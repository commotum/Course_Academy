#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069625} :activity/id #uuid "155e5337-d5e8-53d9-b3b1-ee0f86219c05" :activity/scope {:db/id #edb/ref 17592186050511 :topic/id #uuid "4f6afc08-f23d-50b8-a5e5-a6052d6e4308" :topic/math-academy-id 391} :activity/steps [{:db/id #edb/ref 17592186069625 :step/content {:db/id #edb/ref 17592186070028 :tutorial/content "What is the value of $x$ that satisfies the following equation?\n\n$$\n3^x = 3^4\n$$\n\nWe call this an **exponential equation** because the variable is contained within the exponent. \n\nNow, this equation is pretty easy to solve. Because the bases on both sides of the equation are the same (they are both equal to $3$), we can simply equate the powers.\n\n$$\n\\begin{aligned}{3}^{x} & ={3}^{4} \\\\ x & =4\\end{aligned}\n$$\n\nTherefore, the solution to this equation is $x=4.$" :tutorial/id #uuid "1fc010d0-e380-5035-bdb6-5d5d7cff060b" :tutorial/math-academy-id 8837 :tutorial/title "Introduction"} :step/id #uuid "ddaa7aab-6a5c-5c05-989d-9d15267eceec" :step/math-academy-id 170031 :step/next {:db/id #edb/ref 17592186069626}} {:db/id #edb/ref 17592186069626 :step/content {:db/id #edb/ref 17592186068731 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068495 :question/id #uuid "4912a540-482c-51be-bdc4-8fb128ddfb77" :question/math-academy-id "e-14246"} :knowledge-point/id #uuid "f1e0a7d0-f891-5f5f-8d8d-1ced62b2899e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725} {:db/id #edb/ref 17592186049714}] :knowledge-point/questions [{:db/id #edb/ref 17592186069155} {:db/id #edb/ref 17592186069474} {:db/id #edb/ref 17592186488215} {:db/id #edb/ref 17592186488218} {:db/id #edb/ref 17592186488241} {:db/id #edb/ref 17592186488279}] :knowledge-point/title "Solving an Exponential Equation"} :step/id #uuid "d2856989-c0e4-57bc-927d-5351b29a50a4" :step/math-academy-id 170032 :step/next {:db/id #edb/ref 17592186069627}} {:db/id #edb/ref 17592186069627 :step/content {:db/id #edb/ref 17592186070029 :tutorial/content "Let's take a look at the following equation: \n\n$$\n5^x = 25\n$$\n\nWe can't solve this equation straight off the bat because the two sides of the equation don't share a common base.\n\nHowever, notice that $25$ can be written as a power of $5\\mathbin{:}$\n\n$$\n25=5^2\n$$\n\nTherefore, we can rewrite the equation as\n\n$$\n5^x = 5^2.\n$$\n\nSince both sides of the equation are now written as an exponential expression with a common base of $5,$ we can set the exponents equal to each other and solve:\n\n$$\n\\begin{aligned}{5}^{x} & ={5}^{2} \\\\ x & =2\\end{aligned}\n$$\n\nTo check that the solution is correct, we plug $x=2$ into the original equation:\n\n$$\n\\eqalign{\n\t\t5^{2} &= 25 \\\n\t\t25 &= 25 \\; {\\color{green}{\\checkmark}}\n\t}\n$$" :tutorial/id #uuid "43789602-55db-50d6-8517-6be1716d6133" :tutorial/math-academy-id 8839 :tutorial/title "Changing the Base of an Expression"} :step/id #uuid "792c4b4f-5718-5101-aad6-254e3d0f1a1c" :step/math-academy-id 170035 :step/next {:db/id #edb/ref 17592186069628}} {:db/id #edb/ref 17592186069628 :step/content {:db/id #edb/ref 17592186068732 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068496 :question/id #uuid "bc9650d4-c12f-5e7a-b0b2-aacca9a9d698" :question/math-academy-id "e-14248"} :knowledge-point/id #uuid "7e0c15b8-dc6e-570d-9392-4c679395cc87" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048262} {:db/id #edb/ref 17592186050495}] :knowledge-point/questions [{:db/id #edb/ref 17592186069156} {:db/id #edb/ref 17592186069157} {:db/id #edb/ref 17592186069358} {:db/id #edb/ref 17592186488260} {:db/id #edb/ref 17592186488284} {:db/id #edb/ref 17592186501198} {:db/id #edb/ref 17592186501221}] :knowledge-point/title "Solving an Exponential Equation by Changing the Base"} :step/id #uuid "6ed2b746-5c94-5683-9d52-e609dd44d3af" :step/math-academy-id 170036 :step/next {:db/id #edb/ref 17592186069629}} {:db/id #edb/ref 17592186069629 :step/content {:db/id #edb/ref 17592186068733 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068497 :question/id #uuid "9a971439-a68b-58e5-a8f3-51045b2a0bf0" :question/math-academy-id "e-14252"} :knowledge-point/id #uuid "368d83db-e01e-543b-ba45-8fc9c63242e9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186069122} {:db/id #edb/ref 17592186069158} {:db/id #edb/ref 17592186069523} {:db/id #edb/ref 17592186488240} {:db/id #edb/ref 17592186501151}] :knowledge-point/title "Rearranging and Solving an Exponential Equation"} :step/id #uuid "a3c641ad-5eab-5dde-a062-3feb7d161f4c" :step/math-academy-id 170040}] :activity/title "Solving Exponential Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068938}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186501254} :activity/id #uuid "f4f76a90-d9b8-5d27-b8ad-37337bf353b0" :activity/scope {:db/id #edb/ref 17592186050511 :topic/id #uuid "4f6afc08-f23d-50b8-a5e5-a6052d6e4308" :topic/math-academy-id 391} :activity/steps [{:db/id #edb/ref 17592186501254 :step/content {:db/id #edb/ref 17592186501221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d95c0c5-ace6-53b1-8acd-f4567066b531" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-5" :db/id #edb/ref 17592186500529} {:answer/id #uuid "2bd93094-e14e-5a07-917e-a7afe75bc4f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=2" :db/id #edb/ref 17592186500556} {:answer/id #uuid "4cb2ba71-a137-5a99-8edd-1849eaa61229" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1" :db/id #edb/ref 17592186500622} {:answer/id #uuid "ad6a4066-b9ea-53d1-a1ca-0d161468d3c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=1" :db/id #edb/ref 17592186500825} {:answer/id #uuid "d602709b-da4a-5d8a-9f5c-30e950209408" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=5" :db/id #edb/ref 17592186500925}] :answer-field/correct {:db/id #edb/ref 17592186500622} :answer-field/id #uuid "fee5e589-c054-5eb6-8af3-cb3f2d4d13a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501134}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c1a2b990-ffe2-5008-9b55-fe50c6e1b0a9" :question/math-academy-id "q-72" :question/problem "Solve the equation ${5}^{x}=\\frac{1}{5}.$" :question/worked-solution "First, we rewrite $\\frac{1}{5}$ as ${5}^{-1}$ to get:\n\n$$\n\\begin{aligned}{5}^{x} & =\\frac{1}{5} \\\\ {5}^{x} & ={5}^{-1}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(5)$, we equate the exponents:\n\n$$\n\\begin{aligned}{5}^{x} & ={5}^{-1} \\\\ x & =-1\\end{aligned}\n$$\n\nTherefore, the solution is $x=-1.$"} :step/id #uuid "1ae92f66-49f7-5012-8ef4-d9d2b3e7eeeb" :step/next {:db/id #edb/ref 17592186501262}} {:db/id #edb/ref 17592186501262 :step/content {:db/id #edb/ref 17592186501151 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "026f7618-75a1-5a04-a1b5-19a4dc5bf3a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=3" :db/id #edb/ref 17592186500474} {:answer/id #uuid "927ec64f-f546-590f-a4a2-b25b5259079e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2" :db/id #edb/ref 17592186500771} {:answer/id #uuid "b2009e5a-bca1-5305-a255-000d7c669780" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{3}" :db/id #edb/ref 17592186500839} {:answer/id #uuid "dbbbb42e-e930-5fd7-b9c9-d3dc2136d8ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-2" :db/id #edb/ref 17592186500935} {:answer/id #uuid "f58f8a6d-120b-534f-bcf9-f4589ff32814" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=8" :db/id #edb/ref 17592186500991}] :answer-field/correct {:db/id #edb/ref 17592186500474} :answer-field/id #uuid "8ea04aaa-60fe-5164-9b6a-5f1f5daacdc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501081}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "21ccfd77-b3db-57e5-9298-b5b4966f212d" :question/math-academy-id "q-64060" :question/problem "Solve the equation $3\\cdot {2}^{y}=24.$" :question/worked-solution "First, we isolate the term with the variable exponent by dividing both sides by $3$:\n\n$$\n\\begin{aligned}3\\cdot {2}^{y} & =24 \\\\ \\frac{3\\cdot {2}^{y}}{3} & =\\frac{24}{3} \\\\ {2}^{y} & =8\\end{aligned}\n$$\n\nNow, we rewrite $8$ as ${2}^{3}$ to get:\n\n$$\n\\begin{aligned}{2}^{y} & =8 \\\\ {2}^{y} & ={2}^{3}\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base $(2)$, we equate the exponents:\n\n$$\n\\begin{aligned}{2}^{y} & ={2}^{3} \\\\ y & =3\\end{aligned}\n$$\n\nTherefore, the solution is $y=3.$"} :step/id #uuid "391259fa-6f5a-58f1-8632-da1ecefaa31a" :step/next {:db/id #edb/ref 17592186501269}} {:db/id #edb/ref 17592186501269 :step/content {:db/id #edb/ref 17592186501198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aa42764-8a55-5dbc-bccf-f7cea3894ec5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-1" :db/id #edb/ref 17592186500618} {:answer/id #uuid "b2001155-eb5c-5cb3-bb2c-450902eb3479" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=3" :db/id #edb/ref 17592186500838} {:answer/id #uuid "b6c8da6c-3a4b-5500-9638-fe300ced4dc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-2" :db/id #edb/ref 17592186500848} {:answer/id #uuid "eb8af3a9-b131-5b59-8cf5-ff99c1204dc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=2" :db/id #edb/ref 17592186500971} {:answer/id #uuid "fcdebc72-280c-5c16-b415-95987a0b52ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=1" :db/id #edb/ref 17592186501005}] :answer-field/correct {:db/id #edb/ref 17592186500618} :answer-field/id #uuid "70045a59-b4d4-5586-bd99-bd10111a9b0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501065}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9d01c4ee-dae1-5984-a9e0-aab6ea21f976" :question/math-academy-id "q-64096" :question/problem "Solve the equation ${2}^{z}=\\frac{1}{2}.$" :question/worked-solution "First, we rewrite $\\frac{1}{2}$ as ${2}^{-1}$ to get:\n\n$$\n\\begin{aligned}{2}^{z} & =\\frac{1}{2} \\\\ {2}^{z} & ={2}^{-1}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(2)$, we equate the exponents:\n\n$$\n\\begin{aligned}{2}^{z} & ={2}^{-1} \\\\ z & =-1\\end{aligned}\n$$\n\nTherefore, the solution is $z=-1.$"} :step/id #uuid "5811b9d0-d6f4-5652-886c-ce57664b39ee"}] :activity/title "Solving Exponential Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186500469}]}
