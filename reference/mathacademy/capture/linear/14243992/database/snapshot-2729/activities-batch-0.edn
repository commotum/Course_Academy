ref 17592186078191 :question/id #uuid "5b905b18-5ac3-5a0f-a42f-1d9e53e792cc" :question/math-academy-id "e-14399"} :knowledge-point/id #uuid "d979a7bd-42a1-5d4f-8717-1caa06ce623c" :knowledge-point/questions [{:db/id #edb/ref 17592186078781} {:db/id #edb/ref 17592186079062} {:db/id #edb/ref 17592186233656} {:db/id #edb/ref 17592186234235} {:db/id #edb/ref 17592186234465}] :knowledge-point/title "Determining the Index of a Term Given Two Terms"} :step/id #uuid "365e24e0-7b67-5ec0-b97d-dd778e400ad7" :step/math-academy-id 192038}] :activity/title "Determining Indexes of Terms in Arithmetic Sequences" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078687}]}
