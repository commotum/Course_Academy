#{[{:db/id #edb/ref 17592186171738 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186171955 :knowledge-point/id #uuid "b5c8e2ab-4da7-5e43-a61f-b1dbf76d99ef" :knowledge-point/title "Raising Numbers to Larger Exponents"}] :question/id #uuid "9bdfdfa3-5ed2-5cf9-bf8b-ee84bf4bb9c5" :question/math-academy-id "e-14474" :question/problem "Evaluate $7^4.$" :question/worked-solution "According to the definition, \n![](images/90/90f05ddf350a2b7a739a219c2dbb35958fd182ee9e665e0e5f6ce317ba7675ed.svg)\n\nSince $7 \\times 7 = 49,$ we have\n\n$$\n\\underbrace{7 \\times 7}_{\\color{blue}49} \\times \\underbrace{7 \\times 7}_{\\color{blue}49} = {\\color{blue}49} \\times {\\color{blue}49}.\n$$\n\nFinally, we work out $49 \\times 49.$\n\n$$\n\\begin{aligned}\\begin{aligned} &  &  & \\,\\,\\,\\,\\,\\,\\begin{aligned}\\boxed{\\text{[math]\\color{blue}3[/math]}} \\\\ \\boxed{\\text{[math]\\color{blue}8[/math]}}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $7^4=2,401.$"}] [{:db/id #edb/ref 17592186171739 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186171953 :knowledge-point/id #uuid "3ccf09f0-c76d-5133-be05-1fdfa61b23ad" :knowledge-point/title "Squaring Two-Digit Numbers"}] :question/id #uuid "53a23554-58d8-595a-8e14-bd36e00f678d" :question/math-academy-id "e-14476" :question/problem "Evaluate $31^2.$" :question/worked-solution "To evaluate $31^2,$ we start by writing it out with a multiplication sign:\n![](images/0f/0f6a4e089111de1dbb0e16cb6c388d3dcd236e981f94e2b4694c3492e3d526a3.svg)\n\nThen, we work out $31 \\times 31.$\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}\\end{aligned} \\\\  & \\end{aligned}\n$$\n\nTherefore, $31 \\times 31 =   961.$"}] [{:db/id #edb/ref 17592186171759 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186171954 :knowledge-point/id #uuid "5178592b-14ed-520a-a375-e95219ba8fa3" :knowledge-point/title "Squaring Numbers Ending in Zeros"}] :question/id #uuid "60c9af0c-e7f2-5027-855b-dcc5868e3ee3" :question/math-academy-id "e-15038" :question/problem "Evaluate $220^2.$" :question/worked-solution "To evaluate $220^2,$ we start by writing it out with a multiplication sign:\n![](images/e9/e963c6c194b0cf3991be02d43f130eb81cd3e6f16b1b6921718468b3752ddc07.svg)\n\nThen, we work out $220 \\times 220.$\n\nFirst, we figure out the non-zero part and the block of zeros for both numbers:\n\n$$\n\\begin{aligned}220 & \\,⟶\\,220 \\\\ 220 & \\,⟶\\,220\\end{aligned}\n$$\n\nWe can see that there are $2$ zeros in total.\n\nNext, we multiply the non-zero parts:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}\\end{aligned} \\\\  & \\end{aligned}\n$$\n\nFinally, we join the above with the block of zeros: \n\n$$\n{\\color{red}484}{\\color{blue}00}= 48,400\n$$\n\nTherefore, $220^2  =   48,400.$"}] [{:db/id #edb/ref 17592186430706 :knowledge-point/_questions [{:db/id #edb/ref 17592186171953 :knowledge-point/id #uuid "3ccf09f0-c76d-5133-be05-1fdfa61b23ad" :knowledge-point/title "Squaring Two-Digit Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7814b84e-31e9-5b25-b1d2-682afc124ca3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "281" :db/id #edb/ref 17592186430686} {:answer/id #uuid "84507046-5d4e-53b2-b7bf-b7a74f9e31f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "441" :db/id #edb/ref 17592186430687} {:answer/id #uuid "9686d914-1ae2-54bb-a298-e30f4ea05fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186430689} {:answer/id #uuid "a57f602c-e405-5d4c-b0ed-356fbf84d770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "144" :db/id #edb/ref 17592186430690} {:answer/id #uuid "cfccb0b0-2e66-5b26-9cb9-c8a973494329" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186430694}] :answer-field/correct {:answer/id #uuid "84507046-5d4e-53b2-b7bf-b7a74f9e31f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "441" :db/id #edb/ref 17592186430687} :answer-field/id #uuid "c341d955-1902-5827-913d-e306ac904cea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430704}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e37b600-123f-57a8-aec0-1c4187d7acd1" :question/math-academy-id "q-103854" :question/problem "${21}^{2}=$" :question/worked-solution "To evaluate ${21}^{2},$ we start by writing it out with a multiplication sign:\n\n$$\n{21}^{2}={{21\\times 21}_{⏟}}_{2\\text{ times}}\n$$\n\nThen, we work out $21\\times 21.$\n\n$$\n\\begin{aligned}\\begin{aligned} &  &  & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nTherefore, ${21}^{2}=441.$"}] [{:db/id #edb/ref 17592186430709 :knowledge-point/_questions [{:db/id #edb/ref 17592186171953 :knowledge-point/id #uuid "3ccf09f0-c76d-5133-be05-1fdfa61b23ad" :knowledge-point/title "Squaring Two-Digit Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2180c52-0c69-5616-9e0e-538f8bf11655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "196" :db/id #edb/ref 17592186430695}] :answer-field/correct {:answer/id #uuid "d2180c52-0c69-5616-9e0e-538f8bf11655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "196" :db/id #edb/ref 17592186430695} :answer-field/id #uuid "6ced82ff-6330-5b2d-9d1d-4a8a84518b30" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186430702}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e43445a0-0d82-5a10-9128-a6bbc70f2fb7" :question/math-academy-id "q-224170" :question/problem "${14}^{2}=${{field-1}}" :question/worked-solution "To evaluate ${14}^{2},$ we start by writing it out with a multiplication sign:\n\n$$\n{14}^{2}={{14\\times 14}_{⏟}}_{2\\text{ times}}\n$$\n\nThen, we work out $14\\times 14.$\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{1}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned} & \\end{aligned}\n$$\n\nTherefore, ${14}^{2}=196.$"}] [{:db/id #edb/ref 17592186430708 :knowledge-point/_questions [{:db/id #edb/ref 17592186171954 :knowledge-point/id #uuid "5178592b-14ed-520a-a375-e95219ba8fa3" :knowledge-point/title "Squaring Numbers Ending in Zeros"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e22584d-3050-5603-88da-5ecc5679e6e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "490000" :db/id #edb/ref 17592186430684}] :answer-field/correct {:answer/id #uuid "5e22584d-3050-5603-88da-5ecc5679e6e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "490000" :db/id #edb/ref 17592186430684} :answer-field/id #uuid "3854e34a-bad6-5250-b016-0e9032322e89" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186430701}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6078b88-7674-57bc-95ac-a34e18c2f27b" :question/math-academy-id "q-224264" :question/problem "${700}^{2}=${{field-1}}" :question/worked-solution "To evaluate ${700}^{2},$ we start by writing it out with a multiplication sign:\n\n$$\n{700}^{2}={{700\\times 700}_{⏟}}_{2\\text{ times}}\n$$\n\nThen, we work out $700\\times 700.$\n\nFirst, we figure out the non-zero part and the block of zeros for both numbers:\n\n$$\n\\begin{aligned}700 & \\,⟶\\,700 \\\\ 700 & \\,⟶\\,700\\end{aligned}\n$$\n\nWe can see that there are $4$ zeros in total.\n\nNext, we multiply the non-zero parts:\n\n$$\n7\\times 7=49\n$$\n\nFinally, we join the above with the block of zeros: \n\n$$\n490000=490,000\n$$\n\nTherefore, ${700}^{2}=490,000.$"}] [{:db/id #edb/ref 17592186430705 :knowledge-point/_questions [{:db/id #edb/ref 17592186171954 :knowledge-point/id #uuid "5178592b-14ed-520a-a375-e95219ba8fa3" :knowledge-point/title "Squaring Numbers Ending in Zeros"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6181b2f4-70eb-592e-8e28-5dbb8add845c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25600" :db/id #edb/ref 17592186430685}] :answer-field/correct {:answer/id #uuid "6181b2f4-70eb-592e-8e28-5dbb8add845c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25600" :db/id #edb/ref 17592186430685} :answer-field/id #uuid "1f42ed49-0e4f-50d7-b2dc-b6a989999e04" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186430700}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "25c765b2-1047-5099-8c3e-89ccf0cb03b6" :question/math-academy-id "q-224272" :question/problem "${160}^{2}=${{field-1}}" :question/worked-solution "To evaluate ${160}^{2},$ we start by writing it out with a multiplication sign:\n\n$$\n{160}^{2}={{160\\times 160}_{⏟}}_{2\\text{ times}}\n$$\n\nThen, we work out $160\\times 160.$\n\nFirst, we figure out the non-zero part and the block of zeros for both numbers:\n\n$$\n\\begin{aligned}160 & \\,⟶\\,160 \\\\ 160 & \\,⟶\\,160\\end{aligned}\n$$\n\nWe can see that there are $2$ zeros in total.\n\nNext, we multiply the non-zero parts:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{3}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,2\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,6\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}\\end{aligned} & \\end{aligned}\n$$\n\nFinally, we join the above with the block of zeros: \n\n$$\n25600=25,600\n$$\n\nTherefore, ${160}^{2}=25,600.$"}] [{:db/id #edb/ref 17592186430707 :knowledge-point/_questions [{:db/id #edb/ref 17592186171955 :knowledge-point/id #uuid "b5c8e2ab-4da7-5e43-a61f-b1dbf76d99ef" :knowledge-point/title "Raising Numbers to Larger Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89dbb185-61b3-5c47-890c-db13f2de2ed5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6,525" :db/id #edb/ref 17592186430688} {:answer/id #uuid "b3c3a767-02dd-5d0f-8568-320f3e0f1f36" :answer/type {:db/id #