#{[{:activity/first-step {:db/id #edb/ref 17592186172759} :activity/id #uuid "398007ac-5b9a-5c75-bc98-faf0280549a1" :activity/scope {:db/id #edb/ref 17592186049368 :topic/id #uuid "ef3ce67d-2852-5da7-b74a-ccd55010b765" :topic/math-academy-id 3537} :activity/steps [{:db/id #edb/ref 17592186172759 :step/content {:db/id #edb/ref 17592186173277 :tutorial/content "To evaluate a large exponent, we first write out the power using multiplication signs as usual. Then, we calculate the product by splitting it into groups of two-digit multiplications, before calculating the resulting product.\n\nFor example, let's evaluate $2^4$.\n\nFirst, we write\n$4$\n\nSince\n\n$$\n2 \\times 2 = 4\n$$\n\nwe have\n\n$$\n\\underbrace{2 \\times 2}_{\\large \\color{blue}4} \\times \\underbrace{2 \\times 2}_{\\large \\color{blue}4} = {\\color{blue}4} \\times {\\color{blue}4}\n$$\n\nFinally, we work out $4\\times 4$.\nSince\n\n$$\n4\\times 4=16\n$$\n\nwe conclude that $2^4=16$." :tutorial/id #uuid "4a00be57-d26e-53b8-9d16-7f4994f21077" :tutorial/math-academy-id 8955 :tutorial/title "Introduction"} :step/id #uuid "a08ac1c8-ddf6-527a-b5da-c74d68629060" :step/math-academy-id 183158 :step/next {:db/id #edb/ref 17592186172760}} {:db/id #edb/ref 17592186172760 :step/content {:db/id #edb/ref 17592186171953 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171739 :question/id #uuid "53a23554-58d8-595a-8e14-bd36e00f678d" :question/math-academy-id "e-14476"} :knowledge-point/id #uuid "3ccf09f0-c76d-5133-be05-1fdfa61b23ad" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048924} {:db/id #edb/ref 17592186050170}] :knowledge-point/questions [{:db/id #edb/ref 17592186172386} {:db/id #edb/ref 17592186172599}] :knowledge-point/title "Squaring Two-Digit Numbers"} :step/id #uuid "2ec86d88-91a2-57ce-b6f0-88b36b9b4e91" :step/math-academy-id 183159 :step/next {:db/id #edb/ref 17592186172761}} {:db/id #edb/ref 17592186172761 :step/content {:db/id #edb/ref 17592186171954 :knowledge-point/canonica