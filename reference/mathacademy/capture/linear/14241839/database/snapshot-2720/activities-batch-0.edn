#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186176612} :activity/id #uuid "f441e707-bca4-5383-a476-aeddd2c81a22" :activity/scope {:db/id #edb/ref 17592186048144 :topic/id #uuid "82f08561-a294-5382-8640-2c8beeb6ee2e" :topic/math-academy-id 3555} :activity/steps [{:db/id #edb/ref 17592186176612 :step/content {:db/id #edb/ref 17592186177094 :tutorial/content "Consider the rational equation\n\n$$\n\\dfrac{12}{x+3} = \\dfrac{2}{x-2}.\n$$\n\nRecall that when the equation consists of a single rational expression on each side, like the one above, then the easiest way to solve it is usually to use cross-multiplication.\n\nHowever, before we start, note that $x=-3$ and $x=2$ cannot be solutions. This is because when $x=-3,$ we get a zero in the denominator on the left-hand side, and when $x=2,$ we get a zero in the denominator on the right-hand side.\n\nWith this in mind, let's solve the equation. First, we cross-multiply:\n\n$$\n\\begin{aligned}\\frac{12}{x+3} & =\\frac{2}{x-2} \\\\ 12\\cdot (x-2) & =(x+3)\\cdot 2 \\\\ 12x-24 & =2x+6\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}12x-24 & =2x+6 \\\\ 12x-24-2x & =2x+6-2x \\\\ 10x-24 & =6 \\\\ 10x-24+24 & =6+24 \\\\ 10x & =30 \\\\ \\frac{10x}{10} & =\\frac{30}{10} \\\\ x & =3\\end{aligned}\n$$\n\nSince $x=3$ is different from $x=-3$ and $x=2,$ we accept it as a solution. Thus, the solution is $x=3.$" :tutorial/id #uuid "32ce7197-6c97-5ece-b45d-186993605c4f" :tutorial/math-academy-id 8781 :tutorial/title "Introduction"} :step/id #uuid "ecfccb89-86a2-557a-b9d3-c0ad225826b2" :step/math-academy-id 143532 :step/next {:db/id #edb/ref 17592186176613}} {:db/id #edb/ref 17592186176613 :step/content {:db/id #edb/ref 17592186175906 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175733 :question/id #uuid "1be25af9-d59f-5270-b9e1-d0c5dcd731e8" :question/math-academy-id "e-14143"} :knowledge-point/id #uuid "2e09c5b9-5f31-52a5-b696-b2df1879d289" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048891}] :knowledge-point/questions [{:db/id #edb/ref 17592186176177} {:db/id #edb/ref 17592186176535} {:db/id #edb/ref 17592186498538} {:db/id #edb/ref 17592186498554}] :knowledge-point/title "Solving Rational Equations Containing a Binomial in One Denominator"} :step/id #uuid "36c668d7-ed4b-5afb-8e0b-ee04536f38df" :step/math-academy-id 143533 :step/next {:db/id #edb/ref 17592186176614}} {:db/id #edb/ref 17592186176614 :step/content {:db/id #edb/ref 17592186175907 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175739 :question/id #uuid "2d5b690c-bee9-5503-8f21-285b8c42d5fa" :question/math-academy-id "e-14705"} :knowledge-point/id #uuid "4f3e1fc3-c46b-5958-92b2-0f2dc11ff961" :knowledge-point/questions [{:db/id #edb/ref 17592186176421} {:db/id #edb/ref 17592186176474} {:db/id #edb/ref 17592186498505} {:db/id #edb/ref 17592186498588}] :knowledge-point/title "Equations Containing Negative Signs"} :step/id #uuid "5d7e1964-4293-5a03-90c4-211bf2cd63f1" :step/math-academy-id 143537 :step/next {:db/id #edb/ref 17592186176615}} {:db/id #edb/ref 17592186176615 :step/content {:db/id #edb/ref 17592186175908 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175734 :question/id #uuid "72cf8733-9727-5a9f-8028-1dee62e5715d" :question/math-academy-id "e-14146"} :knowledge-point/id #uuid "208596d0-1a45-57b2-afa5-d17e99218e38" :knowledge-point/questions [{:db/id #edb/ref 17592186176415} {:db/id #edb/ref 17592186176422} {:db/id #edb/ref 17592186498563} {:db/id #edb/ref 17592186498568} {:db/id #edb/ref 17592186498597} {:db/id #edb/ref 17592186559812} {:db/id #edb/ref 17592186559882} {:db/id #edb/ref 17592186559887}] :knowledge-point/title "Solving Rational Equations Containing Binomials in Both Denominators"} :step/id #uuid "fe911541-f3cd-5e52-abb4-31aa92a738cf" :step/math-academy-id 143541}] :activity/title "Solving Rational Equations Containing Binomials Using Cross-Multiplication" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176106}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186559930} :activity/id #uuid "1b14901e-c955-5627-a3c0-254c47f97349" :activity/scope {:db/id #edb/ref 17592186048144 :topic/id #uuid "82f08561-a294-5382-8640-2c8beeb6ee2e" :topic/math-academy-id 3555} :activity/steps [{:db/id #edb/ref 17592186559898 :step/content {:db/id #edb/ref 17592186559882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029cf53c-ae6d-5d8b-9043-5e9d44910d40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-2" :db/id #edb/ref 17592186559023} {:answer/id #uuid "1e358410-36f2-52bb-a6b8-0503c41957c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=3" :db/id #edb/ref 17592186559090} {:answer/id #uuid "2580ada9-6aad-537f-845b-f3e63bd554dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1" :db/id #edb/ref 17592186559109} {:answer/id #uuid "672174dc-c76d-54f0-9e26-076639ae8482" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=5" :db/id #edb/ref 17592186559273} {:answer/id #uuid "c1fb6cc6-e2e8-5330-99ad-14aa63b61123" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-7" :db/id #edb/ref 17592186559493}] :answer-field/correct {:db/id #edb/ref 17592186559273} :answer-field/id #uuid "a808e838-88e8-51e8-8659-395345d61b0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559735}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f03fefa6-3a2e-5378-840e-6b0b6beb7bc1" :question/math-academy-id "q-102818" :question/problem "Solve the equation $\\frac{1}{x-1}=\\frac{2}{x+3}.$" :question/worked-solution "First, note that $x=-3$ and $x=1$ cannot be solutions since division by $0$ is undefined.\n\nTo solve the equation, we first apply cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{1}{x-1} & =\\frac{2}{x+3} \\\\ 1\\cdot (x+3) & =(x-1)\\cdot 2 \\\\ x+3 & =2x-2\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}x+3 & =2x-2 \\\\ x+3-x & =2x-2-x \\\\ 3 & =x-2 \\\\ 3+2 & =x-2+2 \\\\ 5 & =x\\end{aligned}\n$$\n\nSince $x=5$ is different from $x=-3$ and $x=1,$ we can accept it as a solution. Thus, the solution is $x=5.$"} :step/id #uuid "06eb6fa1-dfb2-5b2c-acc7-dce9cf39f5b3"} {:db/id #edb/ref 17592186559930 :step/content {:db/id #edb/ref 17592186559887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "174a201d-f58e-5ec3-aa26-3df65a0919fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1" :db/id #edb/ref 17592186559069} {:answer/id #uuid "1b9ee885-f816-536a-9a4b-66917e71b76e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=4" :db/id #edb/ref 17592186559080} {:answer/id #uuid "3fd1f6a6-e59a-5fdb-8f79-06248ac10397" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{1}{8}" :db/id #edb/ref 17592186559180} {:answer/id #uuid "6c45b276-24f3-5a57-bccd-2046b40c3894" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{3}{14}" :db/id #edb/ref 17592186559285} {:answer/id #uuid "a2f762a9-8f3f-5725-8c3d-a647af718df0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{7}{4}" :db/id #edb/ref 17592186559426}] :answer-field/correct {:db/id #edb/ref 17592186559069} :answer-field/id #uuid "f814dc0c-188f-574f-b854-176c72a87e74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559767}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f7ee9ca4-a3f0-5a8a-a26b-4c46c8822ae6" :question/math-academy-id "q-47794" :question/problem "Solve the equation $\\frac{9}{6x-3}=\\frac{2}{3x+1}.$" :question/worked-solution "First, note that $x=\\frac{1}{2}$ and $x=-\\frac{1}{3}$ cannot be solutions since division by $0$ is undefined. \n\nTo solve the equation, we first apply cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{9}{6x-3} & =\\frac{2}{3x+1} \\\\ 9\\cdot (3x+1) & =(6x-3)\\cdot 2 \\\\ 27x+9 & =12x-6\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}27x+9 & =12x-6 \\\\ 27x+9-12x & =12x-6-12x \\\\ 15x+9 & =-6 \\\\ 15x+9-9 & =-6-9 \\\\ 15x & =-15 \\\\ \\frac{15x}{15} & =\\frac{-15}{15} \\\\ x & =-1\\end{aligned}\n$$\n\nSince  $x=-1$ is different from $x=\\frac{1}{2}$ and $x=-\\frac{1}{3},$ we can accept it as a solution.\nThus, the solution is $x=-1.$"} :step/id #uuid "544b0bbe-7699-51f8-ab7e-6267f3303aae" :step/next {:db/id #edb/ref 17592186559940}} {:db/id #edb/ref 17592186559940 :step/content {:db/id #edb/ref 17592186559812 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32f4c6f4-178d-5d4f-9cff-30346f3dab9e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No solutions" :db/id #edb/ref 17592186559144} {:answer/id #uuid "4a7a45de-e0ec-5bc5-ba26-4cf78d2fefc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=5" :db/id #edb/ref 17592186559208} {:answer/id #uuid "889b7794-6975-5412-ab18-7cd2f1fda6ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-2" :db/id #edb/ref 17592186559359} {:answer/id #uuid "b4f50d04-a640-5bf1-aa0f-e78901fe54e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=4" :db/id #edb/ref 17592186559468} {:answer/id #uuid "fa1934be-efbe-592e-ba9b-fcbe1eb325e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{3}{2}" :db/id #edb/ref 17592186559631}] :answer-field/correct {:db/id #edb/ref 17592186559144} :answer-field/id #uuid "842edd8c-d49e-5de9-8d9e-73cf9af84901" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559717}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "600419ab-eff5-5dfa-9145-b6a621ba7867" :question/math-academy-id "q-51471" :question/problem "Solve the equation $\\frac{2}{3x+12}=\\frac{2}{x+4}.$" :question/worked-solution "First, note that $x=-4$ cannot be a solution since division by $0$ is undefined. \n\nTo solve the equation, we first apply cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{2}{3x+12} & =\\frac{2}{x+4} \\\\ 2\\cdot (x+4) & =(3x+12)\\cdot 2 \\\\ 2x+8 & =6x+24\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}2x+8 & =6x+24 \\\\ 2x+8-24 & =6x+24-24 \\\\ 2x-16 & =6x \\\\ 2x-16-2x & =6x-2x \\\\ -16 & =4x \\\\ \\frac{-16}{4} & =\\frac{4x}{4} \\\\ -4 & =x\\end{aligned}\n$$\n\nSince $x=-4$ cannot be a solution, the equation has no solutions."} :step/id #uuid "6e6e733b-eaf0-5101-bc15-75bd30fffd8b" :step/next {:db/id #edb/ref 17592186559898}}] :activity/title "Solving Rational Equations Containing Binomials Using Cross-Multiplication" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186558998}]}
