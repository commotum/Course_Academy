[{:db/id 17592186142883 :knowledge-point/questions ["question-84700809-8deb-5dcd-825c-021f0de996ee" "question-5e7cfcea-8131-5196-8e8b-1f4b9653bb0f" "question-5283f831-0cb3-5bf5-9744-ff5db4db7f78" "question-ff247414-d461-5a80-b3f1-dbef2f303fb7"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186142705 :question/worked-solution "The figure consists of $3$ rows, and each row has $5$ cubes.\n\n![](images/ba/baa53ae50449e9d56821925d9fbe5d2ebf694badd4e1e5e3c604fdcbf698a16f.png)\n\nSo, there are $5 \\times 3 = 15$ cubes in total.\n\nTherefore, the volume of the figure is $15$ cubic units." :db/ensure [:question/validate]} {:db/id 17592186142706 :question/worked-solution "The figure consists of two layers:\n\n- The bottom layer consists of $4$ cubes.\n\n- The top layer consists of $1$ cube.\n\n![](images/4c/4c6372a05b21e7aa9f26717fdbb2cfe47e17d2d17215e9b7411e876b0e6473f5.png)\n\nTherefore, the volume is $4+1=5$ cubic units." :db/ensure [:question/validate]} {:db/id "question-84700809-8deb-5dcd-825c-021f0de996ee" :question/id #uuid "84700809-8deb-5dcd-825c-021f0de996ee" :question/math-academy-id "q-58154" :question/problem "![](images/49/49f584ca846d3cc6b00f4b31e2374d9fb295f446bec637a6f49c960beb7dbc9c.png)\n\nIf each cube represents $1$ cubic unit, what is the volume of the figure?" :question/worked-solution "The figure consists of $4$ cubes. \n\n![](images/44/4438429d27efe7b18b2d65fd6f202b53f3e6020edc84ef5332a545b777cc0f42.png)\n\nTherefore, its volume is $4$ cubic units." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eac244d4-38bb-526d-b0d7-6cf44ac0b355"] :db/ensure [:question/validate]} {:db/id "answer-field-eac244d4-38bb-526d-b0d7-6cf44ac0b355" :answer-field/id #uuid "eac244d4-38bb-526d-b0d7-6cf44ac0b355" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3f75a191-3f99-5b30-b9fd-bdd56d5dbae2" :answer-field/choices ["answer-efef2d70-ccb6-5c46-a248-49e604bcfa2b" "answer-e5205