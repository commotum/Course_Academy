#{[{:db/id #edb/ref 17592186142704 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142883 :knowledge-point/id #uuid "6057e526-a6a3-562d-b6e5-d72ac184b968" :knowledge-point/title "Finding the Volume of a Figure by Counting"}] :question/id #uuid "c041baf7-07b4-5c1a-969d-4324a3417f92" :question/math-academy-id "e-2147" :question/problem "If each cube represents one cubic unit, what is the volume of the figure?\n\n![](images/54/544b5a74ce1d8c5545d32df665df7d10ba4853cdf166ca02a3a03b46e2a97259.png)" :question/worked-solution "The figure consists of $10$ cubes.\n\n![](images/df/dfa571cbacb1f3e06ce70e05c127239cb159fdbc9adbd937df6120a5f214b120.png)\n\nTherefore, the volume is $10$ cubic units."}] [{:db/id #edb/ref 17592186142705 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142884 :knowledge-point/id #uuid "12445ca3-d861-5cf8-98c2-603026cfe199" :knowledge-point/title "Finding the Volume of a Figure by Multiplying"}] :question/id #uuid "40f45207-a212-5fb2-8c5c-5625e367301f" :question/math-academy-id "e-2148" :question/problem "If each cube represents $1$ cubic unit, what is the volume of the figure?\n\n![](images/2e/2e9da7bdc1b3e20a197be4c7e2ab3a64abcbdd78dc16274bc314e73bdc6bd1ce.png)" :question/worked-solution "The figure consists of $3$ rows, and each row has $5$ cubes.\n\n![](images/ba/baa53ae50449e9d56821925d9fbe5d2ebf694badd4e1e5e3c604fdcbf698a16f.png)\n\nSo, there are $5 \\times 3 = 15$ cubes in total.\n\nTherefore, the volume of the figure is $15$ cubic units."}] [{:db/id #edb/ref 17592186142706 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142885 :knowledge-point/id #uuid "2ee3dbcf-50d2-542c-9519-fbdcd4ac5b52" :knowledge-point/title "Finding the Volume of a Figure Containing Multiple Layers"}] :question/id #uuid "5316b5a3-dec6-5e2c-a14e-ee19c1040916" :question/math-academy-id "e-2149" :question/problem "An object is assembled as shown below. Given that each small cube represents one cubic unit, what is the volume of the object?\n\n![](images/53/5304eed09b6d029958fbfcce95001c79a8a9dbdd91e7c8ae6eefa7d54db61a75.png)" :question/worked-solution "The figure consists of two layers:\n\n- The bottom layer consists of $4$ cubes.\n\n- The top layer consists of $1$ cube.\n\n![](images/4c/4c6372a05b21e7aa9f26717fdbb2cfe47e17d2d17215e9b7411e876b0e6473f5.png)\n\nTherefore, the volume is $4+1=5$ cubic units."}] [{:db/id #edb/ref 17592186432196 :knowledge-point/_questions [{:db/id #edb/ref 17592186142883 :knowledge-point/id #uuid "6057e526-a6a3-562d-b6e5-d72ac184b968" :knowledge-point/title "Finding the Volume of a Figure by Counting"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f775cfe-b42f-568b-b1f0-6032ca161de1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ cubic inches" :db/id #edb/ref 17592186432175} {:answer/id #uuid "4e964b86-655f-5b0f-90cf-94b1ab5e254d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ cubic inches" :db/id #edb/ref 17592186432177} {:answer/id #uuid "7323ec21-7cb0-5c3a-bfdb-8714016e43b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ cubic inches" :db/id #edb/ref 17592186432181} {:answer/id #uuid "8c00fcc4-4d8d-5ab0-be3c-4b4d04a0fdca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ cubic inches" :db/id #edb/ref 17592186432183} {:answer/id #uuid "d4af68cf-5c98-5792-99ee-4f578b8121f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ cubic inches" :db/id #edb/ref 17592186432185}] :answer-field/correct {:answer/id #uuid "4e964b86-655f-5b0f-90cf-94b1ab5e254d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ cubic inches" :db/id #edb/ref 17592186432177} :answer-field/id #uuid "be02a775-e3c8-5882-844e-a9ae15be7dd7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493