#{[{:activity/first-step {:db/id #edb/ref 17592186143803} :activity/id #uuid "1ea98903-be03-54ee-a4af-ad6a084260e4" :activity/scope {:db/id #edb/ref 17592186050338 :topic/id #uuid "41041814-a377-5adb-96e1-952df5762433" :topic/math-academy-id 2403} :activity/steps [{:db/id #edb/ref 17592186143803 :step/content {:db/id #edb/ref 17592186143995 :tutorial/content "**Volume** is the amount of space that an object takes up. We can measure volume with **unit cubes**, like the one below.\n\n![](images/a3/a318f6234bdbf014e4cbefbc1add274dbcc37b08f59d93a5fe53c463e962cc86.png)\n\nThese are called unit cubes because each one represents $1$ cubic unit. The volume of a figure is the number of unit cubes that make it up.\n\nFor example, let's find the volume of the figure below:\n\n![](images/12/1215ed078257410d4aab5cff0a58dcbc719c477211bdec8a77b9d10a2ecb5dae.png)\n\nThe figure consists of $2$ cubes.\n\n![](images/4b/4ba5e58d16c4bf9e684590e0280c4ddbd32c5b2c2bbf94412ca77713d9f059b0.png)\n\nTherefore, its volume is $2$ cubic units." :tutorial/id #uuid "a4dc0491-8422-502e-9ecd-f199ce666a9a" :tutorial/math-academy-id 2000 :tutorial/title "Introduction"} :step/id #uuid "dbf328d0-e455-5024-ae5a-d1dbd16b32d3" :step/math-academy-id 604864 :step/next {:db/id #edb/ref 17592186143808}} {:db/id #edb/ref 17592186143804 :step/content {:db/id #edb/ref 17592186142883 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142704 :question/id #uuid "c041baf7-07b4-5c1a-969d-4324a3417f92" :question/math-academy-id "e-2147"} :knowledge-point/id #uuid "6057e526-a6a3-562d-b6e5-d72ac184b968" :knowledge-point/questions [{:db/id #edb/ref 17592186143086} {:db/id #edb/ref 17592186143381}] :knowledge-point/title "Finding the Volume of a Figure by Counting"} :step/id #uuid "14023ba2-9d6a-5179-b29d-c2d1893fc2f0" :step/math-academy-id 604865 :step/next {:db/id #edb/ref 17592186143805}} {:db/id #edb/ref 17592186143805 :step/content {:db/id #edb/ref 17592186142884 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142705 :question/id #uuid "40f45207-a212-5fb2-8c5c-5625e367301f" :question/math-academy-id "e-2148"} :knowledge-point/id #uuid "12445ca3-d861-5cf8-98c2-603026cfe199" :knowledge-point/questions [{:db/id #edb/ref 17592186143087} {:db/id #edb/ref 17592186143383}] :knowledge-point/title "Finding the Volume of a Figure by Multiplying"} :step/id #uuid "95654ea7-6c8d-5f85-93cc-e6eb65a408a1" :step/math-academy-id 604868 :step/next {:db/id #edb/ref 17592186143806}} {:db/id #edb/ref 17592186143806 :step/content {:db/id #edb/ref 17592186143996 :tutorial/content "If a figure has multiple layers, we can find its volume by first finding the volume of each layer and then adding the results.\n\nEach cube in the figure below represents one cubic unit. Let's find its volume.\n\n![](images/54/547a09fed5b5b736b556db4d476f869a68a39528f59d6a5abe505f1fa38260d9.png)\n\nThe figure consists of two layers:\n\n- The bottom layer consists of $2$ cubes.\n- The top layer consists of $2$ cubes, too.\n\n![](images/6b/6b7e4ce3ffa821b4263213782bf99a4243f3b844c862e49fcf5181a6f4cdacd2.png)\n\nTherefore, the volume is\n\n$$\n2+2=4\n$$\n\ncubic units." :tutorial/id #uuid "a4ba0e39-861d-56ee-a198-e03e2de4bc6c" :tutorial/math-academy-id 2001 :tutorial/title "Figures With Multiple Layers"} :step/id #uuid "9c8e84bb-8ce1-5ca3-9905-45f12e5aed4e" :step/math-academy-id 604871 :step/next {:db/id #edb/ref 17592186143807}} {:db/id #edb/ref 17592186143807 :step/content {:db/id #edb/ref 17592186142885 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142706 :question/id #uuid "5316b5a3-dec6-5e2c-a14e-ee19c1040916" :question/math-academy-id "e-2149"} :knowledge-point/id #uuid "2ee3dbcf-50d2-542c-9519-fbdcd4ac5b52" :knowledge-point/questions [{:db/id #edb/ref 17592186143088} {:db/id #edb/ref 17592186143398}] :knowledge-point/title "Finding the Volume of a Figure Containing Multiple Layers"} :step/id #uuid "e65cc34b-2b13-5be9-80ab-065730d3bbe1" :step/math-academy-id 604872} {:db/id #edb/ref 17592186143808 :step/content {:db/id #edb/ref 17592186143972 :tutorial/content "We can use metric and customary units to measure volume.\n\nConsider the cube below, whose length, width, and height all equal $1$ centimeter.\n\n![](images/2a/2a87c66750f85974528df85c7956a13a7e3a7982490d22113879ee80881badfb.png)\n\nSince the length, width, and height of this cube all equal $1$ centimeter, the volume of this cube is $\\mathbf 1$ **cubic centimeter.**\n\nCommonly used metric units of volume are:\n\n- cubic meters\n- cubic centimeters\n- cubic millimeters\n\nCommonly used customary units of volume are:\n\n- cubic feet\n- cubic inches\n\nWe'll learn more about units of volume in future lessons." :tutorial/id #uuid "12f18b2c-66de-5ce9-af17-3ac954d482bb" :tutorial/math-academy-id 14836 :tutorial/title "Units of Volume"} :step/id #uuid "14ae82bf-123e-5049-8743-6d3ec50f0915" :step/math-academy-id 604880 :step/next {:db/id #edb/ref 17592186143804}}] :activity/title "Understanding Volume Using Unit Cubes" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186143033}]}
