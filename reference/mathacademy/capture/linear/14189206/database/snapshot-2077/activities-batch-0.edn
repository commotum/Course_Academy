#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186069730} :activity/id #uuid "74c085db-a02d-55d0-a9c6-2ff188739b10" :activity/scope {:db/id #edb/ref 17592186049181 :topic/id #uuid "e176f8f6-a3bc-5ea6-89d2-2202d9d89fd7" :topic/math-academy-id 423} :activity/steps [{:db/id #edb/ref 17592186069730 :step/content {:db/id #edb/ref 17592186069927 :tutorial/content "To simplify a rational expression, we cancel out the largest common factor from the numerator and denominator. To do this, we sometimes need to factor the numerator and denominator before canceling.\n\nFor example, suppose that we wish to simplify $\\dfrac {4x - 12} {10x + 4}.$ To do this, we factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\eqalign{\n\t\t\\dfrac {4x - 12} {10x + 4}\n\t\t&=\\dfrac {4(x - 3)} {2(5x + 2)}\\[5pt]\n&=\\dfrac {2 \\cdot 2 \\cdot (x - 3)} {2(5x + 2)}\\[5pt]\t\t\n\t\t&=\\dfrac {\\cancel{2} \\cdot 2(x - 3)} {\\cancel{2}(5x + 2)}\\[5pt]\t\n\t\t&=\\dfrac {2(x - 3)} {5x + 2}\n\t}\n$$" :tutorial/id #uuid "332f534f-811e-5c03-8393-560134dd4ea8" :tutorial/math-academy-id 1370 :tutorial/title "Introduction"} :step/id #uuid "818bd86a-fb35-5a26-8a36-9ee10c0aa1c5" :step/math-academy-id 2850 :step/next {:db/id #edb/ref 17592186069869}} {:db/id #edb/ref 17592186069731 :step/content {:db/id #edb/ref 17592186068805 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068653 :question/id #uuid "3df1f00a-3a87-5db7-83c5-d47dce633bf9" :question/math-academy-id "e-843"} :knowledge-point/id #uuid "6a17d9d6-cd3a-554e-98d2-7e9536950bd0" :knowledge-point/questions [{:db/id #edb/ref 17592186069273} {:db/id #edb/ref 17592186069446} {:db/id #edb/ref 17592186480645} {:db/id #edb/ref 17592186480703} {:db/id #edb/ref 17592186502073} {:db/id #edb/ref 17592186502106}] :knowledge-point/title "Simplifying Rational Expressions With Common Factors"} :step/id #uuid "ba820298-67c7-5655-858e-a20d665b5e15" :step/math-academy-id 2854 :step/next