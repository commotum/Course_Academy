ef 17592186502073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3886ddee-8772-528b-bf4d-8bf02e891107" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5(2g+6)^{2}}" :db/id #edb/ref 17592186501568} {:answer/id #uuid "5450829c-b0a3-5655-bd1c-5951e0c37b62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2g+6" :db/id #edb/ref 17592186501622} {:answer/id #uuid "87a0ab98-9dd0-5490-bcc8-385d1c51bb82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186501726} {:answer/id #uuid "afcad7b6-af4e-59d6-82fd-8b0d5cf543c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5(2g+6)^{2}}{4}" :db/id #edb/ref 17592186501815} {:answer/id #uuid "fcd329fc-b34a-5fbb-bd9a-1392f560a2ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186501970}] :answer-field/correct {:db/id #edb/ref 17592186501726} :answer-field/id #uuid "f3dfd035-8faf-5e9c-8f1e-539bc75374da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502058}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0dc91759-1708-5aa4-a78f-8164b2208179" :question/math-academy-id "q-51526" :question/problem "What is $\\frac{10g+30}{8g+24}$ reduced to its lowest terms?" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{10g+30}{8g+24} & =\\frac{5(2g+6)}{4(2g+6)} \\\\  & =\\frac{5\\cancel{(2g+6)}}{4\\cancel{(2g+6)}} \\\\  & =\\frac{5}{4}\\end{aligned}\n$$"} :step/id #uuid "244bf9be-1869-5c01-9bef-c171796be681" :step/next {:db/id #edb/ref 17592186502193}} {:db/id #edb/ref 17592186502193 :step/content {:db/id #edb/ref 17592186502106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f4f1f7-644a-5080-b0cf-201bf0a40bc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{x-3}" :db/id #edb/ref 17592186501480} {:answer/id #uuid "070118e9-d838-5a52-8939-3d392169bc42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186501482} {:answer/id #uuid "ac77b55f-c27a-5257-a8fa-649823e99715" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186501809} {:answer/id #uuid "cbc47ca7-0390-52f9-aa36-ff5d3975d9c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186501871} {:answer/id #uuid "daa76a02-84a6-5425-b200-2e9ee6c38aef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3-x}" :db/id #edb/ref 17592186501904}] :answer-field/correct {:db/id #edb/ref 17592186501871} :answer-field/id #uuid "6d7f57eb-669c-54ed-8aa2-d787aac81274" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502013}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "624c7b11-aded-592e-be21-f98c6f89890c" :question/math-academy-id "q-52367" :question/problem "Which of the following is equivalent to $\\frac{2x-6}{3-x}?$" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{2x-6}{3-x} & =\\frac{2(x-3)}{-(x-3)} \\\\  & =\\frac{2\\cdot (x-3)}{(-1)\\cdot (x-3)} \\\\  & =\\frac{2\\cdot \\cancel{(x-3)}}{(-1)\\cdot \\cancel{(x-3)}} \\\\  & =\\frac{2}{(-1)} \\\\  & =-2\\end{aligned}\n$$"} :step/id #uuid "906a3f57-f0f9-58fa-b96b-4062bc57287a"}] :activity/title "Simplifying Rational Expressions by Factoring" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186501460}]}
