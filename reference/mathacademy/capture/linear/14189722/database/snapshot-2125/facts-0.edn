8 #edb/ref 17592186045417] [17592186503250 #edb/ref 1083 #uuid "83db7d2e-5441-54f0-9b72-b23bdd133079" #edb/ref 17592186045417] [17592186503281 #edb/ref 1080 "\\frac{1}{32}+\\frac{25y}{8}+145{y}^{2}" #edb/ref 17592186045417] [17592186503281 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186503281 #edb/ref 1083 #uuid "9799692b-0119-5014-ae4f-3ef5e9145c63" #edb/ref 17592186045417] [17592186503368 #edb/ref 1080 "{y}^{3}-4{y}^{2}x+6y{x}^{2}" #edb/ref 17592186045417] [17592186503368 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186503368 #edb/ref 1083 #uuid "c137176e-2ac9-58c5-84bd-949dafa76422" #edb/ref 17592186045417] [17592186503469 #edb/ref 1080 "128" #edb/ref 17592186045417] [17592186503469 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186503469 #edb/ref 1083 #uuid "eddbbe69-969c-5b54-965b-bba69c119ec3" #edb/ref 17592186045417] [17592186503516 #edb/ref 1075 #edb/ref 17592186503038 #edb/ref 17592186045417] [17592186503516 #edb/ref 1075 #edb/ref 17592186503091 #edb/ref 17592186045417] [17592186503516 #edb/ref 1075 #edb/ref 17592186503190 #edb/ref 17592186045417] [17592186503516 #edb/ref 1075 #edb/ref 17592186503250 #edb/ref 17592186045417] [17592186503516 #edb/ref 1075 #edb/ref 17592186503469 #edb/ref 17592186045417] [17592186503516 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186503516 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186503516 #edb/ref 1078 #edb/ref 17592186503091 #edb/ref 17592186045417] [17592186503516 #edb/ref 1079 #uuid "056e7899-7359-5aa3-9d75-0e24b35490d3" #edb/ref 17592186045417] [17592186503583 #edb/ref 1075 #edb/ref 17592186503009 #edb/ref 17592186045417] [17592186503583 #edb/ref 1075 #edb/ref 17592186503051 #edb/ref 17592186045417] [17592186503583 #edb/ref 1075 #edb/ref 17592186503165 #edb/ref 17592186045417] [17592186503583 #edb/ref 1075 #edb/ref 17592186503172 #edb/ref 17592186045417] [17592186503583 #edb/ref 1075 #edb/ref 17592186503368 #edb/ref 17592186045417] [17592186503583 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186503583 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186503583 #edb/ref 1078 #edb/ref 17592186503051 #edb/ref 17592186045417] [17592186503583 #edb/ref 1079 #uuid "8b892af4-e657-5e7b-967c-44dc67970e0b" #edb/ref 17592186045417] [17592186503635 #edb/ref 1075 #edb/ref 17592186503008 #edb/ref 17592186045417] [17592186503635 #edb/ref 1075 #edb/ref 17592186503128 #edb/ref 17592186045417] [17592186503635 #edb/ref 1075 #edb/ref 17592186503133 #edb/ref 17592186045417] [17592186503635 #edb/ref 1075 #edb/ref 17592186503136 #edb/ref 17592186045417] [17592186503635 #edb/ref 1075 #edb/ref 17592186503281 #edb/ref 17592186045417] [17592186503635 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186503635 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186503635 #edb/ref 1078 #edb/ref 17592186503008 #edb/ref 17592186045417] [17592186503635 #edb/ref 1079 #uuid "ef1b5443-9d42-51aa-ac69-73ecc6958d74" #edb/ref 17592186045417] [17592186503727 #edb/ref 1068 #edb/ref 17592186503516 #edb/ref 17592186045417] [17592186503727 #edb/ref 1069 "q-3564" #edb/ref 17592186045417] [17592186503727 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186503727 #edb/ref 1071 "Given that \n\n$$\n{(2{t}^{2}-3s)}^{4}=A{t}^{8}+B{t}^{6}s+C{t}^{4}{s}^{2}-216{t}^{2}{s}^{3}+81{s}^{4}\n$$\n\nwhere $A,B$ and $C$ are constants, determine the value of $A+B+C.$" #edb/ref 17592186045417] [17592186503727 #edb/ref 1072 #uuid "ab532852-8985-56d4-9487-9412ea181516" #edb/ref 17592186045417] [17592186503727 #edb/ref 1074 "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=4,$ $a=2{t}^{2},$ and $b=-3s.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{4}{b}^{0},\\,{a}^{3}{b}^{1},\\,{a}^{2}{b}^{2},\\,{a}^{1}{b}^{3},\\,{a}^{0}{b}^{4}.\n$$\n\nThe $4$th row in Pascal's Triangle is $(1,4,6,4,1).$ Therefore,\n\n$$\n\\begin{aligned}(2{t}^{2}-3s)^{4} & =1{a}^{4}+4{a}^{3}b+6{a}^{2}{b}^{2}+4a{b}^{3}+1{b}^{4} \\\\  & =1{(2{t}^{2})}^{4}(-3s)^{0}+4{(2{t}^{2})}^{3}(-3s)^{1}+6{(2{t}^{2})}^{2}(-3s)^{2} \\\\  & \\,+4{(2{t}^{2})}^{1}(-3s)^{3}+1{(2{t}^{2})}^{0}(-3s)^{4} \\\\  & =1(16{t}^{8})(1)+4(8{t}^{6})(-3s)+6(4{t}^{4})(9{s}^{2}) \\\\  & \\,+4(2{t}^{2})(-27{s}^{3})+1(1)(81{s}^{4}) \\\\  & =16{t}^{8}-96{t}^{6}s+216{t}^{4}{s}^{2}-216{t}^{2}{s}^{3}+81{s}^{4}.\\end{aligned}\n$$\n\nTherefore, $A=16,B=-96,$ and $C=216.$ Finally,\n\n$$\nA+B+C=16-96+216=136.\n$$" #edb/ref 17592186045417] [17592186503741 #edb/ref 1068 #edb/ref 17592186503583 #edb/ref 17592186045417] [17592186503741 #edb/ref 1069 "q-12884" #edb/ref 17592186045417] [17592186503741 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186503741 #edb/ref 1071 "Find, in descending powers of $y$ and ascending powers of $x,$ the first three terms of the binomial expansion of ${(y-x)}^{3}.$" #edb/ref 17592186045417] [17592186503741 #edb/ref 1072 #uuid "c989ddc2-999c-5079-ab1b-dc05c9512624" #edb/ref 17592186045417] [17592186503741 #edb/ref 1074 "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=3,$ $a=y,$ and $b=-x.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{3}{b}^{0},\\,{a}^{2}{b}^{1},\\,{a}^{1}{b}^{2},\\,{a}^{0}{b}^{3}.\n$$\n\nThe $3$rd row in Pascal's Triangle is $(1,3,3,1).$ Therefore,\n\n$$\n\\begin{aligned}{(y-x)}^{3} & =1{a}^{3}+3{a}^{2}b+3a{b}^{2}+1{b}^{3} \\\\  & =1(y)^{3}(-x)^{0}+3(y)^{2}(-x)^{1}+3(y)^{1}(-x)^{2}+1(y)^{0}(-x)^{3} \\\\  & =1({y}^{3})(1)+3({y}^{2})(-x)+3(y)({x}^{2})+1(1)(-{x}^{3}) \\\\  & ={y}^{3}-3{y}^{2}x+3y{x}^{2}-{x}^{3}.\\end{aligned}\n$$\n\nFinally, in descending powers of $y$ and ascending powers of $x,$ the first three terms are\n\n$$\n{y}^{3}-3{y}^{2}x+3y{x}^{2}.\n$$" #edb/ref 17592186045417] [17592186503745 #edb/ref 1068 #edb/ref 17592186503635 #edb/ref 17592186045417] [17592186503745 #edb/ref 1069 "q-3563" #edb/ref 17592186045417] [17592186503745 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186503745 #edb/ref 1071 "Find, in ascending powers of $y,$ the first three terms of the binomial expansion of ${(10y+\\frac{1}{2})}^{5}.$" #edb/ref 17592186045417] [17592186503745 #edb/ref 1072 #uuid "d6a9fa51-d96f-5308-9675-af7e9df7f105" #edb/ref 17592186045417] [17592186503745 #edb/ref 1074 "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=5,$ $a=10y,$ and $b=\\frac{1}{2}.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{5}{b}^{0},\\,{a}^{4}{b}^{1},\\,{a}^{3}{b}^{2},\\,{a}^{2}{b}^{3},\\,{a}^{1}{b}^{4},\\,{a}^{0}{b}^{5}.\n$$\n\nThe $5$th row in Pascal's Triangle is $(1,5,10,10,5,1).$ Therefore,\n\n$$\n\\begin{aligned}{(10y+\\frac{1}{2})}^{5} & =1{a}^{5}+5{a}^{4}b+10{a}^{3}{b}^{2}+10{a}^{2}{b}^{3}+5a{b}^{4}+1{b}^{5} \\\\  & =1(10y)^{5}{(\\frac{1}{2})}^{0}+5(10y)^{4}{(\\frac{1}{2})}^{1}+10(10y)^{3}{(\\frac{1}{2})}^{2} \\\\  & \\,+10(10y)^{2}{(\\frac{1}{2})}^{3}+5(10y)^{1}{(\\frac{1}{2})}^{4}+1(10y)^{0}{(\\frac{1}{2})}^{5} \\\\  & =1(100\\,000{y}^{5})(1)+5(10\\,000{y}^{4})(\\frac{1}{2})+10(1\\,000{y}^{3})(\\frac{1}{4}) \\\\  & \\,+10(100{y}^{2})(\\frac{1}{8})+5(10y)(\\frac{1}{16})+1(1)(\\frac{1}{32}) \\\\  & =100\\,000{y}^{5}+\\frac{50\\,000{y}^{4}}{2}+\\frac{10\\,000{y}^{3}}{4}+\\frac{1\\,000{y}^{2}}{8}+\\frac{50y}{16}+\\frac{1}{32} \\\\  & =100\\,000{y}^{5}+25\\,000{y}^{4}+2\\,500{y}^{3}+125{y}^{2}+\\frac{25y}{8}+\\frac{1}{32}.\\end{aligned}\n$$\n\nFinally, in ascending powers of $y$, the first three terms are\n\n$$\n\\frac{1}{32}+\\frac{25y}{8}+125{y}^{2}.\n$$" #edb/ref 17592186045417] [17592186503765 #edb/ref 1058 #edb/ref 17592186503841 #edb/ref 17592186045417] [17592186503765 #edb/ref 1062 #uuid "0fcd4859-f70e-5b53-af4b-3bf056bd41ce" #edb/ref 17592186045417] [17592186503765 #edb/ref 1063 #edb/ref 17592186503727 #edb/ref 17592186045417] [17592186503805 #edb/ref 1058 #edb/ref 17592186503765 #edb/ref 17592186045417] [17592186503805 #edb/ref 1062 #uuid "8cc0e099-5714-599b-80b4-eb693886b0be" #edb/ref 17592186045417] [17592186503805 #edb/ref 1063 #edb/ref 17592186503745 #edb/ref 17592186045417] [17592186503841 #edb/ref 1062 #uuid "febb20a8-7bec-598d-9521-3df7ff50a618" #edb/ref 17592186045417] [17592186503841 #edb/ref 1063 #edb/ref 17592186503741 #edb/ref 17592186045417]}
