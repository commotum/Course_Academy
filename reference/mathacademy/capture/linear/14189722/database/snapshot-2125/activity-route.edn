#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186503805} :activity/id #uuid "9b7f87c5-a873-5d35-a338-1eb6f31f95ee" :activity/scope {:db/id #edb/ref 17592186048677 :topic/id #uuid "b3fe0bdc-d6d3-510d-ba60-be31a59b4ba0" :topic/math-academy-id 1157} :activity/steps [{:db/id #edb/ref 17592186503765 :step/content {:db/id #edb/ref 17592186503727 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e0b8e5d-ea62-586b-acf8-47c7448fb9eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "328" :db/id #edb/ref 17592186503038} {:answer/id #uuid "3ad5cbb7-83ea-5127-9a88-0dafeb6f2337" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "136" :db/id #edb/ref 17592186503091} {:answer/id #uuid "6adb48dc-a33c-5da7-ae77-576efafa9e3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "168" :db/id #edb/ref 17592186503190} {:answer/id #uuid "83db7d2e-5441-54f0-9b72-b23bdd133079" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "320" :db/id #edb/ref 17592186503250} {:answer/id #uuid "eddbbe69-969c-5b54-965b-bba69c119ec3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "128" :db/id #edb/ref 17592186503469}] :answer-field/correct {:db/id #edb/ref 17592186503091} :answer-field/id #uuid "056e7899-7359-5aa3-9d75-0e24b35490d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503516}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ab532852-8985-56d4-9487-9412ea181516" :question/math-academy-id "q-3564" :question/problem "Given that \n\n$$\n{(2{t}^{2}-3s)}^{4}=A{t}^{8}+B{t}^{6}s+C{t}^{4}{s}^{2}-216{t}^{2}{s}^{3}+81{s}^{4}\n$$\n\nwhere $A,B$ and $C$ are constants, determine the value of $A+B+C.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=4,$ $a=2{t}^{2},$ and $b=-3s.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{4}{b}^{0},\\,{a}^{3}{b}^{1},\\,{a}^{2}{b}^{2},\\,{a}^{1}{b}^{3},\\,{a}^{0}{b}^{4}.\n$$\n\nThe $4$th row in Pascal's Triangle is $(1,4,6,4,1).$ Therefore,\n\n$$\n\\begin{aligned}(2{t}^{2}-3s)^{4} & =1{a}^{4}+4{a}^{3}b+6{a}^{2}{b}^{2}+4a{b}^{3}+1{b}^{4} \\\\  & =1{(2{t}^{2})}^{4}(-3s)^{0}+4{(2{t}^{2})}^{3}(-3s)^{1}+6{(2{t}^{2})}^{2}(-3s)^{2} \\\\  & \\,+4{(2{t}^{2})}^{1}(-3s)^{3}+1{(2{t}^{2})}^{0}(-3s)^{4} \\\\  & =1(16{t}^{8})(1)+4(8{t}^{6})(-3s)+6(4{t}^{4})(9{s}^{2}) \\\\  & \\,+4(2{t}^{2})(-27{s}^{3})+1(1)(81{s}^{4}) \\\\  & =16{t}^{8}-96{t}^{6}s+216{t}^{4}{s}^{2}-216{t}^{2}{s}^{3}+81{s}^{4}.\\end{aligned}\n$$\n\nTherefore, $A=16,B=-96,$ and $C=216.$ Finally,\n\n$$\nA+B+C=16-96+216=136.\n$$"} :step/id #uuid "0fcd4859-f70e-5b53-af4b-3bf056bd41ce" :step/next {:db/id #edb/ref 17592186503841}} {:db/id #edb/ref 17592186503805 :step/content {:db/id #edb/ref 17592186503745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b600bcd-5006-5baf-9dca-4aab5033031d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{32}+\\frac{25y}{8}+125{y}^{2}" :db/id #edb/ref 17592186503008} {:answer/id #uuid "4c839c43-5c26-510d-85ac-e2e3c39a216c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{32}+\\frac{25y}{4}+145{y}^{2}" :db/id #edb/ref 17592186503128} {:answer/id #uuid "4fb998d5-d716-53e2-a50b-72e1271eb277" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{32}+\\frac{25y}{8}-100{y}^{2}" :db/id #edb/ref 17592186503133} {:answer/id #uuid "5135b701-cd58-5dde-8d9b-989995318cb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{32}+\\frac{25y}{4}+100{y}^{2}" :db/id #edb/ref 17592186503136} {:answer/id #uuid "9799692b-0119-5014-ae4f-3ef5e9145c63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{32}+\\frac{25y}{8}+145{y}^{2}" :db/id #edb/ref 17592186503281}] :answer-field/correct {:db/id #edb/ref 17592186503008} :answer-field/id #uuid "ef1b5443-9d42-51aa-ac69-73ecc6958d74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503635}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d6a9fa51-d96f-5308-9675-af7e9df7f105" :question/math-academy-id "q-3563" :question/problem "Find, in ascending powers of $y,$ the first three terms of the binomial expansion of ${(10y+\\frac{1}{2})}^{5}.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=5,$ $a=10y,$ and $b=\\frac{1}{2}.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{5}{b}^{0},\\,{a}^{4}{b}^{1},\\,{a}^{3}{b}^{2},\\,{a}^{2}{b}^{3},\\,{a}^{1}{b}^{4},\\,{a}^{0}{b}^{5}.\n$$\n\nThe $5$th row in Pascal's Triangle is $(1,5,10,10,5,1).$ Therefore,\n\n$$\n\\begin{aligned}{(10y+\\frac{1}{2})}^{5} & =1{a}^{5}+5{a}^{4}b+10{a}^{3}{b}^{2}+10{a}^{2}{b}^{3}+5a{b}^{4}+1{b}^{5} \\\\  & =1(10y)^{5}{(\\frac{1}{2})}^{0}+5(10y)^{4}{(\\frac{1}{2})}^{1}+10(10y)^{3}{(\\frac{1}{2})}^{2} \\\\  & \\,+10(10y)^{2}{(\\frac{1}{2})}^{3}+5(10y)^{1}{(\\frac{1}{2})}^{4}+1(10y)^{0}{(\\frac{1}{2})}^{5} \\\\  & =1(100\\,000{y}^{5})(1)+5(10\\,000{y}^{4})(\\frac{1}{2})+10(1\\,000{y}^{3})(\\frac{1}{4}) \\\\  & \\,+10(100{y}^{2})(\\frac{1}{8})+5(10y)(\\frac{1}{16})+1(1)(\\frac{1}{32}) \\\\  & =100\\,000{y}^{5}+\\frac{50\\,000{y}^{4}}{2}+\\frac{10\\,000{y}^{3}}{4}+\\frac{1\\,000{y}^{2}}{8}+\\frac{50y}{16}+\\frac{1}{32} \\\\  & =100\\,000{y}^{5}+25\\,000{y}^{4}+2\\,500{y}^{3}+125{y}^{2}+\\frac{25y}{8}+\\frac{1}{32}.\\end{aligned}\n$$\n\nFinally, in ascending powers of $y$, the first three terms are\n\n$$\n\\frac{1}{32}+\\frac{25y}{8}+125{y}^{2}.\n$$"} :step/id #uuid "8cc0e099-5714-599b-80b4-eb693886b0be" :step/next {:db/id #edb/ref 17592186503765}} {:db/id #edb/ref 17592186503841 :step/content {:db/id #edb/ref 17592186503741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bac5b62-4ee8-545a-966d-5c12ee806664" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}-3{y}^{2}x-10y{x}^{2}" :db/id #edb/ref 17592186503009} {:answer/id #uuid "24ced81d-498a-516a-95d5-fb01dede7a9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}-3{y}^{2}x+3y{x}^{2}" :db/id #edb/ref 17592186503051} {:answer/id #uuid "5e2cc4e3-3a7b-5190-9ba6-ed8c80cfcd59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}-3{y}^{2}x-6y{x}^{2}" :db/id #edb/ref 17592186503165} {:answer/id #uuid "6331dd90-d13b-5bdb-bc74-b83aa99db890" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}-4{y}^{2}x+10y{x}^{2}" :db/id #edb/ref 17592186503172} {:answer/id #uuid "c137176e-2ac9-58c5-84bd-949dafa76422" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{y}^{3}-4{y}^{2}x+6y{x}^{2}" :db/id #edb/ref 17592186503368}] :answer-field/correct {:db/id #edb/ref 17592186503051} :answer-field/id #uuid "8b892af4-e657-5e7b-967c-44dc67970e0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503583}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c989ddc2-999c-5079-ab1b-dc05c9512624" :question/math-academy-id "q-12884" :question/problem "Find, in descending powers of $y$ and ascending powers of $x,$ the first three terms of the binomial expansion of ${(y-x)}^{3}.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=3,$ $a=y,$ and $b=-x.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{3}{b}^{0},\\,{a}^{2}{b}^{1},\\,{a}^{1}{b}^{2},\\,{a}^{0}{b}^{3}.\n$$\n\nThe $3$rd row in Pascal's Triangle is $(1,3,3,1).$ Therefore,\n\n$$\n\\begin{aligned}{(y-x)}^{3} & =1{a}^{3}+3{a}^{2}b+3a{b}^{2}+1{b}^{3} \\\\  & =1(y)^{3}(-x)^{0}+3(y)^{2}(-x)^{1}+3(y)^{1}(-x)^{2}+1(y)^{0}(-x)^{3} \\\\  & =1({y}^{3})(1)+3({y}^{2})(-x)+3(y)({x}^{2})+1(1)(-{x}^{3}) \\\\  & ={y}^{3}-3{y}^{2}x+3y{x}^{2}-{x}^{3}.\\end{aligned}\n$$\n\nFinally, in descending powers of $y$ and ascending powers of $x,$ the first three terms are\n\n$$\n{y}^{3}-3{y}^{2}x+3y{x}^{2}.\n$$"} :step/id #uuid "febb20a8-7bec-598d-9521-3df7ff50a618"}] :activity/title "Expanding Binomials Using Pascal's Triangle" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186502971}]}
