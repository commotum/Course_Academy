#{[{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186097454} :activity/id #uuid "955ea517-6a8e-5d79-b982-bb76840b57f8" :activity/scope {:db/id #edb/ref 17592186050926 :topic/id #uuid "725c1842-0d9b-590f-8559-27b6fce12ae4" :topic/math-academy-id 1045} :activity/steps [{:db/id #edb/ref 17592186097454 :step/content {:db/id #edb/ref 17592186097919 :tutorial/content "Sometimes, we might have a system of equations with fractional coefficients, such as the following:\n\n$$\n\\left\\{\\begin{aligned}\\frac{1}{2}x+\\frac{5}{4}y &=-4 \\\\ 7x-5y &=-2\\end{aligned}\\right.\n$$\n\nWe can turn the system into an equivalent system involving only integer coefficients. This will make it easier to solve.\n\nIn general, we multiply each equation by its lowest common denominator. In this instance, multiplying the first equation by the lowest common denominator of the fractions $(4)$ will do the job:\n\n$$\n\\left\\{\\begin{aligned}\\frac{1}{2}x+\\frac{5}{4}y &=-4 && |\\,\\times 4 \\\\ 7x-5y &=-2 && \\end{aligned}\\right.\n$$\n\nNow, we can solve the system using, for example, the elimination method. Notice that the $5y$ term in the first equation can cancel with the $-5y$ term in the second equation.\n\nAdding the two equations eliminates the $y$-variable, and allows us to solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}2x+\\cancel{5y} & =-16 \\\\ 7x-\\cancel{5y} & =-2 \\\\ 9x & =-18 \\\\ x & =-2\\end{aligned}\n$$\n\nFinally, we can substitute $x=-2$ into the equation $7x - 5y= -2$ to solve for $y\\mathbin{:}$\n\n$$\n\\begin{aligned}7x-5y & =-2 \\\\ 7(-2)-5y & =-2 \\\\ -14-5y & =-2 \\\\ -5y & =12 \\\\ y & =-\\frac{12}{5}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-2, \\,y=-\\dfrac{12}{5}.$" :tutorial/id #uuid "68821d79-90e2-580a-95fd-a5268f848ff4" :tutorial/math-academy-id 8706 :tutorial/title "Introduction"} :step/id #uuid "703fc6f0-096a-5e00-b1a3-f32d4b4f9ac6" :step/math-academy-id 148710 :step/next {:db/id #edb/ref 17592186097455}} {:db/id #edb/ref 17592186097455 :step/content {:db/id #edb/ref 17592186096634 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096394 :question/id #uuid "fb7a4815-45e8-5288-8e96-c3741f1a2097" :question/math-academy-id "e-14732"} :knowledge-point/id #uuid "14370371-529b-5f25-9963-62c0cd9a172e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049060}] :knowledge-point/questions [{:db/id #edb/ref 17592186097189} {:db/id #edb/ref 17592186097319} {:db/id #edb/ref 17592186290328} {:db/id #edb/ref 17592186290329} {:db/id #edb/ref 17592186290330} {:db/id #edb/ref 17592186290335} {:db/id #edb/ref 17592186332888}] :knowledge-point/title "Solving a System Containing Fractions in One Equation Using Elimination"} :step/id #uuid "ef39da0c-015c-59a6-af08-1693a877674f" :step/math-academy-id 148711 :step/next {:db/id #edb/ref 17592186097456}} {:db/id #edb/ref 17592186097456 :step/content {:db/id #edb/ref 17592186096635 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096395 :question/id #uuid "7f77dc95-b22e-51af-a8c2-ef60ae4f3098" :question/math-academy-id "e-14733"} :knowledge-point/id #uuid "a7eb3fea-e4cf-5537-9a33-06b9d2b35c6b" :knowledge-point/questions [{:db/id #edb/ref 17592186097193} {:db/id #edb/ref 17592186097194} {:db/id #edb/ref 17592186290337} {:db/id #edb/ref 17592186290338} {:db/id #edb/ref 17592186332889} {:db/id #edb/ref 17592186345133}] :knowledge-point/title "Solving a System Containing Fractions in Both Equations Using Elimination"} :step/id #uuid "e0176cd1-6ae7-5332-9e2d-1cdfde89e84c" :step/math-academy-id 148714 :step/next {:db/id #edb/ref 17592186097457}} {:db/id #edb/ref 17592186097457 :step/content {:db/id #edb/ref 17592186097930 :tutorial/content "We can also use the substitution method to solve systems of equations containing fractional coefficients.\n\nWe proceed as follows:\n\n- First, we multiply both equations by the lowest common denominator of the fractions in the system.\n\n- Then, we apply the substitution method as usual.\n\nLet's see an example." :tutorial/id #uuid "33f3d90d-d232-500a-b9c6-cecc2546b571" :tutorial/math-academy-id 9138 :tutorial/title "Using Substitution"} :step/id #uuid "3dad326e-86ed-5c46-93c4-a610d7869f3e" :step/math-academy-id 148717 :step/next {:db/id #edb/ref 17592186097458}} {:db/id #edb/ref 17592186097458 :step/content {:db/id #edb/ref 17592186096636 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096388 :question/id #uuid "210f48cc-8812-564d-9dae-5a8a42165ef9" :question/math-academy-id "e-14005"} :knowledge-point/id #uuid "90455606-1080-552e-a825-0cc7054b4be3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048826}] :knowledge-point/questions [{:db/id #edb/ref 17592186097190} {:db/id #edb/ref 17592186097204} {:db/id #edb/ref 17592186290315} {:db/id #edb/ref 17592186290317} {:db/id #edb/ref 17592186290318} {:db/id #edb/ref 17592186290319} {:db/id #edb/ref 17592186292609}] :knowledge-point/title "Solving a System Containing Fractions in One Equation Using Substitution"} :step/id #uuid "63a09a62-bd67-54f7-9a93-8dbf670b155c" :step/math-academy-id 148718 :step/next {:db/id #edb/ref 17592186097459}} {:db/id #edb/ref 17592186097459 :step/content {:db/id #edb/ref 17592186096637 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096389 :question/id #uuid "ff844be7-7d1e-5a1f-a4d6-1d4313f5fd2d" :question/math-academy-id "e-14006"} :knowledge-point/id #uuid "c2c880ac-41a9-543f-b7a1-b4dfcc5de99d" :knowledge-point/questions [{:db/id #edb/ref 17592186097191} {:db/id #edb/ref 17592186097192} {:db/id #edb/ref 17592186233633} {:db/id #edb/ref 17592186290320} {:db/id #edb/ref 17592186290321} {:db/id #edb/ref 17592186290331} {:db/id #edb/ref 17592186290332} {:db/id #edb/ref 17592186290334}] :knowledge-point/title "Solving a System Containing Fractions in Both Equations"} :step/id #uuid "167c3d0e-c8ed-5974-9e0e-6fe077e49acc" :step/math-academy-id 148721}] :activity/title "Systems of Linear Equations With Fractional Coeffici