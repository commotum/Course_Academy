n we add the results together:\n\n$$\n\\begin{aligned}3x({x}^{2}y+2) & = \\\\ 3x({x}^{2}y)+3x(2) & = \\\\ 3\\cdot {x}^{2+1}y+6x & = \\\\ 3{x}^{3}y+6x\\end{aligned}\n$$"} :step/id #uuid "0bc8636c-0807-5847-a5a8-7748bf0a3cfb" :step/next {:db/id #edb/ref 17592186490359}} {:db/id #edb/ref 17592186490359 :step/content {:db/id #edb/ref 17592186490289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10618d86-2776-5cce-97a6-7ca9e920abd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}^{2}-3{a}^{4}+{a}^{5}" :db/id #edb/ref 17592186489553} {:answer/id #uuid "47ed6dd6-b0d1-5887-8326-53ee4a3b117a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{a}^{6}+2{a}^{4}+5{a}^{2}" :db/id #edb/ref 17592186489681} {:answer/id #uuid "4cfe73b4-b0e8-50ac-850e-f133bc075de3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{a}^{6}+3{a}^{3}+6a" :db/id #edb/ref 17592186489696} {:answer/id #uuid "4ff82ea5-a53e-581b-bf6e-70bfe7b8756b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{a}^{5}+3{a}^{2}+6{a}^{2}" :db/id #edb/ref 17592186489706} {:answer/id #uuid "f80efb83-27d0-51e9-bdfb-27593f4de169" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{a}^{6}+3{a}^{4}+6{a}^{2}" :db/id #edb/ref 17592186490054}] :answer-field/correct {:db/id #edb/ref 17592186490054} :answer-field/id #uuid "f72b4150-b00a-5010-ad64-3981725c8bb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490204}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aad55e06-4983-5ff1-b72a-41466f8cbb81" :question/math-academy-id "q-110835" :question/problem "$-{a}^{2}(2{a}^{4}-3{a}^{2}-6)=$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}-{a}^{2}(2{a}^{4}-3{a}^{2}-6) & = \\\\ (-{a}^{2})(2{a}^{4})+(-{a}^{2})(-3{a}^{2})+(-{a}^{2})(-6) & = \\\\ ((-1)\\cdot 2)({a}^{2}\\cdot {a}^{4})+((-1)\\cdot (-3))({a}^{2}\\cdot {a}^{2})+((-1)\\cdot (-6))({a}^{2}) & = \\\\ (-2){a}^{2+4}+(3){a}^{2+2}+(6){a}^{2} & = \\\\ -2{a}^{6}+3{a}^{4}+6{a}^{2}\\end{aligned}\n$$"} :step/id #uuid "73a8d1dc-0fad-55c8-9ef4-adcb5e444d92" :step/next {:db/id #edb/ref 17592186490392}} {:db/id #edb/ref 17592186490392 :step/content {:db/id #edb/ref 17592186490282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f663968-9914-51d2-a0d5-0de18327bcb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-5{x}^{4}" :db/id #edb/ref 17592186489659} {:answer/id #uuid "aa8be593-a930-5092-b401-4276e53f4bb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-\\frac{5{x}^{4}}{2}" :db/id #edb/ref 17592186489890} {:answer/id #uuid "aab4c61d-684a-5773-b4d6-164888798bb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3x}{2}-5{x}^{4}" :db/id #edb/ref 17592186489891} {:answer/id #uuid "c9c56fc1-b117-576b-81a6-2f4abdab9754" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3x}{2}-\\frac{5{x}^{4}}{2}" :db/id #edb/ref 17592186489955} {:answer/id #uuid "f6bfd523-eab9-5a44-b230-8dd48c8d9b55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6x+5{x}^{4}" :db/id #edb/ref 17592186490049}] :answer-field/correct {:db/id #edb/ref 17592186489659} :answer-field/id #uuid "cc8bf450-8384-5183-8fd7-ee109eb1c278" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186490181}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a0223a5d-a1d6-5c40-af63-e8dfd73551f8" :question/math-academy-id "q-111117" :question/problem "$\\frac{x}{2}(6-10{x}^{3})=$" :question/worked-solution "We multiply each term inside the parentheses by the term outside the parentheses, simplify using the rules of exponents, and then we add the results together:\n\n$$\n\\begin{aligned}\\frac{x}{2}(6-10{x}^{3}) & = \\\\ (\\frac{x}{2})(6)+(\\frac{x}{2})(-10{x}^{3}) & = \\\\ (\\frac{1}{2}x)(6)+(\\frac{1}{2}x)(-10{x}^{3}) & = \\\\ (\\frac{1}{2}\\cdot 6)x+(\\frac{1}{2}\\cdot (-10))(x\\cdot {x}^{3}) & = \\\\ (3)x+(-5)({x}^{1+3}) & = \\\\ 3x-5{x}^{4}\\end{aligned}\n$$"} :step/id #uuid "fef1509a-8ac4-5f19-b17b-2194e4983c02"}] :activity/title "The Distributive Law for Polynomials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186489510}]}
