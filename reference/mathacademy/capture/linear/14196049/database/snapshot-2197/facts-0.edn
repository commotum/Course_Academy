f 1075 #edb/ref 17592186510005 #edb/ref 17592186045417] [17592186510272 #edb/ref 1075 #edb/ref 17592186510099 #edb/ref 17592186045417] [17592186510272 #edb/ref 1075 #edb/ref 17592186510222 #edb/ref 17592186045417] [17592186510272 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186510272 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186510272 #edb/ref 1078 #edb/ref 17592186509822 #edb/ref 17592186045417] [17592186510272 #edb/ref 1079 #uuid "41293c54-1759-5e11-8b8c-9e3094059bbe" #edb/ref 17592186045417] [17592186510276 #edb/ref 1075 #edb/ref 17592186509907 #edb/ref 17592186045417] [17592186510276 #edb/ref 1075 #edb/ref 17592186509911 #edb/ref 17592186045417] [17592186510276 #edb/ref 1075 #edb/ref 17592186510017 #edb/ref 17592186045417] [17592186510276 #edb/ref 1075 #edb/ref 17592186510156 #edb/ref 17592186045417] [17592186510276 #edb/ref 1075 #edb/ref 17592186510211 #edb/ref 17592186045417] [17592186510276 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186510276 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186510276 #edb/ref 1078 #edb/ref 17592186509911 #edb/ref 17592186045417] [17592186510276 #edb/ref 1079 #uuid "4a64adf4-89bb-5bcd-a5d3-aeb6554ac2a4" #edb/ref 17592186045417] [17592186510294 #edb/ref 1075 #edb/ref 17592186509720 #edb/ref 17592186045417] [17592186510294 #edb/ref 1075 #edb/ref 17592186509928 #edb/ref 17592186045417] [17592186510294 #edb/ref 1075 #edb/ref 17592186509999 #edb/ref 17592186045417] [17592186510294 #edb/ref 1075 #edb/ref 17592186510036 #edb/ref 17592186045417] [17592186510294 #edb/ref 1075 #edb/ref 17592186510110 #edb/ref 17592186045417] [17592186510294 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186510294 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186510294 #edb/ref 1078 #edb/ref 17592186509928 #edb/ref 17592186045417] [17592186510294 #edb/ref 1079 #uuid "66fe9ad0-b164-5fc3-a63f-e6ebefcc66a3" #edb/ref 17592186045417] [17592186510350 #edb/ref 1075 #edb/ref 17592186509747 #edb/ref 17592186045417] [17592186510350 #edb/ref 1075 #edb/ref 17592186509915 #edb/ref 17592186045417] [17592186510350 #edb/ref 1075 #edb/ref 17592186509949 #edb/ref 17592186045417] [17592186510350 #edb/ref 1075 #edb/ref 17592186510020 #edb/ref 17592186045417] [17592186510350 #edb/ref 1075 #edb/ref 17592186510112 #edb/ref 17592186045417] [17592186510350 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186510350 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186510350 #edb/ref 1078 #edb/ref 17592186509747 #edb/ref 17592186045417] [17592186510350 #edb/ref 1079 #uuid "dbac6049-90c6-5602-a97a-d27179f99520" #edb/ref 17592186045417] [17592186510386 #edb/ref 1068 #edb/ref 17592186510272 #edb/ref 17592186045417] [17592186510386 #edb/ref 1069 "q-25591" #edb/ref 17592186045417] [17592186510386 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186510386 #edb/ref 1071 "Which of the following number lines represents the values of $x$ that satisfy $7x+5>47$ or $3x-3\\le 30?$" #edb/ref 17592186045417] [17592186510386 #edb/ref 1072 #uuid "4351a80f-5497-5bde-b1ce-3fcb89da7609" #edb/ref 17592186045417] [17592186510386 #edb/ref 1074 "We start by solving $7x+5>47:$ \n\n$$\n\\begin{aligned}7x+5 & >47 \\\\ 7x & >47-5 \\\\ 7x & >42 \\\\ x & >\\frac{42}{7} \\\\ x & >6\\end{aligned}\n$$\n\n![](images/b2/b2b7aad327466abf2472e9058317e8f5521eba35a944482e2cc3cc12cf51095b.png)\n\nThen, we solve $3x-3\\le 30:$ \n\n$$\n\\begin{aligned}3x-3 & \\le 30 \\\\ 3x & \\le 30+3 \\\\ 3x & \\le 33 \\\\ x & \\le \\frac{33}{3} \\\\ x & \\le 11\\end{aligned}\n$$\n\n![](images/31/312b09109c1cb34d5820616c9aca887c6e48507be2c5045b128f9fa8c4cb0791.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/66/6681d256a848077367d83e215b4cb45edea86c49929c9c85c2aa32d8caaa2de7.png)\n\nTherefore, the final solution is $-\\infty <x<\\infty .$" #edb/ref 17592186045417] [17592186510414 #edb/ref 1068 #edb/ref 17592186510350 #edb/ref 17592186045417] [17592186510414 #edb/ref 1069 "q-25489" #edb/ref 17592186045417] [17592186510414 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186510414 #edb/ref 1071 "Find the set of values of $x$ that satisfy $4x-5>9$ or $3<10x+8<16.$" #edb/ref 17592186045417] [17592186510414 #edb/ref 1072 #uuid "7d1dc12b-037c-55bd-92e4-67849dd74463" #edb/ref 17592186045417] [17592186510414 #edb/ref 1074 "We start by solving $4x-5>9:$\n\n$$\n\\begin{aligned}4x-5 & >9 \\\\ 4x & >14 \\\\ x & >\\frac{14}{4} \\\\ x & >\\frac{7}{2}\\end{aligned}\n$$\n\n![](images/e3/e39459442837c3de83da860526c5f39b048d02b33b6ea0a3340efd599bb880d3.png)\n\nThen, we solve $3<10x+8<16:$\n\n$$\n\\begin{aligned}3 & <10x+8<16 \\\\ 3-8 & <10x<16-8 \\\\ -5 & <10x<8 \\\\ -\\frac{5}{10} & <x<\\frac{8}{10} \\\\ -\\frac{1}{2} & <x<\\frac{4}{5}\\end{aligned}\n$$\n\n![](images/61/611944fd64cf3638f0cfd4ae8f8a658496af927adc7b91f68e7aafdd36817272.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/11/112f50397f85c79e51650d88d2d4125cdb5479e60af579836bc3c8cd4eb22276.png)\n\nTherefore, the final solution is $x>\\frac{7}{2}$ or $-\\frac{1}{2}<x<\\frac{4}{5}.$ We can write this using interval notation as\n\n$$\n(-\\frac{1}{2},\\frac{4}{5})\\cup (\\frac{7}{2},\\infty ).\n$$" #edb/ref 17592186045417] [17592186510418 #edb/ref 1068 #edb/ref 17592186510269 #edb/ref 17592186045417] [17592186510418 #edb/ref 1069 "q-28988" #edb/ref 17592186045417] [17592186510418 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186510418 #edb/ref 1071 "Find the set of values of $x$ that satisfy $2<4x-3<3$ or $4x-3\\ge 4.$" #edb/ref 17592186045417] [17592186510418 #edb/ref 1072 #uuid "83a6d940-fad6-59a8-acb5-f275a8b09b93" #edb/ref 17592186045417] [17592186510418 #edb/ref 1074 "We start by solving $2<4x-3<3:$\n\n$$\n\\begin{aligned}2 & <4x-3<3 \\\\ 5 & <4x<6 \\\\ \\frac{5}{4} & <x<\\frac{6}{4} \\\\ \\frac{5}{4} & <x<\\frac{3}{2}\\end{aligned}\n$$\n\n![](images/ba/bac195a89ad5d09fa7753fe32bc5f4633453d37816c53330321e000579a8cb85.png)\n\nThen, we solve $4x-3\\ge 4:$\n\n$$\n\\begin{aligned}4x-3 & \\ge 4 \\\\ 4x & \\ge 7 \\\\ x & \\ge \\frac{7}{4}\\end{aligned}\n$$\n\n![](images/09/09fd2be8420b15d39149183d5b802fdcdbd20739ab7364663e0592e61aaf12df.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/6a/6ac5a412c535841b9872b1cbe4edee815e173dd43f3bb757616b7ca9a68200b8.png)\n\nTherefore, the final solution is $\\frac{5}{4}<x<\\frac{3}{2}$ or $x\\ge \\frac{7}{4}.$ We can write this using interval notation as\n\n$$\n(\\frac{5}{4},\\frac{3}{2})\\cup [\\frac{7}{4},\\infty ).\n$$" #edb/ref 17592186045417] [17592186510421 #edb/ref 1068 #edb/ref 17592186510276 #edb/ref 17592186045417] [17592186510421 #edb/ref 1069 "q-51768" #edb/ref 17592186045417] [17592186510421 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186510421 #edb/ref 1071 "Find the set of values of $w$ that satisfy $w-3\\le -1$ or $5w>25.$ Express your answer in interval notation." #edb/ref 17592186045417] [17592186510421 #edb/ref 1072 #uuid "89c9046d-3e0b-5226-98f7-31a9c44e0e5c" #edb/ref 17592186045417] [17592186510421 #edb/ref 1074 "We start by solving $w-3\\le -1:$\n\n$$\n\\begin{aligned}w-3+3 & \\le -1+3 \\\\ w & \\le 2\\end{aligned}\n$$\n\n![](images/41/41894afbf397505568367e80d14e34fe2b04a2acdfd5398bd8ba41727b8c67c6.png)\n\nThen, we solve $5w>25:$ \n\n$$\n\\begin{aligned}\\frac{5w}{5} & >\\frac{25}{5} \\\\ w & >5\\end{aligned}\n$$\n\n![](images/26/262a3e683cb8c8a67cdd58c0f138e44466c346092c7f74ec03ec1483a385056a.png)\n\nTo graph the values of $w$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/95/95d67331522c16093207de451a33bb713b42e1418d1f4c1a7aa1ef6369a51e4b.png)\n\nTherefore, the final solution is $w\\le 2$ or $w>5.$ We can write this using interval notation as\n\n$$\n(-\\infty ,2]\\cup (5,\\infty ).\n$$" #edb/ref 17592186045417] [17592186510428 #edb/ref 1068 #edb/ref 17592186510294 #edb/ref 17592186045417] [17592186510428 #edb/ref 1069 "q-28961" #edb/ref 17592186045417] [17592186510428 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186510428 #edb/ref 1071 "Find the set of values of $x$ that satisfy $3x+5>14$ or $2x-3\\le 1.$ Express your answer in interval notation." #edb/ref 17592186045417] [17592186510428 #edb/ref 1072 #uuid "9ea10a00-dd11-5690-aa60-169c6a36b74a" #edb/ref 17592186045417] [17592186510428 #edb/ref 1074 "We start by solving $3x+5>14:$\n\n$$\n\\begin{aligned}3x+5 & >14 \\\\ 3x & >9 \\\\ x & >3\\end{aligned}\n$$\n\n![](images/5d/5dca213f8266a9bd001380b30368e5996b24fa2ddb6d3aef5670befde451e77d.png)\n\nThen, we solve $2x-3\\le 1:$ \n\n$$\n\\begin{aligned}2x-3 & \\le 1 \\\\ 2x & \\le 4 \\\\ x & \\le 2\\end{aligned}\n$$\n\n![](images/45/454e1de1e32bb5e3fb03dc280076414493d9e4a9c042246be565d8550c2012f2.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/53/531c59b67623a10db6af4236187e7d50315e7068585d6a5e6882db0d1997bdce.png)\n\nTherefore, the final solution is $x\\le 2$ or $x>3.$ We can write this using interval notation as\n\n$$\n(-\\infty ,2]\\cup (3,\\infty ).\\,\n$$" #edb/ref 17592186045417]}
