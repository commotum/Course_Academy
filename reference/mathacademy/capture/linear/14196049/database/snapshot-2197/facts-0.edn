7592186045417] [17592186114357 #edb/ref 1083 #uuid "ec152d47-a4ec-5e78-905c-db1d5493f9c0" #edb/ref 17592186045417] [17592186114358 #edb/ref 1080 "images/94/9457831d1de2697c57d827c12fe1919c35fa637e5d21621a949f04b88e9010dd.png" #edb/ref 17592186045417] [17592186114358 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186114358 #edb/ref 1083 #uuid "fd7b96c5-2ad9-5774-9aa1-adcd6b32e6aa" #edb/ref 17592186045417] [17592186114359 #edb/ref 1080 "images/9c/9c045011d942bd93712aa87307994f00d9be9613c6dd547476f4fe7bd1622e19.png" #edb/ref 17592186045417] [17592186114359 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186114359 #edb/ref 1083 #uuid "35b899f8-1a73-555a-aef4-38d360590a94" #edb/ref 17592186045417] [17592186114360 #edb/ref 1080 "images/f3/f3c81896babacce5e34f1cbb9f179f6843ae46fa45b8b4399b8f7f8eb11284c8.png" #edb/ref 17592186045417] [17592186114360 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186114360 #edb/ref 1083 #uuid "4c47f2ba-4f50-55b6-a56d-d0e4351c33ba" #edb/ref 17592186045417] [17592186115153 #edb/ref 1069 "e-965" #edb/ref 17592186045417] [17592186115153 #edb/ref 1071 "Find all the values of $x$ that satisfy $12x+8 > 44$ or $5x+3 \\leq 28.$" #edb/ref 17592186045417] [17592186115153 #edb/ref 1072 #uuid "abae2e99-53b7-5d81-860c-9555ce50ec3a" #edb/ref 17592186045417] [17592186115153 #edb/ref 1074 "We start by solving $12x+8 > 44\\mathbin{:}$\n\n$$\n\\begin{aligned}12x+8 & >44 \\\\ 12x & >36 \\\\ x & >3\\end{aligned}\n$$\n\n![](images/e9/e9eec85ca2dd2a9fd01db97a5f281d16fd958e143e048f7ff3c5e7a87dd33f0a.png)\n\nThen, we solve $5x+3 \\leq 28\\mathbin{:}$\n\n$$\n\\begin{aligned}5x+3 & \\le 28 \\\\ 5x & \\le 25 \\\\ x & \\le 5\\end{aligned}\n$$\n\n![](images/c9/c9cec5cfc0e476fffe4f89f89ff0585992855e8e36fe09778029d5accd2bdc6b.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/dd/dd1330c9f2d9dc2140a3e3a4dc37ac269d134c5e367f59c9985ce04d4acd6304.png)\n\nTherefore, the final solution is $-\\infty < x < \\infty.$ We can write this using interval notation as $(-\\infty,\\infty).$" #edb/ref 17592186045417] [17592186115154 #edb/ref 1069 "e-966" #edb/ref 17592186045417] [17592186115154 #edb/ref 1071 "Find the set of values of $x$ that satisfy $6x-1 \\leq 2$ or $5x-1 > 9.$ Express your answer in interval notation." #edb/ref 17592186045417] [17592186115154 #edb/ref 1072 #uuid "81405a9f-882c-50fb-8057-41bb54515d14" #edb/ref 17592186045417] [17592186115154 #edb/ref 1074 "We start by solving $6x-1 \\leq 2\\mathbin{:}$\n\n$$\n\\begin{aligned}6x-1 & \\le 2 \\\\ 6x & \\le 3 \\\\ x & \\le \\frac{3}{6} \\\\ x & \\le \\frac{1}{2}\\end{aligned}\n$$\n\n![](images/dd/dd2c101e02e14a147371bc1b822f3bc86081dd0059ac50ae1f9131909e73e3ad.png)\n\nThen, we solve $5x -1 > 9\\mathbin{:}$\n\n$$\n\\begin{aligned}5x-1 & >9 \\\\ 5x & >10 \\\\ x & >2\\end{aligned}\n$$\n\n![](images/8b/8b252e1c42dcac87072a33b33460a887b6ec3bfa0d1511f05a004935df1911ca.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/ac/ac44f335b135463820ec0db9bc04470769fee7aabc8717edcc351893b6d8de47.png)\n\nTherefore, the final solution is $x \\leq \\dfrac{1}{2}$ or $x >2.$ We can write this using interval notation as\n\n$$\n\\begin{aligned}(-\\infty ,\\frac{1}{2}]\\cup (2,\\infty ).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186115155 #edb/ref 1069 "e-967" #edb/ref 17592186045417] [17592186115155 #edb/ref 1071 "Find the set of values of $x$ that satisfy $1 < 5x+6 \\leq 11$ or $5x-7 > 8.$" #edb/ref 17592186045417] [17592186115155 #edb/ref 1072 #uuid "dced871e-e24d-5d06-a4bb-9faa933ecac7" #edb/ref 17592186045417] [17592186115155 #edb/ref 1074 "We start by solving $1 < 5x+6 \\leq 11\\mathbin{:}$\n\n$$\n\\begin{aligned}1 & <5x+6\\le 11 \\\\ -5 & <5x\\le 5 \\\\ -1 & <x\\le 1\\end{aligned}\n$$\n\n![](images/69/69948e87bc893a2461ec6e8bb77dd72e77e6d496970e31df899400c42238cd01.png)\n\nThen, we solve $5x-7 > 8\\mathbin{:}$\n\n$$\n\\begin{aligned}5x-7 & >8 \\\\ 5x & >15 \\\\ x & >3\\end{aligned}\n$$\n\n![](images/10/10bb9a3bcc0b13b015649e2dae70a3ff3dcd361f46e6c545182031d6e095ad16.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/84/84a05cd47818c9609609c2f02bd026ccadfa77c6641dff82936630bf04fbe77e.png)\n\nThus, the final solution is $-1 <  x \\leq 1$ or $x > 3.$ We can write this using interval notation as\n\n$$\n(-1,1] \\cup (3,\\infty).\n$$" #edb/ref 17592186045417] [17592186115321 #edb/ref 1038 #edb/ref 17592186115903 #edb/ref 17592186045417] [17592186115321 #edb/ref 1038 #edb/ref 17592186115905 #edb/ref 17592186045417] [17592186115321 #edb/ref 1038 #edb/ref 17592186510386 #edb/ref 17592186045417] [17592186115321 #edb/ref 1039 "Solving For the Union of Two Opposite-Sided Linear Inequalities that Overlap" #edb/ref 17592186045417] [17592186115321 #edb/ref 1041 #edb/ref 17592186115153 #edb/ref 17592186045417] [17592186115321 #edb/ref 1042 #uuid "cdaed02f-09f2-5572-a70c-0e6979ef2167" #edb/ref 17592186045417] [17592186115322 #edb/ref 1037 #edb/ref 17592186049986 #edb/ref 17592186045417] [17592186115322 #edb/ref 1037 #edb/ref 17592186050229 #edb/ref 17592186045417] [17592186115322 #edb/ref 1038 #edb/ref 17592186115575 #edb/ref 17592186045417] [17592186115322 #edb/ref 1038 #edb/ref 17592186115577 #edb/ref 17592186045417] [17592186115322 #edb/ref 1038 #edb/ref 17592186510421 #edb/ref 17592186045417] [17592186115322 #edb/ref 1038 #edb/ref 17592186510428 #edb/ref 17592186045417] [17592186115322 #edb/ref 1039 "Finding the Union of Two Linear Inequalities" #edb/ref 17592186045417] [17592186115322 #edb/ref 1041 #edb/ref 17592186115154 #edb/ref 17592186045417] [17592186115322 #edb/ref 1042 #uuid "91a5169c-6a92-535d-85e1-8b9363b49274" #edb/ref 17592186045417] [17592186115323 #edb/ref 1037 #edb/ref 17592186050734 #edb/ref 17592186045417] [17592186115323 #edb/ref 1038 #edb/ref 17592