592186444091 :knowledge-point/_questions [{:db/id #edb/ref 17592186059860 :knowledge-point/id #uuid "b5865455-213b-5f5e-9366-420907a81259" :knowledge-point/title "Finding the Inequality Represented by a Number Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c032b333-6e7d-5a0a-9633-7aa7f47efab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186444080}] :answer-field/correct {:answer/id #uuid "c032b333-6e7d-5a0a-9633-7aa7f47efab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186444080} :answer-field/id #uuid "2839a5ea-d1c6-5bba-aa69-40c780d7f1aa" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444084} {:answer-field/choices [{:answer/id #uuid "a676959d-6ea0-5065-98f5-5e572da516c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186444078}] :answer-field/correct {:answer/id #uuid "a676959d-6ea0-5065-98f5-5e572da516c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186444078} :answer-field/id #uuid "dff4734c-e402-5cf1-b36f-6fdafdb2be9f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444089}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6797302b-db97-5343-8bcd-03d0be79c3e6" :question/math-academy-id "q-180943" :question/problem "![](images/f2/f20c29602002cfc9310e69da692096f11eede3602f481ed23199fecefdc67ec6.png)\n\nThe inequality corresponding to the highlighted region shown above is $x${{field-1}}{{field-2}}." :question/worked-solution "There is a **closed** circle at $x=-\\frac{3}{2},$ and the red arrow starts from $-\\frac{3}{2}$ and goes to the **left**. This indicates that $x$ should consist of all the values **less than or equal** to $-\\frac{3}{2}.$\n\nTherefore, the highlighted region represents $x\\le -\\frac{3}{2}.$"}] [{:db/id #edb/ref 17592186444092 :knowledge-point/_questions [{:db/id #edb/ref 17592186059860 :knowledge-point/id #uuid "b5865455-213b-5f5e-9366-420907a81259" :knowledge-point/title "Finding the Inequality Represented by a Number Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12bb050c-17f2-5b49-bd67-5399140422df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<2" :db/id #edb/ref 17592186444070} {:answer/id #uuid "3071d7a4-198e-5069-8278-a358ecc1769d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -2" :db/id #edb/ref 17592186444073} {:answer/id #uuid "73428768-362c-5264-a417-4dc542a945aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>-2" :db/id #edb/ref 17592186444075} {:answer/id #uuid "96b99f5f-b2db-5301-a474-08090ce19f3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -2" :db/id #edb/ref 17592186444077} {:answer/id #uuid "a98fc996-0d00-5ba4-ac4b-c42bb0f40474" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<-2" :db/id #edb/ref 17592186444079}] :answer-field/correct {:answer/id #uuid "a98fc996-0d00-5ba4-ac4b-c42bb0f40474" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<-2" :db/id #edb/ref 17592186444079} :answer-field/id #uuid "372bfce3-55de-5261-b54b-bd57baebf86e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444085}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b33a7a36-0a25-50da-8f78-4cfda2