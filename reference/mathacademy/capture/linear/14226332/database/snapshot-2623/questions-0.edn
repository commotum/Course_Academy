\sqrt{2+7}+{4}^{2} \\\\  & =\\sqrt{9}+16 \\\\  & =3+16 \\\\  & =19\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186544841 :knowledge-point/_questions [{:db/id #edb/ref 17592186068702 :knowledge-point/id #uuid "2b5f42de-fad6-54b6-90e1-205fdbe8a456" :knowledge-point/title "Evaluating a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "351d8210-c575-5ac4-a472-cd52a62017be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186544204} {:answer/id #uuid "3c1e55c9-211f-5df0-b5a6-dab892b30f5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186544218} {:answer/id #uuid "7736b0cd-e345-58aa-b572-63adfa1c527d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186544352} {:answer/id #uuid "92061fea-8540-57d3-bf20-97d7a67ca306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186544406} {:answer/id #uuid "da61b983-1fd7-5312-8583-91abd7c70e0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186544557}] :answer-field/correct {:answer/id #uuid "351d8210-c575-5ac4-a472-cd52a62017be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186544204} :answer-field/id #uuid "de4038dd-4a4f-5744-b3e0-9f127c2fa707" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186544760}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "850f2473-aeb8-5637-89c4-7aa5503f51fe" :question/math-academy-id "q-130574" :question/problem "Evaluate $f(2,1)$ if $f(x,y)=(x-3y)(x+y)^{2}.$" :question/worked-solution "We substitute $x=2$ and $y=1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =(x-3y)(x+y)^{2} \\\\ f(2,1) & =(2-3(1))(2+1)^{2} \\\\  & =(-1)\\cdot (3)^{2} \\\\  & =-1\\cdot 9 \\\\  & =-9\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186544830 :knowledge-point/_questions [{:db/id #edb/ref 17592186068702 :knowledge-point/id #uuid "2b5f42de-fad6-54b6-90e1-205fdbe8a456" :knowledge-point/title "Evaluating a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2522a912-6ec9-5d1e-9006-2d6a985f8f29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186544168} {:answer/id #uuid "32bfe30f-860e-5462-9664-fd946b7e9aeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186544200} {:answer/id #uuid "432f6ee1-afa8-57d6-ae54-4a08db2f0814" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186544235} {:answer/id #uuid "92fc0bde-21ea-528f-87e4-e626ffa89252" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186544411} {:answer/id #uuid "f5c66c90-2e89-5fdf-92e0-e36e92e33fac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186544622}] :answer-field/correct {:answer/id #uuid "f5c66c90-2e89-5fdf-92e0-e36e92e33fac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186544622} :answer-field/id #uuid "92a31c45-7d31-5b52-9c18-6a21a65bc008" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186544720}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e8aaddd-953c-576c-ad6b-2e4d36b66988" :question/math-academy-id "q-130578" :question/problem "Evaluate $f(1,1)$ if $f(x,y)=(3y-x)^{3}+(2x-y)^{2}.$" :question/worked-solution "We substitute $x=1$ and $y=1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =(3y-x)^{3}+(2x-y)^{2} \\\\ f(1,1) & =(3(1)-1)^{3}+(2(1)-1)^{2} \\\\  & ={2}^{3}+{1}^{2} \\\\  & =8+1 \\\\  & =9\\end{aligned}\n$$"}]}
