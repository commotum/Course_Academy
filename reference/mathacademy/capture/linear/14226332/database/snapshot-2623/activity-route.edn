answer/id #uuid "32bfe30f-860e-5462-9664-fd946b7e9aeb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186544200} {:answer/id #uuid "432f6ee1-afa8-57d6-ae54-4a08db2f0814" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186544235} {:answer/id #uuid "92fc0bde-21ea-528f-87e4-e626ffa89252" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186544411} {:answer/id #uuid "f5c66c90-2e89-5fdf-92e0-e36e92e33fac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186544622}] :answer-field/correct {:db/id #edb/ref 17592186544622} :answer-field/id #uuid "92a31c45-7d31-5b52-9c18-6a21a65bc008" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544720}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6e8aaddd-953c-576c-ad6b-2e4d36b66988" :question/math-academy-id "q-130578" :question/problem "Evaluate $f(1,1)$ if $f(x,y)=(3y-x)^{3}+(2x-y)^{2}.$" :question/worked-solution "We substitute $x=1$ and $y=1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =(3y-x)^{3}+(2x-y)^{2} \\\\ f(1,1) & =(3(1)-1)^{3}+(2(1)-1)^{2} \\\\  & ={2}^{3}+{1}^{2} \\\\  & =8+1 \\\\  & =9\\end{aligned}\n$$"} :step/id #uuid "fffd7ed9-55d6-58a4-b296-ec80636460e6"}] :activity/title "Introduction to Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544085}]}
