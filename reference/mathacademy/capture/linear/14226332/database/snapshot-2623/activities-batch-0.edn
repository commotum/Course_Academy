#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069578} :activity/id #uuid "09fac72c-e8cf-5881-9f87-6135d15c419b" :activity/scope {:db/id #edb/ref 17592186048652 :topic/id #uuid "b27952f8-4bda-51a9-b51b-57fe61de4a72" :topic/math-academy-id 470} :activity/steps [{:db/id #edb/ref 17592186069578 :step/content {:db/id #edb/ref 17592186070022 :tutorial/content "A **function** is a rule that takes a number as **input** and then **outputs** another number.\n\nFor instance, let's look at the following function: \n\n$$\nf(x) = 3x+1\n$$\n\nIn this example,\n\n- $f$ is the **name** of the function,\n\n- the number $x$ is the **input**,\n\n- the number $3x+1$ is the **output**.\n\nIf we **substitute** a number into our function in place of $x$, we get another number as output. \n\nFor example, by substituting $x={\\color{blue}{2}},$ we get\n\n$$\nf({\\color{blue}{2}}) = 3\\cdot {\\color{blue}{2}}+1 = 7.\n$$\n\nSo, the input $x={\\color{blue}{2}}$ results in an output of $7.$\n\nWe can substitute any number we like into this function! For example, if we substitute $x={\\color{red}{-2}},$ we get\n\n$$\nf({\\color{red}{-2}}) = 3\\cdot ({\\color{red}{-2}})+1 = -5.\n$$\n\nSo, the input $x={\\color{red}{-2}}$ results in an output of $-5.$" :tutorial/id #uuid "902a3802-7423-5fa0-9cf1-43856055c65c" :tutorial/math-academy-id 8783 :tutorial/title "Introduction"} :step/id #uuid "726a2782-726c-5f7e-b8e5-138b8563ebff" :step/math-academy-id 138156 :step/next {:db/id #edb/ref 17592186069579}} {:db/id #edb/ref 17592186069579 :step/content {:db/id #edb/ref 17592186068701 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068486 :question/id #uuid "38228952-21ef-5caf-9805-76e42ebf0caa" :question/math-academy-id "e-14148"} :knowledge-point/id #uuid "4e5366dd-a374-5abd-bdf6-77f378f97145" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048594} {:db/id #edb/ref 17592186049299} {:db/id #edb/ref 17592186050127}] :knowledge-point/questions [{:db/id #edb/ref 17592186069041} {:db/id #edb/ref 17592186069115} {:db/id #edb/ref 17592186069123} {:db/id #edb/ref 17592186233385} {:db/id #edb/ref 17592186233396} {:db/id #edb/ref 17592186233405} {:db/id #edb/ref 17592186233561} {:db/id #edb/ref 17592186233568} {:db/id #edb/ref 17592186233575} {:db/id #edb/ref 17592186482561} {:db/id #edb/ref 17592186482574} {:db/id #edb/ref 17592186492831} {:db/id #edb/ref 17592186492850} {:db/id #edb/ref 17592186492901} {:db/id #edb/ref 17592186522723}] :knowledge-point/title "Evaluating a Function"} :step/id #uuid "8af30817-9be7-537a-9bfb-2ce31b525422" :step/math-academy-id 138157 :step/next {:db/id #edb/ref 17592186069580}} {:db/id #edb/ref 17592186069580 :step/content {:db/id #edb/ref 17592186070023 :tutorial/content "Functions with more than one input are called **multivariable functions**. \n\nFor example, the multivariable function \n\n$$\nf(x,y)=x-y\n$$\n\ntakes in two numbers, $x$ and $y$, and returns their difference. \n\nFor multivariable functions, the order of the inputs matters. For example, if we substitute $x={\\color{blue}{3}}$ and $y={\\color{red}{2}},$ we get\n\n$$\nf({\\color{blue}{3}},{\\color{red}{2}}) = {\\color{blue}{3}}-{\\color{red}{2}}=1,\n$$\n\nwhereas if we substitute $x={\\color{red}{2}}$ and $y={\\color{blue}{3}},$ we get a different output:\n\n$$\nf({\\color{red}{2}},{\\color{blue}{3}})={\\color{red}{2}}-{\\color{blue}{3}}=-1\n$$" :tutorial/id #uuid "0bef6d6f-bda2-56dd-badb-0001ca2e4329" :tutorial/math-academy-id 8784 :tutorial/title "Evaluating Functions of More Than One Variable"} :step/id #uuid "004a3461-1ea4-5e28-807b-fea6c51ae3d4" :step/math-academy-id 138161 :step/next {:db/id #edb/ref 17592186069581}} {:db/id #edb/ref 17592186069581 :step/content {:db/id #edb/ref 17592186068702 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068487 :question/id #uuid "4e06fa0b-f3f0-5e60-9a83-67a393b4cc07" :question/math-academy-id "e-14150"} :knowledge-point/id #uuid "2b5f42de-fad6-54b6-90e1-205fdbe8a456" :knowledge-point/questions [{:db/id #edb/ref 17592186069042} {:db/id #edb/ref 17592186069116} {:db/id #edb/ref 17592186069124} {:db/id #edb/ref 17592186482526} {:db/id #edb/ref 17592186482569} {:db/id #edb/ref 17592186492852} {:db/id #edb/ref 17592186544826} {:db/id #edb/ref 17592186544830} {:db/id #edb/ref 17592186544841}] :knowledge-point/title "Evaluating a Multivariable Function"} :step/id #uuid "e7679093-39bc-5822-a013-8ae88e7f542e" :step/math-academy-id 138162}] :activity/title "Introduction to Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068995}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186492946} :activity/id #uuid "32d73cc0-19b4-59d2-9583-c970a787e5ed" :activity/scope {:db/id #edb/ref 17592186048652 :topic/id #uuid "b27952f8-4bda-51a9-b51b-57fe61de4a72" :topic/math-academy-id 470} :activity/steps [{:db/id #edb/ref 17592186492936 :step/content {:db/id #edb/ref 17592186492831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e1864d1-334e-5ed1-a854-e574404fd88a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186492368}] :answer-field/correct {:db/id #edb/ref 17592186492368} :answer-field/id #uuid "40e76a0e-856c-5852-affb-986c061df288" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186492730}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "135b40fb-5cf8-57bf-b723-676d052a026d" :question/math-academy-id "q-214832" :question/problem "If $f(x)={x}^{2}-{4}^{x-2},$ then $f(4)=${{field-1}}." :question/worked-solution "We substitute $x=4$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x) & ={x}^{2}-{4}^{x-2} \\\\ f(4) & ={4}^{2}-{4}^{4-2} \\\\  & =16-{4}^{2} \\\\  & =16-16 \\\\  & =0\\end{aligned}\n$$"} :step/id #uuid "235c73d5-ae23-5b39-841a-4951560a5eff"} {:db/id #edb/ref 17592186492946 :step/content {:db/id #edb/ref 17592186492850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "019dfabe-776e-5411-a52a-468bd8010e2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-3)=-29" :db/id #edb/ref 17592186492226} {:answer/id #uuid "1d371280-0e81-5a2f-8015-37b237435f45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-3)=21" :db/id #edb/ref 17592186492274} {:answer/id #uuid "28841ece-193a-5984-aca8-980d7d142fd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-3)=29" :db/id #edb/ref 17592186492301} {:answer/id #uuid "8bf18704-fb98-57f4-be11-81048d8cd298" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-3)=49" :db/id #edb/ref 17592186492495} {:answer/id #uuid "8d6261f9-d215-5ae3-bfdb-9431ed756997" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-3)=-21" :db/id #edb/ref 17592186492496}] :answer-field/correct {:db/id #edb/ref 17592186492496} :answer-field/id #uuid "76bd600f-4df3-5837-8db3-4c610cb01b2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492754}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3e0ff0f4-e55f-55b3-97b5-30132033682d" :question/math-academy-id "q-12993" :question/problem "Evaluate $g(-3)$, where $g(x)=(x+1)^{2}-(x-2)^{2}.$" :question/worked-solution "We substitute $x=-3$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}g(x) & =(x+1)^{2}-(x-2)^{2} \\\\ g(-3) & =(-3+1)^{2}-(-3-2)^{2} \\\\  & =(-2)^{2}-(-5)^{2} \\\\  & =4-25 \\\\  & =-21\\end{aligned}\n$$"} :step/id #uuid "45066582-f649-5b97-b9fa-5d0d0116ad1b" :step/next {:db/id #edb/ref 17592186492959}} {:db/id #edb/ref 17592186492957 :step/content {:db/id #edb/ref 17592186492852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ea9fe05-136c-54fa-8287-468235cbdb0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186492316} {:answer/id #uuid "92ff2ec6-c1ed-57da-a105-85732944baad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186492504} {:answer/id #uuid "c4dd854f-76b8-57b7-925b-6bec0085d762" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186492611} {:answer/id #uuid "c81618e6-76ad-5708-8e7c-de8c549d1cea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186492616} {:answer/id #uuid "cfb62b1a-34c6-56d6-983c-37f403386609" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186492629}] :answer-field/correct {:db/id #edb/ref 17592186492616} :answer-field/id #uuid "021d4422-18e9-573a-aea3-c035cc557e6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492706}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3e8b84ea-82b6-5138-bf4d-e73af61fdac3" :question/math-academy-id "q-130576" :question/problem "Evaluate $f(-1,2)$ if $f(x,y)=(2x-y)(x+2y).$" :question/worked-solution "We substitute $x=-1$ and $y=2$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =(2x-y)(x+2y) \\\\ f(-1,2) & =(2(-1)-2)((-1)+2(2)) \\\\  & =(-4)(3) \\\\  & =-12\\end{aligned}\n$$"} :step/id #uuid "719d3968-3672-57cb-89f5-452d75b3654a" :step/next {:db/id #edb/ref 17592186492936}} {:db/id #edb/ref 17592186492959 :step/content {:db/id #edb/ref 17592186492901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04609b43-5111-5208-b18d-1c6e7b99af15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-1)=-32" :db/id #edb/ref 17592186492230} {:answer/id #uuid "16f29b86-ae62-561b-a969-655e99943a2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-1)=27" :db/id #edb/ref 17592186492260} {:answer/id #uuid "28262c89-1983-5b3b-9aa2-400cb80daebc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-1)=31" :db/id #edb/ref 17592186492299} {:answer/id #uuid "8319ede1-808f-592a-a403-f22857a5c9d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-1)=-27" :db/id #edb/ref 17592186492481} {:answer/id #uuid "b5da9e45-5970-5fa3-92b6-9e353c5519c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "g(-1)=-39" :db/id #edb/ref 17592186492584}] :answer-field/correct {:db/id #edb/ref 17592186492230} :answer-field/id #uuid "7da22270-2bc9-5e75-a1ee-38a321ba33ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492758}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b9348d7e-52bc-5a07-98ca-88ef4ff5b0f5" :question/math-academy-id "q-31727" :question/problem "Evaluate $g(-1),$ if $g(x)=(x+3)^{2}-(x-5)^{2}.$" :question/worked-solution "We substitute $x=-1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}g(x) & =(x+3)^{2}-(x-5)^{2} \\\\ g(-1) & =((-1)+3)^{2}-((-1)-5)^{2} \\\\  & =(2)^{2}-(-6)^{2} \\\\  & =4-36 \\\\  & =-32\\end{aligned}\n$$"} :step/id #uuid "75570071-e9a9-567a-93e7-3ab7178838f5" :step/next {:db/id #edb/ref 17592186492957}}] :activity/title "Introduction to Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492206}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186544957} :activity/id #uuid "f68627be-ff54-526c-8208-8406616b4322" :activity/scope {:db/id #edb/ref 17592186048652 :topic/id #uuid "b27952f8-4bda-51a9-b51b-57fe61de4a72" :topic/math-academy-id 470} :activity/steps [{:db/id #edb/ref 17592186544957 :step/content {:db/id #edb/ref 17592186233385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f66ec8e-8bae-5a96-a179-d8e3a1dfe2cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "19" :db/id #edb/ref 17592186544118} {:answer/id #uuid "3182f7a3-fd37-55f9-853d-66f2f6f3f9d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186544197} {:answer/id #uuid "514f3bb9-096e-5c0d-b085-0e9b207d4026" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186544264} {:answer/id #uuid "5da83ddd-756d-5caa-827b-cb339578aa6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186544290} {:answer/id #uuid "76c83aeb-cd5d-5dbb-bf1d-595dc42cd722" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186544350}] :answer-field/correct {:db/id #edb/ref 17592186544118} :answer-field/id #uuid "a932ff36-ed99-5a50-893b-5f175f3ceeef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544730}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "06658175-2088-56d6-9b3b-8c8339fcc59d" :question/math-academy-id "q-130569" :question/problem "Evaluate $f(2)$, where $f(x)=\\sqrt{x+7}+{4}^{x}.$" :question/worked-solution "We substitute $x=2$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x) & =\\sqrt{x+7}+{4}^{x} \\\\ f(2) & =\\sqrt{2+7}+{4}^{2} \\\\  & =\\sqrt{9}+16 \\\\  & =3+16 \\\\  & =19\\end{aligned}\n$$"} :step/id #uuid "a3365b0a-a746-531d-b973-83372efaf126" :step/next {:db/id #edb/ref 17592186544989}} {:db/id #edb/ref 17592186544989 :step/content {:db/id #edb/ref 17592186544841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "351d8210-c575-5ac4-a472-cd52a62017be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186544204} {:answer/id #uuid "3c1e55c9-211f-5df0-b5a6-dab892b30f5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186544218} {:answer/id #uuid "7736b0cd-e345-58aa-b572-63adfa1c527d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186544352} {:answer/id #uuid "92061fea-8540-57d3-bf20-97d7a67ca306" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186544406} {:answer/id #uuid "da61b983-1fd7-5312-8583-91abd7c70e0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186544557}] :answer-field/correct {:db/id #edb/ref 17592186544204} :answer-field/id #uuid "de4038dd-4a4f-5744-b3e0-9f127c2fa707" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544760}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "850f2473-aeb8-5637-89c4-7aa5503f51fe" :question/math-academy-id "q-130574" :question/problem "Evaluate $f(2,1)$ if $f(x,y)=(x-3y)(x+y)^{2}.$" :question/worked-solution "We substitute $x=2$ and $y=1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =(x-3y)(x+y)^{2} \\\\ f(2,1) & =(2-3(1))(2+1)^{2} \\\\  & =(-1)\\cdot (3)^{2} \\\\  & =-1\\cdot 9 \\\\  & =-9\\end{aligned}\n$$"} :step/id #uuid "f310f4e8-5364-5f72-bc12-2c5b4ed0e307" :step/next {:db/id #edb/ref 17592186544995}} {:db/id #edb/ref 17592186544995 :step/content {:db/id #edb/ref 17592186544830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2522a912-6ec9-5d1e-9006-2d6a985f8f29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186544168} {:answer/id #uuid "32bfe30f-860e-5462-9664-fd946b7e9aeb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186544200} {:answer/id #uuid "432f6ee1-afa8-57d6-ae54-4a08db2f0814" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186544235} {:answer/id #uuid "92fc0bde-21ea-528f-87e4-e626ffa89252" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186544411} {:answer/id #uuid "f5c66c90-2e89-5fdf-92e0-e36e92e33fac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186544622}] :answer-field/correct {:db/id #edb/ref 17592186544622} :answer-field/id #uuid "92a31c45-7d31-5b52-9c18-6a21a65bc008" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186544720}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6e8aaddd-953c-576c-ad6b-2e4d36b66988" :question/math-academy-id "q-130578" :question/problem "Evaluate $f(1,1)$ if $f(x,y)=(3y-x)^{3}+(2x-y)^{2}.$" :question/worked-solution "We substitute $x=1$ and $y=1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =(3y-x)^{3}+(2x-y)^{2} \\\\ f(1,1) & =(3(1)-1)^{3}+(2(1)-1)^{2} \\\\  & ={2}^{3}+{1}^{2} \\\\  & =8+1 \\\\  & =9\\end{aligned}\n$$"} :step/id #uuid "fffd7ed9-55d6-58a4-b296-ec80636460e6"}] :activity/title "Introduction to Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186544085}]}
