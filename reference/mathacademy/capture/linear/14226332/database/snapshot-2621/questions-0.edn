#{[{:db/id #edb/ref 17592186233385 :knowledge-point/_questions [{:db/id #edb/ref 17592186068701 :knowledge-point/id #uuid "4e5366dd-a374-5abd-bdf6-77f378f97145" :knowledge-point/title "Evaluating a Function"}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "06658175-2088-56d6-9b3b-8c8339fcc59d" :question/math-academy-id "q-130569" :question/problem "Evaluate $f(2)$, where $f(x)=\\sqrt{x+7}+{4}^{x}.$" :question/worked-solution "We substitute $x=2$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x) & =\\sqrt{x+7}+{4}^{x} \\\\ f(2) & =\\sqrt{2+7}+{4}^{2} \\\\  & =\\sqrt{9}+16 \\\\  & =3+16 \\\\  & =19\\end{aligned}\n$$"}]}
