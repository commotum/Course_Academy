#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186111517} :activity/id #uuid "f6c3553a-0bb2-5e80-aaec-94cddf828cfd" :activity/scope {:db/id #edb/ref 17592186049668 :topic/id #uuid "094d9698-9cc9-5916-96dd-6106a9f252e9" :topic/math-academy-id 1425} :activity/steps [{:db/id #edb/ref 17592186111517 :step/content {:db/id #edb/ref 17592186111919 :tutorial/content "Many quadratic equations have two solutions. However, it's also possible for a quadratic equation to have only one solution or no real solutions at all.\n\nFor example, consider the following quadratic equation:\n\n$$\n(3x-6)^2=0\n$$\n\nWe can solve this equation using the square root method:\n\n$$\n\\begin{aligned}(3x-6)^{2} & =0 \\\\ \\sqrt{(3x-6)^{2}} & =\\sqrt{0} \\\\ |3x-6| & =0\\end{aligned}\n$$\n\nNormally, at this stage, we would obtain two solutions by setting the inside of the absolute value equal to positive or negative $(\\pm)$ the right-hand side. However, in this case, the right-hand side is zero, and $+0$ and $-0$ are both just $0.$ \n\nSo, we have only one solution:\n\n$$\n\\begin{aligned}|3x-6| & =0 \\\\ 3x-6 & =0 \\\\ 3x & =6 \\\\ x & =2\\end{aligned}\n$$" :tutorial/id #uuid "3b3899a9-dbc6-524a-b493-c57a45bfeda9" :tutorial/math-academy-id 9203 :tutorial/title "Introduction"} :step/id #uuid "5f5183e9-19ad-5c69-807b-510db46d8281" :step/math-academy-id 169632 :step/next {:db/id #edb/ref 17592186111518}} {:db/id #edb/ref 17592186111518 :step/content {:db/id #edb/ref 17592186110612 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110346 :question/id #uuid "34bac64f-5afc-5c30-bb87-15b3df40f8a9" :question/math-academy-id "e-14817"} :knowledge-point/id #uuid "637d4fe0-abb6-5050-a541-f132e78f9b8a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048963}] :knowledge-point/questions [{:db/id #edb/ref 17592186110972} {:db/id #edb/ref 17592186111183} {:db/id #edb/ref 17592186534001} {:db/id #edb/ref 17592186534086}] :knowledge-point/title "Cases When the Perfect Square is Isolated"} :step/id #uuid "6967ba33-4930-52a7-a7b4-7ffe0762be89" :step/math-academy-id 169633 :step/next {:db/id #edb/ref 17592186111519}} {:db/id #edb/ref 17592186111519 :step/content {:db/id #edb/ref 17592186110613 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110348 :question/id #uuid "b9db498b-f1e3-5d52-b23d-106895586815" :question/math-academy-id "e-14820"} :knowledge-point/id #uuid "2aca8019-3239-539c-b7a9-e1a9ca461a61" :knowledge-point/questions [{:db/id #edb/ref 17592186110958} {:db/id #edb/ref 17592186111002} {:db/id #edb/ref 17592186533989} {:db/id #edb/ref 17592186534036} {:db/id #edb/ref 17592186534038} {:db/id #edb/ref 17592186534052} {:db/id #edb/ref 17592186534060} {:db/id #edb/ref 17592186548056}] :knowledge-point/title "Finding an Unknown Parameter"} :step/id #uuid "bedc7efe-42c1-54d6-8c86-490434760721" :step/math-academy-id 169636 :step/next {:db/id #edb/ref 17592186111520}} {:db/id #edb/ref 17592186111520 :step/content {:db/id #edb/ref 17592186110614 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110349 :question/id #uuid "281c39c4-7b52-51aa-aad8-dbd40223b796" :question/math-academy-id "e-14822"} :knowledge-point/id #uuid "f637b472-4c1a-511b-9820-3e07f659eb25" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049026}] :knowledge-point/questions [{:db/id #edb/ref 17592186110973} {:db/id #edb/ref 17592186111395} {:db/id #edb/ref 17592186534004} {:db/id #edb/ref 17592186534042} {:db/id #edb/ref 17592186534085} {:db/id #edb/ref 17592186548065}] :knowledge-point/title "Factoring a Perfect Square"} :step/id #uuid "8ba31f89-a15d-5135-be97-97d5978bcacc" :step/math-academy-id 169639 :step/next {:db/id #edb/ref 17592186111521}} {:db/id #edb/ref 17592186111521 :step/content {:db/id #edb/ref 17592186111920 :tutorial/content "Let's try and solve the equation $(x+1)^2=-1$ using the square root method.\n\n$$\n\\begin{aligned}(x+1)^{2} & =-1 \\\\ \\sqrt{(x+1)^{2}} & =\\sqrt{-1} \\\\ |x+1| & =\\sqrt{-1}\\end{aligned}\n$$\n\nWe have a problem here. We cannot take the square root of a negative number. For that reason, the equation above has *no real solutions*." :tutorial/id #uuid "414b731c-3f76-57ad-985a-3d64bda214e0" :tutorial/math-academy-id 9205 :tutorial/title "Perfect Square Quadratic Equations With No Real Solutions"} :step/id #uuid "e56ff91b-5edd-5f4c-9d04-0fdf7c34e322" :step/math-academy-id 169642 :step/next {:db/id #edb/ref 17592186111522}} {:db/id #edb/ref 17592186111522 :step/content {:db/id #edb/ref 17592186110615 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110350 :question/id #uuid "1e0655ad-122c-5d94-8f8b-9e476eaf4d78" :question/math-academy-id "e-14824"} :knowledge-point/id #uuid "02785337-efe0-54cb-9433-46ff4a9c6302" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050503}] :knowledge-point/questions [{:db/id #edb/ref 17592186110959} {:db/id #edb/ref 17592186110974} {:db/id #edb/ref 17592186534081} {:db/id #edb/ref 17592186534097} {:db/id #edb/ref 17592186548010}] :knowledge-point/title "Equations With No Real Solutions"} :step/id #uuid "c852bd3c-c398-5a0c-9830-c6b1283797c0" :step/math-academy-id 169643}] :activity/title "Perfect Square Quadratic Equations with One or No Solutions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110817}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186548141} :activity/id #uuid "f093369d-b14e-5869-aee8-2e6ce5540050" :activity/scope {:db/id #edb/ref 17592186049668 :topic/id #uuid "094d9698-9cc9-5916-96dd-6106a9f252e9" :topic/math-academy-id 1425} :activity/steps [{:db/id #edb/ref 17592186548118 :step/content {:db/id #edb/ref 17592186548056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a928ab0-ab65-547b-a92d-a3572e570e71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186547483}] :answer-field/correct {:db/id #edb/ref 17592186547483} :answer-field/id #uuid "908ab81d-c6d9-5ff9-acb5-ec458e5404d7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186547911}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d0ec07f9-1330-5f73-b5fc-18b90684baa7" :question/math-academy-id "q-222414" :question/problem "Which value of $h$ gives precisely one solution to the equation ${x}^{2}-h=2?$\n\n$h=$\n{{field-1}}" :question/worked-solution "First, we solve for $x$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}-h & =2 \\\\ {x}^{2} & =2+h \\\\ \\sqrt{{x}^{2}} & =\\sqrt{2+h} \\\\ |x| & =\\sqrt{2+h}\\end{aligned}\n$$\n\nThe equation has only one solution if the right-hand side is equal to zero, and the right-hand side is zero only if the expression underneath the radical is zero. So, we solve for the value of $h$ that makes the expression under the radical equal to zero:\n\n$$\n\\begin{aligned}2+h & =0 \\\\ h & =-2\\end{aligned}\n$$\n\nTherefore, $h=-2$ will give only one solution to the equation."} :step/id #uuid "6cb7afce-9837-5cfe-8b86-1ee68f54c9e3"} {:db/id #edb/ref 17592186548141 :step/content {:db/id #edb/ref 17592186548010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fa5fc1e-a0f6-5966-bb74-7c7870f75585" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k>-1" :db/id #edb/ref 17592186547414} {:answer/id #uuid "62cb63a8-19e0-588e-9db0-dfaecf1c5151" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k<0" :db/id #edb/ref 17592186547533} {:answer/id #uuid "8cfc645a-d731-58d6-b481-e809bbf004c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k<1" :db/id #edb/ref 17592186547629} {:answer/id #uuid "9af04c2f-bbcb-574d-aea2-43165947b74d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k>1" :db/id #edb/ref 17592186547655} {:answer/id #uuid "a19aba6e-b8ff-5e28-ac1a-a1f4ccb147c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k\\le 1" :db/id #edb/ref 17592186547669}] :answer-field/correct {:db/id #edb/ref 17592186547629} :answer-field/id #uuid "d66ee932-5e98-5dcc-a364-81a8f8aab903" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547953}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6679348c-4b94-5c71-ad1e-c5e2e39219c8" :question/math-academy-id "q-23909" :question/problem "Consider the equation ${x}^{2}+1=k.$ For which values of $k$ does this equation have no real solutions?" :question/worked-solution "Let's try and solve using the square root method:\n\n$$\n\\begin{aligned}{x}^{2}+1 & =k \\\\ {x}^{2} & =k-1 \\\\ \\sqrt{{x}^{2}} & =\\sqrt{k-1} \\\\ |x| & =\\sqrt{k-1}\\end{aligned}\n$$\n\nThe equation will have no real solutions if the expression under the square root is negative, which gives the following condition:\n\n$$\nk-1<0\n$$\n\nWe solve this inequality for $k:$\n\n$$\n\\begin{aligned}k-1 & <0 \\\\ k & <1\\end{aligned}\n$$\n\nTherefore, any value of $k$ that is less than $1$ will give an equation with no real solutions."} :step/id #uuid "a323b5f9-d32e-52fb-ba12-a1996673427b" :step/next {:db/id #edb/ref 17592186548172}} {:db/id #edb/ref 17592186548172 :step/content {:db/id #edb/ref 17592186548065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "048d8ec8-9ca8-5505-93f8-840a311956fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "w=\\pm 2" :db/id #edb/ref 17592186547327} {:answer/id #uuid "475a999b-2d7e-58d1-898b-b645cc60c183" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No real solutions" :db/id #edb/ref 17592186547474} {:answer/id #uuid "4d80400f-b2d0-54b9-9ed3-e5ecca731644" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "w=2,0" :db/id #edb/ref 17592186547492} {:answer/id #uuid "aa279c53-f443-593f-af08-6cc45f50bcb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "w=\\frac{2\\pm \\sqrt{5}}{3}" :db/id #edb/ref 17592186547691} {:answer/id #uuid "b00e279b-684b-51a7-94af-527772a83d48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "w=2" :db/id #edb/ref 17592186547699}] :answer-field/correct {:db/id #edb/ref 17592186547699} :answer-field/id #uuid "34420ca9-d74d-5ceb-bb68-1f1b54c6ad1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547868}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e09c7bc1-cc56-5292-bdc6-0155dadb5e01" :question/math-academy-id "q-52265" :question/problem "Given that  $64-64w+16{w}^{2}=0$, find $w.$" :question/worked-solution "First, notice that the left-hand side is a perfect square. It just needs to be factored:\n\n$$\n\\begin{aligned}64-64w+16{w}^{2} & =0 \\\\ {8}^{2}-2\\cdot 8\\cdot 4w+(4w)^{2} & =0 \\\\ (8-4w)^{2} & =0\\end{aligned}\n$$\n\nFrom here, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}\\sqrt{(8-4w)^{2}} & =\\sqrt{0} \\\\ |8-4w| & =0 \\\\ 8-4w & =0 \\\\ 4w & =8 \\\\ w & =2\\end{aligned}\n$$"} :step/id #uuid "d818973d-772d-5615-9419-e6057af17ee9" :step/next {:db/id #edb/ref 17592186548118}}] :activity/title "Perfect Square Quadratic Equations with One or No Solutions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186547312}]}
