i>j</mi><mn>2</mn></msup><mo>+</mo><msup><mi>k</mi><mn>2</mn></msup><mo>−</mo><mi>k</mi><mn>2</mn><mi>j</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mi>j</mi><mn>2</mn></msup><mo>−</mo><mn>2</mn><mi>j</mi><mi>k</mi><mo>+</mo><msup><mi>k</mi><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mi>j</mi><mo>−</mo><mi>k</mi><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
