#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186495212} :activity/id #uuid "28e4707c-4172-5804-bb5b-31ce59766c25" :activity/scope {:db/id #edb/ref 17592186048702 :topic/id #uuid "b66180ad-be0f-549e-967d-4ba9e0cb40fa" :topic/math-academy-id 1318} :activity/steps [{:db/id #edb/ref 17592186495179 :step/content {:db/id #edb/ref 17592186495125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f7a6999-f8f4-59e0-98e0-015a493f1d2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{21}}{7}" :db/id #edb/ref 17592186494555} {:answer/id #uuid "89a01196-ecc5-54e7-97a0-a62b76df60ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9\\sqrt{7}}{7}" :db/id #edb/ref 17592186494626} {:answer/id #uuid "9af2d328-e266-562e-9983-62f0ac8950e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{63}}{7}" :db/id #edb/ref 17592186494673} {:answer/id #uuid "c52da2ef-45c8-5cc1-8d40-dcc039628f7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{7}}{7}" :db/id #edb/ref 17592186494781} {:answer/id #uuid "e2e5fe20-ac58-5d90-b58b-91cc21887122" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{7}}{21}" :db/id #edb/ref 17592186494859}] :answer-field/correct {:db/id #edb/ref 17592186494555} :answer-field/id #uuid "a3bf9e83-273c-5b34-b405-581696dd025a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494994}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ae109d24-9fc2-5d5a-8052-a06c5bb12363" :question/math-academy-id "q-68978" :question/problem "$\\frac{\\sqrt{3}}{\\sqrt{7}}=$" :question/worked-solution "To remove the radical $\\sqrt{7}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{7}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}}{\\sqrt{7}} & = \\\\ \\frac{\\sqrt{3}}{\\sqrt{7}}\\cdot \\frac{\\sqrt{7}}{\\sqrt{7}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{7}}{(\\sqrt{7})^{2}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{7}}{7} & \\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}\\cdot \\sqrt{7}}{7} & = \\\\ \\frac{\\sqrt{3\\cdot 7}}{7} & = \\\\ \\frac{\\sqrt{21}}{7} & \\end{aligned}\n$$"} :step/id #uuid "052fe2c5-40e8-568d-a7e6-4596a024895e" :step/next {:db/id #edb/ref 17592186495204}} {:db/id #edb/ref 17592186495204 :step/content {:db/id #edb/ref 17592186495047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b1b5fba-fdd8-5128-9a27-cbfb26a9e1c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{5}}{5}" :db/id #edb/ref 17592186494634} {:answer/id #uuid "a519e98f-6574-52d8-8a8c-870b9a1a0093" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{15}}{5}" :db/id #edb/ref 17592186494694} {:answer/id #uuid "aabd3a95-2d4e-5129-96fc-6ea2f3661cd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{15}" :db/id #edb/ref 17592186494712} {:answer/id #uuid "e7a916dc-cd3b-563d-8a31-4a98472fc173" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{30}}{5}" :db/id #edb/ref 17592186494867} {:answer/id #uuid "e7d7cf72-8c4a-588a-92d9-55fa1de43c10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{5}" :db/id #edb/ref 17592186494868}] :answer-field/correct {:db/id #edb/ref 17592186494694} :answer-field/id #uuid "a8d63188-077b-53b4-bf34-059f17e831ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494996}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0166b33d-cd65-51f2-b6e7-3a4bfb8c5ea3" :question/math-academy-id "q-68979" :question/problem "$\\frac{\\sqrt{3}}{\\sqrt{5}}=$" :question/worked-solution "To remove the radical $\\sqrt{5}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{5}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}}{\\sqrt{5}} & = \\\\ \\frac{\\sqrt{3}}{\\sqrt{5}}\\cdot \\frac{\\sqrt{5}}{\\sqrt{5}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{5}}{(\\sqrt{5})^{2}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{5}}{5} & \\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}\\cdot \\sqrt{5}}{5} & = \\\\ \\frac{\\sqrt{3\\cdot 5}}{5} & = \\\\ \\frac{\\sqrt{15}}{5} & \\end{aligned}\n$$"} :step/id #uuid "61942193-2d0a-56bf-a25c-0114eb566388"} {:db/id #edb/ref 17592186495212 :step/content {:db/id #edb/ref 17592186495091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ba6809-48d6-572e-a887-ee445eb17ac5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{3}}{5}" :db/id #edb/ref 17592186494341} {:answer/id #uuid "9541ae86-02b9-5a82-a43c-89a200374f23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186494660} {:answer/id #uuid "e1e2d6be-e1f7-5b7f-b3e5-50ad0be9ac8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{5}" :db/id #edb/ref 17592186494854} {:answer/id #uuid "e294048f-eaaa-5e29-aeaf-312c92a62877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{15}}{5}" :db/id #edb/ref 17592186494858} {:answer/id #uuid "eafd7840-0948-5dc2-99ff-617d14233294" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186494875}] :answer-field/correct {:db/id #edb/ref 17592186494854} :answer-field/id #uuid "8e4335f4-0a43-52eb-920e-e7c8066542cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494981}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6053c699-eed7-5f85-aa40-b59fc9957b5c" :question/math-academy-id "q-68973" :question/problem "$\\frac{3}{5\\sqrt{3}}=$" :question/worked-solution "To remove the radical $\\sqrt{3}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{3}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3}{5\\sqrt{3}} & = \\\\ \\frac{3}{5\\sqrt{3}}\\cdot \\frac{\\sqrt{3}}{\\sqrt{3}} & = \\\\ \\frac{3\\sqrt{3}}{5\\cdot (\\sqrt{3})^{2}} & = \\\\ \\frac{3\\sqrt{3}}{5\\cdot 3} & = \\\\ \\frac{\\sqrt{3}}{5} & \\end{aligned}\n$$"} :step/id #uuid "707ae3ed-9b4d-5300-a0d5-6ced1c7337f1" :step/next {:db/id #edb/ref 17592186495179}}] :activity/title "Rationalizing Denominators" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494302}]}
