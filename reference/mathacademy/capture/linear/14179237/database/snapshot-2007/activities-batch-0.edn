#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186106568} :activity/id #uuid "c03def6f-6404-54a2-be07-37a61c9f3ebb" :activity/scope {:db/id #edb/ref 17592186048702 :topic/id #uuid "b66180ad-be0f-549e-967d-4ba9e0cb40fa" :topic/math-academy-id 1318} :activity/steps [{:db/id #edb/ref 17592186106568 :step/content {:db/id #edb/ref 17592186107169 :tutorial/content "Whenever we have a fraction that contains a square root in the denominator, such as $\\dfrac{3}{\\sqrt{2}},$ we often want to find an equivalent fraction that has no square root in the denominator.\n\nTo find this equivalent fraction, all we need to do is multiply both the numerator and the denominator by the square root in the denominator. This process is known as **rationalizing the denominator**.\n\nFor example, for the fraction $\\dfrac{3}{\\sqrt{2}},$ we can remove the square root from the denominator by multiplying both the numerator and denominator by the square root:\n\n$$\n\\begin{aligned}\\frac{3}{\\sqrt{2}} & = \\\\ \\frac{3}{\\sqrt{2}}\\cdot \\frac{\\sqrt{2}}{\\sqrt{2}} & = \\\\ \\frac{3\\sqrt{2}}{{(\\sqrt{2})}^{2}} & = \\\\ \\frac{3\\sqrt{2}}{2}\\end{aligned}\n$$\n\nSo, when we rationalize the denominator in the fraction  $\\dfrac{3}{\\sqrt{2}},$ we get the equivalent fraction $\\dfrac{3 \\sqrt{2} }{ 2 }$ that has no square root in the denominator." :tutorial/id #uuid "a73f63d7-83ef-5e72-a786-df2bbc85ddd0" :tutorial/math-academy-id 9068 :tutorial/title "Introduction"} :step/id #uuid "8ca3d4bb-c694-5bb7-b380-f5c1233f1952" :step/math-academy-id 127307 :step/next {:db/id #edb/ref 17592186106569}} {:db/id #edb/ref 17592186106569 :step/content {:db/id #edb/ref 17592186105704 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105481 :question/id #uuid "72b4f2ac-747d-500b-9839-f557502cbbec" :question/math-academy-id "e-14638"} :knowledge-point/id #uuid "7e7047fd-14f2-5325-8959-f24fa670f453" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049733} {:db/