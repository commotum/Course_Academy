#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186101638} :activity/id #uuid "fa3b0123-3cb4-59d6-8bc7-e2be683f501b" :activity/scope {:db/id #edb/ref 17592186050647 :topic/id #uuid "5c0a40b2-d1c1-52e2-9f18-dd59bcf6cdb7" :topic/math-academy-id 1251} :activity/steps [{:db/id #edb/ref 17592186101638 :step/content {:db/id #edb/ref 17592186101945 :tutorial/content "Suppose that we have the graph of $y=f(x)$ shown below. What would the graph of $y=f(x)+2$ look like, and how does it relate to the original curve?\n\n![](images/1a/1a55ebd7e9dc656f3a2488debf14e63e655ed7548b76f63c26498f09d96d65ca.png)\n\nFor each point on the graph of $y=f(x)$ there is a corresponding point on the graph of $y=f(x)+2$ with the same $x$-value and a $y$-value that is two units greater. So let's create a table of points.\n\n$$\n\\begin{aligned}\\text{Points on [math]y=f(x)[/math]} & \\text{Points on [math]y=f(x)+2[/math]} \\\\ (-2,0) & (-2,2) \\\\ (0,1.5) & (0,3.5) \\\\ (1,2) & (1,4) \\\\ (3,-3) & (3,-1)\\end{aligned}\n$$\n\nEvery point on the graph of $y=f(x)+2$ is precisely two units above a point on the graph of $y=f(x)$. The graph of $y=f(x)+2$ is an **upward vertical translation** of the graph of $y=f(x)$ by two units.\n\n![](images/66/6636d65acf9cd34d818d3d9e12a7b7de36dec4ceb70c7503a08751f971868855.png)\n\nOn the other hand, for each point on the graph of $y=f(x)$ there is a corresponding point on the graph of $y=f(x)-2$ with the same $x$-value and a $y$-value that is two units smaller. So let's create a table of points.\n\n$$\n\\begin{aligned}\\text{Points on [math]y=f(x)[/math]} & \\text{Points on [math]y=f(x)-2[/math]} \\\\ (-2,0) & (-2,-2) \\\\ (0,1.5) & (0,-0.5) \\\\ (1,2) & (1,0) \\\\ (3,-3) & (3,-5)\\end{aligned}\n$$\n\nEvery point on the graph of $y=f(x)-2$ is two units below a point on the graph of $y=f(x)$. The graph of $y=f(x)-2$ is a **downward vertical translation** of the graph of $y=f(x)$ by two units.\n\n![](images/72/72588aaa92f5b4bf9923c381cf5ad28ebb7288e77f6442549d0ffe1fdac3dc48.png)" :tutorial/id #uuid "198f4c8f-65df-5b93-951c-12fd4d9dfd12" :tutorial/math-academy-id 2809 :tutorial/title "Introduction"} :step/id #uuid "f72e4e92-9df5-551e-bf9d-c6db356cd3c2" :step/math-academy-id 14720 :step/next {:db/id #edb/ref 17592186101640}} {:db/id #edb/ref 17592186101639 :step/content {:db/id #edb/ref 17592186100847 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100668 :question/id #uuid "8c6c748a-f067-527d-91aa-3ead12bb569d" :question/math-academy-id "e-4106"} :knowledge-point/id #uuid "ac31493b-30d0-5ed1-8422-f1f475e3c576" :knowledge-point/questions [{:db/id #edb/ref 17592186101355} {:db/id #edb/ref 17592186101356} {:db/id #edb/ref 17592186529163} {:db/id #edb/ref 17592186529184}] :knowledge-point/title "Identifying Points that Must Lie on a Translated Curve"} :step/id #uuid "4f45cbb5-b569-58b3-95eb-fbb98b10614a" :step/math-academy-id 14721} {:db/id #edb/ref 17592186101640 :step/content {:db/id #edb/ref 17592186100848 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100669 :question/id #uuid "7b856c88-45bf-54a5-80c4-134a7544742c" :question/math-academy-id "e-4107"} :knowledge-point/id #uuid "a8224846-04e6-531d-9415-9a18d2afddb6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048838}] :knowledge-point/questions [{:db/id #edb/ref 17592186101203} {:db/id #edb/ref 17592186101206} {:db/id #edb/ref 17592186529146}] :knowledge-point/title "Identifying the Graph of a Translated Function"} :step/id #uuid "e7dee1eb-ff16-5f46-b872-2042f7c92dcc" :step/math-academy-id 14722 :step/next {:db/id #edb/ref 17592186101704}} {:db/id #edb/ref 17592186101641 :step/content {:db/id #edb/ref 17592186100849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100670 :question/id #uuid "85d2f012-deb3-55dc-8e38-51bfe62eab20" :question/math-academy-id "e-4108"} :knowledge-point/id #uuid "10557b22-4b4b-5860-abcb-0dcd96a5743d" :knowledge-point/questions [{:db/id #edb/ref 17592186101215} {:db/id #edb/ref 17592186101354} {:db/id #edb/ref 17592186529106} {:db/id #edb/ref 17592186529108} {:db/id #edb/ref 17592186549967} {:db/id #edb/ref 17592186549975}] :knowledge-point/title "Identifying the Vertical Shift of a Translated Function"} :step/id #uuid "ba6cf136-6d59-5437-b6e3-d44b8ca10f7b" :step/math-academy-id 14723 :step/next {:db/id #edb/ref 17592186101639}} {:db/id #edb/ref 17592186101704 :step/content {:db/id #edb/ref 17592186100887 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100712 :question/id #uuid "1c57d35a-24ad-51ae-b00d-0f55396f045d" :question/math-academy-id "e-5007"} :knowledge-point/id #uuid "d982b565-2c41-5687-8d00-86b971bfb18b" :knowledge-point/questions [{:db/id #edb/ref 17592186101353} {:db/id #edb/ref 17592186101384} {:db/id #edb/ref 17592186529167} {:db/id #edb/ref 17592186529192}] :knowledge-point/title "Identifying the Graph of an Original Function Given a Translated Function"} :step/id #uuid "0612808f-4124-5dbf-a60c-734f4636a504" :step/math-academy-id 18128 :step/next {:db/id #edb/ref 17592186101705}} {:db/id #edb/ref 17592186101705 :step/content {:db/id #edb/ref 17592186101972 :tutorial/content "Consider the solid curve $y=f(x)$ and the dashed curve $y=f(x)+b$ shown below. What is the value of $b?$\n\n![](images/b0/b058da1ea31e45f3029f1542642d802a35da7280f315a37ea92044e5c322fbd4.png)\n\nThe graph of $y=f(x)+b$ can be obtained from the graph of $y=f(x)$ by translating it $6$ units down. So, $b=-6.$" :tutorial/id #uuid "f2c0aba0-7e3b-5a75-83b0-7386793a015b" :tutorial/math-academy-id 3295 :tutorial/title "Identifying the Shift"} :step/id #uuid "f13d8d49-a65d-58fb-9ad0-f736406fedbb" :step/math-academy-id 18130 :step/next {:db/id #edb/ref 17592186101641}}] :activity/title "Vertical Translations of Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101091}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186550036} :activity/id #uuid "87827238-a8af-5c97-9258-aa69642e3f16" :activity/scope {:db/id #edb/ref 17592186050647 :topic/id #uuid "5c0a40b2-d1c1-52e2-9f18-dd59bcf6cdb7" :topic/math-academy-id 1251} :activity/steps [{:db/id #edb/ref 17592186550023 :step/content {:db/id #edb/ref 17592186101355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b476e027-410c-5b7e-957f-bcd73763b2de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,-1)" :db/id #edb/ref 17592186099340} {:answer/id #uuid "6322842e-0357-5c8d-a2fc-2fbea9483242" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,-5)" :db/id #edb/ref 17592186099343} {:answer/id #uuid "28f9ac9c-0bcc-55e5-b0c1-5964a0642420" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,3)" :db/id #edb/ref 17592186549403} {:answer/id #uuid "8ce03ece-86f6-59a3-8602-b78e5b08064c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,2)" :db/id #edb/ref 17592186549587} {:answer/id #uuid "ca9d69c3-29e9-597f-b0dc-ddca64600d9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,1)" :db/id #edb/ref 17592186549692}] :answer-field/correct {:db/id #edb/ref 17592186549403} :answer-field/id #uuid "e8f48646-2ca1-54ba-9599-4b59d99425d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186099339}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e2e3553c-e4d2-5b12-8a22-fe04a05189b4" :question/math-academy-id "q-26123" :question/problem "The point $P$ with coordinates $(2,-1)$ lies on the curve $y=f(x)-3.$ Which of the following points must lie on $y=f(x)+1?$" :question/worked-solution "**Method 1**\n\nThe graph of $y=f(x)+1$ is obtained by translating the graph of $y=f(x)-3$ by $4$ units *up.* \n\nHence, if the point $(2,-1)$ lies on $y=f(x)-3$, then the point \n\n$$\n(2,-1+4)=(2,3)\n$$\n\nlies on $y=f(x)+1.$\n\n![](images/46/468f1e720d1a4834f1547b0cd2fcb8c9bff1e0342d2d98e33a62bbf9d473701a.png)\n\n**Method 2**\n\nAs $(2,-1)$ lies on $y=f(x)-3$, we have:\n\n$$\n\\begin{aligned}f(2)-3 & =-1 \\\\ f(2) & =-1+3 \\\\ f(2) & =2\\end{aligned}\n$$\n\nNow, if $x=2$ then\n\n$$\n\\begin{aligned}y & =f(2)+1 \\\\  & =2+1 \\\\  & =3.\\end{aligned}\n$$\n\nSo, the point $(2,3)$ must lie on $y=f(x)+1.$"} :step/id #uuid "01e04307-8907-58c2-83c8-12dc65028b26" :step/next {:db/id #edb/ref 17592186550082}} {:db/id #edb/ref 17592186550036 :step/content {:db/id #edb/ref 17592186549967 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e4c5e1-b54f-532d-b0ea-bdebad3f0d95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186549322} {:answer/id #uuid "152655c8-8d0e-5d61-a322-4d75404f1f47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186549351} {:answer/id #uuid "5fa7c064-ac96-5662-8162-cff29cbeaa27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186549505} {:answer/id #uuid "6c3df13a-ef61-5c67-b5ac-9720cf6ce5b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186549520} {:answer/id #uuid "d37c0952-f531-540d-b472-b096be136b1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186549707}] :answer-field/correct {:db/id #edb/ref 17592186549520} :answer-field/id #uuid "559dfa33-1ae3-585f-bec7-2a590aa14d78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549836}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6bd4c5ad-d5d4-5f1c-b1a3-32f3fc367847" :question/math-academy-id "q-26056" :question/problem "The point $Q$ with coordinates $(-1,1)$ lies on the curve $y=f(x)$ and the point $R$ with coordinates $(-1,-2)$ lies on the curve $y=g(x).$ If the curve $y=g(x)$ is related to $y=f(x)$ via the transformation $g(x)=f(x)+k$, then what is the value of $k?$" :question/worked-solution "First, notice that the point $R(-1,-2)$ lies $3$ units below the point $Q(-1,1).$ So, the graph of $y=g(x)$ can be obtained from the graph of $y=f(x)$ by shifting it $3$ units down. \n\n![](images/7d/7d470919b374a5796b49ff81f893f37f5bb76afd4546a25459259f3b6339529b.png)\n\nAs a result, $k=-3.$"} :step/id #uuid "27c6e6f7-3931-5a76-88e4-d6e4ba6f3303" :step/next {:db/id #edb/ref 17592186550023}} {:db/id #edb/ref 17592186550082 :step/content {:db/id #edb/ref 17592186549975 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19683c15-6c13-53b8-8aea-5ea6854b2db1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186549366} {:answer/id #uuid "268c40f5-7adb-5466-bcd8-a03a2de00544" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186549398} {:answer/id #uuid "81da2310-6e25-5259-a85e-a5baa6d90882" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186549557} {:answer/id #uuid "bacd3f0c-4868-59b8-9c7f-afe842c347b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186549665} {:answer/id #uuid "ef25ba64-af1d-535e-b7a0-c43c1199f31b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186549757}] :answer-field/correct {:db/id #edb/ref 17592186549557} :answer-field/id #uuid "1e5978fb-3e4b-580d-a4fb-b9e5b65e85b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549814}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "841b4d8f-31c4-51b2-96fd-34cf02a240b8" :question/math-academy-id "q-86632" :question/problem "The point $Q$ with coordinates $(-2,1)$ lies on the curve $y=f(x)$ and the point $R$ with coordinates $(-2,-1)$ lies on the curve $y=g(x).$ If the curve $y=g(x)$ is related to $y=f(x)$ via the transformation $g(x)=f(x)+k$, then what is the value of $k?$" :question/worked-solution "First, notice that the point $R(-2,-1)$ lies $2$ units below the point $Q(-2,1).$ So, the graph of $y=g(x)$ can be obtained from the graph of $y=f(x)$ by shifting it $2$ units down. \n\n![](images/15/158488a446217332d0b70d2e6b116bc1e17e7e5b205ff5ebe4289a75ef05fa05.png)\n\nAs a result, $k=-2.$"} :step/id #uuid "9f9b1109-0afb-53ad-9318-3e619c5a55d9"}] :activity/title "Vertical Translations of Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186549310}]}
