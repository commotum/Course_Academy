#{[{:db/id #edb/ref 17592186087431 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087880 :knowledge-point/id #uuid "5e905212-8796-5742-a83e-892fdf66eced" :knowledge-point/title "Constructing an Expression that Represents the Derivative of a Function"}] :question/id #uuid "36199fc1-505f-5179-9eeb-bec0534bab5f" :question/math-academy-id "e-128" :question/problem "Given that $f(x) = x^2,$ what is $f'(x)$ according to the definition of the derivative?" :question/worked-solution "The derivative $f '(x)$ is given by the limit \n\n$$\n\\lim_{h\\to 0} \\dfrac{f(x+h)-f(x)}{h} .\n$$\n\nSince $f(x) = x^2$,  we have that $f(x+h) = (x+h)^2.$ Hence,  we get\n\n$$\n\\displaystyle f'(x)=\\lim_{h\\to 0} \\dfrac{(x+h)^2-x^2}{h} .\n$$"}] [{:db/id #edb/ref 17592186087432 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087881 :knowledge-point/id #uuid "9c6f3c71-d11b-59af-bad6-5f5c0ff6634f" :knowledge-point/title "Calculating the Derivative of a Function"}] :question/id #uuid "7fb64010-dc03-5db5-b5d1-563d2fe44b6d" :question/math-academy-id "e-130" :question/problem "Given $y =x^2,$ calculate $\\dfrac{\\textrm{d}y}{\\textrm{d}x}$ using the limit of a difference quotient." :question/worked-solution "We let $y=f(x)$ and apply the formula for the derivative:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{h\\to 0}\\frac{f(x+h)-f(x)}{h} \\\\  & ={lim}_{h\\to 0}\\frac{(x+h)^{2}-{x}^{2}}{h} \\\\  & ={lim}_{h\\to 0}\\frac{{x}^{2}+2xh+{h}^{2}-{x}^{2}}{h} \\\\  & ={lim}_{h\\to 0}\\frac{2xh+{h}^{2}}{h} \\\\  & ={lim}_{h\\to 0}(\\frac{2xh}{h}+\\frac{{h}^{2}}{h}) \\\\  & ={lim}_{h\\to 0}(2x+h) \\\\  & =2x+0 \\\\  & =2x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186537953 :knowledge-point/_questions [{:db/id #edb/ref 17592186087880 :knowledge-point/id #uuid "5e905212-8796-5742-a83e-892fdf66eced" :knowledge-point/title "Constructing an Expression that Represents the Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31269d34-bf9b-5beb-8795-1803e3e8f873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={lim}_{h\\to 0}(\\frac{(x+h)-(2x+1)}{h})" :db/id #edb/ref 17592186537335} {:answer/id #uuid "7ab95eba-e6f1-50b3-93cf-0ac8c24f9109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={lim}_{h\\to 0}(\\frac{2(x+h)+1-(2x+1)}{h})" :db/id #edb/ref 17592186537468} {:answer/id #uuid "957167b9-3ca4-5394-9fd5-5962be3124cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={lim}_{h\\to 0}(\\frac{(x+h)+x}{h})" :db/id #edb/ref 17592186537512} {:answer/id #uuid "b02f15e2-ec30-5b7e-8dd6-d998fa88fd43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={lim}_{h\\to 0}(\\frac{2x+1-(x+h+1)}{h})" :db/id #edb/ref 17592186537562} {:answer/id #uuid "daeffdac-cd8f-5ed5-9255-0868e62e563e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={lim}_{h\\to 0}(\\frac{2x+1-(x+h)}{h})" :db/id #edb/ref 17592186537667}] :answer-field/correct {:answer/id #uuid "7ab95eba-e6f1-50b3-93cf-0ac8c24f9109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={lim}_{h\\to 0}(\\frac{2(x+h)+1-(2x+1)}{h})" :db/id #edb/ref 17592186537468} :answer-field/id #uuid "f4d0ff0d-7860-5a8a-a6e6-4fb8f62ae866" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537874}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab9ad28a-3195-5102-ad22-90c2dc511297" :question/math-academy-id "q-101957" :question/problem "Given that $f(x)=2x+1$, what is ${f}^{′}(x)$ according to the definition of the derivative?" :question/worked-solution "The derivative ${f}^{′}(x)$ is given by the limit \n\n$$\n{lim}_{h\\to 0}(\\frac{f(x+h)-f(x)}{h}).\n$$\n\nSince $f(x)=2x+1$,  we have that $f(x+h)=2(x+h)+1.$ Hence,  we get\n\n$$\n{f}^{′}(x)={lim}_{h\\to 0}(\\frac{2(x+h)+1-(2x+1)}{h}).\n$$"}] [{:db/id #edb/ref 17592186537884 :knowledge-point/_questions [{:db/id #edb/ref 17592186087880 :knowledge-point/id #uuid "5e905212-8796-5742-a83e-892fdf66eced" :knowledge-point/title "Constructing an Expression that Represents the Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33e3ce1d-b9dc-5b4f-9df8-3667487f8eec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={lim}_{h\\to 0}(\\frac{x-7(x+h)}{h})" :db/id #edb/ref 17592186537339} {:answer/id #uuid "39ae355b-9bd5-55ce-b14f-de747087c884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={lim}_{h\\to 0}(\\frac{(x+h)+(-7x)}{h})" :db/id #edb/ref 17592186537349} {:answer/id #uuid "aaa427b3-244e-5498-9b61-671f781cd044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={lim}_{h\\to 0}(\\frac{(x+h)+x}{h})" :db/id #edb/ref 17592186537551} {:answer/id #uuid "c3af6ada-214b-5c5d-8e42-88d836757eb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={lim}_{h\\to 0}(\\frac{-7(x+h)-(-7x)}{h})" :db/id #edb/ref 17592186537604} {:answer/id #uuid "fee23737-7fe3-58db-a3d3-3228bf0805d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={lim}_{h\\to 0}(\\frac{-7x-(x+h)}{h})" :db/id #edb/ref 17592186537754}] :answer-field/correct {:answer/id #uuid "c3af6ada-214b-5c5d-8e42-88d836757eb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)={lim}_{h\\to 0}(\\frac{-7(x+h)-(-7x)}{h})" :db/id #edb/ref 17592186537604} :answer-field/id #uuid "a05863a1-93f7-5544-886b-fd004cc1deef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537832}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d6da41c-2674-5be8-ab4e-fb7795b804a5" :question/math-academy-id "q-101958" :question/problem "Given that $f(x)=-7x$, what is ${f}^{′}(x)$ according to the definition of the derivative?" :question/worked-solution "The derivative ${f}^{′}(x)$ is given by the limit \n\n$$\n{lim}_{h\\to 0}(\\frac{f(x+h)-f(x)}{h}).\n$$\n\nSince $f(x)=-7x$,  we have that $f(x+h)=-7(x+h).$ Hence,  we get\n\n$$\n{f}^{′}(x)={lim}_{h\\to 0}(\\frac{-7(x+h)-(-7x)}{h}).\n$$"}] [{:db/id #edb/ref 17592186537947 :knowledge-point/_questions [{:db/id #edb/ref 17592186087881 :knowledge-point/id #uuid "9c6f3c71-d11b-59af-bad6-5f5c0ff6634f" :knowledge-point/title "Calculating the Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f05b0eb8-1f64-572b-9eb7-f009dba2ee76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8x+5" :db/id #edb/ref 17592186537724}] :answer-field/correct {:answer/id #uuid "f05b0eb8-1f64-572b-9eb7-f009dba2ee76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8x+5" :db/id #edb/ref 17592186537724} :answer-field/id #uuid "a93c79b4-53dc-5d15-9856-ca96c8afc783" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186537839}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a35127e9-e5f3-508e-9d5a-b3279aa78b1a" :question/math-academy-id "q-340405" :question/problem "Use the definition of the derivative to find ${f}^{′}(x)$ if  $f(x)=-4{x}^{2}+5x.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The definition of ${f}^{′}(x)$ is\n\n$$\n\\begin{aligned}{f}^{′}(x)={lim}_{h\\to 0}\\frac{f(x+h)-f(x)}{h}.\\end{aligned}\n$$\n\nApplying this to $f(x)=-4{x}^{2}+5x$, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={lim}_{h\\to 0}(\\frac{-4(x+h)^{2}+5(x+h)-(-4{x}^{2}+5x)}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{-4({x}^{2}+2xh+{h}^{2})+5x+5h+4{x}^{2}-5x}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{-4{x}^{2}-8xh-4{h}^{2}+5x+5h+4{x}^{2}-5x}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{-8xh-4{h}^{2}+5h}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{h(-8x-4h+5)}{h}) \\\\  & ={lim}_{h\\to 0}(-8x-4h+5) \\\\  & =-8x+5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186537931 :knowledge-point/_questions [{:db/id #edb/ref 17592186087881 :knowledge-point/id #uuid "9c6f3c71-d11b-59af-bad6-5f5c0ff6634f" :knowledge-point/title "Calculating the Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c63b9a2-0026-5b42-b9d7-d33ef6517d2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=1" :db/id #edb/ref 17592186537353} {:answer/id #uuid "a025d814-8eca-5444-bebb-105d5442a824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=\\frac{1}{2}" :db/id #edb/ref 17592186537529} {:answer/id #uuid "ae3bfc58-7850-5886-b64b-df0f4824039b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=4" :db/id #edb/ref 17592186537558} {:answer/id #uuid "d603a1ab-9c62-5f2a-a0d7-d9ad36ff8382" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=0" :db/id #edb/ref 17592186537653} {:answer/id #uuid "da196b53-b10f-53b6-a009-921baa312c45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=2" :db/id #edb/ref 17592186537664}] :answer-field/correct {:answer/id #uuid "da196b53-b10f-53b6-a009-921baa312c45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(x)=2" :db/id #edb/ref 17592186537664} :answer-field/id #uuid "11a32983-ce2f-531f-8a50-70b77c16b7ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537766}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "779ee099-0fc5-5dca-bd3b-ce3793ba0e8c" :question/math-academy-id "q-47689" :question/problem "Given that $f(x)=2x$, the derivative ${f}^{′}(x)$ can be computed using the definition of the derivative. The first few steps of this calculation are shown below:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={lim}_{h\\to 0}\\frac{f(x+h)-f(x)}{h} \\\\  & ={lim}_{h\\to 0}\\frac{2(x+h)-2x}{h} \\\\  & =…\\end{aligned}\n$$\n\nFinish the calculation, and hence find ${f}^{′}(x).$" :question/worked-solution "By proceeding with the remaining calculations we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={lim}_{h\\to 0}\\frac{f(x+h)-f(x)}{h} \\\\  & ={lim}_{h\\to 0}\\frac{2(x+h)-2x}{h} \\\\  & ={lim}_{h\\to 0}\\frac{2x+2h-2x}{h} \\\\  & ={lim}_{h\\to 0}\\frac{2h}{h} \\\\  & ={lim}_{h\\to 0}2 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, ${f}^{′}(x)=2.$"}]}
