/ref 17592186432249} :answer-field/id #uuid "157d5a2e-d085-508a-9da0-cb6dc3051b92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186432263}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "41453e98-41d7-58be-8d18-9e4d9fb3b015" :question/math-academy-id "q-99445" :question/problem "$(-12)\\cdot 5=$" :question/worked-solution "We have a product of a negative number $(-12)$ and a positive number $(5).$ So the product will be negative:\n\n$$\n(-12)\\cdot 5=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we multiply $12$ by $5$ without any signs: $12\\cdot 5=60.$ So, we get\n\n$$\n(-12)\\cdot 5=-60.\n$$"} :step/id #uuid "f36c3bc9-dffc-556f-850b-d49b74b01e63" :step/next {:db/id #edb/ref 17592186432270}}] :activity/title "Multiplying Positive Numbers With Negative Numbers" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186432247}]}
