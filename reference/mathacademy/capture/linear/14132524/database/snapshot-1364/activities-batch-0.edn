wer/value "3" :db/id #edb/ref 17592186432254} {:answer/id #uuid "93c8453d-19e9-5ddd-9a36-ec95a5b00a21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-40" :db/id #edb/ref 17592186432255} {:answer/id #uuid "d6abe23d-56fc-532a-bb7e-e99ea8c70774" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186432259} {:answer/id #uuid "e5c4b205-5359-5074-8da7-88a25ea2aae0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186432261}] :answer-field/correct {:db/id #edb/ref 17592186432255} :answer-field/id #uuid "a7bb4bae-cb21-52d3-82b9-df23def72715" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186432265}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f61276cc-cdad-58a5-b095-9a6df738789c" :question/math-academy-id "q-75641" :question/problem "$8\\cdot (-5)=$" :question/worked-solution "We have a product of a positive number $(8)$ and a negative number $(-5).$ So the product will be negative:\n\n$$\n8\\cdot (-5)=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we multiply $8$ by $5$ without any signs: $8\\cdot 5=40.$ So, we get\n\n$$\n8\\cdot (-5)=-40.\n$$"} :step/id #uuid "7a56f76f-a41d-5110-9135-464d4d9ebfe9" :step/next {:db/id #edb/ref 17592186432271}} {:db/id #edb/ref 17592186432270 :step/content {:db/id #edb/ref 17592186432266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37ffd596-d09b-5a5a-8699-6e99b79ba9b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13.5" :db/id #edb/ref 17592186432250} {:answer/id #uuid "46616c34-fc66-526c-a3bc-bc82e5353ba0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-18" :db/id #edb/ref 17592186432252} {:answer/id #uuid "a0777173-65ea-5c6c-973b-575d95bd84ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10.5" :db/id #edb/ref 17592186432256} {:answer/id #uuid "b6ac5b2d-8317-5da5-b9df-63f80e513633" :a