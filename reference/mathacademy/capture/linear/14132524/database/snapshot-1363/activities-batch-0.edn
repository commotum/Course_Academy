#{[{:activity/first-step {:db/id #edb/ref 17592186065293} :activity/id #uuid "87fa48fe-260e-5396-9f68-9ac420c9528d" :activity/scope {:db/id #edb/ref 17592186049349 :topic/id #uuid "ede67d03-aa98-5b07-b1a1-e05056a85575" :topic/math-academy-id 298} :activity/steps [{:db/id #edb/ref 17592186065293 :step/content {:db/id #edb/ref 17592186065415 :tutorial/content "Multiplying with negative numbers can be summed up by two simple rules.\n\nThe first rule says that when we multiply a negative number by a positive number, the result (**product**) is a negative number. We can picture this multiplication rule as\n\n$$\n(-)\\cdot(+) = (-)or(+)\\cdot(-) = (-)\n$$\n\nFor instance, let's find out the value of $(-3) \\cdot 10$.\nHere, we have a product of a negative number $\\color{red}(-3)$ and a positive one ${\\color{blue}(10)}$. So the product will be negative:\n$30$\nNow, to compute the number that goes in the box, we multiply $3$ by $10$ without any signs:\n\n$$\n3 \\cdot 10 = 30\n$$\n\nSo, we get\n\n$$\n{\\color{red}(-3)} \\cdot {\\color{blue}10} = {\\color{red} -30}\n$$\n\nNote that multiplication is **commutative**, meaning it doesn't matter in what order we multiply two numbers. Commutativity means that we're allowed to swap the numbers, which gives\n\n$$\n{\\color{red}(-3)} \\cdot {\\color{blue}10} = {\\color{blue}10}\\cdot {\\color{red}(-3)} = {\\color{red} -30}\n$$" :tutorial/id #uuid "1eb02261-90e4-51bc-a24e-dabdedaafa63" :tutorial/math-academy-id 8105 :tutorial/title "Introduction"} :step/id #uuid "480bb98f-29a4-57e1-9342-972680f415f8" :step/math-academy-id 82238 :step/next {:db/id #edb/ref 17592186065294}} {:db/id #edb/ref 17592186065294 :step/content {:db/id #edb/ref 17592186064363 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063939 :question/id #uuid "9e3473f6-80c1-5559-b29f-ac0bcb2f3a13" :question/math-academy-id "e-12967"} :knowledge-point/id #uuid "75901336-1d0e-51f1-acde-d6eb784d9f82" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049429}] :knowledge-point/questions [{:db/id #edb/ref 17592186064550} {:db/id #edb/ref 17592186064576}] :knowledge-point/title "Multiplying a Positive Number by a Negative Number"} :step/id #uuid "cb9bb839-e0dc-5aca-9cc9-ae22d07a3486" :step/math-academy-id 82239 :step/next {:db/id #edb/ref 17592186065295}} {:db/id #edb/ref 17592186065295 :step/content {:db/id #edb/ref 17592186064364 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063940 :question/id #uuid "e4e645fe-d1cd-584c-b6a3-4e75e1170a34" :question/math-academy-id "e-12969"} :knowledge-point/id #uuid "9cb97145-a93a-5df3-8dbe-6777d21601c8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051030}] :knowledge-point/questions [{:db/id #edb/ref 17592186064767} {:db/id #edb/ref 17592186064940} {:db/id #edb/ref 17592186064974} {:db/id #edb/ref 17592186424824}] :knowledge-point/title "Multiplying a Positive Number by a Negative Number With Decimals"} :step/id #uuid "b387ed41-0522-5959-a882-fcd13a445bf5" :step/math-academy-id 82242}] :activity/title "Multiplying Positive Numbers With Negative Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064401}]}
