b/ref 17592186045417] [17592186570686 #edb/ref 1075 #edb/ref 17592186570335 #edb/ref 17592186045417] [17592186570686 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186570686 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186570686 #edb/ref 1078 #edb/ref 17592186570300 #edb/ref 17592186045417] [17592186570686 #edb/ref 1079 #uuid "e6989b96-6453-5959-889b-dc271201d958" #edb/ref 17592186045417] [17592186570693 #edb/ref 1075 #edb/ref 17592186570504 #edb/ref 17592186045417] [17592186570693 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186570693 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186570693 #edb/ref 1078 #edb/ref 17592186570504 #edb/ref 17592186045417] [17592186570693 #edb/ref 1079 #uuid "fae03ebe-384c-56a0-b28b-7e7a4779e500" #edb/ref 17592186045417] [17592186570709 #edb/ref 1068 #edb/ref 17592186570686 #edb/ref 17592186045417] [17592186570709 #edb/ref 1069 "q-104295" #edb/ref 17592186045417] [17592186570709 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186570709 #edb/ref 1071 "Given $f(x)=\\frac{5-{x}^{4}}{6{x}^{2}},$ find ${f}^{‴}(x).$" #edb/ref 17592186045417] [17592186570709 #edb/ref 1072 #uuid "224e49e4-5633-5d71-8ad0-69cc905bfd6e" #edb/ref 17592186045417] [17592186570709 #edb/ref 1074 "First, notice that we can rewrite the function as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{5-{x}^{4}}{6{x}^{2}} \\\\  & =\\frac{5}{6{x}^{2}}-\\frac{{x}^{2}}{6}\\end{aligned}\n$$\n\nNow, computing the first derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{5}{6{x}^{2}}-\\frac{{x}^{2}}{6}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{5}{6}{x}^{-2}-\\frac{{x}^{2}}{6}) \\\\  & =-\\frac{5}{3}{x}^{-3}-\\frac{x}{3}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}{f}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{5}{3}{x}^{-3}-\\frac{x}{3}) \\\\  & =5{x}^{-4}-\\frac{1}{3}.\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}{f}^{‴}(x) & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{-4}-\\frac{1}{3}) \\\\  & =-20{x}^{-5} \\\\  & =-\\frac{20}{{x}^{5}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186570716 #edb/ref 1068 #edb/ref 17592186570693 #edb/ref 17592186045417] [17592186570716 #edb/ref 1069 "q-343087" #edb/ref 17592186045417] [17592186570716 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186570716 #edb/ref 1071 "Given $f(x)=\\frac{1}{2}{x}^{2}+\\operatorname{sin}⁡x+3x,$ we have\n\n${f}^{‴}(x)=$ \n{{field-1}}." #edb/ref 17592186045417] [17592186570716 #edb/ref 1072 #uuid "30675b2a-1249-5c56-916f-1fdddcd8a518" #edb/ref 17592186045417] [17592186570716 #edb/ref 1074 "Computing the first derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{x}^{2}+\\operatorname{sin}⁡x+3x) \\\\  & =x+\\operatorname{cos}⁡x+3.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}{f}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(x+\\operatorname{cos}⁡x+3) \\\\  & =1-\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}{f}^{‴}(x) & =\\frac{\\text{d}}{\\text{d}x}(1-\\operatorname{sin}⁡x) \\\\  & =-\\operatorname{cos}⁡x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186570784 #edb/ref 1068 #edb/ref 17592186570647 #edb/ref 17592186045417] [17592186570784 #edb/ref 1069 "q-105266" #edb/ref 17592186045417] [17592186570784 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186570784 #edb/ref 1071 "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=7x-4{x}^{2}.$" #edb/ref 17592186045417] [17592186570784 #edb/ref 1072 #uuid "f67b31bd-a1c3-55b5-a439-944a03b0aa36" #edb/ref 17592186045417] [17592186570784 #edb/ref 1074 "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(7x-4{x}^{2}) \\\\  & =7-2\\cdot 4x \\\\  & =7-8x.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(7-8x) \\\\  & =0-8 \\\\  & =-8.\\end{aligned}\n$$" #edb/ref 17592186045417]}
