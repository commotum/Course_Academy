#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111613} :activity/id #uuid "dc520173-74e8-57e7-ad6f-9e7a82ef78e1" :activity/scope {:db/id #edb/ref 17592186049892 :topic/id #uuid "1c2006c0-c4c4-5ff8-8fa2-7f9dd3693f49" :topic/math-academy-id 1500} :activity/steps [{:db/id #edb/ref 17592186111613 :step/content {:db/id #edb/ref 17592186111906 :tutorial/content "For any two distinct points, there is always one (and only one) line that passes through them.\n\nFor example, the line passing through the points $P$ and $Q$ is $\\overset{\\longleftrightarrow}{PQ},$ while the line that passes through $A$ and $B$ is $\\overset{\\longleftrightarrow}{AB}\\mathbin{:}$\n\n![](images/8c/8c79a551e7ced71de157ea292baa3d7f38afaca4ea76ee467fc4add1b28ed33f.png)\n\nHowever, given three or more points, there is not always a line that passes through all of them.\n\nFor example, for the three points $F, G,$ and $H$ below, it is impossible to draw a single straight line that passes through all of them.\n\n![](images/30/30361c0bd49e571e317746f2d88848626da52e5ddbcda8fe9b6f496e4aff6b69.png)\n\nHowever, it is *sometimes* possible to draw a line through three (or more) points. In such cases, we say that the points are **collinear**.\n\nFor example, the points $M,$ $N,$ and $O$ shown below are collinear since they all lie on the same line.\n\n![](images/bf/bf3de55518c21de30718b2d9fee7032139c89aa3a4a963b8346b457ceafbeada.png)" :tutorial/id #uuid "051ac95a-dc63-5270-a5fa-a498a36c8297" :tutorial/math-academy-id 6732 :tutorial/title "Introduction"} :step/id #uuid "2afa6da4-491a-5a31-8b50-09bd210fc929" :step/math-academy-id 40727 :step/next {:db/id #edb/ref 17592186111615}} {:db/id #edb/ref 17592186111614 :step/content {:db/id #edb/ref 17592186110674 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110295 :question/id #uuid "a042ba66-3567-5b06-84e6-344ad0043bbc" :question/math-academy-id "e-10748"} :knowledge-point/id #uuid "f67c3319-1153-51ed-a57a-f85c06c7e76c" :knowledge-point/questions [{:db/id #edb/ref 17592186110905} {:db/id #edb/ref 17592186111394} {:db/id #edb/ref 17592186441206} {:db/id #edb/ref 17592186441209} {:db/id #edb/ref 17592186441210} {:db/id #edb/ref 17592186441212} {:db/id #edb/ref 17592186527150}] :knowledge-point/title "Determining Whether Points on Intersecting Lines Are Collinear"} :step/id #uuid "08fe2b06-8140-5116-be8c-f9a047f0e538" :step/math-academy-id 40728} {:db/id #edb/ref 17592186111615 :step/content {:db/id #edb/ref 17592186110675 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110296 :question/id #uuid "76902823-634d-5525-afc5-5f2a98cea481" :question/math-academy-id "e-10749"} :knowledge-point/id #uuid "9ef4e321-841e-5933-b5e4-ff7dab6c5275" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049350}] :knowledge-point/questions [{:db/id #edb/ref 17592186110928} {:db/id #edb/ref 17592186110929} {:db/id #edb/ref 17592186441205} {:db/id #edb/ref 17592186441207} {:db/id #edb/ref 17592186441208} {:db/id #edb/ref 17592186441211} {:db/id #edb/ref 17592186524990} {:db/id #edb/ref 17592186531608} {:db/id #edb/ref 17592186531655} {:db/id #edb/ref 17592186531657}] :knowledge-point/title "Identifying Collinear Points on a Grid"} :step/id #uuid "f4bbacca-99b9-57fe-b9c5-a2075ef9663b" :step/math-academy-id 40731 :step/next {:db/id #edb/ref 17592186111614}}] :activity/title "Collinear Points" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110859}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186531680} :activity/id #uuid "1e277d26-3cd4-5f96-8fca-4798fc8680e1" :activity/scope {:db/id #edb/ref 17592186049892 :topic/id #uuid "1c2006c0-c4c4-5ff8-8fa2-7f9dd3693f49" :topic/math-academy-id 1500} :activity/steps [{:db/id #edb/ref 17592186531676 :step/content {:db/id #edb/ref 17592186531655 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fe09bc4-31c7-568f-be87-02c28b0907ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186530929} {:answer/id #uuid "4160685f-7ffd-5ade-9845-5db543cb5598" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186531003} {:answer/id #uuid "88414189-b1f0-5218-8c18-851c2eff974f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186531162} {:answer/id #uuid "c0e424dc-7e89-5bd6-b6e8-84d2d9dea85f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186531271} {:answer/id #uuid "ec66f155-3fe5-5781-8a8a-8f6d97fb5483" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186531341}] :answer-field/correct {:db/id #edb/ref 17592186531341} :answer-field/id #uuid "ff504920-6a29-5379-af64-ee43cc431a4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531555}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f44be398-7e63-5657-97ac-ad7b78dba187" :question/math-academy-id "q-155051" :question/problem "![](images/01/01aba7550fb134b1f3a93276dc8f3b91794844ea21254c2c75a0702a443a60e3.png)\n\nWhich of the diagrams above shows three collinear points?" :question/worked-solution "Three (or more) points are collinear if a straight line passes through all points.\n\nWith that in mind, let's examine our diagrams in turn.\n\n- Diagram I shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/63/6310ff39996be529bc44e5058ef9710400f0c8089196a57e7f4eb541703e53ae.png)\n\n- Diagram II shows three points that are *not* collinear. We can't draw a straight line that passes through all three points.\n\n![](images/63/6334d2bc1fda6390b6ec542afb8cc37d4f76322b98d41ca6bbb3af3c8d735c8f.png)\n\n- Diagram III shows three points that are *not* collinear. We can't draw a straight line that passes through all three points.\n\n![](images/89/8939cff2d7cc8ca9a08c7be63517ffb900e49b769edc5c2454119f4da25904cc.png)\n\n \n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "2a5c9c16-0e21-58e2-96cf-f2e548e46cfb"} {:db/id #edb/ref 17592186531680 :step/content {:db/id #edb/ref 17592186111394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb0faf0f-5618-54d9-89a7-80c77140df42" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186110090} {:answer/id #uuid "f86d63d7-74b3-530e-91d9-8ff31f761445" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186110091} {:answer/id #uuid "479e057f-e9e5-52df-ba3d-412259c39194" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186110092} {:answer/id #uuid "6af6be9b-f51c-5bcf-b37a-cca78ef06518" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186110093} {:answer/id #uuid "6ccc7e23-2f5e-5bc7-b82f-ad9500638c6f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186110094}] :answer-field/correct {:db/id #edb/ref 17592186110091} :answer-field/id #uuid "cfb9f9a8-0793-550e-8000-7cbb65bc3ee6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186110089}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7d9ca7f7-8b8f-513d-9055-bfafe5f332c2" :question/math-academy-id "q-7484" :question/problem "![](images/d1/d1fd1460fe24739d1c1bf1a7cad39da6775860b0764eaa4b41fffaae073e3a50.png)\n\nGiven the picture shown above, which of the following statements are true?\n\nI. $E$, $G$ and $H$ are collinear\n\nII. $A$, $B$ and $G$ are **not** collinear\n\nIII. $B$, $F$ and $H$ are collinear" :question/worked-solution "Three (or more) points are collinear if a straight line passes through all points.\n\nWith that in mind, let's examine our diagrams in turn.\n\n- Statement I is true. There is a straight line that passes through these three points.\n\n![](images/fb/fb82255ac578efc90bb070dab669a19950387cab7d9011de4d5d0d94dd9de505.png)\n\n- Statement II is true. We can't draw a straight line that passes through these three points.\n\n![](images/2c/2c20ebe076b3e655b7709ccb337c68d4aa8505bfabdb5a8755e5a1410642d612.png)\n\n- Statement III is false. We can't draw a straight line that passes through these three points.\n\n![](images/98/9859ea0144923d69e37d64130910608f6fc3e7afe09d74af19a5402030e0d3cb.png)\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "31152b20-4269-5712-98a1-7b73a2698d69" :step/next {:db/id #edb/ref 17592186531693}} {:db/id #edb/ref 17592186531693 :step/content {:db/id #edb/ref 17592186531608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23cd9f25-8435-55d5-b158-0660cc1531d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186530942} {:answer/id #uuid "2caca10d-0d8d-59c0-ac12-d60468871006" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186530962} {:answer/id #uuid "7b3c3526-8bc0-510b-9c22-722374cff8f4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186531135} {:answer/id #uuid "d4bd80d9-e2bb-50d2-8715-080b48547162" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186531303} {:answer/id #uuid "f3622c66-9de1-5f33-ba19-0af4be6d1d74" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186531360}] :answer-field/correct {:db/id #edb/ref 17592186531360} :answer-field/id #uuid "3c338420-c385-5c49-a1ce-a9b479af623d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531439}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "73e5dd6e-2c47-5055-afc2-9cc17f2d620e" :question/math-academy-id "q-155031" :question/problem "![](images/97/97faa2ca35485f76f012475a9ba2b6af7938cfc86728bddd560cf3da59fff197.png)\n\nWhich of the diagrams above shows three collinear points?" :question/worked-solution "Three (or more) points are collinear if a straight line passes through all points.\n\nWith that in mind, let's examine our diagrams in turn.\n\n- Diagram I shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/f5/f52592db0fee86e26318d6d2de9d7f685f1fb9f5d416628a04878857f1c54b54.png)\n\n- Diagram II shows three points that are *not* collinear. We can't draw a straight line that passes through all three points.\n\n![](images/76/76f0da764caf0237a2d30d32d593886d8df6c348368fe889f7447be781b6faf1.png)\n\n- Diagram III shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/97/9778abd955cdc9b705800eba8f3d0d635af1c6a5fd5724583bdb32a943c6d44f.png)\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "765a5c07-dcf7-5bfa-9917-01071a277a0b" :step/next {:db/id #edb/ref 17592186531676}}] :activity/title "Collinear Points" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186530854}]}
