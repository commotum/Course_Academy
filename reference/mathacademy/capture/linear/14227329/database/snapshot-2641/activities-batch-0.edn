#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186079356} :activity/id #uuid "1bf76cea-4646-53df-8ca6-de484707e26b" :activity/scope {:db/id #edb/ref 17592186050157 :topic/id #uuid "32ad96da-6870-504d-ad58-7d14df8bea1a" :topic/math-academy-id 668} :activity/steps [{:db/id #edb/ref 17592186079356 :step/content {:db/id #edb/ref 17592186079727 :tutorial/content "The explicit formula for the $n$th term of an arithmetic sequence is given by\n\n$$\na_n = a_1 + (n-1)d,\n$$\n\nwhere $a_1$ is the first term and $d$ is a common difference.\n\nTo illustrate how this works, suppose we want to find the $20$th term of the following arithmetic sequence:\n\n$$\n{\\color{blue}2}, \\: 5, \\: 8, \\: 11, \\: 14, \\: \\ldots\n$$\n\nThe first term is $a_1={\\color{blue}2},$ and the common difference is \n\n$$\nd=5-2={\\color{red}3}.\n$$\n\nSo, we can write the formula for the $n$th term of the sequence as follows:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =2+(n-1)(3) \\\\  & =2+3n-3 \\\\  & =3n-1\\end{aligned}\n$$\n\nTo find the $20$th term, we can use this formula with $n=20\\mathbin{:}$\n\n$$\n\\begin{aligned}{a}_{n} & =3n-1 \\\\ {a}_{20} & =3(20)-1 \\\\  & =60-1 \\\\  & =59\\end{aligned}\n$$\n\nTherefore, the $20$th term is $a_{20}=59.$ Using the formula was much quicker than writing out all $20$ terms of the sequence!" :tutorial/id #uuid "8a96e03d-29c4-5df5-9a65-7ba58b42a896" :tutorial/math-academy-id 8909 :tutorial/title "Introduction"} :step/id #uuid "cf2f182d-a477-54e3-bd8c-09edda20c9b2" :step/math-academy-id 187824 :step/next {:db/id #edb/ref 17592186079357}} {:db/id #edb/ref 17592186079357 :step/content {:db/id #edb/ref 17592186078463 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078181 :question/id #uuid "3efc515d-87bd-5e90-b2ea-4bdf954302e5" :question/math-academy-id "e-14382"} :knowledge-point/id #uuid "952a09bc-d1fa-5e2d-b146-ec28e1c960a9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049579} {:db/id #edb/ref 17592186050575}] :knowledge-point/questions [{:db/id #edb/ref 17592186078778} {:db/id #edb/ref 17592186079081} {:db/id #edb/ref 17592186519566}] :knowledge-point/title "Finding the Formula for the Nth Term of an Arithmetic Sequence"} :step/id #uuid "99e17149-4a8f-564b-9fb1-cd6f65290056" :step/math-academy-id 187825 :step/next {:db/id #edb/ref 17592186079358}} {:db/id #edb/ref 17592186079358 :step/content {:db/id #edb/ref 17592186078464 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078182 :question/id #uuid "fa9f6acf-041b-5030-a32a-065b562a7f49" :question/math-academy-id "e-14384"} :knowledge-point/id #uuid "0f6a51df-54c6-5019-a5a0-05949d440895" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652}] :knowledge-point/questions [{:db/id #edb/ref 17592186078807} {:db/id #edb/ref 17592186079073} {:db/id #edb/ref 17592186519562} {:db/id #edb/ref 17592186519600} {:db/id #edb/ref 17592186535942} {:db/id #edb/ref 17592186535978} {:db/id #edb/ref 17592186548025} {:db/id #edb/ref 17592186548048}] :knowledge-point/title "Finding the Formula for the Nth Term of an Arithmetic Sequence in Function Notation"} :step/id #uuid "dde6f52c-3ffd-528c-a9fd-314db5ab20d5" :step/math-academy-id 187828 :step/next {:db/id #edb/ref 17592186079359}} {:db/id #edb/ref 17592186079359 :step/content {:db/id #edb/ref 17592186078465 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078184 :question/id #uuid "27c03d66-4cbe-567c-8846-4d6b0382bd89" :question/math-academy-id "e-14387"} :knowledge-point/id #uuid "e8234e8b-2b1c-5433-94f8-64f84f38f1d0" :knowledge-point/questions [{:db/id #edb/ref 17592186078808} {:db/id #edb/ref 17592186078894} {:db/id #edb/ref 17592186519512} {:db/id #edb/ref 17592186519581} {:db/id #edb/ref 17592186535958} {:db/id #edb/ref 17592186548031}] :knowledge-point/title "Finding a Particular Term of an Arithmetic Sequence"} :step/id #uuid "dcf44960-5491-5ee7-887f-23bee9777a44" :step/math-academy-id 187831 :step/next {:db/id #edb/ref 17592186079360}} {:db/id #edb/ref 17592186079360 :step/content {:db/id #edb/ref 17592186078466 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078186 :question/id #uuid "56926a19-7cfc-51ca-8f07-870fc0271abb" :question/math-academy-id "e-14391"} :knowledge-point/id #uuid "85635ba4-d618-5600-8531-eacb2b0bb5d0" :knowledge-point/questions [{:db/id #edb/ref 17592186078809} {:db/id #edb/ref 17592186079117} {:db/id #edb/ref 17592186519534} {:db/id #edb/ref 17592186519543} {:db/id #edb/ref 17592186547995}] :knowledge-point/title "Finding the Formula for the Nth Term Given Another Term and the Common Difference"} :step/id #uuid "d7eb2ee2-b02f-5c37-95cf-f08741a24e06" :step/math-academy-id 187834}] :activity/title "The Nth Term of an Arithmetic Sequence" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078684}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536018} :activity/id #uuid "d673b246-6f75-5325-93c7-4d1a916755c3" :activity/scope {:db/id #edb/ref 17592186050157 :topic/id #uuid "32ad96da-6870-504d-ad58-7d14df8bea1a" :topic/math-academy-id 668} :activity/steps [{:db/id #edb/ref 17592186536008 :step/content {:db/id #edb/ref 17592186535978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02bda01c-00ce-5dc4-afcd-031687d469c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-5-n" :db/id #edb/ref 17592186535441} {:answer/id #uuid "757b62cd-47f6-52e7-b8c7-87b24ef760d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-5+n" :db/id #edb/ref 17592186535616} {:answer/id #uuid "95450a87-b3f3-5724-921d-8f93ba0f17ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-4+n" :db/id #edb/ref 17592186535669} {:answer/id #uuid "9b49282d-829d-5a5f-abfe-4892f5735307" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-1-5n" :db/id #edb/ref 17592186535681} {:answer/id #uuid "db6d5fb0-094b-5c89-9c80-859ccdc9373f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-4-n" :db/id #edb/ref 17592186535769}] :answer-field/correct {:db/id #edb/ref 17592186535769} :answer-field/id #uuid "885b6fc5-35e5-5c62-b5d3-34dcc6e8b072" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535881}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a3ce8ce6-6748-574c-a1ce-f27315ba87e1" :question/math-academy-id "q-100834" :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $-5$ and the common difference is $-1.$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nWe are told that the first term is $f(1)=-5$ and the common difference is $d=-1.$ So, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =-5+(n-1)(-1) \\\\  & =-5-n+1 \\\\  & =-4-n\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is $f(n)=-4-n.$"} :step/id #uuid "09c7a56f-14c4-5bf0-b911-ecdd6881ed50" :step/next {:db/id #edb/ref 17592186536032}} {:db/id #edb/ref 17592186536018 :step/content {:db/id #edb/ref 17592186535942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2df398-80bb-51a4-b350-3b2e0296b3f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=1+2n" :db/id #edb/ref 17592186535458} {:answer/id #uuid "7b33bb5e-aeab-5597-b3c0-9aeced82a379" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=1-2n" :db/id #edb/ref 17592186535625} {:answer/id #uuid "a98fd583-0615-5103-abe9-05473df6b6a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-1+2n" :db/id #edb/ref 17592186535700} {:answer/id #uuid "eed3487f-5a9e-54ff-85a2-1310f6278051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-1-2n" :db/id #edb/ref 17592186535803} {:answer/id #uuid "fae6e728-13ce-5cb2-a8d9-0931f9782d37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=2n" :db/id #edb/ref 17592186535823}] :answer-field/correct {:db/id #edb/ref 17592186535625} :answer-field/id #uuid "3a89ed3a-0922-5e5e-b7bc-1abf0e252f66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535851}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2a8b0250-b565-5cfb-a030-1477892ed03e" :question/math-academy-id "q-100832" :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $-1$ and the second term is $-3.$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nWe are given the first term $f(1)=-1.$ Also, the common difference of the sequence can be found as\n\n$$\nd=-3-(-1)=-2.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =-1+(n-1)(-2) \\\\  & =-1-2n+2 \\\\  & =1-2n\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is $f(n)=1-2n.$"} :step/id #uuid "3ff9a4dd-1f62-5e61-be7b-a1740475e433" :step/next {:db/id #edb/ref 17592186536008}} {:db/id #edb/ref 17592186536032 :step/content {:db/id #edb/ref 17592186535958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24dcbfc4-cc84-5f3a-b1cb-693ebed8dae5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "104" :db/id #edb/ref 17592186535493} {:answer/id #uuid "38a4a997-9b98-51d1-8c53-e8d9e667a96a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "92" :db/id #edb/ref 17592186535521} {:answer/id #uuid "7f05b8a0-9a98-5dee-a7d1-c5848081e29f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100" :db/id #edb/ref 17592186535636} {:answer/id #uuid "baf4b0b7-e6e4-57e2-9251-32c818c8e409" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "96" :db/id #edb/ref 17592186535722} {:answer/id #uuid "e6e5068d-43ad-5e98-9f6e-018f2ee0916c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "98" :db/id #edb/ref 17592186535789}] :answer-field/correct {:db/id #edb/ref 17592186535636} :answer-field/id #uuid "7ba50122-278d-5157-acaf-029a2378db5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535874}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6e4f48de-276e-5a6a-aa00-d24142c4be2a" :question/math-academy-id "q-100845" :question/problem "Find the $25$th term of the following arithmetic sequence. \n\n$$\n4,\\,8,\\,12,\\,16,\\,…\n$$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d.\n$$\n\nFirst, we will write the formula for the $n$th term of this sequence. From the first few terms\n\n$$\n4,\\,8,\\,12,\\,16,\\,…,\n$$\n\nwe see that the first term is ${a}_{1}=4$ and the common difference is \n\n$$\nd=8-4=4.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =4+(n-1)(4) \\\\  & =4+4n-4 \\\\  & =4n\\end{aligned}\n$$\n\nNow, we can use our formula to find the $25$th term. All we have to do is substitute $n=25:$\n\n$$\n\\begin{aligned}{a}_{n} & =4n \\\\ {a}_{25} & =4(25) \\\\  & =100\\end{aligned}\n$$\n\nTherefore, the $25$th term of the sequence is ${a}_{25}=100.$"} :step/id #uuid "80f2b9a6-d06f-59b4-bcbb-e30cb9858cb6"}] :activity/title "The Nth Term of an Arithmetic Sequence" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186535432}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186548152} :activity/id #uuid "b2e9f259-a49d-50fe-8d81-4ae722fca5d0" :activity/scope {:db/id #edb/ref 17592186050157 :topic/id #uuid "32ad96da-6870-504d-ad58-7d14df8bea1a" :topic/math-academy-id 668} :activity/steps [{:db/id #edb/ref 17592186548084 :step/content {:db/id #edb/ref 17592186548031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f77056-5d14-5518-9cbd-e4452715e777" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-132" :db/id #edb/ref 17592186547333} {:answer/id #uuid "0c6276f4-81a3-56a7-9734-86d03dd61f6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-117" :db/id #edb/ref 17592186547342} {:answer/id #uuid "6c7ba412-0a09-5ef6-ad37-9e32e70aba66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-142" :db/id #edb/ref 17592186547557} {:answer/id #uuid "9ad28e5d-83ac-5491-a717-309c203fa850" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-147" :db/id #edb/ref 17592186547653} {:answer/id #uuid "fd2de95c-c117-5333-977c-0e532865c0d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-152" :db/id #edb/ref 17592186547835}] :answer-field/correct {:db/id #edb/ref 17592186547653} :answer-field/id #uuid "abede6a0-89e1-5a83-afd9-f80c57dc4266" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547926}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "985912e6-de0a-5f5e-a520-8f2ffaee1968" :question/math-academy-id "q-108425" :question/problem "Find the $33$rd term of the following arithmetic sequence.\n\n$$\n13,\\,8,\\,3,\\,-2,\\,…\n$$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d.\n$$\n\nFirst, we will write the formula for the $n$th term of this sequence. From the first few terms\n\n$$\n13,\\,8,\\,3,\\,-2,\\,…\n$$\n\nwe see that the first term is ${a}_{1}=13$ and the common difference is \n\n$$\nd=8-13=-5.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =13+(n-1)(-5) \\\\  & =13-5n+5 \\\\  & =18-5n\\end{aligned}\n$$\n\nNow, we can use our formula to find the $33$rd term. All we have to do is substitute $n=33:$\n\n$$\n\\begin{aligned}{a}_{n} & =18-5n \\\\ {a}_{33} & =18-5(33) \\\\  & =18-165 \\\\  & =-147\\end{aligned}\n$$\n\nTherefore, the $33$rd term of the sequence is ${a}_{33}=-147.$"} :step/id #uuid "033c0cbd-058f-545a-b909-5256409e8977" :step/next {:db/id #edb/ref 17592186548136}} {:db/id #edb/ref 17592186548089 :step/content {:db/id #edb/ref 17592186548025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f6c4e76-71d7-5c88-ad1b-84c8143a9cf3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=21+2n" :db/id #edb/ref 17592186547413} {:answer/id #uuid "53bb4e1e-5889-56d8-9213-e82f82adab40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=21-2n" :db/id #edb/ref 17592186547505} {:answer/id #uuid "66ab06c6-74ed-51a0-a275-dfbca43f60bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=19-2n" :db/id #edb/ref 17592186547543} {:answer/id #uuid "6fbba565-83f4-5c3d-94c9-3458a2250ffb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=17+2n" :db/id #edb/ref 17592186547564} {:answer/id #uuid "9075cc84-4347-58c2-abbb-1932b80b3932" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=17-2n" :db/id #edb/ref 17592186547638}] :answer-field/correct {:db/id #edb/ref 17592186547505} :answer-field/id #uuid "d5d52af8-2924-5fe6-b3c8-abd3e2fc08d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547952}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "89937c4c-b18e-5039-ba6e-7940ef191d3c" :question/math-academy-id "q-100839" :question/problem "Find the general formula for the $n$th term of the arithmetic sequence that begins with \n\n$$\n19,\\,17,\\,15,\\,…\n$$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nFrom the first few terms\n\n$$\n19,\\,17,\\,15,\\,…\n$$\n\nwe see that the first term is $f(1)=19$ and the common difference is \n\n$$\nd=17-19=-2.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =19+(n-1)(-2) \\\\  & =19-2n+2 \\\\  & =21-2n\\end{aligned}\n$$\n\n    \n\nTherefore, the formula for the $n$th term is $f(n)=21-2n.$"} :step/id #uuid "1b7586b2-7187-526e-80b9-c9e05218ba34" :step/next {:db/id #edb/ref 17592186548084}} {:db/id #edb/ref 17592186548096 :step/content {:db/id #edb/ref 17592186078808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "458896f3-f370-52f1-9e3e-51ef001c59b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "98" :db/id #edb/ref 17592186547471}] :answer-field/correct {:db/id #edb/ref 17592186547471} :answer-field/id #uuid "9388e2a4-7b83-5876-8db8-56bf8103cac7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186075756}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3f637f85-8c3a-5315-8be1-4862dead07bc" :question/math-academy-id "q-236630" :question/problem "Consider the following arithmetic sequence.\n\n$$\n-17,\\,-12,\\,-7,\\,-2,\\,…\n$$\n\nWhat is the $24$th term of this sequence?\n\n${a}_{24}=$\n{{field-1}}" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d.\n$$\n\nFirst, we will write the formula for the $n$th term of this sequence. From the first few terms\n\n$$\n-17,\\,-12,\\,-7,\\,-2,\\,…,\n$$\n\nwe see that the first term is ${a}_{1}=-17$ and the common difference is \n\n$$\nd=-12-(-17)=5.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-17+(n-1)(5) \\\\  & =-17+5n-5 \\\\  & =5n-22\\end{aligned}\n$$\n\nNow, we can use our formula to find the $24$th term. All we have to do is substitute $n=24:$\n\n$$\n\\begin{aligned}{a}_{n} & =5n-22 \\\\ {a}_{24} & =5(24)-22 \\\\  & =120-22 \\\\  & =98\\end{aligned}\n$$"} :step/id #uuid "3dab1ea8-198d-52e8-b2e7-dce76d84a576"} {:db/id #edb/ref 17592186548136 :step/content {:db/id #edb/ref 17592186548048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e72eddf4-f297-542a-8adb-ccb2df0a4268" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5n-7" :db/id #edb/ref 17592186547795}] :answer-field/correct {:db/id #edb/ref 17592186547795} :answer-field/id #uuid "26dd1386-b847-5429-b10f-64f524c091e9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186547860}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bc128731-698c-584b-a0e3-391ca3d39ded" :question/math-academy-id "q-214180" :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $-2$ and the second term is $3.$\n\n$f(n)=$\n{{field-1}}\n$,\\,n\\ge 1$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nWe are given the first term $f(1)=-2.$ Also, the common difference of the sequence can be found as\n\n$$\nd=3-(-2)=5.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =-2+(n-1)(5) \\\\  & =-2+5n-5 \\\\  & =5n-7\\end{aligned}\n$$"} :step/id #uuid "9ac76756-68b5-5248-924d-2688b5cafc76" :step/next {:db/id #edb/ref 17592186548096}} {:db/id #edb/ref 17592186548152 :step/content {:db/id #edb/ref 17592186547995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "149d2a25-3355-5476-9483-6ef32c464750" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=-7-3n" :db/id #edb/ref 17592186547360} {:answer/id #uuid "15b024da-39c0-5595-9f56-e6a113bbb89a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=3n+7" :db/id #edb/ref 17592186547362} {:answer/id #uuid "5c8829a0-1b20-5c89-9024-a64b275b91c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=3n-5" :db/id #edb/ref 17592186547520} {:answer/id #uuid "9d698802-d582-5322-94ce-c890e61d06c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=3n-7" :db/id #edb/ref 17592186547658} {:answer/id #uuid "eafe4bd3-18f0-5764-bb6e-1785d198798e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{a}_{n}=7n-7" :db/id #edb/ref 17592186547804}] :answer-field/correct {:db/id #edb/ref 17592186547658} :answer-field/id #uuid "3600f700-81aa-539b-9b1e-e8b15201fad2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547869}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3a1942e4-caa0-5f58-aeeb-9eef16c2b831" :question/math-academy-id "q-19982" :question/problem "Given an arithmetic sequence that has ${a}_{10}=23$ and the common difference $d=3$, what is the general formula for the $n$th term of the sequence?" :question/worked-solution "Since ${a}_{10}=23$ is $9$ jumps after ${a}_{1},$ we can determine the first term of the sequence:\n\n$$\n\\begin{aligned}{a}_{10} & ={a}_{1}+9d \\\\ 23 & ={a}_{1}+9(3) \\\\ 23 & ={a}_{1}+27 \\\\ -4 & ={a}_{1}\\end{aligned}\n$$\n\nSo, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-4+(n-1)(3) \\\\  & =-4+3n-3 \\\\  & =3n-7\\end{aligned}\n$$"} :step/id #uuid "b95bdef4-950e-5d9f-9010-46130d47212a" :step/next {:db/id #edb/ref 17592186548089}}] :activity/title "The Nth Term of an Arithmetic Sequence" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186547305}]}
