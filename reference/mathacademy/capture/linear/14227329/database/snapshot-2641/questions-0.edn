#{[{:db/id #edb/ref 17592186548025 :knowledge-point/_questions [{:db/id #edb/ref 17592186078464 :knowledge-point/id #uuid "0f6a51df-54c6-5019-a5a0-05949d440895" :knowledge-point/title "Finding the Formula for the Nth Term of an Arithmetic Sequence in Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f6c4e76-71d7-5c88-ad1b-84c8143a9cf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=21+2n" :db/id #edb/ref 17592186547413} {:answer/id #uuid "53bb4e1e-5889-56d8-9213-e82f82adab40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=21-2n" :db/id #edb/ref 17592186547505} {:answer/id #uuid "66ab06c6-74ed-51a0-a275-dfbca43f60bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=19-2n" :db/id #edb/ref 17592186547543} {:answer/id #uuid "6fbba565-83f4-5c3d-94c9-3458a2250ffb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=17+2n" :db/id #edb/ref 17592186547564} {:answer/id #uuid "9075cc84-4347-58c2-abbb-1932b80b3932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=17-2n" :db/id #edb/ref 17592186547638}] :answer-field/correct {:answer/id #uuid "53bb4e1e-5889-56d8-9213-e82f82adab40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(n)=21-2n" :db/id #edb/ref 17592186547505} :answer-field/id #uuid "d5d52af8-2924-5fe6-b3c8-abd3e2fc08d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547952}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "89937c4c-b18e-5039-ba6e-7940ef191d3c" :question/math-academy-id "q-100839" :question/problem "Find the general formula for the $n$th term of the arithmetic sequence that begins with \n\n$$\n19,\\,17,\\,15,\\,…\n$$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nFrom the first few terms\n\n$$\n19,\\,17,\\,15,\\,…\n$$\n\nwe see that the first term is $f(1)=19$ and the common difference is \n\n$$\nd=17-19=-2.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =19+(n-1)(-2) \\\\  & =19-2n+2 \\\\  & =21-2n\\end{aligned}\n$$\n\n    \n\nTherefore, the formula for the $n$th term is $f(n)=21-2n.$"}] [{:db/id #edb/ref 17592186548031 :knowledge-point/_questions [{:db/id #edb/ref 17592186078465 :knowledge-point/id #uuid "e8234e8b-2b1c-5433-94f8-64f84f38f1d0" :knowledge-point/title "Finding a Particular Term of an Arithmetic Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f77056-5d14-5518-9cbd-e4452715e777" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-132" :db/id #edb/ref 17592186547333} {:answer/id #uuid "0c6276f4-81a3-56a7-9734-86d03dd61f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-117" :db/id #edb/ref 17592186547342} {:answer/id #uuid "6c7ba412-0a09-5ef6-ad37-9e32e70aba66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-142" :db/id #edb/ref 17592186547557} {:answer/id #uuid "9ad28e5d-83ac-5491-a717-309c203fa850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-147" :db/id #edb/ref 17592186547653} {:answer/id #uuid "fd2de95c-c117-5333-977c-0e532865c0d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-152" :db/id #edb/ref 17592186547835}] :answer-field/correct {:answer/id #uuid "9ad28e5d-83ac-5491-a717-309c203fa850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-147" :db/id #edb/ref 17592186547653} :answer-field/id #uuid "abede6a0-89e1-5a83-afd9-f80c57dc4266" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547926}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "985912e6-de0a-5f5e-a520-8f2ffaee1968" :question/math-academy-id "q-108425" :question/problem "Find the $33$rd term of the following arithmetic sequence.\n\n$$\n13,\\,8,\\,3,\\,-2,\\,…\n$$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d.\n$$\n\nFirst, we will write the formula for the $n$th term of this sequence. From the first few terms\n\n$$\n13,\\,8,\\,3,\\,-2,\\,…\n$$\n\nwe see that the first term is ${a}_{1}=13$ and the common difference is \n\n$$\nd=8-13=-5.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =13+(n-1)(-5) \\\\  & =13-5n+5 \\\\  & =18-5n\\end{aligned}\n$$\n\nNow, we can use our formula to find the $33$rd term. All we have to do is substitute $n=33:$\n\n$$\n\\begin{aligned}{a}_{n} & =18-5n \\\\ {a}_{33} & =18-5(33) \\\\  & =18-165 \\\\  & =-147\\end{aligned}\n$$\n\nTherefore, the $33$rd term of the sequence is ${a}_{33}=-147.$"}] [{:db/id #edb/ref 17592186547995 :knowledge-point/_questions [{:db/id #edb/ref 17592186078466 :knowledge-point/id #uuid "85635ba4-d618-5600-8531-eacb2b0bb5d0" :knowledge-point/title "Finding the Formula for the Nth Term Given Another Term and the Common Difference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "149d2a25-3355-5476-9483-6ef32c464750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=-7-3n" :db/id #edb/ref 17592186547360} {:answer/id #uuid "15b024da-39c0-5595-9f56-e6a113bbb89a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=3n+7" :db/id #edb/ref 17592186547362} {:answer/id #uuid "5c8829a0-1b20-5c89-9024-a64b275b91c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=3n-5" :db/id #edb/ref 17592186547520} {:answer/id #uuid "9d698802-d582-5322-94ce-c890e61d06c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=3n-7" :db/id #edb/ref 17592186547658} {:answer/id #uuid "eafe4bd3-18f0-5764-bb6e-1785d198798e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=7n-7" :db/id #edb/ref 17592186547804}] :answer-field/correct {:answer/id #uuid "9d698802-d582-5322-94ce-c890e61d06c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{n}=3n-7" :db/id #edb/ref 17592186547658} :answer-field/id #uuid "3600f700-81aa-539b-9b1e-e8b15201fad2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547869}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3a1942e4-caa0-5f58-aeeb-9eef16c2b831" :question/math-academy-id "q-19982" :question/problem "Given an arithmetic sequence that has ${a}_{10}=23$ and the common difference $d=3$, what is the general formula for the $n$th term of the sequence?" :question/worked-solution "Since ${a}_{10}=23$ is $9$ jumps after ${a}_{1},$ we can determine the first term of the sequence:\n\n$$\n\\begin{aligned}{a}_{10} & ={a}_{1}+9d \\\\ 23 & ={a}_{1}+9(3) \\\\ 23 & ={a}_{1}+27 \\\\ -4 & ={a}_{1}\\end{aligned}\n$$\n\nSo, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-4+(n-1)(3) \\\\  & =-4+3n-3 \\\\  & =3n-7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186548048 :knowledge-point/_questions [{:db/id #edb/ref 17592186078464 :knowledge-point/id #uuid "0f6a51df-54c6-5019-a5a0-05949d440895" :knowledge-point/title "Finding the Formula for the Nth Term of an Arithmetic Sequence in Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e72eddf4-f297-542a-8adb-ccb2df0a4268" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5n-7" :db/id #edb/ref 17592186547795}] :answer-field/correct {:answer/id #uuid "e72eddf4-f297-542a-8adb-ccb2df0a4268" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5n-7" :db/id #edb/ref 17592186547795} :answer-field/id #uuid "26dd1386-b847-5429-b10f-64f524c091e9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186547860}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bc128731-698c-584b-a0e3-391ca3d39ded" :question/math-academy-id "q-214180" :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $-2$ and the second term is $3.$\n\n$f(n)=$\n{{field-1}}\n$,\\,n\\ge 1$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nWe are given the first term $f(1)=-2.$ Also, the common difference of the sequence can be found as\n\n$$\nd=3-(-2)=5.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =-2+(n-1)(5) \\\\  & =-2+5n-5 \\\\  & =5n-7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078808 :knowledge-point/_questions [{:db/id #edb/ref 17592186078465 :knowledge-point/id #uuid "e8234e8b-2b1c-5433-94f8-64f84f38f1d0" :knowledge-point/title "Finding a Particular Term of an Arithmetic Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "458896f3-f370-52f1-9e3e-51ef001c59b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "98" :db/id #edb/ref 17592186547471}] :answer-field/correct {:answer/id #uuid "458896f3-f370-52f1-9e3e-51ef001c59b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "98" :db/id #edb/ref 17592186547471} :answer-field/id #uuid "9388e2a4-7b83-5876-8db8-56bf8103cac7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186075756}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3f637f85-8c3a-5315-8be1-4862dead07bc" :question/math-academy-id "q-236630" :question/problem "Consider the following arithmetic sequence.\n\n$$\n-17,\\,-12,\\,-7,\\,-2,\\,…\n$$\n\nWhat is the $24$th term of this sequence?\n\n${a}_{24}=$\n{{field-1}}" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d.\n$$\n\nFirst, we will write the formula for the $n$th term of this sequence. From the first few terms\n\n$$\n-17,\\,-12,\\,-7,\\,-2,\\,…,\n$$\n\nwe see that the first term is ${a}_{1}=-17$ and the common difference is \n\n$$\nd=-12-(-17)=5.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-17+(n-1)(5) \\\\  & =-17+5n-5 \\\\  & =5n-22\\end{aligned}\n$$\n\nNow, we can use our formula to find the $24$th term. All we have to do is substitute $n=24:$\n\n$$\n\\begin{aligned}{a}_{n} & =5n-22 \\\\ {a}_{24} & =5(24)-22 \\\\  & =120-22 \\\\  & =98\\end{aligned}\n$$"}]}
