ledge-point/canonical-example {:db/id #edb/ref 17592186078186 :question/id #uuid "56926a19-7cfc-51ca-8f07-870fc0271abb" :question/math-academy-id "e-14391"} :knowledge-point/id #uuid "85635ba4-d618-5600-8531-eacb2b0bb5d0" :knowledge-point/questions [{:db/id #edb/ref 17592186078809} {:db/id #edb/ref 17592186079117} {:db/id #edb/ref 17592186519534} {:db/id #edb/ref 17592186519543}] :knowledge-point/title "Finding the Formula for the Nth Term Given Another Term and the Common Difference"} :step/id #uuid "d7eb2ee2-b02f-5c37-95cf-f08741a24e06" :step/math-academy-id 187834}] :activity/title "The Nth Term of an Arithmetic Sequence" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078684}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536018} :activity/id #uuid "d673b246-6f75-5325-93c7-4d1a916755c3" :activity/scope {:db/id #edb/ref 17592186050157 :topic/id #uuid "32ad96da-6870-504d-ad58-7d14df8bea1a" :topic/math-academy-id 668} :activity/steps [{:db/id #edb/ref 17592186536008 :step/content {:db/id #edb/ref 17592186535978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02bda01c-00ce-5dc4-afcd-031687d469c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-5-n" :db/id #edb/ref 17592186535441} {:answer/id #uuid "757b62cd-47f6-52e7-b8c7-87b24ef760d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-5+n" :db/id #edb/ref 17592186535616} {:answer/id #uuid "95450a87-b3f3-5724-921d-8f93ba0f17ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-4+n" :db/id #edb/ref 17592186535669} {:answer/id #uuid "9b49282d-829d-5a5f-abfe-4892f5735307" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-1-5n" :db/id #edb/ref 17592186535681} {:answer/id #uuid "db6d5fb0-094b-5c89-9c80-859ccdc9373f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-4-n" :db/id #edb/ref 17592186535769}] :answer-field/correct {:db/id #edb/ref 17592186535769} :answer-field/id #uuid "885b6fc5-35e5-5c62-b5d3-34dcc6e8b072" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535881}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a3ce8ce6-6748-574c-a1ce-f27315ba87e1" :question/math-academy-id "q-100834" :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $-5$ and the common difference is $-1.$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nWe are told that the first term is $f(1)=-5$ and the common difference is $d=-1.$ So, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =-5+(n-1)(-1) \\\\  & =-5-n+1 \\\\  & =-4-n\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is $f(n)=-4-n.$"} :step/id #uuid "09c7a56f-14c4-5bf0-b911-ecdd6881ed50" :step/next {:db/id #edb/ref 17592186536032}} {:db/id #edb/ref 17592186536018 :step/content {:db/id #edb/ref 17592186535942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2df398-80bb-51a4-b350-3b2e0296b3f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=1+2n" :db/id #edb/ref 17592186535458} {:answer/id #uuid "7b33bb5e-aeab-5597-b3c0-9aeced82a379" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=1-2n" :db/id #edb/ref 17592186535625} {:answer/id #uuid "a98fd583-0615-5103-abe9-05473df6b6a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-1+2n" :db/id #edb/ref 17592186535700} {:answer/id #uuid "eed3487f-5a9e-54ff-85a2-1310f6278051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=-1-2n" :db/id #edb/ref 17592186535803} {:answer/id #uuid "fae6e728-13ce-5cb2-a8d9-0931f9782d37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "f(n)=2n" :db/id #edb/ref 17592186535823}] :answer-field/correct {:db/id #edb/ref 17592186535625} :answer-field/id #uuid "3a89ed3a-0922-5e5e-b7bc-1abf0e252f66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535851}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2a8b0250-b565-5cfb-a030-1477892ed03e" :question/math-academy-id "q-100832" :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $-1$ and the second term is $-3.$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nWe are given the first term $f(1)=-1.$ Also, the common difference of the sequence can be found as\n\n$$\nd=-3-(-1)=-2.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =-1+(n-1)(-2) \\\\  & =-1-2n+2 \\\\  & =1-2n\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is $f(n)=1-2n.$"} :step/id #uuid "3ff9a4dd-1f62-5e61-be7b-a1740475e433" :step/next {:db/id #edb/ref 17592186536008}} {:db/id #edb/ref 17592186536032 :step/content {:db/id #edb/ref 17592186535958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24dcbfc4-cc84-5f3a-b1cb-693ebed8dae5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "104" :db/id #edb/ref 17592186535493} {:answer/id #uuid "38a4a997-9b98-51d1-8c53-e8d9e667a96a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "92" :db/id #edb/ref 17592186535521} {:answer/id #uuid "7f05b8a0-9a98-5dee-a7d1-c5848081e29f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100" :db/id #edb/ref 17592186535636} {:answer/id #uuid "baf4b0b7-e6e4-57e2-9251-32c818c8e409" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "96" :db/id #edb/ref 17592186535722} {:answer/id #uuid "e6e5068d-43ad-5e98-9f6e-018f2ee0916c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "98" :db/id #edb/ref 17592186535789}] :answer-field/correct {:db/id #edb/ref 17592186535636} :answer-field/id #uuid "7ba50122-278d-5157-acaf-029a2378db5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186535874}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6e4f48de-276e-5a6a-aa00-d24142c4be2a" :question/math-academy-id "q-100845" :question/problem "Find the $25$th term of the following arithmetic sequence. \n\n$$\n4,\\,8,\\,12,\\,16,\\,…\n$$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d.\n$$\n\nFirst, we will write the formula for the $n$th term of this sequence. From the first few terms\n\n$$\n4,\\,8,\\,12,\\,16,\\,…,\n$$\n\nwe see that the first term is ${a}_{1}=4$ and the common difference is \n\n$$\nd=8-4=4.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =4+(n-1)(4) \\\\  & =4+4n-4 \\\\  & =4n\\end{aligned}\n$$\n\nNow, we can use our formula to find the $25$th term. All we have to do is substitute $n=25:$\n\n$$\n\\begin{aligned}{a}_{n} & =4n \\\\ {a}_{25} & =4(25) \\\\  & =100\\end{aligned}\n$$\n\nTherefore, the $25$th term of the sequence is ${a}_{25}=100.$"} :step/id #uuid "80f2b9a6-d06f-59b4-bcbb-e30cb9858cb6"}] :activity/title "The Nth Term of an Arithmetic Sequence" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186535432}]}
