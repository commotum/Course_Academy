0</mn><mn>11</mn></mfrac></mstyle><mi>t</mi></mtd><mtd><mo>=</mo><mn>960</mn></mtd></mtr><mtr><mtd><mn>11</mn><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>300</mn><mn>11</mn></mfrac></mstyle><mi>t</mi></mtd><mtd><mo>=</mo><mn>11</mn><mo>⋅</mo><mn>960</mn></mtd></mtr><mtr><mtd><menclose notation=\"updiagonalstrike\"><mn>11</mn></menclose><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>300</mn><menclose notation=\"updiagonalstrike\"><mn>11</mn></menclose></mfrac></mstyle><mi>t</mi></mtd><mtd><mo>=</mo><mn>11</mn><mo>⋅</mo><mn>960</mn></mtd></mtr><mtr><mtd><mn>300</mn><mi>t</mi></mtd><mtd><mo>=</mo><mn>11</mn><mo>⋅</mo><mn>960</mn></mtd></mtr></mtable></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Then, we divide both sides of the equation by <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"77\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>300</mn></math></mjx-assistive-mml></mjx-container> to isolate <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"78\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-texatom texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c3A\"></mjx-c></mjx-mo></mjx-texatom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mrow data-mjx-texclass=\"BIN\"><mo>:</mo></mrow></math></mjx-assistive-mml></mjx-container></p>\n<p><mjx-container class=\"MathJax CtxtM