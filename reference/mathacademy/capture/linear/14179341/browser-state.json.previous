  "live_records": {
    "q-111432": {
      "dom_id": "step-q111432",
      "name": "Question 1",
      "problem": "Find all of the real solutions to the equation ${x}^{8}=256.$",
      "worked_solution": "We can solve this equation by taking the $8$th root of each side and solving for $x.$ Since the exponent $(8)$  is even, we consider both the positive and negative solutions:\n\n$$\n\\begin{aligned}{x}^{8} & =256 \\\\ \\sqrt[8]{{x}^{8}} & =\\pm \\sqrt[8]{256} \\\\ x & =\\pm \\sqrt[8]{{2}^{8}} \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 2.$",
      "calculator_instructions": "",
