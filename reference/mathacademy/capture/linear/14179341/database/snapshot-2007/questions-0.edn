#{[{:db/id #edb/ref 17592186115139 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115310 :knowledge-point/id #uuid "b936abcf-8e73-524c-a9bf-e59b55a48f5f" :knowledge-point/title "Solving Equations With Even Exponents"}] :question/id #uuid "977cdc31-054e-5910-a649-e604dc4ce31f" :question/math-academy-id "e-8052" :question/problem "Find all of the real solutions to the equation $9x^4 = \\dfrac{1}{9}.$" :question/worked-solution "We can solve this equation by isolating the $x^4$ term and then taking the $4$th root of each side.\n\nFirst, let's isolate the $x^4$ term on the left-hand side:\n\n$$\n\\begin{aligned}9{x}^{4} & =\\frac{1}{9} \\\\ {x}^{4} & =\\frac{1}{81}\\end{aligned}\n$$\n\nNow, we take the $4$th root of each side and solve for $x.$ Since the exponent $(4)$ is even, we consider both the positive and negative solutions:\n\n$$\n\\begin{aligned}{x}^{4} & =\\frac{1}{81} \\\\ \\sqrt[4]{{x}^{4}} & =\\pm \\sqrt[4]{\\frac{1}{81}} \\\\ x & =\\pm \\sqrt[4]{{(\\frac{1}{3})}^{4}} \\\\ x & =\\pm \\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm \\dfrac13.$"}] [{:db/id #edb/ref 17592186115140 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115311 :knowledge-point/id #uuid "23e661ed-3a7b-598a-a7b1-fd5011fe4fb8" :knowledge-point/title "Solving Equations Containing an Expression Raised to an Even Power"}] :question/id #uuid "3f41b040-6584-57cd-8d47-b01e071b0fa9" :question/math-academy-id "e-8064" :question/problem "Find all of the real solutions to the equation $(x-3)^4=-\\dfrac{1}{81}.$" :question/worked-solution "Notice that $(x-3)^4 \\geq 0$ for all values of $x$ because the exponent ($4$) is even. This expression can never be negative. \n\nTherefore, there are no real solutions to this equation."}] [{:db/id #edb/ref 17592186495082 :knowledge-point/_questions [{:db/id #edb/ref 17592186115310 :knowledge-point/id #uuid "b936abcf-8e73-524c-a9bf-e59b55a48f5f" :knowledge-point/title "Solving Equations With Even Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "456ceebb-e8a3-5b0f-859b-21d38bb5eedc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ only" :db/id #edb/ref 17592186494457} {:answer/id #uuid "5e02902a-4e09-5633-8b9e-162c48602cea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ only" :db/id #edb/ref 17592186494511} {:answer/id #uuid "8077695a-7be0-5f57-a402-02fe156c48c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 4" :db/id #edb/ref 17592186494599} {:answer/id #uuid "d47a91dc-8ede-5f9c-9d92-2ef194aa7d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2" :db/id #edb/ref 17592186494820} {:answer/id #uuid "e370bcbf-edcc-5e53-bfa1-d3a7f7b920d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 8" :db/id #edb/ref 17592186494862}] :answer-field/correct {:answer/id #uuid "d47a91dc-8ede-5f9c-9d92-2ef194aa7d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2" :db/id #edb/ref 17592186494820} :answer-field/id #uuid "d41a6a03-8ac6-50f3-989c-c4f2f248ef4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186495020}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48c1b745-ea84-58de-8c55-67874acb2883" :question/math-academy-id "q-111432" :question/problem "Find all of the real solutions to the equation ${x}^{8}=256.$" :question/worked-solution "We can solve this equation by taking the $8$th root of each side and solving for $x.$ Since the exponent $(8)$  is even, we consider both the positive and negative solutions:\n\n$$\n\\begin{aligned}{x}^{8} & =256 \\\\ \\sqrt[8]{{x}^{8}} & =\\pm \\sqrt[8]{256} \\\\ x & =\\pm \\sqrt[8]{{2}^{8}} \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 2.$"}] [{:db/id #edb/ref 17592186495166 :knowledge-point/_questions [{:db/id #edb/ref 17592186115311 :knowledge-point/id #uuid "23e661ed-3a7b-598a-a7b1-fd5011fe4fb8" :knowledge-point/title "Solving Equations Containing an Expression Raised to an Even Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "046961d9-841f-51f7-ba46-6248fd584f28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ only" :db/id #edb/ref 17592186494327} {:answer/id #uuid "12570bb9-131f-5544-adfe-03cf59187a89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no real solutions" :db/id #edb/ref 17592186494351} {:answer/id #uuid "c80c0be2-5eb8-5f9b-bcf9-872d44ce5073" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-9$ and $1$" :db/id #edb/ref 17592186494789} {:answer/id #uuid "dd046e4c-0a37-524b-be1d-418cb02c11ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ only" :db/id #edb/ref 17592186494842} {:answer/id #uuid "f33d340d-daf0-5075-96f9-10bbd81a45f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 5" :db/id #edb/ref 17592186494896}] :answer-field/correct {:answer/id #uuid "c80c0be2-5eb8-5f9b-bcf9-872d44ce5073" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-9$ and $1$" :db/id #edb/ref 17592186494789} :answer-field/id #uuid "ddb6fa7b-1fb9-5740-bed5-f388b665266b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186495024}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f481106a-9bb9-56a6-bdda-a603ba8e3a03" :question/math-academy-id "q-111442" :question/problem "Find all of the real solutions to the equation $\\frac{(x+4)^{4}}{25}=25.$" :question/worked-solution "We can solve this equation by isolating the $(x+4)^{4}$ term and then taking the $4$th root of each side.\n\nFirst, let's isolate the $(x+4)^{4}$ term on the left-hand side:\n\n$$\n\\begin{aligned}\\frac{(x+4)^{4}}{25} & =25 \\\\ (x+4)^{4} & =625\\end{aligned}\n$$\n\nNow, we take the $4$th root of each side and solve for $x.$ Since the exponent $(4)$ is even, we consider both the positive and negative solutions:\n\n$$\n\\begin{aligned}(x+4)^{4} & =625 \\\\ \\sqrt[4]{(x+4)^{4}} & =\\pm \\sqrt[4]{625} \\\\ x+4 & =\\pm \\sqrt[4]{{5}^{4}} \\\\ x+4 & =\\pm 5 \\\\ x & =-4\\pm 5\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-9$ and $x=1.$"}] [{:db/id #edb/ref 17592186495083 :knowledge-point/_questions [{:db/id #edb/ref 17592186115310 :knowledge-point/id #uuid "b936abcf-8e73-524c-a9bf-e59b55a48f5f" :knowledge-point/title "Solving Equations With Even Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2123cae8-cb1a-5228-85b4-5f749192b6a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2" :db/id #edb/ref 17592186494382} {:answer/id #uuid "2b3fe37f-f28d-59da-ba3c-f29c6d8c79be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ only" :db/id #edb/ref 17592186494401} {:answer/id #uuid "2fd8b37a-1e03-5b26-9907-5b4238479f4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 8" :db/id #edb/ref 17592186494413} {:answer/id #uuid "a079d803-c0e8-5a69-908f-7d7f78c8f16a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ only" :db/id #edb/ref 17592186494683} {:answer/id #uuid "f8b599f8-ea72-5a9e-a427-3abc331f2f40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 4" :db/id #edb/ref 17592186494903}] :answer-field/correct {:answer/id #uuid "2123cae8-cb1a-5228-85b4-5f749192b6a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2" :db/id #edb/ref 17592186494382} :answer-field/id #uuid "3a974b9a-1983-5b53-86c0-307685fb8dcb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494942}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "49a4d1a9-08de-560d-b9e9-2048bdc86e7d" :question/math-academy-id "q-91337" :question/problem "Find all of the real solutions to the equation ${x}^{6}=64.$" :question/worked-solution "We can solve this equation by taking the $6$th root of each side and solving for $x.$ Since the exponent $(6)$  is even, we consider both the positive and negative solutions:\n\n$$\n\\begin{aligned}{x}^{6} & =64 \\\\ \\sqrt[6]{{x}^{6}} & =\\pm \\sqrt[6]{64} \\\\ x & =\\pm \\sqrt[6]{{2}^{6}} \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 2.$"}] [{:db/id #edb/ref 17592186495103 :knowledge-point/_questions [{:db/id #edb/ref 17592186115311 :knowledge-point/id #uuid "23e661ed-3a7b-598a-a7b1-fd5011fe4fb8" :knowledge-point/title "Solving Equations Containing an Expression Raised to an Even Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "455d03c1-5919-5d7e-b1aa-81cabab616bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1$ and $-5$" :db/id #edb/ref 17592186494456} {:answer/id #uuid "867e2980-c6e6-52f9-86f1-c4e70fe4b20f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ and $3$" :db/id #edb/ref 17592186494614} {:answer/id #uuid "9eb81f1d-9e84-581c-a6cc-af1d05970df8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ and $-5$" :db/id #edb/ref 17592186494680} {:answer/id #uuid "d8ab36c9-f58f-5bb6-be84-4b0f66dfa592" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ and $5$" :db/id #edb/ref 17592186494829} {:answer/id #uuid "f3987bc8-0469-592b-a842-c96c0962f6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1$ and $7$" :db/id #edb/ref 17592186494897}] :answer-field/correct {:answer/id #uuid "455d03c1-5919-5d7e-b1aa-81cabab616bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-1$ and $-5$" :db/id #edb/ref 17592186494456} :answer-field/id #uuid "7e4f76af-0404-5cab-83e6-644ae34e1cdf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494974}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "80133e3d-6a6e-531f-96e9-2c88946d7720" :question/math-academy-id "q-91443" :question/problem "Find all of the real solutions to the equation $8(x+3)^{6}=512.$" :question/worked-solution "We can solve this equation by isolating the $(x+3)^{6}$ term and then taking the $6$th root of each side.\n\nFirst, let's isolate the $(x+3)^{6}$ term on the left-hand side:\n\n$$\n\\begin{aligned}8(x+3)^{6} & =512 \\\\ (x+3)^{6} & =64\\end{aligned}\n$$\n\nNow, we take the $6$th root of each side and solve for $x.$ Since the exponent $(6)$ is even, we consider both the positive and negative solutions:\n\n$$\n\\begin{aligned}(x+3)^{6} & =64 \\\\ \\sqrt[6]{(x+3)^{6}} & =\\pm \\sqrt[6]{64} \\\\ x+3 & =\\pm \\sqrt[6]{{2}^{6}} \\\\ x+3 & =\\pm 2 \\\\ x & =-3\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-1$ and $x=-5.$"}]}
