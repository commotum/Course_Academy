#{[{:activity/first-step {:db/id #edb/ref 17592186116230} :activity/id #uuid "b0012b09-9794-5364-a20b-bf1c5e744a22" :activity/scope {:db/id #edb/ref 17592186050828 :topic/id #uuid "69d7c525-79e4-514e-80ba-739018d9e137" :topic/math-academy-id 1587} :activity/steps [{:db/id #edb/ref 17592186116226 :step/content {:db/id #edb/ref 17592186115310 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115139 :question/id #uuid "977cdc31-054e-5910-a649-e604dc4ce31f" :question/math-academy-id "e-8052"} :knowledge-point/id #uuid "b936abcf-8e73-524c-a9bf-e59b55a48f5f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048187}] :knowledge-point/questions [{:db/id #edb/ref 17592186115978} {:db/id #edb/ref 17592186115979}] :knowledge-point/title "Solving Equations With Even Exponents"} :step/id #uuid "3cf6da35-b32f-503b-b8ea-94efb7441f1c" :step/math-academy-id 30068 :step/next {:db/id #edb/ref 17592186116227}} {:db/id #edb/ref 17592186116227 :step/content {:db/id #edb/ref 17592186115311 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115140 :question/id #uuid "3f41b040-6584-57cd-8d47-b01e071b0fa9" :question/math-academy-id "e-8064"} :knowledge-point/id #uuid "23e661ed-3a7b-598a-a7b1-fd5011fe4fb8" :knowledge-point/questions [{:db/id #edb/ref 17592186115980} {:db/id #edb/ref 17592186115981}] :knowledge-point/title "Solving Equations Containing an Expression Raised to an Even Power"} :step/id #uuid "c66f2f53-2687-55ab-8bb5-e1056e5074bc" :step/math-academy-id 30120} {:db/id #edb/ref 17592186116230 :step/content {:db/id #edb/ref 17592186116534 :tutorial/content "How do we solve an equation with a variable raised to an even exponent, such as\n\n$$\nx^6 = 64\n$$\n\nWe can solve this equation by taking the $6$th root of each side and solving for $x$.\n\nSince the exponent $(6)$ is even, there will be two real solutions (positive and negative):\n\n$$\n\\begin{aligned}\nx^{6} &= 64 \\\\\n\\sqrt[6]{x^{6}} &= ± \\sqrt[6]{64} \\\\\nx &= ± \\sqrt[6]{2^{6}} \\\\\nx &= ± 2\n\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 2$.\n\nIn general, we have the following rule of thumb:\n\n> *When $n$ is even, and we take the $n$th root of both sides of $x^n = a$ with $a \\geq 0$, we get two solutions (positive and negative):* $x = \\pm\\sqrt[n]{a}$\n\n**Watch out!** If $a<0$ and $n$ is even, equation $x^n = a$ has no solution since, in this case,\n\n$$\nx^n \\geq 0\n$$\n\nfor any real $x$." :tutorial/id #uuid "6a9834f3-f04b-5340-b297-793072b594d9" :tutorial/math-academy-id 4833 :tutorial/title "Introduction"} :step/id #uuid "036c0d84-9bf6-5da8-986c-2ace277257a2" :step/math-academy-id 30128 :step/next {:db/id #edb/ref 17592186116226}}] :activity/title "Solving Equations With Even Exponents Using the Nth Root Method" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115421}]}
