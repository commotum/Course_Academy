#{[{:db/id #edb/ref 17592186512921 :knowledge-point/_questions [{:db/id #edb/ref 17592186204011 :knowledge-point/id #uuid "83df73fc-c0cc-5605-9b39-453de0c37cc7" :knowledge-point/title "Calculating S(x,y) Using the Shortcut Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53c4e854-a95f-58d6-aaed-933846604762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "83" :db/id #edb/ref 17592186512286}] :answer-field/correct {:answer/id #uuid "53c4e854-a95f-58d6-aaed-933846604762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "83" :db/id #edb/ref 17592186512286} :answer-field/id #uuid "be6a6eec-8d66-5b27-9486-87b9b28cd48f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186512827}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae961e11-0326-56d9-bf54-b78685d8bc1a" :question/math-academy-id "q-251795" :question/problem "Consider two sets of $16$ paired observations ${x}_{1},{x}_{2},…,{x}_{16},$ and ${y}_{1},{y}_{2},…,{y}_{16}.$ You are given that\n\n$$\n\\begin{aligned} & {\\sum }_{i=1}^{16}{x}_{i}=168, \\\\  & {\\sum }_{i=1}^{16}{y}_{i}=158, \\\\  & {\\sum }_{i=1}^{16}{x}_{i}{y}_{i}=1\\,742.\\end{aligned}\n$$\n\nThen, ${S}_{xy}=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the statistic ${S}_{xy}$ be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xy} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}{y}_{i}-\\frac{1}{n}({\\sum }_{i=1}^{n}{x}_{i})({\\sum }_{i=1}^{n}{y}_{i}).\\end{aligned}\n$$\n\nSubstituting the given statistics in the above formula, we get\n\n$$\n\\begin{aligned}{S}_{xy} & =1\\,742-\\frac{1}{16}(168)(158) \\\\  & =1\\,742-1\\,659 \\\\  & =83.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186563704 :knowledge-point/_questions [{:db/id #edb/ref 17592186204011 :knowledge-point/id #uuid "83df73fc-c0cc-5605-9b39-453de0c37cc7" :knowledge-point/title "Calculating S(x,y) Using the Shortcut Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c5d8ba4-23fd-58c5-878f-33e321fefa74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}_{xy}=32" :db/id #edb/ref 17592186562965} {:answer/id #uuid "3cacd545-fd7c-5c12-b57f-e54b5d1d6829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}_{xy}=30.5" :db/id #edb/ref 17592186563080} {:answer/id #uuid "a38d71f2-fdd4-5997-bdf4-77d25628f1b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}_{xy}=33.5" :db/id #edb/ref 17592186563314} {:answer/id #uuid "afb01973-c81f-590b-a69b-afca6cd48a7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}_{xy}=27.5" :db/id #edb/ref 17592186563337} {:answer/id #uuid "c7395bc7-0a3c-5f1c-a9c6-0a647dc4241a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}_{xy}=24" :db/id #edb/ref 17592186563383}] :answer-field/correct {:answer/id #uuid "a38d71f2-fdd4-5997-bdf4-77d25628f1b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{S}_{xy}=33.5" :db/id #edb/ref 17592186563314} :answer-field/id #uuid "71771a9c-6d44-5ba0-b159-1c1d1cb21717" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563573}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7487be5e-d3cc-5ed9-9625-a2ce92482f7c" :question/math-academy-id "q-251806" :question/problem "Consider the two sets of $8$ paired observations in the table below.\n\n| **$\\,{x}_{i}\\,$** | $16$ | $9$ | $12$ | $10$ | $11$ | $11$ | $6$ | $9$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| **$\\,{y}_{i}\\,$** | $10$ | $14$ | $8$ | $10$ | $7$ | $8$ | $2$ | $4$ |\n\nGiven that ${\\sum }_{i=1}^{8}{x}_{i}{y}_{i}=695,$ calculate ${S}_{xy}.$" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of products of deviations from the means can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xy} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & ={\\sum }_{i}{x}_{i}{y}_{i}-\\frac{1}{n}({\\sum }_{i=1}^{n}{x}_{i})({\\sum }_{i=1}^{n}{y}_{i})\\end{aligned}\n$$\n\nFirst, we calculate the sum of the ${x}_{i}$ and ${y}_{i}:$\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}{x}_{i} & =16+9+12+10+11+11+6+9=84, \\\\ {\\sum }_{i=1}^{n}{y}_{i} & =10+14+8+10+7+8+2+4=63\\end{aligned}\n$$\n\nWe are given that ${\\sum }_{i=1}^{8}{x}_{i}{y}_{i}=695.$\n\nFinally, by substituting in the above formula, we get\n\n$$\n{S}_{xy}=695-\\frac{1}{8}(84)(63)=695-661.5=33.5.\n$$"}] [{:db/id #edb/ref 17592186563655 :knowledge-point/_questions [{:db/id #edb/ref 17592186204009 :knowledge-point/id #uuid "714000f9-caea-57a3-a8cb-6b8ec99960d1" :knowledge-point/title "Calculating Variance and Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f3cf9a4-e088-5b99-9833-d8bb8c2bb442" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.8" :db/id #edb/ref 17592186563195}] :answer-field/correct {:answer/id #uuid "6f3cf9a4-e088-5b99-9833-d8bb8c2bb442" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.8" :db/id #edb/ref 17592186563195} :answer-field/id #uuid "1b5318d2-3f2f-55cf-b4e0-80a9f6598453" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186563537}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "17851fea-30ed-54e9-89be-985c48bef200" :question/math-academy-id "q-251850" :question/problem "Consider two sets of $20$ paired observations ${x}_{1},{x}_{2},…,{x}_{20},$ and ${y}_{1},{y}_{2},…,{y}_{20}.$ You are given that\n\n$$\n\\begin{aligned}{S}_{xx}=60,\\,{S}_{yy}=116,\\,{S}_{xy}=100.\\end{aligned}\n$$\n\nThen, ${\\sigma }_{y}^{2}=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the variance of ${y}_{i}$ can be calculated as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{y}^{2} & =\\frac{{S}_{yy}}{n},\\end{aligned}\n$$\n\nwhere ${S}_{yy}$ is the sum of squared deviations from the mean for the data ${y}_{i}.$\n\nWe are given that ${S}_{yy}=116.$ Substituting the given statistic in the above formula, we get\n\n$$\n\\begin{aligned}{\\sigma }_{y}^{2} & =\\frac{116}{20} \\\\  & =5.8.\\end{aligned}\n$$"}]}
