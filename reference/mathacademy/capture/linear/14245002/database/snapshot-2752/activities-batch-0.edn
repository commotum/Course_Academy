/ref 17592186204149}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186521617} :activity/id #uuid "7aa8c243-9cf9-5efe-a839-52140fca9bde" :activity/scope {:db/id #edb/ref 17592186050406 :topic/id #uuid "467c6e31-0c6e-5017-92e2-f1c8d38e5a4c" :topic/math-academy-id 5204} :activity/steps [{:db/id #edb/ref 17592186521602 :step/content {:db/id #edb/ref 17592186521520 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e2a6f16-31aa-5059-b5b0-f9450b74c6de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=7" :db/id #edb/ref 17592186520791} {:answer/id #uuid "3558b18f-4849-5916-845e-fe6aa991a513" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=5" :db/id #edb/ref 17592186520876} {:answer/id #uuid "489962a8-1deb-53b2-935a-d63467602030" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=11" :db/id #edb/ref 17592186520927} {:answer/id #uuid "ceb274b6-f1d2-5d6b-bab5-c50bfb7607a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=12" :db/id #edb/ref 17592186521230} {:answer/id #uuid "d2ffdadb-e1e7-530b-b56a-cb1c31d4fe05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=8" :db/id #edb/ref 17592186521237}] :answer-field/correct {:db/id #edb/ref 17592186520791} :answer-field/id #uuid "15b52421-3d0b-5fa5-9d1e-da2b902cf171" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521335}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "84b31519-3642-53d1-a74c-ac68de0d653b" :question/math-academy-id "q-251802" :question/problem "Consider the two sets of $7$ paired observations in the table below.\n\n| **$\\,{x}_{i}\\,$** | $12$ | $4$ | $6$ | $10$ | $8$ | $15$ | $11$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| **$\\,{y}_{i}\\,$** | $20$ | $10$ | $5$ | $1$ | $7$ | $4$ | $9$ |\n\nGiven that ${\\sum }_{i=1}^{7}{x}_{i}{y}_{i}=535,$ calculate ${S}_{xy}.$" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of products of deviations from the means can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xy} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & ={\\sum }_{i}{x}_{i}{y}_{i}-\\frac{1}{n}({\\sum }_{i=1}^{n}{x}_{i})({\\sum }_{i=1}^{n}{y}_{i})\\end{aligned}\n$$\n\nFirst, we calculate the sum of the ${x}_{i}$ and ${y}_{i}:$\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}{x}_{i} & =12+4+6+10+8+15+11=66, \\\\ {\\sum }_{i=1}^{n}{y}_{i} & =20+10+5+1+7+4+9=56\\end{aligned}\n$$\n\nWe are given that ${\\sum }_{i=1}^{7}{x}_{i}{y}_{i}=535.$\n\nFinally, by substituting in the above formula, we get\n\n$$\n{S}_{xy}=535-\\frac{1}{7}(66)(56)=535-528=7.\n$$"} :step/id #uuid "5d03f414-94f2-58bc-a50f-eb3425afa07a" :step/next {:db/id #edb/ref 17592186521632}} {:db/id #edb/ref 17592186521617 :step/content {:db/id #edb/ref 17592186204442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db5304b5-083a-506d-804d-17b1e72be0cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "960" :db/id #edb/ref 17592186521256}] :answer-field/correct {:db/id #edb/ref 17592186521256} :answer-field/id #uuid "b0ce1b0a-97a1-51bf-bae4-ff211637bd0f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186202598}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2e106c63-c0cc-5875-983c-f82c045e7559" :question/math-academy-id "q-251426" :question/problem "Consider two sets of $25$ paired observations ${x}_{1},{x}_{2},…,{x}_{25},$ and ${y}_{1},{y}_{2},…,{y}_{25}.$ You are given that\n\n$$\n\\begin{aligned} & {\\sum }_{i=1}^{25}{x}_{i}=250,\\,{\\sum }_{i=1}^{25}{y}_{i}=265, \\\\  & {\\sum }_{i=1}^{25}{x}_{i}^{2}=3\\,460,\\,{\\sum }_{i=1}^{25}{y}_{i}^{2}=5\\,720.\\end{aligned}\n$$\n\nCalculate the sum of the squared deviations from the mean for the points ${x}_{i}.$\n\n${S}_{xx}=$\n{{field-1}}" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of squared deviations from the mean for the data ${x}_{i}$ can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xx} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2} \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}^{2}-\\frac{1}{n}{({\\sum }_{i=1}^{n}{x}_{i})}^{2}\\end{aligned}\n$$\n\nSubstituting the given statistics in the above formula, we get\n\n$$\n\\begin{aligned}{S}_{xx} & =3\\,460-\\frac{1}{25}(250)^{2} \\\\  & =3\\,460-2\\,500 \\\\  & =960.\\end{aligned}\n$$"} :step/id #uuid "7802b9e3-fd31-5e80-8ab7-f1535e9dbf56" :step/next {:db/id #edb/ref 17592186521602}} {:db/id #edb/ref 17592186521630 :step/content {:db/id #edb/ref 17592186521471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66aa0cf4-9fdd-5d95-be6b-811b502b95a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{yy}=22" :db/id #edb/ref 17592186520998} {:answer/id #uuid "8f3ad138-0924-5a40-8f81-cbba162c0f19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{yy}=16" :db/id #edb/ref 17592186521088} {:answer/id #uuid "b647c1b2-e8a2-513d-bca8-1ba7556ab769" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{yy}=21.3" :db/id #edb/ref 17592186521170} {:answer/id #uuid "ba06e549-bfbb-5699-a72e-3e553bcf6f6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{yy}=13" :db/id #edb/ref 17592186521178} {:answer/id #uuid "f4353feb-c770-5137-9c93-96535a82b4a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{yy}=19" :db/id #edb/ref 17592186521299}] :answer-field/correct {:db/id #edb/ref 17592186521088} :answer-field/id #uuid "97de8c2b-2160-5c30-92a5-23ff5b28889c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521400}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "26b0163b-edde-5aab-b2bd-a06d38a87337" :question/math-academy-id "q-251898" :question/problem "Consider the two sets of $8$ paired observations shown in the table below.\n\n| **$\\,{x}_{i}\\,$** | $9$ | $12$ | $10$ | $15$ | $12$ | $21$ | $6$ | $12$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| **$\\,{y}_{i}\\,$** | $3$ | $4$ | $5$ | $4$ | $7$ | $2$ | $3$ | $4$ |\n\nGiven that ${\\sum }_{i=1}^{8}{y}_{i}^{2}=144,$ calculate ${S}_{yy}.$" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of squared deviations from the mean for the data ${y}_{i}$ can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{yy} & ={\\sum }_{i=1}^{n}({y}_{i}-\\overset{―}{y})^{2} \\\\  & ={\\sum }_{i}{y}_{i}^{2}-\\frac{1}{n}{({\\sum }_{i=1}^{n}{y}_{i})}^{2}\\end{aligned}\n$$\n\nFirst, we calculate the sum of the ${y}_{i}$ data:\n\n$$\n{\\sum }_{i=1}^{8}{y}_{i}=3+4+5+4+7+2+3+4=32.\n$$\n\nWe are given that ${\\sum }_{i=1}^{8}{y}_{i}^{2}=144.$\n\nFinally, by substituting into the above formula, we get\n\n$$\n{S}_{yy}=144-\\frac{1}{8}(32)^{2}=144-128=16.\n$$"} :step/id #uuid "ae51bedd-deee-5ef3-b5f9-595f36d08dbe"} {:db/id #edb/ref 17592186521632 :step/content {:db/id #edb/ref 17592186521455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e38fe49d-81c4-5be4-8d42-66e01917801d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.7" :db/id #edb/ref 17592186521274}] :answer-field/correct {:db/id #edb/ref 17592186521274} :answer-field/id #uuid "f25616a1-e3e9-5a57-bef3-4345308333c4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186521449}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "094cdd1f-e814-5164-bdf6-dc0f3e0f507e" :question/math-academy-id "q-251857" :question/problem "Consider two sets of $40$ paired observations ${x}_{1},{x}_{2},…,{x}_{40},$ and ${y}_{1},{y}_{2},…,{y}_{40}.$ You are given that\n\n$$\n\\begin{aligned}{S}_{xx}=54,\\,{S}_{yy}=35,\\,{S}_{xy}=188.\\end{aligned}\n$$\n\nThen, $Cov(x,y)=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ their covariance can be calculated as follows:\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{{S}_{xy}}{n},\\end{aligned}\n$$\n\nwhere ${S}_{xy}$ is the sum of products of the deviations of ${x}_{i}$ and ${y}_{i}$ from their means.\n\nWe are given that ${S}_{xy}=188.$ Substituting the given statistic in the above formula, we get\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{188}{40} \\\\  & =4.7.\\end{aligned}\n$$"} :step/id #uuid "b37e6950-25d6-5437-bec0-c80cada70611" :step/next {:db/id #edb/ref 17592186521640}} {:db/id #edb/ref 17592186521640 :step/content {:db/id #edb/ref 17592186521460 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f6a7f83-6364-5d0a-9fd6-ef7977380a2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.6" :db/id #edb/ref 17592186520945}] :answer-field/correct {:db/id #edb/ref 17592186520945} :answer-field/id #uuid "203627a4-892f-5453-bd75-4c6fd9a28c76" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186521341}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1470b28d-5083-563f-9b26-d7812411f35b" :question/math-academy-id "q-251861" :question/problem "Consider two sets of $15$ paired observations ${x}_{1},{x}_{2},…,{x}_{15},$ and ${y}_{1},{y}_{2},…,{y}_{15}.$ You are given that\n\n$$\n\\begin{aligned}{S}_{xx}=105,\\,{S}_{yy}=81,\\,{S}_{xy}=69.\\end{aligned}\n$$\n\nThen, $Cov(x,y)=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ their covariance can be calculated as follows:\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{{S}_{xy}}{n},\\end{aligned}\n$$\n\nwhere ${S}_{xy}$ is the sum of products of the deviations of ${x}_{i}$ and ${y}_{i}$ from their means.\n\nWe are given that ${S}_{xy}=69.$ Substituting the given statistic in the above formula, we get\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{69}{15} \\\\  & =4.6.\\end{aligned}\n$$"} :step/id #uuid "c7b1248b-f25e-5efc-bec5-63e8214005ee" :step/next {:db/id #edb/ref 17592186521630}}] :activity/title "Sums of Squares" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186520752}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186540151} :activity/id #uuid "94a23f2d-8fa1-5341-a7e1-f1d5a2e5ea11" :activity/scope {:db/id #edb/ref 17592186050406 :topic/id #uuid "467c6e31-0c6e-5017-92e2-f1c8d38e5a4c" :topic/math-academy-id 5204} :activity/steps [{:db/id #edb/ref 17592186540117 :step/content {:db/id #edb/ref 17592186540115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "386c5691-b5b0-5909-a9d6-cd57208e04fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "186" :db/id #edb/ref 17592186539582}] :answer-field/correct {:db/id #edb/ref 17592186539582} :answer-field/id #uuid "73feca10-d97d-5b59-8725-6847129335cf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186539965}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fe1475b2-e88a-5639-9c34-aefc361e0ff5" :question/math-academy-id "q-251794" :question/problem "Consider two sets of $14$ paired observations ${x}_{1},{x}_{2},…,{x}_{14},$ and ${y}_{1},{y}_{2},…,{y}_{14}.$ You are given that\n\n$$\n\\begin{aligned} & {\\sum }_{i=1}^{14}{x}_{i}=157, \\\\  & {\\sum }_{i=1}^{14}{y}_{i}=182, \\\\  & {\\sum }_{i=1}^{14}{x}_{i}{y}_{i}=2\\,227.\\end{aligned}\n$$\n\nThen, ${S}_{xy}=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the statistic ${S}_{xy}$ be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xy} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}{y}_{i}-\\frac{1}{n}({\\sum }_{i=1}^{n}{x}_{i})({\\sum }_{i=1}^{n}{y}_{i}).\\end{aligned}\n$$\n\nSubstituting the given statistics in the above formula, we get\n\n$$\n\\begin{aligned}{S}_{xy} & =2\\,227-\\frac{1}{14}(157)(182) \\\\  & =2\\,227-2\\,041 \\\\  & =186.\\end{aligned}\n$$"} :step/id #uuid "075080f4-fbd5-5910-aa84-ddaafacb2543" :step/next {:db/id #edb/ref 17592186540176}} {:db/id #edb/ref 17592186540130 :step/content {:db/id #edb/ref 17592186540059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e2c88d9-7183-503f-8f87-d5f2453b6ce6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xx}=26" :db/id #edb/ref 17592186539538} {:answer/id #uuid "24b92e1b-6dac-56bd-afde-abf287b17941" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xx}=48" :db/id #edb/ref 17592186539550} {:answer/id #uuid "55462a77-e788-50b5-b111-e635b1fd0381" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xx}=122" :db/id #edb/ref 17592186539626} {:answer/id #uuid "d64241a1-b9bd-5245-9d38-1c834a4c5c12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xx}=87.2" :db/id #edb/ref 17592186539844} {:answer/id #uuid "debcb05c-cb0f-5de9-87ca-767431d038bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xx}=119" :db/id #edb/ref 17592186539862}] :answer-field/correct {:db/id #edb/ref 17592186539550} :answer-field/id #uuid "273080ef-8c7f-5a88-9950-91456455d22a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539933}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "72d27b98-5424-5f73-97fc-8f2eaa4b8548" :question/math-academy-id "q-251896" :question/problem "Consider the two sets of $7$ paired observations shown in the table below.\n\n| **$\\,{x}_{i}\\,$** | $12$ | $14$ | $9$ | $17$ | $15$ | $10$ | $14$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| **$\\,{y}_{i}\\,$** | $15$ | $18$ | $11$ | $10$ | $20$ | $15$ | $16$ |\n\nGiven that ${\\sum }_{i=1}^{7}{x}_{i}^{2}=1\\,231,$ calculate ${S}_{xx}.$" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of squared deviations from the mean for the data ${x}_{i}$ can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xx} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2} \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}^{2}-\\frac{1}{n}{({\\sum }_{i=1}^{n}{x}_{i})}^{2}.\\end{aligned}\n$$\n\nFirst, we calculate the sum of the ${x}_{i}$ data:\n\n$$\n{\\sum }_{i=1}^{7}{x}_{i}=12+\\,14+\\,9+\\,17+\\,15+\\,10+\\,14=91.\n$$\n\nWe are given that ${\\sum }_{i=1}^{7}{x}_{i}^{2}=1\\,231.$\n\nFinally, by substituting into the above formula, we get\n\n$$\n{S}_{xx}=1\\,231-\\frac{1}{7}(91)^{2}=1231-1\\,183=48.\n$$"} :step/id #uuid "3b3dc73d-4deb-517f-8239-1e28183ba06b"} {:db/id #edb/ref 17592186540151 :step/content {:db/id #edb/ref 17592186204445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e208d22-eade-509b-b9cd-26f67b90dab5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "975" :db/id #edb/ref 17592186539565}] :answer-field/correct {:db/id #edb/ref 17592186539565} :answer-field/id #uuid "dfeb687f-763d-54c4-aef3-8444a3902349" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186202606}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d5e13c72-a4ef-5310-a416-6c1b8d1065c7" :question/math-academy-id "q-251491" :question/problem "Consider two sets of $25$ paired observations ${x}_{1},{x}_{2},…,{x}_{25},$ and ${y}_{1},{y}_{2},…,{y}_{25}.$ You are given that\n\n$$\n\\begin{aligned} & {\\sum }_{i=1}^{25}{x}_{i}=250, \\\\  & {\\sum }_{i=1}^{25}{y}_{i}=265, \\\\  & {\\sum }_{i=1}^{25}{x}_{i}{y}_{i}=3\\,625.\\end{aligned}\n$$\n\nThen, ${S}_{xy}=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the statistic ${S}_{xy}$ be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xy} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}{y}_{i}-\\frac{1}{n}({\\sum }_{i=1}^{n}{x}_{i})({\\sum }_{i=1}^{n}{y}_{i}).\\end{aligned}\n$$\n\nSubstituting the given statistics in the above formula, we get\n\n$$\n\\begin{aligned}{S}_{xy} & =3\\,625-\\frac{1}{25}(250)(265) \\\\  & =3\\,625-2\\,650 \\\\  & =975.\\end{aligned}\n$$"} :step/id #uuid "7665738a-290c-5834-a4b9-da964e1eeec9" :step/next {:db/id #edb/ref 17592186540117}} {:db/id #edb/ref 17592186540156 :step/content {:db/id #edb/ref 17592186540110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16428388-adc9-5bc3-a420-1ca62578bc67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186539525}] :answer-field/correct {:db/id #edb/ref 17592186539525} :answer-field/id #uuid "9daa41b5-a3c9-591b-8bf6-1fa87f56a85e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186539974}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f9b76f6d-a314-5376-893f-3c9706a4c31e" :question/math-academy-id "q-251858" :question/problem "Consider two sets of $39$ paired observations ${x}_{1},{x}_{2},…,{x}_{39},$ and ${y}_{1},{y}_{2},…,{y}_{39}.$ You are given that\n\n$$\n\\begin{aligned}{S}_{xx}=663,\\,{S}_{yy}=1\\,092,\\,{S}_{xy}=975.\\end{aligned}\n$$\n\nThen, $Cov(x,y)=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ their covariance can be calculated as follows:\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{{S}_{xy}}{n},\\end{aligned}\n$$\n\nwhere ${S}_{xy}$ is the sum of products of the deviations of ${x}_{i}$ and ${y}_{i}$ from their means.\n\nWe are given that ${S}_{xy}=975.$ Substituting the given statistic in the above formula, we get\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{975}{39} \\\\  & =25.\\end{aligned}\n$$"} :step/id #uuid "8eb70679-39ee-53ce-aad6-c400551eb4cd" :step/next {:db/id #edb/ref 17592186540130}} {:db/id #edb/ref 17592186540176 :step/content {:db/id #edb/ref 17592186536838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e22bc458-30f2-56c5-a752-2720115543c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1250" :db/id #edb/ref 17592186536636}] :answer-field/correct {:db/id #edb/ref 17592186536636} :answer-field/id #uuid "0ae99c74-d6dc-56f1-8e0e-a0b4df319323" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186536704}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5cbb4944-93ba-5c18-a003-1720623144e5" :question/math-academy-id "q-251837" :question/problem "Consider two sets of $27$ paired observations ${x}_{1},{x}_{2},…,{x}_{27},$ and ${y}_{1},{y}_{2},…,{y}_{27}.$ You are given that\n\n$$\n\\begin{aligned} & {\\sum }_{i=1}^{27}{x}_{i}=540,\\,{\\sum }_{i=1}^{27}{y}_{i}=567, \\\\  & {\\sum }_{i=1}^{27}{x}_{i}^{2}=12\\,050,\\,{\\sum }_{i=1}^{27}{y}_{i}^{2}=14\\,107.\\end{aligned}\n$$\n\nCalculate the sum of the squared deviations from the mean for the points ${x}_{i}.$\n\n${S}_{xx}=$\n{{field-1}}" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of squared deviations from the mean for the data ${x}_{i}$ can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xx} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2} \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}^{2}-\\frac{1}{n}{({\\sum }_{i=1}^{n}{x}_{i})}^{2}\\end{aligned}\n$$\n\nSubstituting the given statistics in the above formula, we get\n\n$$\n\\begin{aligned}{S}_{xx} & =12\\,050-\\frac{1}{27}(540)^{2} \\\\  & =12\\,050-10\\,800 \\\\  & =1\\,250.\\end{aligned}\n$$"} :step/id #uuid "e5aeca2e-7232-51d5-aca3-7df63cf2122f" :step/next {:db/id #edb/ref 17592186540156}}] :activity/title "Sums of Squares" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186539474}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186563799} :activity/id #uuid "3db7337d-a389-5665-8389-d09f94e9de5d" :activity/scope {:db/id #edb/ref 17592186050406 :topic/id #uuid "467c6e31-0c6e-5017-92e2-f1c8d38e5a4c" :topic/math-academy-id 5204} :activity/steps [{:db/id #edb/ref 17592186563797 :step/content {:db/id #edb/ref 17592186563655 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f3cf9a4-e088-5b99-9833-d8bb8c2bb442" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.8" :db/id #edb/ref 17592186563195}] :answer-field/correct {:db/id #edb/ref 17592186563195} :answer-field/id #uuid "1b5318d2-3f2f-55cf-b4e0-80a9f6598453" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186563537}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "17851fea-30ed-54e9-89be-985c48bef200" :question/math-academy-id "q-251850" :question/problem "Consider two sets of $20$ paired observations ${x}_{1},{x}_{2},…,{x}_{20},$ and ${y}_{1},{y}_{2},…,{y}_{20}.$ You are given that\n\n$$\n\\begin{aligned}{S}_{xx}=60,\\,{S}_{yy}=116,\\,{S}_{xy}=100.\\end{aligned}\n$$\n\nThen, ${\\sigma }_{y}^{2}=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the variance of ${y}_{i}$ can be calculated as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{y}^{2} & =\\frac{{S}_{yy}}{n},\\end{aligned}\n$$\n\nwhere ${S}_{yy}$ is the sum of squared deviations from the mean for the data ${y}_{i}.$\n\nWe are given that ${S}_{yy}=116.$ Substituting the given statistic in the above formula, we get\n\n$$\n\\begin{aligned}{\\sigma }_{y}^{2} & =\\frac{116}{20} \\\\  & =5.8.\\end{aligned}\n$$"} :step/id #uuid "a7895719-cd74-5149-b7a2-f4d6e3aaf4d8"} {:db/id #edb/ref 17592186563799 :step/content {:db/id #edb/ref 17592186512921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53c4e854-a95f-58d6-aaed-933846604762" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "83" :db/id #edb/ref 17592186512286}] :answer-field/correct {:db/id #edb/ref 17592186512286} :answer-field/id #uuid "be6a6eec-8d66-5b27-9486-87b9b28cd48f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186512827}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ae961e11-0326-56d9-bf54-b78685d8bc1a" :question/math-academy-id "q-251795" :question/problem "Consider two sets of $16$ paired observations ${x}_{1},{x}_{2},…,{x}_{16},$ and ${y}_{1},{y}_{2},…,{y}_{16}.$ You are given that\n\n$$\n\\begin{aligned} & {\\sum }_{i=1}^{16}{x}_{i}=168, \\\\  & {\\sum }_{i=1}^{16}{y}_{i}=158, \\\\  & {\\sum }_{i=1}^{16}{x}_{i}{y}_{i}=1\\,742.\\end{aligned}\n$$\n\nThen, ${S}_{xy}=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the statistic ${S}_{xy}$ be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xy} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}{y}_{i}-\\frac{1}{n}({\\sum }_{i=1}^{n}{x}_{i})({\\sum }_{i=1}^{n}{y}_{i}).\\end{aligned}\n$$\n\nSubstituting the given statistics in the above formula, we get\n\n$$\n\\begin{aligned}{S}_{xy} & =1\\,742-\\frac{1}{16}(168)(158) \\\\  & =1\\,742-1\\,659 \\\\  & =83.\\end{aligned}\n$$"} :step/id #uuid "ad3cd3d3-d40e-5da8-8eb0-d07f1135677a" :step/next {:db/id #edb/ref 17592186563800}} {:db/id #edb/ref 17592186563800 :step/content {:db/id #edb/ref 17592186563704 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c5d8ba4-23fd-58c5-878f-33e321fefa74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=32" :db/id #edb/ref 17592186562965} {:answer/id #uuid "3cacd545-fd7c-5c12-b57f-e54b5d1d6829" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=30.5" :db/id #edb/ref 17592186563080} {:answer/id #uuid "a38d71f2-fdd4-5997-bdf4-77d25628f1b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=33.5" :db/id #edb/ref 17592186563314} {:answer/id #uuid "afb01973-c81f-590b-a69b-afca6cd48a7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=27.5" :db/id #edb/ref 17592186563337} {:answer/id #uuid "c7395bc7-0a3c-5f1c-a9c6-0a647dc4241a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=24" :db/id #edb/ref 17592186563383}] :answer-field/correct {:db/id #edb/ref 17592186563314} :answer-field/id #uuid "71771a9c-6d44-5ba0-b159-1c1d1cb21717" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563573}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7487be5e-d3cc-5ed9-9625-a2ce92482f7c" :question/math-academy-id "q-251806" :question/problem "Consider the two sets of $8$ paired observations in the table below.\n\n| **$\\,{x}_{i}\\,$** | $16$ | $9$ | $12$ | $10$ | $11$ | $11$ | $6$ | $9$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| **$\\,{y}_{i}\\,$** | $10$ | $14$ | $8$ | $10$ | $7$ | $8$ | $2$ | $4$ |\n\nGiven that ${\\sum }_{i=1}^{8}{x}_{i}{y}_{i}=695,$ calculate ${S}_{xy}.$" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of products of deviations from the means can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xy} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & ={\\sum }_{i}{x}_{i}{y}_{i}-\\frac{1}{n}({\\sum }_{i=1}^{n}{x}_{i})({\\sum }_{i=1}^{n}{y}_{i})\\end{aligned}\n$$\n\nFirst, we calculate the sum of the ${x}_{i}$ and ${y}_{i}:$\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}{x}_{i} & =16+9+12+10+11+11+6+9=84, \\\\ {\\sum }_{i=1}^{n}{y}_{i} & =10+14+8+10+7+8+2+4=63\\end{aligned}\n$$\n\nWe are given that ${\\sum }_{i=1}^{8}{x}_{i}{y}_{i}=695.$\n\nFinally, by substituting in the above formula, we get\n\n$$\n{S}_{xy}=695-\\frac{1}{8}(84)(63)=695-661.5=33.5.\n$$"} :step/id #uuid "b482909e-911d-5802-9b01-f344a82c291e" :step/next {:db/id #edb/ref 17592186563797}}] :activity/title "Sums of Squares" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186562926}]}
