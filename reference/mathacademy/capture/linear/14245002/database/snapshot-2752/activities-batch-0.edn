#{[{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186204875} :activity/id #uuid "3ca1fe5c-e3e2-5af9-bb9f-82c8c2f00317" :activity/scope {:db/id #edb/ref 17592186050406 :topic/id #uuid "467c6e31-0c6e-5017-92e2-f1c8d38e5a4c" :topic/math-academy-id 5204} :activity/steps [{:db/id #edb/ref 17592186204875 :step/content {:db/id #edb/ref 17592186205125 :tutorial/content "Given a data set $x_1, x_2, \\ldots, x_n,$ we know that its variance, which we may denote as $\\sigma_x^2,$ is given by\n\n$$\n\\sigma_x^2 = \\dfrac1n \\sum_{i=1}^n (x_i - \\overline x)^2\n$$\n\nwhere $\\overline x$ is the mean of $x.$ \n\nThe summation term\n\n$$\nS_{xx} = \\sum_{i=1}^n (x_i - \\overline x)^2\n$$\n\nis known as a **sum of squares** and is denoted $S_{xx}.$ As we'll see, this quantity often appears in statistical analysis, so giving it a separate notation is useful.\n\nSimilarly, if we have a data set $y_1, y_2, \\ldots, y_n,$ then we define\n\n$$\nS_{yy} =  \\sum_{i=1}^n (y_i - \\overline y)^2.\n$$\n\nNow, suppose we have the bivariate data set\n\n$$\n(x_1, y_1), \\qquad (x_2, y_2),\\qquad \\ldots, \\qquad (x_n, y_n).\n$$\n\nThen, the covariance is given by\n\n$$\n\\textrm{Cov}(x,y) =  \\dfrac1n\\sum_{i=1}^n (x_i - \\overline x)(y_i - \\overline y)\n$$\n\nand we may define $S_{xy}$ as\n\n$$\nS_{xy} = \\sum_{i=1}^n (x_i - \\overline{x})(y_i - \\overline{y}).\n$$\n\nFinally, we can define the variance and covariance in terms of $S_{xx}, S_{yy},$ and $S_{xy}$ as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{x}^{2} & =\\frac{{S}_{xx}}{n},\\,{\\sigma }_{y}^{2}=\\frac{{S}_{yy}}{n},\\,\\text{Cov}(x,y)=\\frac{{S}_{xy}}{n}\\end{aligned}\n$$" :tutorial/id #uuid "f7e454c5-fb32-5adc-b4bd-0eb93ccd4ce7" :tutorial/math-academy-id 10575 :tutorial/title "Introduction"} :step/id #uuid "780a886e-f7ec-5134-8c19-6ef13b7e6958" :step/math-academy-id 226927 :step/next {:db/id #edb/ref 17592186204876}} {:db/id #edb/ref 17592186204876 :step/content {:db/id #edb/ref 17592186204008 :knowledge-point/canonical-example {:db/id #edb/ref 17592186203803 :question/id #uuid "6f0e3d4b-943b-5710-a996-ac4d3c68778d" :question/math-academy-id "e-16399"} :knowledge-point/id #uuid "d0afa4d8-6d02-52c6-9836-12089de8f406" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048914} {:db/id #edb/ref 17592186049126}] :knowledge-point/questions [{:db/id #edb/ref 17592186204443} {:db/id #edb/ref 17592186204444} {:db/id #edb/ref 17592186512866} {:db/id #edb/ref 17592186512868} {:db/id #edb/ref 17592186512914} {:db/id #edb/ref 17592186536828} {:db/id #edb/ref 17592186536892}] :knowledge-point/title "Calculating Sums of Squares Given a Dataset or Summary Statistics"} :step/id #uuid "c4508f2d-5b01-5156-a636-efc40f9518ac" :step/math-academy-id 226928 :step/next {:db/id #edb/ref 17592186204877}} {:db/id #edb/ref 17592186204877 :step/content {:db/id #edb/ref 17592186204009 :knowledge-point/canonical-example {:db/id #edb/ref 17592186203805 :question/id #uuid "7daa2313-4672-5624-aac2-e3b87b6ec366" :question/math-academy-id "e-16401"} :knowledge-point/id #uuid "714000f9-caea-57a3-a8cb-6b8ec99960d1" :knowledge-point/questions [{:db/id #edb/ref 17592186204447} {:db/id #edb/ref 17592186204448} {:db/id #edb/ref 17592186512890} {:db/id #edb/ref 17592186512901} {:db/id #edb/ref 17592186512920} {:db/id #edb/ref 17592186512923} {:db/id #edb/ref 17592186521455} {:db/id #edb/ref 17592186521460} {:db/id #edb/ref 17592186540110} {:db/id #edb/ref 17592186563655}] :knowledge-point/title "Calculating Variance and Covariance"} :step/id #uuid "b96fcd87-a442-5e10-907a-17ae7bf45eef" :step/math-academy-id 226931 :step/next {:db/id #edb/ref 17592186204878}} {:db/id #edb/ref 17592186204878 :step/content {:db/id #edb/ref 17592186205126 :tutorial/content "Calculating $S_{xx}, S_{yy},$ and $S_{xy}$ using their definitions can be cumbersome. Thankfully, we have the following shortcut formulas:\n\n$$\n\\begin{aligned}{S}_{xx} & ={\\sum }_{i=1}^{n}{x}_{i}^{2}-\\frac{1}{n}{({\\sum }_{i=1}^{n}{x}_{i})}^{2} \\\\ {S}_{yy} & ={\\sum }_{i=1}^{n}{y}_{i}^{2}-\\frac{1}{n}{({\\sum }_{i=1}^{n}{y}_{i})}^{2} \\\\ {S}_{xy} & ={\\sum }_{i=1}^{n}{x}_{i}{y}_{i}-\\frac{1}{n}({\\sum }_{i=1}^{n}{x}_{i})({\\sum }_{i=1}^{n}{y}_{i})\\end{aligned}\n$$\n\nWe'll prove these at the end of the lesson." :tutorial/id #uuid "c497f58a-e56b-5fde-9a53-c8553e8dcbcf" :tutorial/math-academy-id 10576 :tutorial/title "Shortcut Formulas"} :step/id #uuid "d1fb1eb8-ff7c-5cd3-b9e5-580d6a2360ac" :step/math-academy-id 226934 :step/next {:db/id #edb/ref 17592186204879}} {:db/id #edb/ref 17592186204879 :step/content {:db/id #edb/ref 17592186204010 :knowledge-point/canonical-example {:db/id #edb/ref 17592186203806 :question/id #uuid "9804df95-f494-5d99-acbd-97c69344d401" :question/math-academy-id "e-16402"} :knowledge-point/id #uuid "1f0ed04b-f011-5818-952d-425a19e0cd5c" :knowledge-point/questions [{:db/id #edb/ref 17592186204442} {:db/id #edb/ref 17592186204455} {:db/id #edb/ref 17592186512885} {:db/id #edb/ref 17592186512907} {:db/id #edb/ref 17592186512942} {:db/id #edb/ref 17592186512955} {:db/id #edb/ref 17592186521471} {:db/id #edb/ref 17592186536838} {:db/id #edb/ref 17592186540059}] :knowledge-point/title "Calculating Sums of Squares Using the Shortcut Formula"} :step/id #uuid "88b4bb82-3260-512d-b14c-8e8a43f1aaa4" :step/math-academy-id 226935 :step/next {:db/id #edb/ref 17592186204880}} {:db/id #edb/ref 17592186204880 :step/content {:db/id #edb/ref 17592186204011 :knowledge-point/canonical-example {:db/id #edb/ref 17592186203804 :question/id #uuid "489e5ffd-9e78-567b-b009-25d0c004825a" :question/math-academy-id "e-16400"} :knowledge-point/id #uuid "83df73fc-c0cc-5605-9b39-453de0c37cc7" :knowledge-point/questions [{:db/id #edb/ref 17592186204445} {:db/id #edb/ref 17592186204446} {:db/id #edb/ref 17592186233680} {:db/id #edb/ref 17592186512910} {:db/id #edb/ref 17592186512911} {:db/id #edb/ref 17592186512921} {:db/id #edb/ref 17592186512939} {:db/id #edb/ref 17592186521520} {:db/id #edb/ref 175921865401