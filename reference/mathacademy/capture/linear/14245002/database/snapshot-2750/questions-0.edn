#{[{:db/id #edb/ref 17592186512921 :knowledge-point/_questions [{:db/id #edb/ref 17592186204011 :knowledge-point/id #uuid "83df73fc-c0cc-5605-9b39-453de0c37cc7" :knowledge-point/title "Calculating S(x,y) Using the Shortcut Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53c4e854-a95f-58d6-aaed-933846604762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "83" :db/id #edb/ref 17592186512286}] :answer-field/correct {:answer/id #uuid "53c4e854-a95f-58d6-aaed-933846604762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "83" :db/id #edb/ref 17592186512286} :answer-field/id #uuid "be6a6eec-8d66-5b27-9486-87b9b28cd48f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186512827}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae961e11-0326-56d9-bf54-b78685d8bc1a" :question/math-academy-id "q-251795" :question/problem "Consider two sets of $16$ paired observations ${x}_{1},{x}_{2},…,{x}_{16},$ and ${y}_{1},{y}_{2},…,{y}_{16}.$ You are given that\n\n$$\n\\begin{aligned} & {\\sum }_{i=1}^{16}{x}_{i}=168, \\\\  & {\\sum }_{i=1}^{16}{y}_{i}=158, \\\\  & {\\sum }_{i=1}^{16}{x}_{i}{y}_{i}=1\\,742.\\end{aligned}\n$$\n\nThen, ${S}_{xy}=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the statistic ${S}_{xy}$ be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xy} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}{y}_{i}-\\frac{1}{n}({\\sum }_{i=1}^{n}{x}_{i})({\\sum }_{i=1}^{n}{y}_{i}).\\end{aligned}\n$$\n\nSubstituting the given statistics in the above formula, we get\n\n$$\n\\begin{aligned}{S}_{xy} & =1\\,742-\\frac{1}{16}(168)(158) \\\\  & =1\\,742-1\\,659 \\\\  & =83.\\end{aligned}\n$$"}]}
