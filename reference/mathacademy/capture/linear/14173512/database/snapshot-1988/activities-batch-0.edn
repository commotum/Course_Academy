#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186111726} :activity/id #uuid "823419db-8de6-590e-8d12-60c4a4921be8" :activity/scope {:db/id #edb/ref 17592186050889 :topic/id #uuid "6ea4a4a8-a41b-576b-b701-36d0b9902524" :topic/math-academy-id 1507} :activity/steps [{:db/id #edb/ref 17592186111428 :step/content {:db/id #edb/ref 17592186110547 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110436 :question/id #uuid "11f90b96-0b4d-5f8d-8b0d-b4cde31fc7fd" :question/math-academy-id "e-3044"} :knowledge-point/id #uuid "2f6b7437-6922-58bd-a819-de7fb02a261e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050532}] :knowledge-point/questions [{:db/id #edb/ref 17592186111084} {:db/id #edb/ref 17592186111085} {:db/id #edb/ref 17592186492833} {:db/id #edb/ref 17592186492869}] :knowledge-point/title "Calculating an Unknown Quantity Using Vertical Angles"} :step/id #uuid "fc9b2937-76b3-5f60-a004-4e4ea833b4db" :step/math-academy-id 10143 :step/next {:db/id #edb/ref 17592186111727}} {:db/id #edb/ref 17592186111726 :step/content {:db/id #edb/ref 17592186111838 :tutorial/content "When two lines meet at a point, they create two pairs of opposite angles. The angles in each pair are called **vertical angles**.\n\nVertical angles are *always* congruent.\n\n![](images/0d/0d5b2895ae18beb7242ef666af08e5b8e3490880de99aec8d993b02f31a9fcf4.png)\n\nIn the diagram above, $\\angle 1$ and $\\angle 3$ are vertical angles and are therefore congruent. \n\nLikewise, $\\angle 2$ and $\\angle 4$ are vertical angles and are therefore congruent. \n\nSo, we have $\\angle 1 \\cong \\angle 3$ and $\\angle 2 \\cong \\angle 4.$" :tutorial/id #uuid "d4d9e056-1e55-54e4-a5e4-9aee258c4fb0" :tutorial/math-academy-id 2179 :tutorial/title "Introduction"} :step/id #uuid "f9299154-a343-50c2-b86c-1b7953800ab9" :step/math-academy-id 8745 :step/next {:db/id #edb/ref 17592186111428}} {:db/id #edb/ref 17592186111727 :step/content {:db/id #edb/ref 17592186110749 :know