#{[{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186162834} :activity/id #uuid "0481b748-a2c3-549d-87bb-442640a2e50f" :activity/scope {:db/id #edb/ref 17592186049024 :topic/id #uuid "d4915fbb-3ba0-55bd-ad16-ce672a3ac557" :topic/math-academy-id 3082} :activity/steps [{:db/id #edb/ref 17592186162834 :step/content {:db/id #edb/ref 17592186163216 :tutorial/content "A **linear Diophantine equation** with two variables $x$ and $y$ takes the form \n\n$$\nax+by=c,\n$$\n\nwhere $a,$ $b,$ and $c$ are integer constants. A **solution of a Diophantine equation** is any integer pair \n\n$$\n(x,y)\n$$\n\n that satisfies the equation.\n\nFor example, the Diophantine equation \n\n$$\n2x+3y=9\n$$\n\nhas an infinite number of integer solutions:\n\n$$\n(3, 1), \\quad (6, -1), \\quad (15, -7), \\quad \\ldots\n$$" :tutorial/id #uuid "74479694-00cd-56e4-a966-17ec3c6a6df4" :tutorial/math-academy-id 4859 :tutorial/title "Introduction"} :step/id #uuid "8fdb2ed6-395d-5acd-a018-d4c94702acd2" :step/math-academy-id 30433 :step/next {:db/id #edb/ref 17592186162835}} {:db/id #edb/ref 17592186162835 :step/content {:db/id #edb/ref 17592186161972 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161764 :question/id #uuid "41efb6ec-beb7-52ff-9951-fd73454e50d6" :question/math-academy-id "e-8134"} :knowledge-point/id #uuid "8919d471-0e4c-55c1-b39e-2b46a86540d2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048714}] :knowledge-point/questions [{:db/id #edb/ref 17592186162576} {:db/id #edb/ref 17592186162604} {:db/id #edb/ref 17592186414080} {:db/id #edb/ref 17592186414082}] :knowledge-point/title "Identifying a Solution of a Linear Diophantine Equation"} :step/id #uuid "a32eefb7-ec52-5fbb-a2ee-f1bfe513b195" :step/math-academy-id 30434 :step/next {:db/id #edb/ref 17592186162837}} {:db/id #edb/ref 17592186162836 :step/content {:db/id #edb/ref 17592186161973 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161765 :question/id #uuid "b156d26b-369f-57d7-8fcf-3e67f2c03e60" :question/math-academy-id "e-8135"} :knowledge-point/id #uuid "607df418-165b-5d37-aae1-d49ce8e9d3e5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049540}] :knowledge-point/questions [{:db/id #edb/ref 17592186162577} {:db/id #edb/ref 17592186162605} {:db/id #edb/ref 17592186414084} {:db/id #edb/ref 17592186414086}] :knowledge-point/title "Identifying Whether a Linear Diophantine Equation Has a Solution"} :step/id #uuid "4452042f-220b-53ea-a8da-dfb2eabdd9ed" :step/math-academy-id 30435 :step/next {:db/id #edb/ref 17592186162839}} {:db/id #edb/ref 17592186162837 :step/content {:db/id #edb/ref 17592186163217 :tutorial/content "The linear Diophantine equation\n\n$$\nax+by=c\n$$\n\nhas a solution if and only if $d \\: | \\: c,$ where $d = \\text{gcd}(a,b).$  \n\nLet's use the theorem to test some Diophantine equations.\n\n- Consider the equation\n\n$$\n2x+10y=17.\n$$\n\nHere, we have $a=2,$ $b=10,$ and $c=17.$ Notice that\n\n$$\nd=\\text{gcd}(2,10)=2\n$$\n\nand $2 \\!\\not{|}\\: 17.$ Therefore, according to the theorem, our equation has no solution.\n\nIndeed, notice that the expression on the left-hand side ($2x+10y$) is always an even number, while the right-hand side of the equation ($17$) is an odd number. As a result, there is no solution. \n\n- Consider the equation\n\n$$\n4x+5y=7.\n$$\n\nHere, we have $a=4,$ $b=5,$ and $c=7.$ Since \n\n$$\nd=\\text{gcd}(4,5)=1\n$$\n\nand $1 \\:{|}\\: 7,$ our equation has solutions.\n\nIndeed, one of the solutions for $4x+5y=7$ is the pair $(3,-1).$" :tutorial/id #uuid "a6d53d84-2ce8-5b31-b71b-49fa570f368e" :tutorial/math-academy-id 4860 :tutorial/title "When a Linear Diophantine Equation Has No Solutions"} :step/id #uuid "bdfa6024-4717-5bbc-92b3-98318be5fc5f" :step/math-academy-id 30436 :step/next {:db/id #edb/ref 17592186162836}} {:db/id #edb/ref 17592186162838 :step/content {:db/id #edb/ref 17592186161974 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161766 :question/id #uuid "5771c3fd-b47b-5f51-bc0c-d87771df70d7" :question/math-academy-id "e-8136"} :knowledge-point/id #uuid "b68b2579-6ae9-53a4-a9f1-b36ff041d500" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049094}] :knowledge-point/questions [{:db/id #edb/ref 17592186162578} {:db/id #edb/ref 17592186162610} {:db/id #edb/ref 17592186378004} {:db/id #edb/ref 17592186378011} {:db/id #edb/ref 17592186414081}] :knowledge-point/title "Solving a Linear Diophantine Equation"} :step/id #uuid "82601269-9394-5a74-98c8-230c9e6656f6" :step/math-academy-id 30437} {:db/id #edb/ref 17592186162839 :step/content {:db/id #edb/ref 17592186163218 :tutorial/content "If $(x_0,y_0)$ is any particular solution of the equation, then the set of all solutions consists of integer pairs  \n\n$$\n\\left( x_0 + \\dfrac{b}{d}t, \\: y_0 - \\dfrac{a}{d}t \\right), \\qquad t = 0, \\pm 1, \\pm2, \\ldots \\: .\n$$\n\nIn particular, if $d=1,$ we obtain\n\n$$\n\\left( x_0 + bt, \\: y_0 - at \\right), \\qquad t = 0, \\pm 1, \\pm2, \\ldots \\: .\n$$\n\nFor example, given that $(x,y)=(4,-1)$ is a solution of the Diophantine equation \n\n$$\n4x+5y=11,\n$$\n\nfind its general solution. \n\nHere, we have $a=4,$ $b=5,$ and $c=11.$ Since $(4,-1)$ is a solution of $4x+5y=11,$ the general solution must be\n\n$$\n\\begin{aligned}(4+\\frac{5}{1}t,\\,-1-\\frac{4}{1}t) & =(4+5t,\\,-1-4t),\\end{aligned}\n$$\n\nwhere $t=0, \\pm1, \\pm2, \\ldots \\, .$" :tutorial/id #uuid "c3e3ddb7-77b6-506b-9d49-fe534bdcba95" :tutorial/math-academy-id 4861 :tutorial/title "The General Solution of a Linear Diophantine Equation"} :step/id #uuid "db14dd1c-a261-5a71-90b3-4c876c46dcb6" :step/math-academy-id 30444 :step/next {:db/id #edb/ref 17592186162840}} {:db/id #edb/ref 17592186162840 :step/content {:db/id #edb/ref 17592186161975 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161767 :question/id #uuid "1b1f251a-cb4e-5af9-b7ab-fddfbfc45faa" :question/math-academy-id "e-8138"} :knowledge-point/id #uuid "096b8bc9-e3fc-55fa-8266-5cafa411a2f6" :knowledge-point/questions [{:db/id #edb/ref 17592186162579} {:db/id #edb/ref 17592186162580} {:db/id #edb/ref 17592186414083} {:db/id #edb/ref 17592186414085}] :knowledge-point/title "Finding the General Solution of a Linear Diophantine Equation Given One of Its Solutions"} :step/id #uuid "97b0c1e1-2c35-5f66-9ab8-4bd40f549331" :step/math-academy-id 30446 :step/next {:db/id #edb/ref 17592186162838}}] :activity/title "Linear Diophantine Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162209}]}
