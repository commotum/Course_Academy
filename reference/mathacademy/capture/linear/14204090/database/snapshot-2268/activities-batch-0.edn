/id #edb/ref 17592186079117}] :knowledge-point/title "Finding the Formula for the Nth Term Given Another Term and the Common Difference"} :step/id #uuid "d7eb2ee2-b02f-5c37-95cf-f08741a24e06" :step/math-academy-id 187834}] :activity/title "The Nth Term of an Arithmetic Sequence" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078684}]}
