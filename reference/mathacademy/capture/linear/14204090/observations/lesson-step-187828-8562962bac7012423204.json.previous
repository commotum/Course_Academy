9\" d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-3D\" d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-31\" d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-2B\" d=\"M56 237T56 250T70 270H369V420L370 570Q380 583 389 583Q402 583 409 568V270H707Q722 262 722 250T707 230H409V-68Q401 -82 391 -82H389H387Q375 -82 369 -68V230H70Q56 237 56 250Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-2212\" d=\"M84 237T84 250T98 270H679Q694 262 694 250T679 230H98Q84 237 84 250Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMATHI-64\" d=\"M366 683Q367 683 438 688T511 694Q523 694 523 686Q523 679 450 384T375 83T374 68Q374 26 402 26Q411 27 422 35Q443 55 463 131Q469 151 473 152Q475 153 483 153H487H491Q506 153 506 145Q506 140 503 129Q490 79 473 48T445 8T417 -8Q409 -10 393 -10Q359 -10 336 5T306 36L300 51Q299 52 296 50Q294 48 292 46Q233 -10 172 -10Q117 -10 75 30T33 157Q33 205 53 255T101 341Q148 398 195 420T280 442Q336 442 364 400Q369 394 369 396Q370 400 396 505T424 616Q424 629 417 632T378 637H357Q351 643 351 645T353 664Q358 683 366 683ZM352 326Q329 405 277 405Q242 405 210 374T160 293Q131 214 119 129Q119 126 119 118T118 106Q118 61 136 44T179 26Q233 26 290 98L298 109L352 326Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E2-MJMATHI-66\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-28\" x=\"550\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMATHI-6E\" x=\"940\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-29\" x=\"1540\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-3D\" x=\"2207\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMATHI-66\" x=\"3264\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-28\" x=\"3814\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-31\" x=\"4204\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-29\" x=\"4704\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2B\" x=\"5316\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-28\" x=\"6317\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMATHI-6E\" x=\"6706\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2212\" x=\"7529\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-31\" x=\"8529\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-29\" x=\"9030\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMATHI-64\" x=\"9419\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2E\" x=\"9943\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>We are given the first term <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"9.158ex\" height=\"2.843ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -863.1 3943.1 1223.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-3-Title\">\n<title id=\"MathJax-SVG-3-Title\">f(1)={\\color{blue}0}.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E3-MJMATHI-66\" d=\"M118 -162Q120 -162 124 -164T135 -167T147 -168Q160 -168 171 -155T187 -126Q197 -99 221 27T267 267T289 382V385H242Q195 385 192 387Q188 390 188 397L195 425Q197 430 203 430T250 431Q298 431 298 432Q298 434 307 482T319 540Q356 705 465 705Q502 703 526 683T550 630Q550 594 529 578T487 561Q443 561 443 603Q443 622 454