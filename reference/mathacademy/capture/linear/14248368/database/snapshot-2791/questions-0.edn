#{[{:db/id #edb/ref 17592186128964 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129302 :knowledge-point/id #uuid "503a2d0a-ba6c-5529-9f26-b83c769a26a2" :knowledge-point/title "Finding the Domain of a Transformed Reciprocal Function"}] :question/id #uuid "b7a64276-0aab-5ef0-861b-528ebbd66e60" :question/math-academy-id "e-5839" :question/problem "What is the domain of the function $f(x) = \\dfrac{3}{2-x}+1?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except those that make the denominator zero. To find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}2-x & =0 \\\\ x & =2.\\end{aligned}\n$$\n\nTherefore, the domain is  $x \\in (-\\infty,2) \\cup (2 ,\\infty).$"}] [{:db/id #edb/ref 17592186128965 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129303 :knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/id #uuid "1d4c0776-f7ea-5529-bb58-8f9d892c9551" :question/math-academy-id "e-5840" :question/problem "The domain of the function $f(x) = \\dfrac{5}{2x-a}+3$ is $(-\\infty,3) \\cup (3 ,+\\infty).$ What is the value of $a?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}2x-a & =0 \\\\ 2x & =a \\\\ x & =\\frac{a}{2}.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x = \\dfrac{a}{2}.$ \n\nOn the other hand, we can see that $x=3$ is excluded from the domain. Equating this to $\\dfrac{a}{2},$ we get\n\n$$\n\\begin{aligned}\\frac{a}{2} & =3 \\\\ a & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186128966 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129304 :knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/id #uuid "fb0fd8d0-a34c-509f-a13d-dc39464262c0" :question/math-academy-id "e-5841" :question/problem "Find the range of the function $f(x)=\\dfrac{3}{4x-1}+2.$" :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x) = \\dfrac{a}{bx+c} + d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore, its range is\n\n$$\nf(x) \\in (-\\infty, d)\\cup (d,\\infty).\n$$\n\nIn our case, $d = 2.$ Therefore, the horizontal asymptote is $y = 2,$ and the range of the function is\n\n$$\nf(x) \\in (-\\infty, 2) \\cup (2, \\infty).\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](images/fb/fb344a1c6613805bab7bcc04c8b711b5ba1c26eef36197c45b03205e2bc5dbc6.png)"}] [{:db/id #edb/ref 17592186364709 :knowledge-point/_questions [{:db/id #edb/ref 17592186129304 :knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6766513e-2896-5f9e-8127-d8009c1faf2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-3)\\cup (-3,\\infty )" :db/id #edb/ref 17592186364711} {:answer/id #uuid "710db2f0-829c-532f-ab1b-37dc4e5f2ae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,4)\\cup (4,\\infty )" :db/id #edb/ref 17592186364712} {:answer/id #uuid "08e8b32f-4438-5f6b-a14c-e8ea868e70eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,3)\\cup (3,\\infty )" :db/id #edb/ref 17592186364713} {:answer/id #uuid "f8efdcf0-f302-5462-b76f-d3024ef6a818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-2)\\cup (-2,\\infty )" :db/id #edb/ref 17592186364714} {:answer/id #uuid "193f133e-b0a3-51f3-86c4-c5d4648ce6a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-5)\\cup (-5,\\infty )" :db/id #edb/ref 17592186364715}] :answer-field/correct {:answer/id #uuid "6766513e-2896-5f9e-8127-d8009c1faf2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-3)\\cup (-3,\\infty )" :db/id #edb/ref 17592186364711} :answer-field/id #uuid "9a0489fd-3135-5e0f-bd36-ffa3b3553d6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364710}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3e883836-cad7-580b-9e8a-24fa830bfc9b" :question/math-academy-id "q-106747" :question/problem "What is the range of $f(x)=\\frac{5}{4-x}-3?$" :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x)=\\frac{a}{bx+c}+d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore, its range is\n\n$$\nf(x)\\in (-\\infty ,d)\\cup (d,\\infty ).\n$$\n\nIn our case, $d=-3.$ Therefore, the horizontal asymptote is $y=-3,$ and the range of the function is\n\n$$\nf(x)\\in (-\\infty ,-3)\\cup (-3,\\infty ).\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](images/b1/b1b6683bab3caf6fc2350c14382266483c848e6b0490d4d1b7cf6c5f5d2ad273.png)"}] [{:db/id #edb/ref 17592186294843 :knowledge-point/_questions [{:db/id #edb/ref 17592186129302 :knowledge-point/id #uuid "503a2d0a-ba6c-5529-9f26-b83c769a26a2" :knowledge-point/title "Finding the Domain of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c5247d4-8e31-57f3-ae52-37cfc07abbd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186293303}] :answer-field/correct {:answer/id #uuid "5c5247d4-8e31-57f3-ae52-37cfc07abbd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186293303} :answer-field/id #uuid "1e388363-f26a-593b-acd3-eed7b90aee37" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294028} {:answer-field/choices [{:answer/id #uuid "05876ed1-1c25-5ec5-aea2-a8e603460c86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186292955}] :answer-field/correct {:answer/id #uuid "05876ed1-1c25-5ec5-aea2-a8e603460c86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186292955} :answer-field/id #uuid "3fc78a53-2085-5204-ab61-c296a83eccb8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294149} {:answer-field/choices [{:answer/id #uuid "55fbaeaf-df9b-5ff7-80d2-63dc8fa7a61f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186293283}] :answer-field/correct {:answer/id #uuid "55fbaeaf-df9b-5ff7-80d2-63dc8fa7a61f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186293283} :answer-field/id #uuid "9d3f8d39-95a5-593d-a567-b7d92d998b80" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294497}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "81159dc4-76c4-50b0-ae3d-b2812d3bd662" :question/math-academy-id "q-276607" :question/problem "What is the domain of the function $f(x)=\\frac{7}{3x-12}\\,?$\n\nThe domain is\n$x\\in (-\\infty ,$\n{{field-1}}$)\\cup (${{field-2}}$,$\n{{field-3}}$).$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}3x-12 & =0 \\\\ 3x & =12 \\\\ x & =\\frac{12}{3} \\\\ x & =4.\\end{aligned}\n$$\n\nTherefore, the domain is $x\\in (-\\infty ,4)\\cup (4,\\infty ).$"}] [{:db/id #edb/ref 17592186294851 :knowledge-point/_questions [{:db/id #edb/ref 17592186129303 :knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cdec77d3-f758-533e-b94d-95a5175abead" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186293727}] :answer-field/correct {:answer/id #uuid "cdec77d3-f758-533e-b94d-95a5175abead" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186293727} :answer-field/id #uuid "4ae73e0e-4aab-5fee-a08f-9c1fc5417de2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294195}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0e31c6b4-744c-5f6b-83bb-dc39caa8f302" :question/math-academy-id "q-276643" :question/problem "If the domain of the function $f(x)=\\frac{10}{kx+4}$ is $(-\\infty ,-\\frac{1}{2})\\cup (-\\frac{1}{2},\\infty ),$ then $k=${{field-1}}." :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}kx+4 & =0 \\\\ kx & =-4 \\\\ x & =-\\frac{4}{k}.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=-\\frac{4}{k}.$ \n\nOn the other hand, we can see that $x=-\\frac{1}{2}$ is excluded from the domain. Equating this to $-\\frac{4}{k},$ we get\n\n$$\n\\begin{aligned}-\\frac{4}{k} & =-\\frac{1}{2} \\\\ \\frac{4}{k} & =\\frac{1}{2} \\\\ k & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186294853 :knowledge-point/_questions [{:db/id #edb/ref 17592186129303 :knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a17a8c-e820-5306-9ba2-c5062c747c20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186293016}] :answer-field/correct {:answer/id #uuid "14a17a8c-e820-5306-9ba2-c5062c747c20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186293016} :answer-field/id #uuid "08a7703f-1852-5a61-8a23-bc0e6c3133d5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293951}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d2acc18f-6649-5da5-99ec-a581a511537c" :question/math-academy-id "q-276663" :question/problem "If the domain of the function $f(x)=\\frac{2x+7}{bx+5}$ is $(-\\infty ,-\\frac{5}{6})\\cup (-\\frac{5}{6},\\infty ),$ then $b=${{field-1}}." :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}bx+5 & =0 \\\\ bx & =-5 \\\\ x & =-\\frac{5}{b}.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=-\\frac{5}{b}.$ \n\nOn the other hand, we can see that $x=-\\frac{5}{6}$ is excluded from the domain. Equating this to $-\\frac{5}{b},$ we get\n\n$$\n\\begin{aligned}-\\frac{5}{b} & =-\\frac{5}{6} \\\\ \\frac{5}{b} & =\\frac{5}{6} \\\\ b & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186294860 :knowledge-point/_questions [{:db/id #edb/ref 17592186129304 :knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "910a859e-2f39-5d44-9724-856252bb097d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186293499}] :answer-field/correct {:answer/id #uuid "910a859e-2f39-5d44-9724-856252bb097d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186293499} :answer-field/id #uuid "03cb80ef-0d9e-5570-9d16-7c09debde870" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293941} {:answer-field/choices [{:answer/id #uuid "3dec42cf-e086-5ae4-850c-3ef4185d372e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186293178}] :answer-field/correct {:answer/id #uuid "3dec42cf-e086-5ae4-850c-3ef4185d372e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186293178} :answer-field/id #uuid "ac0ed6ee-35ca-53af-b996-1a23be08d47f" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294549} {:answer-field/choices [{:answer/id #uuid "f1cc1066-7dee-5012-8ed9-5c6a489bf4f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186293873}] :answer-field/correct {:answer/id #uuid "f1cc1066-7dee-5012-8ed9-5c6a489bf4f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186293873} :answer-field/id #uuid "dde32572-8787-55e0-b07b-cc51561e3c70" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294705}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8f1e9d48-4b9a-5415-83bb-4467d8d9a1d3" :question/math-academy-id "q-276692" :question/problem "What is the range of the function $f(x)=-\\frac{9}{2x+9}+5\\,?$\n\nThe range is\n$f(x)\\in (${{field-1}}$,$\n{{field-2}}$)\\cup (${{field-3}}$,\\infty ).$" :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x)=\\frac{a}{bx+c}+d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore, its range is\n\n$$\nf(x)\\in (-\\infty ,d)\\cup (d,\\infty ).\n$$\n\nIn our case, $d=5.$ Therefore, the horizontal asymptote is $y=5,$ and the range of the function is\n\n$$\nf(x)\\in (-\\infty ,5)\\cup (5,\\infty ).\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](images/0d/0da9b33dde51888d770d9e095d74b628698d870727a53f252948d99644c7bc3d.png)"}]}
