#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186130273} :activity/id #uuid "e3919b64-e475-58f4-849f-f742f95030ba" :activity/scope {:db/id #edb/ref 17592186050344 :topic/id #uuid "413bfc2b-04ec-5814-ae32-700a3a3979c5" :topic/math-academy-id 2082} :activity/steps [{:db/id #edb/ref 17592186130273 :step/content {:db/id #edb/ref 17592186130366 :tutorial/content "When we transform the reciprocal function $y= \\dfrac{1}{x},$ its domain might be modified as well.\n\nFor example, the diagram below shows the graph of the transformed reciprocal function $f(x) = \\dfrac{1}{x+2}.$\n\n![](images/f7/f729214a66435995d8a20c48b237105f50e0521d2aac93f2d4ba958c55d3ca5a.png)\n\nA reciprocal function is defined for all values of $x$ except for those that make the denominator zero. To find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator of the reciprocal function above equal to zero and solving, we get\n\n$$\n\\begin{aligned}x+2 & =0 \\\\ x & =-2.\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\in(-\\infty, -2) \\cup (-2, +\\infty).$" :tutorial/id #uuid "c427d3bc-8bab-524d-9288-5f24daf1dcc0" :tutorial/math-academy-id 3767 :tutorial/title "Introduction"} :step/id #uuid "581a8b43-bc30-5e7a-a7fb-9f4cf06161cd" :step/math-academy-id 465149 :step/next {:db/id #edb/ref 17592186130274}} {:db/id #edb/ref 17592186130274 :step/content {:db/id #edb/ref 17592186129302 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128964 :question/id #uuid "b7a64276-0aab-5ef0-861b-528ebbd66e60" :question/math-academy-id "e-5839"} :knowledge-point/id #uuid "503a2d0a-ba6c-5529-9f26-b83c769a26a2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186049072}] :knowledge-point/questions [{:db/id #edb/ref 17592186129695} {:db/id #edb/ref 17592186129769} {:db/id #edb/ref 17592186294843} {:db/id #edb/ref 17592186294844} {:db/id #edb/ref 17592186294845} {:db/id #edb/ref 17592186294847} {:db/id #edb/ref 17592186326735} {:db/id #edb/ref 17592186326738} {:db/id #edb/ref 17592186326798} {:db/id #edb/ref 17592186326799} {:db/id #edb/ref 17592186338905} {:db/id #edb/ref 17592186351284}] :knowledge-point/title "Finding the Domain of a Transformed Reciprocal Function"} :step/id #uuid "f0defeba-39f3-5776-83cd-b994338983c6" :step/math-academy-id 465150 :step/next {:db/id #edb/ref 17592186130275}} {:db/id #edb/ref 17592186130275 :step/content {:db/id #edb/ref 17592186129303 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128965 :question/id #uuid "1d4c0776-f7ea-5529-bb58-8f9d892c9551" :question/math-academy-id "e-5840"} :knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/questions [{:db/id #edb/ref 17592186129593} {:db/id #edb/ref 17592186129875} {:db/id #edb/ref 17592186247356} {:db/id #edb/ref 17592186247357} {:db/id #edb/ref 17592186292707} {:db/id #edb/ref 17592186294850} {:db/id #edb/ref 17592186294851} {:db/id #edb/ref 17592186294852} {:db/id #edb/ref 17592186294853} {:db/id #edb/ref 17592186294855} {:db/id #edb/ref 17592186326801} {:db/id #edb/ref 17592186326802} {:db/id #edb/ref 17592186326804} {:db/id #edb/ref 17592186351285} {:db/id #edb/ref 17592186351286} {:db/id #edb/ref 17592186364852}] :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"} :step/id #uuid "16081658-cb71-581c-98e5-b1db328a50ea" :step/math-academy-id 465154 :step/next {:db/id #edb/ref 17592186130276}} {:db/id #edb/ref 17592186130276 :step/content {:db/id #edb/ref 17592186130367 :tutorial/content "When we transform the reciprocal function $y=\\dfrac1x,$ we might also modify its range. \n\nFor example, consider the graph of the transformed reciprocal function $f(x) = \\dfrac1x -2,$ shown below.\n\n![](images/74/745bdf3daa3acfcb8a3505e1931cc31ab86c2e4e9e43d2e6266d3156f9cab4fb.png)\n\nNotice that the function has the horizontal asymptote $y=-2.$\n\nThe function $y=f(x)$ can attain any $y$-value with the exception of the $y$-value of the horizontal asymptote. Therefore, to compute its range, we take the interval $(-\\infty,\\infty)$ and exclude the $y$-value of the asymptote.\n\nTherefore, the range of $y = f(x)$ is \n\n$$\nf(x)\\in (-\\infty, -2) \\cup (-2,\\infty).\n$$\n\nIn general, a transformed reciprocal function of the form\n\n$$\nf(x) = \\dfrac{a}{bx+c} + d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore its range is\n\n$$\nf(x) \\in (-\\infty, d)\\cup (d,\\infty).\n$$" :tutorial/id #uuid "626ffa04-a6c0-5b42-a423-c07d1bd7ea1f" :tutorial/math-academy-id 3771 :tutorial/title "The Range of a Transformed Reciprocal Function"} :step/id #uuid "c4978fb4-2d49-5954-85ac-60cd1b70d52e" :step/math-academy-id 465157 :step/next {:db/id #edb/ref 17592186130277}} {:db/id #edb/ref 17592186130277 :step/content {:db/id #edb/ref 17592186129304 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128966 :question/id #uuid "fb0fd8d0-a34c-509f-a13d-dc39464262c0" :question/math-academy-id "e-5841"} :knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050580}] :knowledge-point/questions [{:db/id #edb/ref 17592186129694} {:db/id #edb/ref 17592186129876} {:db/id #edb/ref 17592186243940} {:db/id #edb/ref 17592186243942} {:db/id #edb/ref 17592186243943} {:db/id #edb/ref 17592186292708} {:db/id #edb/ref 17592186292709} {:db/id #edb/ref 17592186294856} {:db/id #edb/ref 17592186294857} {:db/id #edb/ref 17592186294858} {:db/id #edb/ref 17592186294859} {:db/id #edb/ref 17592186294860} {:db/id #edb/ref 17592186294861} {:db/id #edb/ref 17592186364695} {:db/id #edb/ref 17592186364709} {:db/id #edb/ref 17592186365491}] :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"} :step/id #uuid "d1017813-a8f4-5e3f-bd78-d8a31ad19e27" :step/math-academy-id 465158}] :activity/title "Domain and Range of Transformed Reciprocal Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186129394}]}
