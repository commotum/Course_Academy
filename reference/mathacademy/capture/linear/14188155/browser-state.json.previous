</mo><mi>h</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mo>=</mo></mtd></mtr><mtr><mtd><mn>2</mn><mi>f</mi><mi>g</mi><mi>h</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
