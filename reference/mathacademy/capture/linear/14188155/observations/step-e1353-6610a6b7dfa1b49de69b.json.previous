0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E1-MJSZ3-221A\" x=\"0\" y=\"79\"></use>\n<rect stroke=\"none\" width=\"1283\" height=\"60\" x=\"1000\" y=\"1470\"></rect>\n<g transform=\"translate(1000,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1043\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(69,676)\">\n <use xlink:href=\"#E1-MJMATHI-72\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E1-MJMAIN-32\" x=\"638\" y=\"408\"></use>\n</g>\n<g transform=\"translate(60,-780)\">\n <use xlink:href=\"#E1-MJMATHI-73\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E1-MJMAIN-32\" x=\"663\" y=\"408\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span> given that <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"5.998ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 2582.6 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-2-Title\">\n<title id=\"MathJax-SVG-2-Title\">s&gt;0.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E2-MJMATHI-73\" d=\"M131 289Q131 321 147 354T203 415T300 442Q362 442 390 415T419 355Q419 323 402 308T364 292Q351 292 340 300T328 326Q328 342 337 354T354 372T367 378Q368 378 368 379Q368 382 361 388T336 399T297 405Q249 405 227 379T204 326Q204 301 223 291T278 274T330 259Q396 230 396 163Q396 135 385 107T352 51T289 7T195 -10Q118 -10 86 19T53 87Q53 126 74 143T118 160Q133 160 146 151T160 120Q160 94 142 76T111 58Q109 57 108 57T107 55Q108 52 115 47T146 34T201 27Q237 27 263 38T301 66T318 97T323 122Q323 150 302 164T254 181T195 196T148 231Q131 256 131 289Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-3E\" d=\"M84 520Q84 528 88 533T96 539L99 540Q106 540 253 471T544 334L687 265Q694 260 694 250T687 235Q685 233 395 96L107 -40H101Q83 -38 83 -20Q83 -19 83 -17Q82 -10 98 -1Q117 9 248 71Q326 108 378 132L626 250L378 368Q90 504 86 509Q84 513 84 520Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-30\" d=\"M96 585Q152 666 249 666Q297 666 345 640T423 548Q460 465 460 320Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E2-MJMATHI-73\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-3E\" x=\"747\" y=\"0\"></use>\n<g transform=\"translate(1803,0)\">\n <use xlink:href=\"#E2-MJMAIN-30\"></use>\n <use xlink:href=\"#E2-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n</g>\n</g>\n</svg></span></p>\n\n                    </div>     \n            \n                    <div class=\"exampleExplanationHeader\">EXPLANATION</div>\n            \n                    <div class=\"exampleExplanation\">\n                        <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direction: ltr;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            border: 0;\n                            padding: 0;\n                            margin: 0\n                            }\n\n                            .mjpage * {\n                            transition: none;\n                            -webkit-transition: none;\n                            -moz-transition: none;\n                            -ms-transition: none;\n                            -o-transition: none\n                            }\n\n                            .mjx-svg-href {\n                            fill: blue;\n                            stroke: blue\n                            }\n\n                            .MathJax_SVG_LineBox {\n                            display: table!important\n                            }\n\n                            .MathJax_SVG_LineBox span {\n                            display: table-cell!important;\n                            width: 10000em!important;\n                            min-width: 0;\n                            max-width: none;\n                            padding: 0;\n                            border: 0;\n                            margin: 0\n                            }\n\n                            .mjpage__block {\n                            text-align: center;\n                            margin: 1em 0em;\n                            position: relative;\n                            display: block!important;\n                            text-indent: 0;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            width: 100%\n                            }</style><p>The square root of a squared quantity can be simplified using absolute value:</p>\n<p><span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"10.429ex\" height=\"3.509ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -1150.1 4490.5 1510.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-1-Title\">\n<title id=\"MathJax-SVG-1-Title\">\n\\sqrt{x^2} = |x|\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E1-MJMATHI-78\" d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40Q91 39 97 36T113 29T132 26Q168 26 194 71Q203 87 217 139T245 247T261 313Q266 340 266 352Q266 380 251 392T217 404Q177 404 142 372T93 290Q91 281 88 280T72 278H58Q52 284 52 289Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJMAIN-32\" d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJSZ1-221A\" d=\"M263 249Q264 249 315 130T417 -108T470 -228L725 302Q981 837 982 839Q989 850 1001 850Q1008 850 1013 844T1020 832V826L741 243Q645 43 540 -176Q479 -303 469 -324T453 -348Q449 -350 436 -350L424 -349L315 -96Q206 156 205 156L171 130Q138 104 137 104L111 130L263 249Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJMAIN-3D\" d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\"></path>\n<path stroke-width=\"1\" id=\"E1-MJMAIN-7C\" d=\"M139 -249H137Q125 -249 119 -235V251L120 737Q130 750 139 750Q152 750 159 735V-235Q151 -249 141 -249H139Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E1-MJSZ1-221A\" x=\"0\" y=\"162\"></use>\n<rect stroke=\"none\" width=\"1026\" height=\"60\" x=\"1000\" y=\"953\"></rect>\n<g transform=\"translate(1000,0)\">\n <use xlink:href=\"#E1-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E1-MJMAIN-32\" x=\"809\" y=\"583\"></use>\n</g>\n <use xlink:href=\"#E1-MJMAIN-3D\" x=\"2304\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-7C\" x=\"3360\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMATHI-78\" x=\"3639\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-7C\" x=\"4211\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>In our case, we can simplify the given expression as follows:</p>\n<p><span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"11.285ex\" height=\"38.509ex\" style=\"vertical-align: -18.671ex;\" viewBox=\"0 -8541.3 4858.7 16580.3\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-2-Title\">\n<title id=\"MathJax-SVG-2-Title\">\n\t\\eqalign{\n\\sqrt{\\dfrac{r^2}{s^2}} &amp;= <span>\\</span>[5pt]\n\n\\sqrt{\\dfrac{r}{s} \\cdot \\dfrac{r}{s}} &amp;= <span>\\</span>[5pt]\n\n\\sqrt{\\left(\\dfrac{r}{s}\\right)^2} &amp;= <span>\\</span>[5pt]\n\n\\left|\\dfrac{r}{s}\\right| &amp;= <span>\\</span>[5pt]\n\n\\dfrac{|r|}{|s|} &amp; \n\t}\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E2-MJMATHI-72\" d=\"M21 287Q22 290 23 295T28 317T38 348T53 381T73 411T99 433T132 442Q161 442 183 430T214 408T225 388Q227 382 228 382T236 389Q284 441 347 441H350Q398 441 422 400Q430 381 430 363Q430 333 417 315T391 292T366 288Q346 288 334 299T322 328Q322 376 378 392Q356 405 342 405Q286 405 239 331Q229 315 224 298T190 165Q156 25 151 16Q138 -11 108 -11Q95 -11 87 -5T76 7T74 17Q74 30 114 189T154 366Q154 405 128 405Q107 405 92 377T68 316T57 280Q55 278 41 278H27Q21 284 21 287Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-32\" d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMATHI-73\" d=\"M131 289Q131 321 147 354T203 415T300 442Q362 442 390 415T419 355Q419 323 402 308T364 292Q351 292 340 300T328 326Q328 342 337 354T354 372T367 378Q368 378 368 379Q368 382 361 388T336 399T297 405Q249 405 227 379T204 326Q204 301 223 291T278 274T330 259Q396 230 396 163Q396 135 385 107T352 51T289 7T195 -10Q118 -10 86 19T53 87Q53 126 74 143T118 160Q133 160 146 151T160 120Q160 94 142 76T111 58Q109 57 108 57T107 55Q108 52 115 47T146 34T201 27Q237 27 263 38T301 66T318 97T323 122Q323 150 302 164T254 181T195 196T148 231Q131 256 131 289Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJSZ4-221A\" d=\"M983 1739Q988 1750 1001 1750Q1008 1750 1013 1745T1020 1733Q1020 1726 742 244T460 -1241Q458 -1250 439 -1250H436Q424 -1250 424 -1248L410 -1166Q395 -1083 367 -920T312 -601L201 44L137 -83L111 -57L187 96L264 247