e\">)</mo><mo>⋅</mo><mn>2</mn></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><mn>10</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>6</mn><mi>x</mi></mrow><mrow><mi>x</mi><mo>+</mo><mn>10</mn></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><mn>10</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mn>2</mn></mtd><mtd><mi></mi><mo>=</mo><menclose notation=\"updiagonalstrike\"><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><mn>10</mn><mo stretchy=\"false\">)</mo></menclose><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>6</mn><mi>x</mi></mrow><menclose notation=\"updiagonalstrike\"><mi>x</mi><mo>+</mo><mn>10</mn></menclose></mfrac></mstyle></mtd></mtr><mtr><mtd><mn>2</mn><mi>x</mi><mo>+</mo><mn>20</mn></mtd><mtd><mi></mi><mo>=</mo><mn>6</mn><mi>x</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Then, we apply the addition and multiplication principles, as usual:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"68\" style=\"font-size: 113.1%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 10.289em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-bottom: 0.4em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class