type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u-v)({u}^{2}-2uv-{v}^{2})" :db/id #edb/ref 17592186526993} {:answer/id #uuid "fb79a307-4c65-53e9-a927-d82583e482d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u+v)({u}^{2}-2uv+{v}^{2})" :db/id #edb/ref 17592186527002}] :answer-field/correct {:answer/id #uuid "27c64f24-0d09-5df4-90dd-c29025c86c01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(u+v)({u}^{2}-uv+{v}^{2})" :db/id #edb/ref 17592186526589} :answer-field/id #uuid "32eaed90-4af1-595e-a09a-fcfcd024c34b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186527030}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0184b3b4-f2c2-5b99-95bf-75c75b254d85" :question/math-academy-id "q-3599" :question/problem "Factor ${u}^{3}+{v}^{3}.$" :question/worked-solution "The sum of cubes formula is given by\n\n$$\n{a}^{3}+{b}^{3}=(a+b)({a}^{2}-ab+{b}^{2}).\n$$\n\nWe factor our expression using the sum of cubes formula:\n\n$$\n\\begin{aligned}{u}^{3}+{v}^{3} & =(u+v)({u}^{2}-uv+{v}^{2})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186527213 :knowledge-point/_questions [{:db/id #edb/ref 17592186068744 :knowledge-point/id #uuid "4682b115-6156-5496-8faf-81000bcd993e" :knowledge-point/title "Factoring a Difference of Cubes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "064d15c3-a0de-5346-b883-d6b90e56b38b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\sqrt{j})(1+\\sqrt{j}+j)" :db/id #edb/ref 17592186526515} {:answer/id #uuid "101b2f56-a291-5e34-96a2-f1d545e44187" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+\\sqrt{j})(1+j+{j}^{2})" :db/id #edb/ref 17592186526535} {:answer/id #uuid "ba75a583-8bd5-5f4f-b57d-0064c5a8a98f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-j)(1-\\sqrt{j}+j)" :db/id #edb/ref 17592186526859} {:answer/id #uuid "dcf74dbe-f21c-5e1b-9d2e-7adddf5228f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\sqrt{j})(1+\\sqrt{j}+{j}^{2})" :db/id #edb/ref 17592186526933} {:answer/id #uuid "e2e1d5f7-b8ba-5e77-b26d-65f15622ddcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\sqrt{j})(1-j-{j}^{2})" :db/id #edb/ref 17592186526947}] :answer-field/correct {:answer/id #uuid "064d15c3-a0de-5346-b883-d6b90e56b38b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\sqrt{j})(1+\\sqrt{j}+j)" :db/id #edb/ref 17592186526515} :answer-field/id #uuid "fda84225-aba2-5045-8a04-e66c3a2630f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186527120}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d6fb18a1-0afa-52ee-a564-35b978a84f8b" :question/math-academy-id "q-3601" :question/problem "Factor $1-{j}^{3/2}.$" :question/worked-solution "The difference of cubes formula is given by\n\n$$\n{a}^{3}-{b}^{3}=(a-b)({a}^{2}+ab+{b}^{2}).\n$$\n\nNotice that we can write our expression as a difference of cubes:\n\n$$\n1-{j}^{3/2}={1}^{3}-{({j}^{1/2})}^{3}={1}^{3}-{(\\sqrt{j})}^{3}\n$$\n\nNow, we factor the given expression using the difference of cubes formula:\n\n$$\n\\begin{aligned}1-{j}^{3/2} & ={1}^{3}-{(\\sqrt{j})}^{3} \\\\  & =(1-\\sqrt{j})({1}^{2}+1\\cdot \\sqrt{j}+(\\sqrt{j})^{2}) \\\\  & =(1-\\sqrt{j})(1+\\sqrt{j}+j)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186527139 :knowledge-point/_questions [{:db/id #edb/ref 17592186068744 :knowledge-point/id #uuid "4682b115-6156-5496-8faf-81000bcd993e" :knowledge-point/title "Factoring a Difference of Cubes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bd39f00-76e2-5b63-9319-2c2b865a5332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({q}^{2}-3d)({q}^{4}+3d{q}^{2}+9{d}^{2})" :db/id #edb/ref 17592186526690} {:answer/id #uuid "bb780b17-ffd1-53b6-a8c8-ff494ba6cf99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(q-d)({q}^{4}-3d{q}^{2}+9{d}^{2})" :db/id #edb/ref 17592186526862} {:answer/id #uuid "dc3d9974-95c1-5f13-95a5-908d08c97f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({q}^{2}+3d)({q}^{4}+d{q}^{2}+3d)" :db/id #edb/ref 17592186526929} {:answer/id #uuid "e3d60daf-5109-5e14-8dae-ef03258f17e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(q-3d)({q}^{4}-3d{q}^{2}+3{d}^{2})" :db/id #edb/ref 17592186526949} {:answer/id #uuid "e7745848-fe8b-56b8-85f5-71f52b80e1bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(q+d)({q}^{4}-d{q}^{2}+9{d}^{2})" :db/id #edb/ref 17592186526959}] :answer-field/correct {:answer/id #uuid "5bd39f00-76e2-5b63-9319-2c2b865a5332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({q}^{2}-3d)({q}^{4}+3d{q}^{2}+9{d}^{2})" :db/id #edb/ref 17592186526690} :answer-field/id #uuid "0bf50773-cb5a-5ead-acf4-696f7fdbc82d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186527015}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "246f9007-c107-5fa6-a212-74a6a9a70dc6" :question/math-academy-id "q-37554" :question/problem "Factor the expression ${q}^{6}-27{d}^{3}.$" :question/worked-solution "The difference of cubes formula is given by\n\n$$\n{a}^{3}-{b}^{3}=(a-b)({a}^{2}+ab+{b}^{2}).\n$$\n\nNotice that we can write our expression as a difference of cubes:\n\n$$\n{q}^{6}-27{d}^{3}={({q}^{2})}^{3}-{(3d)}^{3}\n$$\n\nNow, we factor the given expression using the difference of cubes formula:\n\n$$\n\\begin{aligned}{q}^{6}-27{d}^{3} & ={({q}^{2})}^{3}-{(3d)}^{3} \\\\  & =({q}^{2}-3d)(({q}^{2})^{2}+{q}^{2}\\cdot 3d+(3d)^{2}) \\\\  & =({q}^{2}-3d)({q}^{4}+3d{q}^{2}+9{d}^{2})\\end{aligned}\n$$"}]}
