#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186088740} :activity/id #uuid "4ee3f6cf-7f54-503a-9d82-660a1ecf09f8" :activity/scope {:db/id #edb/ref 17592186049695 :topic/id #uuid "0bd4af20-8e63-5977-8ad8-a3833c62469f" :topic/math-academy-id 895} :activity/steps [{:db/id #edb/ref 17592186088740 :step/content {:db/id #edb/ref 17592186088886 :tutorial/content "Suppose that we want to solve the quadratic equation\n\n$$\nx^2 -2x +2=0.\n$$\n\nThis quadratic is written in standard form with $a=1,$ $b=-2,$ and $c=2.$ However, its discriminant is negative:\n\n$$\n\\begin{aligned}{b}^{2}-4ac & =(-2)^{2}-4(1)(2) \\\\  & =4-8 \\\\  & =-4 \\\\  & <0\\end{aligned}\n$$\n\nThis means that the quadratic equation has no real solutions. However, if we allow complex solutions, we may solve the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{-(-2)\\pm \\sqrt{(-2)^{2}-4(1)(2)}}{2\\cdot 1} \\\\  & =\\frac{2\\pm \\sqrt{-4}}{2} \\\\  & =\\frac{2\\pm 2\\text{i}}{2} \\\\  & =1\\pm \\text{i}\\end{aligned}\n$$\n\nTherefore, the equation $x^2 -2x +2=0$ has two solutions, $x=1+\\textrm{i}$ and $x=1-\\textrm{i}.$" :tutorial/id #uuid "275a04ea-da37-527f-9ade-d57aa888110b" :tutorial/math-academy-id 2827 :tutorial/title "Introduction"} :step/id #uuid "625577f3-63da-5990-aa37-6436fc70cf20" :step/math-academy-id 455706 :step/next {:db/id #edb/ref 17592186088741}} {:db/id #edb/ref 17592186088741 :step/content {:db/id #edb/ref 17592186087828 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087498 :question/id #uuid "2e80a8b3-de45-51f0-9241-a699222da37b" :question/math-academy-id "e-4157"} :knowledge-point/id #uuid "bbe35c7b-8068-5b28-a820-d25e6b62565a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048428} {:db/id #edb/ref 17592186050465}] :knowledge-point/questions [{:db/id #edb/ref 17592186088048} {:db/id #edb/ref 17592186088076} {:db/id #edb/ref 17592186088077} {:db/id #edb/ref 17592186335884} {:db/id #edb/ref 17592186390448} {:db/id #edb/ref 17592186522730} {:db/id #edb/ref 17592186522805} {:db/id #edb/ref 17592186522811}] :knowledge-point/title "Solving a Quadratic Equation With Complex Roots Using the Quadratic Formula"} :step/id #uuid "7641a04f-8f2b-513e-af55-334dff7e186c" :step/math-academy-id 455707 :step/next {:db/id #edb/ref 17592186088742}} {:db/id #edb/ref 17592186088742 :step/content {:db/id #edb/ref 17592186087829 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087632 :question/id #uuid "7f7e9924-1c7b-516c-928c-962a4cd5cbcc" :question/math-academy-id "e-7517"} :knowledge-point/id #uuid "ef8dec7d-5154-59ee-aee8-9f068eb6b8f4" :knowledge-point/questions [{:db/id #edb/ref 17592186088078} {:db/id #edb/ref 17592186088251} {:db/id #edb/ref 17592186233675} {:db/id #edb/ref 17592186233676} {:db/id #edb/ref 17592186233738} {:db/id #edb/ref 17592186233739} {:db/id #edb/ref 17592186234208} {:db/id #edb/ref 17592186335883} {:db/id #edb/ref 17592186390453}] :knowledge-point/title "Rearranging and Solving a Quadratic Equation With Complex Roots"} :step/id #uuid "04a3ac7e-6653-5ae7-bf85-4e6eb8db0752" :step/math-academy-id 455711 :step/next {:db/id #edb/ref 17592186088743}} {:db/id #edb/ref 17592186088743 :step/content {:db/id #edb/ref 17592186088887 :tutorial/content "We can also solve a quadratic equation with complex solutions using the square root method.\n\nTo demonstrate, let's find the solutions of the equation $(x-2)^2=-16.$\n\nThe left-hand side is a perfect square. Therefore, we can solve the equation as follows:\n\n$$\n\\begin{aligned}(x-2)^{2} & =-16 \\\\ x-2 & =\\pm \\sqrt{-16} \\\\ x-2 & =\\pm 4\\text{i} \\\\ x & =2\\pm 4\\text{i}\\end{aligned}\n$$\n\nSometimes, we need to complete the square first before applying the square root method. Let's see how." :tutorial/id #uuid "145efd5f-c374-5133-89cb-39314be19dcd" :tutorial/math-academy-id 2829 :tutorial/title "Solving a Quadratic Equation With Complex Roots by Completing the Square"} :step/id #uuid "8514fb33-b596-528a-a07d-1f67ad500b05" :step/math-academy-id 455714 :step/next {:db/id #edb/ref 17592186088744}} {:db/id #edb/ref 17592186088744 :step/content {:db/id #edb/ref 17592186087830 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087499 :question/id #uuid "af6ecee9-30de-5913-be21-f184d6f9cacd" :question/math-academy-id "e-4160"} :knowledge-point/id #uuid "a9c8c1d8-2662-5c15-b084-084f9e930141" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049250}] :knowledge-point/questions [{:db/id #edb/ref 17592186088079} {:db/id #edb/ref 17592186088250} {:db/id #edb/ref 17592186088258} {:db/id #edb/ref 17592186233677} {:db/id #edb/ref 17592186233678} {:db/id #edb/ref 17592186234210} {:db/id #edb/ref 17592186247337} {:db/id #edb/ref 17592186290598} {:db/id #edb/ref 17592186335907} {:db/id #edb/ref 17592186399788} {:db/id #edb/ref 17592186403230} {:db/id #edb/ref 17592186522714} {:db/id #edb/ref 17592186522814}] :knowledge-point/title "Solving a Quadratic Equation With Complex Roots by Completing the Square"} :step/id #uuid "402941da-4dd4-589e-92f9-62b01650ad6b" :step/math-academy-id 455715}] :activity/title "Solving Quadratic Equations With Complex Roots" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087957}]}
