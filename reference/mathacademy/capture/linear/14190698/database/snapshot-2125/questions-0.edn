c49a1cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{12}^{∘}" :db/id #edb/ref 17592186503158} {:answer/id #uuid "6fc1ecb5-d7eb-5500-bd4b-91ea1d561875" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{∘}" :db/id #edb/ref 17592186503204} {:answer/id #uuid "7961ee07-8f19-530d-a718-164eaa2b4559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{28}^{∘}" :db/id #edb/ref 17592186503227} {:answer/id #uuid "c372a766-c59f-5385-8c29-b00b163db7b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{24}^{∘}" :db/id #edb/ref 17592186503375}] :answer-field/correct {:answer/id #uuid "c372a766-c59f-5385-8c29-b00b163db7b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{24}^{∘}" :db/id #edb/ref 17592186503375} :answer-field/id #uuid "6b0ca8a4-e827-5427-bc8e-2d2216283d94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503565}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c6ac92e-0be2-531f-8b8a-397c09e6a538" :question/math-academy-id "q-5920" :question/problem "![](images/41/41719768d5ad07b128d4a44d0dd767c8b40ca23d4a2cc4ea7179c1591c900ebd.png)\n\nSolve for $x$ given the figure above." :question/worked-solution "Since the two angles are supplementary, the sum of their measures is equal to ${180}^{∘}.$ Therefore:\n\n$$\n\\begin{aligned}{40}^{∘}+(5x+{20}^{∘}) & ={180}^{∘} \\\\ 5x+{60}^{∘} & ={180}^{∘} \\\\ 5x & ={120}^{∘} \\\\ x & ={24}^{∘}\\end{aligned}\n$$"}]}
