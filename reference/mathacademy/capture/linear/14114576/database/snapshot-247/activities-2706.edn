#{[{:activity/first-step {:db/id #edb/ref 17592186153096} :activity/id #uuid "21c31b1b-d40c-5fbe-b15a-999554ec43b1" :activity/scope {:db/id #edb/ref 17592186049069 :topic/id #uuid "d6ce2ee6-a753-5ae6-adc3-a2fe1a548d00" :topic/math-academy-id 2706} :activity/steps [{:db/id #edb/ref 17592186153092 :step/content {:db/id #edb/ref 17592186152185 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151980 :question/id #uuid "d2dafa69-6a9b-5f99-a16d-5fe5529ffd66" :question/math-academy-id "e-6704"} :knowledge-point/id #uuid "f63580eb-b476-51fa-a005-560f6e57d911" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050831}] :knowledge-point/questions [{:db/id #edb/ref 17592186152777} {:db/id #edb/ref 17592186152781} {:db/id #edb/ref 17592186292885} {:db/id #edb/ref 17592186295183} {:db/id #edb/ref 17592186295184} {:db/id #edb/ref 17592186345328} {:db/id #edb/ref 17592186345329} {:db/id #edb/ref 17592186345330}] :knowledge-point/title "Computing the Image of a Point Under a Linear Transformation of a Plane"} :step/id #uuid "718f6754-40c5-5b42-a425-d91992e573a7" :step/math-academy-id 24441 :step/next {:db/id #edb/ref 17592186153102}} {:db/id #edb/ref 17592186153093 :step/content {:db/id #edb/ref 17592186152186 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151981 :question/id #uuid "2195a964-074f-5beb-abcd-ba0229e2872b" :question/math-academy-id "e-6705"} :knowledge-point/id #uuid "15e8730b-c59a-5897-8c83-073b54f517a9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049207}] :knowledge-point/questions [{:db/id #edb/ref 17592186152778} {:db/id #edb/ref 17592186152780} {:db/id #edb/ref 17592186235402} {:db/id #edb/ref 17592186292886} {:db/id #edb/ref 17592186292887} {:db/id #edb/ref 17592186295212} {:db/id #edb/ref 17592186295213} {:db/id #edb/ref 17592186295214} {:db/id #edb/ref 17592186295215} {:db/id #edb/ref 17592186295216} {:db/id #edb/ref 17592186295217} {:db/id #edb/ref 17592186345340} {:db/id #edb/ref 17592186345354}] :knowledge-point/title "Computing the Image of a Line Given by an Equation in Standard Form"} :step/id #uuid "c503a970-4f74-565b-a10f-e1aa26b3aade" :step/math-academy-id 24450 :step/next {:db/id #edb/ref 17592186153097}} {:db/id #edb/ref 17592186153095 :step/content {:db/id #edb/ref 17592186152187 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151982 :question/id #uuid "2192176c-e983-5913-b159-4d2bffd72ae1" :question/math-academy-id "e-6713"} :knowledge-point/id #uuid "0c8f0fa1-a86a-577f-bdc9-fc7427faa18d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049846}] :knowledge-point/questions [{:db/id #edb/ref 17592186152779} {:db/id #edb/ref 17592186152782} {:db/id #edb/ref 17592186295038} {:db/id #edb/ref 17592186295185} {:db/id #edb/ref 17592186295186} {:db/id #edb/ref 17592186295187} {:db/id #edb/ref 17592186295188} {:db/id #edb/ref 17592186295191} {:db/id #edb/ref 17592186295192} {:db/id #edb/ref 17592186345332} {:db/id #edb/ref 17592186345333} {:db/id #edb/ref 17592186345334} {:db/id #edb/ref 17592186345335} {:db/id #edb/ref 17592186345336} {:db/id #edb/ref 17592186345337}] :knowledge-point/title "Computing the Image of a Line Given by an Equation in Slope-Intercept Form"} :step/id #uuid "dac3b326-03e4-531d-be2f-af0a55237db9" :step/math-academy-id 24566 :step/next {:db/id #edb/ref 17592186153093}} {:db/id #edb/ref 17592186153096 :step/content {:db/id #edb/ref 17592186153371 :tutorial/content "Consider the linear transformation $\\mathbf T$ with matrix representation $T,$ given by\n\n$$\n[\\begin{aligned}-2 & 1 \\\\ 0 & -2\\end{aligned}]\n$$\n\nGiven a point $A(1,1),$ let $A'$ be the image of $A$ under the action of $\\mathbf T.$ How can we find the coordinates of $A'?$\n\nFirst, we create a column vector $\\mathbf{x}$ containing the coordinates of $A{:}$\n\n$$\n[\\begin{aligned}1 \\\\ 1\\end{aligned}]\n$$\n\nNow, we compute the image of $\\mathbf{x}$ under the action of $\\mathbf T$ by calculating the matrix product $T\\mathbf{x}\\mathbin{:}$\n\n$$\n\\begin{aligned}Tx & =[\\begin{aligned}-2 & 1 \\\\ 0 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nThe result, $T \\mathbf{x},$ contains the coordinates of $A'.$ Therefore, $A'(-1,-2).$" :tutorial/id #uuid "4d5c8f46-d41f-54e7-b904-4a0dd5c53af2" :tutorial/math-academy-id 4090 :tutorial/title "Introduction"} :step/id #uuid "47319bd6-6a77-5e3c-a0b8-c11cb72d7ee1" :step/math-academy-id 24571 :step/next {:db/id #edb/ref 17592186153092}} {:db/id #edb/ref 17592186153097 :step/content {:db/id #edb/ref 17592186153372 :tutorial/content "Consider a non-singular linear transformation $\\mathbf{T}$ and a line that is given by the vector equation \n\n$$\n\\mathbf{r} = \\mathbf{p}+\\mathbf{d}t, \\qquad\n\tt \\in (-\\infty,\\infty).\n$$\n\nNote that, for the above equation to represent a line (and not just a point), we must have $\\mathbf{d} \\neq \\mathbf{0}.$\n\nNow, using the linearity of the transformation, we obtain\n\n$$\n\\begin{aligned}T(r) & =T(p+dt) \\\\  & =T(p)+T(td) \\\\  & =T(p)+tT(d) \\\\  & ={p}^{'}+t{d}^{'},\\end{aligned}\n$$\n\nwhere $\\mathbf{T}(\\mathbf{p})=\\mathbf{p}'$ and $\\mathbf{T}(\\mathbf{d})=\\mathbf{d}'.$\n\nBecause $\\mathbf{T}$ is non-singular and $\\mathbf{d} \\neq \\mathbf{0},$ we know that $\\mathbf{T}(\\mathbf{d}) \\neq \\mathbf{0},$ which means $\\mathbf{d}' \\neq \\mathbf{0}.$\n\nTherefore, the equation $\\mathbf{p}'+t\\mathbf{d}'$ represents a straight line, and we can make the following conclusion:\n\n> *A non-singular linear transformation maps a straight line onto a straight line.*" :tutorial/id #uuid "e0b93f1f-ffda-51cc-87ea-a5906a94f7d9" :tutorial/math-academy-id 4091 :tutorial/title "The Proof That a Linear Transformation Maps a Straight Line Onto a Straight Line"} :step/id #uuid "c1f70e8e-5b79-56df-8c86-d7683913fb7f" :step/math-academy-id 24572} {:db/id #edb/ref 17592186153102 :step/content {:db/id #edb/ref 17592186153379 :tutorial/content "Linear transformations of a plane have the following important property: \n\n> *A non-singular linear transformation in the plane maps a straight line into a straight line. *\n\nTherefore, to find the image of a line $l$ under the action of a linear transformation $\\mathbf{T}$ (represented by its standard matrix $T$), we do the following:\n\n- Find two distinct points $A$ and $B$ that lie on the line $l.$\n\n- Compute the images $A'$ and $B'$ of the points $A$ and $B$ under the action of $\\mathbf{T}.$\n\n- Write down the equation of the line that passes through $A'$ and $B'.$" :tutorial/id #uuid "9501e857-f231-5e41-a526-334a1fed20e5" :tutorial/math-academy-id 4119 :tutorial/title "The Image of a Line Under the Action of a Linear Transformation"} :step/id #uuid "451dbef8-606a-5a73-83ab-109b7eb5a1d1" :step/math-academy-id 24936 :step/next {:db/id #edb/ref 17592186153095}}] :activity/title "Linear Transformations of Points and Lines in the Plane" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152355}]}
