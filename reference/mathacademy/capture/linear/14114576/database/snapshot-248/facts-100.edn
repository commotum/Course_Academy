db/ref 17592186299600 #edb/ref 17592186045585] [17592186105743 #edb/ref 1038 #edb/ref 17592186341989 #edb/ref 17592186045585] [17592186105743 #edb/ref 1038 #edb/ref 17592186375887 #edb/ref 17592186045585] [17592186105743 #edb/ref 1038 #edb/ref 17592186377085 #edb/ref 17592186045585] [17592186105743 #edb/ref 1039 "Calculating Scalar Triple Products Using Its Properties" #edb/ref 17592186045585] [17592186105743 #edb/ref 1041 #edb/ref 17592186105601 #edb/ref 17592186045585] [17592186105743 #edb/ref 1042 #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" #edb/ref 17592186045585] [17592186105969 #edb/ref 1043 #edb/ref 17592186106626 #edb/ref 17592186045585] [17592186105969 #edb/ref 1043 #edb/ref 17592186106627 #edb/ref 17592186045585] [17592186105969 #edb/ref 1043 #edb/ref 17592186106628 #edb/ref 17592186045585] [17592186105969 #edb/ref 1043 #edb/ref 17592186106629 #edb/ref 17592186045585] [17592186105969 #edb/ref 1043 #edb/ref 17592186106630 #edb/ref 17592186045585] [17592186105969 #edb/ref 1043 #edb/ref 17592186106631 #edb/ref 17592186045585] [17592186105969 #edb/ref 1043 #edb/ref 17592186106632 #edb/ref 17592186045585] [17592186105969 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045585] [17592186105969 #edb/ref 1045 "The Scalar Triple Product" #edb/ref 17592186045585] [17592186105969 #edb/ref 1046 #edb/ref 17592186106626 #edb/ref 17592186045585] [17592186105969 #edb/ref 1049 #edb/ref 17592186050362 #edb/ref 17592186045585] [17592186105969 #edb/ref 1053 #uuid "f530f18b-11b2-5bde-8332-6af2fe3c20eb" #edb/ref 17592186045585] [17592186106626 #edb/ref 1058 #edb/ref 17592186106627 #edb/ref 17592186045585] [17592186106626 #edb/ref 1061 15857 #edb/ref 17592186045585] [17592186106626 #edb/ref 1062 #uuid "54962f85-eb4f-5689-8e98-692b298d15d1" #edb/ref 17592186045585] [17592186106626 #edb/ref 1063 #edb/ref 17592186107080 #edb/ref 17592186045585] [17592186106627 #edb/ref 1058 #edb/ref 17592186106628 #edb/ref 17592186045585] [17592186106627 #edb/ref 1061 15858 #edb/ref 17592186045585] [17592186106627 #edb/ref 1062 #uuid "3a87ffcc-ec7d-55bd-9fb9-bf8d091686aa" #edb/ref 17592186045585] [17592186106627 #edb/ref 1063 #edb/ref 17592186105741 #edb/ref 17592186045585] [17592186106628 #edb/ref 1058 #edb/ref 17592186106629 #edb/ref 17592186045585] [17592186106628 #edb/ref 1061 15859 #edb/ref 17592186045585] [17592186106628 #edb/ref 1062 #uuid "49837287-74a9-55df-aeef-eb0b8fd6f361" #edb/ref 17592186045585] [17592186106628 #edb/ref 1063 #edb/ref 17592186107081 #edb/ref 17592186045585] [17592186106629 #edb/ref 1058 #edb/ref 17592186106630 #edb/ref 17592186045585] [17592186106629 #edb/ref 1061 15860 #edb/ref 17592186045585] [17592186106629 #edb/ref 1062 #uuid "8fd2fcb8-9be2-5a30-a126-347cf62d3bd6" #edb/ref 17592186045585] [17592186106629 #edb/ref 1063 #edb/ref 17592186105742 #edb/ref 17592186045585] [17592186106630 #edb/ref 1058 #edb/ref 17592186106631 #edb/ref 17592186045585] [17592186106630 #edb/ref 1061 15861 #edb/ref 17592186045585] [17592186106630 #edb/ref 1062 #uuid "29a88567-7fa3-590d-9466-ca0095d38194" #edb/ref 17592186045585] [17592186106630 #edb/ref 1063 #edb/ref 17592186107082 #edb/ref 17592186045585] [17592186106631 #edb/ref 1058 #edb/ref 17592186106632 #edb/ref 17592186045585] [17592186106631 #edb/ref 1061 15862 #edb/ref 17592186045585] [17592186106631 #edb/ref 1062 #uuid "06a0d838-fa82-5fdb-bf4d-ea928e28bcaa" #edb/ref 17592186045585] [17592186106631 #edb/ref 1063 #edb/ref 17592186105743 #edb/ref 17592186045585] [17592186106632 #edb/ref 1061 15863 #edb/ref 17592186045585] [17592186106632 #edb/ref 1062 #uuid "4b903237-363d-5bc1-826b-fb982e1c9d41" #edb/ref 17592186045585] [17592186106632 #edb/ref 1063 #edb/ref 17592186107083 #edb/ref 17592186045585] [17592186107080 #edb/ref 1064 "The **scalar triple product** of three vectors $\\mathbf{a},$ $\\mathbf{b},$ and $\\mathbf{c}$ is defined as $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$\n\nFor example, suppose we have three vectors $\\mathbf{a} = \\langle -1,2,1 \\rangle,$ $\\mathbf{b} = \\langle 1,1,-2 \\rangle,$ and $\\mathbf{c} = \\langle 0,3,1 \\rangle.$ Let's compute their scalar triple product, $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$\n\nFirst, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{aligned}| \\\\  & =|\\begin{aligned}i & j & k \\\\ 1 & 1 & -2 \\\\ 0 & 3 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -2 \\\\ 3 & 1\\end{aligned}|i-|\\begin{aligned}1 & -2 \\\\ 0 & 1\\end{aligned}|j+|\\begin{aligned}1 & 1 \\\\ 0 & 3\\end{aligned}|k \\\\  & =(1\\cdot 1-(-2)\\cdot 3)i-(1\\cdot 1-(-2)\\cdot 0)j+(1\\cdot 3-1\\cdot 0)k \\\\  & =7i-j+3k \\\\  & =⟨7,-1,3⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-1,2,1⟩\\cdot ⟨7,-1,3⟩ \\\\  & =(-1)\\cdot 7+2\\cdot (-1)+1\\cdot 3 \\\\  & =-6\\end{aligned}\n$$\n\n**Note:** The scalar triple product takes its name from the fact that it multiplies three vectors together and always results in a scalar.\n\nLater, we will learn some geometric intuition behind the scalar triple product. But for now, we will focus on computing the scalar triple product." #edb/ref 17592186045585] [17592186107080 #edb/ref 1065 2952 #edb/ref 17592186045585] [17592186107080 #edb/ref 1066 #uuid "28eff4c1-2c88-5799-b15d-0ab9f27be09b" #edb/ref 17592186045585] [17592186107080 #edb/ref 1067 "Introduction" #edb/ref 17592186045585] [17592186107081 #edb/ref 1064 "It turns out that the scalar triple product $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})$ is just the determinant of the matrix whose rows are given by $\\mathbf{a},$ $\\mathbf{b},$ and $\\mathbf{c}.$\n\nThat is to say, if $\\mathbf{a} = \\langle a_1,a_2,a_3 \\rangle,$ $\\mathbf{b} = \\langle b_1,b_2,b_3 \\rangle,$ and $\\mathbf{c} = \\langle c_1,c_2,c_3 \\rangle,$ then\n\n$$\n\\begin{aligned}a\\cdot (b\\times c)=|\\begin{aligned}{a}_{1} & {a}_{2} & {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{aligned}|.\\end{aligned}\n$$\n\nA proof of this result will be given at the end of the lesson. But for now, let's focus on computing the scalar triple product using the determinant above." #edb/ref 17592186045585] [17592186107081 #edb/ref 1065 2953 #edb/ref 17592186045585] [17592186107081 #edb/ref 1066 #uuid "67915540-ba40-5a4a-a7b0-6d81497d64c4" #edb/ref 17592186045585] [17592186107081 #edb/ref 1067 "The Definition of the Scalar Triple Product Via the Determinant" #edb/ref 17592186045585] [17592186107082 #edb/ref 1064 "The scalar triple product has two important properties.\n\nFirst, scalars can be factored out of the product. For example,\n\n$$\n({\\color{red}2}\\mathbf{a}) \\cdot (\\mathbf{b} \\times \\mathbf{c}) = \\mathbf{a} \\cdot ({\\color{red}2}\\mathbf{b} \\times \\mathbf{c}) = \\mathbf{a} \\cdot (\\mathbf{b} \\times {\\color{red}2}\\mathbf{c}) = {\\color{red}2}\\left[ \\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})\\right].\n$$\n\nSecond, if we swap exactly two vectors in the scalar triple product, the result changes sign. For example, swapping $\\mathbf{a}$ and $\\mathbf{b},$ we have\n\n$$\n{\\color{red}\\mathbf{a}} \\cdot ( {\\color{blue}\\mathbf{b}} \\times \\mathbf{c}) = - {\\color{blue}\\mathbf{b}} \\cdot ( {\\color{red}\\mathbf{a}} \\times \\mathbf{c}).\n$$\n\nNote that if we swap twice, then the result remains the same, because the negatives cancel out. For example, swapping $\\color{red}\\mathbf{a}$ and $\\color{blue}\\mathbf{b}$ and then swapping $\\color{red}\\mathbf{a}$ and $\\mathbf{c},$ we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =-b\\cdot (a\\times c) \\\\  & =-(-b\\cdot (c\\times a)) \\\\  & =b\\cdot (c\\times a).\\end{aligned}\n$$\n\nThese properties arise naturally from the fact that the scalar triple product can be computed as a determinant.\n\n- If we multiply a row of the matrix by a number, then the determinant is multiplied by that number:\n\n$$\n|\\begin{aligned}2{a}_{1} & 2{a}_{2} & 2{a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{aligned}|\n$$\n\n- If we swap two rows, then the determinant changes sign:\n\n$$\n|\\begin{aligned}{a}_{1} & {a}_{2} & {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{aligned}|\n$$" #edb/ref 17592186045585] [17592186107082 #edb/ref 1065 2954 #edb/ref 17592186045585] [17592186107082 #edb/ref 1066 #uuid "41cd1550-dd91-5029-a397-fa1417d1e160" #edb/ref 17592186045585] [17592186107082 #edb/ref 1067 "Properties of the Scalar Triple Product" #edb/ref 17592186045585] [17592186107083 #edb/ref 1064 "We have been using the fact for three vectors $\\mathbf{a} = \\langle a_1,a_2,a_3 \\rangle,$ $\\mathbf{b} = \\langle b_1,b_2,b_3 \\rangle,$ and $\\mathbf{c} = \\langle c_1,c_2,c_3 \\rangle,$ the scalar triple product can be computed as\n\n$$\n\\begin{aligned}a\\cdot (b\\times c)=|\\begin{aligned}{a}_{1} & {a}_{2} & {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{aligned}|.\\end{aligned}\n$$\n\nBut why is this true? To understand where this result comes from, first notice that in the formula for the triple product, the cross product can be expressed as follows:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{aligned}| \\\\  & =|\\begin{aligned}{b}_{2} & {b}_{3} \\\\ {c}_{2} & {c}_{3}\\end{aligned}|i-|\\begin{aligned}{b}_{1} & {b}_{3} \\\\ {c}_{1} & {c}_{3}\\end{aligned}|j+|\\begin{aligned}{b}_{1} & {b}_{2} \\\\ {c}_{1} & {c}_{2}\\end{aligned}|k\\end{aligned}\n$$\n\nNow, when we take the dot product with $\\mathbf{a},$ we get an expression that is just the cofactor expansion across the first row of the matrix:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =({a}_{1}i+{a}_{2}j+{a}_{3}k)\\cdot (|\\begin{aligned}{b}_{2} & {b}_{3} \\\\ {c}_{2} & {c}_{3}\\end{aligned}|i-|\\begin{aligned}{b}_{1} & {b}_{3} \\\\ {c}_{1} & {c}_{3}\\end{aligned}|j+|\\begin{aligned}{b}_{1} & {b}_{2} \\\\ {c}_{1} & {c}_{2}\\end{aligned}|k) \\\\  & ={a}_{1}|\\begin{aligned}{b}_{2} & {b}_{3} \\\\ {c}_{2} & {c}_{3}\\end{aligned}|-{a}_{2}|\\begin{aligned}{b}_{1} & {b}_{3} \\\\ {c}_{1} & {c}_{3}\\end{aligned}|+{a}_{3}|\\begin{aligned}{b}_{1} & {b}_{2} \\\\ {c}_{1} & {c}_{2}\\end{aligned}| \\\\  & =|\\begin{aligned}{a}_{1} & {a}_{2} & {a}_{3} \\\\ {b}_{1} & {b}_{2} & {b}_{3} \\\\ {c}_{1} & {c}_{2} & {c}_{3}\\end{aligned}|\\end{aligned}\n$$" #edb/ref 17592186045585] [17592186107083 #edb/ref 1065 2955 #edb/ref 17592186045585] [17592186107083 #edb/ref 1066 #uuid "99f752d5-13c8-5b3e-aeee-383770b0db33" #edb/ref 17592186045585] [17592186107083 #edb/ref 1067 "A Proof of the Formula for the Scalar Triple Product" #edb/ref 17592186045585] [17592186115232 #edb/ref 1037 #edb/ref 17592186050413 #edb/ref 17592186045585] [17592186115232 #edb/ref 1037 #edb/ref 17592186051085 #edb/ref 17592186045585] [17592186115232 #edb/ref 1038 #edb/ref 17592186115835 #edb/ref 17592186045585] [17592186115232 #edb/ref 1038 #edb/ref 17592186115842 #edb/ref 17592186045585] [17592186115232 #edb/ref 1038 #edb/ref 17592186235398 #edb/ref 17592186045585] [17592186115232 #edb/ref 1038 #edb/ref 17592186265876 #edb/ref 17592186045585] [17592186115232 #edb/ref 1038 #edb/ref 17592186292864 #edb/ref 17592186045585] [17592186115232 #edb/ref 1038 #edb/ref 17592186292865 #edb/ref 17592186045585] [17592186115232 #edb/ref 1038 #edb/ref 17592186299808 #edb/ref 17592186045585] [17592186115232 #edb/ref 1038 #edb/ref 17592186299809 #edb/ref 17592186045585] [17592186115232 #edb/ref 1038 #edb/ref 17592186299813 #edb/ref 17592186045585] [17592186115232 #edb/ref 1038 #edb/ref 17592186299814 #edb/ref 17592186045585] [17592186115232 #edb/ref 1038 #edb/ref 17592186345117 #edb/ref 17592186045585] [17592186115232 #edb/ref 1038 #edb/ref 17592186388096 #edb/ref 17592186045585] [17592186115232 #edb/ref 1039 "Calculating a Matrix Product Using the Distributive Law" #edb/ref 17592186045585] [175921861152