#{[{:activity/first-step {:db/id #edb/ref 17592186097492} :activity/id #uuid "90bcccea-5782-59d1-a524-d6852abe26cd" :activity/scope {:db/id #edb/ref 17592186048786 :topic/id #uuid "be10c23c-41f3-53b5-9245-d50fb098c325" :topic/math-academy-id 1106} :activity/steps [{:db/id #edb/ref 17592186097492 :step/content {:db/id #edb/ref 17592186097843 :tutorial/content "Given a fixed **origin** in the plane (often denoted ![](images/75/7502527c010624a805906c12d7a6e94363988e41b1c40771a4cc4fc82900e083.svg)), and another point ![](images/42/42193b6382254991fb9c053ead9edd0631767155ea51d8a8551cfc4fc734340e.svg) the vector ![](images/20/20edf7e26e0b35148bf8ff1e9b52c38e5b6672ae0462a8c2e218e1c0456bae07.svg) is called the **position vector** of the point ![](images/ed/ed6dc1fd057e3dd2207c735a562bf4db22b72d1a9380651607439f00c0440725.svg)\n\nSo, the position vector tells us how to move from the origin to the point.\n\nFor example, suppose ![](images/4f/4f9204dcee76e03f03dc64827bf810327c9b2b981a0aee5a10c7f80ca98f4d5d.svg) and ![](images/41/412bd151cdf5602575028591e2f87d9a7e0328aa6b18dccb6459e7041a5d9b9c.svg) How can we find the position vector ![](images/20/20edf7e26e0b35148bf8ff1e9b52c38e5b6672ae0462a8c2e218e1c0456bae07.svg) in terms of ![](images/52/527e0abeb684dd24d8c92e45425542080c4c9493b9460bb89753fef3226c1f92.svg) and ![](images/c5/c5d2e1827ba6a11504655381514c15ce7eba142e62bf8dca3a10d12eef9d7861.svg)\n\n![](images/e6/e61003fb62534b04cfbbac07a64e61f6c16e2d464eb35bc5b98654b0603b24db.png)\n\nFrom the diagram, we can trace a path from ![](images/75/7502527c010624a805906c12d7a6e94363988e41b1c40771a4cc4fc82900e083.svg) to ![](images/46/46833dd7644e5c60bb4525fe4e7649a99752b26096331755a4b44c2abe183f11.svg) by first moving from ![](images/75/7502527c010624a805906c12d7a6e94363988e41b1c40771a4cc4fc82900e083.svg) to ![](images/c2/c2c85081d1f89d74b8ebb2761496d211d7052193809b7864e7983437f5d0b80f.svg) and then from ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) to ![](images/ed/ed6dc1fd057e3dd2207c735a562bf4db22b72d1a9380651607439f00c0440725.svg) Therefore,\n![](images/ac/ac96d55fd0d74cf5fd24f1f1a96beb3865bc70bc45d17be5aad209c5adb1be6d.svg)\n\nSince ![](images/4f/4f9204dcee76e03f03dc64827bf810327c9b2b981a0aee5a10c7f80ca98f4d5d.svg) and ![](images/e2/e283cb6e7ab325c89dd652abd93ff1382b714462887d8839dfed8769693cc7a7.svg) we get\n![](images/e1/e1bde038ef63f77c3ecc5357b49999c96dd6d331aa7455fcdd1935b1f3eb8261.svg)\n\nSo, to find a position vector, we can trace a convenient path from the origin to the point and add the vectors along that path." :tutorial/id #uuid "055562c0-b02b-58fe-93a0-5e216241c04f" :tutorial/math-academy-id 2910 :tutorial/title "Introduction"} :step/id #uuid "e10b4911-140a-5838-a16e-13feb12fba7b" :step/math-academy-id 661397 :step/next {:db/id #edb/ref 17592186362451}} {:db/id #edb/ref 17592186097493 :step/content {:db/id #edb/ref 17592186096658 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096457 :question/id #uuid "dccb5bac-e528-5b42-9949-36b3870fdde1" :question/math-academy-id "e-4287"} :knowledge-point/id #uuid "45b6a076-8795-5510-aabc-62a925826dd0" :knowledge-point/questions [{:db/id #edb/ref 17592186097171} {:db/id #edb/ref 17592186097247} {:db/id #edb/ref 17592186256381} {:db/id #edb/ref 17592186256383} {:db/id #edb/ref 17592186256384} {:db/id #edb/ref 17592186256385} {:db/id #edb/ref 17592186292813} {:db/id #edb/ref 17592186302260} {:db/id #edb/ref 17592186302261} {:db/id #edb/ref 17592186302262} {:db/id #edb/ref 17592186302263} {:db/id #edb/ref 17592186302321} {:db/id #edb/ref 17592186302322} {:db/id #edb/ref 17592186302323} {:db/id #edb/ref 17592186329681} {:db/id #edb/ref 17592186329682} {:db/id #edb/ref 17592186329685} {:db/id #edb/ref 17592186345318} {:db/id #edb/ref 17592186365580} {:db/id #edb/ref 17592186403884}] :knowledge-point/title "Finding Two Scalar Factors in a Linear Combination"} :step/id #uuid "e9410dda-1b4e-5dca-b7ed-64fdcc297e4e" :step/math-academy-id 661408 :step/next {:db/id #edb/ref 17592186097494}} {:db/id #edb/ref 17592186097494 :step/content {:db/id #edb/ref 17592186096659 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096458 :question/id #uuid "09d593cc-526e-5691-9a18-efff515eae59" :question/math-academy-id "e-4288"} :knowledge-point/id #uuid "feae36e7-ae88-5f3a-957f-e65a92e399ad" :knowledge-point/questions [{:db/id #edb/ref 17592186097052} {:db/id #edb/ref 17592186097246} {:db/id #edb/ref 17592186256387} {:db/id #edb/ref 17592186256389} {:db/id #edb/ref 17592186256392} {:db/id #edb/ref 17592186256588} {:db/id #edb/ref 17592186256617} {:db/id #edb/ref 17592186256630} {:db/id #edb/ref 17592186294972} {:db/id #edb/ref 17592186294980} {:db/id #edb/ref 17592186302117} {:db/id #edb/ref 17592186302118} {:db/id #edb/ref 17592186302119} {:db/id #edb/ref 17592186302120} {:db/id #edb/ref 17592186302121} {:db/id #edb/ref 17592186302122} {:db/id #edb/ref 17592186302123} {:db/id #edb/ref 17592186302124} {:db/id #edb/ref 17592186302125} {:db/id #edb/ref 17592186329684} {:db/id #edb/ref 17592186387007} {:db/id #edb/ref 17592186390564}] :knowledge-point/title "Expressing a Vector That Satisfies a Ratio in Terms of Known Vectors"} :step/id #uuid "eb2bab86-218f-5b3a-9a4e-b0b3872ba6db" :step/math-academy-id 661411} {:db/id #edb/ref 17592186097570 :step/content {:db/id #edb/ref 17592186096707 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096501 :question/id #uuid "839ed5f5-165f-5de5-aba1-551ac605475f" :question/math-academy-id "e-5212"} :knowledge-point/id #uuid "2fbb8f19-f35a-59c4-9b77-8f6c3542ef28" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050473} {:db/id #edb/ref 17592186051020}] :knowledge-point/questions [{:db/id #edb/ref 17592186097170} {:db/id #edb/ref 17592186097187} {:db/id #edb/ref 17592186256376} {:db/id #edb/ref 17592186256377} {:db/id #edb/ref 17592186292812} {:db/id #edb/ref 17592186302047} {:db/id #edb/ref 17592186302317} {:db/id #edb/ref 17592186302318} {:db/id #edb/ref 17592186338759} {:db/id #edb/ref 17592186338760} {:db/id #edb/ref 17592186338762} {:db/id #edb/ref 17592186338763} {:db/id #edb/ref 17592186364886}] :knowledge-point/title "Finding a Scalar Factor in a Linear Combination"} :step/id #uuid "74a3f281-5081-51cb-a589-0b5531ea612f" :step/math-academy-id 661399 :step/next {:db/id #edb/ref 17592186362458}} {:db/id #edb/ref 17592186362451 :step/content {:db/id #edb/ref 17592186362410 :tutorial/content "Now let's look at a slightly more complicated diagram.\n\nSuppose we have two vectors ![](images/4f/4f9204dcee76e03f03dc64827bf810327c9b2b981a0aee5a10c7f80ca98f4d5d.svg) and ![](images/92/92e98c3630891023a50149ee1f15d2bd5d2730e93f166931e86a9e4640ebd1c1.svg) and a parallelogram ![](images/14/14fa5b1a9ad8e22445d2e6ab97a047b0b6dc51912ed129823847560bad78554f.svg) where ![](images/37/37252d39c3cb979bda5aa0e19184009625e32ad6b4d496ec843edcd9ebd11444.svg) How can we find the position vector ![](images/1e/1ea9147123ec18b9ae6f584584c919a462f7efdee6b5b72b61a1cf3c4b13b88a.svg) in terms of ![](images/52/527e0abeb684dd24d8c92e45425542080c4c9493b9460bb89753fef3226c1f92.svg) and ![](images/c5/c5d2e1827ba6a11504655381514c15ce7eba142e62bf8dca3a10d12eef9d7861.svg)\n\n![](images/c7/c78c8895790b28c7dbe60d0dd31a5375fef19ba2d6fa668144859e6fafaf33bb.png)\n\nAs before, we trace a path from the origin to the point ![](images/ed/ed6dc1fd057e3dd2207c735a562bf4db22b72d1a9380651607439f00c0440725.svg) From the diagram, we can write\n![](images/8c/8c0197f45331c0bfd19524c6044f35ddd1d725512112d9700750d10c8709f89f.svg)\n\nWe know that\n![](images/14/146676b86f179710731d5e1ec1b4e5e5e3cf4cdf1af0d4cd4db3d709a36ea0c6.svg)\n\nAlso, since ![](images/c6/c6dbfaa7b99647ca21ec1ad2c57f563756ed17cec04b559d89a086571f1419a1.svg) is a parallelogram, opposite sides are equal and parallel. So,\n![](images/94/940eac51696aa93c499bd105cf5726bbed6eaac94eda297d0743af6cd00a67d3.svg)\n\nSubstituting these into the expression for ![](images/a6/a69eca8aae37a4ecd6d3653c994b2bea69e37a8be6dcb00c4a5eeafbc58f1382.svg) we get\n![](images/f5/f56355c56683deba996e3f8cbdd8a9862cd7a9f6f570be9ab12cd4520748e7ec.svg)\n\nSo, even when the path uses translated copies of known vectors, we can still find the position vector by expressing each part of the path in terms of the known vectors and then adding.\n\nNow we will use the same path-tracing idea in a slightly different way. Instead of only writing a position vector, we will also use vector paths to identify unknown coefficients in linear combinations of known vectors." :tutorial/id #uuid "bd7a9db3-e422-5170-83a1-857ca34b9bc8" :tutorial/math-academy-id 15988 :tutorial/title "Writing a Position Vector Using Known Vectors"} :step/id #uuid "57d87818-8242-532e-8177-977c7fa7906e" :step/math-academy-id 661398 :step/next {:db/id #edb/ref 17592186097570}} {:db/id #edb/ref 17592186362458 :step/content {:db/id #edb/ref 17592186362409 :tutorial/content "We can still find a position vector by tracing a path from the origin to the point and adding the vectors along that path.\n\nHowever, if one part of the path points in the opposite direction to a known vector, then we write it as a **negative** multiple of that vector.\n\nFor example, consider the picture below. \n\n![](images/d5/d5366a68ed98e7f614ff998f69098613ea8e12d05bc27274ea66e8ce5a908cb7.png)\n\nWe are given that ![](images/80/80eb0b356da6e6a2315ea1466d34b914c6cad5e59ff07c4d061ea82b69ed9838.svg) and we are asked to find ![](images/44/44db815dcaf0a9d405026460a655495e055df7e55a785f542f8920ca90af5418.svg)\n\nTo find ![](images/4a/4a2f3891f0b4c8b852767d556e1607028035219b70ab83b4910e95159a930b9c.svg) we want to match the expression\n![](images/52/52599a11cea864ea801b87d8ec0ea288252afa4265395d9fbb4a4dc2815e9e7e.svg)\n\nLet ![](images/75/7502527c010624a805906c12d7a6e94363988e41b1c40771a4cc4fc82900e083.svg) be the origin, and let ![](images/52/527e0abeb684dd24d8c92e45425542080c4c9493b9460bb89753fef3226c1f92.svg) and ![](images/a1/a14e933631f2b075c5a0bb4ab14fad2ca2790c3be2122b1fe8f4b7193fb505b2.svg) end at points ![](images/32/3207697e43e4f88223ad85c16964c3103a50c0c999a4ca14417695158d45526b.svg) and ![](images/21/2109f0ae1a3679002930f1bf8bfa3490cf23c540ae6bbd50c093e5064327ab15.svg) as shown in the diagram below.\n\nSince one term in the vector sum is ![](images/bd/bdd7762354dbbdecb02ccf8284e0830f5421588bbb7fbf1bd9c3a9268a750649.svg) we first draw the vector ![](images/cb/cbbad9d9d0e183ac112cfdf946b99fd00718e0c6856d1a75564925b0e2760e85.svg) from the origin. Then we complete the path to the point ![](images/27/278f99df1e14fe0ebfb61bdb72262a62670dcaa60d322148bc3ee591b278ec2d.svg)\n\n![](images/bc/bc976b12b4610c69953545d95662bf5535ef2a92eb9d9cbd63e087c85f3b98e7.png)\n\nLet ![](images/1a/1aaddf0d4be4d873ff6c0600b0b239e0565a05ca8daaff7ca92bd5c70bebcf03.svg) be the endpoint of the vector ![](images/a2/a2b2f82b89941e4065ecf4c3bf612ab3d7e66fdb16c848dd2ce169480714e7ae.svg) Then\n\n![](images/3a/3a9a2959c3a256cb2651e0f00b0d7fe774f95aeee92289284bffb4c3b11b843a.svg)\n\nFrom the construction, we have\n\n![](images/f1/f1e5980924989b13362a77d776ecbd4b7567f99e30fe26eb57ee99d18fa1d464.svg)\n\nAlso, the vector ![](images/5f/5f1f2cecb3a462fc45e60ec717c2fde5b1aaba79448a58aae1a9d3023b21b7bb.svg) has length ![](images/f5/f551620762fb84e33026129595b42ef514082cc2e137b6762d75fd574d56383c.svg) but points in the opposite direction to ![](images/85/853e57b0bf9a8f7c16e59d37575ae23ac4028ed66b30720af9d7d49ab595c91b.svg) Therefore,\n\n![](images/4f/4fdd6b0f88ff6e5ea11ace72a5b61c24fe8cf6b1d85b4bceee599dde18471b5d.svg)\n\nSubstituting these into the expression for ![](images/3c/3cce8321317b15087f61b778b47963fdff160e7df1e3ade0d33b040e10125994.svg) we get\n\n![](images/71/71d018c5f48d3afb47781ddff61419623e8c6d15856151398905494498254880.svg)\n\nConsequently,\n![](images/57/57897701facaf26cf0826a2b6a12f408ae1acd8a5f4e78575a4457f66a156d9b.svg)\n\nSince ![](images/e6/e6090f180976846ce7a2e6e8d696a0fa078a471c950de6188908528c881839fb.svg) the linear combination can only be written in one way. Equating the coefficients of ![](images/79/792ff38b4658d1d4bbfbc57cbe93be95dd8d90b24559f601250eaa81becf8d24.svg) we get\n\n![](images/99/99914dd947bc5c5acbb4d9aa989efb9fef4dc78b0242629ea0508a81e7058f61.svg)" :tutorial/id #uuid "b5155eff-3506-551b-8dc0-597bff07650f" :tutorial/math-academy-id 15990 :tutorial/title "Vectors in Opposite Directions"} :step/id #uuid "d0bece94-821b-52ea-b6b1-d2373c5447e0" :step/math-academy-id 661404 :step/next {:db/id #edb/ref 17592186362459}} {:db/id #edb/ref 17592186362459 :step/content {:db/id #edb/ref 17592186235291 :knowledge-point/canonical-example {:db/id #edb/ref 17592186234982 :question/id #uuid "aeaa36a2-41b5-5b7b-9797-f39df1e34050" :question/math-academy-id "e-26144"} :knowledge-point/id #uuid "58a49d00-cc58-5228-af38-9369cf31d8c8" :knowledge-point/questions [{:db/id #edb/ref 17592186235349} {:db/id #edb/ref 17592186235350} {:db/id #edb/ref 17592186235351} {:db/id #edb/ref 17592186235571} {:db/id #edb/ref 17592186235572} {:db/id #edb/ref 17592186235573} {:db/id #edb/ref 17592186235574} {:db/id #edb/ref 17592186235575} {:db/id #edb/ref 17592186235576} {:db/id #edb/ref 17592186235577} {:db/id #edb/ref 17592186235578} {:db/id #edb/ref 17592186235579} {:db/id #edb/ref 17592186235587} {:db/id #edb/ref 17592186235588}] :knowledge-point/title "Finding a Scalar Factor When Direction Reverses"} :step/id #uuid "d4d86c29-1b09-51e8-ae95-b9a5b6ceb242" :step/math-academy-id 661405 :step/next {:db/id #edb/ref 17592186097493}}] :activity/title "Describing the Position Vector of a Point Using Known Vectors" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096892}]}
