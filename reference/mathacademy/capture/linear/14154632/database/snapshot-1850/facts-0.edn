b/ref 17592186045417] [17592186476820 #edb/ref 1078 #edb/ref 17592186476671 #edb/ref 17592186045417] [17592186476820 #edb/ref 1079 #uuid "98d73616-be34-5da4-9690-1b1b03cd1846" #edb/ref 17592186045417] [17592186476840 #edb/ref 1075 #edb/ref 17592186476295 #edb/ref 17592186045417] [17592186476840 #edb/ref 1075 #edb/ref 17592186476315 #edb/ref 17592186045417] [17592186476840 #edb/ref 1075 #edb/ref 17592186476427 #edb/ref 17592186045417] [17592186476840 #edb/ref 1075 #edb/ref 17592186476505 #edb/ref 17592186045417] [17592186476840 #edb/ref 1075 #edb/ref 17592186476622 #edb/ref 17592186045417] [17592186476840 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186476840 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186476840 #edb/ref 1078 #edb/ref 17592186476295 #edb/ref 17592186045417] [17592186476840 #edb/ref 1079 #uuid "becea34b-bc1c-530f-ba36-e7d6968724eb" #edb/ref 17592186045417] [17592186476843 #edb/ref 1075 #edb/ref 17592186476503 #edb/ref 17592186045417] [17592186476843 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186476843 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186476843 #edb/ref 1078 #edb/ref 17592186476503 #edb/ref 17592186045417] [17592186476843 #edb/ref 1079 #uuid "c1b8a8d2-8645-5d76-a3b1-15987289e454" #edb/ref 17592186045417] [17592186476872 #edb/ref 1068 #edb/ref 17592186476760 #edb/ref 17592186045417] [17592186476872 #edb/ref 1069 "q-44706" #edb/ref 17592186045417] [17592186476872 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186476872 #edb/ref 1071 "$-6{w}^{9}+9{w}^{4}-3{w}^{4}=$" #edb/ref 17592186045417] [17592186476872 #edb/ref 1072 #uuid "034e440a-6b0a-5b2a-b439-84edad47d0e5" #edb/ref 17592186045417] [17592186476872 #edb/ref 1074 "Here, $9{w}^{4}$ and $-3{w}^{4}$ are like terms, so we group them, and then we add or subtract the coefficients.\n\n$$\n\\begin{aligned}-6{w}^{9}+9{w}^{4}-3{w}^{4} & = \\\\ -6{w}^{9}+(9{w}^{4}-3{w}^{4}) & = \\\\ -6{w}^{9}+(9-3){w}^{4} & = \\\\ -6{w}^{9}+6{w}^{4}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186476922 #edb/ref 1068 #edb/ref 17592186476806 #edb/ref 17592186045417] [17592186476922 #edb/ref 1069 "q-44709" #edb/ref 17592186045417] [17592186476922 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186476922 #edb/ref 1071 "Which of the following polynomials **IS NOT** written in standard form?" #edb/ref 17592186045417] [17592186476922 #edb/ref 1072 #uuid "8f6306e3-cdd2-5e25-bcc0-631107f095ff" #edb/ref 17592186045417] [17592186476922 #edb/ref 1074 "A polynomial is written in standard form when the terms are arranged in descending order of the variable's exponent. The first term should have the largest exponent, and the last term should have the smallest exponent.\n\nThe polynomial \n\n$$\n1-x-5{x}^{2}\n$$\n\nis *not* in standard form. The highest exponent term is $-5{x}^{2},$ followed by $-x,$ and finally $1.$ So, the standard form is \n\n$$\n-5{x}^{2}-x+1\n$$\n\nwhich is different from the given arrangement." #edb/ref 17592186045417] [17592186476933 #edb/ref 1068 #edb/ref 17592186476840 #edb/ref 17592186045417] [17592186476933 #edb/ref 1069 "q-31028" #edb/ref 17592186045417] [17592186476933 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186476933 #edb/ref 1071 "Simplify the polynomial $-\\frac{5x}{3}+4{x}^{2}-\\frac{5{x}^{2}}{2}+3x.$" #edb/ref 17592186045417] [17592186476933 #edb/ref 1072 #uuid "a820117b-ea24-5225-acf7-be7cc5fe0269" #edb/ref 17592186045417] [17592186476933 #edb/ref 1074 "Here,   $4{x}^{2}$ and $-\\frac{5{x}^{2}}{2}$ are like terms, and the $-\\frac{5x}{3}$ and $3x$ are also like terms. So, we group and add each pair of  like terms separately:\n\n$$\n\\begin{aligned}-\\frac{5x}{3}+4{x}^{2}-\\frac{5{x}^{2}}{2}+3x & = \\\\ (4{x}^{2}-\\frac{5{x}^{2}}{2})+(3x-\\frac{5x}{3}) & = \\\\ (4-\\frac{5}{2}){x}^{2}+(3-\\frac{5}{3})x & = \\\\ \\frac{3}{2}{x}^{2}+\\frac{4}{3}x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186476964 #edb/ref 1068 #edb/ref 17592186476843 #edb/ref 17592186045417] [17592186476964 #edb/ref 1069 "q-217281" #edb/ref 17592186045417] [17592186476964 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186476964 #edb/ref 1071 "Express the polynomial $1-2{b}^{4}+{b}^{3}+5{b}^{2}$ in standard form.\n\n$1-2{b}^{4}+{b}^{3}+5{b}^{2}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186476964 #edb/ref 1072 #uuid "d5263083-aa8d-5aef-bf34-79081aa08d71" #edb/ref 17592186045417] [17592186476964 #edb/ref 1074 "To write a polynomial in **standard form**, we must arrange the terms in descending order of the variable's exponent. The first term should have the largest exponent, and the last term should have the smallest exponent.\n\nThe highest exponent term is $-2{b}^{4},$ followed by ${b}^{3},$ and then $5{b}^{2},$ and finally $1.$\n\nSo, the standard form of the polynomial is\n\n$$\n-2{b}^{4}+{b}^{3}+5{b}^{2}+1.\n$$" #edb/ref 17592186045417] [17592186476970 #edb/ref 1068 #edb/ref 17592186476774 #edb/ref 17592186045417] [17592186476970 #edb/ref 1069 "q-110820" #edb/ref 17592186045417] [17592186476970 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186476970 #edb/ref 1071 "The standard form of the polynomial $3{c}^{2}-5{c}^{2}-6{c}^{4}+7$ is" #edb/ref 17592186045417] [17592186476970 #edb/ref 1072 #uuid "e4e12c2d-18b6-5dcb-8703-4bb161f999a5" #edb/ref 17592186045417] [17592186476970 #edb/ref 1074 "First, we collect like terms:\n\n$$\n\\begin{aligned}3{c}^{2}-5{c}^{2}-6{c}^{4}+7 & = \\\\ (3{c}^{2}-5{c}^{2})-6{c}^{4}+7 & = \\\\ (3-5){c}^{2}-6{c}^{4}+7 & = \\\\ -2{c}^{2}-6{c}^{4}+7\\end{aligned}\n$$\n\nNow, we need to express our polynomial in standard form.\n\nThe highest exponent term is $-6{c}^{4},$ followed by $-2{c}^{2},$ and finally $7.$\n\nSo, the standard form of the polynomial is:\n\n$$\n-6{c}^{4}-2{c}^{2}+7\n$$" #edb/ref 17592186045417] [17592186476972 #edb/ref 1068 #edb/ref 17592186476820 #edb/ref 17592186045417] [17592186476972 #edb/ref 1069 "q-33224" #edb/ref 17592186045417] [17592186476972 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186476972 #edb/ref 1071 "Which of the following polynomials are given in standard form?\n\nI. ${x}^{7}+5{x}^{2}-7{x}^{5}$\n\nII. ${x}^{8}+9{x}^{4}+3{x}^{6}$\n\nIII. ${x}^{7}+5{x}^{2}-7$" #edb/ref 17592186045417] [17592186476972 #edb/ref 1072 #uuid "eb22febe-8e72-5f03-9eea-2a883449fa35" #edb/ref 17592186045417] [17592186476972 #edb/ref 1074 "A polynomial is written in standard form when the terms are arranged in descending order of the variable's exponent. The first term should have the largest exponent, and the last term should have the smallest exponent.\n\nLet's analyze each polynomial.\n\n- Polynomial I is *not* in standard form. The highest exponent term is ${x}^{7},$ followed by $-7{x}^{5},$ and finally $5{x}^{2}.$ So, the standard form is ${x}^{7}-7{x}^{5}+5{x}^{2},$ which is different from the given arrangement.\n\n- Polynomial II is *not* in standard form. The highest exponent term is ${x}^{8},$ followed by $3{x}^{6},$ and finally $9{x}^{4}.$ So, the standard form is ${x}^{8}+3{x}^{6}+9{x}^{4},$ which is different from the given arrangement.\n\n- Polynomial III is in standard form. The highest exponent term is ${x}^{7}$ followed by $5{x}^{2},$ and finally $-7.$ So, the standard form is indeed ${x}^{7}+5{x}^{2}-7.$\n\nIn conclusion, only polynomial III is given in standard form." #edb/ref 17592186045417]}
