#{[{:db/id #edb/ref 17592186119529 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119768 :knowledge-point/id #uuid "6b66305f-f020-5236-a344-502bc54f8cc0" :knowledge-point/title "Simplifying a Polynomial"}] :question/id #uuid "473d3810-3c45-5e76-87a2-9cc4d194a2b0" :question/math-academy-id "e-14292" :question/problem "Simplify the polynomial $x^3+x-2x^2-3x$." :question/worked-solution "Here, $x$ and $-3x$ are like terms, so we group them, and then we add or subtract the coefficients.\n\n$$\n\\begin{aligned}\nx^{3} + x - 2x^{2} - 3x &=  \\\\\nx^{3} + x - 3x - 2x^{2} &=  \\\\\nx^{3} + (x - 3x) - 2x^{2} &=  \\\\\nx^{3} + (1 - 3)x - 2x^{2} &=  \\\\\n&= x^{3} - 2x - 2x^{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186119530 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119769 :knowledge-point/id #uuid "af3f4c35-be23-5a1a-97fb-18e89ab51591" :knowledge-point/title "Writing Polynomials in Standard Form"}] :question/id #uuid "f65e4129-1564-52d2-80b0-5c2e970722e8" :question/math-academy-id "e-14297" :question/problem "Rewrite the polynomial below in standard form.\n\n$8x-9-3x^4 - 6x^3$" :question/worked-solution "To write a polynomial in **standard form**, we must arrange the terms in descending order of the variable's exponent. The first term should have the largest exponent, and the last term should have the smallest exponent.\n\nThe highest exponent term is $3x^4$, followed by $-6x^3$, and then $8x$, and finally $-9$.\n\nSo, the standard form of the polynomial is\n$-3x^4 - 6x^3 + 8x-9$."}] [{:db/id #edb/ref 17592186119531 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119770 :knowledge-point/id #uuid "6f00d5b6-5c41-5499-a897-b3ea7cbb3432" :knowledge-point/title "Simplifying and Writing Polynomials in Standard Form"}] :question/id #uuid "409cbc8a-e56e-587b-a639-ecb2c2c0cc97" :question/math-academy-id "e-14302" :question/problem "Simplify the polynomial $3x^2-2-4x - 6x^2+18$, giving your final answer in standard form." :question/worked-solution "First, we collect like terms:\n\n$$\n\\begin{aligned}\n3x^{2} - 2 - 4x - 6x^{2} + 18 &=  \\\\\n3x^{2} - 6x^{2} - 2 + 18 - 4x &=  \\\\\n(3x^{2} - 6x^{2}) + (-2 + 18) - 4x &=  \\\\\n(3 - 6)x^{2} + (-2 + 18) - 4x &=  \\\\\n&= - 3x^{2} + 16 - 4x\n\\end{aligned}\n$$\n\nNow, we need to express our polynomial in standard form.\n\nThe highest exponent term is $-3x^2$, followed by $-4x$, and finally $16$.\n\nSo, the standard form of the polynomial is\n\n$$\n-3x^2-4x+16\n$$"}] [{:db/id #edb/ref 17592186120488 :knowledge-point/_questions [{:db/id #edb/ref 17592186119770 :knowledge-point/id #uuid "6f00d5b6-5c41-5499-a897-b3ea7cbb3432" :knowledge-point/title "Simplifying and Writing Polynomials in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afdfa325-0ac2-5f43-ac7a-3ffd0741f975" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 + 3x^{2} + 4x^{3}" :db/id #edb/ref 17592186119043} {:answer/id #uuid "e352366d-16d7-5fef-93df-fbcc25ce2e07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x^{3} + 3x^{2} + 2" :db/id #edb/ref 17592186119044} {:answer/id #uuid "edec14da-bd66-55d4-92ec-e6c03cdae122" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x^{3} + 2x^{2} + 2" :db/id #edb/ref 17592186119045} {:answer/id #uuid "fe3c9fcf-b6a0-5cb7-8e8a-2b8f310e8e84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 + 2x^{2} + 3x^{3}" :db/id #edb/ref 17592186119046} {:answer/id #uuid "16a718ac-7fdf-583e-8ec9-94b39ccd19b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x^{2} + 3x^{3}" :db/id #edb/ref 17592186119047}] :answer-field/id #uuid "1ba7977f-c9de-5cb6-8c79-d9ded44d72b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186119042}] :question/id #uuid "07524f9b-4a87-5a60-baad-877be227b03b" :question/math-academy-id "q-61898" :question/problem "The standard form of the polynomial $2 + 3x^{2} + 4x^{3} - x^{2} - x^{3}$ is"}]}
