#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186120613} :activity/id #uuid "af23758d-7476-5d58-8b4e-e0d2c3022048" :activity/scope {:db/id #edb/ref 17592186049538 :topic/id #uuid "fcf84897-2da1-577a-877e-c8fd8d1350aa" :topic/math-academy-id 1783} :activity/steps [{:db/id #edb/ref 17592186120613 :step/content {:db/id #edb/ref 17592186121146 :tutorial/content "We can simplify the polynomial below because it contains a pair of like terms:\n\n$$\n{\\color{blue}{3x^2}} +4x \\,{\\color{blue}{-}}\\,{\\color{blue}{2x^2}} +5\n$$\n\nTo simplify, we combine the like terms ($3x^2$ and $-2x^2$) by adding or subtracting their coefficients:\n\n$$\n\\begin{aligned}3{x}^{2}+4x-2{x}^{2}+5 & = \\\\ 3{x}^{2}-2{x}^{2}+4x+5 & = \\\\ (3{x}^{2}-2{x}^{2})+4x+5 & = \\\\ (3-2){x}^{2}+4x+5 & = \\\\ {x}^{2}+4x+5 & \\end{aligned}\n$$" :tutorial/id #uuid "dcac1959-d802-5641-8736-12d53db273a9" :tutorial/math-academy-id 8864 :tutorial/title "Introduction"} :step/id #uuid "8789d5b3-8f11-513e-a769-fad4e067d79a" :step/math-academy-id 150900 :step/next {:db/id #edb/ref 17592186120614}} {:db/id #edb/ref 17592186120614 :step/content {:db/id #edb/ref 17592186119768 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119529 :question/id #uuid "473d3810-3c45-5e76-87a2-9cc4d194a2b0" :question/math-academy-id "e-14292"} :knowledge-point/id #uuid "6b66305f-f020-5236-a344-502bc54f8cc0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186120241} {:db/id #edb/ref 17592186120468} {:db/id #edb/ref 17592186476872} {:db/id #edb/ref 17592186476933}] :knowledge-point/title "Simplifying a Polynomial"} :step/id #uuid "2339f28a-1bfe-5d7f-a1d4-4457e0b9dd39" :step/math-academy-id 150901 :step/next {:db/id #edb/ref 17592186120615}} {:db/id #edb/ref 17592186120615 :step/content {:db/id #edb/ref 17592186121147 :tutorial/content "To write a polynomial in **standard form**, we must arrange the terms of the variable's exponent in descending order. The first term should have the largest exponent, and the last term should have the smallest exponent.\n\nFor example, consider the following polynomial:\n\n$$\n6x-2x^2-2+x^3\n$$\n\nTo write this polynomial in standard form, we follow the steps below:\n\n1\\. Identify the term with the highest exponent ($x^3$) and write it first.\n\n2\\. Identify the term with the next highest exponent ($-2x^2$) and write it second.\n\n3\\. Continue identifying the term with the next highest exponent and writing it next until all of the polynomial terms have been written.\n\nTherefore, the standard form of our polynomial is\n\n$$\nx^3 -2x^2 + 6x -2.\n$$\n\nNote the following:\n\n- The leading term always appears first when a polynomial is written in standard form. This is where the leading term gets its name!\n\n- When a polynomial is written in standard form, we also say that the terms are written in **decreasing powers of $\\boldsymbol x$** or **descending powers of $\\boldsymbol x$** because the powers are decreasing/descending.\n\n- If we were to write the terms of our polynomial in *increasing* (or *ascending*) powers of $x,$ it would look as follows:\n\n$$\n-2 + 6x -2x^2 + x^3\n$$\n\nIn this case, the powers of $x$ *increase* as we read from left to right." :tutorial/id #uuid "40e8c8a9-715e-5a33-92e4-34369c27b505" :tutorial/math-academy-id 8868 :tutorial/title "Standard Form"} :step/id #uuid "ab63d222-6bc9-5825-a10a-531c4978485f" :step/math-academy-id 150904 :step/next {:db/id #edb/ref 17592186120616}} {:db/id #edb/ref 17592186120616 :step/content {:db/id #edb/ref 17592186119769 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119530 :question/id #uuid "f65e4129-1564-52d2-80b0-5c2e970722e8" :question/math-academy-id "e-14297"} :knowledge-point/id #uuid "af3f4c35-be23-5a1a-97fb-18e89ab51591" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048406}] :knowledge-point/questions [{:db/id #edb/ref 17592186120173} {:db/id #edb/ref 17592186120240} {:db/id #edb/ref 17592186476922} {:db/id #edb/ref 17592186476964} {:db/id #edb/ref 17592186476972}] :knowledge-point/title "Writing Polynomials in Standard Form"} :step/id #uuid "357f8d99-13be-51ca-a9b3-f2b34dc03d58" :step/math-academy-id 150905 :step/next {:db/id #edb/ref 17592186120617}} {:db/id #edb/ref 17592186120617 :step/content {:db/id #edb/ref 17592186119770 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119531 :question/id #uuid "409cbc8a-e56e-587b-a639-ecb2c2c0cc97" :question/math-academy-id "e-14302"} :knowledge-point/id #uuid "6f00d5b6-5c41-5499-a897-b3ea7cbb3432" :knowledge-point/questions [{:db/id #edb/ref 17592186120161} {:db/id #edb/ref 17592186120162} {:db/id #edb/ref 17592186120488} {:db/id #edb/ref 17592186476970}] :knowledge-point/title "Simplifying and Writing Polynomials in Standard Form"} :step/id #uuid "8288291c-78f5-5a1b-99f9-23e99b20eada" :step/math-academy-id 150908}] :activity/title "Simplifying Polynomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120005}]}
