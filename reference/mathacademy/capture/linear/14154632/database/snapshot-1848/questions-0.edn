#{[{:db/id #edb/ref 17592186119529 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119768 :knowledge-point/id #uuid "6b66305f-f020-5236-a344-502bc54f8cc0" :knowledge-point/title "Simplifying a Polynomial"}] :question/id #uuid "473d3810-3c45-5e76-87a2-9cc4d194a2b0" :question/math-academy-id "e-14292" :question/problem "Simplify the polynomial $x^3+x-2x^2-3x.$" :question/worked-solution "Here, $x$ and $-3x$ are like terms, so we group them, and then we add or subtract the coefficients.\n\n$$\n\\begin{aligned}{x}^{3}+x-2{x}^{2}-3x & = \\\\ {x}^{3}+x-3x-2{x}^{2} & = \\\\ {x}^{3}+(x-3x)-2{x}^{2} & = \\\\ {x}^{3}+(1-3)x-2{x}^{2} & = \\\\ {x}^{3}-2x-2{x}^{2} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186119530 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119769 :knowledge-point/id #uuid "af3f4c35-be23-5a1a-97fb-18e89ab51591" :knowledge-point/title "Writing Polynomials in Standard Form"}] :question/id #uuid "f65e4129-1564-52d2-80b0-5c2e970722e8" :question/math-academy-id "e-14297" :question/problem "Rewrite the polynomial below in standard form. \n\n$$\n8x-9-3x^4 - 6x^3\n$$" :question/worked-solution "To write a polynomial in **standard form**, we must arrange the terms in descending order of the variable's exponent. The first term should have the largest exponent, and the last term should have the smallest exponent.\n\nThe highest exponent term is $3x^4,$ followed by $-6x^3,$ and then $8x,$ and finally $-9.$\n\nSo, the standard form of the polynomial is\n\n$$\n-3x^4 - 6x^3 + 8x-9.\n$$"}] [{:db/id #edb/ref 17592186119531 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186119770 :knowledge-point/id #uuid "6f00d5b6-5c41-5499-a897-b3ea7cbb3432" :knowledge-point/title "Simplifying and Writing Polynomials in Standard Form"}] :question/id #uuid "409cbc8a-e56e-587b-a639-ecb2c2c0cc97" :question/math-academy-id "e-14302" :question/problem "Simplify the polynomial $3x^2-2-4x - 6x^2+18,$ giving your final answer in standard form." :question/worked-solution "First, we collect like terms:\n\n$$\n\\begin{aligned}3{x}^{2}-2-4x-6{x}^{2}+18 & = \\\\ 3{x}^{2}-6{x}^{2}-2+18-4x & = \\\\ (3{x}^{2}-6{x}^{2})+(-2+18)-4x & = \\\\ (3-6){x}^{2}+(-2+18)-4x & = \\\\ -3{x}^{2}+16-4x & \\end{aligned}\n$$\n\nNow, we need to express our polynomial in standard form. \n\nThe highest exponent term is $-3x^2,$ followed by $-4x,$ and finally $16.$\n\nSo, the standard form of the polynomial is\n\n$$\n-3x^2-4x+16.\n$$"}] [{:db/id #edb/ref 17592186476970 :knowledge-point/_questions [{:db/id #edb/ref 17592186119770 :knowledge-point/id #uuid "6f00d5b6-5c41-5499-a897-b3ea7cbb3432" :knowledge-point/title "Simplifying and Writing Polynomials in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70812f52-10fa-52ae-91c6-d4dd671618ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{c}^{4}-3{c}^{2}+7" :db/id #edb/ref 17592186476456} {:answer/id #uuid "826fb077-82c4-5621-837d-2593cdb45648" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{c}^{4}-4{c}^{2}+7" :db/id #edb/ref 17592186476489} {:answer/id #uuid "b1a6a4d0-b51f-514f-8f75-68f248162e57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{c}^{4}-3{c}^{2}+7" :db/id #edb/ref 17592186476600} {:answer/id #uuid "d02eef8e-525a-5a6e-89f5-c93dfac2e187" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{c}^{4}-2{c}^{2}+7" :db/id #edb/ref 17592186476668} {:answer/id #uuid "fe6312fb-f2a1-5eee-88d0-3c05acdff2da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{c}^{4}-{c}^{2}+7" :db/id #edb/ref 17592186476758}] :answer-field/correct {:answer/id #uuid "d02eef8e-525a-5a6e-89f5-c93dfac2e187" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{c}^{4}-2{c}^{2}+7" :db/id #edb/ref 17592186476668} :answer-field/id #uuid "2d9b3bc2-9c69-5479-8c20-ed590e77d8ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476774}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e4e12c2d-18b6-5dcb-8703-4bb161f999a5" :question/math-academy-id "q-110820" :question/problem "The standard form of the polynomial $3{c}^{2}-5{c}^{2}-6{c}^{4}+7$ is" :question/worked-solution "First, we collect like terms:\n\n$$\n\\begin{aligned}3{c}^{2}-5{c}^{2}-6{c}^{4}+7 & = \\\\ (3{c}^{2}-5{c}^{2})-6{c}^{4}+7 & = \\\\ (3-5){c}^{2}-6{c}^{4}+7 & = \\\\ -2{c}^{2}-6{c}^{4}+7\\end{aligned}\n$$\n\nNow, we need to express our polynomial in standard form.\n\nThe highest exponent term is $-6{c}^{4},$ followed by $-2{c}^{2},$ and finally $7.$\n\nSo, the standard form of the polynomial is:\n\n$$\n-6{c}^{4}-2{c}^{2}+7\n$$"}] [{:db/id #edb/ref 17592186476964 :knowledge-point/_questions [{:db/id #edb/ref 17592186119769 :knowledge-point/id #uuid "af3f4c35-be23-5a1a-97fb-18e89ab51591" :knowledge-point/title "Writing Polynomials in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88187258-7279-53a1-bb2a-e3a6feb03f9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2b^{4}+b^{3}+5b^{2}+1" :db/id #edb/ref 17592186476503}] :answer-field/correct {:answer/id #uuid "88187258-7279-53a1-bb2a-e3a6feb03f9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2b^{4}+b^{3}+5b^{2}+1" :db/id #edb/ref 17592186476503} :answer-field/id #uuid "c1b8a8d2-8645-5d76-a3b1-15987289e454" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186476843}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d5263083-aa8d-5aef-bf34-79081aa08d71" :question/math-academy-id "q-217281" :question/problem "Express the polynomial $1-2{b}^{4}+{b}^{3}+5{b}^{2}$ in standard form.\n\n$1-2{b}^{4}+{b}^{3}+5{b}^{2}=$\n{{field-1}}" :question/worked-solution "To write a polynomial in **standard form**, we must arrange the terms in descending order of the variable's exponent. The first term should have the largest exponent, and the last term should have the smallest exponent.\n\nThe highest exponent term is $-2{b}^{4},$ followed by ${b}^{3},$ and then $5{b}^{2},$ and finally $1.$\n\nSo, the standard form of the polynomial is\n\n$$\n-2{b}^{4}+{b}^{3}+5{b}^{2}+1.\n$$"}] [{:db/id #edb/ref 17592186476933 :knowledge-point/_questions [{:db/id #edb/ref 17592186119768 :knowledge-point/id #uuid "6b66305f-f020-5236-a344-502bc54f8cc0" :knowledge-point/title "Simplifying a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "285a1466-9430-5687-bbcf-29121fab75da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}+\\frac{4}{3}x" :db/id #edb/ref 17592186476295} {:answer/id #uuid "32dae763-b632-5eb9-a345-87aa4c02570b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}+\\frac{15}{3}x" :db/id #edb/ref 17592186476315} {:answer/id #uuid "637465f4-79f7-5282-b818-a1b5a378c60b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{2}{x}^{2}+\\frac{4}{3}x" :db/id #edb/ref 17592186476427} {:answer/id #uuid "8cad9be0-f5bf-5d8e-b89a-2f174676d7aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{13}{2}{x}^{2}+\\frac{15}{3}x" :db/id #edb/ref 17592186476505} {:answer/id #uuid "b90be755-ae0b-5fa0-9b25-e6f73288c4fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}{x}^{2}+\\frac{4}{3}x" :db/id #edb/ref 17592186476622}] :answer-field/correct {:answer/id #uuid "285a1466-9430-5687-bbcf-29121fab75da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}+\\frac{4}{3}x" :db/id #edb/ref 17592186476295} :answer-field/id #uuid "becea34b-bc1c-530f-ba36-e7d6968724eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476840}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a820117b-ea24-5225-acf7-be7cc5fe0269" :question/math-academy-id "q-31028" :question/problem "Simplify the polynomial $-\\frac{5x}{3}+4{x}^{2}-\\frac{5{x}^{2}}{2}+3x.$" :question/worked-solution "Here,   $4{x}^{2}$ and $-\\frac{5{x}^{2}}{2}$ are like terms, and the $-\\frac{5x}{3}$ and $3x$ are also like terms. So, we group and add each pair of  like terms separately:\n\n$$\n\\begin{aligned}-\\frac{5x}{3}+4{x}^{2}-\\frac{5{x}^{2}}{2}+3x & = \\\\ (4{x}^{2}-\\frac{5{x}^{2}}{2})+(3x-\\frac{5x}{3}) & = \\\\ (4-\\frac{5}{2}){x}^{2}+(3-\\frac{5}{3})x & = \\\\ \\frac{3}{2}{x}^{2}+\\frac{4}{3}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186476972 :knowledge-point/_questions [{:db/id #edb/ref 17592186119769 :knowledge-point/id #uuid "af3f4c35-be23-5a1a-97fb-18e89ab51591" :knowledge-point/title "Writing Polynomials in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12cc2bc5-5cd8-581d-a908-ccd46cac065f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186476234} {:answer/id #uuid "47dd3496-c4d6-5410-a64a-a17c3a56e61a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III" :db/id #edb/ref 17592186476355} {:answer/id #uuid "5e2cc8fb-8432-50b8-8d8f-b15de2358c9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III" :db/id #edb/ref 17592186476413} {:answer/id #uuid "b7c76b15-9cb4-55d7-b45f-d54fa206beb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186476619} {:answer/id #uuid "d0510240-070a-5322-b399-d0bef4b4a1b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186476671}] :answer-field/correct {:answer/id #uuid "d0510240-070a-5322-b399-d0bef4b4a1b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186476671} :answer-field/id #uuid "98d73616-be34-5da4-9690-1b1b03cd1846" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476820}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eb22febe-8e72-5f03-9eea-2a883449fa35" :question/math-academy-id "q-33224" :question/problem "Which of the following polynomials are given in standard form?\n\nI. ${x}^{7}+5{x}^{2}-7{x}^{5}$\n\nII. ${x}^{8}+9{x}^{4}+3{x}^{6}$\n\nIII. ${x}^{7}+5{x}^{2}-7$" :question/worked-solution "A polynomial is written in standard form when the terms are arranged in descending order of the variable's exponent. The first term should have the largest exponent, and the last term should have the smallest exponent.\n\nLet's analyze each polynomial.\n\n- Polynomial I is *not* in standard form. The highest exponent term is ${x}^{7},$ followed by $-7{x}^{5},$ and finally $5{x}^{2}.$ So, the standard form is ${x}^{7}-7{x}^{5}+5{x}^{2},$ which is different from the given arrangement.\n\n- Polynomial II is *not* in standard form. The highest exponent term is ${x}^{8},$ followed by $3{x}^{6},$ and finally $9{x}^{4}.$ So, the standard form is ${x}^{8}+3{x}^{6}+9{x}^{4},$ which is different from the given arrangement.\n\n- Polynomial III is in standard form. The highest exponent term is ${x}^{7}$ followed by $5{x}^{2},$ and finally $-7.$ So, the standard form is indeed ${x}^{7}+5{x}^{2}-7.$\n\nIn conclusion, only polynomial III is given in standard form."}] [{:db/id #edb/ref 17592186476872 :knowledge-point/_questions [{:db/id #edb/ref 17592186119768 :knowledge-point/id #uuid "6b66305f-f020-5236-a344-502bc54f8cc0" :knowledge-point/title "Simplifying a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aab9ce2-cbfa-5ebd-884c-a4950519a3af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{w}^{9}+3{w}^{4}" :db/id #edb/ref 17592186476220} {:answer/id #uuid "5955a692-dbb2-5272-9aae-c8989adf2445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{w}^{9}-12{w}^{4}" :db/id #edb/ref 17592186476395} {:answer/id #uuid "7acfb0db-7152-596b-b1f2-b0ecd6821403" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{w}^{9}+9{w}^{4}" :db/id #edb/ref 17592186476476} {:answer/id #uuid "b04507f4-90d0-57e4-b9da-e0e36f66a3bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{w}^{9}-3{w}^{4}" :db/id #edb/ref 17592186476597} {:answer/id #uuid "d6de6484-f44f-5b5a-8c53-cdd81f663e09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{w}^{9}+6{w}^{4}" :db/id #edb/ref 17592186476686}] :answer-field/correct {:answer/id #uuid "d6de6484-f44f-5b5a-8c53-cdd81f663e09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6{w}^{9}+6{w}^{4}" :db/id #edb/ref 17592186476686} :answer-field/id #uuid "003b4804-d14f-578e-8656-2a90c49c95cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476760}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "034e440a-6b0a-5b2a-b439-84edad47d0e5" :question/math-academy-id "q-44706" :question/problem "$-6{w}^{9}+9{w}^{4}-3{w}^{4}=$" :question/worked-solution "Here, $9{w}^{4}$ and $-3{w}^{4}$ are like terms, so we group them, and then we add or subtract the coefficients.\n\n$$\n\\begin{aligned}-6{w}^{9}+9{w}^{4}-3{w}^{4} & = \\\\ -6{w}^{9}+(9{w}^{4}-3{w}^{4}) & = \\\\ -6{w}^{9}+(9-3){w}^{4} & = \\\\ -6{w}^{9}+6{w}^{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186476922 :knowledge-point/_questions [{:db/id #edb/ref 17592186119769 :knowledge-point/id #uuid "af3f4c35-be23-5a1a-97fb-18e89ab51591" :knowledge-point/title "Writing Polynomials in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "455ee15e-6c0f-573a-96f8-ac2eaa0977b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}-5x" :db/id #edb/ref 17592186476352} {:answer/id #uuid "6d8631f4-d5b1-510c-abe6-fbc154ccae42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{4}+2{x}^{2}+1" :db/id #edb/ref 17592186476447} {:answer/id #uuid "7abedaa4-a598-50ba-a9e0-ad1705a60b26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-1" :db/id #edb/ref 17592186476475} {:answer/id #uuid "c30fb40b-692c-5fdf-a9cd-32de15e13bb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186476641} {:answer/id #uuid "d27483fd-f79d-5bfb-893c-84c1d0df9f1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-x-5{x}^{2}" :db/id #edb/ref 17592186476673}] :answer-field/correct {:answer/id #uuid "d27483fd-f79d-5bfb-893c-84c1d0df9f1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-x-5{x}^{2}" :db/id #edb/ref 17592186476673} :answer-field/id #uuid "711f0999-7afe-5b44-8f33-71ef38be9424" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476806}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8f6306e3-cdd2-5e25-bcc0-631107f095ff" :question/math-academy-id "q-44709" :question/problem "Which of the following polynomials **IS NOT** written in standard form?" :question/worked-solution "A polynomial is written in standard form when the terms are arranged in descending order of the variable's exponent. The first term should have the largest exponent, and the last term should have the smallest exponent.\n\nThe polynomial \n\n$$\n1-x-5{x}^{2}\n$$\n\nis *not* in standard form. The highest exponent term is $-5{x}^{2},$ followed by $-x,$ and finally $1.$ So, the standard form is \n\n$$\n-5{x}^{2}-x+1\n$$\n\nwhich is different from the given arrangement."}] [{:db/id #edb/ref 17592186120488 :knowledge-point/_questions [{:db/id #edb/ref 17592186119770 :knowledge-point/id #uuid "6f00d5b6-5c41-5499-a897-b3ea7cbb3432" :knowledge-point/title "Simplifying and Writing Polynomials in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0997ff7b-e53b-5695-bfa9-fe2333cddfff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+3{x}^{3}" :db/id #edb/ref 17592186476219} {:answer/id #uuid "1c4db17c-4d76-5d9f-b238-06a0e9bee011" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+2{x}^{2}+3{x}^{3}" :db/id #edb/ref 17592186476263} {:answer/id #uuid "2044cde2-6967-5e40-8ba2-cedeae8231e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}+3{x}^{2}+2" :db/id #edb/ref 17592186476277} {:answer/id #uuid "59c51559-735d-5f2a-a2b3-1ea4b2e36862" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+2{x}^{2}+2" :db/id #edb/ref 17592186476400} {:answer/id #uuid "9ec31274-efd0-5b92-8596-eb10ad67ee3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+3{x}^{2}+4{x}^{3}" :db/id #edb/ref 17592186476544}] :answer-field/correct {:answer/id #uuid "59c51559-735d-5f2a-a2b3-1ea4b2e36862" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+2{x}^{2}+2" :db/id #edb/ref 17592186476400} :answer-field/id #uuid "1ba7977f-c9de-5cb6-8c79-d9ded44d72b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186119042}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "07524f9b-4a87-5a60-baad-877be227b03b" :question/math-academy-id "q-61898" :question/problem "The standard form of the polynomial $2+3{x}^{2}+4{x}^{3}-{x}^{2}-{x}^{3}$ is" :question/worked-solution "First, we collect like terms:\n\n$$\n\\begin{aligned}2+3{x}^{2}+4{x}^{3}-{x}^{2}-{x}^{3} & = \\\\ 2+(3{x}^{2}-{x}^{2})+(4{x}^{3}-{x}^{3}) & = \\\\ 2+(3-1){x}^{2}+(4-1){x}^{3} & = \\\\ 2+2{x}^{2}+3{x}^{3}\\end{aligned}\n$$\n\nNow, we need to express our polynomial in standard form.\n\nThe highest exponent term is $3{x}^{3},$ followed by $2{x}^{2},$ and finally $2.$\n\nSo, the standard form of the polynomial is:\n\n$$\n3{x}^{3}+2{x}^{2}+2\n$$"}]}
