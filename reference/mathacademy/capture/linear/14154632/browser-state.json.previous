    "q-44706": {
      "dom_id": "step-q44706",
      "name": "Question 2",
      "problem": "$-6{w}^{9}+9{w}^{4}-3{w}^{4}=$",
      "worked_solution": "Here, $9{w}^{4}$ and $-3{w}^{4}$ are like terms, so we group them, and then we add or subtract the coefficients.\n\n$$\n\\begin{aligned}-6{w}^{9}+9{w}^{4}-3{w}^{4} & = \\\\ -6{w}^{9}+(9{w}^{4}-3{w}^{4}) & = \\\\ -6{w}^{9}+(9-3){w}^{4} & = \\\\ -6{w}^{9}+6{w}^{4}\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-44706-a",
