  "live_records": {
    "q-31028": {
      "dom_id": "step-q31028",
      "name": "Question 1",
      "problem": "Simplify the polynomial $-\\frac{5x}{3}+4{x}^{2}-\\frac{5{x}^{2}}{2}+3x.$",
      "worked_solution": "Here,   $4{x}^{2}$ and $-\\frac{5{x}^{2}}{2}$ are like terms, and the $-\\frac{5x}{3}$ and $3x$ are also like terms. So, we group and add each pair of  like terms separately:\n\n$$\n\\begin{aligned}-\\frac{5x}{3}+4{x}^{2}-\\frac{5{x}^{2}}{2}+3x & = \\\\ (4{x}^{2}-\\frac{5{x}^{2}}{2})+(3x-\\frac{5x}{3}) & = \\\\ (4-\\frac{5}{2}){x}^{2}+(3-\\frac{5}{3})x & = \\\\ \\frac{3}{2}{x}^{2}+\\frac{4}{3}x.\\end{aligned}\n$$",
      "calculator_instructions": "",
