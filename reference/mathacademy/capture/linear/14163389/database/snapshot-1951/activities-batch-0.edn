#{[{:activity/first-step {:db/id #edb/ref 17592186065266} :activity/id #uuid "920218c5-b28d-5647-a01d-bb88eb97a449" :activity/scope {:db/id #edb/ref 17592186050622 :topic/id #uuid "59bac138-6475-51d1-971d-3bd216b92f3c" :topic/math-academy-id 356} :activity/steps [{:db/id #edb/ref 17592186065266 :step/content {:db/id #edb/ref 17592186065414 :tutorial/content "Equations can contain more than one variable. For example, the following equation has two variables, $\\color{blue}x$ and ${\\color{red}y}{:}$\n\n$$\n{\\color{blue}x} - 7{\\color{red}y} = 1\n$$\n\nTo **solve the equation for the variable** ${\\color{blue}{x}}$, we need to isolate $\\color{blue}x$ on one side of the equation:\n\nIn this case, we apply the addition principle and add $7{\\color{red}y}$ to both sides:\n\n$$\n\\begin{aligned}\nx - 7y &= 1 \\\\\nx - 7y + 7y &= 1 + 7y \\\\\nx + 0 &= 1 + 7y \\\\\nx &= 1 + 7y\n\\end{aligned}\n$$\n\nAnd that's it! We have successfully isolated the variable ${\\color{blue}{x}}$.\n\nLet's now look at an example where we must apply the multiplication principle." :tutorial/id #uuid "c431a781-752f-59ae-bf37-616b43771b6f" :tutorial/math-academy-id 8072 :tutorial/title "Introduction"} :step/id #uuid "c59fe348-2f63-5607-9155-2839edb15553" :step/math-academy-id 72728 :step/next {:db/id #edb/ref 17592186065267}} {:db/id #edb/ref 17592186065267 :step/content {:db/id #edb/ref 17592186064347 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063937 :question/id #uuid "46597138-36cc-584b-ade8-70cbfafcad2a" :question/math-academy-id "e-12905"} :knowledge-point/id #uuid "97dc4044-9984-58a3-bf02-61f31fc31792" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725} {:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186064498} {:db/id #edb/ref 17592186064787} {:db/id #edb/ref 17592186064788}] :knowledge-point/title "Solving One-Step Equations"} :step/id #uuid "20731402-a6cb-5902-8400-bb1a89578bba" :step/math-academy-id 72729 :step/next 