#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186074548} :activity/id #uuid "e91b9de1-4554-5765-ad6d-d882793a60e2" :activity/scope {:db/id #edb/ref 17592186049888 :topic/id #uuid "1bc09ddf-fd5e-5421-80b2-910368a693db" :topic/math-academy-id 516} :activity/steps [{:db/id #edb/ref 17592186074548 :step/content {:db/id #edb/ref 17592186074993 :tutorial/content "We've seen how to apply trigonometric ratios to angles given in degrees, but we can also apply them to angles given in radians.\n\nFor example, let's consider the expression \n\n$$\n\\cos({\\color{red}1}).\n$$\n\nNote that $\\color{red}1$ is written without any special symbols, like ${}^\\circ$ (degrees). This indicates that the angle $\\color{red}1$ is given in *radians*. Here, $\\color{red}1$ reads as \"one radian.\"\n\nIf we were given $\\cos({\\color{blue}1^\\circ})$ instead, with the degree sign ${}^\\circ$, that would mean we want the cosine of \"one degree.\"\n\nThe simplest way to find the actual value of $\\cos(1)$ would be using a calculator. This gives\n\n$$\n\\cos(1) = 0.540\\,302\\ldots \\approx 0.540\n$$\n\nrounded to $3$ decimal places.\n\n**Watch out!** Don't forget to set your calculator into the \"radians\" mode before computing the trigonometric function above." :tutorial/id #uuid "12546ed2-3515-59de-92de-6b69f547f78a" :tutorial/math-academy-id 2477 :tutorial/title "Introduction"} :step/id #uuid "b88962c7-2661-591e-a9d5-be86d2edfbaf" :step/math-academy-id 11063 :step/next {:db/id #edb/ref 17592186074549}} {:db/id #edb/ref 17592186074549 :step/content {:db/id #edb/ref 17592186073680 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073620 :question/id #uuid "2b0df0b9-3484-5408-aadc-01e756c43de7" :question/math-academy-id "e-3315"} :knowledge-point/id #uuid "c16dc76e-e756-5f66-9453-ba88b3f37f67" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049915} {:db/id #edb/ref 17592186050053} {:db/id #edb/ref 17592186050928}] :knowledge-point/questions [{:db/id #edb/ref 17592186074261} {:db/id #edb/ref 17592186074262} {:db/id #edb/ref 17592186521505} {:db/id #edb/ref 17592186521519}] :knowledge-point/title "Finding a Trigonometric Ratio"} :step/id #uuid "057b8527-936d-5316-85d9-d2b2d0b45d01" :step/math-academy-id 11064 :step/next {:db/id #edb/ref 17592186074551}} {:db/id #edb/ref 17592186074550 :step/content {:db/id #edb/ref 17592186073681 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073621 :question/id #uuid "b9829363-8cde-55fb-a1de-b6460ef451a1" :question/math-academy-id "e-3317"} :knowledge-point/id #uuid "3a2e44aa-d511-5bb4-bfe3-3213d7df0f1a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050847}] :knowledge-point/questions [{:db/id #edb/ref 17592186074260} {:db/id #edb/ref 17592186074263} {:db/id #edb/ref 17592186521528}] :knowledge-point/title "Finding a Trigonometric Ratio of an Acute Special Angle"} :step/id #uuid "16244912-12fe-5b3f-a5ff-6f52fb8ded59" :step/math-academy-id 11066 :step/next {:db/id #edb/ref 17592186074552}} {:db/id #edb/ref 17592186074551 :step/content {:db/id #edb/ref 17592186073682 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073622 :question/id #uuid "55d74eac-00aa-54cc-8e1f-743e053cc599" :question/math-academy-id "e-3318"} :knowledge-point/id #uuid "c2439bd5-8e25-5e4f-b852-72cabeeb440f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049794}] :knowledge-point/questions [{:db/id #edb/ref 17592186074256} {:db/id #edb/ref 17592186074257} {:db/id #edb/ref 17592186521483} {:db/id #edb/ref 17592186521504} {:db/id #edb/ref 17592186521535}] :knowledge-point/title "Finding an Inverse Trigonometric Ratio"} :step/id #uuid "7678b0e0-45c7-5db4-a061-a10fe08a9d29" :step/math-academy-id 11067 :step/next {:db/id #edb/ref 17592186074578}} {:db/id #edb/ref 17592186074552 :step/content {:db/id #edb/ref 17592186073683 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073623 :question/id #uuid "7eadc0f5-b50a-5e8e-9706-7f4fe0554abf" :question/math-academy-id "e-3319"} :knowledge-point/id #uuid "ce9c6436-70ed-5b95-b336-b40f0931f825" :knowledge-point/questions [{:db/id #edb/ref 17592186074258} {:db/id #edb/ref 17592186074259} {:db/id #edb/ref 17592186521473} {:db/id #edb/ref 17592186521494} {:db/id #edb/ref 17592186521498} {:db/id #edb/ref 17592186521556} {:db/id #edb/ref 17592186521569}] :knowledge-point/title "Identifying True Statements"} :step/id #uuid "981de351-12df-521a-a5a4-dfe5dbc79601" :step/math-academy-id 11068} {:db/id #edb/ref 17592186074578 :step/content {:db/id #edb/ref 17592186075001 :tutorial/content "Another way to compute a trigonometric ratio of an angle, say $\\sin\\theta$ where $\\theta$ is measured in radians, is to convert the angle into degrees first and then compute the trigonometric ratio of the equivalent angle in degrees.\n\nLet's consider the value of $\\sin \\left(\\dfrac{\\pi}{10}\\right).$ Since the angle is a multiple of $\\pi,$ we can easily convert the measure in radians to an equivalent measure in degrees. This gives\n\n$$\n\\left(\\dfrac{\\pi}{10}\\right) \\left(\\dfrac {180^\\circ} {\\pi}\\right) = \\dfrac {180^\\circ} {10} = 18^\\circ.\n$$\n\nNow, using a calculator in \"degrees\" mode, we obtain\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{\\pi }{10}) & =\\operatorname{sin}⁡({18}^{∘}) \\\\  & =0.309\\,016… \\\\  & ≈0.309\\end{aligned}\n$$\n\nrounded to $3$ decimal places." :tutorial/id #uuid "956127f3-00a2-527c-90a1-f254c49c25cf" :tutorial/math-academy-id 2573 :tutorial/title "Trigonometric Ratios With Angles in Radians Written As Multiples of Pi"} :step/id #uuid "4408c1c9-ea5f-57a8-9141-343a108416cb" :step/math-academy-id 11904 :step/next {:db/id #edb/ref 17592186074550}}] :activity/title "Trigonometric Ratios With Radians" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073941}]}
