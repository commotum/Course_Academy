#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186074548} :activity/id #uuid "e91b9de1-4554-5765-ad6d-d882793a60e2" :activity/scope {:db/id #edb/ref 17592186049888 :topic/id #uuid "1bc09ddf-fd5e-5421-80b2-910368a693db" :topic/math-academy-id 516} :activity/steps [{:db/id #edb/ref 17592186074548 :step/content {:db/id #edb/ref 17592186074993 :tutorial/content "We've seen how to apply trigonometric ratios to angles given in degrees, but we can also apply them to angles given in radians.\n\nFor example, let's consider the expression \n\n$$\n\\cos({\\color{red}1}).\n$$\n\nNote that $\\color{red}1$ is written without any special symbols, like ${}^\\circ$ (degrees). This indicates that the angle $\\color{red}1$ is given in *radians*. Here, $\\color{red}1$ reads as \"one radian.\"\n\nIf we were given $\\cos({\\color{blue}1^\\circ})$ instead, with the degree sign ${}^\\circ$, that would mean we want the cosine of \"one degree.\"\n\nThe simplest way to find the actual value of $\\cos(1)$ would be using a calculator. This gives\n\n$$\n\\cos(1) = 0.540\\,302\\ldots \\approx 0.540\n$$\n\nrounded to $3$ decimal places.\n\n**Watch out!** Don't forget to set your calculator into the \"radians\" mode before computing the trigonometric function above." :tutorial/id #uuid "12546ed2-3515-59de-92de-6b69f547f78a" :tutorial/math-academy-id 2477 :tutorial/title "Introduction"} :step/id #uuid "b88962c7-2661-591e-a9d5-be86d2edfbaf" :step/math-academy-id 11063 :step/next {:db/id #edb/ref 17592186074549}} {:db/id #edb/ref 17592186074549 :step/content {:db/id #edb/ref 17592186073680 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073620 :question/id #uuid "2b0df0b9-3484-5408-aadc-01e756c43de7" :question/math-academy-id "e-3315"} :knowledge-point/id #uuid "c16dc76e-e756-5f66-9453-ba88b3f37f67" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049915} {:db/id #edb/ref 17592186050053} {:db/id #edb/ref 17592186050928}] :knowledge-point/questions [{:db/id #edb/ref 17592186074261} {:db/id #edb/ref 17592186074262} {:db/id #edb/ref 17592186521505} {:db/id #edb/ref 17592186521519}] :knowledge-point/title "Finding a Trigonometric Ratio"} :step/id #uuid "057b8527-936d-5316-85d9-d2b2d0b45d01" :step/math-academy-id 11064 :step/next {:db/id #edb/ref 17592186074551}} {:db/id #edb/ref 17592186074550 :step/content {:db/id #edb/ref 17592186073681 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073621 :question/id #uuid "b9829363-8cde-55fb-a1de-b6460ef451a1" :question/math-academy-id "e-3317"} :knowledge-point/id #uuid "3a2e44aa-d511-5bb4-bfe3-3213d7df0f1a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050847}] :knowledge-point/questions [{:db/id #edb/ref 17592186074260} {:db/id #edb/ref 17592186074263} {:db/id #edb/ref 17592186521528} {:db/id #edb/ref 17592186545819} {:db/id #edb/ref 17592186545858}] :knowledge-point/title "Finding a Trigonometric Ratio of an Acute Special Angle"} :step/id #uuid "16244912-12fe-5b3f-a5ff-6f52fb8ded59" :step/math-academy-id 11066 :step/next {:db/id #edb/ref 17592186074552}} {:db/id #edb/ref 17592186074551 :step/content {:db/id #edb/ref 17592186073682 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073622 :question/id #uuid "55d74eac-00aa-54cc-8e1f-743e053cc599" :question/math-academy-id "e-3318"} :knowledge-point/id #uuid "c2439bd5-8e25-5e4f-b852-72cabeeb440f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049794}] :knowledge-point/questions [{:db/id #edb/ref 17592186074256} {:db/id #edb/ref 17592186074257} {:db/id #edb/ref 17592186521483} {:db/id #edb/ref 17592186521504} {:db/id #edb/ref 17592186521535}] :knowledge-point/title "Finding an Inverse Trigonometric Ratio"} :step/id #uuid "7678b0e0-45c7-5db4-a061-a10fe08a9d29" :step/math-academy-id 11067 :step/next {:db/id #edb/ref 17592186074578}} {:db/id #edb/ref 17592186074552 :step/content {:db/id #edb/ref 17592186073683 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073623 :question/id #uuid "7eadc0f5-b50a-5e8e-9706-7f4fe0554abf" :question/math-academy-id "e-3319"} :knowledge-point/id #uuid "ce9c6436-70ed-5b95-b336-b40f0931f825" :knowledge-point/questions [{:db/id #edb/ref 17592186074258} {:db/id #edb/ref 17592186074259} {:db/id #edb/ref 17592186521473} {:db/id #edb/ref 17592186521494} {:db/id #edb/ref 17592186521498} {:db/id #edb/ref 17592186521556} {:db/id #edb/ref 17592186521569}] :knowledge-point/title "Identifying True Statements"} :step/id #uuid "981de351-12df-521a-a5a4-dfe5dbc79601" :step/math-academy-id 11068} {:db/id #edb/ref 17592186074578 :step/content {:db/id #edb/ref 17592186075001 :tutorial/content "Another way to compute a trigonometric ratio of an angle, say $\\sin\\theta$ where $\\theta$ is measured in radians, is to convert the angle into degrees first and then compute the trigonometric ratio of the equivalent angle in degrees.\n\nLet's consider the value of $\\sin \\left(\\dfrac{\\pi}{10}\\right).$ Since the angle is a multiple of $\\pi,$ we can easily convert the measure in radians to an equivalent measure in degrees. This gives\n\n$$\n\\left(\\dfrac{\\pi}{10}\\right) \\left(\\dfrac {180^\\circ} {\\pi}\\right) = \\dfrac {180^\\circ} {10} = 18^\\circ.\n$$\n\nNow, using a calculator in \"degrees\" mode, we obtain\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{\\pi }{10}) & =\\operatorname{sin}⁡({18}^{∘}) \\\\  & =0.309\\,016… \\\\  & ≈0.309\\end{aligned}\n$$\n\nrounded to $3$ decimal places." :tutorial/id #uuid "956127f3-00a2-527c-90a1-f254c49c25cf" :tutorial/math-academy-id 2573 :tutorial/title "Trigonometric Ratios With Angles in Radians Written As Multiples of Pi"} :step/id #uuid "4408c1c9-ea5f-57a8-9141-343a108416cb" :step/math-academy-id 11904 :step/next {:db/id #edb/ref 17592186074550}}] :activity/title "Trigonometric Ratios With Radians" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073941}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186545978} :activity/id #uuid "dec9a261-3e1f-5d0e-88a5-0754978f11d5" :activity/scope {:db/id #edb/ref 17592186049888 :topic/id #uuid "1bc09ddf-fd5e-5421-80b2-910368a693db" :topic/math-academy-id 516} :activity/steps [{:db/id #edb/ref 17592186545961 :step/content {:db/id #edb/ref 17592186545819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "137571b5-7a83-5f63-8a0b-fcf213a92f6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186545235} {:answer/id #uuid "4ff39d9b-b653-56bf-aa12-7a8401ca193a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186545348} {:answer/id #uuid "b258fa98-837b-58ac-bb50-87dbe84ce48b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186545521} {:answer/id #uuid "b4f2c0d5-f400-5694-82c6-4b8a8fb68adb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186545529} {:answer/id #uuid "da283058-2c21-59b1-a080-2b672e4fb121" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186545600}] :answer-field/correct {:db/id #edb/ref 17592186545529} :answer-field/id #uuid "f6f86bd3-1e4e-5923-9c4e-69ac157875db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545790}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4f375dc2-c494-589d-83fe-86d9688ddf86" :question/math-academy-id "q-54386" :question/problem "$\\operatorname{cos}⁡(\\frac{\\pi }{6})=$" :question/worked-solution "First, we convert $\\frac{\\pi }{6}$ radians to an equivalent measure in degrees. This gives\n\n$$\n(\\frac{\\pi }{6})(\\frac{{180}^{∘}}{\\pi })=\\frac{{180}^{∘}}{6}={30}^{∘}.\n$$\n\nTherefore,\n\n$$\n\\operatorname{cos}⁡(\\frac{\\pi }{6})=\\operatorname{cos}⁡{30}^{∘}.\n$$\n\nFinally, since we know that $\\operatorname{cos}⁡{30}^{∘}=\\frac{\\sqrt{3}}{2},$ we obtain\n\n$$\n\\operatorname{cos}⁡(\\frac{\\pi }{6})=\\operatorname{cos}⁡{30}^{∘}=\\frac{\\sqrt{3}}{2}.\n$$"} :step/id #uuid "a58b4787-6c01-5691-bbc7-71fe7276d88f" :step/next {:db/id #edb/ref 17592186546006}} {:db/id #edb/ref 17592186545978 :step/content {:db/id #edb/ref 17592186074257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d86e239-6e85-58eb-a19e-95b86eb56b12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.381" :db/id #edb/ref 17592186071781} {:answer/id #uuid "b085e3f4-7f65-5148-b395-ac572d6eec64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.558" :db/id #edb/ref 17592186071782} {:answer/id #uuid "cee93826-641b-5e29-9832-3f9f5d288e72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.675" :db/id #edb/ref 17592186071783} {:answer/id #uuid "fc64ba9d-9471-5d5a-b914-0a717b2e5782" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.446" :db/id #edb/ref 17592186071784} {:answer/id #uuid "7869bc21-9fc2-58cf-b6bc-1c79e23bc83a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.540" :db/id #edb/ref 17592186071785}] :answer-field/correct {:db/id #edb/ref 17592186071783} :answer-field/id #uuid "f9643322-cded-5b67-a8dd-cc6014f700fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186071780}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "50639e0d-27b7-5cc4-8c91-e7a7ffd38e27" :question/math-academy-id "q-54367" :question/problem "Rounded to three decimal places, what is $\\operatorname{arctan}⁡(0.8)$ in radians?" :question/requires-calculator true :question/worked-solution "Note that we need the answer in radians. Using a calculator in \"radians\" mode, we obtain\n\n$$\n\\operatorname{arctan}⁡(0.8)=0.674\\,740…≈0.675\\,\\text{radians}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "c3d09685-08ad-5d3c-9337-bff6ebdd69bb" :step/next {:db/id #edb/ref 17592186545961}} {:db/id #edb/ref 17592186546006 :step/content {:db/id #edb/ref 17592186545858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a11dbc5-4605-5d2f-815d-487cdff0ae65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186545252} {:answer/id #uuid "4a933bd3-9d4d-5635-b3d2-b0ca7cff973e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186545341} {:answer/id #uuid "b56b841a-b4a3-56c7-bfa1-a682e8e14500" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186545530} {:answer/id #uuid "bb5dd636-0a57-50f3-a3b6-1ac51a1c9db9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186545538} {:answer/id #uuid "bd197a7f-2045-5bf2-9e98-404a33fb8ace" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186545542}] :answer-field/correct {:db/id #edb/ref 17592186545538} :answer-field/id #uuid "27912ff0-a6bc-5a3b-9141-25760180fb99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545689}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c68e45a3-bbd1-5372-b99a-a88344f8278f" :question/math-academy-id "q-54387" :question/problem "$\\operatorname{tan}⁡(\\frac{\\pi }{3})=$" :question/worked-solution "First, we convert $\\frac{\\pi }{3}$ radians to an equivalent measure in degrees. This gives\n\n$$\n(\\frac{\\pi }{3})(\\frac{{180}^{∘}}{\\pi })=\\frac{{180}^{∘}}{3}={60}^{∘}.\n$$\n\nTherefore, \n\n$$\n\\operatorname{tan}⁡(\\frac{\\pi }{3})=\\operatorname{tan}⁡{60}^{∘}.\n$$\n\nFinally, since we know that $\\operatorname{tan}⁡{60}^{∘}=\\sqrt{3},$  we obtain\n\n$$\n\\operatorname{tan}⁡(\\frac{\\pi }{3})=\\operatorname{tan}⁡{60}^{∘}=\\sqrt{3}.\n$$"} :step/id #uuid "e83dc6c2-4a4b-5902-b486-56bd0dc1f84c"}] :activity/title "Trigonometric Ratios With Radians" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186545196}]}
