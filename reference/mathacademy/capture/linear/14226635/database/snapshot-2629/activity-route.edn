#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186545978} :activity/id #uuid "dec9a261-3e1f-5d0e-88a5-0754978f11d5" :activity/scope {:db/id #edb/ref 17592186049888 :topic/id #uuid "1bc09ddf-fd5e-5421-80b2-910368a693db" :topic/math-academy-id 516} :activity/steps [{:db/id #edb/ref 17592186545961 :step/content {:db/id #edb/ref 17592186545819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "137571b5-7a83-5f63-8a0b-fcf213a92f6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186545235} {:answer/id #uuid "4ff39d9b-b653-56bf-aa12-7a8401ca193a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186545348} {:answer/id #uuid "b258fa98-837b-58ac-bb50-87dbe84ce48b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186545521} {:answer/id #uuid "b4f2c0d5-f400-5694-82c6-4b8a8fb68adb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186545529} {:answer/id #uuid "da283058-2c21-59b1-a080-2b672e4fb121" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186545600}] :answer-field/correct {:db/id #edb/ref 17592186545529} :answer-field/id #uuid "f6f86bd3-1e4e-5923-9c4e-69ac157875db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545790}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4f375dc2-c494-589d-83fe-86d9688ddf86" :question/math-academy-id "q-54386" :question/problem "$\\operatorname{cos}⁡(\\frac{\\pi }{6})=$" :question/worked-solution "First, we convert $\\frac{\\pi }{6}$ radians to an equivalent measure in degrees. This gives\n\n$$\n(\\frac{\\pi }{6})(\\frac{{180}^{∘}}{\\pi })=\\frac{{180}^{∘}}{6}={30}^{∘}.\n$$\n\nTherefore,\n\n$$\n\\operatorname{cos}⁡(\\frac{\\pi }{6})=\\operatorname{cos}⁡{30}^{∘}.\n$$\n\nFinally, since we know that $\\operatorname{cos}⁡{30}^{∘}=\\frac{\\sqrt{3}}{2},$ we obtain\n\n$$\n\\operatorname{cos}⁡(\\frac{\\pi }{6})=\\operatorname{cos}⁡{30}^{∘}=\\frac{\\sqrt{3}}{2}.\n$$"} :step/id #uuid "a58b4787-6c01-5691-bbc7-71fe7276d88f" :step/next {:db/id #edb/ref 17592186546006}} {:db/id #edb/ref 17592186545978 :step/content {:db/id #edb/ref 17592186074257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d86e239-6e85-58eb-a19e-95b86eb56b12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.381" :db/id #edb/ref 17592186071781} {:answer/id #uuid "b085e3f4-7f65-5148-b395-ac572d6eec64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.558" :db/id #edb/ref 17592186071782} {:answer/id #uuid "cee93826-641b-5e29-9832-3f9f5d288e72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.675" :db/id #edb/ref 17592186071783} {:answer/id #uuid "fc64ba9d-9471-5d5a-b914-0a717b2e5782" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.446" :db/id #edb/ref 17592186071784} {:answer/id #uuid "7869bc21-9fc2-58cf-b6bc-1c79e23bc83a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.540" :db/id #edb/ref 17592186071785}] :answer-field/correct {:db/id #edb/ref 17592186071783} :answer-field/id #uuid "f9643322-cded-5b67-a8dd-cc6014f700fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186071780}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "50639e0d-27b7-5cc4-8c91-e7a7ffd38e27" :question/math-academy-id "q-54367" :question/problem "Rounded to three decimal places, what is $\\operatorname{arctan}⁡(0.8)$ in radians?" :question/requires-calculator true :question/worked-solution "Note that we need the answer in radians. Using a calculator in \"radians\" mode, we obtain\n\n$$\n\\operatorname{arctan}⁡(0.8)=0.674\\,740…≈0.675\\,\\text{radians}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "c3d09685-08ad-5d3c-9337-bff6ebdd69bb" :step/next {:db/id #edb/ref 17592186545961}} {:db/id #edb/ref 17592186546006 :step/content {:db/id #edb/ref 17592186545858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a11dbc5-4605-5d2f-815d-487cdff0ae65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186545252} {:answer/id #uuid "4a933bd3-9d4d-5635-b3d2-b0ca7cff973e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186545341} {:answer/id #uuid "b56b841a-b4a3-56c7-bfa1-a682e8e14500" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186545530} {:answer/id #uuid "bb5dd636-0a57-50f3-a3b6-1ac51a1c9db9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186545538} {:answer/id #uuid "bd197a7f-2045-5bf2-9e98-404a33fb8ace" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186545542}] :answer-field/correct {:db/id #edb/ref 17592186545538} :answer-field/id #uuid "27912ff0-a6bc-5a3b-9141-25760180fb99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545689}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c68e45a3-bbd1-5372-b99a-a88344f8278f" :question/math-academy-id "q-54387" :question/problem "$\\operatorname{tan}⁡(\\frac{\\pi }{3})=$" :question/worked-solution "First, we convert $\\frac{\\pi }{3}$ radians to an equivalent measure in degrees. This gives\n\n$$\n(\\frac{\\pi }{3})(\\frac{{180}^{∘}}{\\pi })=\\frac{{180}^{∘}}{3}={60}^{∘}.\n$$\n\nTherefore, \n\n$$\n\\operatorname{tan}⁡(\\frac{\\pi }{3})=\\operatorname{tan}⁡{60}^{∘}.\n$$\n\nFinally, since we know that $\\operatorname{tan}⁡{60}^{∘}=\\sqrt{3},$  we obtain\n\n$$\n\\operatorname{tan}⁡(\\frac{\\pi }{3})=\\operatorname{tan}⁡{60}^{∘}=\\sqrt{3}.\n$$"} :step/id #uuid "e83dc6c2-4a4b-5902-b486-56bd0d