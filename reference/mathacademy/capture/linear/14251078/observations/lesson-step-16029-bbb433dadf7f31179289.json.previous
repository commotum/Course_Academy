MAINB-7C\" x=\"879\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-32\" x=\"1694\" y=\"675\"></use>\n</g>\n <use xlink:href=\"#E3-MJMAIN-2B\" x=\"3208\" y=\"0\"></use>\n<g transform=\"translate(4209,0)\">\n <use xlink:href=\"#E3-MJMAINB-7C\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAINB-62\" x=\"319\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAINB-7C\" x=\"959\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-32\" x=\"1808\" y=\"675\"></use>\n</g>\n <use xlink:href=\"#E3-MJMAIN-2212\" x=\"6164\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-32\" x=\"7164\" y=\"0\"></use>\n<g transform=\"translate(7665,0)\">\n <use xlink:href=\"#E3-MJMAINB-7C\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAINB-61\" x=\"319\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAINB-7C\" x=\"879\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAINB-7C\" x=\"1198\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAINB-62\" x=\"1518\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAINB-7C\" x=\"2157\" y=\"0\"></use>\n</g>\n<g transform=\"translate(10308,0)\">\n <use xlink:href=\"#E3-MJMAIN-63\"></use>\n <use xlink:href=\"#E3-MJMAIN-6F\" x=\"444\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-73\" x=\"945\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E3-MJMATHI-3B8\" x=\"11815\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>In general, given any two vectors that form a triangle using the triangle addition law, we can always use the law of cosines to compute the magnitude of the sum.</p>\n\n        </div>",
