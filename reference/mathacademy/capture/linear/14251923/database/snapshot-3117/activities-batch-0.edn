edb/ref 17592186519542} {:db/id #edb/ref 17592186541054} {:db/id #edb/ref 17592186541065} {:db/id #edb/ref 17592186541129} {:db/id #edb/ref 17592186572665}] :knowledge-point/title "Calculating the Limit of a Rational Function With Two Quadratic Terms by Factoring"} :step/id #uuid "de1bdae6-79f1-521f-90b6-f0f8755e4df7" :step/math-academy-id 451 :step/next {:db/id #edb/ref 17592186120905}}] :activity/title "Calculating Limits of Rational Functions by Factoring" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120021}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186518250} :activity/id #uuid "1e5bf916-4dc8-5981-8525-b54be92da138" :activity/scope {:db/id #edb/ref 17592186049927 :topic/id #uuid "1f1f7b83-a1f4-5b1c-888f-a20ae593bd72" :topic/math-academy-id 1813} :activity/steps [{:db/id #edb/ref 17592186518250 :step/content {:db/id #edb/ref 17592186518112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21831e57-25de-5c6c-9c6c-ab43447a6e8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186517547} {:answer/id #uuid "508c3ec8-73a1-50fd-9725-b8b2d47f39c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186517645} {:answer/id #uuid "65388b8f-1379-5e74-8e66-a7ae1be68001" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186517673} {:answer/id #uuid "8e6f65b9-3a3d-5210-af3f-833869259271" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186517754} {:answer/id #uuid "903accd6-cb1b-59f6-92d9-52cbca2aade9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{9}" :db/id #edb/ref 17592186517758}] :answer-field/correct {:db/id #edb/ref 17592186517547} :answer-field/id #uuid "d257b360-4e88-51e4-add3-d80d3561fcec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518070}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "17d3a51b-87c6-5439-b5d7-1ae7b5260460" :question/math-academy-id "q-101158" :question/problem "Evaluate ${lim}_{t\\to 2}\\frac{{t}^{2}+t-6}{{t}^{2}-9t+14}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{{t}^{2}+t-6}{{t}^{2}-9t+14} & =\\frac{{2}^{2}+2-6}{{2}^{2}-9(2)+14}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{t}^{2}+t-6}{{t}^{2}-9t+14} & =\\frac{(t+3)(t-2)}{(t-2)(t-7)} \\\\  & =\\frac{t+3}{t-7}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{t\\to 2}\\frac{{t}^{2}+t-6}{{t}^{2}-9t+14} & ={lim}_{t\\to 2}\\frac{t+3}{t-7} \\\\  & =\\frac{2+3}{2-7} \\\\  & =\\frac{5}{(-5)} \\\\  & =-1.\\end{aligned}\n$$"} :step/id #uuid "481c4610-a5dc-53ed-ae6e-370e534c6b45" :step/next {:db/id #edb/ref 17592186518293}} {:db/id #edb/ref 17592186518274 :step/content {:db/id #edb/ref 17592186518196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8a68754-36ce-52d6-9127-21d7b91302be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186517899}] :answer-field/correct {:db/id #edb/ref 17592186517899} :answer-field/id #uuid "ceec04e3-5f86-53fd-a80b-d4bd7eba9ecc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186518068}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c9bfaabb-1ddb-5591-87c5-e59f3a52dfbc" :question/math-academy-id "q-338200" :question/problem "Evaluate the following limit:\n\n${lim}_{y\\to 4}\\frac{{y}^{2}-16}{{y}^{2}-4y}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{y\\to 4}\\frac{{y}^{2}-16}{{y}^{2}-4y} & =\\frac{(4)^{2}-16}{(4)^{2}-4(4)} \\\\  & =\\frac{16-16}{16-16} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{y}^{2}-16}{{y}^{2}-4y} & =\\frac{(y-4)(y+4)}{y(y-4)} \\\\  & =\\frac{y+4}{y}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{y\\to 4}\\frac{{y}^{2}-16}{{y}^{2}-4y} & ={lim}_{y\\to 4}\\frac{y+4}{y} \\\\  & =\\frac{4+4}{4} \\\\  & =\\frac{8}{4} \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "955c3886-484b-5898-8b9e-865782ff28a4" :step/next {:db/id #edb/ref 17592186518286}} {:db/id #edb/ref 17592186518286 :step/content {:db/id #edb/ref 17592186518167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79457547-f0fb-58fa-a2c2-317026062441" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{10}" :db/id #edb/ref 17592186517716}] :answer-field/correct {:db/id #edb/ref 17592186517716} :answer-field/id #uuid "288b4964-15f8-5bdf-aea5-937b1035cccb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186517990}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7eccf962-783f-535d-b46e-1c5922c7413f" :question/math-academy-id "q-338206" :question/problem "Evaluate the following limit:\n\n${lim}_{y\\to 0}\\frac{7{y}^{6}-3{y}^{4}}{5{y}^{5}+10{y}^{4}}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{y\\to 0}\\frac{7{y}^{6}-3{y}^{4}}{5{y}^{5}+10{y}^{4}} & =\\frac{7(0)^{6}-3(0)^{4}}{5(0)^{5}+10(0)^{4}}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{7{y}^{6}-3{y}^{4}}{5{y}^{5}+10{y}^{4}} & =\\frac{{y}^{4}(7{y}^{2}-3)}{{y}^{4}(5y+10)} \\\\  & =\\frac{7{y}^{2}-3}{5y+10}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{y\\to 0}\\frac{7{y}^{6}-3{y}^{4}}{5{y}^{5}+10{y}^{4}} & ={lim}_{y\\to 0}\\frac{7{y}^{2}-3}{5y+10} \\\\  & =\\frac{7(0)-3}{5(0)+10} \\\\  & =-\\frac{3}{10}.\\end{aligned}\n$$"} :step/id #uuid "b56c33d1-61b7-5263-b02b-f1a42ae44b24"} {:db/id #edb/ref 17592186518293 :step/content {:db/id #edb/ref 17592186518149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f3291a2-9375-59ea-b11b-d3d51ab51141" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186517542} {:answer/id #uuid "2974ec32-c354-5379-8e1b-6a9acfaaddc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186517562} {:answer/id #uuid "58abb328-ad36-5cec-a8bc-f5da4562671f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186517652} {:answer/id #uuid "70d0b790-1084-5fd6-8c21-af30bf9f25cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186517705} {:answer/id #uuid "8ae9eecc-f45a-5e19-a6c0-5c2967aa26fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186517748}] :answer-field/correct {:db/id #edb/ref 17592186517562} :answer-field/id #uuid "97ef3454-a8d7-5dce-ad87-6a661e06cf5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518043}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "63acba77-7b2e-522a-aba2-29e686142675" :question/math-academy-id "q-140415" :question/problem "Evaluate ${lim}_{x\\to -4}\\frac{3x+12}{{x}^{3}+64}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{3x+12}{{x}^{3}+64} & =\\frac{3(-4)+12}{(-4)^{3}+64}=\\frac{-12+12}{-64+64}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. \n\nNotice that the denominator is a sum of cubes. Therefore, factoring our expression, we get\n\n$$\n\\begin{aligned}\\frac{3x+12}{{x}^{3}+64} & =\\frac{3(x+4)}{{x}^{3}+{4}^{3}} \\\\  & =\\frac{3(x+4)}{(x+4)({x}^{2}-4x+{4}^{2})} \\\\  & =\\frac{3}{{x}^{2}-4x+16}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{3x+12}{{x}^{3}+64} & ={lim}_{x\\to -4}\\frac{3}{{x}^{2}-4x+16} \\\\  & =\\frac{3}{(-4)^{2}-4(-4)+16} \\\\  & =\\frac{3}{16+16+16} \\\\  & =\\frac{1}{16}.\\end{aligned}\n$$"} :step/id #uuid "c854a8d0-adb7-5877-8a8d-92ee782e3584" :step/next {:db/id #edb/ref 17592186518274}}] :activity/title "Calculating Limits of Rational Functions by Factoring" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186517476}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186519668} :activity/id #uuid "51893726-ddac-5484-9f3a-d915a01dfdcb" :activity/scope {:db/id #edb/ref 17592186049927 :topic/id #uuid "1f1f7b83-a1f4-5b1c-888f-a20ae593bd72" :topic/math-academy-id 1813} :activity/steps [{:db/id #edb/ref 17592186519641 :step/content {:db/id #edb/ref 17592186519532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c83a02a-d899-55c8-a94f-5215ee121e17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186519111} {:answer/id #uuid "81e207e3-fbc2-5800-abe0-1ceefd387562" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186519195} {:answer/id #uuid "89b85bb3-22c0-5d24-a29b-0c275ecfe2a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186519215} {:answer/id #uuid "d56cb5bc-4d9d-5419-a948-dca0397cf746" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186519344} {:answer/id #uuid "e10ffd2c-df31-5361-8cae-6b39de43c35c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186519365}] :answer-field/correct {:db/id #edb/ref 17592186519215} :answer-field/id #uuid "be118eae-f956-5136-8758-541234de46d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519484}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2778d4f8-72c7-5929-98a7-5df304873786" :question/math-academy-id "q-101160" :question/problem "Evaluate ${lim}_{y\\to 3}\\frac{{y}^{2}+3y-18}{{y}^{2}-3y}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{y\\to 3}\\frac{{y}^{2}+3y-18}{{y}^{2}-3y} & =\\frac{{3}^{2}+3(3)-18}{{3}^{2}-3(3)}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{y}^{2}+3y-18}{{y}^{2}-3y} & =\\frac{(y+6)(y-3)}{y(y-3)} \\\\  & =\\frac{y+6}{y}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{y\\to 3}\\frac{{y}^{2}+3y-18}{{y}^{2}-3y} & ={lim}_{y\\to 3}\\frac{y+6}{y} \\\\  & =\\frac{3+6}{3} \\\\  & =\\frac{9}{3} \\\\  & =3.\\end{aligned}\n$$"} :step/id #uuid "6d3de455-eb8b-5f64-94cd-7656cf858b93" :step/next {:db/id #edb/ref 17592186519662}} {:db/id #edb/ref 17592186519662 :step/content {:db/id #edb/ref 17592186519542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b385cd1-b9ce-5705-9e8c-ff293413d49c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186519185}] :answer-field/correct {:db/id #edb/ref 17592186519185} :answer-field/id #uuid "dd8d554e-6195-547e-bcb1-ff6fe5d58358" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186519500}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5986bf81-4caa-5e55-8c99-36ab322d7c9c" :question/math-academy-id "q-313149" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to -2}\\frac{{x}^{2}-5x-14}{x+2}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to -2}\\frac{{x}^{2}-5x-14}{x+2} & =\\frac{(-2)^{2}-5(-2)-14}{-2+2} \\\\  & =\\frac{4+10-14}{0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator. We get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-5x-14}{x+2} & =\\frac{(x-7)(x+2)}{x+2} \\\\  & =x-7.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to -2}(x-7) & =(-2)-7 \\\\  & =-9.\\end{aligned}\n$$"} :step/id #uuid "c8ebbc60-a13e-5fb9-bd31-db31053b64b4"} {:db/id #edb/ref 17592186519668 :step/content {:db/id #edb/ref 17592186519551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e1be6ba-0318-5199-9cf7-6cfc2c56fa02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186519156} {:answer/id #uuid "892f567d-b4cc-5f65-95a7-7373905d09c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186519211} {:answer/id #uuid "8ce5d32b-9d7b-5303-97bb-68e862c5ae64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186519222} {:answer/id #uuid "a6c6b966-6937-5cda-a2a8-2103c125ed81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186519266} {:answer/id #uuid "edf46e72-237e-5ade-b7c8-d89a1c8c5d81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186519382}] :answer-field/correct {:db/id #edb/ref 17592186519266} :answer-field/id #uuid "2b3845e7-e81e-5c5b-85b8-7d7f11e07468" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519427}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "72828711-fc6d-5cc1-8d14-0b819a351e61" :question/math-academy-id "q-3749" :question/problem "Evaluate ${lim}_{x\\to 1}\\frac{-2{x}^{4}+6{x}^{2}-4}{{x}^{2}-1}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{-2{x}^{4}+6{x}^{2}-4}{{x}^{2}-1} & =\\frac{-2(1)^{4}+6(1)^{2}-4}{(1)^{2}-1}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. \n\n$$\n\\begin{aligned}\\frac{-2{x}^{4}+6{x}^{2}-4}{{x}^{2}-1} & =\\frac{-2({x}^{4}-3{x}^{2}+2)}{{x}^{2}-1} \\\\  & =\\frac{-2({x}^{2}-2)({x}^{2}-1)}{{x}^{2}-1} \\\\  & =-2({x}^{2}-2).\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{-2{x}^{4}+6{x}^{2}-4}{{x}^{2}-1} & ={lim}_{x\\to 1}\\,\\,-2({x}^{2}-2) \\\\  & =-2(1-2) \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "ec795ac2-9c40-5579-8d71-0f6e0fe67464" :step/next {:db/id #edb/ref 17592186519641}}] :activity/title "Calculating Limits of Rational Functions by Factoring" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186518978}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186541215} :activity/id #uuid "09e02f53-8a92-5ad2-9c96-e92966523e23" :activity/scope {:db/id #edb/ref 17592186049927 :topic/id #uuid "1f1f7b83-a1f4-5b1c-888f-a20ae593bd72" :topic/math-academy-id 1813} :activity/steps [{:db/id #edb/ref 17592186541204 :step/content {:db/id #edb/ref 17592186541054 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ecaeecc-1dd7-50eb-83e9-f0550181de4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186540580} {:answer/id #uuid "2ac09810-2176-58cd-aa0b-9736d84fc7e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186540601} {:answer/id #uuid "54bf5811-f21f-5d2c-886d-ccd5bf4f9758" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186540669} {:answer/id #uuid "a9943892-6a5d-567f-a068-dec6e6f6140d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186540812} {:answer/id #uuid "d0c0f7e1-5ac8-52a6-a477-47a0531cf7cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186540879}] :answer-field/correct {:db/id #edb/ref 17592186540601} :answer-field/id #uuid "d2177b68-63d5-53b3-a804-f2a9f09d50af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541034}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "000ec056-1962-5b34-98db-f72ea83a397c" :question/math-academy-id "q-101157" :question/problem "Evaluate ${lim}_{t\\to -4}\\frac{{t}^{2}-16}{{t}^{2}+4t}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{{t}^{2}-16}{{t}^{2}+4t} & =\\frac{(-4)^{2}-16}{(-4)^{2}+4(-4)}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{t}^{2}-16}{{t}^{2}+4t} & =\\frac{(t+4)(t-4)}{t(t+4)} \\\\  & =\\frac{t-4}{t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{t\\to -4}\\frac{{t}^{2}-16}{{t}^{2}+4t} & ={lim}_{t\\to -4}\\frac{t-4}{t} \\\\  & =\\frac{-4-4}{(-4)} \\\\  & =\\frac{(-8)}{(-4)} \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "9a97cb65-3846-5c88-b3b7-a6e46d1bdf5c" :step/next {:db/id #edb/ref 17592186541210}} {:db/id #edb/ref 17592186541210 :step/content {:db/id #edb/ref 17592186541129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16787501-bf61-5650-acba-b6330c5fbd81" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Does not exist" :db/id #edb/ref 17592186540563} {:answer/id #uuid "1b673edc-f9bf-5da4-a8b1-570b0810ca4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186540573} {:answer/id #uuid "a84a29ca-0cdf-58cd-bf89-e6937cd9cb17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186540808} {:answer/id #uuid "ac833262-dd83-5bdc-a643-9892af09fe23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186540816} {:answer/id #uuid "cd352154-c198-57dc-a850-df25b22c0f47" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186540870}] :answer-field/correct {:db/id #edb/ref 17592186540808} :answer-field/id #uuid "01c57478-0f3f-518c-9545-f7b2b4a1d9d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540942}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c1e71946-3589-5a14-87c2-2599e8aef444" :question/math-academy-id "q-107041" :question/problem "Evaluate ${lim}_{x\\to 5}\\frac{{x}^{2}-5x}{{x}^{2}-8x+15}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 5}\\frac{{x}^{2}-5x}{{x}^{2}-8x+15} & =\\frac{{5}^{2}-5(5)}{{5}^{2}-8(5)+15}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-5x}{{x}^{2}-8x+15} & =\\frac{x(x-5)}{(x-5)(x-3)} \\\\  & =\\frac{x}{x-3}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 5}\\frac{{x}^{2}-5x}{{x}^{2}-8x+15} & ={lim}_{x\\to 5}\\frac{x}{x-3} \\\\  & =\\frac{5}{5-3} \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$"} :step/id #uuid "b0ee0554-72db-514b-8267-3bcda471dd63" :step/next {:db/id #edb/ref 17592186541227}} {:db/id #edb/ref 17592186541215 :step/content {:db/id #edb/ref 17592186541065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb41bce-fce3-5aca-b3c6-9258d6451625" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186540546} {:answer/id #uuid "a9102bb7-1a7c-515a-bc83-8aa77adb4e86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186540811} {:answer/id #uuid "e4c5729f-2ec8-544e-b828-2de2b317c0ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186540916} {:answer/id #uuid "e4ff5de3-95df-570c-97a0-37b81b1edad0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186540917} {:answer/id #uuid "f8fc8b30-393b-592f-a907-3907a2e566f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186540934}] :answer-field/correct {:db/id #edb/ref 17592186540917} :answer-field/id #uuid "9da39b9f-c278-5623-b8c6-2f09872d7126" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541009}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1889a049-4ef8-5003-97ad-4734948ea194" :question/math-academy-id "q-14553" :question/problem "Evaluate ${lim}_{x\\to 4}\\frac{{x}^{2}-2x-8}{{x}^{2}+x-20}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}\\frac{{x}^{2}-2x-8}{{x}^{2}+x-20} & =\\frac{{4}^{2}-2(4)-8}{{4}^{2}+4-20}=\\frac{0}{0},\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-2x-8}{{x}^{2}+x-20} & =\\frac{(x+2)(x-4)}{(x+5)(x-4)} \\\\  & =\\frac{x+2}{x+5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}\\frac{{x}^{2}-2x-8}{{x}^{2}+x-20} & ={lim}_{x\\to 4}\\frac{x+2}{x+5} \\\\  & =\\frac{4+2}{4+5} \\\\  & =\\frac{6}{9} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} :step/id #uuid "b86c1506-fd97-5625-ace8-d8b15485c870" :step/next {:db/id #edb/ref 17592186541204}} {:db/id #edb/ref 17592186541227 :step/content {:db/id #edb/ref 17592186541105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "077220d2-c11b-581c-9dc9-a863cd12de00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "54" :db/id #edb/ref 17592186540535} {:answer/id #uuid "086f31ad-a572-5058-91fc-e1dcee2b9771" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186540538} {:answer/id #uuid "34f2a82b-7c4f-54f8-b717-955f680377fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186540610} {:answer/id #uuid "866ea189-c7fa-588c-bb97-2a9eac42cd76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186540753} {:answer/id #uuid "d4751cb2-aee2-5bbb-a97c-2800d912b17c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186540887}] :answer-field/correct {:db/id #edb/ref 17592186540610} :answer-field/id #uuid "81caaad2-536e-533e-be45-81a17e89437b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540996}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7aab1343-37d9-52dc-ba1f-d0f44020bf1c" :question/math-academy-id "q-140416" :question/problem "Evaluate ${lim}_{x\\to 3}\\frac{{x}^{3}-27}{2x-6}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{{x}^{3}-27}{2x-6} & =\\frac{{3}^{3}-27}{2(3)-6}=\\frac{27-27}{6-6}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. \n\nNotice that the numerator is a difference of cubes. Therefore, factoring our expression, we get\n\n$$\n\\begin{aligned}\\frac{{x}^{3}-27}{2x-6} & =\\frac{{x}^{3}-{3}^{3}}{2(x-3)} \\\\  & =\\frac{(x-3)({x}^{2}+3x+{3}^{2})}{2(x-3)} \\\\  & =\\frac{{x}^{2}+3x+9}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{{x}^{3}-27}{2x-6} & ={lim}_{x\\to 3}\\frac{{x}^{2}+3x+9}{2} \\\\  & =\\frac{{3}^{2}+3(3)+9}{2} \\\\  & =\\frac{9+9+9}{2} \\\\  & =\\frac{27}{2}.\\end{aligned}\n$$"} :step/id #uuid "ed05f966-1db5-5d79-b616-775fcdf355c1"}] :activity/title "Calculating Limits of Rational Functions by Factoring" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186540513}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186572732} :activity/id #uuid "cafdccd2-ff8f-57a4-83bf-a3c65b815967" :activity/scope {:db/id #edb/ref 17592186049927 :topic/id #uuid "1f1f7b83-a1f4-5b1c-888f-a20ae593bd72" :topic/math-academy-id 1813} :activity/steps [{:db/id #edb/ref 17592186572732 :step/content {:db/id #edb/ref 17592186572728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2daf76a0-8500-574d-afca-1701571dfa88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty" :db/id #edb/ref 17592186572370} {:answer/id #uuid "3a948208-572a-5fd8-9cc1-d9a5ab2b4a9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186572385} {:answer/id #uuid "74947654-7873-5a49-873e-6e8a7c42d1c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186572448} {:answer/id #uuid "b0943d78-afb5-5b99-822e-4d82efc4099b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186572512} {:answer/id #uuid "f33d6f17-9ed5-585c-ab3c-2a4e63e824bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186572581}] :answer-field/correct {:db/id #edb/ref 17592186572581} :answer-field/id #uuid "5de46a5c-045a-5a65-93fe-1ee8641452b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572618}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f8c786dd-8e95-5f38-8555-c19baa5a85a4" :question/math-academy-id "q-48388" :question/problem "Evaluate ${lim}_{x\\to 0}\\frac{9{x}^{3}-4x}{3{x}^{2}+2x}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{9{x}^{3}-4x}{3{x}^{2}+2x} & =\\frac{9(0)^{3}-4(0)}{3(0)^{2}+2(0)}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{9{x}^{3}-4x}{3{x}^{2}+2x} & =\\frac{x(9{x}^{2}-4)}{x(3x+2)} \\\\  & =\\frac{9{x}^{2}-4}{3x+2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{9{x}^{3}-4x}{3{x}^{2}+2x} & ={lim}_{x\\to 0}\\frac{9{x}^{2}-4}{3x+2} \\\\  & =\\frac{0-4}{0+2} \\\\  & =-2.\\end{aligned}\n$$"} :step/id #uuid "0796118c-90f3-59dc-9c5f-bed198c5fe51" :step/next {:db/id #edb/ref 17592186572769}} {:db/id #edb/ref 17592186572769 :step/content {:db/id #edb/ref 17592186572665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44fc1e65-39b7-53d3-8c38-1cf0053850be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186572400} {:answer/id #uuid "760f0c51-eb09-5ae7-863a-50b68e94109a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186572449} {:answer/id #uuid "91881f5a-186b-5d3f-97c9-7622ea19b498" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186572472} {:answer/id #uuid "d59bae02-6f8d-59be-922b-a8707a090036" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186572552} {:answer/id #uuid "dfef8bf6-a200-5160-b0c0-0fc8f8a3312c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186572561}] :answer-field/correct {:db/id #edb/ref 17592186572561} :answer-field/id #uuid "c166c720-f30f-53d5-b633-d02350cfb530" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572643}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0496054d-648c-503a-af82-71aac17fd7ca" :question/math-academy-id "q-67981" :question/problem "Evaluate ${lim}_{x\\to -1}\\frac{{x}^{2}-2x-3}{{x}^{2}-1}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{{x}^{2}-2x-3}{{x}^{2}-1} & =\\frac{(-1)^{2}-2(-1)-3}{(-1)^{2}-1}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-2x-3}{{x}^{2}-1} & =\\frac{(x+1)(x-3)}{(x-1)(x+1)} \\\\  & =\\frac{x-3}{x-1}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{{x}^{2}-2x-3}{{x}^{2}-1} & ={lim}_{x\\to -1}\\frac{x-3}{x-1} \\\\  & =\\frac{-1-3}{-1-1} \\\\  & =\\frac{-4}{-2} \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "68972858-a460-50bc-a8a4-057bf06d32dd" :step/next {:db/id #edb/ref 17592186572788}} {:db/id #edb/ref 17592186572788 :step/content {:db/id #edb/ref 17592186572697 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15098472-7d00-5b55-9d69-49c413adaaef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Does not exist" :db/id #edb/ref 17592186572339} {:answer/id #uuid "40e6c1f3-a022-5a8d-9468-6645788684f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{18}{5}" :db/id #edb/ref 17592186572391} {:answer/id #uuid "64ba839f-a12f-57b7-8daf-7af8a737912a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186572435} {:answer/id #uuid "6bad7f3c-66cb-5a2b-a2bb-6ac8015817b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186572441} {:answer/id #uuid "6ff234b9-3d6c-566d-84d6-2fca579d2ca0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186572445}] :answer-field/correct {:db/id #edb/ref 17592186572435} :answer-field/id #uuid "8d7ede5a-d5a6-5e6e-9812-54ef505e6966" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572628}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7acf7423-e8b7-5b28-a3d4-100be04f8153" :question/math-academy-id "q-107050" :question/problem "Evaluate ${lim}_{y\\to 3}\\frac{{y}^{3}-9y}{{y}^{2}-5y+6}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{y\\to 3}\\frac{{y}^{3}-9y}{{y}^{2}-5y+6} & =\\frac{{3}^{3}-9(3)}{{3}^{2}-5(3)+6}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{y}^{3}-9y}{{y}^{2}-5y+6} & =\\frac{y({y}^{2}-9)}{(y-2)(y-3)} \\\\  & =\\frac{y(y-3)(y+3)}{(y-2)(y-3)} \\\\  & =\\frac{y(y+3)}{(y-2)}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{y\\to 3}\\frac{{y}^{3}-9y}{{y}^{2}-5y+6} & ={lim}_{y\\to 3}\\frac{y(y+3)}{y-2} \\\\  & =\\frac{3(3+3)}{3-2} \\\\  & =18.\\end{aligned}\n$$"} :step/id #uuid "b2aabd23-f3ac-5637-91ae-b0a3e28457d3"}] :activity/title "Calculating Limits of Rational Functions by Factoring" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186572312}]}
