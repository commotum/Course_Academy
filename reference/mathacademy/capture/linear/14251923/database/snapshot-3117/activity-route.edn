#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186572732} :activity/id #uuid "cafdccd2-ff8f-57a4-83bf-a3c65b815967" :activity/scope {:db/id #edb/ref 17592186049927 :topic/id #uuid "1f1f7b83-a1f4-5b1c-888f-a20ae593bd72" :topic/math-academy-id 1813} :activity/steps [{:db/id #edb/ref 17592186572732 :step/content {:db/id #edb/ref 17592186572728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2daf76a0-8500-574d-afca-1701571dfa88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty" :db/id #edb/ref 17592186572370} {:answer/id #uuid "3a948208-572a-5fd8-9cc1-d9a5ab2b4a9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186572385} {:answer/id #uuid "74947654-7873-5a49-873e-6e8a7c42d1c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186572448} {:answer/id #uuid "b0943d78-afb5-5b99-822e-4d82efc4099b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186572512} {:answer/id #uuid "f33d6f17-9ed5-585c-ab3c-2a4e63e824bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186572581}] :answer-field/correct {:db/id #edb/ref 17592186572581} :answer-field/id #uuid "5de46a5c-045a-5a65-93fe-1ee8641452b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572618}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f8c786dd-8e95-5f38-8555-c19baa5a85a4" :question/math-academy-id "q-48388" :question/problem "Evaluate ${lim}_{x\\to 0}\\frac{9{x}^{3}-4x}{3{x}^{2}+2x}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{9{x}^{3}-4x}{3{x}^{2}+2x} & =\\frac{9(0)^{3}-4(0)}{3(0)^{2}+2(0)}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{9{x}^{3}-4x}{3{x}^{2}+2x} & =\\frac{x(9{x}^{2}-4)}{x(3x+2)} \\\\  & =\\frac{9{x}^{2}-4}{3x+2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{9{x}^{3}-4x}{3{x}^{2}+2x} & ={lim}_{x\\to 0}\\frac{9{x}^{2}-4}{3x+2} \\\\  & =\\frac{0-4}{0+2} \\\\  & =-2.\\end{aligned}\n$$"} :step/id #uuid "0796118c-90f3-59dc-9c5f-bed198c5fe51" :step/next {:db/id #edb/ref 17592186572769}} {:db/id #edb/ref 17592186572769 :step/content {:db/id #edb/ref 17592186572665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44fc1e65-39b7-53d3-8c38-1cf0053850be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186572400} {:answer/id #uuid "760f0c51-eb09-5ae7-863a-50b68e94109a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186572449} {:answer/id #uuid "91881f5a-186b-5d3f-97c9-7622ea19b498" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186572472} {:answer/id #uuid "d59bae02-6f8d-59be-922b-a8707a090036" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186572552} {:answer/id #uuid "dfef8bf6-a200-5160-b0c0-0fc8f8a3312c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186572561}] :answer-field/correct {:db/id #edb/ref 17592186572561} :answer-field/id #uuid "c166c720-f30f-53d5-b633-d02350cfb530" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572643}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0496054d-648c-503a-af82-71aac17fd7ca" :question/math-academy-id "q-67981" :question/problem "Evaluate ${lim}_{x\\to -1}\\frac{{x}^{2}-2x-3}{{x}^{2}-1}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{{x}^{2}-2x-3}{{x}^{2}-1} & =\\frac{(-1)^{2}-2(-1)-3}{(-1)^{2}-1}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-2x-3}{{x}^{2}-1} & =\\frac{(x+1)(x-3)}{(x-1)(x+1)} \\\\  & =\\frac{x-3}{x-1}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{{x}^{2}-2x-3}{{x}^{2}-1} & ={lim}_{x\\to -1}\\frac{x-3}{x-1} \\\\  & =\\frac{-1-3}{-1-1} \\\\  & =\\frac{-4}{-2} \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "68972858-a460-50bc-a8a4-057bf06d32dd" :step/next {:db/id #edb/ref 17592186572788}} {:db/id #edb/ref 17592186572788 :step/content {:db/id #edb/ref 17592186572697 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15098472-7d00-5b55-9d69-49c413adaaef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Does not exist" :db/id #edb/ref 17592186572339} {:answer/id #uuid "40e6c1f3-a022-5a8d-9468-6645788684f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{18}{5}" :db/id #edb/ref 17592186572391} {:answer/id #uuid "64ba839f-a12f-57b7-8daf-7af8a737912a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186572435} {:answer/id #uuid "6bad7f3c-66cb-5a2b-a2bb-6ac8015817b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186572441} {:answer/id #uuid "6ff234b9-3d6c-566d-84d6-2fca579d2ca0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186572445}] :answer-field/correct {:db/id #edb/ref 17592186572435} :answer-field/id #uuid "8d7ede5a-d5a6-5e6e-9812-54ef505e6966" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572628}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7acf7423-e8b7-5b28-a3d4-100be04f8153" :question/math-academy-id "q-107050" :question/problem "Evaluate ${lim}_{y\\to 3}\\frac{{y}^{3}-9y}{{y}^{2}-5y+6}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{y\\to 3}\\frac{{y}^{3}-9y}{{y}^{2}-5y+6} & =\\frac{{3}^{3}-9(3)}{{3}^{2}-5(3)+6}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{y}^{3}-9y}{{y}^{2}-5y+6} & =\\frac{y({y}^{2}-9)}{(y-2)(y-3)} \\\\  & =\\frac{y(y-3)(y+3)}{(y-2)(y-3)} \\\\  & =\\frac{y(y+3)}{(y-2)}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{y\\to 3}\\frac{{y}^{3}-9y}{{y}^{2}-5y+6} & ={lim}_{y\\to 3}\\frac{y(y+3)}{y-2} \\\\  & =\\frac{3(3+3)}{3-2} \\\\  & =18.\\end{aligned}\n$$"} :step/id #uuid "b2aabd23-f3ac-5637-91ae-b0a3e28457d3"}] :activity/title "Calculating Limits of Rational Functions by Factoring" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186572312}]}
