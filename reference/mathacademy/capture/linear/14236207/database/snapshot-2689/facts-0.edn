592186045417] [17592186084056 #edb/ref 1061 165069 #edb/ref 17592186045417] [17592186084056 #edb/ref 1062 #uuid "1966fcb5-717e-5b45-9abe-201766bc8fde" #edb/ref 17592186045417] [17592186084056 #edb/ref 1063 #edb/ref 17592186084524 #edb/ref 17592186045417] [17592186084057 #edb/ref 1058 #edb/ref 17592186084058 #edb/ref 17592186045417] [17592186084057 #edb/ref 1061 165070 #edb/ref 17592186045417] [17592186084057 #edb/ref 1062 #uuid "1784759d-26b3-5648-a44f-50a904305f4f" #edb/ref 17592186045417] [17592186084057 #edb/ref 1063 #edb/ref 17592186083186 #edb/ref 17592186045417] [17592186084058 #edb/ref 1058 #edb/ref 17592186084059 #edb/ref 17592186045417] [17592186084058 #edb/ref 1061 165073 #edb/ref 17592186045417] [17592186084058 #edb/ref 1062 #uuid "66d8a122-58d0-5a8d-bafa-0181de8ba10e" #edb/ref 17592186045417] [17592186084058 #edb/ref 1063 #edb/ref 17592186083187 #edb/ref 17592186045417] [17592186084059 #edb/ref 1061 165076 #edb/ref 17592186045417] [17592186084059 #edb/ref 1062 #uuid "4ee667dd-7fbf-5534-8753-ffdacf304f5b" #edb/ref 17592186045417] [17592186084059 #edb/ref 1063 #edb/ref 17592186083188 #edb/ref 17592186045417] [17592186084524 #edb/ref 1064 "To determine the axis of symmetry of the parabola $y=ax^2+bx+c,$ we can use the following formula:\n\n$$\nx=-\\dfrac{b}{2a}\n$$\n\nWe'll derive this result in a separate lesson. For now, let's get some practice working with it. \n\nSuppose we want to find the axis of symmetry of the function $y=3x^2-6x+1.$ To do this, we substitute $a=3$ and $b=-6$ into the above formula, as follows:\n\n$$\n\\begin{aligned}x & =-\\frac{b}{2a} \\\\  & =-\\frac{(-6)}{2(3)} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, $x=1$ is the equation of the axis of symmetry. \n\n![](images/88/88ee917eb387ee60e67080785519ffe9cb4333adcd602a733659d0447c37f61a.png)\n\nThe vertex of the parabola lies on the axis of symmetry, so $x=1$ also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we can substitute $x=1$ into the original equation:\n\n$$\n\\begin{aligned}y & =3{x}^{2}-6x+1 \\\\  & =3(1)^{2}-6(1)+1 \\\\  & =3-6+1 \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the vertex is at $(1,-2).$\n\n![](images/a3/a391338ffb2bddd2a58b836e328c574d348215c518b27d9886ca11a21674943a.png)" #edb/ref 17592186045417] [17592186084524 #edb/ref 1065 9241 #edb/ref 17592186045417] [17592186084524 #edb/ref 1066 #uuid "bfd0e6a4-644a-50b6-91df-852343ebd41e" #edb/ref 17592186045417] [17592186084524 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186554990 #edb/ref 1043 #edb/ref 17592186555919 #edb/ref 17592186045417] [17592186554990 #edb/ref 1043 #edb/ref 17592186555939 #edb/ref 17592186045417] [17592186554990 #edb/ref 1043 #edb/ref 17592186555945 #edb/ref 17592186045417] [17592186554990 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186554990 #edb/ref 1045 "The Axis of Symmetry of a Parabola" #edb/ref 17592186045417] [17592186554990 #edb/ref 1046 #edb/ref 17592186555939 #edb/ref 17592186045417] [17592186554990 #edb/ref 1048 #edb/ref 17592186046647 #edb/ref 17592186045417] [17592186554990 #edb/ref 1049 #edb/ref 17592186048398 #edb/ref 17592186045417] [17592186554990 #edb/ref 1053 #uuid "2aedf8e5-8934-58a3-922c-e425fd7146f3" #edb/ref 17592186045417] [17592186555006 #edb/ref 1080 "(2,38)" #edb/ref 17592186045417] [17592186555006 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186555006 #edb/ref 1083 #uuid "010f0520-1f81-5417-8d63-763acd75346e" #edb/ref 17592186045417] [17592186555039 #edb/ref 1080 "-4" #edb/ref 17592186045417] [17592186555039 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186555039 #edb/ref 1083 #uuid "140d1a26-6c40-56b2-a7aa-06cc13939aeb" #edb/ref 17592186045417] [17592186555057 #edb/ref 1080 "(-2,-10)" #edb/ref 17592186045417] [17592186555057 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186555057 #edb/ref 1083 #uuid "1f564bb1-e463-51e8-a110-610f5d826505" #edb/ref 17592186045417] [17592186555087