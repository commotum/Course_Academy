6045417] [17592186555722 #edb/ref 1075 #edb/ref 17592186555611 #edb/ref 17592186045417] [17592186555722 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186555722 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186555722 #edb/ref 1078 #edb/ref 17592186555611 #edb/ref 17592186045417] [17592186555722 #edb/ref 1079 #uuid "a9f334df-9edf-56f6-b904-ca6fc39afbf1" #edb/ref 17592186045417] [17592186555728 #edb/ref 1075 #edb/ref 17592186555006 #edb/ref 17592186045417] [17592186555728 #edb/ref 1075 #edb/ref 17592186555057 #edb/ref 17592186045417] [17592186555728 #edb/ref 1075 #edb/ref 17592186555124 #edb/ref 17592186045417] [17592186555728 #edb/ref 1075 #edb/ref 17592186555378 #edb/ref 17592186045417] [17592186555728 #edb/ref 1075 #edb/ref 17592186555600 #edb/ref 17592186045417] [17592186555728 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186555728 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186555728 #edb/ref 1078 #edb/ref 17592186555378 #edb/ref 17592186045417] [17592186555728 #edb/ref 1079 #uuid "b6b01d69-c2df-5fe3-b016-c551c810194f" #edb/ref 17592186045417] [17592186555786 #edb/ref 1068 #edb/ref 17592186555705 #edb/ref 17592186045417] [17592186555786 #edb/ref 1069 "q-30392" #edb/ref 17592186045417] [17592186555786 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186555786 #edb/ref 1071 "The axis of symmetry of the parabola $y=k{x}^{2}+3x-15$ is $x=4.$ Find the value of $k.$" #edb/ref 17592186045417] [17592186555786 #edb/ref 1072 #uuid "35646e02-dadb-58eb-b337-8ae59fb6fd33" #edb/ref 17592186045417] [17592186555786 #edb/ref 1074 "First, we will calculate the axis of symmetry in terms of $k.$ Then, we will set our result equal to $4.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=k$ and $b=3$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{3}{2(k)} \\\\  & =-\\frac{3}{2k}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=4,$ so we must have\n\n$$\n\\begin{aligned}-\\frac{3}{2k} & =4 \\\\ -3 & =8k \\\\ k & =-\\frac{3}{8}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186555846 #edb/ref 1068 #edb/ref 17592186555728 #edb/ref 17592186045417] [17592186555846 #edb/ref 1069 "q-30451" #edb/ref 17592186045417] [17592186555846 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186555846 #edb/ref 1071 "Find the coordinates of the vertex of the parabola $y=2{x}^{2}+12x+6.$" #edb/ref 17592186045417] [17592186555846 #edb/ref 1072 #uuid "aa0495c1-850f-5f82-bb9f-fd1f7fa6ce97" #edb/ref 17592186045417] [17592186555846 #edb/ref 1074 "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=2$ and $b=12$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{12}{2(2)} \\\\  & =-\\frac{12}{4} \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-3.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=-3$ into the original equation:\n\n$$\n\\begin{aligned}y & =2{x}^{2}+12x+6 \\\\  & =2(-3)^{2}+12(-3)+6 \\\\  & =18-36+6 \\\\  & =-12\\end{aligned}\n$$\n\nTherefore, the vertex is at $(-3,-12).$" #edb/ref 17592186045417] [17592186555853 #edb/ref 1068 #edb/ref 17592186555722 #edb/ref 17592186045417] [17592186555853 #edb/ref 1069 "q-30452" #edb/ref 17592186045417] [17592186555853 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186555853 #edb/ref 1071 "Find the coordinates of the vertex of the parabola $y=4{x}^{2}-2x+1.$" #edb/ref 17592186045417] [17592186555853 #edb/ref 1072 #uuid "c47ad7a3-3c57-54bc-8711-6eebfda1e26f" #edb/ref 17592186045417] [17592186555853 #edb/ref 1074 "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=4$ and $b=-2$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{-2}{2(4)} \\\\  & =-\\frac{-2}{8} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=\\frac{1}{4}.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=\\frac{1}{4}$ into the original equation:\n\n$$\n\\begin{aligned}y & =4{x}^{2}-2x+1 \\\\  & =4{(\\frac{1}{4})}^{2}-2(\\frac{1}{4})+1 \\\\  & =\\frac{1}{4}-\\frac{1}{2}+1 \\\\  & =\\frac{1}{4}-\\frac{2}{4}+\\frac{4}{4} \\\\  & =\\frac{3}{4}\\end{aligned}\n$$\n\nTherefore, the vertex is at $(\\frac{1}{4},\\frac{3}{4}).$" #edb/ref 17592186045417] [17592186555919 #edb/ref 1058 #edb/ref 17592186555945 #edb/ref 17592186045417] [17592186555919 #edb/ref 1062 #uuid "800c1a08-8dd6-5f55-92e4-df70f0fce894" #edb/ref 17592186045417] [17592186555919 #edb/ref 1063 #edb/ref 17592186555846 #edb/ref 17592186045417] [17592186555939 #edb/ref 1058 #edb/ref 17592186555919 #edb/ref 17592186045417] [17592186555939 #edb/ref 1062 #uuid "ce67b857-f176-5873-ba8a-87814b9af6a7" #edb/ref 17592186045417] [17592186555939 #edb/ref 1063 #edb/ref 17592186555786 #edb/ref 17592186045417] [17592186555945 #edb/ref 1062 #uuid "d9a1c56e-6c1b-5141-9c3c-939ad62ac505" #edb/ref 17592186045417] [17592186555945 #edb/ref 1063 #edb/ref 17592186555853 #edb/ref 17592186045417]}
