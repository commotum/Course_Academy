#{[{:db/id #edb/ref 17592186110292 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110671 :knowledge-point/id #uuid "3e8c4c24-2d04-5fd1-a9f4-6f1abb25c255" :knowledge-point/title "Finding the Measure of a Smaller Angle"}] :question/id #uuid "d4240cff-2c48-520b-a11a-f6838c163a17" :question/math-academy-id "e-10594" :question/problem "The measure of the angle $\\angle BAD$ is ${90}^{\\circ}.$ Find the value of $x.$\n\n![](images/f4/f41802149d3e2a8524a47123e6de1bb6aa68e480cf54aafd756085ad52355ede.png)" :question/worked-solution "Here, the letter $x$ represents the measure of the unknown angle $\\angle CAD.$\n\nNote the following:\n\n- The angles $\\angle BAC$ and $\\angle CAD$ are adjacent because they share the side $\\overrightarrow{AC}.$\n\n- So, the measure of the *large* angle $(\\angle BAD)$ must be the *sum* of the measures of the two *smaller* angles $(\\angle BAC$ and $\\angle CAD).$\n\n- This means that the measure of $\\angle CAD$ must be the *difference* between the large angle $(\\angle BAD)$ and the smaller known angle $(\\angle BAC).$\n\nTherefore,\n\n$$\nx = 90^\\circ - 35^\\circ = 55^\\circ.\n$$"}] [{:db/id #edb/ref 17592186110381 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110748 :knowledge-point/id #uuid "782a6a0a-7a15-5230-8f9d-5405aa72f96a" :knowledge-point/title "Finding the Measure of a Combined Angle"}] :question/id #uuid "361d828c-ec57-5baa-81c6-321e0dc723e2" :question/math-academy-id "e-2577" :question/problem "In the figure below, determine $m\\angle{POR}.$\n\n![](images/0b/0bb38727216cc66882b7ed55fa59c3c700243ad18eb035a3e19a73eeffa81a2a.png)" :question/worked-solution "![](images/70/70bb672243a7689bd08c2d03ebe19570fdb148182dd7b5137da5be4b91724f03.png)\n\nFirst, notice that $\\angle{POQ}$ and $\\angle{QOR}$ are adjacent because they share the same side $\\overrightarrow{OQ}.$\n\nWe can add the measures of two adjacent angles to find the measure of the combined angle.\n\nTherefore: \n\n$$\n\\begin{aligned}m∠POR & =m∠POQ+m∠QOR \\\\  & ={68}^{∘}+{37}^{∘} \\\\  & ={105}^{∘}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110382 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110750 :knowledge-point/id #uuid "c59421f9-a1af-59d9-aa89-16cd2d13d332" :knowledge-point/title "Finding the Measure of an Unknown Angle Using the Extended Rule"}] :question/id #uuid "4ad9432d-82fc-58e6-b586-f16474fa18f3" :question/math-academy-id "e-2578" :question/problem "In the figure below, $m \\angle BAE = {110}^{\\circ}.$ Find the value of $x.$\n\n![](images/24/245dbaa430eb99aee193110fcd6df2844cfd7cffd2363c561337ac74d18a1fb5.png)" :question/worked-solution "Here, the letter $x$ represents the measure of the unknown angle $\\angle CAD.$\n\nThe measure of $\\angle CAD$ must be the *difference* between the large angle $(\\angle BAE)$ and the two smaller known angles $(\\angle BAC$ and $\\angle DAE).$\n\nTherefore, \n\n$$\nx = 110^\\circ - 40^\\circ - 20^\\circ = 50^\\circ.\n$$"}] [{:db/id #edb/ref 17592186111276 :knowledge-point/_questions [{:db/id #edb/ref 17592186110748 :knowledge-point/id #uuid "782a6a0a-7a15-5230-8f9d-5405aa72f96a" :knowledge-point/title "Finding the Measure of a Combined Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9440095b-ce7e-56d7-be71-f85a97aa5a70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75^{∘}" :db/id #edb/ref 17592186109382} {:answer/id #uuid "a873e243-4671-5229-89bf-7f80a4a67207" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "74^{∘}" :db/id #edb/ref 17592186109383} {:answer/id #uuid "fea35ad1-2b4d-592f-94f3-17fa4fdf50d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80^{∘}" :db/id #edb/ref 17592186109384} {:answer/id #uuid "1dcb5787-bb5f-571d-bd99-3c87aec78d7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "78^{∘}" :db/id #edb/ref 17592186109385} {:answer/id #uuid "30bcf295-564d-50b2-8d06-1782e831ce3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "82^{∘}" :db/id #edb/ref 17592186109386}] :answer-field/id #uuid "873bc689-a7e7-5413-a60b-d78d8191f318" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109381}] :question/id #uuid "915b9cd0-2037-5441-8562-105770a85a47" :question/math-academy-id "q-53140" :question/problem "![](images/85/850013d06343c35d1bc102be741e0061214bc66abf479167141da1ec4fd8c82f.png)\n\nIn the figure above, find $m∠AOC$."}]}
