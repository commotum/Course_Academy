:$\n\n$$\n\\begin{aligned}m∠POR & =m∠POQ+m∠QOR \\\\  & ={45}^{∘}+{65}^{∘} \\\\  & ={110}^{∘}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b9002bc1-78a6-565b-92e9-6d7ba056ce6b"] :db/ensure [:question/validate]} {:db/id "answer-field-b9002bc1-78a6-565b-92e9-6d7ba056ce6b" :answer-field/id #uuid "b9002bc1-78a6-565b-92e9-6d7ba056ce6b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d537e57c-90be-562b-b367-68ce5cd0150e" :answer-field/choices ["answer-f24c8cba-6ba0-5e2f-8d8b-2b6208716638" "answer-2014ad3b-af18-5cbf-9a7b-23ff3020c880" "answer-d537e57c-90be-562b-b367-68ce5cd0150e" "answer-e4fc0cfb-faea-58f7-904e-fa6bf4cd9de2" "answer-0cc3b37d-ee9e-561a-a603-10bed87792b9"] :db/ensure [:answer-field/validate]} {:db/id "answer-f24c8cba-6ba0-5e2f-8d8b-2b6208716638" :answer/id #uuid "f24c8cba-6ba0-5e2f-8d8b-2b6208716638" :answer/type :answer.type/math :answer/value "{100}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-2014ad3b-af18-5cbf-9a7b-23ff3020c880" :answer/id #uuid "2014ad3b-af18-5cbf-9a7b-23ff3020c880" :answer/type :answer.type/math :answer/value "{105}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-d537e57c-90be-562b-b367-68ce5cd0150e" :answer/id #uuid "d537e57c-90be-562b-b367-68ce5cd0150e" :answer/type :answer.type/math :answer/value "{110}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-e4fc0cfb-faea-58f7-904e-fa6bf4cd9de2" :answer/id #uuid "e4fc0cfb-faea-58f7-904e-fa6bf4cd9de2" :answer/type :answer.type/math :answer/value "{115}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-0cc3b37d-ee9e-561a-a603-10bed87792b9" :answer/id #uuid "0cc3b37d-ee9e-561a-a603-10bed87792b9" :answer/type :answer.type/math :answer/value "{120}^{∘}" :db/ensure [:answer/validate]}]
