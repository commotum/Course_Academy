ure of the *large* angle $(∠LON)$ must be the *sum* of the measures of the two *smaller* angles $(∠LOM$ and $∠MON).$\n\n- This means that the measure of $∠MON$ must be the *difference* between the large angle $(∠LON)$ and the smaller known angle $(∠LOM).$\n\nTherefore, the correct equation to determine $x$ is the following:\n\n$$\nx={75}^{∘}-{30}^{∘}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-692760d2-82f6-5a6d-96f5-c4002798edfa"] :db/ensure [:question/validate]} {:db/id "answer-field-692760d2-82f6-5a6d-96f5-c4002798edfa" :answer-field/id #uuid "692760d2-82f6-5a6d-96f5-c4002798edfa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f8938f21-38c2-5de7-b34e-4354ae6a27e9" :answer-field/choices ["answer-ed189ece-e96b-5b2d-bb0f-eebcd71fa8c9" "answer-99e12a41-9481-5e9b-95dd-bd52b9d3c141" "answer-d5623039-c6f8-5229-a5e5-b42ca9bf909e" "answer-f8938f21-38c2-5de7-b34e-4354ae6a27e9" "answer-1b2a3aad-85e3-5fb4-829b-3d11835d963a"] :db/ensure [:answer-field/validate]} {:db/id "answer-ed189ece-e96b-5b2d-bb0f-eebcd71fa8c9" :answer/id #uuid "ed189ece-e96b-5b2d-bb0f-eebcd71fa8c9" :answer/type :answer.type/math :answer/value "x={50}^{∘}+{20}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-99e12a41-9481-5e9b-95dd-bd52b9d3c141" :answer/id #uuid "99e12a41-9481-5e9b-95dd-bd52b9d3c141" :answer/type :answer.type/math :answer/value "x={75}^{∘}+{30}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-d5623039-c6f8-5229-a5e5-b42ca9bf909e" :answer/id #uuid "d5623039-c6f8-5229-a5e5-b42ca9bf909e" :answer/type :answer.type/math :answer/value "x={75}^{∘}-{20}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-f8938f21-38c2-5de7-b34e-4354ae6a27e9" :answer/id #uuid "f8938f21-38c2-5de7-b34e-4354ae6a27e9" :answer/type :answer.type/math :answer/value "x={75}^{∘}-{30}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-1b2a3aad-85e3-5fb4-829b-3d11835d963a" :answer/id #uuid "1b2a3aad-85e3-5fb4-829b-3