#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111724} :activity/id #uuid "a3c6b50b-17b0-55fa-aa1d-2127b664fc63" :activity/scope {:db/id #edb/ref 17592186050494 :topic/id #uuid "4db79817-fed4-5680-ad8d-2788d5ed4038" :topic/math-academy-id 1505} :activity/steps [{:db/id #edb/ref 17592186111590 :step/content {:db/id #edb/ref 17592186111899 :tutorial/content "We can extend our rule relating sums of adjacent angles to more than two angles.\n\nFor example, let's consider the angles shown in the diagram below.\n\n![](images/32/3264d0ab1a40b02915a737dad57e9f26820193d9bdc6b42431ec1ab6508cc523.png)\n\nAccording to our rule, the measure of the reflex angle $\\angle QST$ is\n\n$$\n\\begin{aligned}m∠QST & ={{m∠QSP}_{⏟}}_{\\text{green angle}}+{{m∠PSR}_{⏟}}_{\\text{orange angle}}+{{m∠RST}_{⏟}}_{\\text{blue angle}} \\\\  & ={100}^{∘}+{95}^{∘}+{45}^{∘} \\\\  & ={240}^{∘}.\\end{aligned}\n$$\n\nWe can also use this rule to determine the size of a smaller angle when we know a larger one. Let's see an example." :tutorial/id #uuid "ed758074-8bf2-5fa7-a897-7d4e08bc5413" :tutorial/math-academy-id 5701 :tutorial/title "Extending the Sums of Angles Rule"} :step/id #uuid "168e13db-19fd-5150-9315-8ec1bd908530" :step/math-academy-id 34985 :step/next {:db/id #edb/ref 17592186111729}} {:db/id #edb/ref 17592186111610 :step/content {:db/id #edb/ref 17592186110671 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110292 :question/id #uuid "d4240cff-2c48-520b-a11a-f6838c163a17" :question/math-academy-id "e-10594"} :knowledge-point/id #uuid "3e8c4c24-2d04-5fd1-a9f4-6f1abb25c255" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049802} {:db/id #edb/ref 17592186050861}] :knowledge-point/questions [{:db/id #edb/ref 17592186110920} {:db/id #edb/ref 17592186110927} {:db/id #edb/ref 17592186432454} {:db/id #edb/ref 17592186432456} {:db/id #edb/ref 17592186432459} {:db/id #edb/ref 17592186432463} {:db/id #edb/ref 17592186434921} {:db/id #edb/ref 17592186434922} {:db/id #edb/ref 17592186434923} {:db/id #edb/ref 17592186434924} {:db/id #edb/ref 17592186434932}] :knowledge-point/title "Finding the Measure of a Smaller Angle"} :step/id #uuid "f946459e-27fe-5d63-8cb0-e5bef1bfeae2" :step/math-academy-id 40051 :step/next {:db/id #edb/ref 17592186111590}} {:db/id #edb/ref 17592186111724 :step/content {:db/id #edb/ref 17592186111836 :tutorial/content "When two angles share a common side, they are called **adjacent** angles. When two angles are adjacent, we can add their measures to find the measure of the larger angle. \n\nFor example, consider the diagram below.\n\n![](images/f5/f562f3505de0dd2345b29e2baabaf51a7885cbccb5d95e6201b8bc9aec1b1986.png)\n\nThe angles $\\angle PSR$ and $\\angle RST$ are adjacent because they both have the side $\\overrightarrow{SR}$ in common.\n\nSince the angles $\\angle PSR$ and $\\angle RST$ are adjacent, we can find the measure of the combined angle $\\angle PST$ by adding the two angles:\n\n$$\n\\begin{aligned}m∠PST & ={{m∠PSR}_{⏟}}_{\\text{orange angle}}+{{m∠RST}_{⏟}}_{\\text{blue angle}} \\\\  & ={95}^{∘}+{45}^{∘} \\\\  & ={140}^{∘}\\end{aligned}\n$$" :tutorial/id #uuid "2f387075-8fbb-5e3e-9370-8b93f5e8523e" :tutorial/math-academy-id 2177 :tutorial/title "Introduction"} :step/id #uuid "e5bccd87-45fe-5b00-91e1-b4f266423fdd" :step/math-academy-id 8743 :step/next {:db/id #edb/ref 17592186111725}} {:db/id #edb/ref 17592186111725 :step/content {:db/id #edb/ref 17592186110748 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110381 :question/id #uuid "361d828c-ec57-5baa-81c6-321e0dc723e2" :question/math-academy-id "e-2577"} :knowledge-point/id #uuid "782a6a0a-7a15-5230-8f9d-5405aa72f96a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048587} {:db/id #edb/ref 17592186048959}] :knowledge-point/questions [{:db/id #edb/ref 17592186110954} {:db/id #edb/ref 17592186111276} {:db/id #edb/ref 17592186432453} {:db/id #edb/ref 17592186432455} {:db/id #edb/ref 17592186432457} {:db/id #edb/ref 17592186432461} {:db/id #edb/ref 17592186434925} {:db/id #edb/ref 17592186434928} {:db/id #edb/ref 17592186434931} {:db/id #edb/ref 17592186434933}] :knowledge-point/title "Finding the Measure of a Combined Angle"} :step/id #uuid "5e2a85a2-9024-5643-baf3-fdaaf3ccfcf3" :step/math-academy-id 8744 :step/next {:db/id #edb/ref 17592186111610}} {:db/id #edb/ref 17592186111729 :step/content {:db/id #edb/ref 17592186110750 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110382 :question/id #uuid "4ad9432d-82fc-58e6-b586-f16474fa18f3" :question/math-academy-id "e-2578"} :knowledge-point/id #uuid "c59421f9-a1af-59d9-aa89-16cd2d13d332" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049516}] :knowledge-point/questions [{:db/id #edb/ref 17592186111277} {:db/id #edb/ref 17592186111278} {:db/id #edb/ref 17592186432458} {:db/id #edb/ref 17592186432460} {:db/id #edb/ref 17592186432462} {:db/id #edb/ref 17592186432464} {:db/id #edb/ref 17592186434920} {:db/id #edb/ref 17592186434926} {:db/id #edb/ref 17592186434927} {:db/id #edb/ref 17592186434929} {:db/id #edb/ref 17592186434930}] :knowledge-point/title "Finding the Measure of an Unknown Angle Using the Extended Rule"} :step/id #uuid "7fb4b7de-56d8-52a6-8f79-0bd1ed01d553" :step/math-academy-id 8749}] :activity/title "Sums of Angles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110861}]}
