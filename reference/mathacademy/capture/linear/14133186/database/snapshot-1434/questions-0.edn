id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{115}^{∘}" :db/id #edb/ref 17592186434865} {:answer/id #uuid "83e4e69f-16f7-56ba-b97e-be7f71df9ab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{103}^{∘}" :db/id #edb/ref 17592186434872} {:answer/id #uuid "c677dcfe-caac-520c-acd6-d5d2227f1cba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{124}^{∘}" :db/id #edb/ref 17592186434889}] :answer-field/correct {:answer/id #uuid "5fdac38a-7cec-58d8-90c1-1e652d1486e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{120}^{∘}" :db/id #edb/ref 17592186434861} :answer-field/id #uuid "1bb6f675-7bc6-54c2-a8f2-c971974cf7ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434906}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2f7aabf-f781-5516-8215-5f6f4e267c7c" :question/math-academy-id "q-150761" :question/problem "![](images/39/39e491930076760f06a77929e4264d41ba3f921db918fb34dd49772036ad09d5.png)\n\nIn the figure above, find $m∠QOS.$" :question/worked-solution "![](images/53/537b98b49691a55102fd5c1d06f6635f770118113b3535e8c1238f169b2e4dfb.png)\n\nFirst, notice that $∠QOR$ and $∠ROS$ are adjacent because they share the same side $\\overset{\\to }{OR}.$\n\nWe can add the measures of two adjacent angles to find the measure of the combined angle.\n\nTherefore: \n\n$$\n\\begin{aligned}m∠QOS & =m∠QOR+m∠ROS \\\\  & ={79}^{∘}+{41}^{∘} \\\\  & ={120}^{∘}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186434923 :knowledge-point/_questions [{:db/id #edb/ref 17592186110671 :knowledge-point/id #uuid "3e8c4c24-2d04-5fd1-a9f4-6f1abb25c255" :knowledge-point/title "Finding the Measure of a Smaller Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "130c6f21-6857-55ea-88a0-c147a7f849e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}-{80}^{∘}" :db/id #edb/ref 17592186434842} {:answer/id #uuid "24a6d6cf-caaa-5dcd-82d3-6c83523c1ae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={80}^{∘}\\times {60}^{∘}" :db/id #edb/ref 17592186434847} {:answer/id #uuid "3043ced3-a2ab-50d1-b509-fcfa0dbf92a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={80}^{∘}-{60}^{∘}" :db/id #edb/ref 17592186434849} {:answer/id #uuid "77d38efc-bde9-53cd-b3bb-70f61af956c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}+{80}^{∘}" :db/id #edb/ref 17592186434869} {:answer/id #uuid "db914ed6-3e30-5d19-9e0e-4b74a4177030" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={80}^{∘}+{60}^{∘}" :db/id #edb/ref 17592186434896}] :answer-field/correct {:answer/id #uuid "3043ced3-a2ab-50d1-b509-fcfa0dbf92a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={80}^{∘}-{60}^{∘}" :db/id #edb/ref 17592186434849} :answer-field/id #uuid "715ee9db-17c4-5381-a913-c1d6ed279307" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434911}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3e3d6990-d239-54ed-b94a-9738925e98e2" :question/math-academy-id "q-150762" :question/problem "![](images/46/46db75fc773bb1fbcb21817fe8371b855c8f9ac8a08e88134fa992dd68498982.png)\n\nIn the diagram above, $m∠BAD={80}^{∘}.$ What equation could be used to find the value of $x?$" :question/worked-solution "Here, the letter $x$ represents the measure of the unknown angle $∠BAC.$\n\nNote the following:\n\n- The angles $∠BAC$ and $∠CAD$ are adjacent because they share the side $\\overset{\\to }{AC}.$\n\n- So, the measure of the *large* angle $(∠BAD)$ must be the *sum* of the measures of the two *smaller* angles $(∠BAC$ and $∠CAD).$\n\n- This means that the measure of $∠BAC$ must be the *difference* between the large angle $(∠BAD)$ and the smaller known angle $(∠CAD).$\n\nTherefore, the correct equation to determine $x$ is the following:\n\n$$\nx={80}^{∘}-{60}^{∘}\n$$"}] [{:db/id #edb/ref 17592186434922 :knowledge-point/_questions [{:db/id #edb/ref 17592186110671 :knowledge-point/id #uuid "3e8c4c24-2d04-5fd1-a9f4-6f1abb25c255" :knowledge-point/title "Finding the Measure of a Smaller Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c80eb4b-c4d6-5e5b-a19d-efe4a9b59e2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={25}^{∘}-{90}^{∘}" :db/id #edb/ref 17592186434837} {:answer/id #uuid "20cde8dc-5569-53b9-ad42-37ced8ac948b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={25}^{∘}+{90}^{∘}" :db/id #edb/ref 17592186434846} {:answer/id #uuid "4c17bb3b-c189-555d-9e82-95710843f835" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}+{25}^{∘}" :db/id #edb/ref 17592186434853} {:answer/id #uuid "acf658b4-f2dc-58c6-8948-21604ed9cc51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}-{25}^{∘}" :db/id #edb/ref 17592186434882} {:answer/id #uuid "bacc36e7-a6b7-5561-bce3-dd5985eb384a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}\\times {25}^{∘}" :db/id #edb/ref 17592186434885}] :answer-field/correct {:answer/id #uuid "acf658b4-f2dc-58c6-8948-21604ed9cc51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}-{25}^{∘}" :db/id #edb/ref 17592186434882} :answer-field/id #uuid "d7440227-feac-59a0-9e4a-35264d9b1f5b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434919}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1ef518cd-3d3e-535b-ac4e-329668aadc31" :question/math-academy-id "q-150766" :question/problem "![](images/c4/c4c1194c822c34e02e73e130c2c39e99a98cb52b577c9d68be4c29554604fc0f.png)\n\nIn the diagram above, $m∠LON={90}^{∘}.$ What equation could be used to find the value of $x?$" :question/worked-solution "Here, the letter $x$ represents the measure of the unknown angle $∠LOM.$\n\nNote the following:\n\n- The angles $∠LOM$ and $∠MON$ are adjacent because they share the side $\\overset{\\to }{OM}.$\n\n- So, the measure of the *large* angle $(∠LON)$ must be the *sum* of the measures of the two *smaller* angles $(∠LOM$ and $∠MON).$\n\n- This means that the measure of $∠LOM$ must be the *difference* between the large angle $(∠LON)$ and the smaller known angle $(∠MON).$\n\nTherefore, the correct equation to determine $x$ is the following:\n\n$$\nx={90}^{∘}-{25}^{∘}\n$$"}] [{:db/id #edb/ref 17592186434921 :knowledge-point/_questions [{:db/id #edb/ref 17592186110671 :knowledge-point/id #uuid "3e8c4c24-2d04-5fd1-a9f4-6f1abb25c255" :knowledge-point/title "Finding the Measure of a Smaller Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f52bdda-aaff-584c-a790-064721aaf593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{40}^{∘}" :db/id #edb/ref 17592186434864} {:answer/id #uuid "ac48bdba-5314-554e-99d7-30221b9e0e74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{220}^{∘}" :db/id #edb/ref 17592186434881} {:answer/id #uuid "b9f6df9b-8204-5fea-9018-e827d986a3db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{100}^{∘}" :db/id #edb/ref 17592186434884} {:answer/id #uuid "e7c039d4-45f9-534a-9140-1280a148b8d9" :answer/type {:db/id #edb/ref 