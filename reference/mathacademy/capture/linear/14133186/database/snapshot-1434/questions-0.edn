#{[{:db/id #edb/ref 17592186110292 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110671 :knowledge-point/id #uuid "3e8c4c24-2d04-5fd1-a9f4-6f1abb25c255" :knowledge-point/title "Finding the Measure of a Smaller Angle"}] :question/id #uuid "d4240cff-2c48-520b-a11a-f6838c163a17" :question/math-academy-id "e-10594" :question/problem "The measure of the angle $\\angle BAD$ is ${90}^{\\circ}.$ Find the value of $x.$\n\n![](images/f4/f41802149d3e2a8524a47123e6de1bb6aa68e480cf54aafd756085ad52355ede.png)" :question/worked-solution "Here, the letter $x$ represents the measure of the unknown angle $\\angle CAD.$\n\nNote the following:\n\n- The angles $\\angle BAC$ and $\\angle CAD$ are adjacent because they share the side $\\overrightarrow{AC}.$\n\n- So, the measure of the *large* angle $(\\angle BAD)$ must be the *sum* of the measures of the two *smaller* angles $(\\angle BAC$ and $\\angle CAD).$\n\n- This means that the measure of $\\angle CAD$ must be the *difference* between the large angle $(\\angle BAD)$ and the smaller known angle $(\\angle BAC).$\n\nTherefore,\n\n$$\nx = 90^\\circ - 35^\\circ = 55^\\circ.\n$$"}] [{:db/id #edb/ref 17592186110381 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110748 :knowledge-point/id #uuid "782a6a0a-7a15-5230-8f9d-5405aa72f96a" :knowledge-point/title "Finding the Measure of a Combined Angle"}] :question/id #uuid "361d828c-ec57-5baa-81c6-321e0dc723e2" :question/math-academy-id "e-2577" :question/problem "In the figure below, determine $m\\angle{POR}.$\n\n![](images/0b/0bb38727216cc66882b7ed55fa59c3c700243ad18eb035a3e19a73eeffa81a2a.png)" :question/worked-solution "![](images/70/70bb672243a7689bd08c2d03ebe19570fdb148182dd7b5137da5be4b91724f03.png)\n\nFirst, notice that $\\angle{POQ}$ and $\\angle{QOR}$ are adjacent because they share the same side $\\overrightarrow{OQ}.$\n\nWe can add the measures of two adjacent angles to find the measure of the combined angle.\n\nTherefore: \n\n$$\n\\begin{aligned}m∠POR & =m∠POQ+m∠QOR \\\\  & ={68}^{∘}+{37}^{∘} \\\\  & ={105}^{∘}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110382 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110750 :knowledge-point/id #uuid "c59421f9-a1af-59d9-aa89-16cd2d13d332" :knowledge-point/title "Finding the Measure of an Unknown Angle Using the Extended Rule"}] :question/id #uuid "4ad9432d-82fc-58e6-b586-f16474fa18f3" :question/math-academy-id "e-2578" :question/problem "In the figure below, $m \\angle BAE = {110}^{\\circ}.$ Find the value of $x.$\n\n![](images/24/245dbaa430eb99aee193110fcd6df2844cfd7cffd2363c561337ac74d18a1fb5.png)" :question/worked-solution "Here, the letter $x$ represents the measure of the unknown angle $\\angle CAD.$\n\nThe measure of $\\angle CAD$ must be the *difference* between the large angle $(\\angle BAE)$ and the two smaller known angles $(\\angle BAC$ and $\\angle DAE).$\n\nTherefore, \n\n$$\nx = 110^\\circ - 40^\\circ - 20^\\circ = 50^\\circ.\n$$"}] [{:db/id #edb/ref 17592186434928 :knowledge-point/_questions [{:db/id #edb/ref 17592186110748 :knowledge-point/id #uuid "782a6a0a-7a15-5230-8f9d-5405aa72f96a" :knowledge-point/title "Finding the Measure of a Combined Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e1cb4a0-7539-5215-901a-94090333335f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{122}^{∘}" :db/id #edb/ref 17592186434839} {:answer/id #uuid "4a00bb7b-b835-5b61-b907-46193558bba4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{120}^{∘}" :db/id #edb/ref 17592186434852} {:answer/id #uuid "78d65e3b-18bb-5408-9442-62a7570cd3b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{124}^{∘}" :db/id #edb/ref 17592186434870} {:answer/id #uuid "aa1cdeb1-6a89-5184-a432-146c530475a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{110}^{∘}" :db/id #edb/ref 17592186434879}