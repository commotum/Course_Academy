=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.3em\"><mtr><mtd><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>A</mi><mi>O</mi><mi>C</mi></mtd><mtd><mi></mi><mo>=</mo><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>A</mi><mi>O</mi><mi>B</mi><mo>+</mo><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mi>B</mi><mi>O</mi><mi>C</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mn>40</mn><mo>∘</mo></msup><mo>+</mo><msup><mn>65</mn><mo>∘</mo></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mn>105</mn><mo>∘</mo></msup></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
