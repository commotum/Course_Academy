/mi><mi mathvariant=\"normal\">∠</mi><mrow data-mjx-texclass=\"ORD\"><mi>Q</mi><mi>O</mi><mi>R</mi></mrow><mo>+</mo><mi>m</mi><mi mathvariant=\"normal\">∠</mi><mrow data-mjx-texclass=\"ORD\"><mi>R</mi><mi>O</mi><mi>S</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mn>79</mn><mrow data-mjx-texclass=\"ORD\"><mo>∘</mo></mrow></msup><mo>+</mo><msup><mn>41</mn><mrow data-mjx-texclass=\"ORD\"><mo>∘</mo></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mn>120</mn><mrow data-mjx-texclass=\"ORD\"><mo>∘</mo></mrow></msup></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
