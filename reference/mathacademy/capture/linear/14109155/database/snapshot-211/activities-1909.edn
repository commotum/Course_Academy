#{[{:activity/first-step {:db/id #edb/ref 17592186125356} :activity/id #uuid "4535a3e9-8919-5e95-ab78-1b3e6bc5fe1d" :activity/scope {:db/id #edb/ref 17592186048558 :topic/id #uuid "a92f5097-81a3-51a2-90e4-397763d967f0" :topic/math-academy-id 1909} :activity/steps [{:db/id #edb/ref 17592186125356 :step/content {:db/id #edb/ref 17592186125769 :tutorial/content "A set of vectors \n\n$$\n\\mathcal{B}=\\{ \\mathbf{b}_1,\\mathbf{b}_2, \\ldots, \\mathbf{b}_n \\}\n$$\n\nis called a **basis** of an abstract vector space $V$ if the following two conditions hold:\n\n- $\\mathcal{B}$ is linearly independent, and\n\n- $\\mathcal{B}$ spans $V.$\n\nFor example, let's consider the vector space $\\mathbb{R}_2[t]$ of all polynomials in the variable $t$ over $\\mathbb R$ with degree at most $2,$ and its subset \n\n$$\n\\mathcal{B} = \\left\\{ {\\color{blue}{1}}, {\\color{blue}{t}}, {\\color{blue}{t^2}} \\right\\}.\n$$\n\n \n\nIs $\\mathcal{B}$ a basis for $\\mathbb{R}_2[t]?$ Let's check our two conditions.\n\n- First, we check for linear independence. Notice that the equation \n\n$$\nx_1 \\cdot {\\color{blue}1} + x_2 \\cdot {\\color{blue}t} + x_3 \\cdot {\\color{blue}t^2} = 0\n$$\n\n \nis true for all $t$ if and only if \n\n$$\nx_1=x_2=x_3=0.\n$$\n\nTherefore, the set $\\mathcal{B}$ is linearly independent in $\\mathbb{R}_2[t].$\n\n- Next, we check that $\\mathcal B$ spans $\\mathbb{R}_2[t].$ Notice that we can write any polynomial $at^2+bt+c\\in\\mathbb{R}_2[t]$ as a linear combination of vectors from $\\mathcal{B} \\mathbin{:}$\n\n$$\nat^2+bt+c=c\\cdot{\\color{blue}1} + b\\cdot{\\color{blue}t} + a\\cdot{\\color{blue}t^2}\n$$\n\nTherefore, $\\mathcal B$ spans $\\mathbb{R}_2[t].$\n\nSince both conditions hold, we conclude that $\\mathcal{B} = \\{ {1}, {t}, {t^2} \\}$ is a basis of $\\mathbb{R}_2[t]$." :tutorial/id #uuid "1d94c7bd-3777-5331-b633-0e2463092e26" :tutorial/math-academy-id 3210 :tutorial/title "Introduction"} :step/id #uuid "b18f66cf-141c-5d9b-abc4-5dec05218f63" :step/math-academy-id 17522 :step/next {:db/id #edb/ref 17592186125533}} {:db/id #edb/ref 17592186125357 :step/content {:db/id #edb/ref 17592186124495 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124308 :question/id #uuid "4b1227cb-7cf9-534d-a22f-e7acf7df9dc9" :question/math-academy-id "e-4830"} :knowledge-point/id #uuid "073042ee-d96d-5872-9681-ddcea43a2d37" :knowledge-point/questions [{:db/id #edb/ref 17592186125008} {:db/id #edb/ref 17592186125251} {:db/id #edb/ref 17592186244052} {:db/id #edb/ref 17592186244075} {:db/id #edb/ref 17592186244076} {:db/id #edb/ref 17592186360525} {:db/id #edb/ref 17592186360526} {:db/id #edb/ref 17592186360527} {:db/id #edb/ref 17592186360528} {:db/id #edb/ref 17592186360529}] :knowledge-point/title "Identifying True Statements About Sets of Vectors in a Matrix Vector Space"} :step/id #uuid "c37255e8-78c3-5483-a38d-706de2e319e3" :step/math-academy-id 17523 :step/next {:db/id #edb/ref 17592186125358}} {:db/id #edb/ref 17592186125358 :step/content {:db/id #edb/ref 17592186125770 :tutorial/content "A set of vectors $\\mathcal{B}=\\{ \\mathbf{b}_1,\\mathbf{b}_2, \\ldots, \\mathbf{b}_n \\}$ is a basis of a vector space $V$ if $\\mathcal{B}$ is a **maximally linearly independent set in $V$**. In other words, $\\mathcal{B}$ is linearly independent and for any vector ${\\color{blue}\\mathbf{w}} \\in V,$ the set \n\n$$\n\\mathcal{B} \\cup \\{ {\\color{blue}\\mathbf{w}} \\} = \\{ \\mathbf{b}_1,\\mathbf{b}_2, \\ldots, \\mathbf{b}_n, {\\color{blue}\\mathbf{w}} \\}\n$$\n\nis linearly dependent." :tutorial/id #uuid "dc0c1b8c-4abf-5ce9-aac8-763330c5a699" :tutorial/math-academy-id 3211 :tutorial/title "An Alternative Definition"} :step/id #uuid "914841e5-976c-50b0-9edd-a7475085a0ff" :step/math-academy-id 17524 :step/next {:db/id #edb/ref 17592186125361}} {:db/id #edb/ref 17592186125359 :step/content {:db/id #edb/ref 17592186125771 :tutorial/content "Let $\\mathbb{R}_n[t]$ denote the vector space of all polynomials in the variable $t$ over $\\mathbb{R}$ that have degree at most $n.$ Also, let $\\text{M}_2(\\mathbb{R})$ be the vector space of all $2 \\times 2$ matrices over $\\mathbb{R}.$ Then, we have the following important standard bases.\n\n- The standard basis of $\\mathbb{R}_1[t]$ is $\\{ 1, \\: t \\}.$\n\n- The standard basis of $\\mathbb{R}_2[t]$ is $\\{ 1, \\: t, \\: t^2 \\}.$\n\n- The standard basis of $\\mathbb{R}_n[t]$ is $\\{ 1, \\: t, \\: \\ldots, \\: t^n \\}.$\n\n- The standard basis of $\\text{M}_2(\\mathbb{R})$ is\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]\n$$" :tutorial/id #uuid "fd76fc85-4c43-564f-96ac-8492b69f8ecf" :tutorial/math-academy-id 3212 :tutorial/title "Some Important Standard Bases"} :step/id #uuid "4e0810ce-4ac6-549b-8bdf-98dce31cb769" :step/math-academy-id 17525} {:db/id #edb/ref 17592186125361 :step/content {:db/id #edb/ref 17592186124496 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124309 :question/id #uuid "91989c25-1d0d-5639-b3e1-7f7479322b7b" :question/math-academy-id "e-4831"} :knowledge-point/id #uuid "ca956d3e-37a8-5f0f-a062-97d0567d54e6" :knowledge-point/questions [{:db/id #edb/ref 17592186124868} {:db/id #edb/ref 17592186124973} {:db/id #edb/ref 17592186244099} {:db/id #edb/ref 17592186244100} {:db/id #edb/ref 17592186244101} {:db/id #edb/ref 17592186319205} {:db/id #edb/ref 17592186321020} {:db/id #edb/ref 17592186360539}] :knowledge-point/title "Identifying True Statements About Bases of Abstract Vector Spaces"} :step/id #uuid "e09fa444-e077-5819-b997-b79f912a52f2" :step/math-academy-id 17527 :step/next {:db/id #edb/ref 17592186125359}} {:db/id #edb/ref 17592186125533 :step/content {:db/id #edb/ref 17592186124598 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124409 :question/id #uuid "92adb651-e2db-5296-817d-aea249afe2b4" :question/math-academy-id "e-8269"} :knowledge-point/id #uuid "2588e089-4786-5346-b42d-65c2740ae2ab" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048263}] :knowledge-point/questions [{:db/id #edb/ref 17592186124972} {:db/id #edb/ref 17592186125250} {:db/id #edb/ref 17592186244035} {:db/id #edb/ref 17592186360519} {:db/id #edb/ref 17592186360520} {:db/id #edb/ref 17592186360521} {:db/id #edb/ref 17592186360522}] :knowledge-point/title "Identifying True Statements About Sets of Vectors in a Polynomial Vector Space"} :step/id #uuid "df7f4408-7a22-5728-a508-8a07da995a75" :step/math-academy-id 30897 :step/next {:db/id #edb/ref 17592186125357}}] :activity/title "Bases in Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124715}]}
