#{[{:db/id #edb/ref 17592186514373 :knowledge-point/_questions [{:db/id #edb/ref 17592186064257 :knowledge-point/id #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" :knowledge-point/title "Splitting a Rational Expression With Two Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19980522-9bdd-55a7-8d9d-8828e76405ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6-\\frac{y}{2}" :db/id #edb/ref 17592186513600} {:answer/id #uuid "320dbf36-2cfb-59da-86bb-c1a4774c9420" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-\\frac{y}{2}" :db/id #edb/ref 17592186513668} {:answer/id #uuid "c52cd410-949a-5ecc-9db0-e370a7d7839c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-y" :db/id #edb/ref 17592186514049} {:answer/id #uuid "c6076542-ac8d-521b-91c3-c0f173f61489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{y}{2}" :db/id #edb/ref 17592186514051} {:answer/id #uuid "db0641d9-8d65-5bc9-86fa-3e03187c823e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-y" :db/id #edb/ref 17592186514105}] :answer-field/correct {:answer/id #uuid "c6076542-ac8d-521b-91c3-c0f173f61489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{y}{2}" :db/id #edb/ref 17592186514051} :answer-field/id #uuid "abc45ee2-9c31-50c1-96af-d62cdd130b8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514307}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18e51362-5c55-557f-b76e-006c8ec5e5f2" :question/math-academy-id "q-103607" :question/problem "Which of the following is equivalent to $\\frac{12-3y}{6}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in individual terms, we get\n\n$$\n\\begin{aligned}\\frac{12-3y}{6} & = \\\\ \\frac{12}{6}-\\frac{3y}{6} & = \\\\ \\frac{12}{6}-\\frac{3}{6}\\cdot y & = \\\\ 2-\\frac{1}{2}\\cdot y & = \\\\ 2-\\frac{y}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514368 :knowledge-point/_questions [{:db/id #edb/ref 17592186064258 :knowledge-point/id #uuid "0649943a-643f-592f-8815-45c871f7e7dd" :knowledge-point/title "Splitting a Rational Expression With Three Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "000d1ee2-eb0e-516d-880b-59e76d658afd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4a}{3}-2b+3c" :db/id #edb/ref 17592186513525} {:answer/id #uuid "17d560ac-9cc4-58ec-bd8a-4cc87ded49ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{a}{3}-2b+3c" :db/id #edb/ref 17592186513592} {:answer/id #uuid "3def3569-bf02-567b-a7ce-c0676ebb8e33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4a}{3}-2b-3c" :db/id #edb/ref 17592186513694} {:answer/id #uuid "a1c1327e-3c63-5535-94ec-15c702bd94af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7abc}{3}" :db/id #edb/ref 17592186513950} {:answer/id #uuid "d2165713-727d-5608-af21-2766b713333b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4a}{3}+2b-3c" :db/id #edb/ref 17592186514078}] :answer-field/correct {:answer/id #uuid "000d1ee2-eb0e-516d-880b-59e76d658afd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4a}{3}-2b+3c" :db/id #edb/ref 17592186513525} :answer-field/id #uuid "33f1ff95-b84b-5146-8e81-b9dec5eae7f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514247}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1169d5be-77b9-5c01-b29e-d873231e9f86" :question/math-academy-id "q-2591" :question/problem "Which of the following is equivalent to $\\frac{4a-6b+9c}{3}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{4a-6b+9c}{3} & = \\\\ \\frac{4a}{3}-\\frac{6b}{3}+\\frac{9c}{3} & = \\\\ \\frac{4a}{3}-\\frac{6}{3}\\cdot b+\\frac{9}{3}\\cdot c & = \\\\ \\frac{4a}{3}-2b+3c & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514417 :knowledge-point/_questions [{:db/id #edb/ref 17592186064257 :knowledge-point/id #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" :knowledge-point/title "Splitting a Rational Expression With Two Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75c969ca-367d-5068-acbe-f0467f813227" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a=2$ and $b=-3$" :db/id #edb/ref 17592186513843} {:answer/id #uuid "c1682820-b145-57af-bb60-67f57aa12777" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a=2$ and $b=3$" :db/id #edb/ref 17592186514043} {:answer/id #uuid "cd8541b1-df31-5bf9-9595-f8be69351a38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a=8$ and $b=-3$" :db/id #edb/ref 17592186514063} {:answer/id #uuid "e31a9be0-36c9-524a-9bf7-ae092f66b308" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a=3$ and $b=-2$" :db/id #edb/ref 17592186514127} {:answer/id #uuid "f8331f74-2394-5f6e-af1d-324225a8b66a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a=2$ and $b=-12$" :db/id #edb/ref 17592186514180}] :answer-field/correct {:answer/id #uuid "75c969ca-367d-5068-acbe-f0467f813227" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$a=2$ and $b=-3$" :db/id #edb/ref 17592186513843} :answer-field/id #uuid "23253a0c-91f5-5d73-8605-1ae876bdd4b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514235}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "69e15305-fd39-5e12-9afd-c74d993158ed" :question/math-academy-id "q-2593" :question/problem "If $\\frac{8x-12y}{4}$ is written in the form $ax+by,$ what are the values of $a$ and $b?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{8x-12y}{4} & = \\\\ \\frac{8x}{4}-\\frac{12y}{4} & = \\\\ \\frac{8}{4}\\cdot x-\\frac{12}{4}\\cdot y & = \\\\ 2x-3y & .\\end{aligned}\n$$\n\nWriting the above in the form $ax+by,$ we get\n\n$$\n\\begin{aligned}{{(2)}_{⏟}}_{a}x+{{(-3)}_{⏟}}_{b}y.\\end{aligned}\n$$\n\nTherefore, $a=2$ and $b=-3.$"}] [{:db/id #edb/ref 17592186233686 :knowledge-point/_questions [{:db/id #edb/ref 17592186064258 :knowledge-point/id #uuid "0649943a-643f-592f-8815-45c871f7e7dd" :knowledge-point/title "Splitting a Rational Expression With Three Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03200003-7c03-5877-9799-fe42b38367d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5d}{3}-3e+2f" :db/id #edb/ref 17592186513535} {:answer/id #uuid "875b0e1a-c6ee-5156-9b67-b9182be36dd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}-3e+2f" :db/id #edb/ref 17592186513884} {:answer/id #uuid "a837bab8-9905-5840-bdf4-12b924029d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5d}{3}-3e-2f" :db/id #edb/ref 17592186513968} {:answer/id #uuid "b7dfca26-24d1-5b2e-89b8-03b7057f94a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "d-9e-2f" :db/id #edb/ref 17592186514016} {:answer/id #uuid "e8af9eea-0d25-50f2-b747-1968474f3c58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2d-9e-2f" :db/id #edb/ref 17592186514140}] :answer-field/correct {:answer/id #uuid "a837bab8-9905-5840-bdf4-12b924029d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5d}{3}-3e-2f" :db/id #edb/ref 17592186513968} :answer-field/id #uuid "5be07d56-1b09-5907-9a4a-651321f7cdec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514269}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cedc5783-2073-5a5a-9238-c637979688f1" :question/math-academy-id "q-2595" :question/problem "$\\frac{5d-9e-6f}{3}=$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{5d-9e-6f}{3} & = \\\\ \\frac{5d}{3}-\\frac{9e}{3}-\\frac{6f}{3} & = \\\\ \\frac{5d}{3}-\\frac{9}{3}\\cdot e-\\frac{6}{3}\\cdot f & = \\\\ \\frac{5d}{3}-3e-2f & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514455 :knowledge-point/_questions [{:db/id #edb/ref 17592186064257 :knowledge-point/id #uuid "724bdf2f-c9f0-564e-ae33-c64d44c582ef" :knowledge-point/title "Splitting a Rational Expression With Two Terms in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "233176ce-70f9-5e6d-87d1-a9ee42aee061" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a-6b" :db/id #edb/ref 17592186513629} {:answer/id #uuid "2b6d12dd-a924-575c-bf78-e849044273ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a-4" :db/id #edb/ref 17592186513650} {:answer/id #uuid "6a973a8f-68d4-5f16-b9b5-43302aeb1566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4a-\\frac{3b}{2}" :db/id #edb/ref 17592186513818} {:answer/id #uuid "98adbab9-1df8-5350-9e28-7f78e7ab5f5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a-\\frac{3b}{2}" :db/id #edb/ref 17592186513929} {:answer/id #uuid "b3b993a8-041c-5f04-b5e8-b517b901f0ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{3b}{2}" :db/id #edb/ref 17592186514002}] :answer-field/correct {:answer/id #uuid "98adbab9-1df8-5350-9e28-7f78e7ab5f5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a-\\frac{3b}{2}" :db/id #edb/ref 17592186513929} :answer-field/id #uuid "a56dfd75-69de-5099-a23d-5bcbe223963a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514304}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8beba6a-7b91-5602-93f9-62eba4e754b8" :question/math-academy-id "q-2596" :question/problem "Which of the following is equivalent to $\\frac{4a-6b}{4}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{4a-6b}{4} & = \\\\ \\frac{4a}{4}-\\frac{6b}{4} & = \\\\ \\frac{4}{4}\\cdot a-\\frac{6}{4}\\cdot b & = \\\\ a-\\frac{3}{2}\\cdot b & = \\\\ a-\\frac{3b}{2} & .\\end{aligned}\n$$"}]}
