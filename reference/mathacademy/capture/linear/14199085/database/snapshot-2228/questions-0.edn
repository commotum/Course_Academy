#{[{:db/id #edb/ref 17592186233686 :knowledge-point/_questions [{:db/id #edb/ref 17592186064258 :knowledge-point/id #uuid "0649943a-643f-592f-8815-45c871f7e7dd" :knowledge-point/title "Splitting a Rational Expression With Three Terms in the Numerator"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cedc5783-2073-5a5a-9238-c637979688f1" :question/math-academy-id "q-2595" :question/problem "$\\frac{5d-9e-6f}{3}=$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{5d-9e-6f}{3} & = \\\\ \\frac{5d}{3}-\\frac{9e}{3}-\\frac{6f}{3} & = \\\\ \\frac{5d}{3}-\\frac{9}{3}\\cdot e-\\frac{6}{3}\\cdot f & = \\\\ \\frac{5d}{3}-3e-2f & .\\end{aligned}\n$$"}]}
