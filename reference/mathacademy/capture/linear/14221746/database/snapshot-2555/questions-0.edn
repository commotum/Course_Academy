#{[{:db/id #edb/ref 17592186233180 :knowledge-point/_questions [{:db/id #edb/ref 17592186054609 :knowledge-point/id #uuid "add45606-39f6-5a61-9535-867d2950d183" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Power Function"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fe44f85b-e8b3-5b91-9050-93c115ce76be" :question/math-academy-id "q-113733" :question/problem "Calculate $\\int \\frac{1}{3{x}^{6}}\\,\\text{d}x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{3{x}^{6}}\\,\\text{d}x & =\\frac{1}{3}\\int {x}^{-6}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\cdot (\\frac{{x}^{-6+1}}{-6+1})+C \\\\  & =\\frac{1}{3}\\cdot (\\frac{{x}^{-5}}{-5})+C \\\\  & =-\\frac{1}{15}\\cdot {x}^{-5}+C \\\\  & =-\\frac{1}{15{x}^{5}}+C\\end{aligned}\\end{aligned}\n$$"}]}
