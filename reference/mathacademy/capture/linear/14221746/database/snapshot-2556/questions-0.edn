#{[{:db/id #edb/ref 17592186535088 :knowledge-point/_questions [{:db/id #edb/ref 17592186054609 :knowledge-point/id #uuid "add45606-39f6-5a61-9535-867d2950d183" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa7dce6-df1a-5088-806d-df25a6f8ac37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{8}}{6}+C" :db/id #edb/ref 17592186534284} {:answer/id #uuid "8cd65e72-3b80-534f-8810-88f5e53d25aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{y}^{8}}{8}+C" :db/id #edb/ref 17592186534570} {:answer/id #uuid "bbaf516e-8b25-5de2-a3f1-8ece4f6fd9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{6}}{8}+C" :db/id #edb/ref 17592186534685} {:answer/id #uuid "ce3c6810-8d96-5dbe-8d24-a6ff93cac7f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{8}}{2}+C" :db/id #edb/ref 17592186534728} {:answer/id #uuid "fabcfbb7-87ed-59c3-875b-7c9ddc058fe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{6}}{3}+C" :db/id #edb/ref 17592186534820}] :answer-field/correct {:answer/id #uuid "0aa7dce6-df1a-5088-806d-df25a6f8ac37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{8}}{6}+C" :db/id #edb/ref 17592186534284} :answer-field/id #uuid "3c95a3e3-069c-5ec3-b88e-edd9bad2a80d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534865}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc2dfa06-fbfe-5d00-98fd-cc43b27c052d" :question/math-academy-id "q-113731" :question/problem "Calculate $\\int \\frac{4}{3}{y}^{7}\\,\\text{d}y.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{4}{3}{y}^{7}\\,\\text{d}y & =\\frac{4}{3}\\int {y}^{7}\\,\\text{d}y \\\\  & =\\frac{4}{3}(\\frac{{y}^{7+1}}{7+1})+C \\\\  & =\\frac{4}{3}\\cdot \\frac{{y}^{8}}{8}+C \\\\  & =\\frac{{y}^{8}}{6}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186535039 :knowledge-point/_questions [{:db/id #edb/ref 17592186054609 :knowledge-point/id #uuid "add45606-39f6-5a61-9535-867d2950d183" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a676b7a-83f4-580e-bc68-198c1d310014" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10{z}^{5}}+C" :db/id #edb/ref 17592186534376} {:answer/id #uuid "524c97c6-03f8-598a-8c7c-ea2d3d324912" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{12{z}^{3}}+C" :db/id #edb/ref 17592186534428} {:answer/id #uuid "763e5a13-a335-5cdf-a259-7426bf657fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{{z}^{3}}+C" :db/id #edb/ref 17592186534519} {:answer/id #uuid "c1384251-11ce-53fe-90e4-87749a27be70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5{z}^{5}}+C" :db/id #edb/ref 17592186534696} {:answer/id #uuid "ddebe549-4054-5e6e-aaa8-0ecca6bb1cbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3{z}^{3}}+C" :db/id #edb/ref 17592186534760}] :answer-field/correct {:answer/id #uuid "ddebe549-4054-5e6e-aaa8-0ecca6bb1cbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3{z}^{3}}+C" :db/id #edb/ref 17592186534760} :answer-field/id #uuid "986e5def-75c9-5fb2-b0cd-ce6e4f5db7e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534914}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a064553-8bcb-586c-b022-5e4a307bf7cb" :question/math-academy-id "q-113732" :question/problem "Calculate $\\int \\frac{4}{{z}^{4}}\\,\\text{d}z.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{4}{{z}^{4}}\\,\\text{d}z & =4\\int {z}^{-4}\\,\\text{d}z \\\\  & =4\\cdot (\\frac{{z}^{-4+1}}{-4+1})+C \\\\  & =4\\cdot (\\frac{{z}^{-3}}{-3})+C \\\\  & =-\\frac{4}{3}\\cdot {z}^{-3}+C \\\\  & =-\\frac{4}{3{z}^{3}}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233180 :knowledge-point/_questions [{:db/id #edb/ref 17592186054609 :knowledge-point/id #uuid "add45606-39f6-5a61-9535-867d2950d183" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f05efc8-fec2-570b-87ce-c010c59354fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{15{x}^{5}}+C" :db/id #edb/ref 17592186534496} {:answer/id #uuid "867ff7cf-a3a9-5f4e-9f81-a86ed899e17f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3{x}^{5}}+C" :db/id #edb/ref 17592186534556} {:answer/id #uuid "86db9c05-054a-512f-9076-5d6601562ba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{21{x}^{7}}+C" :db/id #edb/ref 17592186534557} {:answer/id #uuid "aa104223-6a26-5471-ac67-5cfc91cda9db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{3{x}^{7}}+C" :db/id #edb/ref 17592186534646} {:answer/id #uuid "ed5eb29d-e2f7-5502-9cac-86d15c20177a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5{x}^{5}}+C" :db/id #edb/ref 17592186534792}] :answer-field/correct {:answer/id #uuid "6f05efc8-fec2-570b-87ce-c010c59354fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{15{x}^{5}}+C" :db/id #edb/ref 17592186534496} :answer-field/id #uuid "491fcc02-859b-58ab-a165-365def78f7fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534870}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fe44f85b-e8b3-5b91-9050-93c115ce76be" :question/math-academy-id "q-113733" :question/problem "Calculate $\\int \\frac{1}{3{x}^{6}}\\,\\text{d}x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{3{x}^{6}}\\,\\text{d}x & =\\frac{1}{3}\\int {x}^{-6}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\cdot (\\frac{{x}^{-6+1}}{-6+1})+C \\\\  & =\\frac{1}{3}\\cdot (\\frac{{x}^{-5}}{-5})+C \\\\  & =-\\frac{1}{15}\\cdot {x}^{-5}+C \\\\  & =-\\frac{1}{15{x}^{5}}+C\\end{aligned}\\end{aligned}\n$$"}]}
