#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186158376} :activity/id #uuid "986c9303-5c90-5d19-85f8-915c37c8bfb0" :activity/scope {:db/id #edb/ref 17592186048423 :topic/id #uuid "9ddcc703-a984-5097-a142-236dc3c2fbaf" :topic/math-academy-id 2979} :activity/steps [{:db/id #edb/ref 17592186158376 :step/content {:db/id #edb/ref 17592186158530 :tutorial/content "Suppose we want to find all of the solutions to the equation\n\n$$\nx \\cdot 3^x - 2 \\cdot 3^x = 0.\n$$\n\nFirst, we factor the equation:\n\n$$\n\\begin{aligned}x\\cdot {3}^{x}-2\\cdot {3}^{x} & =0 \\\\ (x-2)\\cdot {3}^{x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\nx-2  = 0 \\quad \\textrm{and} \\quad 3^x=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $x-2=0$ has the solution $x=2.$\n\n- The equation $3^x=0$ has no real solution because $3^x$ is positive for every real number $x.$\n\nTherefore, the original equation has a single solution, $x=2.$" :tutorial/id #uuid "90c9dc44-008d-5e8d-b233-b33802547a9c" :tutorial/math-academy-id 4715 :tutorial/title "Introduction"} :step/id #uuid "56edca54-b7a1-571d-b42c-21eaa3456fa1" :step/math-academy-id 467336 :step/next {:db/id #edb/ref 17592186158377}} {:db/id #edb/ref 17592186158377 :step/content {:db/id #edb/ref 17592186157437 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157170 :question/id #uuid "d6fce272-8b91-53f1-bfa4-32f098d8ee86" :question/math-academy-id "e-7836"} :knowledge-point/id #uuid "3758cf02-ba4b-539a-bc61-8c2030ff6f6f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048157} {:db/id #edb/ref 17592186048774}] :knowledge-point/questions [{:db/id #edb/ref 17592186157684} {:db/id #edb/ref 17592186157958} {:db/id #edb/ref 17592186237806} {:db/id #edb/ref 17592186237807} {:db/id #edb/ref 17592186290505} {:db/id #edb/ref 17592186292659} {:db/id #edb/ref 175