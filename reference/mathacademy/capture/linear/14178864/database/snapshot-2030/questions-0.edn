er/value "II and III only" :db/id #edb/ref 17592186108320} {:answer/id #uuid "028ecd1f-f636-5e81-8aaf-126986c2bd32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186108321} {:answer/id #uuid "74ca8c5b-bfb1-58ef-b546-5092219f4348" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186108322}] :answer-field/id #uuid "38e76745-24d5-5762-8d5c-0a948cb43c06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108317}] :question/id #uuid "de8441f9-b5b3-54ab-a25c-529c00dca814" :question/math-academy-id "q-26504" :question/problem "![](images/fa/fa57e1d088e5384cfd7a08d524877e6a9fafce413f0b3039d59d90dd074d361b.png)\n\nWhich of the following statements are true for the polygons $P$, $Q$ and $R$ shown above?\n\n1. $P≅Q$\n2. $Q≅R$\n3. $P≅R$"}]}
