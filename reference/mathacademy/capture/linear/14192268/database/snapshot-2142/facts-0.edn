b/ref 17592186045417] [17592186086253 #edb/ref 1080 "x ∈ [3, 4]" #edb/ref 17592186045417] [17592186086253 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186086253 #edb/ref 1083 #uuid "1695e743-0255-503d-9ed8-c389262443c4" #edb/ref 17592186045417] [17592186086254 #edb/ref 1080 "x ∈ [2, 4]" #edb/ref 17592186045417] [17592186086254 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186086254 #edb/ref 1083 #uuid "5f2704a0-b07f-5cc0-b922-2ae8ccfdfc67" #edb/ref 17592186045417] [17592186086255 #edb/ref 1080 "x ∈ (2, 4)" #edb/ref 17592186045417] [17592186086255 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186086255 #edb/ref 1083 #uuid "78aba92e-a87b-5df2-b916-d8a2ad1df444" #edb/ref 17592186045417] [17592186087423 #edb/ref 1069 "e-1100" #edb/ref 17592186045417] [17592186087423 #edb/ref 1071 "What is the domain of the function shown below?\n\n![](images/16/16ee469ac79597e3afc65844e27a156fd45d8cbd3234f2fdc74e0ab9b4554237.png)" #edb/ref 17592186045417] [17592186087423 #edb/ref 1072 #uuid "445894dd-2509-547b-8b42-2f44e3739d2c" #edb/ref 17592186045417] [17592186087423 #edb/ref 1074 "The function above is defined for values between $x=-2$ and $x=2$.\n\n- Since there is a closed circle at $x=-2$, this point is included in the domain.\n- Since there is a closed circle at $x=2$, this point is also included in the domain.\n\nTherefore, the domain of this function is\n\n$$\n-2 \\leq x \\leq 2\n$$\n\nUsing interval notation, we can write this as\n$x \\in [-2,2]$." #edb/ref 17592186045417] [17592186087424 #edb/ref 1069 "e-1102" #edb/ref 17592186045417] [17592186087424 #edb/ref 1071 "What is the domain of the function $f(x)$ defined by the following table?\n\n| $x$ | $\\,-2\\,$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,2\\,$ | $\\,4\\,$ | $\\,6\\,$ |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: |\n| $f(x)$ | $-2$ | $-2$ | $-1$ | $1$ | $1$ | $2$ |" #edb/ref 17592186045417] [17592186087424 #edb/ref 1072 #uuid "3482c05a-8088-510a-9eed-52a9299e87e9" #edb/ref 17592186045417] [17592186087424 #edb/ref 1074 "The domain is the set of all input values for which the function is defined. In the table, this corresponds to the set of $x$-values in the first row:\n\n$$\n\\{-2,-1,0,2,4,6\\}\n$$" #edb/ref 17592186045417] [17592186087652 #edb/ref 1069 "e-9641" #edb/ref 17592186045417] [17592186087652 #edb/ref 1071 "![](images/42/424ba7888faf0cd8503f562664da2d87595680e79b91acbefa5f1e3e79b81776.png)\n\nWhat is the domain of the function shown above?" #edb/ref 17592186045417] [17592186087652 #edb/ref 1072 #uuid "7eee5cfd-73ea-5430-81ff-b725b748b177" #edb/ref 17592186045417] [17592186087652 #edb/ref 1074 "The function above is defined for all values of $x$ that are less than $x = 3$.\n\nIn addition, since there is a closed circle at $x = 3$, this point is included in the domain.\n\nTherefore, the domain of this function is\n\n$$\nx \\leq 3\n$$\n\nwhich we can write as $x \\in (-\\infty, 3]$." #edb/ref 17592186045417] [17592186087815 #edb/ref 1037 #edb/ref 17592186049162 #edb/ref 17592186045417] [17592186087815 #edb/ref 1038 #edb/ref 17592186088265 #edb/ref 17592186045417] [17592186087815 #edb/ref 1038 #edb/ref 17592186088266 #edb/ref 17592186045417] [17592186087815 #edb/ref 1039 "Determining the Finite Domain of a Function From Its Graph" #edb/ref 17592186045417] [17592186087815 #edb/ref 1041 #edb/ref 17592186087423 #edb/ref 17592186045417] [17592186087815 #edb/ref 1042 #uuid "3dea9cc3-e655-5f03-80a7-beb0e3f252de" #edb/ref 17592186045417] [17592186087816 #edb/ref 1037 #edb/ref 17592186050566 #edb/ref 17592186045417] [17592186087816 #edb/ref 1038 #edb/ref 17592186088220 #edb/ref 17592186045417] [17592186087816 #edb/ref 1038 #edb/ref 17592186088221 #edb/ref 17592186045417] [17592186087816 #edb/ref 1039 "Determining the Domain of a Function From a Mapping Diagram or Table" #edb/ref 17592186045417] [17592186087816 #edb/ref 1041 #edb/ref 17592186087424 #edb/ref 17592186045417] [17592186087816 #edb/ref 1042 #uuid "4fdb78