#{[{:db/id #edb/ref 17592186087423 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087815 :knowledge-point/id #uuid "3dea9cc3-e655-5f03-80a7-beb0e3f252de" :knowledge-point/title "Determining the Finite Domain of a Function From Its Graph"}] :question/id #uuid "445894dd-2509-547b-8b42-2f44e3739d2c" :question/math-academy-id "e-1100" :question/problem "What is the domain of the function shown below?\n\n![](images/16/16ee469ac79597e3afc65844e27a156fd45d8cbd3234f2fdc74e0ab9b4554237.png)" :question/worked-solution "The function above is defined for values between $x=-2$ and $x=2$.\n\n- Since there is a closed circle at $x=-2$, this point is included in the domain.\n- Since there is a closed circle at $x=2$, this point is also included in the domain.\n\nTherefore, the domain of this function is\n\n$$\n-2 \\leq x \\leq 2\n$$\n\nUsing interval notation, we can write this as\n$x \\in [-2,2]$."}] [{:db/id #edb/ref 17592186087424 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087816 :knowledge-point/id #uuid "4fdb7891-f2c4-5464-afe5-50badf628096" :knowledge-point/title "Determining the Domain of a Function From a Mapping Diagram or Table"}] :question/id #uuid "3482c05a-8088-510a-9eed-52a9299e87e9" :question/math-academy-id "e-1102" :question/problem "What is the domain of the function $f(x)$ defined by the following table?\n\n| $x$ | $\\,-2\\,$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,2\\,$ | $\\,4\\,$ | $\\,6\\,$ |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: |\n| $f(x)$ | $-2$ | $-2$ | $-1$ | $1$ | $1$ | $2$ |" :question/worked-solution "The domain is the set of all input values for which the function is defined. In the table, this corresponds to the set of $x$-values in the first row:\n\n$$\n\\{-2,-1,0,2,4,6\\}\n$$"}] [{:db/id #edb/ref 17592186087652 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087817 :knowledge-point/id #uuid "edc2109a-1ed3-5211-8b78-5592f7d77493" :knowledge-point/title "Determining the Infinite Domain of a Function From Its Graph"}] :question/id #uuid "7eee5cfd-73ea-5430-81ff-b725b748b177" :question/math-academy-id "e-9641" :question/problem "![](images/42/424ba7888faf0cd8503f562664da2d87595680e79b91acbefa5f1e3e79b81776.png)\n\nWhat is the domain of the function shown above?" :question/worked-solution "The function above is defined for all values of $x$ that are less than $x = 3$.\n\nIn addition, since there is a closed circle at $x = 3$, this point is included in the domain.\n\nTherefore, the domain of this function is\n\n$$\nx \\leq 3\n$$\n\nwhich we can write as $x \\in (-\\infty, 3]$."}] [{:db/id #edb/ref 17592186088265 :knowledge-point/_questions [{:db/id #edb/ref 17592186087815 :knowledge-point/id #uuid "3dea9cc3-e655-5f03-80a7-beb0e3f252de" :knowledge-point/title "Determining the Finite Domain of a Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b0a32f5-36c1-5cb4-9382-91368b306507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ (1, 5]" :db/id #edb/ref 17592186086245} {:answer/id #uuid "8d363d0c-68b3-54bc-98c9-a5ea5a9fad9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ [1, 5)" :db/id #edb/ref 17592186086246} {:answer/id #uuid "cbd3e9e7-a740-5560-b4f4-6607e1e6762e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ (1, 4]" :db/id #edb/ref 17592186086247} {:answer/id #uuid "e7e19016-26c1-5599-9cf8-5b2f74a67cda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ [1, 4)" :db/id #edb/ref 17592186086248} {:answer/id #uuid "6eba152e-78c0-521d-9c0b-d2835ecb81ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x ∈ [1, 4]" :db/id #edb/ref 17592186086249}] :answer-field/id #uuid "56a4309c-fb5f-55a2-bf19-9aaf5274891a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.