#{[{:db/id #edb/ref 17592186087423 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087815 :knowledge-point/id #uuid "3dea9cc3-e655-5f03-80a7-beb0e3f252de" :knowledge-point/title "Determining the Finite Domain of a Function From Its Graph"}] :question/id #uuid "445894dd-2509-547b-8b42-2f44e3739d2c" :question/math-academy-id "e-1100" :question/problem "What is the domain of the function shown below?\n\n![](images/16/16ee469ac79597e3afc65844e27a156fd45d8cbd3234f2fdc74e0ab9b4554237.png)" :question/worked-solution "The function above is defined for values between $x=-2$ and $x=2.$\n\n- Since there is a closed circle at $x=-2,$ this point is included in the domain.\n\n- Since there is a closed circle at $x=2,$ this point is also included in the domain.\n\nTherefore, the domain of this function is\n\n$$\n-2 \\leq x \\leq 2.\n$$\n\nUsing interval notation, we can write this as\n\n$$\nx \\in [-2,2].\n$$"}] [{:db/id #edb/ref 17592186087424 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087816 :knowledge-point/id #uuid "4fdb7891-f2c4-5464-afe5-50badf628096" :knowledge-point/title "Determining the Domain of a Function From a Mapping Diagram or Table"}] :question/id #uuid "3482c05a-8088-510a-9eed-52a9299e87e9" :question/math-academy-id "e-1102" :question/problem "What is the domain of the function $f(x)$ defined by the following table? \n\n| $x$ | $\\,-2\\,$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,2\\,$ | $\\,4\\,$ | $\\,6\\,$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $-2$ | $-2$ | $-1$ | $1$ | $1$ | $2$ |" :question/worked-solution "The domain is the set of all input values for which the function is defined. In the table, this corresponds to the set of $x$-values in the first row:\n\n \n\n$$\n\\{ -2,-1,0,2,4,6\\}\n$$"}] [{:db/id #edb/ref 17592186087652 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087817 :knowledge-point/id #uuid "edc2109a-1ed3-5211-8b78-5592f7d77493" :knowledge-point/title "Determining the Infinite Domain of a Function From Its Graph"}] :question/id #uuid "7eee5cfd-73ea-5430-81ff-b725b748b177" :question/math-academy-id "e-9641" :question/problem "![](images/42/424ba7888faf0cd8503f562664da2d87595680e79b91acbefa5f1e3e79b81776.png)\n\nWhat is the domain of the function shown above?" :question/worked-solution "The function above is defined for all values of $x$ that are less than $x = 3.$\n\nIn addition, since there is a closed circle at $x = 3,$ this point is included in the domain.\n\nTherefore, the domain of this function is $x \\leq 3,$ which we can write as $x \\in (-\\infty, 3].$"}] [{:db/id #edb/ref 17592186505755 :knowledge-point/_questions [{:db/id #edb/ref 17592186087816 :knowledge-point/id #uuid "4fdb7891-f2c4-5464-afe5-50badf628096" :knowledge-point/title "Determining the Domain of a Function From a Mapping Diagram or Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce20594-2358-5ff7-89ff-5cadd0a95e97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,20)" :db/id #edb/ref 17592186505156} {:answer/id #uuid "847fff66-ddfc-5162-bb0b-bd2399256f64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{5,10,15,20\\}" :db/id #edb/ref 17592186505367} {:answer/id #uuid "cc91d0ee-3d52-5f3e-938e-dd040c2caf25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[5,20]" :db/id #edb/ref 17592186505499} {:answer/id #uuid "f1381d05-6389-52f2-9c1d-61eb3554de91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{6,12,18,24\\}" :db/id #edb/ref 17592186505573} {:answer/id #uuid "f3c1b6f7-300e-54f8-945b-311c518e0e48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[6,24]" :db/id #edb/ref 17592186505578}] :answer-field/correct {:answer/id #uuid "847fff66-ddfc-5162-bb0b-bd2399256f64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{5,10,15,20\\}" :db/id #edb/ref 17592186505367} :answer-field/id #uuid "02fb490d-7974-523d-bc5c-3d147361beac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186505605}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "326c594b-0df4-5454-9bfb-36d7406d2334" :question/math-academy-id "q-130437" :question/problem "![](images/a3/a3af5c931067f960d2099efdb9a19e23dd2835a16095cdc0e61a0a507b0e8a3c.png)\n\nWhat is the domain of the function $f$ defined by the mapping diagram above?" :question/worked-solution "The domain is the set of all input values for which the function is defined. In the mapping diagram, this corresponds to the set of values in the \"Input\" set:\n\n$$\n\\{5,10,15,20\\}\n$$"}] [{:db/id #edb/ref 17592186505840 :knowledge-point/_questions [{:db/id #edb/ref 17592186087817 :knowledge-point/id #uuid "edc2109a-1ed3-5211-8b78-5592f7d77493" :knowledge-point/title "Determining the Infinite Domain of a Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01183f01-992f-5a34-8298-4be6d5d73976" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186505107} {:answer/id #uuid "09f080a6-b427-563b-ae55-b03d337c2cd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in \\{-5,-4,-3,-2,0,1,2,3\\}" :db/id #edb/ref 17592186505124} {:answer/id #uuid "12eda399-a8d7-53f2-a8f0-aad90ef36064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-5,3]" :db/id #edb/ref 17592186505137} {:answer/id #uuid "28bd0717-9921-5919-9e62-33a8eba93b72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186505178} {:answer/id #uuid "d09d52d7-0f46-5bd6-b36a-38755a