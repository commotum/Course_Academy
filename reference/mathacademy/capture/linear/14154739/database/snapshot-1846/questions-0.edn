#{[{:db/id #edb/ref 17592186124294 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124481 :knowledge-point/id #uuid "202575c6-7672-5387-a5ae-762bef520add" :knowledge-point/title "Separating a Square Root Into a Product of Two Square Roots"}] :question/id #uuid "35290ca2-1488-52ba-9d2e-b8c3e04c45e4" :question/math-academy-id "e-4743" :question/problem "Simplify $\\sqrt{12}$." :question/worked-solution "Note that\n\n$$\n12=4 \\cdot 3\n$$\n\nwhere $4$ is a perfect square. So, applying the product rule, we have\n\n$$\n\\sqrt{12} =\\sqrt{4 \\cdot 3}= \\sqrt{4} \\cdot \\sqrt{3} = 2\\sqrt{3}\n$$"}] [{:db/id #edb/ref 17592186124295 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124482 :knowledge-point/id #uuid "d6f8c2c9-e82f-5d37-9f34-4811dd88c78d" :knowledge-point/title "Writing a Product of Two Square Roots as a Single Square Root"}] :question/id #uuid "204328e4-810f-591e-a085-bb9cdadca875" :question/math-academy-id "e-4744" :question/problem "Write $3 \\sqrt{5}$ as the square root of a single number." :question/worked-solution "Note that\n\n$$\n3 = \\sqrt{9}\n$$\n\nSo, applying the product rule, we have\n\n$$\n3 \\sqrt{5} = \\sqrt{9}\\cdot\\sqrt{5}= \\sqrt{9\\cdot 5} = \\sqrt{45}\n$$"}] [{:db/id #edb/ref 17592186124296 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186124483 :knowledge-point/id #uuid "e97098b0-a7f9-564a-899e-60fb88682c80" :knowledge-point/title "The Product Rule With Cube Roots"}] :question/id #uuid "0c797a57-00a8-57b9-af30-655e8952c4c3" :question/math-academy-id "e-4756" :question/problem "Express $\\sqrt[3]{2}\\cdot\\sqrt[3]{3}$ as the cube root of a single number." :question/worked-solution "Using the product rule, we have\n\n$$\n\\sqrt[3]{2}\\cdot\\sqrt[3]{3}= \\sqrt[3]{2\\cdot 3} = \\sqrt[3]{6}\n$$"}] [{:db/id #edb/ref 17592186125205 :knowledge-point/_questions [{:db/id #edb/ref 17592186124481 :knowledge-point/id #uuid "202575c6-7672-5387-a5ae-762bef520add" :knowledge-point/title "Separating a Square Root Int