#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186097464} :activity/id #uuid "30c36ee2-9323-5f4b-8285-fca56e5c3713" :activity/scope {:db/id #edb/ref 17592186050194 :topic/id #uuid "3590e84f-47da-5e18-b0fb-3a411e717ac4" :topic/math-academy-id 1107} :activity/steps [{:db/id #edb/ref 17592186097464 :step/content {:db/id #edb/ref 17592186097826 :tutorial/content "A **vector** is a mathematical object that is used to represent quantities that have both **direction** and **magnitude.** We can think of a vector as a \"directed line segment\".\n\nFor example, consider a ship that travels $15\\:\\textrm{km}$ due east. In the diagram below, the ship starts at the point $A$ and ends at the point $B.$ This information can be represented as a **vector**, a directed line segment that starts at $A$ and points to $B,$ as follows:\n\n![](images/5c/5c12cfd2657f42293b2ee53fd2a4aede2f0325233305be9ac9bc0b5620391654.png)\n\nThe vector itself represents the **displacement** of the ship. The magnitude (length) of the vector represents the total distance traveled, and the direction of the vector gives the direction of travel.\n\nThe **tail** of the vector is at the point $A.$ The **head** of the vector is at the point $B.$ \n\nThe vector can be written using its endpoints as $\\overrightarrow{AB}.$ We can also represent vectors using lowercase letters written in bold, such as $\\mathbf{a},$ $\\mathbf{b},$ $\\mathbf{c}.$" :tutorial/id #uuid "6ccac1e4-068b-5d32-9511-15bcc9142591" :tutorial/math-academy-id 2899 :tutorial/title "Introduction"} :step/id #uuid "2f547b48-2d83-5acb-bfd1-ba058d79863a" :step/math-academy-id 15682 :step/next {:db/id #edb/ref 17592186097465}} {:db/id #edb/ref 17592186097465 :step/content {:db/id #edb/ref 17592186096640 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096437 :question/id #uuid "5987eb83-0b8c-54f9-8295-2b25c677c855" :question/math-academy-id "e-4270"} :knowledge-point/id #uuid "6a0610a8-fff6-5365-be0f-1f4524fbf7a1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048587} {:db/id #edb/ref 17592186050563}] :knowledge-point/questions [{:db/id #edb/ref 17592186096952} {:db/id #edb/ref 17592186096987} {:db/id #edb/ref 17592186510369}] :knowledge-point/title "Drawing Vectors Representing Displacements"} :step/id #uuid "defe8630-5cba-584a-874a-00e5bedf61b4" :step/math-academy-id 15683 :step/next {:db/id #edb/ref 17592186097466}} {:db/id #edb/ref 17592186097466 :step/content {:db/id #edb/ref 17592186097827 :tutorial/content "Two vectors are **equal** if they have both the same magnitude and the same direction. For example, the two vectors shown in the picture below are equal.\n\n![](images/2a/2a0d9e89849dcedc7dcd8395fcf1379a1f857cf1a6e91e490489d93d08a3da1d.png)\n\nAs we can see from the picture above, we have\n\n$$\n\\overrightarrow{AB} = \\overrightarrow{CD} = \\textbf{a}.\n$$" :tutorial/id #uuid "e85c3bb7-56a4-543d-96d4-ade0905a8661" :tutorial/math-academy-id 2900 :tutorial/title "Equal Vectors"} :step/id #uuid "09bedba4-2787-5bb2-ade5-ba8b11c106ff" :step/math-academy-id 15684 :step/next {:db/id #edb/ref 17592186097468}} {:db/id #edb/ref 17592186097468 :step/content {:db/id #edb/ref 17592186096641 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096438 :question/id #uuid "b570eb3b-dc18-5f39-8cd5-9b126f6d36d6" :question/math-academy-id "e-4271"} :knowledge-point/id #uuid "a34cc294-bcdd-5d8d-aca3-c55ffa22d5c6" :knowledge-point/questions [{:db/id #edb/ref 17592186097151} {:db/id #edb/ref 17592186097169} {:db/id #edb/ref 17592186510393}] :knowledge-point/title "Drawing Equal Vectors"} :step/id #uuid "b0ce86f2-b2c7-58cf-8614-314aecc47523" :step/math-academy-id 15686 :step/next {:db/id #edb/ref 17592186097546}} {:db/id #edb/ref 17592186097546 :step/content {:db/id #edb/ref 17592186096689 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096484 :question/id #uuid "fa99b738-088b-54d8-938c-d3bb75ae3398" :question/math-academy-id "e-5012"} :knowledge-point/id #uuid "69934fc1-6d88-5c34-82ae-a2d79774529d" :knowledge-point/questions [{:db/id #edb/ref 17592186097152} {:db/id #edb/ref 17592186097170} {:db/id #edb/ref 17592186510377} {:db/id #edb/ref 17592186510382}] :knowledge-point/title "Identifying Equal Vectors"} :step/id #uuid "e1330bc3-d54a-58d4-b013-29a71838ec48" :step/math-academy-id 18355}] :activity/title "Introduction to Vectors" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096887}]}
