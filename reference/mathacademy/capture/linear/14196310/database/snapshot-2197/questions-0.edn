dbd67ec10be795b15f5526e03221a6ab.png)\n\nThe length of the line segment of the vector represents the displacement of the ship (which is $10$ $\\text{km}$)."}] [{:db/id #edb/ref 17592186510369 :knowledge-point/_questions [{:db/id #edb/ref 17592186096640 :knowledge-point/id #uuid "6a0610a8-fff6-5365-be0f-1f4524fbf7a1" :knowledge-point/title "Drawing Vectors Representing Displacements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d7fb3a-31e0-5f76-94b9-de46f4079cf2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8c/8cb666a7b82847d16500fab42f7261ba0828b0dd9657d70ad2354a234d83b7b2.png" :db/id #edb/ref 17592186509702} {:answer/id #uuid "23f264ab-766e-5b75-a836-82e9e3548d22" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8f/8f19c351d68561d9c8a5e61e6ab04da569fd148f8747290b7fb1bfd241dd6ece.png" :db/id #edb/ref 17592186509766} {:answer/id #uuid "5338c16d-ee92-5749-9ad1-da2ae809d2d0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6d/6d0e5014afb9ccf6fccbd696feaa127b701f1d030645904dbc094f9b617b30f1.png" :db/id #edb/ref 17592186509860} {:answer/id #uuid "8a418fc6-55d9-5a6f-9315-d3eee890b60d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/05/05e8728e445de285c6cd7674046d6ba18c605b930eadeb001ff7d8b91fb3eaaf.png" :db/id #edb/ref 17592186509991} {:answer/id #uuid "d2477097-99cb-5377-b0c1-dae712c7ac4d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8ba5dcce8a71c4ccea5f4d69a02140c4d0d3a94b1a1b914afd7e7dab0600ed8.png" :db/id #edb/ref 17592186510136}] :answer-field/correct {:answer/id #uuid "d2477097-99cb-5377-b0c1-dae712c7ac4d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8ba5dcce8a71c4ccea5f4d69a02140c4d0d3a94b1a1b914afd7e7dab0600ed8.png" :db/id #edb/ref 17