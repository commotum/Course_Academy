#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186540116} :activity/id #uuid "1c136286-07e7-54b0-87c2-d0c00e24e994" :activity/scope {:db/id #edb/ref 17592186050953 :topic/id #uuid "7525f3f4-fbe5-5024-8fab-55ad3066edd8" :topic/math-academy-id 266} :activity/steps [{:db/id #edb/ref 17592186540116 :step/content {:db/id #edb/ref 17592186060376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9afe93af-c815-5f2c-ac75-9a584d561ee5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186058879} {:answer/id #uuid "e4d50060-ed5a-55ba-98a5-e136d622f6bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186058880} {:answer/id #uuid "e6d7edad-f24a-5a39-b3a9-bdf0e222d37a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186058881} {:answer/id #uuid "3af8e372-8b94-5bca-966e-b13590d4c251" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{7}" :db/id #edb/ref 17592186058882} {:answer/id #uuid "4335e387-f8cb-50d1-a3a5-f1a739c9876b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186058883}] :answer-field/correct {:db/id #edb/ref 17592186058882} :answer-field/id #uuid "084ec80c-c0ed-58a4-b621-614f03d00659" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186058878}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "09320d7a-d867-531b-9740-66504912149d" :question/math-academy-id "q-67332" :question/problem "Solve the equation $\\frac{2}{3x+2}=-\\frac{4}{x}.$" :question/worked-solution "First, we note that\n\n- $x=-\\frac{2}{3}$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=0$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{3x+2}{2}=-\\frac{x}{4}\n$$\n\nNext, we write both fractions using the least common denominator $4,$ as follows:\n\n$$\n\\frac{6x+4}{4}=-\\frac{x}{4}\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}4\\cdot \\frac{6x+4}{4} & =4\\cdot (-\\frac{x}{4}) \\\\ 6x+4 & =-x \\\\ 6x+x & =-4 \\\\ x & =-\\frac{4}{7}\\end{aligned}\n$$"} :step/id #uuid "04bd31c0-ddc2-5b9c-ad07-d73251e35927" :step/next {:db/id #edb/ref 17592186540140}} {:db/id #edb/ref 17592186540123 :step/content {:db/id #edb/ref 17592186540100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d56b3b6-d2ee-5a6a-ac79-f166c602aad7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186539536} {:answer/id #uuid "5bbc6a18-26ef-5ee7-a216-046a93109cdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186539634} {:answer/id #uuid "684d8919-d630-53ec-be88-da83985b9cfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186539650} {:answer/id #uuid "adf72623-7732-5460-b0b6-5cc1011adb27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186539775} {:answer/id #uuid "f71975b1-e674-5e94-a227-f47c16e02797" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186539894}] :answer-field/correct {:db/id #edb/ref 17592186539894} :answer-field/id #uuid "746714c2-cc0f-5a43-9606-b934d8793273" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539966}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dba16e2f-f755-5c6f-b25b-801d348b9282" :question/math-academy-id "q-67435" :question/problem "Solve the equation $-\\frac{4}{x-2}=\\frac{1}{x-1}.$" :question/worked-solution "First, we note that\n\n- $x=2$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=1$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n-\\frac{x-2}{4}=\\frac{x-1}{1}\n$$\n\nNext, we write both fractions using the least common denominator, $4.$ The equation becomes\n\n$$\n-\\frac{x-2}{4}=\\frac{4x-4}{4}.\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}(-4)\\cdot (\\frac{x-2}{-4}) & =(-4)\\cdot \\frac{4x-4}{4} \\\\ x-2 & =-4x+4 \\\\ x+4x & =4+2 \\\\ 5x & =6 \\\\ (\\frac{1}{5})\\cdot (5x) & =(\\frac{1}{5})\\cdot (6) \\\\ (\\cancel{\\frac{1}{5}})\\cdot (\\cancel{5}x) & =(\\frac{1}{5})\\cdot (6) \\\\ x & =\\frac{6}{5}\\end{aligned}\n$$"} :step/id #uuid "128aaed4-1578-549e-bc3a-0ca44706efdb"} {:db/id #edb/ref 17592186540140 :step/content {:db/id #edb/ref 17592186540075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30e054d1-ef35-5151-b5a6-95077b0323c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186539572} {:answer/id #uuid "5deed0da-0520-5246-8e6c-365d802468b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186539637} {:answer/id #uuid "6c5af59e-eefa-5320-9d2c-7a4fb55193a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186539660} {:answer/id #uuid "a816dc9c-912f-5b96-8ae4-1b55000c74ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186539765} {:answer/id #uuid "b4e754c7-eafd-5c39-98a7-4f2732e90d24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186539791}] :answer-field/correct {:db/id #edb/ref 17592186539660} :answer-field/id #uuid "d7cb7b4d-8e3a-52e0-b39c-57977a95c75f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540000}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9929bc33-2631-5ab2-871b-80ee305fc700" :question/math-academy-id "q-67413" :question/problem "Solve the equation $\\frac{1}{x+5}=\\frac{1}{3}.$" :question/worked-solution "First, we note that $x=-5$ cannot be a solution since this would make the denominator on the left-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{x+5}{1}=\\frac{3}{1}\n$$\n\nThe above equation simplifies to\n\n$$\nx+5=3\n$$\n\nWe can now solve this equation using the addition principle:\n\n$$\n\\begin{aligned}x+5 & =3 \\\\ x+5-5 & =3-5 \\\\ x & =-2\\end{aligned}\n$$"} :step/id #uuid "5a1efe66-123d-5aba-9cc1-514789a8cab9" :step/next {:db/id #edb/ref 17592186540123}}] :activity/title "Solving Rational Equations Using the Flip Method" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186539465}]}
