#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186060674} :activity/id #uuid "780b6d06-4e3c-5fb9-a687-1ad2687e0771" :activity/scope {:db/id #edb/ref 17592186050953 :topic/id #uuid "7525f3f4-fbe5-5024-8fab-55ad3066edd8" :topic/math-academy-id 266} :activity/steps [{:db/id #edb/ref 17592186060580 :step/content {:db/id #edb/ref 17592186059706 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059519 :question/id #uuid "935e8644-8d66-5be6-87ec-b8176675aa91" :question/math-academy-id "e-4233"} :knowledge-point/id #uuid "4af25d77-e2aa-585a-971f-693c44f34e48" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050613} {:db/id #edb/ref 17592186050749}] :knowledge-point/questions [{:db/id #edb/ref 17592186060370} {:db/id #edb/ref 17592186060371} {:db/id #edb/ref 17592186503715}] :knowledge-point/title "Solving Rational Equations with a Variable in One Denominator"} :step/id #uuid "a0e30d07-9c41-5c2c-839c-9e49ca64764c" :step/math-academy-id 15458 :step/next {:db/id #edb/ref 17592186060581}} {:db/id #edb/ref 17592186060581 :step/content {:db/id #edb/ref 17592186059707 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059520 :question/id #uuid "e7d11d09-773c-58a9-8582-2cd47a3b141c" :question/math-academy-id "e-4234"} :knowledge-point/id #uuid "93665eb6-5d3e-52d2-afc6-bc27488190e1" :knowledge-point/questions [{:db/id #edb/ref 17592186060372} {:db/id #edb/ref 17592186060377} {:db/id #edb/ref 17592186503666} {:db/id #edb/ref 17592186503684} {:db/id #edb/ref 17592186540075}] :knowledge-point/title "Solving Rational Equations with a Binomial in One Denominator"} :step/id #uuid "233132be-0fc4-52d1-9152-818b8c45b168" :step/math-academy-id 15459 :step/next {:db/id #edb/ref 17592186060582}} {:db/id #edb/ref 17592186060582 :step/content {:db/id #edb/ref 17592186059708 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059521 :question/id #uuid "3ae175a8-7654-57c8-b5d8-33d7892b7a24" :question/math-academy-id "e-4235"} :knowledge-point/id #uuid "c2c24d70-3bde-5277-bc92-ae081065deee" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725}] :knowledge-point/questions [{:db/id #edb/ref 17592186060373} {:db/id #edb/ref 17592186060376} {:db/id #edb/ref 17592186503661} {:db/id #edb/ref 17592186503729}] :knowledge-point/title "Solving Rational Equations with a Binomial and a Monomial in Denominators"} :step/id #uuid "13e292aa-c881-5526-9904-6d174bbb856b" :step/math-academy-id 15460 :step/next {:db/id #edb/ref 17592186060583}} {:db/id #edb/ref 17592186060583 :step/content {:db/id #edb/ref 17592186059709 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059522 :question/id #uuid "13f9fd01-802e-5331-b422-b9aa2cdda7ea" :question/math-academy-id "e-4236"} :knowledge-point/id #uuid "387a794f-17ea-5ea9-86a1-656a495f62cb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213}] :knowledge-point/questions [{:db/id #edb/ref 17592186060374} {:db/id #edb/ref 17592186060375} {:db/id #edb/ref 17592186234237} {:db/id #edb/ref 17592186503706} {:db/id #edb/ref 17592186540100}] :knowledge-point/title "Solving Rational Equations with Binomials in Both Denominators"} :step/id #uuid "634f203a-900b-5f9f-977b-e1bb2ab2c5ab" :step/math-academy-id 15461} {:db/id #edb/ref 17592186060674 :step/content {:db/id #edb/ref 17592186060937 :tutorial/content "Remember that to solve a rational equation, such as the one below, we can use cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{2}{x} & =\\frac{3}{5} \\\\ 5\\cdot 2 & =3\\cdot x \\\\ 10 & =3x \\\\ \\frac{10}{3} & =x\\end{aligned}\n$$\n\nHowever, there is also another method that we can use, known as the **flip method,** which involves taking the reciprocal of both sides of an equation. So, when an equation involves two fractions, we can \"flip\" them as follows:\n\n$$\n\\dfrac{a}{b} = \\dfrac{c}{d}\\quad\\Longrightarrow\\quad \\dfrac ba =\\dfrac dc\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nThe flip method is useful because it allows us to remove a variable from a denominator. For example, applying the flip method, we have\n\n$$\n\\dfrac{\\color{red}2}{\\color{blue}x}=\\dfrac{\\color{blue}3}{\\color{red}5}  \\quad\\Longrightarrow\\quad \\dfrac{\\color{blue}x}{\\color{red}2} = \\dfrac{\\color{red}5}{\\color{blue}3}.\n$$\n\nNow, we can solve the resulting equation using the multiplication principle:\n\n$$\n\\begin{aligned}2\\cdot \\frac{x}{2} & =2\\cdot \\frac{5}{3} \\\\ \\cancel{2}\\cdot \\frac{x}{\\cancel{2}} & =2\\cdot \\frac{5}{3} \\\\ x & =\\frac{10}{3}\\end{aligned}\n$$" :tutorial/id #uuid "33bd96be-8ef8-525c-be19-8590b4893b52" :tutorial/math-academy-id 3123 :tutorial/title "Introduction"} :step/id #uuid "b043ea3a-fd3a-5de4-b7ac-21a29627ca53" :step/math-academy-id 17016 :step/next {:db/id #edb/ref 17592186060580}}] :activity/title "Solving Rational Equations Using the Flip Method" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059941}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186540116} :activity/id #uuid "1c136286-07e7-54b0-87c2-d0c00e24e994" :activity/scope {:db/id #edb/ref 17592186050953 :topic/id #uuid "7525f3f4-fbe5-5024-8fab-55ad3066edd8" :topic/math-academy-id 266} :activity/steps [{:db/id #edb/ref 17592186540116 :step/content {:db/id #edb/ref 17592186060376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9afe93af-c815-5f2c-ac75-9a584d561ee5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186058879} {:answer/id #uuid "e4d50060-ed5a-55ba-98a5-e136d622f6bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186058880} {:answer/id #uuid "e6d7edad-f24a-5a39-b3a9-bdf0e222d37a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186058881} {:answer/id #uuid "3af8e372-8b94-5bca-966e-b13590d4c251" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{7}" :db/id #edb/ref 17592186058882} {:answer/id #uuid "4335e387-f8cb-50d1-a3a5-f1a739c9876b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186058883}] :answer-field/correct {:db/id #edb/ref 17592186058882} :answer-field/id #uuid "084ec80c-c0ed-58a4-b621-614f03d00659" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186058878}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "09320d7a-d867-531b-9740-66504912149d" :question/math-academy-id "q-67332" :question/problem "Solve the equation $\\frac{2}{3x+2}=-\\frac{4}{x}.$" :question/worked-solution "First, we note that\n\n- $x=-\\frac{2}{3}$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=0$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{3x+2}{2}=-\\frac{x}{4}\n$$\n\nNext, we write both fractions using the least common denominator $4,$ as follows:\n\n$$\n\\frac{6x+4}{4}=-\\frac{x}{4}\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}4\\cdot \\frac{6x+4}{4} & =4\\cdot (-\\frac{x}{4}) \\\\ 6x+4 & =-x \\\\ 6x+x & =-4 \\\\ x & =-\\frac{4}{7}\\end{aligned}\n$$"} :step/id #uuid "04bd31c0-ddc2-5b9c-ad07-d73251e35927" :step/next {:db/id #edb/ref 17592186540140}} {:db/id #edb/ref 17592186540123 :step/content {:db/id #edb/ref 17592186540100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d56b3b6-d2ee-5a6a-ac79-f166c602aad7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186539536} {:answer/id #uuid "5bbc6a18-26ef-5ee7-a216-046a93109cdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186539634} {:answer/id #uuid "684d8919-d630-53ec-be88-da83985b9cfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186539650} {:answer/id #uuid "adf72623-7732-5460-b0b6-5cc1011adb27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186539775} {:answer/id #uuid "f71975b1-e674-5e94-a227-f47c16e02797" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186539894}] :answer-field/correct {:db/id #edb/ref 17592186539894} :answer-field/id #uuid "746714c2-cc0f-5a43-9606-b934d8793273" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539966}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dba16e2f-f755-5c6f-b25b-801d348b9282" :question/math-academy-id "q-67435" :question/problem "Solve the equation $-\\frac{4}{x-2}=\\frac{1}{x-1}.$" :question/worked-solution "First, we note that\n\n- $x=2$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=1$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n-\\frac{x-2}{4}=\\frac{x-1}{1}\n$$\n\nNext, we write both fractions using the least common denominator, $4.$ The equation becomes\n\n$$\n-\\frac{x-2}{4}=\\frac{4x-4}{4}.\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}(-4)\\cdot (\\frac{x-2}{-4}) & =(-4)\\cdot \\frac{4x-4}{4} \\\\ x-2 & =-4x+4 \\\\ x+4x & =4+2 \\\\ 5x & =6 \\\\ (\\frac{1}{5})\\cdot (5x) & =(\\frac{1}{5})\\cdot (6) \\\\ (\\cancel{\\frac{1}{5}})\\cdot (\\cancel{5}x) & =(\\frac{1}{5})\\cdot (6) \\\\ x & =\\frac{6}{5}\\end{aligned}\n$$"} :step/id #uuid "128aaed4-1578-549e-bc3a-0ca44706efdb"} {:db/id #edb/ref 17592186540140 :step/content {:db/id #edb/ref 17592186540075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30e054d1-ef35-5151-b5a6-95077b0323c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186539572} {:answer/id #uuid "5deed0da-0520-5246-8e6c-365d802468b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186539637} {:answer/id #uuid "6c5af59e-eefa-5320-9d2c-7a4fb55193a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186539660} {:answer/id #uuid "a816dc9c-912f-5b96-8ae4-1b55000c74ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186539765} {:answer/id #uuid "b4e754c7-eafd-5c39-98a7-4f2732e90d24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186539791}] :answer-field/correct {:db/id #edb/ref 17592186539660} :answer-field/id #uuid "d7cb7b4d-8e3a-52e0-b39c-57977a95c75f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540000}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9929bc33-2631-5ab2-871b-80ee305fc700" :question/math-academy-id "q-67413" :question/problem "Solve the equation $\\frac{1}{x+5}=\\frac{1}{3}.$" :question/worked-solution "First, we note that $x=-5$ cannot be a solution since this would make the denominator on the left-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{x+5}{1}=\\frac{3}{1}\n$$\n\nThe above equation simplifies to\n\n$$\nx+5=3\n$$\n\nWe can now solve this equation using the addition principle:\n\n$$\n\\begin{aligned}x+5 & =3 \\\\ x+5-5 & =3-5 \\\\ x & =-2\\end{aligned}\n$$"} :step/id #uuid "5a1efe66-123d-5aba-9cc1-514789a8cab9" :step/next {:db/id #edb/ref 17592186540123}}] :activity/title "Solving Rational Equations Using the Flip Method" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186539465}]}
