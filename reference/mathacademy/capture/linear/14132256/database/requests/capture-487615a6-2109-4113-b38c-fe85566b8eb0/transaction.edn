632cab" :answer-field/id #uuid "48d79138-0de4-5b37-a697-7791eb632cab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d25d860e-1fb4-5651-a715-83172a0123b2" :answer-field/choices ["answer-d25d860e-1fb4-5651-a715-83172a0123b2" "answer-a3876dee-3617-5e7c-8c43-042cee4adc46" "answer-81421b5c-78a5-5f2f-8a83-40f1ed77d0ff" "answer-e11f82db-a662-5ea4-8bb1-1a4ab367c2f1" "answer-d880f55d-019e-5eac-b502-6db0c643fc16"] :db/ensure [:answer-field/validate]} {:db/id "answer-d25d860e-1fb4-5651-a715-83172a0123b2" :answer/id #uuid "d25d860e-1fb4-5651-a715-83172a0123b2" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-a3876dee-3617-5e7c-8c43-042cee4adc46" :answer/id #uuid "a3876dee-3617-5e7c-8c43-042cee4adc46" :answer/type :answer.type/math :answer/value "11\\,\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-81421b5c-78a5-5f2f-8a83-40f1ed77d0ff" :answer/id #uuid "81421b5c-78a5-5f2f-8a83-40f1ed77d0ff" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-e11f82db-a662-5ea4-8bb1-1a4ab367c2f1" :answer/id #uuid "e11f82db-a662-5ea4-8bb1-1a4ab367c2f1" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-d880f55d-019e-5eac-b502-6db0c643fc16" :answer/id #uuid "d880f55d-019e-5eac-b502-6db0c643fc16" :answer/type :answer.type/math :answer/value "8\\,\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "question-b0e3e224-39c7-55c1-9017-33330a41adbe" :question/id #uuid "b0e3e224-39c7-55c1-9017-33330a41adbe" :question/math-academy-id "q-211247" :question/problem "Expressed as a whole number, $1\\,\\frac{1}{4}\\times 4=${{field-1}}." :question/worked-solution "First, we write $1\\,\\frac{1}{4}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{4}=\\frac{(1\\times 4)+1}{4}=\\frac{5}{4}\n$$\n\n \n\nWe also write $4$ as an improper fraction:\n\n$$\n4=\\frac{4}{1}\n$$\n\nNow, we can multiply the numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{5}{4}\\times \\frac{4}{1}=\\frac{5\\times 4}{4\\times 1}=\\frac{20}{4}\n$$\n\nFinally, we reduce the fraction to its lowest terms by dividing the numerator and denominator by $4:$\n\n$$\n\\frac{20}{4}=\\frac{20÷4}{4÷4}=\\frac{5}{1}=5\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-96e2c959-f14f-5ca0-ae35-a6df8db1361c"] :db/ensure [:question/validate]} {:db/id "answer-field-96e2c959-f14f-5ca0-ae35-a6df8db1361c" :answer-field/id #uuid "96e2c959-f14f-5ca0-ae35-a6df8db1361c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f7b09085-3891-5561-b353-21ac0efa99c9" :answer-field/choices ["answer-f7b09085-3891-5561-b353-21ac0efa99c9"] :db/ensure [:answer-field/validate]} {:db/id "answer-f7b09085-3891-5561-b353-21ac0efa99c9" :answer/id #uuid "f7b09085-3891-5561-b353-21ac0efa99c9" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-d47e615f-58e6-5902-88f8-098ef1f1c1bf" :question/id #uuid "d47e615f-58e6-5902-88f8-098ef1f1c1bf" :question/math-academy-id "q-211242" :question/problem "Expressed as a mixed number in its lowest terms, $3\\times 1\\,\\frac{5}{6}=${{field-1}}." :question/worked-solution "First, we write $3$ as an improper fraction:\n\n$$\n3=\\frac{3}{1}\n$$\n\nWe also write $1\\,\\frac{5}{6}$ as an improper fraction:\n\n$$\n1\\,\\frac{5}{6}=\\frac{(1\\times 6)+5}{6}=\\frac{11}{6}\n$$\n\n \n\nNow, we can multiply the numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{3}{1}\\times \\frac{11}{6}=\\frac{3\\times 11}{1\\times 6}=\\frac{33}{6}\n$$\n\nNext, we reduce the fraction to its lowest terms by dividing the numerator and denominator by $3:$\n\n$$\n\\frac{33}{6}=\\frac{33÷3}{6÷3}=\\frac{11}{2}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{11}{2}=5\\,\\text{R}\\,1=5\\,\\frac{1}{2}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f81547da-6bae-513a-abe2-646392df8d00"] :db/ensure [:question/validate]} {:db/id "answer-field-f81547da-6bae-513a-abe2-646392df8d00" :answer-field/id #uuid "f81547da-6bae-513a-abe2-646392df8d00" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a4dc87ef-49ec-5a26-8d7d-9814e6a55889" :answer-field/choices ["answer-a4dc87ef-49ec-5a26-8d7d-9814e6a55889"] :db/ensure [:answer-field/validate]} {:db/id "answer-a4dc87ef-49ec-5a26-8d7d-9814e6a55889" :answer/id #uuid "a4dc87ef-49ec-5a26-8d7d-9814e6a55889" :answer/type :answer.type/math :answer/value "5\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-2f78e4f9-faf2-56cf-8be7-d24c50f82032" :question/id #uuid "2f78e4f9-faf2-56cf-8be7-d24c50f82032" :question/math-academy-id "q-172149" :question/problem "Expressed as a whole number, $8\\times 2\\,\\frac{1}{4}=${{field-1}}." :question/worked-solution "First, we write $8$ as an improper fraction:\n\n$$\n8=\\frac{8}{1}\n$$\n\nWe also write $2\\,\\frac{1}{4}$ as an improper fraction:\n\n$$\n2\\,\\frac{1}{4}=\\frac{(2\\times 4)+1}{4}=\\frac{9}{4}\n$$\n\nSo now, we need to solve the following multiplication problem:\n\n$$\n\\frac{8}{1}\\times \\frac{9}{4}\n$$\n\nNotice that the first fraction's numerator ($8$) and the second fraction's denominator ($4$) have a common factor of $4.$ \n\nTherefore, we can simplify our problem by swapping the denominators first and then multiplying the resulting fractions:\n\n$$\n\\begin{aligned}\\frac{8}{1}\\times \\frac{9}{4} & =\\frac{8}{4}\\times \\frac{9}{1} \\\\  & =2\\times 9 \\\\  & =18\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-0e7691d5-bf13-5c00-ad01-fd3ad7a8d134"] :db/ensure [:question/validate]} {:db/id "answer-field-0e7691d5-bf13-5c00-ad01-fd3ad7a8d134" :answer-field/id #uuid "0e7691d5-bf13-5c00-ad01-fd3ad7a8d134" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-eaa09e5d-517e-5def-8616-9f4be29780b0" :answer-field/choices ["answer-eaa09e5d-517e-5def-8616-9f4be29780b0"] :db/ensure [:answer-field/validate]} {:db/id "answer-eaa09e5d-517e-5def-8616-9f4be29780b0" :answer/id #uuid "eaa09e5d-517e-5def-8616-9f4be29780b0" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "question-9c5c53ba-1c75-5a47-95b1-d73845f940f1" :question/id #uuid "9c5c53ba-1c75-5a47-95b1-d73845f940f1" :question/math-academy-id "q-152213" :question/problem "What is the missing number in the following equality?\n\n$$\n4\\times 2\\,\\frac{3}{8}=\\frac{\\,\\boxed{}}{2}\n$$" :question/worked-solution "First, we write $4$ as an improper fraction:\n\n$$\n4=\\frac{4}{1}\n$$\n\n \n\nWe also write $2\\,\\frac{3}{8}$ as an improper fraction:\n\n$$\n2\\,\\frac{3}{8}=\\frac{(2\\times 8)+3}{8}=\\frac{19}{8}\n$$\n\n \n\nSo now, we need to solve the following multiplication problem:\n\n$$\n\\frac{4}{1}\\times \\frac{19}{8}\n$$\n\nNotice that the first fraction's numerator ($4$) and the second fraction's denominator ($8$) have a common \nfactor of $4.$ \n\nTherefore, we can simplify our problem by swapping the denominators first and then multiplying the resulting fractions:\n\n$$\n\\begin{aligned}\\frac{4}{1}\\times \\frac{19}{8} & =\\frac{4}{8}\\times \\frac{19}{1} \\\\  & =\\frac{1}{2}\\times 19 \\\\  & =\\frac{1\\times 19}{2} \\\\  & =\\frac{19}{2}\\end{aligned}\n$$\n\nTherefore, the missing number is $19.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-619772b1-03bb-5668-a2bf-c48fe85c504b"] :db/ensure [:question/validate]} {:db/id "answer-field-619772b1-03bb-5668-a2bf-c48fe85c504b" :answer-field/id #uuid "619772b1-03bb-5668-a2bf-c48fe85c504b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8e5fde2a-b199-51ce-9701-c3abab2da3c5" :answer-field/choices ["answer-87808bcc-62cf-5bcf-907c-267b5b7675b8" "answer-a556abeb-dc18-5303-8885-8834437da789" "answer-8e5fde2a-b199-51ce-9701-c3abab2da3c5" "answer-cc218119-3659-5c00-915c-b9f7bbfbd4e1" "answer-aabf682e-6c68-5e54-a165-196fe9036cb5"] :db/ensure [:answer-field/validate]} {:db/id "answer-87808bcc-62cf-5bcf-907c-267b5b7675b8" :answer/id #uuid "87808bcc-62cf-5bcf-907c-267b5b7675b8" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-a556abeb-dc18-5303-8885-8834437da789" :answer/id #uuid "a556abeb-dc18-5303-8885-8834437da789" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "answer-8e5fde2a-b199-51ce-9701-c3abab2da3c5" :answer/id #uuid "8e5fde2a-b199-51ce-9701-c3abab2da3c5" :answer/type :answer.type/math :answer/value "19" :db/ensure [:answer/validate]} {:db/id "answer-cc218119-3659-5c00-915c-b9f7bbfbd4e1" :answer/id #uuid "cc218119-3659-5c00-915c-b9f7bbfbd4e1" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-aabf682e-6c68-5e54-a165-196fe9036cb5" :answer/id #uuid "aabf682e-6c68-5e54-a165-196fe9036cb5" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id 17592186143304 :question/problem "What is the missing number in the following equality?\n\n$$\n3\\times 1\\,\\frac{2}{9}=\\frac{\\,\\boxed{}}{3}\n$$" :question/worked-solution "First, we write $3$ as an improper fraction:\n\n$$\n3=\\frac{3}{1}\n$$\n\n \n\nWe also write $1\\,\\frac{2}{9}$ as an improper fraction:\n\n$$\n1\\,\\frac{2}{9}=\\frac{(1\\times 9)+2}{9}=\\frac{11}{9}\n$$\n\n \n\nSo now, we need to solve the following multiplication problem:\n\n$$\n\\frac{3}{1}\\times \\frac{11}{9}\n$$\n\nNotice that the first fraction's numerator ($3$) and the second fraction's denominator ($9$) have a common \nfactor of $3.$ \n\nTherefore, we can simplify our problem by swapping the denominators first and then multiplying the resulting fractions:\n\n$$\n\\begin{aligned}\\frac{3}{1}\\times \\frac{11}{9} & =\\frac{3}{9}\\times \\frac{11}{1} \\\\  & =\\frac{1}{3}\\times 11 \\\\  & =\\frac{1\\times 11}{3} \\\\  & =\\frac{11}{3}\\end{aligned}\n$$\n\nTherefore, the missing number is $11.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186140793 :answer-field/correct 17592186140797 :db/ensure [:answer-field/validate]} {:db/id "question-bae0062b-f5ac-5baa-b921-966c2cbaf487" :question/id #uuid "bae0062b-f5ac-5baa-b921-966c2cbaf487" :question/math-academy-id "q-211376" :question/problem "Expressed as a mixed number in its lowest terms, $2\\,\\frac{3}{4}\\times 6=${{field-1}}." :question/worked-solution "First, we write $2\\,\\frac{3}{4}$ as an improper fraction:\n\n$$\n2\\,\\frac{3}{4}=\\frac{(2\\times 4)+3}{4}=\\frac{11}{4}\n$$\n\nWe also write $6$ as an improper fraction:\n\n$$\n6=\\frac{6}{1}\n$$\n\nSo now, we need to solve the following multiplication problem:\n\n$$\n\\frac{11}{4}\\times \\frac{6}{1}\n$$\n\nNotice that the first fraction's denominator ($4$) and the second fraction's numerator ($6$) have a common factor of $2.$ \n\nTherefore, we can simplify our problem by swapping the denominators first and then multiplying the resulting fractions:\n\n$$\n\\begin{aligned}\\frac{11}{4}\\times \\frac{6}{1} & =\\frac{11}{1}\\times \\frac{6}{4} \\\\  & =11\\times \\frac{3}{2} \\\\  & =\\frac{11\\times 3}{2} \\\\  & =\\frac{33}{2}\\end{aligned}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{33}{2}=16\\,\\text{R}\\,1=16\\,\\frac{1}{2}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8d73019f-d3f2-5f38-828d-bf81eb27a805"] :db/ensure [:question/validate]} {:db/id "answer-field-8d73019f-d3f2-5f38-828d-bf81eb27a805" :answer-field/id #uuid "8d73019f-d3f2-5f38-828d-bf81eb27a805" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bf7497c0-fde9-594c-af55-8f063361d71e" :answer-field/choices ["answer-bf7497c0-fde9-594c-af55-8f063361d71e"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf7497c0-fde9-594c-af55-8f063361d71e" :answer/id #uuid "bf7497c0-fde9-594c-af55-8f063361d71e" :answer/type :answer.type/math :answer/value "16\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-545b365b-c759-5099-8acb-b948f190db31" :question/id #uuid "545b365b-c759-5099-8acb-b948f190db31" :question/math-academy-id "q-211378" :question/problem "Expressed as a mixed number in its lowest terms, $1\\,\\frac{1}{20}\\times 10=${{field-1}}." :question/worked-solution "First, we write $1\\,\\frac{1}{20}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{20}=\\frac{(1\\times 20)+1}{20}=\\frac{21}{20}\n$$\n\nWe also write $10$ as an improper fraction:\n\n$$\n10=\\frac{10}{1}\n$$\n\nSo now, we need to solve the following multiplication problem:\n\n$$\n\\frac{21}{20}\\times \\frac{10}{1}\n$$\n\nNotice that the first fraction's denominator ($20$) and the second fraction's numerator ($10$) have a common factor of $10.$ \n\nTherefore, we can simplify our problem by swapping the denominators first and then multiplying the resulting fractions:\n\n$$\n\\begin{aligned}\\frac{21}{20}\\times \\frac{10}{1} & =\\frac{21}{1}\\times \\frac{10}{20} \\\\  & =21\\times \\frac{1}{2} \\\\  & =\\frac{21\\times 1}{2} \\\\  & =\\frac{21}{2}\\end{aligned}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{21}{2}=10\\,\\text{R}\\,1=10\\,\\frac{1}{2}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-500fab62-64f2-56e7-a7de-5a97cade7517"] :db/ensure [:question/validate]} {:db/id "answer-field-500fab62-64f2-56e7-a7de-5a97cade7517" :answer-field/id #uuid "500fab62-64f2-56e7-a7de-5a97cade7517" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-60a6543d-449f-5db9-b18a-be345713e19b" :answer-field/choices ["answer-60a6543d-449f-5db9-b18a-be345713e19b"] :db/ensure [:answer-field/validate]} {:db/id "answer-60a6543d-449f-5db9-b18a-be345713e19b" :answer/id #uuid "60a6543d-449f-5db9-b18a-be345713e19b" :answer/type :answer.type/math :answer/value "10\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id 17592186144068 :tutorial/content "Suppose we want to multiply a mixed number by a whole number:\n\n$$\n3\\times 2\\,\\dfrac 3{4}\n$$\n\nTo do this, we perform the following steps:\n\n**Step 1:** Convert both numbers to improper fractions. Here, the number $3$ can be expressed as the improper fraction\n\n$$\n3=\\dfrac{3}{1},\n$$\n\nand the mixed number $2\\,\\dfrac 3{4}$ can be expressed as the improper fraction\n\n$$\n2\\,\\dfrac 3{4}=\\dfrac{(2\\times 4)+3}{4}= \\dfrac {11} {4}.\n$$\n\n**Step 2:** Multiply the resulting fractions together. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac{3}{1}\\times\\dfrac {11} {4}=  \\dfrac {3\\times 11} {1\\times 4} = \\dfrac{33}{4}\n$$\n\n**Step 3:** Simplify or convert back to a mixed number (if necessary):\n\n$$\n\\dfrac{33}{4} =8\\,\\textrm{R} 1 = 8\\,\\dfrac 1 {4}\n$$\n\nTherefore, the final result is\n\n$$\n3\\times 2\\,\\dfrac 3{4} = 8\\,\\dfrac 1 {4}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186143014 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]}]
