#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186134997} :activity/id #uuid "dc51c5b9-0f8c-57e5-946b-c5bfeae6dba2" :activity/scope {:db/id #edb/ref 17592186048587 :topic/id #uuid "abf13c19-9dcf-557d-a2d7-edd69fa99577" :topic/math-academy-id 2172} :activity/steps [{:db/id #edb/ref 17592186134898 :step/content {:db/id #edb/ref 17592186133909 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133464 :question/id #uuid "deb87162-187a-5f89-9157-b84b5d8178f7" :question/math-academy-id "e-10592"} :knowledge-point/id #uuid "816d35ed-007d-58b9-9c59-16302359e658" :knowledge-point/questions [{:db/id #edb/ref 17592186134120} {:db/id #edb/ref 17592186134170} {:db/id #edb/ref 17592186430899} {:db/id #edb/ref 17592186430905} {:db/id #edb/ref 17592186430909}] :knowledge-point/title "Determining an Angle With a Given Measure"} :step/id #uuid "2e496789-9ea0-5bca-a027-c4dce8a20217" :step/math-academy-id 40044 :step/next {:db/id #edb/ref 17592186134899}} {:db/id #edb/ref 17592186134899 :step/content {:db/id #edb/ref 17592186133910 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133465 :question/id #uuid "5df19497-b07f-57e3-9589-a488291147bf" :question/math-academy-id "e-10600"} :knowledge-point/id #uuid "773c6135-d786-593d-8fa6-92e929904554" :knowledge-point/questions [{:db/id #edb/ref 17592186134121} {:db/id #edb/ref 17592186134172} {:db/id #edb/ref 17592186430900} {:db/id #edb/ref 17592186430902} {:db/id #edb/ref 17592186430904} {:db/id #edb/ref 17592186430908} {:db/id #edb/ref 17592186430910}] :knowledge-point/title "Reading the Measure of an Angle"} :step/id #uuid "d11adfce-8cff-56d1-933a-33d75274ecc7" :step/math-academy-id 40082} {:db/id #edb/ref 17592186134900 :step/content {:db/id #edb/ref 17592186135150 :tutorial/content "The **measure** of an angle is the amount of \"turn\" from one side of the angle to the other. \n\nWe measure angles in **degrees**, which have the symbol $^\\circ.$ \n\nLet's look at a few examples of angles with their measures.\n\n![](images/7c/7c8a1fb7268052f44c88734607cd8e38ae8b57b924ec9fb65a6cb8918c60266f.png)\n\nNote the following:\n\n- The more \"turn\" there is, the larger the angle's measure.\n\n- A corner angle (like the angle $C$ above) has a measure of $90^\\circ.$ An angle with measure $90^\\circ$ is called a **right angle.**\n\nWe use the letter $m$ to represent the measure of the angle. For example,\n\n$$\nm \\angle C = 90^\\circ.\n$$\n\nWe'd read this as \"the measure of the angle $C$ is $90$ degrees.\"" :tutorial/id #uuid "90b2ad8a-62aa-50c2-a1d2-0ff4f1a62e0a" :tutorial/math-academy-id 6649 :tutorial/title "Angle Measures"} :step/id #uuid "05cb3abe-c72e-5327-a20e-92f160937267" :step/math-academy-id 40246 :step/next {:db/id #edb/ref 17592186134898}} {:db/id #edb/ref 17592186134997 :step/content {:db/id #edb/ref 17592186135018 :tutorial/content "An **angle** is formed whenever two rays meet at a point. \n\nThe common point shared by the rays is called the **vertex**, and the rays themselves are called the **sides** of the angle.\n\n![](images/ca/caa6fe6d949902d06c155f109fc2202bc4adbfc0c324591100a56337f6841279.png)\n\nConsider the following angle, made up of the rays $\\overrightarrow{{\\color{blue}{A}}B}$ and $\\overrightarrow{{\\color{blue}{A}}C}.$\n\n![](images/d4/d4a10fda5cbf508754812bb114e80de3f3aad529c54d6b82538284bda58cd737.png)\n\nThere are several different ways of labeling this angle.\n\n- One way to write this angle is as follows:\n\n$$\n\\angle C\\!{\\color{blue}{A}}B\n$$\n\n \nThe symbol $\\angle$ means \"angle.\" Notice that the vertex ${\\color{blue}{A}}$ is in the middle.\n\n- We can also swap the order in which we write the endpoints. For example,\n\n$$\n\\angle B{\\color{blue}{A}}C.\n$$\n\n \nNotice that the vertex ${\\color{blue}{A}}$ is still in the middle.\n\n- To save space, we sometimes write $\\angle {\\color{blue}{A}}.$\n\n- Finally, instead of using the $\\angle$ symbol, we can write $\\widehat{C{\\color{blue}{A}}B}$ or $\\widehat{B{\\color{blue}{A}}C}.$" :tutorial/id #uuid "991904e0-131d-59ea-b73b-080a9980bb0b" :tutorial/math-academy-id 2176 :tutorial/title "Introduction"} :step/id #uuid "b3be408b-fdab-59b5-8032-c20d6f2f3e1f" :step/math-academy-id 8742 :step/next {:db/id #edb/ref 17592186134998}} {:db/id #edb/ref 17592186134998 :step/content {:db/id #edb/ref 17592186133970 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133540 :question/id #uuid "ebc8ba04-2c55-56bd-b07c-f5f95d0841c1" :question/math-academy-id "e-2584"} :knowledge-point/id #uuid "d7eff006-e868-5994-a895-708ff74808b4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049350}] :knowledge-point/questions [{:db/id #edb/ref 17592186134169} {:db/id #edb/ref 17592186134171} {:db/id #edb/ref 17592186430901} {:db/id #edb/ref 17592186430903} {:db/id #edb/ref 17592186430906} {:db/id #edb/ref 17592186430907}] :knowledge-point/title "Expressing Angles Using Angle Notation"} :step/id #uuid "0dd5b67f-90da-5d21-877f-0ab2cd46b804" :step/math-academy-id 8752 :step/next {:db/id #edb/ref 17592186134900}}] :activity/title "Angles and Measures of Angles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134032}]}
