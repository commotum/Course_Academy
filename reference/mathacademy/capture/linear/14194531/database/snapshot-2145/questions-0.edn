#{[{:db/id #edb/ref 17592186110310 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110732 :knowledge-point/id #uuid "cf40e17e-0461-54a3-8f23-8424d694f189" :knowledge-point/title "Sketching the Graph of an Exponential Growth Function"}] :question/id #uuid "99ab6141-164f-5f36-b55b-6e7fa1c8770c" :question/math-academy-id "e-1215" :question/problem "Sketch the graph of $f(x)=3^x$." :question/worked-solution "The graph of $y=3^x$ has a $y$-intercept at $(0,1)$, grows rapidly for $x>0$, and approaches the asymptote $y=0$ for $x<0$.\n\nWhen $x=1$, we have $y=3^1 = 3$. Therefore, another point on the graph is $(1,3)$.\n\nWe draw the graph through this point as follows:\n\n![](images/43/4367540979396fd0106204a0f71d9368a70ce3538d8e7239ac250e5fc45644f1.png)"}] [{:db/id #edb/ref 17592186110311 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110733 :knowledge-point/id #uuid "f6fa9e7b-172d-57b6-8b6e-0db0f8f802ad" :knowledge-point/title "Identifying True Statements about Exponential Growth Functions"}] :question/id #uuid "45473f44-206e-5eb6-a663-04d264e6a890" :question/math-academy-id "e-1216" :question/problem "Which of the following statements are true in relation to the function $f(x) = 3^x$?\n\n1. It passes through the point $(1,3)$.\n2. $f(x)\\rightarrow -\\infty$ as $x\\rightarrow -\\infty$.\n3. The graph of $y=f(x)$ has a vertical asymptote $x=0$." :question/worked-solution "Let's start by recalling the graph of $y=3^x$:\n\n![](images/83/837e535b83d91c67e7e5c592bd71e9b9ebe59c216fc75ba4f99de2ccec2546ae.png)\n\nNow, let's look at each statement:\n\n- Statement I is true because $f(1) = 3^1 = 3$.\n- Statement II is false, since $f(x)\\rightarrow 0$ as $x\\rightarrow -\\infty$.\n- Statement III is false. The graph has a *horizontal* asymptote $y=0$.\n\nIn conclusion, only statement I is true."}] [{:db/id #edb/ref 17592186110312 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110735 :knowledge-point/id #uuid "f8a6ac29-44ee-5305-be7a-41f9ae742756" :knowledge-point/title "Plotting a Vertically Compressed Exponential Growth Function"}] :question/id #uuid "3661675e-e7da-5834-97cf-017e4e084275" :question/math-academy-id "e-1217" :question/problem "Plot the graph of $y=\\dfrac{1}{2}(2)^x$." :question/worked-solution "First we plot the graph of $y=2^{x}$:\n\n![](images/94/946d749b38d09eebd11eba2821be07e61c6551f17ab9cff0149cdbf600257796.png)\n\nThen, we scale this graph vertically by a factor of\n\n$$\n\\dfrac12\n$$\n\nThe $y$-intercept becomes\n\n$$\n\\left(0,\\dfrac{1}{2} \\right)\n$$\n\nand the resulting graph is as follows:\n\n![](images/bc/bc971bc35c4f54baba330aa074bf9618fb7a755593f5f9e713bcc90142da6394.png)"}] [{:db/id #edb/ref 17592186110369 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110734 :knowledge-point/id #uuid "c7654997-ee9a-5d6c-88e9-d46f36bd8e88" :knowledge-point/title "Plotting a Vertically Stretched Exponential Growth Function"}] :question/id #uuid "e5680653-d529-58df-b243-7447db0a750a" :question/math-academy-id "e-1802" :question/problem "Plot the graph of $y=3(2^x)$." :question/worked-solution "First we plot the graph of $y=2^{x}$:\n\n![](images/f2/f2200a327b3c85d190638befc03655296be954d668d96a55d060d4d9b3791148.png)\n\nThen, we scale this graph vertically by a factor of $3$. The $y$-intercept becomes\n\n$$\n\\left(0,3 \\right)\n$$\n\nand the resulting graph is as follows:\n\n![](images/ab/abcd2227ca143b42f5dc09523c4a0e944af2316e048fdea35c507bcbd1bb7310.png)"}] [{:db/id #edb/ref 17592186110930 :knowledge-point/_questions [{:db/id #edb/ref 17592186110735 :knowledge-point/id #uuid "f8a6ac29-44ee-5305-be7a-41f9ae742756" :knowledge-point/title "Plotting a Vertically Compressed Exponential Growth Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccd936dc-2ce3-5688-b56a-b0ecc37f257e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186107472} {:answer/id #uuid "20250a95-7a58-50a2-86af-ac75707f5323" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186107473} {:answer/id #uuid "425ef207-4465-55fb-b916-bb50e95c3ce5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186107474} {:answer/id #uuid "4c919938-5471-5d61-a615-93a4783683e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186107475} {:answer/id #uuid "64d5485a-0b3b-5a3a-897b-2ac54cc10627" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186107476}] :answer-field/id #uuid "6e137d62-178c-54b4-8967-9073e2828a76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186107471}] :question/id #uuid "afce8b19-fb25-5544-97f9-8f9caa8b68b1" :question/math-academy-id "q-166992" :question/problem "Which of the following statements are true in relation to the function $f(x) = \\frac{2}{7}(\\frac{3}{2})^{x}$?\n\n1. Its range is $(\\frac{2}{7}, ∞)$.\n2. Its domain is $(\\frac{3}{2}, ∞)$.\n3. It passes through the point $(1, \\frac{3}{7})$."}] [{:db/id #edb/ref 17592186111100 :knowledge-point/_questions [{:db/id #edb/ref 17592186110735 :knowledge-point/id #uuid "f8a6ac29-44ee-5305-be7a-41f9ae742756" :knowledge-point/title "Plotting a Vertically Compressed Exponential Growth Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a18354ce-313b-5089-ba4c-294b89d6dc00" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cd/cd9912eac35d5df094d33c56e83d223be04aeda88313f4bcc61ea55ca7f0e921.png" :db/id #edb/ref 17592186108341} {:answer/id #uuid "beaa25aa-4be8-54e5-9ae8-7db5540a76c1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image