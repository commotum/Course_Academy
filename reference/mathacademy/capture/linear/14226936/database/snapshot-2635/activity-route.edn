#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186547106} :activity/id #uuid "fbcd23bd-0b5e-522e-a224-1cd518e64d90" :activity/scope {:db/id #edb/ref 17592186049619 :topic/id #uuid "0536fa23-cd17-50b6-b180-7b50962fb1ee" :topic/math-academy-id 1153} :activity/steps [{:db/id #edb/ref 17592186547099 :step/content {:db/id #edb/ref 17592186547021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc0268ec-d8fa-5068-89a2-d047adff26bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "162" :db/id #edb/ref 17592186546737}] :answer-field/correct {:db/id #edb/ref 17592186546737} :answer-field/id #uuid "a498868f-8302-53e1-96f6-a5c4ab372013" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546906}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7a913f31-a39a-5842-bec8-7be0ed73cc2a" :question/math-academy-id "q-218599" :question/problem "If $f(x)=A\\cdot {(\\frac{1}{3})}^{x}$ and $f(4)=2,$ then $A=${{field-1}}." :question/worked-solution "We substitute $x=4$ and $f(x)=2$ into the expression for $f(x)$ and solve for $A,$ as follows:\n\n$$\n\\begin{aligned}2 & =A\\cdot {(\\frac{1}{3})}^{4} \\\\ 2 & =A\\cdot (\\frac{{1}^{4}}{{3}^{4}}) \\\\ 2 & =A\\cdot \\frac{1}{81} \\\\ 2\\cdot 81 & =A \\\\ 162 & =A\\end{aligned}\n$$\n\nTherefore, $A=162.$"} :step/id #uuid "24c4d8ea-2c2d-5bf1-8012-7f901ed738b4"} {:db/id #edb/ref 17592186547106 :step/content {:db/id #edb/ref 17592186547010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb188b7-1bba-52cb-abb3-fd6aed751092" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "42" :db/id #edb/ref 17592186546280} {:answer/id #uuid "2544cee4-9901-5260-a310-d276e35ad5bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186546333} {:answer/id #uuid "3735ad7d-4556-5e39-a71d-f32c39e15424" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "48" :db/id #edb/ref 17592186546370} {:answer/id #uuid "8720c01d-8df0-5742-be97-36d70ae63773" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "96" :db/id #edb/ref 17592186546550} {:answer/id #uuid "8a0d70e3-37d6-5e7a-96ef-4b4a41e04706" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186546554}] :answer-field/correct {:db/id #edb/ref 17592186546370} :answer-field/id #uuid "84915d34-7d23-593e-8953-0481a5d952d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186546887}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5d902ef6-57b9-5fc3-a3a5-f189fbbd0124" :question/math-academy-id "q-61724" :question/problem "If $g(x)=M\\cdot {(\\frac{1}{2})}^{x}$ and $g(4)=3,$ then $M=$" :question/worked-solution "We substitute $x=4$ and $g(x)=3$ into the expression for $g(x)$ and solve for $M,$ as follows:\n\n$$\n\\begin{aligned}3 & =M\\cdot {(\\frac{1}{2})}^{4} \\\\ 3 & =M\\cdot (\\frac{{1}^{4}}{{2}^{4}}) \\\\ 3 & =M\\cdot \\frac{1}{16} \\\\ 3\\cdot 16 & =M \\\\ 48 & =M\\end{aligned}\n$$\n\nTherefore, $M=48.$"} :step/id #uuid "400b2935-82a5-5288-b8ed-ee8bd5f66ac6" :step/next {:db/id #edb/ref 17592186547144}} {:db/id #edb/ref 17592186547144 :step/content {:db/id #edb/ref 17592186547051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32f86ea7-b245-5854-99ca-445e07a33913" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "192" :db/id #edb/ref 17592186546361} {:answer/id #uuid "345e8697-48b9-551d-896e-1cee7485be04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "248" :db/id #edb/ref 17592186546364} {:answer/id #uuid "4fb74a52-e9ea-5852-b670-f8fc81bc2b9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "320" :db/id #edb/ref 17592186546424} {:answer/id #uuid "9ff1664d-bf13-5f15-9c2d-ee07c74dcf74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "96" :db/id #edb/ref 17592186546607} {:answer/id #uuid "c656e398-ebf6-5ea7-85fa-6a3e66c74967" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "384" :db/id #edb/ref 17592186546692}] :answer-field/correct {:db/id #edb/ref 17592186546361} :answer-field/id #uuid "a47053c5-18d3-5ce9-95e6-882a410af16b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186546904}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c55619be-bc04-5da4-9e98-241a09beba3a" :question/math-academy-id "q-112141" :question/problem "The growth of a mice colony is given by the formula $M(t)=6\\cdot {2}^{t},$ where $t$ is the time, in months, since the beginning of the observation. How many mice will the colony have after $5$ months?" :question/worked-solution "To get the number of mice in the colony after $5$ months, we evaluate the function at $t=5.$ Substituting $t=5$ into the function $M(t)$ gives\n\n$$\n\\begin{aligned}M(5) & =6\\cdot {2}^{5} \\\\  & =6\\cdot 32 \\\\  & =192.\\end{aligned}\n$$\n\n \n\nTherefore, after $5$ months there will be $192$ mice in the colony."} :step/id #uuid "b7c0f0f3-0bc3-52e8-9529-1d0edd9dbc37" :step/next {:db/id #edb/ref 17592186547099}}] :activity/title "Exponential Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186546253}]}
