#{[{:db/id #edb/ref 17592186092510 :knowledge-point/_questions [{:db/id #edb/ref 17592186092385 :knowledge-point/id #uuid "3ba61258-92a9-511e-891f-9e6adce2edb0" :knowledge-point/title "Determining the Intercepts of a Normal Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "142b6536-fed4-529f-ac1d-8a42fc666730" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186244498} {:answer/id #uuid "65112d5b-e5af-58b2-8b42-2fafe84f3bf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186245208} {:answer/id #uuid "6e29c4b1-5a97-5a97-bbf2-51eabed39e9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{5}{2})" :db/id #edb/ref 17592186245289} {:answer/id #uuid "ca93f7a3-eace-5053-ae98-706828a1b4af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{1}{2})" :db/id #edb/ref 17592186246111} {:answer/id #uuid "d23fbfd4-1cbd-54d1-aa24-886860426aba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186246184}] :answer-field/correct {:answer/id #uuid "d23fbfd4-1cbd-54d1-aa24-886860426aba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186246184} :answer-field/id #uuid "816b14ca-c9ce-5b90-8b9c-06306f5bacc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246773}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24c7ef87-44ff-5aaa-8c80-717e24087d16" :question/math-academy-id "q-11124" :question/problem "Find where the normal line to the curve $f(x)=2\\sqrt{x}$ at the point $(1,2)$ intersects the $y$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\sqrt{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{1/2}) \\\\  & ={x}^{-1/2} \\\\  & =\\frac{1}{\\sqrt{x}}.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(1)=\\frac{1}{\\sqrt{1}}=1,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-1.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-2 & =-1(x-1) \\\\ y & =-x+1+2 \\\\ y & =-x+3.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $y$-axis by setting $x=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}y & =-0+3 \\\\ y & =3.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $y$-axis at  $(0,3).$"}] [{:db/id #edb/ref 17592186547057 :knowledge-point/_questions [{:db/id #edb/ref 17592186092240 :knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e827c707-4183-5bda-8490-ae6373ae9ace" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186546771}] :answer-field/correct {:answer/id #uuid "e827c707-4183-5bda-8490-ae6373ae9ace" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186546771} :answer-field/id #uuid "aa428138-3fdd-52e3-90d7-e57b79a7836a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186546911} {:answer-field/choices [{:answer/id #uuid "85168c9f-eca2-5f20-86c3-38ab8f99e07f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186546543}] :answer-field/correct {:answer/id #uuid "85168c9f-eca2-5f20-86c3-38ab8f99e07f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186546543} :answer-field/id #uuid "e1fb6fa9-d25d-5930-b90b-ff3334996e24" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186546939}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d27eb9e3-1a36-5293-b88b-ba67a6d55870" :question/math-academy-id "q-342187" :question/problem "Find the equation of the normal line to the curve $y=4x-\\frac{2}{x}$ at the point $(-1,-2).$\n\n$x\\,+$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" :question/worked-solution "Let $f(x)=4x-\\frac{2}{x}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4x-\\frac{2}{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4x-2{x}^{-1}) \\\\  & =4+2{x}^{-2} \\\\  & =4+\\frac{2}{{x}^{2}}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(-1,-2):$\n\n$$\nm={f}^{′}(-1)=4+\\frac{2}{(-1)^{2}}=4+2=6\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{6}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(-2) & =-\\frac{1}{6}[x-(-1)] \\\\ -6(y+2) & =x+1 \\\\ -6y-12 & =x+1 \\\\ x+6\\cdot y & =-13.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092722 :knowledge-point/_questions [{:db/id #edb/ref 17592186092240 :knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3826d54-f39e-5e45-982c-0196c96b30c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "77" :db/id #edb/ref 17592186090533} {:answer/id #uuid "bf822091-623a-5b75-a700-06562c3fa7b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "74" :db/id #edb/ref 17592186090534} {:answer/id #uuid "c014a862-aa95-5ee5-8cc4-90a1115cf633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186090535} {:answer/id #uuid "e535f72e-5b43-5878-a978-9a20e1d8470d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186090536} {:answer/id #uuid "48a27df3-0a04-52a4-9003-fd2c61c07e74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186090537}] :answer-field/correct {:answer/id #uuid "bf822091-623a-5b75-a700-06562c3fa7b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "74" :db/id #edb/ref 17592186090534} :answer-field/id #uuid "7907bce1-6e91-548c-bf8c-f50341390d5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090532}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2a649b33-83ae-5424-9852-7d09d082fffc" :question/math-academy-id "q-47406" :question/problem "The equation of the normal line to the curve $y=2{x}^{2}$ at the point $(2,8)$ is given by $x+py=q$ where $p$ and $q$ are constants. Find the value of $p+q.$" :question/worked-solution "Let $f(x)=2{x}^{2}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})=4x\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,8):$\n\n$$\n\\begin{aligned}m={f}^{′}(2)=4(2)=8\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{8}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-8 & =-\\frac{1}{8}(x-2) \\\\ 8y-64 & =-x+2 \\\\ x+8y & =66.\\end{aligned}\n$$\n\nTherefore, $p+q=8+66=74.$"}]}
