    "q-164597": {
      "dom_id": "step-q164597",
      "name": "Question 8",
      "problem": "An online retailer guarantees $1\\,\\text{day}$ delivery for orders placed on their platform. What is this time in hours?",
      "worked_solution": "A table showing the units of time is given below.\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Second | $\\text{s}$ | $-$ |\n| Minute | $\\text{min}$ | $1\\,\\text{min}=60\\,\\text{s}$ |\n| Hour | $\\text{h}$ | $1\\,\\text{h}=60\\,\\text{min}$ |\n| Day | $-$ | $1\\,\\text{day}=24\\,\\text{h}$ |\n| Week | $-$ | $1\\,\\text{week}=7\\,\\text{days}$ |\n\nTherefore, $1\\,\\text{day}$ is equivalent to $24\\,\\text{h}.$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-164597-a",
              "type": "math",
              "value": "24\\,\\text{h}",
              "html": "<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"88\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c68\"></mjx-c></mjx-mtext></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>24</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>h</mtext></math></mjx-assistive-mml></mjx-container>"
            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-164597-b",
