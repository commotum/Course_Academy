    "q-164568": {
      "dom_id": "step-q164568",
      "name": "Question 1",
      "problem": "Adults' heartbeats have an average time duration of $1\\,\\text{s}.$ What is this time in milliseconds?",
      "worked_solution": "A table showing the metric units of time is given below.\n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Second | $\\text{s}$ | Base Unit |\n| Millisecond | $\\text{ms}$ | $1\\,000\\,\\text{ms}=1\\,\\text{s}$ |\n\nTherefore, $1\\,\\text{s}$ is equivalent to $1\\,000\\,\\text{ms}.$",
