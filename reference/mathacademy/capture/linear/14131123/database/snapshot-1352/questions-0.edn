#{[{:db/id #edb/ref 17592186198062 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198420 :knowledge-point/id #uuid "c8bea365-3b4d-5421-88d0-a4291ba37810" :knowledge-point/title "Metric Units of Time"}] :question/id #uuid "8f99f10e-a1bb-5725-a43b-ab556bc3a105" :question/math-academy-id "e-12497" :question/problem "Suppose we want to measure the duration of the collision between two billiard balls. Which metric unit could we use?\n\n1. $\\textrm{kg}$\n2. $\\textrm{m}$\n3. $\\textrm{ms}$" :question/worked-solution "A table showing the metric units of time is given below.\n\n| Name | Symbol |\n| --- | ---: |\n| Second | $\\textrm{s}$ |\n| Millisecond | $\\textrm{ms}$ |\n\nTherefore, from the given options, the only unit of time is $\\textrm{ms}$."}] [{:db/id #edb/ref 17592186198070 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198428 :knowledge-point/id #uuid "db1c1c29-c709-5d2d-aa49-b018d7d895ae" :knowledge-point/title "Identifying Conversions Between Time Units"}] :question/id #uuid "0353f3c2-288d-5107-b292-a685263cf848" :question/math-academy-id "e-12519" :question/problem "A fitness class lasts exactly $1\\,\\textrm{h}$. What is this time in minutes?" :question/worked-solution "A table showing the units of time is given below.\n\n| Name | Symbol | Conversion |\n| --- | ---: | ---: |\n| Second | $\\textrm{s}$ | $-$ |\n| Minute | $\\textrm{min}$ | $1\\,\\textrm{min} = 60\\,\\textrm{s}$ |\n| Hour | $\\textrm{h}$ | $1\\,\\textrm{h} = 60\\,\\textrm{min}$ |\n| Day | $-$ | $1\\,\\textrm{day} = 24\\,\\textrm{h}$ |\n| Week | $-$ | $1\\,\\textrm{week} = 7\\,\\textrm{days}$ |\n\nTherefore, $1\\,\\textrm{h}$ is equivalent to $60\\,\\textrm{min}$."}] [{:db/id #edb/ref 17592186198666 :knowledge-point/_questions [{:db/id #edb/ref 17592186198428 :knowledge-point/id #uuid "db1c1c29-c709-5d2d-aa49-b018d7d895ae" :knowledge-point/title "Identifying Conversions Between Time Units"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08e04789-e3f6-54ec-a4e6-bcbcefcce0df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10h" :db/id #edb/ref 17592186194628} {:answer/id #uuid "11bce5e4-ccdd-5a30-8114-ee87a091cef0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100h" :db/id #edb/ref 17592186194629} {:answer/id #uuid "16adad2a-b28e-5c2e-b6a9-45b75e053dc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24h" :db/id #edb/ref 17592186194630} {:answer/id #uuid "267b1fa0-8119-585d-8a99-234c009072e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7h" :db/id #edb/ref 17592186194631} {:answer/id #uuid "4040586f-6598-5a95-9d50-6a38c5df5cb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60h" :db/id #edb/ref 17592186194632}] :answer-field/id #uuid "9428eac1-6939-5721-abc2-47d230494934" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186194627}] :question/id #uuid "ba5e3056-3ad1-50fd-9a05-869df9182fac" :question/math-academy-id "q-163648" :question/problem "A journey between two locations lasts exactly $1day$. What is this time in hours?"}]}
