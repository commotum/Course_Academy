  "live_records": {
    "q-46278": {
      "dom_id": "step-q46278",
      "name": "Question 1",
      "problem": "Mr. Smith owns a factory where pants are made. To make these pants, the factory has several sewing machines. Mr. Smith wishes to determine the rate at which the number of pants increases with the number of sewing machines. What is an appropriate unit for Mr. Smith's purpose?",
      "worked_solution": "We *measure the change* in the number of pants, as *we change* the number of sewing machines. Consequently, any appropriate unit must take the form\n\n$$\n\\frac{\\text{unit of pants}}{\\text{unit of sewing machines}}.\n$$\n\nTherefore, among the given options, the only correct one is \"pants per sewing machine.\"",
      "calculator_instructions": "",
      "fields": [
        {
