#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186139371} :activity/id #uuid "ddf9f6c0-2c82-5508-b796-5212ce1fc527" :activity/scope {:db/id #edb/ref 17592186049092 :topic/id #uuid "d9ba8adc-063a-54f1-8d4e-3ac01a6c2237" :topic/math-academy-id 2231} :activity/steps [{:db/id #edb/ref 17592186139371 :step/content {:db/id #edb/ref 17592186139598 :tutorial/content "Sometimes, when we are choosing an appropriate unit, we are not given any formula to use. \n\nThis often occurs when we measure the **rate of change** of something. A rate of change measures how much something changes as we change something else.\n\nIn such cases, we can use a quotient to work out an appropriate unit. The numerator is what we measure the change of, and the denominator is what we change:\n\n$$\n\\dfrac{\\color{blue}\\textrm{what we measure the change of}}{\\color{red}\\textrm{what we change}}\n$$\n\nFor instance, suppose that a newly opened store wants to measure the rate at which the number of customers increases each day.\n\nWe *measure the change* of the number of customers, as *we change* the number of days, so the most appropriate unit is\n\n$$\n\\dfrac{\\color{blue}\\textrm{customers}}{\\color{red}\\textrm{day}},\n$$\n\nor, customers per day." :tutorial/id #uuid "56217ef8-a09e-5cdd-91f3-7f35d3cba561" :tutorial/math-academy-id 1401 :tutorial/title "Introduction"} :step/id #uuid "81f48e8d-1f8d-5602-aaa8-6dbfe592f877" :step/math-academy-id 3029 :step/next {:db/id #edb/ref 17592186139372}} {:db/id #edb/ref 17592186139372 :step/content {:db/id #edb/ref 17592186138440 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138313 :question/id #uuid "66c31f3c-2abb-51ff-b8d5-8377aeb90d80" :question/math-academy-id "e-901"} :knowledge-point/id #uuid "86db8dde-c4ad-5ba3-9022-afe85acbc3d8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050076}] :knowledge-point/questions [{:db/id #edb/ref 17592186138794} {:db/id #edb/ref 17592186138819} {:db/id #edb/ref 17592186496240} {:db/id #edb/ref 17592186496253}] :knowledge-point/title "Choosing Appropriate Units When Base Units Are Not Required"} :step/id #uuid "fc01ce33-f078-54a8-aba9-533e122ac058" :step/math-academy-id 3033 :step/next {:db/id #edb/ref 17592186139408}} {:db/id #edb/ref 17592186139408 :step/content {:db/id #edb/ref 17592186138458 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138211 :question/id #uuid "f0782388-8184-5922-8e9e-d9edcf727264" :question/math-academy-id "e-1526"} :knowledge-point/id #uuid "010539bb-ae6a-5071-a7bd-25c40d5a9717" :knowledge-point/questions [{:db/id #edb/ref 17592186139085} {:db/id #edb/ref 17592186139086} {:db/id #edb/ref 17592186496279} {:db/id #edb/ref 17592186496280}] :knowledge-point/title "Choosing Appropriate Units When Base Units Are Required"} :step/id #uuid "224fd6c9-017e-5d25-880a-8e0f92b408fe" :step/math-academy-id 4786}] :activity/title "Selecting Units for Rates of Change" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138591}]}
