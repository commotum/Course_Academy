#{[{:db/id #edb/ref 17592186138211 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138458 :knowledge-point/id #uuid "010539bb-ae6a-5071-a7bd-25c40d5a9717" :knowledge-point/title "Choosing Appropriate Units When Base Units Are Required"}] :question/id #uuid "f0782388-8184-5922-8e9e-d9edcf727264" :question/math-academy-id "e-1526" :question/problem "Density $D$ is the rate that mass $M$ changes as volume $V$ changes. What are the units of density in terms of base units?" :question/worked-solution "We *measure the change* in the mass, as *we change* the volume. Consequently, any appropriate unit must take the form\n\n$$\n\\dfrac{\\textrm{unit of mass}}{\\textrm{unit of volume}}.\n$$\n\nThe base unit for mass is $\\textrm{kg},$ and the base unit for volume is $\\textrm{m}^3.$ Therefore, the units of density are\n\n$$\n\\dfrac{\\textrm{kg}}{\\textrm{m}^3},\n$$\n\nor, kilograms per cubic meter."}] [{:db/id #edb/ref 17592186138313 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138440 :knowledge-point/id #uuid "86db8dde-c4ad-5ba3-9022-afe85acbc3d8" :knowledge-point/title "Choosing Appropriate Units When Base Units Are Not Required"}] :question/id #uuid "66c31f3c-2abb-51ff-b8d5-8377aeb90d80" :question/math-academy-id "e-901" :question/problem "A tank is being filled with water. What is an appropriate unit for measuring the rate of change of water volume in the tank, as time goes on?" :question/worked-solution "We *measure the change* of the volume as *we change* the amount of time. Consequently, any appropriate unit for measuring the rate of change of water volume in the tank must take the form\n\n$$\n\\dfrac{\\textrm{unit of volume}}{\\textrm{unit of time}}.\n$$\n\nSome examples of appropriate units include $\\dfrac{\\textrm{liters}}{\\textrm{hour}},$ $\\dfrac{\\textrm{m}^3}{\\textrm{min}},$ and $\\dfrac{\\textrm{cm}^3}{\\textrm{s}}.$"}] [{:db/id #edb/ref 17592186496279 :knowledge-point/_questions [{:db/id #edb/ref 17592186138458 :knowledge-point/id #uuid "010539bb-ae6a-5071-a7bd-25c40d5a9717" :knowledge-point/title "Choosing Appropriate Units When Base Units Are Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b2500b-de4f-55ca-a5fe-606c9cc41191" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{m}}^{2}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186495511} {:answer/id #uuid "a7ccc9c8-0453-51f3-a066-d4f32b5bb75d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{in}}^{3}}{\\text{s}}" :db/id #edb/ref 17592186495887} {:answer/id #uuid "d188753b-06ec-5280-9668-288f19cdb913" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{\\text{s}}" :db/id #edb/ref 17592186495967} {:answer/id #uuid "d31e5a96-a611-5ddc-a644-f01de074be5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{ft}}{\\text{s}}" :db/id #edb/ref 17592186495974} {:answer/id #uuid "ee35cffa-97d2-5c8d-8c26-3cb5445b1373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{m}}^{2}}{\\text{s}}" :db/id #edb/ref 17592186496033}] :answer-field/correct {:answer/id #uuid "ee35cffa-97d2-5c8d-8c26-3cb5445b1373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{m}}^{2}}{\\text{s}}" :db/id #edb/ref 17592186496033} :answer-field/id #uuid "85ecd063-0c30-5774-8d10-b2e4acbf4358" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496141}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7eeb94bb-3ad7-577d-9be8-4467334dced4" :question/math-academy-id "q-103386" :question/problem "Mark is mowing the lawn. He wants to determine how much area he can mow as time goes on. What are appropriate units for Mark's purpose, in terms of base units?" :question/worked-solution "We *measure the change* in the area, as *we change* the time. Consequently, any appropriate unit must take the form\n\n$$\n\\frac{\\text{unit of area}}{\\text{unit of time}}.\n$$\n\nThe base unit for area is ${\\text{m}}^{2},$ and the base unit for time is $\\text{s}.$ Therefore, the appropriate units are\n\n$$\n\\frac{{\\text{m}}^{2}}{\\text{s}},\n$$\n\nor, square meters per second."}] [{:db/id #edb/ref 17592186496280 :knowledge-point/_questions [{:db/id #edb/ref 17592186138458 :knowledge-point/id #uuid "010539bb-ae6a-5071-a7bd-25c40d5a9717" :knowledge-point/title "Choosing Appropriate Units When Base Units Are Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a31c016-7581-51c5-822b-4a571829ce10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{in}}{\\text{s}}" :db/id #edb/ref 17592186495535} {:answer/id #uuid "70cfc503-22ee-55c2-836b-3453b0c8c7f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186495757} {:answer/id #uuid "92f01d15-91dc-5198-9880-f2fea86ce575" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\text{m}}^{2}}{\\text{s}}" :db/id #edb/ref 17592186495834} {:answer/id #uuid "a785465d-4be2-52e9-bd6a-046a7ecc4c55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{\\text{s}}" :db/id #edb/ref 17592186495886} {:answer/id #uuid "f747453d-9a93-50ac-912e-3072a4460dcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{in}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186496050}] :answer-field/correct {:answer/id #uuid "70cfc503-22ee-55c2-836b-3453b0c8c7f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}}" :db/id #edb/ref 17592186495757} :answer-field/id #uuid "5165db33-f994-5bf2-a4e5-e80f00f1780e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496113}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "84dd0eb1-204d-5088-96b6-0cbdfd5aaddf" :question/math-academy-id "q-103391" :question/problem "John is traveling in the subway and wants to determine how the subway speed changes as time goes on. What are appropriate units for the rate of change of the speed, in terms of base units?" :question/worked-solution "We *measure the change* in the speed, as *we change* the time. Consequently, any appropriate unit must take the form\n\n$$\n\\frac{\\text{unit of speed}}{\\text{unit of time}}.\n$$\n\nIn terms of meters and seconds, the unit for speed is $\\frac{\\text{m}}{\\text{s}},$ and the unit for time is $\\text{s}.$ Therefore, the appropriate unit for the rate of change of speed is\n\n$$\n\\frac{(\\frac{\\text{m}}{\\text{s}})}{\\text{s}}=\\frac{\\text{m}}{{\\text{s}}^{2}}.\n$$\n\nor, meters per square second."}] [{:db/id #edb/ref 17592186496253 :knowledge-point/_questions [{:db/id #edb/ref 17592186138440 :knowledge-point/id #uuid "86db8dde-c4ad-5ba3-9022-afe85acbc3d8" :knowledge-point/title "Choosing Appropriate Units When Base Units Are Not Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db72ead-e219-506e-a05e-8d12d99ca06d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Pants per sewing machine" :db/id #edb/ref 17592186495572} {:answer/id #uuid "2bc1cc65-cce6-5aab-a972-6c9fe588281f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Sewing machines" :db/id #edb/ref 17592186495607} {:answer/id #uuid "60df7dfc-bcf9-5f26-87e5-641220cc035f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Square pants" :db/id #edb/ref 17592186495727} {:answer/id #uuid "6674b986-b342-55f0-8b67-c723d4e8fe35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Sewing machines per pant" :db/id #edb/ref 17592186495738} {:answer/id #uuid "d6b9893d-0e95-5cf7-b7ac-fb186460a81c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Square pants per sewing machine" :db/id #edb/ref 17592186495981}] :answer-field/correct {:answer/id #uuid "1db72ead-e219-506e-a05e-8d12d99ca06d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Pants per sewing machine" :db/id #edb/ref 17592186495572} :answer-field/id #uuid "fd72d8dd-ed46-535b-82ea-bbaa1272b985" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496218}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a867d1e-d4d9-50bf-b40e-5286a48f1d65" :question/math-academy-id "q-46278" :question/problem "Mr. Smith owns a factory where pants are made. To make these pants, the factory has several sewing machines. Mr. Smith wishes to determine the rate at which the number of pants increases with the number of sewing machines. What is an appropriate unit for Mr. Smith's purpose?" :question/worked-solution "We *measure the change* in the number of pants, as *we change* the number of sewing machines. Consequently, any appropriate unit must take the form\n\n$$\n\\frac{\\text{unit of pants}}{\\text{unit of sewing machines}}.\n$$\n\nTherefore, among the given options, the only correct one is \"pants per sewing machine.\""}] [{:db/id #edb/ref 17592186496240 :knowledge-point/_questions [{:db/id #edb/ref 17592186138440 :knowledge-point/id #uuid "86db8dde-c4ad-5ba3-9022-afe85acbc3d8" :knowledge-point/title "Choosing Appropriate Units When Base Units Are Not Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d10ee8f-e8d6-56f3-a936-711052259f70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{kg}}{{\\text{cow}}^{2}}" :db/id #edb/ref 17592186495541} {:answer/id #uuid "37557c6c-406f-5373-8d54-ed5c649b8b5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{cow}}{{\\text{kg}}^{2}}" :db/id #edb/ref 17592186495640} {:answer/id #uuid "87a9fb87-3f7f-5f15-90f0-fc1b135e29be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{kg}}{\\text{cow}}" :db/id #edb/ref 17592186495804} {:answer/id #uuid "8abcc84d-1cac-523c-8298-c07ee544a799" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{cow}}{\\text{kg}}" :db/id #edb/ref 17592186495815} {:answer/id #uuid "e79be69d-008b-5dcb-a000-d63598d95025" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{kg}\\cdot \\text{cow}" :db/id #edb/ref 17592186496021}] :answer-field/correct {:answer/id #uuid "87a9fb87-3f7f-5f15-90f0-fc1b135e29be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{kg}}{\\text{cow}}" :db/id #edb/ref 17592186495804} :answer-field/id #uuid "17602a23-65c4-5b79-88c2-cd9e187b01af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496086}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "321dc173-e020-511b-8049-7dba8d5ea21d" :question/math-academy-id "q-59700" :question/problem "Kevin, a farmer, prepares fodder annually for his cows. He wants to determine how the weight of fodder changes as the number of cows changes. What is an appropriate unit for Kevin's purpose?" :question/worked-solution "We *measure the change* in the weight of fodder, as *we change* the number of cows. Consequently, any appropriate unit must take the form\n\n$$\n\\frac{\\text{unit of weight}}{\\text{number of cows}}.\n$$\n\nTherefore, among the given options, the only correct one is $\\frac{\\text{kg}}{\\text{cow}}.$"}]}
