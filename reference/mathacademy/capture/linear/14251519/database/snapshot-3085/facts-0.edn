acf2-5857-55f8-bb3a-ded7762c8061" #edb/ref 17592186045417] [17592186557366 #edb/ref 1063 #edb/ref 17592186557214 #edb/ref 17592186045417] [17592186557395 #edb/ref 1062 #uuid "cca24e3e-cdea-5e7c-b3c8-5f84dfb83ea6" #edb/ref 17592186045417] [17592186557395 #edb/ref 1063 #edb/ref 17592186557301 #edb/ref 17592186045417] [17592186557409 #edb/ref 1058 #edb/ref 17592186557395 #edb/ref 17592186045417] [17592186557409 #edb/ref 1062 #uuid "fc153cbc-8b84-5906-bc61-6b445d0eb4ba" #edb/ref 17592186045417] [17592186557409 #edb/ref 1063 #edb/ref 17592186557259 #edb/ref 17592186045417] [17592186565593 #edb/ref 1068 #edb/ref 17592186565597 #edb/ref 17592186045443] [17592186565593 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186565593 #edb/ref 1071 "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(3 - 4 x)^{6}.$" #edb/ref 17592186045443] [17592186565593 #edb/ref 1072 #uuid "7a04edd0-e7bf-56e5-8b7e-72d1c5d80068" #edb/ref 17592186045443] [17592186565593 #edb/ref 1074 "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{6},\\,g=3 - 4 x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=6g^{5},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-4.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=6g^{5}\\cdot (-4) \\\\  &=-24(3 - 4 x)^{5}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186565600 #edb/ref 1068 #edb/ref 17592186565596 #edb/ref 17592186045443] [17592186565600 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186565600 #edb/ref 1071 "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(-1+2x)^{6}.$" #edb/ref 17592186045443] [17592186565600 #edb/ref 1072 #uuid "c560bc6a-e1e6-5b7e-9d3d-86522a3c4ff0" #edb/ref 17592186045443] [17592186565600 #edb/ref 1074 "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{6},\\,g=-1+2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=6g^{5},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=6\\cdot 2\\cdot (-1+2x)^{5} \\\\  &=12(-1+2x)^{5}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186565604 #edb/ref 1168 "generators/5f/5f54a64d59365172932f979ffc922d010c51eeda759e90f6d1a0dd794c46ee16/generator.py" #edb/ref 17592186045443] [17592186565604 #edb/ref 1169 #uuid "4096aab8-3d82-5f72-93a5-f1633c89b48f" #edb/ref 17592186045443]}
