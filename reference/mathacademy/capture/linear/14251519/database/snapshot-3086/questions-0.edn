#{[{:db/id #edb/ref 17592186572194 :knowledge-point/_questions [{:db/id #edb/ref 17592186096843 :knowledge-point/id #uuid "0a312840-0d35-50bb-94b3-b04778f4efc3" :knowledge-point/title "Differentiating a Function Using the Chain Rule and Prime Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "096b9b79-42b4-5435-8d17-15938cf8083f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+4x}{\\sqrt{x-{x}^{2}}}" :db/id #edb/ref 17592186571556} {:answer/id #uuid "528cbd11-0bdd-5861-899e-cfe78186526c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-2x}{\\sqrt{(x-{x}^{2})^{3}}}" :db/id #edb/ref 17592186571688} {:answer/id #uuid "c895d3ba-c44d-57f2-8b2f-97e98d154d5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1-2x}{\\sqrt{(x-{x}^{2})^{3}}}" :db/id #edb/ref 17592186571895} {:answer/id #uuid "de570552-69e0-5331-86f3-79143ee949ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2+4x}{\\sqrt{(x-{x}^{2})^{3}}}" :db/id #edb/ref 17592186571936} {:answer/id #uuid "f88f7c0f-9d24-5617-aa25-c79abffb93e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-4x}{\\sqrt{(x-{x}^{2})^{3}}}" :db/id #edb/ref 17592186571966}] :answer-field/correct {:answer/id #uuid "f88f7c0f-9d24-5617-aa25-c79abffb93e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-4x}{\\sqrt{(x-{x}^{2})^{3}}}" :db/id #edb/ref 17592186571966} :answer-field/id #uuid "c878ff99-495e-5613-8683-22e308482f13" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572080}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e5c85892-5c29-5ec5-80d2-d47ed89d83b9" :question/math-academy-id "q-107298" :question/problem "Find ${f}^{′}(x)$ for $f(x)=-\\frac{4}{\\sqrt{x-{x}^{2}}}.$" :question/worked-solution "Let $g(x)=x-{x}^{2}$ and $f(g(x))=-\\frac{4}{\\sqrt{g}}=-4{g}^{-1/2}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =-4({g}^{-1/2})^{′}=4\\cdot \\frac{1}{2}{g}^{-3/2}=\\frac{2}{{g}^{3/2}}, \\\\ {g}^{′}(x) & =(x-{x}^{2})^{′}=1-2x.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =\\frac{2}{{g}^{3/2}}\\cdot (1-2x) \\\\  & =\\frac{2-4x}{\\sqrt{(x-{x}^{2})^{3}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572150 :knowledge-point/_questions [{:db/id #edb/ref 17592186096842 :knowledge-point/id #uuid "2f0cdac9-57b2-5634-8d98-d6adf8a85204" :knowledge-point/title "Differentiating a Radical Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2440da94-c49c-5b97-93a3-f1f305aaf546" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186571599} {:answer/id #uuid "4dfdfa0c-df5d-578c-9e5a-030e1e19fe81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186571679} {:answer/id #uuid "67441758-f1aa-545c-a9ad-7fa7f49bf8b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186571715} {:answer/id #uuid "fb5ed5a3-55f9-5465-8515-fdd310345cd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186571970} {:answer/id #uuid "fd4a6f37-6e13-59de-b1f0-4ae8dde2510a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186571976}] :answer-field/correct {:answer/id #uuid "2440da94-c49c-5b97-93a3-f1f305aaf546" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186571599} :answer-field/id #uuid "5afb038d-0b31-5d55-8f54-c760388f6c4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572027}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "87ece511-fd94-56a1-8fa2-055336c9156b" :question/math-academy-id "q-48848" :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{3{x}^{2}+24}$ at the point where $x=-2.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=3{x}^{2}+24.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{2\\sqrt{u}}\\cdot 6x \\\\  & =\\frac{3x}{\\sqrt{3{x}^{2}+24}}.\\end{aligned}\n$$\n\nFinally, substituting  $x=-2,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-2} & ={(\\frac{3x}{\\sqrt{3{x}^{2}+24}})|}_{x=-2} \\\\  & =\\frac{(-6)}{\\sqrt{3(-2)^{2}+24}} \\\\  & =-\\frac{6}{6} \\\\  & =-1\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572161 :knowledge-point/_questions [{:db/id #edb/ref 17592186096843 :knowledge-point/id #uuid "0a312840-0d35-50bb-94b3-b04778f4efc3" :knowledge-point/title "Differentiating a Function Using the Chain Rule and Prime Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "557cd32f-67a1-5f7d-8007-8e8dc4e07e92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{({x}^{4}-2{x}^{3})}^{2}(4{x}^{3}-6{x}^{2})" :db/id #edb/ref 17592186571691} {:answer/id #uuid "82e6a967-6c7d-5d88-8afe-9d6fff949b45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{4}-2{x}^{3})(3{x}^{4}-6{x}^{2})" :db/id #edb/ref 17592186571760} {:answer/id #uuid "baf7a497-5f73-5773-889e-5e6f697822ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{4}-2{x}^{3})(4{x}^{3}-6{x}^{2})" :db/id #edb/ref 17592186571872} {:answer/id #uuid "caaa2a22-48c5-53fe-92ea-da472c888e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{4}-3{x}^{2})(4{x}^{3}-6{x}^{2})" :db/id #edb/ref 17592186571901} {:answer/id #uuid "df3cad62-492d-5cb0-b710-42db57802071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{4}-2{x}^{3}){(4{x}^{3}-6{x}^{2})}^{2}" :db/id #edb/ref 17592186571938}] :answer-field/correct {:answer/id #uuid "baf7a497-5f73-5773-889e-5e6f697822ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{4}-2{x}^{3})(4{x}^{3}-6{x}^{2})" :db/id #edb/ref 17592186571872} :answer-field/id #uuid "bbfbd138-787c-5944-9a48-89b79ecd75b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572074}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9d6e7296-3732-5370-89a1-2dbb983a355c" :question/math-academy-id "q-71951" :question/problem "Given that $f(x)={({x}^{4}-2{x}^{3})}^{2},$ find ${f}^{′}(x).$" :question/worked-solution "Let $g(x)={x}^{4}-2{x}^{3}$ and $f(g(x))=g(x)^{2}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{2})^{′}=2g, \\\\ {g}^{′}(x) & =({x}^{4}-2{x}^{3})^{′}=4{x}^{3}-6{x}^{2}.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =2g\\cdot (4{x}^{3}-6{x}^{2}) \\\\  & =2({x}^{4}-2{x}^{3})(4{x}^{3}-6{x}^{2}).\\end{aligned}\n$$"}]}
