:db/id #edb/ref 17592186432717} {:answer/id #uuid "507fa32c-4749-5d72-9fa6-d23768d5f02e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186432721} {:answer/id #uuid "995d4239-9221-5924-87b4-04783d3524d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186432733} {:answer/id #uuid "a4c84267-e3ef-5e7d-a900-0c207f03e3dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186432738} {:answer/id #uuid "e5414113-8a82-5922-b990-18a21eb0033e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186432759}] :answer-field/correct {:answer/id #uuid "a4c84267-e3ef-5e7d-a900-0c207f03e3dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186432738} :answer-field/id #uuid "118061fa-f4fb-5c4a-8157-a3d01d37bb53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432770}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "245a9f1f-3fc0-594c-a273-205b94f4bf02" :question/math-academy-id "q-132405" :question/problem "Which of the following numbers are divisible by $6?$\n\nI. $185\\,346$\n\nII. $2\\,525\\,934$\n\nIII. $15\\,070\\,962$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$\n\n- The number $185\\,346$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n1+8+5+3+4+6=27\n$$\n\nSo, $185\\,346$ is divisible by $6.$\n\n- The number $2\\,525\\,934$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n2+5+2+5+9+3+4=30\n$$\n\nSo, $2\\,525\\,934$ is divisible by $6.$\n\n- The number $15\\,070\\,962$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n1+5+0+7+0+9+6+2=30\n$$\n\nSo, $15\\,070\\,962$ is divisible by $6.$\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186432789 :knowledge-point/_questions [{:db/id #edb/ref 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a2752c1-636c-52a6-a6d4-6d9b59cbf421" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186432713} {:answer/id #uuid "4d83589b-d420-59c9-bbed-964e663c6b6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186432720} {:answer/id #uuid "8dac666f-2957-5b5a-bf69-321c0d67de2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186432732} {:answer/id #uuid "cd42dba0-3bec-5cb3-9e1f-c94b56e7c76a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186432751} {:answer/id #uuid "f0877883-a791-5d0e-bd93-e8b6c16fdb44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186432763}] :answer-field/correct {:answer/id #uuid "cd42dba0-3bec-5cb3-9e1f-c94b56e7c76a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186432751} :answer-field/id #uuid "b3d65056-5e8f-5f44-8d4d-595ca231767e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432779}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91c8241d-8043-5a59-abeb-68e020936dc7" :question/math-academy-id "q-132408" :question/problem "Which of the following numbers are divisible by $6?$\n\nI. $345\\,989\\,191$\n\nII. $55\\,355\\,676$\n\nIII. $137\\,252\\,124$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$\n\n- The number $345\\,989\\,191$ is not divisible by $2,$ so it is not divisible by $6.$\n\n- The number $55\\,355\\,676$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n5+5+3+5+5+6+7+6=42\n$$\n\nSo, $55\\,355\\,676$ is divisible by $6.$\n\n- The number $137\\,252\\,124$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n1+3+7+2+5+2+1+2+4=27\n$$\n\nSo, $137\\,252\\,124$ is divisible by $6.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186432795 :knowledge-point/_questions [{:db/id #edb/ref 17592186171934 :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/title "Determining if a Number Is Divisible by 7"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d82c8ca-e2a0-5442-acfc-6cf1aba5809b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186432704} {:answer/id #uuid "2a0c050b-dbdf-51df-b498-80916aea50b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186432712} {:answer/id #uuid "32d2feef-0a50-5be6-8be0-cc007b6c7465" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186432715} {:answer/id #uuid "50fc2e21-2e60-5152-8ded-84b094c83b34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186432722} {:answer/id #uuid "aec18c88-4572-5f31-bf18-6f1c2e43c5c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186432742}] :answer-field/correct {:answer/id #uuid "aec18c88-4572-5f31-bf18-6f1c2e43c5c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186432742} :answer-field/id #uuid "d41a4fb2-3b50-5439-ab7b-d9726d39fc08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432782}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0e5ee54-f96c-54ab-8de5-f272c76ac6c8" :question/math-academy-id "q-223365" :question/problem "Which of the following numbers are divisible by $7?$\n\nI. $448$\n\nII. $352$\n\nIII. $217$" :question/worked-solution "To check if a number is divisible by $7,$ double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$\n\n- For the number $448,$ we have that \n\n$$\n44-2(8)=44-16=28\n$$\n\nwhich is divisible by $7.$ Therefore, $448$ is divisible by $7.$\n\n- For the number $352,$ we have that \n\n$$\n35-2(2)=35-4=31\n$$\n\nwhich is not divisible by $7.$ Therefore, $352$ is not divisible by $7.$\n\n- For the number $217,$ we have that \n\n$$\n21-2(7)=21-14=7\n$$\n\nwhich is divisible by $7.$ Therefore, $217$ is divisible by $7.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186432790 :knowledge-point/_questions [{:db/id #edb/ref 17592186171934 :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/title "Determining if a Number Is Divisible by 7"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c90b2bd-a16e-537c-aa1a-b49d1b1aa9f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :