swer/id #uuid "bb02ed4d-afba-5f09-a6c7-d827c4d8ce5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186432746} {:answer/id #uuid "bea65e05-1ab6-583c-85b7-297c6ed8db2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186432748} {:answer/id #uuid "fcc9070c-89ee-5218-b491-1202fd30f40f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186432767}] :answer-field/correct {:answer/id #uuid "fcc9070c-89ee-5218-b491-1202fd30f40f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186432767} :answer-field/id #uuid "33f9ffcb-9fbc-5046-94a2-69e90f86b7d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432774}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bf3c9279-64c9-519d-9697-63c8e9dc9b5a" :question/math-academy-id "q-85393" :question/problem "Which of the following numbers are divisible by $3?$\n\nI. $896\\,154$\n\nII. $12\\,471\\,106$\n\nIII. $3\\,472\\,335$" :question/worked-solution "A number is divisible by $3$ if the sum of its digits is divisible by $3.$\n\n- The sum of the digits of $896\\,154$ is\n\n$$\n8+9+6+1+5+4=33,\n$$\n\nwhich is divisible by $3.$ So, $896\\,154$ is divisible by $3.$\n\n- The sum of the digits of $12\\,471\\,106$ is\n\n$$\n1+2+4+7+1+1+0+6=22,\n$$\n\nwhich is *not* divisible by $3.$ So, $12\\,471\\,106$ is *not* divisible by $3.$\n\n- The sum of the digits of $3\\,472\\,335$ is\n\n$$\n3+4+7+2+3+3+5=27,\n$$\n\nwhich is divisible by $3.$ So, $3\\,472\\,335$ is divisible by $3.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186432783 :knowledge-point/_questions [{:db/id #edb/ref 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6953cf33-afb1-5529-b0c4-a6bac7c9f508" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186432725} {:answer/id #uuid "6cfb0cd8-4097-52ac-a24f-a5e6ae32c190" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186432728} {:answer/id #uuid "7e1d019f-92de-55d5-8d55-0b5c0744419b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186432730} {:answer/id #uuid "bcb13dc7-f917-53db-b3f3-f960d61be764" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Il and III only" :db/id #edb/ref 17592186432747} {:answer/id #uuid "e61e92ae-4945-5869-9605-05e6adcdca23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186432760}] :answer-field/correct {:answer/id #uuid "6cfb0cd8-4097-52ac-a24f-a5e6ae32c190" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186432728} :answer-field/id #uuid "1cb538e3-95c1-52b1-beac-59b8fbe328de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432771}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "072352b0-88b5-50de-9e91-38bf12444d03" :question/math-academy-id "q-85420" :question/problem "Which digits, when inserted into the blank, make the number $35\\,284\\,43◻$ divisible by $6?$\n\nI. $2$\n\nII. $5$\n\nIII. $4$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n3+5+2+8+4+4+3+◻=29+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $2$ into the blank, we get $35\\,284\\,432,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $29+2=31,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $5$ into the blank, we get $35\\,284\\,435,$ which is not divisible by $2.$ Therefore, it is not divisible by $6$ either.\n\n- If we substitute $4$ into the blank, we get $35\\,284\\,434,$ which is divisible by $2.$ The sum of the digits is $29+4=33,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186432791 :knowledge-point/_questions [{:db/id #edb/ref 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03716efb-8dd0-5692-a7ad-ddc54290f97c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186432702} {:answer/id #uuid "c7079a82-b92a-5d2b-9c94-e0b3d56ba29d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186432750} {:answer/id #uuid "d53103cc-e21c-5a43-a029-4914bb36a519" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186432753} {:answer/id #uuid "d86b4192-f97c-51d0-8a92-2939d373fe1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186432755} {:answer/id #uuid "ecf7965c-4e93-5f39-a663-6a32dce50c9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186432761}] :answer-field/correct {:answer/id #uuid "03716efb-8dd0-5692-a7ad-ddc54290f97c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186432702} :answer-field/id #uuid "008ba33f-0dbe-5e5d-81fc-18953e1cddb8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432769}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a49592c2-4649-5980-ab80-d5418f7e763f" :question/math-academy-id "q-85422" :question/problem "Which digits, when inserted into the blank, make the number $114\\,040\\,32◻$ divisible by $6?$\n\nI. $0$\n\nII. $5$\n\nIII. $6$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n1+1+4+0+4+0+3+2+◻=15+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $0$ into the blank, we get $114\\,040\\,320,$ which is divisible by $2.$ The sum of the digits is $15+0=15,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\n- If we substitute $5$ into the blank, we get $114\\,040\\,325,$ which is not divisible by $2.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $6$ into the blank, we get $114\\,040\\,326,$ which is divisible by $2.$ The sum of the digits is $15+6=21,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186432786 :knowledge-point/_questions [{:db/id #edb/ref 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "149ea1cb-e01d-5802-a028-00d7e8a540c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186432706} {:answer/id #uuid "36d91072-cbcb-50c7-a7c3-d3eb2bc27ed2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186432716} {:answer/id #uuid "e33d63b8-9632-5974-8d28-9b8bceb357a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186432758} {:answer/id #uuid "f44b8d56-143e-5cc7-b349-09ed4c123545" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186432765} {:answer/id #uuid "fd87e2f0-0eb6-506b-a7f5-68956058c004" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186432768}] :answer-field/correct {:answer/id #uuid "fd87e2f0-0eb6-506b-a7f5-68956058c004" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186432768} :answer-field/id #uuid "345c84c1-3b26-5e71-9c91-d17afe953859" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432775}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66ca27c6-8cac-5ac3-b80e-6fd1dcb7b6a5" :question/math-academy-id "q-85424" :question/problem "Which digits, when inserted into the blank, make the number $591\\,030\\,47◻$ divisible by $6?$\n\nI. $2$\n\nII. $5$\n\nIII. $4$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n5+9+1+0+3+0+4+7+◻=29+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $2$ into the blank, we get $591\\,030\\,472,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $29+2=31,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $5$ into the blank, we get $591\\,030\\,475,$ which is not divisible by $2,$ so it is not divisible by $6$ either.\n\n- If we substitute $4$ into the blank, we get $591\\,030\\,474,$ which is divisible by $2.$ The sum of the digits is $29+4=33,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\nTherefore, the correct answer is \"III only.\""}]}
