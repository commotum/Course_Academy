#{[{:db/id #edb/ref 17592186552464 :knowledge-point/_questions [{:db/id #edb/ref 17592186068910 :knowledge-point/id #uuid "76450310-bc86-5f3b-9bb8-82206d89c627" :knowledge-point/title "Evaluating Left and Right Limits at an Interior Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a0cf460-55a4-53ba-a1f8-673862b8fab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186552002}] :answer-field/correct {:answer/id #uuid "8a0cf460-55a4-53ba-a1f8-673862b8fab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186552002} :answer-field/id #uuid "42936415-9406-5a74-8677-a757c4ddb5da" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552291} {:answer-field/choices [{:answer/id #uuid "4f7b4459-6e7f-55bb-a709-b808579751a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186551853}] :answer-field/correct {:answer/id #uuid "4f7b4459-6e7f-55bb-a709-b808579751a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186551853} :answer-field/id #uuid "aa16bc81-a180-514a-8eff-2535332a3a69" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552352}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "825d48d1-753b-5c3d-88ac-771966b26aa9" :question/math-academy-id "q-131461" :question/problem "Find ${lim}_{x\\to \\,{1}^{-}}g(x)$ and ${lim}_{x\\to \\,{1}^{+}}g(x).$ If a limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,{1}^{-}}g(x)=$\n{{field-1}}\n\n${lim}_{x\\to \\,{1}^{+}}g(x)=$\n{{field-2}}" :question/worked-solution "As $x$ approaches $1$ from the left, the function $g(x)$ approaches $1.$ Therefore,\n\n$$\n{lim}_{x\\to \\,{1}^{-}}g(x)=1.\n$$\n\nLikewise, as $x$ approaches $1$ from the right, the function $g(x)$ approaches $0.$ Therefore,\n\n$$\n{lim}_{x\\to \\,{1}^{+}}g(x)=0.\n$$\n\nIn conclusion, we have\n\n$$\n{lim}_{x\\to \\,{1}^{-}}g(x)=1,\\,{lim}_{x\\to \\,{1}^{+}}g(x)=0.\n$$"}] [{:db/id #edb/ref 17592186552519 :knowledge-point/_questions [{:db/id #edb/ref 17592186078508 :knowledge-point/id #uuid "5e2b72a2-c486-5a7a-a65e-57e83b78f6cc" :knowledge-point/title "Identifying the Limit at an Interior Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e244e3f-a497-5d8b-86df-e77fd054e1da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "DNE" :db/id #edb/ref 17592186551965}] :answer-field/correct {:answer/id #uuid "7e244e3f-a497-5d8b-86df-e77fd054e1da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "DNE" :db/id #edb/ref 17592186551965} :answer-field/id #uuid "79c6b638-25c2-5c98-9b0c-513af8ec4b05" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552323}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ed765a29-aa16-50e2-b510-c72034032862" :question/math-academy-id "q-131462" :question/problem "Find ${lim}_{x\\to \\,1}g(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,1}g(x)=$ \n{{field-1}}" :question/worked-solution "In part 1, we showed that\n\n$$\n{lim}_{x\\to \\,{1}^{-}}g(x)=1,\\,{lim}_{x\\to \\,{1}^{+}}g(x)=0.\n$$\n\nSince ${lim}_{x\\to \\,{1}^{-}}g(x)\\ne {lim}_{x\\to \\,{1}^{+}}g(x),$ we conclude that\n\n$$\n{lim}_{x\\to \\,1}g(x)=\\text{DNE}.\n$$"}] [{:db/id #edb/ref 17592186552495 :knowledge-point/_questions [{:db/id #edb/ref 17592186078508 :knowledge-point/id #uuid "5e2b72a2-c486-5a7a-a65e-57e83b78f6cc" :knowledge-point/title "Identifying the Limit at an Interior Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2bc19c-2a71-595a-a550-bc76e3e70f16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186551695}] :answer-field/correct {:answer/id #uuid "0c2bc19c-2a71-595a-a550-bc76e3e70f16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186551695} :answer-field/id #uuid "0caaacf5-0bb4-54ec-ac6a-b476546a0c75" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552262}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b69f893c-224f-5a62-ac7c-a87ffc7746ab" :question/math-academy-id "q-131463" :question/problem "Find ${lim}_{x\\to \\,(-1)}g(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to (-1)}g(x)=$\n{{field-1}}" :question/worked-solution "From the graph, we see that as we approach $x=-1$ from the left, the $y$-value approaches $1.$ So the left-hand limit is\n\n$$\n{lim}_{x\\to \\,(-1)^{-}}g(x)=1.\n$$\n\nSimilarly, when we approach $x=-1$ from the right, the $y$-value again approaches $1.$ So the right-hand limit is\n\n$$\n{lim}_{x\\to \\,(-1)^{+}}g(x)=1.\n$$\n\nSince both the left and right-hand limits exist and are equal to $1,$ we conclude that\n\n \n\n$$\n{lim}_{x\\to \\,(-1)}g(x)=1.\n$$"}] [{:db/id #edb/ref 17592186552441 :knowledge-point/_questions [{:db/id #edb/ref 17592186124579 :knowledge-point/id #uuid "ea4038bf-34f0-58cc-a7b6-6a4c1890570f" :knowledge-point/title "The Limit at Infinity for an Unbounded Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19723842-c403-5db6-848b-d04909dfc11f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186551719}] :answer-field/correct {:answer/id #uuid "19723842-c403-5db6-848b-d04909dfc11f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186551719} :answer-field/id #uuid "8bc5f2cb-f76f-574b-9be6-37990ef008b0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552336} {:answer-field/choices [{:answer/id #uuid "db28315c-43f6-54bc-aa64-41ce09175eea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186552181}] :answer-field/correct {:answer/id #uuid "db28315c-43f6-54bc-aa64-41ce09175eea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186552181} :answer-field/id #uuid "aa90b2a5-1bb3-519d-b83d-9e89ef3664b7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552353}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b9c1b56-216e-5690-b417-9acbe40876e5" :question/math-academy-id "q-131464" :question/problem "Find ${lim}_{x\\to -\\infty }g(x)$ and ${lim}_{x\\to \\infty }g(x).$ If a limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to -\\infty }g(x)=$\n{{field-1}}\n\n${lim}_{x\\to \\infty }g(x)=$\n{{field-2}}" :question/worked-solution "On the left side of the graph, we see that as the values of $x$ decrease and approach $-\\infty ,$ the graph of the function $g(x)$ moves closer and closer to the horizontal asymptote $y=-1.$\n\nConsequently, $g(x)$ approaches the value $-1$ as $x$ approaches $-\\infty ,$ and we have\n\n$$\n{lim}_{x\\to -\\infty }g(x)=-1.\n$$\n\nOn the right side of the graph, as the values of $x$ increase and approach $\\infty ,$  the graph of the function $g(x)$ moves closer and closer to the horizontal asymptote $y=-1.$ Therefore, \n\n$$\n{lim}_{x\\to \\infty }g(x)=-1.\n$$"}] [{:db/id #edb/ref 17592186552447 :knowledge-point/_questions [{:db/id #edb/ref 17592186115326 :knowledge-point/id #uuid "b94d5612-763f-59d8-9a80-7f6e2f18fa6c" :knowledge-point/title "Using the Constant Rule to Compute a Limit Algebraically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b514c398-b992-5e10-a4c9-4c702696ea7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186552102}] :answer-field/correct {:answer/id #uuid "b514c398-b992-5e10-a4c9-4c702696ea7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186552102} :answer-field/id #uuid "1710b855-9cf2-5f0a-9e99-64032a7ecff7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552268}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "684140b2-affb-5ccb-83ee-320705bb77fa" :question/math-academy-id "q-131465" :question/problem "Given that ${lim}_{x\\to \\,1}Cf(x)=8,$ where $C$ is a real constant, what is the value of $C?$\n\n$C=$\n{{field-1}}" :question/worked-solution "From the graph, we see ${lim}_{x\\to \\,1}f(x)=-1.$\n\nWe factor the constant out of the limit and evaluate the remaining limit, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}Cf(x) & =8 \\\\ C\\cdot {lim}_{x\\to 1}f(x) & =8 \\\\ C\\cdot (-1) & =8 \\\\ C & =-8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552439 :knowledge-point/_questions [{:db/id #edb/ref 17592186124613 :knowledge-point/id #uuid "38e6d549-0d5a-56e3-88b0-0b22dceb2d0d" :knowledge-point/title "Applying the Sum Rule to Compute A Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65d21ca8-3efe-54e5-bade-78de16222794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186551903}] :answer-field/correct {:answer/id #uuid "65d21ca8-3efe-54e5-bade-78de16222794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186551903} :answer-field/id #uuid "0f20ff5c-92ae-5166-a3cb-7910d80b3b2c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552265}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "51d9f041-304f-5c22-9ed6-3b3659033e6d" :question/math-academy-id "q-131466" :question/problem "Evaluate ${lim}_{x\\to \\,(-1)}(5f(x)+6g(x)+3{x}^{3}).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,(-1)}(5f(x)+6g(x)+3{x}^{3})=$\n{{field-1}}" :question/worked-solution "According to the sum and constant multiple rules, we can compute the required limit as follows:\n\n$$\n{lim}_{x\\to \\,(-1)}(5f(x)+6g(x)+3{x}^{3})=5{lim}_{x\\to \\,(-1)}f(x)+6{lim}_{x\\to \\,(-1)}g(x)+3{lim}_{x\\to \\,(-1)}{x}^{3}\n$$\n\n \n\nThe above equation assumes that ${lim}_{x\\to \\,(-1)}f(x)$ and ${lim}_{x\\to \\,(-1)}g(x)$ both exist.\n\nFrom the graph, we see ${lim}_{x\\to \\,(-1)}f(x)=0,$ and from part 3, we found ${lim}_{x\\to \\,(-1)}g(x)=1.$ So, we have  \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,(-1)}(5f(x)+6g(x)+3{x}^{3}) & =5{lim}_{x\\to \\,(-1)}f(x)+6{lim}_{x\\to \\,(-1)}g(x)+3{lim}_{x\\to \\,(-1)}{x}^{3} \\\\  & =5\\cdot 0+6\\cdot 1+3\\cdot (-1)^{3} \\\\  & =0+6-3 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552462 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cd307d0-84e5-5a56-ba21-a9c4b5fafb92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186551850}] :answer-field/correct {:answer/id #uuid "4cd307d0-84e5-5a56-ba21-a9c4b5fafb92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186551850} :answer-field/id #uuid "a2eeafbb-8b5b-54b8-acf7-c57ce5d5fa61" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552347}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b122753-4256-5b6b-bc1d-003f930bcebd" :question/math-academy-id "q-131467" :question/problem "What are the points of discontinuity of $f(x)?$\n\nThe function $f(x)$ is discontinuous at $x=$\n{{field-1}}." :question/worked-solution "The point of discontinuity of $f(x)$ is $x=1.$ It is impossible to draw the function in a neighborhood of this point without taking our pencil off of the page."}] [{:db/id #edb/ref 17592186552521 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cd664bb-86be-5a58-8fa0-b07122d09b0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186551814}] :answer-field/correct {:answer/id #uuid "3cd664bb-86be-5a58-8fa0-b07122d09b0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186551814} :answer-field/id #uuid "1d34f118-41e1-5f0d-b2fe-07e3f161bc03" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552271} {:answer-field/choices [{:answer/id #uuid "b191e3b7-d2db-5ccc-8585-09ab0a9c2e0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186552095}] :answer-field/correct {:answer/id #uuid "b191e3b7-d2db-5ccc-8585-09ab0a9c2e0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186552095} :answer-field/id #uuid "93e6cfce-7cf1-5e99-9ce9-953b3e91dbc0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186552339}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f30773ae-09b1-517b-85fe-c0701b657a78" :question/math-academy-id "q-131468" :question/problem "**In ascending order**, what are the points of discontinuity of $g(x)?$\n\n$g(x)$ is discontinuous at $x=$\n{{field-1}}\n$\\,$and $x=$\n{{field-2}}." :question/worked-solution "The points of discontinuity of $g(x)$ are $x=-1$ and $x=1.$ It is impossible to draw the function in the neighborhood of these points without taking our pencil off of the page."}]}
