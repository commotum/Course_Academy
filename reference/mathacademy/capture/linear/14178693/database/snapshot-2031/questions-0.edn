#{[{:db/id #edb/ref 17592186110299 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110661 :knowledge-point/id #uuid "854edbd5-3aef-5c6b-bb79-967aa241beb2" :knowledge-point/title "Combining the Rules of Exponents Without Fractions"}] :question/id #uuid "ee3fd0ee-77a9-5ebb-9bc9-c7439f5946b4" :question/math-academy-id "e-1088" :question/problem "Simplify the expression $\\left(x^2y\\right)^3\\cdot x^2y.$" :question/worked-solution "We start by using the power of product rule:\n\n$$\n\\begin{aligned}{({x}^{2}y)}^{3}\\cdot {x}^{2}y= &  \\\\ {({x}^{2})}^{3}\\cdot {y}^{3}\\cdot {x}^{2}y & \\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}{x}^{2\\cdot 3}\\cdot {y}^{3}\\cdot {x}^{2}y & = \\\\ {x}^{6}\\cdot {y}^{3}\\cdot {x}^{2}y & \\end{aligned}\n$$\n\nFinally, we use the product rule:\n\n$$\n\\begin{aligned}{x}^{6}\\cdot {y}^{3}\\cdot {x}^{2}y= &  \\\\ {x}^{6}\\cdot {x}^{2}\\cdot {y}^{3}\\cdot y= &  \\\\ {x}^{6+2}\\cdot {y}^{3+1} & = \\\\ {x}^{8}\\cdot {y}^{4} & = \\\\ {x}^{8}{y}^{4} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110300 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110662 :knowledge-point/id #uuid "736c1b75-fe60-5f0a-b426-a19f3edaaa2b" :knowledge-point/title "Combining the Rules of Exponents With Fractions"}] :question/id #uuid "d8aca072-8ed5-5d49-8d4e-8bcc96a27ddb" :question/math-academy-id "e-1089" :question/problem "Given that $a=2x^3$ and $b=\\dfrac{x}{y},$ express $ab^2$ in terms of $x$ and $y.$" :question/worked-solution "First, we substitute for $a$ and $b\\mathbin{:}$\n\n$$\n\\begin{aligned}a{b}^{2}=2{x}^{3}{(\\frac{x}{y})}^{2}\\end{aligned}\n$$\n\nThen, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}2{x}^{3}{(\\frac{x}{y})}^{2}=2{x}^{3}(\\frac{{x}^{2}}{{y}^{2}})\\end{aligned}\n$$\n\nFinally, we multiply and apply the product rule:\n\n$$\n\\begin{aligned}2{x}^{3}(\\frac{{x}^{2}}{{y}^{2}}) & = \\\\ \\frac{2{x}^{3}\\cdot {x}^{2}}{{y}^{2}} & = \\\\ \\frac{2{x}^{3+2}}{{y}^{2}} & = \\\\ \\frac{2{x}^{5}}{{y}^{2}} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110301 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186110663 :knowledge-point/id #uuid "014ea973-359e-53f5-9151-adc85e08bd3f" :knowledge-point/title "Combining the Rules of Exponents With Radicals"}] :question/id #uuid "cf539049-76f2-56c0-a890-00c2d767c0a8" :question/math-academy-id "e-1091" :question/problem "Simplify the expression $\\dfrac {\\sqrt{y}} {\\sqrt[3]{y}}.$" :question/worked-solution "First, we rewrite the radicals as fractional exponents:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{y}}{\\sqrt[3]{y}}=\\frac{{y}^{1/2}}{{y}^{1/3}}\\end{aligned}\n$$\n\nThen, we apply the quotient rule:\n\n$$\n\\begin{aligned}\\frac{{y}^{1/2}}{{y}^{1/3}} & = \\\\ {y}^{1/2-1/3} & = \\\\ {y}^{3/6-2/6} & = \\\\ {y}^{1/6}\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\n\\begin{aligned}{y}^{1/6}=\\sqrt[6]{y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186499524 :knowledge-point/_questions [{:db/id #edb/ref 17592186110663 :knowledge-point/id #uuid "014ea973-359e-53f5-9151-adc85e08bd3f" :knowledge-point/title "Combining the Rules of Exponents With Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c464b8a-119e-51a8-ab64-abc53812e731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{{y}^{20}}" :db/id #edb/ref 17592186499008} {:answer/id #uuid "7df0dfb7-2b06-5629-941d-770a6b80e3e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[34]{{y}^{3}}" :db/id #edb/ref 17592186499012} {:answer/id #uuid "a1cb0968-e908-510a-9a85-6ab2251201bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[20]{{y}^{3}}" :db/id #edb/ref 17592186499076} {:answer/id #uuid "b1241184-32b5-5462-84ef-9651c1478e5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{{y}^{19}}" :db/id #edb/ref 17592186499124} {:answer/id #uuid "b1ba8311-f3f5-56e3-b433-b35071e9ac33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{{y}^{34}}" :db/id #edb/ref 17592186499126}] :answer-field/correct {:answer/id #uuid "7c464b8a-119e-51a8-ab64-abc53812e731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{{y}^{20}}" :db/id #edb/ref 17592186499008} :answer-field/id #uuid "d8df651f-f104-583c-9836-0f9f71da1bc3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499415}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "af52435b-8d7b-5fb6-b052-723de06fafd6" :question/math-academy-id "q-104671" :question/problem "Simplify the expression $\\frac{{y}^{9}}{\\sqrt[3]{{y}^{7}}}.$" :question/worked-solution "First, we rewrite the radical as a fractional exponent:\n\n$$\n\\begin{aligned}\\frac{{y}^{9}}{\\sqrt[3]{{y}^{7}}}=\\frac{{y}^{9}}{{({y}^{7})}^{1/3}}\\end{aligned}\n$$\n\nNow, we apply the power rule for exponents:\n\n$$\n\\frac{{y}^{9}}{{({y}^{7})}^{1/3}}=\\frac{{y}^{9}}{{y}^{7(1/3)}}=\\frac{{y}^{9}}{{y}^{7/3}}\n$$\n\nThen, we apply the quotient rule:\n\n$$\n\\begin{aligned}\\frac{{y}^{9}}{{y}^{7/3}} & = \\\\ {y}^{9-7/3} & = \\\\ {y}^{20/3}\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\n\\begin{aligned}{y}^{20/3} & =\\sqrt[3]{{y}^{20}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186110915 :knowledge-point/_questions [{:db/id #edb/ref 17592186110661 :knowledge-point/id #uuid "854edbd5-3aef-5c6b-bb79-967aa241beb2" :knowledge-point/title "Combining the Rules of Exponents Without Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c756396-e727-5a1d-b715-610a47f49def" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{6}" :db/id #edb/ref 17592186498868} {:answer/id #uuid "7a323d59-5faf-5c86-b1dd-4ba95d8c8921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{4}" :db/id #edb/ref 17592186499002} {:answer/id #uuid "b80387b4-edd3-5386-acd2-762477d07957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}{y}^{8}" :db/id #edb/ref 17592186499140} {:answer/id #uuid "c6c5e286-786c-531a-9d5c-0e950304344b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}{y}^{5}" :db/id #edb/ref 17592186499165} {:answer/id #uuid "f782fcb1-f0ea-5483-a7e2-650059b3d532" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}{y}^{2}" :db/id #edb/ref 17592186499285}] :answer-field/correct {:answer/id #uuid "c6c5e286-786c-531a-9d5c-0e950304344b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}{y}^{5}" :db/id #edb/ref 17592186499165} :answer-field/id #uuid "6dc75e3b-a075-5d84-8499-595f1ab73862" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186107381}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a9eb6cb-b287-518f-b5b6-3a57acbb1da3" :question/math-academy-id "q-141978" :question/problem "${(x{y}^{2})}^{2}\\cdot xy=$" :question/worked-solution "We start by using the power of product rule:\n\n$$\n\\begin{aligned}{(x{y}^{2})}^{2}\\cdot xy={x}^{2}\\cdot ({y}^{2})^{2}\\cdot xy & \\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot ({y}^{2})^{2}\\cdot xy & = \\\\ {x}^{2}\\cdot {y}^{2\\cdot 2}\\cdot xy & = \\\\ {x}^{2}\\cdot {y}^{4}\\cdot xy & \\end{aligned}\n$$\n\nFinally, we use the product rule:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {y}^{4}\\cdot xy & = \\\\ ({x}^{2}\\cdot x)\\cdot ({y}^{4}\\cdot y) & = \\\\ {x}^{2+1}\\cdot {y}^{4+1} & = \\\\ {x}^{3}\\cdot {y}^{5} & = \\\\ {x}^{3}{y}^{5} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186499508 :knowledge-point/_questions [{:db/id #edb/ref 17592186110661 :knowledge-point/id #uuid "854edbd5-3aef-5c6b-bb79-967aa241beb2" :knowledge-point/title "Combining the Rules of Exponents Without Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d432e0b-5e73-5082-9179-2c0e5ce1c203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{4}{b}^{2}" :db/id #edb/ref 17592186498793} {:answer/id #uuid "3cb1b4cf-3291-5299-99a3-e0138a299fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{7}{b}^{4}" :db/id #edb/ref 17592186498869} {:answer/id #uuid "4b251482-3f03-5972-a333-8643986852ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{5}{b}^{2}" :db/id #edb/ref 17592186498905} {:answer/id #uuid "a049de80-4ef4-573d-94a4-648d945c51f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{3}{b}^{2}" :db/id #edb/ref 17592186499070} {:answer/id #uuid "e19aa923-8c4f-59fb-90ad-9fe011b14fc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{7}{b}^{2}" :db/id #edb/ref 17592186499237}] :answer-field/correct {:answer/id #uuid "3cb1b4cf-3291-5299-99a3-e0138a299fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{7}{b}^{4}" :db/id #edb/ref 17592186498869} :answer-field/id #uuid "262de599-4be0-58c1-8c31-b5e8da1d1817" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499327}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8bcb7c88-fa9c-5de4-82d6-48872f12ed89" :question/math-academy-id "q-141984" :question/problem "${({a}^{2}b)}^{3}\\cdot ab=$" :question/worked-solution "We start by using the power of product rule:\n\n$$\n\\begin{aligned}{({a}^{2}b)}^{3}\\cdot ab=({a}^{2})^{3}\\cdot {b}^{3}\\cdot ab & \\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}({a}^{2})^{3}\\cdot {b}^{3}\\cdot ab & = \\\\ {a}^{2\\cdot 3}\\cdot {b}^{3}\\cdot ab & = \\\\ {a}^{6}\\cdot {b}^{3}\\cdot ab & \\end{aligned}\n$$\n\nFinally, we use the product rule:\n\n$$\n\\begin{aligned}{a}^{6}\\cdot {b}^{3}\\cdot ab & = \\\\ ({a}^{6}\\cdot a)\\cdot ({b}^{3}\\cdot b) & = \\\\ {a}^{6+1}\\cdot {b}^{3+1} & = \\\\ {a}^{7}\\cdot {b}^{4} & = \\\\ {a}^{7}{b}^{4} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186499483 :knowledge-point/_questions [{:db/id #edb/ref 17592186110663 :knowledge-point/id #uuid "014ea973-359e-53f5-9151-adc85e08bd3f" :knowledge-point/title "Combining the Rules of Exponents With Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2c17b6-ee01-55d3-81de-a6a069a28374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{{y}^{4}}" :db/id #edb/ref 17592186498752} {:answer/id #uuid "7470470e-9dcb-5cb6-a298-354e8bd306a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[6]{y}" :db/id #edb/ref 17592186498987} {:answer/id #uuid "b150665b-cc55-5a3e-9bc9-352c3cbb62f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{{y}^{3}}" :db/id #edb/ref 17592186499125} {:answer/id #uuid "b33aa548-4b46-5ab9-830b-ffa8ce5ad423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{y}" :db/id #edb/ref 17592186499130} {:answer/id #uuid "badfdb89-f38f-5c6f-b938-cf0c832948ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{y}" :db/id #edb/ref 17592186499148}] :answer-field/correct {:answer/id #uuid "b150665b-cc55-5a3e-9bc9-352c3cbb62f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{{y}^{3}}" :db/id #edb/ref 17592186499125} :answer-field/id #uuid "2373b85f-68d6-5beb-815d-bde5b1392e92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499326}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64c8a090-cafc-5e88-b591-72ecb0cc7b81" :question/math-academy-id "q-142145" :question/problem "Simplify the expression $\\sqrt{y}\\cdot \\sqrt[4]{y}.$" :question/worked-solution "First, we rewrite the radical as a fractional exponent:\n\n$$\n\\begin{aligned}\\sqrt{y}\\cdot \\sqrt[4]{y}={y}^{1/2}\\cdot {y}^{1/4}\\end{aligned}\n$$\n\nThen, we apply the product rule:\n\n$$\n\\begin{aligned}{y}^{1/2}\\cdot {y}^{1/4} & = \\\\ {y}^{1/2+1/4} & = \\\\ {y}^{3/4}\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\n\\begin{aligned}{y}^{3/4} & =\\sqrt[4]{{y}^{3}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186499549 :knowledge-point/_questions [{:db/id #edb/ref 17592186110662 :knowledge-point/id #uuid "736c1b75-fe60-5f0a-b426-a19f3edaaa2b" :knowledge-point/title "Combining the Rules of Exponents With Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "465a9a31-c9a7-5242-b06e-83d1de732242" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{u}^{10}}{32{v}^{20}}" :db/id #edb/ref 17592186498892} {:answer/id #uuid "4ea53a6a-43cc-5424-b0c0-f4959baa4754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{u}^{7}}{32{v}^{9}}" :db/id #edb/ref 17592186498913} {:answer/id #uuid "6842d70f-c788-545a-96c5-2eb791e9c865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{u}^{5}}{16{v}^{5}}" :db/id #edb/ref 17592186498965} {:answer/id #uuid "a8cdef2e-ff7f-5848-8193-597d13abef49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{u}^{6}}{8{v}^{12}}" :db/id #edb/ref 17592186499100} {:answer/id #uuid "cc5a67c3-eb72-52e8-8d6e-906807a56f0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{u}^{10}}{2{v}^{20}}" :db/id #edb/ref 17592186499182}] :answer-field/correct {:answer/id #uuid "465a9a31-c9a7-5242-b06e-83d1de732242" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{u}^{10}}{32{v}^{20}}" :db/id #edb/ref 17592186498892} :answer-field/id #uuid "e4acd8be-661d-5d96-83bb-5a718612e8be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499418}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e0110074-4c62-517f-b5cb-ff4cff4e0579" :question/math-academy-id "q-22838" :question/problem "Which of the following is equivalent to ${(\\frac{{u}^{2}}{-2{v}^{4}})}^{5}?$" :question/worked-solution "We start by using the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{{u}^{2}}{-2{v}^{4}})}^{5} & = \\\\ \\frac{{({u}^{2})}^{5}}{{(-2{v}^{4})}^{5}} & \\end{aligned}\n$$\n\nThen, we apply the power rule in the numerator and the power of product rule in the denominator:\n\n$$\n\\begin{aligned}\\frac{{({u}^{2})}^{5}}{{(-2{v}^{4})}^{5}} & = \\\\ \\frac{{u}^{2\\cdot 5}}{(-2)^{5}\\cdot {({v}^{4})}^{5}} & = \\\\ \\frac{{u}^{10}}{(-2)^{5}\\cdot {({v}^{4})}^{5}} & \\end{aligned}\n$$\n\nFinally, we apply the power rule for exponents:\n\n$$\n\\begin{aligned}\\frac{{u}^{10}}{(-2)^{5}\\cdot {({v}^{4})}^{5}} & = \\\\ \\frac{{u}^{10}}{(-2)^{5}\\cdot {v}^{4\\cdot 5}} & = \\\\ \\frac{{u}^{10}}{(-32)\\cdot {v}^{20}} & = \\\\ -\\frac{{u}^{10}}{32{v}^{20}} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111086 :knowledge-point/_questions [{:db/id #edb/ref 17592186110662 :knowledge-point/id #uuid "736c1b75-fe60-5f0a-b426-a19f3edaaa2b" :knowledge-point/title "Combining the Rules of Exponents With Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c3799d1-e22b-508b-99e0-e101484e5368" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{4}y" :db/id #edb/ref 17592186498753} {:answer/id #uuid "1eeb7505-876b-5c0c-aba8-8336a6626599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{3}y" :db/id #edb/ref 17592186498797} {:answer/id #uuid "2e7d26d8-c88e-5fdd-a2e2-2527a68c8ea4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{4}" :db/id #edb/ref 17592186498834} {:answer/id #uuid "ba2a519f-707c-578b-92d0-e04043008181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{4}{y}^{2}" :db/id #edb/ref 17592186499147} {:answer/id #uuid "cb1f5daa-1a7b-5b59-9eaf-11ba1bde0022" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{4}{y}^{2}" :db/id #edb/ref 17592186499177}] :answer-field/correct {:answer/id #uuid "0c3799d1-e22b-508b-99e0-e101484e5368" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{4}y" :db/id #edb/ref 17592186498753} :answer-field/id #uuid "79a1b12e-9b5e-5cf2-a5c0-09f1566e0c71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108275}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d7c1ad1-12d2-56a0-a936-eae89426f942" :question/math-academy-id "q-2629" :question/problem "$\\frac{100{x}^{7}{y}^{3}}{20{x}^{3}{y}^{2}}=$" :question/worked-solution "We separate the fraction, group the two variables separately, and apply the quotient rule:\n\n$$\n\\begin{aligned}\\frac{100{x}^{7}{y}^{3}}{20{x}^{3}{y}^{2}} & = \\\\ \\frac{100}{20}\\cdot \\frac{{x}^{7}}{{x}^{3}}\\cdot \\frac{{y}^{3}}{{y}^{2}} & = \\\\ 5\\cdot {x}^{(7-3)}\\cdot {y}^{(3-2)} & = \\\\ 5{x}^{4}{y}^{1} & = \\\\ 5{x}^{4}y\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186499500 :knowledge-point/_questions [{:db/id #edb/ref 17592186110663 :knowledge-point/id #uuid "014ea973-359e-53f5-9151-adc85e08bd3f" :knowledge-point/title "Combining the Rules of Exponents With Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f28308b-720b-5df8-a2b3-3f5e70ac4866" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{{y}^{3}}" :db/id #edb/ref 17592186498838} {:answer/id #uuid "3195d9ce-4aa6-599a-be0b-62ab0a5b2c62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{y}" :db/id #edb/ref 17592186498845} {:answer/id #uuid "a28d9916-0048-550e-ab13-3f717c29f173" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{{y}^{5}}" :db/id #edb/ref 17592186499079} {:answer/id #uuid "bd06633e-df0e-50eb-902f-8ff48110959f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{{y}^{5}}" :db/id #edb/ref 17592186499150} {:answer/id #uuid "c48364e6-a284-5fda-a5f7-dfb7c464c310" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{y}" :db/id #edb/ref 17592186499162}] :answer-field/correct {:answer/id #uuid "bd06633e-df0e-50eb-902f-8ff48110959f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{{y}^{5}}" :db/id #edb/ref 17592186499150} :answer-field/id #uuid "f2675a89-c5db-5be6-a863-504dfe78916e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499426}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "842d5936-85a3-5b6e-b4fa-f505a9d0860b" :question/math-academy-id "q-72511" :question/problem "Simplify the expression $y\\cdot \\sqrt[4]{y}.$" :question/worked-solution "First, we rewrite the radical as a fractional exponent:\n\n$$\n\\begin{aligned}y\\cdot \\sqrt[4]{y}=y\\cdot {y}^{1/4}\\end{aligned}\n$$\n\nThen, we apply the product rule:\n\n$$\n\\begin{aligned}y\\cdot {y}^{1/4} & = \\\\ {y}^{1+1/4} & = \\\\ {y}^{5/4}\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\n\\begin{aligned}{y}^{5/4} & =\\sqrt[4]{{y}^{5}}\\end{aligned}\n$$"}]}
