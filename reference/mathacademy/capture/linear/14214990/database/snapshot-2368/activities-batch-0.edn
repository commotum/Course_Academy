#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186088543} :activity/id #uuid "cfe67386-85ee-52bc-a19f-9e5f91df386d" :activity/scope {:db/id #edb/ref 17592186049840 :topic/id #uuid "17f87fcb-3fe5-5ecd-ba54-8883ffee898f" :topic/math-academy-id 839} :activity/steps [{:db/id #edb/ref 17592186088543 :step/content {:db/id #edb/ref 17592186088991 :tutorial/content "The **standard form** equation of a line is \n\n$$\nax+by=c,\n$$\n\nwhere\n\n- $a,b,$ and $c$ are all integers,\n\n- $a \\geq 0,$ and\n\n- $a,b,$ and $c$ have no common factors.\n\nNote that we always write $x$ *before* $y$ on the left-hand side!\n\nLet's see some examples:\n\n- The equation $2x - y= -5$ is in standard form. Indeed, the variables are on the left-hand side, while the constant term is on the right-hand side:\n\n$$\n\\underbrace{2x - y}_{\\textrm{variables}} \\quad = \\underbrace{-5\\phantom{y}}_{\\textrm{constant}}\n$$\n\n \nAll coefficients are integers (namely, $2,$ $-1,$ and $-5$) and don't have common factors greater than $1.$ Also, the coefficient of $x$ is non-negative ($2$).\n\n- The equation $-3x + y = 1$ is *not* in standard form because the coefficient of $x$ is negative ($-3$).\n\n- The equation $2x+4y = -10$ is *not* in standard form because the coefficients $(2,4,$ and $-10)$ have a common factor of $2.$\n\n- The equation $\\dfrac12x+\\dfrac13y = 6$ is *not* in standard form because the coefficients of $x$ and $y$ are not integers." :tutorial/id #uuid "739ff387-5940-547f-adac-8b2ac8e5a229" :tutorial/math-academy-id 9126 :tutorial/title "Introduction"} :step/id #uuid "0f6a809a-5a39-577f-8881-246e8ed35867" :step/math-academy-id 178720 :step/next {:db/id #edb/ref 17592186088544}} {:db/id #edb/ref 17592186088544 :step/content {:db/id #edb/ref 17592186087709 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087437 :question/id #uuid "5faa755c-1e2d-52a7-a521-49f79b94ec39" :question/math-academy-id "e-14709"} :knowledge-point/id #uuid "8e2458e5-8061-5f3f-9b4f-4d0bdd0ec641" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049935} {:db/id #edb/ref 17592186050581}] :knowledge-point/questions [{:db/id #edb/ref 17592186088071} {:db/id #edb/ref 17592186088074} {:db/id #edb/ref 17592186088219} {:db/id #edb/ref 17592186493927} {:db/id #edb/ref 17592186493955}] :knowledge-point/title "Identifying Equations Written in Standard Form"} :step/id #uuid "e1825121-20e1-5854-9a35-360f43ffb277" :step/math-academy-id 178721 :step/next {:db/id #edb/ref 17592186088545}} {:db/id #edb/ref 17592186088545 :step/content {:db/id #edb/ref 17592186088993 :tutorial/content "Let's now discuss how to convert the equation of a line to standard form.\n\nTo illustrate, we will take the line $y = 2x-1$ and convert it into standard form. We begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side.\n\n$$\n\\begin{aligned}y & =2x-1 \\\\ y-2x & =-1 \\\\ -2x+y & =-1\\end{aligned}\n$$\n\nNow the equation is in the form $ax+by=c.$ However, it violates the rule $a \\geq 0.$ We can fix this by multiplying the equation by $-1$ as follows:\n\n$$\n\\begin{aligned}-2x+y & =-1 \\\\ (-1)\\cdot (-2x+y) & =(-1)\\cdot (-1) \\\\ 2x-y & =1\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a \\geq 0.$ So, we are done!\n\nThe standard form of the line is $2x-y=1.$" :tutorial/id #uuid "914fb469-510e-5e74-92bc-6174870cbd47" :tutorial/math-academy-id 9221 :tutorial/title "Converting a Line to Standard Form"} :step/id #uuid "1ad80f23-5479-5329-8fd1-39cf7d32c8f0" :step/math-academy-id 178725 :step/next {:db/id #edb/ref 17592186088546}} {:db/id #edb/ref 17592186088546 :step/content {:db/id #edb/ref 17592186087710 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087438 :question/id #uuid "7a4196bc-1f72-5435-9c00-c1fbef60b549" :question/math-academy-id "e-14710"} :knowledge-point/id #uuid "f399f6ed-91bc-594e-9a40-b7c79f60c5dc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050622}] :knowledge-point/questions [{:db/id #edb/ref 17592186088065} {:db/id #edb/ref 17592186088299} {:db/id #edb/ref 17592186088300} {:db/id #edb/ref 17592186235494} {:db/id #edb/ref 17592186493934} {:db/id #edb/ref 17592186493940} {:db/id #edb/ref 17592186523946}] :knowledge-point/title "Converting from Slope-Intercept Form to Standard Form"} :step/id #uuid "219a19a2-5ca7-55ec-b664-706e0003f956" :step/math-academy-id 178726 :step/next {:db/id #edb/ref 17592186088547}} {:db/id #edb/ref 17592186088547 :step/content {:db/id #edb/ref 17592186087711 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087439 :question/id #uuid "9e0c4000-c24e-5761-8cbe-60699b557eca" :question/math-academy-id "e-14711"} :knowledge-point/id #uuid "daa37544-c4ec-5b8b-91a5-ccf5ee8f50d6" :knowledge-point/questions [{:db/id #edb/ref 17592186088002} {:db/id #edb/ref 17592186088069} {:db/id #edb/ref 17592186493922} {:db/id #edb/ref 17592186493928} {:db/id #edb/ref 17592186501171} {:db/id #edb/ref 17592186526035}] :knowledge-point/title "Converting an Arbitrary Line to Standard Form"} :step/id #uuid "54390c19-603c-54bd-bf54-163d31414029" :step/math-academy-id 178730 :step/next {:db/id #edb/ref 17592186088548}} {:db/id #edb/ref 17592186088548 :step/content {:db/id #edb/ref 17592186087712 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087440 :question/id #uuid "f78832f7-acd3-5779-b171-0650782b918e" :question/math-academy-id "e-14712"} :knowledge-point/id #uuid "eefba93e-12c7-5835-80fb-b36463f140d8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061} {:db/id #edb/ref 17592186050635}] :knowledge-point/questions [{:db/id #edb/ref 17592186088066} {:db/id #edb/ref 17592186088070} {:db/id #edb/ref 17592186088301} {:db/id #edb/ref 17592186493891} {:db/id #edb/ref 17592186501182} {:db/id #edb/ref 17592186501213}] :knowledge-point/title "Finding the Standard Equation of a Line Passing Through Two Points"} :step/id #uuid "5756f274-95fd-5077-9cb0-2b24aadadb72" :step/math-academy-id 178733}] :activity/title "Equations of Lines in Standard Form" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087911}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186501288} :activity/id #uuid "ea710b72-1ae9-594f-81f0-bb4e388075ac" :activity/scope {:db/id #edb/ref 17592186049840 :topic/id #uuid "17f87fcb-3fe5-5ecd-ba54-8883ffee898f" :topic/math-academy-id 839} :activity/steps [{:db/id #edb/ref 17592186501256 :step/content {:db/id #edb/ref 17592186501171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ff46960-a634-5a81-ae1f-2ca39d897a7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x=4y-3" :db/id #edb/ref 17592186500593} {:answer/id #uuid "79487712-6da4-5496-8225-aac3af672e2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4y=3x+3" :db/id #edb/ref 17592186500719} {:answer/id #uuid "b8f9749e-7d8c-55a2-9037-1039c6ab8a8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-2y=-1" :db/id #edb/ref 17592186500852} {:answer/id #uuid "dd48f16b-2a4a-5029-a026-63bc2965823a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-4y+3=0" :db/id #edb/ref 17592186500938} {:answer/id #uuid "ec6efbc0-8d44-5de2-87c8-4041efd1a2f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-4y=-3" :db/id #edb/ref 17592186500972}] :answer-field/correct {:db/id #edb/ref 17592186500972} :answer-field/id #uuid "5ecaf1bd-48c2-52f6-ac2e-e2c732914f1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501059}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "654a7d79-4ae5-544e-b9a0-d1ca56a9cbc1" :question/math-academy-id "q-109618" :question/problem "Write $3-4y=-3x$ in standard form." :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side. This gives\n\n$$\n3x-4y=-3.\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is $3x-4y=-3.$"} :step/id #uuid "20f07fd1-d467-5612-a99b-42e2c6facda8"} {:db/id #edb/ref 17592186501288 :step/content {:db/id #edb/ref 17592186501182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4948554b-8702-53e2-9b75-d60c9757c1b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-2y=1" :db/id #edb/ref 17592186500613} {:answer/id #uuid "81c06851-5a55-515e-b014-4e1a61503690" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2y=3x-1" :db/id #edb/ref 17592186500734} {:answer/id #uuid "9a1bd908-d894-5634-a386-eae6d2558b62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7x-4y=0" :db/id #edb/ref 17592186500780} {:answer/id #uuid "ace9b919-181f-5f85-aacf-3f2308c62bcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-\\frac{4}{7}\\,y=0" :db/id #edb/ref 17592186500824} {:answer/id #uuid "fc01bcb9-ef79-5851-a139-46cdb6164d5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4y=7x" :db/id #edb/ref 17592186501004}] :answer-field/correct {:db/id #edb/ref 17592186500780} :answer-field/id #uuid "cf0b3dce-d893-5070-8809-d9f2b47f02b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501112}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7638fe82-2585-52d0-beb7-40611addaef6" :question/math-academy-id "q-44202" :question/problem "What is the equation of the line that passes through the points $(0,0)$ and $(4,7)$, expressed in standard form?" :question/worked-solution "First, we will construct the point-slope form of the line. Then, we will simplify it into standard form.\n\nTo construct the point-slope form of the line, we need a point and a slope. We already have two points, so we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{7-0}{4-0}=\\frac{7}{4}\\end{aligned}\n$$\n\nThen, we use this slope along with one of the points to write the point-slope form equation of the line. It doesn't matter which point we choose, but let's choose $(0,0).$ The point-slope equation is as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =\\frac{7}{4}(x-0) \\\\ y & =\\frac{7}{4}x\\end{aligned}\n$$\n\nTo simplify the point-slope formula into standard form, we first multiply by $4$ to get rid of the fraction:\n\n$$\n\\begin{aligned}y & =\\frac{7}{4}(x) \\\\ 4\\cdot (y) & =4\\cdot \\frac{7}{4}(x) \\\\ 4y & =7x\\end{aligned}\n$$\n\nThen, we move the variables to the left side and the constant to the right side:\n\n$$\n\\begin{aligned}4y & =7x \\\\ -7x+4y & =0\\end{aligned}\n$$\n\nFinally, we multiply by $-1$ to make the $x$-coefficient positive:\n\n$$\n\\begin{aligned}-7x+4y & =0 \\\\ (-1)\\cdot (-7x+4y) & =(-1)\\cdot 0 \\\\ 7x-4y & =0\\end{aligned}\n$$\n\nSo, the standard form of the equation is $7x-4y=0.$"} :step/id #uuid "b7421da9-e8bc-5823-9858-330f84d2ecf1" :step/next {:db/id #edb/ref 17592186501292}} {:db/id #edb/ref 17592186501292 :step/content {:db/id #edb/ref 17592186501213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa1d2cc4-2934-5c01-acf3-e4688de64dff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x-y=6" :db/id #edb/ref 17592186500819} {:answer/id #uuid "c0d0840e-b8f1-5833-899d-775ab6668a32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-y=3" :db/id #edb/ref 17592186500867} {:answer/id #uuid "c3d3f7b4-e921-553d-88ad-be60876e12b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2x-3" :db/id #edb/ref 17592186500877} {:answer/id #uuid "ca9d0db1-1d42-546b-8c61-bc0bc89d225c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4x+y=-6" :db/id #edb/ref 17592186500896} {:answer/id #uuid "cf99202c-1f33-5c86-9aa3-ff042e4be5ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+2y=4" :db/id #edb/ref 17592186500913}] :answer-field/correct {:db/id #edb/ref 17592186500819} :answer-field/id #uuid "2ee1d5f3-79b0-529f-9d27-584c54dd513d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501034}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b34b9e0f-ca1a-53ee-8948-5e07722771b6" :question/math-academy-id "q-72425" :question/problem "What is the equation of the line that passes through the points $(1,-2)$ and $(3,6)$, expressed in standard form?" :question/worked-solution "First, we will construct the point-slope form of the line. Then, we will simplify it into standard form.\n\nTo construct the point-slope form of the line, we need a point and a slope. We already have two points, so we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{6-(-2)}{3-1}=\\frac{8}{2}=4\\end{aligned}\n$$\n\nThen, we use this slope along with one of the points to write the point-slope form equation of the line. It doesn't matter which point we choose, but let's choose $(1,-2).$ The point-slope equation is as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-2) & =4(x-1) \\\\ y+2 & =4(x-1)\\end{aligned}\n$$\n\nNext, we simplify the point-slope formula into standard form, moving the variables to the left side and the constant to the right side:\n\n$$\n\\begin{aligned}y+2 & =4(x-1) \\\\ y+2 & =4x-4 \\\\ y & =4x-6 \\\\ -4x+y & =-6\\end{aligned}\n$$\n\nFinally, we multiply by $-1$ to make the $x$-coefficient positive:\n\n$$\n\\begin{aligned}-4x+y & =-6 \\\\ (-1)\\cdot (-4x+y) & =(-1)\\cdot (-6) \\\\ 4x-y & =6\\end{aligned}\n$$\n\nSo, the standard form of the equation is $4x-y=6.$"} :step/id #uuid "dbbb55d2-6ac7-5cb1-a4a3-8f1b82a1b491" :step/next {:db/id #edb/ref 17592186501256}}] :activity/title "Equations of Lines in Standard Form" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186500468}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186526118} :activity/id #uuid "5fd46b7c-ef09-527e-bc1f-fb6f5543dee9" :activity/scope {:db/id #edb/ref 17592186049840 :topic/id #uuid "17f87fcb-3fe5-5ecd-ba54-8883ffee898f" :topic/math-academy-id 839} :activity/steps [{:db/id #edb/ref 17592186526118 :step/content {:db/id #edb/ref 17592186088300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ce635f8-4383-5e2d-baa8-462f0646a57d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2x-10" :db/id #edb/ref 17592186525359} {:answer/id #uuid "56dcaada-2e45-5e47-b10d-7423de786283" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-2x=10" :db/id #edb/ref 17592186525431} {:answer/id #uuid "a64fc9d9-1954-54bb-9104-2c70061145e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+y=10" :db/id #edb/ref 17592186525626} {:answer/id #uuid "a9fc8576-442e-5448-9c72-26dd2ff8c409" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-y=10" :db/id #edb/ref 17592186525635} {:answer/id #uuid "b0e5661e-64af-5f76-ad7e-bb04261a05bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+y-10=0" :db/id #edb/ref 17592186525654}] :answer-field/correct {:db/id #edb/ref 17592186525635} :answer-field/id #uuid "8bedc031-1af4-59be-8827-ddccc40055ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186086454}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1ddc1b00-1388-5ab1-b4ec-fe79f4a369ed" :question/math-academy-id "q-7375" :question/problem "Write $y=2x-10$ in standard form." :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side. This gives\n\n$$\n-2x+y=-10\n$$\n\nNow, we multiply both sides of the equation by $-1:$\n\n$$\n\\begin{aligned}-2x+y & =-10 \\\\ (-1)\\cdot (-2x+y) & =(-1)\\cdot (-10) \\\\ 2x-y & =10.\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is $2x-y=10.$"} :step/id #uuid "5531d2d2-4653-5821-ad34-95da930170ae" :step/next {:db/id #edb/ref 17592186526148}} {:db/id #edb/ref 17592186526128 :step/content {:db/id #edb/ref 17592186088065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50e5beee-cd5d-5d0e-a06c-ed2bcb868f66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+10y" :db/id #edb/ref 17592186525416}] :answer-field/correct {:db/id #edb/ref 17592186525416} :answer-field/id #uuid "ca145851-e9d5-53d0-b524-37f7de7eeb0b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186085124} {:answer-field/choices [{:answer/id #uuid "7c83729c-0f7e-5ffe-bf01-d09e27351dab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186525515}] :answer-field/correct {:db/id #edb/ref 17592186525515} :answer-field/id #uuid "6f29fa38-38be-5d7a-8b04-017c959f4e64" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186085125}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b90758e4-7aff-5ee7-bbb0-64e72c86781c" :question/math-academy-id "q-208783" :question/problem "Express the equation of the line $y=-\\frac{1}{5}x+\\frac{1}{2}$ in standard form.\n\n{{field-1}}\n\n$=$\n{{field-2}}" :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side. This gives\n\n$$\n\\frac{1}{5}x+y=\\frac{1}{2}\n$$\n\nNow, we multiply both sides of the equation by $10:$\n\n$$\n\\begin{aligned}\\frac{1}{5}x+y & =\\frac{1}{2} \\\\ 10\\cdot (\\frac{1}{5}x+y) & =10\\cdot (\\frac{1}{2}) \\\\ 2x+10y & =5.\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is \n\n$$\n2x+10y=5.\n$$"} :step/id #uuid "81bb2396-2021-540b-9bce-0c126fd371de"} {:db/id #edb/ref 17592186526148 :step/content {:db/id #edb/ref 17592186526035 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01ceb895-6483-595f-b812-ce7792346c53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+10y=-4" :db/id #edb/ref 17592186525213} {:answer/id #uuid "38916548-028a-5017-811a-5ecb8cc9b06a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+11y=-2" :db/id #edb/ref 17592186525345} {:answer/id #uuid "669b434e-e144-50c0-890a-a5e64976a180" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-11y=-4" :db/id #edb/ref 17592186525468} {:answer/id #uuid "9f12e004-fb3b-598c-9d12-4da7ab0cd767" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+11y=-4" :db/id #edb/ref 17592186525612} {:answer/id #uuid "f2361365-100c-59dd-ae92-0d3dd51e9ba8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+11y=-4" :db/id #edb/ref 17592186525811}] :answer-field/correct {:db/id #edb/ref 17592186525811} :answer-field/id #uuid "38e9167e-6f24-5db2-a3c7-7d0d60e4c2f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186525876}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "704b5a22-e7b8-5a05-8c48-94b98e94c6e2" :question/math-academy-id "q-22753" :question/problem "Write $2x+22y=-8$ in standard form." :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nThe equation is in the form $ax+by=c.$ However, $a,b,$ and $c$ have a common factor of $2.$ So, we divide by $2$ as follows:\n\n$$\n\\begin{aligned}2x+22y & =-8 \\\\ \\frac{2x+22y}{2} & =\\frac{-8}{2} \\\\ x+11y & =-4\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is $x+11y=-4.$"} :step/id #uuid "e46359de-50c7-51f6-b170-e204f33ff01e" :step/next {:db/id #edb/ref 17592186526128}}] :activity/title "Equations of Lines in Standard Form" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186525201}]}
