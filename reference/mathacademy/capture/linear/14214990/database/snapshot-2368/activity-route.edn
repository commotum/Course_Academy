#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186526118} :activity/id #uuid "5fd46b7c-ef09-527e-bc1f-fb6f5543dee9" :activity/scope {:db/id #edb/ref 17592186049840 :topic/id #uuid "17f87fcb-3fe5-5ecd-ba54-8883ffee898f" :topic/math-academy-id 839} :activity/steps [{:db/id #edb/ref 17592186526118 :step/content {:db/id #edb/ref 17592186088300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ce635f8-4383-5e2d-baa8-462f0646a57d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2x-10" :db/id #edb/ref 17592186525359} {:answer/id #uuid "56dcaada-2e45-5e47-b10d-7423de786283" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y-2x=10" :db/id #edb/ref 17592186525431} {:answer/id #uuid "a64fc9d9-1954-54bb-9104-2c70061145e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+y=10" :db/id #edb/ref 17592186525626} {:answer/id #uuid "a9fc8576-442e-5448-9c72-26dd2ff8c409" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-y=10" :db/id #edb/ref 17592186525635} {:answer/id #uuid "b0e5661e-64af-5f76-ad7e-bb04261a05bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+y-10=0" :db/id #edb/ref 17592186525654}] :answer-field/correct {:db/id #edb/ref 17592186525635} :answer-field/id #uuid "8bedc031-1af4-59be-8827-ddccc40055ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186086454}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1ddc1b00-1388-5ab1-b4ec-fe79f4a369ed" :question/math-academy-id "q-7375" :question/problem "Write $y=2x-10$ in standard form." :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side. This gives\n\n$$\n-2x+y=-10\n$$\n\nNow, we multiply both sides of the equation by $-1:$\n\n$$\n\\begin{aligned}-2x+y & =-10 \\\\ (-1)\\cdot (-2x+y) & =(-1)\\cdot (-10) \\\\ 2x-y & =10.\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is $2x-y=10.$"} :step/id #uuid "5531d2d2-4653-5821-ad34-95da930170ae" :step/next {:db/id #edb/ref 17592186526148}} {:db/id #edb/ref 17592186526128 :step/content {:db/id #edb/ref 17592186088065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50e5beee-cd5d-5d0e-a06c-ed2bcb868f66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+10y" :db/id #edb/ref 17592186525416}] :answer-field/correct {:db/id #edb/ref 17592186525416} :answer-field/id #uuid "ca145851-e9d5-53d0-b524-37f7de7eeb0b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186085124} {:answer-field/choices [{:answer/id #uuid "7c83729c-0f7e-5ffe-bf01-d09e27351dab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186525515}] :answer-field/correct {:db/id #edb/ref 17592186525515} :answer-field/id #uuid "6f29fa38-38be-5d7a-8b04-017c959f4e64" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186085125}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b90758e4-7aff-5ee7-bbb0-64e72c86781c" :question/math-academy-id "q-208783" :question/problem "Express the equation of the line $y=-\\frac{1}{5}x+\\frac{1}{2}$ in standard form.\n\n{{field-1}}\n\n$=$\n{{field-2}}" :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side. This gives\n\n$$\n\\frac{1}{5}x+y=\\frac{1}{2}\n$$\n\nNow, we multiply both sides of the equation by $10:$\n\n$$\n\\begin{aligned}\\frac{1}{5}x+y & =\\frac{1}{2} \\\\ 10\\cdot (\\frac{1}{5}x+y) & =10\\cdot (\\frac{1}{2}) \\\\ 2x+10y & =5.\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is \n\n$$\n2x+10y=5.\n$$"} :step/id #uuid "81bb2396-2021-540b-9bce-0c126fd371de"} {:db/id #edb/ref 17592186526148 :step/content {:db/id #edb/ref 17592186526035 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01ceb895-6483-595f-b812-ce7792346c53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+10y=-4" :db/id #edb/ref 17592186525213} {:answer/id #uuid "38916548-028a-5017-811a-5ecb8cc9b06a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+11y=-2" :db/id #edb/ref 17592186525345} {:answer/id #uuid "669b434e-e144-50c0-890a-a5e64976a180" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-11y=-4" :db/id #edb/ref 17592186525468} {:answer/id #uuid "9f12e004-fb3b-598c-9d12-4da7ab0cd767" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+11y=-4" :db/id #edb/ref 17592186525612} {:answer/id #uuid "f2361365-100c-59dd-ae92-0d3dd51e9ba8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+11y=-4" :db/id #edb/ref 17592186525811}] :answer-field/correct {:db/id #edb/ref 17592186525811} :answer-field/id #uuid "38e9167e-6f24-5db2-a3c7-7d0d60e4c2f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186525876}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "704b5a22-e7b8-5a05-8c48-94b98e94c6e2" :question/math-academy-id "q-22753" :question/problem "Write $2x+22y=-8$ in standard form." :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nThe equation is in the form $ax+by=c.$ However, $a,b,$ and $c$ have a common factor of $2.$ So, we divide by $2$ as follows:\n\n$$\n\\begin{aligned}2x+22y & =-8 \\\\ \\frac{2x+22y}{2} & =\\frac{-8}{2} \\\\ x+11y & =-4\\end{aligned}\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is $x+11y=-4.$"} :step/id #uuid "e46359de-50c7-51f6-b170-e204f33ff01e" :step/next {:db/id #edb/ref 17592186526128}}] :activity/title "Equations of Lines in Standard Form" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186525201}]}
