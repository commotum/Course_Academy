#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186554671} :activity/id #uuid "18d4c92e-e0a8-5b92-a68e-b9cd79663667" :activity/scope {:db/id #edb/ref 17592186050496 :topic/id #uuid "4dc7f0d4-7695-5efd-99c0-299924cc9d4b" :topic/math-academy-id 389} :activity/steps [{:db/id #edb/ref 17592186554671 :step/content {:db/id #edb/ref 17592186554540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0431e39d-71d1-5768-88be-409ca33f6c7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{y}^{2}\\sqrt{5}" :db/id #edb/ref 17592186553875} {:answer/id #uuid "369e7a6b-727f-5c71-8be5-8892046afcfb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3y\\sqrt{5}" :db/id #edb/ref 17592186553967} {:answer/id #uuid "78a5d1c0-2297-5d46-9446-2060429a75d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15y" :db/id #edb/ref 17592186554112} {:answer/id #uuid "889645be-9d28-546a-9122-d1ad0f6e84d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5y\\sqrt{3}" :db/id #edb/ref 17592186554155} {:answer/id #uuid "d1a5b4b0-a22e-503c-b26d-aee6391ea028" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{5y}" :db/id #edb/ref 17592186554325}] :answer-field/correct {:db/id #edb/ref 17592186553967} :answer-field/id #uuid "391f389b-05b6-594c-95d0-cca64d0e6b52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554452}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "09d71431-cc0e-5153-8350-c0a86eafb77b" :question/math-academy-id "q-3047" :question/problem "Simplify $\\sqrt{45{y}^{2}}$ given that $y\\ge 0.$" :question/worked-solution "We first write $45{y}^{2}$ as the product $9{y}^{2}\\cdot 5$ which contains a perfect square $(9{y}^{2}).$ Then, we can separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{45{y}^{2}} & = \\\\ \\sqrt{9{y}^{2}\\cdot 5} & = \\\\ \\sqrt{(3y)^{2}\\cdot 5} & = \\\\ \\sqrt{(3y)^{2}}\\cdot \\sqrt{5} & = \\\\ |3y|\\cdot \\sqrt{5} & = \\\\ |3|\\cdot |y|\\cdot \\sqrt{5} & = \\\\ 3\\cdot |y|\\cdot \\sqrt{5}\\end{aligned}\n$$\n\nSince $y\\ge 0,$ we have $|y|=y,$ and we can simplify further. Therefore, our final answer is\n\n$$\n\\begin{aligned}3\\cdot |y|\\cdot \\sqrt{5} & = \\\\ 3\\cdot y\\cdot \\sqrt{5} & = \\\\ 3y\\sqrt{5}.\\end{aligned}\n$$"} :step/id #uuid "4793c529-2358-59fb-98fc-407d9b60139f" :step/next {:db/id #edb/ref 17592186554727}} {:db/id #edb/ref 17592186554704 :step/content {:db/id #edb/ref 17592186554641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c8d00de-5cfb-5d7d-b6ce-1a3fcf580c19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{n}^{2}\\sqrt{5n}" :db/id #edb/ref 17592186553951} {:answer/id #uuid "493f354b-b71f-58ef-b5af-c43b305893c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2n\\sqrt{5n}" :db/id #edb/ref 17592186554009} {:answer/id #uuid "8a439d62-6628-5381-a609-99d4cc463d9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5n\\sqrt{2n}" :db/id #edb/ref 17592186554162} {:answer/id #uuid "c8dc9bd6-1c8a-5517-9d4e-a5d506cda766" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{n}^{2}\\sqrt{2n}" :db/id #edb/ref 17592186554312} {:answer/id #uuid "ddeb1d91-9f54-55f6-b72d-fd60d991fa39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{n}^{2}\\sqrt{5n}" :db/id #edb/ref 17592186554353}] :answer-field/correct {:db/id #edb/ref 17592186553951} :answer-field/id #uuid "5f773159-8463-5e37-81f8-8746b86bfcf3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554468}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f380d0a4-2ab4-5ffd-9f65-88568a9b06d4" :question/math-academy-id "q-33483" :question/problem "Simplify $\\sqrt{20{n}^{5}}.$" :question/worked-solution "We first write $20{n}^{5}$ as the product $4{n}^{4}\\cdot 5n$ which contains a perfect square $(4{n}^{4}).$ Then, we can separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{20{n}^{5}} & = \\\\ \\sqrt{4{n}^{4}\\cdot 5n} & = \\\\ \\sqrt{(2{n}^{2})^{2}\\cdot 5n} & = \\\\ \\sqrt{(2{n}^{2})^{2}}\\cdot \\sqrt{5n} & = \\\\ |2{n}^{2}|\\cdot \\sqrt{5n} & = \\\\ |2|\\cdot |{n}^{2}|\\cdot \\sqrt{5n} & = \\\\ 2\\cdot |{n}^{2}|\\cdot \\sqrt{5n}\\end{aligned}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}2\\cdot |{n}^{2}|\\cdot \\sqrt{5n} & = \\\\ 2\\cdot {n}^{2}\\cdot \\sqrt{5n} & = \\\\ 2{n}^{2}\\sqrt{5n}.\\end{aligned}\n$$"} :step/id #uuid "9070e2ab-f493-5ae1-ae96-aa294b03d716"} {:db/id #edb/ref 17592186554727 :step/content {:db/id #edb/ref 17592186554586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac23f07-19eb-5a0a-91fe-2143e303a9c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{a}^{3}{b}^{4}\\sqrt{2a}" :db/id #edb/ref 17592186553890} {:answer/id #uuid "8a26477d-d557-5b83-8ec1-5e390a04ff66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{b}^{4}\\sqrt{2a}" :db/id #edb/ref 17592186554161} {:answer/id #uuid "c3fbfc23-489f-58fe-b8ff-e2ebc4569716" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{b}^{3}\\sqrt{2a}" :db/id #edb/ref 17592186554295} {:answer/id #uuid "cec1e7d9-d8c0-5441-9601-896e2db22b3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8a{b}^{4}\\sqrt{a}" :db/id #edb/ref 17592186554321} {:answer/id #uuid "e7e84788-8981-5728-a6a0-aba9de9a572d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{a}^{2}{b}^{4}\\sqrt{2}" :db/id #edb/ref 17592186554371}] :answer-field/correct {:db/id #edb/ref 17592186553890} :answer-field/id #uuid "aef36574-d26a-51ae-8adf-50d31d43f76c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554498}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "758c8bb2-c32e-5b6a-b65e-f02ce4ad0d8b" :question/math-academy-id "q-29342" :question/problem "Simplify $\\sqrt{32{a}^{7}{b}^{8}}$ given that $a\\ge 0.$" :question/worked-solution "We first write $32{a}^{7}{b}^{8}$ as the product $16{a}^{6}{b}^{8}\\cdot 2a$ which contains a perfect square $(16{a}^{6}{b}^{8}).$ Then, we separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{32{a}^{7}{b}^{8}} & = \\\\ \\sqrt{16{a}^{6}{b}^{8}\\cdot 2a} & = \\\\ \\sqrt{(4{a}^{3}{b}^{4})^{2}\\cdot 2a} & = \\\\ \\sqrt{(4{a}^{3}{b}^{4})^{2}}\\cdot \\sqrt{2a} & = \\\\ |4{a}^{3}{b}^{4}|\\cdot \\sqrt{2a} & = \\\\ |4|\\cdot |{a}^{3}|\\cdot |{b}^{4}|\\cdot \\sqrt{2a} & = \\\\ 4\\cdot |{a}^{3}|\\cdot |{b}^{4}|\\cdot \\sqrt{2a}\\end{aligned}\n$$\n\nA number raised to the power of four is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have that $|{b}^{4}|={b}^{4}$ and $|{a}^{3}|={a}^{3}.$ Therefore, our final answer is\n\n$$\n\\begin{aligned}4\\cdot |{a}^{3}|\\cdot |{b}^{4}|\\cdot \\sqrt{2a} & = \\\\ 4\\cdot {a}^{3}\\cdot {b}^{4}\\cdot \\sqrt{2a} & = \\\\ 4{a}^{3}{b}^{4}\\sqrt{2a}.\\end{aligned}\n$$"} :step/id #uuid "b80055f6-9aac-5f82-8760-3f10697f55c5" :step/next {:db/id #edb/ref 17592186554704}}] :activity/title "Simplifying Square Root Expressions Using the Product Rule" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186553842}]}
