#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186069800} :activity/id #uuid "180009fa-7306-5958-952a-a560c9c25ac0" :activity/scope {:db/id #edb/ref 17592186050496 :topic/id #uuid "4dc7f0d4-7695-5efd-99c0-299924cc9d4b" :topic/math-academy-id 389} :activity/steps [{:db/id #edb/ref 17592186069762 :step/content {:db/id #edb/ref 17592186068826 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068676 :question/id #uuid "ce2e3248-96e3-5d69-9a16-1a62e0ce0eeb" :question/math-academy-id "e-9980"} :knowledge-point/id #uuid "f2471751-7e5c-5823-9f63-76d14f927db2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049861}] :knowledge-point/questions [{:db/id #edb/ref 17592186069057} {:db/id #edb/ref 17592186069259} {:db/id #edb/ref 17592186233457} {:db/id #edb/ref 17592186501215} {:db/id #edb/ref 17592186501222}] :knowledge-point/title "Simplifying a Radical Expression That Is Not a Perfect Square With Larger Powers"} :step/id #uuid "3a8b2793-a5c0-588d-81b2-ae26ae1802aa" :step/math-academy-id 37585 :step/next {:db/id #edb/ref 17592186069801}} {:db/id #edb/ref 17592186069764 :step/content {:db/id #edb/ref 17592186068828 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068432 :question/id #uuid "a474788c-5b2b-570d-84bf-2c9575ac4f54" :question/math-academy-id "e-10022"} :knowledge-point/id #uuid "3674f343-59bc-5420-9dca-44102b11aba6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049843} {:db/id #edb/ref 17592186049923}] :knowledge-point/questions [{:db/id #edb/ref 17592186069056} {:db/id #edb/ref 17592186069206} {:db/id #edb/ref 17592186501139} {:db/id #edb/ref 17592186501216}] :knowledge-point/title "Simplifying a Radical Expression That Is Not a Perfect Square"} :step/id #uuid "444844cf-a75f-58b6-bbc1-b9439090e46c" :step/math-academy-id 37757 :step/next {:db/id #edb/ref 17592186069762}} {:db/id #edb/ref 17592186069800 :step/content {:db/id #edb/ref 17592186069943 :tutorial/content "The **product rule for radicals** states that the square root of a product equals the product of the square roots:\n\n$$\n\\eqalign{\n\t\t\\sqrt{ab} &=\\sqrt{a} \\cdot \\sqrt{b}\n\t}\n$$\n\nWe can use the product rule to rewrite the square roots of algebraic expressions.\n\nAs an example, let's suppose we want to simplify the following expression:\n\n$$\n\\sqrt{32y}\n$$\n\nFirst, we rewrite $32y$ as the product $16 \\cdot 2y,$ which contains a perfect square $(16){:}$ \n\n$$\n\\eqalign{\n\t\\sqrt{32y}&=\\[5pt]\n\t\\sqrt{16 \\cdot 2y}&=\\[5pt]\n\t\\sqrt{4^2 \\cdot 2y}&\n\n\t}\n$$\n\nThen, we separate the product into two separate radicals using the product rule:\n\n$$\n\\eqalign{\n        \\sqrt{4^2\\cdot 2y}&=\\[3pt]\n        \\sqrt{4^2}\\cdot \\sqrt{2y}&\n\t}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\eqalign{\n        \\sqrt{4^2}\\cdot \\sqrt{2y}&=\\[3pt]\n        |4|\\cdot \\sqrt{2y}&=\\[3pt]\n\n\t4\\sqrt{2y}&\n\t}\n$$" :tutorial/id #uuid "169256a7-1898-59b1-a7a9-f8cb8b713d51" :tutorial/math-academy-id 1606 :tutorial/title "Introduction"} :step/id #uuid "bfc154dc-32b4-5e94-a701-30a255009a40" :step/math-academy-id 4304 :step/next {:db/id #edb/ref 17592186069764}} {:db/id #edb/ref 17592186069801 :step/content {:db/id #edb/ref 17592186068852 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068469 :question/id #uuid "969be012-a830-564e-a355-00a4f1985ae8" :question/math-academy-id "e-1363"} :knowledge-point/id #uuid "4df00200-f680-53f3-9b49-700b9ac14204" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050890}] :knowledge-point/questions [{:db/id #edb/ref 17592186069224} {:db/id #edb/ref 17592186069225} {:db/id #edb/ref 17592186501143}] :knowledge-point/title "Simplifying a Radical Expression That Is Not a Perfect Square With Domain Restrictions"} :step/id #uuid "16267a67-a93b-562b-88e6-0963346b1bfb" :step/math-academy-id 4311}] :activity/title "Simplifying Square Root Expressions Using the Product Rule" :activity/type {:db/id #