d" :step/next {:db/id #edb/ref 17592186534154}} {:db/id #edb/ref 17592186534154 :step/content {:db/id #edb/ref 17592186534043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39a10731-5fc5-5806-9d35-87c5df736739" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "49" :db/id #edb/ref 17592186533273} {:answer/id #uuid "3e32be5a-ab1f-58fc-8cd8-39d0fdebf2af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "343" :db/id #edb/ref 17592186533283} {:answer/id #uuid "6b798186-aa8c-5b3b-91a6-72f60d4af904" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186533390} {:answer/id #uuid "8346c2e4-3159-519a-933c-ed33451c4b6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186533448} {:answer/id #uuid "9b467886-d4bd-53f1-975f-d7a82a45d740" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-343" :db/id #edb/ref 17592186533516}] :answer-field/correct {:db/id #edb/ref 17592186533516} :answer-field/id #uuid "69802b94-6643-58fc-ad81-08af38307602" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533864}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a6550081-06ce-5fdd-8f86-5cb7f9262731" :question/math-academy-id "q-71502" :question/problem "$(\\sqrt[3]{-343})^{3}=$" :question/worked-solution "The cube and the cube root cancel each other out. So, we have\n\n$$\n(\\sqrt[3]{-343})^{3}=-343.\n$$"} :step/id #uuid "e9d03a39-8b21-5275-aa96-f0cc96d800f3"}] :activity/title "The Cube Root of a Perfect Cube" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186533123}]}
