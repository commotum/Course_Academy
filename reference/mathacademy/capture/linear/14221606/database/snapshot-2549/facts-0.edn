17592186534026 #edb/ref 1072 #uuid "7fc0fee8-5d8f-576c-8b1d-3594d43c9abb" #edb/ref 17592186045417] [17592186534026 #edb/ref 1074 "First, notice that the numbers $125$ and $64$ are both perfect cubes. \n\nSo, to determine the value of $\\sqrt[3]{\\frac{125}{64}},$ we express $\\frac{125}{64}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{125}{64}} & = \\\\ \\sqrt[3]{\\frac{{5}^{3}}{{4}^{3}}} & = \\\\ \\sqrt[3]{\\frac{5\\cdot 5\\cdot 5}{4\\cdot 4\\cdot 4}} & = \\\\ \\sqrt[3]{\\frac{5}{4}\\cdot \\frac{5}{4}\\cdot \\frac{5}{4}} & = \\\\ \\sqrt[3]{{(\\frac{5}{4})}^{3}} & = \\\\ \\frac{5}{4} & \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186534043 #edb/ref 1068 #edb/ref 17592186533864 #edb/ref 17592186045417] [17592186534043 #edb/ref 1069 "q-71502" #edb/ref 17592186045417] [17592186534043 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186534043 #edb/ref 1071 "$(\\sqrt[3]{-343})^{3}=$" #edb/ref 17592186045417] [17592186534043 #edb/ref 1072 #uuid "a6550081-06ce-5fdd-8f86-5cb7f9262731" #edb/ref 17592186045417] [17592186534043 #edb/ref 1074 "The cube and the cube root cancel each other out. So, we have\n\n$$\n(\\sqrt[3]{-343})^{3}=-343.\n$$" #edb/ref 17592186045417] [17592186534108 #edb/ref 1058 #edb/ref 17592186534129 #edb/ref 17592186045417] [17592186534108 #edb/ref 1062 #uuid "1e5d4b1f-71f8-513d-8ca3-3ea352241efb" #edb/ref 17592186045417] [17592186534108 #edb/ref 1063 #edb/ref 17592186120249 #edb/ref 17592186045417] [17592186534129 #edb/ref 1058 #edb/ref 17592186534154 #edb/ref 17592186045417] [17592186534129 #edb/ref 1062 #uuid "646a95eb-3d50-5de4-b371-82aed596236d" #edb/ref 17592186045417] [17592186534129 #edb/ref 1063 #edb/ref 17592186534026 #edb/ref 17592186045417] [17592186534154 #edb/ref 1062 #uuid "e9d03a39-8b21-5275-aa96-f0cc96d800f3" #edb/ref 17592186045417] [17592186534154 #edb/ref 1063 #edb/ref 17592186534043 #edb/ref 17592186045417]}
