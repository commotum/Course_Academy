#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186180636} :activity/id #uuid "d591686e-75aa-506f-aade-856d6dea793a" :activity/scope {:db/id #edb/ref 17592186049495 :topic/id #uuid "f9324acf-7bff-528d-bb24-b67ba475ce6a" :topic/math-academy-id 3746} :activity/steps [{:db/id #edb/ref 17592186180636 :step/content {:db/id #edb/ref 17592186180660 :tutorial/content "Sometimes, we can use ratios to find quantities that aren't explicitly given in the ratio.\n\nFor instance, suppose that the ratio of boys to girls in the fifth grade is $3: 4.$ If there are $15$ boys, how many students are there in total?\n\nNotice that the \"total number of students\" doesn't appear in the ratio. However, we can find the number of students by adding the total number of boys and the number of girls.\n\nWe start with the ratio ${\\color{blue}3}:{\\color{red}4}$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}3}}{{\\color{red}4}}\n$$\n\nIn this fraction, the numerator represents the number of boys and the denominator represents the number of girls.\n\nWe know that there are $15$ boys, so we want to make a numerator of $15.$ We can do this by multiplying the numerator and denominator by $5\\mathbin{:}$\n\n$$\n\\dfrac{{\\color{blue}3}\\times 5}{{\\color{red}4}\\times 5} = \\dfrac{{\\color{blue}15}}{{\\color{red}20}}\n$$\n\nTherefore, since there are $15$ boys in the fifth grade, there must also be $20$ girls. So the total number of students is \n\n$$\n{\\color{blue}15} + {\\color{red}20} = 35\\,.\n$$" :tutorial/id #uuid "ca3cabae-8ebe-5879-b608-9d0ebdb233fb" :tutorial/math-academy-id 2051 :tutorial/title "Introduction"} :step/id #uuid "a4a7f682-c223-50f1-a3eb-6b1f79aad9b0" :step/math-academy-id 637169 :step/next {:db/id #edb/ref 17592186180637}} {:db/id #edb/ref 17592186180637 :step/content {:db/id #edb/ref 17592186179817 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179494 :question/id #uuid "02ae40ba-a02c-5025-9597-1968322f2421" :question/math-academy-id "e-2279"} :knowledge-point/id #uuid "0e44aa33-0aca-5cb2-8c89-6391240beed8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050174}] :knowledge-point/questions [{:db/id #edb/ref 17592186180232} {:db/id #edb/ref 17592186180234} {:db/id #edb/ref 17592186275168} {:db/id #edb/ref 17592186275170} {:db/id #edb/ref 17592186332959} {:db/id #edb/ref 17592186332960} {:db/id #edb/ref 17592186504610} {:db/id #edb/ref 17592186504645} {:db/id #edb/ref 17592186516820}] :knowledge-point/title "Calculating an Amount Given a Ratio"} :step/id #uuid "91f76525-9d6e-5ea9-a6a3-b6249f246583" :step/math-academy-id 637170 :step/next {:db/id #edb/ref 17592186180638}} {:db/id #edb/ref 17592186180638 :step/content {:db/id #edb/ref 17592186179818 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179495 :question/id #uuid "4aeb615e-16a1-5170-be5e-fe0f63a5d895" :question/math-academy-id "e-2280"} :knowledge-point/id #uuid "b5406de3-483e-56c2-b9c6-73de6769552e" :knowledge-point/questions [{:db/id #edb/ref 17592186180233} {:db/id #edb/ref 17592186180235} {:db/id #edb/ref 17592186275169} {:db/id #edb/ref 17592186275171} {:db/id #edb/ref 17592186275172} {:db/id #edb/ref 17592186357529} {:db/id #edb/ref 17592186504652} {:db/id #edb/ref 17592186516845}] :knowledge-point/title "Calculating an Amount Given a Ratio as a Fraction"} :step/id #uuid "5f14a9d9-61a5-5432-ad78-2673e2e5e50e" :step/math-academy-id 637173}] :activity/title "Further Reasoning With Equivalent Ratios" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179889}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186516890} :activity/id #uuid "23866e55-455f-5349-a24f-744eddf74337" :activity/scope {:db/id #edb/ref 17592186049495 :topic/id #uuid "f9324acf-7bff-528d-bb24-b67ba475ce6a" :topic/math-academy-id 3746} :activity/steps [{:db/id #edb/ref 17592186516890 :step/content {:db/id #edb/ref 17592186180233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19618e12-debd-5b4e-9bf1-429e65d1a0bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186330167} {:answer/id #uuid "5a4d2098-760f-5acc-84b4-40651c95e415" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186330758} {:answer/id #uuid "5bdcbebb-943f-5a2c-92b4-c3828824f1a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186330771} {:answer/id #uuid "7d4abe4a-1493-5b17-9061-c2a59e27d5ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186331053} {:answer/id #uuid "fdf4ef6e-5e9b-5fbd-8000-7085f8f93e23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186332185}] :answer-field/correct {:db/id #edb/ref 17592186331053} :answer-field/id #uuid "cecfd35c-e905-59a9-a911-bac01e2f48fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186332560}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9aff327a-3ab5-5bdb-b2ab-437fac7b7394" :question/math-academy-id "q-59895" :question/problem "There are $15$ students in a class, and $\\frac{2}{5}$ of them wear glasses. How many students **do not** wear glasses?" :question/worked-solution "We are given that the ratio of students who wear glasses to the total number of students is $\\frac{2}{5}.$ \n\nIn this fraction, the numerator represents the number of students who wear glasses, and the denominator represents the total number of students.\n\nWe can make a denominator of $15$ by multiplying the numerator and denominator by $3:$\n\n$$\n\\frac{2\\times 3}{5\\times 3}=\\frac{6}{15}\n$$\n\nTherefore, there are $6$ students who wear glasses. \n\nSo the number of students who don't wear glasses is\n\n$$\n15-6=9.\n$$"} :step/id #uuid "351d27f8-ae58-54cf-867a-22cc22f2bf67" :step/next {:db/id #edb/ref 17592186516985}} {:db/id #edb/ref 17592186516960 :step/content {:db/id #edb/ref 17592186516820 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29fbf3dc-a47e-54b1-bcf8-7e68c453ce58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186516198} {:answer/id #uuid "33b33412-cf90-51cd-bf23-bd54dfd122f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186516220} {:answer/id #uuid "635a14ed-c473-5b21-9e9c-024325325da0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "35" :db/id #edb/ref 17592186516327} {:answer/id #uuid "d4530301-1e8c-5fda-aec9-3766286b1b3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "45" :db/id #edb/ref 17592186516559} {:answer/id #uuid "eddc115b-1150-555f-bd2f-52f8639641ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186516604}] :answer-field/correct {:db/id #edb/ref 17592186516604} :answer-field/id #uuid "d304b13f-6fc1-5cd7-bca3-7aa0d027956e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516747}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7dd5c31e-e5f0-51dc-a3ec-12e73e8808ee" :question/math-academy-id "q-147064" :question/problem "The ratio of sheep to goats in Manuel's herd is $3:1.$\nIf Manuel has $30$ sheep, how many animals are in the herd in total?" :question/worked-solution "We start with the ratio $3:1$ and write it as a fraction:\n\n$$\n\\frac{3}{1}\n$$\n\nIn this fraction, the numerator represents the number of sheep, and the denominator represents the number of goats.\n\nWe can make a numerator of $30$ by multiplying the numerator and denominator by $10:$\n\n$$\n\\frac{3\\times 10}{1\\times 10}=\\frac{30}{10}\n$$\n\nTherefore, Manuel has $30$ sheep and $10$ goats. So, the total number of animals in the herd is \n\n$$\n30+10=40.\n$$"} :step/id #uuid "c440cbf8-556c-5d78-8335-881bde443fbb"} {:db/id #edb/ref 17592186516985 :step/content {:db/id #edb/ref 17592186516845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f71bb97-ece8-546e-a7a7-8359437ebda2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186516320} {:answer/id #uuid "701eba46-6034-5191-b8c0-f4010b286be4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186516363} {:answer/id #uuid "70b5c337-134d-5b23-8234-a694bfeab0ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186516365} {:answer/id #uuid "bff2951a-541e-5f2c-b035-f5b17ef671ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186516519} {:answer/id #uuid "dc72bee6-483f-5536-ad4b-5f542ab698ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186516577}] :answer-field/correct {:db/id #edb/ref 17592186516365} :answer-field/id #uuid "c50e1709-fb35-5c84-a6d5-30b4b5bd93b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516741}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bea17d69-eb40-57fe-baa2-90eb85105abf" :question/math-academy-id "q-60197" :question/problem "In an electronics store, the ratio of the number of cell phones to the total number of gadgets sold (cell phones and computers) is $\\frac{8}{11}.$ If $16$ cell phones were sold in a week, how many computers were sold?" :question/worked-solution "We are given that the ratio of the number of cell phones sold to the number of gadgets (cell phones and computers) sold is $\\frac{8}{11}.$\n\nIn this fraction, the numerator represents the number of cell phones sold and the denominator represents the number of cell phones and computers sold.\n\nWe can make a numerator of $16$ by multiplying the numerator and denominator by $2:$\n\n$$\n\\frac{8\\times 2}{11\\times 2}=\\frac{16}{22}\n$$\n\nTherefore, the number of cell phones and computers sold that week was $22.$ Of this amount, the number of computers sold was\n\n$$\n22-16=6.\n$$"} :step/id #uuid "fe452996-f813-52b6-bce9-784c946d6846" :step/next {:db/id #edb/ref 17592186516960}}] :activity/title "Further Reasoning With Equivalent Ratios" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516089}]}
