#{[{:db/id #edb/ref 17592186147290 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186147611 :knowledge-point/id #uuid "e8fd3c2c-3340-50df-a95c-3b82f165a071" :knowledge-point/title "Naming Prisms"}] :question/id #uuid "319d252c-a8c4-5a5f-ad2b-f4bdb5702b75" :question/math-academy-id "e-2662" :question/problem "What is the name of the polyhedron shown below?\n\n![](images/b6/b6b4021c8add7d92bfbc98c23f9c9e56e4fd0c8fa152e60c04ca78c5c5b594cd.png)" :question/worked-solution "The polyhedron is a **heptagonal prism** since it has two identical heptagonal faces connected by equal parallel line segments.\n\nAlso, notice that:\n\n- The solid is not an octagonal (pentagonal or hexagonal) prism since it does not have an octagonal (pentagonal or hexagonal) base.\n- The solid is not a cube since not all of its faces are squares."}] [{:db/id #edb/ref 17592186147291 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186147612 :knowledge-point/id #uuid "b9d83422-a877-5de8-bc55-2c7aae9eeb72" :knowledge-point/title "Identifying Non-Polyhedra"}] :question/id #uuid "0583c82a-049c-51e6-aebc-bcd32423824e" :question/math-academy-id "e-2668" :question/problem "Which of the following is **not** a polyhedron?\n\n![](images/ce/ceedc03f96a3c801f31069f5551a8c0e5241dbabfc5c9463240a1eb1698a7105.png)" :question/worked-solution "Each face in a polyhedron must be a polygon. Therefore, the only option that is **not** a polyhedron is:\n\n![](images/ae/aea63ad8ff248347de606d37112355cdecc30ab5ae631b987b87f0b9f9d68f17.png)\n\nNotice that one of its faces is not a polygon (it has curved sides)."}] [{:db/id #edb/ref 17592186147294 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186147615 :knowledge-point/id #uuid "ddd0beef-ff0c-5ef3-88c4-ce49fbb8d5cb" :knowledge-point/title "Naming Pyramids"}] :question/id #uuid "dc558592-e65f-5369-890d-fffc633f2a3b" :question/math-academy-id "e-2757" :question/problem "![](images/be/beed0799de4f42cde58bf0c85f31a1a6850ef1227ea2827e9819a4edeb3ede4a.png)\n\nWhat is the name of the polyhedron shown above?\n\n1. Hexagonal prism\n2. Hexagonal pyramid\n3. Rectangular prism" :question/worked-solution "The solid is a **hexagonal pyramid** since its base is a hexagon and all other $6$ faces meet at a single point\n\nAlso, notice that:\n\n- The solid is not a hexagonal prism since it doesn't have two identical hexagonal faces connected by equal parallel lines.\n- The solid is not a rectangular prism since not all of its faces are rectangles."}] [{:db/id #edb/ref 17592186147392 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186147455 :knowledge-point/id #uuid "f4196423-3401-54e1-b214-9dbc4861cfe1" :knowledge-point/title "Identifying Spheres, Hemispheres, Cones, and Cylinders"}] :question/id #uuid "4447e034-350f-5e6b-a501-0f57a3888bd0" :question/math-academy-id "e-8975" :question/problem "What is the name of the solid shown below?\n\n![](images/43/4397eb1e78f99d0f6cda1515a4aef23d1a9e44235623c086f5ae849b4863fb45.png)" :question/worked-solution "The solid is a **right cone**.\n\nNotice the following:\n\n- The solid has one circular base and one vertex. So, it's a cone.\n- The axis that passes through the center of the circle and the vertex is perpendicular to the base. So, it's right."}] [{:db/id #edb/ref 17592186147727 :knowledge-point/_questions [{:db/id #edb/ref 17592186147455 :knowledge-point/id #uuid "f4196423-3401-54e1-b214-9dbc4861cfe1" :knowledge-point/title "Identifying Spheres, Hemispheres, Cones, and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "986b13bc-7e25-52d7-a880-61a4b157a022" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Hemisphere" :db/id #edb/ref 17592186144126} {:answer/id #uuid "a31a0f67-370a-50da-ab8c-90e9b1a9aa95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Oblique cylinder" :db/id #edb/ref 17592186144127} {:answer/id #uuid "b166d1f4-df7d-585d-b0ed-62388f70e458" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Right cone" :db/id #edb/ref 17592186144128} {:answer/id #uuid "d1a19fa9-3e15-5ce4-93d9-4e0f8d69d1e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Right cylinder" :db/id #edb/ref 17592186144129} {:answer/id #uuid "50bd2f42-3593-5db4-9f60-a157a9a0eebc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Oblique cone" :db/id #edb/ref 17592186144130}] :answer-field/id #uuid "f673e2c8-2e2e-567f-b360-49b31d20a59b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186144125}] :question/id #uuid "4ee4b958-bafa-5f08-8ddd-9a92364a8e0d" :question/math-academy-id "q-107175" :question/problem "![](images/9a/9a918919ef71c8e29b51d008fb5aa2720dbecbecc14830789b1f55fb259d47a5.png)\n\nWhat is the name of the solid shown above?"}] [{:db/id #edb/ref 17592186147891 :knowledge-point/_questions [{:db/id #edb/ref 17592186147611 :knowledge-point/id #uuid "e8fd3c2c-3340-50df-a95c-3b82f165a071" :knowledge-point/title "Naming Prisms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c44d4c7b-db24-5621-9224-b5575e177073" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Triangular prism" :db/id #edb/ref 17592186145101} {:answer/id #uuid "d37d5306-ec2e-5f29-bebd-360351dd3df4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Rectangular prism" :db/id #edb/ref 17592186145102} {:answer/id #uuid "ec1ccccc-e904-5b54-8765-1023354ac99f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Cube" :db/id #edb/ref 17592186145103} {:answer/id #uuid "f4931c36-2703-5372-80b6-94ae4f3be720" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Hexagonal prism" :db/id #edb/ref 17592186145104} {