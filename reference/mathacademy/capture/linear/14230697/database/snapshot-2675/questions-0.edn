knowledge-point/_questions [{:db/id #edb/ref 17592186147615 :knowledge-point/id #uuid "ddd0beef-ff0c-5ef3-88c4-ce49fbb8d5cb" :knowledge-point/title "Naming Pyramids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1852fd6c-1599-5811-a563-a92f67931581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Triangular pyramid" :db/id #edb/ref 17592186552909} {:answer/id #uuid "26b08f80-9cfa-5b25-bc8d-851e83975bb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Rectangular pyramid" :db/id #edb/ref 17592186552936} {:answer/id #uuid "3d5f18e5-7640-5be2-abd6-035520eda7e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Rectangular prism" :db/id #edb/ref 17592186552991} {:answer/id #uuid "639168a2-06ab-5640-ace4-2d4b667aaee9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Hexagonal pyramid" :db/id #edb/ref 17592186553082} {:answer/id #uuid "84065c86-6a7f-5133-88ea-2220ca5be17a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Hexagonal prism" :db/id #edb/ref 17592186553134}] :answer-field/correct {:answer/id #uuid "639168a2-06ab-5640-ace4-2d4b667aaee9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Hexagonal pyramid" :db/id #edb/ref 17592186553082} :answer-field/id #uuid "a97ab0d9-e503-5570-a4f3-0853a9b06c6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553456}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d5776870-d936-568a-a9d6-0ec5e35815ef" :question/math-academy-id "q-69864" :question/problem "![](images/81/8144eea23c9f47796eb414502c73044582a3c417abd44684bc4a5cd12d56cfcc.png)\n\nWhat is the name of the polyhedron shown above?" :question/worked-solution "The polyhedron is a **hexagonal pyramid** since it is a pyramid whose base is a hexagon.  \n\nAlso, notice that:\n\n- The solid is not a rectangular pyramid because it does not have a rectangle as its base.\n\n- The solid is not a triangular pyramid because not all of its faces are triangles.\n\n- The solid is not a hexagonal prism since it has only one hexagonal face.\n\n- The solid is not a rectangular prism since not all of its faces are rectangles."}] [{:db/id #edb/ref 17592186553541 :knowledge-point/_questions [{:db/id #edb/ref 17592186147615 :knowledge-point/id #uuid "ddd0beef-ff0c-5ef3-88c4-ce49fbb8d5cb" :knowledge-point/title "Naming Pyramids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "240a84fc-5e49-5666-9e47-92d9e5ca7720" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Hexagonal pyramid" :db/id #edb/ref 17592186552933} {:answer/id #uuid "37d49e79-adee-5d48-9f3c-54a923fdadac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Heptagonal prism" :db/id #edb/ref 17592186552979} {:answer/id #uuid "8a9580ff-5149-5172-8c90-ad5914bd3fc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Cube" :db/id #edb/ref 17592186553148} {:answer/id #uuid "f3c5fa83-39dd-5069-84f7-e554e4a0624c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Rectangular prism" :db/id #edb/ref 17592186553347} {:answer/id #uuid "fe4abc1a-5fd5-54fe-8b11-a2c8da5fd9b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Heptagonal pyramid" :db/id #edb/ref 17592186553371}] :answer-field/correct {:answer/id #uuid "fe4abc1a-5fd5-54fe-8b11-a2c8da5fd9b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Heptagonal pyramid" :db/id #edb/ref 17592186553371} :answer-field/id #uuid "9c511c8e-ae32-5826-89f3-c8b44c59f5ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553451}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e00fa35-b4fc-5e3e-94db-29044e83ec94" :question/math-academy-id "q-93196" :question/problem "![](images/90/90bdf56a0c09a2db4fae7b19d3625360c4fc148b8807cc3e8a8ba35d1bdf78bb.png)\n\nWhat is the name of the polyhedron shown above?" :question/worked-solution "The solid is a **heptagonal pyramid** since it is a pyramid whose base is a heptagon.\n\nAlso, notice that:\n\n- The solid is not a heptagonal prism since it has only one heptagonal face.\n\n- The solid is not a hexagonal pyramid since it has no hexagonal face.\n\n- The solid is not a rectangular prism since not all of its faces are rectangles. Due to the same reasons, the solid is not a cube."}] [{:db/id #edb/ref 17592186553581 :knowledge-point/_questions [{:db/id #edb/ref 17592186147612 :knowledge-point/id #uuid "b9d83422-a877-5de8-bc55-2c7aae9eeb72" :knowledge-point/title "Identifying Non-Polyhedra"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22e1f78b-0771-595e-b5bb-efe703b032f9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4e/4e0550f18e27ad9326b5606f23b502ff6879d2149f5bac5e2fcc829506748f0b.png" :db/id #edb/ref 17592186552931} {:answer/id #uuid "289cc259-a1fd-5e09-bdf8-c6632abb135a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/93/931007418b0e7f9af99bb34831fbd50119ab5d0468e0039405bb84cb33fbe9fe.png" :db/id #edb/ref 17592186552940} {:answer/id #uuid "3ef3ff53-5943-5089-89d1-279891d7d7c8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2e/2ef8e272dc3a650b83322a1b8f80d2691a3ac7406738e957daf819cb7317d926.png" :db/id #edb/ref 17592186552995} {:answer/id #uuid "41cdce87-367f-5a43-a332-a54e98990a24" :answer/type {