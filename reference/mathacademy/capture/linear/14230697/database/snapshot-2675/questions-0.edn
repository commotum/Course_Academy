swer.type/image} :answer/value "images/1a/1a04515db528b35af4da3e164522ff54458cba3dee0562e361388860890aa7a7.png" :db/id #edb/ref 17592186553247} :answer-field/id #uuid "4a24d8be-b6f4-5a86-9f10-12282c04ffec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553411}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8ad29a00-337d-58d4-9a53-85c6c404f218" :question/math-academy-id "q-117720" :question/problem "Which of the following is a polyhedron?" :question/worked-solution "Each face in a polyhedron must be a polygon. Therefore, the only option that is a polyhedron is:\n\n![](images/1a/1a04515db528b35af4da3e164522ff54458cba3dee0562e361388860890aa7a7.png)\n\nNotice that all other shapes have at least one face which is not a polygon."}] [{:db/id #edb/ref 17592186147891 :knowledge-point/_questions [{:db/id #edb/ref 17592186147611 :knowledge-point/id #uuid "e8fd3c2c-3340-50df-a95c-3b82f165a071" :knowledge-point/title "Naming Prisms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c44d4c7b-db24-5621-9224-b5575e177073" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Triangular prism" :db/id #edb/ref 17592186145101} {:answer/id #uuid "d37d5306-ec2e-5f29-bebd-360351dd3df4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Rectangular prism" :db/id #edb/ref 17592186145102} {:answer/id #uuid "ec1ccccc-e904-5b54-8765-1023354ac99f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Cube" :db/id #edb/ref 17592186145103} {:answer/id #uuid "f4931c36-2703-5372-80b6-94ae4f3be720" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Hexagonal prism" :db/id #edb/ref 17592186145104} {:answer/id #uuid "075e9492-616f-5d3b-bfc3-6fa9c9eae913" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Pentagonal prism" :db/id #edb/ref 17592186145105}] :answer-field/correct {:answer/id #uuid "d37d5306-ec2e-5f29-bebd-360351dd3df4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Rectangular prism" :db/id #edb/ref 17592186145102} :answer-field/id #uuid "7f02fe03-c7e1-5e27-934e-5a7e3b68a461" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186145100}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1cbf6ca2-7cba-59ce-97fd-e3a452054a0a" :question/math-academy-id "q-61545" :question/problem "![](images/78/78af384db9beb590c4f4e3d062a77eb22738b7d75ed26be7207686d8a213e6b5.png)\n\nWhat is the name of the polyhedron shown above?" :question/worked-solution "The solid is a **rectangular prism** since all its faces are rectangles.\n\nAlso, notice that:\n\n- The solid is not a triangular (pentagonal or hexagonal) prism since it does not have a triangular (pentagonal or hexagonal) base.\n\n- The solid is not a cube since its faces are not squares."}] [{:db/id #edb/ref 17592186553567 :knowledge-point/_questions [{:db/id #edb/ref 17592186147611 :knowledge-point/id #uuid "e8fd3c2c-3340-50df-a95c-3b82f165a071" :knowledge-point/title "Naming Prisms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11b5cda0-8df3-5aff-a584-01d2bfa412ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Rectangular pyramid" :db/id #edb/ref 17592186552898} {:answer/id #uuid "5a869980-6012-5244-841a-4a65c259a4a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Cube" :db/id #edb/ref 17592186553063} {:answer/id #uuid "a774c8a8-cf5b-5175-865d-5be90b270abd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Triangular prism" :db/id #edb/ref 17592186553202} {:answer/id #uuid "d384c22d-d602-57db-943e-0615fbe06585" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Pyramid" :db/id #edb/ref 17592186553290} {:answer/id #uuid "e6965e4d-509f-5c69-a4b7-1d491736baf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Triangular pyramid" :db/id #edb/ref 17592186553327}] :answer-field/correct {:answer/id #uuid "5a869980-6012-5244-841a-4a65c259a4a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Cube" :db/id #edb/ref 17592186553063} :answer-field/id #uuid "61f696f8-268a-5b8a-9f94-89ea6bbbe502" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553420}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9f71f42-cce6-5b97-9247-c6bd081ec3db" :question/math-academy-id "q-61643" :question/problem "![](images/71/71c7fda05aab2b4d91df47361b0bbf58f3e65d383a7c4af4e05d27d3e7ea9147.png)\n\nWhat is the name of the polyhedron shown above?" :question/worked-solution "The polyhedron is a **cube** since all its faces are squares.\n\nAlso, notice that:\n\n- The solid is not a pyramid since a pyramid must have triangular faces (except, possibly, for the base).\n\n- The solid is not a triangular prism because it does not have two triangular bases connected by parallel lines."}] [{:db/id #edb/ref 17592186553558 :knowledge-point/_questions [{:db/id #edb/ref 17592186147611 :knowledge-point/id #uuid "e8fd3c2c-3340-50df-a95c-3b82f165a071" :knowledge-point/title "Naming Prisms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bcd57cb-5a6c-5fb7-958b-036b8957aafc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Pentagonal prism" :db/id #edb/ref 17592186552917} {:answer/id #uuid "4a094c6f-f5ca-5e0d