45417] [17592186554507 #edb/ref 1075 #edb/ref 17592186554397 #edb/ref 17592186045417] [17592186554507 #edb/ref 1075 #edb/ref 17592186554409 #edb/ref 17592186045417] [17592186554507 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186554507 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186554507 #edb/ref 1078 #edb/ref 17592186554409 #edb/ref 17592186045417] [17592186554507 #edb/ref 1079 #uuid "bdd707aa-f658-5dc0-88e8-2cc1aff0bd8c" #edb/ref 17592186045417] [17592186554534 #edb/ref 1075 #edb/ref 17592186553933 #edb/ref 17592186045417] [17592186554534 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186554534 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186554534 #edb/ref 1078 #edb/ref 17592186553933 #edb/ref 17592186045417] [17592186554534 #edb/ref 1079 #uuid "f78565af-1ce0-5d78-bd24-bee276b6e56e" #edb/ref 17592186045417] [17592186554562 #edb/ref 1068 #edb/ref 17592186554506 #edb/ref 17592186045417] [17592186554562 #edb/ref 1069 "q-67512" #edb/ref 17592186045417] [17592186554562 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186554562 #edb/ref 1071 "Find the equation for the common ratio $r$ of the geometric sequence whose $4$th term is $27$ and whose $11$th term is $-\\frac{1}{81}.$" #edb/ref 17592186045417] [17592186554562 #edb/ref 1072 #uuid "3805f218-eb22-5e05-bae4-085089844c85" #edb/ref 17592186045417] [17592186554562 #edb/ref 1074 "The formula for the $n$th term of a geometric sequence is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}.\n$$\n\nApplying this formula with $n=11$ and $n=4,$ respectively, we have\n\n$$\n\\begin{aligned}{a}_{4} & ={a}_{1}{r}^{4-1}={a}_{1}{r}^{3}, \\\\ {a}_{11} & ={a}_{1}{r}^{11-1}={a}_{1}{r}^{10}.\\end{aligned}\n$$\n\nGiven that ${a}_{4}=27$ and ${a}_{11}=-\\frac{1}{81},$ we obtain the following system of equations:\n\n$$\n\\{\\begin{aligned}{a}_{1}{r}^{3}=27 \\\\ {a}_{1}{r}^{10}=-\\frac{1}{81}\\end{aligned}\n$$\n\nFinally, by dividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{{a}_{1}{r}^{10}}{{a}_{1}{r}^{3}} & =\\frac{(-\\frac{1}{81})}{27} \\\\ \\frac{\\cancel{\\,{a}_{1}\\,}{r}^{10}}{\\cancel{\\,{a}_{1}\\,}{r}^{3}} & =\\frac{(-\\frac{1}{81})}{27} \\\\ \\frac{{r}^{10}}{{r}^{3}} & =-\\frac{1}{2\\,187} \\\\ {r}^{7} & =-\\frac{1}{2\\,187}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186554575 #edb/ref 1068 #edb/ref 17592186554534 #edb/ref 17592186045417] [17592186554575 #edb/ref 1069 "q-250943" #edb/ref 17592186045417] [17592186554575 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186554575 #edb/ref 1071 "Find the common ratio $r$ of the geometric sequence whose tenth term is $-8$ and whose twelfth term is $-72.$ You're given that the common ratio is negative.\n\n$r=${{field-1}}" #edb/ref 17592186045417] [17592186554575 #edb/ref 1072 #uuid "5abf554f-7e7b-567c-9a3f-c62e189188a5" #edb/ref 17592186045417] [17592186554575 #edb/ref 1074 "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{12}=-72$ and ${a}_{10}=-8.$ Substituting $n=12$ and $m=10$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{12-10} & =\\frac{{a}_{12}}{{a}_{10}} \\\\ {r}^{2} & =\\frac{(-72)}{(-8)} \\\\ {r}^{2} & =9.\\end{aligned}\n$$\n\nFinally, solving the equation for $r$ and considering that $r$ is negative, we get\n\n$$\n\\begin{aligned}{r}^{2} & =9 \\\\ {r}^{2} & =(-3)^{2} \\\\ r & =-3.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186554588 #edb/ref 1068 #edb/ref 17592186554445 #edb/ref 17592186045417] [17592186554588 #edb/ref 1069 "q-64032" #edb/ref 17592186045417] [17592186554588 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186554588 #edb/ref 1071 "Find the common ratio of the geometric sequence whose second term is $48$ and whose fifth term is $6.$" #edb/ref 17592186045417] [17592186554588 #edb/ref 1072 #uuid "7794f339-0fd4-50d9-a0ab-1ce4d82318cb" #edb/ref 17592186045417] [17592186554588 #edb/ref 1074 "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{5}=6$ and ${a}_{2}=48.$ Substituting $n=5$ and $m=2$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{5-2} & =\\frac{{a}_{5}}{{a}_{2}} \\\\ {r}^{3} & =\\frac{6}{48} \\\\ {r}^{3} & =\\frac{1}{8}.\\end{aligned}\n$$\n\nFinally, by solving the equation for $r,$ we get\n\n$$\n\\begin{aligned}{r}^{3} & =\\frac{1}{8} \\\\ {r}^{3} & ={(\\frac{1}{2})}^{3} \\\\ r & =\\frac{1}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186554612 #edb/ref 1068 #edb/ref 17592186554507 #edb/ref 17592186045417] [17592186554612 #edb/ref 1069 "q-64033" #edb/ref 17592186045417] [17592186554612 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186554612 #edb/ref 1071 "Find the common ratio of the geometric sequence whose fourth term is $135$ and whose seventh term is $5.$" #edb/ref 17592186045417] [17592186554612 #edb/ref 1072 #uuid "a5c77383-51aa-56e3-a7b4-492c5c358798" #edb/ref 17592186045417] [17592186554612 #edb/ref 1074 "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula \n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{7}=5$ and ${a}_{4}=135.$ Substituting $n=7$ and $m=4$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{7-4} & =\\frac{{a}_{7}}{{a}_{4}} \\\\ {r}^{3} & =\\frac{5}{135} \\\\ {r}^{3} & =\\frac{1}{27}.\\end{aligned}\n$$\n\nFinally, by solving the equation for $r,$ we get\n\n$$\n\\begin{aligned}{r}^{3} & =\\frac{1}{27} \\\\ {r}^{3} & ={(\\frac{1}{3})}^{3} \\\\ r & =\\frac{1}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186554621 #edb/ref 1068 #edb/ref 17592186554428 #edb/ref 17592186045417] [17592186554621 #edb/ref 1069 "q-67513" #edb/ref 17592186045417] [17592186554621 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186554621 #edb/ref 1071 "Find the equation for the common ratio $r$ of the geometric sequence whose $3$rd term is $4$ and whose $5$th term is $196.$" #edb/ref 17592186045417] [17592186554621 #edb/ref 1072 #uuid "c8e2a0b2-6f85-51c0-a653-f0669492c9a0" #edb/ref 17592186045417] [17592186554621 #edb/ref 1074 "The formula for the $n$th term of a geometric sequence is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}.\n$$\n\nApplying this formula with $n=5$ and $n=3,$ respectively, we have\n\n$$\n\\begin{aligned}{a}_{3} & ={a}_{1}{r}^{3-1}={a}_{1}{r}^{2}, \\\\ {a}_{5} & ={a}_{1}{r}^{5-1}={a}_{1}{r}^{4}.\\end{aligned}\n$$\n\nGiven that ${a}_{3}=4$ and ${a}_{5}=196,$ we obtain the following system of equations:\n\n$$\n\\{\\begin{aligned}{a}_{1}{r}^{2}=4 \\\\ {a}_{1}{r}^{4}=196\\end{aligned}\n$$\n\nFinally, by dividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{{a}_{1}{r}^{4}}{{a}_{1}{r}^{2}} & =\\frac{196}{4} \\\\ \\frac{\\cancel{\\,{a}_{1}\\,}{r}^{4}}{\\cancel{\\,{a}_{1}\\,}{r}^{2}} & =\\frac{196}{4} \\\\ \\frac{{r}^{4}}{{r}^{2}} & =49 \\\\ {r}^{2} & =49.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186554633 #edb/ref 1068 #edb/ref 17592186554476 #edb/ref 17592186045417] [17592186554633 #edb/ref 1069 "q-63999" #edb/ref 17592186045417] [17592186554633 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186554633 #edb/ref 1071 "The second term of a geometric sequence is $3$ and its fourth term is $27.$  Find the common ratio $r$ of this sequence given that $r$ is positive." #edb/ref 17592186045417] [17592186554633 #edb/ref 1072 #uuid "e964bcbb-bd9b-5437-9046-a26f2773d2b6" #edb/ref 17592186045417] [17592186554633 #edb/ref 1074 "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{4}=27$ and ${a}_{2}=3.$ Substituting $n=4$ and $m=2$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{4-2} & =\\frac{{a}_{4}}{{a}_{2}} \\\\ {r}^{2} & =\\frac{27}{3} \\\\ {r}^{2} & =9.\\end{aligned}\n$$\n\nFinally, solving the equation for $r$ and considering that $r$ is positive, we get\n\n$$\n\\begin{aligned}{r}^{2} & =9 \\\\ {r}^{2} & ={3}^{2} \\\\ r & =3.\\end{aligned}\n$$" #edb/ref 17592186045417]}
