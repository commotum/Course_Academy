#{[17592186138596 #edb/ref 1043 #edb/ref 17592186139486 #edb/ref 17592186045417] [17592186138596 #edb/ref 1043 #edb/ref 17592186139487 #edb/ref 17592186045417] [17592186138596 #edb/ref 1043 #edb/ref 17592186139488 #edb/ref 17592186045417] [17592186138596 #edb/ref 1043 #edb/ref 17592186139489 #edb/ref 17592186045417] [17592186138596 #edb/ref 1043 #edb/ref 17592186139490 #edb/ref 17592186045417] [17592186138596 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186138596 #edb/ref 1045 "Simplifying Linear Expressions Containing Fractions" #edb/ref 17592186045417] [17592186138596 #edb/ref 1046 #edb/ref 17592186139486 #edb/ref 17592186045417] [17592186138596 #edb/ref 1049 #edb/ref 17592186049047 #edb/ref 17592186045417] [17592186138596 #edb/ref 1050 480.0 #edb/ref 17592186045417] [17592186138596 #edb/ref 1053 #uuid "63522699-6803-576b-82ed-8d88d13eba2f" #edb/ref 17592186045417] [17592186138614 #edb/ref 1043 #edb/ref 17592186139522 #edb/ref 17592186045417] [17592186138614 #edb/ref 1043 #edb/ref 17592186139523 #edb/ref 17592186045417] [17592186138614 #edb/ref 1043 #edb/ref 17592186139524 #edb/ref 17592186045417] [17592186138614 #edb/ref 1043 #edb/ref 17592186139525 #edb/ref 17592186045417] [17592186138614 #edb/ref 1043 #edb/ref 17592186139526 #edb/ref 17592186045417] [17592186138614 #edb/ref 1043 #edb/ref 17592186139527 #edb/ref 17592186045417] [17592186138614 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186138614 #edb/ref 1045 "Compound Inequalities" #edb/ref 17592186045417] [17592186138614 #edb/ref 1046 #edb/ref 17592186139522 #edb/ref 17592186045417] [17592186138614 #edb/ref 1049 #edb/ref 17592186049051 #edb/ref 17592186045417] [17592186138614 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186138614 #edb/ref 1053 #uuid "4e2e5333-ed8e-576e-abed-94cc93efbdb5" #edb/ref 17592186045417] [17592186139294 #edb/ref 1058 #edb/ref 17592186139295 #edb/ref 17592186045417] [17592186139294 #edb/ref 1061 165169 #edb/ref 17592186045417] [175