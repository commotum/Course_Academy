{:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186536567} {:answer/id #uuid "cb0bbf4b-84c5-5b4b-bf9f-be7a1d428368" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186536604}] :answer-field/correct {:db/id #edb/ref 17592186536361} :answer-field/id #uuid "4b9b6de2-c942-5b7d-bee5-f32a9154bfcb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536733}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2b21718f-1527-5624-995c-489290485c6f" :question/math-academy-id "q-128027" :question/problem "Find the value of $(-\\frac{12}{5})÷(-3).$" :question/worked-solution "Dividing a negative number by a negative number gives a positive number. Hence, the result will be positive.\n\nTherefore, since \n\n$$\n\\frac{12}{5}÷3=\\frac{12}{5\\times 3}=\\frac{12}{15}=\\frac{4}{5},\n$$\n\nwe obtain\n\n$$\n(-\\frac{12}{5})÷(-3)=\\frac{4}{5}.\n$$"} :step/id #uuid "34561666-9bea-5d6d-853e-40e11bd2da5f" :step/next {:db/id #edb/ref 17592186536977}} {:db/id #edb/ref 17592186536921 :step/content {:db/id #edb/ref 17592186536858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b7ceac-a5dd-5a5e-81f6-5093daac715f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "314.65\\,\\text{g}\\le m<314.75\\,\\text{g}" :db/id #edb/ref 17592186536294} {:answer/id #uuid "334f31b7-f7be-595d-b52c-848908f510f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "314.69\\,\\text{g}\\le m<314.71\\,\\text{g}" :db/id #edb/ref 17592186536365} {:answer/id #uuid "5237a001-734d-52ba-8325-09127dd19a3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "314.695\\,\\text{g}\\le m<314.705\\,\\text{g}" :db/id #edb/ref 17592186536423} {:answer/id #uuid "52df3fc4-f30c-5656-9770-f6b6852fee06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "314.6\\,\\text{g}\\le m<314.8\\,\\text{g}" :db/id #edb/ref 17592186536426} {:answer/id #uuid "86ccb7e9-64a7-58a7-9d0c-22ade13bddc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "313.7\\,\\text{g}\\le m<315.7\\,\\text{g}" :db/id #edb/ref 17592186536502}] :answer-field/correct {:db/id #edb/ref 17592186536294} :answer-field/id #uuid "6435960d-f51a-52e7-94e7-a76e47e9ec99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536746}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8f0c5a6d-560b-5b20-a886-377893e98cd2" :question/math-academy-id "q-154082" :question/problem "The mass $m$ of a tablet PC measures $314.7\\,\\text{g}$ to the nearest tenth of a gram. Determine the upper and lower bounds of this measurement." :question/worked-solution "Our measurement is given to the nearest $0.1\\,\\text{g}.$ So, the greatest possible error of this measurement is\n\n$$\n\\frac{0.1\\,\\text{g}}{2}=0.05\\,\\text{g}.\n$$\n\nTherefore, we can calculate the lower and upper bounds of this measurement as follows:\n\n$$\n\\begin{aligned}\\text{lower bound} & =314.7\\,\\text{g}-0.05\\,\\text{g} \\\\  & =314.65\\,\\text{g} \\\\ \\text{upper bound} & =314.7\\,\\text{g}+0.05\\,\\text{g} \\\\  & =314.75\\,\\text{g}\\end{aligned}\n$$\n\nSince the exact value of $m$ lies between the lower and upper bound, we conclude that\n\n$$\n314.65\\,\\text{g}\\le m<314.75\\,\\text{g}.\n$$"} :step/id #uuid "3d4e32a9-5701-5da7-80e6-388ca6056199" :step/next {:db/id #edb/ref 17592186536939}} {:db/id #edb/ref 17592186536929 :step/content {:db/id #edb/ref 17592186536853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "231fa41e-7562-58c3-bc53-a8af642e063c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{w}^{4}-{w}^{3}" :db/id #edb/ref 17592186536332} {:answer/id #uuid "52e7dc11-9cb1-5f72-b61c-ed22849bf163" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{w}^{4}-6{w}^{3}" :db/id #edb/ref 17592186536427} {:answer/id #uuid "8f86123d-e422-5dce-9146-cf89e8645b54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{w}^{4}-{w}^{3}" :db/id #edb/ref 17592186536513} {:answer/id #uuid "d3ee0861-9665-55bd-98e5-b09f0500d4c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{w}^{4}-5{w}^{3}" :db/id #edb/ref 17592186536618} {:answer/id #uuid "fd9c33f9-8e43-5ba3-8d78-df3475ffcd16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{w}^{4}-5{w}^{3}" :db/id #edb/ref 17592186536689}] :answer-field/correct {:db/id #edb/ref 17592186536332} :answer-field/id #uuid "c4f49a27-fbe6-5211-9e4e-77c7312508de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536785}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8b3fdd80-83cc-5d53-85c1-0216b4942139" :question/math-academy-id "q-33226" :question/problem "$3{w}^{4}-{w}^{3}-5{w}^{4}=$" :question/worked-solution "Here, $3{w}^{3}$ and $-5{w}^{3}$are like terms, so we group them, and then we add or subtract the coefficients.\n\n$$\n\\begin{aligned}3{w}^{4}-{w}^{3}-5{w}^{4} & = \\\\ (3{w}^{4}-5{w}^{4})-{w}^{3} & = \\\\ (3-5){w}^{4}-{w}^{3} & = \\\\ -2{w}^{4}-{w}^{3}\\end{aligned}\n$$"} :step/id #uuid "562ff00d-571b-5999-9f45-fbee183d290f" :step/next {:db/id #edb/ref 17592186536921}} {:db/id #edb/ref 17592186536939 :step/content {:db/id #edb/ref 17592186074397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3309d42c-e7de-5e1b-be51-6b077a257c48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2:5" :db/id #edb/ref 17592186536363} {:answer/id #uuid "68e267a2-c19e-5d1c-8c01-8f92fa4013d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5:8" :db/id #edb/ref 17592186536461} {:answer/id #uuid "9e2d1ca2-29a3-590d-8b3a-8e4797c313f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1:5" :db/id #edb/ref 17592186536539} {:answer/id #uuid "c96f6581-7aac-56c8-9f71-0a776b002031" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3:4" :db/id #edb/ref 17592186536601} {:answer/id #uuid "d74c804c-a8d1-59e6-9899-b3b34ec27cb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2:3" :db/id #edb/ref 17592186536623}] :answer-field/correct {:db/id #edb/ref 17592186536623} :answer-field/id #uuid "f04dafd5-1f53-58c8-83ed-d257228e592c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186072620}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "57ed4a6f-262c-5ecd-8ab6-efd8ae2df206" :question/math-academy-id "q-59984" :question/problem "![](images/47/4777b642ae90300bcdcb33e2377067113a78f04a5a891a1c332178619291b6ad.png)\n\nNancy is making lemonade. The amount of water she needs for a given amount of lemon juice is given in the graph above. In its simplest form, what is the ratio of lemon juice to water?" :question/worked-solution "One of the points belonging to the graph is $(10,15).$\n\nLet's write the ratio $10:15$ as a fraction:\n\n$$\n\\frac{10}{15}\n$$\n\nWe can simplify this fraction by dividing both the numerator and the denominator by $5$:\n\n$$\n\\begin{aligned}\\frac{10÷5}{15÷5} & =\\frac{2}{3}\\end{aligned}\n$$\n\nSo the ratio of lemon juice to water is $2:3.$"} :step/id #uuid "70005216-31d5-544a-ba87-36b82b25ff44" :step/next {:db/id #edb/ref 17592186536949}} {:db/id #edb/ref 17592186536941 :step/content {:db/id #edb/ref 17592186536830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a5c6d33-1d35-5904-b068-cc3598e10f87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{125}" :db/id #edb/ref 17592186536302} {:answer/id #uuid "6420deb4-465e-555a-a374-d785308e82a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{125}" :db/id #edb/ref 17592186536457} {:answer/id #uuid "6869578e-010a-5d61-92d2-4038d52299fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{25}" :db/id #edb/ref 17592186536460} {:answer/id #uuid "8cf77517-9738-5543-8399-498bb9e2609f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186536509} {:answer/id #uuid "eb31a0c1-bfa5-5c81-aff5-37d4792278fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{75}" :db/id #edb/ref 17592186536656}] :answer-field/correct {:db/id #edb/ref 17592186536302} :answer-field/id #uuid "ba8ba35a-49bb-57fe-8e35-5eb9d11c64aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536781}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4305d4d8-cadf-560e-80db-63776f30d2a1" :question/math-academy-id "q-100739" :question/problem "${(\\frac{1}{5})}^{3}=$" :question/worked-solution "To raise the fraction to the power of $3$, we must raise both the numerator and the denominator to the power of $3:$\n\n$$\n{(\\frac{1}{5})}^{3}=\\frac{{1}^{3}}{{5}^{3}}\n$$\n\nNow, using ${1}^{3}=1$ and ${5}^{3}=125,$ we get\n\n$$\n\\frac{{1}^{3}}{{5}^{3}}=\\frac{1}{125}.\n$$"} :step/id #uuid "7ae4b46c-04b0-5da1-bcf6-bc60dfd09721" :step/next {:db/id #edb/ref 17592186536911}} {:db/id #edb/ref 17592186536943 :step/content {:db/id #edb/ref 17592186536825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1c0f87-8b49-5592-8278-4f20b774880f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\overset{―}{AB}$ and $\\overset{―}{DE}$" :db/id #edb/ref 17592186536345} {:answer/id #uuid "56845b85-a543-5de5-adf6-cdbc4d607c4a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\overset{―}{AF}$ and $\\overset{―}{EH}$" :db/id #edb/ref 17592186536433} {:answer/id #uuid "ab3a0964-0876-500d-953b-cf57d39d452e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\overset{―}{AF}$ and $\\overset{―}{DE}$" :db/id #edb/ref 17592186536560} {:answer/id #uuid "e4bce096-0cb3-534f-ac50-b962d3d5cd28" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\overset{―}{AF}$ and $\\overset{―}{CD}$" :db/id #edb/ref 17592186536641} {:answer/id #uuid "fcd10031-e0af-531a-a89d-15be1b754137" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\overset{―}{BC}$ and $\\overset{―}{EH}$" :db/id #edb/ref 17592186536688}] :answer-field/correct {:db/id #edb/ref 17592186536433} :answer-field/id #uuid "1f289b04-603f-536e-a74e-badc24c7a114" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536708}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3496c0a1-50f2-52f3-ab73-961afb8b5fec" :question/math-academy-id "q-52900" :question/problem "![](images/f2/f2d269fab1c7b0f7206ead91739a6df41c931089edb355bded226c868c1b74fc.png)\n\nWhich sides are consecutive to $\\overset{―}{FH}?$" :question/worked-solution "Two sides are consecutive if they have a vertex in common. Therefore, $\\overset{―}{AF}$ and $\\overset{―}{EH}$ are consecutive sides to $\\overset{―}{FH}.$"} :step/id #uuid "831d7468-e8ba-503e-ab48-9b0263c602af"} {:db/id #edb/ref 17592186536949 :step/content {:db/id #edb/ref 17592186536871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "489e5d74-a352-5e41-872e-d97d1152340f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-$23.10$" :db/id #edb/ref 17592186536395} {:answer/id #uuid "4ab57578-c0f4-564e-9dcc-b30c65737168" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-$17.50$" :db/id #edb/ref 17592186536401} {:answer/id #uuid "4b45565c-a329-5dbb-9963-42bd3aefa10e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-$18.60$" :db/id #edb/ref 17592186536403} {:answer/id #uuid "c55f0115-e6bf-5e7b-88ff-bcccaff67b54" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-$20.90$" :db/id #edb/ref 17592186536597} {:answer/id #uuid "db7af467-35db-5c13-913d-0211eaf4b4c3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$-$21.40$" :db/id #edb/ref 17592186536626}] :answer-field/correct {:db/id #edb/ref 17592186536626} :answer-field/id #uuid "bc9bd1b9-0131-55b4-a33d-f2d8e3052b46" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536782}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ac3e396f-e9ff-515e-95c3-ddf87162b016" :question/math-academy-id "q-68844" :question/problem "Maria has a bank account at LJB Bank. She has an overdraft facility authorized by this bank. Her bank balance on Monday was $-$40.00.$ To reduce her debt, Maria decides to make a deposit of $$18.60$ into her bank account on the following Tuesday. What is Maria's balance at the end of the day on Tuesday?" :question/worked-solution "To determine the balance at the end of the day on Tuesday, we must add the amount of money Maria deposited to the starting balance. This gives\n\n$$\n-$40.00+$18.60=-$21.40.\n$$\n\nThus, Maria's balance at the end of the day on Tuesday is $-$21.40.$"} :step/id #uuid "89b09572-620e-572d-a77d-722e8662abc5" :step/next {:db/id #edb/ref 17592186536920}} {:db/id #edb/ref 17592186536955 :step/content {:db/id #edb/ref 17592186536851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8298bf8e-c7b2-5ff5-a08a-84e187a9e365" :answer/type {:db/id #edb/ref 17592186045498} :answer/value ">" :db/id #edb/ref 17592186536498}] :answer-field/correct {:db/id #edb/ref 17592186536498} :answer-field/id #uuid "420e3038-9379-5f1b-bacb-cd8a79d07923" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186536726} {:answer-field/choices [{:answer/id #uuid "e4bd58a2-759b-5017-9df7-097ec85ef0de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186536642}] :answer-field/correct {:db/id #edb/ref 17592186536642} :answer-field/id #uuid "9731d226-3a56-501c-99bb-44ed05bb4dd9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186536759}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8a9682b8-c5c3-5a53-a91f-bba592503325" :question/math-academy-id "q-181308" :question/problem "![](images/87/878fd1c82e5d634e9090d9e7b49faf3a92135c8679d309e72505af6d201d5e80.png)\n\nThe inequality corresponding to the highlighted region shown above is $x${{field-1}}\n$-2\\text{ or }x$\n{{field-2}}$1.$" :question/worked-solution "The red rays contain all values less than $-2$ or greater than $1.$ In addition, \n\n- the open circle at $-2$ implies that $x$ cannot be equal to $-2,$ and\n\n- the open circle at $1$ implies that $x$ cannot be equal to $2.$\n\nTherefore, the highlighted region represents $x<-2$ or $x>1.$"} :step/id #uuid "a1bec5a5-8e2e-512b-ac1b-f78cee734328" :step/next {:db/id #edb/ref 17592186536941}} {:db/id #edb/ref 17592186536956 :step/content {:db/id #edb/ref 17592186536897 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2385595f-7f7d-5bcb-b6db-b0de1f32a65b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=2,$ $b=-2$ and $c=-1$" :db/id #edb/ref 17592186536334} {:answer/id #uuid "5bd91c40-af18-5c9d-b794-20c583df8cb8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=\\frac{1}{5},$ $b=2$ and $c=\\frac{2}{5}$" :db/id #edb/ref 17592186536444} {:answer/id #uuid "86d1e6a6-32cc-5370-9d0c-04db2526ab57" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=1,$ $b=-2$ and $c=2$" :db/id #edb/ref 17592186536503} {:answer/id #uuid "bd7d356d-5fef-5042-be30-4689b4b9777a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=1,$ $b=\\frac{1}{5}$ and $c=-\\frac{2}{5}$" :db/id #edb/ref 17592186536583} {:answer/id #uuid "fc3e3b6b-5c5d-5998-9365-602913fed818" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=1,$ $b=-2$ and $c=-\\frac{2}{5}$" :db/id #edb/ref 17592186536687}] :answer-field/correct {:db/id #edb/ref 17592186536687} :answer-field/id #uuid "9ac144df-2131-57c9-bfbb-43bd44e355e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536762}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f3e4db00-9ed0-5e91-8213-2ca14aefffbb" :question/math-academy-id "q-103625" :question/problem "If $\\frac{5x-10y-2z}{5}$ is written in the form $ax+by+cz,$ what are the values of  $a,$ $b$ and $c?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{5x-10y-2z}{5} & = \\\\ \\frac{5x}{5}-\\frac{10y}{5}-\\frac{2z}{5} & = \\\\ \\frac{5}{5}\\cdot x-\\frac{10}{5}\\cdot y-\\frac{2}{5}\\cdot z & = \\\\ 1\\cdot x-2\\cdot y-\\frac{2}{5}\\cdot z & = \\\\ x-2y-\\frac{2z}{5} & .\\end{aligned}\n$$\n\nWriting the above in the form $ax+by+cz,$ we get\n\n$$\n\\begin{aligned}{{(1)}_{⏟}}_{a}x+{{(-2)}_{⏟}}_{b}y+{{(-\\frac{2}{5})}_{⏟}}_{c}z.\\end{aligned}\n$$\n\nTherefore,  $a=1,$ $b=-2$ and $c=-\\frac{2}{5}.$"} :step/id #uuid "a5fff220-a65c-52c5-83e7-dd723079d075" :step/next {:db/id #edb/ref 17592186536955}} {:db/id #edb/ref 17592186536977 :step/content {:db/id #edb/ref 17592186536886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0099a153-14ac-5228-adff-948144c7c511" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186536287} {:answer/id #uuid "164cdbc6-b14e-5459-8e4d-4f24d14ceda3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186536319} {:answer/id #uuid "19ac550c-b465-5b11-ae37-62b736f5ff29" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186536321} {:answer/id #uuid "756c1651-49c5-59b4-9237-64c638bfd4f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186536481} {:answer/id #uuid "eb7b757c-1895-5c25-80ab-64cfd132b5b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186536657}] :answer-field/correct {:db/id #edb/ref 17592186536481} :answer-field/id #uuid "27071654-a089-55fa-816c-6ef4bea74f2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536713}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d513115b-ad74-5e72-8ee2-71bd9f120a6f" :question/math-academy-id "q-128174" :question/problem "![](images/0f/0f18036ac5790bda530116c6847243108f9617f9ae12fcbc5c1b2c3fff018985.png)\n\nWhich of the following terms describe the shape above?\n\nI. Parallelogram\n\nII. Rectangle\n\nIII. Rhombus" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nLet's now look at the terms one by one.\n\n- The given figure is a quadrilateral with two pairs of opposite congruent sides, so it is a parallelogram.\n\n- Since the four angles of the quadrilateral are right angles, it is a rectangle.\n\n- The given figure is a quadrilateral where the sides are not all congruent. So it is **not** a rhombus.\n\nConsequently, the given shape is described by terms I (parallelogram), and II (rectangle)."} :step/id #uuid "e1dd9c79-23ea-53a4-88a1-b6ba4715c9ab" :step/next {:db/id #edb/ref 17592186536910}} {:db/id #edb/ref 17592186536978 :step/content {:db/id #edb/ref 17592186536859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "471a4b7a-98d9-5684-a4fb-e5881f1be8ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186536392}] :answer-field/correct {:db/id #edb/ref 17592186536392} :answer-field/id #uuid "ec396184-e874-5ee9-9738-287768ca0067" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186536796}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8fef57fc-2f55-531e-87c9-45485e34049e" :question/math-academy-id "q-179536" :question/problem "If $r=4,$ then $\\frac{2r}{3}-2=${{field-1}}." :question/worked-solution "Replacing $r$ with $4$ in the expression, we get\n\n$$\n\\begin{aligned}\\frac{2r}{3}-2 & = \\\\ \\frac{2(4)}{3}-2 & = \\\\ \\frac{8}{3}-2 & = \\\\ \\frac{8-3\\cdot 2}{3} & = \\\\ \\frac{2}{3} & .\\end{aligned}\n$$"} :step/id #uuid "e398a282-5db4-58d8-a386-8b8b994ed716" :step/next {:db/id #edb/ref 17592186536912}} {:db/id #edb/ref 17592186536979 :step/content {:db/id #edb/ref 17592186536855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63e7d7b2-6328-5a7c-9e7b-fa3dbce3eabb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{\\sqrt{6}}" :db/id #edb/ref 17592186536455} {:answer/id #uuid "9667e35e-f889-55cd-8df1-5a84f2a0d662" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{30}" :db/id #edb/ref 17592186536525} {:answer/id #uuid "b68eee8c-221b-58d9-95b5-d015aa6fa3b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{\\sqrt{6}}" :db/id #edb/ref 17592186536573} {:answer/id #uuid "d5a72cad-24d0-5be3-9016-0f236bf8df17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{\\sqrt{6}}" :db/id #edb/ref 17592186536620} {:answer/id #uuid "f6c3fe8d-00a3-53be-a31e-4a67a046510c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{6}" :db/id #edb/ref 17592186536679}] :answer-field/correct {:db/id #edb/ref 17592186536573} :answer-field/id #uuid "02aa50d8-7e59-5ec3-baec-32c35fa91223" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536697}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8bf7e480-fb51-579e-b130-139151e7ecc4" :question/math-academy-id "q-68992" :question/problem "$\\sqrt{\\frac{5}{6}}=$" :question/worked-solution "The square root of a quotient of two positive numbers is equal to the quotient of the square roots of the numbers. Therefore,\n\n$$\n\\sqrt{\\frac{5}{6}}=\\frac{\\sqrt{5}}{\\sqrt{6}}.\n$$"} :step/id #uuid "e43b7507-9e67-5f0a-938c-6ae9b734b45c" :step/next {:db/id #edb/ref 17592186536980}} {:db/id #edb/ref 17592186536980 :step/content {:db/id #edb/ref 17592186536824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c122ba6-cc81-5732-b3b3-5c73d49cce35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "140" :db/id #edb/ref 17592186536407} {:answer/id #uuid "5f957550-490c-5d15-93b3-98e6be45e35b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "120" :db/id #edb/ref 17592186536449} {:answer/id #uuid "9647ff7c-56ee-5eaa-b169-213ba236e2d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "132" :db/id #edb/ref 17592186536523} {:answer/id #uuid "a0177ecd-9269-57dd-ac6c-b48ee7ad95ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "125" :db/id #edb/ref 17592186536544} {:answer/id #uuid "b97144c0-81e0-5543-82e8-e60b900bad57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "110" :db/id #edb/ref 17592186536576}] :answer-field/correct {:db/id #edb/ref 17592186536523} :answer-field/id #uuid "98df2e4f-b683-5bb4-8a2e-794e7d7efd73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536760}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "32edbf40-91ab-5dc2-911c-42534beb5cff" :question/math-academy-id "q-318354" :question/problem "What number is $175%$ greater than $48?$" :question/worked-solution "To find a number $175%$ *greater than* $48,$ we apply a new percentage of\n\n$$\n100%+175%=275%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n275%=\\frac{275}{100}=2.75\n$$\n\nSo, to find a number that is $175%$ greater than $48,$ we multiply $48$ by $2.75:$\n\n$$\n2.75\\cdot 48=132\n$$\n\nTherefore, the number that is $175%$ greater than $48$ is $132.$"} :step/id #uuid "eba8b6ca-b5f4-5ebf-b0a7-086c6e16f571" :step/next {:db/id #edb/ref 17592186536929}}] :activity/title "Quiz 9" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186536276}]}
