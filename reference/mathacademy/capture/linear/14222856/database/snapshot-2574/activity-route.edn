#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536978} :activity/id #uuid "730c4de1-8a80-5a4c-b896-a6d576e08875" :activity/steps [{:db/id #edb/ref 17592186536910 :step/content {:db/id #edb/ref 17592186536857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7dda24c2-846e-5ae5-9e55-258b14393706" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186536494}] :answer-field/correct {:db/id #edb/ref 17592186536494} :answer-field/id #uuid "aa265d47-40f3-5a3f-9bf0-25685f2be3fa" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186536769} {:answer-field/choices [{:answer/id #uuid "6ee09fa0-6224-5178-b8f9-36c108594771" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{29}{10}" :db/id #edb/ref 17592186536470}] :answer-field/correct {:db/id #edb/ref 17592186536470} :answer-field/id #uuid "cebc456f-ee3c-58cf-96e7-c237efa764f7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186536787}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8e8a0eda-6609-511f-9732-1a6312007048" :question/math-academy-id "q-175581" :question/problem "$\\frac{2}{5}x+4y+\\frac{5}{2}x+3y=${{field-1}}\n$x\\,+$\n{{field-2}}\n$y$" :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{2}{5}x+4y+\\frac{5}{2}x+3y & = \\\\ (\\frac{2}{5}x+\\frac{5}{2}x)+(4y+3y) & = \\\\ (\\frac{2}{5}+\\frac{5}{2})x+(4+3)y & = \\\\ (\\frac{4}{10}+\\frac{25}{10})x+7y & = \\\\ (\\frac{4+25}{10})x+7y & = \\\\ \\frac{29}{10}\\,x+7\\,y\\end{aligned}\n$$"} :step/id #uuid "1e2425be-8098-53da-bfb3-6126a03f6f56" :step/next {:db/id #edb/ref 17592186536956}} {:db/id #edb/ref 17592186536911 :step/content {:db/id #edb/ref 17592186536807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10