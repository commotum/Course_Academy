-6d170c347d50" :activity/scope {:db/id #edb/ref 17592186049355 :topic/id #uuid "ee459d83-61aa-5856-8bac-7a5980791833" :topic/math-academy-id 1131} :activity/steps [{:db/id #edb/ref 17592186501281 :step/content {:db/id #edb/ref 17592186097334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43af25d8-92f4-5878-a3dc-1e644c8ce222" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4.1}^{∘}\\text{C}" :db/id #edb/ref 17592186500598} {:answer/id #uuid "5af32836-d1a7-5d0a-943b-b796a712c9a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5.4}^{∘}\\text{C}" :db/id #edb/ref 17592186500653} {:answer/id #uuid "89cd1393-5088-5478-9c9a-365dbf9b98ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4.5}^{∘}\\text{C}" :db/id #edb/ref 17592186500756} {:answer/id #uuid "a8e8a032-002e-52f4-b130-3642ea6a8d2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4.9}^{∘}\\text{C}" :db/id #edb/ref 17592186500816} {:answer/id #uuid "aee93dc4-7161-5dc3-8fb5-fae906b155a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3.8}^{∘}\\text{C}" :db/id #edb/ref 17592186500833}] :answer-field/correct {:db/id #edb/ref 17592186500653} :answer-field/id #uuid "1e8d554f-b2db-5405-9a00-6a130d18be15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095928}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8ee7811c-bbf0-5938-a2b2-9a34707608bb" :question/math-academy-id "q-68929" :question/problem "Jennifer is doing a science experiment in her Chemistry class. She takes a liquid with a temperature of ${10.1}^{∘}\\text{C}$ and places it in a refrigerator. After half an hour, she removes the liquid from the refrigerator and places it on a table. She concludes that the temperature decreased by ${12.7}^{∘}\\text{C}.$\n\nAfter half an hour, Jennifer takes the temperature of the liquid again and finds that the temperature increased by ${8}^{∘}\\text{C}.$ What is the final temperature of the liquid?" :question/worked-solution "First of all, we must determine the temperature of the liquid when it was removed from the refrigerator. Since its temperature decreased by ${12.7}^{∘}\\text{C}$ compared to the initial temperature, we must subtract the variation in temperature from the initial temperature. This gives\n\n$$\n{10.1}^{∘}\\text{C}-{12.7}^{∘}\\text{C}=-{2.6}^{∘}\\text{C}.\n$$\n\nNow, we must determine the temperature of the liquid after half an hour had elapsed. Since the temperature of the liquid increased by ${8}^{∘}\\text{C}$ compared to the temperature when it was removed from the refrigerator, we add the variation in temperature to the temperature of the liquid when it was removed from the refrigerator. This gives\n\n$$\n-{2.6}^{∘}\\text{C}+{8}^{∘}\\text{C}={5.4}^{∘}\\text{C}.\n$$\n\nTherefore, the final temperature of the liquid is ${5.4}^{∘}\\text{C}.$"} :step/id #uuid "b210e935-1e45-56a0-b060-d68f4c88d265"} {:db/id #edb/ref 17592186501285 :step/content {:db/id #edb/ref 17592186097332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b50f720-834e-538d-a417-e00fac3153c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{1.2}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500555} {:answer/id #uuid "51dca9e2-de80-5c9d-8a95-e67f670877be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{1.3}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500635} {:answer/id #uuid "775a09e2-42f5-548f-8dd4-b32b4dc2ffac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{1.7}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500714} {:answer/id #uuid "a5596099-ee8b-5cf9-8adb-ce7fa5b6cd6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{2.3}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500805} {:answer/id #uuid "e2d3652a-d1a5-5019-9d30-94746544d406" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{2.1}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500948}] :answer-field/correct {:db/id #edb/ref 17592186500714} :answer-field/id #uuid "03913dbe-158c-5e69-a492-f412ab726635" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095916}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f9448c2-f63c-5cfa-ac1b-26b1b5d3b6f6" :question/math-academy-id "q-68889" :question/problem "On a certain day in January, the temperature in New York in the morning was $-{2.4}^{∘}\\,\\text{C}.$ At noon, the temperature registered a slight increase of ${0.7}^{∘}\\,\\text{C}.$ What was the temperature in New York at noon?" :question/worked-solution "To determine the temperature at noon, we add the variation in temperature to the temperature in the morning of that day This gives\n\n$$\n-{2.4}^{∘}\\,\\text{C}+{0.7}^{∘}\\,\\text{C}=-{1.7}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the temperature in New York at noon that day was $-{1.7}^{∘}\\,\\text{C}.$"} :step/id #uuid "b66eda3a-f894-548a-a50a-1339b390ccd6" :step/next {:db/id #edb/ref 17592186501281}} {:db/id #edb/ref 17592186501297 :step/content {:db/id #edb/ref 17592186097327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43d5adc5-a2eb-531a-b7ea-b5939b327f6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\,\\text{m}" :db/id #edb/ref 17592186500599} {:answer/id #uuid "86933486-a8ce-5022-91e0-69867dfc556a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14\\,\\text{m}" :db/id #edb/ref 17592186500748} {:answer/id #uuid "a0f2cce9-f1d9-5104-a5a1-b0915a465a5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15\\,\\text{m}" :db/id #edb/ref 17592186500794} {:answer/id #uuid "bb2d2cd5-3aa6-5d90-8deb-5b7155be97f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,\\text{m}" :db/id #edb/ref 17592186500856} {:answer/id #uuid "e5cee887-50b6-56ef-81f1-ae790574664e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\,\\text{m}" :db/id #edb/ref 17592186500957}] :answer-field/correct {:db/id #edb/ref 17592186500794} :answer-field/id #uuid "813aaeae-688c-5e88-936e-02dac71e1499" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095886}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "beabbd10-476d-53ed-8111-c1ff6cabe7de" :question/math-academy-id "q-68474" :question/problem "Margaret and Juan like freediving. One day they both went to the sea, and while Juan practiced this extreme sport $13$ meters below sea level, Margaret waited for him in the boat, $2$ meters above sea level. If Juan is below Margaret, how far apart are they from each other?" :question/worked-solution "To determine the distance between Margaret and Juan, we calculate the difference between Margaret's location and Juan's location. This gives\n\n$$\n2-(-13)=2+13=15\\,\\text{m}.\n$$\n\nTherefore, Margaret and Juan are $15\\,\\text{m}$ apart."} :step/id #uuid "f6f16938-eb50-51e6-8e2a-41104a49a9ed" :step/next {:db/id #edb/ref 17592186501285}}] :activity/title "Solving Problems Using Addition and Subtraction of Rational Numbers" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186500463}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186531684} :activity/id #uuid "3a7cc79b-02e8-5c46-8409-33face8b5d86" :activity/scope {:db/id #edb/ref 17592186049355 :topic/id #uuid "ee459d83-61aa-5856-8bac-7a5980791833" :topic/math-academy-id 1131} :activity/steps [{:db/id #edb/ref 17592186531684 :step/content {:db/id #edb/ref 17592186531647 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "522a5cb8-0595-52ba-9fc4-f068d4c71551" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6.5}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531044} {:answer/id #uuid "9f446274-2a06-55e0-8045-82df46c8c668" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5.5}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531210} {:answer/id #uuid "bd2b2c82-d14e-5b84-a678-29528d106c3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5.1}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531265} {:answer/id #uuid "cecbd7c4-4b6e-5c63-af83-fbf23e812e6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5.7}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531293} {:answer/id #uuid "ffb4664a-819a-5fb1-8000-71d73f25fc83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6.1}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531382}] :answer-field/correct {:db/id #edb/ref 17592186531382} :answer-field/id #uuid "36172dc8-5c18-5ef5-9115-2e2f3e7fffef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531430}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "de213b3e-d398-5228-8036-33cbe3a6bb3b" :question/math-academy-id "q-68888" :question/problem "Jordan did an experiment in his Chemistry class. He heated a liquid whose initial temperature was $-{1.2}^{∘}\\,\\text{C}.$ After several minutes, the temperature of the liquid increased by ${7.3}^{∘}\\,\\text{C}$, at which point he decided to end the experiment. What was the final temperature of the liquid?" :question/worked-solution "To determine the final temperature of the liquid, we add the variation in temperature to the initial temperature of the liquid. This gives\n\n$$\n-{1.2}^{∘}\\,\\text{C}+{7.3}^{∘}\\,\\text{C}={6.1}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the temperature of the liquid at the end of the experiment was ${6.1}^{∘}\\,\\text{C}.$"} :step/id #uuid "4312b0ab-5d64-50e6-af89-0104161e7489" :step/next {:db/id #edb/ref 17592186531721}} {:db/id #edb/ref 17592186531707 :step/content {:db/id #edb/ref 17592186531557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18077ca4-3183-5672-8449-0b9577e66287" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{20.0}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530910} {:answer/id #uuid "27359f95-680c-5018-a7ac-5a2779c5560b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{19.4}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530953} {:answer/id #uuid "6703364e-cb34-54b1-bbee-575941b2ee4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{19.0}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531093} {:answer/id #uuid "74447b91-7282-514f-97dd-a72921fec8a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{18.0}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531121} {:answer/id #uuid "7eaacb5e-d719-5348-ada6-db919d5cf4fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{18.4}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531141}] :answer-field/correct {:db/id #edb/ref 17592186530953} :answer-field/id #uuid "e8439ccf-f19f-54b5-951f-b6eba6db8136" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531540}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "02fcb6dd-d8d1-548e-be72-9006c65abdf0" :question/math-academy-id "q-72691" :question/problem "Chantelle did an experiment in her Chemistry class. She heated a liquid whose initial temperature was $-{5.3}^{∘}\\,\\text{C}.$ After several minutes, the temperature of the liquid increased by ${24.7}^{∘}\\,\\text{C}$, at which point she decided to end the experiment. What was the final temperature of the liquid?" :question/worked-solution "To determine the final temperature of the liquid, we add the variation in temperature to the initial temperature of the liquid. This gives\n\n$$\n-{5.3}^{∘}\\,\\text{C}+{24.7}^{∘}\\,\\text{C}={19.4}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the temperature of the liquid at the end of the experiment was ${19.4}^{∘}\\,\\text{C}.$"} :step/id #uuid "b3d2d012-a306-590e-b68d-a518598a0966"} {:db/id #edb/ref 17592186531721 :step/content {:db/id #edb/ref 17592186531630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0233853c-7d57-5992-a3de-9375ae31e3e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{2.9}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530866} {:answer/id #uuid "11599972-180e-564a-8500-e2e61a9c6541" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{3.7}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530894} {:answer/id #uuid "11d8cfac-231b-5b5e-a776-de1a254087fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{5.3}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186530897} {:answer/id #uuid "565ce699-4384-5be5-a535-10eb3fabc2a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{5.5}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531053} {:answer/id #uuid "64fa1bca-1096-5716-a7aa-e09d16681a32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{3.4}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186531087}] :answer-field/correct {:db/id #edb/ref 17592186530894} :answer-field/id #uuid "89a90e23-11a2-5c55-80c6-c90a2ec355b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531479}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aab3a1fe-f42d-5861-9d8c-8da472abefec" :question/math-academy-id "q-68925" :question/problem "In Toronto, Canada, the average temperature in November is ${4.9}^{∘}\\,\\text{C}.$ In December, the average temperature decreases by ${5.4}^{∘}\\,\\text{C}$ compared to November. Finally, in January, the average temperature decreases by ${3.2}^{∘}\\,\\text{C}$ compared to the previous month. Determine the average temperature in Toronto in January." :question/worked-solution "First, we must determine the average temperature in Toronto during the month of December. Since we know that the temperature decreases on average by ${5.4}^{∘}\\,\\text{C}$ compared to November, we subtract the variation in temperature from the average temperature in November. This gives\n\n$$\n{4.9}^{∘}\\,\\text{C}-{5.4}^{∘}\\,\\text{C}=-{0.5}^{∘}\\,\\text{C}.\n$$\n\nNow, we must determine the temperature during the month of January. Since we know that the temperature decreases on average by ${3.2}^{∘}\\,\\text{C}$ compared to December, we subtract the variation in temperature from the average temperature in December. This gives\n\n$$\n-{0.5}^{∘}\\,\\text{C}-{3.2}^{∘}\\,\\text{C}=-{3.7}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the average temperature in Toronto in January is $-{3.7}^{∘}\\,\\text{C}.$"} :step/id #uuid "ddd3f114-58f8-562c-960c-b5c342a5bcb5" :step/next {:db/id #edb/ref 17592186531707}}] :activity/title "Solving Problems Using Addition and Subtraction of Rational Numbers" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186530855}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186120613} :activity/id #uuid "af23758d-7476-5d58-8b4e-e0d2c3022048" :activity/scope {:db/id #edb/ref 17592186049538 :topic/id #uuid "fcf84897-2da1-577a-877e-c8fd8d1350aa" :topic/math-academy-id 1783} :activity/steps [{:db/id #edb/ref 17592186120613 :step/content {:db/id #edb/ref 17592186121146 :tutorial/content "We can simplify the polynomial below because it contains a pair of like terms:\n\n$$\n{\\color{blue}{3x^2}} +4x \\,{\\color{blue}{-}}\\,{\\color{blue}{2x^2}} +5\n$$\n\nTo simplify, we combine the like terms ($3x^2$ and $-2x^2$) by adding or subtracting their coefficients:\n\n$$\n\\begin{aligned}3{x}^{2}+4x-2{x}^{2}+5 & = \\\\ 3{x}^{2}-2{x}^{2}+4x+5 & = \\\\ (3{x}^{2}-2{x}^{2})+4x+5 & = \\\\ (3-2){x}^{2}+4x+5 & = \\\\ {x}^{2}+4x+5 & \\end{aligned}\n$$" :tutorial/id #uuid "dcac1959-d802-5641-8736-12d53db273a9" :tutorial/math-academy-id 8864 :tutorial/title "Introduction"} :step/id #uuid "8789d5b3-8f11-513e-a769-fad4e067d79a" :step/math-academy-id 150900 :step/next {:db/id #edb/ref 17592186120614}} {:db/id #edb/ref 17592186120614 :step/content {:db/id #edb/ref 17592186119768 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119529 :question/id #uuid "473d3810-3c45-5e76-87a2-9cc4d194a2b0" :question/math-academy-id "e-14292"} :knowledge-point/id #uuid "6b66305f-f020-5236-a344-502bc54f8cc0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186120241} {:db/id #edb/ref 17592186120468} {:db/id #edb/ref 17592186476872} {:db/id #edb/ref 17592186476933} {:db/id #edb/ref 17592186536853}] :knowledge-point/title "Simplifying a Polynomial"} :step/id #uuid "2339f28a-1bfe-5d7f-a1d4-4457e0b9dd39" :step/math-academy-id 150901 :step/next {:db/id #edb/ref 17592186120615}} {:db/id #edb/ref 17592186120615 :step/content {:db/id #edb/ref 17592186121147 :tutorial/content "To write a polynomial in **standard form**, we must arrange the terms of the variable's exponent in descending order. The first term should have the largest exponent, and the last term should have the smallest exponent.\n\nFor example, consider the following polynomial:\n\n$$\n6x-2x^2-2+x^3\n$$\n\nTo write this polynomial in standard form, we follow the steps below:\n\n1\\. Identify the term with the highest exponent ($x^3$) and write it first.\n\n2\\. Identify the term with the next highest exponent ($-2x^2$) and write it second.\n\n3\\. Continue identifying the term with the next highest exponent and writing it next until all of the polynomial terms have been written.\n\nTherefore, the standard form of our polynomial is\n\n$$\nx^3 -2x^2 + 6x -2.\n$$\n\nNote the following:\n\n- The leading term always appears first when a polynomial is written in standard form. This is where the leading term gets its name!\n\n- When a polynomial is written in standard form, we also say that the terms are written in **decreasing powers of $\\boldsymbol x$** or **descending powers of $\\boldsymbol x$** because the powers are decreasing/descending.\n\n- If we were to write the terms of our polynomial in *increasing* (or *ascending*) powers of $x,$ it would look as follows:\n\n$$\n-2 + 6x -2x^2 + x^3\n$$\n\nIn this case, the powers of $x$ *increase* as we read from left to right." :tutorial/id #uuid "40e8c8a9-715e-5a33-92e4-34369c27b505" :tutorial/math-academy-id 8868 :tutorial/title "Standard Form"} :step/id #uuid "ab63d222-6bc9-5825-a10a-531c4978485f" :step/math-academy-id 150904 :step/next {:db/id #edb/ref 17592186120616}} {:db/id #edb/ref 17592186120616 :step/content {:db/id #edb/ref 17592186119769 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119530 :question/id #uuid "f65e4129-1564-52d2-80b0-5c2e970722e8" :question/math-academy-id "e-14297"} :knowledge-point/id #uuid "af3f4c35-be23-5a1a-97fb-18e89ab51591" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048406}] :knowledge-point/questions [{:db/id #edb/ref 17592186120173} {:db/id #edb/ref 17592186120240} {:db/id #edb/ref 17592186476922} {:db/id #edb/ref 17592186476964} {:db/id #edb/ref 17592186476972}] :knowledge-point/title "Writing Polynomials in Standard Form"} :step/id #uuid "357f8d99-13be-51ca-a9b3-f2b34dc03d58" :step/math-academy-id 150905 :step/next {:db/id #edb/ref 17592186120617}} {:db/id #edb/ref 17592186120617 :step/content {:db/id #edb/ref 17592186119770 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119531 :question/id #uuid "409cbc8a-e56e-587b-a639-ecb2c2c0cc97" :question/math-academy-id "e-14302"} :knowledge-point/id #uuid "6f00d5b6-5c41-5499-a897-b3ea7cbb3432" :knowledge-point/questions [{:db/id #edb/ref 17592186120161} {:db/id #edb/ref 17592186120162} {:db/id #edb/ref 17592186120488} {:db/id #edb/ref 17592186476970}] :knowledge-point/title "Simplifying and Writing Polynomials in Standard Form"} :step/id #uuid "8288291c-78f5-5a1b-99f9-23e99b20eada" :step/math-academy-id 150908}] :activity/title "Simplifying Polynomials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120005}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186129942} :activity/id #uuid "7f8b0621-460a-5fd0-a97f-1010b71e6fd3" :activity/scope {:db/id #edb/ref 17592186049861 :topic/id #uuid "195298b7-de92-5cff-8e4c-30e6040a95db" :topic/math-academy-id 2012} :activity/steps [{:db/id #edb/ref 17592186129935 :step/content {:db/id #edb/ref 17592186129110 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128922 :question/id #uuid "5c179a8e-55f3-5be7-8e97-b54287ea23e3" :question/math-academy-id "e-4668"} :knowledge-point/id #uuid "8aab5653-c3ec-5b4e-b56f-53393955d641" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049714}] :knowledge-point/questions [{:db/id #edb/ref 17592186129826} {:db/id #edb/ref 17592186129830} {:db/id #edb/ref 17592186479057} {:db/id #edb/ref 17592186479143}] :knowledge-point/title "Applying the Power of Product Rule"} :step/id #uuid "fcae326c-6edf-5bae-84ae-a001e5da8818" :step/math-academy-id 17139 :step/next {:db/id #edb/ref 17592186129936}} {:db/id #edb/ref 17592186129936 :step/content {:db/id #edb/ref 17592186129111 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128923 :question/id #uuid "ee165665-5cf3-5343-bae6-9080a887fcd6" :question/math-academy-id "e-4669"} :knowledge-point/id #uuid "525486fb-d976-57a5-b6bd-c33f19177a3f" :knowledge-point/questions [{:db/id #edb/ref 17592186129827} {:db/id #edb/ref 17592186129828} {:db/id #edb/ref 17592186479058} {:db/id #edb/ref 17592186479098}] :knowledge-point/title "Applying the Power of Product Rule to Expressions with Fractions"} :step/id #uuid "56deb814-d1c1-54cd-97bd-ffe38566dc3e" :step/math-academy-id 17140 :step/next {:db/id #edb/ref 17592186129937}} {:db/id #edb/ref 17592186129937 :step/content {:db/id #edb/ref 17592186129112 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128924 :question/id #uuid "10d598e9-cbcf-5681-b500-b046e2ec27ca" :question/math-academy-id "e-4670"} :knowledge-point/id #uuid "a47a8902-eb6f-5d07-8e91-36796d1c6295" :knowledge-point/questions [{:db/id #edb/ref 17592186129829} {:db/id #edb/ref 17592186129831} {:db/id #edb/ref 17592186479137} {:db/id #edb/ref 17592186536867}] :knowledge-point/title "Applying the Power of Product Rule to Expressions with Negative Numbers"} :step/id #uuid "824f067a-aafa-5691-a971-7a05644aa56b" :step/math-academy-id 17141} {:db/id #edb/ref 17592186129942 :step/content {:db/id #edb/ref 17592186130340 :tutorial/content "To raise the product of two numbers to a power, we can raise each number to that power, and then multiply. This is the **power of product rule for exponents**. \n\nTo demonstrate, let's simplify the expression $(5 \\times 3)^4$ by applying the power of product rule:\n\n$$\n(5\\times 3)^4=5^4\\times 3^4\n$$\n\n**Note:** The power of product rule for exponents is really just a quicker alternative to using repeated multiplication, as follows:\n\n$$\n\\begin{aligned}(5\\times 3)^{4} & = \\\\ {{(5\\times 3)\\times (5\\times 3)\\times (5\\times 3)\\times (5\\times 3)}_{⏟}}_{4\\text{ copies}} & = \\\\ {{(5\\times 5\\times 5\\times 5)}_{⏟}}_{4\\text{ copies}}\\times {{(3\\times 3\\times 3\\times 3)}_{⏟}}_{4\\text{ copies}} & = \\\\ {5}^{4}\\times {3}^{4}\\end{aligned}\n$$" :tutorial/id #uuid "79b0e407-5948-563e-a8af-5dbcd3ab59f3" :tutorial/math-academy-id 3272 :tutorial/title "Introduction"} :step/id #uuid "308748b1-5bd7-5b3a-94ef-bd3c9df25cfe" :step/math-academy-id 17996 :step/next {:db/id #edb/ref 17592186129935}}] :activity/title "The Power of Product Rule for Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186129355}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186125365} :activity/id #uuid "391e2b89-8cde-5a13-8210-4ec865147d71" :activity/scope {:db/id #edb/ref 17592186049923 :topic/id #uuid "1ed8dd8d-e728-5e57-81fe-a7c1a6a08469" :topic/math-academy-id 1927} :activity/steps [{:db/id #edb/ref 17592186125338 :step/content {:db/id #edb/ref 17592186124481 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124294 :question/id #uuid "35290ca2-1488-52ba-9d2e-b8c3e04c45e4" :question/math-academy-id "e-4743"} :knowledge-point/id #uuid "202575c6-7672-5387-a5ae-762bef520add" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050358} {:db/id #edb/ref 17592186050404}] :knowledge-point/questions [{:db/id #edb/ref 17592186125205} {:db/id #edb/ref 17592186125210} {:db/id #edb/ref 17592186476915} {:db/id #edb/ref 17592186536807}] :knowledge-point/title "Separating a Square Root Into a Product of Two Square Roots"} :step/id #uuid "8ba8ca19-5df4-53c5-ab7a-0a7ba56e0bc7" :step/math-academy-id 17274 :step/next {:db/id #edb/ref 17592186125339}} {:db/id #edb/ref 17592186125339 :step/content {:db/id #edb/ref 17592186124482 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124295 :question/id #uuid "204328e4-810f-591e-a085-bb9cdadca875" :question/math-academy-id "e-4744"} :knowledge-point/id #uuid "d6f8c2c9-e82f-5d37-9f34-4811dd88c78d" :knowledge-point/questions [{:db/id #edb/ref 17592186125206} {:db/id #edb/ref 17592186125207} {:db/id #edb/ref 17592186476886} {:db/id #edb/ref 17592186476944}] :knowledge-point/title "Writing a Product of Two Square Roots as a Single Square Root"} :step/id #uuid "ec31ad60-33b1-5f33-bc69-7dda09da6514" :step/math-academy-id 17275 :step/next {:db/id #edb/ref 17592186125367}} {:db/id #edb/ref 17592186125340 :step/content {:db/id #edb/ref 17592186124483 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124296 :question/id #uuid "0c797a57-00a8-57b9-af30-655e8952c4c3" :question/math-academy-id "e-4756"} :knowledge-point/id #uuid "e97098b0-a7f9-564a-899e-60fb88682c80" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048770}] :knowledge-point/questions [{:db/id #edb/ref 17592186125208} {:db/id #edb/ref 17592186125209} {:db/id #edb/ref 17592186476873} {:db/id #edb/ref 17592186476923}] :knowledge-point/title "The Product Rule With Cube Roots"} :step/id #uuid "48f71bf2-cfc9-583f-81af-bf3c85f247e7" :step/math-academy-id 17346} {:db/id #edb/ref 17592186125365 :step/content {:db/id #edb/ref 17592186125769 :tutorial/content "To multiply square roots, we simply multiply the numbers under the root. This is called the **product rule for radicals**.\n\nTo demonstrate, let's simplify the expression $\\sqrt{2} \\cdot \\sqrt{5}$ by applying the product rule:\n\n$$\n\\sqrt{2} \\cdot \\sqrt{5} = \\sqrt{2 \\cdot 5} = \\sqrt{10}\n$$\n\nThe product rule also works for cube roots. For example,\n\n$$\n\\sqrt[3]{2} \\cdot \\sqrt[3]{5} = \\sqrt[3]{2 \\cdot 5} = \\sqrt[3]{10}.\n$$\n\nIn general, the product rule works for any product of $n$th roots. So for any $n,$ we have\n\n$$\n\\sqrt[n]{2} \\cdot \\sqrt[n]{5} = \\sqrt[n]{2 \\cdot 5} = \\sqrt[n]{10}.\n$$\n\n**Watch out!** We cannot use the product rule when we have the product of different radicals, such as square roots and cube roots. For example, the expression $\\sqrt{2} \\times \\sqrt[3]{5}$ cannot be simplified because the radicals $\\sqrt{\\phantom{x}}$ and $\\sqrt[3]{\\phantom{x}}$ are different." :tutorial/id #uuid "f7f60ab3-2c97-5570-bacc-49ef3d371c52" :tutorial/math-academy-id 3296 :tutorial/title "Introduction"} :step/id #uuid "dcc53fd7-b344-545d-8cd9-408d76d4ce85" :step/math-academy-id 18176 :step/next {:db/id #edb/ref 17592186125366}} {:db/id #edb/ref 17592186125366 :step/content {:db/id #edb/ref 17592186125770 :tutorial/content "The product rule can often be used to simplify square roots.\n\nFor example, consider $\\sqrt{98}.$ Note that $98=49 \\cdot 2,$ where $49$ is a perfect square. So, we have\n\n$$\n\\sqrt{98} = \\sqrt{49 \\cdot 2} = \\sqrt{49} \\cdot \\sqrt{2} = 7 \\sqrt{2}\n$$\n\nAlternatively, if we're given a simplified square root and we want to convert it to the square root of a single number, then we can work backwards using the product rule:\n\n$$\n7 \\sqrt{2} = \\sqrt{49} \\cdot \\sqrt{2} = \\sqrt{49 \\cdot 2} = \\sqrt{98}\n$$" :tutorial/id #uuid "6b8006c0-4a18-5c9d-84c6-1224cf85a921" :tutorial/math-academy-id 3298 :tutorial/title "Simplifying Square Roots"} :step/id #uuid "85a7257b-e917-5ef4-854d-85d0f5b7753b" :step/math-academy-id 18178 :step/next {:db/id #edb/ref 17592186125338}} {:db/id #edb/ref 17592186125367 :step/content {:db/id #edb/ref 17592186125771 :tutorial/content "The product rule applies to cube roots as well.\n\nFor example, consider $\\sqrt[3]{24}.$ Note that $24=8 \\cdot 3,$ where $8$ is a perfect cube. So, we have\n\n$$\n\\sqrt[3]{24} = \\sqrt[3]{8 \\cdot 3} = \\sqrt[3]{8} \\cdot \\sqrt[3]{3} = 2 \\sqrt[3]{3}.\n$$\n\nAgain, if we're given a simplified cube root and we want to convert it to the cube root of a single number then we can work backwards using the product rule:\n\n$$\n2 \\sqrt[3]{3} = \\sqrt[3]{8} \\cdot \\sqrt[3]{3} = \\sqrt[3]{8 \\cdot 3} = \\sqrt[3]{24}\n$$" :tutorial/id #uuid "d8fc754e-e350-5273-9188-9203a384b9b6" :tutorial/math-academy-id 3299 :tutorial/title "The Product Rule With Cube Roots"} :step/id #uuid "e9b6616d-b6fe-5529-bc7e-89b4bc69c83e" :step/math-academy-id 18179 :step/next {:db/id #edb/ref 17592186125340}}] :activity/title "The Product Rule for Radicals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124720}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186055890} :activity/id #uuid "c6035687-0b20-5278-942e-d7c865a8e2a4" :activity/scope {:db/id #edb/ref 17592186050127 :topic/id #uuid "2ed40600-0b7c-5540-8255-04fca5187c09" :topic/math-academy-id 64} :activity/steps [{:db/id #edb/ref 17592186055890 :step/content {:db/id #edb/ref 17592186056016 :tutorial/content "To **evaluate** the expression $3+x$ for $x={\\color{blue}2}$, we replace $x$ with $\\color{blue}2$ in the expression and simplify:\n\n$$\n\\begin{aligned}3+x & = \\\\ 3+(2) & = \\\\ 3+2 & = \\\\ 5 & \\end{aligned}\n$$" :tutorial/id #uuid "f4532e0a-1865-5de3-b251-2774b7d5d45d" :tutorial/math-academy-id 8079 :tutorial/title "Introduction"} :step/id #uuid "34a47b76-009d-562d-9fa3-84f6480e10ea" :step/math-academy-id 73028 :step/next {:db/id #edb/ref 17592186055891}} {:db/id #edb/ref 17592186055891 :step/content {:db/id #edb/ref 17592186054838 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054393 :question/id #uuid "dad98e52-6c94-5cb9-95f1-0db822fbb44a" :question/math-academy-id "e-12915"} :knowledge-point/id #uuid "9a02aff6-185a-56b7-8139-5efad8ddf403" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048888} {:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186055412} {:db/id #edb/ref 17592186055478} {:db/id #edb/ref 17592186055479} {:db/id #edb/ref 17592186479062} {:db/id #edb/ref 17592186479123}] :knowledge-point/title "Evaluating Linear Expressions"} :step/id #uuid "7a44adb4-ec60-5635-a786-870b859b9277" :step/math-academy-id 73029 :step/next {:db/id #edb/ref 17592186055892}} {:db/id #edb/ref 17592186055892 :step/content {:db/id #edb/ref 17592186054839 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054424 :question/id #uuid "6acd4bf9-8cf9-5a35-a1f5-a9a01766af87" :question/math-academy-id "e-13069"} :knowledge-point/id #uuid "f915db41-a929-5ff0-b571-9ab3a1d510e5" :knowledge-point/questions [{:db/id #edb/ref 17592186055062} {:db/id #edb/ref 17592186055288} {:db/id #edb/ref 17592186055289} {:db/id #edb/ref 17592186479069} {:db/id #edb/ref 17592186479111} {:db/id #edb/ref 17592186491149} {:db/id #edb/ref 17592186536818} {:db/id #edb/ref 17592186536859}] :knowledge-point/title "Evaluating Linear Expressions Containing Fractions"} :step/id #uuid "c4f792f2-3137-5f3d-835f-27e81b7b0ddb" :step/math-academy-id 73033 :step/next {:db/id #edb/ref 17592186055893}} {:db/id #edb/ref 17592186055893 :step/content {:db/id #edb/ref 17592186056017 :tutorial/content "The usual order of operations (PEMDAS) applies when evaluating expressions. So when an algebraic expression contains parentheses $(\\ldots)$, we calculate what's inside the parentheses *first*. \n\nFor example, we evaluate $6 - (2x+3)$ at $x=3$, as follows:\n\n$$\n\\begin{aligned}6-(2x+3) & = \\\\ 6-(2\\cdot 3+3) & = \\\\ 6-(6+3) & = \\\\ 6-9 & = \\\\ -3.\\end{aligned}\n$$" :tutorial/id #uuid "34dded6d-159e-5c07-9693-340cd7e2080e" :tutorial/math-academy-id 8081 :tutorial/title "Evaluating Expressions Containing Parentheses"} :step/id #uuid "6c3059f6-37e7-57cf-a1da-3e8a8ac0f0b4" :step/math-academy-id 73037 :step/next {:db/id #edb/ref 17592186055894}} {:db/id #edb/ref 17592186055894 :step/content {:db/id #edb/ref 17592186054840 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054394 :question/id #uuid "51bb6ac7-5c24-5805-85ba-9c697f4360b6" :question/math-academy-id "e-12919"} :knowledge-point/id #uuid "e5dcee75-1c40-5885-81e2-960bee2dd3a8" :knowledge-point/questions [{:db/id #edb/ref 17592186055260} {:db/id #edb/ref 17592186055261} {:db/id #edb/ref 17592186055268} {:db/id #edb/ref 17592186479081} {:db/id #edb/ref 17592186479109} {:db/id #edb/ref 17592186491166}] :knowledge-point/title "Evaluating Expressions of a Single Variable with Parentheses"} :step/id #uuid "0feb005d-8dfd-50f1-975c-f0edcb47caeb" :step/math-academy-id 73038 :step/next {:db/id #edb/ref 17592186055895}} {:db/id #edb/ref 17592186055895 :step/content {:db/id #edb/ref 17592186056018 :tutorial/content "If an expression contains more than one variable, we evaluate it using the same procedure, replacing each variable with the appropriate value.\n\nFor example, to find the value of $2b + \\dfrac{1}{2}a$ when $a=-2$ and $b=3,$ we replace $a$ with $-2$ and $b$ with $3\\mathbin{:}$\n\n$$\n\\begin{aligned}2b+\\frac{1}{2}a & = \\\\ 2\\cdot 3+\\frac{1}{2}\\cdot (-2) & = \\\\ 6-1 & = \\\\ 5\\end{aligned}\n$$" :tutorial/id #uuid "5858aaa3-b757-5794-a965-368222b8122f" :tutorial/math-academy-id 8082 :tutorial/title "Evaluating Expressions Containing More Than One Variable"} :step/id #uuid "fd60f94d-fcfc-5630-bf91-5646b04bf125" :step/math-academy-id 73042 :step/next {:db/id #edb/ref 17592186055896}} {:db/id #edb/ref 17592186055896 :step/content {:db/id #edb/ref 17592186054841 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054395 :question/id #uuid "caf5354e-e240-5515-94c7-6c3caa2063af" :question/math-academy-id "e-12920"} :knowledge-point/id #uuid "6d42c63b-4549-5ed0-8da5-72561253acb9" :knowledge-point/questions [{:db/id #edb/ref 17592186055266} {:db/id #edb/ref 17592186055267} {:db/id #edb/ref 17592186479068} {:db/id #edb/ref 17592186479125} {:db/id #edb/ref 17592186536895}] :knowledge-point/title "Evaluating Expressions Containing Multiple Variables"} :step/id #uuid "561eb475-e13d-577e-88df-bf741708db2f" :step/math-academy-id 73043}] :activity/title "Evaluating Linear Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054916}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186491276} :activity/id #uuid "c5c757e6-bbf4-5e43-b295-6e94b7d7c532" :activity/scope {:db/id #edb/ref 17592186050127 :topic/id #uuid "2ed40600-0b7c-5540-8255-04fca5187c09" :topic/math-academy-id 64} :activity/steps [{:db/id #edb/ref 17592186491231 :step/content {:db/id #edb/ref 17592186491166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3a3f7b6-e8b6-5e89-888c-8054c2bbbae3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186490846}] :answer-field/correct {:db/id #edb/ref 17592186490846} :answer-field/id #uuid "73f6cac1-03ce-521d-a9ba-b9024d58d2b5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186491047}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "79ba2bde-8132-53b1-8d2a-2c8fb0089fe0" :question/math-academy-id "q-180248" :question/problem "If $h=5,$ then $3(h-8)+11=${{field-1}}." :question/worked-solution "We replace $h$ with $5$ in the expression and evaluate the parentheses first:\n\n$$\n\\begin{aligned}3(h-8)+11 & = \\\\ 3(5-8)+11 & = \\\\ 3(-3)+11 & = \\\\ -9+11 & = \\\\ 2 & \\end{aligned}\n$$"} :step/id #uuid "39d80571-3269-5150-845b-28436a0a2497"} {:db/id #edb/ref 17592186491246 :step/content {:db/id #edb/ref 17592186491149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abfc1b8e-9de5-5538-aee2-de9cac0e9509" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186490853}] :answer-field/correct {:db/id #edb/ref 17592186490853} :answer-field/id #uuid "ae77bf12-3e74-5cbf-b87a-cc3a8d30f6a1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186491071}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5b99e56c-ad94-54d0-842e-fa2fe1eccf19" :question/math-academy-id "q-179537" :question/problem "If $v=8,$ then $2-\\frac{v}{5}=${{field-1}}." :question/worked-solution "Replacing $v$ with $8$ in the expression, we get\n\n$$\n\\begin{aligned}2-\\frac{v}{5} & = \\\\ 2-\\frac{8}{5} & = \\\\ \\frac{2\\cdot 5-8}{5} & = \\\\ \\frac{2}{5} & .\\end{aligned}\n$$"} :step/id #uuid "6bf4c860-29fa-57b1-8224-b01d35195e0f" :step/next {:db/id #edb/ref 17592186491231}} {:db/id #edb/ref 17592186491276 :step/content {:db/id #edb/ref 17592186055289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f91b176-7a76-531d-bf78-d71efd4387f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186052972} {:answer/id #uuid "b92e5659-9a39-53ea-9213-d39f1ed36e56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186052973} {:answer/id #uuid "f3b6aae1-a2f8-5c78-ab69-05c5e8cd91a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186052974} {:answer/id #uuid "11d98231-154d-5aa8-a2a4-915b69036b58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186052975} {:answer/id #uuid "12a6ca44-5064-5ec7-bec7-d128f6981b6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186052976}] :answer-field/correct {:db/id #edb/ref 17592186052976} :answer-field/id #uuid "176da1dd-e17f-5c3d-aaf3-4fabcd678809" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186052971}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "74548fba-87bb-5bd8-bd8a-1a1dbe7d1130" :question/math-academy-id "q-44272" :question/problem "Evaluate $3-\\frac{m}{3}$ for $m=6.$" :question/worked-solution "Replacing $m$ with $6$ in the expression, we get\n\n$$\n\\begin{aligned}3-\\frac{m}{3} & = \\\\ 3-\\frac{6}{3} & = \\\\ 3-2 & = \\\\ 1.\\end{aligned}\n$$"} :step/id #uuid "f968670f-d1d6-543f-b58f-f0cbb571267d" :step/next {:db/id #edb/ref 17592186491246}}] :activity/title "Evaluating Linear Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186490510}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536964} :activity/id #uuid "64f22741-1620-5ebf-a698-c114e4dfd2d4" :activity/scope {:db/id #edb/ref 17592186050127 :topic/id #uuid "2ed40600-0b7c-5540-8255-04fca5187c09" :topic/math-academy-id 64} :activity/steps [{:db/id #edb/ref 17592186536907 :step/content {:db/id #edb/ref 17592186536818 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d3ba2ca-3832-5dc3-9fb9-10f0bb92af21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186536467} {:answer/id #uuid "6ebd1e88-6bcf-591f-926c-4a1673c2672c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186536469} {:answer/id #uuid "caccab01-04b7-51d0-a959-905fccb9ed6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186536603} {:answer/id #uuid "f10524ba-6897-50bd-a165-464eef34e996" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186536666} {:answer/id #uuid "ffad4caf-5fdb-50bf-a855-3942f62af10f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186536693}] :answer-field/correct {:db/id #edb/ref 17592186536693} :answer-field/id #uuid "b81d465f-8515-5dea-92b5-4f5818d1c903" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536778}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "23eee6bd-a3f3-5d31-99a2-293051ea115d" :question/math-academy-id "q-179516" :question/problem "Evaluate $8+\\frac{3x}{4}$ for $x=-8.$" :question/worked-solution "Replacing $x$ with $-8$ in the expression, we get\n\n$$\n\\begin{aligned}8+\\frac{3x}{4} & = \\\\ 8+\\frac{3}{4}\\cdot (-8) & = \\\\ 8-\\frac{24}{4} & = \\\\ 8-6 & = \\\\ 2 & .\\end{aligned}\n$$"} :step/id #uuid "0f37d062-2bc9-5789-a927-01f7e374eae9"} {:db/id #edb/ref 17592186536961 :step/content {:db/id #edb/ref 17592186536895 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d10c19e-e150-55eb-b24f-880c7b312823" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186536466} {:answer/id #uuid "a3b3c01c-522f-573c-9eb2-ad4d95b6fe5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186536548} {:answer/id #uuid "aabb5221-9e59-59ad-89e3-cdfd40a76ef1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-22" :db/id #edb/ref 17592186536557} {:answer/id #uuid "ceffc3ea-0be6-5e49-bd61-93965c77fc7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186536609} {:answer/id #uuid "ee0c7ef3-1224-563f-ab0a-0e9a6c26a9b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22" :db/id #edb/ref 17592186536662}] :answer-field/correct {:db/id #edb/ref 17592186536609} :answer-field/id #uuid "bd06868d-23f4-5b1c-a48c-3253d06db7ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536783}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f350f45b-6b40-5442-831e-bda149e4ff5d" :question/math-academy-id "q-41203" :question/problem "If $p=2$ and $q=-2,$ then $8p+7q+2=$" :question/worked-solution "Replacing $p$ with $2$ and $q$ with $-2$ in the expression, we get\n\n$$\n\\begin{aligned}8p+7q+2 & = \\\\ 8(2)+7(-2)+2 & = \\\\ 16+(-14)+2 & = \\\\ 16-14+2 & = \\\\ 4.\\end{aligned}\n$$"} :step/id #uuid "b3cc2331-6b4e-5004-b3ef-6e9ebe344a7c" :step/next {:db/id #edb/ref 17592186536907}} {:db/id #edb/ref 17592186536964 :step/content {:db/id #edb/ref 17592186055261 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "836062b0-524b-538a-ae83-7cad477cb4ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186052804} {:answer/id #uuid "8536fa93-92ba-5579-8423-a5d6f6b4e5c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186052805} {:answer/id #uuid "965dad9f-9100-51ca-9460-5f28cbd40484" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186052806} {:answer/id #uuid "9b99030e-5927-5114-bb6a-579ed4a631f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186052807} {:answer/id #uuid "1c804d08-6d90-5c98-bbd8-0145eeb15e1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186052808}] :answer-field/correct {:db/id #edb/ref 17592186052805} :answer-field/id #uuid "0738cf39-8cba-5493-9162-fc131deb3619" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186052803}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a40f13fa-0e75-5597-9336-15bb065e38ac" :question/math-academy-id "q-41015" :question/problem "Evaluate $1+(2-3x)$ for $x=-1.$" :question/worked-solution "We replace $x$ with $-1$ in the expression and evaluate the parentheses first:\n\n$$\n\\begin{aligned}1+(2-3x) & = \\\\ 1+(2-3\\cdot (-1)) & = \\\\ 1+(2-(-3)) & = \\\\ 1+(2+3) & = \\\\ 1+5 & = \\\\ 6\\end{aligned}\n$$"} :step/id #uuid "bb29e9d5-2794-5eb8-b471-0795b5e1d4ca" :step/next {:db/id #edb/ref 17592186536961}}] :activity/title "Evaluating Linear Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186536275}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186139326} :activity/id #uuid "7b28ec1f-d603-58bd-8b19-a4b5ae532d10" :activity/scope {:db/id #edb/ref 17592186050315 :topic/id #uuid "3f453bac-6f10-55b6-9795-7cf9ac76659e" :topic/math-academy-id 2240} :activity/steps [{:db/id #edb/ref 17592186139305 :step/content {:db/id #edb/ref 17592186138394 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138299 :question/id #uuid "571f96ea-2c3c-55e6-b776-9009301d8d9e" :question/math-academy-id "e-4778"} :knowledge-point/id #uuid "638d891b-f2c9-505e-99a6-9c15fbf6df5a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050358} {:db/id #edb/ref 17592186050404}] :knowledge-point/questions [{:db/id #edb/ref 17592186139157} {:db/id #edb/ref 17592186139158} {:db/id #edb/ref 17592186476939} {:db/id #edb/ref 17592186476956} {:db/id #edb/ref 17592186536855}] :knowledge-point/title "Separating a Square Root Into a Quotient of Two Square Roots"} :step/id #uuid "be8f78e1-4021-5706-815d-35b712aee1e1" :step/math-academy-id 17374 :step/next {:db/id #edb/ref 17592186139306}} {:db/id #edb/ref 17592186139306 :step/content {:db/id #edb/ref 17592186138395 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138300 :question/id #uuid "96cf1739-aa80-574d-900e-3ff75517cfe9" :question/math-academy-id "e-4779"} :knowledge-point/id #uuid "afa8c578-f074-5c70-a6d8-7ad3fb059961" :knowledge-point/questions [{:db/id #edb/ref 17592186139155} {:db/id #edb/ref 17592186139156} {:db/id #edb/ref 17592186476901} {:db/id #edb/ref 17592186476934} {:db/id #edb/ref 17592186476952} {:db/id #edb/ref 17592186476965}] :knowledge-point/title "Writing a Quotient of Two Square Roots as a Single Square Root"} :step/id #uuid "16b49c7f-043e-5aeb-9d10-cd74f7f3ddf8" :step/math-academy-id 17375 :step/next {:db/id #edb/ref 17592186139307}} {:db/id #edb/ref 17592186139307 :step/content {:db/id #edb/ref 17592186138396 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138301 :question/id #uuid "f0bfcf6d-08a2-5dc4-b66c-814445c05e76" :question/math-academy-id "e-4780"} :knowledge-point/id #uuid "6d8f0211-cd1a-5a01-9422-2e3e475599ed" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048770}] :knowledge-point/questions [{:db/id #edb/ref 17592186139159} {:db/id #edb/ref 17592186139160} {:db/id #edb/ref 17592186476878} {:db/id #edb/ref 17592186476917}] :knowledge-point/title "The Quotient Rule With Cube Roots"} :step/id #uuid "c1d5b8d5-8593-5e6a-84da-d4aaea527af8" :step/math-academy-id 17376} {:db/id #edb/ref 17592186139326 :step/content {:db/id #edb/ref 17592186139644 :tutorial/content "To divide square roots, we simply divide the numbers under the root. This is called the **quotient rule for radicals**.\n\nTo demonstrate, let's simplify the expression $\\dfrac{ \\sqrt{10} }{ \\sqrt{2} }$ by applying the quotient rule:\n\n$$\n\\dfrac{ \\sqrt{10} }{ \\sqrt{2} } = \\sqrt{ \\dfrac{10}{2} } = \\sqrt{5}\n$$\n\nThe quotient rule also works for cube roots. For example,\n\n$$\n\\dfrac{ \\sqrt[3]{10} }{ \\sqrt[3]{2} } = \\sqrt[3]{ \\dfrac{10}{2} } = \\sqrt[3]{5}\n$$\n\nIn general, the quotient rule works for any quotient of $n$th roots. So for any $n,$ we have\n\n$$\n\\dfrac{ \\sqrt[n]{10} }{ \\sqrt[n]{2} } = \\sqrt[n]{ \\dfrac{10}{2} } = \\sqrt[n]{5}.\n$$\n\n**Watch out!** We cannot use the quotient rule when we have the quotient of different radicals, such as square roots and cube roots. For example, the expression $\\dfrac{ \\sqrt{10} }{ \\sqrt[3]{5} }$ cannot be simplified because the radicals $\\sqrt{\\phantom{x}}$ and $\\sqrt[3]{\\phantom{x}}$ are different." :tutorial/id #uuid "6ea49118-4345-575a-a14f-9aedade211d4" :tutorial/math-academy-id 3297 :tutorial/title "Introduction"} :step/id #uuid "7e0565a6-cf26-5e4b-8bc5-c3de10c211d9" :step/math-academy-id 18177 :step/next {:db/id #edb/ref 17592186139305}}] :activity/title "The Quotient Rule for Radicals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138594}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074877} :activity/id #uuid "b18f153a-24ae-52c2-833b-f1d51a752952" :activity/scope {:db/id #edb/ref 17592186050948 :topic/id #uuid "7447137e-4148-57e3-9e8c-8ef64742b913" :topic/math-academy-id 561} :activity/steps [{:db/id #edb/ref 17592186074877 :step/content {:db/id #edb/ref 17592186074968 :tutorial/content "Remember that we can place equivalent ratios in a ratio table, like the one below.\n\n| $\\color{blue}x$ | $\\color{red}y$ |\n| --- | --- |\n| $\\color{blue}1$ | $\\color{red}2$ |\n| $\\color{blue}2$ | $\\color{red}4$ |\n| $\\color{blue}4$ | $\\color{red}8$ |\n\nBy setting the values in the left column as $\\color{blue}x$-coordinates and the values in the right column as the corresponding $\\color{red}y$-coordinates, we can graph the points to represent a relationship between the ratios.\n\nIn this case, we have the following ordered pairs: $({\\color{blue}1},{\\color{red}2}),$ $({\\color{blue}2},{\\color{red}4}),$ $({\\color{blue}4},{\\color{red}8}).$\n\nPlotting these points on a coordinate plane, we get the following graph:\n\n![](images/0c/0c4abb8d462730ed9b532feeca1e0a800f5376a978bfc799afb9d9a927ff310d.png)\n\nConnecting the points gives us a straight line! Plotting equivalent ratios will *always* give a straight line. Furthermore, the straight line will *always* pass through the origin $(0,0).$" :tutorial/id #uuid "05d7bd91-e8b4-5ada-936f-6036f766cf23" :tutorial/math-academy-id 2053 :tutorial/title "Introduction"} :step/id #uuid "e3c01e56-883c-55ab-9e6a-10ceb0575884" :step/math-academy-id 7803 :step/next {:db/id #edb/ref 17592186074878}} {:db/id #edb/ref 17592186074878 :step/content {:db/id #edb/ref 175921