{:answer-field/choices [{:answer/id #uuid "03200003-7c03-5877-9799-fe42b38367d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5d}{3}-3e+2f" :db/id #edb/ref 17592186513535} {:answer/id #uuid "875b0e1a-c6ee-5156-9b67-b9182be36dd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}-3e+2f" :db/id #edb/ref 17592186513884} {:answer/id #uuid "a837bab8-9905-5840-bdf4-12b924029d23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5d}{3}-3e-2f" :db/id #edb/ref 17592186513968} {:answer/id #uuid "b7dfca26-24d1-5b2e-89b8-03b7057f94a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "d-9e-2f" :db/id #edb/ref 17592186514016} {:answer/id #uuid "e8af9eea-0d25-50f2-b747-1968474f3c58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2d-9e-2f" :db/id #edb/ref 17592186514140}] :answer-field/correct {:db/id #edb/ref 17592186513968} :answer-field/id #uuid "5be07d56-1b09-5907-9a4a-651321f7cdec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514269}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cedc5783-2073-5a5a-9238-c637979688f1" :question/math-academy-id "q-2595" :question/problem "$\\frac{5d-9e-6f}{3}=$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{5d-9e-6f}{3} & = \\\\ \\frac{5d}{3}-\\frac{9e}{3}-\\frac{6f}{3} & = \\\\ \\frac{5d}{3}-\\frac{9}{3}\\cdot e-\\frac{6}{3}\\cdot f & = \\\\ \\frac{5d}{3}-3e-2f & .\\end{aligned}\n$$"} :step/id #uuid "500be06c-ef79-5741-b61d-1e169ee21469" :step/next {:db/id #edb/ref 17592186514518}} {:db/id #edb/ref 17592186514516 :step/content {:db/id #edb/ref 17592186514417 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75c969ca-367d-5068-acbe-f0467f813227" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=2$ and $b=-3$" :db/id #edb/ref 17592186513843} {:answer/id #uuid "c1682820-b145-57af-bb60-67f57aa12777" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=2$ and $b=3$" :db/id #edb/ref 17592186514043} {:answer/id #uuid "cd8541b1-df31-5bf9-9595-f8be69351a38" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=8$ and $b=-3$" :db/id #edb/ref 17592186514063} {:answer/id #uuid "e31a9be0-36c9-524a-9bf7-ae092f66b308" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=3$ and $b=-2$" :db/id #edb/ref 17592186514127} {:answer/id #uuid "f8331f74-2394-5f6e-af1d-324225a8b66a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$a=2$ and $b=-12$" :db/id #edb/ref 17592186514180}] :answer-field/correct {:db/id #edb/ref 17592186513843} :answer-field/id #uuid "23253a0c-91f5-5d73-8605-1ae876bdd4b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514235}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "69e15305-fd39-5e12-9afd-c74d993158ed" :question/math-academy-id "q-2593" :question/problem "If $\\frac{8x-12y}{4}$ is written in the form $ax+by,$ what are the values of $a$ and $b?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{8x-12y}{4} & = \\\\ \\frac{8x}{4}-\\frac{12y}{4} & = \\\\ \\frac{8}{4}\\cdot x-\\frac{12}{4}\\cdot y & = \\\\ 2x-3y & .\\end{aligned}\n$$\n\nWriting the above in the form $ax+by,$ we get\n\n$$\n\\begin{aligned}{{(2)}_{⏟}}_{a}x+{{(-3)}_{⏟}}_{b}y.\\end{aligned}\n$$\n\nTherefore, $a=2$ and $b=-3.$"} :step/id #uuid "7d64cf93-ea34-55d5-ba8a-91d5a0d045c0" :step/next {:db/id #edb/ref 17592186514499}} {:db/id #edb/ref 17592186514518 :step/content {:db/id #edb/ref 17592186514455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "233176ce-70f9-5e6d-87d1-a9ee42aee061" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a-6b" :db/id #edb/ref 17592186513629} {:answer/id #uuid "2b6d12dd-a924-575c-bf78-e849044273ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a-4" :db/id #edb/ref 17592186513650} {:answer/id #uuid "6a973a8f-68d4-5f16-b9b5-43302aeb1566" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4a-\\frac{3b}{2}" :db/id #edb/ref 17592186513818} {:answer/id #uuid "98adbab9-1df8-5350-9e28-7f78e7ab5f5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "a-\\frac{3b}{2}" :db/id #edb/ref 17592186513929} {:answer/id #uuid "b3b993a8-041c-5f04-b5e8-b517b901f0ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{3b}{2}" :db/id #edb/ref 17592186514002}] :answer-field/correct {:db/id #edb/ref 17592186513929} :answer-field/id #uuid "a56dfd75-69de-5099-a23d-5bcbe223963a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514304}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b8beba6a-7b91-5602-93f9-62eba4e754b8" :question/math-academy-id "q-2596" :question/problem "Which of the following is equivalent to $\\frac{4a-6b}{4}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{4a-6b}{4} & = \\\\ \\frac{4a}{4}-\\frac{6b}{4} & = \\\\ \\frac{4}{4}\\cdot a-\\frac{6}{4}\\cdot b & = \\\\ a-\\frac{3}{2}\\cdot b & = \\\\ a-\\frac{3b}{2} & .\\end{aligned}\n$$"} :step/id #uuid "98967ed7-c764-5a5b-b909-edddb93ab4db" :step/next {:db/id #edb/ref 17592186514530}} {:db/id #edb/ref 17592186514530 :step/content {:db/id #edb/ref 17592186514373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19980522-9bdd-55a7-8d9d-8828e76405ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6-\\frac{y}{2}" :db/id #edb/ref 17592186513600} {:answer/id #uuid "320dbf36-2cfb-59da-86bb-c1a4774c9420" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4-\\frac{y}{2}" :db/id #edb/ref 17592186513668} {:answer/id #uuid "c52cd410-949a-5ecc-9db0-e370a7d7839c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4-y" :db/id #edb/ref 17592186514049} {:answer/id #uuid "c6076542-ac8d-521b-91c3-c0f173f61489" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-\\frac{y}{2}" :db/id #edb/ref 17592186514051} {:answer/id #uuid "db0641d9-8d65-5bc9-86fa-3e03187c823e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-y" :db/id #edb/ref 17592186514105}] :answer-field/correct {:db/id #edb/ref 17592186514051} :answer-field/id #uuid "abc45ee2-9c31-50c1-96af-d62cdd130b8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514307}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "18e51362-5c55-557f-b76e-006c8ec5e5f2" :question/math-academy-id "q-103607" :question/problem "Which of the following is equivalent to $\\frac{12-3y}{6}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in individual terms, we get\n\n$$\n\\begin{aligned}\\frac{12-3y}{6} & = \\\\ \\frac{12}{6}-\\frac{3y}{6} & = \\\\ \\frac{12}{6}-\\frac{3}{6}\\cdot y & = \\\\ 2-\\frac{1}{2}\\cdot y & = \\\\ 2-\\frac{y}{2}.\\end{aligned}\n$$"} :step/id #uuid "c51eee0e-bd4d-55fb-bf8e-c27eef65b158"} {:db/id #edb/ref 17592186514536 :step/content {:db/id #edb/ref 17592186514368 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "000d1ee2-eb0e-516d-880b-59e76d658afd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4a}{3}-2b+3c" :db/id #edb/ref 17592186513525} {:answer/id #uuid "17d560ac-9cc4-58ec-bd8a-4cc87ded49ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{a}{3}-2b+3c" :db/id #edb/ref 17592186513592} {:answer/id #uuid "3def3569-bf02-567b-a7ce-c0676ebb8e33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4a}{3}-2b-3c" :db/id #edb/ref 17592186513694} {:answer/id #uuid "a1c1327e-3c63-5535-94ec-15c702bd94af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7abc}{3}" :db/id #edb/ref 17592186513950} {:answer/id #uuid "d2165713-727d-5608-af21-2766b713333b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4a}{3}+2b-3c" :db/id #edb/ref 17592186514078}] :answer-field/correct {:db/id #edb/ref 17592186513525} :answer-field/id #uuid "33f1ff95-b84b-5146-8e81-b9dec5eae7f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514247}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1169d5be-77b9-5c01-b29e-d873231e9f86" :question/math-academy-id "q-2591" :question/problem "Which of the following is equivalent to $\\frac{4a-6b+9c}{3}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{4a-6b+9c}{3} & = \\\\ \\frac{4a}{3}-\\frac{6b}{3}+\\frac{9c}{3} & = \\\\ \\frac{4a}{3}-\\frac{6}{3}\\cdot b+\\frac{9}{3}\\cdot c & = \\\\ \\frac{4a}{3}-2b+3c & .\\end{aligned}\n$$"} :step/id #uuid "d09296b7-b1c5-5fd5-a919-8913f8b1040a" :step/next {:db/id #edb/ref 17592186514516}}] :activity/title "Splitting Rational Expressions Into Separate Terms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186513521}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186139486} :activity/id #uuid "63522699-6803-576b-82ed-8d88d13eba2f" :activity/scope {:db/id #edb/ref 17592186049047 :topic/id #uuid "d5a8629a-110d-5d05-beb7-159e81536910" :topic/math-academy-id 2244} :activity/steps [{:db/id #edb/ref 17592186139486 :step/content {:db/id #edb/ref 17592186139661 :tutorial/content "Suppose that we want to simplify the following expression: \n\n$$\n2+\\dfrac{5}{2}x -5 + \\dfrac{7}{2}x.\n$$\n\n  \n\nWe begin by collecting like terms.\n\n$$\n\\begin{aligned}(\\frac{5}{2}x+\\frac{7}{2}x)+(2-5)\\end{aligned}\n$$\n\nThen, we combine the like terms, simplifying the coefficients as much as possible.\n\n$$\n\\begin{aligned}(\\frac{5}{2}x+\\frac{7}{2}x)+(2-5) & = \\\\ (\\frac{5+7}{2})x+(-3) & = \\\\ \\frac{12}{2}x-3 & = \\\\ 6x-3 & .\\end{aligned}\n$$\n\nThus, the simplified expression is $6x-3.$" :tutorial/id #uuid "7ef8a0d2-a9fe-57f8-b3fc-7b69cbb3a818" :tutorial/math-academy-id 8040 :tutorial/title "Introduction"} :step/id #uuid "3cca408f-980b-5a63-a54c-03cd0d86a422" :step/math-academy-id 71207 :step/next {:db/id #edb/ref 17592186139487}} {:db/id #edb/ref 17592186139487 :step/content {:db/id #edb/ref 17592186138510 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138069 :question/id #uuid "e85da1d1-1cf3-547c-86ce-42329475fbdd" :question/math-academy-id "e-12835"} :knowledge-point/id #uuid "54498b47-9a43-5b4d-8bbf-806af5968829" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050311} {:db/id #edb/ref 17592186050452} {:db/id #edb/ref 17592186050833}] :knowledge-point/questions [{:db/id #edb/ref 17592186138716} {:db/id #edb/ref 17592186138809} {:db/id #edb/ref 17592186459206} {:db/id #edb/ref 17592186459226}] :knowledge-point/title "Simplifying Fractions with Like Denominators"} :step/id #uuid "24f9787a-6b3b-581b-a228-064feb6d711c" :step/math-academy-id 71208 :step/next {:db/id #edb/ref 17592186139488}} {:db/id #edb/ref 17592186139488 :step/content {:db/id #edb/ref 17592186138511 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138071 :question/id #uuid "53c1f7ca-bcaa-59e4-9929-0695b67621cb" :question/math-academy-id "e-12837"} :knowledge-point/id #uuid "75d096f5-9834-5e52-a7eb-9aae72398d19" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050131} {:db/id #edb/ref 17592186050637}] :knowledge-point/questions [{:db/id #edb/ref 17592186138816} {:db/id #edb/ref 17592186138817} {:db/id #edb/ref 17592186459205} {:db/id #edb/ref 17592186459293} {:db/id #edb/ref 17592186536857}] :knowledge-point/title "Simplifying Fractions with Unlike Denominators"} :step/id #uuid "aae03f7b-9f94-5281-8d40-eddd120590d8" :step/math-academy-id 71212 :step/next {:db/id #edb/ref 17592186139489}} {:db/id #edb/ref 17592186139489 :step/content {:db/id #edb/ref 17592186138512 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138070 :question/id #uuid "30cf0891-33d3-566c-8286-4c161f84c1dd" :question/math-academy-id "e-12836"} :knowledge-point/id #uuid "dec4e22a-5882-56d9-8e13-b18b4d22efdc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050599} {:db/id #edb/ref 17592186050908}] :knowledge-point/questions [{:db/id #edb/ref 17592186138760} {:db/id #edb/ref 17592186138779}] :knowledge-point/title "Using the Distributive Law With Fractions"} :step/id #uuid "1036460b-f34d-54e4-a730-f0b57e843495" :step/math-academy-id 71216 :step/next {:db/id #edb/ref 17592186139490}} {:db/id #edb/ref 17592186139490 :step/content {:db/id #edb/ref 17592186138513 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138072 :question/id #uuid "957b3102-6eb7-52d3-9299-54ed9bd4718e" :question/math-academy-id "e-12892"} :knowledge-point/id #uuid "e3e39a9d-1f97-54f2-a388-90c71c83b93e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050575}] :knowledge-point/questions [{:db/id #edb/ref 17592186138818} {:db/id #edb/ref 17592186139065} {:db/id #edb/ref 17592186459228} {:db/id #edb/ref 17592186459288}] :knowledge-point/title "Simplifying Expressions Using the Distributive Law"} :step/id #uuid "4e4a8574-0322-564e-8108-20569dba02f5" :step/math-academy-id 71219}] :activity/title "Simplifying Linear Expressions Containing Fractions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138596}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186139522} :activity/id #uuid "4e2e5333-ed8e-576e-abed-94cc93efbdb5" :activity/scope {:db/id #edb/ref 17592186049051 :topic/id #uuid "d5e55293-c14f-55db-a945-4aa2b42df552" :topic/math-academy-id 2310} :activity/steps [{:db/id #edb/ref 17592186139522 :step/content {:db/id #edb/ref 17592186139662 :tutorial/content "A **compound inequality** is an inequality that consists of multiple different inequalities put together. For example, the compound inequality \n\n$$\nx \\leq 0 \\hspace{.25cm} \\text{ or } \\hspace{.25cm} x \\gt  3\n$$\n\n states that $x$ is less than or equal to $0$, or greater than $3$.\n\nFor the compound \"or\" inequality to be satisfied, at least one of the separate inequalities must be satisfied. To illustrate:\n\n- $x=-1$ satisfies the inequality because it satisfies $x \\leq 0.$\n\n- $x=5$ satisfies the inequality because it satisfies $x > 3.$\n\n- $x=1$ does not satisfy the inequality because it does not satisfy $x \\leq 0$ and it also does not satisfy $x > 3.$\n\nTo graph a compound inequality involving the word \"or,\" we graph the two separate inequalities on the same number line. In this particular case,\n\n- the inequality $x \\leq 0$ consists of a closed circle at $0$ and an arrow to the left, while\n\n- the inequality $x >3$ consists of an open circle at $3$ and an arrow to the right.\n\nThe resulting graph is as follows:\n\n![](images/96/96f1b1ee25ebc210a83ba12d90396683b7e2660050f820c4057ab85de419db91.png)" :tutorial/id #uuid "770f70a7-6710-533c-bd9a-e37123e913bb" :tutorial/math-academy-id 8132 :tutorial/title "Introduction"} :step/id #uuid "73ffc612-4a54-5b2a-9949-3131ab4b5010" :step/math-academy-id 79780 :step/next {:db/id #edb/ref 17592186139523}} {:db/id #edb/ref 17592186139523 :step/content {:db/id #edb/ref 17592186138536 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138073 :question/id #uuid "014723fc-0b7d-5212-a41e-73847f5adb00" :question/math-academy-id "e-13011"} :knowledge-point/id #uuid "6090342d-3d4e-519f-ab7d-3fb6df6e92a8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050519}] :knowledge-point/questions [{:db/id #edb/ref 17592186138770} {:db/id #edb/ref 17592186139089} {:db/id #edb/ref 17592186447251} {:db/id #edb/ref 17592186481665}] :knowledge-point/title "Representing \"Or\" Inequalities on Number Lines"} :step/id #uuid "1d905dee-c60b-587c-8b1e-96a234f4883a" :step/math-academy-id 79781 :step/next {:db/id #edb/ref 17592186139524}} {:db/id #edb/ref 17592186139524 :step/content {:db/id #edb/ref 17592186138537 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138075 :question/id #uuid "e5b6a9dc-3a19-5496-9e22-d953ff4eb647" :question/math-academy-id "e-13018"} :knowledge-point/id #uuid "32daa2fb-e5fa-5e44-b6f2-5d815d9145af" :knowledge-point/questions [{:db/id #edb/ref 17592186138848} {:db/id #edb/ref 17592186139090} {:db/id #edb/ref 17592186447247} {:db/id #edb/ref 17592186447252} {:db/id #edb/ref 17592186491986} {:db/id #edb/ref 17592186534083} {:db/id #edb/ref 17592186536851}] :knowledge-point/title "Identifying \"Or\" Inequalities Given on Number Lines"} :step/id #uuid "bcf79e23-3398-56f2-9f7c-6dddc11d8b32" :step/math-academy-id 79784 :step/next {:db/id #edb/ref 17592186139525}} {:db/id #edb/ref 17592186139525 :step/content {:db/id #edb/ref 17592186139663 :tutorial/content "Compound inequalities can also be written with the word \"and.\" However, such inequalities are often written together as a single expression with two inequality signs. For example, the compound inequality \n\n$$\n-4 \\leq x < -1\n$$\n\n means that $-4 \\leq x$ and $x < -1.$\n\nFor the compound \"and\" inequality to be satisfied, both of the separate inequalities must be satisfied. To illustrate:\n\n- $x=-3$ satisfies the inequality because it satisfies both $-4 \\leq x$ and $x < -1.$\n\n- $x=-5$ does not satisfy the inequality because it does not satisfy $-4 \\leq x.$\n\n- $x=0$ does not satisfy the inequality because it does not satisfy $x < -1.$\n\nTo graph this compound inequality, we first graph the two inequalities separately.\n\n![](images/42/42edf8ee61badbbd1e5525a3843cfbe189e6432b2ad06455c1bdca6a7087ac56.png)\n\nThen, we keep only where they overlap.\n\n![](images/fa/fa07233f96bed30ddfcc5905a55a835763359cd34188e4d1c249c13b1d27d25c.png)\n\n**Note:** Any compound \"and\" inequality will always represent a segment between two points. So, it is not always necessary to draw both inequalities and find the overlap. To speed up the process, we can just draw the endpoints with open or closed circles as appropriate, and highlight the area between the endpoints." :tutorial/id #uuid "9859e4f2-2267-558c-923f-35c348957ad9" :tutorial/math-academy-id 8133 :tutorial/title "Compound \"And\" Inequalities"} :step/id #uuid "59dbf0dd-b3a9-5867-8cbf-3b28624f9ad9" :step/math-academy-id 79788 :step/next {:db/id #edb/ref 17592186139526}} {:db/id #edb/ref 17592186139526 :step/content {:db/id #edb/ref 17592186138538 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138074 :question/id #uuid "21eace75-0b5a-5b37-903c-c238e3821bee" :question/math-academy-id "e-13012"} :knowledge-point/id #uuid "9106723c-b8b0-586e-8c2b-9bb4f50bc945" :knowledge-point/questions [{:db/id #edb/ref 17592186138765} {:db/id #edb/ref 17592186138847} {:db/id #edb/ref 17592186447250} {:db/id #edb/ref 17592186492061}] :knowledge-point/title "Representing \"And\" Inequalities on Number Lines"} :step/id #uuid "7e38370d-1c18-5d27-bb22-cf9444dd1b90" :step/math-academy-id 79789 :step/next {:db/id #edb/ref 17592186139527}} {:db/id #edb/ref 17592186139527 :step/content {:db/id #edb/ref 17592186138539 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138076 :question/id #uuid "347520ff-e759-5d99-acf7-0bc8a8f26689" :question/math-academy-id "e-13019"} :knowledge-point/id #uuid "a707a741-0208-5a74-8478-ac05ff2673ab" :knowledge-point/questions [{:db/id #edb/ref 17592186138766} {:db/id #edb/ref 17592186138776} {:db/id #edb/ref 17592186447248} {:db/id #edb/ref 17592186447249} {:db/id #edb/ref 17592186492032}] :knowledge-point/title "Identifying \"And\" Inequalities Given on Number Lines"} :step/id #uuid "40b2748c-2bc7-5064-b788-ba5145c312f9" :step/math-academy-id 79793}] :activity/title "Compound Inequalities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138614}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186492094} :activity/id #uuid "9814bdeb-c5c1-549b-8942-0dcd8592f0fd" :activity/scope {:db/id #edb/ref 17592186049051 :topic/id #uuid "d5e55293-c14f-55db-a945-4aa2b42df552" :topic/math-academy-id 2310} :activity/steps [{:db/id #edb/ref 17592186492079 :step/content {:db/id #edb/ref 17592186492061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03910583-d566-5a8b-bfc2-8972fe3ecdd6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f6/f6139cea308db19681b8e2239e01f77d4af406a728041aa738b29ee3ce6a603e.png" :db/id #edb/ref 17592186491454} {:answer/id #uuid "7b650c21-47ed-5214-a59e-48d2075d1b3f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/90/901ffc463b1516e30690f41af6225c62a1a3cc3950bc34e28bc5b13ae7314b28.png" :db/id #edb/ref 17592186491672} {:answer/id #uuid "8698ddac-ea80-50d9-9ad8-a8742ba97aef" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/24/2415d02b1c88fbeb254f41d3540b81e20be8fb94da400b77fabca65e40da3b8c.png" :db/id #edb/ref 17592186491685} {:answer/id #uuid "97ae2684-9fda-5d9f-bda1-046e9cd84f79" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6f/6fa6ef603a454d9f219ca5967a87a99cc8afabc30105d36879c172b8385fd36b.png" :db/id #edb/ref 17592186491718} {:answer/id #uuid "ad0ec700-72a5-535a-a4a1-e48679183f05" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/49/496986cb7dca8bffb2d2856f3867e48d794f106139d4703e1b2166d9a223781d.png" :db/id #edb/ref 17592186491756}] :answer-field/correct {:db/id #edb/ref 17592186491454} :answer-field/id #uuid "d9c1885b-25c3-55b9-8caf-90ff3bd587c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491970}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d2934ac4-af1a-5b63-bae8-4d35ad544ba0" :question/math-academy-id "q-54810" :question/problem "Which of the following number lines represents the inequality $-3<x<1?$" :question/worked-solution "The inequality $-3<x<1$ means that $x$ can take any value greater than $-3,$ and less than $1.$\n\nTo represent this on a number line, we draw an open circle at $-3$ and another open circle at $1.$ Then, we highlight the region between the points.\n\n![](images/f6/f6139cea308db19681b8e2239e01f77d4af406a728041aa738b29ee3ce6a603e.png)"} :step/id #uuid "1a122adf-7490-5a96-86fc-64fdc36ac5fa" :step/next {:db/id #edb/ref 17592186492092}} {:db/id #edb/ref 17592186492092 :step/content {:db/id #edb/ref 17592186491986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0158d2c2-46e2-511e-9829-663aca526316" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x\\le -1$ or $x\\ge 1$" :db/id #edb/ref 17592186491450} {:answer/id #uuid "2fd0b12d-c6d3-5074-bd89-cbaa31e2e2ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x<-1$ or $x>1$" :db/id #edb/ref 17592186491548} {:answer/id #uuid "3f38c2dd-7e7e-5407-9e8b-c247c54b9afc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x>-1$ or $x>1$" :db/id #edb/ref 17592186491579} {:answer/id #uuid "7853872b-6305-5952-a1e3-1e4da4e83d64" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x<-1$ or $x<1$" :db/id #edb/ref 17592186491663} {:answer/id #uuid "a7ce2a8a-1854-5692-8ab6-ce6a4ef7ea6e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x\\ge -1$ or $x\\le 1$" :db/id #edb/ref 17592186491747}] :answer-field/correct {:db/id #edb/ref 17592186491548} :answer-field/id #uuid "81599ce3-b5fd-5790-a91f-aa92a6b6fa9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491931}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "087d9e13-8fc3-51e2-a62c-c006b17d535f" :question/math-academy-id "q-54820" :question/problem "![](images/f2/f2fc2248ce56cd8209d9f6438d24c7f9e9f805f320ef5549be25282cfbaa6e61.png)\n\nWhich inequality corresponds to the highlighted region shown on the number line above?" :question/worked-solution "The red rays contain all values less than  $-1$ or greater than $1.$ In addition,\n\n- the open circle at $-1$ implies that $x$ cannot be equal to $-1,$ and\n\n- the open circle at $1$ implies that $x$ cannot be equal to $1.$\n\nTherefore, the highlighted region represents $x<-1$ or $x>1.$"} :step/id #uuid "471f4a51-0ae6-5b3b-b0f1-91ebb382a932"} {:db/id #edb/ref 17592186492094 :step/content {:db/id #edb/ref 17592186492032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05fd7dc9-4b77-586d-9ed5-f96227aed75b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x<2" :db/id #edb/ref 17592186491463} {:answer/id #uuid "1b458bce-037d-59e4-a297-afaa3a6e5449" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x\\le 2" :db/id #edb/ref 17592186491508} {:answer/id #uuid "5101b5ff-6f7e-5771-aeaf-1f3ea7c2baa6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\le x\\le 2" :db/id #edb/ref 17592186491607} {:answer/id #uuid "9bb5ca05-d4de-59e6-8172-825f719298fb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x\\le 2$ or $x\\ge -2$" :db/id #edb/ref 17592186491722} {:answer/id #uuid "f6121d20-e884-5a07-9ef4-25a31648abf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\le x<2" :db/id #edb/ref 17592186491875}] :answer-field/correct {:db/id #edb/ref 17592186491607} :answer-field/id #uuid "9deac3f0-5baf-51d6-9fda-87f6599c1dbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186491947}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8a1c7bea-76d1-5380-abbc-23d155edc522" :question/math-academy-id "q-28797" :question/problem "![](images/67/67c1fa5db66f96b6bbbccacf251f3cdc655fc88a6b87499234f4b1cd0a21da1d.png)\n\nWhich inequality corresponds to the highlighted region shown on the number line above?" :question/worked-solution "The red segment contains all values between  $-2$ and $2.$\n\n- the closed circle at $-2$ implies that $x$ can be equal to $-2,$ while\n\n- the closed circle at $2$ implies that $x$ can be equal to $2.$\n\nTherefore, the highlighted region represents $-2\\le x\\le 2.$"} :step/id #uuid "5ec340ac-62fa-5a0a-99de-ca8554313a1d" :step/next {:db/id #edb/ref 17592186492079}}] :activity/title "Compound Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186491445}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111763} :activity/id #uuid "cceda887-69b2-551b-ab27-e3d019c77f5a" :activity/scope {:db/id #edb/ref 17592186049068 :topic/id #uuid "d78ca6bb-945f-51db-a4af-fc777024df22" :topic/math-academy-id 1459} :activity/steps [{:db/id #edb/ref 17592186111598 :step/content {:db/id #edb/ref 17592186111900 :tutorial/content "We can organize all mentioned types of quadrilaterals into the following hierarchy diagram:\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nEach shape below another is a specific type of the one above it. For example, every square is a rectangle, and every rectangle is a parallelogram. This means every square is also a parallelogram." :tutorial/id #uuid "d9d3be2f-753b-5a4b-9f26-20b34ab8f89a" :tutorial/math-academy-id 5931 :tutorial/title "Classifying Quadrilaterals"} :step/id #uuid "eab37537-55a4-56e5-9fd6-7ee823f295bb" :step/math-academy-id 36207 :step/next {:db/id #edb/ref 17592186111765}} {:db/id #edb/ref 17592186111763 :step/content {:db/id #edb/ref 17592186111845 :tutorial/content "There are lots of different types of quadrilaterals. Let's look at some examples.\n\n- A **trapezoid** is a quadrilateral with exactly ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) pair of opposite sides that are parallel to each other. \nThe parallel sides are called the **bases**. The other two sides are called the **legs**.\n\n![](images/9f/9fa09c46a2119d35c796065a696954931e20062fd5b3677a5484bef92bc2b0d8.png)\n\n- An **isosceles trapezoid** is a  trapezoid with congruent legs.\n\n![](images/b6/b6b2b2012c1d724f9da8b23551ec4f978f190d86875d7db7a3074635d7f40c02.png)\n\n- A **parallelogram** is a quadrilateral with ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) pairs of parallel sides.\n\n \n\n![](images/5d/5d0f383f3510f54b415a7ab99ef52fb30270924f97b8afec59534a96cd3edcef.png)\n\n Opposite sides and opposite angles of a parallelogram are always congruent. Moreover, if a quadrilateral has ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) pairs of opposite congruent sides or  ![](images/f5/f5f3224583db57b9cfe323c8489ef5e5271000002b5ea253eb98fd067a858b2d.svg) pairs of opposite congruent angles, it is always a parallelogram.\n\n![](images/39/39ccf26333785f9ef47eed68a96bc40005a6ba025fdb6e250beefe14f10b043d.png)\n\n- A **rectangle** is a parallelogram where all angles are right.\n\n \n\n![](images/55/55a16e0ba93bf1f01d576cca558805aaea9631d1fa8e43b149509d4f8eb4c834.png)\n\n A rectangle where all sides are congruent is a **square**.\n\n![](images/a0/a04b2a0e86be8b085c5e3fc906d5aa66dfea45c033d52cd4746031202a7d427d.png)\n\n- A **rhombus** is a parallelogram where all sides are congruent. The opposite angles of a rhombus are also congruent.\n\n![](images/d3/d3588d7cbe8f285198df3909df3c03fdec04f53a3f75769e46a0ab4283fa27b3.png)\n\n A rhombus where all angles are congruent is a **square**.\n\n \n\n![](images/94/941872050d5407bcd9cb532e318276adccff802230ed854a2d292666fc0096fc.png)\n\n- A **kite** is a quadrilateral with two pairs of congruent sides that are adjacent to each other.\n\n![](images/11/116e323d81ee190c0f69b4d7cdcefe9f0952da883b0d6d3c6d4036119794baa7.png)" :tutorial/id #uuid "06a11fa2-5911-52f5-9a6d-1028e49b44dd" :tutorial/math-academy-id 2262 :tutorial/title "Introduction"} :step/id #uuid "04c2712b-f67a-5317-b34e-8936b6acdd9c" :step/math-academy-id 9452 :step/next {:db/id #edb/ref 17592186111598}} {:db/id #edb/ref 17592186111765 :step/content {:db/id #edb/ref 17592186110776 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110405 :question/id #uuid "515ab620-8513-55cc-8c88-61c0ad27aff2" :question/math-academy-id "e-2833"} :knowledge-point/id #uuid "00889b75-3745-52f6-9157-912846482689" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048723} {:db/id #edb/ref 17592186049584}] :knowledge-point/questions [{:db/id #edb/ref 17592186111260} {:db/id #edb/ref 17592186111261} {:db/id #edb/ref 17592186446849} {:db/id #edb/ref 17592186446853} {:db/id #edb/ref 17592186536886}] :knowledge-point/title "Describing a Quadrilateral"} :step/id #uuid "4f398499-a037-5d65-8f25-ecbcfa7534c2" :step/math-academy-id 9454 :step/next {:db/id #edb/ref 17592186111767}} {:db/id #edb/ref 17592186111767 :step/content {:db/id #edb/ref 17592186110777 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110406 :question/id #uuid "ee3a028c-93df-5e5a-bc06-4c286a5e1839" :question/math-academy-id "e-2834"} :knowledge-point/id #uuid "c81cf5ed-8dd7-5174-b8e9-faf63bf0a278" :knowledge-point/questions [{:db/id #edb/ref 17592186111263} {:db/id #edb/ref 17592186111264} {:db/id #edb/ref 17592186446851} {:db/id #edb/ref 17592186446852} {:db/id #edb/ref 17592186506540} {:db/id #edb/ref 17592186531582}] :knowledge-point/title "Identifying a Quadrilateral"} :step/id #uuid "14f9869d-2b87-58dd-a3bd-3dfd6047425b" :step/math-academy-id 9459 :step/next {:db/id #edb/ref 17592186111768}} {:db/id #edb/ref 17592186111768 :step/content {:db/id #edb/ref 17592186110778 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110408 :question/id #uuid "a7b82dde-36fc-582e-9ed6-fbfcfbf8b47c" :question/math-academy-id "e-2839"} :knowledge-point/id #uuid "34ed7bcd-3c06-592e-906c-5010e80370db" :knowledge-point/questions [{:db/id #edb/ref 17592186111262} {:db/id #edb/ref 17592186111266} {:db/id #edb/ref 17592186446850} {:db/id #edb/ref 17592186506515} {:db/id #edb/ref 17592186506571} {:db/id #edb/ref 17592186536811} {:db/id #edb/ref 17592186536834}] :knowledge-point/title "Identifying True Statements About Quadrilaterals"} :step/id #uuid "615b803e-ca7c-56d1-9167-9829ed84b5c5" :step/math-academy-id 9460}] :activity/title "Classifying Quadrilaterals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110831}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186506608} :activity/id #uuid "0fada08e-9ee8-50a7-a281-27eecc4451e2" :activity/scope {:db/id #edb/ref 17592186049068 :topic/id #uuid "d78ca6bb-945f-51db-a4af-fc777024df22" :topic/math-academy-id 1459} :activity/steps [{:db/id #edb/ref 17592186506608 :step/content {:db/id #edb/ref 17592186506515 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04cd6f91-4830-5fb2-a760-6d1458397aff" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186505925} {:answer/id #uuid "3cb14bc8-1566-5a66-a92e-6847a87ef3a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186506011} {:answer/id #uuid "40c8a717-049b-5524-b555-5e7634dfb774" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186506019} {:answer/id #uuid "6b6d04c0-fedf-5f99-93ce-81d660f42b3b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186506097} {:answer/id #uuid "9f2a5be0-7fd3-5d96-a0c9-2797fdcde248" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186506194}] :answer-field/correct {:db/id #edb/ref 17592186506011} :answer-field/id #uuid "b73d6aaf-8b71-5986-9a72-f3f8cba064c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506464}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "16005fe9-c0e8-5807-8dbf-172a83d89558" :question/math-academy-id "q-53062" :question/problem "Which of the following statements are true?\n\nI. A square is sometimes not a rectangle.\n\nII. A rectangle is always a quadrilateral.\n\nIII. A square is never a rhombus." :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nLet's now look at each statement in turn.\n\n- Statement I is false. In a rectangle, its four angles are right angles. The same is true for a square. A square is a specific type of rectangle, where the four angles are right angles and the four sides are congruent.\n\n- Statement II is true. A rectangle is always a quadrilateral because it has four sides.\n\n- Statement III is false. A rhombus is a parallelogram where all sides are congruent. A square is a specific type of rhombus, where the four angles are right angles and the four sides are congruent.\n\nIn conclusion, only statement II is true."} :step/id #uuid "1472f937-314f-5429-8263-e1a67f2a5b4d" :step/next {:db/id #edb/ref 17592186506644}} {:db/id #edb/ref 17592186506644 :step/content {:db/id #edb/ref 17592186506571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "015f0057-b143-57ad-8fa5-2978f72ea3dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186505914} {:answer/id #uuid "1afb074a-342e-57b7-b473-fffc06924988" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186505957} {:answer/id #uuid "555289bb-109d-55d5-955e-bed2ff4c8443" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186506057} {:answer/id #uuid "92f03582-9a2a-59ce-8ac4-d6529d374b33" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186506160} {:answer/id #uuid "e905ed52-46a6-5b4b-9ca4-e3a4bea9ebdc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186506337}] :answer-field/correct {:db/id #edb/ref 17592186506160} :answer-field/id #uuid "38a2df37-5f07-59b3-9c74-e390691ea42b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506405}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "978998ae-c2d1-5709-a415-cc49252cea0c" :question/math-academy-id "q-53063" :question/problem "Which of the following statements are true?\n\nI. A parallelogram is sometimes a rectangle.\n\nII. A kite is never a quadrilateral.\n\nIII. A square is always a trapezoid." :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nLet's now look at each statement in turn.\n\n- Statement I is true. A parallelogram is a rectangle when all the angles are right.\n\n- Statement II is false. A kite is always a quadrilateral because it has four sides.\n\n- Statement III is false. A trapezoid has only $1$ pair of opposite sides that are parallel. However, in a square, $2$ pairs of opposite sides are parallel, and so doesn't fit the definition of a trapezoid.\n\nIn conclusion, only statement I is true."} :step/id #uuid "a7b19881-e4d4-5ce2-a2db-ec80491290b8" :step/next {:db/id #edb/ref 17592186506648}} {:db/id #edb/ref 17592186506648 :step/content {:db/id #edb/ref 17592186506540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c5ff65a-e0ad-54f7-95cd-72299fae692b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186506101} {:answer/id #uuid "ab8a2580-e988-59db-b88f-bdf851f5dff2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$R$ only" :db/id #edb/ref 17592186506224} {:answer/id #uuid "dabfe65d-e001-5f6f-8eae-84c4f049a38c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$S$ only" :db/id #edb/ref 17592186506304} {:answer/id #uuid "f6b01984-7aec-5b99-b309-32e1700f88cf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$ only" :db/id #edb/ref 17592186506364} {:answer/id #uuid "faa76e22-ab2a-5e2f-b51a-88f71d4a4169" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ only" :db/id #edb/ref 17592186506371}] :answer-field/correct {:db/id #edb/ref 17592186506364} :answer-field/id #uuid "7c39ae96-03b7-5d75-924b-50c66d2fd7a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506435}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4ee12482-99b3-5022-8d03-b6e6abfce44f" :question/math-academy-id "q-74591" :question/problem "![](images/e3/e3708d7723606224e201147b432250dd759022fd7ed275dabebf51935d68d8f8.png)\n\nWhich of the figures above is a rhombus?" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a rhombus is a parallelogram where all sides are congruent.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is a rectangle. The sides are not all congruent, so it is not a rhombus.\n\n- The shape $Q$ is a square. All its sides are congruent and the opposite sides are parallel, so it is a rhombus.\n\n- The shape $R$ is a trapezoid. Since it has only one pair of parallel sides, it is not a rhombus.\n\n- The shape $S$ is an isosceles trapezoid.  Since it has only one pair of parallel sides, it is not a rhombus.\n\nTherefore, shape $Q$ is a rhombus. The shapes $P,$ $R,$ and $S$ are not rhombuses."} :step/id #uuid "b98f15bb-0b73-5666-9f9e-51644b2b10be"}] :activity/title "Classifying Quadrilaterals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505900}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186536948} :activity/id #uuid "5011f029-40b3-50ae-adc7-c8594e763c6a" :activity/scope {:db/id #edb/ref 17592186049068 :topic/id #uuid "d78ca6bb-945f-51db-a4af-fc777024df22" :topic/math-academy-id 1459} :activity/steps [{:db/id #edb/ref 17592186536917 :step/content {:db/id #edb/ref 17592186111263 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8113f0c1-13bf-5ab2-9884-6d72597b1b88" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$Q$ and $S$ only" :db/id #edb/ref 17592186109304} {:answer/id #uuid "8a8d835d-c354-5c3b-ad6e-6b19f2da5a27" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$R$ only" :db/id #edb/ref 17592186109305} {:answer/id #uuid "bee1b7de-ab86-59bc-81ce-c2ecde07ae92" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186109306} {:answer/id #uuid "2aa8a596-87e0-598e-9105-9841f4e811d8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ only" :db/id #edb/ref 17592186109307} {:answer/id #uuid "44b7bf2b-d86f-5d31-82a9-bbadefe43231" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186109308}] :answer-field/correct {:db/id #edb/ref 17592186109308} :answer-field/id #uuid "e044e866-6811-5b05-95ac-6974da60d777" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186109303}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5b35d665-09e4-54b3-8c80-68318024b0ef" :question/math-academy-id "q-53035" :question/problem "![](images/70/702edb8e1ea4a79ea12e891ed3874c36ff3e6628c9cb000753f74ca7bc35ec74.png)\n\nWhich of the figures above is a parallelogram?" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nRemember that a parallelogram is a quadrilateral with $2$ pairs of parallel sides.\n\nWith that in mind, let's look at each shape in turn.\n\n- The shape $P$ is a rectangle. Therefore, its opposite sides are parallel, so it is a parallelogram.\n\n- The shape $Q$ is a kite. It has a pair of opposite sides that are not parallel, therefore, it is not a parallelogram.\n\n- The shape $R$ is a rhombus. Since the opposite sides of a rhombus are parallel, it is a parallelogram.\n\n- The shape $S$ is a trapezoid. It has only one pair of parallel sides, therefore, it is not a parallelogram.\n\nTherefore, shapes $P$ and $R$ are parallelograms. The shapes $Q$ and $S$ are not parallelograms."} :step/id #uuid "2cfe7fe6-dfad-5186-856c-597f87ad3a5e"} {:db/id #edb/ref 17592186536937 :step/content {:db/id #edb/ref 17592186536834 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48305576-11d5-5617-960a-a3990bcb7dca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186536394} {:answer/id #uuid "5af8d66e-d7ec-5f20-b9b6-13fb2ff0d05e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186536443} {:answer/id #uuid "bfbf47b7-c34e-5794-aa4d-102f253c4306" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186536584} {:answer/id #uuid "f2464b38-1ef3-59d6-af91-e21eb614b53f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186536670} {:answer/id #uuid "f5b0cf17-65c2-51ce-89a4-44437b972a52" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186536677}] :answer-field/correct {:db/id #edb/ref 17592186536443} :answer-field/id #uuid "ec71a978-52b7-54a3-b5fa-ef72f160c9d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536797}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "55788c3c-c1d0-5ef8-8ff4-5e5fd3b4c618" :question/math-academy-id "q-53012" :question/problem "![](images/4e/4e20dca5a916c43e93dd94b92ff4c1949a111537a8cb2e45b9ca0be7e2300f40.png)\n\nWhich of the following statements are true regarding the square above?\n\nI. $AB=BC=CD=AD.$\n\nII. $m∠ABC=m∠ADC.$\n\nIII. $\\overset{―}{AD}$ is parallel to $\\overset{―}{BC}.$" :question/worked-solution "Let's look at each statement in turn.\n\n- Statement I is true. A square is a rectangle where all sides are congruent, hence $AB=BC=CD=AD.$\n\n- Statement II is true. The angles in a square are all right. Therefore, $m∠ABC={90}^{∘}=m∠ADC.$\n\n- Statement III is true. Opposite sides of a square are parallel, and $\\overset{―}{AD}$ is opposite $\\overset{―}{BC},$ therefore $\\overset{―}{AD}$ is parallel to $\\overset{―}{BC}.$\n\nIn conclusion, statements I, II, and III are true."} :step/id #uuid "6b24c0db-50fd-51da-9580-556fff1c0632" :step/next {:db/id #edb/ref 17592186536917}} {:db/id #edb/ref 17592186536948 :step/content {:db/id #edb/ref 17592186536811 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24387f91-25bf-5714-8675-ef415eba960e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186536337} {:answer/id #uuid "28dbcf41-1538-5429-b8d5-50fbfa182de1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None" :db/id #edb/ref 17592186536344} {:answer/id #uuid "8d7da163-a580-5e50-a38f-f8e138ef74c7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186536510} {:answer/id #uuid "edec2c50-c3f2-5ae9-9a96-0ba69435f615" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186536661} {:answer/id #uuid "f02da5b5-90ef-5511-90c7-04d4ca4bf833" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186536664}] :answer-field/correct {:db/id #edb/ref 17592186536510} :answer-field/id #uuid "6a514638-3f19-527b-a1de-1e926b7c8285" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536750}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "13987c3a-59aa-55ed-8fe6-1cb169d96b89" :question/math-academy-id "q-53009" :question/problem "![](images/1b/1b0dd854ae2edb38245466049806c7e93bb4b704a03284905d968869fa1b4146.png)\n\nWhich of the following statements are true regarding the kite above?\n\nI. $AB=AD.$\n\nII. The kite has a pair of congruent opposite angles.\n\nIII. $AB=BC=CD=AD.$" :question/worked-solution "Let's look at each statement in turn.\n\n- Statement I is true. A kite is a quadrilateral with two pairs of congruent sides that are adjacent to each other. In the figure, we can see that $AB=AD.$\n\n- Statement II is true. A kite always has a pair of congruent opposite angles.\n\n- Statement III is false. A kite is a quadrilateral with two pairs of congruent sides that are adjacent to each other. However, not all sides are congruent, for instance, $AB\\ne BC.$\n\nIn conclusion, statements I and II are true."} :step/id #uuid "866cff26-8806-5fb7-acaa-154a2dd5266d" :step/next {:db/id #edb/ref 17592186536937}}] :activity/title "Classifying Quadrilaterals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186536273}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186097538} :activity/id #uuid "1b2432bc-44f8-5039-b360-0a329be037b5" :activity/scope {:db/id #edb/ref 17592186049355 :topic/id #uuid "ee459d83-61aa-5856-8bac-7a5980791833" :topic/math-academy-id 1131} :activity/steps [{:d