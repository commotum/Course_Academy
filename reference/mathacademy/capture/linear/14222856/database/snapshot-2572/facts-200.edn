#{[17592186104986 #edb/ref 1075 #edb/ref 17592186104987 #edb/ref 17592186045417] [17592186104986 #edb/ref 1075 #edb/ref 17592186104988 #edb/ref 17592186045417] [17592186104986 #edb/ref 1075 #edb/ref 17592186104989 #edb/ref 17592186045417] [17592186104986 #edb/ref 1075 #edb/ref 17592186104990 #edb/ref 17592186045417] [17592186104986 #edb/ref 1075 #edb/ref 17592186104991 #edb/ref 17592186045417] [17592186104986 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186104986 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186104986 #edb/ref 1078 #edb/ref 17592186104988 #edb/ref 17592186045417] [17592186104986 #edb/ref 1079 #uuid "b9230a8b-5c46-59a1-bb96-933a3909004f" #edb/ref 17592186045417] [17592186104987 #edb/ref 1080 "\\frac{1}{7}" #edb/ref 17592186045417] [17592186104987 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186104987 #edb/ref 1083 #uuid "9f287d7b-8e45-585a-98fa-28040508099a" #edb/ref 17592186045417] [17592186104988 #edb/ref 1080 "\\frac{1}{49}" #edb/ref 17592186045417] [17592186104988 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186104988 #edb/ref 1083 #uuid "ce55da7f-50bc-50e1-97d4-2fb77506d6e6" #edb/ref 17592186045417] [17592186104989 #edb/ref 1080 "-\\frac{1}{14}" #edb/ref 17592186045417] [17592186104989 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186104989 #edb/ref 1083 #uuid "f9e6c57d-980f-5bf5-abe5-039788ff6f9a" #edb/ref 17592186045417] [17592186104990 #edb/ref 1080 "-\\frac{1}{7}" #edb/ref 17592186045417] [17592186104990 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186104990 #edb/ref 1083 #uuid "3a096c69-a948-55c4-b1f3-408814661ef8" #edb/ref 17592186045417] [17592186104991 #edb/ref 1080 "-\\frac{1}{49}" #edb/ref 17592186045417] [17592186104991 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186104991 #edb/ref 1083 #uuid "4f053517-545a-56dd-a930-55fa0e6815e1" #edb/ref 17592186045417] [17592186105742 #edb/ref 10