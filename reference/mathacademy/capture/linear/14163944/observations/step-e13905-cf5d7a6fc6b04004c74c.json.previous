0\"></use>\n <use xlink:href=\"#E3-MJMAIN-35\" x=\"1334\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMATHI-79\" x=\"1834\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-2B\" x=\"2554\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-31\" x=\"3555\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-2212\" x=\"4277\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-35\" x=\"5278\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMATHI-79\" x=\"5778\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-1853)\">\n <use xlink:href=\"#E3-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-31\" x=\"1334\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>Notice that all terms containing <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.155ex\" height=\"2.009ex\" style=\"vertical-align: -0.671ex;\" viewBox=\"0 -576.1 497.5 865.1\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-4-Title\">\n<title id=\"MathJax-SVG-4-Title\">y</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E4-MJMATHI-79\" d=\"M21 287Q21 301 36 335T84 406T158 442Q199 442 224 419T250 355Q248 336 247 334Q247 331 231 288T198 191T182 105Q182 62 196 45T238 27Q261 27 281 38T312 61T339 94Q339 95 344 114T358 173T377 247Q415 397 419 404Q432 431 462 431Q475 431 483 424T494 412T496 403Q496 390 447 193T391 -23Q363 -106 294 -155T156 -205Q111 -205 77 -183T43 -117Q43 -95 50 -80T69 -58T89 -48T106 -45Q150 -45 150 -87Q150 -107 138 -122T115 -142T102 -147L99 -148Q101 -153 118 -160T152 -167H160Q177 -167 186 -165Q219 -156 247 -127T290 -65T313 -9T321 21L315 17Q309 13 296 6T270 -6Q250 -11 231 -11Q185 -11 150 11T104 82Q103 89 103 113Q103 170 138 262T173 379Q173 380 173 381Q173 390 173 393T169 400T158 404H154Q131 404 112 385T82 344T65 302T57 280Q55 278 41 278H27Q21 284 21 287Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E4-MJMATHI-79\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> are on the left-hand side, and all terms independent of <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.155ex\" height=\"2.009ex\" style=\"vertical-align: -0.671ex;\" viewBox=\"0 -576.1 497.5 865.1\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-5-Title\">\n<title id=\"MathJax-SVG-5-Title\">y</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E5-MJMATHI-79\" d=\"M21 287Q21 301 36 335T84 406T158 442Q199 442 224 419T250 355Q248 336 247 334Q247 331 231 288T198 191T182 105Q182 62 196 45T238 27Q261 27 281 38T312 61T339 94Q339 95 344 114T358 173T377 247Q415 397 419 404Q432 431 462 431Q475 431 483 424T494 412T496 403Q496 390 447 193T391 -23Q363 -106 294 -155T156 -205Q111 -205 77 -183T43 -117Q43 -95 50 -80T69 -58T89 -48T106 -45Q150 -45 150 -87Q150 -107 138 -122T115 -142T102 -147L99 -148Q101 -153 118 -160T152 -167H160Q177 -167 186 -165Q219 -156 247 -127T290 -65T313 -9T321 21L315 17Q309 13 296 6T270 -6Q250 -11 231 -11Q185 -11 150 11T104 82Q103 89 103 113Q103 170 138 262T173 379Q173 380 173 381Q173 390 173 393T169 400T158 404H154Q131 404 112 385T82 344T65 302T57 280Q55 278 41 278H27Q21 284 21 287Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E5-MJMATHI-79\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> are on the right-hand side.</p>\n<p>Next, we factor out <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.155ex\" height=\"2.009ex\" style=\"vertical-align: -0.671ex;\" viewBox=\"0 -576.1 497.5 865.1\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-6-Title\">\n<title id=\"MathJax-SVG-6-Title\">y</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E6-MJMATHI-79\" d=\"M21 287Q21 301 36