#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186572235} :activity/id #uuid "3e972de8-bdbd-5deb-80d5-de1b7fa35350" :activity/scope {:db/id #edb/ref 17592186049235 :topic/id #uuid "e5a9189d-c52f-5fc0-b562-b787ed5b5ba1" :topic/math-academy-id 599} :activity/steps [{:db/id #edb/ref 17592186572212 :step/content {:db/id #edb/ref 17592186572173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae8dd84-1056-5afc-bdc6-13595c3ec750" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5(a+b)}}{5(a+b)}" :db/id #edb/ref 17592186571559} {:answer/id #uuid "0f075ce4-fb79-5eda-ae39-63d67635fa33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5(a+b)}" :db/id #edb/ref 17592186571564} {:answer/id #uuid "5ddd2e2e-8471-56e7-a9d7-6310c3988ee4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{a+b}}{5(a+b)}" :db/id #edb/ref 17592186571700} {:answer/id #uuid "a26f3e02-92d3-5d1f-b928-01b20bb52ebf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5(a+b)}}{a+b}" :db/id #edb/ref 17592186571820} {:answer/id #uuid "b1dd8cac-e702-5ca8-9e50-f2b488451c81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\sqrt{a+b}}{a+b}" :db/id #edb/ref 17592186571849}] :answer-field/correct {:db/id #edb/ref 17592186571820} :answer-field/id #uuid "39c3806c-d499-553b-a0be-7c5643b8cfe0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572006}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bb598f6a-4308-50e9-9232-77329f4110cd" :question/math-academy-id "q-111061" :question/problem "Express $\\sqrt{\\frac{5}{a+b}}\\,$ without radicals in the denominator." :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{5}{a+b}} & =\\frac{\\sqrt{5}}{\\sqrt{a+b}}\\end{aligned}\n$$\n\nTo remove the radical $\\sqrt{a+b}$ from the denominator, we multiply both the numerator and denominator by $\\sqrt{a+b}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{5}}{\\sqrt{a+b}} & = \\\\ \\frac{\\sqrt{5}}{\\sqrt{a+b}}\\cdot \\frac{\\sqrt{a+b}}{\\sqrt{a+b}} & = \\\\ \\frac{\\sqrt{5}\\cdot \\sqrt{a+b}}{\\sqrt{a+b}\\cdot \\sqrt{a+b}} & = \\\\ \\frac{\\sqrt{5(a+b)}}{(\\sqrt{a+b})^{2}} & = \\\\ \\frac{\\sqrt{5(a+b)}}{a+b} & \\end{aligned}\n$$"} :step/id #uuid "1b0a9667-11fa-5264-a52b-4744b8cfa717"} {:db/id #edb/ref 17592186572235 :step/content {:db/id #edb/ref 17592186078874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fece18e-f320-5a76-b295-3c64b645336c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{x^{2} - 1}}{x - 1}" :db/id #edb/ref 17592186076023} {:answer/id #uuid "df1fa51e-7cef-54f4-b1a7-7b7f68b20ba4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{x^{2} + 1}}{x - 1}" :db/id #edb/ref 17592186076024} {:answer/id #uuid "e3398373-09e7-518d-8484-610bbd1766a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{x^{2} - 1}}{x + 1}" :db/id #edb/ref 17592186076025} {:answer/id #uuid "4807a334-9b60-580f-95bf-7ae864029740" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{x^{2} + 1}}{x + 1}" :db/id #edb/ref 17592186076026} {:answer/id #uuid "614f8066-a822-57a5-9b0f-6b6b278d8ab4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{x - 1}}{x - 1}" :db/id #edb/ref 17592186076027}] :answer-field/id #uuid "3684090f-6f56-5785-8eb6-12b556ad9dcb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186076022}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6d4f11e4-b97c-51c1-9c34-daa6bcb78819" :question/math-academy-id "q-35021" :question/problem "Express $\\frac{\\sqrt{x + 1}}{\\sqrt{x - 1}}$ without radicals in the denominator."} :step/id #uuid "5d5b8600-0127-53ac-86da-87ef921e206c" :step/next {:db/id #edb/ref 17592186572276}} {:db/id #edb/ref 17592186572276 :step/content {:db/id #edb/ref 17592186572124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58fbaa76-4be3-5810-9fca-639dcb62397d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{42p}}{7p}" :db/id #edb/ref 17592186571694} {:answer/id #uuid "8c042201-2e31-56b9-9702-f689b45b0c3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{13p}}{7p}" :db/id #edb/ref 17592186571778} {:answer/id #uuid "f61222d0-e8d9-55d4-8873-2cca126d2600" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7\\sqrt{6p}}{7p}" :db/id #edb/ref 17592186571961} {:answer/id #uuid "f7473de6-7b7e-515e-9736-b0cbdd110a8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{7p}}{42p}" :db/id #edb/ref 17592186571962} {:answer/id #uuid "fec08322-cdbe-591d-8353-32e8ee674331" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6\\sqrt{7p}}{7p}" :db/id #edb/ref 17592186571979}] :answer-field/correct {:db/id #edb/ref 17592186571694} :answer-field/id #uuid "59851225-0325-52a4-8d88-a304533ac22e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572025}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3bff8ce6-eaad-5e46-86a8-f4fe4b2862a6" :question/math-academy-id "q-111056" :question/problem "Rationalize the denominator of $\\sqrt{\\frac{6}{7p}}.$" :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{6}{7p}} & =\\frac{\\sqrt{6}}{\\sqrt{7p}}\\end{aligned}\n$$\n\nNow, we need to remove the radical $\\sqrt{7p}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{7p},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{6}}{\\sqrt{7p}}\\cdot \\frac{\\sqrt{7p}}{\\sqrt{7p}} & = \\\\ \\frac{\\sqrt{42p}}{(\\sqrt{7p})^{2}} & = \\\\ \\frac{\\sqrt{42p}}{7p}\\end{aligned}\n$$"} :step/id #uuid "f626936f-607f-5132-84f4-52ddcf9e5010" :step/next {:db/id #edb/ref 17592186572212}}] :activity/title "Rationalizing Denominators of Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186571521}]}
