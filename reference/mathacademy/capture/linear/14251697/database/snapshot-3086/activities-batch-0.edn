#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186079505} :activity/id #uuid "fdd52764-0daf-5efd-a9d3-a33178d0ea3d" :activity/scope {:db/id #edb/ref 17592186049235 :topic/id #uuid "e5a9189d-c52f-5fc0-b562-b787ed5b5ba1" :topic/math-academy-id 599} :activity/steps [{:db/id #edb/ref 17592186079505 :step/content {:db/id #edb/ref 17592186079624 :tutorial/content "When simplifying expressions, we prefer not to leave a radical in the denominator. To eliminate a radical in an expression's denominator, we can use a process known as **rationalizing the denominator**.\n\nTo rationalize the denominator, we need to multiply both the numerator and denominator by the radical that we wish to remove from the denominator.\n\nFor instance, to rationalize the denominator in the expression\n\n$$\n\\dfrac{1}{\\sqrt{x}},\n$$\n\nall we need to do is multiply both the numerator and denominator by $\\sqrt{x}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{x}} & = \\\\ \\frac{1}{\\sqrt{x}}\\,\\cdot \\,\\frac{\\sqrt{x}}{\\sqrt{x}} & = \\\\ \\frac{\\sqrt{x}}{{(\\sqrt{x})}^{2}} & = \\\\ \\frac{\\sqrt{x}}{x} & \\end{aligned}\n$$\n\nWe see that the final expression no longer has a radical in the denominator. Thus, the denominator has been rationalized.\n\n**Note:** Because we multiplied the numerator and denominator by the same amount, the resulting expression $\\dfrac{\\sqrt{x}}{x}$ is equivalent to the original fraction $\\dfrac{1}{\\sqrt{x}}.$ They are equivalent, even though they are written differently." :tutorial/id #uuid "17e8e5bd-0b03-5315-8d7a-fc97948fb0d4" :tutorial/math-academy-id 1614 :tutorial/title "Introduction"} :step/id #uuid "32f48700-2e28-53f4-8117-05414a51c990" :step/math-academy-id 653769 :step/next {:db/id #edb/ref 17592186079506}} {:db/id #edb/ref 17592186079506 :step/content {:db/id #edb/ref 17592186078561 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078342 :question/id #uuid "b7506e51-659a-5f10-a2a8-822e8378768c" :question/math-academy-id "e-6718"} :knowledge-point/id #uuid "064cd24d-8e8c-5c55-b354-e84edb518c59" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048702}] :knowledge-point/questions [{:db/id #edb/ref 17592186078845} {:db/id #edb/ref 17592186078846} {:db/id #edb/ref 17592186079127} {:db/id #edb/ref 17592186519540} {:db/id #edb/ref 17592186519570}] :knowledge-point/title "Rationalizing a Variable Fraction"} :step/id #uuid "03cdecc5-044c-525b-9d1a-1f3234b5c9a1" :step/math-academy-id 653770 :step/next {:db/id #edb/ref 17592186079507}} {:db/id #edb/ref 17592186079507 :step/content {:db/id #edb/ref 17592186078562 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078171 :question/id #uuid "3b907098-3e14-5db0-914f-811c84a79d1b" :question/math-academy-id "e-1385"} :knowledge-point/id #uuid "49541737-272f-5821-8bf2-241989e14349" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050887}] :knowledge-point/questions [{:db/id #edb/ref 17592186078870} {:db/id #edb/ref 17592186079208} {:db/id #edb/ref 17592186519561} {:db/id #edb/ref 17592186519594} {:db/id #edb/ref 17592186572124}] :knowledge-point/title "Rationalizing a Variable Fraction Using the Quotient Rule For Radicals"} :step/id #uuid "c84a2326-edc8-5f45-9916-727883af7cec" :step/math-academy-id 653774 :step/next {:db/id #edb/ref 17592186079508}} {:db/id #edb/ref 17592186079508 :step/content {:db/id #edb/ref 17592186078563 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078172 :question/id #uuid "226ef796-a5c7-5113-a268-825bc1738a78" :question/math-academy-id "e-1386"} :knowledge-point/id #uuid "bd46dce5-3009-5b72-9230-f4b66fa77c9a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050818}] :knowledge-point/questions [{:db/id #edb/ref 17592186078872} {:db/id #edb/ref 17592186078873} {:db/id #edb/ref 17592186078874} {:db/id #edb/ref 17592186410432} {:db/id #edb/ref 17592186519517} {:db/id #edb/ref 17592186519520} {:db/id #edb/ref 17592186519530} {:db/id #edb/ref 17592186519583} {:db/id #edb/ref 17592186572173}] :knowledge-point/title "Rationalizing a Variable Fraction With More Than Two Terms"} :step/id #uuid "01600498-e551-5c5b-b3e4-ea3cc665f3c0" :step/math-academy-id 653778}] :activity/title "Rationalizing Denominators of Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078633}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186572235} :activity/id #uuid "3e972de8-bdbd-5deb-80d5-de1b7fa35350" :activity/scope {:db/id #edb/ref 17592186049235 :topic/id #uuid "e5a9189d-c52f-5fc0-b562-b787ed5b5ba1" :topic/math-academy-id 599} :activity/steps [{:db/id #edb/ref 17592186572212 :step/content {:db/id #edb/ref 17592186572173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae8dd84-1056-5afc-bdc6-13595c3ec750" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5(a+b)}}{5(a+b)}" :db/id #edb/ref 17592186571559} {:answer/id #uuid "0f075ce4-fb79-5eda-ae39-63d67635fa33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5(a+b)}" :db/id #edb/ref 17592186571564} {:answer/id #uuid "5ddd2e2e-8471-56e7-a9d7-6310c3988ee4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{a+b}}{5(a+b)}" :db/id #edb/ref 17592186571700} {:answer/id #uuid "a26f3e02-92d3-5d1f-b928-01b20bb52ebf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5(a+b)}}{a+b}" :db/id #edb/ref 17592186571820} {:answer/id #uuid "b1dd8cac-e702-5ca8-9e50-f2b488451c81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5\\sqrt{a+b}}{a+b}" :db/id #edb/ref 17592186571849}] :answer-field/correct {:db/id #edb/ref 17592186571820} :answer-field/id #uuid "39c3806c-d499-553b-a0be-7c5643b8cfe0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572006}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bb598f6a-4308-50e9-9232-77329f4110cd" :question/math-academy-id "q-111061" :question/problem "Express $\\sqrt{\\frac{5}{a+b}}\\,$ without radicals in the denominator." :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{5}{a+b}} & =\\frac{\\sqrt{5}}{\\sqrt{a+b}}\\end{aligned}\n$$\n\nTo remove the radical $\\sqrt{a+b}$ from the denominator, we multiply both the numerator and denominator by $\\sqrt{a+b}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{5}}{\\sqrt{a+b}} & = \\\\ \\frac{\\sqrt{5}}{\\sqrt{a+b}}\\cdot \\frac{\\sqrt{a+b}}{\\sqrt{a+b}} & = \\\\ \\frac{\\sqrt{5}\\cdot \\sqrt{a+b}}{\\sqrt{a+b}\\cdot \\sqrt{a+b}} & = \\\\ \\frac{\\sqrt{5(a+b)}}{(\\sqrt{a+b})^{2}} & = \\\\ \\frac{\\sqrt{5(a+b)}}{a+b} & \\end{aligned}\n$$"} :step/id #uuid "1b0a9667-11fa-5264-a52b-4744b8cfa717"} {:db/id #edb/ref 17592186572235 :step/content {:db/id #edb/ref 17592186078874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fece18e-f320-5a76-b295-3c64b645336c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{x^{2} - 1}}{x - 1}" :db/id #edb/ref 17592186076023} {:answer/id #uuid "df1fa51e-7cef-54f4-b1a7-7b7f68b20ba4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{x^{2} + 1}}{x - 1}" :db/id #edb/ref 17592186076024} {:answer/id #uuid "e3398373-09e7-518d-8484-610bbd1766a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{x^{2} - 1}}{x + 1}" :db/id #edb/ref 17592186076025} {:answer/id #uuid "4807a334-9b60-580f-95bf-7ae864029740" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{x^{2} + 1}}{x + 1}" :db/id #edb/ref 17592186076026} {:answer/id #uuid "614f8066-a822-57a5-9b0f-6b6b278d8ab4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{x - 1}}{x - 1}" :db/id #edb/ref 17592186076027}] :answer-field/id #uuid "3684090f-6f56-5785-8eb6-12b556ad9dcb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186076022}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6d4f11e4-b97c-51c1-9c34-daa6bcb78819" :question/math-academy-id "q-35021" :question/problem "Express $\\frac{\\sqrt{x + 1}}{\\sqrt{x - 1}}$ without radicals in the denominator."} :step/id #uuid "5d5b8600-0127-53ac-86da-87ef921e206c" :step/next {:db/id #edb/ref 17592186572276}} {:db/id #edb/ref 17592186572276 :step/content {:db/id #edb/ref 17592186572124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58fbaa76-4be3-5810-9fca-639dcb62397d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{42p}}{7p}" :db/id #edb/ref 17592186571694} {:answer/id #uuid "8c042201-2e31-56b9-9702-f689b45b0c3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{13p}}{7p}" :db/id #edb/ref 17592186571778} {:answer/id #uuid "f61222d0-e8d9-55d4-8873-2cca126d2600" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7\\sqrt{6p}}{7p}" :db/id #edb/ref 17592186571961} {:answer/id #uuid "f7473de6-7b7e-515e-9736-b0cbdd110a8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{7p}}{42p}" :db/id #edb/ref 17592186571962} {:answer/id #uuid "fec08322-cdbe-591d-8353-32e8ee674331" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6\\sqrt{7p}}{7p}" :db/id #edb/ref 17592186571979}] :answer-field/correct {:db/id #edb/ref 17592186571694} :answer-field/id #uuid "59851225-0325-52a4-8d88-a304533ac22e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572025}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3bff8ce6-eaad-5e46-86a8-f4fe4b2862a6" :question/math-academy-id "q-111056" :question/problem "Rationalize the denominator of $\\sqrt{\\frac{6}{7p}}.$" :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{6}{7p}} & =\\frac{\\sqrt{6}}{\\sqrt{7p}}\\end{aligned}\n$$\n\nNow, we need to remove the radical $\\sqrt{7p}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{7p},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{6}}{\\sqrt{7p}}\\cdot \\frac{\\sqrt{7p}}{\\sqrt{7p}} & = \\\\ \\frac{\\sqrt{42p}}{(\\sqrt{7p})^{2}} & = \\\\ \\frac{\\sqrt{42p}}{7p}\\end{aligned}\n$$"} :step/id #uuid "f626936f-607f-5132-84f4-52ddcf9e5010" :step/next {:db/id #edb/ref 17592186572212}}] :activity/title "Rationalizing Denominators of Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186571521}]}
