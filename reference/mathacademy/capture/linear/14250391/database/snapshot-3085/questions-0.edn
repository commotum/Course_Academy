answer/id #uuid "23e50c1d-2565-52fb-a27d-e5eebdb995f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186570942} {:answer/id #uuid "28f6047f-9a87-547f-a2b0-63d84f9e7ba0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186570951} {:answer/id #uuid "37aa1780-0a4d-52e2-9cea-73b9f1b8285f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186570976} {:answer/id #uuid "a74b9557-7451-5e28-88f9-084444ad33bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186571156} {:answer/id #uuid "bfce57ab-0e1b-5406-9ad1-93d01c1c45c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186571190}] :answer-field/correct {:answer/id #uuid "23e50c1d-2565-52fb-a27d-e5eebdb995f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186570942} :answer-field/id #uuid "38ac1c06-8797-54c9-919a-9badd40bf6f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571303}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "215445ba-4b6e-5c24-97c0-9095e5d1fe80" :question/math-academy-id "q-89719" :question/problem "A triangle $△ABC$ is reflected over the $x$-axis and then translated by $5$ units to the left. If the resulting triangle is $△PQR,$ which of the following statements must be true?\n\nI. $△ABC∼△PQR$\n\nII. $∠A≅∠P$\n\nIII. $5AC=PR$" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations.\n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the statements in turn.\n\n- Statement I is true. We are given a combination of a reflection and a translation. As a result, we obtain that \n\n$$\n△ABC∼△PQR.\n$$\n\n- Statement II is true. Since $△ABC∼△PQR,$ all corresponding angles of the triangles must be congruent. In particular, \n\n$$\n∠A≅∠P.\n$$\n\n- Statement III is false. Since our combined transformation consists of rigid motions only (namely, reflection and translation), the distance between all points is preserved under the transformation. Therefore, we obtain that \n\n$$\nAC=PR.\n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186571379 :knowledge-point/_questions [{:db/id #edb/ref 17592186073917 :knowledge-point/id #uuid "a8b5ef8e-6f13-5496-ae7f-c9fbaf3e25c7" :knowledge-point/title "Identifying Similarity Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05427ec8-e02f-5962-a97b-e42a7ce91391" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186570900} {:answer/id #uuid "13de73f0-fe5e-594f-80cc-4fcff2c06615" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186570918} {:answer/id #uuid "407d0955-8691-55fa-b272-acb163e39973" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186570986} {:answer/id #uuid "4d71a682-eaee-5663-bfae-47c7ddc5f646" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186571011} {:answer/id #uuid "7060a78b-a388-5597-a5b4-fc581daeb80f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186571065}] :answer-field/correct {:answer/id #uuid "4d71a682-eaee-5663-bfae-47c7ddc5f646" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186571011} :answer-field/id #uuid "03cf1212-20cf-5fec-91ff-894cfb864801" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571284}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19280716-a1d4-5a8a-bdaf-7c2fa87a8518" :question/math-academy-id "q-89723" :question/problem "Which of the following transformations map any polygon to a similar polygon?\n\nI. $(x,y)↦(x-3,y+1)$\n\nII. $(x,y)↦(2x,2y)$\n\nIII. $(x,y)↦(y,-x)$" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations. \n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I represents a translation by $3$ units to the left and $1$ unit upward. Thus, it is a similarity transformation.\n\n- Transformation II represents a dilation of scale factor $2$ and center $O.$ Thus, it is a similarity transformation.\n\n- Transformation III represents a rotation by ${90}^{∘}$ clockwise around the point $O.$ Thus, it is a rigid motion and, therefore, a similarity transformation.\n\nTherefore, the correct answer is \"I, II, and III.\""}]}
