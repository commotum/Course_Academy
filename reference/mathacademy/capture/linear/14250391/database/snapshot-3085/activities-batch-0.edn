#{[{:activity/first-step {:db/id #edb/ref 17592186074923} :activity/id #uuid "a8efd125-dcb7-576a-aba7-d6a258e9a53d" :activity/scope {:db/id #edb/ref 17592186048583 :topic/id #uuid "ab9e96eb-9d23-50fe-8a94-f2eebf047bbc" :topic/math-academy-id 491} :activity/steps [{:db/id #edb/ref 17592186074720 :step/content {:db/id #edb/ref 17592186073784 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073656 :question/id #uuid "f89ebcc9-96b7-5d6b-b844-4a9328f2ab6b" :question/math-academy-id "e-7916"} :knowledge-point/id #uuid "87cdc7a8-9437-56cc-a523-6b869b013428" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049112} {:db/id #edb/ref 17592186050659}] :knowledge-point/questions [{:db/id #edb/ref 17592186074208} {:db/id #edb/ref 17592186074219} {:db/id #edb/ref 17592186516862} {:db/id #edb/ref 17592186571381}] :knowledge-point/title "Identifying True Statements Regarding Transformed Polygons"} :step/id #uuid "2480a381-e1e9-5ddf-97c9-5065c97a8cda" :step/math-academy-id 29494 :step/next {:db/id #edb/ref 17592186074924}} {:db/id #edb/ref 17592186074923 :step/content {:db/id #edb/ref 17592186074984 :tutorial/content "Any transformation that maps a polygon to a similar polygon is called a **similarity transformation**.\n\nAny combination of transformations made up of translation, rotation, reflection, and dilation will result in a similarity transformation.\n\nTo understand why this is true, remember:\n\n- Rigid motions (rotation, reflection, and translation) do not change the lengths or angles of the original figure. They map polygons to congruent polygons. If two polygons are congruent, then they are similar.\n- A dilation with scale factor $k$ multiplies all the lengths of the original shape by $k$ (leaving the angle measures unchanged), thereby producing a similar shape." :tutorial/id #uuid "622763c1-840b-5946-a1e7-feb59d8f0c89" :tutorial/math-academy-id 2315 :tutorial/title "Introduction"} :step/id #uuid "7ec1bc50-2134-5ed0-aa3d-e29348fd99e7" :step/math-academy-id 9647 :step/next {:db/id #edb/ref 17592186074720}} {:db/id #edb/ref 17592186074924 :step/content {:db/id #edb/ref 17592186073916 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073602 :question/id #uuid "54f05d2d-1137-5bc7-b56d-0215dc3895ad" :question/math-academy-id "e-2978"} :knowledge-point/id #uuid "d7545aba-d80b-58ab-9a56-25ad196da3ee" :knowledge-point/questions [{:db/id #edb/ref 17592186074183} {:db/id #edb/ref 17592186074184}] :knowledge-point/title "Finding a Similarity Transformation Given a Polygon and Its Image"} :step/id #uuid "b8d1a4d2-47c1-5676-a5b1-d16b02e3ee67" :step/math-academy-id 9655 :step/next {:db/id #edb/ref 17592186074925}} {:db/id #edb/ref 17592186074925 :step/content {:db/id #edb/ref 17592186073917 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073603 :question/id #uuid "a75b57a8-4819-594a-9aa2-e35b54a68f6a" :question/math-academy-id "e-2993"} :knowledge-point/id #uuid "a8b5ef8e-6f13-5496-ae7f-c9fbaf3e25c7" :knowledge-point/questions [{:db/id #edb/ref 17592186074207} {:db/id #edb/ref 17592186074209} {:db/id #edb/ref 17592186234140} {:db/id #edb/ref 17592186234141} {:db/id #edb/ref 17592186516783} {:db/id #edb/ref 17592186516855} {:db/id #edb/ref 17592186571379}] :knowledge-point/title "Identifying Similarity Transformations"} :step/id #uuid "3698100e-df7d-5666-8520-aa605b0f8eca" :step/math-academy-id 9670}] :activity/title "Similarity Transformations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073926}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186516979} :activity/id #uuid "de7cd668-3db3-5af6-b281-2d79561e3e20" :activity/scope {:db/id #edb/ref 17592186048583 :topic/id #uuid "ab9e96eb-9d23-50fe-8a94-f2eebf047bbc" :topic/math-academy-id 491} :activity/steps [{:db/id #edb/ref 17592186516889 :step/content {:db/id #edb/ref 17592186516862 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ed52675-1674-5013-b977-2c1156e5c97e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186516169} {:answer/id #uuid "dc6eb254-4764-5546-881b-d06219358af3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186516576} {:answer/id #uuid "de8ea9cd-d289-5e31-b480-860682054345" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186516581} {:answer/id #uuid "def95e8e-df89-5823-b269-5d8d58bb3e5b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186516584} {:answer/id #uuid "eb50b3d4-f784-52f7-8f87-e4315c20fe44" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186516601}] :answer-field/correct {:db/id #edb/ref 17592186516576} :answer-field/id #uuid "6f5beb74-044c-5e40-8586-8ba7b7f03022" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516701}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8890925-6102-5a39-922f-cbb90bd120c9" :question/math-academy-id "q-89714" :question/problem "A square $ABCD$ is translated by $3$ units to the left and $3$ units upward. If the resulting quadrilateral is $PQRS,$ which of the following statements must be true?\n\nI. $ABCD∼PQRS$\n\nII. $ABCD≅PQRS$\n\nIII. $\\overset{―}{BC}≅\\overset{―}{QR}$" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations. \n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the statements in turn.\n\n- Statement I is true. We are given a combination of translations. As a result, we obtain that \n\n$$\nABCD∼PQRS.\n$$\n\n- Statement II is true. Since our combined transformation consists of rigid motions only (namely, translations), the distance between all points is preserved under the transformation. Therefore,  we obtain that \n\n$$\nABCD≅PQRS.\n$$\n\n- Statement III is true. Since $ABCD≅PQRS,$ all corresponding sides must be congruent. Therefore, \n\n$$\n\\overset{―}{BC}≅\\overset{―}{QR}.\n$$\n\nTherefore, the correct answer is \"I, II, and III.\""} :step/id #uuid "34047e62-3d93-591d-8a51-e16282e2c37f"} {:db/id #edb/ref 17592186516967 :step/content {:db/id #edb/ref 17592186516783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41f1557f-aa1b-5c6b-97f9-3183a0fdae13" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186516243} {:answer/id #uuid "5eeba46f-9dda-59a4-86da-d1ee0173c9ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186516317} {:answer/id #uuid "8861175f-b2e1-5165-afbc-bffd586e1f4b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186516397} {:answer/id #uuid "be0af016-3822-5b80-b2b9-b035f07b9902" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186516511} {:answer/id #uuid "c746c42b-4136-5b7a-8e70-85095e0c0424" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186516533}] :answer-field/correct {:db/id #edb/ref 17592186516511} :answer-field/id #uuid "f4eeffe0-d387-54ea-99bf-7c07fda39ad8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516762}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1ea750dd-05b5-599b-a75b-1d40366d85dc" :question/math-academy-id "q-89161" :question/problem "Which of the following transformations map any polygon to a similar polygon?\n\nI. Stretching with stretch factor $6$ in the $x$-direction, then a translation by $2$ units downward\n\nII. Rotation by ${45}^{∘}$ clockwise around a point $O$ followed by reflection over a line $l$\n\nIII. Dilation of scale factor $4$ with center at $A,$ then translation by $6$ units to the right" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations.\n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I includes stretching in only one direction. Thus, it is not a similarity transformation.\n\n- Transformation II is a combination of rotation and a reflection, which are rigid motions. Thus, it is a similarity transformation.\n\n- Transformation III is a combination of dilation of scale factor $4$ and a translation. Thus, it is a similarity transformation.\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "ccd3e0af-ff85-5d17-8152-0c5d9758036f" :step/next {:db/id #edb/ref 17592186516889}} {:db/id #edb/ref 17592186516979 :step/content {:db/id #edb/ref 17592186516855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4dea26-3eb3-5f68-9eb1-02c2680a892f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186516131} {:answer/id #uuid "6c7e6e72-0b09-5a44-9520-dfe8cf8a7a8b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II and III" :db/id #edb/ref 17592186516350} {:answer/id #uuid "eaba3792-c563-5079-bcd1-af361f15f0d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186516600} {:answer/id #uuid "fb5e5c56-e5ce-55fd-bc03-e48b07508467" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186516638} {:answer/id #uuid "fc9917d3-0d49-551d-bb4f-aa7e5e3ff567" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186516641}] :answer-field/correct {:db/id #edb/ref 17592186516131} :answer-field/id #uuid "eec1a239-a69c-51bb-a8aa-9e0e02460536" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516759}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cfe4ea96-fddc-550c-ac7a-6ec2d2c94652" :question/math-academy-id "q-53703" :question/problem "Which of the following transformations map any polygon to a similar polygon?\n\nI. $(x,y)↦(x-5,y)$\n\nII. $(x,y)↦(-y,x)$\n\nIII. $(x,y)↦(x,3y)$" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations. \n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I represents a translation by $5$ units to the left. Thus, it is a similarity transformation.\n\n- Transformation II represents a rotation by ${90}^{∘}$ counterclockwise around the origin. Thus, it is a similarity transformation.\n\n- Transformation III represents a stretch of factor $3$ in the $y$-direction. This is not a rigid motion.\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "eab95375-eb28-5e00-b681-d227e2c00467" :step/next {:db/id #edb/ref 17592186516967}}] :activity/title "Similarity Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516108}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186571507} :activity/id #uuid "d9e9c217-5ae3-5068-98fd-e6cb3f9c865d" :activity/scope {:db/id #edb/ref 17592186048583 :topic/id #uuid "ab9e96eb-9d23-50fe-8a94-f2eebf047bbc" :topic/math-academy-id 491} :activity/steps [{:db/id #edb/ref 17592186571465 :step/content {:db/id #edb/ref 17592186571379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05427ec8-e02f-5962-a97b-e42a7ce91391" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186570900} {:answer/id #uuid "13de73f0-fe5e-594f-80cc-4fcff2c06615" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186570918} {:answer/id #uuid "407d0955-8691-55fa-b272-acb163e39973" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186570986} {:answer/id #uuid "4d71a682-eaee-5663-bfae-47c7ddc5f646" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186571011} {:answer/id #uuid "7060a78b-a388-5597-a5b4-fc581daeb80f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186571065}] :answer-field/correct {:db/id #edb/ref 17592186571011} :answer-field/id #uuid "03cf1212-20cf-5fec-91ff-894cfb864801" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571284}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "19280716-a1d4-5a8a-bdaf-7c2fa87a8518" :question/math-academy-id "q-89723" :question/problem "Which of the following transformations map any polygon to a similar polygon?\n\nI. $(x,y)↦(x-3,y+1)$\n\nII. $(x,y)↦(2x,2y)$\n\nIII. $(x,y)↦(y,-x)$" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations. \n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I represents a translation by $3$ units to the left and $1$ unit upward. Thus, it is a similarity transformation.\n\n- Transformation II represents a dilation of scale factor $2$ and center $O.$ Thus, it is a similarity transformation.\n\n- Transformation III represents a rotation by ${90}^{∘}$ clockwise around the point $O.$ Thus, it is a rigid motion and, therefore, a similarity transformation.\n\nTherefore, the correct answer is \"I, II, and III.\""} :step/id #uuid "1ecfdd56-b7a0-5383-b779-374f5912150a"} {:db/id #edb/ref 17592186571507 :step/content {:db/id #edb/ref 17592186074207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98967896-54c8-5865-9845-e1a1d9178d9a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186071481} {:answer/id #uuid "99425a0d-da69-5731-ab7b-5d1dbde284e9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II and III" :db/id #edb/ref 17592186071482} {:answer/id #uuid "f3ae2f37-5f2f-5b3f-bf82-6aaaec926b58" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186071483} {:answer/id #uuid "f58a930e-62c4-5b53-a5bb-dd2908fc00c1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186071484} {:answer/id #uuid "5aa1f5ba-a50f-5287-ab7e-18287a3d2778" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186071485}] :answer-field/id #uuid "c5c90552-b5c4-5088-8ad5-64fb40a1de6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186071480}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fa450ad8-38d3-5294-81d0-6aaf37b44d6a" :question/math-academy-id "q-53598" :question/problem "Which of the following transformations maps any polygon to a similar polygon?\n\n1. $(x, y) ↦ (2x, 4y)$\n2. $(x, y) ↦ (3x, 3y)$\n3. $(x, y) ↦ (x,-y)$"} :step/id #uuid "cf78c2a0-767a-5134-ad68-8cf1fdecbd91" :step/next {:db/id #edb/ref 17592186571512}} {:db/id #edb/ref 17592186571512 :step/content {:db/id #edb/ref 17592186074219 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3da95ee-64a1-53eb-8b84-1e6d84fd159d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186071553} {:answer/id #uuid "dd40d0e4-b220-5fad-ac83-ba5f8ccfeaeb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186071554} {:answer/id #uuid "1445342a-399b-5585-acc3-e62bcb266551" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186071555} {:answer/id #uuid "27998285-8dc0-50a3-9e8a-93c116e2602a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186071556} {:answer/id #uuid "5cbd6832-803e-5578-a06a-1443325e6c37" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186071557}] :answer-field/id #uuid "83ffdad4-909a-53a7-9e48-6b57f1b5d673" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186071552}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "50bdf0ec-aa66-5df7-a5eb-d3cf86ba0ebe" :question/math-academy-id "q-53706" :question/problem "A square $ABCD$ is reflected over the $y$-axis and then translated by $2$ units to the right. If the resulting quadrilateral is $PQRS$, which of the following statements must be true?\n\n1. $ABCD∼PQRS$\n2. $ABCD≅PQRS$\n3. $BC^(―)≅QR^(―)$"} :step/id #uuid "eca63cc3-1f0e-59ee-b361-58cfcc164925" :step/next {:db/id #edb/ref 17592186571516}} {:db/id #edb/ref 17592186571516 :step/content {:db/id #edb/ref 17592186571381 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23e50c1d-2565-52fb-a27d-e5eebdb995f8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186570942} {:answer/id #uuid "28f6047f-9a87-547f-a2b0-63d84f9e7ba0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186570951} {:answer/id #uuid "37aa1780-0a4d-52e2-9cea-73b9f1b8285f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186570976} {:answer/id #uuid "a74b9557-7451-5e28-88f9-084444ad33bb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186571156} {:answer/id #uuid "bfce57ab-0e1b-5406-9ad1-93d01c1c45c0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186571190}] :answer-field/correct {:db/id #edb/ref 17592186570942} :answer-field/id #uuid "38ac1c06-8797-54c9-919a-9badd40bf6f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571303}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "215445ba-4b6e-5c24-97c0-9095e5d1fe80" :question/math-academy-id "q-89719" :question/problem "A triangle $△ABC$ is reflected over the $x$-axis and then translated by $5$ units to the left. If the resulting triangle is $△PQR,$ which of the following statements must be true?\n\nI. $△ABC∼△PQR$\n\nII. $∠A≅∠P$\n\nIII. $5AC=PR$" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations.\n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the statements in turn.\n\n- Statement I is true. We are given a combination of a reflection and a translation. As a result, we obtain that \n\n$$\n△ABC∼△PQR.\n$$\n\n- Statement II is true. Since $△ABC∼△PQR,$ all corresponding angles of the triangles must be congruent. In particular, \n\n$$\n∠A≅∠P.\n$$\n\n- Statement III is false. Since our combined transformation consists of rigid motions only (namely, reflection and translation), the distance between all points is preserved under the transformation. Therefore, we obtain that \n\n$$\nAC=PR.\n$$\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "f3ed4448-d98b-563f-8e2d-4623559201da" :step/next {:db/id #edb/ref 17592186571465}}] :activity/title "Similarity Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570890}]}
