045585] [17592186151088 #edb/ref 1084 #uuid "c1c11e3e-afcd-52ca-b7f8-5c50dd90b61e" #edb/ref 17592186045585] [17592186151089 #edb/ref 1081 "-35" #edb/ref 17592186045585] [17592186151089 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186151089 #edb/ref 1084 #uuid "57c5aaf4-4b46-5f29-aba6-f6b73dfcc740" #edb/ref 17592186045585] [17592186151090 #edb/ref 1081 "7" #edb/ref 17592186045585] [17592186151090 #edb/ref 1083 #edb/ref 17592186045499 #edb/ref 17592186045585] [17592186151090 #edb/ref 1084 #uuid "7e501346-6065-5d6c-95b9-362147164eb3" #edb/ref 17592186045585] [17592186151961 #edb/ref 1069 "e-6499" #edb/ref 17592186045585] [17592186151961 #edb/ref 1071 "Let $a=85$ and $n=8$. Find positive integers $q$ and $r$ such that $a = qn+r$, where $0 \\leq r < n$, and determine $q \\cdot r$." #edb/ref 17592186045585] [17592186151961 #edb/ref 1072 #uuid "909d813e-aab7-5e84-be60-2434383064a8" #edb/ref 17592186045585] [17592186151961 #edb/ref 1074 "Dividing $85$ by $8$ using integer division, we notice that\n\n$$\n{\\color{red}{10}} < 85\\div 8 < 11\n$$\n\nThe quotient $q$ is the left-hand value. So\n\n$$\nq={\\color{red}{10}}\n$$\n\nNext, we find the remainder $r$ by computing $r = a-qn$. This gives\n\n$$\nr = 85 - (10)(8) = {\\color{blue}{5}}\n$$\n\nTherefore, we can write\n\n$$\n85 = qn + r\n$$\n\nas follows:\n\n$$\n85 = 10_(⏟)_(q) \\cdot 8 + 5_(⏟)_(r)\n$$\n\nFinally,\n\n$$\nq \\cdot r = 10 \\cdot 5 = 50\n$$" #edb/ref 17592186045585] [17592186151962 #edb/ref 1069 "e-6500" #edb/ref 17592186045585] [17592186151962 #edb/ref 1071 "Let $a=-44$ and $n=6$. Find integers $q$ and $r$ such that $a = qn+r$, where $0 \\leq r < n$, and determine $q\\cdot r$." #edb/ref 17592186045585] [17592186151962 #edb/ref 1072 #uuid "58d4cedc-5fb8-5592-a75d-687a0c67da21" #edb/ref 17592186045585] [17592186151962 #edb/ref 1074 "Dividing $-44$ by $6$ using integer division, we notice that\n\n$$\n{\\color{red}{-8}} < -44\\div 6 < -7\n$$\n\nThe quotient $q$ is the left-hand value. So\n\n$$\nq={\\color{red}{-8}}\n$$\n\nNext, we find the remainder $r$ by solving $r = a-qn$. This gives\n\n$$\nr = -44 - (-8)(6) = {\\color{blue}{4}}\n$$\n\nTherefore, we can write\n\n$$\n-44 = qn + r\n$$\n\nas follows:\n\n$$\n-44 = (-8)_(⏟)_(q) \\cdot 6 + 4_(⏟)_(r)\n$$\n\nFinally,\n\n$$\nq\\cdot r = -8 \\cdot 4 = -32\n$$" #edb/ref 17592186045585] [17592186152170 #edb/ref 1037 #edb/ref 17592186048280 #edb/ref 17592186045585] [17592186152170 #edb/ref 1037 #edb/ref 17592186049057 #edb/ref 17592186045585] [17592186152170 #edb/ref 1038 #edb/ref 17592186152766 #edb/ref 17592186045585] [17592186152170 #edb/ref 1038 #edb/ref 17592186152767 #edb/ref 17592186045585] [17592186152170 #edb/ref 1039 "The Division Algorithm For Positive Integers" #edb/ref 17592186045585] [17592186152170 #edb/ref 1041 #edb/ref 17592186151961 #edb/ref 17592186045585] [17592186152170 #edb/ref 1042 #uuid "7eb49535-c9cc-5d5a-9fd0-a6fd7e5df3bf" #edb/ref 17592186045585] [17592186152171 #edb/ref 1038 #edb/ref 17592186152761 #edb/ref 17592186045585] [17592186152171 #edb/ref 1038 #edb/ref 17592186152768 #edb/ref 17592186045585] [17592186152171 #edb/ref 1039 "The Division Algorithm For Negative Integers" #edb/ref 17592186045585] [17592186152171 #edb/ref 1041 #edb/ref 17592186151962 #edb/ref 17592186045585] [17592186152171 #edb/ref 1042 #uuid "374cafa1-c178-5125-bda0-19b4e1c51892" #edb/ref 17592186045585] [17592186152353 #edb/ref 1043 #edb/ref 17592186153072 #edb/ref 17592186045585] [17592186152353 #edb/ref 1043 #edb/ref 17592186153073 #edb/ref 17592186045585] [17592186152353 #edb/ref 1043 #edb/ref 17592186153076 #edb/ref 17592186045585] [17592186152353 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045585] [17592186152353 #edb/ref 1045 "The Division Algorithm" #edb/ref 17592186045585] [17592186152353 #edb/ref 1046 #edb/ref 17592186153076 #edb/ref 17592186045585] [17592186152353 #edb/ref 1049 #edb/ref 17592186050451 #edb/ref 17592186045585] [17592186152353 #edb/ref 1053 #uuid "dd90587b-59ca-521e-b3f5-ea8301c