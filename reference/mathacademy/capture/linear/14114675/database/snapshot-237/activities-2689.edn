#{[{:activity/first-step {:db/id #edb/ref 17592186153076} :activity/id #uuid "dd90587b-59ca-521e-b3f5-ea8301cf8692" :activity/scope {:db/id #edb/ref 17592186050451 :topic/id #uuid "49978329-baa9-545d-916c-f0072c761ab2" :topic/math-academy-id 2689} :activity/steps [{:db/id #edb/ref 17592186153072 :step/content {:db/id #edb/ref 17592186152170 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151961 :question/id #uuid "909d813e-aab7-5e84-be60-2434383064a8" :question/math-academy-id "e-6499"} :knowledge-point/id #uuid "7eb49535-c9cc-5d5a-9fd0-a6fd7e5df3bf" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048280} {:db/id #edb/ref 17592186049057}] :knowledge-point/questions [{:db/id #edb/ref 17592186152766} {:db/id #edb/ref 17592186152767}] :knowledge-point/title "The Division Algorithm For Positive Integers"} :step/id #uuid "580d705f-f2f5-5760-9ae3-69568f3ab00d" :step/math-academy-id 23954 :step/next {:db/id #edb/ref 17592186153073}} {:db/id #edb/ref 17592186153073 :step/content {:db/id #edb/ref 17592186152171 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151962 :question/id #uuid "58d4cedc-5fb8-5592-a75d-687a0c67da21" :question/math-academy-id "e-6500"} :knowledge-point/id #uuid "374cafa1-c178-5125-bda0-19b4e1c51892" :knowledge-point/questions [{:db/id #edb/ref 17592186152761} {:db/id #edb/ref 17592186152768}] :knowledge-point/title "The Division Algorithm For Negative Integers"} :step/id #uuid "e7f54797-4181-5e6e-986f-085c9f9e83b0" :step/math-academy-id 23955} {:db/id #edb/ref 17592186153076 :step/content {:db/id #edb/ref 17592186153365 :tutorial/content "Suppose that $a$ is an integer and that $n$ is a positive integer. Then there are *unique* integers $q$ (called the **quotient**) and $r$ (called the **remainder**) such that\n\n$$\na = qn + r \\quad\\textrm{where}\\quad 0 \\leq r \\lt n\n$$\n\nThis simple idea has far-reaching consequences, as we'll soon discover.\n\nAs an example, suppose that $a=56$ and $n=5$. Then, we can write\n\n$$\n56 = \\underbrace{{\\color{red}{11}}}_{q}\\cdot 5 + \\underbrace{{\\color{blue}{1}}}_{r}\n$$\n\nWe can find $q$ using integer division. Once we know $q$, it's then straightforward to find $r$." :tutorial/id #uuid "afc98e47-2d5e-5d68-8ebf-06da0e82b2fc" :tutorial/math-academy-id 4006 :tutorial/title "Introduction"} :step/id #uuid "ada416f9-b803-5bef-8685-9f0ab966f0b2" :step/math-academy-id 24003 :step/next {:db/id #edb/ref 17592186153072}}] :activity/title "The Division Algorithm" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152353}]}
