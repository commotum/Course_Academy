[[:db/retract 17592186152766 :question/answer-fields 17592186151073] [:db/retract 17592186152768 :question/answer-fields 17592186151085] {:db/id 17592186152170 :knowledge-point/questions ["question-5b3d670b-6c15-5f96-828d-2a33d12d5846" "question-314ddabc-5058-598a-91b1-40efd4d045ae" "question-b2c5714b-ac40-5a40-a5f3-8159a7a54ddc" "question-4190f22f-14a3-5ec1-bdc7-02c4f951d26e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151961 :question/problem "Let $a=85$ and $n=8.$ Find positive integers $q$ and $r$ such that $a = qn+r,$ where $0 \\leq r <          n,$ and determine $q \\cdot r.$" :question/worked-solution "Dividing $85$ by $8$ using integer division, we notice that\n\n$$\n{\\color{red}{10}} <     85\\div 8 <     11.\n$$\n\nThe quotient $q$ is the left-hand value. So $q={\\color{red}{10}}.$\n\nNext, we find the remainder $r$ by computing $r = a-qn.$ This gives\n\n$$\nr = 85 - (10)(8) = {\\color{blue}{5}}.\n$$\n\nTherefore, we can write $85 = qn + r$ as follows:\n\n$$\n\\begin{aligned}85={{10}_{⏟}}_{q}\\cdot 8+{{5}_{⏟}}_{r}\\end{aligned}\n$$\n\nFinally, $q \\cdot r = 10 \\cdot 5 = 50.$" :db/ensure [:question/validate]} {:db/id 17592186152171 :knowledge-point/questions ["question-661f54e0-10c4-53e1-98b9-3627d5f43a3c" "question-d7616244-dc19-5790-9506-1e0646247891" "question-411dd7b8-effc-5fa5-873f-f9e9d66680ce" "question-a3df2d82-a0d6-5047-9209-0da57b555ffc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151962 :question/problem "Let $a=-44$ and $n=6.$ Find integers $q$ and $r$ such that $a = qn+r,$ where $0 \\leq r <         n,$ and determine $q\\cdot r.$" :question/worked-solution "Dividing $-44$ by $6$ using integer division, we notice that\n\n$$\n{\\color{red}{-8}} <      -44\\div 6 <      -7.\n$$\n\nThe quotient $q$ is the left-hand value. So $q={\\color{red}{-8}}.$\n\nNext, we find the remainder $r$ by solving $r = a-qn.$ This gives\n\n$$\nr = -44 - (-8)(6) = {\\color{blue}{4}}.\n$$\n\nTherefore, we can write $-44 = qn + r$ as follows:\n\n$$\n\\begin{aligned}-44={{(-8)}_{⏟}}_{q}\\cdot 6+{{4}_{⏟}}_{r}\\end{aligned}\n$$\n\nFinally, $q\\cdot r = -8 \\cdot 4 = -32.$" :db/ensure [:question/validate]} {:db/id 17592186152766 :question/problem "Let $a=47$ and $n=7.$ Find integers $q$ and $r$ such that $a=qn+r,$ where $0\\le r<n.$ Then, $r=$" :question/worked-solution "Dividing $47$ by $7$ using integer division, we notice that\n\n$$\n6<47÷7<7.\n$$\n\nThe quotient $q$ is the left-hand value. So $q=6.$\n\nNext, we find the remainder $r$ by computing $r=a-qn.$ This gives\n\n$$\nr=47-(6)(7)=5.\n$$\n\nTherefore, we can write $47=qn+r$ as follows:\n\n$$\n\\begin{aligned}47={{6}_{⏟}}_{q}\\cdot 7+{{5}_{⏟}}_{r}\\end{aligned}\n$$\n\nTherefore, $r=5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3b5bb491-6ee4-5d6b-b60b-240ce5a344aa"] :db/ensure [:question/validate]} {:db/id "answer-field-3b5bb491-6ee4-5d6b-b60b-240ce5a344aa" :answer-field/id #uuid "3b5bb491-6ee4-5d6b-b60b-240ce5a344aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9f2ef715-b767-5809-a181-d21aa31df7b8" :answer-field/choices ["answer-5ba32fa9-0b77-53a2-9851-45731fc186b1" "answer-1dedafaa-76a9-54f7-a202-8c780ec811d9" "answer-3354f69e-877b-5939-ae70-0c01652fa98a" "answer-9f2ef715-b767-5809-a181-d21aa31df7b8" "answer-6cb4db23-0312-5a9d-8374-3cf170ee8b4b"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ba32fa9-0b77-53a2-9851-45731fc186b1" :answer/id #uuid "5ba32fa9-0b77-53a2-9851-45731fc186b1" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-1dedafaa-76a9-54f7-a202-8c780ec811d9" :answer/id #uuid "1dedafaa-76a9-54f7-a202-8c780ec811d9" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-3354f69e-877b-5939-ae70-0c01652fa98a" :answer/id #uuid "3354f69e-877b-5939-ae70-0c01652fa98a" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:d