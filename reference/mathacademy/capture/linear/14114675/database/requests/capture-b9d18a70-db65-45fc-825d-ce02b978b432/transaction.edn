/choices ["answer-f195f921-8863-5f8f-9158-d7857046fe76" "answer-c8e8dd3e-339b-5884-a542-57e73851c11d" "answer-a6180fa8-0703-57e2-a5b9-761b0f67a8b7" "answer-83821279-d8d3-51d9-9a43-2782f4edd5db" "answer-3c22ada9-f64d-509b-b2e8-df15592edeb9"] :db/ensure [:answer-field/validate]} {:db/id "answer-f195f921-8863-5f8f-9158-d7857046fe76" :answer/id #uuid "f195f921-8863-5f8f-9158-d7857046fe76" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-c8e8dd3e-339b-5884-a542-57e73851c11d" :answer/id #uuid "c8e8dd3e-339b-5884-a542-57e73851c11d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-a6180fa8-0703-57e2-a5b9-761b0f67a8b7" :answer/id #uuid "a6180fa8-0703-57e2-a5b9-761b0f67a8b7" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-83821279-d8d3-51d9-9a43-2782f4edd5db" :answer/id #uuid "83821279-d8d3-51d9-9a43-2782f4edd5db" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-3c22ada9-f64d-509b-b2e8-df15592edeb9" :answer/id #uuid "3c22ada9-f64d-509b-b2e8-df15592edeb9" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-a3df2d82-a0d6-5047-9209-0da57b555ffc" :question/id #uuid "a3df2d82-a0d6-5047-9209-0da57b555ffc" :question/math-academy-id "q-79916" :question/problem "Let $a=-47$ and $n=6.$ Find integers $q$ and $r$ such that $a=qn+r,$ where $0\\le r<n,$ and determine $q\\cdot r.$" :question/worked-solution "Dividing $-47$ by $6$ using integer division, we notice that\n\n$$\n-8<-47÷6<-7.\n$$\n\nThe quotient $q$ is the left-hand value. So $q=-8.$\n\nNext, we find the remainder $r$ by solving $r=a-qn.$ This gives\n\n$$\nr=-47-(-8)(6)=1.\n$$\n\nTherefore, we can write $-47=qn+r$ as follows:\n\n$$\n\\begin{aligned}-47={{(-8)}_{⏟}}_{q}\\cdot 6+{{1}_{⏟}}_{r}\\end{aligned}\n$$\n\nFinally, $q\\cdot r=-8\\cdot 1=-8.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1409f416-1779-5a79-bb58-7a786b26efd6"] :db/ensure [:question/validate]} {:db/id "answer-field-1409f416-1779-5a79-bb58-7a786b26efd6" :answer-field/id #uuid "1409f416-1779-5a79-bb58-7a786b26efd6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3a21b84c-0acd-5586-b983-1675fd62a514" :answer-field/choices ["answer-75802b9f-01bb-574e-9345-e340b253cc8c" "answer-092038e3-d8b5-5a85-ac6f-ac53305df0d5" "answer-3a21b84c-0acd-5586-b983-1675fd62a514" "answer-9454920a-c9e0-527e-b4e6-7a4414d022e4" "answer-5aa3122b-f6e2-51f2-9b45-751244dde2cf"] :db/ensure [:answer-field/validate]} {:db/id "answer-75802b9f-01bb-574e-9345-e340b253cc8c" :answer/id #uuid "75802b9f-01bb-574e-9345-e340b253cc8c" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-092038e3-d8b5-5a85-ac6f-ac53305df0d5" :answer/id #uuid "092038e3-d8b5-5a85-ac6f-ac53305df0d5" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-3a21b84c-0acd-5586-b983-1675fd62a514" :answer/id #uuid "3a21b84c-0acd-5586-b983-1675fd62a514" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-9454920a-c9e0-527e-b4e6-7a4414d022e4" :answer/id #uuid "9454920a-c9e0-527e-b4e6-7a4414d022e4" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-5aa3122b-f6e2-51f2-9b45-751244dde2cf" :answer/id #uuid "5aa3122b-f6e2-51f2-9b45-751244dde2cf" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186153365 :tutorial/content "Suppose that $a$ is an integer and that $n$ is a positive integer. Then there are *unique* integers $q$ (called the **quotient**) and $r$ (called the **remainder**) such that\n\n$$\na = qn + r \\quad\\textrm{where}\\quad 0 \\leq r \\lt n.\n$$\n\nThis simple idea has far-reaching consequences, as we'll soon discover. \n\nAs an example, suppose that $a=56$ and $n=5.$ Then, we can write \n\n$$\n56 = \\underbrace{{\\color{red}{11}}}_{q}\\cdot 5 + \\underbrace{{\\color{blue}{1}}}_{r}.\n$$\n\nWe can find $q$ using integer division. Once we know $q,$ it's then straightforward to find $r.$" :db/ensure [:tutorial/validate]} {:db/id 17592186152353 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
