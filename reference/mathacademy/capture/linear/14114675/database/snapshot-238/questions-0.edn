nd{aligned}\n$$\n\nTherefore, $r=5.$"}] [{:db/id #edb/ref 17592186407771 :knowledge-point/_questions [{:db/id #edb/ref 17592186152170 :knowledge-point/id #uuid "7eb49535-c9cc-5d5a-9fd0-a6fd7e5df3bf" :knowledge-point/title "The Division Algorithm For Positive Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36317481-1088-5e8c-b158-b7dcd8b8b247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186407720} {:answer/id #uuid "7b9fa351-8ded-5346-be31-b4ff2b2b4c28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186407734} {:answer/id #uuid "8bd19f6f-413a-5e4e-8d62-fbfad83beb5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186407738} {:answer/id #uuid "c3fe947f-b82a-57f4-b35e-9a3dce8041f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186407749} {:answer/id #uuid "e7b9af20-0a99-555f-b6b6-cfee6fdc21ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186407754}] :answer-field/correct {:answer/id #uuid "e7b9af20-0a99-555f-b6b6-cfee6fdc21ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186407754} :answer-field/id #uuid "c18fdade-b31d-500c-9ac3-fe7da34b2f8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407767}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4190f22f-14a3-5ec1-bdc7-02c4f951d26e" :question/math-academy-id "q-79910" :question/problem "Let $a=96$ and $n=7.$ Find positive integers $q$ and $r$ such that $a=qn+r,$ where $0\\le r<n,$ and determine $q\\cdot r.$" :question/worked-solution "Dividing $96$ by $7$ using integer division, we notice that\n\n$$\n13<96÷7<14.\n$$\n\nThe quotient $q$ is the left-hand value. So $q=13.$\n\nNext, we find the remainder $r$ by computing $r=a-qn.$ This gives\n\n$$\nr=96-(13)(7)=5.\n$$\n\nTherefore, we can write $96=qn+r$ as follows:\n\n$$\n\\begin{aligned}96={{13}_{⏟}}_{q}\\cdot 7+{{5}_{⏟}}_{r}\\end{aligned}\n$$\n\nFinally, $q\\cdot r=13\\cdot 5=65.$"}] [{:db/id #edb/ref 17592186407769 :knowledge-point/_questions [{:db/id #edb/ref 17592186152170 :knowledge-point/id #uuid "7eb49535-c9cc-5d5a-9fd0-a6fd7e5df3bf" :knowledge-point/title "The Division Algorithm For Positive Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "025eeed5-68d4-5570-b021-0adf7e52b725" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186407709} {:answer/id #uuid "2d8581dd-1da5-594c-aeff-a22bc96cc24d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186407716} {:answer/id #uuid "a2432a68-e348-5010-853a-902531c483c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186407742} {:answer/id #uuid "c37191bc-1638-5bbe-a72d-998e1f87afae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186407748} {:answer/id #uuid "fcf4c5e6-37cd-56a4-81e4-9f40fbfa5399" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186407757}] :answer-field/correct {:answer/id #uuid "c37191bc-1638-5bbe-a72d-998e1f87afae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186407748} :answer-field/id #uuid "c589018b-3bd0-5b95-aacd-b5a22d703944" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407768}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "314ddabc-5058-598a-91b1-40efd4d045ae" :question/math-academy-id "q-79911" :question/problem "Let $a=49$ and $n=3.$ Find integers $q$ and $r$ such that $a=qn+r,$ where $0\\le r<n.$ Then, $q=$" :question/worked-solution "Dividing $49$ by $3$ using integer division, we notice that\n\n$$\n16<49÷3<17.\n$$\n\nThe quotient $q$ is the left-hand value. So $q=16.$\n\nNext, we find the remainder $r$ by computing $r=a-qn.$ This gives\n\n$$\nr=49-(16)(3)=1.\n$$\n\nTherefore, we can write $49=qn+r$ as follows:\n\n$$\n\\begin{aligned}49={{16}_{⏟}}_{q}\\cdot 3+{{1}_{⏟}}_{r}\\end{aligned}\n$$\n\nTherefore, $q=16.$"}] [{:db/id #edb/ref 17592186407773 :knowledge-point/_questions [{:db/id #edb/ref 17592186152171 :knowledge-point/id #uuid "374cafa1-c178-5125-bda0-19b4e1c51892" :knowledge-point/title "The Division Algorithm For Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3023cfd3-4c7f-56e6-a490-a108ba8f4a83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186407718} {:answer/id #uuid "5fe218bc-d3e1-52b4-b584-fec32700636e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186407730} {:answer/id #uuid "7fba60ac-1f50-5dfe-a109-e5bc6d216850" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-39" :db/id #edb/ref 17592186407735} {:answer/id #uuid "a4b49e7b-120f-561c-b309-ffce56a7d9e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186407743} {:answer/id #uuid "ec9dc135-1e22-5df4-aaa0-a6566fed7b38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186407755}] :answer-field/correct {:answer/id #uuid "ec9dc135-1e22-5df4-aaa0-a6566fed7b38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186407755} :answer-field/id #uuid "8abe8724-f702-5a13-b074-bf87bcd15c75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407764}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "661f54e0-10c4-53e1-98b9-3627d5f43a3c" :question/math-academy-id "q-79914" :question/problem "Let $a=-63$ and $n=5.$ Find integers $q$ and $r$ such that $a=qn+r,$ where $0\\le r<n,$ and determine $q\\cdot r.$" :question/worked-solution "Dividing $-63$ by $5$ using integer division, we notice that\n\n$$\n-13<-63÷5<-12.\n$$\n\nThe quotient $q$ is the left-hand value. So $q=-13.$\n\nNext, we find the remainder $r$ by solving $r=a-qn.$ This gives\n\n$$\nr=-63-(-13)(5)=2.\n$$\n\nTherefore, we can write $-63=qn+r$ as follows:\n\n$$\n\\begin{aligned}-63={{(-13)}_{⏟}}_{q}\\cdot 5+{{2}_{⏟}}_{r}\\end{aligned}\n$$\n\nFinally, $q\\cdot r=-13\\cdot 2=-26.$"}] [{:db/id #edb/ref 17592186407774 :knowledge-point/_questions [{:db/id #edb/ref 17592186152171 :knowledge-point/id #uuid "374cafa1-c178-5125-bda0-19b4e1c51892" :knowledge-point/title "The Division Algorithm For Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "092038e3-d8b5-5a85-ac6f-ac53305df0d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186407710} {:answer/id #uuid "3a21b84c-0acd-5586-b983-1675fd62a514" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186407721} {:answer/id #uuid "5aa3122b-f6e2-51f2-9b45-751244dde2cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186407726} {:answer/id #uuid "75802b9f-01bb-574e-9345-e340b253cc8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186407733} {:answer/id #uuid "9454920a-c9e0-527e-b4e6-7a4414d022e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186407739}] :answer-field/correct {:answer/id #uuid "3a21b84c-0acd-5586-b983-1675fd62a514" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186407721} :answer-field/id #uuid "1409f416-1779-5a79-bb58-7a786b26efd6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407759}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a3df2d82-a0d6-5047-9209-0da57b555ffc" :question/math-academy-id "q-79916" :question/problem "Let $a=-47$ and $n=6.$ Find integers $q$ and $r$ such that $a=qn+r,$ where $0\\le r<n,$ and determine $q\\cdot r.$" :question/worked-solution "Dividing $-47$ by $6$ using integer division, we notice that\n\n$$\n-8<-47÷6<-7.\n$$\n\nThe quotient $q$ is the left-hand value. So $q=-8.$\n\nNext, we find the remainder $r$ by solving $r=a-qn.$ This gives\n\n$$\nr=-47-(-8)(6)=1.\n$$\n\nTherefore, we can write $-47=qn+r$ as follows:\n\n$$\n\\begin{aligned}-47={{(-8)}_{⏟}}_{q}\\cdot 6+{{1}_{⏟}}_{r}\\end{aligned}\n$$\n\nFinally, $q\\cdot r=-8\\cdot 1=-8.$"}]}
