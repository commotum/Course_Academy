#{[{:db/id #edb/ref 17592186151961 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186152170 :knowledge-point/id #uuid "7eb49535-c9cc-5d5a-9fd0-a6fd7e5df3bf" :knowledge-point/title "The Division Algorithm For Positive Integers"}] :question/id #uuid "909d813e-aab7-5e84-be60-2434383064a8" :question/math-academy-id "e-6499" :question/problem "Let $a=85$ and $n=8.$ Find positive integers $q$ and $r$ such that $a = qn+r,$ where $0 \\leq r <          n,$ and determine $q \\cdot r.$" :question/worked-solution "Dividing $85$ by $8$ using integer division, we notice that\n\n$$\n{\\color{red}{10}} <     85\\div 8 <     11.\n$$\n\nThe quotient $q$ is the left-hand value. So $q={\\color{red}{10}}.$\n\nNext, we find the remainder $r$ by computing $r = a-qn.$ This gives\n\n$$\nr = 85 - (10)(8) = {\\color{blue}{5}}.\n$$\n\nTherefore, we can write $85 = qn + r$ as follows:\n\n$$\n\\begin{aligned}85={{10}_{⏟}}_{q}\\cdot 8+{{5}_{⏟}}_{r}\\end{aligned}\n$$\n\nFinally, $q \\cdot r = 10 \\cdot 5 = 50.$"}] [{:db/id #edb/ref 17592186151962 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186152171 :knowledge-point/id #uuid "374cafa1-c178-5125-bda0-19b4e1c51892" :knowledge-point/title "The Division Algorithm For Negative Integers"}] :question/id #uuid "58d4cedc-5fb8-5592-a75d-687a0c67da21" :question/math-academy-id "e-6500" :question/problem "Let $a=-44$ and $n=6.$ Find integers $q$ and $r$ such that $a = qn+r,$ where $0 \\leq r <         n,$ and determine $q\\cdot r.$" :question/worked-solution "Dividing $-44$ by $6$ using integer division, we notice that\n\n$$\n{\\color{red}{-8}} <      -44\\div 6 <      -7.\n$$\n\nThe quotient $q$ is the left-hand value. So $q={\\color{red}{-8}}.$\n\nNext, we find the remainder $r$ by solving $r = a-qn.$ This gives\n\n$$\nr = -44 - (-8)(6) = {\\color{blue}{4}}.\n$$\n\nTherefore, we can write $-44 = qn + r$ as follows:\n\n$$\n\\begin{aligned}-44={{(-8)}_{⏟}}_{q}\\cdot 6+{{4}_{⏟}}_{r}\\end{aligned}\n$$\n\nFinally, $q\\cdot r = -8 \\cdot 4 = -32.$"}] [{:db/id #edb/ref 17592186407775 :knowledge-point/_questions [{:db/id #edb/ref 17592186152170 :knowledge-point/id #uuid "7eb49535-c9cc-5d5a-9fd0-a6fd7e5df3bf" :knowledge-point/title "The Division Algorithm For Positive Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ea9ff6a-5ee5-58e1-92ff-71f27fcc82ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186407713} {:answer/id #uuid "2dd25de4-d6ad-5295-b389-825a91dadade" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186407717} {:answer/id #uuid "48a1a7c1-9c16-5e0a-ac3a-546df02ac453" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186407724} {:answer/id #uuid "9fc79799-e635-5c9d-b78e-c7f8b34d37f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186407741} {:answer/id #uuid "fd8d9b65-ab13-55ef-8f29-c9e35e6d936f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186407758}] :answer-field/correct {:answer/id #uuid "9fc79799-e635-5c9d-b78e-c7f8b34d37f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186407741} :answer-field/id #uuid "5ff9d617-a37d-52c8-885f-2af8c5145393" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407763}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2c5714b-ac40-5a40-a5f3-8159a7a54ddc" :question/math-academy-id "q-103277" :question/problem "Let $a=88$ and $n=9.$ Find positive integers $q$ and $r$ such that $a=qn+r,$ where $0\\le r<n,$ and determine $q\\cdot r.$" :question/worked-solution "Dividing $88$ by $9$ using integer division, we notice that\n\n$$\n9<88÷9<10.\n$$\n\nThe quotient $q$ is the left-hand value. So $q=9.$\n\nNext, we find the remainder $r$ by computing $r=a-qn.$ This gives\n\n$$\nr=88-(9)(9)=7.\n$$\n\nTherefore, we can write $88=qn+r$ as follows:\n\n$$\n\\begin{aligned}88={{9}_{⏟}}_{q}\\cdot 9+{{7}_{⏟}}_{r}\\end{aligned}\n$$\n\nFinally, $q\\cdot r=9\\cdot 7=63.$"}] [{:db/id #edb/ref 17592186407770 :knowledge-point/_questions [{:db/id #edb/ref 17592186152171 :knowledge-point/id #uuid "374cafa1-c178-5125-bda0-19b4e1c51892" :knowledge-point/title "The Division Algorithm For Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c22ada9-f64d-509b-b2e8-df15592edeb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186407722} {:answer/id #uuid "83821279-d8d3-51d9-9a43-2782f4edd5db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186407737} {:answer/id #uuid "a6180fa8-0703-57e2-a5b9-761b0f67a8b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186407744} {:answer/id #uuid "c8e8dd3e-339b-5884-a542-57e73851c11d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186407751} {:answer/id #uuid "f195f921-8863-5f8f-9158-d7857046fe76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186407756}] :answer-field/correct {:answer/id #uuid "c8e8dd3e-339b-5884-a542-57e73851c11d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186407751} :answer-field/id #uuid "2a9de8f2-e083-554c-a90d-6a3a06ab6f0f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407760}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "411dd7b8-effc-5fa5-873f-f9e9d66680ce" :question/math-academy-id "q-103288" :question/problem "Let $a=-53$ and $n=7.$ Find integers $q$ and $r$ such that $a=qn+r,$ where $0\\le r<n.$ Then, $r=$" :question/worked-solution "Dividing $-53$ by $7$ using integer division, we notice that\n\n$$\n-8<-53÷7<-7.\n$$\n\nThe quotient $q$ is the left-hand value. So $q=-8.$\n\nNext, we find the remainder $r$ by solving $r=a-qn.$ This gives\n\n$$\nr=-53-(-8)(7)=3.\n$$\n\nTherefore, we can write $-53=qn+r$ as follows:\n\n$$\n\\begin{aligned}-53={{(-8)}_{⏟}}_{q}\\cdot 7+{{3}_{⏟}}_{r}\\end{aligned}\n$$\n\nTherefore, $r=3.$"}] [{:db/id #edb/ref 17592186152766 :knowledge-point/_questions [{:db/id #edb/ref 17592186152170 :knowledge-point/id #uuid "7eb49535-c9cc-5d5a-9fd0-a6fd7e5df3bf" :knowledge-point/title "The Division Algorithm For Positive Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dedafaa-76a9-54f7-a202-8c780ec811d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186407712} {:answer/id #uuid "3354f69e-877b-5939-ae70-0c01652fa98a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186407719} {:answer/id #uuid "5ba32fa9-0b77-53a2-9851-45731fc186b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186407728} {:answer/id #uuid "6cb4db23-0312-5a9d-8374-3cf170ee8b4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186407732} {:answer/id #uuid "9f2ef715-b767-5809-a181-d21aa31df7b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186407740}] :answer-field/correct {:answer/id #uuid "9f2ef715-b767-5809-a181-d21aa31df7b8" :answer/type {:db/id #edb