class=\"mjx-c1D45F TEX-I\"></mjx-c></mjx-mi></mjx-mstyle></mjx-texatom></mjx-under></mjx-row></mjx-munder><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right\" columnspacing=\"\" rowspacing=\"3pt\"><mtr><mtd><mn>49</mn><mo>=</mo><munder><mrow data-mjx-texclass=\"OP\"><munder><mstyle mathcolor=\"red\"><mn>16</mn></mstyle><mo>⏟</mo></munder></mrow><mrow data-mjx-texclass=\"ORD\"><mstyle mathsize=\"1.2em\"><mi>q</mi></mstyle></mrow></munder><mo>⋅</mo><mn>3</mn><mo>+</mo><munder><mrow data-mjx-texclass=\"OP\"><munder><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle><mo>⏟</mo></munder></mrow><mrow data-mjx-texclass=\"ORD\"><mstyle mathsize=\"1.2em\"><mi>r</mi></mstyle></mrow></munder></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore, <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"70\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45E TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c36\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>q</mi><mo>=</mo><mn>16.</mn></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
