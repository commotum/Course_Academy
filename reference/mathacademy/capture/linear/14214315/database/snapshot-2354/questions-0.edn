#{[{:db/id #edb/ref 17592186525006 :knowledge-point/_questions [{:db/id #edb/ref 17592186054800 :knowledge-point/id #uuid "ae662093-c3e8-5577-af6e-7e2f383da79d" :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Addition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13e534db-9596-59d9-9c6b-3930ced0eda8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-11" :db/id #edb/ref 17592186524418} {:answer/id #uuid "3b428f3f-5b16-53f0-90ce-5a5f77c7668b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186524489} {:answer/id #uuid "c4573cdc-fa07-5d0e-a201-5b0f200109dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11x" :db/id #edb/ref 17592186524698} {:answer/id #uuid "cb21fb7c-771e-59ab-859e-8244b0f384ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11+" :db/id #edb/ref 17592186524717} {:answer/id #uuid "ecda9f85-7385-56c8-8d13-6935cfbd7169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+11" :db/id #edb/ref 17592186524798}] :answer-field/correct {:answer/id #uuid "ecda9f85-7385-56c8-8d13-6935cfbd7169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+11" :db/id #edb/ref 17592186524798} :answer-field/id #uuid "9e5d655d-fbf8-5d56-ba34-b7364dcf679e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524911}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8a3d8f81-e9cc-5df6-a543-4a7637a4bf37" :question/math-academy-id "q-108484" :question/problem "Translate the following phrase into an algebraic expression: \"Eleven more than a number.\"" :question/worked-solution "If we denote our number by $x$, then the phrase \"eleven more than a number\" can be written as\n\n$$\nx+11.\n$$"}] [{:db/id #edb/ref 17592186525035 :knowledge-point/_questions [{:db/id #edb/ref 17592186064256 :knowledge-point/id #uuid "f1c51da0-7569-50c0-b405-c74419d47ef3" :knowledge-point/title "Subtracting a Positive Number From a Non-Negative Number With Larger Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "312c0471-f6a8-584a-8540-c0ffccf50082" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-38" :db/id #edb/ref 17592186524472} {:answer/id #uuid "4094f0d0-05cf-5ee4-a732-943e61a72904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186524501} {:answer/id #uuid "87f8df68-bd78-54f9-a792-5d87d762bda8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186524593} {:answer/id #uuid "a1dfcbed-4a13-5c15-bf37-f46225c5f0fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186524637} {:answer/id #uuid "dba740cd-f7de-5931-a8ed-ffa787631d12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-50" :db/id #edb/ref 17592186524754}] :answer-field/correct {:answer/id #uuid "4094f0d0-05cf-5ee4-a732-943e61a72904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186524501} :answer-field/id #uuid "b01b6f43-db85-5f44-a21c-7bc482e17f50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524917}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bd178561-a381-5104-8041-a4f6b40537cb" :question/math-academy-id "q-128106" :question/problem "$201-249=$" :question/worked-solution "Since $249$ is larger than $201,$ the answer will be negative.\n\nWe start by solving an easier problem:\n\n$$\n249-201\n$$\n\nNext, we carry out the subtraction:\n\n$$\n\\begin{aligned} &  & \\,\\,\\, & \\,\\,\\, & \\,\\,\\, \\\\  &  & \\,\\,\\,2\\,\\,\\, & \\,\\,\\,4\\,\\,\\, & \\,\\,\\,9\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,2\\,\\,\\, & \\,\\,\\,0\\,\\,\\, & \\,\\,\\,1\\,\\,\\, \\\\  &  &  & \\,\\,\\,4\\,\\,\\, & \\,\\,\\,8\\,\\,\\,\\end{aligned}\n$$\n\nSo, we have\n\n$$\n249-201=48.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n201-249=-48.\n$$"}] [{:db/id #edb/ref 17592186524990 :knowledge-point/_questions [{:db/id #edb/ref 17592186110675 :knowledge-point/id #uuid "9ef4e321-841e-5933-b5e4-ff7dab6c5275" :knowledge-point/title "Identifying Collinear Points on a Grid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6e006a-3651-55e2-82ca-b07d0cbd9083" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186524436} {:answer/id #uuid "25290c47-5501-5d05-bf5f-86c572554236" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186524448} {:answer/id #uuid "aa073262-2b05-5652-a10b-edbf70e1bcb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186524656} {:answer/id #uuid "cd55077e-30a6-57f4-96d5-cbe0cbc13b2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186524723} {:answer/id #uuid "f8ab19ae-f23f-5e56-a623-ff1afaf77f6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186524824}] :answer-field/correct {:answer/id #uuid "f8ab19ae-f23f-5e56-a623-ff1afaf77f6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186524824} :answer-field/id #uuid "ac8cfa71-a98c-57db-8d46-6eba8f2a87b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524914}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5af7e394-12e7-5f3a-b066-84aff669a022" :question/math-academy-id "q-155030" :question/problem "![](images/95/95726fe45adfcf88fb3d2380779380fb236a5dd0a3bb332847130a8cb5251251.png)\n\nWhich of the diagrams above shows three collinear points?" :question/worked-solution "Three (or more) points are collinear if a straight line passes through all points.\n\nWith that in mind, let's examine our diagrams in turn.\n\n- Diagram I shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/61/611d93edb119e6bdc60bc3492b72d2c08730ef946232e3c3189b7d04eab43c18.png)\n\n- Diagram II shows three points that are *not* collinear. We can't draw a straight line that passes through all three points.\n\n![](images/32/32bb229224aac8d0b8feda0160c00d7afa9aa42827f448834a173b926a9dd48b.png)\n\n \n\n- Diagram III shows three points that are *not* collinear. We can't draw a straight line that passes through all three points.\n\n![](images/38/3886d294defeb0a4e43c5612c981b6b392a23067c0ecb51ebab6c2dab154c218.png)\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186524972 :knowledge-point/_questions [{:db/id #edb/ref 17592186064364 :knowledge-point/id #uuid "9cb97145-a93a-5df3-8dbe-6777d21601c8" :knowledge-point/title "Multiplying a Positive Number by a Negative Number With Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cbcfea6-3b4c-5765-8a42-b7ea0a31c27a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6.3" :db/id #edb/ref 17592186524463}] :answer-field/correct {:answer/id #uuid "2cbcfea6-3b4c-5765-8a42-b7ea0a31c27a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6.3" :db/id #edb/ref 17592186524463} :answer-field/id #uuid "fc3af737-6c46-5c87-a738-6dffb7ab08df" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524951}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "27d1fbdb-2975-5b0f-9d8e-58c27611f8b1" :question/math-academy-id "q-181026" :question/problem "$7\\cdot (-0.9)=${{field-1}}" :question/worked-solution "We have a product of a positive number $(7)$ and a negative number $(-0.9).$ So the product will be negative:\n\n$$\n7\\cdot (-0.9)=-\\,\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we multiply $7$ by $0.9$ without any signs: $7\\cdot 0.9=6.3.$ So, we get\n\n$$\n7\\cdot (-0.9)=-6.3.\n$$"}] [{:db/id #edb/ref 17592186064564 :knowledge-point/_questions [{:db/id #edb/ref 17592186064357 :knowledge-point/id #uuid "b434d0d5-bd04-554b-888e-df84e3961839" :knowledge-point/title "Dividing a Negative Number by a Positive Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8de48342-366e-5f2e-a882-be31c63e4994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186061580} {:answer/id #uuid "8f6f28c1-5772-52e6-9d1b-10deb0b189dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186061581} {:answer/id #uuid "b7ee0eab-bf8c-5c66-b8fc-10cc16e234b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186061582} {:answer/id #uuid "08cfe581-6bfa-52e2-a8a5-389c6c128baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186061583} {:answer/id #uuid "5efe3835-5d78-55b3-933a-b76d19a440d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186061584}] :answer-field/correct {:answer/id #uuid "08cfe581-6bfa-52e2-a8a5-389c6c128baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186061583} :answer-field/id #uuid "92c26b6e-f65d-57b9-b0dd-c0cca8cbc97b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061579}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "672db696-181e-5c2a-bef5-44e43460c4ec" :question/math-academy-id "q-2046" :question/problem "$(-18)÷6=$" :question/worked-solution "Here, we are dividing a negative number $(-18)$ by a positive one $(6).$ So the result will be negative:\n\n$$\n(-18)÷6=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we divide $18$ by $6$ without any signs: $18÷6=3.$ Therefore, we get\n\n$$\n(-18)÷6=-3.\n$$"}] [{:db/id #edb/ref 17592186106198 :knowledge-point/_questions [{:db/id #edb/ref 17592186105756 :knowledge-point/id #uuid "61c58110-9813-5588-81d2-5735718589aa" :knowledge-point/title "Finding Adjacent Vertices and Sides"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95113678-742c-5c9f-9bf2-c3b50800360d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and $E$" :db/id #edb/ref 17592186103065} {:answer/id #uuid "9e004b35-14e7-572b-83c3-e61d138e1365" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$E$ and $G$" :db/id #edb/ref 17592186103066} {:answer/id #uuid "f43487a5-fa2f-5c7c-bc36-1a5521a1fa94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and $F$" :db/id #edb/ref 17592186103067} {:answer/id #uuid "ff40b58c-2181-5128-962c-b29f33c3f58a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$" :db/id #edb/ref 17592186103068} {:answer/id #uuid "313c83a2-4ad3-5165-a670-3965bc7797ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and $G$" :db/id #edb/ref 17592186103069}] :answer-field/correct {:answer/id #uuid "f43487a5-fa2f-5c7c-bc36-1a5521a1fa94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and $F$" :db/id #edb/ref 17592186103067} :answer-field/id #uuid "e5f8bc00-ab42-590a-b078-5899db71661d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103064}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d54b328c-f1e2-5bec-a2e6-95356df69a23" :question/math-academy-id "q-22300" :question/problem "![](images/59/597626d534c99880de4eabaf51be1c756149395ce285e843a9eaa9a8bdc395d8.png)\n\nWhich vertices are adjacent to $E?$" :question/worked-solution "$E$ is the endpoint of the sides $\\overset{―}{DE}$ and $\\overset{―}{EF}.$ Therefore, the vertices $D$ and $F$ are adjacent to $E.$"}] [{:db/id #edb/ref 17592186524993 :knowledge-point/_questions [{:db/id #edb/ref 17592186073739 :knowledge-point/id #uuid "ae17eb3f-f444-5ab3-82fd-6c92b97b0e41" :knowledge-point/title "Simplifying Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "060cb9e2-a062-5d4e-b79a-46882843668c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186524391}] :answer-field/correct {:answer/id #uuid "060cb9e2-a062-5d4e-b79a-46882843668c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186524391} :answer-field/id #uuid "21c0a936-65d3-544b-823a-d54356a48ef4" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524855} {:answer-field/choices [{:answer/id #uuid "50e6fea6-9b42-5ed3-b05b-ca82f193ee2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186524519}] :answer-field/correct {:answer/id #uuid "50e6fea6-9b42-5ed3-b05b-ca82f193ee2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186524519} :answer-field/id #uuid "46a1e1ec-6fc7-5470-9953-6afd6d16c7d8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524868}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "63fb796f-6e2e-5f84-a08a-5f5d5b996ee4" :question/math-academy-id "q-236393" :question/problem "![](images/e6/e612ac8882e5abbe9f5eff3fc9f6e1f9e5e5d5827f01d232532ca8378c508793.png)\n\nExpress the number of hexagons to the total number of shapes as a ratio in its simplest form.\n\n{{field-1}}\n$:$\n{{field-2}}" :question/worked-solution "We count the number of hexagons. We see that there are $4$ hexagons.\n\nWe count the total number of shapes. We see that there are $8$ shapes in total.\n\nSo the ratio of hexagons to total shapes is $4:8.$\n\nWe can simplify this ratio by dividing both numbers in a ratio by $4:$\n\n$$\n\\begin{aligned}\\,\\,4 &  & : & \\,\\,\\,\\, & \\,\\,\\,8 &  \\\\ \\,\\,↓÷\\,\\,4 &  &  &  & \\,\\,\\,↓÷\\,\\,4 &  \\\\ \\,\\,1 &  & : &  & \\,\\,\\,2 & \\end{aligned}\n$$\n\nTherefore, the ratio of hexagons to the total shapes is $1:2.$"}] [{:db/id #edb/ref 17592186525042 :knowledge-point/_questions [{:db/id #edb/ref 17592186073880 :knowledge-point/id #uuid "7435b531-e922-5db5-8140-463b7e66dd64" :knowledge-point/title "Completing a Statement by Interpreting a Fraction as a Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cac3a3e4-4bff-51d4-94a9-d0eae7728987" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ and $2$" :db/id #edb/ref 17592186524713} {:answer/id #uuid "caf95b5a-8839-5d83-9547-7ca888e830c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ and $1$" :db/id #edb/ref 17592186524714} {:answer/id #uuid "db65c7dd-931c-568b-b998-a3add8069f01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $5$" :db/id #edb/ref 17592186524753} {:answer/id #uuid "dfbdc7ed-2666-5811-b094-8560cb08569d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $3$" :db/id #edb/ref 17592186524768} {:answer/id #uuid "f7cf4838-7951-57f4-83c2-70cb04192ef5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ and $2$" :db/id #edb/ref 17592186524820}] :answer-field/correct {:answer/id #uuid "dfbdc7ed-2666-5811-b094-8560cb08569d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $3$" :db/id #edb/ref 17592186524768} :answer-field/id #uuid "e7f79f08-c364-55a5-b2d4-7a59020d9e10" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524943}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca5fdebc-3254-5299-89b6-95fbebb635d8" :question/math-academy-id "q-60248" :question/problem "From left to right, what are the missing numbers in the following sentence?\n\nIn a liquid, there are $\\frac{2}{3}$ quarts of honey for each quart of water. Therefore, the liquid has a ratio of $\\boxed{}$ quarts of honey to $\\boxed{}$ quarts of water." :question/worked-solution "Let's rewrite a fraction $\\frac{2}{3}$ as a ratio:\n\n$$\n2:3\n$$\n\nTherefore, the liquid has a ratio of $2$ quarts of honey to $3$ quarts of water."}] [{:db/id #edb/ref 17592186525012 :knowledge-point/_questions [{:db/id #edb/ref 17592186147595 :knowledge-point/id #uuid "176069e4-4aa3-58cd-a04e-a70e7e5da960" :knowledge-point/title "Finding Part of a Number Given a Whole and a Percentage Greater Than 100%"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "043a9e3e-b3cd-5cfa-9d81-e26ad450d6d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186524384} {:answer/id #uuid "7ea86345-e78c-5f38-b314-bdcdcd13141f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "73" :db/id #edb/ref 17592186524580} {:answer/id #uuid "a261e6f2-0933-593a-835f-6a1e14079910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186524639} {:answer/id #uuid "ea7c30f7-8e5e-5379-ac16-2ec9b3bc8b9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "69" :db/id #edb/ref 17592186524796} {:answer/id #uuid "fab2505d-f4e8-5303-98fc-f5bf2a45cf35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186524833}] :answer-field/correct {:answer/id #uuid "043a9e3e-b3cd-5cfa-9d81-e26ad450d6d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186524384} :answer-field/id #uuid "c30bdd72-4d41-5214-a1f5-29955bfd7ec1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524923}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "90c33764-1c3e-51f1-880d-65fb7c77f172" :question/math-academy-id "q-61194" :question/problem "In a particular year, firefighters in a city responded to $40$ emergencies. The following year, firefighters attended $165%$ of the total number of emergencies compared to the previous year. How many emergencies did firefighters attend in the second year?" :question/worked-solution "To solve this problem, we can use the formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is the total number of emergencies that firefighters attended in the first year, which is $40$ emergencies. The percentage is $165%,$ and the part is the total number of emergencies firefighters attended in the second year.\n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n165%=165÷100=1.65\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =165%\\times 40 \\\\  & =1.65\\times 40 \\\\  & =66\\end{aligned}\n$$\n\nTherefore, $165%$ of $40$ is $66.$ So, firefighters attended $66$ emergencies in the second year.\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n165%=\\frac{165}{100}=\\frac{165÷5}{100÷5}=\\frac{33}{20}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =165%\\times 40 \\\\  & =\\frac{33}{20}\\times 40 \\\\  & =33\\times \\frac{40}{20} \\\\  & =33\\times 2 \\\\  & =66\\end{aligned}\n$$\n\nTherefore, $165%$ of $40$ is $66.$ So, firefighters attended $66$ emergencies in the second year."}] [{:db/id #edb/ref 17592186525009 :knowledge-point/_questions [{:db/id #edb/ref 17592186073899 :knowledge-point/id #uuid "f0708cd3-0608-5d57-ac14-4c16ef362473" :knowledge-point/title "Finding the Vertical Distance Between Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a9f768d-3b7a-50b9-ac43-fb1ac35f78d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186524537} {:answer/id #uuid "74343b0c-fe77-58ec-a95f-54b3006fc19b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186524568} {:answer/id #uuid "8b054765-177a-507b-aced-090f3a91ac77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186524602} {:answer/id #uuid "c22d2239-9d96-5d3d-b39b-6e4294bf44b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186524694} {:answer/id #uuid "db61b73a-6ab9-56d5-8f1b-246a5b28b8d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186524752}] :answer-field/correct {:answer/id #uuid "db61b73a-6ab9-56d5-8f1b-246a5b28b8d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186524752} :answer-field/id #uuid "fe1cad92-38bd-52de-a7fd-ee07bf798a45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524953}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f463b76-07fb-5ba1-955a-1c27fbeaf1d4" :question/math-academy-id "q-61272" :question/problem "What is the distance between the points $(0,-2)$  and $(0,-4)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/9e/9edd6fb0f5b8dbf861a10cb559e597abaee54d4f833735912ab8ecb8b6e6091a.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $2$ units, so the distance equals $2.$\n\n![](images/ee/ee815ded554b01fd73cfd3577cfd7a21ea1360a32414de62a2f43f8b8612fd67.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis and then subtracting.\n\n![](images/19/19d94e1c26e61bfccdbab7083781ea5fb164910c54719135b348a60002c27a0b.png)\n\nThe point $(0,-2)$ is at a distance of $2$ from the $x$-axis, and the point $(0,-4)$ is at a distance of $4$ from the $x$-axis. Therefore, the distance between the two points is $4-2=2.$"}] [{:db/id #edb/ref 17592186525050 :knowledge-point/_questions [{:db/id #edb/ref 17592186064229 :knowledge-point/id #uuid "c2097574-c45c-504d-8ec8-44474880cd21" :knowledge-point/title "Dividing Zero by a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26c7a5d6-1af2-5075-a7bd-450dd0ee43f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.001" :db/id #edb/ref 17592186524455} {:answer/id #uuid "33743398-b298-5983-bc4d-f2da54e46199" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186524475} {:answer/id #uuid "8a15f3c8-e961-5145-88db-0eb135efb5b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186524601} {:answer/id #uuid "cfb17e04-e236-5f22-aeec-e13db4c07375" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-100" :db/id #edb/ref 17592186524726} {:answer/id #uuid "d424a728-4479-5e44-9ae0-31a47ba3f480" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.01" :db/id #edb/ref 17592186524737}] :answer-field/correct {:answer/id #uuid "8a15f3c8-e961-5145-88db-0eb135efb5b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186524601} :answer-field/id #uuid "e45e0444-e71c-54ae-afbd-b2d40b2407b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524939}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "df0053ff-176e-53fc-ba84-2cd6292eecda" :question/math-academy-id "q-6174" :question/problem "Find the value of $0÷100.$" :question/worked-solution "Zero divided by any number (other than zero) equals zero. Therefore, $0÷100=0.$"}] [{:db/id #edb/ref 17592186525001 :knowledge-point/_questions [{:db/id #edb/ref 17592186179824 :knowledge-point/id #uuid "e39bc3f9-6e7c-5e13-abe1-ba7d88c68379" :knowledge-point/title "Multiplying Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f23f63d-1c73-5eeb-8f85-ff4c5f9bb1cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12.4" :db/id #edb/ref 17592186524439} {:answer/id #uuid "30958349-350a-5a29-a374-a3c26918b0b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8.6" :db/id #edb/ref 17592186524470} {:answer/id #uuid "34be3dd1-5cf2-50b3-b40c-6ae74c0269f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17.2" :db/id #edb/ref 17592186524479} {:answer/id #uuid "4f858313-2e3a-5cc8-830d-e8df4c9e098f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.6" :db/id #edb/ref 17592186524515} {:answer/id #uuid "d35a1a7e-0f9d-5ee0-af7e-39ff18bddc90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-17.2" :db/id #edb/ref 17592186524733}] :answer-field/correct {:answer/id #uuid "34be3dd1-5cf2-50b3-b40c-6ae74c0269f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17.2" :db/id #edb/ref 17592186524479} :answer-field/id #uuid "ccdc240d-6ac0-5c24-9e5f-9b1fb2cab436" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524928}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "81ed1269-d411-55d0-9278-76332ca965f4" :question/math-academy-id "q-75654" :question/problem "$(-2)\\cdot (-8.6)=$" :question/worked-solution "We have the product of two negative numbers, which gives a positive number.\n\n$$\n(-2)\\cdot (-8.6)=2\\cdot 8.6=17.2.\n$$"}] [{:db/id #edb/ref 17592186172603 :knowledge-point/_questions [{:db/id #edb/ref 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ee8e909-702f-543f-8ae9-dab28a6aff1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186171244} {:answer/id #uuid "b7dbfc5d-04ab-5c88-a062-444bdcc55b4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186171245} {:answer/id #uuid "fe7049d7-19ae-5aaf-9ed6-c1a834c80549" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186171246} {:answer/id #uuid "5c35ea73-fa13-5451-aa4c-97467cb0a1aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186171247} {:answer/id #uuid "69306ebe-e33d-5271-b827-bb68331191d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186171248}] :answer-field/correct {:answer/id #uuid "69306ebe-e33d-5271-b827-bb68331191d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186171248} :answer-field/id #uuid "39b5b834-22e4-569e-824a-b13b273bb96c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171243}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7acff681-6951-5e3e-93c7-ed77445de5b9" :question/math-academy-id "q-85146" :question/problem "Which of the following numbers are divisible by $6?$\n\nI. $14\\,733\\,189$\n\nII. $1\\,589\\,610$\n\nIII. $873\\,100\\,584$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$\n\n- The number $14\\,733\\,189$ is not divisible by $2,$ so it is not divisible by $6$ either.\n\n- The number $1\\,589\\,610$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n1+5+8+9+6+1+0=30\n$$\n\nSo, $1\\,589\\,610$ is divisible by $6.$\n\n- The number $873\\,100\\,584$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n8+7+3+1+0+0+5+8+4=36\n$$\n\nSo, $873\\,100\\,584$ is divisible by $6.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186524970 :knowledge-point/_questions [{:db/id #edb/ref 17592186152125 :knowledge-point/id #uuid "ebf3f930-2768-5399-8470-48ac430065a3" :knowledge-point/title "Classifying Numbers as Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09cfbfe2-a49a-5d22-b4e1-802ad451ab15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186524399} {:answer/id #uuid "0da4e9f1-ea41-5305-8ea0-e01a52047060" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186524406} {:answer/id #uuid "4bc9243a-1e45-596c-96d5-d7386c09bd5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186524510} {:answer/id #uuid "d7844ae8-7dce-53bc-ab13-f84339c7bc68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186524743} {:answer/id #uuid "faf857a2-8623-5564-a455-5ce3b85b40b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186524834}] :answer-field/correct {:answer/id #uuid "faf857a2-8623-5564-a455-5ce3b85b40b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186524834} :answer-field/id #uuid "af925059-3a5f-5fa3-90c5-752a6f343cbd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524916}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "20ed3ba1-b1a8-58f4-bd28-e42bcc1fa66a" :question/math-academy-id "q-98373" :question/problem "Which of the following numbers are integers?\n\nI. $-1$\n\nII. $0$\n\nIII. $1$" :question/worked-solution "The integers consist of all positive and negative whole numbers and zero.\n\n$$\n…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…\n$$\n\n \n\nOf the given numbers, $-1,$ $0,$ and $1$ are all integers.\n\nTherefore, the correct answer is \"I, II, and III.\""}]}
