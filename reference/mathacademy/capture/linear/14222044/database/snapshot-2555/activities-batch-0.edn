#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186055741} :activity/id #uuid "923904ff-312a-55b4-a100-3a7d7ffea386" :activity/scope {:db/id #edb/ref 17592186049931 :topic/id #uuid "1f6ee093-7e77-5fea-be72-a47ed3862b7a" :topic/math-academy-id 133} :activity/steps [{:db/id #edb/ref 17592186055741 :step/content {:db/id #edb/ref 17592186055979 :tutorial/content "To find the zeros of a rational function, we first need to factor the numerator and denominator and cancel any common factors. Then, we set the numerator equal to zero and solve.\n\nFor example, consider the function $f(x) = \\dfrac{x-3}{x^2-25}.$ Factoring the numerator and denominator, we get\n\n$$\nf(x) = \\dfrac{x-3}{(x+5)(x-5)}.\n$$\n\nThere are no common factors to cancel, so we set the numerator equal to zero and solve:\n\n$$\n\\begin{aligned}x-3 & =0 \\\\ x & =3\\end{aligned}\n$$\n\nTherefore, the solution to $f(x)=0$ is $x=3.$" :tutorial/id #uuid "ba9f3296-27d6-5ebc-93b3-bfd93d9384c8" :tutorial/math-academy-id 3380 :tutorial/title "Introduction"} :step/id #uuid "9401928f-ea2f-5f26-8234-d667d795a44d" :step/math-academy-id 466118 :step/next {:db/id #edb/ref 17592186055742}} {:db/id #edb/ref 17592186055742 :step/content {:db/id #edb/ref 17592186054739 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054566 :question/id #uuid "b8371b7c-dfd8-52b3-9c34-00d6814cc5de" :question/math-academy-id "e-5257"} :knowledge-point/id #uuid "7d084b4e-7ca3-5569-b2a5-42c4b8f47917" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186049074}] :knowledge-point/questions [{:db/id #edb/ref 17592186055163} {:db/id #edb/ref 17592186055471} {:db/id #edb/ref 17592186515583} {:db/id #edb/ref 17592186515607}] :knowledge-point/title "Finding the Roots of a Rational Function With a Linear Numerator and No Common Factors"} :step/id #uuid "650bf011-937b-57f7-a8ee-bf0e54ee1856" :step/math-academy-id 466119 :step/next {:db/id #edb/ref 17592186055743}} {:db/id #edb/ref 17592186055743 :step/content {:db/id #edb/ref 17592186054740 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054555 :question/id #uuid "bf127b16-01c5-58c9-903a-e00fe349c011" :question/math-academy-id "e-5139"} :knowledge-point/id #uuid "3d98f7bd-2351-5eb8-80ff-67adcba4adbc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049244}] :knowledge-point/questions [{:db/id #edb/ref 17592186055167} {:db/id #edb/ref 17592186055170} {:db/id #edb/ref 17592186515527} {:db/id #edb/ref 17592186515617} {:db/id #edb/ref 17592186522768}] :knowledge-point/title "Finding the Roots of a Rational Function With a Quadratic Numerator and No Common Factors"} :step/id #uuid "5d759207-50ca-5a02-8c7f-f76f8a3a0c9e" :step/math-academy-id 466122 :step/next {:db/id #edb/ref 17592186055744}} {:db/id #edb/ref 17592186055744 :step/content {:db/id #edb/ref 17592186054741 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054554 :question/id #uuid "f4a45939-a80c-5e3e-bf2f-b3097a42c2ff" :question/math-academy-id "e-5137"} :knowledge-point/id #uuid "e77fe2f6-0e93-5378-aa8d-cc6d5122bdaa" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050323}] :knowledge-point/questions [{:db/id #edb/ref 17592186055161} {:db/id #edb/ref 17592186055164} {:db/id #edb/ref 17592186055165} {:db/id #edb/ref 17592186233162} {:db/id #edb/ref 17592186515532} {:db/id #edb/ref 17592186515550} {:db/id #edb/ref 17592186522701}] :knowledge-point/title "Finding the Roots of a Rational Function With Common Factors"} :step/id #uuid "52cff0b4-d007-524e-b472-b630eebace14" :step/math-academy-id 466125 :step/next {:db/id #edb/ref 17592186055745}} {:db/id #edb/ref 17592186055745 :step/content {:db/id #edb/ref 17592186054742 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054556 :question/id #uuid "6d6b343f-756f-5d3b-9231-fe7796d85653" :question/math-academy-id "e-5142"} :knowledge-point/id #uuid "688b4f72-387b-5757-9b81-d24a1d9c727d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048272} {:db/id #edb/ref 17592186050827}] :knowledge-point/questions [{:db/id #edb/ref 17592186055160} {:db/id #edb/ref 17592186055162} {:db/id #edb/ref 17592186515571} {:db/id #edb/ref 17592186515573} {:db/id #edb/ref 17592186515599} {:db/id #edb/ref 17592186515608} {:db/id #edb/ref 17592186522751}] :knowledge-point/title "Finding the Roots of a Rational Function Containing a Cubic Expression"} :step/id #uuid "33217373-ba5e-50bc-a25d-6269107d313b" :step/math-academy-id 466129}] :activity/title "Roots of Rational Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054883}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186522837} :activity/id #uuid "8ba659a1-95fd-5dbf-977d-e7f98db61b34" :activity/scope {:db/id #edb/ref 17592186049931 :topic/id #uuid "1f6ee093-7e77-5fea-be72-a47ed3862b7a" :topic/math-academy-id 133} :activity/steps [{:db/id #edb/ref 17592186522830 :step/content {:db/id #edb/ref 17592186522701 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c6081c3-38a0-553f-95b3-bb1b79615863" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-3" :db/id #edb/ref 17592186522045} {:answer/id #uuid "7fe183f1-adc3-55ca-a0f5-2cb7c6c206e7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No roots" :db/id #edb/ref 17592186522273} {:answer/id #uuid "804cb341-7dd4-5100-bc89-462928a3d075" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=3" :db/id #edb/ref 17592186522275} {:answer/id #uuid "94e6af2f-d3d4-5aa3-96b5-dd921249cb1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=-4" :db/id #edb/ref 17592186522324} {:answer/id #uuid "9df9d439-2cc7-5118-ac3a-b34455eb4e49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=0" :db/id #edb/ref 17592186522344}] :answer-field/correct {:db/id #edb/ref 17592186522273} :answer-field/id #uuid "ce072ed5-fff1-5f57-8574-8b1467c81f11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522655}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "11794345-6933-57d1-83b3-9cd504769483" :question/math-academy-id "q-113152" :question/problem "Find the roots of $f(t)=\\frac{3t-9}{{t}^{2}+t-12}.$" :question/worked-solution "The roots of $f(t)$ are the solutions to the equation $f(t)=0.$ In our case, we have\n\n$$\n\\frac{3t-9}{{t}^{2}+t-12}=0.\n$$\n\nFirst, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}f(t) & =\\frac{3t-9}{{t}^{2}+t-12} \\\\  & =\\frac{3(t-3)}{(t-3)(t+4)} \\\\  & =\\frac{3\\cancel{(t-3)}}{\\cancel{(t-3)}(t+4)} \\\\  & =\\frac{3}{t+4}\\end{aligned}\n$$\n\nSetting the numerator equal to zero, we get $3=0,$ which is a false statement. Therefore, $f(t)=0$ has no solution, and so $f(t)$ has no roots."} :step/id #uuid "268eb4f9-3381-592c-aa6f-741cf272b0a8" :step/next {:db/id #edb/ref 17592186522890}} {:db/id #edb/ref 17592186522837 :step/content {:db/id #edb/ref 17592186522768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a4f702-63d6-559a-a0dd-ab624a5eb606" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=4" :db/id #edb/ref 17592186522022} {:answer/id #uuid "27570a30-bc64-5dd2-bf7a-c9dfffda49a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-2" :db/id #edb/ref 17592186522109} {:answer/id #uuid "3e970e43-56e8-51a7-8b67-1a34c8189d31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=-2,4" :db/id #edb/ref 17592186522154} {:answer/id #uuid "609ca3c1-35ba-50ca-a3f5-8ffaec27d898" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The equation has no real solution" :db/id #edb/ref 17592186522219} {:answer/id #uuid "654e9075-d5c0-5942-8335-3af4eecc1069" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z=2" :db/id #edb/ref 17592186522229}] :answer-field/correct {:db/id #edb/ref 17592186522219} :answer-field/id #uuid "88c05edb-27ce-5999-bea1-f451f6da5f5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522626}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "afbc25b8-e022-51c1-8f23-554ddf441b28" :question/math-academy-id "q-24662" :question/problem "Solve $g(z)=0$ where $g(z)=\\frac{{z}^{2}+4}{{z}^{2}-4}.$" :question/worked-solution "First, we factor $g(z),$ as follows:\n\n$$\n\\begin{aligned}g(z) & =\\frac{{z}^{2}+4}{{z}^{2}-4} \\\\  & =\\frac{{z}^{2}+4}{(z+2)(z-2)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the numerator equal to zero and solve for $z:$\n\n$$\n{z}^{2}+4=0\n$$\n\nSince ${z}^{2}+4>0$ for all $z,$ there is no real solution to $g(z)=0.$"} :step/id #uuid "42b328a5-8ffd-5876-afdc-e5a592324737" :step/next {:db/id #edb/ref 17592186522830}} {:db/id #edb/ref 17592186522890 :step/content {:db/id #edb/ref 17592186522751 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e45747-6dab-55e5-a4ac-42f5c054c709" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-5,\\,5" :db/id #edb/ref 17592186522037} {:answer/id #uuid "3035b6f7-dba3-5eb6-b785-1c9139483a03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2" :db/id #edb/ref 17592186522125} {:answer/id #uuid "55c97b34-1a0c-5fa1-a935-7a5e02916c64" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The equation has no solution" :db/id #edb/ref 17592186522199} {:answer/id #uuid "9ea0ed19-e8bc-5906-af88-d2c141f8e4a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2,\\,5" :db/id #edb/ref 17592186522347} {:answer/id #uuid "bba86845-7980-5a1c-8edf-d8acd2d217eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-1" :db/id #edb/ref 17592186522408}] :answer-field/correct {:db/id #edb/ref 17592186522125} :answer-field/id #uuid "4500e6f6-1360-506a-b80c-23e6f852f50c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522594}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "87c77350-058a-500e-bb8c-ed314494ab76" :question/math-academy-id "q-113168" :question/problem "Solve $g(y)=0$ where $g(y)=\\frac{{y}^{3}-2{y}^{2}-25y+50}{{y}^{3}+{y}^{2}-25y-25}.$" :question/worked-solution "First, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}g(y) & =\\frac{{y}^{3}-2{y}^{2}-25y+50}{{y}^{3}+{y}^{2}-25y-25} \\\\  & =\\frac{{y}^{2}(y-2)-25(y-2)}{{y}^{2}(y+1)-25(y+1)} \\\\  & =\\frac{(y-2)({y}^{2}-25)}{(y+1)({y}^{2}-25)} \\\\  & =\\frac{(y-2)(y-5)(y+5)}{(y+1)(y-5)(y+5)} \\\\  & =\\frac{(y-2)\\cancel{(y-5)(y+5)}}{(y+1)\\cancel{(y-5)(y+5)}} &  \\\\  & =\\frac{y-2}{y+1}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $y:$\n\n$$\n\\begin{aligned}y-2=0\\,⟹\\,y=2\\end{aligned}\n$$\n\nTherefore, the solution to $g(y)=0$ is $y=2.$"} :step/id #uuid "ea2da595-f24a-5651-9567-526c9ece20d8"}] :activity/title "Roots of Rational Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186522008}]}
