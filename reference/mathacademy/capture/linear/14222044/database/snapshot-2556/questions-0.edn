#{[{:db/id #edb/ref 17592186535037 :knowledge-point/_questions [{:db/id #edb/ref 17592186054740 :knowledge-point/id #uuid "3d98f7bd-2351-5eb8-80ff-67adcba4adbc" :knowledge-point/title "Finding the Roots of a Rational Function With a Quadratic Numerator and No Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8fa7c33-0920-5c80-b81d-66783a8901b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186534720}] :answer-field/correct {:answer/id #uuid "c8fa7c33-0920-5c80-b81d-66783a8901b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186534720} :answer-field/id #uuid "0ac2b473-8562-5640-a093-bef975d33359" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534834} {:answer-field/choices [{:answer/id #uuid "f64427b9-45e9-556f-9926-61f1f8b1c91c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186534813}] :answer-field/correct {:answer/id #uuid "f64427b9-45e9-556f-9926-61f1f8b1c91c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186534813} :answer-field/id #uuid "ac9d0efb-0c6f-57c1-96e7-540134465667" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534931}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "860910b4-2f3e-5abd-a759-661586cb6055" :question/math-academy-id "q-277907" :question/problem "In **ascending order**, the roots of $f(t)=\\frac{{t}^{2}-4t-21}{{t}^{2}+7t+10}$ are\n\n$t=$\n{{field-1}} $\\,$\nand\n$\\,\\,t=$\n{{field-2}}" :question/worked-solution "The roots of $f(t)$ are the solutions to the equation $f(t)=0.$ In our case, we have\n\n$$\n\\frac{{t}^{2}-4t-21}{{t}^{2}+7t+10}=0.\n$$\n\nFirst, we factor $f(t),$ as follows:\n\n$$\n\\begin{aligned}f(t) & =\\frac{{t}^{2}-4t-21}{{t}^{2}+7t+10} \\\\  & =\\frac{(t-7)(t+3)}{(t+5)(t+2)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the numerator equal to zero and solve for $t:$\n\n$$\n\\begin{aligned}(t-7)(t+3) & =0 \\\\ t & =7,\\,-3.\\end{aligned}\n$$\n\nTherefore, the solutions to $f(t)=0$, in ascending order, are $t=-3$ and $t=7.$"}] [{:db/id #edb/ref 17592186535063 :knowledge-point/_questions [{:db/id #edb/ref 17592186054740 :knowledge-point/id #uuid "3d98f7bd-2351-5eb8-80ff-67adcba4adbc" :knowledge-point/title "Finding the Roots of a Rational Function With a Quadratic Numerator and No Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60aaf0db-8e49-5cec-affb-68ab9d86ab91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186534461}] :answer-field/correct {:answer/id #uuid "60aaf0db-8e49-5cec-affb-68ab9d86ab91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186534461} :answer-field/id #uuid "4b91aa5d-2ec5-510f-9b6f-4340499a244c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534874} {:answer-field/choices [{:answer/id #uuid "d2f22493-6c20-57c1-8868-c03954a3bfa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186534738}] :answer-field/correct {:answer/id #uuid "d2f22493-6c20-57c1-8868-c03954a3bfa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186534738} :answer-field/id #uuid "844d3128-113d-58e2-9969-6c438840e1d9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534901}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bdbe7587-32bb-56f0-8c5c-492c8b22516f" :question/math-academy-id "q-277916" :question/problem "In **ascending order**, the roots of $f(x)=\\frac{{x}^{2}+2x-8}{{x}^{2}-9x+18}$ are\n\n$x=$\n{{field-1}} $\\,$\nand\n$\\,\\,x=$\n{{field-2}}" :question/worked-solution "The roots of $f(x)$ are the solutions to the equation $f(x)=0.$ In our case, we have\n\n$$\n\\frac{{x}^{2}+2x-8}{{x}^{2}-9x+18}=0.\n$$\n\nFirst, we factor $f(x),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}+2x-8}{{x}^{2}-9x+18} \\\\  & =\\frac{(x+4)(x-2)}{(x-3)(x-6)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the numerator equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}(x+4)(x-2) & =0 \\\\ x & =-4,\\,2.\\end{aligned}\n$$\n\nTherefore, the solutions to $f(x)=0$, in ascending order, are $x=-4$ and $x=2.$"}] [{:db/id #edb/ref 17592186535066 :knowledge-point/_questions [{:db/id #edb/ref 17592186054741 :knowledge-point/id #uuid "e77fe2f6-0e93-5378-aa8d-cc6d5122bdaa" :knowledge-point/title "Finding the Roots of a Rational Function With Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d82c5625-6116-52bd-ab3d-67180f93a5e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186534754}] :answer-field/correct {:answer/id #uuid "d82c5625-6116-52bd-ab3d-67180f93a5e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186534754} :answer-field/id #uuid "914487b6-8ecc-5985-adf5-223f2a382299" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534910}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c691641a-bf97-5ba0-ae7f-e25ca5480f64" :question/math-academy-id "q-277942" :question/problem "Solve $f(t)=0,$ where $f(t)=\\frac{{t}^{2}-5t+6}{3t-9}.$\n\n$t=$\n{{field-1}}" :question/worked-solution "First, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}f(t) & =\\frac{{t}^{2}-5t+6}{3t-9} \\\\  & =\\frac{(t-3)(t-2)}{3(t-3)} \\\\  & =\\frac{\\cancel{(t-3)}(t-2)}{3\\cancel{(t-3)}} \\\\  & =\\frac{(t-2)}{3}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $t:$\n\n$$\n\\begin{aligned}t-2 & =0\\,⟹\\,t=2\\end{aligned}\n$$\n\nTherefore, the solution to $f(t)=0$ is $t=2.$"}]}
