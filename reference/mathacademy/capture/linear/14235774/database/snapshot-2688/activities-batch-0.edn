#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186069587} :activity/id #uuid "69e08761-f82c-562e-8f6d-9f890b1ae48a" :activity/scope {:db/id #edb/ref 17592186050073 :topic/id #uuid "2b0634ea-2a8b-503c-8554-54791daac8d4" :topic/math-academy-id 464} :activity/steps [{:db/id #edb/ref 17592186069587 :step/content {:db/id #edb/ref 17592186069964 :tutorial/content "When solving an equation, we sometimes require taking the square root of a negative number. In such cases, we will not end up with real solutions, but imaginary solutions.\n\nTo demonstrate, let's solve the equation $2x^2 +8 = 0$ for $x.$ First, we rearrange the equation, as follows:\n\n$$\n\\eqalign{\n\t\t2x^2 + 8 &= 0 \\[3pt]\n\t\t2x^2 &= -8 \\[3pt]\n\t\tx^2 &= -4\n}\n$$\n\nBy taking the square root, we obtain\n\n$$\nx = \\pm \\sqrt{-4}.\n$$\n\nWe now rewrite $x$ using the imaginary unit $\\textrm{i}=\\sqrt{-1}\\, \\mathbin{:}$\n\n$$\n\\begin{aligned}x & =\\pm \\sqrt{-4} \\\\  & =\\pm \\sqrt{4\\cdot (-1)} \\\\  & =\\pm \\sqrt{4}\\cdot \\sqrt{-1} \\\\  & =\\pm 2\\text{i}\\end{aligned}\n$$\n\nTherefore, the solutions are $x = \\pm 2 \\textrm{i}.$" :tutorial/id #uuid "5649dc90-3e67-5125-9612-6e0618aea772" :tutorial/math-academy-id 2786 :tutorial/title "Introduction"} :step/id #uuid "0addf265-a4aa-5c4e-a8fb-9fbf5ad15eef" :step/math-academy-id 14281 :step/next {:db/id #edb/ref 17592186069588}} {:db/id #edb/ref 17592186069588 :step/content {:db/id #edb/ref 17592186068705 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068559 :question/id #uuid "d659780a-f726-5827-a13a-a64b21a0cf41" :question/math-academy-id "e-4027"} :knowledge-point/id #uuid "0b04beff-987b-504f-9783-4465474e01ab" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048187} {:db/id #edb/ref 17592186048428}] :knowledge-point/questions [{:db/id #edb/ref 17592186069306} {:db/id #edb/ref 17592186069308} {:db/id #edb/ref 17592186234012} {:db/id #edb/ref 17592186234013} {:db/id #edb/ref 17592186518139} 