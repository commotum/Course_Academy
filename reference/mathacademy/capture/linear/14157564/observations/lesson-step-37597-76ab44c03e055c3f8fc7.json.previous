{
  "dom_id": "step-37597",
  "name": "Example: \n                    Applying the Power Rule With Negative Integer Exponents",
  "problem": "Express $\\left(\\left(\\dfrac{2}{5}\\right)^{6}\\right)^{-2}$ as a base raised to a single exponent.",
  "worked_solution": "To raise a power to another power, we simply multiply the exponents:\n\n$$\n\\left(\\left(\\dfrac{2}{5}\\right)^{6}\\right)^{-2}=\\left(\\dfrac{2}{5}\\right)^{(6)\\cdot (-2)}=\\left(\\dfrac{2}{5}\\right)^{-12}\n$$",
  "calculator_instructions": "",
  "fields": [],
  "problem_field_keys": [],
  "answer_fields_complete": null,
  "result": null,
  "proof_feedback": null,
