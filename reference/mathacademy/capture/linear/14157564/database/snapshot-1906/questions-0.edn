#{[{:db/id #edb/ref 17592186100706 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100884 :knowledge-point/id #uuid "da02158c-c59e-5639-9d0c-625c0ff285e0" :knowledge-point/title "Applying the Power Rule With Positive Integer Exponents"}] :question/id #uuid "d5f71763-77dd-5758-bf77-a927b42bae5e" :question/math-academy-id "e-4651" :question/problem "Express $\\left(4^3\\right)^2$ as a base raised to a single exponent." :question/worked-solution "To raise a power to another power, we simply multiply the exponents:\n\n \n\n$$\n\\left(4^3\\right)^2=4^{3\\cdot 2}=4^{6}\n$$"}] [{:db/id #edb/ref 17592186100707 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100885 :knowledge-point/id #uuid "78d619d2-620e-539c-b9e2-89a7bb832722" :knowledge-point/title "Applying the Power Rule With Negative Integer Exponents and Formatting the Result"}] :question/id #uuid "0cdd6749-d069-5500-8cec-e581ff67c389" :question/math-academy-id "e-4652" :question/problem "Express $\\left(2^{-4}\\right)^{2}$ as a base raised to a single, positive exponent." :question/worked-solution "To raise a power to another power, we simply multiply the exponents:\n\n$$\n\\left(2^{-4}\\right)^{2}=2^{(-4)\\cdot 2}=2^{-8}\n$$\n\nTo evaluate $2^{-8},$ we find the reciprocal of the base $(2)$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n2^{-8} = \\left(\\dfrac{1}{2}\\right)^{8}\n$$"}] [{:db/id #edb/ref 17592186100802 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100960 :knowledge-point/id #uuid "ce6cafca-522d-5949-b5d2-4d13060bf7a8" :knowledge-point/title "Applying the Power Rule With Negative Integer Exponents"}] :question/id #uuid "4ede067b-672d-5366-928f-45f42e3aec19" :question/math-academy-id "e-9982" :question/problem "Express $\\left(\\left(\\dfrac{2}{5}\\right)^{6}\\right)^{-2}$ as a base raised to a single exponent." :question/worked-solution "To raise a power to another power, we simply multiply the exponents:\n\n$$\n\\left(\\left(\\dfrac{2}{5}\\right)^{6}\\right)^{-2}=\\left(\\dfrac{2}{5}\\right)^{(6)\\cdot (-2)}=\\left(\\dfrac{2}{5}\\right)^{-12}\n$$"}] [{:db/id #edb/ref 17592186481386 :knowledge-point/_questions [{:db/id #edb/ref 17592186100885 :knowledge-point/id #uuid "78d619d2-620e-539c-b9e2-89a7bb832722" :knowledge-point/title "Applying the Power Rule With Negative Integer Exponents and Formatting the Result"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01c03964-bbb3-565c-bfcb-c6ed69ba5e55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{9}^{18}" :db/id #edb/ref 17592186480739} {:answer/id #uuid "2150377d-9170-5e26-8c05-6932a47baf31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{1}{9})}^{3}" :db/id #edb/ref 17592186480806} {:answer/id #uuid "78a5e0b0-0aff-56f5-b302-e96894a6e57c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{1}{9})}^{9}" :db/id #edb/ref 17592186480961} {:answer/id #uuid "8ff6cccd-26e2-5560-99d7-944b84007b58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{9}^{9}" :db/id #edb/ref 17592186481010} {:answer/id #uuid "96a52254-ea30-53d5-b2d5-8fa3a1d84466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{1}{9})}^{18}" :db/id #edb/ref 17592186481028}] :answer-field/correct {:answer/id #uuid "96a52254-ea30-53d5-b2d5-8fa3a1d84466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(\\frac{1}{9})}^{18}" :db/id #edb/ref 17592186481028} :answer-field/id #uuid "de337785-0bed-5d88-927f-c04df51fff3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186481325}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "77363ffd-e93f-5e69-9243-0a2