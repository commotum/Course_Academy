#{[{:db/id #edb/ref 17592186100706 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100884 :knowledge-point/id #uuid "da02158c-c59e-5639-9d0c-625c0ff285e0" :knowledge-point/title "Applying the Power Rule With Positive Integer Exponents"}] :question/id #uuid "d5f71763-77dd-5758-bf77-a927b42bae5e" :question/math-academy-id "e-4651" :question/problem "Express $\\left(2\\cdot 4^3\\right)^2$ as a base raised to a single exponent." :question/worked-solution "To raise a power to another power, we simply multiply the exponents:\n\n$$\n\\left(2\\cdot4^3\\right)^2=2^{2}\\cdot 4^{3\\cdot 2}=4 \\cdot 4^{6} = 4^{7}\n$$"}] [{:db/id #edb/ref 17592186100707 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100885 :knowledge-point/id #uuid "78d619d2-620e-539c-b9e2-89a7bb832722" :knowledge-point/title "Applying the Power Rule With Negative Integer Exponents and Formatting the Result"}] :question/id #uuid "0cdd6749-d069-5500-8cec-e581ff67c389" :question/math-academy-id "e-4652" :question/problem "Express $\\left(2^{-4}\\right)^{2}$ as a base raised to a single, positive exponent." :question/worked-solution "To raise a power to another power, we simply multiply the exponents:\n\n$$\n\\left(2^{-4}\\right)^{2}=2^{(-4)\\cdot 2}=2^{-8}\n$$\n\nTo evaluate $2^{-8}$, we find the reciprocal of the base $(2)$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n2^{-8} = \\left(\\dfrac{1}{2}\\right)^{8}\n$$"}] [{:db/id #edb/ref 17592186100802 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100960 :knowledge-point/id #uuid "ce6cafca-522d-5949-b5d2-4d13060bf7a8" :knowledge-point/title "Applying the Power Rule With Negative Integer Exponents"}] :question/id #uuid "4ede067b-672d-5366-928f-45f42e3aec19" :question/math-academy-id "e-9982" :question/problem "Express $\\left(\\left(\\dfrac{2}{5}\\right)^{6}\\right)^{-2}$ as a base raised to a single exponent." :question/worked-solution "To raise a power to another power, we simply multiply the exponents:\n\n$$\n\\left(\\left(\\dfrac{2}{5}\\right)^{6}\\right)^{-2}=\\left(\\dfrac{2}{5}\\right)^{(6)\\cdot (-2)}=\\left(\\dfrac{2}{5}\\right)^{-12}\n$$"}]}
