#{[{:activity/first-step {:db/id #edb/ref 17592186101701} :activity/id #uuid "c33f4447-9a4b-5add-a4c9-995ef344ed21" :activity/scope {:db/id #edb/ref 17592186050697 :topic/id #uuid "5faccef4-6874-58a8-9306-2498a05448ef" :topic/math-academy-id 1224} :activity/steps [{:db/id #edb/ref 17592186101697 :step/content {:db/id #edb/ref 17592186100884 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100706 :question/id #uuid "d5f71763-77dd-5758-bf77-a927b42bae5e" :question/math-academy-id "e-4651"} :knowledge-point/id #uuid "da02158c-c59e-5639-9d0c-625c0ff285e0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050668}] :knowledge-point/questions [{:db/id #edb/ref 17592186101506} {:db/id #edb/ref 17592186101518}] :knowledge-point/title "Applying the Power Rule With Positive Integer Exponents"} :step/id #uuid "e66d16bb-63ca-5f42-9fb6-5c998c1c1dfb" :step/math-academy-id 17013 :step/next {:db/id #edb/ref 17592186101813}} {:db/id #edb/ref 17592186101698 :step/content {:db/id #edb/ref 17592186100885 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100707 :question/id #uuid "0cdd6749-d069-5500-8cec-e581ff67c389" :question/math-academy-id "e-4652"} :knowledge-point/id #uuid "78d619d2-620e-539c-b9e2-89a7bb832722" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050495}] :knowledge-point/questions [{:db/id #edb/ref 17592186101508} {:db/id #edb/ref 17592186101520}] :knowledge-point/title "Applying the Power Rule With Negative Integer Exponents and Formatting the Result"} :step/id #uuid "c7c9ea1d-6c99-509e-a3c4-2bed9dd181b6" :step/math-academy-id 17014} {:db/id #edb/ref 17592186101701 :step/content {:db/id #edb/ref 17592186101969 :tutorial/content "To raise a power to another power, we multiply the exponents. This is the **power rule for exponents**.\n\nTo demonstrate, let's simplify the expression\n\n$$\n\\left(3^5\\right)^4\n$$\n\nby applying the power rule:\n\n$$\n\\left(3^5\\right)^4 = 3^{5\\cdot 4} = 3^{20}\n$$\n\n**Note:** The power rule for exponents is just a quicker alternative to using repeated multiplication, as follows:\n\n$$\n\\begin{aligned}\n(3^{5})^{4} &=  \\\\\n3^{5} \\cdot 3^{5} \\cdot 3^{5} \\cdot 3^{5}_(⏟)_(4copies) &=  \\\\\n3^{5 + 5 + 5 + 5} &=  \\\\\n3^{5 \\cdot 4} &=  \\\\\n&= 3^{20}\n\\end{aligned}\n$$" :tutorial/id #uuid "77fdb9f8-30b1-5d1a-bc9d-feb500358913" :tutorial/math-academy-id 3270 :tutorial/title "Introduction"} :step/id #uuid "189dcb57-8b33-5690-bfb8-3d4a2e5f4099" :step/math-academy-id 17994 :step/next {:db/id #edb/ref 17592186101697}} {:db/id #edb/ref 17592186101813 :step/content {:db/id #edb/ref 17592186100960 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100802 :question/id #uuid "4ede067b-672d-5366-928f-45f42e3aec19" :question/math-academy-id "e-9982"} :knowledge-point/id #uuid "ce6cafca-522d-5949-b5d2-4d13060bf7a8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049349}] :knowledge-point/questions [{:db/id #edb/ref 17592186101100} {:db/id #edb/ref 17592186101519}] :knowledge-point/title "Applying the Power Rule With Negative Integer Exponents"} :step/id #uuid "191b9302-8a78-5f1f-9a30-3a6369c726fd" :step/math-academy-id 37597 :step/next {:db/id #edb/ref 17592186101698}}] :activity/title "The Power Rule for Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101076}]}
