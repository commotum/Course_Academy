tor of Two Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fe71c82-b6c4-51cf-b985-aa0b95b275ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186493417} {:answer/id #uuid "70785a40-9f68-59a0-a962-71a1ac609b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186493555} {:answer/id #uuid "88d14389-f858-5c64-8688-9b858b1bb194" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186493605} {:answer/id #uuid "961c6f7b-ffd8-5b18-9ce1-53f8a971ffd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186493625} {:answer/id #uuid "be32ecf2-6799-5674-a380-2b7c08c1f88e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186493705}] :answer-field/correct {:answer/id #uuid "70785a40-9f68-59a0-a962-71a1ac609b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186493555} :answer-field/id #uuid "4a56c089-3496-5ced-98ed-177d54b87aa0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493819}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc2e2da4-0526-5cbb-b99c-ff4e18d482b4" :question/math-academy-id "q-7554" :question/problem "Find the lowest common denominator of $\\frac{2}{5}$ and $\\frac{8}{11}.$" :question/worked-solution "To find the lowest common denominator of two fractions, we first find the prime factorization of both denominators. \n\nSince the denominators $5$ and $11$ are prime numbers, they are already represented by their respective prime factorizations. \n\nNow, we write down each prime factor, and we raise each factor to the highest power given in either factorization:\n\n- the highest power of $5$ is $1$\n\n- the highest power of $11$ is also $1$\n\nTherefore, the lowest common denominator is ${5}^{1}\\cdot {11}^{1}=55.$"}]}
