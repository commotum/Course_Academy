#{[{:activity/first-step {:db/id #edb/ref 17592186193791} :activity/id #uuid "8fdd2a28-fb77-5389-95e2-b00162ba12d2" :activity/scope {:db/id #edb/ref 17592186050512 :topic/id #uuid "4f6fdd1b-ddaf-50e8-af06-b394c3c58702" :topic/math-academy-id 3980} :activity/steps [{:db/id #edb/ref 17592186193790 :step/content {:db/id #edb/ref 17592186192856 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192615 :question/id #uuid "55e26a5c-18da-5923-a45f-f5cdaed73ac2" :question/math-academy-id "e-2576"} :knowledge-point/id #uuid "4de6c0f2-b9c3-518d-ba86-40ec3fcbd4f3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048587}] :knowledge-point/questions [{:db/id #edb/ref 17592186193326} {:db/id #edb/ref 17592186193327}] :knowledge-point/title "Measuring Angles Using a Protractor"} :step/id #uuid "bce5c56d-9855-51ed-a0e7-6211798ef991" :step/math-academy-id 8747 :step/next {:db/id #edb/ref 17592186193792}} {:db/id #edb/ref 17592186193791 :step/content {:db/id #edb/ref 17592186193813 :tutorial/content "We use a **protractor** to measure angles. A protractor is an instrument that looks as follows:\n\n![](images/2c/2c8865e67ff36fe06a6d1cf1be8c591468f1fef98b060ccb404b3bb61509edcf.png)\n\nTo find the measure of an angle using a protractor, we follow three steps:\n\n1. Place the midpoint of the protractor on the vertex of the angle.\n2. Align one side of the angle with the line passing through the midpoint and zero on the protractor.\n3. Read off the degrees where the other side of the angle intersects the scale.\n\nLet's measure the following angle using a protractor.\n\n![](images/ba/baebe10676f4e321f0e3983ffd848718f0a569a601f7e7fef36679f05984dd08.png)\n\nWe place the midpoint of our protractor on the vertex and align a zero on the protractor with one of the sides.\n\n![](images/5f/5f4de191857fa5b08e9b1675205149108ce0db0e46815a572cccddb665865f69.png)\n\nReading the protractor, we see that the angle measures $45^\\circ$.\n\n**Warning:** Protractors usually have two scales in opposite directions. Be careful which one you use. In this case, we used the *upper* scale because this is the one that starts from zero as we measure counterclockwise." :tutorial/id #uuid "7445a02a-ecba-53d9-88d7-765a590a504d" :tutorial/math-academy-id 2181 :tutorial/title "Introduction"} :step/id #uuid "7ea36da5-bcd8-5e22-ad3a-6ec6864a217a" :step/math-academy-id 8751 :step/next {:db/id #edb/ref 17592186193790}} {:db/id #edb/ref 17592186193792 :step/content {:db/id #edb/ref 17592186192857 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192616 :question/id #uuid "76f4a24f-4d7b-5be8-a86a-b1ae86c9f991" :question/math-academy-id "e-2589"} :knowledge-point/id #uuid "e42452f6-bf63-5c2e-a4d0-4ed5f6124c91" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050861}] :knowledge-point/questions [{:db/id #edb/ref 17592186193345} {:db/id #edb/ref 17592186193346}] :knowledge-point/title "Finding an Angle Measure by Taking a Difference"} :step/id #uuid "05f0b3a4-5dcf-5d3c-b6ea-cfcafe8b8203" :step/math-academy-id 8771}] :activity/title "Measuring Angles Using a Protractor" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192891}]}
