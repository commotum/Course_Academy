#{[{:db/id #edb/ref 17592186192615 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192856 :knowledge-point/id #uuid "4de6c0f2-b9c3-518d-ba86-40ec3fcbd4f3" :knowledge-point/title "Measuring Angles Using a Protractor"}] :question/id #uuid "55e26a5c-18da-5923-a45f-f5cdaed73ac2" :question/math-academy-id "e-2576" :question/problem "Determine the measure of the angles shown below.\n\n![](images/8a/8a74f14be370f7ca987cd5271572477f4e15a91f54be9ad662ec1455af7c4183.png)" :question/worked-solution "We will use a protractor to determine the measure of the angles.\n\nTo do this, we align one side of an angle with the zero mark (on the left or on the right side of the protractor) and read the degrees where the second side of the angle intersects the scale of numbers:\n\nBy doing this, we get the following angle measures.\n\n![](images/0b/0bf274dff799a9b7695c0e8dfc5f3850ac9c196f94d3ffb0210fc1df1bf12386.png)"}] [{:db/id #edb/ref 17592186192616 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186192857 :knowledge-point/id #uuid "e42452f6-bf63-5c2e-a4d0-4ed5f6124c91" :knowledge-point/title "Finding an Angle Measure by Taking a Difference"}] :question/id #uuid "76f4a24f-4d7b-5be8-a86a-b1ae86c9f991" :question/math-academy-id "e-2589" :question/problem "Determine the measure of the angle $\\angle ABC$ shown below.\n\n![](images/fe/feb2c7d5645b1443194baabcf4f7153fe15cb8059e4f590e2ee30a3a80a29aef.png)" :question/worked-solution "To find the angle, we can use either scale of the protractor.\n\n- First, let's use the upper scale. The side $\\overrightarrow{BA}$ of the angle intersects the upper scale at $125^\\circ$, and the other side $\\overrightarrow{BC}$ intersects the upper scale at $20^\\circ$. To find the measure of $\\angle ABC$, we subtract the smaller reading from the larger one and get\n$m\\angle ABC = 125^\\circ - 20^\\circ = 105^\\circ$.\n- If we use the lower scale, we get the same result. The side $\\overrightarrow{BA}$ of the angle intersects the lower scale at $55^\\circ$, and the other side $\\overrightarrow{BC}$ intersects the lower scale at $160^\\circ$. Subtracting the smaller reading from the larger one, we get\n$m\\angle ABC = 160^\\circ - 55^\\circ = 105^\\circ$.\n\nWe can check our result by rotating the protractor to align its zero with the side $\\overrightarrow{BC}$, as shown below. This way, we can perform the usual process, taking only a single measurement. Indeed, we see that $m\\angle ABC$ is equal to $105^\\circ$.\n\n![](images/02/0292b94168d618a8fe48b47c524b71b5b3ca40fa42c89f104b2b8eca10f3a847.png)"}] [{:db/id #edb/ref 17592186193326 :knowledge-point/_questions [{:db/id #edb/ref 17592186192856 :knowledge-point/id #uuid "4de6c0f2-b9c3-518d-ba86-40ec3fcbd4f3" :knowledge-point/title "Measuring Angles Using a Protractor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b6f8480-f3d5-55b6-9608-afc8f4d3d809" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "130^{∘}" :db/id #edb/ref 17592186191884} {:answer/id #uuid "f9da9878-464e-565c-9c53-33a6f050a77e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "118^{∘}" :db/id #edb/ref 17592186191885} {:answer/id #uuid "4570011c-a3f6-5765-8a46-594ec0dcaa3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "114^{∘}" :db/id #edb/ref 17592186191886} {:answer/id #uuid "6094120a-ef66-5dec-bbb8-a4fda66e3caf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105^{∘}" :db/id #edb/ref 17592186191887} {:answer/id #uuid "6dc0ce1b-371d-5a5c-89f4-3353299db87b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120^{∘}" :db/id #edb/ref 17592186191888}] :answer-field/id #uuid "4352e214-a796-5703-a843-0c023f66dc67" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186191883}] 