#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069781} :activity/id #uuid "d5e19120-ea4c-56bb-8467-d5e831ef288e" :activity/scope {:db/id #edb/ref 17592186049587 :topic/id #uuid "0246121f-0f22-5c51-a8c1-62015ed02e05" :topic/math-academy-id 421} :activity/steps [{:db/id #edb/ref 17592186069781 :step/content {:db/id #edb/ref 17592186070002 :tutorial/content "A line that crosses two parallel lines is called a **transversal**. For example, the line $\\overset{\\longleftrightarrow}{EF}$ in the diagram below is a transversal.\n\n![](images/cd/cdae3e21ca7b66c756e047b2f71dd03d1320a947e7477f6b025dacef95321399.png)\n\nA pair of parallel lines with a transversal form a set of $8$ angles, shown below.\n\n![](images/a4/a4465bbe051f978925e704cc40ced894c4e8c6625c53c7bd944a93c123359ab9.png)\n\nThis set of eight angles can be grouped into two categories:\n\n- We have four pairs of **vertical angles**:\n\n![](images/e0/e010db0c586e29e8ae640842f1519da314455bb7520680b80530799509058df3.png)\n\n- We also have four pairs of so-called **corresponding angles**:\n\n![](images/d1/d1b3f1ede08e3c20c80b7a23477491237e73a9b6691d93e6deabc5e5a4e0c57b.png)\n\nCorresponding pairs of angles are located in the same position as each other relative to the parallel lines and on the same side of the transversal. Pairs of corresponding angles are congruent." :tutorial/id #uuid "40b3e634-5345-5152-8f01-f8adc3303078" :tutorial/math-academy-id 6722 :tutorial/title "Introduction"} :step/id #uuid "e004f524-3c81-54dc-a543-8d822f7af1a4" :step/math-academy-id 40674 :step/next {:db/id #edb/ref 17592186069807}} {:db/id #edb/ref 17592186069782 :step/content {:db/id #edb/ref 17592186068839 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068446 :question/id #uuid "142170e2-0b2d-5612-92d8-7c989aa1453e" :question/math-academy-id "e-10736"} :knowledge-point/id #uuid "52f2cc01-7206-5396-aeef-8e4a73809186" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213}] :knowledge-point/questions [{:db/id #edb/ref 17592186069086} {:db/id #edb/ref 17592186069331} {:db/id #edb/ref 17592186498545} {:db/id #edb/ref 17592186498548} {:db/id #edb/ref 17592186545828}] :knowledge-point/title "Problems Involving Two Unknown Corresponding Angles"} :step/id #uuid "15924751-c726-5bb6-a169-80c8a5ad667e" :step/math-academy-id 40675 :step/next {:db/id #edb/ref 17592186069788}} {:db/id #edb/ref 17592186069788 :step/content {:db/id #edb/ref 17592186068843 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068450 :question/id #uuid "40e3c6c8-c86a-55bf-80ef-d8845828ad27" :question/math-academy-id "e-10855"} :knowledge-point/id #uuid "67fd827a-5a7a-5ab7-8153-a86e55ccd154" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048174}] :knowledge-point/questions [{:db/id #edb/ref 17592186069087} {:db/id #edb/ref 17592186069522} {:db/id #edb/ref 17592186498558} {:db/id #edb/ref 17592186498561} {:db/id #edb/ref 17592186545813} {:db/id #edb/ref 17592186545835}] :knowledge-point/title "Solving Problems With Two Transversals"} :step/id #uuid "3e415bc4-98c6-58c5-9103-42a481f6e39e" :step/math-academy-id 41152 :step/next {:db/id #edb/ref 17592186069791}} {:db/id #edb/ref 17592186069790 :step/content {:db/id #edb/ref 17592186068845 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068452 :question/id #uuid "b983a05e-715b-5541-be19-cefac6f82b10" :question/math-academy-id "e-11054"} :knowledge-point/id #uuid "85cc8613-7372-5e19-be2d-afd8d58d4708" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186049476} {:db/id #edb/ref 17592186050164}] :knowledge-point/questions [{:db/id #edb/ref 17592186069332} {:db/id #edb/ref 17592186069333} {:db/id #edb/ref 17592186498494}] :knowledge-point/title "Problems Involving an Unknown Corresponding Angle"} :step/id #uuid "c594c925-bfd5-53e6-a96b-e13cc0e7650a" :step/math-academy-id 42008 :step/next {:db/id #edb/ref 17592186069782}} {:db/id #edb/ref 17592186069791 :step/content {:db/id #edb/ref 17592186068846 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068453 :question/id #uuid "c7d91325-bc8d-571d-8ae7-aa66ae0534c7" :question/math-academy-id "e-11055"} :knowledge-point/id #uuid "1cb30b2e-2f71-55a0-a80a-f7a0f5e71780" :knowledge-point/questions [{:db/id #edb/ref 17592186069082} {:db/id #edb/ref 17592186069137} {:db/id #edb/ref 17592186498529} {:db/id #edb/ref 17592186498570}] :knowledge-point/title "Solving Problems With Two Transversals That Require Solving an Equation"} :step/id #uuid "79d55ed9-0774-5bc8-a780-b7745cc2bd4a" :step/math-academy-id 42009} {:db/id #edb/ref 17592186069807 :step/content {:db/id #edb/ref 17592186070008 :tutorial/content "Consider the following pair of parallel lines $\\overset{\\longleftrightarrow}{AB} \\parallel \\overset{\\longleftrightarrow}{CD},$ and the transversal $\\overset{\\longleftrightarrow}{EF}.$\n\n![](images/af/af403ef4827e840a49d5a3bde36561d22a508d262b3ad15b830812aefc306286.png)\n\n What is the value of $x?$\n\nFirst, note that $\\angle DIF$ and $\\angle BJI$ are corresponding angles. Therefore, they are congruent and thus have the same measure. This means we can write down the following equation:\n\n$$\n\\begin{aligned}m∠DIF & =m∠BJI \\\\ 3x-{20}^{∘} & =x+{10}^{∘}\\end{aligned}\n$$\n\nTo solve this equation, we first subtract $x$ from both sides:\n\n$$\n\\begin{aligned}3x-{20}^{∘} & =x+{10}^{∘} \\\\ 3x-{20}^{∘}-x & =x+{10}^{∘}-x \\\\ 2x-{20}^{∘} & ={10}^{∘}\\end{aligned}\n$$\n\nThen, we add $20^\\circ$ to both sides:\n\n$$\n\\begin{aligned}2x-{20}^{∘} & ={10}^{∘} \\\\ 2x-{20}^{∘}+{20}^{∘} & ={10}^{∘}+{20}^{∘} \\\\ 2x & ={30}^{∘}\\end{aligned}\n$$\n\nFinally, we divide both sides by $2{:}$\n\n$$\n\\begin{aligned}2x & ={30}^{∘} \\\\ \\frac{2x}{2} & =\\frac{{30}^{∘}}{2} \\\\ \\frac{\\cancel{2}x}{\\cancel{2}} & ={15}^{∘} \\\\ x & ={15}^{∘}\\end{aligned}\n$$\n\nTherefore, $x=15^\\circ.$" :tutorial/id #uuid "1983a72b-cd06-525b-8a7f-820171f631c1" :tutorial/math-academy-id 7640 :tutorial/title "A Worked Example"} :step/id #uuid "c53425c9-93f8-50f1-ba9b-c5137c0d9d3e" :step/math-academy-id 44334 :step/next {:db/id #edb/ref 17592186069790}}] :activity/title "Corresponding Angles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068954}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186545956} :activity/id #uuid "49957f7a-4afb-5f72-8d90-9be2de6b3a44" :activity/scope {:db/id #edb/ref 17592186049587 :topic/id #uuid "0246121f-0f22-5c51-a8c1-62015ed02e05" :topic/math-academy-id 421} :activity/steps [{:db/id #edb/ref 17592186545939 :step/content {:db/id #edb/ref 17592186545813 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0746683d-8797-5f2b-95dc-71f40b0506c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{48}^{∘}" :db/id #edb/ref 17592186545215} {:answer/id #uuid "8418df2d-a794-5d2d-8b95-e9c9f6f2cc0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{54}^{∘}" :db/id #edb/ref 17592186545449} {:answer/id #uuid "c7711a92-f975-5159-8094-830ed6cf3bee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{44}^{∘}" :db/id #edb/ref 17592186545559} {:answer/id #uuid "c7cd1ffe-fc48-5e5c-b643-f8b5e62deab4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{36}^{∘}" :db/id #edb/ref 17592186545562} {:answer/id #uuid "e5a98074-8d83-5bec-84ca-c92ae7444892" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{31}^{∘}" :db/id #edb/ref 17592186545625}] :answer-field/correct {:db/id #edb/ref 17592186545559} :answer-field/id #uuid "a6e4fe6a-97c0-55f8-aa37-67b07ae4b10b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545751}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "407bfc4b-29e1-5ad8-862e-1c4f1b286f41" :question/math-academy-id "q-117549" :question/problem "![](images/cc/ccdbd48b6cdf40205fe15a0b52553926aa4ba5e66e5a29bcf9ce6ae4164154a4.png)\n\nGiven that $r$, $s$ and $t$ in the above diagram are parallel, find $m∠v.$" :question/worked-solution "Consider $∠2$ and $∠3$ in the diagram below.\n\n![](images/50/50d1e010a8279bf8f59a5e57b4ee4d4b744af7e431351bb17397e123aa79c59a.png)\n\nNote that $∠2$ and the angle whose measure is ${100}^{∘}$ are corresponding angles formed by the same transversal. Therefore, \n\n$$\nm∠2={100}^{∘}.\n$$\n\nSimilarly, note that $∠3$ and the angle whose measure is ${36}^{∘}$ are corresponding angles formed by the same transversal. Therefore, \n\n$$\nm∠3={36}^{∘}.\n$$\n\nLet's add these measures to our diagram:\n\n![](images/ce/ce9944a3fa28177bd0882fccd53d544159b6f041c570e7037cac7db31103130e.png)\n\nThe angles $∠v$, $∠2,$ and $∠3$ combined give a straight angle. So, we get:\n\n$$\n\\begin{aligned}m∠v+m∠2+m∠3 & ={180}^{∘} \\\\ m∠v+{100}^{∘}+{36}^{∘} & ={180}^{∘} \\\\ m∠v+{136}^{∘} & ={180}^{∘} \\\\ m∠v & ={44}^{∘}\\end{aligned}\n$$"} :step/id #uuid "6804ab59-29d8-51c1-a53a-33027de8ef79" :step/next {:db/id #edb/ref 17592186546002}} {:db/id #edb/ref 17592186545956 :step/content {:db/id #edb/ref 17592186545835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10bb692e-36e7-518e-934f-7f2348cb810a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186545229} {:answer/id #uuid "4552359d-6331-5661-8b66-027569a2f7c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{50}^{∘}" :db/id #edb/ref 17592186545331} {:answer/id #uuid "4903221c-fcab-5a64-8b23-188c2c939e88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{60}^{∘}" :db/id #edb/ref 17592186545337} {:answer/id #uuid "df394d85-dc28-5c29-8329-dc16aae0f557" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{70}^{∘}" :db/id #edb/ref 17592186545611} {:answer/id #uuid "facc42be-49b3-5141-9e80-3358d50482bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{55}^{∘}" :db/id #edb/ref 17592186545664}] :answer-field/correct {:db/id #edb/ref 17592186545664} :answer-field/id #uuid "8d96c227-6f23-514a-8097-fbbd94755da1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545740}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "90e45430-ff4c-59cd-b8f8-806fae001939" :question/math-academy-id "q-53171" :question/problem "![](images/db/db1b39e3f00fd6bb64ed738fb12213f4775d2bd7d098dfa9d0efec2192d7a64f.png)\n\nGiven that $r$, $s$ and $t$ in the above diagram are parallel, find $m∠1.$" :question/worked-solution "Consider $∠2$ and $∠3$ in the diagram below.\n\n![](images/a7/a775b7c9ce63aa5b9f8c03fb91e7018d2f1edde5a2a2acdb099ae5ba53a874e4.png)\n\nNote that $∠2$ and the angle whose measure is ${75}^{∘}$ are corresponding angles formed by the same transversal. Therefore, \n\n$$\nm∠2={75}^{∘}.\n$$\n\nSimilarly, note that $∠3$ and the angle whose measure is ${50}^{∘}$ are corresponding angles formed by the same transversal. Therefore, \n\n$$\nm∠3={50}^{∘}.\n$$\n\nLet's add these measures to our diagram:\n\n![](images/01/01462502a4fbe0b25e489cc611200beb47cd926b8a055b69b7279aa0f301850b.png)\n\nThe angles $∠1$, $∠2,$ and $∠3$ combine to give a straight angle. So, we get:\n\n$$\n\\begin{aligned}m∠1+m∠2+m∠3 & ={180}^{∘} \\\\ m∠1+{75}^{∘}+{50}^{∘} & ={180}^{∘} \\\\ m∠1+{125}^{∘} & ={180}^{∘} \\\\ m∠1 & ={55}^{∘}\\end{aligned}\n$$"} :step/id #uuid "9cbce6de-8a3c-5419-8c14-0e187454a2b5" :step/next {:db/id #edb/ref 17592186545939}} {:db/id #edb/ref 17592186546002 :step/content {:db/id #edb/ref 17592186545828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "479d9a01-9deb-5a09-aa6b-934264ad1bfb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{35}^{∘}" :db/id #edb/ref 17592186545335} {:answer/id #uuid "68b20937-06fa-5ee7-9f09-8c2eff9900a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{29}^{∘}" :db/id #edb/ref 17592186545398} {:answer/id #uuid "6aa510db-507e-5d1c-ac87-823b20e24290" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{28}^{∘}" :db/id #edb/ref 17592186545401} {:answer/id #uuid "a5702a25-959c-54e4-8b48-d733d466e381" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{31}^{∘}" :db/id #edb/ref 17592186545502} {:answer/id #uuid "cfaa1e72-858f-5fb1-b6b1-a45409e1345a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{25}^{∘}" :db/id #edb/ref 17592186545576}] :answer-field/correct {:db/id #edb/ref 17592186545502} :answer-field/id #uuid "5ce27563-7842-5bd7-8582-3e404e021713" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545712}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6d28d4f3-c7e7-5aa9-96b5-112441d6c1ac" :question/math-academy-id "q-117567" :question/problem "![](images/47/4745f9e651eb50c345550e83ee82eb957cd28fd82e3398b667e4285bb512194c.png)\n\nSolve for $x$ in the figure above given that $\\overset{⟷}{AB}∥\\overset{⟷}{CD}.$" :question/worked-solution "Since the angles $∠JID$ and $∠EJB$ are corresponding angles, they are congruent and therefore have the same measure:\n\n$$\n\\begin{aligned}m∠JID & =m∠EJB \\\\ 4x+{25}^{∘} & ={180}^{∘}-x\\end{aligned}\n$$\n\nNow, we have an equation that we can solve for $x:$\n\n$$\n\\begin{aligned}4x+{25}^{∘} & ={180}^{∘}-x \\\\ 5x+{25}^{∘} & ={180}^{∘} \\\\ 5x & ={155}^{∘} \\\\ \\frac{5x}{5} & =\\frac{{155}^{∘}}{5} \\\\ \\frac{\\cancel{5}x}{\\cancel{5}} & ={31}^{∘} \\\\ x & ={31}^{∘}\\end{aligned}\n$$"} :step/id #uuid "e3e36f95-7ba1-5506-be93-9e4d488f2a59"}] :activity/title "Corresponding Angles" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186545188}]}
