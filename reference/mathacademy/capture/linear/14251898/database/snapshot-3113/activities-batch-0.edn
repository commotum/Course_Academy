#{[{:activity/first-step {:db/id #edb/ref 17592186097482} :activity/id #uuid "d3512106-8af4-5a4c-becc-adf1fbecbc2e" :activity/scope {:db/id #edb/ref 17592186051014 :topic/id #uuid "79fb6a4f-4564-5155-81f6-db81bd65e488" :topic/math-academy-id 1105} :activity/steps [{:db/id #edb/ref 17592186097482 :step/content {:db/id #edb/ref 17592186097835 :tutorial/content "A **linear combination** of two vectors $\\mathbf{a}$ and $\\mathbf{b}$ is a sum of multiples of the two vectors.\n\nFor example, let's consider the vectors $\\mathbf a$ and $\\mathbf b$, shown below:\n\n![](images/00/0091edb7bcd026737e7bdf9d56e5a9932970d62902a185f76599cdf18bfd9d45.png)\n\nOne particular linear combination of these vectors is\n\n$$\n2 \\mathbf{a} + 3 \\mathbf{b} = 2 \\cdot \\mathbf{a} + 3 \\cdot \\mathbf{b}\n$$\n\nIf we draw this linear combination in the coordinate plane, we get the following:\n\n![](images/73/73a73b7e90c9e82e57f88d04079a69fa2cce082fc6d7f4667fae1cb4190ea46a.png)" :tutorial/id #uuid "bb8c733e-1952-5929-84b3-4a26ad5131af" :tutorial/math-academy-id 2908 :tutorial/title "Introduction"} :step/id #uuid "daeeb1d8-7c26-5fe9-8805-aaf3b1a01627" :step/math-academy-id 15705 :step/next {:db/id #edb/ref 17592186097483}} {:db/id #edb/ref 17592186097483 :step/content {:db/id #edb/ref 17592186096650 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096449 :question/id #uuid "2ff4e8a9-d5ef-5e00-bba9-b51e18bf1f24" :question/math-academy-id "e-4284"} :knowledge-point/id #uuid "b8b30414-400e-5c93-98d4-82299b4eb570" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049603} {:db/id #edb/ref 17592186049715}] :knowledge-point/questions [{:db/id #edb/ref 17592186097163} {:db/id #edb/ref 17592186097180}] :knowledge-point/title "Finding a Linear Combination of Two Vectors"} :step/id #uuid "9a5ae19b-011f-5b8d-8540-600a73800026" :step/math-academy-id 15706 :step/next {:db/id #edb/ref 17592186097484}} {:db/id #edb/ref 17592186097484 :step/content {:db/id #edb/ref 17592186097836 :tutorial/content "If two vectors are not parallel, then each linear combination can only be written in one way.\n\nFor example, if we have two vectors $\\mathbf{a},\\mathbf{b}$ with $\\mathbf{a} \\nparallel \\mathbf{b}$, and two real numbers $\\alpha,\\beta$, then the equality\n\n$$\n2 \\mathbf{a} + 3 \\mathbf{b} = \\alpha \\mathbf{a} + \\beta \\mathbf{b}\n$$\n\nholds if and only if $\\alpha=2$ and $\\beta=3$.\n\nIn other words, the pair of numbers $\\alpha,\\beta$ defines a unique vector $\\alpha \\mathbf{a} + \\beta \\mathbf{b}$. That is to say, if\n\n$$\n\\alpha_1 \\mathbf{a} + \\beta_1 \\mathbf{b} = \\alpha_2 \\mathbf{a} + \\beta_2 \\mathbf{b}\n$$\n\nthen\n\n$$\n\\alpha_1 = \\alpha_2\n$$\n\nand\n\n$$\n\\beta_1 = \\beta_2\n$$\n\n**Watch out!** This property holds only if two vectors *are not parallel*." :tutorial/id #uuid "238afee6-d844-5e3c-ae61-fa85f64be3fa" :tutorial/math-academy-id 2909 :tutorial/title "An Important Property of Linear Combinations"} :step/id #uuid "330d84aa-8daf-516c-b0d1-59b30240a2f1" :step/math-academy-id 15707 :step/next {:db/id #edb/ref 17592186097485}} {:db/id #edb/ref 17592186097485 :step/content {:db/id #edb/ref 17592186096651 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096450 :question/id #uuid "f8325830-9c74-5bf2-866c-1c31acdcc37c" :question/math-academy-id "e-4285"} :knowledge-point/id #uuid "2121109d-7b73-5609-a9df-1eeed257ab1b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048826}] :knowledge-point/questions [{:db/id #edb/ref 17592186096970} {:db/id #edb/ref 17592186097047}] :knowledge-point/title "Solving a Statement With Linear Combinations Whose Coefficients Are Linear Functions"} :step/id #uuid "85245f42-5306-52d7-9f36-21cfddb14c40" :step/math-academy-id 15708}] :activity/title "Linear Combinations of Vectors and Their Properties" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096885}]}
