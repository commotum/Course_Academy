ock\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"3pt\"><mtr><mtd><mi>y</mi></mtd><mtd><mi></mi><mo>=</mo><mn>3</mn><mi>x</mi><mo>−</mo><mn>2</mn></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mn>3</mn><mo stretchy=\"false\">(</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mn>2</mn></mtd></mtr><mtr><mtd><mi>t</mi></mtd><mtd><mi></mi><mo>=</mo><mn>12</mn><mo>−</mo><mn>2</mn></mtd></mtr><mtr><mtd><mi>t</mi></mtd><mtd><mi></mi><mo>=</mo><mn>10</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
