#{[{:db/id #edb/ref 17592186055121 :knowledge-point/_questions [{:db/id #edb/ref 17592186054692 :knowledge-point/id #uuid "ab1cee02-754b-5431-b20a-cca551442193" :knowledge-point/title "Finding a Missing Coordinate in a Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d5f3fd9-1922-51bc-a239-c90eb1947c2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186052095} {:answer/id #uuid "dbf1fdf8-e1f8-5b70-bcdc-c2b605741c60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186052096} {:answer/id #uuid "3a453e07-0a58-5dcd-ad0f-d184e9fe84a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186052097} {:answer/id #uuid "4a45537c-fe71-5382-a81a-736f9af0d799" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186052098} {:answer/id #uuid "55f5c385-4f81-5579-983d-b306a3c6b0f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186052099}] :answer-field/correct {:answer/id #uuid "8d5f3fd9-1922-51bc-a239-c90eb1947c2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186052095} :answer-field/id #uuid "a5c553e9-261c-5c05-a60d-360c0826e8e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186052094}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d5036f1-050b-5536-86c3-62162fea429b" :question/math-academy-id "q-22354" :question/problem "A solution to the linear equation $y=3x-2$ is the ordered pair $(4,t).$ What is the value of $t?$" :question/worked-solution "Since $(4,t)$ is a solution to the linear equation $y=3x-2,$ the equation must turn into a true statement if we substitute $4$ and $t$ for $x$ and $y.$ So, we replace $x$ with $4$ and $y$ with $t,$ as follows:\n\n$$\n\\begin{aligned}y & =3x-2 \\\\ (t) & =3(4)-2 \\\\ t & =12-2 \\\\ t & =10\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186506561 :knowledge-point/_questions [{:db/id #edb/ref 17592186054693 :knowledge-point/id #uuid "1fe6fbb4-545d-5db8-9042-2c5fac1add72" :knowledge-point/title "Identifying a Solution to a Given Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a6c279-2e8a-5668-8055-0c5048d986d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186505921} {:answer/id #uuid "55cd2295-7391-5333-b505-2bebeab49eda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186506058} {:answer/id #uuid "c46fb7a0-b425-5c37-9b0c-bf407dbdefee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186506261} {:answer/id #uuid "c8246af6-e321-5c32-9d54-0be845fb1a81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186506266} {:answer/id #uuid "ee218eec-e653-595b-ae8d-c1cb3b786e4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186506346}] :answer-field/correct {:answer/id #uuid "03a6c279-2e8a-5668-8055-0c5048d986d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186505921} :answer-field/id #uuid "b78c8c28-e7f5-5c67-a2f4-7acc6b4dc795" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186506465}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8850735f-3807-552e-a696-83fed33439b4" :question/math-academy-id "q-44331" :question/problem "Which of the following ordered pairs is **NOT** a solution to $y=3x+4?$\n\nI. $(4,16)$\n\nII. $(0,4)$\n\nIII. $(3,12)$" :question/worked-solution "To check whether each point is a solution to the equation, we substitute it into the equation and see if it results in a true statement.\n\nFirst, we substitute $(4,16)$ into the equation:\n\n$$\n\\begin{aligned}y & =3x+4 \\\\ (16) & =3(4)+4 \\\\ 16 & =12+4 \\\\ 16 & =16\\,✓\\end{aligned}\n$$\n\nThe result is a true statement, so $(4,16)$ is a solution to the equation.\n\nNext, we substitute $(0,4)$ into the equation:\n\n$$\n\\begin{aligned}y & =3x+4 \\\\ (4) & =3(0)+4 \\\\ 4 & =4\\,✓\\end{aligned}\n$$\n\nThe result is again a true statement, so $(0,4)$ is also a solution to the equation.\n\nFinally, we substitute $(3,12)$ into the equation:\n\n$$\n\\begin{aligned}y & =3x+4 \\\\ (12) & =3(3)+4 \\\\ 12 & =9+4 \\\\ 12 & =13\\,\\times \\end{aligned}\n$$\n\nThe result is a false statement, so $(3,12)$ is *not* a solution to the equation.\n\nSo, out of the three ordered pairs given, the only pair that is *not* a solution to the equation is III $(3,12).$"}] [{:db/id #edb/ref 17592186055294 :knowledge-point/_questions [{:db/id #edb/ref 17592186054693 :knowledge-point/id #uuid "1fe6fbb4-545d-5db8-9042-2c5fac1add72" :knowledge-point/title "Identifying a Solution to a Given Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88347baa-025a-5e5c-88e3-f65b12dcc985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186053002} {:answer/id #uuid "274281c4-e66d-5c6e-997b-024704633ec4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186053003} {:answer/id #uuid "34ab3ba0-2078-5a05-83ec-aead538212ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186053004} {:answer/id #uuid "3c55bc63-3ef4-548e-be83-eda8885a1b2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186053005} {:answer/id #uuid "661b6e44-4a0b-51c7-b6f3-7ea19e81f4d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186053006}] :answer-field/correct {:answer/id #uuid "88347baa-025a-5e5c-88e3-f65b12dcc985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186053002} :answer-field/id #uuid "801abd93-e7bb-54b1-82aa-29f8976c8adc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186053001}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1fbdecf5-4a29-5c6d-93b5-fff79bda9424" :question/math-academy-id "q-44430" :question/problem "Which of the following ordered pairs is **NOT** a solution to $y=\\frac{x}{4}?$\n\nI. $(-8,-2)$\n\nII. $(4,1)$\n\nIII. $(-4,1)$" :question/worked-solution "To check whether each point is a solution to the equation, we substitute it into the equation and see if it results in a true statement.\n\nFirst, we substitute $(-8,-2)$ into the equation:\n\n$$\n\\begin{aligned}y & =\\frac{x}{4} \\\\ (-2) & =\\frac{-8}{4} \\\\ -2 & =-2\\,✓\\end{aligned}\n$$\n\nThe result is a true statement, so $(-8,-2)$ is a solution to the equation.\n\nNext, we substitute $(4,1)$ into the equation:\n\n$$\n\\begin{aligned}y & =\\frac{x}{4} \\\\ (1) & =\\frac{4}{4} \\\\ 1 & =1\\,✓\\end{aligned}\n$$\n\nThe result is again a true statement, so $(4,1)$ is also a solution to the equation.\n\nFinally, we substitute $(-4,1)$ into the equation:\n\n$$\n\\begin{aligned}y & =\\frac{x}{4} \\\\ (1) & =\\frac{-4}{4} \\\\ 1 & =-1\\,\\times \\end{aligned}\n$$\n\nThe result is a false statement, so $(-4,1)$ is *not* a solution to the equation.\n\nSo, out of the three ordered pairs given, the only pair that is *not* a solution to the equation is III $(-4,1).$"}]}
