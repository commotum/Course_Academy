#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186526119} :activity/id #uuid "5079039b-0826-5fc6-9d6a-f79de2e1bc90" :activity/scope {:db/id #edb/ref 17592186049930 :topic/id #uuid "1f64bfc1-4120-531e-ba84-356d2ff12489" :topic/math-academy-id 3556} :activity/steps [{:db/id #edb/ref 17592186526114 :step/content {:db/id #edb/ref 17592186526077 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d9862ce-1b22-570f-b0f4-942e4c99145c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x+2y=-6" :db/id #edb/ref 17592186525234} {:answer/id #uuid "a1bf0da8-5174-5d84-9fff-6819955f9d58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-4y=12" :db/id #edb/ref 17592186525620} {:answer/id #uuid "b5573cbe-d00b-5b1a-afac-e3acdea13510" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x+4y=-12" :db/id #edb/ref 17592186525673} {:answer/id #uuid "df054b8b-fc33-5c83-8433-bf974b2db376" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x-3y=9" :db/id #edb/ref 17592186525759} {:answer/id #uuid "e820943e-5e8a-5dac-9a49-98516b6d45e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x+3y=-9" :db/id #edb/ref 17592186525782}] :answer-field/correct {:db/id #edb/ref 17592186525673} :answer-field/id #uuid "bc62103d-6751-533d-b063-57b196da521e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186525938}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c123720e-2a57-5feb-ae6c-82695ba41c0a" :question/math-academy-id "q-103460" :question/problem "Find the equation of the line that passes through the point $(0,-3)$ and is parallel to the line passing through the points $(-5,1)$ and $(-1,-2).$" :question/worked-solution "Since parallel lines have equal slopes, both lines should have the same slope.\n\nFirst, let's find the slope of the line passing through the points $(-5,1)$ and $(-1,-2):$ \n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{-2-1}{-1-(-5)} \\\\  & =\\frac{-2-1}{-1+5} \\\\  & =-\\frac{3}{4}\\end{aligned}\n$$\n\nTherefore, we wish to find a line that has a slope of $-\\frac{3}{4}$ and passes through the point $(0,-3).$ To find the equation of this line, we use point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-3) & =-\\frac{3}{4}(x-0) \\\\ y+3 & =-\\frac{3}{4}x \\\\ y & =-\\frac{3}{4}x-3\\end{aligned}\n$$\n\nFinally, we write this equation in standard form.\n\n$$\n\\begin{aligned}y & =-\\frac{3}{4}x-3 \\\\ 4y+12 & =-3x \\\\ 3x+4y & =-12\\end{aligned}\n$$"} :step/id #uuid "44951b97-c394-57bb-8663-d8177b69bc9b"} {:db/id #edb/ref 17592186526119 :step/content {:db/id #edb/ref 17592186526002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "343298c1-1018-572c-85ec-68e3a5c1f342" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6x-y=32" :db/id #edb/ref 17592186525337} {:answer/id #uuid "4ce69fd4-a327-5e51-a0e6-eb4d14072113" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+3y=-8" :db/id #edb/ref 17592186525400} {:answer/id #uuid "889c2fba-ec2e-5440-947d-138ca7cc8032" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x+y=22" :db/id #edb/ref 17592186525548} {:answer/id #uuid "ef90eb27-7d23-5eeb-adcd-acb35d8540fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-y=14" :db/id #edb/ref 17592186525801} {:answer/id #uuid "ff6a7a39-f1ee-57dd-973e-1f8fb2ba7b4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+3y=18" :db/id #edb/ref 17592186525845}] :answer-field/correct {:db/id #edb/ref 17592186525801} :answer-field/id #uuid "e8a593e0-a69a-5d2b-b860-de1d3f5a603d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186525962}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "302f16e1-b5b4-533b-be86-52df48d21b76" :question/math-academy-id "q-44539" :question/problem "Find the equation of the line that passes through the point $(6,4)$ and is parallel to $3x-y=7.$" :question/worked-solution "Since parallel lines have equal slopes, the slope of the new line should be equal to the slope of the line $3x-y=7.$ \n\nTo find the slope of the line $3x-y=7,$ we convert the equation to slope-intercept form:\n\n$$\n\\begin{aligned}3x-y & =7 \\\\ y & =3x-7\\end{aligned}\n$$\n\nFrom the slope-intercept form, we can tell that the slope of the line is $3.$\n\nSo, we want a line with the slope $3$ that passes through the point $(6,4).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =3(x-6) \\\\ y-4 & =3x-18 \\\\ y & =3x-14\\end{aligned}\n$$\n\nFinally, we write this equation in standard form.\n\n$$\n\\begin{aligned}y & =3x-14 \\\\ -3x+y & =-14 \\\\ 3x-y & =14\\end{aligned}\n$$"} :step/id #uuid "57ca5c24-c99f-5c8a-8ff1-5467e89e199d" :step/next {:db/id #edb/ref 17592186526132}} {:db/id #edb/ref 17592186526132 :step/content {:db/id #edb/ref 17592186525995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "122f36fc-cfd3-5e68-bafc-e946c196bbf8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x+2" :db/id #edb/ref 17592186525244} {:answer/id #uuid "6183284a-ed2b-51f4-86d0-72274887d6c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2x" :db/id #edb/ref 17592186525452} {:answer/id #uuid "71e5beea-f43c-5902-9cfb-80b31306584d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=x" :db/id #edb/ref 17592186525494} {:answer/id #uuid "9f18766a-4e88-570b-ac9e-ba781886f8c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-2x+2" :db/id #edb/ref 17592186525613} {:answer/id #uuid "b5e2c5af-4ab0-59cb-a568-062c570d0b63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x" :db/id #edb/ref 17592186525675}] :answer-field/correct {:db/id #edb/ref 17592186525675} :answer-field/id #uuid "f4134d17-05ca-571e-a376-892110f9d8d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186525974}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2265e6cf-85f5-580d-8ba4-5b466bbdd76f" :question/math-academy-id "q-72501" :question/problem "Find the equation of the line that passes through the point $(0,0)$ and is parallel to the line passing through the points $(0,-2)$ and $(-2,0).$" :question/worked-solution "Since parallel lines have equal slopes, both lines should have the same slope.\n\nFirst, let's find the slope of the line passing through the points $(0,-2)$ and $(-2,0):$\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{0-(-2)}{-2-0} \\\\  & =-\\frac{2}{2} \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, we wish to find a line that has a slope of $-1$ and passes through the point $(0,0).$ To find the equation of this line, we use the point-slope form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =-1(x-0) \\\\ y & =-x\\end{aligned}\n$$"} :step/id #uuid "92438995-71ab-5c89-b23c-6c43565db6f9" :step/next {:db/id #edb/ref 17592186526114}}] :activity/title "Finding Equations of Parallel Lines" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186525199}]}
