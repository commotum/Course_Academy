\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}],\\,{Σ}_{r}=[\\begin{aligned}2\\sqrt{10} & 0 \\\\ 0 & \\sqrt{10}\\end{aligned}],\\,{V}_{r}=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\n{V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T},\n$$\n\nwhere ${Σ}_{r}^{+}$ is the pseudoinverse of ${Σ}_{r}.$\n\nFirst, notice that\n\n$$\n{Σ}_{r}^{+}=\\frac{1}{2\\sqrt{10}}[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}],\\,{U}_{r}^{T}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}0 & 1 & 3 \\\\ 0 & -3 & 1\\end{aligned}].\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{2\\sqrt{10}}[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}0 & 1 & 3 \\\\ 0 & -3 & 1\\end{aligned}] \\\\  & =\\frac{1}{20}[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]\\cdot [\\begin{aligned}0 & 1 & 3 \\\\ 0 & -3 & 1\\end{aligned}] \\\\  & =\\frac{1}{20}[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]\\cdot [\\begin{aligned}0 & 1 & 3 \\\\ 0 & -3 & 1\\end{aligned}] \\\\  & =\\frac{1}{20}[\\begin{aligned}0 & 1 & 3 \\\\ 0 & -6 & 2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a01449e0-fee7-54b8-bc93-a094ffce75c1"] :db/ensure [:question/validate]} {:db/id "answer-field-a01449e0-fee7-54b8-bc93-a094ffce75c1" :answer-field/id #uuid "a01449e0-fee7-54b8-bc93-a094ffce75c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3c1203aa-43a1-5ff4-889a-1439cc8945c3" :answer-field/choices ["answer-3c1203aa-43a1-5ff4-889a-1439cc8945c3" "answer-7e01a274-8738-5cf2-a673-1055c4c67b97" "answer-32c5eab7-61e5-58ba-983c-a7f55e21301d" "answer-fb51fb6a-1738-5259-951f-347a4793bbda" "answer-73f62c7b-39b6-567c-8e60-5bf5c983d0c9"] :db/ensure [:answer-field/validate]} {:db/id "answer-3c1203aa-43a1-5ff4-889a-1439cc8945c3" :answer/id #uuid "3c1203aa-43a1-5ff4-889a-1439cc8945c3" :answer/type :answer.type/math :answer/value "\\frac{1}{20}[\\begin{aligned}0 & 1 & 3 \\\\ 0 & -6 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-7e01a274-8738-5cf2-a673-1055c4c67b97" :answer/id #uuid "7e01a274-8738-5cf2-a673-1055c4c67b97" :answer/type :answer.type/math :answer/value "\\frac{1}{20}[\\begin{aligned}0 & 1 \\\\ 3 & 0 \\\\ -6 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-32c5eab7-61e5-58ba-983c-a7f55e21301d" :answer/id #uuid "32c5eab7-61e5-58ba-983c-a7f55e21301d" :answer/type :answer.type/math :answer/value "\\frac{1}{20}[\\begin{aligned}0 & 3 & 1 \\\\ 0 & 2 & -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-fb51fb6a-1738-5259-951f-347a4793bbda" :answer/id #uuid "fb51fb6a-1738-5259-951f-347a4793bbda" :answer/type :answer.type/math :answer/value "\\frac{1}{20}[\\begin{aligned}1 & 0 \\\\ 3 & 0 \\\\ -2 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-73f62c7b-39b6-567c-8e60-5bf5c983d0c9" :answer/id #uuid "73f62c7b-39b6-567c-8e60-5bf5c983d0c9" :answer/type :answer.type/math :answer/value "\\frac{1}{20}[\\begin{aligned}3 & 1 & 0 \\\\ 2 & -6 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-f2315875-6b0f-5492-8e9e-75741c68b770" :question/id #uuid "f2315875-6b0f-5492-8e9e-75741c68b770" :question/math-academy-id "q-138658" :question/problem "$$\n{U}_{r}=[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}],\\,{Σ}_{r}=[\\begin{aligned}2\\sqrt{5}\\end{aligned}],\\,{V}_{r}=[\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" :question/worked-solution "If $A={U}_{r}{Σ}_{r}{V}_{r}^{T}$ is a reduced singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\n{V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T},\n$$\n\nwhere ${Σ}_{r}^{+}$ is the pseudoinverse of ${Σ}_{r}.$\n\nFirst, notice that\n\n$$\n{V}_{r}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}],\\,{Σ}_{r}^{+}=\\frac{1}{2\\sqrt{5}}[\\begin{aligned}1\\end{aligned}],\\,{U}_{r}^{T}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 & -1\\end{aligned}].\n$$\n\n \n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & ={V}_{r}\\,{Σ}_{r}^{+}\\,{U}_{r}^{T} \\\\  & =\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\cdot \\frac{1}{2\\sqrt{5}}[\\begin{aligned}1\\end{aligned}]\\cdot \\frac{1}{\\sqrt{2}}[\\begin{aligned}1 & -1\\end{aligned}] \\\\  & =\\frac{1}{20}[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\cdot [\\begin{aligned}1\\end{aligned}]\\cdot [\\begin{aligned}1 & -1\\end{aligned}] \\\\  & =\\frac{1}{20}[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\cdot [\\begin{aligned}1 & -1\\end{aligned}] \\\\  & =\\frac{1}{20}[\\begin{aligned}1 & -1 \\\\ 3 & -3\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3d63e1b9-0a9f-5b44-a041-bc2d944d4dee"] :db/ensure [:question/validate]} {:db/id "answer-field-3d63e1b9-0a9f-5b44-a041-bc2d944d4dee" :answer-field/id #uuid "3d63e1b9-0a9f-5b44-a041-bc2d944d4dee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2e553566-a4fb-554e-8652-c4ff524a08ac" :answer-field/choices ["answer-efe97a60-f805-5797-98cb-412041423fd9" "answer-ac6598fd-20cd-597a-8708-3c1fffbbe65f" "answer-2e553566-a4fb-554e-8652-c4ff524a08ac" "answer-4fcafdf4-daf9-5fb3-9853-a3d9f99769a5" "an