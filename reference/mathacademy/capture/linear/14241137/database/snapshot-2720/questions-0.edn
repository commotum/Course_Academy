#{[{:db/id #edb/ref 17592186559787 :knowledge-point/_questions [{:db/id #edb/ref 17592186068878 :knowledge-point/id #uuid "3af5fb92-f8bf-5cda-94b7-72d8ad15fc79" :knowledge-point/title "Solving Perfect Square Quadratic Equations With Leading Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07157920-abd5-5bf2-a352-0cf1e00e0462" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186559030} {:answer/id #uuid "12e36eca-3675-577b-9ee7-798a0a376d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186559059} {:answer/id #uuid "5a9cd8c6-701e-5a0f-89c0-f811b41febe9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm 3" :db/id #edb/ref 17592186559250} {:answer/id #uuid "b1f70480-6564-5dbe-8439-da4c15dc9c7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186559460} {:answer/id #uuid "c101184b-a1da-5275-90f3-849ec9155b99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm 6" :db/id #edb/ref 17592186559490}] :answer-field/correct {:answer/id #uuid "5a9cd8c6-701e-5a0f-89c0-f811b41febe9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm 3" :db/id #edb/ref 17592186559250} :answer-field/id #uuid "1271505d-716e-5d6d-a0d2-c688dce6429b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559650}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22229a6c-eb9f-551d-9867-ebd127134155" :question/math-academy-id "q-12785" :question/problem "Use the difference of squares method to solve the equation $4{k}^{2}-36=0.$" :question/worked-solution "Before we start our normal process of factoring, notice that all of the terms have a common factor of $4.$ Therefore, we can simplify the expression by factoring out $4,$ as follows:\n\n$$\n4{k}^{2}-36=4({k}^{2}-9)\n$$\n\nNow, let's factor the expression inside parentheses using the difference of squares formula:\n\n$$\n\\begin{aligned}4({k}^{2}-9) & =0 \\\\ 4({k}^{2}-{3}^{2}) & =0 \\\\ 4(k-3)(k+3) & =0\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\nk-3=0\\,\\text{or}\\,k+3=0,\n$$\n\nwhich in turn gives\n\n$$\nk=3\\,\\text{or}\\,k=-3.\n$$\n\nTherefore, the solutions are $k=-3,3.$ We can write this even more concisely as $k=\\pm 3.$"}] [{:db/id #edb/ref 17592186559781 :knowledge-point/_questions [{:db/id #edb/ref 17592186068879 :knowledge-point/id #uuid "70100cca-afbd-5fc2-83ce-760342a03364" :knowledge-point/title "Solving Perfect Square Quadratic Equations by Reorganizing and Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d8c45c0-f456-5018-a401-f5b8c6c0145e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{5}{4}" :db/id #edb/ref 17592186559088} {:answer/id #uuid "1f67d2a4-0336-5ce5-9f20-b8c50799aee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{2}{5}" :db/id #edb/ref 17592186559093} {:answer/id #uuid "225758a5-6eb6-5e61-b1e2-66c86e0d5afa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{1}{2}" :db/id #edb/ref 17592186559097} {:answer/id #uuid "d466eb8b-ab50-5f71-b7e6-a93daf8fc8a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{3}{2}" :db/id #edb/ref 17592186559538} {:answer/id #uuid "f2b1a9b9-ef17-58b0-9243-95a3a967a631" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{5}{2}" :db/id #edb/ref 17592186559607}] :answer-field/correct {:answer/id #uuid "f2b1a9b9-ef17-58b0-9243-95a3a967a631" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{5}{2}" :db/id #edb/ref 17592186559607} :answer-field/id #uuid "e2131dde-8f57-5325-b5c9-e3e9de599f08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559756}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1bf2ec1b-375e-51fb-ba57-6d1d010ff509" :question/math-academy-id "q-23553" :question/problem "Use the difference of squares method to solve the equation $4{x}^{2}=25.$" :question/worked-solution "First, we move all of the terms to the left-hand side and collect the like terms:\n\n$$\n\\begin{aligned}4{x}^{2} & =25 \\\\ 4{x}^{2}-25 & =0\\end{aligned}\n$$\n\nNow, using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}4{x}^{2}-25 & =0 \\\\ (2x)^{2}-(5)^{2} & =0 \\\\ (2x-5)(2x+5) & =0\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n2x-5=0\\,\\text{or}\\,2x+5=0.\n$$\n\nThen, we solve each equation separately:\n\n$$\n\\begin{aligned}2x-5 & =0 & \\, & \\, & 2x+5 & =0 \\\\ 2x & =5 & \\, & \\, & 2x & =-5 \\\\ x & =\\frac{5}{2} & \\, & \\, & x & =-\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-\\frac{5}{2},\\frac{5}{2}.$ We can write this even more concisely as $x=\\pm \\frac{5}{2}.$"}] [{:db/id #edb/ref 17592186559856 :knowledge-point/_questions [{:db/id #edb/ref 17592186068878 :knowledge-point/id #uuid "3af5fb92-f8bf-5cda-94b7-72d8ad15fc79" :knowledge-point/title "Solving Perfect Square Quadratic Equations With Leading Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c015956-8ceb-574e-b57d-7e90e9485963" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j=\\pm \\frac{7}{8}" :db/id #edb/ref 17592186559283} {:answer/id #uuid "7d4ea996-7e02-5985-abd5-43d8ffcc57a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j=\\pm \\frac{4}{7}" :db/id #edb/ref 17592186559328} {:answer/id #uuid "bb60f34e-6211-5013-859c-8c21ceaeecc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j=\\pm \\frac{8}{7}" :db/id #edb/ref 17592186559481} {:answer/id #uuid "d2f41667-d9e5-5380-ba9f-472a87707f29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j=\\pm \\frac{7}{4}" :db/id #edb/ref 17592186559535} {:answer/id #uuid "f694123a-9481-5f13-bad5-eb94fed69a96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j=\\pm \\frac{16}{7}" :db/id #edb/ref 17592186559625}] :answer-field/correct {:answer/id #uuid "bb60f34e-6211-5013-859c-8c21ceaeecc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "j=\\pm \\frac{8}{7}" :db/id #edb/ref 17592186559481} :answer-field/id #uuid "20c66023-fe7d-5634-bdab-140e09291918" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559656}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c2c62744-4e6e-5285-9246-bd3c3e1b0773" :question/math-academy-id "q-3131" :question/problem "Use the difference of squares method to solve the equation $49{j}^{2}-64=0.$" :question/worked-solution "Using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}49{j}^{2}-64 & =0 \\\\ (7j)^{2}-{8}^{2} & =0 \\\\ (7j-8)(7j+8) & =0\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n7j-8=0\\,\\text{or}\\,7j+8=0.\n$$\n\nThen, we solve each equation separately:\n\n$$\n\\begin{aligned}7j-8 & =0 & \\, & \\, & 7j+8 & =0 \\\\ 7j & =8 & \\, & \\, & 7j & =-8 \\\\ j & =\\frac{8}{7} & \\, & \\, & j & =-\\frac{8}{7}\\end{aligned}\n$$\n\nTherefore, the solutions are $j=-\\frac{8}{7},\\frac{8}{7}.$ We can write this even more concisely as $j=\\pm \\frac{8}{7}.$"}]}
