#{[{:activity/first-step {:db/id #edb/ref 17592186069840} :activity/id #uuid "34bc121a-11b5-50d2-b626-7f80c9f81c46" :activity/scope {:db/id #edb/ref 17592186048157 :topic/id #uuid "83bad3df-40e8-5e95-ad95-39947df5a5ac" :topic/math-academy-id 394} :activity/steps [{:db/id #edb/ref 17592186069840 :step/content {:db/id #edb/ref 17592186069945 :tutorial/content "Suppose we have a quadratic equation like\n$x^2-25 = 0$.\nWe can solve this equation using the **difference of squares** formula, shown below:\n\n$$\n{\\color{red}a}^2 - {\\color{blue}b}^2 = ({\\color{red}a}+{\\color{blue}b})({\\color{red}a}-{\\color{blue}b})\n$$\n\nUsing the difference of squares formula, we can factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}\nx^{2} - 25 &= 0 \\\\\nx^{2} - 5^{2} &= 0 \\\\\n(x + 5)(x - 5) &= 0\n\\end{aligned}\n$$\n\nFinally, we apply the zero product rule to get\n\n$$\nx+5=0 \\qquad\\text{or}\\qquad x-5=0\n$$\n\nwhich in turn gives\n\n$$\nx=-5 \\qquad\\text{or}\\qquad x=5\n$$\n\nTherefore, the solutions are $x=-5,5$. We can write this even more concisely as $x=\\pm 5$.\n\n**Note:** We could have solved the equation $x^2-25=0$ using the square root method. However, the factoring method introduced in this lesson will become very useful later when we move on to more complicated quadratic equations. Make sure that you learn it!" :tutorial/id #uuid "0e80849d-fec5-5167-8b39-902cd2d825ef" :tutorial/math-academy-id 1623 :tutorial/title "Introduction"} :step/id #uuid "44b39091-c3ce-5da7-935a-b6a8e7f88bf6" :step/math-academy-id 460445 :step/next {:db/id #edb/ref 17592186069841}} {:db/id #edb/ref 17592186069841 :step/content {:db/id #edb/ref 17592186068877 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068484 :question/id #uuid "8a5c740c-4719-5ebc-a5e3-0b82a2450521" :question/math-academy-id "e-1413"} :knowledge-point/id #uuid "50a815eb-f3d9-5ac7-bf15-2e28894e8910" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048928} {:db/id #edb/ref 17592186050845}] :knowledge-point/questions [{:db/id #edb/ref 17592186069142} {:db/id #edb/ref 17592186069143} {:db/id #edb/ref 17592186069529}] :knowledge-point/title "Solving Perfect Square Quadratic Equations"} :step/id #uuid "387068d5-e460-551c-9a0f-ef1602e7f7f9" :step/math-academy-id 460446 :step/next {:db/id #edb/ref 17592186069842}} {:db/id #edb/ref 17592186069842 :step/content {:db/id #edb/ref 17592186068878 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068485 :question/id #uuid "74c951a8-5bd6-5296-af9e-4f7a5f4008c4" :question/math-academy-id "e-1414"} :knowledge-point/id #uuid "3af5fb92-f8bf-5cda-94b7-72d8ad15fc79" :knowledge-point/questions [{:db/id #edb/ref 17592186069035} {:db/id #edb/ref 17592186069144} {:db/id #edb/ref 17592186069145} {:db/id #edb/ref 17592186534997} {:db/id #edb/ref 17592186559787} {:db/id #edb/ref 17592186559856}] :knowledge-point/title "Solving Perfect Square Quadratic Equations With Leading Coefficients"} :step/id #uuid "7e0d8a37-ec5c-5b5c-a24c-b05472a5add4" :step/math-academy-id 460450 :step/next {:db/id #edb/ref 17592186069843}} {:db/id #edb/ref 17592186069843 :step/content {:db/id #edb/ref 17592186068879 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068488 :question/id #uuid "be3c2628-847c-5b00-a7ea-7881c8805aa8" :question/math-academy-id "e-1416"} :knowledge-point/id #uuid "70100cca-afbd-5fc2-83ce-760342a03364" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048524}] :knowledge-point/questions [{:db/id #edb/ref 17592186069146} {:db/id #edb/ref 17592186069168} {:db/id #edb/ref 17592186069185} {:db/id #edb/ref 17592186535021} {:db/id #edb/ref 17592186535085} {:db/id #edb/ref 17592186559781}] :knowledge-point/title "Solving Perfect Square Quadratic Equations by Reorganizing and Factoring"} :step/id #uuid "393a0e1c-9694-5613-967a-4569b3f7a14f" :step/math-academy-id 460454}] :activity/title "Solving Quadratic Equations Using a Difference of Squares" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068940}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186535134} :activity/id #uuid "cc3bb6b8-928e-5335-a818-2702f23810ea" :activity/scope {:db/id #edb/ref 17592186048157 :topic/id #uuid "83bad3df-40e8-5e95-ad95-39947df5a5ac" :topic/math-academy-id 394} :activity/steps [{:db/id #edb/ref 17592186535104 :step/content {:db/id #edb/ref 17592186535021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7363154c-84f1-50eb-a664-4c273bbb58c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{\\sqrt{10}}{7}" :db/id #edb/ref 17592186534511} {:answer/id #uuid "8ec6ff9a-236c-5222-9a36-a98ddc2fec27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{7}{10}" :db/id #edb/ref 17592186534577} {:answer/id #uuid "b911aa7c-d630-5d40-a422-58c6b53d97f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\sqrt{\\frac{7}{10}}" :db/id #edb/ref 17592186534678} {:answer/id #uuid "bcde4af1-a530-531b-be8b-3a0aa122b238" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{\\sqrt{7}}{10}" :db/id #edb/ref 17592186534687} {:answer/id #uuid "ccd2a13c-9442-5d35-a48b-3bbad053d7bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{10}{7}" :db/id #edb/ref 17592186534722}] :answer-field/correct {:db/id #edb/ref 17592186534687} :answer-field/id #uuid "ab8d9acb-6fc3-559a-a240-a008f18351b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534928}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6bcd8b40-daaf-5baf-a297-367e7c76cde5" :question/math-academy-id "q-44216" :question/problem "Use the difference of squares method to solve the equation $100{x}^{2}=7.$" :question/worked-solution "First, we move all of the terms to the left-hand side and collect the like terms:\n\n$$\n\\begin{aligned}100{x}^{2} & =7 \\\\ 100{x}^{2}-7 & =0\\end{aligned}\n$$\n\nNow, using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}100{x}^{2}-7 & =0 \\\\ (10x)^{2}-{(\\sqrt{7})}^{2} & =0 \\\\ (10x-\\sqrt{7})(10x+\\sqrt{7}) & =0\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n10x-\\sqrt{7}=0\\,\\text{or}\\,10x+\\sqrt{7}=0.\n$$\n\nThen, we solve each equation separately:\n\n$$\n\\begin{aligned}10x-\\sqrt{7} & =0 & \\, & \\, & 10x+\\sqrt{7} & =0 \\\\ 10x & =\\sqrt{7} & \\, & \\, & 10x & =-\\sqrt{7} \\\\ x & =\\frac{\\sqrt{7}}{10} & \\, & \\, & x & =-\\frac{\\sqrt{7}}{10}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-\\frac{\\sqrt{7}}{10},\\frac{\\sqrt{7}}{10}.$ We can write this even more concisely as $x=\\pm \\frac{\\sqrt{7}}{10}.$"} :step/id #uuid "314b4754-6b4d-5560-bc0e-1a66b0c11feb" :step/next {:db/id #edb/ref 17592186535138}} {:db/id #edb/ref 17592186535134 :step/content {:db/id #edb/ref 17592186535085 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d8327b6-7b01-5a19-936b-ca09e8613a7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=-\\frac{5}{2}" :db/id #edb/ref 17592186534382} {:answer/id #uuid "7d1a02f4-ee95-57b6-97e6-2580b8e0c2e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=0,\\frac{5}{2}" :db/id #edb/ref 17592186534534} {:answer/id #uuid "8de39a43-8ede-5187-ba08-b187507759ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=\\pm \\frac{5}{2}" :db/id #edb/ref 17592186534572} {:answer/id #uuid "d6d3906e-8813-5496-bc23-8f6231b7e268" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=2,5" :db/id #edb/ref 17592186534751} {:answer/id #uuid "ee107525-6275-5cbd-ab75-f56bf4255a19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "p=\\pm \\frac{2}{5}" :db/id #edb/ref 17592186534794}] :answer-field/correct {:db/id #edb/ref 17592186534572} :answer-field/id #uuid "c9e8053f-1d19-507b-ae24-2f03876f5694" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534942}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f49a62d5-679a-524a-aa83-c1365bd71520" :question/math-academy-id "q-12786" :question/problem "Use the difference of squares method to solve the equation $p$ is $4{p}^{2}=25.$" :question/worked-solution "First, we move all of the terms to the left-hand side and collect the like terms:\n\n$$\n\\begin{aligned}4{p}^{2} & =25 \\\\ 4{p}^{2}-25 & =0\\end{aligned}\n$$\n\nNow, using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}4{p}^{2}-25 & =0 \\\\ (2p)^{2}-{5}^{2} & =0 \\\\ (2p-5)(2p+5) & =0\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n2p-5=0\\,\\text{or}\\,2p+5=0.\n$$\n\nThen, we solve each equation separately:\n\n$$\n\\begin{aligned}2p-5 & =0 & \\, & \\, & 2p+5 & =0 \\\\ 2p & =5 & \\, & \\, & 2p & =-5 \\\\ p & =\\frac{5}{2} & \\, & \\, & p & =-\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the solutions are $p=-\\frac{5}{2},\\frac{5}{2}.$ We can write this even more concisely as $p=\\pm \\frac{5}{2}.$"} :step/id #uuid "d43a116c-df02-565c-9c0d-c8994337e176" :step/next {:db/id #edb/ref 17592186535104}} {:db/id #edb/ref 17592186535138 :step/content {:db/id #edb/ref 17592186534997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34c8611d-f4d0-5fc3-bc5b-7bb9b1dcfd80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\pm \\frac{9}{4}" :db/id #edb/ref 17592186534365} {:answer/id #uuid "6810cf2e-dde9-5c88-ba30-9bf1db5e3988" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{2}{9}" :db/id #edb/ref 17592186534475} {:answer/id #uuid "7e5080fb-4356-5e0d-810b-29ca0123aff1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\pm \\frac{9}{2}" :db/id #edb/ref 17592186534538} {:answer/id #uuid "c793206a-9ed2-5ff6-90f1-25919555ed3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\pm \\frac{81}{16}" :db/id #edb/ref 17592186534713} {:answer/id #uuid "d7fe1427-aadb-56ed-9930-60e09e59d9b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{81}{16}" :db/id #edb/ref 17592186534753}] :answer-field/correct {:db/id #edb/ref 17592186534365} :answer-field/id #uuid "ced7671a-bc8b-5661-8f1a-fdc445d654be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534945}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "36228bc3-c8df-58ee-9fb1-b8814e29ddd8" :question/math-academy-id "q-111997" :question/problem "Use the difference of squares method to solve the equation $16{y}^{2}-81=0.$" :question/worked-solution "Using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}16{y}^{2}-81 & =0 \\\\ (4y)^{2}-(9)^{2} & =0 \\\\ (4y-9)(4y+9) & =0\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n4y-9=0\\,\\text{or}\\,4y+9=0.\n$$\n\nThen, we solve each equation separately:\n\n$$\n\\begin{aligned}4y-9 & =0 & \\, & \\, & 4y+9 & =0 \\\\ 4y & =9 & \\, & \\, & 4y & =-9 \\\\ y & =\\frac{9}{4} & \\, & \\, & y & =-\\frac{9}{4}\\end{aligned}\n$$\n\nTherefore, the solutions are $y=-\\frac{9}{4},\\frac{9}{4}.$ We can write this even more concisely as $y=\\pm \\frac{9}{4}.$"} :step/id #uuid "df79d613-c2bb-5858-bb0e-95831b62fe81"}] :activity/title "Solving Quadratic Equations Using a Difference of Squares" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186534262}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186559909} :activity/id #uuid "a332065b-8d89-5ece-8df1-c8721027cb7f" :activity/scope {:db/id #edb/ref 17592186048157 :topic/id #uuid "83bad3df-40e8-5e95-ad95-39947df5a5ac" :topic/math-academy-id 394} :activity/steps [{:db/id #edb/ref 17592186559909 :step/content {:db/id #edb/ref 17592186559856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c015956-8ceb-574e-b57d-7e90e9485963" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "j=\\pm \\frac{7}{8}" :db/id #edb/ref 17592186559283} {:answer/id #uuid "7d4ea996-7e02-5985-abd5-43d8ffcc57a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "j=\\pm \\frac{4}{7}" :db/id #edb/ref 17592186559328} {:answer/id #uuid "bb60f34e-6211-5013-859c-8c21ceaeecc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "j=\\pm \\frac{8}{7}" :db/id #edb/ref 17592186559481} {:answer/id #uuid "d2f41667-d9e5-5380-ba9f-472a87707f29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "j=\\pm \\frac{7}{4}" :db/id #edb/ref 17592186559535} {:answer/id #uuid "f694123a-9481-5f13-bad5-eb94fed69a96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "j=\\pm \\frac{16}{7}" :db/id #edb/ref 17592186559625}] :answer-field/correct {:db/id #edb/ref 17592186559481} :answer-field/id #uuid "20c66023-fe7d-5634-bdab-140e09291918" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559656}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c2c62744-4e6e-5285-9246-bd3c3e1b0773" :question/math-academy-id "q-3131" :question/problem "Use the difference of squares method to solve the equation $49{j}^{2}-64=0.$" :question/worked-solution "Using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}49{j}^{2}-64 & =0 \\\\ (7j)^{2}-{8}^{2} & =0 \\\\ (7j-8)(7j+8) & =0\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n7j-8=0\\,\\text{or}\\,7j+8=0.\n$$\n\nThen, we solve each equation separately:\n\n$$\n\\begin{aligned}7j-8 & =0 & \\, & \\, & 7j+8 & =0 \\\\ 7j & =8 & \\, & \\, & 7j & =-8 \\\\ j & =\\frac{8}{7} & \\, & \\, & j & =-\\frac{8}{7}\\end{aligned}\n$$\n\nTherefore, the solutions are $j=-\\frac{8}{7},\\frac{8}{7}.$ We can write this even more concisely as $j=\\pm \\frac{8}{7}.$"} :step/id #uuid "2b77aa42-833d-5567-ba4d-f232dd423a6b" :step/next {:db/id #edb/ref 17592186559981}} {:db/id #edb/ref 17592186559947 :step/content {:db/id #edb/ref 17592186559781 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d8c45c0-f456-5018-a401-f5b8c6c0145e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{5}{4}" :db/id #edb/ref 17592186559088} {:answer/id #uuid "1f67d2a4-0336-5ce5-9f20-b8c50799aee4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{2}{5}" :db/id #edb/ref 17592186559093} {:answer/id #uuid "225758a5-6eb6-5e61-b1e2-66c86e0d5afa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{1}{2}" :db/id #edb/ref 17592186559097} {:answer/id #uuid "d466eb8b-ab50-5f71-b7e6-a93daf8fc8a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{3}{2}" :db/id #edb/ref 17592186559538} {:answer/id #uuid "f2b1a9b9-ef17-58b0-9243-95a3a967a631" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\pm \\frac{5}{2}" :db/id #edb/ref 17592186559607}] :answer-field/correct {:db/id #edb/ref 17592186559607} :answer-field/id #uuid "e2131dde-8f57-5325-b5c9-e3e9de599f08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559756}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1bf2ec1b-375e-51fb-ba57-6d1d010ff509" :question/math-academy-id "q-23553" :question/problem "Use the difference of squares method to solve the equation $4{x}^{2}=25.$" :question/worked-solution "First, we move all of the terms to the left-hand side and collect the like terms:\n\n$$\n\\begin{aligned}4{x}^{2} & =25 \\\\ 4{x}^{2}-25 & =0\\end{aligned}\n$$\n\nNow, using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}4{x}^{2}-25 & =0 \\\\ (2x)^{2}-(5)^{2} & =0 \\\\ (2x-5)(2x+5) & =0\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n2x-5=0\\,\\text{or}\\,2x+5=0.\n$$\n\nThen, we solve each equation separately:\n\n$$\n\\begin{aligned}2x-5 & =0 & \\, & \\, & 2x+5 & =0 \\\\ 2x & =5 & \\, & \\, & 2x & =-5 \\\\ x & =\\frac{5}{2} & \\, & \\, & x & =-\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-\\frac{5}{2},\\frac{5}{2}.$ We can write this even more concisely as $x=\\pm \\frac{5}{2}.$"} :step/id #uuid "847fa0d2-e5ef-5701-9540-0f72c70df40e"} {:db/id #edb/ref 17592186559981 :step/content {:db/id #edb/ref 17592186559787 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07157920-abd5-5bf2-a352-0cf1e00e0462" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=3" :db/id #edb/ref 17592186559030} {:answer/id #uuid "12e36eca-3675-577b-9ee7-798a0a376d8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=6" :db/id #edb/ref 17592186559059} {:answer/id #uuid "5a9cd8c6-701e-5a0f-89c0-f811b41febe9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=\\pm 3" :db/id #edb/ref 17592186559250} {:answer/id #uuid "b1f70480-6564-5dbe-8439-da4c15dc9c7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=-3" :db/id #edb/ref 17592186559460} {:answer/id #uuid "c101184b-a1da-5275-90f3-849ec9155b99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "k=\\pm 6" :db/id #edb/ref 17592186559490}] :answer-field/correct {:db/id #edb/ref 17592186559250} :answer-field/id #uuid "1271505d-716e-5d6d-a0d2-c688dce6429b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559650}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "22229a6c-eb9f-551d-9867-ebd127134155" :question/math-academy-id "q-12785" :question/problem "Use the difference of squares method to solve the equation $4{k}^{2}-36=0.$" :question/worked-solution "Before we start our normal process of factoring, notice that all of the terms have a common factor of $4.$ Therefore, we can simplify the expression by factoring out $4,$ as follows:\n\n$$\n4{k}^{2}-36=4({k}^{2}-9)\n$$\n\nNow, let's factor the expression inside parentheses using the difference of squares formula:\n\n$$\n\\begin{aligned}4({k}^{2}-9) & =0 \\\\ 4({k}^{2}-{3}^{2}) & =0 \\\\ 4(k-3)(k+3) & =0\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\nk-3=0\\,\\text{or}\\,k+3=0,\n$$\n\nwhich in turn gives\n\n$$\nk=3\\,\\text{or}\\,k=-3.\n$$\n\nTherefore, the solutions are $k=-3,3.$ We can write this even more concisely as $k=\\pm 3.$"} :step/id #uuid "f184aec9-5e96-5e74-9416-ea4e8754a3ed" :step/next {:db/id #edb/ref 17592186559947}}] :activity/title "Solving Quadratic Equations Using a Difference of Squares" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186559006}]}
