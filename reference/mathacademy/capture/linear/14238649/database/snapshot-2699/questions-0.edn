#{[{:db/id #edb/ref 17592186557259 :knowledge-point/_questions [{:db/id #edb/ref 17592186096842 :knowledge-point/id #uuid "2f0cdac9-57b2-5634-8d98-d6adf8a85204" :knowledge-point/title "Differentiating a Radical Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49385517-eeac-5b31-adab-df094762881b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186556593} {:answer/id #uuid "604e0e8a-a825-50c3-a298-9ae13e709a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186556648} {:answer/id #uuid "9404be8d-cb6c-53b2-8a36-eb362e775360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186556786} {:answer/id #uuid "95cb350d-4388-53ea-9992-f43b19639582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186556791} {:answer/id #uuid "9b3dc5f8-2374-5afe-8f07-96ed5f7a5da8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186556807}] :answer-field/correct {:answer/id #uuid "49385517-eeac-5b31-adab-df094762881b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186556593} :answer-field/id #uuid "add9725c-6d77-5248-a0ae-02fe439fa683" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557163}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "67f07fb8-cc06-5cda-9a1f-cc029f68242d" :question/math-academy-id "q-107288" :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{2x+1}$ at the point where $x=4.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=2x+1.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot 2 \\\\  & =\\frac{1}{\\sqrt{2x+1}}.\\end{aligned}\n$$\n\nFinally, substituting $x=4,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=4} & ={(\\frac{1}{\\sqrt{2x+1}})|}_{x=4} \\\\  & =\\frac{1}{\\sqrt{2(4)+1}} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186557301 :knowledge-point/_questions [{:db/id #edb/ref 17592186096843 :knowledge-point/id #uuid "0a312840-0d35-50bb-94b3-b04778f4efc3" :knowledge-point/title "Differentiating a Function Using the Chain Rule and Prime Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c368e94-1966-5731-867b-0babe7d75b00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36(6x-5)^{5}" :db/id #edb/ref 17592186556637}] :answer-field/correct {:answer/id #uuid "5c368e94-1966-5731-867b-0babe7d75b00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36(6x-5)^{5}" :db/id #edb/ref 17592186556637} :answer-field/id #uuid "258869c8-85b7-5a80-8cff-298b4785a0ca" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186557088}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1385fb4-0635-5e4c-a92d-2175e82b7bcc" :question/math-academy-id "q-314205" :question/problem "Given that $f(x)={(6x-5)}^{6},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Let $g(x)=6x-5$ and $f(g(x))=g(x)^{6}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{6})^{′}=6{g}^{5}, \\\\ {g}^{′}(x) & =(6x-5)^{′}=6.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =6{g}^{5}\\cdot (6) \\\\  & =36(6x-5)^{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186557214 :knowledge-point/_questions [{:db/id #edb/ref 17592186096843 :knowledge-point/id #uuid "0a312840-0d35-50bb-94b3-b04778f4efc3" :knowledge-point/title "Differentiating a Function Using the Chain Rule and Prime Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0576b7ba-7b60-5cde-90eb-b7b6e9fa9cd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(2x-11)^{5}" :db/id #edb/ref 17592186556443} {:answer/id #uuid "13af737a-117c-5f32-93ba-e6c9200ca3d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12(x-11)^{5}" :db/id #edb/ref 17592186556472} {:answer/id #uuid "1fb99734-0a8c-580d-a0f8-4954f321ea9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6(2x-11)^{5}" :db/id #edb/ref 17592186556506} {:answer/id #uuid "97c20d2c-d45f-5b09-9f39-ebe08248b75a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12(2x-11)^{6}" :db/id #edb/ref 17592186556794} {:answer/id #uuid "a776abf8-3706-5639-a382-e250cca33636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12(2x-11)^{5}" :db/id #edb/ref 17592186556844}] :answer-field/correct {:answer/id #uuid "a776abf8-3706-5639-a382-e250cca33636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12(2x-11)^{5}" :db/id #edb/ref 17592186556844} :answer-field/id #uuid "9164d315-5789-5468-b831-e821976b6b32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557148}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1b4d3073-0a5e-5d32-b8ba-a307535b4915" :question/math-academy-id "q-71958" :question/problem "Given that $f(x)={(2x-11)}^{6},$ find ${f}^{′}(x).$" :question/worked-solution "Let $g(x)=2x-11$ and $f(g(x))=g(x)^{6}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{6})^{′}=6{g}^{5}, \\\\ {g}^{′}(x) & =(2x-11)^{′}=2.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =6{g}^{5}\\cdot 2 \\\\  & =12(2x-11)^{5}.\\end{aligned}\n$$"}]}
