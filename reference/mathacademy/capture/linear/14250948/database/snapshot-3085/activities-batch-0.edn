-id 18884}] :activity/title "Multiplying Rational Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068966}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186571506} :activity/id #uuid "27e9e25a-2aaf-54f0-94f8-e33678265838" :activity/scope {:db/id #edb/ref 17592186049079 :topic/id #uuid "d8e5a8ad-8cb3-52d6-a4cb-aee78ee0ea22" :topic/math-academy-id 435} :activity/steps [{:db/id #edb/ref 17592186571486 :step/content {:db/id #edb/ref 17592186571383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2129eca9-41b2-52ac-b8b6-7fe532a6f1a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2m}{n}" :db/id #edb/ref 17592186570939} {:answer/id #uuid "e3690399-bbec-58fd-9326-6e1c850caaec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{m}^{2}n" :db/id #edb/ref 17592186571243} {:answer/id #uuid "e712eb0b-a24a-5541-92fe-3fbeea68f3c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{mn}{2}" :db/id #edb/ref 17592186571250} {:answer/id #uuid "f6eec2bc-b07f-5f43-9293-6db9b9bdfd6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{m}{2n}" :db/id #edb/ref 17592186571262} {:answer/id #uuid "f6f38e53-7016-50e4-8db9-6b4499c1191d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2mn" :db/id #edb/ref 17592186571263}] :answer-field/correct {:db/id #edb/ref 17592186571263} :answer-field/id #uuid "d4153628-bfae-591c-b4db-ba1a90ddf18c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571360}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "24ce9bfc-b18d-5480-9cb5-cbc49bc8a5b3" :question/math-academy-id "q-79537" :question/problem "$\\frac{{m}^{3}}{2n}\\cdot \\frac{4{n}^{2}}{{m}^{2}}=$" :question/worked-solution "We multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{{m}^{3}}{2n}\\cdot \\frac{4{n}^{2}}{{m}^{2}} & =\\frac{{m}^{3}\\cdot 4{n}^{2}}{2n\\cdot {m}^{2}} \\\\  & =\\frac{4{m}^{3}{n}^{2}}{2n{m}^{2}} \\\\  & =2mn\\end{aligned}\n$$\n\n**Note:** In the above example, we performed some cancellations after multiplying. However, with more complex expressions, it's often easier to cancel *before* multiplying."} :step/id #uuid "6b7b7c3c-945b-5043-9605-e55caf998f05"} {:db/id #edb/ref 17592186571494 :step/content {:db/id #edb/ref 17592186571444 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0195c8a0-e51d-57d7-8eb2-6d0f023ae0f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s+3t" :db/id #edb/ref 17592186570896} {:answer/id #uuid "47d058ba-3f4a-54da-803b-0c9951e9f506" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2(s+t)" :db/id #edb/ref 17592186571004} {:answer/id #uuid "66f964ee-b306-500a-be24-01d739011b33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186571050} {:answer/id #uuid "a01f7011-4ff1-5e0c-a207-b83d44f6a914" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186571138} {:answer/id #uuid "ee61a300-c861-587f-9d5f-72e4ab2fadc7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s-t" :db/id #edb/ref 17592186571256}] :answer-field/correct {:db/id #edb/ref 17592186571050} :answer-field/id #uuid "3b01523f-b152-5388-b26f-feab157c056e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571305}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dc1c51cf-df21-5c5d-94c2-fcb5504155b0" :question/math-academy-id "q-14409" :question/problem "Which of the following is equivalent to $\\frac{s-t}{s+3t}\\cdot \\frac{s+3t}{s-t}?$" :question/worked-solution "First, we cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{s-t}{s+3t}\\cdot \\frac{s+3t}{s-t} & =\\frac{\\cancel{(s-t)}}{\\cancel{(s+3t)}}\\cdot \\frac{\\cancel{(s+3t)}}{\\cancel{(s-t)}} \\\\  & =\\frac{1}{1}\\cdot \\frac{1}{1} \\\\  & =1\\end{aligned}\n$$"} :step/id #uuid "9724395a-3497-5db3-a98e-37e3649b7f55" :step/next {:db/id #edb/ref 17592186571486}} {:db/id #edb/ref 17592186571506 :step/content {:db/id #edb/ref 17592186571435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2af09dc2-e3c6-5483-9b2a-b5b4be979142" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2{m}^{3}}{n}" :db/id #edb/ref 17592186570954} {:answer/id #uuid "46fbbeda-bcef-5c40-9345-1436ff5f23f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2{m}^{2}}{n}" :db/id #edb/ref 17592186571002} {:answer/id #uuid "5a5bbd4d-01af-574b-89d1-a320e074a799" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{m}{2{n}^{2}}" :db/id #edb/ref 17592186571033} {:answer/id #uuid "7a583223-14a8-5416-a570-e6422a76ff21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{m}^{3}}{2{n}^{2}}" :db/id #edb/ref 17592186571083} {:answer/id #uuid "b89a037b-4ac4-5824-91f9-1d8c1284347c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{{n}^{2}}" :db/id #edb/ref 17592186571175}] :answer-field/correct {:db/id #edb/ref 17592186571175} :answer-field/id #uuid "7410f49e-6c3c-51c2-a82f-2b238e9fa0ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571328}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a8ed0c4a-0721-5d8a-9946-9c5ca386be9f" :question/math-academy-id "q-3646" :question/problem "Which of the following is equivalent to $\\frac{m}{{n}^{2}m+2{n}^{2}}\\cdot \\frac{2m+4}{m}?$" :question/worked-solution "First, we factor all of the expressions and cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{m}{{n}^{2}m+2{n}^{2}}\\cdot \\frac{2m+4}{m} & =\\frac{m}{{n}^{2}(m+2)}\\frac{2(m+2)}{m} \\\\  & =\\frac{\\cancel{m}}{{n}^{2}\\cancel{(m+2)}}\\frac{2\\cancel{(m+2)}}{\\cancel{m}} \\\\  & =\\frac{2}{{n}^{2}}\\end{aligned}\n$$"} :step/id #uuid "cd1153df-8a47-53bb-8c2e-6fb02edcd2fd" :step/next {:db/id #edb/ref 17592186571494}}] :activity/title "Multiplying Rational Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570880}]}
