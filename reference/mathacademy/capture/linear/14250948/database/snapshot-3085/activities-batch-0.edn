#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186069661} :activity/id #uuid "6fcb59ce-662d-5a90-b1b3-661f2c2ab5cc" :activity/scope {:db/id #edb/ref 17592186049079 :topic/id #uuid "d8e5a8ad-8cb3-52d6-a4cb-aee78ee0ea22" :topic/math-academy-id 435} :activity/steps [{:db/id #edb/ref 17592186069661 :step/content {:db/id #edb/ref 17592186069972 :tutorial/content "Multiplying rational expressions is just like multiplying fractions. After all, fractions are just rational expressions with constants!\n\nFor example, to multiply the rational expressions $\\dfrac{3}{x}$ and $\\dfrac{y}{2},$ we multiply the numerators and the denominators as follows:\n\n$$\n\\dfrac{3}{x} \\cdot \\dfrac{y}{2} = \\dfrac{3 \\cdot y}{x \\cdot 2} = \\dfrac{3y}{2x}\n$$" :tutorial/id #uuid "9b51617b-96b7-5112-bd91-a351a05ee49a" :tutorial/math-academy-id 3378 :tutorial/title "Introduction"} :step/id #uuid "9a41c4bd-7e12-505d-8a4d-a76b4263fecb" :step/math-academy-id 18880 :step/next {:db/id #edb/ref 17592186069662}} {:db/id #edb/ref 17592186069662 :step/content {:db/id #edb/ref 17592186068755 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068593 :question/id #uuid "5d90ba01-2318-5f03-9d7a-a7ad66555886" :question/math-academy-id "e-5131"} :knowledge-point/id #uuid "7ee9f8f9-37dd-5e7f-9a5c-b6d757c12025" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049253}] :knowledge-point/questions [{:db/id #edb/ref 17592186069498} {:db/id #edb/ref 17592186069499} {:db/id #edb/ref 17592186531601} {:db/id #edb/ref 17592186531623}] :knowledge-point/title "Multiplying Rational Expressions With No Common Factor"} :step/id #uuid "6bfe927f-5c28-5838-bfe9-a2f184f0afa5" :step/math-academy-id 18881 :step/next {:db/id #edb/ref 17592186069663}} {:db/id #edb/ref 17592186069663 :step/content {:db/id #edb/ref 17592186068756 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068594 :question/id #uuid "702e4d33-7021-5b21-9c9d-d41463f7b665" :question/math-academy-id "