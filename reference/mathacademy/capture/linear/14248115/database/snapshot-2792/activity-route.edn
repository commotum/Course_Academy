#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186566285} :activity/id #uuid "63c09cac-cd45-58a2-abdb-f4b784ae0ed1" :activity/scope {:db/id #edb/ref 17592186048483 :topic/id #uuid "a3715b53-2444-5539-85aa-a4d20357877e" :topic/math-academy-id 4031} :activity/steps [{:db/id #edb/ref 17592186566280 :step/content {:db/id #edb/ref 17592186566215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fc357ae-9889-5eb8-a90b-b6ac5876dded" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/92/920cbb4ab186e89d6d490da1324751a619244ef594c2ec713d4b625824b6a2f8.png" :db/id #edb/ref 17592186565730} {:answer/id #uuid "556c39b1-7ade-5eda-a71c-1de324730533" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/09/093f2e5ade9371ae84fa09ab6bee24b18930a781aac7a5fd16c3dd35fecae5ab.png" :db/id #edb/ref 17592186565813} {:answer/id #uuid "67948ed3-3f6f-5f6a-91c2-eb52c223b719" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b6/b6023387c507913444d288a2352e012a56f2c0a5115e24c3edd2eb34b2ab3c16.png" :db/id #edb/ref 17592186565838} {:answer/id #uuid "f340c2cb-5704-54e4-9367-88bbfdcd4b81" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b0/b03fee9beb85f691871f18e577154e41f9687f95b1a8c2e9f4b5c52771337be7.png" :db/id #edb/ref 17592186566080} {:answer/id #uuid "fa0d060f-2dd9-5c47-bbb3-8817090a034c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/47/479abaa62de3b6b0b57d45d06770f0a87e25ad68e27b3359e5610c8b6f1f352c.png" :db/id #edb/ref 17592186566091}] :answer-field/correct {:db/id #edb/ref 17592186565813} :answer-field/id #uuid "325c91c6-a03a-513d-b5f7-b58463828441" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566127}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "29a403df-d998-5649-bdb5-51e39508e73b" :question/math-academy-id "q-155564" :question/problem "Represent the solution of the inequality $2>3x+5$ on a number line." :question/worked-solution "First, we apply the addition principle, subtracting $5$ from both sides:\n\n$$\n\\begin{aligned}2 & >3x+5 \\\\ 2-5 & >3x+5-5 \\\\ -3 & >3x+0 \\\\ -3 & >3x\\end{aligned}\n$$\n\nSecond, we apply the multiplication principle, dividing both sides by $3:$\n\n$$\n\\begin{aligned}-3 & >3x \\\\ \\frac{-3}{3} & >\\frac{3x}{3} \\\\ \\frac{-3}{3} & >\\frac{\\cancel{3}x}{\\cancel{3}} \\\\ -1 & >x\\end{aligned}\n$$\n\n \n\nFinally, let's swap the left and right-hand sides so that the variable is on the left-hand side. Remember, we also need to flip the inequality.\n\n$$\nx<-1\n$$\n\nTherefore, the solution is $x<-1.$ The solution can be expressed on a number line, as shown below.\n\n![](images/09/093f2e5ade9371ae84fa09ab6bee24b18930a781aac7a5fd16c3dd35fecae5ab.png)"} :step/id #uuid "11c0623a-4eac-5e65-ac53-b36aaa6b05b3"} {:db/id #edb/ref 17592186566285 :step/content {:db/id #edb/ref 17592186566223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e58b6ff-edc7-55bc-805d-79a600da2102" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c1/c135701f345826b8ae0ba0cc8dab059834a7e7b968bc87067af45a2622d0514c.png" :db/id #edb/ref 17592186565703} {:answer/id #uuid "4e3884ea-4a2a-5eb6-895e-670ae4010193" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/26/2692d36cd8012c02f2324dfa66898132a48c2b7ff54bc869220b6a50fad6e584.png" :db/id #edb/ref 17592186565799} {:answer/id #uuid "88c5d179-5dbf-56db-b432-bc3a1e8123c7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b0/b0b5b503d8aabf9cae17ce26c868e6a382cf1a4091726a5e3c54e563d66af13b.png" :db/id #edb/ref 17592186565895} {:answer/id #uuid "bbec4801-2f2d-553f-a54e-786297c0a334" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/09/09480ce53cf6d8ed90a6280131b1c545566a4c778adb5c25e5f32d2ee3c9802e.png" :db/id #edb/ref 17592186565983} {:answer/id #uuid "f6635464-e3de-53fd-86d7-838f43c01046" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/27/270fc71b3bbd905ffe18b443c1a306b160f2c837a675308417d5b0315d88c5be.png" :db/id #edb/ref 17592186566084}] :answer-field/correct {:db/id #edb/ref 17592186565703} :answer-field/id #uuid "9e773230-0903-5269-b1a1-b9793adfcc4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566168}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3b73619e-ed22-51ef-83f4-ae6eed9f4cb4" :question/math-academy-id "q-101945" :question/problem "Represent the solution of the inequality $2x+9>1$ on a number line." :question/worked-solution "First, we apply the addition principle, subtracting $9$ from both sides:\n\n$$\n\\begin{aligned}2x+9 & >1 \\\\ 2x+9-9 & >1-9 \\\\ 2x+0 & >-8 \\\\ 2x & >-8\\end{aligned}\n$$\n\nSecond, we apply the multiplication principle, dividing both sides by $2:$\n\n$$\n\\begin{aligned}2x & >-8 \\\\ \\frac{2x}{2} & >\\frac{-8}{2} \\\\ \\frac{\\cancel{2}x}{\\cancel{2}} & >\\frac{-8}{2} \\\\ x & >-4\\end{aligned}\n$$\n\n \n\nTherefore, the solution is $x>-4.$ The solution can be expressed on a number line, as shown below.\n\n![](images/c1/c135701f345826b8ae0ba0cc8dab059834a7e7b968bc87067af45a2622d0514c.png)"} :step/id #uuid "3a05fa63-c708-578f-b91c-7abfb0babd01" :step/next {:db/id #edb/ref 17592186566294}} {:db/id #edb/ref 17592186566294 :step/content {:db/id #edb/ref 17592186566257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a51e6f-9a3a-58f7-9636-3b246ae5d6e3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8c/8cdfe0777a9a7d8a2096bf1903a0ffb79955d63cbb03a03a8e3f7d1702b162bb.png" :db/id #edb/ref 17592186565685} {:answer/id #uuid "0c9a8ec0-0e56-5bfe-a34d-bcc7fb373cda" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c1/c1f7c992d9df85434eaf96e5bd9af52f9b6228e42fede6e9d4001e6471c3c239.png" :db/id #edb/ref 17592186565698} {:answer/id #uuid "8c34c623-d907-5995-baf4-11d638c93028" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/39/39c072d69e558a095c4671f773ef3cdaed2366997a23edd0112c5bcdb22388dc.png" :db/id #edb/ref 17592186565902} {:answer/id #uuid "e62c6989-ba87-590f-bc09-16aad7903942" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/cd/cdc5f5b4cdcc56e29d02ee94eb5f2e2128299b5de932966fe2c2a7316bb0f75c.png" :db/id #edb/ref 17592186566052} {:answer/id #uuid "eab7fa00-aa04-5abb-837c-33d49463d2c7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f8/f8d2f5c3a4c14d802773a171f71b662d5cb926401cf78bacd26f5dd457a584ad.png" :db/id #edb/ref 17592186566062}] :answer-field/correct {:db/id #edb/ref 17592186565698} :answer-field/id #uuid "c95bc101-3d53-5754-8210-1facc1f0192a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566179}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b5942d8a-a361-5a4c-829b-f23ceb66bd8b" :question/math-academy-id "q-155559" :question/problem "Represent the solution of the inequality $5x-3<2$ on a number line." :question/worked-solution "First, we apply the addition principle, adding $3$ to both sides:\n\n$$\n\\begin{aligned}5x-3 & <2 \\\\ 5x-3+3 & <2+3 \\\\ 5x+0 & <5 \\\\ 5x & <5\\end{aligned}\n$$\n\nSecond, we apply the multiplication principle, dividing both sides by $5:$\n\n$$\n\\begin{aligned}5x & <5 \\\\ \\frac{5x}{5} & <\\frac{5}{5} \\\\ \\frac{\\cancel{5}x}{\\cancel{5}} & <\\frac{5}{5} \\\\ x & <1\\end{aligned}\n$$\n\n \n\nTherefore, the solution is $x<1.$ The solution can be expressed on a number line, as shown below.\n\n![](images/c1/c1f7c992d9df85434eaf96e5bd9af52f9b6228e42fede6e9d4001e6471c3c239.png)"} :step/id #uuid "5f1e04f5-1826-5b79-8562-d80e353e4d76" :step/next {:db/id #edb/ref 17592186566280}}] :activity/title "Representing Solutions to Inequalities on Number Lines" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186565668}]}
