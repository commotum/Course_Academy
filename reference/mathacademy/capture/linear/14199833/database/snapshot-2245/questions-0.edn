#{[{:db/id #edb/ref 17592186234092 :knowledge-point/_questions [{:db/id #edb/ref 17592186054611 :knowledge-point/id #uuid "67b307f2-1d37-5741-8972-cbddae50c4c8" :knowledge-point/title "Finding the Product of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0232f6d1-cc47-55de-8533-bead91016a51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-77" :db/id #edb/ref 17592186516117} {:answer/id #uuid "3581fa24-c005-5f7c-a7ef-a44af78898c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186516225} {:answer/id #uuid "574a7f7b-4e6e-5629-b9e0-03d3d14a8260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-41" :db/id #edb/ref 17592186516295} {:answer/id #uuid "ae50b601-00f2-5d2d-862d-a236109f9bed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186516475} {:answer/id #uuid "cb4ed9aa-c01d-5794-9c67-4387dd7bdb77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "77" :db/id #edb/ref 17592186516542}] :answer-field/correct {:answer/id #uuid "ae50b601-00f2-5d2d-862d-a236109f9bed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186516475} :answer-field/id #uuid "46b5e342-2f59-5f17-97d7-60225f6e5208" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516677}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "98638830-1bd5-5922-b12a-9c190db0e3da" :question/math-academy-id "q-4825" :question/problem "Given $f(x)=2{x}^{2}+5x$ and $g(x)=9-2x,$ find $(fg)(-1).$" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(-1),$ we find $f(-1)$ and $g(-1),$ and then multiply the results.\n\nFirst, we find $f(-1)$ and $g(-1):$\n\n$$\n\\begin{aligned}f(-1) & =2(-1)^{2}+5(-1)=-3 \\\\ g(-1) & =9-2(-1)=11\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(-1)=f(-1)g(-1)=-3\\cdot 11=-33\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =(2{x}^{2}+5x)(9-2x) \\\\  & =-4{x}^{3}+8{x}^{2}+45x\\end{aligned}\n$$\n\nNow, we evaluate $(fg)(-1):$ \n\n$$\n\\begin{aligned}(fg)(-1) & =-4(-1)^{3}+8(-1)^{2}+45(-1) \\\\  & =4+8-45 \\\\  & =-33\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186516773 :knowledge-point/_questions [{:db/id #edb/ref 17592186054611 :knowledge-point/id #uuid "67b307f2-1d37-5741-8972-cbddae50c4c8" :knowledge-point/title "Finding the Product of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cc163ae-67c3-5dbb-9c2e-df65985cece8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186516268} {:answer/id #uuid "5c4f1670-871c-59ee-8a82-19f3fd41d372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186516308} {:answer/id #uuid "7d98d607-1295-57e0-82a2-4957c73eb6f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186516378} {:answer/id #uuid "b56a0556-d0b6-58d1-ae92-072bdafe84ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186516490} {:answer/id #uuid "c9da03d1-95db-5bd2-ac01-db50a9b70c37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186516538}] :answer-field/correct {:answer/id #uuid "5c4f1670-871c-59ee-8a82-19f3fd41d372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186516308} :answer-field/id #uuid "ff0d330b-f0bf-5ed3-9055-16241719d8a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516763}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dffdb23-4e19-5e3b-9c5d-b76e7cdb23fa" :question/math-academy-id "q-66419" :question/problem "Given $f(x)=8{x}^{2}+1$ and $g(x)=2x-2,$ find  $(fg)(1).$" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(1),$ we find $f(1)$ and $g(1),$ and then multiply the results.\n\nFirst, we find $f(1)$ and $g(1):$\n\n$$\n\\begin{aligned}f(1) & =8(1)^{2}+1=9 \\\\ g(1) & =2(1)-2=0\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(1)=f(1)g(1)=9\\cdot 0=0\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =(8{x}^{2}+1)(2x-2) \\\\  & =16{x}^{3}-16{x}^{2}+2x-2\\end{aligned}\n$$\n\nNow, we evaluate $(fg)(1):$ \n\n$$\n\\begin{aligned}(fg)(1) & =16(1)^{3}-16(1)^{2}+2(1)-2 \\\\  & =16-16+2-2 \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234199 :knowledge-point/_questions [{:db/id #edb/ref 17592186054612 :knowledge-point/id #uuid "55d291ea-d722-5852-9c3a-faaba8e6df3e" :knowledge-point/title "Evaluating the Quotient of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a971ff-a0ac-5e41-a6f9-de3fae7b9090" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186413834} {:answer/id #uuid "79f9695d-1add-50ce-be55-ea88b6f4de22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186413843} {:answer/id #uuid "970de561-023f-5e4a-8ecd-0cd2dba960b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186413846} {:answer/id #uuid "e137be1f-e344-5693-8401-73a72931c8a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186413852} {:answer/id #uuid "fb2ca1be-c620-54b9-9e8c-878f37709564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186413857}] :answer-field/correct {:answer/id #uuid "970de561-023f-5e4a-8ecd-0cd2dba960b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186413846} :answer-field/id #uuid "328f71c0-868a-51e6-9077-92f3e52307b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413859}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d54abce-95cd-5dd9-be80-9f173369bea7" :question/math-academy-id "q-66425" :question/problem "Given $f(x)=2{x}^{2}-6$ and $g(x)=-2x+2,$ find  $(f/g)(3).$" :question/worked-solution "The notation $(f/g)(x)$ means the quotient of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f/g)(3),$ we find $f(3)$ and $g(3),$ and then divide the results.\n\nFirst, we find $f(3)$ and $g(3):$\n\n$$\n\\begin{aligned}f(3) & =2(3)^{2}-6=12 \\\\ g(3) & =-2(3)+2=-4\\end{aligned}\n$$\n\n \n\nNow, we divide the results:\n\n$$\n(f/g)(3)=\\frac{f(3)}{g(3)}=\\frac{12}{-4}=-3\n$$\n\n**Method 2**\n\nFirst, we find $(f/g)(x)$ by dividing $f$ by $g$:\n\n$$\n\\begin{aligned}(f/g)(x)=\\frac{2{x}^{2}-6}{-2x+2}\\end{aligned}\n$$\n\nNow, we evaluate $(f/g)(3):$ \n\n$$\n\\begin{aligned}(f/g)(3) & =\\frac{2(3)^{2}-6}{-2(3)+2}=\\frac{12}{-4}=-3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186516817 :knowledge-point/_questions [{:db/id #edb/ref 17592186054612 :knowledge-point/id #uuid "55d291ea-d722-5852-9c3a-faaba8e6df3e" :knowledge-point/title "Evaluating the Quotient of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02da732e-8f8f-522b-a0af-c292550ebd0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186516118} {:answer/id #uuid "12fd6f4f-4886-505e-ae42-dc7cc6984c42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186516148} {:answer/id #uuid "2045e6fa-2eac-591c-966c-1fdb56bcfe80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186516173} {:answer/id #uuid "5f02d874-962f-54b5-b78b-81b45af705f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186516318} {:answer/id #uuid "7eaec706-9934-5e79-9ce3-c47dee2c41e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186516381}] :answer-field/correct {:answer/id #uuid "2045e6fa-2eac-591c-966c-1fdb56bcfe80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186516173} :answer-field/id #uuid "b0def8c5-0e76-5633-984d-4a0398a720ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516734}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "76e8734a-ae7e-5bfd-82cf-840027d7b221" :question/math-academy-id "q-66437" :question/problem "Given $f(x)={x}^{2}-4$ and $g(x)=2x+2,$ find  $(f/g)(2).$" :question/worked-solution "The notation $(f/g)(x)$ means the quotient of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f/g)(2),$ we find $f(2)$ and $g(2),$ and then divide the results.\n\nFirst, we find $f(2)$ and $g(2):$\n\n$$\n\\begin{aligned}f(2) & =(2)^{2}-4=0 \\\\ g(2) & =2(2)+2=6\\end{aligned}\n$$\n\n \n\nNow, we divide the results:\n\n$$\n(f/g)(2)=\\frac{f(2)}{g(2)}=\\frac{0}{6}=0\n$$\n\n**Method 2**\n\nFirst, we find $(f/g)(x)$ by dividing $f$ by $g$:\n\n$$\n\\begin{aligned}(f/g)(x)=\\frac{{x}^{2}-4}{2x+2}\\end{aligned}\n$$\n\nNow, we evaluate $(f/g)(2):$  \n\n$$\n\\begin{aligned}(f/g)(2) & =\\frac{(2)^{2}-4}{2(2)+2}=\\frac{0}{6}=0\\end{aligned}\n$$"}]}
