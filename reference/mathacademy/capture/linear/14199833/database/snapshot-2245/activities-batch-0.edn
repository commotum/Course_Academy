{-2x+2}\\end{aligned}\n$$\n\nNow, we evaluate $(f/g)(3):$ \n\n$$\n\\begin{aligned}(f/g)(3) & =\\frac{2(3)^{2}-6}{-2(3)+2}=\\frac{12}{-4}=-3\\end{aligned}\n$$"} :step/id #uuid "c74026d0-f786-50c1-b154-b7d927f144aa" :step/next {:db/id #edb/ref 17592186516982}} {:db/id #edb/ref 17592186516973 :step/content {:db/id #edb/ref 17592186234092 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0232f6d1-cc47-55de-8533-bead91016a51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-77" :db/id #edb/ref 17592186516117} {:answer/id #uuid "3581fa24-c005-5f7c-a7ef-a44af78898c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "33" :db/id #edb/ref 17592186516225} {:answer/id #uuid "574a7f7b-4e6e-5629-b9e0-03d3d14a8260" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-41" :db/id #edb/ref 17592186516295} {:answer/id #uuid "ae50b601-00f2-5d2d-862d-a236109f9bed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-33" :db/id #edb/ref 17592186516475} {:answer/id #uuid "cb4ed9aa-c01d-5794-9c67-4387dd7bdb77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "77" :db/id #edb/ref 17592186516542}] :answer-field/correct {:db/id #edb/ref 17592186516475} :answer-field/id #uuid "46b5e342-2f59-5f17-97d7-60225f6e5208" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516677}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "98638830-1bd5-5922-b12a-9c190db0e3da" :question/math-academy-id "q-4825" :question/problem "Given $f(x)=2{x}^{2}+5x$ and $g(x)=9-2x,$ find $(fg)(-1).$" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(-1),$ we find $f(-1)$ and $g(-1),$ and then multiply the results.\n\nFirst, we find $f(-1)$ and $g(-1):$\n\n$$\n\\begin{aligned}f(-1) & =2(-1)^{2}+5(-1)=-3 \\\\ g(-1) & =9-2(-1)=11\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(-1)=f(-1)g(-1)=-3\\cdot 11=-33\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =(2{x}^{2}+5x)(9-2x) \\\\  & =-4{x}^{3}+8{x}^{2}+45x\\end{aligned}\n$$\n\nNow, we evaluate $(fg)(-1):$ \n\n$$\n\\begin{aligned}(fg)(-1) & =-4(-1)^{3}+8(-1)^{2}+45(-1) \\\\  & =4+8-45 \\\\  & =-33\\end{aligned}\n$$"} :step/id #uuid "dbee05de-3d07-576a-9368-57acc32e5170" :step/next {:db/id #edb/ref 17592186516933}} {:db/id #edb/ref 17592186516982 :step/content {:db/id #edb/ref 17592186516817 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02da732e-8f8f-522b-a0af-c292550ebd0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186516118} {:answer/id #uuid "12fd6f4f-4886-505e-ae42-dc7cc6984c42" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Undefined" :db/id #edb/ref 17592186516148} {:answer/id #uuid "2045e6fa-2eac-591c-966c-1fdb56bcfe80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186516173} {:answer/id #uuid "5f02d874-962f-54b5-b78b-81b45af705f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186516318} {:answer/id #uuid "7eaec706-9934-5e79-9ce3-c47dee2c41e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186516381}] :answer-field/correct {:db/id #edb/ref 17592186516173} :answer-field/id #uuid "b0def8c5-0e76-5633-984d-4a0398a720ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516734}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "76e8734a-ae7e-5bfd-82cf-840027d7b221" :question/math-academy-id "q-66437" :question/problem "Given $f(x)={x}^{2}-4$ and $g(x)=2x+2,$ find  $(f/g)(2).$" :question/worked-solution "The notation $(f/g)(x)$ means the quotient of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f/g)(2),$ we find $f(2)$ and $g(2),$ and then divide the results.\n\nFirst, we find $f(2)$ and $g(2):$\n\n$$\n\\begin{aligned}f(2) & =(2)^{2}-4=0 \\\\ g(2) & =2(2)+2=6\\end{aligned}\n$$\n\n \n\nNow, we divide the results:\n\n$$\n(f/g)(2)=\\frac{f(2)}{g(2)}=\\frac{0}{6}=0\n$$\n\n**Method 2**\n\nFirst, we find $(f/g)(x)$ by dividing $f$ by $g$:\n\n$$\n\\begin{aligned}(f/g)(x)=\\frac{{x}^{2}-4}{2x+2}\\end{aligned}\n$$\n\nNow, we evaluate $(f/g)(2):$  \n\n$$\n\\begin{aligned}(f/g)(2) & =\\frac{(2)^{2}-4}{2(2)+2}=\\frac{0}{6}=0\\end{aligned}\n$$"} :step/id #uuid "f577bcab-36ae-5324-94f9-2ea6a15c229b"}] :activity/title "The Arithmetic of Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516103}]}
