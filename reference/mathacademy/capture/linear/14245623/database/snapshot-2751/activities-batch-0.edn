b/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186485032} {:answer/id #uuid "84297f1f-e6e8-5683-af04-f7b713873948" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186485101}] :answer-field/correct {:db/id #edb/ref 17592186484906} :answer-field/id #uuid "8f6bd22d-0ba9-56fb-9f12-08c0ea8052b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186485426}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14cc1a32-5526-5826-8d11-3b9752e2a607" :question/math-academy-id "q-74463" :question/problem "Given the polynomial $g(x)={x}^{4}+3{x}^{3}+{x}^{2}-4x,$ $g(1)=$" :question/worked-solution "We substitute $x=1$ into the expression for $g(x)$ and simplify: \n\n$$\n\\begin{aligned}g(x) & ={x}^{4}+3{x}^{3}+{x}^{2}-4x \\\\ g(1) & ={1}^{4}+3\\cdot {1}^{3}+{1}^{2}-4\\cdot 1 \\\\  & =1+3+1-4 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, $g(1)=1.$"} :step/id #uuid "fb3db9c8-817f-5352-8d1f-22e473869755"}] :activity/title "Introduction to Polynomials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186484811}] [{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186065266} :activity/id #uuid "920218c5-b28d-5647-a01d-bb88eb97a449" :activity/scope {:db/id #edb/ref 17592186050622 :topic/id #uuid "59bac138-6475-51d1-971d-3bd216b92f3c" :topic/math-academy-id 356} :activity/steps [{:db/id #edb/ref 17592186065266 :step/content {:db/id #edb/ref 17592186065414 :tutorial/content "Equations can contain more than one variable. For example, the following equation has two variables, $\\color{blue}x$ and ${\\color{red}y}{:}$\n\n$$\n{\\color{blue}x} - 7{\\color{red}y} = 1\n$$\n\nTo **solve the equation for the variable ** ${\\color{blue}{x}},$ we need to isolate $\\color{blue}x$ on one side of the equation:  \n\nIn this case, we apply the addition principle and add $7{\\color{red}y}$ to both sides:\n\n$$\n\\begin{aligned}x-7y & =1 \\\\ x-7y+7y & =1+7y \\\\ x+0 & =1+7y \\\\ x & =1+7y\\end{aligned}\n$$\n\nAnd that's it! We have successfully isolated the variable ${\\color{blue}{x}}.$\n\nLet's now look at an example where we must apply the multiplication principle." :tutorial/id #uuid "c431a781-752f-59ae-bf37-616b43771b6f" :tutorial/math-academy-id 8072 :tutorial/title "Introduction"} :step/id #uuid "c59fe348-2f63-5607-9155-2839edb15553" :step/math-academy-id 72728 :step/next {:db/id #edb/ref 17592186065267}} {:db/id #edb/ref 17592186065267 :step/content {:db/id #edb/ref 17592186064347 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063937 :question/id #uuid "46597138-36cc-584b-ade8-70cbfafcad2a" :question/math-academy-id "e-12905"} :knowledge-point/id #uuid "97dc4044-9984-58a3-bf02-61f31fc31792" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725} {:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186064498} {:db/id #edb/ref 17592186064787} {:db/id #edb/ref 17592186064788} {:db/id #edb/ref 17592186488192} {:db/id #edb/ref 17592186488254}] :knowledge-point/title "Solving One-Step Equations"} :step/id #uuid "20731402-a6cb-5902-8400-bb1a89578bba" :step/math-academy-id 72729 :step/next {:db/id #edb/ref 17592186065268}} {:db/id #edb/ref 17592186065268 :step/content {:db/id #edb/ref 17592186064348 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063950 :question/id #uuid "84e24683-73f6-59a1-b2c3-03d3659adf27" :question/math-academy-id "e-13119"} :knowledge-point/id #uuid "075c23a4-9de9-59b5-bec4-575b0b0454f4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186064499} {:db/id #edb/ref 17592186064664} {:db/id #edb/ref 17592186064672} {:db/id #edb/ref 17592186233559} {:db/id #edb/ref 17592186233566} {:db/id #edb/ref 17592186233573} {:db/id #edb/ref 17592186488194} {:db/id #edb/ref 17592186488239} {:db/id #edb/ref 17592186495052}] :