ref 17592186045498} :answer/value "\\frac{7c}{5}" :db/id #edb/ref 17592186494575} {:answer/id #uuid "84cad270-ffb9-54b7-ab0b-714c6f9ff0a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2c}{5}" :db/id #edb/ref 17592186494611} {:answer/id #uuid "afd965a8-0cc0-5acc-b8a9-26911d6de0b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3c}{5}" :db/id #edb/ref 17592186494728}] :answer-field/correct {:db/id #edb/ref 17592186494415} :answer-field/id #uuid "ce86109f-c522-5257-a1af-0a30eb61a2af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495017}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "131ccfe9-849e-53c3-a3f1-91aed4a65240" :question/math-academy-id "q-22237" :question/problem "If $b-5c=c-4b,$ then $b=$" :question/worked-solution "We need to isolate the variable $b.$ To do this, we treat $c$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we add $4b$ to both sides of the equation:\n\n$$\n\\begin{aligned}b-5c & =c-4b \\\\ b-5c+4b & =c-4b+4b \\\\ b+4b-5c & =c-4b+4b \\\\ 5b-5c & =c\\end{aligned}\n$$\n\nThen, we add $5c$ to both sides of the equation:\n\n$$\n\\begin{aligned}5b-5c & =c \\\\ 5b-5c+5c & =c+5c \\\\ 5b & =6c\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $5:$\n\n$$\n\\begin{aligned}5b & =6c \\\\ \\frac{5b}{5} & =\\frac{6c}{5} \\\\ \\frac{\\cancel{5}b}{\\cancel{5}} & =\\frac{6c}{5} \\\\ b & =\\frac{6c}{5}\\end{aligned}\n$$"} :step/id #uuid "c76c91ea-1fa5-50f4-8d7c-4155dbbf366c" :step/next {:db/id #edb/ref 17592186495259}} {:db/id #edb/ref 17592186495259 :step/content {:db/id #edb/ref 17592186495052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b21b33-50e5-5cbe-9b22-24f73902555e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+2y}{3}" :db/id #edb/ref 17592186494322} {:answer/id #uuid "15ea45d4-5b0c-536f-977e-e4f7ad0b6a37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+6y" :db/id #edb/ref 17592186494357} {:answer/id #uuid "cabe9447-7e18-5fc2-b800-d12efc44ec31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3-6y" :db/id #edb/ref 17592186494798} {:answer/id #uuid "eb9cf60f-e518-550d-b474-33adf1d185b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2y-1}{3}" :db/id #edb/ref 17592186494878} {:answer/id #uuid "f0e2634c-f79a-5536-b6e7-b72d016dd451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3-2y" :db/id #edb/ref 17592186494889}] :answer-field/correct {:db/id #edb/ref 17592186494357} :answer-field/id #uuid "b4aba618-e4e2-5bd3-9df6-670dd46cecef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495003}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "041420d0-7112-5aa8-8e70-44b04f8459e6" :question/math-academy-id "q-135011" :question/problem "If $\\frac{z}{3}-2y=1$ then $z=$" :question/worked-solution "We need to isolate the variable $z.$ To do this, we treat $y$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we add $2y$ to both sides of the equation:\n\n$$\n\\begin{aligned}\\frac{z}{3}-2y & =1 \\\\ \\frac{z}{3}-2y+2y & =1+2y \\\\ \\frac{z}{3} & =1+2y\\end{aligned}\n$$\n\nThen, we multiply both sides of the equation by $3:$\n\n$$\n\\begin{aligned}\\frac{z}{3} & =1+2y \\\\ 3\\cdot \\frac{z}{3} & =3\\cdot (1+2y) \\\\ \\cancel{3}\\cdot \\frac{z}{\\cancel{3}} & =3\\cdot (1+2y) \\\\ z & =3\\cdot (1+2y) \\\\ z & =3\\cdot 1+3\\cdot 2y \\\\ z & =3+6y\\end{aligned}\n$$"} :step/id #uuid "dc32766e-e6b6-52c0-84bc-2ef3316dead6" :step/next {:db/id #edb/ref 17592186495270}} {:db/id #edb/ref 17592186495270 :step/content {:db/id #edb/ref 17592186495079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57e54aa5-0ae5-5529-8641-8aded4a5dfa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2y}{3}" :db/id #edb/ref 17592186494496}] :answer-field/correct {:db/id #edb/ref 17592186494496} :answer-field/id #uuid "c06f8f1f-3ac5-52a2-ba1c-01d871adb3a0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186495007}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "42436934-3a89-50ee-8455-624cf79683ae" :question/math-academy-id "q-176587" :question/problem "Given that $2x-y=y-x,$ express $x$ in terms of $y.$\n\n$x=$\n{{field-1}}" :question/worked-solution "We need to isolate the variable $x.$ To do this, we treat $y$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we add $y$ to both sides of the equation:\n\n$$\n\\begin{aligned}2x-y & =y-x \\\\ 2x-y+y & =y-x+y \\\\ 2x & =-x+2y\\end{aligned}\n$$\n\nThen, we add $x$ to both sides of the equation:\n\n$$\n\\begin{aligned}2x & =-x+2y \\\\ 2x+x & =-x+2y+x \\\\ 3x & =2y\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $3:$\n\n$$\n\\begin{aligned}3x & =2y \\\\ \\frac{3x}{3} & =\\frac{2y}{3} \\\\ \\frac{\\cancel{3}x}{\\cancel{3}} & =\\frac{2y}{3} \\\\ x & =\\frac{2y}{3}\\end{aligned}\n$$"} :step/id #uuid "f6f165f3-2e0f-519e-8f2f-88ed8efb2170"}] :activity/title "Solving Two-Variable Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494316}] [{:activity/first-step {:db/id #edb/ref 17592186065228} :activity/id #uuid "28a8e191-2419-5067-b551-a263baa08308" :activity/scope {:db/id #edb/ref 17592186051017 :topic/id #uuid "7a611e07-341d-5ee4-914f-fa436e11a160" :topic/math-academy-id 353} :activity/steps [{:db/id #edb/ref 17592186065228 :step/content {:db/id #edb/ref 17592186065340 :tutorial/content "To factor a polynomial expression like $2a^2+6a$, we follow the three steps below:\n\n1. First, we find the greatest common factor (or $\\textrm{GCF}$) of both terms. In this case,\n$\\textrm{GCF}(2a^2,6a) = 2a$.\n2. Then, we rewrite each term in the original expression as a product with the $\\textrm{GCF}$:\n$2a^{2} + 6a|=; (2a \\cdot a) + (2a \\cdot 3)$\n3. Finally, we write the $\\textrm{GCF}$ outside the parentheses and keep the remaining terms inside:\n$(2a \\cdot a) + (2a \\cdot 3)|=; 2a(a + 3)$\n\nTherefore, the factored form of $2a^2+6a$ is $2a(a+3)$.\n\nWe can check that we factored correctly by multiplying it out:\n\n$$\n\\begin{aligned}\n2a(a + 3) &=  \\\\\n2a \\cdot a + 2a \\cdot 3 &=  \\\\\n&= 2a^{2} + 6a \\mid ✓\n\\end{aligned}\n$$" :tutorial/id #uuid "f84c09f1-b24a-50f1-a8c4-24b8d857bca2" :tutorial/math-academy-id 1595 :tutorial/title "Introduction"} :step/id #uuid "79b200d6-ffc5-573e-9352-08bd5b609ca7" :step/math-academy-id 4216 :step/next {:db/id #edb/ref 17592186065257}} {:db/id #edb/ref 17592186065229 :step/content {:db/id #edb/ref 17592186064322 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063953 :question/id #uuid "e0ffd89f-c43e-578d-a2b0-da1229a4ef0f" :question/math-academy-id "e-1323"} :knowledge-point/id #uuid "12fed420-dbc6-57b4-8b3b-a13d441a51df" :knowledge-point/questions [{:db/id #edb/ref 17592186064684} {:db/id #edb/ref 17592186064720}] :knowledge-point/title "Factoring a Monomial out of a Binomial Containing Two Variables"} :step/id #uuid "3968652b-1ef7-5b97-9ac6-78222515a6b5" :step/math-academy-id 4217 :step/next {:db/id #edb/ref 17592186065230}} {:db/id #edb/ref 17592186065230 :step/content {:db/id #edb/ref 17592186064323 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063954 :question/id #uuid "7cbc7f2d-a2df-5382-bff4-d8a7e10c9b6d" :question/math-academy-id "e-1324"} :knowledge-point/id #uuid "6d1134c0-02ce-59c1-8238-4820da388f90" :knowledge-point/questions [{:db/id #edb/ref 17592186064675} {:db/id #edb/ref 17592186064719} {:db/id #edb/ref 17592186233562} {:db/id #edb/ref 17592186233569} {:db/id #edb/ref 17592186233576}] :knowledge-point/title "Factoring a Monomial From a Trinomial"} :step/id #uuid "a4