#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186573361} :activity/id #uuid "3542d0d0-8424-5c15-90db-0d0a314cb9c3" :activity/scope {:db/id #edb/ref 17592186048470 :topic/id #uuid "a249df7c-110c-5944-a303-74505130a629" :topic/math-academy-id 28} :activity/steps [{:db/id #edb/ref 17592186573346 :step/content {:db/id #edb/ref 17592186573253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38a98641-2e38-578c-b3c5-17bb1f192700" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186572881} {:answer/id #uuid "5e7dce6a-3e36-598d-9a5e-9b0c2908e50b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186572932} {:answer/id #uuid "9b66ccb7-9147-50dc-a184-c4ff564b8209" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186573024} {:answer/id #uuid "9d4fd407-f836-5227-93e6-01c0887c14a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186573028} {:answer/id #uuid "e1e77c3b-5d54-5798-8bc6-98d8b4b1e688" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186573111}] :answer-field/correct {:db/id #edb/ref 17592186572881} :answer-field/id #uuid "cd14762e-d61e-513a-9786-dfc287bdc4a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573226}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "070008c9-e913-5456-a5af-e255c5aba081" :question/math-academy-id "q-30824" :question/problem "${log}_{64}⁡(\\sqrt{8})=$" :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}⁡X=\\frac{{log}_{b}⁡X}{{log}_{b}⁡a}\n$$\n\nIn our case, $a=64$ and $X=\\sqrt{8}.$ Since both $a$ and $X$ can be presented as a power of $8,$ we set $b=8.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{64}⁡(\\sqrt{8}) & =\\frac{{log}_{8}⁡(\\sqrt{8})}{{log}_{8}⁡(64)} \\\\  & =\\frac{{log}_{8}⁡({8}^{1/2})}{{log}_{8}⁡({8}^{2})} \\\\  & =\\frac{(\\frac{1}{2})}{2} \\\\  & =\\frac{1}{4}\\end{aligned}\n$$"} :step/id #uuid "518c1048-98b7-5c05-bbdd-0b9d19b57a71" :step/next {:db/id #edb/ref 17592186573349}} {:db/id #edb/ref 17592186573349 :step/content {:db/id #edb/ref 17592186573267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66a0bcce-653d-592a-b615-921125e4877d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186572948} {:answer/id #uuid "76ba75fb-4bc9-5ff8-9ed9-b66c1d091c5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186572976} {:answer/id #uuid "95204e1c-0acb-54ed-a36a-670e3b50729d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186573019} {:answer/id #uuid "b82f8830-ef82-53f9-94fe-10a3b6669fdf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186573058} {:answer/id #uuid "b870fa54-4d3f-51b4-81c7-fd2cf9755718" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186573059}] :answer-field/correct {:db/id #edb/ref 17592186572948} :answer-field/id #uuid "b211c988-c894-53a3-abe3-c7c0de871b39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186573213}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2e637b5f-6f34-5a1c-b2e1-f9ed9e9b050b" :question/math-academy-id "q-66885" :question/problem "${log}_{64}⁡(\\sqrt[3]{4})=$" :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}⁡X=\\frac{{log}_{b}⁡X}{{log}_{b}⁡a}\n$$\n\nIn our case, $a=64$ and $X=\\sqrt[3]{4}.$ Since both $a$ and $X$ can be presented as a power of $4,$ we set $b=4.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{64}⁡(\\sqrt[3]{4}) & =\\frac{{log}_{4}⁡(\\sqrt[3]{4})}{{log}_{4}⁡(64)} \\\\  & =\\frac{{log}_{4}⁡({4}^{1/3})}{{log}_{4}⁡({4}^{3})} \\\\  & =\\frac{(\\frac{1}{3})}{3} \\\\  & =\\frac{1}{9}\\end{aligned}\n$$"} :step/id #uuid "5a87c232-6596-5aaf-adc7-7ced8ad66d80"} {:db/id #edb/ref 17592186573361 :step/content {:db/id #edb/ref 17592186234501 :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d53e430a-1886-55bb-9012-664bdb531b68" :question/math-academy-id "q-98" :question/problem "Use a calculator to evaluate ${log}_{12}(23)$ rounded to $3$ decimal places." :question/worked-solution "Let's calculate ${log}_{12}(23)$ by changing the base $12$ to the common logarithm (base $10$).\n\nWe use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=12,$ $X=23,$ $b=10.$ So, we have\n\n$$\n\\begin{aligned}{log}_{12}(23) & =\\frac{{log}_{10}(23)}{{log}_{10}(12)} \\\\  & =\\frac{\\operatorname{log}(23)}{\\operatorname{log}(12)} \\\\  & \\approx \\frac{1.361\\,728}{1.079\\,181} \\\\  & \\approx 1.262\\end{aligned}\n$$"} :step/id #uuid "bd6d4a94-a1a0-5506-a3c7-6666ea986adc" :step/next {:db/id #edb/ref 17592186573346}}] :activity/title "The Change of Base Formula for Logarithms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186572819}]}
