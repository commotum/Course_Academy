#{[{:db/id #edb/ref 17592186234501 :knowledge-point/_questions [{:db/id #edb/ref 17592186054745 :knowledge-point/id #uuid "bccd26ff-1dc5-5817-962b-a1ef1f46b2fb" :knowledge-point/title "Evaluating a Logarithm With a Calculator Using the Change of Base Formula"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d53e430a-1886-55bb-9012-664bdb531b68" :question/math-academy-id "q-98" :question/problem "Use a calculator to evaluate ${log}_{12}(23)$ rounded to $3$ decimal places." :question/worked-solution "Let's calculate ${log}_{12}(23)$ by changing the base $12$ to the common logarithm (base $10$).\n\nWe use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=12,$ $X=23,$ $b=10.$ So, we have\n\n$$\n\\begin{aligned}{log}_{12}(23) & =\\frac{{log}_{10}(23)}{{log}_{10}(12)} \\\\  & =\\frac{\\operatorname{log}(23)}{\\operatorname{log}(12)} \\\\  & \\approx \\frac{1.361\\,728}{1.079\\,181} \\\\  & \\approx 1.262\\end{aligned}\n$$"}]}
