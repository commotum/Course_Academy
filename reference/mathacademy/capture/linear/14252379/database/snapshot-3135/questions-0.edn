#{[{:db/id #edb/ref 17592186573253 :knowledge-point/_questions [{:db/id #edb/ref 17592186054746 :knowledge-point/id #uuid "e0ab12b8-b1c9-5192-91be-cebc968d9587" :knowledge-point/title "Evaluating a Logarithm Without a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38a98641-2e38-578c-b3c5-17bb1f192700" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186572881} {:answer/id #uuid "5e7dce6a-3e36-598d-9a5e-9b0c2908e50b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186572932} {:answer/id #uuid "9b66ccb7-9147-50dc-a184-c4ff564b8209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186573024} {:answer/id #uuid "9d4fd407-f836-5227-93e6-01c0887c14a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186573028} {:answer/id #uuid "e1e77c3b-5d54-5798-8bc6-98d8b4b1e688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186573111}] :answer-field/correct {:answer/id #uuid "38a98641-2e38-578c-b3c5-17bb1f192700" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186572881} :answer-field/id #uuid "cd14762e-d61e-513a-9786-dfc287bdc4a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573226}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "070008c9-e913-5456-a5af-e255c5aba081" :question/math-academy-id "q-30824" :question/problem "${log}_{64}⁡(\\sqrt{8})=$" :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}⁡X=\\frac{{log}_{b}⁡X}{{log}_{b}⁡a}\n$$\n\nIn our case, $a=64$ and $X=\\sqrt{8}.$ Since both $a$ and $X$ can be presented as a power of $8,$ we set $b=8.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{64}⁡(\\sqrt{8}) & =\\frac{{log}_{8}⁡(\\sqrt{8})}{{log}_{8}⁡(64)} \\\\  & =\\frac{{log}_{8}⁡({8}^{1/2})}{{log}_{8}⁡({8}^{2})} \\\\  & =\\frac{(\\frac{1}{2})}{2} \\\\  & =\\frac{1}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573267 :knowledge-point/_questions [{:db/id #edb/ref 17592186054746 :knowledge-point/id #uuid "e0ab12b8-b1c9-5192-91be-cebc968d9587" :knowledge-point/title "Evaluating a Logarithm Without a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66a0bcce-653d-592a-b615-921125e4877d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186572948} {:answer/id #uuid "76ba75fb-4bc9-5ff8-9ed9-b66c1d091c5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186572976} {:answer/id #uuid "95204e1c-0acb-54ed-a36a-670e3b50729d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186573019} {:answer/id #uuid "b82f8830-ef82-53f9-94fe-10a3b6669fdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186573058} {:answer/id #uuid "b870fa54-4d3f-51b4-81c7-fd2cf9755718" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186573059}] :answer-field/correct {:answer/id #uuid "66a0bcce-653d-592a-b615-921125e4877d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186572948} :answer-field/id #uuid "b211c988-c894-53a3-abe3-c7c0de871b39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573213}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2e637b5f-6f34-5a1c-b2e1-f9ed9e9b050b" :question/math-academy-id "q-66885" :question/problem "${log}_{64}⁡(\\sqrt[3]{4})=$" :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}⁡X=\\frac{{log}_{b}⁡X}{{log}_{b}⁡a}\n$$\n\nIn our case, $a=64$ and $X=\\sqrt[3]{4}.$ Since both $a$ and $X$ can be presented as a power of $4,$ we set $b=4.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{64}⁡(\\sqrt[3]{4}) & =\\frac{{log}_{4}⁡(\\sqrt[3]{4})}{{log}_{4}⁡(64)} \\\\  & =\\frac{{log}_{4}⁡({4}^{1/3})}{{log}_{4}⁡({4}^{3})} \\\\  & =\\frac{(\\frac{1}{3})}{3} \\\\  & =\\frac{1}{9}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234501 :knowledge-point/_questions [{:db/id #edb/ref 17592186054745 :knowledge-point/id #uuid "bccd26ff-1dc5-5817-962b-a1ef1f46b2fb" :knowledge-point/title "Evaluating a Logarithm With a Calculator Using the Change of Base Formula"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d53e430a-1886-55bb-9012-664bdb531b68" :question/math-academy-id "q-98" :question/problem "Use a calculator to evaluate ${log}_{12}(23)$ rounded to $3$ decimal places." :question/worked-solution "Let's calculate ${log}_{12}(23)$ by changing the base $12$ to the common logarithm (base $10$).\n\nWe use the change of base formula:\n\n$$\n{log}_{a}X=\\frac{{log}_{b}X}{{log}_{b}a}\n$$\n\nIn our case, $a=12,$ $X=23,$ $b=10.$ So, we have\n\n$$\n\\begin{aligned}{log}_{12}(23) & =\\frac{{log}_{10}(23)}{{log}_{10}(12)} \\\\  & =\\frac{\\operatorname{log}(23)}{\\operatorname{log}(12)} \\\\  & \\approx \\frac{1.361\\,728}{1.079\\,181} \\\\  & \\approx 1.262\\end{aligned}\n$$"}]}
