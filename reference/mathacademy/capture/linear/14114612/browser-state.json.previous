      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14114612/observations/step-q80370-1a11cd71d413a0443c8a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14114612/observations/step-q80370-1a11cd71d413a0443c8a.png",
      "source_url": "https://mathacademy.com/tasks/14114612/topics/2678/review",
