      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14114612/observations/step-q80091-dc4b922e36f918041ce9.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14114612/observations/step-q80091-dc4b922e36f918041ce9.png",
      "source_url": "https://mathacademy.com/tasks/14114612/topics/2678/review",
      "captured_at": 1791698985.6736479,
