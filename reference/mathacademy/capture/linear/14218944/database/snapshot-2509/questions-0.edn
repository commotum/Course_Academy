#{[{:db/id #edb/ref 17592186115093 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115264 :knowledge-point/id #uuid "bd783d1a-745d-5cd7-a5c3-9a109b6d1350" :knowledge-point/title "Plotting the Graph of a Horizontally Stretched Function"}] :question/id #uuid "57ece1a0-70e5-523f-8f6d-73a2fef43492" :question/math-academy-id "e-4983" :question/problem "![](images/1a/1a11bef66d0529418dde00e5713ed5e98f53a948c8a60f83fd056fd9e2c18698.png)\n\nPlot the graph of $y=f\\left(\\dfrac{1}{2}x \\right)$ for $y=f(x)$ given above." :question/worked-solution "To graph the function\n\n$$\ny = f\\left(\\dfrac{1}{2}x\\right)\n$$\n\nwe take the graph of $y = f(x)$ and stretch it by factor of $2$ parallel to the $x$-axis. This has the effect of multiplying the $x$-coordinates of all points on $y=f(x)$ by $2$.\n\nThe resulting graph is shown below.\n\n![](images/ae/ae191c7f3af5c16113d28c20572eba4559b08145327cab651a49ca7d39991502.png)"}] [{:db/id #edb/ref 17592186115094 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115265 :knowledge-point/id #uuid "d199ed2c-8188-5d80-9bb6-7b69ae684747" :knowledge-point/title "Plotting the Graph of a Horizontally Compressed Function"}] :question/id #uuid "9da96071-1bed-5e17-9d59-45948a0aaa5f" :question/math-academy-id "e-4984" :question/problem "The graph of $y=f(x)$ is shown below. Sketch the graph of $y=f(3x)$.\n\n![](images/0d/0d6473127647437b8f45b6a29713710534c9d36b4cc8be544be4f0a0a91a51bd.png)" :question/worked-solution "To graph the function $y=f(3x)$, we take the graph of $y=f(x)$ and compress it by factor of $3$ parallel to the $x$-axis. This has the effect of dividing the $x$-coordinates of all points on $y=f(x)$ by $3$.\n\nThe resulting graph is shown below.\n\n![](images/70/705a3f72f3a402a5f9c87157b335d1f9eda8468e28399b1bed0a6cb88218452c.png)"}] [{:db/id #edb/ref 17592186115095 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186115266 :knowledge-point/id #uuid "03cffed8-0c7f-5175-907c-3285cc07b2ec" :knowledge-point/title "Finding a Point that Lies on a Horizontally Stretched Function"}] :question/id #uuid "0063a610-8c9a-587f-bd0a-7296d778059b" :question/math-academy-id "e-4985" :question/problem "The point $P$ with coordinates $(6,7)$ lies on the curve $y=f(x)$. Find a point that must lie on the graph of $y= f\\left(\\dfrac{1}{4}x\\right)$." :question/worked-solution "The function\n\n$$\ny = f\\left(\\dfrac{1}{4}x\\right)\n$$\n\nrepresents a stretch of the function $y = f(x)$ by a factor of $4$ parallel to the $x$-axis. This has the effect of multiplying the $x$-coordinates of all points on $y=f(x)$ by $4$.\n\nTherefore, the point $(6,7)$ on $f(x)$ is mapped to the point\n\n$$\n\\left(4\\cdot 6, 7\\right) = (24,7)\n$$\n\nand this point must lie on the graph of\n\n$$\ny = f\\left(\\dfrac{1}{4}x\\right)\n$$"}] [{:db/id #edb/ref 17592186115517 :knowledge-point/_questions [{:db/id #edb/ref 17592186115264 :knowledge-point/id #uuid "bd783d1a-745d-5cd7-a5c3-9a109b6d1350" :knowledge-point/title "Plotting the Graph of a Horizontally Stretched Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f4b8454-70f2-52b8-a588-1eb23a87817d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5b/5b243e1bc72f5a26940444f79a35fd976ece5a5b52efd3a6f06122fde8b2753f.png" :db/id #edb/ref 17592186112112} {:answer/id #uuid "b6d43673-7404-5738-a8fd-e0a88f5093be" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a5/a576eba399dc093bce6dcca8e2bb94e9540635f81760c22e29ef5e1cebba3d22.png" :db/id #edb/ref 17592186112113} {:answer/id #uuid "132d4e03-1a48-52f0-b14e-c53e728841df" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3d/3d95097deb2941922c10689c6b890dca21b0f472309a575090d660eb189b695d.png" :db/id #edb/ref 17592186112114} {:answer/id #uuid "23b786cd-f388-5ea4-b1d7-e992cbfdf141" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0c/0c4fe72068b86cc10eb28d7856338a5f70ba9efab1ac14eba61152fb9fe64ecd.png" :db/id #edb/ref 17592186112115} {:answer/id #uuid "3a006c58-3673-5b90-ab45-6fe5e306c2b8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1e/1e9d42287b036cd39a629d282a1f77d77d5351cfbf2c9add13a0f16868856365.png" :db/id #edb/ref 17592186112116}] :answer-field/id #uuid "e829bc19-97da-5fef-8303-762a1b1fd60e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186112111}] :question/id #uuid "480564a8-84d8-5f3d-af71-9694637aa517" :question/math-academy-id "q-16668" :question/problem "![](images/13/136b4d945288f7492273d66b1795e82183699b14fe898b4537e16fc36ad5bf5b.png)\n\nThe graph of $y = f(x)$ is shown above. Which of the following is the graph of $y = f(\\frac{1}{2}x)$?\n\n(*Note: Figures not drawn to scale*)"}]}
