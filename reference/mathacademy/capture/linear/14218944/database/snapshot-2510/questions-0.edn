 the function $y=f(3x),$ we take the graph of $y=f(x)$ and compress it by factor of $3$ parallel to the $x$-axis. This has the effect of dividing the $x$-coordinates of all points on $y=f(x)$ by $3.$\n\nThe resulting graph is shown below.\n\n![](images/b8/b84a3ca0b17949c07748e73235d026d696c199136e448b32639959036c5389a8.png)"}] [{:db/id #edb/ref 17592186530509 :knowledge-point/_questions [{:db/id #edb/ref 17592186115264 :knowledge-point/id #uuid "bd783d1a-745d-5cd7-a5c3-9a109b6d1350" :knowledge-point/title "Plotting the Graph of a Horizontally Stretched Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a1cc3a4-21f2-5582-964d-0251bd68aff1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/14/145e1fa0eaa6449723c3fbed3c8a75fb79081f770f7c9e4bd82a4618d78843eb.png" :db/id #edb/ref 17592186529630} {:answer/id #uuid "3f75c274-6bf7-5dca-8a8e-f2057b378c46" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3a/3ab140478396e14d93854f6901ce167c6c19f9b863d819b0ac7015bae367411c.png" :db/id #edb/ref 17592186529728} {:answer/id #uuid "6ed09593-bef3-549e-81f0-c8a78defea47" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6e/6e30bafc3340d1245bcf5100cf527382752b8d181d4610f939f573347e834da2.png" :db/id #edb/ref 17592186529866} {:answer/id #uuid "97e00b75-e3b8-5185-b06c-0f352fb0da4a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/48/4898556c3fed28697c2629b6e378e3013278b2ec65113f6ce8793d1a5dd60872.png" :db/id #edb/ref 17592186529952} {:answer/id #uuid "99360503-37d8-58fb-9406-8b209b2cadaa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/22/22b7d495dcd67598134e446703bc55342222d11160f82d9e89189b88f1f03266.png" :db/id #edb/ref 17592186529955}] :answer-field/correct {:answer/id #uuid "3f75c274-6bf7-5dca-8a8e-f2057b378c46" :answ