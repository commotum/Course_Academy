#{[{:db/id #edb/ref 17592186059458 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059632 :knowledge-point/id #uuid "8daba5bf-5162-5779-9512-f22d0c8c0320" :knowledge-point/title "Evaluating Piecewise Functions"}] :question/id #uuid "92d4072d-90d5-5b12-b043-9361efb446cd" :question/math-academy-id "e-1749" :question/problem "For the function $g(x)$ defined on the set of integers, find $g(-12)$ and $g(3)$, where $g(x)$ is the following piecewise function:\n${2x,\\begin{vmatrix}x < 1 \\\\ 3x,\\end{vmatrix}x \\ge 1$" :question/worked-solution "- First, we compute $g(-12)$. Since $-12 < 1$, we use the first branch:\n$g(x)|= 2x; g(-12)|= 2(-12); =-24$\n- Next, we compute $g(3)$. Since $3 \\geq 1$, we use the second branch:\n$g(x)|= 3x; g(3)|= 3(3); = 9$"}] [{:db/id #edb/ref 17592186059459 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059633 :knowledge-point/id #uuid "a0df71e7-73ee-5b39-9c36-053215d90052" :knowledge-point/title "Graphing a Piecewise Step Function"}] :question/id #uuid "05e153cd-83bb-5d6a-b316-58835ee0fab2" :question/math-academy-id "e-1751" :question/problem "Given that\n${3,\\begin{vmatrix}x < - 3 \\\\ 1,\\end{vmatrix}x \\ge - 3$\nwhat is the graph of $y=f(x)$?" :question/worked-solution "We will graph each branch separately.\n\n- On the interval $(-\\infty, -3)$, we have $f(x) = 3$, so the graph is a horizontal line that ends at $(-3,3)$, excluding this point.\n- On the interval $[-3, \\infty)$, we have $f(x) = 1$, so the graph is a horizontal line that begins at $(-3,1)$, including this point.\n\nTherefore, the graph of the given function is as follows:\n\n![](images/f0/f0cdcbeb59ce6f011504ead0de090fa79c925fb933b1a99ce2f885e61eb33107.png)"}] [{:db/id #edb/ref 17592186059608 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059634 :knowledge-point/id #uuid "bfe3639d-d134-5e2e-b405-a9285a33ec6c" :knowledge-point/title "Graphing a Piecewise Function"}] :question/id #uuid "c2b247d7-416c-5a41-99c2-b6afd3ca918a" :question/math-academy-id "e-6752" :question/problem "If $f$ is the piecewise function\n${-1,\\begin{vmatrix}x \\le 0 \\\\ -x + 2,\\end{vmatrix}x > 0$\nwhat is the graph of $y=f(x)$?" :question/worked-solution "We will graph each branch separately.\n\n- On the interval $(-\\infty, 0]$, we have $f(x) = -1$, so the graph is a horizontal line that ends at $(0,-1)$, including this point.\n- On the interval $(0, \\infty)$, we have $f(x) =-x+2$, so the graph is a straight line of slope $-1$ that starts from $(0,2)$, not including this point.\n\nTherefore, the graph of the given function is as follows:\n\n![](images/47/47a6d2d5b84424d0347efc7d9dc64ee90323855b233fde68827bff2a820121af.png)"}] [{:db/id #edb/ref 17592186059623 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059635 :knowledge-point/id #uuid "ec82342d-2986-5483-88f0-a0c85cac5110" :knowledge-point/title "The Domain of a Piecewise Function"}] :question/id #uuid "0ea16984-1ed3-51a5-b425-bfffea3bcd77" :question/math-academy-id "e-9628" :question/problem "What is the domain of the function shown below?\n\n![](images/2b/2b0235b4a984b1560312cef1c315ca8955bf062a90b75c3e03df8ee027e3cbd4.png)" :question/worked-solution "The function is defined for values between $-4$ and $1$.\n\n- Since there is an open circle at $x=-4$, this point is not included in the domain.\n- Since there is a closed circle at $x=-1$, this point is included in the domain.\n- Since there is an open circle at $x=1$, this point is not included in the domain.\n\nSo, the function $f(x)$ above is defined for values between $x=-4$ and $x=1$, not including $x=-4$ and $x=1$ but including $x=-1$.\n\nTherefore, the domain is\n$x\\in (-4,1)$\n\nNote that the function is defined at the point $x=-1$, even though the function jumps at that point. The function value at $x=-1$ is $2$."}] [{:db/id #edb/ref 17592186060191 :knowledge-point/_questions [{:db/id #edb/ref 17592186059634 :knowledge-point/id #uuid "bfe3639d-d134-5e2e-b405-a9285a33ec6c" :knowledge-point/title "Graphing a Piecewise Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "891e1446-aeb4-56dd-902e-3b3d0df1c63f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x) = {2x + 1,\\begin{vmatrix}x \\le 1 \\\\ 2 - 2x,\\end{vmatrix}x > 1" :db/id #edb/ref 17592186057607} {:answer/id #uuid "abb454b4-6d74-5119-85f4-a178c7af259e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The graph is not a function" :db/id #edb/ref 17592186057608} {:answer/id #uuid "1448b4e6-93b5-59e9-85f0-638cc69a0836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x) = {2x + 1,\\begin{vmatrix}x \\le 1 \\\\ -2 - 2x,\\end{vmatrix}x > 1" :db/id #edb/ref 17592186057609} {:answer/id #uuid "2f11273a-8282-5d13-937b-81436864bd8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x) = {2x - 1,\\begin{vmatrix}x \\le 1 \\\\ 1 - 2x,\\end{vmatrix}x > 1" :db/id #edb/ref 17592186057610} {:answer/id #uuid "600aabe7-52e5-51bf-9579-76add8df5245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x) = {1 - x,\\begin{vmatrix}x \\le 1 \\\\ x - 1,\\end{vmatrix}x > 1" :db/id #edb/ref 17592186057611}] :answer-field/id #uuid "070fe48e-347f-5977-a780-ed4db2b88659" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057606}] :question/id #uuid "2551a862-e523-555f-9254-175cc890352b" :question/math-academy-id "q-19304" :question/problem "![](images/1a/1a7b132b3efcd909ec61421c956c6808cdbfd813123e2e9341fd0116d0d3deda.png)\n\nWhat is the definition of the function $y = f(x)$ shown above?"}] [{:db/id #edb/ref 17592186060275 :knowledge-point/_questions [{:db/id #edb/ref 17592186059635 :knowledge-point/id #uuid "ec82342d-2986-5483-88f0-a0c85cac5110" :knowledge-point/title "The Domain of a Piecewise Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88a95b84-b03d-5118-b29c-7eaabee3f479" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,-1)∪(-1, 4]" :db/id #edb/ref 17592186058273} {:answer/id #uuid "e6defdc8-ed75-5d77-8b89-7fb2e32cc26e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- ∞,-1)∪(-1, 4]" :db/id #edb/ref 17592186058274} {:answer/id #uuid "097adcd4-0edf-58cc-835f-7da96d89ebe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- ∞,-1)∪(-1, ∞)" :db/id #edb/ref 17592186058275} {:answer/id #uuid "25eeb931-cd9d-592b-8c1b-e3bc7888163e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- ∞,-1)∪(-1, 4)" :db/id #edb/ref 17592186058276} {:answer/id #uuid "68430067-b826-5d08-9c81-151706a857db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- ∞, 4]" :db/id #edb/ref 17592186058277}] :answer-field/id #uuid "8b3336fc-3ab6-5f17-8fab-6bf06fa9d81c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058272}] :question/id #uuid "5fce58b4-e9bb-50e8-aefb-7f6df598ae68" :question/math-academy-id "q-34612" :question/problem "![](images/48/4822b0bf0e9bf1d2ac7d6410f2f1768c35a5504188eb58581d6f723772e5bb0a.png)\n\nWhat is the domain of the function shown above?"}]}
