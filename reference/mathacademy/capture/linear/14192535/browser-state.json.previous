    "q-34612": {
      "dom_id": "step-q34612",
      "name": "Question 7",
      "problem": "![](/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14192535/assets/4822b0bf0e9bf1d2ac7d6410f2f1768c35a5504188eb58581d6f723772e5bb0a.png)\n\nWhat is the domain of the function shown above?",
      "worked_solution": "The function is defined  for values less than $-1,$ and between $-1$ and $4.$\n\n- Since there is a closed circle at $x=4,$ this point is included in the domain.\n\n- On the other hand, because there are two open circles for $x=-1,$ this point is not included in the domain.\n\nTherefore, the domain is\n\n$$\nx\\in (-\\infty ,-1)\\cup (-1,4].\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-34612-a",
