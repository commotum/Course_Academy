#{[{:db/id #edb/ref 17592186570033 :knowledge-point/_questions [{:db/id #edb/ref 17592186110595 :knowledge-point/id #uuid "7d076e5d-9d08-5355-b813-d1749feb0803" :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "310d0146-d260-5636-89ab-ecc12e622eae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.353" :db/id #edb/ref 17592186569514} {:answer/id #uuid "437278c9-7a76-5f2e-b4a6-02500ee6a3f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.335" :db/id #edb/ref 17592186569537} {:answer/id #uuid "7d7a2b6a-8f01-536e-a4bb-dec07965bb90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.533" :db/id #edb/ref 17592186569651} {:answer/id #uuid "9be72108-4bdd-5fab-a923-17cc67035375" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.303" :db/id #edb/ref 17592186569692} {:answer/id #uuid "c72edcf4-d019-51c5-b9b0-7370b8b2c4d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.350" :db/id #edb/ref 17592186569761}] :answer-field/correct {:answer/id #uuid "437278c9-7a76-5f2e-b4a6-02500ee6a3f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.335" :db/id #edb/ref 17592186569537} :answer-field/id #uuid "e8491df2-d5c3-5271-8329-efe669739dd5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569941}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e0b9a214-575e-56bc-9016-1d953bb568c0" :question/math-academy-id "q-100254" :question/problem "Given that ${7}^{5x}+8=34,$ find the value of $x$ rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{7}^{5x}+8 & =34 \\\\ {7}^{5x} & =26\\end{aligned}\n$$\n\nNow, we take ${log}_{7}$ of both sides of the equation and solve for $x$:\n\n$$\n\\begin{aligned}{7}^{5x} & =26 \\\\ {log}_{7}⁡({7}^{5x}) & ={log}_{7}⁡(26) \\\\ 5x & ={log}_{7}⁡(26) \\\\ x & =\\frac{1}{5}{log}_{7}⁡(26)\\end{aligned}\n$$\n\nEvaluating the above on a calculator gives\n\n$$\nx≈0.335\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186570041 :knowledge-point/_questions [{:db/id #edb/ref 17592186110594 :knowledge-point/id #uuid "9a7784d8-f6a4-5e45-b03e-d76a27372c48" :knowledge-point/title "Finding Approximate Solutions to Exponential Equations Using Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f642b7e-3aa4-589d-b5d0-69cd84cc61e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.041" :db/id #edb/ref 17592186569466} {:answer/id #uuid "4e71bb66-f31b-56f1-8b96-dceb6bb51802" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.911" :db/id #edb/ref 17592186569553} {:answer/id #uuid "6a7282e0-ffd3-5bad-a6f6-578fd6e4195e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.041" :db/id #edb/ref 17592186569610} {:answer/id #uuid "9762dcaa-9d7a-5565-8692-82ad8a90275e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.771" :db/id #edb/ref 17592186569682} {:answer/id #uuid "b59296e7-69ea-5b0f-8c88-fdca508c6ae7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.771" :db/id #edb/ref 17592186569731}] :answer-field/correct {:answer/id #uuid "b59296e7-69ea-5b0f-8c88-fdca508c6ae7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.771" :db/id #edb/ref 17592186569731} :answer-field/id #uuid "335d885a-d13c-55bb-8478-3d052924914c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569864}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fa39cf5e-b1cf-510a-a444-4f30da1c63f4" :question/math-academy-id "q-66814" :question/problem "Given that ${11}^{2x-3}=\\sqrt[3]{{7}^{2}},$  find the value of $x$ rounded to $3$ decimal places." :question/worked-solution "Taking ${log}_{11}$ of both sides of the equation gives:\n\n$$\n\\begin{aligned}{11}^{2x-3} & =\\sqrt[3]{{7}^{2}} \\\\ {log}_{11}⁡({11}^{2x-3}) & ={log}_{11}⁡(\\sqrt[3]{{7}^{2}}) \\\\ 2x-3 & ={log}_{11}⁡({7}^{2/3})\\end{aligned}\n$$\n\nThen, we apply the power rule to the right-hand side:\n\n$$\n2x-3=\\frac{2}{3}{log}_{11}⁡(7)\n$$\n\nNext, we rewrite the right-hand side using the change of base formula and then solve for $x:$\n\n$$\n\\begin{aligned}2x-3 & =\\frac{2\\operatorname{log}⁡(7)}{3\\operatorname{log}⁡(11)} \\\\ 2x & =\\frac{2\\operatorname{log}⁡(7)}{3\\operatorname{log}⁡(11)}+3 \\\\ x & =\\frac{\\operatorname{log}⁡(7)}{3\\operatorname{log}⁡(11)}+\\frac{3}{2}\\end{aligned}\n$$\n\nEvaluating the above on a calculator gives\n\n$$\nx≈1.771\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186569966 :knowledge-point/_questions [{:db/id #edb/ref 17592186110595 :knowledge-point/id #uuid "7d076e5d-9d08-5355-b813-d1749feb0803" :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "014ac208-df51-5c62-a006-7a4b9940094f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.527" :db/id #edb/ref 17592186569448} {:answer/id #uuid "6d3ecb1e-79b9-5c0c-8d13-23fcec2c2084" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.176" :db/id #edb/ref 17592186569617} {:answer/id #uuid "6e72282c-66ef-50e5-a1aa-f7ce5f8bbebe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.631" :db/id #edb/ref 17592186569621} {:answer/id #uuid "a121dafc-2f1c-5f9d-9334-83be1e4a3593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.585" :db/id #edb/ref 17592186569699} {:answer/id #uuid "de3f796d-328d-51b3-a6f9-559142e7a197" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.585" :db/id #edb/ref 17592186569797}] :answer-field/correct {:answer/id #uuid "6e72282c-66ef-50e5-a1aa-f7ce5f8bbebe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.631" :db/id #edb/ref 17592186569621} :answer-field/id #uuid "f58ba2f4-b668-5a8c-92f5-c9264d481c97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569950}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19a2dc0a-21a4-5b89-85c8-47422a295e17" :question/math-academy-id "q-974" :question/problem "Given that $\\frac{5}{2}\\cdot {3}^{x}=5,$ find the value of $x$ rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{5}{2}\\cdot {3}^{x} & =5 \\\\ {3}^{x} & =2\\end{aligned}\n$$\n\nNow, we take ${log}_{3}$ of both sides of the equation and solve for $x$:\n\n$$\n\\begin{aligned}{3}^{x} & =2 \\\\ {log}_{3}⁡({3}^{x}) & ={log}_{3}⁡(2) \\\\ x & ={log}_{3}⁡(2)\\end{aligned}\n$$\n\nNext, we rewrite the right-hand side using the change of base formula:\n\n$$\nx=\\frac{\\operatorname{log}⁡(2)}{\\operatorname{log}⁡(3)}\n$$\n\nEvaluating the above on a calculator gives\n\n$$\nx≈0.631\n$$\n\nrounded to $3$ decimal places."}]}
