#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186111491} :activity/id #uuid "f8c81811-3f72-5396-b8eb-321dbcd75f82" :activity/scope {:db/id #edb/ref 17592186049053 :topic/id #uuid "d5efe33b-5861-5f40-bd4b-3f871de6b84d" :topic/math-academy-id 1482} :activity/steps [{:db/id #edb/ref 17592186111491 :step/content {:db/id #edb/ref 17592186111879 :tutorial/content "We can use logarithms to solve equations where the variable is in an exponent.\nFor instance, suppose we are given the equation \n\n$$\n{\\color{blue}2}^x=5.\n$$\n\nNotice that the base of the exponential is ${\\color{blue}2}.$ So, if we take $\\log_{\\color{blue}2}$ of both sides of the equation, we have that\n\n$$\n\\begin{aligned}{log}_{2}⁡({2}^{x}) & ={log}_{2}⁡(5).\\end{aligned}\n$$\n\nNow, we can use the fact that $\\log_{\\color{blue}b} \\left( {\\color{blue}b}^c \\right) = c$ to simplify the left-hand side. This gives\n\n$$\nx = \\log_{\\color{blue}2} (5).\n$$\n\nThis is the solution! We often present the solution of an exponential equation as an exact solution in logarithmic form.\n\nNote that when taking the $\\log_b$ of both sides of an exponential equation, we always use the base of the exponential as the base of the logarithm." :tutorial/id #uuid "bcae8943-0768-5280-ad4d-a67f04877fbe" :tutorial/math-academy-id 2794 :tutorial/title "Introduction"} :step/id #uuid "e9f045cc-a10e-5c66-b731-eb57c6883345" :step/math-academy-id 14453 :step/next {:db/id #edb/ref 17592186111492}} {:db/id #edb/ref 17592186111492 :step/content {:db/id #edb/ref 17592186110593 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110494 :question/id #uuid "7c937587-dc81-5ee9-aa66-a509a87433e2" :question/math-academy-id "e-4067"} :knowledge-point/id #uuid "34f4b65e-b93a-51e8-b943-b3b53d47fffb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725}] :knowledge-point/questions [{:db/id #edb/ref 17592186111048} {:db/id #edb/ref 17592186111370} {:db/id #edb/ref 17592186544786} {:db/id #edb/ref 17592186544814}] :knowledge-point/title "Finding Exact Solutions to Exponential Equations Using Logarithms"} :step/id #uuid "b19bc194-a2b5-5800-8dae-7a6d496cb4da" :step/math-academy-id 14454 :step/next {:db/id #edb/ref 17592186111493}} {:db/id #edb/ref 17592186111493 :step/content {:db/id #edb/ref 17592186110594 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110495 :question/id #uuid "45d74b50-fd9d-5d18-835d-a7e140278a34" :question/math-academy-id "e-4069"} :knowledge-point/id #uuid "9a7784d8-f6a4-5e45-b03e-d76a27372c48" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186049879}] :knowledge-point/questions [{:db/id #edb/ref 17592186111371} {:db/id #edb/ref 17592186111426} {:db/id #edb/ref 17592186544846} {:db/id #edb/ref 17592186544881} {:db/id #edb/ref 17592186570041}] :knowledge-point/title "Finding Approximate Solutions to Exponential Equations Using Logarithms"} :step/id #uuid "8529df34-5e48-53b8-8d64-f02185cbc66e" :step/math-academy-id 14465 :step/next {:db/id #edb/ref 17592186111494}} {:db/id #edb/ref 17592186111494 :step/content {:db/id #edb/ref 17592186110595 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110496 :question/id #uuid "5d31a3e8-aae6-50b5-9ce1-65cef1d8395e" :question/math-academy-id "e-4071"} :knowledge-point/id #uuid "7d076e5d-9d08-5355-b813-d1749feb0803" :knowledge-point/questions [{:db/id #edb/ref 17592186110892} {:db/id #edb/ref 17592186111372} {:db/id #edb/ref 17592186234211} {:db/id #edb/ref 17592186544836} {:db/id #edb/ref 17592186569966} {:db/id #edb/ref 17592186570033}] :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"} :step/id #uuid "f8398d77-d45f-5c49-9a78-fef3d56b0cd8" :step/math-academy-id 14467}] :activity/title "Solving Exponential Equations Using Logarithms" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110848}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570056} :activity/id #uuid "5ca3793e-9c61-5fbb-9fe2-bc247e9dc655" :activity/scope {:db/id #edb/ref 17592186049053 :topic/id #uuid "d5efe33b-5861-5f40-bd4b-3f871de6b84d" :topic/math-academy-id 1482} :activity/steps [{:db/id #edb/ref 17592186570056 :step/content {:db/id #edb/ref 17592186569966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "014ac208-df51-5c62-a006-7a4b9940094f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.527" :db/id #edb/ref 17592186569448} {:answer/id #uuid "6d3ecb1e-79b9-5c0c-8d13-23fcec2c2084" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.176" :db/id #edb/ref 17592186569617} {:answer/id #uuid "6e72282c-66ef-50e5-a1aa-f7ce5f8bbebe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.631" :db/id #edb/ref 17592186569621} {:answer/id #uuid "a121dafc-2f1c-5f9d-9334-83be1e4a3593" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.585" :db/id #edb/ref 17592186569699} {:answer/id #uuid "de3f796d-328d-51b3-a6f9-559142e7a197" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.585" :db/id #edb/ref 17592186569797}] :answer-field/correct {:db/id #edb/ref 17592186569621} :answer-field/id #uuid "f58ba2f4-b668-5a8c-92f5-c9264d481c97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569950}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "19a2dc0a-21a4-5b89-85c8-47422a295e17" :question/math-academy-id "q-974" :question/problem "Given that $\\frac{5}{2}\\cdot {3}^{x}=5,$ find the value of $x$ rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{5}{2}\\cdot {3}^{x} & =5 \\\\ {3}^{x} & =2\\end{aligned}\n$$\n\nNow, we take ${log}_{3}$ of both sides of the equation and solve for $x$:\n\n$$\n\\begin{aligned}{3}^{x} & =2 \\\\ {log}_{3}⁡({3}^{x}) & ={log}_{3}⁡(2) \\\\ x & ={log}_{3}⁡(2)\\end{aligned}\n$$\n\nNext, we rewrite the right-hand side using the change of base formula:\n\n$$\nx=\\frac{\\operatorname{log}⁡(2)}{\\operatorname{log}⁡(3)}\n$$\n\nEvaluating the above on a calculator gives\n\n$$\nx≈0.631\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "4a92addf-a789-59af-809f-318e8cab3755" :step/next {:db/id #edb/ref 17592186570063}} {:db/id #edb/ref 17592186570063 :step/content {:db/id #edb/ref 17592186570041 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f642b7e-3aa4-589d-b5d0-69cd84cc61e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2.041" :db/id #edb/ref 17592186569466} {:answer/id #uuid "4e71bb66-f31b-56f1-8b96-dceb6bb51802" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.911" :db/id #edb/ref 17592186569553} {:answer/id #uuid "6a7282e0-ffd3-5bad-a6f6-578fd6e4195e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.041" :db/id #edb/ref 17592186569610} {:answer/id #uuid "9762dcaa-9d7a-5565-8692-82ad8a90275e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1.771" :db/id #edb/ref 17592186569682} {:answer/id #uuid "b59296e7-69ea-5b0f-8c88-fdca508c6ae7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.771" :db/id #edb/ref 17592186569731}] :answer-field/correct {:db/id #edb/ref 17592186569731} :answer-field/id #uuid "335d885a-d13c-55bb-8478-3d052924914c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569864}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fa39cf5e-b1cf-510a-a444-4f30da1c63f4" :question/math-academy-id "q-66814" :question/problem "Given that ${11}^{2x-3}=\\sqrt[3]{{7}^{2}},$  find the value of $x$ rounded to $3$ decimal places." :question/worked-solution "Taking ${log}_{11}$ of both sides of the equation gives:\n\n$$\n\\begin{aligned}{11}^{2x-3} & =\\sqrt[3]{{7}^{2}} \\\\ {log}_{11}⁡({11}^{2x-3}) & ={log}_{11}⁡(\\sqrt[3]{{7}^{2}}) \\\\ 2x-3 & ={log}_{11}⁡({7}^{2/3})\\end{aligned}\n$$\n\nThen, we apply the power rule to the right-hand side:\n\n$$\n2x-3=\\frac{2}{3}{log}_{11}⁡(7)\n$$\n\nNext, we rewrite the right-hand side using the change of base formula and then solve for $x:$\n\n$$\n\\begin{aligned}2x-3 & =\\frac{2\\operatorname{log}⁡(7)}{3\\operatorname{log}⁡(11)} \\\\ 2x & =\\frac{2\\operatorname{log}⁡(7)}{3\\operatorname{log}⁡(11)}+3 \\\\ x & =\\frac{\\operatorname{log}⁡(7)}{3\\operatorname{log}⁡(11)}+\\frac{3}{2}\\end{aligned}\n$$\n\nEvaluating the above on a calculator gives\n\n$$\nx≈1.771\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "619dfb5e-d397-51db-b22a-87b658c7b4af" :step/next {:db/id #edb/ref 17592186570085}} {:db/id #edb/ref 17592186570085 :step/content {:db/id #edb/ref 17592186570033 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "310d0146-d260-5636-89ab-ecc12e622eae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.353" :db/id #edb/ref 17592186569514} {:answer/id #uuid "437278c9-7a76-5f2e-b4a6-02500ee6a3f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.335" :db/id #edb/ref 17592186569537} {:answer/id #uuid "7d7a2b6a-8f01-536e-a4bb-dec07965bb90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.533" :db/id #edb/ref 17592186569651} {:answer/id #uuid "9be72108-4bdd-5fab-a923-17cc67035375" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.303" :db/id #edb/ref 17592186569692} {:answer/id #uuid "c72edcf4-d019-51c5-b9b0-7370b8b2c4d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.350" :db/id #edb/ref 17592186569761}] :answer-field/correct {:db/id #edb/ref 17592186569537} :answer-field/id #uuid "e8491df2-d5c3-5271-8329-efe669739dd5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569941}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e0b9a214-575e-56bc-9016-1d953bb568c0" :question/math-academy-id "q-100254" :question/problem "Given that ${7}^{5x}+8=34,$ find the value of $x$ rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{7}^{5x}+8 & =34 \\\\ {7}^{5x} & =26\\end{aligned}\n$$\n\nNow, we take ${log}_{7}$ of both sides of the equation and solve for $x$:\n\n$$\n\\begin{aligned}{7}^{5x} & =26 \\\\ {log}_{7}⁡({7}^{5x}) & ={log}_{7}⁡(26) \\\\ 5x & ={log}_{7}⁡(26) \\\\ x & =\\frac{1}{5}{log}_{7}⁡(26)\\end{aligned}\n$$\n\nEvaluating the above on a calculator gives\n\n$$\nx≈0.335\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "be7b6383-ca84-5004-8ffd-368e7e44f857"}] :activity/title "Solving Exponential Equations Using Logarithms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186569438}]}
