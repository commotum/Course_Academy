#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111508} :activity/id #uuid "5fbb27e3-c74f-5f9c-91d3-ed4d700e940a" :activity/scope {:db/id #edb/ref 17592186048741 :topic/id #uuid "ba61133e-2980-52f4-ab73-d0df517adbd4" :topic/math-academy-id 1551} :activity/steps [{:db/id #edb/ref 17592186111508 :step/content {:db/id #edb/ref 17592186111882 :tutorial/content "To solve logarithmic equations containing the natural logarithm $(\\ln),$ we can use the same method as usual: first isolate the logarithm, and then exponentiate both sides of the equation using the same base as the logarithm.\n\nThe key is to remember that the base of the natural logarithm is $e.$\n\nTo demonstrate, let's solve for $x$ in the equation $\\ln x = 2.$\n\nTo remove the logarithm, we exponentiate both sides of the equation. The logarithm is a natural logarithm, which means its base is $e.$ So, we use a base of $e$ for the exponentiation as well:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡x & =2 \\\\ {e}^{\\operatorname{ln}⁡x} & ={e}^{2}\\end{aligned}\n$$\n\nSince exponentiation is the inverse function of the logarithm, we know that $e^{\\ln x} = x.$ \n\nTherefore, we get\n\n$$\n\\begin{aligned}x & ={e}^{2}.\\end{aligned}\n$$\n\nSo, the solution is $x=e^2.$" :tutorial/id #uuid "7e032551-9488-5bc5-858a-2197849a42cf" :tutorial/math-academy-id 2821 :tutorial/title "Introduction"} :step/id #uuid "c10874f0-296d-50d3-83ba-2cd2a1d44b40" :step/math-academy-id 14892 :step/next {:db/id #edb/ref 17592186111509}} {:db/id #edb/ref 17592186111509 :step/content {:db/id #edb/ref 17592186110606 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110503 :question/id #uuid "44c87021-177d-5f5c-b1f9-47eb08f107a6" :question/math-academy-id "e-4146"} :knowledge-point/id #uuid "8dec21a9-eec8-5e39-9af6-5ba355a11c5b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049589} {:db/id #edb/ref 17592186049944}] :knowledge-point/questions [{:db/id #edb/ref 17592186110937} {:db/id