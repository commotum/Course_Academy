 data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mn>0</mn></mrow></munder><mfrac><mrow><mn>4</mn><msqrt><mi>x</mi><mo>+</mo><mn>4</mn></msqrt><mo>−</mo><mi>x</mi><mo>−</mo><mn>8</mn></mrow><msup><mi>x</mi><mn>2</mn></msup></mfrac></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mn>0</mn></mrow></munder><mfrac><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mn>4</mn><msqrt><mi>x</mi><mo>+</mo><mn>4</mn></msqrt><mo>−</mo><mi>x</mi><mo>−</mo><mn>8</mn><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo data-mjx-alternate=\"1\">′</mo></msup><mrow><mo stretchy=\"false\">[</mo><msup><mi>x</mi><mn>2</mn></msup><msup><mo stretchy=\"false\">]</mo><mo data-mjx-alternate=\"1\">′</mo></msup></mrow></mfrac></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><msqrt><mi>x</mi><mo>+</mo><mn>4</mn></msqrt></mfrac></mstyle><mo>−</mo><mn>1</mn><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mrow><mn>2</mn><mi>x</mi></mrow></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>This time, the resulting limit still gives the indeterminate form <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"9\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-m