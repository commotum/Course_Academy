 Polygon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b52f5af-7d6b-569b-8fde-d1522bdf7ca1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{50}^{∘}" :db/id #edb/ref 17592186506855} {:answer/id #uuid "50c84c90-34e5-52bb-b7fd-555a98604332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{40}^{∘}" :db/id #edb/ref 17592186506862} {:answer/id #uuid "6fffe8d2-c474-56bc-918b-dea5da6268b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{70}^{∘}" :db/id #edb/ref 17592186506936} {:answer/id #uuid "80f27afc-3eb4-5dee-bffe-22bc5d994142" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{55}^{∘}" :db/id #edb/ref 17592186506963} {:answer/id #uuid "c42ae78f-0cf2-55bb-bdac-ba38eb55f931" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186507108}] :answer-field/correct {:answer/id #uuid "50c84c90-34e5-52bb-b7fd-555a98604332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{40}^{∘}" :db/id #edb/ref 17592186506862} :answer-field/id #uuid "63526ff4-978e-5027-b198-bcb2aed785de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186507297}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "841a0e71-68f5-57fb-a64f-360ce08a6366" :question/math-academy-id "q-68411" :question/problem "![](images/04/0425d0fe9dea48f907b945e659ec94311bdc868a3ede3c484c6b1ed6fc6f3b9f.png)\n\nWhat is the measure of each exterior angle of a regular nonagon?" :question/worked-solution "For any polygon, the exterior angles sum to ${360}^{∘}.$ In a regular nonagon, there are $9$ equivalent exterior angles, so each has a measure of \n\n$$\n\\frac{{360}^{∘}}{9}={40}^{∘}.\n$$"}]}
