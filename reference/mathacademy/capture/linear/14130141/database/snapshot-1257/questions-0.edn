#{[{:db/id #edb/ref 17592186142510 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142772 :knowledge-point/id #uuid "9c58126c-3d5b-5c2e-aaa4-7f9304e77935" :knowledge-point/title "Multiplying a Fraction by a Whole Number"}] :question/id #uuid "714ed22d-8268-502d-9d74-12620cb1c4fe" :question/math-academy-id "e-13393" :question/problem "Find the value of $5\\times \\dfrac{1}{12}.$" :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n5\\times \\dfrac{1}{12}= \\dfrac{5\\times 1}{12} = \\dfrac{5}{12}\n$$"}] [{:db/id #edb/ref 17592186142511 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142773 :knowledge-point/id #uuid "e3c96e1c-a8cd-5d6d-b4ae-7497c4694407" :knowledge-point/title "Multiplying a Fraction by a Whole Number Resulting in a Whole Number"}] :question/id #uuid "499b112b-863b-568a-bd56-f32d66b619fc" :question/math-academy-id "e-13394" :question/problem "Multiply $\\dfrac{2}{3}\\times 3.$" :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\dfrac{2\\times 3}{3} = \\dfrac{6}{3}\n$$\n\nFinally, we simplify this fraction by interpreting $\\dfrac 6 3$ as a division:\n\n$$\n6\\div 3 =2\n$$"}] [{:db/id #edb/ref 17592186142512 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142774 :knowledge-point/id #uuid "d3bbd0c1-1e52-5f95-b5b1-7270f49e5f5d" :knowledge-point/title "Multiplying a Fraction by a Whole Number With Simplification"}] :question/id #uuid "da8475a1-d48e-5989-b1a9-a7c72a205fd2" :question/math-academy-id "e-13395" :question/problem "Multiply $\\dfrac{1}{6}\\times 4.$" :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\dfrac{1\\times 4}{6} = \\dfrac{4}{6}\n$$\n\nTo simplify this fraction, we can divide the numerator and denominator by $2\\mathbin{:}$\n\n$$\n\\dfrac{4\\div 2}{6\\div 2} = \\dfrac{2}{3}\n$$"}] [{:db/id #edb/ref 17592186142513 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142775 :knowledge-point/id #uuid "91037b32-189a-5ba9-ab0a-117f6255c496" :knowledge-point/title "Multiplying a Fraction by a Whole Number Resulting in a Mixed Number"}] :question/id #uuid "494ad564-7a01-533e-887a-6c83a2fb4e78" :question/math-academy-id "e-13396" :question/problem "Find the value $9\\times\\dfrac 3 {4}$ as a mixed number." :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n9\\times \\dfrac{3}{4} = \\dfrac{9\\times 3}{4} = \\dfrac{27}{4}\n$$\n\nWe now convert this to a mixed number:\n\n$$\n27\\div 4 = 6\\,\\textrm{R} 3 = 6\\,\\dfrac{3}{4}\n$$"}] [{:db/id #edb/ref 17592186426010 :knowledge-point/_questions [{:db/id #edb/ref 17592186142772 :knowledge-point/id #uuid "9c58126c-3d5b-5c2e-aaa4-7f9304e77935" :knowledge-point/title "Multiplying a Fraction by a Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4625c41-25d2-5fa0-b1b6-5eb99a28e621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186425999}] :answer-field/correct {:answer/id #uuid "f4625c41-25d2-5fa0-b1b6-5eb99a28e621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186425999} :answer-field/id #uuid "b5e07511-8e6c-5a8d-be8d-3ddc240d0673" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186426003}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8a44c492-647e-5f02-873c-e9e875c25787" :question/math-academy-id "q-186825" :question/problem "Given that $\\frac{4}{7}\\times 5=\\frac{\\,\\boxed{}}{7},$ the missing number is{{field-1}}." :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{4\\times 5}{7}=\\frac{20}{7}\n$$\n\nTherefore, the missing number is $20.$"}] [{:db/id #edb/ref 17592186426009 :knowledge-point/_questions [{:db/id #edb/ref 17592186142772 :knowledge-point/id #uuid "9c58126c-3d5b-5c2e-aaa4-7f9304e77935" :knowledge-point/title "Multiplying a Fraction by a Whole Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09f3754e-b1c1-5f1e-ace2-3c70c5d86e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{11}" :db/id #edb/ref 17592186425982}] :answer-field/correct {:answer/id #uuid "09f3754e-b1c1-5f1e-ace2-3c70c5d86e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{11}" :db/id #edb/ref 17592186425982} :answer-field/id #uuid "ddf45ba1-7380-5978-8c24-51b8af98fc2a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186426005}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61ee6ad3-1a7f-5619-932c-25b8833f8ab3" :question/math-academy-id "q-186831" :question/problem "Expressed as an improper fraction in its lowest terms, $6\\times \\frac{3}{11}=${{field-1}}." :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{6\\times 3}{11}=\\frac{18}{11}\n$$"}] [{:db/id #edb/ref 17592186426008 :knowledge-point/_questions [{:db/id #edb/ref 17592186142775 :knowledge-point/id #uuid "91037b32-189a-5ba9-ab0a-117f6255c496" :knowledge-point/title "Multiplying a Fraction by a Whole Number Resulting in a Mixed Number"}]