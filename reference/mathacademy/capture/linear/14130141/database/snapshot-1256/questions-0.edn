#{[{:db/id #edb/ref 17592186142510 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142772 :knowledge-point/id #uuid "9c58126c-3d5b-5c2e-aaa4-7f9304e77935" :knowledge-point/title "Multiplying a Fraction by a Whole Number"}] :question/id #uuid "714ed22d-8268-502d-9d74-12620cb1c4fe" :question/math-academy-id "e-13393" :question/problem "Find the value of $5\\times \\dfrac{1}{12}$." :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n5\\times \\dfrac{1}{12}= \\dfrac{5\\times 1}{12} = \\dfrac{5}{12}\n$$"}] [{:db/id #edb/ref 17592186142511 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142773 :knowledge-point/id #uuid "e3c96e1c-a8cd-5d6d-b4ae-7497c4694407" :knowledge-point/title "Multiplying a Fraction by a Whole Number Resulting in a Whole Number"}] :question/id #uuid "499b112b-863b-568a-bd56-f32d66b619fc" :question/math-academy-id "e-13394" :question/problem "Multiply $\\dfrac{2}{3}\\times 3$." :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\dfrac{2\\times 3}{3} = \\dfrac{6}{3}\n$$\n\nFinally, we simplify this fraction by interpreting\n\n$$\n\\dfrac 6 3\n$$\n\nas a division:\n\n$$\n6\\div 3 =2\n$$"}] [{:db/id #edb/ref 17592186142512 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142774 :knowledge-point/id #uuid "d3bbd0c1-1e52-5f95-b5b1-7270f49e5f5d" :knowledge-point/title "Multiplying a Fraction by a Whole Number With Simplification"}] :question/id #uuid "da8475a1-d48e-5989-b1a9-a7c72a205fd2" :question/math-academy-id "e-13395" :question/problem "Multiply $\\dfrac{1}{6}\\times 4$." :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\dfrac{1\\times 4}{6} = \\dfrac{4}{6}\n$$\n\nTo simplify this fraction, we can divide the numerator and denominator by $2$:\n\n$$\n\\dfrac{4\\div 2}{6\\div 2} = \\dfrac{2}{3}\n$$"}] [{:db/id #edb/ref 17592186142513 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186142775 :knowledge-point/id #uuid "91037b32-189a-5ba9-ab0a-117f6255c496" :knowledge-point/title "Multiplying a Fraction by a Whole Number Resulting in a Mixed Number"}] :question/id #uuid "494ad564-7a01-533e-887a-6c83a2fb4e78" :question/math-academy-id "e-13396" :question/problem "Find the value $9\\times\\dfrac 3 {4}$ as a mixed number." :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n9\\times \\dfrac{3}{4} = \\dfrac{9\\times 3}{4} = \\dfrac{27}{4}\n$$\n\nWe now convert this to a mixed number:\n\n$$\n27\\div 4 = 6\\,\\textrm{R} 3 = 6\\,\\dfrac{3}{4}\n$$"}] [{:db/id #edb/ref 17592186143196 :knowledge-point/_questions [{:db/id #edb/ref 17592186142775 :knowledge-point/id #uuid "91037b32-189a-5ba9-ab0a-117f6255c496" :knowledge-point/title "Multiplying a Fraction by a Whole Number Resulting in a Mixed Number"}] :question/answer-fields [{:answer-field/id #uuid "6b27e074-d1b0-5dbd-8e58-3ebf1fc1aff0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186140358}] :question/id #uuid "439a0f0d-a3d2-5c95-a6b8-2e0a7b9fef98" :question/math-academy-id "q-187309" :question/problem "Expressed as a mixed number in its lowest terms, $6 \\cdot \\frac{7}{8} =$ {{field-1}}."}] [{:db/id #edb/ref 17592186143268 :knowledge-point/_questions [{:db/id #edb/ref 17592186142774 :knowledge-point/id #uuid "d3bbd0c1-1e52-5f95-b5b1-7270f49e5f5d" :knowledge-point/title "Multiplying a Fraction by a Whole Number With Simplification"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99a9de03-b4ce-5b0c-b158-ac92330b190d" :answer/type {:db/id #edb/ref 1759218