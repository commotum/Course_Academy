[{:db/id 17592186142772 :knowledge-point/questions ["question-8a44c492-647e-5f02-873c-e9e875c25787" "question-61ee6ad3-1a7f-5619-932c-25b8833f8ab3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186142510 :question/problem "Find the value of $5\\times \\dfrac{1}{12}.$" :db/ensure [:question/validate]} {:db/id 17592186142773 :knowledge-point/questions ["question-0b69ce62-503e-5554-ab0a-6c59e7ed13e5" "question-3ff362bc-8460-5485-acc0-71917ecd60fc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186142511 :question/problem "Multiply $\\dfrac{2}{3}\\times 3.$" :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\dfrac{2\\times 3}{3} = \\dfrac{6}{3}\n$$\n\nFinally, we simplify this fraction by interpreting $\\dfrac 6 3$ as a division:\n\n$$\n6\\div 3 =2\n$$" :db/ensure [:question/validate]} {:db/id 17592186142774 :knowledge-point/questions ["question-b75df178-753c-5fb9-8bdf-eb4f27f52576"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186142512 :question/problem "Multiply $\\dfrac{1}{6}\\times 4.$" :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\dfrac{1\\times 4}{6} = \\dfrac{4}{6}\n$$\n\nTo simplify this fraction, we can divide the numerator and denominator by $2\\mathbin{:}$\n\n$$\n\\dfrac{4\\div 2}{6\\div 2} = \\dfrac{2}{3}\n$$" :db/ensure [:question/validate]} {:db/id 17592186142775 :knowledge-point/questions ["question-54a1fbf2-a228-5f80-beb4-16deb2530cb6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8a44c492-647e-5f02-873c-e9e875c25787" :question/id #uuid "8a44c492-647e-5f02-873c-e9e875c25787" :question/math-academy-id "q-186825" :question/problem "Given that $\\frac{4}{7}\\times 5=\\frac{\\,\\boxed{}}{7},$ the missing number is{{field-1}}." :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{4\\times 5}{7}=\\frac{20}{7}\n$$\n\nTherefore, the missing number is $20.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b5e07511-8e6c-5a8d-be8d-3ddc240d0673"] :db/ensure [:question/validate]} {:db/id "answer-field-b5e07511-8e6c-5a8d-be8d-3ddc240d0673" :answer-field/id #uuid "b5e07511-8e6c-5a8d-be8d-3ddc240d0673" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f4625c41-25d2-5fa0-b1b6-5eb99a28e621" :answer-field/choices ["answer-f4625c41-25d2-5fa0-b1b6-5eb99a28e621"] :db/ensure [:answer-field/validate]} {:db/id "answer-f4625c41-25d2-5fa0-b1b6-5eb99a28e621" :answer/id #uuid "f4625c41-25d2-5fa0-b1b6-5eb99a28e621" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "question-61ee6ad3-1a7f-5619-932c-25b8833f8ab3" :question/id #uuid "61ee6ad3-1a7f-5619-932c-25b8833f8ab3" :question/math-academy-id "q-186831" :question/problem "Expressed as an improper fraction in its lowest terms, $6\\times \\frac{3}{11}=${{field-1}}." :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{6\\times 3}{11}=\\frac{18}{11}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ddf45ba1-7380-5978-8c24-51b8af98fc2a"] :db/ensure [:question/validate]} {:db/id "answer-field-ddf45ba1-7380-5978-8c24-51b8af98fc2a" :answer-field/id #uuid "ddf45ba1-7380-5978-8c24-51b8af98fc2a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-09f3754e-b1c1-5f1e-ace2-3c70c5d86e12" :answer-field/choices ["answer-09f3754e-b1c1-5f1e-ace2-3c70c5d86e12"] :db/ensure [:answer-field/validate]} {:db/id "answer-09f3754e-b1c1-5f1e-ace2-3c70c5d86e12" :answer/id #uuid "09f3754e-b1c1-