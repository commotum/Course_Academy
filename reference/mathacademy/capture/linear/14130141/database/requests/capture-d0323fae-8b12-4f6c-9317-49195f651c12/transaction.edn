1d34-0ea6-5686-8bce-dd46195c7eef" :answer/id #uuid "52c61d34-0ea6-5686-8bce-dd46195c7eef" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-2b524dea-2f19-5de3-b09c-7f9fdf9a3e70" :answer/id #uuid "2b524dea-2f19-5de3-b09c-7f9fdf9a3e70" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186143268 :question/problem "$3\\times \\frac{1}{6}=$" :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{3\\times 1}{6}=\\frac{3}{6}\n$$\n\nWe then reduce this fraction to its lowest terms:\n\n$$\n\\frac{3}{6}=\\frac{3÷3}{6÷3}=\\frac{1}{2}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186140577 :answer-field/correct 17592186140579 :db/ensure [:answer-field/validate]} {:db/id "question-b75df178-753c-5fb9-8bdf-eb4f27f52576" :question/id #uuid "b75df178-753c-5fb9-8bdf-eb4f27f52576" :question/math-academy-id "q-56537" :question/problem "$\\frac{3}{8}\\times 2=$" :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{3\\times 2}{8}=\\frac{6}{8}\n$$\n\nWe then reduce this fraction to its lowest terms:\n\n$$\n\\frac{6}{8}=\\frac{6÷2}{8÷2}=\\frac{3}{4}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3bb5b01a-e799-565d-9228-3bf9a3c621e8"] :db/ensure [:question/validate]} {:db/id "answer-field-3bb5b01a-e799-565d-9228-3bf9a3c621e8" :answer-field/id #uuid "3bb5b01a-e799-565d-9228-3bf9a3c621e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2c8c9777-df54-5c1d-8caa-61fd20e7bb87" :answer-field/choices ["answer-753e057b-821b-5a34-8aad-4f946d259970" "answer-2c8c9777-df54-5c1d-8caa-61fd20e7bb87" "answer-1a1bd069-87c9-5de3-8c9a-8