#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186493977} :activity/id #uuid "9d9c15c2-a381-503f-8c20-095ae4a1ed50" :activity/scope {:db/id #edb/ref 17592186048548 :topic/id #uuid "a8f3106d-906d-52d1-b148-e532348d89d2" :topic/math-academy-id 79} :activity/steps [{:db/id #edb/ref 17592186493977 :step/content {:db/id #edb/ref 17592186493954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1056a69e-6f45-5662-8064-9d31764878d8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Quadratic trinomial" :db/id #edb/ref 17592186493420} {:answer/id #uuid "683a7cea-5988-5760-91b7-9df2a330db1a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Quartic trinomial" :db/id #edb/ref 17592186493546} {:answer/id #uuid "71053b83-643d-5ef2-8a38-901d38fcd2cf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Quartic binomial" :db/id #edb/ref 17592186493557} {:answer/id #uuid "8ee88caf-fa42-587f-9b4e-37e2a9c5dac2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Cubic binomial" :db/id #edb/ref 17592186493617} {:answer/id #uuid "b5c26456-8a47-5d01-856e-a94ad2152272" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Cubic trinomial" :db/id #edb/ref 17592186493686}] :answer-field/correct {:db/id #edb/ref 17592186493686} :answer-field/id #uuid "61ac3cf1-ce85-58c6-8c68-c0b075726ad0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493830}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "becc645b-7ce0-5458-abaa-ac04d1cbd85e" :question/math-academy-id "q-51576" :question/problem "Classify the polynomial $5{y}^{3}-2y+1$ according to its degree and the number of terms." :question/worked-solution "The polynomial $5{y}^{3}-2y+1$ has three terms, so it is a trinomial.\n\nAlso, its degree is $3,$ so it is a cubic.\n\nTherefore, the polynomial is a cubic trinomial."} :step/id #uuid "05338efe-276c-51da-8655-6d896721903f" :step/next {:db/id #edb/ref 17592186493994}} {:db/id #edb/ref 17592186493992 :step/content {:db/id #edb/ref 17592186493921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61b11b3a-81a6-51e7-8ad5-0ea10ae35041" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186493537} {:answer/id #uuid "7d3ca694-1f66-5b36-b822-4d155549fa8d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186493585} {:answer/id #uuid "a66f3f1f-29ec-5be2-8bc5-722c8e836b92" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186493654} {:answer/id #uuid "e4b1e4de-0805-5bfa-8e45-f45979420ad8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186493753} {:answer/id #uuid "f7a93d32-18e7-5f8e-961d-886b53773bcf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186493792}] :answer-field/correct {:db/id #edb/ref 17592186493537} :answer-field/id #uuid "9a727332-6125-5bf9-8eee-55ebc8cbefb8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493853}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4a6f2377-d91b-5967-99d3-f6f62abbce5f" :question/math-academy-id "q-152221" :question/problem "Which of the following statements are true? \n\nI. The sum of $4{x}^{2}+1$ and $2{x}^{2}$ is a binomial.\n\nII. The sum of $3{x}^{2}-2x$ and $5$ is a binomial.\n\nIII. The sum of a binomial and a monomial is **sometimes** a binomial." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true. We have\n\n$$\n(4{x}^{2}+1)+(2{x}^{2})=6{x}^{2}+1,\n$$\n\nwhich is a binomial.\n\n- Statement II is false. We have\n\n$$\n(3{x}^{2}-2x)+(5)=3{x}^{2}-2x+5,\n$$\n\nwhich is *not* a binomial (it's a trinomial).\n\n- Statement III is true. The sum of a binomial and a monomial *could be* a binomial (see, for example, statement I). \n\n However, the sum of a binomial and a monomial is *not always* a binomial (see, for example, statement II). \n\n So, the sum of a binomial and a monomial is *sometimes* binomial.\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "33040ec4-d764-5460-b879-febde2296a30"} {:db/id #edb/ref 17592186493994 :step/content {:db/id #edb/ref 17592186493944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6c22d6-e892-5446-9098-76a0b21515ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "linear binomial" :db/id #edb/ref 17592186493442} {:answer/id #uuid "32c65879-0672-5962-bea0-b0afdace1faf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "quadratic trinomial" :db/id #edb/ref 17592186493477} {:answer/id #uuid "3a6cf1b6-04ad-59dd-b257-00f1e1dce62c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "quintic binomial" :db/id #edb/ref 17592186493489} {:answer/id #uuid "44e3a524-e613-5db6-91fb-801225462723" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "cubic trinomial" :db/id #edb/ref 17592186493506} {:answer/id #uuid "8caae5ad-2091-5a94-9de8-16bbe05ea834" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "quartic binomial" :db/id #edb/ref 17592186493614}] :answer-field/correct {:db/id #edb/ref 17592186493489} :answer-field/id #uuid "5cfb5c23-969b-59ed-8fd1-dd67557eb34a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493827}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a6b20681-3c0e-56d8-a0d2-12a0033bb72d" :question/math-academy-id "q-111223" :question/problem "Categorize the polynomial ${z}^{5}-3z$ based on its degree and the number of terms it has." :question/worked-solution "The polynomial ${z}^{5}-3z$ has two terms, so it is a binomial.\n\nAlso, its degree is $5,$ so it is a quintic.\n\nTherefore, the polynomial is a quintic binomial."} :step/id #uuid "39e3b333-15cb-5985-99ff-5688251c0604" :step/next {:db/id #edb/ref 17592186493992}}] :activity/title "Monomials, Binomials and Trinomials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493384}]}
