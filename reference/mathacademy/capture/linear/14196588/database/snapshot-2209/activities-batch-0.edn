#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186111733} :activity/id #uuid "9857734b-5bab-54f4-a580-a7385aea30f3" :activity/scope {:db/id #edb/ref 17592186048174 :topic/id #uuid "85adbb4a-1472-583d-a6f0-528ebb0b39cc" :topic/math-academy-id 1437} :activity/steps [{:db/id #edb/ref 17592186111609 :step/content {:db/id #edb/ref 17592186110670 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110291 :question/id #uuid "60df6f7a-5257-5081-ba0c-0e9499a15f23" :question/math-academy-id "e-10588"} :knowledge-point/id #uuid "5ac4127f-1253-5aee-b524-84e5c6b2bc64" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186050452} {:db/id #edb/ref 17592186050494}] :knowledge-point/questions [{:db/id #edb/ref 17592186111241} {:db/id #edb/ref 17592186111279} {:db/id #edb/ref 17592186233215} {:db/id #edb/ref 17592186493947} {:db/id #edb/ref 17592186493950}] :knowledge-point/title "Calculating Angles From Right, Straight, and Full Angles Using Algebra"} :step/id #uuid "9d2f5fba-20ef-5cac-9659-5aee4c02e5a5" :step/math-academy-id 40025 :step/next {:db/id #edb/ref 17592186111742}} {:db/id #edb/ref 17592186111733 :step/content {:db/id #edb/ref 17592186111840 :tutorial/content "When solving problems with angles, it is helpful to remember the following classifications:\n\n- a **null** angle has a measure of $0^\\circ,$\n\n- an **acute** angle has a measure between $0^\\circ$ and $90^\\circ,$\n\n- a **right** angle has a measure of $90^\\circ,$\n\n- an **obtuse** angle has a measure between $90^\\circ$ and $180^\\circ,$\n\n- a **straight** angle has a measure of $180^\\circ,$\n\n- a **reflex** angle has a measure between $180^\\circ$ and $360^\\circ,$ and\n\n- a **full** angle has a measure of $360^\\circ.$\n\nIt is also helpful to remember that when two lines meet at a point, the opposite angles are called **vertical angles**. Vertical angles are congruent, and consequently they have the same measure." :tutorial/id #uuid "282e8601-d3f4-5c34-a96b-a071a96de244" :tutorial/math-academy-id 2182 :tutorial/title "Introduction"} :step/id #uuid "d8e313bb-3f6b-5512-9eaa-d26017f922aa" :step/math-academy-id 8758 :step/next {:db/id #edb/ref 17592186111743}} {:db/id #edb/ref 17592186111742 :step/content {:db/id #edb/ref 17592186110759 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110387 :question/id #uuid "826ef015-53ba-5889-8749-170a656c35f9" :question/math-academy-id "e-2590"} :knowledge-point/id #uuid "9d62f753-a3e0-5c7e-919d-3f878c1d8e93" :knowledge-point/questions [{:db/id #edb/ref 17592186111245} {:db/id #edb/ref 17592186111246} {:db/id #edb/ref 17592186493932}] :knowledge-point/title "Finding the Measure of Unknown Angles on a Diagram"} :step/id #uuid "d8bbc417-4a3f-577b-991f-4a7306fb343e" :step/math-academy-id 8768} {:db/id #edb/ref 17592186111743 :step/content {:db/id #edb/ref 17592186110760 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110390 :question/id #uuid "6438b232-f40a-54b0-a599-a1d6aa4151d2" :question/math-academy-id "e-2599"} :knowledge-point/id #uuid "f64be210-e966-5be7-b7b4-cbf859793e76" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048723} {:db/id #edb/ref 17592186050016} {:db/id #edb/ref 17592186050889}] :knowledge-point/questions [{:db/id #edb/ref 17592186111247} {:db/id #edb/ref 17592186111248} {:db/id #edb/ref 17592186493894} {:db/id #edb/ref 17592186493929}] :knowledge-point/title "Identifying Angle Types From a Diagram"} :step/id #uuid "8ad48197-e2e5-58b1-af58-7632d0bd7fe9" :step/math-academy-id 8772 :step/next {:db/id #edb/ref 17592186111744}} {:db/id #edb/ref 17592186111744 :step/content {:db/id #edb/ref 17592186110761 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110391 :question/id #uuid "15470df7-8d18-5427-9488-f3f10df13952" :question/math-academy-id "e-2601"} :knowledge-point/id #uuid "fea607a9-7512-5062-b4ae-c53e0f653efd" :knowledge-point/questions [{:db/id #edb/ref 17592186111249} {:db/id #edb/ref 17592186111250} {:db/id #edb/ref 17592186493951} {:db/id #edb/ref 17592186493953} {:db/id #edb/ref 17592186497333}] :knowledge-point/title "Identifying an Angle Type From a Description"} :step/id #uuid "1a60a9ec-5f67-5382-8520-b964b945c556" :step/math-academy-id 8773 :step/next {:db/id #edb/ref 17592186111609}}] :activity/title "Solving Problems With Angles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110823}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111539} :activity/id #uuid "91d80949-4bd6-531f-a855-c98a58ea2f32" :activity/scope {:db/id #edb/ref 17592186048764 :topic/id #uuid "bce11f5d-4b21-5819-b55b-282994760aee" :topic/math-academy-id 1511} :activity/steps [{:db/id #edb/ref 17592186111539 :step/content {:db/id #edb/ref 17592186111922 :tutorial/content "Two angles are **supplementary** if their measures add up to $180^\\circ.$\n\n![](images/88/886f1ce19ad595b470d5ad13943b780bd5a22ee737908d9554e97bd08c9ce985.png)\n\nThese angles are supplementary because the sum of their measures is $180^\\circ{:}$\n\n$$\n105^\\circ +75^\\circ = 180^\\circ\n$$\n\nA **linear pair** is a pair of adjacent angles formed when two lines intersect. The angles shown above form a linear pair.\n\nThe **linear pair postulate** states the following:\n\nIf two angles form a linear pair, then they are supplementary.\n\nThe converse is *not* true. That is, if two angles are supplementary, they do not necessarily form a linear pair.\n\nTo see why, consider the diagram shown below:\n\n![](images/29/29ff0dfefb0b535342f4e8060b37fb2404983fc150681bb02d18fa6e5b00f899.png)\n\nAlthough the angles are supplementary (the sum of their measures is $120^\\circ + 60^\\circ = 180^\\circ$), they do not form a linear pair of angles since they are not adjacent." :tutorial/id #uuid "ea9626ef-f56f-5668-8f47-81a9f68c9db4" :tutorial/math-academy-id 9518 :tutorial/title "Introduction"} :step/id #uuid "34d571bc-0e65-56b1-80d0-82208a4c2869" :step/math-academy-id 193869 :step/next {:db/id #edb/ref 17592186111540}} {:db/id #edb/ref 17592186111540 :step/content {:db/id #edb/ref 17592186110627 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110357 :question/id #uuid "4ebed10c-0a87-528a-ba18-67d960ba7692" :question/math-academy-id "e-15641"} :knowledge-point/id #uuid "931f7270-ec55-5c42-8c1b-6c7988f6c921" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048723} {:db/id #edb/ref 17592186050494}] :knowledge-point/questions [{:db/id #edb/ref 17592186110998} {:db/id #edb/ref 17592186111176} {:db/id #edb/ref 17592186499469} {:db/id #edb/ref 17592186499474} {:db/id #edb/ref 17592186499519} {:db/id #edb/ref 17592186503660} {:db/id #edb/ref 17592186503738}] :knowledge-point/title "Identifying Supplementary Angles"} :step/id #uuid "677af1bc-75a9-505c-baf3-c267afccb1b8" :step/math-academy-id 193870 :step/next {:db/id #edb/ref 17592186111541}} {:db/id #edb/ref 17592186111541 :step/content {:db/id #edb/ref 17592186110628 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110358 :question/id #uuid "ba553f7b-1750-5ffb-b6f8-81ad141368a8" :question/math-academy-id "e-15642"} :knowledge-point/id #uuid "2ba5d861-c6bf-57df-aa00-7034aeb5e1ac" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725}] :knowledge-point/questions [{:db/id #edb/ref 17592186110999} {:db/id #edb/ref 17592186111000} {:db/id #edb/ref 17592186503697} {:db/id #edb/ref 17592186503702} {:db/id #edb/ref 17592186503724} {:db/id #edb/ref 17592186503754}] :knowledge-point/title "Calculating Supplementary Angles"} :step/id #uuid "1635a868-152f-5d33-a98e-b081e4cab5fa" :step/math-academy-id 193873 :step/next {:db/id #edb/ref 17592186111542}} {:db/id #edb/ref 17592186111542 :step/content {:db/id #edb/ref 17592186110629 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110355 :question/id #uuid "62cec20b-28d4-5f08-9201-2d32bb741f1b" :question/math-academy-id "e-15141"} :knowledge-point/id #uuid "2c7eec3a-50e3-5550-9e1e-def64ca9642a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049939} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186110997} {:db/id #edb/ref 17592186111242} {:db/id #edb/ref 17592186503670} {:db/id #edb/ref 17592186503751}] :knowledge-point/title "Calculating Supplementary Angles From a Description"} :step/id #uuid "ae5c4a50-4790-50a4-8623-989e8ec2863b" :step/math-academy-id 193876 :step/next {:db/id #edb/ref 17592186111543}} {:db/id #edb/ref 17592186111543 :step/content {:db/id #edb/ref 17592186110630 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110356 :question/id #uuid "39e78adf-4714-5461-b3a4-c619019df41a" :question/math-academy-id "e-15142"} :knowledge-point/id #uuid "9e6e34d9-29a2-55ed-9d28-258cbfd91600" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186110931} {:db/id #edb/ref 17592186111331} {:db/id #edb/ref 17592186503652} {:db/id #edb/ref 17592186503713}] :knowledge-point/title "Finding an Unknown Quantity Using Supplementary Angles"} :step/id #uuid "fbb2518f-7e11-56ac-abf6-3669b2e06083" :step/math-academy-id 193879}] :activity/title "Supplementary Angles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110866}] [{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186106627} :activity/id #uuid "5207c8f6-7d65-5c9f-8bbb-af66fdcc9b1d" :activity/scope {:db/id #edb/ref 17592186049027 :topic/id #uuid "d4a5e636-5453-5120-957b-34a9e32197ae" :topic/math-academy-id 1403} :activity/steps [{:db/id #edb/ref 17592186106627 :step/content {:db/id #edb/ref 17592186107043 :tutorial/content "Remember that longer sides in a triangle are opposite to larger angles, and vice versa. But what if two (or more) sides have the same length?\n\nAs you might have guessed, if two sides have the same length, then the opposite angles have the same measure. And vice-versa: if two angles have the same measure, then the opposite sides have the same length.\n\nSo, we obtain the following important properties of isosceles and equilateral triangles:\n\n- A triangle is **equilateral** if and only if all of its angles are of $60^\\circ.$\n\n![](images/ad/ad56532db83ae54eeabf04d5a182a850bed14d9d0a65518b8048c3c0c112c371.png)\n\n- A triangle is **isosceles** if and only if it has two congruent angles.\n\n![](images/2b/2b5d6779527eae10e108ffcdc80745f63f3f38e41474673990bf74c83d2e6a64.png)\n\n**Note:** The statement above encompasses two theorems:\n\n- The **isosceles triangle theorem**:\n\n*If a triangle is isosceles, then the base angles are congruent.*\n\n- The **converse isosceles triangle theorem**: \n\n*If two angles in a triangle have the same measure, then the triangle must be isosceles.*" :tutorial/id #uuid "87d68609-ccd1-5ebd-b129-2c6993e05b75" :tutorial/math-academy-id 2227 :tutorial/title "Introduction"} :step/id #uuid "5440fe87-c485-5fa7-ab27-be4de4746fa1" :step/math-academy-id 164419 :step/next {:db/id #edb/ref 17592186106628}} {:db/id #edb/ref 17592186106628 :step/content {:db/id #edb/ref 17592186105738 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105525 :question/id #uuid "df6c46c7-a65c-578c-a9b3-e75de73c527a" :question/math-academy-id "e-2718"} :knowledge-point/id #uuid "02d46a44-0f02-5491-8e71-2eb22ad50ff9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049949}] :knowledge-point/questions [{:db/id #edb/ref 17592186106166} {:db/id #edb/ref 17592186106170} {:db/id #edb/ref 17592186505752} {:db/id #edb/ref 17592186505835}] :knowledge-point/title "Calculating the Measure of an Angle Using the Isosceles Triangle Theorem"} :step/id #uuid "6c37fcdd-4a4f-5fa4-b419-cdfb144ce00e" :step/math-academy-id 164420 :step/next {:db/id #edb/ref 17592186106629}} {:db/id #edb/ref 17592186106629 :step/content {:db/id #edb/ref 17592186105739 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105526 :question/id #uuid "c7ae19b8-aee0-5a64-b7c8-61f3ce75272c" :question/math-academy-id "e-2721"} :knowledge-point/id #uuid "0690d62b-432c-5d1e-96f2-b43393f6efa9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048764} {:db/id #edb/ref 17592186050410}] :knowledge-point/questions [{:db/id #edb/ref 17592186106167} {:db/id #edb/ref 17592186106171} {:db/id #edb/ref 17592186505731} {:db/id #edb/ref 17592186505815}] :knowledge-point/title "Calculating the Measure of an Angle in an Isosceles Triangle Given an Exterior Angle"} :step/id #uuid "52480c3c-c289-5e97-b7aa-1a5401a73156" :step/math-academy-id 164423 :step/next {:db/id #edb/ref 17592186106630}} {:db/id #edb/ref 17592186106630 :step/content {:db/id #edb/ref 17592186105740 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105584 :question/id #uuid "d9e953e1-5af0-55eb-a861-af6f4ed9b720" :question/math-academy-id "e-4269"} :knowledge-point/id #uuid "c9c2b7ee-d32b-550b-b110-81d04d750c98" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213}] :knowledge-point/questions [{:db/id #edb/ref 17592186106165} {:db/id #edb/ref 17592186106169} {:db/id #edb/ref 17592186505797} {:db/id #edb/ref 17592186505818}] :knowledge-point/title "Solving for a Variable Given Unknown Lengths in an Isosceles Triangle"} :step/id #uuid "b5d08f57-ce6b-5494-a967-38442f05a2c6" :step/math-academy-id 164426 :step/next {:db/id #edb/ref 17592186106631}} {:db/id #edb/ref 17592186106631 :step/content {:db/id #edb/ref 17592186105741 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105527 :question/id #uuid "e44e7e25-f65b-5f40-9aef-cbe55bfd1b53" :question/math-academy-id "e-2726"} :knowledge-point/id #uuid "0044ba61-80c8-57cf-80dc-8a17cf980a84" :knowledge-point/questions [{:db/id #edb/ref 17592186106168} {:db/id #edb/ref 17592186106391} {:db/id #edb/ref 17592186505742} {:db/id #edb/ref 17592186505837}] :knowledge-point/title "Finding the Measure of an Angle Given Multiple Triangles"} :step/id #uuid "ec111c1e-1c82-5a70-b2f1-5dfba6037c19" :step/math-academy-id 164429}] :activity/title "The Isosceles Triangle Theorem" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106021}] [{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186106588} :activity/id #uuid "2af93617-2850-5d80-8e89-a45566d1d99b" :activity/scope {:db/id #edb/ref 17592186049223 :topic/id #uuid "e4ba6b67-ce78-5f37-b120-6055b0e97c6c" :topic/math-academy-id 1319} :activity/steps [{:db/id #edb/ref 17592186106588 :step/content {:db/id #edb/ref 17592186107137 :tutorial/content "The sum of the interior angles of *any* triangle equals $180^\\circ.$\n\n![](images/fc/fcc21c5e13ab095da35eeca128e3a82a075d649e205aa0e1683b6ab0e4a4cc4c.png)\n\nAs it turns out, there is a general rule for the sum of the interior angles that applies to all polygons:\n\n*The sum of the interior angles of a polygon with $n$ sides equals $180^\\circ \\cdot (n-2).$*\n\nFor example, every triangle has ${\\color{blue}3}$ sides. Let's substitute $n={\\color{blue}3}$ into the formula to check that it works:\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (3-2) \\\\  & ={180}^{∘}\\cdot 1 \\\\  & ={180}^{∘}\\,✓\\end{aligned}\n$$\n\nSo, the formula tells us that the sum of the interior angles of a triangle equals $180^\\circ,$ which we know is correct.\n\nLet's see some more examples." :tutorial/id #uuid "8edf1574-04d8-5aea-839f-9c03c16e6ab5" :tutorial/math-academy-id 6654 :tutorial/title "Introduction"} :step/id #uuid "6daf0d6e-d3ca-5943-93ac-6a8d0ae04d45" :step/math-academy-id 136665 :step/next {:db/id #edb/ref 17592186106589}} {:db/id #edb/ref 17592186106589 :step/content {:db/id #edb/ref 17592186107138 :tutorial/content "The sum of the interior angles of a polygon with $n$ sides equals \n\n$$\n180^\\circ \\cdot (n-2).\n$$\n\nEvery quadrilateral has $n={\\color{blue}4}$ sides. Applying the formula, we get\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}.\\end{aligned}\n$$\n\nSo, the formula tells us that the sum of the interior angles of a quadrilateral equals $360^\\circ.$ \n\n![](images/a0/a0d6cd7aa4b4e7aba6451b32087fa6cf86e0f63d2ff70e68328a5ac9d4eddcfc.png)" :tutorial/id #uuid "1de6f70b-9797-56cc-b325-b5375efaf06b" :tutorial/math-academy-id 6688 :tutorial/title "The Sum of the Interior Angles of a Quadrilateral"} :step/id #uuid "55ff9455-d9c5-5dfd-b9aa-7d7ad79f0ad7" :step/math-academy-id 136666 :step/next {:db/id #edb/ref 17592186106590}} {:db/id #edb/ref 17592186106590 :step/content {:db/id #edb/ref 17592186105717 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105440 :question/id #uuid "757aacb7-c988-5f1f-9ae6-c69ebf1399ec" :question/math-academy-id "e-10772"} :knowledge-point/id #uuid "3d6d5827-91a8-5fd4-85ea-7564e8f5396e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049949} {:db/id #edb/ref 17592186049993} {:db/id #edb/ref 17592186050127}] :knowledge-point/questions [{:db/id #edb/ref 17592186106132} {:db/id #edb/ref 17592186106468} {:db/id #edb/ref 17592186500366}] :knowledge-point/title "Identifying Possible Interior Angles of a Quadrilateral"} :step/id #uuid "93903594-40c4-5f1f-b805-5569c124dd4b" :step/math-academy-id 136667 :step/next {:db/id #edb/ref 17592186106591}} {:db/id #edb/ref 17592186106591 :step/content {:db/id #edb/ref 17592186107139 :tutorial/content "The sum of the interior angles of a polygon with $n$ sides equals \n\n$$\n180^\\circ \\cdot (n-2).\n$$\n\nEvery pentagon has $n={\\color{blue}5}$ sides. Applying the formula, we get\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (5-2) \\\\  & ={180}^{∘}\\cdot 3 \\\\  & ={540}^{∘}.\\end{aligned}\n$$\n\nSo, the formula tells us that the sum of the interior angles of a pentagon equals $540^\\circ.$ \n\n![](images/8d/8d0478edf5e40b947b06b7b6b0b726999b11ce39dc8af5daaf414f2bd2292647.png)\n\nWe can use the same formula to deduce the sum of the interior angles of hexagons, heptagons, octagons, and so forth." :tutorial/id #uuid "573fd3ba-e480-5a75-ba71-1fd15e977637" :tutorial/math-academy-id 6738 :tutorial/title "The Sum of the Interior Angles of a Pentagon"} :step/id #uuid "9d73fd08-d0b3-549f-8356-26bd528a081c" :step/math-academy-id 136670 :step/next {:db/id #edb/ref 17592186106592}} {:db/id #edb/ref 17592186106592 :step/content {:db/id #edb/ref 17592186105718 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105438 :question/id #uuid "5f89d47f-4068-508e-9fdd-1f3768d53a92" :question/math-academy-id "e-10637"} :knowledge-point/id #uuid "bad93a16-17d4-50ff-89c8-f3d966df5f1a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186106315} {:db/id #edb/ref 17592186106317} {:db/id #edb/ref 17592186500330} {:db/id #edb/ref 17592186500342} {:db/id #edb/ref 17592186500365} {:db/id #edb/ref 17592186500375}] :knowledge-point/title "Finding Unknown Quantities in Quadrilaterals and Pentagons"} :step/id #uuid "66ba6652-6516-5c96-9fc2-f1a279bbcdce" :step/math-academy-id 136671 :step/next {:db/id #edb/ref 17592186106593}} {:db/id #edb/ref 17592186106593 :step/content {:db/id #edb/ref 17592186105719 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105439 :question/id #uuid "7d0dd769-07d8-58c6-a2c8-d6165ca5bb5a" :question/math-academy-id "e-10638"} :knowledge-point/id #uuid "0b111120-41dd-5a58-bcc5-b0b6fc78b384" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048354}] :knowledge-point/questions [{:db/id #edb/ref 17592186106206} {:db/id #edb/ref 17592186106207} {:db/id #edb/ref 17592186500302} {:db/id #edb/ref 17592186500305} {:db/id #edb/ref 17592186500348}] :knowledge-point/title "Finding the Number of Sides of a Polygon Given the Sum of Its Interior Angles"} :step/id #uuid "7f2b2f6c-0f00-518c-8edf-15031fffc70c" :step/math-academy-id 136674 :step/next {:db/id #edb/ref 17592186106594}} {:db/id #edb/ref 17592186106594 :step/content {:db/id #edb/ref 17592186107170 :tutorial/content "We've made use of the following theorem throughout this lesson. \n\n*The sum of the interior angles of a polygon with $n$ sides equals $180^\\circ \\cdot (n-2).$*\n\nThis formula works because any $n$-sided polygon can be split into $n-2$ triangles using diagonals that meet at one fixed vertex of the polygon. \n\nLet's illustrate this for a few different polygons.\n\n| ![](images/20/20aae267ba75bb418e509d548b1519af47b4cf9464d7f8400369c8e77b013aae.png) | **Quadrilateral** \n\nNumber of vertices: $4$ \n\nNumber of triangles: $4 - 2 = {\\color{blue}{2}}$ \n\nSum of interior angles: $180^\\circ \\cdot {\\color{blue}{2}} = 360^\\circ$ |\n| --- | --- |\n| ![](images/20/20551ad9f4661402aef9e501bf9d4c841e671b4277fae78f85d9e9ada9830592.png) | **Pentagon** \n\nNumber of vertices: $5$ \n\nNumber of triangles: $5 - 2 = {\\color{blue}{3}}$ \n\nSum of interior angles: $180^\\circ \\cdot {\\color{blue}{3}} = 540^\\circ$ |\n| ![](images/de/de8ec9be742a40384891de3a682a151e817f6c24d624e0ef505fb98ce6a1e60d.png) | **Hexagon** \n\nNumber of vertices: $6$ \n\nNumber of triangles: $6 - 2 = {\\color{blue}{4}}$ \n\nSum of interior angles: $180^\\circ \\cdot {\\color{blue}{4}} = 720^\\circ$ |\n\nThe sum of the interior angles of each polygon is the same as the sum of the interior angles of the corresponding triangles. \n\nEach triangle has interior angles that sum to $180^\\circ,$ and any $n$-sided polygon can be split into $n-2$ triangles in the manner shown above. Therefore, the sum of the interior angles in an $n$-sided polygon is\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2).\\end{aligned}\n$$" :tutorial/id #uuid "211863f5-73c2-57af-83e9-696d21971d5b" :tutorial/math-academy-id 9114 :tutorial/title "Justification of the Formula"} :step/id #uuid "19ab5e9d-cd9a-5abe-b2d8-a8c2a4b0511a" :step/math-academy-id 136677}] :activity/title "Interior Angles of Polygons" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105973}] [{:activity/first-step {:db/id #edb/ref 17592186193595} :activity/id #uuid "7dce8769-8b8a-5a22-ae68-4462efb5a5ce" :activity/scope {:db/id #edb/ref 17592186049376 :topic/id #uuid "eff92a43-1983-58ce-8999-65db419a98c7" :topic/math-academy-id 4019} :activity/steps [{:db/id #edb/ref 17592186193595 :step/content {:db/id #edb/ref 17592186193857 :tutorial/content "Suppose we have a pair of parallel lines cut by a transversal.\n\n**Alternate interior angles** are the pairs of angles on *alternate* (opposite) sides of the transversal and are *interior* to (inside of) the parallel lines. These pairs of angles always have equal measure.\n\n![](images/b0/b06ff1e3d55ee09f95a1234ab4aa340d825f05971957ae8a88ff408c256c82a4.png)\n\n**Alternate external angles** are the pairs of angles on *alternate* (opposite) sides of the transversal and are *exterior* to (outside of) the parallel lines. These pairs of angles always have equal measure.\n\n![](images/4d/4d4765d2f5e49794336d2bf35705da9fa7885ce0a619dcd3a117d28cfe66645e.png)" :tutorial/id #uuid "17eba692-165e-58c9-96a3-8aed2c660530" :tutorial/math-academy-id 6723 :tutorial/title "Introduction"} :step/id #uuid "5f6b707c-1a02-5a01-96da-00e64ed94944" :step/math-academy-id 40678 :step/next {:db/id #edb/ref 17592186193596}} {:db/id #edb/ref 17592186193596 :step/content {:db/id #edb/ref 17592186192742 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192460 :question/id #uuid "273e5c07-6f92-5019-8268-bc3af728c530" :question/math-academy-id "e-10737"} :knowledge-point/id #uuid "d4b0977a-6bcb-5d7f-bec8-b10bff6d7e23" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213} {:db/id #edb/ref 17592186049587}] :knowledge-point/questions [{:db/id #edb/ref 17592186193186} {:db/id #edb/ref 17592186193351}] :knowledge-point/title "Finding Alternate Interior Angles"} :step/id #uuid "8bd1113e-49e3-508c-a22f-dfa0fdd69bae" :step/math-academy-id 40680 :step/next {:db/id #edb/ref 17592186193673}} {:db/id #edb/ref 17592186193616 :step/content {:db/id #edb/ref 17592186192756 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192475 :question/id #uuid "9faa078f-3129-5683-8cc4-d9b783505224" :question/math-academy-id "e-10856"} :knowledge-point/id #uuid "7e1b5c9b-4be3-5d63-a757-fb0ec6091e3c" :knowledge-point/questions [{:db/id #edb/ref 17592186193185} {:db/id #edb/ref 17592186193385}] :knowledge-point/title "Further Solving Problems With Alternate Angles"} :step/id #uuid "7f037845-d12e-5297-90be-1612950af662" :step/math-academy-id 41154} {:db/id #edb/ref 17592186193673 :step/content {:db/id #edb/ref 17592186192791 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192515 :question/id #uuid "39e4f5cd-d815-5318-8e85-6941293da1ca" :question/math-academy-id "e-11056"} :knowledge-point/id #uuid "18bf826f-de64-5905-9e7b-b87a3b4e1227" :knowledge-point/questions [{:db/id #edb/ref 17592186192946} {:db/id #edb/ref 17592186193187}] :knowledge-point/title "Finding Alternate Exterior Angles"} :step/id #uuid "0ed50c81-73e4-55ef-8062-730a3a7ba23a" :step/math-academy-id 42013 :step/next {:db/id #edb/ref 17592186193674}} {:db/id #edb/ref 17592186193674 :step/content {:db/id #edb/ref 17592186192792 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192516 :question/id #uuid "29f0ad4e-9785-5469-9cff-399fa91da066" :question/math-academy-id "e-11057"} :knowledge-point/id #uuid "77d962d1-2421-592e-b825-e33ebe277b67" :knowledge-point/questions [{:db/id #edb/ref 17592186193184} {:db/id #edb/ref 17592186193386}] :knowledge-point/title "Solving Problems With Alternate Angles"} :step/id #uuid "75c54c3c-1feb-55cc-a726-bb26875bb42a" :step/math-academy-id 42014 :step/next {:db/id #edb/ref 17592186193616}}] :activity/title "Alternate Angles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192902}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186106548} :activity/id #uuid "53739364-ab76-5f6a-9987-a1e5894cdc33" :activity/scope {:db/id #edb/ref 17592186049856 :topic/id #uuid "18feb129-7dac-5ab9-b065-23e4f689ee98" :topic/math-academy-id 1404} :activity/steps [{:db/id #edb/ref 17592186106548 :step/content {:db/id #edb/ref 17592186107061 :tutorial/content "Let $O$ be a point on the plane. Let's consider all the points on the plane whose distance to $O$ is equal to $5\\,\\textrm{cm}.$\n\n![](images/ba/ba0fc787b4469b0322fa46fa072d58ae163e24dea284f3e5507306e9b30dfbf3.png)\n\nThe collection of all such points defines a geometrical shape which is called a **circle**. \n\n- The point $O$ is called the **center** of the circle.\n\n- The distance from $O$ to any point on the circle is called the **radius**.\n\nIn our diagram above, the radius is $r={\\color{black}5\\,\\textrm{cm}}.$" :tutorial/id #uuid "a53c8e3d-2c5a-558c-912f-f2e051ef7b41" :tutorial/math-academy-id 2417 :tutorial/title "Introduction"} :step/id #uuid "9812b925-7461-5557-92e8-1ff7d3367b95" :step/math-academy-id 10836 :step/next {:db/id #edb/ref 17592186106550}} {:db/id #edb/ref 17592186106549 :step/content {:db/id #edb/ref 17592186105693 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105557 :question/id #uuid "2b2211b8-cc3f-5dd6-9dc0-1dc1a7f69513" :question/math-academy-id "e-3166"} :knowledge-point/id #uuid "82c825b9-fc36-510c-982e-e4596ab2ce24" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050519}] :knowledge-point/questions [{:db/id #edb/ref 17592186106160} {:db/id #edb/ref 17592186106161} {:db/id #edb/ref 17592186497339} {:db/id #edb/ref 17592186497367}] :knowledge-point/title "Identifying True Statements About the Distance to a Circle's Center"} :step/id #uuid "16717d1c-e42a-524b-915d-835d1e83173b" :step/math-academy-id 10837 :step/next {:db/id #edb/ref 17592186106551}} {:db/id #edb/ref 17592186106550 :step/content {:db/id #edb/ref 17592186105694 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105558 :question/id #uuid "9e6ebec8-4c08-5bc9-8a8c-4c6cedb2bd8e" :question/math-academy-id "e-3167"} :knowledge-point/id #uuid "8fa963eb-82a7-56cb-a8b8-f9291adec2d0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050505}] :knowledge-point/questions [{:db/id #edb/ref 17592186106162} {:db/id #edb/ref 17592186106163} {:db/id #edb/ref 17592186497369} {:db/id #edb/ref 17592186497412}] :knowledge-point/title "Calculating the Length of a Line Segment With Endpoints on a Circle and Passing Through the Center"} :step/id #uuid "432ff13e-3f9e-5ca8-8549-971f7f9795b1" :step/math-academy-id 10838 :step/next {:db/id #edb/ref 17592186106549}} {:db/id #edb/ref 17592186106551 :step/content {:db/id #edb/ref 17592186107062 :tutorial/content "There are three important line segments associated with a circle:\n\n- A **radius** is any line segment that connects a point on the circle with the center (left-hand diagram).\n\n- A **chord** is any line segment whose endpoints lie on the circle (middle diagram).\n\n- A **diameter** is any chord that passes through the center of the circle (right-hand diagram). The diameter is the longest chord and its measure is twice the radius of the circle:\n\n$$\nd = 2r.\n$$\n\n![](images/7f/7f12a9db3210054e64397e26c87fd57ce4e55ff5dc9a2ed0d3b0ce3a8f9c2e65.png)" :tutorial/id #uuid "bcbdf407-5fe9-57d7-9359-167f8fbf21b0" :tutorial/math-academy-id 2418 :tutorial/title "Chords and Diameters"} :step/id #uuid "7fb8225e-7462-53e8-804b-4a3bdd2a3605" :step/math-academy-id 10839 :step/next {:db/id #edb/ref 17592186106552}} {:db/id #edb/ref 17592186106552 :step/content {:db/id #edb/ref 17592186105695 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105559 :question/id #uuid "cb990fba-991a-58c8-a404-54353183903c" :question/math-academy-id "e-3168"} :knowledge-point/id #uuid "2401d489-0970-54a8-a70d-9e8613458f54" :knowledge-point/questions [{:db/id #edb/ref 17592186106421} {:db/id #edb/ref 17592186106422} {:db/id #edb/ref 17592186497398}] :knowledge-point/title "Identifying True Statements About Line Segments Associated with a Circle"} :step/id #uuid "7ea7aa1c-cdcf-5530-838a-3d3d9f236858" :step/math-academy-id 10840}] :activity/title "Circles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106022}]}
