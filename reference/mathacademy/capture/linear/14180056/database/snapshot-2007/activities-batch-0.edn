#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186134779} :activity/id #uuid "3675dcdc-e716-5cf3-815c-6104dee10ef7" :activity/scope {:db/id #edb/ref 17592186048925 :topic/id #uuid "ccad99ab-e070-516f-9254-b5d931a9723d" :topic/math-academy-id 2213} :activity/steps [{:db/id #edb/ref 17592186134779 :step/content {:db/id #edb/ref 17592186135012 :tutorial/content "The expression below gives the cost, in dollars, of sending a letter to Spain: \n\n$$\n2w + 1\n$$\n\nHere, $w$ is the letter's weight in ounces.\n\n$$\n\\overbrace{\\:{\\color{blue}2}\\!\\!\\!{\\underset{\\underset{\\Large\\textrm{weight}}{\\large\\uparrow}}{w}}\\!\\!\\!+{\\color{red}1}\\:}^{\\large\\textrm{total cost}}\n$$\n\nThe coefficient of $w$ is the cost for each additional ounce of weight.\n\nTo illustrate:\n\n- If $w=1$ (we have a $1$-ounce letter), the cost is ${\\color{blue}2} \\cdot 1 + {\\color{red}1} = \\[math]3.$\n\n- If $w=2$ (we have a $2$-ounce letter), the cost is ${\\color{blue}2} \\cdot 2 + {\\color{red}1} = \\[/math]5.$\n\n- If $w=3$ (we have a $3$-ounce letter), the cost is ${\\color{blue}2} \\cdot 3 + {\\color{red}1} = \\[math]7.$\n\nNote the following:\n\n- The number $\\color{blue}2$ in this expression represents a *unit rate.* Each time we increase the letter's weight by $1$ ounce, the cost increases by $\\color{blue}\\[/math]2$.\n\n- There is also a **base fee** of $\\color{red}\\[math]1$, which does not depend on the weight of the letter. We can think of this as the cost of sending a zero-ounce letter." :tutorial/id #uuid "4884ffa5-ca42-52e9-9661-39a00bd97ba4" :tutorial/math-academy-id 1363 :tutorial/title "Introduction"} :step/id #uuid "3727010c-1515-54c6-9fef-96ea2dc82e6d" :step/math-academy-id 2798 :step/next {:db/id #edb/ref 17592186134780}} {:db/id #edb/ref 17592186134780 :step/content {:db/id #edb/ref 17592186133849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133673 :question/id #uuid "d580ba90-3479-5bc6-be3c-457485999ade" :question/math-academy-id "e-822"} :knowledge-point/id #uuid "ad5ad311-bf6f-58e9-a473-51ad651160fd" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049018} {:db/id #edb/ref 17592186050195}] :knowledge-point/questions [{:db/id #edb/ref 17592186134437} {:db/id #edb/ref 17592186134439} {:db/id #edb/ref 17592186495077} {:db/id #edb/ref 17592186495117}] :knowledge-point/title "Interpreting the Meaning of the Coefficient and Constant Term"} :step/id #uuid "da830df3-d6a9-51ba-bd81-b481445b0aa5" :step/math-academy-id 2799 :step/next {:db/id #edb/ref 17592186134781}} {:db/id #edb/ref 17592186134781 :step/content {:db/id #edb/ref 17592186133850 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133674 :question/id #uuid "2797cfc6-ae99-55a6-98a2-bb1f5be39b4e" :question/math-academy-id "e-824"} :knowledge-point/id #uuid "a926bb0a-acd8-529c-8705-f6c7b4bbc2c2" :knowledge-point/questions [{:db/id #edb/ref 17592186134440} {:db/id #edb/ref 17592186134486} {:db/id #edb/ref 17592186495120}] :knowledge-point/title "Constructing an Expression With a Constant Term"} :step/id #uuid "d4c12aa1-5cda-5b3b-9eb9-f006009f5e4f" :step/math-academy-id 2804 :step/next {:db/id #edb/ref 17592186134897}} {:db/id #edb/ref 17592186134782 :step/content {:db/id #edb/ref 17592186133851 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133675 :question/id #uuid "0c075047-3971-5f0b-a03b-c67be0032db4" :question/math-academy-id "e-825"} :knowledge-point/id #uuid "7a696afb-6edc-5445-a6e4-23b82f96c76b" :knowledge-point/questions [{:db/id #edb/ref 17592186134441} {:db/id #edb/ref 17592186134488} {:db/id #edb/ref 17592186495057} {:db/id #edb/ref 17592186495070} {:db/id #edb/ref 17592186495088} {:db/id #edb/ref 17592186495169}] :knowledge-point/title "Interpreting an Expression With Multiple Variables"} :step/id #uuid "70341f70-571d-537e-81a7-dfdece0049ef" :step/math-academy-id 2806} {:db/id #edb/ref 17592186134897 :step/content {:db/id #edb/ref 17592186135149 :tutorial/content "In many countries, a **sales tax** is charged whenever an individual or company makes a purchase. The tax is usually based on a certain percentage of the sale price.\n\nFor example, suppose a person purchases a bicycle for $\\[math] 200,$ and there is a sales tax of $5\\%.$ How much is this tax, and what is the total cost of the bicycle?\n\nTo determine the amount of the tax the person must pay, we multiply $200 \\times 5\\%$, as follows:\n\n$$\n\\begin{aligned}Tax & =\\text{\\[}/math]200\\times 5% \\\\  & =\\text{\\[}math]200\\times 0.05 \\\\  & =\\text{\\[}/math]10\\end{aligned}\n$$\n\nTherefore, the purchaser must pay a $\\[math]10$ sales tax. This means that the total amount the person needs to pay for the bicycle is\n\n$$\n\\[/math]200 + \\[math]10 = \\[/math]210.\n$$" :tutorial/id #uuid "683a47a7-4c0a-5da2-888c-d004b4167df5" :tutorial/math-academy-id 6218 :tutorial/title "Calculating Taxes"} :step/id #uuid "7365f275-4f44-5bdc-b64a-45158abcf6d5" :step/math-academy-id 37767 :step/next {:db/id #edb/ref 17592186134962}} {:db/id #edb/ref 17592186134962 :step/content {:db/id #edb/ref 17592186133947 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133538 :question/id #uuid "93b2ed4a-45ad-5fc4-bfe8-479f5a674595" :question/math-academy-id "e-1604"} :knowledge-point/id #uuid "758ce589-dcf8-5be8-8f15-ae72172050db" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049467}] :knowledge-point/questions [{:db/id #edb/ref 17592186134438} {:db/id #edb/ref 17592186134487} {:db/id #edb/ref 17592186495112} {:db/id #edb/ref 17592186495140} {:db/id #edb/ref 17592186495141} {:db/id #edb/ref 17592186495172}] :knowledge-point/title "Constructing an Expression With a Tax Term"} :step/id #uuid "4b073ed7-15e0-5244-aa23-477855194546" :step/math-academy-id 5156 :step/next {:db/id #edb/ref 17592186134782}}] :activity/title "Interpreting Linear Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134048}]}
