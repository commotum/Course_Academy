elds [{:answer-field/choices [{:answer/id #uuid "684e8c26-8180-54e1-999c-0ea096171179" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P+0.18P" :db/id #edb/ref 17592186494527} {:answer/id #uuid "6eb09405-1768-5ef7-9b79-594123849392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P+0.18" :db/id #edb/ref 17592186494552} {:answer/id #uuid "766e1c71-656a-5b0c-a509-2ff36ff63d6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P+1.8P" :db/id #edb/ref 17592186494569} {:answer/id #uuid "a097eeea-b8b8-54b8-b696-3e1fffcdc696" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P+18" :db/id #edb/ref 17592186494684} {:answer/id #uuid "d0abca10-0178-57e7-90b8-2cbf3e78aa53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P+18P" :db/id #edb/ref 17592186494813}] :answer-field/correct {:answer/id #uuid "684e8c26-8180-54e1-999c-0ea096171179" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P+0.18P" :db/id #edb/ref 17592186494527} :answer-field/id #uuid "07c344ea-d58d-51c4-9a5b-5e3e071f27e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494920}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fb9924ff-c4e2-52dd-bf49-e683873b21a5" :question/math-academy-id "q-110314" :question/problem "Mel is buying a skateboard. The price of a skateboard is $P$ dollars, and Mel also has to pay a $18%$ tax.\n\nWhat expression represents the total cost, in dollars, of a skateboard after tax is applied?" :question/worked-solution "The price before taxes of a skateboard is $P$ dollars.\n\nThe amount of tax Mel pays is  $18%$ of the price of a skateboard, or $0.18P.$\n\nTherefore, the expression that represents the total cost (in dollars) of the skateboard after tax is:\n\n \n\n$$\nP+0.18P\n$$"}] [{:db/id #edb/ref 17592186495070 :knowledge-point/_questions [{:db/id #edb/ref 17592186133851 :knowledge-point/id #uuid "7a696afb-6edc-5445-a6e4-23b82f96c76b" :knowledge-point/title "Interpreting an Expression With Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35a70b18-5978-500c-a989-bdd2a58ce009" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Each hot dog costs $$5$" :db/id #edb/ref 17592186494427} {:answer/id #uuid "7a736020-45d4-5b30-8e67-8fd11f5dd934" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Alan has purchased $4H+2F+2D$ hot dogs in total" :db/id #edb/ref 17592186494581} {:answer/id #uuid "7d758c08-bea6-544c-a1c3-527e884ef9c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Each combo costs $5(4H+2F+2D)$ dollars" :db/id #edb/ref 17592186494591} {:answer/id #uuid "82bfcd99-5fc7-5938-84a4-efbaa0587f7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Alan purchased $5$ combos in total" :db/id #edb/ref 17592186494603} {:answer/id #uuid "ab423b52-1289-5966-a9dd-1630efd13913" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Alan has purchased $5(4H+2F+2D)$ combos in total" :db/id #edb/ref 17592186494714}] :answer-field/correct {:answer/id #uuid "82bfcd99-5fc7-5938-84a4-efbaa0587f7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Alan purchased $5$ combos in total" :db/id #edb/ref 17592186494603} :answer-field/id #uuid "f9a522c8-2da3-5f8b-a8d6-4f543f912c76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186495039}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "261e2c7f-a2b0-5f74-8412-23a24f65f2b4" :question/math-academy-id "q-110315" :question/problem "In a cinema, a snack combo consists of four hot dogs, two medium fries, and two medium soft drinks. The cost of one hot dog is $H$ dollars, the cost of one portion of fries is $F$ dollars and the cost of one drink is $D$ dollars. Alan is purchasing some combos for his friends and the total bill comes to $5(4H+2F+2D)$ dollars. \n\nWhat does the factor $5$ mean in this context?" :question/worked-solution "A hot dog costs $H$ dollars, one medium fries costs $F$ dollars, and a medium soft drink costs $D$ dollars. Thus, the cost, in dollars, of a combo is\n\n$$\n4H+2F+2D.\n$$\n\nAlan's bill, in dollars, comes to\n\n$$\n5(4H+2F+2D).\n$$\n\nHence, the factor $5$ must be the total number of combos that he's purchased."}] [{:db/id #edb/ref 17592186495169 :knowledge-point/_questions [{:db/id #edb/ref 17592186133851 :knowledge-point/id #uuid "7a696afb-6edc-5445-a6e4-23b82f96c76b" :knowledge-point/title "Interpreting an Expression With Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01bd6103-2e3a-5532-8ccc-de057f9bbd7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Each bouquet costs $$12$" :db/id #edb/ref 17592186494323} {:answer/id #uuid "644db01d-40c6-53ba-8fcc-1f1f62dc79c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Thomas purchased $12$ bouquets in total" :db/id #edb/ref 17592186494521} {:answer/id #uuid "8fec6a6e-5778-585f-836e-300c1705088b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are $12$ tulips in total" :db/id #edb/ref 17592186494644} {:answer/id #uuid "9a5d3a56-e003-54c8-9d7d-248fb5af6f56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Each bouquet costs $12(8T+4V)$  dollars" :db/id #edb/ref 17592186494669} {:answer/id #uuid "a04cf854-380f-54c5-bd5d-e1774bc4156b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are $12$ violets in total" :db/id #edb/ref 17592186494682}] :answer-field/correct {:answer/id #uuid "644db01d-40c6-53ba-8fcc-1f1f62dc79c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Thomas purchased $12$ bouquets in total" :db/id #edb/ref 17592186494521} :answer-field/id #uuid "37240545-1fe3-5f0d-b1eb-5faf520bf81f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494939}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f7d200e6-96cf-5acb-92f7-781b4bd31a5f" :question/math-academy-id "q-110316" :question/problem "A bouquet of flowers consists of $8$ tulips and $4$ violets. The cost of one tulip is $T$ dollars and  the cost of one violet is $V$ dollars. Thomas is purchasing some bouquets for a wedding, and his total bill comes to $12(8T+4V)$ dollars.\n\nWhat does the factor $12$ mean in this context?" :question/worked-solution "Eight tulips cost $8T$ dollars, and four violets cost $4V$ dollars. Thus, the cost,  in dollars, of a bouquet is\n\n$$\n8T+4V.\n$$\n\nThomas' bill,  in dollars, comes to\n\n$$\n12(8T+4V).\n$$\n\nThis is $12$ times the cost of a single bouquet. Thus, the factor $12$ must be the total number of bouquets that Thomas purchased."}] [{:db/id #edb/ref 17592186495057 :knowledge-point/_questions [{:db/id #edb/ref 17592186133851 :knowledge-point/id #uuid "7a696afb-6edc-5445-a6e4-23b82f96c76b" :knowledge-point/title "Interpreting an Expression With Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09311d83-111f-5567-b483-3659faf7b6b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are $10$ violets in total" :db/id #edb/ref 17592186494342}