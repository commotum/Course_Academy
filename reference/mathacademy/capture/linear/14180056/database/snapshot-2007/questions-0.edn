17592186045499 :db/ident :answer.type/text} :answer/value "The plumber's fee for working zero hours is $$50.$" :db/id #edb/ref 17592186494399} :answer-field/id #uuid "9a3ba977-bb42-571f-927f-26ead2900a1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494992}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3c3cdc1a-ff2a-59c0-9009-f0a0d149abd3" :question/math-academy-id "q-110213" :question/problem "The fee a plumber charges for a callout is given by the expression $45h+50,$ where $h$ is the time, in hours, it takes him to complete the job. \n\nWhat does the constant term of the expression represent in this context?" :question/worked-solution "The expression tells us that the plumber charges $$45$ every hour, plus a 'base fee' of $$50.$ \n\nThe constant term is $50.$ This represents the fee (in dollars) the plumber charges for working zero hours."}] [{:db/id #edb/ref 17592186495140 :knowledge-point/_questions [{:db/id #edb/ref 17592186133947 :knowledge-point/id #uuid "758ce589-dcf8-5be8-8f15-ae72172050db" :knowledge-point/title "Constructing an Expression With a Tax Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "341d5fe8-20a0-562c-848f-94212a29d786" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P+12" :db/id #edb/ref 17592186494422} {:answer/id #uuid "5e41dd3d-3353-51e8-9aba-56c20a6d135a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P+1.2P" :db/id #edb/ref 17592186494513} {:answer/id #uuid "935f6d6b-83c3-56a4-be16-0c7248a977bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P+0.12P" :db/id #edb/ref 17592186494654} {:answer/id #uuid "c5a13f7b-bc19-5485-bb61-b3d2526f8a80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/valu