#{[{:db/id #edb/ref 17592186133538 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133947 :knowledge-point/id #uuid "758ce589-dcf8-5be8-8f15-ae72172050db" :knowledge-point/title "Constructing an Expression With a Tax Term"}] :question/id #uuid "93b2ed4a-45ad-5fc4-bfe8-479f5a674595" :question/math-academy-id "e-1604" :question/problem "At a grocery store, the price of a turkey is $N$ dollars. However, there is also a $7\\%$ sales tax.\n\nWhat expression represents the total cost of a turkey after tax is applied?" :question/worked-solution "The price before taxes of the turkey is $N$ dollars.\n\nThe amount of tax is $7\\%$ of the price of the turkey, or $0.07N$.\n\nTherefore, the expression that represents the total cost of the turkey after tax is:\n\n$$\nN+0.07N\n$$"}] [{:db/id #edb/ref 17592186133673 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133849 :knowledge-point/id #uuid "ad5ad311-bf6f-58e9-a473-51ad651160fd" :knowledge-point/title "Interpreting the Meaning of the Coefficient and Constant Term"}] :question/id #uuid "d580ba90-3479-5bc6-be3c-457485999ade" :question/math-academy-id "e-822" :question/problem "The taxi fare, in dollars, charged by a particular cab company is given by the expression\n$6m+8$,\nwhere $m$ is the number of miles traveled. What do the constant term and the coefficient of $m$ represent in this context?" :question/worked-solution "The expression tells us that the cab company charges $\\[math]6$ for each mile traveled, plus a \"base fee\" of $\\[/math]8$.\n\n- The constant term is $8$. We can think of this as the fee (in dollars) for traveling zero miles.\n- The coefficient of $m$ is $6$. This represents the fee (in dollars) charged for every mile traveled."}] [{:db/id #edb/ref 17592186133674 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133850 :knowledge-point/id #uuid "a926bb0a-acd8-529c-8705-f6c7b4bbc2c2" :knowledge-point/title "Constructing an Expression With a Constant Term"}] :question/id #uuid "2797cfc6-ae99-55a6-98a2-bb1f5be39b4e" :question/math-academy-id "e-824" :question/problem "A recording studio charges musicians an initial fee of $\\[math]70$ to record an album. The studio also charges an additional fee of $\\[/math]55$ per hour.\nWhat expression gives the cost of recording an album in terms of the number of hours $h$?" :question/worked-solution "If $h$ is the number of hours used to record an album, and the studio charges an fee of $\\[math]55$ per hour, then the cost for $h$ hours must be $55h$.\n\nHowever, there is also a fixed fee for recording an album. This fee is $\\[/math]70$. Consequently, the constant term of the expression should be $70$.\n\nTherefore, the expression that represents the total cost of recording an album is:\n$55 h+70$"}] [{:db/id #edb/ref 17592186133675 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186133851 :knowledge-point/id #uuid "7a696afb-6edc-5445-a6e4-23b82f96c76b" :knowledge-point/title "Interpreting an Expression With Multiple Variables"}] :question/id #uuid "0c075047-3971-5f0b-a03b-c67be0032db4" :question/math-academy-id "e-825" :question/problem "In a particular fast-food restaurant, a standard lunch consists of $2$ hot dogs for $H$ dollars each, $8$ potato wedges for $W$ dollars each, and $1$ drink $D$ dollars. Monica went to the fast-food restaurant to pick up lunch for her family, and the total bill was\n$5(2H + 8W + D)$\ndollars.\nWhat does the factor $5$ mean in this context?" :question/worked-solution "Two hot dogs cost $2H$ dollars, eight potato wedges cost $8W$ dollars, and a drink costs $D$ dollars. Thus, each standard lunch costs\n$2H + 8W + D$\ndollars. Monica's bill comes to\n$5(2H + 8W + D)$\ndollars, which is $5$ times the cost of a single standard lunch. Thus, the factor $5$ must be the total number of standard lunches that Monica purchased."}] [{:db/id #edb/ref 17592186134486 :knowledge-point/_questions [{:db/id #edb/ref 17592186133850 :knowledge-point/id #uuid "a926bb0a-acd8-529c-8705-f6c7b4bbc2c2" :knowledge-point/title "Constructing an Expression With a Constant Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5374d3c-620a-57e3-affc-2bdd74a491df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3n + 15" :db/id #edb/ref 17592186132955} {:answer/id #uuid "b9167d26-3b50-5780-831a-48b1b2e8ddcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3n" :db/id #edb/ref 17592186132956} {:answer/id #uuid "cbabdf44-adad-5846-be0b-8f69efb4f4e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15n + 3" :db/id #edb/ref 17592186132957} {:answer/id #uuid "d9b67856-3345-59c8-8e5f-269d2c5728a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15n + 3n" :db/id #edb/ref 17592186132958} {:answer/id #uuid "24f670c1-ee74-56bf-ad2c-ba4cc0b2b85c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186132959}] :answer-field/id #uuid "68de4bff-9a2b-5bd7-b567-4fa2f26a643d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132954}] :question/id #uuid "b732ae55-1e03-5b4b-a75c-931094700bbd" :question/math-academy-id "q-57508" :question/problem "A pizzeria charges $$15$ for a cheese pizza and $$3$ for each topping.\n\nWhat expression gives the total cost, in dollars, of a pizza with $n$ toppings?"}]}
