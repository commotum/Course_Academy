defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E4-MJMATHI-4E\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2B\" x=\"1110\" y=\"0\"></use>\n<g transform=\"translate(2111,0)\">\n <use xlink:href=\"#E4-MJMAIN-30\"></use>\n <use xlink:href=\"#E4-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-30\" x=\"779\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-37\" x=\"1279\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E4-MJMATHI-4E\" x=\"3891\" y=\"0\"></use>\n</g>\n</svg></span></p>\n\n            </div>           \n        </div>",
