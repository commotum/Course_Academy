9b9086ac1e48a913bc6f2.png)\n\nWhich of the following polynomials could be the function shown in the diagram above?"] ["question-6bd098ca-5d84-5b72-a30b-9d7d1d658d79" :question/worked-solution "Let's call $P(x)$ the polynomial shown in the diagram.\n\nThe end behavior of $P(x)$ is\n\n- $P(x)\\to \\infty $ as $x\\to -\\infty ,$ and\n\n- $P(x)\\to \\infty $ as $x\\to \\infty .$\n\nConsequently, \n\n- the degree of $P(x)$ is even, and\n\n- the leading coefficient of $P(x)$ is positive.\n\n- the $y$-intercept is $0,$ which means that $P(0)=0.$\n\nTherefore, of the given options, the only one that satisfies all three criteria is $y=3{x}^{4}-{x}^{3}+4{x}^{2}-4x.$"] ["question-6bd098ca-5d84-5b72-a30b-9d7d1d658d79" :question/difficulty :question.difficulty/easy] ["answer-field-14dacbe4-15ee-5993-8b14-d648db29810e" :answer-field/id #uuid "14dacbe4-15ee-5993-8b14-d648db29810e"] ["answer-14630fb7-9545-5c1e-8187-195636207c60" :answer/id #uuid "14630fb7-9545-5c1e-8187-195636207c60"] ["answer-14630fb7-9545-5c1e-8187-195636207c60" :answer/type :answer.type/math] ["answer-14630fb7-9545-5c1e-8187-195636207c60" :answer/value "y=-{x}^{2}+2x"] ["answer-ae6ea9d0-4acf-5f43-bd32-b0b64eb348e4" :answer/id #uuid "ae6ea9d0-4acf-5f43-bd32-b0b64eb348e4"] ["answer-ae6ea9d0-4acf-5f43-bd32-b0b64eb348e4" :answer/type :answer.type/math] ["answer-ae6ea9d0-4acf-5f43-bd32-b0b64eb348e4" :answer/value "y=-{x}^{3}+1"] ["answer-1dfeaa55-d693-571f-970a-52c394bd4b98" :answer/id #uuid "1dfeaa55-d693-571f-970a-52c394bd4b98"] ["answer-1dfeaa55-d693-571f-970a-52c394bd4b98" :answer/type :answer.type/math] ["answer-1dfeaa55-d693-571f-970a-52c394bd4b98" :answer/value "y=2{x}^{6}+5{x}^{5}-x+2"] ["answer-5eb962d6-ab29-5e03-b451-b28b26aec307" :answer/id #uuid "5eb962d6-ab29-5e03-b451-b28b26aec307"] ["answer-5eb962d6-ab29-5e03-b451-b28b26aec307" :answer/type :answer.type/math] ["answer-5eb962d6-ab29-5e03-b451-b28b26aec307" :answer/value "y=3{x}^{4}-{x}^{3}+4{x}^{2}-4x"] ["answer-044e357f-937c-5bd9-add1-561e96b796b3" :answer/id #uuid "044e357f-937c-5bd9-add1-561e96b796b3"] ["answer-044e357f-937c-5bd9-add1-561e96b796b3" :answer/type :answer.type/math] ["answer-044e357f-937c-5bd9-add1-561e96b796b3" :answer/value "y=7{x}^{3}-2{x}^{2}+x"] ["answer-field-14dacbe4-15ee-5993-8b14-d648db29810e" :answer-field/key "selection"] ["answer-field-14dacbe4-15ee-5993-8b14-d648db29810e" :answer-field/type :answer-field.type/radio] ["answer-field-14dacbe4-15ee-5993-8b14-d648db29810e" :answer-field/correct "answer-5eb962d6-ab29-5e03-b451-b28b26aec307"] ["answer-field-14dacbe4-15ee-5993-8b14-d648db29810e" :answer-field/choices "answer-14630fb7-9545-5c1e-8187-195636207c60"] ["answer-field-14dacbe4-15ee-5993-8b14-d648db29810e" :answer-field/choices "answer-ae6ea9d0-4acf-5f43-bd32-b0b64eb348e4"] ["answer-field-14dacbe4-15ee-5993-8b14-d648db29810e" :answer-field/choices "answer-1dfeaa55-d693-571f-970a-52c394bd4b98"] ["answer-field-14dacbe4-15ee-5993-8b14-d648db29810e" :answer-field/choices "answer-5eb962d6-ab29-5e03-b451-b28b26aec307"] ["answer-field-14dacbe4-15ee-5993-8b14-d648db29810e" :answer-field/choices "answer-044e357f-937c-5bd9-add1-561e96b796b3"] ["question-6bd098ca-5d84-5b72-a30b-9d7d1d658d79" :question/answer-fields "answer-field-14dacbe4-15ee-5993-8b14-d648db29810e"] [17592186129144 :knowledge-point/questions "question-6bd098ca-5d84-5b72-a30b-9d7d1d658d79"] ["question-2df530d9-8f9f-501a-acc0-81862423dcff" :question/id #uuid "2df530d9-8f9f-501a-acc0-81862423dcff"] ["question-2df530d9-8f9f-501a-acc0-81862423dcff" :question/math-academy-id "q-38622"] ["question-2df530d9-8f9f-501a-acc0-81862423dcff" :question/problem "![](images/3d/3d226fbaa993448544cb821d64843c6f2c11945f6ad869636e0c875ada530c72.png)\n\nWhich of the following polynomials could be the function shown in the diagram above?"] ["question-2df530d9-8f9f-501a-acc0-81862423dcff" :question/worked-solution "Let's call $P(x)$ the polynomial shown in the diagram.\n\nThe end behavior of $P(x)$ is\n\n- $P(x)\\to -\\infty $ as $x\\to -\\infty ,$ and\n\n- $P(x)\\to \\infty $ as $x\\to \\infty .$\n\nConsequently, \n\n- the degree of $P(x)$ is odd, and\n\n- the leading coefficient of $P(x)$ is positive.\n\n- the $y$-intercept is positive, which means that  $P(0)>0.$\n\nTherefore, of the given options, the only one that satisfies all three criteria is $y={x}^{3}-2{x}^{2}+x+2.$"] ["question-2df530d9-8f9f-501a-acc0-81862423dcff" :question/difficulty :question.difficulty/moderate] ["answer-field-5f5e17ee-7aa0-5622-8b03-bbdf3907c81e" :answer-field/id #uuid "5f5e17ee-7aa0-5622-8b03-bbdf3907c81e"] ["answer-3ae3d5c1-b5c4-556a-89b0-de6a348a674f" :answer/id #uuid "3ae3d5c1-b5c4-556a-89b0-de6a348a674f"] ["answer-3ae3d5c1-b5c4-556a-89b0-de6a348a674f" :answer/type :answer.type/math] ["answer-3ae3d5c1-b5c4-556a-89b0-de6a348a674f" :answer/value "y=-{x}^{4}-\\frac{3}{4}{x}^{3}+2{x}^{2}+1"] ["answer-39206252-e501-5ad8-b487-ecdc76709e86" :answer/id #uuid "39206252-e501-5ad8-b487-ecdc76709e86"] ["answer-39206252-e501-5ad8-b487-ecdc76709e86" :answer/type :answer.type/math] ["answer-39206252-e501-5ad8-b487-ecdc76709e86" :answer/value "y=-{x}^{5}+2x-1"] ["answer-f73ba5e4-3073-5405-b935-af657c931af1" :answer/id #uuid "f73ba5e4-3073-5405-b935-af657c931af1"] ["answer-f73ba5e4-3073-5405-b935-af657c931af1" :answer/type :answer.type/math] ["answer-f73ba5e4-3073-5405-b935-af657c931af1" :answer/value "y=2{x}^{7}+3{x}^{2}-5x-2"] ["answer-062db534-4619-5a1c-91bf-640c060c6dc5" :answer/id #uuid "062db534-4619-5a1c-91bf-640c060c6dc5"] ["answer-062db534-4619-5a1c-91bf-640c060c6dc5" :answer/type :answer.type/math] ["answer-062db534-4619-5a1c-91bf-640c060c6dc5" :answer/value "y={x}^{3}-2{x}^{2}+x+2"] ["answer-69bd051e-dd91-5863-af4f-143880eafeb5" :answer/id #uuid "69bd051e-dd91-5863-af4f-143880eafeb5"] ["answer-69bd051e-dd91-5863-af4f-143880eafeb5" :answer/type :answer.type/math] ["answer-69bd051e-dd91-5863-af4f-143880eafeb5" :answer/value "y={x}^{4}+{x}^{3}+{x}^{2}+x+2"] ["answer-field-5f5e17ee-7aa0-5622-8b03-bbdf3907c81e" :answer-field/key "selection"] ["answer-field-5f5e17ee-7aa0-5622-8b03-bbdf3907c81e" :answer-field/type :answer-field.type/radio] ["answer-field-5f5e17ee-7aa0-5622-8b03-bbdf3907c81e" :answer-field/correct "answer-062db534-4619-5a1c-91bf-640c060c6dc5"] ["answer-field-5f5e17ee-7aa0-5622-8b03-bbdf3907c81e" :answer-field/choices "answer-3ae3d5c1-b5c4-556a-89b0-de6a348a674f"] ["answer-field-5f5e17ee-7aa0-5622-8b03-bbdf3907c81e" :answer-field/choices "answer-39206252-e501-5ad8-b487-ecdc76709e86"] ["answer-field-5f5e17ee-7aa0-5622-8b03-bbdf3907c81e" :answer-field/choices "answer-f73ba5e4-3073-5405-b935-af657c931af1"] ["answer-field-5f5e17ee-7aa0-5622-8b03-bbdf3907c81e" :answer-field/choices "answer-062db534-4619-5a1c-91bf-640c060c6dc5"] ["answer-field-5f5e17ee-7aa0-5622-8b03-bbdf3907c81e" :answer-field/choices "answer-69bd051e-dd91-5863-af4f-143880eafeb5"] ["question-2df530d9-8f9f-501a-acc0-81862423dcff" :question/answer-fields "answer-field-5f5e17ee-7aa0-5622-8b03-bbdf3907c81e"] [17592186129144 :knowledge-point/questions "question-2df530d9-8f9f-501a-acc0-81862423dcff"] ["question-f2a8f457-b09c-537d-9f0d-5fb2f3f9943c" :question/id #uuid "f2a8f457-b09c-537d-9f0d-5fb2f3f9943c"] ["question-f2a8f457-b09c-537d-9f0d-5fb2f3f9943c" :question/math-academy-id "q-112109"] ["question-f2a8f457-b09c-537d-9f0d-5fb2f3f9943c" :question/problem "![](images/1a/1a91d10c69c8d466b6155f775ebd0856003889089cc41a3246ec0a812b58def3.png)\n\nThe graph of the polynomial $y=P(x)$ is shown above. Which of the following statements are true?\n\nI. The degree of $P(x)$ is odd.\n\nII. $P(x)\\to \\infty $ as $x\\to \\infty .$\n\nIII. The coefficient of the leading term is negative."] ["question-f2a8f457-b09c-537d-9f0d-5fb2f3f9943c" :question/worked-solution "The end behavior of $P(x)$ is\n\n- $P(x)\\to -\\infty $ as $x\\to -\\infty ,$ and\n\n- $P(x)\\to -\\infty $ as $x\\to \\infty .$\n\nConsequently, \n\n- the degree of $P(x)$ is even, and\n\n- the leading coefficient of $P(x)$ is negative.\n\nTherefore, statement III is true, while statements I and II are false."] ["question-f2a8f457-b09c-537d-9f0d-5fb2f3f9943c" :question/difficulty :question.difficulty/easy] ["answer-field-d22468f4-1e10-5fb7-b45d-996333ac8044" :answer-field/id #uuid "d22468f4-1e10-5fb7-b45d-996333ac8044"] ["answer-25519646-119b-5f15-ae50-e28ac0492d20" :answer/id #uuid "25519646-119b-5f15-ae50-e28ac0492d20"] ["answer-25519646-119b-5f15-ae50-e28ac0492d20" :answer/type :answer.type/text] ["answer-25519646-119b-5f15-ae50-e28ac0492d20" :answer/value "I and II only"] ["answer-2c8e1779-364d-5227-a7e7-64ed9a015982" :answer/id #uuid "2c8e1779-364d-5227-a7e7-64ed9a015982"] ["answer-2c8e1779-364d-5227-a7e7-64ed9a015982" :answer/type :answer.type/text] ["answer-2c8e1779-364d-5227-a7e7-64ed9a015982" :answer/value "I and III only"] ["answer-0b8241fd-ab10-5abd-9457-a6831042e1f8" :answer/id #uuid "0b8241fd-ab10-5abd-9457-a6831042e1f8"] ["answer-0b8241fd-ab10-5abd-9457-a6831042e1f8" :answer/type :answer.type/text] ["answer-0b8241fd-ab10-5abd-9457-a6831042e1f8" :answer/value "II only"] ["answer-cddaac9c-c465-53a5-b196-6c4d3033f0db" :answer/id #uuid "cddaac9c-c465-53a5-b196-6c4d3033f0db"] ["answer-cddaac9c-c465-53a5-b196-6c4d3033f0db" :answer/type :answer.type/text] ["answer-cddaac9c-c465-53a5-b196-6c4d3033f0db" :answer/value "III only"] ["answer-65d07a26-dc02-5e5c-bb7d-8516ec1203fe" :answer/id #uuid "65d07a26-dc02-5e5c-bb7d-8516ec1203fe"] ["answer-65d07a26-dc02-5e5c-bb7d-8516ec1203fe" :answer/type :answer.type/text] ["answer-65d07a26-dc02-5e5c-bb7d-8516ec1203fe" :answer/value "None"] ["answer-field-d22468f4-1e10-5fb7-b45d-996333ac8044" :answer-field/key "selection"] ["answer-field-d22468f4-1e10-5fb7-b45d-996333ac8044" :answer-field/type :answer-field.type/radio] ["answer-field-d22468f4-1e10-5fb7-b45d-996333ac8044" :answer-field/correct "answer-cddaac9c-c465-53a5-b196-6c4d3033f0db"] ["answer-field-d22468f4-1e10-5fb7-b45d-996333ac8044" :answer-field/choices "answer-25519646-119b-5f15-ae50-e28ac0492d20"] ["answer-field-d22468f4-1e10-5fb7-b45d-996333ac8044" :answer-field/choices "answer-2c8e1779-364d-5227-a7e7-64ed9a015982"] ["answer-field-d22468f4-1e10-5fb7-b45d-996333ac8044" :answer-field/choices "answer-0b8241fd-ab10-5abd-9457-a6831042e1f8"] ["answer-field-d22468f4-1e10-5fb7-b45d-996333ac8044" :answer-field/choices "answer-cddaac9c-c465-53a5-b196-6c4d3033f0db"] ["answer-field-d22468f4-1e10-5fb7-b45d-996333ac8044" :answer-field/choices "answer-65d07a26-dc02-5e5c-bb7d-8516ec1203fe"] ["question-f2a8f457-b09c-537d-9f0d-5fb2f3f9943c" :question/answer-fields "answer-field-d22468f4-1e10-5fb7-b45d-996333ac8044"] [17592186129148 :knowledge-point/questions "question-f2a8f457-b09c-537d-9f0d-5fb2f3f9943c"] [17592186130395 :tutorial/content "In general, if we have a polynomial\n\n$$\nf(x) = a_nx^n+a_{n-1}x^{n-1}+...+a_{1}x + a_0\n$$\n\nwith leading coefficient $a_n\\neq 0,$ the end behavior of the polynomial is always\n\n$$\nf(x) \\rightarrow +\\infty \\quad \\text{or} \\quad f(x) \\rightarrow -\\infty\n$$\n\nas $x \\rightarrow \\pm \\infty.$ The sign of infinity depends on whether the leading exponent is even or odd, and on the sign of the leading coefficient. \n\n- If the leading coefficient is *positive*, then $f(x) \\to +\\infty$ as $x \\to +\\infty.$ Otherwise, if the leading coefficient is *negative*, then $f(x) \\to -\\infty$ as $x \\to +\\infty.$\n\n- If the leading exponent is *even*, then the end behavior as $x \\to +\\infty$ is the *same* as the end behavior as $x \\to -\\infty.$ Otherwise, if the leading exponent is *odd*, then the end behavior as $x \\to +\\infty$ is *opposite* the end behavior as $x \\to -\\infty.$\n\nThe different cases are summarized in the table below.\n\n<table align=\"center\" border=\"1\" cellpadding=\"10\" cellspacing=\"0\" width=\"60%\">\n<tbody><tr>\n<th align=\"center\" width=\"30%\"> $n$</th>\n<th align=\"center\" width=\"40%\"> $a_n$</th>\n<th align=\"center\" width=\"10%\"> $x  \\rightarrow -\\infty$ </th>\n<th align=\"center\" width=\"10%\"> $x  \\rightarrow +\\infty$</th>\n<th align=\"center\" width=\"10%\"> Sketch</th>\n</tr>\n<tr>\n<td rowspan=\"2\">Even </td>\n<td>  $>0$ </td>\n<td>  $f(x)  \\rightarrow +\\infty$ </td>\n<td>  $f(x)  \\rightarrow +\\infty$ </td>\n<td>\n<img alt=\"\" src=\"images/f4/f45aadee45a2a07e4cd050b4c9942118c250e73c011b7d00fff09d70a76c3319.png\"/>\n</td>\n</tr>\n<tr>\n<td>  $<0$ </td>\n<td>  $f(x)  \\rightarrow -\\infty$ </td>\n<td>  $f(x)  \\rightarrow -\\infty$ </td>\n<td>\n<img alt=\"\" src=\"images/b6/b61d6aa8182bda07e62ff6b8cc433f10a41aaaad0bde2bf4c3e8783415327b22.png\"/>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\"> Odd </td>\n<td>  $>0$ </td>\n<td>  $f(x)  \\rightarrow -\\infty$ </td>\n<td>  $f(x)  \\rightarrow +\\infty$ </td>\n<td>\n<img alt=\"\" src=\"images/06/064b94a21052ed2e20c20a69fe7649d8e0015c20c5840ad76440dbf2b7867bf5.png\"/>\n</td>\n</tr>\n<tr>\n<td>  $<0$ </td>\n<td>  $f(x)  \\rightarrow +\\infty$ </td>\n<td>  $f(x)  \\rightarrow -\\infty$ </td>\n<td>\n<img alt=\"\" src=\"images/c4/c4863580d9d7aa01a94cabb918d70203e57993bb7872a7abb186ac06760945ec.png\"/>\n</td>\n</tr>\n</tbody></table>"] [17592186129383 :activity/expected-seconds 420.0]] "retractions" [[17592186128961 :question/problem "![](images/84/84c37b1692f6807873d924fad0d3591298c2b46b780797ed258dcf32d2ff0d8a.png)\n\nWhich of the following polynomials is shown in the diagram above?\n\n- $-2 x^4 + 6 x^3 - 2 x^2 - 6 x + 4$\n\n- $-2 x^5 + 6 x^4 + 5 x^3 - 2 x^2 - 3 x + 1$\n\n- $3 x^4 + 5 x^3 - 2 x^2 - 3 x - 4$\n\n- $- x^4 + 5 x^3 - 2 x^2 - 3 x - 1$"] [17592186128962 :question/problem "The graph of a polynomial $Q(x)$ is shown below.\n\n![](images/c6/c6729ee13a704ce630586cd4cbdde5c67e55c03f65f1840b2ca1f2b6c38186f2.png)\n\nWhich of the following statements are true?\n\n- The coefficient of the leading term is positive.\n\n- The degree of $Q(x)$ is odd.\n\n- The constant term is negative."] [17592186129678 :question/problem "![](images/43/43e2c01d6e2ee22fe666bbaa46586b43467f8dd580d76e4da6644ac845761d31.png)\n\nWhich of the above could be the graph of $y = x^{3} - 2x^{2} - 1$?"] [17592186130395 :tutorial/content "In general, if we have a polynomial\n\n$$\nf(x) = a_nx^n+a_{n-1}x^{n-1}+...+a_{1}x + a_0\n$$\n\nwith leading coefficient $a_n\\neq 0,$ the end behavior of the polynomial is always\n\n$$\nf(x) \\rightarrow +\\infty \\quad \\text{or} \\quad f(x) \\rightarrow -\\infty\n$$\n\nas $x \\rightarrow \\pm \\infty.$ The sign of infinity depends on whether the leading exponent is even or odd, and on the sign of the leading coefficient. \n\n- If the leading coefficient is *positive*, then $f(x) \\to +\\infty$ as $x \\to +\\infty.$ Otherwise, if the leading coefficient is *negative*, then $f(x) \\to -\\infty$ as $x \\to +\\infty.$\n\n- If the leading exponent is *even*, then the end behavior as $x \\to +\\infty$ is the *same* as the end behavior as $x \\to -\\infty.$ Otherwise, if the leading exponent is *odd*, then the end behavior as $x \\to +\\infty$ is *opposite* the end behavior as $x \\to -\\infty.$\n\nThe different cases are summarized in the table below.\n\n| $n$ | $a_n$ | $x  \\rightarrow -\\infty$ | $x  \\rightarrow +\\infty$ | Sketch |\n| --- | --- | --- | --- | --- |\n| Even | $>0$ | $f(x)  \\rightarrow +\\infty$ | $f(x)  \\rightarrow +\\infty$ | ![](images/f4/f45aadee45a2a07e4cd050b4c9942118c250e73c011b7d00fff09d70a76c3319.png) |\n| $<0$ | $f(x)  \\rightarrow -\\infty$ | $f(x)  \\rightarrow -\\infty$ | ![](images/b6/b61d6aa8182bda07e62ff6b8cc433f10a41aaaad0bde2bf4c3e8783415327b22.png) |  |\n| Odd | $>0$ | $f(x)  \\rightarrow -\\infty$ | $f(x)  \\rightarrow +\\infty$ | ![](images/06/064b94a21052ed2e20c20a69fe7649d8e0015c20c5840ad76440dbf2b7867bf5.png) |\n| $<0$ | $f(x)  \\rightarrow +\\infty$ | $f(x)  \\rightarrow -\\infty$ | ![](images/c4/c4863580d9d7aa01a94cabb918d70203e57993bb7872a7abb186ac06760945ec.png) |  |"]]}]