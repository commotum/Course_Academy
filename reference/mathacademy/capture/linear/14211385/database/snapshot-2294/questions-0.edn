#{[{:db/id #edb/ref 17592186087491 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087683 :knowledge-point/id #uuid "8d82c39c-5ec6-5cf3-96f8-e778091a451a" :knowledge-point/title "Evaluating Expressions Containing Natural Logarithms Using a Calculator"}] :question/id #uuid "effc520d-4717-5e46-9358-c2ea34c7aa24" :question/math-academy-id "e-3990" :question/problem "Rounded to $2$ decimal places, what is the value of $\\dfrac{4}{\\ln(2)}?$" :question/worked-solution "We compute the required expression to $2$ decimal places using a calculator, rounding the intermediate steps to $5$ decimal places to avoid rounding error. This gives\n\n$$\n\\begin{aligned}\\frac{4}{\\operatorname{ln}⁡(2)} & ≈\\frac{4}{0.693\\,15} \\\\  & ≈5.770\\,76 \\\\  & ≈5.77.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087492 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087684 :knowledge-point/id #uuid "30497207-86c5-507f-906a-d23bd0af71e9" :knowledge-point/title "Converting Between Exponential and Logarithmic Form With Natural Logarithms"}] :question/id #uuid "97f9f0d6-d948-5f9b-b0ae-57e6a456a53b" :question/math-academy-id "e-4056" :question/problem "Convert the expression $\\ln{3} \\approx 1.1$ to its equivalent exponential form." :question/worked-solution "The natural logarithm of $a$ is defined as follows:\n\n$\\ln{a} = x$ is equivalent to $a = e^x$\n\nIf we compare $\\ln{3} \\approx 1.1$ with $\\ln{a} = x,$ we get $a = 3$ and $x = 1.1.$\n\nTherefore, the approximation $\\ln{3} \\approx 1.1$ is equivalent to \n\n$$\ne^{1.1} \\approx 3 .\n$$"}] [{:db/id #edb/ref 17592186087493 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087685 :knowledge-point/id #uuid "a323ad55-d029-58f4-b0a3-cc10b7dab125" :knowledge-point/title "Evaluating Natural Logarithms"}] :question/id #uuid "fd02e00f-9e2c-54f1-a5d3-fb0da9c9a413" :question/math-academy-id "e-4057" :question/problem "Evaluate $\\ln\\left( e^{6}\\right).$" :question/worked-solution "The natural logarithm of a power of $e$ is the power itself:\n\n$$\n\\ln(e^x) = x\n$$\n\nIn our case, we have $x = 6.$ Therefore,\n\n$$\n\\ln\\left( e^{6}\\right) = 6.\n$$"}] [{:db/id #edb/ref 17592186087497 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186087692 :knowledge-point/id #uuid "169ca81a-c698-553c-9f47-d6c4303b82a9" :knowledge-point/title "Evaluating Natural Logarithms of Fractions and Roots"}] :question/id #uuid "37ca3b87-9f5f-583c-95ff-83ca35608559" :question/math-academy-id "e-4155" :question/problem "Evaluate $\\ln\\left(\\dfrac{1}{e^{3}}\\right).$" :question/worked-solution "First, we rewrite $\\dfrac{1}{e^3}$ as a power of $e$ (the base of the natural logarithm) as follows:\n\n$$\n\\dfrac{1}{e^3} = e^{-3}\n$$\n\nTherefore, we have\n\n$$\n\\ln\\left( \\dfrac{1}{e^3} \\right) = \\ln \\left( e^{-3} \\right).\n$$\n\nThe natural logarithm of a power of $e$ is the power itself:\n\n$$\n\\ln(e^x) = x\n$$\n\nIn our case, we have $x = -3.$ Therefore,\n\n$$\n\\ln\\left( e^{-3}\\right) = - 3.\n$$"}] [{:db/id #edb/ref 17592186088088 :knowledge-point/_questions [{:db/id #edb/ref 17592186087683 :knowledge-point/id #uuid "8d82c39c-5ec6-5cf3-96f8-e778091a451a" :knowledge-point/title "Evaluating Expressions Containing Natural Logarithms Using a Calculator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9de93595-3e7b-5b56-a3a0-fa1b9c20ad4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.792" :db/id #edb/ref 17592186085196} {:answer/id #uuid "3549bd05-2f37-5e33-94f8-6d58ba6447ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.608" :db/id #edb/ref 17592186085197} {:answer/id #uuid "3dc8d463-7185-51d0-8829-e07324901f9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.609" :db/id #edb/ref 17592186085198} {:answer/id #uuid "44ac2971-af63-59dc-aa4b-b699e3a4f55e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.725" :db/id #edb/ref 17592186085199} {:answer/id #uuid "76ce0b8e-ec27-5c96-9d67-41a7868bc70d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.786" :db/id #edb/ref 17592186085200}] :answer-field/correct {:answer/id #uuid "9de93595-3e7b-5b56-a3a0-fa1b9c20ad4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.792" :db/id #edb/ref 17592186085196} :answer-field/id #uuid "974f394f-0f4f-538e-bd25-be36004f39c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186085195}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b32884a1-1fe4-5f93-a61e-12ff0b7a3580" :question/math-academy-id "q-23114" :question/problem "Rounded to $3$ decimal places,  $\\operatorname{ln}⁡(2)+\\operatorname{ln}⁡(3)=$" :question/requires-calculator true :question/worked-solution "We compute the required expression to $3$ decimal places using a calculator, rounding the intermediate steps to $6$ decimal places to avoid rounding error. This gives:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2)+\\operatorname{ln}⁡(3) & ≈0.693\\,147+1.098\\,612 \\\\  & ≈1.791\\,759 \\\\  & ≈1.792\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522708 :knowledge-point/_questions [{:db/id #edb/ref 17592186087685 :knowledge-point/id #uuid "a323ad55-d029-58f4-b0a3-cc10b7dab125" :knowledge-point/title "Evaluating Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eff558a-3c38-5664-bb91-fb5a4851baf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186522087} {:answer/id #uuid "57695a31-2cfb-521d-95f1-18be8ce8e8f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+2e" :db/id #edb/ref 17592186522204} {:answer/id #uuid "b1246c4c-16cc-51e2-a2c5-dbd123655551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186522383} {:answer/id #uuid "cc4d5038-b9db-5ce3-8d03-5b1a25e7e438" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+e" :db/id #edb/ref 17592186522442} {:answer/id #uuid "f5611f4e-0ff3-5233-94f4-1de6fcd819fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186522540}] :answer-field/correct {:answer/id #uuid "b1246c4c-16cc-51e2-a2c5-dbd123655551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186522383} :answer-field/id #uuid "4c36275b-baef-5618-a583-b3b010acb944" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522599}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "28b3be5c-4b6d-5163-b2d6-7be50f206805" :question/math-academy-id "q-47240" :question/problem "Evaluate $\\operatorname{ln}⁡({e}^{2})+2\\operatorname{ln}⁡(e).$" :question/worked-solution "The natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn the first and second term, we have $x=2$ and $x=1,$ respectively. Therefore:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{2})=2 \\\\ \\operatorname{ln}⁡(e)=1\\end{aligned}\n$$\n\nHence:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{2})+2\\operatorname{ln}⁡(e)=2+2\\cdot 1=4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522766 :knowledge-point/_questions [{:db/id #edb/ref 17592186087684 :knowledge-point/id #uuid "30497207-86c5-507f-906a-d23bd0af71e9" :knowledge-point/title "Converting Between Exponential and Logarithmic Form With Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26c039d9-87aa-526c-a55c-208378039a5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1.396)≈-\\frac{1}{3}" :db/id #edb/ref 17592186522105} {:answer/id #uuid "346a8fc2-d3b0-571b-a007-db66c0150840" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1.396)≈{e}^{3}" :db/id #edb/ref 17592186522138} {:answer/id #uuid "91e7cc32-5524-5aa5-b94e-b02b1193a809" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(3)≈1.396" :db/id #edb/ref 17592186522320} {:answer/id #uuid "b8e73407-0a7d-5e1d-8940-4d6ee32ff32f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1.396)≈\\frac{1}{3}" :db/id #edb/ref 17592186522400} {:answer/id #uuid "df934311-2eb7-572b-8a5a-b3a81c09582c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1.396)≈3" :db/id #edb/ref 17592186522490}] :answer-field/correct {:answer/id #uuid "b8e73407-0a7d-5e1d-8940-4d6ee32ff32f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1.396)≈\\frac{1}{3}" :db/id #edb/ref 17592186522400} :answer-field/id #uuid "708eb122-281a-5b43-a058-af1d0d941515" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522613}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4f69e59-b897-52a3-98ba-7aff5af1aea8" :question/math-academy-id "q-66795" :question/problem "$\\sqrt[3]{e\\,}≈1.396$ can be expressed as" :question/worked-solution "Notice that the given approximation can be written using exponents as:\n\n$$\n{e}^{1/3}≈1.396\n$$\n\nThe natural logarithm of $a$ is defined as follows:\n\n$a={e}^{x}$ is equivalent to $\\operatorname{ln}⁡a=x$ \n\nIf we compare ${e}^{1/3}≈1.396$ with $a={e}^{x},$ we get $a=1.396$ and $x=\\frac{1}{3}.$ \n\nTherefore, the approximation $\\sqrt[3]{e}≈1.396$ can be expressed as $\\operatorname{ln}⁡(1.396)≈\\frac{1}{3}.$"}] [{:db/id #edb/ref 17592186088260 :knowledge-point/_questions [{:db/id #edb/ref 17592186087684 :knowledge-point/id #uuid "30497207-86c5-507f-906a-d23bd0af71e9" :knowledge-point/title "Converting Between Exponential and Logarithmic Form With Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4fd5701-f4cc-555a-bef1-0629f5c2d9ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2.303}≈10" :db/id #edb/ref 17592186522367} {:answer/id #uuid "b9a6409e-4dc7-5e73-a13e-93de08e37b5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2.303}≈\\frac{1}{10}" :db/id #edb/ref 17592186522401} {:answer/id #uuid "c1a6e87d-b8a7-5425-b11c-3766e9cf23f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{10}^{2.303}≈e" :db/id #edb/ref 17592186522422} {:answer/id #uuid "ce5e2f46-1a69-5daa-9116-2e91ab14e61e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{10}^{e}≈2.303" :db/id #edb/ref 17592186522446} {:answer/id #uuid "e0fe25ed-98f8-5308-ad53-c2d8d1096a80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2.303}≈10" :db/id #edb/ref 17592186522496}] :answer-field/correct {:answer/id #uuid "e0fe25ed-98f8-5308-ad53-c2d8d1096a80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2.303}≈10" :db/id #edb/ref 17592186522496} :answer-field/id #uuid "e7af1850-4481-5ae1-b808-903637f29a31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086214}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "78ada24c-d363-5556-8035-633c7847adf2" :question/math-academy-id "q-66798" :question/problem "$\\operatorname{ln}⁡10≈2.303$ is equivalent to" :question/worked-solution "The natural logarithm of $a$ is defined as follows:\n\n$\\operatorname{ln}⁡a=x$ is equivalent to $a={e}^{x}$\n\nIf we compare $\\operatorname{ln}⁡10≈2.303$ with $\\operatorname{ln}⁡a=x,$ we get $a=10$ and $x=2.303.$\n\nTherefore, the approximation $\\operatorname{ln}⁡10≈2.303$ is equivalent to ${e}^{2.303}≈10.$"}] [{:db/id #edb/ref 17592186522721 :knowledge-point/_questions [{:db/id #edb/ref 17592186087692 :knowledge-point/id #uuid "169ca81a-c698-553c-9f47-d6c4303b82a9" :knowledge-point/title "Evaluating Natural Logarithms of Fractions and Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040a210b-491b-5e87-810f-cce446965078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186522024} {:answer/id #uuid "7c38600e-9095-5d68-9679-992de9782bd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186522263} {:answer/id #uuid "b7f950d3-5f98-5aa6-9a5c-854d5d739f5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186522397} {:answer/id #uuid "d2352f86-cbc5-5a20-9312-01f56f5d1500" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186522456} {:answer/id #uuid "dcf9c1bf-6252-5332-8106-48f580492575" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186522479}] :answer-field/correct {:answer/id #uuid "d2352f86-cbc5-5a20-9312-01f56f5d1500" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186522456} :answer-field/id #uuid "9a3c0e7e-447d-50a1-976e-443b533f1367" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522638}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ea37247-24cf-5fab-829f-0e5fcfa54afc" :question/math-academy-id "q-66855" :question/problem "$2\\operatorname{ln}⁡(\\frac{1}{{e}^{4}})=$" :question/worked-solution "First, we rewrite $\\frac{1}{{e}^{4}}$ as a power of $e$ (the base of the natural logarithm) as follows:\n\n$$\n\\frac{1}{{e}^{4}}={e}^{-4}\n$$\n\nTherefore, we have:\n\n$$\n2\\operatorname{ln}⁡(\\frac{1}{{e}^{4}})=2\\operatorname{ln}⁡({e}^{-4})\n$$\n\nThe natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn our case, we have $x=-4.$ Therefore:\n\n$$\n2\\operatorname{ln}⁡({e}^{-4})=2\\cdot (-4)=-8\n$$"}] [{:db/id #edb/ref 17592186522711 :knowledge-point/_questions [{:db/id #edb/ref 17592186087692 :knowledge-point/id #uuid "169ca81a-c698-553c-9f47-d6c4303b82a9" :knowledge-point/title "Evaluating Natural Logarithms of Fractions and Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9412c668-edd2-55fd-9399-7d6e1a2f8a6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186522322} {:answer/id #uuid "9d7cf7d9-c32d-5d59-8e1b-aecff778bbd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186522342} {:answer/id #uuid "9f84b452-29ef-5fed-8688-2d2cbe3460cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186522349} {:answer/id #uuid "de1dacf5-452c-5f6c-91e7-9cda5f87f798" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186522485} {:answer/id #uuid "ec68ce0a-0a97-5e15-9517-25ed30b46d75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186522523}] :answer-field/correct {:answer/id #uuid "ec68ce0a-0a97-5e15-9517-25ed30b46d75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186522523} :answer-field/id #uuid "2f157eba-77b5-548d-a8fd-18ca5d8b5a99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522576}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2f25e707-eeb9-5b06-994f-863f6b76503d" :question/math-academy-id "q-66856" :question/problem "$\\operatorname{ln}⁡(\\sqrt[3]{e})=$" :question/worked-solution "First, we rewrite $\\sqrt[3]{e}$ as a power of $e$ (the base of the natural logarithm) as follows:\n\n$$\n\\sqrt[3]{e}={e}^{1/3}\n$$\n\nTherefore, we have:\n\n$$\n\\operatorname{ln}⁡(\\sqrt[3]{e})=\\operatorname{ln}⁡({e}^{1/3})\n$$\n\nThe natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn our case, we have $x=\\frac{1}{3}.$ Therefore:\n\n$$\n\\operatorname{ln}⁡({e}^{1/3})=\\frac{1}{3}\n$$"}] [{:db/id #edb/ref 17592186522707 :knowledge-point/_questions [{:db/id #edb/ref 17592186087685 :knowledge-point/id #uuid "a323ad55-d029-58f4-b0a3-cc10b7dab125" :knowledge-point/title "Evaluating Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0376afbe-5220-5eab-bc31-f47e4643aa27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186522020} {:answer/id #uuid "1d57c4f5-731f-52c0-bd31-88b2c6de7f43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186522085} {:answer/id #uuid "5d4311e3-27f0-565f-a4f5-e008c3b19791" :answer/type {:db/id #edb/ref 175