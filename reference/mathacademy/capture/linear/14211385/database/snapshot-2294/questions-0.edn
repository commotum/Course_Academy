8 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186522129} {:answer/id #uuid "c0a12033-1a6e-5a88-af17-bb4f55993e4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186522417} {:answer/id #uuid "dd9fba62-ac84-588c-b69a-9b024d5ca676" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186522482} {:answer/id #uuid "e1a07ac1-07d6-51e7-8687-9b55e361c2b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186522497}] :answer-field/correct {:answer/id #uuid "c0a12033-1a6e-5a88-af17-bb4f55993e4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186522417} :answer-field/id #uuid "23aae750-eafd-52bf-8e1a-92d37cd03934" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522569}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc51ccb0-0438-5418-a3d9-157e172ac1ec" :question/math-academy-id "q-99685" :question/problem "$-\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1}{{e}^{5}})=$" :question/worked-solution "First, we rewrite $\\frac{1}{{e}^{5}}$ as a power of $e$ (the base of the natural logarithm) as follows:\n\n$$\n\\frac{1}{{e}^{5}}={e}^{-5}\n$$\n\nTherefore, we have:\n\n$$\n-\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1}{{e}^{5}})=-\\frac{1}{2}\\operatorname{ln}⁡({e}^{-5})\n$$\n\nThe natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn our case, we have $x=-5.$ Therefore:\n\n$$\n-\\frac{1}{2}\\operatorname{ln}⁡({e}^{-5})=-\\frac{1}{2}\\cdot (-5)=\\frac{5}{2}\n$$"}] [{:db/id #edb/ref 17592186522704 :knowledge-point/_questions [{:db/id #edb/ref 175