edb/ref 1078 #edb/ref 17592186522148 #edb/ref 17592186045417] [17592186522677 #edb/ref 1079 #uuid "f03464b5-9819-5ae9-b792-064fb40a818e" #edb/ref 17592186045417] [17592186522693 #edb/ref 1068 #edb/ref 17592186522575 #edb/ref 17592186045417] [17592186522693 #edb/ref 1069 "q-99695" #edb/ref 17592186045417] [17592186522693 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186522693 #edb/ref 1071 "Using suitable approximations, calculate $\\sqrt{\\operatorname{ln}⁡(4)}\\cdot \\operatorname{ln}⁡(2)$ to $3$ decimal places." #edb/ref 17592186045417] [17592186522693 #edb/ref 1072 #uuid "00510ebe-a387-562e-98da-516fa9a673e0" #edb/ref 17592186045417] [17592186522693 #edb/ref 1074 "We compute the required expression to $3$ decimal places using a calculator, rounding the intermediate steps to $6$ decimal places to avoid rounding error. This gives:\n\n$$\n\\begin{aligned}\\sqrt{\\operatorname{ln}⁡(4)}\\cdot \\operatorname{ln}⁡(2) & ≈\\sqrt{1.386\\,294}\\cdot 0.693\\,147 \\\\  & ≈1.177\\,410\\cdot 0.693\\,147 \\\\  & ≈0.816\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186522704 #edb/ref 1068 #edb/ref 17592186522677 #edb/ref 17592186045417] [17592186522704 #edb/ref 1069 "q-99692" #edb/ref 17592186045417] [17592186522704 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186522704 #edb/ref 1071 "Rounded to $3$ decimal places,  $\\operatorname{ln}⁡(\\sqrt{10})=$" #edb/ref 17592186045417] [17592186522704 #edb/ref 1072 #uuid "14cade25-332f-551b-a745-e0cec33e151b" #edb/ref 17592186045417] [17592186522704 #edb/ref 1074 "We compute the required expression to $3$ decimal places using a calculator, rounding the intermediate step to $6$ decimal places to avoid rounding error. This gives:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(\\sqrt{10}) & ≈\\operatorname{ln}⁡(3.162\\,278) \\\\  & ≈1.151\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186522707 #edb/ref 1068 #edb/ref 17592186522637 #edb/ref 17592186045417] [17592186522707 #edb/ref 1069 "q-99683" #edb/ref 17592186045417] [17592186522707 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186522707 #edb/ref 1071 "$\\frac{\\operatorname{ln}⁡({e}^{3})}{9}=$" #edb/ref 17592186045417] [17592186522707 #edb/ref 1072 #uuid "22c1a58e-7bf8-52c0-be52-879e9dd8226f" #edb/ref 17592186045417] [17592186522707 #edb/ref 1074 "The natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn our case,  we have $x=3.$ Therefore:\n\n$$\n\\frac{\\operatorname{ln}⁡({e}^{3})}{9}=\\frac{3}{9}=\\frac{1}{3}\n$$" #edb/ref 17592186045417] [17592186522708 #edb/ref 1068 #edb/ref 17592186522599 #edb/ref 17592186045417] [17592186522708 #edb/ref 1069 "q-47240" #edb/ref 17592186045417] [17592186522708 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186522708 #edb/ref 1071 "Evaluate $\\operatorname{ln}⁡({e}^{2})+2\\operatorname{ln}⁡(e).$" #edb/ref 17592186045417] [17592186522708 #edb/ref 1072 #uuid "28b3be5c-4b6d-5163-b2d6-7be50f206805" #edb/ref 17592186045417] [17592186522708 #edb/ref 1074 "The natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn the first and second term, we have $x=2$ and $x=1,$ respectively. Therefore:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{2})=2 \\\\ \\operatorname{ln}⁡(e)=1\\end{aligned}\n$$\n\nHence:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{2})+2\\operatorname{ln}⁡(e)=2+2\\cdot 1=4\\end{aligned}\n$$" #edb/ref 17592186045417]}
