    "q-99695": {
      "dom_id": "step-q99695",
      "name": "Question 10",
      "problem": "Using suitable approximations, calculate $\\sqrt{\\operatorname{ln}⁡(4)}\\cdot \\operatorname{ln}⁡(2)$ to $3$ decimal places.",
      "worked_solution": "We compute the required expression to $3$ decimal places using a calculator, rounding the intermediate steps to $6$ decimal places to avoid rounding error. This gives:\n\n$$\n\\begin{aligned}\\sqrt{\\operatorname{ln}⁡(4)}\\cdot \\operatorname{ln}⁡(2) & ≈\\sqrt{1.386\\,294}\\cdot 0.693\\,147 \\\\  & ≈1.177\\,410\\cdot 0.693\\,147 \\\\  & ≈0.816\\end{aligned}\n$$",
      "calculator_instructions": "",
