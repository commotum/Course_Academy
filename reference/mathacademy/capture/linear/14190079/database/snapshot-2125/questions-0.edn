#{[{:db/id #edb/ref 17592186128873 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129106 :knowledge-point/id #uuid "82f5682f-73b8-5c0a-b7d3-3336200843a0" :knowledge-point/title "Finding the Roots of a Function Given Its Graph"}] :question/id #uuid "c1e36290-8271-5508-9bf8-cf15a3907f75" :question/math-academy-id "e-14174" :question/problem "What are the roots of the function shown below?\n\n![](images/ee/eef552d392c76e2a980a443faba33ffb8edda502aa31fb078374a6445365d242.png)" :question/worked-solution "The roots of the function are the $x$-intercepts. Therefore, the roots are $x=-6,-3,0,3,6.$\n\n![](images/53/534bffb28abfa0609ae498f987be560f82037134e21d16e79c133ed82f1b1cd3.png)"}] [{:db/id #edb/ref 17592186128874 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129107 :knowledge-point/id #uuid "02e29602-b3c0-5ceb-ab65-710c06a08c1d" :knowledge-point/title "Finding the Roots of a Function Given a Table"}] :question/id #uuid "a443151c-f310-533e-adb7-1c8eda168738" :question/math-academy-id "e-14176" :question/problem "If $f(x)$ is given by the table shown below, what are its roots?\n\n| $x$ | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $5$ | $0$ | $-2$ | $-4$ | $0$ | $1$ | $3$ |" :question/worked-solution "The roots of the function are the values of $x$ such that $f(x)=0.$ In the given table, we see that $f(-2)=0$ and $f(1)=0.$\n\nTherefore, the roots of the function are $x=-2$ and $x=1.$"}] [{:db/id #edb/ref 17592186128875 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129108 :knowledge-point/id #uuid "578132af-f322-5a68-9771-72e1954622ad" :knowledge-point/title "Finding the Roots of a Function Given a Mapping Diagram"}] :question/id #uuid "c92eb920-7734-57fd-9f34-c1917d435eaf" :question/math-academy-id "e-14177" :question/problem "What are the roots of the function $g(x)$ defined by the mapping diagram shown below?\n\n![](images/95/951e37aa910fa9cf3588ee047dd6258f8e628198ce3ce4620119d4b30bee8c8d.png)" :question/worked-solution "The roots of the function are the values of $x$ such that $g(x)=0.$ In the given mapping diagram, we see that $g(9) = 0.$\n\nTherefore, the only root of the function is $x=9.$"}] [{:db/id #edb/ref 17592186128876 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129109 :knowledge-point/id #uuid "82d522a8-ae3c-5723-909e-540ddac1d9da" :knowledge-point/title "Finding the Roots Given a Function Definition"}] :question/id #uuid "d5e99647-7ada-562f-8a16-a61f4d1ae0be" :question/math-academy-id "e-14179" :question/problem "What is the root of the function $f(x)=2-4x?$" :question/worked-solution "The roots are the solutions to the equation $f(x)=0,$ which we solve as follows:\n\n$$\n\\begin{aligned}f(x) & =0 \\\\ 2-4x & =0 \\\\ 4x & =2 \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the function has the single root $x=\\dfrac12.$"}] [{:db/id #edb/ref 17592186503708 :knowledge-point/_questions [{:db/id #edb/ref 17592186129108 :knowledge-point/id #uuid "578132af-f322-5a68-9771-72e1954622ad" :knowledge-point/title "Finding the Roots of a Function Given a Mapping Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4680a870-34ad-5604-97ab-11765b3e31ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186503115}] :answer-field/correct {:answer/id #uuid "4680a870-34ad-5604-97ab-11765b3e31ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186503115} :answer-field/id #uuid "93704170-2260-598c-9254-0adc092a7bd9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503588} {:answer-field/choices [{:answer/id #uuid "40289e00-3cb4-5953-9963-6b2fa168a616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592