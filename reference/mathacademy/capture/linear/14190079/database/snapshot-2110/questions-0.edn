{3}" :db/id #edb/ref 17592186128382}] :answer-field/id #uuid "a5bd135d-99f8-5aa8-aa93-31549967cbd7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128377}] :question/id #uuid "3460491c-f6b3-5370-8269-8fffeb14eb6f" :question/math-academy-id "q-51497" :question/problem "What is the root of the function $g(x) = \\frac{x}{2} + 4$?"}]}
