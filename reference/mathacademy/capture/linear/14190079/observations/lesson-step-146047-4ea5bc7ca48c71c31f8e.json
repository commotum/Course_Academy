  "html": "<div id=\"step-146047\" class=\"step\" style=\"display: block\" stepid=\"146047\" steptype=\"example\" contentid=\"14174\">\n            <div class=\"stepHeader\">\n                <div class=\"stepName\">\n                    Example: \n                    <a id=\"stepAnchor-146047\" class=\"stepAnchor\" style=\"font-weight: normal;\" name=\"step-2\">Finding the Roots of a Function Given Its Graph</a> \n                </div>      \n                <div class=\"helpButton\" stepid=\"146047\">?</div>\n            </div>\n            \n            <div class=\"exampleQuestion\">\n                <p>What are the roots of the function shown below?</p>\n<div id=\"graphic-9dadf7ce1906a9e6f4173bcfe2107cbe\" class=\"graphic\"><img src=\"/graphics/9dadf7ce1906a9e6f4173bcfe2107cbe\"></div>\n            </div>     \n\n            <div class=\"explanationHeader\">EXPLANATION</div>\n\n            <div class=\"exampleExplanation\">\n                <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n            