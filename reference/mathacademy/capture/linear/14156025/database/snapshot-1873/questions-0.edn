#{[{:db/id #edb/ref 17592186179445 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179798 :knowledge-point/id #uuid "95cfce29-7f40-5b15-b299-363f8647e111" :knowledge-point/title "Dividing With Negative Decimals"}] :question/id #uuid "4fc788a3-fcac-5de0-a92b-8e818ce41160" :question/math-academy-id "e-12799" :question/problem "Calculate $2.4 \\div (-1.2).$" :question/worked-solution "Dividing a positive number by a negative number gives a negative number. Hence, the result will be negative.\n\nTherefore, since \n\n$$\n2.4\\div 1.2 = 2,\n$$\n\nwe obtain\n\n$$\n2.4 \\div (-1.2) = -2.\n$$"}] [{:db/id #edb/ref 17592186179446 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179799 :knowledge-point/id #uuid "57266531-c68d-57d9-b136-9d100dcc983e" :knowledge-point/title "Dividing With Negative Whole Numbers and Fractions"}] :question/id #uuid "723f1bda-4e94-502f-aaea-d9a6c1259fd3" :question/math-academy-id "e-12800" :question/problem "Find the value of $\\dfrac{4}{7} \\div (-2).$" :question/worked-solution "Dividing a positive number by a negative number gives a negative number. Hence, the result will be negative.\n\nTherefore, since \n\n$$\n\\dfrac{4}{7} \\div 2 = \\dfrac{4}{7 \\times 2} = \\dfrac{4}{14} = \\dfrac{2}{7},\n$$\n\nwe obtain\n\n$$\n\\dfrac{4}{7} \\div (-2) = -\\dfrac {2}{7}.\n$$"}] [{:db/id #edb/ref 17592186179447 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179800 :knowledge-point/id #uuid "15f1aff4-68c4-5acf-9de0-ad34e321ef3f" :knowledge-point/title "Dividing With Negative Fractions"}] :question/id #uuid "4cdf5132-1efc-52c2-8ec7-f26ef6ac833a" :question/math-academy-id "e-12801" :question/problem "Find the value of $\\left(-\\dfrac{2}{5}\\right) \\div \\dfrac{1}{10}.$" :question/worked-solution "Dividing a negative number by a positive number gives a negative number. Hence, the result will be negative.\n\nTherefore, since \n\n$$\n\\dfrac{2}{5} \\div \\dfrac{1}{10} =  \\dfrac {2 \\times 10}{5 \\times 1} = \\dfrac{20}{5} =4,\n$$\n\nwe obtain\n\n$$\n\\left(-\\dfrac{2}{5}\\right) \\div \\dfrac{1}{10} = -4.\n$$"}] [{:db/id #edb/ref 17592186180046 :knowledge-point/_questions [{:db/id #edb/ref 17592186179799 :knowledge-point/id #uuid "57266531-c68d-57d9-b136-9d100dcc983e" :knowledge-point/title "Dividing With Negative Whole Numbers and Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9023dacb-eeda-56db-8d1b-6dee28e3d304" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186177946} {:answer/id #uuid "f387802e-1ce6-57c0-bb69-e842a42b296a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{13}" :db/id #edb/ref 17592186177947} {:answer/id #uuid "f91c6dfe-5bb9-5582-a74c-754e1af88ea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{65}" :db/id #edb/ref 17592186177948} {:answer/id #uuid "3ae13dcb-c4ed-59a5-ac12-4b1ed05c4d11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{65}" :db/id #edb/ref 17592186177949} {:answer/id #uuid "51b38409-acc7-5b85-85ff-3ef64661f723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{13}" :db/id #edb/ref 17592186177950}] :answer-field/correct {:answer/id #uuid "f387802e-1ce6-57c0-bb69-e842a42b296a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{13}" :db/id #edb/ref 17592186177947} :answer-field/id #uuid "efdb995d-208b-57ad-82d7-1b0f09c33bf5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177945}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "06dbdab8-c946-5c87-85a9-b4822fda3e4f" :question/math-academy-id "q-127984" :question/problem "Find the value of $