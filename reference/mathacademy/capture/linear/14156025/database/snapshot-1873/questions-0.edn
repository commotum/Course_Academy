id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479034}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2bc8b64b-a7b7-55cd-9947-549d751592b0" :question/math-academy-id "q-128053" :question/problem "What is the value of $(-7)÷(-\\frac{14}{3})?$" :question/worked-solution "Dividing a negative number by a negative number gives a positive number. Hence, the result will be positive.\n\nTherefore, since \n\n$$\n7÷\\frac{14}{3}=\\frac{7\\times 3}{14}=\\frac{21}{14}=\\frac{3}{2},\n$$\n\nwe obtain\n\n$$\n(-7)÷(-\\frac{14}{3})=\\frac{3}{2}.\n$$"}] [{:db/id #edb/ref 17592186479064 :knowledge-point/_questions [{:db/id #edb/ref 17592186179800 :knowledge-point/id #uuid "15f1aff4-68c4-5acf-9de0-ad34e321ef3f" :knowledge-point/title "Dividing With Negative Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2749ad5e-b872-5296-91b9-e167f8f5a3a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{7}" :db/id #edb/ref 17592186478618} {:answer/id #uuid "4e609fbc-62fa-5fcd-9256-165133a5218d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186478671} {:answer/id #uuid "8f522f80-69d9-5bcc-ade5-3754e15e072f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186478786} {:answer/id #uuid "b8e1f465-57d7-577a-81e0-844ea0b22ad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186478857} {:answer/id #uuid "ed3d0116-13a7-56a0-a497-ee65979830f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186478928}] :answer-field/correct {:answer/id #uuid "b8e1f465-57d7-577a-81e0-844ea0b22ad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186478857} :answer-field/id #uuid "82bd2e5b-ca74-5ae2-ae05-c4f34010bf6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479010}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19175ca2-a78d-555b-9b54-1037f66b4e28" :question/math-academy-id "q-128058" :question/problem "Determine the value of $\\frac{2}{7}÷(-\\frac{5}{14}).$" :question/worked-solution "Dividing a positive number by a negative number gives a negative number. Hence, the result will be negative.\n\nTherefore, since \n\n$$\n\\frac{2}{7}÷\\frac{5}{14}=\\frac{2\\times 14}{7\\times 5}=\\frac{28}{35}=\\frac{4}{5},\n$$\n\nwe obtain\n\n$$\n\\frac{2}{7}÷(-\\frac{5}{14})=-\\frac{4}{5}.\n$$"}] [{:db/id #edb/ref 17592186479122 :knowledge-point/_questions [{:db/id #edb/ref 17592186179799 :knowledge-point/id #uuid "57266531-c68d-57d9-b136-9d100dcc983e" :knowledge-point/title "Dividing With Negative Whole Numbers and Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b9227e7-7620-53d7-a69e-82572e19c707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{20}" :db/id #edb/ref 17592186478687}] :answer-field/correct {:answer/id #uuid "5b9227e7-7620-53d7-a69e-82572e19c707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{20}" :db/id #edb/ref 17592186478687} :answer-field/id #uuid "15c044ef-015b-5367-b640-7228c5344697" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478965}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bd19c846-3189-5236-8a25-5221073f7ed6" :question/math-academy-id "q-178615" :question/problem "Expressed as a fraction in its simplest form, $\\frac{3}{4}÷(-15)=${{field-1}}." :question/worked-solution "Dividing a positive number by a negative number gives a negative number. Hence, the result will be negative.\n\nTherefore, since \n\n$$\n\\frac{3}{4}÷15=\\frac{3}{4\\times 15}=\\frac{3}{60}=\\frac{1}{20},\n$$\n\nwe obtain\n\n$$\n\\frac{3}{4}÷(-15)=-\\frac{1}{20}.\n$$"}] [{:db/id #edb/ref 17592186479087 :knowledge-point/_questions [{:db/id #edb/ref 17592186179800 :knowledge-point/id #uuid "15f1aff4-68c4-5acf-9de0-ad34e321ef3f" :knowledge-point/title "Dividing With Negative Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "faed038c-cb2b-58d2-9845-181cd5acb89c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186478951}] :answer-field/correct {:answer/id #uuid "faed038c-cb2b-58d2-9845-181cd5acb89c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186478951} :answer-field/id #uuid "04be7bca-6977-5bf8-9d2e-5320d2ebe561" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186478960}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e17c219-57c5-563f-87a2-8e9738ef4bd2" :question/math-academy-id "q-178619" :question/problem "Expressed as a fraction in its simplest form, $\\frac{5}{8}÷(-\\frac{3}{4})=${{field-1}}." :question/worked-solution "Dividing a positive number by a negative number gives a negative number. Hence, the result will be negative.\n\nTherefore, since\n\n$$\n\\frac{5}{8}÷\\frac{3}{4}=\\frac{5\\times 4}{8\\times 3}=\\frac{20}{24}=\\frac{5}{6},\n$$\n\nwe obtain\n\n$$\n\\frac{5}{6}÷(-\\frac{3}{4})=-\\frac{5}{6}.\n$$"}]}
