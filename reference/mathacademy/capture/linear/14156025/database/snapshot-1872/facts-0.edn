db/ref 1083 #uuid "3ae13dcb-c4ed-59a5-ac12-4b1ed05c4d11" #edb/ref 17592186045417] [17592186177950 #edb/ref 1080 "\\frac{2}{13}" #edb/ref 17592186045417] [17592186177950 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186177950 #edb/ref 1083 #uuid "51b38409-acc7-5b85-85ff-3ef64661f723" #edb/ref 17592186045417] [17592186179445 #edb/ref 1069 "e-12799" #edb/ref 17592186045417] [17592186179445 #edb/ref 1071 "Calculate $2.4 \\div (-1.2)$." #edb/ref 17592186045417] [17592186179445 #edb/ref 1072 #uuid "4fc788a3-fcac-5de0-a92b-8e818ce41160" #edb/ref 17592186045417] [17592186179445 #edb/ref 1074 "Dividing a positive number by a negative number gives a negative number. Hence, the result will be negative.\n\nTherefore, since\n\n$$\n2.4\\div 1.2 = 2\n$$\n\nwe obtain\n\n$$\n2.4 \\div (-1.2) = -2\n$$" #edb/ref 17592186045417] [17592186179446 #edb/ref 1069 "e-12800" #edb/ref 17592186045417] [17592186179446 #edb/ref 1071 "Find the value of $\\dfrac{4}{7} \\div (-2)$." #edb/ref 17592186045417] [17592186179446 #edb/ref 1072 #uuid "723f1bda-4e94-502f-aaea-d9a6c1259fd3" #edb/ref 17592186045417] [17592186179446 #edb/ref 1074 "Dividing a positive number by a negative number gives a negative number. Hence, the result will be negative.\n\nTherefore, since\n\n$$\n\\dfrac{4}{7} \\div 2 = \\dfrac{4}{7 \\times 2} = \\dfrac{4}{14} = \\dfrac{2}{7}\n$$\n\nwe obtain\n\n$$\n\\dfrac{4}{7} \\div (-2) = -\\dfrac {2}{7}\n$$" #edb/ref 17592186045417] [17592186179447 #edb/ref 1069 "e-12801" #edb/ref 17592186045417] [17592186179447 #edb/ref 1071 "Find the value of $\\left(-\\dfrac{2}{5}\\right) \\div \\dfrac{1}{10}$." #edb/ref 17592186045417] [17592186179447 #edb/ref 1072 #uuid "4cdf5132-1efc-52c2-8ec7-f26ef6ac833a" #edb/ref 17592186045417] [17592186179447 #edb/ref 1074 "Dividing a negative number by a positive number gives a negative number. Hence, the result will be negative.\n\nTherefore, since\n\n$$\n\\dfrac{2}{5} \\div \\dfrac{1}{10} = \\dfrac {2 \\times 10}{5 \\times 1} = \\dfrac{20}{5} =4\n$$\n\nwe obtain\n\n$$\n\\left(-\\dfrac{2}{5}\\right) \\div \\dfrac{1}{10} = -4\n$$" #edb/ref 17592186045417] [17592186179798 #edb/ref 1037 #edb/ref 17592186048158 #edb/ref 17592186045417] [17592186179798 #edb/ref 1037 #edb/ref 17592186049391 #edb/ref 17592186045417] [17592186179798 #edb/ref 1037 #edb/ref 17592186050719 #edb/ref 17592186045417] [17592186179798 #edb/ref 1037 #edb/ref 17592186050934 #edb/ref 17592186045417] [17592186179798 #edb/ref 1038 #edb/ref 17592186180048 #edb/ref 17592186045417] [17592186179798 #edb/ref 1038 #edb/ref 17592186180312 #edb/ref 17592186045417] [17592186179798 #edb/ref 1039 "Dividing With Negative Decimals" #edb/ref 17592186045417] [17592186179798 #edb/ref 1041 #edb/ref 17592186179445 #edb/ref 17592186045417] [17592186179798 #edb/ref 1042 #uuid "95cfce29-7f40-5b15-b299-363f8647e111" #edb/ref 17592186045417] [17592186179799 #edb/ref 1037 #edb/ref 17592186049046 #edb/ref 17592186045417] [17592186179799 #edb/ref 1037 #edb/ref 17592186049357 #edb/ref 17592186045417] [17592186179799 #edb/ref 1038 #edb/ref 17592186180046 #edb/ref 17592186045417] [17592186179799 #edb/ref 1038 #edb/ref 17592186180047 #edb/ref 17592186045417] [17592186179799 #edb/ref 1039 "Dividing With Negative Whole Numbers and Fractions" #edb/ref 17592186045417] [17592186179799 #edb/ref 1041 #edb/ref 17592186179446 #edb/ref 17592186045417] [17592186179799 #edb/ref 1042 #uuid "57266531-c68d-57d9-b136-9d100dcc983e" #edb/ref 17592186045417] [17592186179800 #edb/ref 1037 #edb/ref 17592186049616 #edb/ref 17592186045417] [17592186179800 #edb/ref 1038 #edb/ref 17592186180044 #edb/ref 17592186045417] [17592186179800 #edb/ref 1038 #edb/ref 17592186180045 #edb/ref 17592186045417] [17592186179800 #edb/ref 1039 "Dividing With Negative Fractions" #edb/ref 17592186045417] [17592186179800 #edb/ref 1041 #edb/ref 17592186179447 #edb/ref 17592186045417] [17592186179800 #edb/ref 1042 #uuid "15f1aff4-68c4-5acf-9de0-ad34e321ef3f" #edb/ref 17592186045417] [17592186179870 #edb/ref 104