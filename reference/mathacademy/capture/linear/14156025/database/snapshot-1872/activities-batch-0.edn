#{[{:activity/first-step {:db/id #edb/ref 17592186180602} :activity/id #uuid "e6fba530-9f3d-5ad2-a58a-2010478f12bf" :activity/scope {:db/id #edb/ref 17592186048392 :topic/id #uuid "9b9bc1e8-8910-5e7b-b200-0bc492f56034" :topic/math-academy-id 3719} :activity/steps [{:db/id #edb/ref 17592186180602 :step/content {:db/id #edb/ref 17592186180768 :tutorial/content "Let's remind ourselves of the three rules for dividing with negative numbers:\n\n- A negative number divided by a positive number gives a negative number.\n$(-)\\div(+) = (-)$\n- A positive number divided by a negative number is also a negative number.\n$(+)\\div(-) = (-)$\n- A negative number divided by a negative number is a positive number.\n$(-)\\div(-) = (+)$" :tutorial/id #uuid "19bbbf1e-a31e-54b1-92bb-a2fb71bf54b8" :tutorial/math-academy-id 8022 :tutorial/title "Introduction"} :step/id #uuid "b2427cba-ac8b-55c2-95b7-2a0f2be0812b" :step/math-academy-id 53469 :step/next {:db/id #edb/ref 17592186180603}} {:db/id #edb/ref 17592186180603 :step/content {:db/id #edb/ref 17592186180769 :tutorial/content "As an example, let's find the value of\n\n$$\n2.4 \\div (-4)\n$$\n\nDividing a positive number by a negative number gives a negative number. Hence, the result will be negative.\n\nTherefore, since\n\n$$\n2.4\\div 4=0.6\n$$\n\nwe obtain\n\n$$\n2.4 \\div (-4) = -0.6\n$$" :tutorial/id #uuid "3c2ea5e2-fa57-573b-8e38-712b30958ca4" :tutorial/math-academy-id 8023 :tutorial/title "A Worked Example"} :step/id #uuid "c0f81736-6a5b-5d18-9f29-8ef5290d319e" :step/math-academy-id 53470 :step/next {:db/id #edb/ref 17592186180604}} {:db/id #edb/ref 17592186180604 :step/content {:db/id #edb/ref 17592186179798 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179445 :question/id #uuid "4fc788a3-fcac-5de0-a92b-8e818ce41160" :question/math-academy-id "e-12799"} :knowledge-point/id #uuid "95cfce29-7f40-5b15-b299-363f8647e111" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048158} {:db/id #edb/ref 17592186049391} {:db/id #edb/ref 17592186050719} {:db/id #edb/ref 17592186050934}] :knowledge-point/questions [{:db/id #edb/ref 17592186180048} {:db/id #edb/ref 17592186180312}] :knowledge-point/title "Dividing With Negative Decimals"} :step/id #uuid "78adffff-c4c8-53d4-8be1-0adce0ba9c40" :step/math-academy-id 53471 :step/next {:db/id #edb/ref 17592186180605}} {:db/id #edb/ref 17592186180605 :step/content {:db/id #edb/ref 17592186179799 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179446 :question/id #uuid "723f1bda-4e94-502f-aaea-d9a6c1259fd3" :question/math-academy-id "e-12800"} :knowledge-point/id #uuid "57266531-c68d-57d9-b136-9d100dcc983e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049046} {:db/id #edb/ref 17592186049357}] :knowledge-point/questions [{:db/id #edb/ref 17592186180046} {:db/id #edb/ref 17592186180047}] :knowledge-point/title "Dividing With Negative Whole Numbers and Fractions"} :step/id #uuid "51cb3a96-772b-5cf8-a320-e21f950a928a" :step/math-academy-id 53474 :step/next {:db/id #edb/ref 17592186180606}} {:db/id #edb/ref 17592186180606 :step/content {:db/id #edb/ref 17592186179800 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179447 :question/id #uuid "4cdf5132-1efc-52c2-8ec7-f26ef6ac833a" :question/math-academy-id "e-12801"} :knowledge-point/id #uuid "15f1aff4-68c4-5acf-9de0-ad34e321ef3f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049616}] :knowledge-point/questions [{:db/id #edb/ref 17592186180044} {:db/id #edb/ref 17592186180045}] :knowledge-point/title "Dividing With Negative Fractions"} :step/id #uuid "01563470-15f3-5ad3-a0d7-68cf371ee42d" :step/math-academy-id 53477}] :activity/title "Dividing With Negative Decimals and Fractions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179870}]}
