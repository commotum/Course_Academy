{
  "dom_id": "step-53469",
  "name": "Introduction",
  "problem": "Let's remind ourselves of the three rules for dividing with negative numbers:\n\n- A negative number divided by a positive number gives a negative number. \n\n$$\n\\begin{aligned}(-)\\,÷\\,(+)\\,=\\,(-)\\end{aligned}\n$$\n\n- A positive number divided by a negative number is also a negative number. \n\n$$\n\\begin{aligned}(+)\\,÷\\,(-)\\,=\\,(-)\\end{aligned}\n$$\n\n- A negative number divided by a negative number is a positive number.\n\n$$\n\\begin{aligned}(-)\\,÷\\,(-)\\,=\\,(+)\\end{aligned}\n$$",
  "worked_solution": "",
  "calculator_instructions": "",
  "fields": [],
  "problem_field_keys": [],
  "answer_fields_complete": null,
  "result": null,
  "proof_feedback": null,
