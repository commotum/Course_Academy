n\\frac{2-6}{7}=\\frac{-4}{7}=-\\frac{4}{7}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4abef0d5-1231-588c-bd31-a2da25e317de"] :db/ensure [:question/validate]} {:db/id "answer-field-4abef0d5-1231-588c-bd31-a2da25e317de" :answer-field/id #uuid "4abef0d5-1231-588c-bd31-a2da25e317de" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f9e0dabd-cccc-56f3-88ec-878f11e94828" :answer-field/choices ["answer-78d56a67-a62b-5fb2-a31e-0e7c574117ea" "answer-f9e0dabd-cccc-56f3-88ec-878f11e94828" "answer-2da14132-4d6b-51df-8620-245d7145bdf3" "answer-dad1c1cc-d45a-591b-891b-04f549f1712f" "answer-1bca7a5b-a088-5bcc-802a-8f3860610e1b"] :db/ensure [:answer-field/validate]} {:db/id "answer-78d56a67-a62b-5fb2-a31e-0e7c574117ea" :answer/id #uuid "78d56a67-a62b-5fb2-a31e-0e7c574117ea" :answer/type :answer.type/math :answer/value "-\\frac{3}{7}" :db/ensure [:answer/validate]} {:db/id "answer-f9e0dabd-cccc-56f3-88ec-878f11e94828" :answer/id #uuid "f9e0dabd-cccc-56f3-88ec-878f11e94828" :answer/type :answer.type/math :answer/value "-\\frac{4}{7}" :db/ensure [:answer/validate]} {:db/id "answer-2da14132-4d6b-51df-8620-245d7145bdf3" :answer/id #uuid "2da14132-4d6b-51df-8620-245d7145bdf3" :answer/type :answer.type/math :answer/value "-\\frac{8}{7}" :db/ensure [:answer/validate]} {:db/id "answer-dad1c1cc-d45a-591b-891b-04f549f1712f" :answer/id #uuid "dad1c1cc-d45a-591b-891b-04f549f1712f" :answer/type :answer.type/math :answer/value "\\frac{4}{7}" :db/ensure [:answer/validate]} {:db/id "answer-1bca7a5b-a088-5bcc-802a-8f3860610e1b" :answer/id #uuid "1bca7a5b-a088-5bcc-802a-8f3860610e1b" :answer/type :answer.type/math :answer/value "\\frac{8}{7}" :db/ensure [:answer/validate]} {:db/id "question-1e29b1c7-106c-5ab0-8d9e-819610a3356d" :question/id #uuid "1e29b1c7-106c-5ab0-8d9e-819610a3356d" :question/math-academy-id "q-119466" :question/problem "Find the value of $-\\frac{3}{11}-\\frac{6}{11}.$" :questio