-1daa5bacd78a" :answer/id #uuid "d28504e9-23a3-51f0-b178-1daa5bacd78a" :answer/type :answer.type/math :answer/value "-\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "answer-177ca00e-712d-5a3a-90a3-0eed2855c692" :answer/id #uuid "177ca00e-712d-5a3a-90a3-0eed2855c692" :answer/type :answer.type/math :answer/value "-\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "answer-9b908d3b-a60e-58b0-9b72-8b4f81b6c8a2" :answer/id #uuid "9b908d3b-a60e-58b0-9b72-8b4f81b6c8a2" :answer/type :answer.type/math :answer/value "-\\frac{5}{18}" :db/ensure [:answer/validate]} {:db/id "question-3d3c4be6-4f0d-589b-961f-38e5107411d1" :question/id #uuid "3d3c4be6-4f0d-589b-961f-38e5107411d1" :question/math-academy-id "q-119508" :question/problem "Calculate the value of $\\frac{2}{7}-\\frac{1}{3}.$" :question/worked-solution "We write $\\frac{2}{7}$ as $\\frac{6}{21}$ and $\\frac{1}{3}$ as $\\frac{7}{21},$ and then we simply subtract the numerators. This gives\n\n$$\n\\frac{6}{21}-\\frac{7}{21}=\\frac{6-7}{21}.\n$$\n\nNow, we work out $6-7$ using a number line:\n\n![](images/f3/f39be0767b6d9b5c3203946adc4212201c49cd6539cfc49c3c75646d7ea4bac5.png)\n\nSo, we get\n\n$$\n\\frac{6-7}{21}=\\frac{-1}{21}=-\\frac{1}{21}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1aa7ae84-3c5f-5210-931e-9cd2854e6aca"] :db/ensure [:question/validate]} {:db/id "answer-field-1aa7ae84-3c5f-5210-931e-9cd2854e6aca" :answer-field/id #uuid "1aa7ae84-3c5f-5210-931e-9cd2854e6aca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1d1a6ad6-1fbb-5d33-869c-b99e4e3cd1d3" :answer-field/choices ["answer-1d1a6ad6-1fbb-5d33-869c-b99e4e3cd1d3" "answer-a912c885-bfee-5944-b15a-8975628b8c80" "answer-600f8e10-b937-56be-ab9b-755885f180f5" "answer-1c1697a5-e129-5313-bc78-5a73e3ea45d6" "answer-569980e2-0084-5ec6-987a-095f019f2bb5"] :db/ensure [:answer-field/validate]} {:db/id "answer-1d1a6ad6-1fbb-5d33-869c-b99e4e3cd1d3" :answer/id #uuid "1d1a6ad6-1fbb-5d33-869c-b99e4e3cd1d3" :answer/type :answer.type/math :answer/value "-\\frac{1}{21}" :db/ensure [:answer/validate]} {:db/id "answer-a912c885-bfee-5944-b15a-8975628b8c80" :answer/id #uuid "a912c885-bfee-5944-b15a-8975628b8c80" :answer/type :answer.type/math :answer/value "-\\frac{2}{21}" :db/ensure [:answer/validate]} {:db/id "answer-600f8e10-b937-56be-ab9b-755885f180f5" :answer/id #uuid "600f8e10-b937-56be-ab9b-755885f180f5" :answer/type :answer.type/math :answer/value "-\\frac{2}{7}" :db/ensure [:answer/validate]} {:db/id "answer-1c1697a5-e129-5313-bc78-5a73e3ea45d6" :answer/id #uuid "1c1697a5-e129-5313-bc78-5a73e3ea45d6" :answer/type :answer.type/math :answer/value "\\frac{1}{21}" :db/ensure [:answer/validate]} {:db/id "answer-569980e2-0084-5ec6-987a-095f019f2bb5" :answer/id #uuid "569980e2-0084-5ec6-987a-095f019f2bb5" :answer/type :answer.type/math :answer/value "\\frac{1}{7}" :db/ensure [:answer/validate]} {:db/id "question-bfb8f280-e1d8-5d03-9404-6aac25e66c3a" :question/id #uuid "bfb8f280-e1d8-5d03-9404-6aac25e66c3a" :question/math-academy-id "q-119512" :question/problem "Calculate the value of $\\frac{1}{3}-\\frac{3}{5}.$" :question/worked-solution "We write $\\frac{1}{3}$ as $\\frac{5}{15}$ and $\\frac{3}{5}$ as $\\frac{9}{15},$ and then we simply subtract the numerators. This gives\n\n$$\n\\frac{5}{15}-\\frac{9}{15}=\\frac{5-9}{15}.\n$$\n\nNow, we work out $5-9$ using a number line:\n\n![](images/96/96aeff6f68fcb31f7a871381a819951ee749114228535155b2eda3b32aee8fef.png)\n\nSo, we get\n\n$$\n\\frac{5-9}{15}=\\frac{-4}{15}=-\\frac{4}{15}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-23a58afd-d1b7-5e99-a2e9-49c62a181959"] :db/ensure [:question/validate]} {:db/id "answer-field-23a58afd-d1b7-5e99-a2e9-49c62a181959" :answer-field/id #uuid "23a58afd-d1b7-5e99-a2e9-49c62a181959" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b4715225-fe07-572f-a735-