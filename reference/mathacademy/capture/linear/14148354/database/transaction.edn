ype :answer-field.type/radio :answer-field/correct "answer-5a5487b1-7f0e-54c7-a8d9-cbb5808d277f" :answer-field/choices ["answer-5a5487b1-7f0e-54c7-a8d9-cbb5808d277f" "answer-f5e63997-25a6-5c66-9233-58f902c8a57f" "answer-899a2543-03cd-5aea-9614-3ddad7e79bc7" "answer-90a99a83-85a6-5a96-a517-021aa18bea03" "answer-8109d9f1-e4a8-5a74-b46b-1b3c8469b5ed"] :db/ensure [:answer-field/validate]} {:db/id "answer-5a5487b1-7f0e-54c7-a8d9-cbb5808d277f" :answer/id #uuid "5a5487b1-7f0e-54c7-a8d9-cbb5808d277f" :answer/type :answer.type/math :answer/value "-\\frac{11}{10}" :db/ensure [:answer/validate]} {:db/id "answer-f5e63997-25a6-5c66-9233-58f902c8a57f" :answer/id #uuid "f5e63997-25a6-5c66-9233-58f902c8a57f" :answer/type :answer.type/math :answer/value "-\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-899a2543-03cd-5aea-9614-3ddad7e79bc7" :answer/id #uuid "899a2543-03cd-5aea-9614-3ddad7e79bc7" :answer/type :answer.type/math :answer/value "-\\frac{3}{10}" :db/ensure [:answer/validate]} {:db/id "answer-90a99a83-85a6-5a96-a517-021aa18bea03" :answer/id #uuid "90a99a83-85a6-5a96-a517-021aa18bea03" :answer/type :answer.type/math :answer/value "-\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-8109d9f1-e4a8-5a74-b46b-1b3c8469b5ed" :answer/id #uuid "8109d9f1-e4a8-5a74-b46b-1b3c8469b5ed" :answer/type :answer.type/math :answer/value "-\\frac{9}{10}" :db/ensure [:answer/validate]} {:db/id "question-a6a01cd3-8e80-578c-a68c-ccfe0c02910d" :question/id #uuid "a6a01cd3-8e80-578c-a68c-ccfe0c02910d" :question/math-academy-id "q-101213" :question/problem "Calculate the value of $\\frac{2}{3}-\\frac{5}{6}.$" :question/worked-solution "We write $\\frac{2}{3}$ as $\\frac{4}{6}$ and then we simply subtract the numerators. This gives\n\n$$\n\\frac{4}{6}-\\frac{5}{6}=\\frac{4-5}{6}.\n$$\n\nNow, we work out $4-5$ using a number line:\n\n![](images/53/53b1655255807f7007040bb6ba38c2570ec14e0dde04e3d49696953f3750d449.png)\n\nSo we get\n\n$$\n\\frac{4-5}{6}=\\frac{-1}{6}=-\\frac{1}{6}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4de4f800-0051-5404-8aa0-db9f86428481"] :db/ensure [:question/validate]} {:db/id "answer-field-4de4f800-0051-5404-8aa0-db9f86428481" :answer-field/id #uuid "4de4f800-0051-5404-8aa0-db9f86428481" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a863f19c-37d5-51d3-bef2-403dae10500a" :answer-field/choices ["answer-7f9f07fa-7338-5059-9ba0-d622dbd68762" "answer-1f1bfecb-b84d-59ed-91ec-6e4c30f06fe5" "answer-a863f19c-37d5-51d3-bef2-403dae10500a" "answer-08e25748-bc23-5fb1-b630-aafea4a149b9" "answer-84e625f5-12e5-520d-b36c-439f88a00f39"] :db/ensure [:answer-field/validate]} {:db/id "answer-7f9f07fa-7338-5059-9ba0-d622dbd68762" :answer/id #uuid "7f9f07fa-7338-5059-9ba0-d622dbd68762" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-1f1bfecb-b84d-59ed-91ec-6e4c30f06fe5" :answer/id #uuid "1f1bfecb-b84d-59ed-91ec-6e4c30f06fe5" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-a863f19c-37d5-51d3-bef2-403dae10500a" :answer/id #uuid "a863f19c-37d5-51d3-bef2-403dae10500a" :answer/type :answer.type/math :answer/value "-\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-08e25748-bc23-5fb1-b630-aafea4a149b9" :answer/id #uuid "08e25748-bc23-5fb1-b630-aafea4a149b9" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-84e625f5-12e5-520d-b36c-439f88a00f39" :answer/id #uuid "84e625f5-12e5-520d-b36c-439f88a00f39" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "question-39ba11e1-e910-5353-9445-994f4bc57a7d" :question/id #uuid "39ba11e1-e910-5353-9445-994f4bc57a7d" :question/math-academy-id "q-119389" :question/problem "Calculate the value of $\\frac{2}{3}-\\frac{7}{6}.$" :question/worked-solution "We write $\\frac{2}{3}$ as $\\frac{4}{6}$ and then we simply subtract the numerators. This gives\n\n$$\n\\frac{4}{6}-\\frac{7}{6}=\\frac{4-7}{6}.\n$$\n\nNow, we work out $4-7$ using a number line:\n\n![](images/d5/d542609ee447bff7bcb3209bb8ea6eccbd770509d2ae4ad794df9eb6606c2b17.png)\n\nSo we get\n\n$$\n\\frac{4-7}{6}=\\frac{-3}{6}=-\\frac{3}{6}.\n$$\n\nFinally, we simplify:\n\n$$\n-\\frac{3}{6}=-\\frac{3÷3}{6÷3}=-\\frac{1}{2}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{2}{3}-\\frac{7}{6}=-\\frac{1}{2}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c85eb72d-5422-58e8-a29e-633c39efec1a"] :db/ensure [:question/validate]} {:db/id "answer-field-c85eb72d-5422-58e8-a29e-633c39efec1a" :answer-field/id #uuid "c85eb72d-5422-58e8-a29e-633c39efec1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a6ca40b9-8a25-58ad-ac4c-c399c41809a7" :answer-field/choices ["answer-a6ca40b9-8a25-58ad-ac4c-c399c41809a7" "answer-d422ae59-c5ba-5a12-ae7e-8f6ac2487be5" "answer-5cb1b3fb-9bee-5812-92ac-c8898be7ff70" "answer-59b6dbee-4543-5ac0-bbc5-39ee16ac5735" "answer-71439147-1f96-5c48-b484-dc22c9f60c8c"] :db/ensure [:answer-field/validate]} {:db/id "answer-a6ca40b9-8a25-58ad-ac4c-c399c41809a7" :answer/id #uuid "a6ca40b9-8a25-58ad-ac4c-c399c41809a7" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-d422ae59-c5ba-5a12-ae7e-8f6ac2487be5" :answer/id #uuid "d422ae59-c5ba-5a12-ae7e-8f6ac2487be5" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-5cb1b3fb-9bee-5812-92ac-c8898be7ff70" :answer/id #uuid "5cb1b3fb-9bee-5812-92ac-c8898be7ff70" :answer/type :answer.type/math :answer/value "-\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-59b6dbee-4543-5ac0-bbc5-39ee16ac5735" :answer/id #uuid "59b6dbee-4543-5ac0-bbc5-39ee16ac5735" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id 