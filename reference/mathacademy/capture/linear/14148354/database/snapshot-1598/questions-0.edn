s [{:answer/id #uuid "695df94e-a8d7-5f7b-93fe-c8812a984f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186443768} {:answer/id #uuid "8c17c9ca-c1b7-5242-8027-c5085290d31f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186443780} {:answer/id #uuid "97d73e08-7eb5-53e2-8dd4-1dafe8d2ba01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186443782} {:answer/id #uuid "9d972692-fe10-5e3c-afea-7a24a57a8c8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186443784} {:answer/id #uuid "f5e5df30-f2d3-5a0f-b3cb-e485002e94e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186443813}] :answer-field/correct {:answer/id #uuid "695df94e-a8d7-5f7b-93fe-c8812a984f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186443768} :answer-field/id #uuid "58cec188-3aa9-5a93-bf5d-662504369bc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443824}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "00627a83-5d8e-5013-8a9c-ba462e57258b" :question/math-academy-id "q-119467" :question/problem "Find the value of $\\frac{1}{6}-\\frac{5}{6}.$" :question/worked-solution "Since both fractions have the same denominators, we can combine them into one fraction, which gives\n\n$$\n\\frac{1}{6}-\\frac{5}{6}=\\frac{1-5}{6}.\n$$\n\nNow, we work out $1-5$ using a number line:\n\n![](images/ac/ac5c43b0ae0187245b0b5f308335e2797483f62afba727e7b64f1bc1dceced77.png)\n\nSo, we get \n\n$$\n\\frac{1-5}{6}=\\frac{-4}{6}=-\\frac{4}{6}.\n$$\n\nFinally, we simplify:\n\n$$\n-\\frac{4}{6}=-\\frac{4÷2}{6÷2}=-\\frac{2}{3}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1}{6}-\\frac{5}{6}=-\\frac{2}{3}.\n$$"}] [{:db/id #edb/ref 17592186443842 :knowledge-point/_questions [{:db/id #edb/ref 17592186179697 :knowledge-point/id #uuid "fd087cbc-c76f-5900-a1ef-183c383e34ed" :knowledge-point/title "Subtracting a Positive Fraction From a Fraction: Unlike Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a5487b1-7f0e-54c7-a8d9-cbb5808d277f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{10}" :db/id #edb/ref 17592186443762} {:answer/id #uuid "8109d9f1-e4a8-5a74-b46b-1b3c8469b5ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{10}" :db/id #edb/ref 17592186443775} {:answer/id #uuid "899a2543-03cd-5aea-9614-3ddad7e79bc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{10}" :db/id #edb/ref 17592186443779} {:answer/id #uuid "90a99a83-85a6-5a96-a517-021aa18bea03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186443781} {:answer/id #uuid "f5e63997-25a6-5c66-9233-58f902c8a57f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186443814}] :answer-field/correct {:answer/id #uuid "5a5487b1-7f0e-54c7-a8d9-cbb5808d277f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{10}" :db/id #edb/ref 17592186443762} :answer-field/id #uuid "33b907a1-e0e3-5118-8c10-2e95a21daf53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443819}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9177f11e-16b2-5f25-b1c3-d0c370d0a589" :question/math-academy-id "q-119497" :question/problem "Calculate the value of $-\\frac{2}{5}-\\frac{7}{10}.$" :question/worked-solution "We write $-\\frac{2}{5}$ as $-\\frac{4}{10}$ and then we simply subtract the numerators. This gives\n\n$$\n-\\frac{4}{10}-\\frac{7}{10}=\\frac{-4-7}{10}.\n$$\n\nNow, we work out $-4-7$ using a number line:\n\n![](images/d2/d2965f3b03382313757e12920c55ca04be14bf5ae8d5957a15458f5548b8402d.png)\n\nSo, we get\n\n$$\n\\frac{-4-7}{10}=\\frac{-11}{10}=-\\frac{11}{10}.\n$$"}] [{:db/id #edb/ref 17592186443838 :knowledge-point/_questions [{:db/id #edb/ref 17592186179698 :knowledge-point/id #uuid "2ce776ed-33ba-522b-9241-68458339ddc6" :knowledge-point/title "Subtracting a Positive Fraction From a Fraction: Unlike Denominators That Are Not Multiples"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c1697a5-e129-5313-bc78-5a73e3ea45d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{21}" :db/id #edb/ref 17592186443741} {:answer/id #uuid "1d1a6ad6-1fbb-5d33-869c-b99e4e3cd1d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{21}" :db/id #edb/ref 17592186443742} {:answer/id #uuid "569980e2-0084-5ec6-987a-095f019f2bb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186443760} {:answer/id #uuid "600f8e10-b937-56be-ab9b-755885f180f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186443764} {:answer/id #uuid "a912c885-bfee-5944-b15a-8975628b8c80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{21}" :db/id #edb/ref 17592186443788}] :answer-field/correct {:answer/id #uuid "1d1a6ad6-1fbb-5d33-869c-b99e4e3cd1d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{21}" :db/id #edb/ref 17592186443742} :answer-field/id #uuid "1aa7ae84-3c5f-5210-931e-9cd2854e6aca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186443817}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d3c4be6-4f0d-589b-961f-38e5107411d1" :question/math-academy-id "q-119508" :question/problem "Calculate the value of $\\frac{2}{7}-\\frac{1}{3}.$" :question/worked-solution "We write $\\frac{2}{7}$ as $\\frac{6}{21}$ and $\\frac{1}{3}$ as $\\frac{7}{21},$ and then we simply subtract the numerators. This gives\n\n$$\n\\frac{6}{21}-\\frac{7}{21}=\\frac{6-7}{21}.\n$$\n\nNow, we work out $6-7$ using a number line:\n\n![](images/f3/f39be0767b6d9b5c3203946adc4212201c49cd6539cfc49c3c75646d7ea4bac5.png)\n\nSo, we get\n\n$$\n\\frac{6-7}{21}=\\frac{-1}{21}=-\\frac{1}{21}.\n$$"}] [{:db/id #edb/ref 17592186443846 :knowledge-point/_questions [{:db/id #edb/ref 17592186179698 :knowledge-point/id #uuid "2ce776ed-33ba-522b-9241-68458339ddc6" :knowledge-point/title "Subtracting a Positive Fraction From a Fraction: Unlike Denominators That Are Not Multiples"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "177ca00e-712d-5a3a-90a3-0eed2855c692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186443738} {:answer/id #uuid "3d8cb284-f096-5f05-b73a-60eb463a44b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{18}" :db/id #edb/ref 17592186443749} {:answer/id #uuid "9b908d3b-a60e-58b0-9b72-8b4f81b6c8a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{18}" :db/id #edb/ref 17592186443783} {:answer/id #uuid "b6795589-efe5-5e37-95f1-af12d6609282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.ty