34910 17592186045417 true] [17592186443843 1070 #edb/ref 17592186045485 13194139534910 17592186045417 true] [17592186443843 1071 "Calculate the value of $\\frac{2}{3}-\\frac{5}{6}.$" 13194139534910 17592186045417 true] [17592186443843 1072 #uuid "a6a01cd3-8e80-578c-a68c-ccfe0c02910d" 13194139534910 17592186045417 true] [17592186443843 1074 "We write $\\frac{2}{3}$ as $\\frac{4}{6}$ and then we simply subtract the numerators. This gives\n\n$$\n\\frac{4}{6}-\\frac{5}{6}=\\frac{4-5}{6}.\n$$\n\nNow, we work out $4-5$ using a number line:\n\n![](images/53/53b1655255807f7007040bb6ba38c2570ec14e0dde04e3d49696953f3750d449.png)\n\nSo we get\n\n$$\n\\frac{4-5}{6}=\\frac{-1}{6}=-\\frac{1}{6}.\n$$" 13194139534910 17592186045417 true] [17592186443844 1068 #edb/ref 17592186443827 13194139534910 17592186045417 true] [17592186443844 1069 "q-119521" 13194139534910 17592186045417 true] [17592186443844 1070 #edb/ref 17592186045486 13194139534910 17592186045417 true] [17592186443844 1071 "Calculate the value of $-\\frac{1}{9}-\\frac{1}{6}.$" 13194139534910 17592186045417 true] [17592186443844 1072 #uuid "b3cacdef-dab0-554e-ba7e-6bcb902467ae" 13194139534910 17592186045417 true] [17592186443844 1074 "We write $-\\frac{1}{9}$ as $-\\frac{2}{18}$ and $\\frac{1}{6}$ as $\\frac{3}{18},$ and then we simply subtract the numerators. This gives\n\n$$\n-\\frac{2}{18}-\\frac{3}{18}=\\frac{-2-3}{18}.\n$$\n\nNow, we work out $-2-3$ using a number line:\n\n![](images/f1/f1d24c5635fd9b7523667eb492fe3d88adf1e485b2972e1ba61e3b3d0fb212c5.png)\n\nSo, we get\n\n$$\n\\frac{-2-3}{18}=\\frac{-5}{18}=-\\frac{5}{18}.\n$$" 13194139534910 17592186045417 true] [17592186443845 1068 #edb/ref 17592186443818 13194139534910 17592186045417 true] [17592186443845 1069 "q-119512" 13194139534910 17592186045417 true] [17592186443845 1070 #edb/ref 17592186045485 13194139534910 17592186045417 true] [17592186443845 1071 "Calculate the value of $\\frac{1}{3}-\\frac{3}{5}.$" 13194139534910 17592186045417 true] [17592186443845 1072 #uuid "bfb8f280-e1d8-5d03-9404-6aac25e66c3a" 13194139534910 17592186045417 true] [17592186443845 1074 "We write $\\frac{1}{3}$ as $\\frac{5}{15}$ and $\\frac{3}{5}$ as $\\frac{9}{15},$ and then we simply subtract the numerators. This gives\n\n$$\n\\frac{5}{15}-\\frac{9}{15}=\\frac{5-9}{15}.\n$$\n\nNow, we work out $5-9$ using a number line:\n\n![](images/96/96aeff6f68fcb31f7a871381a819951ee749114228535155b2eda3b32aee8fef.png)\n\nSo, we get\n\n$$\n\\frac{5-9}{15}=\\frac{-4}{15}=-\\frac{4}{15}.\n$$" 13194139534910 17592186045417 true] [17592186443846 1068 #edb/ref 17592186443829 13194139534910 17592186045417 true] [17592186443846 1069 "q-119510" 13194139534910 17592186045417 true] [17592186443846 1070 #edb/ref 17592186045485 13194139534910 17592186045417 true] [17592186443846 1071 "Calculate the value of $\\frac{4}{9}-\\frac{1}{2}.$" 13194139534910 17592186045417 true] [17592186443846 1072 #uuid "c7de1d22-ba4a-5f8e-8822-f3f4dfdb810b" 13194139534910 17592186045417 true] [17592186443846 1074 "We write $\\frac{4}{9}$ as $\\frac{8}{18}$ and $\\frac{1}{2}$ as $\\frac{9}{18},$ and then we simply subtract the numerators. This gives\n\n$$\n\\frac{8}{18}-\\frac{9}{18}=\\frac{8-9}{18}.\n$$\n\nNow, we work out $8-9$ using a number line:\n\n![](images/61/617ce139a9838991ce1fe0532a01da77e3e58f9e5d50184598570419b4c5a5fc.png)\n\nSo, we get\n\n$$\n\\frac{8-9}{18}=\\frac{-1}{18}=-\\frac{1}{18}.\n$$" 13194139534910 17592186045417 true] [17592186443847 1068 #edb/ref 17592186443831 13194139534910 17592186045417 true] [17592186443847 1069 "q-101209" 13194139534910 17592186045417 true] [17592186443847 1070 #edb/ref 17592186045485 13194139534910 17592186045417 true] [17592186443847 1071 "Find the value of $\\frac{2}{9}-\\frac{7}{9}.$" 13194139534910 17592186045417 true] [17592186443847 1072 #uuid "cdfbed1a-906b-56f6-99dc-ee6b37df7069" 13194139534910 17592186045417 true] [17592186443847 1074 "Since both fractions have the same denominators, we can combine them into one fraction, which gives\n\n$$\n\\frac{2}{9}-\\frac{7}{9}=\\frac{2-7}{9}.\n$$\n\nNow, we work out $2-7$ using a number line:\n\n![](images/bb/bb81cb03e8205a9df3a62ed47ca7b2a4c1a66ad990eaf248f8701480bb2d5bb1.png)\n\nSo, we get \n\n$$\n\\frac{2-7}{9}=\\frac{-5}{9}=-\\frac{5}{9}.\n$$" 13194139534910 17592186045417 true]] :edb/tempids {"answer-06826022-9aca-5119-b4b0-e4cd562a853b" 17592186443731 "answer-08e25748-bc23-5fb1-b630-aafea4a149b9" 17592186443732 "answer-0bc4f8fd-ffd1-5e06-a562-5ecb24dab1d4" 17592186443733 "answer-0c063043-348e-5eac-84ed-a7672540af64" 17592186443734 "answer-10c778ac-45a7-5054-9e7a-d2aca2969d45" 17592186443735 "answer-1132f49f-3789-5224-9661-f88d99141500" 17592186443736 "answer-115b8fee-d484-5ba9-846e-26fb6bd010a9" 17592186443737 "answer-177ca00e-712d-5a3a-90a3-0eed2855c692" 17592186443738 "answer-1b4bc9a3-a0f7-576d-b858-9fdbfa22c852" 17592186443739 "answer-1bca7a5b-a088-5bcc-802a-8f3860610e1b" 17592186443740 "answer-1c1697a5-e129-5313-bc78-5a73e3ea45d6" 17592186443741 "answer-1d1a6ad6-1fbb-5d33-869c-b99e4e3cd1d3" 17592186443742 "answer-1f1bfecb-b84d-59ed-91ec-6e4c30f06fe5" 17592186443743 "answer-224e1311-31ca-5818-945d-80b281eb904f" 17592186443744 "answer-27a4e2bb-fb00-519a-9858-ecd80804d22a" 17592186443745 "answer-2b8f5c6f-df95-5cfb-9550-a83a1314f99a" 17592186443746 "answer-2da14132-4d6b-51df-8620-245d7145bdf3" 17592186443747 "answer-305de368-fb6e-5bfe-ab1b-de415b87fd4e" 17592186443748 "answer-3d8cb284-f096-5f05-b73a-60eb463a44b8" 17592186443749 "answer-3fa215d3-0b57-54ce-a8c7-ad8f3fa77766" 17592186443750 "answer-457a66cc-2912-57fb-8fde-0b569e1bf6ac" 17592186443751 "answer-478602a6-4124-5195-96b1-d9ffad534b57" 17592186443752 "answer-4aa889dd-82ee-5d6e-b708-42783ea13b1b" 17592186443753 "answer-4be16cdb-5100-5b3f-bddb-d8a6dcd599c4" 17592186443754 "answer-4c6f55f6-aa95-5757-97d1-fea7904befd7" 17592186443755 "answer-4e623a27-676c-576a-9628-aafefad76c3e" 17592186443756 "answer-50b91276-3486-5538-b2fa-c6c115a6de3e" 17592186443757 "answer-56135516-4bbe-5149-8994-ebb28c6fa4