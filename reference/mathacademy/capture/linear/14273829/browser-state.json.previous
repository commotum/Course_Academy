"false\">|</mo></mrow><msqrt><msup><mi>u</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></msqrt></mrow></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>10</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>arcsec&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mi>u</mi></mrow><mo>+</mo><mi>C</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>10</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>arcsec</mtext><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mi>x</mi><mo>−</mo><mn>6</mn><mo stretchy=\"false\">)</mo></mrow><mo>+</mo><mi>C</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
