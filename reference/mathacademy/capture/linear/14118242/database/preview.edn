′}(1) \\\\ 0 & 0 & f(1)\\end{aligned}] \\\\  & =[\\begin{aligned}e & e & \\frac{e}{2} \\\\ 0 & e & e \\\\ 0 & 0 & e\\end{aligned}]\\end{aligned}\n$$" 13194139534206 17592186045417 true] [17592186414004 1068 #edb/ref 17592186413997 13194139534206 17592186045417 true] [17592186414004 1069 "q-253488" 13194139534206 17592186045417 true] [17592186414004 1070 #edb/ref 17592186045485 13194139534206 17592186045417 true] [17592186414004 1071 "Consider the following matrices:\n\n$$\nB=[\\begin{aligned}-2 & 2 \\\\ -6 & 5\\end{aligned}],\\,D=[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}],\\,P=[\\begin{aligned}2 & 1 \\\\ 3 & 2\\end{aligned}]\n$$\n\nGiven that $X=PD{P}^{-1},$ find ${X}^{5}.$" 13194139534206 17592186045417 true] [17592186414004 1072 #uuid "5a76ab5b-a059-5458-b5f4-e674816ed366" 13194139534206 17592186045417 true] [17592186414004 1074 "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)={x}^{5}$ and the given matrix $X,$ we have\n\n$$\n{X}^{5}=(PD{P}^{-1})^{5}=P\\cdot ({D}^{5})\\cdot {P}^{-1}.\n$$\n\nNow, since $D$ is a diagonal matrix, we get\n\n$$\n{D}^{5}=[\\begin{aligned}{1}^{5} & 0 \\\\ 0 & {2}^{5}\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ 0 & 32\\end{aligned}].\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{2}{2\\cdot 1-3\\cdot 1}[\\begin{aligned}2 & -1 \\\\ -3 & 2\\end{aligned}]=[\\begin{aligned}2 & -1 \\\\ -3 & 2\\end{aligned}].\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}{X}^{5} & =P\\cdot ({D}^{5})\\cdot {P}^{-1} \\\\  & =[\\begin{aligned}2 & 1 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 32\\end{aligned}][\\begin{aligned}2 & -1 \\\\ -3 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}2 & -1 \\\\ -96 & 64\\end{aligned}] \\\\  & =[\\begin{aligned}-92 & 62 \\\\ -186 & 125\\end{aligned}].\\end{aligned}\n$$" 13194139534206 17592186045417 true] [17592186414005 1068 #edb/ref 17592186413985 13194139534206 17592186045417 true] [17592186414005 1068 #edb/ref 17592186413988 13194139534206 17592186045417 true] [17592186414005 1068 #edb/ref 17592186413992 13194139534206 17592186045417 true] [17592186414005 1068 #edb/ref 17592186413996 13194139534206 17592186045417 true] [17592186414005 1068 #edb/ref 17592186414001 13194139534206 17592186045417 true] [17592186414005 1068 #edb/ref 17592186414002 13194139534206 17592186045417 true] [17592186414005 1069 "q-253884" 13194139534206 17592186045417 true] [17592186414005 1070 #edb/ref 17592186045486 13194139534206 17592186045417 true] [17592186414005 1071 "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | {{field-1}} | $0$ | $0$ | $0$ |  |\n| --- | --- | --- | --- | --- | --- | --- |\n| ${e}^{({J}_{1}(3)\\,⊕\\,{J}_{3}(0))}=\\,\\,$ |  | $0$ | {{field-2}} | {{field-3}} | $\\frac{1}{2}$ |  |\n|  | $0$ | $0$ | {{field-4}} | {{field-5}} |  |  |\n|  |  | $0$ | $0$ | $0$ | {{field-6}} |  |" 13194139534206 17592186045417 true] [17592186414005 1072 #uuid "7819c8fe-793f-5300-ba05-a00d3d72cc5c" 13194139534206 17592186045417 true] [17592186414005 1074 "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=[\\begin{aligned}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{aligned}].\n$$\n\nFirst, note that\n\n$$\n\\begin{aligned}{e}^{({J}_{1}(3)\\,⊕\\,{J}_{3}(0))} & ={e}^{([\\begin{aligned}{J}_{1}(3) & 0 \\\\ 0 & {J}_{3}(0)\\end{aligned}])} \\\\  & =[\\begin{aligned}{e}^{({J}_{1}(3))} & 0 \\\\ 0 & {e}^{({J}_{3}(0))}\\end{aligned}] \\\\  & ={e}^{({J}_{1}(3))}\\,⊕\\,{e}^{({J}_{3}(0))}.\\end{aligned}\n$$\n\nSo, we compute the function of each Jordan block separately.\n\n- For ${J}_{1}(3),$ we have $n=1$ and $\\lambda =3.$ since $n=1,$ we don't need any derivatives. So, we get\n\n$$\n\\begin{aligned}f({J}_{1}(3)) & =[\\begin{aligned}f(3)\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{3}\\end{aligned}] \\\\ .\\end{aligned}\n$$\n\n- For ${J}_{3}(0),$ we have $n=3$ and $\\lambda =2.$ \\since $n=3,$ we need to compute the first and second derivatives of $f$ only:\n\n$$\n\\begin{aligned}f(x) & ={e}^{x} \\\\ {f}^{′}(x) & ={e}^{x} \\\\ {f}^{″}(x) & ={e}^{x}\\end{aligned}\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}f({J}_{3}(0)) & =[\\begin{aligned}f(0) & {f}^{′}(0) & \\frac{{f}^{″}(0)}{2} \\\\ 0 & f(0) & {f}^{′}(0) \\\\ 0 & 0 & f(0)\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{0} & {e}^{0} & \\frac{{e}^{0}}{2} \\\\ 0 & {e}^{0} & {e}^{0} \\\\ 0 & 0 & {e}^{0}\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 & \\frac{1}{2} \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}{e}^{({J}_{1}(3)\\,⊕\\,{J}_{3}(0))} & ={e}^{({J}_{1}(3))}\\,⊕\\,{e}^{({J}_{3}(0))} \\\\  & =[\\begin{aligned}{e}^{3} & 0 & 0 & 0 \\\\ 0 & 1 & 1 & \\frac{1}{2} \\\\ 0 & 0 & 1 & 1 \\\\ 0 & 0 & 0 & 1\\end{aligned}].\\end{aligned}\n$$" 13194139534206 17592186045417 true] [17592186414006 1068 #edb/ref 17592186413983 13194139534206 17592186045417 true] [17592186414006 1068 #edb/ref 17592186413987 13194139534206 17592186045417 true] [17592186414006 1068 #edb/ref 17592186413989 13194139534206 17592186045417 true] [17592186414006 1068 #edb/ref 17592186413990 13194139534206 17592186045417 true] [17592186414006 1068 #edb/ref 17592186413994 13194139534206 17592186045417 true] [17592186414006 1068 #edb/ref 17592186413998 13194139534206 17592186045417 true] [17592186414006 1069 "q-253391" 13194139534206 17592186045417 true] [17592186414006 1070 #edb/ref 17592186045487 13194139534206 17592186045417 true] [17592186414006 1071 "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jor