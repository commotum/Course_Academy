#{[{:db/id #edb/ref 17592186068478 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068692 :knowledge-point/id #uuid "8f2df46b-730d-54d0-9cfa-3636a3d37839" :knowledge-point/title "Finding a Point-Slope Equation Given a Slope and a Point"}] :question/id #uuid "ccc054b8-db6c-5726-bb60-a744467a9f6d" :question/math-academy-id "e-13974" :question/problem "Find, in point-slope form, the equation of the line that passes through the point $(6,2)$ and has a slope of $4.$" :question/worked-solution "Using $m=4$ and $(x_1,y_1) = (6,2)$, we substitute into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =4(x-6)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068479 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068693 :knowledge-point/id #uuid "ef428368-9b55-5bbb-94ef-99e503ca9868" :knowledge-point/title "Finding a Point-Slope Equation Given Two Points"}] :question/id #uuid "2b89eb42-8f10-57e8-aaa1-db4a2854c93e" :question/math-academy-id "e-13975" :question/problem "Find, in point-slope form, the equation of the straight line that passes through the points $(5,7)$ and $(1,-1).$" :question/worked-solution "We know that the line passes through the point $(5,7),$ so we can use $(x_1,y_1) = (5,7)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-1-7}{1-5}=\\frac{-8}{-4}=2\\end{aligned}\n$$\n\nThen, we substitute $m=2$ and the point $(x_1,y_1) = (5,7)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-7 & =2(x-5)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068480 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068694 :knowledge-point/id #uuid "1a620c55-6fa6-52db-92c6-231f631c0b45" :knowledge-point/title "Finding a Slope-Intercept Form Using Point-Slope Form"}] :question/id #uuid "88378710-e983-5b10-b56b-40397480e460" :question/math-academy-id "e-13978" :question/problem "Calculate the equation of the straight line that passes through the points $(1,10)$ and $(3,-2),$ giving your final answer in slope-intercept form." :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-2-10}{3-1}=\\frac{-12}{2}=-6\\end{aligned}\n$$\n\nThen, we substitute $m=-6$ and the point $(x_1,y_1) = (1,10)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-10 & =-6(x-1)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y-10 & =-6(x-1) \\\\ y-10 & =-6x+6 \\\\ y & =-6x+16\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492871 :knowledge-point/_questions [{:db/id #edb/ref 17592186068694 :knowledge-point/id #uuid "1a620c55-6fa6-52db-92c6-231f631c0b45" :knowledge-point/title "Finding a Slope-Intercept Form Using Point-Slope Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4822ab40-7aab-5223-856b-eb74b6098f13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3" :db/id #edb/ref 17592186492361}] :answer-field/correct {:answer/id #uuid "4822ab40-7aab-5223-856b-eb74b6098f13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3" :db/id #edb/ref 17592186492361} :answer-field/id #uuid "79f5ca2c-25ad-5180-8b08-53622da5ba2f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492756}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72696385-5600-5d16-af0f-e8ec844daceb" :question/math-academy-id "q-208825" :question/problem "Find the equation of the line that passes through the points $(3,9)$ and $(-1,1)$ in slope-intercept form.\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{1-9}{-1-3}=\\frac{(-8)}{(-4)}=2\\end{aligned}\n$$\n\nThen, we substitute $m=2$ and the point $({x}_{1},{y}_{1})=(3,9)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-9 & =2(x-3)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y-9 & =2(x-3) \\\\ y-9 & =2x-6 \\\\ y & =2x+3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492841 :knowledge-point/_questions [{:db/id #edb/ref 17592186068692 :knowledge-point/id #uuid "8f2df46b-730d-54d0-9cfa-3636a3d37839" :knowledge-point/title "Finding a Point-Slope Equation Given a Slope and a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8116f4e8-14e9-5f1c-a37c-21d6f929f8f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-3" :db/id #edb/ref 17592186492476}] :answer-field/correct {:answer/id #uuid "8116f4e8-14e9-5f1c-a37c-21d6f929f8f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-3" :db/id #edb/ref 17592186492476} :answer-field/id #uuid "30f97c15-7c68-532d-aeb9-524efc0ab12f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492722} {:answer-field/choices [{:answer/id #uuid "6eb023c9-16ed-5e01-b4fe-378dfdd4fb8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-1" :db/id #edb/ref 17592186492434}] :answer-field/correct {:answer/id #uuid "6eb023c9-16ed-5e01-b4fe-378dfdd4fb8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-1" :db/id #edb/ref 17592186492434} :answer-field/id #uuid "68e3aa4d-9327-58f5-a649-20e99f40125b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492749} {:answer-field/choices [{:answer/id #uuid "ef6c5902-abd0-5239-9d09-72a16038bf04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186492681}] :answer-field/correct {:answer/id #uuid "ef6c5902-abd0-5239-9d09-72a16038bf04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186492681} :answer-field/id #uuid "d6845079-35a3-54db-a5c8-1c838df2412d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492792}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22f6fedf-943a-57f1-98a3-a82b2489035f" :question/math-academy-id "q-214702" :question/problem "Express the equation of the line that passes through the point $(1,3)$ and has a slope of $\\frac{1}{2}$ in point-slope form.\n\n{{field-1}}\n$=$\n{{field-2}}\n$($\n{{field-3}}\n$)$" :question/worked-solution "Using $m=\\frac{1}{2}$ and $({x}_{1},{y}_{1})=(1,3)$, we substitute into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =\\frac{1}{2}(x-1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492835 :knowledge-point/_questions [{:db/id #edb/ref 17592186068694 :knowledge-point/id #uuid "1a620c55-6fa6-52db-92c6-231f631c0b45" :knowledge-point/title "Finding a Slope-Intercept Form Using Point-Slope Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d1ce7d2-544c-50a9-85bf-fd974a0a3b42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+2" :db/id #edb/ref 17592186492431}] :answer-field/correct {:answer/id #uuid "6d1ce7d2-544c-50a9-85bf-fd974a0a3b42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x+2" :db/id #edb/ref 17592186492431} :answer-field/id #uuid "465d1bc4-47b8-5cbb-b52f-bea13086b22b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492732}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1abe194d-a2aa-502b-8bc6-8f34c848d468" :question/math-academy-id "q-214728" :question/problem "Find the equation of the line that passes through the points $(-1,-2)$ and $(1,6)$ in slope-intercept form.\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{6-(-2)}{1-(-1)}=\\frac{8}{2}=4\\end{aligned}\n$$\n\nThen, we substitute $m=4$ and the point $({x}_{1},{y}_{1})=(-1,-2)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-2) & =4(x-(-1)) \\\\ y+2 & =4(x+1)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y+2 & =4(x+1) \\\\ y+2 & =4x+4 \\\\ y & =4x+2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492886 :knowledge-point/_questions [{:db/id #edb/ref 17592186068694 :knowledge-point/id #uuid "1a620c55-6fa6-52db-92c6-231f631c0b45" :knowledge-point/title "Finding a Slope-Intercept Form Using Point-Slope Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "207dcff7-2a4a-5821-bc2b-8c5f4d988663" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x+1" :db/id #edb/ref 17592186492281}] :answer-field/correct {:answer/id #uuid "207dcff7-2a4a-5821-bc2b-8c5f4d988663" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x+1" :db/id #edb/ref 17592186492281} :answer-field/id #uuid "68338326-c1a2-58f1-99c1-2c91100253f4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186492748}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "99417d8d-1f43-5c3e-b523-0e838b0c9470" :question/math-academy-id "q-214816" :question/problem "Find the equation of the line that passes through the points $(-1,3)$ and $(1,-1)$ in slope-intercept form.\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-1-3}{1-(-1)}=\\frac{-4}{2}=-2\\end{aligned}\n$$\n\nThen, we substitute $m=-2$ and the point $({x}_{1},{y}_{1})=(-1,3)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =-2(x-(-1)) \\\\ y-3 & =-2(x+1)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y-3 & =-2(x+1) \\\\ y-3 & =-2x-2 \\\\ y & =-2x+1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492881 :knowledge-point/_questions [{:db/id #edb/ref 17592186068693 :knowledge-point/id #uuid "ef428368-9b55-5bbb-94ef-99e503ca9868" :knowledge-point/title "Finding a Point-Slope Equation Given Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e6ea26b-1620-506e-bb8e-3fda206f1449" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-5=-2(x-2)" :db/id #edb/ref 17592186492241} {:answer/id #uuid "7b75104e-005a-541c-b769-3dda605403b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+5=2(x-2)" :db/id #edb/ref 17592186492466} {:answer/id #uuid "d66fd6b4-e28d-5784-baa5-fca15655be5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+5=\\frac{1}{2}(x-2)" :db/id #edb/ref 17592186492639} {:answer/id #uuid "ec9e1392-f368-5bc7-8108-b97f862345cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-5=\\frac{1}{2}(x-2)" :db/id #edb/ref 17592186492674} {:answer/id #uuid "f2207d9b-0a70-5ef2-a0b8-1cd6b58fd059" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+5=\\frac{1}{2}(x+2)" :db/id #edb/ref 17592186492686}] :answer-field/correct {:answer/id #uuid "d66fd6b4-e28d-5784-baa5-fca15655be5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+5=\\frac{1}{2}(x-2)" :db/id #edb/ref 17592186492639} :answer-field/id #uuid "fb692d57-2d39-5d74-a61f-7f4cc771ea13" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492815}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "807e0d45-6dda-516b-87e0-9ddf87246055" :question/math-academy-id "q-44463" :question/problem "Find, in point-slope form, the equation of the line that passes through the points $(2,-5)$ and $(6,-3).$" :question/worked-solution "We know that the line passes through the point $(2,-5),$ so we can use $({x}_{1},{y}_{1})=(2,-5)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-3-(-5)}{6-2}=\\frac{2}{4}=\\frac{1}{2}\\end{aligned}\n$$\n\nThen, we substitute $m=\\frac{1}{2}$ and the point $({x}_{1},{y}_{1})=(2,-5)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-5) & =\\frac{1}{2}(x-2) \\\\ y+5 & =\\frac{1}{2}(x-2)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492910 :knowledge-point/_questions [{:db/id #edb/ref 17592186068693 :knowledge-point/id #uuid "ef428368-9b55-5bbb-94ef-99e503ca9868" :knowledge-point/title "Finding a Point-Slope Equation Given Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2af5e56e-dd60-5295-bbdc-ea33774de19d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+4=\\frac{1}{2}(x+2)" :db/id #edb/ref 17592186492306} {:answer/id #uuid "4ceb533f-d98f-5ba8-901e-52501b69f81e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-4=2(x-2)" :db/id #edb/ref 17592186492367} {:answer/id #uuid "78ceb82d-738e-51f3-8560-fbab85c41b03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+4=2(x-2)" :db/id #edb/ref 17592186492462} {:answer/id #uuid "89349cd9-2d01-5801-881b-4b8665f79568" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-4=2(x+2)" :db/id #edb/ref 17592186492489} {:answer/id #uuid "a8370bac-b18e-58bb-bdc0-a9192adef58b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-4=\\frac{1}{2}(x-2)" :db/id #edb/ref 17592186492557}] :answer-field/correct {:answer/id #uuid "4ceb533f-d98f-5ba8-901e-52501b69f81e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-4=2(x-2)" :db/id #edb/ref 17592186492367} :answer-field/id #uuid "6f6ab974-76c4-5ee1-ae20-e92ccae5d914" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492751}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1c536e5-efa9-5d3b-97fb-617b507bd5a1" :question/math-academy-id "q-51960" :question/problem "Find, in point-slope form, the equation of the line that passes through the points $(2,4)$  and $(-4,-8).$" :question/worked-solution "We know that the line passes through the point $(2,4),$ so we can use $({x}_{1},{y}_{1})=(2,4)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{(-8)-4}{(-4)-2}=\\frac{-12}{-6}=2\\end{aligned}\n$$\n\nThen, we substitute $m=2$ and the point $({x}_{1},{y}_{1})=(2,4)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =2(x-2)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492895 :knowledge-point/_questions [{:db/id #edb/ref 17592186068692 :knowledge-point/id #uuid "8f2df46b-730d-54d0-9cfa-3636a3d37839" :knowledge-point/title "Finding a Point-Slope Equation Given a Slope and a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0458a806-d323-507f-807a-cce564610d05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+4=-\\frac{1}{4}(x+1)" :db/id #edb/ref 17592186492229} {:answer/id #uuid "05bbc6f9-a71c-5303-9ba1-9c860d133578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-1=-\\frac{1}{4}(x-4)" :db/id #edb/ref 17592186492231} {:answer/id #uuid "08a0ca07-73cb-561b-8f5e-683dd37e9382" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-4=-\\frac{1}{4}(x-1)" :db/id #edb/ref 17592186492234} {:answer/id #uuid "6567783f-5eab-5328-8904-c78c51b589db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y+1=-\\frac{1}{4}(x-4)" :db/id #edb/ref 17592186492421} {:answer/id #uuid "c4c9f024-7fde-5e78-b5ca-f49613465c11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-1=-\\frac{1}{4}(x+4)" :db/id #edb/ref 17592186492610}] :answer-field/correct {:answer/id #uuid "05bbc6f9-a71c-5303-9ba1-9c860d133578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y-1=-\\frac{1}{4}(x-4)" :db/id #edb/ref 17592186492231} :answer-field/id #uuid "5e4f85ec-f4fb-5149-aa50-068f9762a5c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492743}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "af8f01ea-2536-5ff7-99ba-8a19dc049226" :question/math-academy-id "q-51970" :question/problem "Find, in point-slope form, the equation of the line that passes through the point $(4,1)$ and has a slope of $-\\frac{1}{4}.$" :question/worked-solution "Using $m=-\\frac{1}{4}$ and $({x}_{1},{y}_{1})=(4,1)$, we substitute into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-\\frac{1}{4}(x-4)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069484 :knowledge-point/_questions [{:db/id #edb/ref 17592186068694 :knowledge-point/id #uuid "1a620c55-6fa6-52db-92c6-231f631c0b45" :knowledge-point/title "Finding a Slope-Intercept Form Using Point-Slope Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1be9dfca-ad6d-55f8-a27a-c47fc7dba344" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x" :db/id #edb/ref 17592186492270} {:answer/id #uuid "22e3c124-d858-516c-bd1f-73e8c8a29884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4x+2" :db/id #edb/ref 17592186492287} {:answer/id #uuid "2ba31689-999b-5f9d-83d9-0bdce6160dc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x+8" :db/id #edb/ref 17592186492309} {:answer/id #uuid "47a03e36-983a-5144-8158-42c2893f5e42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x-8" :db/id #edb/ref 17592186492359} {:answer/id #uuid "a7622c0b-7c82-500c-b2dc-311ab63b4b53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x+16" :db/id #edb/ref 17592186492556}] :answer-field/correct {:answer/id #uuid "1be9dfca-ad6d-55f8-a27a-c47fc7dba344" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x" :db/id #edb/ref 17592186492270} :answer-field/id #uuid "22439fee-f6e5-5fd3-b676-1a8dd4562c4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186068074}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3333f873-769f-586f-9340-f6ae5e456df2" :question/math-academy-id "q-6903" :question/problem "Calculate the equation of the line that passes through the points $(2,8)$ and $(3,12).$" :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{12-8}{3-2}=\\frac{4}{1}=4\\end{aligned}\n$$\n\nThen, we substitute $m=4$ and the point $({x}_{1},{y}_{1})=(2,8)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-8 & =4(x-2)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y-8 & =4(x-2) \\\\ y-8 & =4x-8 \\\\ y & =4x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492843 :knowledge-point/_questions [{:db/id #edb/ref 17592186068694 :knowledge-point/id #uuid "1a620c55-6fa6-52db-92c6-231f631c0b45" :knowledge-point/title "Finding a Slope-Intercept Form Using Point-Slope Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1efc3ce2-0a63-5cfb-8835-3f5803d08c8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x-6" :db/id #edb/ref 17592186492279} {:answer/id #uuid "231007f9-fa46-5595-92f6-2753afa91277" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x-6" :db/id #edb/ref 17592186492288} {:answer/id #uuid "6069335e-9e96-5a4b-bd51-aa204023de51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x-10" :db/id #edb/ref 17592186492411} {:answer/id #uuid "77b71fe4-fa6b-54a9-9d1e-27398fe4f01d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x-8" :db/id #edb/ref 17592186492459} {:answer/id #uuid "cfd4de3e-f16e-587b-8fff-834db60b6152" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x+8" :db/id #edb/ref 17592186492630}] :answer-field/correct {:answer/id #uuid "6069335e-9e96-5a4b-bd51-aa204023de51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x-10" :db/id #edb/ref 17592186492411} :answer-field/id #uuid "5de665dd-f29e-539e-8a46-95e8ce6236b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492741}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2e072874-ed7d-544d-b970-83b9972e3853" :question/math-academy-id "q-6961" :question/problem "Calculate the equation of the line that passes through the points $(4,-8)$ and $(8,-6).$" :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-6-(-8)}{8-4}=\\frac{2}{4}=\\frac{1}{2}\\end{aligned}\n$$\n\nThen, we substitute $m=\\frac{1}{2}$ and the point $({x}_{1},{y}_{1})=(4,-8)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-8) & =\\frac{1}{2}(x-4) \\\\ y+8 & =\\frac{1}{2}(x-4)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y+8 & =\\frac{1}{2}(x-4) \\\\ y & =\\frac{1}{2}x-2-8 \\\\ y & =\\frac{1}{2}x-10\\end{aligned}\n$$"}]}
