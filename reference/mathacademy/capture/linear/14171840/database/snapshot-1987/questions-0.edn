#{[{:db/id #edb/ref 17592186068478 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068692 :knowledge-point/id #uuid "8f2df46b-730d-54d0-9cfa-3636a3d37839" :knowledge-point/title "Finding a Point-Slope Equation Given a Slope and a Point"}] :question/id #uuid "ccc054b8-db6c-5726-bb60-a744467a9f6d" :question/math-academy-id "e-13974" :question/problem "Find, in point-slope form, the equation of the line that passes through the point $(6,2)$ and has a slope of $4$." :question/worked-solution "Using $m=4$ and\n\n$$\n(x_1,y_1) = (6,2)\n$$\n\n, we substitute into the point-slope formula:\n\n$$\n\\begin{aligned}\ny - y_{1} &= m(x - x_{1}) \\\\\ny - 2 &= 4(x - 6)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068479 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068693 :knowledge-point/id #uuid "ef428368-9b55-5bbb-94ef-99e503ca9868" :knowledge-point/title "Finding a Point-Slope Equation Given Two Points"}] :question/id #uuid "2b89eb42-8f10-57e8-aaa1-db4a2854c93e" :question/math-academy-id "e-13975" :question/problem "Find, in point-slope form, the equation of the straight line that passes through the points $(5,7)$ and $(1,-1)$." :question/worked-solution "We know that the line passes through the point $(5,7)$, so we can use\n\n$$\n(x_1,y_1) = (5,7)\n$$\n\nin our point-slope formula. All that remains is to compute $m$, and we can do this using the given points:\n\n$$\nm = \\frac{y_{2} - y_{1}}{x_{2} - x_{1}} = \\frac{-1 - 7}{1 - 5} = \\frac{-8}{-4} = 2\n$$\n\nThen, we substitute $m=2$ and the point\n\n$$\n(x_1,y_1) = (5,7)\n$$\n\ninto the point-slope formula:\n\n$$\n\\begin{aligned}\ny - y_{1} &= m(x - x_{1}) \\\\\ny - 7 &= 2(x - 5)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068480 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068694 :knowledge-point/id #uuid "1a620c55-6fa6-52db-92c6-231f631c0b45" :knowledge-point/title "Finding a Slope-Intercept Form Using Point-Slope Form"}] :question/id #uuid "88378710-e983-5b10-b56b-40397480e460" :question/math-academy-id "e-13978" :question/problem "Calculate the equation of the straight line that passes through the points $(1,10)$ and $(3,-2)$, giving your final answer in slope-intercept form." :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\nm = \\frac{y_{2} - y_{1}}{x_{2} - x_{1}} = \\frac{-2 - 10}{3 - 1} = \\frac{-12}{2} =-6\n$$\n\nThen, we substitute $m=-6$ and the point\n\n$$\n(x_1,y_1) = (1,10)\n$$\n\ninto the point-slope formula:\n\n$$\n\\begin{aligned}\ny - y_{1} &= m(x - x_{1}) \\\\\ny - 10 &= -6(x - 1)\n\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}\ny - 10 &= -6(x - 1) \\\\\ny - 10 &= -6x + 6 \\\\\ny &= -6x + 16\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069484 :knowledge-point/_questions [{:db/id #edb/ref 17592186068694 :knowledge-point/id #uuid "1a620c55-6fa6-52db-92c6-231f631c0b45" :knowledge-point/title "Finding a Slope-Intercept Form Using Point-Slope Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a311d29b-368d-57f2-8d7b-0fd5bd14f34d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y =-4x + 2" :db/id #edb/ref 17592186068075} {:answer/id #uuid "e62082ba-7fbe-53d8-8a7b-e2dfff590148" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 4x + 8" :db/id #edb/ref 17592186068076} {:answer/id #uuid "3a2e2116-cdf9-5413-af47-7bf7b7649a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 4x + 16" :db/id #edb/ref 17592186068077} {:answer/id #uuid "3d1fd861-7ddb-52b2-9172-e3cb298c0be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 4x - 8" :db/id #edb/ref 17592186068078} {:answer/id #uuid "4015e910-1a0d-5f6b-bb04-35b504c15acf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 4x" :db/id #edb/ref 17592186068079}] :answer-field/id #uuid "22439fee-f6e5-5fd3-b676-1a8dd4562c4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186068074}] :question/id #uuid "3333f873-769f-586f-9340-f6ae5e456df2" :question/math-academy-id "q-6903" :question/problem "Calculate the equation of the line that passes through the points $(2, 8)$ and $(3, 12)$."}]}
