B{H}^{2}} \\\\  & =\\sqrt{{30}^{2}+{20}^{2}} \\\\  & =\\sqrt{1\\,300} \\\\  & =10\\sqrt{13}\\,\\text{mm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-17441dbe-6903-5e53-bc8a-41e64fe4b46d"] :db/ensure [:question/validate]} {:db/id "answer-field-17441dbe-6903-5e53-bc8a-41e64fe4b46d" :answer-field/id #uuid "17441dbe-6903-5e53-bc8a-41e64fe4b46d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1b371911-bbad-59a4-a192-de4fbe2c032e" :answer-field/choices ["answer-1b371911-bbad-59a4-a192-de4fbe2c032e" "answer-cd1104ea-933b-5ad2-b216-bcff58d29534" "answer-d30b7b97-b363-5da7-90da-205bd7013318" "answer-6e86868b-8f86-560f-ad61-ab7f7b2f1b12" "answer-4d190923-3c5e-5440-913a-9e45d38e8136"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b371911-bbad-59a4-a192-de4fbe2c032e" :answer/id #uuid "1b371911-bbad-59a4-a192-de4fbe2c032e" :answer/type :answer.type/math :answer/value "10\\sqrt{13}\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-cd1104ea-933b-5ad2-b216-bcff58d29534" :answer/id #uuid "cd1104ea-933b-5ad2-b216-bcff58d29534" :answer/type :answer.type/math :answer/value "50\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-d30b7b97-b363-5da7-90da-205bd7013318" :answer/id #uuid "d30b7b97-b363-5da7-90da-205bd7013318" :answer/type :answer.type/math :answer/value "5\\sqrt{17}\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-6e86868b-8f86-560f-ad61-ab7f7b2f1b12" :answer/id #uuid "6e86868b-8f86-560f-ad61-ab7f7b2f1b12" :answer/type :answer.type/math :answer/value "5\\sqrt{2}\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-4d190923-3c5e-5440-913a-9e45d38e8136" :answer/id #uuid "4d190923-3c5e-5440-913a-9e45d38e8136" :answer/type :answer.type/math :answer/value "6\\sqrt{19}\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "activity-cb643399-c9f1-5f69-aaa9-f0f416dc44e9" :activity/id #uuid "cb643399-c9f1-5f69-aaa9-f0