#{[{:db/id #edb/ref 17592186575556 :knowledge-point/_questions [{:db/id #edb/ref 17592186096690 :knowledge-point/id #uuid "4e0146b8-421b-5d63-a933-3de9bcaa7ab2" :knowledge-point/title "Identifying the Magnitude of a Vector From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04492ea7-d25b-56ea-ae0e-47957b737f4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{2}\\,\\text{mm}" :db/id #edb/ref 17592186574959} {:answer/id #uuid "6bcce013-cdbc-58c4-a357-a196757423be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{10}\\,\\text{mm}" :db/id #edb/ref 17592186575143} {:answer/id #uuid "b095cbfc-1472-52b1-804b-05c032bb0e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\sqrt{2}\\,\\text{mm}" :db/id #edb/ref 17592186575264} {:answer/id #uuid "ba28057b-647d-5124-b1a6-35e530999312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{25}\\,\\text{mm}" :db/id #edb/ref 17592186575280} {:answer/id #uuid "bcd0818b-9462-55a1-9ed5-46fc015e79ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\,\\text{mm}" :db/id #edb/ref 17592186575288}] :answer-field/correct {:answer/id #uuid "b095cbfc-1472-52b1-804b-05c032bb0e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\sqrt{2}\\,\\text{mm}" :db/id #edb/ref 17592186575264} :answer-field/id #uuid "87ff2314-8fb7-54d5-87c5-d6b7e1e45b40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575469}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6aaad334-a3c0-5643-a528-243af5b47439" :question/math-academy-id "q-118915" :question/problem "![](images/de/de4864b00e5b51431ef019a930c3980e33c0f47812c9ee09743934128a72644b.png)\n\nConsider the picture shown above. Find $|a|.$" :question/worked-solution "![](images/ab/ab521b7fc8b594fa7a8a97cf1b2dc57884d50d7941f0e6f7f6d56d3179d3c7a3.png)\n\nIn $△AHB$ we have $∠AHB={90}^{∘}$, $AH=25\\,\\text{mm}$ and $BH=25\\,\\text{mm}.$ So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}AB & =\\sqrt{A{H}^{2}+B{H}^{2}} \\\\  & =\\sqrt{{25}^{2}+{25}^{2}} \\\\  & =\\sqrt{2\\cdot {25}^{2}} \\\\  & =25\\sqrt{2}\\,\\text{mm}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575525 :knowledge-point/_questions [{:db/id #edb/ref 17592186096690 :knowledge-point/id #uuid "4e0146b8-421b-5d63-a933-3de9bcaa7ab2" :knowledge-point/title "Identifying the Magnitude of a Vector From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b371911-bbad-59a4-a192-de4fbe2c032e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\sqrt{13}\\,\\text{mm}" :db/id #edb/ref 17592186574992} {:answer/id #uuid "4d190923-3c5e-5440-913a-9e45d38e8136" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{19}\\,\\text{mm}" :db/id #edb/ref 17592186575081} {:answer/id #uuid "6e86868b-8f86-560f-ad61-ab7f7b2f1b12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{2}\\,\\text{mm}" :db/id #edb/ref 17592186575149} {:answer/id #uuid "cd1104ea-933b-5ad2-b216-bcff58d29534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50\\,\\text{mm}" :db/id #edb/ref 17592186575313} {:answer/id #uuid "d30b7b97-b363-5da7-90da-205bd7013318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{17}\\,\\text{mm}" :db/id #edb/ref 17592186575322}] :answer-field/correct {:answer/id #uuid "1b371911-bbad-59a4-a192-de4fbe2c032e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\sqrt{13}\\,\\text{mm}" :db/id #edb/ref 17592186574992} :answer-field/id #uuid "17441dbe-6903-5e53-bc8a-41e64fe4b46d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575417}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "009a4381-6aca-5a6f-b010-2dbc7da60371" :question/math-academy-id "q-118921" :question/problem "![](images/7b/7b676396ae24fe47c832e4442b67a9ba66128eff11a8c08f7570704c0a16eeb7.png)\n\nConsider the picture shown above. Find $|a+b|.$" :question/worked-solution "We use the triangle law of addition for $a$ and $b.$ We can start $a$ from an arbitrary point on the plane. The resultant goes from the start of $a$ to the head of $b.$\n\n![](images/87/87a40729c97eddcba2820dc083002aad9ee4d05d7e9e654bcf51d8410a2e4861.png)\n\nNow, in $△AHB$ we have $∠AHB={90}^{∘}$, $AH=30\\,\\text{mm}$ and $BH=20\\,\\text{mm}.$ So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}|a+b| & =AB \\\\  & =\\sqrt{A{H}^{2}+B{H}^{2}} \\\\  & =\\sqrt{{30}^{2}+{20}^{2}} \\\\  & =\\sqrt{1\\,300} \\\\  & =10\\sqrt{13}\\,\\text{mm}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186575531 :knowledge-point/_questions [{:db/id #edb/ref 17592186096690 :knowledge-point/id #uuid "4e0146b8-421b-5d63-a933-3de9bcaa7ab2" :knowledge-point/title "Identifying the Magnitude of a Vector From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1206f0b9-be3a-5159-98e0-da77b6c0445a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{41}\\,\\text{mm}" :db/id #edb/ref 17592186574979} {:answer/id #uuid "2ecb5427-5ac5-59b1-94a2-f82f393f874e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{13}\\,\\text{mm}" :db/id #edb/ref 17592186575026} {:answer/id #uuid "432d23e6-e40e-5e8a-a566-7d880e136d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\sqrt{2}\\,\\text{mm}" :db/id #edb/ref 17592186575067} {:answer/id #uuid "5d0fa895-1079-53e7-945b-0a3924af1dff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\sqrt{2}\\,\\text{mm}" :db/id #edb/ref 17592186575114} {:answer/id #uuid "e3afd05d-c063-5ddb-abee-56e9a09c27ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\,\\text{mm}" :db/id #edb/ref 17592186575352}] :answer-field/correct {:answer/id #uuid "1206f0b9-be3a-5159-98e0-da77b6c0445a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\sqrt{41}\\,\\text{mm}" :db/id #edb/ref 17592186574979} :answer-field/id #uuid "c48d75c9-8417-5647-a9f6-2a5523919321" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575494}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1a2c5f5b-bc36-5bd5-afb2-0b0c9dcdd330" :question/math-academy-id "q-20202" :question/problem "![](images/86/868b0274063a19084dac216568a9ed3cebedcc82d967ed6d89ce62f96d38c336.png)\n\nConsider the picture shown above. Find $|a|.$" :question/worked-solution "![](images/a0/a051a9158e8147415b605fee37aef3ef4862281da1c2a0387fd40aa99bddee49.png)\n\nIn $△AHB$ we have $∠AHB={90}^{∘}$, $AH=20\\,\\text{mm}$ and $BH=25\\,\\text{mm}.$ So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}AB & =\\sqrt{A{H}^{2}+B{H}^{2}} \\\\  & =\\sqrt{{20}^{2}+{25}^{2}} \\\\  & =\\sqrt{1\\,025} \\\\  & =5\\sqrt{41}\\,\\text{mm}.\\end{aligned}\n$$"}]}
