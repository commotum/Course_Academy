b/ref 17592186045417] [17592186575417 #edb/ref 1079 #uuid "17441dbe-6903-5e53-bc8a-41e64fe4b46d" #edb/ref 17592186045417] [17592186575469 #edb/ref 1075 #edb/ref 17592186574959 #edb/ref 17592186045417] [17592186575469 #edb/ref 1075 #edb/ref 17592186575143 #edb/ref 17592186045417] [17592186575469 #edb/ref 1075 #edb/ref 17592186575264 #edb/ref 17592186045417] [17592186575469 #edb/ref 1075 #edb/ref 17592186575280 #edb/ref 17592186045417] [17592186575469 #edb/ref 1075 #edb/ref 17592186575288 #edb/ref 17592186045417] [17592186575469 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186575469 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186575469 #edb/ref 1078 #edb/ref 17592186575264 #edb/ref 17592186045417] [17592186575469 #edb/ref 1079 #uuid "87ff2314-8fb7-54d5-87c5-d6b7e1e45b40" #edb/ref 17592186045417] [17592186575494 #edb/ref 1075 #edb/ref 17592186574979 #edb/ref 17592186045417] [17592186575494 #edb/ref 1075 #edb/ref 17592186575026 #edb/ref 17592186045417] [17592186575494 #edb/ref 1075 #edb/ref 17592186575067 #edb/ref 17592186045417] [17592186575494 #edb/ref 1075 #edb/ref 17592186575114 #edb/ref 17592186045417] [17592186575494 #edb/ref 1075 #edb/ref 17592186575352 #edb/ref 17592186045417] [17592186575494 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186575494 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186575494 #edb/ref 1078 #edb/ref 17592186574979 #edb/ref 17592186045417] [17592186575494 #edb/ref 1079 #uuid "c48d75c9-8417-5647-a9f6-2a5523919321" #edb/ref 17592186045417] [17592186575525 #edb/ref 1068 #edb/ref 17592186575417 #edb/ref 17592186045417] [17592186575525 #edb/ref 1069 "q-118921" #edb/ref 17592186045417] [17592186575525 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186575525 #edb/ref 1071 "![](images/7b/7b676396ae24fe47c832e4442b67a9ba66128eff11a8c08f7570704c0a16eeb7.png)\n\nConsider the picture shown above. Find $|a+b|.$" #edb/ref 17592186045417] [17592186575525 #edb/ref 1072 #uuid "009a4381-6aca-5a6f-b010-2dbc7da60371" #edb/ref 17592186045417] [17592186575525 #edb/ref 1074 "We use the triangle law of addition for $a$ and $b.$ We can start $a$ from an arbitrary point on the plane. The resultant goes from the start of $a$ to the head of $b.$\n\n![](images/87/87a40729c97eddcba2820dc083002aad9ee4d05d7e9e654bcf51d8410a2e4861.png)\n\nNow, in $△AHB$ we have $∠AHB={90}^{∘}$, $AH=30\\,\\text{mm}$ and $BH=20\\,\\text{mm}.$ So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}|a+b| & =AB \\\\  & =\\sqrt{A{H}^{2}+B{H}^{2}} \\\\  & =\\sqrt{{30}^{2}+{20}^{2}} \\\\  & =\\sqrt{1\\,300} \\\\  & =10\\sqrt{13}\\,\\text{mm}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186575531 #edb/ref 1068 #edb/ref 17592186575494 #edb/ref 17592186045417] [17592186575531 #edb/ref 1069 "q-20202" #edb/ref 17592186045417] [17592186575531 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186575531 #edb/ref 1071 "![](images/86/868b0274063a19084dac216568a9ed3cebedcc82d967ed6d89ce62f96d38c336.png)\n\nConsider the picture shown above. Find $|a|.$" #edb/ref 17592186045417] [17592186575531 #edb/ref 1072 #uuid "1a2c5f5b-bc36-5bd5-afb2-0b0c9dcdd330" #edb/ref 17592186045417] [17592186575531 #edb/ref 1074 "![](images/a0/a051a9158e8147415b605fee37aef3ef4862281da1c2a0387fd40aa99bddee49.png)\n\nIn $△AHB$ we have $∠AHB={90}^{∘}$, $AH=20\\,\\text{mm}$ and $BH=25\\,\\text{mm}.$ So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}AB & =\\sqrt{A{H}^{2}+B{H}^{2}} \\\\  & =\\sqrt{{20}^{2}+{25}^{2}} \\\\  & =\\sqrt{1\\,025} \\\\  & =5\\sqrt{41}\\,\\text{mm}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186575556 #edb/ref 1068 #edb/ref 17592186575469 #edb/ref 17592186045417] [17592186575556 #edb/ref 1069 "q-118915" #edb/ref 17592186045417] [17592186575556 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186575556 #edb/ref 1071 "![](images/de/de4864b00e5b51431ef019a930c3980e33c0f47812c9ee09743934128a72644b.png)\n\nConsider the picture shown above. Find $|a|.$" #edb/ref 17592186045417] [17592186575556 #edb/ref 1072 #uuid "6aaad334-a3c0-5643-a528-243af5b47439" #edb/ref 17592186045417] [17592186575556 #edb/ref 1074 "![](images/ab/ab521b7fc8b594fa7a8a97cf1b2dc57884d50d7941f0e6f7f6d56d3179d3c7a3.png)\n\nIn $△AHB$ we have $∠AHB={90}^{∘}$, $AH=25\\,\\text{mm}$ and $BH=25\\,\\text{mm}.$ So, the Pythagorean theorem gives\n\n$$\n\\begin{aligned}AB & =\\sqrt{A{H}^{2}+B{H}^{2}} \\\\  & =\\sqrt{{25}^{2}+{25}^{2}} \\\\  & =\\sqrt{2\\cdot {25}^{2}} \\\\  & =25\\sqrt{2}\\,\\text{mm}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186575637 #edb/ref 1062 #uuid "1de77141-d944-56f2-a5e7-2f43def28347" #edb/ref 17592186045417] [17592186575637 #edb/ref 1063 #edb/ref 17592186575525 #edb/ref 17592186045417] [17592186575668 #edb/ref 1058 #edb/ref 17592186575681 #edb/ref 17592186045417] [17592186575668 #edb/ref 1062 #uuid "8c5c1ce5-8d99-5032-b6c2-6072a99ca917" #edb/ref 17592186045417] [17592186575668 #edb/ref 1063 #edb/ref 17592186575531 #edb/ref 17592186045417] [17592186575681 #edb/ref 1058 #edb/ref 17592186575637 #edb/ref 17592186045417] [17592186575681 #edb/ref 1062 #uuid "bd40e0b0-1d40-522a-981c-caef9e15c387" #edb/ref 17592186045417] [17592186575681 #edb/ref 1063 #edb/ref 17592186575556 #edb/ref 17592186045417]}
