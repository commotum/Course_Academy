:db/id #edb/ref 17592186348229}] :knowledge-point/title "Factoring a Polynomial With Multiple Variables as a Difference of Squares"} :step/id #uuid "9d98425c-5d03-51f7-9b8a-1b88b3cafa3d" :step/math-academy-id 18014}] :activity/title "Factoring Higher-Order Polynomials as a Difference of Squares" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078679}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186516901} :activity/id #uuid "46144c44-d687-5bae-90fd-5191deef0586" :activity/scope {:db/id #edb/ref 17592186050307 :topic/id #uuid "3e99290f-65b0-574f-9d45-f70ae6a291e2" :topic/math-academy-id 660} :activity/steps [{:db/id #edb/ref 17592186516901 :step/content {:db/id #edb/ref 17592186516868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e441f3c-74ea-5954-9b04-0b444ffa3de2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(4{s}^{2}+1)(2s+1)(2s-1)" :db/id #edb/ref 17592186516315} {:answer/id #uuid "61602e33-9240-55e5-ae67-6253734db54b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3({s}^{2}+1)(2s+1)(2s-1)" :db/id #edb/ref 17592186516324} {:answer/id #uuid "6aecb389-d54f-575d-8a85-3c0beb8b5f30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4{s}^{2}+1)(3s+1)(3s-1)" :db/id #edb/ref 17592186516345} {:answer/id #uuid "8b8538c7-1b01-599b-b150-a73270292e7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4{s}^{2}+1)(2s+1)(2s-1)" :db/id #edb/ref 17592186516402} {:answer/id #uuid "924d5c59-cd65-56c5-8b49-dc5a89011fa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(4{s}^{2}+1)(s+1)(s-1)" :db/id #edb/ref 17592186516418}] :answer-field/correct {:db/id #edb/ref 17592186516315} :answer-field/id #uuid "06afac61-4a09-516c-87cd-b89382f9efec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516651}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fb5ed83f-adbe-5177-b929-40e3c3c8ee7a" :question/math-academy-id "q-14126" :question/problem "Factor $48{s}^{4}-3$ completely." :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms have a common factor of $3.$ To simplify the computation, we can factor out the $3,$ as follows:\n\n$$\n48{s}^{4}-3=3\\cdot 16{s}^{4}-3\\cdot 1=3(16{s}^{4}-1)\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n3(16{s}^{4}-1)=3({(4{s}^{2})}^{2}-{1}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n3({(4{s}^{2})}^{2}-{1}^{2})=3(4{s}^{2}+1)(4{s}^{2}-1)\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}3(4{s}^{2}+1)(4{s}^{2}-1) & =3(4{s}^{2}+1)({(2s)}^{2}-{1}^{2}) \\\\  & =3(4{s}^{2}+1)(2s+1)(2s-1)\\end{aligned}\n$$"} :step/id #uuid "4a41bda9-95c5-593c-989d-c1491cb3adea" :step/next {:db/id #edb/ref 17592186516951}} {:db/id #edb/ref 17592186516951 :step/content {:db/id #edb/ref 17592186516798 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fbc1e55-9ff4-57db-a8d5-126770ed73c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4({z}^{2}-6)(z+9)" :db/id #edb/ref 17592186516361} {:answer/id #uuid "7e8855f8-54de-5296-8668-a577edca3ea7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({z}^{2}+9)(z+3)(z-3)" :db/id #edb/ref 17592186516380} {:answer/id #uuid "96436117-2f00-5b77-bdde-7a2e1ea0b5f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({z}^{2}+36)(z+3)(z-3)" :db/id #edb/ref 17592186516422} {:answer/id #uuid "a967a549-543c-5830-94ce-4a491fa889e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4({z}^{2}+36)(z+6)(z-6)" :db/id #edb/ref 17592186516466} {:answer/id #uuid "b4e023d2-5c4f-53c0-a51e-017f827fbd2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4({z}^{2}+9)(z+3)(z-3)" :db/id #edb/ref 17592186516488}] :answer-field/correct {:db/id #edb/ref 17592186516488} :answer-field/id #uuid "87c0e667-8c54-5839-81a6-2f3012b2915d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516716}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "47fb24d6-2403-53dd-8dbf-2b7132f71263" :question/math-academy-id "q-14131" :question/problem "Factor $4{z}^{4}-324$ completely." :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms have a common factor of $4.$ To simplify the computation, we can factor out the $4,$ as follows:\n\n$$\n4{z}^{4}-324=4\\cdot {z}^{4}-4\\cdot 81=4({z}^{4}-81)\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n4({z}^{4}-81)=4({({z}^{2})}^{2}-{9}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n4({({z}^{2})}^{2}-{9}^{2})=4({z}^{2}+9)({z}^{2}-9)\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}4({z}^{2}+9)({z}^{2}-9) & =4({z}^{2}+9)({z}^{2}-{3}^{2}) \\\\  & =4({z}^{2}+9)(z+3)(z-3)\\end{aligned}\n$$"} :step/id #uuid "b5c6c1ae-e998-5b44-ae1a-e0bdca81c356" :step/next {:db/id #edb/ref 17592186516959}} {:db/id #edb/ref 17592186516959 :step/content {:db/id #edb/ref 17592186516784 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26f80dbb-9c0a-50e9-af75-fd6ae25f77d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6(9+{x}^{2})(3-{x}^{2})" :db/id #edb/ref 17592186516189} {:answer/id #uuid "431be612-0a45-510a-bc8f-064d5eb3f4c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6(9+{x}^{2})(3+x)(3-x)" :db/id #edb/ref 17592186516245} {:answer/id #uuid "450499eb-16be-5929-9520-1f10e65a24ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9+{x}^{2})(3-{x}^{2})" :db/id #edb/ref 17592186516252} {:answer/id #uuid "8977d251-8b3b-5768-a493-f8eca8cc7e33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6(81+{x}^{4})" :db/id #edb/ref 17592186516399} {:answer/id #uuid "96da69d6-ce5d-553a-aa16-d9284a89737b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6(9+{x}^{2})(9+x)(9-x)" :db/id #edb/ref 17592186516424}] :answer-field/correct {:db/id #edb/ref 17592186516245} :answer-field/id #uuid "51b9c843-101e-597e-98f2-3448d699942e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516682}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1eed18c2-ffc9-58c2-a876-148bf6a4cade" :question/math-academy-id "q-14138" :question/problem "Factor $486-6{x}^{4}$ completely." :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms have a common factor of $6.$ To simplify the computation, we can factor out the $6,$ as follows:\n\n$$\n486-6{x}^{4}=6\\cdot 81-6\\cdot {x}^{4}=6(81-{x}^{4})\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n6(81-{x}^{4})=6({9}^{2}-{({x}^{2})}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n6({9}^{2}-{({x}^{2})}^{2})=6(9+{x}^{2})(9-{x}^{2})\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}6(9+{x}^{2})(9-{x}^{2}) & =6(9+{x}^{2})({3}^{2}-{x}^{2}) \\\\  & =6(9+{x}^{2})(3+x)(3-x)\\end{aligned}\n$$"} :step/id #uuid "c2abec83-36cb-5c3f-a653-14e58cea6968"}] :activity/title "Factoring Higher-Order Polynomials as a Difference of Squares" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516096}]}
