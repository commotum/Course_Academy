#{[{:db/id #edb/ref 17592186543534 :knowledge-point/_questions [{:db/id #edb/ref 17592186078458 :knowledge-point/id #uuid "a9bfd9e9-603e-50ae-8cd1-be79b88aa087" :knowledge-point/title "Factoring a Polynomial With Leading Coefficients as a Difference of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59ca59b3-bc66-5b41-a2e1-7c1ae9fe7294" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(9+{x}^{2})(3+x)(3-x)" :db/id #edb/ref 17592186542885} {:answer/id #uuid "6d2fa2a2-76fd-5930-ad81-eaacf5fc4cf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(9+x)(3+x)(3-x)" :db/id #edb/ref 17592186542931} {:answer/id #uuid "9564c43f-732c-5b28-875b-f898f59a8974" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(9+{x}^{2})(3-x)" :db/id #edb/ref 17592186543032} {:answer/id #uuid "9dda105c-aa70-5651-a006-68417da9eb64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9+{x}^{2})(3+x)(3-x)" :db/id #edb/ref 17592186543056} {:answer/id #uuid "f1000809-2185-56a5-bdfc-7e3b96b60d0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3+5{x}^{2})(3-5x)" :db/id #edb/ref 17592186543258}] :answer-field/correct {:answer/id #uuid "59ca59b3-bc66-5b41-a2e1-7c1ae9fe7294" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(9+{x}^{2})(3+x)(3-x)" :db/id #edb/ref 17592186542885} :answer-field/id #uuid "2a88efbc-787f-5fb5-83b1-796e67980740" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543318}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9d1054aa-9f73-56ea-a93c-1d65449f0f07" :question/math-academy-id "q-14136" :question/problem "Factor $405-5{x}^{4}$ completely." :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms in our expression have a common factor of $5.$ To simplify the computation, we can factor out the $5,$ as follows:\n\n$$\n405-5{x}^{4}=5\\cdot 81-5\\cdot {x}^{4}=5(81-{x}^{4})\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n5(81-{x}^{4})=5({9}^{2}-{({x}^{2})}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n5({9}^{2}-{({x}^{2})}^{2})=5(9+{x}^{2})(9-{x}^{2})\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}5(9+{x}^{2})(9-{x}^{2}) & =5(9+{x}^{2})({3}^{2}-{x}^{2}) \\\\  & =5(9+{x}^{2})(3+x)(3-x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186543579 :knowledge-point/_questions [{:db/id #edb/ref 17592186078459 :knowledge-point/id #uuid "fb183013-a42d-50a3-a1b8-cd8501781075" :knowledge-point/title "Factoring a Polynomial With Multiple Variables as a Difference of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1650bfee-6d96-54e8-852e-43b6f64d4dc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q(1+{p}^{2})(1+p)(1-p)" :db/id #edb/ref 17592186542694} {:answer/id #uuid "90af1bab-a6dd-5030-b070-2e84c0e4c42e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q(1+{p}^{2})(1+p)^{2}" :db/id #edb/ref 17592186543018} {:answer/id #uuid "b49a8467-4b46-5b5a-b841-8a75970290cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+{p}^{2})(q+p)(q-p)" :db/id #edb/ref 17592186543109} {:answer/id #uuid "cb74c517-de27-581f-addd-2aa201faca40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q(1+{p}^{2})(1-p)^{2}" :db/id #edb/ref 17592186543169} {:answer/id #uuid "df55db35-4751-5083-ab35-5e84e6e5d77b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(q+{p}^{2})(1+p)(1-p)" :db/id #edb/ref 17592186543209}] :answer-field/correct {:answer/id #uuid "1650bfee-6d96-54e8-852e-43b6f64d4dc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q(1+{p}^{2})(1+p)(1-p)" :db/id #edb/ref 17592186542694} :answer-field/id #uuid "b41f4802-1656-5ba5-847f-6205f19dba68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543425}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e8441a51-7883-5a5e-8db4-a90d1cf66e2c" :question/math-academy-id "q-37704" :question/problem "Factor the expression $q-q{p}^{4}.$" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms have a common factor of $q.$ To simplify the computation, we can factor out the $q,$ as follows:\n\n$$\nq-q{p}^{4}=q(1-{p}^{4})\n$$\n\nThe expression in parenthesis can be written as a difference of squares:\n\n$$\nq(1-{p}^{4})=q({1}^{2}-{({p}^{2})}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\nq({1}^{2}-{({p}^{2})}^{2})=q(1+{p}^{2})(1-{p}^{2})\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}q(1+{p}^{2})(1-{p}^{2}) & =q(1+{p}^{2})({1}^{2}-{p}^{2}) \\\\  & =q(1+{p}^{2})(1+p)(1-p)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186543580 :knowledge-point/_questions [{:db/id #edb/ref 17592186078458 :knowledge-point/id #uuid "a9bfd9e9-603e-50ae-8cd1-be79b88aa087" :knowledge-point/title "Factoring a Polynomial With Leading Coefficients as a Difference of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03b42502-8bb9-505b-a96e-7773c8d16207" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9({x}^{2}+1)(2x+1)(2x-1)" :db/id #edb/ref 17592186542650} {:answer/id #uuid "0d552ff0-06bd-50a5-91ff-6ffdaa4a9172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(9{x}^{2}+1)(3x+1)(3x-1)" :db/id #edb/ref 17592186542669} {:answer/id #uuid "4fe39158-c45c-5d07-8234-bb5aae85c535" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(9{x}^{2}+1)(x+1)(x-1)" :db/id #edb/ref 17592186542856} {:answer/id #uuid "93fefd61-c204-5b19-a4c2-00c6446d535d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9{x}^{2}+1)(3x+1)(3x-1)" :db/id #edb/ref 17592186543027} {:answer/id #uuid "c30ff4b0-ccfb-548c-9ce7-dea8ff9ce182" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(9{x}^{2}+1)(x+3)(x-3)" :db/id #edb/ref 17592186543152}] :answer-field/correct {:answer/id #uuid "0d552ff0-06bd-50a5-91ff-6ffdaa4a9172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(9{x}^{2}+1)(3x+1)(3x-1)" :db/id #edb/ref 17592186542669} :answer-field/id #uuid "b0587497-190f-5a43-9cd6-5471c683bb02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543421}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea6c80e5-0a00-5798-9872-7c227f663338" :question/math-academy-id "q-5158" :question/problem "Factor $162{x}^{4}-2.$" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms have a common factor of $2.$ To simplify the computation, we can factor out the $2,$ as follows:\n\n$$\n162{x}^{4}-2=2\\cdot 81{x}^{4}-2\\cdot 1=2(81{x}^{4}-1)\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n2(81{x}^{4}-1)=2({(9{x}^{2})}^{2}-{1}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n2({(9{x}^{2})}^{2}-{1}^{2})=2(9{x}^{2}+1)(9{x}^{2}-1)\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}2(9{x}^{2}+1)(9{x}^{2}-1) & =2(9{x}^{2}+1)({(3x)}^{2}-{1}^{2}) \\\\  & =2(9{x}^{2}+1)(3x+1)(3x-1)\\end{aligned}\n$$"}]}
