#{[{:db/id #edb/ref 17592186551289 :knowledge-point/_questions [{:db/id #edb/ref 17592186092328 :knowledge-point/id #uuid "36318568-6dfe-5ba9-b607-a2d269d05425" :knowledge-point/title "Identifying Constraints on the Degree of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46e5a5c3-60ec-5627-a225-2932362ec397" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186550535} {:answer/id #uuid "8c9d1adf-aac7-5855-ae2f-e140a9ae5328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186550724} {:answer/id #uuid "a723bf8c-84a9-5f13-a1ce-a539ed90eb0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186550808} {:answer/id #uuid "ad2db5e7-ef23-5703-aeda-1493ac482354" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186550835} {:answer/id #uuid "fc8f5a46-48bc-535e-8332-02ed609bb690" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186551047}] :answer-field/correct {:answer/id #uuid "8c9d1adf-aac7-5855-ae2f-e140a9ae5328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186550724} :answer-field/id #uuid "a97b574a-ddca-51ce-b670-8bb1bab44ffc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551169}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "70cb115a-1a5a-5899-8751-fbde76c6f208" :question/math-academy-id "q-111383" :question/problem "If $P(x)$ and $Q(x)$ are polynomials of degree $5$, what is the highest possible degree of $P+Q?$" :question/worked-solution "The highest possible degree of $P+Q$ is $5.$\n\nFor example, suppose $P={x}^{5}$ and $Q={x}^{5}.$ Then $P+Q=2{x}^{5}.$ \n\nSince neither $P$ nor $Q$ contain terms of order higher than ${x}^{5},$ $P+Q$ can't contain terms of order higher than ${x}^{5}.$"}] [{:db/id #edb/ref 17592186551326 :knowledge-point/_questions [{:db/id #edb/ref 17592186092329 :knowledge-point/id #uuid "2a0cc5ea-7f70-5c5f-841e-01a6813da8c6" :knowledge-point/title "Identifying True Statements About Operations on Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5397c68e-c67c-554c-9f05-a9f7a14e8c85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186550567} {:answer/id #uuid "a3939c82-26fd-5cc6-93af-ef355402eb4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186550793} {:answer/id #uuid "a9ee9f5a-c959-5e80-ac37-ae91ab167c24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186550819} {:answer/id #uuid "f3578614-1ffa-54f6-b421-463ca35d969d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186551020} {:answer/id #uuid "f6df2b25-6b78-5f3f-bfc1-4493840b6b27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186551030}] :answer-field/correct {:answer/id #uuid "f3578614-1ffa-54f6-b421-463ca35d969d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186551020} :answer-field/id #uuid "efdbde40-612d-561b-91ae-eae8bf3a3a21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551219}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b45d9b53-e4ec-561f-955c-4e4b1f88b215" :question/math-academy-id "q-46426" :question/problem "If $P(x)$ and $Q(x)$ are polynomials of degree $3$ and $5$, respectively, which of the following statements are true?\n\nI. $P+Q$ is always a polynomial\n\nII. $P\\cdot Q$ is always a polynomial\n\nIII. $\\frac{P}{Q}$ is always a polynomial" :question/worked-solution "Let's look at each statement in turn.\n\n- Statement I is true. Polynomials are closed under addition.\n\n- Statement II is true. Polynomials are closed under multiplication.\n\n- Statement III is false. For example, suppose $P={x}^{3}$ and $Q={x}^{5}.$ Then $\\frac{P}{Q}=\\frac{{x}^{3}}{{x}^{5}}=\\frac{1}{{x}^{2}},$ which is not a polynomial.\n\nIn conclusion, only statements I and II are true."}] [{:db/id #edb/ref 17592186551335 :knowledge-point/_questions [{:db/id #edb/ref 17592186092329 :knowledge-point/id #uuid "2a0cc5ea-7f70-5c5f-841e-01a6813da8c6" :knowledge-point/title "Identifying True Statements About Operations on Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba58f0f-dfc0-507b-8520-46f049d08857" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186550399} {:answer/id #uuid "299137ec-d817-5726-82f2-18dfed3ce6ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186550470} {:answer/id #uuid "4d08e1d2-4a2e-51a5-96ae-c016f3c20687" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186550550} {:answer/id #uuid "56caf7ba-915d-5ed9-acd6-ec5f243ce59c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186550579} {:answer/id #uuid "5f8ff36c-d673-5223-a9d5-a6b900bddcbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186550601}] :answer-field/correct {:answer/id #uuid "5f8ff36c-d673-5223-a9d5-a6b900bddcbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186550601} :answer-field/id #uuid "7abffeb2-f396-51d3-8c57-6dd2f44d6299" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551138}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ceee5cde-40e3-565c-b032-fa1a9c5be489" :question/math-academy-id "q-51691" :question/problem "Given that $P(x)$ is a polynomial of degree $5,$ which of the following statements are always true?\n\nI. $P(x)-4{x}^{6}$ is a polynomial\n\nII. $4{x}^{6}\\cdot P(x)$ is a polynomial\n\nIII. $\\frac{4{x}^{6}}{P(x)}$ is a polynomial" :question/worked-solution "Let's look at each statement in turn.\n\n- Statement I is true. Polynomials are closed under subtraction.\n\n- Statement II is true. Polynomials are closed under multiplication.\n\n- Statement III is false. For example, suppose $P(x)={x}^{5}+1.$ Then $\\frac{4{x}^{6}}{P(x)}=\\frac{4{x}^{6}}{{x}^{5}+1},$ which is not a polynomial.\n\nIn conclusion, only statements I and II are true."}]}
