57-6dd2f44d6299"] [17592186092329 :knowledge-point/questions "question-ceee5cde-40e3-565c-b032-fa1a9c5be489"] ["question-70cb115a-1a5a-5899-8751-fbde76c6f208" :question/id #uuid "70cb115a-1a5a-5899-8751-fbde76c6f208"] ["question-70cb115a-1a5a-5899-8751-fbde76c6f208" :question/math-academy-id "q-111383"] ["question-70cb115a-1a5a-5899-8751-fbde76c6f208" :question/problem "If $P(x)$ and $Q(x)$ are polynomials of degree $5$, what is the highest possible degree of $P+Q?$"] ["question-70cb115a-1a5a-5899-8751-fbde76c6f208" :question/worked-solution "The highest possible degree of $P+Q$ is $5.$\n\nFor example, suppose $P={x}^{5}$ and $Q={x}^{5}.$ Then $P+Q=2{x}^{5}.$ \n\nSince neither $P$ nor $Q$ contain terms of order higher than ${x}^{5},$ $P+Q$ can't contain terms of order higher than ${x}^{5}.$"] ["question-70cb115a-1a5a-5899-8751-fbde76c6f208" :question/difficulty :question.difficulty/easy] ["answer-field-a97b574a-ddca-51ce-b670-8bb1bab44ffc" :answer-field/id #uuid "a97b574a-ddca-51ce-b670-8bb1bab44ffc"] ["answer-fc8f5a46-48bc-535e-8332-02ed609bb690" :answer/id #uuid "fc8f5a46-48bc-535e-8332-02ed609bb690"] ["answer-fc8f5a46-48bc-535e-8332-02ed609bb690" :answer/type :answer.type/math] ["answer-fc8f5a46-48bc-535e-8332-02ed609bb690" :answer/value "0"] ["answer-ad2db5e7-ef23-5703-aeda-1493ac482354" :answer/id #uuid "ad2db5e7-ef23-5703-aeda-1493ac482354"] ["answer-ad2db5e7-ef23-5703-aeda-1493ac482354" :answer/type :answer.type/math] ["answer-ad2db5e7-ef23-5703-aeda-1493ac482354" :answer/value "10"] ["answer-a723bf8c-84a9-5f13-a1ce-a539ed90eb0c" :answer/id #uuid "a723bf8c-84a9-5f13-a1ce-a539ed90eb0c"] ["answer-a723bf8c-84a9-5f13-a1ce-a539ed90eb0c" :answer/type :answer.type/math] ["answer-a723bf8c-84a9-5f13-a1ce-a539ed90eb0c" :answer/value "4"] ["answer-8c9d1adf-aac7-5855-ae2f-e140a9ae5328" :answer/id #uuid "8c9d1adf-aac7-5855-ae2f-e140a9ae5328"] ["answer-8c9d1adf-aac7-5855-ae2f-e140a9ae5328" :answer/type :answer.type/math] ["answer-8c9d1adf-aac7-5855-ae2f-e140a9ae5328" :answ