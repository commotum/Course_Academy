078 #edb/ref 17592186556985 #edb/ref 17592186045417] [17592186557159 #edb/ref 1079 #uuid "a463388e-81ee-55c1-8529-9813db3a26dc" #edb/ref 17592186045417] [17592186557271 #edb/ref 1068 #edb/ref 17592186557159 #edb/ref 17592186045417] [17592186557271 #edb/ref 1069 "q-53580" #edb/ref 17592186045417] [17592186557271 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186557271 #edb/ref 1071 "![](images/7f/7f5f82876a00c72d7ec829f320d021613d1932b85ef87c7981f9f92669792cb9.png)\n\nJessica's circular swimming pool has a radius of $10\\,\\text{ft}.$ What is the area of the pool?" #edb/ref 17592186045417] [17592186557271 #edb/ref 1072 #uuid "7769fe1f-a9ea-5777-8254-93dfa6c193aa" #edb/ref 17592186045417] [17592186557271 #edb/ref 1074 "The formula for the area of a circle is $A=\\pi {r}^{2},$ so the area of Jessica's pool is\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\  & =\\pi \\cdot {10}^{2} \\\\  & =100\\pi \\,{\\text{ft}}^{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186557285 #edb/ref 1068 #edb/ref 17592186557075 #edb/ref 17592186045417] [17592186557285 #edb/ref 1069 "q-79020" #edb/ref 17592186045417] [17592186557285 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186557285 #edb/ref 1071 "![](images/22/22f63e5e602b29317d7df70f7dae7387feccdd9ab5678592e6c1af35d3d45fd3.png)\n\nWhat is the area of a circle that has a diameter of $8\\,\\text{m}?$" #edb/ref 17592186045417] [17592186557285 #edb/ref 1072 #uuid "9abf643c-c154-51d5-82bc-efb0d0062ad6" #edb/ref 17592186045417] [17592186557285 #edb/ref 1074 "The radius of a circle is half the diameter. So, the radius of our circle is $r=4.$\n\nTherefore, the area is\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\  & =\\pi \\cdot {4}^{2} \\\\  & =16\\pi \\,{\\text{m}}^{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186557320 #edb/ref 1068 #edb/ref 17592186557083 #edb/ref 17592186045417] [17592186557320 #edb/ref 1069 "q-79026" #edb/ref 17592186045417] [17592186557320 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186557320 #edb/ref 1071 "What is the diameter of a circle if its area is $9\\pi \\,{\\text{km}}^{2}?$" #edb/ref 17592186045417] [17592186557320 #edb/ref 1072 #uuid "e818e98a-49f0-5632-a39a-42d0b7b18e71" #edb/ref 17592186045417] [17592186557320 #edb/ref 1074 "The formula for the area of a circle is $A=\\pi {r}^{2}$, where $r$ is the radius. Therefore,\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\ 9\\pi  & =\\pi {r}^{2} \\\\ 9\\cancel{\\pi } & =\\cancel{\\pi }{r}^{2} \\\\ {r}^{2} & =9 \\\\ r & =3\\,\\text{km}.\\end{aligned}\n$$\n\nTherefore, the diameter is\n\n$$\nd=2\\cdot r=2\\cdot 3=6\\,\\text{km}.\n$$" #edb/ref 17592186045417] [17592186557344 #edb/ref 1058 #edb/ref 17592186557387 #edb/ref 17592186045417] [17592186557344 #edb/ref 1062 #uuid "2117f793-0d8c-55c2-96cb-7d576270d83e" #edb/ref 17592186045417] [17592186557344 #edb/ref 1063 #edb/ref 17592186557271 #edb/ref 17592186045417] [17592186557367 #edb/ref 1062 #uuid "6f4bb269-14f4-5218-acd7-bb7816a8185c" #edb/ref 17592186045417] [17592186557367 #edb/ref 1063 #edb/ref 17592186557320 #edb/ref 17592186045417] [17592186557387 #edb/ref 1058 #edb/ref 17592186557367 #edb/ref 17592186045417] [17592186557387 #edb/ref 1062 #uuid "ba1713ee-8952-5ce9-b609-a0242977cbb3" #edb/ref 17592186045417] [17592186557387 #edb/ref 1063 #edb/ref 17592186557285 #edb/ref 17592186045417]}
