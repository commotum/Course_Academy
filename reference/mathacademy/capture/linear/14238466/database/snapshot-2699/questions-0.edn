#{[{:db/id #edb/ref 17592186557271 :knowledge-point/_questions [{:db/id #edb/ref 17592186119756 :knowledge-point/id #uuid "fcef46b2-41a9-58df-b11d-ef58f0b065a9" :knowledge-point/title "Calculating the Area of a Circle Given the Diameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3921910a-1de5-598a-93d7-2fdc2b7192d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186556552} {:answer/id #uuid "48dda0cc-a22f-5a91-861b-11ee881de9d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\pi \\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186556590} {:answer/id #uuid "756f53a0-e350-5fef-8684-70525d758686" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "400\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186556696} {:answer/id #uuid "76c02040-9874-5be6-8aa7-4bcf208d57ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186556699} {:answer/id #uuid "e0ecb785-4190-5d1d-bbfb-ddfba19efeab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100\\pi \\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186556985}] :answer-field/correct {:answer/id #uuid "e0ecb785-4190-5d1d-bbfb-ddfba19efeab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100\\pi \\,{\\text{ft}}^{2}" :db/id #edb/ref 17592186556985} :answer-field/id #uuid "a463388e-81ee-55c1-8529-9813db3a26dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557159}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7769fe1f-a9ea-5777-8254-93dfa6c193aa" :question/math-academy-id "q-53580" :question/problem "![](images/7f/7f5f82876a00c72d7ec829f320d021613d1932b85ef87c7981f9f92669792cb9.png)\n\nJessica's circular swimming pool has a radius of $10\\,\\text{ft}.$ What is the area of the pool?" :question/worked-solution "The formula for the area of a circle is $A=\\pi {r}^{2},$ so the area of Jessica's pool is\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\  & =\\pi \\cdot {10}^{2} \\\\  & =100\\pi \\,{\\text{ft}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186557285 :knowledge-point/_questions [{:db/id #edb/ref 17592186119756 :knowledge-point/id #uuid "fcef46b2-41a9-58df-b11d-ef58f0b065a9" :knowledge-point/title "Calculating the Area of a Circle Given the Diameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e038d9a-c7c9-554c-bf61-0c349d8c5da3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\pi \\,{\\text{m}}^{2}" :db/id #edb/ref 17592186556568} {:answer/id #uuid "4724aa93-864b-5977-9bce-176ade3fd8e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{\\pi }^{2}\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186556586} {:answer/id #uuid "787de4de-39bc-5a72-95d5-54d7ad83eb88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64{\\pi }^{2}\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186556705} {:answer/id #uuid "b37fcd91-0cf3-59ac-ad10-6c9d508f701d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\pi \\,{\\text{m}}^{2}" :db/id #edb/ref 17592186556872} {:answer/id #uuid "c950e967-2717-54e9-80e2-d197f1792abe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi \\,{\\text{m}}^{2}" :db/id #edb/ref 17592186556913}] :answer-field/correct {:answer/id #uuid "b37fcd91-0cf3-59ac-ad10-6c9d508f701d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\pi \\,{\\text{m}}^{2}" :db/id #edb/ref 17592186556872} :answer-field/id #uuid "15e0cf27-8090-59a9-82f4-1f188dede25c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557075}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9abf643c-c154-51d5-82bc-efb0d0062ad6" :question/math-academy-id "q-79020" :question/problem "![](images/22/22f63e5e602b29317d7df70f7dae7387feccdd9ab5678592e6c1af35d3d45fd3.png)\n\nWhat is the area of a circle that has a diameter of $8\\,\\text{m}?$" :question/worked-solution "The radius of a circle is half the diameter. So, the radius of our circle is $r=4.$\n\nTherefore, the area is\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\  & =\\pi \\cdot {4}^{2} \\\\  & =16\\pi \\,{\\text{m}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186557320 :knowledge-point/_questions [{:db/id #edb/ref 17592186119861 :knowledge-point/id #uuid "f1740fa9-50b1-5fad-9f99-31820dd77067" :knowledge-point/title "Calculating the Radius or Diameter of a Circle Given the Area"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f0c126a-ad91-57d7-9ff4-9aaefd0fb031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{km}" :db/id #edb/ref 17592186556460} {:answer/id #uuid "1366b50a-55de-5aba-a99f-0003e4d3aa16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{km}" :db/id #edb/ref 17592186556471} {:answer/id #uuid "15fdb7ca-98a2-5ffb-9674-d7dc9e7774f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{km}" :db/id #edb/ref 17592186556474} {:answer/id #uuid "5d2424d9-e201-5bcd-919e-7363b78944cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi \\,\\text{km}" :db/id #edb/ref 17592186556638} {:answer/id #uuid "981deb0c-4d5e-5a68-9ff8-0f8cb94c55de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,\\text{km}" :db/id #edb/ref 17592186556795}] :answer-field/correct {:answer/id #uuid "1366b50a-55de-5aba-a99f-0003e4d3aa16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{km}" :db/id #edb/ref 17592186556471} :answer-field/id #uuid "1d3f482e-4b2a-591f-baf2-85798d1eb2b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557083}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e818e98a-49f0-5632-a39a-42d0b7b18e71" :question/math-academy-id "q-79026" :question/problem "What is the diameter of a circle if its area is $9\\pi \\,{\\text{km}}^{2}?$" :question/worked-solution "The formula for the area of a circle is $A=\\pi {r}^{2}$, where $r$ is the radius. Therefore,\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\ 9\\pi  & =\\pi {r}^{2} \\\\ 9\\cancel{\\pi } & =\\cancel{\\pi }{r}^{2} \\\\ {r}^{2} & =9 \\\\ r & =3\\,\\text{km}.\\end{aligned}\n$$\n\nTherefore, the diameter is\n\n$$\nd=2\\cdot r=2\\cdot 3=6\\,\\text{km}.\n$$"}]}
