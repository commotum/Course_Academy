#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186501297} :activity/id #uuid "6717b18e-0ae6-5129-8fd0-6d170c347d50" :activity/scope {:db/id #edb/ref 17592186049355 :topic/id #uuid "ee459d83-61aa-5856-8bac-7a5980791833" :topic/math-academy-id 1131} :activity/steps [{:db/id #edb/ref 17592186501281 :step/content {:db/id #edb/ref 17592186097334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43af25d8-92f4-5878-a3dc-1e644c8ce222" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4.1}^{∘}\\text{C}" :db/id #edb/ref 17592186500598} {:answer/id #uuid "5af32836-d1a7-5d0a-943b-b796a712c9a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{5.4}^{∘}\\text{C}" :db/id #edb/ref 17592186500653} {:answer/id #uuid "89cd1393-5088-5478-9c9a-365dbf9b98ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4.5}^{∘}\\text{C}" :db/id #edb/ref 17592186500756} {:answer/id #uuid "a8e8a032-002e-52f4-b130-3642ea6a8d2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4.9}^{∘}\\text{C}" :db/id #edb/ref 17592186500816} {:answer/id #uuid "aee93dc4-7161-5dc3-8fb5-fae906b155a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3.8}^{∘}\\text{C}" :db/id #edb/ref 17592186500833}] :answer-field/correct {:db/id #edb/ref 17592186500653} :answer-field/id #uuid "1e8d554f-b2db-5405-9a00-6a130d18be15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095928}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8ee7811c-bbf0-5938-a2b2-9a34707608bb" :question/math-academy-id "q-68929" :question/problem "Jennifer is doing a science experiment in her Chemistry class. She takes a liquid with a temperature of ${10.1}^{∘}\\text{C}$ and places it in a refrigerator. After half an hour, she removes the liquid from the refrigerator and places it on a table. She concludes that the temperature decreased by ${12.7}^{∘}\\text{C}.$\n\nAfter half an hour, Jennifer takes the temperature of the liquid again and finds that the temperature increased by ${8}^{∘}\\text{C}.$ What is the final temperature of the liquid?" :question/worked-solution "First of all, we must determine the temperature of the liquid when it was removed from the refrigerator. Since its temperature decreased by ${12.7}^{∘}\\text{C}$ compared to the initial temperature, we must subtract the variation in temperature from the initial temperature. This gives\n\n$$\n{10.1}^{∘}\\text{C}-{12.7}^{∘}\\text{C}=-{2.6}^{∘}\\text{C}.\n$$\n\nNow, we must determine the temperature of the liquid after half an hour had elapsed. Since the temperature of the liquid increased by ${8}^{∘}\\text{C}$ compared to the temperature when it was removed from the refrigerator, we add the variation in temperature to the temperature of the liquid when it was removed from the refrigerator. This gives\n\n$$\n-{2.6}^{∘}\\text{C}+{8}^{∘}\\text{C}={5.4}^{∘}\\text{C}.\n$$\n\nTherefore, the final temperature of the liquid is ${5.4}^{∘}\\text{C}.$"} :step/id #uuid "b210e935-1e45-56a0-b060-d68f4c88d265"} {:db/id #edb/ref 17592186501285 :step/content {:db/id #edb/ref 17592186097332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b50f720-834e-538d-a417-e00fac3153c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{1.2}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500555} {:answer/id #uuid "51dca9e2-de80-5c9d-8a95-e67f670877be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{1.3}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500635} {:answer/id #uuid "775a09e2-42f5-548f-8dd4-b32b4dc2ffac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{1.7}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500714} {:answer/id #uuid "a5596099-ee8b-5cf9-8adb-ce7fa5b6cd6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{2.3}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500805} {:answer/id #uuid "e2d3652a-d1a5-5019-9d30-94746544d406" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{2.1}^{∘}\\,\\text{C}" :db/id #edb/ref 17592186500948}] :answer-field/correct {:db/id #edb/ref 17592186500714} :answer-field/id #uuid "03913dbe-158c-5e69-a492-f412ab726635" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095916}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f9448c2-f63c-5cfa-ac1b-26b1b5d3b6f6" :question/math-academy-id "q-68889" :question/problem "On a certain day in January, the temperature in New York in the morning was $-{2.4}^{∘}\\,\\text{C}.$ At noon, the temperature registered a slight increase of ${0.7}^{∘}\\,\\text{C}.$ What was the temperature in New York at noon?" :question/worked-solution "To determine the temperature at noon, we add the variation in temperature to the temperature in the morning of that day This gives\n\n$$\n-{2.4}^{∘}\\,\\text{C}+{0.7}^{∘}\\,\\text{C}=-{1.7}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the temperature in New York at noon that day was $-{1.7}^{∘}\\,\\text{C}.$"} :step/id #uuid "b66eda3a-f894-548a-a50a-1339b390ccd6" :step/next {:db/id #edb/ref 17592186501281}} {:db/id #edb/ref 17592186501297 :step/content {:db/id #edb/ref 17592186097327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43d5adc5-a2eb-531a-b7ea-b5939b327f6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\,\\text{m}" :db/id #edb/ref 17592186500599} {:answer/id #uuid "86933486-a8ce-5022-91e0-69867dfc556a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14\\,\\text{m}" :db/id #edb/ref 17592186500748} {:answer/id #uuid "a0f2cce9-f1d9-5104-a5a1-b0915a465a5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15\\,\\text{m}" :db/id #edb/ref 17592186500794} {:answer/id #uuid "bb2d2cd5-3aa6-5d90-8deb-5b7155be97f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,\\text{m}" :db/id #edb/ref 17592186500856} {:answer/id #uuid "e5cee887-50b6-56ef-81f1-ae790574664e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\,\\text{m}" :db/id #edb/ref 17592186500957}] :answer-field/correct {:db/id #edb/ref 17592186500794} :answer-field/id #uuid "813aaeae-688c-5e88-936e-02dac71e1499" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095886}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "beabbd10-476d-53ed-8111-c1ff6cabe7de" :question/math-academy-id "q-68474" :question/problem "Margaret and Juan like freediving. One day they both went to the sea, and while Juan practiced this extreme sport $13$ meters below sea level, Margaret waited for him in the boat, $2$ meters above sea level. If Juan is below Margaret, how far apart are they from each other?" :question/worked-solution "To determine the distance between Margaret and Juan, we calculate the difference between Margaret's location and Juan's location. This gives\n\n$$\n2-(-13)=2+13=15\\,\\text{m}.\n$$\n\nTherefore, Margaret and Juan are $15\\,\\text{m}$ apart."} :step/id #uuid "f6f16938-eb50-51e6-8e2a-41104a49a9ed" :step/next {:db/id #edb/ref 17592186501285}}] :activity/title "Solving Problems Using Addition and Subtraction of Rational Numbers" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186500463}]}
