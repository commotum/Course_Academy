#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186495216} :activity/id #uuid "6aa5b166-dd8e-5ca2-8b7d-1419def83709" :activity/scope {:db/id #edb/ref 17592186048938 :topic/id #uuid "cd61cb00-4988-54d1-a596-e98a1a9c15ab" :topic/math-academy-id 2183} :activity/steps [{:db/id #edb/ref 17592186495187 :step/content {:db/id #edb/ref 17592186495065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a193d30-2678-5290-8227-48f94178684b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186494501} {:answer/id #uuid "71b0bb4d-c696-553e-85b2-c82a397e838c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186494561} {:answer/id #uuid "ada5c571-4b79-5699-bf57-b91b3d06e08b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186494721} {:answer/id #uuid "d7b1df03-83f7-505b-93fd-e466c959a197" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186494828} {:answer/id #uuid "e10238d5-b4fc-50dd-852e-f9c92340056d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186494852}] :answer-field/correct {:db/id #edb/ref 17592186494721} :answer-field/id #uuid "eab9a6ff-5e82-586a-84ee-0529550dee14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495032}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1ae15419-ea90-5da7-9981-972449aabeb9" :question/math-academy-id "q-70122" :question/problem "Evaluate $\\frac{2m}{n+4}-\\frac{m-2}{2n}$ if $m=4$ and $n=1$ ." :question/worked-solution "We replace $m$ with $4$ and $n$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{2m}{n+4}-\\frac{m-2}{2n} & = \\\\ \\frac{2(4)}{1+4}-\\frac{4-2}{2(1)} & = \\\\ \\frac{8}{5}-\\frac{2}{2} & = \\\\ \\frac{8}{5}-1 & = \\\\ \\frac{8}{5}-\\frac{5}{5} & = \\\\ \\frac{8-5}{5} & = \\\\ \\frac{3}{5}\\end{aligned}\n$$"} :step/id #uuid "21d43eb5-2713-5f23-bd3a-faf668d76610" :step/next {:db/id #edb/ref 17592186495192}} {:db/id #edb/ref 17592186495192 :step/content {:db/id #edb/ref 17592186495056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03fe396d-fe54-5331-9b0d-89cca76e8a83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186494325} {:answer/id #uuid "28e4f656-f65d-5411-8d23-3582c6860ee1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186494395} {:answer/id #uuid "7e76872b-704c-5f0c-a9ff-08c0e8fdc198" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{7}" :db/id #edb/ref 17592186494593} {:answer/id #uuid "93ee67a5-c7ed-59bc-a55b-a2b9816ca144" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{17}{10}" :db/id #edb/ref 17592186494657} {:answer/id #uuid "a652b819-cc60-593b-be0f-164896bc2a59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{10}{17}" :db/id #edb/ref 17592186494698}] :answer-field/correct {:db/id #edb/ref 17592186494657} :answer-field/id #uuid "df747204-bd95-5057-9f83-9ee058a01322" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495026}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0f15a926-c445-59e0-9b0e-24fb3d26db90" :question/math-academy-id "q-99830" :question/problem "Evaluate $\\frac{8}{x}+\\frac{2}{4x}$ for $x=-5.$" :question/worked-solution "We replace $x$ with $-5$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{8}{x}+\\frac{2}{4x} & = \\\\ \\frac{8}{(-5)}+\\frac{2}{4\\cdot (-5)} & = \\\\ -\\frac{8}{5}+(-\\frac{2}{20}) & = \\\\ -\\frac{8}{5}-\\frac{1}{10} & = \\\\ -\\frac{16}{10}-\\frac{1}{10} & = \\\\ \\frac{-16-1}{10} & = \\\\ -\\frac{17}{10}\\end{aligned}\n$$"} :step/id #uuid "280ac367-40c7-558a-b5e2-c35117deba67" :step/next {:db/id #edb/ref 17592186495263}} {:db/id #edb/ref 17592186495216 :step/content {:db/id #edb/ref 17592186495145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e3dbef9-dc90-5521-aad3-0e986ff0a9c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186494374} {:answer/id #uuid "2f95e908-cc3c-52a0-b192-0d0710737e7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186494411} {:answer/id #uuid "8afd3cea-dcab-580e-a906-ca6e1b3ef1ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186494632} {:answer/id #uuid "c99f603d-0d8c-5cad-a745-389ae3790563" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186494793} {:answer/id #uuid "fc53b599-5c2a-51eb-849a-b5560be90857" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186494912}] :answer-field/correct {:db/id #edb/ref 17592186494793} :answer-field/id #uuid "ae640502-6ec1-5965-8f84-422b9cf2d36f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494999}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cd9fe40e-bc91-5a44-83a1-8324033e7c36" :question/math-academy-id "q-41396" :question/problem "Evaluate $\\frac{4p-1}{2(2p+2)}$ for $p=4.$" :question/worked-solution "We replace $p$ with $4$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{4p-1}{2(2p+2)} & = \\\\ \\frac{4(4)-1}{2(2(4)+2)} & = \\\\ \\frac{15}{2(8+2)} & = \\\\ \\frac{15}{20} & = \\\\ \\frac{3}{4}\\end{aligned}\n$$"} :step/id #uuid "7b236cf6-b776-533a-a5d8-6899df32a482" :step/next {:db/id #edb/ref 17592186495242}} {:db/id #edb/ref 17592186495242 :step/content {:db/id #edb/ref 17592186495162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d21786-f17d-5f51-b039-3a8847d6393b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186494363} {:answer/id #uuid "3624078e-face-5369-96cf-5bd66283c3d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186494430} {:answer/id #uuid "506d0e3d-76e7-56a6-8950-11ce3311fb87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186494480} {:answer/id #uuid "80029657-b251-5c82-b8aa-9552f47c932e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{7}" :db/id #edb/ref 17592186494594} {:answer/id #uuid "899713f6-4503-506c-8e51-5d19404c5088" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186494624}] :answer-field/correct {:db/id #edb/ref 17592186494480} :answer-field/id #uuid "ecea4696-381b-5caf-8ad2-71fa9ec32665" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495033}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ea15f44d-2e1d-56cb-9675-b5eb8b0bd610" :question/math-academy-id "q-51597" :question/problem "Evaluate $\\frac{p+9}{2(3-p)}$ for $p=-5.$" :question/worked-solution "We replace $p$ with $-5$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{p+9}{2(3-p)} & = \\\\ \\frac{(-5)+9}{2(3-(-5))} & = \\\\ \\frac{4}{2(8)} & = \\\\ \\frac{4}{16} & = \\\\ \\frac{1}{4} & \\end{aligned}\n$$"} :step/id #uuid "b33d30b4-f26c-5283-a113-5d791c204f7d" :step/next {:db/id #edb/ref 17592186495187}} {:db/id #edb/ref 17592186495263 :step/content {:db/id #edb/ref 17592186495109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90b1e99c-00a5-5d5c-9c07-a9ac4425d78b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186494647}] :answer-field/correct {:db/id #edb/ref 17592186494647} :answer-field/id #uuid "390cda6c-7afa-531f-b8d2-8d4ab6b358f0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186494941}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8ab342b9-3bac-54fe-9ede-058c11e77bac" :question/math-academy-id "q-175902" :question/problem "If $p=-2$ and $q=6,$ then $\\frac{2q-3}{4}+\\frac{4}{4-2p}=${{field-1}}." :question/worked-solution "Replacing $p$ with $-2$ and $q$ with $6$ in the expression, we get the following:\n\n$$\n\\begin{aligned}\\frac{2q-3}{4}+\\frac{4}{4-2p} & = \\\\ \\frac{2(6)-3}{4}+\\frac{4}{4-2(-2)} & = \\\\ \\frac{12-3}{4}+\\frac{4}{4+4} & = \\\\ \\frac{9}{4}+\\frac{4}{8} & = \\\\ \\frac{18}{8}+\\frac{4}{8} & = \\\\ \\frac{18+4}{8} & = \\\\ \\frac{22}{8} & = \\\\ \\frac{11}{4}\\end{aligned}\n$$"} :step/id #uuid "e3763ce7-1ebb-58a6-9246-c04907a1a3c3"}] :activity/title "Evaluating Rational Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494306}]}
