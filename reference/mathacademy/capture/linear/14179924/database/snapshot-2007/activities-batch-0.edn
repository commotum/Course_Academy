#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186134987} :activity/id #uuid "f2735cce-723e-58b4-93fb-cea13e3ee05e" :activity/scope {:db/id #edb/ref 17592186048938 :topic/id #uuid "cd61cb00-4988-54d1-a596-e98a1a9c15ab" :topic/math-academy-id 2183} :activity/steps [{:db/id #edb/ref 17592186134987 :step/content {:db/id #edb/ref 17592186135171 :tutorial/content "A **rational expression** is, roughly speaking, an algebraic expression that's in the form of a fraction, or contains fractions.\n\nTo evaluate a rational expression like $\\dfrac 6 x$ for $x=2,$ all we need to do is replace $x$ with $2$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{6}{x}=\\frac{6}{2}=3\\end{aligned}\n$$" :tutorial/id #uuid "12656f01-d648-56e1-9a11-2f5bb03056ec" :tutorial/math-academy-id 8008 :tutorial/title "Introduction"} :step/id #uuid "4e087006-b2f0-5042-9384-ccede2e9afb9" :step/math-academy-id 76947 :step/next {:db/id #edb/ref 17592186134988}} {:db/id #edb/ref 17592186134988 :step/content {:db/id #edb/ref 17592186133962 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133492 :question/id #uuid "e2e06b2a-d740-5280-addb-2796864dd5a8" :question/math-academy-id "e-12768"} :knowledge-point/id #uuid "00f73402-88ee-5e43-8e45-dbdd0a361521" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050078} {:db/id #edb/ref 17592186050127}] :knowledge-point/questions [{:db/id #edb/ref 17592186134348} {:db/id #edb/ref 17592186134349} {:db/id #edb/ref 17592186479871} {:db/id #edb/ref 17592186479900}] :knowledge-point/title "Evaluating a Single Fraction"} :step/id #uuid "12a83cc7-e8f9-5b87-bc18-7e038bdde9ae" :step/math-academy-id 76948 :step/next {:db/id #edb/ref 17592186134989}} {:db/id #edb/ref 17592186134989 :step/content {:db/id #edb/ref 17592186133963 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133494 :question/id #uuid "74f72809-7c28-5fc8-9e0e-b5542b5ffe4d" :question/math-academy-id "e-12770"} 