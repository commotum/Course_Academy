    "q-99830": {
      "dom_id": "step-q99830",
      "name": "Question 4",
      "problem": "Evaluate $\\frac{8}{x}+\\frac{2}{4x}$ for $x=-5.$",
      "worked_solution": "We replace $x$ with $-5$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{8}{x}+\\frac{2}{4x} & = \\\\ \\frac{8}{(-5)}+\\frac{2}{4\\cdot (-5)} & = \\\\ -\\frac{8}{5}+(-\\frac{2}{20}) & = \\\\ -\\frac{8}{5}-\\frac{1}{10} & = \\\\ -\\frac{16}{10}-\\frac{1}{10} & = \\\\ \\frac{-16-1}{10} & = \\\\ -\\frac{17}{10}\\end{aligned}\n$$",
      "calculator_instructions": "",
