:answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186104976} {:answer/id #uuid "55d4e952-a6d8-5904-946b-38407b47e342" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{25}" :db/id #edb/ref 17592186104977} {:answer/id #uuid "5ddacffd-3676-5cad-8eda-6c8155b58081" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186104978} {:answer/id #uuid "6d66a109-c2bd-5416-af13-846d5afe3a77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{25}" :db/id #edb/ref 17592186104979}] :answer-field/correct {:db/id #edb/ref 17592186104977} :answer-field/id #uuid "1fc66f7f-3850-5fa3-bc61-13386480b4f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186104974}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5b2c788a-e2e8-529d-bb25-574b06c58bb0" :question/math-academy-id "q-68458" :question/problem "${(\\frac{3}{5})}^{2}=$" :question/worked-solution "To raise the fraction to the power of $2$, we must raise both the numerator and the denominator to the power of $2:$\n\n$$\n{(\\frac{3}{5})}^{2}=\\frac{{3}^{2}}{{5}^{2}}\n$$\n\nNow, using ${3}^{2}=9$ and ${5}^{2}=25,$ we get\n\n$$\n\\frac{{3}^{2}}{{5}^{2}}=\\frac{9}{25}.\n$$"} :step/id #uuid "9adbfcf0-8452-52d5-b4fb-e01320e32a18" :step/next {:db/id #edb/ref 17592186493993}} {:db/id #edb/ref 17592186494048 :step/content {:db/id #edb/ref 17592186106473 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f287d7b-8e45-585a-98fa-28040508099a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186104987} {:answer/id #uuid "ce55da7f-50bc-50e1-97d4-2fb77506d6e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{49}" :db/id #edb/ref 17592186104988} {:answer/id #uuid "f9e6c57d-980f-5bf5-abe5-039788ff6f9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{14}" :db/id #edb/ref 17592186104989} {:answer/id #uuid "3a096c69-a948-55c4-b1f3-408814661ef8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{7}" :db/id #edb/ref 17592186104990} {:answer/id #uuid "4f053517-545a-56dd-a930-55fa0e6815e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{49}" :db/id #edb/ref 17592186104991}] :answer-field/correct {:db/id #edb/ref 17592186104988} :answer-field/id #uuid "b9230a8b-5c46-59a1-bb96-933a3909004f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186104986}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e207c000-8554-5f94-b1da-034972cbe6db" :question/math-academy-id "q-68467" :question/problem "${(-\\frac{1}{7})}^{2}=$" :question/worked-solution "First, notice that $-\\frac{1}{7}=\\frac{(-1)}{7}.$\n\nTo raise the fraction to the power of $2$, we must raise both the numerator and the denominator to the power of $2:$\n\n$$\n{(-\\frac{1}{7})}^{2}={(\\frac{(-1)}{7})}^{2}=\\frac{(-1)^{2}}{{7}^{2}}\n$$\n\nNow, using $(-1)^{2}=1$ and ${7}^{2}=49,$ we get\n\n$$\n\\frac{(-1)^{2}}{{7}^{2}}=\\frac{1}{49}.\n$$"} :step/id #uuid "b0856f94-0f86-5940-aa64-f087a7c6407e"}] :activity/title "The Power of Quotient Rule for Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493379}]}
