#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186106642} :activity/id #uuid "5d527aa8-abdc-59f4-9e67-fe8dbfab8e99" :activity/scope {:db/id #edb/ref 17592186048683 :topic/id #uuid "b4904126-8a71-5d04-a71d-74c10d4620ba" :topic/math-academy-id 1289} :activity/steps [{:db/id #edb/ref 17592186106632 :step/content {:db/id #edb/ref 17592186105742 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105599 :question/id #uuid "3ef53b20-3e82-5cd0-a1df-bd679ea8c650" :question/math-academy-id "e-4671"} :knowledge-point/id #uuid "bbc7c6e8-63c7-5ac4-9b65-f12c006b3fde" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049714}] :knowledge-point/questions [{:db/id #edb/ref 17592186106469} {:db/id #edb/ref 17592186106470} {:db/id #edb/ref 17592186478377}] :knowledge-point/title "Applying the Power of Quotient Rule"} :step/id #uuid "2f04115d-4fb6-50da-9efd-0c167f51e86a" :step/math-academy-id 17142 :step/next {:db/id #edb/ref 17592186106633}} {:db/id #edb/ref 17592186106633 :step/content {:db/id #edb/ref 17592186105743 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105600 :question/id #uuid "0debd4b6-66bd-5c00-8f0c-db39f5d848bc" :question/math-academy-id "e-4672"} :knowledge-point/id #uuid "d87a38cc-5ca0-534e-8fa1-0a6e68d65706" :knowledge-point/questions [{:db/id #edb/ref 17592186106471} {:db/id #edb/ref 17592186106472} {:db/id #edb/ref 17592186478380} {:db/id #edb/ref 17592186493896} {:db/id #edb/ref 17592186536830}] :knowledge-point/title "Evaluating Powers of Fractions Using Power of Quotient Rule"} :step/id #uuid "34836a29-5761-54fe-b6ca-a58e1fca9de8" :step/math-academy-id 17143 :step/next {:db/id #edb/ref 17592186106634}} {:db/id #edb/ref 17592186106634 :step/content {:db/id #edb/ref 17592186105744 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105601 :question/id #uuid "80cde83c-b7fb-5ad7-bc3e-528e47151da4" :question/math-academy-id "e-4673"} :knowledge-point/id #uuid "46cd136a-cc20-51e1-ac90-f8d9b787c5b3" :knowledge-point/questions [{:db/id #edb/ref 17592186106473} {:db/id #edb/ref 17592186106474} {:db/id #edb/ref 17592186478376} {:db/id #edb/ref 17592186478425}] :knowledge-point/title "Evaluating Powers of Negative Fractions Using the Power of Quotient Rule"} :step/id #uuid "fde68042-0dcb-5358-9469-295c9964cb49" :step/math-academy-id 17144} {:db/id #edb/ref 17592186106642 :step/content {:db/id #edb/ref 17592186107083 :tutorial/content "To raise a fraction to a power, we must raise both the numerator and the denominator to that power. This is known as the **power of quotient rule for exponents**.\n\nTo demonstrate, let's simplify the expression $\\left(\\dfrac{2}{5}\\right)^3$ by applying the power of quotient rule:\n\n$$\n\\left(\\dfrac{2}{5}\\right)^3=\\dfrac{2^3}{5^3}\n$$\n\n**Note:** The power of quotient rule for exponents is really just a quicker alternative to using repeated multiplication, as follows:\n\n$$\n\\begin{aligned}{(\\frac{2}{5})}^{3} & =(\\frac{2}{5})\\times (\\frac{2}{5})\\times (\\frac{2}{5}) \\\\  & =\\frac{2\\times 2\\times 2}{5\\times 5\\times 5} \\\\  & =\\frac{{2}^{3}}{{5}^{3}}\\end{aligned}\n$$" :tutorial/id #uuid "8abc3ed3-0ba8-5dc1-8bf8-437985614b92" :tutorial/math-academy-id 3273 :tutorial/title "Introduction"} :step/id #uuid "c9e8e3ef-fed3-5e60-ae33-e12940a91210" :step/math-academy-id 17997 :step/next {:db/id #edb/ref 17592186106632}}] :activity/title "The Power of Quotient Rule for Exponents" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105965}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186494040} :activity/id #uuid "7e7b6dc7-4114-5b93-bb27-c0eeaa8b140f" :activity/scope {:db/id #edb/ref 17592186048683 :topic/id #uuid "b4904126-8a71-5d04-a71d-74c10d4620ba" :topic/math-academy-id 1289} :activity/steps [{:db/id #edb/ref 17592186493993 :step/content {:db/id #edb/ref 17592186493896 :question/answer-fields [{:answer-field/choic