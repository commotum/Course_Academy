ef 17592186104988} {:answer/id #uuid "f9e6c57d-980f-5bf5-abe5-039788ff6f9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{14}" :db/id #edb/ref 17592186104989} {:answer/id #uuid "3a096c69-a948-55c4-b1f3-408814661ef8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{7}" :db/id #edb/ref 17592186104990} {:answer/id #uuid "4f053517-545a-56dd-a930-55fa0e6815e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{49}" :db/id #edb/ref 17592186104991}] :answer-field/correct {:db/id #edb/ref 17592186104988} :answer-field/id #uuid "b9230a8b-5c46-59a1-bb96-933a3909004f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186104986}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e207c000-8554-5f94-b1da-034972cbe6db" :question/math-academy-id "q-68467" :question/problem "${(-\\frac{1}{7})}^{2}=$" :question/worked-solution "First, notice that $-\\frac{1}{7}=\\frac{(-1)}{7}.$\n\nTo raise the fraction to the power of $2$, we must raise both the numerator and the denominator to the power of $2:$\n\n$$\n{(-\\frac{1}{7})}^{2}={(\\frac{(-1)}{7})}^{2}=\\frac{(-1)^{2}}{{7}^{2}}\n$$\n\nNow, using $(-1)^{2}=1$ and ${7}^{2}=49,$ we get\n\n$$\n\\frac{(-1)^{2}}{{7}^{2}}=\\frac{1}{49}.\n$$"} :step/id #uuid "b0856f94-0f86-5940-aa64-f087a7c6407e"}] :activity/title "The Power of Quotient Rule for Exponents" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186493379}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186544982} :activity/id #uuid "5780162d-05a6-5c90-833c-f4c321c6a2c0" :activity/scope {:db/id #edb/ref 17592186048683 :topic/id #uuid "b4904126-8a71-5d04-a71d-74c10d4620ba" :topic/math-academy-id 1289} :activity/steps [{:db/id #edb/ref 17592186544900 :step/content {:db/id #edb/ref 17592186544795 :question/answer-fields [{:answer-field/choices [{: