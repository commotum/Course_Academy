17592186546837}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3c8aa20d-84d8-5ea2-acd5-54c4bc8e046e" :question/math-academy-id "q-28093" :question/problem "![](images/a3/a3f54a14f29af7179fdc8c9a9756669db50e7def8f9dce05f5dc1bdf9edacddf.png)\n\nWhat's the equation of the above curve?" :question/worked-solution "This is the curve $y={x}^{3}$ that's been translated $4$ units *up*.\n\n![](images/6e/6e648364fb73fab66bf5f184495098c37797963781def4203e405ec35c32063c.png)\n\nTherefore, the correct answer is $y={x}^{3}\\,+\\,4.$"}] [{:db/id #edb/ref 17592186547005 :knowledge-point/_questions [{:db/id #edb/ref 17592186115270 :knowledge-point/id #uuid "6f1cf641-888f-576c-b9c3-0bdf62a00fb8" :knowledge-point/title "Combining Horizontal and Vertical Translations of Elementary Cubic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2d4e65a-841a-56dc-9579-4bb2a4cfc6db" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/87/872345b162436395334b48892dc17640714649a40638ad29d451242335b62bfc.png" :db/id #edb/ref 17592186546650} {:answer/id #uuid "cbad7c61-aee3-533b-97fd-24d30553560f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/36/36c05124e344563f7d21009b66e37d5369c3359ac283652d81860217adf80df9.png" :db/id #edb/ref 17592186546703} {:answer/id #uuid "d391811e-d517-5d0c-ba3b-5a9a7a6bd2c2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/34/34c4aeb76feac08b40e58d44de196d229348d0b4f8d4b4a6907bacbddf227b4b.png" :db/id #edb/ref 17592186546719} {:answer/id #uuid "eb781404-cb6f-5abd-9417-ecc0d1134c5c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/61/61aa52ea06b61f494702f44934dfa60432ff79ecd3099572fbb175c512548a9d.png" :db/id #edb/ref 17592186546782} {:answer/id #uuid "f444935a-50ed-5927-b2b3-f60a14618cb6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/51/51c3a15bdf2ed729e3cbd040343df41ae71d35bb0ba33d4df3176e9c82e473fb.png" :db/id #edb/ref 17592186546800}] :answer-field/correct {:answer/id #uuid "d391811e-d517-5d0c-ba3b-5a9a7a6bd2c2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/34/34c4aeb76feac08b40e58d44de196d229348d0b4f8d4b4a6907bacbddf227b4b.png" :db/id #edb/ref 17592186546719} :answer-field/id #uuid "042f833f-600f-5f92-8a75-dd26d848cf5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546833}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "583e5e4f-56c7-5776-be8f-4c44fa8b2464" :question/math-academy-id "q-6653" :question/problem "Which of the following is the graph of $y=-(x-1)^{3}+1?$" :question/worked-solution "The given function can be obtained by translating $y=-{x}^{3}$ both horizontally and vertically.\n\nWe have two translations:\n\n- the $-1$ inside the parentheses means a horizontal translation of $1$ unit to the *right*, and\n\n- the $+1$ outside the parentheses means a vertical translation of $1$ unit *up*.\n\nSo, the new graph looks as follows:\n\n![](images/2c/2c31f6c2b3f6c9e52d220bdb1c374e47b11d1ca13af0f5fe6cf4a58a06216c80.png)"}]}
