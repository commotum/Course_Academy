6045417 true] [17592186446979 1078 #edb/ref 17592186446965 13194139534987 17592186045417 true] [17592186446979 1079 #uuid "77c82add-3292-5a5b-b498-4577ca20c249" 13194139534987 17592186045417 true] [17592186446980 1075 #edb/ref 17592186446968 13194139534987 17592186045417 true] [17592186446980 1076 #edb/ref 17592186045492 13194139534987 17592186045417 true] [17592186446980 1077 "field-1" 13194139534987 17592186045417 true] [17592186446980 1078 #edb/ref 17592186446968 13194139534987 17592186045417 true] [17592186446980 1079 #uuid "e404a850-f14e-5356-843f-34fde6cb6d6a" 13194139534987 17592186045417 true] [17592186446981 1088 #edb/ref 17592186048825 13194139534987 17592186045417 true] [17592186446981 1088 #edb/ref 17592186048924 13194139534987 17592186045417 true] [17592186446981 1088 #edb/ref 17592186049143 13194139534987 17592186045417 true] [17592186446981 1088 #edb/ref 17592186049253 13194139534987 17592186045417 true] [17592186446981 1088 #edb/ref 17592186049640 13194139534987 17592186045417 true] [17592186446981 1088 #edb/ref 17592186049752 13194139534987 17592186045417 true] [17592186446981 1088 #edb/ref 17592186050462 13194139534987 17592186045417 true] [17592186446981 1089 #edb/ref 17592186446982 13194139534987 17592186045417 true] [17592186446981 1090 #uuid "47f4d50f-3177-5ac8-a011-f33d81f51d11" 13194139534987 17592186045417 true] [17592186446982 1084 #edb/ref 17592186446990 13194139534987 17592186045417 true] [17592186446982 1084 #edb/ref 17592186446991 13194139534987 17592186045417 true] [17592186446982 1084 #edb/ref 17592186446992 13194139534987 17592186045417 true] [17592186446982 1084 #edb/ref 17592186446993 13194139534987 17592186045417 true] [17592186446982 1084 #edb/ref 17592186446995 13194139534987 17592186045417 true] [17592186446982 1084 #edb/ref 17592186446996 13194139534987 17592186045417 true] [17592186446982 1084 #edb/ref 17592186446997 13194139534987 17592186045417 true] [17592186446982 1085 "Fernando is organizing a sale of food for animals." 13194139534987 17592186045417 true] [17592186446982 1086 #uuid "6ab342b0-871f-5b9b-acdb-4a852caa3fc4" 13194139534987 17592186045417 true] [17592186446982 1087 #edb/ref 17592186446990 13194139534987 17592186045417 true] [17592186446983 1068 #edb/ref 17592186446978 13194139534987 17592186045417 true] [17592186446983 1068 #edb/ref 17592186446979 13194139534987 17592186045417 true] [17592186446983 1069 "q-134229" 13194139534987 17592186045417 true] [17592186446983 1070 #edb/ref 17592186045487 13194139534987 17592186045417 true] [17592186446983 1071 "After Rocky ate his part of the adult dog food, the remaining amount of adult dog food is$\\,${{field-1}}\n$\\,$than the remaining amount of puppy food because $3\\,\\frac{3}{4}$\n{{field-2}} $\\frac{11}{7}.$" 13194139534987 17592186045417 true] [17592186446983 1072 #uuid "120bfde4-7193-54fa-8c9d-88126da888e7" 13194139534987 17592186045417 true] [17592186446983 1074 "Leonard has $3\\,\\frac{3}{4}\\,\\text{kg}$ of adult dog food and  $\\frac{11}{7}\\,\\text{kg}$ of puppy dog food remaining.\n\nWe cannot compare the fractions directly as they don't have a common denominator.\n\nWe can make a common denominator of $4\\times 7=28.$\n\nTo put $3\\,\\frac{3}{4}$ over a denominator of $28,$ we first convert to an improper fraction and then multiply the numerator and denominator by $7:$\n\n$$\n3\\,\\frac{3}{4}=\\frac{15}{4}=\\frac{15\\times 7}{4\\times 7}=\\frac{105}{28}\n$$\n\nTo put $\\frac{11}{7}$ over a denominator of $28,$ we multiply the numerator and denominator by $4:$\n\n$$\n\\frac{11}{7}=\\frac{11\\times 4}{7\\times 4}=\\frac{44}{28}\n$$\n\nWe can now compare the fractions $\\frac{105}{28}$ and $\\frac{44}{28}$ by looking at the numerators only.\n\nSince $105>44,$ the correct statement must be:\n\n$$\n\\frac{105}{28}>\\frac{44}{28}\n$$\n\nSo, the correct answer is\n> \"After Rocky ate his part of the adult dog food, the remaining amount of adult dog food is $>$than the remaining amount of puppy dog food because $3\\,\\frac{3}{4}>\\frac{11}{7}.$\"" 13194139534987 17592186045417 true] [17592186446984 1068 #edb/ref 17592186446977 13194139534987 17592186045417 true] [17592186446984 1069 "q-134224" 13194139534987 17592186045417 true] [17592186446984 1070 #edb/ref 17592186045485 13194139534987 17592186045417 true] [17592186446984 1071 "Maria, Esther, and Albert each bought $1$ pound of canary seed and $3$ pounds of sunflower seeds. In total, they bought{{field-1}}\n pounds of seeds." 13194139534987 17592186045417 true] [17592186446984 1072 #uuid "1c9c8087-b061-507e-9fec-13a0e9bcaffe" 13194139534987 17592186045417 true] [17592186446984 1074 "We must write and evaluate an expression representing the total number of pounds of seeds.\n\nSince each of them bought a pound of canary seed and $3$ pounds of sunflower seeds, the number of pounds each person bought is:\n\n$$\n{{1}_{⏟}}_{\\text{canary seeds}}+{{3}_{⏟}}_{\\text{sunflower seeds}}\n$$\n\nSince *each* person purchased this amount of seeds, and there are $3$ people, we must multiply the number of pounds of seeds by $3.$ Therefore, the total amount of seeds is:\n\n$$\n{{(1+3)}_{⏟}}_{\\text{each person}}\\times {{3}_{⏟}}_{\\text{people}}\n$$\n\nTo evaluate the expression, we follow the order of operations with parentheses.\n\nFirst, we perform the operations inside the parentheses:\n\n$$\n\\begin{aligned}(1+3)\\times 3 & =(1+3)\\times 3 \\\\  & =4\\times 3.\\end{aligned}\n$$\n\nNow, we multiply:\n\n$$\n4\\times 3=12\n$$" 13194139534987 17592186045417 true] [17592186446985 1068 #edb/ref 17592186446980 13194139534987 17592186045417 true] [17592186446985 1069 "q-134227" 13194139534987 17592186045417 true] [17592186446985 1070 #edb/ref 17592186045485 13194139534987 17592186045417 true] [17592186446985 1071 "Leonard bought $4\\,\\text{kg}$ of adult dog food and $\\frac{11}{7}$ kilograms of puppy dog food. How much dog food did Leonard buy in total? Express your final answer as a mixed number.\n\nLeonard bought$\\,$\n{{field-1}}\n$\\text{kg}$ of dog food in total." 13194139534987 17592186045417 true] [17592186446985 1072 #uuid "54d13d6c-41a6-5a8b-98ff-e263c159a957" 13194139534987 17592186045417 true] [17592186446985 1074 "To find out how much dog food Leonard bought in total, we have to calculate the sum:\n\n$$\n4+\\frac{11}{7}\n$$\n\nTo add $4$ and $\\frac{11}{7},$ we need to express the whole number $4$ as an equivalent fraction with a denominator of $7.$\n\nFirst, we write $4$ as an improper fraction:\n\n$$\n\\frac{4}{1}\n$$\n\nThen we put this fraction over a denominator of $7$ by multiplying the numerator and denominator by $7:$\n\n$$\n\\frac{4\\times 7}{1\\times 7}=\\frac{28}{7}\n$$\n\nSo now, we have to find:\n\n$$\n\\frac{28}{7}+\\frac{11}{7}\n$$\n\nTo add two fractions with like denominators, we add the numerators and keep the denominators the same:\n\n$$\n\\frac{28}{7}+\\frac{11}{7}=\\frac{28+11}{7}=\\frac{39}{7}\n$$\n\nExpressing our answer as a mixed number, we have\n\n$$\n39÷7=5\\,\\text{R}\\,4=5\\,\\frac{4}{7}.\n$$\n\nTherefore, Leonard bought $5\\,\\frac{4}{7}$ $\\text{kg}$ of dog food in total." 13194139534987 17592186045417 true] [17592186446986 1068 #edb/ref 17592186446975 13194139534987 17592186045417 true] [17592186446986 1069 "q-134230" 13194139534987 17592186045417 true] [17592186446986 1070 #edb/ref 17592186045485 13194139534987 17592186045417 true] [17592186446986 1071 "Leonard gave his dog Toby $\\frac{1}{4}$ of the puppy food he bought. What **exact** amount of food did Toby eat?\n\n*Remember that Leonard bought $\\frac{11}{7}$ kilograms of puppy dog food.*\n\nToby ate$\\,$\n{{field-1}}\n$\\,$kilograms of food." 13194139534987 17592186045417 true] [17592186446986 1072 #uuid "5cc5732d-71df-51a9-9fde-261bb49876c6" 13194139534987 17592186045417 true] [17592186446986 1074 "We know that Leonard bought $\\frac{11}{7}$ of a kilogram of puppy dog food.\n\nTo find the fraction of a kilogram that Toby ate, we need to multiply $\\frac{1}{4}$ by $\\frac{11}{7}.$\n\nTo multiply two fractions, we multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{1}{4}\\times \\frac{11}{7}=\\frac{1\\times 11}{4\\times 7}=\\frac{11}{28}.\n$$\n\nTherefore, Toby ate $\\frac{11}{28}$ kilograms of food." 13194139534987 17592186045417 true] [17592186446987 1068 #edb/ref 17592186446974 13194139534987 17592186045417 true] [17592186446987 1069 "q-134228" 13194139534987 17592186045417 true] [17592186446987 1070 #edb/ref 17592186045486 13194139534987 17592186045417 true] [17592186446987 1071 "Of the $4\\,\\text{kg}$ of adult dog food that Leonard bought, he gave his dog Rocky $\\frac{1}{4}$ of a kilogram. As a mixed number, Leonard has{{field-1}}\n$\\text{kg}$ of adult dog food remaining." 13194139534987 17592186045417 true] [17592186446987 1072 #uuid "5e9a72bc-7182-50aa-b33c-312bc9872ece" 13194139534987 17592186045417 true] [17592186446987 1074 "To find out how much adult dog food is remaining, we must calculate the difference $4-\\frac{1}{4}.$\n\nTo subtract $\\frac{1}{4}$ from $4,$ we need to express the whole number $4$ as an equivalent fraction with a denominator of $4.$\n\nFirst, we write $4$ as an improper fraction:\n\n$$\n\\frac{4}{1}\n$$\n\nThen, we put this fraction over a denominator of $4$ by multiplying the numerator and denominator by $4:$\n\n$$\n\\frac{4\\times 4}{1\\times 4}=\\frac{16}{4}\n$$\n\nSo now, we have to find:\n\n$$\n\\frac{16}{4}-\\frac{1}{4}\n$$\n\nTo subtract two fractions with like denominators, we subtract the numerators and keep the denominators the same. Therefore:\n\n$$\n\\frac{16}{4}-\\frac{1}{4}=\\frac{16-1}{4}=\\frac{15}{4}\n$$\n\nFinally, we convert to a mixed number:\n\n$$\n15÷4=3\\,\\text{R}\\,3=3\\,\\frac{3}{4}\n$$\n\nTherefore, Leonard had $3\\,\\frac{3}{4}\\,\\text{kg}$ of adult dog food remaining." 13194139534987 17592186045417 true] [17592186446988 1068 #edb/ref 17592186446973 13194139534987 17592186045417 true] [17592186446988 1069 "q-134226" 13194139534987 17592186045417 true] [17592186446988 1070 #edb/ref 17592186045487 13194139534987 17592186045417 true] [17592186446988 1071 "If Fernando sold all the dog food in $6$ days, and each day he sold the same amount of food, then each day he sold{{field-1}}\n$\\text{kg}$ of dog food." 13194139534987 17592186045417 true] [17592186446988 1072 #uuid "9f31fa20-0ebb-52a7-bbaa-3168885484ca" 13194139534987 17592186045417 true] [17592186446988 1074 "Fernando sold $198\\,\\text{kg}$ of dog food in $6$ days. Since each day he sold the same amount of food, he sold $198÷6$ kilograms of food each day.\n\nWe start by writing down the question using long division notation:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" width=\"150\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"20\">$6$</td>\n<td align=\"center\" colspan=\"2\" height=\"20\" width=\"15\">$\\,\\,\\enclose{longdiv}{1\\,\\phantom{|}9\\,\\phantom{|}8}$</td>\n</tr>\n</tbody></table>\n</td>\n<td align=\"left\" width=\"250\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr height=\"20\">\n<td></td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n</tbody></table>\n\nNotice that $1$ (the number of hundreds in $198$) is less than the divisor $6.$ Therefore, we should consider both the hundreds and tens:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" width=\"150\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"15\">$3$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"20\">$6$</td>\n<td align=\"center\" colspan=\"3\" height=\"20\" width=\"15\">$\\,\\,\\enclose{longdiv}{1\\,\\phantom{|}9\\,\\phantom{|}8}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,\\,\\,\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$8$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$↓$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$8$</td>\n</tr>\n</tbody></table>\n</td>\n<td align=\"left\" width=\"250\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr height=\"20\">\n<td>Divide: $19÷6=3\\,\\text{R}\\,1$</td>\n</tr>\n<tr height=\"20\">\n<td>Write over tens: $3$</td>\n</tr>\n<tr height=\"25\">\n<td>Multiply: $6\\times 3=18$</td>\n</tr>\n<tr height=\"20\">\n<td>Subtract: $19-18=1$</td>\n</tr>\n<tr height=\"25\">\n<td>Bring down: $8$</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n</tbody></table>\n\nNext, we consider the ones:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" width=\"150\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"15\">$3$</td>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"15\">$3$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#EBF5FB\" height=\"20\" width=\"20\">$6$</td>\n<td align=\"center\" colspan=\"3\" height=\"20\" width=\"15\">$\\,\\,\\enclose{longdiv}{1\\,\\phantom{|}9\\,\\phantom{|}8}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,\\,\\,\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$8$</td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$8$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$-\\,\\,\\,\\,\\,$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$1$</td>\n<td align=\"center\" height=\"20\" width=\"15\">$8$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\"></td>\n<td align=\"center\" height=\"20\" width=\"15\">$\\boxed{\\text{0}}$</td>\n</tr>\n</tbody></table>\n</td>\n<td align=\"left\" width=\"250\">\n<table align=\"left\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr height=\"20\">\n<td>Divide: $18÷6=3$</td>\n</tr>\n<tr height=\"20\">\n<td>Write over ones: $3$</td>\n</tr>\n<tr height=\"25\">\n<td>Multiply: $6\\times 3=18$</td>\n</tr>\n<tr height=\"20\">\n<td>Subtract: $18-18=0$</td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n</tbody></table>\n\nWe get the remainder $0$, so the division is done.\n\nTherefore,\n\n$$\n198÷6=33.\n$$" 13194139534987 17592186045417 true] [17592186446989 1068 #edb/ref 17592186446976 13194139534987 17592186045417 true] [17592186446989 1069 "q-134225" 13194139534987 17592186045417 true] [17592186446989 1070 #edb/ref 17592186045487 13194139534987 17592186045417 true] [17592186446989 1071 "Fernando has $11$ dog food packets, each with a weight of $18\\,\\text{kg}.$ In total, Fernando has$\\,${{field-1}}\n$\\text{kg}$ of dog food." 13194139534987 17592186045417 true] [17592186446989 1072 #uuid "e526d16b-2312-5be9-8a0e-4596f38c905d" 13194139534987 17592186045417 true] [17592186446989 1074 "To calculate the total amount of dog food, we need to multiply $11$ by $18.$\n\nSo, we write it this way:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  &  &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  &  &  &  & \\end{aligned}\\end{aligned}\n$$\n\nFirst, we multiply the ones:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned} \\\\ \\boxed{0}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}11\\times 8=88\\end{aligned}\\end{aligned}\n$$\n\nNext, we multiply the tens:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{0}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}11\\times 10=110\\end{aligned}\\end{aligned}\n$$\n\nFinally, we add the results:\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{0}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\,\\end{aligned} & \\,\\, & \\begin{aligned}88+110=198\\end{aligned} \\\\  & \\end{aligned}\n$$\n\nTherefore, $11\\times 18=198.$\n\nTherefore, Fernando has $198\\,\\text{kg}$ of dog food in total." 13194139534987 17592186045417 true] [17592186446990 1058 #edb/ref 17592186446991 13194139534987 17592186045417 true] [17592186446990 1062 #uuid "238c2132-b7ee-533b-afdf-bea1a94d2c44" 13194139534987 17592186045417 true] [17592186446990 1063 #edb/ref 17592186446984 13194139534987 17592186045417 true] [17592186446991 1058 #edb/ref 17592186446995 13194139534987 17592186045417 true] [17592186446991 1062 #uuid "2a90bf0c-3476-5fe2-98ad-02364b9bdeb6" 13194139534987 17592186045417 true] [17592186446991 1063 #edb/ref 17592186446989 13194139534987 17592186045417 true] [17592186446992 1058 #edb/ref 17592186446997 13194139534987 17592186045417 true] [17592186446992 1062 #uuid "40f14adf-712b-5371-ac14-ad0a6b9cfc7e" 13194139534987 17592186045417 true] [17592186446992 1063 #edb/ref 17592186446983 13194139534987 17592186045417 true] [17592186446993 1058 #edb/ref 17592186446992 13194139534987 17592186045417 true] [17592186446993 1062 #uuid "4137f9e4-c2cc-5321-96f9-f09ed29a9d58" 13194139534987 17592186045417 true] [17592186446993 1063 #edb/ref 17592186446987 13194139534987 17592186045417 true] [17592186446994 1062 #uuid "822727a6-778f-54e1-891e-9b9434c62253" 13194139534987 17592186045417 true] [17592186446994 1063 #edb/ref 17592186446981 13194139534987 17592186045417 true] [17592186446995 1058 #edb/ref 17592186446996 13194139534987 17592186045417 true] [17592186446995 1062 #uuid "9c6748ea-37f0-5c60-a207-81cc13f9aa6e" 13194139534987 17592186045417 true] [17592186446995 1063 #edb/ref 17592186446988 13194139534987 17592186045417 true] [17592186446996 1058 #edb/ref 17592186446993 13194139