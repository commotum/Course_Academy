#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186204789} :activity/id #uuid "5956f6cf-ca30-58d2-9ee1-6fa4e250cacf" :activity/scope {:db/id #edb/ref 17592186049287 :topic/id #uuid "ea012716-aa80-521b-a85c-3a4cdebc3bfe" :topic/math-academy-id 4698} :activity/steps [{:db/id #edb/ref 17592186204789 :step/content {:db/id #edb/ref 17592186205225 :tutorial/content "When we divide a whole number by a non-unit fraction, the answer is often not a whole number. \n\nIn this lesson, we'll learn how to solve division problems in these cases using models. The process is similar to cases when the answer is a whole number (we saw this in a previous lesson). The difference now is that we have to deal with a remainder. \n\nTo demonstrate, let's use a model to solve the following division problem:\n\n$$\n{\\color{blue}{1}} \\div \\dfrac{2}{3}\n$$\n\nWe start with a model that represents $\\color{blue}1$ whole:\n\n![](images/bf/bf3da76c75a78c8f2fd64f0ad08a7de339734de12a927d164e7b0b85be5c8bca.png)\n\n \n\nWe need to determine how many times $\\dfrac{\\bbox[2pt, lightgray]{2}}3$ fits into $\\color{blue}1$ whole. So, we proceed as follows:\n\n- First, we split our whole into *thirds* (the denominator of our fraction):\n\n![](images/bf/bfebfebd8b72bbfe256f4cecadaa0b264be7640117b915aa574a485a0091ab09.png)\n\n- Next, we break this into groups of $\\bbox[2pt, lightgray]{2}$:\n\n![](images/ac/ac3eaf757cee480d078152c974e98c9c9470cb0bb4f1ac36aefc973c40edfaef.png)\n\nNote the following:\n\n- We have $\\fbox{1}$ full group. This is the whole number part of our answer.\n\n- We see that there is $\\bbox[2pt, Moccasin]{1}$ piece left over out of a possible group of $\\bbox[2pt, lightgray]{2}.$ So, the fractional part of our answer is \n\n$$\n\\dfrac{\\bbox[2pt, Moccasin]{1}}{\\bbox[2pt, lightgray]{2}}.\n$$\n\nTherefore, the solution to our division problem is as follows:\n\n$$\n1 \\div \\dfrac{2}{3} = \\fbox{1} \\, \\dfrac{\\bbox[2pt, Moccasin]{1}}{\\bbox[2pt, lightgray]{2}}\n$$\n\nLet's see another example." :tutorial/id #uuid "ba2190d9-d8e4-5d70-902a-fb76e0985e5d" :tutorial/math-academy-id 8812 :tutorial/title "Introduction"} :step/id #uuid "fb2d5453-bf96-5349-9538-5fa183ce9885" :step/math-academy-id 195193 :step/next {:db/id #edb/ref 17592186204790}} {:db/id #edb/ref 17592186204790 :step/content {:db/id #edb/ref 17592186203967 :knowledge-point/canonical-example {:db/id #edb/ref 17592186203677 :question/id #uuid "0cecb07f-726d-5d91-8cef-a865aa0feecf" :question/math-academy-id "e-14204"} :knowledge-point/id #uuid "d71689a0-2245-5bb4-97fb-47accd5ae8aa" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048987}] :knowledge-point/questions [{:db/id #edb/ref 17592186204371} {:db/id #edb/ref 17592186204372} {:db/id #edb/ref 17592186441020} {:db/id #edb/ref 17592186441024} {:db/id #edb/ref 17592186441025} {:db/id #edb/ref 17592186441026} {:db/id #edb/ref 17592186441029}] :knowledge-point/title "Finding the Remainder in a Division Problem"} :step/id #uuid "c5009403-d4d6-5b89-8c2e-15432efa8c66" :step/math-academy-id 195194 :step/next {:db/id #edb/ref 17592186204791}} {:db/id #edb/ref 17592186204791 :step/content {:db/id #edb/ref 17592186203968 :knowledge-point/canonical-example {:db/id #edb/ref 17592186203679 :question/id #uuid "89b0b6f9-d6e3-5311-9002-6f6a09b60692" :question/math-academy-id "e-14551"} :knowledge-point/id #uuid "318e702c-5064-5160-aba1-98c52bc9a343" :knowledge-point/questions [{:db/id #edb/ref 17592186204373} {:db/id #edb/ref 17592186204374} {:db/id #edb/ref 17592186441021} {:db/id #edb/ref 17592186441022} {:db/id #edb/ref 17592186441023} {:db/id #edb/ref 17592186441027} {:db/id #edb/ref 17592186441028}] :knowledge-point/title "Dividing a Whole Number by a Non-Unit Fraction"} :step/id #uuid "709abbf7-e660-58aa-b185-632b0c5fc053" :step/math-academy-id 195197}] :activity/title "Dividing Whole Numbers by Fractions Using Models: Fractional Results" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186204108}]}
