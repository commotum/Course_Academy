e]} {:db/id "answer-2062ec2e-6ea0-5886-9ea1-2982b7518d73" :answer/id #uuid "2062ec2e-6ea0-5886-9ea1-2982b7518d73" :answer/type :answer.type/math :answer/value "9x-24" :db/ensure [:answer/validate]} {:db/id "answer-103f9062-da47-5182-afeb-c9ad093838c7" :answer/id #uuid "103f9062-da47-5182-afeb-c9ad093838c7" :answer/type :answer.type/math :answer/value "9x-30" :db/ensure [:answer/validate]} {:db/id "question-b5638b69-5ebf-5535-be80-7df47257978d" :question/id #uuid "b5638b69-5ebf-5535-be80-7df47257978d" :question/math-academy-id "q-178209" :question/problem "$8q+(6p+5q)\\cdot (-2)=${{field-1}}\n$q\\,-$\n{{field-2}}$p$" :question/worked-solution "First, we distribute the $(-2)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}8q+(6p+5q)\\cdot (-2) & = \\\\ 8q+6p\\cdot (-2)+5q\\cdot (-2) & = \\\\ 8q+(-12p)+(-10q) & = \\\\ 8q-12p-10q\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}8q-12p-10q & = \\\\ (8q-10q)-12p & = \\\\ -2\\,q-12\\,p & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9aef909f-9875-5898-a002-8ddee1bd1d06" "answer-field-4bf27c0f-6bb4-565f-8a4a-5647f2c2e5c9"] :db/ensure [:question/validate]} {:db/id "answer-field-9aef909f-9875-5898-a002-8ddee1bd1d06" :answer-field/id #uuid "9aef909f-9875-5898-a002-8ddee1bd1d06" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-794e8648-3541-5b24-a9e5-9cc6e863dd29" :answer-field/choices ["answer-794e8648-3541-5b24-a9e5-9cc6e863dd29"] :db/ensure [:answer-field/validate]} {:db/id "answer-794e8648-3541-5b24-a9e5-9cc6e863dd29" :answer/id #uuid "794e8648-3541-5b24-a9e5-9cc6e863dd29" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-field-4bf27c0f-6bb4-565f-8a4a-5647f2c2e5c9" :answer-field/id #uuid "4bf27c0f-6bb4-565f-8a4a-5647f2c2e5c9" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ed5c130f-e9d0-56ca-9073-74b2989bdd1e" :answer-field/choices ["answer-ed5c130f-e9d0-56ca-9073-74b2989bdd1e"] :db/ensure [:answer-field/validate]} {:db/id "answer-ed5c130f-e9d0-56ca-9073-74b2989bdd1e" :answer/id #uuid "ed5c130f-e9d0-56ca-9073-74b2989bdd1e" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "question-e47c7dff-9b13-5c86-8db2-973382940a0f" :question/id #uuid "e47c7dff-9b13-5c86-8db2-973382940a0f" :question/math-academy-id "q-171506" :question/problem "$6(5r-2s)-11r=${{field-1}}\n$r\\,-$\n{{field-2}}\n$s$" :question/worked-solution "First, we distribute the $6$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}6(5r-2s)-11r & = \\\\ 6\\cdot 5r+6\\cdot (-2s)-11r & = \\\\ (30r)+(-12s)-11r & = \\\\ 30r-12s-11r\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}30r-12s-11r & = \\\\ (30r-11r)-12s & = \\\\ 19\\,r-12\\,s\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cc2ae0a2-ee34-5f4a-876c-d99e9dd3e5a9" "answer-field-9021c7bc-4c7b-585d-869d-41b5dfa7c20a"] :db/ensure [:question/validate]} {:db/id "answer-field-cc2ae0a2-ee34-5f4a-876c-d99e9dd3e5a9" :answer-field/id #uuid "cc2ae0a2-ee34-5f4a-876c-d99e9dd3e5a9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ac862b3f-7d8f-5607-8d18-0d3d1d3094cf" :answer-field/choices ["answer-ac862b3f-7d8f-5607-8d18-0d3d1d3094cf"] :db/ensure [:answer-field/validate]} {:db/id "answer-ac862b3f-7d8f-5607-8d18-0d3d1d3094cf" :answer/id #uuid "ac862b3f-7d8f-5607-8d18-0d3d1d3094cf" :answer/type :answer.type/math :answer/value "19" :db/ensure [:answer/validate]} {:db/id "answer-field-9021c7bc-4c7b-585d-869d-41b5dfa7c20a" :answer-field/id #uuid "9021c7bc-4c7b-585d-869d-41b5dfa7c20a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-db56b20a-9dfe-5b08-b2d7-2721edb4e287" :answer-field/choices ["answer-db56b20a-9dfe-5b08-b2d7-2721edb4e287"] :db/ensure [:answer-field/validate]} {:db/id "answer-db56b20a-9dfe-5b08-b2d7-2721edb4e287" :answer/id #uuid "db56b20a-9dfe-5b08-b2d7-2721edb4e287" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "question-e474bc44-1cd0-59d9-b243-4f2f3cc65ac2" :question/id #uuid "e474bc44-1cd0-59d9-b243-4f2f3cc65ac2" :question/math-academy-id "q-178218" :question/problem "$24+(2z-5)\\cdot 6=${{field-1}}\n$z\\,-$\n{{field-2}}" :question/worked-solution "First, we distribute the $6$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}24+(2z-5)\\cdot 6 & = \\\\ 24+2z\\cdot 6+(-5)\\cdot 6 & = \\\\ 24+(12z)+(-30) & = \\\\ 24+12z-30\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}24+12z-30 & = \\\\ 12z+(24-30) & = \\\\ 12\\,z-6\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b84647f2-ac9c-5c51-982c-4fa8d5f75fba" "answer-field-e80cfec4-0e29-5423-83b6-ed31cf9a77ef"] :db/ensure [:question/validate]} {:db/id "answer-field-b84647f2-ac9c-5c51-982c-4fa8d5f75fba" :answer-field/id #uuid "b84647f2-ac9c-5c51-982c-4fa8d5f75fba" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bff6ab0f-4ae0-5878-b4ad-0497ac39aaac" :answer-field/choices ["answer-bff6ab0f-4ae0-5878-b4ad-0497ac39aaac"] :db/ensure [:answer-field/validate]} {:db/id "answer-bff6ab0f-4ae0-5878-b4ad-0497ac39aaac" :answer/id #uuid "bff6ab0f-4ae0-5878-b4ad-0497ac39aaac" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-field-e80cfec4-0e29-5423-83b6-ed31cf9a77ef" :answer-field/id #uuid "e80cfec4-0e29-5423-83b6-ed31cf9a77ef" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5d4be023-588f-5af7-9ee0-e745258d0a0f" :answer-field/choices ["answer-5d4be023-588f-5af7-9ee0-e745258d0a0f"] :db/ensure [:answer-field/validate]} {:db/id "answer-5d4be023-588f-5af7-9ee0-e745258d0a0f" :answer/id #uuid "5d4be023-588f-5af7-9ee0-e745258d0a0f" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186056008 :tutorial/content "To simplify an expression containing parentheses, we expand the parentheses and then collect like terms. \n\nFor example, let's simplify the following expression: \n\n$$\n3(x + 2) + 4x\n$$\n\n \n\nOur first step is to distribute the $3$ over each of the terms in the parentheses:\n\n$$\n\\eqalign{\n\t\t3(x + 2) + 4x &= \\[5pt]\n\t\t3\\cdot x + 3\\cdot 2 + 4x &= \\[5pt]\n\t\t(3x) + (6) + 4x &= \\[5pt]\n\t\t3x +6 + 4x &\n\t}\n$$\n\nThe second and final step is to collect the like terms:\n\n$$\n\\eqalign{\n\t\t3x + 6 + 4x &= \\\n\t\t(3x + 4x) + 6 &= \\\n\t\t7x + 6\n\t}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186054888 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
