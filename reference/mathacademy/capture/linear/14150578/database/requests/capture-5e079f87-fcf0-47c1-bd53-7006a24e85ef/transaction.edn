[{:db/id 17592186054785 :knowledge-point/questions ["question-9f3e05f4-cb27-5e49-a3d4-eb04dbfb774a" "question-489d9c99-8ab0-55bf-92f6-f4551a5834d4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054378 :question/problem "Simplify $(4+c)\\cdot 3-8.$" :question/worked-solution "First, we distribute the $3$ over each of the terms in parentheses.\n\n$$\n\\eqalign{\n\t\t(4+c)\\cdot 3-8 &= \\[5pt]\n\t\t4\\cdot3+c\\cdot 3-8 &= \\[5pt]\n\t\t(12)+(3c)-8 &= \\[5pt]\n\t\t12+3c-8 &\n\t}\n$$\n\nThen, we collect like terms.\n\n$$\n\\eqalign{\n\t\t12+3c-8 &= \\[5pt]\n\t\t3c +(12-8)&= \\[5pt]\n\t\t3c+4\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186054786 :knowledge-point/questions ["question-9b4aad86-ceca-53db-a793-7c0f3aa34c98" "question-b5638b69-5ebf-5535-be80-7df47257978d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054379 :question/worked-solution "First, we distribute the $(-4)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}(-4)(8x+7y)+30y & = \\\\ (-4)\\cdot 8x+(-4)\\cdot 7y+30y & = \\\\ (-32x)+(-28y)+30y & = \\\\ -32x-28y+30y\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}\\begin{aligned}-32x-28y+30y & = \\\\ -32x+(-28y+30y) & = \\\\ -32x+2y\\end{aligned}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186054787 :knowledge-point/questions ["question-e47c7dff-9b13-5c86-8db2-973382940a0f" "question-e474bc44-1cd0-59d9-b243-4f2f3cc65ac2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054380 :question/worked-solution "First, we distribute the $3$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}(5-y)\\cdot 3-10 & = \\\\ 5\\cdot 3+(-y)\\cdot 3-10 & = \\\\ (15)+(-3y)-10 & = \\\\ 15-3y-10\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}15-3y-10 & = \\\\ (15-10)-3y & = \\\\ 5-3y\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-9f3e05f4-cb27-5e49-a3d4-eb04dbfb774a" :question/id #uuid "9f3e05f4-cb27-5e49-a3d4-eb04dbfb774a" :question/math-academy-id "q-173714" :question/problem "$2(4p+2q)+5q=${{field-1}}\n$p\\,+$\n{{field-2}}\n$q$" :question/worked-solution "First, we distribute the $2$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}2(4p+2q)+5p & = \\\\ 2\\cdot 4p+2\\cdot 2q+5q & = \\\\ (8p)+(4q)+5q & = \\\\ 8p+4q+5q & \\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}8p+4q+5q & = \\\\ 8p+(4q+5q) & = \\\\ 8\\,p+9\\,q\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d7d6dcb2-f183-5270-b411-dec03c1bb185" "answer-field-c5de4592-c46f-5c9f-8ced-9f33f253465f"] :db/ensure [:question/validate]} {:db/id "answer-field-d7d6dcb2-f183-5270-b411-dec03c1bb185" :answer-field/id #uuid "d7d6dcb2-f183-5270-b411-dec03c1bb185" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a61dca96-0242-5f31-b4f6-62a0549ec52a" :answer-field/choices ["answer-a61dca96-0242-5f31-b4f6-62a0549ec52a"] :db/ensure [:answer-field/validate]} {:db/id "answer-a61dca96-0242-5f31-b4f6-62a0549ec52a" :answer/id #uuid "a61dca96-0242-5f31-b4f6-62a0549ec52a" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-field-c5de4592-c46f-5c9f-8ced-9f33f253465f" :answer-field/id #uuid "c5de4592-c46f-5c9f-8ced-9f33f253465f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f51e501d-27ce-5a2d-931a-16650943cff4" :answer-field/choices ["answer-f51e501d-27ce-5a2d-931a-16650943cff4"] :db/ensure [:answer-field/validate]} {:db/id "answer-f51e501d-27ce-5a2d-931a-16650943cff4" :answer/id #uuid "f51e501d-27ce-5a2d-931a-16650943cff4" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-489d9c99-8ab0-55bf-92f6-f4551a5834d4" :question/id #uuid "489d9c99-8ab0-55bf-92f6-f4551a5834d4" :question/math-academy-id "q-109138" :question/problem "$-12u+6(v+2u)=$" :question/worked-solution "First, we distribute the $6$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}-12u+6(v+2u) & = \\\\ -12u+6\\cdot v+6\\cdot 2u & = \\\\ -12u+(6v)+(12u) & = \\\\ -12u+6v+12u & \\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}\\begin{aligned}-12u+6v+12u & = \\\\ (12u-12u)+6v & = \\\\ 6v\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-801067a1-ea9d-532a-83b6-e698ec2e0dfc"] :db/ensure [:question/validate]} {:db/id "answer-field-801067a1-ea9d-532a-83b6-e698ec2e0dfc" :answer-field/id #uuid "801067a1-ea9d-532a-83b6-e698ec2e0dfc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-af83ac0c-c1cb-54aa-87ae-ec0121734c7d" :answer-field/choices ["answer-c284bca0-24a9-5ba9-a08f-a375497c5e6c" "answer-176bdac9-ff3f-5845-8405-f633b7af7f30" "answer-7210f3ed-27cb-51f2-9e9c-683e7447f7e5" "answer-3b565d49-7d79-5c57-b2e7-974f317a45dd" "answer-af83ac0c-c1cb-54aa-87ae-ec0121734c7d"] :db/ensure [:answer-field/validate]} {:db/id "answer-c284bca0-24a9-5ba9-a08f-a375497c5e6c" :answer/id #uuid "c284bca0-24a9-5ba9-a08f-a375497c5e6c" :answer/type :answer.type/math :answer/value "-10u+6v" :db/ensure [:answer/validate]} {:db/id "answer-176bdac9-ff3f-5845-8405-f633b7af7f30" :answer/id #uuid "176bdac9-ff3f-5845-8405-f633b7af7f30" :answer/type :answer.type/math :answer/value "-24u+6v" :db/ensure [:answer/validate]} {:db/id "answer-7210f3ed-27cb-51f2-9e9c-683e7447f7e5" :answer/id #uuid "7210f3ed-27cb-51f2-9e9c-683e7447f7e5" :answer/type :answer.type/math :answer/value "-24u-6v" :db/ensure [:answer/validate]} {:db/id "answer-3b565d49-7d79-5c57-b2e7-974f317a45dd" :answer/id #uuid "3b565d49-7d79-5c57-b2e7-974f317a45dd" :answer/type :answer.type/math :answer/value "24u-6v" :db/ensure [:answer/validate]} {:db/id "answer-af83ac0c-c1cb-54aa-87ae-ec0121734c7d" :answer/id #uuid "af83ac0c-c1cb-54