#{[{:db/id #edb/ref 17592186054378 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054785 :knowledge-point/id #uuid "5e4e59ce-cc8a-5146-b78a-edbdd04909d0" :knowledge-point/title "Simplifying Linear Expressions With Positive Numbers in Parentheses"}] :question/id #uuid "f0bfc0e7-0db2-501d-a7b5-c7d14378ff85" :question/math-academy-id "e-12802" :question/problem "Simplify $(4+c)\\cdot 3-8.$" :question/worked-solution "First, we distribute the $3$ over each of the terms in parentheses.\n\n$$\n\\eqalign{\n\t\t(4+c)\\cdot 3-8 &= \\[5pt]\n\t\t4\\cdot3+c\\cdot 3-8 &= \\[5pt]\n\t\t(12)+(3c)-8 &= \\[5pt]\n\t\t12+3c-8 &\n\t}\n$$\n\nThen, we collect like terms.\n\n$$\n\\eqalign{\n\t\t12+3c-8 &= \\[5pt]\n\t\t3c +(12-8)&= \\[5pt]\n\t\t3c+4\n\t}\n$$"}] [{:db/id #edb/ref 17592186054379 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054786 :knowledge-point/id #uuid "8ffb0f82-65ba-5522-93a4-193c9a794a71" :knowledge-point/title "Simplifying Linear Expressions With Positive Numbers in Parentheses: Distributing a Negative Number"}] :question/id #uuid "0ca08034-c65f-59ec-8ede-9721182eb989" :question/math-academy-id "e-12803" :question/problem "$(-4)(8x+7y) +30y=$" :question/worked-solution "First, we distribute the $(-4)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}(-4)(8x+7y)+30y & = \\\\ (-4)\\cdot 8x+(-4)\\cdot 7y+30y & = \\\\ (-32x)+(-28y)+30y & = \\\\ -32x-28y+30y\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}\\begin{aligned}-32x-28y+30y & = \\\\ -32x+(-28y+30y) & = \\\\ -32x+2y\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054380 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054787 :knowledge-point/id #uuid "fa6b39a9-8665-5135-8637-05d811fc4030" :knowledge-point/title "Simplifying Linear Expressions With Negative Numbers in Parentheses"}] :question/id #uuid "fdc27ed5-386d-5fd9-bbf7-4847499c6181" :question/math-academy-id "e-12804" :question/problem "Simplify $(5 - y) \\cdot 3 - 10$" :question/worked-solution "First, we distribute the $3$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}(5-y)\\cdot 3-10 & = \\\\ 5\\cdot 3+(-y)\\cdot 3-10 & = \\\\ (15)+(-3y)-10 & = \\\\ 15-3y-10\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}15-3y-10 & = \\\\ (15-10)-3y & = \\\\ 5-3y\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186445776 :knowledge-point/_questions [{:db/id #edb/ref 17592186054785 :knowledge-point/id #uuid "5e4e59ce-cc8a-5146-b78a-edbdd04909d0" :knowledge-point/title "Simplifying Linear Expressions With Positive Numbers in Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "176bdac9-ff3f-5845-8405-f633b7af7f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24u+6v" :db/id #edb/ref 17592186445749} {:answer/id #uuid "3b565d49-7d79-5c57-b2e7-974f317a45dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24u-6v" :db/id #edb/ref 17592186445751} {:answer/id #uuid "7210f3ed-27cb-51f2-9e9c-683e7447f7e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24u-6v" :db/id #edb/ref 17592186445754} {:answer/id #uuid "af83ac0c-c1cb-54aa-87ae-ec0121734c7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6v" :db/id #edb/ref 17592186445758} {:answer/id #uuid "c284bca0-24a9-5ba9-a08f-a375497c5e6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10u+6v" :db/id #edb/ref 17592186445760}] :answer-field/correct {:answer/id #uuid "af83ac0c-c1cb-54aa-87ae-ec0121734c7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6v" :db/id #edb/ref 17592186445758} :answer-field/id #uuid "801067a1-ea9d-532a-83b6-e698ec2e0dfc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445767}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "489d9c99-8ab0-55bf-92f6-f4551a5834d4" :question/math-academy-id "q-109138" :question/problem "$-12u+6(v+2u)=$" :question/worked-solution "First, we distribute the $6$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}-12u+6(v+2u) & = \\\\ -12u+6\\cdot v+6\\cdot 2u & = \\\\ -12u+(6v)+(12u) & = \\\\ -12u+6v+12u & \\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}\\begin{aligned}-12u+6v+12u & = \\\\ (12u-12u)+6v & = \\\\ 6v\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186445777 :knowledge-point/_questions [{:db/id #edb/ref 17592186054786 :knowledge-point/id #uuid "8ffb0f82-65ba-5522-93a4-193c9a794a71" :knowledge-point/title "Simplifying Linear Expressions With Positive Numbers in Parentheses: Distributing a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "103f9062-da47-5182-afeb-c9ad093838c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9x-30" :db/id #edb/ref 17592186445748} {:answer/id #uuid "2062ec2e-6ea0-5886-9ea1-2982b7518d73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9x-24" :db/id #edb/ref 17592186445750} {:answer/id #uuid "4990eec0-e8b7-58fc-9dd4-474871d06010" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12x-30" :db/id #edb/ref 17592186445752} {:answer/id #uuid "eaba6084-cc83-5251-a5a7-3f9f51a5706a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18x+6" :db/id #edb/ref 17592186445762} {:answer/id #uuid "f8712647-d78c-5643-b30a-d695b2da020f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12x+6" :db/id #edb/ref 17592186445765}] :answer-field/correct {:answer/id #uuid "4990eec0-e8b7-58fc-9dd4-474871d06010" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12x-30" :db/id #edb/ref 17592186445752} :answer-field/id #uuid "83285247-7ed1-536a-a45b-05082f8248bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b4aad86-ceca-53db-a793-7c0f3aa34c98" :question/math-academy-id "q-141930" :question/problem "$6x+(3x+5)\\cdot (-6)=$" :question/worked-solution "First, we distribute the $(-6)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}6x+(3x+5)\\cdot (-6) & = \\\\ 6x+3x\\cdot (-6)+5\\cdot (-6) & = \\\\ 6x+(-18x)+(-30) & = \\\\ 6x-18x-30\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n \n\n$$\n\\begin{aligned}6x-18x-30 & = \\\\ (6x-18x)-30 & = \\\\ -12x-30 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186445781 :knowledge-point/_questions [{:db/id #edb/ref 17592186054787 :knowledge-point/id #uuid "fa6b39a9-8665-5135-8637-05d811fc4030" :knowledge-point/title "Simplifying Linear Expressions With Negative Numbers in Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db56b20a-9dfe-5b08-b2d7-2721edb4e287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186445761}] :answer-field/correct {:answer/id #uuid "db56b20a-9dfe-5b08-b2d7-2721edb4e287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186445761} :answer-field/id #uuid "9021c7bc-4c7b-585d-869d-41b5dfa7c20a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186445769} {:answer-field/choices [{:answer/id #uuid "ac862b3f-7d8f-5607-8d18-0d3d1d3094cf" :answer/type {:db/id #edb/re