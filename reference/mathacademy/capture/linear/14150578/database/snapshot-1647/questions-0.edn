#{[{:db/id #edb/ref 17592186054378 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054785 :knowledge-point/id #uuid "5e4e59ce-cc8a-5146-b78a-edbdd04909d0" :knowledge-point/title "Simplifying Linear Expressions With Positive Numbers in Parentheses"}] :question/id #uuid "f0bfc0e7-0db2-501d-a7b5-c7d14378ff85" :question/math-academy-id "e-12802" :question/problem "Simplify $(4+c)\\cdot 3-8$." :question/worked-solution "First, we distribute the $3$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned} (4+c)\\cdot 3-8 \\\\[5pt] &= 4\\cdot3+c\\cdot 3-8 \\\\[5pt] &= (12)+(3c)-8 \\\\[5pt] &= 12+3c-8 & \\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned} 12+3c-8 \\\\[5pt] &= 3c +(12-8) \\\\[5pt] &= 3c+4 \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054379 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054786 :knowledge-point/id #uuid "8ffb0f82-65ba-5522-93a4-193c9a794a71" :knowledge-point/title "Simplifying Linear Expressions With Positive Numbers in Parentheses: Distributing a Negative Number"}] :question/id #uuid "0ca08034-c65f-59ec-8ede-9721182eb989" :question/math-academy-id "e-12803" :question/problem "$(-4)(8x+7y) +30y=$" :question/worked-solution "First, we distribute the $(-4)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\n(-4)(8x + 7y) + 30y &=  \\\\\n(-4) \\cdot 8x + (-4) \\cdot 7y + 30y &=  \\\\\n(-32x) + (-28y) + 30y &=  \\\\\n&= - 32x - 28y + 30y\n\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}\n-32x - 28y + 30y &=  \\\\\n- 32x + (-28y + 30y) &=  \\\\\n&= - 32x + 2y\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054380 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054787 :knowledge-point/id #uuid "fa6b39a9-8665-5135-8637-05d811fc4030" :knowledge-point/title "Simplifying Linear Expressions With Negative Numbers in Parentheses"}] :question/id #uuid "fdc27ed5-386d-5fd9-bbf7-4847499c6181" :question/math-academy-id "e-12804" :question/problem "Simplify $(5 - y) \\cdot 3 - 10$" :question/worked-solution "First, we distribute the $3$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\n(5 - y) \\cdot 3 - 10 &=  \\\\\n5 \\cdot 3 + (-y) \\cdot 3 - 10 &=  \\\\\n(15) + (-3y) - 10 &=  \\\\\n&= 15 - 3y - 10\n\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}\n15 - 3y - 10 &=  \\\\\n(15 - 10) - 3y &=  \\\\\n&= 5 - 3y\n\\end{aligned}\n$$"}]}
