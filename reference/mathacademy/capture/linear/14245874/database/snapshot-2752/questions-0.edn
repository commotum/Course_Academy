#{[{:db/id #edb/ref 17592186180296 :knowledge-point/_questions [{:db/id #edb/ref 17592186179680 :knowledge-point/id #uuid "f1e9abbc-b0b5-51a6-b23b-a32a027382f3" :knowledge-point/title "Solving Equations Containing an Expression Raised to an Odd Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2f71584-e930-53ee-b586-0e3133771dab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186179321} {:answer/id #uuid "5ab8c055-ea9d-5540-81ab-2dd3afb58dc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186179322} {:answer/id #uuid "5e8b8815-feff-5dbb-b722-410093a45a1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186179323} {:answer/id #uuid "699e6966-53d4-5218-bca9-f122c0e0dc40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186179324} {:answer/id #uuid "7253e80a-a034-5926-8005-bbcfd67e0155" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186179325}] :answer-field/correct {:answer/id #uuid "e2f71584-e930-53ee-b586-0e3133771dab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186179321} :answer-field/id #uuid "f47acc13-93e7-5be5-891c-f394fc5d2e8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186179320}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c66a4d95-de66-5d58-9163-57438e7f73ef" :question/math-academy-id "q-90945" :question/problem "Find the real solution to the equation $2(x+4)^{3}=686.$" :question/requires-calculator true :question/worked-solution "We can solve this equation by isolating the $(x+4)^{3}$ term and then taking the $3$rd root of each side.\n\nFirst, let's isolate the $(x+4)^{3}$ term on the left-hand side:\n\n$$\n\\begin{aligned}2(x+4)^{3} & =686 \\\\ (x+4)^{3} & =343\\end{aligned}\n$$\n\nNow, we take the $3$rd root of each side and solve for $x.$ Since $n=3$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}(x+4)^{3} & =343 \\\\ \\sqrt[3]{(x+4)^{3}} & =\\sqrt[3]{343} \\\\ x+4 & =\\sqrt[3]{{7}^{3}} \\\\ x+4 & =7 \\\\ x & =3\\end{aligned}\n$$\n\nTherefore, the solution is $x=3.$"}] [{:db/id #edb/ref 17592186563756 :knowledge-point/_questions [{:db/id #edb/ref 17592186179681 :knowledge-point/id #uuid "98f98657-c9c6-5b38-825c-992bcf28d9e3" :knowledge-point/title "Solving Equations With Odd Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097ae540-a1c3-563f-958f-879f687d07c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186562959} {:answer/id #uuid "27ed339f-1ba9-5371-b98d-4f3e5a4957d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186563033} {:answer/id #uuid "4b16ec7e-f0ec-57c4-b0d0-1fe68110981c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186563110} {:answer/id #uuid "7356e8b2-c698-5246-b83e-adcafee91941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186563201} {:answer/id #uuid "7375c3cd-5447-5289-b4b3-d26964bf0961" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no real solution" :db/id #edb/ref 17592186563202}] :answer-field/correct {:answer/id #uuid "097ae540-a1c3-563f-958f-879f687d07c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186562959} :answer-field/id #uuid "76b0b8d7-ead0-5e0b-96f7-c011cf47b3ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563576}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee997e26-088f-52b1-8913-d296b8992e92" :question/math-academy-id "q-91348" :question/problem "Find the real solution to the equation ${x}^{7}=-\\frac{1}{128}.$" :question/worked-solution "We can solve this equation by taking the $7$th root of each side and solving for $x.$ Since $n=7$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}{x}^{7} & =-\\frac{1}{128} \\\\ \\sqrt[7]{{x}^{7}} & =\\sqrt[7]{(-\\frac{1}{128})} \\\\ x & =\\sqrt[7]{{(-\\frac{1}{2})}^{7}} \\\\ x & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the solution is $x=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186563665 :knowledge-point/_questions [{:db/id #edb/ref 17592186179680 :knowledge-point/id #uuid "f1e9abbc-b0b5-51a6-b23b-a32a027382f3" :knowledge-point/title "Solving Equations Containing an Expression Raised to an Odd Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25486f62-97da-5109-9737-87f525d30db1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186563029} {:answer/id #uuid "2c8f8e6f-e697-5bb7-bf75-2e4331631d5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186563046} {:answer/id #uuid "51605067-0787-53ee-aaf2-ba1451c7298b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186563130} {:answer/id #uuid "6fcb20f0-7b84-5ab6-9881-9ca58e2d8984" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186563198} {:answer/id #uuid "a22620b9-3627-519a-9fcf-882b66fb2509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186563311}] :answer-field/correct {:answer/id #uuid "a22620b9-3627-519a-9fcf-882b66fb2509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186563311} :answer-field/id #uuid "8dda18e4-efa2-53cb-b386-72e8b9f7b0ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563592}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "351787b8-999c-59c8-b44f-8fe6c60247fb" :question/math-academy-id "q-91369" :question/problem "Find the real solution to the equation $(x-3)^{7}=-128.$" :question/worked-solution "We can solve this equation by taking the $7$th root of each side and solving for $x.$\nSince $n=7$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}(x-3)^{7} & =-128 \\\\ \\sqrt[7]{(x-3)^{7}} & =\\sqrt[7]{-128} \\\\ x-3 & =\\sqrt[7]{(-2)^{7}} \\\\ x-3 & =-2 \\\\ x & =1\\end{aligned}\n$$\n\nTherefore, the solution is $x=1.$"}]}
