#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186554748} :activity/id #uuid "c327bea7-f4fd-595a-8810-8984b4d4dea4" :activity/scope {:db/id #edb/ref 17592186049394 :topic/id #uuid "f121c6bf-38c7-56a2-930a-199717f2bc16" :topic/math-academy-id 398} :activity/steps [{:db/id #edb/ref 17592186554691 :step/content {:db/id #edb/ref 17592186554551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba7df070-8dc6-516c-b876-bba86140442c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186554275}] :answer-field/correct {:db/id #edb/ref 17592186554275} :answer-field/id #uuid "1f8264ee-8699-5a8d-b7d1-b9e37462db15" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186554446} {:answer-field/choices [{:answer/id #uuid "166db386-af1b-59c2-a6a5-51f8af225a25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186553912}] :answer-field/correct {:db/id #edb/ref 17592186553912} :answer-field/id #uuid "c136b416-aa9d-59c9-87d0-e2fd3b968a46" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186554509}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2546e8f7-eee4-51d1-b227-0107b1dc1dff" :question/math-academy-id "q-175915" :question/problem "The equation of the line that passes through the points $(2,8)$ and $(4,4)$ is $\\,y=${{field-1}}\n$x\\,+$\n{{field-2}}." :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So, we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFirst, we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{4-8}{4-2} \\\\  & =\\frac{-4}{2} \\\\  & =-2\\end{aligned}\n$$\n\nSubstituting the slope $m=-2$ into the slope-intercept formula $y=mx+b,$ we reach\n\n$$\ny=-2x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(4,4):$\n\n$$\n\\begin{aligned}y & =-2x+b \\\\ 4 & =-2(4)+b \\\\ 4 & =-8+b \\\\ 4+8 & =b \\\\ 12 & =b\\end{aligned}\n$$\n\nSo the equation of the line is $y=-2\\,x+12.$"} :step/id #uuid "80da2ac9-41e1-52d3-9494-12a39d637e6f"} {:db/id #edb/ref 17592186554731 :step/content {:db/id #edb/ref 17592186554630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18fc2bc0-bf6d-5c95-b25a-160e38ec578c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186553916}] :answer-field/correct {:db/id #edb/ref 17592186553916} :answer-field/id #uuid "63e4ab55-d0a1-5786-9cc7-b2293a0bf11d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186554469} {:answer-field/choices [{:answer/id #uuid "972b3e5e-b37b-5a4f-991f-145fed1af8e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186554202}] :answer-field/correct {:db/id #edb/ref 17592186554202} :answer-field/id #uuid "80d521d4-3885-53d4-af2a-71f3adfd567c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186554485}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e629f775-4d70-5fe8-b2f0-8f18384b864c" :question/math-academy-id "q-171725" :question/problem "A horizontal line $l$ passes through the point $(-3,2).$ What are the coordinates of the $y$-intercept of $l?$\n\nThe coordinates of the $y$-intercept of $l$ are\n$($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "On any horizontal line, all points have the same $y$-coordinate.\n\nThe $y$-coordinate of the point $(-3,2)$ is $2,$ so the $y$-coordinate of the $y$-intercept is also $2.$\n\nTherefore, the coordinates of the $y$-intercept are $(0,2).$"} :step/id #uuid "c527ad9d-45ff-5250-97c1-54d0f5d7abf9" :step/next {:db/id #edb/ref 17592186554691}} {:db/id #edb/ref 17592186554748 :step/content {:db/id #edb/ref 17592186554614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b155884-63bf-5f91-b031-664e4e3e1a13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,0)" :db/id #edb/ref 17592186554044} {:answer/id #uuid "6fe93805-e84e-5076-bf14-f2778b50b1b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,0)" :db/id #edb/ref 17592186554096} {:answer/id #uuid "89e9239d-84c4-5c3b-8534-6d11bbbf7dca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no $y$-intercept" :db/id #edb/ref 17592186554160} {:answer/id #uuid "a7ae48a6-8e60-521c-ae3d-ed5a35430fa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,4)" :db/id #edb/ref 17592186554240} {:answer/id #uuid "fb242ae4-7619-5609-9b5f-113d3833b245" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,5)" :db/id #edb/ref 17592186554411}] :answer-field/correct {:db/id #edb/ref 17592186554240} :answer-field/id #uuid "15c11955-b9c8-5da1-a467-21fb40fdcf4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554440}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aa2d0b41-12c5-5cc7-a265-9b2befe09045" :question/math-academy-id "q-31605" :question/problem "A horizontal line $l$ passes through the point $(5,4).$ Calculate the coordinates of the $y$-intercept of $l.$" :question/worked-solution "On any horizontal line, all points have the same $y$-coordinate.\n\nThe $y$-coordinate of the point $(5,4)$ is $4,$ so the $y$-coordinate of the $y$-intercept is also $4.$\n\nTherefore, the coordinates of the $y$-intercept are $(0,4).$"} :step/id #uuid "fa72bb9a-82e6-556f-a25d-dca4c2f9aee6" :step/next {:db/id #edb/ref 17592186554731}}] :activity/title "Properties of Lines Given in Slope-Intercept Form" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186553858}]}
