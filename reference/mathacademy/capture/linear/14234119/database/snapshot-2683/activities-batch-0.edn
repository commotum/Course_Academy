#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186069912} :activity/id #uuid "f525c0ff-8172-5646-b7ba-2dd13dd2cdf5" :activity/scope {:db/id #edb/ref 17592186049394 :topic/id #uuid "f121c6bf-38c7-56a2-930a-199717f2bc16" :topic/math-academy-id 398} :activity/steps [{:db/id #edb/ref 17592186069912 :step/content {:db/id #edb/ref 17592186070012 :tutorial/content "The **$y$-intercept** of a line is where the line intersects the $y$-axis. For instance, consider the line that passes through the point $(1,-1)$ and has a slope of $3.$ How can we find the $y$-intercept of this line? \n\n![](images/c3/c307a60266b77cb497a5c5b02a6d9518a3b31e22b1ec97afb1d2b40f488982cb.png)\n\nWe already know values for $x$, $y$ and $m,$ so we can just substitute them into the equation $y=mx+b$ and then solve for $b$:\n\n$$\n\\begin{aligned}y & =mx+b \\\\ (-1) & =(3)(1)+b \\\\ -1 & =3+b \\\\ b & =-4\\end{aligned}\n$$\n\nSo, the $y$-intercept is ${\\color{blue}b}=-4.$ The coordinates of the $y$-intercept are $(0,-4).$" :tutorial/id #uuid "1f9c0e73-8a80-5472-bf82-4c78c873c181" :tutorial/math-academy-id 8059 :tutorial/title "Introduction"} :step/id #uuid "32960d35-0132-5c05-a0dc-e73600e6a188" :step/math-academy-id 67150 :step/next {:db/id #edb/ref 17592186069913}} {:db/id #edb/ref 17592186069913 :step/content {:db/id #edb/ref 17592186068924 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068460 :question/id #uuid "4ad21d3a-bf40-5b65-8ba6-320d853e6cff" :question/math-academy-id "e-12869"} :knowledge-point/id #uuid "bc85ca17-8a08-5473-9473-dce954132bd5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725} {:db/id #edb/ref 17592186049716}] :knowledge-point/questions [{:db/id #edb/ref 17592186069250} {:db/id #edb/ref 17592186069491} {:db/id #edb/ref 17592186069492} {:db/id #edb/ref 17592186492005} {:db/id #edb/ref 17592186492010}] :knowledge-point/title "Finding the Y-Intercept of a Line Given a Point on the Line and Its Slope"} :step/id #uuid "05d03a89-9aa4-5b0f-97cd-69809a74c97d" :step/math-academy-id 67151 :step/next {:db/id #edb/ref 17592186069914}} {:db/id #edb/ref 17592186069914 :step/content {:db/id #edb/ref 17592186068925 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068461 :question/id #uuid "fdc3a6e9-080b-5e2a-b5a4-3af01c7018ff" :question/math-academy-id "e-12870"} :knowledge-point/id #uuid "5e985ae8-05ba-590a-b504-4c84884679f4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061}] :knowledge-point/questions [{:db/id #edb/ref 17592186069012} {:db/id #edb/ref 17592186069483} {:db/id #edb/ref 17592186069510} {:db/id #edb/ref 17592186235491} {:db/id #edb/ref 17592186492004} {:db/id #edb/ref 17592186492040} {:db/id #edb/ref 17592186503720} {:db/id #edb/ref 17592186523950} {:db/id #edb/ref 17592186551297} {:db/id #edb/ref 17592186553562} {:db/id #edb/ref 17592186554551}] :knowledge-point/title "Finding the Equation of a Line That Passes Through Two Points"} :step/id #uuid "fab7c6fb-b6fe-5b55-adee-114f45b728d4" :step/math-academy-id 67155 :step/next {:db/id #edb/ref 17592186069915}} {:db/id #edb/ref 17592186069915 :step/content {:db/id #edb/ref 17592186070013 :tutorial/content "The **$x$-intercept** of a line is where the line intersects the $x$-axis. For instance, consider the line $y = 2x - 4$. How can we find the $x$-intercept of this line?\n\n![](images/57/57a31eab932c948358e7ab6e428707a6a4b9f551bc956554c3a16b659b5f7988.png)\n\nAt the $x$-intercept, the $y$-coordinate is equal to $0.$ So, we can substitute $y=0$ into the equation and then solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}y & =2x-4 \\\\ (0) & =2x-4 \\\\ 4 & =2x \\\\ 2 & =x \\\\ x & =2\\end{aligned}\n$$\n\nTherefore, the $x$**-intercept** is $x=2.$ The coordinates of the $x$-intercept are $(2,0).$" :tutorial/id #uuid "fbd0b44d-8460-5058-9b94-c21852d09a4b" :tutorial/math-academy-id 8060 :tutorial/title "Finding the X-Intercept of a Straight Line"} :step/id #uuid "27dfa118-efd1-5317-966f-90a083509c55" :step/math-academy-id 67159 :step/next {:db/id #edb/ref 17592186069916}} {:db/id #edb/ref 17592186069916 :step/content {:db/id #edb/ref 17592186068926 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068462 :question/id #uuid "ec5bebf6-58d8-5b4d-900c-3c024628647c" :question/math-academy-id "e-12871"} :knowledge-point/id #uuid "63461668-4f76-52a4-8115-1ab135eef9e3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050532}] :knowledge-point/questions [{:db/id #edb/ref 17592186069044} {:db/id #edb/ref 17592186069346} {:db/id #edb/ref 17592186069453} {:db/id #edb/ref 17592186234053} {:db/id #edb/ref 17592186235493} {:db/id #edb/ref 17592186492038} {:db/id #edb/ref 17592186492053} {:db/id #edb/ref 17592186503680} {:db/id #edb/ref 17592186523928} {:db/id #edb/ref 17592186551251}] :knowledge-point/title "Finding the X-Intercept of a Line Given a Point and a Slope"} :step/id #uuid "ebe74c08-cc12-564f-b8bf-ce093355d7a9" :step/math-academy-id 67160 :step/next {:db/id #edb/ref 17592186069917}} {:db/id #edb/ref 17592186069917 :step/content {:db/id #edb/ref 17592186068927 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068463 :question/id #uuid "409dfb1f-7400-5539-9dea-6c2d1b6b7ef0" :question/math-academy-id "e-12872"} :knowledge-point/id #uuid "f66989ce-aac5-5737-b60b-6ed703634cd5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050763}] :knowledge-point/questions [{:db/id #edb/ref 17592186069245} {:db/id #edb/ref 17592186069249} {:db/id #edb/ref 17592186069454} {:db/id #edb/ref 17592186491987} {:db/id #edb/ref 17592186492003} {:db/id #edb/ref 17592186554614} {:db/id #edb/ref 17592186554630}] :knowledge-point/title "Finding the Intercept of a Horizontal or Vertical Line"} :step/id #uuid "8c918cb7-6f6b-5686-99e8-54b94b6009e4" :step/math-academy-id 67164}] :activity/title "Properties of Lines Given in Slope-Intercept Form" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068943}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186503780} :activity/id #uuid "9b65c706-a56f-5043-b155-869786ec18fd" :activity/scope {:db/id #edb/ref 17592186049394 :topic/id #uuid "f121c6bf-38c7-56a2-930a-199717f2bc16" :topic/math-academy-id 398} :activity/steps [{:db/id #edb/ref 17592186503780 :step/content {:db/id #edb/ref 17592186069483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60e87123-16db-5a92-8cb2-8a23c0aeaba6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4x-1" :db/id #edb/ref 17592186503170} {:answer/id #uuid "698c2d3c-6a55-59a5-8c8b-9b9708fddb70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=3x-1" :db/id #edb/ref 17592186503187} {:answer/id #uuid "97d26e7c-a075-5ed5-a723-528daa017501" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2x-6" :db/id #edb/ref 17592186503282} {:answer/id #uuid "bdc76194-9c0b-5ed2-8b4e-4b1e27f0b5e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=4x+1" :db/id #edb/ref 17592186503361} {:answer/id #uuid "f9554e82-405c-52e6-af3f-b2b480146aaf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=3x-3" :db/id #edb/ref 17592186503497}] :answer-field/correct {:db/id #edb/ref 17592186503170} :answer-field/id #uuid "1f1a378b-e807-52c5-ac81-76d5297f2e2a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186068068}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b4eef31d-a7fd-5ae0-810a-624f060a825b" :question/math-academy-id "q-6902" :question/problem "Determine the equation of the line that passes through the points $(2,7)$ and $(3,11).$" :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So, we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFirst, we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{11-7}{3-2} \\\\  & =\\frac{4}{1} \\\\  & =4\\end{aligned}\n$$\n\nSubstituting the slope $m=4$ into the slope-intercept formula $y=mx+b,$ we reach\n\n$$\ny=4x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(2,7):$\n\n$$\n\\begin{aligned}y & =4x+b \\\\ 7 & =4(2)+b \\\\ 7 & =8+b \\\\ 7-8 & =b \\\\ -1 & =b\\end{aligned}\n$$\n\nSo the equation of the line is $y=4x-1.$"} :step/id #uuid "45872dd6-e531-5118-a656-32545845e64a" :step/next {:db/id #edb/ref 17592186503839}} {:db/id #edb/ref 17592186503816 :step/content {:db/id #edb/ref 17592186503680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "196a504d-8519-53de-a140-45e7f8cea19a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186503033} {:answer/id #uuid "4098c8f0-90f5-57e1-ba2c-2a4d7e248771" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186503104} {:answer/id #uuid "50a00234-aaec-5fc9-a334-a039e8d088d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186503135} {:answer/id #uuid "77e09b7f-fef5-597d-84f8-1e7e8d6c7194" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186503223} {:answer/id #uuid "b9ac371a-7bc0-5123-8664-79c20ac774c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186503356}] :answer-field/correct {:db/id #edb/ref 17592186503104} :answer-field/id #uuid "f749aa0a-56e8-5fac-8b2c-39890015d4a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503640}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4459c635-09f2-5d35-8ba8-5eb9bfaa5126" :question/math-academy-id "q-44304" :question/problem "Calculate the $x$-intercept of the line $y=-2x+10.$" :question/worked-solution "At the $x$-intercept, the $y$-coordinate is equal to $0.$ So, we can substitute $y=0$ into the equation and then solve for $x:$\n\n$$\n\\begin{aligned}y & =-2x+10 \\\\ 0 & =-2x+10 \\\\ 2x & =10 \\\\ x & =\\frac{10}{2} \\\\ x & =5\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $x=5.$ The coordinates of the $x$-intercept are $(5,0).$"} :step/id #uuid "b3f3f538-e0c9-5b52-9abc-3ac0e6f13003"} {:db/id #edb/ref 17592186503839 :step/content {:db/id #edb/ref 17592186503720 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33213927-0872-5481-b492-8c2a15d7bc5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=10x-33" :db/id #edb/ref 17592186503073} {:answer/id #uuid "3e07aaa1-5380-511b-82d1-705ddf05637f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=10x+7" :db/id #edb/ref 17592186503096} {:answer/id #uuid "a3fd756d-7353-5103-b953-d571e22e7381" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=10x+47" :db/id #edb/ref 17592186503312} {:answer/id #uuid "ca218148-c955-580f-8eb5-5479cf23735d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=10x+17" :db/id #edb/ref 17592186503386} {:answer/id #uuid "fb7e9268-f0e3-598c-acbf-cc02c162d4d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=10x-47" :db/id #edb/ref 17592186503502}] :answer-field/correct {:db/id #edb/ref 17592186503073} :answer-field/id #uuid "806cc9db-3354-5070-98b7-05a7234f89ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503576}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9be101d3-9545-55c8-953e-3e73d5bfedaf" :question/math-academy-id "q-6944" :question/problem "Determine the equation of the line that passes through the points $(4,7)$ and $(5,17).$" :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So, we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFirst, we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{17-7}{5-4} \\\\  & =\\frac{10}{1} \\\\  & =10\\end{aligned}\n$$\n\nSubstituting the slope $m=10$ into the slope-intercept formula $y=mx+b,$ we reach\n\n$$\ny=10x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(4,7):$\n\n$$\n\\begin{aligned}y & =10x+b \\\\ 7 & =10(4)+b \\\\ 7 & =40+b \\\\ 7-40 & =b \\\\ -33 & =b.\\end{aligned}\n$$\n\nSo, the equation of the line is $y=10x-33.$"} :step/id #uuid "fb3f8a8a-5717-5f57-b96f-677651c9d6bf" :step/next {:db/id #edb/ref 17592186503816}}] :activity/title "Properties of Lines Given in Slope-Intercept Form" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186502970}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186554748} :activity/id #uuid "c327bea7-f4fd-595a-8810-8984b4d4dea4" :activity/scope {:db/id #edb/ref 17592186049394 :topic/id #uuid "f121c6bf-38c7-56a2-930a-199717f2bc16" :topic/math-academy-id 398} :activity/steps [{:db/id #edb/ref 17592186554691 :step/content {:db/id #edb/ref 17592186554551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba7df070-8dc6-516c-b876-bba86140442c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186554275}] :answer-field/correct {:db/id #edb/ref 17592186554275} :answer-field/id #uuid "1f8264ee-8699-5a8d-b7d1-b9e37462db15" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186554446} {:answer-field/choices [{:answer/id #uuid "166db386-af1b-59c2-a6a5-51f8af225a25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186553912}] :answer-field/correct {:db/id #edb/ref 17592186553912} :answer-field/id #uuid "c136b416-aa9d-59c9-87d0-e2fd3b968a46" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186554509}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2546e8f7-eee4-51d1-b227-0107b1dc1dff" :question/math-academy-id "q-175915" :question/problem "The equation of the line that passes through the points $(2,8)$ and $(4,4)$ is $\\,y=${{field-1}}\n$x\\,+$\n{{field-2}}." :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So, we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFirst, we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{4-8}{4-2} \\\\  & =\\frac{-4}{2} \\\\  & =-2\\end{aligned}\n$$\n\nSubstituting the slope $m=-2$ into the slope-intercept formula $y=mx+b,$ we reach\n\n$$\ny=-2x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(4,4):$\n\n$$\n\\begin{aligned}y & =-2x+b \\\\ 4 & =-2(4)+b \\\\ 4 & =-8+b \\\\ 4+8 & =b \\\\ 12 & =b\\end{aligned}\n$$\n\nSo the equation of the line is $y=-2\\,x+12.$"} :step/id #uuid "80da2ac9-41e1-52d3-9494-12a39d637e6f"} {:db/id #edb/ref 17592186554731 :step/content {:db/id #edb/ref 17592186554630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18fc2bc0-bf6d-5c95-b25a-160e38ec578c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186553916}] :answer-field/correct {:db/id #edb/ref 17592186553916} :answer-field/id #uuid "63e4ab55-d0a1-5786-9cc7-b2293a0bf11d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186554469} {:answer-field/choices [{:answer/id #uuid "972b3e5e-b37b-5a4f-991f-145fed1af8e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186554202}] :answer-field/correct {:db/id #edb/ref 17592186554202} :answer-field/id #uuid "80d521d4-3885-53d4-af2a-71f3adfd567c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186554485}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e629f775-4d70-5fe8-b2f0-8f18384b864c" :question/math-academy-id "q-171725" :question/problem "A horizontal line $l$ passes through the point $(-3,2).$ What are the coordinates of the $y$-intercept of $l?$\n\nThe coordinates of the $y$-intercept of $l$ are\n$($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "On any horizontal line, all points have the same $y$-coordinate.\n\nThe $y$-coordinate of the point $(-3,2)$ is $2,$ so the $y$-coordinate of the $y$-intercept is also $2.$\n\nTherefore, the coordinates of the $y$-intercept are $(0,2).$"} :step/id #uuid "c527ad9d-45ff-5250-97c1-54d0f5d7abf9" :step/next {:db/id #edb/ref 17592186554691}} {:db/id #edb/ref 17592186554748 :step/content {:db/id #edb/ref 17592186554614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b155884-63bf-5f91-b031-664e4e3e1a13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,0)" :db/id #edb/ref 17592186554044} {:answer/id #uuid "6fe93805-e84e-5076-bf14-f2778b50b1b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,0)" :db/id #edb/ref 17592186554096} {:answer/id #uuid "89e9239d-84c4-5c3b-8534-6d11bbbf7dca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no $y$-intercept" :db/id #edb/ref 17592186554160} {:answer/id #uuid "a7ae48a6-8e60-521c-ae3d-ed5a35430fa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,4)" :db/id #edb/ref 17592186554240} {:answer/id #uuid "fb242ae4-7619-5609-9b5f-113d3833b245" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,5)" :db/id #edb/ref 17592186554411}] :answer-field/correct {:db/id #edb/ref 17592186554240} :answer-field/id #uuid "15c11955-b9c8-5da1-a467-21fb40fdcf4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186554440}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aa2d0b41-12c5-5cc7-a265-9b2befe09045" :question/math-academy-id "q-31605" :question/problem "A horizontal line $l$ passes through the point $(5,4).$ Calculate the coordinates of the $y$-intercept of $l.$" :question/worked-solution "On any horizontal line, all points have the same $y$-coordinate.\n\nThe $y$-coordinate of the point $(5,4)$ is $4,$ so the $y$-coordinate of the $y$-intercept is also $4.$\n\nTherefore, the coordinates of the $y$-intercept are $(0,4).$"} :step/id #uuid "fa72bb9a-82e6-556f-a25d-dca4c2f9aee6" :step/next {:db/id #edb/ref 17592186554731}}] :activity/title "Properties of Lines Given in Slope-Intercept Form" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186553858}]}
