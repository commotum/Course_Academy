#{[{:db/id #edb/ref 17592186559797 :knowledge-point/_questions [{:db/id #edb/ref 17592186073904 :knowledge-point/id #uuid "1b09eb59-3ad5-5cde-8503-3c28c9e5c546" :knowledge-point/title "Applying Multiple Transformations to a Point Using Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "556b6199-da6f-579f-937f-8d66dce8e67b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8,2)" :db/id #edb/ref 17592186559234} {:answer/id #uuid "58129d4c-4954-5229-a555-5cdc7487dfe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,8)" :db/id #edb/ref 17592186559245} {:answer/id #uuid "9a286323-e88d-5db7-8196-b4a8a572b39c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-5)" :db/id #edb/ref 17592186559407} {:answer/id #uuid "efbd8051-2f04-5f8b-a0a3-fe80110c35fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8,-2)" :db/id #edb/ref 17592186559596} {:answer/id #uuid "f9936f46-eb9e-5009-a35f-953950a2815a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8,-2)" :db/id #edb/ref 17592186559630}] :answer-field/correct {:answer/id #uuid "efbd8051-2f04-5f8b-a0a3-fe80110c35fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8,-2)" :db/id #edb/ref 17592186559596} :answer-field/id #uuid "b50dca08-4713-5514-bd1f-47707336c77c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559740}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b1c8849-8725-5033-99b9-7b44196735cf" :question/math-academy-id "q-14376" :question/problem "The point $P(-2,5)$ is reflected across the $x$-axis, shifted $3$ units down, and then reflected across the line $y=x.$ What is the resulting point?" :question/worked-solution "Let's recall the functional representations of our three transformations:\n\n- A reflection in the $x$-axis can be represented by the function \n\n$$\n(x,y)↦(x,-y).\n$$\n\n- A shift of $3$ units down can be represented by the function \n\n$$\n(x,y)↦(x,y-3).\n$$\n\n- A reflection in the line $y=x$ can be represented by the function \n\n$$\n(x,y)↦(y,x).\n$$\n\nLet's apply the given transformations to the point $P$ using our functions:\n\nFirst, we apply the reflection. The image of the point $(-2,5)$ under the reflection is\n\n$$\n(-2,5)↦(-2,-5).\n$$\n\n \n\nThen, we apply the shift. The image of the point $(-2,-5)$ under this shift is\n\n$$\n(-2,-5)↦(-2,-8).\n$$\n\nFinally, we apply the reflection in the line $y=x.$ The image of the point $(-2,-8)$ under this reflection is\n\n$$\n(-2,-8)↦(-8,-2).\n$$\n\nTherefore, the resulting point is $(-8,-2).$"}] [{:db/id #edb/ref 17592186559847 :knowledge-point/_questions [{:db/id #edb/ref 17592186073779 :knowledge-point/id #uuid "9322724c-215a-5a91-a478-e91abe4038da" :knowledge-point/title "Determining the Image of a Polygon Under the Action of Multiple Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fa33d3e-59a6-5e25-91da-5f65ef10c9ef" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/66/66fba3dcaa529985f8912346c11814d04bfabdd23e56ec85999c5b1810e29b32.png" :db/id #edb/ref 17592186559050} {:answer/id #uuid "1cf9d4a9-b836-55bd-a79f-afebcc294c33" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7c/7c99fe0d00c7549f0449f4ef3fd5f98b7901507c8cac2712fc8ff09f2e53c357.png" :db/id #edb/ref 17592186559086} {:answer/id #uuid "212a1beb-5cfc-5752-a017-5c89a504e3cd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/78/781fe21d562d7f1dd4776e4cb2daf1b75c7961efe0e81c3a21d48a401faf3a01.png" :db/id #edb/ref 17592186559095} {:answer/id #uuid "3b23f4ef-d25a-5f41-b151-756ffbb200c5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/34/3413493e189dc774e491a7fb6a1b7c50ed4d8e3f5b5854790f34a103aea0ad3b.png" :db/id #edb/ref 17592186559164} {:answer/id #uuid "ed3448a7-725e-5b3f-bfda-55749598cea0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/91/91b022517d1bfcf0e32cb684d57a5b67c859632ce0b3639485986d81229537f0.png" :db/id #edb/ref 17592186559590}] :answer-field/correct {:answer/id #uuid "1cf9d4a9-b836-55bd-a79f-afebcc294c33" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7c/7c99fe0d00c7549f0449f4ef3fd5f98b7901507c8cac2712fc8ff09f2e53c357.png" :db/id #edb/ref 17592186559086} :answer-field/id #uuid "7f3c2607-2b6f-5905-9bf7-fdbd9f2d719e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559715}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b4059559-692f-5333-8d82-5fcea28a66c0" :question/math-academy-id "q-45182" :question/problem "![](images/46/46387d95d8b385f618da53c48284b323bed69e547a2e9894294f03aac7fa104e.png)\n\nThe triangle shown above is rotated by ${90}^{∘}$ counterclockwise about the origin and then reflected across the $x$-axis. What is the resulting triangle?" :question/worked-solution "Let's apply the given transformation.\n\n- Rotating the triangle by ${90}^{∘}$ counterclockwise about the origin gives the following:\n\n![](images/e8/e858bc501573ce7290ae6c2c0601d1c5a03d76a44a332ac8a5588e027bc0eacc.png)\n\n- Next, we take the last result and reflect it across the $x$-axis. This gives the following:\n\n![](images/6e/6eaad9b0fc67babd22039d3c615789babd7469fc3e0822e4f585138750a6e3db.png)"}] [{:db/id #edb/ref 17592186074180 :knowledge-point/_questions [{:db/id #edb/ref 17592186073905 :knowledge-point/id #uuid "d4308331-fea0-51e1-b1c9-a3e8e122e09e" :knowledge-point/title "Determining Parameters Given a Point and Its Image Under Multiple Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8903954-08eb-5a8a-b087-3938e7251474" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186071319} {:answer/id #uuid "1a18b1bc-bc8d-5b4e-a8b4-e5b29e70abbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186071320} {:answer/id #uuid "365ba29f-8cec-5c47-ba08-8fe10e4a461e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186071321} {:answer/id #uuid "464a293b-fcab-54b0-af5e-66dd04b99d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186071322} {:answer/id #uuid "7a5b69d2-ad9b-5a7a-855a-7d93765dc5e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186071323}] :answer-field/correct {:answer/id #uuid "464a293b-fcab-54b0-af5e-66dd04b99d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186071322} :answer-field/id #uuid "60d50989-0665-59f9-824e-bed61e95cb97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186071318}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5a06745b-ae00-55bf-a954-7c35626239f9" :question/math-academy-id "q-45188" :question/problem "The point $P(5,6)$ is rotated ${90}^{∘}$ clockwise about the origin $O$ and then translated according to the function $(x,y)↦(x+k,y+k).$ If the image of $P$ under this sequence of transformations is $(12,1),$ then $k=$" :question/worked-solution "Let's apply the given transformations.\n\nA rotation of ${90}^{∘}$ clockwise about $O$ can be represented by\n\n$$\n(x,y)↦(y,-x).\n$$\n\nApplying this to the point $P,$ we get\n\n$$\n(5,6)↦(6,-5).\n$$\n\n \n\nNow, applying the translation to $(6,-5),$ we get\n\n$$\n(6,-5)↦(6+k,\\,-5+k).\n$$\n\n \n\nSince the resulting point is $(12,1),$ by equating the $x$- and $y$-coordinates, we obtain\n\n$$\n\\begin{aligned}\\{\\begin{aligned}6+k=12 \\\\ -5+k=1\\end{aligned}\\,⟹\\,k & =6.\\end{aligned}\n$$\n\nTherefore, $k=6.$"}]}
