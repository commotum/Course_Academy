#{[{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186074907} :activity/id #uuid "8c1c7900-f03a-561c-8ea1-4c36f0a4a28b" :activity/scope {:db/id #edb/ref 17592186048906 :topic/id #uuid "cb5f4251-e56e-5612-a19a-b98c9b2d1546" :topic/math-academy-id 483} :activity/steps [{:db/id #edb/ref 17592186074714 :step/content {:db/id #edb/ref 17592186073779 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073648 :question/id #uuid "14fc5fcd-4aaa-5c46-a991-4703ceb0434c" :question/math-academy-id "e-7747"} :knowledge-point/id #uuid "9322724c-215a-5a91-a478-e91abe4038da" :knowledge-point/questions [{:db/id #edb/ref 17592186074178} {:db/id #edb/ref 17592186074181} {:db/id #edb/ref 17592186536848} {:db/id #edb/ref 17592186536876} {:db/id #edb/ref 17592186536889} {:db/id #edb/ref 17592186559847}] :knowledge-point/title "Determining the Image of a Polygon Under the Action of Multiple Transformations"} :step/id #uuid "383137fb-a667-5ee2-9f6a-b48d1e2491f3" :step/math-academy-id 28860 :step/next {:db/id #edb/ref 17592186074909}} {:db/id #edb/ref 17592186074716 :step/content {:db/id #edb/ref 17592186073781 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073650 :question/id #uuid "0f05c408-7ea2-58d2-a8e3-663f819747d1" :question/math-academy-id "e-7793"} :knowledge-point/id #uuid "1614303a-a067-5879-9ba6-2e7505109136" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050093} {:db/id #edb/ref 17592186050103} {:db/id #edb/ref 17592186050589}] :knowledge-point/questions [{:db/id #edb/ref 17592186074177} {:db/id #edb/ref 17592186074516} {:db/id #edb/ref 17592186536815} {:db/id #edb/ref 17592186536860} {:db/id #edb/ref 17592186536870}] :knowledge-point/title "Determining the Image of a Point Given a Sequence of Transformations"} :step/id #uuid "f68143db-5755-5d7a-98c2-1bc3df7dd0bc" :step/math-academy-id 29004 :step/next {:db/id #edb/ref 17592186074908}} {:db/id #edb/ref 17592186074907 :step/content {:db/id #edb/ref 17592186074980 :tutorial/content "We can combine transformations by applying them in turn.\n\nFor example, suppose that the segment $\\overline{AB}$ below is dilated with center $O$ and a scale factor $2,$ and then shifted $3$ units down. What is the resulting segment? \n\n![](images/bc/bc65e4edde561add5403cf57abc2cba50eabc4a9f7b8ba7592a0ea1f4f95c576.png)\n\nLet's apply the transformations in turn.\n\n- Dilating with center $O$ and scale factor $2$ gives the segment $\\overline{A'B'},$ shown below:\n\n![](images/c5/c526ed621e357ce098c420d3ef5912f347c13bd5c898ca5a2a165570607ea1fd.png)\n\n- Next, we take $\\overline{A'B'}$ and shift it by $3$ units down. This gives the segment $\\overline{A''B''}\\mathbin{:}$\n\n![](images/a7/a78807d3f1fb43f3773671f7c4f5696dd3779ae9ce1d8da797377c3574170a92.png)" :tutorial/id #uuid "db9037b0-2293-5cfb-82a7-3ceb49e7f1c2" :tutorial/math-academy-id 2286 :tutorial/title "Introduction"} :step/id #uuid "54890655-2246-5ea0-b6c5-dd777056aa9e" :step/math-academy-id 9530 :step/next {:db/id #edb/ref 17592186074716}} {:db/id #edb/ref 17592186074908 :step/content {:db/id #edb/ref 17592186073904 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073590 :question/id #uuid "6b45326c-ce13-5d2f-84df-b3698b46ea68" :question/math-academy-id "e-2888"} :knowledge-point/id #uuid "1b09eb59-3ad5-5cde-8503-3c28c9e5c546" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048208} {:db/id #edb/ref 17592186049034}] :knowledge-point/questions [{:db/id #edb/ref 17592186074171} {:db/id #edb/ref 17592186074179} {:db/id #edb/ref 17592186536839} {:db/id #edb/ref 17592186536869} {:db/id #edb/ref 17592186559797}] :knowledge-point/title "Applying Multiple Transformations to a Point Using Functions"} :step/id #uuid "36d25884-66b5-5b7e-a637-4f934d7082a6" :step/math-academy-id 9531 :step/next {:db/id #edb/ref 17592186074714}} {:db/id #edb/ref 17592186074909 :step/content {:db/id #edb/ref 17592186073905 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073591 :question/id #uuid "b45dae26-7996-5544-9884-d604bac62993" :question/math-academy-id "e-2893"} :knowledge-point/id #uuid "d4308331-fea0-51e1-b1c9-a3e8e122e09e" :knowledge-point/questions [{:db/id #edb/ref 17592186074180} {:db/id #edb/ref 17592186074182} {:db/id #edb/ref 17592186536843}] :knowledge-point/title "Determining Parameters Given a Point and Its Image Under Multiple Transformations"} :step/id #uuid "ec82e476-e6de-5ac3-be7f-d6c4d73e8d5b" :step/math-academy-id 9539}] :activity/title "Combining Geometric Transformations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073920}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186559975} :activity/id #uuid "c99456de-5358-5f4a-a509-379861656be6" :activity/scope {:db/id #edb/ref 17592186048906 :topic/id #uuid "cb5f4251-e56e-5612-a19a-b98c9b2d1546" :topic/math-academy-id 483} :activity/steps [{:db/id #edb/ref 17592186559902 :step/content {:db/id #edb/ref 17592186074180 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8903954-08eb-5a8a-b087-3938e7251474" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186071319} {:answer/id #uuid "1a18b1bc-bc8d-5b4e-a8b4-e5b29e70abbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186071320} {:answer/id #uuid "365ba29f-8cec-5c47-ba08-8fe10e4a461e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186071321} {:answer/id #uuid "464a293b-fcab-54b0-af5e-66dd04b99d86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186071322} {:answer/id #uuid "7a5b69d2-ad9b-5a7a-855a-7d93765dc5e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186071323}] :answer-field/correct {:db/id #edb/ref 17592186071322} :answer-field/id #uuid "60d50989-0665-59f9-824e-bed61e95cb97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186071318}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a06745b-ae00-55bf-a954-7c35626239f9" :question/math-academy-id "q-45188" :question/problem "The point $P(5,6)$ is rotated ${90}^{∘}$ clockwise about the origin $O$ and then translated according to the function $(x,y)↦(x+k,y+k).$ If the image of $P$ under this sequence of transformations is $(12,1),$ then $k=$" :question/worked-solution "Let's apply the given transformations.\n\nA rotation of ${90}^{∘}$ clockwise about $O$ can be represented by\n\n$$\n(x,y)↦(y,-x).\n$$\n\nApplying this to the point $P,$ we get\n\n$$\n(5,6)↦(6,-5).\n$$\n\n \n\nNow, applying the translation to $(6,-5),$ we get\n\n$$\n(6,-5)↦(6+k,\\,-5+k).\n$$\n\n \n\nSince the resulting point is $(12,1),$ by equating the $x$- and $y$-coordinates, we obtain\n\n$$\n\\begin{aligned}\\{\\begin{aligned}6+k=12 \\\\ -5+k=1\\end{aligned}\\,⟹\\,k & =6.\\end{aligned}\n$$\n\nTherefore, $k=6.$"} :step/id #uuid "15e09dd4-2f3f-5fc3-aa87-d06ffb45ee78"} {:db/id #edb/ref 17592186559920 :step/content {:db/id #edb/ref 17592186559847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fa33d3e-59a6-5e25-91da-5f65ef10c9ef" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/66/66fba3dcaa529985f8912346c11814d04bfabdd23e56ec85999c5b1810e29b32.png" :db/id #edb/ref 17592186559050} {:answer/id #uuid "1cf9d4a9-b836-55bd-a79f-afebcc294c33" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/7c/7c99fe0d00c7549f0449f4ef3fd5f98b7901507c8cac2712fc8ff09f2e53c357.png" :db/id #edb/ref 17592186559086} {:answer/id #uuid "212a1beb-5cfc-5752-a017-5c89a504e3cd" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/78/781fe21d562d7f1dd4776e4cb2daf1b75c7961efe0e81c3a21d48a401faf3a01.png" :db/id #edb/ref 17592186559095} {:answer/id #uuid "3b23f4ef-d25a-5f41-b151-756ffbb200c5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/34/3413493e189dc774e491a7fb6a1b7c50ed4d8e3f5b5854790f34a103aea0ad3b.png" :db/id #edb/ref 17592186559164} {:answer/id #uuid "ed3448a7-725e-5b3f-bfda-55749598cea0" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/91/91b022517d1bfcf0e32cb684d57a5b67c859632ce0b3639485986d81229537f0.png" :db/id #edb/ref 17592186559590}] :answer-field/correct {:db/id #edb/ref 17592186559086} :answer-field/id #uuid "7f3c2607-2b6f-5905-9bf7-fdbd9f2d719e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559715}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b4059559-692f-5333-8d82-5fcea28a66c0" :question/math-academy-id "q-45182" :question/problem "![](images/46/46387d95d8b385f618da53c48284b323bed69e547a2e9894294f03aac7fa104e.png)\n\nThe triangle shown above is rotated by ${90}^{∘}$ counterclockwise about the origin and then reflected across the $x$-axis. What is the resulting triangle?" :question/worked-solution "Let's apply the given transformation.\n\n- Rotating the triangle by ${90}^{∘}$ counterclockwise about the origin gives the following:\n\n![](images/e8/e858bc501573ce7290ae6c2c0601d1c5a03d76a44a332ac8a5588e027bc0eacc.png)\n\n- Next, we take the last result and reflect it across the $x$-axis. This gives the following:\n\n![](images/6e/6eaad9b0fc67babd22039d3c615789babd7469fc3e0822e4f585138750a6e3db.png)"} :step/id #uuid "45f03049-efe3-5df0-b089-b7bc4f3bb0db" :step/next {:db/id #edb/ref 17592186559902}} {:db/id #edb/ref 17592186559975 :step/content {:db/id #edb/ref 17592186559797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "556b6199-da6f-579f-937f-8d66dce8e67b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-8,2)" :db/id #edb/ref 17592186559234} {:answer/id #uuid "58129d4c-4954-5229-a555-5cdc7487dfe6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,8)" :db/id #edb/ref 17592186559245} {:answer/id #uuid "9a286323-e88d-5db7-8196-b4a8a572b39c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,-5)" :db/id #edb/ref 17592186559407} {:answer/id #uuid "efbd8051-2f04-5f8b-a0a3-fe80110c35fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-8,-2)" :db/id #edb/ref 17592186559596} {:answer/id #uuid "f9936f46-eb9e-5009-a35f-953950a2815a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8,-2)" :db/id #edb/ref 17592186559630}] :answer-field/correct {:db/id #edb/ref 17592186559596} :answer-field/id #uuid "b50dca08-4713-5514-bd1f-47707336c77c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559740}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3b1c8849-8725-5033-99b9-7b44196735cf" :question/math-academy-id "q-14376" :question/problem "The point $P(-2,5)$ is reflected across the $x$-axis, shifted $3$ units down, and then reflected across the line $y=x.$ What is the resulting point?" :question/worked-solution "Let's recall the functional representations of our three transformations:\n\n- A reflection in the $x$-axis can be represented by the function \n\n$$\n(x,y)↦(x,-y).\n$$\n\n- A shift of $3$ units down can be represented by the function \n\n$$\n(x,y)↦(x,y-3).\n$$\n\n- A reflection in the line $y=x$ can be represented by the function \n\n$$\n(x,y)↦(y,x).\n$$\n\nLet's apply the given transformations to the point $P$ using our functions:\n\nFirst, we apply the reflection. The image of the point $(-2,5)$ under the reflection is\n\n$$\n(-2,5)↦(-2,-5).\n$$\n\n \n\nThen, we apply the shift. The image of the point $(-2,-5)$ under this shift is\n\n$$\n(-2,-5)↦(-2,-8).\n$$\n\nFinally, we apply the reflection in the line $y=x.$ The image of the point $(-2,-8)$ under this reflection is\n\n$$\n(-2,-8)↦(-8,-2).\n$$\n\nTherefore, the resulting point is $(-8,-2).$"} :step/id #uuid "db17c9b9-b4ba-501a-aed6-8fe279a39f99" :step/next {:db/id #edb/ref 17592186559920}}] :activity/title "Combining Geometric Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186559010}]}
