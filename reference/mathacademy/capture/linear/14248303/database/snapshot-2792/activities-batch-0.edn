#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186060848} :activity/id #uuid "13debee6-4a55-55f7-a988-efd193fff1b5" :activity/scope {:db/id #edb/ref 17592186050339 :topic/id #uuid "410b2be8-5a51-5910-af93-7909aeb173d3" :topic/math-academy-id 142} :activity/steps [{:db/id #edb/ref 17592186060848 :step/content {:db/id #edb/ref 17592186060871 :tutorial/content "A situation involves **exponential decay** if some initial amount repeatedly shrinks due to being multiplied by some constant rate.\n\nFor example, suppose that a certain battery had a voltage of $4\\,\\textrm{V}$ when it was healthy. Following a sharp impact, the battery's voltage decreased by $\\dfrac12$ every day since the day of the impact. What was the voltage of the battery $3$ days after it was damaged?\n\nStarting with a voltage of $4\\,\\textrm{V},$ we know that this number will halve every day. So after $1$ day, the voltage (measured in volts) was\n\n$$\n{\\color{blue}{4\\cdot \\dfrac 1 2}}.\n$$\n\nOn the second day, this number halved again. So the voltage after $2$ days was\n\n$$\n\\left({\\color{blue}{4\\cdot \\dfrac 1 2}}\\right)\\cdot \\dfrac 1 2 = {\\color{red}{4\\cdot \\left(\\dfrac 1 2\\right)^2}}.\n$$\n\nAfter one more day, the number above halves once again. So the voltage after $3$ days was\n\n$$\n{\\color{red}{4\\cdot \\left(\\dfrac 1 2\\right)^2}}\\cdot \\dfrac 1 2 = {\\color{black}{4\\cdot \\left(\\dfrac 1 2\\right)^3}}.\n$$\n\nIf we evaluate the above expression, we get:\n\n$$\n4\\cdot \\left(\\dfrac 1 2\\right)^3 = 4\\cdot \\dfrac 1 8 =  \\dfrac 1 2\n$$\n\nSo after $3$ days, the voltage reduced to just $\\dfrac 1 2\\,\\textrm{V}.$\n\nThis is an example of exponential decay. The voltage decreases by $\\dfrac 1 2$ over a time interval of $1$ day, every day. The voltage decays very rapidly, as we can see from the graph below.\n\n![](images/ee/ee97a0d5495dd28c8e0af1168fa4dc0455f1985ca8ab8f9a8e8dbf3e1a84ae99.png)" :tutorial/id #uuid "ea0fa9d4-fe24-5adb-917d-cfab19b857a5" :tutorial/math-academy-id 1956 :tutorial/title "Introduction"} :step/id #uuid "c4e08605-7644-508a-bb00-2cd899378643" :step/math-academy-id 6996 :step/next {:db/id #edb/ref 17592186060850}} {:db/id #edb/ref 17592186060849 :step/content {:db/id #edb/ref 17592186059869 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059460 :question/id #uuid "53dbcc31-f851-5f0f-84e8-ae06de2cc40b" :question/math-academy-id "e-2027"} :knowledge-point/id #uuid "1b701fb5-7676-5c5f-8a80-b86d2dec0548" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048263} {:db/id #edb/ref 17592186050625}] :knowledge-point/questions [{:db/id #edb/ref 17592186060048} {:db/id #edb/ref 17592186060312} {:db/id #edb/ref 17592186508920} {:db/id #edb/ref 17592186538950} {:db/id #edb/ref 17592186538979} {:db/id #edb/ref 17592186566251}] :knowledge-point/title "Creating an Exponential Decay Expression From a Decay Rate"} :step/id #uuid "3cf5fee3-1e74-5002-9366-cc2f2212bdfe" :step/math-academy-id 6998} {:db/id #edb/ref 17592186060850 :step/content {:db/id #edb/ref 17592186059870 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059461 :question/id #uuid "ebc44409-5898-5525-baed-9c0539defa5e" :question/math-academy-id "e-2028"} :knowledge-point/id #uuid "162c9121-ff80-59f5-85e1-cdeb2729bfc6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049714}] :knowledge-point/questions [{:db/id #edb/ref 17592186060313} {:db/id #edb/ref 17592186060314} {:db/id #edb/ref 17592186508964} {:db/id #edb/ref 17592186508989} {:db/id #edb/ref 17592186538929} {:db/id #edb/ref 17592186538961} {:db/id #edb/ref 17592186566200} {:db/id #edb/ref 17592186566231}] :knowledge-point/title "Creating an Exponential Decay Expression From a Decay Factor"} :step/id #uuid "8f5e5710-5bb9-5a97-ae64-7a484889eb79" :step/math-academy-id 6999 :step/next {:db/id #edb/ref 17592186060849}}] :activity/title "Creating Exponential Decay Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059879}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186539069} :activity/id #uuid "d3db944e-9fd5-5b8c-9599-004bc0044d98" :activity/scope {:db/id #edb/ref 17592186050339 :topic/id #uuid "410b2be8-5a51-5910-af93-7909aeb173d3" :topic/math-academy-id 142} :activity/steps [{:db/id #edb/ref 17592186539069 :step/content {:db/id #edb/ref 17592186060314 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "295b4554-e6e4-5572-8988-a41fbe42755b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\cdot {(\\frac{5}{6})}^{3}" :db/id #edb/ref 17592186538319} {:answer/id #uuid "88b25360-062c-5962-ab67-7d166e829582" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{12}^{3}\\cdot (\\frac{5}{6})" :db/id #edb/ref 17592186538550} {:answer/id #uuid "b9d2273f-c214-550e-bdff-c833b0e8605d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\cdot {(\\frac{1}{6})}^{3}" :db/id #edb/ref 17592186538667} {:answer/id #uuid "dc51588c-9b81-533c-b74d-397e014ebe49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{12}^{3}\\cdot (\\frac{1}{6})" :db/id #edb/ref 17592186538737} {:answer/id #uuid "f34187bf-602c-5b72-80aa-ab6dacc13343" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\cdot {(\\frac{7}{6})}^{3}" :db/id #edb/ref 17592186538782}] :answer-field/correct {:db/id #edb/ref 17592186538319} :answer-field/id #uuid "707254ef-77ca-5349-acbb-38802e8305d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186058506}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3d28d168-3d53-5315-aa0b-8d22162ffbb7" :question/math-academy-id "q-61858" :question/problem "Owen enrolled in an online course that has $12$ topics. He completed $\\frac{1}{6}$ of the remaining topics every week. Which expression gives approximately  the number of topics that were incomplete after $3$ weeks?" :question/worked-solution "If the number of incomplete topics decreased by $\\frac{1}{6}$ every week, then every week $\\frac{5}{6}$ of the topics remained incomplete.\n\nTherefore:\n\n- After $1$ week, $12\\cdot (\\frac{5}{6})$ topics were incomplete.\n\n- After $2$ weeks, approximately  $12\\cdot {(\\frac{5}{6})}^{2}$ topics were incomplete.\n\n- After $3$ weeks, approximately $12\\cdot {(\\frac{5}{6})}^{3}$ topics were incomplete."} :step/id #uuid "78998f12-8872-552e-a5a5-da0ba51e3a78" :step/next {:db/id #edb/ref 17592186539098}} {:db/id #edb/ref 17592186539089 :step/content {:db/id #edb/ref 17592186538950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c04ac1a-82ca-5e7d-960c-ce0d5428e163" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(11\\,000\\cdot 0.98)}^{10}" :db/id #edb/ref 17592186538261} {:answer/id #uuid "7270ac70-c515-5aab-a7ed-575aca39f8d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\,000\\cdot (0.98)^{10}" :db/id #edb/ref 17592186538491} {:answer/id #uuid "c506aa54-db09-523c-a6d5-40e5d1db4949" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\,{000}^{10}\\cdot 0.98" :db/id #edb/ref 17592186538689} {:answer/id #uuid "ef4db2b8-73eb-5c7d-a88b-f43140375b3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\,000+{0.98}^{10}" :db/id #edb/ref 17592186538776} {:answer/id #uuid "f4ca33f2-3d2b-5209-a730-c75645d73f9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11\\,{000}^{10}+{0.98}^{10}" :db/id #edb/ref 17592186538788}] :answer-field/correct {:db/id #edb/ref 17592186538491} :answer-field/id #uuid "7b4efd19-31d2-5e38-bf06-a602e93463a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538866}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3f3966bd-9f89-5978-a943-b86356ea0f72" :question/math-academy-id "q-63873" :question/problem "A park is estimated to have $11\\,000$ rabbits. If their population decreases by $2%$ every year, what will the population of rabbits be approximately in ten years?" :question/worked-solution "The number $2%$ (expressed as a decimal) is equal to $0.02.$ Therefore, a decrease of $2%$ corresponds to multiplication by a factor of:\n\n$$\n1-0.02=0.98\n$$\n\nTherefore:\n\n- After $1$ year, there will be $11\\,000\\cdot (0.98)$ rabbits.\n\n- After $2$ years, there will be approximately $11\\,000\\cdot (0.98)^{2}$ rabbits.\n\n- After $3$ years, there will be approximately $11\\,000\\cdot (0.98)^{3}$ rabbits.\n\n- $…$\n\nRepeating this pattern, we see that there will be approximately $11\\,000\\cdot (0.98)^{10}$ rabbits in $10$ years."} :step/id #uuid "b04cce73-b728-5431-915f-d9612cfbf878" :step/next {:db/id #edb/ref 17592186539092}} {:db/id #edb/ref 17592186539092 :step/content {:db/id #edb/ref 17592186538961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "365ac6de-5bc0-530c-8769-ab950b8fa19c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,320\\cdot {(\\frac{1}{8})}^{4}" :db/id #edb/ref 17592186538344} {:answer/id #uuid "458c751d-9727-57bd-b649-b6e3f795e9f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,320\\cdot {(\\frac{9}{8})}^{4}" :db/id #edb/ref 17592186538373} {:answer/id #uuid "826be51e-5684-5c67-9bdc-d422871db60d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,320\\cdot {(\\frac{7}{8})}^{4}" :db/id #edb/ref 17592186538531} {:answer/id #uuid "d64d65fc-c9e4-5437-a07d-855621ae3d4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,{320}^{4}\\cdot (\\frac{7}{8})" :db/id #edb/ref 17592186538726} {:answer/id #uuid "f33312dc-e9ad-50f7-8e70-313a65c252c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,{320}^{4}\\cdot (\\frac{1}{8})" :db/id #edb/ref 17592186538781}] :answer-field/correct {:db/id #edb/ref 17592186538531} :answer-field/id #uuid "8b2bdf66-4c59-5fc0-809b-1e1cdae74143" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538873}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5e4151ac-1192-5c41-bdd3-5c80d61ad30d" :question/math-academy-id "q-103124" :question/problem "A company initially had $40\\,320$ followers on a social media platform. If the number of followers declines by $\\frac{1}{8}$ every month after some bad publicity, which expression gives approximately the number of followers after $4$ months?" :question/worked-solution "If the number of followers reduces by $\\frac{1}{8}$ every month, then $\\frac{7}{8}$ of the followers remains every month.\n\nTherefore:\n\n- After $1$ month, there will be $40\\,320\\cdot (\\frac{7}{8})$ followers.\n\n- After $2$ months, there will be $40\\,320\\cdot {(\\frac{7}{8})}^{2}$ followers.\n\n- After $3$ months, there will be approximately $40\\,320\\cdot {(\\frac{7}{8})}^{3}$ followers.\n\n- After $4$ months, there will be approximately $40\\,320\\cdot {(\\frac{7}{8})}^{4}$ followers."} :step/id #uuid "b2551a52-3625-5e2d-81c6-6aeec20a969c"} {:db/id #edb/ref 17592186539098 :step/content {:db/id #edb/ref 17592186538979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59df4646-b50a-5d4b-ae72-4abb4bbc5af9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "400\\cdot (1.02)^{3}" :db/id #edb/ref 17592186538425} {:answer/id #uuid "619431ae-e9db-5a4b-a7fd-782b989a642c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "400\\cdot (0.98)^{3}" :db/id #edb/ref 17592186538446} {:answer/id #uuid "710e9657-f231-554c-92fe-ec46ef48fb0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "400\\cdot (0.8)^{3}" :db/id #edb/ref 17592186538483} {:answer/id #uuid "8473525f-1815-5c36-af56-1eb153bd55e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "400\\cdot (0.02)^{3}" :db/id #edb/ref 17592186538537} {:answer/id #uuid "c59cd770-bed2-5f0d-a3f9-575cb42f709d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{400}^{3}\\cdot (0.98)" :db/id #edb/ref 17592186538693}] :answer-field/correct {:db/id #edb/ref 17592186538446} :answer-field/id #uuid "a5c3df3d-549f-5a8b-98e2-1cf655414971" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538885}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "85541785-a1f8-5b45-843e-637ba62e4e83" :question/math-academy-id "q-61871" :question/problem "Elena has $400$ TVs in her store. She expects that the number of TVs will decrease by $2%$ daily due to sales. Approximately how many TVs will be in her store after $3$ days?" :question/worked-solution "The number $2%$ (expressed as a decimal) is equal to $0.02.$ Therefore, a decrease of $0.02%$ corresponds to multiplication by a factor of:\n\n$$\n1-0.02=0.98\n$$\n\nTherefore:\n\n- After $1$ day, there will be $400\\cdot (0.98)$ TVs remaining.\n\n- After $2$ days, there will be approximately $400\\cdot (0.98)^{2}$ TVs remaining.\n\n- After $3$ days, there will be approximately $400\\cdot (0.98)^{3}$ TVs remaining."} :step/id #uuid "cac69b8e-8bc9-5431-8acd-2441edfca029" :step/next {:db/id #edb/ref 17592186539114}} {:db/id #edb/ref 17592186539114 :step/content {:db/id #edb/ref 17592186538929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03ad4804-5d67-5f61-a2ef-fb8a13a792b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64\\cdot {(\\frac{1}{2})}^{6}" :db/id #edb/ref 17592186538241} {:answer/id #uuid "3957d0a7-b17e-59fa-ba9f-5a550a649663" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64\\cdot {(\\frac{3}{2})}^{6}" :db/id #edb/ref 17592186538351} {:answer/id #uuid "775ad280-4252-584a-9cd3-1acf0234c161" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{64}^{6}\\cdot (\\frac{3}{2})" :db/id #edb/ref 17592186538502} {:answer/id #uuid "b41a5b18-1ac7-5ab7-a7f0-296fa3f34e5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{64}^{6}\\cdot (\\frac{1}{2})" :db/id #edb/ref 17592186538652} {:answer/id #uuid "ef88dff2-c156-5cd2-98da-be865d390a62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64\\cdot {(2)}^{6}" :db/id #edb/ref 17592186538777}] :answer-field/correct {:db/id #edb/ref 17592186538241} :answer-field/id #uuid "b0410c69-ce09-548b-ba42-743ef4a478a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538889}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "11af995c-4c5e-50de-8182-ca4e90fd1ecf" :question/math-academy-id "q-61965" :question/problem "A soccer tournament began with $64$ teams. The number of teams reduced by $\\frac{1}{2}$ after every round. How many teams remained after $6$ rounds?" :question/worked-solution "There were $64$ initially, and this number decreased by $\\frac{1}{2}$ every round. \n\nTherefore:\n\n- After $1$ round, there were $64\\cdot (\\frac{1}{2})$ teams remaining.\n\n- After $2$ rounds, there were $64\\cdot {(\\frac{1}{2})}^{2}$ teams remaining.\n\n- After $3$ rounds, there were $64\\cdot {(\\frac{1}{2})}^{3}$ teams  remaining.\n\n- $…$\n\nRepeating this pattern, we see that there were $64\\cdot {(\\frac{1}{2})}^{6}$ teams remaining after $6$ rounds."} :step/id #uuid "effcf191-f1d7-5563-bf4f-8d03c6d7af58" :step/next {:db/id #edb/ref 17592186539089}}] :activity/title "Creating Exponential Decay Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186538229}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186566316} :activity/id #uuid "2cd680de-e057-5fe8-be45-8a7269417b87" :activity/scope {:db/id #edb/ref 17592186050339 :topic/id #uuid "410b2be8-5a51-5910-af93-7909aeb173d3" :topic/math-academy-id 142} :activity/steps [{:db/id #edb/ref 17592186566289 :step/content {:db/id #edb/ref 17592186566251 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b3db7c-7216-56be-884e-ef04e1c76e20" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\$5\\,{600}^{3}\\cdot (0.93)$" :db/id #edb/ref 17592186565678} {:answer/id #uuid "079785f3-c823-5972-ac97-2b0ad2524596" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\$5\\,600\\cdot (0.93)^{3}$" :db/id #edb/ref 17592186565690} {:answer/id #uuid "23fca3cd-a181-56e7-84e7-f372036dbecd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\$5\\,600\\cdot (1.07)^{3}$" :db/id #edb/ref 17592186565738} {:answer/id #uuid "a3c50ab9-bd4f-5f65-bdaf-f7aeccd5c8bd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\$5\\,600\\cdot (0.7)^{3}$" :db/id #edb/ref 17592186565939} {:answer/id #uuid "b7055644-be40-524c-8158-fba695118f4b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\$5\\,{600}^{3}\\cdot (0.7)$" :db/id #edb/ref 17592186565978}] :answer-field/correct {:db/id #edb/ref 17592186565690} :answer-field/id #uuid "785e2d58-8303-57f1-aa13-ebfbb11ddd2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566153}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "92938c74-0d42-5181-8d49-61141e646c18" :question/math-academy-id "q-61861" :question/problem "Nathan invested $\\$5\\,600$ into a company which then went on to lose $7%$ of its value every year. Which expression gives the value of Nathan's investment after $3$ years?" :question/worked-solution "The number $7%$ (expressed as a decimal) is equal to $0.07.$ Therefore, a decrease of $7%$ corresponds to multiplication by a factor of:\n\n$$\n1-0.07=0.93\n$$\n\nTherefore:\n\n- After $1$ year, the value of the investment was $5\\,600\\cdot (0.93)$ dollars.\n\n- After $2$ years, the value of the investment was $5\\,600\\cdot (0.93)^{2}$ dollars.\n\n- After $3$ years, the value of the investment was $5\\,600\\cdot (0.93)^{3}$ dollars."} :step/id #uuid "5217ad06-79dc-5267-a1fc-7ac92196ff07"} {:db/