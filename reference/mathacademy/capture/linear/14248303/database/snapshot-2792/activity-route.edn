#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186566316} :activity/id #uuid "2cd680de-e057-5fe8-be45-8a7269417b87" :activity/scope {:db/id #edb/ref 17592186050339 :topic/id #uuid "410b2be8-5a51-5910-af93-7909aeb173d3" :topic/math-academy-id 142} :activity/steps [{:db/id #edb/ref 17592186566289 :step/content {:db/id #edb/ref 17592186566251 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b3db7c-7216-56be-884e-ef04e1c76e20" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\$5\\,{600}^{3}\\cdot (0.93)$" :db/id #edb/ref 17592186565678} {:answer/id #uuid "079785f3-c823-5972-ac97-2b0ad2524596" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\$5\\,600\\cdot (0.93)^{3}$" :db/id #edb/ref 17592186565690} {:answer/id #uuid "23fca3cd-a181-56e7-84e7-f372036dbecd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\$5\\,600\\cdot (1.07)^{3}$" :db/id #edb/ref 17592186565738} {:answer/id #uuid "a3c50ab9-bd4f-5f65-bdaf-f7aeccd5c8bd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\$5\\,600\\cdot (0.7)^{3}$" :db/id #edb/ref 17592186565939} {:answer/id #uuid "b7055644-be40-524c-8158-fba695118f4b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\$5\\,{600}^{3}\\cdot (0.7)$" :db/id #edb/ref 17592186565978}] :answer-field/correct {:db/id #edb/ref 17592186565690} :answer-field/id #uuid "785e2d58-8303-57f1-aa13-ebfbb11ddd2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566153}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "92938c74-0d42-5181-8d49-61141e646c18" :question/math-academy-id "q-61861" :question/problem "Nathan invested $\\$5\\,600$ into a company which then went on to lose $7%$ of its value every year. Which expression gives the value of Nathan's investment after $3$ years?" :question/worked-solution "The number $7%$ (expressed as a decimal) is equal to $0.07.$ Therefore, a decrease of $7%$ corresponds to multiplication by a factor of:\n\n$$\n1-0.07=0.93\n$$\n\nTherefore:\n\n- After $1$ year, the value of the investment was $5\\,600\\cdot (0.93)$ dollars.\n\n- After $2$ years, the value of the investment was $5\\,600\\cdot (0.93)^{2}$ dollars.\n\n- After $3$ years, the value of the investment was $5\\,600\\cdot (0.93)^{3}$ dollars."} :step/id #uuid "5217ad06-79dc-5267-a1fc-7ac92196ff07"} {:db/id #edb/ref 17592186566309 :step/content {:db/id #edb/ref 17592186566231 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56025d08-3daa-57d3-a124-01b79cf0d75e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "120\\cdot {(\\frac{1}{5})}^{3}" :db/id #edb/ref 17592186565815} {:answer/id #uuid "bed9968c-838f-5361-8f39-c03feaab5e2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{120}^{3}\\cdot (\\frac{1}{5})" :db/id #edb/ref 17592186565984} {:answer/id #uuid "d0507e43-149d-5743-8d36-f39796b33425" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "120\\cdot {(\\frac{6}{5})}^{3}" :db/id #edb/ref 17592186566019} {:answer/id #uuid "db5a9956-eda8-532e-a69a-92488632bfd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{120}^{3}\\cdot (\\frac{4}{5})" :db/id #edb/ref 17592186566032} {:answer/id #uuid "ed2ae62b-708a-58b6-93f0-dc688cfbb87b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "120\\cdot {(\\frac{4}{5})}^{3}" :db/id #edb/ref 17592186566067}] :answer-field/correct {:db/id #edb/ref 17592186566067} :answer-field/id #uuid "fc24bef0-f8cf-5321-9a6d-d5127a9ed564" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566192}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5c6f292d-8813-58fc-b4b8-7f51b18fc102" :question/math-academy-id "q-61703" :question/problem "A soccer club started with $120$ members. The number of members in the club then decreased by $\\frac{1}{5}$ every year. Which expression gives approximately the number of members after $3$ years?" :question/worked-solution "If the number of members reduced by $\\frac{1}{5}$ every year, it means that $\\frac{4}{5}$ of members remained every year.\n\nTherefore:\n\n- After $1$ year, there were $120\\cdot (\\frac{4}{5})$ members.\n\n- After $2$ years, there were approximately $120\\cdot {(\\frac{4}{5})}^{2}$ members.\n\n- After $3$ years, there were approximately $120\\cdot {(\\frac{4}{5})}^{3}$ members."} :step/id #uuid "c2970b7a-793f-5b1c-9e78-4dd00bd3e750" :step/next {:db/id #edb/ref 17592186566289}} {:db/id #edb/ref 17592186566316 :step/content {:db/id #edb/ref 17592186566200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ec9087c-76ac-5207-b1f9-ec6fe4b81431" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot {(\\frac{1}{4})}^{9}\\,\\text{kg}" :db/id #edb/ref 17592186565729} {:answer/id #uuid "36010bc1-90bd-5d59-bf60-398650da4041" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{9}\\cdot (\\frac{1}{4})\\,\\text{kg}" :db/id #edb/ref 17592186565762} {:answer/id #uuid "6e47a032-29fd-5008-bafe-e0cc57a28e71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot (\\frac{3}{4})\\,\\text{kg}" :db/id #edb/ref 17592186565852} {:answer/id #uuid "b130822a-20ed-52e4-9477-4de7e3cf757a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{9}\\cdot (\\frac{3}{4})\\,\\text{kg}" :db/id #edb/ref 17592186565957} {:answer/id #uuid "b7594013-bebf-56a0-a402-a6f6ee3a5b22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\cdot {(\\frac{3}{4})}^{9}\\,\\text{kg}" :db/id #edb/ref 17592186565979}] :answer-field/correct {:db/id #edb/ref 17592186565979} :answer-field/id #uuid "3d943c3b-30bf-5f50-9d21-212a996b1fd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566129}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "09a2f783-f81f-5ba2-8e8b-78ad6330c2dd" :question/math-academy-id "q-61687" :question/problem "A radioactive substance decays exponentially such that its mass reduces by $\\frac{1}{4}$ every hour. If the mass of the substance was initially $2\\,\\text{kg},$ what is the mass of the substance after $9$ hours?" :question/worked-solution "If the mass reduces by $\\frac{1}{4},$ then $\\frac{3}{4}$ of its mass remains every hour.\n\nTherefore:\n\n- After $1$ hour, the mass is $2\\cdot (\\frac{3}{4}).$\n\n- After $2$ hours, the mass is $2\\cdot {(\\frac{3}{4})}^{2}.$\n\n- After $3$ hours, the mass is $2\\cdot {(\\frac{3}{4})}^{3}.$\n\n- $…$\n\nRepeating this pattern, we see that the mass after $9$ hours is $2\\cdot {(\\frac{3}{4})}^{9}\\,\\text{kg}.$"} :step/id #uuid "df22a5ba-f76c-5c34-9764-841fff0c157d" :step/next {:db/id #edb/ref 17592186566309}}] :activity/title "Creating Exponential Decay Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186565664}]}
