{
  "dom_id": "questionExplanation-61703",
  "name": null,
  "problem": "",
  "worked_solution": "If the number of members reduced by $\\frac{1}{5}$ every year, it means that $\\frac{4}{5}$ of members remained every year.\n\nTherefore:\n\n- After $1$ year, there were $120\\cdot (\\frac{4}{5})$ members.\n\n- After $2$ years, there were approximately $120\\cdot {(\\frac{4}{5})}^{2}$ members.\n\n- After $3$ years, there were approximately $120\\cdot {(\\frac{4}{5})}^{3}$ members.",
  "calculator_instructions": "",
  "fields": [],
