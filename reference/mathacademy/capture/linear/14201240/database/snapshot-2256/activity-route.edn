#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186518250} :activity/id #uuid "1e5bf916-4dc8-5981-8525-b54be92da138" :activity/scope {:db/id #edb/ref 17592186049927 :topic/id #uuid "1f1f7b83-a1f4-5b1c-888f-a20ae593bd72" :topic/math-academy-id 1813} :activity/steps [{:db/id #edb/ref 17592186518250 :step/content {:db/id #edb/ref 17592186518112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21831e57-25de-5c6c-9c6c-ab43447a6e8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186517547} {:answer/id #uuid "508c3ec8-73a1-50fd-9725-b8b2d47f39c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186517645} {:answer/id #uuid "65388b8f-1379-5e74-8e66-a7ae1be68001" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186517673} {:answer/id #uuid "8e6f65b9-3a3d-5210-af3f-833869259271" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186517754} {:answer/id #uuid "903accd6-cb1b-59f6-92d9-52cbca2aade9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{9}" :db/id #edb/ref 17592186517758}] :answer-field/correct {:db/id #edb/ref 17592186517547} :answer-field/id #uuid "d257b360-4e88-51e4-add3-d80d3561fcec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518070}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "17d3a51b-87c6-5439-b5d7-1ae7b5260460" :question/math-academy-id "q-101158" :question/problem "Evaluate ${lim}_{t\\to 2}\\frac{{t}^{2}+t-6}{{t}^{2}-9t+14}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{{t}^{2}+t-6}{{t}^{2}-9t+14} & =\\frac{{2}^{2}+2-6}{{2}^{2}-9(2)+14}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{t}^{2}+t-6}{{t}^{2}-9t+14} & =\\frac{(t+3)(t-2)}{(t-2)(t-7)} \\\\  & =\\frac{t+3}{t-7}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{t\\to 2}\\frac{{t}^{2}+t-6}{{t}^{2}-9t+14} & ={lim}_{t\\to 2}\\frac{t+3}{t-7} \\\\  & =\\frac{2+3}{2-7} \\\\  & =\\frac{5}{(-5)} \\\\  & =-1.\\end{aligned}\n$$"} :step/id #uuid "481c4610-a5dc-53ed-ae6e-370e534c6b45" :step/next {:db/id #edb/ref 17592186518293}} {:db/id #edb/ref 17592186518274 :step/content {:db/id #edb/ref 17592186518196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8a68754-36ce-52d6-9127-21d7b91302be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186517899}] :answer-field/correct {:db/id #edb/ref 17592186517899} :answer-field/id #uuid "ceec04e3-5f86-53fd-a80b-d4bd7eba9ecc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186518068}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c9bfaabb-1ddb-5591-87c5-e59f3a52dfbc" :question/math-academy-id "q-338200" :question/problem "Evaluate the following limit:\n\n${lim}_{y\\to 4}\\frac{{y}^{2}-16}{{y}^{2}-4y}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{y\\to 4}\\frac{{y}^{2}-16}{{y}^{2}-4y} & =\\frac{(4)^{2}-16}{(4)^{2}-4(4)} \\\\  & =\\frac{16-16}{16-16} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{y}^{2}-16}{{y}^{2}-4y} & =\\frac{(y-4)(y+4)}{y(y-4)} \\\\  & =\\frac{y+4}{y}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{y\\to 4}\\frac{{y}^{2}-16}{{y}^{2}-4y} & ={lim}_{y\\to 4}\\frac{y+4}{y} \\\\  & =\\frac{4+4}{4} \\\\  & =\\frac{8}{4} \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "955c3886-484b-5898-8b9e-865782ff28a4" :step/next {:db/id #edb/ref 17592186518286}} {:db/id #edb/ref 17592186518286 :step/content {:db/id #edb/ref 17592186518167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79457547-f0fb-58fa-a2c2-317026062441" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{10}" :db/id #edb/ref 17592186517716}] :answer-field/correct {:db/id #edb/ref 17592186517716} :answer-field/id #uuid "288b4964-15f8-5bdf-aea5-937b1035cccb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186517990}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7eccf962-783f-535d-b46e-1c5922c7413f" :question/math-academy-id "q-338206" :question/problem "Evaluate the following limit:\n\n${lim}_{y\\to 0}\\frac{7{y}^{6}-3{y}^{4}}{5{y}^{5}+10{y}^{4}}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{y\\to 0}\\frac{7{y}^{6}-3{y}^{4}}{5{y}^{5}+10{y}^{4}} & =\\frac{7(0)^{6}-3(0)^{4}}{5(0)^{5}+10(0)^{4}}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{7{y}^{6}-3{y}^{4}}{5{y}^{5}+10{y}^{4}} & =\\frac{{y}^{4}(7{y}^{2}-3)}{{y}^{4}(5y+10)} \\\\  & =\\frac{7{y}^{2}-3}{5y+10}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{y\\to 0}\\frac{7{y}^{6}-3{y}^{4}}{5{y}^{5}+10{y}^{4}} & ={lim}_{y\\to 0}\\frac{7{y}^{2}-3}{5y+10} \\\\  & =\\frac{7(0)-3}{5(0)+10} \\\\  & =-\\frac{3}{10}.\\end{aligned}\n$$"} :step/id #uuid "b56c33d1-61b7-5263-b02b-f1a42ae44b24"} {:db/id #edb/ref 17592186518293 :step/content {:db/id #edb/ref 17592186518149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f3291a2-9375-59ea-b11b-d3d51ab51141" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186517542} {:answer/id #uuid "2974ec32-c354-5379-8e1b-6a9acfaaddc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186517562} {:answer/id #uuid "58abb328-ad36-5cec-a8bc-f5da4562671f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186517652} {:answer/id #uuid "70d0b790-1084-5fd6-8c21-af30bf9f25cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-16" :db/id #edb/ref 17592186517705} {:answer/id #uuid "8ae9eecc-f45a-5e19-a6c0-5c2967aa26fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186517748}] :answer-field/correct {:db/id #edb/ref 17592186517562} :answer-field/id #uuid "97ef3454-a8d7-5dce-ad87-6a661e06cf5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518043}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "63acba77-7b2e-522a-aba2-29e686142675" :question/math-academy-id "q-140415" :question/problem "Evaluate ${lim}_{x\\to -4}\\frac{3x+12}{{x}^{3}+64}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{3x+12}{{x}^{3}+64} & =\\frac{3(-4)+12}{(-4)^{3}+64}=\\frac{-12+12}{-64+64}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. \n\nNotice that the denominator is a sum of cubes. Therefore, factoring our expression, we get\n\n$$\n\\begin{aligned}\\frac{3x+12}{{x}^{3}+64} & =\\frac{3(x+4)}{{x}^{3}+{4}^{3}} \\\\  & =\\frac{3(x+4)}{(x+4)({x}^{2}-4x+{4}^{2})} \\\\  & =\\frac{3}{{x}^{2}-4x+16}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{3x+12}{{x}^{3}+64} & ={lim}_{x\\to -4}\\frac{3}{{x}^{2}-4x+16} \\\\  & =\\frac{3}{(-4)^{2}-4(-4)+16} \\\\  & =\\frac{3}{16+16+16} \\\\  & =\\frac{1}{16}.\\end{aligned}\n$$"} :step/id #uuid "c854a8d0-adb7-5877-8a8d-92ee782e3584" :step/next {:db/id #edb/ref 17592186518274}}] :activity/title "Calculating Limits of Rational Functions by Factoring" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186517476}]}
