3bed86e32f13001a07b8742dcac596a196dbbd41461083.png" :db/id #edb/ref 17592186509964} {:answer/id #uuid "8419e766-8f52-55d6-a218-5e669e1bd46f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1f/1f93d346ca47a2bc1a877616d5e92bea56296cdbdaf7e9ad328506f2bce209f5.png" :db/id #edb/ref 17592186509978} {:answer/id #uuid "cb68c700-d919-5d8c-a997-8c8007d6801b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/32/32e9dd52864c9183df7b617cb60152e57d8b2635ea46e639d82d029288faa269.png" :db/id #edb/ref 17592186510115} {:answer/id #uuid "fb0d91b2-ad9d-5143-aa14-8c9b89b807d5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/47/47dc58b56980429deadfd19b118a599a9c7cd0f9786e3c8e40b0bde8a145e201.png" :db/id #edb/ref 17592186510227}] :answer-field/correct {:db/id #edb/ref 17592186510115} :answer-field/id #uuid "1ee5fb33-119f-57fb-80f8-4484325ed734" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510250}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b577ef62-3bc6-5dd8-a240-3b3950135891" :question/math-academy-id "q-91969" :question/problem "![](images/c7/c7e2d2b4be3fbfe1cb0944dec21c0779fc197d1282eef5a56e806f9ce56a4962.png)\n\nWhat picture is missing from the multiplication model above?" :question/worked-solution "In the model, we have $\\frac{2}{5}$ on the left.\n\nSince we need to multiply by $\\frac{1}{3}$, we split the whole into $3$ equal parts horizontally.\n\n![](images/4e/4e6aa019748eccb9faeb9cb87632e4545d74f4960bdfab3b7a50aa4065069c48.png)\n\nFrom the picture on the right, we obtain that the shaded part represents $\\frac{2}{15}$ of the whole.\n\nThe missing picture is:\n\n![](images/32/32e9dd52864c9183df7b617cb60152e57d8b2635ea46e639d82d029288faa269.png)"} :step/id #uuid "a3b5c6cd-4e14-5081-8958-d3aae4dd67b9" :step/next {:db/id #edb/ref 17592186510531}} {:db/id #edb/ref 17592186510531 :step/content {:db/id #edb/ref 17592186510455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0066f6b9-1f10-53cc-86f7-a00a8a9eff8f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $6$" :db/id #edb/ref 17592186509695} {:answer/id #uuid "1bc42286-a83d-5b57-a46a-fe1281e95763" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $2$" :db/id #edb/ref 17592186509743} {:answer/id #uuid "66d9767a-62ae-5f17-9185-c0baa86c13f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $4$" :db/id #edb/ref 17592186509902} {:answer/id #uuid "8195fd74-5e17-5be8-b759-2050b74a8f66" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $6$" :db/id #edb/ref 17592186509973} {:answer/id #uuid "f9966e5f-fbc1-5b55-a295-1a20de673201" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$1$ and $6$" :db/id #edb/ref 17592186510219}] :answer-field/correct {:db/id #edb/ref 17592186509973} :answer-field/id #uuid "375aea6f-f5c8-5740-8c1d-0b529d16360a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510268}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cf8a9fa4-0c6b-5d86-8b4f-17e214ee6603" :question/math-academy-id "q-59838" :question/problem "![](images/23/23196761364659fb01eb42ffd37c898331a654bf52e3ec1ebe79316f986a6d7e.png)\n\nEach of the two shapes in the model above represents one whole. From left to right, what numbers are missing from the division problem below?\n\n$$\n\\boxed{\\,\\,}÷\\frac{1}{3}=\\boxed{\\,\\,}\n$$" :question/worked-solution "In the model, there are $2$ shapes. Each shape consists of $3$ pieces that each represent $\\frac{1}{3}$ of a whole. There are $6$ pieces in total.\n\nThe model tells us that when we divide $2$ wholes into thirds, we will be left with $6$ pieces.\n\nHence, the division problem is:\n\n$$\n\\boxed{\\,2\\,}÷\\frac{1}{3}=\\boxed{\\,6\\,}\n$$\n\nTherefore, the missing numbers are $2$ and $6.$"} :step/id #uuid "a71e773f-7fbe-58b6-a3b5-68a1865f3681" :step/next {:db/id #edb/ref 17592186510505}} {:db/id #edb/ref 17592186510541 :step/content {:db/id #edb/ref 17592186510460 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b1f22c1-edc4-558c-9158-cfdc71446b10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{42}" :db/id #edb/ref 17592186509776} {:answer/id #uuid "411cf5d2-58f8-5bb5-a587-4a277e1f557e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{45}" :db/id #edb/ref 17592186509826} {:answer/id #uuid "5c31e3b9-101a-5731-b008-13009a0b7762" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{36}" :db/id #edb/ref 17592186509882} {:answer/id #uuid "87987214-d906-547f-9d3f-5d4de60bf3dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186509982} {:answer/id #uuid "c81af2aa-0e56-5864-a32d-43dbdc392a9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{32}" :db/id #edb/ref 17592186510108}] :answer-field/correct {:db/id #edb/ref 17592186509882} :answer-field/id #uuid "7310f3ce-4ed5-51ee-b6f5-00b3a3925cd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510299}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "da75b2dd-3237-5ce6-9291-2b2e45f7ef20" :question/math-academy-id "q-58378" :question/problem "$\\frac{1}{12}÷3=$" :question/worked-solution "To divide a unit fraction by a whole number, we multiply the fraction's denominator by that whole number:\n\n$$\n\\frac{1}{12}÷3=\\frac{1}{12\\times 3}=\\frac{1}{36}\n$$"} :step/id #uuid "c648d137-022b-534c-a353-55c4d167b7fb" :step/next {:db/id #edb/ref 17592186510500}} {:db/id #edb/ref 17592186510547 :step/content {:db/id #edb/ref 17592186510391 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4cf5470-2e71-528f-89cb-a9330ce9939c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{20}" :db/id #edb/r