7}{2}" :db/id #edb/ref 17592186509948} {:answer/id #uuid "a775de45-2e2d-57a7-bef1-dd4af4e4b0fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186510040} {:answer/id #uuid "abc3b9ea-f068-58f2-9f76-68addea27bae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14}{7}" :db/id #edb/ref 17592186510054}] :answer-field/correct {:db/id #edb/ref 17592186509816} :answer-field/id #uuid "a188b732-1f98-5213-b3b8-a7d308750285" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510322}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1ca8d09c-3b66-59cf-8927-0d3c487f55e4" :question/math-academy-id "q-150269" :question/problem "![](images/f7/f7492d3428b5d517bdfdf8b6ffe1df054f1ee0eb70ff40cb15581bf648472ed0.png)\n\nUse the model above to calculate $\\frac{1}{7}\\times 2.$" :question/worked-solution "Since we need to multiply $\\frac{1}{7}$ by $2$, we repeat the fraction model $2$ times, as shown below.\n\n![](images/33/3304c561bf0bbad1b9417e229163456e260e1d5e2022aea9aa275a843f6f12c7.png)\n\n \n\nThere are $2\\times 1=2$ shaded pieces in total. Therefore, \n\n$$\n\\frac{1}{7}\\times 2=\\frac{2}{7}.\n$$"} :step/id #uuid "e5cb3772-a6c9-58ba-ad1b-cf1de878a32e"}] :activity/title "Quiz 1" :activity/type {:db/id #edb/ref 17592186045460 :db/ident :activity.type/assessment} :db/id #edb/ref 17592186509678}]}
