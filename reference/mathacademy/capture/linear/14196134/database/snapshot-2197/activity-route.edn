#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186510509} :activity/id #uuid "10e70b87-a594-5ba5-b831-437d8f12abd9" :activity/steps [{:db/id #edb/ref 17592186510482 :step/content {:db/id #edb/ref 17592186510420 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68fc39bd-b94b-58ac-81dd-4d805d1f0c11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186509906} {:answer/id #uuid "6b7ca6a9-afa3-5418-b51a-aa29f33559ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{5}" :db/id #edb/ref 17592186509910} {:answer/id #uuid "71fe5d93-c8e1-5cc2-8672-876f61407444" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186509924} {:answer/id #uuid "7c70ae3f-5ff5-5786-be3c-12a9fd034015" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{16}" :db/id #edb/ref 17592186509954} {:answer/id #uuid "d0c45124-d30f-5ddf-a2e8-0de275bdcdb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{8}" :db/id #edb/ref 17592186510132}] :answer-field/correct {:db/id #edb/ref 17592186510132} :answer-field/id #uuid "a86b4383-0a44-5dbf-9bab-9a767c939096" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510326}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "852fda9f-31ba-5fd4-8170-a556e23b68b9" :question/math-academy-id "q-61588" :question/problem "What fraction is missing from the statement below?\n\n$$\n16\\times \\frac{5}{8}=\\frac{\\bbox[2pt,border:1pt solid black]{\\phantom{A}}}{\\bbox[2pt,border:1pt solid black]{\\phantom{A}}}\\times 5\n$$" :question/worked-solution "Interpreting the fraction as division, we can write our expression as:\n\n$$\n16\\times 5÷8\n$$\n\nWe can write an equivalent expression by swapping the $\\times 5$ and the $÷8:$\n\n$$\n16÷8\\times 5\n$$\n\nFinally, expressing the division as a fraction, we arrive at:\n\n$$\n\\frac{16}{8}\\times 5\n$$"} :step/id #uuid "11f026d1-05fd-58c9-977e-71070693efa3" :step/next {:db/id #edb/ref 17592186510485}} {:db/id #edb/ref 17592186510485 :step/content {:db/id #edb/ref 17592186510394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18e199cb-9d1a-55f6-ba2d-270b642b74af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75" :db/id #edb/ref 17592186509736} {:answer/id #uuid "76f504ef-d553-5765-a038-94d71090c9f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "80" :db/id #edb/ref 17592186509938} {:answer/id #uuid "7e25ecdc-25cf-5f56-be13-ff0caf742ace" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "70" :db/id #edb/ref 17592186509960} {:answer/id #uuid "997156ae-4ce9-5cf5-bed9-3076ebd31874" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{70}" :db/id #edb/ref 17592186510009} {:answer/id #uuid "cb5b89d9-fa69-5596-87c3-dd09b3e675ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{14}" :db/id #edb/ref 17592186510114}] :answer-field/correct {:db/id #edb/ref 17592186509960} :answer-field/id #uuid "af1c634f-6cda-542c-93f5-1b65d5d29c59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510330}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "594339a7-9976-5ba0-b28f-d33a28c1ef05" :question/math-academy-id "q-91803" :question/problem "$5÷\\frac{1}{14}=$" :question/worked-solution "To divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n5÷\\frac{1}{14}=5\\times 14=70\n$$"} :step/id #uuid "19655f53-67a7-53d6-ba70-32929dea4065" :step/next {:db/id #edb/ref 17592186510521}} {:db/id #edb/ref 17592186510500 :step/content {:db/id #edb/ref 17592186143194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e0357c7-1c51-5077-8b95-07f308839e24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186509850}] :answer-field/correct {:db/id #edb/ref 17592186509850} :answer-field/id #uuid "92b427cb-9398-5368-a038-ebdf307e71ff" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186140356}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0fd772d2-d88c-5889-b52a-bb0aa20863cb" :question/math-academy-id "q-186845" :question/problem "Expressed as a whole number, $\\frac{1}{2}\\times 2=${{field-1}}." :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{1\\times 2}{2}=\\frac{2}{2}.\n$$\n\nFinally, we simplify:\n\n$$\n2÷2=1\n$$"} :step/id #uuid "48cc0a46-d7c1-5da9-bc93-3faa6f6fc0b4" :step/next {:db/id #edb/ref 17592186510517}} {:db/id #edb/ref 17592186510505 :step/content {:db/id #edb/ref 17592186510438 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53184fe8-c56a-52ab-8980-31988461aa42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12x" :db/id #edb/ref 17592186509859} {:answer/id #uuid "58b5f39e-f2bd-52bf-be29-65a5fde0eff8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12-x" :db/id #edb/ref 17592186509873} {:answer/id #uuid "5ec1c0dc-e4b2-537c-b8d9-5b987ca0db8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-12" :db/id #edb/ref 17592186509885} {:answer/id #uuid "d0706b9e-9774-5b98-9272-ffd1f4dab2d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x}{12}" :db/id #edb/ref 17592186510129} {:answer/id #uuid "f5031e85-75fa-5f32-af7f-5a691012e32b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+12" :db/id #edb/ref 17592186510212}] :answer-field/correct {:db/id #edb/ref 17592186510212} :answer-field/id #uuid "e3fe8000-6f93-5ede-8354-5a5af55dae19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510353}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a89a0beb-9081-5694-a8c0-2b633fb2ad70" :question/math-academy-id "q-75559" :question/problem "Translate the following phrase into an algebraic expression: \"Twelve more than a number.\"" :question/worked-solution "If we denote our number by $x$, then the phrase \"twelve more than a number\" can be written as\n\n$$\nx+12.\n$$"} :step/id #uuid "5678f08a-458e-537c-8d70-1c9f06e29a0f" :step/next {:db/id #edb/ref 17592186510482}} {:db/id #edb/ref 17592186510509 :step/content {:db/id #edb/ref 17592186510413 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d0dde1b-0500-59ae-ae3d-9eb21c7ed9ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,-8)" :db/id #edb/ref 17592186509781} {:answer/id #uuid "4df4275b-dc8c-5a91-a8ee-855c4c10d909" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-8,-4)" :db/id #edb/ref 17592186509849} {:answer/id #uuid "75847f36-bc92-5923-a944-aaaabe892afb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8,4)" :db/id #edb/ref 17592186509936} {:answer/id #uuid "88ee5f6c-389b-50c5-868c-45ab4a3fd084" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,-8)" :db/id #edb/ref 17592186509985} {:answer/id #uuid "df7f503d-839e-5332-93e5-ab30280946fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-8,4)" :db/id #edb/ref 17592186510164}] :answer-field/correct {:db/id #edb/ref 17592186509781} :answer-field/id #uuid "939cc08d-b6c1-54a1-985c-4e6d4655de28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510313}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7a1c9a9e-192b-564f-9f04-0763b9d472b4" :question/math-academy-id "q-5747" :question/problem "![](images/6e/6e4cf483b68db33f213470f247ee118cad452c269e8420431730f457f5b5ca89.png)\n\nWhat are the $xy$-coordinates of the point shown in the axes above?" :question/worked-solution "To find the coordinates of the point, we inspect its position along the $x$ and $y$ axes.\n\nThe point is $4$ units to the *left* of the origin, in the *negative* direction of the $x$-axis. So, the point has an $x$-coordinate of $-4.$\n\nAdditionally, the point is $8$ units *below* the origin, in the *negative* direction of the $y$-axis. So, the point has a $y$-coordinate of $-8.$\n\nThe point has an $x$-coordinate of $-4$ and a $y$-coordinate of $-8,$ so its coordinates are $(-4,-8).$"} :step/id #uuid "59f9e0fc-b5d4-5437-aa50-f7d4b316ac92" :step/next {:db/id #edb/ref 17592186510530}} {:db/id #edb/ref 17592186510517 :step/content {:db/id #edb/ref 17592186510415 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a02cc2d-6667-50ea-a48f-849bc30c34b3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f1/f1f7ecca69164ce74359bf8e7b4efd3c29d48b47248710561042d0551a4a266d.png" :db/id #edb/ref 17592186509814} {:answer/id #uuid "3cfb8f3f-e2a2-56b6-b981-3c772cc165bc" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4e/4e0d14141085b9218e81bd3773c7d72466b4fcc91cfd331500b177de2ece5857.png" :db/id #edb/ref 17592186509820} {:answer/id #uuid "943cbc10-0dd4-52f6-abe0-986d55192028" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/5b/5bd25c97711a5d7fb789d8eb670b19c6260630235bfed72b4857fc3b54279fa7.png" :db/id #edb/ref 17592186510001} {:answer/id #uuid "b7b8f701-32e9-5bc4-a5e9-b11659c4492b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8e/8e4d072f17abd83c86c3c2ba9ea3fec409a01666ec1f96e6b5c16a7e744d597e.png" :db/id #edb/ref 17592186510080} {:answer/id #uuid "ff654e20-25bf-52db-b1f0-a56727ceb2dc" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/89/895515d7b86babd4981ae28ac6d41a4b5385c6d022e2440608d97812286983bd.png" :db/id #edb/ref 17592186510238}] :answer-field/correct {:db/id #edb/ref 17592186510080} :answer-field/id #uuid "447b4fc1-979f-59da-9c0d-