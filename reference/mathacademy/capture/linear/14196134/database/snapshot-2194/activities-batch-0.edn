#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074605} :activity/id #uuid "84bb85b0-fcbc-5f41-956b-e9fb4753720a" :activity/scope {:db/id #edb/ref 17592186048460 :topic/id #uuid "a1872f62-c9fe-5c68-8bb3-3c9dac0602b3" :topic/math-academy-id 528} :activity/steps [{:db/id #edb/ref 17592186074605 :step/content {:db/id #edb/ref 17592186075052 :tutorial/content "Remember that a *unit* fraction is a fraction containing ![](images/cc/ccee5f5be0445cce59832a3def74f395a7d05cc12dc630fb36baf8f3d2d448bd.svg) in the numerator. So, for example, the fractions \n\n![](images/2e/2e38b15a8f3be74e15b87e81264b66571e593de7250dc902aeaa0e7bc1c506bf.svg)\nare both unit fractions, whereas \n\n![](images/d1/d157ce836a54214740d295f545d4c94d8c57d54d92ac7f075ed9b92556c932b1.svg)\nare *not* unit fractions.\n\nIn this lesson, we will use models to divide unit fractions by whole numbers. \n\nLet's use a fraction model to find the value of \n\n![](images/d8/d8815c6716e962ce4aebee24d004d4c591a1bc35c5fdebcd87d26ace61ead7fb.svg)\nWe start with a square model of ![](images/9f/9fcebe90d169f37bbdbf55f9e4ac86ceaf6ea6d573d101f382a12008bb0c5c2a.svg) split *vertically*.\n\n![](images/cc/ccfe0f457342c456200c98cfc46e63bdc1153698282085164eeafae5c2092c45.png)\n\nTo divide ![](images/9a/9ae11798da63cafee6ce5ccf824a7b96f9f7407a4ee445d1431d907c36f5dd1b.svg) by ![](images/db/dbfe30ca4e672459c180bd90f25f84f025162b8ce73260773fb1fbdf39b0a052.svg) we split the above whole into ![](images/6f/6f33d8df0d08ae9bddce540bedf62f46e93e748e4a5b6fd85b1dc626953e44a6.svg) equal parts *horizontally*. Then, we remove any shaded parts that are not in the bottom row.\n\n![](images/79/7940073ba05d3136ee1d465530a60bc3624b7aa06fd7484d30797758a28976d7.png)\n\nFrom the picture on the right, we obtain that the shaded part represents ![](images/42/42accbcb8cbfd14800ac4a27bc87d5ba529ff4173a91499f32705cd41b0c88b0.svg) of the whole.\n\nTherefore,\n![](images/f1/f14a0f0f9efb98bdfe6cf40f4b1bbb2c88dc20272caaf9d604fcc44bce79d53c.svg)" :tutorial/id #uuid "5efb47fa-47c0-50c8-9c53-0a64bfc732ea" :tutorial/math-academy-id 8924 :tutorial/title "Introduction"} :step/id #uuid "f5584f93-514d-5a2f-bcbb-77e4a6db1fab" :step/math-academy-id 170369 :step/next {:db/id #edb/ref 17592186074606}} {:db/id #edb/ref 17592186074606 :step/content {:db/id #edb/ref 17592186073716 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073486 :question/id #uuid "4fae5cf1-65c9-5217-89ec-54b40e80f293" :question/math-academy-id "e-14418"} :knowledge-point/id #uuid "aabbe3f2-c799-5d31-b5c1-8d21b32afccc" :knowledge-point/questions [{:db/id #edb/ref 17592186074072} {:db/id #edb/ref 17592186074361} {:db/id #edb/ref 17592186426220} {:db/id #edb/ref 17592186426221}] :knowledge-point/title "Identifying the Division Problem Represented by a Model"} :step/id #uuid "d78545b2-12fd-53a7-b39d-42f2a610a91e" :step/math-academy-id 170370 :step/next {:db/id #edb/ref 17592186074607}} {:db/id #edb/ref 17592186074607 :step/content {:db/id #edb/ref 17592186073717 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073487 :question/id #uuid "9cd2d717-01de-5319-8759-2990e79d64ad" :question/math-academy-id "e-14420"} :knowledge-point/id #uuid "91201453-ec4d-55a4-8a7b-eae34fca9f8d" :knowledge-point/questions [{:db/id #edb/ref 17592186074070} {:db/id #edb/ref 17592186074073} {:db/id #edb/ref 17592186074462} {:db/id #edb/ref 17592186426218} {:db/id #edb/ref 17592186426219}] :knowledge-point/title "Identifying the Missing Divisor in a Division Model"} :step/id #uuid "35c4a621-9782-54f8-a831-e096eb3088b1" :step/math-academy-id 170373 :step/next {:db/id #edb/ref 17592186074608}} {:db/id #edb/ref 17592186074608 :step/content {:db/id #edb/ref 17592186073718 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073488 :question/id #uuid "62d9f262-e419-5a9d-a5cb-741c34613570" :question/math-academy-id "e-14423"} :knowledge-point/id #uuid "7bb96a84-3329-5702-ae45-a7d0ad2a95c6" :knowledge-point/questions [{:db/id #edb/ref 17592186074011} {:db/id #edb/ref 17592186074376} {:db/id #edb/ref 17592186426215} {:db/id #edb/ref 17592186426216}] :knowledge-point/title "Identifying the Missing Result in a Division Model"} :step/id #uuid "128f5715-4d86-5558-ae0e-858cc1b44bab" :step/math-academy-id 170377 :step/next {:db/id #edb/ref 17592186074609}} {:db/id #edb/ref 17592186074609 :step/content {:db/id #edb/ref 17592186073719 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073489 :question/id #uuid "c6e1860a-9fe5-559c-8a19-6ed98335659b" :question/math-academy-id "e-14424"} :knowledge-point/id #uuid "a903aacb-718a-52f6-8be7-a7043358b7bb" :knowledge-point/questions [{:db/id #edb/ref 17592186074012} {:db/id #edb/ref 17592186074075} {:db/id #edb/ref 17592186074076} {:db/id #edb/ref 17592186426214} {:db/id #edb/ref 17592186426217}] :knowledge-point/title "Using a Model to Solve a Division Problem"} :step/id #uuid "d81020bf-bfb8-5f39-8279-6ca9dd7e5cc6" :step/math-academy-id 170380}] :activity/title "Dividing Unit Fractions by Whole Numbers Using Models" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073948}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186162729} :activity/id #uuid "851263af-22ca-51b7-b65b-78ee6f9ebb50" :activity/scope {:db/id #edb/ref 17592186048962 :topic/id #uuid "cfc8bab9-3c84-588c-af07-f2c8e11b8d36" :topic/math-academy-id 3079} :activity/steps [{:db/id #edb/ref 17592186162729 :step/content {:db/id #edb/ref 17592186163366 :tutorial/content "We can use fraction models to multiply any two fractions. \n\nLet's figure out how to use models to compute the following product:\n\n$$\n\\dfrac{3}{5} \\times \\dfrac{2}{3}\n$$\n\nWe start with the model of $\\dfrac{3}{5}.$\n\n![](images/06/06869533fb9eae08e88187c0965c9683c3b00e8cf269b121f416ce7f473ad508.png)\n\nSince we need to multiply by $\\dfrac{\\color{red}2}{\\color{blue}3}$, we split the whole into $\\color{blue}3$ equal parts *horizontally*. But this time, we keep the shaded pieces in the bottom $\\color{red}2$ rows.\n\n![](images/0c/0c449cdff6dabfd6599925b0d450ab2d579ce49d2729b9a98fe63bb8992a850d.png)\n\nFrom the picture on the right, we see that the shaded part represents $\\dfrac{6}{15}$ of the whole.\n\nTherefore,\n\n$$\n\\dfrac{3}{5} \\times \\dfrac{2}{3} = \\dfrac{6}{15}.\n$$" :tutorial/id #uuid "98bc8936-f81c-50ef-a2f7-b9cb50262591" :tutorial/math-academy-id 8978 :tutorial/title "Introduction"} :step/id #uuid "a78e7754-a22c-59f9-9aa8-121a958efa96" :step/math-academy-id 135386 :step/next {:db/id #edb/ref 17592186162730}} {:db/id #edb/ref 17592186162730 :step/content {:db/id #edb/ref 17592186161913 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161716 :question/id #uuid "432754ac-d9f0-5843-a751-b13821e2e725" :question/math-academy-id "e-14520"} :knowledge-point/id #uuid "3443d2b1-14c5-50ba-90b3-73b8bef47016" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050954}] :knowledge-point/questions [{:db/id #edb/ref 17592186162459} {:db/id #edb/ref 17592186162557} {:db/id #edb/ref 17592186427478} {:db/id #edb/ref 17592186427482} {:db/id #edb/ref 17592186427485} {:db/id #edb/ref 17592186427488} {:db/id #edb/ref 17592186427489}] :knowledge-point/title "Identifying a Multiplication Problem Corresponding to a Model"} :step/id #uuid "ce6efcc9-d64a-577b-b5c0-6b41eb1de5ad" :step/math-academy-id 135387 :step/next {:db/id #edb/ref 17592186162731}} {:db/id #edb/ref 17592186162731 :step/content {:db/id #edb/ref 17592186161914 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161717 :question/id #uuid "1fbd22af-5d6d-58ff-ac16-cfbb1d2577de" :question/math-academy-id "e-14523"} :knowledge-point/id #uuid "d06ad10a-4be6-54c4-94b2-17a25f0c2c16" :knowledge-point/questions [{:db/id #edb/ref 17592186162461} {:db/id #edb/ref 17592186162558} {:db/id #edb/ref 17592186427477} {:db/id #edb/ref 17592186427484}] :knowledge-point/title "Identifying a Missing Number"} :step/id #uuid "89847e6c-e242-532d-83bb-f8a0289e83e0" :step/math-academy-id 135391 :step/next {:db/id #edb/ref 17592186162732}} {:db/id #edb/ref 17592186162732 :step/content {:db/id #edb/ref 17592186161915 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161718 :question/id #uuid "493da564-eed4-5ec7-b527-63fd3a68fc95" :question/math-academy-id "e-14528"} :knowledge-point/id #uuid "905c4fc9-5e62-5757-bee9-a9b277b62278" :knowledge-point/questions [{:db/id #edb/ref 17592186162559} {:db/id #edb/ref 17592186162560} {:db/id #edb/ref 17592186427479} {:db/id #edb/ref 17592186427480} {:db/id #edb/ref 17592186427481} {:db/id #edb/ref 17592186427487} {:db/id #edb/ref 17592186427491}] :knowledge-point/title "Identifying a Fraction Model Representing a Product of Two Fractions"} :step/id #uuid "3b3bbfe0-8570-53c6-a5b8-1b924bcf020b" :step/math-academy-id 135395 :step/next {:db/id #edb/ref 17592186162733}} {:db/id #edb/ref 17592186162733 :step/content {:db/id #edb/ref 17592186161916 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161719 :question/id #uuid "2e14de76-f6e2-51f8-9590-8283fe81ce82" :question/math-academy-id "e-14539"} :knowledge-point/id #uuid "fa21548a-67bc-506c-8d6f-980aec5950dc" :knowledge-point/questions [{:db/id #edb/ref 17592186162460} {:db/id #edb/ref 17592186162462} {:db/id #edb/ref 17592186427483} {:db/id #edb/ref 17592186427486} {:db/id #edb/ref 17592186427490} {:db/id #edb/ref 17592186427492} {:db/id #edb/ref 17592186427493}] :knowledge-point/title "Multiplying Two Fractions Using Fraction Models"} :step/id #uuid "a9b790a0-3cdf-5858-9145-025944236be0" :step/math-academy-id 135399}] :activity/title "Multiplying Fractions Using Models" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162206}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074592} :activity/id #uuid "46f0a6e7-151f-5ed2-99d7-1f23744fcd6d" :activity/scope {:db/id #edb/ref 17592186049415 :topic/id #uuid "f305b2e8-0949-5442-9a4e-a0e42cc69236" :topic/math-academy-id 530} :activity/steps [{:db/id #edb/ref 17592186074592 :step/content {:db/id #edb/ref 17592186075045 :tutorial/content "To divide a unit fraction by a whole number, we multiply the fraction's denominator by the whole number.\n\nFor example, to calculate $\\dfrac{1}{5} \\div {\\color{blue}2},$ we multiply the fraction's denominator by ${\\color{blue}2}\\!:$\n\n$$\n\\dfrac{1}{5} \\div {\\color{blue}2}  = \\dfrac{1}{5 \\times {\\color{blue}2}} = \\dfrac{1}{10}\n$$\n\nNotice that we get the same answer using a fraction model, and the process is similar.\n\n![](images/3f/3f1f0dddd115c0d820de4d79624bd87492e215a6c2de43071fda73a4a0684d77.png)" :tutorial/id #uuid "fcf4ea8b-7765-55e8-b5c1-a10899bee9f6" :tutorial/math-academy-id 8562 :tutorial/title "Introduction"} :step/id #uuid "b474bf4e-2005-5555-a057-fd7db3b289b5" :step/math-academy-id 136312 :step/next {:db/id #edb/ref 17592186074593}} {:db/id #edb/ref 17592186074593 :step/content {:db/id #edb/ref 17592186073707 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073463 :question/id #uuid "abfb2b94-b25f-589f-b1e0-883ce065ca7a" :question/math-academy-id "e-13698"} :knowledge-point/id #uuid "9ae15778-3c9c-549a-bde8-58875c98d1bc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048460} {:db/id #edb/ref 17592186050735}] :knowledge-point/questions [{:db/id #edb/ref 17592186074055} {:db/id #edb/ref 17592186074276} {:db/id #edb/ref 17592186074282} {:db/id #edb/ref 17592186426357} {:db/id #edb/ref 17592186426358} {:db/id #edb/ref 17592186426362} {:db/id #edb/ref 17592186426366} {:db/id #edb/ref 17592186426367}] :knowledge-point/title "Dividing a Unit Fraction"} :step/id #uuid "fc606030-824f-518c-b2c2-61a2081b0469" :step/math-academy-id 136313 :step/next {:db/id #edb/ref 17592186074594}} {:db/id #edb/ref 17592186074594 :step/content {:db/id #edb/ref 17592186073708 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073465 :question/id #uuid "e5ecc6c8-ef8d-569b-88cc-82fc31f09730" :question/math-academy-id "e-13700"} :knowledge-point/id #uuid "a2697799-83d5-5358-8f7e-32562fd91169" :knowledge-point/questions [{:db/id #edb/ref 17592186074038} {:db/id #edb/ref 17592186074281} {:db/id #edb/ref 17592186426360} {:db/id #edb/ref 17592186426363} {:db/id #edb/ref 17592186426364} {:db/id #edb/ref 17592186426365} {:db/id #edb/ref 17592186426368}] :knowledge-point/title "Dividing a Unit Fraction With a Two-Digit Denominator"} :step/id #uuid "52f13af0-120d-5b46-804e-4c4cf45042f7" :step/math-academy-id 136317 :step/next {:db/id #edb/ref 17592186074595}} {:db/id #edb/ref 17592186074595 :step/content {:db/id #edb/ref 17592186073709 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073466 :question/id #uuid "b95874b2-2a8e-5ffb-9cbf-8a919a7307fb" :question/math-academy-id "e-13705"} :knowledge-point/id #uuid "fb0eb807-0eda-5565-ae49-a89a97a5b016" :knowledge-point/questions [{:db/id #edb/ref 17592186074056} {:db/id #edb/ref 17592186074283} {:db/id #edb/ref 17592186426356} {:db/id #edb/ref 17592186426359} {:db/id #edb/ref 17592186426361} {:db/id #edb/ref 17592186426369} {:db/id #edb/ref 17592186426370}] :knowledge-point/title "Word Problems"} :step/id #uuid "09ba6c04-edf9-59b5-bc27-8b2e2f8cd62a" :step/math-academy-id 136320}] :activity/title "Dividing Unit Fractions by Whole Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073950}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074903} :activity/id #uuid "b8b9ca72-6ee3-5fad-a697-5a0ef1a4574c" :activity/scope {:db/id #edb/ref 17592186049526 :topic/id #uuid "fc49e19b-1ab9-5364-ac0b-4d9b5ebd9a23" :topic/math-academy-id 533} :activity/steps [{:db/id #edb/ref 17592186074903 :step/content {:db/id #edb/ref 17592186075046 :tutorial/content "To divide a whole number by a unit fraction, we can multiply the whole number by the fraction's denominator.\n\nSo, to divide $2 \\div \\dfrac{1}{\\color{blue}5},$ we multiply the $2$ by ${\\color{blue}5}\\!:$\n\n$$\n2 \\div \\dfrac{1}{\\color{blue}5} = 2 \\times {\\color{blue}5} = 10\n$$\n\nAnd that's the answer! Notice that this method does the same job as the fraction model method we used before:\n\n![](images/5f/5f2eb6ab39ea67466d7a42a8809b8a039a84f9a20a13cca3659d81f669a772a5.png)" :tutorial/id #uuid "058743c7-e03e-521c-92ce-c1a5fd00663f" :tutorial/math-academy-id 8572 :tutorial/title "Introduction"} :step/id #uuid "65c45801-df02-5e24-9d1c-d20654b36c65" :step/math-academy-id 93403 :step/next {:db/id #edb/ref 17592186074904}} {:db/id #edb/ref 17592186074904 :step/content {:db/id #edb/ref 17592186073901 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073469 :question/id #uuid "469cedf6-ef5d-5dcd-902e-418b6f19e347" :question/math-academy-id "e-13723"} :knowledge-point/id #uuid "86c1c87e-1069-52cb-9b60-0c1d9439685c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050665}] :knowledge-point/questions [{:db/id #edb/ref 17592186074277} {:db/id #edb/ref 17592186074278} {:db/id #edb/ref 17592186425905}] :knowledge-point/title "Dividing a Whole Number by a Unit Fraction When the Denominator has One Digit"} :step/id #uuid "300cdd9f-b0a5-526a-907d-3323aed6cfc9" :step/math-academy-id 93404 :step/next {:db/id #edb/ref 17592186074905}} {:db/id #edb/ref 17592186074905 :step/content {:db/id #edb/ref 17592186073902 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073470 :question/id #uuid "a09cb492-4d6a-54ee-884e-fc3ce58bf997" :question/math-academy-id "e-13724"} :knowledge-point/id #uuid "2b882300-206f-5ecd-934b-bdf754ad1264" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050735}] :knowledge-point/questions [{:db/id #edb/ref 17592186074284} {:db/id #edb/ref 17592186074285} {:db/id #edb/ref 17592186425907} {:db/id #edb/ref 17592186425909}] :knowledge-point/title "Dividing a Whole Number by a Unit Fraction When the Denominator has Two Digits"} :step/id #uuid "2868f3bf-331f-5d98-b8a2-329c0d7d3ceb" :step/math-academy-id 93407 :step/next {:db/id #edb/ref 17592186074906}} {:db/id #edb/ref 17592186074906 :step/content {:db/id #edb/ref 17592186073903 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073471 :question/id #uuid "bdc09ee6-a719-5dad-b85e-acb7cdc92458" :question/math-academy-id "e-13725"} :knowledge-point/id #uuid "d271bad8-9fd9-5026-a5b1-794acae68937" :knowledge-point/questions [{:db/id #edb/ref 17592186074279} {:db/id #edb/ref 17592186074286} {:db/id #edb/ref 17592186425906} {:db/id #edb/ref 17592186425908}] :knowledge-point/title "Dividing Whole Numbers by Unit Fractions: Word Problems"} :step/id #uuid "29859205-5375-5c4e-971d-54f1c05b3f49" :step/math-academy-id 93410}] :activity/title "Dividing Whole Numbers by Unit Fractions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073953}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186193793} :activity/id #uuid "4d61d371-4b1d-53de-aa5b-4f42cd001c6f" :activity/scope {:db/id #edb/ref 17592186049804 :topic/id #uuid "1536bce1-492f-5bac-a22e-80aecb57bdd7" :topic/math-academy-id 3968} :activity/steps [{:db/id #edb/ref 17592186193793 :step/content {:db/id #edb/ref 17592186193931 :tutorial/content "We can use our knowledge of fraction models to multiply fractions by whole numbers. \n\nFor example, let's consider the following product:\n\n$$\n\\dfrac{3}{10} \\times 2.\n$$\n\nWe start by drawing a fraction model for $\\dfrac{3}{10}{:}$ \n\n![](images/74/7441921087fa0748dc0de6843c45c93fd9c492bade22fc8ae31192fd9c943016.png)\n\n \n\nMultiplying $\\dfrac{\\color{red}3}{10}$ by $\\color{blue}2$ means that we need to repeat the fraction $\\color{blue}2$ times.\n\n![](images/88/88ba96e731a6242aecea0a6b059933e128efdf6bbb52f37a0a73e57a004ab96c.png)\n\n \n\nNow, we count the number of shaded pieces. \n\nThere are ${\\color{red}3} \\times {\\color{blue}2} = 6$ shaded pieces in total. Therefore,\n\n$$\n\\dfrac{3}{10} \\times 2 = \\dfrac{6}{10}.\n$$" :tutorial/id #uuid "bfe48a90-960a-5004-8a63-a58ea72103ff" :tutorial/math-academy-id 8518 :tutorial/title "Introduction"} :step/id #uuid "87fc1377-7af4-5e22-a70c-aed6997dce8c" :step/math-academy-id 88301 :step/next {:db/id #edb/ref 17592186193794}} {:db/id #edb/ref 17592186193794 :step/content {:db/id #edb/ref 17592186192858 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192568 :question/id #uuid "56936482-95f9-54ff-b006-cd79247947ba" :question/math-academy-id "e-13618"} :knowledge-point/id #uuid "a891eaf9-6a4c-5e87-8aa0-95920347bd4d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050244}] :knowledge-point/questions [{:db/id #edb/ref 17592186193365} {:db/id #edb/ref 17592186193367} {:db/id #edb/ref 17592186425480} {:db/id #edb/ref 17592186425481} {:db/id #edb/ref 17592186425483} {:db/id #edb/ref 17592186425490} {:db/id #edb/ref 17592186425491}] :knowledge-point/title "Representing a Product as a Repeated Addition"} :step/id #uuid "96c0a507-52a5-5363-8641-411d16b13295" :step/math-academy-id 88302 :step/next {:db/id #edb/ref 17592186193795}} {:db/id #edb/ref 17592186193795 :step/content {:db/id #edb/ref 17592186192859 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192569 :question/id #uuid "6a8062c4-e4e5-5045-8b33-7f0afaf76d72" :question/math-academy-id "e-13624"} :knowledge-point/id #uuid "0abaf0f6-4018-54b2-a118-f420a3e0705c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051077}] :knowledge-point/questions [{:db/id #edb/ref 17592186192963} {:db/id #edb/ref 17592186193364} {:db/id #edb/ref 17592186425484} {:db/id #edb/ref 17592186425485} {:db/id #edb/ref 17592186425488} {:db/id #edb/ref 17592186425489}] :knowledge-point/title "Multiplying a Fraction by a Whole Number Using Repeated Addition"} :step/id #uuid "1b181827-1135-5056-b586-5b3139e0ce58" :step/math-academy-id 88305 :step/next {:db/id #edb/ref 17592186193796}} {:db/id #edb/ref 17592186193796 :step/content {:db/id #edb/ref 17592186193932 :tutorial/content "There's another way we can use fraction models to multiply fractions by whole numbers.\n\nTo demonstrate, let's consider the following multiplication problem:\n\n$$\n\\dfrac{2}{9} \\times 4\n$$\n\nWe start by drawing a fraction model to represent $\\dfrac{2}{9}.$\n\n![](images/d3/d3c46b3452b6d5d22a30a9949800d7a69bdacf4135615627881c9dc69c0a5513.png)\n\n \n\nNow, rather than repeating our model $4$ times (which would take a long time), we can instead multiply the number of shaded pieces by $4.$ \n\nOur model has $2$ shaded pieces. So, the resulting model must have $2 \\times 4 = 8$ shaded pieces:\n\n![](images/b9/b99a75597e9e06cdd0c267b291ae0d671d670f7a3fc4b9af4555d9b217a0b4ed.png)\n\nTherefore, we conclude that\n\n$$\n\\dfrac{2}{9}\\times 4 = \\dfrac{8}{9}.\n$$" :tutorial/id #uuid "dbb3bf95-1b0b-52ea-b1ff-7a7a7c5d11f6" :tutorial/math-academy-id 8524 :tutorial/title "A Faster Method for Multiplying Fractions by Whole Numbers"} :step/id #uuid "c1d11338-8db9-53d5-b934-67da3916921a" :step/math-academy-id 88308 :step/next {:db/id #edb/ref 17592186193797}} {:db/id #edb/ref 17592186193797 :step/content {:db/id #edb/ref 17592186192860 :knowledge-point/canonical-example {:db/id #edb/ref 17592186192570 :question/id #uuid "3c170236-340b-5446-960f-a20b6937c23c" :question/math-academy-id "e-13628"} :knowledge-point/id #uuid "78c0c75e-8a40-5064-a62a-954d8b85c3c1" :knowledge-point/questions [{:db/id #edb/ref 17592186193366} {:db/id #edb/ref 17592186193368} {:db/id #edb/ref 17592186425479} {:db/id #edb/ref 17592186425482} {:db/id #edb/ref 17592186425486} {:db/id #edb/ref 17592186425487}] :knowledge-point/title "Multiplying a Fraction by a Whole Number by Repeating the Shaded Parts"} :step/id #uuid "6ab5f02a-0507-5d82-88b7-8426ecc223d8" :step/math-academy-id 88309}] :activity/title "Multiplying Fractions by Whole Numbers Using Models" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186192881}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074736} :activity/id #uuid "5e2897c1-674c-573a-bc21-b2ee8969cb98" :activity/scope {:db/id #edb/ref 17592186050244 :topic/id #uuid "39037448-ec95-5f7d-a4a1-9f6678563857" :topic/math-academy-id 564} :activity/steps [{:db/id #edb/ref 17592186074736 :step/content {:db/id #edb/ref 17592186075016 :tutorial/content "We can use fraction models to multiply unit fractions by whole numbers. \n\nFor example, let's consider the following product: \n\n$$\n\\dfrac 13 \\times 2\n$$\n\nFirst, we represent $\\dfrac{1}{3}$ using a model:\n\n![](images/f0/f08054646558ab944940f1f8f0d8a1077748f9882039e775c6cbdd4d307db102.png)\n\n \n\nMultiplication by a whole number is simply a repeated addition. And, since we need to multiply $\\dfrac{\\color{red}1}{3}$ by ${\\color{blue}2},$ we repeat the fraction model $\\color{blue}2$ times, as shown below.\n\n![](images/31/31fcef6d631262e49fc9c9297fd006f935fd7ee8182b0074d77ae22b626efbbc.png)\n\n \n\nThere are ${\\color{blue}2} \\times {\\color{red}1} = 2$ shaded pieces in total. Therefore, we conclude that\n\n$$\n2 \\times \\dfrac{1}{3} = \\dfrac{2}{3}.\n$$" :tutorial/id #uuid "0baa395e-db83-5229-83f7-f40fd99e8a4f" :tutorial/math-academy-id 6606 :tutorial/title "Introduction"} :step/id #uuid "cf5a7b59-9df0-505a-86e0-c7437dc8b262" :step/math-academy-id 39867 :step/next {:db/id #edb/ref 17592186074737}} {:db/id #edb/ref 17592186074737 :step/content {:db/id #edb/ref 17592186073795 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073417 :question/id #uuid "a3241956-5b5b-5760-9383-d7da13f48b16" :question/math-academy-id "e-10548"} :knowledge-point/id #uuid "95e51046-fc4c-536b-91eb-82c7c298b7be" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051027}] :knowledge-point/questions [{:db/id #edb/ref 17592186074413} {:db/id #edb/ref 17592186074414} {:db/id #edb/ref 17592186425255} {:db/id #edb/ref 17592186425260} {:db/id #edb/ref 17592186425265} {:db/id #edb/ref 17592186425267} {:db/id #edb/ref 17592186425269}] :knowledge-point/title "Representing a Product as a Repeated Addition"} :step/id #uuid "f29f88a5-25e3-54f3-b724-70c3d82de050" :step/math-academy-id 39868 :step/next {:db/id #edb/ref 17592186074738}} {:db/id #edb/ref 17592186074738 :step/content {:db/id #edb/ref 17592186073796 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073418 :question/id #uuid "eea25500-f78e-544f-8bf9-7eaacfac84a6" :question/math-academy-id "e-10549"} :knowledge-point/id #uuid "c1e7017e-45df-5adf-9ded-3f815b4f5673" :knowledge-point/questions [{:db/id #edb/ref 17592186074006} {:db/id #edb/ref 17592186074410} {:db/id #edb/ref 17592186424833} {:db/id #edb/ref 17592186425258} {:db/id #edb/ref 17592186425262} {:db/id #edb/ref 17592186425266} {:db/id #edb/ref 17592186425268}] :knowledge-point/title "Multiplying a Unit Fraction by a Whole Number Using Repeated Addition"} :step/id #uuid "ec8f3fd6-e68a-5a08-909a-7ca8734e46ba" :step/math-academy-id 39869 :step/next {:db/id #edb/ref 17592186074740}} {:db/id #edb/ref 17592186074739 :step/content {:db/id #edb/ref 17592186073797 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073419 :question/id #uuid "1c074473-dc1c-56c6-825b-be4b6b3dbfa2" :question/math-academy-id "e-10550"} :knowledge-point/id #uuid "23f5f4f6-9d8c-5ab5-ada8-1212832de40f" :knowledge-point/questions [{:db/id #edb/ref 17592186074415} {:db/id #edb/ref 17592186074416} {:db/id #edb/ref 17592186425259} {:db/id #edb/ref 17592186425261} {:db/id #edb/ref 17592186425264} {:db/id #edb/ref 17592186425270}] :knowledge-point/title "Identifying a Multiplication Problem Given a Model"} :step/id #uuid "6cd88bb7-dfba-55b2-bb7a-0cce2188c27c" :step/math-academy-id 39871 :step/next {:db/id #edb/ref 17592186074741}} {:db/id #edb/ref 17592186074740 :step/content {:db/id #edb/ref 17592186075017 :tutorial/content "There's another way we can use fraction models to multiply unit fractions by whole numbers.\n\nTo demonstrate, let's consider the multiplication problem below:\n\n$$\n\\dfrac{1}{10} \\times 7\n$$\n\nWe start by drawing a fraction model to represent $\\dfrac{1}{10}.$\n\n![](images/62/62b50e658ed9bc691a9559548d09f87fbd3b33e007e81b5e78a3235ac4bc3280.png)\n\n \n\nNow, rather than repeating our model $7$ times (which would take a long time), we can instead multiply the number of shaded pieces by $7.$ \n\nOur model has $1$ shaded piece. So, the resulting model must have $1 \\times 7 = 7$ shaded pieces: \n\n![](images/2a/2a7d54b1d7a6a6013ee64b601d9dc0ba31c8a25dae0f5f69abba4b0fed0e8ee2.png)\n\nTherefore, we conclude that\n\n$$\n\\dfrac{1}{10}\\times 7 = \\dfrac{7}{10}.\n$$" :tutorial/id #uuid "5b799a98-0619-525c-b2da-433704f26bd8" :tutorial/math-academy-id 6608 :tutorial/title "A Faster Way of Computing a Product Using Models"} :step/id #uuid "0ff59236-e8f5-575d-bc8b-731fac2b148a" :step/math-academy-id 39884 :step/next {:db/id #edb/ref 17592186074739}} {:db/id #edb/ref 17592186074741 :step/content {:db/id #edb/ref 17592186073798 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073420 :question/id #uuid "3e10607a-5812-50cd-a2d5-4b7c3ebcbde1" :question/math-academy-id "e-10555"} :knowledge-point/id #uuid "8bf2fa4e-c47e-5d89-a4aa-8e255050f792" :knowledge-point/questions [{:db/id #edb/ref 17592186074407} {:db/id #edb/ref 17592186074408} {:db/id #edb/ref 17592186425256} {:db/id #edb/ref 17592186425257} {:db/id #edb/ref 17592186425263} {:db/id #edb/ref 17592186425271}] :knowledge-point/title "Identifying a Missing Factor Given a Model"} :step/id #uuid "111068bf-412d-586d-b167-f6557ad36f93" :step/math-academy-id 39885}] :activity/title "Multiplying Unit Fractions by Whole Numbers Using Models" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073982}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186148328} :activity/id #uuid "cd9044aa-4ba8-52ca-97b0-9e256d7f85b1" :activity/scope {:db/id #edb/ref 17592186050475 :topic/id #uuid "4c95526a-a8d3-5fe5-bcd6-80a4165aa35c" :topic/math-academy-id 2458} :activity/steps [{:db/id #edb/ref 17592186148328 :step/content {:db/id #edb/ref 17592186148776 :tutorial/content "Remember that every fraction represents a division: the numerator divided by the denominator. \n\nFor example,\n\n$$\n\\dfrac{5}{3} = 5 \\div 3.\n$$\n\nWe can use this idea to rewrite expressions containing fractions.\n\nFor example, suppose we want to rewrite the following expression:\n\n$$\n\\dfrac{5}{\\color{red}3}\\times {\\color{blue}12}\n$$\n\nInterpreting the fraction as division, we can write our expression as\n\n$$\n5{\\color{red}\\;\\div\\; 3}{\\color{blue}\\;\\times\\; 12}.\n$$\n\nNext, we use the fact that we can swap the order of multiplication and division. So, we can write an equivalent expression by switching the $\\color{red}\\div\\, 3$ and the ${\\color{blue}\\times\\, 12},$ as follows:\n\n$$\n5{\\color{blue}\\;\\times\\; 12}{\\color{red}\\;\\div\\; 3}\n$$\n\nTherefore, \n\n$$\n\\dfrac{5}{\\color{red}3} \\times {\\color{blue}12} = 5{\\color{blue}\\;\\times\\; 12}{\\color{red}\\;\\div\\; 3}.\n$$" :tutorial/id #uuid "b7482125-2f1c-530c-8189-c96395c36e6f" :tutorial/math-academy-id 7865 :tutorial/title "Introduction"} :step/id #uuid "df46e27d-7449-54c2-b98a-b0c900fb421f" :step/math-academy-id 45354 :step/next {:db/id #edb/ref 17592186148329}} {:db/id #edb/ref 17592186148329 :step/content {:db/id #edb/ref 17592186147457 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147140 :question/id #uuid "a3ef9728-84fb-50d0-a50b-774386ca7c9d" :question/math-academy-id "e-12570"} :knowledge-point/id #uuid "0b508e1a-00f5-58d1-b399-344884761c8e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048624}] :knowledge-point/questions [{:db/id #edb/ref 17592186147851} {:db/id #edb/ref 17592186147852} {:db/id #edb/ref 17592186426686} {:db/id #edb/ref 17592186426690} {:db/id #edb/ref 17592186426692} {:db/id #edb/ref 17592186426698} {:db/id #edb/ref 17592186426701}] :knowledge-point/title "Expressing Multiplication of Fractions by Whole Numbers as Multiplication and Division"} :step/id #uuid "eeab3688-5437-5fbc-a190-8b69f65298ae" :step/math-academy-id 45355 :step/next {:db/id #edb/ref 17592186148330}} {:db/id #edb/ref 17592186148330 :step/content {:db/id #edb/ref 17592186148777 :tutorial/content "Consider the expression $\\dfrac{5}{\\color{red}3} \\times {\\color{blue}12}.$ By expressing the fraction as division, we have\n\n$$\n5 {\\color{red}\\;\\div\\; 3} {\\color{blue}\\;\\times\\; 12},\n$$\n\nand by swapping the ${\\color{red}\\div\\; 3}$ and the ${\\color{blue}\\times\\; 12},$ we have\n\n$$\n5 {\\color{blue}\\;\\times\\; 12}{\\color{red}\\;\\div\\; 3}.\n$$\n\nNow, notice that we can rewrite the division ${\\color{blue}12} {\\color{red}\\;\\div\\; 3}$ as a new fraction $\\dfrac{\\color{blue}12}{\\color{red}3}$ to produce a new expression:\n\n$$\n5\\times \\dfrac{\\color{blue}12}{\\color{red}3}\n$$\n\nTherefore,\n\n$$\n\\dfrac{5}{\\color{red}3} \\times {\\color{blue}12} = 5\\times \\dfrac{\\color{blue}12}{\\color{red}3}.\n$$" :tutorial/id #uuid "0f263274-ece0-59e1-9732-f5f3d6d87b96" :tutorial/math-academy-id 7866 :tutorial/title "Further Interpreting Multiplication of Fractions and Whole Numbers"} :step/id #uuid "6e04c40f-4a56-5045-8f36-31065daea522" :step/math-academy-id 45358 :step/next {:db/id #edb/ref 17592186148331}} {:db/id #edb/ref 17592186148331 :step/content {:db/id #edb/ref 17592186147458 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147141 :question/id #uuid "b8af91a0-f5c0-545e-b188-b62cde696bb8" :question/math-academy-id "e-12571"} :knowledge-point/id #uuid "fdcb850d-14d5-56e9-81d8-9af497460503" :knowledge-point/questions [{:db/id #edb/ref 17592186147853} {:db/id #edb/ref 17592186147867} {:db/id #edb/ref 17592186426684} {:db/id #edb/ref 17592186426685} {:db/id #edb/ref 17592186426687} {:db/id #edb/ref 17592186426691}] :knowledge-point/title "Expressing Multiplication and Division as Multiplication of Fractions by Whole Numbers"} :step/id #uuid "fb6a16ba-0abb-515f-a429-f4596b79106e" :step/math-academy-id 45359 :step/next {:db/id #edb/ref 17592186148332}} {:db/id #edb/ref 17592186148332 :step/content {:db/id #edb/ref 17592186147459 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147142 :question/id #uuid "812e5cc8-ff6f-5e67-84bf-f012dec63466" :question/math-academy-id "e-12572"} :knowledge-point/id #uuid "dfdc6b8f-e329-57b4-9ae9-e2f2c92105be" :knowledge-point/questions [{:db/id #edb/ref 17592186147849} {:db/id #edb/ref 17592186147896} {:db/id #edb/ref 17592186426688} {:db/id #edb/ref 17592186426689} {:db/id #edb/ref 17592186426693} {:db/id #edb/ref 17592186426697} {:db/id #edb/ref 17592186426699}] :knowledge-point/title "Swapping the Multiplier and the Numerator of a Fraction"} :step/id #uuid "6e42676a-b45f-56b2-a9e5-d59f5b006abd" :step/math-academy-id 45362 :step/next {:db/id #edb/ref 17592186148333}} {:db/id #edb/ref 17592186148333 :step/content {:db/id #edb/ref 17592186148778 :tutorial/content "Let's evaluate the following expression:\n\n$$\n\\dfrac{5}{\\color{red}3} \\times {\\color{blue}12}\n$$\n\nFirst, by swapping the order of multiplication and division, we can rewrite our expression as\n\n$$\n5\\times \\dfrac{\\color{blue}12}{\\color{red}3}.\n$$\n\nNow, notice that ${\\color{red}3}$ is a factor of ${\\color{blue}{12}},$ and\n\n$$\n\\dfrac{\\color{blue}12}{\\color{red}3} = {\\color{blue}{12}} \\div {\\color{red}3}  = 4.\n$$\n\nTherefore, we can evaluate our entire expression as follows:\n\n$$\n5\\times \\underbrace{\\dfrac{\\color{blue}12}{\\color{red}3}}_{4} = 5 \\times 4 = 20\n$$" :tutorial/id #uuid "d51c39ab-4754-5f52-be5e-037be0398c1b" :tutorial/math-academy-id 7867 :tutorial/title "Solving Multiplication of Fractions and Whole Numbers"} :step/id #uuid "b11f333c-1bba-560f-a6e4-fc9a9b756bd3" :step/math-academy-id 45365 :step/next {:db/id #edb/ref 17592186148334}} {:db/id #edb/ref 17592186148334 :step/content {:db/id #edb/ref 17592186147460 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147143 :question/id #uuid "dfa40a5c-e8ed-55c0-83e7-bd701eae0da5" :question/math-academy-id "e-12573"} :knowledge-point/id #uuid "5726ea5c-ba64-51c2-b5ac-0915853fd080" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050742}] :knowledge-point/questions [{:db/id #edb/ref 17592186147865} {:db/id #edb/ref 17592186147868} {:db/id #edb/ref 17592186426694} {:db/id #edb/ref 17592186426695} {:db/id #edb/ref 17592186426696} {:db/id #edb/ref 17592186426700}] :knowledge-point/title "Evaluating an Expression by Interpreting a Fraction as Division"} :step/id #uuid "087a4adb-8491-530e-a76f-f944701fc12c" :step/math-academy-id 45366}] :activity/title "Strategies to Simplify Whole Number and Fraction Multiplication" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186147659}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055836} :activity/id #uuid "c871a154-cf68-51db-83a7-946dca52e14d" :activity/scope {:db/id #edb/ref 17592186050517 :topic/id #uuid "50123c1c-7113-541e-8c4f-047f2eec416d" :topic/math-academy-id 92} :activity/steps [{:db/id #edb/ref 17592186055836 :step/content {:db/id #edb/ref 17592186055942 :tutorial/content "The **Cartesian coordinate system** (or **Cartesian plane**) is a grid that we can use to understand where certain objects lie, similar to a map. This grid looks as follows:\n\n![](images/fd/fd702a53ff1127a2432cbdd9a3c7057a08c73ac7a086454c066fa2c96bea7974.png)\n\nIt consists of a horizontal number line called the **$x$-axis** and a vertical number line called the **$y$-axis**.\n\nThe **origin** is the location where the $x$ and $y$ axes meet and is given the symbol $O.$" :tutorial/id #uuid "dacc8373-6186-517b-bba8-ec1729732e4d" :tutorial/math-academy-id 1431 :tutorial/title "Introduction"} :step/id #uuid "5cca38c5-c625-5a28-92d3-ccdcc09f108d" :step/math-academy-id 607419 :step/next {:db/id #edb/ref 17592186055837}} {:db/id #edb/ref 17592186055837 :step/content {:db/id #edb/ref 17592186055943 :tutorial/content "Every location on the Cartesian plane is called a **point**. Every point is identified using an $x$**-coordinate** and a $y$**-coordinate**. Together, points are expressed using an **ordered pair** of **coordinates** $(x,y).$\n\nFor example, we can mark (or **plot**) the point $A$ with coordinates $({\\color{red}{3}},{\\color{blue}{2}})$ by starting from $O$ and then traveling $\\color{red}3$ units towards the right, followed $\\color{blue}2$ units up.\n\n![](images/c1/c1ef61dedbbcc6eedcd125c2c62cdfbaa4d9b9a12f10181714b51c060a059fd3.png)\n\nWe say that\n\n- the $x$-coordinate of $A$ is $3$,\n\n- the $y$-coordinate of $A$ is $2$,\n\n- the $xy$-coordinates (or just \"the coordinates\") of $A$ are $(3,2).$\n\nThe letter $A$ is just a label for our point. It's usually a good idea to label points!" :tutorial/id #uuid "9e7847c5-757a-5cb8-b947-9c7d806b5dc5" :tutorial/math-academy-id 1432 :tutorial/title "Coordinates and Ordered Pairs"} :step/id #uuid "b81ec1ae-2147-51bf-abd0-42837ec9335a" :step/math-academy-id 607420 :step/next {:db/id #edb/ref 17592186055838}} {:db/id #edb/ref 17592186055838 :step/content {:db/id #edb/ref 17592186055957 :tutorial/content "Remember that a coordinate plane is made by two number lines that meet at $0.$ Since these are number lines, we can extend both to include negative numbers.\n\n![](images/f1/f1eeb7f3bc0ab8b39e9dc7127d76a32f1dd130d380748fedc6e11b967f3878ed.png)\n\nWe plot an ordered pair $({\\color{red}x},{\\color{blue}y})$ similar to before, but if the number is negative, we reverse the direction. So, starting at the origin:\n\n- if the first number is positive, move that number of places *right* along the $\\color{red}x$-axis. If its negative, move *left*.\n\n- if the second number is positive, move that number of places *up* along the $\\color{blue}y$-axis. If its negative, move *down*.\n\nTo demonstrate, let's find the coordinates of the point $Q$ above.\n\nTo find the coordinates of $Q,$ we start at the origin, move $\\color{red}3$ units *left*, and then $\\color{blue}2$ units *down*. \n\n![](images/b4/b4f58f0c1ad6dc2936ed1b24c844fa82c1b1d5ec10c80e14c6a43f6f4eaf5544.png)\n\nSince we move left, the $\\color{red}x$-coordinate is negative, and since we move down, the $\\color{blue}y$-coordinate is negative.\n\nTherefore, the coordinates of $Q$ are $({\\color{red}{-3}},{\\color{blue}{-2}}).$" :tutorial/id #uuid "7383452c-9470-5f05-b206-dffbb84808dd" :tutorial/math-academy-id 2092 :tutorial/title "Extending the Coordinate Plane to Negative Numbers"} :step/id #uuid "a86683d5-cc60-54e3-a1ca-8ddc210beec5" :step/math-academy-id 607421 :step/next {:db/id #edb/ref 17592186055839}} {:db/id #edb/ref 17592186055839 :step/content {:db/id #edb/ref 17592186054806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054511 :question/id #uuid "e4658959-f2fb-5bb4-ad05-d75b7c74a5d5" :question/math-academy-id "e-2372"} :knowledge-point/id #uuid "f41c2f3b-9b55-5f32-bb0a-a8397cdf66ce" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049429} {:db/id #edb/ref 17592186049884} {:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186055434} {:db/id #edb/ref 17592186055439} {:db/id #edb/ref 17592186426965} {:db/id #edb/ref 17592186426966} {:db/id #edb/ref 17592186426971} {:db/id #edb/ref 17592186426978}] :knowledge-point/title "Determining the X- or Y-Coordinate of a Point in the Coordinate Plane"} :step/id #uuid "708e4952-07a2-52aa-83ee-e86a33ffcc1d" :step/math-academy-id 607422 :step/next {:db/id #edb/ref 17592186055840}} {:db/id #edb/ref 17592186055840 :step/content {:db/id #edb/ref 17592186054807 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054598 :question/id #uuid "bda7aaff-f03f-53bd-b114-d28a46599641" :question/math-academy-id "e-975"} :knowledge-point/id #uuid "b509b42a-c38a-5400-8f93-f3e9024b16a2" :knowledge-point/questions [{:db/id #edb/ref 17592186055411} {:db/id #edb/ref 17592186055435} {:db/id #edb/ref 17592186235487} {:db/id #edb/ref 17592186426968} {:db/id #edb/ref 17592186426970} {:db/id #edb/ref 17592186426973} {:db/id #edb/ref 17592186426976} {:db/id #edb/ref 17592186426977} {:db/id #edb/ref 17592186486370} {:db/id #edb/ref 17592186486437}] :knowledge-point/title "Identifying the Coordinates of a Point"} :step/id #uuid "b4fa400d-ccbf-5b93-8bb2-f08b681dc5d0" :step/math-academy-id 607425 :step/next {:db/id #edb/ref 17592186055841}} {:db/id #edb/ref 17592186055841 :step/content {:db/id #edb/ref 17592186054808 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054597 :question/id #uuid "f610b8b9-8e9e-5a64-bc52-c1f939a0f147" :question/math-academy-id "e-974"} :knowledge-point/id #uuid "e5418e0e-fff7-5d08-b915-6e87be27a132" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049429} {:db/id #edb/ref 17592186049884} {:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186055120} {:db/id #edb/ref 17592186055436} {:db/id #edb/ref 17592186426969} {:db/id #edb/ref 17592186426972} {:db/id #edb/ref 17592186426979} {:db/id #edb/ref 17592186426980} {:db/id #edb/ref 17592186486380}] :knowledge-point/title "Plotting a Point in the Coordinate Plane"} :step/id #uuid "b5dc0ae8-3ca8-53a2-a100-962fd53b4781" :step/math-academy-id 607428 :step/next {:db/id #edb/ref 17592186055842}} {:db/id #edb/ref 17592186055842 :step/content {:db/id #edb/ref 17592186055958 :tutorial/content "The axes split the coordinate plane into four parts, called **quadrants**.\n\n![](images/93/938125e855fcb96f743c01f2a00d289ef13e0601772bab56cf0f255e9adf4dcd.png)\n\nGoing counter-clockwise, it's common to call\n\n- the top-right quadrant the first quadrant (I),\n\n- the top-left is the second quadrant (II),\n\n- the bottom-left is the third quadrant (III),\n\n- and and bottom-right is the fourth quadrant (IV).\n\nTo remember the order of the quadrants, it's helpful to think about writing the letter \"C\" in the graph:\n\n![](images/1e/1ef91f2bc25ea8b887ec449d2dafe2eaf6a157733e7bc50e4480280df8190728.png)" :tutorial/id #uuid "8a1e27dd-9f87-5adf-b0c6-f0f6cd7e2aac" :tutorial/math-academy-id 2097 :tutorial/title "Quadrants in the Coordinate Plane"} :step/id #uuid "3caa8c6c-0602-56f3-a037-3db5c98ff22b" :step/math-academy-id 607431 :step/next {:db/id #edb/ref 17592186055843}} {:db/id #edb/ref 17592186055843 :step/content {:db/id #edb/ref 17592186054809 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054599 :question/id #uuid "419738bb-56e5-52db-aa34-42ccd945fe64" :question/math-academy-id "e-977"} :knowledge-point/id #uuid "7fcec0d8-ca03-5446-a42f-65d0ccddd584" :knowledge-point/questions [{:db/id #edb/ref 17592186055278} {:db/id #edb/ref 17592186055437} {:db/id #edb/ref 17592186424815} {:db/id #edb/ref 17592186426967} {:db/id #edb/ref 17592186426974} {:db/id #edb/ref 17592186426975} {:db/id #edb/ref 17592186426981} {:db/id #edb/ref 17592186486375}] :knowledge-point/title "Identifying the Quadrant of a Given Point"} :step/id #uuid "e7a9127a-071f-5089-a135-f41568b6862d" :step/math-academy-id 607432}] :activity/title "The Cartesian Coordinate System" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054933}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186486467} :activity/id #uuid "2ee8e36f-d6f2-535a-b7e8-f2094eda05e2" :activity/scope {:db/id #edb/ref 17592186050517 :topic/id #uuid "50123c1c-7113-541e-8c4f-047f2eec416d" :topic/math-academy-id 92} :activity/steps [{:db/id #edb/ref 17592186486467 :step/content {:db/id #edb/ref 17592186486370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e2f253f-f36a-560f-9ec1-161de7ca2936" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-3,-6)" :db/id #edb/ref 17592186485790} {:answer/id #uuid "5b907c20-fdab-5148-9850-5b4dac59cbfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,6)" :db/id #edb/ref 17592186485926} {:answer/id #uuid "8ea93a26-50f7-53a6-b9a0-fc301c2fc49b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,-6)" :db/id #edb/ref 17592186486020} {:answer/id #uuid "bf3c4744-55c7-5126-a9e5-deeb937ce8ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,-6)" :db/id #edb/ref 17592186486108} {:answer/id #uuid "fc37df37-6bf2-589e-b9c3-27692a226298" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,-6)" :db/id #edb/ref 17592186486222}] :answer-field/correct {:db/id #edb/ref 17592186486222} :answer-field/id #uuid "6156ddb1-eb69-58fb-ade4-f35c95453cbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486277}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "33922fa7-9cd5-5240-b5a7-6b856c2f3900" :question/math-academy-id "q-12475" :question/problem "![](images/a3/a3e52270e83d29fe4d53f1429a6648c6ef2451ae5ad5b3d48dd0d1a0f3450df4.png)\n\nWhat are the $xy$-coordinates of the point shown in the axes above?" :question/worked-solution "To find the coordinates of the point, we inspect its position along the $x$ and $y$ axes.\n\nThe point is $3$ units to the right of the origin, in the positive direction of the $x$-axis. So, the point has an $x$-coordinate of $3.$\n\nAdditionally, the point is $6$ units *below* the origin, in the *negative* direction of the $y$-axis. So, the point has a $y$-coordinate of $-6.$\n\nThe point has an $x$-coordinate of $3$ and a $y$-coordinate of $-6,$ so its coordinates are $(3,-6).$"} :step/id #uuid "146a565d-dffc-5e6c-b79e-319aeeb7bc4d" :step/next {:db/id #edb/ref 17592186486486}} {:db/id #edb/ref 17592186486475 :step/content {:db/id #edb/ref 17592186486437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "649b626b-4386-5c00-bdcf-5dd4938d9112" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,1)" :db/id #edb/ref 17592186485937} {:answer/id #uuid "80ab4c5e-aff9-5dde-a021-093b6b9ddbd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,1)" :db/id #edb/ref 17592186485991} {:answer/id #uuid "a9b54552-5965-5854-ba07-c60932f774a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,4)" :db/id #edb/ref 17592186486071} {:answer/id #uuid "c5fcd194-a407-59cf-ae7a-2e21427fcdca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,4)" :db/id #edb/ref 17592186486120} {:answer/id #uuid "dfb98379-8815-506f-a548-b96dd7aea567" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,-4)" :db/id #edb/ref 17592186486174}] :answer-field/correct {:db/id #edb/ref 17592186486071} :answer-field/id #uuid "d0b079f8-570c-5a56-a881-00ac494144c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486321}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c5cd4da4-bcde-5c76-b987-99fb9414b223" :question/math-academy-id "q-93510" :question/problem "![](images/53/53e86e59af40ecd611ad1f7753f4780b692f17afc5a81709ea1c249a0bf011d5.png)\n\nWhat are the coordinates of the point $A?$" :question/worked-solution "To find the coordinates of the point $A,$ we start at the origin, move $1$ unit *left* and then $4$ units *up*. \n\n![](images/14/147aa8c644b24f82abadbbb9362ed51718bf94da992c83d016c72a1898032f0f.png)\n\nThe $x$-coordinate of $A$ is $-1,$ the $y$-coordinate is $4,$ and coordinates are given by the ordered pair $(-1,4).$"} :step/id #uuid "3f07956a-6431-5516-8d25-2cc6c4d55a33"} {:db/id #edb/ref 17592186486486 :step/content {:db/id #edb/ref 17592186486375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d8031f-5e2f-5683-84c6-7fe7232955e3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "All" :db/id #edb/ref 17592186485807} {:answer/id #uuid "19d86bf2-74f3-5d7b-a43c-1012785c8707" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186485812} {:answer/id #uuid "41bd2118-a5bb-5da1-8bdd-da8970f09208" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186485890} {:answer/id #uuid "79aeb305-a976-5e19-9df6-af6e17665886" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186485978} {:answer/id #uuid "7dae032f-a2cf-5841-bfb4-ef99e0c6b32f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186485985}] :answer-field/correct {:db/id #edb/ref 17592186485985} :answer-field/id #uuid "db8b3ac8-d583-5e07-b501-9df170f999c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486331}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3b6bba67-98a0-5af4-b6c0-e0b46329b1b5" :question/math-academy-id "q-61365" :question/problem "![](images/6c/6c55183a2999276882036eb3bc54a94f9d7356a58eb7b3d3e1ec7708def1de4f.png)\n\nWhich of the following is true regarding the point $C?$\n\nI. It is in the first quadrant\n\nII. Its $x$-coordinate is $3$\n\nIII. Its $y$-coordinate is $-2$" :question/worked-solution "The point $C$ is in the fourth quadrant, so statement I is false.\n\nTo find the coordinates of the point $C,$ we start at the origin, move $3$ units *right* and then $2$ units *down*. \n\n![](images/98/98c5cd8e245651f99a29c37b6d63122fa7766eed80c64ab6870e05192742dab1.png)\n\nThe coordinates of $C$ are $(3,-2).$ Hence, statements II and III are true."} :step/id #uuid "6a26e169-b937-5d4e-9132-efccf14ec7c7" :step/next {:db/id #edb/ref 17592186486514}} {:db/id #edb/ref 17592186486514 :step/content {:db/id #edb/ref 17592186486380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2379ed4e-1bad-561c-bd91-f529f4ce1c13" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e8/e8b3ac34b4fe6c877d606d8ddde5f29c9856cc4bdc5ac14e3ffcf5ddccdc0ebb.png" :db/id #edb/ref 17592186485825} {:answer/id #uuid "2a8a49a4-67ee-5dd6-8034-f08b8abe1465" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/79/794cbedc72a4ad51263737802b419bb024f250f67d3a6a8464f3c9b6d61aa194.png" :db/id #edb/ref 17592186485840} {:answer/id #uuid "3f7f4dc2-51a6-57b2-a348-9bb680d817c3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/5a/5a9caae32c4a20a6646689ceeb16622dbc1982d150988b8b393868e3dab3ac0f.png" :db/id #edb/ref 17592186485885} {:answer/id #uuid "a75b6401-ac5e-5996-87c4-190b7e47c998" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/14/146f5c3b0672a81347edb9d56cfe840ca6acc023444d110584649bf90d741ae6.png" :db/id #edb/ref 17592186486068} {:answer/id #uuid "f9270677-c75b-5726-992c-0684189ac5e6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4b/4ba1b8ea826f2d1a095982b03b58c4e75c711dbad168493a6a0d784064e06a74.png" :db/id #edb/ref 17592186486215}] :answer-field/correct {:db/id #edb/ref 17592186486215} :answer-field/id #uuid "3cc8f23d-893d-5af7-ae5b-7ea465b5f2d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486262}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a14d943-4b53-5214-a1e8-29e07a0ea11f" :question/math-academy-id "q-71670" :question/problem "Which of the following shows the point $A(-2,3)?$" :question/worked-solution "Starting at the origin, we move along the $x$ and $y$ axes to get to the point $A.$\n\nFirst, we move along the $x$-axis. The point $A$ has an $x$-coordinate of $-2,$ so we move $2$ units to the *left*, in the *negative* direction of the $x$-axis.\n\nThen, we move along the $y$-axis. The point $A$ has a $y$-coordinate of $3,$ so we move $3$ units *up*, in the *positive* direction of the $y$-axis.\n\n![](images/4b/4ba1b8ea826f2d1a095982b03b58c4e75c711dbad168493a6a0d784064e06a74.png)"} :step/id #uuid "dd35957b-3e1a-5f26-ae0e-89d442576bd2" :step/next {:db/id #edb/ref 17592186486475}}] :activity/title "The Cartesian Coordinate System" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186485752}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186143632} :activity/id #uuid "78db3c1b-5958-5d06-912e-feba2d0d67f3" :activity/scope {:db/id #edb/ref 17592186050599 :topic/id #uuid "576878c2-12a4-51b4-9889-1011d89192c4" :topic/math-academy-id 2360} :activity/steps [{:db/id #edb/ref 17592186143632 :step/content {:db/id #edb/ref 17592186144029 :tutorial/content "We can use models to multiply fractions by whole numbers. But can we do this without using models?\n\nAs it turns out, models give us vital clues on how this should be done!\n\nTo demonstrate, let's take a look at the fraction model for $\\dfrac 2 9 \\times 3\\mathbin{:}$\n\n![](images/47/4700c7ddbdc849a73d69ba41d2d716218f1fb181e8e5e9b8757392db6d9a6243.png)\n\nIn the answer, we end up with ${\\color{blue}{2}}\\times {\\color{red}{3}} = 6$ parts, and the denominator remains the same. This is always the case. \n\nTherefore, to multiply a fraction by a whole number, we follow the following steps:\n\n**Step 1**: We multiply the numerator by the whole number.\n\n**Step 2**: We keep the denominator the same.\n\nUsing these steps, we can figure out the answer without using models:\n\n$$\n\\dfrac{\\color{blue}2}{9}{\\color{red}\\,\\times 3\\,} = \\dfrac{{\\color{blue}{2}}{\\color{red}\\,\\times 3\\,}}{9} =  \\dfrac{6}{9}\n$$" :tutorial/id #uuid "e1ad38dc-1875-52f8-ad8b-fb013451e541" :tutorial/math-academy-id 8393 :tutorial/title "Introduction"} :step/id #uuid "ec9e5f6f-5761-5bfe-a807-c02ebc68c07b" :step/math-academy-id 130656 :step/next {:db/id #edb/ref 17592186143633}} {:db/id #edb/ref 17592186143633 :step/content {:db/id #edb/ref 17592186142772 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142510 :question/id #uuid "714ed22d-8268-502d-9d74-12620cb1c4fe" :question/math-academy-id "e-13393"} :knowledge-point/id #uuid "9c58126c-3d5b-5c2e-aaa4-7f9304e77935" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050244}] :knowledge-point/questions [{:db/id #edb/ref 17592186143193} {:db/id #edb/ref 17592186143287} {:db/id #edb/ref 17592186426009} {:db/id #edb/ref 17592186426010}] :knowledge-point/title "Multiplying a Fraction by a Whole Number"} :step/id #uuid "0650c7dd-3214-5c51-8afb-c59493c3db45" :step/math-academy-id 130657 :step/next {:db/id #edb/ref 17592186143634}} {:db/id #edb/ref 17592186143634 :step/content {:db/id #edb/ref 17592186142773 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142511 :question/id #uuid "499b112b-863b-568a-bd56-f32d66b619fc" :question/math-academy-id "e-13394"} :knowledge-point/id #uuid "e3c96e1c-a8cd-5d6d-b4ae-7497c4694407" :knowledge-point/questions [{:db/id #edb/ref 17592186143194} {:db/id #edb/ref 17592186143267} {:db/id #edb/ref 17592186426006} {:db/id #edb/ref 17592186426007}] :knowledge-point/title "Multiplying a Fraction by a Whole Number Resulting in a Whole Number"} :step/id #uuid "4e5e79ca-ec3a-5392-9974-2808857187dd" :step/math-academy-id 130661 :step/next {:db/id #edb/ref 17592186143635}} {:db/id #edb/ref 17592186143635 :step/content {:db/id #edb/ref 17592186142774 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142512 :question/id #uuid "da8475a1-d48e-5989-b1a9-a7c72a205fd2" :question/math-academy-id "e-13395"} :knowledge-point/id #uuid "d3bbd0c1-1e52-5f95-b5b1-7270f49e5f5d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050078}] :knowledge-point/questions [{:db/id #edb/ref 17592186143195} {:db/id #edb/ref 17592186143268} {:db/id #edb/ref 17592186426011}] :knowledge-point/title "Multiplying a Fraction by a Whole Number With Simplification"} :step/id #uuid "21db46b2-cb05-59f7-946c-993b805b99a2" :step/math-academy-id 130665 :step/next {:db/id #edb/ref 17592186143636}} {:db/id #edb/ref 17592186143636 :step/content {:db/id #edb/ref 17592186142775 :knowledge-point/canonical-example {:db/id #edb/ref 17592186142513 :question/id #uuid "494ad564-7a01-533e-887a-6c83a2fb4e78" :question/math-academy-id "e-13396"} :knowledge-point/id #uuid "91037b32-189a-5ba9-ab0a-117f6255c496" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050249}] :knowledge-point/questions [{:db/id #edb/ref 17592186143196} {:db/id #edb/ref 17592186143197} {:db/id #edb/ref 17592186424808} {:db/id #edb/ref 17592186424831} {:db/id #edb/ref 17592186426008}] :knowledge-point/title "Multiplying a Fraction by a Whole Number Resulting in a Mixed Number"} :step/id #uuid "130fe104-c8f0-562f-9d3d-edb7b1985250" :step/math-academy-id 130669}] :activity/title "Multiplying Fractions by Whole Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186142997}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055825} :activity/id #uuid "604975a3-93f4-5972-a157-950937a51eea" :activity/scope {:db/id #edb/ref 17592186050618 :topic/id #uuid "598e4586-378e-5300-9abe-bbb9ded2ad77" :topic/math-academy-id 63} :activity/steps [{:db/id #edb/ref 17592186055825 :step/content {:db/id #edb/ref 17592186056032 :tutorial/content "A **variable** is any letter or symbol that can be replaced by a number. For example, the letters\n\n$$\nx, \\quad y, \\quad z, \\quad a, \\quad b, \\quad c, \\quad k, \\quad m,\\quad n,\\quad p, \\quad q,\\quad r, \\quad \\ldots\n$$\n\nare commonly used as variables. But in general, we can use any letter we like.\n\nAn **algebraic expression** is a combination of variables with mathematical operations, like addition $(+)$, subtraction $(-)$, multiplication $(\\times)$, and division $(\\div).$ So \n\n$$\nx+2,\\qquad 6-y,\\qquad 2\\times p + 1,\\qquad q\\div r,\n$$\n\nare all examples of algebraic expressions." :tutorial/id #uuid "232cd5fe-049f-512d-8d7c-ad600a7e6a81" :tutorial/math-academy-id 8165 :tutorial/title "Introduction"} :step/id #uuid "56c96a42-70b1-5c3d-baeb-d0e31a2f412b" :step/math-academy-id 53778 :step/next {:db/id #edb/ref 17592186055826}} {:db/id #edb/ref 17592186055826 :step/content {:db/id #edb/ref 17592186054799 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054421 :question/id #uuid "61ebe3c8-1241-59f1-9d60-704d520c53fb" :question/math-academy-id "e-13055"} :knowledge-point/id #uuid "ef650886-8d46-583e-bad0-1429ba496479" :knowledge-point/questions [{:db/id #edb/ref 17592186055373} {:db/id #edb/ref 17592186055390} {:db/id #edb/ref 17592186424970} {:db/id #edb/ref 17592186424974} {:db/id #edb/ref 17592186424978} {:db/id #edb/ref 17592186424982}] :knowledge-point/title "Identifying Variables"} :step/id #uuid "31658058-879c-5f54-87bd-336129b73d45" :step/math-academy-id 53779 :step/next {:db/id #edb/ref 17592186055827}} {:db/id #edb/ref 17592186055827 :step/content {:db/id #edb/ref 17592186054800 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054422 :question/id #uuid "ee12fc6a-91b2-5855-96a8-c28bd6652ae5" :question/math-academy-id "e-13056"} :knowledge-point/id #uuid "ae662093-c3e8-5577-af6e-7e2f383da79d" :knowledge-point/questions [{:db/id #edb/ref 17592186055105} {:db/id #edb/ref 17592186055391} {:db/id #edb/ref 17592186424971} {:db/id #edb/ref 17592186424972} {:db/id #edb/ref 17592186424976} {:db/id #edb/ref 17592186424979} {:db/id #edb/ref 17592186424981}] :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Addition"} :step/id #uuid "0db792bd-948d-59a9-bc0b-02a8fbacf35a" :step/math-academy-id 53782 :step/next {:db/id #edb/ref 17592186055828}} {:db/id #edb/ref 17592186055828 :step/content {:db/id #edb/ref 17592186054801 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054423 :question/id #uuid "ebd7ac34-c0e4-5e42-940a-cce33864a7de" :question/math-academy-id "e-13057"} :knowledge-point/id #uuid "8fc32821-14d0-5cbe-b8d9-4e7ff5cc937b" :knowledge-point/questions [{:db/id #edb/ref 17592186055280} {:db/id #edb/ref 17592186055392} {:db/id #edb/ref 17592186424817} {:db/id #edb/ref 17592186424973} {:db/id #edb/ref 17592186424975} {:db/id #edb/ref 17592186424977} {:db/id #edb/ref 17592186424980}] :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Subtraction"} :step/id #uuid "efce8a57-ebe0-5019-8c9d-0c9aa1ff8814" :step/math-academy-id 53786}] :activity/title "Introduction to Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054915}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074610} :activity/id #uuid "d1e56cd5-fc3b-5ec2-ae90-20ca4a2e732f" :activity/scope {:db/id #edb/ref 17592186050665 :topic/id #uuid "5d634c2c-a4e7-591a-891e-89c65f30d787" :topic/math-academy-id 529} :activity/steps [{:db/id #edb/ref 17592186074610 :step/content {:db/id #edb/ref 17592186075043 :tutorial/content "Remember that a **unit fraction** is a fraction containing $1$ in the numerator. \n\nFor example, the following fractions are unit fractions since they each contain ${\\color{blue}{1}}$ in the numerator:\n\n$$\n\\dfrac{\\color{blue}{1}}{2}, \\qquad \\dfrac{\\color{blue}{1}}{5}, \\qquad \\dfrac{\\color{blue}{1}}{8}\n$$\n\nHowever, the following fractions are *not* unit fractions since they do *not* contain ${\\color{blue}{1}}$ in the numerator:\n\n$$\n\\dfrac{\\color{red}{2}}{3}, \\qquad \\dfrac{\\color{red}{5}}{8}, \\qquad \\dfrac{\\color{red}{7}}{12}\n$$\n\nIn this lesson, we will use models to divide whole numbers by unit fractions. \n\nLet's start with an example. Suppose we divide the pizza below into fifths. How many fifths will there be in total?\n\n![](images/4a/4a73488a784067fbe0a4281ef8de45209e284bcd8675f5476c14a8bdcb357712.png)\n\n \n\nSince each part is $\\dfrac{1}{\\color{blue}5}$ of a whole, we need to split $\\color{red}1$ pizza (whole) into $\\color{blue}5$ equal parts, as shown below.\n\n![](images/9e/9e36c7b607bd6ada0018e574d52c060851837b62025429b6cfb94f98ed378ccd.png)\n\n \n\nSo, we get ${\\color{red}1} \\times {\\color{blue}5} = 5$ parts in total." :tutorial/id #uuid "577d7682-3ed8-5103-8641-0c02702a9e08" :tutorial/math-academy-id 8557 :tutorial/title "Introduction"} :step/id #uuid "26245a65-ebc8-5e42-9300-6d874c79a4ec" :step/math-academy-id 172318 :step/next {:db/id #edb/ref 17592186074611}} {:db/id #edb/ref 17592186074611 :step/content {:db/id #edb/ref 17592186073720 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073461 :question/id #uuid "4f8f2348-c6ec-5073-9f95-6697173654a7" :question/math-academy-id "e-13690"} :knowledge-point/id #uuid "b2b57f76-8fab-5b44-80ee-d905e5f9a14f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049517}] :knowledge-point/questions [{:db/id #edb/ref 17592186074042} {:db/id #edb/ref 17592186074365} {:db/id #edb/ref 17592186074521} {:db/id #edb/ref 17592186425718} {:db/id #edb/ref 17592186425719}] :knowledge-point/title "Determining How Many Parts Fit Into a Whole"} :step/id #uuid "3c05bf1b-ab93-581a-9e20-32a418b2cda1" :step/math-academy-id 172319 :step/next {:db/id #edb/ref 17592186074612}} {:db/id #edb/ref 17592186074612 :step/content {:db/id #edb/ref 17592186075044 :tutorial/content "The model below represents $2$ wholes. Let's use it to calculate the value of $2 \\div \\dfrac{1}{5}.$\n\n![](images/bc/bceafee7d9ca5e92e69b5d33d9504f4290526b80059ad62ed26229d02712a278.png)\n\n \n\nTo calculate ${\\color{red}2} \\div \\dfrac{1}{\\color{blue}5}$, we need to divide each of $\\color{red}2$ wholes into $\\color{blue}5$ equal parts, as shown below.\n\n![](images/cf/cf608ce8f5d8e2a47a4bebe21f198d193b10dd8f6e95436986bc954c89c60d19.png)\n\n \n\nWe get ${\\color{red}2} \\times {\\color{blue}5} = 10$ pieces in total. \n\nTherefore,\n\n$$\n2 \\div \\dfrac{1}{5} = 10\\,.\n$$" :tutorial/id #uuid "2de869cb-775d-5db4-b90d-7df0de218fc0" :tutorial/math-academy-id 8561 :tutorial/title "Dividing Whole Numbers by Unit Fractions"} :step/id #uuid "480191b5-d5a1-50b4-8e0c-c36a3b10da79" :step/math-academy-id 172323 :step/next {:db/id #edb/ref 17592186074613}} {:db/id #edb/ref 17592186074613 :step/content {:db/id #edb/ref 17592186073721 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073462 :question/id #uuid "2f739b94-f494-546b-8623-bd17a525a436" :question/math-academy-id "e-13695"} :knowledge-point/id #uuid "ed8053e5-f273-56f2-bfb6-294f936d9701" :knowledge-point/questions [{:db/id #edb/ref 17592186074367} {:db/id #edb/ref 17592186074386} {:db/id #edb/ref 17592186425721}] :knowledge-point/title "Identifying a Model Representing a Division Problem"} :step/id #uuid "242be67e-027e-54a4-9866-c63cb081faa9" :step/math-academy-id 172324 :step/next {:db/id #edb/ref 17592186074614}} {:db/id #edb/ref 17592186074614 :step/content {:db/id #edb/ref 17592186073722 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073467 :question/id #uuid "dd5b4bc8-110c-5247-b5e6-ee4ce7636a1b" :question/math-academy-id "e-13707"} :knowledge-point/id #uuid "2e33ab8e-736b-5972-af0d-f7eeabda1148" :knowledge-point/questions [{:db/id #edb/ref 17592186074043} {:db/id #edb/ref 17592186074366} {:db/id #edb/ref 17592186425715} {:db/id #edb/ref 17592186425716}] :knowledge-point/title "Identifying the Division Problem Represented by a Model"} :step/id #uuid "7721ecc8-af47-5723-b955-d68c3dc4eecb" :step/math-academy-id 172327 :step/next {:db/id #edb/ref 17592186074615}} {:db/id #edb/ref 17592186074615 :step/content {:db/id #edb/ref 17592186073723 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073468 :question/id #uuid "06e730e3-2df3-5d28-afd1-72c34d11cf8e" :question/math-academy-id "e-13709"} :knowledge-point/id #uuid "79e310e4-b8a2-5327-b4e6-fd71b6783e3a" :knowledge-point/questions [{:db/id #edb/ref 17592186074074} {:db/id #edb/ref 17592186074387} {:db/id #edb/ref 17592186424809} {:db/id #edb/ref 17592186425717} {:db/id #edb/ref 17592186425720}] :knowledge-point/title "Dividing Whole Numbers by Unit Fractions"} :step/id #uuid "b662cd66-040d-56ae-be80-ddf72c03e975" :step/math-academy-id 172330}] :activity/title "Dividing Whole Numbers by Unit Fractions Using Models" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073949}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074553} :activity/id #uuid "e5d4d32a-c5b1-5bb9-a109-158be8e0c828" :activity/scope {:db/id #edb/ref 17592186050954 :topic/id #uuid "75482856-dc6f-5409-9718-62a9c17846a8" :topic/math-academy-id 565} :activity/steps [{:db/id #edb/ref 17592186074553 :step/content {:db/id #edb/ref 17592186075055 :tutorial/content "We can use fraction models to understand how to multiply fractions.\n\nFor example, let's suppose that we wish to compute the following product of fractions:\n\n$$\n\\dfrac{2}{3} \\times \\dfrac{1}{2}\n$$\n\nLet's start by representing $\\dfrac23$ using a square fraction model, like the one below. Notice that we have split the fraction *vertically*.\n\n![](images/dc/dc72f1bc6250e2ca39cf424847d3e592858d8cd6765cade9d357a139bbd906b0.png)\n\nSince we need to multiply the above fraction by $\\dfrac{1}{\\color{blue}2}$, we split the whole into $\\color{blue}2$ equal parts *horizontally*. This way, each of the original pieces is split in half. Then, we only keep the shaded pieces in the bottom row.\n\n![](images/41/41d47349763b17ed06777b732997ab4f229088b38252c398854a92a1d62ccb6a.png)\n\nFrom the picture on the right, we see that the shaded part represents $\\dfrac{2}{6}$ of the whole.\n\nTherefore,\n\n$$\n\\dfrac{2}{3} \\times \\dfrac{1}{2} = \\dfrac{2}{6}.\n$$\n\nNotice that we can simplify this answer further by dividing the numerator and denominator by $2.$ However, in this lesson, we'll focus just on multiplication and not worry about simplifying the final answers." :tutorial/id #uuid "7d4c2f3b-ffc4-5837-b2b2-961166892aef" :tutorial/math-academy-id 8959 :tutorial/title "Introduction"} :step/id #uuid "1a9dc867-e32f-56af-8da8-b49a7c78e295" :step/math-academy-id 111265 :step/next {:db/id #edb/ref 17592186074554}} {:db/id #edb/ref 17592186074554 :step/content {:db/id #edb/ref 17592186073684 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073495 :question/id #uuid "f26ed088-6f0b-56b8-9027-9b9af4bcf415" :question/math-academy-id "e-14484"} :knowledge-point/id #uuid "6ffe13c6-a2b6-5d70-8ebe-d152ae4db35f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049804}] :knowledge-point/questions [{:db/id #edb/ref 17592186074423} {:db/id #edb/ref 17592186074520} {:db/id #edb/ref 17592186425828} {:db/id #edb/ref 17592186425830}] :knowledge-point/title "Identifying a Multiplication Problem Corresponding to a Model"} :step/id #uuid "6a6025d9-8b62-55fc-9986-d44a56cc355f" :step/math-academy-id 111266 :step/next {:db/id #edb/ref 17592186074555}} {:db/id #edb/ref 17592186074555 :step/content {:db/id #edb/ref 17592186073685 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073498 :question/id #uuid "a653f45f-e638-5646-a55c-13b319e511b0" :question/math-academy-id "e-14490"} :knowledge-point/id #uuid "3f3ddce4-2cf8-5bf6-86d3-8c304ee6c241" :knowledge-point/questions [{:db/id #edb/ref 17592186074421} {:db/id #edb/ref 17592186074422} {:db/id #edb/ref 17592186425827} {:db/id #edb/ref 17592186425832}] :knowledge-point/title "Identifying a Missing Number in a Model"} :step/id #uuid "81f70a32-6a53-5fdb-9bfe-968569e95d68" :step/math-academy-id 111269 :step/next {:db/id #edb/ref 17592186074556}} {:db/id #edb/ref 17592186074556 :step/content {:db/id #edb/ref 17592186073686 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073499 :question/id #uuid "9bc02e5b-5028-5aa1-85d8-c1217b425c36" :question/math-academy-id "e-14491"} :knowledge-point/id #uuid "0bd1c12d-acb6-5961-a248-47f172fe5bef" :knowledge-point/questions [{:db/id #edb/ref 17592186074394} {:db/id #edb/ref 17592186074395} {:db/id #edb/ref 17592186425831} {:db/id #edb/ref 17592186425833}] :knowledge-point/title "Identifying a Model Corresponding to a Multiplication Problem"} :step/id #uuid "cbcedc93-87eb-515c-aaed-d451e57961fa" :step/math-academy-id 111272 :step/next {:db/id #edb/ref 17592186074557}} {:db/id #edb/ref 17592186074557 :step/content {:db/id #edb/ref 17592186073687 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073500 :question/id #uuid "4730b433-9614-58ea-a452-e404c237ba3b" :question/math-academy-id "e-14492"} :knowledge-point/id #uuid "16e2265e-5c75-538f-91a1-9120d2f77c9e" :knowledge-point/questions [{:db/id #edb/ref 17592186074393} {:db/id #edb/ref 17592186074420} {:db/id #edb/ref 17592186425829}] :knowledge-point/title "Multiplying a Fraction by a Unit Fraction Using a Model"} :step/id #uuid "1fd007c8-be54-595a-bb9b-500f99e68515" :step/math-academy-id 111275}] :activity/title "Multiplying Fractions by Unit Fractions Using Models" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073983}]}
