o><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mo>∘</mo></mrow></msup><mo>+</mo><mo stretchy=\"false\">(</mo><mn>51.340</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>1</mn><mo>…</mo><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mo>∘</mo></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>101.548</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>2</mn><mo>…</mo><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mo>∘</mo></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><msup><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>101.5</mn></mpadded></mstyle><mrow data-mjx-texclass=\"ORD\"><mo>∘</mo></mrow></msup></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>rounded to one decimal place.</p>\n</div></div>",
