"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><munder><mo data-mjx-texclass=\"OP\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi></mrow></munder><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>9</mn><msup><mi>x</mi><mn>3</mn></msup><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mi>x</mi></mrow><mrow><mn>5</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>9</mn><msup><mi>x</mi><mn>3</mn></msup></mrow><msup><mi>x</mi><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>x</mi><mn>2</mn></msup><msup><mi>x</mi><mn>2</mn></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>x</mi><msup><mi>x</mi><mn>2</mn></msup></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>5</mn><msup><mi>x</mi><mn>2</mn></msup></mrow><msup><mi>x</mi><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>9</mn><mi>x</mi><mo>+</mo><mn>1</mn><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mi>x</mi></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>5</mn><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>9</mn><mi>x</mi><mo>+</mo><mn>1</mn><mo>−</mo><mn>0</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>5</mn><mo>+</mo><mn>0</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>5</mn></mfrac></mstyle><munder><mo data-mjx-texclass=\"OP\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi></mrow></munder><mo stretchy=\"false\">(</mo><mn>9</mn><mi>x</mi><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi mathvariant=\"normal\">∞</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n<p>The limit does not come out to a finite number. Therefore, there is no horizontal asymptote.</p>\n</div></div>",
