-field/choices ["answer-955a14ee-2d66-50bc-8de3-377077da9e48"] :db/ensure [:answer-field/validate]} {:db/id "answer-955a14ee-2d66-50bc-8de3-377077da9e48" :answer/id #uuid "955a14ee-2d66-50bc-8de3-377077da9e48" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]}]
