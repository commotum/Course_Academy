#{[{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186418090} :activity/id #uuid "b4f97133-82cd-5750-be9b-b95616155e6b" :activity/scope {:db/id #edb/ref 17592186050004 :topic/id #uuid "25876b80-efb1-53ed-9327-08d34c32cc9a" :topic/math-academy-id 1903} :activity/steps [{:db/id #edb/ref 17592186418087 :step/content {:db/id #edb/ref 17592186413323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0051830d-55e5-5121-b11a-0d87da7f40fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-3" :db/id #edb/ref 17592186413301} {:answer/id #uuid "0e733fa1-bbd0-5f83-a1a9-64ce04aed72b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=1" :db/id #edb/ref 17592186413302} {:answer/id #uuid "a7b385fb-ca34-55cc-a656-aaa065330917" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=2" :db/id #edb/ref 17592186413311} {:answer/id #uuid "cad17541-13af-57a0-9141-29e20640a0ce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186413313} {:answer/id #uuid "db92d19b-e030-57a9-b3fd-2d1169f5e7a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-1" :db/id #edb/ref 17592186413315}] :answer-field/correct {:db/id #edb/ref 17592186413313} :answer-field/id #uuid "36e0c9a9-15c6-51ff-ac4a-304c0aa988be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413317}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e2d47372-f9cb-5c02-86fd-148b7f1d18b1" :question/math-academy-id "q-101320" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{{x}^{4}+1}{{x}^{3}-1}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{{x}^{4}+1}{{x}^{3}-1} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{{x}^{4}}{{x}^{3}}+\\frac{1}{{x}^{3}})}{(\\frac{{x}^{3}}{{x}^{3}}-\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(x+\\frac{1}{{x}^{3}})}{(1-\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(x+0)}{(1-0)} \\\\  & ={lim}_{x\\to \\infty }x \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."} :step/id #uuid "37331294-019e-50e4-a478-f8952797d0e6" :step/next {:db/id #edb/ref 17592186418088}} {:db/id #edb/ref 17592186418088 :step/content {:db/id #edb/ref 17592186413321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20243682-29c5-5259-864f-3c811fbe7f7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{5}" :db/id #edb/ref 17592186413304} {:answer/id #uuid "4f14c146-ddb9-57bd-ad6f-3930420ac403" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{9}{5}" :db/id #edb/ref 17592186413306} {:answer/id #uuid "95bed720-0647-52ed-9834-06d42bf8de74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186413310} {:answer/id #uuid "b4ee551d-2ce2-5847-a076-aa2475baa979" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186413312} {:answer/id #uuid "f405f918-ce19-52f9-9c3d-f68c97ea5cd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{3}" :db/id #edb/ref 17592186413316}] :answer-field/correct {:db/id #edb/ref 17592186413312} :answer-field/id #uuid "e22bffa8-51cb-5c7c-a8dc-24d845160961" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413319}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "88ec9ee8-0b06-53f7-bc3c-92317b5059e7" :question/math-academy-id "q-101322" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{9{x}^{3}+{x}^{2}-x}{5{x}^{2}+3}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{9{x}^{3}+{x}^{2}-x}{5{x}^{2}+3} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{9{x}^{3}}{{x}^{2}}+\\frac{{x}^{2}}{{x}^{2}}-\\frac{x}{{x}^{2}})}{(\\frac{5{x}^{2}}{{x}^{2}}+\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(9x+1-\\frac{1}{x})}{(5+\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(9x+1-0)}{(5+0)} \\\\  & =\\frac{1}{5}{lim}_{x\\to \\infty }(9x+1) \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."} :step/id #uuid "401b3af7-fa57-5cc4-9500-1387b9727f71" :step/next {:db/id #edb/ref 17592186418089}} {:db/id #edb/ref 17592186418089 :step/content {:db/id #edb/ref 17592186413322 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "955a14ee-2d66-50bc-8de3-377077da9e48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\infty" :db/id #edb/ref 17592186413309}] :answer-field/correct {:db/id #edb/ref 17592186413309} :answer-field/id #uuid "e59f45ed-d037-5bd6-940e-13f41f6c836c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186413320}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d8cdb7dd-976e-5b44-901a-f1aa1b8415b7" :question/math-academy-id "q-339615" :question/problem "Evaluate the limit:\n\n${lim}_{x\\to \\infty }\\,\\,\\frac{-{x}^{7}+3}{{x}^{4}+6x+2}=$\n\n{{field-1}}" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{4}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\,\\,\\frac{-{x}^{7}+3}{{x}^{4}+6x+2} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{-{x}^{7}}{{x}^{4}}+\\frac{3}{{x}^{4}})}{(\\frac{{x}^{4}}{{x}^{4}}+\\frac{6x}{{x}^{4}}+\\frac{2}{{x}^{4}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(-{x}^{3}+\\frac{3}{{x}^{4}})}{(1+\\frac{6}{{x}^{3}}+\\frac{2}{{x}^{4}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\text{ }\\frac{-{x}^{3}+0}{1+0+0} \\\\  & ={lim}_{x\\to \\infty }\\,\\,-{x}^{3} \\\\  & =-\\infty .\\end{aligned}\n$$"} :step/id #uuid "75cf104c-743b-5715-8fba-baa298a50d9a"} {:db/id #edb/ref 17592186418090 :step/content {:db/id #edb/ref 17592186124919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18f73f57-316e-5fb3-bc4a-e767aaf24db8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{2}{3}" :db/id #edb/ref 17592186413303} {:answer/id #uuid "30464325-d158-5e08-93a8-e607ad63b4a6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186413305} {:answer/id #uuid "521202c4-e823-5b6e-92ea-799e96ebcde5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{5}" :db/id #edb/ref 17592186413307} {:answer/id #uuid "9123a10f-7315-5079-b272-8ae329eb3b75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{3}" :db/id #edb/ref 17592186413308} {:answer/id #uuid "cf5c50b9-a9ea-50a2-a08b-b1461f5b7bb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{2}" :db/id #edb/ref 17592186413314}] :answer-field/correct {:db/id #edb/ref 17592186413307} :answer-field/id #uuid "381810c0-51a5-5b82-b7b6-6ce8ed23d924" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413318}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a9648fae-8c3b-5e03-83c5-38b5774f94d2" :question/math-academy-id "q-35828" :question/problem "What is the horizontal asymptote of $y=f(x)$ with $f(x)=\\frac{3x+4}{6-15x}?$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{3x+4}{6-15x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{3x}{x}+\\frac{4}{x})}{(\\frac{6}{x}-\\frac{15x}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(3+\\frac{4}{x})}{(\\frac{6}{x}-15)} \\\\  & =\\frac{3+0}{0-15} \\\\  & =-\\frac{1}{5}.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote is $y=-\\frac{1}{5}.$"} :step/id #uuid "812c3262-08eb-552d-a220-5cf16c367fb2" :step/next {:db/id #edb/ref 17592186418091}} {:db/id #edb/ref 17592186418091 :step/content {:db/id #edb/ref 17592186335944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0948bf66-b9eb-50e0-aa36-a645d1dd4d71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186333074} {:answer/id #uuid "7f2618e2-1548-5494-9496-e1c7e62150fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186334121} {:answer/id #uuid "89c810fb-1fda-543b-a4ab-03e4899ffff7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\infty " :db/id #edb/ref 17592186334214} {:answer/id #uuid "c6d2b174-a819-5c3c-8807-a772dccc544a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Does not exist." :db/id #edb/ref 17592186334717} {:answer/id #uuid "f53a2a74-5ee8-5629-9c0f-607f722db1d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty " :db/id #edb/ref 17592186335140}] :answer-field/correct {:db/id #edb/ref 17592186335140} :answer-field/id #uuid "315d67e3-a8ca-5508-a7b2-478fa5b39f63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186335337}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "66754a6b-36e3-52c9-b059-874445c5d773" :question/math-academy-id "q-68043" :question/problem "Calculate ${lim}_{x\\to \\infty }\\,\\,\\frac{{x}^{3}+x}{2{x}^{2}+x+4}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\,\\,\\frac{{x}^{3}+x}{2{x}^{2}+x+4} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{{x}^{3}}{{x}^{2}}+\\frac{x}{{x}^{2}})}{(\\frac{2{x}^{2}}{{x}^{2}}+\\frac{x}{{x}^{2}}+\\frac{4}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(x+\\frac{1}{x})}{(2+\\frac{1}{x}+\\frac{4}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(x+0)}{(2+0+0)} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{x}{2} \\\\  & =\\infty .\\end{aligned}\n$$"} :step/id #uuid "de317f7b-de97-5d26-ad49-2e3610a019e8" :step/next {:db/id #edb/ref 17592186418087}}] :activity/title "Limits at Infinity and Horizontal Asymptotes of Rational Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186418086}]}
