6124703 #edb/ref 1049 #edb/ref 17592186050004 #edb/ref 17592186045417] [17592186124703 #edb/ref 1053 #uuid "55d83791-4999-5136-909d-35e46a8ed919" #edb/ref 17592186045417] [17592186124919 #edb/ref 1068 #edb/ref 17592186122114 #edb/ref 17592186045417] [17592186124919 #edb/ref 1069 "q-35828" #edb/ref 17592186045417] [17592186124919 #edb/ref 1071 "What is the horizontal asymptote of $y = f(x)$ with $f(x) = \\frac{3x + 4}{6 - 15x}$?" #edb/ref 17592186045417] [17592186124919 #edb/ref 1072 #uuid "a9648fae-8c3b-5e03-83c5-38b5774f94d2" #edb/ref 17592186045417] [17592186125668 #edb/ref 1058 #edb/ref 17592186125669 #edb/ref 17592186045417] [17592186125668 #edb/ref 1061 471 #edb/ref 17592186045417] [17592186125668 #edb/ref 1062 #uuid "6cb8d91a-6de6-5bd6-878e-78ec12b7fedf" #edb/ref 17592186045417] [17592186125668 #edb/ref 1063 #edb/ref 17592186125743 #edb/ref 17592186045417] [17592186125669 #edb/ref 1058 #edb/ref 17592186125670 #edb/ref 17592186045417] [17592186125669 #edb/ref 1061 472 #edb/ref 17592186045417] [17592186125669 #edb/ref 1062 #uuid "eb8b99ee-a21a-5d00-8571-260574714375" #edb/ref 17592186045417] [17592186125669 #edb/ref 1063 #edb/ref 17592186124661 #edb/ref 17592186045417] [17592186125670 #edb/ref 1058 #edb/ref 17592186125671 #edb/ref 17592186045417] [17592186125670 #edb/ref 1061 475 #edb/ref 17592186045417] [17592186125670 #edb/ref 1062 #uuid "98d0d8f6-bd8d-5c4f-811f-469eaac31888" #edb/ref 17592186045417] [17592186125670 #edb/ref 1063 #edb/ref 17592186124662 #edb/ref 17592186045417] [17592186125671 #edb/ref 1058 #edb/ref 17592186125672 #edb/ref 17592186045417] [17592186125671 #edb/ref 1061 477 #edb/ref 17592186045417] [17592186125671 #edb/ref 1062 #uuid "22bf77c7-a859-5972-9d3a-30c0590708ed" #edb/ref 17592186045417] [17592186125671 #edb/ref 1063 #edb/ref 17592186125748 #edb/ref 17592186045417] [17592186125672 #edb/ref 1058 #edb/ref 17592186125673 #edb/ref 17592186045417] [17592186125672 #edb/ref 1061 478 #edb/ref 17592186045417] [17592186125672 #edb/ref 1062 #uuid "f59b9e85-79cc-5fcd-b7a2-da25e2aeac81" #edb/ref 17592186045417] [17592186125672 #edb/ref 1063 #edb/ref 17592186124663 #edb/ref 17592186045417] [17592186125673 #edb/ref 1061 480 #edb/ref 17592186045417] [17592186125673 #edb/ref 1062 #uuid "f3b88a81-a304-57e3-a798-5432c418d285" #edb/ref 17592186045417] [17592186125673 #edb/ref 1063 #edb/ref 17592186124664 #edb/ref 17592186045417] [17592186125743 #edb/ref 1064 "To calculate the limit at infinity of a rational function, such as\n\n$$\n\\lim_\\limits{x\\rightarrow \\infty}\\left(\\dfrac{x^4}{x^5-x^2}\\right),\n$$\n\n we apply the following procedure:\n\n**Step 1:** Divide both the numerator and the denominator by the highest power of $x$ in the *denominator*.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(\\frac{{x}^{4}}{{x}^{5}-{x}^{2}}) & ={lim}_{x\\to \\infty }(\\frac{{x}^{4}÷{x}^{5}}{({x}^{5}-{x}^{2})÷{x}^{5}}) \\\\  & ={lim}_{x\\to \\infty }(\\frac{\\frac{{x}^{4}}{{x}^{5}}}{\\frac{{x}^{5}}{{x}^{5}}-\\frac{{x}^{2}}{{x}^{5}}}) \\\\  & ={lim}_{x\\to \\infty }(\\frac{\\frac{1}{x}}{1-\\frac{1}{{x}^{3}}})\\end{aligned}\n$$\n\n**Step 2:** Apply the rule that if $n$ is any positive integer then $\\displaystyle \\lim_\\limits{x\\rightarrow \\infty}\\left(\\dfrac{1}{x^n}\\right)=0.$ Evaluate the remaining expression to obtain the answer.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(\\frac{{x}^{4}}{{x}^{5}-{x}^{2}}) & ={lim}_{x\\to \\infty }(\\frac{\\frac{1}{x}}{1-\\frac{1}{{x}^{3}}}) \\\\  & =\\frac{0}{1-0} \\\\  & =\\frac{0}{1} \\\\  & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186125743 #edb/ref 1065 258 #edb/ref 17592186045417] [17592186125743 #edb/ref 1066 #uuid "ed558480-81a6-5baf-ab3a-f19468f77d72" #edb/ref 17592186045417] [17592186125743 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186125748 #edb/ref 1064 "The horizontal asymptotes of a rational function $y=f(x)$ coincide with the infinite limits of $f(x).$\n\nFor example, we can use the same procedure as before to find the horizontal asymptote of $y=f(x) = \\dfrac{x+1}{x^2+2}.$ As a result, we get \n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{x+1}{{x}^{2}+2} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{x}{{x}^{2}}+\\frac{1}{{x}^{2}})}{(\\frac{{x}^{2}}{{x}^{2}}+\\frac{2}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{1}{x}+\\frac{1}{{x}^{2}})}{(1+\\frac{2}{{x}^{2}})} \\\\  & =\\frac{0+0}{1+0} \\\\  & =0.\\end{aligned}\n$$\n\nSo the horizontal asymptote of the graph $y=f(x)$ is $y=0$, as shown below.\n\n![](images/27/27c77f2d6a06bad338982d000f916811201c45e9b16713caf40cc4d5bcf911bd.png)" #edb/ref 17592186045417] [17592186125748 #edb/ref 1065 261 #edb/ref 17592186045417] [17592186125748 #edb/ref 1066 #uuid "298d636c-df6c-580c-adce-c09a77dec64a" #edb/ref 17592186045417] [17592186125748 #edb/ref 1067 "Horizontal Asymptotes of Rational Functions" #edb/ref 17592186045417] [17592186333074 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186333074 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186333074 #edb/ref 1083 #uuid "0948bf66-b9eb-50e0-aa36-a645d1dd4d71" #edb/ref 17592186045417] [17592186334121 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186334121 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186334121 #edb/ref 1083 #uuid "7f2618e2-1548-5494-9496-e1c7e62150fc" #edb/ref 17592186045417] [17592186334214 #edb/ref 1080 "-\\infty " #edb/ref 17592186045417] [17592186334214 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186334214 #edb/ref 1083 #uuid "89c810fb-1fda-543b-a4ab-03e4899ffff7" #edb/ref 17592186045417] [17592186334717 #edb/ref 1080 "Does not exist." #edb/ref 17592186045417] [17592186334717 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186334717 #edb/ref 1083 #uuid "c6d2b174-a819-5c3c-8807-a772dccc544a" #edb/ref 17592186045417] [17592186335140 #edb/ref 1080 "\\infty " #edb/ref 17592186045417] [17592186335140 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186335140 #edb/ref 1083 #uuid "f53a2a74-5ee8-5629-9c0f-607f722db1d6" #edb/ref 17592186045417] [17592186335337 #edb/ref 1075 #edb/ref 17592186333074 #edb/ref 17592186045417] [17592186335337 #edb/ref 1075 #edb/ref 17592186334121 #edb/ref 17592186045417] [17592186335337 #edb/ref 1075 #edb/ref 17592186334214 #edb/ref 17592186045417] [17592186335337 #edb/ref 1075 #edb/ref 17592186334717 #edb/ref 17592186045417] [17592186335337 #edb/ref 1075 #edb/ref 17592186335140 #edb/ref 17592186045417] [17592186335337 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186335337 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186335337 #edb/ref 1078 #edb/ref 17592186335140 #edb/ref 17592186045417] [17592186335337 #edb/ref 1079 #uuid "315d67e3-a8ca-5508-a7b2-478fa5b39f63" #edb/ref 17592186045417] [17592186335944 #edb/ref 1068 #edb/ref 17592186335337 #edb/ref 17592186045417] [17592186335944 #edb/ref 1069 "q-68043" #edb/ref 17592186045417] [17592186335944 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186335944 #edb/ref 1071 "Calculate ${lim}_{x\\to \\infty }\\,\\,\\frac{{x}^{3}+x}{2{x}^{2}+x+4}.$" #edb/ref 17592186045417] [17592186335944 #edb/ref 1072 #uuid "66754a6b-36e3-52c9-b059-874445c5d773" #edb/ref 17592186045417] [17592186335944 #edb/ref 1074 "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\,\\,\\frac{{x}^{3}+x}{2{x}^{2}+x+4} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{{x}^{3}}{{x}^{2}}+\\frac{x}{{x}^{2}})}{(\\frac{2{x}^{2}}{{x}^{2}}+\\frac{x}{{x}^{2}}+\\frac{4}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(x+\\frac{1}{x})}{(2+\\frac{1}{x}+\\frac{4}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(x+0)}{(2+0+0)} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{x}{2} \\\\  & =\\infty .\\end{aligned}\n$$" #edb/ref 17592186045417]}
