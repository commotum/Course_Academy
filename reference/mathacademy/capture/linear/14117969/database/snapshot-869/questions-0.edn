id "0948bf66-b9eb-50e0-aa36-a645d1dd4d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186333074} {:answer/id #uuid "7f2618e2-1548-5494-9496-e1c7e62150fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186334121} {:answer/id #uuid "89c810fb-1fda-543b-a4ab-03e4899ffff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186334214} {:answer/id #uuid "c6d2b174-a819-5c3c-8807-a772dccc544a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Does not exist." :db/id #edb/ref 17592186334717} {:answer/id #uuid "f53a2a74-5ee8-5629-9c0f-607f722db1d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186335140}] :answer-field/correct {:answer/id #uuid "f53a2a74-5ee8-5629-9c0f-607f722db1d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186335140} :answer-field/id #uuid "315d67e3-a8ca-5508-a7b2-478fa5b39f63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335337}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66754a6b-36e3-52c9-b059-874445c5d773" :question/math-academy-id "q-68043" :question/problem "Calculate ${lim}_{x\\to \\infty }\\,\\,\\frac{{x}^{3}+x}{2{x}^{2}+x+4}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\,\\,\\frac{{x}^{3}+x}{2{x}^{2}+x+4} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{{x}^{3}}{{x}^{2}}+\\frac{x}{{x}^{2}})}{(\\frac{2{x}^{2}}{{x}^{2}}+\\frac{x}{{x}^{2}}+\\frac{4}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(x+\\frac{1}{x})}{(2+\\frac{1}{x}+\\frac{4}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(x+0)}{(2+0+0)} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{x}{2} \\\\  & =\\infty .\\end{aligned}\n$$"}]}
