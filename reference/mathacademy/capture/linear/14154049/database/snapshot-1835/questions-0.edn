#{[{:db/id #edb/ref 17592186054371 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054842 :knowledge-point/id #uuid "40e41bd9-1eee-552d-8507-e8cdf50ddfa4" :knowledge-point/title "Expressing a Product Using an Exponent"}] :question/id #uuid "890b54a1-db53-5a05-bdba-1477aed3461a" :question/math-academy-id "e-12792" :question/problem "Express $7 \\times 7 \\times 7 \\times 7 \\times 7\\times 7$ using an exponent." :question/worked-solution "The number $7$ is multiplied by itself $6$ times, so we have\n\n$$\n\\underbrace{7 \\times 7 \\times 7 \\times 7 \\times 7\\times 7}_{\\large{\\color{blue}6} \\textrm{copies of} 7} = 7^{\\color{blue}6}\n$$\n\nTherefore, the answer is $7^6$."}] [{:db/id #edb/ref 17592186054372 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054843 :knowledge-point/id #uuid "85e60062-7218-5aab-a67a-2cc84f7ad973" :knowledge-point/title "Evaluating an Exponential Expression"}] :question/id #uuid "757d0b35-b4ce-5573-bffd-5badc527bc40" :question/math-academy-id "e-12793" :question/problem "Evaluate $3^4$." :question/worked-solution "The expression $3^4$ means $3$ multiplied by itself $4$ times. So we have\n\n$$\n\\begin{aligned}\n3^{4} &= (3 \\cdot 3) \\cdot (3 \\cdot 3) \\\\\n&= 9 \\cdot 9 \\\\\n&= 81\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054373 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054844 :knowledge-point/id #uuid "1f2cde7b-5f1d-57d0-b24c-c215d83a1936" :knowledge-point/title "Raising a Number to the Power of One"}] :question/id #uuid "93e87899-2b3f-5a97-9a86-538b1acc34b5" :question/math-academy-id "e-12794" :question/problem "Evaluate $9^1$." :question/worked-solution "Any number raised to the first power is itself. So $9^1 = 9$."}] [{:db/id #edb/ref 17592186055097 :knowledge-point/_questions [{:db/id #edb/ref 17592186054842 :knowledge-point/id #uuid "40e41bd9-1eee-552d-8507-e8cdf50ddfa4" :knowledge-point/title "Expressing a Product Using an Exponent"}] :question/answer-fields [{:answer-fiel