  "html": "<div id=\"step-170377\" class=\"step\" style=\"display: block\" stepid=\"170377\" steptype=\"example\" contentid=\"14423\">\n            <div class=\"stepHeader\">\n                <div class=\"stepName\">\n                    Example: \n                    <a id=\"stepAnchor-170377\" class=\"stepAnchor\" style=\"font-weight: normal;\" name=\"step-9\">Identifying the Missing Result in a Division Model</a> \n                </div>      \n                <div class=\"helpButton\" stepid=\"170377\">?</div>\n            </div>\n            \n            <div class=\"exampleQuestion\">\n                <p>What picture is missing from the division model below?</p>\n<p><br></p>\n<div id=\"graphic-ce803880b55287cd389c4facccc362ac\" class=\"graphic\"><img src=\"/graphics/ce803880b55287cd389c4facccc362ac\"></div>\n\n<p><br></p>\n\n            </div>     \n\n            <div class=\"explanationHeader\">EXPLANATION</div>\n\n            <div class=\"exampleExplanation\">\n                <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n              