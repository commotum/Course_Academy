#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074605} :activity/id #uuid "84bb85b0-fcbc-5f41-956b-e9fb4753720a" :activity/scope {:db/id #edb/ref 17592186048460 :topic/id #uuid "a1872f62-c9fe-5c68-8bb3-3c9dac0602b3" :topic/math-academy-id 528} :activity/steps [{:db/id #edb/ref 17592186074605 :step/content {:db/id #edb/ref 17592186075052 :tutorial/content "Remember that a *unit* fraction is a fraction containing ![](images/cc/ccee5f5be0445cce59832a3def74f395a7d05cc12dc630fb36baf8f3d2d448bd.svg) in the numerator. So, for example, the fractions \n\n![](images/2e/2e38b15a8f3be74e15b87e81264b66571e593de7250dc902aeaa0e7bc1c506bf.svg)\nare both unit fractions, whereas \n\n![](images/d1/d157ce836a54214740d295f545d4c94d8c57d54d92ac7f075ed9b92556c932b1.svg)\nare *not* unit fractions.\n\nIn this lesson, we will use models to divide unit fractions by whole numbers. \n\nLet's use a fraction model to find the value of \n\n![](images/d8/d8815c6716e962ce4aebee24d004d4c591a1bc35c5fdebcd87d26ace61ead7fb.svg)\nWe start with a square model of ![](images/9f/9fcebe90d169f37bbdbf55f9e4ac86ceaf6ea6d573d101f382a12008bb0c5c2a.svg) split *vertically*.\n\n![](images/cc/ccfe0f457342c456200c98cfc46e63bdc1153698282085164eeafae5c2092c45.png)\n\nTo divide ![](images/9a/9ae11798da63cafee6ce5ccf824a7b96f9f7407a4ee445d1431d907c36f5dd1b.svg) by ![](images/db/dbfe30ca4e672459c180bd90f25f84f025162b8ce73260773fb1fbdf39b0a052.svg) we split the above whole into ![](images/6f/6f33d8df0d08ae9bddce540bedf62f46e93e748e4a5b6fd85b1dc626953e44a6.svg) equal parts *horizontally*. Then, we remove any shaded parts that are not in the bottom row.\n\n![](images/79/7940073ba05d3136ee1d465530a60bc3624b7aa06fd7484d30797758a28976d7.png)\n\nFrom the picture on the right, we obtain that the shaded part represents ![](images/42/42accbcb8cbfd14800ac4a27bc87d5ba529ff4173a91499f32705cd41b0c88b0.svg) of the whole.\n\nTherefore,\n![](images/f1/f14a0f0f9efb98bdfe6cf40f4b1bbb2c88dc20272caaf9d604fcc44bce79d53c.svg)" :tutorial/id #uuid "5efb47fa-47c0-50c8-9c53-0a64bfc732ea" :tutorial/math-academy-id 8924 :tutorial/title "Introduction"} :step/id #uuid "f5584f93-514d-5a2f-bcbb-77e4a6db1fab" :step/math-academy-id 170369 :step/next {:db/id #edb/ref 17592186074606}} {:db/id #edb/ref 17592186074606 :step/content {:db/id #edb/ref 17592186073716 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073486 :question/id #uuid "4fae5cf1-65c9-5217-89ec-54b40e80f293" :question/math-academy-id "e-14418"} :knowledge-point/id #uuid "aabbe3f2-c799-5d31-b5c1-8d21b32afccc" :knowledge-point/questions [{:db/id #edb/ref 17592186074072} {:db/id #edb/ref 17592186074361} {:db/id #edb/ref 17592186426220} {:db/id #edb/ref 17592186426221}] :knowledge-point/title "Identifying the Division Problem Represented by a Model"} :step/id #uuid "d78545b2-12fd-53a7-b39d-42f2a610a91e" :step/math-academy-id 170370 :step/next {:db/id #edb/ref 17592186074607}} {:db/id #edb/ref 17592186074607 :step/content {:db/id #edb/ref 17592186073717 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073487 :question/id #uuid "9cd2d717-01de-5319-8759-2990e79d64ad" :question/math-academy-id "e-14420"} :knowledge-point/id #uuid "91201453-ec4d-55a4-8a7b-eae34fca9f8d" :knowledge-point/questions [{:db/id #edb/ref 17592186074070} {:db/id #edb/ref 17592186074073} {:db/id #edb/ref 17592186074462} {:db/id #edb/ref 17592186426218} {:db/id #edb/ref 17592186426219}] :knowledge-point/title "Identifying the Missing Divisor in a Division Model"} :step/id #uuid "35c4a621-9782-54f8-a831-e096eb3088b1" :step/math-academy-id 170373 :step/next {:db/id #edb/ref 17592186074608}} {:db/id #edb/ref 17592186074608 :step/content {:db/id #edb/ref 17592186073718 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073488 :question/id #uuid "62d9f262-e419-5a9d-a5cb-741c34613570" :question/math-academy-id "e-14423"} :knowledge-point/id #uuid "7bb96a84-3329-5702-ae45-a7d0ad2a95c6" :knowledge-point/questions [{:db/id #edb/ref 17