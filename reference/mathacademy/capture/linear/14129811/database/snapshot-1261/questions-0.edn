bbcaa8124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186426175} {:answer/id #uuid "7da90e6e-79a7-5d7a-93d8-d940239d7a66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186426185} {:answer/id #uuid "88ad7fc3-818b-583d-ba2d-80ceec1bddf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186426187} {:answer/id #uuid "cee68a1f-2a13-5241-b8cd-0e8e47724fdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186426197} {:answer/id #uuid "d4170176-b35f-5cc6-b501-7bf5d116d9ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186426198}] :answer-field/correct {:answer/id #uuid "24789ef8-39e5-5eb7-8a31-b15bbcaa8124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186426175} :answer-field/id #uuid "2a2205ab-84ba-5cdc-ac76-63c5fe7bd9ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426206}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "510bd3d9-625e-50ef-9ff1-29e5063839de" :question/math-academy-id "q-92142" :question/problem "![](images/0c/0c9a3175cf873ca57adb7f57494f2288c898af1fab9e705d9baaa5335523fa3e.png)\n\nWhat number is missing from the division problem above?" :question/worked-solution "We have $\\frac{1}{3}$ on the left and $\\frac{1}{12}$ on the right.\n\n![](images/96/9638292c507e0714051d52053868717b38ca96ecbc2f7f7629eecf3ed9269fc6.png)\n\nThe division operation splits the shaded region on the left into $4$ equal parts. So the shaded part on the left is $4$ times larger than the shaded part on the right. \n\nTherefore, the division problem shown is:\n\n$$\n\\frac{1}{3}÷4=\\frac{1}{12}\n$$\n\nSo, the missing number is $4.$"}]}
