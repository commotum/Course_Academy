/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee887bda-3e93-501b-9a19-ae45191b855d" :question/math-academy-id "q-60996" :question/problem "![](images/19/19a6781b69eaa283d5681f6ceb0caae64d7236045796530b4bfb852efb5369ab.png)\n\nWhat division problem is represented by the model above?" :question/worked-solution "We have $\\frac{1}{6}$ on the left and $\\frac{1}{18}$ on the right.\n\n![](images/26/26b6d4d934870b17480aa5c575c35bdf1603d976982728ab731d887527bd8637.png)\n\nThe division operation splits the shaded region on the left into $3$ equal parts. So the shaded part on the left is $3$ times larger than the shaded part on the right. \n\nTherefore, the division problem shown is:\n\n$$\n\\frac{1}{6}÷3=\\frac{1}{18}\n$$"}] [{:db/id #edb/ref 17592186426215 :knowledge-point/_questions [{:db/id #edb/ref 17592186073718 :knowledge-point/id #uuid "7bb96a84-3329-5702-ae45-a7d0ad2a95c6" :knowledge-point/title "Identifying the Missing Result in a Division Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37313ebf-b581-5895-b409-a88ec4b3323b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/57/5728a31bada1e61de52cb517941554be27bc63670d6fe98ba5c3eda4c2f5d7a4.png" :db/id #edb/ref 17592186426177} {:answer/id #uuid "51ca4719-7a0c-50ca-ab4a-f5bca9455069" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/12/12af273d7c64a18f27ba95e0a2aa624cb74ab3ef2e6777349d53b09a721e6754.png" :db/id #edb/ref 17592186426179} {:answer/id #uuid "ae0f0d8c-1404-54fd-9e0f-c94d34d42b5b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5e/5ebb3fd718d86f697862763fedffbf2a2d62f90cc1ca8c337c03bb965198759a.png" :db/id #edb/ref 17592186426191} {:answer/id #uuid "bee83439-9f76-564b-a493-19e9d0f1bcf0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/ef539aa99b8d0a