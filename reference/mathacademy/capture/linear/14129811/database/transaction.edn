a657-72dc1365d64a" :answer/type :answer.type/math :answer/value "\\frac{3}{6}÷6=\\frac{1}{18}" :db/ensure [:answer/validate]} {:db/id "question-510bd3d9-625e-50ef-9ff1-29e5063839de" :question/id #uuid "510bd3d9-625e-50ef-9ff1-29e5063839de" :question/math-academy-id "q-92142" :question/problem "![](images/0c/0c9a3175cf873ca57adb7f57494f2288c898af1fab9e705d9baaa5335523fa3e.png)\n\nWhat number is missing from the division problem above?" :question/worked-solution "We have $\\frac{1}{3}$ on the left and $\\frac{1}{12}$ on the right.\n\n![](images/96/9638292c507e0714051d52053868717b38ca96ecbc2f7f7629eecf3ed9269fc6.png)\n\nThe division operation splits the shaded region on the left into $4$ equal parts. So the shaded part on the left is $4$ times larger than the shaded part on the right. \n\nTherefore, the division problem shown is:\n\n$$\n\\frac{1}{3}÷4=\\frac{1}{12}\n$$\n\nSo, the missing number is $4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2a2205ab-84ba-5cdc-ac76-63c5fe7bd9ea"] :db/ensure [:question/validate]} {:db/id "answer-field-2a2205ab-84ba-5cdc-ac76-63c5fe7bd9ea" :answer-field/id #uuid "2a2205ab-84ba-5cdc-ac76-63c5fe7bd9ea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-24789ef8-39e5-5eb7-8a31-b15bbcaa8124" :answer-field/choices ["answer-24789ef8-39e5-5eb7-8a31-b15bbcaa8124" "answer-d4170176-b35f-5cc6-b501-7bf5d116d9ec" "answer-cee68a1f-2a13-5241-b8cd-0e8e47724fdd" "answer-88ad7fc3-818b-583d-ba2d-80ceec1bddf4" "answer-7da90e6e-79a7-5d7a-93d8-d940239d7a66"] :db/ensure [:answer-field/validate]} {:db/id "answer-24789ef8-39e5-5eb7-8a31-b15bbcaa8124" :answer/id #uuid "24789ef8-39e5-5eb7-8a31-b15bbcaa8124" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-d4170176-b35f-5cc6-b501-7bf5d116d9ec" :answer/id #uuid "d4170176-b35f-5cc6-b501-7bf5d116d9ec" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-cee68a1f-2a13-5241-b8cd-0e8e47724fdd" :answer/id #uuid "cee68a1f-2a13-5241-b8cd-0e8e47724fdd" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-88ad7fc3-818b-583d-ba2d-80ceec1bddf4" :answer/id #uuid "88ad7fc3-818b-583d-ba2d-80ceec1bddf4" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-7da90e6e-79a7-5d7a-93d8-d940239d7a66" :answer/id #uuid "7da90e6e-79a7-5d7a-93d8-d940239d7a66" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "question-c3b94acc-11cb-5adf-8b47-557b2f1acf0b" :question/id #uuid "c3b94acc-11cb-5adf-8b47-557b2f1acf0b" :question/math-academy-id "q-222989" :question/problem "Insert the missing number in the division problem below.\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td>\n<table align=\"center\" cellpadding=\"0\" height=\"100\" rules=\"all\" width=\"100\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n</tbody></table>\n</td>\n<td>\n<table align=\"center\" cellpadding=\"3\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$÷$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-1}}\n</td>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$=$</td>\n</tr>\n<tr>\n</tr>\n</tbody></table>\n</td>\n<td>\n<table align=\"center\" cellpadding=\"0\" height=\"100\" rules=\"all\" width=\"100\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n</tr>\n</tbody></table>\n</td>\n</tr>\n</tbody></table>" :question/worked-solution "We have $\\frac{1}{5}$ on the left and $\\frac{1}{35}$ on the right.\n\n![](images/34/3446d5184d3cd128aabaf7f571973e621c1c0c612b01418f1d470bdb616d5ccd.png)\n\nThe division operation splits the shaded region on the left into $7$ equal parts. So the shaded part on the left is $7$ times larger than the shaded part on the right. \n\nTherefore, the division problem shown is:\n\n$$\n\\frac{1}{5}÷7=\\frac{1}{35}\n$$\n\nSo, the missing number is $7.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-cc9faf43-6aee-5f72-8f40-0ad2d2596130"] :db/ensure [:question/validate]} {:db/id "answer-field-cc9faf43-6aee-5f72-8f40-0ad2d2596130" :answer-field/id #uuid "cc9faf43-6aee-5f72-8f40-0ad2d2596130" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3d8eb349-8d81-5b23-8b12-380de2e96e35" :answer-field/choices ["answer-3d8eb349-8d81-5b23-8b12-380de2e96e35"] :db/ensure [:answer-field/validate]} {:db/id "answer-3d8eb349-8d81-5b23-8b12-380de2e96e35" :answer/id #uuid "3d8eb349-8d81-5b23-8b12-380de2e96e35" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-286c5586-6918-5cc7-88c8-ed9f91aad0df" :question/id #uuid "286c5586-6918-5cc7-88c8-ed9f91aad0df" :question/math-academy-id "q-59753" :question/problem "![](images/0c/0cd106493ef6b5c72c5c361fd245a9ec23311b3afc580d9a9449f2a9119a8655.png)\n\nWhat picture is missing from the division model above?" :question/worked-solution "In the model, we have $\\frac{1}{2}$ on the left.\n\nSince we need to divide by $2$, we split the whole into $2$ equal parts horizontally. \n\n![](images/55/55f483778924efcec7d8e47c0c580c3a2c1057d23b2a3ef172adf8b39ddfbd64.png)\n\nFrom the picture on the right, we obtain that the shaded part represents $\\frac{1}{4}$ of the whole.\n\nThe missing picture is:\n\n![](images/6e/6e06a98a14764d926db5dc09d5f1c7f9c2e74a1cd9f396164e6291206b5327