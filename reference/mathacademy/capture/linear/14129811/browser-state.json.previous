      "html": "<div id=\"step-q222989\" class=\"step questionWidget\" style=\"display: block;\"><div class=\"questionWidget-header\"><div class=\"questionWidget-title\">Question 4</div><div class=\"questionWidget-helpButton\">?</div></div><div class=\"questionWidget-text\">Insert the missing number in the division problem below.<table rules=\"all\" cellpadding=\"0\" align=\"center\" style=\"border:0px solid white; margin: auto; margin-bottom: 4mm; margin-top: 4mm;\">\n\n<tbody><tr>\n\n<td>\n\n<table rules=\"all\" width=\"100\" height=\"100\" cellpadding=\"0\" align=\"center\" style=\"border:2px solid rgba(69, 155, 118, 0.8);\">\n<tbody><tr>\n<td style=\"background-color:rgba(69, 155, 118, 0.2); border:2px solid rgba(69, 155, 118, 0.8);\"></td>\n<td style=\"background-color:white; border:2px solid rgba(69, 155, 118, 0.8);\"></td>\n<td style=\"background-color:white; border:2px solid rgba(69, 155, 118, 0.8);\"></td>\n<td style=\"background-color:white; border:2px solid rgba(69, 155, 118, 0.8);\"></td>\n<td style=\"background-color:white; border:2px solid rgba(69, 155, 118, 0.8);\"></td>\n</tr>\n</tbody></table>\n\n</td>\n\n<td>\n\n<table rules=\"all\" cellpadding=\"3\" align=\"center\">\n<tbody><tr>\n<td rowspan=\"2\" width=\"25\" style=\"text-align:center; border-bottom:hidden;\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"-1\" ctxtmenu_counter=\"31\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle size=\"lg\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-cF7\"></mjx-c></mjx-mo></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathsize=\"1.2em\"><mo>÷</mo></mstyle></math></mjx-assistive-mml></mjx-container></td>\n<td width=\"25\" height=\"25\" style=\"text-align:center; border-bottom:hidden; border-left:hidden; border-right:hidden;\">\n<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:20px;\n                                        margin-left:-1px;\n                                        margin-right:-1px;\n                                        background:white;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"1\"><span mathquill-command-id=\"3\">7</span></span></div></div>\n</td>\n<td rowspan=\"2\" width=\"25\" style=\"text-align:center; border-bottom:hidden;\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"-1\" ctxtmenu_counter=\"32\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle size=\"lg\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathsize=\"1.2em\"><mo>=</mo></mstyle></math></mjx-assistive-mml></mjx-container></td>\n</tr>\n<tr>\n</tr>\n</tbody></table>\n\n</td>\n\n<td>\n\n<table rules=\"all\" width=\"100\" height=\"100\" cellpadding=\"0\" align=\"center\" style=\"border:2px solid rgba(69, 155, 118, 0.8);\">\n<tbody><tr>\n<td style=\"background-color:white; border:2px solid rgba(69, 155, 118, 0.8);\"></td>\n<td style=\"background-color:white; border:2px solid rgba(69, 155, 118, 0.8);\"></td>\n<td style=\"background-color:white; border:2px solid rgba(69, 155, 118, 0.8);\"></td>\n<td style=\"background-color:white; border:2px solid rgba(69, 155, 118, 0.8);\"></td>\n<td style=\"background-color:white; border:2px solid rgba(69, 155, 118, 0.8);\"></td>\n</tr>\n<tr>\n<td style=\"background-color:white; border:2px solid rgba(69, 155, 118, 0.8);\"></td>\n<td style=\"b