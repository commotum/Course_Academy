"false\">)</mo></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>±</mo><msqrt><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>25</mn><mn>64</mn></mfrac></mstyle></msqrt><mo>⋅</mo><msqrt><mo>−</mo><mn>1</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>±</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>25</mn></msqrt><msqrt><mn>64</mn></msqrt></mfrac></mstyle><mo>⋅</mo><msqrt><mo>−</mo><mn>1</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>±</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>8</mn></mfrac></mstyle><mtext>i</mtext></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
