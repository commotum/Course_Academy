able></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.6em 0.3em\"><mtr><mtd><mi>y</mi></mtd><mtd><mi></mi><mo>=</mo><mo>±</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>3</mn></msqrt><msqrt><mn>2</mn></msqrt></mfrac></mstyle><mtext>i</mtext></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>±</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>3</mn></msqrt><msqrt><mn>2</mn></msqrt></mfrac></mstyle><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>2</mn></msqrt><msqrt><mn>2</mn></msqrt></mfrac></mstyle><mo>⋅</mo><msqrt><mo>−</mo><mn>1</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>±</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>6</mn></msqrt><mn>2</mn></mfrac></mstyle><mtext>i</mtext></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
