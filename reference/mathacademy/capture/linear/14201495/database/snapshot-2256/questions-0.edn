3953-965d-5e7d-8ae6-4d3ca4fb8eed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\sqrt{3}\\,\\text{i}" :db/id #edb/ref 17592186517601} {:answer/id #uuid "5c0134ef-4a13-5729-92c1-c572b616051a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{\\sqrt{3}}{2}\\text{i}" :db/id #edb/ref 17592186517655} {:answer/id #uuid "75ddc0a8-68a7-598b-8764-ca68b1936025" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{\\sqrt{2}}{6}\\text{i}" :db/id #edb/ref 17592186517711} {:answer/id #uuid "b8cb3719-cc2d-5ddd-9d2c-3c62af520a87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{\\sqrt{2}}{3}\\text{i}" :db/id #edb/ref 17592186517835}] :answer-field/correct {:answer/id #uuid "132d8079-9184-5cf8-ba4f-984356f42abc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{\\sqrt{6}}{2}\\text{i}" :db/id #edb/ref 17592186517525} :answer-field/id #uuid "ab495d5c-1e27-5baa-8e34-728ab73fbe3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067792}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "47b94063-7f34-5826-9273-858fa9727be7" :question/math-academy-id "q-54630" :question/problem "What are the solutions of the equation $8{y}^{2}+12=0?$" :question/worked-solution "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}8{y}^{2}+12 & =0 \\\\ 8{y}^{2} & =-12 \\\\ {y}^{2} & =-\\frac{12}{8} \\\\ {y}^{2} & =-\\frac{3}{2}\\end{aligned}\n$$\n\nBy taking square root, we obtain:\n\n$$\ny=\\pm \\sqrt{-\\frac{3}{2}}\n$$\n\nWe now rewrite $y$ using the imaginary unit $\\text{i}=\\sqrt{-1}\\,:$\n\n$$\n\\begin{aligned}y & =\\pm \\sqrt{-\\frac{3}{2}} \\\\  & =\\pm \\sqrt{\\frac{3}{2}\\cdot (-1)} \\\\  & =\\pm \\sqrt{\\frac{3}{2}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{\\sqrt{3}}{\\sqrt{2}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{\\sqrt{3}}{\\sqrt{2}}\\text{i}\\end{aligned}\n$$\n\nFinally, we rationalize the denominator:\n\n$$\n\\begin{aligned}y & =\\pm \\frac{\\sqrt{3}}{\\sqrt{2}}\\text{i} \\\\  & =\\pm \\frac{\\sqrt{3}}{\\sqrt{2}}\\cdot \\frac{\\sqrt{2}}{\\sqrt{2}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{\\sqrt{6}}{2}\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186518197 :knowledge-point/_questions [{:db/id #edb/ref 17592186068706 :knowledge-point/id #uuid "386bce9a-0c89-545c-b9ed-b9f67fb836b2" :knowledge-point/title "Solving a Quadratic Equation With Purely Imaginary Solutions With Simplification"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04435194-583c-5f60-9dfd-01b9700b130f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\sqrt{3}\\,\\text{i}" :db/id #edb/ref 17592186517498} {:answer/id #uuid "0c227682-8093-5ef5-81a9-3967ae571e70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 7\\sqrt{3}\\,\\text{i}" :db/id #edb/ref 17592186517513} {:answer/id #uuid "5c3f02bd-55b2-5559-aeb7-4f037f158d53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\sqrt{3}\\,\\text{i}" :db/id #edb/ref 17592186517656} {:answer/id #uuid "968e606e-ef3a-548c-83db-9562168f22c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 3\\sqrt{7}\\,\\text{i}" :db/id #edb/ref 17592186517772} {:answer/id #uuid "d622d75e-b7ed-55dc-a703-128ef32c46fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{7}\\,\\text{i}" :db/id #edb/ref 17592186517893}] :answer-field/correct {:answer/id #uuid "968e606e-ef3a-548c-83db-9562168f22c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 3\\sqrt{7}\\,\\text{i}" :db/id #edb/ref 17592186517772} :answer-field/id #uuid "01c4d03b-0f6c-5ed2-bb6c-7ece815cef7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186517969}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd11ce23-27fe-5c7c-9502-a02ca58513ca" :question/math-academy-id "q-66250" :question/problem "If ${y}^{2}+63=0,$ then $y=$" :question/worked-solution "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}{y}^{2}+63 & =0 \\\\ {y}^{2} & =-63\\end{aligned}\n$$\n\nBy taking square root, we obtain:\n\n$$\ny=\\pm \\sqrt{-63}\n$$\n\nWe now rewrite $y$ using the imaginary unit $\\text{i}=\\sqrt{-1}\\,:$\n\n$$\n\\begin{aligned}y & =\\pm \\sqrt{-63} \\\\  & =\\pm \\sqrt{63\\cdot (-1)} \\\\  & =\\pm \\sqrt{63}\\cdot \\sqrt{-1} \\\\  & =\\pm 3\\sqrt{7}\\cdot \\sqrt{-1} \\\\  & =\\pm 3\\sqrt{7}\\,\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069476 :knowledge-point/_questions [{:db/id #edb/ref 17592186068707 :knowledge-point/id #uuid "701015d7-cc6a-52ff-b40d-627a640cd0fb" :knowledge-point/title "Solving a Quadratic Equation With Purely Imaginary Fractional Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13f74ec9-b3e2-592c-9d7d-428e27523b8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{5}" :db/id #edb/ref 17592186068030} {:answer/id #uuid "19fd0de6-fe5b-5d65-b618-614985030ff0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{6}{5}" :db/id #edb/ref 17592186517536} {:answer/id #uuid "6cc99135-04a4-5f4d-9082-3578e0f40e55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{6}{5}\\text{i}" :db/id #edb/ref 17592186517692} {:answer/id #uuid "ba415c2b-05c1-5eab-bbbc-b63c56c7ee81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}\\text{i}" :db/id #edb/ref 17592186517840} {:answer/id #uuid "eaaee2d2-b7a1-54d7-9520-3d7345cdf5c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{5}{6}\\text{i}" :db/id #edb/ref 17592186517933}] :answer-field/correct {:answer/id #uuid "6cc99135-04a4-5f4d-9082-3578e0f40e55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm \\frac{6}{5}\\text{i}" :db/id #edb/ref 17592186517692} :answer-field/id #uuid "fb97819c-0e4a-5ac6-a889-9c7ec737b994" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186068026}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0e3bf3f1-d937-55da-b28c-d65551dd4623" :question/math-academy-id "q-66254" :question/problem "Find the solutions of the equation $25{z}^{2}+36=0.$" :question/worked-solution "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}25{z}^{2}+36 & =0 \\\\ 25{z}^{2} & =-36 \\\\ {z}^{2} & =-\\frac{36}{25}\\end{aligned}\n$$\n\nBy taking square root, we obtain:\n\n$$\nz=\\pm \\sqrt{-\\frac{36}{25}}\n$$\n\nWe now rewrite $z$ using the imaginary unit $\\text{i}=\\sqrt{-1}\\,:$\n\n$$\n\\begin{aligned}z & =\\pm \\sqrt{-\\frac{36}{25}} \\\\  & =\\pm \\sqrt{\\frac{36}{25}\\cdot (-1)} \\\\  & =\\pm \\sqrt{\\frac{36}{25}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{\\sqrt{36}}{\\sqrt{25}}\\cdot \\sqrt{-1} \\\\  & =\\pm \\frac{6}{5}\\text{i}\\end{aligned}\n$$"}]}
