0Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-2212\" d=\"M84 237T84 250T98 270H679Q694 262 694 250T679 230H98Q84 237 84 250Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-34\" d=\"M462 0Q444 3 333 3Q217 3 199 0H190V46H221Q241 46 248 46T265 48T279 53T286 61Q287 63 287 115V165H28V211L179 442Q332 674 334 675Q336 677 355 677H373L379 671V211H471V165H379V114Q379 73 379 66T385 54Q393 47 442 46H471V0H462ZM293 211V545L74 212L183 211H293Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n<g transform=\"translate(167,0)\">\n<g transform=\"translate(-11,0)\">\n<g transform=\"translate(0,1792)\">\n <use xlink:href=\"#E3-MJMAIN-32\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(500,0)\">\n <use xlink:href=\"#E3-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-32\" x=\"809\" y=\"583\"></use>\n</g>\n <use xlink:href=\"#E3-MJMAIN-2B\" x=\"1749\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-38\" x=\"2749\" y=\"0\"></use>\n</g>\n<g transform=\"translate(1723,-93)\">\n <use xlink:href=\"#E3-MJMAIN-32\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(500,0)\">\n <use xlink:href=\"#E3-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-32\" x=\"809\" y=\"583\"></use>\n</g>\n</g>\n<g transform=\"translate(2223,-1977)\">\n <use xlink:href=\"#E3-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-32\" x=\"809\" y=\"583\"></use>\n</g>\n</g>\n<g transform=\"translate(3517,0)\">\n<g transform=\"translate(0,1792)\">\n <use xlink:href=\"#E3-MJMAIN-3D\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E