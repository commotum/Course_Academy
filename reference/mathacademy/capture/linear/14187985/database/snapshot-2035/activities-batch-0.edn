#{[{:activity/first-step {:db/id #edb/ref 17592186180320} :activity/id #uuid "a4c8ca08-bd22-5363-926f-e23513ac4154" :activity/scope {:db/id #edb/ref 17592186049201 :topic/id #uuid "e2f84ebe-3953-57c1-b57f-978988ee6101" :topic/math-academy-id 3725} :activity/steps [{:db/id #edb/ref 17592186180320 :step/content {:db/id #edb/ref 17592186180783 :tutorial/content "To determine the slope of a line that is given in standard form, we need to convert the equation to slope-intercept form.\n\nTo demonstrate, let's calculate the slope of the following line:\n\n$$\n2x + y = 8\n$$\n\nTo write this equation in slope-intercept form, we solve for $y$:\n\n$$\n\\begin{aligned}\n2x + y &= 8 \\\\\n2x + y - 2x &= 8 - 2x \\\\\ny &= 8 - 2x \\\\\ny &= -2x + 8\n\\end{aligned}\n$$\n\nFrom the slope-intercept equation, we can tell that the slope of the line is $m=-2$." :tutorial/id #uuid "3550ae2f-df69-52cc-b33a-14e8f2bb2d8a" :tutorial/math-academy-id 8697 :tutorial/title "Introduction"} :step/id #uuid "72c1429e-a7f2-51eb-b430-aeb492262ee7" :step/math-academy-id 138017 :step/next {:db/id #edb/ref 17592186180321}} {:db/id #edb/ref 17592186180321 :step/content {:db/id #edb/ref 17592186179631 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179474 :question/id #uuid "9b0cfd54-9310-59e6-91cb-5b18413ae7b3" :question/math-academy-id "e-13979"} :knowledge-point/id #uuid "48f52c24-cd5a-5701-8ec2-1d833e87a25f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049394} {:db/id #edb/ref 17592186049840}] :knowledge-point/questions [{:db/id #edb/ref 17592186180058} {:db/id #edb/ref 17592186180131}] :knowledge-point/title "Finding the Slope of a Line Given Standard Form"} :step/id #uuid "fd4133a0-8060-545f-b970-74364bd3c8af" :step/math-academy-id 138018 :step/next {:db/id #edb/ref 17592186180322}} {:db/id #edb/ref 17592186180322 :step/content {:db/id #edb/ref 17592186180784 :tutorial/content "Suppose we want to find the $x$- and $y$-intercepts of the following line:\n\n$$\n2x + y = 8\n$$\n\nLet's find each of them in turn.\n\n- To find the $x$-intercept, we substitute $y=0$ into the equation and solve for $x{:}$\n$2x + (0)|= 8; 2x|= 8; \\frac{2x}{2}|= \\frac{8}{2}; x|= 4$\nTherefore, the line intersects the $x$-axis at the point $(4,0)$.\n\n- To find the $y$-intercept, we substitute $x=0$ into the equation and solve for $y{:}$\n$2(0) + y|= 8; y|= 8$\nTherefore, the line intersects the $y$-axis at the point $(0,8)$." :tutorial/id #uuid "c500072d-6462-54c2-8c16-3c8f68bdbbfe" :tutorial/math-academy-id 8699 :tutorial/title "Determining Intercepts of Lines Given in Standard Form"} :step/id #uuid "ba8eac6e-a6b0-5050-a5e7-2508d56d4806" :step/math-academy-id 138022 :step/next {:db/id #edb/ref 17592186180323}} {:db/id #edb/ref 17592186180323 :step/content {:db/id #edb/ref 17592186179632 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179475 :question/id #uuid "d1904d74-7f31-5211-b7d4-88f4f5042d64" :question/math-academy-id "e-13982"} :knowledge-point/id #uuid "dd8533c7-7573-5917-b347-ce72d26a7168" :knowledge-point/questions [{:db/id #edb/ref 17592186180059} {:db/id #edb/ref 17592186180122}] :knowledge-point/title "Finding the X-Intercept of a Line"} :step/id #uuid "8393e8f1-d3a4-51f5-bea6-a2c3546128e8" :step/math-academy-id 138023 :step/next {:db/id #edb/ref 17592186180324}} {:db/id #edb/ref 17592186180324 :step/content {:db/id #edb/ref 17592186179633 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179476 :question/id #uuid "cbfa4dda-a399-5450-bacd-7681aebceede" :question/math-academy-id "e-13986"} :knowledge-point/id #uuid "ee8d9c8a-51c2-56b4-8006-e768bb7fa128" :knowledge-point/questions [{:db/id #edb/ref 17592186180123} {:db/id #edb/ref 17592186180124}] :knowledge-point/title "Finding the Y-Intercept of a Line"} :step/id #uuid "3a721917-d440-59e3-a3b3-441903fcc6b5" :step/math-academy-id 138026}] :activity/title "Properties of Lines Given in Standard Form" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179876}]}
