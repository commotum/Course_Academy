:answer-field/id #uuid "07ffe521-b249-5aa0-b4b1-011add1acd46" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501019}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6a919522-1a8b-510f-a55a-40d3694f3593" :question/math-academy-id "q-214668" :question/problem "What is the slope of the line $4x+7=0?$" :question/worked-solution "Note that \n\n$$\n\\begin{aligned}4x+7 & =0 \\\\ 4x & =-7 \\\\ x & =-\\frac{7}{4}.\\end{aligned}\n$$\n\nTherefore, the line is vertical, and its slope is undefined."}] [{:db/id #edb/ref 17592186501240 :knowledge-point/_questions [{:db/id #edb/ref 17592186179632 :knowledge-point/id #uuid "dd8533c7-7573-5917-b347-ce72d26a7168" :knowledge-point/title "Finding the X-Intercept of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1410a63b-361e-5496-8200-ae1b63d78725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186500511}] :answer-field/correct {:answer/id #uuid "1410a63b-361e-5496-8200-ae1b63d78725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186500511} :answer-field/id #uuid "0b754c20-8244-5f7e-85fa-5fa2f702047f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501021} {:answer-field/choices [{:answer/id #uuid "2b2e9113-16cb-54f9-a0f9-6f2c2ff2e685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186500553}] :answer-field/correct {:answer/id #uuid "2b2e9113-16cb-54f9-a0f9-6f2c2ff2e685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186500553} :answer-field/id #uuid "fdb9476a-3489-50b6-afd6-e25393d80f1c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501133}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f153c106-d98f-5f2d-af98-3aa7927bfc4d" :question/math-academy-id "q-214677" :question/problem "The line $3x-14y=-3$ intersects the $x$-axis at the point$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "To find the $x$-intercept, we substitute $y=0$ into the equation and solve for $x.$\n\n$$\n\\begin{aligned}3x-14y & =-3 \\\\ 3x-14(0) & =-3 \\\\ 3x & =-3 \\\\ \\frac{3x}{3} & =\\frac{-3}{3} \\\\ x & =-1\\end{aligned}\n$$\n\nHence, the $x$-intercept is $x=-1.$ Thus, the line intersects the $x$-axis at $(-1,0).$"}] [{:db/id #edb/ref 17592186501176 :knowledge-point/_questions [{:db/id #edb/ref 17592186179632 :knowledge-point/id #uuid "dd8533c7-7573-5917-b347-ce72d26a7168" :knowledge-point/title "Finding the X-Intercept of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75634763-e2c8-5ac5-b195-ac5c70809502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186500710}] :answer-field/correct {:answer/id #uuid "75634763-e2c8-5ac5-b195-ac5c70809502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186500710} :answer-field/id #uuid "98bcbd00-1360-593b-a8b5-f75353517d5a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501086} {:answer-field/choices [{:answer/id #uuid "05bd01db-fd0a-5b1a-b2b5-961f20d3d27b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186500477}] :answer-field/correct {:answer/id #uuid "05bd01db-fd0a-5b1a-b2b5-961f20d3d27b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186500477} :answer-field/id #uuid "e8d10e0c-d421-5338-ba21-3ed7cc3cab2e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501123}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b2df9ca-452f-5057-9208-dd46b2f5dde7" :question/math-academy-id "q-214680" :question/problem "The line $3x+8y=18$ intersects the $x$-axis at the point$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "To find the $x$-intercept, we substitute $y=0$ into the equation and solve for $x.$\n\n$$\n\\begin{aligned}3x+8y & =18 \\\\ 3x+8(0) & =18 \\\\ 3x & =18 \\\\ \\frac{3x}{3} & =\\frac{18}{3} \\\\ x & =6\\end{aligned}\n$$\n\nHence, the $x$-intercept is $x=6.$ Thus, the line intersects the $x$-axis at $(6,0).$"}] [{:db/id #edb/ref 17592186501184 :knowledge-point/_questions [{:db/id #edb/ref 17592186179631 :knowledge-point/id #uuid "48f52c24-cd5a-5701-8ec2-1d833e87a25f" :knowledge-point/title "Finding the Slope of a Line Given Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2239c35e-3145-5856-af94-fd5581d244c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186500538} {:answer/id #uuid "32a0b2e3-cb3a-5d86-bff5-04580915b914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186500573} {:answer/id #uuid "3d807d89-059f-51ec-8960-748837a3c2a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186500589} {:answer/id #uuid "c6f9543f-3213-547b-98d1-950edaa18467" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186500889} {:answer/id #uuid "de039c45-265b-503b-ba6d-4b7d1befdbc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186500940}] :answer-field/correct {:answer/id #uuid "de039c45-265b-503b-ba6d-4b7d1befdbc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186500940} :answer-field/id #uuid "77ba2dc0-680e-51f7-8e6e-8be3d8e551c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501070}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7a0740d0-7284-503e-8e76-e4838bad99ae" :question/math-academy-id "q-22787" :question/problem "What is the slope of the line $2x+5y=1?$" :question/worked-solution "We can find the slope of the line if we can express its equation in slope-intercept form. To do this, we solve for $y,$ as follows:\n\n$$\n\\begin{aligned}2x+5y & =1 \\\\ 5y & =-2x+1 \\\\ \\frac{5y}{5} & =\\frac{-2x+1}{5} \\\\ y & =-\\frac{2x}{5}+\\frac{1}{5} \\\\ y & =-\\frac{2}{5}x+\\frac{1}{5}\\end{aligned}\n$$\n\nFrom the slope-intercept equation, we can tell that the slope of the line is $m=-\\frac{2}{5}.$"}]}
