#{[{:db/id #edb/ref 17592186179474 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179631 :knowledge-point/id #uuid "48f52c24-cd5a-5701-8ec2-1d833e87a25f" :knowledge-point/title "Finding the Slope of a Line Given Standard Form"}] :question/id #uuid "9b0cfd54-9310-59e6-91cb-5b18413ae7b3" :question/math-academy-id "e-13979" :question/problem "What is the slope of the line $4x-2y=1?$" :question/worked-solution "We can find the slope of the line if we can express its equation in slope-intercept form. To do this, we solve for $y,$ as follows:\n\n$$\n\\begin{aligned}4x-2y & =1 \\\\ -2y & =-4x+1 \\\\ 2y & =4x-1 \\\\ \\frac{2y}{2} & =\\frac{4x-1}{2} \\\\ y & =\\frac{4x}{2}-\\frac{1}{2} \\\\ y & =2x-\\frac{1}{2}\\end{aligned}\n$$\n\nFrom the slope-intercept equation, we can tell that the slope of the line is $m=2.$"}] [{:db/id #edb/ref 17592186179475 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179632 :knowledge-point/id #uuid "dd8533c7-7573-5917-b347-ce72d26a7168" :knowledge-point/title "Finding the X-Intercept of a Line"}] :question/id #uuid "d1904d74-7f31-5211-b7d4-88f4f5042d64" :question/math-academy-id "e-13982" :question/problem "Find the point where the line $4x-3y=8$ intersects the $x$-axis." :question/worked-solution "To find the $x$-intercept, we substitute $y=0$ into the equation and solve for $x.$\n\n$$\n\\eqalign{\n\t4x-3y&=8\\[5pt]\n\t4x-3(0)&=8\\[5pt]\n\t4x&=8\\[5pt]\n\t\\dfrac{4x}{4}&=\\dfrac{8}{4}\\[5pt]\n\tx&=2\n\t}\n$$\n\nTherefore, the $x$-intercept is $2,$ and we conclude that the line intersects the $x$-axis at $\\left(2,0\\right).$"}] [{:db/id #edb/ref 17592186179476 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186179633 :knowledge-point/id #uuid "ee8d9c8a-51c2-56b4-8006-e768bb7fa128" :knowledge-point/title "Finding the Y-Intercept of a Line"}] :question/id #uuid "cbfa4dda-a399-5450-bacd-7681aebceede" :question/math-academy-id "e-13986" :question/problem "Find the point where the line $5x -4y=-8$ intersects the $y$-axis." :question/worked-solution "To find the $y$-intercept, we substitute $x=0$ into the equation and solve for $y.$\n\n$$\n\\begin{aligned}5x-4y & =-8 \\\\ 5(0)-4y & =-8 \\\\ -4y & =-8 \\\\ y & =2\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $2,$ and we conclude that the line intersects the $y$-axis at $\\left(0,2\\right).$"}] [{:db/id #edb/ref 17592186501148 :knowledge-point/_questions [{:db/id #edb/ref 17592186179631 :knowledge-point/id #uuid "48f52c24-cd5a-5701-8ec2-1d833e87a25f" :knowledge-point/title "Finding the Slope of a Line Given Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d03a500-8785-5f52-84e2-8e6407cbc0e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186500623} {:answer/id #uuid "5e7bd662-05e6-581f-af3a-7be48786911f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186500661} {:answer/id #uuid "dd163c11-9dcb-537c-8b70-dfb219426fe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186500937} {:answer/id #uuid "e2671b56-6883-51bd-b23e-827785a2219c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186500947} {:answer/id #uuid "f22f87b9-a53d-5bd3-a37d-dc52887f236f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186500981}] :answer-field/correct {:answer/id #uuid "4d03a500-8785-5f52-84e2-8e6407cbc0e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186500623} :answer-field/id #uuid "2e88f775-5124-5595-81f7-76e02e56db1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501033}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1bd18cb1-6693-5a86-9b4f-9983e714337e" :question/math-academy-id "q-128961" :question/problem "What is the slope of the line $8x+2y=-7?$" :question/worked-solution "We can find the slope of the line if we can express its equation in slope-intercept form. To do this, we solve for $y,$ as follows:\n\n$$\n\\begin{aligned}8x+2y & =-7 \\\\ 2y & =-8x-7 \\\\ \\frac{2y}{2} & =\\frac{-8x-7}{2} \\\\ y & =\\frac{-8x}{2}-\\frac{7}{2} \\\\ y & =-4x-\\frac{7}{2}\\end{aligned}\n$$\n\nFrom the slope-intercept equation, we can tell that the slope of the line is $m=-4.$"}] [{:db/id #edb/ref 17592186501136 :knowledge-point/_questions [{:db/id #edb/ref 17592186179633 :knowledge-point/id #uuid "ee8d9c8a-51c2-56b4-8006-e768bb7fa128" :knowledge-point/title "Finding the Y-Intercept of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d8f3d82-0498-5a55-931d-cbac55bac592" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{9}{7})" :db/id #edb/ref 17592186500562} {:answer/id #uuid "461e9d47-6016-588f-95e0-59a62b3e303e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-\\frac{7}{9})" :db/id #edb/ref 17592186500605} {:answer/id #uuid "5cbe7e37-8cc3-50a4-8860-b2c42a251536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\frac{3}{7})" :db/id #edb/ref 17592186500659} {:answer/id #uuid "b7b2eeb0-d692-5c4c-acff-c1fcbffa65ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-3)" :db/id #edb/ref 17592186500849} {:answer/id #uuid "f9f130d8-83da-5f6d-9f15-b95316a902c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-\\frac{7}{3})" :db/id #edb/ref 17592186501001}] :answer-field/correct {:answer/id #uuid "f9f130d8-83da-5f6d-9f15-b95316a902c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-\\frac{7}{3})" :db/id #edb/ref 17592186501001} :answer-field/id #uuid "c5e80aea-a97f-5693-b2a9-02c0460549ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501109}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00f5442f-d34a-5776-aee4-863c683c730e" :question/math-academy-id "q-128989" :question/problem "Find the point where the line $9x-3y=7$ intersects the $y$-axis." :question/worked-solution "To find the $y$-intercept, we substitute $x=0$ into the equation and solve for $y.$\n\n$$\n\\begin{aligned}9x-3y & =7 \\\\ 9(0)-3y & =7 \\\\ -3y & =7 \\\\ y & =-\\frac{7}{3}\\end{aligned}\n$$\n\nHence, the $y$-intercept is $-\\frac{7}{3}.$ Thus, the line intersects the $y$-axis at $(0,-\\frac{7}{3}).$"}] [{:db/id #edb/ref 17592186501237 :knowledge-point/_questions [{:db/id #edb/ref 17592186179633 :knowledge-point/id #uuid "ee8d9c8a-51c2-56b4-8006-e768bb7fa128" :knowledge-point/title "Finding the Y-Intercept of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022a16c4-7592-5524-b0e3-a730902b9758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186500473} {:answer/id #uuid "4d63675b-7f0b-5818-b0a6-4be7efaaa096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186500624} {:answer/id #uuid "a4d30050-abdc-538c-9e28-52b6bd93941b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186500801} {:answer/id #uuid "ba165341-da74-5561-af9d-7787d99f82fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186500855} {:answer/id #uuid "db7