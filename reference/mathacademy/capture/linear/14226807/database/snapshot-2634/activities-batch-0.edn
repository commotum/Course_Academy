#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186097419} :activity/id #uuid "a08f28ad-f5a0-5009-8802-2bc2d37a5e98" :activity/scope {:db/id #edb/ref 17592186050690 :topic/id #uuid "5f59a4ad-6d31-5757-be65-f24e070b2c60" :topic/math-academy-id 1116} :activity/steps [{:db/id #edb/ref 17592186097419 :step/content {:db/id #edb/ref 17592186097816 :tutorial/content "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\dfrac{\\textrm{d}}{ \\textrm{d} x}\\left( \\ln x \\right)= \\dfrac{1}{x}\n$$\n\nWe'll prove this result in a future lesson." :tutorial/id #uuid "b1f46211-3766-53d0-bcc7-30bb9056b948" :tutorial/math-academy-id 2615 :tutorial/title "Introduction"} :step/id #uuid "c57de084-771c-5781-b9e0-8c1803097cbb" :step/math-academy-id 12313 :step/next {:db/id #edb/ref 17592186097420}} {:db/id #edb/ref 17592186097420 :step/content {:db/id #edb/ref 17592186096613 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096413 :question/id #uuid "6624681a-bb00-59db-8df9-4d5a3cd00434" :question/math-academy-id "e-3627"} :knowledge-point/id #uuid "a71301e9-bc7f-53b9-900e-c3bd37f96b03" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932}] :knowledge-point/question-generator {:db/id #edb/ref 17592186481493} :knowledge-point/questions [{:db/id #edb/ref 17592186097021} {:db/id #edb/ref 17592186097022} {:db/id #edb/ref 17592186233897} {:db/id #edb/ref 17592186234288} {:db/id #edb/ref 17592186237851} {:db/id #edb/ref 17592186237852} {:db/id #edb/ref 17592186297307} {:db/id #edb/ref 17592186314887} {:db/id #edb/ref 17592186314888} {:db/id #edb/ref 17592186481489} {:db/id #edb/ref 17592186526014} {:db/id #edb/ref 17592186526101}] :knowledge-point/title "Differentiating the Product of a Constant and the Natural Logarithm Function"} :step/id #uuid "b0bc4f64-4ed3-59b3-8f89-94255173749b" :step/math-academy-id 12314 :step/next {:db/id #edb/ref 17592186097421}} {:db/id #edb/ref 17592186097421 :step/content {:db/id #edb/ref 17592186096614 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096414 :question/id #uuid "58d47fb0-cf75-58c4-8eea-f3ae97333159" :question/math-academy-id "e-3628"} :knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/questions [{:db/id #edb/ref 17592186097156} {:db/id #edb/ref 17592186097157} {:db/id #edb/ref 17592186233262} {:db/id #edb/ref 17592186233899} {:db/id #edb/ref 17592186237853} {:db/id #edb/ref 17592186253547} {:db/id #edb/ref 17592186297308} {:db/id #edb/ref 17592186314910} {:db/id #edb/ref 17592186314911} {:db/id #edb/ref 17592186314912} {:db/id #edb/ref 17592186401627} {:db/id #edb/ref 17592186526008}] :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"} :step/id #uuid "f8894432-f206-54fd-8d25-0650b8854e56" :step/math-academy-id 12315 :step/next {:db/id #edb/ref 17592186097422}} {:db/id #edb/ref 17592186097422 :step/content {:db/id #edb/ref 17592186097817 :tutorial/content "For a general logarithm of base $a,$ the derivative is given by\n\n$$\n\\dfrac{\\textrm{d}}{ \\textrm{d} x}\\left( \\log_a x \\right)= \\dfrac{1}{x\\ln a}.\n$$\n\nAlso, recall that whenever $\\log$ is written without a base, we can assume that it represents the base $10.$ So, we have\n\n$$\n\\log x =  \\log_{10} x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{d}{dx}(\\operatorname{log}⁡x) & =\\frac{d}{dx}({log}_{10}⁡x)=\\frac{1}{x\\operatorname{ln}⁡10}.\\end{aligned}\n$$\n\n**Note:** To see where this rule comes from, we can use the change-of-base formula as shown below.\n\n$$\n\\log_a x = \\dfrac{\\ln x}{\\ln a}\n$$\n\nTaking the derivative and using the fact that $\\ln a$ is a constant, then, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡a}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡a}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x) \\\\  & =\\frac{1}{\\operatorname{ln}⁡a}\\cdot \\frac{1}{x} \\\\  & =\\frac{1}{x\\operatorname{ln}⁡a}.\\end{aligned}\n$$" :tutorial/id #uuid "7a7450e4-ec0e-5a5e-9c86-9430eb889be7" :tutorial/math-academy-id 2616 :tutorial/title "Differentiating a Logarithmic Function with a General Base"} :step/id #uuid "50c40528-51c7-55e5-8f01-7af56b1066fc" :step/math-academy-id 12316 :step/next {:db/id #edb/ref 17592186097423}} {:db/id #edb/ref 17592186097423 :step/content {:db/id #edb/ref 17592186096615 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096415 :question/id #uuid "f61ac550-d62c-558f-b6d5-0d4c9aba8089" :question/math-academy-id "e-3629"} :knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7" :knowledge-point/question-generator {:db/id #edb/ref 17592186481488} :knowledge-point/questions [{:db/id #edb/ref 17592186097018} {:db/id #edb/ref 17592186097019} {:db/id #edb/ref 17592186233051} {:db/id #edb/ref 17592186233900} {:db/id #edb/ref 17592186233901} {:db/id #edb/ref 17592186241022} {:db/id #edb/ref 17592186253529} {:db/id #edb/ref 17592186287936} {:db/id #edb/ref 17592186297309} {:db/id #edb/ref 17592186314898} {:db/id #edb/ref 17592186314913} {:db/id #edb/ref 17592186314914} {:db/id #edb/ref 17592186481479} {:db/id #edb/ref 17592186481480} {:db/id #edb/ref 17592186481483} {:db/id #edb/ref 17592186481484} {:db/id #edb/ref 17592186526083}] :knowledge-point/title "Differentiating a Logarithmic Function With a General Base"} :step/id #uuid "386f854e-f0f4-5871-a66f-7812d943cd5f" :step/math-academy-id 12317 :step/next {:db/id #edb/ref 17592186097424}} {:db/id #edb/ref 17592186097424 :step/content {:db/id #edb/ref 17592186096616 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096416 :question/id #uuid "5eaa00f8-0fd0-5de6-a7c0-965db6de3a5c" :question/math-academy-id "e-3630"} :knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050711}] :knowledge-point/question-generator {:db/id #edb/ref 17592186480730} :knowledge-point/