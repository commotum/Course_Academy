#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186547112} :activity/id #uuid "a5f48c28-a90a-5826-83d5-d9daf3f2f41b" :activity/scope {:db/id #edb/ref 17592186050690 :topic/id #uuid "5f59a4ad-6d31-5757-be65-f24e070b2c60" :topic/math-academy-id 1116} :activity/steps [{:db/id #edb/ref 17592186547085 :step/content {:db/id #edb/ref 17592186547067 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d32edabb-91fd-5a5c-9e67-a4e4b7b77dbf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1+6\\ln 3" :db/id #edb/ref 17592186546717}] :answer-field/correct {:db/id #edb/ref 17592186546717} :answer-field/id #uuid "4e8e3638-67f3-58d9-93f9-3c0a5190ed16" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546860}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e2977b6b-7b41-5dba-a0b9-9d44c80b37c2" :question/math-academy-id "q-340103" :question/problem "Given the function  $y=\\operatorname{ln}⁡x+2\\cdot {3}^{x}-1$, find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x+2\\cdot {3}^{x}-1) \\\\  & =\\frac{1}{x}+2\\cdot {3}^{x}\\operatorname{ln}⁡(3).\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{1}{x}+2\\cdot {3}^{x}\\operatorname{ln}⁡(3))|}_{x=1} \\\\  & =\\frac{1}{1}+2\\cdot {3}^{1}\\operatorname{ln}⁡(3) \\\\  & =1+6\\operatorname{ln}⁡(3)\\,.\\end{aligned}\n$$"} :step/id #uuid "022a5585-d56d-5d96-a491-516934e44cec"} {:db/id #edb/ref 17592186547112 :step/content {:db/id #edb/ref 17592186547011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fa57cc0-2c75-5aeb-aa4c-fd8435058a21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x\\operatorname{ln}⁡5}" :db/id #edb/ref 17592186546395} {:answer/id #uuid "4395965f-6000-5eb9-b9e6-b1775cbf5929" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{x}" :db/id #edb/ref 17592186546404} {:answer/id #uuid "745dc55c-39f6-5188-893e-9e3610df2015" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x\\operatorname{ln}⁡5}+\\frac{1}{x}" :db/id #edb/ref 17592186546508} {:answer/id #uuid "ad695ffc-4f3a-5a92-ab02-41059e526392" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x}" :db/id #edb/ref 17592186546638} {:answer/id #uuid "da5cda44-a757-5b8c-8598-b4c7d9c5616f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{x\\operatorname{ln}⁡5}+\\frac{5}{x}" :db/id #edb/ref 17592186546733}] :answer-field/correct {:db/id #edb/ref 17592186546733} :answer-field/id #uuid "9d79f823-7d5d-51a6-84fc-0f83ec6272a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186546895}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5f56c11c-a25d-5517-9da3-7d7d6457fb75" :question/math-academy-id "q-1929" :question/problem "Find ${f}^{′}(x)$ for $f(x)={log}_{5}⁡x+5\\operatorname{ln}⁡x.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({log}_{5}⁡x+5\\operatorname{ln}⁡x) \\\\  & =\\frac{1}{x\\operatorname{ln}⁡5}+5(\\frac{1}{x}) \\\\  & =\\frac{1}{x\\operatorname{ln}⁡5}+\\frac{5}{x}.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "52d24250-13c5-5a58-b409-7dc9b4086b72" :step/next {:db/id #edb/ref 17592186547128}} {:db/id #edb/ref 17592186547128 :step/content {:db/id #edb/ref 17592186547029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b82f47ce-2a1a-54d9-910c-89e3281c9d96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+3e" :db/id #edb/ref 17592186546663}] :answer-field/correct {:db/id #edb/ref 17592186546663} :answer-field/id #uuid "a2358ea3-5164-5a96-8a75-9e3a351c0de6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546902}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "87c3de01-5d96-5716-bf8b-2cb387f1c8ec" :question/math-academy-id "q-340017" :question/problem "Given the function $y=2\\operatorname{ln}⁡x+3{e}^{x},$ the slope of the tangent line at $x=1$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}⁡x+3{e}^{x}) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)+3\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =2\\cdot \\frac{1}{x}+3{e}^{x} \\\\  & =\\frac{2}{x}+3{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{2}{x}+3{e}^{x})|}_{x=1} \\\\  & =\\frac{2}{1}+3{e}^{1} \\\\  & =2+3e\\,.\\end{aligned}\n$$"} :step/id #uuid "96ed02b0-ade6-5327-846d-4799bbb19082" :step/next {:db/id #edb/ref 17592186547085}}] :activity/title "Differentiating Logarithmic Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186546248}]}
