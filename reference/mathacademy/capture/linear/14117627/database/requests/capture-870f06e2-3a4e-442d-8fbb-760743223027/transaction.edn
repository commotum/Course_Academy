}\\,10)$ $\\,✓$\n\n- $-4\\in [6]_{10}$ because $-4≡6\\,(\\text{mod}\\,10)$ $\\,✓$\n\nTherefore, the correct answer is \"II and III only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-abdf5568-4325-50d1-b367-2f8fd167e6e1"] :db/ensure [:question/validate]} {:db/id "answer-field-abdf5568-4325-50d1-b367-2f8fd167e6e1" :answer-field/id #uuid "abdf5568-4325-50d1-b367-2f8fd167e6e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0c1d27f5-2dd8-5ee0-9c85-fa2aafc19456" :answer-field/choices ["answer-d4ca8877-62b9-5e77-9a0b-f311eb33c385" "answer-d3d30caf-3e16-5777-b064-513d0c56a4fe" "answer-5a19bf7b-22db-564c-aa73-f6a7de2af57f" "answer-82922433-61e5-5a62-9698-a3b819a7b545" "answer-0c1d27f5-2dd8-5ee0-9c85-fa2aafc19456"] :db/ensure [:answer-field/validate]} {:db/id "answer-d4ca8877-62b9-5e77-9a0b-f311eb33c385" :answer/id #uuid "d4ca8877-62b9-5e77-9a0b-f311eb33c385" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-d3d30caf-3e16-5777-b064-513d0c56a4fe" :answer/id #uuid "d3d30caf-3e16-5777-b064-513d0c56a4fe" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-5a19bf7b-22db-564c-aa73-f6a7de2af57f" :answer/id #uuid "5a19bf7b-22db-564c-aa73-f6a7de2af57f" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-82922433-61e5-5a62-9698-a3b819a7b545" :answer/id #uuid "82922433-61e5-5a62-9698-a3b819a7b545" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-0c1d27f5-2dd8-5ee0-9c85-fa2aafc19456" :answer/id #uuid "0c1d27f5-2dd8-5ee0-9c85-fa2aafc19456" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "question-6ec8e64f-343c-590b-a372-9757c285ca4e" :question/id #uuid "6ec8e64f-343c-590b-a372-9757c285ca4e" :question/math-academy-id "q-86036" :question/problem "If $[a]_{n}$ denotes the residue class containing all integers congruent to $a$ modulo $n,$ then $[-17]_{8}=$" :question/worked-solution "We have $[a]_{8}=[b]_{8}$ if \n\n$$\na≡b\\,(\\text{mod}\\,8).\n$$\n\nThe residue class $[-17]_{8}$ consists of the elements that are congruent to $-17$ modulo $8.$ \n\nWe can find an alternative representation for this residue class as follows:\n\n$$\n\\begin{aligned}[-17]_{8} & ={x\\in Z\\,|\\,x≡-17\\,(\\text{mod}\\,8)} \\\\  & ={x\\in Z\\,|\\,x≡(-3)\\cdot 8+7\\,(\\text{mod}\\,8)} \\\\  & ={x\\in Z\\,|\\,x≡(-3)\\cdot 0+7\\,(\\text{mod}\\,8)} \\\\  & ={x\\in Z\\,|\\,x≡7\\,(\\text{mod}\\,8)} \\\\  & =[7]_{8}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3e9185ce-04ca-55c2-af57-843e245f78f1"] :db/ensure [:question/validate]} {:db/id "answer-field-3e9185ce-04ca-55c2-af57-843e245f78f1" :answer-field/id #uuid "3e9185ce-04ca-55c2-af57-843e245f78f1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bdd8e295-33c6-5090-a009-cc99ac910e2c" :answer-field/choices ["answer-27688b77-7614-53b0-b9de-691d92f763c7" "answer-0df4bc86-a08e-53e9-853a-99dcf0b0d931" "answer-00a7f57a-39bb-5222-8123-e37237239995" "answer-73b4cec7-d2ce-5479-8f22-01a6924bb563" "answer-bdd8e295-33c6-5090-a009-cc99ac910e2c"] :db/ensure [:answer-field/validate]} {:db/id "answer-27688b77-7614-53b0-b9de-691d92f763c7" :answer/id #uuid "27688b77-7614-53b0-b9de-691d92f763c7" :answer/type :answer.type/math :answer/value "[3]_{8}" :db/ensure [:answer/validate]} {:db/id "answer-0df4bc86-a08e-53e9-853a-99dcf0b0d931" :answer/id #uuid "0df4bc86-a08e-53e9-853a-99dcf0b0d931" :answer/type :answer.type/math :answer/value "[4]_{8}" :db/ensure [:answer/validate]} {:db/id "answer-00a7f57a-39bb-5222-8123-e37237239995" :answer/id #uuid "00a7f57a-39bb-5222-8123-e37237239995" :answer/type :answer.type/math :answer/value "[5]_{8}" :db/ensure [:answer/validat