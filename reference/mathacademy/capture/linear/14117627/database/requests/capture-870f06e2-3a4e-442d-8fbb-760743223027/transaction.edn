swer-3a9a1c5c-d379-566e-88ec-4f742d23a956" :answer/id #uuid "3a9a1c5c-d379-566e-88ec-4f742d23a956" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-d5516742-1e80-5031-a6c5-e5f0e763ef73" :answer/id #uuid "d5516742-1e80-5031-a6c5-e5f0e763ef73" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-ef8754b8-9881-5ed1-bb9f-dc739076a719" :answer/id #uuid "ef8754b8-9881-5ed1-bb9f-dc739076a719" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-3cdd9f0e-932d-558a-9378-6f478cae4f32" :answer/id #uuid "3cdd9f0e-932d-558a-9378-6f478cae4f32" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-d3abf09a-f4e8-5b21-bd9a-3231221ada27" :answer/id #uuid "d3abf09a-f4e8-5b21-bd9a-3231221ada27" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "question-9c32efaa-b6d9-5d28-a23f-80c818eab9ef" :question/id #uuid "9c32efaa-b6d9-5d28-a23f-80c818eab9ef" :question/math-academy-id "q-86031" :question/problem "Which of the following residue classes modulo $7$ contain the integer $-2?$\n\n- $[1]_{7}$\n- $[5]_{7}$\n- $[-9]_{7}$" :question/worked-solution "We have $-2\\in [a]_{7}$ if \n\n$$\n-2≡a\\,(\\text{mod}\\,7).\n$$\n\nLet's now consider each of the given equivalence classes.\n\n- $-2\\notin [1]_{7}$ because $-2≢1\\,(\\text{mod}\\,7)$ $\\,\\times $\n\n- $-2\\in [5]_{7}$ because $-2≡5\\,(\\text{mod}\\,7)$ $\\,✓$\n\n- $-2\\in [-9]_{7}$ because $-2≡-9\\,(\\text{mod}\\,7)$ $\\,✓$\n\nTherefore, the correct answer is \"II and III only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5decdc62-7308-5512-b750-a161dcc81e38"] :db/ensure [:question/validate]} {:db/id "answer-field-5decdc62-7308-5512-b750-a161dcc81e38" :answer-field/id #uuid "5decdc62-7308-5512-b750-a161dcc81e38" :answer-field/key "s