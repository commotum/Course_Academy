,\\,…,\\,[n-1]_{n}}\n$$\n\nTherefore, we have the following properties:\n\n- ${⋃}_{i=0}^{222}\\,[\\,i\\,]_{223}=Z$\n\n- $[\\,21\\,]_{223}\\cap [\\,162\\,]_{223}=∅$\n\n- ${Z}_{223}={[\\,i\\,]_{223}\\,∣\\,0\\le i<223}$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-4f4cb6bf-eef4-5522-ab9f-aa416473d332" "answer-field-de87570e-027c-5793-8ab4-4ef500f5c61e" "answer-field-a19c0d67-49a9-5396-a5d9-875a393bad93" "answer-field-16083492-fd9b-5d22-9677-01e13fa89587" "answer-field-ae09813e-0082-59a4-bfd4-f9cf6d8fed47" "answer-field-1fc12673-6217-5e3a-9852-9f90fda3ba34" "answer-field-f042c4a1-bf4e-5f20-88b6-741622023fc2"] :db/ensure [:question/validate]} {:db/id "answer-field-4f4cb6bf-eef4-5522-ab9f-aa416473d332" :answer-field/id #uuid "4f4cb6bf-eef4-5522-ab9f-aa416473d332" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-b8c02b19-356d-5319-9743-657760c26d97" :answer-field/choices ["answer-06a4101a-d7b3-5462-979c-883171d6ebfc" "answer-b8c02b19-356d-5319-9743-657760c26d97"] :db/ensure [:answer-field/validate]} {:db/id "answer-06a4101a-d7b3-5462-979c-883171d6ebfc" :answer/id #uuid "06a4101a-d7b3-5462-979c-883171d6ebfc" :answer/type :answer.type/math :answer/value "{⋃}_{i=0}^{221}" :db/ensure [:answer/validate]} {:db/id "answer-b8c02b19-356d-5319-9743-657760c26d97" :answer/id #uuid "b8c02b19-356d-5319-9743-657760c26d97" :answer/type :answer.type/math :answer/value "{⋃}_{i=0}^{222}" :db/ensure [:answer/validate]} {:db/id "answer-field-de87570e-027c-5793-8ab4-4ef500f5c61e" :answer-field/id #uuid "de87570e-027c-5793-8ab4-4ef500f5c61e" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-19679b71-8be1-5ef4-8058-da70b90df205" :answer-field/choices ["answer-f166d264-b5b1-54b7-be8d-573f1d63094f" "answer-19679b71-8be1-5ef4-8058-da70b90df205" "answer-cf4019b4-8fa7-5c07-ae40-232d5afcd79a"] :db/ensure [:answer-field/validate]} {:db/id "answer-f166d264-b