#{[{:db/id #edb/ref 17592186138297 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138385 :knowledge-point/id #uuid "a962db4f-c6bf-5631-95b2-c7f42b1236d6" :knowledge-point/title "Factoring Biquadratic Expressions as Perfect Squares"}] :question/id #uuid "15bbccd7-d0ce-50bb-80bb-777b5d0a7245" :question/math-academy-id "e-4360" :question/problem "Factor $x^4-4x^2+4$." :question/worked-solution "We can introduce a new variable $z=x^2$ and then rewrite the trinomial as a quadratic in terms of $z$:\n\n$$\n\\begin{aligned}\nx^{4} - 4x^{2} + 4 &=  \\\\\n(x^{2})^{2} - 4(x^{2}) + 4 &=  \\\\\n&= z^{2} - 4z + 4\n\\end{aligned}\n$$\n\nNow, we can factor the quadratic as the square of a difference, and then rewrite the final expression in terms of $x$:\n\n$$\n\\begin{aligned}\nz^{2} - 4z + 4 &=  \\\\\n(z - 2)^{2} &=  \\\\\n&= (x^{2} - 2)^{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186138304 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138411 :knowledge-point/id #uuid "ee76fa0d-93f1-5b0b-b9e4-4c081741078e" :knowledge-point/title "Factoring Biquadratic Expressions as Quadratic Trinomials"}] :question/id #uuid "12f9f52c-0baa-557b-83b7-d80c8a34c409" :question/math-academy-id "e-5018" :question/problem "Factor $t^4 - t^2 - 2$." :question/worked-solution "We can introduce a new variable $z = t^2$ and then rewrite the trinomial as a quadratic in terms of $z$:\n\n$$\n\\begin{aligned}\nt^{4} - t^{2} - 2 &=  \\\\\n(t^{2})^{2} - t^{2} - 2 &=  \\\\\n&= z^{2} - z - 2\n\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $t$:\n\n$$\n\\begin{aligned}\nz^{2} - z - 2 &=  \\\\\n(z + 1)(z - 2) &=  \\\\\n&= (t^{2} + 1)(t^{2} - 2)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186138305 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138412 :knowledge-point/id #uuid "e836ca22-abd9-5812-bbf7-3b057e3d6c4b" :knowledge-point/title "Factoring Biquadratic Expressions as Quadratic Trinomials With Leading Coefficients"}] :question/id #uuid "f503abb5-10a5-56bf-b07b-7ebe1ed04049" :question/math-academy-id "e-5019" :question/problem "Factor $2p^4 + 5p^2 + 3$." :question/worked-solution "We can introduce a new variable $t = p^2$ and then rewrite the trinomial as a quadratic in terms of $t$:\n\n$$\n\\begin{aligned}\n2p^{4} + 5p^{2} + 3 &=  \\\\\n2(p^{2})^{2} + 5p^{2} + 3 &=  \\\\\n&= 2t^{2} + 5t + 3\n\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $p$:\n\n$$\n\\begin{aligned}\n2t^{2} + 5t + 3 &=  \\\\\n(t + 1)(2t + 3) &=  \\\\\n&= (p^{2} + 1)(2p^{2} + 3)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186139168 :knowledge-point/_questions [{:db/id #edb/ref 17592186138411 :knowledge-point/id #uuid "ee76fa0d-93f1-5b0b-b9e4-4c081741078e" :knowledge-point/title "Factoring Biquadratic Expressions as Quadratic Trinomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98f16705-5a56-55bf-bd9a-f69755682eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2} + 2)(x^{2} - 3)" :db/id #edb/ref 17592186137957} {:answer/id #uuid "ee4511f6-9e9b-5e56-968a-9865b3491da0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2} - 2)(x^{2} + 3)" :db/id #edb/ref 17592186137958} {:answer/id #uuid "3ea2da97-6ba8-5998-8c6e-48afb86b4a84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x^{2} - 2)(x^{2} - 3)" :db/id #edb/ref 17592186137959} {:answer/id #uuid "5decf630-df70-555c-84db-ef44a7b8f169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x - 2)(x + 3)" :db/id #edb/ref 17592186137960} {:answer/id #uuid "75664cbd-813d-5ecc-923a-343e8504658f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x + 2)(x - 3)" :db/id #edb/ref 17592186137961}] :answer-field/id #uuid "545c0cdb-a270-5833-8eb2-8fcba0f8f682" :answer-field/