 :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186476729}] :answer-field/correct {:answer/id #uuid "79c62a52-438b-5e92-ac3c-f33a5c6b7310" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6}{7}" :db/id #edb/ref 17592186476474} :answer-field/id #uuid "9b41596b-ac3f-54ae-b6c0-acf538414639" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476822}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7e8f9822-aefa-57f0-9acd-f132c358e3dc" :question/math-academy-id "q-99612" :question/problem "$\\sqrt[3]{-\\frac{216}{343}}=$" :question/worked-solution "First, we rewrite the fraction under the radical as follows:\n\n$$\n\\sqrt[3]{-\\frac{216}{343}}=\\sqrt[3]{\\frac{(-216)}{343}}\n$$\n\nThe cube root of a quotient of two numbers is equal to the quotient of the cube roots of the numbers. Therefore,\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{(-216)}{343}} & =\\frac{\\sqrt[3]{-216}}{\\sqrt[3]{343}} \\\\  & =\\frac{-6}{7} \\\\  & =-\\frac{6}{7}\\,.\\end{aligned}\n$$"}]}
