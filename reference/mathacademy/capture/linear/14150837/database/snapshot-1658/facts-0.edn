f 1068 #edb/ref 17592186446142 #edb/ref 17592186045417] [17592186446150 #edb/ref 1069 "q-52868" #edb/ref 17592186045417] [17592186446150 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186446150 #edb/ref 1071 "![](images/53/5349fd8cce4fc4c31f4ddf54616158cc9bc1755b78011bdbc699fd5253524382.png)\n\nFind the length of the line segment $\\overset{―}{AB}$ shown above." #edb/ref 17592186045417] [17592186446150 #edb/ref 1072 #uuid "41aa9532-ccbf-54f2-a095-f66029205574" #edb/ref 17592186045417] [17592186446150 #edb/ref 1074 "To find the length, we read the values that correspond to the points $A$ and $B$ and take the difference.\n\nFrom the diagram, we see that $A$ corresponds to $-4$ units while $B$ corresponds to $1$ units.\n\nTherefore, we conclude that \n\n$$\nAB=1-(-4)=5\\,\\text{units}.\n$$" #edb/ref 17592186045417] [17592186446151 #edb/ref 1068 #edb/ref 17592186446146 #edb/ref 17592186045417] [17592186446151 #edb/ref 1069 "q-20579" #edb/ref 17592186045417] [17592186446151 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186446151 #edb/ref 1071 "![](images/ba/ba75204629bffa2aea805fa09cd3b5bd01c24f28edd7ba7d154b93fa9b16e5a0.png)\n\nFor the figure shown above, how many line segments are there?" #edb/ref 17592186045417] [17592186446151 #edb/ref 1072 #uuid "718c9427-3023-5517-97ab-03ae81fa561f" #edb/ref 17592186045417] [17592186446151 #edb/ref 1074 "From the diagram, we can count $6$ line segments:\n$\\overset{―}{PQ}$ , $\\overset{―}{PR}$, $\\overset{―}{PS}$ , $\\overset{―}{QR}$ , $\\overset{―}{QS}$, $\\overset{―}{RS}.$" #edb/ref 17592186045417] [17592186446152 #edb/ref 1068 #edb/ref 17592186446144 #edb/ref 17592186045417] [17592186446152 #edb/ref 1069 "q-53112" #edb/ref 17592186045417] [17592186446152 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186446152 #edb/ref 1071 "![](images/03/033a552ea0d8d76033a8701e4cfe5cbbb8009f18a9329406722e70e498310448.png)\n\nFind the length of the line segment $\\overset{―}{AB}$ shown above." #edb/ref 17592186045417] [17592186446152 #edb/ref 1072 #uuid "751ce1db-dc08-51e0-8ae8-024841607cc5" #edb/ref 17592186045417] [17592186446152 #edb/ref 1074 "To find the length, we read the values that correspond to the points $A$ and $B$ and take the difference.\n\nFrom the diagram, we see that $A$ corresponds to $-12$ units while $B$ corresponds to $-5$ units.\n\nTherefore, we conclude that \n\n$$\nAB=-5-(-12)=7\\,\\text{units}.\n$$" #edb/ref 17592186045417] [17592186446153 #edb/ref 1068 #edb/ref 17592186446140 #edb/ref 17592186045417] [17592186446153 #edb/ref 1069 "q-67642" #edb/ref 17592186045417] [17592186446153 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186446153 #edb/ref 1071 "![](images/d6/d67e2cb1a53f6063cf798294cbf077729bb3cf3621ba242325129b81dfe6c791.png)\n\nWhat is the measure of the line segment $\\overset{―}{AB}$ shown above?" #edb/ref 17592186045417] [17592186446153 #edb/ref 1072 #uuid "b6e9a199-9ae7-5749-8e50-9bec321630b9" #edb/ref 17592186045417] [17592186446153 #edb/ref 1074 "Note that the length of a side of one cell is \n\n$$\n\\frac{6\\,\\text{m}}{3}=2\\,\\text{m}.\n$$\n\nThe line segment has a length of $6$ cells, hence the total measure is \n\n$$\nAB=6\\cdot 2\\,\\text{m}=12\\,\\text{m}.\n$$" #edb/ref 17592186045417] [17592186446154 #edb/ref 1068 #edb/ref 17592186446145 #edb/ref 17592186045417] [17592186446154 #edb/ref 1069 "q-53228" #edb/ref 17592186045417] [17592186446154 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186446154 #edb/ref 1071 "Which of the following pictures shows a line segment of $7.5\\,\\text{cm}$ long?" #edb/ref 17592186045417] [17592186446154 #edb/ref 1072 #uuid "f3042f6b-9d86-5ac2-aea7-7fc852598853" #edb/ref 17592186045417] [17592186446154 #edb/ref 1074 "Note that one of the points of each segment is aligned with the zero-mark on the ruler.\n\nWe will use the rulers to determine which segment has a length of $7.5\\,\\text{cm}.$ To do this, we need to find a p