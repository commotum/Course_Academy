/id #uuid "e96f0d4d-c50a-5397-b977-dc8aea56fbc7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0116267a-587a-59de-84d1-6ba467b65702" :answer-field/choices ["answer-0116267a-587a-59de-84d1-6ba467b65702" "answer-23848e56-6172-5215-a36c-6b695ce1631c" "answer-dd82655e-5239-5814-8fad-6e29f4b3fccd" "answer-0f3613bc-9742-5631-8d02-060c3a922a0e" "answer-4d405620-c6e1-5f40-949b-e1a20e883d48"] :db/ensure [:answer-field/validate]} {:db/id "answer-0116267a-587a-59de-84d1-6ba467b65702" :answer/id #uuid "0116267a-587a-59de-84d1-6ba467b65702" :answer/type :answer.type/image :answer/value "images/39/392b3af6a2e540510c8bb19350226faebe2d2a6183da015473ba5379a8a92d5d.png" :db/ensure [:answer/validate]} {:db/id "answer-23848e56-6172-5215-a36c-6b695ce1631c" :answer/id #uuid "23848e56-6172-5215-a36c-6b695ce1631c" :answer/type :answer.type/image :answer/value "images/3e/3eb6873410aad7b40e0d4264f3f8b5decfd7d12ee669f2f33e57809c15ba891e.png" :db/ensure [:answer/validate]} {:db/id "answer-dd82655e-5239-5814-8fad-6e29f4b3fccd" :answer/id #uuid "dd82655e-5239-5814-8fad-6e29f4b3fccd" :answer/type :answer.type/image :answer/value "images/50/5082919b9603186c3de8c64a98b447890978d3bda0f83a6c89869b2dec5e50bf.png" :db/ensure [:answer/validate]} {:db/id "answer-0f3613bc-9742-5631-8d02-060c3a922a0e" :answer/id #uuid "0f3613bc-9742-5631-8d02-060c3a922a0e" :answer/type :answer.type/image :answer/value "images/7e/7e1e4e275358615bc16f935b940647936ee3aacebc37159722fe66f4e76111d2.png" :db/ensure [:answer/validate]} {:db/id "answer-4d405620-c6e1-5f40-949b-e1a20e883d48" :answer/id #uuid "4d405620-c6e1-5f40-949b-e1a20e883d48" :answer/type :answer.type/image :answer/value "images/db/db68c45d5b5fdbe6ffbe4edc52739c338262444088357352f001b87d0d016f99.png" :db/ensure [:answer/validate]} {:db/id "question-41aa9532-ccbf-54f2-a095-f66029205574" :question/id #uuid "41aa9532-ccbf-54f2-a095-f66029205574" :question/math-academy-id "q-52868" :question/problem "![](images/53/5349fd8cce4fc4c31f4ddf54616158cc9bc1755b78011bdbc699fd5253524382.png)\n\nFind the length of the line segment $\\overset{―}{AB}$ shown above." :question/worked-solution "To find the length, we read the values that correspond to the points $A$ and $B$ and take the difference.\n\nFrom the diagram, we see that $A$ corresponds to $-4$ units while $B$ corresponds to $1$ units.\n\nTherefore, we conclude that \n\n$$\nAB=1-(-4)=5\\,\\text{units}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d5c618e3-fe0a-5c01-b89f-d551027ff469"] :db/ensure [:question/validate]} {:db/id "answer-field-d5c618e3-fe0a-5c01-b89f-d551027ff469" :answer-field/id #uuid "d5c618e3-fe0a-5c01-b89f-d551027ff469" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6cf25686-16f3-53a3-9c89-95ed54ba0418" :answer-field/choices ["answer-3c3e7a43-7351-58ea-897a-397581d61f7e" "answer-126a485c-1c8c-5e8c-9aae-24074e1e761f" "answer-de46e48e-7e61-54b9-b89c-1fdfa9ddf9f0" "answer-6cf25686-16f3-53a3-9c89-95ed54ba0418" "answer-c92cb656-928c-5c3c-9281-be093913ab65"] :db/ensure [:answer-field/validate]} {:db/id "answer-3c3e7a43-7351-58ea-897a-397581d61f7e" :answer/id #uuid "3c3e7a43-7351-58ea-897a-397581d61f7e" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-126a485c-1c8c-5e8c-9aae-24074e1e761f" :answer/id #uuid "126a485c-1c8c-5e8c-9aae-24074e1e761f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-de46e48e-7e61-54b9-b89c-1fdfa9ddf9f0" :answer/id #uuid "de46e48e-7e61-54b9-b89c-1fdfa9ddf9f0" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-6cf25686-16f3-53a3-9c89-95ed54ba0418" :answer/id #uuid "6cf25686-16f3-53a3-9c89-95ed54ba0418" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-c92cb656-928c-5c3c-9281-be093913ab65" :answer/id #uuid "c92cb656-928c-5c3c-9281-be093913ab65" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-751ce1db-dc08-51e0-8ae8-024841607cc5" :question/id #uuid "751ce1db-dc08-51e0-8ae8-024841607cc5" :question/math-academy-id "q-53112" :question/problem "![](images/03/033a552ea0d8d76033a8701e4cfe5cbbb8009f18a9329406722e70e498310448.png)\n\nFind the length of the line segment $\\overset{―}{AB}$ shown above." :question/worked-solution "To find the length, we read the values that correspond to the points $A$ and $B$ and take the difference.\n\nFrom the diagram, we see that $A$ corresponds to $-12$ units while $B$ corresponds to $-5$ units.\n\nTherefore, we conclude that \n\n$$\nAB=-5-(-12)=7\\,\\text{units}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dd6a4017-f3dd-5174-8800-b0bd103fb0a6"] :db/ensure [:question/validate]} {:db/id "answer-field-dd6a4017-f3dd-5174-8800-b0bd103fb0a6" :answer-field/id #uuid "dd6a4017-f3dd-5174-8800-b0bd103fb0a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-131ff9d4-37af-5cae-ab2c-fe1c3304a7b5" :answer-field/choices ["answer-0c9e393a-c83f-56e2-abff-a9c32c985ab0" "answer-4b9b5f9a-9a00-59eb-8765-22f3010fe81d" "answer-131ff9d4-37af-5cae-ab2c-fe1c3304a7b5" "answer-b7d27764-b773-5676-a30c-1db792af18e3" "answer-6d75c618-fc55-55c3-a63b-4a20d102fd18"] :db/ensure [:answer-field/validate]} {:db/id "answer-0c9e393a-c83f-56e2-abff-a9c32c985ab0" :answer/id #uuid "0c9e393a-c83f-56e2-abff-a9c32c985ab0" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-4b9b5f9a-9a00-59eb-8765-22f3010fe81d" :answer/id #uuid "4b9b5f9a-9a00-59eb-8765-22f3010fe81d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-131ff9d4-37af-5cae-ab2c-fe1c3304a7b5" :answer/id #uuid "131ff9d4-37af-5cae-ab2c-fe1c3304a7b5" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-b7d27764-b773-5676-a30c-1db792af18e3" :answer/id #uuid "b7d27764-b773-5676-a30c-1db792af18e3" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-6d75c618-fc55-55c3-a63b-4a20d102fd18" :answer/id #uuid "6d75c618-fc55-55c3-a63b-4a20d102fd18" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186107042 :tutorial/content "A **line segment** is part of a line that's bounded by two points, called the **endpoints** of the segment. A line segment with endpoints $A$ and $B,$ like the one shown below, is denoted by $\\overline{AB}.$\n\n![](images/14/143f62d9a6df523ffcc0ca3dba9f52d470b5c664775156734d0f5d1329971a80.png)\n\nThe **measure** of a line segment is its length. For a line segment $\\overline{AB},$ the measure is denoted by $AB$ (with no line on top) to distinguish it from the line segment itself.\n\n**Watch out!** The line segment $\\overline{AB}$ and its measure $AB$ are *not* the same thing. The line segment $\\overline{AB}$ is a geometric object, while its measure $AB$ (with no line on top) is a number. It's similar to how a person is a physical entity, while their height is a number.\n\n**Note:** We could also express the segment as $\\overline{BA},$ switching the order of the endpoints. The notations $\\overline{BA}$ and $\\overline{AB}$ represent the same exact segment. We could also write the length of the segment as $BA$ or $AB.$" :db/ensure [:tutorial/validate]} {:db/id 17592186107096 :tutorial/content "To measure a line segment, we use a ruler as follows:\n\n1\\. Align the ruler along the line segment in such a way that one of the endpoints corresponds to the zero-mark on the ruler.\n\n  ![](images/38/3829a0acecd882720fcede59d9a916a6b4327e7bc2ee1ec3a82882e074962099.png)\n\n2\\. Read the measurements that correspond to the second endpoint of the segment.\n\n  ![](images/17/174229af901bfe61ee8e61eb2ad2a7f8338f3d6db5b9414647e4b7d037c54b42.png)\n\nGiven that this particular ruler measures length in centimeters ($\\textrm{cm}$), we conclude that\n\n$$\nAB = 5\\,\\textrm{cm}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186106006 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
