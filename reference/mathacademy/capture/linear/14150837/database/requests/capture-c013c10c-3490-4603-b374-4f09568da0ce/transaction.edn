-53ba-b903-41a8213f011c" :answer/id #uuid "af4fc513-31fa-53ba-b903-41a8213f011c" :answer/type :answer.type/math :answer/value "5\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-67589c08-6a52-5837-bacc-a5fa37b2ff7d" :answer/id #uuid "67589c08-6a52-5837-bacc-a5fa37b2ff7d" :answer/type :answer.type/math :answer/value "6\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-e30070a7-6c55-5045-806a-7cbcf56bfd7b" :answer/id #uuid "e30070a7-6c55-5045-806a-7cbcf56bfd7b" :answer/type :answer.type/math :answer/value "8\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "question-13ca1ca9-18d5-5bc5-a895-698275236baa" :question/id #uuid "13ca1ca9-18d5-5bc5-a895-698275236baa" :question/math-academy-id "q-113186" :question/problem "![](images/b9/b9e5d7d183fb090b317bd134829affc63792fbe88945941d5be1311e27751afb.png)\n\nDetermine the measure of the segment $\\overset{―}{AB}$ shown above." :question/worked-solution "Note that $A$ is not aligned with the zero-mark on the ruler. \n\nTo find the length, we read the values that correspond to the points $A$ and $B,$ and take the difference.\n\nFrom the picture, we deduce that $A$ corresponds to $2\\,\\text{in}$ while $B$ corresponds to $3.5\\,\\text{in}.$\n\nTherefore,\n\n$$\n\\begin{aligned}AB=3.5\\,\\text{in}-2\\,\\text{in}=1.5\\,\\text{in}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d8d1f117-e2ef-53ef-86d3-575132895d0f"] :db/ensure [:question/validate]} {:db/id "answer-field-d8d1f117-e2ef-53ef-86d3-575132895d0f" :answer-field/id #uuid "d8d1f117-e2ef-53ef-86d3-575132895d0f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-13ab330c-b10b-5ede-b50b-b9b2819b4f12" :answer-field/choices ["answer-13ab330c-b10b-5ede-b50b-b9b2819b4f12" "answer-5f7e780a-4216-5f56-bc95-fb5d7ee2346e" "answer-fce7b3e1-74ac-55b6-83bc-eb1b379570df" "answer-4cddb303-0487-5754-9529-4a124d16f998" "answer-3fd9caae-c795-5ecf-ac67-5e