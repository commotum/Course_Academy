#{[{:activity/first-step {:db/id #edb/ref 17592186106959} :activity/id #uuid "5348a4cf-a213-5bc7-bd08-274a7dcdf1f0" :activity/scope {:db/id #edb/ref 17592186050563 :topic/id #uuid "53e39f98-0b09-5a55-8519-b9bae786a859" :topic/math-academy-id 1379} :activity/steps [{:db/id #edb/ref 17592186106736 :step/content {:db/id #edb/ref 17592186107096 :tutorial/content "To measure a line segment, we use a ruler as follows:\n\n1. Align the ruler along the line segment in such a way that one of the endpoints corresponds to the zero-mark on the ruler.![](images/38/3829a0acecd882720fcede59d9a916a6b4327e7bc2ee1ec3a82882e074962099.png)\n2. Read the measurements that correspond to the second endpoint of the segment.![](images/17/174229af901bfe61ee8e61eb2ad2a7f8338f3d6db5b9414647e4b7d037c54b42.png)\n\nGiven that this particular ruler measures length in centimeters ($\\textrm{cm}$), we conclude that\n\n$$\nAB = 5\\,\\textrm{cm}\n$$" :tutorial/id #uuid "6ae91736-83ed-5c2c-b9b5-179470bfd5cc" :tutorial/math-academy-id 3871 :tutorial/title "Measuring a Line Segment"} :step/id #uuid "b1bb4026-1bf6-556a-9104-23a39ab6d488" :step/math-academy-id 22766 :step/next {:db/id #edb/ref 17592186106962}} {:db/id #edb/ref 17592186106959 :step/content {:db/id #edb/ref 17592186107042 :tutorial/content "A **line segment** is part of a line that's bounded by two points, called the **endpoints** of the segment. A line segment with endpoints $A$ and $B$, like the one shown below, is denoted by $\\overline{AB}$.\n\n![](images/14/143f62d9a6df523ffcc0ca3dba9f52d470b5c664775156734d0f5d1329971a80.png)\n\nThe **measure** of a line segment is its length. For a line segment $\\overline{AB}$, the measure is denoted by $AB$ (with no line on top) to distinguish it from the line segment itself.\n\n**Watch out!** The line segment $\\overline{AB}$ and its measure $AB$ are *not* the same thing. The line segment $\\overline{AB}$ is a geometric object, while its measure $AB$ (with no line on top) is a number. It's similar to how a person is a physical entity, while their height is a number.\n\n**Note:** We could also express the segment as $\\overline{BA}$, switching the order of the endpoints. The notations $\\overline{BA}$ and $\\overline{AB}$ represent the same exact segment. We could also write the length of the segment as $BA$ or $AB$." :tutorial/id #uuid "0b62e9c2-f9e6-538b-8174-4d4c72c9fde5" :tutorial/math-academy-id 2163 :tutorial/title "Introduction"} :step/id #uuid "7bad32c1-7c55-586b-9645-fae8ac8e1e19" :step/math-academy-id 8697 :step/next {:db/id #edb/ref 17592186106960}} {:db/id #edb/ref 17592186106960 :step/content {:db/id #edb/ref 17592186105926 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105521 :question/id #uuid "4349d9b1-6a58-5c35-8cc1-14526f7cea4e" :question/math-academy-id "e-2546"} :knowledge-point/id #uuid "f0aaf960-68e6-52a2-aed5-3e8cfc5c518e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049350} {:db/id #edb/ref 17592186051057}] :knowledge-point/questions [{:db/id #edb/ref 17592186106396} {:db/id #edb/ref 17592186106401}] :knowledge-point/title "Understanding Line Segment Notation"} :step/id #uuid "8fc4ddf6-def3-5f7a-8f02-d93527316b10" :step/math-academy-id 8698 :step/next {:db/id #edb/ref 17592186106961}} {:db/id #edb/ref 17592186106961 :step/content {:db/id #edb/ref 17592186105927 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105522 :question/id #uuid "cfe017f1-09b7-52c4-88aa-bd312833173d" :question/math-academy-id "e-2547"} :knowledge-point/id #uuid "5c92ac26-24aa-5b82-8689-a30b23f05bfe" :knowledge-point/questions [{:db/id #edb/ref 17592186106399} {:db/id #edb/ref 17592186106400}] :knowledge-point/title "Calculating the Measure of a Line Segment on a Grid"} :step/id #uuid "bcfcd71a-cdf1-59cb-b94c-2ea88367bf15" :step/math-academy-id 8699 :step/next {:db/id #edb/ref 17592186106736}} {:db/id #edb/ref 17592186106962 :step/content {:db/id #edb/ref 17592186105928 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105523 :question/id #uuid "b84a586f-47d6-5543-a751-f0aeaa53fd91" :question/math-academy-id "e-2549"} :knowledge-point/id #uuid "e2b7b354-5f1a-5411-8dde-4255f14b127b" :knowledge-point/questions [{:db/id #edb/ref 17592186106405} {:db/id #edb/ref 17592186106406}] :knowledge-point/title "Calculating the Measure of a Line Segment Using a Ruler"} :step/id #uuid "6ca84269-fc6b-56ac-a8d3-3e5456473482" :step/math-academy-id 8701 :step/next {:db/id #edb/ref 17592186106963}} {:db/id #edb/ref 17592186106963 :step/content {:db/id #edb/ref 17592186105929 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105524 :question/id #uuid "620afc7e-0778-5778-8130-7dbe55680002" :question/math-academy-id "e-2550"} :knowledge-point/id #uuid "4f186459-7a3c-5131-9696-5ce158911634" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049626}] :knowledge-point/questions [{:db/id #edb/ref 17592186106397} {:db/id #edb/ref 17592186106398}] :knowledge-point/title "Calculating the Measure of a Line Segment on a Number Line"} :step/id #uuid "1b23a2cd-522f-5220-a500-8b5b6a39b52b" :step/math-academy-id 8702}] :activity/title "Measures of Segments" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106006}]}
