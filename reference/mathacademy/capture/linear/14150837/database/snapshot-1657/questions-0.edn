#{[{:db/id #edb/ref 17592186105521 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105926 :knowledge-point/id #uuid "f0aaf960-68e6-52a2-aed5-3e8cfc5c518e" :knowledge-point/title "Understanding Line Segment Notation"}] :question/id #uuid "4349d9b1-6a58-5c35-8cc1-14526f7cea4e" :question/math-academy-id "e-2546" :question/problem "Suppose that a line segment has a length of $2\\,\\textrm{m}$, and that $A$ and $B$ are its endpoints. Which of the following statements are true?\n\n1. $\\overline{AB} = 2\\,\\textrm{m}$\n2. $\\overline{BA} = 2\\,\\textrm{m}$\n3. $AB = 2\\,\\textrm{m}$" :question/worked-solution "Let's check each statement in turn.\n\n- Statement I is false. The notation $\\overline{AB}$ represents the line segment itself, not the length of the line segment. Therefore, the expression ${\\overline{AB}}=2\\,\\textrm{m}$ is not valid. Instead, it should say $AB = 2 \\, \\textrm{m}$.\n- Statement II is false. Since $\\overline{BA}$ represents the line segment itself, not the length of the line segment. Therefore, the expression ${\\overline{BA}}=2\\,\\textrm{m}$ is not valid.\n- Statement III is true. The notation $AB$ represents the length of the line segment $\\overline{AB}$, and this line segments has a length of $2\\,\\textrm{m}$. Therefore,\n$AB = 2\\,\\textrm{m}$\nis a correct statement.\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186105522 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105927 :knowledge-point/id #uuid "5c92ac26-24aa-5b82-8689-a30b23f05bfe" :knowledge-point/title "Calculating the Measure of a Line Segment on a Grid"}] :question/id #uuid "cfe017f1-09b7-52c4-88aa-bd312833173d" :question/math-academy-id "e-2547" :question/problem "What is the measure of the line segment $\\overline{ML}$ shown below?\n\n![](images/59/5956f2c41cb04f89e72602ec69ab76e729a3c031bd307f31bbcc24c7f12744ba.png)" :question/worked-solution "Note that the length of a side of one cell is\n\n$$\n\\dfrac{10\\,\\textrm{mm}}{2} = 5\\,\\textrm{mm}\n$$\n\nThe line segment has a length of $7$ cells, so the total measure is\n\n$$\nML = 7 \\cdot 5\\,\\textrm{mm} = 35\\,\\textrm{mm}\n$$"}] [{:db/id #edb/ref 17592186105523 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105928 :knowledge-point/id #uuid "e2b7b354-5f1a-5411-8dde-4255f14b127b" :knowledge-point/title "Calculating the Measure of a Line Segment Using a Ruler"}] :question/id #uuid "b84a586f-47d6-5543-a751-f0aeaa53fd91" :question/math-academy-id "e-2549" :question/problem "The ruler shown below allows measuring length both in $\\textrm{cm}$ (centimeters) and $\\textrm{in}$ (inches). Determine the measure of the line segment $\\overline{MN}$.\n\n![](images/e1/e1d80c4344e4051f1b58a8c7ec1db9930f06d679c1a0532e83bfc7bdb719c4c1.png)" :question/worked-solution "Note that $M$ is not aligned with the zero-mark on the ruler.\n\nTo find the length, we read the values that correspond to the points $M$ and $N$, and take the difference.\n\nFrom the picture, we see that $M$ corresponds to $0.5\\,\\textrm{in}$ while $N$ corresponds to $2\\,\\textrm{in}$.\n\nTherefore,\n\n$$\nMN = 2in - 0.5in = 1.5in\n$$"}] [{:db/id #edb/ref 17592186105524 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105929 :knowledge-point/id #uuid "4f186459-7a3c-5131-9696-5ce158911634" :knowledge-point/title "Calculating the Measure of a Line Segment on a Number Line"}] :question/id #uuid "620afc7e-0778-5778-8130-7dbe55680002" :question/math-academy-id "e-2550" :question/problem "Find the length of the line segment $\\overline{AB}$ shown below.\n\n![](images/aa/aa8af70fcbd81823439ba7a7919b68ac0814776a0cd5afce48162f40b6067061.png)" :question/worked-solution "To find the length, we read the values that correspond to the points $A$ and $B$ and take the difference.\n\nFrom the diagram, we see that $A$ corresponds to $10$ units while $B$ corresponds to $50$ units.\n\nTherefore, we conclude that\n\n$$\nAB = 50 - 10 = 40\\,\\textrm{units}\n$$"}] [{:db/id #edb/ref 17592186106399 :knowledge-point/_questions [{:db/id #edb/ref 17592186105927 :knowledge-point/id #uuid "5c92ac26-24aa-5b82-8689-a30b23f05bfe" :knowledge-point/title "Calculating the Measure of a Line Segment on a Grid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0fbcd2d-17ae-57d7-9719-551241183c36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3mm" :db/id #edb/ref 17592186104543} {:answer/id #uuid "095f0176-3f97-5a37-9d55-7d9cb1419f83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6mm" :db/id #edb/ref 17592186104544} {:answer/id #uuid "1fc46c08-59f6-59bd-bd22-aa47ad955d56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5mm" :db/id #edb/ref 17592186104545} {:answer/id #uuid "42998710-42eb-5963-94a1-0f354a11c8e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8mm" :db/id #edb/ref 17592186104546} {:answer/id #uuid "64bd1e5a-e42c-5981-ba95-fcf25ea820e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4mm" :db/id #edb/ref 17592186104547}] :answer-field/id #uuid "0a6b4b7a-b8e3-5ffd-abbc-04ef8776664c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186104542}] :question/id #uuid "8816099a-1a8b-509c-bd6a-4c969e5d79cf" :question/math-academy-id "q-53113" :question/problem "![](images/01/0136ebffa14d6ce909ae068473da43f576a0bb18731fe281adb57cb6319b35fc.png)\n\nWhat is the measure of the line segment $PQ^(―)$ shown above?"}]}
