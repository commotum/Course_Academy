#{[{:db/id #edb/ref 17592186138077 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138526 :knowledge-point/id #uuid "e0576504-7bd6-5649-99fe-a758faaffa4b" :knowledge-point/title "Solving Linear Equations Containing Single-Digit Decimals"}] :question/id #uuid "6ff19222-3f56-53cf-bd39-b399573664b8" :question/math-academy-id "e-13026" :question/problem "What is the solution to the equation $0.9s=3.6?$" :question/worked-solution "First, we multiply both sides of the equation by $10$ to get rid of the decimals:\n\n$$\n\\begin{aligned}0.9s & =3.6 \\\\ 10\\cdot (0.9s) & =10\\cdot (3.6) \\\\ 9s & =36\\end{aligned}\n$$\n\nThen, we solve the equation using the multiplication principle, as usual:\n\n$$\n\\begin{aligned}9s & =36 \\\\ \\frac{9s}{9} & =\\frac{36}{9} \\\\ \\frac{\\cancel{9}s}{\\cancel{9}} & =\\frac{36}{9} \\\\ s & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186138078 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138527 :knowledge-point/id #uuid "039fc0a8-337f-50b3-be2c-cfbdbd399537" :knowledge-point/title "Solving Linear Equations Containing Two-Digit Decimals"}] :question/id #uuid "015eac36-e18d-5a53-bfff-f301722a1f0c" :question/math-academy-id "e-13027" :question/problem "What is the solution to the equation $0.25s=0.5?$" :question/worked-solution "First, we multiply both sides of the equation by $100$ to get rid of the decimals:\n\n$$\n\\begin{aligned}0.25s & =0.5 \\\\ 100\\cdot (0.25s) & =100\\cdot (0.5) \\\\ 25s & =50\\end{aligned}\n$$\n\nThen, we solve the equation using the multiplication principle, as usual:\n\n$$\n\\begin{aligned}25s & =50 \\\\ \\frac{25s}{25} & =\\frac{50}{25} \\\\ \\frac{\\cancel{25}s}{\\cancel{25}} & =\\frac{50}{25} \\\\ s & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186138079 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138528 :knowledge-point/id #uuid "68f57411-1d39-52cd-86ee-abf633adf3c3" :knowledge-point/title "Solving Two-Step Equations"}] :question/id #uuid "49ed1c21-223b-5dda-8f4d-7b6a3492a26b" :question/math-academy-id "e-13028" :question/problem "If $0.25+0.03z=1,$ then what is the value of $z?$" :question/worked-solution "First, we multiply both sides of the equation by $100$ to get rid of the decimals:\n\n$$\n\\begin{aligned}0.25+0.03z & =1 \\\\ 100\\cdot (0.25+0.03z) & =100\\cdot (1) \\\\ 100\\cdot (0.25)+100\\cdot (0.03z) & =100 \\\\ 25+3z & =100\\end{aligned}\n$$\n\nThen, we solve the equation using the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}25+3z & =100 \\\\ 3z+25 & =100 \\\\ 3z+25-25 & =100-25 \\\\ 3z & =75 \\\\ \\frac{\\cancel{3}z}{\\cancel{3}} & =\\frac{75}{3} \\\\ z & =25\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487313 :knowledge-point/_questions [{:db/id #edb/ref 17592186138527 :knowledge-point/id #uuid "039fc0a8-337f-50b3-be2c-cfbdbd399537" :knowledge-point/title "Solving Linear Equations Containing Two-Digit Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cfbd51a-734a-5e3a-8b25-c0b81d4136ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186486618} {:answer/id #uuid "1b150b38-b0ec-5e36-ab90-28c99ac0e5ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186486648} {:answer/id #uuid "8e4a755e-b9de-5bcb-9cfd-4eb6ce0145d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186486908} {:answer/id #uuid "ab018aba-0cc7-59f2-998c-c5bcc03f4f28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186486981} {:answer/id #uuid "f7186df6-166b-54ae-99d8-17acc53a9c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186487121}] :answer-field/correct {:answer/id #uuid "f7186df6-166b-54ae-99d8-17acc53a9c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186487121} :answer-field/id #uuid "5cf9bf5f-be26-58bf-857e-26882ff07d69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186487184}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "316ee768-f13c-53c1-a1ba-cd88e7e69557" :question/math-academy-id "q-102055" :question/problem "If $0.07c=2.8$, then $c=$" :question/worked-solution "First, we multiply both sides of the equation by $100$ to get rid of the decimals:\n\n$$\n\\begin{aligned}0.07c & =2.8 \\\\ 100\\cdot (0.07c) & =100\\cdot (2.8) \\\\ 7c & =280\\end{aligned}\n$$\n\nNow, we solve the above equation using the multiplication principle, as usual:\n\n$$\n\\begin{aligned}7c & =280 \\\\ \\frac{7c}{7} & =\\frac{280}{7} \\\\ \\frac{\\cancel{7}c}{\\cancel{7}} & =\\frac{280}{7} \\\\ c & =40\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487347 :knowledge-point/_questions [{:db/id #edb/ref 17592186138526 :knowledge-point/id #uuid "e0576504-7bd6-5649-99fe-a758faaffa4b" :knowledge-point/title "Solving Linear Equations Containing Single-Digit Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43eb2e64-ae0f-56e1-aefa-8da54029af57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4" :db/id #edb/ref 17592186486742} {:answer/id #uuid "7b4f2719-0ef9-590f-ad80-68ad61c216f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-9" :db/id #edb/ref 17592186486860} {:answer/id #uuid "86ca42ed-568f-55de-8cbb-2607d3783553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-6" :db/id #edb/ref 17592186486886} {:answer/id #uuid "a2b3ca93-2bdc-548b-b98d-42b80b873f7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-0.9" :db/id #edb/ref 17592186486964} {:answer/id #uuid "f7b82128-e129-5372-8efb-cdff8d26f197" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-0.6" :db/id #edb/ref 17592186487123}] :answer-field/correct {:answer/id #uuid "86ca42ed-568f-55de-8cbb-2607d3783553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-6" :db/id #edb/ref 17592186486886} :answer-field/id #uuid "b329d8c3-91aa-5b06-bddf-b2834fac8b2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186487241}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d591c49-17a4-5f3d-8812-829122abd153" :question/math-academy-id "q-104763" :question/problem "Solve for $x$, if $0.6x=-3.6.$" :question/worked-solution "First, we multiply both sides of the equation by $10$ to get rid of the decimals:\n\n$$\n\\begin{aligned}0.6x & =-3.6 \\\\ 10\\cdot (0.6x) & =10\\cdot (-3.6) \\\\ 6x & =-36\\end{aligned}\n$$\n\nThen, we solve the equation using the multiplication principle, as usual:\n\n$$\n\\begin{aligned}6x & =-36 \\\\ \\frac{6x}{6} & =\\frac{-36}{6} \\\\ \\frac{\\cancel{6}x}{\\cancel{6}} & =\\frac{-36}{6} \\\\ x & =-6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487297 :knowledge-point/_questions [{:db/id #edb/ref 17592186138526 :knowledge-point/id #uuid "e0576504-7bd6-5649-99fe-a758faaffa4b" :knowledge-point/title "Solving Linear Equations Containing Single-Digit Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62c79f02-8ddd-5ec2-84fc-36f06ba45ad0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186486809}] :answer-field/correct {:answer/id #uuid "62c79f02-8ddd-5ec2-84fc-36f06ba45ad0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186486809} :answer-field/id #uuid "b6ad48f8-35dd-5d8e-9281-77e8acd40163" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186487243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "18f83573-c25e-51a6-ba43-48ece64ab68b" :question/math-academy-id "q-180226" :question/problem "If $0.6y=-4.8$, then $y=${{field-1}}." :question/worked-solution "First, we multiply both sides of the equation by $10$ to get rid of the decimals:\n\n$$\n\\begin{aligned}0.6y & =-4.8 \\\\ 10\\cdot (0.6y) & =10\\cdot (-4.8) \\\\ 6y & =-48\\end{aligned}\n$$\n\nThen, we solve the equation using the multiplication principle, as usual:\n\n$$\n\\begin{aligned}6y & =-48 \\\\ \\frac{6y}{6} & =\\frac{-48}{6} \\\\ \\frac{\\cancel{6}y}{\\cancel{6}} & =-8 \\\\ y & =-8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487356 :knowledge-point/_questions [{:db/id #edb/ref 17592186138527 :knowledge-point/id #uuid "039fc0a8-337f-50b3-be2c-cfbdbd399537" :knowledge-point/title "Solving Linear Equations Containing Two-Digit Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd75239e-1ad1-5e68-b2c8-566627905d78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "110" :db/id #edb/ref 17592186487045}] :answer-field/correct {:answer/id #uuid "cd75239e-1ad1-5e68-b2c8-566627905d78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "110" :db/id #edb/ref 17592186487045} :answer-field/id #uuid "26874153-2887-514d-8d77-8dbe7bee4a91" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186487152}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9d41f481-9aa0-5eac-ac86-1ea37172f582" :question/math-academy-id "q-180234" :question/problem "If $-0.06t=-6.6$, then $t=${{field-1}}." :question/worked-solution "First, we multiply both sides of the equation by $100$ to get rid of the decimals:\n\n$$\n\\begin{aligned}-0.06t & =-6.6 \\\\ 100\\cdot (-0.06t) & =100\\cdot (-6.6) \\\\ -6t & =-660\\end{aligned}\n$$\n\nThen, we divide by $-6$ to isolate $t:$\n\n$$\n\\begin{aligned}-6t & =-660 \\\\ \\frac{-6t}{-6} & =\\frac{-660}{-6} \\\\ \\frac{\\cancel{-6}t}{\\cancel{-6}} & =110 \\\\ t & =110\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487301 :knowledge-point/_questions [{:db/id #edb/ref 17592186138528 :knowledge-point/id #uuid "68f57411-1d39-52cd-86ee-abf633adf3c3" :knowledge-point/title "Solving Two-Step Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03713a81-1b46-528d-848a-0dfe4b974eab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186486600}] :answer-field/correct {:answer/id #uuid "03713a81-1b46-528d-848a-0dfe4b974eab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186486600} :answer-field/id #uuid "ea6b67ed-4ddb-5c14-9fa9-219ba1e6b107" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186487270}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e95a376-82a0-5b4f-a431-8c6e09301595" :question/math-academy-id "q-180238" :question/problem "If $0.52t=0.4t+2.4$, then $t=${{field-1}}." :question/worked-solution "First, we multiply both sides of the equation by $100$ to get rid of the decimals:\n\n$$\n\\begin{aligned}0.52t & =0.4t+2.4 \\\\ 100\\cdot (0.52t) & =100\\cdot (0.4t+2.4) \\\\ 52t & =40t+240\\end{aligned}\n$$\n\nThen, we solve the equation using the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}52t & =40t+240 \\\\ 52t-40t & =40t+240-40t \\\\ 12t & =240 \\\\ \\frac{\\cancel{12}t}{\\cancel{12}} & =\\frac{240}{12} \\\\ t & =20\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186487372 :knowledge-point/_questions [{:db/id #edb/ref 17592186138528 :knowledge-point/id #uuid "68f57411-1d39-52cd-86ee-abf633adf3c3" :knowledge-point/title "Solving Two-Step Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f802dd-4d78-56a4-88c7-93c27944c3fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186486609} {:answer/id #uuid "31a8bb24-ad52-5a5b-ab61-b0b247067658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186486699} {:answer/id #uuid "5301111d-ae64-5ef6-9772-483cfc42b711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186486775} {:answer/id #uuid "6872a15c-9fa1-5c07-8421-74a5702381a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186486822} {:answer/id #uuid "a3001bda-0f1d-5a9c-94b6-d1242daf2667" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186486965}] :answer-field/correct {:answer/id #uuid "31a8bb24-ad52-5a5b-ab61-b0b247067658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186486699} :answer-field/id #uuid "6b38a2e8-da03-5fb8-be27-cbfeaf035c35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186487197}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b69ac07e-a3e5-5cb5-8868-26a8f07d7004" :question/math-academy-id "q-51617" :question/problem "If $0.35q-0.3=-1$, then $q=$" :question/worked-solution "First, we multiply both sides of the equation by $100$ to get rid of the decimals:\n\n$$\n\\begin{aligned}0.35q-0.3 & =-1 \\\\ 100(0.35q-0.3) & =100(-1) \\\\ 35q-30 & =-100\\end{aligned}\n$$\n\nNow, we solve the above equation using the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}35q-30 & =-100 \\\\ 35q-30+30 & =-100+30 \\\\ 35q & =-70 \\\\ \\frac{35q}{35} & =\\frac{-70}{35} \\\\ \\frac{\\cancel{35}q}{\\cancel{35}} & =-\\frac{70}{35} \\\\ q & =-2\\end{aligned}\n$$"}]}
