#{[{:db/id #edb/ref 17592186055007 :knowledge-point/_questions [{:db/id #edb/ref 17592186054786 :knowledge-point/id #uuid "8ffb0f82-65ba-5522-93a4-193c9a794a71" :knowledge-point/title "Simplifying Linear Expressions With Positive Numbers in Parentheses: Distributing a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0adde8b3-07d2-55b6-a1f0-3c38ee251bfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16u-4v" :db/id #edb/ref 17592186488494} {:answer/id #uuid "7c324be0-96e7-5ffe-bcfe-ef9337be7a83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18u-4v" :db/id #edb/ref 17592186488717} {:answer/id #uuid "a12bce51-2478-5eb3-b82a-2dd61753bcce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16u-4v" :db/id #edb/ref 17592186488787} {:answer/id #uuid "c86e6225-f0f0-5ec3-9fed-7879c6d560c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18u-4v" :db/id #edb/ref 17592186488880} {:answer/id #uuid "f4d7958e-1aae-57c9-9588-d067a948ae50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16u+4v" :db/id #edb/ref 17592186488988}] :answer-field/correct {:answer/id #uuid "7c324be0-96e7-5ffe-bcfe-ef9337be7a83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18u-4v" :db/id #edb/ref 17592186488717} :answer-field/id #uuid "8f10d8a0-402a-56dc-90f7-09efc71a379e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051572}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eba523b6-dd38-519f-9070-b818c12401b0" :question/math-academy-id "q-141873" :question/problem "$2u+(5u+v)\\cdot (-4)=$" :question/worked-solution "First, we distribute the $(-4)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}2u+(5u+v)\\cdot (-4) & = \\\\ 2u+5u\\cdot (-4)+v\\cdot (-4) & = \\\\ 2u+(-20u)+(-4v) & = \\\\ 2u-20u-4v & .\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n \n\n$$\n\\begin{aligned}2u-20u-4v & = \\\\ (2u-20u)-4v & = \\\\ -18u-4v & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186489220 :knowledge-point/_questions [{:db/id #edb/ref 17592186054786 :knowledge-point/id #uuid "8ffb0f82-65ba-5522-93a4-193c9a794a71" :knowledge-point/title "Simplifying Linear Expressions With Positive Numbers in Parentheses: Distributing a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ad97cff-9e2e-563f-b6a9-474cb218d7b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+6y" :db/id #edb/ref 17592186488561} {:answer/id #uuid "3b3b0a0d-ced6-5f22-a4fb-24960d846e07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8x+8y" :db/id #edb/ref 17592186488593} {:answer/id #uuid "c4a42675-06f0-5aac-910b-a636d62f1f43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+6y" :db/id #edb/ref 17592186488868} {:answer/id #uuid "f3da4469-9b3d-59cb-947a-65e2c706782e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+9y" :db/id #edb/ref 17592186488984} {:answer/id #uuid "f668a967-ab29-563f-b04a-57e4cb7a86bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+9y" :db/id #edb/ref 17592186488992}] :answer-field/correct {:answer/id #uuid "c4a42675-06f0-5aac-910b-a636d62f1f43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+6y" :db/id #edb/ref 17592186488868} :answer-field/id #uuid "a999e85d-466d-5b48-8784-0835d63fcc46" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489109}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "56c7326b-73aa-516e-8094-38a5a4c858fb" :question/math-academy-id "q-141910" :question/problem "$(-2)(3x+y)+8y=$" :question/worked-solution "First, we distribute the $(-2)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}(-2)(3x+y)+8y & = \\\\ (-2)\\cdot 3x+(-2)\\cdot y+8y & = \\\\ (-6x)+(-2y)+8y & = \\\\ -6x-2y+8y & \\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}\\begin{aligned}-6x-2y+8y & = \\\\ -6x+(8y-2y) & = \\\\ -6x+6y & \\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186489221 :knowledge-point/_questions [{:db/id #edb/ref 17592186054787 :knowledge-point/id #uuid "fa6b39a9-8665-5135-8637-05d811fc4030" :knowledge-point/title "Simplifying Linear Expressions With Negative Numbers in Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05bb9e95-1d10-5069-a452-c7b0b169db9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-4a" :db/id #edb/ref 17592186488483} {:answer/id #uuid "5ae65b8c-35be-548c-a00d-0cc258220579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20-4a" :db/id #edb/ref 17592186488644} {:answer/id #uuid "a6e3c89e-98d3-5561-a67a-a1b501b72224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8-a" :db/id #edb/ref 17592186488803} {:answer/id #uuid "cb99c864-e94b-5f43-b916-b054dd2ef046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20-a" :db/id #edb/ref 17592186488884} {:answer/id #uuid "fa49a3a2-0170-50ed-940e-118d1bf5b6a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8-4a" :db/id #edb/ref 17592186488998}] :answer-field/correct {:answer/id #uuid "5ae65b8c-35be-548c-a00d-0cc258220579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20-4a" :db/id #edb/ref 17592186488644} :answer-field/id #uuid "fcc25ce6-564a-5da0-94c0-553cbcb50892" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489167}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d0b6029-5d16-5038-805d-6574595234a2" :question/math-academy-id "q-141938" :question/problem "Simplify $4(2-a)+12.$" :question/worked-solution "First, we distribute the $4$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}4(2-a)+12 & = \\\\ 4\\cdot 2+4\\cdot (-a)+12 & = \\\\ (8)+(-4a)+12 & = \\\\ 8-4a+12\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}8-4a+12 & = \\\\ (8+12)-4a & = \\\\ 20-4a\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186489294 :knowledge-point/_questions [{:db/id #edb/ref 17592186054787 :knowledge-point/id #uuid "fa6b39a9-8665-5135-8637-05d811fc4030" :knowledge-point/title "Simplifying Linear Expressions With Negative Numbers in Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ca5f0a-6066-5ca0-a1b3-1aed5c88446b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+x" :db/id #edb/ref 17592186488518} {:answer/id #uuid "3b392e44-d743-52c0-b2c4-1b24a9652e42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7+3x" :db/id #edb/ref 17592186488592} {:answer/id #uuid "3f111cec-76bb-5894-9561-03fcdf244044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7+x" :db/id #edb/ref 17592186488600} {:answer/id #uuid "5a8175c1-02fa-50e9-a6cd-d3cc478b8b05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+5x" :db/id #edb/ref 17592186488642} {:answer/id #uuid "a82c0323-a9df-5774-94f2-0aaef3aa4133" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+3x" :db/id #edb/ref 17592186488804}] :answer-field/correct {:answer/id #uuid "5a8175c1-02fa-50e9-a6cd-d3cc478b8b05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+5x" :db/id #edb/ref 17592186488642} :answer-field/id #uuid "56cc9ec7-a78c-54b1-a942-1c31a8e69346" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489063}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fadc73be-dedf-5384-82b7-e3c8b9123466" :question/math-academy-id "q-173697" :question/problem "$12-3x+(4x-5)\\cdot 2=$" :question/worked-solution "First, we distribute the $2$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}12-3x+(4x-5)\\cdot 2 & = \\\\ 12-3x+4x\\cdot 2+(-5)\\cdot 2 & = \\\\ 12-3x+(8x)+(-10) & = \\\\ 12-3x+8x-10\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n$$\n\\begin{aligned}12-3x+8x-10 & = \\\\ (12-10)+(-3x+8x) & = \\\\ (2)+(5x) & = \\\\ 2+5x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186489266 :knowledge-point/_questions [{:db/id #edb/ref 17592186054786 :knowledge-point/id #uuid "8ffb0f82-65ba-5522-93a4-193c9a794a71" :knowledge-point/title "Simplifying Linear Expressions With Positive Numbers in Parentheses: Distributing a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ac84694-db3c-508f-ab4f-56602c4d7c88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186488643}] :answer-field/correct {:answer/id #uuid "5ac84694-db3c-508f-ab4f-56602c4d7c88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186488643} :answer-field/id #uuid "36634756-bd5b-5b68-9066-c998674fe2a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489047} {:answer-field/choices [{:answer/id #uuid "d00aea71-15dd-50d3-9494-51ab03f8e7b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186488893}] :answer-field/correct {:answer/id #uuid "d00aea71-15dd-50d3-9494-51ab03f8e7b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186488893} :answer-field/id #uuid "fb10cdd1-554d-5648-b07a-f7242920d579" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186489166}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd9687a1-fd95-59a6-b621-1301fd1f4974" :question/math-academy-id "q-178204" :question/problem "$(3p+5q)\\cdot (-3)+9q=${{field-1}}\n$p\\,-$\n{{field-2}}\n$q$" :question/worked-solution "First, we distribute the $(-3)$ over each of the terms in parentheses.\n\n$$\n\\begin{aligned}\\begin{aligned}(3p+5q)\\cdot (-3)+9q & = \\\\ 3p\\cdot (-3)+5q\\cdot (-3)+9q & = \\\\ (-9p)+(-15q)+9q & = \\\\ -9p-15q+9q\\end{aligned}\\end{aligned}\n$$\n\nThen, we collect like terms.\n\n \n\n$$\n\\begin{aligned}-9p-15q+9q & = \\\\ -9p+(-15q+9q) & = \\\\ -9\\,p-6\\,q & \\end{aligned}\n$$"}]}
