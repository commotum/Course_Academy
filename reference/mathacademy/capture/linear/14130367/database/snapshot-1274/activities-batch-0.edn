#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186148328} :activity/id #uuid "cd9044aa-4ba8-52ca-97b0-9e256d7f85b1" :activity/scope {:db/id #edb/ref 17592186050475 :topic/id #uuid "4c95526a-a8d3-5fe5-bcd6-80a4165aa35c" :topic/math-academy-id 2458} :activity/steps [{:db/id #edb/ref 17592186148328 :step/content {:db/id #edb/ref 17592186148776 :tutorial/content "Remember that every fraction represents a division: the numerator divided by the denominator. \n\nFor example,\n\n$$\n\\dfrac{5}{3} = 5 \\div 3.\n$$\n\nWe can use this idea to rewrite expressions containing fractions.\n\nFor example, suppose we want to rewrite the following expression:\n\n$$\n\\dfrac{5}{\\color{red}3}\\times {\\color{blue}12}\n$$\n\nInterpreting the fraction as division, we can write our expression as\n\n$$\n5{\\color{red}\\;\\div\\; 3}{\\color{blue}\\;\\times\\; 12}.\n$$\n\nNext, we use the fact that we can swap the order of multiplication and division. So, we can write an equivalent expression by switching the $\\color{red}\\div\\, 3$ and the ${\\color{blue}\\times\\, 12},$ as follows:\n\n$$\n5{\\color{blue}\\;\\times\\; 12}{\\color{red}\\;\\div\\; 3}\n$$\n\nTherefore, \n\n$$\n\\dfrac{5}{\\color{red}3} \\times {\\color{blue}12} = 5{\\color{blue}\\;\\times\\; 12}{\\color{red}\\;\\div\\; 3}.\n$$" :tutorial/id #uuid "b7482125-2f1c-530c-8189-c96395c36e6f" :tutorial/math-academy-id 7865 :tutorial/title "Introduction"} :step/id #uuid "df46e27d-7449-54c2-b98a-b0c900fb421f" :step/math-academy-id 45354 :step/next {:db/id #edb/ref 17592186148329}} {:db/id #edb/ref 17592186148329 :step/content {:db/id #edb/ref 17592186147457 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147140 :question/id #uuid "a3ef9728-84fb-50d0-a50b-774386ca7c9d" :question/math-academy-id "e-12570"} :knowledge-point/id #uuid "0b508e1a-00f5-58d1-b399-344884761c8e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048624}] :knowledge-point/questions [{:db/id #edb/ref 17592186147851} {:db/id #edb/ref 17592186147852} {:db/id #edb/ref 17592186426686} {:db/id #edb/ref 17592186426690} {:db/id #edb/ref 17592186426692} {:db/id #edb/ref 17592186426698} {:db/id #edb/ref 17592186426701}] :knowledge-point/title "Expressing Multiplication of Fractions by Whole Numbers as Multiplication and Division"} :step/id #uuid "eeab3688-5437-5fbc-a190-8b69f65298ae" :step/math-academy-id 45355 :step/next {:db/id #edb/ref 17592186148330}} {:db/id #edb/ref 17592186148330 :step/content {:db/id #edb/ref 17592186148777 :tutorial/content "Consider the expression $\\dfrac{5}{\\color{red}3} \\times {\\color{blue}12}.$ By expressing the fraction as division, we have\n\n$$\n5 {\\color{red}\\;\\div\\; 3} {\\color{blue}\\;\\times\\; 12},\n$$\n\nand by swapping the ${\\color{red}\\div\\; 3}$ and the ${\\color{blue}\\times\\; 12},$ we have\n\n$$\n5 {\\color{blue}\\;\\times\\; 12}{\\color{red}\\;\\div\\; 3}.\n$$\n\nNow, notice that we can rewrite the division ${\\color{blue}12} {\\color{red}\\;\\div\\; 3}$ as a new fraction $\\dfrac{\\color{blue}12}{\\color{red}3}$ to produce a new expression:\n\n$$\n5\\times \\dfrac{\\color{blue}12}{\\color{red}3}\n$$\n\nTherefore,\n\n$$\n\\dfrac{5}{\\color{red}3} \\times {\\color{blue}12} = 5\\times \\dfrac{\\color{blue}12}{\\color{red}3}.\n$$" :tutorial/id #uuid "0f263274-ece0-59e1-9732-f5f3d6d87b96" :tutorial/math-academy-id 7866 :tutorial/title "Further Interpreting Multiplication of Fractions and Whole Numbers"} :step/id #uuid "6e04c40f-4a56-5045-8f36-31065daea522" :step/math-academy-id 45358 :step/next {:db/id #edb/ref 17592186148331}} {:db/id #edb/ref 17592186148331 :step/content {:db/id #edb/ref 17592186147458 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147141 :question/id #uuid "b8af91a0-f5c0-545e-b188-b62cde696bb8" :question/math-academy-id "e-12571"} :knowledge-point/id #uuid "fdcb850d-14d5-56e9-81d8-9af497460503" :knowledge-point/questions [{:db/id #edb/ref 17592186147853} {:db/id #edb/ref 17592186147867} {:db/id #edb/ref 17592186426684} {:db/id #edb/ref 17592186426685} {:db/id #edb/ref 17592186426687} {:db/id #edb/ref 17592186426691}] :knowledge-point/title "Expressing Multiplication and Division as Multiplication of Fractions by Whole Numbers"} :step/id #uuid "fb6a16ba-0abb-515f-a429-f4596b79106e" :step/math-academy-id 45359 :step/next {:db/id #edb/ref 17592186148332}} {:db/id #edb/ref 17592186148332 :step/content {:db/id #edb/ref 17592186147459 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147142 :question/id #uuid "812e5cc8-ff6f-5e67-84bf-f012dec63466" :question/math-academy-id "e-12572"} :knowledge-point/id #uuid "dfdc6b8f-e329-57b4-9ae9-e2f2c92105be" :knowledge-point/questions [{:db/id #edb/ref 17592186147849} {:db/id #edb/ref 17592186147896} {:db/id #edb/ref 17592186426688} {:db/id #edb/ref 17592186426689} {:db/id #edb/ref 17592186426693} {:db/id #edb/ref 17592186426697} {:db/id #edb/ref 17592186426699}] :knowledge-point/title "Swapping the Multiplier and the Numerator of a Fraction"} :step/id #uuid "6e42676a-b45f-56b2-a9e5-d59f5b006abd" :step/math-academy-id 45362 :step/next {:db/id #edb/ref 17592186148333}} {:db/id #edb/ref 17592186148333 :step/content {:db/id #edb/ref 17592186148778 :tutorial/content "Let's evaluate the following expression:\n\n$$\n\\dfrac{5}{\\color{red}3} \\times {\\color{blue}12}\n$$\n\nFirst, by swapping the order of multiplication and division, we can rewrite our expression as\n\n$$\n5\\times \\dfrac{\\color{blue}12}{\\color{red}3}.\n$$\n\nNow, notice that ${\\color{red}3}$ is a factor of ${\\color{blue}{12}},$ and\n\n$$\n\\dfrac{\\color{blue}12}{\\color{red}3} = {\\color{blue}{12}} \\div {\\color{red}3}  = 4.\n$$\n\nTherefore, we can evaluate our entire expression as follows:\n\n$$\n5\\times \\underbrace{\\dfrac{\\color{blue}12}{\\color{red}3}}_{4} = 5 \\times 4 = 20\n$$" :tutorial/id #uuid "d51c39ab-4754-5f52-be5e-037be0398c1b" :tutorial/math-academy-id 7867 :tutorial/title "Solving Multiplication of Fractions and Whole Numbers"} :step/id #uuid "b11f333c-1bba-560f-a6e4-fc9a9b756bd3" :step/math-academy-id 45365 :step/next {:db/id #edb/ref 17592186148334}} {:db/id #edb/ref 17592186148334 :step/content {:db/id #edb/ref 17592186147460 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147143 :question/id #uuid "dfa40a5c-e8ed-55c0-83e7-bd701eae0da5" :question/math-academy-id "e-12573"} :knowledge-point/id #uuid "5726ea5c-ba64-51c2-b5ac-0915853fd080" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050742}] :knowledge-point/questions [{:db/id #edb/ref 17592186147865} {:db/id #edb/ref 17592186147868} {:db/id #edb/ref 17592186426694} {:db/id #edb/ref 17592186426695} {:db/id #edb/ref 17592186426696} {:db/id #edb/ref 17592186426700}] :knowledge-point/title "Evaluating an Expression by Interpreting a Fraction as Division"} :step/id #uuid "087a4adb-8491-530e-a76f-f944701fc12c" :step/math-academy-id 45366}] :activity/title "Strategies to Simplify Whole Number and Fraction Multiplication" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186147659}]}
