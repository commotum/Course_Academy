#{[{:activity/first-step {:db/id #edb/ref 17592186060487} :activity/id #uuid "417359c4-b8c5-5481-85de-95f9b7666274" :activity/scope {:db/id #edb/ref 17592186048433 :topic/id #uuid "9eec9b0a-ab49-5a77-b05c-4701ae98e0a4" :topic/math-academy-id 167} :activity/steps [{:db/id #edb/ref 17592186060485 :step/content {:db/id #edb/ref 17592186059648 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059476 :question/id #uuid "9d157fc4-9b82-5430-8622-dd5bb155b123" :question/math-academy-id "e-3158"} :knowledge-point/id #uuid "8594bbfe-b098-5aad-9b9e-29997798c73b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049407}] :knowledge-point/questions [{:db/id #edb/ref 17592186060321} {:db/id #edb/ref 17592186060323}] :knowledge-point/title "Representing Negative Angles in the Coordinate Plane With the Unit Circle"} :step/id #uuid "a631840f-99c0-5d35-9855-db3383fa47c6" :step/math-academy-id 10736 :step/next {:db/id #edb/ref 17592186060486}} {:db/id #edb/ref 17592186060486 :step/content {:db/id #edb/ref 17592186059649 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059477 :question/id #uuid "2026745e-59ca-5365-82fc-2683b026fac5" :question/math-academy-id "e-3159"} :knowledge-point/id #uuid "ae40b03b-8dd7-56f6-95a1-96fd20de50bb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050053}] :knowledge-point/questions [{:db/id #edb/ref 17592186060322} {:db/id #edb/ref 17592186060342}] :knowledge-point/title "Representing Negative Angles in Radians in the Coordinate Plane With the Unit Circle"} :step/id #uuid "85340a36-e053-52ea-8d93-3f41daecc7dc" :step/math-academy-id 10737 :step/next {:db/id #edb/ref 17592186060488}} {:db/id #edb/ref 17592186060487 :step/content {:db/id #edb/ref 17592186060878 :tutorial/content "Recall that, in the coordinate plane, an angle $\\theta$ in the standard position has its vertex at the origin, its initial side lies along the positive $x$-axis, and it rotates such that a positive angle is measured counter-clockwise.\n\nSince a positive angle is always measured counter-clockwise, this means that a negative angle is measured *clockwise*.\n\nFor example, we can represent the angles\n\n$$\n\\theta = -45^\\circ, -135^\\circ, -225^\\circ\n$$\n\nand $-315^\\circ$ as central angles of the unit circle (in the standard way) as follows:\n\n![](images/0b/0b33ba078eecacd9f8d40622fb21be5ec710a22b6e69458006c5d9422441285a.png)" :tutorial/id #uuid "68ce29e1-9103-5789-b099-86fc740b8e9f" :tutorial/math-academy-id 2412 :tutorial/title "Introduction"} :step/id #uuid "1bb5b6ee-a626-5cee-ac11-f154d67f6e28" :step/math-academy-id 10738 :step/next {:db/id #edb/ref 17592186060485}} {:db/id #edb/ref 17592186060488 :step/content {:db/id #edb/ref 17592186060879 :tutorial/content "Sometimes, we wish to represent negative angles in the coordinate plane without reference to the unit circle.\n\nAs with positive angles, the convention for representing negative angles is the same as without the unit circle.\n\nFor example, we can represent the angles\n\n$$\n\\theta = -45^\\circ, -135^\\circ, -225^\\circ\n$$\n\nand $-315^\\circ$ in the coordinate plane in the standard way as follows:\n\n![](images/01/019d5fc186f3c540702951b08d8dfcaf67cb82333a6c18a466dc21794e6dc94c.png)" :tutorial/id #uuid "7777faf9-e849-5e81-b157-e4001c256429" :tutorial/math-academy-id 2413 :tutorial/title "Representing Negative Angles in the Coordinate Plane"} :step/id #uuid "749b9fe4-b52e-530d-9ddf-a23f119ac8be" :step/math-academy-id 10741 :step/next {:db/id #edb/ref 17592186060489}} {:db/id #edb/ref 17592186060489 :step/content {:db/id #edb/ref 17592186059650 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059478 :question/id #uuid "4a601091-a7ee-5733-b17d-d01acced88b3" :question/math-academy-id "e-3160"} :knowledge-point/id #uuid "e67c1979-cee7-5eab-81d5-b185976b88b7" :knowledge-point/questions [{:db/id #edb/ref 17592186060268} {:db/id #edb/ref 17592186060325}] :knowledge-point/title "Representing Negative Angles in the Coordinate Plane"} :step/id #uuid "4005a53d-8809-5a49-8548-a6e4d1f33cb9" :step/math-academy-id 10749}] :activity/title "Negative Angles in the Coordinate Plane" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059895}]}
