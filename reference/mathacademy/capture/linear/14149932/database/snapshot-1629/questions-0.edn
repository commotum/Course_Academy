#{[{:db/id #edb/ref 17592186054403 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054777 :knowledge-point/id #uuid "070ef753-e976-5aeb-bc1c-5d0397e962ed" :knowledge-point/title "Distributing a Positive Number Over the Sum of Two Terms"}] :question/id #uuid "cc355989-794d-5053-9539-930149bb2019" :question/math-academy-id "e-12977" :question/problem "Expand $3(4x+2).$" :question/worked-solution "Using the distributive law, we multiply each term inside the parentheses by the number $3\\mathbin{:}$\n\n$$\n\\begin{aligned}3(4x+2) & = \\\\ 3\\cdot 4x+3\\cdot 2 & = \\\\ 12x+6 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054404 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054778 :knowledge-point/id #uuid "6cb5920c-6481-57a8-b669-35a94ecb1062" :knowledge-point/title "Distributing a Negative Number Over the Sum of Two Terms"}] :question/id #uuid "8cbbff48-a8bb-54c8-8e64-a73b6f83b590" :question/math-academy-id "e-12978" :question/problem "Expand $(2y+7) \\cdot (-3).$" :question/worked-solution "Using the distributive law, we multiply each term inside the parentheses by the number \n$(-3)\\mathbin{:}$\n\n$$\n\\eqalign{\n\t(2y+7) \\cdot (-3)&=\\[5pt]\n\t2y\\cdot(-3)+7\\cdot(-3)&=\\[5pt]\n\t(-6y) + (-21)&=\\[5pt]\n\t-6y-21\n\t}\n$$"}] [{:db/id #edb/ref 17592186054405 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054779 :knowledge-point/id #uuid "c3908758-abd6-58c4-bd6e-d4df02c6dff2" :knowledge-point/title "Distributing a Positive Number Over the Difference of Two Terms"}] :question/id #uuid "5a98cb1f-a23d-522b-9677-ed4163db76d2" :question/math-academy-id "e-12979" :question/problem "Expand $7(5x-3y).$" :question/worked-solution "Using the distributive law, we multiply each term inside the parentheses by the number $7\\mathbin:$\n\n$$\n\\begin{aligned}7(5x-3y) & = \\\\ 7\\cdot 5x+7\\cdot (-3y) & = \\\\ (35x)+(-21y) & = \\\\ 35x-21y & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054406 :knowledge-point/_canonical-example [{:db