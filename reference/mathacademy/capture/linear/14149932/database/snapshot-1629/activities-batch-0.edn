#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055793} :activity/id #uuid "beb0ff73-9801-5d7a-8cda-68d3cc158437" :activity/scope {:db/id #edb/ref 17592186050908 :topic/id #uuid "704c70d6-1bf4-5b23-b4da-d122a744acda" :topic/math-academy-id 135} :activity/steps [{:db/id #edb/ref 17592186055793 :step/content {:db/id #edb/ref 17592186056023 :tutorial/content "The **distributive law** states that multiplying a group of terms by a number is the same as multiplying each term separately by that same number and adding the products.\n\nFor example, let's take a look at the following expression: \n\n$$\n2(3+4).\n$$\n\n \n\nWe can evaluate this expression using the distributive law:\n\n![](images/4c/4ca32844e45f756ce88e4d8e6d73e8b69099d2c517157b51fed9bb1f02a699ea.png)\n\nTherefore,\n\n$$\n\\begin{aligned}2(3+4) & = \\\\ 2\\cdot 3+2\\cdot 4 & = \\\\ 6+8 & = \\\\ 14 & .\\end{aligned}\n$$\n\nThe distributive law also applies when the multiplication occurs on the right of the parentheses:\n\n$$\n\\begin{aligned}(3+4)\\cdot 2 & = \\\\ 3\\cdot 2+4\\cdot 2 & = \\\\ 6+8 & = \\\\ 14 & \\end{aligned}\n$$" :tutorial/id #uuid "38c806d3-fe46-5786-81c9-63a1d1bdd9d3" :tutorial/math-academy-id 8112 :tutorial/title "Introduction"} :step/id #uuid "0260c802-439e-52f2-a68b-09274c6a571b" :step/math-academy-id 52198 :step/next {:db/id #edb/ref 17592186055794}} {:db/id #edb/ref 17592186055794 :step/content {:db/id #edb/ref 17592186054777 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054403 :question/id #uuid "cc355989-794d-5053-9539-930149bb2019" :question/math-academy-id "e-12977"} :knowledge-point/id #uuid "070ef753-e976-5aeb-bc1c-5d0397e962ed" :knowledge-point/questions [{:db/id #edb/ref 17592186055379} {:db/id #edb/ref 17592186055395} {:db/id #edb/ref 17592186445155}] :knowledge-point/title "Distributing a Positive Number Over the Sum of Two Terms"} :step/id #uuid "2773b7a6-5cf0-5ec7-ab24-7c3f3e071778" :step/math-academy-id 52199 :step/next {:db/id #edb/ref 17592186055795}} {:db/id #edb/ref 17592186055795 :step/content {:db/id #edb/ref 17592186054778 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054404 :question/id #uuid "8cbbff48-a8bb-54c8-8e64-a73b6f83b590" :question/math-academy-id "e-12978"} :knowledge-point/id #uuid "6cb5920c-6481-57a8-b669-35a94ecb1062" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049349} {:db/id #edb/ref 17592186050421}] :knowledge-point/questions [{:db/id #edb/ref 17592186055230} {:db/id #edb/ref 17592186055396} {:db/id #edb/ref 17592186445153} {:db/id #edb/ref 17592186445154}] :knowledge-point/title "Distributing a Negative Number Over the Sum of Two Terms"} :step/id #uuid "13fb6de4-d0af-5464-a0b6-d0869bef3942" :step/math-academy-id 52202 :step/next {:db/id #edb/ref 17592186055796}} {:db/id #edb/ref 17592186055796 :step/content {:db/id #edb/ref 17592186056024 :tutorial/content "The distributive law also works when there is subtraction inside the parentheses. \n\nFor example, we can expand the expression $2(3-4)$ as follows:\n\n![](images/05/05ba4424f566b35af2a279b994c3a8f13564560deaa60f1c7c4616f52d2fb8d6.png)\n\nNotice that we keep a plus ($+$) sign between the two terms. This helps us to avoid mistakes when multiplying with negative numbers.\n\nNow, evaluating our expression, we have\n\n$$\n\\begin{aligned}2(3-4) & = \\\\ 2\\cdot 3+2\\cdot (-4) & = \\\\ (6)+(-8) & = \\\\ 6-8 & = \\\\ -2 & .\\end{aligned}\n$$\n\nFinally, the distributive law also applies when the multiplication occurs on the right of the parentheses:\n\n$$\n\\begin{aligned}(3-4)\\cdot 2 & = \\\\ 3\\cdot 2+(-4)\\cdot 2 & = \\\\ (6)+(-8) & = \\\\ 6-8 & = \\\\ -2 & .\\end{aligned}\n$$" :tutorial/id #uuid "ac1d8340-9788-5072-a2ae-b1a73d0df048" :tutorial/math-academy-id 8113 :tutorial/title "Dealing With a Minus Inside the Parentheses"} :step/id #uuid "bf71b983-d8a0-5ea7-b63f-9c9cc0dee5ed" :step/math-academy-id 52205 :step/next {:db/id #edb/ref 17592186055797}} {:db/id #edb/ref 17592186055797 :step/content {:db/id #edb/ref 17592186054779 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054405 :question/id #uuid "5a98cb1f-a23d-522b-9677-ed4163db76d2" :question/math-academy-id "e-12979"} :knowledge-point/id #uuid "c3908758-abd6-58c4-bd6e-d4df02c6dff2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050287}] :knowledge-point/questions [{:db/id #edb/ref 17592186055362} {:db/id #edb/ref 17592186055376} {:db/id #edb/ref 17592186445151} {:db/id #edb/ref 17592186445152}] :knowledge-point/title "Distributing a Positive Number Over the Difference of Two Terms"} :step/id #uuid "7b50cc40-2af9-5f98-b18f-05c4449bce2b" :step/math-academy-id 52206 :step/next {:db/id #edb/ref 17592186055798}} {:db/id #edb/ref 17592186055798 :step/content {:db/id #edb/ref 17592186054780 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054406 :question/id #uuid "f93a8815-c7ef-51f9-9c22-f297248fdd6b" :question/math-academy-id "e-12980"} :knowledge-point/id #uuid "1a1b70d3-5120-5def-b9b5-eca62577b587" :knowledge-point/questions [{:db/id #edb/ref 17592186055005} {:db/id #edb/ref 17592186055249} {:db/id #edb/ref 17592186445149} {:db/id #edb/ref 17592186445150}] :knowledge-point/title "Distributing a Negative Number Over the Difference of Two Terms"} :step/id #uuid "9c926434-2ec0-590c-b30c-36f58052ba12" :step/math-academy-id 52209}] :activity/title "Applying the Distributive Law With Linear Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054885}]}
