#{[{:db/id #edb/ref 17592186054403 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054777 :knowledge-point/id #uuid "070ef753-e976-5aeb-bc1c-5d0397e962ed" :knowledge-point/title "Distributing a Positive Number Over the Sum of Two Terms"}] :question/id #uuid "cc355989-794d-5053-9539-930149bb2019" :question/math-academy-id "e-12977" :question/problem "Expand $3(4x+2)$." :question/worked-solution "Using the distributive law, we multiply each term inside the parentheses by the number $3$:\n\n$$\n\\begin{aligned}\n3(4x + 2) &=  \\\\\n3 \\cdot 4x + 3 \\cdot 2 &=  \\\\\n&= 12x + 6\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054404 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054778 :knowledge-point/id #uuid "6cb5920c-6481-57a8-b669-35a94ecb1062" :knowledge-point/title "Distributing a Negative Number Over the Sum of Two Terms"}] :question/id #uuid "8cbbff48-a8bb-54c8-8e64-a73b6f83b590" :question/math-academy-id "e-12978" :question/problem "Expand $(2y+7) \\cdot (-3)$." :question/worked-solution "Using the distributive law, we multiply each term inside the parentheses by the number\n$(-3)$:\n\n$$\n\\begin{aligned} (2y+7) \\cdot (-3) \\\\[5pt] &= 2y\\cdot(-3)+7\\cdot(-3) \\\\[5pt] &= (-6y) + (-21) \\\\[5pt] &= -6y-21 \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054405 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054779 :knowledge-point/id #uuid "c3908758-abd6-58c4-bd6e-d4df02c6dff2" :knowledge-point/title "Distributing a Positive Number Over the Difference of Two Terms"}] :question/id #uuid "5a98cb1f-a23d-522b-9677-ed4163db76d2" :question/math-academy-id "e-12979" :question/problem "Expand $7(5x-3y)$." :question/worked-solution "Using the distributive law, we multiply each term inside the parentheses by the number $7\\mathbin$:\n\n$$\n\\begin{aligned}\n7(5x - 3y) &=  \\\\\n7 \\cdot 5x + 7 \\cdot (-3y) &=  \\\\\n(35x) + (-21y) &=  \\\\\n&= 35x - 21y\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054406 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054780 :knowledge-point/id #uuid "1a1b70d3-5120-5def-b9b5-eca62577b587" :knowledge-point/title "Distributing a Negative Number Over the Difference of Two Terms"}] :question/id #uuid "f93a8815-c7ef-51f9-9c22-f297248fdd6b" :question/math-academy-id "e-12980" :question/problem "Expand $-11(4x - 3y)$." :question/worked-solution "Using the distributive law, we multiply each term inside the parentheses by the number $(-11)$:\n\n$$\n\\begin{aligned}\n-11(4x - 3y) &=  \\\\\n(-11) \\cdot 4x + (-11) \\cdot (-3y) &=  \\\\\n(-44x) + (33y) &=  \\\\\n&= - 44x + 33y\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055379 :knowledge-point/_questions [{:db/id #edb/ref 17592186054777 :knowledge-point/id #uuid "070ef753-e976-5aeb-bc1c-5d0397e962ed" :knowledge-point/title "Distributing a Positive Number Over the Sum of Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91f8f797-8e77-5129-b2ec-ae04dd135ab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40x - 15" :db/id #edb/ref 17592186053512} {:answer/id #uuid "c6b00632-96f3-53ee-9c3d-6f733150cc17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13x + 8" :db/id #edb/ref 17592186053513} {:answer/id #uuid "c72fcf45-04f3-5f1b-9fb3-50e637ee632a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-40x - 15" :db/id #edb/ref 17592186053514} {:answer/id #uuid "c97dd8bc-b052-58ac-9c0b-f925035c9e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-40x + 15" :db/id #edb/ref 17592186053515} {:answer/id #uuid "08054c16-8999-50a7-8ec6-876374a56cf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40x + 15" :db/id #edb/ref 17592186053516}] :answer-field/id #uuid "be083618-5a2e-58ef-947f-78020a2cace9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 175921860454