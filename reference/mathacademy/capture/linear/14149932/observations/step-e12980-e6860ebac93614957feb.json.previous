{
  "dom_id": "step-e12980",
  "name": "Example: Distributing a Negative Number Over the Difference of Two Terms",
  "problem": "Expand $-11(4x - 3y) .$",
  "worked_solution": "Using the distributive law, we multiply each term inside the parentheses by the number $(-11)\\mathbin{:}$\n\n$$\n\\begin{aligned}-11(4x-3y) & = \\\\ (-11)\\cdot 4x+(-11)\\cdot (-3y) & = \\\\ (-44x)+(33y) & = \\\\ -44x+33y & \\end{aligned}\n$$",
  "calculator_instructions": "",
  "fields": [],
  "problem_field_keys": [],
  "answer_fields_complete": null,
  "result": null,
  "proof_feedback": null,
