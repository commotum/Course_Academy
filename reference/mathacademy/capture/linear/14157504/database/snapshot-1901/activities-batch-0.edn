#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055687} :activity/id #uuid "4df2c794-d6f1-5b2c-b531-4b62cd330d25" :activity/scope {:db/id #edb/ref 17592186049729 :topic/id #uuid "0e93d6a8-7e73-5aab-ad38-9219d686c6e1" :topic/math-academy-id 71} :activity/steps [{:db/id #edb/ref 17592186055687 :step/content {:db/id #edb/ref 17592186055948 :tutorial/content "The **product rule for exponents** states that when we multiply two or more exponents that have the same base, we add the exponents:\n\n$$\na^n\\cdot a^m=a^{n+m}\n$$\n\nFor example,\n\n$$\na^2\\cdot a^3 = a^{2+3} = a^5.\n$$\n\nTo see why the product rule is true, let's take the above example and work it out again, the long way.\n\nFor the two factors $a^2$ and $a^3$ we have $a^2=a\\cdot a$ and $a^3= a\\cdot a\\cdot a.$ If we now substitute these two expressions into $a^2\\cdot a^3$, we get the same result:\n\n$$\n\\eqalign{\na^2\\cdot a^3&=\\\n (a\\cdot a) \\cdot (a\\cdot a\\cdot a)&=\\\na\\cdot a\\cdot a\\cdot a\\cdot a&=\\\na^5\n}\n$$\n\nThe product rule is just a shortcut for the process above." :tutorial/id #uuid "e5759844-cfcd-53d9-9411-c5a117bf0fc6" :tutorial/math-academy-id 1476 :tutorial/title "Introduction"} :step/id #uuid "18a0a31b-5f77-564c-8052-6c2f28d6c821" :step/math-academy-id 3507 :step/next {:db/id #edb/ref 17592186055688}} {:db/id #edb/ref 17592186055688 :step/content {:db/id #edb/ref 17592186054704 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054351 :question/id #uuid "3e60b147-6f6c-585b-8daf-d4499f989cef" :question/math-academy-id "e-1069"} :knowledge-point/id #uuid "2253ac13-3eee-5385-b774-8340a57b468e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050668} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186055195} {:db/id #edb/ref 17592186055307} {:db/id #edb/ref 17592186480642} {:db/id #edb/ref 17592186480646}] :knowledge-point/title "Using the Product Rule with Two Terms"} :step/id #uuid "e2299354-c3b9-5b97-b8ed-d0d7bd6fb590" :step/math-academy-id 3511 :step/next {:db/id #edb/ref 17592186055689}} {:db/id #edb/ref 17592186055689 :step/content {:db/id #edb/ref 17592186054705 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054352 :question/id #uuid "0dfa49be-7dbf-51b4-bf95-e4994cd769d2" :question/math-academy-id "e-1070"} :knowledge-point/id #uuid "360ffb58-b8b5-523d-bfe2-eb40e6eb7345" :knowledge-point/questions [{:db/id #edb/ref 17592186055119} {:db/id #edb/ref 17592186055433} {:db/id #edb/ref 17592186480672}] :knowledge-point/title "Using the Product Rule with Three or More Terms"} :step/id #uuid "ba6c3a6b-298d-583e-9823-7d6417807493" :step/math-academy-id 3513 :step/next {:db/id #edb/ref 17592186055690}} {:db/id #edb/ref 17592186055690 :step/content {:db/id #edb/ref 17592186054706 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054353 :question/id #uuid "dbd05bab-1b11-508b-ab4a-f2667a97de28" :question/math-academy-id "e-1071"} :knowledge-point/id #uuid "4f8634cb-7384-535a-b2de-a743be54dbdb" :knowledge-point/questions [{:db/id #edb/ref 17592186055008} {:db/id #edb/ref 17592186055118} {:db/id #edb/ref 17592186480640}] :knowledge-point/title "Using the Product Rule with Multiple Variables"} :step/id #uuid "5f4ea114-3782-5716-a7d3-7fe239374a1d" :step/math-academy-id 3515}] :activity/title "The Product Rule for Exponents With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054921}]}
