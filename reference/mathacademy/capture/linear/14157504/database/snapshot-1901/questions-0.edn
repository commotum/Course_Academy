#{[{:db/id #edb/ref 17592186054351 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054704 :knowledge-point/id #uuid "2253ac13-3eee-5385-b774-8340a57b468e" :knowledge-point/title "Using the Product Rule with Two Terms"}] :question/id #uuid "3e60b147-6f6c-585b-8daf-d4499f989cef" :question/math-academy-id "e-1069" :question/problem "Simplify $a^{9}\\cdot a^{7}.$" :question/worked-solution "We add the exponents, as follows:\n\n$$\n\\begin{aligned}{a}^{9}\\cdot {a}^{7} & = \\\\ {a}^{9+7} & = \\\\ {a}^{16}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054352 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054705 :knowledge-point/id #uuid "360ffb58-b8b5-523d-bfe2-eb40e6eb7345" :knowledge-point/title "Using the Product Rule with Three or More Terms"}] :question/id #uuid "0dfa49be-7dbf-51b4-bf95-e4994cd769d2" :question/math-academy-id "e-1070" :question/problem "Find $n$ such that $x^2\\cdot x^3 \\cdot x^4 = x^n$ is correct." :question/worked-solution "We add the exponents, as follows:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {x}^{3}\\cdot {x}^{4} & = \\\\ {x}^{2+3+4} & = \\\\ {x}^{9}\\end{aligned}\n$$\n\nTherefore $x^{n}=x^9$, so $n=9.$"}] [{:db/id #edb/ref 17592186054353 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054706 :knowledge-point/id #uuid "4f8634cb-7384-535a-b2de-a743be54dbdb" :knowledge-point/title "Using the Product Rule with Multiple Variables"}] :question/id #uuid "dbd05bab-1b11-508b-ab4a-f2667a97de28" :question/math-academy-id "e-1071" :question/problem "Simplify $x\\left(x^3 y^5\\right) \\left(x^2 y^9\\right).$" :question/worked-solution "Here we have two variables, $x$ and $y.$ We will start by grouping the two variables separately: \n\n$$\n\\begin{aligned}x({x}^{3}{y}^{5})({x}^{2}{y}^{9}) & = \\\\ {x}^{1}\\cdot {x}^{3}\\cdot {y}^{5}\\cdot {x}^{2}\\cdot {y}^{9} & = \\\\ ({x}^{1}\\cdot {x}^{3}\\cdot {x}^{2})({y}^{5}\\cdot {y}^{9})\\end{aligned}\n$$\n\nThis way, we can apply the product rule to the two variables independently:\n\n$$\n\\begin{aligned}({x}^{1}\\cdot {x}^{3}\\cdot {x}^{2})({y}^{5}\\cdot {y}^{9}) & = \\\\ {x}^{(1+3+2)}\\cdot {y}^{(5+9)} & = \\\\ {x}^{6}{y}^{14}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055118 :knowledge-point/_questions [{:db/id #edb/ref 17592186054706 :knowledge-point/id #uuid "4f8634cb-7384-535a-b2de-a743be54dbdb" :knowledge-point/title "Using the Product Rule with Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "026f402f-4f08-5e98-9638-1f92ff4899a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{b}^{18}\\cdot {c}^{11}" :db/id #edb/ref 17592186480114} {:answer/id #uuid "1a3209b9-00a2-5a1a-a7a0-639a1f4a7573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{b}^{4}\\cdot {c}^{3}" :db/id #edb/ref 17592186480152} {:answer/id #uuid "81252667-4f78-5e9b-ba67-141d2bb31903" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{b}^{7}\\cdot {c}^{6}" :db/id #edb/ref 17592186480326} {:answer/id #uuid "ee7d415e-0961-5b0a-98e7-925e1bdf7a10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{b}^{14}\\cdot {c}^{14}" :db/id #edb/ref 17592186480504} {:answer/id #uuid "f0e41fa0-f099-5121-8725-02fe13cbd7b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{b}^{6}\\cdot {c}^{7}" :db/id #edb/ref 17592186480507}] :answer-field/correct {:answer/id #uuid "ee7d415e-0961-5b0a-98e7-925e1bdf7a10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{b}^{14}\\cdot {c}^{14}" :db/id #edb/ref 17592186480504} :answer-field/id #uuid "7ed94865-1e1c-5e1b-820d-0d74db0d957f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186052076}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5376669b-d519-5bda-b07f-57fecc79f283" :question/math-academy-id "q-22278" :question/problem "Use exponents to rewrite the product $b\\cdot {b}^{2}\\cdot {c}^{3}\\cdot {b}^{4}\\cdot {c}^{5}\\cdot {c}^{6}\\cdot {b}^{7}.$" :question/worked-solution "Here we have two variables, $b$ and $c.$ We will start by grouping the two variables separately: \n\n$$\n\\begin{aligned}b\\cdot {b}^{2}\\cdot {c}^{3}\\cdot {b}^{4}\\cdot {c}^{5}\\cdot {c}^{6}\\cdot {b}^{7} & = \\\\ {b}^{1}\\cdot {b}^{2}\\cdot {b}^{4}\\cdot {b}^{7}\\cdot {c}^{3}\\cdot {c}^{5}\\cdot {c}^{6} & = \\\\ ({b}^{1}\\cdot {b}^{2}\\cdot {b}^{4}\\cdot {b}^{7})\\cdot ({c}^{3}\\cdot {c}^{5}\\cdot {c}^{6})\\end{aligned}\n$$\n\nThis way, we can apply the product rule to the two variables independently:\n\n$$\n\\begin{aligned}({b}^{1}\\cdot {b}^{2}\\cdot {b}^{4}\\cdot {b}^{7})\\cdot ({c}^{3}\\cdot {c}^{5}\\cdot {c}^{6}) & = \\\\ {b}^{(1+2+4+7)}\\cdot {c}^{(3+5+6)} & = \\\\ {b}^{14}{c}^{14}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186480640 :knowledge-point/_questions [{:db/id #edb/ref 17592186054706 :knowledge-point/id #uuid "4f8634cb-7384-535a-b2de-a743be54dbdb" :knowledge-point/title "Using the Product Rule with Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ca88955-2551-56b5-ae77-f58ffc8d46ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{2}\\cdot {3}^{3}" :db/id #edb/ref 17592186480158} {:answer/id #uuid "20a27ccd-ef69-5159-a07a-6bb960f42037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{3}\\cdot 3" :db/id #edb/ref 17592186480166} {:answer/id #uuid "23e3fcda-86fd-5c67-80ac-0a18aa283291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{3}\\cdot {3}^{2}" :db/id #edb/ref 17592186480170} {:answer/id #uuid "95450425-9751-51d9-bdf4-48d8be8b762f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math