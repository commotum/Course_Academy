/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186053837} {:answer/id #uuid "058f57b6-69a1-5c96-a926-b724d9247e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186053838} {:answer/id #uuid "11b0caef-0521-5db9-ab0e-68cefd11fa36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186053839} {:answer/id #uuid "3c5c5f87-1f78-5af6-b291-64fb3352abbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186053840}] :answer-field/correct {:answer/id #uuid "d6c82e08-3970-5a05-a527-9b764895c146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186053836} :answer-field/id #uuid "812f4b49-4a29-5638-9567-f2108887e56e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186053835}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5329f7f5-2259-50ff-a14e-44701ea00a75" :question/math-academy-id "q-60566" :question/problem "Find $n$ such that  ${z}^{5}\\cdot {z}^{7}\\cdot {z}^{2}={z}^{n}$  is correct." :question/worked-solution "We add the exponents, as follows:\n\n$$\n\\begin{aligned}{z}^{5}\\cdot {z}^{7}\\cdot {z}^{2} & = \\\\ {z}^{5+7+2} & = \\\\ {z}^{14}\\end{aligned}\n$$\n\nTherefore ${z}^{n}={z}^{14}$, so $n=14.$"}]}
