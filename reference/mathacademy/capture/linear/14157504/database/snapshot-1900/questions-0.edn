#{[{:db/id #edb/ref 17592186054351 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054704 :knowledge-point/id #uuid "2253ac13-3eee-5385-b774-8340a57b468e" :knowledge-point/title "Using the Product Rule with Two Terms"}] :question/id #uuid "3e60b147-6f6c-585b-8daf-d4499f989cef" :question/math-academy-id "e-1069" :question/problem "Simplify $a^{9}\\cdot a^{7}$." :question/worked-solution "We add the exponents, as follows:\n\n$$\n\\begin{aligned}\na^{9} \\cdot a^{7} &=  \\\\\na^{9 + 7} &=  \\\\\n&= a^{16}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054352 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054705 :knowledge-point/id #uuid "360ffb58-b8b5-523d-bfe2-eb40e6eb7345" :knowledge-point/title "Using the Product Rule with Three or More Terms"}] :question/id #uuid "0dfa49be-7dbf-51b4-bf95-e4994cd769d2" :question/math-academy-id "e-1070" :question/problem "Find $n$ such that $x^2\\cdot x^3 \\cdot x^4 = x^n$ is correct." :question/worked-solution "We add the exponents, as follows:\n\n$$\n\\begin{aligned}\nx^{2} \\cdot x^{3} \\cdot x^{4} &=  \\\\\nx^{2 + 3 + 4} &=  \\\\\n&= x^{9}\n\\end{aligned}\n$$\n\nTherefore $x^{n}=x^9$, so $n=9$."}] [{:db/id #edb/ref 17592186054353 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186054706 :knowledge-point/id #uuid "4f8634cb-7384-535a-b2de-a743be54dbdb" :knowledge-point/title "Using the Product Rule with Multiple Variables"}] :question/id #uuid "dbd05bab-1b11-508b-ab4a-f2667a97de28" :question/math-academy-id "e-1071" :question/problem "Simplify $x\\left(x^3 y^5\\right) \\left(x^2 y^9\\right)$." :question/worked-solution "Here we have two variables, $x$ and $y$. We will start by grouping the two variables separately:\n\n$$\n\\begin{aligned}\nx(x^{3}y^{5})(x^{2}y^{9}) &=  \\\\\nx^{1} \\cdot x^{3} \\cdot y^{5} \\cdot x^{2} \\cdot y^{9} &=  \\\\\n&= (x^{1} \\cdot x^{3} \\cdot x^{2})(y^{5} \\cdot y^{9})\n\\end{aligned}\n$$\n\nThis way, we can apply the product rule to the two variables independently:\n\n$$\n\\begin{aligned}\n(x^{1} \\cdot x^{3} \\cdot x^{2})(y^{5} \\cdot y^{9}) &=  \\\\\nx^{(1 + 3 + 2)} \\cdot y^{(5 + 9)} &=  \\\\\n&= x^{6}y^{14}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055118 :knowledge-point/_questions [{:db/id #edb/ref 17592186054706 :knowledge-point/id #uuid "4f8634cb-7384-535a-b2de-a743be54dbdb" :knowledge-point/title "Using the Product Rule with Multiple Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa217fb6-7a82-50b8-8211-4d977c7458a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{7} \\cdot c^{6}" :db/id #edb/ref 17592186052077} {:answer/id #uuid "b52b0434-45ca-5773-b045-df1a638e587c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{4} \\cdot c^{3}" :db/id #edb/ref 17592186052078} {:answer/id #uuid "db51f9a5-3d13-588f-8e4e-4b56b4123d75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{6} \\cdot c^{7}" :db/id #edb/ref 17592186052079} {:answer/id #uuid "2d57d024-0544-5aaf-b12a-09735ec9a9a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{14} \\cdot c^{14}" :db/id #edb/ref 17592186052080} {:answer/id #uuid "4155ce6e-397c-51e3-b0fd-c9292ad03aeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b^{18} \\cdot c^{11}" :db/id #edb/ref 17592186052081}] :answer-field/id #uuid "7ed94865-1e1c-5e1b-820d-0d74db0d957f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186052076}] :question/id #uuid "5376669b-d519-5bda-b07f-57fecc79f283" :question/math-academy-id "q-22278" :question/problem "Use exponents to rewrite the product $b \\cdot b^{2} \\cdot c^{3} \\cdot b^{4} \\cdot c^{5} \\cdot c^{6} \\cdot b^{7}$."}] [{:db/id #edb/ref 17592186055433 :knowledge-point/_questions [{:db/id #edb/ref 17592186054705 :kn