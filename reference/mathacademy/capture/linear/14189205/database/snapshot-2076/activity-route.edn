#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186502166} :activity/id #uuid "1f1e2e98-3f29-5a8d-b619-48f3bdf693dc" :activity/scope {:db/id #edb/ref 17592186049716 :topic/id #uuid "0da24e9b-3685-5d19-9e02-0c5f09170003" :topic/math-academy-id 1240} :activity/steps [{:db/id #edb/ref 17592186502166 :step/content {:db/id #edb/ref 17592186502153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b074387-ea1b-58a9-8455-29e4ebdf026b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-3x+\\frac{3}{2}" :db/id #edb/ref 17592186501602} {:answer/id #uuid "540d2aca-caaa-5a05-b71c-086789c0ec35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{3}{2}x" :db/id #edb/ref 17592186501621} {:answer/id #uuid "a68bbf07-cefa-5dff-9f31-335abf2135e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x+3" :db/id #edb/ref 17592186501789} {:answer/id #uuid "d4d94deb-f953-5c29-852d-1230348acbe6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-3x+3" :db/id #edb/ref 17592186501889} {:answer/id #uuid "d5c65083-63b9-5502-80e5-5b8c67db5cc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{3}{2}x+3" :db/id #edb/ref 17592186501891}] :answer-field/correct {:db/id #edb/ref 17592186501891} :answer-field/id #uuid "98f6c907-31fa-5398-b9b9-cd18dddbc8ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502029}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d734e86c-2f4c-5a69-bdfa-2077440bd884" :question/math-academy-id "q-44192" :question/problem "![](images/db/dbf33e6d3a9e1efb4d0217f9076b0eb1381ea7d7fa9efa7ef7759b1c0e20175c.png)\n\nThe line shown above passes through the points $(0,3)$ and $(2,0).$ What is the equation of the line?" :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFrom the graph, we see that the line intercepts the $y$-axis at $(0,3).$ So, the $y$-intercept is $b=3.$\n\nWe can calculate the slope of the line by choosing two points on the line and applying the slope formula. The line passes through the points $(0,3)$ and $(2,0),$ so we calculate its slope as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{0-3}{2-0} \\\\  & =\\frac{-3}{2} \\\\  & =-\\frac{3}{2}\\end{aligned}\n$$\n\nSubstituting the slope $m=-\\frac{3}{2}$ and the $y$-intercept $b=3$ into the slope-intercept form $y=mx+b,$ we obtain the equation of the line:\n\n$$\ny=-\\frac{3}{2}x+3\n$$"} :step/id #uuid "07cd0f42-e686-5aa2-b3b0-7e07e394a2c4" :step/next {:db/id #edb/ref 17592186502167}} {:db/id #edb/ref 17592186502167 :step/content {:db/id #edb/ref 17592186101258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155d28bd-5a1b-53d1-a062-ce10c04fe049" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}x+1" :db/id #edb/ref 17592186501508}] :answer-field/correct {:db/id #edb/ref 17592186501508} :answer-field/id #uuid "f1f3cddf-9336-5732-ad3e-9ab0c3ba2047" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186098879}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "78b15dc1-cbef-5898-ab15-04cac6cf3f71" :question/math-academy-id "q-178577" :question/problem "![](images/05/051c906be77d7e12a778449883a630c3b24f92b84ae7dac3d93b1787824f9c0c.png)\n\nConsider the line shown above, which has a slope of $\\frac{2}{3}.$ The equation of the line is $y=${{field-1}}." :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ We know that the slope is $m=\\frac{2}{3},$ so we just need to work out $y$-intercept $b.$\n\nFrom the graph, we see that the line passes through the point $(3,3).$ Substituting this into $y=mx+b$ with $m=\\frac{2}{3}$ and solving for $b,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{2}{3}x+b \\\\ 3 & =\\frac{2}{3}(3)+b \\\\ 3 & =2+b \\\\ b & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the line is $y=\\frac{2}{3}x+1.$"} :step/id #uuid "0c73f501-a6b3-5d8e-af7b-d2238fefcc83" :step/next {:db/id #edb/ref 17592186502214}} {:db/id #edb/ref 17592186502214 :step/content {:db/id #edb/ref 17592186502126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c85bc99-52ec-513c-89c2-e3beaf6434b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}x+2" :db/id #edb/ref 17592186501489}] :answer-field/correct {:db/id #edb/ref 17592186501489} :answer-field/id #uuid "55a4f4df-f97d-5fe3-9f2f-2745efb5c93c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186502004}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9340bec6-b3d6-57e0-89a1-d4e7fb7357f7" :question/math-academy-id "q-179508" :question/problem "Written in the form $y=mx+b,$ what is the equation of the line that passes through the points $(6,-2)$ and $(0,2)?$\n\nThe equation of the line is $y=$\n{{field-1}}." :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So, we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFirst, we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{2-(-2)}{0-6} \\\\  & =\\frac{2+2}{0-6} \\\\  & =\\frac{4}{-6} \\\\  & =-\\frac{2}{3}\\end{aligned}\n$$\n\nThe coordinates of the $y$-intercept are always $(0,b).$ We know that the line passes through the point $(0,2),$ so the $y$-intercept is $b=2.$  \n\nSubstituting the slope $m=-\\frac{2}{3}$ and the $y$-intercept $b=2$ into the slope-intercept formula $y=mx+b,$ we reach\n\n$$\ny=-\\frac{2}{3}x+2.\n$$"} :step/id #uuid "febf91cb-77cd-5e1e-bba8-c5ccf63dd284"}] :activity/title "Equations of Lines in Slope-Intercept Form" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186501452}]}
