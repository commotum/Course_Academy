ey "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521373}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ddd958f-3ed8-5647-8898-4f321748c5a0" :question/math-academy-id "q-124397" :question/problem "$\\frac{4!}{0!}=$" :question/worked-solution "The given expression is a quotient of two factorials.\n\n- Computing $4!$ using the definition, we get\n\n$$\n4!=4\\cdot 3\\cdot 2\\cdot 1=24.\n$$\n\n- By definition, the factorial of zero equals one:\n\n$$\n0!=1\n$$\n\nFinally, we can evaluate the given expression:\n\n$$\n\\begin{aligned}\\frac{4!}{0!} & =\\frac{24}{1}=24\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287963 :knowledge-point/_questions [{:db/id #edb/ref 17592186083218 :knowledge-point/id #uuid "203386bf-cdf1-5a78-92fd-36fababfb971" :knowledge-point/title "Evaluating a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f266ba-625d-50b2-8955-a31b643ccb22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{60}" :db/id #edb/ref 17592186284849} {:answer/id #uuid "5a741793-ec05-5b38-b353-badec08e03c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3\\,250}" :db/id #edb/ref 17592186285615} {:answer/id #uuid "72ca56e0-74f1-5064-9dc4-111d865e3ecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{520}" :db/id #edb/ref 17592186285844} {:answer/id #uuid "deb3d7db-8add-55bf-b80b-e6b72f1491bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8\\,640}" :db/id #edb/ref 17592186286814} {:answer/id #uuid "ed6d2808-42d6-50a7-ac51-9cae0b39cbd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4\\,320}" :db/id #edb/ref 17592186286964}] :answer-field/correct {:answer/id #uuid "deb3d7db-8add-55bf-b80b-e6b72f1491bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8\\,640}" :db/id #edb/ref 17592186286814} :answer-field/id #uuid "3bebb173-a092-52ea-b332-24d187f1c4da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287271}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "530cc791-45d7-57ef-b0ee-6c5d01b9fe36" :question/math-academy-id "q-19848" :question/problem "Simplify $\\frac{1!\\,2!}{3!\\,4!\\,5!}.$" :question/worked-solution "First, notice that $5!=5\\cdot 4\\cdot 3\\cdot 2!.$ Then, we can cancel the $2!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{1!\\,2!}{3!\\,4!\\,5!} & =\\frac{1\\cdot 2!}{(3\\cdot 2\\cdot 1)(4\\cdot 3\\cdot 2\\cdot 1)(5\\cdot 4\\cdot 3\\cdot 2!)} \\\\  & =\\frac{1\\cdot \\cancel{2!}}{3\\cdot 2\\cdot 4\\cdot 3\\cdot 2\\cdot 5\\cdot 4\\cdot 3\\cdot \\cancel{2!}} \\\\  & =\\frac{1}{8\\,640}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521489 :knowledge-point/_questions [{:db/id #edb/ref 17592186083218 :knowledge-point/id #uuid "203386bf-cdf1-5a78-92fd-36fababfb971" :knowledge-point/title "Evaluating a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0003b6a0-5b7b-5381-804b-be2455c24eb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{41}{55}" :db/id #edb/ref 17592186520763} {:answer/id #uuid "410a4aff-aef1-5924-8451-5151ee0e274c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{37}{39}" :db/id #edb/ref 17592186520910} {:answer/id #uuid "4bae973c-05f8-5a5a-8c78-b86861e2dead" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{41}{45}" :db/id #edb/ref 17592186520937} {:answer/id #uuid "70c9be2b-110b-59cb-a769-21670ee903ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{42}{47}" :db/id #edb/ref 17592186521017} {:answer/id #uuid "9ebab680-be6e-5ffe-9c35-9bf5106eba27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31}{35}" :db/id #edb/ref 17592186521122}] :answer-field/correct {:answer/id #uuid "4bae973c-05f8-5a5a-8c78-b86861e2dead" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{41}{45}" :db/id #edb/ref 17592186520937} :answer-field/id #uuid "8d1abfb3-22d4-511b-944b-e2271fb0f05d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521395}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3e9e4e75-7918-575f-a18d-8c831116251f" :question/math-academy-id "q-19873" :question/problem "Simplify $\\frac{89!\\,82!}{90!\\,81!}.$" :question/worked-solution "First, notice that $90!=90\\cdot 89!$ and $82!=82\\cdot 81!\\,.$ Then, we can cancel the $89!$ and $81!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{89!\\,82!}{90!\\,81!} & =\\frac{89!\\,\\cdot 82\\cdot 81!}{90\\cdot 89!\\,\\cdot 81!} \\\\  & =\\frac{\\cancel{89!\\,}\\cdot 82\\cdot \\cancel{81!}}{90\\cdot \\cancel{89!\\,}\\cdot \\cancel{81!}} \\\\  & =\\frac{82}{90} \\\\  & =\\frac{41}{45}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083926 :knowledge-point/_questions [{:db/id #edb/ref 17592186083217 :knowledge-point/id #uuid "bc445253-146a-5448-9bf3-d5b6c0d4c1f0" :knowledge-point/title "Evaluating Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87cdca9b-5276-5e45-bab8-274a3e6dfee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186082488} {:answer/id #uu