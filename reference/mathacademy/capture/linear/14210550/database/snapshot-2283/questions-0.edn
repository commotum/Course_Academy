#{[{:db/id #edb/ref 17592186083017 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083217 :knowledge-point/id #uuid "bc445253-146a-5448-9bf3-d5b6c0d4c1f0" :knowledge-point/title "Evaluating Factorials"}] :question/id #uuid "9ad07c38-8ace-5900-818d-34ccacc8ee11" :question/math-academy-id "e-5667" :question/problem "$5!\\,2!=$" :question/worked-solution "The given expression is a product of two factorials.\n\n- Computing $5!$ using the definition, we get\n\n$$\n5! = 5 \\cdot 4 \\cdot 3 \\cdot 2 \\cdot 1 = 120.\n$$\n\n- Computing $2!$ using the definition, we get\n\n$$\n2! = 2 \\cdot 1 = 2.\n$$\n\nFinally, we can evaluate the given expression:\n\n$$\n\\begin{aligned}5!\\,2! & =5!\\cdot 2! \\\\  & =120\\cdot 2 \\\\  & =240\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083018 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083218 :knowledge-point/id #uuid "203386bf-cdf1-5a78-92fd-36fababfb971" :knowledge-point/title "Evaluating a Quotient of Factorials"}] :question/id #uuid "22af250d-d219-5003-b972-aa912a0d6ee1" :question/math-academy-id "e-5668" :question/problem "Evaluate $\\dfrac {5!} {2!}.$" :question/worked-solution "First, notice that $5! = 5 \\cdot 4 \\cdot 3 \\cdot 2! \\, .$ Then, we can cancel the $2!$ that occurs in both the numerator and the denominator:\n\n$$\n\\require{cancel}\n\t\\eqalign{\n\\dfrac {5!} {2!} \n&= \\dfrac {5 \\cdot 4 \\cdot 3 \\cdot 2!} {2!} \\[5pt]\n\n&= \\dfrac {5 \\cdot 4 \\cdot 3 \\cdot  \\cancel{2!}} {\\cancel{2!}} \\[5pt]\n&= \t\t\\dfrac {5 \\cdot 4 \\cdot 3} {1} \\[5pt]\n&= \n\t\t60\n\t}\n$$"}] [{:db/id #edb/ref 17592186083137 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083335 :knowledge-point/id #uuid "8d084334-b89a-5a33-9373-086018cdfbc3" :knowledge-point/title "Evaluating the Factorial of Zero"}] :question/id #uuid "95e6de18-9036-55d2-a1cc-1be931c76d3f" :question/math-academy-id "e-9519" :question/problem "Calculate $\\dfrac{5!}{0!}.$" :question/worked-solution "The given expression is a quotient of two factorials.\n\n- Computing $5!$ using the definition, we get\n\n$$\n5! = 5 \\cdot 4 \\cdot 3 \\cdot 2 \\cdot 1 = 120.\n$$\n\n- By definition, the factorial of zero equals one:\n\n$$\n0! = 1\n$$\n\nFinally, we can evaluate the given expression:\n\n$$\n\\begin{aligned}\\frac{5!}{0!} & =\\frac{120}{1}=120\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521502 :knowledge-point/_questions [{:db/id #edb/ref 17592186083217 :knowledge-point/id #uuid "bc445253-146a-5448-9bf3-d5b6c0d4c1f0" :knowledge-point/title "Evaluating Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9d3a921-84b6-5973-90d4-323de837035b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "362\\,880" :db/id #edb/ref 17592186521177} {:answer/id #uuid "c40a534d-df67-5fc4-b3d3-ddc328582726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\,320" :db/id #edb/ref 17592186521201} {:answer/id #uuid "ca73191b-b2e3-5dbb-8810-8b286230a0c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60\\,480" :db/id #edb/ref 17592186521218} {:answer/id #uuid "e93959a6-6322-56d2-a4a1-532787d89221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "181\\,440" :db/id #edb/ref 17592186521284} {:answer/id #uuid "f54f2cd6-56b9-59bd-98f1-25f8225ccde2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,024" :db/id #edb/ref 17592186521300}] :answer-field/correct {:answer/id #uuid "b9d3a921-84b6-5973-90d4-323de837035b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "362\\,880" :db/id #edb/ref 17592186521177} :answer-field/id #uuid "c7742e3f-6c18-573d-b40a-6b9885cf2856" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521427}] :question/difficulty {:db/id #edb/