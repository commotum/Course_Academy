ices [{:answer/id #uuid "39c6cec7-fb7f-5231-bc44-6a56b8fa44e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186410244} {:answer/id #uuid "62f4e82c-ba7f-5fb6-98b7-100ff6e0921a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186410267} {:answer/id #uuid "6d486faf-5316-5114-8d73-0b4810f9441a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186410275} {:answer/id #uuid "980b2551-0ea6-5316-bab6-4baecfe33889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186410300} {:answer/id #uuid "b4cd9ab6-bf31-51da-869a-ffbc665155cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186410326}] :answer-field/correct {:answer/id #uuid "980b2551-0ea6-5316-bab6-4baecfe33889" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186410300} :answer-field/id #uuid "2f94bc8f-6c0f-50a3-8936-bf86f03998e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410380}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73ac4960-30ae-5f42-9db9-54e717e4f3da" :question/math-academy-id "q-73017" :question/problem "Simplify $\\frac{9!\\text{ }5!}{7!\\text{ }6!}.$" :question/worked-solution "First, notice that $9!=9\\cdot 8\\cdot 7!$ and $6!=6\\cdot 5!\\,.$ Then, we can cancel the $7!$ and $5!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{9!\\text{ }5!}{7!\\text{ }6!} & =\\frac{9\\cdot 8\\cdot 7!\\cdot 5!}{7!\\cdot 6\\cdot 5!} \\\\  & =\\frac{9\\cdot 8\\cdot \\cancel{7!}\\cdot \\cancel{5!}}{\\cancel{7!}\\cdot 6\\cdot \\cancel{5!}} \\\\  & =\\frac{9\\cdot 8}{6} \\\\  & =12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186521496 :knowledge-point/_questions [{:db/id #edb/ref 17592186083218 :knowledge-point/id #uuid "203386bf-cdf1-5a78-92fd-36fababfb971" :knowledge-point/title "Evaluating a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4460ffde-f366-5f49-aab2-737efad5edb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{70}{3}" :db/id #edb/ref 17592186520918} {:answer/id #uuid "6a9bb3aa-6b51-58d8-b1af-91bd45411a7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{9}" :db/id #edb/ref 17592186521006} {:answer/id #uuid "931dbc23-be9e-59e3-b1e8-6992aca17d8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186521098} {:answer/id #uuid "e1fcab41-7953-57bc-bd9e-0e87d2ab73d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{140}{3}" :db/id #edb/ref 17592186521270} {:answer/id #uuid "fc98e19a-9d26-58be-a66b-509f498db309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186521318}] :answer-field/correct {:answer/id #uuid "e1fcab41-7953-57bc-bd9e-0e87d2ab73d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{140}{3}" :db/id #edb/ref 17592186521270} :answer-field/id #uuid "38b7fe1e-34c3-508a-8ffa-6a2b08675b26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521356}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4e0bd81c-fffc-5b90-b2d5-10d251044393" :question/math-academy-id "q-73019" :question/problem "Simplify $\\frac{8!\\,5!}{3!\\,4!\\,6!}.$" :question/worked-solution "First, notice that $8!=8\\cdot 7\\cdot 6!$ and $5!=5\\cdot 4!$ . Then, we can cancel the $6!$ and $4!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{8!\\,5!}{3!\\,4!\\,6!} & =\\frac{8\\cdot 7\\cdot 6!\\cdot 5\\cdot 4!}{3!\\cdot 4!\\cdot 6!} \\\\  & =\\frac{8\\cdot 7\\cdot \\cancel{6!}\\cdot 5\\cdot \\cancel{4!}}{3!\\cdot \\cancel{4!}\\cdot \\cancel{6!}} \\\\  & =\\frac{8\\cdot 7\\cdot 5}{3\\cdot 2\\cdot 1} \\\\  & =\\frac{140}{3}.\\end{aligned}\n$$"}]}
