#{[{:db/id #edb/ref 17592186083017 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083217 :knowledge-point/id #uuid "bc445253-146a-5448-9bf3-d5b6c0d4c1f0" :knowledge-point/title "Evaluating Factorials"}] :question/id #uuid "9ad07c38-8ace-5900-818d-34ccacc8ee11" :question/math-academy-id "e-5667" :question/problem "$5!\\,2!=$" :question/worked-solution "The given expression is a product of two factorials.\n\n- Computing $5$! using the definition, we get\n$5! = 5 \\cdot 4 \\cdot 3 \\cdot 2 \\cdot 1 = 120$.\n- Computing $2$! using the definition, we get\n$2! = 2 \\cdot 1 = 2$.\n\nFinally, we can evaluate the given expression:\n\n$$\n\\begin{aligned}\n5!2! &= 5! \\cdot 2! \\\\\n&= 120 \\cdot 2 \\\\\n&= 240\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083018 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083218 :knowledge-point/id #uuid "203386bf-cdf1-5a78-92fd-36fababfb971" :knowledge-point/title "Evaluating a Quotient of Factorials"}] :question/id #uuid "22af250d-d219-5003-b972-aa912a0d6ee1" :question/math-academy-id "e-5668" :question/problem "Evaluate $\\dfrac {5!} {2!}$." :question/worked-solution "First, notice that\n\n$$\n5! = 5 \\cdot 4 \\cdot 3 \\cdot 2! \\,\n$$\n\nThen, we can cancel the $2$! that occurs in both the numerator and the denominator:\n\n$$\n\\require{cancel} \\begin{aligned} \\dfrac {5!} {2!} &= \\dfrac {5 \\cdot 4 \\cdot 3 \\cdot 2!} {2!} \\\\[5pt] &= \\dfrac {5 \\cdot 4 \\cdot 3 \\cdot \\cancel{2!}} {\\cancel{2!}} \\\\[5pt] &= \\dfrac {5 \\cdot 4 \\cdot 3} {1} \\\\[5pt] &= 60 \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083137 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083335 :knowledge-point/id #uuid "8d084334-b89a-5a33-9373-086018cdfbc3" :knowledge-point/title "Evaluating the Factorial of Zero"}] :question/id #uuid "95e6de18-9036-55d2-a1cc-1be931c76d3f" :question/math-academy-id "e-9519" :question/problem "Calculate $\\dfrac{5!}{0!}$." :question/worked-solution "The given expression is a quotient of two factorials.\n\n- Computing $5$! using the definition, we get\n$5! = 5 \\cdot 4 \\cdot 3 \\cdot 2 \\cdot 1 = 120$.\n- By definition, the factorial of zero equals one:\n$0! = 1$\n\nFinally, we can evaluate the given expression:\n\n$$\n\\begin{aligned}\n\\frac{5!}{0!} &= \\frac{120}{1} = 120\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259681 :knowledge-point/_questions [{:db/id #edb/ref 17592186083335 :knowledge-point/id #uuid "8d084334-b89a-5a33-9373-086018cdfbc3" :knowledge-point/title "Evaluating the Factorial of Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23e6ed81-294e-51ba-bdbd-c9acf6e6f86d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186257085} {:answer/id #uuid "412360bb-da28-5a12-8b6a-9f48a3ecbfeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186257361} {:answer/id #uuid "567ec294-e9fa-52fb-a82c-67c3fbe5c5f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186257527} {:answer/id #uuid "724de988-dc4d-5d2c-a2b8-b031c86cdd56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186257784} {:answer/id #uuid "a27b19af-eb9f-55c6-b0c6-c04a240606b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "240" :db/id #edb/ref 17592186258204}] :answer-field/correct {:answer/id #uuid "567ec294-e9fa-52fb-a82c-67c3fbe5c5f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186257527} :answer-field/id #uuid "b578d210-8d97-5605-bd48-743bc171ebe7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259347}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6688982b-061e-548a-92f3-135ff8f3c6b0" :question/math-academy-id "q-124393" :question/problem "$5!\\,0!=$" :question/worked-solution "The given expression is a product of two factorials.\n\n- Computing $5!$ using the definition, we get\n\n$$\n5!=5\\cdot 4\\cdot 3\\cdot 2\\cdot 1=120.\n$$\n\n- By definition, the factorial of zero equals one:\n\n$$\n0!=1\n$$\n\nFinally, we can evaluate the given expression:\n\n$$\n\\begin{aligned}5!\\,0! & =120\\cdot 1=120\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287963 :knowledge-point/_questions [{:db/id #edb/ref 17592186083218 :knowledge-point/id #uuid "203386bf-cdf1-5a78-92fd-36fababfb971" :knowledge-point/title "Evaluating a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f266ba-625d-50b2-8955-a31b643ccb22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{60}" :db/id #edb/ref 17592186284849} {:answer/id #uuid "5a741793-ec05-5b38-b353-badec08e03c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3\\,250}" :db/id #edb/ref 17592186285615} {:answer/id #uuid "72ca56e0-74f1-5064-9dc4-111d865e3ecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{520}" :db/id #edb/ref 17592186285844} {:answer/id #uuid "deb3d7db-8add-55bf-b80b-e6b72f1491bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8\\,640}" :db/id #edb/ref 17592186286814} {:answer/id #uuid "ed6d2808-42d6-50a7-ac51-9cae0b39cbd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4\\,320}" :db/id #edb/ref 17592186286964}] :answer-field/correct {:answer/id #uuid "deb3d7db-8add-55bf-b80b-e6b72f1491bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8\\,640}" :db/id #edb/ref 17592186286814} :answer-field/id #uuid "3bebb173-a092-52ea-b332-24d187f1c4da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287271}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "530cc791-45d7-57ef-b0ee-6c5d01b9fe36" :question/math-academy-id "q-19848" :question/problem "Simplify $\\frac{1!\\,2!}{3!\\,4!\\,5!}.$" :question/worked-solution "First, notice that $5!=5\\cdot 4\\cdot 3\\cdot 2!.$ Then, we can cancel the $2!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{1!\\,2!}{3!\\,4!\\,5!} & =\\frac{1\\cdot 2!}{(3\\cdot 2\\cdot 1)(4\\cdot 3\\cdot 2\\cdot 1)(5\\cdot 4\\cdot 3\\cdot 2!)} \\\\  & =\\frac{1\\cdot \\cancel{2!}}{3\\cdot 2\\cdot 4\\cdot 3\\cdot 2\\cdot 5\\cdot 4\\cdot 3\\cdot \\cancel{2!}} \\\\  & =\\frac{1}{8\\,640}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083926 :knowledge-point/_questions [{:db/id #edb/ref 17592186083217 :knowledge-point/id #uuid "bc445253-146a-5448-9bf3-d5b6c0d4c1f0" :knowledge-point/title "Evaluating Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87cdca9b-5276-5e45-bab8-274a3e6dfee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186082488} {:answer/id #uuid "97f87e0f-ab42-57d6-8deb-e2d9b32ec4d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186082489} {:answer/id #uuid "c5bf44ec-4830-510d-8f15-207d4f8d0b11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186082490} {:answer/id #uuid "d292f507-d18e-5fd6-9801-177943e99480" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186082491} {:answer/id #uuid "fd651e74-c7e5-5a17-85e1-9f3b509ecb1d" :answer/type {:db/id #edb/