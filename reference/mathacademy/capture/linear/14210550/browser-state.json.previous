i></mi><mo>=</mo><mn>2</mn><mo>!</mo><mo>⋅</mo><mn>3</mn><mo>!</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mo>⋅</mo><mn>6</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>12</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
