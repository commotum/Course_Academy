#{[{:db/id #edb/ref 17592186563746 :knowledge-point/_questions [{:db/id #edb/ref 17592186110726 :knowledge-point/id #uuid "23f4cc44-569e-56bd-aaa6-b72a10970679" :knowledge-point/title "Finding the Axis of Symmetry From the Parabola’s Equation in Factored Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05ed7714-762b-563c-aa6e-395fc6bb299a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}" :db/id #edb/ref 17592186562950} {:answer/id #uuid "12226c0d-85bd-508b-82d8-13bf97d8f83b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{5}" :db/id #edb/ref 17592186562981} {:answer/id #uuid "3bd14c1c-2112-52ab-bcdc-5d7b174123b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{3}{5}" :db/id #edb/ref 17592186563079} {:answer/id #uuid "55af48ee-55a1-5c40-847d-5742b568cea0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{2}{5}" :db/id #edb/ref 17592186563140} {:answer/id #uuid "f8844c5c-08d4-51a1-8c11-9ac8c49c3885" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{5}" :db/id #edb/ref 17592186563501}] :answer-field/correct {:answer/id #uuid "05ed7714-762b-563c-aa6e-395fc6bb299a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}" :db/id #edb/ref 17592186562950} :answer-field/id #uuid "707a53ec-3f89-531c-a47b-914f51a9c97c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186563571}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "da0e0865-56b2-565d-ac33-deaee1268cf4" :question/math-academy-id "q-84903" :question/problem "Find the axis of symmetry of the parabola $y=(7-5x)(x+1).$" :question/worked-solution "From the equation $y=(7-5x)(x+1),$ we find that the roots of the parabola are ${x}_{1}=\\frac{7}{5}$ and ${x}_{2}=-1.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(\\frac{7}{5}-1)}{2} \\\\  & =\\frac{(\\frac{7}{5}-\\frac{5}{5})}{2} \\\\  & =\\frac{(\\frac{2}{5})}{2} \\\\  & =\\frac{1}{5}\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=\\frac{1}{5}.$"}]}
