#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186111692} :activity/id #uuid "a1f0ae8e-6f0b-56b6-a410-3e3ca9e6eda7" :activity/scope {:db/id #edb/ref 17592186050577 :topic/id #uuid "5555aaf2-f73f-5c86-8f74-5c76cb5a6f50" :topic/math-academy-id 1451} :activity/steps [{:db/id #edb/ref 17592186111692 :step/content {:db/id #edb/ref 17592186111921 :tutorial/content "If a parabola has two roots, the axis of symmetry occurs precisely halfway between the roots of the parabola. Therefore, we can find the axis of symmetry of a parabola by finding the roots and then taking their average value. \n\nSo, if the roots are $x_1$ and $x_2,$ the **average of the roots formula** tells us that the axis of symmetry of the parabola is\n\n$$\nx = \\dfrac{x_1+x_2}{2}.\n$$\n\nFor example, let's consider the parabola \n\n$$\ny=(x+2)(x-4).\n$$\n\nWe have the roots $x_1=-2$ and $x_2=4.$ Therefore, the equation of the axis of symmetry is\n\n$$\n\\begin{aligned}x=\\frac{-2+4}{2}=1\\end{aligned}\n$$\n\nSo, the axis of symmetry of the parabola $y=(x+2)(x-4)$ is $x=1,$ as shown below.\n\n![](images/ec/ec08bc1ba75082ac98bb6559b6c0ef8119fbf245f3c266710ce8c6a569fa8a02.png)" :tutorial/id #uuid "cd361f4f-6e49-5ced-8872-2849078d909c" :tutorial/math-academy-id 9250 :tutorial/title "Introduction"} :step/id #uuid "0bf344b4-5c54-585a-ab6e-16e5a8e551f8" :step/math-academy-id 502427 :step/next {:db/id #edb/ref 17592186111693}} {:db/id #edb/ref 17592186111693 :step/content {:db/id #edb/ref 17592186110725 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110351 :question/id #uuid "30974188-c734-5e99-a9ae-81d1a53b9105" :question/math-academy-id "e-14854"} :knowledge-point/id #uuid "42832b65-324f-56f7-9cbe-c9bf43389fde" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051029}] :knowledge-point/questions [{:db/id #edb/ref 17592186110975} {:db/id #edb/ref 17592186110976} {:db/id #edb/ref 17592186111039} {:db/id #edb/ref 17592186541059} {:db/id #edb/ref 17592186541064} {:db/id #edb/ref 17592186541116} {:db/id #edb/ref 17592186555854} {:db/id #edb/ref 17592186563701} {:db/id #edb/ref 17592186563721} {:db/id #edb/ref 17592186563762}] :knowledge-point/title "Finding the Axis of Symmetry From the X-Intercepts"} :step/id #uuid "362cf052-a4cb-519a-968e-bda8b81a4551" :step/math-academy-id 502428 :step/next {:db/id #edb/ref 17592186111694}} {:db/id #edb/ref 17592186111694 :step/content {:db/id #edb/ref 17592186110726 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110352 :question/id #uuid "00575d99-28e6-59b7-b416-765808916fe5" :question/math-academy-id "e-14857"} :knowledge-point/id #uuid "23f4cc44-569e-56bd-aaa6-b72a10970679" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049244}] :knowledge-point/questions [{:db/id #edb/ref 17592186110965} {:db/id #edb/ref 17592186111405} {:db/id #edb/ref 17592186541122} {:db/id #edb/ref 17592186541127} {:db/id #edb/ref 17592186555793} {:db/id #edb/ref 17592186555801} {:db/id #edb/ref 17592186563686} {:db/id #edb/ref 17592186563705} {:db/id #edb/ref 17592186563735} {:db/id #edb/ref 17592186563746}] :knowledge-point/title "Finding the Axis of Symmetry From the Parabola’s Equation in Factored Form"} :step/id #uuid "f7dec3f3-b123-50ec-a737-75e54a076282" :step/math-academy-id 502432 :step/next {:db/id #edb/ref 17592186111695}} {:db/id #edb/ref 17592186111695 :step/content {:db/id #edb/ref 17592186110727 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110353 :question/id #uuid "405e0230-69cb-5679-bec0-13a69c722934" :question/math-academy-id "e-14860"} :knowledge-point/id #uuid "89428829-1c13-5c7e-9fc2-ffe526a4c33a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048760}] :knowledge-point/questions [{:db/id #edb/ref 17592186110977} {:db/id #edb/ref 17592186110978} {:db/id #edb/ref 17592186111040} {:db/id #edb/ref 17592186541088} {:db/id #edb/ref 17592186541106} {:db/id #edb/ref 17592186563646} {:db/id #edb/ref 17592186563653} {:db/id #edb/ref 17592186563685} {:db/id #edb/ref 17592186563697} {:db/id #edb/ref 17592186566212} {:db/id #edb/ref 17592186566249}] :knowledge-point/title "Finding an Unknown Value Given the Axis of Symmetry"} :step/id #uuid "dd4bd192-4cdd-5f22-9524-55cd3e1d3ba8" :step/math-academy-id 502435 :step/next {:db/id #edb/ref 17592186111696}} {:db/id #edb/ref 17592186111696 :step/content {:db/id #edb/ref 17592186111821 :tutorial/content "![](images/b2/b27906f92121928be444d3b7f616becbcc7a849e1313ef50accd8c8bfd718bfb.png)\n\nIf we know two points on a parabola with *identical* $y$-values, we can find the $x$-coordinate of the vertex by taking an average of the two $x$-values. \n\nFor example, consider the parabola $y=f(x)$ above. Notice that the values of $f(x)$ at the points $x=-3$ and $x=5$ are equal.\n\n$$\nf(-3) = f(5) = 3\n$$\n\nTherefore, the parabola's axis of symmetry must be equidistant from the lines $x=-3$ and $x=5.$ We can find this by taking the average of these two values.\n\nIf the parabola's vertex is $(h,k),$ then we must have\n\n$$\n\\begin{aligned}h & =\\frac{-3+5}{2} \\\\  & =\\frac{2}{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, $h=1$ is the $x$-coordinate of the vertex, and the axis of symmetry of the parabola is $x=1.$" :tutorial/id #uuid "23d4f6e0-c0a7-5551-bd88-80b3268a5b2b" :tutorial/math-academy-id 13792 :tutorial/title "Extending the Formula"} :step/id #uuid "1b132072-c297-50ce-be49-d3a763e0a32f" :step/math-academy-id 502439 :step/next {:db/id #edb/ref 17592186111697}} {:db/id #edb/ref 17592186111697 :step/content {:db/id #edb/ref 17592186110728 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110373 :question/id #uuid "04877936-271e-5fcb-a1ea-aa39c52482b6" :question/math-academy-id "e-19740"} :knowledge-point/id #uuid "9a2eed2b-7f94-5b53-bc5c-4bf9aea18d32" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048398}] :knowledge-point/questions [{:db/id #edb/ref 17592186111153} {:db/id #edb/ref 17592186111154} {:db/id #edb/ref 17592186541070} {:db/id #edb/ref 17592186541071} {:db/id #edb/ref 17592186563654} {:db/id #edb/ref 17592186563659} {:db/id #edb/ref 17592186563728} {:db/id #edb/ref 17592186563739} {:db/id #edb/ref 17592186563740}] :knowledge-point/title "Calculating the Vertex of a Parabola From Table Data"} :step/id #uuid "f7518575-386c-57e6-893c-6238e3cc01a1" :step/math-academy-id 502440}] :activity/title "The Average of the Roots Formula" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186110824}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186555957} :activity/id #uuid "922fea49-6b8a-58c7-b90e-f0eeab5445ca" :activity/scope {:db/id #edb/ref 17592186050577 :topic/id #uuid "5555aaf2-f73f-5c86-8f74-5c76cb5a6f50" :topic/math-academy-id 1451} :activity/steps [{:db/id #edb/ref 17592186555917 :step/content {:db/id #edb/ref 17592186555801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ca5d762-c81a-57fc-9843-502e7d1af843" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{1}{2}" :db/id #edb/ref 17592186555171} {:answer/id #uuid "74a90c6d-2efa-51c6-a91a-aaf6755d1abb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=2" :db/id #edb/ref 17592186555263} {:answer/id #uuid "b9780710-3705-5098-9242-2c8b7fe1151f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=6" :db/id #edb/ref 17592186555442} {:answer/id #uuid "dccfbbc1-9cf7-51b9-ac74-1a8d552f82e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-6" :db/id #edb/ref 17592186555536} {:answer/id #uuid "ebb0e4ca-74ad-5d0c-b490-4cbfbd48e530" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-1" :db/id #edb/ref 17592186555580}] :answer-field/correct {:db/id #edb/ref 17592186555580} :answer-field/id #uuid "633578f8-1fcc-5369-8160-ab9262e6ed6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555688}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4f8a844e-8d7a-52ec-932d-abb0df6525f2" :question/math-academy-id "q-106157" :question/problem "Find the axis of symmetry for the parabola $y=-(x-5)(x+7).$" :question/worked-solution "From the equation $y=-(x-5)(x+7),$ we find that the roots of the parabola are ${x}_{1}=5$ and ${x}_{2}=-7.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{5+(-7)}{2} \\\\  & =-1.\\end{aligned}\n$$\n\n \n\nTherefore, the axis of symmetry is $x=-1.$"} :step/id #uuid "7d16b69a-5a84-5d56-969f-c9e96234e18c" :step/next {:db/id #edb/ref 17592186555938}} {:db/id #edb/ref 17592186555938 :step/content {:db/id #edb/ref 17592186555793 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fb5a3b2-6779-5f18-aee9-35c71d01843c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186555296}] :answer-field/correct {:db/id #edb/ref 17592186555296} :answer-field/id #uuid "ff2d3b83-418c-57aa-abbd-ad23104f3a79" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186555757}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3c9a4b7b-8e3b-5aa3-8825-873abec27dfc" :question/math-academy-id "q-223666" :question/problem "The axis of symmetry of the parabola $y=(x-1)(x-9)$ is $x=${{field-1}}." :question/worked-solution "From the equation $y=(x-1)(x-9),$ we can tell that the roots of the parabola are ${x}_{1}=1$ and ${x}_{2}=9.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{1+9}{2} \\\\  & =\\frac{10}{2} \\\\  & =5\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=5.$"} :step/id #uuid "cd4f8847-652c-5cee-968e-bc3d8b8c3f08"} {:db/id #edb/ref 17592186555957 :step/content {:db/id #edb/ref 17592186555854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0824024b-c099-527a-8256-d5a6127f2786" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{9}{2}" :db/id #edb/ref 17592186555013} {:answer/id #uuid "2f22d275-c75b-5b64-9666-30863a46ed54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{15}{6}" :db/id #edb/ref 17592186555104} {:answer/id #uuid "4087805a-ed7e-522b-a9a2-c73758870563" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=3" :db/id #edb/ref 17592186555140} {:answer/id #uuid "76e3d3fa-3854-5450-9938-38191ec8e7d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{35}{12}" :db/id #edb/ref 17592186555274} {:answer/id #uuid "f412a256-5361-5b16-a302-db1d43b422fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=2" :db/id #edb/ref 17592186555602}] :answer-field/correct {:db/id #edb/ref 17592186555140} :answer-field/id #uuid "15067fae-69bc-5d5f-83e8-e1ebdc618e5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186555649}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c4e9e89a-1628-511a-8a61-3e91affcd33c" :question/math-academy-id "q-106134" :question/problem "![](images/8c/8cd1c9ab91a23fae12dd45078ec44ca55e69da8aa787775d7a9583857a84cb71.png)\n\nThe graph above shows a parabola. The $x$-coordinates of $A$ and $B$ are $\\frac{11}{6}$ and $\\frac{25}{6},$ respectively.  Find the axis of symmetry of the parabola." :question/worked-solution "We're given that the roots of the parabola are \n ${x}_{1}=\\frac{11}{6}$ and ${x}_{2}=\\frac{25}{6}.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(\\frac{11}{6}+\\frac{25}{6})}{2} \\\\  & =\\frac{(\\frac{36}{6})}{2} \\\\  & =\\frac{6}{2} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=3.$"} :step/id #uuid "fc0ea0dd-6d8e-54af-8a2c-d3dfe94d4d67" :step/next {:db/id #edb/ref 17592186555917}}] :activity/title "The Average of the Roots Formula" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186554996}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186566321} :activity/id #uuid "49a9bc74-71fa-5e68-804c-d56430f0f339" :activity/scope {:db/id #edb/ref 17592186050577 :topic/id #uuid "5555aaf2-f73f-5c86-8f74-5c76cb5a6f50" :topic/math-academy-id 1451} :activity/steps [{:db/id #edb/ref 17592186566287 :step/content {:db/id #edb/ref 17592186566249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70b54ca2-ba87-5256-9420-5d2e2bf07f05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186565854}] :answer-field/correct {:db/id #edb/ref 17592186565854} :answer-field/id #uuid "a7afddcb-dc24-5839-bcf0-80fc718004df" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566171}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "83c46e33-f8bd-5862-a614-a54a16643b82" :question/math-academy-id "q-220358" :question/problem "The axis of symmetry of the parabola $y=(2x+k)(x-3k)$ is $x=\\frac{1}{4}.$ Find the value of $k.$\n\n$k=$\n\n{{field-1}}" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=\\frac{1}{4},$ we will set our result equal to $\\frac{1}{4}.$ \n\nFrom the equation $y=(2x+k)(x-3k),$ we find that the roots of the parabola are ${x}_{1}=-\\frac{k}{2}$ and ${x}_{2}=3k.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-\\frac{k}{2}+3k)}{2} \\\\  & =\\frac{(\\frac{6k-k}{2})}{2} \\\\  & =\\frac{5k}{4}\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=\\frac{1}{4}.$ Therefore, we have\n\n$$\n\\begin{aligned}\\frac{5k}{4} & =\\frac{1}{4} \\\\ 5k & =1 \\\\ k & =\\frac{1}{5}.\\end{aligned}\n$$"} :step/id #uuid "3f1f4856-598c-59df-bf66-05dde605cabb" :step/next {:db/id #edb/ref 17592186566314}} {:db/id #edb/ref 17592186566314 :step/content {:db/id #edb/ref 17592186566212 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e82e1f4-a267-5040-a3a3-bab230ab5205" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186565904}] :answer-field/correct {:db/id #edb/ref 17592186565904} :answer-field/id #uuid "2c736d93-e203-5595-b533-b4a4b0df38aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566123}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "213ef30b-cee1-556f-a46a-815fdaa45856" :question/math-academy-id "q-223693" :question/problem "The axis of symmetry of the parabola $y=(x-5k)(x+7k)$ is $x=4.$ Find the value of $k.$\n\n$k=$\n\n{{field-1}}" :question/worked-solution "First, we calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=4,$ we will set our result equal to $4.$ \n\nFrom the equation $y=(x-5k)(x+7k),$ we find that the roots of the parabola are ${x}_{1}=5k$ and ${x}_{2}=-7k.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{5k+(-7k)}{2} \\\\  & =\\frac{-2k}{2} \\\\  & =-k\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=4.$ Therefore, we have\n\n$$\n\\begin{aligned}-k & =4 \\\\ k & =-4.\\end{aligned}\n$$"} :step/id #uuid "dd479361-324f-51c6-bbe1-29ac04309691"} {:db/id #edb/ref 17592186566321 :step/content {:db/id #edb/ref 17592186563746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05ed7714-762b-563c-aa6e-395fc6bb299a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{1}{5}" :db/id #edb/ref 17592186562950} {:answer/id #uuid "12226c0d-85bd-508b-82d8-13bf97d8f83b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{1}{5}" :db/id #edb/ref 17592186562981} {:answer/id #uuid "3bd14c1c-2112-52ab-bcdc-5d7b174123b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{3}{5}" :db/id #edb/ref 17592186563079} {:answer/id #uuid "55af48ee-55a1-5c40-847d-5742b568cea0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{2}{5}" :db/id #edb/ref 17592186563140} {:answer/id #uuid "f8844c5c-08d4-51a1-8c11-9ac8c49c3885" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{3}{5}" :db/id #edb/ref 17592186563501}] :answer-field/correct {:db/id #edb/ref 17592186562950} :answer-field/id #uuid "707a53ec-3f89-531c-a47b-914f51a9c97c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563571}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "da0e0865-56b2-565d-ac33-deaee1268cf4" :question/math-academy-id "q-84903" :question/problem "Find the axis of symmetry of the parabola $y=(7-5x)(x+1).$" :question/worked-solution "From the equation $y=(7-5x)(x+1),$ we find that the roots of the parabola are ${x}_{1}=\\frac{7}{5}$ and ${x}_{2}=-1.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(\\frac{7}{5}-1)}{2} \\\\  & =\\frac{(\\frac{7}{5}-\\frac{5}{5})}{2} \\\\  & =\\frac{(\\frac{2}{5})}{2} \\\\  & =\\frac{1}{5}\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=\\frac{1}{5}.$"} :step/id #uuid "fd3f6f6d-c09c-53c9-813a-5ff408b3201c" :step/next {:db/id #edb/ref 17592186566287}}] :activity/title "The Average of the Roots Formula" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186565667}]}
