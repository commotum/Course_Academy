#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186566321} :activity/id #uuid "49a9bc74-71fa-5e68-804c-d56430f0f339" :activity/scope {:db/id #edb/ref 17592186050577 :topic/id #uuid "5555aaf2-f73f-5c86-8f74-5c76cb5a6f50" :topic/math-academy-id 1451} :activity/steps [{:db/id #edb/ref 17592186566287 :step/content {:db/id #edb/ref 17592186566249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70b54ca2-ba87-5256-9420-5d2e2bf07f05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186565854}] :answer-field/correct {:db/id #edb/ref 17592186565854} :answer-field/id #uuid "a7afddcb-dc24-5839-bcf0-80fc718004df" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566171}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "83c46e33-f8bd-5862-a614-a54a16643b82" :question/math-academy-id "q-220358" :question/problem "The axis of symmetry of the parabola $y=(2x+k)(x-3k)$ is $x=\\frac{1}{4}.$ Find the value of $k.$\n\n$k=$\n\n{{field-1}}" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=\\frac{1}{4},$ we will set our result equal to $\\frac{1}{4}.$ \n\nFrom the equation $y=(2x+k)(x-3k),$ we find that the roots of the parabola are ${x}_{1}=-\\frac{k}{2}$ and ${x}_{2}=3k.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(-\\frac{k}{2}+3k)}{2} \\\\  & =\\frac{(\\frac{6k-k}{2})}{2} \\\\  & =\\frac{5k}{4}\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=\\frac{1}{4}.$ Therefore, we have\n\n$$\n\\begin{aligned}\\frac{5k}{4} & =\\frac{1}{4} \\\\ 5k & =1 \\\\ k & =\\frac{1}{5}.\\end{aligned}\n$$"} :step/id #uuid "3f1f4856-598c-59df-bf66-05dde605cabb" :step/next {:db/id #edb/ref 17592186566314}} {:db/id #edb/ref 17592186566314 :step/content {:db/id #edb/ref 17592186566212 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e82e1f4-a267-5040-a3a3-bab230ab5205" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186565904}] :answer-field/correct {:db/id #edb/ref 17592186565904} :answer-field/id #uuid "2c736d93-e203-5595-b533-b4a4b0df38aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566123}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "213ef30b-cee1-556f-a46a-815fdaa45856" :question/math-academy-id "q-223693" :question/problem "The axis of symmetry of the parabola $y=(x-5k)(x+7k)$ is $x=4.$ Find the value of $k.$\n\n$k=$\n\n{{field-1}}" :question/worked-solution "First, we calculate the axis of symmetry in terms of $k.$ Then, since we know that the axis of symmetry is $x=4,$ we will set our result equal to $4.$ \n\nFrom the equation $y=(x-5k)(x+7k),$ we find that the roots of the parabola are ${x}_{1}=5k$ and ${x}_{2}=-7k.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{5k+(-7k)}{2} \\\\  & =\\frac{-2k}{2} \\\\  & =-k\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=4.$ Therefore, we have\n\n$$\n\\begin{aligned}-k & =4 \\\\ k & =-4.\\end{aligned}\n$$"} :step/id #uuid "dd479361-324f-51c6-bbe1-29ac04309691"} {:db/id #edb/ref 17592186566321 :step/content {:db/id #edb/ref 17592186563746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05ed7714-762b-563c-aa6e-395fc6bb299a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{1}{5}" :db/id #edb/ref 17592186562950} {:answer/id #uuid "12226c0d-85bd-508b-82d8-13bf97d8f83b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{1}{5}" :db/id #edb/ref 17592186562981} {:answer/id #uuid "3bd14c1c-2112-52ab-bcdc-5d7b174123b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{3}{5}" :db/id #edb/ref 17592186563079} {:answer/id #uuid "55af48ee-55a1-5c40-847d-5742b568cea0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{2}{5}" :db/id #edb/ref 17592186563140} {:answer/id #uuid "f8844c5c-08d4-51a1-8c11-9ac8c49c3885" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{3}{5}" :db/id #edb/ref 17592186563501}] :answer-field/correct {:db/id #edb/ref 17592186562950} :answer-field/id #uuid "707a53ec-3f89-531c-a47b-914f51a9c97c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563571}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "da0e0865-56b2-565d-ac33-deaee1268cf4" :question/math-academy-id "q-84903" :question/problem "Find the axis of symmetry of the parabola $y=(7-5x)(x+1).$" :question/worked-solution "From the equation $y=(7-5x)(x+1),$ we find that the roots of the parabola are ${x}_{1}=\\frac{7}{5}$ and ${x}_{2}=-1.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(\\frac{7}{5}-1)}{2} \\\\  & =\\frac{(\\frac{7}{5}-\\frac{5}{5})}{2} \\\\  & =\\frac{(\\frac{2}{5})}{2} \\\\  & =\\frac{1}{5}\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=\\frac{1}{5}.$"} :step/id #uuid "fd3f6f6d-c09c-53c9-813a-5ff408b3201c" :step/next {:db/id #edb/ref 17592186566287}}] :activity/title "The Average of the Roots Formula" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186565667}]}
