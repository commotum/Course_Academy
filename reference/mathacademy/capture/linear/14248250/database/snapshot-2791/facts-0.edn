7] [17592186563501 #edb/ref 1080 "x=\\frac{3}{5}" #edb/ref 17592186045417] [17592186563501 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186563501 #edb/ref 1083 #uuid "f8844c5c-08d4-51a1-8c11-9ac8c49c3885" #edb/ref 17592186045417] [17592186563571 #edb/ref 1075 #edb/ref 17592186562950 #edb/ref 17592186045417] [17592186563571 #edb/ref 1075 #edb/ref 17592186562981 #edb/ref 17592186045417] [17592186563571 #edb/ref 1075 #edb/ref 17592186563079 #edb/ref 17592186045417] [17592186563571 #edb/ref 1075 #edb/ref 17592186563140 #edb/ref 17592186045417] [17592186563571 #edb/ref 1075 #edb/ref 17592186563501 #edb/ref 17592186045417] [17592186563571 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186563571 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186563571 #edb/ref 1078 #edb/ref 17592186562950 #edb/ref 17592186045417] [17592186563571 #edb/ref 1079 #uuid "707a53ec-3f89-531c-a47b-914f51a9c97c" #edb/ref 17592186045417] [17592186563746 #edb/ref 1068 #edb/ref 17592186563571 #edb/ref 17592186045417] [17592186563746 #edb/ref 1069 "q-84903" #edb/ref 17592186045417] [17592186563746 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186563746 #edb/ref 1071 "Find the axis of symmetry of the parabola $y=(7-5x)(x+1).$" #edb/ref 17592186045417] [17592186563746 #edb/ref 1072 #uuid "da0e0865-56b2-565d-ac33-deaee1268cf4" #edb/ref 17592186045417] [17592186563746 #edb/ref 1074 "From the equation $y=(7-5x)(x+1),$ we find that the roots of the parabola are ${x}_{1}=\\frac{7}{5}$ and ${x}_{2}=-1.$ \n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2} \\\\  & =\\frac{(\\frac{7}{5}-1)}{2} \\\\  & =\\frac{(\\frac{7}{5}-\\frac{5}{5})}{2} \\\\  & =\\frac{(\\frac{2}{5})}{2} \\\\  & =\\frac{1}{5}\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is $x=\\frac{1}{5}.$" #edb/ref 17592186045417]}
