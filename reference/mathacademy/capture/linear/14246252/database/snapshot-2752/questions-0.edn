2.png)"}] [{:db/id #edb/ref 17592186115674 :knowledge-point/_questions [{:db/id #edb/ref 17592186115282 :knowledge-point/id #uuid "4f9e91fd-9896-5fdd-8a60-b8ec86ca761c" :knowledge-point/title "Graphing a Translated or Stretched Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9633bb3-7ee4-57c3-a6fd-cc54be9e9bbd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7336172bda3512c455830f0b1be46deac8d0522294d270f3f734391a60bc853.png" :db/id #edb/ref 17592186113011} {:answer/id #uuid "ab903738-aa5f-582e-a489-750e0b0218bb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f7c2d23d12059c5fe56ce44757825e6c95517e842caeded02b734bbfdc5f7945.png" :db/id #edb/ref 17592186113012} {:answer/id #uuid "b3ae7a21-5fda-5426-8a2c-e1dd1e1f05de" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8b/8b9cffb10d9396ed518f109a906dd4c04187c4359cd9e7b1396153bc4b38a1d3.png" :db/id #edb/ref 17592186113013} {:answer/id #uuid "b97d167f-b5dd-5760-af3b-6ec9251b03fe" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2c/2c59cd038a9eddad9c7834eb33a4ceb380fa764127fe71edf7a866f153160abb.png" :db/id #edb/ref 17592186113014} {:answer/id #uuid "5450386b-555a-55d4-8e20-44e905317424" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ce/ceceb8e7d30739ea2a23a3adf4ffc2d9896b32cf1846af7865fcd473e9b8e3e2.png" :db/id #edb/ref 17592186113015}] :answer-field/correct {:answer/id #uuid "ab903738-aa5f-582e-a489-750e0b0218bb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f7c2d23d12059c5fe56ce44757825e6c95517e842caeded02b734bbfdc5f7945.png" :db/id #edb/ref 17592186113012} :answer-field/id #uuid "e8ec9261-2a03-5162-a251-fb90e85d9515" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113010}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4d7a5c07-5796-5737-ba24-b537b941da1c" :question/math-academy-id "q-28243" :question/problem "Which of the following is the graph of $y=5\\operatorname{ln}⁡x?$" :question/worked-solution "To plot $y=5\\operatorname{ln}⁡x,$ we apply the following steps:\n\n- Take the curve $y=\\operatorname{ln}⁡x.$\n\n![](images/9a/9aa292639642f664a81078a5cf916a7f7efef4f4b4a944a85c17bfc63b11beb8.png)\n\n- Stretch it by a scale factor of $5$ parallel to the $y$-axis to get the graph of $y=5\\operatorname{ln}⁡x.$\n\n![](images/f7/f7c2d23d12059c5fe56ce44757825e6c95517e842caeded02b734bbfdc5f7945.png)"}] [{:db/id #edb/ref 17592186563722 :knowledge-point/_questions [{:db/id #edb/ref 17592186115282 :knowledge-point/id #uuid "4f9e91fd-9896-5fdd-8a60-b8ec86ca761c" :knowledge-point/title "Graphing a Translated or Stretched Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31fb838b-38b2-5ea1-a6c5-3c99557057ad" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4b/4b5e2469ce9b19817f67b95a0ac0b402a3d5dec6db92b79f7c7e18331ef267af.png" :db/id #edb/ref 17592186563058} {:answer/id #uuid "3dc4589a-2522-5497-8812-d066a6032475" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/58/5836978b2b72feee5a8d0dca2f63c2cf416259e1a93f5023a9aa0912eecd456a.png" :db/id #edb/ref 17592186563085} {:answer/id #uuid "9d13fcf6-57bd-5155-a0d1-0fd1d61508e5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/14/14a1d62e03b380aec6bb164e28935531845f1f46f98ea5103bbb54b60594cdc4.png" :db/id #edb/ref 17592186563297} {:answer/id #uuid "e236c589-b299-55e0-bcbf-1880ceecb833" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/valu