#{[{:db/id #edb/ref 17592186572125 :knowledge-point/_questions [{:db/id #edb/ref 17592186068720 :knowledge-point/id #uuid "5df52cb5-75b1-58d9-8535-07c1bb87be34" :knowledge-point/title "Determining the Length of a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "379919fe-14c5-5033-9b3a-c01fc06e063d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186571636} {:answer/id #uuid "52c6b9cc-ce8b-5b07-bd83-778a557af4fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186571689} {:answer/id #uuid "8c3f86e3-aa37-529d-833c-43163e45c374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{15}" :db/id #edb/ref 17592186571779} {:answer/id #uuid "92676a16-1339-55d9-9df9-b454ed1dd9f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186571797} {:answer/id #uuid "dcfb51fc-582b-51c5-801a-8eebb92fb524" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186571935}] :answer-field/correct {:answer/id #uuid "92676a16-1339-55d9-9df9-b454ed1dd9f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186571797} :answer-field/id #uuid "99558049-622d-5685-b782-575ef24f9379" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572050}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "410f5e90-695f-5bc0-8245-a684010c1ba9" :question/math-academy-id "q-119112" :question/problem "![](images/d9/d939db899518bec1c91fd70e4d16726ec7a12d32f2d7b41575759843e5837d6c.png)\n\nWhat is the length of $\\overset{―}{AB}?$" :question/worked-solution "From the figure, we note that the points $A$ and $B$ have coordinates ${{(-1,1)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(3,-2)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})},$ respectively.\n\nTo find the length of $\\overset{―}{AB},$ we use the distance formula:\n\n$$\n\\begin{aligned}AB & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(3-(-1))^{2}+(-2-1)^{2}} \\\\  & =\\sqrt{(4)^{2}+(-3)^{2}} \\\\  & =\\sqrt{16+9} \\\\  & =\\sqrt{25} \\\\  & =5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572130 :knowledge-point/_questions [{:db/id #edb/ref 17592186068720 :knowledge-point/id #uuid "5df52cb5-75b1-58d9-8535-07c1bb87be34" :knowledge-point/title "Determining the Length of a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78183e78-e617-5692-8a7d-a04e6565cbe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186571744}] :answer-field/correct {:answer/id #uuid "78183e78-e617-5692-8a7d-a04e6565cbe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186571744} :answer-field/id #uuid "b282633f-0ee1-506a-a430-4ffd87e35c4d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186572066}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c32c57d-e2a6-5951-aed3-798fe23141b6" :question/math-academy-id "q-216289" :question/problem "![](images/92/923997b18a24320bab5eb7ca39dc04d7da52e10ebf18ff4cb7f8ec40bf00b491.png)\n\nThe length of $\\overset{―}{CD}$ is{{field-1}}." :question/worked-solution "From the figure, we note that the points $C$ and $D$ have coordinates ${{(7,1)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(1,9)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})},$ respectively. \n\nTo find the distance $CD,$ we can use the distance formula:\n\n$$\n\\begin{aligned}CD & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(1-7)^{2}+(9-1)^{2}} \\\\  & =\\sqrt{(-6)^{2}+{8}^{2}} \\\\  & =\\sqrt{36+64} \\\\  & =\\sqrt{100} \\\\  & =10\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069136 :knowledge-point/_questions [{:db/id #edb/ref 17592186068721 :knowledge-point/id #uuid "bdded031-fd95-5a7f-92d4-c0d6713ba64d" :knowledge-point/title "Calculating the Distance Between Two Points"}] :question/answer-fields [{:answer-field/id #uuid "fbfe5191-7236-5cba-916e-1d72a298bfd0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186066152}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "768d87c3-2b53-5022-aece-d8352b72ea75" :question/math-academy-id "q-216298" :question/problem "The exact distance between the points $(3, 6)$ and $(2,-4)$ is {{field-1}}."}] [{:db/id #edb/ref 17592186572113 :knowledge-point/_questions [{:db/id #edb/ref 17592186068721 :knowledge-point/id #uuid "bdded031-fd95-5a7f-92d4-c0d6713ba64d" :knowledge-point/title "Calculating the Distance Between Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfccf1a2-81a4-586f-b6af-2f70838ec300" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186571939}] :answer-field/correct {:answer/id #uuid "dfccf1a2-81a4-586f-b6af-2f70838ec300" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186571939} :answer-field/id #uuid "13d56c94-2d25-54b7-b65c-c2ab11270b92" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186571990}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18f21b66-7036-5909-982a-f6e8c6a583c2" :question/math-academy-id "q-216300" :question/problem "The distance between the points $(5,1)$ and $(1,-2)$ is{{field-1}}." :question/worked-solution "In this case, we have ${{(5,1)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(1,-2)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$ \nSo, the distance $d$ can be calculated using the distance formula, as follows:\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(1-5)^{2}+(-2-1)^{2}} \\\\  & =\\sqrt{(-4)^{2}+(-3)^{2}} \\\\  & =\\sqrt{16+9} \\\\  & =\\sqrt{25} \\\\  & =5\\end{aligned}\n$$"}]}
