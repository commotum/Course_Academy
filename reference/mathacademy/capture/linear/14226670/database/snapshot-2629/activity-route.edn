#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186545974} :activity/id #uuid "ddf2c666-86f8-502f-9585-efc495d0f82c" :activity/scope {:db/id #edb/ref 17592186050089 :topic/id #uuid "2cb07e2e-6475-548a-8275-28e63ed7fbf9" :topic/math-academy-id 460} :activity/steps [{:db/id #edb/ref 17592186545879 :step/content {:db/id #edb/ref 17592186069431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e3b387-d21e-5429-bea6-116f81ba1ff5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\pi \\,\\text{ft}" :db/id #edb/ref 17592186545208} {:answer/id #uuid "4a14f43c-a600-563f-9d5a-fb05244e3a85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\,\\text{ft}" :db/id #edb/ref 17592186545340} {:answer/id #uuid "8c6bc2bf-f6de-5c8f-9eae-af5bddf27872" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi \\,\\text{ft}" :db/id #edb/ref 17592186545460} {:answer/id #uuid "b40ea921-33a0-56f3-b29a-40075c246ad4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi \\,\\text{ft}" :db/id #edb/ref 17592186545527} {:answer/id #uuid "e24d60bc-e43a-5171-acd0-fdd50211baf0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\pi \\,\\text{ft}" :db/id #edb/ref 17592186545618}] :answer-field/correct {:db/id #edb/ref 17592186545618} :answer-field/id #uuid "d20d0e94-eb9d-54ac-a04b-bb5bfc8a939b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186067756}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fab21302-ee94-5b6f-a645-ce41d0356979" :question/math-academy-id "q-53557" :question/problem "Ken's tree has a diameter of $4\\,\\text{ft}.$ What length of chain does Ken need for it to wrap around the tree perfectly?" :question/worked-solution "The length of the chain needed to wrap around the tree is its circumference.\n\nThe formula for the circumference of a circle is $C=\\pi d,$ where $d=4\\,\\text{ft}$ is the diameter.\n\nTherefore, we have\n\n$$\nC=\\pi \\cdot 4=4\\pi \\,\\text{ft}.\n$$"} :step/id #uuid "040c1124-5997-531e-bc13-442121034938"} {:db/id #edb/ref 17592186545974 :step/content {:db/id #edb/ref 17592186069256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cd3d410-3c97-5b5e-bcf8-a98a446e144b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\,\\text{cm}" :db/id #edb/ref 17592186545257} {:answer/id #uuid "2495183c-6dbb-598a-808f-628586b9fe57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\pi \\,\\text{cm}" :db/id #edb/ref 17592186545277} {:answer/id #uuid "35ef7018-e4a3-5cbc-8d70-cdf053cda6d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\pi \\,\\text{cm}" :db/id #edb/ref 17592186545310} {:answer/id #uuid "4c52566a-ed5d-53b3-88c6-c1e145863df0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32\\pi \\,\\text{cm}" :db/id #edb/ref 17592186545343} {:answer/id #uuid "da44332b-8fd7-5949-8407-aa22d1e3488a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,\\text{cm}" :db/id #edb/ref 17592186545602}] :answer-field/correct {:db/id #edb/ref 17592186545277} :answer-field/id #uuid "ad1c5896-7d97-5faa-877b-8d3ff040f83a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186066706}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "81faa1ed-4997-5c7e-9226-5ab40a6765e9" :question/math-academy-id "q-32097" :question/problem "![](images/af/afcd7f6646b84debcea24ad6bf3a9cd71d14aae778cdb31b77a36665865a1996.png)\n\nWhat is the circumference of a circle with a radius of $8\\,\\text{cm}?$" :question/requires-calculator true :question/worked-solution "We use the formula $C=2\\pi r$ to get\n\n$$\n\\begin{aligned}C & =2\\pi r \\\\  & =2\\pi \\cdot 8 \\\\  & =16\\pi \\,\\text{cm}.\\end{aligned}\n$$"} :step/id #uuid "b9c93b9a-4e23-53cc-bb82-5cef9ff44438" :step/next {:db/id #edb/ref 17592186546021}} {:db/id #edb/ref 17592186546021 :step/content {:db/id #edb/ref 17592186545852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cc74002-0c78-5dae-9707-9fc6b2c0acc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20\\pi \\,\\text{m}" :db/id #edb/ref 17592186545256} {:answer/id #uuid "3e5fb3ec-04f9-557a-a27d-938fe5b48a02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50\\pi \\,\\text{m}" :db/id #edb/ref 17592186545319} {:answer/id #uuid "590ac348-294a-5f50-a8c7-b17dbddb6c87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\pi \\,\\text{m}" :db/id #edb/ref 17592186545369} {:answer/id #uuid "ade05a1d-8e7a-5fc3-97af-ab7e34759ac1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\pi \\,\\text{m}" :db/id #edb/ref 17592186545518} {:answer/id #uuid "fb50c58d-a49d-5612-bfc9-30c593717a24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\pi \\,\\text{m}" :db/id #edb/ref 17592186545665}] :answer-field/correct {:db/id #edb/ref 17592186545256} :answer-field/id #uuid "6780567c-cefa-51bd-8a53-02a09d77b6b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545716}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b99550b6-8022-5cbb-baaa-e73791a1b173" :question/math-academy-id "q-53555" :question/problem "![](images/a4/a4ff0f0f932cf6f2c98f474e2d0d6d6450e5c6072608a4f2fab4cd50aa650d94.png)\n\nA circular plot of land has a diameter of $20\\,\\text{m}.$ What length of fence is needed to border this plot of land?" :question/worked-solution "The length of the fence needed to border the circular land is its circumference.\n\nThe formula for the circumference of a circle is $C=\\pi d,$ where $d=20\\,\\text{m}$ is the diameter.\n\nTherefore, we have\n\n$$\nC=\\pi \\cdot 20=20\\pi \\,\\text{m}.\n$$"} :step/id #uuid "ff6ec4ce-a876-55f0-a547-0177e1ff36c5" :step/next {:db/id #edb/ref 17592186545879}}] :activity/title "The Circumference of a Circle" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186545195}]}
