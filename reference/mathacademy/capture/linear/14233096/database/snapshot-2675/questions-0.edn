#{[{:db/id #edb/ref 17592186553564 :knowledge-point/_questions [{:db/id #edb/ref 17592186083193 :knowledge-point/id #uuid "20c12caf-9f3e-5dcb-a12c-5c368824ede9" :knowledge-point/title "Rational Equations Containing Negative Signs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76c8f3f7-161d-543a-8276-7a301d916a9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=-\\frac{9}{7}" :db/id #edb/ref 17592186553107} {:answer/id #uuid "7ac07413-4850-5624-83af-f095ddd47313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=-\\frac{16}{9}" :db/id #edb/ref 17592186553120} {:answer/id #uuid "8b6ea648-a389-56ab-b36f-fb046e45c3dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=-\\frac{7}{16}" :db/id #edb/ref 17592186553151} {:answer/id #uuid "bdf2a0b4-b5da-54ac-a8c3-72dbd0d1cb00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=-\\frac{7}{9}" :db/id #edb/ref 17592186553244} {:answer/id #uuid "d870d3ee-d1a0-5de9-ab6b-55afc0deeb26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=-\\frac{16}{7}" :db/id #edb/ref 17592186553302}] :answer-field/correct {:answer/id #uuid "bdf2a0b4-b5da-54ac-a8c3-72dbd0d1cb00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=-\\frac{7}{9}" :db/id #edb/ref 17592186553244} :answer-field/id #uuid "4471834c-aadc-52a5-8221-0fc8082126bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553407}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1ef5b0e-d9e2-581a-b9df-9ba5373d94d3" :question/math-academy-id "q-106184" :question/problem "Solve the equation $\\frac{12}{7}=-\\frac{4}{3n}.$" :question/worked-solution "First, note that $n=0$ cannot be a solution since division by $0$ is undefined.\n\nTo solve the equation, we move the negative sign onto the numerator of the fraction and then apply cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{12}{7} & =-\\frac{4}{3n} \\\\ \\frac{12}{7} & =\\frac{-4}{3n} \\\\ 12\\cdot 3n & =7\\cdot (-4) \\\\ 36n & =-28\\end{aligned}\n$$\n\nThen, we apply the multiplication principle:\n\n$$\n\\begin{aligned}36n & =-28 \\\\ n & =-\\frac{28}{36} \\\\ n & =-\\frac{28÷4}{36÷4} \\\\ n & =-\\frac{7}{9}\\end{aligned}\n$$\n\nSince  $n=-\\frac{7}{9}$ is different from $n=0,$ we can accept it as a solution. Therefore, the solution is $n=-\\frac{7}{9}.$"}] [{:db/id #edb/ref 17592186553562 :knowledge-point/_questions [{:db/id #edb/ref 17592186068925 :knowledge-point/id #uuid "5e985ae8-05ba-590a-b504-4c84884679f4" :knowledge-point/title "Finding the Equation of a Line That Passes Through Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "125972c9-32e8-538b-a997-da527d54a553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{3}{2}x+3" :db/id #edb/ref 17592186552899} {:answer/id #uuid "31ca44cb-7eb3-52d3-b309-91406d94b5d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{3}{2}x-2" :db/id #edb/ref 17592186552964} {:answer/id #uuid "6d218bc5-8d58-5c12-bd7b-15280a7308c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+1" :db/id #edb/ref 17592186553092} {:answer/id #uuid "76e121c8-397b-5e1b-aeaf-4d9fdcc71c5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x-3" :db/id #edb/ref 17592186553108} {:answer/id #uuid "f70df01c-cf72-529e-a5cd-186e427e4a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x+3" :db/id #edb/ref 17592186553356}] :answer-field/correct {:answer/id #uuid "76e121c8-397b-5e1b-aeaf-4d9fdcc71c5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x-3" :db/id #edb/ref 17592186553108} :answer-field/id #uuid "d64b3832-4443-5df9-a2ae-cff83b32069c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553473}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "abb200c5-68bb-537e-9baa-018c760a0ae2" :question/math-academy-id "q-109485" :question/problem "![](images/0a/0a380bff517befb89bd26c88aeb014b36b4040b5d8b5ceab6c8ef7b8549b3378.png)\n\nFind the equation of the line that passes through the points $(2,1)$ and $(5,7).$" :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So, we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFirst, we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{7-1}{5-2} \\\\  & =\\frac{6}{3} \\\\  & =2\\end{aligned}\n$$\n\nSubstituting the slope $m=2$ into the slope-intercept formula $y=mx+b,$ we reach\n\n$$\ny=2x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(2,1):$\n\n$$\n\\begin{aligned}y & =2x+b \\\\ 1 & =2(2)+b \\\\ 1 & =4+b \\\\ 1-4 & =b \\\\ -3 & =b\\end{aligned}\n$$\n\nTherefore, the equation of the line is $y=2x-3.$"}] [{:db/id #edb/ref 17592186553580 :knowledge-point/_questions [{:db/id #edb/ref 17592186096658 :knowledge-point/id #uuid "6bab04f2-5e9a-55e7-9669-63e15938be0a" :knowledge-point/title "Evaluating a Function in a Modeling Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1173fae1-5443-5a7c-802f-bc4a18b39485" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$409$ reproductions" :db/id #edb/ref 17592186552896} {:answer/id #uuid "11a99ae3-f649-5309-a389-9ea75401a0dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4\\,096$ reproductions" :db/id #edb/ref 17592186552897} {:answer/id #uuid "5ae4b63e-4637-5904-9946-b0888671c3ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$40\\,960$ reproductions" :db/id #edb/ref 17592186553064} {:answer/id #uuid "91b8bd7c-9971-5b54-bace-76198473750a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4\\,096\\,000$ reproductions" :db/id #edb/ref 17592186553162} {:answer/id #uuid "f5748763-341a-5368-8dc2-9b543d96e925" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$409\\,600$ reproductions" :db/id #edb/ref 17592186553352}] :answer-field/correct {:answer/id #uuid "f5748763-341a-5368-8dc2-9b543d96e925" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$409\\,600$ reproductions" :db/id #edb/ref 17592186553352} :answer-field/id #uuid "bce7582a-d7a8-568c-a03e-61260c9c5c8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553465}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e11fae48-4720-5d25-bf2f-7ddb91eae65f" :question/math-academy-id "q-112144" :question/problem "The formula $V(t)=100\\cdot {4}^{t}$ gives the number of times a video has been reproduced $t$ hours after it was published. How many reproductions will the video have after $6$ hours?" :question/worked-solution "To get the number of reproductions after $6$ hours, we evaluate the function at $t=6.$ Substituting $t=6$ into the function $V(t)$ gives\n\n$$\n\\begin{aligned}V(6) & =100\\cdot {4}^{6} \\\\  & =100\\cdot 4\\,096 \\\\  & =409\\,600.\\end{aligned}\n$$\n\n \n\nTherefore, after $6$ hours, the video will have $409\\,600$ reproductions."}] [{:db/id #edb/ref 17592186553555 :knowledge-point/_questions [{:db/id #edb/ref 17592186110746 :knowledge-point/id #uuid "c4a4cad5-d0b0-51cb-921f-31a96e8e5eda" :knowledge-point/title "Using Properties of Midpoints to Calculate an Unknown Value From a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36d9a542-16ec-53c9-a052-9fd0bbc28c77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186552976} {:answer/id #uuid "786aaef0-ae04-5785-8da6-da19b9fb6a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186553112} {:answer/id #uuid "9fa19674-b23f-5602-9420-589c8d7e75dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186553191} {:answer/id #uuid "a4568c7c-9c13-56da-88e4-06090093e14a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186553199} {:answer/id #uuid "fbd6f2ce-4279-5589-9abf-c83467615388" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186553368}] :answer-field/correct {:answer/id #uuid "786aaef0-ae04-5785-8da6-da19b9fb6a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186553112} :answer-field/id #uuid "edc3d773-9201-5181-846a-f801f1bee199" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553480}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99403fe1-1721-56c5-b69a-61a8a55f3486" :question/math-academy-id "q-113574" :question/problem "![](images/c3/c368bfa8eb05583b7298e6e386ac37e36751f8de874a4822bbdcf7432e054945.png)\n\nGiven that $M$ is the midpoint of $\\overset{―}{LN}$ with $LM=7-x$ and $LN=11-x$, what is the value of $LN?$" :question/worked-solution "We have the following diagram.\n\n![](images/7c/7c89598fe6a0450eddfe8af4ed274d4110fd7cb2de796bb5a749798b44c7e94a.png)\n\n  \n\nSince $M$ is the midpoint of $\\overset{―}{LN}$, the segment $\\overset{―}{LN}$ is twice the length of the segment $\\overset{―}{LM}.$ So, we have:\n\n$$\n\\begin{aligned}2LM & =LN \\\\ 2(7-x) & =11-x \\\\ 14-2x & =11-x \\\\ 14-2x+2x & =11-x+2x \\\\ 14 & =11+x \\\\ 14-11 & =11+x-11 \\\\ 3 & =x \\\\ x & =3\\end{aligned}\n$$\n\nTherefore,  by plugging this value into the expression for $LN$, we obtain:\n\n$$\n\\begin{aligned}LN & =11-x \\\\  & =11-3 \\\\  & =8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186553493 :knowledge-point/_questions [{:db/id #edb/ref 17592186078527 :knowledge-point/id #uuid "3cc2167e-d318-54d5-8b67-47afbc65f530" :knowledge-point/title "Determining if a Rule Given by a Mapping Diagram Is a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39a6106f-130d-52bd-a05c-60c10693484a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Not enough information" :db/id #edb/ref 17592186552983} {:answer/id #uuid "3ae708f7-f35a-5b75-aa24-58de3cc80a07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Yes, since each output is related to at least one input" :db/id #edb/ref 17592186552989} {:answer/id #uuid "4b538715-003f-565e-8674-ff6f7d48caaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No, since there is an input value that is not assigned to an output value" :db/id #edb/ref 17592186553030} {:answer/id #uuid "8ba18aa9-efde-599d-ba8e-29486468a2d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Yes, since each input is assigned to exactly one output" :db/id #edb/ref 17592186553152} {:answer/id #uuid "ba32e71d-0eec-52de-b568-6f97cb29f798" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No, since the sets do not have the same number of elements" :db/id #edb/ref 17592186553238}] :answer-field/correct {:answer/id #uuid "4b538715-003f-565e-8674-ff6f7d48caaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No, since there is an input value that is not assigned to an output value" :db/id #edb/ref 17592186553030} :answer-field/id #uuid "1b926d6c-df11-5a3e-9992-7339f761ef9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553386}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "09d0b1bd-784f-5b5f-a562-190332d09cbb" :question/math-academy-id "q-130473" :question/problem "![](images/63/631bae1b2aa4a34ecaa023d45b4cf0f8aebe011214deef8e23890da1a2d197d8.png)\n\nIs the above rule a function?" :question/worked-solution "A rule is a function if and only if *every* input is mapped to *precisely one* output.\n\nIn particular, a rule is *not* a function in the following cases:\n\n- An input value is not assigned to an output value. For example, the following situation is *not allowed* for functions (an input value with no arrow from it):\n\n![](images/bb/bb53865d210d631d78e5ce48aa96ecff99da8995936a085c789c3471ffb9e6a0.png)\n\n \n\n- An input value is assigned to more than one output value. For example, the following situation is *not allowed* for functions (an input value with more than one arrow from it):\n\n![](images/18/18831dc73e561faa69748fed111eb7e1024d35849fb6624594ae08d8c35301ee.png)\n\n \n\nIn this particular example, the rule is *not* a function because there is an input value ($x=0$) that is *not assigned* to an output value."}] [{:db/id #edb/ref 17592186553577 :knowledge-point/_questions [{:db/id #edb/ref 17592186054712 :knowledge-point/id #uuid "0bd2d5a4-73de-51ad-9f9f-070d1d4f31a5" :knowledge-point/title "Identifying True Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e17cd6a-52e8-553b-847d-6129223a3399" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186552885} {:answer/id #uuid "51d55016-840d-5996-844d-923acd2896fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186553045} {:answer/id #uuid "61055eee-d3cf-5b28-a9de-4c7fb6584490" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186553075} {:answer/id #uuid "93d5569f-6c94-5e96-9972-bb126f6da1df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186553166} {:answer/id #uuid "afaf933e-e66d-51d7-9e62-faab91a6bb46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186553222}] :answer-field/correct {:answer/id #uuid "afaf933e-e66d-51d7-9e62-faab91a6bb46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186553222} :answer-field/id #uuid "73263b45-6098-5117-a465-c79f61aeae54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553430}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d8eb4941-b3e2-55e9-b6fe-f87579a51eed" :question/math-academy-id "q-152026" :question/problem "Which of the following statements are true? \n\nI. The sum of ${x}^{2}+x+1$ and ${x}^{2}-2x-1$ is a trinomial.\n\nII. The sum of ${x}^{2}+3x+1$ and $3{x}^{2}-x-5$ is a trinomial.\n\nIII. The sum of two trinomials is not necessarily a trinomial." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. We have\n\n$$\n({x}^{2}+x+1)+({x}^{2}-2x-1)=2{x}^{2}-x,\n$$\n\nwhich is *not* a trinomial (it's a binomial).\n\n- Statement II is true. We have\n\n$$\n({x}^{2}+3x+1)+(3{x}^{2}-x-5)=4{x}^{2}+2x-4,\n$$\n\nwhich is a trinomial.\n\n- Statement III is true. The sum of two trinomials *could be* a trinomial (see, for example, statement II). \n\n However, the sum of two trinomials is *not always* a trinomial (see, for example, statement I). \n\n So, the sum of two trinomials is not necessarily a trinomial.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186553554 :knowledge-point/_questions [{:db/id #edb/ref 17592186059829 :knowledge-point/id #uuid "2f519fa9-de89-5b00-aa02-312cf8e32cba" :knowledge-point/title "Converting Between Intervals and Inequalities: Closed Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd995a9-b989-5eb9-a1bd-bb739025a499" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[1,5)" :db/id #edb/ref 17592186552918} {:answer/id #uuid "2f9055f6-bbd2-57f5-867f-46b21bf3bb97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[1,5]" :db/id #edb/ref 17592186552956} {:answer/id #uuid "aa39e0ad-a191-5047-bc57-3b582cadb1c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,5)" :db/id #edb/ref 17592186553210} {:answer/id #uuid "c6fd135d-d86a-5987-9de8-d466c75f9138" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,5]" :db/id #edb/ref 17592186553266} {:answer/id #uuid "e83c5b5b-2113-5fab-83c6-66a9ffcc9dbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,5]" :db/id #edb/ref 17592186553330}] :answer-field/correct {:answer/id #uuid "2f9055f6-bbd2-57f5-867f-46b21bf3bb97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[1,5]" :db/id #edb/ref 17592186552956} :answer-field/id #uuid "37038cfb-4364-58c7-8027-27793c04b330" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553397}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "974c4026-e9d5-5cd6-80d1-e15772e57911" :question/math-academy-id "q-154717" :question/problem "The inequality $1\\le x\\le 5$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nOur inequality contains only \"or equal to\" symbols. So, the endpoints $1$ and $5$ *are* included. \n\n$$\n1\\,\\,\\le \\,\\,x\\,\\,\\le \\,\\,5\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n[1,5]\n$$\n\nMore formally, we can also write\n\n$$\nx\\in [1,5].\n$$"}] [{:db/id #edb/ref 17592186553559 :knowledge-point/_questions [{:db/id #edb/ref 17592186105806 :knowledge-point/id #uuid "b1d4b0c2-10d0-5c3a-8a58-4d7598dd9f96" :knowledge-point/title "Calculating the Perimeter of a Triangle Given the Perimeter of Another Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a792fd2-70da-549d-9115-d7df73920b11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186552912} {:answer/id #uuid "5fd136c0-e1c4-5142-b13b-a2e763067a98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186553071} {:answer/id #uuid "91722234-957f-5df1-b3e1-c0613cb30d65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186553160} {:answer/id #uuid "a185a44a-16d0-5bb7-b8c7-891fdeb1dcf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186553194} {:answer/id #uuid "f462dc9d-266e-59e7-b54e-23fbb51c4609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186553349}] :answer-field/correct {:answer/id #uuid "f462dc9d-266e-59e7-b54e-23fbb51c4609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186553349} :answer-field/id #uuid "e0dcc2e6-1bc5-592f-996a-6b8e9f9cebf3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553478}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9e670b5a-5fbf-5bcb-b259-10c91c8115bb" :question/math-academy-id "q-20574" :question/problem "The perimeter $p$ of the equilateral triangle $△ABC$ is $9.$ What is the perimeter of the isosceles triangle $△ABD$ with base $\\overset{―}{AB}$ if $AD=5?$" :question/worked-solution "Let's illustrate the triangles.\n\n![](images/2e/2e18009a3a454e83e42f9f21840c6821605ac2eb8f4e3d493c8468a5fe5f5acc.png)\n\n \n\nWe're told that the perimeter of the equilateral triangle $△ABC$ is ${p}_{1}=9,$ and since all $3$ sides have equal length, we get\n\n$$\nAB=\\frac{{p}_{1}}{3}=\\frac{9}{3}=3.\n$$\n\nSince  $△ABD$  is an isosceles triangle with base $\\overset{―}{AB},$ we have $AD=BD=5.$ \n\nNow, we have enough information to compute the perimeter of the triangle $△ABD:$\n\n$$\n\\begin{aligned}p & =AB+BD+AD \\\\  & =3+5+5 \\\\  & =13\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186553489 :knowledge-point/_questions [{:db/id #edb/ref 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48c2e38d-b9ae-5469-80da-9fbdd71de470" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186553020} {:answer/id #uuid "4c2cbe8d-3e4b-5384-8b16-725c4463dd05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186553034} {:answer/id #uuid "9c93cb76-4c56-5d96-8b69-8368ebaaeef1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186553187} {:answer/id #uuid "c2d7c1ac-66b2-5bec-8e54-ba134d4a8328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186553257} {:answer/id #uuid "f9b558ea-14a4-554d-a74d-bad2d525c660" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186553363}] :answer-field/correct {:answer/id #uuid "4c2cbe8d-3e4b-5384-8b16-725c4463dd05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186553034} :answer-field/id #uuid "5b7c28ee-4474-52da-a1df-71e406689457" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553417}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "021c858c-ff29-5406-946e-12cf5966af05" :question/math-academy-id "q-288441" :question/problem "Consider the equation\n\n$$\n7mx=-14x\n$$\n\nwhere $m$ is a constant. Given that this equation has infinitely many solutions, what is the value of $m?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=7m,\\,b=-14.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n7m=-14.\n$$\n\nSolving this for $m,$ we get\n\n$$\nm=-2.\n$$"}] [{:db/id #edb/ref 17592186060293 :knowledge-point/_questions [{:db/id #edb/ref 17592186059639 :knowledge-point/id #uuid "26db86bd-122c-5d1b-9684-9444897d1c44" :knowledge-point/title "Relating the Length of the Shorter Leg to the Length of the Longer Leg"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8271321a-5f20-5351-b265-9e5f58992917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186058381} {:answer/id #uuid "c56113a9-bd82-50ec-9e11-144e35e346e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186058382} {:answer/id #uuid "c61836ec-4054-53d8-8841-41f9a3baf98a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186058383} {:answer/id #uuid "d8eea4e0-3573-5b1d-ae2e-1f69a7ed0d4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186058384} {:answer/id #uuid "4bf111e9-6acc-5c2d-b02d-b52633b286cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186058385}] :answer-field/correct {:answer/id #uuid "c61836ec-4054-53d8-8841-41f9a3baf98a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186058383} :answer-field/id #uuid "7d63238d-f606-593d-9f97-2c68caa08d3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058380}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fa9ef661-186d-5d12-a80e-dc8dc356af87" :question/math-academy-id "q-53473" :question/problem "![](images/a2/a23c687653c3491bea681b15e2338cad5814765e5a9eb719ac474f59f3c6c128.png)\n\nIn the triangle above, what is the length of the shorter leg?" :question/worked-solution "Let's refer to our standard ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle.\n\n![](images/75/75e75d1190cda98916cc6071cb2c0c2d25985fabafeda774cfafa5d3e60a7cb8.png)\n\nSince this is a ${30}^{∘}$-${60}^{∘}$-${90}^{∘}$ triangle, the length of the longer leg is $\\sqrt{3}$ times that of the shorter leg.\n\nHere, the longer leg has length $3,$ and the shorter leg has length $x,$ so we have\n\n$$\n\\begin{aligned}3 & =\\sqrt{3}x \\\\ x & =\\frac{3}{\\sqrt{3}}.\\end{aligned}\n$$\n\nTo remove the radical from the denominator, we can multiply the numerator and denominator by the radical:\n\n$$\nx=\\frac{3}{\\sqrt{3}}=\\frac{3\\cdot \\sqrt{3}}{\\sqrt{3}\\cdot \\sqrt{3}}=\\frac{3\\sqrt{3}}{3}=\\sqrt{3}\n$$\n\nSo, the length of the shorter leg is $\\sqrt{3}.$"}] [{:db/id #edb/ref 17592186553531 :knowledge-point/_questions [{:db/id #edb/ref 17592186105850 :knowledge-point/id #uuid "8b4ce383-37b4-5d5a-80ef-3886605bd56f" :knowledge-point/title "Using the Power of Product Rule with a Positive Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "299f70f9-d586-5ab8-9fa1-e66b62718b96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{y}^{2}" :db/id #edb/ref 17592186552943} {:answer/id #uuid "80553c4f-13fb-5669-97d1-2d6f13f16069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{y}^{4}" :db/id #edb/ref 17592186553128} {:answer/id #uuid "b1f092b1-289b-5644-bdf4-12f442a05dc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{y}^{4}" :db/id #edb/ref 17592186553226} {:answer/id #uuid "ccc4e58e-78e3-5701-87e5-d91a3ca12c42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{y}^{4}" :db/id #edb/ref 17592186553278} {:answer/id #uuid "d3c80396-4cef-5dc3-ac82-29205d9d7fa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8y" :db/id #edb/ref 17592186553292}] :answer-field/correct {:answer/id #uuid "ccc4e58e-78e3-5701-87e5-d91a3ca12c42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{y}^{4}" :db/id #edb/ref 17592186553278} :answer-field/id #uuid "33389c7b-23f5-548b-b70a-903275cf55e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553396}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "677c1e28-0032-5401-8f05-31d06a622d65" :question/math-academy-id "q-60587" :question/problem "Simplify $(2y)^{4}.$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}(2y)^{4} & = \\\\ {2}^{4}\\cdot {y}^{4} & = \\\\ 16{y}^{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234249 :knowledge-point/_questions [{:db/id #edb/ref 17592186110616 :knowledge-point/id #uuid "bd2dc211-25cb-5975-a665-f1f6ffd52488" :knowledge-point/title "Combining Various Product and Quotient Rules of Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35e0bf9e-55a9-503e-bb55-0d8b6bfd2bca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{8}\\cdot {7}^{-3}" :db/id #edb/ref 17592186552971} {:answer/id #uuid "38d4ba8e-ef5c-5be5-9602-4bfdc765be69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{3}\\cdot {7}^{2}" :db/id #edb/ref 17592186552981} {:answer/id #uuid "87019656-9802-57c4-9c86-0aa7eee50d5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{8}\\cdot {7}^{5}" :db/id #edb/ref 17592186553139} {:answer/id #uuid "89435a2f-5b03-538d-abb8-6005a8a854de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{3}\\cdot {7}^{-8}" :db/id #edb/ref 17592186553142} {:answer/id #uuid "a1425a83-7601-5533-bdbe-983b40ba004e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{8}\\cdot {7}^{-5}" :db/id #edb/ref 17592186553193}] :answer-field/correct {:answer/id #uuid "a1425a83-7601-5533-bdbe-983b40ba004e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{8}\\cdot {7}^{-5}" :db/id #edb/ref 17592186553193} :answer-field/id #uuid "f166422c-41b0-5717-a433-57648d5156df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553481}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ce2bfa1c-5e37-5680-930e-c063dd6092a4" :question/math-academy-id "q-68957" :question/problem "${(\\frac{6}{7})}^{8}\\cdot {7}^{3}=$" :question/worked-solution "First, we rewrite the first factor using the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{6}{7})}^{8}\\cdot {7}^{3}=\\frac{{6}^{8}}{{7}^{8}}\\cdot {7}^{3}\\end{aligned}\n$$\n\nNext, we rewrite the fractional part of our expression as follows:\n\n$$\n\\frac{{6}^{8}}{{7}^{8}}\\cdot {7}^{3}={6}^{8}\\cdot \\frac{{7}^{3}}{{7}^{8}}\n$$\n\nFinally, we simplify using the quotient rule for exponents:\n\n$$\n{6}^{8}\\cdot \\frac{{7}^{3}}{{7}^{8}}={6}^{8}\\cdot {7}^{3-8}={6}^{8}\\cdot {7}^{-5}\n$$"}] [{:db/id #edb/ref 17592186553520 :knowledge-point/_questions [{:db/id #edb/ref 17592186073726 :knowledge-point/id #uuid "d34e60c9-710b-50ca-a491-adc2b50e6edc" :knowledge-point/title "Problem Solving Using the Ratio of Two Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "303ab246-fe90-5bda-b128-33f0ac56f4a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$12.50$ dollars" :db/id #edb/ref 17592186552958} {:answer/id #uuid "4a379cc3-cf23-5864-92c8-b73aff6939b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$15$ dollars" :db/id #edb/ref 17592186553025} {:answer/id #uuid "797e0d4d-7f71-5c30-b090-71e91f692dda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ dollars" :db/id #edb/ref 17592186553117} {:answer/id #uuid "940bcf64-ca6b-5dd6-8445-8c6a8edf2d80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ dollars" :db/id #edb/ref 17592186553168} {:answer/id #uuid "e01598c2-6122-5249-99d4-451a8dd02c27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7.50$ dollars" :db/id #edb/ref 17592186553313}] :answer-field/correct {:answer/id #uuid "797e0d4d-7f71-5c30-b090-71e91f692dda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ dollars" :db/id #edb/ref 17592186553117} :answer-field/id #uuid "872ec969-4ca6-55b2-bd5c-ff7079521efb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553438}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a0694b1-4a4b-5ce3-895a-155c5691ef32" :question/math-academy-id "q-69041" :question/problem "Eleanor made a call to her parents, which lasted for $\\frac{1}{4}$ of an hour. For this call, she paid $\\frac{1}{2}$ of a dollar. How many dollars would she pay for a $5$ hour call?" :question/worked-solution "To find the number of dollars that Eleanor would pay for a $5$ hour call, we can first find the unit rate of dollars per hour, and then multiply the unit rate by $5$ hours.\n\nTo find the unit rate of dollars per hour, we divide the number of dollars, $\\frac{1}{2},$ by the number of hours, $\\frac{1}{4},$ as follows:\n\n$$\n\\frac{1}{2}÷\\frac{1}{4}\n$$\n\nDividing one fraction by another is equivalent to multiplying the fraction by the reciprocal of the second fraction:\n\n$$\n\\begin{aligned}\\frac{1}{2}÷\\frac{1}{4} & =\\frac{1}{2}\\times \\frac{4}{1} \\\\  & =\\frac{1\\times 4}{2\\times 1} \\\\  & =\\frac{4}{2} \\\\  & =4÷2 \\\\  & =2\\end{aligned}\n$$\n\nSo, the unit rate is $2$ dollars per hour. To find the number of dollars that Eleanor would pay for a $5$ hour call, we multiply the unit rate by $5$ hours and get\n\n$$\n\\begin{aligned}2\\times 5 & =10.\\end{aligned}\n$$\n\nTherefore, Eleanor would pay $10$ dollars for a $5$ hour call."}] [{:db/id #edb/ref 17592186553553 :knowledge-point/_questions [{:db/id #edb/ref 17592186064361 :knowledge-point/id #uuid "1ca49b4e-a4fa-5a67-9334-12e8656b5d1a" :knowledge-point/title "Dividing a Counting Number by a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1abb5c2a-f907-5ec8-8eaa-045849906fd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{33}" :db/id #edb/ref 17592186552913} {:answer/id #uuid "23f1850b-9cf1-5ba9-958d-6192a230eab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{33}{4}" :db/id #edb/ref 17592186552932} {:answer/id #uuid "68099384-0fa4-5c9d-b726-604bfb900ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{44}{3}" :db/id #edb/ref 17592186553087} {:answer/id #uuid "6fd4d1ee-f3c3-561f-b1b0-76bd0e228df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186553097} {:answer/id #uuid "8a90a5e9-09f1-5cfd-a38d-7c4b2dd144a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186553147}] :answer-field/correct {:answer/id #uuid "68099384-0fa4-5c9d-b726-604bfb900ce3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{44}{3}" :db/id #edb/ref 17592186553087} :answer-field/id #uuid "202889fe-fbdf-5866-9db5-d7e0eb76934f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553387}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97290040-c817-56ab-b0de-389c63e1806d" :question/math-academy-id "q-99763" :question/problem "$\\frac{11}{(\\frac{3}{4})}=$" :question/worked-solution "First, remember that a fraction represents a division:\n\n$$\n\\begin{aligned}\\frac{11}{(\\frac{3}{4})}=11÷\\frac{3}{4}\\end{aligned}\n$$\n\nNow, recall that $11=\\frac{11}{1}$ and dividing by $\\frac{3}{4}$ is the same as multiplying by its reciprocal $\\frac{4}{3}.$ We can use these facts to simplify the fraction above: \n\n$$\n\\begin{aligned}11÷\\frac{3}{4} & = \\\\ \\frac{11}{1}\\times \\frac{4}{3} & = \\\\ \\frac{11\\times 4}{1\\times 3} & = \\\\ \\frac{44}{3}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{11}{(\\frac{3}{4})}=\\frac{44}{3}.\n$$"}]}
