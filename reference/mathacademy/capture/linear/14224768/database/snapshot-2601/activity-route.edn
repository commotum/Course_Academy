#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186541190} :activity/id #uuid "587563c0-4481-5a89-aa07-e03a9a094b05" :activity/scope {:db/id #edb/ref 17592186049387 :topic/id #uuid "f0b7f9f5-b45c-5478-b9c9-cc76a52e64dd" :topic/math-academy-id 3530} :activity/steps [{:db/id #edb/ref 17592186541163 :step/content {:db/id #edb/ref 17592186237900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4316944c-e18a-5667-8357-3240d5834ee1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=4" :db/id #edb/ref 17592186236249} {:answer/id #uuid "5b7aa047-300c-51e2-a7f6-c86c3378272d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=1" :db/id #edb/ref 17592186236387} {:answer/id #uuid "8767245b-bfc6-5e40-825e-939e48ea70d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=3" :db/id #edb/ref 17592186236661} {:answer/id #uuid "da101795-d4d4-5895-b026-192d3540e285" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=2" :db/id #edb/ref 17592186237200} {:answer/id #uuid "daef56e2-fa7d-55a5-97b6-d74bb645b9d9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The function has no roots" :db/id #edb/ref 17592186237205}] :answer-field/correct {:db/id #edb/ref 17592186237200} :answer-field/id #uuid "9705bb37-155c-552f-a7d8-20b2d7f6706b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237638}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a455185a-d45e-53e1-ad70-9c8898740251" :question/math-academy-id "q-102545" :question/problem "Find the root of $f(x)=\\sqrt[6]{11-5x}-1.$" :question/worked-solution "To find the roots of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[6]{11-5x}-1=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[6]{11-5x}-1 & =0 \\\\ \\sqrt[6]{11-5x} & =1 \\\\ (\\sqrt[6]{11-5x})^{6} & ={1}^{6} \\\\ 11-5x & =1 \\\\ -5x & =-10 \\\\ x & =2\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}\\sqrt[6]{11-5\\cdot 2}-1 & =0 \\\\ \\sqrt[6]{1}-1 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=2.$"} :step/id #uuid "1b86290c-18a7-50eb-819b-0fa8474a409b" :step/next {:db/id #edb/ref 17592186541214}} {:db/id #edb/ref 17592186541190 :step/content {:db/id #edb/ref 17592186172609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "720ce82d-536f-52e4-a924-9dc9994eace0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{12}{5}" :db/id #edb/ref 17592186355669} {:answer/id #uuid "9c357947-0335-531e-b792-b57594efd6eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=2" :db/id #edb/ref 17592186356049} {:answer/id #uuid "a14eace9-3890-5be9-b73b-56227bff4efd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=3" :db/id #edb/ref 17592186356096} {:answer/id #uuid "a60dca9c-200d-526d-95e8-ae5ecfbe0621" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{12}{5}" :db/id #edb/ref 17592186356135} {:answer/id #uuid "d317e9da-0cf9-523f-af7e-fdda914c3077" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The function has no roots" :db/id #edb/ref 17592186356506}] :answer-field/correct {:db/id #edb/ref 17592186356096} :answer-field/id #uuid "7a0524cb-a296-51c4-96c8-ba5fc5980ac8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357132}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1da47db3-4817-571a-b409-df8d62fa2bb2" :question/math-academy-id "q-92875" :question/problem "Find the root of $f(x)=\\sqrt[3]{5x+12}-3.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[3]{5x+12}-3=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{5x+12}-3 & =0 \\\\ \\sqrt[3]{5x+12} & =3 \\\\ (\\sqrt[3]{5x+12})^{3} & ={3}^{3} \\\\ 5x+12 & =27 \\\\ 5x & =15 \\\\ x & =3\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=3.$"} :step/id #uuid "706337ed-6f73-5aa4-a7bc-09ed1de7df1b" :step/next {:db/id #edb/ref 17592186541163}} {:db/id #edb/ref 17592186541214 :step/content {:db/id #edb/ref 17592186541139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14084539-11f9-57a7-bca4-b41548842563" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The function has no roots" :db/id #edb/ref 17592186540561} {:answer/id #uuid "5e32c774-4665-53a3-a335-e276947bd8e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=4" :db/id #edb/ref 17592186540687} {:answer/id #uuid "7cc13ad9-fa80-5007-ad61-79095af56b5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-4" :db/id #edb/ref 17592186540737} {:answer/id #uuid "bf30ec0c-ff50-5289-b435-f7fa72992683" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=3" :db/id #edb/ref 17592186540847} {:answer/id #uuid "e11e0448-3e5c-5bd7-8da6-0d9adf39655e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-3" :db/id #edb/ref 17592186540912}] :answer-field/correct {:db/id #edb/ref 17592186540561} :answer-field/id #uuid "f92cfc9a-845f-5eba-bf0a-56370e4c5744" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541050}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "daa14d13-b22a-5855-ae0b-e89337d6a6c3" :question/math-academy-id "q-102547" :question/problem "Find the root of $f(x)=\\sqrt[4]{-7-2x}+1.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[4]{-7-2x}+1=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[4]{-7-2x}+1 & =0 \\\\ \\sqrt[4]{-7-2x} & =-1\\end{aligned}\n$$\n\nThis equation does not have any solutions since its left-hand side is always nonnegative, while the right-hand side is negative.\n\nTherefore, $f(x)$ has no root."} :step/id #uuid "b63a3209-a592-54a8-8df6-a40afa0d58e4"}] :activity/title "Roots of Transformed Radical Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186540518}]}
