#{[{:db/id #edb/ref 17592186078285 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078415 :knowledge-point/id #uuid "15cd299b-c720-5bf6-814c-2bef2c839e48" :knowledge-point/title "Finding the Inverse of a Linear Function"}] :question/id #uuid "2fd3c4ba-850d-5d6d-872b-1e05386855e2" :question/math-academy-id "e-3968" :question/problem "Find the inverse of $f(x) = 3x - 4.$" :question/worked-solution "To find the inverse of a function, we follow the four steps below.\n\n**Step 1:** Replace $f(x)$ with $y.$\n\n$$\ny = 3x-4\n$$\n\n**Step 2:** Swap $x$ and $y.$\n\n$$\nx = 3y-4\n$$\n\n**Step 3:** Solve for $y.$\n\n$$\n\\begin{aligned}x & =3y-4 \\\\ x+4 & =3y \\\\ \\frac{x+4}{3} & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with $f^{-1}(x).$\n\n$$\nf^{-1}(x) = \\dfrac {x + 4} {3}\n$$"}] [{:db/id #edb/ref 17592186078286 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078416 :knowledge-point/id #uuid "40a70c8d-dc8e-52bd-a679-ffd6d1940451" :knowledge-point/title "Finding the Inverse of a Function With a Parameter"}] :question/id #uuid "096eb672-5a54-565f-91d7-1072e4ce7136" :question/math-academy-id "e-3970" :question/problem "Find the inverse of the function $f(x) = bx-5,$ where $b$ is a constant." :question/worked-solution "To find the inverse of a function, we follow the four steps below.\n\n**Step 1:** Replace $f(x)$ with $y.$\n\n$$\ny = bx- 5\n$$\n\n**Step 2:** Swap $x$ and $y.$\n\n$$\nx = by- 5\n$$\n\n**Step 3:** Solve for $y.$\n\n$$\n\\begin{aligned}x & =by-5 \\\\ x+5 & =by \\\\ \\frac{x+5}{b} & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with $f^{-1}(x).$\n\n$$\nf^{-1}(x) = \\dfrac{x + 5}{b}\n$$"}] [{:db/id #edb/ref 17592186290357 :knowledge-point/_questions [{:db/id #edb/ref 17592186078415 :knowledge-point/id #uuid "15cd299b-c720-5bf6-814c-2bef2c839e48" :knowledge-point/title "Finding the Inverse of a Linear Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "572579ea-d0b8-5c37-9948-6c0dd4599a42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7-x}{3}" :db/id #edb/ref 17592186288636}] :answer-field/correct {:answer/id #uuid "572579ea-d0b8-5c37-9948-6c0dd4599a42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7-x}{3}" :db/id #edb/ref 17592186288636} :answer-field/id #uuid "c4ae0a04-689d-5eb4-b3f7-68ce08afe4c5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290152}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "33d5b021-749e-5278-a7fc-314d6c4a5b27" :question/math-academy-id "q-218691" :question/problem "If $f(x)=-3x+7$, then ${f}^{-1}(x)=${{field-1}}." :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=-3x+7\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=-3y+7\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =-3y+7 \\\\ 3y & =7-x \\\\ y & =\\frac{7-x}{3}\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\frac{7-x}{3}\n$$"}] [{:db/id #edb/ref 17592186321090 :knowledge-point/_questions [{:db/id #edb/ref 17592186078416 :knowledge-point/id #uuid "40a70c8d-dc8e-52bd-a679-ffd6d1940451" :knowledge-point/title "Finding the Inverse of a Function With a Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15469719-66e1-52f5-a7fb-6f1d770894df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-4b}{3}" :db/id #edb/ref 17592186319450} {:answer/id #uuid "99215789-28a5-5f7e-8283-de3570135c81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-3b}{4}" :db/id #edb/ref 17592186319848} {:answer/id #uuid "9a4b3713-62c0-5c1e-975c-f45b39067ebd" :answer/type {:db/id #edb/ref 