 {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+2}{3}" :db/id #edb/ref 17592186550439} {:answer/id #uuid "22531293-214b-530c-86f7-cdf18b1da2c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+3}{2}" :db/id #edb/ref 17592186550445} {:answer/id #uuid "5c509b94-d744-51e8-a94a-69794cb063c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-3}{2}" :db/id #edb/ref 17592186550592} {:answer/id #uuid "a52d3f85-6eb9-50cb-836e-6465ece0de2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=3x-2" :db/id #edb/ref 17592186550800} {:answer/id #uuid "eb853d16-fce7-507e-b42a-571f1dc7127d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-2}{3}" :db/id #edb/ref 17592186551003}] :answer-field/correct {:answer/id #uuid "22531293-214b-530c-86f7-cdf18b1da2c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+3}{2}" :db/id #edb/ref 17592186550445} :answer-field/id #uuid "2df6be3a-0f6d-5096-bf4e-b8bfa2d2b0ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551092}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d76f6fd1-8c28-5a6f-b6d6-f8935ad11046" :question/math-academy-id "q-7002" :question/problem "For the function $f(x)$ defined by $f(x)=2x-3,$ find ${f}^{-1}(x).$" :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=2x-3\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=2y-3\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =2y-3 \\\\ x+3 & =2y \\\\ \\frac{x+3}{2} & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\frac{x+3}{2}\n$$"}] [{:db/id #edb/ref 17592186551265 :knowledge-point/_questions [{:db/id #edb/ref 17592186078416 :knowledge-point/id #uuid "40a70c8d-dc8e-52bd-a679-ffd6d1940451" :knowledge-point/title "Finding the Inverse of a Function With a Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10a7cb10-eff4-505d-bf58-6872fc938c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-4q}{3}" :db/id #edb/ref 17592186550410} {:answer/id #uuid "4978396b-3692-5598-905a-6992fe350695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+4q}{3}" :db/id #edb/ref 17592186550540} {:answer/id #uuid "60911624-cd75-57a8-a5fd-d42b9a750579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=3x-2q" :db/id #edb/ref 17592186550602} {:answer/id #uuid "99a2a771-d1ec-5f15-ba4f-5d685e13ac64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-3q}{4}" :db/id #edb/ref 17592186550758} {:answer/id #uuid "b870b08a-e761-58e7-b8fc-fce8b75ed795" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+3q}{4}" :db/id #edb/ref 17592186550876}] :answer-field/correct {:answer/id #uuid "b870b08a-e761-58e7-b8fc-fce8b75ed795" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+3q}{4}" :db/id #edb/ref 17592186550876} :answer-field/id #uuid "0a64a770-8a82-5513-98ff-f8e9991e353a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551068}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d4bf850-5813-5f60-9b39-8cfc55a16cca" :question/math-academy-id "q-78669" :question/problem "Find the inverse of the function $f(x)=4x-3q$, where $q$ is a constant." :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=4x-3q\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=4y-3q\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =4y-3q \\\\ x+3q & =4y \\\\ \\frac{x+3q}{4} & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\frac{x+3q}{4}\n$$"}]}
