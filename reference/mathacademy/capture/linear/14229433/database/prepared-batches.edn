[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186078415 :knowledge-point/questions ["question-d76f6fd1-8c28-5a6f-b6d6-f8935ad11046"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078416 :knowledge-point/questions ["question-3d4bf850-5813-5f60-9b39-8cfc55a16cca"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d76f6fd1-8c28-5a6f-b6d6-f8935ad11046" :question/id #uuid "d76f6fd1-8c28-5a6f-b6d6-f8935ad11046" :question/math-academy-id "q-7002" :question/problem "For the function $f(x)$ defined by $f(x)=2x-3,$ find ${f}^{-1}(x).$" :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=2x-3\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=2y-3\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =2y-3 \\\\ x+3 & =2y \\\\ \\frac{x+3}{2} & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\frac{x+3}{2}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2df6be3a-0f6d-5096-bf4e-b8bfa2d2b0ec"] :db/ensure [:question/validate]} {:db/id "answer-field-2df6be3a-0f6d-5096-bf4e-b8bfa2d2b0ec" :answer-field/id #uuid "2df6be3a-0f6d-5096-bf4e-b8bfa2d2b0ec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-22531293-214b-530c-86f7-cdf18b1da2c4" :answer-field/choices ["answer-a52d3f85-6eb9-50cb-836e-6465ece0de2d" "answer-2061fb20-1146-54d2-ad25-6ee672ffd1da" "answer-22531293-214b-530c-86f7-cdf18b1da2c4" "answer-eb853d16-fce7-507e-b42a-571f1dc7127d" "answer-5c509b94-d744-51e8-a94a-69794cb063c7"] :db/ensure [:answer-field/validate]} {:db/id "answer-a52d3f85-6eb9-50cb-836e-6465ece0de2d" :answer/id #uuid "a52d3f85-6eb9-50cb-836e-6465ece0de2d" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=3x-2" :db/ensure [:answer/validate]} {:db/id "answer-2061fb20-1146-54d2-ad25-6ee672ffd1da" :answer/id #uuid "2061fb20-1146-54d2-ad25-6ee672ffd1da" :answer/type :