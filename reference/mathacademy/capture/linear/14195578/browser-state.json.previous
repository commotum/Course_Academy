  "live_records": {
    "q-64117": {
      "dom_id": "step-q64117",
      "name": "Question 1",
      "problem": "A scientist observes that the mass, in grams, of a particular substance decays exponentially according to the rule  $12\\cdot (0.5)^{t},$ where $t$ is the time, in hours, since the beginning of observations.  What does the factor $12$ mean in this context?",
      "worked_solution": "The given expression is an exponential decay expression of the form $y(t)=a\\cdot {b}^{t},$ where we have the following:\n\n- $a=12$ represents the initial mass of the sample.\n\n- $b=0.5$ is the decay factor.\n\n- $t$ is the time since the beginning of the observations, in hours.\n\nSince $a=12,$ this indicates that the sample's mass at the beginning of the observations was  $12$ grams.",
      "calculator_instructions": "",
