6045417] [17592186050164 #edb/ref 1028 #edb/ref 17592186176044 #edb/ref 17592186045417] [17592186050164 #edb/ref 1028 #edb/ref 17592186176097 #edb/ref 17592186045417] [17592186050164 #edb/ref 1028 #edb/ref 17592186176098 #edb/ref 17592186045417] [17592186050164 #edb/ref 1031 "Congruent Angles" #edb/ref 17592186045417] [17592186050164 #edb/ref 1033 3554 #edb/ref 17592186045417] [17592186050164 #edb/ref 1035 #uuid "333ee4a3-8244-5546-a959-8bbd7343369d" #edb/ref 17592186045417] [17592186050494 #edb/ref 1027 #edb/ref 17592186048501 #edb/ref 17592186045417] [17592186050494 #edb/ref 1027 #edb/ref 17592186050164 #edb/ref 17592186045417] [17592186050494 #edb/ref 1028 #edb/ref 17592186110671 #edb/ref 17592186045417] [17592186050494 #edb/ref 1028 #edb/ref 17592186110748 #edb/ref 17592186045417] [17592186050494 #edb/ref 1028 #edb/ref 17592186110750 #edb/ref 17592186045417] [17592186050494 #edb/ref 1031 "Sums of Angles" #edb/ref 17592186045417] [17592186050494 #edb/ref 1033 1505 #edb/ref 17592186045417] [17592186050494 #edb/ref 1034 1.0 #edb/ref 17592186045436] [17592186050494 #edb/ref 1035 #uuid "4db79817-fed4-5680-ad8d-2788d5ed4038" #edb/ref 17592186045417] [17592186050823 #edb/ref 1027 #edb/ref 17592186048216 #edb/ref 17592186045417] [17592186050823 #edb/ref 1027 #edb/ref 17592186049297 #edb/ref 17592186045417] [17592186050823 #edb/ref 1027 #edb/ref 17592186051006 #edb/ref 17592186045417] [17592186050823 #edb/ref 1028 #edb/ref 17592186105890 #edb/ref 17592186045417] [17592186050823 #edb/ref 1028 #edb/ref 17592186105891 #edb/ref 17592186045417] [17592186050823 #edb/ref 1028 #edb/ref 17592186105892 #edb/ref 17592186045417] [17592186050823 #edb/ref 1031 "Proving Congruence Statements" #edb/ref 17592186045417] [17592186050823 #edb/ref 1033 1357 #edb/ref 17592186045417] [17592186050823 #edb/ref 1035 #uuid "69883e68-2851-532b-8bb3-c8eceb1d668d" #edb/ref 17592186045417] [17592186110395 #edb/ref 1069 "e-2615" #edb/ref 17592186045417] [17592186110395 #edb/ref 1071 "In the figure below, $\\overset{\\longrightarrow}{AC}$ is the bisector of $\\angle DAB$ and $m\\angle DAB = 79^\\circ$. What is the measure of $\\angle DAC$?\n\n![](images/8d/8d02999cf6ae7ec69fee2cdac99b8dc214c59f1ed50bbf85bec6bec01f2212ef.png)" #edb/ref 17592186045417] [17592186110395 #edb/ref 1072 #uuid "9612e5aa-af83-5ea5-8bf2-302834e1926a" #edb/ref 17592186045417] [17592186110395 #edb/ref 1074 "An angle bisector divides the angle into two congruent angles with equal measures, so\n\n$$\nm\\angle BAC = m\\angle DAC\n$$\n\n![](images/6e/6e7c8ce2713441e633d7ecc3548c504d2522b4771eb6355217d6ab766a647b67.png)\n\nEach of these congruent angles has a measure that is half the measure of the larger bisected angle. So, we have\n\n$$\n\\begin{aligned}\nm∠DAC &= \\frac{m∠DAB}{2} \\\\\n&= \\frac{79^{∘}}{2} \\\\\n&= 39.5^{∘}\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186110397 #edb/ref 1069 "e-2621" #edb/ref 17592186045417] [17592186110397 #edb/ref 1071 "In the figure below, $\\overset{\\longrightarrow}{AG}$ is the bisector of $\\angle CAD$ and $m\\angle BAC = 40^\\circ$. What is the measure of $\\angle GAD$?\n\n![](images/51/51e4b2db4e0715ce53b605fb9e803d86613c3b4a128dcdd9255a9d183a2de941.png)" #edb/ref 17592186045417] [17592186110397 #edb/ref 1072 #uuid "ec3e6d87-e38e-5aa6-b064-f3c15a51a836" #edb/ref 17592186045417] [17592186110397 #edb/ref 1074 "Since the angles $\\angle CAD$ and $\\angle BAC$ are supplementary, we have\n\n$$\n\\begin{aligned}\nm∠CAD &= 180^{∘} - m∠BAC \\\\\n&= 180^{∘} - 40^{∘} \\\\\n&= 140^{∘}\n\\end{aligned}\n$$\n\nSince $\\overset{\\longrightarrow}{AG}$ is the bisector of $\\angle CAD$, we obtain\n\n$$\n\\begin{aligned}\nm∠GAD &= \\frac{m∠CAD}{2} \\\\\n&= \\frac{140^{∘}}{2} \\\\\n&= 70^{∘}\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186110398 #edb/ref 1069 "e-2624" #edb/ref 17592186045417] [17592186110398 #edb/ref 1071 "In the figure below, $\\overrightarrow{OC}$ is the bisector of $\\angle AOB$. If $m \\angle AOD = 90^\\circ$ and $m \\angle COD = 35^\\circ$, find the measure of $\\angle BOD$.\n\n![](images/0b/0b76c6ee6e576fa2701993e941c27f1168c213d9f5f26b1aa8a50759c3711404.png)" #edb/ref 17592186045417] [17592186110398 #edb/ref 1072 #uuid "f4304d42-1b4c-5ade-86d2-8ed44a952fc8" #edb/ref 17592186045417] [17592186110398 #edb/ref 1074 "![](images/5a/5ae4873418247e8d825233f903ed359ebee4d2c51ad73e6c7763102a23acded6.png)\n\nBy the angle addition postulate, we have\n\n$$\n\\begin{aligned}\nm∠AOC &= m∠AOD - m∠COD \\\\\n&= 90^{∘} - 35^{∘} \\\\\n&= 55^{∘}\n\\end{aligned}\n$$\n\nThe bisector of an angle divides the angle into two congruent angles. Therefore,\n\n$$\nm \\angle AOB =2 m \\angle AOC = 110^\\circ\n$$\n\nFinally, the angle addition postulate gives\n\n$$\n\\begin{aligned}\nm∠BOD &= m∠AOB - m∠AOD \\\\\n&= 110^{∘} - 90^{∘} \\\\\n&= 20^{∘}\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186110399 #edb/ref 1069 "e-2628" #edb/ref 17592186045417] [17592186110399 #edb/ref 1071 "In the figure below, $\\angle BAD$ is a straight angle, $\\overset{\\longrightarrow}{AG}$ is the bisector of $\\angle CAD$ and $\\overset{\\longrightarrow}{AF}$ is the bisector of $\\angle BAC$. What is the measure of $\\angle GAF$?\n\n![](images/45/458893f38204421326fd7dcb0693b1688eeb61fb3988e00b2d36763b47adc2d2.png)" #edb/ref 17592186045417] [17592186110399 #edb/ref 1072 #uuid "b3dbb627-0262-5fdd-ae6b-ba669e4fac6f" #edb/ref 17592186045417] [17592186110399 #edb/ref 1074 "![](images/3b/3b0fddd3229947725b0f4f07e58ce9bfac3a9e7e348c25757162f5bc8e03d699.png)\n\nLet\n\n$$\nm \\angle FAC=x\n$$\n\nand\n\n$$\nm \\angle CAG=y\n$$\n\nThen,\n\n$$\nm \\angle GAF=m\\angle FAC + m \\angle CAG=x+y\n$$\n\nSince $\\overset{\\longrightarrow}{AF}$ is the bisector of $\\angle BAC$, we have\n\n$$\nm \\angle BAC=2x\n$$\n\nSince $\\overset{\\longrightarrow}{AG}$ is the bisector of $\\angle CAD$, we have\n\n$$\nm \\angle CAD=2y\n$$\n\nFinally, since $\\angle BAD$ is a straight angle, we obtain:\n\n$$\n\\begin{aligned}\nm∠BAC + m∠CAD &= m∠BAD \\\\\n2x + 2y &= 180^{∘} \\\\\nx + y &= 90^{∘}\n\\end{aligned}\n$$\n\nConsequently,\n\n$$\nm \\angle GAF=x+y=90^\\circ\n$$" #edb/ref 17592186045417] [17592186110766 #edb/ref 1037 #edb/ref 17592186050164 #edb/ref 17592186045417] [17592186110766 #edb/ref 1038 #edb/ref 17592186111091 #edb/ref 17592186045417] [17592186110766 #edb/ref 1038 #edb/ref 17592186111092 #edb/ref 17592186045417] [17592186110766 #edb/ref 1039 "Using the Property of a Bisection" #edb/ref 17592186045417] [17592186110766 #edb/ref 1041 #edb/ref 17592186110395 #edb/ref 17592186045417] [17592186110766 #edb/ref 1042 #uuid "d3162bc9-a06e-50d9-aaab-628438daa9fe" #edb/ref 17592186045417] [17592186110767 #edb/ref 1037 #edb/ref 17592186048764 #edb/ref 17592186045417] [17592186110767 #edb/ref 1037 #edb/ref 17592186050494 #edb/ref 17592186045417] [17592186110767 #edb/ref 1038 #edb/ref 17592186111281 #edb/ref 17592186045417] [17592186110767 #edb/ref 1038 #edb/ref 17592186111282 #edb/ref 17592186045417] [17592186110767 #edb/ref 1039 "Calculating an Unknown Angle Given an Angle Bisector, an Angle Measurement, and a Straight Angle" #edb/ref 17592186045417] [17592186110767 #edb/ref 1041 #edb/ref 17592186110397 #edb/ref 17592186045417] [17592186110767 #edb/ref 1042 #uuid "2051959e-cd96-5318-8b36-518756991988" #edb/ref 17592186045417] [17592186110769 #edb/ref 1037 #edb/ref 17592186048174 #edb/ref 17592186045417] [17592186110769 #edb/ref 1038 #edb/ref 17592186111280 #edb/ref 17592186045417] [17592186110769 #edb/ref 1038 #edb/ref 17592186111283 #edb/ref 17592186045417] [17592186110769 #edb/ref 1038 #edb/ref 17592186233239 #edb/ref 17592186045417] [17592186110769 #edb/ref 1039 "Calculating an Unknown Angle Given an Angle Bisector and Two Angle Measurements" #edb/ref 17592186045417] [17592186110769 #edb/ref 1041 #edb/ref 17592186110398 #edb/ref 17592186045417] [17592186110769 #edb/ref 1042 #uuid "f6849b30-c5a6-53ba-8517-92c9526ce308" #edb/ref 17592186045417] [17592186110770 #edb/ref 1038 #edb/ref 17592186111090 #edb/ref 17592186045417] [175921861107