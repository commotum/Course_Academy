#{[{:activity/first-step {:db/id #edb/ref 17592186111749} :activity/id #uuid "04bc8b7b-7ea5-55c8-ab74-1bade2a9232e" :activity/scope {:db/id #edb/ref 17592186048161 :topic/id #uuid "83f358e7-8e72-5df7-83a1-5f295f525040" :topic/math-academy-id 1508} :activity/steps [{:db/id #edb/ref 17592186111749 :step/content {:db/id #edb/ref 17592186111842 :tutorial/content "An angle **bisector** is a line that divides an angle into two equal parts.\n\nFor example, in the diagram below, $\\overset{\\longrightarrow}{AC}$ is the bisector of the angle $\\angle BAD$.\n\n![](images/3b/3bf65e915f4fc26b8d87199f46ea0bc514195d857890983d31aa2d73eb38a811.png)\n\nThe resulting angles $\\angle BAC$ and $\\angle CAD$ are congruent (they have the same measure)." :tutorial/id #uuid "525bd6d2-3c4c-53fb-aaa5-dab5eee2cf13" :tutorial/math-academy-id 2190 :tutorial/title "Introduction"} :step/id #uuid "9e612b0f-54c0-5291-8cff-8d993deb2e7f" :step/math-academy-id 8793 :step/next {:db/id #edb/ref 17592186111751}} {:db/id #edb/ref 17592186111751 :step/content {:db/id #edb/ref 17592186110766 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110395 :question/id #uuid "9612e5aa-af83-5ea5-8bf2-302834e1926a" :question/math-academy-id "e-2615"} :knowledge-point/id #uuid "d3162bc9-a06e-50d9-aaab-628438daa9fe" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050164}] :knowledge-point/questions [{:db/id #edb/ref 17592186111091} {:db/id #edb/ref 17592186111092}] :knowledge-point/title "Using the Property of a Bisection"} :step/id #uuid "1c31f48e-d74f-5249-95de-5e7c8f5d2f46" :step/math-academy-id 8800 :step/next {:db/id #edb/ref 17592186111752}} {:db/id #edb/ref 17592186111752 :step/content {:db/id #edb/ref 17592186110767 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110397 :question/id #uuid "ec3e6d87-e38e-5aa6-b064-f3c15a51a836" :question/math-academy-id "e-2621"} :knowledge-point/id #uuid "2051959e-cd96-5318-8b36-518756991988" :knowledge-point/key-prerequisites [{:db/id #edb/ref