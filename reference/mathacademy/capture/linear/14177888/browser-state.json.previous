      "html": "<div id=\"question-134236\" class=\"question\">                                \n                        <div id=\"question-134236-text\" class=\"questionText\">      \n                            \n                            <!--<span style=\"font-weight: bold; margin-right: 10px;\">f.</span>-->\n\n                            <div id=\"question-134236-graphic\" class=\"questionGraphic\">\n                                \n                            </div>   \n\n\n                            After Sophia takes her share of walnuts, Robert's remaining amount of walnuts is\n\n                            \n                                    \n                            \n                                        <div class=\"matheditor-wrapper-answer\" style=\"min-width: 15px; margin-left: 4px; margin-right: 2px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"11\"><var mathquill-command-id=\"47\">g</var><var mathquill-command-id=\"49\">r</var><var mathquill-command-id=\"51\">e</var><var mathquill-command-id=\"53\">a</var><var mathquill-command-id=\"55\">t</var><var mathquill-command-id=\"57\">e</var><var mathquill-command-id=\"59\">r</var></span></div></div>                \n                                    \n                                \n                                    \n                                        \n                                        \nthan Susan's amount of walnuts because <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"17\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\