tion/math-academy-id "q-59573" :question/problem "Which of the following shows the point $C(4,-2)?$" :question/worked-solution "Starting at the origin, we move along the $x$ and $y$ axes to get to the point $C.$\n\nFirst, we move along the $x$-axis. The point $C$ has an $x$-coordinate of $4,$ so we move $4$ units to the *right*, in the positive direction of the $x$-axis.\n\nThen, we move along the $y$-axis. The point $C$ has a $y$-coordinate of $-2,$ so we move $2$ units *down*, in the negative direction of the $y$-axis.\n\n![](images/68/68f55dd9851c7fa3805dec284aad2a9eb7e07b77a94a3f6b4b9b8ddcfd630baf.png)"}] [{:db/id #edb/ref 17592186515552 :knowledge-point/_questions [{:db/id #edb/ref 17592186073739 :knowledge-point/id #uuid "ae17eb3f-f444-5ab3-82fd-6c92b97b0e41" :knowledge-point/title "Simplifying Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0003dfa-a1b9-55b2-9d01-caf97c1db2c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3:2" :db/id #edb/ref 17592186515307} {:answer/id #uuid "f68f1bd9-0968-5373-95e0-ba9f203e08c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:3" :db/id #edb/ref 17592186515388} {:answer/id #uuid "fc699391-fd04-52df-b409-e770247a3ce6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:2" :db/id #edb/ref 17592186515404} {:answer/id #uuid "fcfa165d-4b9d-54cb-812e-73d65dba9b12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2:3" :db/id #edb/ref 17592186515405} {:answer/id #uuid "ff467776-5b6b-511a-ad55-110c0788fd36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:1" :db/id #edb/ref 17592186515409}] :answer-field/correct {:answer/id #uuid "fc699391-fd04-52df-b409-e770247a3ce6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:2" :db/id #edb/ref 17592186515404} :answer-field/id #uuid "5b42a0ed-8cc4-538a-846f-4d271e746063" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515441}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "65505664-38a4-5c26-b1d6-fe28649569b3" :question/math-academy-id "q-59891" :question/problem "![](images/ae/aeee7aa14daab059cc6a03a3fd7437799713009014d21a5b8751f073864cf959.png)\n\nWhat ratio describes the number of pentagons to the total number of shapes?" :question/worked-solution "We count the number of pentagons. We see that there are $2$ pentagons.\n\nWe count the total number of shapes. We see that there are $4$ shapes in total.\n\nSo the ratio of pentagons to total shapes is $2:4.$\n\nWe can simplify this ratio by dividing both numbers in a ratio by $2$:\n\n$$\n\\begin{aligned}\\,\\,2 &  & : & \\,\\,\\,\\, & \\,\\,\\,4 &  \\\\ \\,\\,↓÷\\,\\,2 &  &  &  & \\,\\,\\,↓÷\\,\\,2 &  \\\\ \\,\\,1 &  & : &  & \\,\\,\\,2 & \\end{aligned}\n$$\n\nTherefore, the ratio of pentagons to the total shapes is $1:2.$"}] [{:db/id #edb/ref 17592186515588 :knowledge-point/_questions [{:db/id #edb/ref 17592186073786 :knowledge-point/id #uuid "b6a21dbe-0674-5fa2-b3ee-e4069115c6be" :knowledge-point/title "Writing a Ratio as a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c7a0200-b59c-5801-885b-a9a72ac9c71e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186515042} {:answer/id #uuid "61dce4ea-67c2-5e04-b994-1ad7734b5bd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186515082} {:answer/id #uuid "6436abf3-387c-55fc-b4a4-8646d18e2feb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{1}" :db/id #edb/ref 17592186515087} {:answer/id #uuid "7d5fce3c-a994-51ce-8e85-866e785eb7fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186515130} {:answer/id #uuid "f61e4974-b2d2-5961-b651-f64c5ada5d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186515386}] :answer-field/correct {:answer/id #uuid "7d5fce3c-a994-51ce-8e85-866e785eb7fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186515130} :answer-field/id #uuid "a5edf232-7148-5791-8ed0-07796291a0df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515474}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2e2b3d0-06c7-5374-8f2a-5e2b0c04b187" :question/math-academy-id "q-60253" :question/problem "![](images/72/7237864f8c4c8711820ced0d2acad7a098e71a1965730e118eeed65f79bc496a.png)\n\nWhat ratio describes the number of rhombuses to circles?" :question/worked-solution "We count the number of rhombuses. We see that there are $3$ rhombuses.\n\n We count the number of circles. We see that there are $2$ circles.\n\nSo the ratio of rhombuses to circles is $\\frac{3}{2}.$"}] [{:db/id #edb/ref 17592186515568 :knowledge-point/_questions [{:db/id #edb/ref 17592186054800 :knowledge-point/id #uuid "ae662093-c3e8-5577-af6e-7e2f383da79d" :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Addition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1875ea73-f13c-57d4-a741-70e155a12822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a" :db/id #edb/ref 17592186514925} {:answer/id #uuid "20b648aa-d5d0-5faf-af78-d419c6aabd7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9a" :db/id #edb/ref 17592186514947} {:answer/id #uuid "2d6d74ab-d342-56fb-8ea0-9a4106caa0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a-9" :db/id #edb/ref 17592186514973} {:answer/id #uuid "8ecfa99c-b906-53f2-a081-af849a74bca6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{a}" :db/id #edb/ref 17592186515174} {:answer/id #uuid "ec29873a-f026-5265-a671-9e55b4a56120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a+9" :db/id #edb/ref 17592186515370}] :answer-field/correct {:answer/id #uuid "ec29873a-f026-5265-a671-9e55b4a56120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a+9" :db/id #edb/ref 17592186515370} :answer-field/id #uuid "ff6b6508-4543-52e8-9082-8cfcb40a4f2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515516}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "82e0c6bc-08da-5baa-b6ef-f85a33295d8a" :question/math-academy-id "q-75558" :question/problem "Translate the following phrase into an algebraic expression: \"Nine more than a number.\"" :question/worked-solution "If we denote our number by $a$, then the phrase \"nine more than a number\" can be written as\n\n$$\na+9.\n$$"}] [{:db/id #edb/ref 17592186515579 :knowledge-point/_questions [{:db/id #edb/ref 17592186152124 :knowledge-point/id #uuid "f0075774-6bd8-54c9-b698-4aacd499fce5" :knowledge-point/title "Classifying Numbers as Natural"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1daba185-8b77-5aec-aef0-5e19b2cbe869" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186514937} {:answer/id #uuid "323103e8-cc86-5e4d-a7f3-f4b3fad56610" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186514984} {:answer/id #uuid "86d6d528-b089-5674-9ee6-21c3da5c9504" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186515154} {:answer/id #uuid "ab2fb77e-c67e-5fa6-b913-1652d2e05a5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186515232} {:answer/id #uuid "c03e7d1f-d6a3-5a89-aba6-58d3bf03d60e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186515281}] :answer-field/correct {:answer/id #uuid "1daba185-8b77-5aec-aef0-5e19b2cbe869" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186514937} :answer-field/id #uuid "ce83d198-e8da-5698-936e-5f3c729fa5e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515495}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9f63b51c-dc94-5351-8801-eb6438eefe9b" :question/math-academy-id "q-98372" :question/problem "Which of the following are natural numbers?\n\nI. $4$\n\nII. $-1$\n\nIII. $0$" :question/worked-solution "The natural numbers consist of all positive whole numbers.\n\n$$\n1,\\,2,\\,3,\\,4,\\,5,…\n$$\n\nOf the given numbers, $4$ is a natural number, but $-1$ and $0$ are not.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186515531 :knowledge-point/_questions [{:db/id #edb/ref 17592186064229 :knowledge-point/id #uuid "c2097574-c45c-504d-8ec8-44474880cd21" :knowledge-point/title "Dividing Zero by a Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f379f80-98a0-58de-a89d-4bebbbe3c069" :answer/type {:db/id #edb/ref 17592186045498 :db/id