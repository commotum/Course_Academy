#{[{:db/id #edb/ref 17592186515522 :knowledge-point/_questions [{:db/id #edb/ref 17592186171932 :knowledge-point/id #uuid "fb8fa39c-a982-569a-b2e0-833c51259711" :knowledge-point/title "Determining if a Number Is Divisible by 3 or 9"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d2d098-2a69-510a-81e0-73d1dac134b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186514879} {:answer/id #uuid "54e47f42-90e3-5e87-9da0-7121c6f877b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186515063} {:answer/id #uuid "5ddc1748-c54d-52f9-b83d-77b10b8e524f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186515077} {:answer/id #uuid "6db19dc0-a972-59c4-8899-534655f444e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186515101} {:answer/id #uuid "db211885-c760-5c9b-82d8-324650fee491" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186515333}] :answer-field/correct {:answer/id #uuid "db211885-c760-5c9b-82d8-324650fee491" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186515333} :answer-field/id #uuid "5a012c9a-24db-583a-bec6-39e67dddf0b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515439}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09796f32-bb96-5a23-99aa-3f951bba421d" :question/math-academy-id "q-132395" :question/problem "Which digits, when inserted into the blank, make the number $◻46\\,283\\,123$ divisible by $3?$\n\nI. $3$\n\nII. $6$\n\nIII. $9$" :question/worked-solution "A number is divisible by $3$ if the sum of its digits is divisible by $3.$\n\nFor the number $◻46\\,283\\,123$ the sum of the digits is\n\n$$\n◻+4+6+2+8+3+1+2+3=29+◻.\n$$\n\nNow, let's consider each of the given digits that could be inserted into the blank.\n\n- If we insert $3$ into the blank, then the sum of the digits is $29+3=32,$ which is *not* divisible by $3.$\n\n- If we insert $6$ into the blank, then the sum of the digits is $29+6=35,$ which is *not* divisible by $3.$\n\n- If we insert $9$ into the blank, then the sum of the digits is $29+9=38,$ which is *not* divisible by $3.$\n\nTherefore, the correct answer is \"None.\""}] [{:db/id #edb/ref 17592186515582 :knowledge-point/_questions [{:db/id #edb/ref 17592186064255 :knowledge-point/id #uuid "6a3c970b-4086-52ef-ac0f-2b8c3d72fd51" :knowledge-point/title "Subtracting a Positive Number From a Non-Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "263730a7-d900-56d4-be80-9dadccb245dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186514960} {:answer/id #uuid "3f4d5d40-8d33-5b31-9752-23270c1b3868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186515007} {:answer/id #uuid "8ca50584-d69b-5398-8f05-a653b2a6d512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186515167} {:answer/id #uuid "96e1eee3-5077-58ac-b72f-c86132ca0639" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186515190} {:answer/id #uuid "d678d095-acd3-5b2e-9272-829f9b15150f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186515323}] :answer-field/correct {:answer/id #uuid "3f4d5d40-8d33-5b31-9752-23270c1b3868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186515007} :answer-field/id #uuid "a6d7cd97-51d5-5b03-bff9-714e06b9c85a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515475}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1cd61ea-798a-5042-9adf-ebc8c5167849" :question/math-academy-id "q-2089" :question/problem "$3-7=$" :question/worked-solution "To subtract $7$ from $3$, we start at $3$ on the number line and move $7$ places to the left. \n\n![](images/c5/c520527df91b786ff936ed3061e7596b9504ccdc9d959236a7daeba5f795654c.png)\n\nThis gives $3-7=-4.$"}] [{:db/id #edb/ref 17592186515567 :knowledge-point/_questions [{:db/id #edb/ref 17592186147544 :knowledge-point/id #uuid "638e604b-5416-5d3c-a61f-5be645aa255b" :knowledge-point/title "Identifying True Statements in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13d60628-2e34-5a04-8810-5657a4599223" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186514913} {:answer/id #uuid "85d382c2-60ee-52a0-8af7-005ba470406e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186515152} {:answer/id #uuid "aef19ca5-ff9c-50d9-8e0b-543cb86c89db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186515239} {:answer/id #uuid "b59f6c09-9eee-5a65-a69f-2fd0dc79df4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186515254} {:answer/id #uuid "c463c709-bb2f-50b7-94ad-28fe7da2872a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186515290}] :answer-field/correct {:answer/id #uuid "b59f6c09-9eee-5a65-a69f-2fd0dc79df4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186515254} :answer-field/id #uuid "90a3f767-62b1-56e7-8914-d9fc2589ce88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515463}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8134e1ae-9578-5877-ab86-0666cefb2b4c" :question/math-academy-id "q-350261" :question/problem "Maya and Priya are café owners. In the previous season, $55%$ of Maya’s orders were takeout, while the decimal proportion of Priya’s orders that were takeout was $0.8.$\n\nWhich of the following statements are true?\n\nI. Less than half of Maya's orders were takeout.\n\nII. More than half of Priya's orders were takeout.\n\nIII. Maya had a greater percentage of takeout orders compared to Priya." :question/worked-solution "Let's examine our statements in turn.\n\n- Statement I is false. Indeed, since \n\n$$\n55%>50%,\n$$\n\nmore than half of Maya's orders were takeout.\n\n- Statement II is true. Notice that \n\n$$\n0.8>0.5.\n$$\n\nSo, more than half of Priya's orders were takeout.\n\n- Statement III is false. We can compare $55%$ and $0.8$ by converting the decimal into a percent. \n\nTo do this, we multiply it by $100:$\n\n$$\n0.8\\times 100=80%\n$$\n\nSince  $55%<80%,$ Maya did not have a greater percentage of takeout orders compared to Priya.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186515611 :knowledge-point/_questions [{:db/id #edb/ref 17592186064364 :knowledge-point/id #uuid "9cb97145-a93a-5df3-8dbe-6777d21601c8" :knowledge-point/title "Multiplying a Positive Number by a Negative Number With Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097f1ec8-cd7a-54e6-b09c-ad492b1b69d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186514891} {:answer/id #uuid "9b12df53-fb74-533e-b0bd-f7a6b55abdd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15.5" :db/id #edb/ref 17592186515200} {:answer/id #uuid "9ceaee27-6a87-5935-a239-9ab3c4ce482e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186515205} {:answer/id #uuid "a5a3790b-50cd-59a8-b9ee-bc0773804594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186515223} {:answer/id #uuid "d0b39389-0b4f-557d-8541-f36e3d737e1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186515308}] :answer-field/correct {:answer/id #uuid "a5a3790b-50cd-59a8-b9ee-bc0773804594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186515223} :answer-field/id #uuid "30fab160-3791-5756-af82-eb9b85bfd673" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515427}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e4257f22-304f-5aae-a7d4-d381f535406f" :question/math-academy-id "q-43032" :question/problem "$4\\cdot (-3.5)=$" :question/worked-solution "We have a product of a positive number $(4)$ and a negative number $(-3.5).$ So the product will be negative:\n\n$$\n4\\cdot (-3.5)=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we multiply $4$ by $3.5$ without any signs: $4\\cdot 3.5=14.$ So, we get\n\n$$\n4\\cdot (-3.5)=-14.\n$$"}] [{:db/id #edb/ref 17592186515549 :knowledge-point/_questions [{:db/id #edb/ref 17592186054808 :knowledge-point/id #uuid "e5418e0e-fff7-5d08-b915-6e87be27a132" :knowledge-point/title "Plotting a Point in the Coordinate 