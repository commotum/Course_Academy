#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069567} :activity/id #uuid "09c8fe50-cab2-5dfd-a90a-5053ffffc1bf" :activity/scope {:db/id #edb/ref 17592186050574 :topic/id #uuid "54ee2cc0-54a0-5d60-a3d0-0b11995e4133" :topic/math-academy-id 462} :activity/steps [{:db/id #edb/ref 17592186069567 :step/content {:db/id #edb/ref 17592186069958 :tutorial/content "A function $f(x)$ is **continuous** over its entire domain if the graph of $y=f(x)$ can be drawn using a pencil and a piece of paper without taking the pencil off of the paper.\n\nTo illustrate, let's consider the function $y=x^2$ whose graph is shown below. \n\n![](images/67/67ffd0b78845693b522100f4f0ba460cae6fedd796964b24708e320eab04ce29.png)\n\n \n\nWe can draw as much of the function $y=x^2$ as we want without taking our pencil off of the paper. Therefore, we say that $y=x^2$ is **continuous** at every point in its domain.\n\nLet's compare this to the function $y=g(x)$ below:\n\n![](images/a0/a07ccd15d14fa3eeb00a9c4ab07674c1c169e2a0d0a3e9fcb64798e9929e2ff9.png)\n\n \n\nNotice that this function has a jump in its value at $x=0.$\n\nIt is *impossible* to draw $y=g(x)$ without taking the pencil off the paper to fill in the jump at $x=0.$ Therefore, we say that $y=g(x)$ has a **discontinuity** at $x=0.$" :tutorial/id #uuid "1fb32bea-3d77-5134-936c-bfa9f0381fdb" :tutorial/math-academy-id 2583 :tutorial/title "Introduction"} :step/id #uuid "3561bec4-880a-5815-bc18-84c3d62a3191" :step/math-academy-id 12020 :step/next {:db/id #edb/ref 17592186069576}} {:db/id #edb/ref 17592186069568 :step/content {:db/id #edb/ref 17592186068695 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068547 :question/id #uuid "f12b3891-021d-5ae3-a767-f9d423408ce6" :question/math-academy-id "e-3567"} :knowledge-point/id #uuid "6cd6c125-ecaf-5847-a802-ec1b3594a15c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049534}] :knowledge-point/question-generator {:db/id #edb/ref 17592186513512} :knowledge-point/questions [{:db/id #edb/ref 17592186069365} {:db/id #edb/ref 17592186069369} {:db/id #edb/ref 17592186233061} {:db/id #edb/ref 17592186234403} {:db/id #edb/ref 17592186237871} {:db/id #edb/ref 17592186336004} {:db/id #edb/ref 17592186348065} {:db/id #edb/ref 17592186348066} {:db/id #edb/ref 17592186392615} {:db/id #edb/ref 17592186513492} {:db/id #edb/ref 17592186513495} {:db/id #edb/ref 17592186548982} {:db/id #edb/ref 17592186549055}] :knowledge-point/title "Determining Whether a Function Is Continuous at a Given Point"} :step/id #uuid "1c9dde49-f9f9-5036-8e84-b7e1ced3796b" :step/math-academy-id 12021 :step/next {:db/id #edb/ref 17592186069569}} {:db/id #edb/ref 17592186069569 :step/content {:db/id #edb/ref 17592186068696 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068548 :question/id #uuid "514240a0-8a38-564f-ab4c-d0bacb0c5f6b" :question/math-academy-id "e-3568"} :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/question-generator {:db/id #edb/ref 17592186514621} :knowledge-point/questions [{:db/id #edb/ref 17592186069368} {:db/id #edb/ref 17592186069370} {:db/id #edb/ref 17592186233079} {:db/id #edb/ref 17592186233392} {:db/id #edb/ref 17592186233394} {:db/id #edb/ref 17592186235380} {:db/id #edb/ref 17592186235381} {:db/id #edb/ref 17592186240783} {:db/id #edb/ref 17592186240784} {:db/id #edb/ref 17592186240785} {:db/id #edb/ref 17592186329859} {:db/id #edb/ref 17592186329860} {:db/id #edb/ref 17592186329861} {:db/id #edb/ref 17592186386069} {:db/id #edb/ref 17592186392602} {:db/id #edb/ref 17592186396578} {:db/id #edb/ref 17592186396673} {:db/id #edb/ref 17592186514557} {:db/id #edb/ref 17592186514561} {:db/id #edb/ref 17592186514573} {:db/id #edb/ref 17592186514578} {:db/id #edb/ref 17592186514583} {:db/id #edb/ref 17592186514587} {:db/id #edb/ref 17592186514590} {:db/id #edb/ref 17592186514591} {:db/id #edb/ref 17592186514601} {:db/id #edb/ref 17592186514618} {:db/id #edb/ref 17592186548989}] :knowledge-point/title "Identifying Points of Discontinuity"} :step/id #uuid "74cd2bd0-c1c2-5429-adda-d13aa18601d2" :step/math-academy-id 12022 :step/next {:db/id #edb/ref 17592186069570}} {:db/id #edb/ref 17592186069570 :step/content {:db/id #edb/ref 17592186068697 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068549 :question/id #uuid "01bca086-0ed4-5626-a357-e0724685f144" :question/math-academy-id "e-3569"} :knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048943} {:db/id #edb/ref 17592186051049}] :knowledge-point/question-generator {:db/id #edb/ref 17592186514550} :knowledge-point/questions [{:db/id #edb/ref 17592186069366} {:db/id #edb/ref 17592186069367} {:db/id #edb/ref 17592186234087} {:db/id #edb/ref 17592186240786} {:db/id #edb/ref 17592186240787} {:db/id #edb/ref 17592186240788} {:db/id #edb/ref 17592186240800} {:db/id #edb/ref 17592186329853} {:db/id #edb/ref 17592186329854} {:db/id #edb/ref 17592186329855} {:db/id #edb/ref 17592186329856} {:db/id #edb/ref 17592186329857}] :knowledge-point/title "Determining the Behavior of a Function in the Neighborhood of a Point"} :step/id #uuid "64c70852-38a7-5f5e-ade8-36856f8eef67" :step/math-academy-id 12023} {:db/id #edb/ref 17592186069576 :step/content {:db/id #edb/ref 17592186069961 :tutorial/content "Now consider the function $y=h(x)$ below. This function has a discontinuity at $x=0,$ so it is not continuous over its entire domain.\n\n![](images/4e/4e41ca41e4befba33c62da68666a8c4a2e2c7a19c79331360ae4bf124edafd50.png)\n\n \n\nHowever, the function $h(x)$ may be continuous at other points, such as $x=1.$ \n\nTo determine whether $h(x)$ is continuous at $x=1,$ we have to consider points in the **neighborhood** of $x=1.$ Roughly speaking, the *neighborhood of $x=1$* means the points on the curve that have an $x$-coordinate that's close to $1.$\n\nIndeed, in the *neighborhood* of $x=1,$ we can draw the function $h(x)$ without taking the pencil off the paper. So, $h(x)$ is indeed continuous at $x=1.$" :tutorial/id #uuid "54ca4bef-1b8e-5315-85d4-0667910b332c" :tutorial/math-academy-id 2640 :tutorial/title "Continuity at a Point"} :step/id #uuid "c5269250-b2f9-525d-bfaa-9f0e6033687b" :step/math-academy-id 12404 :step/next {:db/id #edb/ref 17592186069568}}] :activity/title "Determining Continuity from Graphs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068989}]}
