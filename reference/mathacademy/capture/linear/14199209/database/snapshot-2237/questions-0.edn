#{[{:db/id #edb/ref 17592186515596 :knowledge-point/_questions [{:db/id #edb/ref 17592186054736 :knowledge-point/id #uuid "0959286b-1859-50b5-acd2-d83ffc4ed96d" :knowledge-point/title "Finding the Magnitude of a Complex Number With No Real Part"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "008a9322-bc09-5270-b395-42f5ae02f992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186514873} {:answer/id #uuid "2370feff-0720-50c4-8b43-d0d1aab5431b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186514956} {:answer/id #uuid "8ef6c697-69ee-5d21-b15c-a353586495fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186515175} {:answer/id #uuid "ab0f6764-317d-5061-9f80-de4f98c14068" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186515231} {:answer/id #uuid "eb76ce3d-4469-58f1-ae4b-06566734b7f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186515369}] :answer-field/correct {:answer/id #uuid "ab0f6764-317d-5061-9f80-de4f98c14068" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186515231} :answer-field/id #uuid "35aa10d9-d0b5-5bf2-a319-9f587b8c0a83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515429}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c3ed3524-1800-5472-a34a-a2b28ed462d4" :question/math-academy-id "q-160277" :question/problem "What is the magnitude of the number $z=2\\text{i}?$" :question/worked-solution "The imaginary number $2\\text{i}$ is equivalent to the complex number $z=0+2\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0+2\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(2)^{2}} \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186515604 :knowledge-point/_questions [{:db/id #edb/ref 17592186054736 :knowledge-point/id #uuid "0959286b-1859-50b5-acd2-d83ffc4ed96d" :knowledge-point/title "Finding the Magnitude of a Complex Number With No Real Part"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4240242c-ccfc-5919-bcd1-23f365cf0d9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186515012} {:answer/id #uuid "5fc877af-90aa-504b-aeaa-80f58a1269ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{13}" :db/id #edb/ref 17592186515080} {:answer/id #uuid "81fce244-4b65-5986-bf17-3c08a29adf62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186515142} {:answer/id #uuid "9313ceb2-8065-5a51-8891-b63edaff61bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186515181} {:answer/id #uuid "e910e0d2-e229-5e15-aa4e-2cbc5871b5be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{-13}" :db/id #edb/ref 17592186515363}] :answer-field/correct {:answer/id #uuid "9313ceb2-8065-5a51-8891-b63edaff61bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186515181} :answer-field/id #uuid "fea1f402-87f7-543c-a08b-8028f822c3a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515515}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d1878d53-723f-5989-b8bc-003976423212" :question/math-academy-id "q-70258" :question/problem "What is the magnitude of the number $z=-13\\text{i}?$" :question/worked-solution "The imaginary number $-13\\text{i}$ is equivalent to the complex number $z=0-13\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0-13\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(-13)^{2}} \\\\  & =13.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186515521 :knowledge-point/_questions [{:db/id #edb/ref 17592186054737 :knowledge-point/id #uuid "0ba72f2d-3029-5ebe-9527-8ea775beac22" :knowledge-point/title "Finding the Magnitude of a Complex Number With Variable Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "336f253c-9736-520b-8fb7-d41987f37473" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+4{c}^{2}" :db/id #edb/ref 17592186514987} {:answer/id #uuid "58e24837-7d55-5cdf-a839-e3afda08636c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{4{x}^{2}-16{c}^{2}}" :db/id #edb/ref 17592186515072} {:answer/id #uuid "7989544f-7ea6-5b3b-8e3c-3231d82c6955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{4{x}^{2}+16{c}^{2}}" :db/id #edb/ref 17592186515125} {:answer/id #uuid "8b810d0d-88c0-5a8f-aeca-ac3055abcc67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2{x}^{2}+4{c}^{2}}" :db/id #edb/ref 17592186515165} {:answer/id #uuid "d4f229fc-d9e2-5832-9150-33c974b452ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2{x}^{2}-4{c}^{2}}" :db/id #edb/ref 17592186515317}] :answer-field/correct {:answer/id #uuid "7989544f-7ea6-5b3b-8e3c-3231d82c6955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{4{x}^{2}+16{c}^{2}}" :db/id #edb/ref 17592186515125} :answer-field/id #uuid "17b8dedc-9dc9-5851-973e-6ace85b1c419" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515415}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "08d92dcc-49dd-5acf-9195-6229900ba610" :question/math-academy-id "q-79466" :question/problem "Find $|z|$ if $z=2x+4c\\text{i},$ where $x$ and $c$ are real numbers." :question/worked-solution "For a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nFor the complex number $z=2x+4c\\text{i},$ we have $a=2x$ and $b=4c.$ So, the magnitude is given by\n\n$$\n\\begin{aligned}\\begin{aligned}|2x+4c\\text{i}| & =\\sqrt{(2x)^{2}+(4c)^{2}} \\\\  & =\\sqrt{4{x}^{2}+16{c}^{2}}.\\end{aligned}\\end{aligned}\n$$"}]}
