#{[{:activity/first-step {:db/id #edb/ref 17592186055736} :activity/id #uuid "20dc52fd-28a9-5191-a425-32855a28683b" :activity/scope {:db/id #edb/ref 17592186049831 :topic/id #uuid "1726eb44-d776-5df6-8797-69b129ad3167" :topic/math-academy-id 34} :activity/steps [{:db/id #edb/ref 17592186055736 :step/content {:db/id #edb/ref 17592186055976 :tutorial/content "The **magnitude** of a complex number is its distance from the origin. It's denoted as $\\mid z \\mid$.\n\nFor example, consider the complex number\n\n$$\nz=-4+5\\textrm{i}\n$$\n\nshown in the complex plane below.\n\n![](images/33/33d0294178c15b883f8f4988e34d7c81244edd9f426e9ed206e10469dbc5abf1.png)\n\nUsing the Pythagorean theorem, we obtain\n\n$$\n\\begin{aligned}\n\\mid z \\mid &= \\sqrt{(-4)^{2} + (5)^{2}} \\\\\n&= \\sqrt{16 + 25} \\\\\n&= \\sqrt{41}\n\\end{aligned}\n$$\n\nIn general, for a complex number\n\n$$\nz=a+b\\textrm{i}\n$$\n\nthe magnitude of $z$ can be found as follows:\n\n$$\n\\mid z \\mid = \\sqrt{a^2+b^2}\n$$" :tutorial/id #uuid "df0d2109-2954-5b2d-8b02-98a43f80ac89" :tutorial/math-academy-id 3329 :tutorial/title "Introduction"} :step/id #uuid "332a5684-42f1-5051-9109-e6eecf07792c" :step/math-academy-id 464642 :step/next {:db/id #edb/ref 17592186055737}} {:db/id #edb/ref 17592186055737 :step/content {:db/id #edb/ref 17592186054735 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054548 :question/id #uuid "98b156f1-66b9-56f5-be59-ba15d1b857db" :question/math-academy-id "e-5038"} :knowledge-point/id #uuid "54d9d8e4-c521-5b7d-bca7-f3c5b0d2b1d7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050191} {:db/id #edb/ref 17592186050975}] :knowledge-point/questions [{:db/id #edb/ref 17592186055466} {:db/id #edb/ref 17592186055511} {:db/id #edb/ref 17592186234471}] :knowledge-point/title "Finding the Magnitude of a Complex Number"} :step/id #uuid "cb92b79b-ab97-5fdc-b40d-801d52bba2ca" :step/math-academy-id 464643 :step/next {:db/id #edb/ref 17592186055738}} {:db/id #edb/ref 1759218