#{[{:db/id #edb/ref 17592186234126 :knowledge-point/_questions [{:db/id #edb/ref 17592186138422 :knowledge-point/id #uuid "3329cd2b-b1f7-59ca-9a4e-cbb30aadbbf3" :knowledge-point/title "Finding the Product of Two Nonlinear Binomials"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a97a25c8-3d64-58a0-8a46-bc117211d97c" :question/math-academy-id "q-5132" :question/problem "$(9{u}^{3}-4{v}^{2})(9{u}^{3}+4{v}^{2})=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=9{u}^{3}$ and $b=4{v}^{2},$ we have\n\n$$\n\\begin{aligned}(9{u}^{3}-4{v}^{2})(9{u}^{3}+4{v}^{2}) & = \\\\ {(9{u}^{3})}^{2}-{(4{v}^{2})}^{2} & = \\\\ 81{u}^{6}-16{v}^{4}.\\end{aligned}\n$$"}]}
