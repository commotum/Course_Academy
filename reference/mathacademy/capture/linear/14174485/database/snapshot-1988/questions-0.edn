ifference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=9{u}^{3}$ and $b=4{v}^{2},$ we have\n\n$$\n\\begin{aligned}(9{u}^{3}-4{v}^{2})(9{u}^{3}+4{v}^{2}) & = \\\\ {(9{u}^{3})}^{2}-{(4{v}^{2})}^{2} & = \\\\ 81{u}^{6}-16{v}^{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492848 :knowledge-point/_questions [{:db/id #edb/ref 17592186138421 :knowledge-point/id #uuid "86c57e03-cecd-5cc3-9158-b7b5caaf2530" :knowledge-point/title "Finding the Product of Two Binomials With Leading Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11a9a132-bbd3-56be-adc6-9533d084b6e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{w}^{2}-20w+16" :db/id #edb/ref 17592186492248} {:answer/id #uuid "3447384d-9ecf-572f-8792-7b3d981567eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{w}^{2}-16" :db/id #edb/ref 17592186492326} {:answer/id #uuid "46caea5b-a2f6-5db9-b407-dc210ac19aaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{w}^{2}-10w+16" :db/id #edb/ref 17592186492358} {:answer/id #uuid "a3c7e7dc-f643-5b4e-b56d-495a7442aa92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{w}^{2}+20w+16" :db/id #edb/ref 17592186492546} {:answer/id #uuid "bdf1dae4-c035-5207-86e5-e426c6896c0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{w}^{2}+16" :db/id #edb/ref 17592186492596}] :answer-field/correct {:answer/id #uuid "3447384d-9ecf-572f-8792-7b3d981567eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49{w}^{2}-16" :db/id #edb/ref 17592186492326} :answer-field/id #uuid "49a31005-f7ac-5156-8bbe-2b2e28da6848" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492733}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "33f90fc9-0783-587e-8fb0-ea53809ed85b" :question/math-academy-id "q-52169" :question/problem "$(7w-4)(7w+4)=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=7w$ and $b=4,$ we have\n\n$$\n\\begin{aligned}(7w-4)(7w+4) & = \\\\ (7w)^{2}-{4}^{2} & = \\\\ 49{w}^{2}-16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186492909 :knowledge-point/_questions [{:db/id #edb/ref 17592186138423 :knowledge-point/id #uuid "dc7f5072-ef21-5abb-9889-13ab8814af9a" :knowledge-point/title "Finding the Product of Two Binomials Containing General Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51adf9ba-7d77-5e07-9003-ad27a96bdcac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{2m}+5" :db/id #edb/ref 17592186492373} {:answer/id #uuid "61d76e6c-c1dd-58ac-aa25-215aafd382c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{m}-5" :db/id #edb/ref 17592186492415} {:answer/id #uuid "7365dd6a-4ad2-587b-b7f1-820e11f5f06f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{2m}-5" :db/id #edb/ref 17592186492447} {:answer/id #uuid "a46ed410-3c39-592c-9c9d-b33b33a4edbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{2m}+\\sqrt{5}" :db/id #edb/ref 17592186492549} {:answer/id #uuid "ae58ba3b-6b4e-5ca7-97a8-b167bcc4b7f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{m}+\\sqrt{5}" :db/id #edb/ref 17592186492566}] :answer-field/correct {:answer/id #uuid "7365dd6a-4ad2-587b-b7f1-820e11f5f06f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{2m}-5" :db/id #edb/ref 17592186492447} :answer-field/id #uuid "9f69e280-5ee5-5da5-b875-931b7eef7051" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492768}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c1188285-b76b-5dfe-bc37-680ab9486187" :question/math-academy-id "q-78928" :question/problem "$({k}^{m}+\\sqrt{5})({k}^{m}-\\sqrt{5})=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a={k}^{m}$ and $b=\\sqrt{5},$ we have \n\n$$\n\\begin{aligned}({k}^{m}+\\sqrt{5})({k}^{m}-\\sqrt{5}) & = \\\\ ({k}^{m})^{2}-(\\sqrt{5})^{2} & = \\\\ {k}^{2m}-5.\\end{aligned}\n$$"}]}
