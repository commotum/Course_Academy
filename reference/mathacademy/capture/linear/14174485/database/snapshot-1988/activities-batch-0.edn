733}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "33f90fc9-0783-587e-8fb0-ea53809ed85b" :question/math-academy-id "q-52169" :question/problem "$(7w-4)(7w+4)=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=7w$ and $b=4,$ we have\n\n$$\n\\begin{aligned}(7w-4)(7w+4) & = \\\\ (7w)^{2}-{4}^{2} & = \\\\ 49{w}^{2}-16.\\end{aligned}\n$$"} :step/id #uuid "5fea5894-0ceb-5f99-955a-9c7a291f853c" :step/next {:db/id #edb/ref 17592186492990}} {:db/id #edb/ref 17592186492985 :step/content {:db/id #edb/ref 17592186234126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35491d80-a77f-52c6-a568-bd24e13c7116" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{u}^{3}+4{v}^{2}" :db/id #edb/ref 17592186492329} {:answer/id #uuid "9e781594-53d3-5ca5-9e41-43c8424c3fa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "81{u}^{3}-16{v}^{2}" :db/id #edb/ref 17592186492526} {:answer/id #uuid "a600b6da-a934-537d-9ba1-c9162991c253" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "81{u}^{6}-16{v}^{4}" :db/id #edb/ref 17592186492553} {:answer/id #uuid "c02f0190-7201-5e62-92ea-188e7964fa1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{u}^{3}-4{v}^{2}" :db/id #edb/ref 17592186492599} {:answer/id #uuid "e741361b-5fc6-54dd-b921-faf3dea25837" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9{u}^{6}-4{v}^{4}" :db/id #edb/ref 17592186492666}] :answer-field/correct {:db/id #edb/ref 17592186492553} :answer-field/id #uuid "26889d78-c51c-51db-a21e-7c52ae1d80b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492718}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a97a25c8-3d64-58a0-8a46-bc117211d97c" :question/math-academy-id "q-5132" :question/problem "$(9{u}^{3}-4{v}^{2})(9{u}^{3}+4{v}^{2})=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=9{u}^{3}$ and $b=4{v}^{2},$ we have\n\n$$\n\\begin{aligned}(9{u}^{3}-4{v}^{2})(9{u}^{3}+4{v}^{2}) & = \\\\ {(9{u}^{3})}^{2}-{(4{v}^{2})}^{2} & = \\\\ 81{u}^{6}-16{v}^{4}.\\end{aligned}\n$$"} :step/id #uuid "aceced29-dbef-543a-9e7f-9315fba7db9c" :step/next {:db/id #edb/ref 17592186492952}} {:db/id #edb/ref 17592186492990 :step/content {:db/id #edb/ref 17592186492909 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51adf9ba-7d77-5e07-9003-ad27a96bdcac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{k}^{2m}+5" :db/id #edb/ref 17592186492373} {:answer/id #uuid "61d76e6c-c1dd-58ac-aa25-215aafd382c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{k}^{m}-5" :db/id #edb/ref 17592186492415} {:answer/id #uuid "7365dd6a-4ad2-587b-b7f1-820e11f5f06f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{k}^{2m}-5" :db/id #edb/ref 17592186492447} {:answer/id #uuid "a46ed410-3c39-592c-9c9d-b33b33a4edbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{k}^{2m}+\\sqrt{5}" :db/id #edb/ref 17592186492549} {:answer/id #uuid "ae58ba3b-6b4e-5ca7-97a8-b167bcc4b7f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{k}^{m}+\\sqrt{5}" :db/id #edb/ref 17592186492566}] :answer-field/correct {:db/id #edb/ref 17592186492447} :answer-field/id #uuid "9f69e280-5ee5-5da5-b875-931b7eef7051" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492768}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c1188285-b76b-5dfe-bc37-680ab9486187" :question/math-academy-id "q-78928" :question/problem "$({k}^{m}+\\sqrt{5})({k}^{m}-\\sqrt{5})=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a={k}^{m}$ and $b=\\sqrt{5},$ we have \n\n$$\n\\begin{aligned}({k}^{m}+\\sqrt{5})({k}^{m}-\\sqrt{5}) & = \\\\ ({k}^{m})^{2}-(\\sqrt{5})^{2} & = \\\\ {k}^{2m}-5.\\end{aligned}\n$$"} :step/id #uuid "bac4923d-4220-5254-af97-b724a6683d30"}] :activity/title "The Difference of Squares Formula" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492218}]}
