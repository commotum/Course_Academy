#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186550051} :activity/id #uuid "b0fb9cbe-a644-586a-b7c5-2e3cbc97298d" :activity/scope {:db/id #edb/ref 17592186050372 :topic/id #uuid "43f7df3c-d8d4-556e-9f46-8a4092e26bff" :topic/math-academy-id 450} :activity/steps [{:db/id #edb/ref 17592186550050 :step/content {:db/id #edb/ref 17592186549954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b94ed9c-f4fb-5037-a3fd-676575385f34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(y-6)^{2}+5" :db/id #edb/ref 17592186549335} {:answer/id #uuid "239e272e-e941-51b1-88d1-658092cfdf99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(y-24)^{2}+5" :db/id #edb/ref 17592186549389} {:answer/id #uuid "3d6d081e-5e34-5799-885e-d02bf5b30f41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(y-12)^{2}+5" :db/id #edb/ref 17592186549440} {:answer/id #uuid "4b420642-8b38-528a-b9fd-458b11392903" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(y+12)^{2}+5" :db/id #edb/ref 17592186549468} {:answer/id #uuid "90614b3a-fb15-561e-801a-0578deafc573" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(y+24)^{2}+5" :db/id #edb/ref 17592186549598}] :answer-field/correct {:db/id #edb/ref 17592186549440} :answer-field/id #uuid "1776e3b4-56ca-52fb-a385-2675941436c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186549804}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3846b0e4-266a-5fcc-97c9-5ac90ce8b7bf" :question/math-academy-id "q-140285" :question/problem "Rewrite the expression $({y}^{2}-24y+144)+5$ as the sum of a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{y}^{2}-2ay+{a}^{2}=(y-a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{y}^{2}-24y+144 & = \\\\ {y}^{2}-24y+{12}^{2} & = \\\\ {y}^{2}-2\\cdot 12y+{12}^{2} & = \\\\ (y-12)^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({y}^{2}-24y+144)+5 & = \\\\ (y-12)^{2}+5 & .\\end{aligned}\n$$"} :step/id #uuid "46213224-80fa-53d0-9106-cff102084b4d" :step/next {:db/id #edb/ref 17592186550065}} {:db/id #edb/ref 17592186550051 :step/content {:db/id #edb/ref 17592186272045 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "676795d7-785f-5397-8327-127950122542" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x-11)^{2}-4" :db/id #edb/ref 17592186549513} {:answer/id #uuid "6d0cbb7e-2e2b-5c3e-9916-24ba60cdd66e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+11)^{2}-4" :db/id #edb/ref 17592186549524} {:answer/id #uuid "782c0f56-ce37-5099-a0fe-148c3a2874bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+12)^{2}-4" :db/id #edb/ref 17592186549545} {:answer/id #uuid "92ce75a4-5626-5103-ac1f-efecdd50c67c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x-22)^{2}-4" :db/id #edb/ref 17592186549604} {:answer/id #uuid "e423200f-b6b6-53b6-8137-df750e0ae04e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x-12)^{2}-4" :db/id #edb/ref 17592186549736}] :answer-field/correct {:db/id #edb/ref 17592186549513} :answer-field/id #uuid "90eb344c-2847-58a2-8769-e020f945532e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271768}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ff51e775-e2b4-585e-a683-f90782853abe" :question/math-academy-id "q-140283" :question/problem "Rewrite the expression $({x}^{2}-22x+121)-4$ as the difference between a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-22x+121 & = \\\\ {x}^{2}-22x+{11}^{2} & = \\\\ {x}^{2}-2\\cdot 11x+{11}^{2} & = \\\\ (x-11)^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-22x+121)-4 & = \\\\ (x-11)^{2}-4 & .\\end{aligned}\n$$"} :step/id #uuid "46931b01-d215-5f84-b5da-4675f952102f" :step/next {:db/id #edb/ref 17592186550050}} {:db/id #edb/ref 17592186550065 :step/content {:db/id #edb/ref 17592186272296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53ee2aa7-49df-5b3a-8072-6c045e66c322" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+10)^{2}-5" :db/id #edb/ref 17592186549484} {:answer/id #uuid "8a5616f0-230f-5380-b162-0895d7287876" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+5)^{2}+12" :db/id #edb/ref 17592186549580} {:answer/id #uuid "a61c1956-9aa0-5bda-b2b7-c15d6dd5eb67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+5)^{2}+10" :db/id #edb/ref 17592186549628} {:answer/id #uuid "adae3f5a-4f4b-5c8d-b4ef-48df06cebd7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+5)^{2}-7" :db/id #edb/ref 17592186549640} {:answer/id #uuid "b69ae637-47df-5d0a-a406-5a5d5619d853" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+5)^{2}-9" :db/id #edb/ref 17592186549655}] :answer-field/correct {:db/id #edb/ref 17592186549655} :answer-field/id #uuid "12b561ff-d7d5-56bf-bd70-881cdbd1aea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186271540}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c7d3420b-3f28-5142-8868-756f1394ea88" :question/math-academy-id "q-141537" :question/problem "Complete the square on the quadratic expression ${x}^{2}+10x+16.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 5x+16\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${5}^{2},$ writing the constant term $16$ last:\n\n$$\n{{x}^{2}+2\\cdot 5x+{5}^{2}}_{⏟}-\\,{5}^{2}+16\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+5)^{2}-{5}^{2}+16\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x+5)^{2}-9.\n$$"} :step/id #uuid "6b79bb64-c64c-594d-b208-8d0b50578499"}] :activity/title "Completing the Square" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186549311}]}
