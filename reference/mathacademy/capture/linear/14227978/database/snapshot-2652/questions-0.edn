#{[{:db/id #edb/ref 17592186272045 :knowledge-point/_questions [{:db/id #edb/ref 17592186068874 :knowledge-point/id #uuid "bf9b812d-0dbf-5a67-9d45-3cc5e373b2b1" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated: Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "098366e9-6bbf-557f-8b0b-c28f1f5c5d06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+12{)}^{2}-4" :db/id #edb/ref 17592186269356} {:answer/id #uuid "229c01ab-0ea9-5605-90a1-1d5a7751e77a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-11{)}^{2}-4" :db/id #edb/ref 17592186269568} {:answer/id #uuid "9d389434-bcbe-5f2b-ab97-000df772d7d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-12{)}^{2}-4" :db/id #edb/ref 17592186270659} {:answer/id #uuid "aa8a2c46-7cb2-59b0-9203-35410fcdd6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-22{)}^{2}-4" :db/id #edb/ref 17592186270793} {:answer/id #uuid "b0f56343-9654-51c6-8939-85100071b4dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+11{)}^{2}-4" :db/id #edb/ref 17592186270849}] :answer-field/correct {:answer/id #uuid "229c01ab-0ea9-5605-90a1-1d5a7751e77a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-11{)}^{2}-4" :db/id #edb/ref 17592186269568} :answer-field/id #uuid "90eb344c-2847-58a2-8769-e020f945532e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff51e775-e2b4-585e-a683-f90782853abe" :question/math-academy-id "q-140283" :question/problem "Rewrite the expression $({x}^{2}-22x+121)-4$ as the difference between a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a{)}^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-22x+121 & = \\\\ {x}^{2}-22x+{11}^{2} & = \\\\ {x}^{2}-2\\cdot 11x+{11}^{2} & = \\\\ (x-11{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-22x+121)-4 & = \\\\ (x-11{)}^{2}-4 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272296 :knowledge-point/_questions [{:db/id #edb/ref 17592186068875 :knowledge-point/id #uuid "366b36a5-c909-5ea5-a05d-a6052fcd41d7" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129c0ce9-31d0-501f-9253-202530581425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}+10" :db/id #edb/ref 17592186269432} {:answer/id #uuid "1e413b35-35e1-5ce6-a283-f4ff4b83d4f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+10{)}^{2}-5" :db/id #edb/ref 17592186269522} {:answer/id #uuid "395d3e65-bf9a-53cf-a730-73e30942c7aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}-9" :db/id #edb/ref 17592186269789} {:answer/id #uuid "899c0f97-acdd-567e-ab3c-221326e9fa7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}+12" :db/id #edb/ref 17592186270456} {:answer/id #uuid "d9c19f26-9f49-5230-b707-0daae3af6b9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}-7" :db/id #edb/ref 17592186271177}] :answer-field/correct {:answer/id #uuid "395d3e65-bf9a-53cf-a730-73e30942c7aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}-9" :db/id #edb/ref 17592186269789} :answer-field/id #uuid "12b561ff-d7d5-56bf-bd70-881cdbd1aea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271540}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7d3420b-3f28-5142-8868-756f1394ea88" :question/math-academy-id "q-141537" :question/problem "Complete the square on the quadratic expression ${x}^{2}+10x+16.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 5x+16\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${5}^{2},$ writing the constant term $16$ last:\n\n$$\n{{x}^{2}+2\\cdot 5x+{5}^{2}}_{⏟}-\\,{5}^{2}+16\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+5{)}^{2}-{5}^{2}+16\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x+5{)}^{2}-9.\n$$"}]}
