[{"source" ":org/Math-Academy" "forms" [[:db/retract 17592186271768 :answer-field/choices 17592186269568] [:db/retract 17592186271768 :answer-field/choices 17592186270849] [:db/retract 17592186271768 :answer-field/choices 17592186270659] [:db/retract 17592186271768 :answer-field/choices 17592186270793] [:db/retract 17592186271768 :answer-field/choices 17592186269356] [:db/retract 17592186271540 :answer-field/choices 17592186270456] [:db/retract 17592186271540 :answer-field/choices 17592186269522] [:db/retract 17592186271540 :answer-field/choices 17592186269432] [:db/retract 17592186271540 :answer-field/choices 17592186271177] [:db/retract 17592186271540 :answer-field/choices 17592186269789] {:db/id 17592186068874 :knowledge-point/questions ["question-3846b0e4-266a-5fcc-97c9-5ac90ce8b7bf"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186272045 :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-22x+121 & = \\\\ {x}^{2}-22x+{11}^{2} & = \\\\ {x}^{2}-2\\cdot 11x+{11}^{2} & = \\\\ (x-11)^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-22x+121)-4 & = \\\\ (x-11)^{2}-4 & .\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186271768 :answer-field/correct "answer-676795d7-785f-5397-8327-127950122542" :answer-field/choices ["answer-6d0cbb7e-2e2b-5c3e-9916-24ba60cdd66e" "answer-782c0f56-ce37-5099-a0fe-148c3a2874bb" "answer-676795d7-785f-5397-8327-127950122542" "answer-e423200f-b6b6-53b6-8137-df750e0ae04e" "answer-92ce75a4-5626-5103-ac1f-efecdd50c67c"] :db/ensure [:answer-field/validate]} {:db/id "answer-6d0cbb7e-2e2b-5c3e-9916-24ba60cdd66e" :answer/id #uuid "6d0cbb7e-2e2b-5c3e-9916-24ba60cdd66e" :answer/type :answer.type/math :answer/value "(x+11)^{2}-4" :db/ensure [:answer/validate]} {:db/id "answer-782c0f56-ce37-5099-a0fe-148c3a2874bb" :answer/i