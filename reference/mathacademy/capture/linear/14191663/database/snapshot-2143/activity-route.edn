#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186505861} :activity/id #uuid "99eb6a44-d2b9-5096-b3ab-f9426e7c07c4" :activity/scope {:db/id #edb/ref 17592186048274 :topic/id #uuid "8ec9e357-9aa8-58e6-a773-83ca66dffe88" :topic/math-academy-id 354} :activity/steps [{:db/id #edb/ref 17592186505855 :step/content {:db/id #edb/ref 17592186505799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f6031fe-dae8-5f79-8354-ae1008ca4d70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u=-\\frac{3(q+t)}{t}" :db/id #edb/ref 17592186505187} {:answer/id #uuid "42e1ca41-9357-5447-aecf-19fa174b44b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u=\\frac{3(2q+3)}{t}" :db/id #edb/ref 17592186505239} {:answer/id #uuid "c6e30156-92fb-5dac-a0b6-4c80f7ce8c61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u=\\frac{3(q-t)}{t}" :db/id #edb/ref 17592186505491} {:answer/id #uuid "c8b1a494-b2fa-50bd-90e0-abef56db21bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u=-\\frac{3(2q+3)}{2t}" :db/id #edb/ref 17592186505494} {:answer/id #uuid "cedd86ac-999f-5768-b398-f390ebb9ae13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u=\\frac{3(2q+t)}{t}" :db/id #edb/ref 17592186505502}] :answer-field/correct {:db/id #edb/ref 17592186505502} :answer-field/id #uuid "15fd936a-538d-59e8-a7b2-44862239f5b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186505617}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ad562e0e-d9eb-505d-ab03-28a6d5a05d76" :question/math-academy-id "q-101844" :question/problem "Solve for $u$ where $\\frac{ut}{3}-t=2q.$" :question/worked-solution "We need to isolate $u,$ so we will treat the other variables $t$ and $q$ as constants. We can use the addition and multiplication principles to solve for $u.$\n\nFirst, we add $t$ from both sides of the equation:\n\n$$\n\\begin{aligned}\\frac{ut}{3}-t & =2q \\\\ \\frac{ut}{3}-t+t & =2q+t \\\\ \\frac{ut}{3} & =2q+t\\end{aligned}\n$$\n\nThen, we multiply by $3$ to get rid of the fraction:\n\n$$\n\\begin{aligned}\\frac{ut}{3} & =2q+t \\\\ 3\\cdot \\frac{ut}{3} & =3\\cdot (2q+t) \\\\ ut & =3(2q+t)\\end{aligned}\n$$\n\nFinally, we divide by $t$ to get $u$ alone:\n\n$$\n\\begin{aligned}ut & =3(2q+t) \\\\ \\frac{ut}{t} & =\\frac{3(2q+t)}{t} \\\\ u & =\\frac{3(2q+t)}{t}\\end{aligned}\n$$\n\n**Note:** This result assumes that $t\\ne 0.$"} :step/id #uuid "1f219f56-c36c-5367-afab-e9542307a462"} {:db/id #edb/ref 17592186505861 :step/content {:db/id #edb/ref 17592186505773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a26a004-ab1a-577e-b192-fb3a04ccd597" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "S=N(A-P)" :db/id #edb/ref 17592186505286} {:answer/id #uuid "68d1cfd7-eb14-56cd-9f35-c1684245f8b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "S=\\frac{P}{N}-A" :db/id #edb/ref 17592186505318} {:answer/id #uuid "762431aa-c3f3-5af0-a3df-59f4956ff122" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "S=N(P-A)" :db/id #edb/ref 17592186505345} {:answer/id #uuid "8cc2c16f-5187-567c-80eb-77c0c76039c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "S=\\frac{A-P}{N}" :db/id #edb/ref 17592186505379} {:answer/id #uuid "94fee1c4-86d3-53c9-9623-7a0244807af1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "S=\\frac{P-A}{N}" :db/id #edb/ref 17592186505392}] :answer-field/correct {:db/id #edb/ref 17592186505392} :answer-field/id #uuid "170a3946-01f0-5d6d-bd80-98d776b43bb3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186505620}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5dad91f1-4207-55b4-9100-a67ecfbe26da" :question/math-academy-id "q-58390" :question/problem "The formula for the total number of people in a school is\n\n$$\n\\begin{aligned}P=NS+A\\end{aligned}\n$$\n\nwhere $N$ is the number of classrooms, $S$ is the average number of students per class, and $A$ is the number of school administrators.\n\nFind an expression for $S$ in terms of the other quantities." :question/worked-solution "We need to isolate $S,$ so we will treat the other variables $P,$ $N,$ and $A$ as constants. We can use the addition and multiplication principles to solve for $S.$\n\nFirst, we subtract $A$ from both sides of the equation:\n\n$$\n\\begin{aligned}P & =NS+A \\\\ P-A & =NS+A-A \\\\ P-A & =NS\\end{aligned}\n$$\n\nThen, we divide by $N$ to get $S$ alone:\n\n$$\n\\begin{aligned}P-A & =NS \\\\ \\frac{P-A}{N} & =\\frac{NS}{N} \\\\ \\frac{P-A}{N} & =S\\end{aligned}\n$$\n\nThus, $S=\\frac{P-A}{N}.$\n\n**Note:** This result assumes that $N\\ne 0.$"} :step/id #uuid "3bb228bb-dd4a-5d6f-9588-57bc6709f38f" :step/next {:db/id #edb/ref 17592186505894}} {:db/id #edb/ref 17592186505894 :step/content {:db/id #edb/ref 17592186505841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a51d7e-d0b1-5453-b475-2cd413c6954b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "S=3VR" :db/id #edb/ref 17592186505104} {:answer/id #uuid "0e65ec95-246e-5666-897b-d58dd56350c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "S=3V-R" :db/id #edb/ref 17592186505130} {:answer/id #uuid "137d5484-9010-5f94-99ed-72015866a46b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "S=V-3R" :db/id #edb/ref 17592186505139} {:answer/id #uuid "267f5f7a-7688-5c2e-be56-83d72f0c321f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "S=\\frac{3V}{R}" :db/id #edb/ref 17592186505172} {:answer/id #uuid "7476b59e-dd65-5cbc-ac38-f9047bb2171d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "S=\\frac{VR}{3}" :db/id #edb/ref 17592186505339}] :answer-field/correct {:db/id #edb/ref 17592186505172} :answer-field/id #uuid "d8a85f31-1f36-5d3a-89fa-6bec10d29927" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186505713}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fa1ff475-5c3a-53b9-87ff-1753b8c81cba" :question/math-academy-id "q-59669" :question/problem "The volume $V$ of a sphere can be written in terms of its radius $R$ and its surface $S$ as\n\n$$\nV=\\frac{SR}{3}.\n$$\n\nWhat is the formula for the surface of the sphere in terms of its volume and radius?" :question/worked-solution "We need to isolate $S,$ so we will treat the other variables $V$ and $R$ as constants. We can use the multiplication principle to solve for $S.$\n\nFirst, we multiply both sides by $3:$\n\n$$\n\\begin{aligned}V & =\\frac{SR}{3} \\\\ 3V & =\\frac{3SR}{3} \\\\ 3V & =SR\\end{aligned}\n$$\n\nNow, we divide both sides by $R:$\n\n$$\n\\begin{aligned}3V & =SR \\\\ \\frac{3V}{R} & =\\frac{SR}{R} \\\\ \\frac{3V}{R} & =S\\end{aligned}\n$$\n\nThus, $S=\\frac{3V}{R}.$\n\n**Note:** This result assumes that $R\\ne 0.$"} :step/id #uuid "dbe8ab04-6544-5207-baf9-2343a5f029dd" :step/next {:db/id #edb/ref 17592186505855}}] :activity/title "Solving Many-Variable Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505100}]}
