45417] [17592186505713 #edb/ref 1075 #edb/ref 17592186505139 #edb/ref 17592186045417] [17592186505713 #edb/ref 1075 #edb/ref 17592186505172 #edb/ref 17592186045417] [17592186505713 #edb/ref 1075 #edb/ref 17592186505339 #edb/ref 17592186045417] [17592186505713 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186505713 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186505713 #edb/ref 1078 #edb/ref 17592186505172 #edb/ref 17592186045417] [17592186505713 #edb/ref 1079 #uuid "d8a85f31-1f36-5d3a-89fa-6bec10d29927" #edb/ref 17592186045417] [17592186505773 #edb/ref 1068 #edb/ref 17592186505620 #edb/ref 17592186045417] [17592186505773 #edb/ref 1069 "q-58390" #edb/ref 17592186045417] [17592186505773 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186505773 #edb/ref 1071 "The formula for the total number of people in a school is\n\n$$\n\\begin{aligned}P=NS+A\\end{aligned}\n$$\n\nwhere $N$ is the number of classrooms, $S$ is the average number of students per class, and $A$ is the number of school administrators.\n\nFind an expression for $S$ in terms of the other quantities." #edb/ref 17592186045417] [17592186505773 #edb/ref 1072 #uuid "5dad91f1-4207-55b4-9100-a67ecfbe26da" #edb/ref 17592186045417] [17592186505773 #edb/ref 1074 "We need to isolate $S,$ so we will treat the other variables $P,$ $N,$ and $A$ as constants. We can use the addition and multiplication principles to solve for $S.$\n\nFirst, we subtract $A$ from both sides of the equation:\n\n$$\n\\begin{aligned}P & =NS+A \\\\ P-A & =NS+A-A \\\\ P-A & =NS\\end{aligned}\n$$\n\nThen, we divide by $N$ to get $S$ alone:\n\n$$\n\\begin{aligned}P-A & =NS \\\\ \\frac{P-A}{N} & =\\frac{NS}{N} \\\\ \\frac{P-A}{N} & =S\\end{aligned}\n$$\n\nThus, $S=\\frac{P-A}{N}.$\n\n**Note:** This result assumes that $N\\ne 0.$" #edb/ref 17592186045417] [17592186505799 #edb/ref 1068 #edb/ref 17592186505617 #edb/ref 17592186045417] [17592186505799 #edb/ref 1069 "q-101844" #edb/ref 17592186045417] [17592186505799 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186505799 #edb/ref 1071 "Solve for $u$ where $\\frac{ut}{3}-t=2q.$" #edb/ref 17592186045417] [17592186505799 #edb/ref 1072 #uuid "ad562e0e-d9eb-505d-ab03-28a6d5a05d76" #edb/ref 17592186045417] [17592186505799 #edb/ref 1074 "We need to isolate $u,$ so we will treat the other variables $t$ and $q$ as constants. We can use the addition and multiplication principles to solve for $u.$\n\nFirst, we add $t$ from both sides of the equation:\n\n$$\n\\begin{aligned}\\frac{ut}{3}-t & =2q \\\\ \\frac{ut}{3}-t+t & =2q+t \\\\ \\frac{ut}{3} & =2q+t\\end{aligned}\n$$\n\nThen, we multiply by $3$ to get rid of the fraction:\n\n$$\n\\begin{aligned}\\frac{ut}{3} & =2q+t \\\\ 3\\cdot \\frac{ut}{3} & =3\\cdot (2q+t) \\\\ ut & =3(2q+t)\\end{aligned}\n$$\n\nFinally, we divide by $t$ to get $u$ alone:\n\n$$\n\\begin{aligned}ut & =3(2q+t) \\\\ \\frac{ut}{t} & =\\frac{3(2q+t)}{t} \\\\ u & =\\frac{3(2q+t)}{t}\\end{aligned}\n$$\n\n**Note:** This result assumes that $t\\ne 0.$" #edb/ref 17592186045417] [17592186505841 #edb/ref 1068 #edb/ref 17592186505713 #edb/ref 17592186045417] [17592186505841 #edb/ref 1069 "q-59669" #edb/ref 17592186045417] [17592186505841 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186505841 #edb/ref 1071 "The volume $V$ of a sphere can be written in terms of its radius $R$ and its surface $S$ as\n\n$$\nV=\\frac{SR}{3}.\n$$\n\nWhat is the formula for the surface of the sphere in terms of its volume and radius?" #edb/ref 17592186045417] [17592186505841 #edb/ref 1072 #uuid "fa1ff475-5c3a-53b9-87ff-1753b8c81cba" #edb/ref 17592186045417] [17592186505841 #edb/ref 1074 "We need to isolate $S,$ so we will treat the other variables $V$ and $R$ as constants. We can use the multiplication principle to solve for $S.$\n\nFirst, we multiply both sides by $3:$\n\n$$\n\\begin{aligned}V & =\\frac{SR}{3} \\\\ 3V & =\\frac{3SR}{3} \\\\ 3V & =SR\\end{aligned}\n$$\n\nNow, we divide both sides by $R:$\n\n$$\n\\begin{aligned}3V & =SR \\\\ \\frac{3V}{R} & =\\frac{SR}{R} \\\\ \\frac{3V}{R} & =S\\end{aligned}\n$$\n\nThus, $S=\\frac{3V}{R}.$\n\n**Note:** This result assumes that $R\\ne 0.$" #edb/ref 17592186045417] [17592186505855 #edb/ref 1062 #uuid "1f219f56-c36c-5367-afab-e9542307a462" #edb/ref 17592186045417] [17592186505855 #edb/ref 1063 #edb/ref 17592186505799 #edb/ref 17592186045417] [17592186505861 #edb/ref 1058 #edb/ref 17592186505894 #edb/ref 17592186045417] [17592186505861 #edb/ref 1062 #uuid "3bb228bb-dd4a-5d6f-9588-57bc6709f38f" #edb/ref 17592186045417] [17592186505861 #edb/ref 1063 #edb/ref 17592186505773 #edb/ref 17592186045417] [17592186505894 #edb/ref 1058 #edb/ref 17592186505855 #edb/ref 17592186045417] [17592186505894 #edb/ref 1062 #uuid "dbe8ab04-6544-5207-baf9-2343a5f029dd" #edb/ref 17592186045417] [17592186505894 #edb/ref 1063 #edb/ref 17592186505841 #edb/ref 17592186045417]}
