n></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo stretchy=\"false\">(</mo><mn>1</mn><mo>+</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow><mrow><mn>1</mn><mo stretchy=\"false\">(</mo><mn>1</mn><mo>+</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo>+</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo stretchy=\"false\">(</mo><mn>1</mn><mo>+</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow><mrow><mn>1</mn><mo>+</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></mrow></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Finally, we simplify using the Pythagorean identity, as follows:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"80\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 22.627em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-mstyle><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mrow><mjx-msup><mjx-m