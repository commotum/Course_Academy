on/validate]} {:db/id "answer-field-7594dca0-750e-5385-aeed-2b580bc45bc5" :answer-field/id #uuid "7594dca0-750e-5385-aeed-2b580bc45bc5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e5f265d6-01f5-58fd-aef8-6ccbb90eac60" :answer-field/choices ["answer-e5f265d6-01f5-58fd-aef8-6ccbb90eac60"] :db/ensure [:answer-field/validate]} {:db/id "answer-e5f265d6-01f5-58fd-aef8-6ccbb90eac60" :answer/id #uuid "e5f265d6-01f5-58fd-aef8-6ccbb90eac60" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id "question-b63c78ef-ce78-5787-b3da-65a5a527693b" :question/id #uuid "b63c78ef-ce78-5787-b3da-65a5a527693b" :question/math-academy-id "q-186053" :question/problem "$124%$ of $200$ is equal to{{field-1}}." :question/worked-solution "To solve this problem, we can use the following formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is $200,$ and the percentage is $124%.$ \n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n124%=124÷100=1.24\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =124%\\times 200 \\\\  & =1.24\\times 200 \\\\  & =248\\end{aligned}\n$$\n\nTherefore, $124%$ of $200$ is $248.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n124%=\\frac{124}{100}=\\frac{124÷4}{100÷4}=\\frac{31}{25}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =124%\\times 200 \\\\  & =\\frac{31}{25}\\times 200 \\\\  & =31\\times \\frac{200}{25} \\\\  & =31\\times 8 \\\\  & =248\\end{aligned}\n$$\n\nTherefore, $124%$ of $200$ is $248.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-97375675-8012-5fdd-8547-0626fe42d85b"] :db/ensure [:question/validate]} {:db/id "answer-field-97375675-8012-5fdd-8547-0626fe42d85b" :answer-field/id #uuid "97375675-8012-5fdd-8547-0626fe42d85b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6c306237-c3de-526b-9961-c59eb34ac48d" :answer-field/choices ["answer-6c306237-c3de-526b-9961-c59eb34ac48d"] :db/ensure [:answer-field/validate]} {:db/id "answer-6c306237-c3de-526b-9961-c59eb34ac48d" :answer/id #uuid "6c306237-c3de-526b-9961-c59eb34ac48d" :answer/type :answer.type/math :answer/value "248" :db/ensure [:answer/validate]} {:db/id "question-28285ccd-1dac-57e7-a3e5-0e93bbb0a6e3" :question/id #uuid "28285ccd-1dac-57e7-a3e5-0e93bbb0a6e3" :question/math-academy-id "q-186026" :question/problem "$225%$ of $32$ is equal to{{field-1}}." :question/worked-solution "To solve this problem, we can use the following formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is $32,$ and the percentage is $225%.$ \n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n225%=225÷100=2.25\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =225%\\times 32 \\\\  & =2.25\\times 32 \\\\  & =72\\end{aligned}\n$$\n\nTherefore, $225%$ of $32$ is $72.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n225%=\\frac{225}{100}=\\frac{225÷25}{100÷25}=\\frac{9}{4}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =225%\\times 32 \\\\  & =\\frac{9}{4}\\times 32 \\\\  & =9\\times \\frac{32}{4} \\\\  & =9\\times 8 \\\\  & =72\\end{aligned}\n$$\n\nTherefore, $225%$ of $32$ is $72.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-197e399a-9f23-54c7-8fee-76aab7df8160"] :db/ensure [:question/validate]} {:db/id "answer-field-197e399a-9f23-54c7-8fee-76aab7df8160" :answer-field/id #uuid "197e399a-9f23-54c7-8fee-76aab7df8160" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-353c536e-911b-5a8c-9ad9-b43c4d0b61d1" :answer-field/choices ["answer-353c536e-911b-5a8c-9ad9-b43c4d0b61d1"] :db/ensure [:answer-field/validate]} {:db/id "answer-353c536e-911b-5a8c-9ad9-b43c4d0b61d1" :answer/id #uuid "353c536e-911b-5a8c-9ad9-b43c4d0b61d1" :answer/type :answer.type/math :answer/value "72" :db/ensure [:answer/validate]} {:db/id "question-e7f35be5-687e-57cd-bcc5-6295920b0ded" :question/id #uuid "e7f35be5-687e-57cd-bcc5-6295920b0ded" :question/math-academy-id "q-160842" :question/problem "What is $115%$ of $80?$" :question/worked-solution "To solve this problem, we can use the following formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is $80,$ and the percentage is $115%.$ \n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n115%=115÷100=1.15\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =115%\\times 80 \\\\  & =1.15\\times 80 \\\\  & =92\\end{aligned}\n$$\n\nTherefore, $115%$ of $80$ is $92.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n115%=\\frac{115}{100}=\\frac{115÷5}{100÷5}=\\frac{23}{20}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =115%\\times 80 \\\\  & =\\frac{23}{20}\\times 80 \\\\  & =23\\times \\frac{80}{20} \\\\  & =23\\times 4 \\\\  & =92\\end{aligned}\n$$\n\nTherefore, $115%$ of $80$ is $92.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-428eb806-1017-5c82-866c-5cb029c7791a"] :db/ensure [:question/validate]} {:db/id "answer-field-428eb806-1017-5c82-866c-5cb029c7791a" :answer-field/id #uuid "428eb806-1017-5c82-866c-5cb029c7791a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ff4488c6-c8c6-5d04-9e6a-88bca4dc6f00" :answer-field/choices ["answer-6a