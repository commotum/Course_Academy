100}\n$$\n\nThen, we apply our formula as follows:\n\n$$\n\\begin{aligned}\npart &= percentage \\cdot whole \\\\\n&= 4% \\cdot 35 \\\\\n&= \\frac{4}{100} \\cdot 35 \\\\\n&= \\frac{140}{100} \\\\\n&= 1.4\n\\end{aligned}\n$$\n\nTherefore, $4 \\%$ of $35$ is $1.4$." 13194139534865 17592186045417 false] [17592186147163 1071 "What is $140 \\%$ of $30$?" 13194139534865 17592186045417 false] [17592186147163 1071 "What is $140 \\%$ of $30?$" 13194139534865 17592186045417 true] [17592186147163 1074 "To solve this problem, we can use the following formula:\n\n$$\n\\textrm{part}=  \\textrm{percentage}\\times \\textrm{whole}\n$$\n\nIn our case, the whole is $30$, and the percentage is $140\\%.$ \n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n140 \\% = 140 \\div 100 = 1.4\n$$\n\nThen, we apply our formula as follows:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =140%\\times 30 \\\\  & =1.4\\times 30 \\\\  & =42\\end{aligned}\n$$\n\nTherefore, $140 \\%$ of $30$ is $42.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n140 \\% = \\dfrac{140}{100} = \\dfrac{140 \\div 20}{100\\div 20} = \\dfrac{7}{5}\n$$\n\nThen, we apply our formula as follows:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =140%\\times 30 \\\\  & =\\frac{7}{5}\\times 30 \\\\  & =7\\times \\frac{30}{5} \\\\  & =7\\times 6 \\\\  & =42\\end{aligned}\n$$\n\nTherefore, $140 \\%$ of $30$ is $42.$" 13194139534865 17592186045417 true] [17592186147163 1074 "To solve this problem, we can use the following formula:\n\n$$\n\\textrm{part}= \\textrm{percentage}\\times \\textrm{whole}\n$$\n\nIn our case, the whole is $30$, and the percentage is $140\\%$.\n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n140 \\% = 140 \\div 100 = 1.4\n$$\n\nThen, we apply our formula as follows:\n\n$$\n\\begin{aligned}\npart &= percentage \\cdot whole \\\\\n&= 140% \\cdot 30 \\\\\n&= 1.4 \\cdot 30 \\\\\n&= 42\n\\end{aligned}\n$$\n\nTherefore, $140 \\%$ of $30$ is $42$.\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n140 \\% = \\dfrac{140}{100} = \\dfrac{140 \\div 20}{100\\div 20} = \\dfrac{7}{5}\n$$\n\nThen, we apply our formula as follows:\n\n$$\n\\begin{aligned}\npart &= percentage \\cdot whole \\\\\n&= 140% \\cdot 30 \\\\\n&= \\frac{7}{5} \\cdot 30 \\\\\n&= 7 \\cdot \\frac{30}{5} \\\\\n&= 7 \\cdot 6 \\\\\n&= 42\n\\end{aligned}\n$$\n\nTherefore, $140 \\%$ of $30$ is $42$." 13194139534865 17592186045417 false] [17592186147164 1071 "What is $3.6 \\%$ of $25$?" 13194139534865 17592186045417 false] [17592186147164 1071 "What is $3.6 \\%$ of $25?$" 13194139534865 17592186045417 true] [17592186147164 1074 "To solve this problem, we can use the following formula:\n\n$$\n\\textrm{part}=  \\textrm{percentage}\\times \\textrm{whole}\n$$\n\nIn our case, the whole is $25$, and the percentage is $3.6 \\%.$ \n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n3.6 \\% = 3.6 \\div 100 = 0.036\n$$\n\nThen, we apply our formula as follows:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =3.6%\\times 25 \\\\  & =0.036\\times 25 \\\\  & =0.9\\end{aligned}\n$$\n\nTherefore, $3.6 \\%$ of $25$ is $0.9.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n3.6 \\% = \\dfrac{3.6}{100} = \\dfrac{3.6 \\times 10}{100 \\times 10} = \\dfrac{36}{1,000}\n$$\n\nThen, we apply our formula as follows:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =3.6%\\times 25 \\\\  & =\\frac{36}{1,000}\\times 25 \\\\  & =\\frac{900}{1,000} \\\\  & =0.9\\end{aligned}\n$$\n\nTherefore, $3.6 \\%$ of $25$ is $0.9.$" 13194139534865 17592186045417 true] [17592186147164 1074 "To solve this problem, we can use the following formula:\n\n$$\n\\textrm{part}= \\textrm{percentage}\\times \\textrm{whole}\n$$\n\nIn our case, the whole is $25$, and the percentage is $3.6 \\%$.\n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n3.6 \\% = 3.6 \\div 100 = 0.036\n$$\n\nThen, we apply our formula as follows:\n\n$$\n\\begin{aligned}\npart &= percentage \\cdot whole \\\\\n&= 3.6% \\cdot 25 \\\\\n&= 0.036 \\cdot 25 \\\\\n&= 0.9\n\\end{aligned}\n$$\n\nTherefore, $3.6 \\%$ of $25$ is $0.9$.\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n3.6 \\% = \\dfrac{3.6}{100} = \\dfrac{3.6 \\times 10}{100 \\times 10} = \\dfrac{36}{1,000}\n$$\n\nThen, we apply our formula as follows:\n\n$$\n\\begin{aligned}\npart &= percentage \\cdot whole \\\\\n&= 3.6% \\cdot 25 \\\\\n&= \\frac{36}{1, 000} \\cdot 25 \\\\\n&= \\frac{900}{1, 000} \\\\\n&= 0.9\n\\end{aligned}\n$$\n\nTherefore, $3.6 \\%$ of $25$ is $0.9$." 13194139534865 17592186045417 false] [17592186147482 1038 #edb/ref 17592186441672 13194139534865 17592186045417 true] [17592186147482 1038 #edb/ref 17592186441676 13194139534865 17592186045417 true] [17592186147482 1038 #edb/ref 17592186441677 13194139534865 17592186045417 true] [17592186147482 1038 #edb/ref 17592186441681 13194139534865 17592186045417 true] [17592186147482 1038 #edb/ref 17592186441685 13194139534865 17592186045417 true] [17592186147483 1038 #edb/ref 17592186441673 13194139534865 17592186045417 true] [17592186147483 1038 #edb/ref 17592186441678 13194139534865 17592186045417 true] [17592186147483 1038 #edb/ref 17592186441682 13194139534865 17592186045417 true] [17592186147483 1038 #edb/ref 17592186441684 13194139534865 17592186045417 true] [17592186147484 1038 #edb/ref 17592186441674 13194139534865 17592186045417 true] [17592186147484 1038 #edb/ref 17592186441675 13194139534865 17592186045417 true] [17592186147484 1038 #edb/ref 17592186441679 13194139534865 17592186045417 true] [17592186147484 1038 #edb/ref 17592186441680 13194139534865 17592186045417 true] [17592186147484 1038 #edb/ref 17592186441683 13194139534865 17592186045417 true] [17592186147654 1050 420.0 13194139534865 17592186045417 true] [17592186147890 1070 #edb/ref 17592186045485 13194139534865 17592186045417 true] [17592186147890 1071 "What is $120%$ of $25$?" 13194139534865 17592186045417 false] [17592186147890 1071 "What is $120%$ of $25?$" 13194139534865 17592186045417 true] [17592186147890 1074 "To solve this problem, we can use the following formula:\n\n$$\n\\text{part}=\\text{percentage}\\times \\text{whole}\n$$\n\nIn our case, the whole is $25,$ and the percentage is $120%.$ \n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n120%=120÷100=1.2\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =120%\\times 25 \\\\  & =1.2\\times 25 \\\\  & =30\\end{aligned}\n$$\n\nTherefore, $120%$ of $25$ is $30.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n120%=\\frac{120}{100}=\\frac{120÷20}{100÷20}=\\frac{6}{5}\n$$\n\nApplying our formula, we have:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =120%\\times 25 \\\\  & =\\frac{6}{5}\\times 25 \\\\  & =6\\times \\frac{25}{5} \\\\  & =6\\times 5 \\\\  & =30\\end{aligned}\n$$\n\nTherefore, $120%$ of $25$ is $30.$" 13194139534865 17592186045417 true] [17592186148789 1064 "We can find a percentage part of a number using the following formula:\n\n$$\n\\textrm{part} = \\textrm{percentage} \\times \\textrm{whole}\n$$\n\nTo illustrate, let's calculate $16 \\%$ of $300$.\n\nHere, the whole is $300$ and the percentage is $16 \\%$. So, the part is given by\n\n$$\n\\textrm{part} = 16\\% \\times 300\n$$\n\nBut how do we multiply a percentage by a number? We have two methods of doing this. Let's apply both and check that they give the same answer.\n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n16\\% = 16 \\div 100 = 0.16\n$$\n\nThen, we apply our formula as follows:\n\n$$\n\\begin{aligned}\npart &= percentage \\cdot whole \\\\\n&= 16% \\cdot 300 \\\\\n&= 0.16 \\cdot 300 \\\\\n&= 48\n\\end{aligned}\n$$\n\nTherefore, $16\\%$ of $300$ is $48$.\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n16\\% = \\dfrac{16}{100}\n$$\n\nThen, we apply our formula as follows:\n\n$$\n\\begin{aligned}\npart &= percentage \\cdot whole \\\\\n&= 16% \\cdot 300 \\\\\n&= \\frac{16}{100} \\cdot 300 \\\\\n&= 16 \\cdot \\frac{300}{100} \\\\\n&= 16 \\cdot 3 \\\\\n&= 48\n\\end{aligned}\n$$\n\nTherefore, $16 \\%$ of $300$ is $48$." 13194139534865 17592186045417 false] [17592186148789 1064 "We can find a percentage part of a number using the following formula:\n\n$$\n\\textrm{part} = \\textrm{percentage} \\times \\textrm{whole}\n$$\n\nTo illustrate, let's calculate $16 \\%$ of $300.$\n\nHere, the whole is $300$ and the percentage is $16 \\% .$ So, the part is given by\n\n$$\n\\textrm{part} = 16\\% \\times 300.\n$$\n\nBut how do we multiply a percentage by a number? We have two methods of doing this. Let's apply both and check that they give the same answer.\n\n**Method 1**\n\nFirst, we convert the percentage to a decimal:\n\n$$\n16\\% = 16 \\div 100 = 0.16\n$$\n\nThen, we apply our formula as follows:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =16%\\times 300 \\\\  & =0.16\\times 300 \\\\  & =48\\end{aligned}\n$$\n\nTherefore, $16\\%$ of $300$ is $48.$\n\n**Method 2**\n\nFirst, we convert the percentage to a fraction:\n\n$$\n16\\% = \\dfrac{16}{100}\n$$\n\nThen, we apply our formula as follows:\n\n$$\n\\begin{aligned}\\text{part} & =\\text{percentage}\\times \\text{whole} \\\\  & =16%\\times 300 \\\\  & =\\frac{16}{100}\\times 300 \\\\  & =16\\times \\frac{300}{100} \\\\  & =16\\times 3 \\\\  & =48\\end{aligned}\n$$\n\nTherefore, $16 \\%$ of $300$ is $48.$" 13194139534865 17592186045417 true] [17592186441624 1080 "100" 13194139534865 17592186045417 true] [17592186441624 1082 #edb/ref 17592186045498 13194139534865 17592186045417 true] [17592186441624 1083 #uuid "11421dbe-1fb6-5598-a5a3-7680bd0658a8