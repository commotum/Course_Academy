#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186120924} :activity/id #uuid "a57ecb02-a517-575e-937a-29d06cde95ac" :activity/scope {:db/id #edb/ref 17592186048829 :topic/id #uuid "c4140dd8-d457-5cdb-8b51-1b7b952642cd" :topic/math-academy-id 1818} :activity/steps [{:db/id #edb/ref 17592186120924 :step/content {:db/id #edb/ref 17592186120994 :tutorial/content "The common ratio ![](images/3a/3a4ef1c1b261a53f9c45d0c90f2d44b155125fe1e7b1359406830111b4846f2f.svg) of a geometric sequence is found by dividing any term by the term immediately before it:\n![](images/64/641727086c22a06619c11617fae703a715530b8436e05ea22ad57cfffdbf9e8f.svg)\n\nTherefore, the **recursive formula for a geometric sequence** with common ratio ![](images/3a/3a4ef1c1b261a53f9c45d0c90f2d44b155125fe1e7b1359406830111b4846f2f.svg) takes the form\n![](images/c6/c68961a8641390e8d86b86ec557512300a53f424912bed25e9939126e5d71c07.svg)\n\nThe above formula states that to get to the next term in the sequence, we multiply the previous term by ![](images/b2/b2e0c6bf822f391aab6c59cc540176f139c5c69f5a6f54ae9c81d451defe9c9f.svg)\n\nTo illustrate, consider the geometric sequence below:\n\n![](images/7c/7ceb288dea6b0c885bae7014d7170c923afb2d38b8ba6cb338cd63c32e6af5c0.svg)\n\nThe first term is ![](images/82/82447c5e47fb052201522cca2359b821307def74212b7ce26debbfd8875f4dc2.svg) and we can calculate the common ratio ![](images/3a/3a4ef1c1b261a53f9c45d0c90f2d44b155125fe1e7b1359406830111b4846f2f.svg) as\n\n![](images/d2/d2c615fcab22a64d8f610b7ff36d28190b787c456e9e4099d8f5be2522dafd9c.svg)\n\nTherefore, the recursive formula is\n\n![](images/9d/9d7aaea9acc235b192240da83d3e53d9d62ee6e67e128df01dba6bd0d1ced4ad.svg)\n\nWhen writing out our final answer for the recursive formula, we should also state the first term and the range for ![](images/c2/c2475d72e6ec36042292de6c0160930174172b2386148d823a70e59fddfb93c2.svg)\n\nTo check that the recursive formula is correct, we can use it to generate the next few terms of the series:\n\n![](images/b3/b397de9b364d11653d651b7fa2d6ddf422ede5fca1692596f527e3e293bafb27.svg)" :tutorial/id #uuid "ba1c40d0-f4d8-562e-9c41-9e0da7ea24a4" :tutorial/math-academy-id 1668 :tutorial/title "Introduction"} :step/id #uuid "499a7374-b1ea-510b-ad4d-6da274c17403" :step/math-academy-id 455131 :step/next {:db/id #edb/ref 17592186120925}} {:db/id #edb/ref 17592186120925 :step/content {:db/id #edb/ref 17592186119950 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119536 :question/id #uuid "0a5038b8-1c2e-591c-9190-9493014fd98a" :question/math-academy-id "e-1506"} :knowledge-point/id #uuid "ce50e834-b8c1-56da-8750-241601cd1046" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050380} {:db/id #edb/ref 17592186050977}] :knowledge-point/questions [{:db/id #edb/ref 17592186120169} {:db/id #edb/ref 17592186120170} {:db/id #edb/ref 17592186120469} {:db/id #edb/ref 17592186545806} {:db/id #edb/ref 17592186545818} {:db/id #edb/ref 17592186545822} {:db/id #edb/ref 17592186545829} {:db/id #edb/ref 17592186545846}] :knowledge-point/title "Constructing a Recursive Formula for a Geometric Sequence"} :step/id #uuid "9383b3af-074e-5945-a23a-a22fecf5c293" :step/math-academy-id 455132 :step/next {:db/id #edb/ref 17592186120926}} {:db/id #edb/ref 17592186120926 :step/content {:db/id #edb/ref 17592186119951 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119537 :question/id #uuid "25a92b77-314f-5e6a-8a26-5e631d10e4d0" :question/math-academy-id "e-1507"} :knowledge-point/id #uuid "6aee1b1d-3cb6-5f52-8973-13b067b1c41a" :knowledge-point/questions [{:db/id #edb/ref 17592186120165} {:db/id #edb/ref 17592186120171} {:db/id #edb/ref 17592186120470}] :knowledge-point/title "Calculating a Term of a Geometric Sequence Given Its Recursive Formula"} :step/id #uuid "35c45656-808c-5546-9a32-7e6bd7fd0bd1" :step/math-academy-id 455136 :step/next {:db/id #edb/ref 17592186120927}} {:db/id #edb/ref 17592186120927 :step/content {:db/id #edb/ref 175