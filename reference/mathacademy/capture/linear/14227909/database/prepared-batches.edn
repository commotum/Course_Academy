4)=16 \\\\ {a}_{4} & =\\frac{1}{4}{a}_{3}=\\frac{1}{4}(16)=4\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=4.$"] [17592186120171 :question/difficulty :question.difficulty/moderate] ["answer-027fccaa-c5ae-5f11-8896-43a5a65af33e" :answer/id #uuid "027fccaa-c5ae-5f11-8896-43a5a65af33e"] ["answer-027fccaa-c5ae-5f11-8896-43a5a65af33e" :answer/type :answer.type/math] ["answer-027fccaa-c5ae-5f11-8896-43a5a65af33e" :answer/value "4"] [17592186117192 :answer-field/correct "answer-027fccaa-c5ae-5f11-8896-43a5a65af33e"] [17592186117192 :answer-field/choices "answer-027fccaa-c5ae-5f11-8896-43a5a65af33e"] ["question-aefdd63c-9ca1-53a8-bde4-4b90e11b234c" :question/id #uuid "aefdd63c-9ca1-53a8-bde4-4b90e11b234c"] ["question-aefdd63c-9ca1-53a8-bde4-4b90e11b234c" :question/math-academy-id "q-44911"] ["question-aefdd63c-9ca1-53a8-bde4-4b90e11b234c" :question/problem "What is the $3$rd term of the geometric sequence given below?\n\n$$\n{a}_{n+1}=-5{a}_{n},\\,{a}_{1}=\\frac{1}{75},\\,n\\ge 1\n$$"] ["question-aefdd63c-9ca1-53a8-bde4-4b90e11b234c" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $3$rd term:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{1}{75} \\\\ {a}_{2} & =-5{a}_{1}=-5(\\frac{1}{75})=-\\frac{1}{15} \\\\ {a}_{3} & =-5{a}_{2}=-5(-\\frac{1}{15})=\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, ${a}_{3}=\\frac{1}{3}.$"] ["question-aefdd63c-9ca1-53a8-bde4-4b90e11b234c" :question/difficulty :question.difficulty/easy] ["answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4" :answer-field/id #uuid "176b8b77-5248-5ad2-a9d6-5fb267c606a4"] ["answer-e5043de9-8a57-5304-b0ba-e8e53419e90b" :answer/id #uuid "e5043de9-8a57-5304-b0ba-e8e53419e90b"] ["answer-e5043de9-8a57-5304-b0ba-e8e53419e90b" :answer/type :answer.type/math] ["answer-e5043de9-8a57-5304-b0ba-e8e53419e90b" :answer/value "-\\frac{1}{15}"] ["answer-b229ccac-19bf-5635-b760-624ad2c11e2c" :answer/id #uuid "b229ccac-19bf-5635-b760-624ad2c11e2c"] ["answer-b229ccac-19bf-5635-b760-624ad2c11e2c" :answer/type :answer.type/math] ["answer-b229ccac-19bf-5635-b760-624ad2c11e2c" :answer/value "-\\frac{1}{3}"] ["answer-53dc9885-bcbf-5231-b7b6-371ca0f2ff5f" :answer/id #uuid "53dc9885-bcbf-5231-b7b6-371ca0f2ff5f"] ["answer-53dc9885-bcbf-5231-b7b6-371ca0f2ff5f" :answer/type :answer.type/math] ["answer-53dc9885-bcbf-5231-b7b6-371ca0f2ff5f" :answer/value "\\frac{1}{15}"] ["answer-a173cd67-30bb-555b-b5f9-349f5d3f36c4" :answer/id #uuid "a173cd67-30bb-555b-b5f9-349f5d3f36c4"] ["answer-a173cd67-30bb-555b-b5f9-349f5d3f36c4" :answer/type :answer.type/math] ["answer-a173cd67-30bb-555b-b5f9-349f5d3f36c4" :answer/value "\\frac{1}{3}"] ["answer-fa44994d-5a93-5dd0-b5c3-4cf7e14c5acf" :answer/id #uuid "fa44994d-5a93-5dd0-b5c3-4cf7e14c5acf"] ["answer-fa44994d-5a93-5dd0-b5c3-4cf7e14c5acf" :answer/type :answer.type/math] ["answer-fa44994d-5a93-5dd0-b5c3-4cf7e14c5acf" :answer/value "\\frac{25}{3}"] ["answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4" :answer-field/key "selection"] ["answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4" :answer-field/type :answer-field.type/radio] ["answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4" :answer-field/correct "answer-a173cd67-30bb-555b-b5f9-349f5d3f36c4"] ["answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4" :answer-field/choices "answer-e5043de9-8a57-5304-b0ba-e8e53419e90b"] ["answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4" :answer-field/choices "answer-b229ccac-19bf-5635-b760-624ad2c11e2c"] ["answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4" :answer-field/choices "answer-53dc9885-bcbf-5231-b7b6-371ca0f2ff5f"] ["answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4" :answer-field/choices "answer-a173cd67-30bb-555b-b5f9-349f5d3f36c4"] ["answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4" :answer-field/choices "answer-fa44994d-5a93-5dd0-b5c3-4cf7e14c5acf"] ["question-aefdd63c-9ca1-53a8-bde4-4b90e11b234c" :question/answer-fields "answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4"] [17592186119951 :knowledge-point/questions "question-aefdd63c-9ca1-53a8-bde4-4b90e11b234c"] ["question-03727fdc-9b2a-53db-b355-f55f8718eb73" :question/id #uuid "03727fdc-9b2a-53db-b355-f55f8718eb73"] ["question-03727fdc-9b2a-53db-b355-f55f8718eb73" :question/math-academy-id "q-249803"] ["question-03727fdc-9b2a-53db-b355-f55f8718eb73" :question/problem "Consider the following geometric sequence:\n\n$$\n{a}_{n+1}=\\frac{2}{3}{a}_{n},\\,{a}_{1}=27,\\,n\\ge 1\n$$\n\nThe $3$rd term of this geometric sequence is ${a}_{3}=$\n{{field-1}}."] ["question-03727fdc-9b2a-53db-b355-f55f8718eb73" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $3$rd term:\n\n$$\n\\begin{aligned}{a}_{1} & =27 \\\\ {a}_{2} & =\\frac{2}{3}{a}_{1}=\\frac{2}{3}(27)=18 \\\\ {a}_{3} & =\\frac{2}{3}{a}_{2}=\\frac{2}{3}(18)=12\\end{aligned}\n$$\n\nTherefore, ${a}_{3}=12.$"] ["question-03727fdc-9b2a-53db-b355-f55f8718eb73" :question/difficulty :question.difficulty/easy] ["answer-field-c6223f65-65ec-56a2-89b6-bc66582ce68b" :answer-field/id #uuid "c6223f65-65ec-56a2-89b6-bc66582ce68b"] ["answer-e349f683-d5d2-533c-bbf7-eb7857abb61f" :answer/id #uuid "e349f683-d5d2-533c-bbf7-eb7857abb61f"] ["answer-e349f683-d5d2-533c-bbf7-eb7857abb61f" :answer/type :answer.type/math] ["answer-e349f683-d5d2-533c-bbf7-eb7857abb61f" :answer/value "12"] ["answer-field-c6223f65-65ec-56a2-89b6-bc66582ce68b" :answer-field/key "field-1"] ["answer-field-c6223f65-65ec-56a2-89b6-bc66582ce68b" :answer-field/type :answer-field.type/blank] ["answer-field-c6223f65-65ec-56a2-89b6-bc66582ce68b" :answer-field/correct "answer-e349f683-d5d2-533c-bbf7-eb7857abb61f"] ["answer-field-c6223f65-65ec-56a2-89b6-bc66582ce68b" :answer-field/choices "answer-e349f683-d5d2-533c-bbf7-eb7857abb61f"] ["question-03727fdc-9b2a-53db-b355-f55f8718eb73" :question/answer-fields "answer-field-c6223f65-65ec-56a2-89b6-bc66582ce68b"] [17592186119951 :knowledge-point/questions "question-03727fdc-9b2a-53db-b355-f55f8718eb73"] ["question-e7787ac5-6aeb-5774-9055-b078c9c07d68" :question/id #uuid "e7787ac5-6aeb-5774-9055-b078c9c07d68"] ["question-e7787ac5-6aeb-5774-9055-b078c9c07d68" :question/math-academy-id "q-101432"] ["question-e7787ac5-6aeb-5774-9055-b078c9c07d68" :question/problem "What is the $4$th term of the geometric sequence given below?\n\n$$\nf(n+1)=-3.5f(n),\\,f(1)=-2,\\,n\\ge 1\n$$"] ["question-e7787ac5-6aeb-5774-9055-b078c9c07d68" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $4$th term:\n\n$$\n\\begin{aligned}f(1) & =-2 \\\\ f(2) & =-3.5f(1)=-3.5(-2)=7 \\\\ f(3) & =-3.5f(2)=-3.5(7)=-24.5 \\\\ f(4) & =-3.5f(3)=-3.5(-24.5)=85.75\\end{aligned}\n$$\n\nTherefore, $f(4)=85.75.$"] ["question-e7787ac5-6aeb-5774-9055-b078c9c07d68" :question/difficulty :question.difficulty/moderate] ["answer-field-f08de971-253f-5c62-b587-1f127bb77b75" :answer-field/id #uuid "f08de971-253f-5c62-b587-1f127bb77b75"] ["answer-c65f894c-ad2b-5fd9-88a7-4d2f848bde7a" :answer/id #uuid "c65f894c-ad2b-5fd9-88a7-4d2f848bde7a"] ["answer-c65f894c-ad2b-5fd9-88a7-4d2f848bde7a" :answer/type :answer.type/math] ["answer-c65f894c-ad2b-5fd9-88a7-4d2f848bde7a" :answer/value "-300.75"] ["answer-ec977cf1-c906-53fd-b5f5-1fb310eb6eda" :answer/id #uuid "ec977cf1-c906-53fd-b5f5-1fb310eb6eda"] ["answer-ec977cf1-c906-53fd-b5f5-1fb310eb6eda" :answer/type :answer.type/math] ["answer-ec977cf1-c906-53fd-b5f5-1fb310eb6eda" :answer/value "-85.75"] ["answer-a3ad70f6-91a3-5b4a-af2e-ce791c283024" :answer/id #uuid "a3ad70f6-91a3-5b4a-af2e-ce791c283024"] ["answer-a3ad70f6-91a3-5b4a-af2e-ce791c283024" :answer/type :answer.type/math] ["answer-a3ad70f6-91a3-5b4a-af2e-ce791c283024" :answer/value "125.5"] ["answer-00bac6ed-4ca1-5d37-a955-d3ac6bd3a6e0" :answer/id #uuid "00bac6ed-4ca1-5d37-a955-d3ac6bd3a6e0"] ["answer-00bac6ed-4ca1-5d37-a955-d3ac6bd3a6e0" :answer/type :answer.type/math] ["answer-00bac6ed-4ca1-5d37-a955-d3ac6bd3a6e0" :answer/value "250.75"] ["answer-24fc281b-515c-5c55-b365-b208cd62d896" :answer/id #uuid "24fc281b-515c-5c55-b365-b208cd62d896"] ["answer-24fc281b-515c-5c55-b365-b208cd62d896" :answer/type :answer.type/math] ["answer-24fc281b-515c-5c55-b365-b208cd62d896" :answer/value "85.75"] ["answer-field-f08de971-253f-5c62-b587-1f127bb77b75" :answer-field/key "selection"] ["answer-field-f08de971-253f-5c62-b587-1f127bb77b75" :answer-field/type :answer-field.type/radio] ["answer-field-f08de971-253f-5c62-b587-1f127bb77b75" :answer-field/correct "answer-24fc281b-515c-5c55-b365-b208cd62d896"] ["answer-field-f08de971-253f-5c62-b587-1f127bb77b75" :answer-field/choices "answer-c65f894c-ad2b-5fd9-88a7-4d2f848bde7a"] ["answer-field-f08de971-253f-5c62-b587-1f127bb77b75" :answer-field/choices "answer-ec977cf1-c906-53fd-b5f5-1fb310eb6eda"] ["answer-field-f08de971-253f-5c62-b587-1f127bb77b75" :answer-field/choices "answer-a3ad70f6-91a3-5b4a-af2e-ce791c283024"] ["answer-field-f08de971-253f-5c62-b587-1f127bb77b75" :answer-field/choices "answer-00bac6ed-4ca1-5d37-a955-d3ac6bd3a6e0"] ["answer-field-f08de971-253f-5c62-b587-1f127bb77b75" :answer-field/choices "answer-24fc281b-515c-5c55-b365-b208cd62d896"] ["question-e7787ac5-6aeb-5774-9055-b078c9c07d68" :question/answer-fields "answer-field-f08de971-253f-5c62-b587-1f127bb77b75"] [17592186119952 :knowledge-point/questions "question-e7787ac5-6aeb-5774-9055-b078c9c07d68"] ["question-e60274a9-ad7a-5782-a789-be03c76f6f3c" :question/id #uuid "e60274a9-ad7a-5782-a789-be03c76f6f3c"] ["question-e60274a9-ad7a-5782-a789-be03c76f6f3c" :question/math-academy-id "q-249892"] ["question-e60274a9-ad7a-5782-a789-be03c76f6f3c" :question/problem "Consider the following geometric sequence:\n\n$$\nf(n+1)=\\frac{2}{7}f(n),\\,f(1)=343,\\,n\\ge 1\n$$\n\nThe $4$th term of this geometric sequence is $f(4)=$\n{{field-1}}."] ["question-e60274a9-ad7a-5782-a789-be03c76f6f3c" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $4$th term:\n\n$$\n\\begin{aligned}f(1) & =343 \\\\ f(2) & =\\frac{2}{7}f(1)=\\frac{2}{7}(343)=98 \\\\ f(3) & =\\frac{2}{7}f(2)=\\frac{2}{7}(98)=28 \\\\ f(4) & =\\frac{2}{7}f(3)=\\frac{2}{7}(28)=8\\end{aligned}\n$$\n\nTherefore, $f(4)=8.$"] ["question-e60274a9-ad7a-5782-a789-be03c76f6f3c" :question/difficulty :question.difficulty/moderate] ["answer-field-b4c7e41f-ae27-5892-83ef-b3b75e7b59b0" :answer-field/id #uuid "b4c7e41f-ae27-5892-83ef-b3b75e7b59b0"] ["answer-83d8320e-7ae3-5aee-85eb-74f11662e0df" :answer/id #uuid "83d8320e-7ae3-5aee-85eb-74f11662e0df"] ["answer-83d8320e-7ae3-5aee-85eb-74f11662e0df" :answer/type :answer.type/math] ["answer-83d8320e-7ae3-5aee-85eb-74f11662e0df" :answer/value "8"] ["answer-field-b4c7e41f-ae27-5892-83ef-b3b75e7b59b0" :answer-field/key "field-1"] ["answer-field-b4c7e41f-ae27-5892-83ef-b3b75e7b59b0" :answer-field/type :answer-field.type/blank] ["answer-field-b4c7e41f-ae27-5892-83ef-b3b75e7b59b0" :answer-field/correct "answer-83d8320e-7ae3-5aee-85eb-74f11662e0df"] ["answer-field-b4c7e41f-ae27-5892-83ef-b3b75e7b59b0" :answer-field/choices "answer-83d8320e-7ae3-5aee-85eb-74f11662e0df"] ["question-e60274a9-ad7a-5782-a789-be03c76f6f3c" :question/answer-fields "answer-field-b4c7e41f-ae27-5892-83ef-b3b75e7b59b0"] [17592186119952 :knowledge-point/questions "question-e60274a9-ad7a-5782-a789-be03c76f6f3c"] ["question-1faddb6e-7103-543e-9a46-6187e7487263" :question/id #uuid "1faddb6e-7103-543e-9a46-6187e7487263"] ["question-1faddb6e-7103-543e-9a46-6187e7487263" :question/math-academy-id "q-109811"] ["question-1faddb6e-7103-543e-9a46-6187e7487263" :question/problem "Which of the three sequences below are geometric sequences?\n\nI. $\\frac{1}{3},\\,-\\frac{4}{3},\\,-\\frac{16}{3},\\,…$\n\nII. $-5,\\,-20,\\,80,\\,…$\n\nIII. $f(n+1)=4f(n)-4,\\,f(1)=2,\\,n\\ge 1$"] ["question-1faddb6e-7103-543e-9a46-6187e7487263" :question/worked-solution "A sequence is geometric if there is a common ratio between its terms. Let's check each sequence in turn.\n\n- Sequence I is not geometric because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{(-\\frac{4}{3})}{(\\frac{1}{3})}=-4 \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{(-\\frac{16}{3})}{(-\\frac{4}{3})}=4\\end{aligned}\n$$\n\n- Sequence II is not geometric because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{-20}{-5}=4 \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{80}{-20}=-4\\end{aligned}\n$$\n\n- Sequence III is not a geometric sequence. To see this, we can calculate the first $3$ terms of the sequence and then compute the ratios of consecutive terms:\n\n$$\n\\begin{aligned}f(1) & =2 \\\\ f(2) & =4\\cdot 2-4=4 \\\\ f(3) & =4\\cdot 4-4=12\\end{aligned}\n$$\n\nSo, the first two pairs of consecutive terms have different ratios:\n\n$$\n\\begin{aligned}\\frac{f(2)}{f(1)} & =\\frac{4}{2}=2 \\\\ \\frac{f(3)}{f(2)} & =\\frac{12}{4}=3\\end{aligned}\n$$\n\nIn conclusion, none of the given is a geometric sequence."] ["question-1faddb6e-7103-543e-9a46-6187e7487263" :question/difficulty :question.difficulty/easy] ["answer-field-3a716f11-43d9-5db6-97b8-516caa9bdfb0" :answer-field/id #uuid "3a716f11-43d9-5db6-97b8-516caa9bdfb0"] ["answer-8b95b35a-939e-5d64-a7a0-741bd14bb687" :answer/id #uuid "8b95b35a-939e-5d64-a7a0-741bd14bb687"] ["answer-8b95b35a-939e-5d64-a7a0-741bd14bb687" :answer/type :answer.type/text] ["answer-8b95b35a-939e-5d64-a7a0-741bd14bb687" :answer/value "I and II only"] ["answer-8b172897-6256-56d7-a919-3132661e3862" :answer/id #uuid "8b172897-6256-56d7-a919-3132661e3862"] ["answer-8b172897-6256-56d7-a919-3132661e3862" :answer/type :answer.type/text] ["answer-8b172897-6256-56d7-a919-3132661e3862" :answer/value "I only"] ["answer-8dbf5972-ecfe-5bfa-9e97-3f8d36df9174" :answer/id #uuid "8dbf5972-ecfe-5bfa-9e97-3f8d36df9174"] ["answer-8dbf5972-ecfe-5bfa-9e97-3f8d36df9174" :answer/type :answer.type/text] ["answer-8dbf5972-ecfe-5bfa-9e97-3f8d36df9174" :answer/value "II only"] ["answer-223d1a4a-f12e-53dc-b2c2-3f53b62f9cde" :answer/id #uuid "223d1a4a-f12e-53dc-b2c2-3f53b62f9cde"] ["answer-223d1a4a-f12e-53dc-b2c2-3f53b62f9cde" :answer/type :answer.type/text] ["answer-223d1a4a-f12e-53dc-b2c2-3f53b62f9cde" :answer/value "III only"] ["answer-99df87b4-dd35-52a1-a81f-94fcade66b11" :answer/id #uuid "99df87b4-dd35-52a1-a81f-94fcade66b11"] ["answer-99df87b4-dd35-52a1-a81f-94fcade66b11" :answer/type :answer.type/text] ["answer-99df87b4-dd35-52a1-a81f-94fcade66b11" :answer/value "None"] ["answer-field-3a716f11-43d9-5db6-97b8-516caa9bdfb0" :answer-field/key "selection"] ["answer-field-3a716f11-43d9-5db6-97b8-516caa9bdfb0" :answer-field/type :answer-field.type/radio] ["answer-field-3a716f11-43d9-5db6-97b8-516caa9bdfb0" :answer-field/correct "answer-99df87b4-dd35-52a1-a81f-94fcade66b11"] ["answer-field-3a716f11-43d9-5db6-97b8-516caa9bdfb0" :answer-field/choices "answer-8b95b35a-939e-5d64-a7a0-741bd14bb687"] ["answer-field-3a716f11-43d9-5db6-97b8-516caa9bdfb0" :answer-field/choices "answer-8b172897-6256-56d7-a919-3132661e3862"] ["answer-field-3a716f11-43d9-5db6-97b8-516caa9bdfb0" :answer-field/choices "answer-8dbf5972-ecfe-5bfa-9e97-3f8d36df9174"] ["answer-field-3a716f11-43d9-5db6-97b8-516caa9bdfb0" :answer-field/choices "answer-223d1a4a-f12e-53dc-b2c2-3f53b62f9cde"] ["answer-field-3a716f11-43d9-5db6-97b8-516caa9bdfb0" :answer-field/choices "answer-99df87b4-dd35-52a1-a81f-94fcade66b11"] ["question-1faddb6e-7103-543e-9a46-6187e7487263" :question/answer-fields "answer-field-3a716f11-43d9-5db6-97b8-516caa9bdfb0"] [17592186119953 :knowledge-point/questions "question-1faddb6e-7103-543e-9a46-6187e7487263"] ["question-baaafa36-2999-5769-af9b-da0e59cba7b8" :question/id #uuid "baaafa36-2999-5769-af9b-da0e59cba7b8"] ["question-baaafa36-2999-5769-af9b-da0e59cba7b8" :question/math-academy-id "q-101443"] ["question-baaafa36-2999-5769-af9b-da0e59cba7b8" :question/problem "Which of the three sequences below are geometric sequences?\n\nI. $\\frac{3}{2},\\,\\frac{1}{2},\\,\\frac{1}{6},\\,…$\n\nII. ${a}_{n+1}={a}_{n}+{a}_{n}^{2},\\,{a}_{1}=2,\\,n\\ge 1$\n\nIII. $f(n+1)=5f(n)+3,\\,f(1)=\\frac{1}{5},\\,n\\ge 1$"] ["question-baaafa36-2999-5769-af9b-da0e59cba7b8" :question/worked-solution "A sequence is geometric if there is a common ratio between its terms. Let's check each sequence in turn.\n\n- Sequence I could be a geometric. For each pair of consecutive terms, the common ratio is the same:\n\n$$\n\\begin{aligned}\\frac{(\\frac{1}{2})}{(\\frac{3}{2})} & =\\frac{1}{3} \\\\ \\frac{(\\frac{1}{6})}{(\\frac{1}{2})} & =\\frac{1}{3}\\end{aligned}\n$$\n\n- Sequence II is not a geometric sequence. To see this, we can calculate the first $3$ terms of the sequence and then compute the ratios of consecutive terms:\n\n$$\n\\begin{aligned}{a}_{1} & =2 \\\\ {a}_{2} & =2+{2}^{2}=6 \\\\ {a}_{3} & =6+{6}^{2}=42\\end{aligned}\n$$\n\nSo, the first two pairs of consecutive terms have different ratios:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}}=\\frac{6}{2} & =3 \\\\ \\frac{{a}_{3}}{{a}_{2}}=\\frac{42}{6} & =7\\end{aligned}\n$$\n\n- Sequence III is not a geometric sequence. To see this, we can calculate the first $3$ terms of the sequence and then compute the ratios of consecutive terms:\n\n$$\n\\begin{aligned}f(1) & =\\frac{1}{5} \\\\ f(2) & =5(\\frac{1}{5})+3=4 \\\\ f(3) & =5(4)+3=23\\end{aligned}\n$$\n\nSo, the first two pairs of consecutive terms have different ratios:\n\n$$\n\\begin{aligned}\\frac{f(2)}{f(1)} & =\\frac{4}{(\\frac{1}{5})}=20 \\\\ \\frac{f(3)}{f(2)} & =\\frac{23}{4}\\end{aligned}\n$$\n\nIn conclusion, only I is a geometric sequence."] ["question-baaafa36-2999-5769-af9b-da0e59cba7b8" :question/difficulty :question.difficulty/moderate] ["answer-field-1136a664-65b2-52c5-a34a-dc3466e7ae31" :answer-field/id #uuid "1136a664-65b2-52c5-a34a-dc3466e7ae31"] ["answer-9fe85af2-0fd8-5185-920a-010f63408182" :answer/id #uuid "9fe85af2-0fd8-5185-920a-010f63408182"] ["answer-9fe85af2-0fd8-5185-920a-010f63408182" :answer/type :answer.type/tex