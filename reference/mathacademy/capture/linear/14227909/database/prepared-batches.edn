[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186119950 :knowledge-point/questions ["question-31eb43e4-a693-51d4-837e-e49e62a1a72a" "question-95752b1d-23a5-5822-b360-684f0368d8b3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119951 :knowledge-point/questions ["question-418f1354-66b6-535c-975e-7236a5d63898" "question-aefdd63c-9ca1-53a8-bde4-4b90e11b234c" "question-03727fdc-9b2a-53db-b355-f55f8718eb73"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119952 :knowledge-point/questions ["question-e7787ac5-6aeb-5774-9055-b078c9c07d68" "question-e60274a9-ad7a-5782-a789-be03c76f6f3c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119953 :knowledge-point/questions ["question-1faddb6e-7103-543e-9a46-6187e7487263" "question-baaafa36-2999-5769-af9b-da0e59cba7b8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-31eb43e4-a693-51d4-837e-e49e62a1a72a" :question/id #uuid "31eb43e4-a693-51d4-837e-e49e62a1a72a" :question/math-academy-id "q-101258" :question/problem "What is the recursive formula for the following geometric sequence?\n\n$$\n20,\\,15,\\,\\frac{45}{4},\\,…\n$$" :question/worked-solution "The recursive formula for a geometric sequence with common ratio $r$ takes the form\n\n$$\n{a}_{n+1}=r\\cdot {a}_{n}.\n$$\n\nIn this case, the first term is ${a}_{1}=20,$ and we can calculate the common ratio $r$ as\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{15}{20}=\\frac{3}{4}.\n$$\n\nConsequently, the recursive formula for this sequence is\n\n$$\n{a}_{n+1}=\\frac{3}{4}\\,{a}_{n},\\,{a}_{1}=20,\\,n\\ge 1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8095106a-9247-5646-9b1f-f9986551763f"] :db/ensure [:question/validate]} {:db/id "answer-field-8095106a-9247-5646-9b1f-f9986551763f" :answer-field/id #uuid "8095106a-9247-5646-9b1f-f9986551763f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ddf82a41-3a9d-594e-8658-634533fb08a2" :answer-field/choices ["answer-d73001c1-8eb9-52f1-a68d-ccd036e4b502" "answer-ddf82a41-3a9d-594e-8658-634533fb08a2" "answer-009c5090-9761-5896-a02c-03e25cbe6026" "answer-72123f1f-d2d0-5b74-98de-1e0e9c6f018c" "answer-ac81aff5-4139-5c1a-bd69-74881d053800"] :db/ensure [:answer-field/validate]} {:db/id "answer-d73001c1-8eb9-52f1-a68d-ccd036e4b502" :answer/id #uuid "d73001c1-8eb9-52f1-a68d-ccd036e4b502" :answer/type :answer.type/math :answer/value "{a}_{n+1}=\\frac{3}{20}\\,{a}_{n},\\,{a}_{1}=15,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-ddf82a41-3a9d-594e-8658-634533fb08a2" :answer/id #uuid "ddf82a41-3a9d-594e-8658-634533fb08a2" :answer/type :answer.type/math :answer/value "{a}_{n+1}=\\frac{3}{4}\\,{a}_{n},\\,{a}_{1}=20,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-009c5090-9761-5896-a02c-03e25cbe6026" :answer/id #uuid "009c5090-9761-5896-a02c-03e25cbe6026" :answer/type :answer.type/math :answer/value "{a}_{n+1}=\\frac{3}{8}\\,{a}_{n},\\,{a}_{1}=20,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-72123f1f-d2d0-5b74-98de-1e0e9c6f018c" :answer/id #uuid "72123f1f-d2d0-5b74-98de-1e0e9c6f018c" :answer/type :answer.type/math :answer/value "{a}_{n+1}=\\frac{45}{4}\\,{a}_{n},\\,{a}_{1}=15,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-ac81aff5-4139-5c1a-bd69-74881d053800" :answer/id #uuid "ac81aff5-4139-5c1a-bd69-74881d053800" :answer/type :answer.type/math :answer/value "{a}_{n+1}=\\frac{4}{3}\\,{a}_{n},\\,{a}_{1}=20,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "question-95752b1d-23a5-5822-b360-684f0368d8b3" :question/id #uuid "95752b1d-23a5-5822-b360-684f0368d8b3" :question/math-academy-id "q-249790" :question/problem "Consider the following geometric sequence:\n\n$$\n30,\\,50,\\,\\frac{250}{3},\\,…\n$$\n\nThe recursive formula for this geometric sequence is\n\n${a}_{n+1}=${{field-1}}$,\\,{a}_{1}=$\n{{field-2}}$,\\,n\\ge 1.$" :question/worked-solution "The recursive formula for a geometric sequence with common ratio $r$ takes the form\n\n$$\n{a}_{n+1}=r\\cdot {a}_{n}.\n$$\n\nIn this case, the first term is ${a}_{1}=30,$ and we can calculate the common ratio $r$ as\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{50}{30}=\\frac{5}{3}.\n$$\n\nTherefore, the recursive formula is\n\n$$\n{a}_{n+1}=\\frac{5}{3}{a}_{n},\\,{a}_{1}=30,\\,n\\ge 1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5a037a71-ae84-5e7f-b898-efcae2af52b3" "answer-field-5fa0faa4-4e5a-549c-865c-470803bc7a75"] :db/ensure [:question/validate]} {:db/id "answer-field-5a037a71-ae84-5e7f-b898-efcae2af52b3" :answer-field/id #uuid "5a037a71-ae84-5e7f-b898-efcae2af52b3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9007d100-56e2-5122-835f-80d3456291ac" :answer-field/choices ["answer-9007d100-56e2-5122-835f-80d3456291ac"] :db/ensure [:answer-field/validate]} {:db/id "answer-9007d100-56e2-5122-835f-80d3456291ac" :answer/id #uuid "9007d100-56e2-5122-835f-80d3456291ac" :answer/type :answer.type/math :answer/value "\\frac{5}{3}a_n" :db/ensure [:answer/validate]} {:db/id "answer-field-5fa0faa4-4e5a-549c-865c-470803bc7a75" :answer-field/id #uuid "5fa0faa4-4e5a-549c-865c-470803bc7a75" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-224edbc2-fbee-5d40-bf96-326d59bc470b" :answer-field/choices ["answer-224edbc2-fbee-5d40-bf96-326d59bc470b"] :db/ensure [:answer-field/validate]} {:db/id "answer-224edbc2-fbee-5d40-bf96-326d59bc470b" :answer/id #uuid "224edbc2-fbee-5d40-bf96-326d59bc470b" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "question-418f1354-66b6-535c-975e-7236a5d63898" :question/id #uuid "418f1354-66b6-535c-975e-7236a5d63898" :question/math-academy-id "q-79510" :question/problem "What is the $4$th term of the geometric sequence given below?\n\n$$\n{a}_{n+1}=-\\frac{1}{2}{a}_{n},\\,{a}_{1}=128,\\,n\\ge 1\n$$" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $4$th term:\n\n$$\n\\begin{aligned}{a}_{1} & =128 \\\\ {a}_{2} & =-\\frac{1}{2}{a}_{1}=-\\frac{1}{2}(128)=-64 \\\\ {a}_{3} & =-\\frac{1}{2}{a}_{2}=-\\frac{1}{2}(-64)=32 \\\\ {a}_{4} & =-\\frac{1}{2}{a}_{3}=-\\frac{1}{2}(32)=-16\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=-16.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-41177c22-4ae0-5230-bc33-006cf9fb29c1"] :db/ensure [:question/validate]} {:db/id "answer-field-41177c22-4ae0-5230-bc33-006cf9fb29c1" :answer-field/id #uuid "41177c22-4ae0-5230-bc33-006cf9fb29c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9bdf55a5-f673-5863-95de-682e4913eded" :answer-field/choices ["answer-9bdf55a5-f673-5863-95de-682e4913eded" "answer-ec359335-db2b-5362-8e72-c6378e62b45f" "answer-7c1a3798-54ab-540d-863e-f5e6a9544ee6" "answer-25d55b98-960e-591e-bf2d-4f4a15f0caea" "answer-a82bbcfe-69b8-5590-98b0-bca18d5ecc85"] :db/ensure [:answer-field/validate]} {:db/id "answer-9bdf55a5-f673-5863-95de-682e4913eded" :answer/id #uuid "9bdf55a5-f673-5863-95de-682e4913eded" :answer/type :answer.type/math :answer/value "-16" :db/ensure [:answer/validate]} {:db/id "answer-ec359335-db2b-5362-8e72-c6378e62b45f" :answer/id #uuid "ec359335-db2b-5362-8e72-c6378e62b45f" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-7c1a3798-54ab-540d-863e-f5e6a9544ee6" :answer/id #uuid "7c1a3798-54ab-540d-863e-f5e6a9544ee6" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-25d55b98-960e-591e-bf2d-4f4a15f0caea" :answer/id #uuid "25d55b98-960e-591e-bf2d-4f4a15f0caea" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "answer-a82bbcfe-69b8-5590-98b0-bca18d5ecc85" :answer/id #uuid "a82bbcfe-69b8-5590-98b0-bca18d5ecc85" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186120171 :question/problem "Consider the following geometric sequence:\n\n$$\n{a}_{n+1}=\\frac{1}{4}{a}_{n},\\,{a}_{1}=256,\\,n\\ge 1\n$$\n\nThe $4$th term of this geometric sequence is ${a}_{4}=$\n{{field-1}}." :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $4$th term:\n\n$$\n\\begin{aligned}{a}_{1} & =256 \\\\ {a}_{2} & =\\frac{1}{4}{a}_{1}=\\frac{1}{4}(256)=64 \\\\ {a}_{3} & =\\frac{1}{4}{a}_{2}=\\frac{1}{4}(64)=16 \\\\ {a}_{4} & =\\frac{1}{4}{a}_{3}=\\frac{1}{4}(16)=4\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=4.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186117192 :answer-field/correct "answer-027fccaa-c5ae-5f11-8896-43a5a65af33e" :answer-field/choices ["answer-027fccaa-c5ae-5f11-8896-43a5a65af33e"] :db/ensure [:answer-field/validate]} {:db/id "answer-027fccaa-c5ae-5f11-8896-43a5a65af33e" :answer/id #uuid "027fccaa-c5ae-5f11-8896-43a5a65af33e" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-aefdd63c-9ca1-53a8-bde4-4b90e11b234c" :question/id #uuid "aefdd63c-9ca1-53a8-bde4-4b90e11b234c" :question/math-academy-id "q-44911" :question/problem "What is the $3$rd term of the geometric sequence given below?\n\n$$\n{a}_{n+1}=-5{a}_{n},\\,{a}_{1}=\\frac{1}{75},\\,n\\ge 1\n$$" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $3$rd term:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{1}{75} \\\\ {a}_{2} & =-5{a}_{1}=-5(\\frac{1}{75})=-\\frac{1}{15} \\\\ {a}_{3} & =-5{a}_{2}=-5(-\\frac{1}{15})=\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, ${a}_{3}=\\frac{1}{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4"] :db/ensure [:question/validate]} {:db/id "answer-field-176b8b77-5248-5ad2-a9d6-5fb267c606a4" :answer-field/id #uuid "176b8b77-5248-5ad2-a9d6-5fb267c606a4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a173cd67-30bb-555b-b5f9-349f5d3f36c4" :answer-field/choices ["answer-e5043de9-8a57-5304-b0ba-e8e53419e90b" "answer-b229ccac-19bf-5635-b760-624ad2c11e2c" "answer-53dc9885-bcbf-5231-b7b6-371ca0f2ff5f" "answer-a173cd67-30bb-555b-b5f9-349f5d3f36c4" "answer-fa44994d-5a93-5dd0-b5c3-4cf7e14c5acf"] :db/ensure [:answer-field/validate]} {:db/id "answer-e5043de9-8a57-5304-b0ba-e8e53419e90b" :answer/id #uuid "e5043de9-8a57-5304-b0ba-e8e53419e90b" :answer/type :answer.type/math :answer/value "-\\frac{1}{15}" :db/ensure [:answer/validate]} {:db/id "answer-b229ccac-19bf-5635-b760-624ad2c11e2c" :answer/id #uuid "b229ccac-19bf-5635-b760-624ad2c11e2c" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-53dc9885-bcbf-5231-b7b6-371ca0f2ff5f" :answer/id #uuid "53dc9885-bcbf-5231-b7b6-371ca0f2ff5f" :answer/type :answer.type/math :answer/value "\\frac{1}{15}" :db/ensure [:answer/validate]} {:db/id "answer-a173cd67-30bb-555b-b5f9-349f5d3f36c4" :answer/id #uuid "a173cd67-30bb-555b-b5f9-349f5d3f36c4" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-fa44994d-5a93-5dd0-b5c3-4cf7e14c5acf" :answer/id #uuid "fa44994d-5a93-5dd0-b5c3-4cf7e14c5acf" :answer/type :answer.type/math :answer/value "\\frac{25}{3}" :db/ensure [:answer/validate]} {:db/id "question-03727fdc-9b2a-53db-b355-f55f8718eb73" :question/id #uuid "03727fdc-9b2a-53db-b355-f55f8718eb73" :question/math-academy-id "q-249803" :question/problem "Consider the following geometric sequence:\n\n$$\n{a}_{n+1}=\\frac{2}{3}{a}_{n},\\,{a}_{1}=27,\\,n\\ge 1\n$$\n\nThe $3$rd term of this geometric sequence is ${a}_{3}=$\n{{field-1}}." :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $3$rd term:\n\n$$\n\\begin{aligned}{a}_{1} & =27 \\\\ {a}_{2} & =\\frac{2}{3}{a}_{1}=\\frac{2}{3}(27)=18 \\\\ {a}_{3} & =\\frac{2}{3}{a}_{2}=\\frac{2}{3}(18)=12\\end{aligned}\n$$\n\nTherefore, ${a}_{3}=12.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c6223f65-65ec-56a2-89b6-bc66582ce68b"] :db/ensure [:question/validate]} {:db/id "answer-field-c6223f65-65ec-56a2-89b6-bc66582ce68b" :answer-field/id #uuid "c6223f65-65ec-56a2-89b6-bc66582ce68b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e349f683-d5d2-533c-bbf7-eb7857abb61f" :answer-field/choices ["answer-e349f683-d5d2-533c-bbf7-eb7857abb61f"] :db/ensure [:answer-field/validate]} {:db/id "answer-e349f683-d5d2-533c-bbf7-eb7857abb61f" :answer/id #uuid "e349f683-d5d2-533c-bbf7-eb7857abb61f" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "question-e7787ac5-6aeb-5774-9055-b078c9c07d68" :question/id #uuid "e7787ac5-6aeb-5774-9055-b078c9c07d68" :question/math-academy-id "q-101432" :question/problem "What is the $4$th term of the geometric sequence given below?\n\n$$\nf(n+1)=-3.5f(n),\\,f(1)=-2,\\,n\\ge 1\n$$" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $4$th term:\n\n$$\n\\begin{aligned}f(1) & =-2 \\\\ f(2) & =-3.5f(1)=-3.5(-2)=7 \\\\ f(3) & =-3.5f(2)=-3.5(7)=-24.5 \\\\ f(4) & =-3.5f(3)=-3.5(-24.5)=85.75\\end{aligned}\n$$\n\nTherefore, $f(4)=85.75.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f08de971-253f-5c62-b587-1f127bb77b75"] :db/ensure [:question/validate]} {:db/id "answer-field-f08de971-253f-5c62-b587-1f127bb77b75" :answer-field/id #uuid "f08de971-253f-5c62-b587-1f127bb77b75" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-24fc281b-515c-5c55-b365-b208cd62d896" :answer-field/choices ["answer-c65f894c-ad2b-5fd9-88a7-4d2f848bde7a" "answer-ec977cf1-c906-53fd-b5f5-1fb310eb6eda" "answer-a3ad70f6-91a3-5b4a-af2e-ce791c283024" "answer-00bac6ed-4ca1-5d37-a955-d3ac6bd3a6e0" "answer-24fc281b-515c-5c55-b365-b208cd62d896"] :db/ensure [:answer-field/validate]} {:db/id "answer-c65f894c-ad2b-5fd9-88a7-4d2f848bde7a" :answer/id #uuid "c65f894c-ad2b-5fd9-88a7-4d2f848bde7a" :answer/type :answer.type/math :answer/value "-300.75" :db/ensure [:answer/validate]} {:db/id "answer-ec977cf1-c906-53fd-b5f5-1fb310eb6eda" :answer/id #uuid "ec977cf1-c906-53fd-b5f5-1fb310eb6eda" :answer/type :answer.type/math :answer/value "-85.75" :db/ensure [:answer/validate]} {:db/id "answer-a3ad70f6-91a3-5b4a-af2e-ce791c283024" :answer/id #uuid "a3ad70f6-91a3-5b4a-af2e-ce791c283024" :answer/type :answer.type/math :answer/value "125.5" :db/ensure [:answer/validate]} {:db/id "answer-00bac6ed-4ca1-5d37-a955-d3ac6bd3a6e0" :answer/id #uuid "00bac6ed-4ca1-5d37-a955-d3ac6bd3a6e0" :answer/type :answer.type/math :answer/value "250.75" :db/ensure [:answer/validate]} {:db/id "answer-24fc281b-515c-5c55-b365-b208cd62d896" :answer/id #uuid "24fc281b-515c-5c55-b365-b208cd62d896" :answer/type :answer.type/math :answer/value "85.75" :db/ensure [:answer/validate]} {:db/id "question-e60274a9-ad7a-5782-a789-be03c76f6f3c" :question/id #uuid "e60274a9-ad7a-5782-a789-be03c76f6f3c" :question/math-academy-id "q-249892" :question/problem "Consider the following geometric sequence:\n\n$$\nf(n+1)=\\frac{2}{7}f(n),\\,f(1)=343,\\,n\\ge 1\n$$\n\nThe $4$th term of this geometric sequence is $f(4)=$\n{{field-1}}." :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $4$th term:\n\n$$\n\\begin{aligned}f(1) & =343 \\\\ f(2) & =\\frac{2}{7}f(1)=\\frac{2}{7}(343)=98 \\\\ f(3) & =\\frac{2}{7}f(2)=\\frac{2}{7}(98)=28 \\\\ f(4) & =\\frac{2}{7}f(3)=\\frac{2}{7}(28)=8\\end{aligned}\n$$\n\nTherefore, $f(4)=8.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b4c7e41f-ae27-5892-83ef-b3b75e7b59b0"] :db/ensure [:question/validate]} {:db/id "answer-field-b4c7e41f-ae27-5892-83ef-b3b75e7b59b0" :answer-field/id #uuid "b4c7e41f-ae27-5892-83ef-b3b75e7b59b0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-83d8320e-7ae3-5aee-85eb-74f11662e0df" :answer-field/choices ["answer-83d8320e-7ae3-5aee-85eb-74f11662e0df"] :db/ensure [:answer-field/validate]} {:db/id "answer-83d8320e-7ae3-5aee-85eb-74f11662e0df" :answer/id #uuid "83d8320e-7ae3-5aee-85eb-74f11662e0df" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-1faddb6e-7103-543e-9a46-6187e7487263" :question/id #uuid "1faddb6e-7103-543e-9a46-6187e7487263" :question/math-academy-id "q-109811" :question/problem "Which of the three sequences below are geometric sequences?\n\nI. $\\frac{1}{3},\\,-\\frac{4}{3},\\,-\\frac{16}{3},\\,…$\n\nII. $-5,\\,-20,\\,80,\\,…$\n\nIII. $f(n+1)=4f(n)-4,\\,f(1)=2,\\,n\\ge 1$" :question/worked-solution "A sequence is geometric if there is a common ratio between its terms. Let's check each sequence in turn.\n\n- Sequence I is not geometric because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{(-\\frac{4}{3})}{(\\frac{1}{3})}=-4 \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{(-\\frac{16}{3})}{(-\\frac{4}{3})}=4\\end{aligned}\n$$\n\n- Sequence II is not geometric because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{-20}{-5}=4 \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{80}{-20}=-4\\end{aligned}\n$$\n\n- Sequence III is not a geometric sequence. To see this, we can calculate the first $3$ terms of the sequence and then compute the ratios of consecutive terms:\n\n$$\n\\begin{aligned}f(1) & =2 \\\\ f(2) & =4\\cdot 2-4=4 \\\\ f(3) & =4\\cdot 4-4=12\\end{aligned}\n$$\n\nSo, the first two pairs of consecutive terms have different ratios:\n\n$$\n\\begin{aligned}\\frac{f(2)}{f(1)} & =\\frac{4}{2}=2 \\\\ \\frac{f(3)}{f(2)} & =\\frac{12}{4}=3\\end{aligned}\n$$\n\nIn conclusion, none of the given is a geometric sequence." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3a716f11-43d9-5db6-97b8-516caa9bdfb0"] :db/ensure [:question/validate]} {:db/id "answer-field-3a716f11-43d9-5db6-97b8-516caa9bdfb0" :answer-field/id #uuid "3a716f11-43d9-5db6-97b8-516caa9bdfb0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-99df87b4-dd35-52a1-a81f-94fcade66b11" :answer-field/choices ["answer-8b95b35a-939e-5d64-a7a0-741bd14bb687" "answer-8b172897-6256-56d7-a919-3132661e3862" "answer-8dbf5972-ecfe-5bfa-9e97-3f8d36df9174" "answer-223d1a4a-f12e-53dc-b2c2-3f53b62f9cde" "answer-99df87b4-dd35-52a1-a81f-94fcade66b11"] :db/ensure [:answer-field/validate]} {:db/id "answer-8b95b35a-939e-5d64-a7a0-741bd14bb687" :answer/id #uuid "8b95b35a-939e-5d64-a7a0-741bd14bb687" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-8b172897-6256-56d7-a919-3132661e3862" :answer/id #uuid "8b172897-6256-56d7-a919-3132661e3862" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-8dbf5972-ecfe-5bfa-9e97-3f8d36df9174" :answer/id #uuid "8dbf5972-ecfe-5bfa-9e97-3f8d36df9174" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-223d1a4a-f12e-53dc-b2c2-3f53b62f9cde" :answer/id #uuid "223d1a4a-f12e-53dc-b2c2-3f53b62f9cde" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-99df87b4-dd35-52a1-a81f-94fcade66b11" :answer/id #uuid "99df87b4-dd35-52a1-a81f-94fcade66b11" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "question-baaafa36-2999-5769-af9b-da0e59cba7b8" :question/id #uuid "baaafa36-2999-5769-af9b-da0e59cba7b8" :question/math-academy-id "q-101443" :question/problem "Which of the three sequences below are geometric sequences?\n\nI. $\\frac{3}{2},\\,\\frac{1}{2},\\,\\frac{1}{6},\\,…$\n\nII. ${a}_{n+1}={a}_{n}+{a}_{n}^{2},\\,{a}_{1}=2,\\,n\\ge 1$\n\nIII. $f(n+1)=5f(n)+3,\\,f(1)=\\frac{1}{5},\\,n\\ge 1$" :question/worked-solution "A sequence is geometric if there is a common ratio between its terms. Let's check each sequence in turn.\n\n- Sequence I could be a geometric. For each pair of consecutive terms, the common ratio is the same:\n\n$$\n\\begin{aligned}\\frac{(\\frac{1}{2})}{(\\frac{3}{2})} & =\\frac{1}{3} \\\\ \\frac{(\\frac{1}{6})}{(\\frac{1}{2})} & =\\frac{1}{3}\\end{aligned}\n$$\n\n- Sequence II is not a geometric sequence. To see this, we can calculate the first $3$ terms of the sequence and then compute the ratios of consecutive terms:\n\n$$\n\\begin{aligned}{a}_{1} & =2 \\\\ {a}_{2} & =2+{2}^{2}=6 \\\\ {a}_{3} & =6+{6}^{2}=42\\end{aligned}\n$$\n\nSo, the first two pairs of consecutive terms have different ratios:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}}=\\frac{6}{2} & =3 \\\\ \\frac{{a}_{3}}{{a}_{2}}=\\frac{42}{6} & =7\\end{aligned}\n$$\n\n- Sequence III is not a geometric sequence. To see this, we can calculate the first $3$ terms of the sequence and then compute the ratios of consecutive terms:\n\n$$\n\\begin{aligned}f(1) & =\\frac{1}{5} \\\\ f(2) & =5(\\frac{1}{5})+3=4 \\\\ f(3) & =5(4)+3=23\\end{aligned}\n$$\n\nSo, the first two pairs of consecutive terms have different ratios:\n\n$$\n\\begin{aligned}\\frac{f(2)}{f(1)} & =\\frac{4}{(\\frac{1}{5})}=20 \\\\ \\frac{f(3)}{f(2)} & =\\frac{23}{4}\\end{aligned}\n$$\n\nIn conclusion, only I is a geometric sequence." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1136a664-65b2-52c5-a34a-dc3466e7ae31"] :db/ensure [:question/validate]} {:db/id "answer-field-1136a664-65b2-52c5-a34a-dc3466e7ae31" :answer-field/id #uuid "1136a664-65b2-52c5-a34a-dc3466e7ae31" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-433d90d7-e26f-567c-9af1-c112294a4728" :answer-field/choices ["answer-9fe85af2-0fd8-5185-920a-010f63408182" "answer-433d90d7-e26f-567c-9af1-c112294a4728" "answer-ae09be8b-9fec-50e0-ab6a-459b64c04f25" "answer-fc97ca3f-aeac-59db-8044-ae6fc8558f1b" "answer-3ed8ab5a-274b-5b22-8b12-39cf14734b98"] :db/ensure [:answer-field/validate]} {:db/id "answer-9fe85af2-0fd8-5185-920a-010f63408182" :answer/id #uuid "9fe85af2-0fd8-5185-920a-010f63408182" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-433d90d7-e26f-567c-9af1-c112294a4728" :answer/id #uuid "433d90d7-e26f-567c-9af1-c112294a4728" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-ae09be8b-9fec-50e0-ab6a-459b64c04f25" :answer/id #uuid "ae09be8b-9fec-50e0-ab6a-459b64c04f25" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-fc97ca3f-aeac-59db-8044-ae6fc8558f1b" :answer/id #uuid "fc97ca3f-aeac-59db-8044-ae6fc8558f1b" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-3ed8ab5a-274b-5b22-8b12-39cf14734b98" :answer/id #uuid "3ed8ab5a-274b-5b22-8b12-39cf14734b98" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]}] "assertions" [["question-31eb43e4-a693-51d4-837e-e49e62a1a72a" :question/id #uuid "31eb43e4-a693-51d4-837e-e49e62a1a72a"] ["question-31eb43e4-a693-51d4-837e-e49e62a1a72a" :question/math-academy-id "q-101258"] ["question-31eb43e4-a693-51d4-837e-e49e62a1a72a" :question/problem "What is the recursive formula for the following geometric sequence?\n\n$$\n20,\\,15,\\,\\frac{45}{4},\\,…\n$$"] ["question-31eb43e4-a693-51d4-837e-e49e62a1a72a" :question/worked-solution "The recursive formula for a geometric sequence with common ratio $r$ takes the form\n\n$$\n{a}_{n+1}=r\\cdot {a}_{n}.\n$$\n\nIn this case, the first term is ${a}_{1}=20,$ and we can calculate the common ratio $r$ as\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{15}{20}=\\frac{3}{4}.\n$$\n\nConsequently, the recursive formula for this sequence is\n\n$$\n{a}_{n+1}=\\frac{3}{4}\\,{a}_{n},\\,{a}_{1}=20,\\,n\\ge 1.\n$$"] ["question-31eb43e4-a693-51d4-837e-e49e62a1a72a" :question/difficulty :question.difficulty/easy] ["answer-field-8095106a-9247-5646-9b1f-f9986551763f" :answer-field/id #uuid "8095106a-9247-5646-9b1f-f9986551763f"] ["answer-d73001c1-8eb9-52f1-a68d-ccd036e4b502" :answer/id #uuid "d73001c1-8eb9-52f1-a68d-ccd036e4b502"] ["answer-d73001c1-8eb9-52f1-a68d-ccd036e4b502" :answer/type :answer.type/math] ["answer-d73001c1-8eb9-52f1-a68d-ccd036e4b502" :answer/value "{a}_{n+1}=\\frac{3}{20}\\,{a}_{n},\\,{a}_{1}=15,\\,n\\ge 1"] ["answer-ddf82a41-3a9d-594e-8658-634533fb08a2" :answer/id #uuid "ddf82a41-3a9d-594e-8658-634533fb08a2"] ["answer-ddf82a41-3a9d-594e-8658-634533fb08a2" :answer/type :answer.type/math] ["answer-ddf82a41-3a9d-594e-8658-634533fb08a2" :answer/value "{a}_{n+1}=\\frac{3}{4}\\,{a}_{n},\\,{a}_{1}=20,\\,n\\ge 1"] ["answer-009c5090-9761-5896-a02c-03e25cbe6026" :answer/id #uuid "009c5090-9761-5896-a02c-03e25cbe6026"] ["answer-009c5090-9761-5896-a02c-03e25cbe6026" :answer/type :answer.type/math] ["answer-009c5090-9761-5896-a02c-03e25cbe6026" :answer/value "{a}_{n+1}=\\frac{3}{8}\\,{a}_{n},\\,{a}_{1}=20,\\,n\\ge 1"] ["answer-72123f1f-d2d0-5b74-98de-1e0e9c6f018c" :answer/id #uuid "72123f1f-d2d0-5b74-98de-1e0e9c6f018c"] ["answer-72123f1f-d2d0-5b74-98de-1e0e9c6f018c" :answer/type :answer.type/math] ["answer-72123f1f-d2d0-5b74-98de-1e0e9c6f018c" :answer/value "{a}_{n+1}=\\frac{45}{4}\\,{a}_{n},\\,{a}_{1}=15,\\,n\\ge 1"] ["answer-ac81aff5-4139-5c1a-bd69-74881d053800" :answer/id #uuid "ac81aff5-4139-5c1a-bd69-74881d053800"] ["answer-ac81aff5-4139-5c1a-bd69-74881d053800" :answer/type :answer.type/math] ["answer-ac81aff5-4139-5c1a-bd69-74881d053800" :answer/value "{a}_{n+1}=\\frac{4}{3}\\,{a}_{n},\\,{a}_{1}=20,\\,n\\ge 1"] ["answer-field-8095106a-9247-5646-9b1f-f9986551763f" :answer-field/key "selection"] ["answer-field-8095106a-9247-5646-9b1f-f9986551763f" :answer-field/type :answer-field.type/radio] ["answer-field-8095106a-9247-5646-9b1f-f9986551763f" :answer-field/correct "answer-ddf82a41-3a9d-594e-8658-634533fb08a2"] ["answer-field-8095106a-9247-5646-9b1f-f9986551763f" :answer-field/choices "answer-d73001c1-8eb9-52f1-a68d-ccd036e4b502"] ["answer-field-8095106a-9247-5646-9b1f-f9986551763f" :answer-field/choices "answer-ddf82a41-3a9d-594e-8658-634533fb08a2"] ["answer-field-8095106a-9247-5646-9b1f-f9986551763f" :answer-field/choices "answer-009c5090-9761-5896-a02c-03e25cbe6026"] ["answer-field-8095106a-9247-5646-9b1f-f9986551763f" :answer-field/choices "answer-72123f1f-d2d0-5b74-98de-1e0e9c6f018c"] ["answer-field-8095106a-9247-5646-9b1f-f9986551763f" :answer-field/choices "answer-ac81aff5-4139-5c1a-bd69-74881d053800"] ["question-31eb43e4-a693-51d4-837e-e49e62a1a72a" :question/answer-fields "answer-field-8095106a-9247-5646-9b1f-f9986551763f"] [17592186119950 :knowledge-point/questions "question-31eb43e4-a693-51d4-837e-e49e62a1a72a"] ["question-95752b1d-23a5-5822-b360-684f0368d8b3" :question/id #uuid "95752b1d-23a5-5822-b360-684f0368d8b3"] ["question-95752b1d-23a5-5822-b360-684f0368d8b3" :question/math-academy-id "q-249790"] ["question-95752b1d-23a5-5822-b360-684f0368d8b3" :question/problem "Consider the following geometric sequence:\n\n$$\n30,\\,50,\\,\\frac{250}{3},\\,…\n$$\n\nThe recursive formula for this geometric sequence is\n\n${a}_{n+1}=${{field-1}}$,\\,{a}_{1}=$\n{{field-2}}$,\\,n\\ge 1.$"] ["question-95752b1d-23a5-5822-b360-684f0368d8b3" :question/worked-solution "The recursive formula for a geometric sequence with common ratio $r$ takes the form\n\n$$\n{a}_{n+1}=r\\cdot {a}_{n}.\n$$\n\nIn this case, the first term is ${a}_{1}=30,$ and we can calculate the common ratio $r$ as\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{50}{30}=\\frac{5}{3}.\n$$\n\nTherefore, the recursive formula is\n\n$$\n{a}_{n+1}=\\frac{5}{3}{a}_{n},\\,{a}_{1}=30,\\,n\\ge 1.\n$$"] ["question-95752b1d-23a5-5822-b360-684f0368d8b3" :question/difficulty :question.difficulty/easy] ["answer-field-5a037a71-ae84-5e7f-b898-efcae2af52b3" :answer-field/id #uuid "5a037a71-ae84-5e7f-b898-efcae2af52b3"] ["answer-9007d100-56e2-5122-835f-80d3456291ac" :answer/id #uuid "9007d100-56e2-5122-835f-80d3456291ac"] ["answer-9007d100-56e2-5122-835f-80d3456291ac" :answer/type :answer.type/math] ["answer-9007d100-56e2-5122-835f-80d3456291ac" :answer/value "\\frac{5}{3}a_n"] ["answer-field-5a037a71-ae84-5e7f-b898-efcae2af52b3" :answer-field/key "field-1"] ["answer-field-5a037a71-ae84-5e7f-b898-efcae2af52b3" :answer-field/type :answer-field.type/blank] ["answer-field-5a037a71-ae84-5e7f-b898-efcae2af52b3" :answer-field/correct "answer-9007d100-56e2-5122-835f-80d3456291ac"] ["answer-field-5a037a71-ae84-5e7f-b898-efcae2af52b3" :answer-field/choices "answer-9007d100-56e2-5122-835f-80d3456291ac"] ["answer-field-5fa0faa4-4e5a-549c-865c-470803bc7a75" :answer-field/id #uuid "5fa0faa4-4e5a-549c-865c-470803bc7a75"] ["answer-224edbc2-fbee-5d40-bf96-326d59bc470b" :answer/id #uuid "224edbc2-fbee-5d40-bf96-326d59bc470b"] ["answer-224edbc2-fbee-5d40-bf96-326d59bc470b" :answer/type :answer.type/math] ["answer-224edbc2-fbee-5d40-bf96-326d59bc470b" :answer/value "30"] ["answer-field-5fa0faa4-4e5a-549c-865c-470803bc7a75" :answer-field/key "field-2"] ["answer-field-5fa0faa4-4e5a-549c-865c-470803bc7a75" :answer-field/type :answer-field.type/blank] ["answer-field-5fa0faa4-4e5a-549c-865c-470803bc7a75" :answer-field/correct "answer-224edbc2-fbee-5d40-bf96-326d59bc470b"] ["answer-field-5fa0faa4-4e5a-549c-865c-470803bc7a75" :answer-field/choices "answer-224edbc2-fbee-5d40-bf96-326d59bc470b"] ["question-95752b1d-23a5-5822-b360-684f0368d8b3" :question/answer-fields "answer-field-5a037a71-ae84-5e7f-b898-efcae2af52b3"] ["question-95752b1d-23a5-5822-b360-684f0368d8b3" :question/answer-fields "answer-field-5fa0faa4-4e5a-549c-865c-470803bc7a75"] [17592186119950 :knowledge-point/questions "question-95752b1d-23a5-5822-b360-684f0368d8b3"] ["question-418f1354-66b6-535c-975e-7236a5d63898" :question/id #uuid "418f1354-66b6-535c-975e-7236a5d63898"] ["question-418f1354-66b6-535c-975e-7236a5d63898" :question/math-academy-id "q-79510"] ["question-418f1354-66b6-535c-975e-7236a5d63898" :question/problem "What is the $4$th term of the geometric sequence given below?\n\n$$\n{a}_{n+1}=-\\frac{1}{2}{a}_{n},\\,{a}_{1}=128,\\,n\\ge 1\n$$"] ["question-418f1354-66b6-535c-975e-7236a5d63898" :question/worked-solution "We use the recursive formula to compute the terms of the sequence up to the $4$th term:\n\n$$\n\\begin{aligned}{a}_{1} & =128 \\\\ {a}_{2} & =-\\frac{1}{2}{a}_{1}=-\\frac{1}{2}(128)=-64 \\\\ {a}_{3} & =-\\frac{1}{2}{a}_{2}=-\\frac{1}{2}(-64)=32 \\\\ {a}_{4} & =-\\frac{1}{2}{a}_{3}=-\\frac{1}{2}(32)=-16\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=-16.$"] ["question-418f1354-66b6-535c-975e-7236a5d63898" :question/difficulty :question.difficulty/moderate] ["answer-field-41177c22-4ae0-5230-bc33-006cf9fb29c1" :answer-field/id #uuid "41177c22-4ae0-5230-bc33-006cf9fb29c1"] ["answer-9bdf55a5-f673-5863-95de-682e4913eded" :answer/id #uuid "9bdf55a5-f673-5863-95de-682e4913eded"] ["answer-9bdf55a5-f673-5863-95de-682e4913eded" :answer/type :answer.type/math] ["answer-9bdf55a5-f673-5863-95de-682e4913eded" :answer/value "-16"] ["answer-ec359335-db2b-5362-8e72-c6378e62b45f" :answer/id #uuid "ec359335-db2b-5362-8e72-c6378e62b45f"] ["answer-ec359335-db2b-5362-8e72-c6378e62b45f" :answer/type :answer.type/math] ["answer-ec359335-db2b-5362-8e72-c6378e62b45f" :answer/value "-8"] ["answer-7c1a3798-54ab-540d-863e-f5e6a9544ee6" :answer/id #uuid "7c1a3798-54ab-540d-863e-f5e6a9544ee6"] ["answer-7c1a3798-54ab-540d-863e-f5e6a9544ee6" :answer/type :answer.type/math] ["answer-7c1a3798-54ab-540d-863e-f5e6a9544ee6" :answer/value "16"] ["answer-25d55b98-960e-591e-bf2d-4f4a15f0caea" :answer/id #uuid "25d55b98-960e-591e-bf2d-4f4a15f0caea"] ["answer-25d55b98-960e-