#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186562581} :activity/id #uuid "d99ecb5e-abe9-5c9f-a181-aa603fce82c4" :activity/scope {:db/id #edb/ref 17592186050271 :topic/id #uuid "3b427f21-e66e-500e-b1b5-ede02904d802" :topic/math-academy-id 1007} :activity/steps [{:db/id #edb/ref 17592186562521 :step/content {:db/id #edb/ref 17592186092618 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "265b541b-62a2-540d-bd79-5ef733742b3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x{e}^{{x}^{2}}" :db/id #edb/ref 17592186285123} {:answer/id #uuid "4a81ce5d-011d-51ee-bf9c-6333bf4dc66f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{2{x}^{2}}" :db/id #edb/ref 17592186285478} {:answer/id #uuid "4b97230b-e5a8-5328-9497-45595399fb66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{{x}^{2}}" :db/id #edb/ref 17592186285492} {:answer/id #uuid "812af0ad-7d34-5c50-a85a-78aa2431dcbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x{e}^{{x}^{2}}" :db/id #edb/ref 17592186285975} {:answer/id #uuid "dedd5724-68fc-54e4-9b62-8ebbbd324624" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}" :db/id #edb/ref 17592186286818}] :answer-field/correct {:db/id #edb/ref 17592186285975} :answer-field/id #uuid "0cfdfe24-c411-57d2-aa42-0fbbe96ad9c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186287169}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0e52fa16-cf3e-5339-95e2-786fe7ef7e5d" :question/math-academy-id "q-1953" :question/problem "Find ${f}^{′}(x)$ for $f(x)={e}^{{x}^{2}}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u={x}^{2}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2x.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (2x) \\\\  & =2x{e}^{u} \\\\  & =2x{e}^{{x}^{2}}.\\end{aligned}\n$$"} :step/id #uuid "01785848-3535-566c-8ed3-1625e925070f" :step/next {:db/id #edb/ref 17592186562549}} {:db/id #edb/ref 17592186562549 :step/content {:db/id #edb/ref 17592186562416 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dbe0539-4fe2-5131-9a91-4a158b45aa23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x{e}^{{x}^{4}+3}" :db/id #edb/ref 17592186561701} {:answer/id #uuid "699ef952-cd7a-5cde-b182-3f4d9a8b1d58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{x}^{3}{e}^{2{x}^{4}+3}" :db/id #edb/ref 17592186561845} {:answer/id #uuid "7b4af48c-3147-5fd2-ba59-b1551123c8c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8x{e}^{2x+3}" :db/id #edb/ref 17592186561887} {:answer/id #uuid "ca809957-cb8d-5918-bf34-5e74f50b4780" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{x}^{2}{e}^{2{x}^{4}+5}" :db/id #edb/ref 17592186562088} {:answer/id #uuid "f16911d4-15e8-5cbf-a535-476b2410db5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8x{e}^{6{x}^{4}+1}" :db/id #edb/ref 17592186562184}] :answer-field/correct {:db/id #edb/ref 17592186561845} :answer-field/id #uuid "018265d8-4b38-5450-a523-ac3f8812815c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186562217}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2f55f57b-ca3e-54c4-9349-d3c4559745cd" :question/math-academy-id "q-71877" :question/problem "Find ${f}^{′}(x)$ for $f(x)={e}^{2{x}^{4}+3}.$" :question/worked-solution "First we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u=2{x}^{4}+3.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=8{x}^{3}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (8{x}^{3}) \\\\  & =8{x}^{3}{e}^{u} \\\\  & =8{x}^{3}{e}^{2{x}^{4}+3}.\\end{aligned}\n$$"} :step/id #uuid "734de382-5fea-5f07-968d-7e70fd7866b9"} {:db/id #edb/ref 17592186562581 :step/content {:db/id #edb/ref 17592186562394 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38229b23-2b39-59e5-9abd-c6c07d94e182" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\cdot {4}^{7x}" :db/id #edb/ref 17592186561722} {:answer/id #uuid "78c9ae9f-b6bd-5e2b-a491-13f9286f6a11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7x" :db/id #edb/ref 17592186561883} {:answer/id #uuid "799b33bd-f993-5922-93a7-8e0d15933029" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡4\\cdot {4}^{7x}" :db/id #edb/ref 17592186561884} {:answer/id #uuid "7ccc347a-a561-5923-a18e-8613311aa3f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4}^{7x}" :db/id #edb/ref 17592186561891} {:answer/id #uuid "b13acdb7-c3c6-501a-bb40-9e3bfb33ea7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\operatorname{ln}⁡4\\cdot {4}^{7x}" :db/id #edb/ref 17592186562024}] :answer-field/correct {:db/id #edb/ref 17592186562024} :answer-field/id #uuid "bc0be4a0-ce70-5992-8eed-814e9a761b79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186562341}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0876dfcc-e11e-5c1c-a9e0-0c7b6f68915a" :question/math-academy-id "q-1951" :question/problem "If $f(x)={4}^{7x},$ find ${f}^{′}(x).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={4}^{u},\\,u=7x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={4}^{u}\\operatorname{ln}⁡4,\\,\\frac{\\text{d}u}{\\text{d}x}=7.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =7\\cdot {4}^{u}\\operatorname{ln}⁡4 \\\\  & =7\\operatorname{ln}⁡4\\cdot {4}^{u} \\\\  & =7\\operatorname{ln}⁡4\\cdot {4}^{7x}.\\end{aligned}\n$$"} :step/id #uuid "d84d7d23-dca4-52c0-a782-75952a8d43b2" :step/next {:db/id #edb/ref 17592186562521}}] :activity/title "The Chain Rule With Exponential Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186561576}]}
