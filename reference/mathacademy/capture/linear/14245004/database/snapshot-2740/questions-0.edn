#{[{:db/id #edb/ref 17592186092618 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "265b541b-62a2-540d-bd79-5ef733742b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{{x}^{2}}" :db/id #edb/ref 17592186285123} {:answer/id #uuid "4a81ce5d-011d-51ee-bf9c-6333bf4dc66f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2{x}^{2}}" :db/id #edb/ref 17592186285478} {:answer/id #uuid "4b97230b-e5a8-5328-9497-45595399fb66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{{x}^{2}}" :db/id #edb/ref 17592186285492} {:answer/id #uuid "812af0ad-7d34-5c50-a85a-78aa2431dcbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{e}^{{x}^{2}}" :db/id #edb/ref 17592186285975} {:answer/id #uuid "dedd5724-68fc-54e4-9b62-8ebbbd324624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}" :db/id #edb/ref 17592186286818}] :answer-field/correct {:answer/id #uuid "812af0ad-7d34-5c50-a85a-78aa2431dcbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{e}^{{x}^{2}}" :db/id #edb/ref 17592186285975} :answer-field/id #uuid "0cfdfe24-c411-57d2-aa42-0fbbe96ad9c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287169}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e52fa16-cf3e-5339-95e2-786fe7ef7e5d" :question/math-academy-id "q-1953" :question/problem "Find ${f}^{′}(x)$ for $f(x)={e}^{{x}^{2}}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u={x}^{2}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2x.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (2x) \\\\  & =2x{e}^{u} \\\\  & =2x{e}^{{x}^{2}}.\\end{aligned}\n$$"}]}
