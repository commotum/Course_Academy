#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186557388} :activity/id #uuid "0b2ee7db-7c41-5b6b-a695-5915c75ef129" :activity/scope {:db/id #edb/ref 17592186048338 :topic/id #uuid "96be3b68-ea0a-594d-ac9b-2bd958c09c72" :topic/math-academy-id 669} :activity/steps [{:db/id #edb/ref 17592186557377 :step/content {:db/id #edb/ref 17592186557252 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "495383fd-96af-5901-b036-2fc2d4ed846d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186556595} {:answer/id #uuid "533597a1-e3f5-5fa1-94dc-91bba990baca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186556620} {:answer/id #uuid "54e4cfc3-636f-5122-be78-c9628acb2eb2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17" :db/id #edb/ref 17592186556626} {:answer/id #uuid "670cec8e-0d34-56b0-87fa-070c4615dfb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186556673} {:answer/id #uuid "fa518048-206a-54de-a58b-6bc20ddc9f4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186557050}] :answer-field/correct {:db/id #edb/ref 17592186556673} :answer-field/id #uuid "887edb48-4438-5fb8-9f68-ad1ecb484ac1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557144}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "56794a38-11f6-536d-bb01-6b7e50ccfb8b" :question/math-academy-id "q-51839" :question/problem "An arithmetic sequence has ${a}_{9}=9$ and ${a}_{22}=178.$ What is the common difference of the sequence?" :question/worked-solution "The first thing to note is that the terms are *increasing*, and therefore we expect $d$ to be *positive*.\n\nWe are given the terms\n\n$$\n{a}_{9}=9,\\,{a}_{22}=178.\n$$\n\nTo find $d,$ we apply the formula with $n=22$ and $m=9:$\n\n$$\n\\begin{aligned}d & =\\frac{{a}_{n}-{a}_{m}}{n-m} \\\\  & =\\frac{{a}_{22}-{a}_{9}}{22-9} \\\\  & =\\frac{178-9}{22-9} \\\\  & =\\frac{169}{13} \\\\  & =13\\end{aligned}\n$$\n\nTherefore, the common difference is $d=13.$"} :step/id #uuid "8aad04a0-c6e7-572a-a7a1-bb3e0b3a6360" :step/next {:db/id #edb/ref 17592186557397}} {:db/id #edb/ref 17592186557388 :step/content {:db/id #edb/ref 17592186079080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b87ba976-114f-5bc8-9b3d-f528fb5b2b4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186077259} {:answer/id #uuid "ca1d7240-8bbe-50cf-8edf-7f135f060a57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186077260} {:answer/id #uuid "e8706c52-3a97-54e9-a8e5-74d26fbd9743" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186077261} {:answer/id #uuid "2eab5511-577f-5ea6-b64e-f6320e4ed0ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186077262} {:answer/id #uuid "4ea95db3-ff2b-5f09-931a-2faa481430f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186077263}] :answer-field/correct {:db/id #edb/ref 17592186077263} :answer-field/id #uuid "373aa7b8-6a29-57bc-bcdc-cc742a408c61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186077258}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3ff9d20b-55c8-53ea-a576-66b9dcd459f3" :question/math-academy-id "q-5270" :question/problem "Find the common difference of an arithmetic sequence if its fourth and fifth terms are $1$ and $7$, respectively." :question/worked-solution "The first thing to note is that the terms are *increasing*, and therefore we expect the common difference $d$ to be *positive*.\n\nSince the two terms are consecutive, we can find the common difference by subtracting ${a}_{4}$ from ${a}_{5}:$\n\n$$\n\\begin{aligned}d & ={a}_{5}-{a}_{4} \\\\  & =7-1 \\\\  & =6\\end{aligned}\n$$\n\nTherefore, the common difference is $d=6.$"} :step/id #uuid "bb173ec4-dd61-50f2-8584-c82411d790aa" :step/next {:db/id #edb/ref 17592186557377}} {:db/id #edb/ref 17592186557397 :step/content {:db/id #edb/ref 17592186557209 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dafe0d7-7167-5df4-9ba9-18802932947e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186556567} {:answer/id #uuid "6116e349-e0a5-58a8-8407-21b7d71d2915" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186556650} {:answer/id #uuid "657ee12f-f6f4-59d4-bac7-11a544c78598" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186556667} {:answer/id #uuid "d2564f09-d536-5dd1-b262-ee4b42fae3e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-11" :db/id #edb/ref 17592186556937} {:answer/id #uuid "d312637a-fb32-535d-b6c7-1fb61f66a8e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186556940}] :answer-field/correct {:db/id #edb/ref 17592186556667} :answer-field/id #uuid "618eab75-64d8-512a-bb20-45001701ac97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186557121}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "028f9fde-1b16-58aa-96b4-26b7759a29ce" :question/math-academy-id "q-51867" :question/problem "Find the common difference of an arithmetic sequence if its seventh and twenty-second terms are $126$ and $-9$, respectively." :question/worked-solution "The first thing to note is that the terms are *decreasing*, and therefore we expect $d$ to be *negative*.\n\nWe are given the terms\n\n$$\n{a}_{7}=126,\\,{a}_{22}=-9.\n$$\n\nSo, to find $d,$ we apply the formula with $n=22$ and $m=7:$\n\n$$\n\\begin{aligned}d & =\\frac{{a}_{n}-{a}_{m}}{n-m} \\\\  & =\\frac{{a}_{22}-{a}_{7}}{22-7} \\\\  & =\\frac{(-9)-126}{22-7} \\\\  & =\\frac{-135}{15} \\\\  & =-9\\end{aligned}\n$$\n\nTherefore, the common difference is $d=-9.$"} :step/id #uuid "dae43b25-3e8a-58c9-81da-f3af859a0e75"}] :activity/title "Finding the Common Difference of an Arithmetic Sequence" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186556407}]}
