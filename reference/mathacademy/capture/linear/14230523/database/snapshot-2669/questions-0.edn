ces [{:answer/id #uuid "4216db74-aefa-5a03-b6c7-5f7441349954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186551823} {:answer/id #uuid "6c730574-db0d-582d-8a0d-1f3d385226f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186551918} {:answer/id #uuid "77749144-f42f-5bdc-bdf5-9a73ee954a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186551947} {:answer/id #uuid "a9a3aebb-4432-58b4-bf5d-938559cac89e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186552070} {:answer/id #uuid "d75e751c-9fb6-5a6b-a89c-ca676c18fa70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186552173}] :answer-field/correct {:answer/id #uuid "a9a3aebb-4432-58b4-bf5d-938559cac89e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186552070} :answer-field/id #uuid "f251fcd4-afa5-556f-8623-eabb2c36903b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552395}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cc78fc5e-250d-5649-8a8b-22e66a1b36a4" :question/math-academy-id "q-51569" :question/problem "![](images/be/be6a289223fdd6c6896278b5e179bf9f4a98d7f9e5988d1b5ae98a1217dd48b0.png)\n\nThe graph of $y=f(x)$ is shown above. Given that $y=f(x)$ is periodic with period $3,$ what is the value of $f(30)?$" :question/worked-solution "Since the period is $3,$ if we add (or subtract) any multiple of $3$ from the input, the output stays the same.\n\nSo, we can keep subtracting $3$ from the input until we get to an input that we see in the graph:\n\n$$\n\\begin{aligned}f(30) & =f(30-3) \\\\  & =f(30-2\\cdot 3) \\\\  & =⋯ \\\\  & =f(30-10\\cdot 3) \\\\  & =f(0) \\\\  & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186552498 :knowledge-point/_questions [{:db/id #edb/ref 17592186133904 :knowledge-point/id #uuid "282b873c-1ba0-5205-b75f-c58721ffaaff" :knowledge-point/title "Inferring Values of a Periodic Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d0d8735-6074-5b38-aaa0-dc0b493efa76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186551920} {:answer/id #uuid "7125aeb5-88dc-5496-8c06-33a69b6906fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186551933} {:answer/id #uuid "8870cac5-aa48-555c-94d0-9beebad895d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186551996} {:answer/id #uuid "88ab28bc-1dcc-55dd-bd2f-0d4cd94b7d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186551997} {:answer/id #uuid "f47526ea-c542-5dd5-92c8-53fe01409039" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186552238}] :answer-field/correct {:answer/id #uuid "6d0d8735-6074-5b38-aaa0-dc0b493efa76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186551920} :answer-field/id #uuid "db065e90-9456-5e94-8dea-022b5c078f50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552381}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b9272833-b47f-50b5-a702-18a31d3e3932" :question/math-academy-id "q-82378" :question/problem "![](images/7d/7d94f4a4ab36e4370754f948d3fa7176c300b057b938faa16ca5843f1d8b42f4.png)\n\nThe graph of $y=f(x)$ is shown above. Given that $y=f(x)$ is periodic with period $5,$ what is the value of $f(132)?$" :question/worked-solution "Since the period is $5,$ if we add (or subtract) any multiple of $5$ from the input, the output stays the same.\n\nSo, we can keep subtracting $5$ from the input until we get to an input that we see in the graph:\n\n$$\n\\begin{aligned}f(132) & =f(132-5) \\\\  & =f(132-2\\cdot 5) \\\\  & =⋯ \\\\  & =f(132-26\\cdot 5) \\\\  & =f(2) \\\\  & =-2\\end{aligned}\n$$"}]}
