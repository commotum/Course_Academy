point/title "Drawing the Graph of a Periodic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a59d2e-0e5f-5d17-895b-c745e08f6ab4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cc/cc628e23b36aa95aa47e42c6bae14caf29651c46abcea1bf26408b44f2660f10.png" :db/id #edb/ref 17592186551710} {:answer/id #uuid "29b86e49-b4a2-5627-8ef4-894f6c4b6a34" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2a/2a781632685f39a17d71ab2e2a1b8c57814a1b896f449dfc845f6715944c1d5c.png" :db/id #edb/ref 17592186551761} {:answer/id #uuid "c3a58e20-55c6-568a-adf4-add7d23f1d5d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1d/1d7101c6a31ad2266cbe6143580785dfc9d767da26bbaf3b434333e57b185e55.png" :db/id #edb/ref 17592186552132} {:answer/id #uuid "f6a59501-f2c0-59e4-ac3b-2fa33298dbe7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/78/7846122a9a471d5645e3909bce365a31008e944802123b2349b64a2d78576e21.png" :db/id #edb/ref 17592186552241} {:answer/id #uuid "ffcd2c9a-b6b8-5e1f-ad46-10d9f12db045" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e7/e76b9e3629db598697bf65ea533176a974e0622fb4df8759be30e632635b8c91.png" :db/id #edb/ref 17592186552255}] :answer-field/correct {:answer/id #uuid "15a59d2e-0e5f-5d17-895b-c745e08f6ab4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cc/cc628e23b36aa95aa47e42c6bae14caf29651c46abcea1bf26408b44f2660f10.png" :db/id #edb/ref 17592186551710} :answer-field/id #uuid "4b2a9f55-9ead-51a5-ba87-c49cdccec809" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552294}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #u