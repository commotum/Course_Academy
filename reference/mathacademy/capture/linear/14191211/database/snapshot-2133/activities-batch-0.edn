#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186189246} :activity/id #uuid "d79ba348-c646-5f14-ae8e-c850ebf9ecf1" :activity/scope {:db/id #edb/ref 17592186049496 :topic/id #uuid "f93c391b-70b7-5915-96b7-e71123856cd6" :topic/math-academy-id 3873} :activity/steps [{:db/id #edb/ref 17592186189246 :step/content {:db/id #edb/ref 17592186189440 :tutorial/content "Let's think about how to simplify the following expression:\n\n$$\n6x-(3+2x)\n$$\n\nIn this example, we're subtracting the entire group of terms in parentheses from $6x.$ In such cases, we distribute the negative sign to each term in the parentheses *first* and then simplify by collecting like terms.\n\nRemoving the parentheses by distributing the negative sign, we get\n\n$$\n\\begin{aligned}6x-(3+2x) & = \\\\ 6x-3-2x & .\\end{aligned}\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}6x-3-2x & = \\\\ (6x-2x)-3 & = \\\\ 4x-3 & \\end{aligned}\n$$\n\nLet's take a look at another example." :tutorial/id #uuid "e0305f7d-c5ac-5566-af24-891e025ad938" :tutorial/math-academy-id 8189 :tutorial/title "Introduction"} :step/id #uuid "48299c1f-8045-5cb7-a906-450404a7722b" :step/math-academy-id 54169 :step/next {:db/id #edb/ref 17592186189247}} {:db/id #edb/ref 17592186189247 :step/content {:db/id #edb/ref 17592186188373 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188086 :question/id #uuid "7f43385c-ccc0-5855-916a-e6bb689c290f" :question/math-academy-id "e-13094"} :knowledge-point/id #uuid "77a8929d-7aa9-5410-97d7-c7c72e9f1356" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049939} {:db/id #edb/ref 17592186050452}] :knowledge-point/questions [{:db/id #edb/ref 17592186188574} {:db/id #edb/ref 17592186188576} {:db/id #edb/ref 17592186475944} {:db/id #edb/ref 17592186475982}] :knowledge-point/title "Distributing the Negative Sign Before Simplifying"} :step/id #uuid "b722a519-23e4-59d9-b070-fe41c31e900a" :step/math-academy-id 54170 :step/next {:db/id #edb/ref 17592186189248}} {:db/id #edb/ref 17592186189248 :step/content {:db/id #edb/ref 17592186188374 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188087 :question/id #uuid "d73b6911-278d-5c8e-a900-fc751fa518fa" :question/math-academy-id "e-13095"} :knowledge-point/id #uuid "b93a6e36-3ec9-5451-92c0-a534f2776cf1" :knowledge-point/questions [{:db/id #edb/ref 17592186188575} {:db/id #edb/ref 17592186188577} {:db/id #edb/ref 17592186475951} {:db/id #edb/ref 17592186504669} {:db/id #edb/ref 17592186504687}] :knowledge-point/title "Distributing the Negative Sign Before Simplifying: Negative Terms in Parentheses"} :step/id #uuid "2d27c88e-9503-5c41-bf18-fcea1bf5999f" :step/math-academy-id 54173 :step/next {:db/id #edb/ref 17592186189249}} {:db/id #edb/ref 17592186189249 :step/content {:db/id #edb/ref 17592186189441 :tutorial/content "Sometimes, to subtract a group of terms, we have to apply the distributive law.\n\nFor example, let's simplify the following expression:\n\n$$\n7-4(y+2)\n$$\n\nFirst, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n7 - \\Big[4(y+2)\\Big]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n7 - \\Big[4y+8\\Big].\n$$\n\nNow, we proceed as before. Removing the brackets by distributing the negative sign gives\n\n$$\n7 - 4y - 8.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}7-4y-8 & = \\\\ (7-8)-4y & = \\\\ -1-4y & \\end{aligned}\n$$" :tutorial/id #uuid "7ded6b18-fb82-5e0c-999c-e8bede8f99c8" :tutorial/math-academy-id 8190 :tutorial/title "Subtracting a Group of Terms Using the Distributive Law"} :step/id #uuid "ad56d248-e365-5d0f-9646-35528365848b" :step/math-academy-id 54176 :step/next {:db/id #edb/ref 17592186189250}} {:db/id #edb/ref 17592186189250 :step/content {:db/id #edb/ref 17592186188375 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188088 :question/id #uuid "34317825-e142-5f97-951f-45f87d9672d5" :question/math-academy-id "e-13096"} :knowledge-point/id #uuid "9012632c-56fc-59b7-8212-39aeb96e2f9d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050575}] :knowledge-point/questions [{:db/id #edb/ref 17592186188950} {:db/id #edb/ref 17592186188974} {:db/id #edb/ref 17592186475946} {:db/id #edb/ref 17592186475983}] :knowledge-point/title "Applying the Distributive Law Before Simplifying"} :step/id #uuid "f8f736f0-3a01-5ac8-a88f-d5962e78c148" :step/math-academy-id 54177 :step/next {:db/id #edb/ref 17592186189251}} {:db/id #edb/ref 17592186189251 :step/content {:db/id #edb/ref 17592186188376 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188089 :question/id #uuid "d6283f26-9e20-5255-b358-8bc0c6523065" :question/math-academy-id "e-13097"} :knowledge-point/id #uuid "1f9b26ce-9f61-5cb0-aeab-ee44bb3584c9" :knowledge-point/questions [{:db/id #edb/ref 17592186188971} {:db/id #edb/ref 17592186188972} {:db/id #edb/ref 17592186475950} {:db/id #edb/ref 17592186475981}] :knowledge-point/title "Applying the Distributive Law Before Simplifying: Negative Terms in Parentheses"} :step/id #uuid "7f09baad-048d-5278-9394-d9bf15b40156" :step/math-academy-id 54180}] :activity/title "Simplifying Linear Expressions When a Group of Terms Is Subtracted" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186188467}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186504736} :activity/id #uuid "9fecab51-b2b7-570a-b77c-aaf9f1c9d473" :activity/scope {:db/id #edb/ref 17592186049496 :topic/id #uuid "f93c391b-70b7-5915-96b7-e71123856cd6" :topic/math-academy-id 3873} :activity/steps [{:db/id #edb/ref 17592186504712 :step/content {:db/id #edb/ref 17592186504687 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34afa9ed-00ce-5ad3-8ac0-de8b2107befb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6+2t" :db/id #edb/ref 17592186504121} {:answer/id #uuid "56a02156-0eda-5329-a27c-ae71c16b1d13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4+2t" :db/id #edb/ref 17592186504183} {:answer/id #uuid "7094ccad-f184-5eda-960d-72aaa2be77f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4-2t" :db/id #edb/ref 17592186504229} {:answer/id #uuid "ae9e55e7-5332-5599-bce1-06cd145becde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5+2t" :db/id #edb/ref 17592186504333} {:answer/id #uuid "bbf61ddd-6039-5de5-8c94-ab6c85436dcc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6-2t" :db/id #edb/ref 17592186504357}] :answer-field/correct {:db/id #edb/ref 17592186504229} :answer-field/id #uuid "846bf343-94dc-5249-9587-db971cfd4284" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186504539}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d29eb87c-44a4-5a37-bf93-591857617749" :question/math-academy-id "q-144242" :question/problem "Simplify the expression $-5-(2t-1).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-5-2t+1\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-5-2t+1 & = \\\\ (-5+1)-2t & = \\\\ -4-2t & \\end{aligned}\n$$"} :step/id #uuid "1400d1b1-0431-5937-822b-73dc0d2e03d3" :step/next {:db/id #edb/ref 17592186504722}} {:db/id #edb/ref 17592186504722 :step/content {:db/id #edb/ref 17592186504669 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f196ffb-2adb-5a67-bb3e-2b31b5c43446" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z-4" :db/id #edb/ref 17592186504174} {:answer/id #uuid "50315422-59be-5fbc-81e9-8488f57b7566" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2z+4" :db/id #edb/ref 17592186504176} {:answer/id #uuid "6b1aee99-c06b-5e49-889b-b7b106beb421" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3z+4" :db/id #edb/ref 17592186504219} {:answer/id #uuid "80a4c9b3-c7c7-5c88-a811-ea10d3447e52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3z-4" :db/id #edb/ref 17592186504256} {:answer/id #uuid "b6ea043f-71dc-55a6-85e3-43551c5df0ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "z+4" :db/id #edb/ref 17592186504348}] :answer-field/correct {:db/id #edb/ref 17592186504219} :answer-field/id #uuid "d8ee21a4-8187-5196-bc40-be0eccd3b690" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186504584}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b758fdc7-6117-52fe-b304-75d15ade9ee4" :question/math-academy-id "q-144248" :question/problem "Simplify the expression $-z-(2z-4).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-z-2z+4\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-z-2z+4 & = \\\\ (-z-2z)+4 & = \\\\ -3z+4 & \\end{aligned}\n$$"} :step/id #uuid "476044c1-7592-5496-b5a8-09989c9fdef0"} {:db/id #edb/ref 17592186504736 :step/content {:db/id #edb/ref 17592186188950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "503a5a0c-6d91-57c6-948d-dc1e42b752c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+3x" :db/id #edb/ref 17592186504177} {:answer/id #uuid "7896240f-c609-59c4-ad0e-5e18c1ac5585" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-x" :db/id #edb/ref 17592186504238} {:answer/id #uuid "e47bba09-a7c0-55d0-b09a-a6c628a5c61a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6-x" :db/id #edb/ref 17592186504426} {:answer/id #uuid "f49610d5-614f-58e0-bcf7-ba25b5bd037f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-3x" :db/id #edb/ref 17592186504458} {:answer/id #uuid "f78366f5-867d-50a1-aae2-976f8223d54e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6-3x" :db/id #edb/ref 17592186504462}] :answer-field/correct {:db/id #edb/ref 17592186504458} :answer-field/id #uuid "f7c1fbb4-4134-53c6-a8fa-ae4d00ea2050" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186187776}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fb908c23-fe0f-52b8-bd9d-1f4c58233cb6" :question/math-academy-id "q-57060" :question/problem "$5-3(x+1)=$" :question/worked-solution "Notice that the expression we need to subtract from $5$ must be expanded using the distributive law. \n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n5-[3(x+1)]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n5-[3x+3].\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n5-3x-3.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}5-3x-3 & = \\\\ (5-3)-3x & = \\\\ 2-3x & \\end{aligned}\n$$"} :step/id #uuid "caf89608-4574-585a-892a-4ade1daf1ba9" :step/next {:db/id #edb/ref 17592186504712}}] :activity/title "Simplifying Linear Expressions When a Group of Terms Is Subtracted" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186504026}]}
