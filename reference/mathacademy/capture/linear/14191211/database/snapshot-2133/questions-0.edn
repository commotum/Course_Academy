gn. This gives\n\n$$\n-5-2t+1\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-5-2t+1 & = \\\\ (-5+1)-2t & = \\\\ -4-2t & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186504669 :knowledge-point/_questions [{:db/id #edb/ref 17592186188374 :knowledge-point/id #uuid "b93a6e36-3ec9-5451-92c0-a534f2776cf1" :knowledge-point/title "Distributing the Negative Sign Before Simplifying: Negative Terms in Parentheses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f196ffb-2adb-5a67-bb3e-2b31b5c43446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z-4" :db/id #edb/ref 17592186504174} {:answer/id #uuid "50315422-59be-5fbc-81e9-8488f57b7566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2z+4" :db/id #edb/ref 17592186504176} {:answer/id #uuid "6b1aee99-c06b-5e49-889b-b7b106beb421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3z+4" :db/id #edb/ref 17592186504219} {:answer/id #uuid "80a4c9b3-c7c7-5c88-a811-ea10d3447e52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3z-4" :db/id #edb/ref 17592186504256} {:answer/id #uuid "b6ea043f-71dc-55a6-85e3-43551c5df0ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z+4" :db/id #edb/ref 17592186504348}] :answer-field/correct {:answer/id #uuid "6b1aee99-c06b-5e49-889b-b7b106beb421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3z+4" :db/id #edb/ref 17592186504219} :answer-field/id #uuid "d8ee21a4-8187-5196-bc40-be0eccd3b690" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504584}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b758fdc7-6117-52fe-b304-75d15ade9ee4" :question/math-academy-id "q-144248" :question/problem "Simplify the expression $-z-(2z-4).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n-z-2z+4\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}-z-2z+4 & = \\\\ (-z-2z)+4 & = \\\\ -3z+4 & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186188950 :knowledge-point/_questions [{:db/id #edb/ref 17592186188375 :knowledge-point/id #uuid "9012632c-56fc-59b7-8212-39aeb96e2f9d" :knowledge-point/title "Applying the Distributive Law Before Simplifying"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "503a5a0c-6d91-57c6-948d-dc1e42b752c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+3x" :db/id #edb/ref 17592186504177} {:answer/id #uuid "7896240f-c609-59c4-ad0e-5e18c1ac5585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-x" :db/id #edb/ref 17592186504238} {:answer/id #uuid "e47bba09-a7c0-55d0-b09a-a6c628a5c61a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6-x" :db/id #edb/ref 17592186504426} {:answer/id #uuid "f49610d5-614f-58e0-bcf7-ba25b5bd037f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-3x" :db/id #edb/ref 17592186504458} {:answer/id #uuid "f78366f5-867d-50a1-aae2-976f8223d54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6-3x" :db/id #edb/ref 17592186504462}] :answer-field/correct {:answer/id #uuid "f49610d5-614f-58e0-bcf7-ba25b5bd037f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-3x" :db/id #edb/ref 17592186504458} :answer-field/id #uuid "f7c1fbb4-4134-53c6-a8fa-ae4d00ea2050" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186187776}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb908c23-fe0f-52b8-bd9d-1f4c58233cb6" :question/math-academy-id "q-57060" :question/problem "$5-3(x+1)=$" :question/worked-solution "Notice that the expression we need to subtract from $5$ must be expanded using the distributive law. \n\nSo first, let's write some big brackets around the expression in parentheses, keeping the minus sign *outside*.\n\n$$\n5-[3(x+1)]\n$$\n\nNext, we expand the expression inside the brackets using the distributive law. This gives\n\n$$\n5-[3x+3].\n$$\n\nNow, we remove the brackets by distributing the negative sign. This gives\n\n$$\n5-3x-3.\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}5-3x-3 & = \\\\ (5-3)-3x & = \\\\ 2-3x & \\end{aligned}\n$$"}]}
