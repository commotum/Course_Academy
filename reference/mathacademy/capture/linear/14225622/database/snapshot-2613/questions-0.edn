#{[{:db/id #edb/ref 17592186543578 :knowledge-point/_questions [{:db/id #edb/ref 17592186184341 :knowledge-point/id #uuid "8092788d-bb38-5527-8069-8e32c97e08b9" :knowledge-point/title "Composing a Function With Itself"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abd7f3ea-e1df-5aa2-b07e-3e4d14c0cfb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x^{4}-8x^{2}+1" :db/id #edb/ref 17592186543092}] :answer-field/correct {:answer/id #uuid "abd7f3ea-e1df-5aa2-b07e-3e4d14c0cfb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x^{4}-8x^{2}+1" :db/id #edb/ref 17592186543092} :answer-field/id #uuid "205ef3eb-ccfc-5714-a196-5890ad4baa93" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543310}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e71385aa-2fca-5283-a0e8-74b07850b796" :question/math-academy-id "q-222425" :question/problem "If $f(x)=2{x}^{2}-1,$ then $(f∘f)(x)=${{field-1}}." :question/worked-solution "First, we note that $(f∘f)(x)$ is equivalent to $f(f(x)).$\n\nTo find $f(f(x)),$ we write down the function $f$ and replace every occurrence of $x$ with $f(x):$\n\n$$\n\\begin{aligned}f(x) & =2{x}^{2}-1 \\\\ f(f(x)) & =2(f(x))^{2}-1\\end{aligned}\n$$\n\nThen, we substitute $f(x)=2{x}^{2}-1$ into the right-hand side of the above and simplify, as follows:\n\n$$\n\\begin{aligned}f(f(x)) & =2(f(x))^{2}-1 \\\\  & =2(2{x}^{2}-1)^{2}-1 \\\\  & =2(4{x}^{4}-4{x}^{2}+1)-1 \\\\  & =8{x}^{4}-8{x}^{2}+1\\end{aligned}\n$$\n\nTherefore, $(f∘f)(x)=8{x}^{4}-8{x}^{2}+1.$"}] [{:db/id #edb/ref 17592186543586 :knowledge-point/_questions [{:db/id #edb/ref 17592186184342 :knowledge-point/id #uuid "9dd4252e-6408-5e03-828f-d3d94cccaa7c" :knowledge-point/title "Evaluating a Function With a Variable Input"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11b1c1bf-2a67-5c91-92bc-0b92c34f4a40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{2}+2a+4" :db/id #edb/ref 17592186542682} {:answer/id #uuid "4ccd54ce-a52c-5b42-898c-f9760ff781cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{2}+2a-1" :db/id #edb/ref 17592186542849} {:answer/id #uuid "688799a2-d61c-5052-a6f0-07ce3472dfbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{2}+2a+1" :db/id #edb/ref 17592186542921} {:answer/id #uuid "76a0b15e-8792-5dad-8f77-92d2f58c48fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{a}^{2}+2a+1" :db/id #edb/ref 17592186542954} {:answer/id #uuid "c1970721-3576-5dbe-b614-e6262fbf4c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{2}-2a+1" :db/id #edb/ref 17592186543146}] :answer-field/correct {:answer/id #uuid "c1970721-3576-5dbe-b614-e6262fbf4c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{2}-2a+1" :db/id #edb/ref 17592186543146} :answer-field/id #uuid "358c69cd-3ebc-5d97-9a9d-cdbfb1e80a78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543324}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "efcb8d92-e0fd-53fd-9869-69a86351884a" :question/math-academy-id "q-3900" :question/problem "Evaluate $f(x)={x}^{2}-6x+9$ at $x=a+2.$" :question/worked-solution "To find $f(a+2),$ we write down the function $f$ and replace every occurrence of $x$ with $(a+2):$\n\n$$\n\\begin{aligned}f(x) & ={x}^{2}-6x+9 \\\\ f(a+2) & =(a+2)^{2}-6(a+2)+9\\end{aligned}\n$$\n\nThen, we simplify as follows:\n\n$$\n\\begin{aligned}f(a+2) & =(a+2)^{2}-6(a+2)+9 \\\\  & =(a+2)(a+2)-6a-12+9 \\\\  & ={a}^{2}+2a+2a+4-6a-3 \\\\  & ={a}^{2}-2a+1\\end{aligned}\n$$\n\nTherefore, $f(a+2)={a}^{2}-2a+1.$"}] [{:db/id #edb/ref 17592186543575 :knowledge-point/_questions [{:db/id #edb/ref 17592186184342 :knowledge-point/id #uuid "9dd4252e-6408-5e03-828f-d3d94cccaa7c" :knowledge-point/title "Evaluating a Function With a Variable Input"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32a224a7-1eb4-5777-a6ac-6be22859d307" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{p}^{2}+4p-5" :db/id #edb/ref 17592186542776} {:answer/id #uuid "4a7f8e06-5a54-5672-ba21-201d8162c811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{p}^{2}-6" :db/id #edb/ref 17592186542845} {:answer/id #uuid "7cd5aebb-db28-53c1-8e40-925f6096e6ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{p}^{2}+2p-6" :db/id #edb/ref 17592186542976} {:answer/id #uuid "b514765d-7d04-5bf6-bca0-72cd46f1cbb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{p}^{2}-8p-6" :db/id #edb/ref 17592186543110} {:answer/id #uuid "dda5c6a8-dd5c-5cd9-87ed-9811dc416ce7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{p}^{2}-4p-5" :db/id #edb/ref 17592186543204}] :answer-field/correct {:answer/id #uuid "4a7f8e06-5a54-5672-ba21-201d8162c811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{p}^{2}-6" :db/id #edb/ref 17592186542845} :answer-field/id #uuid "515fa882-da2b-53bc-a0ac-98c42e8cebf3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543340}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5a43bfc-062d-59bd-8636-9805b214ca53" :question/math-academy-id "q-66446" :question/problem "If $f(x)={x}^{2}+2x-5$, then $f(2p-1)=$" :question/worked-solution "To find $f(2p-1),$ we write down the function $f$ and replace every occurrence of $x$ with $(2p-1):$\n\n$$\n\\begin{aligned}f(x) & ={x}^{2}+2x-5 \\\\ f(2p-1) & =(2p-1)^{2}+2(2p-1)-5\\end{aligned}\n$$\n\nThen, we simplify as follows:\n\n$$\n\\begin{aligned}f(2p-1) & =(2p-1)^{2}+2(2p-1)-5 \\\\  & =(2p-1)(2p-1)+4p-2-5 \\\\  & =4{p}^{2}-2p-2p+1+4p-7 \\\\  & =4{p}^{2}-6\\end{aligned}\n$$\n\nTherefore, $f(2p-1)=4{p}^{2}-6.$"}]}
