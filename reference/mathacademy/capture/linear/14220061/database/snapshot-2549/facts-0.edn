 17592186045417] [17592186253083 #edb/ref 1078 #edb/ref 17592186251051 #edb/ref 17592186045417] [17592186253083 #edb/ref 1079 #uuid "9e5e003f-a698-53ab-98d2-6521927c967e" #edb/ref 17592186045417] [17592186253221 #edb/ref 1075 #edb/ref 17592186251461 #edb/ref 17592186045417] [17592186253221 #edb/ref 1075 #edb/ref 17592186251635 #edb/ref 17592186045417] [17592186253221 #edb/ref 1075 #edb/ref 17592186251702 #edb/ref 17592186045417] [17592186253221 #edb/ref 1075 #edb/ref 17592186252570 #edb/ref 17592186045417] [17592186253221 #edb/ref 1075 #edb/ref 17592186252681 #edb/ref 17592186045417] [17592186253221 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186253221 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186253221 #edb/ref 1078 #edb/ref 17592186252570 #edb/ref 17592186045417] [17592186253221 #edb/ref 1079 #uuid "ef01d8ee-239f-5582-826d-a723a4095517" #edb/ref 17592186045417] [17592186253395 #edb/ref 1068 #edb/ref 17592186253221 #edb/ref 17592186045417] [17592186253395 #edb/ref 1069 "q-117687" #edb/ref 17592186045417] [17592186253395 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186253395 #edb/ref 1071 "Solve the equation $\\frac{3}{m+4}+\\frac{1}{m-3}=\\frac{3}{{m}^{2}+m-12}.$" #edb/ref 17592186045417] [17592186253395 #edb/ref 1072 #uuid "237cb996-b5fc-51c0-b848-df3a338c9048" #edb/ref 17592186045417] [17592186253395 #edb/ref 1074 "First, we factor the quadratic denominator, giving us the equation\n\n$$\n\\frac{3}{m+4}+\\frac{1}{m-3}=\\frac{3}{(m+4)(m-3)}.\n$$\n\nWe now make the following observations:\n\n- The least common denominator of our equation is given by\n\n$$\n\\text{LCM}(m+4,\\,m-3,\\,(m+4)(m-3))=(m+4)(m-3).\n$$\n\n- The values $m=-4$ and $m=3$ cannot be solutions to our equation. These values make at least one denominator in our original equation equal zero, and division by zero is undefined.\n\nNow, multiplying both sides of the equation by the least common denominator, we can simplify it as follows:\n\n$$\n\\begin{aligned}\\frac{3}{m+4}+\\frac{1}{m-3} & =\\frac{3}{(m+4)(m-3)} \\\\ (m+4)(m-3)\\cdot (\\frac{3}{m+4}+\\frac{1}{m-3}) & =(m+4)(m-3)\\cdot \\frac{3}{(m+4)(m-3)} \\\\ \\frac{3(m+4)(m-3)}{m+4}+\\frac{(m+4)(m-3)}{m-3} & =\\frac{3(m+4)(m-3)}{(m+4)(m-3)} \\\\ \\frac{3\\cancel{(m+4)}(m-3)}{\\cancel{m+4}}+\\frac{(m+4)\\cancel{(m-3)}}{\\cancel{m-3}} & =\\frac{3\\cancel{(m+4)(m-3)}}{\\cancel{(m+4)(m-3)}} \\\\ 3(m-3)+(m+4) & =3\\end{aligned}\n$$\n\nSolving this equation for $m,$ we get the following:\n\n$$\n\\begin{aligned}3(m-3)+(m+4) & =3 \\\\ 4m-5 & =3 \\\\ 4m & =8 \\\\ m & =2\\end{aligned}\n$$\n\nSince $2\\ne -4$ and $2\\ne 3,$ we conclude that $m=2$ is a valid solution. \n\nTherefore, the solution to our original equation is $m=2.$" #edb/ref 17592186045417] [17592186253457 #edb/ref 1068 #edb/ref 17592186252997 #edb/ref 17592186045417] [17592186253457 #edb/ref 1069 "q-118117" #edb/ref 17592186045417] [17592186253457 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186253457 #edb/ref 1071 "Solve the equation $\\frac{6}{v+4}+\\frac{12}{{v}^{2}+4v}=\\frac{3}{v}.$" #edb/ref 17592186045417] [17592186253457 #edb/ref 1072 #uuid "686ef7d4-296f-572a-a3ca-d6455dccd76c" #edb/ref 17592186045417] [17592186253457 #edb/ref 1074 "First, we factor the quadratic denominator, giving us the equation\n\n$$\n\\frac{6}{v+4}+\\frac{12}{v(v+4)}=\\frac{3}{v}.\n$$\n\nWe now make the following observations:\n\n- The least common denominator of our equation is given by\n\n$$\n\\text{LCM}(v+4,\\,v(v+4),\\,v)=v(v+4).\n$$\n\n- The values $v=0$ and $v=-4$ cannot be solutions to our equation. These values make at least one denominator in our original equation equal zero, and division by zero is undefined.\n\nNow, multiplying both sides of the equation by the least common denominator, we can simplify it as follows:\n\n$$\n\\begin{aligned}\\frac{6}{v+4}+\\frac{12}{v(v+4)} & =\\frac{3}{v} \\\\ v(v+4)\\cdot (\\frac{6}{v+4}+\\frac{12}{v(v+4)}) & =v(v+4)\\cdot \\frac{3}{v} \\\\ \\frac{6v(v+4)}{v+4}+\\frac{12v(v+4)}{v(v+4)} & =\\frac{3v(v+4)}{v} \\\\ \\frac{6v\\cdot \\cancel{(v+4)}}{\\cancel{v+4}}+\\frac{12\\cdot \\cancel{v(v+4)}}{\\cancel{v(v+4)}} & =\\frac{3\\cdot \\cancel{v}\\cdot (v+4)}{\\cancel{v}} \\\\ 6v+12 & =3(v+4)\\end{aligned}\n$$\n\nSolving this equation for $v,$ we get the following:\n\n$$\n\\begin{aligned}6v+12 & =3(v+4) \\\\ 6v+12 & =3v+12 \\\\ 3v & =0 \\\\ v & =0\\end{aligned}\n$$\n\nHowever, since $v=0$  is not a valid solution, our equation has no solutions." #edb/ref 17592186045417] [17592186253459 #edb/ref 1068 #edb/ref 17592186253083 #edb/ref 17592186045417] [17592186253459 #edb/ref 1069 "q-118123" #edb/ref 17592186045417] [17592186253459 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186253459 #edb/ref 1071 "Solve the equation $\\frac{5}{z-1}-\\frac{5}{{z}^{2}-z}=\\frac{1}{2z}.$" #edb/ref 17592186045417] [17592186253459 #edb/ref 1072 #uuid "d3e07973-1de0-5078-b548-53734ee05751" #edb/ref 17592186045417] [17592186253459 #edb/ref 1074 "First, we factor the quadratic denominator, giving us the equation\n\n$$\n\\frac{5}{z-1}-\\frac{5}{z(z-1)}=\\frac{1}{2z}.\n$$\n\nWe make the following observations:\n\n- The least common denominator of our equation is given by\n\n$$\n\\text{LCM}(z-1,\\,2z,\\,z(z-1))=2z(z-1).\n$$\n\n- The values $z=0$ and $z=1$ cannot be solutions to our equation. These values make at least one denominator in our original equation equal zero, and division by zero is undefined.\n\nNow, multiplying both sides of the equation by the least common denominator, we can simplify it as follows:\n\n$$\n\\begin{aligned}\\frac{5}{z-1}-\\frac{5}{z(z-1)} & =\\frac{1}{2z} \\\\ 2z(z-1)\\cdot (\\frac{5}{z-1}-\\frac{5}{z(z-1)}) & =2z(z-1)\\cdot \\frac{1}{2z} \\\\ \\frac{10z(z-1)}{z-1}-\\frac{10z(z-1)}{z(z-1)} & =\\frac{2z(z-1)}{2z} \\\\ \\frac{10z\\cdot \\cancel{(z-1)}}{\\cancel{z-1}}-\\frac{10\\cdot \\cancel{z(z-1)}}{\\cancel{z(z-1)}} & =\\frac{\\cancel{2z}\\cdot (z-1)}{\\cancel{2z}} \\\\ 10z-10 & =z-1\\end{aligned}\n$$\n\nSolving this equation for $z,$ we get the following:\n\n$$\n\\begin{aligned}10z-10 & =z-1 \\\\ 9z & =9 \\\\ z & =1\\end{aligned}\n$$\n\nHowever, since $z=1$ is not a valid solution, our equation has no solutions." #edb/ref 17592186045417] [17592186291466 #edb/ref 1080 "13" #edb/ref 17592186045417] [17592186291466 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186291466 #edb/ref 1083 #uuid "c24c8638-bc45-58d8-92ca-8e5999196644" #edb/ref 17592186045417] [17592186291805 #edb/ref 1075 #edb/ref 17592186291466 #edb/ref 17592186045417] [17592186291805 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186291805 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186291805 #edb/ref 1078 #edb/ref 17592186291466 #edb/ref 17592186045417] [17592186291805 #edb/ref 1079 #uuid "13cc09e6-8210-5c2c-84d3-0adddb80ebe7" #edb/ref 17592186045417] [17592186292936 #edb/ref 1068 #edb/ref 17592186291805 #edb/ref 17592186045417] [17592186292936 #edb/ref 1069 "q-276459" #edb/ref 17592186045417] [17592186292936 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186292936 #edb/ref 1071 "Solve the equation $\\frac{3}{n+4}-\\frac{5}{n(n+4)}=\\frac{2}{n}.$\n\n$n=$\n{{field-1}}" #edb/ref 17592186045417] [17592186292936 #edb/ref 1072 #uuid "5052ef42-8b3c-5bc4-ad50-88c2f81dda82" #edb/ref 17592186045417] [17592186292936 #edb/ref 1074 "We make the following observations:\n\n- The least common denominator of our equation is given by\n\n$$\n\\text{LCM}(n+4,\\,n(n+4),\\,n)=n(n+4).\n$$\n\n- The values $n=-4$ and $n=0$ cannot be solutions to our equation. These values make at least one denominator in our original equation equal zero, and division by zero is undefined.\n\nNow, multiplying both sides of the equation by the least common denominator, we can simplify it as follows:\n\n$$\n\\begin{aligned}\\frac{3}{n+4}-\\frac{5}{n(n+4)} & =\\frac{2}{n} \\\\ n(n+4)\\cdot (\\frac{3}{n+4}-\\frac{5}{n(n+4)}) & =n(n+4)\\cdot \\frac{2}{n} \\\\ \\frac{3n(n+4)}{n+4}-\\frac{5n(n+4)}{n(n+4)} & =\\frac{2n(n+4)}{n} \\\\ \\frac{3n\\cdot \\cancel{(n+4)}}{\\cancel{n+4}}-\\frac{5\\cdot \\cancel{n(n+4)}}{\\cancel{n(n+4)}} & =\\frac{2\\cdot \\cancel{n}\\cdot (n+4)}{\\cancel{n}} \\\\ 3n-5 & =2(n+4)\\end{aligned}\n$$\n\nSolving this equation for $n,$ we get the following:\n\n$$\n\\begin{aligned}3n-5 & =2(n+4) \\\\ 3n-5 & =2n+8 \\\\ n & =13\\end{aligned}\n$$\n\nSince $13\\ne 0$ and $13\\ne -4,$ we conclude that $n=13$ is a valid solution.\n\nTherefore, the solution to our original equation is $n=13.$" #edb/ref 17592186045417] [17592186360933 #edb/ref 1080 "w=-1" #edb/ref 17592186045417] [17592186360933 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186360933 #edb/ref 1083 #uuid "17043857-3227-572b-b4b7-6ed400421ab4" #edb/ref 17592186045417] [17592186361079 #edb/ref 1080 "w=-3" #edb/ref 17592186045417] [17592186361079 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186361079 #edb/ref 1083 #uuid "35f1c23e-4f90-5bc5-a18f-a8492ea035e1" #edb/ref 17592186045417] [17592186361351 #edb/ref 1080 "No solutions" #edb/ref 17592186045417] [17592186361351 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186361351 #edb/ref 1083 #uuid "74d18717-fb29-5681-a346-e6ed7697370a" #edb/ref 17592186045417] [17592186361471 #edb/ref 1080 "w=1" #edb/ref 17592186045417] [17592186361471 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186361471 #edb/ref 1083 #uuid "8ec7f463-3427-592f-90f0-c6c4b74d7bc7" #edb/ref 17592186045417] [17592186361927 #edb/ref 1080 "w=0" #edb/ref 17592186045417] [17592186361927 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186361927 #edb/ref 1083 #uuid "f3bae244-6b93-50b4-a686-78c3894fb2f8" #edb/ref 17592186045417] [17592186362136 #edb/ref 1075 #edb/ref 17592186360933 #edb/ref 17592186045417] [17592186362136 #edb/ref 1075 #edb/ref 17592186361079 #edb/ref 17592186045417] [17592186362136 #edb/ref 1075 #edb/ref 1759218636