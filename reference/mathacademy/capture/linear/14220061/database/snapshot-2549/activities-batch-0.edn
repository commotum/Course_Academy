o our original equation is ![](images/09/0981bec86ce7424eb7dabbaa3827cc7591360dc24997730f3773c002f72a673b.svg)" :tutorial/id #uuid "bbec5a32-ab56-51ba-8362-e120d00857da" :tutorial/math-academy-id 5712 :tutorial/title "Introduction"} :step/id #uuid "8ead11f6-987c-50c1-8754-c7518e6c4b62" :step/math-academy-id 35079 :step/next {:db/id #edb/ref 17592186084286}}] :activity/title "Advanced Rational Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083412}]}
