class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c1D464 TEX-I\"></mjx-c></mjx-mi><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"1.3em 1.3em 1.3em 1.3em 1.3em\"><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mi>w</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mrow><mi>w</mi><mo stretchy=\"false\">(</mo><mi>w</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mi>w</mi><mo>−</mo><mn>3</mn></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>w</mi><mo stretchy=\"false\">(</mo><mi>w</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mi>w</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mrow><mi>w</mi><mo stretchy=\"false\">(</mo><mi>w</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd><mtd><mi></mi><mo>=</mo><mi>w</mi><mo stretchy=\"false\">(</mo><mi>w</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mi>w</mi><mo>−</mo><mn>3</mn></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>2</mn><mi>w</mi><mo stretchy=\"false\">(</mo><mi>w</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mrow><mi>w</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>3</mn><mi>w</mi><mo stretchy=\"false\">(</mo><mi>w</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mi>w</mi><mo stretchy=\"false\">(</mo><mi>w</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>w</mi><mo stretchy=\"false\">(</mo><mi>w</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mi>w</mi><mo>−</mo><mn>3</mn></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>2</mn><mo>⋅</mo><menclose notation=\"updiagonalstrike\"><mi>w</mi></menclose><mo stretchy=\"false\">(</mo><mi>w</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mrow><menclose notation=\"updiagonalstrike\"><mi>w</mi></menclose></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>3</mn><mo>⋅</mo><menclose notation=\"updiagonalstrike\"><mi>w</mi><mo stretchy=\"false\">(</mo><mi>w</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></menclose></mrow><menclose notation=\"updiagonalstrike\"><mi>w</mi><mo stretchy=\"false\">(</mo><mi>w</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></menclose></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>w</mi><mo>⋅</mo><menclose notation=\"updiagonalstrike\"><mo stretchy=\"false\">(</mo><mi>w</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></menclose></mrow><menclose notation=\"updiagonalstrike\"><mi>w</mi><mo>−</mo><mn>3</mn></menclose></mfrac></mstyle></mtd></mtr><mtr><mtd><mn>2</mn><mi>w</mi><mo>−</mo><mn>6</mn><mo>+</mo><mn>3</mn></mtd><mtd><mi></mi><mo>=</mo><mi>w</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Solving this equation for <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"18\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D464 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>w</mi><mo>,</mo></math></mjx-assistive-mml></mjx-container> we get the following:\n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"19\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 6.71em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D464 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-bottom: 0.4em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c1D464 TEX-I\"></mjx-c></mjx-mi><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-top: 0.4em;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D464 TEX-I\"></mjx-c></mjx-mi><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-top: 0.4em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.3em\"><mtr><mtd><mn>2</mn><mi>w</mi><mo>−</mo><mn>6</mn><mo>+</mo><mn>3</mn></mtd><mtd><mi></mi><mo>=</mo><mi>w</mi></mtd></mtr><mtr><mtd><mi>w</mi></mtd><mtd><mi></mi><mo>=</mo><mn>3</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>However, since <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"20\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D464 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>w</mi><mo>=</mo><mn>3</mn></math></mjx-assistive-mml></mjx-container>  is not a valid solution, our equation has no solutions.</p>\n</div></div>",
