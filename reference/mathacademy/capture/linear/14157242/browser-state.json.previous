      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14157242/observations/step-4-e7994c88407353a08c32.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14157242/observations/step-4-e7994c88407353a08c32.png",
      "source_url": "https://mathacademy.com/tasks/14157242/multisteps/1231",
      "captured_at": 1791862836.6593928,
