          "input_html": "<div class=\"matheditor-wrapper-answer\" style=\"min-width: 40px; margin-left: 5px; margin-right: 5px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"5\"><var mathquill-command-id=\"29\">x</var><span mathquill-command-id=\"31\" class=\"mq-binary-operator\">+</span><span mathquill-command-id=\"33\">5</span></span></div></div>",
          "rendered_text": "x+5",
