63} {:answer/id #uuid "f9df7a6a-2bf6-55ee-9e50-cffb838757e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186517959}] :answer-field/correct {:db/id #edb/ref 17592186517863} :answer-field/id #uuid "260e99a3-e5e1-53cf-915e-ef78d3294c9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186517988}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8c4f25cf-0173-54ec-98c6-ab10b632fa9a" :question/math-academy-id "q-60256" :question/problem "![](images/06/06931fae92045635d523614dce24063856209b1f04987471b9de183a3ccce4a2.png)\n\nIf the ratio of rhombuses to total shapes is $\\frac{3}{\\boxed{}}$ then what is the missing number?" :question/worked-solution "We count the number of rhombuses. We see that there are $3$ rhombuses.\n\n We count the total number of shapes. We see that there are $7$ shapes.\n\nHence, the ratio of circles to triangles is$\\frac{3}{7}$\n\nSo the missing number is $7.$"} :step/id #uuid "4104b582-02c9-5a3d-a68c-63888ab13e51"} {:db/id #edb/ref 17592186518261 :step/content {:db/id #edb/ref 17592186518223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42896cb7-0d0b-54cc-969c-bb0fda2c6508" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186517618} {:answer/id #uuid "6cced7a0-4aa3-52bc-9f11-947258d1a3be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$13$ and $4$" :db/id #edb/ref 17592186517693} {:answer/id #uuid "7ac161ed-1d7c-54b3-a3a8-e7718d81f9d9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $13$" :db/id #edb/ref 17592186517722} {:answer/id #uuid "80b5563d-a832-5f85-beb1-f5023beb53ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $9$" :db/id #edb/ref 17592186517732} {:answer/id #uuid "ef6e0e18-3319-51dc-bd29-cc144c970a2a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $9$" :db/id #edb/ref 17592186517946}] :answer-field/correct {:db/id #edb/ref 17592186517732} :answer-field/id #uuid "adf5e13e-d3c5-59f6-8423-d12c85673faf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518051}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fed5c231-48f8-530b-a66d-407d2c45633b" :question/math-academy-id "q-60250" :question/problem "From left to right, what are the missing numbers in the following sentence?\n\nA student makes a mixture having $\\frac{4}{9}$ grams of ginger for each gram of glucose to make his own energy drink. Therefore, the energy drink has a ratio of $\\boxed{}$ grams of ginger to $\\boxed{}$ grams of glucose." :question/worked-solution "Let's rewrite the fraction $\\frac{4}{9}$ as a ratio:\n\n$$\n4:9\n$$\n\nTherefore, the energy drink has a ratio of $4$ grams of ginger to $9$ grams of glucose."} :step/id #uuid "73d398fa-e284-584b-af53-0ec2a7adc313" :step/next {:db/id #edb/ref 17592186518247}}] :activity/title "Writing Ratios Using Fractions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186517482}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055836} :activity/id #uuid "c871a154-cf68-51db-83a7-946dca52e14d" :activity/scope {:db/id #edb/ref 17592186050517 :topic/id #uuid "50123c1c-7113-541e-8c4f-047f2eec416d" :topic/math-academy-id 92} :activity/steps [{:db/id #edb/ref 17592186055836 :step/content {:db/id #edb/ref 17592186055942 :tutorial/content "The **Cartesian coordinate system** (or **Cartesian plane**) is a grid that we can use to understand where certain objects lie, similar to a map. This grid looks as follows:\n\n![](images/fd/fd702a53ff1127a2432cbdd9a3c7057a08c73ac7a086454c066fa2c96bea7974.png)\n\nIt consists of a horizontal number line called the **$x$-axis** and a vertical number line called the **$y$-axis**.\n\nThe **origin** is the location where the $x$ and $y$ axes meet and is given the symbol $O.$" :tutorial/id #uuid "dacc8373-6186-517b-bba8-ec1729732e4d" :tutorial/math-academy-id 1431 :tutorial/title "Introduction"} :step/id #uuid "5cca38c5-c625-5a28-92d3-ccdcc09f108d" :step/math-academy-id 607419 :step/next {:db/id #edb/ref 17592186055837}} {:db/id #edb/ref 17592186055837 :step/content {:db/id #edb/ref 17592186055943 :tutorial/content "Every location on the Cartesian plane is called a **point**. Every point is identified using an $x$**-coordinate** and a $y$**-coordinate**. Together, points are expressed using an **ordered pair** of **coordinates** $(x,y).$\n\nFor example, we can mark (or **plot**) the point $A$ with coordinates $({\\color{red}{3}},{\\color{blue}{2}})$ by starting from $O$ and then traveling $\\color{red}3$ units towards the right, followed $\\color{blue}2$ units up.\n\n![](images/c1/c1ef61dedbbcc6eedcd125c2c62cdfbaa4d9b9a12f10181714b51c060a059fd3.png)\n\nWe say that\n\n- the $x$-coordinate of $A$ is $3$,\n\n- the $y$-coordinate of $A$ is $2$,\n\n- the $xy$-coordinates (or just \"the coordinates\") of $A$ are $(3,2).$\n\nThe letter $A$ is just a label for our point. It's usually a good idea to label points!" :tutorial/id #uuid "9e7847c5-757a-5cb8-b947-9c7d806b5dc5" :tutorial/math-academy-id 1432 :tutorial/title "Coordinates and Ordered Pairs"} :step/id #uuid "b81ec1ae-2147-51bf-abd0-42837ec9335a" :step/math-academy-id 607420 :step/next {:db/id #edb/ref 17592186055838}} {:db/id #edb/ref 17592186055838 :step/content {:db/id #edb/ref 17592186055957 :tutorial/content "Remember that a coordinate plane is made by two number lines that meet at $0.$ Since these are number lines, we can extend both to include negative numbers.\n\n![](images/f1/f1eeb7f3bc0ab8b39e9dc7127d76a32f1dd130d380748fedc6e11b967f3878ed.png)\n\nWe plot an ordered pair $({\\color{red}x},{\\color{blue}y})$ similar to before, but if the number is negative, we reverse the direction. So, starting at the origin:\n\n- if the first number is positive, move that number of places *right* along the $\\color{red}x$-axis. If its negative, move *left*.\n\n- if the second number is positive, move that number of places *up* along the $\\color{blue}y$-axis. If its negative, move *down*.\n\nTo demonstrate, let's find the coordinates of the point $Q$ above.\n\nTo find the coordinates of $Q,$ we start at the origin, move $\\color{red}3$ units *left*, and then $\\color{blue}2$ units *down*. \n\n![](images/b4/b4f58f0c1ad6dc2936ed1b24c844fa82c1b1d5ec10c80e14c6a43f6f4eaf5544.png)\n\nSince we move left, the $\\color{red}x$-coordinate is negative, and since we move down, the $\\color{blue}y$-coordinate is negative.\n\nTherefore, the coordinates of $Q$ are $({\\color{red}{-3}},{\\color{blue}{-2}}).$" :tutorial/id #uuid "7383452c-9470-5f05-b206-dffbb84808dd" :tutorial/math-academy-id 2092 :tutorial/title "Extending the Coordinate Plane to Negative Numbers"} :step/id #uuid "a86683d5-cc60-54e3-a1ca-8ddc210beec5" :step/math-academy-id 607421 :step/next {:db/id #edb/ref 17592186055839}} {:db/id #edb/ref 17592186055839 :step/content {:db/id #edb/ref 17592186054806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054511 :question/id #uuid "e4658959-f2fb-5bb4-ad05-d75b7c74a5d5" :question/math-academy-id "e-2372"} :knowledge-point/id #uuid "f41c2f3b-9b55-5f32-bb0a-a8397cdf66ce" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049429} {:db/id #edb/ref 17592186049884} {:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186055434} {:db/id #edb/ref 17592186055439} {:db/id #edb/ref 17592186426965} {:db/id #edb/ref 17592186426966} {:db/id #edb/ref 17592186426971} {:db/id #edb/ref 17592186426978}] :knowledge-point/title "Determining the X- or Y-Coordinate of a Point in the Coordinate Plane"} :step/id #uuid "708e4952-07a2-52aa-83ee-e86a33ffcc1d" :step/math-academy-id 607422 :step/next {:db/id #edb/ref 17592186055840}} {:db/id #edb/ref 17592186055840 :step/content {:db/id #edb/ref 17592186054807 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054598 :question/id #uuid "bda7aaff-f03f-53bd-b114-d28a46599641" :question/math-academy-id "e-975"} :knowledge-point/id #uuid "b509b42a-c38a-5400-8f93-f3e9024b16a2" :knowledge-point/questions [{:db/id #edb/ref 17592186055411} {:db/id #edb/ref 17592186055435} {:db/id #edb/ref 17592186235487} {:db/id #edb/ref 17592186426968} {:db/id #edb/ref 17592186426970} {:db/id #edb/ref 17592186426973} {:db/id #edb/ref 17592186426976} {:db/id #edb/ref 17592186426977} {:db/id #edb/ref 17592186486370} {:db/id #edb/ref 17592186486437} {:db/id #edb/ref 17592186510413}] :knowledge-point/title "Identifying the Coordinates of a Point"} :step/id #uuid "b4fa400d-ccbf-5b93-8bb2-f08b681dc5d0" :step/math-academy-id 607425 :step/next {:db/id #edb/ref 17592186055841}} {:db/id #edb/ref 17592186055841 :step/content {:db/id #edb/ref 17592186054808 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054597 :question/id #uuid "f610b8b9-8e9e-5a64-bc52-c1f939a0f147" :question/math-academy-id "e-974"} :knowledge-point/id #uuid "e5418e0e-fff7-5d08-b915-6e87be27a132" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049429} {:db/id #edb/ref 17592186049884} {:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186055120} {:db/id #edb/ref 17592186055436} {:db/id #edb/ref 17592186426969} {:db/id #edb/ref 17592186426972} {:db/id #edb/ref 17592186426979} {:db/id #edb/ref 17592186426980} {:db/id #edb/ref 17592186486380} {:db/id #edb/ref 17592186515549} {:db/id #edb/ref 17592186518189}] :knowledge-point/title "Plotting a Point in the Coordinate Plane"} :step/id #uuid "b5dc0ae8-3ca8-53a2-a100-962fd53b4781" :step/math-academy-id 607428 :step/next {:db/id #edb/ref 17592186055842}} {:db/id #edb/ref 17592186055842 :step/content {:db/id #edb/ref 17592186055958 :tutorial/content "The axes split the coordinate plane into four parts, called **quadrants**.\n\n![](images/93/938125e855fcb96f743c01f2a00d289ef13e0601772bab56cf0f255e9adf4dcd.png)\n\nGoing counter-clockwise, it's common to call\n\n- the top-right quadrant the first quadrant (I),\n\n- the top-left is the second quadrant (II),\n\n- the bottom-left is the third quadrant (III),\n\n- and and bottom-right is the fourth quadrant (IV).\n\nTo remember the order of the quadrants, it's helpful to think about writing the letter \"C\" in the graph:\n\n![](images/1e/1ef91f2bc25ea8b887ec449d2dafe2eaf6a157733e7bc50e4480280df8190728.png)" :tutorial/id #uuid "8a1e27dd-9f87-5adf-b0c6-f0f6cd7e2aac" :tutorial/math-academy-id 2097 :tutorial/title "Quadrants in the Coordinate Plane"} :step/id #uuid "3caa8c6c-0602-56f3-a037-3db5c98ff22b" :step/math-academy-id 607431 :step/next {:db/id #edb/ref 17592186055843}} {:db/id #edb/ref 17592186055843 :step/content {:db/id #edb/ref 17592186054809 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054599 :question/id #uuid "419738bb-56e5-52db-aa34-42ccd945fe64" :question/math-academy-id "e-977"} :knowledge-point/id #uuid "7fcec0d8-ca03-5446-a42f-65d0ccddd584" :knowledge-point/questions [{:db/id #edb/ref 17592186055278} {:db/id #edb/ref 17592186055437} {:db/id #edb/ref 17592186424815} {:db/id #edb/ref 17592186426967} {:db/id #edb/ref 17592186426974} {:db/id #edb/ref 17592186426975} {:db/id #edb/ref 17592186426981} {:db/id #edb/ref 17592186486375}] :knowledge-point/title "Identifying the Quadrant of a Given Point"} :step/id #uuid "e7a9127a-071f-5089-a135-f41568b6862d" :step/math-academy-id 607432}] :activity/title "The Cartesian Coordinate System" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054933}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186486467} :activity/id #uuid "2ee8e36f-d6f2-535a-b7e8-f2094eda05e2" :activity/scope {:db/id #edb/ref 17592186050517 :topic/id #uuid "50123c1c-7113-541e-8c4f-047f2eec416d" :topic/math-academy-id 92} :activity/steps [{:db/id #edb/ref 17592186486467 :step/content {:db/id #edb/ref 17592186486370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e2f253f-f36a-560f-9ec1-161de7ca2936" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-3,-6)" :db/id #edb/ref 17592186485790} {:answer/id #uuid "5b907c20-fdab-5148-9850-5b4dac59cbfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,6)" :db/id #edb/ref 17592186485926} {:answer/id #uuid "8ea93a26-50f7-53a6-b9a0-fc301c2fc49b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,-6)" :db/id #edb/ref 17592186486020} {:answer/id #uuid "bf3c4744-55c7-5126-a9e5-deeb937ce8ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,-6)" :db/id #edb/ref 17592186486108} {:answer/id #uuid "fc37df37-6bf2-589e-b9c3-27692a226298" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,-6)" :db/id #edb/ref 17592186486222}] :answer-field/correct {:db/id #edb/ref 17592186486222} :answer-field/id #uuid "6156ddb1-eb69-58fb-ade4-f35c95453cbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486277}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "33922fa7-9cd5-5240-b5a7-6b856c2f3900" :question/math-academy-id "q-12475" :question/problem "![](images/a3/a3e52270e83d29fe4d53f1429a6648c6ef2451ae5ad5b3d48dd0d1a0f3450df4.png)\n\nWhat are the $xy$-coordinates of the point shown in the axes above?" :question/worked-solution "To find the coordinates of the point, we inspect its position along the $x$ and $y$ axes.\n\nThe point is $3$ units to the right of the origin, in the positive direction of the $x$-axis. So, the point has an $x$-coordinate of $3.$\n\nAdditionally, the point is $6$ units *below* the origin, in the *negative* direction of the $y$-axis. So, the point has a $y$-coordinate of $-6.$\n\nThe point has an $x$-coordinate of $3$ and a $y$-coordinate of $-6,$ so its coordinates are $(3,-6).$"} :step/id #uuid "146a565d-dffc-5e6c-b79e-319aeeb7bc4d" :step/next {:db/id #edb/ref 17592186486486}} {:db/id #edb/ref 17592186486475 :step/content {:db/id #edb/ref 17592186486437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "649b626b-4386-5c00-bdcf-5dd4938d9112" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,1)" :db/id #edb/ref 17592186485937} {:answer/id #uuid "80ab4c5e-aff9-5dde-a021-093b6b9ddbd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-4,1)" :db/id #edb/ref 17592186485991} {:answer/id #uuid "a9b54552-5965-5854-ba07-c60932f774a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,4)" :db/id #edb/ref 17592186486071} {:answer/id #uuid "c5fcd194-a407-59cf-ae7a-2e21427fcdca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,4)" :db/id #edb/ref 17592186486120} {:answer/id #uuid "dfb98379-8815-506f-a548-b96dd7aea567" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,-4)" :db/id #edb/ref 17592186486174}] :answer-field/correct {:db/id #edb/ref 17592186486071} :answer-field/id #uuid "d0b079f8-570c-5a56-a881-00ac494144c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486321}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c5cd4da4-bcde-5c76-b987-99fb9414b223" :question/math-academy-id "q-93510" :question/problem "![](images/53/53e86e59af40ecd611ad1f7753f4780b692f17afc5a81709ea1c249a0bf011d5.png)\n\nWhat are the coordinates of the point $A?$" :question/worked-solution "To find the coordinates of the point $A,$ we start at the origin, move $1$ unit *left* and then $4$ units *up*. \n\n![](images/14/147aa8c644b24f82abadbbb9362ed51718bf94da992c83d016c72a1898032f0f.png)\n\nThe $x$-coordinate of $A$ is $-1,$ the $y$-coordinate is $4,$ and coordinates are given by the ordered pair $(-1,4).$"} :step/id #uuid "3f07956a-6431-5516-8d25-2cc6c4d55a33"} {:db/id #edb/ref 17592186486486 :step/content {:db/id #edb/ref 17592186486375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d8031f-5e2f-5683-84c6-7fe7232955e3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "All" :db/id #edb/ref 17592186485807} {:answer/id #uuid "19d86bf2-74f3-5d7b-a43c-1012785c8707" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186485812} {:answer/id #uuid "41bd2118-a5bb-5da1-8bdd-da8970f09208" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186485890} {:answer/id #uuid "79aeb305-a976-5e19-9df6-af6e17665886" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186485978} {:answer/id #uuid "7dae032f-a2cf-5841-bfb4-ef99e0c6b32f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186485985}] :answer-field/correct {:db/id #edb/ref 17592186485985} :answer-field/id #uuid "db8b3ac8-d583-5e07-b501-9df170f999c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486331}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3b6bba67-98a0-5af4-b6c0-e0b46329b1b5" :question/math-academy-id "q-61365" :question/problem "![](images/6c/6c55183a2999276882036eb3bc54a94f9d7356a58eb7b3d3e1ec7708def1de4f.png)\n\nWhich of the following is true regarding the point $C?$\n\nI. It is in the first quadrant\n\nII. Its $x$-coordinate is $3$\n\nIII. Its $y$-coordinate is $-2$" :question/worked-solution "The point $C$ is in the fourth quadrant, so statement I is false.\n\nTo find the coordinates of the point $C,$ we start at the origin, move $3$ units *right* and then $2$ units *down*. \n\n![](images/98/98c5cd8e245651f99a29c37b6d63122fa7766eed80c64ab6870e05192742dab1.png)\n\nThe coordinates of $C$ are $(3,-2).$ Hence, statements II and III are true."} :step/id #uuid "6a26e169-b937-5d4e-9132-efccf14ec7c7" :step/next {:db/id #edb/ref 17592186486514}} {:db/id #edb/ref 17592186486514 :step/content {:db/id #edb/ref 17592186486380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2379ed4e-1bad-561c-bd91-f529f4ce1c13" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e8/e8b3ac34b4fe6c877d606d8ddde5f29c9856cc4bdc5ac14e3ffcf5ddccdc0ebb.png" :db/id #edb/ref 17592186485825} {:answer/id #uuid "2a8a49a4-67ee-5dd6-8034-f08b8abe1465" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/79/794cbedc72a4ad51263737802b419bb024f250f67d3a6a8464f3c9b6d61aa194.png" :db/id #edb/ref 17592186485840} {:answer/id #uuid "3f7f4dc2-51a6-57b2-a348-9bb680d817c3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/5a/5a9caae32c4a20a6646689ceeb16622dbc1982d150988b8b393868e3dab3ac0f.png" :db/id #edb/ref 17592186485885} {:answer/id #uuid "a75b6401-ac5e-5996-87c4-190b7e47c998" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/14/146f5c3b0672a81347edb9d56cfe840ca6acc023444d110584649bf90d741ae6.png" :db/id #edb/ref 17592186486068} {:answer/id #uuid "f9270677-c75b-5726-992c-0684189ac5e6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4b/4ba1b8ea826f2d1a095982b03b58c4e75c711dbad168493a6a0d784064e06a74.png" :db/id #edb/ref 17592186486215}] :answer-field/correct {:db/id #edb/ref 17592186486215} :answer-field/id #uuid "3cc8f23d-893d-5af7-ae5b-7ea465b5f2d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186486262}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a14d943-4b53-5214-a1e8-29e07a0ea11f" :question/math-academy-id "q-71670" :question/problem "Which of the following shows the point $A(-2,3)?$" :question/worked-solution "Starting at the origin, we move along the $x$ and $y$ axes to get to the point $A.$\n\nFirst, we move along the $x$-axis. The point $A$ has an $x$-coordinate of $-2,$ so we move $2$ units to the *left*, in the *negative* direction of the $x$-axis.\n\nThen, we move along the $y$-axis. The point $A$ has a $y$-coordinate of $3,$ so we move $3$ units *up*, in the *positive* direction of the $y$-axis.\n\n![](images/4b/4ba1b8ea826f2d1a095982b03b58c4e75c711dbad168493a6a0d784064e06a74.png)"} :step/id #uuid "dd35957b-3e1a-5f26-ae0e-89d442576bd2" :step/next {:db/id #edb/ref 17592186486475}}] :activity/title "The Cartesian Coordinate System" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186485752}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186055825} :activity/id #uuid "604975a3-93f4-5972-a157-950937a51eea" :activity/scope {:db/id #edb/ref 17592186050618 :topic/id #uuid "598e4586-378e-5300-9abe-bbb9ded2ad77" :topic/math-academy-id 63} :activity/steps [{:db/id #edb/ref 17592186055825 :step/content {:db/id #edb/ref 17592186056032 :tutorial/content "A **variable** is any letter or symbol that can be replaced by a number. For example, the letters\n\n$$\nx, \\quad y, \\quad z, \\quad a, \\quad b, \\quad c, \\quad k, \\quad m,\\quad n,\\quad p, \\quad q,\\quad r, \\quad \\ldots\n$$\n\nare commonly used as variables. But in general, we can use any letter we like.\n\nAn **algebraic expression** is a combination of variables with mathematical operations, like addition $(+)$, subtraction $(-)$, multiplication $(\\times)$, and division $(\\div).$ So \n\n$$\nx+2,\\qquad 6-y,\\qquad 2\\times p + 1,\\qquad q\\div r,\n$$\n\nare all examples of algebraic expressions." :tutorial/id #uuid "232cd5fe-049f-512d-8d7c-ad600a7e6a81" :tutorial/math-academy-id 8165 :tutorial/title "Introduction"} :step/id #uuid "56c96a42-70b1-5c3d-baeb-d0e31a2f412b" :step/math-academy-id 53778 :step/next {:db/id #edb/ref 17592186055826}} {:db/id #edb/ref 17592186055826 :step/content {:db/id #edb/ref 17592186054799 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054421 :question/id #uuid "61ebe3c8-1241-59f1-9d60-704d520c53fb" :question/math-academy-id "e-13055"} :knowledge-point/id #uuid "ef650886-8d46-583e-bad0-1429ba496479" :knowledge-point/questions [{:db/id #edb/ref 17592186055373} {:db/id #edb/ref 17592186055390} {:db/id #edb/ref 17592186424970} {:db/id #edb/ref 17592186424974} {:db/id #edb/ref 17592186424978} {:db/id #edb/ref 17592186424982} {:db/id #edb/ref 17592186518175}] :knowledge-point/title "Identifying Variables"} :step/id #uuid "31658058-879c-5f54-87bd-336129b73d45" :step/math-academy-id 53779 :step/next {:db/id #edb/ref 17592186055827}} {:db/id #edb/ref 17592186055827 :step/content {:db/id #edb/ref 17592186054800 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054422 :question/id #uuid "ee12fc6a-91b2-5855-96a8-c28bd6652ae5" :question/math-academy-id "e-13056"} :knowledge-point/id #uuid "ae662093-c3e8-5577-af6e-7e2f383da79d" :knowledge-point/questions [{:db/id #edb/ref 17592186055105} {:db/id #edb/ref 17592186055391} {:db/id #edb/ref 17592186424971} {:db/id #edb/ref 17592186424972} {:db/id #edb/ref 17592186424976} {:db/id #edb/ref 17592186424979} {:db/id #edb/ref 17592186424981} {:db/id #edb/ref 17592186510438} {:db/id #edb/ref 17592186515568}] :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Addition"} :step/id #uuid "0db792bd-948d-59a9-bc0b-02a8fbacf35a" :step/math-academy-id 53782 :step/next {:db/id #edb/ref 17592186055828}} {:db/id #edb/ref 17592186055828 :step/content {:db/id #edb/ref 17592186054801 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054423 :question/id #uuid "ebd7ac34-c0e4-5e42-940a-cce33864a7de" :question/math-academy-id "e-13057"} :knowledge-point/id #uuid "8fc32821-14d0-5cbe-b8d9-4e7ff5cc937b" :knowledge-point/questions [{:db/id #edb/ref 17592186055280} {:db/id #edb/ref 17592186055392} {:db/id #edb/ref 17592186424817} {:db/id #edb/ref 17592186424973} {:db/id #edb/ref 17592186424975} {:db/id #edb/ref 17592186424977} {:db/id #edb/ref 17592186424980}] :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Subtraction"} :step/id #uuid "efce8a57-ebe0-5019-8c9d-0c9aa1ff8814" :step/math-academy-id 53786}] :activity/title "Introduction to Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054915}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074630} :activity/id #uuid "8d68098e-61ea-5694-8c81-2a07b3b89448" :activity/scope {:db/id #edb/ref 17592186050924 :topic/id #uuid "7247d928-5458-5a46-a08c-b035b4eadd8a" :topic/math-academy-id 534} :activity/steps [{:db/id #edb/ref 17592186074630 :step/content {:db/id #edb/ref 17592186075037 :tutorial/content "A **ratio** is a mathematical statement that expresses the relative sizes of two quantities.\n\nAs an example, let's look at the triangles and circles below. \n\n![](images/48/4865786ce55e0ec3fc1747ece4ea962425a3f83b2a45c7980f52719522318c82.png)\n\nWe can express the ratio of the number of circles to the number of triangles as follows:\n\n$$\n{\\color{blue}{\\textrm{number of circles}}} : {\\color{red}{\\textrm{number of triangles}}}\n$$\n\nTo find this ratio, we start by counting the number of occurrences of each shape:\n\n- First, we count the number of circles. There are $\\color{blue}5$ circles.\n\n- Next, we count the number of triangles. There are $\\color{red}2$ triangles.\n\nTherefore, the ratio of circles to triangles is ${\\color{blue}5}:{\\color{red}2}.$\n\nWe can describe this ratio in words as follows:\n\n*The ratio of circles to triangles is  ${\\color{blue}5}:{\\color{red}2}$ because there are ${\\color{blue}5}$ circles *for every* ${\\color{red}{2}}$ triangles.*" :tutorial/id #uuid "3d8ebe22-8ef7-538a-a42d-4f1133689833" :tutorial/math-academy-id 8277 :tutorial/title "Introduction"} :step/id #uuid "0340ef01-84ac-534c-a79b-d7336d5305b6" :step/math-academy-id 185365 :step/next {:db/id #edb/ref 17592186074631}} {:db/id #edb/ref 17592186074631 :step/content {:db/id #edb/ref 17592186073735 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073450 :question/id #uuid "c4235bf2-0c2b-5c2d-be8d-779a8e5fb38f" :question/math-academy-id "e-13256"} :knowledge-point/id #uuid "0be25cd8-4333-5e00-91e9-7e1256281814" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048698}] :knowledge-point/questions [{:db/id #edb/ref 17592186074082} {:db/id #edb/ref 17592186074396} {:db/id #edb/ref 17592186434178} {:db/id #edb/ref 17592186434180} {:db/id #edb/ref 17592186434182} {:db/id #edb/ref 17592186434185} {:db/id #edb/ref 17592186434190}] :knowledge-point/title "Finding a Ratio"} :step/id #uuid "310791d0-15c7-54f2-9d96-846dc8064a94" :step/math-academy-id 185366 :step/next {:db/id #edb/ref 17592186074632}} {:db/id #edb/ref 17592186074632 :step/content {:db/id #edb/ref 17592186073736 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073451 :question/id #uuid "76442c46-6958-556f-a895-027a3ce7427b" :question/math-academy-id "e-13257"} :knowledge-point/id #uuid "acde6034-9007-5777-a79c-5f99ead9154a" :knowledge-point/questions [{:db/id #edb/ref 17592186074084} {:db/id #edb/ref 17592186074401} {:db/id #edb/ref 17592186434181} {:db/id #edb/ref 17592186434184} {:db/id #edb/ref 17592186434186} {:db/id #edb/ref 17592186434188} {:db/id #edb/ref 17592186434189}] :knowledge-point/title "Word Problems"} :step/id #uuid "cb26c220-5990-5446-ae5f-4ca0b272e25a" :step/math-academy-id 185369 :step/next {:db/id #edb/ref 17592186074633}} {:db/id #edb/ref 17592186074633 :step/content {:db/id #edb/ref 17592186073737 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073452 :question/id #uuid "34ec50f1-1873-510d-8693-49f93bae1df8" :question/math-academy-id "e-13258"} :knowledge-point/id #uuid "9edb7c90-39fa-5396-b00e-04a0627d0581" :knowledge-point/questions [{:db/id #edb/ref 17592186073995} {:db/id #edb/ref 17592186074402} {:db/id #edb/ref 17592186424828} {:db/id #edb/ref 17592186434177} {:db/id #edb/ref 17592186434179} {:db/id #edb/ref 17592186434183} {:db/id #edb/ref 17592186434187}] :knowledge-point/title "Interpreting Ratios"} :step/id #uuid "9ef29b30-f1cb-5cec-a28d-cd61e7444890" :step/math-academy-id 185372}] :activity/title "Introduction to Ratios" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073954}]}
