#{[{:db/id #edb/ref 17592186521487 :knowledge-point/_questions [{:db/id #edb/ref 17592186064364 :knowledge-point/id #uuid "9cb97145-a93a-5df3-8dbe-6777d21601c8" :knowledge-point/title "Multiplying a Positive Number by a Negative Number With Decimals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d94c53c-2afd-517b-8b96-6142e6db784f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15.6" :db/id #edb/ref 17592186520943}] :answer-field/correct {:answer/id #uuid "4d94c53c-2afd-517b-8b96-6142e6db784f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15.6" :db/id #edb/ref 17592186520943} :answer-field/id #uuid "7a7ea3b9-535a-5e77-b9a4-dea5e94f45e7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186521382}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3e520184-edf6-56d7-ae3f-333c3748146f" :question/math-academy-id "q-171123" :question/problem "$(5.2)\\cdot (-3)=${{field-1}}" :question/worked-solution "We have a product of a positive number $(5.2)$ and a negative number $(-3).$ So the product will be negative:\n\n$$\n5.2\\cdot (-3)=-\\,\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we multiply $5.2$ by $3$ without any signs: $5.2\\cdot 3=15.6.$ So, we get\n\n$$\n5.2\\cdot (-3)=-15.6.\n$$"}] [{:db/id #edb/ref 17592186064528 :knowledge-point/_questions [{:db/id #edb/ref 17592186064256 :knowledge-point/id #uuid "f1c51da0-7569-50c0-b405-c74419d47ef3" :knowledge-point/title "Subtracting a Positive Number From a Non-Negative Number With Larger Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58dd9577-598d-5be3-9295-297a104810d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-158" :db/id #edb/ref 17592186520967}] :answer-field/correct {:answer/id #uuid "58dd9577-598d-5be3-9295-297a104810d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-158" :db/id #edb/ref 17592186520967} :answer-field/id #uuid "2f43053e-840e-5508-9d3c-407eb24843aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061388}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "faa8db22-22eb-53d1-b031-cb02b6e51ba7" :question/math-academy-id "q-174309" :question/problem "$206-364=${{field-1}}" :question/worked-solution "Since $364$ is larger than $206,$ the answer will be negative.\n\nWe start by solving an easier problem:\n\n$$\n364-206\n$$\n\nNext, we carry out the subtraction:\n\n$$\n\\begin{aligned} &  & \\,\\,\\, & \\,\\,\\,\\begin{aligned}\\,\\,\\,5\\end{aligned} & \\,\\,\\,\\begin{aligned}\\,\\,\\,14\\end{aligned} \\\\  &  & \\,\\,\\,3\\,\\,\\, & \\,\\,\\,6\\,\\,\\, & \\,\\,\\,4\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,2\\,\\,\\, & \\,\\,\\,0\\,\\,\\, & \\,\\,\\,6\\,\\,\\, \\\\  &  & \\,\\,\\,1\\,\\,\\, & \\,\\,\\,5\\,\\,\\, & \\,\\,\\,8\\,\\,\\,\\end{aligned}\n$$\n\nSo, we have\n\n$$\n364-206=158.\n$$\n\nHowever, since our answer must be negative, we need to change the sign of the answer above. \n\nTherefore, we conclude that\n\n$$\n206-364=-158.\n$$"}] [{:db/id #edb/ref 17592186521495 :knowledge-point/_questions [{:db/id #edb/ref 17592186171934 :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/title "Determining if a Number Is Divisible by 7"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01148fdd-b3c2-58c3-bd64-bc7039e3aa72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and  III only" :db/id #edb/ref 17592186520765} {:answer/id #uuid "7e74e918-bf7e-51d4-b025-37cf39ae58bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and  II only" :db/id #edb/ref 17592186521054} {:answer/id #uuid "ca3c4587-fd47-5a07-9f96-490c2058ad00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186521216} {:answer/id #uuid "cb8ba310-7b83-5c1c-b220-d8e14288b80b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186521219} {:answer/id #uuid "f99d86fe-18dc-5ab3-b1d5-cc194710dad4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186521310}] :answer-field/correct {:answer/id #uuid "f99d86fe-18dc-5ab3-b1d5-cc194710dad4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186521310} :answer-field/id #uuid "da0cc54c-5334-583d-91ac-093122073d60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521436}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4d3c9434-4ef2-5a17-95da-683191ed9ce8" :question/math-academy-id "q-223451" :question/problem "Which of the following numbers are divisible by $7?$\n\nI. $631$\n\nII. $782$\n\nIII. $686$" :question/worked-solution "To check if a number is divisible by $7,$ double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$\n\n- For the number $631,$ we have that \n\n$$\n63-2(1)=63-2=61\n$$\n\nwhich is not divisible by $7.$ Therefore, $631$ is not divisible by $7.$\n\n- For the number $782,$ we have that \n\n$$\n78-2(2)=78-4=74\n$$\n\nwhich is not divisible by $7.$ Therefore, $782$ is not divisible by $7.$\n\n- For the number $686,$ we have that \n\n$$\n68-2(6)=68-12=56\n$$\n\nwhich is divisible by $7.$ Therefore, $686$ is divisible by $7.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186521488 :knowledge-point/_questions [{:db/id #edb/ref 17592186147544 :knowledge-point/id #uuid "638e604b-5416-5d3c-a61f-5be645aa255b" :knowledge-point/title "Identifying True Statements in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13906513-b2f0-5250-9ebb-45ffb4a6b3ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186520810} {:answer/id #uuid "1905c358-05c8-5758-9d22-794e63bc3875" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186520819} {:answer/id #uuid "41a234f5-7ea7-50f7-bbcb-7a8cfe94b9f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186520912} {:answer/id #uuid "87728be6-075d-537f-8aef-27d481efa7f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186521074} {:answer/id #uuid "8bd1beb1-7b8d-5ba2-ad28-8ad264935383" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186521081}] :answer-field/correct {:answer/id #uuid "8bd1beb1-7b8d-5ba2-ad28-8ad264935383" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186521081} :answer-field/id #uuid "54b448ba-1dea-5e80-9afc-9ef26eb406f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521365}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3e597010-3568-5f92-b7bf-8866f8549553" :question/math-academy-id "q-350258" :question/problem "Ethan and Lucas are swimmers. In the previous season, $75%$ of Ethan’s races were freestyle, while the decimal proportion of Lucas’s races that were freestyle was $0.4.$\n\nWhich of the following statements are true?\n\nI. Less than half of Ethan's races were freestyle.\n\nII. More than half of Lucas's races were freestyle.\n\nIII. Ethan had a greater percentage of freestyle races compared to Lucas." :question/worked-solution "Let's examine our statements in turn.\n\n- Statement I is false. Indeed, since \n\n$$\n75%>50%,\n$$\n\nmore than half of Ethan's races were freestyle.\n\n- Statement II is false. Notice that \n\n$$\n0.4<0.5.\n$$\n\nSo, less than half of Lucas's races were freestyle.\n\n- Statement III is true. We can compare $75%$ and $0.4$ by converting the decimal into a percent. \n\nTo do this, we multiply it by $100:$\n\n$$\n0.4\\times 100=40%\n$$\n\nSince $75%>40%,$ Ethan had a **greater** percentage of freestyle races compared to Lucas.\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186521514 :knowledge-point/_questions [{:db/id #edb/ref 17592186054807 :knowledge-point/id #uuid "b509b42a-c38a-5400-8f93-f3e9024b16a2" :knowledge-point/title "Identifying the Coordinates of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47b7e555-339b-50e9-aaab-1a24dfc2973d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-7)" :db/id #edb/ref 17592186520925} {:answer/id #uuid "4ecfd91a-68ea-5d2d-b285-46f98c629e98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,-5)" :db/id #edb/ref 17592186520944} {:answer/id #uuid "77bd6183-b631-5c1e-a4b5-dbba0ddecd44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-7,-5)" :db/id #edb/ref 17592186521031} {:answer/id #uuid "bb4f6388-69b6-5879-b082-4c5fb3cdbe9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,-7)" :db/id #edb/ref 17592186521183} {:answer/id #uuid "ff630284-77f1-5372-8795-b1017630bab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,5)" :db/id #edb/ref 17592186521325}] :answer-field/correct {:answer/id #uuid "47b7e555-339b-50e9-aaab-1a24dfc2973d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-7)" :db/id #edb/ref 17592186520925} :answer-field/id #uuid "8fa81a20-3eba-5785-81ce-192978644ece" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521397}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "785b3e3d-2e78-5863-9118-440c52c1081d" :question/math-academy-id "q-5754" :question/problem "![](images/d4/d43d45e070fe27d03717c2c88740b4536a23c7adba0ba2aa2ae451ecab34dbb5.png)\n\nWhat are the $xy$-coordinates of the point shown in the axes above?" :question/worked-solution "To find the coordinates of the point, we inspect its position along the $x$ and $y$ axes.\n\nThe point is $5$ units to the *left* of the origin, in the *negative* direction of the $x$-axis. So, the point has an $x$-coordinate of $-5.$\n\nAdditionally, the point is $7$ units *below* the origin, in the *negative* direction of the $y$-axis. So, the point has a $y$-coordinate of $-7.$\n\nThe point has an $x$-coordinate of $-5$ and a $y$-coordinate of $-7,$ so its coordinates are $(-5,-7).$"}] [{:db/id #edb/ref 17592186521463 :knowledge-point/_questions [{:db/id #edb/ref 17592186073740 :knowledge-point/id #uuid "d16202af-d3ac-54bc-9c76-25947a7a0b60" :knowledge-point/title "Completing a Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4878cfa1-846f-5e65-8d90-c04276138057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186520926} {:answer/id #uuid "8a9f26e9-6756-5716-989d-00c536e7041c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186521078} {:answer/id #uuid "ca64ca36-f6af-5be2-9a76-2b7cbc85698b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186521217} {:answer/id #uuid "db276d64-70bd-58c9-a75a-18687f8c8c7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186521255} {:answer/id #uuid "ec72d0d4-5419-525b-9012-042c143b9e36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186521290}] :answer-field/correct {:answer/id #uuid "ca64ca36-f6af-5be2-9a76-2b7cbc85698b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186521217} :answer-field/id #uuid "9ee707a5-cdba-5ace-9f13-9f6ca1c803ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521406}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "162ad66e-4fa5-5917-937f-4dfd0e95e3fd" :question/math-academy-id "q-59899" :question/problem "![](images/6e/6e12ca457954f93778b772f2d0bd5a1e63e7e8e7eaf626d309300e97b23ab525.png)\n\nWhat number is missing from the boxes in the statement below?\n\nThe ratio of hexagons to rhombuses is $\\boxed{}:1$ because there are $\\boxed{}$ hexagons for every $1$ rhombus." :question/worked-solution "First, we count the number of hexagons. We see that there are $4$ hexagons.\n\nThen, we count the number of rhombuses. We see that there are $2$ rhombuses.\n\nSo the ratio of hexagons to rhombuses is $4:2.$\n\nWe can simplify this ratio by dividing both numbers by $2$:\n\n$$\n\\begin{aligned}\\,\\,4 &  & : & \\,\\,\\,\\, & \\,\\,\\,2 &  \\\\ \\,\\,↓÷\\,\\,2 &  &  &  & \\,\\,\\,↓÷\\,\\,2 &  \\\\ \\,\\,2 &  & : &  & \\,\\,\\,1 & \\end{aligned}\n$$\n\nThis means that $2:1$ is equivalent to $4:2.$ \n\nSo, the complete statement is\n\"The ratio of hexagons to rhombuses is $2:1$ because there are $2$ hexagons for every $1$ rhombus.\""}] [{:db/id #edb/ref 17592186521493 :knowledge-point/_questions [{:db/id #edb/ref 17592186073737 :knowledge-point/id #uuid "9edb7c90-39fa-5396-b00e-04a0627d0581" :knowledge-point/title "Interpreting Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e479e53-8494-57eb-96f8-9ac771475ceb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $5$" :db/id #edb/ref 17592186520828} {:answer/id #uuid "5c3cefc9-3d90-5e7d-8e1a-5a464d800db6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ and $7$" :db/id #edb/ref 17592186520972} {:answer/id #uuid "8fd633a8-8523-5e91-a3cc-48af3aae1d72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ and $2$" :db/id #edb/ref 17592186521091} {:answer/id #uuid "c7d42562-52c2-5c3e-9214-a27acb95bf22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $7$" :db/id #edb/ref 17592186521209} {:answer/id #uuid "d31ab7c6-4994-5471-beb0-1b8ac5139ddd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ and $2$" :db/id #edb/ref 17592186521238}] :answer-field/correct {:answer/id #uuid "d31ab7c6-4994-5471-beb0-1b8ac5139ddd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ and $2$" :db/id #edb/ref 17592186521238} :answer-field/id #uuid "ae34d415-ccc8-5608-abcb-26fa7f2fa29a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521412}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4be9a2f5-2f4a-5a28-99ac-bf9fd6c5ffaf" :question/math-academy-id "q-60088" :question/problem "![](images/2d/2d4fc837b149453ef874950260279781e57ca398b92023e28ebe4fb3b841c311.png)\n\nFrom left to right, what are the missing numbers in the statement below?\n\nThe ratio of rectangles to kites is $2:\\boxed{}\\,$ because there are $\\,\\boxed{}\\,$ rectangles for every $5$ kites." :question/worked-solution "We can express the ratio of the number of rectangles to the number of kites as follows:\n\n$$\n\\text{number of rectangles}:\\text{number of kites}\n$$\n\nTo find this ratio, we start by counting the number of occurrences of each shape:\n\n- First, we count the number of rectangles. There are $2$ rectangles.\n\n- Next, we count the number of kites. There are $5$ kites.\n\nTherefore, the ratio of rectangles to kites is $2:5.$\n\nTherefore, the missing numbers are $5$ and $2.$"}] [{:db/id #edb/ref 17592186521563 :knowledge-point/_questions [{:db/id #edb/ref 17592186054800 :knowledge-point/id #uuid "ae662093-c3e8-5577-af6e-7e2f383da79d" :knowledge-point/title "Translating Between Phrases and Algebraic Expressions Containing Addition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155bdc41-9802-59b2-8bca-e743c38085f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a" :db/id #edb/ref 17592186520814} {:answer/id #uuid "6c0f6c1d-30cb-5325-b1b4-4aae790a56f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a+20" :db/id #edb/ref 17592186521010} {:answer/id #uuid "b3da9a63-8d40-5367-87c4-1d31dd79b916" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{20}{a}" :db/id #edb/ref 17592186521166} {:answer/id #uuid "dcffd8c0-0654-5ce4-bfe4-e1f0bf668694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20a" :db/id #edb/ref 17592186521258} {:answer/id #uuid "ece49a7a-6a81-5e2a-aa9b-c2756d56b63f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20-a" :db/id #edb/ref 17592186521292}] :answer-field/correct {:answer/id #uuid "6c0f6c1d-30cb-5325-b1b4-4aae790a56f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a+20" :db/id #edb/ref 17592186521010} :answer-field/id #uuid "2567cecc-e540-571f-986b-6c5fcfdd8368" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521344}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e800ccd8-93c4-50ec-b967-b7f8e3af90fc" :question/math-academy-id "q-67032" :question/problem "Translate the following phrase into an algebraic expression: \"Twenty more than a number.\"" :question/worked-solution "If we denote our number by $a$, then the phrase \"twenty more than a number\" can be written as\n\n$$\na+20.\n$$"}] [{:db/id #edb/ref 17592186521470 :knowledge-point/_questions [{:db/id #edb/ref 17592186073879 :knowledge-point/id #uuid "6e191386-9391-5e3c-9f2f-f17d55f9b6ca" :knowledge-point/title "Completing a Statement Describing a Ratio as a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54a8b7db-79fa-58b5-96a6-e82a42bcb1cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186520956} {:answer/id #uuid "ae3cb97f-a300-598b-bfe6-6bf8f1278132" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186521154} {:answer/id #uuid "c0fd5d3a-7d0f-5ea4-914a-871484720da7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186521194} {:answer/id #uuid "c389682d-42f9-5b36-aecf-84b5b45dee1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186521200} {:answer/id #uuid "f7618fca-86a2-53d3-84b0-51f4f3d7c765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186521305}] :answer-field/correct {:answer/id #uuid "c389682d-42f9-5b36-aecf-84b5b45dee1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186521200} :answer-field/id #uuid "d0c989b5-7b3b-504b-8868-67605b31a160" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521430}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2668924b-c4c3-5180-8799-da87f8fa9aec" :question/math-academy-id "q-92941" :question/problem "What is missing in the following sentence?\n\nIn order to make some flannels, Martha bought $5$ meters of cotton fabric and $4$ meters of linen fabric, so there are $\\boxed{}$ meters of cotton fabric for each meter of linen fabric." :question/worked-solution "The ratio of the amount of cotton fabric to the amount of linen fabric is $5:4.$ \n\nWe can rewrite this ratio as a fraction, as follows:\n\n$$\n\\frac{5}{4}\n$$\n\nThis means that there are $\\frac{5}{4}$ meters of cotton fabric for each meter of linen fabric."}] [{:db/id #edb/ref 17592186521562 :knowledge-point/_questions [{:db/id #edb/ref 17592186152124 :knowledge-point/id #uuid "f0075774-6bd8-54c9-b698-4aacd499fce5" :knowledge-point/title "Classifying Numbers as Natural"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f126447-987a-50d2-91b4-6bb6bc430b1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186520829} {:answer/id #uuid "42d46641-017d-5647-b920-cf17ddf92d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186520914} {:answer/id #uuid "cea95e71-ceaf-544e-82f6-41c536fe741f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186521228} {:answer/id #uuid "d6be00ed-0b75-57c7-b788-a5b37ddea0cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186521244} {:answer/id #uuid "e27ef853-fbbc-5693-b282-741e2f3dff09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186521271}] :answer-field/correct {:answer/id #uuid "cea95e71-ceaf-544e-82f6-41c536fe741f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186521228} :answer-field/id #uuid "bddec77b-4bb5-5e2b-92e1-a0fa38b99c3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521423}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e58a84f8-02f0-5e14-9a24-64165fe53601" :question/math-academy-id "q-98374" :question/problem "Which of the following are natural numbers?\n\nI. $-\\frac{4}{3}$\n\nII. $3$\n\nIII. $-4$" :question/worked-solution "The natural numbers consist of all positive whole numbers.\n\n$$\n1,\\,2,\\,3,\\,4,\\,5,…\n$$\n\nOf the given numbers, $3$ is a natural number, but $-\\frac{4}{3}$ and $-4$ are not.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186521501 :knowledge-point/_questions [{:db/id #edb/ref 17592186064230 :knowledge-point/id #uuid "3df16e28-70ed-5dd0-9bf0-d56b38f542eb" :knowledge-point/title "Dividing Zero by a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "445dc765-fffa-5c9c-8032-001531d309ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186520917} {:answer/id #uuid "7c75d6e2-200f-56c9-be87-9792e2c68716" :answer/type {:db/id #edb/ref 17592186045