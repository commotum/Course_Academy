334-7998-50d1-8c82-99faf7930e48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P" :db/id #edb/ref 17592186412453} {:answer/id #uuid "c220dff6-bac7-5212-aa3c-13d42ca63b7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P" :db/id #edb/ref 17592186412459} {:answer/id #uuid "d4792fc7-c352-5d42-8f7f-8e905df57e93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{t}" :db/id #edb/ref 17592186412465}] :answer-field/correct {:db/id #edb/ref 17592186412430} :answer-field/id #uuid "f19ff78d-fe83-5887-b329-51a2db951790" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186412485} {:answer-field/choices [{:answer/id #uuid "478f2087-4260-5002-aec3-be86ac2d16bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P" :db/id #edb/ref 17592186412436} {:answer/id #uuid "50c79500-5794-5ac9-a02d-9fcddd212f2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{c}" :db/id #edb/ref 17592186412438} {:answer/id #uuid "8163c207-2ef3-55b7-85ad-5a34633c72c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{t}" :db/id #edb/ref 17592186412447} {:answer/id #uuid "e46e9479-3c1d-5a65-a125-93a5096ef970" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P" :db/id #edb/ref 17592186412468}] :answer-field/correct {:db/id #edb/ref 17592186412436} :answer-field/id #uuid "f231f80b-e868-51ef-88c4-aa06687be545" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186412486}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8b03653-3dbc-58b5-96b9-61df0ae25ec2" :question/math-academy-id "q-218619" :question/problem "If $P$ is a statement, $\\text{t}$ is a tautology, and $\\text{c}$ is a contradiction, complete the following table of logical equivalences.\n\n| Statement | Is Logically Equivalent To |\n| --- | --- |\n| $\\text{t}∧\\text{c}$ | {{field-1}} |\n| $\\text{c}∨\\text{c}$ | {{field-2}} |\n| $\\text{c}∧¬P$ | {{field-3}} |\n| $P∨\\text{c}$ | {{field-4}} |" :question/worked-solution "Recall the following properties of tautologies and contradictions:\n\n$$\n\\begin{aligned}A∨\\text{t}=\\text{t}\\, &  & A∧\\text{t} & =A \\\\ A∨\\text{c}=A\\, &  & A∧\\text{c} & =\\text{c} \\\\ \\text{t}∨\\text{t}=\\text{t}\\, &  & \\text{t}∧\\text{t} & =\\text{t} \\\\ \\text{t}∨\\text{c}=\\text{t}\\, &  & \\text{t}∧\\text{c} & =\\text{c} \\\\ \\text{c}∨\\text{t}=\\text{t}\\, &  & \\text{c}∧\\text{t} & =\\text{c} \\\\ \\text{c}∨\\text{c}=\\text{c}\\, &  & \\text{c}∧\\text{c} & =\\text{c}\\end{aligned}\n$$\n\nThe completed table is shown below.\n\n| Statement | Is Logically Equivalent To |\n| --- | --- |\n| $\\text{t}∧\\text{c}$ | $\\text{c}$ |\n| $\\text{c}∨\\text{c}$ | $\\text{c}$ |\n| $\\text{c}∧¬P$ | $\\text{c}$ |\n| $P∨\\text{c}$ | $P$ |"} :step/id #uuid "b5ec8193-89bd-513d-9413-97a3db4d604d"} {:db/id #edb/ref 17592186420436 :step/content {:db/id #edb/ref 17592186412493 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "011a757a-8f28-54ed-ba0e-850164295679" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬B" :db/id #edb/ref 17592186412422} {:answer/id #uuid "0f3b6458-283b-571f-9a26-0b7d6458ac1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A" :db/id #edb/ref 17592186412425} {:answer/id #uuid "3fc4643b-2573-5fab-be1c-271a55aba445" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "B" :db/id #edb/ref 17592186412433} {:answer/id #uuid "8440357c-e8f4-52a1-a3d2-aa0095777a19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{t}" :db/id #edb/ref 17592186412449} {:answer/id #uuid "8c664640-a8d9-540c-a8d0-6eef986b478f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A∨B" :db/id #edb/ref 17592186412450}] :answer-field/correct {:db/id #edb/ref 17592186412425} :answer-field/id #uuid "f4691870-3991-5d73-8ef6-aa0282e3a085" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186412487}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ce194f41-6fc2-5669-9a9a-5765a4bee419" :question/math-academy-id "q-107597" :question/problem "Simplify the expression $(A∧B)∨(A∧¬B).$" :question/worked-solution "Let's simplify the expression using the properties of logical operations:\n\n- First,  we use the distributive law (conjunction over disjunction):\n\n$$\n(A∧B)∨(A∧¬B)≡A∧(B∨¬B)\n$$\n\n- Next,  we use the fact that the disjunction of an expression and its negation is a tautology:\n\n$$\nA∧(B∨¬B)≡A∧\\text{t}\n$$\n\n- Finally, we use the fact that the conjunction of an expression and a tautology gives the initial expression:\n\n$$\nA∧\\text{t}≡A\n$$\n\nTherefore, we conclude that\n\n$$\n(A∧B)∨(A∧¬B)≡A.\n$$"} :step/id #uuid "c3697fe6-7104-578f-a0f0-040a5a9c9a26" :step/next {:db/id #edb/ref 17592186420438}} {:db/id #edb/ref 17592186420437 :step/content {:db/id #edb/ref 17592186412492 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02899baf-379d-5a7f-825e-80fc84556e33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∨¬Y" :db/id #edb/ref 17592186412423} {:answer/id #uuid "12fed220-5b36-555f-a0e1-23193416aef8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨¬Y" :db/id #edb/ref 17592186412426} {:answer/id #uuid "9dfa5bfc-2768-57bf-8720-845e228b4fc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∧Y" :db/id #edb/ref 17592186412454} {:answer/id #uuid "a345243f-29ba-535f-a9fb-a842f28ed390" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∧Y" :db/id #edb/ref 17592186412455} {:answer/id #uuid "d374d92d-3da8-529d-b3c3-8ade1c57d532" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∨Y" :db/id #edb/ref 17592186412464}] :answer-field/correct {:db/id #edb/ref 17592186412455} :answer-field/id #uuid "40f92c2f-604c-5e5a-be11-f4fdbee5d8ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186412475}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "480f94bc-0561-588e-b570-1657983e06e2" :question/math-academy-id "q-216907" :question/problem "Simplify the expression $¬[(¬X∨¬Y)∨(¬Y∧Y)].$" :question/worked-solution "Let's simplify the expression using the properties of logical operations:\n\n- First, we use the fact that the conjunction of a statement and its negation is a contradiction:\n\n$$\n¬[(¬X∨¬Y)∨(¬Y∧Y)]≡¬[(¬X∨¬Y)∨\\text{c}]\n$$\n\n- Next, we use the fact that the disjunction of a statement and a contradiction equals the original statement:\n\n$$\n¬[(¬X∨¬Y)∨\\text{c}]≡¬(¬X∨¬Y)\n$$\n\n- Then, we use a De Morgan's law:\n\n$$\n¬(¬X∨¬Y)≡¬¬(X∧Y)\n$$\n\n- Finally,  we simplify the double negation:\n\n$$\n¬¬(X∧Y)≡X∧Y\n$$\n\nTherefore, we conclude that\n\n$$\n¬[(¬X∨¬Y)∨(¬Y∧Y)]≡X∧Y\n$$"} :step/id #uuid "d748ceaf-a120-5010-b245-eb5900c5edba" :step/next {:db/id #edb/ref 17592186420435}} {:db/id #edb/ref 17592186420438 :step/content {:db/id #edb/ref 17592186412491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b7fee42-d2c5-5fc7-932f-a17671313f9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186412445} {:answer/id #uuid "8123fa38-b912-58e2-8130-c57c2777ed77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186412446}] :answer-field/correct {:db/id #edb/ref 17592186412445} :answer-field/id #uuid "07966ba7-6b15-5942-a6a4-899944cebd1a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186412472} {:answer-field/choices [{:answer/id #uuid "3eea4b75-9abf-52ea-a6f4-eb5ac01d868c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "isn't" :db/id #edb/ref 17592186412432} {:answer/id #uuid "6cfd2131-16f7-5698-bfe3-6ad801b3d577" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "is" :db/id #edb/ref 17592186412444}] :answer-field/correct {:db/id