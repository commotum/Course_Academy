 \n$\\text{is}$\na contradiction."} :step/id #uuid "e795d763-e974-5a96-b527-c5d7928a4242" :step/next {:db/id #edb/ref 17592186420439}} {:db/id #edb/ref 17592186420439 :step/content {:db/id #edb/ref 17592186412490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92d1746f-42da-5dc0-a455-4077ceb7aad7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186412452} {:answer/id #uuid "dda8ff27-7c35-5514-aa0f-4ee5349d5e1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186412466}] :answer-field/correct {:db/id #edb/ref 17592186412452} :answer-field/id #uuid "2facc718-9d95-5d69-a30e-b8df235199b6" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186412474} {:answer-field/choices [{:answer/id #uuid "418d52d4-78b1-52f0-95a6-64a27c29334c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186412434} {:answer/id #uuid "90a94a33-9085-5063-9938-221bbd66c8b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186412451}] :answer-field/correct {:db/id #edb/ref 17592186412434} :answer-field/id #uuid "526464ec-b785-5384-96f4-c7a8788177cd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186412476} {:answer-field/choices [{:answer/id #uuid "2ef73e8a-799c-5475-b4c7-fa5b5bf21725" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "isn't" :db/id #edb/ref 17592186412429} {:answer/id #uuid "81cb6b63-950d-5bbb-b661-e7826baa728d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "is" :db/id #edb/ref 17592186412448}] :answer-field/correct {:db/id #edb/ref 17592186412429} :answer-field/id #uuid "68c53a60-1bf9-5a45-ac13-ea9da7929304" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186412478} {:answer-field/choices [{:answer/id #uuid "ca