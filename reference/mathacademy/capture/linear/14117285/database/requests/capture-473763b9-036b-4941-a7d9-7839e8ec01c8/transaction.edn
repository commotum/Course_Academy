F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n\nAccording to the table, $(¬A∧B)∧(A∧¬B)$ \n$\\text{is}$\nalways false. Therefore, it \n$\\text{is}$\na contradiction." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fbd5dd94-f84e-57c1-a028-260de43e3586" "answer-field-6b7b36e2-010e-5c8c-a531-cfdac4c1e2af" "answer-field-07966ba7-6b15-5942-a6a4-899944cebd1a" "answer-field-672bc2ab-c6b2-5ac7-9bda-d6f933656a07" "answer-field-153641e6-e568-5cae-995f-1bd2ca55e951" "answer-field-fbd85907-0579-5041-8783-00bf88384248"] :db/ensure [:question/validate]} {:db/id "answer-field-fbd5dd94-f84e-57c1-a028-260de43e3586" :answer-field/id #uuid "fbd5dd94-f84e-57c1-a028-260de43e3586" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-4f153669-0824-50b8-ade3-91be6b7232a5" :answer-field/choices ["answer-4f153669-0824-50b8-ade3-91be6b7232a5" "answer-c11773f1-7d07-5369-9596-73628361ee4c"] :db/ensure [:answer-field/validate]} {:db/id "answer-4f153669-0824-50b8-ade3-91be6b7232a5" :answer/id #uuid "4f153669-0824-50b8-ade3-91be6b7232a5" :answer/type :answer.type/math :answer/value "\\text{F}" :db/ensure [:answer/validate]} {:db/id "answer-c11773f1-7d07-5369-9596-73628361ee4c" :answer/id #uuid "c11773f1-7d07-5369-9596-73628361ee4c" :answer/type :answer.type/math :answer/value "\\text{T}" :db/ensure [:answer/validate]} {:db/id "answer-field-6b7b36e2-010e-5c8c-a531-cfdac4c1e2af" :answer-field/id #uuid "6b7b36e2-010e-5c8c-a531-cfdac4c1e2af" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-baa7ed6f-98a3-5b32-9567-e6c8aa1f3e51" :answer-field/choices ["answer-baa7ed6f-98a3-5b32-9567-e6c8aa1f3e51" "answer-5eada6ad-0f8e-5c7b-9d90-8043ba159f77"] :db/ensure [:answer-field/validate]} {:db/id "answer-baa7ed6f-98a3-5b32-9567