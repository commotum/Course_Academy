ld-153641e6-e568-5cae-995f-1bd2ca55e951" :answer-field/id #uuid "153641e6-e568-5cae-995f-1bd2ca55e951" :answer-field/key "field-5" :answer-field/type :answer-field.type/select :answer-field/correct "answer-6cfd2131-16f7-5698-bfe3-6ad801b3d577" :answer-field/choices ["answer-6cfd2131-16f7-5698-bfe3-6ad801b3d577" "answer-3eea4b75-9abf-52ea-a6f4-eb5ac01d868c"] :db/ensure [:answer-field/validate]} {:db/id "answer-6cfd2131-16f7-5698-bfe3-6ad801b3d577" :answer/id #uuid "6cfd2131-16f7-5698-bfe3-6ad801b3d577" :answer/type :answer.type/text :answer/value "is" :db/ensure [:answer/validate]} {:db/id "answer-3eea4b75-9abf-52ea-a6f4-eb5ac01d868c" :answer/id #uuid "3eea4b75-9abf-52ea-a6f4-eb5ac01d868c" :answer/type :answer.type/text :answer/value "isn't" :db/ensure [:answer/validate]} {:db/id "answer-field-fbd85907-0579-5041-8783-00bf88384248" :answer-field/id #uuid "fbd85907-0579-5041-8783-00bf88384248" :answer-field/key "field-6" :answer-field/type :answer-field.type/select :answer-field/correct "answer-cebad483-df6b-5f20-872d-5b97842a6635" :answer-field/choices ["answer-cebad483-df6b-5f20-872d-5b97842a6635" "answer-b5a86e95-6e8d-5c5b-ba8d-c922a8550c21"] :db/ensure [:answer-field/validate]} {:db/id "answer-cebad483-df6b-5f20-872d-5b97842a6635" :answer/id #uuid "cebad483-df6b-5f20-872d-5b97842a6635" :answer/type :answer.type/text :answer/value "is" :db/ensure [:answer/validate]} {:db/id "answer-b5a86e95-6e8d-5c5b-ba8d-c922a8550c21" :answer/id #uuid "b5a86e95-6e8d-5c5b-ba8d-c922a8550c21" :answer/type :answer.type/text :answer/value "isn't" :db/ensure [:answer/validate]} {:db/id "question-1e6df6c0-c5fb-5993-9a0a-f13c5e1ee5eb" :question/id #uuid "1e6df6c0-c5fb-5993-9a0a-f13c5e1ee5eb" :question/math-academy-id "q-216810" :question/problem "Select the correct options in the truth table below and use this to determine whether $(P∧Q)∧(¬P∨Q)$ is a contradiction." :question/worked-solution "An expression is a contradiction if it is always false, regardless of the inputs.\n\nBy completing the final column in the truth table below, we obtain the following:\n\n| $\\,P\\,$ | $\\,Q\\,$ | $\\,P∧Q\\,$ | $\\,¬P∨Q\\,$ | $\\,(P∧Q)∧(¬P∨Q)\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n\nAccording to the table, $(P∧Q)∧(¬P∨Q)$ \n$\\text{isn't}$\nalways false. Therefore, it \n$\\text{isn't}$\na contradiction." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-526464ec-b785-5384-96f4-c7a8788177cd" "answer-field-2facc718-9d95-5d69-a30e-b8df235199b6" "answer-field-93e1de7c-e2d5-507a-bda9-9dc367cd8f04" "answer-field-b6f42738-955f-5e2a-8f6c-ff6cd54b7bc2" "answer-field-68c53a60-1bf9-5a45-ac13-ea9da7929304" "answer-field-b3bceeb8-ebf9-5b61-9558-dc7041e7185a"] :db/ensure [:question/validate]} {:db/id "answer-field-526464ec-b785-5384-96f4-c7a8788177cd" :answer-field/id #uuid "526464ec-b785-5384-96f4-c7a8788177cd" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-418d52d4-78b1-52f0-95a6-64a27c29334c" :answer-field/choices ["answer-90a94a33-9085-5063-9938-221bbd66c8b0" "answer-418d52d4-78b1-52f0-95a6-64a27c29334c"] :db/ensure [:answer-field/validate]} {:db/id "answer-90a94a33-9085-5063-9938-221bbd66c8b0" :answer/id #uuid "90a94a33-9085-5063-9938-221bbd66c8b0" :answer/type :answer.type/math :answer/value "\\text{F}" :db/ensure [:answer/validate]} {:db/id "answer-418d52d4-78b1-52f0-95a6-64a27c29334c" :answer/id #uuid "418d52d4-78b1-52f0-95a6-64a27c29334c" :answer/type :answer.type/math :answer/value "\\text{T}" :db/ensure [:answer/validate]} {:db/id "answer-field-2facc718-9d95-5d69-a30e-b8df235199b6" :answer-field/id #uuid "2facc718-9d95-5d69-a30e-b8df235199b6" :answer-field/key "field-2" :answer-field/type 