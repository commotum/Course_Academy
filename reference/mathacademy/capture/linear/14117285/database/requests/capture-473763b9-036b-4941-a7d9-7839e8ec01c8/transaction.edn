lidate]} {:db/id "question-e8b03653-3dbc-58b5-96b9-61df0ae25ec2" :question/id #uuid "e8b03653-3dbc-58b5-96b9-61df0ae25ec2" :question/math-academy-id "q-218619" :question/problem "If $P$ is a statement, $\\text{t}$ is a tautology, and $\\text{c}$ is a contradiction, complete the following table of logical equivalences." :question/worked-solution "Recall the following properties of tautologies and contradictions:\n\n$$\n\\begin{aligned}A∨\\text{t}=\\text{t}\\, &  & A∧\\text{t} & =A \\\\ A∨\\text{c}=A\\, &  & A∧\\text{c} & =\\text{c} \\\\ \\text{t}∨\\text{t}=\\text{t}\\, &  & \\text{t}∧\\text{t} & =\\text{t} \\\\ \\text{t}∨\\text{c}=\\text{t}\\, &  & \\text{t}∧\\text{c} & =\\text{c} \\\\ \\text{c}∨\\text{t}=\\text{t}\\, &  & \\text{c}∧\\text{t} & =\\text{c} \\\\ \\text{c}∨\\text{c}=\\text{c}\\, &  & \\text{c}∧\\text{c} & =\\text{c}\\end{aligned}\n$$\n\nThe completed table is shown below.\n\n| Statement | Is Logically Equivalent To |\n| --- | --- |\n| $\\text{t}∧\\text{c}$ | $\\text{c}$ |\n| $\\text{c}∨\\text{c}$ | $\\text{c}$ |\n| $\\text{c}∧¬P$ | $\\text{c}$ |\n| $P∨\\text{c}$ | $P$ |" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9f8bb933-5fa1-5f5d-81ba-b5d5386295aa" "answer-field-f19ff78d-fe83-5887-b329-51a2db951790" "answer-field-c813975b-a85f-5a90-8b1c-717ddcf8b6fe" "answer-field-f231f80b-e868-51ef-88c4-aa06687be545"] :db/ensure [:question/validate]} {:db/id "answer-field-9f8bb933-5fa1-5f5d-81ba-b5d5386295aa" :answer-field/id #uuid "9f8bb933-5fa1-5f5d-81ba-b5d5386295aa" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-5e5ef93d-2e52-5082-a5a0-1004c88a1036" :answer-field/choices ["answer-28c26dde-1517-5b49-8912-b32b58a4b66f" "answer-5e5ef93d-2e52-5082-a5a0-1004c88a1036" "answer-ed9b80b9-37a0-5d36-bfe6-37f0764a3156" "answer-f09bd6bf-df85-5811-b53c-b9351efc67a0"] :db/ensure [:answer-field/validate]} {:db/id "answer-28c26dde-1517-5b49-8912-b32b58a4b66f" :answer/id #uuid "28c26