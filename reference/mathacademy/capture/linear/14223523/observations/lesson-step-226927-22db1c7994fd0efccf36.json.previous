"488\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMATHI-78\" x=\"808\" y=\"-211\"></use>\n <use xlink:href=\"#E3-MJMAIN-3D\" x=\"1354\" y=\"0\"></use>\n<g transform=\"translate(2410,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"720\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E3-MJMAIN-31\" x=\"110\" y=\"676\"></use>\n <use xlink:href=\"#E3-MJMATHI-6E\" x=\"60\" y=\"-686\"></use>\n</g>\n</g>\n<g transform=\"translate(3537,0)\">\n <use xlink:href=\"#E3-MJSZ2-2211\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(147,-1090)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMATHI-69\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-3D\" x=\"345\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-31\" x=\"1124\" y=\"0\"></use>\n</g>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMATHI-6E\" x=\"721\" y=\"1627\"></use>\n</g>\n <use xlink:href=\"#E3-MJMAIN-28\" x=\"4982\" y=\"0\"></use>\n<g transform=\"translate(5371,0)\">\n <use xlink:href=\"#E3-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMATHI-69\" x=\"809\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E3-MJMAIN-2212\" x=\"6510\" y=\"0\"></use>\n<g transform=\"translate(7511,0)\">\n <use xlink:href=\"#E3-MJMATHI-78\" x=\"24\" y=\"0\"></use>\n<g transform=\"translate(0,259)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-AF\" x=\"-70\" y=\"0\"></use>\n<g transform=\"translate(243.33524654895245,0) scale(0.2427625054254761,1)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-AF\"></use>\n</g>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-AF\" x=\"379\" y=\"0\"></use>\n</g>\n</g>\n<g transform=\"translate(8133,0)\">\n <use xlink:href=\"#E3-MJMAIN-29\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-32\" x=\"550\" y=\"583\"></use>\n</g>\n</g>\n</svg></span>\nwhere <span class=\"mjpage