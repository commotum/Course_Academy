-5017-92e2-f1c8d38e5a4c" :topic/math-academy-id 5204} :activity/steps [{:db/id #edb/ref 17592186521602 :step/content {:db/id #edb/ref 17592186521520 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e2a6f16-31aa-5059-b5b0-f9450b74c6de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=7" :db/id #edb/ref 17592186520791} {:answer/id #uuid "3558b18f-4849-5916-845e-fe6aa991a513" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=5" :db/id #edb/ref 17592186520876} {:answer/id #uuid "489962a8-1deb-53b2-935a-d63467602030" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=11" :db/id #edb/ref 17592186520927} {:answer/id #uuid "ceb274b6-f1d2-5d6b-bab5-c50bfb7607a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=12" :db/id #edb/ref 17592186521230} {:answer/id #uuid "d2ffdadb-e1e7-530b-b56a-cb1c31d4fe05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{xy}=8" :db/id #edb/ref 17592186521237}] :answer-field/correct {:db/id #edb/ref 17592186520791} :answer-field/id #uuid "15b52421-3d0b-5fa5-9d1e-da2b902cf171" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521335}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "84b31519-3642-53d1-a74c-ac68de0d653b" :question/math-academy-id "q-251802" :question/problem "Consider the two sets of $7$ paired observations in the table below.\n\n| **$\\,{x}_{i}\\,$** | $12$ | $4$ | $6$ | $10$ | $8$ | $15$ | $11$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| **$\\,{y}_{i}\\,$** | $20$ | $10$ | $5$ | $1$ | $7$ | $4$ | $9$ |\n\nGiven that ${\\sum }_{i=1}^{7}{x}_{i}{y}_{i}=535,$ calculate ${S}_{xy}.$" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of products of deviations from the means can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xy} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & ={\\sum }_{i}{x}_{i}{y}_{i}-\\frac{1}{n}({\\sum }_{i=1}^{n}{x}_{i})({\\sum }_{i=1}^{n}{y}_{i})\\end{aligned}\n$$\n\nFirst, we calculate the sum of the ${x}_{i}$ and ${y}_{i}:$\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}{x}_{i} & =12+4+6+10+8+15+11=66, \\\\ {\\sum }_{i=1}^{n}{y}_{i} & =20+10+5+1+7+4+9=56\\end{aligned}\n$$\n\nWe are given that ${\\sum }_{i=1}^{7}{x}_{i}{y}_{i}=535.$\n\nFinally, by substituting in the above formula, we get\n\n$$\n{S}_{xy}=535-\\frac{1}{7}(66)(56)=535-528=7.\n$$"} :step/id #uuid "5d03f414-94f2-58bc-a50f-eb3425afa07a" :step/next {:db/id #edb/ref 17592186521632}} {:db/id #edb/ref 17592186521617 :step/content {:db/id #edb/ref 17592186204442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db5304b5-083a-506d-804d-17b1e72be0cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "960" :db/id #edb/ref 17592186521256}] :answer-field/correct {:db/id #edb/ref 17592186521256} :answer-field/id #uuid "b0ce1b0a-97a1-51bf-bae4-ff211637bd0f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186202598}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2e106c63-c0cc-5875-983c-f82c045e7559" :question/math-academy-id "q-251426" :question/problem "Consider two sets of $25$ paired observations ${x}_{1},{x}_{2},…,{x}_{25},$ and ${y}_{1},{y}_{2},…,{y}_{25}.$ You are given that\n\n$$\n\\begin{aligned} & {\\sum }_{i=1}^{25}{x}_{i}=250,\\,{\\sum }_{i=1}^{25}{y}_{i}=265, \\\\  & {\\sum }_{i=1}^{25}{x}_{i}^{2}=3\\,460,\\,{\\sum }_{i=1}^{25}{y}_{i}^{2}=5\\,720.\\end{aligned}\n$$\n\nCalculate the sum of the squared deviations from the mean for the points ${x}_{i}.$\n\n${S}_{xx}=$\n{{field-1}}" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of squared deviations from the mean for the data ${x}_{i}$ can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xx} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2} \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}^{2}-\\frac{1}{n}{({\\sum }_{i=1}^{n}{x}_{i})}^{2}\\end{aligned}\n$$\n\nSubstituting the given statistics in the above formula, we get\n\n$$\n\\begin{aligned}{S}_{xx} & =3\\,460-\\frac{1}{25}(250)^{2} \\\\  & =3\\,460-2\\,500 \\\\  & =960.\\end{aligned}\n$$"} :step/id #uuid "7802b9e3-fd31-5e80-8ab7-f1535e9dbf56" :step/next {:db/id #edb/ref 17592186521602}} {:db/id #edb/ref 17592186521630 :step/content {:db/id #edb/ref 17592186521471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66aa0cf4-9fdd-5d95-be6b-811b502b95a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{yy}=22" :db/id #edb/ref 17592186520998} {:answer/id #uuid "8f3ad138-0924-5a40-8f81-cbba162c0f19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{yy}=16" :db/id #edb/ref 17592186521088} {:answer/id #uuid "b647c1b2-e8a2-513d-bca8-1ba7556ab769" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{yy}=21.3" :db/id #edb/ref 17592186521170} {:answer/id #uuid "ba06e549-bfbb-5699-a72e-3e553bcf6f6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{yy}=13" :db/id #edb/ref 17592186521178} {:answer/id #uuid "f4353feb-c770-5137-9c93-96535a82b4a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{S}_{yy}=19" :db/id #edb/ref 17592186521299}] :answer-field/correct {:db/id #edb/ref 17592186521088} :answer-field/id #uuid "97de8c2b-2160-5c30-92a5-23ff5b28889c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521400}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "26b0163b-edde-5aab-b2bd-a06d38a87337" :question/math-academy-id "q-251898" :question/problem "Consider the two sets of $8$ paired observations shown in the table below.\n\n| **$\\,{x}_{i}\\,$** | $9$ | $12$ | $10$ | $15$ | $12$ | $21$ | $6$ | $12$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| **$\\,{y}_{i}\\,$** | $3$ | $4$ | $5$ | $4$ | $7$ | $2$ | $3$ | $4$ |\n\nGiven that ${\\sum }_{i=1}^{8}{y}_{i}^{2}=144,$ calculate ${S}_{yy}.$" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of squared deviations from the mean for the data ${y}_{i}$ can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{yy} & ={\\sum }_{i=1}^{n}({y}_{i}-\\overset{―}{y})^{2} \\\\  & ={\\sum }_{i}{y}_{i}^{2}-\\frac{1}{n}{({\\sum }_{i=1}^{n}{y}_{i})}^{2}\\end{aligned}\n$$\n\nFirst, we calculate the sum of the ${y}_{i}$ data:\n\n$$\n{\\sum }_{i=1}^{8}{y}_{i}=3+4+5+4+7+2+3+4=32.\n$$\n\nWe are given that ${\\sum }_{i=1}^{8}{y}_{i}^{2}=144.$\n\nFinally, by substituting into the above formula, we get\n\n$$\n{S}_{yy}=144-\\frac{1}{8}(32)^{2}=144-128=16.\n$$"} :step/id #uuid "ae51bedd-deee-5ef3-b5f9-595f36d08dbe"} {:db/id #edb/ref 17592186521632 :step/content {:db/id #edb/ref 17592186521455 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e38fe49d-81c4-5be4-8d42-66e01917801d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.7" :db/id #edb/ref 17592186521274}] :answer-field/correct {:db/id #edb/ref 17592186521274} :answer-field/id #uuid "f25616a1-e3e9-5a57-bef3-4345308333c4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186521449}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "094cdd1f-e814-5164-bdf6-dc0f3e0f507e" :question/math-academy-id "q-251857" :question/problem "Consider two sets of $40$ paired observations ${x}_{1},{x}_{2},…,{x}_{40},$ and ${y}_{1},{y}_{2},…,{y}_{40}.$ You are given that\n\n$$\n\\begin{aligned}{S}_{xx}=54,\\,{S}_{yy}=35,\\,{S}_{xy}=188.\\end{aligned}\n$$\n\nThen, $Cov(x,y)=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ their covariance can be calculated as follows:\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{{S}_{xy}}{n},\\end{aligned}\n$$\n\nwhere ${S}_{xy}$ is the sum of products of the deviations of ${x}_{i}$ and ${y}_{i}$ from their means.\n\nWe are given that ${S}_{xy}=188.$ Substituting the given statistic in the above formula, we get\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{188}{40} \\\\  & =4.7.\\end{aligned}\n$$"} :step/id #uuid "b37e6950-25d6-5437-bec0-c80cada70611" :step/next {:db/id #edb/ref 17592186521640}} {:db/id #edb/ref 17592186521640 :step/content {:db/id #edb/ref 17592186521460 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f6a7f83-6364-5d0a-9fd6-ef7977380a2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4.6" :db/id #edb/ref 17592186520945}] :answer-field/correct {:db/id #edb/ref 17592186520945} :answer-field/id #uuid "203627a4-892f-5453-bd75-4c6fd9a28c76" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186521341}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1470b28d-5083-563f-9b26-d7812411f35b" :question/math-academy-id "q-251861" :question/problem "Consider two sets of $15$ paired observations ${x}_{1},{x}_{2},…,{x}_{15},$ and ${y}_{1},{y}_{2},…,{y}_{15}.$ You are given that\n\n$$\n\\begin{aligned}{S}_{xx}=105,\\,{S}_{yy}=81,\\,{S}_{xy}=69.\\end{aligned}\n$$\n\nThen, $Cov(x,y)=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ their covariance can be calculated as follows:\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{{S}_{xy}}{n},\\end{aligned}\n$$\n\nwhere ${S}_{xy}$ is the sum of products of the deviations of ${x}_{i}$ and ${y}_{i}$ from their means.\n\nWe are given that ${S}_{xy}=69.$ Substituting the given statistic in the above formula, we get\n\n$$\n\\begin{aligned}Cov(x,y) & =\\frac{69}{15} \\\\  & =4.6.\\end{aligned}\n$$"} :step/id #uuid "c7b1248b-f25e-5efc-bec5-63e8214005ee" :step/next {:db/id #edb/ref 17592186521630}}] :activity/title "Sums of Squares" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186520752}]}
