#{[{:activity/first-step {:db/id #edb/ref 17592186074775} :activity/id #uuid "e7d0e915-5cc0-5d0f-b4c6-027cb6220aa3" :activity/scope {:db/id #edb/ref 17592186049463 :topic/id #uuid "f762d717-d0f3-5d60-8a4d-561cc023f344" :topic/math-academy-id 524} :activity/steps [{:db/id #edb/ref 17592186074775 :step/content {:db/id #edb/ref 17592186075029 :tutorial/content "Given a number, its **additive inverse** is the number we need to add to get zero.\nTo find the additive inverse of a number, we change its sign by placing a minus symbol $({\\color{red}{-}})$ in front of it.\n\nFor example, to find the additive inverse of $5$, we obtain\n\n$$\n{\\color{red}{-}}\\,(5) = -5\n$$\n\nTo check our work, we add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n5+(-5) = 5-5 = 0 \\quad {\\color{green}\\checkmark}\n$$" :tutorial/id #uuid "21fd73d9-f9b8-5ef8-9e18-9ba21d6d8d79" :tutorial/math-academy-id 8012 :tutorial/title "Introduction"} :step/id #uuid "c1f41837-dee8-5f07-9c9f-5cfaebd69d2e" :step/math-academy-id 53555 :step/next {:db/id #edb/ref 17592186074776}} {:db/id #edb/ref 17592186074776 :step/content {:db/id #edb/ref 17592186073820 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073437 :question/id #uuid "735e0a05-bc90-5b18-b096-d51d9f9c50e3" :question/math-academy-id "e-12780"} :knowledge-point/id #uuid "d7d26bc9-6f89-5da4-b8a9-6be6f4280f81" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050421}] :knowledge-point/questions [{:db/id #edb/ref 17592186074498} {:db/id #edb/ref 17592186074499}] :knowledge-point/title "Finding the Additive Inverse of a Positive Integer"} :step/id #uuid "6255e96d-283e-52d1-815a-3ba256caf351" :step/math-academy-id 53556 :step/next {:db/id #edb/ref 17592186074777}} {:db/id #edb/ref 17592186074777 :step/content {:db/id #edb/ref 17592186075030 :tutorial/content "To find the additive inverse of a negative number, we can use the same process.\n\nFor instance, to find the additive inverse of the number $-3$, we change its sign by placing a minus symbol $({\\color{red}{-}})$ in front of it.\nSo, we obtain\n\n$$\n{\\color{red}{-}}\\,(-3) = 3\n$$\n\nAgain, we check our work by adding the inverse to the original number. If we're correct, we should get zero.\n\n$$\n(-3)+3 = -3+3 = 0 \\quad {\\color{green}\\checkmark}\n$$" :tutorial/id #uuid "d30313d5-d29e-5eea-b11c-0619439becb0" :tutorial/math-academy-id 8013 :tutorial/title "Finding the Additive Inverse of a Negative Integer"} :step/id #uuid "29da515a-cf3c-5833-83f4-fdcc7d1ce495" :step/math-academy-id 53559 :step/next {:db/id #edb/ref 17592186074778}} {:db/id #edb/ref 17592186074778 :step/content {:db/id #edb/ref 17592186073821 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073438 :question/id #uuid "de14e5df-9b12-5878-a134-9b02db1d5b5d" :question/math-academy-id "e-12781"} :knowledge-point/id #uuid "b38f30b0-9e05-510f-9ba6-928ab1b8482b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048546}] :knowledge-point/questions [{:db/id #edb/ref 17592186074497} {:db/id #edb/ref 17592186074500}] :knowledge-point/title "Finding the Additive Inverse of a Negative Integer"} :step/id #uuid "d90caf33-37bf-5639-9bbb-33de68320604" :step/math-academy-id 53560 :step/next {:db/id #edb/ref 17592186074779}} {:db/id #edb/ref 17592186074779 :step/content {:db/id #edb/ref 17592186073822 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073439 :question/id #uuid "8b152054-aec8-58f3-9a7a-e435e49fe8c9" :question/math-academy-id "e-12782"} :knowledge-point/id #uuid "b88b2def-7312-5076-9ff3-60319d37f1d6" :knowledge-point/questions [{:db/id #edb/ref 17592186074501} {:db/id #edb/ref 17592186074502}] :knowledge-point/title "Finding the Additive Inverse of a Decimal or Fraction"} :step/id #uuid "0a3e5261-c30f-51be-aebe-8a0790994019" :step/math-academy-id 53563 :step/next {:db/id #edb/ref 17592186074780}} {:db/id #edb/ref 17592186074780 :step/content {:db/id #edb/ref 17592186075031 :tutorial/content "On a number line, a number and its additive inverse are at the same distance from zero but on opposite sides. Remember that the distance of a number from zero is given by its absolute value.\n\nFor instance, the only two numbers that are at distance of $4$ from zero are $4$ and $-4$. So, $-4$ is the additive inverse of $4$ (and vice versa).\n\n![](images/3c/3cc1cf9fa82a16d0b8942ba8d30de1c73e019d6c8b740625857bbb7cb5c7f8b0.png)" :tutorial/id #uuid "59a5b145-f6a7-5571-9977-dbdba3ae9fe9" :tutorial/math-academy-id 8014 :tutorial/title "Identifying an Additive Inverse on a Number Line"} :step/id #uuid "c2ccbfbc-2ac7-5c71-8d3a-0a6268b08a8b" :step/math-academy-id 53566 :step/next {:db/id #edb/ref 17592186074781}} {:db/id #edb/ref 17592186074781 :step/content {:db/id #edb/ref 17592186073823 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073440 :question/id #uuid "f0a3790d-c67d-5b70-b33e-ce71f8606ad3" :question/math-academy-id "e-12783"} :knowledge-point/id #uuid "327a7c63-425d-511a-b629-be5d407cbcc4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049429}] :knowledge-point/questions [{:db/id #edb/ref 17592186074503} {:db/id #edb/ref 17592186074504}] :knowledge-point/title "Identifying an Additive Inverse on a Number Line"} :step/id #uuid "654a216e-9eb3-5a92-8889-48d443a8d7aa" :step/math-academy-id 53567}] :activity/title "Additive Inverses of Numbers" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073944}]}
