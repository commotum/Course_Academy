[[:db/retract 17592186074779 :step/next 17592186074780] [:db/retract 17592186073944 :activity/steps 17592186074780] [:db/retract 17592186073944 :activity/steps 17592186074781] [:db/retract 17592186074780 :step/next 17592186074781] {:db/id 17592186073820 :knowledge-point/questions ["question-6a68349c-9da7-5bc6-9613-b7d43e64402e" "question-de0a6181-6738-5d17-97f1-3a34c3d50cc1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073437 :question/math-academy-id "e-22709" :question/problem "What is the additive inverse of $40?$" :question/worked-solution "To find the additive inverse of the number $40,$ we change its sign by placing a minus symbol $({\\color{red}{-}})$ in front of it. So, we obtain \n\n$$\n{\\color{red}{-}}\\,(40) = -40.\n$$\n\nTo check our work, we add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n40+(-40) = 40-40 = 0 \\quad {\\color{green}\\checkmark}\n$$" :db/ensure [:question/validate]} {:db/id 17592186073821 :knowledge-point/questions ["question-b6e7d799-a169-5962-a533-496e435fb78b" "question-d1ca34c0-e607-5050-a46f-b9f14c2f4fa4" "question-9ee27692-b513-522a-bc00-7922312d42de"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073438 :question/math-academy-id "e-22710" :question/problem "What number can be added to $-28$ to get a sum of $0?$" :question/worked-solution "The number that can be added to $-28$ to give $0$ is the additive inverse of $-28.$\n\nTo find the additive inverse of the number $-28,$ we change its sign by placing a minus symbol $({\\color{red}{-}})$ in front of it. So, we obtain \n\n$$\n{\\color{red}{-}}\\,(-28) = 28.\n$$\n\nTo check our work, we add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n(-28)+28 = -28+28= 0 \\quad {\\color{green}\\checkmark}\n$$" :db/ensure [:question/validate]} {:db/id 17592186073822 :knowledge-point/questions ["question-88917821-51ee-5182-8fea-321431d2835e" "question-27906a11-2ce1-51ea-addf-43b430fbb669"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073439 :question/math-academy-id "e-22711" :question/problem "What is the additive inverse of $0.72?$" :question/worked-solution "To find the additive inverse of the number $0.72,$ we change its sign by placing a minus symbol $({\\color{red}{-}})$ in front of it. So, we obtain \n\n$$\n{\\color{red}{-}}\\,(0.72) = -0.72.\n$$\n\nTo check our work, we add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n0.72+(-0.72) = 0.72-0.72 = 0 \\quad {\\color{green}\\checkmark}\n$$" :db/ensure [:question/validate]} {:db/id "question-6a68349c-9da7-5bc6-9613-b7d43e64402e" :question/id #uuid "6a68349c-9da7-5bc6-9613-b7d43e64402e" :question/math-academy-id "q-101562" :question/problem "What is the additive inverse of $9?$" :question/worked-solution "To find the additive inverse of the number $9$, we change its sign by placing a minus symbol $(-)$ in front of it. So, we obtain \n\n$$\n-\\,(9)=-9.\n$$\n\nTo check our work, we simply add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n9+(-9)=9-9=0\\,✓\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ae50759e-0b98-5ede-a37c-339b48300f74"] :db/ensure [:question/validate]} {:db/id "answer-field-ae50759e-0b98-5ede-a37c-339b48300f74" :answer-field/id #uuid "ae50759e-0b98-5ede-a37c-339b48300f74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-96e6b5cd-036a-5554-a639-6fdc855253d8" :answer-field/choices ["answer-cf3850fb-3390-58c6-9cc1-2d9a1b0ea2a2" "answer-96e6b5cd-036a-5554-a639-6fdc855253d8" "answer-76715657-5ef3-5534-8c3d-34cc4519f7fd" "answer-33b8b601-0d35-5f25-8075-c8cdd14bc3bc" "answer-84ec5379-04a9-5bc1-ba95-262607deae42"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf3850fb-3390-58c6-9cc1-2d9a1b0ea2a2" :answer/id #uuid "cf3850fb-3390-58c6-9cc1-2d9a1b0ea2a2" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/va