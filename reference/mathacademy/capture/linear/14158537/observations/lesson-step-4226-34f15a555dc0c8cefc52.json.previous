\"></use>\n <use xlink:href=\"#E4-MJMAIN-2B\" x=\"4074\" y=\"0\"></use>\n<g transform=\"translate(5074,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E4-MJMATHI-61\"></use>\n</g>\n</g>\n</g>\n <use transform=\"scale(0.707)\" xlink:href=\"#E4-MJMAIN-32\" x=\"748\" y=\"583\"></use>\n</g>\n <use xlink:href=\"#E4-MJMAIN-3D\" x=\"6335\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-28\" x=\"7392\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMATHI-78\" x=\"7781\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2B\" x=\"8576\" y=\"0\"></use>\n<g transform=\"translate(9577,0)\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n<g fill=\"blue\" stroke=\"blue\">\n <use xlink:href=\"#E4-MJMATHI-61\"></use>\n</g>\n</g>\n</g>\n</g>\n<g transform=\"translate(10106,0)\">\n <use xlink:href=\"#E4-MJMAIN-29\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E4-MJMAIN-32\" x=\"550\" y=\"583\"></use>\n</g>\n</g>\n</svg></span> </p>\n<p>To illustrate, let's factor the expression <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"11.719ex\" height=\"2.676ex\" style=\"vertical-align: -0.505ex;\" viewBox=\"0 -934.9 5045.8 1152.1\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-5-Title\">\n<title id=\"MathJax-SVG-5-Title\">x^2+6x+9</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E5-MJMATHI-78\" d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40