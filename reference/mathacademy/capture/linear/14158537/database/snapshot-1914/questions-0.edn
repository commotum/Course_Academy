ned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{n}^{2}-2\\cdot 4n+{4}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=4.$ This gives\n\n$$\n\\begin{aligned}(n-4)^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482612 :knowledge-point/_questions [{:db/id #edb/ref 17592186064326 :knowledge-point/id #uuid "457399ac-1ede-551f-968b-9ef270a67d0b" :knowledge-point/title "Factoring a Trinomial Generated by the Square of a Difference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33ad99fc-1f72-5f18-91bc-a87ebce61eca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-20)^{2}" :db/id #edb/ref 17592186481901} {:answer/id #uuid "7ed35112-5230-5213-899f-b5c028d022e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5)^{2}" :db/id #edb/ref 17592186482066} {:answer/id #uuid "8509ee32-0054-5a82-9df9-6ca422de6360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5)^{2}" :db/id #edb/ref 17592186482085} {:answer/id #uuid "997f08c7-8c76-5407-ad33-a50dbbf851cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-10)^{2}" :db/id #edb/ref 17592186482138} {:answer/id #uuid "b6c3f97e-3782-58c0-ad2f-f95a54618783" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+10)^{2}" :db/id #edb/ref 17592186482208}] :answer-field/correct {:answer/id #uuid "997f08c7-8c76-5407-ad33-a50dbbf851cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-10)^{2}" :db/id #edb/ref 17592186482138} :answer-field/id #uuid "7b0dc3f1-b5b1-5200-a64b-568ebc36fda2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482444}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f18cf588-d703-5104-bc39-415b94a76959" :question/math-academy-id "q-31845" :question/problem "${x}^{2}+100-20x$ is equivalent to" :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n{x}^{2}+100-20x={x}^{2}-20x+100.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{x}^{2}-20x+{10}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{x}^{2}-2\\cdot 10x+{10}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=10.$ This gives\n\n$$\n\\begin{aligned}(x-10)^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482579 :knowledge-point/_questions [{:db/id #edb/ref 17592186064325 :knowledge-point/id #uuid "373d4ad5-ef39-5f03-bba4-d9be901e2587" :knowledge-point/title "Factoring a Trinomial Generated by the Square of a Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b2e2ed4-8577-5b51-bcd5-fe6c9eb1aee1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4-x)^{2}" :db/id #edb/ref 17592186481988} {:answer/id #uuid "85da8dec-b7f8-5bc2-a8cc-1e1fb0c3211c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8-x)^{2}" :db/id #edb/ref 17592186482088} {:answer/id #uuid "94a416e6-2fec-5d8c-84ab-cd7d3ed32ea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+4)^{2}" :db/id #edb/ref 17592186482123} {:answer/id #uuid "9d6e43d3-232d-52f2-810c-0a514fc301c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+8)^{2}" :db/id #edb/ref 17592186482149} {:answer/id #uuid "e80f03a3-463c-5484-906b-72bc65a58138" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+16)^{2}" :db/id #edb/ref 17592186482331}] :answer-field/correct {:answer/id #uuid "9d6e43d3-232d-52f2-810c-0a514fc301c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+8)^{2}" :db/id #edb/ref 17592186482149} :answer-field/id #uuid "7552c985-a452-590b-bdd7-491a346c7e14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b2c7f8cb-2d06-5a06-8c22-c48f3e03b4b4" :question/math-academy-id "q-44087" :question/problem "$16x+64+{x}^{2}=$" :question/worked-solution "The \"square of a sum\" formula states that\n\n$$\n{x}^{2}+2ax+{a}^{2}=(x+a)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n16x+64+{x}^{2}={x}^{2}+16x+64.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{x}^{2}+16x+{8}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{x}^{2}+2\\cdot 8x+{8}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of sum formula with $a=8.$ This gives\n\n$$\n\\begin{aligned}(x+8)^{2}.\\end{aligned}\n$$"}]}
