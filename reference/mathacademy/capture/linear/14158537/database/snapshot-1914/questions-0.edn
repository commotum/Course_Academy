#{[{:db/id #edb/ref 17592186063960 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064325 :knowledge-point/id #uuid "373d4ad5-ef39-5f03-bba4-d9be901e2587" :knowledge-point/title "Factoring a Trinomial Generated by the Square of a Sum"}] :question/id #uuid "d496f23e-6ef7-5ec2-bb6c-054759a5b033" :question/math-academy-id "e-1327" :question/problem "Factor $x^2 + 12x + 36.$" :question/worked-solution "The \"square of a sum\" formula states that\n\n$$\nx^2 + {\\color{red}{2}}{\\color{blue}{a}} x + a^2 =  (x+{\\color{blue}{a}})^2 .\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\nx^2 + 12x + 36.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{x}^{2}+12x+{6}^{2} & \\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{x}^{2}+2\\cdot 6x+{6}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of sum formula with ${\\color{blue}{a}} = {\\color{blue}{6}}.$ This gives\n\n$$\n\\begin{aligned}(x+6)^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063961 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064326 :knowledge-point/id #uuid "457399ac-1ede-551f-968b-9ef270a67d0b" :knowledge-point/title "Factoring a Trinomial Generated by the Square of a Difference"}] :question/id #uuid "29cbd59e-9eff-5439-9551-4520f68707b1" :question/math-academy-id "e-1328" :question/problem "Factor $p^2 - 10p + 25.$" :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\np^2 - {\\color{red}{2}}{\\color{blue}{a}} p + a^2 =  (p-{\\color{blue}{a}})^2 .\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\np^2 - 10p + 25.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{p}^{2}-10p+{5}^{2}\\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{p}^{2}-2\\cdot 5p+{5}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with ${\\color{blue}{a}} = {\\color{blue}{5}}.$ This gives\n\n$$\n\\begin{aligned}(p-5)^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063962 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064327 :knowledge-point/id #uuid "48f257af-1f00-5cf9-89cd-3d44d21482ec" :knowledge-point/title "Factoring a Trinomial with Fractions"}] :question/id #uuid "2fb03f0f-25c2-57a6-9e33-da837af2f339" :question/math-academy-id "e-1329" :question/problem "Factor the expression $y^2 + \\dfrac{2}{5}y + \\dfrac{1}{25}.$" :question/worked-solution "The \"square of a sum\" formula states that\n\n$$\nx^2 + {\\color{red}{2}}{\\color{blue}{a}} x + a^2 =  (x+{\\color{blue}{a}})^2 .\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\ny^2 + \\dfrac{2}{5}y + \\dfrac{1}{25}.\n$$\n\nFirst, we write the constant term as a perfect square:\n\n$$\n\\begin{aligned}{y}^{2}+\\frac{2}{5}y+{(\\frac{1}{5})}^{2} & \\end{aligned}\n$$\n\nThen, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}{y}^{2}+2\\cdot \\frac{1}{5}y+{(\\frac{1}{5})}^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of sum formula with ${\\color{blue}{a}} = {\\color{blue}{\\dfrac 1 5}}.$ This gives\n\n$$\n\\begin{aligned}{(y+\\frac{1}{5})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482518 :knowledge-point/_questions [{:db/id #edb/ref 17592186064325 :knowledge-point/id #uuid "373d4ad5-ef39-5f03-bba4-d9be901e2587" :knowledge-point/title "Factoring a Trinomial Generated by the Square of a Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ffa3d12-0822-568b-8e93-b5d8b1c6fd9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p+7)^{2}" :db/id #edb/ref 17592186481861} {:answer/id #uuid "33223ce6-b3e6-59ce-b2da-d2c0df8d69d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(p+14)^{2}" :db/id #edb