#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186116193} :activity/id #uuid "83238460-ae6a-5692-b2cc-36d335dfb4f5" :activity/scope {:db/id #edb/ref 17592186048691 :topic/id #uuid "b50c8541-b540-572c-b4ed-91f2bd4fcec6" :topic/math-academy-id 1654} :activity/steps [{:db/id #edb/ref 17592186116193 :step/content {:db/id #edb/ref 17592186116519 :tutorial/content "The graph of any cubic function $y = f(x)= ax^3 + bx^2 + cx +d$ (where $a >0$) has a characteristic inverted ${\\textsf{S}}$-shape, with $y$-values ranging from $-\\infty$ to $+\\infty.$ This means that every such function has *at least* one real root and *at most* three distinct roots.\n\nFor instance, suppose that we want to plot the graph of $y = x^3-x.$ Then we set $y=0$ to find the roots:\n\n$$\n\\begin{aligned}{x}^{3}-x & =0 \\\\ x({x}^{2}-1) & =0 \\\\ x(x-1)(x+1) & =0\\end{aligned}\n$$\n\nBy the zero-product rule, we get three distinct roots $x=0, -1, 1.$ \n\nSo, we draw an inverted ${\\textsf{S}}$-shaped graph that passes through these three roots, as follows:\n\n![](images/ec/ec5e7195e9584059755c8462de65ddd9bba038f38b18d5fe301dc392e1cdc9b9.png)" :tutorial/id #uuid "d815d87e-e244-5418-ae9a-0a7801e0a14c" :tutorial/math-academy-id 3749 :tutorial/title "Introduction"} :step/id #uuid "7e549eab-929e-5df2-b16b-e4c2f66fa929" :step/math-academy-id 21017 :step/next {:db/id #edb/ref 17592186116194}} {:db/id #edb/ref 17592186116194 :step/content {:db/id #edb/ref 17592186115287 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115110 :question/id #uuid "46e2f515-2220-585d-927e-7f8a91af7bcb" :question/math-academy-id "e-5800"} :knowledge-point/id #uuid "eea927d4-f52d-5583-879f-d70a0f40a1e0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049244} {:db/id #edb/ref 17592186050294}] :knowledge-point/questions [{:db/id #edb/ref 17592186115662} {:db/id #edb/ref 17592186115679} {:db/id #edb/ref 17592186554604} {:db/id #edb/ref 17592186554606} {:db/id #edb/ref 17592186554625}] :knowledge-point/title "Graphing a Factored Cubic Curve with Positive Leading Coefficient"} :step/id #uuid "1cd0dd15-986d-5f20-b8b1-45893745126a" :step/math-academy-id 21019 :step/next {:db/id #edb/ref 17592186116195}} {:db/id #edb/ref 17592186116195 :step/content {:db/id #edb/ref 17592186115288 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115111 :question/id #uuid "3723bac3-ba0f-5c81-a59f-cf26836d7671" :question/math-academy-id "e-5801"} :knowledge-point/id #uuid "5914ea8b-a7f5-5fe0-8060-34cb47f5d401" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048497}] :knowledge-point/questions [{:db/id #edb/ref 17592186115649} {:db/id #edb/ref 17592186115658} {:db/id #edb/ref 17592186554544} {:db/id #edb/ref 17592186554600}] :knowledge-point/title "Graphing an Expanded Cubic Curve with Positive Leading Coefficient"} :step/id #uuid "7e5f69ce-e04e-5a3f-838b-e51da5ec3504" :step/math-academy-id 21020 :step/next {:db/id #edb/ref 17592186116197}} {:db/id #edb/ref 17592186116197 :step/content {:db/id #edb/ref 17592186116520 :tutorial/content "The graph of any cubic function $y = f(x)= ax^3 + bx^2 + cx +d$ (where $a <0$)  has a characteristic ${\\textsf{S}}$-shape, with $y$-values ranging from $+\\infty$ to $-\\infty.$ This means that every such function has *at least* one real root and *at most* three distinct roots. \n\nFor instance, suppose that we want to plot the graph of $y = -x^3+4x.$ Then we set $y=0$ to find the roots:\n\n$$\n\\begin{aligned}-{x}^{3}+4x & =0 \\\\ -x({x}^{2}-4) & =0 \\\\ -x(x-2)(x+2) & =0\\end{aligned}\n$$\n\nSo by the zero-product rule, we get three distinct roots $x=0, -2, 2.$ \n\nSo, we draw an ${\\textsf{S}}$-shape that passes through these three roots, as follows:\n\n![](images/7f/7ff179ef8c305c460c8a2dca0d7792c2297677bd07b737645130faf95497fa71.png)" :tutorial/id #uuid "219631b8-7bf6-5699-915e-b6bdd5d81166" :tutorial/math-academy-id 3750 :tutorial/title "Negative Cubic Curves With Three Distinct Real Roots"} :step/id #uuid "211d67ef-65f7-5d4e-bb56-4cd7e51107b4" :step/math-academy-id 21022 :step/next {:db/id #edb/ref 17592186116198}} {:db/id #edb/ref 17592186116198 :step/content {:db/id #edb/ref 17592186115289 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115113 :question/id #uuid "11960e10-03d2-57d2-bff1-d5d4285f4e98" :question/math-academy-id "e-5803"} :knowledge-point/id #uuid "38c7027c-8dc4-5d3a-9a96-5d33d3b8c1c7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050818}] :knowledge-point/questions [{:db/id #edb/ref 17592186115664} {:db/id #edb/ref 17592186115689} {:db/id #edb/ref 17592186554546} {:db/id #edb/ref 17592186554578}] :knowledge-point/title "Graphing a Factored Cubic Curve with Negative Leading Coefficient"} :step/id #uuid "2dfd5420-7487-525a-b02e-a75f6aef34d1" :step/math-academy-id 21023 :step/next {:db/id #edb/ref 17592186116200}} {:db/id #edb/ref 17592186116200 :step/content {:db/id #edb/ref 17592186115291 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115114 :question/id #uuid "d73c8c81-0fc1-5722-a134-65664b66b3d8" :question/math-academy-id "e-5804"} :knowledge-point/id #uuid "e03f532e-bf46-5933-baf3-b59e42b7cc67" :knowledge-point/questions [{:db/id #edb/ref 17592186115663} {:db/id #edb/ref 17592186115680} {:db/id #edb/ref 17592186554628} {:db/id #edb/ref 17592186554637}] :knowledge-point/title "Graphing an Expanded Cubic Curve with Negative Leading Coefficient"} :step/id #uuid "d35aa79d-aba7-5922-aa9e-1ace5814c00c" :step/math-academy-id 21025}] :activity/title "Graphing Cubic Curves Containing Three Distinct Real Roots" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115447}]}
