#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186116193} :activity/id #uuid "83238460-ae6a-5692-b2cc-36d335dfb4f5" :activity/scope {:db/id #edb/ref 17592186048691 :topic/id #uuid "b50c8541-b540-572c-b4ed-91f2bd4fcec6" :topic/math-academy-id 1654} :activity/steps [{:db/id #edb/ref 17592186116193 :step/content {:db/id #edb/ref 17592186116519 :tutorial/content "The graph of any cubic function $y = f(x)= ax^3 + bx^2 + cx +d$ (where $a >0$) has a characteristic inverted ${\\textsf{S}}$-shape, with $y$-values ranging from $-\\infty$ to $+\\infty.$ This means that every such function has *at least* one real root and *at most* three distinct roots.\n\nFor instance, suppose that we want to plot the graph of $y = x^3-x.$ Then we set $y=0$ to find the roots:\n\n$$\n\\begin{aligned}{x}^{3}-x & =0 \\\\ x({x}^{2}-1) & =0 \\\\ x(x-1)(x+1) & =0\\end{aligned}\n$$\n\nBy the zero-product rule, we get three distinct roots $x=0, -1, 1.$ \n\nSo, we draw an inverted ${\\textsf{S}}$-shaped graph that passes through these three roots, as follows:\n\n![](images/ec/ec5e7195e9584059755c8462de65ddd9bba038f38b18d5fe301dc392e1cdc9b9.png)" :tutorial/id #uuid "d815d87e-e244-5418-ae9a-0a7801e0a14c" :tutorial/math-academy-id 3749 :tutorial/title "Introduction"} :step/id #uuid "7e549eab-929e-5df2-b16b-e4c2f66fa929" :step/math-academy-id 21017 :step/next {:db/id #edb/ref 17592186116194}} {:db/id #edb/ref 17592186116194 :step/content {:db/id #edb/ref 17592186115287 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115110 :question/id #uuid "46e2f515-2220-585d-927e-7f8a91af7bcb" :question/math-academy-id "e-5800"} :knowledge-point/id #uuid "eea927d4-f52d-5583-879f-d70a0f40a1e0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049244} {:db/id #edb/ref 17592186050294}] :knowledge-point/questions [{:db/id #edb/ref 17592186115662} {:db/id #edb/ref 17592186115679} {:db/id #edb/ref 17592186554604} {:db/id #edb/ref 17592186554606} {:db/id #edb/ref 17592186554625}] :knowledge-point/title "Graphing a Factored Cubic Curve with Positive Leading Coefficient"} :step/id #uuid "1cd0dd15-986d-5f20-b8b1-45893745126a" :step/math-academy-id 21019 :step/next {:db/id #edb/ref 17592186116195}} {:db/id #edb/ref 17592186116195 :step/content {:db/id #edb/ref 17592186115288 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115111 :question/id #uuid "3723bac3-ba0f-5c81-a59f-cf26836d7671" :question/math-academy-id "e-5801"} :knowledge-point/id #uuid "5914ea8b-a7f5-5fe0-8060-34cb47f5d401" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048497}] :knowledge-point/questions [{:db/id #edb/ref 17592186115649} {:db/id #edb/ref 17592186115658} {:db/id #edb/ref 17592186554544} {:db/id #edb/ref 17592186554600} {:db/id #edb/ref 17592186570708}] :knowledge-point/title "Graphing an Expanded Cubic Curve with Positive Leading Coefficient"} :step/id #uuid "7e5f69ce-e04e-5a3f-838b-e51da5ec3504" :step/math-academy-id 21020 :step/next {:db/id #edb/ref 17592186116197}} {:db/id #edb/ref 17592186116197 :step/content {:db/id #edb/ref 17592186116520 :tutorial/content "The graph of any cubic function $y = f(x)= ax^3 + bx^2 + cx +d$ (where $a <0$)  has a characteristic ${\\textsf{S}}$-shape, with $y$-values ranging from $+\\infty$ to $-\\infty.$ This means that every such function has *at least* one real root and *at most* three distinct roots. \n\nFor instance, suppose that we want to plot the graph of $y = -x^3+4x.$ Then we set $y=0$ to find the roots:\n\n$$\n\\begin{aligned}-{x}^{3}+4x & =0 \\\\ -x({x}^{2}-4) & =0 \\\\ -x(x-2)(x+2) & =0\\end{aligned}\n$$\n\nSo by the zero-product rule, we get three distinct roots $x=0, -2, 2.$ \n\nSo, we draw an ${\\textsf{S}}$-shape that passes through these three roots, as follows:\n\n![](images/7f/7ff179ef8c305c460c8a2dca0d7792c2297677bd07b737645130faf95497fa71.png)" :tutorial/id #uuid "219631b8-7bf6-5699-915e-b6bdd5d81166" :tutorial/math-academy-id 3750 :tutorial/title "Negative Cubic Curves With Three Distinct Real Roots"} :step/id #uuid "211d67ef-65f7-5d4e-bb56-4cd7e51107b4" :step/math-academy-id 21022 :step/next {:db/id #edb/ref 17592186116198}} {:db/id #edb/ref 17592186116198 :step/content {:db/id #edb/ref 17592186115289 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115113 :question/id #uuid "11960e10-03d2-57d2-bff1-d5d4285f4e98" :question/math-academy-id "e-5803"} :knowledge-point/id #uuid "38c7027c-8dc4-5d3a-9a96-5d33d3b8c1c7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050818}] :knowledge-point/questions [{:db/id #edb/ref 17592186115664} {:db/id #edb/ref 17592186115689} {:db/id #edb/ref 17592186554546} {:db/id #edb/ref 17592186554578} {:db/id #edb/ref 17592186570707}] :knowledge-point/title "Graphing a Factored Cubic Curve with Negative Leading Coefficient"} :step/id #uuid "2dfd5420-7487-525a-b02e-a75f6aef34d1" :step/math-academy-id 21023 :step/next {:db/id #edb/ref 17592186116200}} {:db/id #edb/ref 17592186116200 :step/content {:db/id #edb/ref 17592186115291 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115114 :question/id #uuid "d73c8c81-0fc1-5722-a134-65664b66b3d8" :question/math-academy-id "e-5804"} :knowledge-point/id #uuid "e03f532e-bf46-5933-baf3-b59e42b7cc67" :knowledge-point/questions [{:db/id #edb/ref 17592186115663} {:db/id #edb/ref 17592186115680} {:db/id #edb/ref 17592186554628} {:db/id #edb/ref 17592186554637} {:db/id #edb/ref 17592186570715}] :knowledge-point/title "Graphing an Expanded Cubic Curve with Negative Leading Coefficient"} :step/id #uuid "d35aa79d-aba7-5922-aa9e-1ace5814c00c" :step/math-academy-id 21025}] :activity/title "Graphing Cubic Curves Containing Three Distinct Real Roots" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186115447}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186570846} :activity/id #uuid "8e96de79-87d9-54d2-95f8-f4785b140574" :activity/scope {:db/id #edb/ref 17592186048691 :topic/id #uuid "b50c8541-b540-572c-b4ed-91f2bd4fcec6" :topic/math-academy-id 1654} :activity/steps [{:db/id #edb/ref 17592186570804 :step/content {:db/id #edb/ref 17592186570715 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01480b4d-e433-5319-b7dd-b2b93fad7110" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e3/e38995dc7545fe0b32a7214438397304b0fc2a3dd3b589f387ad7230b7740ee9.png" :db/id #edb/ref 17592186570121} {:answer/id #uuid "0ecb6cc8-9b1a-53ec-8594-8c498c333227" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/12/1222fb6503f602a7da1b84d73fa8ced3474ae7f65b695d9e71fba267712278b4.png" :db/id #edb/ref 17592186570148} {:answer/id #uuid "376e8047-36e1-5ce3-92f5-7608828fe9a4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/21/21dec37151f40778b8f094d3ae68cd8716c993535e53496cf7f148817c72e345.png" :db/id #edb/ref 17592186570220} {:answer/id #uuid "d264c026-fbc5-505c-b381-13549290748d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/84/8468568ef0a3848797191a51080e0a904f9a739f659286358341bb218012fb43.png" :db/id #edb/ref 17592186570492} {:answer/id #uuid "f972b644-cb9f-5d42-8c7d-406b85ac2b37" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/19/19a0cce27a712f55a6430100fe29d4ea1a323709f1a398fc2ce48c1b4fe3206b.png" :db/id #edb/ref 17592186570564}] :answer-field/correct {:db/id #edb/ref 17592186570220} :answer-field/id #uuid "4d149e3a-5f29-5983-a00c-27e7be6451ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570608}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2c01baff-ab5f-57ff-be23-ce994353bbde" :question/math-academy-id "q-28365" :question/problem "Given that $x=2$ is a root of $f(x)=-{x}^{3}+7{x}^{2}-14x+8,$ which of the following curves is generated by $y=f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, we notice that the function is a negative cubic curve because the coefficient of ${x}^{3}$ is negative.\n\nWe are told that $x=2$ is a root of $f(x),$ which means that $(x-2)$ is a factor of $f(x).$ So, to find the other roots of $f(x)$ we use synthetic division to divide $f(x)$ by $(x-2):$\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ 2 & -1 & 7 & -14 & 8 \\\\  &  & -2 & 10 & -8 \\\\  & -1 & 5 & -4 & 0\\end{aligned}\n$$\n\nWe obtain \n\n$$\n\\begin{aligned}f(x) & =(x-2)(-{x}^{2}+5x-4) \\\\  & =-(x-2)({x}^{2}-5x+4) \\\\  & =-(x-2)(x-1)(x-4).\\end{aligned}\n$$\n\nSetting the factors equal to zero, we find that the other roots of $f(x)$ are $x=1$ and $x=4.$ \n\nNow, let's find the $y$-intercept. To do that, we substitute $x=0,$ and we get\n\n$$\n\\begin{aligned}y & =-(0-2)(0-1)(0-4) \\\\  & =-(-2)(-1)(-4) \\\\  & =8.\\end{aligned}\n$$\n\nSo, we draw an $S$-shaped graph that passes through the three roots $x=1,2,4$ and has the $y$-intercept $y=8,$ as follows:\n\n![](images/21/21dec37151f40778b8f094d3ae68cd8716c993535e53496cf7f148817c72e345.png)"} :step/id #uuid "2446ca1c-5282-5cff-a939-7255d0f9c35b" :step/next {:db/id #edb/ref 17592186570859}} {:db/id #edb/ref 17592186570846 :step/content {:db/id #edb/ref 17592186570707 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84d8beff-2479-5088-bdac-e141e015a59c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/56/56f52c1e31d4e6224a222bdc57ee726848672332b7e1e6bed0c7d51db09a4f60.png" :db/id #edb/ref 17592186570358} {:answer/id #uuid "a68e71cf-7bb8-52ab-aecd-7b06a8b6b148" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/7b/7b5f467f84f0c7d8b3c1dce432ae0c4db8117cde6730611ac4e48881a0bb4b69.png" :db/id #edb/ref 17592186570419} {:answer/id #uuid "ad8813ef-4396-5a21-9fdd-ad55cb9aa352" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/13/13c3fb2aadb027fe3397b237e8c8027e1fcc7418106cc488e51f81062fa75e2e.png" :db/id #edb/ref 17592186570433} {:answer/id #uuid "d0a6cbb4-361d-51df-86ce-cc6151d8155e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/18/18a34470ca210b12544b90b520dfc4d2ed443231f55a2443ffbbdf31e72d61c1.png" :db/id #edb/ref 17592186570488} {:answer/id #uuid "d124ec48-3b27-5a60-951a-d15de5d7a40d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/47/472cf0dd7807c15e8e8334a163d1cfbfbbdcd974534e99b94222929048e72b31.png" :db/id #edb/ref 17592186570490}] :answer-field/correct {:db/id #edb/ref 17592186570490} :answer-field/id #uuid "c9f032b0-b93a-57ee-ab00-0ed6113f8ef6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570674}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1d85a230-c47c-5ffa-b563-dedfdd86c871" :question/math-academy-id "q-28074" :question/problem "Which of the following curves is generated by $y=-3(x+2)(x+1)(x-1)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, notice that the function is a product of $3$ linear binomials, so this function is a cubic function. Moreover, it is a negative cubic because if we were to expand the parentheses, the coefficient of the ${x}^{3}$ term would be negative:\n\n$$\n-3(x+2)(x+1)(x-1)=-3x\\cdot x\\cdot x+⋯=-3{x}^{3}+⋯\n$$\n\nThe equation is given in the factored form. So by the zero-product rule, we deduce that the roots are  $x=-2,$ $x=-1,$ and $x=1.$ \n\nWe now find the $y$-intercept of the curve by plugging the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =-3(0+2)(0+1)(0-1) \\\\  & =-3(2)(1)(-1) \\\\  & =6.\\end{aligned}\n$$\n\nSo, we draw an $\\text{S}$-shaped graph that passes through the three roots $x=-2,-1,1$ and has the $y$-intercept $y=6,$ as follows:\n\n![](images/47/472cf0dd7807c15e8e8334a163d1cfbfbbdcd974534e99b94222929048e72b31.png)"} :step/id #uuid "95c410e0-d5ac-51fe-bc83-3557448ebd94" :step/next {:db/id #edb/ref 17592186570804}} {:db/id #edb/ref 17592186570859 :step/content {:db/id #edb/ref 17592186570708 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10c54f81-76b6-583f-90ea-fedd6ed4be72" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/06/066d0669762137e2e014c2b76c941bdf7812c2d537ae1c03e0ae89a1d7107dc3.png" :db/id #edb/ref 17592186570155} {:answer/id #uuid "17b7e3ec-839e-5536-aba8-7da932732eea" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/aa/aadabdf5e3da853c5d80a902717c0e4e7b7628f63ec45690acb35c9ea1471026.png" :db/id #edb/ref 17592186570171} {:answer/id #uuid "a21448ea-448b-5f5d-8fa7-410e5c305b6b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/dc/dc808580cd0a7dfee4d03a2357d278076650da7acdbe0b963c944ec1338ca66c.png" :db/id #edb/ref 17592186570410} {:answer/id #uuid "acc28117-8c7e-5014-8d43-cf71987edfa5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/5c/5cd54c55d39003033450f9cbf0ba1fbcfc6608fd18a50b97b8a23880e2bf25d2.png" :db/id #edb/ref 17592186570431} {:answer/id #uuid "ceaf2707-9a91-54ce-8aa8-a46bf55db815" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/01/016b5bc1171471bb3ce678031ce7cac74187cc06333bd4646ba09b9be054c4e5.png" :db/id #edb/ref 17592186570481}] :answer-field/correct {:db/id #edb/ref 17592186570431} :answer-field/id #uuid "b18f2373-d103-568e-a398-52c15fa56a75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186570663}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1fbfa8ab-6879-57fc-b2d0-196f095281bf" :question/math-academy-id "q-112004" :question/problem "Given that $(x+3)$ is a factor of $f(x)={x}^{3}+2{x}^{2}-9x-18,$ which of the following curves is generated by $y=f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, we note that the function is a positive cubic curve because the coefficient of ${x}^{3}$ is positive.\n\nWe are told that $(x+3)$ is a factor of $f(x),$ so to find the other roots of $f(x)$ we use synthetic division to divide $f(x)$ by  $(x+3):$\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -3 & 1 & 2 & -9 & -18 \\\\  &  & -3 & 3 & 18 \\\\  & 1 & -1 & -6 & 0\\end{aligned}\n$$\n\nWe obtain \n\n$$\n\\begin{aligned}f(x) & =(x+3)({x}^{2}-x-6) \\\\  & =(x+3)(x+2)(x-3),\\end{aligned}\n$$\n\nso the roots of $f(x)$ are $x=-3,$ $x=-2,$ and $x=3.$ \n\nNow, let's find the $y$-intercept. To do that, we substitute $x=0,$ and we get\n\n$$\n\\begin{aligned}y & =(0+3)(0+2)(0-3) \\\\  & =(3)(2)(-3) \\\\  & =-18.\\end{aligned}\n$$\n\nSo, we draw an inverted $\\text{S}$-shaped graph that passes through the three roots $x=-3,-2,3$ and has the $y$-intercept $y=-18,$ as follows:\n\n![](images/c3/c3d41c300747f4f0f18607351f2f03241c9a789ed70fe72e05c5a385b708c4c8.png)"} :step/id #uuid "cfcb7580-8426-5081-ac0a-40fc40360751"}] :activity/title "Graphing Cubic Curves Containing Three Distinct Real Roots" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570107}]}
