#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186551372} :activity/id #uuid "415fc07e-39c3-5797-979e-ef79737b49e5" :activity/scope {:db/id #edb/ref 17592186050291 :topic/id #uuid "3d5ca35e-6400-55ca-b230-0ff03628b370" :topic/math-academy-id 112} :activity/steps [{:db/id #edb/ref 17592186551367 :step/content {:db/id #edb/ref 17592186551269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d65c081f-46e7-50d2-b0af-c99aac626906" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186550948}] :answer-field/correct {:db/id #edb/ref 17592186550948} :answer-field/id #uuid "d1767cf0-549a-5130-876d-9403ed25774d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186551197}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "44100483-c880-5325-8cb2-5b4178bd1ae8" :question/math-academy-id "q-267389" :question/problem "![](images/fe/fe2f1266db9f675a2c82803728d37f53d0995c25cf61f74304a731c3d21c64c8.png)\n\nThe point $P(\\frac{\\sqrt{11}}{6},\\frac{5}{6})$ lies on the unit circle, as shown. What is $\\operatorname{csc}⁡\\theta ?$ Do not round your answer.\n\n$\\operatorname{csc}⁡\\theta =$\n{{field-1}}" :question/worked-solution "![](images/48/489a919487ffe7051a27f736ff8ca210e4c246bceac42055e31f5150bc4e094b.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $y=\\frac{5}{6}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{sin}⁡\\theta =\\frac{5}{6}.\n$$\n\nKnowing that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we can calculate $\\operatorname{csc}⁡\\theta :$\n\n$$\n\\operatorname{csc}⁡\\theta =\\frac{1}{(\\frac{5}{6})}=\\frac{6}{5}\n$$"} :step/id #uuid "1263712a-3a0a-57fc-89c3-d4db066a7847" :step/next {:db/id #edb/ref 17592186551440}} {:db/id #edb/ref 17592186551372 :step/content {:db/id #edb/ref 17592186551250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05b0de47-6d93-56f4-9eec-48894f36d56e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{13}}{6}" :db/id #edb/ref 17592186550384} {:answer/id #uuid "3a4fe516-3675-584c-b3d4-a4182956369b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\sqrt{13}" :db/id #edb/ref 17592186550503} {:answer/id #uuid "72ba0ba6-9d3d-570e-859e-0393addd7b86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6\\sqrt{13}}{13}" :db/id #edb/ref 17592186550656} {:answer/id #uuid "7400282a-889c-5443-9fca-18dc0075e6d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{13}}{7}" :db/id #edb/ref 17592186550659} {:answer/id #uuid "f948c330-b81c-5ef2-94de-f3c68097c2a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7\\sqrt{13}}{6}" :db/id #edb/ref 17592186551035}] :answer-field/correct {:db/id #edb/ref 17592186550384} :answer-field/id #uuid "82c3804a-ba42-5eda-8d70-9caba3ae75d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186551142}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "29930a9c-51d8-56d8-87b6-15535f5105d7" :question/math-academy-id "q-124392" :question/problem "![](images/e5/e597e317f32a2a9a3757ce583a2b053f4cba1da1a2119c572671e7edc96c61e4.png)\n\nThe point $P(\\frac{6}{7},\\frac{\\sqrt{13}}{7})$ lies on the unit circle, as shown. What is $\\operatorname{tan}⁡\\theta ?$" :question/worked-solution "![](images/fb/fb0da765a857607ce0c8f13690efaa2f0d504ccaa51899a23044ee4ed17f0aa5.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{6}{7}$ and $y=\\frac{\\sqrt{13}}{7}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{6}{7},\\,\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{13}}{7}.\n$$\n\nKnowing that $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },$ we can calculate $\\operatorname{tan}⁡\\theta :$\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{(\\frac{\\sqrt{13}}{7})}{(\\frac{6}{7})}=\\frac{\\sqrt{13}}{6}.\n$$"} :step/id #uuid "1d9f8358-1b2c-5a6e-9744-40ad486a7663" :step/next {:db/id #edb/ref 17592186551367}} {:db/id #edb/ref 17592186551440 :step/content {:db/id #edb/ref 17592186551277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4b60d51-d24a-5296-b05c-ca2de01453fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186550944}] :answer-field/correct {:db/id #edb/ref 17592186550944} :answer-field/id #uuid "9194ee95-2b5a-5c6e-af69-3efb185447ac" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186551155}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5237ac2b-249d-5de5-a0f0-312a03200ea8" :question/math-academy-id "q-267419" :question/problem "![](images/a8/a8fc1b09d51bf0d7ac526a917b2341015b787b3098627bedd25e1638ecf041cc.png)\n\nThe point $P(\\frac{2}{3},\\frac{\\sqrt{5}}{3})$ lies on the unit circle, as shown. What is $\\operatorname{tan}⁡\\theta ?$ Do not round your answer.\n\n$\\operatorname{tan}⁡\\theta =$\n{{field-1}}" :question/worked-solution "![](images/fd/fdddfbe8431756e0e0341ad6576383764eb88519cc0454280ce4d443559d3536.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{2}{3}$ and $y=\\frac{\\sqrt{5}}{3}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{2}{3},\\,\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{5}}{3}.\n$$\n\nKnowing that $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },$ we can calculate $\\operatorname{tan}⁡\\theta :$\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{(\\frac{\\sqrt{5}}{3})}{(\\frac{2}{3})}=\\frac{\\sqrt{5}}{2}\n$$"} :step/id #uuid "b2579eff-0975-5a6a-82fa-36ae232133c1"}] :activity/title "Properties of the Unit Circle in the First Quadrant" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186550345}]}
