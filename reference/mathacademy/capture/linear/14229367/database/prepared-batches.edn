n}⁡\\theta \n$$\n\nWe're given that $y=\\frac{5}{6}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{sin}⁡\\theta =\\frac{5}{6}.\n$$\n\nKnowing that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we can calculate $\\operatorname{csc}⁡\\theta :$\n\n$$\n\\operatorname{csc}⁡\\theta =\\frac{1}{(\\frac{5}{6})}=\\frac{6}{5}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d1767cf0-549a-5130-876d-9403ed25774d"] :db/ensure [:question/validate]} {:db/id "answer-field-d1767cf0-549a-5130-876d-9403ed25774d" :answer-field/id #uuid "d1767cf0-549a-5130-876d-9403ed25774d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d65c081f-46e7-50d2-b0af-c99aac626906" :answer-field/choices ["answer-d65c081f-46e7-50d2-b0af-c99aac626906"] :db/ensure [:answer-field/validate]} {:db/id "answer-d65c081f-46e7-50d2-b0af-c99aac626906" :answer/id #uuid "d65c081f-46e7-50d2-b0af-c99aac626906" :answer/type :answer.type/math :answer/value "\\frac{6}{5}" :db/ensure [:answer/validate]} {:db/id "question-5237ac2b-249d-5de5-a0f0-312a03200ea8" :question/id #uuid "5237ac2b-249d-5de5-a0f0-312a03200ea8" :question/math-academy-id "q-267419" :question/problem "![](images/a8/a8fc1b09d51bf0d7ac526a917b2341015b787b3098627bedd25e1638ecf041cc.png)\n\nThe point $P(\\frac{2}{3},\\frac{\\sqrt{5}}{3})$ lies on the unit circle, as shown. What is $\\operatorname{tan}⁡\\theta ?$ Do not round your answer.\n\n$\\operatorname{tan}⁡\\theta =$\n{{field-1}}" :question/worked-solution "![](images/fd/fdddfbe8431756e0e0341ad6576383764eb88519cc0454280ce4d443559d3536.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{2}{3}$ and $y=\\frac{\\sqrt{5}}{3}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{2}{3},\\,\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{5}}{3}.\n$$\n\nKnowing that $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },$ we can calculate $\\operatorname{tan}⁡\\theta :$\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{(\\frac{\\sqrt{5}}{3})}{(\\frac{2}{3})}=\\frac{\\sqrt{5}}{2}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9194ee95-2b5a-5c6e-af69-3efb185447ac"] :db/ensure [:question/validate]} {:db/id "answer-field-9194ee95-2b5a-5c6e-af69-3efb185447ac" :answer-field/id #uuid "9194ee95-2b5a-5c6e-af69-3efb185447ac" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d4b60d51-d24a-5296-b05c-ca2de01453fe" :answer-field/choices ["answer-d4b60d51-d24a-5296-b05c-ca2de01453fe"] :db/ensure [:answer-field/validate]} {:db/id "answer-d4b60d51-d24a-5296-b05c-ca2de01453fe" :answer/id #uuid "d4b60d51-d24a-5296-b05c-ca2de01453fe" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{2}" :db/ensure [:answer/validate]} {:db/id "activity-415fc07e-39c3-5797-979e-ef79737b49e5" :activity/id #uuid "415fc07e-39c3-5797-979e-ef79737b49e5" :activity/title "Properties of the Unit Circle in the First Quadrant" :activity/type :activity.type/review :activity/scope 17592186050291 :activity/course 17592186046647 :activity/steps ["step-1d9f8358-1b2c-5a6e-9744-40ad486a7663" "step-1263712a-3a0a-57fc-89c3-d4db066a7847" "step-b2579eff-0975-5a6a-82fa-36ae232133c1"] :activity/first-step "step-1d9f8358-1b2c-5a6e-9744-40ad486a7663" :db/ensure [:activity/validate]} {:db/id "step-1d9f8358-1b2c-5a6e-9744-40ad486a7663" :step/id #uuid "1d9f8358-1b2c-5a6e-9744-40ad486a7663" :step/content "question-29930a9c-51d8-56d8-87b6-15535f5105d7" :step/next "step-1263712a-3a0a-57fc-89c3-d4db066a7847" :db/ensure [:step/validate]} {:db/id "step-1263712a-3a0a-57fc-89c3-d4db066a7847" :step/id #uuid "1263712a-3a0a-57fc-89c3-d4db066a7847" :step/content "question-44100483-c880-5325-8cb2-5b4178bd1ae8" :s