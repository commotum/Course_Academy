b-249d-5de5-a0f0-312a03200ea8" :question/difficulty :question.difficulty/easy] ["answer-field-9194ee95-2b5a-5c6e-af69-3efb185447ac" :answer-field/id #uuid "9194ee95-2b5a-5c6e-af69-3efb185447ac"] ["answer-d4b60d51-d24a-5296-b05c-ca2de01453fe" :answer/id #uuid "d4b60d51-d24a-5296-b05c-ca2de01453fe"] ["answer-d4b60d51-d24a-5296-b05c-ca2de01453fe" :answer/type :answer.type/math] ["answer-d4b60d51-d24a-5296-b05c-ca2de01453fe" :answer/value "\\frac{\\sqrt{5}}{2}"] ["answer-field-9194ee95-2b5a-5c6e-af69-3efb185447ac" :answer-field/key "field-1"] ["answer-field-9194ee95-2b5a-5c6e-af69-3efb185447ac" :answer-field/type :answer-field.type/blank] ["answer-field-9194ee95-2b5a-5c6e-af69-3efb185447ac" :answer-field/correct "answer-d4b60d51-d24a-5296-b05c-ca2de01453fe"] ["answer-field-9194ee95-2b5a-5c6e-af69-3efb185447ac" :answer-field/choices "answer-d4b60d51-d24a-5296-b05c-ca2de01453fe"] ["question-5237ac2b-249d-5de5-a0f0-312a03200ea8" :question/answer-fields "answer-field-9194ee95-2b5a-5c6e-af69-3efb185447ac"] [17592186054719 :knowledge-point/questions "question-5237ac2b-249d-5de5-a0f0-312a03200ea8"] ["activity-415fc07e-39c3-5797-979e-ef79737b49e5" :activity/id #uuid "415fc07e-39c3-5797-979e-ef79737b49e5"] ["step-1d9f8358-1b2c-5a6e-9744-40ad486a7663" :step/id #uuid "1d9f8358-1b2c-5a6e-9744-40ad486a7663"] ["step-1263712a-3a0a-57fc-89c3-d4db066a7847" :step/id #uuid "1263712a-3a0a-57fc-89c3-d4db066a7847"] ["step-b2579eff-0975-5a6a-82fa-36ae232133c1" :step/id #uuid "b2579eff-0975-5a6a-82fa-36ae232133c1"] ["step-1d9f8358-1b2c-5a6e-9744-40ad486a7663" :step/content "question-29930a9c-51d8-56d8-87b6-15535f5105d7"] ["step-1d9f8358-1b2c-5a6e-9744-40ad486a7663" :step/next "step-1263712a-3a0a-57fc-89c3-d4db066a7847"] ["step-1263712a-3a0a-57fc-89c3-d4db066a7847" :step/content "question-44100483-c880-5325-8cb2-5b4178bd1ae8"] ["step-1263712a-3a0a-57fc-89c3-d4db066a7847" :step/next "step-b2579eff-0975-5a6a-82fa-36ae232133c1"] ["step-b2579eff-0975-5a6a-82fa-36ae232133c1" :step/content "question-