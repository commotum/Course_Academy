ts\n\n- $CD=3$ units\n\n- $GH=4$ units\n\nTherefore, the only pair of congruent segments is $\\overset{―}{AB}$ and $\\overset{―}{EF}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c5935cda-3ca0-5a2c-b098-daf654724f64"] :db/ensure [:question/validate]} {:db/id "answer-field-c5935cda-3ca0-5a2c-b098-daf654724f64" :answer-field/id #uuid "c5935cda-3ca0-5a2c-b098-daf654724f64" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7f494db1-50d3-56cb-8e05-a1b5329875fd" :answer-field/choices ["answer-fef54bfa-f07f-59e8-bec9-bb54e349e1bb" "answer-7f494db1-50d3-56cb-8e05-a1b5329875fd" "answer-f4e0b450-c2c2-5523-8065-e4c2bcd6455c" "answer-1b55d9ad-d125-558a-81f9-5d73ea9169f0" "answer-f054e55f-b130-59c9-9267-319c6a3272ed"] :db/ensure [:answer-field/validate]} {:db/id "answer-fef54bfa-f07f-59e8-bec9-bb54e349e1bb" :answer/id #uuid "fef54bfa-f07f-59e8-bec9-bb54e349e1bb" :answer/type :answer.type/text :answer/value "$\\overset{―}{AB}$ and $\\overset{―}{CD}$" :db/ensure [:answer/validate]} {:db/id "answer-7f494db1-50d3-56cb-8e05-a1b5329875fd" :answer/id #uuid "7f494db1-50d3-56cb-8e05-a1b5329875fd" :answer/type :answer.type/text :answer/value "$\\overset{―}{AB}$ and $\\overset{―}{EF}$" :db/ensure [:answer/validate]} {:db/id "answer-f4e0b450-c2c2-5523-8065-e4c2bcd6455c" :answer/id #uuid "f4e0b450-c2c2-5523-8065-e4c2bcd6455c" :answer/type :answer.type/text :answer/value "$\\overset{―}{AB}$ and $\\overset{―}{GH}$" :db/ensure [:answer/validate]} {:db/id "answer-1b55d9ad-d125-558a-81f9-5d73ea9169f0" :answer/id #uuid "1b55d9ad-d125-558a-81f9-5d73ea9169f0" :answer/type :answer.type/text :answer/value "$\\overset{―}{CD}$ and $\\overset{―}{EF}$" :db/ensure [:answer/validate]} {:db/id "answer-f054e55f-b130-59c9-9267-319c6a3272ed" :answer/id #uuid "f054e55f-b130-59c9-9267-319c6a3272ed" :answer/type :answer.type/text :answer/value "$\\overset{―}{EF}$ and $\\overset{―}{GH}$" :db/ensure [:answer/validate]} {