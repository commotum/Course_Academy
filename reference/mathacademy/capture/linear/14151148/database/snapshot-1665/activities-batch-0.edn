#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186111715} :activity/id #uuid "c06b4e33-1b3c-55b4-883e-d93402ee309a" :activity/scope {:db/id #edb/ref 17592186049584 :topic/id #uuid "01fbe812-7107-563d-a37c-41e92cf45075" :topic/math-academy-id 1462} :activity/steps [{:db/id #edb/ref 17592186111715 :step/content {:db/id #edb/ref 17592186111834 :tutorial/content "When two line segments have the same length, they are **congruent** segments. To indicate that the line segments $\\overline{AB}$ and $\\overline{CD}$ are congruent we write \n\n$$\n\\overline{AB} \\:\\:{\\color{red}\\boldsymbol{\\cong}}\\:\\: \\overline{CD},\n$$\n\nand we use special marks like in the diagram below.\n\n![](images/6d/6d7fd26fce7dce67fa57769db3e96be503051be5c7d2c7714ed48927547d5165.png)\n\nWe can also write \n\n$$\nAB \\:{\\color{blue}=}\\: CD,\n$$\n\nwhich means that the measure of $\\overline{AB}$ is equal to the measure of $\\overline{CD}.$\n\n**Watch out!** The equation \n\n$$\n\\overline{AB} = \\overline{CD}\n$$\n\nis only true when both $\\overline{AB}$ and $\\overline{CD}$ correspond to the same exact segment. When the segments are distinct, we should use the symbol $\\cong$ to represent that the two segments are separate but that they have the same length." :tutorial/id #uuid "a565176c-749f-56b7-aa7c-4d200187c50f" :tutorial/math-academy-id 2164 :tutorial/title "Introduction"} :step/id #uuid "5c755862-dc82-5232-8df9-c287c6e24622" :step/math-academy-id 8703 :step/next {:db/id #edb/ref 17592186111717}} {:db/id #edb/ref 17592186111716 :step/content {:db/id #edb/ref 17592186110741 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110374 :question/id #uuid "8d23b33d-46ad-56af-853c-353c306c7af0" :question/math-academy-id "e-2553"} :knowledge-point/id #uuid "dee17b1d-686f-5817-b7dd-bf5b0bbd3da3" :knowledge-point/questions [{:db/id #edb/ref 17592186111255} {:db/id #edb/ref 17592186111274} {:db/id #edb/ref 17592186446549} {:db/id #edb/ref 17592186446552}]