      "html": "<div id=\"question-168003\" class=\"question\">                                \n                        <div id=\"question-168003-text\" class=\"questionText\">      \n                            \n                            <!--<span style=\"font-weight: bold; margin-right: 10px;\">a.</span>-->\n\n                            <div id=\"question-168003-graphic\" class=\"questionGraphic\">\n                                \n                            </div>   \n\n\n                            What is the area of a circle of radius <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"8\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c3F\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>?</mo></math></mjx-assistive-mml></mjx-container>\n\n                            \n                                    \n                                        \n                                            <div class=\"freeResponse\">\n                                                <div class=\"freeResponseLine\">\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"9\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-cal mjx-i\"><mjx-c class=\"mjx-c41 TEX-C\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo clas