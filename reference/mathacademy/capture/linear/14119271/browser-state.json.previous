            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-213392-b",
              "type": "text",
              "value": "II and III only",
              "html": "II and III only\n"
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-213392-c",
              "type": "text",
              "value": "III only",
              "html": "III only"
            },
            {
              "option": "d",
              "dom_id": "questionWidget-choiceLetterCircle-213392-d",
              "type": "text",
              "value": "I and II only",
              "html": "I and II only\n"
            },
            {
              "option": "e",
              "dom_id": "questionWidget-choiceLetterCircle-213392-e",
              "type": "text",
              "value": "I and III only",
