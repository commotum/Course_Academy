  "live_records": {
    "q-144158": {
      "dom_id": "step-q144158",
      "name": "Question 1",
      "problem": "Suppose we want to find the area of a forest. What units could we use?",
      "worked_solution": "We can measure length in kilometers $(\\text{km}).$ When measuring lengths in kilometers, areas are measured in $\\text{km}\\times \\text{km},$ which is usually written as ${\\text{km}}^{2}.$",
