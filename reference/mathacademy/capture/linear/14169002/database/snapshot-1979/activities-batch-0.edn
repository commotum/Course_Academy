#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186106737} :activity/id #uuid "2fb56d40-545a-510d-a693-25bf992fdb77" :activity/scope {:db/id #edb/ref 17592186048921 :topic/id #uuid "cc9dbee5-9d12-52e7-a3e4-6d1b31e3ecaf" :topic/math-academy-id 1386} :activity/steps [{:db/id #edb/ref 17592186106737 :step/content {:db/id #edb/ref 17592186107044 :tutorial/content "Consider the triangle $\\triangle ABC$ shown below.\n\n![](images/46/46a85010d46969ffb7df440efd72bb3fa8d1394b35cc2887ee4567cda15079c5.png)\n\nThe sum of the length of its sides is called the **perimeter**. Here, the perimeter of our triangle is\n\n$$\n\\begin{aligned}p & =AB+BC+AC \\\\  & =2+4.2+3.8 \\\\  & =10\\,\\text{cm}.\\end{aligned}\n$$" :tutorial/id #uuid "7664d7c3-e47c-57b6-97aa-1131f036852c" :tutorial/math-academy-id 2244 :tutorial/title "Introduction"} :step/id #uuid "2dd79ef0-aa4a-5d52-ba67-92d8d47fd909" :step/math-academy-id 623181 :step/next {:db/id #edb/ref 17592186106738}} {:db/id #edb/ref 17592186106738 :step/content {:db/id #edb/ref 17592186105806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105528 :question/id #uuid "00942425-ab13-5a50-a63a-d29cf2f34889" :question/math-academy-id "e-2752"} :knowledge-point/id #uuid "b1d4b0c2-10d0-5c3a-8a58-4d7598dd9f96" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049027} {:db/id #edb/ref 17592186050410}] :knowledge-point/questions [{:db/id #edb/ref 17592186106137} {:db/id #edb/ref 17592186106384} {:db/id #edb/ref 17592186492074}] :knowledge-point/title "Calculating the Perimeter of a Triangle Given the Perimeter of Another Triangle"} :step/id #uuid "48b5c886-bff4-52b2-b702-6be7c990ade1" :step/math-academy-id 623182 :step/next {:db/id #edb/ref 17592186106739}} {:db/id #edb/ref 17592186106739 :step/content {:db/id #edb/ref 17592186107045 :tutorial/content "Suppose we have a quadrilateral $ABCD$ as shown below and it is known that ${AD} = 6\\,\\mathrm{m},$ ${AB} = 2\\,\\mathrm{m},$ ${BC} = 4\\,\\mathrm{m},$ and $CD=5\\,\\mathrm{m}.$ What is the perimeter of the quadrilateral?   \n\n![](images/a7/a74251f1c72eccad42b98e0d3fd9a7e7cd0a60018a6f03bb65ec2abc34eb1c88.png)\n\nRemember that the **perimeter** $p$ of a polygon is the sum of the measures of all its sides. So, we can simply calculate \n\n$$\n\\begin{aligned}p & =AD+AB+BC+CD \\\\  & =6+2+4+5 \\\\  & =17\\,m.\\end{aligned}\n$$" :tutorial/id #uuid "0428807f-e6a6-5280-81bc-ab454203aebf" :tutorial/math-academy-id 2246 :tutorial/title "Perimeters of Polygons"} :step/id #uuid "2154c4c2-efe1-5888-87e0-905e612555d4" :step/math-academy-id 623185 :step/next {:db/id #edb/ref 17592186106740}} {:db/id #edb/ref 17592186106740 :step/content {:db/id #edb/ref 17592186105807 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105529 :question/id #uuid "b4864184-6983-58ab-9787-524e04dc5c73" :question/math-academy-id "e-2754"} :knowledge-point/id #uuid "6f6c0ca1-297a-5f25-bccf-c74d0c565c24" :knowledge-point/questions [{:db/id #edb/ref 17592186106202} {:db/id #edb/ref 17592186106203} {:db/id #edb/ref 17592186492033} {:db/id #edb/ref 17592186492041}] :knowledge-point/title "Calculating the Perimeter of a Polygon"} :step/id #uuid "2896eab9-aca7-5163-8e08-2101c4fa2827" :step/math-academy-id 623186 :step/next {:db/id #edb/ref 17592186106741}} {:db/id #edb/ref 17592186106741 :step/content {:db/id #edb/ref 17592186107046 :tutorial/content "Let's take a look at the polygons depicted below and find their perimeters.\n\n![](images/69/69ef06a71f13625ad4525a03966f4a4c62ae2b2136b085e97b8dc02a6a6963cc.png)\n\nFrom the picture, we conclude that polygons I, II and III all have a perimeter of $10$ while polygon IV has a perimeter of $8.$ \n\nPolygons that have the same perimeter are called **isoperimetric**. So I, II and III are isoperimetric polygons." :tutorial/id #uuid "596db00e-9cf7-51e1-902e-73c6670780eb" :tutorial/math-academy-id 2247 :tutorial/title "Isoperimetric Polygons"} :step/id #uuid "ffc5ce2a-4bcb-5660-a1ce-e79bd1b4c604" :step/math-academy-id 623189 :step/next {:db/id #edb/ref 17592186106742}} {:db/id #edb/ref 17592186106742 :step/content {:db/id #edb/ref 17592186105808 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105530 :question/id #uuid "3de76784-4137-5093-9c35-847edd10ef62" :question/math-academy-id "e-2756"} :knowledge-point/id #uuid "b2c2a15f-617d-5515-98a8-ccdc525092b3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050613}] :knowledge-point/questions [{:db/id #edb/ref 17592186106204} {:db/id #edb/ref 17592186106205} {:db/id #edb/ref 17592186492007} {:db/id #edb/ref 17592186492071}] :knowledge-point/title "Determining the Value of Variables Given Two Isoperimetric Polygons"} :step/id #uuid "ec3bbafa-69db-5676-8013-221157e979a6" :step/math-academy-id 623190}] :activity/title "The Perimeter of a Polygon" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106009}]}
