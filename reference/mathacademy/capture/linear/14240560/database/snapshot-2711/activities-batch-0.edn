#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186158116} :activity/id #uuid "46278cd6-bec5-5a16-b39f-8e1852f87fc0" :activity/scope {:db/id #edb/ref 17592186051033 :topic/id #uuid "7c048599-260c-5867-88ec-692aa4d19c71" :topic/math-academy-id 2827} :activity/steps [{:db/id #edb/ref 17592186158111 :step/content {:db/id #edb/ref 17592186157282 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157086 :question/id #uuid "37d8d7b3-4252-5b87-899a-655137acdb4a" :question/math-academy-id "e-7156"} :knowledge-point/id #uuid "70b0ef91-c5ed-5e5d-a777-dea3ae515aed" :knowledge-point/questions [{:db/id #edb/ref 17592186157763} {:db/id #edb/ref 17592186157785} {:db/id #edb/ref 17592186233062} {:db/id #edb/ref 17592186233066} {:db/id #edb/ref 17592186558550} {:db/id #edb/ref 17592186558551}] :knowledge-point/title "Finding an Intersection of Sets Without a Venn Diagram"} :step/id #uuid "41de3fd2-d4b5-5a24-bbbd-6e3135b248f6" :step/math-academy-id 26356 :step/next {:db/id #edb/ref 17592186158112}} {:db/id #edb/ref 17592186158112 :step/content {:db/id #edb/ref 17592186157283 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157087 :question/id #uuid "a30b2847-895f-5a76-9e1d-dad43f528482" :question/math-academy-id "e-7157"} :knowledge-point/id #uuid "ee6a1874-a11e-58d6-8509-4cef2203fc64" :knowledge-point/questions [{:db/id #edb/ref 17592186157766} {:db/id #edb/ref 17592186157787} {:db/id #edb/ref 17592186234431} {:db/id #edb/ref 17592186234466} {:db/id #edb/ref 17592186558511}] :knowledge-point/title "Finding Intersections of Sets Given Verbally"} :step/id #uuid "6485ec10-7fed-5898-9d4d-c74138c1f40a" :step/math-academy-id 26357} {:db/id #edb/ref 17592186158116 :step/content {:db/id #edb/ref 17592186158473 :tutorial/content "The **intersection** of two sets $A$ and $B,$ denoted by $A \\cap B,$ is the set of all elements belonging to both $A$ and $B.$\n\nFor example, consider the sets $A = \\{ a,b,c \\}$ and $B = \\{ b, d, e \\}.$ We can represent these sets using a Venn diagram, as follows:\n\n![](images/83/8351db4817ac8b0d2991fe8ef09ee1f2583c84cb772114ef0614a0ef96c96389.png)\n\nThe intersection $A \\cap B$ consists of all the elements that are in both $A$ and $B.$ To represent $A \\cap B,$ we will shade in all the area that is contained within both $A$ and $B.$\n\n![](images/f1/f123089087c3a51aa80555633aedc18d38ca8d157d4a5cf6ade58adf74144e52.png)\n\nThe only element that is contained in both $A$ and $B$ is $b.$ Therefore,\n\n$$\nA \\cap B = \\{ b \\}.\n$$" :tutorial/id #uuid "b46c3390-4677-561a-9ab7-6e07f869fcb6" :tutorial/math-academy-id 4332 :tutorial/title "Introduction"} :step/id #uuid "3f16cec4-549c-5f5a-b840-a9100f0fc975" :step/math-academy-id 26363 :step/next {:db/id #edb/ref 17592186158123}} {:db/id #edb/ref 17592186158123 :step/content {:db/id #edb/ref 17592186157290 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157094 :question/id #uuid "b33222a9-91db-51fd-b275-a6b593e2f6df" :question/math-academy-id "e-7169"} :knowledge-point/id #uuid "953e79cf-c216-5d4b-a056-455f76e7fa87" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049065}] :knowledge-point/questions [{:db/id #edb/ref 17592186157806} {:db/id #edb/ref 17592186157807} {:db/id #edb/ref 17592186233060} {:db/id #edb/ref 17592186234430} {:db/id #edb/ref 17592186558554}] :knowledge-point/title "Finding an Intersection of Sets Using a Venn Diagram"} :step/id #uuid "03afa206-77e4-5da8-9a9a-afd97242cb31" :step/math-academy-id 26374 :step/next {:db/id #edb/ref 17592186158128}} {:db/id #edb/ref 17592186158128 :step/content {:db/id #edb/ref 17592186158479 :tutorial/content "Although Venn diagrams can be useful to visualize intersections, we do not have to draw a Venn diagram every time we wish to compute an intersection.\n\nFor example, let's again consider the sets $A = \\{ a,b,c \\}$ and $B = \\{ b, d, e \\}.$ This time, we will compute the intersection $A \\cap B$ without using a Venn diagram. We just need to find all the elements that are in both $A$ and $B.$\n\nSo, we will go through the elements of $A$ and check if each element is also in $B.$\n\n- For the element $a \\in A,$ we have $a \\not\\in B. \\quad \\color{red}\\times$\n\n- For the element $b \\in A,$ we have $b \\in B. \\quad \\color{green}\\checkmark$\n\n- For the element $c \\in A,$ we have $c \\not\\in B. \\quad \\color{red}\\times$\n\nThe only element in $A$ that is also in $B$ is $b.$ \n\nTherefore, the intersection of $A$ and $B$ is\n\n$$\nA \\cap B = \\{ b \\}.\n$$" :tutorial/id #uuid "bd26f7e1-89d5-573e-832c-7b05e26c776a" :tutorial/math-academy-id 4341 :tutorial/title "Intersections Without Venn Diagrams"} :step/id #uuid "853cbb33-a834-5621-883d-b7e9e3e59b25" :step/math-academy-id 26396 :step/next {:db/id #edb/ref 17592186158111}}] :activity/title "The Intersection of Sets" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157484}]}
