#{[{:activity/first-step {:db/id #edb/ref 17592186079509} :activity/id #uuid "8560c2d0-d837-56e0-950c-db576aea6153" :activity/scope {:db/id #edb/ref 17592186048166 :topic/id #uuid "84e2509e-1fbc-5c17-a4bf-5c3aa6194b5d" :topic/math-academy-id 685} :activity/steps [{:db/id #edb/ref 17592186079313 :step/content {:db/id #edb/ref 17592186078436 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078306 :question/id #uuid "d7c0ca60-1915-5484-913a-835a1f8fa320" :question/math-academy-id "e-4240"} :knowledge-point/id #uuid "90216c0e-e4a5-5933-86e0-58d218939e29" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048142}] :knowledge-point/questions [{:db/id #edb/ref 17592186079063} {:db/id #edb/ref 17592186079157} {:db/id #edb/ref 17592186234162}] :knowledge-point/title "Finding the Index of a Term Given the Recursive Formula"} :step/id #uuid "a9588d2a-14e4-52e1-b197-e06616dcb6e5" :step/math-academy-id 15490 :step/next {:db/id #edb/ref 17592186079511}} {:db/id #edb/ref 17592186079314 :step/content {:db/id #edb/ref 17592186078437 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078307 :question/id #uuid "2da03f9b-c474-5b07-b4e8-bdf1dc3c2fd8" :question/math-academy-id "e-4241"} :knowledge-point/id #uuid "a82355f8-4b86-55c8-8686-1e4ea82e4464" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050511}] :knowledge-point/questions [{:db/id #edb/ref 17592186079155} {:db/id #edb/ref 17592186079156}] :knowledge-point/title "Finding the Index of a Term Given the First Term and the Common Ratio"} :step/id #uuid "23a88b1d-eef3-5987-a6c3-5e388244d80e" :step/math-academy-id 15491 :step/next {:db/id #edb/ref 17592186079510}} {:db/id #edb/ref 17592186079509 :step/content {:db/id #edb/ref 17592186079627 :tutorial/content "In addition to using the formula\n\n$$\n\\begin{aligned}\na_{n} &= a_{1} \\cdot r^{n - 1}\n\\end{aligned}\n$$\n\nto compute the terms of a geometric sequence, we can also use it to compute the index of a desired term in a geometric sequence.\n\nTo illustrate, suppose we're given the geometric sequence\n\n$$\n3, \\: 6, \\: 12, \\: \\ldots, \\:96, \\ldots\n$$\n\nthat has the first term $a_1=3$ and the common ratio $r=2$. What index gives the term $96$? In other words, what value of $n$ gives $a_n=96$?\n\nWe can construct the formula for the $n$th term, as follows:\n\n$$\n\\begin{aligned}\na_{n} &= a_{1} \\cdot r^{n - 1} \\\\\n&= 3 \\cdot 2^{n - 1}\n\\end{aligned}\n$$\n\nNow, to find the value of $n$ that gives $a_n=96$, we can use the formula for the $n$th term, as follows:\n\n$$\n\\begin{aligned}\na_{n} &= 3 \\cdot 2^{n - 1} \\\\\n96 &= 3 \\cdot 2^{n - 1} \\\\\n32 &= 2^{n - 1} \\\\\n2^{5} &= 2^{n - 1}\n\\end{aligned}\n$$\n\nEquating the exponents gives:\n\n$$\n5 = n - 1\\quad \\Longrightarrow \\quad n = 6\n$$\n\nTherefore, $96$ is the $6$th term of the sequence." :tutorial/id #uuid "77450737-c02f-5751-b70b-0b387def70eb" :tutorial/math-academy-id 1672 :tutorial/title "Introduction"} :step/id #uuid "fbfa3bf3-20c5-5d4d-a7dd-74222bd4805e" :step/math-academy-id 4734 :step/next {:db/id #edb/ref 17592186079314}} {:db/id #edb/ref 17592186079510 :step/content {:db/id #edb/ref 17592186078564 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078205 :question/id #uuid "426f52d9-ad0e-5ef3-a545-78315ea02c0e" :question/math-academy-id "e-1514"} :knowledge-point/id #uuid "d47c0304-a438-5444-9add-5e4f61acbbcd" :knowledge-point/questions [{:db/id #edb/ref 17592186079113} {:db/id #edb/ref 17592186079126}] :knowledge-point/title "Finding the Index of a Term Given the First Term and Another Term"} :step/id #uuid "a4bf9b19-3f3a-5399-8f55-c85f6684f07d" :step/math-academy-id 4735 :step/next {:db/id #edb/ref 17592186079313}} {:db/id #edb/ref 17592186079511 :step/content {:db/id #edb/ref 17592186078565 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078206 :question/id #uuid "e3fed3e8-9bc6-558d-a426-96006871a20d" :question/math-academy-id "e-1516"} :knowledge-point/id #uuid "aaa87d67-d9df-5bbb-b98e-00d72d16fe7f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049083}] :knowledge-point/questions [{:db/id #edb/ref 17592186078895} {:db/id #edb/ref 17592186079114}] :knowledge-point/title "Finding the Index of a Particular Term When the First Term is Unknown"} :step/id #uuid "a73a35bf-c363-53aa-a8e5-abf04854ae43" :step/math-academy-id 4741}] :activity/title "Determining Indexes of Terms in Geometric Sequences" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078698}]}
