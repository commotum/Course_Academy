4-51bb-b6ff-834d2bc4fa93" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186440712} {:answer-field/choices [{:answer/id #uuid "0f2fa47c-0109-5d2e-84d9-59c969e4fe18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186440659}] :answer-field/correct {:answer/id #uuid "0f2fa47c-0109-5d2e-84d9-59c969e4fe18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186440659} :answer-field/id #uuid "ba2b18d5-3302-5878-81ce-3a17c6769fcf" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186440713}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "389f8107-d36d-5e2a-813a-3711b6104288" :question/math-academy-id "q-237526" :question/problem "![](images/75/75541d04a4f9f324910b584c139f970044d7973ff0b68088fc2152c38d6ef3c8.png)\n\nUse the model above to determine the missing numbers in the following division problem.\n\n{{field-1}}\n$÷\\,\\frac{2}{4}=$\n{{field-2}}" :question/worked-solution "Let's start by interpreting our model:\n\n- The model shows $3$ wholes. Each whole is split into *fourths*.\n\n![](images/60/606a6bfa9efc29dab451ce936003a0668664fdd0e853e98264ecc0a0af062fd9.png)\n\n \n\n- The fourths are grouped, and each group contains $\\frac{2}{4}.$\n\n![](images/f7/f7747d516865a13babe44cbf6d2ceab399b1106ae0f8eedc3b849967d436d7da.png)\n\n \n\n- There are $6$ groups in total.\n\n![](images/cb/cb4655782705d05f32db002c8e7ace17c672e6e521650d351bcc81461a10c5f3.png)\n\n \n\nSo, if we divide $3$ wholes into groups of $\\frac{2}{4},$ we get $6$ groups in total.\n\nTherefore, the model represents the following division problem:\n\n$$\n\\boxed{\\,3\\,}÷\\frac{2}{4}=\\boxed{\\,6\\,}\n$$\n\nTherefore, the missing numbers are $3$ and $6.$"}] [{:db/id #edb/ref 17592186143257 :knowledge-point/_questions [{:db/id #edb/ref 17592186142847 :knowledge-point/id #uuid "fe5587f6-f6a7-523c-b532-15786ade73b7" :knowledge-point/title "Dividing a Whole Number by a Non-Unit Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d682a00-6c22-5ef0-a86e-25070c5c017d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186440689}] :answer-field/correct {:answer/id #uuid "8d682a00-6c22-5ef0-a86e-25070c5c017d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186440689} :answer-field/id #uuid "2ec19b71-3b3a-5435-8cc7-7348e2f13fc3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186140510}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "81a263a9-d502-559d-acde-febf3ffe6377" :question/math-academy-id "q-237553" :question/problem "![](images/45/45d4e4ca4f1cdfddcb624dccf32cb053818a2fd70cbb7b5a02d1ff30f9784e2b.png)\n\nIf the model above represents $3$ wholes, use the model to solve the following division problem. Express your answer as a whole number.\n\n$3÷\\frac{3}{7}=$\n{{field-1}}" :question/worked-solution "We proceed as follows:\n\n- First, we split each whole into sevenths.\n\n![](images/16/16e82ebe81e32e4a5d5d273a8dfbdb0669a65b5268ff2653f38ea578d5f52681.png)\n\n \n\n- Next, we create groups of $\\frac{3}{7}.$\n\n![](images/b1/b1eb547db76061c7f24a34249554ade3226668e460fac1473e3280fe50807c6b.png)\n\n \n\n- Then, we count the groups.\n\n![](images/6f/6f79a68dece26e9e430a4b905ee72626fd3ddcbc61dd49b6d8a8d86252dbb31c.png)\n\n \n\nSo, if we divide $3$ wholes into groups of $\\frac{3}{7},$ we get $7$ groups in total.\n\nTherefore, we conclude that\n\n$$\n3÷\\frac{3}{7}=7.\n$$"}] [{:db/id #edb/ref 17592186440728 :knowledge-point/_questions [{:db/id #edb/ref 17592186142847 :knowledge-point/id #uuid "fe5587f6-f6a7-523c-b532-15786ade73b7" :knowledge-point/title "Dividing a Whole Number by a Non-Unit Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "873f8a2f-8b41-59e8-92b6-d6dc4f45a1db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186440686}] :answer-field/correct {:answer/id #uuid "873f8a2f-8b41-59e8-92b6-d6dc4f45a1db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186440686} :answer-field/id #uuid "616e9c21-247d-5e5d-90e2-6b489a175453" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186440707}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "78c4fd59-49dd-56c1-ac67-210c652702b1" :question/math-academy-id "q-237555" :question/problem "![](images/4f/4fd99d8e6a64427167fee57e0e0ba7c55cbe9a0bac31157f9692e3cd4a346f00.png)\n\nIf the model above represents $3$ wholes, use the model to solve the following division problem. Express your answer as a whole number.\n\n$3÷\\frac{3}{6}=$\n{{field-1}}" :question/worked-solution "We proceed as follows:\n\n- First, we split each whole into sixths.\n\n![](images/d9/d90639c936363a89657dd29172d5fd244b88ddbc80e5c5c2ad3a1b435736ac60.png)\n\n \n\n- Next, we create groups of $\\frac{3}{6}.$\n\n![](images/72/722e68a49beefa326bddf7f29c374a9b0c274e56a9621092a0dca6b6465e468b.png)\n\n \n\n- Then, we count the groups.\n\n![](images/8a/8a13c7877fcbaaac076b55091d39a2a6c92eef5edf2105dcaafb18a9b5415cbc.png)\n\n \n\nSo, if we divide $3$ wholes into groups of $\\frac{3}{6},$ we get $6$ groups in total.\n\nTherefore, we conclude that\n\n$$\n3÷\\frac{3}{6}=6.\n$$"}] [{:db/id #edb/ref 17592186440726 :knowledge-point/_questions [{:db/id #edb/ref 17592186142847 :knowledge-point/id #uuid "fe5587f6-f6a7-523c-b532-15786ade73b7" :knowledge-point/title "Dividing a Whole Number by a Non-Unit Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "225d2f56-d24f-515c-9eb3-656a3ca65350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186440664} {:answer/id #uuid "39a1e469-83bc-53b6-bf8b-974fa2229870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186440670} {:answer/id #uuid "49fa7e10-2005-5d0a-bc45-0b9154d3eca9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186440672} {:answer/id #uuid "68c795f5-1a0e-5887-86c6-066a1ba2f993" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186440677} {:answer/id #uuid "bbe6ded9-ab0f-5983-9b5a-491fa31b352d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186440695}] :answer-field/correct {:answer/id #uuid "bbe6ded9-ab0f-5983-9b5a-491fa31b352d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186440695} :answer-field/id #uuid "1b10f244-3dca-52d5-9f11-a4faf5704079" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186440705}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "734f4af7-992c-56b2-a4be-8fd1acb71c1a" :question/math-academy-id "q-61079" :question/problem "![](images/62/62bc017c2a920b6e1014fe652ce847d76b062bf2290e2916a99b830e8e10db45.png)\n\nThe model above represents $2$ wholes. Use the model to determine the missing number in the following division problem.\n\n$$\n2÷\\frac{2}{3}=\\boxed{\\,\\,}\n$$" :question/worked-solution "We proceed as follows:\n\n- First, we split each whole into thirds.\n\n![](images/d9/d9c692ed44d98c47b475dc18c2d28a01d0ab1f2f231ed24a9604f14000f599b1.png)\n\n \n\n- Next, we create groups of $\\frac{2}{3}.$\n\n![](images/3c/3c9fd6222f68deffa02ce69a2f31dca220ce2285f71dbd8255d364126ea0d8c8.png)\n\n \n\n- Then, we count the groups.\n\n![](images/22/228c9e5eea2b5696d64d4423ecd927e12a11e6672d614cc30a947549943be0c4.png)\n\n \n\nSo, if we divide $2$ wholes into groups of $\\frac{2}{3},$ we get $3$ groups in total.\n\nTherefore, we conclude that\n\n$$\n2÷\\frac{2}{3}=\\boxed{\\text{3}}.\n$$\n\nSo, the missing number is $3.$"}] [{:db/id #edb/ref 17592186440731 :knowledge-point/_questions [{:db/id #edb/ref 17592186142847 :knowledge-point/id #uuid "fe5587f6-f6a7-523c-b532-15786ade73b7" :knowledge-point/title "Dividing a Whole Number by a Non-Unit Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d471c86-5bf8-5123-ae14-d39930b5a4f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186440671} {:answer/id #uuid "74d51b07-ea24-533b-ad49-e92c87cfb13d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186440678} {:answer/id #uuid "879bd016-6739-5324-ad22-8733b1d9e5ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186440687} {:answer/id #uuid "89456ade-4939-5dd4-bea9-6e8d137e6ebd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186440688} {:answer/id #uuid "e73c0199-cede-5872-888c-35bcb181987b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186440700}] :answer-field/correct {:answer/id #uuid "3d471c86-5bf8-5123-ae14-d39930b5a4f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186440671} :answer-field/id #uuid "62714c3a-8199-51fc-b6c3-2a4484fd4f42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186440708}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bce29865-432c-5a79-a98d-71299b5409b3" :question/math-academy-id "q-61360" :question/problem "![](images/66/66d5a573ea6ca96486c172021b8948273ac593a80b9eae335681a20b1dc1bb0b.png)\n\nThe model above represents $3$ wholes. Use the model to determine the missing number in the following division problem.\n\n$$\n3÷\\frac{3}{4}=\\boxed{\\,\\,}\n$$" :question/worked-solution "We proceed as follows:\n\n- First, we split each whole into fourths.\n\n![](images/42/42f81180846a0498783403b8bbce0523922e81ed44b40ca401e47a04ad36d157.png)\n\n \n\n- Next, we create groups of $\\frac{3}{4}.$\n\n![](images/38/382113c4fb25a663548966d5e714bc9d1f79ba27f5de114da775ec451c8150ca.png)\n\n \n\n- Then, we count the groups.\n\n![](images/5e/5e236ffc51b1faeb2f38df7fc022bd1b28a0e7dea093310941b251b24601f587.png)\n\n \n\nSo, if we divide $3$ wholes into groups of $\\frac{3}{4},$ we get $4$ groups in total.\n\nTherefore, we conclude that\n\n$$\n3÷\\frac{3}{4}=\\boxed{\\text{4}}.\n$$\n\n \n\nSo, the missing number is $4.$"}]}
