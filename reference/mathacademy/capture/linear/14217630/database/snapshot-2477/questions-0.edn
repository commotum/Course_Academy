#{[{:db/id #edb/ref 17592186063929 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064267 :knowledge-point/id #uuid "68635d27-a9ef-541b-a57b-d9f5f422ae85" :knowledge-point/title "Calculating the Average Rate of Change of a Function"}] :question/id #uuid "ac676612-cbb2-5057-a515-501e03414b5a" :question/math-academy-id "e-118" :question/problem "A curve is defined as $y = 2x^2$. Find the average rate of change of $y$ over the interval $[0,5]$." :question/worked-solution "Let\n\n$$\nf(x)=2x^2\n$$\n\nApplying the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\n\\frac{Δy}{Δx} &= (f(b) - f(a))/(b - a) \\\\\n&= (f(5) - f(0))/(5 - (0)) \\\\\n&= ((2(5)^{2}) - (2(0)^{2}))/(5) \\\\\n&= \\frac{50}{5} \\\\\n&= 10\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063930 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064269 :knowledge-point/id #uuid "8d13310c-2b80-5945-ada3-31d886f1ec48" :knowledge-point/title "Calculating the Average Rate of Change: Word Problem"}] :question/id #uuid "484ff19c-9a37-553c-a5d5-837a50574703" :question/math-academy-id "e-120" :question/problem "Dave plants a tree in his garden. After $x$ months the tree is $2\\sqrt x + 1$ feet high. What is the average rate of growth of the tree over the first six months?" :question/worked-solution "Let\n\n$$\nf(x)=2\\sqrt{x}+1\n$$\n\nbe the height of the tree after $x$ months. The average rate of growth of the tree over the first six months is the average value of $f(x)$ on the interval $[0,6]$.\n\nApplying the formula, we get\n\n$$\n\\begin{aligned}\n\\frac{Δf}{Δx} &= (f(b) - f(a))/(b - a) \\\\\n&= (f(6) - f(0))/(6) \\\\\n&= (2\\sqrt{6} + 1 - (2\\sqrt{0} + 1))/(6) \\\\\n&= \\frac{2\\sqrt{6}}{6} \\\\\n&= \\frac{\\sqrt{6}}{3}\n\\end{aligned}\n$$\n\nTherefore, the average rate of growth is\n\n$$\n\\dfrac {\\sqrt 6} 3 \\approx 0.82\n$$\n\nfeet per month."}] [{:db/id #edb/ref 17592186063931 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064268 :knowledge-point/id #uuid "1f7224e3-9c13-51e7-a3f7-0e379f63a861" :knowledge-point/title "Calculating the Average Rate of Change Given a Table"}] :question/id #uuid "40bfeecc-aa0f-5901-9d75-bc94421b14ec" :question/math-academy-id "e-121" :question/problem "Find the average rate of change of the function $f(x)$ on the interval $[-1,2]$ given the following table of values for $f(x)$:\n\n| $x$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,2\\,$ | $\\,3\\,$ | $\\,4\\,$ |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: |\n| $f(x)$ | $\\,-3\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,6\\,$ | $\\,0\\,$ | $\\,4\\,$ |" :question/worked-solution "Using the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\n\\frac{Δf}{Δx} &= (f(b) - f(a))/(b - a) \\\\\n&= (f(2) - f(-1))/(2 - (-1)) \\\\\n&= (6 - (-3))/(2 - (-1)) \\\\\n&= 3\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063932 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064270 :knowledge-point/id #uuid "051b5337-7671-599f-a7f3-c3fb064575cc" :knowledge-point/title "Determining the Interval Over Which the Average Rate of Change is Zero"}] :question/id #uuid "50e4be08-7e9b-501b-beae-686aa62e96f3" :question/math-academy-id "e-122" :question/problem "Find the interval where the average rate of change of $f(x)$ equals $0$ given the following table of values for $f(x)$:\n\n| $x$ | $\\,-2\\,$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,2\\,$ | $\\,5\\,$ | $\\,7\\,$ |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n| $f(x)$ | $\\,2\\,$ | $\\,1\\,$ | $\\,4\\,$ | $\\,-5\\,$ | $\\,-7\\,$ | $\\,2\\,$ | $\\,-2\\,$ |" :question/worked-solution "We have\n\n$$\n\\dfrac{\\Delta f}{\\Delta x}=0\n$$\n\nif and only if\n\n$$\n\\Delta f = 0\n$$\n\nSo\n\n$$\nΔf = 0; f(b) - f(a) = 0; f(b) = f(a)\n$$\n\nThis means we have to find an interval $[a,b]$ such that\n\n$$\nf(a)=f(b)\n$$\n\nSince\n\n$$\nf(-2)=f(5)=2\n$$\n\nwe conclude that\n\n$$\n\\dfrac{\\Delta f}{\\Delta x}=0\n$$\n\non the interval $[-2,5]$."}] [{:db/id #edb/ref 17592186064565 :knowledge-point/_questions [{:db/id #edb/ref 17592186064267 :knowledge-point/id #uuid "68635d27-a9ef-541b-a57b-d9f5f422ae85" :knowledge-point/title "Calculating the Average Rate of Change of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bb2e6d9-a77d-57a2-9067-88938b25fdf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186061586} {:answer/id #uuid "c9c43b9e-95bc-527c-aaa8-97ef8fe71eb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186061587} {:answer/id #uuid "eab80576-cf3c-565b-8b70-625ee7c85497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186061588} {:answer/id #uuid "ecdbf5c9-b46e-558c-a271-c8dd2bf11f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186061589} {:answer/id #uuid "1bdd418b-40e8-5c8b-9aee-f67c99347494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186061590}] :answer-field/id #uuid "258c7721-283b-58d1-a5c6-b9d2648fb034" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061585}] :question/id #uuid "e460d45e-d406-504b-ba46-cb34526931e8" :question/math-academy-id "q-20832" :question/problem "A curve is defined as $y = x^{4} - 3x^{3} + 3x$. Find the average rate of change of $y$ over the interval $[- 1, 3]$.\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}]}
