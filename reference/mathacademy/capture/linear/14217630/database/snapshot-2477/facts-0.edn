97ef8fe71eb9" #edb/ref 17592186045417] [17592186061588 #edb/ref 1080 "-\\frac{3}{2}" #edb/ref 17592186045417] [17592186061588 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186061588 #edb/ref 1083 #uuid "eab80576-cf3c-565b-8b70-625ee7c85497" #edb/ref 17592186045417] [17592186061589 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186061589 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186061589 #edb/ref 1083 #uuid "ecdbf5c9-b46e-558c-a271-c8dd2bf11f35" #edb/ref 17592186045417] [17592186061590 #edb/ref 1080 "9" #edb/ref 17592186045417] [17592186061590 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186061590 #edb/ref 1083 #uuid "1bdd418b-40e8-5c8b-9aee-f67c99347494" #edb/ref 17592186045417] [17592186063929 #edb/ref 1069 "e-118" #edb/ref 17592186045417] [17592186063929 #edb/ref 1071 "A curve is defined as $y = 2x^2$. Find the average rate of change of $y$ over the interval $[0,5]$." #edb/ref 17592186045417] [17592186063929 #edb/ref 1072 #uuid "ac676612-cbb2-5057-a515-501e03414b5a" #edb/ref 17592186045417] [17592186063929 #edb/ref 1074 "Let\n\n$$\nf(x)=2x^2\n$$\n\nApplying the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\n\\frac{Δy}{Δx} &= (f(b) - f(a))/(b - a) \\\\\n&= (f(5) - f(0))/(5 - (0)) \\\\\n&= ((2(5)^{2}) - (2(0)^{2}))/(5) \\\\\n&= \\frac{50}{5} \\\\\n&= 10\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186063930 #edb/ref 1069 "e-120" #edb/ref 17592186045417] [17592186063930 #edb/ref 1071 "Dave plants a tree in his garden. After $x$ months the tree is $2\\sqrt x + 1$ feet high. What is the average rate of growth of the tree over the first six months?" #edb/ref 17592186045417] [17592186063930 #edb/ref 1072 #uuid "484ff19c-9a37-553c-a5d5-837a50574703" #edb/ref 17592186045417] [17592186063930 #edb/ref 1074 "Let\n\n$$\nf(x)=2\\sqrt{x}+1\n$$\n\nbe the height of the tree after $x$ months. The average rate of growth of the tree over the first six months is the average value of $f(x)$ on the interval $[0,6]$.\n\nApplying the formula, we get\n\n$$\n\\begin{aligned}\n\\frac{Δf}{Δx} &= (f(b) - f(a))/(b - a) \\\\\n&= (f(6) - f(0))/(6) \\\\\n&= (2\\sqrt{6} + 1 - (2\\sqrt{0} + 1))/(6) \\\\\n&= \\frac{2\\sqrt{6}}{6} \\\\\n&= \\frac{\\sqrt{6}}{3}\n\\end{aligned}\n$$\n\nTherefore, the average rate of growth is\n\n$$\n\\dfrac {\\sqrt 6} 3 \\approx 0.82\n$$\n\nfeet per month." #edb/ref 17592186045417] [17592186063931 #edb/ref 1069 "e-121" #edb/ref 17592186045417] [17592186063931 #edb/ref 1071 "Find the average rate of change of the function $f(x)$ on the interval $[-1,2]$ given the following table of values for $f(x)$:\n\n| $x$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,2\\,$ | $\\,3\\,$ | $\\,4\\,$ |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: |\n| $f(x)$ | $\\,-3\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,6\\,$ | $\\,0\\,$ | $\\,4\\,$ |" #edb/ref 17592186045417] [17592186063931 #edb/ref 1072 #uuid "40bfeecc-aa0f-5901-9d75-bc94421b14ec" #edb/ref 17592186045417] [17592186063931 #edb/ref 1074 "Using the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\n\\frac{Δf}{Δx} &= (f(b) - f(a))/(b - a) \\\\\n&= (f(2) - f(-1))/(2 - (-1)) \\\\\n&= (6 - (-3))/(2 - (-1)) \\\\\n&= 3\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186063932 #edb/ref 1069 "e-122" #edb/ref 17592186045417] [17592186063932 #edb/ref 1071 "Find the interval where the average rate of change of $f(x)$ equals $0$ given the following table of values for $f(x)$:\n\n| $x$ | $\\,-2\\,$ | $\\,-1\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,2\\,$ | $\\,5\\,$ | $\\,7\\,$ |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n| $f(x)$ | $\\,2\\,$ | $\\,1\\,$ | $\\,4\\,$ | $\\,-5\\,$ | $\\,-7\\,$ | $\\,2\\,$ | $\\,-2\\,$ |" #edb/ref 17592186045417] [17592186063932 #edb/ref 1072 #uuid "50e4be08-7e9b-501b-beae-686aa62e96f3" #edb/ref 17592186045417] [17592186063932 #edb/ref 1074 "We have\n\n$$\n\\dfrac{\\Delta f}{\\Delta x}=0\n$$\n\nif and only if\n\n$$\n\\Delta f = 0\n$$\n\nSo\n\n$$\nΔf = 0; f(b) - f(a) = 0; f(b) = f(a)\n$$\n\nThis means we have to find an interval $[a,b]$ such that\n\n$$\nf(a)=f(b)\n$$\n\nSince\n\n$$\nf(-2)=f(5)=2\n$$\n\nwe conclude that\n\n$$\n\\dfrac{\\Delta f}{\\Delta x}=0\n$$\n\non the interval $[-2,5]$." #edb/ref 17592186045417] [17592186064267 #edb/ref 1037 #edb/ref 17592186048652 #edb/ref 17592186045417] [17592186064267 #edb/ref 1037 #edb/ref 17592186049061 #edb/ref 17592186045417] [17592186064267 #edb/ref 1038 #edb/ref 17592186064565 #edb/ref 17592186045417] [17592186064267 #edb/ref 1038 #edb/ref 17592186064635 #edb/ref 17592186045417] [17592186064267 #edb/ref 1038 #edb/ref 17592186233623 #edb/ref 17592186045417] [17592186064267 #edb/ref 1038 #edb/ref 17592186233667 #edb/ref 17592186045417] [17592186064267 #edb/ref 1038 #edb/ref 17592186511505 #edb/ref 17592186045417] [17592186064267 #edb/ref 1039 "Calculating the Average Rate of Change of a Function" #edb/ref 17592186045417] [17592186064267 #edb/ref 1041 #edb/ref 17592186063929 #edb/ref 17592186045417] [17592186064267 #edb/ref 1042 #uuid "68635d27-a9ef-541b-a57b-d9f5f422ae85" #edb/ref 17592186045417] [17592186064268 #edb/ref 1038 #edb/ref 17592186064522 #edb/ref 17592186045417] [17592186064268 #edb/ref 1038 #edb/ref 17592186064541 #edb/ref 17592186045417] [17592186064268 #edb/ref 1038 #edb/ref 17592186233053 #edb/ref 17592186045417] [17592186064268 #edb/ref 1038 #edb/ref 17592186233537 #edb/ref 17592186045417] [17592186064268 #edb/ref 1038 #edb/ref 17592186233606 #edb/ref 17592186045417] [17592186064268 #edb/ref 1038 #edb/ref 17592186233607 #edb/ref 17592186045417] [17592186064268 #edb/ref 1039 "Calculating the Average Rate of Change Given a Table" #edb/ref 17592186045417] [17592186064268 #edb/ref 1041 #edb/ref 17592186063931 #edb/ref 17592186045417] [17592186064268 #edb/ref 1042 #uuid "1f7224e3-9c13-51e7-a3f7-0e379f63a861" #edb/ref 17592186045417] [17592186064269 #edb/ref 1038 #edb/ref 17592186064573 #edb/ref 17592186045417] [17592186064269 #edb/ref 1038 #edb/ref 1