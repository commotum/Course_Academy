#{[{:activity/first-step {:db/id #edb/ref 17592186065149} :activity/id #uuid "633bad62-882e-5d8a-8c9d-aa13b14ea6e1" :activity/scope {:db/id #edb/ref 17592186050572 :topic/id #uuid "54b8c8a0-5bff-5a9f-9ca1-b046c38a20d9" :topic/math-academy-id 336} :activity/steps [{:db/id #edb/ref 17592186065149 :step/content {:db/id #edb/ref 17592186065362 :tutorial/content "Consider a curve $y=f(x)$ between two points $x=a$ and $x=b$. The **average rate of change** of $y=f(x)$ on the interval $x\\in[a,b]$ is computed as follows:\n\n$$\n\\dfrac{\\Delta y}{\\Delta x} = \\dfrac{\\text{change in}y}{\\text{change in}x} = \\dfrac{f(b)-f(a)}{b-a}\n$$\n\nGeometrically, the average rate of change represents the slope of the **secant line** which passes through $(a,f(a))$ and $(b,f(b))$.\n\n![](images/2d/2d27bcc73d1bcb8545c058c06553e3f4bc80d5426a98f5bb90e4d4c0aef71108.png)\n\n**Note:** In general, a secant is a line that intersects a curve at two or more distinct points." :tutorial/id #uuid "4e32384d-35c4-578e-b254-9cf90914529e" :tutorial/math-academy-id 312 :tutorial/title "Introduction"} :step/id #uuid "59d271e2-f80e-5c14-bfff-c684c31322e1" :step/math-academy-id 206314 :step/next {:db/id #edb/ref 17592186065150}} {:db/id #edb/ref 17592186065150 :step/content {:db/id #edb/ref 17592186064267 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063929 :question/id #uuid "ac676612-cbb2-5057-a515-501e03414b5a" :question/math-academy-id "e-118"} :knowledge-point/id #uuid "68635d27-a9ef-541b-a57b-d9f5f422ae85" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652} {:db/id #edb/ref 17592186049061}] :knowledge-point/questions [{:db/id #edb/ref 17592186064565} {:db/id #edb/ref 17592186064635} {:db/id #edb/ref 17592186233623} {:db/id #edb/ref 17592186233667} {:db/id #edb/ref 17592186511505}] :knowledge-point/title "Calculating the Average Rate of Change of a Function"} :step/id #uuid "963172d5-8251-51b5-aca6-4ecca42d86ee" :step/math-academy-id 206315 :step/next {:db/id #edb/ref 1