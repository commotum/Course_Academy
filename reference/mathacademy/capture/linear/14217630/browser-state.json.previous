se\">]</mo></mrow><mn>4</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>9</mn><mo>−</mo><mn>1</mn></mrow><mn>4</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>8</mn><mn>4</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mn>2.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
