  "live_records": {
    "q-20832": {
      "dom_id": "step-q20832",
      "name": "Question 1",
      "problem": "A curve is defined as $y={x}^{4}-3{x}^{3}+3x.$ Find the average rate of change of $y$ over the interval $[-1,3].$",
      "worked_solution": "Let $f(x)={x}^{4}-3{x}^{3}+3x.$ Applying the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\\frac{Δy}{Δx} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(3)-f(-1)}{3-(-1)} \\\\  & =\\frac{[{3}^{4}-3({3}^{3})+3(3)]-[(-1)^{4}-3(-1)^{3}+3(-1)]}{4} \\\\  & =\\frac{9-1}{4} \\\\  & =\\frac{8}{4} \\\\  & =2.\\end{aligned}\n$$",
      "calculator_instructions": "",
