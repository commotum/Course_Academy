#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186074837} :activity/id #uuid "6abf4cca-9ce9-543e-b69b-460bc5feb49d" :activity/scope {:db/id #edb/ref 17592186049453 :topic/id #uuid "f6bff719-8556-59fe-8f37-6cf30097092e" :topic/math-academy-id 566} :activity/steps [{:db/id #edb/ref 17592186074734 :step/content {:db/id #edb/ref 17592186073793 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073415 :question/id #uuid "3deda9a1-7edd-5b1e-9f39-5c69644f30ab" :question/math-academy-id "e-10542"} :knowledge-point/id #uuid "940366ef-28e8-5827-b52d-a8b500dbb2a1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050249}] :knowledge-point/questions [{:db/id #edb/ref 17592186074403} {:db/id #edb/ref 17592186074445} {:db/id #edb/ref 17592186455466}] :knowledge-point/title "Multiplying a Fraction by a Whole Number: Result Is a Mixed Number"} :step/id #uuid "f5e9fd25-c8c7-5c5a-a339-898928ef9262" :step/math-academy-id 39848 :step/next {:db/id #edb/ref 17592186074735}} {:db/id #edb/ref 17592186074735 :step/content {:db/id #edb/ref 17592186073794 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073416 :question/id #uuid "9fb671f7-6d04-5863-9683-3b2c3753df73" :question/math-academy-id "e-10543"} :knowledge-point/id #uuid "b58f3a78-53b1-577f-8907-d53a00186686" :knowledge-point/questions [{:db/id #edb/ref 17592186074444} {:db/id #edb/ref 17592186074446} {:db/id #edb/ref 17592186455461} {:db/id #edb/ref 17592186455479}] :knowledge-point/title "Determining Whole Number Bounds of a Multiplication Problem"} :step/id #uuid "c28fe622-ab99-50b0-a92e-6e1e1322ca4c" :step/math-academy-id 39849} {:db/id #edb/ref 17592186074837 :step/content {:db/id #edb/ref 17592186074957 :tutorial/content "In this lesson, we'll consider real-life situations where we have to multiply fractions by whole numbers.\n\nSuppose that Justin, a chef, has $8$ large tins of tomatoes. If each tin of tomatoes weighs $\\dfrac{5}{4}\\,\\textrm{lb},$ how many pounds of tomatoes does Justin have in total?\n\nTo find out the total weight of tomatoes, we need to multiply $\\dfrac{5}{4}\\,\\textrm{lb}$ by $8.$  \n\nTo multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n8 \\times \\dfrac54= \\dfrac{8\\times 5}{4} = \\dfrac{40}4\n$$\n\nWe can simplify this fraction by interpreting the fraction as a division:\n\n$$\n\\dfrac{40}{4} =  40 \\div 4 = 10\n$$\n\nSo, in total, Justin has $10\\,\\textrm{lb}$ of tomatoes." :tutorial/id #uuid "298ab81d-8afe-5255-bdcd-354d669f8700" :tutorial/math-academy-id 1886 :tutorial/title "Introduction"} :step/id #uuid "96933400-d1d9-564b-821e-12dd6c004ad6" :step/math-academy-id 6461 :step/next {:db/id #edb/ref 17592186074838}} {:db/id #edb/ref 17592186074838 :step/content {:db/id #edb/ref 17592186073859 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073538 :question/id #uuid "737b03c4-95f0-5a89-a428-e051b9efee6d" :question/math-academy-id "e-1863"} :knowledge-point/id #uuid "f8b003cb-5504-549c-8da4-fdc91242c8af" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048624} {:db/id #edb/ref 17592186050599}] :knowledge-point/questions [{:db/id #edb/ref 17592186074404} {:db/id #edb/ref 17592186074431} {:db/id #edb/ref 17592186455488}] :knowledge-point/title "Multiplying a Fraction by a Whole Number: Result Is a Whole Number"} :step/id #uuid "e1f36309-f225-55f2-a168-85f87992f190" :step/math-academy-id 6462 :step/next {:db/id #edb/ref 17592186074734}}] :activity/title "Multiplying Fractions by Whole Numbers: Word Problems" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073984}]}
