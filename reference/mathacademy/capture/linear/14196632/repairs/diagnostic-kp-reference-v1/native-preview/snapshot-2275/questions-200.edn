#{[{:db/id #edb/ref 17592186233504 :knowledge-point/_questions [{:db/id #edb/ref 17592186192815 :knowledge-point/id #uuid "7266d5c7-67b9-59db-b994-07dcb143af1f" :knowledge-point/title "Finding the Inverse of a Simple Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64a8b4ab-c23e-5d88-b637-6f5584a95608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+5}{x+6}" :db/id #edb/ref 17592186512338} {:answer/id #uuid "6b9ca4df-8417-5084-ac48-203c262cbbfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{7-6x}{5x+1}" :db/id #edb/ref 17592186512356} {:answer/id #uuid "8a28b1aa-9eaa-5f37-9ff3-545ca9a7ab3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{6-x}{x-5}" :db/id #edb/ref 17592186512422} {:answer/id #uuid "a5a1b1d8-acbe-5be7-a6ee-b82eda6bf9fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{7x+6}{x-5}" :db/id #edb/ref 17592186512490} {:answer/id #uuid "dce17946-5ca5-50b7-9337-491e29e13717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{6-7x}{x+5}" :db/id #edb/ref 17592186512629}] :answer-field/correct {:answer/id #uuid "dce17946-5ca5-50b7-9337-491e29e13717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{6-7x}{x+5}" :db/id #edb/ref 17592186512629} :answer-field/id #uuid "ec781e0d-5672-5d8a-a7d3-0b30ab64cffc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512854}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09439e98-9680-5cbd-876f-1f24d85d22d7" :question/math-academy-id "q-148512" :question/problem "Find the inverse of the function $f(x)=\\frac{6-5x}{x+7}.$" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{6-5x}{x+7}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{6-5y}{y+7}.\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{6-5y}{y+7} \\\\ x(y+7) & =6-5y \\\\ xy+7x & =6-5y \\\\ xy+5y & =6-7x \\\\ y(x+5) & =6-7x \\\\ y & =\\frac{6-7x}{x+5}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{6-7x}{x+5}.\n$$"}] [{:db/id #edb/ref 17592186233542 :knowledge-point/_questions [{:db/id #edb/ref 17592186054733 :knowledge-point/id #uuid "a09b3f4a-a1df-504e-8e9f-510225da1392" :knowledge-point/title "Multiplying Two Complex Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e6c14c3-46ef-52b6-9c5a-9d55e3141b28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+15\\,\\text{i}" :db/id #edb/ref 17592186512271} {:answer/id #uuid "60b74954-3003-503f-a9dc-2f3cea1add5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "63+15\\,\\text{i}" :db/id #edb/ref 17592186512330} {:answer/id #uuid "60e0e66a-c149-588b-90b5-4254cd022492" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-67-15\\,\\text{i}" :db/id #edb/ref 17592186512331} {:answer/id #uuid "68ab3fb9-a119-597e-9344-6ff98a17ba94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "63+12\\,\\text{i}" :db/id #edb/ref 17592186512351} {:answer/id #uuid "7e36ff1c-756d-5ab9-a64f-f67db129bbaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81-12\\,\\text{i}" :db/id #edb/ref 17592186512397}] :answer-field/correct {:answer/id #uuid "4e6c14c3-46ef-52b6-9c5a-9d55e3141b28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+15\\,\\text{i}" :db/id #edb/ref 17592186512271} :answer-field/id #uuid "0bc5ff01-f7ae-5810-8e9a-c63f6da9b11b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512727}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f4508476-b89c-53c0-90e9-f3a9b08e0f33" :question/math-academy-id "q-16295" :question/problem "$(6-9\\,\\text{i})(3+7\\,\\text{i})=$" :question/worked-solution "Multiplying two complex numbers is similar to multiplying two binomials. We also use the fact that ${\\text{i}}^{2}=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(6-9\\,\\text{i})(3+7\\,\\text{i}) & =6\\cdot 3+6\\cdot 7\\,\\text{i}+(-9\\,\\text{i})\\cdot 3+(-9\\,\\text{i})\\cdot 7\\,\\text{i} \\\\  & =18+42\\,\\text{i}-27\\,\\text{i}-63\\,{\\text{i}}^{2} \\\\  & =18+15\\,\\text{i}-63\\cdot (-1) \\\\  & =18+15\\,\\text{i}+63 \\\\  & =81+15\\,\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233592 :knowledge-point/_questions [{:db/id #edb/ref 17592186198451 :knowledge-point/id #uuid "874dfb35-398e-5ed7-8a76-f0011569e6a1" :knowledge-point/title "Computing a Complement Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1537842d-13cc-58e0-a0d1-143d9983a915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186512145} {:answer/id #uuid "25d9c9bd-9d1a-5474-8d96-6dd5e36e339b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{17}" :db/id #edb/ref 17592186512181} {:answer/id #uuid "48992171-11ab-56d9-b3bd-6dc0be5319e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{17}" :db/id #edb/ref 17592186512255} {:answer/id #uuid "7dd7ce66-80c6-5c47-a014-bc47fefa20f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{16}" :db/id #edb/ref 17592186512396} {:answer/id #uuid "fd4ece7b-d879-59f6-b3c7-36a00c82fb05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{17}" :db/id #edb/ref 17592186512714}] :answer-field/correct {:answer/id #uuid "25d9c9bd-9d1a-5474-8d96-6dd5e36e339b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{17}" :db/id #edb/ref 17592186512181} :answer-field/id #uuid "3f94bd53-f137-5cf0-9547-b2c16a22c866" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512759}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "81a4737e-d96b-5774-b418-c2e889c0a2b6" :question/math-academy-id "q-180277" :question/problem "![](images/a6/a61a6232b2041bab3d455a7d765311ddfae25f674f8dbbf79696d2137355b159.png)\n\nThe Venn diagram shown above represents two events $A$ and $B$ and the number of outcomes in each region of the sample space.\n\nGiven that every outcome is equally likely, find $P({A}^{′}\\cup {B}^{′}).$" :question/worked-solution "To calculate the probability of an event using a Venn diagram, we count the number of outcomes in the region that represents the event, and divide by the total number of outcomes of the sample space $S.$\n\nIn the Venn diagram, ${A}^{′}\\cup {B}^{′}$ is represented by the area outside the circle $B$ or outside the circle $A$ (see the illustration below).\n\n![](images/6a/6a3bb7b671e45aeb15d3239cae6fcedb7c36e52b15141d66b23e65066ab37edc.png)\n\nWe count up the outcomes:\n\n- The number of outcomes in ${A}^{′}\\cup {B}^{′}$ is \n\n$$\n2+5+1=8\n$$\n\n- The total number of outcomes in $S$ is\n\n$$\n2+9+5+1=17.\n$$\n\nSo, we have\n\n$$\nP({A}^{′}\\cup {B}^{′})=\\frac{8}{17}.\n$$"}] [{:db/id #edb/ref 17592186233616 :knowledge-point/_questions [{:db/id #edb/ref 17592186059790 :knowledge-point/id #uuid "57bae420-d529-5b9d-a306-37127c523be6" :knowledge-point/title "Applying the Rule of Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f9be4f9-9349-5fa3-b613-a61f24179452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "270" :db/id #edb/ref 17592186410223} {:answer/id #uuid "8697752e-5619-5132-bce4-85f1b8da875e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "248" :db/id #edb/ref 17592186410285} {:answer/id #uuid "9d1dbebb-e0c2-52a0-8350-bb215802044b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "360" :db/id #edb/ref 17592186410306} {:answer/id #uuid "a7e38e02-fb12-5161-9fd0-deab260ddeca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "310" :db/id #edb/ref 17592186410316} {:answer/id #uuid "ce1bc7e2-fa14-5ac8-9514-f051895c965d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "288" :db/id #edb/ref 17592186410345}] :answer-field/correct {:answer/id #uuid "ce1bc7e2-fa14-5ac8-9514-f051895c965d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "288" :db/id #edb/ref 17592186410345} :answer-field/id #uuid "46b3319b-2af6-598f-8941-02f6c4fc8ef7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410386}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9db0cb85-c477-5f32-9094-207566837840" :question/math-academy-id "q-19821" :question/problem "Peter has $8$ shirts, $6$ pants, and $6$ pairs of shoes. If Peter wears one shirt, one pant, and one pair of shoes, how many different ways can Peter dress?" :question/worked-solution "Using the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Number of outfits} & =\\text{Number of shirts} \\\\  & \\times \\text{Number of pants} \\\\  & \\times \\text{Number of pairs of shoes} \\\\  & =8\\times 6\\times 6 \\\\  & =288.\\end{aligned}\n$$\n\nTherefore, Peter can dress in $288$ different ways."}] [{:db/id #edb/ref 17592186233682 :knowledge-point/_questions [{:db/id #edb/ref 17592186054679 :knowledge-point/id #uuid "0996a6f2-3c15-5670-891a-34fd6ecc8b72" :knowledge-point/title "Estimating a Variance or Standard Deviation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50cba50f-0215-54ad-96b6-a3d381b47f01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.9" :db/id #edb/ref 17592186512277}] :answer-field/correct {:answer/id #uuid "50cba50f-0215-54ad-96b6-a3d381b47f01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.9" :db/id #edb/ref 17592186512277} :answer-field/id #uuid "d0a16f09-2e74-5931-9828-588ba4cfaa5c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232372}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac5ee09a-446b-5918-96fe-4cc239c6a7e2" :question/math-academy-id "q-254742" :question/problem "Consider the frequency table below for a continuous variable $x.$ The total number of observations is $n=20,$ and the estimated sample mean is $\\overset{―}{x}≈13.5.$\n\n| Range | Frequency $({f}_{i})$ |\n| --- | --- |\n| $0\\le x<10$ | $8$ |\n| $10\\le x<20$ | $7$ |\n| $20\\le x<30$ | $5$ |\n\n$$\n\n$$\n\nUsing the midpoint of each class interval to approximate all observations within that class, estimate the standard deviation ${\\sigma }_{n},$ using $n$ as the denominator in the variance formula.\n\nRounded to one decimal place, ${\\sigma }_{n}≈$\n{{field-1}}" :question/worked-solution "Given a frequency table containing continuous data split into $K$ classes, we can estimate the variance by treating all observations within each class as though they were equal to the midpoint of that class. This gives\n\n$$\n{\\sigma }_{n}^{2}≈\\frac{1}{n}{\\sum }_{i=1}^{K}{f}_{i}\\cdot ({m}_{i}-\\overset{―}{x})^{2},\n$$\n\nwhere\n\n- ${f}_{i}$ is the frequency of the $i$th class,\n\n- ${m}_{i}$ is the midpoint of the $i$th class,\n\n- $n$ is the total number of observations, and\n\n- $\\overset{―}{x}$ is the estimated mean, calculated using the class midpoints.\n\nTo find the variance, we add columns to our table for the midpoints of each interval, the squared deviations of the midpoints from the mean, and the products of the squared deviations and frequencies.\n\n| Range | ${f}_{i}$ | ${m}_{i}$ | ${({m}_{i}-\\overset{―}{x})}^{2}$ | ${f}_{i}{({m}_{i}-\\overset{―}{x})}^{2}$ |\n| --- | --- | --- | --- | --- |\n| $0\\le x<10$ | $8$ | $5$ | $72.25$ | $578$ |\n| $10\\le x<20$ | $7$ | $15$ | $2.25$ | $15.75$ |\n| $20\\le x<30$ | $5$ | $25$ | $132.25$ | $661.25$ |\n\n$$\n\n$$\n\nThen, we divide the sum of all the values in the last column by $20$ (the total number of observations):\n\n$$\n\\begin{aligned}{\\sigma }_{n}^{2} & ≈\\frac{578+15.75+661.25}{20} \\\\  & =\\frac{1255}{20} \\\\  & =62.75\\end{aligned}\n$$\n\nFinally, the estimated standard deviation is the square root of the estimated variance:\n\n$$\n\\begin{aligned}{\\sigma }_{n} & ≈\\sqrt{62.75}≈7.9\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233712 :knowledge-point/_questions [{:db/id #edb/ref 17592186068831 :knowledge-point/id #uuid "cc402a1d-e538-5510-8a6f-79dd1626ff1f" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "046339ca-d635-57b1-a4b9-a7619ba24dea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186512111} {:answer/id #uuid "1eededde-27c4-5ab6-921a-69c922b3ddd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186512163} {:answer/id #uuid "4846d2a5-0437-5027-a18c-e8704132c534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186512253} {:answer/id #uuid "8dc266e6-456a-5c58-bbb2-5385368780aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186512431} {:answer/id #uuid "ec722ee2-a7c4-5b69-bb9e-dbec3b88f301" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186512672}] :answer-field/correct {:answer/id #uuid "ec722ee2-a7c4-5b69-bb9e-dbec3b88f301" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186512672} :answer-field/id #uuid "da30e9ce-0a25-5add-9fa0-a7b33a5bb2d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512843}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1ad05a96-8f5a-585b-894f-27d371577458" :question/math-academy-id "q-27541" :question/problem "![](images/41/41875c5ab1216b78760c1c2dddec6ffc31bfd57d2da27f4797b1190dbf4af709.png)\n\nThe graph above shows the curve $y=k{(\\frac{1}{2})}^{x}+c.$ Find the value of $k-c.$" :question/worked-solution "The horizontal asymptote of the curve $y=k{(\\frac{1}{2})}^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-3.$ Hence, $c=-3.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,1),$ so we substitute $x=0$ and $y=1$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}k{(\\frac{1}{2})}^{x}+c & =y \\\\ k{(\\frac{1}{2})}^{x}-3 & =y \\\\ k{(\\frac{1}{2})}^{0}-3 & =1 \\\\ k-3 & =1 \\\\ k & =4\\end{aligned}\n$$\n\nTherefore,\n\n$$\nk-c=4-(-3)=7.\n$$\n\nThe equation of the curve is $y=4{(\\frac{1}{2})}^{x}-3.$"}] [{:db/id #edb/ref 17592186512877 :knowledge-point/_questions [{:db/id #edb/ref 17592186213005 :knowledge-point/id #uuid "46822f28-8863-5150-a420-09c61a5c28b1" :knowledge-point/title "Comparing Factored Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e944915-2fc2-5b59-b074-8518099067d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186512398}] :answer-field/correct {:answer/id #uuid "7e944915-2fc2-5b59-b074-8518099067d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186512398} :answer-field/id #uuid "9df0f739-7e6e-51a0-aeca-cefca94dcd0f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186512808}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "19e31d5d-5933-52fe-a699-d3240dcd05a2" :question/math-academy-id "q-288661" :question/problem "The equation\n\n$$\n(ax-8)(x+b)=4{x}^{2}-32x+48\n$$\n\nis true for all values of $x,$ where $a$ and $b$ are constants. What is the value of $a+b?$\n\n$a+b=$\n{{field-1}}" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the product on the left-hand side must expand to match the right-hand side.\n\nFirst, let's expand the left-hand side:\n\n$$\n\\begin{aligned}(ax-8)(x+b) & =a{x}^{2}+abx-8x-8b \\\\  & =a{x}^{2}+(ab-8)x-8b.\\end{aligned}\n$$\n\nNext, we equate the expanded form to the right-hand side:\n\n$$\na{x}^{2}+(ab-8)x-8b=4{x}^{2}-32x+48.\n$$\n\nNow, we compare the coefficients of corresponding terms.\n\n- Equating the coefficients of ${x}^{2},$ we get\n\n$$\na=4.\n$$\n\n- Equating the constant terms, we get\n\n$$\n-8\\cdot b=48⇒b=-6.\n$$\n\nLet's verify that values $a=4$ and $b=-6$ produce the correct linear coefficient:\n\n$$\n\\begin{aligned}ab-8 & =4\\cdot (-6)-8 \\\\  & =-24-8 \\\\  & =-32\\,✓\\end{aligned}\n$$\n\nwhich matches the coefficient of $x$ on the right-hand side. So, our solution is valid.\n\nFinally, we compute the value of $a+b:$\n\n$$\n\\begin{aligned}a+b & =4+(-6) \\\\  & =-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186512876 :knowledge-point/_questions [{:db/id #edb/ref 17592186213068 :knowledge-point/id #uuid "410a9971-d4c0-57ff-b936-58621a2313b5" :knowledge-point/title "Constructing Functions With Alternative Domains"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "043178c1-c125-508a-9bc7-2d3b5ab2bbaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(t)=3t+2" :db/id #edb/ref 17592186512110} {:answer/id #uuid "7bc7d993-8b07-5c1f-bb87-a59ad81eac7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(t)=5t-4" :db/id #edb/ref 17592186512392} {:answer/id #uuid "be0ba7e5-fe56-50ea-afc4-f6da042055f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(t)=5t-3" :db/id #edb/ref 17592186512555} {:answer/id #uuid "c7de47a7-d842-546b-a5f0-ba929b208c17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(t)=3t+5" :db/id #edb/ref 17592186512582} {:answer/id #uuid "dd9abff9-7b86-525c-b8a8-762f29c56795" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(t)=5t+3" :db/id #edb/ref 17592186512632}] :answer-field/correct {:answer/id #uuid "7bc7d993-8b07-5c1f-bb87-a59ad81eac7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(t)=5t-4" :db/id #edb/ref 17592186512392} :answer-field/id #uuid "456409ce-9cbe-59f6-9c9f-5b1ca5269b70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512762}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "18899ab8-1919-5955-a40e-8e20033f8007" :question/math-academy-id "q-293604" :question/problem "A generator consumes $3$ liters of fuel per hour for the first two hours of use and $5$ liters for each additional hour. Which function $F$ gives the total amount of fuel consumed after $t$ hours, where $t\\ge 2?$" :question/worked-solution "The total amount of fuel consumed consists of two parts.\n\n- For the first $2$ hours, the generator consumes\n\n$$\n3\\times 2=6\\,\\,\\text{liters}.\n$$\n\n- For each additional hour beyond the first $2,$ the generator consumes\n\n$$\n5(t-2)\\,\\,\\text{liters}.\n$$\n\nTherefore, the total amount of fuel $F$ consumed after $t$ hours, where $t\\ge 2,$ is\n\n$$\n\\begin{aligned}F(t) & =6+5(t-2) \\\\  & =6+5t-10 \\\\  & =5t-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186512892 :knowledge-point/_questions [{:db/id #edb/ref 17592186068810 :knowledge-point/id #uuid "30abea2b-3b0e-5d3f-88c3-deb7c9ada4c8" :knowledge-point/title "Modeling Using Linear Equations With Two Variable Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26b1ddc1-9435-5f7f-b5dd-42b065875b78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186512183} {:answer/id #uuid "8d542712-a993-5adf-89b6-a680649fc5ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186512430} {:answer/id #uuid "a2ea0f46-6409-5ea6-87af-ac98474c7f6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186512479} {:answer/id #uuid "a388a803-84bd-53e8-aa65-d13f7f96e425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186512482} {:answer/id #uuid "f32cdaeb-1435-578d-beb3-bd4b850bf04a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "104" :db/id #edb/ref 17592186512688}] :answer-field/correct {:answer/id #uuid "a388a803-84bd-53e8-aa65-d13f7f96e425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186512482} :answer-field/id #uuid "fe515d97-b46e-5b25-875a-5d4729fa788a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512861}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "671acf01-53e4-5ebe-ba29-cc75ccac1d67" :question/math-academy-id "q-3414" :question/problem "Caden sold half of his comic books and then bought sixteen more. If he now has $36$, how many comic books did he have at the start?" :question/worked-solution "Let $x=$ the number of comic books Caden had at the start.\n\nWe note that:\n\n- Half the number of comic books corresponds to $\\frac{1}{2}x.$\n\n- The number of comic books remaining after selling half of them corresponds to $x-\\frac{1}{2}x.$\n\n- The number of comic books remaining after selling half and buying sixteen more corresponds to $x-\\frac{1}{2}x+16.$\n\nThe final number of comic books is $36,$ so we have the equation\n\n$$\nx-\\frac{1}{2}x+16=36.\n$$\n\nWe can solve this equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}x-\\frac{1}{2}x+16 & =36 \\\\ (1-\\frac{1}{2})x+16 & =36 \\\\ \\frac{1}{2}x+16 & =36 \\\\ \\frac{1}{2}x+16-16 & =36-16 \\\\ \\frac{1}{2}x & =20 \\\\ 2\\cdot \\frac{1}{2}x & =2\\cdot 20 \\\\ x & =40\\end{aligned}\n$$\n\nThus, Caden had $40$ comic books at the start."}] [{:db/id #edb/ref 17592186233937 :knowledge-point/_questions [{:db/id #edb/ref 17592186119753 :knowledge-point/id #uuid "50de296d-56a1-5166-aa7d-42de027a33bc" :knowledge-point/title "Using Trigonometry to Find an Angle in the Coordinate Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fd2d8ba-3ba8-5ea6-a35d-4969c52ff9ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186512275} {:answer/id #uuid "531e8eab-af68-5079-9c20-857bd006a3f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{6}" :db/id #edb/ref 17592186512285} {:answer/id #uuid "64f794dc-e2dc-5758-ad2d-f07b9dd4ce38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11\\pi }{6}" :db/id #edb/ref 17592186512339} {:answer/id #uuid "cefdb48d-3425-56ca-aa9f-081a9420b77e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186512597} {:answer/id #uuid "fb1ded3b-66b2-5d93-9cde-d2879d7ff545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{4}" :db/id #edb/ref 17592186512704}] :answer-field/correct {:answer/id #uuid "4fd2d8ba-3ba8-5ea6-a35d-4969c52ff9ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186512275} :answer-field/id #uuid "9707ee33-50e5-5d83-8659-e34d49a8a2a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512803}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5a8a7118-dcfe-5423-982d-0747799e649d" :question/math-academy-id "q-34279" :question/problem "![](images/09/09ea9b27d573f7ca318e00a912a18d6c8de8b66ead5c85fb90ebea7f5bd20ca8.png)\n\nGiven that the point $A$ has coordinates $(2\\sqrt{3},-6),$ calculate the angle $\\theta .$" :question/worked-solution "We can form a triangle by creating a vertical line from $A$ to the $x$-axis. Let us call ${\\theta }^{′}$ the angle that is formed with the $x$-axis such that ${\\theta }^{′}+\\theta =2\\pi $\n\n![](images/eb/eb659af0765e200333ca35b716772d92765c7f46ccc4b267243b3c82ba88a1e8.png)\n\nUsing the tangent ratio, we have\n\n$$\n\\operatorname{tan}⁡{\\theta }^{′}=\\frac{6}{2\\sqrt{3}}=\\frac{3}{\\sqrt{3}}=\\sqrt{3}.\n$$\n\nFinally, using the inverse tangent, we get\n\n$$\n{\\theta }^{′}=\\operatorname{arctan}⁡\\sqrt{3}=\\frac{\\pi }{3}.\n$$\n\nFinally, using $\\theta +{\\theta }^{′}=2\\pi ,$ we get $\\theta =2\\pi -\\frac{\\pi }{3}=\\frac{5\\pi }{3}.$"}] [{:db/id #edb/ref 17592186512902 :knowledge-point/_questions [{:db/id #edb/ref 17592186119753 :knowledge-point/id #uuid "50de296d-56a1-5166-aa7d-42de027a33bc" :knowledge-point/title "Using Trigonometry to Find an Angle in the Coordinate Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "048aac5a-0f26-5bb2-8fc3-e1525f3c52a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{220}^{∘}" :db/id #edb/ref 17592186512112} {:answer/id #uuid "07fc1d0e-4b4b-5938-884e-27a158d44eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{200}^{∘}" :db/id #edb/ref 17592186512122} {:answer/id #uuid "1453fd1b-3ee6-55e4-87aa-1fe26fc47d07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{210}^{∘}" :db/id #edb/ref 17592186512142} {:answer/id #uuid "33f89d2b-d7fe-5ded-8d87-7f20aa7f2159" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{190}^{∘}" :db/id #edb/ref 17592186512213} {:answer/id #uuid "659ef10a-f223-514c-a277-cdc5f9c36beb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{230}^{∘}" :db/id #edb/ref 17592186512342}] :answer-field/correct {:answer/id #uuid "1453fd1b-3ee6-55e4-87aa-1fe26fc47d07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{210}^{∘}" :db/id #edb/ref 17592186512142} :answer-field/id #uuid "8eecf4b6-4798-5f08-9a2c-b96119d1c2e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512801}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7e50efe9-568f-54f5-835e-03a6e09d3518" :question/math-academy-id "q-34313" :question/problem "![](images/23/23f0dba237502bc7261fd8f28327beefd5872bb4b0f503930c488b2857fcef24.png)\n\nGiven that the point $A$ has coordinates $(-\\sqrt{3},-1),$ calculate the angle $\\theta .$" :question/worked-solution "We can form a triangle by creating a vertical line from $A$ to the $x$-axis. Let us call ${\\theta }^{′}$ the acute angle that is formed with the $x$-axis such that ${\\theta }^{′}+{180}^{∘}=\\theta $\n\n![](images/d1/d14f62179f831ebdc177eac7bd2899679864305d4104d4b61f304eb4fa9e133d.png)\n\nUsing the tangent ratio, we have\n\n$$\n\\operatorname{tan}⁡{\\theta }^{′}=\\frac{1}{\\sqrt{3}}=\\frac{\\sqrt{3}}{3}.\n$$\n\nFinally, using the inverse tangent, we get\n\n$$\n{\\theta }^{′}=\\operatorname{arctan}⁡\\frac{\\sqrt{3}}{3}={30}^{∘}.\n$$\n\nFinally, using $\\theta ={\\theta }^{′}+{180}^{∘},$ we get $\\theta ={30}^{∘}+{180}^{∘}={210}^{∘}.$"}] [{:db/id #edb/ref 17592186233966 :knowledge-point/_questions [{:db/id #edb/ref 17592186213018 :knowledge-point/id #uuid "fa5d982f-ff13-5a31-9cd3-d5847ea2790c" :knowledge-point/title "Rationalizing Denominators Containing a Binomial Within the Radical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69df2f53-5c50-59ae-8338-33f06671b49c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y-3}-10}{y-7}" :db/id #edb/ref 17592186512353} {:answer/id #uuid "6c32fdae-9578-5230-9c6a-0030dc42ee0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}+10}{y-1}" :db/id #edb/ref 17592186512357} {:answer/id #uuid "97224d93-ee75-5b28-87bf-a215b4d67a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}-10}{y+7}" :db/id #edb/ref 17592186512455} {:answer/id #uuid "c408e350-5f98-5e07-beed-90e315ab7e7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}+2}{y+1}" :db/id #edb/ref 17592186512571} {:answer/id #uuid "eb76173e-aa86-561d-80e6-1b55db1b9cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y-3}+2}{y-1}" :db/id #edb/ref 17592186512665}] :answer-field/correct {:answer/id #uuid "6c32fdae-9578-5230-9c6a-0030dc42ee0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{y+3}+10}{y-1}" :db/id #edb/ref 17592186512357} :answer-field/id #uuid "767f1526-f555-548a-8c1f-53ab5b15fedc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512791}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8bdad77-9abf-5122-8282-321bd75ae69b" :question/math-academy-id "q-34858" :question/problem "Rationalize the denominator of $\\frac{5}{\\sqrt{y+3}-2}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{y+3}+2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{y+3}+2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{5}{\\sqrt{y+3}-2} & = \\\\ \\frac{5}{\\sqrt{y+3}-2}\\cdot \\frac{\\sqrt{y+3}+2}{\\sqrt{y+3}+2} & = \\\\ \\frac{5(\\sqrt{y+3}+2)}{(\\sqrt{y+3}-2)(\\sqrt{y+3}+2)} & = \\\\ \\frac{5\\sqrt{y+3}+10}{(\\sqrt{y+3})^{2}-{2}^{2}} & = \\\\ \\frac{5\\sqrt{y+3}+10}{y+3-4} & = \\\\ \\frac{5\\sqrt{y+3}+10}{y-1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186512867 :knowledge-point/_questions [{:db/id #edb/ref 17592186078403 :knowledge-point/id #uuid "a19695af-0879-5a00-b400-1c4a490f7bfa" :knowledge-point/title "Identifying True Statements About Limits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15d8ad0d-a6a9-5c9d-8b4e-ece065c13c17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186512148} {:answer/id #uuid "389fc1a2-a5ba-57bb-b0b8-1e8ad5cb1eb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186512224} {:answer/id #uuid "3c92e62b-f9d1-5567-ac76-513d8a2c9e83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186512231} {:answer/id #uuid "7a92d27e-54b0-5d4c-9818-cfe70961fad6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186512389} {:answer/id #uuid "e9bb5d36-6be0-565e-a094-366239849940" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186512660}] :answer-field/correct {:answer/id #uuid "7a92d27e-54b0-5d4c-9818-cfe70961fad6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186512389} :answer-field/id #uuid "b5da9fec-9cf5-5ef3-8a64-44b81b106bd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512824}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0821d791-2798-561e-8237-7b4aabdd155c" :question/math-academy-id "q-35003" :question/problem "![](images/06/06e792c5b74eda036b55ac3728122737da22c9824f89f982b50657ab07391269.png)\n\nWhich of the following statements are true concerning the function $y=f(x)$ whose graph is shown above? \n\nI. ${lim}_{x\\to \\,0}f(x)=\\text{DNE}$\n\nII. ${lim}_{x\\to \\,1}f(x)=2$\n\nIII. ${lim}_{x\\to \\,1}f(x)={lim}_{x\\to \\,2}f(x)$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true. As $x$ approaches $0$ from the left and right we get\n\n$$\n{lim}_{x\\to \\,{0}^{-}}f(x)=0,\\,{lim}_{x\\to \\,{0}^{+}}f(x)=1\\,.\n$$\n\n \nTherefore, ${lim}_{x\\to \\,{0}^{-}}f(x)\\ne {lim}_{x\\to \\,{0}^{+}}f(x),$ and hence ${lim}_{x\\to \\,0}f(x)=\\text{DNE}.$\n\n- Statement II is false. As $x$ approaches $1$ from the left and right we get\n\n$$\n{lim}_{x\\to \\,{1}^{-}}f(x)=2,\\,{lim}_{x\\to \\,{1}^{+}}f(x)=\\text{DNE}\\,.\n$$\n\n \nTherefore, ${lim}_{x\\to \\,{1}^{-}}f(x)\\ne {lim}_{x\\to \\,{1}^{+}}f(x),$ and hence ${lim}_{x\\to \\,1}f(x)=\\text{DNE}.$\n\n- Statement III is false. We see from the graph that \n\n$$\n{lim}_{x\\to \\,1}f(x)=\\text{DNE},\\,{lim}_{x\\to \\,2}f(x)=\\text{DNE}\n$$\n\n We can't say that the limits are equal because we can't compare undefined values.\n\nIn conclusion, only statement I is true."}] [{:db/id #edb/ref 17592186234060 :knowledge-point/_questions [{:db/id #edb/ref 17592186133979 :knowledge-point/id #uuid "b01281fd-5272-579c-98d5-ca5cc00c73e4" :knowledge-point/title "Identifying Maps Presented in Function Notation That Are Rigid Motions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11836738-7848-544f-964f-d18900f41ba2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186512136} {:answer/id #uuid "39a67398-ddde-57d6-9d3c-e46cbe169db2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186512225} {:answer/id #uuid "5c9e5c61-489e-5929-8866-74f1bcafce96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186512315} {:answer/id #uuid "a3469b93-f669-5fdc-b195-9fe95068770f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186512481} {:answer/id #uuid "d5efbd0f-bd64-5ab7-99fc-db3c57d526db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186512608}] :answer-field/correct {:answer/id #uuid "11836738-7848-544f-964f-d18900f41ba2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186512136} :answer-field/id #uuid "d57c22b9-eb8a-53fc-aa35-99d38f580f0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512840}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c7b38bd8-148f-55bd-b6dc-69c04541be76" :question/math-academy-id "q-45468" :question/problem "Which of the following transformations map every polygon to a congruent polygon?\n\nI. $(x,y)↦(x-1,y)$\n\nII. $(x,y)↦(-y,x)$\n\nIII. $(x,y)↦(2x,y)$" :question/worked-solution "A rigid motion is a transformation that preserves distances. There are three types of rigid motions:\n\n- Translations\n\n- Rotations\n\n- Reflections\n\nAlso, two polygons are congruent if and only if one can be mapped to another using a combination of rigid motions.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I is a translation of $1$ unit to the right. This is a rigid motion. So, it maps every polygon to a congruent polygon.\n\n- Transformation II is a rotation of ${90}^{∘}$ counterclockwise about the origin. This is a rigid motion. So, it maps every polygon to a congruent polygon.\n\n- Transformation III is a stretch with a stretch factor of $2$ in the $x$-direction. This is *not* a rigid motion. So, it does not map every polygon to a congruent polygon.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186234061 :knowledge-point/_questions [{:db/id #edb/ref 17592186172137 :knowledge-point/id #uuid "a23a10c1-a091-55bb-98a6-7718e46d841b" :knowledge-point/title "Writing the Equation of a Parabola With Leading Coefficients in Vertex Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc2ec08-ccd3-52d6-ba27-4d0c5b4a6f70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186512203} {:answer/id #uuid "3be7a489-8098-540d-bf9d-af04ee7bcc91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186512229} {:answer/id #uuid "481a228a-6054-5d3b-9727-76814a95d100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186512252} {:answer/id #uuid "5882ed18-1e8f-5fb9-ae77-3f8984bbac2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186512304} {:answer/id #uuid "d79197b3-4c94-57d3-bae0-0b19e5e807a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186512612}] :answer-field/correct {:answer/id #uuid "3be7a489-8098-540d-bf9d-af04ee7bcc91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186512229} :answer-field/id #uuid "e0744bce-0ef4-5d83-bb98-f340a557f518" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512849}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7b10f970-f0c0-5c1c-948f-9f92d7941265" :question/math-academy-id "q-46167" :question/problem "The curve $y=4{x}^{2}-24x+24$ can be written as $y=a(x+b)^{2}+c.$ Calculate $a+b+c.$" :question/worked-solution "To express the equation of the parabola in vertex form, we need to complete the square. \n\nFirst, we take out a factor of $4$ from the entire expression:\n\n$$\n\\begin{aligned}4{x}^{2}-24x+24 & =4({x}^{2}-6x+6)\\end{aligned}\n$$\n\nNow, we complete the square for the expression inside the parentheses:\n\n$$\n\\begin{aligned}{x}^{2}-6x+6 & = \\\\ {x}^{2}-2\\cdot 3\\cdot x+6 & = \\\\ {x}^{2}-2\\cdot 3\\cdot x+{3}^{2}-{3}^{2}+6 & = \\\\ ({x}^{2}-2\\cdot 3\\cdot x+{3}^{2})-{3}^{2}+6 & = \\\\ (x-3)^{2}-{3}^{2}+6 & = \\\\ (x-3)^{2}-9+6 & = \\\\ (x-3)^{2}-3\\end{aligned}\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}4({x}^{2}-6x+6) & = \\\\ 4((x-3)^{2}-3) & = \\\\ 4(x-3)^{2}-12\\end{aligned}\n$$\n\nSo,  $a+b+c=4+(-3)+(-12)=-11.$"}] [{:db/id #edb/ref 17592186234078 :knowledge-point/_questions [{:db/id #edb/ref 17592186092329 :knowledge-point/id #uuid "2a0cc5ea-7f70-5c5f-841e-01a6813da8c6" :knowledge-point/title "Identifying True Statements About Operations on Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d1705b0-834b-5792-8c06-6d5fc22048b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448684} {:answer/id #uuid "b112adca-cb36-57f3-bd90-2e7a480434e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448685}] :answer-field/correct {:answer/id #uuid "7d1705b0-834b-5792-8c06-6d5fc22048b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448684} :answer-field/id #uuid "92ff8be7-384f-50f9-a9cc-07cf8d5eaf16" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449382} {:answer-field/choices [{:answer/id #uuid "af4bc898-dce0-5f3d-9d2f-6a7b8e8ffcf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448686} {:answer/id #uuid "b1aa0055-1d04-5645-beb9-c3d9eaaccc11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448687}] :answer-field/correct {:answer/id #uuid "af4bc898-dce0-5f3d-9d2f-6a7b8e8ffcf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448686} :answer-field/id #uuid "1841f66d-8716-5ae9-9721-03af6375e921" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449383} {:answer-field/choices [{:answer/id #uuid "edf57af7-4b49-59d6-a5a9-3387654cc8df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448688} {:answer/id #uuid "2dcfac6c-2e42-52a0-9938-f9d8d1b51b3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448689}] :answer-field/correct {:answer/id #uuid "2dcfac6c-2e42-52a0-9938-f9d8d1b51b3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448689} :answer-field/id #uuid "d516701d-8778-510c-80b6-62bc3f31f92b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449384}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c6cc47f7-3bf2-54bf-a0ea-9009aac01bb7" :question/math-academy-id "q-47447" :question/problem "If $P(x)$ and $Q(x)$ are polynomials of degree $3$ and $7,$ respectively, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $P+Q$ is always a polynomial of degree $10$\n- **II.** $P-Q$ is always a polynomial of degree $4$\n- **III.** $P\\cdot Q$ is always a polynomial of degree $10$" :question/worked-solution "Let's look at each statement in turn.\n\n- Statement I is false. For example, suppose $P(x)={x}^{3}$ and $Q(x)={x}^{7}.$ Then $P+Q={x}^{3}+{x}^{7},$ which is not a polynomial of degree $10.$\n\n- Statement II is false. For example, suppose $P(x)={x}^{3}$ and $Q(x)={x}^{7}.$ Then $P-Q={x}^{3}-{x}^{7},$ which is not a polynomial of degree $4.$\n\n- Statement III is true. The highest-degree terms in $P$ and $Q$ must contain ${x}^{3}$ and ${x}^{7},$ respectively. Therefore, the highest-degree term in $P\\cdot Q$ must contain ${x}^{3}\\cdot {x}^{7}={x}^{3+7}={x}^{10},$ meaning that $P\\cdot Q$ has degree $10.$\n\nIn conclusion, only statement III is true."}] [{:db/id #edb/ref 17592186234083 :knowledge-point/_questions [{:db/id #edb/ref 17592186054812 :knowledge-point/id #uuid "d8d06cd8-9aae-50ab-90dc-6c70b545d569" :knowledge-point/title "Computing the Derivative of a Fractional Power Function Using the Power Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "004fb43a-8a3c-5d57-8932-47e0fe4aee15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5\\sqrt[7]{{x}^{2}}}" :db/id #edb/ref 17592186512097} {:answer/id #uuid "4d853c4b-ff54-546b-bb02-2311564ce7a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\sqrt[5]{{x}^{7}}" :db/id #edb/ref 17592186512266} {:answer/id #uuid "c403ef6b-b382-5306-92d4-4c26b3f05c2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}\\sqrt[7]{{x}^{5}}" :db/id #edb/ref 17592186512570} {:answer/id #uuid "dbafea93-c3c1-5c81-95ea-a42523faec59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5\\sqrt[5]{{x}^{7}}}" :db/id #edb/ref 17592186512625} {:answer/id #uuid "e6d3b420-0896-5d50-a950-480cffd7a14e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5\\sqrt[5]{{x}^{2}}}" :db/id #edb/ref 17592186512653}] :answer-field/correct {:answer/id #uuid "dbafea93-c3c1-5c81-95ea-a42523faec59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5\\sqrt[5]{{x}^{7}}}" :db/id #edb/ref 17592186512625} :answer-field/id #uuid "2311da2e-4f69-5b66-a303-9fcae05b36b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512742}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "daf077a1-46a3-5bb7-a73f-ea41666a8c97" :question/math-academy-id "q-47831" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ when $y=\\frac{1}{\\sqrt[5]{{x}^{2}}}.$" :question/worked-solution "Writing the radical as a rational exponent, we have\n\n$$\ny=\\frac{1}{\\sqrt[5]{{x}^{2}}}=\\frac{1}{{x}^{2/5}}={x}^{-2/5}\n$$\n\nApplying the power rule with $n=-\\frac{2}{5},$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{-2/5}) \\\\  & =-\\frac{2}{5}{x}^{-2/5-1} \\\\  & =-\\frac{2}{5}{x}^{-7/5} \\\\  & =-\\frac{2}{5{x}^{7/5}} \\\\  & =-\\frac{2}{5\\sqrt[5]{{x}^{7}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234105 :knowledge-point/_questions [{:db/id #edb/ref 17592186064272 :knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782" :knowledge-point/title "Relating a Derivative to a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef1b856-e606-5faf-bc81-d441b2fbfdf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)=E(t)-L(t)" :db/id #edb/ref 17592186512128} {:answer/id #uuid "59459bbc-bff1-5a8f-9a50-e6ffa451c3d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=E(t)\\cdot L(t)" :db/id #edb/ref 17592186512306} {:answer/id #uuid "a912d151-5821-56b2-bfc3-6a30d519da07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)=E(t)+L(t)" :db/id #edb/ref 17592186512502} {:answer/id #uuid "cafddae2-e99e-570b-af04-9b580b7a3489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=E(t)+L(t)" :db/id #edb/ref 17592186512589} {:answer/id #uuid "f1d31616-58ba-5787-a9be-a1cfe9d0322c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=E(t)-L(t)" :db/id #edb/ref 17592186512684}] :answer-field/correct {:answer/id #uuid "f1d31616-58ba-5787-a9be-a1cfe9d0322c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=E(t)-L(t)" :db/id #edb/ref 17592186512684} :answer-field/id #uuid "1ee88502-7069-5e01-a8d0-c684a215ef26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512740}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c00a28ec-ae50-52ff-8f5b-35e535d7e4c4" :question/math-academy-id "q-48923" :question/problem "To measure the success of an amusement park, Ed uses the following three functions that model the daily number of visitors to the park $t$ minutes after the park is opened to the public.\n\n- $N(t)$ - the number of people inside the park\n\n- $E(t)$ - the rate at which people enter the park\n\n- $L(t)$ - the rate at which people leave the park\n\nWhat is the relationship between the functions above?" :question/worked-solution "The function $N(t)$ gives the number of people inside the park $t$ minutes after opening. Then,\n\n$$\n{N}^{′}(t)=\\frac{\\text{d}N(t)}{\\text{d}t}=\\frac{\\text{Change in }N}{\\text{Change in }t}.\n$$\n\nThus, ${N}^{′}(t)$ gives the rate at which the number of people inside the park changes $t$ minutes after opening.\n\nIn addition, we can compute the rate of change of the number of people inside the park at time $t$ by finding the difference between the entry and exit rates at time $t.$ That is,\n\n$$\n{N}^{′}(t)=E(t)-L(t).\n$$"}] [{:db/id #edb/ref 17592186234137 :knowledge-point/_questions [{:db/id #edb/ref 17592186054670 :knowledge-point/id #uuid "5d4a21cd-bd8d-5572-b932-76875827170a" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Sequence Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e2e40d7-3854-5e96-a861-a1a07ecb3a0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186512161} {:answer/id #uuid "8951bc5c-f431-5ff4-a335-7c7928becd8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186512420} {:answer/id #uuid "b68ba403-6a1c-5a91-9565-64d68e9cdbb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186512533} {:answer/id #uuid "bf07614f-d15a-5062-80cc-4b44fbdc05d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186512558} {:answer/id #uuid "e8ad6404-266a-54af-a78f-543ff14358ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186512655}] :answer-field/correct {:answer/id #uuid "bf07614f-d15a-5062-80cc-4b44fbdc05d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186512558} :answer-field/id #uuid "c54970a5-ea06-5ef6-84b8-80c8776bc786" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512831}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19fe87cd-0d79-5f77-b53f-849ad0d5ffc8" :question/math-academy-id "q-52557" :question/problem "If ${a}_{n+2}={a}_{n+1}+{a}_{n}$ with ${a}_{1}=1$ and ${a}_{2}=6,$ then ${a}_{4}=$" :question/worked-solution "The recursive formula is\n\n$$\n{a}_{n+2}={a}_{n+1}+{a}_{n}.\n$$\n\nSubstituting $n=1$ into the recursive formula gives:\n\n$$\n\\begin{aligned}{a}_{1+2} & ={a}_{1+1}+{a}_{1} \\\\ {a}_{3} & ={a}_{2}+{a}_{1} \\\\ {a}_{3} & =6+1 \\\\ {a}_{3} & =7\\end{aligned}\n$$\n\nSubstituting $n=2$ into the recursive formula gives:\n\n$$\n\\begin{aligned}{a}_{2+2} & ={a}_{2+1}+{a}_{2} \\\\ {a}_{4} & ={a}_{3}+{a}_{2} \\\\ {a}_{4} & =7+6 \\\\ {a}_{4} & =13\\end{aligned}\n$$\n\nHence, ${a}_{4}=13.$"}] [{:db/id #edb/ref 17592186234141 :knowledge-point/_questions [{:db/id #edb/ref 17592186073917 :knowledge-point/id #uuid "a8b5ef8e-6f13-5496-ae7f-c9fbaf3e25c7" :knowledge-point/title "Identifying Similarity Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09685bcf-87c8-5820-be62-2079ad8b2fa9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186512123} {:answer/id #uuid "2aa03d95-5c1e-5462-baea-44a0db21983a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186512198} {:answer/id #uuid "487920ed-c0d8-5fef-8da2-dbe125c0490e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186512254} {:answer/id #uuid "a1f3412f-dd4f-5295-8d3f-906cebe4d2ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186512475} {:answer/id #uuid "b8e819db-c3b6-5287-aeeb-bc588fb737a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186512540}] :answer-field/correct {:answer/id #uuid "2aa03d95-5c1e-5462-baea-44a0db21983a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186512198} :answer-field/id #uuid "49c9f005-3956-54dc-a98f-72829d84a02e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512764}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "384ee4e4-0b37-56f7-a3a5-86d23f2e43a9" :question/math-academy-id "q-53708" :question/problem "Which of the following transformations map any polygon to a similar polygon?\n\nI. Stretching with a stretch factor of $2$ in the $x$-direction and a stretch factor of $4$ in the $y$-direction\n\nII. Translation by $3$ units to the left and $4$ units upward\n\nIII. Dilation of scale factor $2$ with center $O,$ then reflection across the $y$-axis" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations.\n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I includes stretching with different factors in the $x$- and $y$-direction. Thus, it is not a similarity transformation.\n\n- Transformation II is a combination of two translations, which are rigid motions. Thus, it is a similarity transformation.\n\n- Transformation III is a combination of dilation of scale factor $2$ and a reflection. Thus, it is a similarity transformation.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186234163 :knowledge-point/_questions [{:db/id #edb/ref 17592186147463 :knowledge-point/id #uuid "4df9158c-01a9-5596-9528-6033296b2925" :knowledge-point/title "Finding the Common Ratio Given Some Additional Information About the Geometric Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "106793da-24f7-59ed-8b62-e13cfc57d52f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186512133} {:answer/id #uuid "571aa39e-400a-5863-b676-0015f3b249cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186512297} {:answer/id #uuid "6e1bcd9e-18d9-5b81-bf60-b688fcd821e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186512361} {:answer/id #uuid "6fa661ae-e5a1-55f6-8a14-031daabbb4f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186512364} {:answer/id #uuid "a7e88750-2d2a-5ed0-bb69-82c918766691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186512498}] :answer-field/correct {:answer/id #uuid "a7e88750-2d2a-5ed0-bb69-82c918766691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186512498} :answer-field/id #uuid "981ea52b-9e45-5858-a199-002953f70e37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512804}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "727e7006-93ff-5e5c-a29e-52adc22e5960" :question/math-academy-id "q-64010" :question/problem "The third term of a geometric sequence is $108$ and its fifth term is $3.$  Find the common ratio $r$ of this sequence given that $r$ is positive." :question/worked-solution "To find the common ratio $r$ of a geometric sequence given two terms ${a}_{m}$ and ${a}_{n},$ we use the formula\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}.\n$$\n\nIn this case, we're given ${a}_{5}=3$ and ${a}_{3}=108.$ Substituting $n=5$ and $m=3$ into the formula, we have\n\n$$\n\\begin{aligned}{r}^{5-3} & =\\frac{{a}_{5}}{{a}_{3}} \\\\ {r}^{2} & =\\frac{3}{108} \\\\ {r}^{2} & =\\frac{1}{36}.\\end{aligned}\n$$\n\nFinally, solving the equation for $r$ and considering that $r$ is positive, we get\n\n$$\n\\begin{aligned}{r}^{2} & =\\frac{1}{36} \\\\ {r}^{2} & ={(\\frac{1}{6})}^{2} \\\\ r & =\\frac{1}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234168 :knowledge-point/_questions [{:db/id #edb/ref 17592186192752 :knowledge-point/id #uuid "a1519905-a736-54a1-8778-cc03d019a084" :knowledge-point/title "Expressing a Reciprocal Trigonometric Ratio in Terms of a Reference Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04b1019a-d92e-5d04-be9a-1a4844c6f0a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡(\\frac{7\\pi }{10})" :db/id #edb/ref 17592186512114} {:answer/id #uuid "706750fb-a8db-5883-9866-c48f23ec7c80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cot}⁡(\\frac{7\\pi }{10})" :db/id #edb/ref 17592186512367} {:answer/id #uuid "767844f9-50f9-5d37-92c5-befa41f424fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡(\\frac{3\\pi }{10})" :db/id #edb/ref 17592186512379} {:answer/id #uuid "82a50b38-647a-51f0-83dd-2e735fd413fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{3\\pi }{10})" :db/id #edb/ref 17592186512404} {:answer/id #uuid "ecf7300d-5c9b-5c16-914a-b75e51c21227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cot}⁡(\\frac{3\\pi }{10})" :db/id #edb/ref 17592186512673}] :answer-field/correct {:answer/id #uuid "ecf7300d-5c9b-5c16-914a-b75e51c21227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cot}⁡(\\frac{3\\pi }{10})" :db/id #edb/ref 17592186512673} :answer-field/id #uuid "427c3f91-22fc-5c34-bf37-633a78d7c0ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512760}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c210cee-fd55-5399-a645-1646a3c5f4b6" :question/math-academy-id "q-64741" :question/problem "Express $\\operatorname{cot}⁡(\\frac{7\\pi }{10})$ in terms of a reference angle." :question/worked-solution "To help us to visualize the angle, we first convert the measure of the angle into degrees. \n\nTo convert the measure of an angle in radians to an equivalent measure in degrees, we multiply the measure in radians by $\\frac{{180}^{∘}}{\\pi }.$ This gives\n\n$$\n(\\frac{7\\pi }{10})\\cdot (\\frac{{180}^{∘}}{\\pi })={126}^{∘}.\n$$\n\nTherefore $\\frac{7\\pi }{10}$ is equivalent to ${126}^{∘},$ which lies in the $2\\text{nd}$ quadrant.\n\n![](images/89/89b5e2656378adb5d91c9f58c261e4beaae252b67819b904bf209f6ed8a5a25e.png)\n\nTo express $\\operatorname{cot}⁡(\\frac{7\\pi }{10})$ in terms of $\\operatorname{cot}⁡{\\theta }_{R},$ we follow three steps:\n\n1\\. Find its reference angle ${\\theta }_{R}.$\n\n2\\. Calculate the value of the function for ${\\theta }_{R}.$\n\n3\\. Determine whether the resulting value is positive or negative.\n\n**Step 1**: Since $\\theta =\\frac{7\\pi }{10}$ is in the $2$nd quadrant, the reference angle ${\\theta }_{R}$ is\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\pi -\\theta  \\\\  & =\\pi -\\frac{7\\pi }{10} \\\\  & =\\frac{3\\pi }{10}.\\end{aligned}\n$$\n\n**Step 2**: The given ratio is $\\operatorname{cot}⁡(\\frac{7\\pi }{10})$, and therefore we're interested in $\\operatorname{cot}⁡{\\theta }_{R}=\\operatorname{cot}⁡(\\frac{3\\pi }{10}).$\n\n**Step 3:** The ratio $\\operatorname{cot}⁡(\\frac{7\\pi }{10})$ must be negative because tangent (and therefore cotangent) is always negative in the $2$nd quadrant. Therefore,\n\n$$\n\\operatorname{cot}⁡(\\frac{7\\pi }{10})=-\\operatorname{cot}⁡(\\frac{3\\pi }{10}).\n$$"}] [{:db/id #edb/ref 17592186234200 :knowledge-point/_questions [{:db/id #edb/ref 17592186083359 :knowledge-point/id #uuid "06e51d62-ad2a-51c3-b276-eeb60022ab48" :knowledge-point/title "Computing an Inverse Function Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48184947-7782-5f06-87ef-88301b445aa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186512251} {:answer/id #uuid "4ea8fc33-f0d3-5d44-843e-d1dc99182838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186512273} {:answer/id #uuid "b4c00340-454e-506c-bf24-063b51dc5bdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186512526} {:answer/id #uuid "daf2acf4-7be1-5ff4-8dae-a4d6fffc11f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186512622} {:answer/id #uuid "db256129-77ad-51ea-86d8-8bfe24ceef09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186512623}] :answer-field/correct {:answer/id #uuid "daf2acf4-7be1-5ff4-8dae-a4d6fffc11f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186512622} :answer-field/id #uuid "ce61e97b-bb14-57d6-aa01-271d52a76ac5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512836}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1766a0cc-97ef-5939-9ca2-60e65363339c" :question/math-academy-id "q-66456" :question/problem "Suppose that $f(x)=2x+6$ and $g(x)=\\frac{x}{2}+k.$ If $g$ is the inverse of $f,$ then $k=$" :question/worked-solution "If $g$ is the inverse of $f,$ then we must have:\n\n$$\ng(f(x))=x\n$$\n\nTo find $g(f(x)),$ we write down the function $g$ and replace every occurrence of $x$ with $f(x):$\n\n$$\n\\begin{aligned}g(x) & =\\frac{x}{2}+k \\\\ g(f(x)) & =\\frac{f(x)}{2}+k\\end{aligned}\n$$\n\nThen, we substitute $f(x)=2x+6$ into the right-hand side of our expression and simplify, as follows:\n\n$$\n\\begin{aligned}g(f(x)) & =\\frac{f(x)}{2}+k \\\\  & =\\frac{2x+6}{2}+k \\\\  & =x+3+k\\end{aligned}\n$$\n\nHowever, we also know that $g(f(x))=x.$ Equating the expression above with $x$ and solving for $k$ gives:\n\n$$\n\\begin{aligned}x+3+k & =x \\\\ \\cancel{x}+3+k & =\\cancel{x} \\\\ 3+k & =0 \\\\ k & =-3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186512917 :knowledge-point/_questions [{:db/id #edb/ref 17592186087692 :knowledge-point/id #uuid "169ca81a-c698-553c-9f47-d6c4303b82a9" :knowledge-point/title "Evaluating Natural Logarithms of Fractions and Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6042c78b-71af-5276-80cf-ccdcb9284bf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186512329} {:answer/id #uuid "6614a67a-a7fe-55e2-be74-7e1ab3c9e3c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186512343} {:answer/id #uuid "b10534f0-4c95-531e-94d6-ba5e4a60964c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186512516} {:answer/id #uuid "c6fff638-a832-599c-b20d-b7725b1e8582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186512578} {:answer/id #uuid "f7b61c9c-6858-5b2e-a66c-1ae788e691c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186512699}] :answer-field/correct {:answer/id #uuid "6614a67a-a7fe-55e2-be74-7e1ab3c9e3c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186512343} :answer-field/id #uuid "6fd07e78-dd69-5881-8015-dd32bee64dd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512789}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a5359436-369e-5935-88c6-73a8053a9364" :question/math-academy-id "q-66526" :question/problem "$\\operatorname{ln}⁡(\\frac{1}{\\sqrt{e}})=$" :question/worked-solution "First, we rewrite $\\frac{1}{\\sqrt{e}}$ as a power of $e$ (the base of the natural logarithm) as follows:\n\n$$\n\\frac{1}{\\sqrt{e}}=\\frac{1}{{e}^{1/2}}={e}^{-1/2}\n$$\n\nTherefore, we have:\n\n$$\n\\operatorname{ln}⁡(\\frac{1}{\\sqrt{e}})=\\operatorname{ln}⁡({e}^{-1/2})\n$$\n\nThe natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn our case, we have $x=-\\frac{1}{2}.$ Therefore:\n\n$$\n\\operatorname{ln}⁡({e}^{-1/2})=-\\frac{1}{2}\n$$"}] [{:db/id #edb/ref 17592186234209 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85558fe1-9c94-53cd-9b06-9d10fd915bfd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439873} {:answer/id #uuid "41bb42a2-237c-50d2-bde6-1e67a38a37e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439874}] :answer-field/correct {:answer/id #uuid "41bb42a2-237c-50d2-bde6-1e67a38a37e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439874} :answer-field/id #uuid "c62a73cf-8c33-535d-9dea-0086d3e41c0e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440294} {:answer-field/choices [{:answer/id #uuid "dffdc7f5-2b92-5cae-91de-71f301a1f0da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439875} {:answer/id #uuid "528273a2-3a9d-5b9a-9b7a-08f3145a6a84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439876}] :answer-field/correct {:answer/id #uuid "dffdc7f5-2b92-5cae-91de-71f301a1f0da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439875} :answer-field/id #uuid "18169496-ec76-51fc-b481-2edec3fc6630" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440295} {:answer-field/choices [{:answer/id #uuid "0ce25a91-38a4-5e06-8dbc-24d243e66ca3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439877} {:answer/id #uuid "1ae5b007-91e6-5976-a3c2-72321bebd9a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439878}] :answer-field/correct {:answer/id #uuid "0ce25a91-38a4-5e06-8dbc-24d243e66ca3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439877} :answer-field/id #uuid "d5c6a5b6-c726-593a-9362-e5d7e8c23832" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440296}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "912ff428-058e-5197-af7a-fcbe7f3d6387" :question/math-academy-id "q-66785" :question/problem "Given that $f(x)=|x-4|+2,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-\\infty ,3)$\n- **II.** $x\\in (1,\\infty )$\n- **III.** $x\\in (-\\infty ,5]$" :question/worked-solution "The graph of the function $f(x)=|x-4|+2$ can be obtained in the following way:\n\n- Take the curve $y=|x|.$\n\n- Translate it by $4$ units to the right,  to get $y=|x-4|.$\n\n- Finally, translate $y=|x-4|$ by $2$ units up to get $f(x)=|x-4|+2.$\n\n![](images/56/56956d0f23ae6828098507712fd00525dc4f114a195716dc16e63d8475e9c143.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test. \n\n- The function $f(x)$ is invertible on the interval $x\\in (-\\infty ,3).$  Indeed, on this interval, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n- The function $f(x)$ is not invertible on any of the intervals $x\\in (1,\\infty )$  and $(-\\infty ,5].$ On each of these intervals, some horizontal lines will intersect the curve more than once.\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186512891 :knowledge-point/_questions [{:db/id #edb/ref 17592186087692 :knowledge-point/id #uuid "169ca81a-c698-553c-9f47-d6c4303b82a9" :knowledge-point/title "Evaluating Natural Logarithms of Fractions and Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dc31748-131c-5761-b87b-12c70e2700fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186512268} {:answer/id #uuid "8511cc21-378c-5a60-9221-6fb771890a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186512407} {:answer/id #uuid "b219a9cf-83fc-5cad-a42c-df24894c4cbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186512518} {:answer/id #uuid "f6bf7bc9-83ae-5185-89c3-ff3999355ed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186512698} {:answer/id #uuid "ffe0d590-58c4-5faf-8679-f3cf76a7cea1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186512719}] :answer-field/correct {:answer/id #uuid "8511cc21-378c-5a60-9221-6fb771890a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186512407} :answer-field/id #uuid "f1f049c7-00fd-5d21-8330-9fbecd737783" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512856}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5f3a9a12-37bd-5534-bce9-24153ef1f5e3" :question/math-academy-id "q-66857" :question/problem "$\\frac{1}{2}\\operatorname{ln}⁡(\\sqrt[4]{e})=$" :question/worked-solution "First, we rewrite $\\sqrt[4]{e}$ as a power of $e$ (the base of the natural logarithm) as follows:\n\n$$\n\\sqrt[4]{e}={e}^{1/4}\n$$\n\nTherefore, we have:\n\n$$\n\\frac{1}{2}\\operatorname{ln}⁡(\\sqrt[4]{e})=\\frac{1}{2}\\operatorname{ln}⁡({e}^{1/4})\n$$\n\nThe natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn our case, we have $x=\\frac{1}{4}.$ Therefore:\n\n$$\n\\frac{1}{2}\\operatorname{ln}⁡({e}^{1/4})=\\frac{1}{2}\\cdot \\frac{1}{4}=\\frac{1}{8}\n$$"}] [{:db/id #edb/ref 17592186234216 :knowledge-point/_questions [{:db/id #edb/ref 17592186083185 :knowledge-point/id #uuid "4fa847d9-f0bf-57fb-92b2-27c8a7cdb3b1" :knowledge-point/title "Classifying Even and Odd Functions Using the Algebraic Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56223238-871c-5059-a611-b22adabd18b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Neither even nor odd" :db/id #edb/ref 17592186512294} {:answer/id #uuid "73f077c3-f7dc-5e4b-b69b-312d30bce105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "It's not a function" :db/id #edb/ref 17592186512373} {:answer/id #uuid "888c316d-cb0b-54ba-954c-a843ead762fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Odd" :db/id #edb/ref 17592186512417} {:answer/id #uuid "d459b53f-1cde-5cb4-a70d-3e698301abf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Even" :db/id #edb/ref 17592186512604} {:answer/id #uuid "d7d0aa2d-484b-5d54-b229-1c89a2a9149c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Both even and odd" :db/id #edb/ref 17592186512614}] :answer-field/correct {:answer/id #uuid "888c316d-cb0b-54ba-954c-a843ead762fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Odd" :db/id #edb/ref 17592186512417} :answer-field/id #uuid "b597c4e2-567a-5468-a2f0-d74fa667be66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512823}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48b449a7-d277-5309-976b-1d1765d56b87" :question/math-academy-id "q-6690" :question/problem "Is the function $f(x)=2{x}^{3}-2x$ even, odd, or neither?" :question/worked-solution "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =2(-x)^{3}-2(-x) \\\\  & =-2{x}^{3}+2x.\\end{aligned}\n$$\n\nSince $f(-x)\\ne f(x),$ the function is not even.\n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-(2{x}^{3}-2x) \\\\  & =-2{x}^{3}+2x.\\end{aligned}\n$$\n\nSince $f(-x)=-f(x),$ the function is odd."}] [{:db/id #edb/ref 17592186234235 :knowledge-point/_questions [{:db/id #edb/ref 17592186078471 :knowledge-point/id #uuid "d979a7bd-42a1-5d4f-8717-1caa06ce623c" :knowledge-point/title "Determining the Index of a Term Given Two Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fe24ca2-15a6-51f1-a1df-7cc11fbacd48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186410224} {:answer/id #uuid "2cd556ca-30b4-5288-8d72-abfec4b7f03d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186410236} {:answer/id #uuid "4ef2bdba-9ddd-528c-9cea-425b4e82d718" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186410256} {:answer/id #uuid "a1d45a8f-d17e-5c84-8b87-5a64a5a6e762" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186410313} {:answer/id #uuid "debab0a7-4e2a-5e76-9d88-682a5f66970d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186410353}] :answer-field/correct {:answer/id #uuid "1fe24ca2-15a6-51f1-a1df-7cc11fbacd48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186410224} :answer-field/id #uuid "9596f751-f676-5a62-bf63-b8794255c731" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410393}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "51d856f6-bec1-5419-b978-851c105050a5" :question/math-academy-id "q-67348" :question/problem "Given an arithmetic sequence that has ${a}_{4}=13$ and ${a}_{8}=41,$ what is the index of the term $90?$" :question/worked-solution "To construct the formula for the sequence, we need to know the common difference $d$ and the first term ${a}_{1}.$\n\nSince we are given ${a}_{4}=13$ and ${a}_{8}=41,$ we can find the common difference by dividing the total difference by the number of jumps:\n\n$$\n\\begin{aligned}d & =\\frac{{a}_{8}-{a}_{4}}{8-4} \\\\  & =\\frac{41-13}{8-4} \\\\  & =\\frac{28}{4} \\\\  & =7\\end{aligned}\n$$\n\nNow, since ${a}_{4}=13$ is $3$ jumps after ${a}_{1},$ we can determine the first term of the sequence:\n\n$$\n\\begin{aligned}{a}_{4} & ={a}_{1}+3d \\\\ 13 & ={a}_{1}+3(7) \\\\ 13 & ={a}_{1}+21 \\\\ -8 & ={a}_{1}\\end{aligned}\n$$\n\nSo, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-8+(n-1)(7) \\\\  & =-8+7n-7 \\\\  & =7n-15\\end{aligned}\n$$\n\nNow, we solve for the value of $n$ that gives ${a}_{n}=90,$ as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =7n-15 \\\\ 90 & =7n-15 \\\\ 105 & =7n \\\\ \\frac{105}{7} & =n \\\\ 15 & =n\\end{aligned}\n$$\n\nTherefore, $90$ is the $15$th term of the sequence."}] [{:db/id #edb/ref 17592186234270 :knowledge-point/_questions [{:db/id #edb/ref 17592186179649 :knowledge-point/id #uuid "3db20b82-9561-5c54-8e12-8914bb6747c3" :knowledge-point/title "Adding and Subtracting Rational Expressions With No Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16c23837-9722-5faa-902a-3e9a610ae018" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4t}{3t(t+2)}" :db/id #edb/ref 17592186512151} {:answer/id #uuid "389e3585-eb6e-5e0b-b7ad-c87d63aa1f56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{t(t+2)}" :db/id #edb/ref 17592186512223} {:answer/id #uuid "aaef2d17-80ab-59de-9959-f78c7423de66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t+3}{3t(t+2)}" :db/id #edb/ref 17592186512503} {:answer/id #uuid "e9e2076f-e637-5540-becf-7c08397db46e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6t+5}{t(t+2)}" :db/id #edb/ref 17592186512662} {:answer/id #uuid "fd95737c-f9df-54a0-8ab8-9ef3e07fdf1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2t+1}{3t(t+2)}" :db/id #edb/ref 17592186512715}] :answer-field/correct {:answer/id #uuid "fd95737c-f9df-54a0-8ab8-9ef3e07fdf1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2t+1}{3t(t+2)}" :db/id #edb/ref 17592186512715} :answer-field/id #uuid "c848d579-8366-518a-a3ba-b24a64e2c36d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512832}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee038b53-750c-5b8c-99dc-a961b717435d" :question/math-academy-id "q-70358" :question/problem "$\\frac{t+1}{t(t+2)}-\\frac{1}{3t}=$" :question/worked-solution "In this case, we need to put the fractions over a common denominator of $3t(t+2),$ since there are no common factors in either denominator that we can exploit.\n\nTo do this, we multiply the top and bottom of the first fraction by $3$, and the top and bottom of the second fraction by $(t+2):$\n\n$$\n\\begin{aligned}\\frac{t+1}{t(t+2)}-\\frac{1}{3t} & = \\\\ \\frac{3}{3}\\cdot \\frac{t+1}{t(t+2)}-\\frac{t+2}{t+2}\\cdot \\frac{1}{3t} & = \\\\ \\frac{3(t+1)}{3t(t+2)}-\\frac{t+2}{3t(t+2)} & = \\\\ \\frac{3(t+1)-(t+2)}{3t(t+2)} & = \\\\ \\frac{3t+3-t-2}{3t(t+2)} & = \\\\ \\frac{2t+1}{3t(t+2)} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234280 :knowledge-point/_questions [{:db/id #edb/ref 17592186092383 :knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ed8aa18-f23e-5179-83b5-62f4300a01d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-\\frac{5}{4})" :db/id #edb/ref 17592186512274} {:answer/id #uuid "50ff8cf1-00c5-5be3-8b99-91abe28049cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,0)" :db/id #edb/ref 17592186512278} {:answer/id #uuid "63c9374b-d37c-56a0-a295-21e6bccf14d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{4},0)" :db/id #edb/ref 17592186512335} {:answer/id #uuid "76efb7a8-362e-53ed-a7a6-f85bdf02a95f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,0)" :db/id #edb/ref 17592186512380} {:answer/id #uuid "b96971bd-8297-5518-aab6-d9a19486e8f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{5}{4},0)" :db/id #edb/ref 17592186512544}] :answer-field/correct {:answer/id #uuid "63c9374b-d37c-56a0-a295-21e6bccf14d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{4},0)" :db/id #edb/ref 17592186512335} :answer-field/id #uuid "2f3486a1-cfa1-570d-be9b-887c8a18ac0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512750}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43b75bde-30a1-5aa7-ad2b-9b63b76aaef0" :question/math-academy-id "q-70517" :question/problem "Find where the tangent to the curve $y=6\\sqrt{x}+5x-13$ at the point $(1,-2)$ intersects the $x$-axis." :question/worked-solution "Let $f(x)=6\\sqrt{x}+5x-13.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6\\sqrt{x}+5x-13) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{1/2}+5x) \\\\  & =3{x}^{-1/2}+5\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{′}(1)=3(1)^{-1/2}+5=8.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-2) & =8(x-1) \\\\ y & =8x-8-2 \\\\ y & =8x-10.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}0 & =8x-10 \\\\ x & =\\frac{5}{4}\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(\\frac{5}{4},0).$"}] [{:db/id #edb/ref 17592186234325 :knowledge-point/_questions [{:db/id #edb/ref 17592186105905 :knowledge-point/id #uuid "3173d361-b91d-5699-97d8-6595ef59d0a3" :knowledge-point/title "Calculating the Area of a Quadrilateral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e1a207-f9d0-53f3-b9be-3206f74c6704" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "85" :db/id #edb/ref 17592186512106} {:answer/id #uuid "992ff176-6fda-5a2c-8659-55baf90a83fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186512458} {:answer/id #uuid "af6bec52-f2b1-55fa-890f-584e44e51b59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186512510} {:answer/id #uuid "c3294de8-305e-5066-b9e4-7eebd339a6e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "78" :db/id #edb/ref 17592186512565} {:answer/id #uuid "ea211255-4798-55dc-866b-aae486ca03e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186512663}] :answer-field/correct {:answer/id #uuid "992ff176-6fda-5a2c-8659-55baf90a83fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186512458} :answer-field/id #uuid "a5f55799-fa35-55be-b5e7-23ed06c306d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512814}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5a33798d-52c0-57f6-a233-6585edd299f2" :question/math-academy-id "q-72754" :question/problem "![](images/4c/4ce20d9d732816efda0a2fd3aebabc467f9f2c73d0b6037f4ad8f95d8e8ef1e7.png)\n\nRounded to the nearest integer, what is the area of the quadrilateral $ABCD?$" :question/worked-solution "The area of the quadrilateral $ABCD$ is the sum of the areas of the triangles $△ABD$ and $△BDC$ (see the illustration below).\n\n![](images/6e/6e070d26915bcb11118f5a23f36b80038d5dd865e32a8517a12c10939ca02f0b.png)\n\nFirst, we find the area of $△ABD:$\n\n$$\n\\begin{aligned}{A}_{ABD} & =\\frac{1}{2}\\cdot 6\\cdot 8\\cdot \\operatorname{sin}⁡{85}^{∘} \\\\  & =24\\cdot \\operatorname{sin}⁡{85}^{∘} \\\\  & ≈23.908\\,7,\\end{aligned}\n$$\n\nrounded to four decimal places.\n\nNow we find the area of $△BCD:$\n\n$$\n\\begin{aligned}{A}_{BCD} & =\\frac{1}{2}\\cdot 14\\cdot 16\\cdot \\operatorname{sin}⁡{36.4}^{∘} \\\\  & =112\\cdot \\operatorname{sin}⁡{36.4}^{∘} \\\\  & ≈66.462\\,9,\\end{aligned}\n$$\n\nrounded to four decimal places.\n\nFinally, we add together the areas of our two triangles to determine the area of $ABCD:$\n\n$$\n\\begin{aligned}{A}_{ABCD} & ={A}_{ABD}+{A}_{BCD} \\\\  & ≈23.908\\,7+66.462\\,9 \\\\  & ≈90.371\\,6.\\end{aligned}\n$$\n\nConsequently, to the nearest integer, the area of the quadrilateral $ABCD$ is $90.$"}] [{:db/id #edb/ref 17592186512938 :knowledge-point/_questions [{:db/id #edb/ref 17592186054673 :knowledge-point/id #uuid "353c5ce4-024c-5c23-a226-99849fba18b4" :knowledge-point/title "Further Computing Probabilities Using Combinations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16176054-57d8-50dd-83a1-0a1e8ea37105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45%" :db/id #edb/ref 17592186512150} {:answer/id #uuid "1ec32d6a-e0a8-5c9e-973c-c722de870f07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27%" :db/id #edb/ref 17592186512162} {:answer/id #uuid "240ee738-741b-5618-af59-6d108f123836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17%" :db/id #edb/ref 17592186512178} {:answer/id #uuid "3be7b83f-658e-5186-bf99-aa39df89587a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35%" :db/id #edb/ref 17592186512230} {:answer/id #uuid "40693834-30ab-5f7b-b4a8-410b121d0822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37%" :db/id #edb/ref 17592186512237}] :answer-field/correct {:answer/id #uuid "1ec32d6a-e0a8-5c9e-973c-c722de870f07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27%" :db/id #edb/ref 17592186512162} :answer-field/id #uuid "c3a0c2d2-5b3a-522b-a6d4-7655774ccad3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512830}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c7f9805c-ce96-515d-891a-332594997042" :question/math-academy-id "q-85920" :question/problem "A team of $5$ players is to be chosen at random from $7$ boys and $5$ girls.  What is the probability that $2$ boys and $3$ girls will be chosen? Round your answer to the nearest percent." :question/worked-solution "Let $A$ represent the event described in the question. Then\n\n$$\n\\begin{aligned}P(A) & =\\frac{n}{N},\\end{aligned}\n$$\n\nwhere $N$ is the total number of ways to choose $5$ people out of a total of $12,$ and $n$ is the number of picks where $2$ are boys and $3$ are girls.\n\nSince the order in which the players are chosen does not matter, we use combinations.\n\nFirst, we compute $N.$ The number of ways to pick $5$ people from a total of $12$ is\n\n$$\n\\begin{aligned}N={}_{12}{C}_{5} & =\\frac{12!}{5!\\cdot 7!}=792.\\end{aligned}\n$$\n\nNow, we compute $n.$ The computation of $n$ can be divided into two steps: \n\n- the number of ways to choose $2$ (out of $7$) boys is \n\n$$\n\\begin{aligned}{}_{7}{C}_{2}=\\frac{7!}{2!\\cdot 5!}=21\\end{aligned}\n$$\n\n- the number of ways to choose $3$ (out of $5$) girls is \n\n$$\n\\begin{aligned}{}_{5}{C}_{3} & =\\frac{5!}{3!\\cdot 2!}=10\\end{aligned}\n$$\n\nMultiplying the results from the above steps, we get\n\n$$\n\\begin{aligned}n={}_{7}{C}_{2}\\cdot {}_{5}{C}_{3}=21\\cdot 10=210.\\end{aligned}\n$$\n\nFinally, \n\n$$\n\\begin{aligned}P(A) & =\\frac{210}{792}≈0.27=27%.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234470 :knowledge-point/_questions [{:db/id #edb/ref 17592186157438 :knowledge-point/id #uuid "8aaf12cf-8596-5960-bc68-5ca3eb5fab0f" :knowledge-point/title "Solving an Exponential Equation by Rearranging the Equation and Then Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e08de2a-a2d3-5bb5-9eff-7650cc85dd48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186512320} {:answer/id #uuid "95a56734-4623-5a29-823a-2dcc5eb112ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186512451} {:answer/id #uuid "a3148c07-b30e-5ef9-a7ce-98aeae65443e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186512480} {:answer/id #uuid "dd724d2d-9deb-58d6-b8f5-0793d0b3ea1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186512631} {:answer/id #uuid "e559e8d5-044b-536f-be6b-c537f919870e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186512647}] :answer-field/correct {:answer/id #uuid "a3148c07-b30e-5ef9-a7ce-98aeae65443e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186512480} :answer-field/id #uuid "da5f6c2e-8aef-51f4-af0b-4f5580c1b351" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512844}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f70c750-2bdb-5272-875c-7d304eb180d7" :question/math-academy-id "q-88472" :question/problem "What is the product of solutions of the equation $4{x}^{2}{e}^{5x}=3{e}^{5x}-4x{e}^{5x}?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}4{x}^{2}{e}^{5x} & =3{e}^{5x}-4x{e}^{5x} \\\\ 4{x}^{2}{e}^{5x}+4x{e}^{5x}-3{e}^{5x} & =0 \\\\ (4{x}^{2}+4x-3){e}^{5x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n4{x}^{2}+4x-3=0\\,\\text{and}\\,{e}^{5x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $4{x}^{2}+4x-3=0$ can be factored as\n\n$$\n(2x+3)(2x-1)=0,\n$$\n\nwhich leads to the solutions $x=-\\frac{3}{2},\\frac{1}{2}.$\n\n- The equation ${e}^{5x}=0$ has no solutions because ${e}^{5x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-\\frac{3}{2},\\frac{1}{2},$ and their product is $(-\\frac{3}{2})\\cdot \\frac{1}{2}=-\\frac{3}{4}.$"}] [{:db/id #edb/ref 17592186234471 :knowledge-point/_questions [{:db/id #edb/ref 17592186054735 :knowledge-point/id #uuid "54d9d8e4-c521-5b7d-bca7-f3c5b0d2b1d7" :knowledge-point/title "Finding the Magnitude of a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27e8a0d3-e9d0-5d51-a265-c0563c9b3cf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186512186} {:answer/id #uuid "6862586c-2f33-53f0-a4a2-03c505c418b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186512349} {:answer/id #uuid "8886309f-692e-500f-998c-a9b714ef0d0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186512416} {:answer/id #uuid "e5742b23-5b17-5bb0-9ed8-9c567870fcff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186512648} {:answer/id #uuid "faf87d00-4e4f-5040-a1bb-183235d0017e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186512703}] :answer-field/correct {:answer/id #uuid "6862586c-2f33-53f0-a4a2-03c505c418b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186512349} :answer-field/id #uuid "7e3a5638-9657-57b0-b3fc-98e2b3a3e4f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512796}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d30493c3-51f6-5c83-b546-665bbdac5511" :question/math-academy-id "q-889" :question/problem "Find $|z|$ if $z=2-3\\text{i}.$" :question/worked-solution "For a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nFor the complex number $z=2-3\\text{i},$ we have $a=2$ and $b=-3.$ So, the magnitude is given by\n\n$$\n\\begin{aligned}\\begin{aligned}|2-3\\text{i}| & =\\sqrt{{2}^{2}+(-3)^{2}} \\\\  & =\\sqrt{4+9} \\\\  & =\\sqrt{13}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234483 :knowledge-point/_questions [{:db/id #edb/ref 17592186172024 :knowledge-point/id #uuid "4d059c56-ae7f-5fb6-8bc6-2ce97bb7f876" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Even Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2126c568-9edc-5343-a977-03add492c720" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=13" :db/id #edb/ref 17592186512169} {:answer/id #uuid "70637956-2895-5e59-9c04-34a4660e4308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-7" :db/id #edb/ref 17592186512366} {:answer/id #uuid "87d28730-c006-5e79-9d89-80cc3de93d6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 15" :db/id #edb/ref 17592186512415} {:answer/id #uuid "a6248731-39c4-573a-bae9-7c33dde12c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=17" :db/id #edb/ref 17592186512493} {:answer/id #uuid "dfca70aa-c78a-5ad6-9130-294f9083ee33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no root" :db/id #edb/ref 17592186512637}] :answer-field/correct {:answer/id #uuid "a6248731-39c4-573a-bae9-7c33dde12c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=17" :db/id #edb/ref 17592186512493} :answer-field/id #uuid "0a6695ee-b357-51dc-b26f-ab87cc005be3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512726}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "aebcd2ff-63a9-5afc-9df9-bf4ebc2f269f" :question/math-academy-id "q-93100" :question/problem "Find the root of $f(x)=3\\sqrt[6]{3x+13}-6.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n3\\sqrt[6]{3x+13}-6=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}3\\sqrt[6]{3x+13}-6 & =0 \\\\ 3\\sqrt[6]{3x+13} & =6 \\\\ \\sqrt[6]{3x+13} & =2 \\\\ (\\sqrt[6]{3x+13})^{6} & ={2}^{6} \\\\ 3x+13 & =64 \\\\ 3x & =51 \\\\ x & =17\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}3\\sqrt[6]{3\\cdot 17+13}-6 & =0 \\\\ 3\\sqrt[6]{64}-6 & =0 \\\\ 3\\cdot 2-6 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=17.$"}] [{:db/id #edb/ref 17592186234488 :knowledge-point/_questions [{:db/id #edb/ref 17592186054746 :knowledge-point/id #uuid "e0ab12b8-b1c9-5192-91be-cebc968d9587" :knowledge-point/title "Evaluating a Logarithm Without a Calculator Using the Change of Base Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "154fa8da-d8d4-5d35-a927-4d997f30031e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186512146} {:answer/id #uuid "22ffff4a-deb5-521a-9391-9c312d39acfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186512174} {:answer/id #uuid "29fbd695-065d-59f9-a978-64ab959589fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186512195} {:answer/id #uuid "c582451e-1fd0-5671-8d95-3e20037da447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186512575} {:answer/id #uuid "c67bb952-4b1f-5631-b6cd-9cff40172e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186512577}] :answer-field/correct {:answer/id #uuid "c67bb952-4b1f-5631-b6cd-9cff40172e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186512577} :answer-field/id #uuid "f4740df2-7f5f-55f7-996f-1be23039010f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512858}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9bbddd9a-4e6f-51fe-9ece-2d2a83dcd62f" :question/math-academy-id "q-956" :question/problem "Calculate ${log}_{8}⁡(32)$ without using a calculator." :question/worked-solution "We use the change of base formula:\n\n$$\n{log}_{a}⁡X=\\frac{{log}_{b}⁡X}{{log}_{b}⁡a}\n$$\n\nIn our case, $a=8,$ and $X=32.$ Since both $a$ and $X$ are powers of $2,$ we set $b=2.$ So, we have:\n\n$$\n\\begin{aligned}{log}_{8}⁡(32) & =\\frac{{log}_{2}⁡(32)}{{log}_{2}⁡(8)} \\\\  & =\\frac{{log}_{2}⁡({2}^{5})}{{log}_{2}⁡({2}^{3})} \\\\  & =\\frac{5}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234512 :knowledge-point/_questions [{:db/id #edb/ref 17592186064186 :knowledge-point/id #uuid "b514d4ef-68ad-5fd4-b802-e61ca86aec2c" :knowledge-point/title "Converting Equations With Radicals Into Logarithmic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "239c326a-0a3b-5c29-850c-cac8919a3673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/4}⁡16=2" :db/id #edb/ref 17592186512177} {:answer/id #uuid "4779f4c7-29b4-5acc-9108-58e66d5a7ed5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{1/4}⁡2=16" :db/id #edb/ref 17592186512249} {:answer/id #uuid "4794e66d-dfd4-5289-9730-730f5a69be16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{16}⁡2=\\frac{1}{4}" :db/id #edb/ref 17592186512250} {:answer/id #uuid "5e21fa3f-1c6c-5a3a-b2e9-4f260f1443e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{4}⁡2=16" :db/id #edb/ref 17592186512321} {:answer/id #uuid "c4e5741e-9798-5186-9c1e-7f4c4d89acfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{2}⁡16=\\frac{1}{4}" :db/id #edb/ref 17592186512574}] :answer-field/correct {:answer/id #uuid "4794e66d-dfd4-5289-9730-730f5a69be16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{log}_{16}⁡2=\\frac{1}{4}" :db/id #edb/ref 17592186512250} :answer-field/id #uuid "c2c2319c-52ab-5a4c-97b1-53dcd4e20292" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512829}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32b42bfe-7421-54f2-832b-a9a8c0cbc5ae" :question/math-academy-id "q-99487" :question/problem "$\\sqrt[4]{16}=2$ is equivalent to" :question/worked-solution "Notice that the given equation can be written using exponents as follows:\n\n$$\n{16}^{1/4}=2\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${16}^{1/4}=2$ with $a={b}^{x},$ we get $a=2,b=16$ and $x=\\frac{1}{4}.$\n\nTherefore, the given equation is equivalent to ${log}_{16}⁡2=\\frac{1}{4}.$"}]}
