cc-5bf66a479b5f" #edb/ref 17592186045417] [17592186084103 #edb/ref 1063 #edb/ref 17592186083212 #edb/ref 17592186045417] [17592186084104 #edb/ref 1058 #edb/ref 17592186084105 #edb/ref 17592186045417] [17592186084104 #edb/ref 1061 20502 #edb/ref 17592186045417] [17592186084104 #edb/ref 1062 #uuid "113d7621-4637-5ddb-bcfe-a8f99fc1bb72" #edb/ref 17592186045417] [17592186084104 #edb/ref 1063 #edb/ref 17592186083213 #edb/ref 17592186045417] [17592186084105 #edb/ref 1061 20504 #edb/ref 17592186045417] [17592186084105 #edb/ref 1062 #uuid "ab03ce26-02b2-5bee-a351-687d9a193e8a" #edb/ref 17592186045417] [17592186084105 #edb/ref 1063 #edb/ref 17592186083214 #edb/ref 17592186045417] [17592186084132 #edb/ref 1058 #edb/ref 17592186084103 #edb/ref 17592186045417] [17592186084132 #edb/ref 1061 20705 #edb/ref 17592186045417] [17592186084132 #edb/ref 1062 #uuid "c9efaccc-7297-5304-9366-ffdbc569b338" #edb/ref 17592186045417] [17592186084132 #edb/ref 1063 #edb/ref 17592186083230 #edb/ref 17592186045417] [17592186084318 #edb/ref 1058 #edb/ref 17592186084319 #edb/ref 17592186045417] [17592186084318 #edb/ref 1061 41715 #edb/ref 17592186045417] [17592186084318 #edb/ref 1062 #uuid "f836d465-3cfd-57b6-ab05-79619fabc9a6" #edb/ref 17592186045417] [17592186084318 #edb/ref 1063 #edb/ref 17592186084499 #edb/ref 17592186045417] [17592186084319 #edb/ref 1058 #edb/ref 17592186084320 #edb/ref 17592186045417] [17592186084319 #edb/ref 1061 41716 #edb/ref 17592186045417] [17592186084319 #edb/ref 1062 #uuid "2e3f4334-5c00-58e4-9032-fed944bab672" #edb/ref 17592186045417] [17592186084319 #edb/ref 1063 #edb/ref 17592186083356 #edb/ref 17592186045417] [17592186084320 #edb/ref 1058 #edb/ref 17592186084321 #edb/ref 17592186045417] [17592186084320 #edb/ref 1061 41719 #edb/ref 17592186045417] [17592186084320 #edb/ref 1062 #uuid "d19f2942-df0f-5896-adf0-8c5b3ca192b5" #edb/ref 17592186045417] [17592186084320 #edb/ref 1063 #edb/ref 17592186083357 #edb/ref 17592186045417] [17592186084321 #edb/ref 1058 #edb/ref 17592186084322 #edb/ref 17592186045417] [17592186084321 #edb/ref 1061 41722 #edb/ref 17592186045417] [17592186084321 #edb/ref 1062 #uuid "26073589-e276-519e-b495-acab562e4cb3" #edb/ref 17592186045417] [17592186084321 #edb/ref 1063 #edb/ref 17592186083358 #edb/ref 17592186045417] [17592186084322 #edb/ref 1058 #edb/ref 17592186084323 #edb/ref 17592186045417] [17592186084322 #edb/ref 1061 41725 #edb/ref 17592186045417] [17592186084322 #edb/ref 1062 #uuid "3130ad01-93cf-56c2-a59d-52d2324277cf" #edb/ref 17592186045417] [17592186084322 #edb/ref 1063 #edb/ref 17592186084500 #edb/ref 17592186045417] [17592186084323 #edb/ref 1061 41726 #edb/ref 17592186045417] [17592186084323 #edb/ref 1062 #uuid "84556b63-2621-5c1b-84d0-55dbf5fff5d9" #edb/ref 17592186045417] [17592186084323 #edb/ref 1063 #edb/ref 17592186083359 #edb/ref 17592186045417] [17592186084422 #edb/ref 1064 "A function is said to be an **even function** if it is symmetric about the $y$-axis.\n\nFor example, the function \n\n$$\nf(x) = x^2,\n$$\n\nwhose graph is depicted below, is an example of an even function. It is symmetric about the $y$-axis, meaning that if we reflect the graph over the $y$-axis, we get the same picture.\n\n![](images/cf/cfca345c7ca094cacdbc6d7141a09e34fd116c677629a6a4c1917fb0db1f753f.png)" #edb/ref 17592186045417] [17592186084422 #edb/ref 1065 2774 #edb/ref 17592186045417] [17592186084422 #edb/ref 1066 #uuid "263b7003-1ee6-55aa-94cd-5ee25cbf63a4" #edb/ref 17592186045417] [17592186084422 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186084423 #edb/ref 1064 "Recall that the graph of the even function $f(x) = x^2$ is symmetric about the $y$-axis.\n\n![](images/07/07d0699c46b3cbd215c461d5df3629d86cd31a93228d6790fdc65b383e8556fc.png)\n\nNotice the following:\n\n$$\n\\begin{aligned}f(-1) & =1=f(1) \\\\ f(-2) & =4=f(2) \\\\ f(-3) & =9=f(3) \\\\  & \\,\\,\\,⋮\\end{aligned}\n$$\n\nSo, for every $x$ in the domain, both $x$ and $-x$ give the same value of the function. Algebraically, this fact can be written as follows: $f(-x) = f(x).$\n\nIn general, a function $f(x)$ is said to be **even** if\n\n$$\nf(-x) = f(x)\n$$\n\n \nfor each $x$ in the domain of the function." #edb/ref 17592186045417] [17592186084423 #edb/ref 1065 2776 #edb/ref 17592186045417] [17592186084423 #edb/ref 1066 #uuid "4c7a0bb9-4765-505f-a538-dd4a1426f8c3" #edb/ref 17592186045417] [17592186084423 #edb/ref 1067 "The Algebraic Definition of Even Functions" #edb/ref 17592186045417] [17592186084430 #edb/ref 1064 "A function is said to be an **odd function** if it has **rotational symmetry of order $2$ about the origin**. That is to say, if we rotate the graph of an odd function by $180^\\circ$ about the origin, we end up with the same picture.\n\nFor example, the function\n\n$$\ng(x)=x,\n$$\n\nwhose graph is shown below, is an example of an odd function. It has rotational symmetry of order $2$ about the origin, meaning that if we rotate the graph of an odd function by $180^\\circ$ about the origin, we end up with the same picture.\n\n![](images/ff/ff49c826d9a6a36b35edf73689d30e5d9dadc976b5f1caf47c1dd0383f9893bc.png)" #edb/ref 17592186045417] [17592186084430 #edb/ref 1065 2840 #edb/ref 17592186045417] [17592186084430 #edb/ref 1066 #uuid "1184d837-2701-5c4d-806c-6af72dee583b" #edb/ref 17592186045417] [17592186084430 #edb/ref 1067 "Classifying Odd Functions Graphically" #edb/ref 17592186045417] [17592186084431 #edb/ref 1064 "Now, recall that the graph of the odd function $g(x)=x$ has rotational symmetry of order $2$ about the origin.\n\n![](images/a0/a0dd6a5cbc09182a4a87569879a97da697a21eeda869ae20f512dc86a911b75e.png)\n\nNotice the following:\n\n$$\n\\begin{aligned}f(-1) & =-1=-f(1) \\\\ f(-2) & =-2=-f(2) \\\\ f(-3) & =-3=-f(3) \\\\  & \\,\\,\\,\\,\\,⋮\\end{aligned}\n$$\n\nSo, for every $x$ in the domain, $x$ and $-x$ give opposite values of the function. Algebraically, this fact can be written as $f(-x) = -f(x).$\n\nIn general, a function $f(x)$ is said to be **odd** if\n\n$$\nf(-x) = -f(x)\n$$\n\n \nfor each $x$ in the domain of the function." #edb/ref 17592186045417] [17592186084431 #edb/ref 1065 2844 #edb/ref 17592186045417] [17592186084431 #edb/ref 1066 #uuid "db19e6ba-49d7-534c-b84b-24dfd8866658" #edb/ref 17592186045417] [17592186084431 #edb/ref 1067 "The Algebraic Definition of Odd Functions" #edb/ref 17592186045417] [17592186084442 #edb/ref 1064 "Suppose we roll a fair die. Then, the sample space $\\mathcal S$ of this experiment is\n\n$$\n\\mathcal{S} = \\{1,2,3,4,5,6\\}\n$$\n\nNow, let's consider the event\n$X = \\{6\\}$.\nThis means that $X$ is the event \"the die lands on $6$.\" We know that\n\n$$\nP(X) = \\dfrac{1}{6}\n$$\n\nbecause there are $6$ equally likely outcomes and only $1$ of those outcomes is a $6$.\n\nWe can represent the entire sample space $\\mathcal S$, the event $X$, and its probability using a **Venn diagram**.\n\n![](images/96/966be6be009751b755fbcaca9f037e0c4ee281525a94e50a9a19631dc7cd4e1f.png)\n\nNote the following important points:\n\n- The area inside the rectangle represents the sample space $\\mathcal S$.\n- The area inside the circle (shaded blue) represents the event $X$.\n- The number inside the blue circle represents the probability of $X$.\n- The area inside the rectangle but outside the circle represents the event $X'$, the complement of $X$. In our case, the complement is\n$X' = \\{1,2,3,4,5\\}$,\nwhich consists of every event other than throwing a $6$.\n\nFor any event $X$, we have\n\n$$\nP(X) +P\\left(X'\\right) = 1\n$$\n\nNote that the above formula can be rearranged into either of the following equivalent forms:\n\n$$\n\\begin{aligned}\nP(X) &= 1 - P(X^{′}) \\\\\nP(X^{′}) &= 1 - P(X)\n\\end{aligned}\n$$\n\nIn our case, we can calculate\n\n$$\nP\\left(X'\\right)\n$$\n\nas\n\n$$\n\\begin{aligned}\nP(X^{′}) &= 1 - P(X) \\\\\n&= 1 - \\frac{1}{6} \\\\\n&= \\frac{5}{6}\n\\end{aligned}\n$$\n\nFinally, since the sample space $\\mathcal S$ contains every possible event, we sometimes write\n\n$$\nP(\\mathcal S) = 1\n$$" #edb/ref 17592186045417] [17592186084442 #edb/ref 1065 3657 #edb/ref 17592186045417] [17592186084442 #edb/ref 1066 #uuid "af5371a2-dcfe-5de0-b0ab-f82c96a0b759" #edb/ref 17592186045417] [17592186084442 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186084499 #edb/ref 1064 "Consider the mapping diagram of the function $f(x)$, shown below.\n\n![](images/41/415b9ce71454f2aec9a2fc678c79f1d34fbb16468fbac50fc62b76283b9c209a.png)\n\nLet's now reverse the arrows, as follows:\n\n![](images/80/801b3eca4820b110c2145bd13fbf1faddbb0db83905869410cad1dc8a32f4e83.png)\n\nNow, we have a mapping diagram that \"reverses\" the action of the function $f$. The diagram itself represents a new function, which we call the **inverse of the function $f$,** and denote by $f^{-1}$.\n\nWe can evaluate the inverse function $f^{-1}$ at any point in the range of $f$. For example, to find the value of $f^{-1}(2)$, we notice that we have an arrow from ${\\color{black}2}$ (on the right) to ${\\color{black}0}$ (on the left). Therefore,\n\n$$\nf^{-1}({\\color{black}2}) = {\\color{black}0}\n$$\n\nIn the original function, $f$, that same arrow went from ${\\color{black}0}$ (on the left) to ${\\color{black}2}$ (on the right). So, we have that\n\n$$\nf({\\color{black}0})={\\color{black}2}\n$$\n\nand as a result, we obtain\n\n$$\nf^{-1}(f(0)) = 0\n$$\n\nSo, applying the function $f$ and then \"reversing\" the action using $f^{-1}$ will get us back to $0$.\n\nIn general, this is true for every $x$ in the domain of the function $f$:\n\n$$\nf^{-1}(f(x)) = x\n$$" #edb/ref 17592186045417] [17592186084499 #edb/ref 1065 6883 #edb/ref 17592186045417] [17592186084499 #edb/ref 1066 #uuid "05fd6236-8b7b-59d7-bf60-5e7d9d2db65a" #edb/ref 17592186045417] [17592186084499 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186084500 #edb/ref 1064 "Recall that the $f^{-1}$ \"reverses\" the action of $f$ so that\n\n$$\nf^{-1}(f(x)) = x\n$$\n\nwhich can be visualized using the mapping diagram, as shown below.\n\n![](images/91/9124176153ba77d905cf4cafad36d700f87ed5519a9f2e302b8a4dee6a6e1a51.png)\n\nSince $f^{-1}(f(x))$ is just the composition $(f^{-1} \\circ f)(x)$, we can now give the algebraic definition of the inverse.\n\nThe function $f^{-1}$ is called the **inverse of the function $f$** if\n\n$$\n(f^{-1} \\circ f)(x) = x\n$$\n\nfor each $x$ in the domain of $f$.\n\nIn other words, to show that two functions $f(x)$ and $g(x)$ are inverses of each other, we need to check the following condition:\n\n$$\n(g\\circ f)(x) = x\n$$" #edb/ref 17592186045417] [17592186084500 #edb/ref 1065 6884 #edb/ref 17592186045417] [17592186084500 #edb/ref 1066 #uuid "f4a2e52b-5aee-58ed-bcc3-b236246d862c" #edb/ref 17592186045417] [17592186084500 #edb/ref 1067 "The Definition of the Inverse Function" #edb/ref 17592186045417] [17592186087491 #edb/ref 1069 "e-3990" #edb/ref 17592186045417] [17592186087491 #edb/ref 1071 "Rounded to $2$ decimal places, what is the value of $\\dfrac{4}{\\ln(2)}$?" #edb/ref 17592186045417] [17592186087491 #edb/ref 1072 #uuid "effc520d-4717-5e46-9358-c2ea34c7aa24" #edb/ref 17592186045417] [17592186087491 #edb/ref 1074 "We compute the required expression to $2$ decimal places using a calculator, rounding the intermediate steps to $5$ decimal places to avoid rounding error. This gives\n\n$$\n(4)/(\\ln (2)) \\mid \\approx \\frac{4}{0.69315}; \\approx 5.77076; \\approx 5.77\n$$" #edb/ref 17592186045417] [17592186087492 #edb/ref 1069 "e-4056" #edb/ref 17592186045417] [17592186087492 #edb/ref 1071 "Convert the expression $\\ln{3} \\approx 1.1$ to its equivalent exponential form." #edb/ref 17592186045417] [17592186087492 #edb/ref 1072 #uuid "97f9f0d6-d948-5f9b-b0ae-57e6a456a53b" #edb/ref 17592186045417] [17592186087492 #edb/ref 1074 "The natural logarithm of $a$ is defined as follows:\n\n> $\\ln{a} = x$ is equivalent to $a = e^x$\n\nIf we compare\n\n$$\n\\ln{3} \\approx 1.1\n$$\n\nwith $\\ln{a} = x$, we get $a = 3$ and $x = 1.1$.\n\nTherefore, the approximation\n\n$$\n\\ln{3} \\approx 1.1\n$$\n\nis equivalent to\n\n$$\ne^{1.1} \\approx 3\n$$" #edb/ref 17592186045417] [17592186087493 #edb/ref 1069 "e-4057" #edb/ref 17592186045417] [17592186087493 #edb/ref 1071 "Evaluate $\\ln\\left(e^{6}\\right)$." #edb/ref 17592186045417] [17592186087493 #edb/ref 1072 #uuid "fd02e00f-9e2c-54f1-a5d3-fb0da9c9a413" #edb/ref 17592186045417] [17592186087493 #edb/ref 1074 "The natural logarithm of a power of $e$ is the power itself:\n\n$$\n\\ln(e^x) = x\n$$\n\nIn our case, we have $x = 6$. Therefore,\n\n$$\n\\ln\\left(e^{6}\\right) = 6\n$$" #edb/ref 17592186045417] [17592186087497 #edb/ref 1069 "e-4155" #edb/ref 17592186045417] [17592186087497 #edb/ref 1071 "Evaluate $\\ln\\left(\\dfrac{1}{e^{3}}\\right)$." #edb/ref 17592186045417] [17592186087497 #edb/ref 1072 #uuid "37ca3b87-9f5f-583c-95ff-83ca35608559" #edb/ref 17592186045417] [17592186087497 #edb/ref 1074 "First, we rewrite\n\n$$\n\\dfrac{1}{e^3}\n$$\n\nas a power of $e$ (the base of the natural logarithm) as follows:\n\n$$\n\\dfrac{1}{e^3} = e^{-3}\n$$\n\nTherefore, we have\n\n$$\n\\ln\\left(\\dfrac{1}{e^3} \\right) = \\ln \\left(e^{-3} \\right)\n$$\n\nThe natural logarithm of a power of $e$ is the power itself:\n\n$$\n\\ln(e^x) = x\n$$\n\nIn our case, we have $x = -3$. Therefore,\n\n$$\n\\ln\\left(e^{-3}\\right) =-3\n$$" #edb/ref 17592186045417] [17592186087581 #edb/ref 1069 "e-5881" #edb/ref 17592186045417] [17592186087581 #edb/ref 1071 "Find the remainder when $p(x)=3x^2 +7x - 4$ is divided by $(3x-2)$." #edb/ref 17592186045417] [17592186087581 #edb/ref 1072 #uuid "1e79a137-05cd-5dd5-bb0a-04c9040c05e4" #edb/ref 17592186045417] [17592186087581 #edb/ref 1074 "The remainder theorem states that when $p(x)$ is divided by\n\n$$\n(3x-2)= 3\\left(x-\\dfrac23\\right)\n$$\n\nthe remainder equals\n\n$$\np\\left(\\dfrac23\\right)\n$$\n\nEvaluating\n\n$$\np\\left(\\dfrac23\\right)\n$$\n\ndirectly gives\n\n$$\n\\begin{aligned} p\\left(\\dfrac23\\right) & =3\\cdot \\left(\\dfrac23\\right)^2 +7\\cdot \\left(\\dfrac23\\right) - 4 \\\\[5pt] & =3\\cdot \\left(\\dfrac49\\right) +\\dfrac{14}{3} - 4 \\\\[5pt] & =\\dfrac{12}{9}+\\dfrac{2}{3} \\\\[5pt] & = \\dfrac{12+ 3\\cdot 2}{9} \\\\[5pt] & = \\dfrac{18}{9} \\\\[5pt] & = 2. \\end{aligned}\n$$\n\nSo, when $p(x)$ is divided by\n\n$$\n3\\left(x-\\dfrac23\\right)\n$$\n\nthe remainder is $2$.\n\n**Note:** We can check the answer by carrying out synthetic division:\n\n|  | $x^2$ | $x^1$ | $x^0$ |\n| --- | ---: | ---: | ---: |\n| $\\color{red}\\frac23$ | $3$ | $7$ | $\\!\\!\\!\\!-4$ |\n|  | $\\color{gray}\\downarrow$ | $2$ | $6$ |\n|  | $3$ | $9$ | $2$ |" #edb/ref 17592186045417] [17592186087582 #edb/ref 1069 "e-5882" #edb/ref 17592186045417] [17592186087582 #edb/ref 1071 "If $q(x)=2x^3+3x^2-5x+c$ has remainder $-5$ when divided by $(x+3)$, what is the value of $c$?" #edb/ref 17592186045417] [17592186087582 #edb/ref 1072 #uuid "488cb495-bf1e-5f52-87a5-8bfc6fbbce16" #edb/ref 17592186045417] [17592186087582 #edb/ref 1074 "The remainder theorem states that when $q(x)$ is divided by $(x+3)$, the remainder equals $q(-3)$. Since we're told that the remainder is $-5$, then, we must have $q(-3)=-5$.\n\nEvaluating $q(-3)$ directly gives\n\n$$\n\\begin{aligned}\nq(-3) &= 2(-3)^{3} + 3(-3)^{2} - 5(-3) + c \\\\\n&=-54 + 27 + 15 + c \\\\\n&=-12 + c\n\\end{aligned}\n$$\n\nwhich means that\n\n$$\n-5 = -12 + c\n$$\n\nSolving for $c$ in the equation above, we find that $c=7$." #edb/ref 17592186045417] [17592186087583 #edb/ref 1069 "e-5883" #edb/ref 17592186045417] [17592186087583 #edb/ref 1071 "Suppose $f(x) = ax^3 +bx^2 -11x -2$ has a factor of $(x-2)$ and remainder of $-8$ when divided by $(x-1)$. Find the values of $a$ and $b$." #edb/ref 17592186045417] [17592186087583 #edb/ref 1072 #uuid "6bbc5788-0449-51cb-815a-83f578ef6b15" #edb/ref 17592186045417] [17592186087583 #edb/ref 1074 "Since $(x-2)$ is a factor of $f(x)$, it must divide into $f(x)$ with no remainder. In other words, when $f(x)$ is divided by $(x-2)$, the remainder is $0$. It follows from the remainder theorem that\n\n$$\n\\begin{aligned}\n0 &= f(2) \\\\\n&= a(2)^{3} + b(2)^{2} - 11(2) - 2 \\\\\n&= 8a + 4b - 24\n\\end{aligned}\n$$\n\nLikewise, since we're told that the remainder is $-8$ when $f(x)$ is divided by $(x-1)$, it follows from the remainder theorem that\n\n$$\n\\begin{aligned}\n-8 &= f(1) \\\\\n&= a(1)^{3} + b(1)^{2} - 11(1) - 2 \\\\\n&= a + b - 13\n\\end{aligned}\n$$\n\nWe now have the system of equations\n\n$$\n{0 = 8a + 4b - 24; - 8 = a + b - 13\n$$\n\nSimplifying each equation, we get\n\n$$\n{2a + b = 6; a + b = 5\n$$\n\nTo eliminate $b$, we subtract the equations and get\n\n$$\n\\begin{aligned}\n2\\begin{vmatrix}a + b &= 6 \\\\ -\\end{vmatrix}a + b|= 5 \\\\\na &= 1\n\\end{aligned}\n$$\n\nFinally, we substitute $a=1$ into\n\n$$\na+b=5\n$$\n\nto find $b=4$.\n\nTherefore, our final solution is\n\n$$\n(a,b) = (1,4)\n$$" #edb/ref 17592186045417] [17592186087683 #edb/ref 1038 #edb/ref 17592186088088 #edb/ref 17592186045417] [17592186087683 #edb/ref 1038 #edb/ref 17592186088119 #edb/ref 17592186045417] [17592186087683 #edb/ref 1039 "Evaluating Expressions Containing Natural Logarithms Using a Calculator" #edb/ref 17592186045417] [17592186087683 #edb/ref 1041 #edb/ref 17592186087491 #edb/ref 17592186045417] [17592186087683 #edb/ref 1042 #uuid "8d82c39c-5ec6-5cf3-96f8-e778091a451a" #edb/ref 17592186045417] [17592186087684 #edb/ref 1037 #edb/ref 17592186049859 #edb/ref 17592186045417] [17592186087684 #edb/ref 1037 #edb/ref 17592186049865 #edb/ref 17592186045417] [17592186087684 #edb/ref 1038 #edb/ref 17592186088259 #edb/ref 17592186045417] [17592186087684 #edb/ref 1038 #edb/ref 17592186088260 #edb/ref 17592186045417] [17592186087684 #edb/ref 1039 "Converting Between Exponential and Logarithmic Form With Natural Logarithms" #edb/ref 17592186045417] [17592186087684 #edb/ref 1041 #edb/ref 17592186087492 #edb/ref 17592186045417] [17592186087684 #edb/ref 1042 #uuid "30497207-86c5-507f-906a-d23bd0af71e9" #edb/ref 17592186045417] [17592186087685 #edb/ref 1037 #edb/ref 17592186048964 #edb/ref 17592186045417] [17592186087685 #edb/ref 1038 #edb/ref 17592186088261 #edb/ref 17592186045417] [17592186087685 #edb/ref 1038 #edb/ref 17592186088262 #edb/ref 17592186045417] [17592186087685 #edb/ref 1039 "Evaluating Natural Logarithms" #edb/ref 17592186045417] [17592186087685 #edb/ref 1041 #edb/ref 17592186087493 #edb/ref 17592186045417] [17592186087685 #edb/ref 1042 #uuid "a323ad55-d029-58f4-b0a3-cc10b7dab125" #edb/ref 17592186045417] [17592186087692 #edb/ref 1038 #edb/ref 17592186088252 #edb/ref 17592186045417] [17592186087692 #edb/ref 1038 #edb/ref 17592186088257 #edb/ref 17592186045417] [17592186087692 #edb/ref 1038 #edb/ref 17592186512891 #edb/ref 17592186045417] [17592186087692 #edb/ref 1038 #edb/ref 17592186512917 #edb/ref 17592186045417] [17592186087692 #edb/ref 1039 "Evaluating Natural Logarithms of Fractions and Roots" #edb/ref 17592186045417] [17592186087692 #edb/ref 1041 #edb/ref 17592186087497 #edb/ref 17592186045417] [17592186087692 #edb/ref 1042 #uuid "169ca81a-c698-553c-9f47-d6c4303b82a9" #edb/ref 17592186045417] [17592186087854 #edb/ref 1037 #edb/ref 17592186051061 #edb/ref 17592186045417] [17592186087854 #edb/ref 1038 #edb/ref 17592186087981 #edb/ref 17592186045417] [17592186087854 #edb/ref 1038 #edb/ref 17592186088156 #edb/ref 17592186045417] [17592186087854 #edb/ref 1038 #edb/ref 17592186088327 #edb/ref 17592186045417] [17592186087854 #edb/ref 1039 "Finding the Value of the Remainder When a Polynomial is Divided by a Linear Factor" #edb/ref 17592186045417] [17592186087854 #edb/ref 1041 #edb/ref 17592186087581 #edb/ref 17592186045417] [17592186087854 #edb/ref 1042 #uuid "18823139-c8c2-56ad-b8cc-4e43b97e904d" #edb/ref 17592186045417] [17592186087855 #edb/ref 1038 #edb/ref 17592186088158 #edb/ref 17592186045417] [17592186087855 #edb/ref 1038 #edb/ref 17592186088330 #edb/ref 17592186045417] [17592186087855 #edb/ref 1038 #edb/ref 17592186088335 #edb/ref 17592186045417] [17592186087855 #edb/ref 1039 "Findin