2}=\\frac{12}{-4}=-3\\end{aligned}\n$$"} :step/id #uuid "c74026d0-f786-50c1-b154-b7d927f144aa" :step/next {:db/id #edb/ref 17592186516982}} {:db/id #edb/ref 17592186516973 :step/content {:db/id #edb/ref 17592186234092 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0232f6d1-cc47-55de-8533-bead91016a51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-77" :db/id #edb/ref 17592186516117} {:answer/id #uuid "3581fa24-c005-5f7c-a7ef-a44af78898c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "33" :db/id #edb/ref 17592186516225} {:answer/id #uuid "574a7f7b-4e6e-5629-b9e0-03d3d14a8260" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-41" :db/id #edb/ref 17592186516295} {:answer/id #uuid "ae50b601-00f2-5d2d-862d-a236109f9bed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-33" :db/id #edb/ref 17592186516475} {:answer/id #uuid "cb4ed9aa-c01d-5794-9c67-4387dd7bdb77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "77" :db/id #edb/ref 17592186516542}] :answer-field/correct {:db/id #edb/ref 17592186516475} :answer-field/id #uuid "46b5e342-2f59-5f17-97d7-60225f6e5208" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516677}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "98638830-1bd5-5922-b12a-9c190db0e3da" :question/math-academy-id "q-4825" :question/problem "Given $f(x)=2{x}^{2}+5x$ and $g(x)=9-2x,$ find $(fg)(-1).$" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(-1),$ we find $f(-1)$ and $g(-1),$ and then multiply the results.\n\nFirst, we find $f(-1)$ and $g(-1):$\n\n$$\n\\begin{aligned}f(-1) & =2(-1)^{2}+5(-1)=-3 \\\\ g(-1) & =9-2(-1)=11\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(-1)=f(-1)g(-1)=-3\\cdot 11=-33\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =(2{x}^{2}+5x)(9-2x) \\\\  & =-4{x}^{3}+8{x}^{2}+45x\\end{aligned}\n$$\n\nNow, we evaluate $(fg)(-1):$ \n\n$$\n\\begin{aligned}(fg)(-1) & =-4(-1)^{3}+8(-1)^{2}+45(-1) \\\\  & =4+8-45 \\\\  & =-33\\end{aligned}\n$$"} :step/id #uuid "dbee05de-3d07-576a-9368-57acc32e5170" :step/next {:db/id #edb/ref 17592186516933}} {:db/id #edb/ref 17592186516982 :step/content {:db/id #edb/ref 17592186516817 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02da732e-8f8f-522b-a0af-c292550ebd0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186516118} {:answer/id #uuid "12fd6f4f-4886-505e-ae42-dc7cc6984c42" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Undefined" :db/id #edb/ref 17592186516148} {:answer/id #uuid "2045e6fa-2eac-591c-966c-1fdb56bcfe80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186516173} {:answer/id #uuid "5f02d874-962f-54b5-b78b-81b45af705f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186516318} {:answer/id #uuid "7eaec706-9934-5e79-9ce3-c47dee2c41e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186516381}] :answer-field/correct {:db/id #edb/ref 17592186516173} :answer-field/id #uuid "b0def8c5-0e76-5633-984d-4a0398a720ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516734}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "76e8734a-ae7e-5bfd-82cf-840027d7b221" :question/math-academy-id "q-66437" :question/problem "Given $f(x)={x}^{2}-4$ and $g(x)=2x+2,$ find  $(f/g)(2).$" :question/worked-solution "The notation $(f/g)(x)$ means the quotient of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f/g)(2),$ we find $f(2)$ and $g(2),$ and then divide the results.\n\nFirst, we find $f(2)$ and $g(2):$\n\n$$\n\\begin{aligned}f(2) & =(2)^{2}-4=0 \\\\ g(2) & =2(2)+2=6\\end{aligned}\n$$\n\n \n\nNow, we divide the results:\n\n$$\n(f/g)(2)=\\frac{f(2)}{g(2)}=\\frac{0}{6}=0\n$$\n\n**Method 2**\n\nFirst, we find $(f/g)(x)$ by dividing $f$ by $g$:\n\n$$\n\\begin{aligned}(f/g)(x)=\\frac{{x}^{2}-4}{2x+2}\\end{aligned}\n$$\n\nNow, we evaluate $(f/g)(2):$  \n\n$$\n\\begin{aligned}(f/g)(2) & =\\frac{(2)^{2}-4}{2(2)+2}=\\frac{0}{6}=0\\end{aligned}\n$$"} :step/id #uuid "f577bcab-36ae-5324-94f9-2ea6a15c229b"}] :activity/title "The Arithmetic of Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516103}] [{:activity/first-step {:db/id #edb/ref 17592186084318} :activity/id #uuid "66462250-9bf6-5b79-837b-72d46f60efbf" :activity/scope {:db/id #edb/ref 17592186050867 :topic/id #uuid "6cb8c050-5f50-5c96-a3dc-144c8d409165" :topic/math-academy-id 753} :activity/steps [{:db/id #edb/ref 17592186084318 :step/content {:db/id #edb/ref 17592186084499 :tutorial/content "Consider the mapping diagram of the function $f(x)$, shown below.\n\n![](images/41/415b9ce71454f2aec9a2fc678c79f1d34fbb16468fbac50fc62b76283b9c209a.png)\n\nLet's now reverse the arrows, as follows:\n\n![](images/80/801b3eca4820b110c2145bd13fbf1faddbb0db83905869410cad1dc8a32f4e83.png)\n\nNow, we have a mapping diagram that \"reverses\" the action of the function $f$. The diagram itself represents a new function, which we call the **inverse of the function $f$,** and denote by $f^{-1}$.\n\nWe can evaluate the inverse function $f^{-1}$ at any point in the range of $f$. For example, to find the value of $f^{-1}(2)$, we notice that we have an arrow from ${\\color{black}2}$ (on the right) to ${\\color{black}0}$ (on the left). Therefore,\n\n$$\nf^{-1}({\\color{black}2}) = {\\color{black}0}\n$$\n\nIn the original function, $f$, that same arrow went from ${\\color{black}0}$ (on the left) to ${\\color{black}2}$ (on the right). So, we have that\n\n$$\nf({\\color{black}0})={\\color{black}2}\n$$\n\nand as a result, we obtain\n\n$$\nf^{-1}(f(0)) = 0\n$$\n\nSo, applying the function $f$ and then \"reversing\" the action using $f^{-1}$ will get us back to $0$.\n\nIn general, this is true for every $x$ in the domain of the function $f$:\n\n$$\nf^{-1}(f(x)) = x\n$$" :tutorial/id #uuid "05fd6236-8b7b-59d7-bf60-5e7d9d2db65a" :tutorial/math-academy-id 6883 :tutorial/title "Introduction"} :step/id #uuid "f836d465-3cfd-57b6-ab05-79619fabc9a6" :step/math-academy-id 41715 :step/next {:db/id #edb/ref 17592186084319}} {:db/id #edb/ref 17592186084319 :step/content {:db/id #edb/ref 17592186083356 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082904 :question/id #uuid "bca42c78-0735-587e-914b-7c9892f47d51" :question/math-academy-id "e-10986"} :knowledge-point/id #uuid "0b2b6ea7-ea1c-5d6b-b786-bb0880c6af4a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050633}] :knowledge-point/questions [{:db/id #edb/ref 17592186083877} {:db/id #edb/ref 17592186083878}] :knowledge-point/title "Evaluating an Inverse Function From a Mapping Diagram"} :step/id #uuid "2e3f4334-5c00-58e4-9032-fed944bab672" :step/math-academy-id 41716 :step/next {:db/id #edb/ref 17592186084320}} {:db/id #edb/ref 17592186084320 :step/content {:db/id #edb/ref 17592186083357 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082905 :question/id #uuid "841640c2-1f50-5a13-b12b-bfe202e7621c" :question/math-academy-id "e-10987"} :knowledge-point/id #uuid "bd1735b2-8684-5312-8315-ec6acb2daa21" :knowledge-point/questions [{:db/id #edb/ref 17592186083819} {:db/id #edb/ref 17592186083990}] :knowledge-point/title "Evaluating an Inverse Function Given Function Data"} :step/id #uuid "d19f2942-df0f-5896-adf0-8c5b3ca192b5" :step/math-academy-id 41719 :step/next {:db/id #edb/ref 17592186084321}} {:db/id #edb/ref 17592186084321 :step/content {:db/id #edb/ref 17592186083358 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082906 :question/id #uuid "200ba5c0-9ec6-56e9-8ce4-24cee169ac8c" :question/math-academy-id "e-10988"} :knowledge-point/id #uuid "ab89a7ad-8b73-5dde-b5ed-efac2deb67e1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048838}] :knowledge-point/questions [{:db/id #edb/ref 17592186083663} {:db/id #edb/ref 17592186083879}] :knowledge-point/title "Evaluating an Inverse Function Using a Graph"} :step/id #uuid "26073589-e276-519e-b495-acab562e4cb3" :step/math-academy-id 41722 :step/next {:db/id #edb/ref 17592186084322}} {:db/id #edb/ref 17592186084322 :step/content {:db/id #edb/ref 17592186084500 :tutorial/content "Recall that the $f^{-1}$ \"reverses\" the action of $f$ so that\n\n$$\nf^{-1}(f(x)) = x\n$$\n\nwhich can be visualized using the mapping diagram, as shown below.\n\n![](images/91/9124176153ba77d905cf4cafad36d700f87ed5519a9f2e302b8a4dee6a6e1a51.png)\n\nSince $f^{-1}(f(x))$ is just the composition $(f^{-1} \\circ f)(x)$, we can now give the algebraic definition of the inverse.\n\nThe function $f^{-1}$ is called the **inverse of the function $f$** if\n\n$$\n(f^{-1} \\circ f)(x) = x\n$$\n\nfor each $x$ in the domain of $f$.\n\nIn other words, to show that two functions $f(x)$ and $g(x)$ are inverses of each other, we need to check the following condition:\n\n$$\n(g\\circ f)(x) = x\n$$" :tutorial/id #uuid "f4a2e52b-5aee-58ed-bcc3-b236246d862c" :tutorial/math-academy-id 6884 :tutorial/title "The Definition of the Inverse Function"} :step/id #uuid "3130ad01-93cf-56c2-a59d-52d2324277cf" :step/math-academy-id 41725 :step/next {:db/id #edb/ref 17592186084323}} {:db/id #edb/ref 17592186084323 :step/content {:db/id #edb/ref 17592186083359 :knowledge-point/canonical-example {:db/id #edb/ref 17592186082907 :question/id #uuid "062748b1-c85a-5c2c-8d1f-f1006e73a880" :question/math-academy-id "e-10989"} :knowledge-point/id #uuid "06e51d62-ad2a-51c3-b276-eeb60022ab48" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049317} {:db/id #edb/ref 17592186050622}] :knowledge-point/questions [{:db/id #edb/ref 17592186083552} {:db/id #edb/ref 17592186083553} {:db/id #edb/ref 17592186083662} {:db/id #edb/ref 17592186233404} {:db/id #edb/ref 17592186233413} {:db/id #edb/ref 17592186234200}] :knowledge-point/title "Computing an Inverse Function Using the Definition"} :step/id #uuid "84556b63-2621-5c1b-84d0-55dbf5fff5d9" :step/math-academy-id 41726}] :activity/title "Introduction to Inverse Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083443}] [{:activity/first-step {:db/id #edb/ref 17592186055630} :activity/id #uuid "913d0dba-5888-5da2-af62-bd71555fbd8a" :activity/scope {:db/id #edb/ref 17592186051013 :topic/id #uuid "79d52f6b-aedf-5a99-b881-b489d9e71e06" :topic/math-academy-id 132} :activity/steps [{:db/id #edb/ref 17592186055630 :step/content {:db/id #edb/ref 17592186055986 :tutorial/content "Sometimes, when calculating probabilities, we have to use our knowledge of permutations. We do this when the order of occurrences in the event matters.\n\nFor instance, suppose we create a $3$-digit number from the digits $1$, $2$, $3$, and $4$, without repetition. What is the probability that our number starts with $1$?\n\nLet $A$ represent the event that our number starts with $1$. We can use the formula\n$3$\n\nFirst, let's calculate the total number of ways to choose a $3$-digit number using the digits $1$, $2$, $3$, and $4$ without repetition. From $4$ digits, we choose $3$ of them, and since the order of the digits matters, we use permutations:\n\n$$\nN = {}_{4}P_3 = \\dfrac{4!}{(4-3)!} = 24\n$$\n\nThen, we calculate the number of ways to choose a $3$-digit number starting with $1$. The first digit has to be $1$, and so to form the rest of the number, we can choose another $2$ digits out of the remaining $3$. Again, since the order of the digits matters, we use permutations:\n\n$$\nn = {}_{3}P_2 = \\dfrac{3!}{(3-2)!} = \\dfrac{3!}{1!} = 6\n$$\n\nTherefore, using the formula, the probability is\n\n$$\nP(A) = \\dfrac{n}{N} = \\dfrac{6}{24} = \\dfrac{1}{4} = 25\\%\n$$" :tutorial/id #uuid "8891f962-2358-5995-822d-0fb7f020565c" :tutorial/math-academy-id 3686 :tutorial/title "Introduction"} :step/id #uuid "74d9b17e-d785-5076-baae-f6c14fd34423" :step/math-academy-id 20578 :step/next {:db/id #edb/ref 17592186055631}} {:db/id #edb/ref 17592186055631 :step/content {:db/id #edb/ref 17592186054672 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054567 :question/id #uuid "2b1fef9c-13b4-52c7-a7c0-c53cdc5dec7f" :question/math-academy-id "e-5678"} :knowledge-point/id #uuid "7ec1189c-2f89-5aad-9eb1-cfc5fc84b389" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048254} {:db/id #edb/ref 17592186048431} {:db/id #edb/ref 17592186049300}] :knowledge-point/questions [{:db/id #edb/ref 17592186055337} {:db/id #edb/ref 17592186055351}] :knowledge-point/title "Computing Probabilities Using Permutations"} :step/id #uuid "d9f70b44-647d-502a-b166-627763161cf7" :step/math-academy-id 20579 :step/next {:db/id #edb/ref 17592186055632}} {:db/id #edb/ref 17592186055632 :step/content {:db/id #edb/ref 17592186055987 :tutorial/content "When the order of occurrences in an event does *not* matter, we use combinations instead of permutations.\n\nFor example, suppose that in a game, a player must draw two tiles randomly from a bag. Each tile is labeled with a letter from either $a$, $b$, $c$, or $d$, and there are five tiles of each letter (so a total of $20$ tiles). What is the probability that both of the player's tiles are labeled with the letter $a$?\n\nLet $A$ represent the event described in the question. Then\n\n$$\nP(A) = \\dfrac{n}{N}\n$$\n\nwhere $N$ is the total number of ways to pick $2$ tiles out of $20$, and $n$ is the number of those $2$-tile picks where both tiles have the letter $a$.\n\nNote that since the order of the picks does not matter, we must use combinations.\n\nFirst, we compute $N$. The number of ways to draw $2$ tiles from a total of $20$ is\n\n$$\nN = {}_{20}C_2 = \\dfrac{20!}{2!\\cdot 18!} = 190\n$$\n\nNow, we compute $n$. There are $5$ tiles with the letter $a$, so the number of ways to choose $2$ of those tiles (out of $5$) is\n\n$$\nn = {}_{5}C_2 = \\dfrac{5!}{2!\\cdot 3!} = 10\n$$\n\nFinally,\n\n$$\nP(A) = \\dfrac{10}{190} = \\dfrac{1}{19}\n$$" :tutorial/id #uuid "70abb95c-1d33-539c-976f-2558824c3681" :tutorial/math-academy-id 3687 :tutorial/title "Computing Probabilities Using Combinations"} :step/id #uuid "5cc5618c-cf9a-57f7-8313-8a684200218f" :step/math-academy-id 20580 :step/next {:db/id #edb/ref 17592186055659}} {:db/id #edb/ref 17592186055633 :step/content {:db/id #edb/ref 17592186054673 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054568 :question/id #uuid "86e0ce13-7866-562e-81a7-9500401bfed7" :question/math-academy-id "e-5679"} :knowledge-point/id #uuid "353c5ce4-024c-5c23-a226-99849fba18b4" :knowledge-point/questions [{:db/id #edb/ref 17592186055332} {:db/id #edb/ref 17592186055340} {:db/id #edb/ref 17592186512938}] :knowledge-point/title "Further Computing Probabilities Using Combinations"} :step/id #uuid "4538c9de-86c1-5ebe-a9e1-edbf86aac5ac" :step/math-academy-id 20581 :step/next {:db/id #edb/ref 17592186055634}} {:db/id #edb/ref 17592186055634 :step/content {:db/id #edb/ref 17592186054674 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054569 :question/id #uuid "4b0a7e6e-7f71-55c8-bef4-789f3ca2fbeb" :question/math-academy-id "e-5680"} :knowledge-point/id #uuid "92ef3234-540b-5b75-aeae-45d6231da7fc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049642}] :knowledge-point/questions [{:db/id #edb/ref 17592186055348} {:db/id #edb/ref 17592186055349}] :knowledge-point/title "Computing Probabilities Using the Complement"} :step/id #uuid "7fcc90ed-551e-592b-9eb9-ae80ba333c63" :step/math-academy-id 20582} {:db/id #edb/ref 17592186055659 :step/content {:db/id #edb/ref 17592186054689 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054579 :question/id #uuid "7b1a0931-7eb8-53a5-9fe7-eee6ed5d3757" :question/math-academy-id "e-7561"} :knowledge-point/id #uuid "7c9517d3-7f13-5cd7-8359-055fb69282e7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049434}] :knowledge-point/questions [{:db/id #edb/ref 17592186055333} {:db/id #edb/ref 17592186055341}] :knowledge-point/title "Computing Probabilities Using Combinations"} :step/id #uuid "6fbd0f3c-3ff1-584f-82cd-a2584a7488ad" :step/math-academy-id 28094 :step/next {:db/id #edb/ref 17592186055633}}] :activity/title "Computing Probabilities Using Combinatorics" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054882}]}
