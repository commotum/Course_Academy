18014}] :activity/title "Factoring Higher-Order Polynomials as a Difference of Squares" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078679}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186516901} :activity/id #uuid "46144c44-d687-5bae-90fd-5191deef0586" :activity/scope {:db/id #edb/ref 17592186050307 :topic/id #uuid "3e99290f-65b0-574f-9d45-f70ae6a291e2" :topic/math-academy-id 660} :activity/steps [{:db/id #edb/ref 17592186516901 :step/content {:db/id #edb/ref 17592186516868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e441f3c-74ea-5954-9b04-0b444ffa3de2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(4{s}^{2}+1)(2s+1)(2s-1)" :db/id #edb/ref 17592186516315} {:answer/id #uuid "61602e33-9240-55e5-ae67-6253734db54b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3({s}^{2}+1)(2s+1)(2s-1)" :db/id #edb/ref 17592186516324} {:answer/id #uuid "6aecb389-d54f-575d-8a85-3c0beb8b5f30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4{s}^{2}+1)(3s+1)(3s-1)" :db/id #edb/ref 17592186516345} {:answer/id #uuid "8b8538c7-1b01-599b-b150-a73270292e7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4{s}^{2}+1)(2s+1)(2s-1)" :db/id #edb/ref 17592186516402} {:answer/id #uuid "924d5c59-cd65-56c5-8b49-dc5a89011fa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3(4{s}^{2}+1)(s+1)(s-1)" :db/id #edb/ref 17592186516418}] :answer-field/correct {:db/id #edb/ref 17592186516315} :answer-field/id #uuid "06afac61-4a09-516c-87cd-b89382f9efec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516651}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fb5ed83f-adbe-5177-b929-40e3c3c8ee7a" :question/math-academy-id "q-14126" :question/problem "Factor $48{s}^{4}-3$ completely." :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms have a common factor of $3.$ To simplify the computation, we can factor out the $3,$ as follows:\n\n$$\n48{s}^{4}-3=3\\cdot 16{s}^{4}-3\\cdot 1=3(16{s}^{4}-1)\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n3(16{s}^{4}-1)=3({(4{s}^{2})}^{2}-{1}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n3({(4{s}^{2})}^{2}-{1}^{2})=3(4{s}^{2}+1)(4{s}^{2}-1)\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}3(4{s}^{2}+1)(4{s}^{2}-1) & =3(4{s}^{2}+1)({(2s)}^{2}-{1}^{2}) \\\\  & =3(4{s}^{2}+1)(2s+1)(2s-1)\\end{aligned}\n$$"} :step/id #uuid "4a41bda9-95c5-593c-989d-c1491cb3adea" :step/next {:db/id #edb/ref 17592186516951}} {:db/id #edb/ref 17592186516951 :step/content {:db/id #edb/ref 17592186516798 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fbc1e55-9ff4-57db-a8d5-126770ed73c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4({z}^{2}-6)(z+9)" :db/id #edb/ref 17592186516361} {:answer/id #uuid "7e8855f8-54de-5296-8668-a577edca3ea7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({z}^{2}+9)(z+3)(z-3)" :db/id #edb/ref 17592186516380} {:answer/id #uuid "96436117-2f00-5b77-bdde-7a2e1ea0b5f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({z}^{2}+36)(z+3)(z-3)" :db/id #edb/ref 17592186516422} {:answer/id #uuid "a967a549-543c-5830-94ce-4a491fa889e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4({z}^{2}+36)(z+6)(z-6)" :db/id #edb/ref 17592186516466} {:answer/id #uuid "b4e023d2-5c4f-53c0-a51e-017f827fbd2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4({z}^{2}+9)(z+3)(z-3)" :db/id #edb/ref 17592186516488}] :answer-field/correct {:db/id #edb/ref 17592186516488} :answer-field/id #uuid "87c0e667-8c54-5839-81a6-2f3012b2915d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516716}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "47fb24d6-2403-53dd-8dbf-2b7132f71263" :question/math-academy-id "q-14131" :question/problem "Factor $4{z}^{4}-324$ completely." :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms have a common factor of $4.$ To simplify the computation, we can factor out the $4,$ as follows:\n\n$$\n4{z}^{4}-324=4\\cdot {z}^{4}-4\\cdot 81=4({z}^{4}-81)\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n4({z}^{4}-81)=4({({z}^{2})}^{2}-{9}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n4({({z}^{2})}^{2}-{9}^{2})=4({z}^{2}+9)({z}^{2}-9)\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}4({z}^{2}+9)({z}^{2}-9) & =4({z}^{2}+9)({z}^{2}-{3}^{2}) \\\\  & =4({z}^{2}+9)(z+3)(z-3)\\end{aligned}\n$$"} :step/id #uuid "b5c6c1ae-e998-5b44-ae1a-e0bdca81c356" :step/next {:db/id #edb/ref 17592186516959}} {:db/id #edb/ref 17592186516959 :step/content {:db/id #edb/ref 17592186516784 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26f80dbb-9c0a-50e9-af75-fd6ae25f77d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6(9+{x}^{2})(3-{x}^{2})" :db/id #edb/ref 17592186516189} {:answer/id #uuid "431be612-0a45-510a-bc8f-064d5eb3f4c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6(9+{x}^{2})(3+x)(3-x)" :db/id #edb/ref 17592186516245} {:answer/id #uuid "450499eb-16be-5929-9520-1f10e65a24ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9+{x}^{2})(3-{x}^{2})" :db/id #edb/ref 17592186516252} {:answer/id #uuid "8977d251-8b3b-5768-a493-f8eca8cc7e33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6(81+{x}^{4})" :db/id #edb/ref 17592186516399} {:answer/id #uuid "96da69d6-ce5d-553a-aa16-d9284a89737b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6(9+{x}^{2})(9+x)(9-x)" :db/id #edb/ref 17592186516424}] :answer-field/correct {:db/id #edb/ref 17592186516245} :answer-field/id #uuid "51b9c843-101e-597e-98f2-3448d699942e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516682}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1eed18c2-ffc9-58c2-a876-148bf6a4cade" :question/math-academy-id "q-14138" :question/problem "Factor $486-6{x}^{4}$ completely." :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms have a common factor of $6.$ To simplify the computation, we can factor out the $6,$ as follows:\n\n$$\n486-6{x}^{4}=6\\cdot 81-6\\cdot {x}^{4}=6(81-{x}^{4})\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n6(81-{x}^{4})=6({9}^{2}-{({x}^{2})}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n6({9}^{2}-{({x}^{2})}^{2})=6(9+{x}^{2})(9-{x}^{2})\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}6(9+{x}^{2})(9-{x}^{2}) & =6(9+{x}^{2})({3}^{2}-{x}^{2}) \\\\  & =6(9+{x}^{2})(3+x)(3-x)\\end{aligned}\n$$"} :step/id #uuid "c2abec83-36cb-5c3f-a653-14e58cea6968"}] :activity/title "Factoring Higher-Order Polynomials as a Difference of Squares" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516096}] [{:activity/first-step {:db/id #edb/ref 17592186055528} :activity/id #uuid "14506510-6a23-50e7-9f92-2d6a0e7b9372" :activity/scope {:db/id #edb/ref 17592186050782 :topic/id #uuid "66aee53c-aecf-5378-b318-bdc0930f5e43" :topic/math-academy-id 140} :activity/steps [{:db/id #edb/ref 17592186055528 :step/content {:db/id #edb/ref 17592186055964 :tutorial/content "It's possible to perform arithmetic with functions, just like with numbers. Shown below are the four arithmetic operations, addition $(+)$, subtraction $(-)$, multiplication $(\\cdot)$, and division $(/)$, applied to the functions\n\n$$\nf(x) = 4x + 1\n$$\n\nand\n\n$$\ng(x) = x - 2\n$$\n\n- **Addition**\n$\\begin{aligned} (f + g)(x) &= f(x) + g(x) \\\\ &= (4x + 1) + (x - 2) \\\\ &= 4x + 1 + x - 2 \\\\ &= 5x - 1 \\end{aligned}$\n- **Subtraction**\n$(f - g)(x)|= f(x) - g(x); = (4x + 1) - (x - 2); = 4x + 1 - x + 2; = 3x + 3$\n- **Multiplication**\n$(fg)(x)|= f(x)g(x); = (4x + 1)(x - 2); = 4x^{2} - 8x + x - 2; = 4x^{2} - 7x - 2$\n- **Division**\n$(f/g)(x)|= (f(x))/(g(x)); = \\frac{4x + 1}{x - 2}$\n\n**Note:** In the case of division, we must have that\n\n$$\ng(x)\\neq 0\n$$\n\nso that we avoid dividing by zero." :tutorial/id #uuid "c656d962-19ad-5e04-b117-fa8d0c9034b8" :tutorial/math-academy-id 2751 :tutorial/title "Introduction"} :step/id #uuid "10d1d758-8351-5c00-a262-8b57b04f8398" :step/math-academy-id 13680 :step/next {:db/id #edb/ref 17592186055531}} {:db/id #edb/ref 17592186055529 :step/content {:db/id #edb/ref 17592186054611 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054522 :question/id #uuid "9a523530-ec38-5df8-997f-2f94975eb87b" :question/math-academy-id "e-3912"} :knowledge-point/id #uuid "67b307f2-1d37-5741-8972-cbddae50c4c8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050818}] :knowledge-point/questions [{:db/id #edb/ref 17592186055326} {:db/id #edb/ref 17592186055350} {:db/id #edb/ref 17592186233436} {:db/id #edb/ref 17592186233437} {:db/id #edb/ref 17592186234092} {:db/id #edb/ref 17592186234198} {:db/id #edb/ref 17592186413864} {:db/id #edb/ref 17592186413865} {:db/id #edb/ref 17592186516773}] :knowledge-point/title "Finding the Product of Two Functions"} :step/id #uuid "725779d7-8771-596d-841c-0ca2dd5da761" :step/math-academy-id 13682 :step/next {:db/id #edb/ref 17592186055530}} {:db/id #edb/ref 17592186055530 :step/content {:db/id #edb/ref 17592186054612 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054523 :question/id #uuid "79c8f0a9-6f05-515f-abaa-553863402a06" :question/math-academy-id "e-3913"} :knowledge-point/id #uuid "55d291ea-d722-5852-9c3a-faaba8e6df3e" :knowledge-point/questions [{:db/id #edb/ref 17592186055327} {:db/id #edb/ref 17592186055459} {:db/id #edb/ref 17592186233401} {:db/id #edb/ref 17592186233410} {:db/id #edb/ref 17592186234199} {:db/id #edb/ref 17592186234201} {:db/id #edb/ref 17592186413866} {:db/id #edb/ref 17592186516817}] :knowledge-point/title "Evaluating the Quotient of Two Functions"} :step/id #uuid "c6da4ec9-5a2e-5037-ad6d-2b91d02a4fa0" :step/math-academy-id 13683} {:db/id #edb/ref 17592186055531 :step/content {:db/id #edb/ref 17592186054613 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054524 :question/id #uuid "c68e70d0-ccec-578a-96c1-7ed106aebc79" :question/math-academy-id "e-3914"} :knowledge-point/id #uuid "2aafd8db-c723-508f-9ea3-43881f0d9140" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048524}] :knowledge-point/questions [{:db/id #edb/ref 17592186055325} {:db/id #edb/ref 17592186055452} {:db/id #edb/ref 17592186233400} {:db/id #edb/ref 17592186233409} {:db/id #edb/ref 17592186234196} {:db/id #edb/ref 17592186234505} {:db/id #edb/ref 17592186234506}] :knowledge-point/title "Finding the Sum or Difference of Two Functions"} :step/id #uuid "722ef25c-0cfd-5916-9719-a70b3e79029b" :step/math-academy-id 13684 :step/next {:db/id #edb/ref 17592186055552}} {:db/id #edb/ref 17592186055551 :step/content {:db/id #edb/ref 17592186054628 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054544 :question/id #uuid "b6a4d0a8-f579-5d6d-ad74-59b68d2046e6" :question/math-academy-id "e-4162"} :knowledge-point/id #uuid "0e8b25b3-5cc4-51b7-8ff9-fc1773797ad4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652}] :knowledge-point/questions [{:db/id #edb/ref 17592186055450} {:db/id #edb/ref 17592186055458} {:db/id #edb/ref 17592186233434} {:db/id #edb/ref 17592186233435} {:db/id #edb/ref 17592186234197} {:db/id #edb/ref 17592186234260} {:db/id #edb/ref 17592186234261} {:db/id #edb/ref 17592186234407} {:db/id #edb/ref 17592186410421}] :knowledge-point/title "Evaluating the Sum or Difference of Two Functions"} :step/id #uuid "d9de7d87-ac26-5915-a421-2a3c6f706e14" :step/math-academy-id 15087 :step/next {:db/id #edb/ref 17592186055529}} {:db/id #edb/ref 17592186055552 :step/content {:db/id #edb/ref 17592186055971 :tutorial/content "When we're asked to evaluate the sum of two functions at a particular point, there are two methods that we can use. We could either evaluate both functions at the point and sum the results. Or, we could sum the two functions and then evaluate the result at the point.\n\nTo demonstrate, let's find the $(f+g)(1)$ for\n\n$$\nf(x) = x^2 -1\n$$\n\nand\n\n$$\ng(x) = 2x-3\n$$\n\nThe notation $(f+g)(x)$ means the sum of the functions $f(x)$ and $g(x)$.\n\n**Method 1**\n\nTo evaluate $(f + g)(1)$, we find $f(1)$ and $g(1)$, and then add the results:\n\nFirst, we find $f(1)$ and $g(1)$:\n\n$$\n\\begin{aligned}\nf(1) &= (1)^{2} - 1 = 0 \\\\\ng(1) &= 2(1) - 3 =-1\n\\end{aligned}\n$$\n\nNow, we add the results:\n\n$$\n\\begin{aligned}\n(f + g)(1) &= f(1) + g(1) \\\\\n&= 0 + (-1) \\\\\n&=-1\n\\end{aligned}\n$$\n\n**Method 2**\n\nFirst, we find $(f+g)(x)$ by adding the two functions:\n\n$$\n\\begin{aligned}\n(f + g)(x) &= (x^{2} - 1) + (2x - 3) \\\\\n&= x^{2} + 2x - 4\n\\end{aligned}\n$$\n\nNow, we evaluate $(f + g)(1)$:\n\n$$\n\\begin{aligned}\n(f + g)(1) &= (1)^{2} + 2(1) - 4 =-1\n\\end{aligned}\n$$\n\nBoth these methods work fine, but method $1$ is usually faster.\n\nFinally, note that we can evaluate the difference between two functions using the same methods." :tutorial/id #uuid "74671b66-6f9b-59a5-96e2-aeb7ca503afe" :tutorial/math-academy-id 2834 :tutorial/title "Evaluating the Sum or Difference of Two Functions"} :step/id #uuid "c0ba47b0-a276-56f7-965d-acc1c060fc97" :step/math-academy-id 15088 :step/next {:db/id #edb/ref 17592186055551}}] :activity/title "The Arithmetic of Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186054889}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186413867} :activity/id #uuid "034eac1a-9202-5b49-a5b1-6bfa6ac2f838" :activity/scope {:db/id #edb/ref 17592186050782 :topic/id #uuid "66aee53c-aecf-5378-b318-bdc0930f5e43" :topic/math-academy-id 140} :activity/steps [{:db/id #edb/ref 17592186413867 :step/content {:db/id #edb/ref 17592186055450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "191ed9fb-e1ea-5bef-892a-5baa90256a4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186413837} {:answer/id #uuid "2d90ba2d-f17e-5fdb-9818-2e1002340d59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186413838} {:answer/id #uuid "325859ee-224e-52c1-a505-c5197b9a6558" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186413839} {:answer/id #uuid "65020d93-ef32-58e5-bf24-738b6719f093" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186413841} {:answer/id #uuid "e7666301-e17b-5314-afdb-d7835e5ea1bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186413855}] :answer-field/correct {:db/id #edb/ref 17592186413841} :answer-field/id #uuid "b4da891c-9eb7-5195-a3f8-0ac1c8c6f04f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413861}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "23a164f0-a08a-5974-9621-a6231dc1af90" :question/math-academy-id "q-66137" :question/problem "Given $f(x)=2x+1$ and $g(x)=-3x+5,$ find $(f+g)(4).$" :question/worked-solution "The notation $(f+g)(x)$ means the sum of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f+g)(4),$ we find $f(4)$ and $g(4),$ and then add the results.\n\nFirst, we find $f(4)$ and $g(4):$\n\n$$\n\\begin{aligned}f(4) & =2(4)+1=9 \\\\ g(4) & =-3(4)+5=-7\\end{aligned}\n$$\n\n \n\nNow, we add the results:\n\n$$\n(f+g)(4)=f(4)+g(4)=9+(-7)=2\n$$\n\n**Method 2**\n\nFirst, we find $(f+g)(x)$ by adding the two functions:\n\n$$\n\\begin{aligned}(f+g)(x) & =(2x+1)+(-3x+5) \\\\  & =-x+6 \\\\  & =6-x\\end{aligned}\n$$\n\nNow, we evaluate $(f+g)(4):$\n\n$$\n\\begin{aligned}(f+g)(4) & =6-4=2\\end{aligned}\n$$"} :step/id #uuid "03bc34b4-7201-59a8-8931-1f1c21fe49e2" :step/next {:db/id #edb/ref 17592186413871}} {:db/id #edb/ref 17592186413868 :step/content {:db/id #edb/ref 17592186413866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ace236d-44ca-52a6-8858-d6e6168991a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186413836} {:answer/id #uuid "596e74cb-e10e-56ee-8a2b-0983ab1a5c46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186413840} {:answer/id #uuid "7494fadd-dd07-5f67-a41d-7917f368d4e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186413842} {:answer/id #uuid "e1f2e513-a3ca-5f51-9c1b-c18eeceadd98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186413853} {:answer/id #uuid "f632d377-ac04-57c7-af38-4a82afb34aaa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Undefined" :db/id #edb/ref 17592186413856}] :answer-field/correct {:db/id #edb/ref 17592186413856} :answer-field/id #uuid "5a311d46-6876-5cc8-bd29-ac82b7694535" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413860}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fe5aa5dd-14e3-52ea-8c5e-90aad88d589b" :question/math-academy-id "q-78620" :question/problem "Find  $(f/g)(-1)$  for $f(x)={x}^{2}+2x$ and $g(x)={x}^{2}+x.$" :question/worked-solution "The notation $(f/g)(x)$ means the quotient of the functions $f(x)$ and $g(x).$ \n\nTo evaluate $(f/g)(-1),$ we find $f(-1)$ and $g(-1),$ and then divide the results. \n\nFirst, we find $f(-1)$ and $g(-1):$\n\n$$\n\\begin{aligned}f(-1) & =(-1)^{2}+2(-1)=-1 \\\\ g(-1) & =(-1)^{2}+(-1)=0\\end{aligned}\n$$\n\n \n\nHowever, since the denominator of a fraction can't be zero, we can't divide $f(-1)$ by $g(-1).$\n\nTherefore, the value  $(f/g)(-1)$  is undefined."} :step/id #uuid "292a564d-1238-5079-b27b-a11f9ef4f0f1"} {:db/id #edb/ref 17592186413869 :step/content {:db/id #edb/ref 17592186413865 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84f34919-47cb-54fa-a488-9daaa920449b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "450" :db/id #edb/ref 17592186413844} {:answer/id #uuid "99c58b19-affa-5e56-ac31-b7ba0d67c4b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "120" :db/id #edb/ref 17592186413847} {:answer/id #uuid "d5863df3-ccee-5d78-a1f6-ffe664b5ed2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100" :db/id #edb/ref 17592186413850} {:answer/id #uuid "d88a8dac-6d79-5f3b-af46-b99926e48769" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "135" :db/id #edb/ref 17592186413851} {:answer/id #uuid "ff7784da-0b8b-5927-98d8-267858c58f6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "540" :db/id #edb/ref 17592186413858}] :answer-field/correct {:db/id #edb/ref 17592186413850} :answer-field/id #uuid "c6c5b78a-506e-5248-bf6a-b9065365cf86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413862}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e96a222d-7bc2-5df0-a9b1-bdb0a30abe0c" :question/math-academy-id "q-66422" :question/problem "Given $f(x)=4x-6$ and $g(x)=5x-10,$ find  $(fg)(4).$" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(4),$ we find $f(4)$ and $g(4),$ and then multiply the results.\n\nFirst, we find $f(4)$ and $g(4):$\n\n$$\n\\begin{aligned}f(4) & =4(4)-6=10 \\\\ g(4) & =5(4)-10=10\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(4)=f(4)g(4)=10\\cdot 10=100\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =(4x-6)(5x-10) \\\\  & =20{x}^{2}-70x+60\\end{aligned}\n$$\n\n \n\nNow, we evaluate $(fg)(4):$ \n\n$$\n\\begin{aligned}(fg)(4) & =20(4)^{2}-70(4)+60 \\\\  & =320-280+60 \\\\  & =100\\end{aligned}\n$$"} :step/id #uuid "8e2f3d8e-766a-5816-a6bd-fad48a7d5c1a" :step/next {:db/id #edb/ref 17592186413870}} {:db/id #edb/ref 17592186413870 :step/content {:db/id #edb/ref 17592186234199 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a971ff-a0ac-5e41-a6f9-de3fae7b9090" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186413834} {:answer/id #uuid "79f9695d-1add-50ce-be55-ea88b6f4de22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186413843} {:answer/id #uuid "970de561-023f-5e4a-8ecd-0cd2dba960b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186413846} {:answer/id #uuid "e137be1f-e344-5693-8401-73a72931c8a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186413852} {:answer/id #uuid "fb2ca1be-c620-54b9-9e8c-878f37709564" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186413857}] :answer-field/correct {:db/id #edb/ref 17592186413846} :answer-field/id #uuid "328f71c0-868a-51e6-9077-92f3e52307b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413859}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8d54abce-95cd-5dd9-be80-9f173369bea7" :question/math-academy-id "q-66425" :question/problem "Given $f(x)=2{x}^{2}-6$ and $g(x)=-2x+2,$ find  $(f/g)(3).$" :question/worked-solution "The notation $(f/g)(x)$ means the quotient of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f/g)(3),$ we find $f(3)$ and $g(3),$ and then divide the results.\n\nFirst, we find $f(3)$ and $g(3):$\n\n$$\n\\begin{aligned}f(3) & =2(3)^{2}-6=12 \\\\ g(3) & =-2(3)+2=-4\\end{aligned}\n$$\n\n \n\nNow, we divide the results:\n\n$$\n(f/g)(3)=\\frac{f(3)}{g(3)}=\\frac{12}{-4}=-3\n$$\n\n**Method 2**\n\nFirst, we find $(f/g)(x)$ by dividing $f$ by $g$:\n\n$$\n\\begin{aligned}(f/g)(x)=\\frac{2{x}^{2}-6}{-2x+2}\\end{aligned}\n$$\n\nNow, we evaluate $(f/g)(3):$ \n\n$$\n\\begin{aligned}(f/g)(3) & =\\frac{2(3)^{2}-6}{-2(3)+2}=\\frac{12}{-4}=-3\\end{aligned}\n$$"} :step/id #uuid "a4e39718-e05a-5c8f-b46d-8cb5708b44e2" :step/next {:db/id #edb/ref 17592186413868}} {:db/id #edb/ref 17592186413871 :step/content {:db/id #edb/ref 17592186413864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0624c52e-1d19-5b3b-ba86-d2f6b9cc8ef9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186413835} {:answer/id #uuid "881fa5d4-1c12-5bc5-a457-efc8e41af6ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "54" :db/id #edb/ref 17592186413845} {:answer/id #uuid "9a61e467-6a0c-55c5-bb23-f1d334a8e5d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186413848} {:answer/id #uuid "c363b46a-0dfe-5b02-aa34-a0ac7fb02ba1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "52" :db/id #edb/ref 17592186413849} {:answer/id #uuid "e3d08458-0ba1-59ee-877c-a0b12c255dc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186413854}] :answer-field/correct {:db/id #edb/ref 17592186413835} :answer-field/id #uuid "fb5f2ce0-c095-5ce3-be9e-db12b1e6fb29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186413863}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a8d2e394-0754-5534-a3fd-34ae3db4d32c" :question/math-academy-id "q-66348" :question/problem "Given $f(x)={x}^{2}+1$ and $g(x)=2x-1,$ find  $(fg)(3).$" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(3),$ we find $f(3)$ and $g(3),$ and then multiply the results.\n\nFirst, we find $f(3)$ and $g(3):$\n\n$$\n\\begin{aligned}f(3) & =(3)^{2}+1=10 \\\\ g(3) & =2(3)-1=5\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(3)=f(3)g(3)=10\\cdot 5=50\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =({x}^{2}+1)(2x-1) \\\\  & =2{x}^{3}-{x}^{2}+2x-1\\end{aligned}\n$$\n\nNow, we evaluate $(fg)(3):$ \n\n$$\n\\begin{aligned}(fg)(3) & =2(3)^{3}-(3)^{2}+2(3)-1 \\\\  & =54-9+6-1 \\\\  & =50\\end{aligned}\n$$"} :step/id #uuid "fc41b5fb-c1e3-5c52-a028-1ec2c66a6df0" :step/next {:db/id #edb/ref 17592186413869}}] :activity/title "The Arithmetic of Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186413833}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186516973} :activity/id #uuid "7ce49917-85e7-5228-8878-60a8c1f29960" :activity/scope {:db/id #edb/ref 17592186050782 :topic/id #uuid "66aee53c-aecf-5378-b318-bdc0930f5e43" :topic/math-academy-id 140} :activity/steps [{:db/id #edb/ref 17592186516933 :step/content {:db/id #edb/ref 17592186516773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cc163ae-67c3-5dbb-9c2e-df65985cece8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186516268} {:answer/id #uuid "5c4f1670-871c-59ee-8a82-19f3fd41d372" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186516308} {:answer/id #uuid "7d98d607-1295-57e0-82a2-4957c73eb6f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186516378} {:answer/id #uuid "b56a0556-d0b6-58d1-ae92-072bdafe84ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186516490} {:answer/id #uuid "c9da03d1-95db-5bd2-ac01-db50a9b70c37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186516538}] :answer-field/correct {:db/id #edb/ref 17592186516308} :answer-field/id #uuid "ff0d330b-f0bf-5ed3-9055-16241719d8a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516763}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0dffdb23-4e19-5e3b-9c5d-b76e7cdb23fa" :question/math-academy-id "q-66419" :question/problem "Given $f(x)=8{x}^{2}+1$ and $g(x)=2x-2,$ find  $(fg)(1).$" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(1),$ we find $f(1)$ and $g(1),$ and then multiply the results.\n\nFirst, we find $f(1)$ and $g(1):$\n\n$$\n\\begin{aligned}f(1) & =8(1)^{2}+1=9 \\\\ g(1) & =2(1)-2=0\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(1)=f(1)g(1)=9\\cdot 0=0\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =(8{x}^{2}+1)(2x-2) \\\\  & =16{x}^{3}-16{x}^{2}+2x-2\\end{aligned}\n$$\n\nNow, we evaluate $(fg)(1):$ \n\n$$\n\\begin{aligned}(fg)(1) & =16(1)^{3}-16(1)^{2}+2(1)-2 \\\\  & =16-16+2-2 \\\\  & =0\\end{aligned}\n$$"} :step/id #uuid "8915ea14-a53d-5e03-ae86-339fcc7361b9" :step/next {:db/id #edb/ref 17592186516963}} {:db/id #edb/ref 1