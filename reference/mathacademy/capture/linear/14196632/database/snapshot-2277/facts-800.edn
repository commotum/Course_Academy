41d8d4b" #edb/ref 17592186045417] [17592186105954 #edb/ref 1043 #edb/ref 17592186106917 #edb/ref 17592186045417] [17592186105954 #edb/ref 1043 #edb/ref 17592186106918 #edb/ref 17592186045417] [17592186105954 #edb/ref 1043 #edb/ref 17592186106919 #edb/ref 17592186045417] [17592186105954 #edb/ref 1043 #edb/ref 17592186106920 #edb/ref 17592186045417] [17592186105954 #edb/ref 1043 #edb/ref 17592186106921 #edb/ref 17592186045417] [17592186105954 #edb/ref 1043 #edb/ref 17592186106922 #edb/ref 17592186045417] [17592186105954 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186105954 #edb/ref 1045 "The Area of a General Triangle" #edb/ref 17592186045417] [17592186105954 #edb/ref 1046 #edb/ref 17592186106917 #edb/ref 17592186045417] [17592186105954 #edb/ref 1049 #edb/ref 17592186050149 #edb/ref 17592186045417] [17592186105954 #edb/ref 1050 720.0 #edb/ref 17592186045436] [17592186105954 #edb/ref 1053 #uuid "75a4e4a8-271a-52f6-80d3-a6bbb0833cfd" #edb/ref 17592186045417] [17592186106917 #edb/ref 1058 #edb/ref 17592186106918 #edb/ref 17592186045417] [17592186106917 #edb/ref 1061 463833 #edb/ref 17592186045417] [17592186106917 #edb/ref 1062 #uuid "e26490ba-2418-5a78-9c31-5425d1b67c42" #edb/ref 17592186045417] [17592186106917 #edb/ref 1063 #edb/ref 17592186107063 #edb/ref 17592186045417] [17592186106918 #edb/ref 1058 #edb/ref 17592186106919 #edb/ref 17592186045417] [17592186106918 #edb/ref 1061 463834 #edb/ref 17592186045417] [17592186106918 #edb/ref 1062 #uuid "ee7e485d-cba2-595c-b5bd-d8cd98cc7e04" #edb/ref 17592186045417] [17592186106918 #edb/ref 1063 #edb/ref 17592186105903 #edb/ref 17592186045417] [17592186106919 #edb/ref 1058 #edb/ref 17592186106920 #edb/ref 17592186045417] [17592186106919 #edb/ref 1061 463837 #edb/ref 17592186045417] [17592186106919 #edb/ref 1062 #uuid "ca664e6a-cebd-5079-927f-7fc062b9c6fd" #edb/ref 17592186045417] [17592186106919 #edb/ref 1063 #edb/ref 17592186105904 #edb/ref 17592186045417] [17592186106920 #edb/ref 1058 #edb/ref 17592186106921 #edb/ref 17592186045417] [17592186106920 #edb/ref 1061 463840 #edb/ref 17592186045417] [17592186106920 #edb/ref 1062 #uuid "ab2a0c05-ebeb-54b0-a9a3-b37d1f143e15" #edb/ref 17592186045417] [17592186106920 #edb/ref 1063 #edb/ref 17592186105905 #edb/ref 17592186045417] [17592186106921 #edb/ref 1058 #edb/ref 17592186106922 #edb/ref 17592186045417] [17592186106921 #edb/ref 1061 463843 #edb/ref 17592186045417] [17592186106921 #edb/ref 1062 #uuid "85b3474e-aa3e-5a9b-8c47-069d6e314fad" #edb/ref 17592186045417] [17592186106921 #edb/ref 1063 #edb/ref 17592186105906 #edb/ref 17592186045417] [17592186106922 #edb/ref 1061 463846 #edb/ref 17592186045417] [17592186106922 #edb/ref 1062 #uuid "29c5a503-b01d-5845-a29d-0bd76807b33f" #edb/ref 17592186045417] [17592186106922 #edb/ref 1063 #edb/ref 17592186107027 #edb/ref 17592186045417] [17592186107027 #edb/ref 1064 "Consider $\\triangle ABC$ with sides of lengths $a,b,$ and $c,$ as shown below.\n\n![](images/1d/1d30e12e2252b27a651bb02b718cf2214c7ddcf4f0e768c5bd952c11b2e4ecde.png)\n\nLet's now add the height of length $h$ perpendicular to $\\overline{BC},$ as shown.\n\n![](images/96/96817ab2168b9ec37777166a26001ee8bc7e7709f80fdf234ac6d70cdfbb5ddc.png)\n\nUsing the usual formula for the area $\\mathcal A$ of a triangle in terms of its base and height, we have\n\n$$\n\\mathcal A = \\dfrac12 ah.\n$$\n\nUsing elementary trigonometry, we have that\n\n$$\n\\dfrac{h}{b} = \\sin C\n$$\n\nwhich means that \n\n$$\nh = b\\sin C.\n$$\n\nTherefore, by substituting this into our expression for $\\mathcal A,$ we have\n\n$$\n\\mathcal A = \\dfrac12ab\\sin C\n$$\n\nas required.\n\nWe can use a similar approach to prove the following formulas:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}bc\\operatorname{sin}A \\\\ A & =\\frac{1}{2}ac\\operatorname{sin}B\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186107027 #edb/ref 1065 13277 #edb/ref 17592186045417] [17592186107027 #edb/ref 1066 #uuid "e126d83f-0c01-514b-bb7e-ce2d16291b22" #edb/ref 17592186045417] [17592186107027 #edb/ref 1067 "Deriving the Formula for the Area of a General Triangle" #edb/ref 17592186045417] [17592186107063 #edb/ref 1064 "The formula for the area of a general triangle is\n\n$$\n\\mathcal{A}=\\frac{1}{2}{\\color{red}{a}}{\\color{blue}{b}}\\sin{C},\n$$\n\nwhere $\\color{red}a$ and $\\color{blue}b$ are two sides of the triangle and $C$ is the measure of the angle between those sides (called the **included angle**).\n\nWe'll prove this result at the end of the lesson.\n\nTo demonstrate how this works, suppose that we want to calculate the area of the non-right-angled triangle below:\n\n![](images/4b/4b0fb75f9b2eaf3d0237d8cfe2e31bc27b02425b6cffa8d15f27d6de03f60838.png)\n\nLet's call the lengths of the sides $BC = \\color{red}{a}$ and $AC ={\\color{blue}{b}}.$ For the triangle above we have\n${\\color{red}a=10},$ ${\\color{blue}b=12},$ and  $m\\angle C=45^{\\circ}.$\n\nTherefore, the area of our triangle is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot 10\\cdot 12\\cdot \\operatorname{sin}{45}^{∘} \\\\  & =60\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =30\\sqrt{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186107063 #edb/ref 1065 2465 #edb/ref 17592186045417] [17592186107063 #edb/ref 1066 #uuid "ff9f9791-f688-59c5-8c9d-b776016045be" #edb/ref 17592186045417] [17592186107063 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186115088 #edb/ref 1069 "e-4973" #edb/ref 17592186045417] [17592186115088 #edb/ref 1071 "Plot the graph $y=f(x+2)$ for $y=f(x)$ given below.\n\n![](images/6c/6ca96bba855899f9b87ae06c166503c9af739fcd6bb2ec466a73b75cc70dde7f.png)" #edb/ref 17592186045417] [17592186115088 #edb/ref 1072 #uuid "e320a97a-d524-5225-895e-76034e599fa9" #edb/ref 17592186045417] [17592186115088 #edb/ref 1074 "The graph of\n\n$$\ny=f(x+2)\n$$\n\nis a horizontal translation of the graph of $y=f(x)$ by $2$ units to the *left*. So, every point on the graph of\n\n$$\ny=f(x+2)\n$$\n\nis two units *to the left* of the corresponding point on the graph of $y=f(x)$.\n\n![](images/75/758899a1abd5298429059016a4127db61eda014e8c46e0539e9226c5641e5ceb.png)" #edb/ref 17592186045417] [17592186115089 #edb/ref 1069 "e-4974" #edb/ref 17592186045417] [17592186115089 #edb/ref 1071 "The point $P$ with coordinates $(-2,0)$ lies on the curve $y=f(x)$. Find a point that must lie on $y=f(x-7)$." #edb/ref 17592186045417] [17592186115089 #edb/ref 1072 #uuid "4dec57af-1c02-56fe-b38e-e62795fdc93d" #edb/ref 17592186045417] [17592186115089 #edb/ref 1074 "The graph of $y=f(x-7)$ is a translation of the graph of $y=f(x)$ by $7$ units to the *right*. So the $y$-coordinate remains unchanged while the $x$-coordinate increases by $7$.\n\nWe know that the point $(-2,0)$ lies on $y=f(x)$. Therefore, the point\n\n$$\n(-2+7,0) = (5,0)\n$$\n\nmust lie on $y=f(x-7)$." #edb/ref 17592186045417] [17592186115090 #edb/ref 1069 "e-4975" #edb/ref 17592186045417] [17592186115090 #edb/ref 1071 "Plot the graph of $y=f(x+1)-2$ for $y=f(x)$ given below.\n\n![](images/38/3814318e7d04bf8457c0e5a9a5d563412bb6a988eda83fca84b8400ffea2a117.png)" #edb/ref 17592186045417] [17592186115090 #edb/ref 1072 #uuid "86b96055-a0e1-5dc7-9f89-364f77412a77" #edb/ref 17592186045417] [17592186115090 #edb/ref 1074 "To graph\n\n$$\ny=f(x+1)-2\n$$\n\nwe translate the graph of $y=f(x)$ by $1$ unit to the left and then $2$ units down.\n\n![](images/17/1744139728266d53c546e0b98452e042b8d099cebed12f5ee0a7c230257e9fa2.png)" #edb/ref 17592186045417] [17592186115103 #edb/ref 1069 "e-5229" #edb/ref 17592186045417] [17592186115103 #edb/ref 1071 "The point $P$ with coordinates $(1, 0)$ lies on the curve $y = f(x)$. What point must lie on $y=f(x + 1)+5$?" #edb/ref 17592186045417] [17592186115103 #edb/ref 1072 #uuid "740d5deb-3982-5293-9071-ddaaa189fb81" #edb/ref 17592186045417] [17592186115103 #edb/ref 1074 "The graph of\n\n$$\ny=f(x+1)+5\n$$\n\nis a translation of the graph of $y=f(x)$ by $1$ unit to the *left* and $5$ units up. So the $y$-coordinate increases by $5$ and the $x$-coordinate decreases by $1$.\n\nWe know that the point $P(1,0)$ lies on $y=f(x)$. Therefore, the point\n\n$$\n(1-1,0+5) = (0,5)\n$$\n\nmust lie on\n\n$$\ny=f(x+1)+5\n$$" #edb/ref 17592186045417] [17592186115259 #edb/ref 1037 #edb/ref 17592186050647 #edb/ref 17592186045417] [17592186115259 #edb/ref 1038 #edb/ref 17592186115506 #edb/ref 17592186045417] [17592186115259 #edb/ref 1038 #edb/ref 17592186115507 #edb/ref 17592186045417] [17592186115259 #edb/ref 1039 "Plotting a Horizontal Translation of a Given Graph" #edb/ref 17592186045417] [17592186115259 #edb/ref 1041 #edb/ref 17592186115088 #edb/ref 17592186045417] [17592186115259 #edb/ref 1042 #uuid "372e7248-7fe0-5138-896d-61b4866f83cd" #edb/ref 17592186045417] [17592186115260 #edb/ref 1038 #edb/ref 17592186115620 #edb/ref 17592186045417] [17592186115260 #edb/ref 1038 #edb/ref 17592186115622 #edb/ref 17592186045417] [17592186115260 #edb/ref 1039 "Finding a Corresponding Point on a Horizontally Translated Function" #edb/ref 17592186045417] [17592186115260 #edb/ref 1041 #edb/ref 17592186115089 #edb/ref 17592186045417] [17592186115260 #edb/ref 1042 #uuid "919da198-25e0-5b6f-8d99-79f1508759b9" #edb/ref 17592186045417] [17592186115261 #edb/ref 1038 #edb/ref 17592186115508 #edb/ref 17592186045417] [17592186115261 #edb/ref 1038 #edb/ref 17592186115509 #edb/ref 17592186045417] [17592186115261 #edb/ref 1038 #edb/ref 17592186233127 #edb/ref 17592186045417] [17592186115261 #edb/ref 1039 "Plotting Horizontal and Vertical Translations of a Given Graph" #edb/ref 17592186045417] [17592186115261 #edb/ref 1041 #edb/ref 17592186115090 #edb/ref 17592186045417] [17592186115261 #edb/ref 1042 #uuid "d7c84dd5-2c76-5584-81a1-53d2459afb94" #edb/ref 17592186045417] [17592186115274 #edb/ref 1038 #edb/ref 17592186115610 #edb/ref 17592186045417] [17592186115274 #edb/ref 1038 #edb/ref 17592186115621 #edb/ref 17592186045417] [17592186115274 #edb/ref 1039 "Finding a Corresponding Point on a Horizontally and Vertically Translated Function" #edb/ref 17592186045417] [17592186115274 #edb/ref 1041 #edb/ref 17592186115103 #edb/ref 17592186045417] [17592186115274 #edb/ref 1042 #uuid "57ef1e2c-07d4-5d04-9de8-8884cae17c00" #edb/ref 17592186045417] [17592186115418 #edb/ref 1043 #edb/ref 17592186116148 #edb/ref 17592186045417] [17592186115418 #edb/ref 1043 #edb/ref 17592186116149 #edb/ref 17592186045417] [17592186115418 #edb/ref 1043 #edb/ref 17592186116150 #edb/ref 17592186045417] [17592186115418 #edb/ref 1043 #edb/ref 17592186116151 #edb/ref 17592186045417] [17592186115418 #edb/ref 1043 #edb/ref 17592186116152 #edb/ref 17592186045417] [17592186115418 #edb/ref 1043 #edb/ref 17592186116174 #edb/ref 17592186045417] [17592186115418 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186115418 #edb/ref 1045 "Horizontal Translations of Functions" #edb/ref 17592186045417] [17592186115418 #edb/ref 1046 #edb/ref 17592186116148 #edb/ref 17592186045417] [17592186115418 #edb/ref 1049 #edb/ref 17592186048419 #edb/ref 17592186045417] [17592186115418 #edb/ref 1053 #uuid "abceb987-e559-5c80-8a21-441171253b50" #edb/ref 17592186045417] [17592186116148 #edb/ref 1058 #edb/ref 17592186116149 #edb/ref 17592186045417] [17592186116148 #edb/ref 1061 18017 #edb/ref 17592186045417] [17592186116148 #edb/ref 1062 #uuid "6345469f-1236-5eaf-8f5f-c51d47bf4f3c" #edb/ref 17592186045417] [17592186116148 #edb/ref 1063 #edb/ref 17592186116503 #edb/ref 17592186045417] [17592186116149 #edb/ref 1058 #edb/ref 17592186116150 #edb/ref 17592186045417] [17592186116149 #edb/ref 1061 18018 #edb/ref 17592186045417] [17592186116149 #edb/ref 1062 #uuid "d171b522-79a1-5dbc-bcf1-aa7179ecd080" #edb/ref 17592186045417] [17592186116149 #edb/ref 1063 #edb/ref 17592186115259 #edb/ref 17592186045417] [17592186116150 #edb/ref 1058 #edb/ref 17592186116151 #edb/ref 17592186045417] [17592186116150 #edb/ref 1061 18019 #edb/ref 17592186045417] [17592186116150 #edb/ref 1062 #uuid "b5c16920-e146-5ef0-841d-e2645a4e1de6" #edb/ref 17592186045417] [17592186116150 #edb/ref 1063 #edb/ref 17592186115260 #edb/ref 17592186045417] [17592186116151 #edb/ref 1058 #edb/ref 17592186116152 #edb/ref 17592186045417] [17592186116151 #edb/ref 1061 18020 #edb/ref 17592186045417] [17592186116151 #edb/ref 1062 #uuid "c6cc0af1-c408-599c-ac0a-69b7af985fac" #edb/ref 17592186045417] [17592186116151 #edb/ref 1063 #edb/ref 17592186116504 #edb/ref 17592186045417] [17592186116152 #edb/ref 1058 #edb/ref 17592186116174 #edb/ref 17592186045417] [17592186116152 #edb/ref 1061 18022 #edb/ref 17592186045417] [17592186116152 #edb/ref 1062 #uuid "b18fd01e-e160-5b17-a9cf-730b2b261357" #edb/ref 17592186045417] [17592186116152 #edb/ref 1063 #edb/ref 17592186115261 #edb/ref 17592186045417] [17592186116174 #edb/ref 1061 19261 #edb/ref 17592186045417] [17592186116174 #edb/ref 1062 #uuid "5cdd1f56-3cc3-5455-896a-aec5448b7269" #edb/ref 17592186045417] [17592186116174 #edb/ref 1063 #edb/ref 17592186115274 #edb/ref 17592186045417] [17592186116503 #edb/ref 1064 "In general, for $k>0$,\n\n- the graph of $y=f(x-k)$ is a horizontal translation of $y=f(x)$ by $k$ units to the *right*, while\n- the graph of $y=f(x+k)$ is a horizontal translation of $y=f(x)$ by $k$ units to the *left*.\n\n**Watch out!** It may seem counterintuitive that subtracting $k$ moves the graph to the right, while adding $k$ moves the graph to the left. However, this is in fact true.\n\nTo see why, let's consider the graph of $y=f(x)$ shown below. Let's use this graph to plot the graph of $y=f(x-2)$.\n\n![](images/6c/6ca96bba855899f9b87ae06c166503c9af739fcd6bb2ec466a73b75cc70dde7f.png)\n\nLet's take some points on the graph of $y=f(x)$ and find the corresponding points on the graphs of $y=f(x-2)$.\n\nFor example, take the point $(3,-4)$. The fact that it's on the graph of $y=f(x)$ means that\n\n$$\nf(3)=-4\n$$\n\nThen if\n\n$$\nx={\\color{red}5}\n$$\n\nwe have\n\n$$\nf(x-2) = f({\\color{red}5}-2) = f(3) = -4\n$$\n\nwhich means that $({\\color{red}5},-4)$ is on the graph of $y=f(x-2)$.\n\nFor each point on the graph of $y=f(x)$ there is a corresponding point on the graph of $y=f(x-2)$ with the same $y$-value and a $x$-value that is $2$ units *greater*! Several more examples of points are shown below.\n\n$$\n\\begin{bmatrix}Points on [math]y=f(x)[/math] & Points on [math]y=f(x-2)[/math] \\\\ (3,-4) & (5,-4) \\\\ (1, 2) & (3, 2) \\\\ (0, 1.5) & (2, 1.5) \\\\ (-2, 0) & (0, 0)\\end{bmatrix}\n$$\n\nNow, let's plot both curves.\n\n![](images/ed/edae088984432dc7d0fff816a9e016ad221a3c897a78cf79efe6c784fa9176fe.png)\n\nWe see that every point on the graph of $y=f(x-2)$ is shifted $2$ units *to the right* of the corresponding point on the graph of $y=f(x)$." #edb/ref 17592186045417] [17592186116503 #edb/ref 1065 3280 #edb/ref 17592186045417] [17592186116503 #edb/ref 1066 #uuid "da231b95-be14-58c3-a8fe-6261d61c7d83" #edb/ref 17592186045417] [17592186116503 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186116504 #edb/ref 1064 "When graphing a function, we can combine vertical and horizontal translations. In general, the graph of\n\n$$\ny = f(x-h)+k\n$$\n\nis a translation of the graph of $y=f(x)$ by $h$ units to the right and $k$ units up.\n\nIt doesn't matter which translation we do first, but it's often easiest to start with the horizontal translation." #edb/ref 17592186045417] [17592186116504 #edb/ref 1065 3282 #edb/ref 17592186045417] [17592186116504 #edb/ref 1066 #uuid "ceb4fcff-ae84-5217-aa0c-16d64fc23eac" #edb/ref 17592186045417] [17592186116504 #edb/ref 1067 "Combining Vertical and Horizontal Translations" #edb/ref 17592186045417] [17592186119567 #edb/ref 1069 "e-3155" #edb/ref 17592186045417] [17592186119567 #edb/ref 1071 "Construct a unit circle in the coordinate plane with a central angle of $105^\\circ$ in the standard position." #edb/ref 17592186045417] [17592186119567 #edb/ref 1072 #uuid "927b97a7-437e-5c46-b83d-1e8d2d62007e" #edb/ref 17592186045417] [17592186119567 #edb/ref 1074 "Recall that:\n\n- A unit circle has a radius of $1$ and is centered at the origin in the coordinate plane.\n- An angle in the standard position has its initial side on the positive $x$-axis, its vertex at the origin, and it rotates such that a positive angle is measured counter-clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](images/46/46e41d84cb00ea2a95f3d1c94e75863707fddf78ea7117de1ed415b71e66f2f1.png)" #edb/ref 17592186045417] [17592186119568 #edb/ref 1069 "e-3156" #edb/ref 17592186045417] [17592186119568 #edb/ref 1071 "Construct a unit circle in the coordinate plane with a central angle of $\\dfrac{2\\pi}{5}$ in the standard position." #edb/ref 17592186045417] [17592186119568 #edb/ref 1072 #uuid "02cd545d-7fde-520b-924e-5ff4f8e4244b" #edb/ref 17592186045417] [17592186119568 #edb/ref 1074 "To help us to visualize the angle, we first convert the measure of the angle into degrees.\n\nTo convert the measure of an angle in radians to an equivalent measure in degrees, we multiply the measure in radians by\n\n$$\n\\dfrac{180^\\circ}{\\pi}\n$$\n\nThis gives\n\n$$\n\\left(\\dfrac{2\\pi} 5\\right) \\cdot \\left(\\dfrac {180^\\circ} {\\pi}\\right) = 72^\\circ\n$$\n\nTherefore,\n\n$$\n\\dfrac{2\\pi}{5}\n$$\n\nis equivalent to $72^\\circ$.\n\nThen, we recall that:\n\n- A unit circle has a radius of $1$ and is centered at the origin in the coordinate plane.\n- An angle in the standard position has its initial side on the positive $x$-axis, its vertex at the origin, and it rotates such that a positive angle is measured counter-clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](images/64/6479f08add76d919644c8eba7df6bb1d273fd1de808d4af58876a6a5da539fcb.png)" #edb/ref 17592186045417] [17592186119569 #edb/ref 1069 "e-3157" #edb/ref 17592186045417] [17592186119569 #edb/ref 1071 "![](images/f0/f0347081906740a955f8a192baa53c65536b110df9adc6021288c43767c9ac2f.png)\n\nGiven that the point $A$ has coordinates $(\\sqrt 3, 1)$, calculate the angle $\\theta$." #edb/ref 17592186045417] [17592186119569 #edb/ref 1072 #uuid "50e22612-2f22-5c48-a2da-a6a0580375a5" #edb/ref 17592186045417] [17592186119569 #edb/ref 1074 "First, we can form a triangle by creating a vertical line from $A$ to the $x$-axis.\n\n![](images/3e/3e5ebde9ee4132e0bd64cb2aaf2a3763abc2b0de1a798e87ed4ee652ca360078.png)\n\nUsing the tangent ratio, we have\n\n$$\n\\tan\\theta = \\dfrac{1}{\\sqrt 3} = \\dfrac{\\sqrt 3}{3}\n$$\n\nFinally, using the inverse tangent, we get\n\n$$\n\\theta = \\arctan{\\left(\\dfrac{\\sqrt 3}{3} \\right)} = 30^\\circ\n$$" #edb/ref 17592186045417] [17592186119570 #edb/ref 1069 "e-3161" #edb/ref 17592186045417] [17592186119570 #edb/ref 1071 "How is the angle $150^\\circ$ normally represented in the coordinate plane?" #edb/ref 17592186045417] [17592186119570 #edb/ref 1072 #uuid "98f445f6-806d-5169-81f9-183b93e5bb94" #edb/ref 17592186045417] [17592186119570 #edb/ref 1074 "First, we recall that:\n\n- An angle in the standard position has its initial side on the positive $x$-axis, and its vertex is at the origin.\n- It rotates such that a positive angle is measured counter-clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](images/1d/1dcf96192164d9e1845207773d4fe9596ff3fd0d5fa7e83984260004e8bc32aa.png)" #edb/ref 17592186045417]}
