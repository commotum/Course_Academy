ref 17592186045417] [17592186064463 #edb/ref 1053 #uuid "85e998e2-3550-5179-9873-be08bc1ad3c7" #edb/ref 17592186045417] [17592186064979 #edb/ref 1058 #edb/ref 17592186065155 #edb/ref 17592186045417] [17592186064979 #edb/ref 1061 1040 #edb/ref 17592186045417] [17592186064979 #edb/ref 1062 #uuid "31d20aff-dfc8-5c40-ac4f-e90082ea3b22" #edb/ref 17592186045417] [17592186064979 #edb/ref 1063 #edb/ref 17592186065394 #edb/ref 17592186045417] [17592186064980 #edb/ref 1058 #edb/ref 17592186064981 #edb/ref 17592186045417] [17592186064980 #edb/ref 1061 1041 #edb/ref 17592186045417] [17592186064980 #edb/ref 1062 #uuid "16f4f430-8d96-53e9-8d8a-f9c5dacb8f75" #edb/ref 17592186045417] [17592186064980 #edb/ref 1063 #edb/ref 17592186064152 #edb/ref 17592186045417] [17592186064981 #edb/ref 1058 #edb/ref 17592186064982 #edb/ref 17592186045417] [17592186064981 #edb/ref 1061 1044 #edb/ref 17592186045417] [17592186064981 #edb/ref 1062 #uuid "53feca1f-08af-5384-9bcc-951619d23c04" #edb/ref 17592186045417] [17592186064981 #edb/ref 1063 #edb/ref 17592186064153 #edb/ref 17592186045417] [17592186064982 #edb/ref 1058 #edb/ref 17592186065156 #edb/ref 17592186045417] [17592186064982 #edb/ref 1061 1048 #edb/ref 17592186045417] [17592186064982 #edb/ref 1062 #uuid "ce4a6a9b-f1e7-5114-a5dd-312034e232c8" #edb/ref 17592186045417] [17592186064982 #edb/ref 1063 #edb/ref 17592186064154 #edb/ref 17592186045417] [17592186065025 #edb/ref 1058 #edb/ref 17592186065029 #edb/ref 17592186045417] [17592186065025 #edb/ref 1061 13972 #edb/ref 17592186045417] [17592186065025 #edb/ref 1062 #uuid "245d5026-e5bf-5aa1-a597-08d94f58a796" #edb/ref 17592186045417] [17592186065025 #edb/ref 1063 #edb/ref 17592186064184 #edb/ref 17592186045417] [17592186065027 #edb/ref 1061 13982 #edb/ref 17592186045417] [17592186065027 #edb/ref 1062 #uuid "7e554aac-e51a-56ed-97d6-d71fc9b2a0af" #edb/ref 17592186045417] [17592186065027 #edb/ref 1063 #edb/ref 17592186064186 #edb/ref 17592186045417] [17592186065028 #edb/ref 1058 #edb/ref 17592186065034 #edb/ref 17592186045417] [17592186065028 #edb/ref 1061 13983 #edb/ref 17592186045417] [17592186065028 #edb/ref 1062 #uuid "dcc23e94-3ee0-58a9-b2f0-f64588a9d011" #edb/ref 17592186045417] [17592186065028 #edb/ref 1063 #edb/ref 17592186064187 #edb/ref 17592186045417] [17592186065029 #edb/ref 1058 #edb/ref 17592186065028 #edb/ref 17592186045417] [17592186065029 #edb/ref 1061 13984 #edb/ref 17592186045417] [17592186065029 #edb/ref 1062 #uuid "7676fb8a-e4a5-5c86-861b-29726b6f4646" #edb/ref 17592186045417] [17592186065029 #edb/ref 1063 #edb/ref 17592186064188 #edb/ref 17592186045417] [17592186065034 #edb/ref 1058 #edb/ref 17592186065027 #edb/ref 17592186045417] [17592186065034 #edb/ref 1061 14167 #edb/ref 17592186045417] [17592186065034 #edb/ref 1062 #uuid "a24545f5-76c6-581e-99d9-e9b0034c2475" #edb/ref 17592186045417] [17592186065034 #edb/ref 1063 #edb/ref 17592186065351 #edb/ref 17592186045417] [17592186065043 #edb/ref 1058 #edb/ref 17592186065025 #edb/ref 17592186045417] [17592186065043 #edb/ref 1061 15296 #edb/ref 17592186045417] [17592186065043 #edb/ref 1062 #uuid "e9ebe7f3-c1dc-5c5b-9736-209a7e1ed0c3" #edb/ref 17592186045417] [17592186065043 #edb/ref 1063 #edb/ref 17592186065354 #edb/ref 17592186045417] [17592186065155 #edb/ref 1058 #edb/ref 17592186064980 #edb/ref 17592186045417] [17592186065155 #edb/ref 1061 22692 #edb/ref 17592186045417] [17592186065155 #edb/ref 1062 #uuid "591c3dff-1506-54a5-a8fe-829db67c140d" #edb/ref 17592186045417] [17592186065155 #edb/ref 1063 #edb/ref 17592186064271 #edb/ref 17592186045417] [17592186065156 #edb/ref 1061 22693 #edb/ref 17592186045417] [17592186065156 #edb/ref 1062 #uuid "90f0715b-ebb7-53b3-8e60-ab2cec7bd6e6" #edb/ref 17592186045417] [17592186065156 #edb/ref 1063 #edb/ref 17592186064272 #edb/ref 17592186045417] [17592186065250 #edb/ref 1058 #edb/ref 17592186065251 #edb/ref 17592186045417] [17592186065250 #edb/ref 1061 595 #edb/ref 17592186045417] [17592186065250 #edb/ref 1062 #uuid "35e9e9bc-7d8d-5422-a6d3-4890eb3c5548" #edb/ref 17592186045417] [17592186065250 #edb/ref 1063 #edb/ref 17592186065365 #edb/ref 17592186045417] [17592186065251 #edb/ref 1058 #edb/ref 17592186065252 #edb/ref 17592186045417] [17592186065251 #edb/ref 1061 596 #edb/ref 17592186045417] [17592186065251 #edb/ref 1062 #uuid "28874baa-b4bb-54af-b29b-a7cbfc639bc9" #edb/ref 17592186045417] [17592186065251 #edb/ref 1063 #edb/ref 17592186064337 #edb/ref 17592186045417] [17592186065252 #edb/ref 1058 #edb/ref 17592186065253 #edb/ref 17592186045417] [17592186065252 #edb/ref 1061 599 #edb/ref 17592186045417] [17592186065252 #edb/ref 1062 #uuid "2fde7718-a29e-5055-884f-3f58ca08aaec" #edb/ref 17592186045417] [17592186065252 #edb/ref 1063 #edb/ref 17592186065366 #edb/ref 17592186045417] [17592186065253 #edb/ref 1061 600 #edb/ref 17592186045417] [17592186065253 #edb/ref 1062 #uuid "af0ad9db-1ba6-5216-8e5f-5d768427a09e" #edb/ref 17592186045417] [17592186065253 #edb/ref 1063 #edb/ref 17592186064338 #edb/ref 17592186045417] [17592186065351 #edb/ref 1064 "What logarithmic equation is equivalent to the equation $\\sqrt{4} = 2 ?$\n\nNotice that the given equation can be written using exponents as\n\n$$\n4^{1/2} = 2.\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare $4^{1/2} = 2$ with $a = b^x,$ we get $a = 2, b = 4,$ and $x=\\dfrac{1}{2}.$\n\nTherefore, the equation $\\sqrt{4} = 2$ is equivalent to $\\log_{4}{2}= \\dfrac{1}{2}.$" #edb/ref 17592186045417] [17592186065351 #edb/ref 1065 2780 #edb/ref 17592186045417] [17592186065351 #edb/ref 1066 #uuid "689eb94a-47df-5cd0-9019-d100d1621193" #edb/ref 17592186045417] [17592186065351 #edb/ref 1067 "Converting Equations With Radicals Into Logarithmic Form" #edb/ref 17592186045417] [17592186065354 #edb/ref 1064 "A **logarithm** (or log) is an operation that's the *inverse* of exponentiation. \n\nFor example, we know that ${\\color{blue}{2}}^{\\color{red}{3}} = 8.$ But we can also write this using a logarithm as\n\n$$\n\\log_{\\color{blue}{2}}(8) = {\\color{red}{3}}.\n$$\n\nIn words, we would say \"log of $8$ with base ${\\color{blue}{2}}$ equals ${\\color{red}{3}}$\". The **base** of the logarithm is always the base of the exponential expression.\n\nSince exponents and logarithms are opposite operations, an exponential equation can always be expressed in logarithmic form, and vice versa.\n\nIn general, the logarithm of $a$ with positive base $b \\neq 1$ is defined as follows:\n\n$a = {\\color{blue}b}^{\\color{red}x}$ is equivalent to $\\log_{\\color{blue}b}{a} = {\\color{red}x}.$" #edb/ref 17592186045417] [17592186065354 #edb/ref 1065 2863 #edb/ref 17592186045417] [17592186065354 #edb/ref 1066 #uuid "4581c0d9-ad31-511c-a9d0-00d5ae0d5e38" #edb/ref 17592186045417] [17592186065354 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186065365 #edb/ref 1064 "The average rate of change of the function $y=f(x)$ on the interval $[a,a+h]$ is given by\n\n$$\n\\dfrac{\\Delta y}{\\Delta x} = \\dfrac{f(a+h) - f(a)}{h}\n$$\n\nThis can be interpreted as the slope of the secant line that intersects the curve at the points $\\color{blue}P$ and ${\\color{red}Q}$, as shown below.\n\n![](images/32/3264f0792cee452453b024a61fb6f58a45290e133d3f84ec1ecf1c14501b4423.png)\n\nThe **instantaneous rate of change** of the function $f(x)$ at the point $x = a$ is the limit of the average rate of change as $h \\to 0$. It is denoted by $f'(a)$ and given by\n\n$$\nf'(a) = \\lim_{h\\to 0}\\dfrac {f(a+h) - f(a)} {h}\n$$\n\nGeometrically, as $h \\to 0$, the point $\\color{red}Q$ moves along the curve $y=f(x)$ towards the point ${\\color{blue}P}$, and the secant transforms into the line that touches the curve at exactly one point $({\\color{blue}P})$. That line is called the **tangent line** to the curve $y=f(x)$ at the point $\\color{blue}P$.\n\n![](images/37/3704b7e4f7a7aec6245d3494ef1e59a2b863e74a50bf5c9ecf471eec3789e7e9.png)\n\nThe value of $f'(a)$ is equal to the slope of the tangent line to the curve $y=f(x)$ at $x=a$." #edb/ref 17592186045417] [17592186065365 #edb/ref 1065 322 #edb/ref 17592186045417] [17592186065365 #edb/ref 1066 #uuid "1f6bb245-1f46-5ade-84d4-6fd172b4b227" #edb/ref 17592186045417] [17592186065365 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186065366 #edb/ref 1064 "Another way of defining $f'(a)$ is\n\n$$\nf'(a) = \\lim_{x\\to a}\\dfrac {f(x) - f(a)} {x-a}\n$$\n\nWe arrive at this definition in the same way as before. But this time, we consider the interval $[a,x]$ instead of $[a,a+h]$, and then take the limit of the average rate of change as $x\\to a$.\n\n![](images/b4/b49c6bba1cb82227e7f47b2d1b91eae85ece94fd5251b79173842179cf7946e0.png)\n\nSometimes, this version is a bit easier to work with, so let's see an example of how to apply it. We should always arrive at the same answer regardless of which definition we use." #edb/ref 17592186045417] [17592186065366 #edb/ref 1065 324 #edb/ref 17592186045417] [17592186065366 #edb/ref 1066 #uuid "6731f995-584b-5424-a320-c41c218307f9" #edb/ref 17592186045417] [17592186065366 #edb/ref 1067 "An Equivalent Definition of Instantaneous Rate of Change" #edb/ref 17592186045417] [17592186065394 #edb/ref 1064 "Derivatives naturally occur in many real-world situations, so it's essential to know their units of measurement. The key is to remember that the derivative represents a rate of change.\n\nFor instance, suppose that the temperature of a pizza $t$ minutes after coming out of a hot oven is $T(t)$ degrees Fahrenheit. What are the units of $\\dfrac{\\textrm{d}T}{\\textrm{d}t}?$\n\nFirst, we have that the temperature $T(t)$ is measured in degrees Fahrenheit and the time $t$ is measured in minutes.\n\n$$\n\\begin{aligned}T(t): & \\text{degrees Fahrenheit} \\\\ t: & \\text{minutes}\\end{aligned}\n$$\n\nThe derivative $\\dfrac{\\textrm{d}\\color{black}T}{\\textrm{d}\\color{black}t}$ measures a change in ${\\color{black}T}$ over a change in ${\\color{black}t}.$ So, it represents a ratio of the units:\n\n$$\n\\begin{aligned}\\frac{\\text{d}T}{\\text{d}t}: & \\frac{\\text{degrees Fahrenheit}}{\\text{minutes}}\\end{aligned}\n$$\n\nTherefore, $\\dfrac{\\textrm{d}\\color{black}T}{\\textrm{d}\\color{black}t}$ is measured in \"degrees Fahrenheit per minute\", or $^\\circ \\textrm F / \\textrm {min}.$" #edb/ref 17592186045417] [17592186065394 #edb/ref 1065 552 #edb/ref 17592186045417] [17592186065394 #edb/ref 1066 #uuid "1a148fb4-165b-500a-b7e6-a3c9c2776ae8" #edb/ref 17592186045417] [17592186065394 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186068454 #edb/ref 1069 "e-1226" #edb/ref 17592186045417] [17592186068454 #edb/ref 1071 "Plot the graph of $y=\\left(\\dfrac{1}{4}\\right)^{x}-3.$" #edb/ref 17592186045417] [17592186068454 #edb/ref 1072 #uuid "da62e401-d03d-54fd-90b5-410d36bdefad" #edb/ref 17592186045417] [17592186068454 #edb/ref 1074 "First we plot the graph of $y=\\left(\\dfrac{1}{4}\\right)^{x}{:}$\n\n![](images/bf/bfe6ffc2b355b488899d29a827f779c60c13ca499312e0425c5b10b07057ed0b.png)\n\nTo sketch the graph of $y=\\left(\\dfrac{1}{4}\\right)^{x}-3,$ we take the graph of $y=\\left(\\dfrac{1}{4}\\right)^{x}$ and shift it $3$ units down. The $y$-intercept moves from $(0,1)$ to $(0,-2),$ and the horizontal asymptote moves from $y=0$ to $y=-3.$\n\n![](images/2c/2c002392e3cb165c295146c3e725ba5389fcf8c285f1c6ccaf7ae457b0f0ed46.png)" #edb/ref 17592186045417] [17592186068455 #edb/ref 1069 "e-1227" #edb/ref 17592186045417] [17592186068455 #edb/ref 1071 "Plot the graph of $y = 2\\left(\\dfrac{1}{5}\\right)^x + 1.$" #edb/ref 17592186045417] [17592186068455 #edb/ref 1072 #uuid "be6b6b07-c139-5ba2-b463-420a2ead54c8" #edb/ref 17592186045417] [17592186068455 #edb/ref 1074 "First, we plot the graph of $y = \\left(\\dfrac{1}{5}\\right)^x\\mathbin{:}$\n\n![](images/71/719e665784fe7ab17a0446e1ae1dae0d3acbcee30b8d4c5437003f9b93f954ce.png)\n\nNext, we plot the graph of $y = 2\\left(\\dfrac{1}{5}\\right)^x.$ To do this, we scale the graph above by a factor of $2.$ The $y$-intercept moves from $(0,1)$ to $(0,2)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/ac/acf747ec793e13f14b10232c90d9a7dde80cfd414c278bbf5034a903e74b5f05.png)\n\nFinally, we plot the graph of $y = 2\\left(\\dfrac{1}{5}\\right)^x + 1.$ To do this, we shift the above graph $1$ unit up. The $y$-intercept moves from $(0,2)$ to $(0,3),$ and the horizontal asymptote moves from $y=0$ to $y=1.$\n\n![](images/c3/c342bc5ec82b31bc9d6ae49d0ecc876f2796a29b7e6df2ee833d3c8723e713c9.png)" #edb/ref 17592186045417] [17592186068456 #edb/ref 1069 "e-1228" #edb/ref 17592186045417] [17592186068456 #edb/ref 1071 "The graph below shows the curve $y = k\\left(\\dfrac{1}{2}\\right)^{x}+c.$ Determine the values of $k$ and $c$ and find the equation of the curve.\n\n![](images/3b/3bf9fe67940a4257bad36511847e5cdb91974993e3be6d113dbc62dadd782134.png)" #edb/ref 17592186045417] [17592186068456 #edb/ref 1072 #uuid "5ab90279-394b-5df0-8bf3-a1042196b40c" #edb/ref 17592186045417] [17592186068456 #edb/ref 1074 "The horizontal asymptote of the curve $y=k\\left(\\dfrac{1}{2}\\right)^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-5$, hence $c=-5.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,-1),$ so we substitute $x=0$ and $y=-1$ into the function and solve for $k\\mathbin{:}$\n\n$$\n\\begin{aligned}k{(\\frac{1}{2})}^{x}+c & =y \\\\ k{(\\frac{1}{2})}^{x}-5 & =y \\\\ k{(\\frac{1}{2})}^{0}-5 & =-1 \\\\ k-5 & =-1 \\\\ k & =4\\end{aligned}\n$$\n\nTherefore, the equation of the curve is $y = 4\\left(\\dfrac{1}{2}\\right)^{x} - 5.$" #edb/ref 17592186045417] [17592186068519 #edb/ref 1069 "e-1587" #edb/ref 17592186045417] [17592186068519 #edb/ref 1071 "The graph below shows the curve $y=\\left( \\dfrac{1}{4} \\right)^{x} + c.$ Determine the value of $c$ and find the equation of the curve.\n\n![](images/25/257c44bbc3762968aee94b2612f489af9f2eda7eb8b5473d5d20f6f3f989cbc9.png)" #edb/ref 17592186045417] [17592186068519 #edb/ref 1072 #uuid "20a59278-1d09-5519-a362-4634ac9d5144" #edb/ref 17592186045417] [17592186068519 #edb/ref 1074 "The horizontal asymptote of $y = \\left( \\dfrac{1}{4} \\right)^x$ is $y = 0.$ \n\nThe vertical translation $y=\\left( \\dfrac{1}{4} \\right)^x+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=1.$ Therefore, $c=1.$" #edb/ref 17592186045417] [17592186068662 #edb/ref 1069 "e-916" #edb/ref 17592186045417] [17592186068662 #edb/ref 1071 "Jim has $\\[math]96$ in his pocket, which is two-thirds of the price of a particular book. How much does the book cost?" #edb/ref 17592186045417] [17592186068662 #edb/ref 1072 #uuid "62bd5b25-6b48-5e76-b338-cd4491d9341b" #edb/ref 17592186045417] [17592186068662 #edb/ref 1074 "First, let $x=$ the cost of the book, which is the unknown quantity we're trying to find.\n\nWe note that:\n\n- Jim has $\\[math]96$ in his pocket.\n- Two-thirds of the cost of the book corresponds to $\\dfrac{2}{3} x$.\n\nSince two-thirds of the cost of the book is *equal* to the amount of money that Jim has, the equation for $x$ is\n\n$$\n\\dfrac 2 3 x = 96\n$$\n\nWe can solve this equation using the multiplication principle:\n\n$$\n\\begin{aligned}\n\\frac{2}{3}x &= 96 \\\\\n\\frac{3}{2} \\cdot \\frac{2}{3}x &= \\frac{3}{2} \\cdot 96 \\\\\nx &= 144\n\\end{aligned}\n$$\n\nTherefore, the book costs $\\[/math]144$." #edb/ref 17592186045417] [17592186068663 #edb/ref 1069 "e-918" #edb/ref 17592186045417] [17592186068663 #edb/ref 1071 "Triple a number is $40$ greater than one-third of that number. Find the number." #edb/ref 17592186045417] [17592186068663 #edb/ref 1072 #uuid "7f14ed31-f9b6-554a-8dff-34fa5d646335" #edb/ref 17592186045417] [17592186068663 #edb/ref 1074 "Let $x=$ the number we are being asked to find.\n\nWe note that:\n\n- Triple the number corresponds to $3x$.\n- One-third of the number corresponds to $\\dfrac{x}{3}$.\n\nNow, we link both expressions using the fact that the triple the number is $40$ greater than one-third of the number, which corresponds to the equation\n\n$$\n3x= \\dfrac{x}{3} + 40\n$$\n\nWe solve the equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned} 3x &= \\dfrac{x}{3} + 40 \\\\[5pt] 3 \\cdot 3x &= 3 \\cdot \\left(\\dfrac{x}{3} + 40 \\right) \\\\[5pt] 9x &= 3 \\cdot \\dfrac{x}{3} + 3 \\cdot 40 \\\\[5pt] 9x &= x + 120 \\\\[5pt] 9x - x &= x + 120 - x \\\\[5pt] 8x &= 120 \\\\[5pt] \\dfrac{8x}{8} &= \\dfrac{120}{8} \\\\[5pt] x &= 15 \\end{aligned}\n$$\n\nTherefore, the number we are interested in is $15$." #edb/ref 17592186045417] [17592186068668 #edb/ref 1069 "e-9612" #edb/ref 17592186045417] [17592186068668 #edb/ref 1071 "A math test has $10$ questions, and each correct answer is worth $3$ points. To calculate the final grade, the teacher first subtracts the number of incorrect answers from the total points obtained from the correct answers. Then, she divides the previous result by $3$.\nIf Ron gets a final grade of $6$, how many questions did he answer correctly?" #edb/ref 17592186045417] [17592186068668 #edb/ref 1072 #uuid "f989a0c3-225e-52d6-bb79-1cdfe79746c5" #edb/ref 17592186045417] [17592186068668 #edb/ref 1074 "Let $x=$ the number of questions Ron answered correctly, which is the unknown quantity we're trying to find.\n\nWe note that:\n\n- The total number of points obtained from the correct answers is $3x$.\n- The number of incorrect answers is $10-x$.\n- The teacher subtracts the number of incorrect answers from the total points obtained from the correct answers, which gives\n$3x-(10-x) = 3x-10+x=4x-10$.\n- Then, the teacher divides the number obtained above by $3$. So, the final grade is\n$\\dfrac{4x-10}{3}$.\n\nRon's final grade is $6$. So, we have the equation\n\n$$\n\\dfrac{4x-10}{3} = 6\n$$\n\nWe can solve this equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}\n\\frac{4x - 10}{3} &= 6 \\\\\n3 \\cdot \\frac{4x - 10}{3} &= 3 \\cdot 6 \\\\\n4x - 10 &= 18 \\\\\n4x - 10 + 10 &= 18 + 10 \\\\\n4x &= 28 \\\\\nx &= 7\n\\end{aligned}\n$$\n\nThus, Ron answered $7$ questions correctly." #edb/ref 17592186045417] [17592186068809 #edb/ref 1037 #edb/ref 17592186048673 #edb/ref 17592186045417] [17592186068809 #edb/ref 1037 #edb/ref 17592186048925 #edb/ref 17592186045417] [17592186068809 #edb/ref 1038 #edb/ref 17592186069200 #edb/ref 17592186045417] [17592186068809 #edb/ref 1038 #edb/ref 17592186069264 #edb/ref 17592186045417] [17592186068809 #edb/ref 1038 #edb/ref 17592186235516 #edb/ref 17592186045417] [17592186068809 #edb/ref 1039 "Modeling Using Linear Equations With One Variable Term" #edb/ref 17592186045417] [17592186068809 #edb/ref 1041 #edb/ref 17592186068662 #edb/ref 17592186045417] [17592186068809 #edb/ref 1042 #uuid "d806fdb4-05d2-5b37-afe9-78a9c2b53ac1" #edb/ref 17592186045417] [17592186068810 #edb/ref 1037 #edb/ref 17592186048213 #edb/ref 17592186045417] [17592186068810 #edb/ref 1038 #edb/ref 17592186069181 #edb/ref 17592186045417] [17592186068810 #edb/ref 1038 #edb/ref 17592186069201 #edb/ref 17592186045417] [17592186068810 #edb/ref 1038 #edb/ref 17592186512892 #edb/ref 17592186045417] [17592186068810 #edb/ref 1039 "Modeling Using Linear Equations With Two Variable Terms" #edb/ref 17592186045417] [17592186068810 #edb/ref 1041 #edb/ref 17592186068663 #edb/ref 17592186045417] [17592186068810 #edb/ref 1042 #uuid "30abea2b-3b0e-5d3f-88c3-deb7c9ada4c8" #edb/ref 17592186045417] [17592186068822 #edb/ref 1037 #edb/ref 17592186048760 #edb/ref 17592186045417] [17592186068822 #edb/ref 1038 #edb/ref 17592186069039 #edb/ref 17592186045417] [17592186068822 #edb/ref 1038 #edb/ref 17592186069265 #edb/ref 17592186045417] [17592186068822 #edb/ref 1039 "Modeling Using Equations Containing One Fractional Term" #edb/ref 17592186045417] [17592186068822 #edb/ref 1041 #edb/ref 17592186068668 #edb/ref 17592186045417] [17592186068822 #edb/ref 1042 #uuid "f9db4b54-14b4-55be-8d05-0a7a7e33315e" #edb/ref 17592186045417] [17592186068829 #