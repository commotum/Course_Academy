#{[17592186147463 #edb/ref 1038 #edb/ref 17592186147753 #edb/ref 17592186045417] [17592186147463 #edb/ref 1038 #edb/ref 17592186148100 #edb/ref 17592186045417] [17592186147463 #edb/ref 1038 #edb/ref 17592186234163 #edb/ref 17592186045417] [17592186147463 #edb/ref 1039 "Finding the Common Ratio Given Some Additional Information About the Geometric Sequence" #edb/ref 17592186045417] [17592186147463 #edb/ref 1041 #edb/ref 17592186147229 #edb/ref 17592186045417] [17592186147463 #edb/ref 1042 #uuid "4df9158c-01a9-5596-9528-6033296b2925" #edb/ref 17592186045417] [17592186147611 #edb/ref 1037 #edb/ref 17592186048698 #edb/ref 17592186045417] [17592186147611 #edb/ref 1037 #edb/ref 17592186050585 #edb/ref 17592186045417] [17592186147611 #edb/ref 1038 #edb/ref 17592186147891 #edb/ref 17592186045417] [17592186147611 #edb/ref 1038 #edb/ref 17592186147899 #edb/ref 17592186045417] [17592186147611 #edb/ref 1039 "Naming Prisms" #edb/ref 17592186045417] [17592186147611 #edb/ref 1041 #edb/ref 17592186147290 #edb/ref 17592186045417] [17592186147611 #edb/ref 1042 #uuid "e8fd3c2c-3340-50df-a95c-3b82f165a071" #edb/ref 17592186045417] [17592186147612 #edb/ref 1038 #edb/ref 17592186147914 #edb/ref 17592186045417] [17592186147612 #edb/ref 1038 #edb/ref 17592186147915 #edb/ref 17592186045417] [17592186147612 #edb/ref 1038 #edb/ref 17592186414711 #edb/ref 17592186045417] [17592186147612 #edb/ref 1038 #edb/ref 17592186414712 #edb/ref 17592186045417] [17592186147612 #edb/ref 1039 "Identifying Non-Polyhedra" #edb/ref 17592186045417] [17592186147612 #edb/ref 1041 #edb/ref 17592186147291 #edb/ref 17592186045417] [17592186147612 #edb/ref 1042 #uuid "b9d83422-a877-5de8-bc55-2c7aae9eeb72" #edb/ref 17592186045417] [17592186147615 #edb/ref 1038 #edb/ref 17592186147897 #edb/ref 17592186045417] [17592186147615 #edb/ref 1038 #edb/ref 17592186147900 #edb/ref 17592186045417] [17592186147615 #edb/ref 1038 #edb/ref 17592186414713 #edb/ref 17592186045417] [17592186147615 #edb/ref 1038 #edb/ref 17592186495110 #e