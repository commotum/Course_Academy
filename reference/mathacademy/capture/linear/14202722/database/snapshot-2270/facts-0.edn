ef 1075 #edb/ref 17592186519384 #edb/ref 17592186045417] [17592186519445 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186519445 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186519445 #edb/ref 1078 #edb/ref 17592186519340 #edb/ref 17592186045417] [17592186519445 #edb/ref 1079 #uuid "6151e229-0e35-564f-8d7f-5b331c2a89a6" #edb/ref 17592186045417] [17592186519489 #edb/ref 1075 #edb/ref 17592186519030 #edb/ref 17592186045417] [17592186519489 #edb/ref 1075 #edb/ref 17592186519032 #edb/ref 17592186045417] [17592186519489 #edb/ref 1075 #edb/ref 17592186519046 #edb/ref 17592186045417] [17592186519489 #edb/ref 1075 #edb/ref 17592186519234 #edb/ref 17592186045417] [17592186519489 #edb/ref 1075 #edb/ref 17592186519288 #edb/ref 17592186045417] [17592186519489 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186519489 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186519489 #edb/ref 1078 #edb/ref 17592186519030 #edb/ref 17592186045417] [17592186519489 #edb/ref 1079 #uuid "c2dfe4a5-5448-5650-8cd1-67d2d7210c41" #edb/ref 17592186045417] [17592186519499 #edb/ref 1075 #edb/ref 17592186519262 #edb/ref 17592186045417] [17592186519499 #edb/ref 1075 #edb/ref 17592186519352 #edb/ref 17592186045417] [17592186519499 #edb/ref 1075 #edb/ref 17592186519389 #edb/ref 17592186045417] [17592186519499 #edb/ref 1075 #edb/ref 17592186519406 #edb/ref 17592186045417] [17592186519499 #edb/ref 1075 #edb/ref 17592186519409 #edb/ref 17592186045417] [17592186519499 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186519499 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186519499 #edb/ref 1078 #edb/ref 17592186519409 #edb/ref 17592186045417] [17592186519499 #edb/ref 1079 #uuid "db460c81-b20d-5e16-92de-4539fa40eda4" #edb/ref 17592186045417] [17592186519521 #edb/ref 1068 #edb/ref 17592186519499 #edb/ref 17592186045417] [17592186519521 #edb/ref 1069 "q-12244" #edb/ref 17592186045417] [17592186519521 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186519521 #edb/ref 1071 "Find $\\frac{\\text{d}y}{\\text{d}x}$ when $y=\\frac{1}{\\sqrt{x}}.$" #edb/ref 17592186045417] [17592186519521 #edb/ref 1072 #uuid "0cf33d77-f213-525d-99fb-8b9182428af7" #edb/ref 17592186045417] [17592186519521 #edb/ref 1074 "Writing the radical as a rational exponent, we have\n\n$$\n\\begin{aligned}y & =\\frac{1}{\\sqrt{x}}=\\frac{1}{{x}^{1/2}}={x}^{-1/2}.\\end{aligned}\n$$\n\nApplying the power rule with $n=-\\frac{1}{2},$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{-1/2}) \\\\  & =-\\frac{1}{2}{x}^{-1/2\\,-1} \\\\  & =-\\frac{1}{2}{x}^{-3/2} \\\\  & =-\\frac{1}{2{x}^{3/2}} \\\\  & =-\\frac{1}{2\\sqrt{{x}^{3}}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186519554 #edb/ref 1068 #edb/ref 17592186519445 #edb/ref 17592186045417] [17592186519554 #edb/ref 1069 "q-47827" #edb/ref 17592186045417] [17592186519554 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186519554 #edb/ref 1071 "Find ${f}^{′}(x)$ if $f(x)=-100.$" #edb/ref 17592186045417] [17592186519554 #edb/ref 1072 #uuid "7712c3e1-7e39-5f21-96a2-73fbade1bb33" #edb/ref 17592186045417] [17592186519554 #edb/ref 1074 "Since $f(x)$ is constant, its derivative is zero. Therefore, ${f}^{′}(x)=0.$" #edb/ref 17592186045417] [17592186519576 #edb/ref 1068 #edb/ref 17592186519489 #edb/ref 17592186045417] [17592186519576 #edb/ref 1069 "q-102182" #edb/ref 17592186045417] [17592186519576 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186519576 #edb/ref 1071 "Find ${f}^{′}(x)$ if $f(x)=\\frac{1}{e}.$" #edb/ref 17592186045417] [17592186519576 #edb/ref 1072 #uuid "adc818d6-3be7-557c-93b2-e7ce26f749ac" #edb/ref 17592186045417] [17592186519576 #edb/ref 1074 "Since $f(x)$ is constant, its derivative is zero. Therefore, ${f}^{′}(x)=0.$" #edb/ref 17592186045417] [17592186519637 #edb/ref 1058 #edb/ref 17592186519660 #edb/ref 17592186045417] [17592186519637 #ed