chy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>10</mn><mi>u</mi></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>10</mn><mrow><mn>3</mn><mo>−</mo><mn>2</mn><mi>x</mi></mrow></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
