#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186093122} :activity/id #uuid "4d6a31ac-41c5-5814-8574-33c8d7e8a0e1" :activity/scope {:db/id #edb/ref 17592186049332 :topic/id #uuid "ec784b83-0c82-5c6a-9dd1-3880cd96d4cb" :topic/math-academy-id 1036} :activity/steps [{:db/id #edb/ref 17592186093122 :step/content {:db/id #edb/ref 17592186093370 :tutorial/content "The chain rule can be used to differentiate logarithmic functions like \n\n$$\ny = \\ln (2x+1).\n$$\n\nFirst notice that this function can be written as the composite function\n\n$$\ny = \\ln u, \\qquad u = 2x+1.\n$$\n\nWe can use the chain rule to compute the derivative of this composite function:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}u)\\cdot \\frac{\\text{d}}{\\text{d}x}(2x+1) \\\\  & =\\frac{1}{u}\\cdot 2 \\\\  & =\\frac{2}{u}\\end{aligned}\n$$\n\nSubstituting $u=2x+1,$ we obtain the final result:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2}{2x+1}\\end{aligned}\n$$" :tutorial/id #uuid "054d5bfc-280f-5da5-9576-4b4cd8668e78" :tutorial/math-academy-id 1272 :tutorial/title "Introduction"} :step/id #uuid "e409fa6f-b896-5f75-a481-3ece75fb28d5" :step/math-academy-id 2500 :step/next {:db/id #edb/ref 17592186093123}} {:db/id #edb/ref 17592186093123 :step/content {:db/id #edb/ref 17592186092264 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092120 :question/id #uuid "5d2c0fff-c9af-5e8a-846a-640878f08283" :question/math-academy-id "e-730"} :knowledge-point/id #uuid "b4ac7f7e-1e07-57d7-a82a-d6545588c2de" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050690} {:db/id #edb/ref 17592186051084}] :knowledge-point/question-generator {:db/id #edb/ref 17592186490412} :knowledge-point/questions [{:db/id #edb/ref 17592186092514} {:db/id #edb/ref 17592186092677} {:db/id #edb/ref 17592186233100} {:db/id #edb/