#{[{:db/id #edb/ref 17592186092120 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092264 :knowledge-point/id #uuid "b4ac7f7e-1e07-57d7-a82a-d6545588c2de" :knowledge-point/title "Differentiating a Natural Logarithm Function Using the Chain Rule"}] :question/id #uuid "5d2c0fff-c9af-5e8a-846a-640878f08283" :question/math-academy-id "e-730" :question/problem "Find the derivative of $f(x) = \\ln(x^2-4).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf = \\ln u, \\qquad u = x^2-4.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d f}{\\textrm d u} = \\dfrac{1}{u},\\qquad \\dfrac{\\textrm{d}u}{\\textrm d x} = 2x.\n$$\n\nWe now apply the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{u}\\cdot 2x \\\\  & =\\frac{1}{{x}^{2}-4}\\cdot 2x \\\\  & =\\frac{2x}{{x}^{2}-4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092122 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186092265 :knowledge-point/id #uuid "a9102c1c-1c38-58dd-9932-b04bd24a6846" :knowledge-point/title "Differentiating a General Logarithm Function Using the Chain Rule"}] :question/id #uuid "7df7fed3-c172-5cc2-aca8-abd31a0902a0" :question/math-academy-id "e-731" :question/problem "If ![](images/6b/6b4554ae23fd7bb02a3dbeda7d55c342b4f30f07b57133739709048d5bfce44a.png) what is ![](images/1e/1e6f1dc22671990b694ea0386dcdcdd843ea819101a3be99a6c5378d10c5c993.png)" :question/worked-solution "First, we express ![](images/52/523ba398cc130edb20b50aa7b9a5deab0a53e4222824e3deda7f1a13ac7b0a56.png) as the composite function\n\n![](images/7d/7dc97a419c76db6b88c0862e2e54d20062ca6501657bc260eb1c478a5ad1b9eb.png)\n\nDifferentiating gives\n\n![](images/c2/c27f0454bd599e68525a774e3e0989a7ee7da4eb82701d6e918ffa334c615916.png)\n\nWe now apply the chain rule, and get\n\n![](images/70/70aaf32dd29ad000b81dcff6e4b155fe6358e923d4d1f485f71aff511233c15b.png)"}] [{:db/id #edb/ref 17592186092732 :knowledge-point/_questions [{:db/id #edb/ref 17592186092265 :knowledge-point/id #uuid "a9102c1c-1c38-58dd-9932-b04bd24a6846" :knowledge-point/title "Differentiating a General Logarithm Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e532d43-a23a-5221-b598-16e29eefa128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5)/((2x - 5)\\ln 3)" :db/id #edb/ref 17592186090593} {:answer/id #uuid "e4cc404d-6ac6-59bd-b154-17d86cfb7fe4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1)/((5x - 2)\\ln 5)" :db/id #edb/ref 17592186090594} {:answer/id #uuid "eb2d8c39-6a30-5e08-bf62-540ea07321bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5)/((5x - 2)\\ln 5)" :db/id #edb/ref 17592186090595} {:answer/id #uuid "f1e559ed-7a2e-5408-b30e-928c5a51cf46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5)/((5x - 2)\\ln 3)" :db/id #edb/ref 17592186090596} {:answer/id #uuid "f2b482c8-0149-5f27-baee-354b3b6597f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5)/((5x - 2))" :db/id #edb/ref 17592186090597}] :answer-field/id #uuid "80eb6a81-e7b7-57ed-8210-04192f46d9f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090592}] :question/id #uuid "6612d2f1-5666-54fd-9c5c-1217f3a2dfe0" :question/math-academy-id "q-48008" :question/problem "Calculate $\\frac{dy}{dx}$ for $y = \\log_{3} (5x - 2)$."}]}
