648" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-14" :db/id #edb/ref 17592186492652}] :answer-field/correct {:db/id #edb/ref 17592186492652} :answer-field/id #uuid "cef39244-d4ac-5c09-b904-ef69c6554e61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492789}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "46b75057-d4db-5536-a016-1c597f33ff13" :question/math-academy-id "q-25403" :question/problem "If $x=-9$ then $-|x-12|+7=$" :question/worked-solution "We substitute $x=-9$ and then evaluate the absolute value before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}-|x-12|+7 & = \\\\ -|-9-12|+7 & = \\\\ -|-21|+7 & = \\\\ -21+7 & = \\\\ -14\\end{aligned}\n$$"} :step/id #uuid "f304f3f8-e188-5590-8410-c6b111d1b2ca" :step/next {:db/id #edb/ref 17592186492973}}] :activity/title "Absolute Value Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186492217}]}
