nswer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186492238} {:answer/id #uuid "23606116-0c3d-57f4-9d18-6b22a6023384" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186492290} {:answer/id #uuid "a1fdf384-9dc0-54c1-8ead-ad298d903b8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186492542} {:answer/id #uuid "cabd6727-7e51-5b45-af79-5c74ca0fead2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186492621} {:answer/id #uuid "fb1e9546-e023-51f6-b4d3-475e7aee4ad8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186492700}] :answer-field/correct {:db/id #edb/ref 17592186492238} :answer-field/id #uuid "cc5e42ce-3f11-5ff2-b5ec-1401d70485f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186492787}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "63dd321a-10a4-552c-a65d-35ddf70e7775" :question/math-academy-id "q-61447" :question/problem "If $x=-2$ then $|x+3|-|3x-1|+x=$" :question/worked-solution "We substitute $x=-2$ and then evaluate the absolute values before we simplify the rest of the expression:\n\n$$\n\\begin{aligned}|x+3|-|3x-1|+x & = \\\\ |-2+3|-|3(-2)-1|+(-2) & = \\\\ |1|-|-6-1|-2 & = \\\\ |1|-|-7|-2 & = \\\\ 1-7-2 & = \\\\ -8 & \\end{aligned}\n$$"} :step/id #uuid "99842b79-76db-5fb3-bbaf-66d05b3bbff6" :step/next {:db/id #edb/ref 17592186492988}} {:db/id #edb/ref 17592186492988 :step/content {:db/id #edb/ref 17592186492854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d45f977-a56a-5280-89d6-5518e60df5dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186492275} {:answer/id #uuid "59218a65-4882-5870-b7c8-86f2679e51b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186492393} {:answer/id #uuid "9f2ed906-5