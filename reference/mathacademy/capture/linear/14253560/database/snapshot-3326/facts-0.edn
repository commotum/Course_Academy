186045417] [17592186051043 #edb/ref 1035 #uuid "7cda6484-cda1-5805-8a40-963bb1a60fdf" #edb/ref 17592186045417] [17592186128407 #edb/ref 1075 #edb/ref 17592186128408 #edb/ref 17592186045417] [17592186128407 #edb/ref 1075 #edb/ref 17592186128409 #edb/ref 17592186045417] [17592186128407 #edb/ref 1075 #edb/ref 17592186128410 #edb/ref 17592186045417] [17592186128407 #edb/ref 1075 #edb/ref 17592186128411 #edb/ref 17592186045417] [17592186128407 #edb/ref 1075 #edb/ref 17592186128412 #edb/ref 17592186045417] [17592186128407 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186128407 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186128407 #edb/ref 1079 #uuid "d7806ea4-bf1f-5b40-aeaa-ce0c2da56b1c" #edb/ref 17592186045417] [17592186128408 #edb/ref 1080 "\\sin θ =-\\frac{3\\sqrt{3}}{2}" #edb/ref 17592186045417] [17592186128408 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186128408 #edb/ref 1083 #uuid "ac781d3b-86af-59b2-b331-dd52889c2bc0" #edb/ref 17592186045417] [17592186128409 #edb/ref 1080 "\\sin θ =-\\frac{1}{\\sqrt{3}}" #edb/ref 17592186045417] [17592186128409 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186128409 #edb/ref 1083 #uuid "c2a14b30-7e32-57c4-9916-890617f1346b" #edb/ref 17592186045417] [17592186128410 #edb/ref 1080 "\\sin θ = \\frac{\\sqrt{3}}{3}" #edb/ref 17592186045417] [17592186128410 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186128410 #edb/ref 1083 #uuid "e265a541-ae07-500b-ab4d-9566c6c756dc" #edb/ref 17592186045417] [17592186128411 #edb/ref 1080 "\\sin θ = \\sqrt{3}" #edb/ref 17592186045417] [17592186128411 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186128411 #edb/ref 1083 #uuid "1324f3b0-80c5-53e5-954f-ef2018f940c5" #edb/ref 17592186045417] [17592186128412 #edb/ref 1080 "\\sin θ =-\\frac{\\sqrt{3}}{2}" #edb/ref 17592186045417] [17592186128412 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186128412 #edb/ref 1083 #uuid "60164d0c-5faf-5bf4-ac47-cae6570067fa" #edb/ref 17592186045417] [17592186128894 #edb/ref 1069 "e-3479" #edb/ref 17592186045417] [17592186128894 #edb/ref 1071 "The point $P$ is located in the second quadrant and lies on the unit circle. \nThe $y$-coordinate of $P$ is $\\dfrac{\\sqrt 2}{2}.$ What is the $x$-coordinate of $P?$" #edb/ref 17592186045417] [17592186128894 #edb/ref 1072 #uuid "323261a0-d9c6-587b-93bf-b2e831893af5" #edb/ref 17592186045417] [17592186128894 #edb/ref 1074 "Since the point $P$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\nx^2+y^2=1 .\n$$\n\nSubstituting $y=\\dfrac{\\sqrt 2}{2}$ into the above and solving for $x,$ we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {x}^{2}+{(\\frac{\\sqrt{2}}{2})}^{2} & =1 \\\\ {x}^{2}+\\frac{1}{2} & =1 \\\\ {x}^{2} & =1-\\frac{1}{2} \\\\ {x}^{2} & =\\frac{1}{2} \\\\ x & =\\pm \\sqrt{\\frac{1}{2}} \\\\ x & =\\pm \\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nFinally, we select the negative answer since $x$ is negative in the second quadrant. Therefore, $x = -\\dfrac{\\sqrt{2}}{2}.$" #edb/ref 17592186045417] [17592186128895 #edb/ref 1069 "e-3481" #edb/ref 17592186045417] [17592186128895 #edb/ref 1071 "![](images/22/2262bdc869d10cef3cc7a779365f5afa0eb712676a397e39d248c813b305cbf0.png)\n\nThe diagram above shows the unit circle. Given that $\\sin\\theta=-\\dfrac{3}{4},$ what is the value of $\\cos \\theta?$" #edb/ref 17592186045417] [17592186128895 #edb/ref 1072 #uuid "a8e5384a-5baa-537f-9ec0-c775026f98d5" #edb/ref 17592186045417] [17592186128895 #edb/ref 1074 "We can use the Pythagorean identity to find $\\cos\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\sin\\theta = -\\dfrac{3}{4}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(-\\frac{3}{4})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{9}{16}} \\\\  & =\\pm \\sqrt{\\frac{7}{16}} \\\\  & =\\pm \\frac{\\sqrt{7}}{4}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\cos\\theta$ is negative in the third quadrant. So, $\\cos\\theta = -\\dfrac {\\sqrt {7}}{4}.$" #edb/ref 17592186045417] [17592186128896 #edb/ref 1069 "e-3483" #edb/ref 17592186045417] [17592186128896 #edb/ref 1071 "![](images/0c/0c29b3961f3e1178f0c82680ca3f67904e57b6fe2cc8b887f09926fcf6c2149a.png)\n\nThe diagram above shows the unit circle. Given that $\\sin\\theta=-\\dfrac{\\sqrt 3}{2},$ what is the value of $\\tan\\theta?$" #edb/ref 17592186045417] [17592186128896 #edb/ref 1072 #uuid "97f55dee-3f6b-5c1f-a901-b391ab37a0df" #edb/ref 17592186045417] [17592186128896 #edb/ref 1074 "We can use the Pythagorean identity to find $\\cos\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\sin\\theta = -\\dfrac{\\sqrt 3}{2}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(-\\frac{\\sqrt{3}}{2})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{3}{4}} \\\\  & =\\pm \\sqrt{\\frac{1}{4}} \\\\  & =\\pm \\frac{1}{2}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\cos\\theta$ is positive in the fourth quadrant. So, $\\cos\\theta = \\dfrac 1 2.$\n\nFinally, knowing that $\\tan\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta},$ we have\n\n$$\n\\tan\\theta = \\dfrac{\\left(-\\dfrac{\\sqrt 3}{2}\\right)}{\\left(\\dfrac{1}{2}\\right)} =-\\sqrt 3.\n$$" #edb/ref 17592186045417] [17592186128897 #edb/ref 1069 "e-3486" #edb/ref 17592186045417] [17592186128897 #edb/ref 1071 "![](images/0e/0e88dc5962fc5bd128c0de5502e8dcd1edf34353de1d31c2d8a21ac672633644.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $-\\dfrac{\\sqrt 3}{2},$ what is $\\csc\\theta?$" #edb/ref 17592186045417] [17592186128897 #edb/ref 1072 #uuid "cfe7b419-9067-5b8c-b9c2-d4ec91120333" #edb/ref 17592186045417] [17592186128897 #edb/ref 1074 "We're given that $x=-\\dfrac{\\sqrt 3}{2}$ at the point $P.$ Therefore, we have\n\n$$\n\\cos\\theta = -\\dfrac{\\sqrt 3}{2}.\n$$\n\nWe can use the Pythagorean identity to find $\\sin\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\cos\\theta = -\\dfrac{\\sqrt 3}{2}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(-\\frac{\\sqrt{3}}{2})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{3}{4}} \\\\  & =\\pm \\sqrt{\\frac{1}{4}} \\\\  & =\\pm \\frac{1}{2}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\sin\\theta$ is negative in the third quadrant. So, $\\sin\\theta = -\\dfrac 1 2.$\n\nFinally, knowing that $\\csc\\theta = \\dfrac{1}{\\sin\\theta},$ we have\n\n$$\n\\csc\\theta = \\dfrac{1}{\\left(-\\dfrac{1}{2}\\right)} =-2.\n$$" #edb/ref 17592186045417] [17592186129080 #edb/ref 1037 #edb/ref 17592186050714 #edb/ref 17592186045417] [17592186129080 #edb/ref 1038 #edb/ref 17592186129558 #edb/ref 17592186045417] [17592186129080 #edb/ref 1038 #edb/ref 17592186129559 #edb/ref 17592186045417] [17592186129080 #edb/ref 1038 #edb/ref 17592186259737 #edb/ref 17592186045417] [17592186129080 #edb/ref 1038 #edb/ref 17592186259738 #edb/ref 17592186045417] [17592186129080 #edb/ref 1038 #edb/ref 17592186259740 #edb/ref 17592186045417] [17592186129080 #edb/ref 1038 #edb/ref 17592186290450 #edb/ref 17592186045417] [17592186129080 #edb/ref 1039 "Applying the Pythagorean Theorem to the Unit Circle" #edb/ref 17592186045417] [17592186129080 #edb/ref 1041 #edb/ref 17592186128894 #edb/ref 17592186045417] [17592186129080 #edb/ref 1042 #uuid "021e3349-c54d-55a8-9095-902bba933660" #edb/ref 17592186045417] [17592186129081 #edb/ref 1037 #edb/ref 17592186051043 #edb/ref 17592186045417] [17592186129081 #edb/ref 1038 #edb/ref 17592186129564 #