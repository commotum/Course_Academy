#{[{:activity/first-step {:db/id #edb/ref 17592186106957} :activity/id #uuid "bd3c7493-58ee-57a8-8d3a-3cd07eb7026e" :activity/scope {:db/id #edb/ref 17592186049350 :topic/id #uuid "edfb49a6-b5b4-5d01-815a-215980c21139" :topic/math-academy-id 1378} :activity/steps [{:db/id #edb/ref 17592186106833 :step/content {:db/id #edb/ref 17592186105858 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105436 :question/id #uuid "a9ca2de5-c0ad-5bba-a432-0e62fdcd7d9c" :question/math-academy-id "e-10583"} :knowledge-point/id #uuid "d9e4943a-72d7-545e-b746-3a19ee6d3a83" :knowledge-point/questions [{:db/id #edb/ref 17592186106047} {:db/id #edb/ref 17592186106051} {:db/id #edb/ref 17592186424814}] :knowledge-point/title "Identifying Segments and Their Notation"} :step/id #uuid "3a8029d6-f569-5e02-94f4-a8c43054eba8" :step/math-academy-id 40003} {:db/id #edb/ref 17592186106834 :step/content {:db/id #edb/ref 17592186105859 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105437 :question/id #uuid "acae6ded-25d0-5ed3-bd39-8c81ecd9a4d3" :question/math-academy-id "e-10603"} :knowledge-point/id #uuid "3f50316d-ff00-53a1-af3a-fedd68e91f43" :knowledge-point/questions [{:db/id #edb/ref 17592186106049} {:db/id #edb/ref 17592186106050}] :knowledge-point/title "Identifying Rays and Their Notation"} :step/id #uuid "79e005c1-44a4-5a62-80df-af13329c4744" :step/math-academy-id 40094 :step/next {:db/id #edb/ref 17592186106836}} {:db/id #edb/ref 17592186106835 :step/content {:db/id #edb/ref 17592186107135 :tutorial/content "A **ray** is similar to a line but has a starting point and extends infinitely in one direction only. An example of a ray is shown below.\n\n![](images/75/750aef546281b34fef8e9aef61c1260894128138022e971d6c19dfd834cfa1e2.png)\n\nA ray that starts at the point $P$ and passes through a point $Q$ is expressed as\n$\\overset{\\longrightarrow}{PQ}$.\n\nWe use the \"$\\longrightarrow$\" symbol to denote that the line extends forever in **one** direction. Notice that the arrow's tail is above the starting point $P$.\n\nSimilar to lines, rays have no width but are infinite in length." :tutorial/id #uuid "74865d26-a257-5d2d-a7cd-537189af9954" :tutorial/math-academy-id 6647 :tutorial/title "Rays"} :step/id #uuid "0bee6a5d-8341-54c8-b8a6-8740368cff99" :step/math-academy-id 40242 :step/next {:db/id #edb/ref 17592186106834}} {:db/id #edb/ref 17592186106836 :step/content {:db/id #edb/ref 17592186107136 :tutorial/content "A **segment** is part of a line bounded by two points, called the **endpoints** of the segment. An example of a segment is shown below.\n\n![](images/6f/6f0d8c12318cc57412be73f2cfb077efa5b06472554e75be41af233c87a9ab17.png)\n\nA segment with endpoints $A$ and $B$ is denoted $\\overline{AB}$." :tutorial/id #uuid "ee97c2fb-0c77-5af6-b979-587c04a1f0c9" :tutorial/math-academy-id 6648 :tutorial/title "Segments"} :step/id #uuid "4f3e9956-cbc9-58f4-8ef4-625ad217137b" :step/math-academy-id 40243 :step/next {:db/id #edb/ref 17592186106833}} {:db/id #edb/ref 17592186106957 :step/content {:db/id #edb/ref 17592186107041 :tutorial/content "In this lesson, we'll discuss some fundamental objects in geometry. The objects we'll discuss are some of the building blocks we use to describe all geometrical objects.\n\nA **point** is an exact location in space. It has no size (i.e., no length, width, or depth), only position. A point is indicated with a dot usually labeled with a capital letter (e.g., $P$, $Q$, $S$,...), as shown below.\n\n![](images/ac/aceb9052aee93f2d7ef5cfc3f6a9c7ace291e6c9525751a2d826c0fbfa0b36ed.png)\n\nA **line** is a straight object that is infinitely long and has no width. We can think of it as an infinite collection of points, extending infinitely in both directions. A line has no endpoints!\n\nLet's take a look at the following line.\n\n![](images/86/861fbcc84e4e293379616a5e18d9073ecfdf4af5f6d17dece22196d332b62899.png)\n\nA line that passes through the points $P$ and $Q$ is expressed as\n$\\overset{\\longleftrightarrow}{PQ}$.\n\nWe use the \"$\\longleftrightarrow$\" symbol to denote that the line extends forever in **both** directions.\n\nLines can also be indicated with lowercase letters. For example:\n\n![](images/0a/0a2d566ad6126527f4b1a2b5a992688a668b9ff901c6b7716381521a576a0594.png)" :tutorial/id #uuid "a6361854-d380-59ab-8f5c-a64142f383c8" :tutorial/math-academy-id 2161 :tutorial/title "Introduction"} :step/id #uuid "5170c6de-909a-58ce-863d-4886baeefb53" :step/math-academy-id 8689 :step/next {:db/id #edb/ref 17592186106958}} {:db/id #edb/ref 17592186106958 :step/content {:db/id #edb/ref 17592186105925 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105520 :question/id #uuid "569e004c-b3c0-5389-9942-fd6dbcad046e" :question/math-academy-id "e-2540"} :knowledge-point/id #uuid "8db8b0ae-1a2a-546a-884d-bdf773c75483" :knowledge-point/questions [{:db/id #edb/ref 17592186106048} {:db/id #edb/ref 17592186106528}] :knowledge-point/title "Identifying Lines and Their Notation"} :step/id #uuid "8ecf8f9e-5978-5c97-8a02-ed6688aea1aa" :step/math-academy-id 8690 :step/next {:db/id #edb/ref 17592186106835}}] :activity/title "Points, Lines, Rays, and Segments" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106005}]}
