  "html": "<div id=\"step-e2540\" class=\"step\" style=\"display: block;\">\n    \n                 \n                <div class=\"example\">\n                    <div class=\"stepHeader\">\n                        <div class=\"stepName\"><span class=\"stepType\">Example:</span> Identifying Lines and Their Notation</div>       \n                        <div class=\"helpButton\" stepid=\"e2540\">?</div>\n                    </div>\n            \n                    <div class=\"exampleQuestion\">\n                        <p>What is the correct way to represent the line shown below?</p>\n<div id=\"graphic-f83a4f61ec1de2dd4022a31b686809a1\" class=\"graphic\"><img src=\"/graphics/f83a4f61ec1de2dd4022a31b686809a1\"></div>\n                    </div>     \n            \n                    <div class=\"exampleExplanationHeader\">EXPLANATION</div>\n            \n                    <div class=\"exampleExplanation\">\n                        <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                         