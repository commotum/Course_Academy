#{[{:db/id #edb/ref 17592186073587 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073898 :knowledge-point/id #uuid "1d9b6948-92f4-58b3-8c06-fae61765dc57" :knowledge-point/title "Finding the Horizontal Distance Between Two Points"}] :question/id #uuid "fb5d2269-5350-5d79-9414-1a25caa48d8c" :question/math-academy-id "e-2647" :question/problem "What is the distance between the points $(2,4)$ and $(5,4)$?\n\n![](images/ce/ce70a8122559f67aac379349fb369e6e7e007e85fa8a13632e7865469804fb6a.png)" :question/worked-solution "**Method 1**\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $3$ units, so the distance equals $3$.\n\n![](images/bd/bd568e789e79574225dbd75e79d4cacb2fbf92beb048f5bdafeb67f74ab029f6.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis and then subtracting.\n\n![](images/fb/fb2f075f8321aca3823770e28a86a8d9532cb343ba4239f94c2fb9d1cc883b0b.png)\n\nThe point $({\\color{blue}{5}},4)$ is at a distance of $\\color{blue}{5}$ from the $y$-axis, and the point $({\\color{red}{2}},4)$ is at a distance of $\\color{red}{2}$ from the $y$-axis. Therefore, the distance between the two points is\n\n$$\n{\\color{blue}{5}} - {\\color{red}{2}} = 3\n$$"}] [{:db/id #edb/ref 17592186073588 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073899 :knowledge-point/id #uuid "f0708cd3-0608-5d57-ac14-4c16ef362473" :knowledge-point/title "Finding the Vertical Distance Between Two Points"}] :question/id #uuid "1250785a-1ae3-5218-925a-0eac01281f3f" :question/math-academy-id "e-2648" :question/problem "What is the distance between the points $(-4,-2)$ and $(-4,-5)$?" :question/worked-solution "**Method 1**\n\nWe plot the given points in the coordinate plane.\n\n![](images/0d/0d26dd64fad1809f58fecdf802a28b5ab6d1dd201b63dc0bb9293f248a127a85.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $3$ units, so the distance equals $3$.\n\n![](images/fb/fbc52312edf77508a9d7436acd515bc91e3225826c16b85c3571143c39886771.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/80/80be7ec0ed67ce819b51b34f7a50aeb51786e3a6ca9190b418b2ec96e127cc78.png)\n\nThe point $(-4,{\\color{red}{-5}})$ is at a distance of $\\color{red}{5}$ from the $x$-axis, and the point $(-4,{\\color{blue}{-2}})$ is at a distance of $\\color{blue}{2}$ from the $x$-axis. Therefore, the distance between the two points is\n\n$$\n{\\color{red}{5}} - {\\color{blue}{2}} = 3\n$$"}] [{:db/id #edb/ref 17592186073589 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186073900 :knowledge-point/id #uuid "83bbdad9-c2a5-5caa-a4e9-2a0c904c605b" :knowledge-point/title "Finding the Distance Between Two Points: Crossing the Axis"}] :question/id #uuid "e05457af-60c5-519f-935e-db465fc76efa" :question/math-academy-id "e-2649" :question/problem "What is the distance between the points $(3,4)$ and $(3,-3)$?" :question/worked-solution "**Method 1**\n\nWe plot the given points in the coordinate plane.\n\n![](images/47/47f203755bf0abcbf33be636331e4f9c0119c14620f1a658be31db0d6feeed17.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $7$ units, so the distance equals $7$.\n\n![](images/79/79b944cc0d1af7577282653e3250af844ad10256bb3b6cf2b204ed2f9862d480.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then adding.\n\n![](images/94/94a5e438b160ce6f3dca0f44fd418a8831c520543e7dad605ea23674500af5fd.png)\n\nThe point $(3,{\\color{blue}{4}})$ is at a distance of $\\color{blue}{4}$ from the $x$-axis, and the point $(3,{\\color{red}{-3}})$ is at a distance of $\\color{red}{3}$ from the $x$-axis. Therefore, the distance between the two points is\n\n$$\n{\\color{red}{3}} + {\\color{blue}{4}} = 7\n$$"}] [{:db/id #edb/ref 17592186074463 :knowledge-point/_questions [{:db/id #edb/ref 17592186073898 :knowledge-point/id #uuid "1d9b6948-92f4-58b3-8c06-fae61765dc57" :knowledge-point/title "Finding the Horizontal Distance Between Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99bbbe13-1322-5cb0-8f12-7065d1258de5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186073017} {:answer/id #uuid "c0512d3c-56c3-5055-9993-dcf06393a97a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186073018} {:answer/id #uuid "dd4160ab-1a74-594e-9448-a710a64bef27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186073019} {:answer/id #uuid "ecfd8232-33f6-5d16-9a7d-a7a461437db4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186073020} {:answer/id #uuid "41ff1f31-6eae-5f24-a23d-4f22c91a2635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186073021}] :answer-field/id #uuid "52a925aa-86a7-54db-95bd-cc39a130bdbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186073016}] :question/id #uuid "712b5b48-ffde-5377-995f-99ec67963db8" :question/math-academy-id "q-61101" :question/problem "![](images/91/91babd6196f0a16bcaf052af27218e9e96ef5bc3d49c0ea46014ac9ba9737b86.png)\n\nWhat is the distance between the points $(1, 3)$ and $(5, 3)$?"}] [{:db/id #edb/ref 17592186074467 :knowledge-point/_questions [{:db/id #edb/ref 17592186073899 :knowledge-point/id #uuid "f0708cd3-0608-5d57-ac14-4c16ef3