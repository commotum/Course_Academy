      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14262965/observations/step-q105399-cfc27f469f14b973c7f4.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14262965/observations/step-q105399-cfc27f469f14b973c7f4.png",
