#{[{:db/id #edb/ref 17592186128922 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129110 :knowledge-point/id #uuid "8aab5653-c3ec-5b4e-b56f-53393955d641" :knowledge-point/title "Applying the Power of Product Rule"}] :question/id #uuid "5c179a8e-55f3-5be7-8e97-b54287ea23e3" :question/math-academy-id "e-4668" :question/problem "Express $(3\\times 2)^2$ as the product of two powers." :question/worked-solution "To raise the product of two numbers to the power of $2$, we can raise each number to the power of $2$, and then multiply:\n\n$$\n(3\\times 2)^2=3^2\\times 2^2\n$$"}] [{:db/id #edb/ref 17592186128923 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129111 :knowledge-point/id #uuid "525486fb-d976-57a5-b6bd-c33f19177a3f" :knowledge-point/title "Applying the Power of Product Rule to Expressions with Fractions"}] :question/id #uuid "ee165665-5cf3-5343-bae6-9080a887fcd6" :question/math-academy-id "e-4669" :question/problem "Express $\\left(2\\times \\dfrac{1}{3}\\right)^2$ as the product of two powers." :question/worked-solution "To raise the product of two numbers to the power of $2$, we can raise each number to the power of $2$, and then multiply:\n\n$$\n\\left(2\\times \\dfrac{1}{3}\\right)^2=2^2 \\times \\left(\\dfrac{1}{3}\\right)^2\n$$"}] [{:db/id #edb/ref 17592186128924 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129112 :knowledge-point/id #uuid "a47a8902-eb6f-5d07-8e91-36796d1c6295" :knowledge-point/title "Applying the Power of Product Rule to Expressions with Negative Numbers"}] :question/id #uuid "10d598e9-cbcf-5681-b500-b046e2ec27ca" :question/math-academy-id "e-4670" :question/problem "Express $\\left(-2\\times 4\\right)^3$ as the product of two powers." :question/worked-solution "To raise the product of two numbers to the power of $3$, we can raise each number to the power of $3$, and then multiply:\n\n$$\n\\left(-2\\times 4\\right)^3=\\left(\\left(-2\\right)\\times 4\\right)^3= \\left(-2\\right)^3\\times 4^3\n$$"}] [{:db/id #edb/ref 17592186129831 :knowledge-point/_questions [{:db/id #edb/ref 17592186129112 :knowledge-point/id #uuid "a47a8902-eb6f-5d07-8e91-36796d1c6295" :knowledge-point/title "Applying the Power of Product Rule to Expressions with Negative Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6a3db1d-5d18-59ad-9638-699dfe8956ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5^{6} \\cdot 7" :db/id #edb/ref 17592186128468} {:answer/id #uuid "b7aa8f5a-d311-5de4-8d56-08e327d29180" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{5})^{6} \\cdot 7^{6}" :db/id #edb/ref 17592186128469} {:answer/id #uuid "c35898a2-4569-5e7f-93aa-0ca1fe989681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5 \\cdot 7^{6}" :db/id #edb/ref 17592186128470} {:answer/id #uuid "00419729-4831-532b-a63a-142d81c39add" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{5})^{6} \\cdot 7" :db/id #edb/ref 17592186128471} {:answer/id #uuid "35fa2b09-bc3f-511b-8549-19b6153ce68c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5} \\cdot 7^{6}" :db/id #edb/ref 17592186128472}] :answer-field/id #uuid "a7add207-1b41-5ffa-a3a6-b6f1c6f6cfa0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128467}] :question/id #uuid "d944e47b-a24e-5bbd-aaec-c98edd661ec9" :question/math-academy-id "q-68622" :question/problem "What is $(-\\frac{1}{5} \\cdot 7)^{6}$?"}]}
