#{[{:db/id #edb/ref 17592186128922 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129110 :knowledge-point/id #uuid "8aab5653-c3ec-5b4e-b56f-53393955d641" :knowledge-point/title "Applying the Power of Product Rule"}] :question/id #uuid "5c179a8e-55f3-5be7-8e97-b54287ea23e3" :question/math-academy-id "e-4668" :question/problem "Express $(3\\times 2)^2$ as the product of two powers." :question/worked-solution "To raise the product of two numbers to the power of $2,$ we can raise each number to the power of $2,$ and then multiply:\n\n$$\n(3\\times 2)^2=3^2\\times 2^2\n$$"}] [{:db/id #edb/ref 17592186128923 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129111 :knowledge-point/id #uuid "525486fb-d976-57a5-b6bd-c33f19177a3f" :knowledge-point/title "Applying the Power of Product Rule to Expressions with Fractions"}] :question/id #uuid "ee165665-5cf3-5343-bae6-9080a887fcd6" :question/math-academy-id "e-4669" :question/problem "Express $\\left(2\\times \\dfrac{1}{3}\\right)^2$ as the product of two powers." :question/worked-solution "To raise the product of two numbers to the power of $2,$ we can raise each number to the power of $2,$ and then multiply:\n\n$$\n\\left(2\\times \\dfrac{1}{3}\\right)^2=2^2 \\times \\left(\\dfrac{1}{3}\\right)^2\n$$"}] [{:db/id #edb/ref 17592186128924 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186129112 :knowledge-point/id #uuid "a47a8902-eb6f-5d07-8e91-36796d1c6295" :knowledge-point/title "Applying the Power of Product Rule to Expressions with Negative Numbers"}] :question/id #uuid "10d598e9-cbcf-5681-b500-b046e2ec27ca" :question/math-academy-id "e-4670" :question/problem "Express $\\left(-2\\times 4\\right)^3$ as the product of two powers." :question/worked-solution "To raise the product of two numbers to the power of $3,$ we can raise each number to the power of $3,$ and then multiply:\n\n$$\n\\left(-2\\times 4\\right)^3=\\left(\\left(-2\\right)\\times 4\\right)^3= \\left(-2\\right)^3\\times 4^3\n$$"}] [{:db/id #edb/ref 17592186479143 :knowledge-point/_questions [{:db/id #edb/ref 17592186129110 :knowledge-point/id #uuid "8aab5653-c3ec-5b4e-b56f-53393955d641" :knowledge-point/title "Applying the Power of Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d336fe8-ccb2-51b0-bf26-ee8c2b286a73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\times 57" :db/id #edb/ref 17592186478668} {:answer/id #uuid "847001c5-c202-50e9-85e3-b34ec0c44418" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\times {19}^{3}" :db/id #edb/ref 17592186478761} {:answer/id #uuid "8862a5f3-b8f0-551c-a5ad-5bbe7e04151f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\times 57" :db/id #edb/ref 17592186478770} {:answer/id #uuid "906506f8-f891-540d-adf0-ccca863558aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\times {19}^{3}" :db/id #edb/ref 17592186478791} {:answer/id #uuid "e9aa5674-32f2-5869-80a9-070581feff5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\times {19}^{6}" :db/id #edb/ref 17592186478924}] :answer-field/correct {:answer/id #uuid "847001c5-c202-50e9-85e3-b34ec0c44418" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64\\times {19}^{3}" :db/id #edb/ref 17592186478761} :answer-field/id #uuid "825260d4-b998-5eb1-ae9b-4657a7ba1c5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479009}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f219023d-b78a-5da7-9e31-cb2247269019" :question/math-academy-id "q-100648" :question/problem "$(4\\times 19)^{3}=$" :question/worked-solution "To raise the product of two numbers to the power of $3$, we can raise each number to the power of $3,$ and then multiply:\n\n$$\n(4\\times 19)^{3}=({4}^{3})\\times ({19}^{3})={4}^{3}\\times {19}^{3}\n$$\n\nNow, using, ${4}^{3}=64,$ we can simplify:\n\n$$\n{4}^{3}\\times {19}^{3}=64\\times {19}^{3}\n$$"}] [{:db/id #edb/ref 17592186479137 :knowledge-point/_questions [{:db/id #edb/ref 17592186129112 :knowledge-point/id #uuid "a47a8902-eb6f-5d07-8e91-36796d1c6295" :knowledge-point/title "Applying the Power of Product Rule to Expressions with Negative Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68ad4902-2995-5cd1-92bc-a5eec0f5639c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186478715} {:answer/id #uuid "854a5449-be1a-554f-bfbe-004b1ed634cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186478764} {:answer/id #uuid "94825fbb-d867-5726-8c12-559497f7dd43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{7}" :db/id #edb/ref 17592186478801} {:answer/id #uuid "a7e9c31d-2006-5f0c-a724-e1f109175257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{2}^{7}" :db/id #edb/ref 17592186478835} {:answer/id #uuid "b193f3aa-3324-5f7b-9b44-969041415948" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186478846}] :answer-field/correct {:answer/id #uuid "a7e9c31d-2006-5f0c-a724-e1f109175257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{2}^{7}" :db/id #edb/ref 17592186478835} :answer-field/id #uuid "863419e1-d8dc-5457-8b79-510ab7d534cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479011}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e39c2a75-ee61-55a4-869d-3b74872c3050" :question/math-academy-id "q-68445" :question/problem "$(-2)^{7}=$" :question/worked-solution "Notice that $-2=(-1)\\times 2.$\n\nTo raise the product of two numbers to the power of $7$, we can raise each number to the power of $7,$ and then multiply:\n\n$$\n(-2)^{7}={((-1)\\times 2)}^{7}=(-1)^{7}\\times {2}^{7}\n$$\n\nSince $-1$ raised to an odd power is $-1,$ we get\n\n$$\n(-1)^{7}\\times {2}^{7}=(-1)\\times {2}^{7}=-{2}^{7}.\n$$"}] [{:db/id #edb/ref 17592186479057 :knowledge-point/_questions [{:db/id #edb/ref 17592186129110 :knowledge-point/id #uuid "8aab5653-c3ec-5b4e-b56f-53393955d641" :knowledge-point/title "Applying the Power of Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0421e8c9-687f-52e2-95b8-e05f06e11293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4}^{4}\\times 2" :db/id #edb/ref 17592186478565} {:answer/id #uuid "8fea78d0-0078-5b06-a22f-b29b1fd07f47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\times 2\\times 4" :db/id #edb/ref 17592186478788} {:answer/id #uuid "980ff1c8-354d-518e-8126-556896961d70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\times {2}^{4}" :db/id #edb/ref 17592186478809} {:answer/id #uuid "bbd35642-20a6-5cb9-92f6-216e2634f06a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4}^{4}\\times {2}^{4}" :db/id #edb/ref 17592186478864} {:answer/id #uuid "f25f2edb-0e13-5364-98df-6d3e2ff2be7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\times 2+4" :db/id #edb/ref 17592186478938}] :answer-field/correct {:answer/id #uuid "bbd35642-20a6-5cb9-92f6-216e2634f06a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4}^{4}\\times {2}^{4}" :db/id #edb/ref 17592186478864} :answer-field/id #uuid 