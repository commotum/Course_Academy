a68dd" #edb/ref 17592186045417] [17592186063922 #edb/ref 1069 "e-1076" #edb/ref 17592186045417] [17592186063922 #edb/ref 1071 "Find the value of $\\left(x^4\\right)^5$." #edb/ref 17592186045417] [17592186063922 #edb/ref 1072 #uuid "a023e3eb-38bb-52ed-ae06-26ccdcd8fbf6" #edb/ref 17592186045417] [17592186063922 #edb/ref 1074 "We multiply the exponents, as follows:\n\n$$\n\\begin{aligned} \\left(x^4\\right)^5 \\\\ &= x^{4\\cdot5} \\\\ &= x^{20} \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186063923 #edb/ref 1069 "e-1077" #edb/ref 17592186045417] [17592186063923 #edb/ref 1071 "If $\\left(x^{-3}\\right)^{-6} = x^n$, then what is $n$?" #edb/ref 17592186045417] [17592186063923 #edb/ref 1072 #uuid "bc3b926b-dc98-5c74-8fc6-32075763059c" #edb/ref 17592186045417] [17592186063923 #edb/ref 1074 "We multiply the exponents, as follows:\n\n$$\n\\begin{aligned} \\left(x^{-3}\\right)^{-6} \\\\ &= x^{(-3)(-6)} \\\\ &= x^{18} \\end{aligned}\n$$\n\nTherefore $n=18$." #edb/ref 17592186045417] [17592186063924 #edb/ref 1069 "e-1079" #edb/ref 17592186045417] [17592186063924 #edb/ref 1071 "Simplify $\\sqrt[4]{x^{-8}}$." #edb/ref 17592186045417] [17592186063924 #edb/ref 1072 #uuid "f61d95d1-9761-53c3-bfb3-699bdcf6467a" #edb/ref 17592186045417] [17592186063924 #edb/ref 1074 "First, we convert the radical to a fractional exponent, and then we apply the power rule:\n\n$$\n\\begin{aligned}\n\\sqrt[4]{x^{-8}} &=  \\\\\n(x^{-8})^{1/4} &=  \\\\\nx^{(-8) \\cdot (1/4)} &=  \\\\\nx^{-2} &=  \\\\\n&= \\frac{1}{x^{2}}\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186063925 #edb/ref 1069 "e-1080" #edb/ref 17592186045417] [17592186063925 #edb/ref 1071 "If $\\left(\\dfrac{1}{\\sqrt[3]{x}}\\right)^4 \\cdot x = x^k$ for some constant $k$, then what is the value of $k$?" #edb/ref 17592186045417] [17592186063925 #edb/ref 1072 #uuid "bdb00b27-cb4d-5713-98c1-d4aa2eaa4643" #edb/ref 17592186045417] [17592186063925 #edb/ref 1074 "First, we convert the radical to a fractional exponent, and then we apply the power rule:\n\n$$\n\\begin{aligned}\n(\\frac{1}{\\sqrt[3]{x}})^{4} \\cdot x &=  \\\\\n(\\frac{1}{x^{1/3}})^{4} \\cdot x &=  \\\\\n(x^{-1/3})^{4} \\cdot x &=  \\\\\nx^{(-1/3) \\cdot (4)} \\cdot x &=  \\\\\n&= x^{-4/3} \\cdot x\n\\end{aligned}\n$$\n\nFinally, we apply the product rule, adding the exponents:\n\n$$\n\\begin{aligned}\nx^{-4/3} \\cdot x &=  \\\\\nx^{-4/3} \\cdot x^{1} &=  \\\\\nx^{-4/3 + 1} &=  \\\\\nx^{-4/3 + 3/3} &=  \\\\\n&= x^{-1/3}\n\\end{aligned}\n$$\n\nTherefore\n\n$$\nk=-\\dfrac{1}{3}\n$$" #edb/ref 17592186045417] [17592186064301 #edb/ref 1037 #edb/ref 17592186050697 #edb/ref 17592186045417] [17592186064301 #edb/ref 1037 #edb/ref 17592186051009 #edb/ref 17592186045417] [17592186064301 #edb/ref 1038 #edb/ref 17592186064680 #edb/ref 17592186045417] [17592186064301 #edb/ref 1038 #edb/ref 17592186064917 #edb/ref 17592186045417] [17592186064301 #edb/ref 1039 "Using the Power Rule with Positive Exponents" #edb/ref 17592186045417] [17592186064301 #edb/ref 1041 #edb/ref 17592186063922 #edb/ref 17592186045417] [17592186064301 #edb/ref 1042 #uuid "e463f04c-3ec1-5b0b-99a4-c286cf0f2d23" #edb/ref 17592186045417] [17592186064302 #edb/ref 1038 #edb/ref 17592186064690 #edb/ref 17592186045417] [17592186064302 #edb/ref 1038 #edb/ref 17592186064918 #edb/ref 17592186045417] [17592186064302 #edb/ref 1039 "Using the Power Rule with Negative Exponents" #edb/ref 17592186045417] [17592186064302 #edb/ref 1041 #edb/ref 17592186063923 #edb/ref 17592186045417] [17592186064302 #edb/ref 1042 #uuid "5abe4cbe-7495-5723-88cd-f97796f8ef49" #edb/ref 17592186045417] [17592186064303 #edb/ref 1037 #edb/ref 17592186050894 #edb/ref 17592186045417] [17592186064303 #edb/ref 1038 #edb/ref 17592186064715 #edb/ref 17592186045417] [17592186064303 #edb/ref 1038 #edb/ref 17592186064919 #edb/ref 17592186045417] [17592186064303 #edb/ref 1039 "Using the Power Rule with Fractional Exponents" #edb/ref 17592186045417] [17592186064303 #edb/ref 1041 #edb/ref 17592186063924 #edb/ref 17592186045417] [1