#{[{:db/id #edb/ref 17592186063922 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064301 :knowledge-point/id #uuid "e463f04c-3ec1-5b0b-99a4-c286cf0f2d23" :knowledge-point/title "Using the Power Rule with Positive Exponents"}] :question/id #uuid "a023e3eb-38bb-52ed-ae06-26ccdcd8fbf6" :question/math-academy-id "e-1076" :question/problem "Find the value of $\\left(x^4\\right)^5$." :question/worked-solution "We multiply the exponents, as follows:\n\n$$\n\\begin{aligned} \\left(x^4\\right)^5 \\\\ &= x^{4\\cdot5} \\\\ &= x^{20} \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063923 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064302 :knowledge-point/id #uuid "5abe4cbe-7495-5723-88cd-f97796f8ef49" :knowledge-point/title "Using the Power Rule with Negative Exponents"}] :question/id #uuid "bc3b926b-dc98-5c74-8fc6-32075763059c" :question/math-academy-id "e-1077" :question/problem "If $\\left(x^{-3}\\right)^{-6} = x^n$, then what is $n$?" :question/worked-solution "We multiply the exponents, as follows:\n\n$$\n\\begin{aligned} \\left(x^{-3}\\right)^{-6} \\\\ &= x^{(-3)(-6)} \\\\ &= x^{18} \\end{aligned}\n$$\n\nTherefore $n=18$."}] [{:db/id #edb/ref 17592186063924 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064303 :knowledge-point/id #uuid "0b64073e-4aa0-551c-b914-98420b0be338" :knowledge-point/title "Using the Power Rule with Fractional Exponents"}] :question/id #uuid "f61d95d1-9761-53c3-bfb3-699bdcf6467a" :question/math-academy-id "e-1079" :question/problem "Simplify $\\sqrt[4]{x^{-8}}$." :question/worked-solution "First, we convert the radical to a fractional exponent, and then we apply the power rule:\n\n$$\n\\begin{aligned}\n\\sqrt[4]{x^{-8}} &=  \\\\\n(x^{-8})^{1/4} &=  \\\\\nx^{(-8) \\cdot (1/4)} &=  \\\\\nx^{-2} &=  \\\\\n&= \\frac{1}{x^{2}}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063925 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064304 :knowledge-point/id #uuid "acc85958-ad98-5ce2-912c-e2ba70d025ca" :knowledge-point/title "Simplifying Challenging Expressions Using the Power Rule"}] :question/id #uuid "bdb00b27-cb4d-5713-98c1-d4aa2eaa4643" :question/math-academy-id "e-1080" :question/problem "If $\\left(\\dfrac{1}{\\sqrt[3]{x}}\\right)^4 \\cdot x = x^k$ for some constant $k$, then what is the value of $k$?" :question/worked-solution "First, we convert the radical to a fractional exponent, and then we apply the power rule:\n\n$$\n\\begin{aligned}\n(\\frac{1}{\\sqrt[3]{x}})^{4} \\cdot x &=  \\\\\n(\\frac{1}{x^{1/3}})^{4} \\cdot x &=  \\\\\n(x^{-1/3})^{4} \\cdot x &=  \\\\\nx^{(-1/3) \\cdot (4)} \\cdot x &=  \\\\\n&= x^{-4/3} \\cdot x\n\\end{aligned}\n$$\n\nFinally, we apply the product rule, adding the exponents:\n\n$$\n\\begin{aligned}\nx^{-4/3} \\cdot x &=  \\\\\nx^{-4/3} \\cdot x^{1} &=  \\\\\nx^{-4/3 + 1} &=  \\\\\nx^{-4/3 + 3/3} &=  \\\\\n&= x^{-1/3}\n\\end{aligned}\n$$\n\nTherefore\n\n$$\nk=-\\dfrac{1}{3}\n$$"}] [{:db/id #edb/ref 17592186064680 :knowledge-point/_questions [{:db/id #edb/ref 17592186064301 :knowledge-point/id #uuid "e463f04c-3ec1-5b0b-99a4-c286cf0f2d23" :knowledge-point/title "Using the Power Rule with Positive Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a823f7f5-d6fb-56f0-8d88-c97a74c4b51a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{2}" :db/id #edb/ref 17592186062138} {:answer/id #uuid "d2ac082d-2dfe-5f29-9d59-d47b273941df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{8}" :db/id #edb/ref 17592186062139} {:answer/id #uuid "0d05ec6f-470a-5159-baef-37f07fcf1fb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{5}" :db/id #edb/ref 17592186062140} {:answer/id #uuid "56732dbd-bb43-56b1-b41d-be87d80f2387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{6}" :db/id #edb/ref 17592186062141} {:answer/id #uuid "7c16425c-b0ac-535c-