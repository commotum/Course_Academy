:question/problem "If ${({y}^{4})}^{-2}={y}^{k},$ then $k=$" :question/worked-solution "We multiply the exponents, as follows:\n\n$$\n\\begin{aligned}{({y}^{4})}^{-2} & = \\\\ {y}^{4\\cdot (-2)} & = \\\\ {y}^{-8}\\end{aligned}\n$$\n\nHence, $k=-8.$"}] [{:db/id #edb/ref 17592186064680 :knowledge-point/_questions [{:db/id #edb/ref 17592186064301 :knowledge-point/id #uuid "e463f04c-3ec1-5b0b-99a4-c286cf0f2d23" :knowledge-point/title "Using the Power Rule with Positive Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c16425c-b0ac-535c-a63b-0a08cdea68dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186062142} {:answer/id #uuid "15a52a15-30d1-581c-aa62-354ee70fc6be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}" :db/id #edb/ref 17592186484861} {:answer/id #uuid "7520ecfb-f9a7-524f-bf87-8ffcdf00908f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}" :db/id #edb/ref 17592186485069} {:answer/id #uuid "c2eaa2de-f3f4-5729-9fa0-3e79bcc9411f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{5}" :db/id #edb/ref 17592186485234} {:answer/id #uuid "f420442c-2ea5-5787-b932-56815d206555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}" :db/id #edb/ref 17592186485339}] :answer-field/correct {:answer/id #uuid "f420442c-2ea5-5787-b932-56815d206555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}" :db/id #edb/ref 17592186485339} :answer-field/id #uuid "1f7392a9-cb77-57a7-ab6e-8b37f17b4370" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062137}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "24f7e76