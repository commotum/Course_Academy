#{[{:db/id #edb/ref 17592186063922 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064301 :knowledge-point/id #uuid "e463f04c-3ec1-5b0b-99a4-c286cf0f2d23" :knowledge-point/title "Using the Power Rule with Positive Exponents"}] :question/id #uuid "a023e3eb-38bb-52ed-ae06-26ccdcd8fbf6" :question/math-academy-id "e-1076" :question/problem "Find the value of $\\left(x^4\\right)^5.$" :question/worked-solution "We multiply the exponents, as follows:\n\n$$\n\\eqalign{\n\\left(x^4\\right)^5\t&= \\\n\tx^{4\\cdot5} \t&= \\\n\tx^{20}\n}\n$$"}] [{:db/id #edb/ref 17592186063923 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064302 :knowledge-point/id #uuid "5abe4cbe-7495-5723-88cd-f97796f8ef49" :knowledge-point/title "Using the Power Rule with Negative Exponents"}] :question/id #uuid "bc3b926b-dc98-5c74-8fc6-32075763059c" :question/math-academy-id "e-1077" :question/problem "If $\\left(x^{-3}\\right)^{-6} = x^n,$ then what is $n?$" :question/worked-solution "We multiply the exponents, as follows:\n\n$$\n\\eqalign{\n\t\\left(x^{-3}\\right)^{-6}&=\\\n\tx^{(-3)(-6)}&=\\\n\tx^{18}\n\t}\n$$\n\nTherefore $n=18.$"}] [{:db/id #edb/ref 17592186063924 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064303 :knowledge-point/id #uuid "0b64073e-4aa0-551c-b914-98420b0be338" :knowledge-point/title "Using the Power Rule with Fractional Exponents"}] :question/id #uuid "f61d95d1-9761-53c3-bfb3-699bdcf6467a" :question/math-academy-id "e-1079" :question/problem "Simplify $\\sqrt[4]{x^{-8}}.$" :question/worked-solution "First, we convert the radical to a fractional exponent, and then we apply the power rule:\n\n$$\n\\begin{aligned}\\sqrt[4]{{x}^{-8}} & = \\\\ ({x}^{-8})^{1/4} & = \\\\ {x}^{(-8)\\cdot (1/4)} & = \\\\ {x}^{-2} & = \\\\ \\frac{1}{{x}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063925 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064304 :knowledge-point/id #uuid "acc85958-ad98-5ce2-912c-e2ba70d025ca" :knowledge-point/title "Simplifying Challenging Expressions Using the Power Rule"}] :question/id #uuid "bdb00b27-cb4d-5713-98c1-d4aa2eaa4643" :question/math-academy-id "e-1080" :question/problem "If $\\left(\\dfrac{1}{\\sqrt[3]{x}}\\right)^4 \\cdot x = x^k$ for some constant $k$, then what is the value of $k?$" :question/worked-solution "First, we convert the radical to a fractional exponent, and then we apply the power rule:\n\n$$\n\\begin{aligned}{(\\frac{1}{\\sqrt[3]{x}})}^{4}\\cdot x & = \\\\ {(\\frac{1}{{x}^{1/3}})}^{4}\\cdot x & = \\\\ {({x}^{-1/3})}^{4}\\cdot x & = \\\\ {x}^{(-1/3)\\cdot (4)}\\cdot x & = \\\\ {x}^{-4/3}\\cdot x & \\end{aligned}\n$$\n\nFinally, we apply the product rule, adding the exponents:\n\n$$\n\\begin{aligned}{x}^{-4/3}\\cdot x & = \\\\ {x}^{-4/3}\\cdot {x}^{1} & = \\\\ {x}^{-4/3+1} & = \\\\ {x}^{-4/3+3/3} & = \\\\ {x}^{-1/3}\\end{aligned}\n$$\n\nTherefore $k=-\\dfrac{1}{3}.$"}] [{:db/id #edb/ref 17592186485539 :knowledge-point/_questions [{:db/id #edb/ref 17592186064303 :knowledge-point/id #uuid "0b64073e-4aa0-551c-b914-98420b0be338" :knowledge-point/title "Using the Power Rule with Fractional Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d322f75-113b-5e34-83ff-1891f5c63ea4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{{r}^{8}}" :db/id #edb/ref 17592186484911} {:answer/id #uuid "5c34ae1d-ea5a-50e6-a4d3-c4d6a29ec564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{{r}^{24}}" :db/id #edb/ref 17592186485022} {:answer/id #uuid "791d12bd-883d-5d64-b3ba-d6248d0de937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{{r}^{6}}" :db/id #edb/ref 17592186485078} {:answer/id #uuid "f6ebfc21-822f-52e2-866f-0a99c80a24b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[4]{{r}^{5}}" :db/id #edb/ref 17592186485345} {:answer/id #uuid "fb9feea5-