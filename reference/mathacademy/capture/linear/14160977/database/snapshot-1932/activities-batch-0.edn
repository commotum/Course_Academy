#{[{:activity/first-step {:db/id #edb/ref 17592186065195} :activity/id #uuid "abc3056c-c606-506b-b00e-5921984cd770" :activity/scope {:db/id #edb/ref 17592186050208 :topic/id #uuid "3668d61c-1873-5fa7-ac2e-a1d14113f40f" :topic/math-academy-id 362} :activity/steps [{:db/id #edb/ref 17592186065195 :step/content {:db/id #edb/ref 17592186065338 :tutorial/content "The **power rule for exponents** states that a power raised to another power is equal to the product of the two powers:\n\n$$\n\\left(a^m\\right)^n = a^{mn}\n$$\n\nFor example,\n\n$$\n\\begin{aligned} \\left(5^2\\right)^3 \\\\ &= 5^{2 \\cdot 3} \\\\ &= 5^6. \\end{aligned}\n$$\n\nTo see why the power rule for exponents is true, let's take the above example and work it out again, the long way:\n\n$$\n\\begin{aligned} \\left(5^2\\right)^3 \\\\[5pt] &= \\underbrace{5^2\\cdot 5^2\\cdot 5^2}_{3\\text{times}} \\\\[5pt] &= (5 \\cdot 5) \\cdot (5 \\cdot 5) \\cdot (5 \\cdot 5) \\\\[5pt] &= \\underbrace{5\\cdot5\\cdot5\\cdot5\\cdot5\\cdot5}_{6\\text{times}} \\\\[5pt] &= 5^6 \\end{aligned}\n$$\n\nThe power rule for exponents is just a shortcut for the process above." :tutorial/id #uuid "1a2e18f4-6996-52a0-95eb-77abb10d0e77" :tutorial/math-academy-id 1480 :tutorial/title "Introduction"} :step/id #uuid "d4e0fa30-ed7c-5ef6-9aaa-10d6ba2f9c05" :step/math-academy-id 3529 :step/next {:db/id #edb/ref 17592186065196}} {:db/id #edb/ref 17592186065196 :step/content {:db/id #edb/ref 17592186064301 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063922 :question/id #uuid "a023e3eb-38bb-52ed-ae06-26ccdcd8fbf6" :question/math-academy-id "e-1076"} :knowledge-point/id #uuid "e463f04c-3ec1-5b0b-99a4-c286cf0f2d23" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050697} {:db/id #edb/ref 17592186051009}] :knowledge-point/questions [{:db/id #edb/ref 17592186064680} {:db/id #edb/ref 17592186064917}] :knowledge-point/title "Using the Power Rule with Positive Exponents"} :step/id #uuid "57c38b87-4e15-573a-960c-a61055841b16" :step/math-academy-id 3530 :step/next {:db/id #edb/ref 17592186065197}} {:db/id #edb/ref 17592186065197 :step/content {:db/id #edb/ref 17592186064302 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063923 :question/id #uuid "bc3b926b-dc98-5c74-8fc6-32075763059c" :question/math-academy-id "e-1077"} :knowledge-point/id #uuid "5abe4cbe-7495-5723-88cd-f97796f8ef49" :knowledge-point/questions [{:db/id #edb/ref 17592186064690} {:db/id #edb/ref 17592186064918}] :knowledge-point/title "Using the Power Rule with Negative Exponents"} :step/id #uuid "94008045-7999-599a-b725-36201f5023db" :step/math-academy-id 3532 :step/next {:db/id #edb/ref 17592186065198}} {:db/id #edb/ref 17592186065198 :step/content {:db/id #edb/ref 17592186065339 :tutorial/content "Suppose we want to remove the radical term in an expression like $\\sqrt{x^{3}}$. To do this, we first convert the radical to a fractional exponent:\n\n$$\n\\sqrt{x^{3}}= \\left(x^{3}\\right)^{1/2}\n$$\n\nThen, we can apply the power rule and multiply the fractional exponents:\n\n$$\n\\begin{aligned}\n(x^{3})^{1/2} &=  \\\\\nx^{(3) \\cdot (1/2)} &=  \\\\\n&= x^{3/2}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\sqrt{x^{3}} = x^{3/2}\n$$\n\nand in general,\n\n$$\n\\sqrt[n]{x^m} = x^{m/n}\n$$" :tutorial/id #uuid "40488864-6672-59b7-9ac6-79903856b484" :tutorial/math-academy-id 1481 :tutorial/title "The Power Rule With Fractional Exponents"} :step/id #uuid "19a0572e-4edb-579e-b72d-fdc1fefe72ca" :step/math-academy-id 3536 :step/next {:db/id #edb/ref 17592186065199}} {:db/id #edb/ref 17592186065199 :step/content {:db/id #edb/ref 17592186064303 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063924 :question/id #uuid "f61d95d1-9761-53c3-bfb3-699bdcf6467a" :question/math-academy-id "e-1079"} :knowledge-point/id #uuid "0b64073e-4aa0-551c-b914-98420b0be338" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050894}] :knowledge-point/questions [{:db/id #edb/ref 17592186064715} {:db/id #edb/ref 17592186064919}] :knowledge-point/title "Using the Power Rule with Fractional Exponents"} :step/id #uuid "d556d6dc-07a0-5db1-b5db-945a6a81b5eb" :step/math-academy-id 3537 :step/next {:db/id #edb/ref 17592186065200}} {:db/id #edb/ref 17592186065200 :step/content {:db/id #edb/ref 17592186064304 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063925 :question/id #uuid "bdb00b27-cb4d-5713-98c1-d4aa2eaa4643" :question/math-academy-id "e-1080"} :knowledge-point/id #uuid "acc85958-ad98-5ce2-912c-e2ba70d025ca" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049729}] :knowledge-point/questions [{:db/id #edb/ref 17592186064750} {:db/id #edb/ref 17592186064920} {:db/id #edb/ref 17592186233088}] :knowledge-point/title "Simplifying Challenging Expressions Using the Power Rule"} :step/id #uuid "7aabc08d-413a-5e15-8a0e-170869a0198c" :step/math-academy-id 3539}] :activity/title "The Power Rule for Exponents With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064449}]}
