            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-119706-b",
              "type": "image",
              "value": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/linear/14268510/assets/a221fb7d17063e3ccf085ad143539660801c14b7b96fd6e45d2b4569c3087ad3.png",
