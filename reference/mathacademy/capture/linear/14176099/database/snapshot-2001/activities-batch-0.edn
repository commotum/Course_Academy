#{[{:activity/first-step {:db/id #edb/ref 17592186088543} :activity/id #uuid "cfe67386-85ee-52bc-a19f-9e5f91df386d" :activity/scope {:db/id #edb/ref 17592186049840 :topic/id #uuid "17f87fcb-3fe5-5ecd-ba54-8883ffee898f" :topic/math-academy-id 839} :activity/steps [{:db/id #edb/ref 17592186088543 :step/content {:db/id #edb/ref 17592186088991 :tutorial/content "The **standard form** equation of a line is\n\n$$\nax+by=c\n$$\n\nwhere\n\n- $a,b$, and $c$ are all integers,\n- $a \\geq 0$, and\n- $a,b$, and $c$ have no common factors.\n\nNote that we always write $x$ *before* $y$ on the left-hand side!\n\nLet's see some examples:\n\n- The equation $2x - y= -5$ is in standard form. Indeed, the variables are on the left-hand side, while the constant term is on the right-hand side:\n$\\underbrace{2x - y}_{\\textrm{variables}} \\quad = \\underbrace{-5\\phantom{y}}_{\\textrm{constant}}$\nAll coefficients are integers (namely, $2$, $-1$, and $-5$) and don't have common factors greater than $1$. Also, the coefficient of $x$ is non-negative ($2$).\n- The equation $-3x + y = 1$ is *not* in standard form because the coefficient of $x$ is negative ($-3$).\n- The equation $2x+4y = -10$ is *not* in standard form because the coefficients $(2,4$, and $-10)$ have a common factor of $2$.\n- The equation $\\dfrac12x+\\dfrac13y = 6$ is *not* in standard form because the coefficients of $x$ and $y$ are not integers." :tutorial/id #uuid "739ff387-5940-547f-adac-8b2ac8e5a229" :tutorial/math-academy-id 9126 :tutorial/title "Introduction"} :step/id #uuid "0f6a809a-5a39-577f-8881-246e8ed35867" :step/math-academy-id 178720 :step/next {:db/id #edb/ref 17592186088544}} {:db/id #edb/ref 17592186088544 :step/content {:db/id #edb/ref 17592186087709 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087437 :question/id #uuid "5faa755c-1e2d-52a7-a521-49f79b94ec39" :question/math-academy-id "e-14709"} :knowledge-point/id #uuid "8e2458e5-8061-5f3f-9b4f-4d0bdd0ec641" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049935} {:db/id #edb/ref 17592186050581}] :knowledge-point/questions [{:db/id #edb/ref 17592186088071} {:db/id #edb/ref 17592186088074} {:db/id #edb/ref 17592186088219}] :knowledge-point/title "Identifying Equations Written in Standard Form"} :step/id #uuid "e1825121-20e1-5854-9a35-360f43ffb277" :step/math-academy-id 178721 :step/next {:db/id #edb/ref 17592186088545}} {:db/id #edb/ref 17592186088545 :step/content {:db/id #edb/ref 17592186088993 :tutorial/content "Let's now discuss how to convert the equation of a line to standard form.\n\nTo illustrate, we will take the line $y = 2x-1$ and convert it into standard form. We begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side.\n\n$$\n\\begin{aligned}\ny &= 2x - 1 \\\\\ny - 2x &= -1 \\\\\n- 2x + y &= -1\n\\end{aligned}\n$$\n\nNow the equation is in the form\n\n$$\nax+by=c\n$$\n\nHowever, it violates the rule\n\n$$\na \\geq 0\n$$\n\nWe can fix this by multiplying the equation by $-1$ as follows:\n\n$$\n\\begin{aligned}\n-2x + y &= -1 \\\\\n(-1) \\cdot (-2x + y) &= (-1) \\cdot (-1) \\\\\n2x - y &= 1\n\\end{aligned}\n$$\n\nNow, $a,b$, and $c$ are integers with no common factors, and\n\n$$\na \\geq 0\n$$\n\nSo, we are done!\n\nThe standard form of the line is $2x-y=1$." :tutorial/id #uuid "914fb469-510e-5e74-92bc-6174870cbd47" :tutorial/math-academy-id 9221 :tutorial/title "Converting a Line to Standard Form"} :step/id #uuid "1ad80f23-5479-5329-8fd1-39cf7d32c8f0" :step/math-academy-id 178725 :step/next {:db/id #edb/ref 17592186088546}} {:db/id #edb/ref 17592186088546 :step/content {:db/id #edb/ref 17592186087710 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087438 :question/id #uuid "7a4196bc-1f72-5435-9c00-c1fbef60b549" :question/math-academy-id "e-14710"} :knowledge-point/id #uuid "f399f6ed-91bc-594e-9a40-b7c79f60c5dc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050622}] :knowledge-point/questions [{:db/id #edb/ref 17592186088065} {:db/id #edb/ref 17592186088299} {:db/id #edb/ref 17592186088300} {:db/id #edb/ref 17592186235494}] :knowledge-point/title "Converting from Slope-Intercept Form to Standard Form"} :step/id #uuid "219a19a2-5ca7-55ec-b664-706e0003f956" :step/math-academy-id 178726 :step/next {:db/id #edb/ref 17592186088547}} {:db/id #edb/ref 17592186088547 :step/content {:db/id #edb/ref 17592186087711 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087439 :question/id #uuid "9e0c4000-c24e-5761-8cbe-60699b557eca" :question/math-academy-id "e-14711"} :knowledge-point/id #uuid "daa37544-c4ec-5b8b-91a5-ccf5ee8f50d6" :knowledge-point/questions [{:db/id #edb/ref 17592186088002} {:db/id #edb/ref 17592186088069}] :knowledge-point/title "Converting an Arbitrary Line to Standard Form"} :step/id #uuid "54390c19-603c-54bd-bf54-163d31414029" :step/math-academy-id 178730 :step/next {:db/id #edb/ref 17592186088548}} {:db/id #edb/ref 17592186088548 :step/content {:db/id #edb/ref 17592186087712 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087440 :question/id #uuid "f78832f7-acd3-5779-b171-0650782b918e" :question/math-academy-id "e-14712"} :knowledge-point/id #uuid "eefba93e-12c7-5835-80fb-b36463f140d8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061} {:db/id #edb/ref 17592186050635}] :knowledge-point/questions [{:db/id #edb/ref 17592186088066} {:db/id #edb/ref 17592186088070} {:db/id #edb/ref 17592186088301}] :knowledge-point/title "Finding the Standard Equation of a Line Passing Through Two Points"} :step/id #uuid "5756f274-95fd-5077-9cb0-2b24aadadb72" :step/math-academy-id 178733}] :activity/title "Equations of Lines in Standard Form" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186087911}]}
