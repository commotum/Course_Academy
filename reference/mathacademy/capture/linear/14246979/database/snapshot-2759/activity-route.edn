#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186564550} :activity/id #uuid "16e1fd21-d537-5ae9-9de0-7f106ce3512a" :activity/scope {:db/id #edb/ref 17592186049418 :topic/id #uuid "f344db4d-49a0-59ae-b874-a20de566b228" :topic/math-academy-id 485} :activity/steps [{:db/id #edb/ref 17592186564548 :step/content {:db/id #edb/ref 17592186564473 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13df7405-37a9-5376-a794-b50ade14b257" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2p,-5q)" :db/id #edb/ref 17592186563997} {:answer/id #uuid "2248598d-8d45-5b33-a1bb-161e7e022f16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2p,-4q)" :db/id #edb/ref 17592186564017} {:answer/id #uuid "41743567-93b3-52b5-956f-5e3cf584ae66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6p,-5q)" :db/id #edb/ref 17592186564079} {:answer/id #uuid "b2dfc1f4-7244-51d1-b08e-beaf085cffe1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3p,-5q)" :db/id #edb/ref 17592186564249} {:answer/id #uuid "cd30a56d-8702-5fad-b81c-b55db3829574" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4p,-2q)" :db/id #edb/ref 17592186564290}] :answer-field/correct {:db/id #edb/ref 17592186564249} :answer-field/id #uuid "47c69590-b35f-5b4e-b1cf-478ea7e99763" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186564392}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a0af22d-5fcd-5a62-b138-4a5969bb9fc8" :question/math-academy-id "q-73730" :question/problem "Find the midpoint of the line segment with endpoints $(8p,-q)$ and $(-2p,-9q).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(8p,-q)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(-2p,-9q)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{8p+(-2p)}{2},\\frac{-q+(-9q)}{2}) \\\\  & =(\\frac{8p-2p}{2},\\frac{-q-9q}{2}) \\\\  & =(\\frac{6p}{2},\\frac{-10q}{2}) \\\\  & =(3p,-5q).\\end{aligned}\n$$"} :step/id #uuid "2022c43f-bf94-523c-aa78-e657d9fc756e" :step/next {:db/id #edb/ref 17592186564584}} {:db/id #edb/ref 17592186564550 :step/content {:db/id #edb/ref 17592186564537 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b86450-d396-50c2-b792-96eb2e069dee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-w,-z)" :db/id #edb/ref 17592186563969} {:answer/id #uuid "1707b2e5-7f13-581b-928d-cb954858885d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2w,2z)" :db/id #edb/ref 17592186563999} {:answer/id #uuid "2295ae60-1e26-5128-8f27-466b06ffd6c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2w,3z)" :db/id #edb/ref 17592186564018} {:answer/id #uuid "2c117928-80a8-595c-9b86-d8c72d7f0afb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2w,-2z)" :db/id #edb/ref 17592186564039} {:answer/id #uuid "c0661565-ff3d-5e5e-b035-22e247858f0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-w,2z)" :db/id #edb/ref 17592186564264}] :answer-field/correct {:db/id #edb/ref 17592186563999} :answer-field/id #uuid "87c637ca-477b-51e8-ad73-42e7989eff3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186564417}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f548e29c-4fb0-5de0-8aa0-2659faa5a2eb" :question/math-academy-id "q-73720" :question/problem "Find the midpoint of the line segment with endpoints $(-w,7z)$ and $(5w,-3z).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(-w,7z)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(5w,-3z)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{-w+5w}{2},\\frac{7z+(-3z)}{2}) \\\\  & =(\\frac{-w+5w}{2},\\frac{7z-3z}{2}) \\\\  & =(\\frac{4w}{2},\\frac{4z}{2}) \\\\  & =(2w,2z).\\end{aligned}\n$$"} :step/id #uuid "20c277f2-75f7-54cc-82c6-c8c4fe25dff4" :step/next {:db/id #edb/ref 17592186564548}} {:db/id #edb/ref 17592186564584 :step/content {:db/id #edb/ref 17592186233640 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49fac7bf-46ec-5ac8-9e60-c629e9e8013c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186232325}] :answer-field/correct {:db/id #edb/ref 17592186232325} :answer-field/id #uuid "b4bdca92-d3ce-5317-93a5-453116878ba3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186232324} {:answer-field/choices [{:answer/id #uuid "957e3eaa-ef13-506d-8623-b2a325befa53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186232327}] :answer-field/correct {:db/id #edb/ref 17592186232327} :answer-field/id #uuid "dc196177-57eb-5ab4-b3b9-ccd45d691c3c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186232326}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "916ab087-cc91-5679-86a8-6caf3720561e" :question/math-academy-id "q-216947" :question/problem "![](images/22/226b832db682da8379d9567123974abb3d44c02f4db3c3ef78d48c1a8f2a491e.png)\n\nGiven that $(1,1)$ is the midpoint of the line segment $\\overset{―}{PQ}$ above, find the values of $a$ and $b.$\n\n$a=$\n{{field-1}},\n$\\,b=$\n{{field-2}}" :question/worked-solution "The given points are ${{(a,b)}_{⏟}}_{\\text{(}{x}_{1},\\,{y}_{1})}$, ${{(-2,0)}_{⏟}}_{\\text{(}{x}_{2},\\,{y}_{2})}$ and ${{(1,1)}_{⏟}}_{\\text{(}{x}_{m},\\,{y}_{m})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\ (1,1) & =(\\frac{a-2}{2},\\frac{b+0}{2})\\end{aligned}\n$$\n\nEquating the corresponding $x$- and $y$-coordinates in the equation above gives us\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}1 &=\\frac{a-2}{2} \\\\ 1 &=\\frac{b}{2}\\end{aligned}\\right.\\,\\Rightarrow \\,\\left\\{\\begin{aligned}a &=4 \\\\ b &=2.\\end{aligned}\\right.\\end{aligned}\n$$\n\nThus, $a=4$ and $b=2.$"} :step/id #uuid "be38ad57-685f-57cb-91ce-666c45d052ff"}] :activity/title "Midpoints in the Coordinate Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186563958}]}
