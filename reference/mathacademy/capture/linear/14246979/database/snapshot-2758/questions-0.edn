#{[{:db/id #edb/ref 17592186233640 :knowledge-point/_questions [{:db/id #edb/ref 17592186073715 :knowledge-point/id #uuid "0b6b70eb-df57-5d17-a753-645ccdf94945" :knowledge-point/title "Finding the Coordinates of an Endpoint Given the Midpoint"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49fac7bf-46ec-5ac8-9e60-c629e9e8013c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186232325}] :answer-field/correct {:answer/id #uuid "49fac7bf-46ec-5ac8-9e60-c629e9e8013c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186232325} :answer-field/id #uuid "b4bdca92-d3ce-5317-93a5-453116878ba3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232324} {:answer-field/choices [{:answer/id #uuid "957e3eaa-ef13-506d-8623-b2a325befa53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186232327}] :answer-field/correct {:answer/id #uuid "957e3eaa-ef13-506d-8623-b2a325befa53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186232327} :answer-field/id #uuid "dc196177-57eb-5ab4-b3b9-ccd45d691c3c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232326}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "916ab087-cc91-5679-86a8-6caf3720561e" :question/math-academy-id "q-216947" :question/problem "![](images/22/226b832db682da8379d9567123974abb3d44c02f4db3c3ef78d48c1a8f2a491e.png)\n\nGiven that $(1,1)$ is the midpoint of the line segment $\\overset{―}{PQ}$ above, find the values of $a$ and $b.$\n\n$a=$\n{{field-1}},\n$\\,b=$\n{{field-2}}" :question/worked-solution "The given points are ${{(a,b)}_{⏟}}_{\\text{(}{x}_{1},\\,{y}_{1})}$, ${{(-2,0)}_{⏟}}_{\\text{(}{x}_{2},\\,{y}_{2})}$ and ${{(1,1)}_{⏟}}_{\\text{(}{x}_{m},\\,{y}_{m})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\ (1,1) & =(\\frac{a-2}{2},\\frac{b+0}{2})\\end{aligned}\n$$\n\nEquating the corresponding $x$- and $y$-coordinates in the equation above gives us\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}1 &=\\frac{a-2}{2} \\\\ 1 &=\\frac{b}{2}\\end{aligned}\\right.\\,\\Rightarrow \\,\\left\\{\\begin{aligned}a &=4 \\\\ b &=2.\\end{aligned}\\right.\\end{aligned}\n$$\n\nThus, $a=4$ and $b=2.$"}]}
