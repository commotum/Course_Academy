86233189 :knowledge-point/_questions [{:db/id #edb/ref 17592186068759 :knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2" :knowledge-point/title "Dividing Rational Expressions with a Single Common Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "620efcf8-fe45-5654-a7f3-88db5fb39541" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(w+2)}{7{w}^{2}}" :db/id #edb/ref 17592186538451} {:answer/id #uuid "c9dc84d0-2123-5c46-be45-9dca7733c77a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7w}{3(w+2)}" :db/id #edb/ref 17592186538701} {:answer/id #uuid "ca928d1f-961b-583d-a769-be5f671d1b2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14{w}^{2}}{w+2}" :db/id #edb/ref 17592186538705} {:answer/id #uuid "d9cc3496-9375-504d-a3d2-06b507e752a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14w}{3(w+2)}" :db/id #edb/ref 17592186538732} {:answer/id #uuid "fb1bc848-a943-502b-beea-11031d924356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{w+2}{14}" :db/id #edb/ref 17592186538797}] :answer-field/correct {:answer/id #uuid "d9cc3496-9375-504d-a3d2-06b507e752a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14w}{3(w+2)}" :db/id #edb/ref 17592186538732} :answer-field/id #uuid "6ebb594e-17b9-5253-8215-8996f4a7ec24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186538860}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97895caf-82df-5b95-8916-1e87ffb09dd3" :question/math-academy-id "q-113809" :question/problem "$\\frac{2{w}^{2}}{3}÷\\frac{w(w+2)}{7}=$" :question/worked-solution "To compute\n\n$$\n\\frac{2{w}^{2}}{3}÷\\frac{w(w+2)}{7},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{2{w}^{2}}{3}÷\\frac{w(w+2)}{7} & = \\\\ \\frac{2{w}^{2}}{3}\\cdot \\frac{7}{w(w+2)} & = \\\\ \\frac{14{w}^{2}}{3w(w+2)} & = \\\\ \\frac{14{w}^{\\cancel{2}}}{3\\cancel{w}(w+2)} & = \\\\ \\frac{14w}{3(w+2)}\\end{aligned}\n$$\n\nNote that we canceled out a common factor of $w$ in the numerator and denominator."}] [{:db/id #edb/ref 17592186275147 :knowledge-point/_questions [{:db/id #edb/ref 17592186068760 :knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f" :knowledge-point/title "Dividing Rational Expressions with Multiple Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06368d8d-e8cc-5093-b179-f46913edb67d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{g}" :db/id #edb/ref 17592186272444} {:answer/id #uuid "140af3f2-c890-5051-8864-91381615cd30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2g}" :db/id #edb/ref 17592186272567} {:answer/id #uuid "1c419ad3-8f0e-57be-8748-249953a12c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8g}{3}" :db/id #edb/ref 17592186272633} {:answer/id #uuid "7d59d9bf-e572-570b-8b5b-7f29aac90361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{g}^{2}}{3}" :db/id #edb/ref 17592186273460} {:answer/id #uuid "f4005a97-9254-5f58-a0f5-c75a5bbbac16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4g}{15}" :db/id #edb/ref 17592186274542}] :answer-field/correct {:answer/id #uuid "1c419ad3-8f0e-57be-8748-249953a12c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8g}{3}" :db/id #edb/ref 17592186272633} :answer-field/id #uuid "611519a7-0326-5a3d-b26e-01b722addb01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274803}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7b45625-1cac-5462-8fbc-e99fa13fa49c" :question/math-academy-id "q-14432" :question/problem "$\\frac{4}{5g}÷\\frac{3}{10{g}^{2}}=$" :question/worked-solution "To compute\n\n$$\n\\frac{4}{5g}÷\\frac{3}{10{g}^{2}},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{4}{5g}÷\\frac{3}{10{g}^{2}} & = \\\\ \\frac{4}{5g}\\cdot \\frac{10{g}^{2}}{3} & = \\\\ \\frac{4}{\\cancel{5}\\cdot \\cancel{g}}\\cdot \\frac{\\cancel{5}\\cdot 2\\cdot {g}^{\\cancel{2}}}{3} & = \\\\ 4\\cdot \\frac{2g}{3} & = \\\\ \\frac{8g}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186538965 :knowledge-point/_questions [{:db/id #edb/ref 17592186068764 :knowledge-point/id #uuid "7bc27633-cfde-532e-a38a-28d195fd2a5b" :knowledge-point/title "Dividing Rational Expressions and Simplifying the Result by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24240d5d-9699-58fb-8663-ef448a1296b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+8" :db/id #edb/ref 17592186538305} {:answer/id #uuid "aafbf437-5412-58dc-86e3-6f4bc151f85e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x-5}" :db/id #edb/ref 17592186538633} {:answer/id #uuid "b1b02b83-478f-5565-a598-0b24437db7e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-5}{x+8}" :db/id #edb/ref 17592186538646} {:answer/id #uuid "e9718652-7a2a-51d9-93d2-a20b22cde1b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186538763} {:answer/id #uuid "fec52fe6-cb5d-5c54-b138-3ee0039ec4da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/m