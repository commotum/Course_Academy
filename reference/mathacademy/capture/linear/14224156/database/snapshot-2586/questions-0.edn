}{\\cancel{2n-6}}\\cdot \\frac{5\\cancel{(2n-6)}}{\\cancel{4n}} & = \\\\ 2\\cdot 5 & = \\\\ 10\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069501 :knowledge-point/_questions [{:db/id #edb/ref 17592186068759 :knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2" :knowledge-point/title "Dividing Rational Expressions with a Single Common Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b50dfdf7-8857-5c81-86e1-ab156863e446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15x}{8}" :db/id #edb/ref 17592186068177} {:answer/id #uuid "46b2ef80-9a66-596b-b82c-62ba6d9db3f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186068178} {:answer/id #uuid "699507e5-dbe9-500d-b628-50a2c020569a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{15}" :db/id #edb/ref 17592186068180} {:answer/id #uuid "6c2218cc-e7d1-5950-a8c1-23a19628e3b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{15z}" :db/id #edb/ref 17592186068181} {:answer/id #uuid "504e0f2a-072f-5b1b-b073-c5b324045add" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x{z}^{2}}{20}" :db/id #edb/ref 17592186538405}] :answer-field/correct {:answer/id #uuid "b50dfdf7-8857-5c81-86e1-ab156863e446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15x}{8}" :db/id #edb/ref 17592186068177} :answer-field/id #uuid "3de203fc-783b-5935-9ac5-c4ced5ae123a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186068176}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5dfcab98-cba3-546d-aba3-178a79398a49" :question/math-academy-id "q-69925" :question/problem "$\\frac{3xz}{4}÷\\frac{2z}{5}=$" :question/worked-solution "To compute\n\n$$\n\\frac{3xz}{4}÷\\frac{2z}{5},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{3xz}{4}÷\\frac{2z}{5} & = \\\\ \\frac{3xz}{4}\\cdot \\frac{5}{2z} & = \\\\ \\frac{15xz}{8z} & = \\\\ \\frac{15x\\cancel{z}}{8\\cancel{z}} & = \\\\ \\frac{15x}{8} & \\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $z$ in the numerator and denominator."}] [{:db/id #edb/ref 17592186069503 :knowledge-point/_questions [{:db/id #edb/ref 17592186068763 :knowledge-point/id #uuid "993a1649-c534-5a08-805f-3388c2f83b20" :knowledge-point/title "Dividing Rational Expressions with No Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af2c7545-0451-5650-a5ee-5ce78934bb2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5b}{14a}" :db/id #edb/ref 17592186068189} {:answer/id #uuid "b08d49d1-afb8-5b7f-8e54-52a31f7bf52c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5ab}{7}" :db/id #edb/ref 17592186068190} {:answer/id #uuid "21ccfac9-6446-510b-9480-3adfd50163e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5ab}{14}" :db/id #edb/ref 17592186068191} {:answer/id #uuid "256e53f7-83ac-59c1-b6b5-154da604264e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2ab}{10}" :db/id #edb/ref 17592186068192} {:answer/id #uuid "43671ebb-f87e-5d7c-aae5-72d6ceb5c415" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5a}{14b}" :db/id #edb/ref 17592186068193}] :answer-field/correct {:answer/id #uuid "21ccfac9-6446-510b-9480-3adfd50163e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5ab}{14}" :db/id #edb/ref 17592186068191} :answer-field/id #uuid "8f68fc8f-c074-5982-9412-9c3d56d22f64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186068188}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f813024f-885c-5619-a6ed-c7af16a7f48d" :question/math-academy-id "q-69965" :question/problem "$\\frac{5b}{7}÷\\frac{2}{a}=$" :question/worked-solution "To compute\n\n$$\n\\frac{5b}{7}÷\\frac{2}{a},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{5b}{7}÷\\frac{2}{a} & = \\\\ \\frac{5b}{7}\\cdot \\frac{a}{2} & = \\\\ \\frac{5ab}{14} & \\end{aligned}\n$$"}]}
