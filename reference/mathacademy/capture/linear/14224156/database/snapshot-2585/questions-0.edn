#{[{:db/id #edb/ref 17592186068597 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068759 :knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2" :knowledge-point/title "Dividing Rational Expressions with a Single Common Factor"}] :question/id #uuid "4fba84c9-6c0f-51cd-b5f2-8b469bd8346f" :question/math-academy-id "e-5135" :question/problem "What is the result of dividing $\\dfrac 3 x$ by $\\dfrac y {6x^2}$?" :question/worked-solution "To compute\n\n$$\n\\dfrac{3}{x} \\div \\dfrac{y}{6x^2}\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\require{cancel} \\begin{aligned} \\dfrac 3 x \\div \\dfrac y {6x^2} &=\\ \\dfrac 3 x \\cdot \\dfrac {6x^2} y &=\\ \\dfrac {18x^2} {xy}&=\\ \\dfrac {18x^\\cancel{2}} {\\cancel{x}y}&=\\ \\dfrac {18x} {y}& \\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $x$ in the numerator and denominator."}] [{:db/id #edb/ref 17592186068598 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068760 :knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f" :knowledge-point/title "Dividing Rational Expressions with Multiple Common Factors"}] :question/id #uuid "fa6bbedb-654a-58a5-8fcf-3bb0fd038160" :question/math-academy-id "e-5136" :question/problem "Given that $\\dfrac {2a^2(1+b)} {3b} =x$ and $\\dfrac {1+b}{5b^2} =y$, then what is $x \\div y$?" :question/worked-solution "To compute $x \\div y$, i.e.,\n\n$$\n(2a^{2}(1 + b))/(3b) \\mid \\div \\frac{1 + b}{5b^{2}}\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\require{cancel} \\begin{aligned} \\dfrac {2a^2(1+b)} {3b} \\div \\dfrac{1+b}{5b^2} \\\\[5pt] &= \\dfrac {2a^2(1+b)} {3b} \\cdot \\dfrac {5b^2} {1+b} \\\\[5pt] &= \\dfrac {2a^2\\cancel{(1+b)}} {3\\cancel{b}} \\cdot \\dfrac {5b^{\\cancel{2}}} {\\cancel{1+b}} \\\\[5pt] &= \\dfrac {10a^2b} {3} \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068604 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068763 :knowledge-point/id #uuid "993a1649-c534-5a08-805f-3388c2f83b20" :knowledge-point/title "Dividing Rational Expressions with No Common Factors"}] :question/id #uuid "dd8b5378-4da1-5955-a566-f84ef0cecb28" :question/math-academy-id "e-5206" :question/problem "What is the result of dividing $\\dfrac 3 x$ by $\\dfrac {5}{y}$?" :question/worked-solution "To compute\n\n$$\n\\dfrac{3}{x} \\div \\dfrac{5}{y}\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned} \\dfrac 3 x \\div \\dfrac 5 y&=\\ \\dfrac 3 x \\cdot \\dfrac y 5&=\\ \\dfrac {3y} {5x} \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068605 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186068764 :knowledge-point/id #uuid "7bc27633-cfde-532e-a38a-28d195fd2a5b" :knowledge-point/title "Dividing Rational Expressions and Simplifying the Result by Factoring"}] :question/id #uuid "3fd58494-e5ee-5dc7-af3c-959888f59627" :question/math-academy-id "e-5207" :question/problem "Given that $\\dfrac {2a^3 - 10a} {7b} =x$ and $\\dfrac {2a} {14b^2}=y$, then what is $x \\div y$?" :question/worked-solution "To compute\n\n$$\n\\require{cancel} \\begin{aligned} \\dfrac {2a^3 - 10a} {7b} &\\div \\dfrac {2a} {14b^2}, \\end{aligned}\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\require{cancel} \\begin{aligned} \\dfrac {2a^3 - 10a} {7b} \\div \\dfrac {2a} {14b^2}&=\\ \\dfrac {2a^3 - 10a} {7b} \\cdot \\dfrac {14b^2} {2a}&=\\ \\dfrac {2a(a^2 - 5)} {7b} \\cdot \\dfrac {2b \\cdot 7b} {2a}&=\\ \\dfrac {\\cancel{2a}(a^2 - 5)} {\\cancel{7b}} \\cdot \\dfrac {2b \\cdot \\cancel{7b}} {\\cancel{2a}}&=\\ \\dfrac {2b(a^2 - 5)} 1 \\\\ &= 2a^2b - 10b & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233189 :knowledge-point/_questions [{:db/id #edb/ref 17592186068759 :knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2" :knowledge-point/title "Dividing Rational Expressions with a Single Common Factor"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97895caf-82df-5b95-8916-1e87ffb09dd3" :question/math-academy-id "q-113809" :question/problem "$\\frac{2{w}^{2}}{3}÷\\frac{w(w+2)}{7}=$" :question/worked-solution "To compute\n\n$$\n\\frac{2{w}^{2}}{3}÷\\frac{w(w+2)}{7},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{2{w}^{2}}{3}÷\\frac{w(w+2)}{7} & = \\\\ \\frac{2{w}^{2}}{3}\\cdot \\frac{7}{w(w+2)} & = \\\\ \\frac{14{w}^{2}}{3w(w+2)} & = \\\\ \\frac{14{w}^{\\cancel{2}}}{3\\cancel{w}(w+2)} & = \\\\ \\frac{14w}{3(w+2)}\\end{aligned}\n$$\n\nNote that we canceled out a common factor of $w$ in the numerator and denominator."}] [{:db/id #edb/ref 17592186275147 :knowledge-point/_questions [{:db/id #edb/ref 17592186068760 :knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f" :knowledge-point/title "Dividing Rational Expressions with Multiple Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06368d8d-e8cc-5093-b179-f46913edb67d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{g}" :db/id #edb/ref 17592186272444} {:answer/id #uuid "140af3f2-c890-5051-8864-91381615cd30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2g}" :db/id #edb/ref 17592186272567} {:answer/id #uuid "1c419ad3-8f0e-57be-8748-249953a12c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8g}{3}" :db/id #edb/ref 17592186272633} {:answer/id #uuid "7d59d9bf-e572-570b-8b5b-7f29aac90361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{g}^{2}}{3}" :db/id #edb/ref 17592186273460} {:answer/id #uuid "f4005a97-9254-5f58-a0f5-c75a5bbbac16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4g}{15}" :db/id #edb/ref 17592186274542}] :answer-field/correct {:answer/id #uuid "1c419ad3-8f0e-57be-8748-249