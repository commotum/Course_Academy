e {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186317951} :answer-field/id #uuid "81bb20a8-4dcb-5a95-8da7-061efc713959" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318707}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92034418-3c29-508e-a258-197f92ef596d" :question/math-academy-id "q-3498" :question/problem "$\\frac{8n}{2n-6}÷\\frac{4n}{10n-30}=$" :question/worked-solution "To compute\n\n$$\n\\frac{8n}{2n-6}÷\\frac{4n}{10n-30},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{8n}{2n-6}÷\\frac{4n}{10n-30} & = \\\\ \\frac{8n}{2n-6}\\cdot \\frac{10n-30}{4n} & = \\\\ \\frac{4n\\cdot 2}{2n-6}\\cdot \\frac{5(2n-6)}{4n} & = \\\\ \\frac{\\cancel{4n}\\cdot 2}{\\cancel{2n-6}}\\cdot \\frac{5\\cancel{(2n-6)}}{\\cancel{4n}} & = \\\\ 2\\cdot 5 & = \\\\ 10\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069501 :knowledge-point/_questions [{:db/id #edb/ref 17592186068759 :knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2" :knowledge-point/title "Dividing Rational Expressions with a Single Common Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b50dfdf7-8857-5c81-86e1-ab156863e446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15x}{8}" :db/id #edb/ref 17592186068177} {:answer/id #uuid "46b2ef80-9a66-596b-b82c-62ba6d9db3f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186068178} {:answer/id #uuid "48bd583c-2946-5964-aa99-ddb03b234405" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6xz^{2}}{20}" :db/id #edb/ref 17592186068179} {:answer/id #uuid "699507e5-dbe9-500d-b628-50a2c020569a" :answer/type {:db/id #