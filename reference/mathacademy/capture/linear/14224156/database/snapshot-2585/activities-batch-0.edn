#{[{:activity/first-step {:db/id #edb/ref 17592186069666} :activity/id #uuid "4e45d2a1-007b-509d-b770-229fc56c4b28" :activity/scope {:db/id #edb/ref 17592186048690 :topic/id #uuid "b509a5b3-8f62-5764-bc7b-a50a3299e6fc" :topic/math-academy-id 436} :activity/steps [{:db/id #edb/ref 17592186069666 :step/content {:db/id #edb/ref 17592186069973 :tutorial/content "To divide one rational expression by another, we multiply by the reciprocal of the divisor. Just like with fractions!\n\nFor example, let's divide $x$ by\n\n$$\n\\dfrac{3}{y}\n$$\n\n$$\nx \\div \\dfrac{3}{y}\n$$\n\nTo do this, we just need to multiply by the reciprocal of the divisor. The divisor is\n\n$$\n\\dfrac{3}{y}\n$$\n\nand to get the reciprocal, we just flip the fraction upside down:\n\n$$\n\\dfrac{y}{3}\n$$\n\nMultiplying by the reciprocal of the divisor, we get\n\n$$\n\\begin{aligned}\nx \\div \\frac{3}{y} &=  \\\\\nx \\cdot \\frac{y}{3} &=  \\\\\n&= \\frac{xy}{3} \\mid\n\\end{aligned}\n$$\n\nLet's see some more examples!" :tutorial/id #uuid "67b283bf-2859-595a-bacb-ebf32b5f7275" :tutorial/math-academy-id 3379 :tutorial/title "Introduction"} :step/id #uuid "0bae9405-6215-5c1d-baf4-ecc1e0c56c25" :step/math-academy-id 18885 :step/next {:db/id #edb/ref 17592186069672}} {:db/id #edb/ref 17592186069667 :step/content {:db/id #edb/ref 17592186068759 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068597 :question/id #uuid "4fba84c9-6c0f-51cd-b5f2-8b469bd8346f" :question/math-academy-id "e-5135"} :knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2" :knowledge-point/questions [{:db/id #edb/ref 17592186069500} {:db/id #edb/ref 17592186069501} {:db/id #edb/ref 17592186233189} {:db/id #edb/ref 17592186233190} {:db/id #edb/ref 17592186233191} {:db/id #edb/ref 17592186234269} {:db/id #edb/ref 17592186250117} {:db/id #edb/ref 17592186338781}] :knowledge-point/title "Dividing Rational Expressions with a Single Common Factor"} :step/id #uuid "6310fcb8-9669-5e4a-bc52-fc49357ab1b2" :step/math-acad