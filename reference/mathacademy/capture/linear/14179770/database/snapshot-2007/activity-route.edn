#{[{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186495251} :activity/id #uuid "c1215756-a0c0-5b05-bb70-32ae79c955b4" :activity/scope {:db/id #edb/ref 17592186050622 :topic/id #uuid "59bac138-6475-51d1-971d-3bd216b92f3c" :topic/math-academy-id 356} :activity/steps [{:db/id #edb/ref 17592186495251 :step/content {:db/id #edb/ref 17592186495060 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30bc4eb9-206e-5878-a8f0-6d3c2752521a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6c}{5}" :db/id #edb/ref 17592186494415} {:answer/id #uuid "3b0f64e1-9ba9-5de5-968c-21a2b8c1abe8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4c}{5}" :db/id #edb/ref 17592186494441} {:answer/id #uuid "77627a96-f8aa-5bce-bdbe-ab14bc8f3202" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7c}{5}" :db/id #edb/ref 17592186494575} {:answer/id #uuid "84cad270-ffb9-54b7-ab0b-714c6f9ff0a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2c}{5}" :db/id #edb/ref 17592186494611} {:answer/id #uuid "afd965a8-0cc0-5acc-b8a9-26911d6de0b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3c}{5}" :db/id #edb/ref 17592186494728}] :answer-field/correct {:db/id #edb/ref 17592186494415} :answer-field/id #uuid "ce86109f-c522-5257-a1af-0a30eb61a2af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495017}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "131ccfe9-849e-53c3-a3f1-91aed4a65240" :question/math-academy-id "q-22237" :question/problem "If $b-5c=c-4b,$ then $b=$" :question/worked-solution "We need to isolate the variable $b.$ To do this, we treat $c$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we add $4b$ to both sides of the equation:\n\n$$\n\\begin{aligned}b-5c & =c-4b \\\\ b-5c+4b & =c-4b+4b \\\\ b+4b-5c & =c-4b+4b \\\\ 5b-5c & =c\\end{aligned}\n$$\n\nThen, we add $5c$ to both sides of the equation:\n\n$$\n\\begin{aligned}5b-5c & =c \\\\ 5b-5c+5c & =c+5c \\\\ 5b & =6c\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $5:$\n\n$$\n\\begin{aligned}5b & =6c \\\\ \\frac{5b}{5} & =\\frac{6c}{5} \\\\ \\frac{\\cancel{5}b}{\\cancel{5}} & =\\frac{6c}{5} \\\\ b & =\\frac{6c}{5}\\end{aligned}\n$$"} :step/id #uuid "c76c91ea-1fa5-50f4-8d7c-4155dbbf366c" :step/next {:db/id #edb/ref 17592186495259}} {:db/id #edb/ref 17592186495259 :step/content {:db/id #edb/ref 17592186495052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b21b33-50e5-5cbe-9b22-24f73902555e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+2y}{3}" :db/id #edb/ref 17592186494322} {:answer/id #uuid "15ea45d4-5b0c-536f-977e-e4f7ad0b6a37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+6y" :db/id #edb/ref 17592186494357} {:answer/id #uuid "cabe9447-7e18-5fc2-b800-d12efc44ec31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3-6y" :db/id #edb/ref 17592186494798} {:answer/id #uuid "eb9cf60f-e518-550d-b474-33adf1d185b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2y-1}{3}" :db/id #edb/ref 17592186494878} {:answer/id #uuid "f0e2634c-f79a-5536-b6e7-b72d016dd451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3-2y" :db/id #edb/ref 17592186494889}] :answer-field/correct {:db/id #edb/ref 17592186494357} :answer-field/id #uuid "b4aba618-e4e2-5bd3-9df6-670dd46cecef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495003}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "041420d0-7112-5aa8-8e70-44b04f8459e6" :question/math-academy-id "q-135011" :question/problem "If $\\frac{z}{3}-2y=1$ then $z=$" :question/worked-solution "We need to isolate the variable $z.$ To do this, we treat $y$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we add $2y$ to both sides of the equation:\n\n$$\n\\begin{aligned}\\frac{z}{3}-2y & =1 \\\\ \\frac{z}{3}-2y+2y & =1+2y \\\\ \\frac{z}{3} & =1+2y\\end{aligned}\n$$\n\nThen, we multiply both sides of the equation by $3:$\n\n$$\n\\begin{aligned}\\frac{z}{3} & =1+2y \\\\ 3\\cdot \\frac{z}{3} & =3\\cdot (1+2y) \\\\ \\cancel{3}\\cdot \\frac{z}{\\cancel{3}} & =3\\cdot (1+2y) \\\\ z & =3\\cdot (1+2y) \\\\ z & =3\\cdot 1+3\\cdot 2y \\\\ z & =3+6y\\end{aligned}\n$$"} :step/id #uuid "dc32766e-e6b6-52c0-84bc-2ef3316dead6" :step/next {:db/id #edb/ref 17592186495270}} {:db/id #edb/ref 17592186495270 :step/content {:db/id #edb/ref 17592186495079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57e54aa5-0ae5-5529-8641-8aded4a5dfa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2y}{3}" :db/id #edb/ref 17592186494496}] :answer-field/correct {:db/id #edb/ref 17592186494496} :answer-field/id #uuid "c06f8f1f-3ac5-52a2-ba1c-01d871adb3a0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186495007}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "42436934-3a89-50ee-8455-624cf79683ae" :question/math-academy-id "q-176587" :question/problem "Given that $2x-y=y-x,$ express $x$ in terms of $y.$\n\n$x=$\n{{field-1}}" :question/worked-solution "We need to isolate the variable $x.$ To do this, we treat $y$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we add $y$ to both sides of the equation:\n\n$$\n\\begin{aligned}2x-y & =y-x \\\\ 2x-y+y & =y-x+y \\\\ 2x & =-x+2y\\end{aligned}\n$$\n\nThen, we add $x$ to both sides of the equation:\n\n$$\n\\begin{aligned}2x & =-x+2y \\\\ 2x+x & =-x+2y+x \\\\ 3x & =2y\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $3:$\n\n$$\n\\begin{aligned}3x & =2y \\\\ \\frac{3x}{3} & =\\frac{2y}{3} \\\\ \\frac{\\cancel{3}x}{\\cancel{3}} & =\\frac{2y}{3} \\\\ x & =\\frac{2y}{3}\\end{aligned}\n$$"} :step/id #uuid "f6f165f3-2e0f-519e-8f2f-88ed8efb2170"}] :activity/title "Solving Two-Variable Equations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494316}]}
