#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186069625} :activity/id #uuid "155e5337-d5e8-53d9-b3b1-ee0f86219c05" :activity/scope {:db/id #edb/ref 17592186050511 :topic/id #uuid "4f6afc08-f23d-50b8-a5e5-a6052d6e4308" :topic/math-academy-id 391} :activity/steps [{:db/id #edb/ref 17592186069625 :step/content {:db/id #edb/ref 17592186070028 :tutorial/content "What is the value of $x$ that satisfies the following equation?\n\n$$\n3^x = 3^4\n$$\n\nWe call this an **exponential equation** because the variable is contained within the exponent. \n\nNow, this equation is pretty easy to solve. Because the bases on both sides of the equation are the same (they are both equal to $3$), we can simply equate the powers.\n\n$$\n\\begin{aligned}{3}^{x} & ={3}^{4} \\\\ x & =4\\end{aligned}\n$$\n\nTherefore, the solution to this equation is $x=4.$" :tutorial/id #uuid "1fc010d0-e380-5035-bdb6-5d5d7cff060b" :tutorial/math-academy-id 8837 :tutorial/title "Introduction"} :step/id #uuid "ddaa7aab-6a5c-5c05-989d-9d15267eceec" :step/math-academy-id 170031 :step/next {:db/id #edb/ref 17592186069626}} {:db/id #edb/ref 17592186069626 :step/content {:db/id #edb/ref 17592186068731 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068495 :question/id #uuid "4912a540-482c-51be-bdc4-8fb128ddfb77" :question/math-academy-id "e-14246"} :knowledge-point/id #uuid "f1e0a7d0-f891-5f5f-8d8d-1ced62b2899e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725} {:db/id #edb/ref 17592186049714}] :knowledge-point/questions [{:db/id #edb/ref 17592186069155} {:db/id #edb/ref 17592186069474} {:db/id #edb/ref 17592186488215} {:db/id #edb/ref 17592186488218} {:db/id #edb/ref 17592186488241} {:db/id #edb/ref 17592186488279}] :knowledge-point/title "Solving an Exponential Equation"} :step/id #uuid "d2856989-c0e4-57bc-927d-5351b29a50a4" :step/math-academy-id 170032 :step/next {:db/id #edb/ref 17592186069627}} {:db/id #edb/ref 17592186069627 :step/content {:db/id #edb/ref 17592186070029 :tutorial/content "Let's take a look at the following equation: \n\n$$\n5^x = 25\n$$\n\nWe can't solve this equation straight off the bat because the two sides of the equation don't share a common base.\n\nHowever, notice that $25$ can be written as a power of $5\\mathbin{:}$\n\n$$\n25=5^2\n$$\n\nTherefore, we can rewrite the equation as\n\n$$\n5^x = 5^2.\n$$\n\nSince both sides of the equation are now written as an exponential expression with a common base of $5,$ we can set the exponents equal to each other and solve:\n\n$$\n\\begin{aligned}{5}^{x} & ={5}^{2} \\\\ x & =2\\end{aligned}\n$$\n\nTo check that the solution is correct, we plug $x=2$ into the original equation:\n\n$$\n\\eqalign{\n\t\t5^{2} &= 25 \\\n\t\t25 &= 25 \\; {\\color{green}{\\checkmark}}\n\t}\n$$" :tutorial/id #uuid "43789602-55db-50d6-8517-6be1716d6133" :tutorial/math-academy-id 8839 :tutorial/title "Changing the Base of an Expression"} :step/id #uuid "792c4b4f-5718-5101-aad6-254e3d0f1a1c" :step/math-academy-id 170035 :step/next {:db/id #edb/ref 17592186069628}} {:db/id #edb/ref 17592186069628 :step/content {:db/id #edb/ref 17592186068732 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068496 :question/id #uuid "bc9650d4-c12f-5e7a-b0b2-aacca9a9d698" :question/math-academy-id "e-14248"} :knowledge-point/id #uuid "7e0c15b8-dc6e-570d-9392-4c679395cc87" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048262} {:db/id #edb/ref 17592186050495}] :knowledge-point/questions [{:db/id #edb/ref 17592186069156} {:db/id #edb/ref 17592186069157} {:db/id #edb/ref 17592186069358} {:db/id #edb/ref 17592186488260} {:db/id #edb/ref 17592186488284}] :knowledge-point/title "Solving an Exponential Equation by Changing the Base"} :step/id #uuid "6ed2b746-5c94-5683-9d52-e609dd44d3af" :step/math-academy-id 170036 :step/next {:db/id #edb/ref 17592186069629}} {:db/id #edb/ref 17592186069629 :step/content {:db/id #edb/ref 17592186068733 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068497 :question/id #uuid "9a971439-a68b-58e5-a8f3-51045b2a0bf0" :question/math-academy-id "e-14252"} :knowledge-point/id #uuid "368d83db-e01e-543b-ba45-8fc9c63242e9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673}] :knowledge-point/questions [{:db/id #edb/ref 17592186069122} {:db/id #edb/ref 17592186069158} {:db/id #edb/ref 17592186069523} {:db/id #edb/ref 17592186488240}] :knowledge-point/title "Rearranging and Solving an Exponential Equation"} :step/id #uuid "a3c641ad-5eab-5dde-a062-3feb7d161f4c" :step/math-academy-id 170040}] :activity/title "Solving Exponential Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068938}]}
