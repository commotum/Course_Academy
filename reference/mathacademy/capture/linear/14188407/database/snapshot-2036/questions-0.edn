#{[{:db/id #edb/ref 17592186501151 :knowledge-point/_questions [{:db/id #edb/ref 17592186068733 :knowledge-point/id #uuid "368d83db-e01e-543b-ba45-8fc9c63242e9" :knowledge-point/title "Rearranging and Solving an Exponential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "026f7618-75a1-5a04-a1b5-19a4dc5bf3a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186500474} {:answer/id #uuid "927ec64f-f546-590f-a4a2-b25b5259079e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186500771} {:answer/id #uuid "b2009e5a-bca1-5305-a255-000d7c669780" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{3}" :db/id #edb/ref 17592186500839} {:answer/id #uuid "dbbbb42e-e930-5fd7-b9c9-d3dc2136d8ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186500935} {:answer/id #uuid "f58f8a6d-120b-534f-bcf9-f4589ff32814" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=8" :db/id #edb/ref 17592186500991}] :answer-field/correct {:answer/id #uuid "026f7618-75a1-5a04-a1b5-19a4dc5bf3a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186500474} :answer-field/id #uuid "8ea04aaa-60fe-5164-9b6a-5f1f5daacdc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501081}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "21ccfd77-b3db-57e5-9298-b5b4966f212d" :question/math-academy-id "q-64060" :question/problem "Solve the equation $3\\cdot {2}^{y}=24.$" :question/worked-solution "First, we isolate the term with the variable exponent by dividing both sides by $3$:\n\n$$\n\\begin{aligned}3\\cdot {2}^{y} & =24 \\\\ \\frac{3\\cdot {2}^{y}}{3} & =\\frac{24}{3} \\\\ {2}^{y} & =8\\end{aligned}\n$$\n\nNow, we rewrite $8$ as ${2}^{3}$ to get:\n\n$$\n\\begin{aligned}{2}^{y} & =8 \\\\ {2}^{y} & ={2}^{3}\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base $(2)$, we equate the exponents:\n\n$$\n\\begin{aligned}{2}^{y} & ={2}^{3} \\\\ y & =3\\end{aligned}\n$$\n\nTherefore, the solution is $y=3.$"}] [{:db/id #edb/ref 17592186501198 :knowledge-point/_questions [{:db/id #edb/ref 17592186068732 :knowledge-point/id #uuid "7e0c15b8-dc6e-570d-9392-4c679395cc87" :knowledge-point/title "Solving an Exponential Equation by Changing the Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aa42764-8a55-5dbc-bccf-f7cea3894ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-1" :db/id #edb/ref 17592186500618} {:answer/id #uuid "b2001155-eb5c-5cb3-bb2c-450902eb3479" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=3" :db/id #edb/ref 17592186500838} {:answer/id #uuid "b6c8da6c-3a4b-5500-9638-fe300ced4dc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-2" :db/id #edb/ref 17592186500848} {:answer/id #uuid "eb8af3a9-b131-5b59-8cf5-ff99c1204dc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2" :db/id #edb/ref 17592186500971} {:answer/id #uuid "fcdebc72-280c-5c16-b415-95987a0b52ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=1" :db/id #edb/ref 17592186501005}] :answer-field/correct {:answer/id #uuid "4aa42764-8a55-5dbc-bccf-f7cea3894ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=-1" :db/id #edb/ref 17592186500618} :answer-field/id #uuid "70045a59-b4d4-5586-bd99-bd10111a9b0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501065}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d01c4ee-dae1-5984-a9e0-aab6ea21f976" :question/math-academy-id "q-64096" :question/problem "Solve the equation ${2}^{z}=\\frac{1}{2}.$" :question/worked-solution "First, we rewrite $\\frac{1}{2}$ as ${2}^{-1}$ to get:\n\n$$\n\\begin{aligned}{2}^{z} & =\\frac{1}{2} \\\\ {2}^{z} & ={2}^{-1}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(2)$, we equate the exponents:\n\n$$\n\\begin{aligned}{2}^{z} & ={2}^{-1} \\\\ z & =-1\\end{aligned}\n$$\n\nTherefore, the solution is $z=-1.$"}] [{:db/id #edb/ref 17592186501221 :knowledge-point/_questions [{:db/id #edb/ref 17592186068732 :knowledge-point/id #uuid "7e0c15b8-dc6e-570d-9392-4c679395cc87" :knowledge-point/title "Solving an Exponential Equation by Changing the Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d95c0c5-ace6-53b1-8acd-f4567066b531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5" :db/id #edb/ref 17592186500529} {:answer/id #uuid "2bd93094-e14e-5a07-917e-a7afe75bc4f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186500556} {:answer/id #uuid "4cb2ba71-a137-5a99-8edd-1849eaa61229" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186500622} {:answer/id #uuid "ad6a4066-b9ea-53d1-a1ca-0d161468d3c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186500825} {:answer/id #uuid "d602709b-da4a-5d8a-9f5c-30e950209408" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186500925}] :answer-field/correct {:answer/id #uuid "4cb2ba71-a137-5a99-8edd-1849eaa61229" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186500622} :answer-field/id #uuid "fee5e589-c054-5eb6-8af3-cb3f2d4d13a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501134}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c1a2b990-ffe2-5008-9b55-fe50c6e1b0a9" :question/math-academy-id "q-72" :question/problem "Solve the equation ${5}^{x}=\\frac{1}{5}.$" :question/worked-solution "First, we rewrite $\\frac{1}{5}$ as ${5}^{-1}$ to get:\n\n$$\n\\begin{aligned}{5}^{x} & =\\frac{1}{5} \\\\ {5}^{x} & ={5}^{-1}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(5)$, we equate the exponents:\n\n$$\n\\begin{aligned}{5}^{x} & ={5}^{-1} \\\\ x & =-1\\end{aligned}\n$$\n\nTherefore, the solution is $x=-1.$"}]}
