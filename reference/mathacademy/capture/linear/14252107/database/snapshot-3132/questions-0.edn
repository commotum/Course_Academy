#{[{:db/id #edb/ref 17592186573252 :knowledge-point/_questions [{:db/id #edb/ref 17592186096654 :knowledge-point/id #uuid "711d0e70-a248-5f93-a836-43bed5435d4f" :knowledge-point/title "Subtracting Two Vectors Using the Triangle Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39706a6d-e9a6-5650-b5b2-4d251ac0aa89" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d4/d4a39433da61674389a83f6d43b44f0ecbf129cf264879b863934f383897d9ab.png" :db/id #edb/ref 17592186572884} {:answer/id #uuid "4dc35e4c-9a9c-5ceb-a076-e19bcff1531f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/86/867d2f76ab683e7c5ae703f99e2a229e8fbbc0951f3d75ef880a6cea3e110f21.png" :db/id #edb/ref 17592186572914} {:answer/id #uuid "611a8a2b-1562-5fd6-98e4-b824b2c679fc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a7/a7f080d33b393ffe9742aa14bc05116a5dec270802529e3d0d57133914a5390c.png" :db/id #edb/ref 17592186572938} {:answer/id #uuid "8912cd22-1c74-5633-8023-b8ecb0a0fad5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/24/24956401d3bd15e50cd6396fdd6eb99c267d7d810965631c85cdb9b34d525a89.png" :db/id #edb/ref 17592186573001} {:answer/id #uuid "e27d143e-c634-541c-b918-53132ea5460b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bf/bf733d5afc13934a4d75a0fce57a0b6f96ffd9d5032200bb105adb2cc87d73dc.png" :db/id #edb/ref 17592186573114}] :answer-field/correct {:answer/id #uuid "611a8a2b-1562-5fd6-98e4-b824b2c679fc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a7/a7f080d33b393ffe9742aa14bc05116a5dec270802529e3d0d57133914a5390c.png" :db/id #edb/ref 17592186572938} :answer-field/id #uuid "79a697f6-597e-5bb5-9a8f-fc97fd26f368" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573191}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "06291cf0-d6c5-5a7a-a5c7-3922a0916c3b" :question/math-academy-id "q-11749" :question/problem "![](images/e0/e0caa2bd7ac6b620ec267d3cc50493701af1f2d6718ddcb090c71f408d2a82ab.png)\n\nThe vectors $\\text{b}$ and $\\text{c}$ are shown in the diagram above. Which of the following could be $-b+c.$" :question/worked-solution "We interpret  $-b+c$ as the addition\n\n$$\n(-b)+c,\n$$\n\nwhere $-b$ is the vector that has the same magnitude as $b$ but goes in the direction *opposite* of $b.$\n\nFinally, we use the triangle law to add the vectors $-b$ and $c:$ \n\n- We can start $-b$ from an arbitrary point on the plane.\n\n- Next, we draw the vector that is equal to $c$ and has its tail placed at the head of $-b.$\n\n- Now, according to the triangle law of addition, the resultant is the vector that goes from the tail of $-\\text{b}$ to the head of $\\text{c}$, as shown below.\n\n![](images/87/873334db27c4cf2d85d262d98050941307026fb7b0341d5c871a5ad8eb565313.png)"}] [{:db/id #edb/ref 17592186573292 :knowledge-point/_questions [{:db/id #edb/ref 17592186184321 :knowledge-point/id #uuid "de2b7926-fa13-5636-9682-8fa382336be7" :knowledge-point/title "Simplifying a Cube Root Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17152414-1ddb-5e41-9abb-42921b68db62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{15a{b}^{2}}" :db/id #edb/ref 17592186572848} {:answer/id #uuid "5d1c0afa-44a7-534c-9aa8-dbc746816bd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{5}ab" :db/id #edb/ref 17592186572929} {:answer/id #uuid "724b9d8c-8955-5a21-ab47-bd79bfc2648c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{15ab}" :db/id #edb/ref 17592186572965} {:answer/id #uuid "7b5ba170-762f-5afc-ac78-ade8780eeb8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15ab" :db/id #edb/ref 17592186572981} {:answer/id #uuid "860c6ce0-0936-5949-979e-21b5c6244968" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{3}ab" :db/id #edb/ref 17592186572996}] :answer-field/correct {:answer/id #uuid "17152414-1ddb-5e41-9abb-42921b68db62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{15a{b}^{2}}" :db/id #edb/ref 17592186572848} :answer-field/id #uuid "11331198-c809-57a2-b886-e3b7b744c7fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573153}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "90e80b30-af1b-594f-ba5d-4e938ac90b8f" :question/math-academy-id "q-141914" :question/problem "$\\sqrt[3]{3ab}\\cdot \\sqrt[3]{5b}=$" :question/worked-solution "We apply the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{3ab}\\cdot \\sqrt[3]{5b} & = \\\\ \\sqrt[3]{3ab\\cdot 5b} & = \\\\ \\sqrt[3]{15a{b}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573272 :knowledge-point/_questions [{:db/id #edb/ref 17592186064239 :knowledge-point/id #uuid "c9460289-3e48-558e-b149-3e12a25e50a6" :knowledge-point/title "Flipping the Sign of an Inequality in a System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e674786-3773-5608-a6fc-fb98f442c244" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p\\in (4,5)" :db/id #edb/ref 17592186572915} {:answer/id #uuid "6d46c113-ad6c-5e71-975b-24d9fa413748" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p\\in (-5,0)" :db/id #edb/ref 17592186572959} {:answer/id #uuid "a48122cf-62c6-51b8-baec-3d0e7d115657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p\\in (-4,4)" :db/id #edb/ref 17592186573035} {:answer/id #uuid "bc69fc81-dde3-504b-9bdc-e9632904c364" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no solution" :db/id #edb/ref 17592186573063} {:answer/id #uuid "e3c70cb9-1512-5f74-8095-ae65fd580c38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p\\in (5,\\infty )" :db/id #edb/ref 17592186573116}] :answer-field/correct {:answer/id #uuid "e3c70cb9-1512-5f74-8095-ae65fd580c38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p\\in (5,\\infty )" :db/id #edb/ref 17592186573116} :answer-field/id #uuid "f4b7ff8f-af4b-55e7-a7df-45025547835b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573245}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "46ac0cd5-cca2-5b10-8e71-7bc6828cb573" :question/math-academy-id "q-156126" :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}p-2>3 \\\\ 1-2p\\le -7\\end{aligned}\n$$" :question/worked-solution "To solve the system, we need to find the values of $p$ that satisfy both $p-2>3$ and $1-2p\\le -7$ simultaneously.\n\n- First, we solve $p-2>3\\,:$\n\n$$\n\\begin{aligned}p-2 & >3 \\\\ p-2+2 & >3+2 \\\\ p & >5\\end{aligned}\n$$\n\n![](images/11/1189f49b694afcfef7f10a19b523ebbcce3bb8ab13b69e60ebfd5a6c342ff10e.png)\n\n$$\n\n$$\n\n- Then, we solve $1-2p\\le -7\\,:$ \n\n$$\n\\begin{aligned}1-2p & \\le -7 \\\\ 1-2p-1 & \\le -7-1 \\\\ -2p & \\le -8 \\\\ (-1)\\cdot (-2p) & \\ge (-1)\\cdot (-8) \\\\ 2p & \\ge 8 \\\\ \\frac{2p}{2} & \\ge \\frac{8}{2} \\\\ p & \\ge 4\\end{aligned}\n$$\n\n![](images/f8/f8bf3ae94c8048dcf9060c985300f9a808ae73158eeeef6e0f01f3f922d33ea9.png)\n\nTo find the values of $p$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/1a/1a4cd0c86983a39354eef09ad60d44f3815c082f443a3eb12bd14f6232988f65.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $p\\in (5,\\infty ).$"}] [{:db/id #edb/ref 17592186573255 :knowledge-point/_questions [{:db/id #edb/ref 17592186105740 :knowledge-point/id #uuid "c9c2b7ee-d32b-550b-b110-81d04d750c98" :knowledge-point/title "Solving for a Variable Given Unknown Lengths in an Isosceles Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa42a462-2d42-54bc-8d5b-f4b3a4b564dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186573142}] :answer-field/correct {:answer/id #uuid "fa42a462-2d42-54bc-8d5b-f4b3a4b564dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186573142} :answer-field/id #uuid "b6d6b55c-d050-5c1b-be29-79f79339ccca" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573215}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a6c019b-459a-54b3-94ee-3cfc489e4bfd" :question/math-academy-id "q-171894" :question/problem "![](images/71/71434714d4941799da3859979b9a75950994efef09b523da00a6a11523e3b906.png)\n\nGiven that the triangle $△ABC$ shown above is isosceles, the measure of $\\overset{―}{AC}$ must be equal to{{field-1}}." :question/worked-solution "Since $△ABC$ is an isosceles triangle with base $\\overset{―}{AB}$, we have that $\\overset{―}{AC}≅\\overset{―}{CB}.$ Hence,\n\n$$\n\\begin{aligned}AC & =CB \\\\ 3x-9 & =2x-1 \\\\ x & =8.\\end{aligned}\n$$\n\nSubstituting this value into the expression for the measure of $\\overset{―}{AC}$ gives\n\n$$\n\\begin{aligned}AC & =3x-9 \\\\  & =3(8)-9 \\\\  & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573281 :knowledge-point/_questions [{:db/id #edb/ref 17592186138511 :knowledge-point/id #uuid "75d096f5-9834-5e52-a7eb-9aae72398d19" :knowledge-point/title "Simplifying Fractions with Unlike Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "880a7533-d27a-5209-9676-048622c816b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186572999}] :answer-field/correct {:answer/id #uuid "880a7533-d27a-5209-9676-048622c816b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186572999} :answer-field/id #uuid "4a8fb50b-f581-55fc-8b2e-6ae22914031e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573176} {:answer-field/choices [{:answer/id #uuid "72d3c220-e470-557e-bcd0-a9f8849b3dc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186572966}] :answer-field/correct {:answer/id #uuid "72d3c220-e470-557e-bcd0-a9f8849b3dc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186572966} :answer-field/id #uuid "54dab796-cb41-55f7-82f8-49c26b926e11" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573181}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64689025-90b1-5416-8d71-9bc463abeb1c" :question/math-academy-id "q-175584" :question/problem "$\\frac{7}{2}u+4w-\\frac{2}{3}u-w=${{field-1}}\n$u\\,+$\n{{field-2}}\n$w$" :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{7}{2}u+4w-\\frac{2}{3}u-w & = \\\\ (\\frac{7}{2}u-\\frac{2}{3}u)+(4w-w) & = \\\\ (\\frac{7}{2}-\\frac{2}{3})u+(4-1)w & = \\\\ (\\frac{21}{6}-\\frac{4}{6})u+3w & = \\\\ (\\frac{21-4}{6})u+3w & = \\\\ \\frac{17}{6}\\,u+3\\,w\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573324 :knowledge-point/_questions [{:db/id #edb/ref 17592186188244 :knowledge-point/id #uuid "278e33dd-6216-5cf9-9e52-e20924e0622b" :knowledge-point/title "Converting From Grams to Milligrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98aaef27-e9c7-59f1-9e36-1b5d0f4406ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "900" :db/id #edb/ref 17592186573022}] :answer-field/correct {:answer/id #uuid "98aaef27-e9c7-59f1-9e36-1b5d0f4406ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "900" :db/id #edb/ref 17592186573022} :answer-field/id #uuid "250a40f4-0b82-5e29-a71e-46fe4615e2b3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573165}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fa1ab2c6-2c4e-5cd2-a497-7648fbd76dfd" :question/math-academy-id "q-215010" :question/problem "What is $0.9\\,\\text{g}$ expressed in $\\text{mg}?$ Write your answer as a whole number.\n\n$0.9\\,\\text{g}=$\n{{field-1}}$\\text{mg}$" :question/worked-solution "We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\text{kg}$ | $1\\,\\text{kg}=1\\,000\\,\\text{g}$ |\n| Gram | $\\text{g}$ | Base Unit |\n| Milligram | $\\text{mg}$ | $1\\,000\\,\\text{mg}=1\\,\\text{g}$ |\n\n$$\n\n$$\n\nThere are $1\\,000\\,\\text{mg}$ per $\\text{g},$ which we can write as follows:\n\n$$\n\\frac{1000\\,\\text{mg}}{\\text{g}}\n$$\n\nThis is our conversion factor.\n\nNow, multiplying $0.9\\,\\text{g}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}0.9\\,\\text{g} & =0.9\\,\\text{g}\\cdot \\frac{1\\,000\\,\\text{mg}}{\\text{g}} \\\\  & =0.9\\,\\cancel{\\text{g}}\\cdot \\frac{1\\,000\\,\\text{mg}}{\\cancel{\\text{g}}} \\\\  & =0.9\\cdot 1\\,000\\,\\text{mg} \\\\  & =900\\,\\text{mg}.\\end{aligned}\n$$\n\nTherefore, $0.9\\,\\text{g}$ is equivalent to $900\\,\\text{mg}.$"}] [{:db/id #edb/ref 17592186573302 :knowledge-point/_questions [{:db/id #edb/ref 17592186068719 :knowledge-point/id #uuid "c4f7e042-a8fa-50c8-a502-1397138dc380" :knowledge-point/title "Absolute Value Inequalities Containing a Greater Than (or Equal To) Symbol"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fea0b29-7f79-50a0-a2d0-ce5d93803b92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge" :db/id #edb/ref 17592186572860}] :answer-field/correct {:answer/id #uuid "1fea0b29-7f79-50a0-a2d0-ce5d93803b92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ge" :db/id #edb/ref 17592186572860} :answer-field/id #uuid "07839e3e-5717-5971-8c55-29675d677717" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573151} {:answer-field/choices [{:answer/id #uuid "ce6d3593-b9ee-56e6-a313-b289f3e83396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186573083}] :answer-field/correct {:answer/id #uuid "ce6d3593-b9ee-56e6-a313-b289f3e83396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186573083} :answer-field/id #uuid "bf84b07b-a308-558a-9ef5-8ba63478514c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573219} {:answer-field/choices [{:answer/id #uuid "5fc9f90b-a8c3-59ba-9cd9-45a1d4218177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186572934}] :answer-field/correct {:answer/id #uuid "5fc9f90b-a8c3-59ba-9cd9-45a1d4218177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186572934} :answer-field/id #uuid "ea10f362-1845-5a00-a8ef-b90f7c8afd1f" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573238}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bf74267c-d6a7-5491-a319-f2e29a265fc9" :question/math-academy-id "q-215492" :question/problem "Solve the absolute value inequality $|12z+7|\\ge 5.$\n\n$z\\le$\n{{field-1}}\n$\\,$ or $\\,z$\n{{field-2}}{{field-3}}" :question/worked-solution "We convert the absolute value inequality into a compound inequality to remove the absolute value. \n\nThe inequality specifies every number $12z+7$ whose distance from zero is greater than or equal to $5.$ This corresponds to the following compound inequality:\n\n$$\n\\begin{aligned}12z+7 & \\le -5 & \\text{or} &  & 12z+7 & \\ge 5\\end{aligned}\n$$\n\nNow, we can solve each inequality using the usual methods.\n\n$$\n\\begin{aligned}12z+7 & \\le -5 &  &  & 12z+7 & \\ge 5 \\\\ 12z & \\le -12 &  &  & 12z & \\ge -2 \\\\ z & \\le -1 &  &  & z & \\ge -\\frac{1}{6}\\end{aligned}\n$$\n\nTherefore, the final solution is\n\n$$\n\\begin{aligned}z & \\le -1 & \\text{or} &  & z & \\ge -\\frac{1}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573316 :knowledge-point/_questions [{:db/id #edb/ref 17592186138561 :knowledge-point/id #uuid "da4a8391-42b6-510c-8cb4-acbbbe7d1585" :knowledge-point/title "Calculating the Value of an Unknown Quantity Using Collinearity and Midpoints"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b03ae89-2d6b-5a08-85ea-dff271502074" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{ cm}" :db/id #edb/ref 17592186572888} {:answer/id #uuid "51e545ac-5ebc-5ae2-b38d-b9f8d50d893e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,\\text{ cm}" :db/id #edb/ref 17592186572918} {:answer/id #uuid "6a531e71-3a1c-5a27-8860-874d97d930f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.25\\,\\text{ cm}" :db/id #edb/ref 17592186572954} {:answer/id #uuid "d3b4ad2c-c9a8-5190-bed2-340447dd6089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,\\text{ cm}" :db/id #edb/ref 17592186573094} {:answer/id #uuid "e93f0823-8ac4-5346-b9c4-51ac8f993a71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.75\\,\\text{ cm}" :db/id #edb/ref 17592186573122}] :answer-field/correct {:answer/id #uuid "3b03ae89-2d6b-5a08-85ea-dff271502074" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{ cm}" :db/id #edb/ref 17592186572888} :answer-field/id #uuid "91ebac2f-a127-5374-8422-8d7547f89157" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573204}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eaee2e36-f252-5a56-ba54-f7a90c1e698d" :question/math-academy-id "q-25774" :question/problem "![](images/c1/c15de626535d55df85e756b8c3fffc9c4d50eb5b7e2b049eeec3f2ba6be2f2bb.png)\n\nIn the diagram shown above, $B$ is the midpoint of $\\overset{―}{AD}.$ Find $BC$ if $AD=29\\,\\text{cm}$ and $CD=6.5\\,\\text{cm}.$" :question/worked-solution "Since $B$ is the midpoint of $\\overset{―}{AD}$, we have: \n\n$$\n\\begin{aligned}BD & =\\frac{1}{2}AD \\\\  & =\\frac{1}{2}\\cdot 29 \\\\  & =14.5\\,\\text{cm}\\end{aligned}\n$$\n\nNow, by the segment addition postulate, we obtain: \n\n$$\n\\begin{aligned}BD & =BC+CD \\\\ 14.5 & =BC+6.5 \\\\ 14.5-6.5 & =BC \\\\ BC & =8\\,\\text{cm}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573278 :knowledge-point/_questions [{:db/id #edb/ref 17592186101008 :knowledge-point/id #uuid "d8e10b2d-cad1-5d50-b9fc-917c3367f814" :knowledge-point/title "Finding the Equation of a Graphed Line (Positive Slope)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "600192ae-60ff-5dcf-8c7b-46a96bdfa607" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x+3" :db/id #edb/ref 17592186572935} {:answer/id #uuid "92631607-7e58-5fa5-96af-a13cddef33d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x+3" :db/id #edb/ref 17592186573014} {:answer/id #uuid "aa6cfee1-f4ba-5337-94cd-fc676ebd72db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+3" :db/id #edb/ref 17592186573042} {:answer/id #uuid "b049026b-520e-5374-ad90-addb17c92919" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x-3" :db/id #edb/ref 17592186573049} {:answer/id #uuid "caba64b7-7134-5366-a184-b1d536fbbf43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x+3" :db/id #edb/ref 17592186573081}] :answer-field/correct {:answer/id #uuid "aa6cfee1-f4ba-5337-94cd-fc676ebd72db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+3" :db/id #edb/ref 17592186573042} :answer-field/id #uuid "bd5cb081-453f-5660-95d6-9625673b4cec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573217}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5a315de4-d76f-5902-ac75-57586afb2f01" :question/math-academy-id "q-316642" :question/problem "![](images/ad/ad5ee5c0c388e0d2a800765288f20350a8332888a54b4eb3fafd5986d6355838.png)\n\nThe line shown above passes through the points $(0,3)$ and $(-2,-1).$ What is the equation of the line?" :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFrom the graph, we see that the line intercepts the $y$-axis at $(0,3).$ So, the $y$-intercept is $b=3.$\n\nWe can calculate the slope of the line by choosing two points on the line and applying the slope formula. The line passes through the points $(0,3)$ and $(-2,-1),$ so we calculate its slope as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{-1-3}{-2-0} \\\\  & =\\frac{-4}{-2} \\\\  & =2\\end{aligned}\n$$\n\nSubstituting the slope $m=2$ and the $y$-intercept $b=3$ into the slope-intercept form $y=mx+b,$ we obtain the equation of the line:\n\n$$\ny=2x+3\n$$"}] [{:db/id #edb/ref 17592186573258 :knowledge-point/_questions [{:db/id #edb/ref 17592186105871 :knowledge-point/id #uuid "6445834c-7788-5427-a72c-30b06cc8e6ab" :knowledge-point/title "Calculating the Area of an Isosceles Right Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f7147e-291e-51e1-814e-204d4b837970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186572828} {:answer/id #uuid "56882461-c4a1-56bb-a01a-69f712e09d6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186572925} {:answer/id #uuid "c8d8b9cf-6230-5853-9eba-97871d5940a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186573075} {:answer/id #uuid "d36d18ae-4508-5fcf-b6f7-e6dc10f0092c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128" :db/id #edb/ref 17592186573092} {:answer/id #uuid "e3a9e524-d6ab-5b23-ac28-b9ac7ddfb943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186573115}] :answer-field/correct {:answer/id #uuid "56882461-c4a1-56bb-a01a-69f712e09d6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186572925} :answer-field/id #uuid "df003f1c-da11-5c20-b29c-290f8d22c7d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573235}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0be768b0-d70e-57fe-9f86-a4cf5ff73d92" :question/math-academy-id "q-87850" :question/problem "![](images/26/26ab73d81c0ec3ef9b2b6fa93de11266fb4d0629b875d7d38636f36926f0f053.png)\n\nWhat is the area of the right triangle $ABC$ shown above?" :question/worked-solution "Since $m∠A=m∠C={45}^{∘}$ and $AB=BC,$ we have an isosceles right triangle. \n\n![](images/e1/e13a301fe37d44657754877ef61b4d5e0e913c309784baa50d53f0d0e5edd913.png)\n\nTherefore, the area of the triangle is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot {8}^{2} \\\\  & =\\frac{1}{2}\\cdot 64 \\\\  & =32.\\end{aligned}\n$$"}]}
