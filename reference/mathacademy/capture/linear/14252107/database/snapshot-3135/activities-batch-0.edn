#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186185016} :activity/id #uuid "a963d35a-d51d-50f7-b102-8821b5ecb011" :activity/scope {:db/id #edb/ref 17592186048132 :topic/id #uuid "81fdc96c-a638-5049-8995-3d48064b08cb" :topic/math-academy-id 3848} :activity/steps [{:db/id #edb/ref 17592186185015 :step/content {:db/id #edb/ref 17592186184225 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184131 :question/id #uuid "cd3fba6a-bb16-51b1-b2ea-fb88656d5aa6" :question/math-academy-id "e-9979"} :knowledge-point/id #uuid "37603549-5c55-5b9e-8d2d-2121db167d02" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049923}] :knowledge-point/questions [{:db/id #edb/ref 17592186184801} {:db/id #edb/ref 17592186184802} {:db/id #edb/ref 17592186503673} {:db/id #edb/ref 17592186503703}] :knowledge-point/title "Combining Radical Expressions"} :step/id #uuid "2a88297e-0c93-59fc-a45e-bb8dc09591fe" :step/math-academy-id 37583 :step/next {:db/id #edb/ref 17592186185195}} {:db/id #edb/ref 17592186185016 :step/content {:db/id #edb/ref 17592186185346 :tutorial/content "The **product rule for radicals** states that the square root of a product equals the product of the square roots:\n\n$$\n\\eqalign{\n\t\t\\sqrt{a} \\cdot \\sqrt{b} = \\sqrt{ab}\n\t}\n$$\n\nWe can use the product rule to combine radical expressions. \n\nFor example, let's suppose we want to combine the radicals in the following expression:\n\n$$\n\\sqrt{5x} \\cdot \\sqrt{6z}\n$$\n\nTo combine the radicals, we apply the product rule as follows:\n\n$$\n\\begin{aligned}\\sqrt{5x}\\cdot \\sqrt{6z} & = \\\\ \\sqrt{5x\\cdot 6z} & = \\\\ \\sqrt{30xz} & \\end{aligned}\n$$" :tutorial/id #uuid "1c9d8f0d-315b-5c83-a8e6-17638c1c3d24" :tutorial/math-academy-id 6200 :tutorial/title "Introduction"} :step/id #uuid "9a6b95b2-a3b2-5264-9183-0fefe3abfed8" :step/math-academy-id 37588 :step/next {:db/id #edb/ref 17592186185015}} {:db/id #edb/ref 17592186185195 :step/content {:db/id #edb/ref 17592186184320 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183935 :question/id #uuid "d669aafc-c1f1-5acd-b7d8-5ff0f31178b0" :question/math-academy-id "e-1361"} :knowledge-point/id #uuid "5fcba20f-b43b-558d-bd84-d76816d3186b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050890}] :knowledge-point/questions [{:db/id #edb/ref 17592186184740} {:db/id #edb/ref 17592186184803} {:db/id #edb/ref 17592186503733} {:db/id #edb/ref 17592186503743} {:db/id #edb/ref 17592186563692} {:db/id #edb/ref 17592186563731}] :knowledge-point/title "Combining Radical Expressions Using the Rules of Absolute Value"} :step/id #uuid "83175ccc-7da0-50d9-b695-82571c0cb353" :step/math-academy-id 4307 :step/next {:db/id #edb/ref 17592186185196}} {:db/id #edb/ref 17592186185196 :step/content {:db/id #edb/ref 17592186185310 :tutorial/content "The product rule for radicals also works for higher-order roots, like the cube root. In the case of the cube root, we have\n\n$$\n\\sqrt[3]{ab} = \\sqrt[3]{a}\\cdot \\sqrt[3]{b}.\n$$\n\nIn general,\n\n$$\n\\sqrt[n]{ab} = \\sqrt[n]{a}\\cdot \\sqrt[n]{b}.\n$$" :tutorial/id #uuid "f9406c08-e6de-514e-aeae-9f581d5730a5" :tutorial/math-academy-id 1607 :tutorial/title "The Product Rule for Cube Roots"} :step/id #uuid "c0a3a07c-d5b4-5d4b-805c-3c93987ee6fe" :step/math-academy-id 4313 :step/next {:db/id #edb/ref 17592186185197}} {:db/id #edb/ref 17592186185197 :step/content {:db/id #edb/ref 17592186184321 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183936 :question/id #uuid "d6b143d1-7d3f-5836-8797-19cb37181541" :question/math-academy-id "e-1364"} :knowledge-point/id #uuid "de2b7926-fa13-5636-9682-8fa382336be7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048170}] :knowledge-point/questions [{:db/id #edb/ref 17592186184500} {:db/id #edb/ref 17592186184501} {:db/id #edb/ref 17592186503701} {:db/id #edb/ref 17592186503731} {:db/id #edb/ref 17592186563675} {:db/id #edb/ref 17592186573292}] :knowledge-point/title "Simplifying a Cube Root Expression"} :step/id #uuid "d028b29f-988d-5038-a9c2-8a95b472232b" :step/math-academy-id 4314}] :activity/title "Combining Radical Expressions Using the Product Rule" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186184432}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186563813} :activity/id #uuid "966a76d8-0c6e-5591-b99a-1917424d151b" :activity/scope {:db/id #edb/ref 17592186048132 :topic/id #uuid "81fdc96c-a638-5049-8995-3d48064b08cb" :topic/math-academy-id 3848} :activity/steps [{:db/id #edb/ref 17592186563770 :step/content {:db/id #edb/ref 17592186563675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f9d67ae-479b-5212-a32d-ea72ac199fdf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28\\sqrt[3]{s{t}^{2}}" :db/id #edb/ref 17592186562975} {:answer/id #uuid "3121334e-b5ff-5d7f-b931-c4cc6aff67e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{14st}" :db/id #edb/ref 17592186563057} {:answer/id #uuid "44050778-0a11-5b3d-8de9-552e09f1598c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\sqrt[3]{28s}" :db/id #edb/ref 17592186563097} {:answer/id #uuid "66a4a5e4-546c-53dd-b661-09d0f6e93243" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\sqrt[3]{st}" :db/id #edb/ref 17592186563184} {:answer/id #uuid "e708cbcb-204a-515f-a2ee-8880e52ab193" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{28s{t}^{2}}" :db/id #edb/ref 17592186563454}] :answer-field/correct {:db/id #edb/ref 17592186563454} :answer-field/id #uuid "8a3551f7-6554-57bf-8d88-2777fb8978a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563590}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "41a2ad72-53df-54b1-8f6d-95041c4754db" :question/math-academy-id "q-141851" :question/problem "$\\sqrt[3]{4s}\\cdot \\sqrt[3]{7{t}^{2}}=$" :question/worked-solution "We apply the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{4s}\\cdot \\sqrt[3]{7{t}^{2}} & = \\\\ \\sqrt[3]{4s\\cdot 7{t}^{2}} & = \\\\ \\sqrt[3]{28s{t}^{2}}\\end{aligned}\n$$"} :step/id #uuid "25b65737-ade2-56c9-a926-c3e2f2a2500e"} {:db/id #edb/ref 17592186563777 :step/content {:db/id #edb/ref 17592186563731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20037864-692e-5bfb-9322-3b5120acbe5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{a}^{2}\\sqrt{10bc}" :db/id #edb/ref 17592186563017} {:answer/id #uuid "4d77eb1e-d305-5769-be60-4814a62a8015" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{a}^{2}b\\sqrt{10c}" :db/id #edb/ref 17592186563119} {:answer/id #uuid "85b799e3-d57c-539f-acb8-811ec4f3f811" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6{a}^{2}\\sqrt{15bc}" :db/id #edb/ref 17592186563246} {:answer/id #uuid "d988c7ff-7f4c-5175-9b2b-46df6a682046" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{a}^{4}{b}^{2}\\sqrt{5c}" :db/id #edb/ref 17592186563421} {:answer/id #uuid "e3bd976f-4efd-55f3-be7f-8f74b45ff7e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6{a}^{2}b\\sqrt{15c}" :db/id #edb/ref 17592186563446}] :answer-field/correct {:db/id #edb/ref 17592186563119} :answer-field/id #uuid "19a40071-b4ac-5acd-960c-d9a0e6445961" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563532}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bd6c8038-fcc2-5fa5-ad44-54f20efc3514" :question/math-academy-id "q-141498" :question/problem "Simplify $\\sqrt{6{a}^{3}b}\\cdot \\sqrt{15abc}$ given that $a,b,c\\ge 0.$" :question/worked-solution "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\begin{aligned}\\sqrt{6{a}^{3}b}\\cdot \\sqrt{15abc} & = \\\\ \\sqrt{6{a}^{3}b\\cdot 15abc} & = \\\\ \\sqrt{90{a}^{4}{b}^{2}c} & = \\\\ \\sqrt{9{a}^{4}{b}^{2}\\cdot 10c} & = \\\\ \\sqrt{(3{a}^{2}b)^{2}\\cdot 10c} & = \\\\ 3\\cdot |{a}^{2}|\\cdot |b|\\cdot \\sqrt{10c}\\end{aligned}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have that $|{a}^{2}|={a}^{2}$ and $|b|=b.$  Therefore, our final answer is\n\n$$\n\\begin{aligned}3\\cdot |{a}^{2}|\\cdot |b|\\cdot \\sqrt{10c} & = \\\\ 3{a}^{2}b\\sqrt{10c} & .\\end{aligned}\n$$"} :step/id #uuid "3a66b197-3ff8-5d27-8cde-046d95da9317" :step/next {:db/id #edb/ref 17592186563770}} {:db/id #edb/ref 17592186563813 :step/content {:db/id #edb/ref 17592186563692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d5136f-8e3c-524a-ae1b-d2c7d6281429" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36{b}^{2}\\sqrt{a}" :db/id #edb/ref 17592186562943} {:answer/id #uuid "4ee323e3-08d6-546b-8935-72052398ce78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36a{b}^{2}\\sqrt{2}" :db/id #edb/ref 17592186563124} {:answer/id #uuid "9a2ab45f-3b8e-59d8-ae0d-a84bcaf91d90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36{b}^{2}\\sqrt{2a}" :db/id #edb/ref 17592186563292} {:answer/id #uuid "cfba2d73-242a-5b18-a815-bc4b2611b506" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6a{b}^{2}\\sqrt{11a}" :db/id #edb/ref 17592186563401} {:answer/id #uuid "fc68b7fb-a728-5929-84b3-caef82248a8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18{b}^{2}\\sqrt{a}" :db/id #edb/ref 17592186563512}] :answer-field/correct {:db/id #edb/ref 17592186563292} :answer-field/id #uuid "1a8b84a5-9da7-5fc7-9d58-31f7e5a5ff16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563534}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "60bf46ec-c41d-5bd2-93b6-b056ca651773" :question/math-academy-id "q-3077" :question/problem "$2\\sqrt{8a{b}^{3}}\\cdot 3\\sqrt{9b}=$" :question/worked-solution "We perform the multiplication under a single radical and then simplify the result:\n\n$$\n\\begin{aligned}2\\sqrt{8a{b}^{3}}\\cdot 3\\sqrt{9b} & = \\\\ 2\\cdot 3\\sqrt{8a{b}^{3}\\cdot 9b} & = \\\\ 6\\sqrt{72a{b}^{4}} & = \\\\ 6\\sqrt{36{b}^{4}\\cdot 2a} & = \\\\ 6\\sqrt{(6{b}^{2})^{2}\\cdot 2a} & = \\\\ 6\\sqrt{(6{b}^{2})^{2}}\\cdot \\sqrt{2a} & = \\\\ 6\\cdot |6{b}^{2}|\\cdot \\sqrt{2a} & = \\\\ 6\\cdot |6|\\cdot |{b}^{2}|\\cdot \\sqrt{2a} & = \\\\ 6\\cdot 6\\cdot |{b}^{2}|\\cdot \\sqrt{2a}\\end{aligned}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}6\\cdot 6\\cdot |{b}^{2}|\\cdot \\sqrt{2a} & = \\\\ 36\\cdot {b}^{2}\\cdot \\sqrt{2a} & = \\\\ 36{b}^{2}\\sqrt{2a}.\\end{aligned}\n$$"} :step/id #uuid "f58651f1-e6af-576f-8e7f-3b48b9f27e36" :step/next {:db/id #edb/ref 17592186563777}}] :activity/title "Combining Radical Expressions Using the Product Rule" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186562933}] [{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186106627} :activity/id #uuid "5207c8f6-7d65-5c9f-8bbb-af66fdcc9b1d" :activity/scope {:db/id #edb/ref 17592186049027 :topic/id #uuid "d4a5e636-5453-5120-957b-34a9e32197ae" :topic/math-academy-id 1403} :activity/steps [{:db/id #edb/ref 17592186106627 :step/content {:db/id #edb/ref 17592186107043 :tutorial/content "Remember that longer sides in a triangle are opposite to larger angles, and vice versa. But what if two (or more) sides have the same length?\n\nAs you might have guessed, if two sides have the same length, then the opposite angles have the same measure. And vice-versa: if two angles have the same measure, then the opposite sides have the same length.\n\nSo, we obtain the following important properties of isosceles and equilateral triangles:\n\n- A triangle is **equilateral** if and only if all of its angles are of $60^\\circ.$\n\n![](images/ad/ad56532db83ae54eeabf04d5a182a850bed14d9d0a65518b8048c3c0c112c371.png)\n\n- A triangle is **isosceles** if and only if it has two congruent angles.\n\n![](images/2b/2b5d6779527eae10e108ffcdc80745f63f3f38e41474673990bf74c83d2e6a64.png)\n\n**Note:** The statement above encompasses two theorems:\n\n- The **isosceles triangle theorem**:\n\n*If a triangle is isosceles, then the base angles are congruent.*\n\n- The **converse isosceles triangle theorem**: \n\n*If two angles in a triangle have the same measure, then the triangle must be isosceles.*" :tutorial/id #uuid "87d68609-ccd1-5ebd-b129-2c6993e05b75" :tutorial/math-academy-id 2227 :tutorial/title "Introduction"} :step/id #uuid "5440fe87-c485-5fa7-ab27-be4de4746fa1" :step/math-academy-id 164419 :step/next {:db/id #edb/ref 17592186106628}} {:db/id #edb/ref 17592186106628 :step/content {:db/id #edb/ref 17592186105738 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105525 :question/id #uuid "df6c46c7-a65c-578c-a9b3-e75de73c527a" :question/math-academy-id "e-2718"} :knowledge-point/id #uuid "02d46a44-0f02-5491-8e71-2eb22ad50ff9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049949}] :knowledge-point/questions [{:db/id #edb/ref 17592186106166} {:db/id #edb/ref 17592186106170} {:db/id #edb/ref 17592186505752} {:db/id #edb/ref 17592186505835} {:db/id #edb/ref 17592186511516}] :knowledge-point/title "Calculating the Measure of an Angle Using the Isosceles Triangle Theorem"} :step/id #uuid "6c37fcdd-4a4f-5fa4-b419-cdfb144ce00e" :step/math-academy-id 164420 :step/next {:db/id #edb/ref 17592186106629}} {:db/id #edb/ref 17592186106629 :step/content {:db/id #edb/ref 17592186105739 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105526 :question/id #uuid "c7ae19b8-aee0-5a64-b7c8-61f3ce75272c" :question/math-academy-id "e-2721"} :knowledge-point/id #uuid "0690d62b-432c-5d1e-96f2-b43393f6efa9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048764} {:db/id #edb/ref 17592186050410}] :knowledge-point/questions [{:db/id #edb/ref 17592186106167} {:db/id #edb/ref 17592186106171} {:db/id #edb/ref 17592186505731} {:db/id #edb/ref 17592186505815} {:db/id #edb/ref 17592186565452}] :knowledge-point/title "Calculating the Measure of an Angle in an Isosceles Triangle Given an Exterior Angle"} :step/id #uuid "52480c3c-c289-5e97-b7aa-1a5401a73156" :step/math-academy-id 164423 :step/next {:db/id #edb/ref 17592186106630}} {:db/id #edb/ref 17592186106630 :step/content {:db/id #edb/ref 17592186105740 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105584 :question/id #uuid "d9e953e1-5af0-55eb-a861-af6f4ed9b720" :question/math-academy-id "e-4269"} :knowledge-point/id #uuid "c9c2b7ee-d32b-550b-b110-81d04d750c98" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048213}] :knowledge-point/questions [{:db/id #edb/ref 17592186106165} {:db/id #edb/ref 17592186106169} {:db/id #edb/ref 17592186505797} {:db/id #edb/ref 17592186505818} {:db/id #edb/ref 17592186573255}] :knowledge-point/title "Solving for a Variable Given Unknown Lengths in an Isosceles Triangle"} :step/id #uuid "b5d08f57-ce6b-5494-a967-38442f05a2c6" :step/math-academy-id 164426 :step/next {:db/id #edb/ref 17592186106631}} {:db/id #edb/ref 17592186106631 :step/content {:db/id #edb/ref 17592186105741 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105527 :question/id #uuid "e44e7e25-f65b-5f40-9aef-cbe55bfd1b53" :question/math-academy-id "e-2726"} :knowledge-point/id #uuid "0044ba61-80c8-57cf-80dc-8a17cf980a84" :knowledge-point/questions [{:db/id #edb/ref 17592186106168} {:db/id #edb/ref 17592186106391} {:db/id #edb/ref 17592186505742} {:db/id #edb/ref 17592186505837} {:db/id #edb/ref 17592186565454} {:db/id #edb/ref 17592186565459}] :knowledge-point/title "Finding the Measure of an Angle Given Multiple Triangles"} :step/id #uuid "ec111c1e-1c82-5a70-b2f1-5dfba6037c19" :step/math-academy-id 164429}] :activity/title "The Isosceles Triangle Theorem" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106021}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186565535} :activity/id #uuid "7731ce61-1f9a-51e4-a49c-996258564f67" :activity/scope {:db/id #edb/ref 17592186049027 :topic/id #uuid "d4a5e636-5453-5120-957b-34a9e32197ae" :topic/math-academy-id 1403} :activity/steps [{:db/id #edb/ref 17592186565501 :step/content {:db/id #edb/ref 17592186565454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03661a97-3f4c-57e9-943b-6740f23533e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{67}^{∘}" :db/id #edb/ref 17592186564944} {:answer/id #uuid "24b2b15c-24e2-57bc-9b13-a06cbd4eb16e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{69}^{∘}" :db/id #edb/ref 17592186564994} {:answer/id #uuid "7335ea22-0c13-5b37-8b47-351229d967ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{73}^{∘}" :db/id #edb/ref 17592186565114} {:answer/id #uuid "7c88601f-7ff0-5a6b-af0b-a77dbae473cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{72}^{∘}" :db/id #edb/ref 17592186565128} {:answer/id #uuid "aa458a18-ad45-591e-ab81-1483b9bbc230" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{70}^{∘}" :db/id #edb/ref 17592186565192}] :answer-field/correct {:db/id #edb/ref 17592186565192} :answer-field/id #uuid "ddd44795-8d4c-547b-9853-d23d19571f47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565394}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ae1938a1-58ee-571b-a544-d365ce409563" :question/math-academy-id "q-21232" :question/problem "![](images/19/19ca38571817d9de8c92de17d5121c33ac1494848766033792dc9586c95fa475.png)\n\nIn the isosceles triangle $△ABC$  with base $\\overset{―}{AB}$, point $E$ lies on the side $\\overset{―}{BC}$, $\\overset{―}{AE}=\\overset{―}{EC}$ and $m∠EAC={40}^{∘}.$ What is the measure of $∠B?$" :question/worked-solution "First, notice that $△ABC$ is an isosceles triangle with base $\\overset{―}{AB}.$ Consequently,  the base angles must have equal measure:\n\n$$\nm∠BAC=m∠B\n$$\n\nAlso, since $△CEA$ is an isosceles triangle, we have:\n\n$$\nm∠C=m∠EAC={40}^{∘}\n$$\n\nFinally, we calculate $m∠B$ using the fact that the interior angles of $△ABC$ sum to ${180}^{∘}:$\n\n$$\n\\begin{aligned}m∠BAC+m∠B+m∠C & ={180}^{∘} \\\\ m∠B+m∠B+{40}^{∘} & ={180}^{∘} \\\\ 2m∠B & ={140}^{∘} \\\\ m∠B & ={70}^{∘}\\end{aligned}\n$$"} :step/id #uuid "3970f23e-0d4b-58af-b62e-7ed9157998d2" :step/next {:db/id #edb/ref 17592186565505}} {:db/id #edb/ref 17592186565505 :step/content {:db/id #edb/ref 17592186565452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46ca1c05-5190-5ad2-8c5c-d591894996c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{107}^{∘}" :db/id #edb/ref 17592186565039} {:answer/id #uuid "5274cb9d-d489-5332-8ddc-d0bf62c38087" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{108}^{∘}" :db/id #edb/ref 17592186565058} {:answer/id #uuid "bfa840cd-3123-510e-bf31-113dff14f21e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{112}^{∘}" :db/id #edb/ref 17592186565228} {:answer/id #uuid "f6ebedab-b10c-56a0-8c29-72fe32d8a4eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{113}^{∘}" :db/id #edb/ref 17592186565312} {:answer/id #uuid "f81ae10f-b2ec-5eff-a612-29b4fa814574" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{110}^{∘}" :db/id #edb/ref 17592186565315}] :answer-field/correct {:db/id #edb/ref 17592186565315} :answer-field/id #uuid "2517a418-b87f-54f2-b710-d15c568a3534" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565338}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a323077c-5cf0-5ef0-a051-240e1171e494" :question/math-academy-id "q-52972" :question/problem "![](images/37/372ac1135e480bcd843f02b05bdeae42d462fccaced8151e4a355d6263d7be64.png)\n\nFind the value of $z$ in the triangle shown above." :question/worked-solution "First, from the diagram, notice that $∠CAB$ and $∠BAD$ are supplementary. Therefore,\n\n$$\n\\begin{aligned}m∠CAB+m∠BAD & ={180}^{∘} \\\\ m∠CAB+z & ={180}^{∘} \\\\ m∠CAB & ={180}^{∘}-z.\\end{aligned}\n$$\n\nSince $△ABC$ is an isosceles triangle where $\\overset{―}{AB}≅\\overset{―}{BC}$, the base angles must be equal:\n\n$$\nm∠C=m∠CAB.\n$$\n\nFinally, since the interior angles of any triangle sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠CAB+m∠C+m∠B & ={180}^{∘} \\\\ 2m∠CAB+m∠B & ={180}^{∘} \\\\ 2({180}^{∘}-z)+{40}^{∘} & ={180}^{∘} \\\\ {360}^{∘}-2z+{40}^{∘} & ={180}^{∘} \\\\ 2z & ={220}^{∘} \\\\ z & ={110}^{∘}.\\end{aligned}\n$$"} :step/id #uuid "547a136f-0f45-5073-888d-a69eb3373469"} {:db/id #edb/ref 17592186565535 :step/content {:db/id #edb/ref 17592186565459 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7af2094e-5a9c-5576-ab4c-588a0176acd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{32}^{∘}" :db/id #edb/ref 17592186565125} {:answer/id #uuid "7f5c018b-da77-51b3-94a3-4a719e2c22a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{29}^{∘}" :db/id #edb/ref 17592186565132} {:answer/id #uuid "8be640ca-b6bd-59dc-98b9-bc210f8e3e6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{27}^{∘}" :db/id #edb/ref 17592186565154} {:answer/id #uuid "a51bdf43-9f1b-54de-9f2e-2698aa8af185" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186565189} {:answer/id #uuid "b7b5d134-db45-5c5c-a672-02898c3558d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{34}^{∘}" :db/id #edb/ref 17592186565213}] :answer-field/correct {:db/id #edb/ref 17592186565189} :answer-field/id #uuid "a9b88805-312e-50ff-a48f-9a2d91e7b91d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186565373}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b85bf70e-60cf-531c-93a8-54cd5e2b47c0" :question/math-academy-id "q-21222" :question/problem "![](images/c6/c62f51c2b029d6b1e24e7f30603c5f34ab5d70d96ed84c5c74de15d4e2e6358e.png)\n\nWhat is the measure of $∠D?$" :question/worked-solution "First, notice that $△ABC$ is an equilateral triangle. Consequently, all of the interior angles must be equal to ${60}^{∘}:$ \n\n$$\nm∠A=m∠B=m∠ABC={60}^{∘}\n$$\n\nAlso, since $△CDB$ is an isosceles triangle, the base angles must have equal measure:\n\n$$\nm∠CBD=m∠D\n$$\n\nNotice also that $∠ACB$ and $∠DCB$ are supplementary, therefore, we obtain\n\n$$\n\\begin{aligned}m∠ACB+m∠DCB & ={180}^{∘} \\\\ {60}^{∘}+m∠DCB & ={180}^{∘} \\\\ m∠DCB & ={120}^{∘}.\\end{aligned}\n$$\n\n Finally, we calculate $m∠D$ using the fact that the interior angles of a triangle sum to ${180}^{∘}:$\n\n$$\n\\begin{aligned}m∠D+m∠DCB+m∠CBD & ={180}^{∘} \\\\ m∠D+{120}^{∘}+m∠D & ={180}^{∘} \\\\ 2m∠D & ={60}^{∘} \\\\ m∠D & ={30}^{∘}\\end{aligned}\n$$"} :step/id #uuid "d4131835-327a-579d-bd13-775bb94299f0" :step/next {:db/id #edb/ref 17592186565501}}] :activity/title "The Isosceles Triangle Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186564931}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186139486} :activity/id #uuid "63522699-6803-576b-82ed-8d88d13eba2f" :activity/scope {:db/id #edb/ref 17592186049047 :topic/id #uuid "d5a8629a-110d-5d05-beb7-159e81536910" :topic/math-academy-id 2244} :activity/steps [{:db/id #edb/ref 17592186139486 :step/content {:db/id #edb/ref 17592186139661 :tutorial/content "Suppose that we want to simplify the following expression: \n\n$$\n2+\\dfrac{5}{2}x -5 + \\dfrac{7}{2}x.\n$$\n\n  \n\nWe begin by collecting like terms.\n\n$$\n\\begin{aligned}(\\frac{5}{2}x+\\frac{7}{2}x)+(2-5)\\end{aligned}\n$$\n\nThen, we combine the like terms, simplifying the coefficients as much as possible.\n\n$$\n\\begin{aligned}(\\frac{5}{2}x+\\frac{7}{2}x)+(2-5) & = \\\\ (\\frac{5+7}{2})x+(-3) & = \\\\ \\frac{12}{2}x-3 & = \\\\ 6x-3 & .\\end{aligned}\n$$\n\nThus, the simplified expression is $6x-3.$" :tutorial/id #uuid "7ef8a0d2-a9fe-57f8-b3fc-7b69cbb3a818" :tutorial/math-academy-id 8040 :tutorial/title "Introduction"} :step/id #uuid "3cca408f-980b-5a63-a54c-03cd0d86a422" :step/math-academy-id 71207 :step/next {:db/id #edb/ref 17592186139487}} {:db/id #edb/ref 17592186139487 :step/content {:db/id #edb/ref 17592186138510 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138069 :question/id #uuid "e85da1d1-1cf3-547c-86ce-42329475fbdd" :question/math-academy-id "e-12835"} :knowledge-point/id #uuid "54498b47-9a43-5b4d-8bbf-806af5968829" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050311} {:db/id #edb/ref 17592186050452} {:db/id #edb/ref 17592186050833}] :knowledge-point/questions [{:db/id #edb/ref 17592186138716} {:db/id #edb/ref 17592186138809} {:db/id #edb/ref 17592186459206} {:db/id #edb/ref 17592186459226}] :knowledge-point/title "Simplifying Fractions with Like Denominators"} :step/id #uuid "24f9787a-6b3b-581b-a228-064feb6d711c" :step/math-academy-id 71208 :step/next {:db/id #edb/ref 17592186139488}} {:db/id #edb/ref 17592186139488 :step/content {:db/id #edb/ref 17592186138511 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138071 :question/id #uuid "53c1f7ca-bcaa-59e4-9929-0695b67621cb" :question/math-academy-id "e-12837"} :knowledge-point/id #uuid "75d096f5-9834-5e52-a7eb-9aae72398d19" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050131} {:db/id #edb/ref 17592186050637}] :knowledge-point/questions [{:db/id #edb/ref 17592186138816} {:db/id #edb/ref 17592186138817} {:db/id #edb/ref 17592186459205} {:db/id #edb/ref 17592186459293} {:db/id #edb/ref 17592186536857} {:db/id #edb/ref 17592186542142} {:db/id #edb/ref 17592186573281}] :knowledge-point/title "Simplifying Fractions with Unlike Denominators"} :step/id #uuid "aae03f7b-9f94-5281-8d40-eddd120590d8" :step/math-academy-id 71212 :step/next {:db/id #edb/ref 17592186139489}} {:db/id #edb/ref 17592186139489 :step/content {:db/id #edb/ref 17592186138512 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138070 :question/id #uuid "30cf0891-33d3-566c-8286-4c161f84c1dd" :question/math-academy-id "e-12836"} :knowledge-point/id #uuid "dec4e22a-5882-56d9-8e13-b18b4d22efdc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050599} {:db/id #edb/ref 17592186050908}] :knowledge-point/questions [{:db/id #edb/ref 17592186138760} {:db/id #edb/ref 17592186138779} {:db/id #edb/ref 17592186544873}] :knowledge-point/title "Using the Distributive Law With Fractions"} :step/id #uuid "1036460b-f34d-54e4-a730-f0b57e843495" :step/math-academy-id 71216 :step/next {:db/id #edb/ref 17592186139490}} {:db/id #edb/ref 17592186139490 :step/content {:db/id #edb/ref 17592186138513 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138072 :question/id #uuid "957b3102-6eb7-52d3-9299-54ed9bd4718e" :question/math-academy-id "e-12892"} :knowledge-point/id #uuid "e3e39a9d-1f97-54f2-a388-90c71c83b93e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050575}] :knowledge-point/questions [{:db/id #edb/ref 17592186138818} {:db/id #edb/ref 17592186139065} {:db/id #edb/ref 17592186459228} {:db/id #edb/ref 17592186459288}] :knowledge-point/title "Simplifying Expressions Using the Distributive Law"} :step/id #uuid "4e4a8574-0322-564e-8108-20569dba02f5" :step/math-academy-id 71219}] :activity/title "Simplifying Linear Expressions Containing Fractions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186138596}] [{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186069604} :activity/id #uuid "1e92c4a4-e0ad-5ee8-8851-82d431bca7f7" :activity/scope {:db/id #edb/ref 17592186049309 :topic/id #uuid "eb56b359-bf3c-5bc4-a26b-629e05c1d464" :topic/math-academy-id 451} :activity/steps [{:db/id #edb/ref 17592186069604 :step/content {:db/id #edb/ref 17592186070026 :tutorial/content "**Absolute value inequalities** combine two basic concepts: absolute value and inequality. The absolute value of a number is its distance from zero, while an inequality specifies a range of values.\n\nConsider a simple absolute value inequality, as follows:\n\n$$\n|x| < 7\n$$\n\nThis inequality specifies every number $x$ that is less than a distance of $7$ from $0$. So, it represents the same thing as the following compound inequality:\n\n$$\n-7 < x < 7\n$$\n\nTo solve an absolute value inequality, we first convert it to a compound inequality to remove the absolute value. Then, we can solve the compound inequality using the usual methods.\n\nTo illustrate, let's solve the following inequality:\n\n$$\n|2x+3| \\leq 5\n$$\n\nFirst, we interpret the inequality: the inequality specifies every number $2x+3$ whose distance from zero is less than or equal to $5.$ So, it represents the same thing as the following compound inequality:\n\n$$\n-5 \\leq 2x+3 \\leq 5\n$$\n\nNow, we can solve the compound inequality using the usual methods:\n\n$$\n\\begin{aligned}-5\\le 2x+3\\le 5 \\\\ -8\\le 2x\\le 2 \\\\ -4\\le x\\le 1\\end{aligned}\n$$" :tutorial/id #uuid "53ecd5cc-486a-584d-abc8-f75ec26f12cc" :tutorial/math-academy-id 8825 :tutorial/title "Introduction"} :step/id #uuid "e46e2f60-2005-54d4-8f5c-97b81542dd48" :step/math-academy-id 145541 :step/next {:db/id #edb/ref 17592186069605}} {:db/id #edb/ref 17592186069605 :step/content {:db/id #edb/ref 17592186068717 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068491 :question/id #uuid "60c2e025-0b7e-5ac2-afec-adeb5f65eed1" :question/math-academy-id "e-14222"} :knowledge-point/id #uuid "e107f878-5b22-54bf-90fc-b8ea8a22c77d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048267} {:db/id #edb/ref 17592186050734}] :knowledge-point/questions [{:db/id #edb/ref 17592186069130} {:db/id #edb/ref 17592186069131} {:db/id #edb/ref 17592186069289} {:db/id #edb/ref 17592186511567} {:db/id #edb/ref 17592186511580}] :knowledge-point/title "Absolute Value Inequalities Containing a Less Than (or Equal To) Symbol"} :step/id #uuid "461b27d5-3e08-5e71-9e57-464e06a7b559" :step/math-academy-id 145542 :step/next {:db/id #edb/ref 17592186069606}} {:db/id #edb/ref 17592186069606 :step/content {:db/id #edb/ref 17592186068718 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068510 :question/id #uuid "12d8aea9-62dd-5181-bd6e-54c11eba4152" :question/math-academy-id "e-14708"} :knowledge-point/id #uuid "65964b91-8f0e-5ffc-97d3-e5b87a6bade5" :knowledge-point/questions [{:db/id #edb/ref 17592186069132} {:db/id #edb/ref 17592186069133} {:db/id #edb/ref 17592186069294} {:db/id #edb/ref 17592186511521} {:db/id #edb/ref 17592186566222} {:db/id #edb/ref 17592186566252}] :knowledge-point/title "Cases Where the Coefficient in the Absolute Value Is Negative"} :step/id #uuid "95df2774-fa6c-5c44-85c3-1203c060ec1a" :step/math-academy-id 145546 :step/next {:db/id #edb/ref 17592186069607}} {:db/id #edb/ref 17592186069607 :step/content {:db/id #edb/ref 17592186070027 :tutorial/content "We take a similar approach for absolute value inequalities involving the \"greater than\" symbol. To illustrate, consider the following absolute value inequality:\n\n$$\n|x| \\geq 6\n$$\n\nTo solve this absolute value inequality, we convert it into a compound inequality to remove the absolute value. The inequality specifies every number $x$ whose distance from zero is greater than or equal to $6.$ This corresponds to the following compound inequality:\n\n$$\n\\begin{aligned}x & \\le -6 & \\text{or} &  & x & \\ge 6\\end{aligned}\n$$\n\nWe use the word \"or\" instead of \"and\" since only one of the inequalities $x\\leq-6$ or $x\\geq 6$ needs to be true for $|x| \\geq 6$ to be true." :tutorial/id #uuid "93e8452a-53ea-5e58-807a-00e95af99af1" :tutorial/math-academy-id 8830 :tutorial/title "Greater Than (or Equal To) Absolute Value Inequalities"} :step/id #uuid "3706f0b6-4695-54b2-974b-2b4f77638739" :step/math-academy-id 145550 :step/next {:db/id #edb/ref 17592186069608}} {:db/id #edb/ref 17592186069608 :step/content {:db/id #edb/ref 17592186068719 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068493 :question/id #uuid "8497ea21-c194-5bbf-b501-a0e9749d8dc8" :question/math-academy-id "e-14227"} :knowledge-point/id #uuid "c4f7e042-a8fa-50c8-a502-1397138dc380" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050680}] :knowledge-point/questions [{:db/id #edb/ref 17592186069134} {:db/id #edb/ref 17592186069135} {:db/id #edb/ref 17592186069290} {:db/id #edb/ref 17592186511463} {:db/id #edb/ref 17592186511490} {:db/id #edb/ref 17592186511573} {:db/id #edb/ref 17592186566272} {:db/id #edb/ref 17592186573302}] :knowledge-point/title "Absolute Value Inequalities Containing a Greater Than (or Equal To) Symbol"} :step/id #uuid "419f8ba9-27c0-5918-8ecd-eff659df7bb5" :step/math-academy-id 145551}] :activity/title "Absolute Value Inequalities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068978}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186566308} :activity/id #uuid "f0bff62a-5343-54b4-9650-eb722b795b80" :activity/scope {:db/id #edb/ref 17592186049309 :topic/id #uuid "eb56b359-bf3c-5bc4-a26b-629e05c1d464" :topic/math-academy-id 451} :activity/steps [{:db/id #edb/ref 17592186566276 :step/content {:db/id #edb/ref 17592186566222 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e5a5cc1-1149-5c80-9621-5b164a74f5c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186565751}] :answer-field/correct {:db/id #edb/ref 17592186565751} :answer-field/id #uuid "12507232-1440-5d68-a043-e8bfbd757afa" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566111} {:answer-field/choices [{:answer/id #uuid "4dc3c896-cef2-5b8f-af28-3a40f830d7d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186565796}] :answer-field/correct {:db/id #edb/ref 17592186565796} :answer-field/id #uuid "1e92ac0d-2286-5dd8-9c71-2ca6103d8408" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566117} {:answer-field/choices [{:answer/id #uuid "fd0fa83b-c689-57c3-9a12-c3988d0858bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186566096}] :answer-field/correct {:db/id #edb/ref 17592186566096} :answer-field/id #uuid "805d8828-fec7-5dee-8b08-1570f7374b06" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566160}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3b6c8eac-bc2e-56d5-9974-3113a1a1870d" :question/math-academy-id "q-215477" :question/problem "Solve the absolute value inequality $|\\frac{1}{4}-x|<\\frac{7}{4}.$\n\n{{field-1}}{{field-2}}\n$x$\n{{field-3}}\n$2$" :question/worked-solution "We convert the absolute value inequality into a compound inequality to remove the absolute value. \n\nThe inequality specifies every number $\\frac{1}{4}-x$ whose distance from zero is less than $\\frac{7}{4}.$ This corresponds to the following compound inequality:\n\n$$\n-\\frac{7}{4}<\\frac{1}{4}-x<\\frac{7}{4}\n$$\n\nNow, we can solve the compound inequality using the usual methods. (Remember that whenever we multiply or divide by a negative number, we have to flip the inequality signs.)\n\n$$\n\\begin{aligned}-\\frac{7}{4}<\\frac{1}{4}-x & <\\frac{7}{4} \\\\ -2<-x & <\\frac{3}{2} \\\\ 2>x & >-\\frac{3}{2}\\end{aligned}\n$$\n\nTo make the final result easier to read, we will rewrite it so that the smaller number is on the left:\n\n$$\n-\\frac{3}{2}<x<2\n$$"} :step/id #uuid "092d0805-5447-576b-a17e-54b3ad43c01d"} {:db/id #edb/ref 17592186566284 :step/content {:db/id #edb/ref 17592186566252 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f44d0466-c408-5e41-8a17-4922edc6fc87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\le" :db/id #edb/ref 17592186566081}] :answer-field/correct {:db/id #edb/ref 17592186566081} :answer-field/id #uuid "06f783ed-065d-530e-89c3-25679100f5ba" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566104} {:answer-field/choices [{:answer/id #uuid "eeb328f6-b0da-51cb-9333-98b341faf744" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186566069}] :answer-field/correct {:db/id #edb/ref 17592186566069} :answer-field/id #uuid "40bc61d6-c33d-519f-9d63-3b3a754770bb" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566131} {:answer-field/choices [{:answer/id #uuid "7db52e48-bc09-525b-b21b-f21d6b279d4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186565879}] :answer-field/correct {:db/id #edb/ref 17592186565879} :answer-field/id #uuid "b7c3dc5e-28b7-50fa-8358-354ed10eb732" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566176}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "92ccb6ea-9886-5668-a071-d63ea68855d0" :question/math-academy-id "q-212475" :question/problem "Solve the absolute value inequality $|9-6t|\\le 15.$\n\n{{field-1}}{{field-2}}\n$t\\le $\n{{field-3}}" :question/worked-solution "We convert the absolute value inequality into a compound inequality to remove the absolute value. \n\nThe inequality specifies every number $9-6t$ whose distance from zero is less than or equal to $15.$ This corresponds to the following compound inequality:\n\n$$\n-15\\le 9-6t\\le 15\n$$\n\nNow, we can solve the compound inequality using the usual methods. (Remember that whenever we multiply or divide by a negative number, we have to flip the inequality signs.)\n\n$$\n\\begin{aligned}-15\\le 9-6t & \\le 15 \\\\ -24\\le -6t & \\le 6 \\\\ 24\\ge 6t & \\ge -6 \\\\ 4\\ge t & \\ge -1\\end{aligned}\n$$\n\nTo make the final result easier to read, we will rewrite it so that the smaller number is on the left:\n\n$$\n-1\\le t\\le 4\n$$"} :step/id #uuid "3785d2d9-e2e4-593e-9a24-974c008dc131" :step/next {:db/id #edb/ref 17592186566276}} {:db/id #edb/ref 17592186566308 :step/content {:db/id #edb/ref 17592186566272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ea1dda3-7062-5057-a8f3-ea9aa8c4de66" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x<-3\\,$ or $\\,x>3$" :db/id #edb/ref 17592186565781} {:answer/id #uuid "57fd8ee1-545a-50ff-bd32-d6f3d758be85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3<x<0" :db/id #edb/ref 17592186565824} {:answer/id #uuid "91a5954a-fc8c-5db8-8e63-6f4a547dc8bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x<3" :db/id #edb/ref 17592186565912} {:answer/id #uuid "99a3a142-d530-5cc9-8a6c-c731befc6219" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x<-3\\,$ or $\\,x>0$" :db/id #edb/ref 17592186565923} {:answer/id #uuid "f6dcd87c-6b54-585b-bb16-02d362d3dafc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$x<0\\,$ or $\\,x>3$" :db/id #edb/ref 17592186566085}] :answer-field/correct {:db/id #edb/ref 17592186566085} :answer-field/id #uuid "7eadfe36-02bc-5c72-8ee0-4c562c298f63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566158}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f551ab94-4892-58d5-baeb-a476fa14edd7" :question/math-academy-id "q-29945" :question/problem "Solve the absolute value inequality $|3-2x|>3.$" :question/worked-solution "We convert the absolute value inequality into a compound inequality to remove the absolute value. \n\nThe inequality specifies every number $3-2x$ whose distance from zero is greater than $3.$ This corresponds to the following compound inequality:\n\n$$\n\\begin{aligned}3-2x & <-3 & \\text{or} &  & 3-2x & >3\\end{aligned}\n$$\n\nNow, we can solve each inequality using the usual methods. (Remember that whenever we multiply or divide by a negative number, we have to flip the inequality signs.)\n\n$$\n\\begin{aligned}3-2x & <-3 &  &  & 3-2x & >3 \\\\ -2x & <-6 &  &  & -2x & >0 \\\\ x & >3 &  &  & x & <0\\end{aligned}\n$$\n\nTherefore, the final solution is\n\n$$\n\\begin{aligned}x & <0 & \\text{or} &  & x & >3.\\end{aligned}\n$$"} :step/id #uuid "c0983f07-671a-561c-9c11-ce7559a3e571" :step/next {:db/id #edb/ref 17592186566284}}] :activity/title "Absolute Value Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186565674}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186106853} :activity/id #uuid "21a47620-e3ce-58d1-b236-202e42fddc8e" :activity/scope {:db/id #edb/ref 17592186049388 :topic/id #uuid "f0cae3f1-329e-50d8-bc2d-f933c5aca17d" :topic/math-academy-id 1397} :activity/steps [{:db/id #edb/ref 17592186106853 :step/content {:db/id #edb/ref 17592186107053 :tutorial/content "The **area of a triangle** can be computed using the formula\n\n$$\n\\mathcal{A} = \\dfrac{b \\cdot h}{2},\n$$\n\nwhere $b$ is a *base* of the triangle and $h$ is the corresponding *height*.\n\nTo demonstrate, let's compute the area of the triangle with base \n$b = 4$\nand the corresponding height is\n$h = 8,$\nas shown below.\n\n![](images/84/84de11aac8e9f33a459f2a83647dac43eb2054445d842ac769511711366a15ec.png)\n\nThe area is\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\  & =\\frac{4\\cdot 8}{2} \\\\  & =\\frac{32}{2} \\\\  & =16.\\end{aligned}\n$$\n\n**Note:** At the end of the lesson, we'll demonstrate where the formula comes from. But first, let's get some practice using it." :tutorial/id #uuid "bf61df49-32c4-50ee-a6f4-21f9da391a02" :tutorial/math-academy-id 2306 :tutorial/title "Introduction"} :step/id #uuid "4293d690-2bd3-5e64-91c6-7e02a0c764f9" :step/math-academy-id 416085 :step/next {:db/id #edb/ref 17592186106854}} {:db/id #edb/ref 17592186106854 :step/content {:db/id #edb/ref 17592186105870 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105541 :question/id #uuid "fc5fc31e-f585-5d15-8a8a-eb0d19704e9a" :question/math-academy-id "e-2947"} :knowledge-point/id #uuid "b6c58537-344e-5842-b68c-d9b5a9d7ca96" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048472} {:db/id #edb/ref 17592186049608}] :knowledge-point/questions [{:db/id #edb/ref 17592186106402} {:db/id #edb/ref 17592186106403} {:db/id #edb/ref 17592186253331} {:db/id #edb/ref 17592186284686} {:db/id #edb/ref 17592186332895} {:db/id #edb/ref 17592186392749} {:db/id #edb/ref 17592186508965} {:db/id #edb/ref 17592186508973}] :knowledge-point/title "Calculating the Area of a Triangle"} :step/id #uuid "a5cb1ab1-345e-5828-babf-f43dc62b43f0" :step/math-academy-id 416086 :step/next {:db/id #edb/ref 17592186106855}} {:db/id #edb/ref 17592186106855 :step/content {:db/id #edb/ref 17592186105871 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105542 :question/id #uuid "cdb1d145-6e8a-5213-a7f7-8076440cbbeb" :question/math-academy-id "e-2949"} :knowledge-point/id #uuid "6445834c-7788-5427-a72c-30b06cc8e6ab" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050428}] :knowledge-point/questions [{:db/id #edb/ref 17592186106193} {:db/id #edb/ref 17592186106194} {:db/id #edb/ref 17592186354593} {:db/id #edb/ref 17592186354594} {:db/id #edb/ref 17592186354604} {:db/id #edb/ref 17592186354605} {:db/id #edb/ref 17592186399961} {:db/id #edb/ref 17592186549052} {:db/id #edb/ref 17592186573258}] :knowledge-point/title "Calculating the Area of an Isosceles Right Triangle"} :step/id #uuid "bf4e1141-e78b-57d6-8b32-737373cca813" :step/math-academy-id 416089 :step/next {:db/id #edb/ref 17592186106856}} {:db/id #edb/ref 17592186106856 :step/content {:db/id #edb/ref 17592186105872 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105543 :question/id #uuid "58e1ce31-f6fc-5900-ab89-e00241045b12" :question/math-academy-id "e-2950"} :knowledge-point/id #uuid "a7656d23-06c9-5d22-b62a-3636bca66ab6" :knowledge-point/questions [{:db/id #edb/ref 17592186106155} {:db/id #edb/ref 17592186106388} {:db/id #edb/ref 17592186253335} {:db/id #edb/ref 17592186253338} {:db/id #edb/ref 17592186386869} {:db/id #edb/ref 17592186404426} {:db/id #edb/ref 17592186508991} {:db/id #edb/ref 17592186508996} {:db/id #edb/ref 17592186549027}] :knowledge-point/title "Finding the Base or the Height of a Triangle Given Its Area"} :step/id #uuid "e81bf9a1-61c3-5dc2-8537-01fb6d1a7871" :step/math-academy-id 416092 :step/next {:db/id #edb/ref 17592186106857}} {:db/id #edb/ref 17592186106857 :step/content {:db/id #edb/ref 17592186107055 :tutorial/content "We know that the area formula for a triangle is\n\n$$\n\\mathcal{A} = \\dfrac{b \\cdot h}{2},\n$$\n\nwhere $b$ is a base and $h$ is the corresponding height.\n\nBut where does this formula come from?\n\nTo understand where the formula comes from, consider $\\triangle{ABC}$ below.\n\n![](images/02/02c1ace5f18e9204c1559f08f591ecd692f00691c48cbee81bc4426c3b34400e.png)\n\nLet's draw a rectangle around $\\triangle{ABC},$ as follows:\n\n![](images/89/893026324410235de9cb7ac286867006593a451556587c60219fe4375a4218a4.png)\n\nWe have two pairs of right triangles with equal areas (each pair is indicated with arrows).\n\nSo, the area of $\\triangle{ABC}$ is exactly half of the area of the rectangle. This gives\n\n$$\n\\mathcal{A}_{ABC} = \\dfrac{AB \\cdot CH}{2}.\n$$" :tutorial/id #uuid "b5be18d9-4833-50c8-8800-085d64e21ce8" :tutorial/math-academy-id 2311 :tutorial/title "Proof of the Formula"} :step/id #uuid "d47b1a6f-6091-5f5b-832a-9ce0b04d1526" :step/math-academy-id 416095}] :activity/title "Areas of Triangles" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186106016}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186549099} :activity/id #uuid "58c010c8-8685-5554-94e6-4a528432d38e" :activity/scope {:db/id #edb/ref 17592186049388 :topic/id #uuid "f0cae3f1-329e-50d8-bc2d-f933c5aca17d" :topic/math-academy-id 1397} :activity/steps [{:db/id #edb/ref 17592186549084 :step/content {:db/id #edb/ref 17592186549052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "417abf8e-a35f-5695-b467-ef4d6b12c3f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12.5" :db/id #edb/ref 17592186548479} {:answer/id #uuid "5cfd8bf4-6acb-5b60-99c2-c71861b1536a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186548526} {:answer/id #uuid "a449dec1-300a-5c71-8723-ab8f3583b39a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186548678} {:answer/id #uuid "b32a6fda-8006-5e0b-bc5e-adba5d208d71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186548714} {:answer/id #uuid "e8a23dd6-a819-573e-923b-b6ed5c0e58fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32.5" :db/id #edb/ref 17592186548810}] :answer-field/correct {:db/id #edb/ref 17592186548479} :answer-field/id #uuid "20a135df-b545-5cd9-8ae5-be9b531bfe60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186548881}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d45bf6d6-3e38-52ed-a276-f99fe5dd268f" :question/math-academy-id "q-87851" :question/problem "![](images/67/678c719915b0d27c1378548267123cfbac3f13f13ee0a05fd6dacd85164911f6.png)\n\nWhat is the area of the right triangle $ABC$ shown above?" :question/worked-solution "Since $m∠A=m∠C={45}^{∘}$ and $AB=BC,$ we have an isosceles right triangle. \n\n![](images/4d/4d340b37161cb3f970ba588fa15a21b3a35ee376c5766e92d6c48358d4ed003e.png)\n\nTherefore, the area of the triangle is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot {5}^{2} \\\\  & =\\frac{1}{2}\\cdot 25 \\\\  & =12.5\\,.\\end{aligned}\n$$"} :step/id #uuid "1d366aad-cd67-5343-baa4-8059cf6699a9" :step/next {:db/id #edb/ref 17592186549111}} {:db/id #edb/ref 17592186549099 :step/content {:db/id #edb/ref 17592186549027 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ed3ec42-7887-59f4-8607-49a2c72ca3d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "49\\,cm" :db/id #edb/ref 17592186548449} {:answer/id #uuid "498f62c4-d10e-5980-af7b-cf193748dc55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18\\,cm" :db/id #edb/ref 17592186548494} {:answer/id #uuid "68718dec-ecd8-5ae5-a90a-23ccd4586c90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,cm" :db/id #edb/ref 17592186548552} {:answer/id #uuid "897c0883-8ea7-5679-b872-375f1438d23b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\,cm" :db/id #edb/ref 17592186548619} {:answer/id #uuid "b854d192-b8ff-551c-8ab1-aef38e4dfe2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14\\,cm" :db/id #edb/ref 17592186548723}] :answer-field/correct {:db/id #edb/ref 17592186548619} :answer-field/id #uuid "8da7771e-63f1-5e10-be3c-1af25ccedf2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186548930}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8d086598-d0f7-52ac-bba9-a6017b092d64" :question/math-academy-id "q-21051" :question/problem "![](images/c8/c85e6ee974a59d956367634fdd1d57b65e9d42a980fe1750886527b173f05d32.png)\n\nFind $BM$ given that the area of $△ACB$ is $49\\,{cm}^{2},$ $AM=5\\,cm,$ and $MC=9\\,cm.$\n\n(Figure not drawn to scale)" :question/worked-solution "The area of the triangle is defined as \n\n$$\nA=\\frac{b\\cdot h}{2},\n$$\n\n where $b$ is the base and $h$ is the corresponding height.\n\nFrom the diagram, we see that the height is $h=BM,$ and the corresponding base is \n\n$$\nb=AM+MC=14\\,cm.\n$$\n\nTherefore, using the formula for the area, we can solve for the height as follows:\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\ 49 & =\\frac{14\\cdot h}{2} \\\\ 98 & =14\\cdot h \\\\ h & =\\frac{98}{14} \\\\ h & =7\\,cm\\end{aligned}\n$$\n\nAs a result, $BM=7\\,\\text{cm}.$"} :step/id #uuid "51c06ce5-a234-5a1a-aa5e-9042f0827d88" :step/next {:db/id #edb/ref 17592186549084}} {:db/id #edb/ref 17592186549111 :step/content {:db/id #edb/ref 17592186354604 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2db54839-6a5b-5b75-9ac0-2fe3487ce8c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "800" :db/id #edb/ref 17592186351989} {:answer/id #uuid "43e30190-4e81-5fda-b3a5-079b052411c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100" :db/id #edb/ref 17592186352191} {:answer/id #uuid "43f1421d-10d0-5af6-8262-60e55e5615e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186352192} {:answer/id #uuid "50c4006c-d6f4-5cb3-977c-4236359a9cc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "200" :db/id #edb/ref 17592186352294} {:answer/id #uuid "7d349513-c9f4-5a55-81fa-6b46f8d0946e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "400" :db/id #edb/ref 17592186352666}] :answer-field/correct {:db/id #edb/ref 17592186352294} :answer-field/id #uuid "23513061-aa39-51dd-a874-2807ff166615" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186353872}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2e4dded3-cef3-55b9-ba8c-e50ddf3e7619" :question/math-academy-id "q-87853" :question/problem "![](images/16/1616f8d921cbdaf1a5654354292e261b0941e5dbfcee16ae620c8a1cf3e92135.png)\n\nWhat is the area of the right triangle $ABC$ shown above?" :question/worked-solution "Since $m∠A=m∠C={45}^{∘}$ and $AB=BC,$ we have an isosceles right  triangle. \n\n![](images/3f/3f9a52834fe76f1560beec8580dbd91076a9f7c6ef980f410aa5bfe7da162c9c.png)\n\nTherefore, the area of the triangle is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot {20}^{2} \\\\  & =\\frac{1}{2}\\cdot 400 \\\\  & =200.\\end{aligned}\n$$"} :step/id #uuid "7462aa22-72f5-51d7-bde0-cc38a35c0d8c"}] :activity/title "Areas of Triangles" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186548343}] [{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186065104} :activity/id #uuid "8d3261ec-ded8-5b6d-ac21-5c0ada0ad6a0" :activity/scope {:db/id #edb/ref 17592186049597 :topic/id #uuid "03616d92-38bb-52d1-b636-cc62f67b859d" :topic/math-academy-id 350} :activity/steps [{:db/id #edb/ref 17592186065104 :step/content {:db/id #edb/ref 17592186065437 :tutorial/content "Suppose we want to find all of the values of $x$ that satisfy *both* $3x+9 \\geq 0$ *and* $2x \\leq -2$ simultaneously. \n\nTo do this, we solve each inequality individually and then compute the intersection of the two solutions.\n\n- We start by solving $3x + 9 \\geq 0\\mathbin{:}$\n\n$$\n\\begin{aligned}3x+9 & \\ge 0 \\\\ 3x+9-9 & \\ge 0-9 \\\\ 3x & \\ge -9 \\\\ \\frac{3x}{3} & \\ge \\frac{-9}{3} \\\\ x & \\ge -3\\end{aligned}\n$$\n\nThe solution to this inequality is shown on the number line below.\n\n![](images/51/5127629c09f32bb8ed7872b476322d6973e44e82be7977492c8dd0967d3cb0ec.png)\n\n- Then, we solve $2x \\leq -2\\mathbin{:}$\n\n$$\n\\begin{aligned}2x & \\le -2 \\\\ \\frac{2x}{2} & \\le \\frac{-2}{2} \\\\ x & \\le -1\\end{aligned}\n$$\n\nThe solution to this inequality is shown on the number line below.\n\n![](images/35/35e30bc9c45b08793d847c8750698f7d9dab781438405239ed4483ce82f2dcfb.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/fe/fe4c223767cb06d9d620d32f5e668c7305688b3870bf0317304c56b11053e19f.png)\n\nThus, the final solution is $\\color{blue}-3 \\leq x \\leq -1.$" :tutorial/id #uuid "79460753-2a4c-5227-8dcd-7355a1841558" :tutorial/math-academy-id 8687 :tutorial/title "Introduction"} :step/id #uuid "f583864f-f671-5e7b-bc34-8fcce050be85" :step/math-academy-id 171168 :step/next {:db/id #edb/ref 17592186065105}} {:db/id #edb/ref 17592186065105 :step/content {:db/id #edb/ref 17592186064237 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063973 :question/id #uuid "f55392b5-8cb5-516c-8151-051768d813dd" :question/math-academy-id "e-13948"} :knowledge-point/id #uuid "53bf0d67-be51-5194-884b-e275d58a2ba1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048483} {:db/id #edb/ref 17592186049270} {:db/id #edb/ref 17592186050503}] :knowledge-point/questions [{:db/id #edb/ref 17592186064470} {:db/id #edb/ref 17592186064602} {:db/id #edb/ref 17592186064660} {:db/id #edb/ref 17592186510367} {:db/id #edb/ref 17592186510458}] :knowledge-point/title "Finding the Intersection of Two Inequalities"} :step/id #uuid "571d4995-c070-510a-b196-97efcbe7b3c6" :step/math-academy-id 171169 :step/next {:db/id #edb/ref 17592186065106}} {:db/id #edb/ref 17592186065106 :step/content {:db/id #edb/ref 17592186064238 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063975 :question/id #uuid "f088ca30-8538-57e7-9882-99d5c155c505" :question/math-academy-id "e-13952"} :knowledge-point/id #uuid "79f6f04e-ecce-5318-b72b-46478661ced0" :knowledge-point/questions [{:db/id #edb/ref 17592186064603} {:db/id #edb/ref 17592186064656} {:db/id #edb/ref 17592186064895} {:db/id #edb/ref 17592186510423} {:db/id #edb/ref 17592186510436} {:db/id #edb/ref 17592186567078}] :knowledge-point/title "Solving Systems of Inequalities"} :step/id #uuid "b8f6c481-c857-541c-8eeb-23a9bcc07e97" :step/math-academy-id 171173 :step/next {:db/id #edb/ref 17592186065107}} {:db/id #edb/ref 17592186065107 :step/content {:db/id #edb/ref 17592186064239 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063978 :question/id #uuid "0a39d86b-ab9b-5479-9d7b-726247558397" :question/math-academy-id "e-13959"} :knowledge-point/id #uuid "c9460289-3e48-558e-b149-3e12a25e50a6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049162} {:db/id #edb/ref 17592186050301}] :knowledge-point/questions [{:db/id #edb/ref 17592186064471} {:db/id #edb/ref 17592186064604} {:db/id #edb/ref 17592186064913} {:db/id #edb/ref 17592186510442} {:db/id #edb/ref 17592186510467} {:db/id #edb/ref 17592186541097} {:db/id #edb/ref 17592186541146} {:db/id #edb/ref 17592186567014} {:db/id #edb/ref 17592186573272}] :knowledge-point/title "Flipping the Sign of an Inequality in a System"} :step/id #uuid "1b6abea6-1d80-56ff-9f97-1fb883fa340f" :step/math-academy-id 171177 :step/next {:db/id #edb/ref 17592186065108}} {:db/id #edb/ref 17592186065108 :step/content {:db/id #edb/ref 17592186064240 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063979 :question/id #uuid "d2726a15-72d6-5c0c-8302-68ba55f8734d" :question/math-academy-id "e-13961"} :knowledge-point/id #uuid "d3286dfe-5140-5ba7-8e34-c98e63dc15c0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050734}] :knowledge-point/questions [{:db/id #edb/ref 17592186064518} {:db/id #edb/ref 17592186064605} {:db/id #edb/ref 17592186510429} {:db/id #edb/ref 17592186541075} {:db/id #edb/ref 17592186567048}] :knowledge-point/title "Systems Containing Compound Inequalities"} :step/id #uuid "826c8505-1d09-51a4-a0f1-27d2b362db4d" :step/math-academy-id 171181}] :activity/title "Compound AND Inequalities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064440}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186541209} :activity/id #uuid "c90a0db0-b9be-51c5-9118-106956e6ede9" :activity/scope {:db/id #edb/ref 17592186049597 :topic/id #uuid "03616d92-38bb-52d1-b636-cc62f67b859d" :topic/math-academy-id 350} :activity/steps [{:db/id #edb/ref 17592186541174 :step/content {:db/id #edb/ref 17592186541146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bf162e4-cd7b-54b0-8466-f4b821b2abe0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (1,2)" :db/id #edb/ref 17592186540629} {:answer/id #uuid "58c4a563-279d-570a-a388-2ff52a0b29f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (1,2]" :db/id #edb/ref 17592186540679} {:answer/id #uuid "5b4c177a-706d-56c0-a404-7bc45e333979" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (1,\\infty )" :db/id #edb/ref 17592186540681} {:answer/id #uuid "b8c8fe3f-912f-5186-af72-dca875ba83b7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no solution" :db/id #edb/ref 17592186540837} {:answer/id #uuid "dedbb23f-f487-5d15-9528-e264d7f421c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,2)" :db/id #edb/ref 17592186540908}] :answer-field/correct {:db/id #edb/ref 17592186540679} :answer-field/id #uuid "3b901c12-2a57-5d11-9bb4-941a5ba8e6d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540968}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e3894629-c728-5b78-885d-1ca88944c278" :question/math-academy-id "q-156096" :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}2x+4>6 \\\\ 4-x\\ge 2\\end{aligned}\n$$" :question/worked-solution "To solve the system, we need to find the values of $k$ that satisfy both $2x+4>6$ and $4-x\\ge 2$ simultaneously.\n\n- First, we solve $2x+4>6:$ \n\n$$\n\\begin{aligned}2x+4 & >6 \\\\ 2x+4-4 & >6-4 \\\\ 2x & >2 \\\\ \\frac{2x}{2} & >\\frac{2}{2} \\\\ x & >1\\end{aligned}\n$$\n\n![](images/6d/6d3b61147527a632ccb46629a356e9f5c92a1ddfc8a52f3d0890cd46eb56f564.png)\n\n- Then, we solve $4-x\\ge 2:$ \n\n$$\n\\begin{aligned}4-x & \\ge 2 \\\\ 4-x-4 & \\ge 2-4 \\\\ -x & \\ge -2 \\\\ (-1)\\cdot (-x) & \\le (-1)\\cdot (-2) \\\\ x & \\le 2\\end{aligned}\n$$\n\n![](images/14/1452391c950b051c4cf454723498e6fa657f6d5f1315f78e50f3450bf7fbc1eb.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/a2/a22a207cc64d33470e27d0b1f45ad0b87106fafd67b88c2163524a44951639bf.png)\n\n    \n\nThus, the final solution is $x\\in (1,2].$"} :step/id #uuid "39304ff2-c632-5bfe-be88-8e807d05822b" :step/next {:db/id #edb/ref 17592186541196}} {:db/id #edb/ref 17592186541196 :step/content {:db/id #edb/ref 17592186541075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "384fd572-a66f-5128-a6b3-44005974b90d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no solution" :db/id #edb/ref 17592186540618} {:answer/id #uuid "3b432c6d-0781-5270-b3f1-15ea3f1af7fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [1,3)" :db/id #edb/ref 17592186540623} {:answer/id #uuid "9852c2c1-fa2d-5d40-ab08-ac566524df45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,-1)\\cup [-2,3]" :db/id #edb/ref 17592186540784} {:answer/id #uuid "a5a74e4a-4c8d-5255-a204-4cf5d72033a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (2,3]" :db/id #edb/ref 17592186540803} {:answer/id #uuid "a7208089-38df-5278-b199-6279ab8f6251" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,-1)" :db/id #edb/ref 17592186540806}] :answer-field/correct {:db/id #edb/ref 17592186540618} :answer-field/id #uuid "db98ca20-fac1-5cbb-9acf-371f7dfc8910" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186541037}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3cd6f974-c65a-5148-8d00-27906b9e797b" :question/math-academy-id "q-156129" :question/problem "Find the set of values of $x$ that satisfy $2<2x+4\\le 6$ and $4x>12.$" :question/worked-solution "To solve compound \"and\" inequalities, we solve each inequality separately and then find their intersection.\n\n- First, we solve $2<2x+4\\le 6\\,:$ \n\n$$\n\\begin{aligned}2 & <2x+4\\le 6 \\\\ 2-4 & <2x+4-4\\le 6-4 \\\\ -2 & <2x\\le 2 \\\\ \\frac{-2}{2} & <\\frac{2x}{2}\\le \\frac{2}{2} \\\\ -1 & <x\\le 1\\end{aligned}\n$$\n\n![](images/48/485e77fe84f5745120d5f450c3e1043ee61463a83f7c12bfc6d1ae0e4124a38b.png)\n\n   \n\n- Then, we solve  $4x>12\\,:$\n\n$$\n\\begin{aligned}4x & >12 \\\\ \\frac{4x}{4} & >\\frac{12}{4} \\\\ x & >3\\end{aligned}\n$$\n\n![](images/65/654f97a64ec1a13b4a94860dfa07d05f7c119a5fe2084ba23aa994a97f0bea70.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/d2/d2d0f41792356b6c250612b033413f66bfd7a35440e1b84da660fccd5c1285b0.png)\n\n$$\n\n$$\n\nIt turns out that the solutions do not overlap at all. Therefore, there are no values of $x$ that satisfy both inequalities simultaneously. So, there is no solution."} :step/id #uuid "83ea5dfe-2530-5a49-b45b-ff45d9eb5966"} {:db/id #edb/ref 17592186541209 :step/content {:db/id #edb/ref 17592186541097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "360b3e1c-48bd-528c-9d5d-938043d6c2b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [-3,1)" :db/id #edb/ref 17592186540614} {:answer/id #uuid "3f31d9f9-5c07-5bf0-9421-ad3c02ba0764" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-\\infty ,1)" :db/id #edb/ref 17592186540634} {:answer/id #uuid "582fa1a5-35f2-55f1-ba22-a7eb59f9b896" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no solution" :db/id #edb/ref 17592186540677} {:answer/id #uuid "88eadd3f-76f1-5d70-87a5-4c7bc2dd9b57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [-3,\\infty )" :db/id #edb/ref 17592186540758} {:answer/id #uuid "d71fd4ba-85b7-5c46-8cbc-f5708e1bd047" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (-1,3]" :db/id #edb/ref 17592186540890}] :answer-field/correct {:db/id #edb/ref 17592186540614} :answer-field/id #uuid "36a01c9a-6a75-5d02-8751-2d076edf1a6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540966}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ef129d9-0a92-5a3f-b637-51eadd473818" :question/math-academy-id "q-156055" :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}x+3<4 \\\\ 3-2x\\le 9\\end{aligned}\n$$" :question/worked-solution "To solve the system, we need to find the values of $x$ that satisfy both $x+3<4$ and $3-2x\\le 9$ simultaneously.\n\n- First, we solve $x+3<4\\,:$ \n\n$$\n\\begin{aligned}x+3 & <4 \\\\ x+3-3 & <4-3 \\\\ x & <1\\end{aligned}\n$$\n\n![](images/c2/c20ffc0279a42a429797f42fcd929fb4dfb499e311dd3ed7b6b61fd95729953c.png)\n\n$$\n\n$$\n\n- Then, we solve $3-2x\\le 9\\,:$\n\n$$\n\\begin{aligned}3-2x & \\le 9 \\\\ 3-2x-3 & \\le 9-3 \\\\ -2x & \\le 6 \\\\ (-1)\\cdot (-2x) & \\ge (-1)\\cdot 6 \\\\ 2x & \\ge -6 \\\\ \\frac{2x}{2} & \\ge \\frac{-6}{2} \\\\ x & \\ge -3\\end{aligned}\n$$\n\n![](images/ae/ae72342a32ea8a952a3d00aec7a8ccc381804ae4b593ba58113911c4bc4b2c09.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/b7/b7d4814919a8c0b2a2ed8e130c8af2bdce5e7fd2d23d10e50e4e293d88170c2f.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $x\\in [-3,1).$"} :step/id #uuid "a4e60d9b-c652-5fbe-abd0-d69cda48b5f5" :step/next {:db/id #edb/ref 17592186541174}}] :activity/title "Compound AND Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186540524}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186567131} :activity/id #uuid "e6e5530b-ac3a-5a1c-8f43-75afa94c2ed2" :activity/scope {:db/id #edb/ref 17592186049597 :topic/id #uuid "03616d92-38bb-52d1-b636-cc62f67b859d" :topic/math-academy-id 350} :activity/steps [{:db/id #edb/ref 17592186567131 :step/content {:db/id #edb/ref 17592186567014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26d0891c-161c-5834-b9eb-6586cb0c9bc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n\\in [-3,3)" :db/id #edb/ref 17592186566446} {:answer/id #uuid "51695b2b-00d2-5afd-9514-8c7464cb7b59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n\\in (1,3)" :db/id #edb/ref 17592186566517} {:answer/id #uuid "82ae7df2-949d-5f30-8f35-50b577c6c509" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no solution" :db/id #edb/ref 17592186566612} {:answer/id #uuid "ed75b313-51b7-5ed1-ad30-3536875d859b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n\\in [-3,1)" :db/id #edb/ref 17592186566844} {:answer/id #uuid "f7a0d75b-e243-5815-8927-4c35ba1889f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "n\\in [-1,3)" :db/id #edb/ref 17592186566859}] :answer-field/correct {:db/id #edb/ref 17592186566859} :answer-field/id #uuid "f016f7be-fb1c-5a42-bf74-e51c3d868c27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566994}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0e2e4815-0beb-5581-be50-52ebe618cd02" :question/math-academy-id "q-156127" :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}n+2<5 \\\\ 1-2n\\le 3\\end{aligned}\n$$" :question/worked-solution "To solve the system, we need to find the values of $n$ that satisfy both $n+2<5$ and $1-2n\\le 3$ simultaneously.\n\n- First, we solve $n+2<5\\,:$ \n\n$$\n\\begin{aligned}n+2 & <5 \\\\ n+2-2 & <5-2 \\\\ n & <3\\end{aligned}\n$$\n\n![](images/4e/4e6e1c1a65abf5b7b88d39bb4d2606d64d5bc9ae526925e9f869eab0927194e3.png)\n\n$$\n\n$$\n\n- Then, we solve $1-2n\\le 3\\,:$\n\n$$\n\\begin{aligned}1-2n & \\le 3 \\\\ 1-2n-1 & \\le 3-1 \\\\ -2n & \\le 2 \\\\ (-1)\\cdot (-2n) & \\ge (-1)\\cdot 2 \\\\ 2n & \\ge -2 \\\\ \\frac{2n}{2} & \\ge \\frac{-2}{2} \\\\ n & \\ge -1\\end{aligned}\n$$\n\n![](images/8e/8e96c91b84e3c69b2e8f58251dbe21294ef8b23ffa695c1b7fbe53ad4f22b2fc.png)\n\nTo find the values of $n$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/cd/cd1d2ad0e357eb3117e5b61351afeda01a348bfff5aec1a2d2940c77ecae120c.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $n\\in [-1,3).$"} :step/id #uuid "7435e07b-f0f9-5485-9a88-0f7e4a9d5287" :step/next {:db/id #edb/ref 17592186567150}} {:db/id #edb/ref 17592186567146 :step/content {:db/id #edb/ref 17592186567078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "916544ca-e729-52f9-99f7-464a605534c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186566649}] :answer-field/correct {:db/id #edb/ref 17592186566649} :answer-field/id #uuid "30c5013c-7ef7-5aa3-9cbc-e11a67222488" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566898} {:answer-field/choices [{:answer/id #uuid "ad0c248c-2575-5291-8824-399e68cd193b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "<" :db/id #edb/ref 17592186566707}] :answer-field/correct {:db/id #edb/ref 17592186566707} :answer-field/id #uuid "53abe454-b2dd-5ad2-8fe1-b231d8cd91f2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566914} {:answer-field/choices [{:answer/id #uuid "c3df23fd-8dd2-5adf-999f-c1d609ac0517" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186566751}] :answer-field/correct {:db/id #edb/ref 17592186566751} :answer-field/id #uuid "e8fccfc7-d496-5162-8471-a2686b179c57" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186566989}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b2b2b02a-ff73-57d9-825a-216db2bab95b" :question/math-academy-id "q-208784" :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}y-5\\le 2 \\\\ 2y+7>11\\end{aligned}\n$$\n\nThe solution is\n{{field-1}}{{field-2}}\n$y\\le $\n{{field-3}}." :question/worked-solution "To solve the system, we need to find the values of $y$ that satisfy both $y-5\\le 2$ and $2y+7>11$ simultaneously.\n\n- First, we solve $y-5\\le 2\\,:$\n\n$$\n\\begin{aligned}y-5 & \\le 2 \\\\ y-5+5 & \\le 2+5 \\\\ y & \\le 7\\end{aligned}\n$$\n\n![](images/b0/b0107bec7ccb2c56036de405a29870e8cfcc166cc6405f425fc3296ec8f1be2b.png)\n\n$$\n\n$$\n\n- Then, we solve $2y+7>11\\,:$\n\n$$\n\\begin{aligned}2y+7 & >11 \\\\ 2y+7-7 & >11-7 \\\\ 2y & >4 \\\\ \\frac{2y}{2} & >\\frac{4}{2} \\\\ y & >2\\end{aligned}\n$$\n\n![](images/59/59523e51144ef776295ec43032def1bc0192351deb6294fbb2d56acd87bb2cac.png)\n\n$$\n\n$$\n\nTo find the values of $y$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/98/981477f5336b96998b61b7ab18647609cb33c12984c14049621ac15c698c25a5.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $2<y\\le 7.$"} :step/id #uuid "c706594b-42c2-5706-a6e2-8d898feb9c13"} {:db/id #edb/ref 17592186567150 :step/content {:db/id #edb/ref 17592186567048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09f83060-457e-51bb-a48c-880d80b51fa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (0,3)" :db/id #edb/ref 17592186566384} {:answer/id #uuid "2c7f2bd0-2eb9-577c-8ebe-c9c59314df42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (3,2]" :db/id #edb/ref 17592186566454} {:answer/id #uuid "62a7710c-4104-514f-9c9a-a23045e79c8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in [-3,1)" :db/id #edb/ref 17592186566553} {:answer/id #uuid "941d31e7-a180-5faa-b9a0-cad9aa59b9a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\in (1,3]" :db/id #edb/ref 17592186566652} {:answer/id #uuid "c2287c90-b752-5994-8a09-4fd688b59847" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "There is no solution" :db/id #edb/ref 17592186566747}] :answer-field/correct {:db/id #edb/ref 17592186566652} :answer-field/id #uuid "1afdbe50-eaa8-50d5-ae52-c02ad59c8fa8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186566889}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6919ce13-e2d9-594d-bb7b-2bdd566b01d1" :question/math-academy-id "q-156128" :question/problem "Find the set of values of $x$ that satisfy $1<2x-1\\le 5$ and $1-2x\\le 3.$" :question/worked-solution "To solve compound \"and\" inequalities, we solve each inequality separately and then find their intersection.\n\n- First, we solve $1<2x-1\\le 5\\,:$\n\n$$\n\\begin{aligned}1 & <2x-1\\le 5 \\\\ 1+1 & <2x-1+1\\le 5+1 \\\\ 2 & <2x\\le 6 \\\\ \\frac{2}{2} & <\\frac{2x}{2}\\le \\frac{6}{2} \\\\ 1 & <x\\le 3\\end{aligned}\n$$\n\n![](images/2b/2b111554de3019b78a3d6e8992477bb1401a53d7c2bbe09a6407e675b8d06daa.png)\n\n- Then, we solve  $1-2x\\le 3\\,:$\n\n$$\n\\begin{aligned}1-2x & \\le 3 \\\\ 1-2x-1 & \\le 3-1 \\\\ -2x & \\le 2 \\\\ (-1)\\cdot (-2x) & \\ge (-1)\\cdot 2 \\\\ 2x & \\ge -2 \\\\ \\frac{2x}{2} & \\ge \\frac{-2}{2} \\\\ x & \\ge -1\\end{aligned}\n$$\n\n![](images/ca/ca4d8a229772ec9d22a45c99cdad22379b6b55aa5d6fe4bb6288fe66d8c5696a.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/74/74cc11cbd20e5b82171d4c89407f24eb6f60ee558bf41a313009839c6f885f7e.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $x\\in (1,3].$"} :step/id #uuid "ddff42aa-f427-5cc0-ac91-0c80184cf30e" :step/next {:db/id #edb/ref 17592186567146}}] :activity/title "Compound AND Inequalities" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186566359}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186097467} :activity/id #uuid "8f327b60-e0cf-5553-a69d-9f75b2352ae4" :activity/scope {:db/id #edb/ref 17592186049603 :topic/id #uuid "03d5463d-8db1-5e89-8946-23139052e041" :topic/math-academy-id 1100} :activity/steps [{:db/id #edb/ref 17592186097467 :step/content {:db/id #edb/ref 17592186097828 :tutorial/content "Given two vectors, we can compute the sum by placing the head of one vector at the tail of the other.\n\nFor example, let's consider the two vectors $\\textbf{a}$ and $\\textbf{b}$ below.\n\n![](images/04/049f79ae22e5931a7ceba7f73fef5cb6bc38d17c2a45e7186d57f8760b02488a.png)\n\nTo find $\\mathbf{a}+\\mathbf{b},$ we need to draw the second vector $\\textbf{b}$ starting from the head of the first vector $\\textbf{a}.$ Now, the sum $\\mathbf{a}+\\mathbf{b}$ is the vector that we get when we join the tail of $\\textbf{a}$ to the head of $\\textbf{b}\\mathbin{:}$\n\n![](images/98/98a42bc3ecf7071630acc7d29349f75f77b20a9cc1c2c34382161cc79b47b4df.png)\n\nWe call this method the **triangle law of addition**. The vector obtained by adding two or more vectors is sometimes called the **resultant**." :tutorial/id #uuid "f1d80471-b824-5cac-9146-15b6e8b910d2" :tutorial/math-academy-id 2901 :tutorial/title "Introduction"} :step/id #uuid "dbd21225-959b-5fe0-a9cb-fd7a77bebb11" :step/math-academy-id 15685 :step/next {:db/id #edb/ref 17592186097470}} {:db/id #edb/ref 17592186097470 :step/content {:db/id #edb/ref 17592186096642 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096439 :question/id #uuid "96cb0487-40a4-5942-aa43-6ca61830bde0" :question/math-academy-id "e-4272"} :knowledge-point/id #uuid "48176a87-796e-5637-9552-4f7fccdeee6a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050194}] :knowledge-point/questions [{:db/id #edb/ref 17592186096954} {:db/id #edb/ref 17592186097171} {:db/id #edb/ref 17592186510432} {:db/id #edb/ref 17592186510474}] :knowledge-point/title "Adding Two Vectors Using the Triangle Law"} :step/id #uuid "d2226c33-40b3-550e-9ab3-8359f4445fdd" :step/math-academy-id 15688 :step/next {:db/id #edb/ref 17592186097473}} {:db/id #edb/ref 17592186097472 :step/content {:db/id #edb/ref 17592186096644 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096441 :question/id #uuid "6db52d38-e14d-5424-9b54-af258ad7551c" :question/math-academy-id "e-4274"} :knowledge-point/id #uuid "db159911-4e9a-563e-9a3d-58d4e73dc862" :knowledge-point/questions [{:db/id #edb/ref 17592186097335} {:db/id #edb/ref 17592186097336} {:db/id #edb/ref 17592186510410} {:db/id #edb/ref 17592186510477} {:db/id #edb/ref 17592186572191}] :knowledge-point/title "Adding Two Opposite Vectors Using the Triangle Law"} :step/id #uuid "c5e4bcd7-3f24-565d-8d90-7d783587b66c" :step/math-academy-id 15690 :step/next {:db/id #edb/ref 17592186097490}} {:db/id #edb/ref 17592186097473 :step/content {:db/id #edb/ref 17592186097830 :tutorial/content "Given a vector $\\overrightarrow{AB},$ the **opposite vector** is the vector $\\overrightarrow{BA}$ that has the same length but goes in the opposite direction.\n\n![](images/65/6591fd004ba2b74c2651182ce0c70302ac789d868389d057a502b8e98ac61fab.png)\n\nWe write\n\n$$\n\\overrightarrow{AB}=-\\overrightarrow{BA}.\n$$\n\nTo compute the sum of two opposite vectors,\n\n$$\n\\overrightarrow{AB}+\\overrightarrow{BA},\n$$\n\nwe can use the triangle law of addition.\n\nAccording to the triangle law of addition, the resultant is the vector that goes from the tail of $\\overrightarrow{AB}$ to the head of $\\overrightarrow{BA}.$ Therefore, we obtain a new vector for which the tail and head are the same point, $A.$ We denote that vector as\n\n$$\n\\overrightarrow{AB}+\\overrightarrow{BA} = \\overrightarrow{AA}=\\mathbf{0}.\n$$\n\nThe vector $\\mathbf{0}$ is called the **zero vector**. The zero vector has no direction and zero magnitude. With the zero vector, the head coincides with the tail." :tutorial/id #uuid "ff30d4cd-a46e-5658-aada-2885298012f1" :tutorial/math-academy-id 2903 :tutorial/title "Opposite Vectors and the Zero Vector"} :step/id #uuid "9589b39e-7e79-59cb-a04d-4c80d504257a" :step/math-academy-id 15691 :step/next {:db/id #edb/ref 17592186097472}} {:db/id #edb/ref 17592186097475 :step/content {:db/id #edb/ref 17592186096646 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096443 :question/id #uuid "77d2bd5d-5f79-5204-8c65-395ef6414225" :question/math-academy-id "e-4276"} :knowledge-point/id #uuid "e9ae0161-d016-5aef-8c11-020047c66bbd" :knowledge-point/questions [{:db/id #edb/ref 17592186096993} {:db/id #edb/ref 17592186097337} {:db/id #edb/ref 17592186510440} {:db/id #edb/ref 17592186510459}] :knowledge-point/title "Adding More Than Two Vectors Using the Triangle Law"} :step/id #uuid "79ccec21-3796-56f3-a7d4-24bb46c252eb" :step/math-academy-id 15693} {:db/id #edb/ref 17592186097489 :step/content {:db/id #edb/ref 17592186096654 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096453 :question/id #uuid "5fade14b-9fa1-5777-afe3-c061907218f6" :question/math-academy-id "e-4359"} :knowledge-point/id #uuid "711d0e70-a248-5f93-a836-43bed5435d4f" :knowledge-point/questions [{:db/id #edb/ref 17592186096992} {:db/id #edb/ref 17592186097153} {:db/id #edb/ref 17592186510404} {:db/id #edb/ref 17592186510437} {:db/id #edb/ref 17592186572135} {:db/id #edb/ref 17592186572157} {:db/id #edb/ref 17592186573252}] :knowledge-point/title "Subtracting Two Vectors Using the Triangle Law"} :step/id #uuid "9525b995-7556-5826-b108-58b033c286e1" :step/math-academy-id 16022 :step/next {:db/id #edb/ref 17592186097475}} {:db/id #edb/ref 17592186097490 :step/content {:db/id #edb/ref 17592186097838 :tutorial/content "We've seen how to use the triangle law to add two vectors. We can also use the triangle law to subtract two vectors.\n\nThe trick is to interpret the subtraction as the addition of a negative vector. For example, the subtraction\n\n$$\n\\mathbf{a}-\\mathbf{b}\n$$\n\ncan be interpreted as the addition\n\n$$\n\\mathbf{a} + (-\\mathbf{b}),\n$$\n\nwhere $-\\mathbf{b}$ is the vector that has the same magnitude as $\\mathbf{b}$ but goes in the direction *opposite* of $\\mathbf{b}.$\n\nLet's see a concrete example." :tutorial/id #uuid "9e3c330e-f67a-51e0-abd7-144acc20080b" :tutorial/math-academy-id 2960 :tutorial/title "Using the Triangle Law for Subtraction"} :step/id #uuid "e1b5149f-330e-5b4d-8235-f3c9ff3b5ad7" :step/math-academy-id 16023 :step/next {:db/id #edb/ref 17592186097489}}] :activity/title "The Triangle Law for the Addition of Two Vectors" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096880}] [{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186572261} :activity/id #uuid "7d8c6889-f3ae-58cb-b3ca-0eb7b18e98a4" :activity/scope {:db/id #edb/ref 17592186049603 :topic/id #uuid "03d5463d-8db1-5e89-8946-23139052e041" :topic/math-academy-id 1100} :activity/steps [{:db/id #edb/ref 17592186572215 :step/content {:db/id #edb/ref 17592186572191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64a42ea5-cb0d-54c7-b3b7-fd35361140e1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/25/25b5c9f9f5f517b7a3f2f1d5e70e6d7b0183d9ab651838fe735b0f378d7f141a.png" :db/id #edb/ref 17592186571711} {:answer/id #uuid "76ed3423-8abf-5493-8cd1-018a985dcee0" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b5/b5a6d499f13d14643ce47f7decd46d739278c40431412c9cc1862c4dd4e61f55.png" :db/id #edb/ref 17592186571741} {:answer/id #uuid "a7e2846a-fd9c-51da-a226-b4a0df2d034a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/26/26c4988a765a67f300428ef7e921df05bcac4f165c71f65a2ba7471d324452a8.png" :db/id #edb/ref 17592186571828} {:answer/id #uuid "af573cc2-d740-58f5-a9b3-14514a40675a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/de/de3ea7300a64b5cb83b6c06a07ed673a29a025123fc955283e13bcdcff8c0a84.png" :db/id #edb/ref 17592186571842} {:answer/id #uuid "c7a268df-28db-5d13-ab80-d2d03b65eb80" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/44/44c890a2ab9f5c3ed67deecee95c76bc663010e3331da48c14d9504c242aeb2a.png" :db/id #edb/ref 17592186571894}] :answer-field/correct {:db/id #edb/ref 17592186571842} :answer-field/id #uuid "c506eaa0-7955-591f-814f-18652414f794" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572076}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e294440f-b12e-5095-aeac-cd3f942d43e6" :question/math-academy-id "q-69856" :question/problem "![](images/32/3247a3ba0e4434860318ef697e29f7d377cfb0eb08135bb5d3e147516b2a5505.png)\n\nConsider the vector $\\overset{\\to }{CD},$ shown above. Which of the following could be $\\overset{\\to }{CD}+\\overset{\\to }{DC}?$" :question/worked-solution "According to the triangle law of addition, the resultant is the vector that goes from the tail of $\\overset{\\to }{CD}$ to the head of $\\overset{\\to }{DC}.$ Therefore, we obtain a new vector for which the tail and head is the same point, the tail of $\\overset{\\to }{CD}.$ \n\nThat vector is called the zero vector, and we write\n\n$$\n\\overset{\\to }{CD}+\\overset{\\to }{DC}=0.\n$$\n\nThe corresponding graph is shown below.\n\n![](images/8e/8e51db7c2e9eff46679a185b82a477d65842d43d1dd71289f3e6bab1a7a503de.png)"} :step/id #uuid "28439026-9df7-5022-8efd-98cccd4a8a55"} {:db/id #edb/ref 17592186572261 :step/content {:db/id #edb/ref 17592186097335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2e99f4a-91f0-5666-986c-d96a19fd2379" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/eb/eb42f18a8d83b77a18b8e796c55cb834b4288bebfd028bd89bfe58bda39252af.png" :db/id #edb/ref 17592186095935} {:answer/id #uuid "a610a33f-18cd-5e82-8634-239c2bde6252" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/24/24cf5282bb402e4c3a3320fdfbf37e6c866692e8c646d558738c289a999d3a36.png" :db/id #edb/ref 17592186095936} {:answer/id #uuid "dee44144-6f77-53e4-9c87-f3521ff5b169" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a9/a91fc49b59add56f76c2eab2def379db811cc7787ee3f809e0cb3f7c70d838df.png" :db/id #edb/ref 17592186095937} {:answer/id #uuid "696c6af9-a8b4-5aee-9b9c-615b7c7c0075" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a8/a85b7f11192f871932665f91542787d8857dcdc22f98771a8df0f4c713058e17.png" :db/id #edb/ref 17592186095938} {:answer/id #uuid "71c2fdc3-b767-5c37-8a7c-a0da3a6be94e" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/de/de4539966254b47c26b16233b26d32ad14453c296fb2692ab4bc147620c46174.png" :db/id #edb/ref 17592186095939}] :answer-field/id #uuid "65c0f080-99fe-57f2-a719-d49f2825bb86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186095934}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "91930512-85f3-5da9-9a83-797480e4b3d5" :question/math-academy-id "q-69448" :question/problem "![](images/44/44612517750f797998e4d7ec8d535cd2149c04e756255b3edf90f7a756463420.png)\n\nConsider the diagram shown above. Which of the following could be $-a$?"} :step/id #uuid "aacc10c9-f5e2-59c8-9018-6674e86ff34b" :step/next {:db/id #edb/ref 17592186572278}} {:db/id #edb/ref 17592186572278 :step/content {:db/id #edb/ref 17592186572157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d17fb1-db0e-56fc-9024-2583fa21dae5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f7/f7e357b3b9b74f27dc253bf611729dd188b632df511ba1f10c33e4bde313d8ec.png" :db/id #edb/ref 17592186571541} {:answer/id #uuid "2cadde5b-64c5-5e69-87ce-17b7c4c4079d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/26/26bd490f6fbd3d3d9dab6a9653ed4e8043b5d266eeddd13255a30a6c2d10da0a.png" :db/id #edb/ref 17592186571614} {:answer/id #uuid "3be231ec-2961-59f0-9c62-a8218e52a1f6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/23/238fe7bdb6d394bed88fd0442050da14977f0391e7650ef36d7a94e998446106.png" :db/id #edb/ref 17592186571648} {:answer/id #uuid "e103853e-2bf0-5610-8cac-ea008ed6f26f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/10/107791ab54cddf8f42b83c349d450d961f4334757f5a525e707f25382529ee02.png" :db/id #edb/ref 17592186571942} {:answer/id #uuid "ee7107e0-b805-55a6-95df-0517737a0181" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/56/56e29d1e52f2c84cf6581f9b46d4b5216f53a9c44d15b2c0c1b21d2d1f57b0b3.png" :db/id #edb/ref 17592186571957}] :answer-field/correct {:db/id #edb/ref 17592186571648} :answer-field/id #uuid "b9df1b13-c754-54c2-9e96-913d5093b7bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186572072}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9756da76-54ed-58bb-84a5-fe67fc16acc7" :question/math-academy-id "q-69508" :question/problem "![](images/b6/b6200095c8fc6c8267fcb1511fcb1ffee896c23ece3a899b76bf3a8701e65440.png)\n\nThe diagram shows the vectors $a$ and $b.$  Which of the following diagrams illustrates the vector subtraction $a-b.$" :question/worked-solution "We interpret the subtraction\n$a-b$\nas the addition\n\n$$\na+(-b),\n$$\n\nwhere $-b$ is the vector that has the same magnitude as $b$ but goes in the direction *opposite* of $b.$\n\nFinally, we use the triangle law to add the vectors $a$ and $-b:$ \n\n- We can start $a$ from an arbitrary point on the plane.\n\n- Next, we draw the vector that is equal to $-b$ and has its tail placed at the head of $a.$\n\n- Now, according to the triangle law of addition, the resultant is the vector that goes from the tail of $\\text{a}$ to the head of $-\\text{b}$, as shown below.\n\n![](images/6f/6fe262898a31d393dc0e1046fbbcbb0a1c9d7c3fb00aed0a982bff5029fcd2a1.png)"} :step/id #uuid "f75a3ecc-4d92-58be-9d26-61d0b71eab9f" :step/next {:db/id #edb/ref 17592186572215}}] :activity/title "The Triangle Law for the Addition of Two Vectors" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186571527}] [{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186101886} :activity/id #uuid "34fe6449-9169-5201-a668-37f6ba507f27" :activity/scope {:db/id #edb/ref 17592186049716 :topic/id #uuid "0da24e9b-3685-5d19-9e02-0c5f09170003" :topic/math-academy-id 1240} :activity/steps [{:db/id #edb/ref 17592186101886 :step/content {:db/id #edb/ref 17592186102020 :tutorial/content "The **slope-intercept** form of the equation of a line is\n\n$$\ny = {\\color{red}{m}}x+{\\color{blue}{b}},\n$$\n\nwhere ${\\color{red}{m}}$ is the **slope** of the line and ${\\color{blue}{b}}$ is the **$y$-intercept.**\n\nTo illustrate, consider the line $y={\\color{red}{2}}x+{\\color{blue}{1}},$ shown below.\n\n![](images/a4/a4c1f53335d7637a0b08f51e93e760d533986e53a4c8896712262688b156bc70.png)\n\nLooking at the line, we notice that:\n\n- The *slope* of the line is $m={\\color{red}{2}},$ because a change of $1$ in the $x$-direction results in a change of $2$ in the $y$-direction.\n\n- The $y$*-intercept* of the line, denoted $b$, is $b={\\color{blue}{1}},$ because the line hits the $y$-axis at the point $(0,{\\color{blue}{1}}).$\n\n**Note**: The coordinates of the $y$-intercept are always $(0,{\\color{blue}{b}}).$\n\nFinally, if the slope $m = 0$ (i.e., we have a horizontal line), the slope-intercept form must be $y=0x+{\\color{blue}b},$ which reduces to $y={\\color{blue}b}.$" :tutorial/id #uuid "7ef443ae-c1bd-551c-9f3b-11a386a427b0" :tutorial/math-academy-id 8049 :tutorial/title "Introduction"} :step/id #uuid "71040723-790d-5f3d-a1dd-222683f75e94" :step/math-academy-id 513896 :step/next {:db/id #edb/ref 17592186101887}} {:db/id #edb/ref 17592186101887 :step/content {:db/id #edb/ref 17592186101007 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100593 :question/id #uuid "95fc8e7d-776c-5d09-9140-a83dc575ac79" :question/math-academy-id "e-12851"} :knowledge-point/id #uuid "0e3833c1-4ec5-5681-ae69-6a9cceece871" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061} {:db/id #edb/ref 17592186050790}] :knowledge-point/questions [{:db/id #edb/ref 17592186101240} {:db/id #edb/ref 17592186101417} {:db/id #edb/ref 17592186101418} {:db/id #edb/ref 17592186491202} {:db/id #edb/ref 17592186492049} {:db/id #edb/ref 17592186492062}] :knowledge-point/title "Identifying the Slope and Y-Intercept From the Equation of a Line"} :step/id #uuid "7d80ece7-1566-52e3-8606-fb2e7978cd91" :step/math-academy-id 513897 :step/next {:db/id #edb/ref 17592186101888}} {:db/id #edb/ref 17592186101888 :step/content {:db/id #edb/ref 17592186101008 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100594 :question/id #uuid "36e13cef-f61a-53e2-8f0e-9ff567dc6fb6" :question/math-academy-id "e-12852"} :knowledge-point/id #uuid "d8e10b2d-cad1-5d50-b9fc-917c3367f814" :knowledge-point/questions [{:db/id #edb/ref 17592186101258} {:db/id #edb/ref 17592186101322} {:db/id #edb/ref 17592186101323} {:db/id #edb/ref 17592186491145} {:db/id #edb/ref 17592186491158} {:db/id #edb/ref 17592186491177} {:db/id #edb/ref 17592186491181} {:db/id #edb/ref 17592186492021} {:db/id #edb/ref 17592186492058} {:db/id #edb/ref 17592186503692} {:db/id #edb/ref 17592186573278}] :knowledge-point/title "Finding the Equation of a Graphed Line (Positive Slope)"} :step/id #uuid "dee1b67c-6094-5585-b4f9-0533338692f3" :step/math-academy-id 513901 :step/next {:db/id #edb/ref 17592186101889}} {:db/id #edb/ref 17592186101889 :step/content {:db/id #edb/ref 17592186101009 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100617 :question/id #uuid "206b8f86-4184-50fa-9999-08700d10dc4f" :question/math-academy-id "e-20867"} :knowledge-point/id #uuid "8ac060cb-0c76-5050-9156-e5f17ad26fbb" :knowledge-point/questions [{:db/id #edb/ref 17592186101324} {:db/id #edb/ref 17592186101521} {:db/id #edb/ref 17592186491119} {:db/id #edb/ref 17592186491180} {:db/id #edb/ref 17592186491985} {:db/id #edb/ref 17592186492068} {:db/id #edb/ref 17592186502153}] :knowledge-point/title "Finding the Equation of a Graphed Line (Negative Slope)"} :step/id #uuid "8b22ef4e-6fe4-51ed-9583-f159a5fcfe83" :step/math-academy-id 513905 :step/next {:db/id #edb/ref 17592186101890}} {:db/id #edb/ref 17592186101890 :step/content {:db/id #edb/ref 17592186101010 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100595 :question/id #uuid "8351e1cb-c602-5968-be5a-9c337ad977de" :question/math-academy-id "e-12853"} :knowledge-point/id #uuid "4762cb71-f6b6-5d32-8d0b-a457db66ff97" :knowledge-point/questions [{:db/id #edb/ref 17592186101260} {:db/id #edb/ref 17592186101522} {:db/id #edb/ref 17592186101523} {:db/id #edb/ref 17592186491162} {:db/id #edb/ref 17592186491168} {:db/id #edb/ref 17592186491207} {:db/id #edb/ref 17592186492065} {:db/id #edb/ref 17592186502126}] :knowledge-point/title "Finding the Equation of a Line That Passes Through Two Points: Y-Intercept Given"} :step/id #uuid "40e1749c-89f2-55ea-8c70-78f7ab83e917" :step/math-academy-id 513908}] :activity/title "Equations of Lines in Slope-Intercept Form" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101084}] [{:activity/course {:db/id #edb/ref 17592186046648} :activity/first-step {:db/id #edb/ref 17592186502166} :activity/id #uuid "1f1e2e98-3f29-5a8d-b619-48f3bdf693dc" :activity/scope {:db/id #edb/ref 17592186049716 :topic/id #uuid "0da24e9b-3685-5d19-9e02-0c5f09170003" :topic/math-academy-id 1240} :activity/steps [{:db/id #edb/ref 17592186502166 :step/content {:db/id #edb/ref 17592186502153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b074387-ea1b-58a9-8455-29e4ebdf026b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-3x+\\frac{3}{2}" :db/id #edb/ref 17592186501602} {:answer/id #uuid "540d2aca-caaa-5a05-b71c-086789c0ec35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{3}{2}x" :db/id #edb/ref 17592186501621} {:answer/id #uuid "a68bbf07-cefa-5dff-9f31-335abf2135e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-x+3" :db/id #edb/ref 17592186501789} {:answer/id #uuid "d4d94deb-f953-5c29-852d-1230348acbe6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-3x+3" :db/id #edb/ref 17592186501889} {:answer/id #uuid "d5c65083-63b9-5502-80e5-5b8c67db5cc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{3}{2}x+3" :db/id #edb/ref 17592186501891}] :answer-field/correct {:db/id #edb/ref 17592186501891} :answer-field/id #uuid "98f6c907-31fa-5398-b9b9-cd18dddbc8ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186502029}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d734e86c-2f4c-5a69-bdfa-2077440bd884" :question/math-academy-id "q-44192" :question/problem "![](images/db/dbf33e6d3a9e1efb4d0217f9076b0eb1381ea7d7fa9efa7ef7759b1c0e20175c.png)\n\nThe line shown above passes through the points $(0,3)$ and $(2,0).$ What is the equation of the line?" :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFrom the graph, we see that the line intercepts the $y$-axis at $(0,3).$ So, the $y$-intercept is $b=3.$\n\nWe can calculate the slope of the line by choosing two points on the line and applying the slope formula. The line passes through the points $(0,3)$ and $(2,0),$ so we calculate its slope as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{0-3}{2-0} \\\\  & =\\frac{-3}{2} \\\\  & =-\\frac{3}{2}\\end{aligned}\n$$\n\nSubstituting the slope $m=-\\frac{3}{2}$ and the $y$-intercept $b=3$ into the slope-intercept form $y=mx+b,$ we obtain the equation of the line:\n\n$$\ny=-\\frac{3}{2}x+3\n$$"} :step/id #uuid "07cd0f42-e686-5aa2-b3b0-7e07e394a2c4" :step/next {:db/id #edb/ref 17592186502167}} {:db/id #edb/ref 17592186502167 :step/content {:db/id #edb/ref 17592186101258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155d28bd-5a1b-53d1-a062-ce10c04fe049" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}x+1" :db/id #edb/ref 17592186501508}] :answer-field/correct {:db/id #edb/ref 17592186501508} :answer-field/id #uuid "f1f3cddf-9336-5732-ad3e-9ab0c3ba2047" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186098879}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "78b15dc1-cbef-5898-ab15-04cac6cf3f71" :question/math-academy-id "q-178577" :question/problem "![](images/05/051c906be77d7e12a778449883a630c3b24f92b84ae7dac3d93b1787824f9c0c.png)\n\nConsider the line shown above, which has a slope of $\\frac{2}{3}.$ The equation of the line is $y=${{field-1}}." :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ We know that the slope is $m=\\frac{2}{3},$ so we just need to work out $y$-intercept $b.$\n\nFrom the graph, we see that the line passes through the point $(3,3).$ Substituting this into $y=mx+b$ with $m=\\frac{2}{3}$ and solving for $b,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{2}{3}x+b \\\\ 3 & =\\frac{2}{3}(3)+b \\\\ 3 & =2+b \\\\ b & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the line is $y=\\frac{2}{3}x+1.$"} :step/id #uuid "0c73f501-a6b3-5d8e-af7b-d2238fefcc83" :step/next {:db/id #edb/ref 17592186502214}} {:db/id #edb/ref 17592186502214 :step/content {:db/id #edb/ref 17592186502126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c85bc99-52ec-513c-89c2-e3beaf6434b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}x+2" :db/id #edb/ref 17592186501489}] :answer-field/correct {:db/id #edb/ref 17592186501489} :answer-field/id #uuid "55a4f4df-f97d-5fe3-9f2f-2745efb5c93c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186502004}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9340bec6-b3d6-57e0-89a1-d4e7fb7357f7" :question/math-academy-id "q-179508" :question/problem "Written in the form $y=mx+b,$ what is the equation of the line that passes through the points $(6,-2)$ and $(0,2)?$\n\nThe equation of the line is $y=$\n{{field-1}}." :question/worked-solution "We will write the equation of the line in the slope-intercept form $y=mx+b.$ So, we need to work out the slope $m$ and the $y$-intercept $b.$\n\nFirst, we calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{2-(-2)}{0-6} \\\\  & =\\frac{2+2}{0-6} \\\\  & =\\frac{4}{-6} \\\\  & =-\\frac{2}{3}\\end{aligned}\n$$\n\nThe coordinates of the $y$-intercept are always $(0,b).$ We know that the line passes through the point $(0,2),$ so the $y$-intercept is $b=2.$  \n\nSubstituting the slope $m=-\\frac{2}{3}$ and the $y$-intercept $b=2$ into the slope-intercept formula $y=mx+b,$ we reach\n\n$$\ny=-\\frac{2}{3}x+2.\n$$"} :step/id #uuid "febf91cb-77cd-5e1e-bba8-c5ccf63dd284"}] :activity/title "Equations of Lines in Slope-Intercept Form" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186501452}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186189032} :activity/id #uuid "991198d2-0d13-559b-aa50-a822d61cae0c" :activity/scope {:db/id #edb/ref 17592186050282 :topic/id #uuid "3c94ddf9-ba20-52cc-bd59-5aeaadb59184" :topic/math-academy-id 3868} :activity/steps [{:db/id #edb/ref 17592186189032 :step/content {:db/id #edb/ref 17592186189493 :tutorial/content "We can manipulate units the same way as variables, which often provides a convenient way to solve problems. One type of problem where units can help is converting between different units of measurement. \n\nFor example, let's use units to convert $0.03\\,\\textrm{kg}$ into grams. We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\textrm{kg}$ | $1\\,\\textrm{kg} = 1\\,000\\,\\textrm{g}$ |\n| Gram | $\\textrm{g}$ | Base Unit |\n| Milligram | $\\textrm{mg}$ | $1\\,000\\,\\textrm{mg} = 1\\,\\textrm{g}$ |\n\nSince we're converting from kilograms to grams, we need a conversion between these two units. According to our table, there are $1000\\,\\textrm g$ per $\\textrm{kg}.$ We can write this ratio as a fraction, as follows:\n\n$$\n\\dfrac{1000\\,\\textrm g}{\\textrm{kg}}\n$$\n\nThis is our **conversion factor.** It's important to write the conversion factor with the units included.\n\nTo convert $0.03 \\,\\textrm{kg}$ to grams, we multiply this quantity by our conversion factor as follows:\n\n$$\n\\begin{aligned}0.03\\,\\text{kg} & =0.03\\,\\text{kg}\\cdot \\frac{1\\,000\\,\\text{g}}{\\text{kg}}\\end{aligned}\n$$\n\nNotice that the kilogram units $(\\textrm{kg})$ cancel, leaving only gram units $(\\textrm{g}).$ Consequently, our expression can be simplified as follows:\n\n$$\n\\begin{aligned}0.03\\,\\text{kg} & =0.03\\,\\text{kg}\\cdot \\frac{1\\,000\\,\\text{g}}{\\text{kg}} \\\\  & =0.03\\,\\cancel{\\text{kg}}\\cdot \\frac{1\\,000\\,\\text{g}}{\\cancel{\\text{kg}}} \\\\  & =0.03\\cdot 1\\,000\\,\\text{g} \\\\  & =30\\,\\text{g}\\end{aligned}\n$$\n\nTherefore, $0.03 \\,\\textrm{kg}$ is equivalent to $30 \\,\\text{g}.$\n\nNote the following:\n\n- When multiplying by the conversion factor, the units we want to remove should *always* cancel, and the units we wish to keep should *always* remain. If this isn't the case, we've made a mistake somewhere.\n\n- We can think of the conversion factor as equivalent to the number $1,$ and multiplying a quantity by $1$ doesn't change it. Therefore, multiplying $0.03\\,\\textrm{kg}$ by the conversion factor doesn't change the *size* of the quantity, though it does change the units.\n\nFinally, notice that, in this example, we've converted from a \"larger\" unit of mass $(\\textrm{kg})$ to a smaller one $(\\textrm{g}).$ We'll see how to use units to convert from smaller units of mass to larger units later in this lesson." :tutorial/id #uuid "a61c3c5b-cabe-50e6-bd8c-c451fc7f7329" :tutorial/math-academy-id 8735 :tutorial/title "Introduction"} :step/id #uuid "a5a6a7de-dd8f-533d-8cb9-defc2774fef3" :step/math-academy-id 142504 :step/next {:db/id #edb/ref 17592186189033}} {:db/id #edb/ref 17592186189033 :step/content {:db/id #edb/ref 17592186188243 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188179 :question/id #uuid "a8a6ddf1-4401-5f68-9eba-e6d1162d33eb" :question/math-academy-id "e-14051"} :knowledge-point/id #uuid "12bd9bab-79dd-577e-907e-5f537b3b5eac" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049747} {:db/id #edb/ref 17592186050702} {:db/id #edb/ref 17592186050843}] :knowledge-point/questions [{:db/id #edb/ref 17592186188886} {:db/id #edb/ref 17592186188958} {:db/id #edb/ref 17592186510366} {:db/id #edb/ref 17592186510403}] :knowledge-point/title "Converting From Kilograms to Grams"} :step/id #uuid "3b9c48be-9be5-5ad9-8524-1db31336c531" :step/math-academy-id 142505 :step/next {:db/id #edb/ref 17592186189034}} {:db/id #edb/ref 17592186189034 :step/content {:db/id #edb/ref 17592186188244 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188180 :question/id #uuid "f565f22a-58de-5553-b618-d55f088be079" :question/math-academy-id "e-14052"} :knowledge-point/id #uuid "278e33dd-6216-5cf9-9e52-e20924e0622b" :knowledge-point/questions [{:db/id #edb/ref 17592186188887} {:db/id #edb/ref 17592186188921} {:db/id #edb/ref 17592186510405} {:db/id #edb/ref 17592186510407} {:db/id #edb/ref 17592186573324}] :knowledge-point/title "Converting From Grams to Milligrams"} :step/id #uuid "d06d61a6-e2a7-5788-ac3a-dc0591173d8d" :step/math-academy-id 142509 :step/next {:db/id #edb/ref 17592186189035}} {:db/id #edb/ref 17592186189035 :step/content {:db/id #edb/ref 17592186189495 :tutorial/content "We've seen how to use units to convert from larger units of mass to smaller ones. Let's now learn how to convert from smaller units to larger ones.\n\nFor example, suppose we want to convert $600\\,\\textrm{mg}$ to grams. We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\textrm{kg}$ | $1\\,\\textrm{kg} = 1\\,000\\,\\textrm{g}$ |\n| Gram | $\\textrm{g}$ | Base Unit |\n| Milligram | $\\textrm{mg}$ | $1\\,000\\,\\textrm{mg} = 1\\,\\textrm{g}$ |\n\nThere are $1000\\,\\textrm {mg}$ per $\\textrm{g},$ which we can write as follows:\n\n$$\n\\dfrac{1000\\,\\textrm{mg}}{\\textrm{g}}\n$$\n\nHowever, since we're converting from a smaller unit of mass $(\\textrm{mg})$ to a larger one $(\\textrm{g}),$ we construct our conversion factor by taking the *reciprocal* of the above:\n\n$$\n\\dfrac{\\textrm{g}}{1000\\,\\textrm{mg}}\n$$\n\nNow, multiplying $600 \\,\\textrm{mg}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}600\\,\\text{mg} & =600\\,\\text{mg}\\cdot \\frac{\\text{g}}{1\\,000\\,\\text{mg}} \\\\  & =600\\,\\cancel{\\text{mg}}\\cdot \\frac{\\text{g}}{1\\,000\\,\\cancel{\\text{mg}}} \\\\  & =600\\cdot \\frac{\\text{g}}{1\\,000} \\\\  & =\\frac{600}{1000}\\,\\text{g} \\\\  & =0.6\\,\\text{g}\\end{aligned}\n$$\n\nTherefore, $600 \\,\\textrm{mg}$ is equivalent to $0.6\\,\\text{g}.$\n\nNote the following: \n\n- When we say that grams are a \"larger unit of mass\" than milligrams, this simply means that $1\\,\\textrm g$ is a larger mass than $1\\,\\textrm{mg}.$\n\n- If you forget to take the reciprocal to find the conversion factor, the units will not cancel when you multiply. This indicates that a mistake has occurred. In such cases, it's best to double-check that you're using the correct conversion factor." :tutorial/id #uuid "295b5ac0-e435-50fd-9493-4e753d8c31bb" :tutorial/math-academy-id 8739 :tutorial/title "Using Reciprocals to Convert From Smaller Units to Larger Units"} :step/id #uuid "a44cd1ff-e34d-5106-a89c-28301fc8fca6" :step/math-academy-id 142513 :step/next {:db/id #edb/ref 17592186189036}} {:db/id #edb/ref 17592186189036 :step/content {:db/id #edb/ref 17592186188245 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188182 :question/id #uuid "8e2f9e3e-e0b3-53d5-88e6-38cbcb37af59" :question/math-academy-id "e-14057"} :knowledge-point/id #uuid "0018c984-790b-57d0-b086-77f5bdf8f273" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049142} {:db/id #edb/ref 17592186050749}] :knowledge-point/questions [{:db/id #edb/ref 17592186188876} {:db/id #edb/ref 17592186188877} {:db/id #edb/ref 17592186510448}] :knowledge-point/title "Converting From Smaller Units to Larger Units"} :step/id #uuid "2178685b-38fc-5e05-805e-7615b35b6f75" :step/math-academy-id 142514}] :activity/title "Unit Conversions Using Base Units of Mass" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186188462}] [{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186139556} :activity/id #uuid "522ceb8a-6a60-5c1f-99d9-c6421e013ec3" :activity/scope {:db/id #edb/ref 17592186050505 :topic/id #uuid "4ed6acfb-fbd7-5e57-abcc-691c74600c49" :topic/math-academy-id 2278} :activity/steps [{:db/id #edb/ref 17592186139556 :step/content {:db/id #edb/ref 17592186139635 :tutorial/content "Let's look at the three points $A,$ $B,$ and $C$ below. \n\n![](images/95/956f9b2c979f06897b09119b089ced903e095d72136e64b9ea52e946fba41544.png)\n\nAs indicated in the diagram, the distances between the points are\n\n$$\n\\begin{aligned}AB=4\\,cm,\\,BC=2\\,cm,\\,AC=6\\,cm.\\end{aligned}\n$$\n\nCan we be sure that the points are collinear? To answer this, we use the **segment addition postulate**.\n\nThe postulate states the following: \n\n*Three points are collinear if and only if the largest distance between two of them is equal to the sum of the other two distances.*\n\nHere, the largest distance is $AC,$ so the points $A,$ $B,$ and $C$ are collinear *if and only if*\n\n$$\nAC=AB + BC.\n$$\n\nSubstituting the given information $AC=6\\,\\mathrm{cm},$ $AB=4\\,\\mathrm{cm},$ and $BC=2\\,\\mathrm{cm}$ we get\n\n$$\n\\begin{aligned}AC & =AB+BC \\\\ 6 & =4+2 \\\\ 6 & =6.\\,✓\\end{aligned}\n$$\n\nThis is a true statement, so the three points $A,$ $B,$ and $C$ are indeed collinear.\n\n**Note:** The postulate works in both directions:\n\n- If the points $A,$ $B,$ and $C$ are collinear then $AC= AB + BC.$\n\n- If $AC= AB + BC$ then the points $A,$ $B,$ and $C$ are collinear." :tutorial/id #uuid "0a460529-da55-5fcc-a207-e4ae6a47f12d" :tutorial/math-academy-id 2168 :tutorial/title "Introduction"} :step/id #uuid "11ec6bb7-b9b3-51ea-b1b2-5f6a0a7b75b9" :step/math-academy-id 8720 :step/next {:db/id #edb/ref 17592186139557}} {:db/id #edb/ref 17592186139557 :step/content {:db/id #edb/ref 17592186139636 :tutorial/content "Given two of the three distances between three collinear points, we can calculate the third distance using the segment addition postulate. \n\nTo demonstrate, consider the collinear points $A,$ $B,$ and $C$ below.\n\n![](images/3b/3b1bc383e8d570f9dc33346e6f4ae04377e3c5c4c0d0e53abe07b0aacd9bb3e6.png)\n\nWe are given two of the distances:\n\n$$\n\\begin{aligned}AB=3\\,cm,\\,AC=5\\,cm\\end{aligned}\n$$\n\nWe can calculate the third distance, $BC,$ using the segment addition postulate.\n\nFirst, we state the equation and substitute the known quantities $AB=3$ and $AC=5,$ as follows:\n\n$$\n\\begin{aligned}AC & =AB+BC \\\\ 5 & =3+BC\\end{aligned}\n$$\n\nNow, we can solve for $BC$ by subtracting $3$ from both sides of the equation:\n\n$$\n\\begin{aligned}5 & =3+BC \\\\ BC & =2\\end{aligned}\n$$\n\nTherefore, the distance between the points $B$ and $C$ is $2\\,\\textrm{cm}.$" :tutorial/id #uuid "92286c39-6af9-5ff0-b2e9-fa44fec8f732" :tutorial/math-academy-id 2169 :tutorial/title "Calculating the Distance Between Collinear Points"} :step/id #uuid "fa4d60ee-75e2-54e2-b7eb-e1946cf89388" :step/math-academy-id 8722 :step/next {:db/id #edb/ref 17592186139558}} {:db/id #edb/ref 17592186139558 :step/content {:db/id #edb/ref 17592186138558 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138282 :question/id #uuid "5b1ee9ef-da39-5f7a-abb5-98149a765b1f" :question/math-academy-id "e-2565"} :knowledge-point/id #uuid "3108f0ab-17b1-5241-93d1-97658cf22601" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725} {:db/id #edb/ref 17592186050563}] :knowledge-point/questions [{:db/id #edb/ref 17592186138768} {:db/id #edb/ref 17592186138769} {:db/id #edb/ref 17592186496230} {:db/id #edb/ref 17592186496315}] :knowledge-point/title "Calculating the Distance Between Three Collinear Points"} :step/id #uuid "ab8e5676-8695-5fd6-8d78-6bae4eba68f9" :step/math-academy-id 8723 :step/next {:db/id #edb/ref 17592186139559}} {:db/id #edb/ref 17592186139559 :step/content {:db/id #edb/ref 17592186138559 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138283 :question/id #uuid "cabd7daa-4f22-56ca-8b26-0791857e8eae" :question/math-academy-id "e-2566"} :knowledge-point/id #uuid "d7679cf4-427a-59ed-8b0f-d483af20ede8" :knowledge-point/questions [{:db/id #edb/ref 17592186138831} {:db/id #edb/ref 17592186138832} {:db/id #edb/ref 17592186496266} {:db/id #edb/ref 17592186496283}] :knowledge-point/title "Calculating the Distance Between More Than Three Collinear Points"} :step/id #uuid "df7668d0-a581-5a0f-a689-b2079711a0d2" :step/math-academy-id 8724 :step/next {:db/id #edb/ref 17592186139560}} {:db/id #edb/ref 17592186139560 :step/content {:db/id #edb/ref 17592186138560 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138284 :question/id #uuid "6df54266-d6d6-54f0-8b61-4b5eabf0fcbc" :question/math-aca