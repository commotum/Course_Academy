#{[{:activity/first-step {:db/id #edb/ref 17592186139340} :activity/id #uuid "0f1320ae-5783-5e37-b1a5-3098937007e1" :activity/scope {:db/id #edb/ref 17592186049943 :topic/id #uuid "202bf905-577e-51ee-b1b6-25f29f3d77aa" :topic/math-academy-id 2275} :activity/steps [{:db/id #edb/ref 17592186139340 :step/content {:db/id #edb/ref 17592186139725 :tutorial/content "The **difference of squares formula** states the product of the sum and the difference of two monomials is equal to the difference of their squares:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nWe can check that this result is correct by expanding the binomial in the usual way, as follows:\n\n$$\n\\begin{aligned} ({\\color{blue}a} + {\\color{red}b})(a - b) \\\\[5pt] &= {\\color{blue}a}(a - b) + {\\color{red}b}(a - b) \\\\[5pt] &= a^2 - ab + ab - b^2 \\\\[5pt] &= a^2 - b^2 \\,& {\\color{green}{\\checkmark}} \\end{aligned}\n$$\n\nNotice that the middle two terms $-ab$ and $ab$ cancel each other out, leaving only $a^2 - b^2$.\n\nIf the order of multiplication is switched, the formula still remains the same:\n\n$$\n(a - b)(a + b) = a^2 - b^2\n$$" :tutorial/id #uuid "5aaa853f-8b04-5d91-8c05-f30646908746" :tutorial/math-academy-id 8883 :tutorial/title "Introduction"} :step/id #uuid "3d09b7a5-02a2-5bb1-ab6c-97fd9a0d593c" :step/math-academy-id 193358 :step/next {:db/id #edb/ref 17592186139341}} {:db/id #edb/ref 17592186139341 :step/content {:db/id #edb/ref 17592186138420 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138186 :question/id #uuid "6d8e25fc-b9a0-5cd1-9a33-3e7c6d34d2c9" :question/math-academy-id "e-14323"} :knowledge-point/id #uuid "08fda5c2-ae08-54fe-8271-b2f4c1f92eb1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049861} {:db/id #edb/ref 17592186050818}] :knowledge-point/questions [{:db/id #edb/ref 17592186138749} {:db/id #edb/ref 17592186138773}] :knowledge-point/title "Finding a Product Using the Difference of Squares Formula"} :step/id #uuid "6a8787b7-2b51-553a-a6d3-45dbce73fd6d" :step/math-academy-id 193359 :step/next {:db/id #edb/ref 17592186139342}} {:db/id #edb/ref 17592186139342 :step/content {:db/id #edb/ref 17592186138421 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138187 :question/id #uuid "092e54fe-57ef-5243-a7a1-5ac10d3a0dca" :question/math-academy-id "e-14326"} :knowledge-point/id #uuid "86c57e03-cecd-5cc3-9158-b7b5caaf2530" :knowledge-point/questions [{:db/id #edb/ref 17592186138761} {:db/id #edb/ref 17592186138775}] :knowledge-point/title "Finding the Product of Two Binomials With Leading Coefficients"} :step/id #uuid "b9ad9381-9b48-5b5b-b8f0-6beb54354def" :step/math-academy-id 193363 :step/next {:db/id #edb/ref 17592186139343}} {:db/id #edb/ref 17592186139343 :step/content {:db/id #edb/ref 17592186138422 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138188 :question/id #uuid "fc349f72-6389-5a1d-b56f-69afe3af3d41" :question/math-academy-id "e-14329"} :knowledge-point/id #uuid "3329cd2b-b1f7-59ca-9a4e-cbb30aadbbf3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050697}] :knowledge-point/questions [{:db/id #edb/ref 17592186138808} {:db/id #edb/ref 17592186139151} {:db/id #edb/ref 17592186234126}] :knowledge-point/title "Finding the Product of Two Nonlinear Binomials"} :step/id #uuid "e3178dc6-d3e2-5d72-8f0b-b70219a656cd" :step/math-academy-id 193367 :step/next {:db/id #edb/ref 17592186139344}} {:db/id #edb/ref 17592186139344 :step/content {:db/id #edb/ref 17592186138423 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138189 :question/id #uuid "eeb682a3-2246-55f7-b99c-f60c589a0587" :question/math-academy-id "e-14337"} :knowledge-point/id #uuid "dc7f5072-ef21-5abb-9889-13ab8814af9a" :knowledge-point/questions [{:db/id #edb/ref 17592186138992} {:db/id #edb/ref 17592186139152}] :knowledge-point/title "Finding the Product of Two Binomials Containing General Exponents"} :step/id #uuid "89a98a58-be61-5132-9c41-09105a97def2" :step/math-academy-id 193370}] :activity/title "The Differ