#{[{:db/id #edb/ref 17592186138186 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138420 :knowledge-point/id #uuid "08fda5c2-ae08-54fe-8271-b2f4c1f92eb1" :knowledge-point/title "Finding a Product Using the Difference of Squares Formula"}] :question/id #uuid "6d8e25fc-b9a0-5cd1-9a33-3e7c6d34d2c9" :question/math-academy-id "e-14323" :question/problem "Expand $(x + 3)(x - 3)$." :question/worked-solution "We will use the difference of square formula:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nSubstituting $a=x$ and $b=3$, we have\n\n$$\n\\begin{aligned} (x + 3)(x - 3) \\\\[5pt] &= x^2 - 3^2 \\\\[5pt] &= x^2 - 9. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186138187 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138421 :knowledge-point/id #uuid "86c57e03-cecd-5cc3-9158-b7b5caaf2530" :knowledge-point/title "Finding the Product of Two Binomials With Leading Coefficients"}] :question/id #uuid "092e54fe-57ef-5243-a7a1-5ac10d3a0dca" :question/math-academy-id "e-14326" :question/problem "Expand $(5x - 4)(5x + 4)$." :question/worked-solution "We will use the difference of square formula:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nSubstituting $a=5x$ and $b=4$, we have\n\n$$\n\\begin{aligned} (5x - 4)(5x + 4) \\\\[5pt] &= (5x)^2 - (4)^2 \\\\[5pt] &= 25x^2 - 16. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186138188 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138422 :knowledge-point/id #uuid "3329cd2b-b1f7-59ca-9a4e-cbb30aadbbf3" :knowledge-point/title "Finding the Product of Two Nonlinear Binomials"}] :question/id #uuid "fc349f72-6389-5a1d-b56f-69afe3af3d41" :question/math-academy-id "e-14329" :question/problem "Expand $(6x + y^2)(6x - y^2)$." :question/worked-solution "We will use the difference of square formula:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nSubstituting $a=6x$ and $b=y^2$, we have\n\n$$\n\\begin{aligned} (6x + y^2)(6x - y^2) \\\\[5pt] &= (6x)^2 - \\left(y^2\\right)^2 \\\\[5pt] &= 36x^2 - y^4. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186138189 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138423 :knowledge-point/id #uuid "dc7f5072-ef21-5abb-9889-13ab8814af9a" :knowledge-point/title "Finding the Product of Two Binomials Containing General Exponents"}] :question/id #uuid "eeb682a3-2246-55f7-b99c-f60c589a0587" :question/math-academy-id "e-14337" :question/problem "Expand $(2x^n-1)(2x^n+1)$." :question/worked-solution "We will use the difference of square formula:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nSubstituting $a=2x^n$ and $b=1$, we have\n\n$$\n\\begin{aligned}\n(2x^{n} - 1)(2x^{n} + 1) &=  \\\\\n(2x^{n})^{2} - (1)^{2} &=  \\\\\n2^{2} \\cdot (x^{n})^{2} - 1 &=  \\\\\n&= 4x^{2n} - 1\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186139151 :knowledge-point/_questions [{:db/id #edb/ref 17592186138422 :knowledge-point/id #uuid "3329cd2b-b1f7-59ca-9a4e-cbb30aadbbf3" :knowledge-point/title "Finding the Product of Two Nonlinear Binomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf9f33e9-4d65-5ebc-99b3-c95652687566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9x^{4} + 12x^{2}y - 4y^{2}" :db/id #edb/ref 17592186137855} {:answer/id #uuid "35ed79a8-76fc-5297-ac7a-1eec57332e68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9x^{4} + 6x^{2}y - 4y^{2}" :db/id #edb/ref 17592186137856} {:answer/id #uuid "4510f887-a539-5eff-bd45-cdc8295f3aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9x^{4} + 4y^{2}" :db/id #edb/ref 17592186137857} {:answer/id #uuid "4aabc99e-f39d-548f-bdc0-3157cdf9afe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9x^{4} - 4y^{2}" :db/id #edb/ref 17592186137858} {:answer/id #uuid "508f1f98-05fb-5fc4-9801-3c1e44d406ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9x^{4} - 12x^{2}y - 4y^{2}" :db/id #edb/ref 175921