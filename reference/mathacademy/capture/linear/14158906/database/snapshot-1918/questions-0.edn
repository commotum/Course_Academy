#{[{:db/id #edb/ref 17592186138186 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138420 :knowledge-point/id #uuid "08fda5c2-ae08-54fe-8271-b2f4c1f92eb1" :knowledge-point/title "Finding a Product Using the Difference of Squares Formula"}] :question/id #uuid "6d8e25fc-b9a0-5cd1-9a33-3e7c6d34d2c9" :question/math-academy-id "e-14323" :question/problem "Expand $(x + 3)(x - 3).$" :question/worked-solution "We will use the difference of square formula:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nSubstituting $a=x$ and $b=3,$ we have\n\n$$\n\\eqalign{\n\t\t(x + 3)(x - 3) &= \\[5pt]\n\t\tx^2 - 3^2 &= \\[5pt]\n\t\tx^2 - 9.\n\t}\n$$"}] [{:db/id #edb/ref 17592186138187 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138421 :knowledge-point/id #uuid "86c57e03-cecd-5cc3-9158-b7b5caaf2530" :knowledge-point/title "Finding the Product of Two Binomials With Leading Coefficients"}] :question/id #uuid "092e54fe-57ef-5243-a7a1-5ac10d3a0dca" :question/math-academy-id "e-14326" :question/problem "Expand $(5x - 4)(5x + 4) .$" :question/worked-solution "We will use the difference of square formula:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nSubstituting $a=5x$ and $b=4,$ we have\n\n$$\n\\eqalign{\n\t\t(5x - 4)(5x + 4) &= \\[5pt]\n\t\t(5x)^2 - (4)^2 &= \\[5pt]\n\t\t25x^2 - 16.\n\t}\n$$"}] [{:db/id #edb/ref 17592186138188 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138422 :knowledge-point/id #uuid "3329cd2b-b1f7-59ca-9a4e-cbb30aadbbf3" :knowledge-point/title "Finding the Product of Two Nonlinear Binomials"}] :question/id #uuid "fc349f72-6389-5a1d-b56f-69afe3af3d41" :question/math-academy-id "e-14329" :question/problem "Expand $(6x + y^2)(6x - y^2) .$" :question/worked-solution "We will use the difference of square formula:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nSubstituting $a=6x$ and $b=y^2,$ we have\n\n$$\n\\eqalign{\n\t\t(6x + y^2)(6x - y^2) &= \\[5pt]\n\t\t(6x)^2 - \\left(y^2\\right)^2 &= \\[5pt]\n\t\t36x^2 - y^4.\n\t}\n$$"}] [{:db/id #edb/ref 17592186138189 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186138423 :knowledge-point/id #uuid "dc7f5072-ef21-5abb-9889-13ab8814af9a" :knowledge-point/title "Finding the Product of Two Binomials Containing General Exponents"}] :question/id #uuid "eeb682a3-2246-55f7-b99c-f60c589a0587" :question/math-academy-id "e-14337" :question/problem "Expand $(2x^n-1)(2x^n+1).$" :question/worked-solution "We will use the difference of square formula:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nSubstituting $a=2x^n$ and $b=1,$ we have\n\n$$\n\\begin{aligned}(2{x}^{n}-1)(2{x}^{n}+1) & = \\\\ {(2{x}^{n})}^{2}-(1)^{2} & = \\\\ {2}^{2}\\cdot ({x}^{n})^{2}-1 & = \\\\ 4{x}^{2n}-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186483376 :knowledge-point/_questions [{:db/id #edb/ref 17592186138420 :knowledge-point/id #uuid "08fda5c2-ae08-54fe-8271-b2f4c1f92eb1" :knowledge-point/title "Finding a Product Using the Difference of Squares Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15099937-83e9-5c72-9432-7caf2eb1b27a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+18y+{y}^{2}" :db/id #edb/ref 17592186482849} {:answer/id #uuid "1a5542ec-b9b2-564c-871d-15f3d7a885cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81-18y-{y}^{2}" :db/id #edb/ref 17592186482864} {:answer/id #uuid "42d99c28-fe1a-598e-9ff0-09981c2f67c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+18y-{y}^{2}" :db/id #edb/ref 17592186482926} {:answer/id #uuid "500a8310-ca26-58f9-8936-872ef14dcc38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81-{y}^{2}" :db/id #edb/ref 17592186482953} {:answer/id #uuid "665d0ee9-863a-5693-bca5-7a38edc7ca78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+{y}^{2}" :db/id #edb/ref 17592186482991}] :answer-field/correct {:answer/id #uuid "5