 stretchy=\"false\">)</mo><mo>÷</mo><mn>2</mn></msqrt></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><msqrt><msup><mn>2</mn><mn>3</mn></msup><mo>×</mo><mo stretchy=\"false\">(</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mo>÷</mo><mn>2</mn></msqrt></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><msqrt><mn>8</mn><mo>×</mo><mn>4</mn><mo>÷</mo><mn>2</mn></msqrt></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><msqrt><mn>32</mn><mo>÷</mo><mn>2</mn></msqrt></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><msqrt><mn>16</mn></msqrt></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><msqrt><mn>4</mn><mo>⋅</mo><mn>4</mn></msqrt></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><msqrt><msup><mn>4</mn><mn>2</mn></msup></msqrt></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mn>4</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
