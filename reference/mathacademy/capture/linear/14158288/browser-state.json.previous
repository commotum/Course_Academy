\"><mjx-c class=\"mjx-c34\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd extra=\"true\"></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.6em 0.6em 0.6em 0.6em 0.6em 0.3em\"><mtr><mtd><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>×</mo><mo stretchy=\"false\">(</mo><mn>4.1</mn><mo>−</mo><msqrt><mn>4</mn></msqrt><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>×</mo><mo stretchy=\"false\">(</mo><mn>4.1</mn><mo>−</mo><msqrt><mn>2</mn><mo>⋅</mo><mn>2</mn></msqrt><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>×</mo><mo stretchy=\"false\">(</mo><mn>4.1</mn><mo>−</mo><msqrt><msup><mn>2</mn><mn>2</mn></msup></msqrt><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>×</mo><mo stretchy=\"false\">(</mo><mn>4.1</mn><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>×</mo><mo stretchy=\"false\">(</mo><mn>2.1</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo>−</mo><mn>4.2</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
