#{[{:db/id #edb/ref 17592186078317 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078450 :knowledge-point/id #uuid "10c998ff-ed64-586c-898d-92b25f48125f" :knowledge-point/title "Evaluating Expressions Containing Radicals and One or Two Additional Operations"}] :question/id #uuid "ce600599-3511-5bf7-ba8b-6691156602b1" :question/math-academy-id "e-4885" :question/problem "What is the value of $7\\times \\sqrt[3]{-8}$?" :question/worked-solution "To evaluate the given expression, we use PEMDAS. In terms of the order of operations:\n\n- expressions underneath radicals are treated the same as parentheses\n- radicals themselves are treated as exponents\n\nTherefore, we first evaluate the value of the radical, and we obtain\n\n$$\n\\begin{aligned}\n7 \\cdot \\sqrt[3]{-8} &=  \\\\\n7 \\cdot \\sqrt[3]{(-2) \\cdot (-2) \\cdot (-2)} &=  \\\\\n7 \\cdot \\sqrt[3]{(-2)^{3}} &=  \\\\\n7 \\cdot (-2) &=  \\\\\n&= - 14\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078318 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078451 :knowledge-point/id #uuid "e8ac5e9b-5b61-5b1c-b25c-cb46d1d68154" :knowledge-point/title "Evaluating Expressions Containing Radicals and Multiple Operations"}] :question/id #uuid "0c8d49e2-ad48-506c-9db7-76fd755fcc57" :question/math-academy-id "e-4887" :question/problem "Find the value of the expression $\\sqrt{(3^4+7^2-2) \\div 2}$." :question/worked-solution "To evaluate the given expression, we use PEMDAS. In terms of the order of operations:\n\n- expressions underneath radicals are treated the same as parentheses\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain\n\n$$\n\\begin{aligned}\n\\sqrt{(3^{4} + 7^{2} - 2) \\div 2} &=  \\\\\n\\sqrt{(81 + 49 - 2) \\div 2} &=  \\\\\n\\sqrt{(130 - 2) \\div 2} &=  \\\\\n\\sqrt{128 \\div 2} &=  \\\\\n\\sqrt{64} &=  \\\\\n\\sqrt{8 \\cdot 8} &=  \\\\\n\\sqrt{8^{2}} &=  \\\\\n&= 8 \\mid\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078319 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078452 :knowledge-point/id #uuid "985d535d-1f51-578d-bb43-a7940cb01fa6" :knowledge-point/title "Simplifying a Radical Expression"}] :question/id #uuid "09a1af5e-aa76-5d08-a0f2-bbb3d534250b" :question/math-academy-id "e-4895" :question/problem "Simplify the expression $\\sqrt{((5^2-4) \\div 3)-2}$." :question/worked-solution "To simplify the given expression, we use PEMDAS. In terms of the order of operations,\n\n- expressions underneath radicals are treated the same as parentheses, and\n- radicals themselves are treated as exponents.\n\nTherefore, following the order of operations, we obtain\n\n$$\n\\begin{aligned}\n\\sqrt{((5^{2} - 4) \\div 3) - 2} &=  \\\\\n\\sqrt{((25 - 4) \\div 3) - 2} &=  \\\\\n\\sqrt{(21 \\div 3) - 2} &=  \\\\\n\\sqrt{7 - 2} &=  \\\\\n&= \\sqrt{5} \\mid\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078320 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078453 :knowledge-point/id #uuid "698ccc70-a18b-5b7d-92e2-a87896649ef5" :knowledge-point/title "Approximating Radical Expressions"}] :question/id #uuid "dc345132-1bb6-5773-804c-9e0fab544c85" :question/math-academy-id "e-4905" :question/problem "What is the value of $2\\sqrt{13\\times 2 - 5} + 1$ rounded to $3$ decimal places?" :question/worked-solution "To simplify the given expression, we use PEMDAS. In terms of the order of operations,\n\n- expressions underneath radicals are treated the same as parentheses, and\n- radicals themselves are treated as exponents.\n\nTherefore, following the order of operations, we obtain\n\n$$\n\\begin{aligned}\n2\\sqrt{13 \\cdot 2 - 5} + 1 &=  \\\\\n2\\sqrt{26 - 5} + 1 &=  \\\\\n&= 2\\sqrt{21} + 1\n\\end{aligned}\n$$\n\nNow, we approximate the value of the radical using a calculator:\n\n$$\n\\sqrt{21} \\approx 4.582\\,576\n$$\n\nrounded to $6$ decimal places.\n\nFinally, we approximate the value of the expression:\n\n$$\n\\begin{aligned}\n2\\sqrt{21} + 1\\begin{vmatrix}\\approx \\\\ ‭‭‭2(4.582576) + 1 &= \\\\ 9.165152 + 1|= \\\\ 10.165152\\end{vmatrix}\\approx \\\\\n&= 10.165\n\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186078911 :knowledge-point/_questions [{:db/id #edb/ref 17592186078451 :knowledge-point/id #uuid "e8ac5e9b-5b61-5b1c-b25c-cb46d1d68154" :knowledge-point/title "Evaluating Expressions Containing Radicals and Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0607432a-e0fe-54e6-9c70-60ebf05d0163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186076245} {:answer/id #uuid "154225b3-4f88-5b8d-b9c2-09b90bd0f636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186076246} {:answer/id #uuid "2bf7ba0e-6a05-5a00-ab76-a3fb0bb486f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186076247} {:answer/id #uuid "35f638b5-3a17-5f93-82dc-5ea2e26e13ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186076248} {:answer/id #uuid "47e18671-6909-5dbb-acef-e8d441ab9382" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186076249}] :answer-field/id #uuid "86fe77c1-48d1-51c4-8764-401b0dc18fe0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186076244}] :question/id #uuid "c62a1a70-230a-5cec-afa4-68b7395a5a2a" :question/math-academy-id "q-43669" :question/problem "Find the value of the expression $\\sqrt{2^{3} \\cdot (3^{2} - 5) \\div 2}$."}] [{:db/id #edb/ref 17592186079182 :knowledge-point/_questions [{:db/id #edb/ref 17592186078452 :knowledge-point/id #uuid "985d535d-1f51-578d-bb43-a7940cb01fa6" :knowledge-point/title "Simplifying a Radical Expression"}] :question/answ