#{[{:db/id #edb/ref 17592186078317 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078450 :knowledge-point/id #uuid "10c998ff-ed64-586c-898d-92b25f48125f" :knowledge-point/title "Evaluating Expressions Containing Radicals and One or Two Additional Operations"}] :question/id #uuid "ce600599-3511-5bf7-ba8b-6691156602b1" :question/math-academy-id "e-4885" :question/problem "What is the value of $7\\times \\sqrt[3]{-8}?$" :question/worked-solution "To evaluate the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, we first evaluate the value of the radical, and we obtain\n\n$$\n\\begin{aligned}7\\times \\sqrt[3]{-8} & = \\\\ 7\\times \\sqrt[3]{(-2)\\cdot (-2)\\cdot (-2)} & = \\\\ 7\\times \\sqrt[3]{(-2)^{3}} & = \\\\ 7\\times (-2) & = \\\\ -14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078318 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078451 :knowledge-point/id #uuid "e8ac5e9b-5b61-5b1c-b25c-cb46d1d68154" :knowledge-point/title "Evaluating Expressions Containing Radicals and Multiple Operations"}] :question/id #uuid "0c8d49e2-ad48-506c-9db7-76fd755fcc57" :question/math-academy-id "e-4887" :question/problem "Find the value of the expression $\\sqrt{ (3^4+7^2-2) \\div 2}.$" :question/worked-solution "To evaluate the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain\n\n$$\n\\begin{aligned}\\sqrt{({3}^{4}+{7}^{2}-2)÷2} & = \\\\ \\sqrt{(81+49-2)÷2} & = \\\\ \\sqrt{(130-2)÷2} & = \\\\ \\sqrt{128÷2} & = \\\\ \\sqrt{64} & = \\\\ \\sqrt{8\\cdot 8} & = \\\\ \\sqrt{{8}^{2}} & = \\\\ 8 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078319 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078452 :knowledge-point/id #uuid "985d535d-1f51-578d-bb43-a7940cb01fa6" :knowledge-point/title "Simplifying a Radical Expression"}] :question/id #uuid "09a1af5e-aa76-5d08-a0f2-bbb3d534250b" :question/math-academy-id "e-4895" :question/problem "Simplify the expression $\\sqrt{((5^2-4) \\div 3)-2}.$" :question/worked-solution "To simplify the given expression, we use PEMDAS. In terms of the order of operations,\n\n- expressions underneath radicals are treated the same as parentheses, and\n\n- radicals themselves are treated as exponents.\n\nTherefore, following the order of operations, we obtain\n\n$$\n\\begin{aligned}\\sqrt{(({5}^{2}-4)÷3)-2} & = \\\\ \\sqrt{((25-4)÷3)-2} & = \\\\ \\sqrt{(21÷3)-2} & = \\\\ \\sqrt{7-2} & = \\\\ \\sqrt{5} & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078320 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186078453 :knowledge-point/id #uuid "698ccc70-a18b-5b7d-92e2-a87896649ef5" :knowledge-point/title "Approximating Radical Expressions"}] :question/id #uuid "dc345132-1bb6-5773-804c-9e0fab544c85" :question/math-academy-id "e-4905" :question/problem "What is the value of $2\\sqrt{13\\times 2 - 5} + 1$ rounded to $3$ decimal places?" :question/worked-solution "To simplify the given expression, we use PEMDAS. In terms of the order of operations,\n\n- expressions underneath radicals are treated the same as parentheses, and\n\n- radicals themselves are treated as exponents.\n\nTherefore, following the order of operations, we obtain\n\n$$\n\\begin{aligned}2\\sqrt{13\\times 2-5}+1 & = \\\\ 2\\sqrt{26-5}+1 & = \\\\ 2\\sqrt{21}+1.\\end{aligned}\n$$\n\nNow, we approximate the value of the radical using a calculator:\n\n$$\n\\sqrt{21} \\approx 4.582\\,576\n$$\n\nrounded to $6$ decimal places.\n\nFinally, we approximate the value of the expression:\n\n$$\n\\begin{aligned}2\\sqrt{21}+1 & ≈ \\\\ ‭‭‭2(4.582\\,576)+1 & = \\\\ 9.165\\,152+1 & = \\\\ 10.165\\,152 & ≈ \\\\ 10.165\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186482603 :knowledge-point/_questions [{:db/id #edb/ref 17592186078452 :knowledge-point/id #uuid "985d535d-1f51-578d-bb43-a7940cb01fa6" :knowledge-point/title "Simplifying a Radical Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39580d17-ecb3-5c7b-990f-951750e37aa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186481918} {:answer/id #uuid "7d1a8f8a-d275-59af-abf9-29bfed39be8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{7}" :db/id #edb/ref 17592186482058} {:answer/id #uuid "8c505423-2a64-5491-a7df-872452ba1bd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{12}" :db/id #edb/ref 17592186482103} {:answer/id #uuid "a0702d12-6de9-5329-b3a1-37f176ac8ae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{14}" :db/id #edb/ref 17592186482156} {:answer/id #uuid "d0fb3491-5760-52ac-99e8-5370f4b61304" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186482274}] :answer-field/correct {:answer/id #uuid "a0702d12-6de9-5329-b3a1-37f176ac8ae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{14}" :db/id #edb/ref 17592186482156} :answer-field/id #uuid "2d74b39f-54e1-52f0-bc2e-caa9fffbb46f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482404}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e0ce2975-3d0e-5df0-82ca-80c1fcc3d613" :question/math-academy-id "q-136194" :question/problem "$2\\sqrt{({5}^{2}+3)÷2}=$" :question/worked-solution "To simplify the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain:\n\n$$\n\\begin{aligned}2\\sqrt{({5}^{2}+3)÷2} & = \\\\ 2\\sqrt{(25+3)÷2} & = \\\\ 2\\sqrt{28÷2} & = \\\\ 2\\sqrt{14}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482589 :knowledge-point/_questions [{:db/id #edb/ref 17592186078452 :knowledge-point/id #uuid "985d535d-1f51-578d-bb43-a7940cb01fa6" :knowledge-point/title "Simplifying a Radical Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09adec12-840c-52e4-a460-053eee3c485d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\sqrt{5}" :db/id #edb/ref 17592186481789} {:answer/id #uuid "6cc33fc2-4115-55ae-b36f-234027346a94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186482027} {:answer/id #uuid "7ea0794d-3afe-5094-adc5-733705a0114e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\sqrt{3}" :db/id #edb/ref 17592186482065} {:answer/id #uuid "ad71bac1-6c14-560b-bf23-9d3f91df83dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\sqrt{2}" :db/id #edb/ref 17592186482182} {:answer/id #uuid "adfd4864-6a86-5407-a50c-fa90baafbbfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186482184}] :answer-field/correct {:answer/id #uuid "7ea0794d-3afe-5094-adc5-733705a0114e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\sqrt{3}" :db/id #edb/ref 17592186482065} :answer-field/id #uuid "3fc45646-39f2-579d-aaeb-9b1904be5943" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482413}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c552807e-b3ea-557b-87d6-077887001adc" :question/math-academy-id "q-136201" :question/problem "$7\\sqrt{6÷(6-{2}^{2})}=$" :question/worked-solution "To simplify the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain:\n\n$$\n\\begin{aligned}7\\sqrt{6÷(6-{2}^{2})} & = \\\\ 7\\sqrt{6÷(6-4)} & = \\\\ 7\\sqrt{6÷2} & = \\\\ 7\\sqrt{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482541 :knowledge-point/_questions [{:db/id #edb/ref 17592186078453 :knowledge-point/id #uuid "698ccc70-a18b-5b7d-92e2-a87896649ef5" :knowledge-point/title "Approximating Radical Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b824ae97-0782-520b-98c2-6828b4f4b7ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.742" :db/id #edb/ref 17592186482212}] :answer-field/correct {:answer/id #uuid "b824ae97-0782-520b-98c2-6828b4f4b7ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.742" :db/id #edb/ref 17592186482212} :answer-field/id #uuid "40f14f8c-bc9b-58e2-900b-314d7347ebbd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482414}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "531dca87-ee51-5a1e-9c95-aee21eccb0e1" :question/math-academy-id "q-171401" :question/problem "Rounded to $3$ decimal places, $\\sqrt{6+4\\times 2}=${{field-1}}." :question/worked-solution "To simplify the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain:\n\n$$\n\\begin{aligned}\\sqrt{6+4\\times 2} & = \\\\ \\sqrt{6+8} & = \\\\ \\sqrt{14}\\end{aligned}\n$$\n\nNow, we approximate the value of $\\sqrt{14}$ using a calculator:\n\n$$\n\\begin{aligned}\\sqrt{14} & ≈‭‭‭3.742\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186482563 :knowledge-point/_questions [{:db/id #edb/ref 17592186078451 :knowledge-point/id #uuid "e8ac5e9b-5b61-5b1c-b25c-cb46d1d68154" :knowledge-point/title "Evaluating Expressions Containing Radicals and Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1455e6c1-309a-56b4-a6aa-582080a449e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186481829} {:answer/id #uuid "1ebd314b-c42c-5c47-9e5e-aaaf861ee759" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186481857} {:answer/id #uuid "84767d45-64a9-5b34-9544-e88575bda101" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186482081} {:answer/id #uuid "b5d7b568-d6f9-5bc7-9f76-0d3c7129a6b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186482204} {:answer/id #uuid "bba07ddb-8eae-5dde-8c94-8dec52b7671c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186482223}] :answer-field/correct {:answer/id #uuid "b5d7b568-d6f9-5bc7-9f76-0d3c7129a6b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186482204} :answer-field/id #uuid "9ddb49c7-56ff-50b1-bda5-8906fafda295" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482461}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d68d1bd-9a61-5ae6-b9dd-a03d4f1484bc" :question/math-academy-id "q-43627" :question/problem "Find ${3}^{2}÷(\\sqrt{25}-2).$" :question/worked-solution "To evaluate the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain:\n\n$$\n\\begin{aligned}{3}^{2}÷(\\sqrt{25}-2) & = \\\\ {3}^{2}÷(\\sqrt{5\\cdot 5}-2) & = \\\\ {3}^{2}÷(\\sqrt{{5}^{2}}-2) & = \\\\ {3}^{2}÷(5-2) & = \\\\ {3}^{2}÷3 & = \\\\ 9÷3 & = \\\\ 3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078911 :knowledge-point/_questions [{:db/id #edb/ref 17592186078451 :knowledge-point/id #uuid "e8ac5e9b-5b61-5b1c-b25c-cb46d1d68154" :knowledge-point/title "Evaluating Expressions Containing Radicals and Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0607432a-e0fe-54e6-9c70-60ebf05d0163" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186076245} {:answer/id #uuid "154225b3-4f88-5b8d-b9c2-09b90bd0f636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186076246} {:answer/id #uuid "2bf7ba0e-6a05-5a00-ab76-a3fb0bb486f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186076247} {:answer/id #uuid "35f638b5-3a17-5f93-82dc-5ea2e26e13ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186076248} {:answer/id #uuid "47e18671-6909-5dbb-acef-e8d441ab9382" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186076249}] :answer-field/correct {:answer/id #uuid "35f638b5-3a17-5f93-82dc-5ea2e26e13ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186076248} :answer-field/id #uuid "86fe77c1-48d1-51c4-8764-401b0dc18fe0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186076244}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c62a1a70-230a-5cec-afa4-68b7395a5a2a" :question/math-academy-id "q-43669" :question/problem "Find the value of the expression $\\sqrt{{2}^{3}\\times ({3}^{2}-5)÷2}.$" :question/worked-solution "To evaluate the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain:\n\n$$\n\\begin{aligned}\\sqrt{{2}^{3}\\times ({3}^{2}-5)÷2} & = \\\\ \\sqrt{{2}^{3}\\times (9-5)÷2} & = \\\\ \\sqrt{{2}^{3}\\times (4)÷2} & = \\\\ \\sqrt{8\\times 4÷2} & = \\\\ \\sqrt{32÷2} & = \\\\ \\sqrt{16} & = \\\\ \\sqrt{4\\cdot 4} & = \\\\ \\sqrt{{4}^{2}} & = \\\\ 4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482528 :knowledge-point/_questions [{:db/id #edb/ref 17592186078453 :knowledge-point/id #uuid "698ccc70-a18b-5b7d-92e2-a87896649ef5" :knowledge-point/title "Approximating Radical Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f5c89c3-07b7-5df3-a433-2fc26cf926fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.905" :db/id #edb/ref 17592186481892} {:answer/id #uuid "980de0e0-baed-55bd-b152-8acd4625867b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186482132} {:answer/id #uuid "9adfb39f-6f5a-530a-b68a-6f8e62c7bc27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "‭-2.045" :db/id #ed