\\\\ (-2)\\cdot 4+3.3 & = \\\\ -8+3.3 & = \\\\ -4.7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482559 :knowledge-point/_questions [{:db/id #edb/ref 17592186078451 :knowledge-point/id #uuid "e8ac5e9b-5b61-5b1c-b25c-cb46d1d68154" :knowledge-point/title "Evaluating Expressions Containing Radicals and Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "331769fd-392c-5fa7-8159-3a314da12662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186481898} {:answer/id #uuid "353db5e0-fb0c-5857-a2f5-6090c135c5ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186481904} {:answer/id #uuid "37bb337e-9900-555f-884a-4f079ca34ab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186481914} {:answer/id #uuid "9286a35c-2dc6-53af-8c6e-4f5e43cb3915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186482118} {:answer/id #uuid "ce3e7796-3c29-5861-8a8d-521ee069f312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186482262}] :answer-field/correct {:answer/id #uuid "37bb337e-9900-555f-884a-4f079ca34ab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186481914} :answer-field/id #uuid "d9827850-9b38-58c0-a560-bbc82a0bfdd5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482493}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "833d1e11-5a78-5410-a7b5-c29285538e0f" :question/math-academy-id "q-69112" :question/problem "What is $\\sqrt{{3}^{3}÷({2}^{3}+1)\\times 27}?$" :question/worked-solution "To evaluate the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain:\n\n$$\n\\begin{aligned}\\sqrt{{3}^{3}÷({2}^{3}+1)\\times 27} & = \\\\ \\sqrt{{3}^{3}÷(8+1)\\times 27} & = \\\\ \\sqrt{{3}^{3}÷9\\times 27} & = \\\\ \\sqrt{27÷9\\times 27} & = \\\\ \\sqrt{3\\times 27} & = \\\\ \\sqrt{81} & = \\\\ \\sqrt{9\\cdot 9} & = \\\\ \\sqrt{{9}^{2}} & = \\\\ 9\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186482533 :knowledge-point/_questions [{:db/id #edb/ref 17592186078451 :knowledge-point/id #uuid "e8ac5e9b-5b61-5b1c-b25c-cb46d1d68154" :knowledge-point/title "Evaluating Expressions Containing Radicals and Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2745bb24-5840-55f6-931d-2b152d735984" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10.1" :db/id #edb/ref 17592186481876} {:answer/id #uuid "a5a8a3c9-56b8-5913-910e-d95965c0e447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.2" :db/id #edb/ref 17592186482168} {:answer/id #uuid "d3720577-5e59-5eea-84ee-913448cf58d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.2" :db/id #edb/ref 17592186482280} {:answer/id #uuid "d51ebc77-78d2-534b-b4fc-e2f01d991b1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.2" :db/id #edb/ref 17592186482285} {:answer/id #uuid "dd8d183a-6251-5c2b-b30e-a4b52550966d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.1" :db/id #edb/ref 17592186482300}] :answer-field/correct {:answer/id #uuid "d3720577-5e59-5eea-84ee-913448cf58d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.2" :db/id #edb/ref 17592186482280} :answer-field/id #uuid "0a879489-ac5d-5d24-945a-940805770edd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482384}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "442c94f9-fe8b-546a-8c5a-f7942d124959" :question/math-academy-id "q-69121" :question/problem "$(-2)\\times (4.1-\\sqrt{4})=$" :question/worked-solution "To evaluate the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain:\n\n$$\n\\begin{aligned}(-2)\\times (4.1-\\sqrt{4}) & = \\\\ (-2)\\times (4.1-\\sqrt{2\\cdot 2}) & = \\\\ (-2)\\times (4.1-\\sqrt{{2}^{2}}) & = \\\\ (-2)\\times (4.1-2) & = \\\\ (-2)\\times (2.1) & = \\\\ -4.2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186079182 :knowledge-point/_questions [{:db/id #edb/ref 17592186078452 :knowledge-point/id #uuid "985d535d-1f51-578d-bb43-a7940cb01fa6" :knowledge-point/title "Simplifying a Radical Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81362f0d-b0b7-5116-8c58-ef732d2e0748" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186077871} {:answer/id #uuid "d3f9784c-37f1-54d3-990e-0ed0f27bedb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186077872} {:answer/id #uuid "f881fb13-ca20-5f7a-8a39-f5af2e596e6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{13}" :db/id #edb/ref 17592186077873} {:answer/id #uuid "1c01bb27-24e6-5f5e-94a9-b469c9561149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{3}" :db/id #edb/ref 17592186077874} {:an