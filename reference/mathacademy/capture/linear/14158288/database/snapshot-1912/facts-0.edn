5417] [17592186078317 #edb/ref 1071 "What is the value of $7\\times \\sqrt[3]{-8}$?" #edb/ref 17592186045417] [17592186078317 #edb/ref 1072 #uuid "ce600599-3511-5bf7-ba8b-6691156602b1" #edb/ref 17592186045417] [17592186078317 #edb/ref 1074 "To evaluate the given expression, we use PEMDAS. In terms of the order of operations:\n\n- expressions underneath radicals are treated the same as parentheses\n- radicals themselves are treated as exponents\n\nTherefore, we first evaluate the value of the radical, and we obtain\n\n$$\n\\begin{aligned}\n7 \\cdot \\sqrt[3]{-8} &=  \\\\\n7 \\cdot \\sqrt[3]{(-2) \\cdot (-2) \\cdot (-2)} &=  \\\\\n7 \\cdot \\sqrt[3]{(-2)^{3}} &=  \\\\\n7 \\cdot (-2) &=  \\\\\n&= - 14\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186078318 #edb/ref 1069 "e-4887" #edb/ref 17592186045417] [17592186078318 #edb/ref 1071 "Find the value of the expression $\\sqrt{(3^4+7^2-2) \\div 2}$." #edb/ref 17592186045417] [17592186078318 #edb/ref 1072 #uuid "0c8d49e2-ad48-506c-9db7-76fd755fcc57" #edb/ref 17592186045417] [17592186078318 #edb/ref 1074 "To evaluate the given expression, we use PEMDAS. In terms of the order of operations:\n\n- expressions underneath radicals are treated the same as parentheses\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain\n\n$$\n\\begin{aligned}\n\\sqrt{(3^{4} + 7^{2} - 2) \\div 2} &=  \\\\\n\\sqrt{(81 + 49 - 2) \\div 2} &=  \\\\\n\\sqrt{(130 - 2) \\div 2} &=  \\\\\n\\sqrt{128 \\div 2} &=  \\\\\n\\sqrt{64} &=  \\\\\n\\sqrt{8 \\cdot 8} &=  \\\\\n\\sqrt{8^{2}} &=  \\\\\n&= 8 \\mid\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186078319 #edb/ref 1069 "e-4895" #edb/ref 17592186045417] [17592186078319 #edb/ref 1071 "Simplify the expression $\\sqrt{((5^2-4) \\div 3)-2}$." #edb/ref 17592186045417] [17592186078319 #edb/ref 1072 #uuid "09a1af5e-aa76-5d08-a0f2-bbb3d534250b" #edb/ref 17592186045417] [17592186078319 #edb/ref 1074 "To simplify the given expression, we use PEMDAS. In terms of the order of operations,\n\n- expressions underneath radicals are treated the same as parentheses, and\n- radicals themselves are treated as exponents.\n\nTherefore, following the order of operations, we obtain\n\n$$\n\\begin{aligned}\n\\sqrt{((5^{2} - 4) \\div 3) - 2} &=  \\\\\n\\sqrt{((25 - 4) \\div 3) - 2} &=  \\\\\n\\sqrt{(21 \\div 3) - 2} &=  \\\\\n\\sqrt{7 - 2} &=  \\\\\n&= \\sqrt{5} \\mid\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186078320 #edb/ref 1069 "e-4905" #edb/ref 17592186045417] [17592186078320 #edb/ref 1071 "What is the value of $2\\sqrt{13\\times 2 - 5} + 1$ rounded to $3$ decimal places?" #edb/ref 17592186045417] [17592186078320 #edb/ref 1072 #uuid "dc345132-1bb6-5773-804c-9e0fab544c85" #edb/ref 17592186045417] [17592186078320 #edb/ref 1074 "To simplify the given expression, we use PEMDAS. In terms of the order of operations,\n\n- expressions underneath radicals are treated the same as parentheses, and\n- radicals themselves are treated as exponents.\n\nTherefore, following the order of operations, we obtain\n\n$$\n\\begin{aligned}\n2\\sqrt{13 \\cdot 2 - 5} + 1 &=  \\\\\n2\\sqrt{26 - 5} + 1 &=  \\\\\n&= 2\\sqrt{21} + 1\n\\end{aligned}\n$$\n\nNow, we approximate the value of the radical using a calculator:\n\n$$\n\\sqrt{21} \\approx 4.582\\,576\n$$\n\nrounded to $6$ decimal places.\n\nFinally, we approximate the value of the expression:\n\n$$\n\\begin{aligned}\n2\\sqrt{21} + 1\\begin{vmatrix}\\approx \\\\ ‭‭‭2(4.582576) + 1 &= \\\\ 9.165152 + 1|= \\\\ 10.165152\\end{vmatrix}\\approx \\\\\n&= 10.165\n\\end{aligned}\n$$\n\nrounded to $3$ decimal places." #edb/ref 17592186045417] [17592186078450 #edb/ref 1037 #edb/ref 17592186048594 #edb/ref 17592186045417] [17592186078450 #edb/ref 1037 #edb/ref 17592186048770 #edb/ref 17592186045417] [17592186078450 #edb/ref 1037 #edb/ref 17592186050358 #edb/ref 17592186045417] [17592186078450 #edb/ref 1038 #edb/ref 17592186078904 #edb/ref 17592186045417] [17592186078450 #edb/ref 1038 #edb/ref 17