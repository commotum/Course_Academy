#{[{:activity/course {:db/id #edb/ref 17592186046647} :activity/first-step {:db/id #edb/ref 17592186534121} :activity/id #uuid "38e95199-7378-5c57-8b6f-37733a1f504d" :activity/scope {:db/id #edb/ref 17592186050987 :topic/id #uuid "7734519e-e666-5361-81f3-89b86b5bc28d" :topic/math-academy-id 37} :activity/steps [{:db/id #edb/ref 17592186534118 :step/content {:db/id #edb/ref 17592186233023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2d9170-72bf-5608-bc85-b7e1e90b7337" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186533246} {:answer/id #uuid "3a9642e4-5571-5f69-b42d-8a766a19f94a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186533276} {:answer/id #uuid "b3087c4f-f3ff-5f73-85e3-80711023e115" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186533572} {:answer/id #uuid "c97fc178-695e-5644-8659-728e66bdb6d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186533621} {:answer/id #uuid "cfdaab07-184b-57e0-83cf-49eb37899d71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186533643}] :answer-field/correct {:db/id #edb/ref 17592186533276} :answer-field/id #uuid "eccb0955-0665-53a1-96c5-95a613de628c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533947}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "98c65517-e27d-5eb7-b458-8dcf5425928f" :question/math-academy-id "q-100273" :question/problem "![](images/fd/fda731fa3c9a3401e9b9e2a7d4c103829d3fe3b14ac9d6f2872b76a319f6ae91.png)\n\nFind ${lim}_{x\\to \\,1}(2{x}^{3}-4f(x))^{3}(2{x}^{4}-3)^{2}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph, we get that ${lim}_{x\\to \\,1}f(x)=1.$ \n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to \\,1}(2{x}^{3}-4f(x))^{3}(2{x}^{4}-3)^{2}={lim}_{x\\to \\,1}(2{x}^{3}-4f(x))^{3}\\cdot {lim}_{x\\to \\,1}(2{x}^{4}-3)^{2}.\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}(2{x}^{3}-4f(x))^{3} & ={({lim}_{x\\to \\,1}(2{x}^{3}-4f(x)))}^{3} \\\\  & =(2(1)^{3}-4(1))^{3} \\\\  & =(-2)^{3} \\\\  & =-8,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}(2{x}^{4}-3)^{2} & ={({lim}_{x\\to \\,1}(2{x}^{4}-3))}^{2} \\\\  & =(2(1)^{4}-3)^{2} \\\\  & =(-1)^{2} \\\\  & =1\\,.\\end{aligned}\n$$\n\nFinally, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}(2{x}^{3}-4f(x))^{3}(2{x}^{4}-3)^{2} & ={lim}_{x\\to \\,1}(2{x}^{3}-4f(x))^{3}\\cdot {lim}_{x\\to \\,1}(2{x}^{4}-3)^{2} \\\\  & =(-8)\\cdot (1) \\\\  & =-8\\,.\\end{aligned}\n$$"} :step/id #uuid "3ceee877-c8fc-531a-9878-62234964e115"} {:db/id #edb/ref 17592186534121 :step/content {:db/id #edb/ref 17592186055233 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83f5e618-9958-5c65-98d7-f72834d8cfad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-81" :db/id #edb/ref 17592186052636} {:answer/id #uuid "c02dfdc4-656f-5641-998f-9bc8a0a18e95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186052637} {:answer/id #uuid "d027fbd4-28ba-5990-9755-63cf439bf5a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186052638} {:answer/id #uuid "41356929-64d9-5d70-95a1-343710b86dad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-641" :db/id #edb/ref 17592186052639} {:answer/id #uuid "42e68d28-554b-55d7-b11f-12bfa298f433" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186052640}] :answer-field/correct {:db/id #edb/ref 17592186052640} :answer-field/id #uuid "022ec75f-d363-5486-95b7-fc4dff138c8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186052635}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0bbcd500-ae70-509c-b570-d85bc1475ae3" :question/math-academy-id "q-35294" :question/problem "![](images/b7/b75586450ddee4f682f02539e02462d0aa5f88830b2989cc7cc2f4f6df635ade.png)\n\nFind ${lim}_{x\\to \\,-1}(5+7x)^{3}(f(x)-x)^{4}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph, we get that ${lim}_{x\\to \\,-1}f(x)=0.$ \n\nFrom the product rule, we have\n\n$$\n{lim}_{x\\to \\,-1}(5+7x)^{3}(f(x)-x)^{4}={lim}_{x\\to \\,-1}(5+7x)^{3}\\cdot {lim}_{x\\to \\,-1}(f(x)-x)^{4}.\n$$\n\nWe calculate the limits of each factor, separately.\n\nApplying the power rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-1}(5+7x)^{3} & ={({lim}_{x\\to \\,-1}(5+7x))}^{3} \\\\  & =(5+7\\cdot (-1))^{3} \\\\  & =(-2)^{3} \\\\  & =-8,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-1}(f(x)-x)^{4} & ={({lim}_{x\\to \\,-1}(f(x)-x))}^{4} \\\\  & =(0-(-1))^{4} \\\\  & ={1}^{4} \\\\  & =1\\,.\\end{aligned}\n$$\n\nFinally, we have\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-1}(5+7x)^{3}(f(x)-x)^{4} & ={lim}_{x\\to \\,-1}(5+7x)^{3}\\cdot {lim}_{x\\to \\,-1}(f(x)-x)^{4} \\\\  & =(-8)\\cdot (1) \\\\  & =-8\\,.\\end{aligned}\n$$"} :step/id #uuid "4c6aa450-6cdc-50b4-806e-6dec30f5eb67" :step/next {:db/id #edb/ref 17592186534155}} {:db/id #edb/ref 17592186534155 :step/content {:db/id #edb/ref 17592186233995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5797e9e9-6e67-537d-a655-48ab777ada22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{21}}{2}" :db/id #edb/ref 17592186533344} {:answer/id #uuid "6cc339c6-f7b7-5c24-ab62-8e1ff9e4ed3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186533394} {:answer/id #uuid "df10c16c-70c6-58c4-9182-e668df07e549" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186533689} {:answer/id #uuid "e6d0edc5-1ae9-515d-a0fc-bd1888788abb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{21}{4}" :db/id #edb/ref 17592186533708} {:answer/id #uuid "f40b5418-f57a-574c-a2f2-815b0c4b394d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186533739}] :answer-field/correct {:db/id #edb/ref 17592186533394} :answer-field/id #uuid "db0ef0b5-fcba-553e-ac8c-0225ffb723a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533931}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "946e7009-82f2-5bbe-a154-157adaaa3621" :question/math-academy-id "q-35295" :question/problem "![](images/95/95e092490e087b5245f05b352b4738beb1ce3d9d649ea289ded881d0728129e5.png)\n\nFind ${lim}_{x\\to 1/2}\\sqrt{4(f(x))^{4}+10x}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph, we get that ${lim}_{x\\to 1/2}f(x)=1.$\n\nApplying the root rule, we have \n\n$$\n\\begin{aligned}{lim}_{x\\to 1/2}\\sqrt{4(f(x))^{4}+10x} & =\\sqrt{{lim}_{x\\to 1/2}(4(f(x))^{4}+10x)} \\\\  & =\\sqrt{4(1)^{4}+10\\cdot \\frac{1}{2}} \\\\  & =\\sqrt{4+5} \\\\  & =\\sqrt{9} \\\\  & =3\\,.\\end{aligned}\n$$"} :step/id #uuid "ec7c12e6-02c7-5b5a-a366-35e1a8ba03d7" :step/next {:db/id #edb/ref 17592186534118}}] :activity/title "The Power and Root Rules for Limits" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186533121}]}
