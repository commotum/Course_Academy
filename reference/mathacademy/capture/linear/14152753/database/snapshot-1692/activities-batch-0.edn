#{[{:activity/first-step {:db/id #edb/ref 17592186153298} :activity/id #uuid "b42cbc99-dc3a-5ea5-af15-2e43d6dacdce" :activity/scope {:db/id #edb/ref 17592186048502 :topic/id #uuid "a4f450cf-8fc5-50db-946a-e2e69ec67915" :topic/math-academy-id 2560} :activity/steps [{:db/id #edb/ref 17592186153298 :step/content {:db/id #edb/ref 17592186153325 :tutorial/content "Sometimes we need to find a number that is a certain percentage *greater than* a given amount. This corresponds to applying a so-called **percentage increase.**\n\nTo apply a percentage increase, we add the increase to $100\\%$, convert the result to a decimal multiplier, and then find the product of the multiplier and the original number.\n\nTo demonstrate, let's consider the following problem.\n\n> What number is $25\\%$ *greater than* $160$?\n\nThe key words here are \"$\\boldsymbol{25\\%}$ **greater than.**\" This means we need to apply a percentage increase, increasing the original number by $25\\%$.\n\nTo find a number $25\\%$ greater than $160$, we apply a new percentage of\n\n$$\n100\\% + 25\\% = 125\\%\n$$\n\nThis means that our new number is $125\\%$ of $160$.\n\nSo, first, we convert this percentage to a decimal:\n\n$$\n125\\% = \\dfrac{125}{100} = 1.25\n$$\n\nTo find a number that is $25\\%$ greater than $160$, we multiply $160$ by $1.25{:}$\n\n$$\n1.25 \\cdot 160 = 200\n$$\n\nTherefore, the number that is $25\\%$ *greater than* $160$ is $200$.\n\nThis method applies to *any* percentage increase, including those greater than $100\\%{;}$ add the increase to $100\\%$ before converting to a decimal multiplier." :tutorial/id #uuid "83dbd64f-3ab9-5239-b54b-ae6d91816248" :tutorial/math-academy-id 14336 :tutorial/title "Introduction"} :step/id #uuid "547ba33b-b6b3-5bae-b2dc-eacefe1e81a4" :step/math-academy-id 615692 :step/next {:db/id #edb/ref 17592186153299}} {:db/id #edb/ref 17592186153299 :step/content {:db/id #edb/ref 17592186152295 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151899 :question/id #uuid "2cfd1ed7-8249-5970-9ddc-1bb69929951c" :question/math-academy-id "e-21450"} :knowledge-point/id #uuid "125ed0b3-14ad-5af8-8370-ca6f83d93c35" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050716}] :knowledge-point/questions [{:db/id #edb/ref 17592186152552} {:db/id #edb/ref 17592186152553}] :knowledge-point/title "Applying a Percentage Increase"} :step/id #uuid "a946c7fa-5aee-54d2-b223-0a3b560b3401" :step/math-academy-id 615693 :step/next {:db/id #edb/ref 17592186153300}} {:db/id #edb/ref 17592186153300 :step/content {:db/id #edb/ref 17592186152296 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151900 :question/id #uuid "95c3dedd-accd-57dc-91ee-4ee8fdb2f3a4" :question/math-academy-id "e-21451"} :knowledge-point/id #uuid "f90ea994-79f2-5409-bf96-306803b4ef01" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049467}] :knowledge-point/questions [{:db/id #edb/ref 17592186152554} {:db/id #edb/ref 17592186152555}] :knowledge-point/title "Applying a Percentage Increase: Word Problems"} :step/id #uuid "fd57418f-a99a-5c17-9192-9191eca0084b" :step/math-academy-id 615696 :step/next {:db/id #edb/ref 17592186153301}} {:db/id #edb/ref 17592186153301 :step/content {:db/id #edb/ref 17592186153340 :tutorial/content "It's possible to increase a number by $100\\%$ or more.\n\nFor example, what number is $150\\%$ greater than $90$?\n\nTo find a number $150\\%$ *greater than* $90$, we apply a new percentage of\n\n$$\n100\\% + 150\\% = 250\\%\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n250\\% = \\dfrac{250}{100} = 2.5\n$$\n\nSo, to find a number that is $150\\%$ greater than $90$, we multiply $90$ by $2.5$:\n\n$$\n2.5 \\cdot 90 = 225\n$$\n\nTherefore, the number that is $150\\%$ greater than $90$ is $225$." :tutorial/id #uuid "a0514684-2b6b-52ce-9ccb-6d28ed8d4850" :tutorial/math-academy-id 15090 :tutorial/title "Percentage Increases Greater Than 100%"} :step/id #uuid "a3bd6e9e-9d93-51a6-9a20-5e9292cf93f4" :step/math-academy-id 615700 :step/next {:db/id #edb/ref 17592186153302}} {:db/id #edb/ref 17592186153302 :step/content {:db/id #edb/ref 17592186152297 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151901 :question/id #uuid "4af9bc31-4980-5c3c-9025-45e85ac09d8a" :question/math-academy-id "e-21517"} :knowledge-point/id #uuid "88d0f4ad-a3f9-5275-b5d5-a9973bf63ebf" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050618}] :knowledge-point/questions [{:db/id #edb/ref 17592186152551} {:db/id #edb/ref 17592186152556}] :knowledge-point/title "Applying Percentage Increases Greater Than 100%"} :step/id #uuid "d9b4f520-6201-594a-907d-e7a899c8d57c" :step/math-academy-id 615701 :step/next {:db/id #edb/ref 17592186153303}} {:db/id #edb/ref 17592186153303 :step/content {:db/id #edb/ref 17592186152298 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151913 :question/id #uuid "92d9c3ca-6e59-5c73-b640-114dfb7d13cd" :question/math-academy-id "e-22093"} :knowledge-point/id #uuid "bbb0103d-d686-575a-8ef8-81640227f4dc" :knowledge-point/questions [{:db/id #edb/ref 17592186152557} {:db/id #edb/ref 17592186152558}] :knowledge-point/title "Solving Word Problems Involving Percentage Increases Greater Than 100%"} :step/id #uuid "10eca415-b601-5bc8-80c2-c2db5a9c451e" :step/math-academy-id 615704}] :activity/title "Applying Percentage Increases" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152315}]}
