{5}}" :db/id #edb/ref 17592186430319} {:answer/id #uuid "ed7b269f-953a-54fa-9e61-dd5a4919e14b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186430334}] :answer-field/correct {:answer/id #uuid "b8ab8f31-61b0-55ea-ace1-21a1ef7ae4b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186430319} :answer-field/id #uuid "e30ad71c-64f9-5534-85f8-dfc05dd3aec9" :answer-field/key "field-8" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186430357}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2cc63714-8ef0-5462-b695-51b69677adfb" :question/math-academy-id "q-363835" :question/problem "$$\nA=[\\begin{aligned}-2 & 0 \\\\ 0 & 0 \\\\ 4 & 0\\end{aligned}],\\,Σ=[\\begin{aligned}2\\sqrt{5} & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$  select the correct options in the computations of the matrix $U$ below.\n\nFrom the matrix $Σ,$ we deduce the singular values ${\\sigma }_{1}=2\\sqrt{5}$ and ${\\sigma }_{2}=0.$\n\nNow, we compute the $1$st column of $U.$ It is given by:\n\n|  |  | {{field-1}} |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{1}=\\,\\,$ |  | $0$ |  |  |\n|  |  | {{field-2}} |  |  |\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal.\n\nHence, we must find vectors $u=[{x}_{1},{x}_{2},{x}_{3}]^{T}$ such that ${u}_{1}\\cdot u=0,$ which is equivalent to \n\n$$\n{{field-3}}.\n$$\n\nChoosing ${x}_{2}$ and ${x}_{3}$ as free variables, the general solution is given by:\n\n|  |  | $2{x}_{3}$ |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | {{field-4}} |  |  |\n|  |  | {{field-5}} |  |  |\n\nthat we can rewrite as\n\n$$\n[\\begin{aligned}2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\nSince the two linearly independent solutions are already mutually orthogonal, we only need to normalize them. Hence, we obtain the second and third columns of $U:$\n\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{2}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-6}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-7}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{3}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-8}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-9}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\frac{1}{\\sqrt{5}}$</td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=2\\sqrt{5}$ and ${\\sigma }_{2}=0.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{2\\sqrt{5}}[\\begin{aligned}-2 & 0 \\\\ 0 & 0 \\\\ 4 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{2\\sqrt{5}}[\\begin{aligned}-2 \\\\ 0 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ 0 \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}]\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n-\\frac{1}{\\sqrt{5}}{x}_{1}+\\frac{2}{\\sqrt{5}}{x}_{3}=0\\,⟹\\,-{x}_{1}+2{x}_{3}=0,\n$$\n\nwe get the general solution \n\n$$\n[\\begin{aligned}2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}{{[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{1}}+{x}_{3}{{[\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{2}$ and ${x}_{3}$ are free variables.\n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are mutually orthogonal. Therefore, we only need to normalize them. This gives the second and third columns of $U:$   \n\n$$\n{u}_{2}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]\\,{u}_{3}=[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & 0 & \\frac{2}{\\sqrt{5}} \\\\ 0 & 1 & 0 \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}}\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186430359 :knowledge-point/_questions [{:db/id #edb/ref 17592186162045 :knowledge-point/id #uuid "566bda0f-f62d-581d-936d-baa8ae474e50" :knowledge-point/title "Finding the First Factor in the SVD of a Rectangular Matrix: Cases Requiring Orthogonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55a5e9b6-ba04-5596-85c3-98cbfa5749b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186430282} {:answer/id #uuid "8d2736ce-0ded-5e27-8be4-d1b6b00a4c03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{2}}" :db/id #edb/ref 17592186430301} {:answer/id #uuid "9c1f2ff8-006b-5ae9-afd4-cd25ca36cc9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186430305} {:answer/id #uuid "f422fa6e-88a7-5efa-ab1c-7813698673fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186430336}] :answer-field/correct {:answer/id #uuid "9c1f2ff8-006b-5ae9-afd4-cd25ca36cc9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186430305} :answer-field/id #uuid "03b01ee8-41bf-5748-a07b-1c8fbdd71f8c" :answer-field/key "field-8" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-fiel