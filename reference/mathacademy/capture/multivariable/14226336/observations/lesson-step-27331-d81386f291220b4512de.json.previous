56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E1-MJMATHI-72\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-3D\" x=\"729\" y=\"0\"></use>\n<g transform=\"translate(1785,0)\">\n <use xlink:href=\"#E1-MJMAIN-73\"></use>\n <use xlink:href=\"#E1-MJMAIN-69\" x=\"394\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-6E\" x=\"673\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E1-MJMAIN-28\" x=\"3015\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-35\" x=\"3404\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMATHI-3B8\" x=\"3905\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-29\" x=\"4374\" y=\"0\"></use>\n</g>\n</svg></span> (shown above) is given by the integral\n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"24.415ex\" height=\"6.343ex\" style=\"vertical-align: -2.338ex;\" viewBox=\"0 -1724.2 10511.8 2730.8\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-2-Title\">\n<title id=\"MathJax-SVG-2-Title\">\n\tA = \\dfrac{1}{2} \\int_{0}^{\\pi/5} \\sin^2(5\\theta) \\:\\textrm{d}\\theta.\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E2-MJMATHI-41\" d=\"M208 74Q208 50 254 46Q272 46 272 35Q272 34 270 22Q267 8 264 4T251 0Q249 0 239 0T205 1T141 2Q70 2 50 0H42Q35 7 35 11Q37 38 48 46H62Q132 49 164 96Q170 102 345 401T523 704Q530 716 547 716H555H572Q578 707 578 706L606 383Q634 60 636 57Q641 46 701 46Q726 46 726 36Q726 34 723 22Q720 7 718 4T704 0Q701 0 690 0T651 1T578 2Q484 2 455 0H443Q437 6 437 9T439 27Q443 40 445 43L449 46H469Q523 49 533 63L521 213H283L249 155Q208 86 208 74ZM516 260Q516 271 504 416T490 562L463 519Q447 492 400 412L310 260L413 259Q516 259 516 260Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-3D\" d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L