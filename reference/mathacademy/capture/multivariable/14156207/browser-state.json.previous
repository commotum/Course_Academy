up><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>A</mi><msub><mi>t</mi><mn>0</mn></msub></mrow></msup><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi>A</mi><msub><mi>t</mi><mn>0</mn></msub></mrow></msup><mo>=</mo><mi>I</mi></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container>"
            },
            {
              "option": "1",
              "dom_id": null,
