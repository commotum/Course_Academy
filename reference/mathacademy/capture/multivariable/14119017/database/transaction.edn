{2}^{2} \\\\  & =6\\,J.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-33c85393-49c2-59b3-86c8-fb54c6c913c0"] :db/ensure [:question/validate]} {:db/id "answer-field-33c85393-49c2-59b3-86c8-fb54c6c913c0" :answer-field/id #uuid "33c85393-49c2-59b3-86c8-fb54c6c913c0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-016d8147-2b48-53a6-82af-fafe816ab49a" :answer-field/choices ["answer-9eea50ba-01cb-55aa-9a12-e59c66a5bac2" "answer-8f693876-d062-56a4-8e01-a7786aea86f2" "answer-e9d6d1ac-3382-5896-9f56-457c7886e3bb" "answer-016d8147-2b48-53a6-82af-fafe816ab49a" "answer-4e46b4a9-a4e3-5f5f-80ed-268038e11e48"] :db/ensure [:answer-field/validate]} {:db/id "answer-9eea50ba-01cb-55aa-9a12-e59c66a5bac2" :answer/id #uuid "9eea50ba-01cb-55aa-9a12-e59c66a5bac2" :answer/type :answer.type/math :answer/value "12\\,J" :db/ensure [:answer/validate]} {:db/id "answer-8f693876-d062-56a4-8e01-a7786aea86f2" :answer/id #uuid "8f693876-d062-56a4-8e01-a7786aea86f2" :answer/type :answer.type/math :answer/value "15\\,J" :db/ensure [:answer/validate]} {:db/id "answer-e9d6d1ac-3382-5896-9f56-457c7886e3bb" :answer/id #uuid "e9d6d1ac-3382-5896-9f56-457c7886e3bb" :answer/type :answer.type/math :answer/value "3\\,J" :db/ensure [:answer/validate]} {:db/id "answer-016d8147-2b48-53a6-82af-fafe816ab49a" :answer/id #uuid "016d8147-2b48-53a6-82af-fafe816ab49a" :answer/type :answer.type/math :answer/value "6\\,J" :db/ensure [:answer/validate]} {:db/id "answer-4e46b4a9-a4e3-5f5f-80ed-268038e11e48" :answer/id #uuid "4e46b4a9-a4e3-5f5f-80ed-268038e11e48" :answer/type :answer.type/math :answer/value "9\\,J" :db/ensure [:answer/validate]} {:db/id "question-2dec6491-4f2e-5985-9f0d-5f140c0cfaf3" :question/id #uuid "2dec6491-4f2e-5985-9f0d-5f140c0cfaf3" :question/math-academy-id "q-163713" :question/problem "A particle $P$ of mass $4\\,kg$ moves along the $x$-axis from rest at the origin with an acceleration of magnitude $\\frac{1}{t+1}\\,{m/s}^{2},$ where the acceleration acts in the direction of increasing $x,$ and $t\\ge 0$ is the time in seconds. Calculate the change in kinetic energy of the particle between the times $t=1\\,s$ and $t=3\\,s.$" :question/worked-solution "The change in kinetic energy of a particle with mass $m,$ initial velocity ${v}_{0},$ and final velocity ${v}_{1}$ is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}.\n$$\n\nWhen the mass and velocity are measured in kilograms and meters per second, respectively, the particle's kinetic energy is measured in Joules ($J$).\n\nFirst, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\ v(t) & =\\int \\frac{1}{t+1}\\,\\text{d}t \\\\ v(t) & =\\operatorname{ln}⁡|t+1|+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(0)=0.$ Substituting this into the above gives\n\n$$\n0=\\operatorname{ln}⁡|0+1|+C\\,⟹\\,C=0.\n$$\n\nHence, the velocity of the particle at time $t$ is $v(t)=\\operatorname{ln}⁡|t+1|.$ In particular, its inital velocity at time $t=1\\,s$ and final velocity at time $t=3\\,s$ are\n\n$$\n\\begin{aligned}{v}_{0} & =v(1)=\\operatorname{ln}⁡|1+1|=\\operatorname{ln}⁡2\\,m/s, \\\\ {v}_{1} & =v(3)=\\operatorname{ln}⁡|3+1|=2\\operatorname{ln}⁡2\\,m/s.\\end{aligned}\n$$\n\nTherefore, the change in kinetic energy of the particle between these times is\n\n$$\n\\begin{aligned}Δ\\,\\text{KE} & =\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2} \\\\  & =\\frac{1}{2}\\cdot 4\\cdot {(2\\operatorname{ln}⁡2)}^{2}-\\frac{1}{2}\\cdot 4\\cdot {(\\operatorname{ln}⁡2)}^{2} \\\\  & =8{ln}^{2}⁡2-2{ln}^{2}⁡2 \\\\  & =6{ln}^{2}⁡(2)\\,J.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d1a23531-d7b7-5e92-b4ab-f45652f32a5c"] :db/ensure [:question/validate]} {:db/id "answer-field-d1a23531-d7b7-5e92-b4ab-f45652f32a5c" :answer-field/id #uuid "d1a23531-d7b7-5e92-b4ab-f45652f32a5c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bca90054-3073-5e42-9916-d9655036d407" :answer-field/choices ["answer-0fd6aeb4-c566-5a88-9e32-388d6c8dfea3" "answer-87c5b30a-40f0-5260-b4b3-8c31092ef6f0" "answer-bca90054-3073-5e42-9916-d9655036d407" "answer-a71705a5-1eed-57a7-9c98-5053c71a7ae2" "answer-6ace19a1-23ee-5f18-97e5-036b1b6c5ceb"] :db/ensure [:answer-field/validate]} {:db/id "answer-0fd6aeb4-c566-5a88-9e32-388d6c8dfea3" :answer/id #uuid "0fd6aeb4-c566-5a88-9e32-388d6c8dfea3" :answer/type :answer.type/math :answer/value "2{ln}^{2}⁡(2)\\,J" :db/ensure [:answer/validate]} {:db/id "answer-87c5b30a-40f0-5260-b4b3-8c31092ef6f0" :answer/id #uuid "87c5b30a-40f0-5260-b4b3-8c31092ef6f0" :answer/type :answer.type/math :answer/value "4{ln}^{2}⁡(2)\\,J" :db/ensure [:answer/validate]} {:db/id "answer-bca90054-3073-5e42-9916-d9655036d407" :answer/id #uuid "bca90054-3073-5e42-9916-d9655036d407" :answer/type :answer.type/math :answer/value "6{ln}^{2}⁡(2)\\,J" :db/ensure [:answer/validate]} {:db/id "answer-a71705a5-1eed-57a7-9c98-5053c71a7ae2" :answer/id #uuid "a71705a5-1eed-57a7-9c98-5053c71a7ae2" :answer/type :answer.type/math :answer/value "\\frac{3}{2}{ln}^{2}⁡(2)\\,J" :db/ensure [:answer/validate]} {:db/id "answer-6ace19a1-23ee-5f18-97e5-036b1b6c5ceb" :answer/id #uuid "6ace19a1-23ee-5f18-97e5-036b1b6c5ceb" :answer/type :answer.type/math :answer/value "\\frac{4}{3}{ln}^{2}⁡(2)\\,J" :db/ensure [:answer/validate]} {:db/id "question-fdc532fe-5376-523b-b4c1-4852cb3ef3ca" :question/id #uuid "fdc532fe-5376-523b-b4c1-4852cb3ef3ca" :question/math-academy-id "q-163704" :question/problem "A particle $P$ of mass $8\\,kg$ moves along the $x$-axis from rest at the origin with an acceleration of magnitude $\\frac{1}{(t+1)^{2}}\\,{m/s}^{2},$ where the acceleration acts in the direction of increasing $x,$ and $t\\ge 0$ is the time in seconds. Calculate the particle's kinetic energy at time $t=3\\,s.$" :question/worked-solution "The kinetic energy of a particle with mass $m$ and velocity $v$ is given by\n\n$$\n\\text{KE}=\\frac{1}{2}m{v}^{2}.\n$$\n\nWhen the mass and velocity are measured in kilograms and meters per second, respectively, the particle's kinetic energy is measured in Joules ($J$).\n\nFirst, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\ v(t) & =\\int \\frac{1}{(t+1)^{2}}\\,\\text{d}t \\\\ v(t) & =-\\frac{1}{t+1}+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(0)=0.$ Substituting this into the above gives\n\n$$\n0=-\\frac{1}{0+1}+C\\,⟹\\,C=1.\n$$\n\nHence, the velocity of the particle at time $t$ is $v(t)=1-\\frac{1}{t+1}.$ In particular, its velocity at time $t=3\\,s$ is\n\n$$\nv=v(3)=1-\\frac{1}{3+1}=\\frac{3}{4}\\,m/s.\n$$\n\nTherefore, the kinetic energy of the particle at $t=3$ is\n\n$$\n\\begin{aligned}\\text{KE} & =\\frac{1}{2}m{v}^{2} \\\\  & =\\frac{1}{2}\\cdot 8\\cdot {(\\frac{3}{4})}^{2} \\\\  & =\\frac{1}{2}\\cdot 8\\cdot \\frac{9}{16} \\\\  & =\\frac{9}{4}\\,J.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-915e3c86-f8a0-5f78-befd-32698839d7d2"] :db/ensure [:question/validate]} {:db/id "answer-field-915e3c86-f8a0-5f78-befd-32698839d7d2" :answer-field/id #uuid "915e3c86-f8a0-5f78-befd-32698839d7d2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b234e6b8-43be-5423-be11-ece81f246d15" :answer-field/choices ["answer-6215fee1-a677-5186-a3d4-62cb7223b14c" "answer-44790b19-9ced-5d46-bcb9-825594809176" "answer-d1b9a351-f8a5-58dc-901e-b298299b5029" "answer-b60dbd39-c84e-5d27-aee9-c2f06ea806f2" "answer-b234e6b8-43be-5423-be11-ece81f246d15"] :db/ensure [:answer-field/validate]} {:db/id "answer-6215fee1-a677-5186-a3d4-62cb7223b14c" :answer/id #uuid "6215fee1-a677-5186-a3d4-62cb7223b14c" :answer/type :answer.type/math :answer/value "2\\,J" :db/ensure [:answer/validate]} {:db/id "answer-44790b19-9ced-5d46-bcb9-825594809176" :answer/id #uuid "44790b19-9ced-5d46-bcb9-825594809176" :answer/type :answer.type/math :answer/value "4\\,J" :db/ensure [:answer/validate]} {:db/id "answer-d1b9a351-f8a5-58dc-901e-b298299b5029" :answer/id #uuid "d1b9a351-f8a5-58dc-901e-b298299b5029" :answer/type :answer.type/math :answer/value "6\\,J" :db/ensure [:answer/validate]} {:db/id "answer-b60dbd39-c84e-5d27-aee9-c2f06ea806f2" :answer/id #uuid "b60dbd39-c84e-5d27-aee9-c2f06ea806f2" :answer/type :answer.type/math :answer/value "\\frac{3}{2}\\,J" :db/ensure [:answer/validate]} {:db/id "answer-b234e6b8-43be-5423-be11-ece81f246d15" :answer/id #uuid "b234e6b8-43be-5423-be11-ece81f246d15" :answer/type :answer.type/math :answer/value "\\frac{9}{4}\\,J" :db/ensure [:answer/validate]} {:db/id "question-115c519a-042d-5002-84f6-473dd06e56ff" :question/id #uuid "115c519a-042d-5002-84f6-473dd06e56ff" :question/math-academy-id "q-163709" :question/problem "A particle $P$ of mass $\\frac{3}{2}\\,kg$ moves along the $x$-axis from rest at the origin with an acceleration of magnitude $(1+2t)\\,{m/s}^{2},$ where the acceleration acts in the direction of increasing $x,$ and $t\\ge 0$ is the time in seconds. Calculate the particle's kinetic energy at time $t=2\\,s.$" :question/worked-solution "The kinetic energy of a particle with mass $m$ and velocity $v$ is given by\n\n$$\n\\text{KE}=\\frac{1}{2}m{v}^{2}.\n$$\n\nWhen the mass and velocity are measured in kilograms and meters per second, respectively, the particle's kinetic energy is measured in Joules ($J$).\n\nFirst, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\ v(t) & =\\int (1+2t)\\,\\text{d}t \\\\ v(t) & =t+{t}^{2}+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(0)=0.$ Substituting this into the above gives\n\n$$\n0=0+{0}^{2}+C\\,⟹\\,C=0.\n$$\n\nHence, the velocity of the particle at time $t$ is $v(t)=t+{t}^{2}.$ In particular, its velocity at time $t=2\\,s$ is\n\n$$\nv=v(2)=2+{2}^{2}=6\\,m/s.\n$$\n\nTherefore, the kinetic energy of the particle at $t=2$ is\n\n$$\n\\begin{aligned}\\text{KE} & =\\frac{1}{2}m{v}^{2} \\\\  & =\\frac{1}{2}\\cdot \\frac{3}{2}\\cdot {6}^{2} \\\\  & =\\frac{1}{2}\\cdot \\frac{3}{2}\\cdot 36 \\\\  & =27\\,J.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d5e2fc07-70cb-5248-ae29-9ab2d781882c"] :db/ensure [:question/validate]} {:db/id "answer-field-d5e2fc07-70cb-5248-ae29-9ab2d781882c" :answer-field/id #uuid "d5e2fc07-70cb-5248-ae29-9ab2d781882c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e23afd90-794c-56ba-9d78-eb6940eb6376" :answer-field/choices ["answer-c924bbae-ceed-5733-99b9-207c3ea0be7d" "answer-6a368a44-5bac-522d-9eaa-44cf19404a5e" "answer-e23afd90-794c-56ba-9d78-eb6940eb6376" "answer-4ec6c244-5362-5ac9-9cb2-e52010f2e97e" "answer-562735b2-f2b9-5808-9e01-b4da0083cca1"] :db/ensure [:answer-field/validate]} {:db/id "answer-c924bbae-ceed-5733-99b9-207c3ea0be7d" :answer/id #uuid "c924bbae-ceed-5733-99b9-207c3ea0be7d" :answer/type :answer.type/math :answer/value "18\\,J" :db/ensure [:answer/validate]} {:db/id "answer-6a368a44-5bac-522d-9eaa-44cf19404a5e" :answer/id #uuid "6a368a44-5bac-522d-9eaa-44cf19404a5e" :answer/type :answer.type/math :answer/value "24\\,J" :db/ensure [:answer/validate]} {:db/id "answer-e23afd90-794c-56ba-9d78-eb6940eb6376" :answer/id #uuid "e23afd90-794c-56ba-9d78-eb6940eb6376" :answer/type :answer.type/math :answer/value "27\\,J" :db/ensure [:answer/validate]} {:db/id "answer-4ec6c244-5362-5ac9-9cb2-e52010f2e97e" :answer/id #uuid "4ec6c244-5362-5ac9-9cb2-e52010f2e97e" :answer/type :answer.type/math :answer/value "32\\,J" :db/ensure [:answer/validate]} {:db/id "answer-562735b2-f2b9-5808-9e01-b4da0083cca1" :answer/id #uuid "562735b2-f2b9-5808-9e01-b4da0083cca1" :answer/type :answer.type/math :answer/value "36\\,J" :db/ensure [:answer/validate]} {:db/id 17592186180105 :question/problem "A particle $P$ of mass $3\\,kg$ moves along the $x$-axis under the action of a resultant force. The displacement of the particle is given by $({t}^{2}+t+1)\\,m,$ where $t\\ge 0$ is the time in seconds. Calculate the work done by the force between the times $t=0\\,s$ and $t=2\\,s.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nThe displacement of the particle is given by $x(t)={t}^{2}+t+1,$ where $t$ is time in seconds.\nWe find the velocity $v(t)$ of the particle by differentiating the displacement with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+t+1) \\\\  & =2t+1\\end{aligned}\n$$\n\nSo, the particle's initial velocity, at $t=0$, is\n\n$$\n{v}_{0}=v(0)=2(0)+1=1\\,m/s,\n$$\n\nand final velocity, at $t=2$, is\n\n$$\n{v}_{1}=v(2)=2(2)+1=5\\,m/s.\n$$\n\nTherefore, by the work-energy principle, the work done by the force between these times is\n\n$$\n\\begin{aligned}W & =Δ\\,\\text{KE} \\\\  & =\\frac{1}{2}\\cdot 3\\cdot {5}^{2}-\\frac{1}{2}\\cdot 3\\cdot {1}^{2} \\\\  & =\\frac{75}{2}-\\frac{3}{2} \\\\  & =36\\,J.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-26a75307-ee16-5df7-9ca9-2990c5ceb006"] :db/ensure [:question/validate]} {:db/id "answer-field-26a75307-ee16-5df7-9ca9-2990c5ceb006" :answer-field/id #uuid "26a75307-ee16-5df7-9ca9-2990c5ceb006" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c4de12ba-3316-5e1b-ac4d-ff0026c7af55" :answer-field/choices ["answer-9085cdd3-9d32-5301-8cbf-ca557b3f00d6" "answer-fab72cab-a457-504c-bec5-6f9514a2cbb6" "answer-c8dba406-896d-56df-ba18-d38eb5a20778" "answer-c4de12ba-3316-5e1b-ac4d-ff0026c7af55" "answer-93b0a24f-9f97-5f8e-ae03-d64c89bef3e8"] :db/ensure [:answer-field/validate]} {:db/id "answer-9085cdd3-9d32-5301-8cbf-ca557b3f00d6" :answer/id #uuid "9085cdd3-9d32-5301-8cbf-ca557b3f00d6" :answer/type :answer.type/math :answer/value "20\\,J" :db/ensure [:answer/validate]} {:db/id "answer-fab72cab-a457-504c-bec5-6f9514a2cbb6" :answer/id #uuid "fab72cab-a457-504c-bec5-6f9514a2cbb6" :answer/type :answer.type/math :answer/value "25\\,J" :db/ensure [:answer/validate]} {:db/id "answer-c8dba406-896d-56df-ba18-d38eb5a20778" :answer/id #uuid "c8dba406-896d-56df-ba18-d38eb5a20778" :answer/type :answer.type/math :answer/value "27\\,J" :db/ensure [:answer/validate]} {:db/id "answer-c4de12ba-3316-5e1b-ac4d-ff0026c7af55" :answer/id #uuid "c4de12ba-3316-5e1b-ac4d-ff0026c7af55" :answer/type :answer.type/math :answer/value "36\\,J" :db/ensure [:answer/validate]} {:db/id "answer-93b0a24f-9f97-5f8e-ae03-d64c89bef3e8" :answer/id #uuid "93b0a24f-9f97-5f8e-ae03-d64c89bef3e8" :answer/type :answer.type/math :answer/value "49\\,J" :db/ensure [:answer/validate]} {:db/id "question-34ad571d-a040-5724-a4dd-5d1ff6b4a0c6" :question/id #uuid "34ad571d-a040-5724-a4dd-5d1ff6b4a0c6" :question/math-academy-id "q-163674" :question/problem "A particle $P$ of mass $2\\,kg$ moves along the $x$-axis under the action of a resultant force. The displacement of the particle is given by $({t}^{3}+2)\\,m,$ where $t\\ge 0$ is the time in seconds. Calculate the work done by the force between the times $t=2\\,s$ and $t=3\\,s.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nThe displacement of the particle is given by $x(t)={t}^{3}+2,$ where $t$ is time in seconds.\nWe find the velocity $v(t)$ of the particle by differentiating the displacement with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}+2) \\\\  & =3{t}^{2}\\end{aligned}\n$$\n\nSo, the particle's initial velocity, at $t=2$, is\n\n$$\n{v}_{0}=v(2)=3(2)^{2}=12\\,m/s,\n$$\n\nand final velocity, at $t=3$, is\n\n$$\n{v}_{1}=v(3)=3(3)^{2}=27\\,m/s.\n$$\n\nTherefore, by the work-energy principle, the work done by the force between these times is\n\n$$\n\\begin{aligned}W & =Δ\\,\\text{KE} \\\\  & =\\frac{1}{2}\\cdot 2\\cdot (27)^{2}-\\frac{1}{2}\\cdot 2\\cdot (12)^{2} \\\\  & =729-144 \\\\  & =585\\,J.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9bd8f27e-7cc0-5e2f-951e-b5461e6ef25c"] :db/ensure [:question/validate]} {:db/id "answer-field-9bd8f27e-7cc0-5e2f-951e-b5461e6ef25c" :answer-field/id #uuid "9bd8f27e-7cc0-5e2f-951e-b5461e6ef25c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8cb1f837-d5d5-5a17-b24a-c680b3267dfe" :answer-field/choices ["answer-cd33b190-ed48-5fec-9293-b65a62708603" "answer-8cb1f837-d5d5-5a17-b24a-c680b3267dfe" "answer-245f5f16-c1db-52b8-93a7-c27b81880f3f" "answer-3f12cf32-2fc6-5ed9-9aec-bed26735d3c6" "answer-357620ce-cca0-59e5-a668-2ee27ee5034a"] :db/ensure [:answer-field/validate]} {:db/id "answer-cd33b190-ed48-5fec-9293-b65a62708603" :answer/id #uuid "cd33b190-ed48-5fec-9293-b65a62708603" :answer/type :answer.type/math :answer/value "530\\,J" :db/ensure [:answer/validate]} {:db/id "answer-8cb1f837-d5d5-5a17-b24a-c680b3267dfe" :answer/id #uuid "8cb1f837-d5d5-5a17-b24a-c680b3267dfe" :answer/type :answer.type/math :answer/value "585\\,J" :db/ensure [:answer/validate]} {:db/id "answer-245f5f16-c1db-52b8-93a7-c27b81880f3f" :answer/id #uuid "245f5f16-c1db-52b8-93a7-c27b81880f3f" :answer/type :answer.type/math :answer/value "625\\,J" :db/ensure [:answer/validate]} {:db/id "answer-3f12cf32-2fc6-5ed9-9aec-bed26735d3c6" :answer/id #uuid "3f12cf32-2fc6-5ed9-9aec-bed26735d3c6" :answer/type :answer.type/math :answer/value "660\\,J" :db/ensure [:answer/validate]} {:db/id "answer-357620ce-cca0-59e5-a668-2ee27ee5034a" :answer/id #uuid "357620ce-cca0-59e5-a668-2ee27ee5034a" :answer/type :answer.type/math :answer/value "735\\,J" :db/ensure [:answer/validate]} {:db/id "question-6813bd80-c67c-56a5-8d0d-2e4e5ee1b618" :question/id #uuid "6813bd80-c67c-56a5-8d0d-2e4e5ee1b618" :question/math-academy-id "q-163672" :question/problem "A particle $P$ of mass $3\\,kg$ moves along the $x$-axis under the action of a resultant force. The particle's velocity is $(3t-1)\\,m/s,$ where $t\\ge 0$ is the time in seconds. Calculate the work done by the force between the times $t=1\\,s$ and $t=3\\,s.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nThe particle's velocity is given by $v(t)=3t-1,$ where $t$ is time in seconds. So, the particle's initial velocity, at $t=1$, is\n\n$$\n{v}_{0}=v(1)=3(1)-1=2\\,m/s,\n$$\n\nand final velocity, at $t=3$, is\n\n$$\n{v}_{1}=v(3)=3(3)-1=8\\,m/s.\n$$\n\nTherefore, by the work-energy principle, the work done by the force between these times is\n\n$$\n\\begin{aligned}W & =Δ\\,\\text{KE} \\\\  & =\\frac{1}{2}\\cdot 3\\cdot (8)^{2}-\\frac{1}{2}\\cdot 3\\cdot (2)^{2} \\\\  & =96-6 \\\\  & =90\\,J.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-440ab6c6-89d8-5d73-9c6d-94b052c4135f"] :db/ensure [:question/validate]} {:db/id "answer-field-440ab6c6-89d8-5d73-9c6d-94b052c4135f" :answer-field/id #uuid "440ab6c6-89d8-5d73-9c6d-94b052c4135f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d4a04a41-69d2-572c-85f9-3f8ecf5abeb1" :answer-field/choices ["answer-b711d539-6b80-51e9-bad0-dc087d68179d" "answer-9ec9126b-bae7-5d30-87eb-6515e3d60873" "answer-cd3cb8b5-896e-5b5e-a89a-10510757b28c" "answer-d4a04a41-69d2-572c-85f9-3f8ecf5abeb1" "answer-583dd30f-780b-569e-92c3-cc4ee471b53b"] :db/ensure [:answer-field/validate]} {:db/id "answer-b711d539-6b80-51e9-bad0-dc087d68179d" :answer/id #uuid "b711d539-6b80-51e9-bad0-dc087d68179d" :answer/type :answer.type/math :answer/value "103\\,J" :db/ensure [:answer/validate]} {:db/id "answer-9ec9126b-bae7-5d30-87eb-6515e3d60873" :answer/id #uuid "9ec9126b-bae7-5d30-87eb-6515e3d60873" :answer/type :answer.type/math :answer/value "118\\,J" :db/ensure [:answer/validate]} {:db/id "answer-cd3cb8b5-896e-5b5e-a89a-10510757b28c" :answer/id #uuid "cd3cb8b5-896e-5b5e-a89a-10510757b28c" :answer/type :answer.type/math :answer/value "85\\,J" :db/ensure [:answer/validate]} {:db/id "answer-d4a04a41-69d2-572c-85f9-3f8ecf5abeb1" :answer/id #uuid "d4a04a41-69d2-572c-85f9-3f8ecf5abeb1" :answer/type :answer.type/math :answer/value "90\\,J" :db/ensure [:answer/validate]} {:db/id "answer-583dd30f-780b-569e-92c3-cc4ee471b53b" :answer/id #uuid "583dd30f-780b-569e-92c3-cc4ee471b53b" :answer/type :answer.type/math :answer/value "96\\,J" :db/ensure [:answer/validate]} {:db/id "question-d148a18c-482f-58b6-ae26-c16e793a32c1" :question/id #uuid "d148a18c-482f-58b6-ae26-c16e793a32c1" :question/math-academy-id "q-163676" :question/problem "A particle $P$ of mass $0.25\\,kg$ moves along the $x$-axis under the action of a resultant force. The displacement of the particle is given by $({t}^{4}-2{t}^{2}+2)\\,m,$ where $t\\ge 0$ is the time in seconds. Calculate the work done by the force between the times $t=1\\,s$ and $t=2\\,s.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nThe displacement of the particle is given by $x(t)={t}^{4}-2{t}^{2}+2,$ where $t$ is time in seconds.\nWe find the velocity $v(t)$ of the particle by differentiating the displacement with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{4}-2{t}^{2}+2) \\\\  & =4{t}^{3}-4t\\end{aligned}\n$$\n\nSo, the particle's initial velocity, at $t=1$, is\n\n$$\n{v}_{0}=v(1)=4(1)^{3}-4(1)=0\\,m/s,\n$$\n\nand final velocity, at $t=2$, is\n\n$$\n{v}_{1}=v(2)=4(2)^{3}-4(2)=24\\,m/s.\n$$\n\nTherefore, by the work-energy principle, the work done by the force between these times is\n\n$$\n\\begin{aligned}W & =Δ\\,\\text{KE} \\\\  & =\\frac{1}{2}\\cdot 0.25\\cdot (24)^{2}-\\frac{1}{2}\\cdot 0.25\\cdot {0}^{2} \\\\  & =72-0 \\\\  & =72\\,J.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e2a61099-7c6c-5889-a8f0-36c27d613946"] :db/ensure [:question/validate]} {:db/id "answer-field-e2a61099-7c6c-5889-a8f0-36c27d613946" :answer-field/id #uuid "e2a61099-7c6c-5889-a8f0-36c27d613946" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d47e9cdf-700c-5733-a11d-78b0ff44a038" :answer-field/choices ["answer-efd1ddb6-ca2b-5d57-8cbb-36a4723bcb03" "answer-9f10d917-ef03-5eb9-9451-45b13e37761c" "answer-dda5a39a-b3d7-53c3-a43b-5f036f3bb6db" "answer-d47e9cdf-700c-5733-a11d-78b0ff44a038" "answer-6d7dfd5d-6a26-57a3-9520-0e5f3f2556d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-efd1ddb6-ca2b-5d57-8cbb-36a4723bcb03" :answer/id #uuid "efd1ddb6-ca2b-5d57-8cbb-36a4723bcb03" :answer/type :answer.type/math :answer/value "108\\,J" :db/ensure [:answer/validate]} {:db/id "answer-9f10d917-ef03-5eb9-9451-45b13e37761c" :answer/id #uuid "9f10d917-ef03-5eb9-9451-45b13e37761c" :answer/type :answer.type/math :answer/value "120\\,J" :db/ensure [:answer/validate]} {:db/id "answer-dda5a39a-b3d7-53c3-a43b-5f036f3bb6db" :answer/id #uuid "dda5a39a-b3d7-53c3-a43b-5f036f3bb6db" :answer/type :answer.type/math :answer/value "64\\,J" :db/ensure [:answer/validate]} {:db/id "answer-d47e9cdf-700c-5733-a11d-78b0ff44a038" :answer/id #uuid "d47e9cdf-700c-5733-a11d-78b0ff44a038" :answer/type :answer.type/math :answer/value "72\\,J" :db/ensure [:answer/validate]} {:db/id "answer-6d7dfd5d-6a26-57a3-9520-0e5f3f2556d5" :answer/id #uuid "6d7dfd5d-6a26-57a3-9520-0e5f3f2556d5" :answer/type :answer.type/math :answer/value "95\\,J" :db/ensure [:answer/validate]} {:db/id "question-841964b0-d48f-583c-9b1a-d5d38816deaf" :question/id #uuid "841964b0-d48f-583c-9b1a-d5d38816deaf" :question/math-academy-id "q-163666" :question/problem "A particle $P$ of mass $4\\,kg$ moves along the $x$-axis under the action of the force of magnitude $(4{x}^{3}+6{x}^{2})\\,N$ acting in the direction of increasing $x.$ Given that distances along the $x$-axis are measured in meters, the particle is initially at the origin, and the particle has velocity $v=5\\,m/s$ at $x=2,$ find the particle's change in velocity in moving from $x=0$ to $x=2.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nFirst, we calculate the work done by the force in moving the particle from $x=0$ to $x=2:$\n\n$$\n\\begin{aligned}W & ={\\int }_{{x}_{1}}^{{x}_{2}}F(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(4{x}^{3}+6{x}^{2})\\,\\text{d}x \\\\  & ={[{x}^{4}+2{x}^{3}]}_{0}^{2} \\\\  & =16+16-0 \\\\  & =32\\,J\\end{aligned}\n$$\n\nThe particle has velocity $v=5\\,m/s$ at $x=2.$ So, we can find the velocity ${v}_{0}$ at $x=0$ using the work-energy principle:\n\n$$\n\\begin{aligned}W & =\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2} \\\\ 32 & =\\frac{1}{2}\\cdot 4\\cdot {5}^{2}-\\frac{1}{2}\\cdot 4\\cdot {v}_{0}^{2} \\\\ 32 & =50-2{v}_{0}^{2} \\\\ 2{v}_{0}^{2} & =18 \\\\ {v}_{0}^{2} & =9 \\\\ {v}_{0} & =\\pm 3.\\end{aligned}\n$$\n\nWe can disregard the negative solution since the velocity and acceleration of the particle are positive in the regions under consideration. \n\nTherefore, the velocity of the particle at $x=0$ is $3\\,m/s.$\n\nFinally, the particle's change in velocity from $x=0$ to $x=2$ is\n\n$$\n{v}_{1}-{v}_{0}=5-3=2\\,m/s.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-29c62bd1-d614-5073-873e-5b53441e5434"] :db/ensure [:question/validate]} {:db/id "answer-field-29c62bd1-d614-5073-873e-5b53441e5434" :answer-field/id #uuid "29c62bd1-d614-5073-873e-5b53441e5434" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6f79dc59-3bf2-54c9-9f6d-145c24052071" :answer-field/choices ["answer-31c287bc-7b24-588a-a540-58a1e566a1b0" "answer-6f79dc59-3bf2-54c9-9f6d-145c24052071" "answer-cc674083-0796-5e90-b9c6-07a3221072a9" "answer-76dbeeb4-610b-5130-aaee-b66603d18018" "answer-98f49da7-f783-5dd3-b704-89fad4575d51"] :db/ensure [:answer-field/validate]} {:db/id "answer-31c287bc-7b24-588a-a540-58a1e566a1b0" :answer/id #uuid "31c287bc-7b24-588a-a540-58a1e566a1b0" :answer/type :answer.type/math :answer/value "1\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-6f79dc59-3bf2-54c9-9f6d-145c24052071" :answer/id #uuid "6f79dc59-3bf2-54c9-9f6d-145c24052071" :answer/type :answer.type/math :answer/value "2\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-cc674083-0796-5e90-b9c6-07a3221072a9" :answer/id #uuid "cc674083-0796-5e90-b9c6-07a3221072a9" :answer/type :answer.type/math :answer/value "3\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-76dbeeb4-610b-5130-aaee-b66603d18018" :answer/id #uuid "76dbeeb4-610b-5130-aaee-b66603d18018" :answer/type :answer.type/math :answer/value "4\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-98f49da7-f783-5dd3-b704-89fad4575d51" :answer/id #uuid "98f49da7-f783-5dd3-b704-89fad4575d51" :answer/type :answer.type/math :answer/value "5\\,m/s" :db/ensure [:answer/validate]} {:db/id "question-e08604c1-4714-50ad-b1df-f5621c3586f5" :question/id #uuid "e08604c1-4714-50ad-b1df-f5621c3586f5" :question/math-academy-id "q-163691" :question/problem "A particle $P$ of mass $4\\,kg$ moves along the $x$-axis under the action of a force of magnitude $3{x}^{2}\\,N$ acting in the direction of increasing $x.$ Given that $x$ is measured in meters, and the particle has velocity $v=2\\,m/s$ at $x=0,$ calculate the velocity of the particle at $x=2.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nFirst, we calculate the work done by the force in moving the particle from $x=0$ to $x=2:$\n\n$$\n\\begin{aligned}W & ={\\int }_{{x}_{1}}^{{x}_{2}}F(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}3{x}^{2}\\,\\text{d}x \\\\  & ={x}^{3}{|}_{0}^{2} \\\\  & ={2}^{3}-0 \\\\  & =8\\,J\\end{aligned}\n$$\n\nThe particle has velocity $v=2\\,m/s$ at $x=0.$ So, we can find the velocity ${v}_{1}$ at $x=2$ using the work-energy principle:\n\n$$\n\\begin{aligned}W & =\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2} \\\\ 8 & =\\frac{1}{2}\\cdot 4\\cdot {v}_{1}^{2}-\\frac{1}{2}\\cdot 4\\cdot {2}^{2} \\\\ 8 & =2{v}_{1}^{2}-8 \\\\ 2{v}_{1}^{2} & =16 \\\\ {v}_{1}^{2} & =8 \\\\ {v}_{1} & =\\pm 2\\sqrt{2}.\\end{aligned}\n$$\n\nWe can disregard the negative solution since the velocity and acceleration of the particle are positive in the regions under consideration. \n\nTherefore, the velocity of the particle at $x=2$ is $2\\sqrt{2}\\,m/s.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-03c056e2-1426-5bcb-a501-ebc6f3a55d75"] :db/ensure [:question/validate]} {:db/id "answer-field-03c056e2-1426-5bcb-a501-ebc6f3a55d75" :answer-field/id #uuid "03c056e2-1426-5bcb-a501-ebc6f3a55d75" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b4ddfe8f-5177-5ba3-bcf9-6389f879b188" :answer-field/choices ["answer-b63eb1f1-da1c-50d8-9fa0-a62c1a301b08" "answer-b4ddfe8f-5177-5ba3-bcf9-6389f879b188" "answer-23a970a6-fde1-5b7d-91a5-9f491fb2d37a" "answer-4862b45c-aff1-5dd0-bdea-a37244d8264e" "answer-4f969a37-7f40-5d87-a34d-979e387d5920"] :db/ensure [:answer-field/validate]} {:db/id "answer-b63eb1f1-da1c-50d8-9fa0-a62c1a301b08" :answer/id #uuid "b63eb1f1-da1c-50d8-9fa0-a62c1a301b08" :answer/type :answer.type/math :answer/value "2\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-b4ddfe8f-5177-5ba3-bcf9-6389f879b188" :answer/id #uuid "b4ddfe8f-5177-5ba3-bcf9-6389f879b188" :answer/type :answer.type/math :answer/value "2\\sqrt{2}\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-23a970a6-fde1-5b7d-91a5-9f491fb2d37a" :answer/id #uuid "23a970a6-fde1-5b7d-91a5-9f491fb2d37a" :answer/type :answer.type/math :answer/value "4\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-4862b45c-aff1-5dd0-bdea-a37244d8264e" :answer/id #uuid "4862b45c-aff1-5dd0-bdea-a37244d8264e" :answer/type :answer.type/math :answer/value "8\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-4f969a37-7f40-5d87-a34d-979e387d5920" :answer/id #uuid "4f969a37-7f40-5d87-a34d-979e387d5920" :answer/type :answer.type/math :answer/value "\\sqrt{2}\\,m/s" :db/ensure [:answer/validate]} {:db/id 17592186180106 :question/problem "A particle $P$ of mass $2\\,kg$ moves along the $x$-axis under the action of a force of magnitude $6x\\,N$ acting in the direction of increasing $x.$ Given that $x$ is measured in meters, and the particle has velocity $v=4\\,m/s$ at $x=1,$ calculate the velocity of the particle at $x=2.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nFirst, we calculate the work done by the force in moving the particle from $x=1$ to $x=2:$\n\n$$\n\\begin{aligned}W & ={\\int }_{{x}_{1}}^{{x}_{2}}F(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}6x\\,\\text{d}x \\\\  & =3{x}^{2}{|}_{1}^{2} \\\\  & =3(4-1) \\\\  & =9\\,J\\end{aligned}\n$$\n\nThe particle has velocity $v=4\\,m/s$ at $x=1.$ So, we can find the velocity ${v}_{1}$ at $x=2$ using the work-energy principle:\n\n$$\n\\begin{aligned}W & =\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2} \\\\ 9 & =\\frac{1}{2}\\cdot 2\\cdot {v}_{1}^{2}-\\frac{1}{2}\\cdot 2\\cdot {4}^{2} \\\\ 9 & ={v}_{1}^{2}-16 \\\\ {v}_{1}^{2} & =25 \\\\ {v}_{1} & =\\pm 5.\\end{aligned}\n$$\n\nWe can disregard the negative solution since the velocity and acceleration of the particle are positive in the regions under consideration. \n\nTherefore, the velocity of the particle at $x=2$ is $5\\,m/s.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ee421f31-693d-5e9b-9b13-f8f8930e49f0"] :db/ensure [:question/validate]} {:db/id "answer-field-ee421f31-693d-5e9b-9b13-f8f8930e49f0" :answer-field/id #uuid "ee421f31-693d-5e9b-9b13-f8f8930e49f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b365bf0a-2cb2-5bc5-a6c1-23cd8ffbd67f" :answer-field/choices ["answer-b365bf0a-2cb2-5bc5-a6c1-23cd8ffbd67f" "answer-45f0d404-cb57-5e93-863a-e6e0439ae329" "answer-11a230f6-8610-57b2-a192-bbc685af3d61" "answer-f5298386-5d77-55b8-8b1f-b593564733bb" "answer-2771a33d-a580-5640-b992-3faea8d28c68"] :db/ensure [:answer-field/validate]} {:db/id "answer-b365bf0a-2cb2-5bc5-a6c1-23cd8ffbd67f" :answer/id #uuid "b365bf0a-2cb2-5bc5-a6c1-23cd8ffbd67f" :answer/type :answer.type/math :answer/value "5\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-45f0d404-cb57-5e93-863a-e6e0439ae329" :answer/id #uuid "45f0d404-cb57-5e93-863a-e6e0439ae329" :answer/type :answer.type/math :answer/value "6\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-11a230f6-8610-57b2-a192-bbc685af3d61" :answer/id #uuid "11a230f6-8610-57b2-a192-bbc685af3d61" :answer/type :answer.type/math :answer/value "\\frac{11}{2}\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-f5298386-5d77-55b8-8b1f-b593564733bb" :answer/id #uuid "f5298386-5d77-55b8-8b1f-b593564733bb" :answer/type :answer.type/math :answer/value "\\frac{16}{3}\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-2771a33d-a580-5640-b992-3faea8d28c68" :answer/id #uuid "2771a33d-a580-5640-b992-3faea8d28c68" :answer/type :answer.type/math :answer/value "\\frac{9}{2}\\,m/s" :db/ensure [:answer/validate]} {:db/id "question-a80bea3f-8cb9-59ff-8c63-3325a8f0a338" :question/id #uuid "a80bea3f-8cb9-59ff-8c63-3325a8f0a338" :question/math-academy-id "q-163703" :question/problem "A particle $P$ of mass $\\frac{1}{2}\\,kg$ moves along the $x$-axis under the action of the force of magnitude $(3-\\frac{1}{{x}^{2}})\\,N$ acting in the direction of increasing $x.$ Given that distances along the $x$-axis are measured in meters, the particle is initially at $x=1,$ and the particle has velocity $v=7\\,m/s$ at $x=4,$ find the particle's change in velocity in moving from $x=1$ to $x=4.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nFirst, we calculate the work done by the force in moving the particle from $x=1$ to $x=4:$\n\n$$\n\\begin{aligned}W & ={\\int }_{{x}_{1}}^{{x}_{2}}F(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}(3-\\frac{1}{{x}^{2}})\\,\\text{d}x \\\\  & ={[3x+\\frac{1}{x}]}_{1}^{4} \\\\  & =(12+\\frac{1}{4})-(3+1) \\\\  & =\\frac{33}{4}\\,J\\end{aligned}\n$$\n\nThe particle has velocity $v=7\\,m/s$ at $x=4.$ So, we can find the velocity ${v}_{0}$ at $x=1$ using the work-energy principle:\n\n$$\n\\begin{aligned}W & =\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2} \\\\ \\frac{33}{4} & =\\frac{1}{2}\\cdot \\frac{1}{2}\\cdot {7}^{2}-\\frac{1}{2}\\cdot \\frac{1}{2}\\cdot {v}_{0}^{2} \\\\ \\frac{33}{4} & =\\frac{49}{4}-\\frac{1}{4}{v}_{0}^{2} \\\\ \\frac{1}{4}{v}_{0}^{2} & =4 \\\\ {v}_{0}^{2} & =16 \\\\ {v}_{0} & =\\pm 4.\\end{aligned}\n$$\n\nWe can disregard the negative solution since the velocity and acceleration of the particle are positive in the regions under consideration. \n\nTherefore, the velocity of the particle at $x=1$ is $4\\,m/s.$\n\nFinally, the particle's change in velocity from $x=1$ to $x=4$ is\n\n$$\n{v}_{1}-{v}_{0}=7-4=3\\,m/s.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a9005e61-607d-5045-aa66-20814a697f93"] :db/ensure [:question/validate]} {:db/id "answer-field-a9005e61-607d-5045-aa66-20814a697f93" :answer-field/id #uuid "a9005e61-607d-5045-aa66-20814a697f93" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a42ed274-a649-5401-8272-60c7780ed481" :answer-field/choices ["answer-70095663-b0c7-5784-aa18-5da9b912ed20" "answer-542437df-028e-59d6-ae86-f7227217dfb1" "answer-a42ed274-a649-5401-8272-60c7780ed481" "answer-673d5641-d0ad-5ff6-a052-0f9b30a96ae7" "answer-4688ab13-3768-5564-a3fb-bdcb6748fe3d"] :db/ensure [:answer-field/validate]} {:db/id "answer-70095663-b0c7-5784-aa18-5da9b912ed20" :answer/id #uuid "70095663-b0c7-5784-aa18-5da9b912ed20" :answer/type :answer.type/math :answer/value "1\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-542437df-028e-59d6-ae86-f7227217dfb1" :answer/id #uuid "542437df-028e-59d6-ae86-f7227217dfb1" :answer/type :answer.type/math :answer/value "2\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-a42ed274-a649-5401-8272-60c7780ed481" :answer/id #uuid "a42ed274-a649-5401-8272-60c7780ed481" :answer/type :answer.type/math :answer/value "3\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-673d5641-d0ad-5ff6-a052-0f9b30a96ae7" :answer/id #uuid "673d5641-d0ad-5ff6-a052-0f9b30a96ae7" :answer/type :answer.type/math :answer/value "\\frac{5}{4}\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-4688ab13-3768-5564-a3fb-bdcb6748fe3d" :answer/id #uuid "4688ab13-3768-5564-a3fb-bdcb6748fe3d" :answer/type :answer.type/math :answer/value "\\frac{7}{2}\\,m/s" :db/ensure [:answer/validate]} {:db/id 17592186180107 :question/problem "A particle $P$ of mass $1\\,kg$ moves along the $x$-axis under the action of the force of magnitude $(3{x}^{2}+1)\\,N$ acting in the direction of increasing $x.$ Given that $x$ is measured in meters, the particle was initially at the origin, and the particle has velocity $v=4\\,m/s$ at $x=1,$ calculate the particle's initial velocity." :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nFirst, we calculate the work done by the force in moving the particle from $x=0$ to $x=1:$\n\n$$\n\\begin{aligned}W & ={\\int }_{{x}_{1}}^{{x}_{2}}F(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(3{x}^{2}+1)\\,\\text{d}x \\\\  & ={x}^{3}+x{|}_{0}^{1} \\\\  & =1+1-0 \\\\  & =2\\,J\\end{aligned}\n$$\n\nThe particle has velocity $v=4\\,m/s$ at $x=1.$ So, we can find the velocity ${v}_{0}$ at $x=0$ using the work-energy principle:\n\n$$\n\\begin{aligned}W & =\\frac{1}{2}{m}_{1}{v}^{2}-\\frac{1}{2}m{v}_{0}^{2} \\\\ 2 & =\\frac{1}{2}\\cdot 1\\cdot {4}^{2}-\\frac{1}{2}\\cdot 1\\cdot {v}_{0}^{2} \\\\ 2 & =8-\\frac{1}{2}{v}_{0}^{2} \\\\ \\frac{1}{2}{v}_{0}^{2} & =6 \\\\ {v}_{0}^{2} & =12 \\\\ {v}_{0} & =\\pm 2\\sqrt{3}.\\end{aligned}\n$$\n\nWe can disregard the negative solution since the velocity and acceleration of the particle are positive in the regions under consideration. \n\nTherefore, the velocity of the particle at $x=0$ is $2\\sqrt{3}\\,m/s.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-685ebe43-4362-5e9f-b513-b366e7e5ddc5"] :db/ensure [:question/validate]} {:db/id "answer-field-685ebe43-4362-5e9f-b513-b366e7e5ddc5" :answer-field/id #uuid "685ebe43-4362-5e9f-b513-b366e7e5ddc5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-86e20970-7c3b-5405-aba7-818b64498280" :answer-field/choices ["answer-5af78eb7-b0ac-5fb4-8298-83843c06cabd" "answer-86e20970-7c3b-5405-aba7-818b64498280" "answer-c6037124-9ca8-59a2-a5ba-448ad5035b07" "answer-c6e877fb-7b90-52aa-a3a8-3a656bf7b8f5" "answer-7a400848-d283-509d-b2ce-69f7f8a4002f"] :db/ensure [:answer-field/validate]} {:db/id "answer-5af78eb7-b0ac-5fb4-8298-83843c06cabd" :answer/id #uuid "5af78eb7-b0ac-5fb4-8298-83843c06cabd" :answer/type :answer.type/math :answer/value "2\\sqrt{2}\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-86e20970-7c3b-5405-aba7-818b64498280" :answer/id #uuid "86e20970-7c3b-5405-aba7-818b64498280" :answer/type :answer.type/math :answer/value "2\\sqrt{3}\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-c6037124-9ca8-59a2-a5ba-448ad5035b07" :answer/id #uuid "c6037124-9ca8-59a2-a5ba-448ad5035b07" :answer/type :answer.type/math :answer/value "3\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-c6e877fb-7b90-52aa-a3a8-3a656bf7b8f5" :answer/id #uuid "c6e877fb-7b90-52aa-a3a8-3a656bf7b8f5" :answer/type :answer.type/math :answer/value "3\\sqrt{2}\\,m/s" :db/ensure [:answer/validate]} {:db/id "answer-7a400848-d283-509d-b2ce-69f7f8a4002f" :answer/id #uuid "7a400848-d283-509d-b2ce-69f7f8a4002f" :answer/type :answer.type/math :answer/value "4\\,m/s" :db/ensure [:answer/validate]} {:db/id 17592186180764 :tutorial/content "In this lesson, we'll discuss the concepts of **work** and **kinetic energy** and describe how these concepts are related. \n\nThe **work done by the force** $F=F(x)$ in moving a particle from the position $x=x_1$ to the position $x=x_2$ along the $x$-axis is defined as\n\n$$\nW = \\int_{x_1}^{x_2} F(x) \\,\\textrm{d}x.\n$$\n\nWhen the force and distance are measured in Newtons ($\\textrm{N}$) and meters ($\\textrm{m}$), respectively, the work done by the force is measured in Joules ($\\rm{J}$).\n\nFor example, suppose a particle $P$ is moving along the $x$-axis under the action of a force of magnitude $4x^3\\,\\textrm{N},$ acting in the direction of increasing $x,$ as shown below. Distances along the $x$-axis are measured in meters.\n\n![](images/3f/3f0040d7a71563304cb954908988c82df1774a1197a5ce16c74a3b8ac65e04a0.png)\n\n \n\nLet's calculate the work done by the force in moving the particle from $x=1$ to $x=2.$\n\nSubstituting the given values into our formula, we obtain\n\n$$\n\\begin{aligned}W & ={\\int }_{1}^{2}4{x}^{3}\\,\\text{d}x \\\\  & ={x}^{4}\\,{|}_{1}^{2} \\\\  & =16-1 \\\\  & =15\\,J.\\end{aligned}\n$$\n\nTherefore, the work done by $F$ in moving $P$ from $x_1=1\\,\\textrm m$ to $x_2=2\\,\\textrm m$ equals $15\\,\\textrm J.$\n\nWe can use the concept of work in conjunction with Newton's second law. Let's see an example." :db/ensure [:tutorial/validate]} {:db/id 17592186180766 :tutorial/content "The **work-energy principle** states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW = \\Delta\\, \\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\n\\Delta\\, \\text{KE} = \\dfrac12 m v_1^2 - \\dfrac12 m v_0^2\n$$\n\nand $m$ is the particle's mass, $v_0$ is its initial velocity, and $v_1$ is its final velocity." :db/ensure [:tutorial/validate]} {:db/id 17592186179842 :activity/expected-seconds 1080.0 :db/ensure [:activity/validate]}]
