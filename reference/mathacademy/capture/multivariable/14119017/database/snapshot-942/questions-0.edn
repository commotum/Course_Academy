 #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14J" :db/id #edb/ref 17592186178278} {:answer/id #uuid "705d3e54-8fb0-5ab8-b646-c8b7d5c0c667" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16J" :db/id #edb/ref 17592186178279} {:answer/id #uuid "7bcb48da-1969-572c-811b-7b9421e3fd3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12J" :db/id #edb/ref 17592186178280}] :answer-field/id #uuid "fa79a852-7933-50c1-8e60-5c43ead054f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178275}] :question/id #uuid "babebacc-c620-5336-84f2-4d7aa7dcc6d8" :question/math-academy-id "q-163598" :question/problem "A particle $P$ of mass $2kg$ moves along the $x$-axis from rest at the origin with an acceleration of magnitude $2tm/s^{2}$, where the acceleration acts in the direction of increasing $x$, and $t \\ge 0$ is the time in seconds. Calculate the particle's kinetic energy at time $t = 2s$."}] [{:db/id #edb/ref 17592186180105 :knowledge-point/_questions [{:db/id #edb/ref 17592186179779 :knowledge-point/id #uuid "94904fa2-bf02-5486-950c-979a4d12998e" :knowledge-point/title "Applying the Work-Energy Principle To Find the Work Done by a Force"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9df22e30-1b2f-5c18-a7fe-a7be5f1b8885" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36J" :db/id #edb/ref 17592186178300} {:answer/id #uuid "bdb34d99-42e0-54b9-9c21-280b28a37857" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20J" :db/id #edb/ref 17592186178301} {:answer/id #uuid "cb5b140a-60cf-5cf2-9e20-1f0817120212" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25J" :db/id #edb/ref 17592186178302} {:answer/id #uuid "ce23d63c-bb7d-542f-97c1-7ddc64a45394" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49J" :db/id #edb/ref 17592186178303} {:answer/id #uuid "0d225512-d29c-55c9-81ee-3ca1ed789e2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27J" :db/id #edb/ref 17592186178304}] :answer-field/id #uuid "a3ef2f1d-303e-5a18-8c46-581a2ecef6e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178299}] :question/id #uuid "93920b26-fb04-52d5-8d58-1e17f6af55c8" :question/math-academy-id "q-163663" :question/problem "A particle $P$ of mass $3kg$ moves along the $x$-axis under the action of a resultant force. The displacement of the particle is given by $(t^{2} + t + 1)m$, where $t \\ge 0$ is the time in seconds. Calculate the work done by the force between the times $t = 0s$ and $t = 2s$."}] [{:db/id #edb/ref 17592186180106 :knowledge-point/_questions [{:db/id #edb/ref 17592186179780 :knowledge-point/id #uuid "793154ca-29f0-5552-97cd-57acbc915966" :knowledge-point/title "Applying the Work-Energy Principle to Find a Particle's Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6edf4f6-1885-5b53-9e12-c7abb0e9600d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{3}m/s" :db/id #edb/ref 17592186178306} {:answer/id #uuid "defefd03-a7eb-5bd7-9a24-0c43f31b8683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5m/s" :db/id #edb/ref 17592186178307} {:answer/id #uuid "e808f59d-5b3d-5f55-a3ff-8ccca587e929" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}m/s" :db/id #edb/ref 17592186178308} {:answer/id #uuid "18014b62-033a-5d58-9a82-e37a09a3e15d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6m/s" :db/id #edb/ref 17592186178309} {:answer/id #uuid "7b673abf-7603-53dc-82c8-e6bd126f4613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{2}m/s" :db/id #edb/ref 17592186178310}] :answer-field/id #uuid "fa43f512-c94b-5eb7-b9e5-51cfd25c0d2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178305}] :question/id #uuid "4f5f6801-1e10-5d42-880a-19ee72d417ff" :question/math-academy-id "q-163665" :question/problem "A particle $P$ of mass $2kg$ moves along the $x$-axis under the action of a force of magnitude $6xN$ acting in the direction of increasing $x$. Given that $x$ is measured in meters, and the particle has velocity $v = 4m/s$ at $x = 1$, calculate the velocity of the particle at $x = 2$."}] [{:db/id #edb/ref 17592186180107 :knowledge-point/_questions [{:db/id #edb/ref 17592186179780 :knowledge-point/id #uuid "793154ca-29f0-5552-97cd-57acbc915966" :knowledge-point/title "Applying the Work-Energy Principle to Find a Particle's Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93d26a44-76f8-586e-b542-ca960eb49f11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}m/s" :db/id #edb/ref 17592186178312} {:answer/id #uuid "aeaacaa4-cd1d-5017-a778-1502320eb560" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}m/s" :db/id #edb/ref 17592186178313} {:answer/id #uuid "de6745c8-b202-5262-80e4-fd8ce298c327" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3m/s" :db/id #edb/ref 17592186178314} {:answer/id #uuid "26fc69d3-fd67-58e6-a94d-df8981172efc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4m/s" :db/id #edb/ref 17592186178315} {:answer/id #uuid "700a84e9-e414-535d-ab79-e1f858bb5e6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}m/s" :db/id #edb/ref 17592186178316}] :answer-field/id #uuid "3dfa71ac-63f9-5b61-94cb-4024690be378" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178311}] :question/id #uuid "6c1be8fb-89db-5bdf-8f42-bf7da0962b48" :question/math-academy-id "q-163667" :question/problem "A particle $P$ of mass $1kg$ moves along the $x$-axis under the action of the force of magnitude $(3x^{2} + 1)N$ acting in the direction of increasing $x$. Given that $x$ is measured in meters, the particle was initially at the origin, and the particle has velocity $v = 4m/s$ at $x = 1$, calculate the particle's initial velocity."}] [{:db/id #edb/ref 17592186389435 :knowledge-point/_questions [{:db/id #edb/ref 17592186179779 :knowledge-point/id #uuid "94904fa2-bf02-5486-950c-979a4d12998e" :knowledge-point/title "Applying the Work-Energy Principle To Find the Work Done by a Force"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70f35aeb-2053-5b37-abce-48d3972b397c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\,J" :db/id #edb/ref 17592186389437} {:answer/id #uuid "24f06dbe-e866-519e-8599-01c0ead2742e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,J" :db/id #edb/ref 17592186389438} {:answer/id #uuid "7a155385-200c-550f-96bf-08d5a75d20fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,J" :db/id #edb/ref 17592186389439} {:answer/id #uuid "318dfa74-61f2-571e-8498-0ef0bc26ce59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17\\,J" :db/id #edb/ref 17592186389440} {:answer/id #uuid "156b8685-b780-52be-a010-0b4b0806771e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,J" :db/id #edb/ref 17592186389441}] :answer-field/correct {:answer/id #uuid "156b8685-b780-52be-a010-0b4b0806771e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,J" :db/id #edb/ref 17592186389441} :answer-field/id #uuid "c13537c9-cba9-528c-81df-ec823b958306" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389436}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8305d2ef-8fb9-5f80-b2fe-3b5b2380f4bf" :question/math-academy-id "q-163671" :question/problem "A particle $P$ of mass $1\\,kg$ moves along the $x$-axis under the action of a resultant force. The particle's velocity is $(t+1)\\,m/s,$ where $t\\ge 0$ is the time in seconds. Calculate the work done by the force between the times $t=2\\,s$ and $t=4\\,s.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nThe particle's velocity is given by $v(t)=t+1,$ where $t$ is time in seconds. So, the particle's initial velocity, at $t=2$, is\n\n$$\n{v}_{0}=v(2)=2+1=3\\,m/s,\n$$\n\nand final velocity, at $t=4$, is\n\n$$\n{v}_{1}=v(4)=4+1=5\\,m/s.\n$$\n\nTherefore, by the work-energy principle, the work done by the force between these times is\n\n$$\n\\begin{aligned}W & =Δ\\,\\text{KE} \\\\  & =\\frac{1}{2}\\cdot 1\\cdot (5)^{2}-\\frac{1}{2}\\cdot 1\\cdot (3)^{2} \\\\  & =\\frac{25}{2}-\\frac{9}{2} \\\\  & =8\\,J.\\end{aligned}\n$$"}]}
