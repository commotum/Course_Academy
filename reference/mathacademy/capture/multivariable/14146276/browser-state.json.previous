      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14146276/observations/step-q163204-3b9beb1c286d6087316e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14146276/observations/step-q163204-3b9beb1c286d6087316e.png",
      "source_url": "https://mathacademy.com/tasks/14146276/topics/2027/review",
