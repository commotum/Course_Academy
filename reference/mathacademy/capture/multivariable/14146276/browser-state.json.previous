      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14146276/observations/step-q162905-56fcd772a1a8c0a50d7a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14146276/observations/step-q162905-56fcd772a1a8c0a50d7a.png",
      "source_url": "https://mathacademy.com/tasks/14146276/topics/2027/review",
      "captured_at": 1791832879.0892015,
      "math_academy_id": "q-162905",
      "topic_id": "2027",
      "sequence_position": null,
