e/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186163868} {:answer/id #uuid "602bdb6d-95e4-538b-b0ed-dcf372ecf31a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186163869}] :answer-field/id #uuid "15b2ef6c-c409-5bdc-8c17-bfe2e3100c8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163864}] :question/id #uuid "9d42bef6-ce15-55df-885d-72410b164f1c" :question/math-academy-id "q-162146" :question/problem "Consider the vector field $F(x, y, z) = ⟨x, y, z + 3⟩$ and a finite region $S$ of the plane $z = x + y$ such that $Area(S) = \\sqrt{3}$. Calculate the flux of $F$ through $S$ with respect to the upward-pointing unit normal vector $n$."}] [{:db/id #edb/ref 17592186323829 :knowledge-point/_questions [{:db/id #edb/ref 17592186166881 :knowledge-point/id #uuid "3da3cc4f-0a1d-5639-b580-95eabc198d2a" :knowledge-point/title "Computing the Flux of a Vector Field Through a Horizontal Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2675eb0f-c25d-53b2-81e3-8fb563f36009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186321447} {:answer/id #uuid "78932147-1c07-5243-a33b-54ccc3b3d246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186322095} {:answer/id #uuid "c5320cee-9b68-5526-9f7b-e4e81b3395ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186322678} {:answer/id #uuid "d670b8fa-5cf4-557e-9b86-650409c1e001" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186322820} {:answer/id #uuid "db414795-e6be-52ec-a2e8-11da08ea2311" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186322865}] :answer-field/correct {:answer/id #uuid "db414795-e6be-52ec-a2e8-11da08ea2311" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186322865} :answer-field/id #uuid "5f36e3b8-2489-5327-a723-3c371eeae8a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323358}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7134c822-9a7e-5b0a-ae0e-9d8056e17711" :question/math-academy-id "q-365879" :question/problem "Consider the vector field $F(x,y,z)=⟨z,\\,y,\\,4x⟩$ and the surface $S$ defined in Cartesian coordinates as $z=4$ for $0\\le x\\le 1$ and $0\\le y\\le 3.$ Calculate the flux of $F$ through $S$ with respect to the upward-pointing unit normal vector $n.$" :question/worked-solution "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nFor the surface $z=4$ for $0\\le x\\le 1$ and $0\\le y\\le 3,$ the upward-pointing unit normal vector is\n\n$$\nn=⟨0,\\,0,\\,1⟩.\n$$\n\nUsing the fact that $z=4$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨z,\\,y,\\,4x⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =⟨4,\\,y,\\,4x⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =4x.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}4x\\,\\text{d}S \\\\  & ={∬}_{D}4x\\,\\text{d}A \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{1}4x\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}\\text{d}y{\\int }_{0}^{1}4x\\,\\text{d}x \\\\  & =3\\cdot {[2{x}^{2}]}_{0}^{1} \\\\  & =6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186370853 :knowledge-point/_questions [{:db/id #edb/ref 17592186166881 :knowledge-point/id #uuid "3da3cc4f-0a1d-5639-b580-95eabc198d2a" :knowledge-point/title "Computing the Flux of a Vector Field Through a Horizontal Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fe33c2d-28d8-5c63-af57-2cfea02124a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186370855} {:answer/id #uuid "b144a61b-6449-5a95-93b2-5ecb54d3aff5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186370856} {:answer/id #uuid "c39ce534-8261-5bb2-a3a7-9565f1b35ea6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186370857} {:answer/id #uuid "f6599dfa-b736-51b0-a238-88ebd55fb5ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-72" :db/id #edb/ref 17592186370858} {:answer/id #uuid "da68bb0d-4fa0-572e-849a-ab56c69bc8e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186370859}] :answer-field/correct {:answer/id #uuid "3fe33c2d-28d8-5c63-af57-2cfea02124a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186370855} :answer-field/id #uuid "5b73cc72-c77c-588f-8710-d900af9a9255" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186370854}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3c5b1199-265f-51a1-b6b8-07c045672fdb" :question/math-academy-id "q-365884" :question/problem "Consider the vector field $F(x,y,z)=⟨z,\\,z,\\,4xy⟩$ and the surface $S$ defined in Cartesian coordinates as $z=2$ for $0\\le x\\le 2$ and $0\\le y\\le 3.$ Calculate the flux of $F$ through $S$ with respect to the *downward*-pointing unit normal vector $n.$" :question/worked-solution "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is a continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nFor the surface $z=2$ for $0\\le x\\le 2$ and $0\\le y\\le 3,$ the downward-pointing unit normal vector is\n\n$$\nn=⟨0,\\,0,\\,-1⟩.\n$$\n\nUsing the fact that $z=2$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨z,\\,z,\\,4xy⟩\\cdot ⟨0,\\,0,\\,-1⟩ \\\\  & =-4xy.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}(-4xy)\\,\\text{d}S \\\\  & ={∬}_{D}(-4xy)\\,\\text{d}A \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}(-4xy)\\,\\text{d}x\\,\\text{d}y \\\\  & =-{\\int }_{0}^{3}2y\\,\\text{d}y{\\int }_{0}^{2}2x\\,\\text{d}x \\\\  & =-{[{y}^{2}]}_{0}^{3}\\cdot {[{x}^{2}]}_{0}^{2} \\\\  & =-36\\end{aligned}\n$$"}]}
