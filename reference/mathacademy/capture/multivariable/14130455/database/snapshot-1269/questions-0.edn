#{[{:db/id #edb/ref 17592186259608 :knowledge-point/_questions [{:db/id #edb/ref 17592186179733 :knowledge-point/id #uuid "2fd19952-77af-5f27-a7ef-adf46b1958ae" :knowledge-point/title "Orientation-Dependence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "075ffae1-ea68-5f4d-bb63-f49b56d8e6b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Impossible to determine" :db/id #edb/ref 17592186256845} {:answer/id #uuid "51a75927-20c3-52d1-a64d-8ec72f7cabd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257476} {:answer/id #uuid "645886ef-4aa0-5f2b-bb93-dc06146a70f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186257662} {:answer/id #uuid "7afaaf8e-21fa-551e-b15c-0317c5d6ef18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257872} {:answer/id #uuid "99fb9ef2-4ee0-53a2-a318-7d1eb71ac286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186258136}] :answer-field/correct {:answer/id #uuid "51a75927-20c3-52d1-a64d-8ec72f7cabd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257476} :answer-field/id #uuid "cb49f773-46c7-535f-a9e1-dc1765ec0827" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259390}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "42bfa60d-7b26-5dc6-9634-a2e58886024d" :question/math-academy-id "q-124179" :question/problem "If ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y=3$ and ${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y=5,$ calculate ${\\int }_{C}f(x,y)\\,\\text{d}y$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $y,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}y=-{\\int }_{C}f(x,y)\\,\\text{d}y$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y \\\\  & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y \\\\  & =-3+5 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259650 :knowledge-point/_questions [{:db/id #edb/ref 17592186179731 :knowledge-point/id #uuid "79e281dd-40c0-515a-a5d5-d063609ecf73" :knowledge-point/title "Line Integrals of Unity With Respect to X"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2271c2f3-6a0e-52db-a073-7c6e91fd8bbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186257064} {:answer/id #uuid "7a614516-aa62-5836-8581-97092175214f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186257865} {:answer/id #uuid "7f262654-5960-5b84-bd60-37392d856cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257916} {:answer/id #uuid "f2324693-6303-570a-a9ea-853d9ea6b405" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\pi }{2}" :db/id #edb/ref 17592186258889} {:answer/id #uuid "f35b33e2-0c6e-55fd-902a-35519905732a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186258903}] :answer-field/correct {:answer/id #uuid "7f262654-5960-5b84-bd60-37392d856cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257916} :answer-field/id #uuid "a181e6a4-7e9b-5c76-a47e-43a0425e674b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259316}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5026f273-e6ca-5d94-86d8-dd1bd2a406be" :question/math-academy-id "q-124281" :question/problem "![](images/6b/6b095a29b433107c37cd7e28c853d9d3d3547fb64a9e874783206b86c0aca6c1.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}x,$ where $C$ is the path along a quarter circle of radius $3,$ traversed from the point $(1,-3)$ to the point $(4,0),$ shown above." :question/worked-solution "The line integral of unity with respect to $x$ along a path $C$ is equal to the net change in $x$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}x={x}_{2}-{x}_{1},\n$$\n\nwhere ${x}_{2}$ is the $x$-coordinate of the terminal point, and ${x}_{1}$ is the $x$-coordinate of the initial point.\n\nIn our case, ${x}_{2}=4$ and ${x}_{1}=1.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}x={x}_{2}-{x}_{1}=4-1=3.\n$$"}] [{:db/id #edb/ref 17592186259672 :knowledge-point/_questions [{:db/id #edb/ref 17592186179732 :knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f" :knowledge-point/title "Line Integrals of Unity With Respect to Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55c54a1b-25be-5636-b467-f5ac1a9b52a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186257520} {:answer/id #uuid "90ca79dc-a39f-5a16-a0bb-06f5058a2325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258059} {:answer/id #uuid "90fced00-d179-5243-b71b-5f2af240f1e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5+5\\sqrt{2}" :db/id #edb/ref 17592186258062} {:answer/id #uuid "f4d9b801-9124-53be-9f21-3845b38cdb84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258919} {:answer/id #uuid "f8d92c55-a2da-5101-b6a0-b111b36b6752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186258966}] :answer-field/correct {:answer/id #uuid "f4d9b801-9124-53be-9f21-3845b38cdb84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258919} :answer-field/id #uuid "4daa3094-63d7-51fd-af1c-c3ff26a2ec4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259167}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6bbf9141-617f-5455-b7c6-ab9b0397e741" :question/math-academy-id "q-124336" :question/problem "![](images/cb/cbef822c90e494cbe75e4a0b4ef93b058fccdd0111ec997f13930b1dba44406d.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}y,$ where $C={C}_{1}\\cup {C}_{2}$ is the path comprising of two line segments, as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, ${y}_{2}=0$ and ${y}_{1}=-1.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1}=0-(-1)=1.\n$$"}]}
