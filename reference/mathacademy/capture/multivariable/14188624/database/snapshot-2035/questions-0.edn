#{[{:db/id #edb/ref 17592186172655 :knowledge-point/_questions [{:db/id #edb/ref 17592186172044 :knowledge-point/id #uuid "eb1745c5-6485-5a9d-9e8f-19492928e4b4" :knowledge-point/title "Finding the Position Function of an Object Moving With Circular Motion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81a7ebf9-894b-512c-ade6-11db4dee9ac5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t) =-3(\\cos 2πti - \\sin 2πtj)" :db/id #edb/ref 17592186171556} {:answer/id #uuid "c73acc69-9eab-579c-9321-9e46172221d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t) = 3(\\cos 2πti + \\sin 2πtj)" :db/id #edb/ref 17592186171557} {:answer/id #uuid "26ddf116-f9ad-5102-8e17-0718d07a489d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t) = 3(\\cos 2πti - \\sin 2πtj)" :db/id #edb/ref 17592186171558} {:answer/id #uuid "5e362178-a2f5-5410-b6c9-e7a88ad6ca26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t) =-2(\\cos 3πti + \\sin 3πtj)" :db/id #edb/ref 17592186171559} {:answer/id #uuid "76391cf1-9137-5b3e-aada-607bd1e04a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t) = 2(\\cos 3πti - \\sin 3πtj)" :db/id #edb/ref 17592186171560}] :answer-field/id #uuid "fa2448a5-0101-5a28-982e-8f121a6f37a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171555}] :question/id #uuid "297d89f1-479f-5e7e-834d-0ffc08d592cd" :question/math-academy-id "q-97586" :question/problem "A particle moves along a **clockwise** circular path with center $O$ in the $xy$-plane with a constant angular velocity of $2πrad/s$. Given that the object is at the position $(3, 0)$ when $t = 0$, find the position function of the particle."}] [{:db/id #edb/ref 17592186362221 :knowledge-point/_questions [{:db/id #edb/ref 17592186172044 :knowledge-point/id #uuid "eb1745c5-6485-5a9d-9e8f-19492928e4b4" :knowledge-point/title "Finding the Position Function of an Object Moving With Circular Motion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cd02180-7f22-5f61-93c7-fff08cd0fa7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=4(\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j)" :db/id #edb/ref 17592186360952} {:answer/id #uuid "3ad8a471-2d04-5600-9388-bfbdf3391f3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=\\operatorname{cos}⁡4t\\,i+\\operatorname{sin}⁡4t\\,j" :db/id #edb/ref 17592186361105} {:answer/id #uuid "75a3c33c-0bca-5f44-a5b5-84ee07be1813" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=4\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j" :db/id #edb/ref 17592186361356} {:answer/id #uuid "845ab6b4-5c02-5255-a705-c026ab5d4e0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=4(\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j)" :db/id #edb/ref 17592186361427} {:answer/id #uuid "b0e84a90-a66f-5f65-ad44-888c40336abc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=\\operatorname{cos}⁡4t\\,i-\\operatorname{sin}⁡4t\\,j" :db/id #edb/ref 17592186361622}] :answer-field/correct {:answer/id #uuid "1cd02180-7f22-5f61-93c7-fff08cd0fa7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=4(\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j)" :db/id #edb/ref 17592186360952} :answer-field/id #uuid "87b5905c-bd9f-57b9-8aca-d92b2a486288" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362099}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a58d6f2-a102-5329-9df6-5ca2570034eb" :question/math-academy-id "q-97631" :question/problem "A particle moves along a circular path centered at $O$ in the $xy$-plane in the counterclockwise direction with a constant angular velocity of $1\\text{ rad/s}.$ Given that the object is at the position $(4,0)$ when $t=0,$ find the position function of the particle." :question/worked-solution "The position function of a particle moving in a circular path of radius $R$ in the $xy$-plane with a constant angular velocity $\\omega $ is given by\n\n$$\nr(t)=R(\\operatorname{cos}⁡\\omega t\\,i+\\operatorname{sin}⁡\\omega t\\,j),\n$$\n\nwhere it is assumed that the circle is centered at $O,$ and the particle is at the position $(R,0)$ when $t=0.$\n\nSince the object's initial position is $(4,0),$ we have that $r(0)=4i,$ and we can conclude that the circle's radius is $R=4.$\n\nTherefore, since we have $R=4$ and $\\omega =1\\text{ rad/s},$ we get that the position function is given by\n\n$$\n\\begin{aligned}r(t) & =4(\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362222 :knowledge-point/_questions [{:db/id #edb/ref 17592186172044 :knowledge-point/id #uuid "eb1745c5-6485-5a9d-9e8f-19492928e4b4" :knowledge-point/title "Finding the Position Function of an Object Moving With Circular Motion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029a7f99-f667-5979-a59f-0e86cfa31195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=8(\\operatorname{cos}⁡4t\\,i-\\operatorname{sin}⁡4t\\,j)" :db/id #edb/ref 17592186360840} {:answer/id #uuid "5407564b-be54-5b7e-b365-08c7dd2979bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=4(\\operatorname{cos}⁡8t\\,i-\\operatorname{sin}⁡8t\\,j)" :db/id #edb/ref 17592186361209} {:answer/id #uuid "aed4d295-17ee-5234-8841-738be0c227d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=8(\\operatorname{cos}⁡4t\\,i+\\operatorname{sin}⁡4t\\,j)" :db/id #edb/ref 17592186361610} {:answer/id #uuid "ba462204-6404-53bb-a653-40fd5d5fc0bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=8(\\operatorname{cos}⁡2t\\,i+\\operatorname{sin}⁡2t\\,j)" :db/id #edb/ref 17592186361667} {:answer/id #uuid "fada0c54-2f8f-5502-bc13-443d0123345e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=4(\\operatorname{cos}⁡8t\\,i+\\operatorname{sin}⁡8t\\,j)" :db/id #edb/ref 17592186361958}] :answer-field/correct {:answer/id #uuid "aed4d295-17ee-5234-8841-738be0c227d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=8(\\operatorname{cos}⁡4t\\,i+\\operatorname{sin}⁡4t\\,j)" :db/id #edb/ref 17592186361610} :answer-field/id #uuid "bff7f1a0-ee8f-51c5-b306-5103d68b521c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362157}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0696e9be-8b02-58ba-8734-5aa777937265" :question/math-academy-id "q-97632" :question/problem "A particle moves along a circular path centered at $O$ in the $xy$-plane in the counterclockwise direction with a constant angular velocity of $4\\text{ rad/s}.$ Given that the object is at the position $(8,0)$ when $t=0,$ find the position function of the particle." :question/worked-solution "The position function of a particle moving in a circular path of radius $R$ in the $xy$-plane with a constant angular velocity $\\omega $ is given by\n\n$$\nr(t)=R(\\operatorname{cos}⁡\\omega t\\,i+\\operatorname{sin}⁡\\omega t\\,j),\n$$\n\nwhere it is assumed that the circle is centered at $O,$ and the particle is at the position $(R,0)$ when $t=0.$\n\nSince the object's initial position is $(8,0),$ we have that $r(0)=8i,$ and we can conclude that the circle's radius is $R=8.$\n\nTherefore, since we have $R=8$ and $\\omega =4\\text{ rad/s},$ we get that the position function is given by\n\n$$\n\\begin{aligned}r(t) & =8(\\operatorname{cos}⁡4t\\,i+\\operatorname{sin}⁡4t\\,j).\\end{aligned}\n$$"}]}
