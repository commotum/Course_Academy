#{[{:activity/expected-seconds 540.0 :activity/first-step {:db/id #edb/ref 17592186093099} :activity/id #uuid "b0819913-0358-5916-b4f8-7f50eb841426" :activity/scope {:db/id #edb/ref 17592186049056 :topic/id #uuid "d677f0d4-4206-54fb-91f0-3b257f0b2577" :topic/math-academy-id 947} :activity/steps [{:db/id #edb/ref 17592186093099 :step/content {:db/id #edb/ref 17592186093446 :tutorial/content "Suppose we want to find all of the solutions to the equation\n\n$$\n0\\le x<2\\pi .\n$$\n\nTo calculate a solution, we can reduce the equation to a more convenient form by dividing through by $\\cos x,$ and then use the identity $\\tan x = \\dfrac{\\sin x}{\\cos x}$ to simplify. This gives\n\n$$\n\\begin{aligned}\\operatorname{sin}x-\\sqrt{3}\\operatorname{cos}x & =0 \\\\ \\frac{\\operatorname{sin}x}{\\operatorname{cos}x}-\\frac{\\sqrt{3}\\operatorname{cos}x}{\\operatorname{cos}x} & =0 \\\\ \\frac{\\operatorname{sin}x}{\\operatorname{cos}x}-\\frac{\\sqrt{3}\\cancel{\\operatorname{cos}x}}{\\cancel{\\operatorname{cos}x}} & =0 \\\\ \\frac{\\operatorname{sin}x}{\\operatorname{cos}x}-\\sqrt{3} & =0 \\\\ \\operatorname{tan}x-\\sqrt{3} & =0.\\end{aligned}\n$$\n\nNow, we rearrange the equation and isolate $\\tan x\\mathbin{:}$\n\n$$\n\\tan x = \\sqrt{3}\n$$\n\nWe can immediately calculate the principal value $x\\mathbin{:}$\n\n$$\nx = \\arctan(\\sqrt{3}) = \\dfrac{\\pi}{3}\n$$\n\nSince $\\dfrac{\\pi}{3}$ lies inside the given domain, our first solution is $x_1 = \\dfrac{\\pi}{3}.$\n\nTo find the other solution in the given interval, we add $\\pi\\mathbin{:}$\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}+\\pi  \\\\  & =\\frac{\\pi }{3}+\\pi  \\\\  & =\\frac{4\\pi }{3}\\end{aligned}\n$$\n\nSo the solutions are $x = \\dfrac{\\pi}{3}, \\dfrac{4\\pi}{3}.$" :tutorial/id #uuid "e6a96a57-0e08-54b9-9ccf-a0facd4b8c41" :tutorial/math-academy-id 3925 :tutorial/title "Introduction"} :step/id #uuid "5f21f197-7ffd-5a91-a7cf-62569b160ada" :step/math-academy-id 23179 :step/next {:db/id #edb/ref 17592186093101}} {:db/id #edb/ref 17592186093101 :step/content {:db/id #edb/ref 17592186092251 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092086 :question/id #uuid "7302747a-df6d-5aa9-8118-c9e5f3b1574d" :question/math-academy-id "e-6192"} :knowledge-point/id #uuid "a681cf28-41fa-5547-ba25-ee6a720e1a4f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048867} {:db/id #edb/ref 17592186050105}] :knowledge-point/questions [{:db/id #edb/ref 17592186092636} {:db/id #edb/ref 17592186092883} {:db/id #edb/ref 17592186290333} {:db/id #edb/ref 17592186304822} {:db/id #edb/ref 17592186304828} {:db/id #edb/ref 17592186354641} {:db/id #edb/ref 17592186354643}] :knowledge-point/title "Solving Trigonometric Equations Using the Sin-Cos-Tan Identity"} :step/id #uuid "8bdf2f12-06f6-5472-94cd-e7e7cf917e3b" :step/math-academy-id 23180 :step/next {:db/id #edb/ref 17592186093102}} {:db/id #edb/ref 17592186093102 :step/content {:db/id #edb/ref 17592186093447 :tutorial/content "Let's find all the solutions to the equation\n\n$$\n-\\pi <x\\le \\pi .\n$$\n\nNotice that this time, the domain is $-\\pi <  x \\leq \\pi.$\n\nFirst, we divide each term of the equation by $\\cos x$ and use the identity $\\tan x = \\dfrac{\\sin x}{\\cos x}$ to simplify. This gives\n\n$$\n\\begin{aligned}\\operatorname{sin}x-\\operatorname{cos}x & =0 \\\\ \\frac{\\operatorname{sin}x}{\\operatorname{cos}x}-\\frac{\\operatorname{cos}x}{\\operatorname{cos}x} & =0 \\\\ \\frac{\\operatorname{sin}x}{\\operatorname{cos}x}-\\frac{\\cancel{\\operatorname{cos}x}}{\\cancel{\\operatorname{cos}x}} & =0 \\\\ \\frac{\\operatorname{sin}x}{\\operatorname{cos}x}-1 & =0 \\\\ \\operatorname{tan}x-1 & =0.\\end{aligned}\n$$\n\nNow, we rearrange the equation and isolate $\\tan x\\mathbin{:}$\n\n$$\n\\tan x = 1\n$$\n\nWe can immediately calculate the principal value $x\\mathbin{:}$\n\n$$\nx =  \\arctan(1) = \\dfrac{\\pi}{4}\n$$\n\nSince $\\dfrac{\\pi}{4}$ lies inside the given domain, our first solution is $x_1 = \\dfrac{\\pi}{4}.$\n\nTo find the other solution in the given interval, we *subtract* $\\pi.$ Hence:\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-\\pi  \\\\  & =\\frac{\\pi }{4}-\\pi  \\\\  & =-\\frac{3\\pi }{4}\\end{aligned}\n$$\n\nSo the solutions are $x = -\\dfrac{3\\pi}{4} , \\dfrac{\\pi}{4} .$" :tutorial/id #uuid "20a00eec-d00f-52e6-8e26-03eb611ec5fc" :tutorial/math-academy-id 3926 :tutorial/title "Solving Trigonometric Equations Using the Sin-Cos-Tan Identity Under a Modified Domain"} :step/id #uuid "efdc73f0-9d53-507a-a14e-a2410505fd66" :step/math-academy-id 23183 :step/next {:db/id #edb/ref 17592186093103}} {:db/id #edb/ref 17592186093103 :step/content {:db/id #edb/ref 17592186092252 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092087 :question/id #uuid "072d7328-7c31-5d09-b2d3-91b564624b62" :question/math-academy-id "e-6196"} :knowledge-point/id #uuid "bf1a53c0-e652-5732-9d5a-5aad004c2676" :knowledge-point/questions [{:db/id #edb/ref 17592186092887} {:db/id #edb/ref 17592186092888} {:db/id #edb/ref 17592186256692} {:db/id #edb/ref 17592186304825} {:db/id #edb/ref 17592186357358} {:db/id #edb/ref 17592186357361}] :knowledge-point/title "Solving Trigonometric Equations Using the Sin-Cos-Tan Identity Under a Modified Domain"} :step/id #uuid "a1f55295-6e60-503c-aad2-f80f83e9b618" :step/math-academy-id 23185}] :activity/title "Solving Trigonometric Equations Using the Sin-Cos-Tan Identity" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092440}]}
