alse\">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mo fence=\"false\" stretchy=\"false\">⟨</mo><msub><mi>f</mi><mi>x</mi></msub><mo>,</mo><msub><mi>f</mi><mi>y</mi></msub><mo>,</mo><msub><mi>f</mi><mi>z</mi></msub><mo fence=\"false\" stretchy=\"false\">⟩</mo></mtd><mtd><mi></mi><mo>=</mo><mi>λ</mi><mo fence=\"false\" stretchy=\"false\">⟨</mo><msub><mi>g</mi><mi>x</mi></msub><mo>,</mo><msub><mi>g</mi><mi>y</mi></msub><mo>,</mo><msub><mi>g</mi><mi>z</mi></msub><mo fence=\"false\" stretchy=\"false\">⟩</mo><mo>+</mo><mi>μ</mi><mo fence=\"false\" stretchy=\"false\">⟨</mo><msub><mi>h</mi><mi>x</mi></msub><mo>,</mo><msub><mi>h</mi><mi>y</mi></msub><mo>,</mo><msub><mi>h</mi><mi>z</mi></msub><mo fence=\"false\" stretchy=\"false\">⟩</mo></mtd></mtr><mtr><mtd><mo fence=\"false\" stretchy=\"false\">⟨</mo><mi>y</mi><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mstyle mathcolor=\"blue\"><mi>x</mi><mo>−</mo><mi>z</mi></mstyle></mpadded></mstyle><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo>−</mo><mi>y</mi><mo fence=\"false\" stretchy=\"false\">⟩</mo></mtd><mtd><mi></mi><mo>=</mo><mi>λ</mi><mo fence=\"false\" stretchy=\"false\">⟨</mo><mn>0</mn><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>1</mn><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></mpadded></mstyle><mo fence=\"false\" stretchy=\"false\">⟩</mo><mo>+</mo><mi>μ</mi><mo fence=\"false\" stretchy=\"false\">⟨</mo><mn>2</mn><mi>x</mi><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>2</mn><mi>y</mi><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mstyle mathcolor=\"blue\"><mn>2</mn><mi>z</mi></mstyle></mpadded></mstyle><mo fence=\"false\" stretchy=\"false\">⟩</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
