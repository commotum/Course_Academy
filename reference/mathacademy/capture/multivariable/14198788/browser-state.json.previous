ss=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c33\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtext>rank</mtext><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">T</mi></mrow><mo stretchy=\"false\">)</mo><mo>=</mo><mtext>rank</mtext><mo stretchy=\"false\">(</mo><mi>T</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mn>3.</mn></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
