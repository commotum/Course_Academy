17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186123005} {:answer/id #uuid "3c98691f-2445-5880-944f-87cf5f407b96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186123006} {:answer/id #uuid "5bda5d0c-e9fa-54b7-8032-3675a6282c00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186123007}] :answer-field/id #uuid "37fa1294-0d25-5a87-933a-a3795c1356c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123002}] :question/id #uuid "8a07adee-cd5f-5906-86f1-fee57d6ba6a8" :question/math-academy-id "q-37378" :question/problem "The function\n$f(x, y)$\nhas the second derivative\n$f^{″}(x, y) = \\begin{bmatrix}(2(1 + \\ln x))/(x) & 2y \\\\ 2y & 2x\\end{bmatrix}$\nand has a stationary point at $(1, 0)$. If $H$ denotes the Hessian determinant of $f$, which of the following statements are true?\n\n1. $H(1, 0) > 0$\n2. $\\frac{∂^{2}f}{∂x^{2}}(1, 0) > 0$\n3. The point $(1, 0)$ is a local maximum of $f$"}]}
