3+\\sqrt{9+1}) \\\\  & =\\operatorname{ln}⁡(3+\\sqrt{10}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186505786 :knowledge-point/_questions [{:db/id #edb/ref 17592186092290 :knowledge-point/id #uuid "69ebb184-52aa-5fde-8956-50b69fde3561" :knowledge-point/title "Applying the Definition of Inverse Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2285b527-2ab8-5af2-afd1-7f4347e00b37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({t}^{4}+\\sqrt{{t}^{2}+1})" :db/id #edb/ref 17592186505163} {:answer/id #uuid "7ed05857-49fc-5316-b172-7d379a7d5223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({t}^{4}+\\sqrt{{t}^{2}-1})" :db/id #edb/ref 17592186505358} {:answer/id #uuid "bab2f251-561a-5061-9968-2a666cadb472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(2{t}^{2}-1)" :db/id #edb/ref 17592186505465} {:answer/id #uuid "c7189b48-7aaf-54df-9ab9-f54ac6ef4215" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({t}^{2}+\\sqrt{{t}^{4}-1})" :db/id #edb/ref 17592186505492} {:answer/id #uuid "f32386a5-3a17-5e0b-8e43-dc3ded6055a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({t}^{2}+\\sqrt{{t}^{4}+1})" :db/id #edb/ref 17592186505576}] :answer-field/correct {:answer/id #uuid "c7189b48-7aaf-54df-9ab9-f54ac6ef4215" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({t}^{2}+\\sqrt{{t}^{4}-1})" :db/id #edb/ref 17592186505492} :answer-field/id #uuid "166baeab-8e67-55ec-8521-064948d2e2ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186505618}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "825bc5fd-74d7-5ef1-94a9-eb5175f0a88c" :question/math-academy-id "q-95612" :question/problem "$$\n\nGiven that $t\\ge 1,$ which of the following is equivalent to $\\operatorname{arcosh}⁡{t}^{2}?$" :question/worked-solution "The definition of $\\operatorname{arcosh}⁡x$ is \n\n$$\n\\operatorname{arcosh}⁡x=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arcosh}⁡{t}^{2} & =\\operatorname{ln}⁡({t}^{2}+\\sqrt{{({t}^{2})}^{2}-1}) \\\\  & =\\operatorname{ln}⁡({t}^{2}+\\sqrt{{t}^{4}-1}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186505789 :knowledge-point/_questions [{:db/id #edb/ref 17592186092291 :knowledge-point/id #uuid "d68a11bd-7a2d-5f1f-8be7-c8904fdfb3e7" :knowledge-point/title "Applying the Definition of Inverse Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ba3e473-02fb-5157-b482-3554be83ad62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{3}{5})" :db/id #edb/ref 17592186505185} {:answer/id #uuid "45918914-cbad-5fa0-8b0f-566e642a966c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{3})" :db/id #edb/ref 17592186505246} {:answer/id #uuid "5762675e-b9b2-5628-ae14-b2f8bf8c8a64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{2}{5})" :db/id #edb/ref 17592186505281} {:answer/id #uuid "68bef3d6-95b9-53bc-bfd3-a4201accc046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{4}{5})" :db/id #edb/ref 17592186505316} {:answer/id #uuid "ef341ed2-5b5f-5140-8092-d50bef9018a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{3}{4})" :db/id #edb/ref 17592186505568}] :answer-field/correct {:answer/id #uuid "2ba3e473-02fb-5157-b482-3554be83ad62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{3}{5})" :db/id #edb/ref 17592186505185} :answer-field/id #uuid "67fc1eae-c999-56ca-96a1-f0623bb0224c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186505654}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "83ade4bd-cffc-596f-9566-1eb5e39170cc" :question/math-academy-id "q-95616" :question/problem "$$\n\n$\\operatorname{artanh}⁡(-\\frac{1}{4})=$" :question/worked-solution "The definition of $\\operatorname{artanh}⁡x$ is \n\n$$\n\\operatorname{artanh}⁡x=\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1+x}{1-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{artanh}⁡(-\\frac{1}{4}) & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1+(-\\frac{1}{4})}{1-(-\\frac{1}{4})}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1-\\frac{1}{4}}{1+\\frac{1}{4}}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{\\frac{3}{4}}{\\frac{5}{4}}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{3}{5}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186505793 :knowledge-point/_questions [{:db/id #edb/ref 17592186092290 :knowledge-point/id #uuid "69ebb184-52aa-5fde-8956-50b69fde3561" :knowledge-point/title "Applying the Definition of Inverse Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "442742ea-5a97-5424-b2fe-831762115423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(36+\\sqrt{6})" :db/id #edb/ref 17592186505242} {:answer/id #uuid "468e30ca-2c3f-55a3-bab1-e10249c2d5c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(35+\\sqrt{6})" :db/id #edb/ref 175921865