s} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\arsinh{2} =$" #edb/ref 17592186045417] [17592186092136 #edb/ref 1072 #uuid "6fc6a60d-11e9-56c1-9328-0179059d4c56" #edb/ref 17592186045417] [17592186092136 #edb/ref 1074 "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe definition of $\\arsinh x$ is\n\n$$\n\\arsinh{x} =\\ln\\left(x+\\sqrt{x^2+1}\\right)\n$$\n\nTherefore,\n\n$$\n\\begin{aligned} \\arsinh{2} & = \\ln\\left(2 + \\sqrt{2^2+1}\\right) \\\\[5pt] & = \\ln\\left(2 + \\sqrt{4+1}\\right) \\\\[5pt] &=\\ln\\left(2 + \\sqrt 5\\right). \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186092137 #edb/ref 1069 "e-8390" #edb/ref 17592186045417] [17592186092137 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\arcosh{3} =$" #edb/ref 17592186045417] [17592186092137 #edb/ref 1072 #uuid "a8951542-ff6f-5b96-a287-b4c7f928b572" #edb/ref 17592186045417] [17592186092137 #edb/ref 1074 "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe definition of $\\arcosh{x}$ is\n\n$$\n\\arcosh{x} = \\ln\\left(x+\\sqrt{x^2-1}\\right)\n$$\n\nTherefore,\n\n$$\n\\begin{aligned} \\arcosh{3} & = \\ln\\left(3+\\sqrt{3^2-1}\\right) \\\\[3pt] & = \\ln\\left(3+\\sqrt{9-1}\\right) \\\\[3pt] & = \\ln\\left(3+\\sqrt{8}\\right) \\\\[3pt] &=\\ln{\\left(3+2\\sqrt{2}\\right)}. \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186092138 #edb/ref 1069 "e-8391" #edb/ref 17592186045417] [17592186092138 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\artanh\\left (\\dfrac{1}{2} \\right) =$" #edb/ref 17592186045417] [17592186092138 #edb/ref 1072 #uuid "13299051-2164-5d54-b90e-52c7a8f1d7f2" #edb/ref 17592186045417] [17592186092138 #edb/ref 1074 "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe definition of $\\artanh{x}$ is\n\n$$\n\\artanh{x} = \\dfrac{1}{2}\\ln\\left(\\dfrac{1+x}{1-x}\\right)\n$$\n\nTherefore,\n\n$$\n\\begin{aligned} \\artanh\\left (\\dfrac{1}{2} \\right) & = \\dfrac{1}{2}\\ln\\left(\\dfrac{1+\\dfrac{1}{2}}{1-\\dfrac{1}{2}}\\right) \\\\[5pt] &=\\dfrac{1}{2}\\ln\\left(\\dfrac{\\dfrac{3}{2}}{\\dfrac{1}{2}}\\right) \\\\[5pt] &=\\dfrac{1}{2}\\ln{3}. \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186092140 #edb/ref 1069 "e-8768" #edb/ref 17592186045417] [17592186092140 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nUsing the definition of the hyperbolic sine, calculate $f^{-1}(x)$ given that $f(x) = \\sinh{\\left(x^2\\right)}$ and $x \\geq 0$." #edb/ref 17592186045417] [17592186092140 #edb/ref 1072 #uuid "4fbdc166-4225-5fa5-aaa2-0f09073e8e2e" #edb/ref 17592186045417] [17592186092140 #edb/ref 1074 "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nLet\n\n$$\ny = \\sinh{\\left(x^2\\right)}\n$$\n\nSince\n\n$$\nx \\geq 0\n$$\n\nwe have\n\n$$\ny \\geq 0\n$$\n\nTo find the inverse function we swap $x$ and $y{:}$\n\n$$\nx = \\sinh{\\left(y^2\\right)}\n$$\n\nwhere $x\\in[0,\\infty)$ and $y\\in[0,\\infty)$.\n\nNext, we apply the definition of $\\sinh x{:}$\n\n$$\n\\begin{aligned}\nx &= \\frac{1}{2}(e^{y^{2}} - e^{-y^{2}}) \\\\\n2x &= e^{y^{2}} - e^{-y^{2}} \\\\\n2xe^{y^{2}} &= e^{2y^{2}} - 1\n\\end{aligned}\n$$\n\nBringing everything to the left-hand side, we get\n\n$$\n\\begin{aligned}\ne^{2y^{2}} - 2xe^{y^{2}} - 1 &= 0 \\\\\n(e^{y^{2}})^{2} - 2x(e^{y^{2}}) - 1 &= 0\n\\end{aligned}\n$$\n\nLet\n\n$$\nY = e^{y^2}\n$$\n\nWe can form a quadratic equation in $Y$ and solve it by completing the square, as follows:\n\n$$\n\\begin{aligned}\nY^{2} - 2xY - 1 &= 0 \\\\\n(Y - x)^{2} - x^{2} - 1 &= 0 \\\\\n(Y - x)^{2} &= x^{2} + 1 \\\\\nY - x &= ± \\sqrt{x^{2} + 1} \\\\\nY &= x ± \\sqrt{x^{2} + 1} \\\\\ne^{y^{2}} &= x ± \\sqrt{x^{2} + 1} \\\\\ny^{2} &= \\ln (x ± \\sqrt{x^{2} + 1}) \\\\\ny &= ± \\sqrt{\\ln (x ± \\sqrt{x^{2} + 1})}\n\\end{aligned}\n$$\n\nFinally, since we require real $y$ and $x < \\sqrt{x^2+1}$ for all $x$, we select the positive solution. Therefore,\n\n$$\nf^{-1}(x) = \\sqrt{\\ln\\left(x+\\sqrt{x^2+1}\\right)}\n$$" #edb/ref 17592186045417] [17592186092289 #edb/ref 1038 #edb/ref 17592186092924 #edb/ref 17592186045417] [17592186092289 #edb/ref 1038 #edb/ref 17592186092928 #edb/ref 17592186045417] [17592186092289 #edb/ref 1039 "Applying the Definition of Inverse Hyperbolic Sine" #edb/ref 17592186045417] [17592186092289 #edb/ref 1041 #edb/ref 17592186092136 #edb/ref 17592186045417] [17592186092289 #edb/ref 1042 #uuid "7d3383cb-2322-5ed0-bd5b-631596d72af9" #edb/ref 17592186045417] [17592186092290 #edb/ref 1038 #edb/ref 17592186092925 #edb/ref 17592186045417] [17592186092290 #edb/ref 1038 #edb/ref 17592186092927 #edb/ref 17592186045417] [175921860922