          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:170px;\n                                        margin-left:2px;\n                                        margin-right:2px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"159\"><span mathquill-command-id=\"161\">2</span><span mathquill-command-id=\"163\" class=\"mq-binary-operator\">+</span><span class=\"mq-non-leaf\" mathquill-command-id=\"165\"><span class=\"mq-scaled mq-sqrt-prefix\" style=\"transform: scale(1, 1.6971);\">√</span><span class=\"mq-non-leaf mq-sqrt-stem\" mathquill-block-id=\"169\"><var mathquill-command-id=\"167\" class=\"mq-operator-name\">l</var><var mathquill-command-id=\"168\" class=\"mq-operator-name\">n</var><span class=\"mq-non-leaf\" mathquill-command-id=\"188\"><span class=\"mq-scaled mq-paren\" style=\"transform: scale(1.11304, 1.87826);\">(</span><span class=\"mq-non-leaf\" mathquill-block-id=\"172\"><var mathquill-command-id=\"171\">x</var><span mathquill-command-id=\"173\" class=\"mq-binary-operator\">+</span><span class=\"mq-non-leaf\" mathquill-command-id=\"175\"><span class=\"mq-scaled mq-sqrt-prefix\" style=\"transform: scale(1, 1.34928);\">√</span><span class=\"mq-non-leaf mq-sqrt-stem\" mathquill-block-id=\"177\"><var mathquill-command-id=\"176\">x</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"178\"><span class=\"mq-sup\" mathquill-block-id=\"180\"><span mathquill-command-id=\"179\">2</span></span></span><span mathquill-command-id=\"182\" class=\"mq-binary-operator\">−</span><span mathquill-command-id=\"184\">1</span></span></span></span><span class=\"mq-scaled mq-paren\" style=\"transform: scale(1.11304, 1.87826);\">)</span></span></span></span></span></div></div>",
          "rendered_text": "2+√ln(x+√x2−1)",
