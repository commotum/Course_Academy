013 844T1020 832V826L741 243Q645 43 540 -176Q479 -303 469 -324T453 -348Q449 -350 436 -350L424 -349L315 -96Q206 156 205 156L171 130Q138 104 137 104L111 130L263 249Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-29\" d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJSZ1-29\" d=\"M305 251Q305 -145 69 -349H56Q43 -349 39 -347T35 -338Q37 -333 60 -307T108 -239T160 -136T204 27T221 250T204 473T160 636T108 740T60 807T35 839Q35 850 50 850H56H69Q197 743 256 566Q305 425 305 251Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-2C\" d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-2208\" d=\"M84 250Q84 372 166 450T360 539Q361 539 377 539T419 540T469 540H568Q583 532 583 520Q583 511 570 501L466 500Q355 499 329 494Q280 482 242 458T183 409T147 354T129 306T124 272V270H568Q583 262 583 250T568 230H124V228Q124 207 134 177T167 112T231 48T328 7Q355 1 466 0H570Q583 -10 583 -20Q583 -32 568 -40H471Q464 -40 446 -40T417 -41Q262 -41 172 45Q84 127 84 250Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-221E\" d=\"M55 217Q55 305 111 373T254 442Q342 442 419 381Q457 350 493 303L507 284L514 294Q618 442 747 442Q833 442 888 374T944 214Q944 128 889 59T743 -11Q657 -11 580 50Q542 81 506 128L492 147L485 137Q381 -11 252 -11Q166 -11 111 57T55 217ZM907 217Q907 285 869 341T761 397Q740 397 720 392T682 378T648 359T619 335T594 310T574 285T559 263T548 246L543 238L574 198Q605 158 622 138T664 94T714 61T765 51Q827 51 867 100T907 217ZM92 214Q92 145 131 89T239 33Q357 33 456 193L425 233Q364 312 334 337Q285 380 233 380Q171 380 132 331T92 214Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E2-MJMAIN-73\"></use>\n <use xlink:href=\"#E2-MJMAIN-69\" x=\"394\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-6E\" x=\"673\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-68\" x=\"1229\" y=\"0\"></use>\n<g transform=\"translate(1786,422)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-2212\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-31\" x=\"778\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E2-MJMATHI-78\" x=\"2957\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-3D\" x=\"3807\" y=\"0\"></use>\n<g transform=\"translate(4863,0)\">\n <use xlink:href=\"#E2-MJMAIN-61\"></use>\n <use xlink:href=\"#E2-MJMAIN-72\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-73\" x=\"893\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-69\" x=\"1287\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-6E\" x=\"1566\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-68\" x=\"2122\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E2-MJMATHI-78\" x=\"7709\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-3D\" x=\"8559\" y=\"0\"></use>\n<g transform=\"translate(9615,0)\">\n <use xlink:href=\"#E2-MJMAIN-6C\"></use>\n <use xlink:href=\"#E2-MJMAIN-6E\" x=\"278\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E2-MJSZ1-28\" x=\"10617\" y=\"-1\"></use>\n <use xlink:href=\"#E2-MJMATHI-78\" x=\"11076\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2B\" x=\"11870\" y=\"0\"></use>\n<g transform=\"translate(12871,0)\">\n <use xlink:href=\"#E2-MJSZ1-221A\" x=\"0\" y=\"126\"></use>\n<rect stroke=\"none\" width=\"2749\" height=\"60\" x=\"1000\" y=\"917\"></rect>\n<g transform=\"translate(1000,0)\">\n <use xlink:href=\"#E2-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-32\" x=\"809\" y=\"583\"></use>\n <use xlink:href=\"#E2-MJMAIN-2B\" x=\"1248\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-31\" x=\"2249\" y=\"0\"></use>\n</g>\n</g>\n <use xlink:href=\"#E2-MJSZ1-29\" x=\"16621\" y=\"-1\"></use>\n <use xlink:href=\"#E2-MJMAIN-2C\" x=\"17080\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMATHI-78\" x=\"19525\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2208\" x=\"20375\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-28\" x=\"21321\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2212\" x=\"21710\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-221E\" x=\"22489\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2C\" x=\"23489\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-221E\" x=\"23934\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-29\" x=\"24935\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2E\" x=\"25324\" y=\"0\"></use>\n</g>\n</svg></span>\nThe graph of the inverse hyperbolic sine function is given below.</p>\n<div id=\"graphic-6352994610b4b541a281e93e3eea6bbc\" class=\"graphic\"><img src=\"/graphics/6352994610b4b541a281e93e3eea6bbc\"></div>\n</li>\n<li><p>The <strong>inverse hyperbolic cosine</strong>, defined as\n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"56.749ex\" height=\"3.676ex\" style=\"vertical-align: -1.005ex;\" viewBox=\"0 -1150.1 24433.7 1582.7\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-3-Title\">\n<title id=\"MathJax-SVG-3-Title\">\n\\cosh^{-1}{x} = \\arcosh{x} = \\ln\\big(x+\\sqrt{x^2-1}\\big), \\qquad x \\in [1, \\infty).\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E3-MJMAIN-63\" d=\"M370 305T349 305T313 320T297 358Q297 381 312 396Q317 401 317 402T307 404Q281 408 258 408Q209 408 178 376Q131 329 131 219Q131 137 162 90Q203 29 272 29Q313 29 338 55T374 117Q376 125 379 127T395 129H409Q415 123 415 120Q415 116 411 104T395 71T366 33T318