><mtd><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mi>P</mi><mo stretchy=\"false\">⇔</mo><mi>Q</mi></mrow></msub></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><msub><mi>T</mi><mi>P</mi></msub><mo>∩</mo><msub><mi>T</mi><mi>Q</mi></msub><mo stretchy=\"false\">)</mo><mo>∪</mo><mo stretchy=\"false\">(</mo><msub><mover><mi>T</mi><mo accent=\"true\">―</mo></mover><mi>P</mi></msub><mo>∩</mo><msub><mover><mi>T</mi><mo accent=\"true\">―</mo></mover><mi>Q</mi></msub><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo>,</mo><mn>3</mn><mo stretchy=\"false\">]</mo><mo>∪</mo><mi mathvariant=\"normal\">∅</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo>,</mo><mn>3</mn><mo stretchy=\"false\">]</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
