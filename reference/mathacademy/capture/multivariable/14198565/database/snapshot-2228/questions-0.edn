#{[{:db/id #edb/ref 17592186167287 :knowledge-point/_questions [{:db/id #edb/ref 17592186166959 :knowledge-point/id #uuid "f1e90af1-3fbd-5aa3-ac32-ac54c27c7224" :knowledge-point/title "Computing the Cosine Coefficients From the Half-Range Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af2e9c05-9931-51cb-bc77-ac72947bd6b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10(1 + (-1)^{n}))/(πn)" :db/id #edb/ref 17592186164943} {:answer/id #uuid "e4c36a65-8f86-5040-960a-52e8fda9ce49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10(1 - (-1)^{n}))/(πn^{2})" :db/id #edb/ref 17592186164944} {:answer/id #uuid "fec7b3aa-104b-59ce-877c-89b77cba9f28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5(1 - (-1)^{n}))/(4πn)" :db/id #edb/ref 17592186164945} {:answer/id #uuid "06bdfd02-1d8c-57c5-8493-7b35f0a2cd30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2(1 - (-1)^{n}))/(πn)" :db/id #edb/ref 17592186164946} {:answer/id #uuid "33fc4622-65a5-5890-938a-f5ddf7b6ccd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5(1 + (-1)^{n}))/(πn^{2})" :db/id #edb/ref 17592186164947}] :answer-field/id #uuid "47123422-6d41-57b1-8d42-77550afd151d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186164942}] :question/id #uuid "464460d1-2c6d-5d78-a455-18bf4796cfeb" :question/math-academy-id "q-340810" :question/problem "$f(x)∼\\frac{a_{0}}{2} + ∑_(n = 1)^(∞)a_{n}\\cos (nx)$\nLet $F(x) =-5x$ for $x ∈ [0, π)$. The Fourier cosine series of the **even** $2π$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for $a_{n}$.$a_{n} =$ {{field-1}}\nfor $n \\ge 1$"}] [{:db/id #edb/ref 17592186167290 :knowledge-point/_questions [{:db/id #edb/ref 17592186166958 :knowledge-point/id #uuid "96ac89a1-4179-5afe-8c1b-ebd9d47bde79" :knowledge-point/title "Computing the Constant Term From the Half-Range Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea6bc13d-d121-5470-9a02-6bccf6326cbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\pi }" :db/id #edb/ref 17592186313840}] :answer-field/correct {:answer/id #uuid "ea6bc13d-d121-5470-9a02-6bccf6326cbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\pi }" :db/id #edb/ref 17592186313840} :answer-field/id #uuid "e2a4d790-be8f-590b-8822-ec2aba0d93b4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314636}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eb68e665-73e2-503c-a3f5-1fe023348ad8" :question/math-academy-id "q-340815" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-\\operatorname{sin}⁡(\\frac{x}{3})$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-\\operatorname{sin}⁡(\\frac{x}{3})$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }-\\operatorname{sin}⁡(\\frac{x}{3})\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[3\\operatorname{cos}⁡(\\frac{x}{3})]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(3\\operatorname{cos}⁡(\\frac{\\pi }{3})-3\\operatorname{cos}⁡(0)) \\\\  & =\\frac{2}{\\pi }(\\frac{3}{2}-3) \\\\  & =-\\frac{3}{\\pi }.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186315077 :knowledge-point/_questions [{:db/id #edb/ref 17592186166959 :knowledge-point/id #uuid "f1e90af1-3fbd-5aa3-ac32-ac54c27c7224" :knowledge-point/title "Computing the Cosine Coefficients From the Half-Range Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cb713a9-182a-58c5-8920-2a63b83c7f86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6((-1)^{n}-1)}{\\pi {n}^{2}}" :db/id #edb/ref 17592186312191} {:answer/id #uuid "240146db-8d91-59be-b64b-76e1c8746ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(1-(-1)^{n})}{\\pi n}" :db/id #edb/ref 17592186312243} {:answer/id #uuid "fd180a8b-f784-5dc2-b774-7210e71ce47f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(-1)^{n}}{\\pi n}" :db/id #edb/ref 17592186313993} {:answer/id #uuid "fe0b1b70-4c58-554b-a64c-113f6eb2a24e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6(-1)^{n}}{\\pi {n}^{2}}" :db/id #edb/ref 17592186314001}] :answer-field/correct {:answer/id #uuid "1cb713a9-182a-58c5-8920-2a63b83c7f86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6((-1)^{n}-1)}{\\pi {n}^{2}}" :db/id #edb/ref 17592186312191} :answer-field/id #uuid "269a3def-e5fb-5139-bdd6-b154cb225918" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314112} {:answer-field/choices [{:answer/id #uuid "00fa78b3-f990-59e4-9c5d-d0332b6aff1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\pi x)" :db/id #edb/ref 17592186311967} {:answer/id #uuid "388c3d71-2ecb-56b2-a8f8-8278a8c14822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(nx)" :db/id #edb/ref 17592186312433} {:answer/id #uuid "e4bb1a08-e278-5d30-b8cb-9166ede28c90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\pi x)" :db/id #edb/ref 17592186313781} {:answer/id #uuid "e8bb46c1-cb30-5e51-80bc-28b9893d881b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(nx)" :db/id #edb/ref 17592186313827}] :answer-field/correct {:answer/id #uuid "388c3d71-2ecb-56b2-a8f8-8278a8c14822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(nx)" :db/id #edb/ref 17592186312433} :answer-field/id #uuid "878c7582-0be7-5a08-9eeb-a39c44e09857" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314369}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d7d424ca-a5eb-5340-a732-023666fa3414" :question/math-academy-id "q-341267" :question/problem "Let $F(x)=3x+1$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼(1+\\frac{3}{2}\\pi )+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$" :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=3x+1$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(3x+1)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=3x+1\\, & ⇒\\,{u}^{′}=3 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(3x+1)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{3}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((3\\pi +1)\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))+\\frac{3}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{2}{n\\pi }(0+\\frac{3}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{6(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{6((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(1+\\frac{3}{2}\\pi )+{\\sum }_{n=1}^{\\infty }\\frac{6((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$"}] [{:db/id #edb/ref 17592186315080 :knowledge-point/_questions [{:db/id #edb/ref 17592186166958 :knowledge-point/id #uuid "96ac89a1-4179-5afe-8c1b-ebd9d47bde79" :knowledge-point/title "Computing the Constant Term From the Half-Range Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27402392-ef7b-543e-a95c-51569128931d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\pi }(\\sqrt{2}-2)" :db/id #edb/ref 17592186312273}] :answer-field/correct {:answer/id #uuid "27402392-ef7b-543e-a95c-51569128931d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\pi }(\\sqrt{2}-2)" :db/id #edb/ref 17592186312273} :answer-field/id #uuid "f63f2945-3857-5e6d-882c-11e5148b361f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314680}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "86b3942b-d5fe-58b1-8280-9f2a9124377a" :question/math-academy-id "q-341283" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-\\operatorname{sin}⁡(\\frac{x}{4})$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-\\operatorname{sin}⁡(\\frac{x}{4})$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }-\\operatorname{sin}⁡(\\frac{x}{4})\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[4\\operatorname{cos}⁡(\\frac{x}{4})]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(4\\operatorname{cos}⁡(\\frac{\\pi }{4})-4\\operatorname{cos}⁡(0)) \\\\  & =\\frac{2}{\\pi }(4\\cdot \\frac{\\sqrt{2}}{2}-4) \\\\  & =\\frac{4}{\\pi }(\\sqrt{2}-2).\\end{aligned}\n$$"}]}
