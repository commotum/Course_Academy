u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v)⟩ \\\\  & =⟨1,\\,1,\\,0⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v)⟩ \\\\  & =⟨0,\\,0,\\,1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =⟨|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|,\\,-|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|,\\,|\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}|⟩ \\\\  & =⟨1,\\,-1,\\,0⟩,\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨1,\\,-1,\\,0⟩‖ \\\\  & =\\sqrt{(1)^{2}+(-1)^{2}+(0)^{2}} \\\\  & =\\sqrt{1+1+0} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =({x}^{2}+{y}^{2})\\,{|}_{x=u\\,y=u\\,z=v} \\\\  & ={u}^{2}+{u}^{2} \\\\  & =2{u}^{2}\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,2\\sqrt{2}{u}^{2}\\,\\,\\text{d}A.\\end{aligned}\n$$" 13194139534216 17592186045417 true] [17592186414461 1068 #edb/ref 17592186414456 13194139534216 17592186045417 true] [17592186414461 1069 "q-161288" 13194139534216 17592186045417 true] [17592186414461 1070 #edb/ref 17592186045487 13194139534216 17592186045417 true] [17592186414461 1071 "$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}\\boxed{}\\,\\text{d}A\n$$\n\nConsider the surface integral of the function \n$f(x,y,z)=-x-{z}^{2}$ \nover the parametric surface \n\n$$\nr(u,v)=⟨{u}^{3},\\,v,\\,{v}^{2}⟩\n$$\n\nfor $(u,v)\\in D⊆{R}^{2}.$ What is the missing expression?" 13194139534216 17592186045417 true] [17592186414461 1072 #uuid "2c7beff7-ff72-566b-ae77-d272cca30605" 13194139534216 17592186045417 true] [17592186414461 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}({u}^{3}),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}({v}^{2})⟩ \\\\  & =⟨3{u}^{2},\\,0,\\,0⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}({u}^{3}),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}({v}^{2})⟩ \\\\  & =⟨0,\\,1,\\,2v⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 3{u}^{2} & 0 & 0 \\\\ 0 & 1 & 2v\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & 0 \\\\ 1 & 2v\\end{aligned}|,\\,-|\\begin{aligned}3{u}^{2} & 0 \\\\ 0 & 2v\\end{aligned}|,\\,|\\begin{aligned}3{u}^{2} & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨0,\\,-6v{u}^{2},\\,3{u}^{2}⟩,\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨0,\\,-6v{u}^{2},\\,3{u}^{2}⟩‖ \\\\  & =\\sqrt{(0)^{2}+(-6v{u}^{2})^{2}+(3{u}^{2})^{2}} \\\\  & =\\sqrt{36{v}^{2}{u}^{4}+9{u}^{4}} \\\\  & =3{u}^{2}\\sqrt{4{v}^{2}+1}.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(-x-{z}^{2})\\,{|}_{x={u}^{3}\\,y=v\\,z={v}^{2}} \\\\  & =-{u}^{3}-({v}^{2}\\cdot {v}^{2}) \\\\  & =-{u}^{3}-{v}^{4}\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,3{u}^{2}(-{u}^{3}-{v}^{4})\\sqrt{4{v}^{2}+1}\\,\\,\\text{d}A.\\end{aligned}\n$$" 13194139534216 17592186045417 true] [17592186414462 1068 #edb/ref 17592186414458 13194139534216 17592186045417 true] [17592186414462 1069 "q-161181" 13194139534216 17592186045417 true] [17592186414462 1070 #edb/ref 17592186045487 13194139534216 17592186045417 true] [17592186414462 1071 "Evaluate the surface integral \n\n$$\n{∬}_{S}(3x-2y+3z)\\,\\text{d}S,\n$$\n\nwhere the parametric surface $S$ is defined by \n\n$$\nr(u,v)=⟨2u+v,\\,2u+v,\\,-v⟩\n$$\n\n \nover the domain $D={(u,v)\\,:\\,-1\\le u\\le 1,\\,-1\\le v\\le 0}.$\n\n*Hint: You can use the fact that $‖{r}_{u}^{′}\\times {r}_{v}^{′}‖=2\\sqrt{2}.$*" 13194139534216 17592186045417 true] [17592186414462 1072 #uuid "d27e0ee0-ad93-5416-8abb-f21167765a8b" 13194139534216 17592186045417 true] [17592186414462 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nNotice that we are told that the norm of the fundamental vector product is\n\n$$\n‖{r}_{u}^{′}\\times {r}_{v}^{′}‖=2\\sqrt{2}.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(3x-2y+3z)\\,{|}_{x=2u+v\\,y=2u+v\\,z=-v} \\\\  & =3(2u+v)-2(2u+v)+3(-v) \\\\  & =2(u-v)\\end{aligned}\n$$\n\nTherefore, our surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,2(u-v)\\cdot 2\\sqrt{2}\\,\\text{d}A \\\\  & =4\\sqrt{2}{∬}_{D}\\,(u-v)\\,\\text{d}A \\\\  & =4\\sqrt{2}{\\int }_{-1}^{0}({\\int }_{-1}^{1}u-v\\,\\text{d}u)\\text{d}v \\\\  & =4\\sqrt{2}{\\int }_{-1}^{0}{[\\frac{{u}^{2}}{2}-vu]}_{-1}^{1}\\text{d}v \\\\  & =4\\sqrt{2}{\\int }_{-1}^{0}(0-2v)\\text{d}v \\\\  & =4\\sqrt{2}{[-{v}^{2}]}_{-1}^{0} \\\\  & =4\\sqrt{2}\\cdot 1 \\\\  & =4\\sqrt{2}.\\end{aligned}\n$$" 13194139534216 17592186045417 true] [17592186414463 1068 #edb/ref 17592186414457 13194139534216 17592186045417 true] [17592186414463 1069 "q-161179" 13194139534216 17592186045417 true] [17592186414463 1070 #edb/ref 17592186045487 13194139534216 17592186045417 true] [17592186414463 1071 "Evaluate the surface integral \n\n$$\n{∬}_{S}(x+y+z)\\,\\text{d}S,\n$$\n\nwhere the parametric surface $S$ is defined by \n\n$$\nr(u,v)=⟨u+v,\\,3v,\\,2u-v⟩\n$$\n\n \nover the domain $D={(u,v)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 1}.$\n\n*Hint: You can use the fact that $‖{r}_{u}^{′}\\times {r}_{v}^{′}‖=3\\sqrt{6}.$*" 13194139534216 17592186045417 true] [17592186414463 1072 #uuid "f95319f6-2e43-511b-ae0d-9608a991c217" 13194139534216 17592186045417 true] [17592186414463 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface integral of a scalar function $f$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nNotice that we are told that the norm of the fundamental vector product is\n\n$$\n‖{r}_{u}^{′}\\times {r}_{v}^{′}‖=3\\sqrt{6}.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $f(x,y,z):$\n\n$$\n\\begin{aligned}f(r(u,v)) & =(x+y+z)\\,{|}_{x=u+v\\,y=3v\\,z=2u-v} \\\\  & =(u+v)+(3v)+(2u-v) \\\\  & =3u+3v\\end{aligned}\n$$\n\nTherefore, our surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(r(u,v))‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}\\,(3u+3v)\\cdot 3\\sqrt{6}\\,\\text{d}A \\\\  & =9\\sqrt{6}{∬}_{D}\\,(u+v)\\,\\text{d}A \\\\  & =9\\sqrt{6}{\\int }_{0}^{1}({\\int }_{0}^{1}u+v\\,\\text{d}u)\\text{d}v \\\\  & =9\\sqrt{6}{\\int }_{0}^{1}{[\\frac{{u}^{2}}{2}+vu]}_{0}^{1}\\text{d}v \\\\  & =9\\sqrt{6}{\\int }_{0}^{1}(\\frac{1}{2}+v)\\text{d}v \\\\  & =9\\sqrt{6}{[\\frac{v}{2}+\\frac{{v}^{2}}{2}]}_{0}^{1} \\\\  & =9\\sqrt{6}\\cdot 1 \\\\  & =9\\sqrt{6}.\\end{aligned}\n$$" 13194139534216 17592186045417 true]] :edb/tempids {"answer-0cd71aa2-2da0-53d3-a18e-57cc7dd66fe2" 17592186414430 "answer-11345332-1583-5403-b382-1f7db9544110" 17592186414431 "answer-1b5899eb-77cf-5b34-b910-c93474d97e73" 17592186414432 "answer-22129875-cc14-5ad3-8bba-b26995c05188" 17592186414433 "answer-31c23b1e-7cd7-5e7a-8c99-254c33c9229b" 17592186414434 "answer-38973f90-0f85-5e71-8380-79a67500ceed" 17592186414435 "answer-44291a57-8b30-555c-b7e9-95314ffa4f9d" 17592186414436 "answer-6a78c70d-c252-5fa1-b3b9-b5253f7112ea" 17592186414437 "answer-6d9b5bd3-6406-550a-9325-8fcec12f33ef" 17592186414438 "answer-6ed83581-5e32-5a0e-8a25-178bb99cade4" 17592186414439 "answer-7d00c43b-e899-573d-afa8-6b12ead91cda" 17592186414440 "answer-8846a5c5-d563-5056-8e15-64f5e19db2bb" 17592186414441 "answer-8d5f84da-ca2b-5738-b498-90f08c5871a9" 17592186414442 "answer-a93dd97e-74c6-56c8-a6b1-3cdadc7213e0" 17592186414443 "answer-ab922d47-0766-574c-83bb-4e4ccfbb77ca" 17592186414444 "answer-b146a4db-c677-57ea-92f8-07f41239596d" 17592186414445 "answer-b723dafe-f5a6-5a70-be14-953187b88dde" 17592186414446 "answer-bc8100ab-c718-514d-8f3c-f28643c256a5" 17592186414447 "answer-c87217ff-e3d3-5223-ac71-463a0c197918" 17592186414448 "answer-cb42e303-0573-52db-81ce-d57e99e6f761" 17592186414449 "answer-d24b3aff-8b91-5bf0-8ab1-f276e0780c98" 17592186414450 "answer-d505a7da-72d5-5c19-aa46-75ea67cf0bb1" 17592186414451 "answer-e1fe1620-65f9-5859-8a82-9a5f97b2fafb" 17592186414452 "answer-e4f2c71c-8604-5aa1-9ce7-1663a5f2e6db" 17592186414453 "answer-f2e130f7-33b8-53a2-a94a-0675fb611102" 17592186414454 "answer-field-16fadbea-4516-5df4-9f64-8b7cc353d5a0" 17592186414455 "answer-field-72a815fc-9d19-53b2-b0ae-b65abcc40317" 17592186414456 "answer-field-831c917a-be0b-5705-bc09-e4bee9b35277" 17592186414457 "answer-field-93abc2ba-af03-5472-9cce-10fe847607a0" 17592186414458 "answer-field-be382d30-f02e-5329-bcf7-16808280a34b" 17592186414459 "question-26a444d6-a870-593f-bb03-1c02941c48b1" 17592186414460 