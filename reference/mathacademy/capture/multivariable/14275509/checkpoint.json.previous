      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14275509/observations/step-t9170-ea4bf2021d478f711f12.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14275509/observations/step-t9170-ea4bf2021d478f711f12.png",
      "worked_solution": "",
