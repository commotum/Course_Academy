#{[{:activity/expected-seconds 1500.0 :activity/first-step {:db/id #edb/ref 17592186065330} :activity/id #uuid "8d3375a4-6e38-5507-bb65-38b3c2679448" :activity/scope {:db/id #edb/ref 17592186050645 :topic/id #uuid "5bfd7882-2604-57b4-bd18-ab558a07257a" :topic/math-academy-id 346} :activity/steps [{:db/id #edb/ref 17592186065179 :step/content {:db/id #edb/ref 17592186064290 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064133 :question/id #uuid "5a66344e-2092-5bd6-a4d0-5663f83866b3" :question/math-academy-id "e-7556"} :knowledge-point/id #uuid "93452be9-27a3-5c5d-b4f2-11b6b1896bca" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049112}] :knowledge-point/questions [{:db/id #edb/ref 17592186064699} {:db/id #edb/ref 17592186064891} {:db/id #edb/ref 17592186523966} {:db/id #edb/ref 17592186523974} {:db/id #edb/ref 17592186523977} {:db/id #edb/ref 17592186524020} {:db/id #edb/ref 17592186524037}] :knowledge-point/title "Calculating the Rate of Change of Fluid Level Using Similar Solids"} :step/id #uuid "3221fdfa-82ca-53c8-b3b8-3f64fe8fa9db" :step/math-academy-id 631148 :step/next {:db/id #edb/ref 17592186065332}} {:db/id #edb/ref 17592186065180 :step/content {:db/id #edb/ref 17592186064291 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064134 :question/id #uuid "3de34c88-a367-5e9f-b8de-c46953be4655" :question/math-academy-id "e-7557"} :knowledge-point/id #uuid "1ab44410-8968-52e0-983f-318416a68cb5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048214} {:db/id #edb/ref 17592186048930} {:db/id #edb/ref 17592186049658}] :knowledge-point/questions [{:db/id #edb/ref 17592186064623} {:db/id #edb/ref 17592186064964} {:db/id #edb/ref 17592186523968} {:db/id #edb/ref 17592186523990} {:db/id #edb/ref 17592186523998}] :knowledge-point/title "Calculating a Rate of Change of Volume Given a Rate of Change of Radius or Height"} :step/id #uuid "9d699428-5e3b-56fd-9632-aa59ba1c3b22" :step/math-academy-id 631141 :step/next {:db/id #edb/ref 17592186065331}} {:db/id #edb/ref 17592186065330 :step/content {:db/id #edb/ref 17592186065389 :tutorial/content "We can use differentiation to solve related rates problems in the context of cones. In general, we follow the usual three steps:\n\n**Step 1:** Draw a diagram and identify the variables that change with time.\n\n**Step 2:** Write down a relation between the time-dependent variables.\n\n**Step 3:** Differentiate the relation with respect to time and plug in the known values.\n\nBefore we start, recall that the volume $v$ of a right cone of radius $r$ and height $h$ (shown below) is given by the formula\n\n$$\nv = \\dfrac13 \\pi r^2 h.\n$$\n\n![](images/cf/cf4e3b5b9f0d827bccaee008e006ad62d870fb2d782df8dd94f61bc4a3ca4050.png)" :tutorial/id #uuid "312c7731-2fba-5fc2-9a6b-e551caf483da" :tutorial/math-academy-id 505 :tutorial/title "Introduction"} :step/id #uuid "98362ef7-51a3-58ec-b8a6-e61dd3fe2604" :step/math-academy-id 631140 :step/next {:db/id #edb/ref 17592186065180}} {:db/id #edb/ref 17592186065331 :step/content {:db/id #edb/ref 17592186064387 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064031 :question/id #uuid "808feb74-65a8-5339-b263-f92ef91bfefb" :question/math-academy-id "e-235"} :knowledge-point/id #uuid "4b2d47c1-0f0c-5722-8778-6f2c3236401b" :knowledge-point/questions [{:db/id #edb/ref 17592186064651} {:db/id #edb/ref 17592186064661} {:db/id #edb/ref 17592186523973} {:db/id #edb/ref 17592186523989} {:db/id #edb/ref 17592186524006} {:db/id #edb/ref 17592186524011} {:db/id #edb/ref 17592186524018}] :knowledge-point/title "Calculating a Rate of Change of Radius or Height Given a Rate of Change of Volume"} :step/id #uuid "048a3659-fb35-56bd-968d-481e141e8dc0" :step/math-academy-id 631145 :step/next {:db/id #edb/ref 17592186065179}} {:db/id #edb/ref 17592186065332 :step/content {:db/id #edb/ref 17592186064388 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064032 :question/id #uuid "6ce9d38b-08d9-5372-b501-298970a2f11f