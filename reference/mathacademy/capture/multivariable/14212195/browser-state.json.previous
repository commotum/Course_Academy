      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212195/observations/step-q51396-b7f53dccc5224f86054d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212195/observations/step-q51396-b7f53dccc5224f86054d.png",
      "source_url": "https://mathacademy.com/tasks/14212195/topics/346/lesson",
      "captured_at": 1792001959.4951441,
      "math_academy_id": "q-51396",
      "topic_id": "346",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q51396",
        "placement_id": null,
        "content_id": null,
