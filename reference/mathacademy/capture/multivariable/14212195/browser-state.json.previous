          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:45px;\n                                        margin-left:6px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"13\"><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"15\"><span class=\"mq-numerator\" mathquill-block-id=\"17\"><span mathquill-command-id=\"16\">1</span></span><span class=\"mq-denominator\" mathquill-block-id=\"19\"><span mathquill-command-id=\"18\">9</span><span class=\"mq-nonSymbola\" mathquill-command-id=\"20\">π</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
