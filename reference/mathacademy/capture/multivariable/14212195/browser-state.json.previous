      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212195/observations/step-q2840-63e132cf111c112a7f55.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212195/observations/step-q2840-63e132cf111c112a7f55.png",
      "source_url": "https://mathacademy.com/tasks/14212195/topics/346/lesson",
      "captured_at": 1792001987.0319786,
      "math_academy_id": "q-2840",
      "topic_id": "346",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q2840",
        "placement_id": null,
        "content_id": null,
        "type": null
