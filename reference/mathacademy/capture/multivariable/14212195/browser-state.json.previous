          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:40px;\n                                        margin-left:4px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"35\"><span mathquill-command-id=\"37\">1</span><span mathquill-command-id=\"39\">0</span><span mathquill-command-id=\"41\">8</span><span class=\"mq-nonSymbola\" mathquill-command-id=\"43\">π</span></span></div></div>",
