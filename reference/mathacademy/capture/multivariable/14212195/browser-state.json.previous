      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212195/observations/step-q121675-9b76d9af12fa84317360.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212195/observations/step-q121675-9b76d9af12fa84317360.png",
      "source_url": "https://mathacademy.com/tasks/14212195/topics/346/lesson",
      "captured_at": 1792002010.5083983,
      "math_academy_id": "q-121675",
      "topic_id": "346",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q121675",
        "placement_id": null,
        "content_id": null,
        "type": null
