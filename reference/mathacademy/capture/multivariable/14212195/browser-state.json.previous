      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212195/observations/step-q2558-05c71a7a65bde626ebd3.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212195/observations/step-q2558-05c71a7a65bde626ebd3.png",
      "source_url": "https://mathacademy.com/tasks/14212195/topics/346/lesson",
      "captured_at": 1792001935.824234,
      "math_academy_id": "q-2558",
      "topic_id": "346",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q2558",
        "placement_id": null,
