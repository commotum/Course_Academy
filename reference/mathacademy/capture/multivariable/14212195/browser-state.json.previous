      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212195/observations/step-q346630-6dc84844427755987305.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212195/observations/step-q346630-6dc84844427755987305.png",
      "source_url": "https://mathacademy.com/tasks/14212195/topics/346/lesson",
      "captured_at": 1792002069.4008105,
      "math_academy_id": "q-346630",
      "topic_id": "346",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q346630",
        "placement_id": null,
        "content_id": null,
