      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212195/observations/step-q344973-6a0462ee00c6bf7f3e24.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212195/observations/step-q344973-6a0462ee00c6bf7f3e24.png",
      "source_url": "https://mathacademy.com/tasks/14212195/topics/346/lesson",
      "captured_at": 1792001771.665551,
      "math_academy_id": "q-344973",
      "topic_id": "346",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q344973",
        "placement_id": null,
        "content_id": null,
        "type": null
