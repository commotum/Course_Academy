a6e72d30f4c" #edb/ref 17592186045417] [17592186159518 #edb/ref 1075 #edb/ref 17592186159519 #edb/ref 17592186045417] [17592186159518 #edb/ref 1075 #edb/ref 17592186159520 #edb/ref 17592186045417] [17592186159518 #edb/ref 1075 #edb/ref 17592186159521 #edb/ref 17592186045417] [17592186159518 #edb/ref 1075 #edb/ref 17592186159522 #edb/ref 17592186045417] [17592186159518 #edb/ref 1075 #edb/ref 17592186159523 #edb/ref 17592186045417] [17592186159518 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186159518 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186159518 #edb/ref 1079 #uuid "f5aa534e-872c-5d14-9fdf-a75d8cc80cc7" #edb/ref 17592186045417] [17592186159519 #edb/ref 1080 "0.7114" #edb/ref 17592186045417] [17592186159519 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186159519 #edb/ref 1083 #uuid "afdb9e46-df2d-5e52-b6f0-95adb58b4509" #edb/ref 17592186045417] [17592186159520 #edb/ref 1080 "0.6456" #edb/ref 17592186045417] [17592186159520 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186159520 #edb/ref 1083 #uuid "b5ba2c77-ba5f-5761-ad3b-38a0aad04acf" #edb/ref 17592186045417] [17592186159521 #edb/ref 1080 "0.6312" #edb/ref 17592186045417] [17592186159521 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186159521 #edb/ref 1083 #uuid "1b8db76f-35f7-5303-9c50-3f306965c095" #edb/ref 17592186045417] [17592186159522 #edb/ref 1080 "0.7948" #edb/ref 17592186045417] [17592186159522 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186159522 #edb/ref 1083 #uuid "3ad522d0-a628-59a8-857a-8bfa58ac567f" #edb/ref 17592186045417] [17592186159523 #edb/ref 1080 "0.7872" #edb/ref 17592186045417] [17592186159523 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186159523 #edb/ref 1083 #uuid "4094f713-af01-5640-96e2-8f7909d521d0" #edb/ref 17592186045417] [17592186161675 #edb/ref 1069 "e-10085" #edb/ref 17592186045417] [17592186161675 #edb/ref 1071 "Given that $X_1, X_2, \\ldots, X_{28} \\sim N(8, 14^2)$ is a random sample of size $n = 28$ from a normal population, what is the distribution of the sample mean $\\overline{X}$?" #edb/ref 17592186045417] [17592186161675 #edb/ref 1072 #uuid "cc2a7119-cb80-575b-9e90-d20ea283de5d" #edb/ref 17592186045417] [17592186161675 #edb/ref 1074 "If $X_1, X_2, \\ldots, X_n$ is a random sample of size $n$ from a normal population, where\n\n$$\nX_i \\sim N(\\mu, \\sigma^2), \\qquad 1\\leq i \\leq n\n$$\n\nthen the sample mean $\\overline{X}$ has the distribution\n\n$$\n\\overline{X} \\sim N\\left(\\mu, \\dfrac{\\sigma^2}{n}\\right)\n$$\n\nIn our case, we have\n\n$$\nn = 28, \\qquad \\mu = 8, \\qquad \\sigma = 14\n$$\n\nTherefore, the distribution of the sample mean $\\overline{X}$ is\n\n$$\nX^(―) \\mid ∼N(8, \\frac{14^{2}}{28}); ∼N(8, 7)\n$$" #edb/ref 17592186045417] [17592186161676 #edb/ref 1069 "e-10086" #edb/ref 17592186045417] [17592186161676 #edb/ref 1071 "Given that $X_1, X_2, \\ldots,X_{100} \\sim N(-4, 20^2)$ is a random sample of size $100$ from a normal population, calculate $P(-4.3 \\lt \\overline{X} \\lt -3.9)$.\n\n*Hint: A value table of $\\Phi(z)$ for different values of $z$ is given below, where $\\Phi(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $z$ | $\\, 0.04 \\,$ | $\\, 0.05 \\,$ | $\\, 0.06 \\,$ |\n| --- | ---: | ---: | ---: |\n| $\\, -0.1 \\,$ | $\\, 0.4443 \\,$ | $\\, 0.4404 \\,$ | $\\, 0.4364 \\,$ |\n| $\\, 0.0 \\,$ | $\\, 0.5160 \\,$ | $\\, 0.5199 \\,$ | $\\, 0.5239 \\,$ |\n| $\\, 0.1 \\,$ | $\\, 0.5557 \\,$ | $\\, 0.5596 \\,$ | $\\, 0.5636 \\,$ |" #edb/ref 17592186045417] [17592186161676 #edb/ref 1072 #uuid "82ae81dd-526e-50de-850c-f1623aae21fb" #edb/ref 17592186045417] [17592186161676 #edb/ref 1074 "If $X_1, X_2, \\ldots, X_n$ is a random sample of size $n$ from a normal population, where\n\n$$\nX_i \\sim N(\\mu, \\sigma^2), \\qquad 1\\leq i\\leq n\n$$\n\nthen the sample mean $\\overline{X}$ has the distribution\n\n$$\n\\overline{X} \\sim N\\left(\\mu, \\dfrac{\\sigma^2}{n}\\right)\n$$\n\nTherefore, the distribution of the sample mean $\\overline{X}$ is\n\n$$\nX^(―) \\mid ∼N(-4, \\frac{20^{2}}{100}); ∼N(-4, 4)\n$$\n\nWe're required to find $P(-4.3 \\lt \\overline{X} \\lt -3.9)$.\n\nFirst, we transform $X$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}\nP(-4.3 < X^(―) < - 3.9) &= P((-4.3 - (-4))/(\\sqrt{4}) < Z < (-3.9 - (-4))/(\\sqrt{4})) \\\\\n&= P(-0.15 < Z < 0.05) \\\\\n&= Φ(0.05) - Φ(-0.15)\n\\end{aligned}\n$$\n\nFrom the table, we have\n\n$$\nΦ(0.05) = 0.5199,; Φ(-0.15) = 0.4404\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nP(-0.15 < Z < 0.05) &= Φ(0.05) - Φ(-0.15) \\\\\n&= 0.5199 - 0.4404 \\\\\n&= 0.0795\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186161677 #edb/ref 1069 "e-10087" #edb/ref 17592186045417] [17592186161677 #edb/ref 1071 "The diastolic blood pressure of adult men in a given population is normally distributed with a mean of $75\\,\\text{mm}\\,\\text{Hg}$ and a standard deviation of $10\\,\\text{mm}\\,\\text{Hg}$. Suppose $10$ men are selected at random. What is the probability that the mean diastolic blood pressure for this sample will be less than $70\\,\\text{mm}\\,\\text{Hg}$?\n\n*Hint: A table of values of $\\Phi(z)$ for different values of $z$ is given below, where $\\Phi(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $z$ | $\\, 0.05 \\,$ | $\\, 0.06 \\,$ | $\\, 0.07 \\,$ | $\\, 0.08 \\,$ | $\\, 0.09 \\,$ |\n| --- | ---: | ---: | ---: | ---: | ---: |\n| $\\, -1.5 \\,$ | $\\, 0.0606 \\,$ | $\\, 0.0594 \\,$ | $\\, 0.0582 \\,$ | $\\, 0.0571 \\,$ | $\\, 0.0559 \\,$ |\n| $\\, -1.4 \\,$ | $\\, 0.0735 \\,$ | $\\, 0.0721 \\,$ | $\\, 0.0708 \\,$ | $\\, 0.0694 \\,$ | $\\, 0.0681 \\,$ |\n| $\\, -1.3 \\,$ | $\\, 0.0885 \\,$ | $\\, 0.0869 \\,$ | $\\, 0.0853 \\,$ | $\\, 0.0838 \\,$ | $\\, 0.0823 \\,$ |" #edb/ref 17592186045417] [17592186161677 #edb/ref 1072 #uuid "8cbddf16-bfab-539b-bce1-5ccb59dc4313" #edb/ref 17592186045417] [17592186161677 #edb/ref 1074 "If $X_1,X_2,\\ldots,X_n$ is a random sample of size $n$ from a normal population, where\n\n$$\nX_i\\sim N(\\mu, \\sigma^2), \\qquad 1\\leq i\\leq n\n$$\n\nthen the sample mean $\\overline{X}$ has the distribution\n\n$$\n\\overline{X}\\sim N\\left(\\mu, \\dfrac{\\sigma^2}{n}\\right)\n$$\n\nWe're told that the population mean $\\mu=75$, the population standard deviation\n\n$$\n\\sigma = 10\n$$\n\nand that the sample size $n=10$. Therefore, the distribution of the sample mean $\\overline{X}$ is\n\n$$\nX^(―) \\mid ∼N(75, \\frac{10^{2}}{10}); ∼N(75, 10)\n$$\n\nWe're required to find $P(\\overline{X} \\lt 70)$.\n\nFirst, we transform $X$ into a standard normal random variable $Z$ by $z$-scoring:\n\n$$\n\\begin{aligned}\nP(X^(―) < 70) &= P(Z < \\frac{70 - 75}{\\sqrt{10}}) \\\\\n&\\approx P(Z < - 1.58) \\\\\n&= Φ(-1.58)\n\\end{aligned}\n$$\n\nFrom the table, we have\n\n$$\n\\begin{aligned}\nΦ(-1.58) &= 0.0571\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nP(X^(―) < 70) &= Φ(-1.58) \\\\\n&= 0.0571\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186162109 #edb/ref 1037 #edb/ref 17592186048382 #edb/ref 17592186045417] [17592186162109 #edb/ref 1037 #edb/ref 17592186049674 #edb/ref 17592186045417] [17592186162109 #edb/ref 1037 #edb/ref 17592186050606 #edb/ref 17592186045417] [17592186162109 #edb/ref 1038 #edb/ref 17592186162310 #edb/ref 17592186045417] [17592186162109 #edb/ref 1038 #edb/ref 17592186162385 #edb/ref 17592186045417] [17592186162109 #edb/ref 1039 "Stating the Distribution of the Sample Mean" #edb/ref 17592186045417] [17592186162109 #edb/ref 1041 #edb/ref 17592186161675 #edb/ref 17592186045417] [17592186162109 #edb/ref 1042 #uuid "1af00587-e4c1-5199-828a-357709e69785" #edb/ref 17592186045417] [17592186162110 #edb/ref 1038 #edb/ref 17592186162378 #edb/ref 17592186045417] [17592186162110 #edb/ref 1038 #edb/ref 17592186162386 #edb/ref 17592186045417] [17592186162110 #edb/ref 1039 "Calculati