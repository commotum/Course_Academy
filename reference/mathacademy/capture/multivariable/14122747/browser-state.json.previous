      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14122747/observations/step-q333600-f95a3e6aef41e6e5ac7a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14122747/observations/step-q333600-f95a3e6aef41e6e5ac7a.png",
      "source_url": "https://mathacademy.com/tasks/14122747/topics/3239/lesson",
      "captured_at": 1791749625.178964,
      "math_academy_id": "q-333600",
