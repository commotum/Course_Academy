      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14122747/observations/step-q333025-dea941fa1d1e72022aa2.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14122747/observations/step-q333025-dea941fa1d1e72022aa2.png",
      "source_url": "https://mathacademy.com/tasks/14122747/topics/3239/lesson",
      "captured_at": 1791749354.4596791,
      "math_academy_id": "q-333025",
      "topic_id": "3239",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q333025",
        "placement_id": null,
        "content_id": null,
