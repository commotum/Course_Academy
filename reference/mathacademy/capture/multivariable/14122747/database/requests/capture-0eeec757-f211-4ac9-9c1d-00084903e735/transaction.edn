answer-field/validate]} {:db/id "answer-b5536c65-476d-593f-b4ba-d00a4bbec848" :answer/id #uuid "b5536c65-476d-593f-b4ba-d00a4bbec848" :answer/type :answer.type/math :answer/value "{\\lambda }_{1}=5" :db/ensure [:answer/validate]} {:db/id "answer-5789e49e-18ca-5c57-8de8-b53a39ea47bc" :answer/id #uuid "5789e49e-18ca-5c57-8de8-b53a39ea47bc" :answer/type :answer.type/math :answer/value "{\\lambda }_{2}=2" :db/ensure [:answer/validate]} {:db/id "answer-field-777de30a-aa44-54ed-8d83-95b4ecacddbb" :answer-field/id #uuid "777de30a-aa44-54ed-8d83-95b4ecacddbb" :answer-field/key "field-10" :answer-field/type :answer-field.type/select :answer-field/correct "answer-0c90deb3-1281-549a-b9ec-dd098c7da22e" :answer-field/choices ["answer-0c90deb3-1281-549a-b9ec-dd098c7da22e" "answer-065efdb1-4ae6-597a-a0e1-aae8bc0611d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-0c90deb3-1281-549a-b9ec-dd098c7da22e" :answer/id #uuid "0c90deb3-1281-549a-b9ec-dd098c7da22e" :answer/type :answer.type/math :answer/value "{v}_{1}" :db/ensure [:answer/validate]} {:db/id "answer-065efdb1-4ae6-597a-a0e1-aae8bc0611d8" :answer/id #uuid "065efdb1-4ae6-597a-a0e1-aae8bc0611d8" :answer/type :answer.type/math :answer/value "{v}_{2}" :db/ensure [:answer/validate]} {:db/id "question-a8dac9e3-6d64-5716-8812-6c8cce0790e7" :question/id #uuid "a8dac9e3-6d64-5716-8812-6c8cce0790e7" :question/math-academy-id "q-333600" :question/problem "![](images/45/450d43a4cbf6dad8d54edbb66fc4a6e44e491290e1dc5d1303057fb0eb7928a7.png)\n\nThe phase portrait for a system of linear differential equations whose matrix has two real, distinct eigenvalues is shown above.\nThe eigenvalues of the system's matrix are ${\\lambda }_{1}$ and ${\\lambda }_{2},$ for which the corresponding eigenvectors are ${v}_{1}=[-1,\\text{ }1]^{T}$ and ${v}_{2}=[-1,\\text{ }2]^{T},$ respectively. \nSelect the correct options in the reasoning below.\n\nThe line that passes through the origin and is parallel to ${v}_{1}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$ has the equation \n\n$$\ny={{field-1}}.\n$$\n\nThe tangents along this line are pointing \n{{field-2}},\nmeaning that the solutions of the form \n${c}_{1}{e}^{{\\lambda }_{1}t}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$\nmust approach \n{{field-3}} \nas $t\\to \\infty .$ So, we must have \n{{field-4}}.\n\nThe line that passes through the origin and is parallel to ${v}_{2}=[\\begin{aligned}-1 \\\\ 2\\end{aligned}]$ has the equation \n\n$$\ny={{field-5}}.\n$$\n\nThe tangents along this line are pointing \n{{field-6}},\nmeaning that the solutions of the form \n${c}_{2}{e}^{{\\lambda }_{2}t}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]$\nmust approach \n{{field-7}} \nas $t\\to \\infty .$ So, we must have \n{{field-8}}.\n\nFinally, since the solutions become parallel to the straight-line solution containing the vector {{field-9}} as they move away from the origin, the dominant eigenvalue is \n{{field-10}}.\n\nTherefore,\n{{field-11}} \n$>0.$" :question/worked-solution "The straight-line solutions of the system have the form\n\n$$\n{c}_{1}{e}^{{\\lambda }_{1}t}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\\,\\text{and}\\,{c}_{2}{e}^{{\\lambda }_{2}t}[\\begin{aligned}-1 \\\\ 2\\end{aligned}].\n$$\n\nThe line that passes through the origin and is parallel to ${v}_{1}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$ has the equation \n\n$$\ny=-x,\n$$\n\nas shown below.\n\n![](images/2d/2dace7c4f02fa0575d70264f33805d15470fa0894622c4d26d80fc1221aa2c54.png)\n\nThe tangents along this line are pointing $\\text{away from the origin},$ meaning that the solutions of the form \n${c}_{1}{e}^{{\\lambda }_{1}t}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$\nmust approach $\\text{infinity}$ as $t\\to \\infty .$ So, we must have ${\\lambda }_{1}>0.$\n\nThe line that passes through the origin and is parallel to ${v}_{1}=[\\begin{aligned}-1 \\\\ 2\\end{aligned}]$ has the equation \n\n$$\ny=-2x,\n$$\n\nas shown below.\n\n![](images/40/40f0bf749448807b1a3aa2b593ae2e30acf26fabedbdc45da75e338e84c328f2.png)\n\nThe tangents along this line are pointing $\\text{away from the origin},$ meaning that the solutions of the form \n${c}_{2}{e}^{{\\lambda }_{2}t}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]$\nmust approach $\\text{infinity}$ as $t\\to \\infty .$ So, we must have ${\\lambda }_{2}>0.$\n\nSo, for this particular system, both eigenvalues are positive. The dominant eigenvalue is the one with the greatest magnitude.\n\nNow, since the solutions become parallel to the straight-line solution containing the vector ${v}_{2}$ as they move away from the origin, the dominant eigenvalue is ${\\lambda }_{2}.$\n\nTherefore, ${\\lambda }_{2}>{\\lambda }_{1}>0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a23b4281-2904-51d2-a2ec-b3660701c2f1" "answer-field-6c82251b-6774-50cb-9563-6cb452907815" "answer-field-bbc96424-f0c8-5bc9-8842-b01fc21c605b" "answer-field-e96b3b83-4377-53a0-8ef9-b0ddb316497b" "answer-field-62c78368-e65c-5c98-b6d6-6209cb87fc85" "answer-field-7778189e-6a37-562c-9a4a-ce12bfff45c5" "answer-field-c7fadd16-1df1-54db-bc2c-557590055356" "answer-field-a41ac7e5-271d-582c-a9f6-515d85bb490d" "answer-field-27bb3c8c-d5b4-5c32-878a-2198b808f869" "answer-field-1e0b93c0-ad48-5a0d-b8cd-df81f372ed71" "answer-field-50aeeefd-3e1f-559b-a54b-155bd5533ed2"] :db/ensure [:question/validate]} {:db/id "answer-field-a23b4281-2904-51d2-a2ec-b3660701c2f1" :answer-field/id #uuid "a23b4281-2904-51d2-a2ec-b3660701c2f1" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-ea66de7a-a700-59b0-abce-4fc92e0cdd18" :answer-field/choices ["answer-7099bb1f-70fb-5a13-be54-dc34307442bb" "answer-14bae1e9-097e-5ed8-a769-fe178a4d51f7" "answer-ea66de7a-a700-59b0-abce-4fc92e0cdd18" "answer-017b9ef2-69f3-5607-98dd-c04ffd4f5965"] :db/ensure [:answer-field/validate]} {:db/id "answer-7099bb1f-70fb-5a13-be54-dc34307442bb" :answer/id #uuid "7099bb1f-70fb-5a13-be54-dc34307442bb" :answer/type :answer.type/math :answer/value 