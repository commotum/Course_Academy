      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14267734/observations/step-q213177-6c0a66b9e9123459165c.png",
      "source_url": "https://mathacademy.com/tasks/14267734/topics/4837/lesson",
