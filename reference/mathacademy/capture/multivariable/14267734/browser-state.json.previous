      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14267734/observations/step-q213257-2fc703f3c38b16491b2f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14267734/observations/step-q213257-2fc703f3c38b16491b2f.png",
