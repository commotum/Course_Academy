height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mi>z</mi></mpadded></mstyle><mo stretchy=\"false\">)</mo><mo>,</mo><mo stretchy=\"false\">(</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mi>y</mi></mpadded></mstyle><mo>,</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mo>,</mo><mo stretchy=\"false\">(</mo><mi>z</mi><mo>,</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mi>x</mi></mpadded></mstyle><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">}</mo></mrow></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
