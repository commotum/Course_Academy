9534520 17592186045417 true] [17592186424094 1083 #uuid "aa971f18-d59c-541a-a8c1-bc17ca502230" 13194139534520 17592186045417 true] [17592186424095 1080 "2" 13194139534520 17592186045417 true] [17592186424095 1082 #edb/ref 17592186045498 13194139534520 17592186045417 true] [17592186424095 1083 #uuid "b0ca885d-c4f1-58d6-b2f7-daed73d87732" 13194139534520 17592186045417 true] [17592186424096 1075 #edb/ref 17592186424091 13194139534520 17592186045417 true] [17592186424096 1075 #edb/ref 17592186424092 13194139534520 17592186045417 true] [17592186424096 1075 #edb/ref 17592186424093 13194139534520 17592186045417 true] [17592186424096 1075 #edb/ref 17592186424094 13194139534520 17592186045417 true] [17592186424096 1075 #edb/ref 17592186424095 13194139534520 17592186045417 true] [17592186424096 1076 #edb/ref 17592186045493 13194139534520 17592186045417 true] [17592186424096 1077 "selection" 13194139534520 17592186045417 true] [17592186424096 1078 #edb/ref 17592186424095 13194139534520 17592186045417 true] [17592186424096 1079 #uuid "bf3ea97d-4f26-5777-a472-6a585002f0c5" 13194139534520 17592186045417 true] [17592186424097 1068 #edb/ref 17592186424096 13194139534520 17592186045417 true] [17592186424097 1069 "q-125729" 13194139534520 17592186045417 true] [17592186424097 1070 #edb/ref 17592186045485 13194139534520 17592186045417 true] [17592186424097 1071 "Consider the scalar field $f(x,y)={x}^{2}-2{y}^{3}.$ Calculate ${\\int }_{C}∇f\\cdot \\text{d}r,$ where $C$ is any smooth path from $(-4,1)$ to $(0,-2)$ in ${R}^{2}.$" 13194139534520 17592186045417 true] [17592186424097 1072 #uuid "af7a572f-0636-5725-9441-ef6582928ab9" 13194139534520 17592186045417 true] [17592186424097 1074 "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nIn our case, the coordinates of the endpoints of the path $C$ are $A(-4,1)$ and $B(0,-2).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(0,-2)-f(-4,1) \\\\  & =({0}^{2}-2(-2)^{3})-((-4)^{2}-2(1)^{3}) \\\\  & =16-16+2 \\\\  & =2.\\end{aligned}\n$$" 13194139534520 17592186045417 true] [17592186424098 1058 #edb/ref 17592186424099 13194139534520 17592186045417 true] [17592186424098 1062 #uuid "342f3d25-ce3a-5f3c-b57d-c4d0387248ff" 13194139534520 17592186045417 true] [17592186424098 1063 #edb/ref 17592186259848 13194139534520 17592186045417 true] [17592186424099 1058 #edb/ref 17592186424101 13194139534520 17592186045417 true] [17592186424099 1062 #uuid "64a5e538-5a25-5466-a330-6b9f2d52b686" 13194139534520 17592186045417 true] [17592186424099 1063 #edb/ref 17592186424097 13194139534520 17592186045417 true] [17592186424100 1058 #edb/ref 17592186424102 13194139534520 17592186045417 true] [17592186424100 1062 #uuid "9d21a388-bd37-58ca-99a7-53b6bd2958a7" 13194139534520 17592186045417 true] [17592186424100 1063 #edb/ref 17592186259851 13194139534520 17592186045417 true] [17592186424101 1058 #edb/ref 17592186424100 13194139534520 17592186045417 true] [17592186424101 1062 #uuid "bf2721f1-961a-51a7-9951-c9a433cd01de" 13194139534520 17592186045417 true] [17592186424101 1063 #edb/ref 17592186259850 13194139534520 17592186045417 true] [17592186424102 1062 #uuid "fdf40bb8-48bd-542e-b098-e878dafa270b" 13194139534520 17592186045417 true] [17592186424102 1063 #edb/ref 17592186259857 13194139534520 17592186045417 true]] :edb/tempids {"activity-a2243f17-089c-5e52-a019-0035fd16e9e3" 17592186424090 "answer-1a818aab-75ac-5369-aa04-7b5968c78bdd" 17592186424091 "answer-5b41497c-0b03-518e-b827-be965cbad