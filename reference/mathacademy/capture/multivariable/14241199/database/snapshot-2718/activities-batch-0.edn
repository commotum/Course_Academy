\\sqrt{2} & -4\\sqrt{2} \\\\ 0 & 2\\end{bmatrix},\\,b=\\begin{bmatrix}9 \\\\ 9 \\\\ 2\\end{bmatrix}.\n$$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}Ax={A}^{T}b\n$$\n\nSubstituting $A=QR,$ we obtain\n\n$$\n\\begin{aligned}{A}^{T}Ax & ={A}^{T}b \\\\ (QR)^{T}QRx & =(QR)^{T}b \\\\ {R}^{T}({Q}^{T}Q)Rx & ={R}^{T}{Q}^{T}b.\\end{aligned}\n$$\n\nSince $Q$ has orthonormal columns, ${Q}^{T}Q=I,$ and we get\n\n$$\n{R}^{T}Rx={R}^{T}\\,{Q}^{T}b.\n$$\n\nFinally, since ${R}^{T}$ is invertible, pre-multiplying by $({R}^{T})^{-1}$ gives\n\n$$\n\\begin{aligned}({R}^{T})^{-1}\\cdot {R}^{T}Rx & =({R}^{T})^{-1}\\cdot {R}^{T}{Q}^{T}b \\\\ Rx & ={Q}^{T}b.\\end{aligned}\n$$\n\nNow, substituting our matrices, we have\n\n$$\n\\begin{aligned}\\overset{R}{\\overset{⏞}{\\frac{1}{3\\sqrt{2}}\\begin{bmatrix}3\\sqrt{2} & -4\\sqrt{2} \\\\ 0 & 2\\end{bmatrix}}}x & =\\overset{{Q}^{T}}{\\overset{⏞}{\\frac{1}{3\\sqrt{2}}\\begin{bmatrix}2\\sqrt{2} & 2\\sqrt{2} & \\sqrt{2} \\\\ -1 & -1 & 4\\end{bmatrix}}}\\overset{b}{\\overset{⏞}{\\begin{bmatrix}9 \\\\ 9 \\\\ 2\\end{bmatrix}}} \\\\ \\begin{bmatrix}3\\sqrt{2} & -4\\sqrt{2} \\\\ 0 & 2\\end{bmatrix}x & =\\begin{bmatrix}38\\sqrt{2} \\\\ -10\\end{bmatrix}\\end{aligned}\n$$\n\nwhich gives the system\n\n$$\n\\left\\{\\begin{aligned}3\\sqrt{2}{x}_{1}-4\\sqrt{2}{x}_{2} &=38\\sqrt{2} \\\\ 2{x}_{2} &=-10.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=-5.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}3\\sqrt{2}{x}_{1}-4\\sqrt{2}(-5) & =38\\sqrt{2} \\\\ 3\\sqrt{2}{x}_{1} & =18\\sqrt{2} \\\\ {x}_{1} & =6.\\end{aligned}\n$$\n\nTherefore, the least-squares solution to $Ax=b$ is $\\begin{bmatrix}6 \\\\ -5\\end{bmatrix}.$"} :step/id #uuid "1c7fbdd9-d70e-53c6-9583-045def1fb610" :step/next {:db/id #edb/ref 17592186510507}} {:db/id #edb/ref 17592186510507 :step/content {:db/id #edb/ref 17592186510447 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1a00c1-8450-5a4b-9a89-eeb5fc22d5e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-10 \\\\ 20\\end{aligned}]" :db/id #edb/ref 17592186509711} {:answer/id #uuid "3c4ffb51-6024-5d55-874c-2de6b98d1d70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}10 \\\\ 30\\end{aligned}]" :db/id #edb/ref 17592186509818} {:answer/id #uuid "4c400c42-935c-5527-acc8-5171e1a58778" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-10 \\\\ 30\\end{aligned}]" :db/id #edb/ref 17592186509845} {:answer/id #uuid "a7d240b2-f0ec-5826-be4a-8f21e8f0a799" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}10 \\\\ -10\\end{aligned}]" :db/id #edb/ref 17592186510043} {:answer/id #uuid "d1f82732-0e5a-5d26-9566-a09f36539763" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}20 \\\\ 30\\end{aligned}]" :db/id #edb/ref 17592186510135}] :answer-field/correct {:db/id #edb/ref 17592186510043} :answer-field/id #uuid "9c12bf5a-62dd-517a-86dc-485e43650a01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186510316}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c07b8d08-df25-5edc-8755-7d7271698aeb" :question/math-academy-id "q-157078" :question/problem "Given the QR decomposition $A=QR,$ find the least-squares solution to $Ax=b,$ where\n\n$$\nQ=\\frac{1}{\\sqrt{70}}[\\begin{aligned}\\sqrt{5} & \\sqrt{2} \\\\ 3\\sqrt{5} & 3\\sqrt{2} \\\\ 2\\sqrt{5} & -5\\sqrt{2}\\end{aligned}],\\,R=\\frac{1}{\\sqrt{70}}[\\begin{aligned}\\sqrt{5} & 2\\sqrt{5} \\\\ 0 & \\sqrt{2}\\end{aligned}],\\,b=[\\begin{aligned}-1 \\\\ -3 \\\\ 0\\end{aligned}].\n$$" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}Ax={A}^{T}b\n$$\n\nSubstituting $A=QR,$ we obtain\n\n$$\n\\begin{aligned}{A}^{T}Ax & ={A}^{T}b \\\\ (QR)^{T}QRx & =(QR)^{T}b \\\\ {R}^{T}({Q}^{T}Q)Rx & ={R}^{T}{Q}^{T}b.\\end{aligned}\n$$\n\nSince $Q$ has orthonormal columns, ${Q}^{T}Q=I,$ and we get\n\n$$\n{R}^{T}Rx={R}^{T}\\,{Q}^{T}b.\n$$\n\nFinally, since ${R}^{T}$ is invertible, pre-multiplying by $({R}^{T})^{-1}$ gives\n\n$$\n\\begin{aligned}({R}^{T})^{-1}\\cdot {R}^{T}Rx & =({R}^{T})^{-1}\\cdot {R}^{T}{Q}^{T}b \\\\ Rx & ={Q}^{T}b.\\end{aligned}\n$$\n\nNow, substituting our matrices, we have\n\n$$\n\\begin{aligned}\\overset{R}{\\overset{⏞}{\\frac{1}{\\sqrt{70}}[\\begin{aligned}\\sqrt{5} & 2\\sqrt{5} \\\\ 0 & \\sqrt{2}\\end{aligned}]}}x & =\\overset{{Q}^{T}}{\\overset{⏞}{\\frac{1}{\\sqrt{70}}[\\begin{aligned}\\sqrt{5} & 3\\sqrt{5} & 2\\sqrt{5} \\\\ \\sqrt{2} & 3\\sqrt{2} & -5\\sqrt{2}\\end{aligned}]}}\\overset{b}{\\overset{⏞}{[\\begin{aligned}-1 \\\\ -3 \\\\ 0\\end{aligned}]}} \\\\ [\\begin{aligned}\\sqrt{5} & 2\\sqrt{5} \\\\ 0 & \\sqrt{2}\\end{aligned}]x & =[\\begin{aligned}-10\\sqrt{5} \\\\ -10\\sqrt{2}\\end{aligned}]\\end{aligned}\n$$\n\nwhich gives the system\n\n$$\n\\left\\{\\begin{aligned}\\sqrt{5}{x}_{1}+2\\sqrt{5}{x}_{2} &=-10\\sqrt{5} \\\\ \\sqrt{2}{x}_{2} &=-10\\sqrt{2}.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=-10.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}\\sqrt{5}{x}_{1}+2\\sqrt{5}(-10) & =-10\\sqrt{5} \\\\ \\sqrt{5}{x}_{1} & =10\\sqrt{5} \\\\ {x}_{1} & =10.\\end{aligned}\n$$\n\nTherefore, the least-squares solution to $Ax=b$ is $[\\begin{aligned}10 \\\\ -10\\end{aligned}].$"} :step/id #uuid "58faa96e-dfec-57d8-91b9-fd2fd0bd774a"} {:db/id #edb/ref 17592186510555 :step/content {:db/id #edb/ref 17592186510449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2aaeec0e-9d7d-51b5-8e98-ca8703231590" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{Q}^{T}" :db/id #edb/ref 17592186509775} {:answer/id #uuid "5a928cee-21d3-53ca-ace1-76f33e1c43e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Q" :db/id #ed