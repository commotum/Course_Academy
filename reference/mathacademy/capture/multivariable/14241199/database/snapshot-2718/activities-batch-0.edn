/id #edb/ref 17592186475933} {:db/id #edb/ref 17592186475975} {:db/id #edb/ref 17592186515570}] :knowledge-point/title "Finding the Intersection Point of a Line and a Plane Given in Other Forms"} :step/id #uuid "5e30a524-692f-5456-b232-21ecbec49f72" :step/math-academy-id 17933} {:db/id #edb/ref 17592186120723 :step/content {:db/id #edb/ref 17592186119838 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119652 :question/id #uuid "f952e670-a673-5c15-913b-c396e8885142" :question/math-academy-id "e-4945"} :knowledge-point/id #uuid "82e761b5-ec1c-549d-b726-e0909cfe460b" :knowledge-point/questions [{:db/id #edb/ref 17592186120289} {:db/id #edb/ref 17592186120290} {:db/id #edb/ref 17592186244121} {:db/id #edb/ref 17592186244122} {:db/id #edb/ref 17592186244124} {:db/id #edb/ref 17592186342127} {:db/id #edb/ref 17592186342128} {:db/id #edb/ref 17592186399622} {:db/id #edb/ref 17592186399629} {:db/id #edb/ref 17592186403745} {:db/id #edb/ref 17592186475922} {:db/id #edb/ref 17592186475941} {:db/id #edb/ref 17592186475955} {:db/id #edb/ref 17592186484201} {:db/id #edb/ref 17592186516797} {:db/id #edb/ref 17592186516801}] :knowledge-point/title "Finding the Intersection Point of a Line in Parametric Form and a Plane in Cartesian Form"} :step/id #uuid "58f5efb4-ec29-5ce2-8705-052ae48be5fc" :step/math-academy-id 17934 :step/next {:db/id #edb/ref 17592186120722}}] :activity/title "The Intersection Between a Line and a Plane" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120019}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186484337} :activity/id #uuid "77955475-06cd-58a4-a89c-cfc9a4ad253a" :activity/scope {:db/id #edb/ref 17592186050148 :topic/id #uuid "30d88a85-9b00-5b6d-90cc-41ac3f6c9da8" :topic/math-academy-id 1808} :activity/steps [{:db/id #edb/ref 17592186484300 :step/content {:db/id #edb/ref 17592186342129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e017315-e476-5fa0-8361-dc00652a6489" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,0,1)" :db/id #edb/ref 17592186340405} {:answer/id #uuid "ad64653c-387b-56c4-988a-77711f82ccae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186340706} {:answer/id #uuid "af463bcf-e431-5d1e-a420-7660e1b98031" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,-5,4)" :db/id #edb/ref 17592186340726} {:answer/id #uuid "d8153fa3-e604-533d-b56e-b26114f3d4d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,1,5)" :db/id #edb/ref 17592186341045} {:answer/id #uuid "f86bd550-c5e7-5c4a-ad94-8436818324a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-5,4,2)" :db/id #edb/ref 17592186341326}] :answer-field/correct {:db/id #edb/ref 17592186341045} :answer-field/id #uuid "9343b686-98f1-53b8-a0c6-e7d798a3b52a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341638}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "156769fc-4325-56fe-a6f3-a488d1baa118" :question/math-academy-id "q-74004" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨3,1,5⟩+w⟨-2,-5,4⟩,\\,Π:r=⟨-5,4,2⟩+s⟨0,3,1⟩+t⟨2,0,1⟩.\n$$" :question/worked-solution "From the equation of a plane in the parametric form $r=p+tv+sw$, we have that its normal vector is $n=v\\times w.$ In our case, the normal vectors to $Π$ is\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =⟨0,3,1⟩\\times ⟨2,0,1⟩ \\\\  & =|\\begin{aligned}i & j & k \\\\ 0 & 3 & 1 \\\\ 2 & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 1 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}|j+|\\begin{aligned}0 & 3 \\\\ 2 & 0\\end{aligned}|k \\\\  & =3i+2j-6k \\\\  & =⟨3,2,-6⟩.\\end{aligned}\n$$\n\nTherefore, the equation of the plane $Π$ in dot product form is\n\n$$\n\\begin{aligned}r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,2,-6⟩ & =⟨-5,4,2⟩\\cdot ⟨3,2,-6⟩ \\\\ r\\cdot ⟨3,2,-6⟩ & =-19.\\end{aligned}\n$$\n\nNow, substituting $r=⟨3,1,5⟩+w⟨-2,-5,4⟩$ into the equation of the plane in dot product form, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨3,2,-6⟩ & =-19 \\\\ ⟨3-2w,1-5w,5+4w⟩\\cdot ⟨3,2,-6⟩ & =-19 \\\\ 3(3-2w)+2(1-5w)-6(5+4w) & =-19 \\\\ 9-6w+2-10w-30-24w & =-19 \\\\ -40w & =0 \\\\ w & =0.\\end{aligned}\n$$\n\nFinally, to get the position vector $q$ of the intersection point $Q,$ we substitute $w=0$ into the equation of the line:\n\n$$\n\\begin{aligned}q & =⟨3-2(0),1-5(0),5+4(0)⟩ \\\\  & =⟨3,1,5⟩\\end{aligned}\n$$\n\nSo, the intersection point is $Q(3,1,5).$"} :step/id #uuid "0227058d-e862-5e31-b5c8-bea4849a37b5" :step/next {:db/id #edb/ref 17592186484327}} {:db/id #edb/ref 17592186484313 :step/content {:db/id #edb/ref 17592186342127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b2ccf68-fbc4-58ea-80f0-c47a1f4e61c5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186339365} {:answer/id #uuid "1d364631-26c0-59a4-93c9-0842ba8027a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(19,10,16)" :db/id #edb/ref 17592186339381} {:answer/id #uuid "2bfe2f6a-4b05-5041-9be9-ec95d41ced84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(18,8,12)" :db/id #edb/ref 17592186339510} {:answer/id #uuid "90fc5ea2-94e0-5824-91af-e274368bde07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(18,11,16)" :db/id #edb/ref 17592186340429} {:answer/id #uuid "a5f82de1-4dec-5d15-9285-344580d1aa1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8,-1,6)" :db/id #edb/ref 17592186340633}] :answer-field/correct {:db/id #edb/ref 17592186340429} :answer-field/id #uuid "3769c405-5ffb-59ea-8180-d6fbf6837b56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341479}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8a17e320-306c-50fa-b84b-f8cbe958e629" :question/math-academy-id "q-73993" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\left\\{\\begin{aligned}x &=3-5t \\\\ y &=2-3t \\\\ z &=-2-6t\\end{aligned}\\right.\\,\\text{and}\\,Π:5x-2y+4z-132=0.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}5x-2y+4z-132 & =0 \\\\ 5(3-5t)-2(2-3t)+4(-2-6t) & =132 \\\\ 15-25t-4+6t-8-24t & =132 \\\\ -43t & =129 \\\\ t & =-3\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=-3$ into the parametric equations of the line:\n\n$$\n\\left\\{\\begin{aligned}x &=3-5(-3)=18 \\\\ y &=2-3(-3)=11 \\\\ z &=-2-6(-3)=16\\end{aligned}\\right.\n$$\n\nSo, the intersection point is  $P(18,11,16).$"} :step/id #uuid "3315e388-6b5a-5594-b5f3-c37c6118ed26" :step/next {:db/id #edb/ref 17592186484300}} {:db/id #edb/ref 17592186484327 :step/content {:db/id #edb/ref 17592186475912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "007d69dc-a2ca-580f-b0f7-74cbcfa1ebdd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186475444} {:answer/id #uuid "3a25e529-3954-5987-92eb-d533381cc44b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(25,31,-6)" :db/id #edb/ref 17592186475523} {:answer/id #uuid "52af092c-e727-5f18-8ff7-345347fe6d51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-8,-13,5)" :db/id #edb/ref 17592186475562} {:answer/id #uuid "572842f6-cb5d-5a22-b2c9-50266f22eb6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(13,15,-2)" :db/id #edb/ref 17592186475570} {:answer/id #uuid "fca47535-789f-5b0b-98b2-271a04ca1b25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-14,-21,7)" :db/id #edb/ref 17592186475823}] :answer-field/correct {:db/id #edb/ref 17592186475523} :answer-field/id #uuid "d8937436-576e-5320-a137-6b981c96167e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186475895}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "07e33caa-9650-5834-8d9a-46cc82f723d1" :question/math-academy-id "q-108434" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨1,-1,2⟩+w⟨3,4,-1⟩,\\,Π:r=⟨5,3,-4⟩+s⟨1,0,2⟩+t⟨0,-2,3⟩.\n$$" :question/worked-solution "From the equation of a plane in the parametric form $r=p+tv+sw$, we have that its normal vector is $n=v\\times w.$ In our case, the normal vectors to $Π$ is\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =⟨1,0,2⟩\\times ⟨0,-2,3⟩ \\\\  & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 2 \\\\ 0 & -2 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 2 \\\\ -2 & 3\\end{aligned}|i-|\\begin{aligned}1 & 2 \\\\ 0 & 3\\end{aligned}|j+|\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}|k \\\\  & =4i-3j-2k \\\\  & =⟨4,-3,-2⟩.\\end{aligned}\n$$\n\nTherefore, the equation of the plane $Π$ in dot product form is\n\n$$\n\\begin{aligned}r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨4,-3,-2⟩ & =⟨5,3,-4⟩\\cdot ⟨4,-3,-2⟩ \\\\ r\\cdot ⟨4,-3,-2⟩ & =19.\\end{aligned}\n$$\n\nNow, substituting $r=⟨1,-1,2⟩+w⟨3,4,-1⟩$ into the equation of the plane in dot product form, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨4,-3,-2⟩ & =19 \\\\ ⟨1+3w,-1+4w,2-w⟩\\cdot ⟨4,-3,-2⟩ & =19 \\\\ 4(1+3w)-3(-1+4w)-2(2-w) & =19 \\\\ 4+12w+3-12w-4+2w & =19 \\\\ 2w & =16 \\\\ w & =8.\\end{aligned}\n$$\n\nFinally, to get the position vector $q$ of the intersection point $Q,$ we substitute $w=8$ into the equation of the line:\n\n$$\n\\begin{aligned}q & =⟨1+3(8),-1+4(8),2-8⟩ \\\\  & =⟨25,31,-6⟩\\end{aligned}\n$$\n\nSo, the intersection point is $Q(25,31,-6).$"} :step/id #uuid "6a1f4ccb-dfb0-5de6-aea8-7109eb01b3fc"} {:db/id #edb/ref 17592186484330 :step/content {:db/id #edb/ref 17592186484201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20fc86f8-0368-54eb-a3e0-3cf6b0379332" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-16,-16,13)" :db/id #edb/ref 17592186483621} {:answer/id #uuid "2143e54b-67d5-5002-957a-3bf88c230ca4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(24,-11,11)" :db/id #edb/ref 17592186483624} {:answer/id #uuid "257b548a-b52d-5b2d-8a2f-57d74b50d39c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186483630} {:answer/id #uuid "7944f3e7-3b31-5e5a-b5cb-a1562208eb42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(11,-13,11)" :db/id #edb/ref 17592186483813} {:answer/id #uuid "a0a4f2b9-c6e0-5e67-8ab6-66d592472d45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(26,12,12)" :db/id #edb/ref 17592186483899}] :answer-field/correct {:db/id #edb/ref 17592186483621} :answer-field/id #uuid "15f90597-4c03-5ae4-b2c2-f42eae091087" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484091}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "12b4f5c6-720f-5c2c-b1e8-295eb7dcb29c" :question/math-academy-id "q-73991" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\left\\{\\begin{aligned}x &=-2-2t \\\\ y &=5-3t \\\\ z &=-1+2t\\end{aligned}\\right.\\,\\text{and}\\,Π:3x-2y+6z=62.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}3x-2y+6z & =62 \\\\ 3(-2-2t)-2(5-3t)+6(-1+2t) & =62 \\\\ -6-6t-10+6t-6+12t & =62 \\\\ 12t & =84 \\\\ t & =7\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=6$ into the parametric equations of the line:\n\n$$\n\\left\\{\\begin{aligned}x &=-2-2(7)=-16 \\\\ y &=5-3(7)=-16 \\\\ z &=-1+2(7)=13\\end{aligned}\\right.\n$$\n\nSo, the intersection point is $P(-16,-16,13).$"} :step/id #uuid "77b76b91-5e55-576f-a898-b871a06b8ed3" :step/next {:db/id #edb/ref 17592186484313}} {:db/id #edb/ref 17592186484337 :step/content {:db/id #edb/ref 17592186120290 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a523b91-b0c8-5d77-ac05-a918d500094c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-9,9,7)" :db/id #edb/ref 17592186312052} {:answer/id #uuid "82d8d2f3-12d7-5f69-9c67-b4d2db7dc5da" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186313028} {:answer/id #uuid "8d14825a-42af-51a3-9f03-b6163ac5f748" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,-1,3)" :db/id #edb/ref 17592186313102} {:answer/id #uuid "95ed7638-8aa8-5f1b-b639-82099d0d033c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9,7,-9)" :db/id #edb/ref 17592186313173} {:answer/id #uuid "c5ba162d-d3e7-561c-ba10-731b0f92f98b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9,-9,7)" :db/id #edb/ref 17592186313525}] :answer-field/correct {:db/id #edb/ref 17592186313525} :answer-field/id #uuid "0d7ba987-d1b7-522f-859e-b04e23ff46bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186314051}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c755ffbb-8374-5c52-a967-a6387ef6da9c" :question/math-academy-id "q-33992" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\left\\{\\begin{aligned}x &=5-2t \\\\ y &=-1+4t \\\\ z &=-3-5t\\end{aligned}\\right.\\,\\text{and}\\,Π:2x-5y+3z-84=0.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}2x-5y+3z-84 & =0 \\\\ 2(5-2t)-5(-1+4t)+3(-3-5t) & =84 \\\\ 10-4t+5-20t-9-15t & =84 \\\\ -39t & =78 \\\\ t & =-2\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=-2$ into the parametric equations of the line:\n\n$$\n\\left\\{\\begin{aligned}x &=5-2(-2)=9 \\\\ y &=-1+4(-2)=-9 \\\\ z &=-3-5(-2)=7\\end{aligned}\\right.\n$$\n\nSo, the intersection point is  $P(9,-9,7).$"} :step/id #uuid "a9c592be-dcfe-59b6-a857-234bdfcf6a00" :step/next {:db/id #edb/ref 17592186484330}}] :activity/title "The Intersection Between a Line and a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186483561}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186516909} :activity/id #uuid "a05a4f34-cba1-54e4-b6a6-f7ada8846659" :activity/scope {:db/id #edb/ref 17592186050148 :topic/id #uuid "30d88a85-9b00-5b6d-90cc-41ac3f6c9da8" :topic/math-academy-id 1808} :activity/steps [{:db/id #edb/ref 17592186516900 :step/content {:db/id #edb/ref 17592186516801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140b7152-7be6-5b10-b162-4dcea3796757" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(23,5,6)" :db/id #edb/ref 17592186516151} {:answer/id #uuid "7062112e-23e0-5023-abc6-42331af0e0bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,50,6)" :db/id #edb/ref 17592186516364} {:answer/id #uuid "739dc482-cca6-5907-b91b-15164a66f7c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(32,50,16)" :db/id #edb/ref 17592186516369} {:answer/id #uuid "cde85d08-f475-531a-bd01-73f6eb9051bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(12,25,36)" :db/id #edb/ref 17592186516547} {:answer/id #uuid "d54b4cb0-06e8-5602-a1ad-89fba9fb6215" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186516561}] :answer-field/correct {:db/id #edb/ref 17592186516369} :answer-field/id #uuid "616c22d5-e3ac-50e3-88f8-ae593e1ea4d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516692}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4c18b1c7-8bdd-5391-9b67-8443fd23166f" :question/math-academy-id "q-73998" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\left\\{\\begin{aligned}x &=8+3t \\\\ y &=-6+7t \\\\ z &=2t\\end{aligned}\\right.\\,\\text{and}\\,Π:2x+5y-8z=186.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}2x+5y-8z & =186 \\\\ 2(8+3t)+5(-6+7t)-8(2t) & =186 \\\\ 16+6t-30+35t-16t & =186 \\\\ 25t & =200 \\\\ t & =8\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=8$ into the parametric equations of the line:\n\n$$\n\\left\\{\\begin{aligned}x &=8+3(8)=32 \\\\ y &=-6+7(8)=50 \\\\ z &=2(8)=16\\end{aligned}\\right.\n$$\n\nSo, the intersection point is $P(32,50,16).$"} :step/id #uuid "46aaa850-40f1-5820-9c52-4b357fdbea2f" :step/next {:db/id #edb/ref 17592186516919}} {:db/id #edb/ref 17592186516909 :step/content {:db/id #edb/ref 17592186120239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d74ada3-9243-5f7c-ade2-62caa4b9c021" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,1,-4)" :db/id #edb/ref 17592186402088} {:answer/id #uuid "2ddeb712-2499-5385-8cf5-8d5841c638be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,-4,7)" :db/id #edb/ref 17592186402089} {:answer/id #uuid "c3a42789-8ed3-50da-bd89-5ed82656d5bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-8,1,1)" :db/id #edb/ref 17592186402090} {:answer/id #uuid "4f5b4306-4e52-5f8f-a6c5-d9a8c474f65b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186402091} {:answer/id #uuid "b73612ac-9159-5b03-82b8-04dc3dbeb325" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,-4,1)" :db/id #edb/ref 17592186402092}] :answer-field/correct {:db/id #edb/ref 17592186402092} :answer-field/id #uuid "1ba93ced-d091-5536-afc3-ce47413fdf3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402087}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49e4fa98-401d-5c2d-a49c-1997a8550033" :question/math-academy-id "q-33203" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨-5,0,1⟩+t⟨-3,1,0⟩,\\,Π:-3x+y-2z+27=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨-5-3t,t,1⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}-3x+y-2z+27 & =0 \\\\ -3x+y-2z & =-27 \\\\ ⟨x,y,z⟩\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ r\\cdot ⟨-3,1,-2⟩ & =-27\\end{aligned}\n$$\n\nNow, substituting $r=⟨-5-3t,t,1⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ ⟨-5-3t,t,1⟩\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ -3(-5-3t)+1\\cdot t-2\\cdot 1 & =-27 \\\\ 15+9t+t-2 & =-27 \\\\ 10t & =-40 \\\\ t & =-4.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=-4$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-5-3(-4),-4,1⟩ \\\\  & =⟨7,-4,1⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(7,-4,1).$"} :step/id #uuid "5afd2fb8-f672-52e7-a18b-c486687e5ed6" :step/next {:db/id #edb/ref 17592186516948}} {:db/id #edb/ref 17592186516916 :step/content {:db/id #edb/ref 17592186515570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4e4e53-6530-5d9b-ac71-88fa4a852643" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,5,12)" :db/id #edb/ref 17592186514894} {:answer/id #uuid "13d7977a-6ece-5a3d-a4d3-a046ae5ee70a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,3,8)" :db/id #edb/ref 17592186514914} {:answer/id #uuid "3e792c4b-0f89-58e4-ad54-bf65b7f20967" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186515006} {:answer/id #uuid "97dcbf66-8c48-507d-96c6-a848577b2e92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-5,-3,-4)" :db/id #edb/ref 17592186515192} {:answer/id #uuid "a9993b57-a418-5d19-be94-6b1c3a3b00c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8,5,8)" :db/id #edb/ref 17592186515229}] :answer-field/correct {:db/id #edb/ref 17592186514914} :answer-field/id #uuid "c8d9ffbc-23ef-519d-9512-884d3bb1903d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515494}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "83aacc67-1785-59c3-94ae-6f65bea01fe4" :question/math-academy-id "q-108881" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\frac{x+2}{3}=\\frac{y+1}{2}=\\frac{z}{4},\\,Π:r\\cdot ⟨3,-1,2⟩=25.\n$$" :question/worked-solution "From the equation of the line $l$, we know that it passes through the point $A(-2,-1,0)$ and it is parallel to the vector $v=⟨3,2,4⟩.$ Therefore, its vector equation is given by\n\n$$\n\\begin{aligned}r & =⟨-2,-1,0⟩+t⟨3,2,4⟩ \\\\  & =⟨-2+3t,-1+2t,4t⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nNow, substituting $r=⟨-2+3t,-1+2t,4t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨3,-1,2⟩ & =25 \\\\ ⟨-2+3t,-1+2t,4t⟩\\cdot ⟨3,-1,2⟩ & =25 \\\\ 3(-2+3t)-(-1+2t)+2(4t) & =25 \\\\ -6+9t+1-2t+8t & =25 \\\\ 15t & =30 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-2+3(2),-1+2(2),4(2)⟩ \\\\  & =⟨4,3,8⟩.\\end{aligned}\n$$\n\nSo, we get $P(4,3,8).$"} :step/id #uuid "6b2e7866-b57f-55d0-8fca-843a70bc51a0"} {:db/id #edb/ref 17592186516919 :step/content {:db/id #edb/ref 17592186516797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58a61e2d-79ec-5942-a542-a599506c947f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,8,4)" :db/id #edb/ref 17592186516299} {:answer/id #uuid "5933b3cc-3b81-55f6-a9e9-d8ce70b49ee7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6,-4,1)" :db/id #edb/ref 17592186516303} {:answer/id #uuid "8c3399b1-2e8d-5048-9705-3b903a795275" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186516404} {:answer/id #uuid "be96b637-0ffd-5d98-b663-5c2fe316eeca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6,-4,-16)" :db/id #edb/ref 17592186516515} {:answer/id #uuid "f5f1cb12-78bd-54f6-9673-719b825438c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,5,-1)" :db/id #edb/ref 17592186516624}] :answer-field/correct {:db/id #edb/ref 17592186516299} :answer-field/id #uuid "96cd3fdc-919f-5a7e-9267-58831d9b0de1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516725}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "47b66d2c-d386-5a47-ab3a-e7307c9bb3f9" :question/math-academy-id "q-108335" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\left\\{\\begin{aligned}x &=4-t \\\\ y &=2+3t \\\\ z &=-6+5t\\end{aligned}\\right.\\,\\text{and}\\,Π:6x-4y+z+16=0.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}6x-4y+z+16 & =0 \\\\ 6(4-t)-4(2+3t)+(-6+5t) & =-16 \\\\ 24-6t-8-12t-6+5t & =-16 \\\\ -13t & =-26 \\\\ t & =2\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=2$ into the parametric equations of the line:\n\n$$\n\\left\\{\\begin{aligned}x &=4-2=2 \\\\ y &=2+3(2)=8 \\\\ z &=-6+5(2)=4\\end{aligned}\\right.\n$$\n\nSo, the intersection point is  $P(2,8,4).$"} :step/id #uuid "736e1f94-c79a-5f94-aec8-100a0d8ad1be" :step/next {:db/id #edb/ref 17592186516916}} {:db/id #edb/ref 17592186516948 :step/content {:db/id #edb/ref 17592186402093 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb5e385e-d48b-552d-92db-b2c42b730f55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,8,14)" :db/id #edb/ref 17592186402095} {:answer/id #uuid "2cec0929-bdd8-5d7b-8ece-52cdde4c6f93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,-2,6)" :db/id #edb/ref 17592186402096} {:answer/id #uuid "c23c18d5-4a2a-5884-8422-592e07e7f5b2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186402097} {:answer/id #uuid "50770341-c200-5dd2-a57c-f88a32fa60ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,4,8)" :db/id #edb/ref 17592186402098} {:answer/id #uuid "b695496a-1b9b-5846-a379-f0e3c0d96851" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(14,8,3)" :db/id #edb/ref 17592186402099}] :answer-field/correct {:db/id #edb/ref 17592186402095} :answer-field/id #uuid "0878a66a-d92b-5043-a146-6c379d55810e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402094}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eaab1f60-24fb-5572-8cfb-474f418bf09f" :question/math-academy-id "q-33205" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨-1,-2,6⟩+t⟨2,5,4⟩,\\,Π:x+2y+z-33=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨-1+2t,-2+5t,6+4t⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}x+2y+z-33 & =0 \\\\ x+2y+z & =33 \\\\ ⟨x,y,z⟩\\cdot ⟨1,2,1⟩ & =33 \\\\ r\\cdot ⟨1,2,1⟩ & =33\\end{aligned}\n$$\n\nNow, substituting $r=⟨-1+2t,-2+5t,6+4t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨1,2,1⟩ & =33 \\\\ ⟨-1+2t,-2+5t,6+4t⟩\\cdot ⟨1,2,1⟩ & =33 \\\\ -1+2t+2(-2+5t)+6+4t & =33 \\\\ -1+2t-4+10t+6+4t & =33 \\\\ 16t & =32 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-1+2(2),-2+5(2),6+4(2)⟩ \\\\  & =⟨3,8,14⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(3,8,14).$"} :step/id #uuid "ae6d11cd-9598-5c2f-b52d-5379a477c70b" :step/next {:db/id #edb/ref 17592186516900}}] :activity/title "The Intersection Between a Line and a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516105}] [{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186163048} :activity/id #uuid "af1642f1-edfe-5e8b-bb3e-376bc11c5af4" :activity/scope {:db/id #edb/ref 17592186050205 :topic/id #uuid "36128875-8025-5e37-8397-54d8247d47c9" :topic/math-academy-id 3131} :activity/steps [{:db/id #edb/ref 17592186163048 :step/content {:db/id #edb/ref 17592186163315 :tutorial/content "Let's suppose we are given the matrix\n\n![](images/18/18f57c05cb79918e17401427e3419648791562a5d38116582e0d396e20db1069.svg)\n\nThen, the corresponding linear transformation \n\n$$\n\\mathbf x \\mapsto A \\mathbf x\n$$\n\nmaps the unit circle $\\big\\{ \\mathbf x \\, | \\, \\|\\mathbf x\\|=1 \\big\\}$ in $\\mathbb R^2$ onto an ellipse $\\big\\{ A\\mathbf{x} \\,|\\, \\| \\mathbf{x} \\| =1 \\big\\}$ in $\\mathbb{R}^2,$ as shown below. \n\n![](images/c1/c163f7714d0e2045db37438b7ea66a2dc8ac92cfbe309a0d24c898bbfac8c295.png)\n\n \n\nHow can we find the maximum possible value of $\\|A \\mathbf x\\|?$ Geometrically, this is equivalent to finding the semi-major axis of our ellipse.\n\n![](images/86/866052291b0d7a416988c0c42fa99eec1d1bfd3b1344cf3cf2eb0a09457ae38d.png)\n\nFirst, we note the following:\n\n- The value of $\\mathbf x$ that maximizes $||A\\mathbf x||$ also maximizes $||A\\mathbf x||^2.$\n\n- If $\\mathbf v$ is a column vector, then $||\\mathbf v||^2 = \\mathbf v^T \\mathbf v\\mathbin{:}$\n\nTherefore, we can re-write the squared distance from the origin to the point $A\\mathbf{x}$ on our ellipse as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x\\end{aligned}\n$$\n\n  \n\nNote that $\\mathbf{x}^T (A^T A) \\mathbf{x}$ is a quadratic form with the matrix $A^T A.$ Therefore, the maximum value of this quadratic form for $\\| \\mathbf{x} \\| =1$ equals the largest eigenvalue of the matrix $A^T A.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}1 & 3 \\\\ -3 & -1\\end{aligned}]}^{T}[\\begin{aligned}1 & 3 \\\\ -3 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -3 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}1 & 3 \\\\ -3 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}10 & 6 \\\\ 6 & 10\\end{aligned}].\\end{aligned}\n$$\n\nNext, we calculate the eigenvalues of the matrix $A^TA\\mathbin{:}$  \n\n$$\n\\begin{aligned}|{A}^{T}A-\\lambda I| & =0 \\\\ |\\begin{aligned}10-\\lambda  & 6 \\\\ 6 & 10-\\lambda \\end{aligned}| & =0 \\\\ (10-\\lambda )^{2}-36 & =0 \\\\ (10-\\lambda )^{2} & =36 \\\\ 10-\\lambda  & =\\pm 6 \\\\ \\lambda  & =4,\\,16\\end{aligned}\n$$\n\nSince the largest eigenvalue of $A^T A$ is $16,$ we obtain\n\n$$\n\\max\\limits_{\\| \\mathbf{x} \\| = 1} \\big\\{ \\| A\\mathbf{x} \\|^2 \\big\\} = 16\n\\qquad\\Longrightarrow\\qquad\n\\max\\limits_{\\| \\mathbf{x} \\| = 1} \\big\\{ \\| A\\mathbf{x} \\| \\big\\} = \\sqrt{16} = 4.\n$$\n\n \n\nTherefore, the length of the semi-major axis of our ellipse equals $4.$" :tutorial/id #uuid "b6f73158-b78c-5262-bb9d-a957e3f79fa3" :tutorial/math-academy-id 6133 :tutorial/title "Introduction"} :step/id #uuid "62510b93-1090-5902-b6a0-45fc7a644d01" :step/math-academy-id 37249 :step/next {:db/id #edb/ref 17592186163049}} {:db/id #edb/ref 17592186163049 :step/content {:db/id #edb/ref 17592186162097 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161910 :question/id #uuid "f4a3741e-a87c-5b57-95b3-5ef47f7ad599" :question/math-academy-id "e-9907"} :knowledge-point/id #uuid "d116374b-b693-5d50-8019-fcc5a7766b9b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048432} {:db/id #edb/ref 17592186050447}] :knowledge-point/questions [{:db/id #edb/ref 17592186162360} {:db/id #edb/ref 17592186162364} {:db/id #edb/ref 17592186269230} {:db/id #edb/ref 17592186269236} {:db/id #edb/ref 17592186269237} {:db/id #edb/ref 17592186269239} {:db/id #edb/ref 17592186383403} {:db/id #edb/ref 17592186412767} {:db/id #edb/ref 17592186493911} {:db/id #edb/ref 17592186493930}] :knowledge-point/title "Finding the Semi-Major Axis of the Image of the Unit Sphere"} :step/id #uuid "01d42207-c2b3-55a2-9d11-6fcda35c9cca" :step/math-academy-id 37250 :step/next {:db/id #edb/ref 17592186163052}} {:db/id #edb/ref 17592186163050 :step/content {:db/id #edb/ref 17592186162098 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161911 :question/id #uuid "06ca6e76-6354-5450-882e-b0c063acd303" :question/math-academy-id "e-9908"} :knowledge-point/id #uuid "9cec3c21-28df-52ba-9b78-86cffb4c7720" :knowledge-point/questions [{:db/id #edb/ref 17592186162362} {:db/id #edb/ref 17592186162363} {:db/id #edb/ref 17592186269244} {:db/id #edb/ref 17592186269245} {:db/id #edb/ref 17592186269246} {:db/id #edb/ref 17592186369748} {:db/id #edb/ref 17592186383431} {:db/id #edb/ref 17592186388618} {:db/id #edb/ref 17592186400763} {:db/id #edb/ref 17592186400770}] :knowledge-point/title "Solving Problems Regarding the Image of the Unit Eigenvectors of a Quadratic Form"} :step/id #uuid "bc576dbc-6ac4-5a02-9348-f4cf6db1eb0c" :step/math-academy-id 37251} {:db/id #edb/ref 17592186163051 :step/content {:db/id #edb/ref 17592186162099 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161912 :question/id #uuid "23c1671b-da2c-570b-af4f-c6aad258155d" :question/math-academy-id "e-9909"} :knowledge-point/id #uuid "fd0e91f0-abbc-52e2-8d8b-94597e4892cd" :knowledge-point/questions [{:db/id #edb/ref 17592186162361} {:db/id #edb/ref 17592186162365} {:db/id #edb/ref 17592186269240} {:db/id #edb/ref 17592186269241} {:db/id #edb/ref 17592186269242} {:db/id #edb/ref 17592186269243} {:db/id #edb/ref 17592186369734} {:db/id #edb/ref 17592186369741} {:db/id #edb/ref 17592186383417} {:db/id #edb/ref 17592186383424} {:db/id #edb/ref 17592186493901} {:db/id #edb/ref 17592186503755}] :knowledge-point/title "Finding the Semi-Major Axis of the Image of the Unit Sphere Given the Corresponding Singular Values"} :step/id #uuid "94acc5c3-ff1a-5747-b32d-b0db6e46436e" :step/math-academy-id 37254 :step/next {:db/id #edb/ref 17592186163050}} {:db/id #edb/ref 17592186163052 :step/content {:db/id #edb/ref 17592186163316 :tutorial/content "Let $A$ be an $m\\times n$ matrix. Then, $A^T A$ is always a symmetric, positive semi-definite matrix. In particular, $A^TA$ can be orthogonally diagonalized, and its eigenvalues are non-negative real numbers.\n\nThe **singular values** of  $A$ are defined as the square roots of the eigenvalues of the matrix $A^T A.$ The $i$th singular value of $A$ is denoted $\\sigma_i\\mathbin{:}$\n\n- $\\sigma_1 = \\sqrt{\\lambda_1}$\n\n- $\\sigma_2 = \\sqrt{\\lambda_2}$\n\n- $\\sigma_3 = \\sqrt{\\lambda_3}$\n\n$\\:\\vdots$\n\n- $\\sigma_n = \\sqrt{\\lambda_n}$\n\nWe usually list the singular values in *decreasing* order. \n\nNow, we know that $A^TA$ is orthogonally diagonalizable. Therefore, if\n\n$$\n\\left\\{\\mathbf v_1, \\mathbf v_2\\,\\ldots, \\mathbf v_n\\right\\}\n$$\n\nis an *orthonormal* basis of $\\mathbb R^n$ consisting of the eigenvectors of ${A^T}{A}$ with the corresponding eigenvalues \n\n$$\n\\lambda_1\\geq \\lambda_2\\geq \\ldots \\geq \\lambda_n,\n$$\n\nthen it can be shown that\n\n- $\\sigma_1 = \\sqrt{\\lambda_1}$ is the length of $A\\mathbf v_1,$\n\n- $\\sigma_2 = \\sqrt{\\lambda_2}$ is the length of $A\\mathbf v_2,$\n\n$\\:\\vdots$\n\n- $\\sigma_n = \\sqrt{\\lambda_n}$ is the length of $A\\mathbf v_n.$\n\nFurthermore:\n\n- $\\sigma_1$ is the maximum value of $||A\\mathbf x||$ over all *unit* vectors $\\mathbf x,$ and is attained on the unit eigenvector $\\mathbf v_1$\n\n- $\\sigma_2$ is the maximum value of $||A\\mathbf x||$ over all *unit* vectors $\\mathbf x$ that are orthogonal to $\\mathbf v_1,$ and is attained on the unit eigenvector $\\mathbf v_2$\n\n- $\\sigma_3$ is the maximum value of $||A\\mathbf x||$ over all *unit* vectors $\\mathbf x$ that are orthogonal to $\\mathbf v_1$ *and* $\\mathbf v_2,$ and is attained on the unit eigenvector $\\mathbf v_3$\n\n$\\:\\vdots$\n\n- $\\sigma_n$ is the maximum value of $||A\\mathbf x||$ over all *unit* vectors $\\mathbf x$ that are orthogonal to $\\mathbf v_1,\\mathbf v_2,\\ldots,\\mathbf v_{n-1},$ and is attained on the unit eigenvector $\\mathbf v_n$\n\nLet's take a look at a concrete example." :tutorial/id #uuid "f470bdb6-fa79-595c-beba-f8242d4426bd" :tutorial/math-academy-id 6134 :tutorial/title "The Singular Values of a Matrix"} :step/id #uuid "ef1b9251-7972-5caa-8ac8-321830fa4c27" :step/math-academy-id 37255 :step/next {:db/id #edb/ref 17592186163056}} {:db/id #edb/ref 17592186163056 :step/content {:db/id #edb/ref 17592186163320 :tutorial/content "We've seen that for the matrix $A,$ given by\n\n![](images/9c/9c11e176876a767543250d5b18038cae7b14a36a692a6f14474da6b4312a48b9.svg)\n\nthe eigenvalues of $A^TA$ are $\\lambda_1=16$ and $\\lambda_2=4.$ It's easy to show that the corresponding unit eigenvectors of $A^T A$ are \n\n![](images/7c/7c44b67b766ea8385f4d7780523ee560bd3e215a0cee42db9baf208da471ccdd.svg) \n\nThe singular values of $A$ are\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{16}=4, \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2.\\end{aligned}\n$$\n\nPutting all of this information together gives us the following diagram. \n\n![](images/23/238f4ae60c783dd786476a339f012ef1b4ca82bcac7aa3f3ef4445726938ef3a.png)\n\n \n\nNote that our ellipse's semi-major and semi-minor axes are $\\sigma_1 = 4$ and $\\sigma_2 =2,$ respectively." :tutorial/id #uuid "a319c696-fd06-5e8f-99f1-26ad08271a27" :tutorial/math-academy-id 6139 :tutorial/title "Associating Singular Values With an Ellipse's Principal Axes"} :step/id #uuid "c9015782-c2cb-5d34-8e6d-84a7dd5678d9" :step/math-academy-id 37280 :step/next {:db/id #edb/ref 17592186163051}}] :activity/title "The Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162225}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186503786} :activity/id #uuid "d2500c5e-c96c-5026-89b9-c0eff4d22db5" :activity/scope {:db/id #edb/ref 17592186050205 :topic/id #uuid "36128875-8025-5e37-8397-54d8247d47c9" :topic/math-academy-id 3131} :activity/steps [{:db/id #edb/ref 17592186503778 :step/content {:db/id #edb/ref 17592186269243 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "371aa83b-7675-5a37-b450-ceb326f383dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186266620} {:answer/id #uuid "3b20f717-34f8-50ab-b29d-bd468f139b4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186266666} {:answer/id #uuid "8eb66304-70cb-53f0-b508-f2f4cfc15286" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186267415} {:answer/id #uuid "9f4e98f1-3aab-5869-8b67-d9a7f948bf2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186267582} {:answer/id #uuid "e3a2dd40-7b9e-5445-928c-b6bb8a1dc03d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186268153}] :answer-field/correct {:db/id #edb/ref 17592186266666} :answer-field/id #uuid "ebf581fc-936a-577e-8513-af09419c38fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268818}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0157c09c-4c34-5a09-a678-edce758d03a9" :question/math-academy-id "q-139543" :question/problem "A $2\\times 3$ matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ Given that the singular values of $A$ are ${\\sigma }_{1}=12,$ ${\\sigma }_{2}=9,$ and ${\\sigma }_{3}=0,$ find the length of the semi-major axis of the ellipse." :question/worked-solution "The matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto the ellipse $\\{Ax\\,|\\,‖x‖=1\\}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the symmetric matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$ \n\nThe square roots of the eigenvalues of ${A}^{T}A$ are called the *singular values* of $A.$ Since the largest singular value of $A$ is ${\\sigma }_{1}=12,$ the largest eigenvalue of ${A}^{T}A$ must be ${\\lambda }_{1}={\\sigma }_{1}^{2}={12}^{2}.$ So, we obtain that\n\n$$\n{max}_{‖x‖=1}\\{‖Ax{‖}^{2}\\}={12}^{2}\\,⟹\\,{max}_{‖x‖=1}\\{‖Ax‖\\}=12.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is ${\\sigma }_{1}=12.$"} :step/id #uuid "410ad0cd-66aa-589e-9d24-b7c90f23a34c" :step/next {:db/id #edb/ref 17592186503797}} {:db/id #edb/ref 17592186503786 :step/content {:db/id #edb/ref 17592186162363 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27612a52-9a44-5194-990a-b67bd5b0cb3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{v}_{1}" :db/id #edb/ref 17592186266495} {:answer/id #uuid "3781afe7-ca23-5caf-8d77-e210ce87765d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186266623} {:answer/id #uuid "9cbfef3a-23de-5494-b267-533971519fee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186267552} {:answer/id #uuid "a48b2a55-e19f-5a3b-aad5-9311f9e9ad3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{v}_{2}" :db/id #edb/ref 17592186267628} {:answer/id #uuid "a9e9b4e6-ef6f-5008-83b9-4dc476b26261" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7{v}_{1}+5{v}_{2}" :db/id #edb/ref 17592186267677}] :answer-field/correct {:db/id #edb/ref 17592186267628} :answer-field/id #uuid "4f73eb28-9edf-5454-bbc8-1e8090f60bd5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268549}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "14414eae-18ed-5455-a3d4-1f9724606970" :question/math-academy-id "q-139421" :question/problem "![](images/f2/f26e876d5234313926a2cbaa8938e32c8a725cf3435ce3113361bfa3dc1b7997.png)\n\nA $2\\times 2$ matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto an ellipse in ${R}^{2}.$ The corresponding ellipse and its principal axes are depicted in the diagram above. Given that ${v}_{1}$ and ${v}_{2}$ are unit eigenvectors of ${A}^{T}A,$ which of the following is an eigenvector corresponding to the eigenvalue $25$ of ${A}^{T}A?$" :question/worked-solution "Suppose $A$ is an $m\\times n$ matrix. Let \n\n$$\n\\{{v}_{1},{v}_{2}\\,…,{v}_{n}\\}\n$$\n\nbe an *orthonormal* basis of ${R}^{n}$ consisting of the eigenvectors of ${A}^{T}A$ with corresponding eigenvalues \n\n$$\n{\\lambda }_{1}\\ge {\\lambda }_{2}\\ge …\\ge {\\lambda }_{n}.\n$$\n\nThen,\n\n- ${\\sigma }_{1}=\\sqrt{{\\lambda }_{1}}$ is the length of $A{v}_{1},$\n\n- ${\\sigma }_{2}=\\sqrt{{\\lambda }_{2}}$ is the length of $A{v}_{2},$\n\n- $⋯$\n\nIn our example, we see that\n\n- $||A{v}_{1}||=7={\\sigma }_{1},$ which means that ${\\lambda }_{1}={7}^{2}=49,$ and\n\n- $||A{v}_{2}||=5={\\sigma }_{2},$ which means that ${\\lambda }_{2}={5}^{2}=25.$\n\nTherefore, an eigenvector corresponding to the eigenvalue ${\\lambda }_{2}=25$ of ${A}^{T}A$ is ${v}_{2}.$"} :step/id #uuid "52f281c4-dfee-54b8-b75f-07ea8b7aff89" :step/next {:db/id #edb/ref 17592186503804}} {:db/id #edb/ref 17592186503797 :step/content {:db/id #edb/ref 17592186388618 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "220208ba-fab8-55a0-8a2f-2eb8fb671d38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{v}_{1}" :db/id #edb/ref 17592186388620} {:answer/id #uuid "5dde93b7-ebe5-5d5f-8618-0c649d764704" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{v}_{2}" :db/id #edb/ref 17592186388621} {:answer/id #uuid "d8598738-9382-5b1a-b55a-73d18649f6d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A{v}_{2}" :db/id #edb/ref 17592186388622} {:answer/id #uuid "f6853d60-cd68-56ae-8530-5d5610a55167" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A{v}_{1}" :db/id #edb/ref 17592186388623} {:answer/id #uuid "fce765ef-ed14-5c1c-a75f-4c9e2f5446a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A{A}^{T}{v}_{1}" :db/id #edb/ref 17592186388624}] :answer-field/correct {:db/id #edb/ref 17592186388621} :answer-field/id #uuid "e12f6b66-e0b5-5c3d-87c1-2792f81acfc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388619}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "82b609f1-ebbe-5986-a6ff-a556a13681d3" :question/math-academy-id "q-139549" :question/problem "![](images/7a/7a2aea092b82dd217b848abdfc162425f098bc13c53975ccfced3f60a4e2ebfb.png)\n\nA $2\\times 2$ matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto an ellipse in ${R}^{2}.$ The corresponding ellipse and its principal axes are depicted in the diagram above. Given that ${v}_{1}$ and ${v}_{2}$ are unit eigenvectors of ${A}^{T}A,$ which of the following is an eigenvector corresponding to the eigenvalue $16$ of ${A}^{T}A?$" :question/worked-solution "Suppose $A$ is an $m\\times n$ matrix. Let \n\n$$\n\\{{v}_{1},{v}_{2}\\,…,{v}_{n}\\}\n$$\n\nbe an *orthonormal* basis of ${R}^{n}$ consisting of the eigenvectors of ${A}^{T}A$ with corresponding eigenvalues \n\n$$\n{\\lambda }_{1}\\ge {\\lambda }_{2}\\ge …\\ge {\\lambda }_{n}.\n$$\n\nThen,\n\n- ${\\sigma }_{1}=\\sqrt{{\\lambda }_{1}}$ is the length of $A{v}_{1},$\n\n- ${\\sigma }_{2}=\\sqrt{{\\lambda }_{2}}$ is the length of $A{v}_{2},$\n\n- $⋯$\n\nIn our example, we see that\n\n- $||A{v}_{1}||=8={\\sigma }_{1},$ which means that ${\\lambda }_{1}={8}^{2}=64,$ and\n\n- $||A{v}_{2}||=4={\\sigma }_{2},$ which means that ${\\lambda }_{2}={4}^{2}=16.$\n\nTherefore, an eigenvector corresponding to the eigenvalue ${\\lambda }_{2}=16$ of ${A}^{T}A$ is ${v}_{2}.$"} :step/id #uuid "74ddedfd-6201-5f03-9796-484a0235a391"} {:db/id #edb/ref 17592186503801 :step/content {:db/id #edb/ref 17592186503755 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c5df5ba-75f0-5bfc-a30e-6793337660ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186503195} {:answer/id #uuid "7d6dfca0-cb60-5c5b-ae49-7cd685619f7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186503239} {:answer/id #uuid "87db152d-bf36-549b-bb17-dd5daccc80b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186503259} {:answer/id #uuid "a7b73526-0075-5162-b576-f6193e008526" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186503320} {:answer/id #uuid "f92b14f4-9494-5bbe-b406-714b16837483" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186503495}] :answer-field/correct {:db/id #edb/ref 17592186503239} :answer-field/id #uuid "5e35f8d5-2126-585d-9e2b-f8a2c67ed434" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503555}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f2c3caea-6032-5d20-9fea-52c78472efb1" :question/math-academy-id "q-139538" :question/problem "A $2\\times 2$ matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto an ellipse in ${R}^{2}.$ Given that the singular values of $A$ are ${\\sigma }_{1}=8$ and ${\\sigma }_{2}=3\\sqrt{3},$ find the length of the semi-major axis of the ellipse." :question/worked-solution "The matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto the ellipse $\\{Ax\\,|\\,‖x‖=1\\}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the symmetric matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$ \n\nThe square roots of the eigenvalues of ${A}^{T}A$ are called the *singular values* of $A.$ Since the largest singular value of $A$ is ${\\sigma }_{1}=8,$ the largest eigenvalue of ${A}^{T}A$ must be ${\\lambda }_{1}={\\sigma }_{1}^{2}={8}^{2}.$ So, we obtain that\n\n$$\n{max}_{‖x‖=1}\\{‖Ax{‖}^{2}\\}={8}^{2}\\,⟹\\,{max}_{‖x‖=1}\\{‖Ax‖\\}=8.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is ${\\sigma }_{1}=8.$"} :step/id #uuid "80e7be25-cdff-5c16-856f-410a8631d1d8" :step/next {:db/id #edb/ref 17592186503778}} {:db/id #edb/ref 17592186503804 :step/content {:db/id #edb/ref 17592186269240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a429996-164b-54fc-9946-577431de1ccb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186266657} {:answer/id #uuid "4f3a6a58-573b-5732-bf74-6c0a1ac7d701" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186266849} {:answer/id #uuid "62be0fb0-0dcb-57b3-9f91-1d3ab410a49b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186267012} {:answer/id #uuid "afc186cf-aab9-589d-af44-efe97c49758b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186267725} {:answer/id #uuid "cd7691e1-a3bb-53c8-9a1f-15a33a8deed3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186267981}] :answer-field/correct {:db/id #edb/ref 17592186266657} :answer-field/id #uuid "2a4b6387-6d51-5a91-bc9a-e1d31b9ff78c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268474}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ed90c3b2-491c-5a1e-a27e-a0b50d59ad00" :question/math-academy-id "q-139535" :question/problem "A $2\\times 2$ matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto an ellipse in ${R}^{2}.$ Given that the singular values of $A$ are ${\\sigma }_{1}=9$ and ${\\sigma }_{2}=2\\sqrt{3},$ find the length of the semi-major axis of the ellipse." :question/worked-solution "The matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto the ellipse $\\{Ax\\,|\\,‖x‖=1\\}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the symmetric matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$ \n\nThe square roots of the eigenvalues of ${A}^{T}A$ are called the *singular values* of $A.$ Since the largest singular value of $A$ is ${\\sigma }_{1}=9,$ the largest eigenvalue of ${A}^{T}A$ must be ${\\lambda }_{1}={\\sigma }_{1}^{2}={9}^{2}.$ So, we obtain that\n\n$$\n{max}_{‖x‖=1}\\{‖Ax{‖}^{2}\\}={9}^{2}\\,⟹\\,{max}_{‖x‖=1}\\{‖Ax‖\\}=9.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is ${\\sigma }_{1}=9.$"} :step/id #uuid "85e42921-05f4-5ace-8862-09474ca442a5" :step/next {:db/id #edb/ref 17592186503801}}] :activity/title "The Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186502976}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186524075} :activity/id #uuid "eb21dc6b-2d80-592a-b7a0-6c3fee156a8e" :activity/scope {:db/id #edb/ref 17592186050205 :topic/id #uuid "36128875-8025-5e37-8397-54d8247d47c9" :topic/math-academy-id 3131} :activity/steps [{:db/id #edb/ref 17592186524058 :step/content {:db/id #edb/ref 17592186412767 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "540c0dc8-bcd9-54af-927a-97418f253efe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186412761} {:answer/id #uuid "5a97219a-abbc-57e2-b1d2-b514ebfcc818" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186412762} {:answer/id #uuid "679d7be2-afd4-56e4-a222-6d038f0fed97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186412763} {:answer/id #uuid "7ae8a743-3acf-5070-9428-27ae75be7fae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186412764} {:answer/id #uuid "ddda3679-2b94-54f4-b126-2775a43b783a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{11}" :db/id #edb/ref 17592186412765}] :answer-field/correct {:db/id #edb/ref 17592186412765} :answer-field/id #uuid "31f990c5-9445-506b-958c-e6c3b52764dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186412766}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d906fadc-a9c3-53a2-ad5f-49a5ac38ab8d" :question/math-academy-id "q-139532" :question/problem "A $2\\times 2$ matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto an ellipse in ${R}^{2}.$ Given that the eigenvalues of ${A}^{T}A$ are $11$ and $4,$ find the length of the ellipse's semi-major axis." :question/worked-solution "The matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto the ellipse $\\{Ax\\,|\\,‖x‖=1\\}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$\n\nSince the largest eigenvalue of ${A}^{T}A$ is $11,$ we obtain\n\n$$\n{max}_{‖x‖=1}\\{‖Ax{‖}^{2}\\}=11\\,⟹\\,{max}_{‖x‖=1}\\{‖Ax‖\\}=\\sqrt{11}.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is $\\sqrt{11}.$"} :step/id #uuid "4b60e7be-0a56-5bba-9861-738aac8f8ee4" :step/next {:db/id #edb/ref 17592186524080}} {:db/id #edb/ref 17592186524075 :step/content {:db/id #edb/ref 17592186162360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5884f354-e5d3-5445-b252-6177d7fb10d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186266935} {:answer/id #uuid "59a2b792-bce2-5ab3-8129-3ed501c97fa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186266941} {:answer/id #uuid "66a53c17-6cca-59e9-b3a7-10509d1e6f05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186267055} {:answer/id #uuid "7ed785dc-de4a-56df-9005-91dc3382836b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186267261} {:answer/id #uuid "c268b638-dc68-5720-86dc-4bdf86ac9c78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186267877}] :answer-field/correct {:db/id #edb/ref 17592186266941} :answer-field/id #uuid "71f2e673-2942-5733-b153-c9e00dd002b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268619}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b2e59ffd-322c-5739-bff6-4abbfbcffef1" :question/math-academy-id "q-139415" :question/problem "A $2\\times 3$ matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ Given that the eigenvalues of ${A}^{T}A$ are $5,$ $3,$ and $0,$ find the length of the ellipse's semi-major axis." :question/worked-solution "The matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto the ellipse $\\{Ax\\,|\\,‖x‖=1\\}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$\n\nSince the largest eigenvalue of ${A}^{T}A$ is $5,$ we obtain\n\n$$\n{max}_{‖x‖=1}\\{‖Ax{‖}^{2}\\}=5\\,⟹\\,{max}_{‖x‖=1}\\{‖Ax‖\\}=\\sqrt{5}.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is $\\sqrt{5}.$"} :step/id #uuid "8e86f3d8-3c6b-5dfb-8619-654db11074d9" :step/next {:db/id #edb/ref 17592186524058}} {:db/id #edb/ref 17592186524078 :step/content {:db/id #edb/ref 17592186269244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2380798b-79b8-5bc8-8153-92b706b0d629" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $\\sqrt{5}$" :db/id #edb/ref 17592186266470} {:answer/id #uuid "aa5c7d7d-7d57-554b-8590-31cd03b7bf50" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $5$" :db/id #edb/ref 17592186267684} {:answer/id #uuid "bd57370c-6b04-52dc-acbe-5e2a687609ed" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$16$ and $\\sqrt{5}$" :db/id #edb/ref 17592186267839} {:answer/id #uuid "cca90f51-cb57-5f81-bcb5-412e125542b9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${v}_{1}$ and ${v}_{1}$" :db/id #edb/ref 17592186267976} {:answer/id #uuid "f862619f-07c7-5287-9b92-80801fdc6ea1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8{v}_{1}$ and $5{v}_{1}$" :db/id #edb/ref 17592186268344}] :answer-field/correct {:db/id #edb/ref 17592186267684} :answer-field/id #uuid "7c9e107d-8a8c-55a2-9d3c-26e1ff04f4aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268633}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f71d275b-8f83-5bf3-90f9-5e8ed34d76ff" :question/math-academy-id "q-139547" :question/problem "![](images/d4/d4947e37239d2ac2950b536d7afc2d0810ea713c437b7095a43e123d50ff2b34.png)\n\nA $2\\times 3$ matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ The corresponding ellipse and its principal axes are depicted in the diagram above. Given that ${v}_{1}$ and ${v}_{2}$ are unit eigenvectors of ${A}^{T}A,$ what are the nonzero singular values of $A?$" :question/worked-solution "Suppose $A$ is an $m\\times n$ matrix. Let \n\n$$\n\\{{v}_{1},{v}_{2}\\,…,{v}_{n}\\}\n$$\n\nbe an *orthonormal* basis of ${R}^{n}$ consisting of the eigenvectors of ${A}^{T}A$ with corresponding eigenvalues \n\n$$\n{\\lambda }_{1}\\ge {\\lambda }_{2}\\ge …\\ge {\\lambda }_{n}.\n$$\n\nThen,\n\n- ${\\sigma }_{1}=\\sqrt{{\\lambda }_{1}}$ is the length of $A{v}_{1},$\n\n- ${\\sigma }_{2}=\\sqrt{{\\lambda }_{2}}$ is the length of $A{v}_{2},$\n\n- $⋯$\n\nIn our example, we see that\n\n- $||A{v}_{1}||=8={\\sigma }_{1},$ and\n\n- $||A{v}_{2}||=5={\\sigma }_{2}.$\n\nTherefore, the nonzero singular values of $A$ are ${\\sigma }_{1}=8$ and ${\\sigma }_{2}=5.$"} :step/id #uuid "9127aacb-30a9-55a4-8d76-24d419b593cf" :step/next {:db/id #edb/ref 17592186524093}} {:db/id #edb/ref 17592186524080 :step/content {:db/id #edb/ref 17592186369741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07e2bd31-1a71-5fa9-80bb-5391989330e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186369743} {:answer/id #uuid "f61dae6c-bf45-5d4f-8713-28f56aef6853" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186369744} {:answer/id #uuid "8563b272-2537-5a12-ba5d-b5eebc0e5b79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186369745} {:answer/id #uuid "9e80d123-7a67-5ff4-beb6-4b523e939500" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186369746} {:answer/id #uuid "d9f5cee2-8204-52ac-a8d9-4f4e81a7c0ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186369747}] :answer-field/correct {:db/id #edb/ref 17592186369745} :answer-field/id #uuid "0b618b69-53f8-5721-89d5-02c9360f4137" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186369742}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dd29d329-0104-5ef8-b69c-cd8c21549714" :question/math-academy-id "q-139544" :question/problem "A $2\\times 3$ matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ Given that the singular values of $A$ are ${\\sigma }_{1}=8,$ ${\\sigma }_{2}=2\\sqrt{5},$ and ${\\sigma }_{3}=0,$ find the length of the semi-major axis of the ellipse." :question/worked-solution "The matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto the ellipse $\\{Ax\\,|\\,‖x‖=1\\}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the symmetric matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$ \n\nThe square roots of the eigenvalues of ${A}^{T}A$ are called the *singular values* of $A.$ Since the largest singular value of $A$ is ${\\sigma }_{1}=8,$ the largest eigenvalue of ${A}^{T}A$ must be ${\\lambda }_{1}={\\sigma }_{1}^{2}={8}^{2}.$ So, we obtain that\n\n$$\n{max}_{‖x‖=1}\\{‖Ax{‖}^{2}\\}={8}^{2}\\,⟹\\,{max}_{‖x‖=1}\\{‖Ax‖\\}=8.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is ${\\sigma }_{1}=8.$"} :step/id #uuid "9ba70a3c-71a0-5cb6-a4db-f475dda224da" :step/next {:db/id #edb/ref 17592186524078}} {:db/id #edb/ref 17592186524093 :step/content {:db/id #edb/ref 17592186383431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be3ba996-d9c0-57d3-95cc-5f43b21decb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{v}_{1}" :db/id #edb/ref 17592186383433} {:answer/id #uuid "4bbea375-60a4-5dc4-b6be-dd9b80d209fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{v}_{2}" :db/id #edb/ref 17592186383434} {:answer/id #uuid "85175ea8-b77f-56c3-83e4-10dd48da9dc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A{v}_{2}" :db/id #edb/ref 17592186383435} {:answer/id #uuid "98ae820c-445e-5ef8-bf8b-2b43811699d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A{v}_{1}" :db/id #edb/ref 17592186383436} {:answer/id #uuid "0a9af6f2-c869-5f00-9c07-d01d9bfe39e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A{A}^{T}{v}_{1}" :db/id #edb/ref 17592186383437}] :answer-field/correct {:db/id #edb/ref 17592186383434} :answer-field/id #uuid "5c7c6fc9-8fb7-527f-ae85-2cdf815c3fbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186383432}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "caf843b3-f2a1-5bdc-8d57-74ed37aa0fe2" :question/math-academy-id "q-139554" :question/problem "![](images/63/63d5de8c08559ecc88b4fd7e2184204a1e6ea2f8a9e8ca6af7959e2354876e3f.png)\n\nA $2\\times 2$ matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto an ellipse in ${R}^{2}.$ The corresponding ellipse and its principal axes are depicted in the diagram above. Given that ${v}_{1}$ and ${v}_{2}$ are unit eigenvectors of ${A}^{T}A,$ which of the following is an eigenvector corresponding to the eigenvalue $9$ of ${A}^{T}A?$" :question/worked-solution "Suppose $A$ is an $m\\times n$ matrix. Let \n\n$$\n\\{{v}_{1},{v}_{2}\\,…,{v}_{n}\\}\n$$\n\nbe an *orthonormal* basis of ${R}^{n}$ consisting of the eigenvectors of ${A}^{T}A$ with corresponding eigenvalues \n\n$$\n{\\lambda }_{1}\\ge {\\lambda }_{2}\\ge …\\ge {\\lambda }_{n}.\n$$\n\nThen,\n\n- ${\\sigma }_{1}=\\sqrt{{\\lambda }_{1}}$ is the length of $A{v}_{1},$\n\n- ${\\sigma }_{2}=\\sqrt{{\\lambda }_{2}}$ is the length of $A{v}_{2},$\n\n- $⋯$\n\nIn our example, we see that\n\n- $||A{v}_{1}||=5={\\sigma }_{1},$ which means that ${\\lambda }_{1}={5}^{2}=25,$ and\n\n- $||A{v}_{2}||=3={\\sigma }_{2},$ which means that ${\\lambda }_{2}={3}^{2}=9.$\n\nTherefore, an eigenvector corresponding to the eigenvalue ${\\lambda }_{2}=9$ of ${A}^{T}A$ is ${v}_{2}.$"} :step/id #uuid "c2b79e93-d3ce-53a6-844f-76207ef1c04e"}] :activity/title "The Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186523246}] [{:activity/expected-seconds 1080.0 :activity/first-step {:db/id #edb/ref 17592186134817} :activity/id #uuid "3a450e6c-560e-5c98-a021-778f5de2c088" :activity/scope {:db/id #edb/ref 17592186050841 :topic/id #uuid "6aced1c3-bd0e-5b1d-973e-105b955f9e1a" :topic/math-academy-id 2126} :activity/steps [{:db/id #edb/ref 17592186134817 :step/content {:db/id #edb/ref 17592186135105 :tutorial/content "Let $V$ be an inner product space with the inner product $\\langle\\cdot, \\cdot\\rangle.$ If \n\n$$\n\\big\\{ \\mathbf{a}_1, \\mathbf{a}_2 , \\ldots, \\mathbf{a}_n \\big\\}\n$$\n\n is a set of mutually orthogonal vectors in $V,$  then the **orthogonal projection** of a vector $\\mathbf{x}\\in V$ onto the subspace \n\n$$\nS = \\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 , \\ldots, \\mathbf{a}_n \\}\n$$\n\nwith respect to the inner product is given by\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+⋯+{\\text{proj}}_{{a}_{n}}x \\\\  & =\\frac{⟨x,{a}_{1}⟩}{⟨{a}_{1},{a}_{1}⟩}{a}_{1}+\\frac{⟨x,{a}_{2}⟩}{⟨{a}_{2},{a}_{2}⟩}{a}_{2}+⋯+\\frac{⟨x,{a}_{n}⟩}{⟨{a}_{n},{a}_{n}⟩}{a}_{n}.\\end{aligned}\n$$\n\nIn other words, the orthogonal projection of $\\mathbf{x}$ onto $S$ is the sum of the orthogonal projections of $\\mathbf{x}$ onto each one-dimensional subspace $\\textrm{Span}\\big\\{ \\mathbf{a}_i\\}$ for $i=1, 2, \\cdots, n.$ \n\nNote the following:\n\n- This is entirely analogous to the corresponding formula for Euclidean spaces.\n\n- As in Euclidean spaces, the formula works *only* when the set of vectors $\\{ \\mathbf{a}_1, \\mathbf{a}_2 , \\ldots, \\mathbf{a}_n \\}$ is orthogonal with respect to the inner product!" :tutorial/id #uuid "9b462101-527b-5e26-bcd4-89b8459552bd" :tutorial/math-academy-id 5162 :tutorial/title "Introduction"} :step/id #uuid "91e83dab-899c-5474-8059-ebdcc7a5278a" :step/math-academy-id 32457 :step/next {:db/id #edb/ref 17592186134885}} {:db/id #edb/ref 17592186134818 :step/content {:db/id #edb/ref 17592186133873 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133689 :question/id #uuid "18068394-b64b-5bc8-a2da-b0db4085ecba" :question/math-academy-id "e-8729"} :knowledge-point/id #uuid "df300955-830a-5347-9aeb-2b2b25f865c8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048169} {:db/id #edb/ref 17592186048893}] :knowledge-point/questions [{:db/id #edb/ref 17592186134060} {:db/id #edb/ref 17592186134563} {:db/id #edb/ref 17592186240902} {:db/id #edb/ref 17592186240903} {:db/id #edb/ref 17592186240904} {:db/id #edb/ref 17592186240948} {:db/id #edb/ref 17592186240949} {:db/id #edb/ref 17592186240961} {:db/id #edb/ref 17592186240962} {:db/id #edb/ref 17592186532639} {:db/id #edb/ref 17592186532688}] :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a One-Dimensional Subspace"} :step/id #uuid "4240c631-050e-58b5-968f-46d616a5f794" :step/math-academy-id 32458 :step/next {:db/id #edb/ref 17592186134819}} {:db/id #edb/ref 17592186134819 :step/content {:db/id #edb/ref 17592186133874 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133690 :question/id #uuid "4e4a5db0-2ea0-542e-abdd-c5b3abfe2134" :question/math-academy-id "e-8730"} :knowledge-point/id #uuid "39692b40-7d68-5ae5-9fe1-0f8b0b2e0d77" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048495} {:db/id #edb/ref 17592186050009}] :knowledge-point/questions [{:db/id #edb/ref 17592186134064} {:db/id #edb/ref 17592186134562} {:db/id #edb/ref 17592186240950} {:db/id #edb/ref 17592186240955} {:db/id #edb/ref 17592186240978} {:db/id #edb/ref 17592186240983} {:db/id #edb/ref 17592186240989} {:db/id #edb/ref 17592186240996} {:db/id #edb/ref 17592186241003} {:db/id #edb/ref 17592186241014} {:db/id #edb/ref 17592186241046} {:db/id #edb/ref 17592186241049}] :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Subspace Spanned by Orthogonal Vectors"} :step/id #uuid "e60ded4d-fa5d-5393-8f16-7c1cc6abe2dd" :step/math-academy-id 32459 :step/next {:db/id #edb/ref 17592186134820}} {:db/id #edb/ref 17592186134820 :step/content {:db/id #edb/ref 17592186135106 :tutorial/content "Suppose that $V$ is a vector space equipped with an inner product $\\left\\langle\\cdot, \\cdot\\right\\rangle$ and that $\\mathbf{v}, \\mathbf{w} \\in V.$ The **distance $d$ between $\\mathbf v$ and $\\mathbf w$ with respect to the inner product** is defined by the *norm* of $\\mathbf{v}- \\mathbf{w}.$ That is,\n\n$$\n\\begin{aligned}d & =‖v-w‖=\\sqrt{⟨v-w,v-w⟩}.\\end{aligned}\n$$\n\nFor example, suppose that $V = \\mathcal{C}[0,1],$ the vector space of continuous functions over $[0,1],$ equipped with the inner product\n\n$$\n\\langle x(t),y(t) \\rangle = \\int_0^{1} x(t) y(t) \\, \\text{d}t.\n$$\n\nThe distance between the functions $f(t)=4t$ and $g(t)=t+1$ with respect to the given inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-g(t)‖ \\\\  & =‖4t-(t+1)‖ \\\\  & =‖3t-1‖ \\\\  & =\\sqrt{⟨3t-1,3t-1⟩} \\\\  & =\\sqrt{{\\int }_{0}^{1}(3t-1)^{2}\\,\\text{d}t} \\\\  & =\\sqrt{{\\frac{1}{9}\\cdot (3t-1)^{3}|}_{0}^{1}} \\\\  & =\\sqrt{\\frac{1}{9}\\cdot [(8)-(-1)]} \\\\  & =\\sqrt{\\frac{1}{9}\\cdot 9} \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nMore generally, given an orthogonal set \n\n$$\n\\big\\{ \\mathbf{a}_1, \\mathbf{a}_2 , \\ldots, \\mathbf{a}_n \\big\\} \\subset  V\n$$\n\nand a vector $\\mathbf x \\in V,$  the **distance between $\\mathbf{x}$ and the subspace** \n\n$$\nS=\\textrm{Span}\\{ \\mathbf{a}_1,\\mathbf{a}_2,  \\ldots, \\mathbf{a}_n \\}\n$$\n\nis defined as\n\n$$\n\\Vert{ \\color{black} \\mathbf{x} - \\text{proj}_{S}\\,\\mathbf{x} }\\Vert.\n$$" :tutorial/id #uuid "4ca26c36-a2e4-51d5-ae7d-a4b59234cedb" :tutorial/math-academy-id 5163 :tutorial/title "The Distance Between a Vector and a Subspace"} :step/id #uuid "7d1a7540-bb8b-5865-a0e0-852beed15e26" :step/math-academy-id 32460 :step/next {:db/id #edb/ref 17592186134821}} {:db/id #edb/ref 17592186134821 :step/content {:db/id #edb/ref 17592186133875 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133691 :question/id #uuid "d7541321-4042-54af-9b64-59f255a6f1a3" :question/math-academy-id "e-8733"} :knowledge-point/id #uuid "25e84fac-02c3-5111-98b3-bc67fe1ec9ab" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049274}] :knowledge-point/questions [{:db/id #edb/ref 17592186134564} {:db/id #edb/ref 17592186134565} {:db/id #edb/ref 17592186241059} {:db/id #edb/ref 17592186241063} {:db/id #edb/ref 17592186241065} {:db/id #edb/ref 17592186241066} {:db/id #edb/ref 17592186241068} {:db/id #edb/ref 17592186241070} {:db/id #edb/ref 17592186241072} {:db/id #edb/ref 17592186241074} {:db/id #edb/ref 17592186375652} {:db/id #edb/ref 17592186543554}] :knowledge-point/title "Calculating the Distance Between a Vector and a Subspace"} :step/id #uuid "20a627a4-468b-5c73-a4aa-e3ab9c87207e" :step/math-academy-id 32485 :step/next {:db/id #edb/ref 17592186134828}} {:db/id #edb/ref 17592186134828 :step/content {:db/id #edb/ref 17592186135107 :tutorial/content "The orthogonal projection of a vector $\\mathbf{x}\\in V$ onto $\\textrm{Span}\\{\\mathbf{a}\\}$ (or simply onto a vector $\\mathbf{a}$) is the vector $\\text{proj}_{\\mathbf{a}}\\,\\mathbf{x}\\in \\textrm{Span}\\{\\mathbf{a}\\}$ that is \"closest\" to $\\mathbf{x}$ with respect to the distance defined by the inner product.\n\nAlthough we've considered abstract vector spaces with any possible inner product in this lesson, we can still visualize this situation with the following diagram:\n\n![](images/09/099a0bb20552824d2376994c3eb7145e48bbf78552d16de39fec44bda6b766f2.png)\n\nAs shown in the diagram, the projection of $\\mathbf{x}$ onto $\\textrm{Span}\\{\\mathbf{a}\\}$ is the vector $\\text{proj}_{\\mathbf{a}}\\,\\mathbf{x}$ such that $\\mathbf{x} - \\text{proj}_{\\mathbf{a}}\\,\\mathbf{x}$ is orthogonal to $\\textrm{Span}\\{\\mathbf{a}\\}.$\n\nFurthermore, $\\| \\mathbf{x} - \\text{proj}_{\\mathbf{a}}\\,\\mathbf{x} \\|$ will be the smallest possible distance (with respect to our inner product) from $\\mathbf{x}$ to any vector in $\\textrm{Span}\\{\\mathbf{a}\\}.$" :tutorial/id #uuid "629bc20f-76c3-5217-b763-e4ab0c831a8d" :tutorial/math-academy-id 5343 :tutorial/title "The Intuition Behind Orthogonal Projections in Inner Product Spaces"} :step/id #uuid "97501e93-7a73-5f78-8d81-1f3d7a340746" :step/math-academy-id 33420} {:db/id #edb/ref 17592186134885 :step/content {:db/id #edb/ref 17592186135141 :tutorial/content "Consider the functions \n\n$$\nf_1(t)=t,\\qquad f_2(t)=t^2+1, \\qquad h(t)= 5t^3,\n$$\n\nin the vector space $V = \\mathcal{C}[-1,1]$ of continuous functions over $[-1,1],$ where the inner product is defined as\n\n$$\n\\langle x(t),y(t) \\rangle = \\int_{-1}^1 x(t) y(t) \\, \\text{d}t.\n$$\n\nLet's find the orthogonal projection of $h(t)$ onto the subspace\n\n$$\nS= \\textrm{Span}\\{f_1(t), f_2(t)\\},\n$$\n\n \n\ngiven that $f_1(t) \\perp f_2(t)$ with respect to this inner product. \n\nSince the set $\\{f_1(t),f_2(t)\\}$ is orthogonal, the orthogonal projection of $h(t)$ onto $S$ is given by\n\n$$\n\\textrm{proj}_{S}\\,h(t) \n= \\textrm{proj}_{f_1(t)}\\,h(t) + \\textrm{proj}_{f_2(t)}\\,h(t).\n$$\n\nLet's now compute these projections:\n\n- First, we compute  the orthogonal projection of $h(t)$ onto $\\textrm{Span}\\{f_1(t)\\}\\mathbin{:}$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{f}_{1}(t)}\\,h(t) & =\\frac{⟨h(t),{f}_{1}(t)⟩}{⟨{f}_{1}(t),{f}_{1}(t)⟩}\\,{f}_{1}(t) \\\\  & =\\frac{{\\int }_{-1}^{1}5{t}^{4}\\,\\text{d}t}{{\\int }_{-1}^{1}{t}^{2}\\,\\text{d}t}\\cdot t \\\\  & =3t\\end{aligned}\n$$\n\n- Next, we compute  the orthogonal projection of $h(t)$ onto $\\textrm{Span}\\{f_2(t)\\}\\mathbin{:}$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{f}_{2}(t)}\\,h(t) & =\\frac{⟨h(t),{f}_{2}(t)⟩}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\,{f}_{2}(t) \\\\  & =\\frac{{\\int }_{-1}^{1}5{t}^{3}({t}^{2}+1)\\,\\text{d}t}{{\\int }_{-1}^{1}({t}^{2}+1)^{2}\\,\\text{d}t}\\cdot ({t}^{2}+1) \\\\  & =0.\\end{aligned}\n$$\n\nNote: We used the fact that the integrand in the numerator is an odd function, so its integral over $[-1,1]$ must be zero.\n\nFinally, we have\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,h(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,h(t)+{\\text{proj}}_{{f}_{2}(t)}\\,h(t) \\\\  & =3t+0 \\\\  & =3t.\\end{aligned}\n$$" :tutorial/id #uuid "975c7894-a67f-5528-875e-2e55a94d99b9" :tutorial/math-academy-id 6130 :tutorial/title "A Worked Example"} :step/id #uuid "b89a94ac-0dd4-505c-b266-41783d527047" :step/math-academy-id 37245 :step/next {:db/id #edb/ref 17592186134818}}] :activity/title "Projecting Vectors Onto Subspaces in Inner Product Spaces" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134005}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186413797} :activity/id #uuid "fba5b1da-9880-515c-af94-05681b35cd3b" :activity/scope {:db/id #edb/ref 17592186050841 :topic/id #uuid "6aced1c3-bd0e-5b1d-973e-105b955f9e1a" :topic/math-academy-id 2126} :activity/steps [{:db/id #edb/ref 17592186413793 :step/content {:db/id #edb/ref 17592186134064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a97740-bf4e-5245-a223-1105ad76868c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t" :db/id #edb/ref 17592186238086} {:answer/id #uuid "0ccb496a-1f3e-5f9c-9be5-7756bb97a385" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t+2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186238169} {:answer/id #uuid "9dbfd16e-b04d-5762-91cf-d69f6af7923d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t+\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239432} {:answer/id #uuid "a5578604-9539-5565-8bbb-579ff2d23c8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239490} {:answer/id #uuid "ff74f82e-113d-5ba7-9d63-962e019ecfd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186240320}] :answer-field/correct {:db/id #edb/ref 17592186238086} :answer-field/id #uuid "50e2f23b-8197-5ffd-805f-f3ecff761a73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240475}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e7a8c44b-b300-5e66-9428-e03f400ebf5f" :question/math-academy-id "q-105416" :question/problem "Let $V=C[-\\pi ,\\pi ],$ the vector space of continuous functions over $[-\\pi ,\\pi ]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=\\operatorname{sin}⁡t,\\,{f}_{2}(t)=\\operatorname{cos}⁡t,\\,g(t)={sin}^{2}⁡t-\\operatorname{cos}⁡t\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}\\{{f}_{1}(t),{f}_{2}(t)\\}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{2}(t)\\}$ equals $-\\operatorname{cos}⁡t.$" :question/worked-solution "Since the set $\\{{f}_{1}(t),{f}_{2}(t)\\}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{2}(t)}\\,g(t)=-\\operatorname{cos}⁡t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{1}(t)\\}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{1}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{1}(t)⟩}{⟨{f}_{1}(t),{f}_{1}(t)⟩}\\,{f}_{1}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{1}(t)⟩ & ={\\int }_{-\\pi }^{\\pi }g(t){f}_{1}(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡t$ is an odd function, while ${sin}^{2}⁡t-\\operatorname{cos}⁡t$ is even. Hence, their product $\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)$ must be an odd function. Now, since we have an integral over the interval $[-\\pi ,\\pi ],$ which is symmetric about the origin, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\,\\text{d}t=0.\n$$\n\n  \n\nTherefore,\n\n$$\n{\\text{proj}}_{{f}_{1}(t)}\\,g(t)=\\frac{0}{⟨{f}_{1}(t),{f}_{1}(t)⟩}\\cdot \\operatorname{sin}⁡t=0.\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =0-\\operatorname{cos}⁡t \\\\  & =-\\operatorname{cos}⁡t.\\end{aligned}\n$$"} :step/id #uuid "0a412cdd-29f8-5273-ab55-2a8dce391dae" :step/next {:db/id #edb/ref 17592186413795}} {:db/id #edb/ref 17592186413794 :step/content {:db/id #edb/ref 17592186241003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9db971-884b-5cf9-9a84-c91c9fa4fa01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8+\\operatorname{sin}⁡t" :db/id #edb/ref 17592186238276} {:answer/id #uuid "39658250-b0fe-59bb-a334-a4e517b0d75e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186238550} {:answer/id #uuid "880b7d31-ec04-56db-ad2a-f754621f1b8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239237} {:answer/id #uuid "b1b15087-e383-5255-8efc-84ad43c168b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6-2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239607} {:answer/id #uuid "cd180c30-2f84-5a24-af62-8965f36db06d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4+2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239851}] :answer-field/correct {:db/id #edb/ref 17592186239607} :answer-field/id #uuid "51c982ce-3e72-5b74-bcb0-6eb543685681" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240480}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2bf55fb2-ca86-5707-a52a-d891899878f4" :question/math-academy-id "q-105186" :question/problem "Let $V=C[-\\pi ,\\pi ],$ the vector space of continuous functions over $[-\\pi ,\\pi ]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=2,\\,{f}_{2}(t)=\\operatorname{sin}⁡t,\\,g(t)=\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t+6\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}\\{{f}_{1}(t),{f}_{2}(t)\\}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{1}(t)\\}$ equals $6.$" :question/worked-solution "Since the set $\\{{f}_{1}(t),{f}_{2}(t)\\}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{1}(t)}\\,g(t)=6,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{2}(t)\\}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{2}(t)⟩}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\,{f}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & ={\\int }_{-\\pi }^{\\pi }g(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }(\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t+6)\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t-2{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t+6{\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡t$ is an odd function, while $\\operatorname{cos}⁡t$ is even. Hence, their product $\\operatorname{cos}⁡t\\operatorname{sin}⁡t$ must be an odd function. Now, since we have integrals over the interval $[-\\pi ,\\pi ],$ which is symmetric about the origin, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t=0.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & =-2{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{proj}}_{{f}_{2}(t)}\\,g(t) & =\\frac{-2{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\cdot \\operatorname{sin}⁡t \\\\  & =\\frac{-2{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}\\cdot \\operatorname{sin}⁡t \\\\  & =-2\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =6-2\\operatorname{sin}⁡t.\\end{aligned}\n$$"} :step/id #uuid "0bc7e18b-fdb5-5429-828f-e671a9abcbda" :step/next {:db/id #edb/ref 17592186413793}} {:db/id #edb/ref 17592186413795 :step/content {:db/id #edb/ref 17592186241059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "694bbe7e-1033-5685-8db7-c579e340a4af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186238969} {:answer/id #uuid "7187a2ab-aec2-5516-9817-82c6b1e6f0ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186239028} {:answer/id #uuid "98f9f087-a4cb-5b2b-ba88-6c34977c1ab6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186239383} {:answer/id #uuid "d0b7eedf-e87f-53c1-a7c0-62ebe727a2fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186239882} {:answer/id #uuid "f69f76e8-1b93-5cd1-b517-2cdfc888efb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186240229}] :answer-field/correct {:db/id #edb/ref 17592186239028} :answer-field/id #uuid "eabf99e8-310f-5528-b7c0-2d81c99774f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240742}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a70f1b99-0d4b-5ef2-9e7e-0dc7f6d78417" :question/math-academy-id "q-105461" :question/problem "Let $V=C[0,1],$ the vector space of functions that are continuous over $[0,1].$ Given that the inner product on $V$ is defined as \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{1}x(t)y(t)\\,\\text{d}t,\n$$\n\nfind the distance between $f(t)=3t$ and $g(t)=-3t+3$ with respect to the inner product." :question/worked-solution "The distance between $f(t)=3t$ and $g(t)=-3t+3$ with respect to the given inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-g(t)‖ \\\\  & =‖3t-(-3t+3)‖ \\\\  & =‖6t-3‖ \\\\  & =\\sqrt{⟨6t-3,6t-3⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨6t-3,6t-3⟩ & ={\\int }_{0}^{1}(6t-3)^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(36{t}^{2}-36t+9)\\text{d}t \\\\  & =[12{t}^{3}-18{t}^{2}+9t]_{0}^{1} \\\\  & =(12-18+9)-0 \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{3}.$"} :step/id #uuid "5b37fdbb-b243-534e-930c-c4161c64569a" :step/next {:db/id #edb/ref 17592186413796}} {:db/id #edb/ref 17592186413796 :step/content {:db/id #edb/ref 17592186241063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10e4eb1a-f07b-5500-9b6b-bb104419f1ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186238193} {:answer/id #uuid "1597005a-083a-5b2f-904c-d3601ce7fd24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186238235} {:answer/id #uuid "189191f2-31ca-5b6a-bb47-311abb8904ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186238264} {:answer/id #uuid "46644984-af18-5419-96cd-d6307758e813" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186238666} {:answer/id #uuid "94691432-7499-5d85-bd53-7c03102b3e45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186239340}] :answer-field/correct {:db/id #edb/ref 17592186238264} :answer-field/id #uuid "e7bf2326-7e5c-5bac-b442-4f7e564308dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240734}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5d460b9a-6ed3-5d23-955f-f3e1840b55a2" :question/math-academy-id "q-105475" :question/problem "Let $V=C[0,1],$ the vector space of functions that are continuous over $[0,1].$ Given that the inner product on $V$ is defined as \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{1}x(t)y(t)\\,\\text{d}t,\n$$\n\nfind the distance between $f(t)=8t$ and the subspace spanned by $g(t)=4t-2$ with respect to the inner product." :question/worked-solution "The orthogonal projection of $f(t)$ onto $\\text{Span}\\{g(t)\\}$ is given by\n\n$$\n\\begin{aligned}{\\text{proj}}_{g(t)}\\,f(t) & =\\frac{⟨f(t),g(t)⟩}{⟨g(t),g(t)⟩}\\,g(t) \\\\  & =\\frac{{\\int }_{0}^{1}8t\\cdot (4t-2)\\,\\text{d}t}{{\\int }_{0}^{1}(4t-2)^{2}\\,\\text{d}t}\\cdot (4t-2) \\\\  & =\\frac{{\\int }_{0}^{1}(32{t}^{2}-16t)\\,\\text{d}t}{{\\int }_{0}^{1}(16{t}^{2}-16t+4)\\,\\text{d}t}\\cdot (4t-2) \\\\  & =\\frac{[\\frac{32}{3}{t}^{3}-8{t}^{2}]_{0}^{1}}{[\\frac{16}{3}{t}^{3}-8{t}^{2}+4t]_{0}^{1}}\\cdot (4t-2) \\\\  & =\\frac{(\\frac{32}{3}-8)-0}{(\\frac{16}{3}-4)-0}\\cdot (6t-3) \\\\  & =\\frac{(\\frac{8}{3})}{(\\frac{4}{3})}\\cdot (4t+2) \\\\  & =2\\cdot (4t-2) \\\\  & =8t-4.\\end{aligned}\n$$\n\nThe distance between $f(t)=8t$ and the subspace spanned by $g(t)=4t-2$ with respect to our inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-{\\text{proj}}_{g(t)}\\,f(t)‖ \\\\  & =‖8t-(8t-4)‖ \\\\  & =‖4‖ \\\\  & =\\sqrt{⟨4,4⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨4,4⟩ & ={\\int }_{0}^{1}4\\cdot 4\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}16\\,\\text{d}t \\\\  & =16t\\,{|}_{0}^{1} \\\\  & =16-0 \\\\  & =16.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{16}=4.$"} :step/id #uuid "5b4d4a19-f8e8-5a9a-8c13-582c4e2b0863"} {:db/id #edb/ref 17592186413797 :step/content {:db/id #edb/ref 17592186240983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b29cd5-55b5-5722-ba90-23f769345723" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t+1" :db/id #edb/ref 17592186238150} {:answer/id #uuid "5bc19ba5-b098-5af2-b759-18b7d61fa0df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cos}⁡t+4\\operatorname{sin}⁡t+1" :db/id #edb/ref 17592186238854} {:answer/id #uuid "64e8e822-ab38-5fcf-a7cb-162397992404" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t" :db/id #edb/ref 17592186238937} {:answer/id #uuid "9cd846ec-dcb9-5576-8a82-5cbd0e68c90d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡t-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239418} {:answer/id #uuid "a19047b8-6624-5f0c-b217-a2d6a5d4fcd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{cos}⁡t+5\\operatorname{sin}⁡t+1" :db/id #edb/ref 17592186239462}] :answer-field/correct {:db/id #edb/ref 17592186238937} :answer-field/id #uuid "f5a8c5d5-fcb2-5bdd-8555-14fa5c61c1d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240761}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "645a82fe-e42f-5dc9-9e79-d8bd0747a894" :question/math-academy-id "q-105136" :question/problem "Let $V=C[-\\pi ,\\pi ],$ the vector space of continuous functions over $[-\\pi ,\\pi ]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=\\operatorname{cos}⁡t,\\,{f}_{2}(t)=\\operatorname{sin}⁡t,\\,g(t)=5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t+1\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}\\{{f}_{1}(t),{f}_{2}(t)\\}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{1}(t)\\}$ equals $5\\operatorname{cos}⁡t.$" :question/worked-solution "Since the set $\\{{f}_{1}(t),{f}_{2}(t)\\}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{1}(t)}\\,g(t)=5\\operatorname{cos}⁡t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{2}(t)\\}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{2}(t)⟩}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\,{f}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & ={\\int }_{-\\pi }^{\\pi }g(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }(5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t+1)\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =5{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t+{\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡t$ is an odd function, while $\\operatorname{cos}⁡t$ is even. Hence, their product $\\operatorname{cos}⁡t\\operatorname{sin}⁡t$ must be an odd function. Now, since we have an integral over the interval $[-\\pi ,\\pi ],$ which is symmetric about the origin, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t=0.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & =-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{proj}}_{{f}_{2}(t)}\\,g(t) & =\\frac{-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\cdot \\operatorname{sin}⁡t \\\\  & =\\frac{-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}\\cdot \\operatorname{sin}⁡t \\\\  & =-4\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t.\\end{aligned}\n$$"} :step/id #uuid "681a7c6c-5a02-51e9-b790-4836129a3fb4" :step/next {:db/id #edb/ref 17592186413794}}] :activity/title "Projecting Vectors Onto Subspaces in Inner Product Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186413792}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186543644} :activity/id #uuid "523c181c-49b6-5cd6-8fa6-f326baf39d66" :activity/scope {:db/id #edb/ref 17592186050841 :topic/id #uuid "6aced1c3-bd0e-5b1d-973e-105b955f9e1a" :topic/math-academy-id 2126} :activity/steps [{:db/id #edb/ref 17592186543611 :step/content {:db/id #edb/ref 17592186543554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55f451c5-1cf6-5e8f-b78f-8d4162ba19df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186542871} {:answer/id #uuid "8aeb3719-7223-5b3f-9a0d-5ec07ace7bda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186543008} {:answer/id #uuid "a13cafa2-36ee-5a1f-b1e2-a197fbd99fd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186543067} {:answer/id #uuid "af5d4774-4ab0-51ea-ab1d-5bfe0d1c2a08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186543097} {:answer/id #uuid "c8b0d1b2-9e6e-5c88-a436-a3385da1208b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186543163}] :answer-field/correct {:db/id #edb/ref 17592186543163} :answer-field/id #uuid "5b5594d1-b2ee-51bd-9f3b-6fbc40eddcaf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543347}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bb47ff23-1630-5500-b6a4-5200379ffde8" :question/math-academy-id "q-105467" :question/problem "Let $V={R}_{1}[t],$ the vector space of polynomials of degree at most $1$ with real coefficients. Given that the inner product on $V$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(0)q(0)+p(1)q(1),\n$$\n\nfind the distance between $f(t)=4t$ and $g(t)=3t-3$ with respect to the inner product." :question/worked-solution "The distance between $f(t)=4t$ and $g(t)=3t-3$ with respect to the given inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-g(t)‖ \\\\  & =‖4t-(3t-3)‖ \\\\  & =‖t+3‖ \\\\  & =\\sqrt{⟨t+3,t+3⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨t+3,t+3⟩ & =(t+3){|}_{0}\\cdot (t+3){|}_{0}+(t+3){|}_{1}\\cdot (t+3){|}_{1} \\\\  & =3\\cdot 3+4\\cdot 4 \\\\  & =25.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{25}=5.$"} :step/id #uuid "25ebdf79-afa5-5b0e-8ef3-42e59a98265f" :step/next {:db/id #edb/ref 17592186543641}} {:db/id #edb/ref 17592186543620 :step/content {:db/id #edb/ref 17592186134064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a97740-bf4e-5245-a223-1105ad76868c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t" :db/id #edb/ref 17592186238086} {:answer/id #uuid "0ccb496a-1f3e-5f9c-9be5-7756bb97a385" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t+2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186238169} {:answer/id #uuid "9dbfd16e-b04d-5762-91cf-d69f6af7923d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t+\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239432} {:answer/id #uuid "a5578604-9539-5565-8bbb-579ff2d23c8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239490} {:answer/id #uuid "ff74f82e-113d-5ba7-9d63-962e019ecfd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186240320}] :answer-field/correct {:db/id #edb/ref 17592186238086} :answer-field/id #uuid "50e2f23b-8197-5ffd-805f-f3ecff761a73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240475}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e7a8c44b-b300-5e66-9428-e03f400ebf5f" :question/math-academy-id "q-105416" :question/problem "Let $V=C[-\\pi ,\\pi ],$ the vector space of continuous functions over $[-\\pi ,\\pi ]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=\\operatorname{sin}⁡t,\\,{f}_{2}(t)=\\operatorname{cos}⁡t,\\,g(t)={sin}^{2}⁡t-\\operatorname{cos}⁡t\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}\\{{f}_{1}(t),{f}_{2}(t)\\}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{2}(t)\\}$ equals $-\\operatorname{cos}⁡t.$" :question/worked-solution "Since the set $\\{{f}_{1}(t),{f}_{2}(t)\\}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{2}(t)}\\,g(t)=-\\operatorname{cos}⁡t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{1}(t)\\}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{1}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{1}(t)⟩}{⟨{f}_{1}(t),{f}_{1}(t)⟩}\\,{f}_{1}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{1}(t)⟩ & ={\\int }_{-\\pi }^{\\pi }g(t){f}_{1}(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡t$ is an odd function, while ${sin}^{2}⁡t-\\operatorname{cos}⁡t$ is even. Hence, their product $\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)$ must be an odd function. Now, since we have an integral over the interval $[-\\pi ,\\pi ],$ which is symmetric about the origin, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\,\\text{d}t=0.\n$$\n\n  \n\nTherefore,\n\n$$\n{\\text{proj}}_{{f}_{1}(t)}\\,g(t)=\\frac{0}{⟨{f}_{1}(t),{f}_{1}(t)⟩}\\cdot \\operatorname{sin}⁡t=0.\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =0-\\operatorname{cos}⁡t \\\\  & =-\\operatorname{cos}⁡t.\\end{aligned}\n$$"} :step/id #uuid "32c4db97-0f9a-5a4a-9397-f3afd25d9b5a" :step/next {:db/id #edb/ref 17592186543611}} {:db/id #edb/ref 17592186543641 :step/content {:db/id #edb/ref 17592186241063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10e4eb1a-f07b-5500-9b6b-bb104419f1ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186238193} {:answer/id #uuid "1597005a-083a-5b2f-904c-d3601ce7fd24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186238235} {:answer/id #uuid "189191f2-31ca-5b6a-bb47-311abb8904ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186238264} {:answer/id #uuid "46644984-af18-5419-96cd-d6307758e813" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186238666} {:answer/id #uuid "94691432-7499-5d85-bd53-7c03102b3e45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186239340}] :answer-field/correct {:db/id #edb/ref 17592186238264} :answer-field/id #uuid "e7bf2326-7e5c-5bac-b442-4f7e564308dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240734}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5d460b9a-6ed3-5d23-955f-f3e1840b55a2" :question/math-academy-id "q-105475" :question/problem "Let $V=C[0,1],$ the vector space of functions that are continuous over $[0,1].$ Given that the inner product on $V$ is defined as \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{1}x(t)y(t)\\,\\text{d}t,\n$$\n\nfind the distance between $f(t)=8t$ and the subspace spanned by $g(t)=4t-2$ with respect to the inner product." :question/worked-solution "The orthogonal projection of $f(t)$ onto $\\text{Span}\\{g(t)\\}$ is given by\n\n$$\n\\begin{aligned}{\\text{proj}}_{g(t)}\\,f(t) & =\\frac{⟨f(t),g(t)⟩}{⟨g(t),g(t)⟩}\\,g(t) \\\\  & =\\frac{{\\int }_{0}^{1}8t\\cdot (4t-2)\\,\\text{d}t}{{\\int }_{0}^{1}(4t-2)^{2}\\,\\text{d}t}\\cdot (4t-2) \\\\  & =\\frac{{\\int }_{0}^{1}(32{t}^{2}-16t)\\,\\text{d}t}{{\\int }_{0}^{1}(16{t}^{2}-16t+4)\\,\\text{d}t}\\cdot (4t-2) \\\\  & =\\frac{[\\frac{32}{3}{t}^{3}-8{t}^{2}]_{0}^{1}}{[\\frac{16}{3}{t}^{3}-8{t}^{2}+4t]_{0}^{1}}\\cdot (4t-2) \\\\  & =\\frac{(\\frac{32}{3}-8)-0}{(\\frac{16}{3}-4)-0}\\cdot (6t-3) \\\\  & =\\frac{(\\frac{8}{3})}{(\\frac{4}{3})}\\cdot (4t+2) \\\\  & =2\\cdot (4t-2) \\\\  & =8t-4.\\end{aligned}\n$$\n\nThe distance between $f(t)=8t$ and the subspace spanned by $g(t)=4t-2$ with respect to our inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-{\\text{proj}}_{g(t)}\\,f(t)‖ \\\\  & =‖8t-(8t-4)‖ \\\\  & =‖4‖ \\\\  & =\\sqrt{⟨4,4⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨4,4⟩ & ={\\int }_{0}^{1}4\\cdot 4\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}16\\,\\text{d}t \\\\  & =16t\\,{|}_{0}^{1} \\\\  & =16-0 \\\\  & =16.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{16}=4.$"} :step/id #uuid "71427223-2fdd-5bbd-81e0-02928d1f72bb" :step/next {:db/id #edb/ref 17592186543648}} {:db/id #edb/ref 17592186543644 :step/content {:db/id #edb/ref 17592186240996 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0344b9d3-e2c9-5e68-8387-9d156ec78af5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4t-1" :db/id #edb/ref 17592186238109} {:answer/id #uuid "38d8be68-9c00-55d7-a56c-7befbf436eeb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t+4" :db/id #edb/ref 17592186238546} {:answer/id #uuid "987f211a-e0b1-5d31-98ab-50e669f1f18d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-t-4" :db/id #edb/ref 17592186239379} {:answer/id #uuid "c9978a6c-0315-53fc-8721-497fe7cfdd44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t-4" :db/id #edb/ref 17592186239825} {:answer/id #uuid "ff73caf6-d30c-588c-ba5d-e9b43a4176d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4t+1" :db/id #edb/ref 17592186240319}] :answer-field/correct {:db/id #edb/ref 17592186239379} :answer-field/id #uuid "9ab72fad-6b2e-54ff-84a2-97ee3410e0b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240600}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "38abb364-8716-52b0-b273-cfd769e1ebaf" :question/math-academy-id "q-105173" :question/problem "Let $V={R}_{1}[t],$ the vector space of real polynomials of degree at most $1,$ and let the inner product on $V$ be defined as\n\n$$\n⟨p(t),q(t)⟩=p(0)q(0)+p(1)q(1).\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{p}_{1}(t)=5t,\\,{p}_{2}(t)=-2t+2,\\,q(t)=-t-4\n$$\n\nFind the orthogonal projection of $q(t)$ onto $S=\\text{Span}\\{{p}_{1}(t),{p}_{2}(t)\\}$ given that ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $q(t)$ onto $\\text{Span}\\{{p}_{1}(t)\\}$ equals $-5t.$" :question/worked-solution "Since the set $\\{{p}_{1}(t),{p}_{2}(t)\\}$ is orthogonal, the orthogonal projection of $q(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,q(t)={\\text{proj}}_{{p}_{1}(t)}\\,q(t)+{\\text{proj}}_{{p}_{2}(t)}\\,q(t).\n$$\n\nWe are given that ${\\text{proj}}_{{p}_{1}(t)}\\,q(t)=-5t,$ so let's now find the orthogonal projection of $q(t)$ onto $\\text{Span}\\{{p}_{2}(t)\\}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{p}_{2}(t)}\\,q(t)=\\frac{⟨q(t),{p}_{2}(t)⟩}{⟨{p}_{2}(t),{p}_{2}(t)⟩}\\,{p}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨q(t),{p}_{2}(t)⟩ & =q(0){p}_{2}(0)+q(1){p}_{2}(1) \\\\  & =(-t-4){|}_{0}\\cdot (-2t+2){|}_{0}+(-t-4){|}_{1}\\cdot (-2t+2){|}_{1} \\\\  & =(-4)\\cdot 2+(-5)\\cdot 0 \\\\  & =-8,\\end{aligned}\n$$\n\n  \n\nand\n\n$$\n\\begin{aligned}⟨{p}_{2}(t),{p}_{2}(t)⟩ & ={p}_{2}(0){p}_{2}(0)+{p}_{2}(1){p}_{2}(1) \\\\  & =(-2t+2)^{2}{|}_{0}+(-2t+2)^{2}{|}_{1} \\\\  & ={2}^{2}+{0}^{2} \\\\  & =4.\\end{aligned}\n$$\n\n  \n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{proj}}_{{p}_{2}(t)}\\,q(t) & =\\frac{-8}{4}\\cdot (-2t+2)=4t-4.\\end{aligned}\n$$\n\n  \n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,q(t) & ={\\text{proj}}_{{p}_{1}(t)}\\,q(t)+{\\text{proj}}_{{p}_{2}(t)}\\,q(t) \\\\  & =-5t+(4t-4) \\\\  & =-t-4.\\end{aligned}\n$$"} :step/id #uuid "7dcbde88-fad6-5855-868c-5505b488f9cb" :step/next {:db/id #edb/ref 17592186543620}} {:db/id #edb/ref 17592186543648 :step/content {:db/id #edb/ref 17592186241070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "115a1a24-40d3-5c4e-90a0-aba0abe29c7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186238197} {:answer/id #uuid "15ded9d3-4cca-5004-b210-7749aa971397" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186238238} {:answer/id #uuid "6443e3f8-344b-515f-9f3c-5f8b07fe516d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186238934} {:answer/id #uuid "6c65aac7-23ec-5d9b-8810-f82f35fdf04f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186238990} {:answer/id #uuid "d32580ad-4b5e-51a7-ab6f-b7e8dce6cdbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186239906}] :answer-field/correct {:db/id #edb/ref 17592186239906} :answer-field/id #uuid "60d3d74f-f2f9-508a-ab35-c3402c95444f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240508}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0a9984c7-9d50-53ab-9302-5dd592a189c5" :question/math-academy-id "q-105496" :question/problem "Let $V={R}_{1}[t],$ the vector space of polynomials of degree at most $1$ with real coefficients. Given that the inner product on $V$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(0)q(0)+p(1)q(1),\n$$\n\nfind the distance between $f(t)=8t-3$ and $g(t)=3t+2$ with respect to the inner product." :question/worked-solution "The distance between $f(t)=8t-3$ and $g(t)=3t+2$ with respect to the given inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-g(t)‖ \\\\  & =‖8t-3-(3t+2)‖ \\\\  & =‖5t-5‖ \\\\  & =\\sqrt{⟨5t-5,5t-5⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨5t-5,5t-5⟩ & =(5t-5){|}_{0}\\cdot (5t-5){|}_{0}+(5t-5){|}_{1}\\cdot (5t-5){|}_{1} \\\\  & =(-5)\\cdot (-5)+0\\cdot 0 \\\\  & =25.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{25}=5.$"} :step/id #uuid "8daf7e4b-481a-569d-84a0-20ce16510f71"}] :activity/title "Projecting Vectors Onto Subspaces in Inner Product Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186542621}]}
