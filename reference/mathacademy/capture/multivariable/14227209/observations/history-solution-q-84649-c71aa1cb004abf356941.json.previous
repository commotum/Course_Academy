xt-align: right; padding-right: 0px; padding-top: 0.4em;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D459 TEX-I\"></mjx-c></mjx-mi><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-top: 0.4em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><msup><mi>P</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">(</mo><mi>l</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>l</mi><msqrt><mn>200</mn><mo>−</mo><msup><mi>l</mi><mn>2</mn></msup></msqrt></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>l</mi><msqrt><mn>200</mn><mo>−</mo><msup><mi>l</mi><mn>2</mn></msup></msqrt></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn></mtd></mtr><mtr><mtd><mi>l</mi></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>200</mn><mo>−</mo><msup><mi>l</mi><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd><msup><mi>l</mi><mn>2</mn></msup></mtd><mtd><mi></mi><mo>=</mo><mn>200</mn><mo>−</mo><msup><mi>l</mi><mn>2</mn></msup></mtd></mtr><mtr><mtd><mn>2</mn><msup><mi>l</mi><mn>2</mn></msup></mtd><mtd><mi></mi><mo>=</mo><mn>200</mn></mtd></mtr><mtr><mtd><msup><mi>l</mi><mn>2</mn></msup></mtd><mtd><mi></mi><mo>=</mo><mn>100</mn></mtd></mtr><mtr><mtd><mi>l</mi></mtd><mtd><mi></mi><mo>=</mo><mn>10</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>All that's left now is to confirm that <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"74\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D459 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>l</mi><mo>=</mo><mn>10</mn></math></mjx-assistive-mml></mjx-container> does indeed give a maximum value of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"75\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D443 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D459 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mo stretchy=\"false\">(</mo><mi>l</mi><mo stretchy=\"false\">)</mo><mo>.</mo></math></mjx-assistive-mml></mjx-container> To do this, we use the first derivative test. We write up a table of values:</p>\n<table rules=\"all\" cellpadding=\"10\" align=\"center\" style=\"border:1px solid black; margin: auto; margin-bottom: 4mm; margin-top: 4mm\">\n<tbody><tr>\n    <td width=\"60px\" bgcolor=\"#D6EAF8\" align=\"center\">Interval</td>\n    <td width=\"60px\" align=\"center\"><mjx-container class=\"MathJax