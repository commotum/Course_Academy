4864 17592186045417 true] [17592186441612 1075 #edb/ref 17592186441604 13194139534864 17592186045417 true] [17592186441612 1075 #edb/ref 17592186441609 13194139534864 17592186045417 true] [17592186441612 1076 #edb/ref 17592186045493 13194139534864 17592186045417 true] [17592186441612 1077 "selection" 13194139534864 17592186045417 true] [17592186441612 1078 #edb/ref 17592186441604 13194139534864 17592186045417 true] [17592186441612 1079 #uuid "25ffc2c7-e514-54e6-8c7b-600c1de04088" 13194139534864 17592186045417 true] [17592186441613 1075 #edb/ref 17592186441601 13194139534864 17592186045417 true] [17592186441613 1075 #edb/ref 17592186441603 13194139534864 17592186045417 true] [17592186441613 1075 #edb/ref 17592186441605 13194139534864 17592186045417 true] [17592186441613 1075 #edb/ref 17592186441607 13194139534864 17592186045417 true] [17592186441613 1075 #edb/ref 17592186441610 13194139534864 17592186045417 true] [17592186441613 1076 #edb/ref 17592186045493 13194139534864 17592186045417 true] [17592186441613 1077 "selection" 13194139534864 17592186045417 true] [17592186441613 1078 #edb/ref 17592186441610 13194139534864 17592186045417 true] [17592186441613 1079 #uuid "7c819006-1c8a-567c-839e-c05698400658" 13194139534864 17592186045417 true] [17592186441614 1075 #edb/ref 17592186441593 13194139534864 17592186045417 true] [17592186441614 1075 #edb/ref 17592186441594 13194139534864 17592186045417 true] [17592186441614 1075 #edb/ref 17592186441595 13194139534864 17592186045417 true] [17592186441614 1075 #edb/ref 17592186441598 13194139534864 17592186045417 true] [17592186441614 1075 #edb/ref 17592186441600 13194139534864 17592186045417 true] [17592186441614 1076 #edb/ref 17592186045493 13194139534864 17592186045417 true] [17592186441614 1077 "selection" 13194139534864 17592186045417 true] [17592186441614 1078 #edb/ref 17592186441595 13194139534864 17592186045417 true] [17592186441614 1079 #uuid "a7e8d331-dfbd-5435-859b-6678685b6ee8" 13194139534864 17592186045417 true] [17592186441615 1068 #edb/ref 17592186441614 13194139534864 17592186045417 true] [17592186441615 1069 "q-126936" 13194139534864 17592186045417 true] [17592186441615 1070 #edb/ref 17592186045487 13194139534864 17592186045417 true] [17592186441615 1071 "![](images/23/23d35daa15e11899592683f2f3215506cc0337358be843780dbf1190c0e38e2c.png)\n\nCalculate ${∮}_{∂D}({x}^{2}+{e}^{x})\\,dx+({x}^{2}+{y}^{2})^{3/2}\\,dy,$ where $D$ is the annular region shown above." 13194139534864 17592186045417 true] [17592186441615 1072 #uuid "0e02e690-e43f-5ecb-8751-7e2242b3bc65" 13194139534864 17592186045417 true] [17592186441615 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)={x}^{2}+{e}^{x}$ and $Q(x,y)=({x}^{2}+{y}^{2})^{3/2}.$ So,\n\n$$\n\\frac{∂P}{∂y}=0,\\,\\frac{∂Q}{∂x}=3x\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}({x}^{2}+{e}^{x})\\,dx+({x}^{2}+{y}^{2})^{3/2}\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}3x\\sqrt{{x}^{2}+{y}^{2}}-0\\,\\text{d}A \\\\  & ={∬}_{D}3x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A.\\end{aligned}\n$$\n\nThe region $D$ can be represented in polar coordinates as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,4\\le r\\le 8,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nRecall that the change of variables formula for polar coordinates gives\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, our double integral becomes\n\n$$\n\\begin{aligned}{∬}_{D}3x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={\\int }_{0}^{2\\pi }{\\int }_{4}^{8}3\\cdot r\\operatorname{cos}⁡\\theta \\cdot \\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{4}^{8}3\\cdot r\\operatorname{cos}⁡\\theta \\cdot \\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{4}^{8}3{r}^{2}\\operatorname{cos}⁡\\theta \\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{4}^{8}3{r}^{3}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta {\\int }_{4}^{8}3{r}^{3}\\,\\text{d}r \\\\  & =\\operatorname{sin}⁡\\theta \\,{|}_{0}^{2\\pi }\\cdot \\frac{3{r}^{4}}{4}\\,{|}_{4}^{8} \\\\  & =(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(0))\\cdot (\\frac{3(8)^{4}}{4}-\\frac{3(4)^{4}}{4}) \\\\  & =0\\cdot (\\frac{3(8)^{4}}{4}-\\frac{3(4)^{4}}{4}) \\\\  & =0.\\end{aligned}\n$$" 13194139534864 17592186045417 true] [17592186441616 1068 #edb/ref 17592186441611 13194139534864 17592186045417 true] [17592186441616 1069 "q-126947" 13194139534864 17592186045417 true] [17592186441616 1070 #edb/ref 17592186045486 13194139534864 17592186045417 true] [17592186441616 1071 "![](images/82/823ab320e0f1426b846c7bf561b977ac6458c80d235aabdc5647a7db07c4cb74.png)\n\nCalculate \n${∮}_{∂D}(2x{y}^{3}+{x}^{5})\\,dx+(5{x}^{2}{y}^{2}-{y}^{3})\\,dy,$\nwhere $D$ is the region shown above." 13194139534864 17592186045417 true] [17592186441616 1072 #uuid "311f57fc-3b6c-595d-a8b9-91e8d4d5d656" 13194139534864 17592186045417 true] [17592186441616 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=2x{y}^{3}+{x}^{5}$ and $Q(x,y)=5{x}^{2}{y}^{2}-{y}^{3}.$ Therefore,\n\n$$\n\\frac{∂P}{∂y}=6x{y}^{2},\\,\\frac{∂Q}{∂x}=10x{y}^{2}.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}(2x{y}^{3}+{x}^{5})\\,dx+(5{x}^{2}{y}^{2}-{y}^{3})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}10x{y}^{2}-6x{y}^{2}\\,\\text{d}A \\\\  & ={∬}_{D}4x{y}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nThe region $D$ can be represented in Cartesian coordinates as ${Δ}_{1}∖{Δ}_{2},$ where\n\n- ${Δ}_{1}=\\{(x,y)\\,:\\,-1\\le x\\le 2,-2\\le y\\le 1\\}$ is the region enclosed by the outer curve, and\n\n- ${Δ}_{2}=\\{(x,y)\\,:\\,0\\le x\\le 1,-1\\le y\\le 0\\}$ is the region enclosed by the inner curve.\n\nTherefore, our double integral becomes\n\n$$\n\\begin{aligned}{∬}_{D}4x{y}^{2}\\,\\text{d}A & ={∬}_{{Δ}_{1}}4x{y}^{2}\\,\\text{d}A-{∬}_{{Δ}_{2}}4x{y}^{2}\\,\\text{d}A \\\\  & ={\\int }_{-2}^{1}{\\int }_{-1}^{2}4x{y}^{2}\\,\\text{d}x\\,\\text{d}y-{\\int }_{-1}^{0}{\\int }_{0}^{1}4x{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{-1}^{2}4x\\,\\text{d}x{\\int }_{-2}^{1}{y}^{2}\\,\\text{d}y-{\\int }_{0}^{1}4x\\,\\text{d}x{\\int }_{-1}^{0}{y}^{2}\\,\\text{d}y \\\\  & =2{x}^{2}\\,{|}_{-1}^{2}\\cdot \\frac{{y}^{3}}{3}\\,{|}_{-2}^{1}-2{x}^{2}\\,{|}_{0}^{1}\\cdot \\frac{{y}^{3}}{3}\\,{|}_{-1}^{0} \\\\  & =(8-2)\\cdot (\\frac{1}{3}-(-\\frac{8}{3}))-(2-0)\\cdot (0-(-\\frac{1}{3})) \\\\  & =6\\cdot 3-2\\cdot \\frac{1}{3} \\\\  & =18-\\frac{2}{3} \\\\  & =\\frac{52}{3}.\\end{aligned}\n$$" 13194139534864 17592186045417 true] [17592186441617 1068 #edb/ref 17592186441612 13194139534864 17592186045417 true] [17592186441617 1069 "q-126893" 13194139534864 17592186045417 true] [17592186441617 1070 #edb/ref 17592186045487 13194139534864 17592186045417 true] [17592186441617 1071 "![](images/df/df52e2add706a17bf93236cdaa04582932b6c799d4a88a3e194a3a3788c816ff.png)\n\nCalculate ${∮}_{∂D}3y\\,dx+7x\\,dy,$ where $D$ is the annular region shown above." 13194139534864 17592186045417 true] [17592186441617 1072 #uuid "93b19a79-b263-5685-8630-5024a89d98bd" 13194139534864 17592186045417 true] [17592186441617 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=3y$ and $Q(x,y)=7x.$ So,\n\n$$\n\\frac{∂P}{∂y}=3,\\,\\frac{∂Q}{∂x}=7.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}dx+x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(7-3)\\,\\text{d}A \\\\  & ={∬}_{D}4\\,\\text{d}A \\\\  & =4\\,\\text{Area}(D) \\\\  & =4\\cdot (\\pi \\cdot {3}^{2}-\\pi \\cdot {1}^{2}) \\\\  & =4\\cdot 8\\pi  \\\\  & =32\\pi .\\end{aligned}\n$$" 13194139534864 17592186045417 true] [17592186441618 1068 #edb/ref 17592186441613 13194139534864 17592186045417 true] [17592186441618 1069 "q-126871" 13194139534864 17592186045417 true] [17592186441618 1070 #edb/ref 17592186045485 13194139534864 17592186045417 true] [17592186441618 1071 "![](images/69/69b42001c8ac5e95e18d89785e73fbba3e78554f9146e59bb50dd618b105f10c.png)\n\nCalculate ${∮}_{∂D}4y\\,dx+5x\\,dy,$ where $D$ is the region shown above." 13194139534864 17592186045417 true] [17592186441618 1072 #uuid "d4082a24-9ee0-5ed5-bf60-7857736d7c8e" 13194139534864 17592186045417 true] [17592186441618 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=4y$ and $Q(x,y)=5x.$ So, \n\n$$\n\\frac{∂P}{∂y}=4,\\,\\frac{∂Q}{∂x}=5.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}4y\\,dx+5x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(5-4)\\,\\text{d}A \\\\  & ={∬}_{D}\\,\\text{d}A \\\\  & =\\text{Area}(D) \\\\  & =\\frac{4\\cdot 4}{2}-\\frac{2\\cdot 2}{2} \\\\  & =8-2 \\\\  & =6.\\end{aligned}\n$$" 13194139534864 17592186045417 true] [17592186441619 1058 #edb/ref 17592186441623 13194139534864 17592186045417 true] [17592186441619 1062 #uuid "01e542b7-96ca-5f0d-8fd7-24a75625fa09" 13194139534864 17592186045417 true] [17592186441619 1063 #edb/ref 17592186441617 13194139534864 17592186045417 true] [17592186441620 1058 #edb/ref 17592186441622 13194139534864 17592186045417 true] [17592186441620 1062 #uuid "39c00f45-8518-5817-af27-2a3b132c427a" 13194139534864 17592186045417 true] [17592186441620 1063 #edb/ref 17592186134098 13194139534864 17592186045417 true] [17592186441621 1062 #uuid "58400d8d-2398-5d06-be9d-44c7cb7e18b1" 13194139534864 17592186045417 true] [17592186441621 1063 #edb/ref 17592186441616 13194139534864 17592186045417 true] [17592186441622 1058 #edb/ref 17592186441619 13194139534864 17592186045417 true] [17592186441622 1062 #uuid "6ae2af08-c3b9-5a97-9f39-1c8f6e552dc4" 13194139534864 17592186045417 true] [17592186441622 1063 #edb/ref 17592186441618 13194139534864 17592186045417 true] [17592186441623 1058 #edb/ref 17592186441621 13194139534864 17592186045