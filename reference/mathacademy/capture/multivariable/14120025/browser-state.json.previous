></mrow></munder><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">F</mi></mrow><mo>⋅</mo><mtext>d</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">r</mi></mrow></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><msub><mi>C</mi><mn>1</mn></msub></mrow></munder><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">F</mi></mrow><mo>⋅</mo><mtext>d</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">r</mi></mrow><mo>+</mo><munder><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><msub><mi>C</mi><mn>2</mn></msub></mrow></munder><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">F</mi></mrow><mo>⋅</mo><mtext>d</mtext><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">r</mi></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>16</mn><mo>+</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>2</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow></msubsup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">F</mi></mrow><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><msub><mi mathvariant=\"bold\">r</mi><mn mathvariant=\"bold\">2</mn></msub></mrow><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">)</mo><mo>⋅</mo><msubsup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">r</mi></mrow><mn>2</mn><mo data-mjx-alternate=\"1\">′</mo></msubsup><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>16</mn><mo>+</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>2</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow></msubsup><mo stretchy=\"false\">(</mo><mo>−</mo><msup><mi>t</mi><mn>4</mn></msup><mo>+</mo><mn>3</mn><msup><mi>t</mi><