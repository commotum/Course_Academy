      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14120025/observations/step-q77134-190801a47bc8fa026bda.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14120025/observations/step-q77134-190801a47bc8fa026bda.png",
      "source_url": "https://mathacademy.com/tasks/14120025/topics/3704/lesson",
      "captured_at": 1791733189.925173,
      "math_academy_id": "q-77134",
