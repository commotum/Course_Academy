            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-125419-a",
              "type": "math",
              "value": "{\\int }_{C}{e}^{{x}^{2}}\\,\\text{d}x+{e}^{y-1}\\,\\text{d}y",
