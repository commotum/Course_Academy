86045417 true] [17592186447150 1077 "selection" 13194139534992 17592186045417 true] [17592186447150 1078 #edb/ref 17592186447101 13194139534992 17592186045417 true] [17592186447150 1079 #uuid "f8dcb75d-dac3-5c81-8f6e-1e4763779208" 13194139534992 17592186045417 true] [17592186447151 1068 #edb/ref 17592186447145 13194139534992 17592186045417 true] [17592186447151 1069 "q-123639" 13194139534992 17592186045417 true] [17592186447151 1070 #edb/ref 17592186045486 13194139534992 17592186045417 true] [17592186447151 1071 "Calculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r=1+\\operatorname{sin}⁡\\theta $ for $\\frac{\\pi }{2}\\le \\theta \\le \\pi .$" 13194139534992 17592186045417 true] [17592186447151 1072 #uuid "1b5a0004-da97-5a43-bf86-5bd3413d5383" 13194139534992 17592186045417 true] [17592186447151 1074 "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1+\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=\\operatorname{cos}⁡\\theta .\n$$\n\nTherefore, we evaluate our line integral as follows:\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\sqrt{(1+\\operatorname{sin}⁡\\theta )^{2}+{(\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\sqrt{1+2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\sqrt{1+2\\operatorname{sin}⁡\\theta +1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\sqrt{2+2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{\\pi /2}^{\\pi }\\sqrt{1+\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{\\pi /2}^{\\pi }\\sqrt{{sin}^{2}⁡(\\frac{\\theta }{2})+{cos}^{2}⁡(\\frac{\\theta }{2})+2\\operatorname{sin}⁡(\\frac{\\theta }{2})\\operatorname{cos}⁡(\\frac{\\theta }{2})}\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{\\pi /2}^{\\pi }\\sqrt{{(\\operatorname{sin}⁡(\\frac{\\theta }{2})+\\operatorname{cos}⁡(\\frac{\\theta }{2}))}^{2}}\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{\\pi /2}^{\\pi }|\\operatorname{sin}⁡(\\frac{\\theta }{2})+\\operatorname{cos}⁡(\\frac{\\theta }{2})|\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}{[|-\\operatorname{cos}⁡(\\frac{\\theta }{2})+\\operatorname{sin}⁡(\\frac{\\theta }{2})|]}_{\\pi /2}^{\\pi } \\\\  & =2\\sqrt{2}(|-\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\operatorname{sin}⁡(\\frac{\\pi }{2})|-|-\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\operatorname{sin}⁡(\\frac{\\pi }{4})|) \\\\  & =2\\sqrt{2}(1-0) \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$" 13194139534992 17592186045417 true] [17592186447152 1068 #edb/ref 17592186447141 13194139534992 17592186045417 true] [17592186447152 1069 "q-123579" 13194139534992 17592186045417 true] [17592186447152 1070 #edb/ref 17592186045487 13194139534992 17592186045417 true] [17592186447152 1071 "![](images/05/051efe86fa3f118dd82c41f32071982bcdbacbab75212d867a5a809f37506192.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r=-2\\operatorname{sin}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{2},$ shown above." 13194139534992 17592186045417 true] [17592186447152 1072 #uuid "202a66ff-7a74-5355-8081-a73c26b6f2c0" 13194139534992 17592186045417 true] [17592186447152 1074 "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=-2\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-2\\operatorname{cos}⁡\\theta .\n$$\n\nTherefore, we evaluate our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(-2\\operatorname{sin}⁡\\theta )}^{2}+{(-2\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{4{sin}^{2}⁡\\theta +4{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{4({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}2\\,\\text{d}\\theta  \\\\  & =2(\\frac{\\pi }{2}-0) \\\\  & =\\pi \\end{aligned}\n$$" 13194139534992 17592186045417 true] [17592186447153 1068 #edb/ref 17592186447144 13194139534992 17592186045417 true] [17592186447153 1069 "q-149822" 13194139534992 17592186045417 true] [17592186447153 1070 #edb/ref 17592186045486 13194139534992 17592186045417 true] [17592186447153 1071 "Calculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r=4\\operatorname{sec}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{4}.$" 13194139534992 17592186045417 true] [17592186447153 1072 #uuid "27eda322-b707-5345-adf8-0465217fdeaf" 13194139534992 17592186045417 true] [17592186447153 1074 "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=4\\operatorname{sec}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=4\\operatorname{sec}⁡\\theta \\operatorname{tan}⁡\\theta .\n$$\n\nTherefore, we evaluate our line integral as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{(4\\operatorname{sec}⁡\\theta )}^{2}+{(4\\operatorname{sec}⁡\\theta \\operatorname{tan}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{16{sec}^{2}⁡\\theta +16{sec}^{2}⁡\\theta {tan}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{16{sec}^{2}⁡\\theta (1+{tan}^{2}⁡\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{16{sec}^{4}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{\\pi /4}{sec}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =4\\operatorname{tan}⁡\\theta \\,{|}_{0}^{\\pi /4} \\\\  & =4[\\operatorname{tan}⁡(\\frac{\\pi }{4})-\\operatorname{tan}⁡(0)] \\\\  & =4.\\end{aligned}\n$$" 13194139534992 17592186045417 true] [17592186447154 1068 #edb/ref 17592186447142 13194139534992 17592186045417 true] [17592186447154 1069 "q-123379" 13194139534992 17592186045417 true] [17592186447154 1070 #edb/ref 17592186045485 13194139534992 17592186045417 true] [17592186447154 1071 "![](images/19/19725cfd8068973c899fcb4f54abcebbbfcd24bd68aec510b9d41cee2c2cd02a.png)\n\nWhich of the following is equivalent to ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r=2-4\\operatorname{cos}⁡\\theta \\,$ for $\\frac{\\pi }{4}\\le \\theta \\le \\pi ,$ shown above?" 13194139534992 17592186045417 true] [17592186447154 1072 #uuid "586f6a61-ad62-56e5-9a2c-611ea0a2819c" 13194139534992 17592186045417 true] [17592186447154 1074 "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=2-4\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=4\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the expression for our line integral is\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi }\\sqrt{(2-4\\operatorname{cos}⁡\\theta )^{2}+(4\\operatorname{sin}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi }\\sqrt{4-16\\operatorname{cos}⁡\\theta +16{cos}^{2}⁡\\theta +16{sin}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi }\\sqrt{4-16\\operatorname{cos}⁡\\theta +16}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi }\\sqrt{20-16\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =2{\\int }_{\\pi /4}^{\\pi }\\sqrt{5-4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" 13194139534992 17592186045417 true] [17592186447155 1068 #edb/ref 17592186447143 13194139534992 17592186045417 true] [17592186447155 1069 "q-123588" 13194139534992 17592186045417 true] [17592186447155 1070 #edb/ref 17592186045486 13194139534992 17592186045417 true] [17592186447155 1071 "Calculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r={e}^{3\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{2}.$" 13194139534992 17592186045417 true] [17592186447155 1072 #uuid "64433fed-4bfa-5173-80b1-78dbdf657823" 13194139534992 17592186045417 true] [17592186447155 1074 "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={e}^{3\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=3{e}^{3\\theta }.\n$$\n\nTherefore, we evaluate our line integral as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{({e}^{3\\theta })}^{2}+{(3{e}^{3\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{6\\theta }+9{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{10{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{10}{\\int }_{0}^{\\pi /2}{e}^{3\\theta }\\,\\text{d}\\theta  \\\\  & =\\frac{\\sqrt{10}}{3}{e}^{3\\theta }{|}_{0}^{\\pi /2} \\\\  & =\\frac{\\sqrt{10}}{3}({e}^{3\\pi /2}-1).\\end{aligned}\n$$" 13194139534992 17592186045417 true] [17592186447156 1068 #edb/ref 17592186447149 13194139534992 17592186045417 true] [17592186447156 1069 "q-123581" 13194139534992 17592186045417 true] [17592186447156 1070 #edb/ref 17592186045487 13194139534992 17592186045417 true] [17592186447156 1071 "![](images/36/36008a9155a01a07136cee263ce0a89239719227541536e8c2f8ea358d43e6df.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r=\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{2},$ shown above." 13194139534992 17592186045417 true] [17592186447156 1072 #uuid "6947d1ad-4cd9-585a-b94f-f141875b9f2d" 13194139534992 17592186045417 true] [17592186447156 1074 "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta ,$ we have \n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, we evaluate our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )}^{2}+{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡\\theta +2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +{cos}^{2}⁡\\theta +{cos}^{2}⁡\\theta -2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +{sin}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡\\theta +\\cancel{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }+{cos}^{2}⁡\\theta +{cos}^{2}⁡\\theta -\\cancel{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }+{sin}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{2({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{2}\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}(\\frac{\\pi }{2}-0) \\\\  & =\\frac{\\pi }{\\sqrt{2}}\\end{aligned}\n$$" 13194139534992 17592186045417 true] [17592186447157 1068 #edb/ref 17592186447147 13194139534992 17592186045417 true] [17592186447157 1069 "q-123426" 13194139534992 17592186045417 true] [17592186447157 1070 #edb/ref 17592186045487 13194139534992 17592186045417 true] [17592186447157 1071 "Which of the following is equivalent to ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r=2{cos}^{3}⁡(\\frac{\\theta }{3})\\,$ for $0\\le \\theta \\le 3\\pi $ ?" 13194139534992 17592186045417 true] [17592186447157 1072 #uuid "70661cc4-274a-5311-99fc-fa9cf5ff480d" 13194139534992 17592186045417 true] [17592186447157 1074 "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=2{cos}^{3}⁡(\\frac{\\theta }{3})\\,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-2{cos}^{2}⁡(\\frac{\\theta }{3})\\operatorname{sin}⁡(\\frac{\\theta }{3}).\n$$\n\nTherefore, the expression for our line integral is \n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi }\\sqrt{{(2{cos}^{3}⁡(\\frac{\\theta }{3}))}^{2}+{(-2{cos}^{2}⁡(\\frac{\\theta }{3})\\operatorname{sin}⁡(\\frac{\\theta }{3}))}^{2}}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{3\\pi }\\sqrt{{cos}^{6}⁡(\\frac{\\theta }{3})+{cos}^{4}⁡(\\frac{\\theta }{3}){sin}^{2}⁡(\\frac{\\theta }{3})}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{3\\pi }{cos}^{2}⁡(\\frac{\\theta }{3})\\sqrt{{cos}^{2}⁡(\\frac{\\theta }{3})+{sin}^{2}⁡(\\frac{\\theta }{3})}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{3\\pi }{cos}^{2}⁡(\\frac{\\theta }{3})\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" 13194139534992 17592186045417 true] [17592186447158 1068 #edb/ref 17592186447148 13194139534992 17592186045417 true] [17592186447158 1069 "q-123511" 13194139534992 17592186045417 true] [17592186447158 1070 #edb/ref 17592186045487 13194139534992 17592186045417 true] [17592186447158 1071 "Which of the following is equivalent to ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r={sin}^{3}⁡\\theta \\,$ for $0\\le \\theta \\le \\pi $ ?" 13194139534992 17592186045417 true] [17592186447158 1072 #uuid "7aa4e4d5-0080-5cb6-bebe-9d6c94950127" 13194139534992 17592186045417 true] [17592186447158 1074 "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $