"mjx-c6D\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left right left\" columnspacing=\"0em 2em 0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em\"><mtr><mtd><msup><mn>9</mn><mn>2</mn></msup></mtd><mtd><mi></mi><mo>≡</mo><mn>81</mn><mo>≡</mo><mn>7</mn><mo>⋅</mo><mn>11</mn><mo>+</mo><mn>4</mn><mo>≡</mo><mn>4</mn></mtd><mtd></mtd><mtd><mi></mi><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>11</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><msup><mn>9</mn><mn>3</mn></msup></mtd><mtd><mi></mi><mo>≡</mo><mn>4</mn><mo>⋅</mo><mn>9</mn><mo>≡</mo><mn>36</mn><mo>≡</mo><mn>3</mn><mo>⋅</mo><mn>11</mn><mo>+</mo><mn>3</mn><mo>≡</mo><mn>3</mn></mtd><mtd></mtd><mtd><mi></mi><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>11</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><msup><mn>9</mn><mn>4</mn></msup></mtd><mtd><mi></mi><mo>≡</mo><mn>3</mn><mo>⋅</mo><mn>9</mn><mo>≡</mo><mn>27</mn><mo>≡</mo><mn>2</mn><mo>⋅</mo><mn>11</mn><mo>+</mo><mn>5</mn><mo>≡</mo><mn>5</mn></mtd><mtd></mtd><mtd><mi></mi><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>11</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><msup><mn>9</mn><mn>5</mn></msup></mtd><mtd><mi></mi><mo>≡</mo><mn>5</mn><mo>⋅</mo><mn>9</mn><mo>≡</mo><mn>45</mn><mo>≡</mo><mn>4</mn><mo>⋅</mo><mn>11</mn><mo>+</mo><mn>1</mn><mo>≡</mo><mn>1</mn></mtd><mtd></mtd><mtd><mi></mi><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>11</mn><mo stretchy=\"false\">)</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>So, <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"248\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c22C5\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c39\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2261\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6D\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>⋅</mo><mn>9</mn><mo>≡</mo><mn>1</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>11</mn><mo stretchy=\"false\">)</mo><mo>,</mo></math></mjx-assistive-mml></mjx-container> which means that <mjx-container cla