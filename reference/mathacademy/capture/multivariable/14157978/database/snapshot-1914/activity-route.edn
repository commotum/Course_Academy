#{[{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186482637} :activity/id #uuid "faea1c30-e59b-555e-986e-d9c6a2962d7e" :activity/scope {:db/id #edb/ref 17592186050687 :topic/id #uuid "5f0fbf1a-01fe-5c95-8b44-55eb40e24c08" :topic/math-academy-id 3708} :activity/steps [{:db/id #edb/ref 17592186482635 :step/content {:db/id #edb/ref 17592186259610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "126a7cd4-67ec-5bc6-9f63-b9d15c490f12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186256950} {:answer/id #uuid "2b62af94-63d3-5090-9678-72c681d50a7f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Impossible to determine" :db/id #edb/ref 17592186257169} {:answer/id #uuid "5e3a6519-cd2f-52db-a411-de74ed8ed855" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186257607} {:answer/id #uuid "d06a24d7-7dbc-5df1-a807-98282f9c0371" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-11" :db/id #edb/ref 17592186258592} {:answer/id #uuid "d1649fec-ac63-518f-a8e9-8c8b164b60dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186258607}] :answer-field/correct {:db/id #edb/ref 17592186256950} :answer-field/id #uuid "49627605-3fb4-5b44-9d52-a141068215f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259161}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "41e596da-5347-5fcf-affc-7dc004feff07" :question/math-academy-id "q-124181" :question/problem "If ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y=8$ and ${\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y=-3,$ calculate ${\\int }_{C}f(x,y)\\,\\text{d}y$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $y,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}y=-{\\int }_{C}f(x,y)\\,\\text{d}y$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y \\\\  & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y \\\\  & =-8-(-3) \\\\  & =-5.\\end{aligned}\n$$"} :step/id #uuid "664817ed-1c5d-56c6-9317-1db891f36e84" :step/next {:db/id #edb/ref 17592186482649}} {:db/id #edb/ref 17592186482637 :step/content {:db/id #edb/ref 17592186259609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6b1eff-f968-5af6-ab7e-497c5b252f54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186257032} {:answer/id #uuid "65fa06b4-0249-5df6-91c8-d1c80fb913d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186257681} {:answer/id #uuid "6f4f8d99-5f81-5776-b928-ceb7dbffd985" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186257760} {:answer/id #uuid "ef1a5375-4524-5e93-b903-4a134bf9563e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Impossible to determine" :db/id #edb/ref 17592186258856} {:answer/id #uuid "fc6782be-6222-5451-a953-3a91a661ea0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186258989}] :answer-field/correct {:db/id #edb/ref 17592186257760} :answer-field/id #uuid "2af5069a-1d91-5111-8f4b-2d7bfb92501a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259109}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f705291d-0bfe-5456-9170-c496d39786bb" :question/math-academy-id "q-124180" :question/problem "If ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x=-1$ and ${\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}x=4,$ calculate ${\\int }_{C}f(x,y)\\,\\text{d}x$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $x,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}x=-{\\int }_{C}f(x,y)\\,\\text{d}x$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}x={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x \\\\  & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}x \\\\  & =-(-1)-4 \\\\  & =-3.\\end{aligned}\n$$"} :step/id #uuid "6f10ce92-f069-526b-924f-aad5da92df4d" :step/next {:db/id #edb/ref 17592186482635}} {:db/id #edb/ref 17592186482649 :step/content {:db/id #edb/ref 17592186415680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f835e91-ee38-5342-a3cd-ebbb06574004" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186415643} {:answer/id #uuid "766165cf-8d6e-5c03-9b98-c79e31ebe685" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186415645} {:answer/id #uuid "9af8db32-4cb8-5c67-bcff-3fbc9c9e8d60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\sqrt{2}" :db/id #edb/ref 17592186415652} {:answer/id #uuid "a4d3a26a-ce31-5aa6-94a6-091609c41ba6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186415653} {:answer/id #uuid "e3f1e8c9-e884-5eab-b5ad-5240ff9dc466" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186415664}] :answer-field/correct {:db/id #edb/ref 17592186415645} :answer-field/id #uuid "47d1b44e-be04-5aae-bd0c-c0fa80e8a07b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415673}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a19a3e84-b3b7-545b-90bc-54d947e5986c" :question/math-academy-id "q-124300" :question/problem "![](images/71/71620d1e3e6691ef6c91382665fd258891984b1e32aeaec122663d65c1ca5b1b.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}x,$ where $C$ is the path along the line segment between the points $(-3,-1)$ to the point $(1,3),$ as shown above." :question/worked-solution "The line integral of unity with respect to $x$ along a path $C$ is equal to the net change in $x$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}x={x}_{2}-{x}_{1},\n$$\n\nwhere ${x}_{2}$ is the $x$-coordinate of the terminal point, and ${x}_{1}$ is the $x$-coordinate of the initial point.\n\nIn our case, ${x}_{2}=1$ and ${x}_{1}=-3.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}x={x}_{2}-{x}_{1}=1-(-3)=4.\n$$"} :step/id #uuid "c50e5f01-04d4-55ae-95c5-9580fdda17a4" :step/next {:db/id #edb/ref 17592186482655}} {:db/id #edb/ref 17592186482652 :step/content {:db/id #edb/ref 17592186259671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222f7372-478c-5a27-a063-8b07e8f92f6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186257061} {:answer/id #uuid "260fe7e6-dcde-5d6f-bd01-230ec63c06ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186257111} {:answer/id #uuid "457aa27e-2b18-5b49-aa06-db270cc7943d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\pi " :db/id #edb/ref 17592186257390} {:answer/id #uuid "81299222-742a-5d9d-a15d-9944b4e165e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186257930} {:answer/id #uuid "a82500ae-ffed-5208-83ef-1952b452cd21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186258250}] :answer-field/correct {:db/id #edb/ref 17592186257111} :answer-field/id #uuid "c408b8b1-0a44-526d-8f26-98e22333e00c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259374}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9f388a61-d9fb-5445-8bd4-8cd72f371aff" :question/math-academy-id "q-124335" :question/problem "![](images/96/963f8812eb8226617c7d893ebdf675747ebed12c92fc6369de2b153a1c2e3b58.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}y,$ where $C$ is the path along the semicircle of radius $2,$ transversed from the point $(1,-2)$ to the point $(1,2),$ as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, ${y}_{2}=2$ and ${y}_{1}=-2.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1}=2-(-2)=4.\n$$"} :step/id #uuid "d68c1073-788b-5de9-b32e-40a492159af1"} {:db/id #edb/ref 17592186482655 :step/content {:db/id #edb/ref 17592186259670 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2ec8d6-1a05-588c-997f-14cc9bfb0ab8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186256900} {:answer/id #uuid "2264d3f3-6ba4-5db9-9859-6e8df205672b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186257063} {:answer/id #uuid "c0061eac-4125-5f88-8e22-704bb968ada8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186258457} {:answer/id #uuid "ea54b8e9-c9db-5811-b209-6fceac58e8e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186258817} {:answer/id #uuid "efaf75dd-29d0-5bee-a63b-c74ce7854eaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{13}" :db/id #edb/ref 17592186258863}] :answer-field/correct {:db/id #edb/ref 17592186258457} :answer-field/id #uuid "59744985-2971-5b60-8561-10d1ce839641" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259183}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "19da757c-af27-523a-9d2f-9ce008944b1f" :question/math-academy-id "q-124334" :question/problem "![](images/9c/9c42d875a65a6b54ad7769180f5ec2e831772ad44a89ec913951da40c6d90514.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}y,$ where $C$ is the path along the line segment between the points $(-3,0)$ to the point $(0,2),$ as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, ${y}_{2}=2$ and ${y}_{1}=0.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1}=2-0=2.\n$$"} :step/id #uuid "e608e1df-6587-55b1-9e73-f808cc254e61" :step/next {:db/id #edb/ref 17592186482652}}] :activity/title "Properties of Line Integrals With Respect to X and Y" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481772}]}
