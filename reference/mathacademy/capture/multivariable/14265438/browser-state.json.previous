math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><menclose notation=\"updiagonalstrike\"><mn>2</mn></menclose><mo>⋅</mo><mn>4</mn><mi>a</mi><mo>≡</mo><menclose notation=\"updiagonalstrike\"><mn>2</mn></menclose><mo>⋅</mo><mn>4</mn><mi>b</mi><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><menclose notation=\"updiagonalstrike\"><mn>2</mn></menclose><mo>⋅</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mo stretchy=\"false\">⟺</mo><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mn>4</mn></mstyle></mpadded></mstyle><mi>a</mi><mo>≡</mo><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mn>4</mn></mstyle></mpadded></mstyle><mi>b</mi><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mn>3</mn></mstyle></mpadded></mstyle><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
