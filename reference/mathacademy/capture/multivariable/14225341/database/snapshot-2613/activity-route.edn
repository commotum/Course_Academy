#{[{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186543650} :activity/id #uuid "dcac007b-4160-5c57-b3fa-73790e770eac" :activity/scope {:db/id #edb/ref 17592186049881 :topic/id #uuid "1aba1eae-fe85-559f-b4fb-b8896b64623f" :topic/math-academy-id 2200} :activity/steps [{:db/id #edb/ref 17592186543596 :step/content {:db/id #edb/ref 17592186134077 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fac33087-90a9-5374-bb9b-89306309caf6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477109} {:answer/id #uuid "1cb234b8-e70d-5436-816b-c72569cefcc6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477110}] :answer-field/correct {:db/id #edb/ref 17592186477109} :answer-field/id #uuid "f5195686-7398-592f-a034-c46b06f34fab" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477524} {:answer-field/choices [{:answer/id #uuid "b51fbdcf-5bea-512d-8ea2-0767a22863a5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477111} {:answer/id #uuid "4e912cb8-5633-51bd-a892-7203a2451c74" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477112}] :answer-field/correct {:db/id #edb/ref 17592186477111} :answer-field/id #uuid "5c026345-d4f5-55cd-a8b5-b6a688019eae" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477525} {:answer-field/choices [{:answer/id #uuid "aa16ff18-2df7-5ce8-a4c4-8312d682551a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477113} {:answer/id #uuid "70d44836-3172-59de-bfac-3e6678ca53bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477114}] :answer-field/correct {:db/id #edb/ref 17592186477114} :answer-field/id #uuid "a69cc77a-87f4-5f19-9bae-02259b9be70b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477526}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1f81e62d-c183-546b-b986-59beb21560d1" :question/math-academy-id "q-109854" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Null}(XY)$ for all compatible matrices $X$ and $Y?$\n- **I.** $\\text{Null}({Y}^{T}\\,{X}^{T})$\n- **II.** $\\text{Col}(XY)$\n- **III.** $\\text{Col}({Y}^{T}\\,{X}^{T})$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{Null}(XY)$ contains all vectors that, when pre-multiplied by $XY,$ result in the zero-vector $0.$ \n\nWhen pre-multiplying a vector by $XY,$ we actually multiply each row of $XY$ by that vector. So, $\\text{Null}(XY)$ must be orthogonal to the row space of $XY,$ which is $\\text{Col}((XY)^{T})=\\text{Col}({Y}^{T}\\,{X}^{T}).$\n\nTherefore, the correct answer is \"III only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)"} :step/id #uuid "03787068-e65a-5894-ac0f-70677b84b503" :step/next {:db/id #edb/ref 17592186543659}} {:db/id #edb/ref 17592186543605 :step/content {:db/id #edb/ref 17592186362743 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed2e2bd4-fa9e-5c29-9fde-5b640f207da7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Null}(A)" :db/id #edb/ref 17592186362745} {:answer/id #uuid "b42b2193-b9c4-5e0c-aafb-563bb246ff36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}(A)" :db/id #edb/ref 17592186362746} {:answer/id #uuid "d28bf949-da52-5d09-b5ad-42160431f00c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186362747} {:answer/id #uuid "455a70da-1199-5679-aa6a-6757392650df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186362748} {:answer/id #uuid "8522f512-49e6-5a4c-b597-44a8def8386e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{R}^{n}" :db/id #edb/ref 17592186362749}] :answer-field/correct {:db/id #edb/ref 17592186362748} :answer-field/id #uuid "6b75f144-2c87-55fa-ae37-c2b10ecef350" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362744}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "462ca0a9-fbe9-5641-92d4-faed2ef0803e" :question/math-academy-id "q-109849" :question/problem "Let $A$ be a $m\\times n$ matrix. What is the image of $\\text{Null}(A)$ under the action of $A?$" :question/worked-solution "By definition of the null subspace, $\\text{Null}(A)$ is mapped to the zero vector $0$ under the action of $A.$"} :step/id #uuid "12ea7b05-1139-5991-9ab8-d66b18daabf2" :step/next {:db/id #edb/ref 17592186543616}} {:db/id #edb/ref 17592186543616 :step/content {:db/id #edb/ref 17592186362750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ed2ea04-17c5-525d-bb8b-a73bdb48fa90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Null}({B}^{T})" :db/id #edb/ref 17592186362752} {:answer/id #uuid "81d7a34a-2311-5d45-891e-5cd69b89006d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}(B)" :db/id #edb/ref 17592186362753} {:answer/id #uuid "1ed9ddc3-ffd8-53ba-802f-ad779bcf8c3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}({B}^{T})" :db/id #edb/ref 17592186362754} {:answer/id #uuid "7b88adee-5c88-5a21-99be-baee1cf260db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186362755} {:answer/id #uuid "7aed3ab2-0476-5b02-8570-9d68a6779e1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Null}(B)" :db/id #edb/ref 17592186362756}] :answer-field/correct {:db/id #edb/ref 17592186362753} :answer-field/id #uuid "4b3fad67-e441-547e-bcca-af1012111f8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362751}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "63c0c3aa-6cd0-5913-9f45-9198721d3066" :question/math-academy-id "q-109850" :question/problem "Let $B$ be a $m\\times n$ matrix. What is the image of $\\text{Col}({B}^{T})$ under the action of $B?$" :question/worked-solution "Pre-multiplying a vector $x\\in {R}^{n}$ by $B$ gives a linear combination of the columns of $B:$\n\n$$\n{{\\begin{bmatrix}| & | & ⋯ & | \\\\ {b}_{1} & {b}_{2} & ⋯ & {b}_{n} \\\\ | & | & ⋯ & |\\end{bmatrix}}_{⏟}}_{B}\\cdot {{\\begin{bmatrix}{x}_{1} \\\\ ⋮ \\\\ {x}_{n}\\end{bmatrix}}_{⏟}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ {b}_{1} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ {b}_{2} \\\\ |\\end{bmatrix}+⋯+{x}_{n}\\begin{bmatrix}| \\\\ {b}_{n} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{n}$ under the action of $B$ must be $\\text{Col}(B),$ the column space of $B.$\n\nFurthermore, since $\\text{Null}(B)$ is mapped to the zero vector $0$ by the definition of the null subspace, the image of its orthogonal complement $\\text{Col}({B}^{T})$ must be $\\text{Col}(B).$\n\nThis can be schematically visualized, as shown below.\n\n![](images/ad/ad1557fbd48206baf7239046ada69f60d8cd9ee4916b4f8e37741903ef7d1e9b.png)"} :step/id #uuid "32720668-2e01-58f0-9e8c-cb68020bcffd" :step/next {:db/id #edb/ref 17592186543596}} {:db/id #edb/ref 17592186543650 :step/content {:db/id #edb/ref 17592186134071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f20cbbab-e838-5cc3-9bc0-309fc77b0b95" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477097} {:answer/id #uuid "56ed48d0-e778-5305-b095-810cb0318a7c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477098}] :answer-field/correct {:db/id #edb/ref 17592186477097} :answer-field/id #uuid "ecbb62c7-2dda-5a03-840d-d5922c38c749" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477518} {:answer-field/choices [{:answer/id #uuid "080c9074-8477-5142-a998-302831331617" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477099} {:answer/id #uuid "2adbcb29-ae60-5a02-a7a4-ad81cc23bd1d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477100}] :answer-field/correct {:db/id #edb/ref 17592186477100} :answer-field/id #uuid "d6babc65-b40a-5bbb-a637-5cba3fe592bd" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477519} {:answer-field/choices [{:answer/id #uuid "9c831444-2313-518a-a561-b0194ffe8ba6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186477101} {:answer/id #uuid "ea4d407d-7ce7-52d8-af97-f359e9fd20bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186477102}] :answer-field/correct {:db/id #edb/ref 17592186477101} :answer-field/id #uuid "1800ad63-0f0b-509e-9e17-fed976eb45e8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186477520}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "304499af-cb5d-5e3b-8108-be3a9fa9519f" :question/math-academy-id "q-108907" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Null}(A)$ for every matrix $A?$\n- **I.** $\\text{Null}({A}^{T})$\n- **II.** $\\text{Col}({A}^{T})$\n- **III.** $\\text{Col}(A)$\n\nSelect all that apply." :question/worked-solution "Recall that $\\text{Null}(A)$ contains all vectors that, when pre-multiplied by $A,$ result in the zero-vector $0.$ \n\nWhen pre-multiplying a vector by $A,$ we actually multiply each row of $A$ by that vector. So, $\\text{Null}(A)$ must be orthogonal to the row space of $A,$ which is $\\text{Col}({A}^{T}).$\n\nTherefore, the correct answer is \"II only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)"} :step/id #uuid "a47247ac-314d-5bb2-ba6f-fdd8d1f684d7" :step/next {:db/id #edb/ref 17592186543605}} {:db/id #edb/ref 17592186543659 :step/content {:db/id #edb/ref 17592186362777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d02fe1b-cc17-5f82-9b2a-b4e46bf1f308" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186362779} {:answer/id #uuid "3ced5acd-cca0-55c2-ba8d-f6afaf38adc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186362780} {:answer/id #uuid "c56c69d3-7c0c-55ae-8047-91c125d12c2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186362781} {:answer/id #uuid "9abee5d9-9e49-55dd-8103-58f4e5cfba37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186362782} {:answer/id #uuid "785f4b33-ec9e-5e15-b22e-c297f48f6d38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186362783}] :answer-field/correct {:db/id #edb/ref 17592186362782} :answer-field/id #uuid "cfbba52c-655b-5de4-989a-7c3965af0883" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362778}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "debbebbb-8895-508b-8192-3a839f7cbe92" :question/math-academy-id "q-109870" :question/problem "Consider a $7\\times 9$ matrix $A.$ If $\\text{dim}(\\text{Null}(A))=3,$ then $\\text{dim}(\\text{Col}({A}^{T}))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=7,$ $n=9,$ and $n-r=3.$ \n\nSubstituting $n=9$ into $n-r=3,$ we can find the rank of $A:$\n\n$$\n(9)-r=3\\,⟹\\,r=6\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Col}({A}^{T})) & =r=6.\\end{aligned}\n$$"} :step/id #uuid "b86b6c6f-57d1-5201-a6cd-714b57d1a7ce"}] :activity/title "The Four Fundamental Subspaces of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186542628}]}
