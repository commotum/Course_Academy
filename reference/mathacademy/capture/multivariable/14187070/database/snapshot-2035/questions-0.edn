#{[{:db/id #edb/ref 17592186435314 :knowledge-point/_questions [{:db/id #edb/ref 17592186162107 :knowledge-point/id #uuid "6eac4a2e-cfa8-5476-919e-fd3c26d01d75" :knowledge-point/title "Finding the Standard Error"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36470539-f464-546f-ba73-6270b016995f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.62" :db/id #edb/ref 17592186435296} {:answer/id #uuid "39a9b6f2-d460-516e-a343-dad430e857a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.61" :db/id #edb/ref 17592186435297} {:answer/id #uuid "3ef092e1-14dd-5d66-a852-0395cd09a641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.14" :db/id #edb/ref 17592186435298} {:answer/id #uuid "5fffa88a-ab60-5e5a-ae9d-85cd50c46069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.03" :db/id #edb/ref 17592186435301} {:answer/id #uuid "f7609979-80a6-5ca8-82ec-72fc4cf0ed29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.16" :db/id #edb/ref 17592186435307}] :answer-field/correct {:answer/id #uuid "f7609979-80a6-5ca8-82ec-72fc4cf0ed29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.16" :db/id #edb/ref 17592186435307} :answer-field/id #uuid "f0bec69d-d68a-518d-bb91-2fd951e08467" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435312}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4ffdafd-ca0f-5aeb-9afa-3ab07c6f0225" :question/math-academy-id "q-143426" :question/problem "If ${X}_{1},{X}_{2},…,{X}_{1000}$ is a sample of size $n=1\\,000$ drawn from a population with mean $\\mu =150$ and variance ${\\sigma }^{2}=25,$ calculate the standard error of $\\overset{―}{X}.$ Round your answer to two decimal places." :question/worked-solution "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n},\n$$\n\nand the standard error is given by\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{\\text{Var}[\\overset{―}{X}]}=\\frac{\\sigma }{\\sqrt{n}}.\n$$\n\nSince the population variance is ${\\sigma }^{2}=25$ and the sample size is $n=1\\,000,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{25}{1\\,000} \\\\  & =0.025.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\text{SE}[\\overset{―}{X}]=\\sqrt{0.025}≈0.16.\n$$"}] [{:db/id #edb/ref 17592186162390 :knowledge-point/_questions [{:db/id #edb/ref 17592186162114 :knowledge-point/id #uuid "eb3b4b6a-3a24-5079-bf33-ed1c5576ffa7" :knowledge-point/title "Finding a Conditional PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9baef0ad-50bb-5117-a90e-f69d88309a80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2 - 2x}" :db/id #edb/ref 17592186159543} {:answer/id #uuid "d4122ef2-c8bb-54cb-a45c-43301f97bf95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1 + x}" :db/id #edb/ref 17592186159544} {:answer/id #uuid "13b37f47-75d5-5673-b367-365373382764" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1 - x}" :db/id #edb/ref 17592186159545} {:answer/id #uuid "4b405321-a053-5f3f-aa87-24ec0e736170" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{2}" :db/id #edb/ref 17592186159546} {:answer/id #uuid "55e6a4c2-f4a8-5437-aab3-0e4104de907f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x^{2}" :db/id #edb/ref 17592186159547}] :answer-field/id #uuid "968220d8-4854-5451-a29d-7b23b30726b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159542}] :question/id #uuid "3d20c523-ad94-5c8f-adf5-6fe709391a09" :question/math-academy-id "q-143459" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$f(x, y) = {1,\\begin{vmatrix}0 < x < 1, x - 1 < y < 1 - x \\\\ 0,\\end{vmatrix}otherwise$\n\nFind the expression of the conditional probability density function $f_{Y\\mid X}(y \\mid x)$ for $0 < x < 1, x - 1 < y < 1 - x$."}] [{:db/id #edb/ref 17592186284606 :knowledge-point/_questions [{:db/id #edb/ref 17592186129305 :knowledge-point/id #uuid "16d1e71b-6eda-5c91-81a0-15a1aa979932" :knowledge-point/title "Finding the General Solution Given the Eigenvalues and Eigenvectors of the Corresponding Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27693351-84ba-5cf8-944f-20cf97e35295" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=-3[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{{c}_{1}t}+3[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{{c}_{2}t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186282028} {:answer/id #uuid "55c460b4-b90c-5153-8760-e9dcd6e57a5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=c[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{3t},\\,c\\in R" :db/id #edb/ref 17592186282417} {:answer/id #uuid "87502e7f-7f1b-5cd5-8388-3373709410f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{-3t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{3t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186282856} {:answer/id #uuid "b2930186-51d4-5ada-b0f3-1488d79396f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{3t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{-3t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186283237} {:answer/id #uuid "de395909-c010-5007-ac35-db1d40fcbed6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=c[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{-3t},\\,c\\in R" :db/id #edb/ref 17592186283629}] :answer-field/correct {:answer/id #uuid "87502e7f-7f1b-5cd5-8388-3373709410f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{-3t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{3t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186282856} :answer-field/id #uuid "af38cfdc-f9e4-5281-957c-90a87b6ede28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284237}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "88fe7310-fc98-5239-8ffe-c165e6875721" :question/math-academy-id "q-168497" :question/problem "Let ${v}_{1}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$ and ${v}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ be eigenvectors of a matrix $A$ that correspond to eigenvalues ${\\lambda }_{1}=-3$ and ${\\lambda }_{2}=3,$ respectively.\nWhat is the general solution of the matrix differential equation ${x}^{′}(t)=Ax(t)?$" :question/worked-solution "Given a system of first-order linear ODEs in the form\n\n$$\n{x}^{′}(t)=Ax(t),\n$$\n\nwhere $A$ has two distinct eigenvalues ${\\lambda }_{1},{\\lambda }_{2}$ with corresponding eigenvectors ${v}_{1}$ and ${v}_{2},$ the formula for the general solution is\n\n$$\nx(t)={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nTherefore, the general solution of our matrix differential equation is\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{-3t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{3t},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345286 :knowledge-point/_questions [{:db/id #edb/ref 17592186179669 :knowledge-point/id #uuid "e5ce5418-6b75-5efa-b7f9-99ee16c510be" :knowledge-point/title "Calculating the Line Integral of a Vector-Valued Function Along a Union of Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ccbd978-8163-5c7e-baae-b8ad95985a86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186342350} {:answer/id #uuid "453e49ec-25af-50ef-847c-f9e8f100fa90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186342807} {:answer/id #uuid "78d2918a-06f4-5e2f-8f95-8ce2e0a1d53e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186343281} {:answer/id #uuid "7c924cb2-9540-5923-aef1-54902d61b6c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186343312} {:answer/id #uuid "a953ff99-deba-55f2-9b54-5b5b5650e514" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186343729}] :answer-field/correct {:answer/id #uuid "0ccbd978-8163-5c7e-baae-b8ad95985a86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186342350} :answer-field/id #uuid "10c5cc9a-ab7f-5bd2-8f67-b0bc3b91ae44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344525}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8fc56ee5-fc5d-5429-bfdb-4254f7ee30fb" :question/math-academy-id "q-77191" :question/problem "![](images/04/0457cb819e6f39ef9c0978e356cff788e1cf5edbef9cbf844a054ab777b70eac.png)\n\nThe path ${C}_{1}$ consists of a the line segment from the point $A(-2,0)$ to the point $B(0,1),$ and the path ${C}_{2}$ consists of the line segment from the point $B(0,1)$ to the point $D(1,1).$\n\nGiven that ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=-\\frac{3}{2},$ evaluate ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=(x-2y)\\,i+(y-x)\\,j,$ and $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "We will use the fact that\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r.\n$$\n\nWe're given the value of the second integral, so we only need to work out the first.\n\nThe path ${C}_{1}$ is the line segment from $A$ to $B.$  It can be parametrized as\n\n$$\n\\begin{aligned}{r}_{1}(t) & =a+t(b-a) \\\\  & =⟨-2,0⟩+t(⟨0,1⟩-⟨-2,0⟩) \\\\  & =⟨-2+2t,t⟩ \\\\  & =(-2+2t)i+t\\,j,\\end{aligned}\n$$\n\nwhere $0<t<1.$ Along this segment, we have $x=-2+2t$ and $y=t.$ Therefore, \n\n$$\n\\begin{aligned}F({r}_{1}(t)) & =(x-2y)\\,i+(y-x)\\,j \\\\  & =((-2+2t)-2t)\\,i+(t-(-2+2t))\\,j \\\\  & =-2\\,i+(2-t)\\,j.\\end{aligned}\n$$\n\nComputing the derivative, we get the following:\n\n$$\n\\begin{aligned}{r}_{1}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(-2+2t)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =2\\,i+j\\end{aligned}\n$$\n\nWe can now compute the dot product:\n\n$$\n\\begin{aligned}F({r}_{1}(t))\\cdot {r}_{1}^{′}(t) & =(-2\\,i+(2-t)\\,j)\\cdot (2\\,i+j) \\\\  & =-2-t\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r \\\\  & ={\\int }_{0}^{1}F({r}_{1}(t))\\cdot {r}_{1}^{′}(t)\\,\\text{d}t+(-\\frac{3}{2}) \\\\  & ={\\int }_{0}^{1}(-2-t)\\,\\text{d}t-\\frac{3}{2} \\\\  & ={[-2t-\\frac{{t}^{2}}{2}]}_{0}^{1}-\\frac{3}{2} \\\\  & =[-2(1)-\\frac{{1}^{2}}{2}-0]-\\frac{3}{2} \\\\  & =-\\frac{5}{2}-\\frac{3}{2} \\\\  & =-4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186172650 :knowledge-point/_questions [{:db/id #edb/ref 17592186172044 :knowledge-point/id #uuid "eb1745c5-6485-5a9d-9e8f-19492928e4b4" :knowledge-point/title "Finding the Position Function of an Object Moving With Circular Motion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad2bf663-7148-56f3-8ad9-aaaf9a2e4151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t) = 5(\\sin 2ti + \\cos 2tj)" :db/id #edb/ref 17592186171526} {:answer/id #uuid "c519753a-04d4-5b62-b7bc-b7d39b0f2148" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t) = 5(\\cos 2ti - \\sin 2tj)" :db/id #edb/ref 17592186171527} {:answer/id #uuid "290b593d-18be-5f40-b516-0c9e242666b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t) = 2(\\cos 5ti + \\sin 5tj)" :db/id #edb/ref 17592186171528} {:answer/id #uuid "35cf975f-89f3-5f9c-b65d-53314124acb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t) = 2(\\cos 5ti - \\sin 5tj)" :db/id #edb/ref 17592186171529} {:answer/id #uuid "6055dd77-7e66-5ace-bef4-a3173ccebb6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t) = 5(\\cos 2ti + \\sin 2tj)" :db/id #edb/ref 17592186171530}] :answer-field/id #uuid "0a88d5f4-d750-5f16-a3bb-b2420ae3e78d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171525}] :question/id #uuid "9927cf9d-99cc-5df6-888f-210e0aad32bd" :question/math-academy-id "q-97540" :question/problem "A particle moves along a circular path centered at $O$ in the $xy$-plane in the counterclockwise direction with a constant angular velocity of $2rad/s$. Given that the object is at the position $(5, 0)$ when $t = 0$, find the position function of the particle."}]}
