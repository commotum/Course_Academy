b/ref 17592186283629 #edb/ref 17592186045417] [17592186284237 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186284237 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186284237 #edb/ref 1078 #edb/ref 17592186282856 #edb/ref 17592186045417] [17592186284237 #edb/ref 1079 #uuid "af38cfdc-f9e4-5281-957c-90a87b6ede28" #edb/ref 17592186045417] [17592186284606 #edb/ref 1068 #edb/ref 17592186284237 #edb/ref 17592186045417] [17592186284606 #edb/ref 1069 "q-168497" #edb/ref 17592186045417] [17592186284606 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186284606 #edb/ref 1071 "Let ${v}_{1}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$ and ${v}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ be eigenvectors of a matrix $A$ that correspond to eigenvalues ${\\lambda }_{1}=-3$ and ${\\lambda }_{2}=3,$ respectively.\nWhat is the general solution of the matrix differential equation ${x}^{′}(t)=Ax(t)?$" #edb/ref 17592186045417] [17592186284606 #edb/ref 1072 #uuid "88fe7310-fc98-5239-8ffe-c165e6875721" #edb/ref 17592186045417] [17592186284606 #edb/ref 1074 "Given a system of first-order linear ODEs in the form\n\n$$\n{x}^{′}(t)=Ax(t),\n$$\n\nwhere $A$ has two distinct eigenvalues ${\\lambda }_{1},{\\lambda }_{2}$ with corresponding eigenvectors ${v}_{1}$ and ${v}_{2},$ the formula for the general solution is\n\n$$\nx(t)={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nTherefore, the general solution of our matrix differential equation is\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{-3t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{3t},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186342350 #edb/ref 1080 "-4" #edb/ref 17592186045417] [17592186342350 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186342350 #edb/ref 1083 #uuid "0ccbd978-8163-5c7e-baae-b8ad95985a86" #edb/ref 17592186045417] [17592186342807 #edb/ref 1080 "5" #edb/ref 17592186045417] [17592186342807 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186342807 #edb/ref 1083 #uuid "453e49ec-25af-50ef-847c-f9e8f100fa90" #edb/ref 17592186045417] [17592186343281 #edb/ref 1080 "-\\frac{3}{2}" #edb/ref 17592186045417] [17592186343281 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186343281 #edb/ref 1083 #uuid "78d2918a-06f4-5e2f-8f95-8ce2e0a1d53e" #edb/ref 17592186045417] [17592186343312 #edb/ref 1080 "\\frac{3}{2}" #edb/ref 17592186045417] [17592186343312 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186343312 #edb/ref 1083 #uuid "7c924cb2-9540-5923-aef1-54902d61b6c5" #edb/ref 17592186045417] [17592186343729 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186343729 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186343729 #edb/ref 1083 #uuid "a953ff99-deba-55f2-9b54-5b5b5650e514" #edb/ref 17592186045417] [17592186344525 #edb/ref 1075 #edb/ref 17592186342350 #edb/ref 17592186045417] [17592186344525 #edb/ref 1075 #edb/ref 17592186342807 #edb/ref 17592186045417] [17592186344525 #edb/ref 1075 #edb/ref 17592186343281 #edb/ref 17592186045417] [17592186344525 #edb/ref 1075 #edb/ref 17592186343312 #edb/ref 17592186045417] [17592186344525 #edb/ref 1075 #edb/ref 17592186343729 #edb/ref 17592186045417] [17592186344525 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186344525 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186344525 #edb/ref 1078 #edb/ref 17592186342350 #edb/ref 17592186045417] [17592186344525 #edb/ref 1079 #uuid "10c5cc9a-ab7f-5bd2-8f67-b0bc3b91ae44" #edb/ref 17592186045417] [17592186345286 #edb/ref 1068 #edb/ref 17592186344525 #edb/ref 17592186045417] [17592186345286 #edb/ref 1069 "q-77191" #edb/ref 17592186045417] [17592186345286 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186345286 #edb/ref 1071 "![](images/04/0457cb819e6f39ef9c0978e356cff788e1cf5edbef9cbf844a054ab777b70eac.png)\n\nThe path ${C}_{1}$ consists of a the line segment from the point $A(-2,0)$ to the point $B(0,1),$ and the path ${C}_{2}$ consists of the line segment from the point $B(0,1)$ to the point $D(1,1).$\n\nGiven that ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=-\\frac{3}{2},$ evaluate ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=(x-2y)\\,i+(y-x)\\,j,$ and $C={C}_{1}\\cup {C}_{2}.$" #edb/ref 17592186045417] [17592186345286 #edb/ref 1072 #uuid "8fc56ee5-fc5d-5429-bfdb-4254f7ee30fb" #edb/ref 17592186045417] [17592186345286 #edb/ref 1074 "We will use the fact that\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r.\n$$\n\nWe're given the value of the second integral, so we only need to work out the first.\n\nThe path ${C}_{1}$ is the line segment from $A$ to $B.$  It can be parametrized as\n\n$$\n\\begin{aligned}{r}_{1}(t) & =a+t(b-a) \\\\  & =⟨-2,0⟩+t(⟨0,1⟩-⟨-2,0⟩) \\\\  & =⟨-2+2t,t⟩ \\\\  & =(-2+2t)i+t\\,j,\\end{aligned}\n$$\n\nwhere $0<t<1.$ Along this segment, we have $x=-2+2t$ and $y=t.$ Therefore, \n\n$$\n\\begin{aligned}F({r}_{1}(t)) & =(x-2y)\\,i+(y-x)\\,j \\\\  & =((-2+2t)-2t)\\,i+(t-(-2+2t))\\,j \\\\  & =-2\\,i+(2-t)\\,j.\\end{aligned}\n$$\n\nComputing the derivative, we get the following:\n\n$$\n\\begin{aligned}{r}_{1}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(-2+2t)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =2\\,i+j\\end{aligned}\n$$\n\nWe can now compute the dot product:\n\n$$\n\\begin{aligned}F({r}_{1}(t))\\cdot {r}_{1}^{′}(t) & =(-2\\,i+(2-t)\\,j)\\cdot (2\\,i+j) \\\\  & =-2-t\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r \\\\  & ={\\int }_{0}^{1}F({r}_{1}(t))\\cdot {r}_{1}^{′}(t)\\,\\text{d}t+(-\\frac{3}{2}) \\\\  & ={\\int }_{0}^{1}(-2-t)\\,\\text{d}t-\\frac{3}{2} \\\\  & ={[-2t-\\frac{{t}^{2}}{2}]}_{0}^{1}-\\frac{3}{2} \\\\  & =[-2(1)-\\frac{{1}^{2}}{2}-0]-\\frac{3}{2} \\\\  & =-\\frac{5}{2}-\\frac{3}{2} \\\\  & =-4\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360840 #edb/ref 1080 "r(t)=8(\\operatorname{cos}⁡4t\\,i-\\operatorname{sin}⁡4t\\,j)" #edb/ref 17592186045417] [17592186360840 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186360840 #edb/ref 1083 #uuid "029a7f99-f667-5979-a59f-0e86cfa31195" #edb/ref 17592186045417] [17592186360952 #edb/ref 1080 "r(t)=4(\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j)" #edb/ref 17592186045417] [17592186360952 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186360952 #edb/ref 1083 #uuid "1cd02180-7f22-5f61-93c7-fff08cd0fa7f" #edb/ref 17592186045417] [17592186361105 #edb/ref 1080 "r(t)=\\operatorname{cos}⁡4t\\,i+\\operatorname{sin}⁡4t\\,j" #edb/ref 17592186045417] [17592186361105 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186361105 #edb/ref 1083 #uuid "3ad8a471-2d04-5600-9388-bfbdf3391f3c" #edb/ref 17592186045417] [17592186361209 #edb/ref 1080 "r(t)=4(\\operatorname{cos}⁡8t\\,i-\\operatorname{sin}⁡8t\\,j)" #edb/ref 17592186045417] [17592186361209 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186361209 #edb/ref 1083 #uuid "5407564b-be54-5b7e-b365-08c7dd2979bc" #edb/ref 17592186045417]}
