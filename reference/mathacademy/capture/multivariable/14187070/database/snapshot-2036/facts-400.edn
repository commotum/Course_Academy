5417] [17592186501042 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186501042 #edb/ref 1078 #edb/ref 17592186500671 #edb/ref 17592186045417] [17592186501042 #edb/ref 1079 #uuid "3fefe9c8-5fc6-5bbb-bfe2-94890c45b24c" #edb/ref 17592186045417] [17592186501045 #edb/ref 1075 #edb/ref 17592186500486 #edb/ref 17592186045417] [17592186501045 #edb/ref 1075 #edb/ref 17592186500694 #edb/ref 17592186045417] [17592186501045 #edb/ref 1075 #edb/ref 17592186500724 #edb/ref 17592186045417] [17592186501045 #edb/ref 1075 #edb/ref 17592186500779 #edb/ref 17592186045417] [17592186501045 #edb/ref 1075 #edb/ref 17592186500796 #edb/ref 17592186045417] [17592186501045 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186501045 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186501045 #edb/ref 1078 #edb/ref 17592186500796 #edb/ref 17592186045417] [17592186501045 #edb/ref 1079 #uuid "4264e826-1eca-5166-bc99-fe720168444a" #edb/ref 17592186045417] [17592186501119 #edb/ref 1075 #edb/ref 17592186500530 #edb/ref 17592186045417] [17592186501119 #edb/ref 1075 #edb/ref 17592186500587 #edb/ref 17592186045417] [17592186501119 #edb/ref 1075 #edb/ref 17592186500716 #edb/ref 17592186045417] [17592186501119 #edb/ref 1075 #edb/ref 17592186500732 #edb/ref 17592186045417] [17592186501119 #edb/ref 1075 #edb/ref 17592186500759 #edb/ref 17592186045417] [17592186501119 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186501119 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186501119 #edb/ref 1078 #edb/ref 17592186500587 #edb/ref 17592186045417] [17592186501119 #edb/ref 1079 #uuid "dfbf2f05-cb8e-50e3-add0-d21c0e98ca91" #edb/ref 17592186045417] [17592186501152 #edb/ref 1068 #edb/ref 17592186501042 #edb/ref 17592186045417] [17592186501152 #edb/ref 1069 "q-161385" #edb/ref 17592186045417] [17592186501152 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186501152 #edb/ref 1071 "Consider the vector field $F$ and the surface $S$ with parametrization $r(u,v),$ where\n\n$$\nF(x,y,z)=⟨-2x,\\,-2y,\\,-z⟩,\\,r(u,v)=⟨{u}^{3},\\,{v}^{3},\\,uv⟩,\\,(u,v)\\in D⊂{R}^{2}.\n$$\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}\\boxed{}\\,\\text{d}A\n$$\n\nwhat is the missing expression?\n\n*Hint: You can use the fact that ${r}_{u}^{′}\\times {r}_{v}^{′}=⟨-3{v}^{3},\\,-3{u}^{3},\\,9{u}^{2}{v}^{2}⟩.$*" #edb/ref 17592186045417] [17592186501152 #edb/ref 1072 #uuid "2343ccc6-302e-57d1-903e-91d537e6ff5c" #edb/ref 17592186045417] [17592186501152 #edb/ref 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nNotice we are told that the fundamental vector product for our surface is\n\n$$\n{r}_{u}^{′}\\times {r}_{v}^{′}=⟨-3{v}^{3},\\,-3{u}^{3},\\,9{u}^{2}{v}^{2}⟩.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨-2x,\\,-2y,\\,-z⟩{|}_{x={u}^{3}\\,y={v}^{3}\\,z=uv} \\\\  & =⟨-2{u}^{3},\\,-2{v}^{3},\\,-uv⟩\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨-2{u}^{3},\\,-2{v}^{3},\\,-uv⟩\\cdot ⟨-3{v}^{3},\\,-3{u}^{3},\\,9{u}^{2}{v}^{2}⟩ \\\\  & =(-2{u}^{3})\\cdot (-3{v}^{3})+(-2{v}^{3})\\cdot (-3{u}^{3})+(-uv)\\cdot 9{u}^{2}{v}^{2} \\\\  & =6{u}^{3}{v}^{3}+6{u}^{3}{v}^{3}-9{u}^{3}{v}^{3} \\\\  & =3{u}^{3}{v}^{3}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}\\,3{u}^{3}{v}^{3}\\,\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186501161 #edb/ref 1068 #edb/ref 17592186501119 #edb/ref 17592186045417] [17592186501161 #edb/ref 1069 "q-163038" #edb/ref 17592186045417] [17592186501161 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186501161 #edb/ref 1071 "A thin rod with mass density function $\\lambda (x)=5\\sqrt{x},$ measured in $\\text{kg/m},$ is placed along the $x$-axis over the interval $0\\le x\\le 1,$ where $x$ is measured in meters. Find the moment of the rod about the origin." #edb/ref 17592186045417] [17592186501161 #edb/ref 1072 #uuid "41337cdf-5450-5e5f-ba7a-c0f13d6a2b84" #edb/ref 17592186045417] [17592186501161 #edb/ref 1074 "The moment about the origin $O$ of a rod with mass density function $\\lambda (x)$ for $a\\le x\\le b$ is given by \n\n$$\n{M}_{O}={\\int }_{a}^{b}x\\,\\lambda (x)\\,\\text{d}x.\n$$\n\nIn our case, we have\n\n$$\n\\lambda (x)=5\\sqrt{x},\\,a=0,\\,b=1.\n$$\n\nWe calculate the moment of the rod about the origin as follows:\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{0}^{1}x\\cdot 5\\sqrt{x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}5{x}^{3/2}\\,\\text{d}x \\\\  & ={[2{x}^{5/2}]}_{0}^{1} \\\\  & =2\\cdot {1}^{5/2}-0 \\\\  & =2\\end{aligned}\n$$\n\n \n\nTherefore, the required moment is $2\\,\\text{kg}\\cdot \\text{m}.$" #edb/ref 17592186045417] [17592186501169 #edb/ref 1068 #edb/ref 17592186501022 #edb/ref 17592186045417] [17592186501169 #edb/ref 1069 "q-125649" #edb/ref 17592186045417] [17592186501169 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186501169 #edb/ref 1071 "![](images/0f/0f178c33254644c5e2e7bf6f3c596df87b1ea2f0b5bfd417c3f279f6c62b1b0d.png)\n\nConsider the circle $S$ and the vector field $F,$ shown above. Let $C$ be any path where $S$ is traversed once in the **clockwise** direction. Which of the following statements are true?\n\nI. ${∮}_{C}F\\cdot \\text{d}r>0$\n\nII. ${∮}_{C}F\\cdot \\text{d}r<0$\n\nIII. ${∮}_{-C}F\\cdot \\text{d}r>0$" #edb/ref 17592186045417] [17592186501169 #edb/ref 1072 #uuid "5f7aceb3-5a6a-584b-8488-47f8fb82e9a0" #edb/ref 17592186045417] [17592186501169 #edb/ref 1074 "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nWe now recall the following:\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${∮}_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${∮}_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is false, while statement II is true. It's clear from the picture below that $F$ works against the motion of the particle as it moves clockwise along $C.$ \n\n![](images/f8/f87d2e735ad58e0b33a813fb91ab202ac0eeaf90575979ea45f954fb7e1d0493.png)\n\nSo, $Γ={∮}_{C}F\\cdot \\text{d}r<0.$\n\n- Statement III is true. It's clear from the picture below that $F$ assists the motion of the particle as it moves counterclockwise along $C.$\n\n![](images/10/102c11f9002e29a3759679c6ff0bd10188908d33eb9cc94a84d900956adc33a5.png)\n\nSo, $Γ={∮}_{-C}F\\cdot \\text{d}r>0.$\n\nTherefore, the correct answer is \"II and III only.\"" #edb/ref 17592186045417] [17592186501246 #edb/ref 1058 #edb/ref 17592186501250 #edb/ref 17592186045417] [17592186501246 #edb/ref 1062 #uuid "090207a1-0f91-53d1-8fe1-4304800c070f" #edb/ref 17592186045417] [17592186501246 #edb/ref 1063 #edb/ref 17592186501152 #edb/ref 17592186045417] [17592186501250 #edb/ref 1058 #edb/ref 17592186501298 #edb/ref 17592186045417] [17592186501250 #edb/ref 1062 #uuid "14bd49e2-0f2a-55aa-9f80-fc0c082b00f9" #edb/ref 17592186045417] [17592186501250 #edb/ref 1063 #edb/ref 17592186501161 #edb/ref 17592186045417] [17592186501253 #edb/ref 1058 #edb/ref 17592186501280 #edb/ref 17592186045417] [17592186501253 #edb/ref 1062 #uuid "19714afd-c950-5f0f-82b1-f0480bbf9695" #edb/ref 17592186045417] [17592186501253 #edb/ref 1063 #edb/ref 17592186501169 #edb/ref 17592186045417] [17592186501261 #edb/ref 1058 #edb/ref 17592186501282 #edb/ref 17592186045417] [17592186501261 #edb/ref 1062 #uuid "368577ca-f476-5cfa-9e6b-273c753b6b1a" #edb/ref 17592186045417] [17592186501261 #edb/ref 1063 #edb/ref 17592186172655 #edb/ref 17592186045417] [17592186501264 #edb/ref 1062 #uuid "3d0cfa91-e160-5e4c-a32c-0f3efbcd2cb2" #edb/ref 17592186045417] [17592186501264 #edb/ref 1063 #edb/ref 17592186172650 #edb/ref 17592186045417] [17592186501270 #edb/ref 1062 #uuid "5c6597e4-8215-5ac5-9944-f088aeed0bde" #edb/ref 17592186045417] [17592186501270 #edb/ref 1063 #edb/ref 17592186501234 #edb/ref 17592186045417] [17592186501272 #edb/ref 1058 #edb/ref 17592186501270 #edb/ref 17592186045417] [17592186501272 #edb/ref 1062 #uuid "7068fb21-64e6-51f4-b3a5-0162c383a600" #edb/ref 17592186045417] [17592186501272 #edb/ref 1063 #edb/ref 17592186501167 #edb/ref 17592186045417] [17592186501280 #edb/ref 1058 #edb/ref 17592186501300 #edb/ref 17592186045417] [17592186501280 #edb/ref 1062 #uuid "aea0e3bb-7784-502f-869c-fd6ee6199fc5" #edb/ref 17592186045417] [17592186501280 #edb/ref 1063 #edb/ref 17592186284606 #edb/ref 17592186045417] [17592186501282 #edb/ref 1058 #edb/ref 17592186501289 #edb/ref 17592186045417] [17592186501282 #edb/ref 1062 #uuid "b298bba9-5caf-53be-a1b8-5e5bfe3389e9" #edb/ref 17592186045417] [17592186501282 #edb/ref 1063 #edb/ref 17592186362221 #edb/ref 17592186045417] [17592186501289 #edb/ref 1058 #edb/ref 17592186501272 #edb/ref 17592186045417] [17592186501289 #edb/ref 1062 #uuid "c62d5c7d-4f34-5f60-92b7-d492ba362088" #edb/ref 17592186045417] [17592186501289 #edb/ref 1063 #edb/ref 17592186362222 #edb/ref 17592186045417] [17592186501296 #edb/ref 1058 #edb/ref 17592186501264 #edb/ref 17592186045417] [17592186501296 #edb/ref 1062 #uuid "f3a0ef83-6260-5054-a183-990e0500bff0" #edb/ref 17592186045417] [17592186501296 #edb/ref 1063 #edb/ref 17592186435314 #edb/ref 1759218604