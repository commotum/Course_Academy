#{[{:db/id #edb/ref 17592186510389 :knowledge-point/_questions [{:db/id #edb/ref 17592186198354 :knowledge-point/id #uuid "58427e6a-8e77-5c01-a578-a7dc4b8f8812" :knowledge-point/title "Finding the Projection of the Intersection of a Surface and a Tilted Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01030459-2127-5845-a022-909ed458b20a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-4{y}^{2}=-2" :db/id #edb/ref 17592186509696} {:answer/id #uuid "077958e9-019b-52b4-a194-2e3d1e6e8a31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-4{y}^{2}=2" :db/id #edb/ref 17592186509708} {:answer/id #uuid "143f96a1-49b9-5c94-8498-9b59fb558656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-2{y}^{2}=1" :db/id #edb/ref 17592186509723} {:answer/id #uuid "203cf6b6-970b-533e-8eff-91d74ba85161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-2{y}^{2}=-2" :db/id #edb/ref 17592186509751} {:answer/id #uuid "fb60e82e-e2d6-5601-ad2a-ed678e54b305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2{y}^{2}=-1" :db/id #edb/ref 17592186510228}] :answer-field/correct {:answer/id #uuid "01030459-2127-5845-a022-909ed458b20a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-4{y}^{2}=-2" :db/id #edb/ref 17592186509696} :answer-field/id #uuid "d9278757-a57e-52ac-9515-43ca861ad9fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510347}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4aa33ace-7f3a-5239-9095-80fa2dcc03c8" :question/math-academy-id "q-35493" :question/problem "Find the projection of the intersection between the hyperboloid of two sheets \n$\\frac{{x}^{2}}{2}+{y}^{2}-\\frac{(z+2)^{2}}{3}=-1$\nand the plane $3y+z=-2$  onto the\n$xy$-plane." :question/worked-solution "Since we want to find the projection onto the $xy$-plane, we need to eliminate the variable $z.$ First, we solve the equation of the plane for $z$, as follows:\n\n$$\n3y+z=-2\\,⟹\\,z=-2-3y\n$$\n\nSubstituting the expression for $z$ into the equation of the hyperboloid, we obtain: \n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2}+{y}^{2}-\\frac{((-2-3y)+2)^{2}}{3} & =-1 \\\\ \\frac{{x}^{2}}{2}+{y}^{2}-\\frac{9{y}^{2}}{3} & =-1 \\\\ \\frac{{x}^{2}}{2}-2{y}^{2} & =-1 \\\\ {x}^{2}-4{y}^{2} & =-2\\end{aligned}\n$$\n\nTherefore, the projection of the intersection is the hyperbola ${x}^{2}-4{y}^{2}=-2.$"}] [{:db/id #edb/ref 17592186496282 :knowledge-point/_questions [{:db/id #edb/ref 17592186198354 :knowledge-point/id #uuid "58427e6a-8e77-5c01-a578-a7dc4b8f8812" :knowledge-point/title "Finding the Projection of the Intersection of a Surface and a Tilted Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2903bd31-59f2-5edf-ba78-0b700636216f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{4}-\\frac{(x+3)^{2}}{2}=1" :db/id #edb/ref 17592186495599} {:answer/id #uuid "72fcd5f6-74c1-548c-b798-b9f86c8b5a52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{4}-\\frac{(x+3)^{2}}{4}=1" :db/id #edb/ref 17592186495763} {:answer/id #uuid "d9e331d6-2b84-5961-a705-7c0440233497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{4}+\\frac{(x+3)^{2}}{2}=1" :db/id #edb/ref 17592186495990} {:answer/id #uuid "e4145407-31af-5f0e-be8b-a08fc7a69e9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{4}+\\frac{(x+3)^{2}}{4}=1" :db/id #edb/ref 17592186496016} {:answer/id #uuid "e87b73a0-162f-5a86-8eb0-04ffa6648475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{4}-\\frac{(x+3)^{2}}{8}=1" :db/id #edb/ref 17592186496023}] :answer-field/correct {:answer/id #uuid "d9e331d6-2b84-5961-a705-7c0440233497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{4}+\\frac{(x+3)^{2}}{2}=1" :db/id #edb/ref 17592186495990} :answer-field/id #uuid "ac07d115-2c5e-5c77-b205-49ff29ccdb65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496158}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c16a549-c615-5f5a-9201-b01b9bbc4908" :question/math-academy-id "q-36325" :question/problem "Find the projection of the intersection between the hyperboloid of one sheet \n$(x+3)^{2}+\\frac{{y}^{2}}{4}-2{z}^{2}=1$\n and the plane   $x+2z=-3$ onto the\n$xy$-plane." :question/worked-solution "Since we want to find the projection onto the $xy$-plane, we need to eliminate the variable $z.$ First, we solve the equation of the plane for $z$, as follows:\n\n$$\nx+2z=-3\\,⟹\\,z=-\\frac{x+3}{2}\n$$\n\nSubstituting the expression for $z$ into the equation of the hyperboloid, we obtain: \n\n$$\n\\begin{aligned}(x+3)^{2}+\\frac{{y}^{2}}{4}-2{(-\\frac{x+3}{2})}^{2} & =1 \\\\ (x+3)^{2}+\\frac{{y}^{2}}{4}-\\frac{(x+3)^{2}}{2} & =1 \\\\ \\frac{{y}^{2}}{4}+\\frac{(x+3)^{2}}{2} & =1.\\end{aligned}\n$$\n\nTherefore, the projection of the intersection is the ellipse $\\frac{{y}^{2}}{4}+\\frac{(x+3)^{2}}{2}=1.$"}] [{:db/id #edb/ref 17592186510376 :knowledge-point/_questions [{:db/id #edb/ref 17592186198433 :knowledge-point/id #uuid "b5329867-1956-5f36-8614-26d483c36efe" :knowledge-point/title "Finding the Intersection of a Surface and a Line Given in Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49d7a3f7-5a7c-529b-8365-112a6e047f3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,-1,2)$ only" :db/id #edb/ref 17592186509838} {:answer/id #uuid "4b015270-c477-5154-96e4-6cc157ae07cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No points of intersection" :db/id #edb/ref 17592186509840} {:answer/id #uuid "58893bd2-e6a6-54b6-a356-759f3915936a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,-2,1)$ and $(-1,-1,2)$" :db/id #edb/ref 17592186509872} {:answer/id #uuid "a7ffed4d-2482-5099-8b82-bd20e8d364c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-1,2)$ and $(-1,-2,0)$" :db/id #edb/ref 17592186510044} {:answer/id #uuid "dc3d4c3e-b241-54c6-acec-d0f88c27e4bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-1,2)$ only" :db/id #edb/ref 17592186510157}] :answer-field/correct {:answer/id #uuid "a7ffed4d-2482-5099-8b82-bd20e8d364c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-1,2)$ and $(-1,-2,0)$" :db/id #edb/ref 17592186510044} :answer-field/id #uuid "6a536d68-bf2d-5dad-99bc-e23331bfdfe7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510296}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2fc9ea0f-3211-5796-852b-f82127f7f8bc" :question/math-academy-id "q-70492" :question/problem "Find the point(s) of the intersection of the sphere ${x}^{2}+(y+4)^{2}+(z-2)^{2}=9$ and the line $x=y+1=\\frac{z-2}{2}.$" :question/worked-solution "First, we write the equation of our line in parametric form:\n\n$$\n\\frac{x}{1}=\\frac{y+1}{1}=\\frac{z-2}{2}=t\\,⟹\\,\\{\\begin{aligned}x=t \\\\ y=t-1 \\\\ z=2t+2,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSubstituting the above expressions for $x$, $y$, and $z$ into the equation of the sphere, we obtain:\n\n$$\n\\begin{aligned}{x}^{2}+(y+4)^{2}+(z-2)^{2} & =9 \\\\ (t)^{2}+((t-1)+4)^{2}+((2t+2)-2)^{2} & =9 \\\\ (t)^{2}+(t+3)^{2}+(2t)^{2} & =9 \\\\ {t}^{2}+({t}^{2}+6t+9)+4{t}^{2} & =9 \\\\ 6{t}^{2}+6t+9 & =9 \\\\ 6{t}^{2}+6t & =0 \\\\ t(t+1) & =0\\end{aligned}\n$$\n\nHence, we get the solutions $t=0$ and $t=-1.$ \n\nNow, we substitute our solutions back into the equations of the line.\n\n- For $t=0$, we have\n\n$$\n\\{\\begin{aligned}x=(0)=0 \\\\ y=(0)-1=-1 \\\\ z=2(0)+2=2,\\end{aligned}\n$$\n\nso the first point is $(0,-1,2).$\n\n- For $t=-1$, we have\n\n$$\n\\{\\begin{aligned}x=(-1)=-1 \\\\ y=(-1)-1=-2 \\\\ z=2(-1)+2=0,\\end{aligned}\n$$\n\nso the second point is $(-1,-2,0).$\n\nTherefore, the points of intersection are $(0,-1,2)$ and $(-1,-2,0).$"}] [{:db/id #edb/ref 17592186510411 :knowledge-point/_questions [{:db/id #edb/ref 17592186198354 :knowledge-point/id #uuid "58427e6a-8e77-5c01-a578-a7dc4b8f8812" :knowledge-point/title "Finding the Projection of the Intersection of a Surface and a Tilted Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "172f9044-b08d-597e-a42f-5e850c62dc68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-8)^{2}}{1/3}+\\frac{(y-2)^{2}}{9}=1" :db/id #edb/ref 17592186509731} {:answer/id #uuid "22ebb37c-8c26-51e9-9c62-0f2d00524ac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-4)^{2}}{2/3}+\\frac{(y-2)^{2}}{9}=1" :db/id #edb/ref 17592186509760} {:answer/id #uuid "78a92225-282a-5fa9-927d-dd473156f003" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}+\\frac{(y-2)^{2}}{9}=1" :db/id #edb/ref 17592186509945} {:answer/id #uuid "a8a7513d-02fd-5ce8-a27d-be0b1651e1a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-4)^{2}}{1/2}+\\frac{(y-2)^{2}}{9}=1" :db/id #edb/ref 17592186510047} {:answer/id #uuid "bbef375e-e5f8-5e13-bf7c-2fbf0dbcd8ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+\\frac{(y-2)^{2}}{9}=1" :db/id #edb/ref 17592186510086}] :answer-field/correct {:answer/id #uuid "a8a7513d-02fd-5ce8-a27d-be0b1651e1a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-4)^{2}}{1/2}+\\frac{(y-2)^{2}}{9}=1" :db/id #edb/ref 17592186510047} :answer-field/id #uuid "57bc7b16-076a-5d7f-9700-faa7bbcaa22a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510283}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79a93a5e-93ce-572a-a9b2-6cc224e62f04" :question/math-academy-id "q-71144" :question/problem "Find the projection of the intersection between the ellipsoid $\\frac{2(x-4)^{2}}{3}+\\frac{(y-2)^{2}}{9}+\\frac{{z}^{2}}{3}=1$ and the plane $2x-z=8$ onto the $xy$-plane." :question/worked-solution "Since we want to find the projection onto the $xy$-plane, we need to eliminate the variable $z.$ First, we solve the equation of the plane for $z$, as follows:\n\n$$\n\\begin{aligned}2x-z & =8\\,⟹\\,z=2x-8\\end{aligned}\n$$\n\nSubstituting the expression for $z$ into the equation of the ellipsoid, we obtain:\n\n$$\n\\begin{aligned}\\frac{2(x-4)^{2}}{3}+\\frac{(y-2)^{2}}{9}+\\frac{(2x-8)^{2}}{3} & =1 \\\\ \\frac{2(x-4)^{2}}{3}+\\frac{(y-2)^{2}}{9}+\\frac{(2(x-4))^{2}}{3} & =1 \\\\ \\frac{2(x-4)^{2}}{3}+\\frac{(y-2)^{2}}{9}+\\frac{4(x-4)^{2}}{3} & =1 \\\\ 2(x-4)^{2}+\\frac{(y-2)^{2}}{9} & =1 \\\\ \\frac{(x-4)^{2}}{1/2}+\\frac{(y-2)^{2}}{9} & =1\\end{aligned}\n$$\n\nTherefore, the projection of the intersection is the ellipse $\\frac{(x-4)^{2}}{1/2}+\\frac{(y-2)^{2}}{9}=1.$"}] [{:db/id #edb/ref 17592186510412 :knowledge-point/_questions [{:db/id #edb/ref 17592186198433 :knowledge-point/id #uuid "b5329867-1956-5f36-8614-26d483c36efe" :knowledge-point/title "Finding the Intersection of a Surface and a Line Given in Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "023e9917-3ef8-5f06-9f86-33a31fac22e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-11,-5,-7)$ and $(1,1,-1)$" :db/id #edb/ref 17592186509700} {:answer/id #uuid "620ccc76-b273-5913-9295-a74568d6b881" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,1,-1)$ only" :db/id #edb/ref 17592186509893} {:answer/id #uuid "77a523c2-195a-5b93-b4f7-8f2f2ba7c2a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-3,-1,-3)$ and $(9,5,3)$" :db/id #edb/ref 17592186509939} {:answer/id #uuid "81c8c0cf-32fa-5ec8-ae30-58c2cefd375c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-7,-3,-5)$ and $(-3,-1,-3)$" :db/id #edb/ref 17592186509974} {:answer/id #uuid "8a82b00a-4358-523b-a223-90c195948106" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-11,-5,-7)$ only" :db/id #edb/ref 17592186509992}] :answer-field/correct {:answer/id #uuid "023e9917-3ef8-5f06-9f86-33a31fac22e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-11,-5,-7)$ and $(1,1,-1)$" :db/id #edb/ref 17592186509700} :answer-field/id #uuid "264de4f5-8c74-5910-abc7-434d194ea07f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510253}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79e25129-bb03-5263-b94d-378f30c636ff" :question/math-academy-id "q-94778" :question/problem "Find the points of the intersection of the elliptic cone ${x}^{2}+3{y}^{2}=4{z}^{2}$ and the line $\\frac{x+1}{2}=y=z+2.$" :question/worked-solution "First, we write the equation of our line in the parametric form:\n\n$$\n\\frac{x+1}{2}=y=z+2=t\\,⟹\\,\\{\\begin{aligned}x=2t-1 \\\\ y=t \\\\ z=t-2,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSubstituting the above expressions for $x,$ $y,$ and $z$ into the equation of the elliptic cone, we obtain\n\n$$\n\\begin{aligned}{x}^{2}+3{y}^{2} & =4{z}^{2} \\\\ (2t-1)^{2}+3{t}^{2} & =4(t-2)^{2} \\\\ 4{t}^{2}-4t+1+3{t}^{2} & =4({t}^{2}-4t+4) \\\\ 4{t}^{2}-4t+1+3{t}^{2} & =4{t}^{2}-16t+16 \\\\ 3{t}^{2}+12t-15 & =0 \\\\ 3({t}^{2}+4t-5) & =0 \\\\ 3(t+5)(t-1) & =0 \\\\ t & =-5,1.\\end{aligned}\n$$\n\nNow, we substitute our solutions back into the equations of the line.\n\n- For $t=-5,$ we have\n\n$$\n\\{\\begin{aligned}x=2(-5)-1=-11 \\\\ y=-5 \\\\ z=-5-2=-7,\\end{aligned}\n$$\n\nso the first point is $(-11,-5,-7).$\n\n- For $t=1,$ we have\n\n$$\n\\{\\begin{aligned}x=2(1)-1=1 \\\\ y=1 \\\\ z=1-2=-1,\\end{aligned}\n$$\n\nso the second point is $(1,1,-1).$\n\nTherefore, the points of intersection are $(-11,-5,-7)$ and $(1,1,-1).$"}]}
