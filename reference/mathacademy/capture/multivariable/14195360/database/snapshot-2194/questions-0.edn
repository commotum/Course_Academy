#{[{:db/id #edb/ref 17592186496282 :knowledge-point/_questions [{:db/id #edb/ref 17592186198354 :knowledge-point/id #uuid "58427e6a-8e77-5c01-a578-a7dc4b8f8812" :knowledge-point/title "Finding the Projection of the Intersection of a Surface and a Tilted Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2903bd31-59f2-5edf-ba78-0b700636216f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{4}-\\frac{(x+3)^{2}}{2}=1" :db/id #edb/ref 17592186495599} {:answer/id #uuid "72fcd5f6-74c1-548c-b798-b9f86c8b5a52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{4}-\\frac{(x+3)^{2}}{4}=1" :db/id #edb/ref 17592186495763} {:answer/id #uuid "d9e331d6-2b84-5961-a705-7c0440233497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{4}+\\frac{(x+3)^{2}}{2}=1" :db/id #edb/ref 17592186495990} {:answer/id #uuid "e4145407-31af-5f0e-be8b-a08fc7a69e9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{4}+\\frac{(x+3)^{2}}{4}=1" :db/id #edb/ref 17592186496016} {:answer/id #uuid "e87b73a0-162f-5a86-8eb0-04ffa6648475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{4}-\\frac{(x+3)^{2}}{8}=1" :db/id #edb/ref 17592186496023}] :answer-field/correct {:answer/id #uuid "d9e331d6-2b84-5961-a705-7c0440233497" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{4}+\\frac{(x+3)^{2}}{2}=1" :db/id #edb/ref 17592186495990} :answer-field/id #uuid "ac07d115-2c5e-5c77-b205-49ff29ccdb65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496158}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c16a549-c615-5f5a-9201-b01b9bbc4908" :question/math-academy-id "q-36325" :question/problem "Find the projection of the intersection between the hyperboloid of one sheet \n$(x+3)^{2}+\\frac{{y}^{2}}{4}-2{z}^{2}=1$\n and the plane   $x+2z=-3$ onto the\n$xy$-plane." :question/worked-solution "Since we want to find the projection onto the $xy$-plane, we need to eliminate the variable $z.$ First, we solve the equation of the plane for $z$, as follows:\n\n$$\nx+2z=-3\\,⟹\\,z=-\\frac{x+3}{2}\n$$\n\nSubstituting the expression for $z$ into the equation of the hyperboloid, we obtain: \n\n$$\n\\begin{aligned}(x+3)^{2}+\\frac{{y}^{2}}{4}-2{(-\\frac{x+3}{2})}^{2} & =1 \\\\ (x+3)^{2}+\\frac{{y}^{2}}{4}-\\frac{(x+3)^{2}}{2} & =1 \\\\ \\frac{{y}^{2}}{4}+\\frac{(x+3)^{2}}{2} & =1.\\end{aligned}\n$$\n\nTherefore, the projection of the intersection is the ellipse $\\frac{{y}^{2}}{4}+\\frac{(x+3)^{2}}{2}=1.$"}]}
