302566 #edb/ref 17592186045417] [17592186304745 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186304745 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186304745 #edb/ref 1078 #edb/ref 17592186302566 #edb/ref 17592186045417] [17592186304745 #edb/ref 1079 #uuid "f8e1d37f-459d-53b0-945b-abafb595373e" #edb/ref 17592186045417] [17592186305034 #edb/ref 1068 #edb/ref 17592186304103 #edb/ref 17592186045417] [17592186305034 #edb/ref 1068 #edb/ref 17592186304506 #edb/ref 17592186045417] [17592186305034 #edb/ref 1068 #edb/ref 17592186304704 #edb/ref 17592186045417] [17592186305034 #edb/ref 1068 #edb/ref 17592186304745 #edb/ref 17592186045417] [17592186305034 #edb/ref 1069 "q-332391" #edb/ref 17592186045417] [17592186305034 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186305034 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}2 \\\\ 0\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L\\{{x}_{1}(t)\\}=\\frac{1}{s}+\\frac{1}{s-2},\\,{X}_{2}(s)=L\\{{x}_{2}(t)\\}=\\frac{1}{s}-\\frac{1}{s-2}.\n$$\n\nFind the solution to the original initial value problem.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,+\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,{e}^{2t}$</td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186305034 #edb/ref 1072 #uuid "8583693b-a733-5fca-ba20-8078cfaf6308" #edb/ref 17592186045417] [17592186305034 #edb/ref 1074 "To find ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to ${X}_{1}(s)$ and ${X}_{2}(s):$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}\\{{X}_{1}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s}+\\frac{1}{s-2}\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s}\\}+{L}^{-1}\\{\\frac{1}{s-2}\\} \\\\  & =1+{e}^{2\\cdot t} \\\\  & =1+{e}^{2t} \\\\ {x}_{2}(t) & ={L}^{-1}\\{{X}_{2}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s}-\\frac{1}{s-2}\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s}\\}-{L}^{-1}\\{\\frac{1}{s-2}\\} \\\\  & =1-{e}^{2\\cdot t} \\\\  & =1-{e}^{2t}\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}1+{e}^{2t} \\\\ 1-{e}^{2t}\\end{aligned}]=[\\begin{aligned}1 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{2t}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186433181 #edb/ref 1080 "7{X}_{1}(s)-{X}_{2}(s)" #edb/ref 17592186045417] [17592186433181 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186433181 #edb/ref 1083 #uuid "0159502e-a9cf-5ff7-bff6-d0e20f2c8963" #edb/ref 17592186045417] [17592186433182 #edb/ref 1080 "{X}_{1}(s)+1" #edb/ref 17592186045417] [17592186433182 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186433182 #edb/ref 1083 #uuid "27146881-ffe8-5c67-86f6-80ca0d70d2b1" #edb/ref 17592186045417] [17592186433183 #edb/ref 1080 "-7{X}_{1}(s)-4{X}_{2}(s)" #edb/ref 17592186045417] [17592186433183 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186433183 #edb/ref 1083 #uuid "3e04df09-fefe-