92186045417 true] [17592186433216 1076 #edb/ref 17592186045492 13194139534698 17592186045417 true] [17592186433216 1077 "field-1" 13194139534698 17592186045417 true] [17592186433216 1078 #edb/ref 17592186433190 13194139534698 17592186045417 true] [17592186433216 1079 #uuid "feb29a18-3baa-5257-96e8-ae32828c5d44" 13194139534698 17592186045417 true] [17592186433217 1068 #edb/ref 17592186433210 13194139534698 17592186045417 true] [17592186433217 1068 #edb/ref 17592186433212 13194139534698 17592186045417 true] [17592186433217 1068 #edb/ref 17592186433215 13194139534698 17592186045417 true] [17592186433217 1069 "q-331901" 13194139534698 17592186045417 true] [17592186433217 1070 #edb/ref 17592186045485 13194139534698 17592186045417 true] [17592186433217 1071 "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=-4{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=7{x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}-5 \\\\ 4\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n\\{\\begin{aligned}{{field-1}}=-4{X}_{1}(s) \\\\ {{field-2}}={{field-3}}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." 13194139534698 17592186045417 true] [17592186433217 1072 #uuid "69f45dd4-5ba1-5f14-94db-7e83a2055bbf" 13194139534698 17592186045417 true] [17592186433217 1074 "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{-4{x}_{1}(t)\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{7{x}_{1}(t)+{x}_{2}(t)\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=-4L\\{{x}_{1}(t)\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=7L\\{{x}_{1}(t)\\}+L\\{{x}_{2}(t)\\}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)+5=-4{X}_{1}(s) \\\\ s{X}_{2}(s)-4=7{X}_{1}(s)+{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." 13194139534698 17592186045417 true] [17592186433218 1068 #edb/ref 17592186433216 13194139534698 17592186045417 true] [17592186433218 1069 "q-332029" 13194139534698 17592186045417 true] [17592186433218 1070 #edb/ref 17592186045487 13194139534698 17592186045417 true] [17592186433218 1071 "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-2{x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}3 \\\\ -6\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},\n$\\,{X}_{2}(s)=\\frac{-6(s-1)}{s(s-3)}.$" 13194139534698 17592186045417 true] [17592186433218 1072 #uuid "a9551a40-c332-54a5-8337-fb6b102278bb" 13194139534698 17592186045417 true] [17592186433218 1074 "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{2{x}_{1}(t)-{x}_{2}(t)\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{-2{x}_{1}(t)+{x}_{2}(t)\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=2L\\{{x}_{1}(t)\\}-L\\{{x}_{2}(t)\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=-2L\\{{x}_{1}(t)\\}+L\\{{x}_{2}(t)\\}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)-3=2{X}_{1}(s)-{X}_{2}(s) \\\\ s{X}_{2}(s)+6=-2{X}_{1}(s)+{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$\n\nRewriting the system in standard form, we get the following:\n\n$$\n\\{\\begin{aligned}(s-2){X}_{1}(s)+{X}_{2}(s)=3 \\\\ 2{X}_{1}(s)+(s-1){X}_{2}(s)=-6\\end{aligned}\n$$\n\nNow, from the second equation, we have \n\n$$\n{X}_{1}(s)=\\frac{-6-(s-1){X}_{2}(s)}{2}.\n$$\n\nSubstituting this into the first equation, we get\n\n$$\n\\begin{aligned}(s-2)[\\frac{-6-(s-1){X}_{2}(s)}{2}]+{X}_{2}(s) & =3 \\\\ (s-2)[-6-(s-1){X}_{2}(s)]+2{X}_{2}(s) & =6 \\\\ -6(s-2)-(s-2)(s-1){X}_{2}(s)+2{X}_{2}(s) & =6 \\\\ [-(s-2)(s-1)+2]{X}_{2}(s) & =6+6(s-2) \\\\ (-{s}^{2}+3s){X}_{2}(s) & =6s-6 \\\\ -s(s-3){X}_{2}(s) & =6(s-1) \\\\ {X}_{2}(s) & =\\frac{-6(s-1)}{s(s-3)}.\\end{aligned}\n$$\n\nNext, we find ${X}_{1}(s):$\n\n$$\n\\begin{aligned}{X}_{1}(s) & =\\frac{-6-(s-1){X}_{2}(s)}{2} \\\\  & =\\frac{-6-(s-1)(\\frac{-6(s-1)}{s(s-3)})}{2} \\\\  & =\\frac{-6+\\frac{6(s-1)^{2}}{s(s-3)}}{2} \\\\  & =\\frac{-6s(s-3)+6(s-1)^{2}}{2s(s-3)} \\\\  & =\\frac{3(s+1)}{s(s-3)}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{X}_{1}(s)=\\frac{3(s+1)}{s(s-3)},\\,{X}_{2}(s)=\\frac{-6(s-1)}{s(s-3)}.\n$$" 13194139534698 17592186045417 true] [17592186433219 1068 #edb/ref 17592186433211 13194139534698 17592186045417 true] [17592186433219 1068 #edb/ref 17592186433213 13194139534698 17592186045417 true] [17592186433219 1068 #edb/ref 17592186433214 13194139534698 17592186045417 true] [17592186433219 1069 "q-331903" 13194139534698 17592186045417 true] [17592186433219 1070 #edb/ref 17592186045485 13194139534698 17592186045417 true] [17592186433219 1071 "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=-7{x}_{1}(t)-4{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-5{x}_{1}(t)+4{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}-1 \\\\ -6\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n\\{\\begin{aligned}{{field-1}}={{field-2}} \\\\ {{field-3}}=-5{X}_{1}(s)+4{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." 13194139534698 17592186045417 true] [17592186433219 1072 #uuid "affee19e-8bbb-5e06-bea1-1923b23ecbed" 13194139534698 17592186045417 true] [17592186433219 1074 "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{-7{x}_{1}(t)-4{x}_{2}(t)\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{-5{x}_{1}(t)+4{x}_{2}(t)\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=-7L\\{{x}_{1}(t)\\}-4L\\{{x}_{2}(t)\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=-5L\\{{x}_{1}(t)\\}+4L\\{{x}_{2}(t)\\}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)+1=-7{X}_{1}(s)-4{X}_{2} \\\\ s{X}_{2}(s)+6=-5{X}_{1}(s)+4{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." 13194139534698 17592186045417 true]] :edb/tempids {"answer-0159502e-a9cf-5ff7-bff6-d0e20f2c8963" 17592186433181 "answer-27146881-ffe8-5c67-86f6-80ca0d70d2b1" 17592186433182 "answer-3e04df09-fefe-577f-8fc1-5bfd603147f3" 17592186433183 "answer-4285ce1d-b698-5afb-812f-b122b49c1dc7" 17592186433184 "answer-458f3c5a-3381-501b-a7f2-dee6d946a149" 17592186433185 "answer-46ff255e-6ad7-565a-bd98-f25ef0ddd954" 17592186433186 "answer-49552c77-e3ef-5aa7-b162-5a1dfbe9d248" 17592186433187 "answer-497a2587-af32-58f2-acc6-994ca52456f1" 17592186433188 "answer-554b6a08-d810-54b8-b391-27bcd47e0847" 17592186433189 "answer-5b33fffb-189c-5d9f-921e-fb455c3f6d66" 17592186433190 "answer-648ac375-ffeb-52c6-b4e9-09ea2dfa38c7" 17592186433191 "answer-661bf31f-47bf-5dcd-856c-f898061b2ff8" 17592186433192 "answer-712e42fa-7b12-5974-bec3-df3b2a35d9c1" 17592186433193 "answer-7135ebc0-5a1b