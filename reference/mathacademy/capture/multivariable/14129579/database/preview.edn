0.3)}^{1}{(0.7)}^{4-1} \\\\  & =1{(0.3)}^{0}{(0.7)}^{4}+4{(0.3)}^{1}{(0.7)}^{3} \\\\  & ≈0.652\\end{aligned}\n$$\n\nrounded to $3$ decimal places." 13194139534580 17592186045417 true] [17592186426428 1068 #edb/ref 17592186426419 13194139534580 17592186045417 true] [17592186426428 1069 "q-97529" 13194139534580 17592186045417 true] [17592186426428 1070 #edb/ref 17592186045486 13194139534580 17592186045417 true] [17592186426428 1071 "Given that $X∼B(8,0.3),$ compute $P(X>2).$ Round your final answer to $4$ decimal places." 13194139534580 17592186045417 true] [17592186426428 1072 #uuid "7b719cf3-bd28-5a38-b0fa-b59090fe757c" 13194139534580 17592186045417 true] [17592186426428 1074 "For a binomial random variable $X∼B(n,p),$ we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(8,0.3),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{8}{x})(0.3)^{x}(0.7)^{8-x}.\n$$\n\nComputing $P(X>2)$ will require us to compute $f(x)$ at $x=3,4,…,8.$ However, if we compute the complement $P(X\\le 2)$ instead, then we will only have to compute $f(x)$ at $x=0,1,2,$ which will result in a much faster computation.\n\nComputing $P(X\\le 2),$ we get\n\n$$\n\\begin{aligned}P(X\\le 2) & =P(X\\in \\{0,1,2\\}) \\\\  & =f(0)+f(1)+f(2) \\\\  & =(\\genfrac{}{}{0pt}{}{8}{0})(0.3)^{0}(0.7)^{8-0}+(\\genfrac{}{}{0pt}{}{8}{1})(0.3)^{1}(0.7)^{8-1}+(\\genfrac{}{}{0pt}{}{8}{2})(0.3)^{2}(0.7)^{8-2} \\\\  & =(0.7)^{8}+8(0.3)(0.7)^{7}+28(0.3)^{2}(0.7)^{6} \\\\  & ≈0.5518\\end{aligned}\n$$\n\nrounded to $4$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X>2) & =1-P(X\\le 2) \\\\  & ≈1-0.5518 \\\\  & =0.4482\\end{aligned}\n$$\n\nrounded to $4$ decimal places." 13194139534580 17592186045417 true] [17592186426429 1068 #edb/ref 17592186426424 13194139534580 17592186045417 true] [17592186426429 1069 "q-129974" 13194139534580 17592186045417 true] [17592186426429 1070 #edb/ref 17592186045485 13194