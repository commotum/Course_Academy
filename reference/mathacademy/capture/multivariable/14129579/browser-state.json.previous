      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129579/observations/step-q281206-38fae71b743d1b51003c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129579/observations/step-q281206-38fae71b743d1b51003c.png",
