://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><mi>P</mi><mo stretchy=\"false\">(</mo><mn>3</mn><mo>≤</mo><mi>X</mi><mo>≤</mo><mn>5</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mi>P</mi><mo stretchy=\"false\">(</mo><mi>X</mi><mo>∈</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>5</mn><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>5</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">(</mo></mrow><mfrac linethickness=\"0\"><mn>6</mn><mn>3</mn></mfrac><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">)</mo></mrow></mrow><mo stretchy=\"false\">(</mo><mn>0.2</mn><msup><mo stretchy=\"false\">)</mo><mn>3</mn></msup><mo stretchy=\"false\">(</mo><mn>0.8</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>6</mn><mo>−</mo><mn>3</mn></mrow></msup><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">(</mo></mrow><mfrac linethickness=\"0\"><mn>6</mn><mn>4</mn></mfrac><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">)</mo></mrow></mrow><mo stretchy=\"false\">(</mo><mn>0.2</mn><msup><mo stretchy=\"false\">)</mo><mn>4</mn></msup><mo stretchy=\"false\">(</mo><mn>0.8</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>6</mn><mo>−</mo><mn>4</mn></mrow></msup><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">(</mo></mrow><mfrac linethickness=\"0\"><mn>6</mn><mn>5</mn></mfrac><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">)</mo></mrow></mrow><mo stretchy=\"false\">(</mo><mn>0.2</mn><msup><mo stretchy=\"false\">)</mo><mn>5</mn></msup><mo stretchy=\"false\">(</mo><mn>0.8</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>6</mn><mo>−</mo><mn>5</mn></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>20</mn><mo stretchy=\"false\">(</mo><mn>0.2</mn><msup><mo stretchy=\"false\">)</mo><mn>3</mn></msup><mo stretchy=\"false\">(</mo><mn>0.8</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow></msup><mo>+</mo><mn>15</mn><mo stretchy=\"false\">(</mo><mn>0.2</mn><msup><mo stretchy=\"false\">)</mo><mn>4</mn></msup><mo stretchy=\"false\">(</mo><mn>0.8</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msup><mo>+</mo><mn>6</mn><mo stretchy=\"false\">(</mo><mn>0.2</mn><msup><mo stretchy=\"false\">)</mo><mn>5</mn></msup><mo stretchy=\"false\">(</mo><mn>0.8</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mn>0.0988</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>\nto <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"196\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math></mjx-assistive-mml></mjx-container> decimal places.</p>\n</div></div>",
