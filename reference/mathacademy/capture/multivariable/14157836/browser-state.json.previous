>[</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mn>4</mn></mrow></msubsup><mi>v</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>v</mi><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mn>2</mn></msubsup><mi>u</mi><msubsup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>v</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mn>4</mn></mrow></msubsup><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mn>2</mn></msubsup><mi>u</mi><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mn>4</mn><mn>2</mn></msup><mn>2</mn></mfrac></mstyle><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mn>2</mn><mn>2</mn></msup><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3</mn><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mn>2</mn></msubsup><mi>u</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3</mn><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">[</mo></mrow><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>u</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle><msubsup><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">]</mo></mrow><mn>0</mn><mn>2</mn></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3</mn><mo>⋅</mo><mn>2</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>6.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>    </p>\n</div></div>",
