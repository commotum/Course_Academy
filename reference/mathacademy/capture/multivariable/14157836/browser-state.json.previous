class=\"CLOSE\">)</mo></mrow><mn>2</mn></msup><mo>⋅</mo><mn>1</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>u</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>v</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mn>1</mn></msubsup><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow><mn>2</mn></msubsup><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>u</mi><mo>−</mo><mn>2</mn><mi>v</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mn>2</mn></msup><mtext>d</mtext><mi>u</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>v</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>   </p>\n</div></div>",
