      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14157836/observations/step-q160906-94f7cb259bdd6fb041b0.png",
      "source_url": "https://mathacademy.com/tasks/14157836/topics/4132/lesson",
      "captured_at": 1791866080.6666136,
      "math_academy_id": "q-160906",
      "topic_id": "4132",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q160906",
        "placement_id": null,
        "content_id": null,
        "type": null
