      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14157836/observations/step-q82818-3c947e985ae524e6dea8.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14157836/observations/step-q82818-3c947e985ae524e6dea8.png",
