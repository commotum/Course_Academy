99 #edb/ref 1080 "\\pi " #edb/ref 17592186045417] [17592186535599 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186535599 #edb/ref 1083 #uuid "6899860b-81ea-5720-98fc-80926761f0f1" #edb/ref 17592186045417] [17592186535718 #edb/ref 1080 "\\frac{\\pi}{6}" #edb/ref 17592186045417] [17592186535718 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186535718 #edb/ref 1083 #uuid "ba22ce2a-0962-5777-b986-98a5bafb7d11" #edb/ref 17592186045417] [17592186535747 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186535747 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186535747 #edb/ref 1083 #uuid "ceb453c5-9589-5071-99e3-645a2efd0834" #edb/ref 17592186045417] [17592186535780 #edb/ref 1080 "The integral is divergent" #edb/ref 17592186045417] [17592186535780 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186535780 #edb/ref 1083 #uuid "e03abd1a-722a-5b07-a324-580b73ea930e" #edb/ref 17592186045417] [17592186535913 #edb/ref 1075 #edb/ref 17592186535474 #edb/ref 17592186045417] [17592186535913 #edb/ref 1075 #edb/ref 17592186535545 #edb/ref 17592186045417] [17592186535913 #edb/ref 1075 #edb/ref 17592186535599 #edb/ref 17592186045417] [17592186535913 #edb/ref 1075 #edb/ref 17592186535747 #edb/ref 17592186045417] [17592186535913 #edb/ref 1075 #edb/ref 17592186535780 #edb/ref 17592186045417] [17592186535913 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186535913 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186535913 #edb/ref 1078 #edb/ref 17592186535545 #edb/ref 17592186045417] [17592186535913 #edb/ref 1079 #uuid "da97b470-1a5e-578a-80de-9d4315049c8f" #edb/ref 17592186045417] [17592186535938 #edb/ref 1068 #edb/ref 17592186535913 #edb/ref 17592186045417] [17592186535938 #edb/ref 1069 "q-86453" #edb/ref 17592186045417] [17592186535938 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186535938 #edb/ref 1071 "Evaluate ${\\int }_{-\\infty }^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186535938 #edb/ref 1072 #uuid "21f7ba2a-9a0f-57d4-9aff-030342b38301" #edb/ref 17592186045417] [17592186535938 #edb/ref 1074 "We break up the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x & ={\\int }_{-\\infty }^{0}\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x\\end{aligned}\n$$\n\nWe start by calculating the second of these integrals:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x & ={\\int }_{0}^{\\infty }\\frac{4x}{{(1+{x}^{2})}^{3}}\\,\\text{d}x\\end{aligned}\n$$\n\nWe calculate the antiderivative using a substitution. Let $u=1+{x}^{2}$,  then $\\text{d}u=2x\\text{d}x.$ Hence\n\n$$\n\\begin{aligned}\\int \\frac{4x}{{(1+{x}^{2})}^{3}}\\,\\text{d}x & =\\int \\frac{2}{{u}^{3}}\\,\\text{d}u \\\\  & =-\\frac{1}{{u}^{2}}+C \\\\  & =-\\frac{1}{{(1+{x}^{2})}^{2}}+C.\\end{aligned}\n$$\n\nWe now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x & ={\\int }_{0}^{\\infty }\\frac{4x}{{(1+{x}^{2})}^{3}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}\\frac{4x}{{(1+{x}^{2})}^{3}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }({-\\frac{1}{{(1+{x}^{2})}^{2}}|}_{0}^{a}) \\\\  & ={lim}_{a\\to \\infty }(-\\frac{1}{{(1+{x}^{2})}^{2}}+\\frac{1}{(1+0)^{2}}) \\\\  & =-0+1 \\\\  & =1.\\end{aligned}\n$$\n\nNow, notice that the integrand $\\frac{4|x|}{{(1+{x}^{2})}^{3}}$ is an **even** function. This means that we can immediately deduce that \n\n$$\n{\\int }_{-\\infty }^{0}\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x=1.\n$$\n\nTherefore, since both improper integrals exist, we conclude that \n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x & ={\\int }_{-\\infty }^{0}\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x \\\\  & =1+1 \\\\  & =2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186536007 #edb/ref 1058 #edb/ref 17592186536013 #edb/ref 17592186045417] [17592186536007 #edb/ref 1062 #uuid "0727a7ae-2a4f-5a1a-b263-107fab74a519" #edb/ref 17592186045417] [17592186536007 #edb/ref 1063 #edb/ref 17592186253506 #edb/ref 17592186045417] [17592186536013 #edb/ref 1062 #uuid "20ef6a64-43e5-569e-9232-97b79c35df56" #edb/ref 17592186045417] [17592186536013 #edb/ref 1063 #edb/ref 17592186320880 #edb/ref 17592186045417] [17592186536027 #edb/ref 1058 #edb/ref 17592186536007 #edb/ref 17592186045417] [17592186536027 #edb/ref 1062 #uuid "6cb888af-c468-5ec7-990d-1e6270a76de3" #edb/ref 17592186045417] [17592186536027 #edb/ref 1063 #edb/ref 17592186535938 #edb/ref 17592186045417] [17592186536043 #edb/ref 1058 #edb/ref 17592186536027 #edb/ref 17592186045417] [17592186536043 #edb/ref 1062 #uuid "cd28a652-1df4-5863-b66e-4a60f9e2ee7f" #edb/ref 17592186045417] [17592186536043 #edb/ref 1063 #edb/ref 17592186288012 #edb/ref 17592186045417] [17592186536052 #edb/ref 1058 #edb/ref 17592186536043 #edb/ref 17592186045417] [17592186536052 #edb/ref 1062 #uuid "fd9a0382-9f34-5402-8fbe-b792883b94da" #edb/ref 17592186045417] [17592186536052 #edb/ref 1063 #edb/ref 17592186332946 #edb/ref 17592186045417]}
