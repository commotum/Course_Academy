a475a4cf13196166bd65ac88d7b.png)"} :step/id #uuid "f301e8ab-1294-53d5-b248-897ded01ea54" :step/next {:db/id #edb/ref 17592186445200}}] :activity/title "Global vs. Local Extrema and Critical Points of Multivariable Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186445191}]}
