be-5932-a217-f573cfba9f2d" 13194139534943 17592186045417 true] [17592186445195 1080 "$B$ only" 13194139534943 17592186045417 true] [17592186445195 1082 #edb/ref 17592186045499 13194139534943 17592186045417 true] [17592186445195 1083 #uuid "b9b3e9e9-2073-5961-8289-000100206e82" 13194139534943 17592186045417 true] [17592186445196 1080 "$A$ only" 13194139534943 17592186045417 true] [17592186445196 1082 #edb/ref 17592186045499 13194139534943 17592186045417 true] [17592186445196 1083 #uuid "e2b33820-f35d-5434-abf3-958f348e4695" 13194139534943 17592186045417 true] [17592186445197 1075 #edb/ref 17592186445192 13194139534943 17592186045417 true] [17592186445197 1075 #edb/ref 17592186445193 13194139534943 17592186045417 true] [17592186445197 1075 #edb/ref 17592186445194 13194139534943 17592186045417 true] [17592186445197 1075 #edb/ref 17592186445195 13194139534943 17592186045417 true] [17592186445197 1075 #edb/ref 17592186445196 13194139534943 17592186045417 true] [17592186445197 1076 #edb/ref 17592186045493 13194139534943 17592186045417 true] [17592186445197 1077 "selection" 13194139534943 17592186045417 true] [17592186445197 1078 #edb/ref 17592186445196 13194139534943 17592186045417 true] [17592186445197 1079 #uuid "261ceadd-9e63-5d86-9762-c5e81f0679da" 13194139534943 17592186045417 true] [17592186445198 1068 #edb/ref 17592186445197 13194139534943 17592186045417 true] [17592186445198 1069 "q-164157" 13194139534943 17592186045417 true] [17592186445198 1070 #edb/ref 17592186045487 13194139534943 17592186045417 true] [17592186445198 1071 "![](images/19/19f4f2d616fa648fcd4663be22b32ab18662fffa8e31f9bd44f0dd3b6da99208.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local maximum points?" 13194139534943 17592186045417 true] [17592186445198 1072 #uuid "da2e1b4b-fd99-52e9-91fa-fb0d43968219" 13194139534943 17592186045417 true] [17592186445198 1074 "A function $f(x,y)$ has a local maximum point at $(a,b)$ if $f(x,y)\\le f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the highest point on the graph in the neighborhood.\n\nSuch region exists for the point $A.$ Hence, $A$ is a local maximum point.\n\n**Note**: For the point $A({x}_{A},{y}_{A},{z}_{A}),$ there are points $(x,y)$ in the surrounding regions such that $f({x}_{A},{y}_{A})=f(x,y).$ However, since the definition of local extrema is non-strict, $f(x,y)\\le f(a,b)$, the point $A$ does satisfy the conditions for a local maximum.\n\n![](images/f0/f0b16c2cb372280ec39915b0e8d4e396e68baec9a8e20edc5389ced079648836.png)" 13194139534943 17592186045417 true] [17592186445199 1058 #edb/ref 17592186445203 13194139534943 17592186045417 true] [17592186445199 1062 #uuid "40399da2-21fd-5f08-bac2-f30a1d0cf8b3" 13194139534943 17592186045417 true] [17592186445199 1063 #edb/ref 17592186367874 13194139534943 17592186045417 true] [17592186445200 1058 #edb/ref 17592186445201 13194139534943 17592186045417 true] [17592186445200 1062 #uuid "781a150f-a171-5196-8aca-b895a99d8faa" 13194139534943 17592186045417 true] [17592186445200 1063 #edb/ref 17592186445198 13194139534943 17592186045417 true] [17592186445201 1062 #uuid "7aa4c459-af9e-558f-a889-0dc28bf20ece" 13194139534943 17592186045417 true] [17592186445201 1063 #edb/ref 17592186284450 13194139534943 17592186045417 true] [17592186445202 1058 #edb/ref 17592186445199 13194139534943 17592186045417 true] [17592186445202 1062 #uuid "f285dabd-6305-5f61-b401-ef0b24f27f1a" 13194139534943 17592186045417 true] [17592186445202 1063 #edb/ref 17592186124813 13194139534943 17592186045417 true] [17592186445203 1058 #edb/ref 17592186445200 13194139534943 17592186045417 true] [17592186445203 1062 #uuid "f301e8ab-1294-53d5-b248-897ded01ea54" 13194139534943 17592186045417 true] [17592186445203 1063 #edb/ref 17592186401439 13194139534943 17592186045417 true]] :edb/tempids {"activity-632f0c8c-4357-5396-aad3-4401d3471d8c" 175921