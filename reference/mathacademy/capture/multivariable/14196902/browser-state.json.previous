      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q144833-56b30114680aca991002.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q144833-56b30114680aca991002.png",
      "source_url": "https://mathacademy.com/tasks/14196902/topics/1230/lesson",
      "captured_at": 1791957768.9887452,
      "math_academy_id": "q-144833",
      "topic_id": "1230",
      "sequence_position": null,
      "source_step": {
