      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q343672-732c6eacf9c588290346.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q343672-732c6eacf9c588290346.png",
