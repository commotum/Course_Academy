      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q343884-edaa52fb59add23f669a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q343884-edaa52fb59add23f669a.png",
      "source_url": "https://mathacademy.com/tasks/14196902/topics/1230/lesson",
      "captured_at": 1791958024.908771,
      "math_academy_id": "q-343884",
      "topic_id": "1230",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q343884",
