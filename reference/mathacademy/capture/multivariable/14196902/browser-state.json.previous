      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q343665-21a814af2d53e3940438.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q343665-21a814af2d53e3940438.png",
      "source_url": "https://mathacademy.com/tasks/14196902/topics/1230/lesson",
