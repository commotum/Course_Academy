      "source_url": "https://mathacademy.com/tasks/14196902/topics/1230/lesson",
      "captured_at": 1791957690.908898,
      "math_academy_id": "q-141882",
      "topic_id": "1230",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q141882",
        "placement_id": null,
        "content_id": null,
        "type": null
