jx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em; margin-left: -0.06em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6D\"></mjx-c><mjx-c class=\"mjx-c61\"></mjx-c><mjx-c class=\"mjx-c78\"></mjx-c></mjx-mtext></mjx-texatom></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>f</mi><mrow data-mjx-texclass=\"ORD\"><mtext>max</mtext></mrow></msub><mo>=</mo></math></mjx-assistive-mml></mjx-container>\n<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:40px;\n                                        margin-left:4px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"1\"><span mathquill-command-id=\"3\" class=\"\">−</span><span mathquill-command-id=\"5\">5</span><span class=\"mq-nonSymbola\" mathquill-command-id=\"7\">π</span></span></div></div></div></div><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div class=\"questionWidget-spinner\" style=\"display: block;\"></div></div><div class=\"questionWidget-result\"><div class=\"questionWidget-incorrectIcon\"><img src=\"/img/incorrect-answer.svg\"></div><div class=\"questionWidget-incorrectText\">Incorrect</div></div><div class=\"questionWidget-explanationHeader\">EXPLANATION</div><div class=\"qu