      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q343680-2f572f5dc669ac0e1df6.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q343680-2f572f5dc669ac0e1df6.png",
      "source_url": "https://mathacademy.com/tasks/14196902/topics/1230/lesson",
      "captured_at": 1791957919.2527618,
      "math_academy_id": "q-343680",
