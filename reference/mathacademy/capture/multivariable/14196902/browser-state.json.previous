      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q15744-8d6083553c23852fcf55.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q15744-8d6083553c23852fcf55.png",
      "source_url": "https://mathacademy.com/tasks/14196902/topics/1230/lesson",
      "captured_at": 1791958111.5646107,
      "math_academy_id": "q-15744",
      "topic_id": "1230",
      "sequence_position": null,
      "source_step": {
