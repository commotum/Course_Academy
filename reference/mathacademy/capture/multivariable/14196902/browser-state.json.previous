      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q18650-d544ae557dbd1da57e30.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q18650-d544ae557dbd1da57e30.png",
