      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q343902-5897b3d5992089d8a94c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q343902-5897b3d5992089d8a94c.png",
      "source_url": "https://mathacademy.com/tasks/14196902/topics/1230/lesson",
      "captured_at": 1791957982.5222836,
      "math_academy_id": "q-343902",
