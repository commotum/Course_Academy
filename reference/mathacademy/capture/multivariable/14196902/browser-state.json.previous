      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q343704-2fd9adfae2c69d0b16a5.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196902/observations/step-q343704-2fd9adfae2c69d0b16a5.png",
      "source_url": "https://mathacademy.com/tasks/14196902/topics/1230/lesson",
