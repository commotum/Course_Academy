#{[{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186498616} :activity/id #uuid "d391d32b-b16d-540c-996a-eea9e96f6f32" :activity/scope {:db/id #edb/ref 17592186050615 :topic/id #uuid "58ea9fa1-e1b7-56f7-a58d-173ed320b2af" :topic/math-academy-id 6369} :activity/steps [{:db/id #edb/ref 17592186498613 :step/content {:db/id #edb/ref 17592186498560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c0f16cb-5174-5b73-b5f7-d769c600bca2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{{s}^{3}}+\\frac{24}{(s-2)^{4}}" :db/id #edb/ref 17592186497973} {:answer/id #uuid "6b5ee011-1e91-5398-889f-6887925f5543" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{s}^{2}}+\\frac{6}{(s-2)^{4}}" :db/id #edb/ref 17592186498061} {:answer/id #uuid "de1efeda-62c3-5e17-b7cb-b295d6451ef1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{{s}^{2}}+\\frac{4}{(s-2)^{3}}" :db/id #edb/ref 17592186498295} {:answer/id #uuid "f22261e4-628e-5669-8943-4998a47f8540" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{{s}^{2}}+\\frac{12}{(s-2)^{4}}" :db/id #edb/ref 17592186498331} {:answer/id #uuid "ff0b72cf-c5ca-5854-b15b-0478c4cfc654" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{{s}^{2}}+\\frac{24}{(s-2)^{4}}" :db/id #edb/ref 17592186498359}] :answer-field/correct {:db/id #edb/ref 17592186498359} :answer-field/id #uuid "d796c28f-05c4-5d13-97d9-d47a85425db2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186498469}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8828e2f6-2765-54b6-be68-2960b77fe33e" :question/math-academy-id "q-332127" :question/problem "Given that\n\n$$\n\\begin{aligned}L\\{{t}^{n}\\} & =\\frac{n!}{{s}^{n+1}}, &  & s>0,\\end{aligned}\n$$\n\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of $f(t)=6t+4{t}^{3}{e}^{2t}$ for $s>2.$" :question/worked-solution "First, we apply the linearity properties of Laplace transforms:\n\n$$\n\\begin{aligned}L\\{f(t)\\} & =L\\{6t+4{t}^{3}{e}^{2t}\\} \\\\  & =L\\{6t\\}+L\\{4{t}^{3}{e}^{2t}\\} \\\\  & =6L\\{t\\}+4L\\{{t}^{3}{e}^{2t}\\}\\end{aligned}\n$$\n\nWe are given that, for $s>0,$\n\n$$\n\\begin{aligned}L\\{{t}^{n}\\} & =\\frac{n!}{{s}^{n+1}}.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L\\{t\\} & =\\frac{1}{{s}^{2}} \\\\ L\\{{t}^{3}\\} & =\\frac{6}{{s}^{4}}\\end{aligned}\n$$\n\nThe first shifting theorem states that if $L\\{f(t)\\}=F(s),$ then $L\\{{e}^{at}f(t)\\}=F(s-a).$ Therefore,\n\n$$\nL\\{{t}^{3}{e}^{2t}\\}=\\frac{6}{(s-2)^{4}}.\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L\\{f(t)\\} & =6L\\{t\\}+4L\\{{t}^{3}{e}^{2t}\\} \\\\  & =6\\cdot \\frac{1}{{s}^{2}}+4\\cdot \\frac{6}{(s-2)^{4}} \\\\  & =\\frac{6}{{s}^{2}}+\\frac{24}{(s-2)^{4}}.\\end{aligned}\n$$\n\nThis transform is valid for $s>2.$"} :step/id #uuid "1ca3e022-cc39-56cd-87c5-f311545581d9"} {:db/id #edb/ref 17592186498616 :step/content {:db/id #edb/ref 17592186221931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f08c7bbb-c2d0-5cc0-bc38-5213764f4024" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-st}\\cdot {e}^{-2t}f(t)" :db/id #edb/ref 17592186390812} {:answer/id #uuid "3d94bd8e-1095-5dca-a3f8-9aaf610978e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-st}\\cdot {e}^{2}f(t)" :db/id #edb/ref 17592186390813} {:answer/id #uuid "28bb7e5b-3455-5522-9000-aba6a7f1eb41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-st}\\cdot {e}^{2t}f(t)" :db/id #edb/ref 17592186390814} {:answer/id #uuid "3a6f9bc4-f8e2-5df6-ba18-334846863668" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{st}\\cdot {e}^{2t}f(t)" :db/id #edb/ref 17592186390815}] :answer-field/correct {:db/id #edb/ref 17592186390814} :answer-field/id #uuid "70e2f98a-16ab-5ff0-97ea-4bd74b0c49aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186390811} {:answer-field/choices [{:answer/id #uuid "65e2db0c-613e-5799-bbf1-d1fd16890715" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "F(s)" :db/id #edb/ref 17592186390817} {:answer/id #uuid "0de35569-0f52-5e9a-9e72-6a51d6ee0586" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "F(s-2)" :db/id #edb/ref 17592186390818} {:answer/id #uuid "4389475f-b93b-5c1b-b101-b0afcf3c492c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "F(s+2)" :db/id #edb/ref 17592186390819}] :answer-field/correct {:db/id #edb/ref 17592186390818} :answer-field/id #uuid "e6bfa42b-b843-5d7d-9658-950091ed7693" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186390816} {:answer-field/choices [{:answer/id #uuid "918e65b1-37a4-57c9-91f8-31e6cedfd3d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{(s+2)t}" :db/id #edb/ref 17592186390821} {:answer/id #uuid "0bc84124-f50e-5d24-b3dd-36e70598d6cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{(s-2)t}" :db/id #edb/ref 17592186390822} {:answer/id #uuid "563f5f3b-f94c-5c9e-9225-6b76c3213e92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-(s+2)t}" :db/id #edb/ref 17592186390823} {:answer/id #uuid "8caaf550-00be-527a-9b74-16e9740ed790" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-(s-2)t}" :db/id #edb/ref 17592186390824}] :answer-field/correct {:db/id #edb/ref 17592186390824} :answer-field/id #uuid "20869d57-2780-5f3e-8816-87767b181302" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186390820} {:answer-field/choices [{:answer/id #uuid "fcb831e6-ab7e-56db-8853-cf8c7142bb92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}" :db/id #edb/ref 17592186390826} {:answer/id #uuid "9a50ffe3-b486-5fce-9a67-a9c4583d6c5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}+2" :db/id #edb/ref 17592186390827} {:answer/id #uuid "3ef90db9-1b5a-5b95-9214-0ce85e84b3f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}-2" :db/id #edb/ref 17592186390828}] :answer-field/correct {:db/id #edb/ref 17592186390827} :answer-field/id #uuid "88721178-9ecd-58e0-9a04-bd9972d88e44" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186390825}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0c13572d-a427-531e-bc5a-c3129ec5167c" :question/math-academy-id "q-328705" :question/problem "Consider a function $f(t)$ such that its Laplace transform is $L\\{f(t)\\}=F(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L\\{{e}^{2t}f(t)\\}.$ Select the correct options in the reasoning below.\n\nBy definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L\\{{e}^{2t}f(t)\\} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,f(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L\\{{e}^{2t}f(t)\\} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{2t}\\,f(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s-2)t}\\,f(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $F(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,f(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s-2)t}\\,f(t)\\,\\text{d}t=F(s-2),\n$$\n\nwhere \n\n$$\ns-2>{s}_{0}\\,⇒\\,s>{s}_{0}+2.\n$$"} :step/id #uuid "2727354f-cd77-55e1-a1d0-cd9c6788d154" :step/next {:db/id #edb/ref 17592186498639}} {:db/id #edb/ref 17592186498627 :step/content {:db/id #edb/ref 17592186498513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17ddf7a6-02de-5357-a0f7-fda2afff17f5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/97/97b2ac07998dea2ba0116ae4b1b26bccdc2c6b2a64d99836578c01d5502c61d2.png" :db/id #edb/ref 17592186497855} {:answer/id #uuid "385d8719-8052-5ba5-93c6-443dbaca8ec8" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/60/6095f8d90e29e62054e66ce058aaf9ef8b592b61a991e7ce9d93b6759d330c7f.png" :db/id #edb/ref 17592186497923} {:answer/id #uuid "38be91b4-49a4-5c7a-9985-97b2fa85e3e3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/fb/fb0bda88019114bf77d68c8c72d164bfa21abc1c10cf0fe52d72b53c1ddbe102.png" :db/id #edb/ref 17592186497924} {:answer/id #uuid "7370344f-b222-597a-9d15-849b3ab68fb2" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ee/ee965e81bc2b44c9d00c08dcd4f227b76c927fb467921e2fac664834b6bb978a.png" :db/id #edb/ref 17592186498074} {:answer/id #uuid "9339d5e1-6245-5bf5-bba6-2750f42458db" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ba/ba6fb6239cc146b1fb5fc31300015984826e4ab1fe4061a0bd14ce3b2643569f.png" :db/id #edb/ref 17592186498134}] :answer-field/correct {:db/id #edb/ref 17592186497855} :answer-field/id #uuid "64110326-a77e-5f76-b890-3c31d6f5dae0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186498404}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2ff7cb38-62cd-5c8f-a2e0-afb3c4fd3adf" :question/math-academy-id "q-332120" :question/problem "![](images/ba/ba6fb6239cc146b1fb5fc31300015984826e4ab1fe4061a0bd14ce3b2643569f.png)\n\nConsider a function $f(t)$ for which the graph of the Laplace transform $L\\{f(t)\\}=F(s)$ is shown above. Which of the following could be the graph of $L\\{{e}^{t}f(t)\\}?$" :question/worked-solution "The first shifting theorem states that if\n$L\\{f(t)\\}=F(s),$\nthen\n$L\\{{e}^{at}f(t)\\}=F(s-a).$\n\nThis implies that multiplying a function $f(t)$ by ${e}^{at}$ shifts the corresponding Laplace transform horizontally along the $s$-axis.\n\n- If $a>0,$ the graph of $F(s)$ shifts to the right.\n\n- If $a<0,$ the graph of $F(s)$ shifts to the left.\n\nIn our case, to get the graph of $L\\{{e}^{t}f(t)\\},$ we must shift the graph of $F(s)$ by $1$ unit to the right.\n\n![](images/97/97b2ac07998dea2ba0116ae4b1b26bccdc2c6b2a64d99836578c01d5502c61d2.png)"} :step/id #uuid "657640d3-5628-5d33-809c-aa5fdbf0b2e4" :step/next {:db/id #edb/ref 17592186498613}} {:db/id #edb/ref 17592186498639 :step/content {:db/id #edb/ref 17592186304980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a729c4-4d54-527d-a93f-3a54c3407e68" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Scale the graph of $F(s)$ by a scale factor of $8$ horizontally." :db/id #edb/ref 17592186302590} {:answer/id #uuid "18dea247-7ffa-5cb9-8234-c442fc60d964" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Scale the graph of $F(s)$ by a scale factor of $8$ vertically." :db/id #edb/ref 17592186302621} {:answer/id #uuid "21cdcb93-5dad-510a-96e8-42da2d959713" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Shift the graph of $F(s)$ by $8$ units to the right." :db/id #edb/ref 17592186302668} {:answer/id #uuid "34be62be-1361-5365-8bef-9d8bbbb458d7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Shift the graph of $F(s)$ by $8$ units to the left." :db/id #edb/ref 17592186302784} {:answer/id #uuid "84d48414-295f-59b5-ab18-a8e9f863808e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The Laplace transform is unchanged." :db/id #edb/ref 17592186303283}] :answer-field/correct {:db/id #edb/ref 17592186302668} :answer-field/id #uuid "44c6a275-2026-5967-a17a-985587e234ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186304266}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f3bbef6f-6296-5a54-8079-8df45d564e16" :question/math-academy-id "q-332063" :question/problem "Consider a function $f(t)$ for which the Laplace transform is $L\\{f(t)\\}=F(s).$ How can we obtain the graph of $L\\{{e}^{8t}f(t)\\}$ from the graph of $F(s)?$" :question/worked-solution "The first shifting theorem states that if\n$L\\{f(t)\\}=F(s),$\nthen\n$L\\{{e}^{at}f(t)\\}=F(s-a).$\n\nThis implies that multiplying a function $f(t)$ by ${e}^{at}$ shifts the corresponding Laplace transform horizontally along the $s$-axis.\n\n- If $a>0,$ the graph of $F(s)$ shifts to the right.\n\n- If $a<0,$ the graph of $F(s)$ shifts to the left.\n\nIn our case, to get the graph of $L\\{{e}^{8t}f(t)\\},$ we must shift the graph of $F(s)$ by $8$ units to the right."} :step/id #uuid "9646d192-bbba-563e-9982-b0be272fde36" :step/next {:db/id #edb/ref 17592186498627}}] :activity/title "The First Shifting Theorem of Laplace Transforms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186497796}]}
