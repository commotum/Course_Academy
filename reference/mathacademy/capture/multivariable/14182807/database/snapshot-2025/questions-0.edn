answer-field/id #uuid "e6bfa42b-b843-5d7d-9658-950091ed7693" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186390816} {:answer-field/choices [{:answer/id #uuid "918e65b1-37a4-57c9-91f8-31e6cedfd3d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{(s+2)t}" :db/id #edb/ref 17592186390821} {:answer/id #uuid "0bc84124-f50e-5d24-b3dd-36e70598d6cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{(s-2)t}" :db/id #edb/ref 17592186390822} {:answer/id #uuid "563f5f3b-f94c-5c9e-9225-6b76c3213e92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-(s+2)t}" :db/id #edb/ref 17592186390823} {:answer/id #uuid "8caaf550-00be-527a-9b74-16e9740ed790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-(s-2)t}" :db/id #edb/ref 17592186390824}] :answer-field/correct {:answer/id #uuid "8caaf550-00be-527a-9b74-16e9740ed790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-(s-2)t}" :db/id #edb/ref 17592186390824} :answer-field/id #uuid "20869d57-2780-5f3e-8816-87767b181302" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186390820} {:answer-field/choices [{:answer/id #uuid "fcb831e6-ab7e-56db-8853-cf8c7142bb92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>{s}_{0}" :db/id #edb/ref 17592186390826} {:answer/id #uuid "9a50ffe3-b486-5fce-9a67-a9c4583d6c5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>{s}_{0}+2" :db/id #edb/ref 17592186390827} {:answer/id #uuid "3ef90db9-1b5a-5b95-9214-0ce85e84b3f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>{s}_{0}-2" :db/id #edb/ref 17592186390828}] :answer-field/correct {:answer/id #uuid "9a50ffe3-b486-5fce-9a67-a9c4583d6c5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s>{s}_{0}+2" :db/id #edb/ref 17592186390827} :answer-field/id #uuid "88721178-9ecd-58e0-9a04-bd9972d88e44" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186390825}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c13572d-a427-531e-bc5a-c3129ec5167c" :question/math-academy-id "q-328705" :question/problem "Consider a function $f(t)$ such that its Laplace transform is $L{f(t)}=F(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L{{e}^{2t}f(t)}.$ Select the correct options in the reasoning below. By definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L{{e}^{2t}f(t)} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,f(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L{{e}^{2t}f(t)} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{2t}\\,f(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s-2)t}\\,f(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $F(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,f(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s-2)t}\\,f(t)\\,\\text{d}t=F(s-2),\n$$\n\nwhere \n\n$$\ns-2>{s}_{0}\\,⇒\\,s>{s}_{0}+2.\n$$"}] [{:db/id #edb/ref 17592186304980 :knowledge-point/_questions [{:db/id #edb/ref 17592186221435 :knowledge-point/id #uuid "7b6ba61d-2e00-539a-84d0-84b63bf92be0" :knowledge-point/title "Identifying Graph Shifts From the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a729c4-4d54-527d-a93f-3a54c3407e68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Scale the graph of $F(s)$ by a scale factor of $8$ horizontally." :db/id #edb/ref 17592186302590} {:answer/id #uuid "18dea247-7ffa-5cb9-8234-c442fc60d964" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Scale the graph of $F(s)$ by a scale factor of $8$ vertically." :db/id #edb/ref 17592186302621} {:answer/id #uuid "21cdcb93-5dad-510a-96e8-42da2d959713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Shift the graph of $F(s)$ by $8$ units to the right." :db/id #edb/ref 17592186302668} {:answer/id #uuid "34be62be-1361-5365-8bef-9d8bbbb458d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Shift the graph of $F(s)$ by $8$ units to the left." :db/id #edb/ref 17592186302784} {:answer/id #uuid "84d48414-295f-59b5-ab18-a8e9f863808e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The Laplace transform is unchanged." :db/id #edb/ref 17592186303283}] :answer-field/correct {:answer/id #uuid "21cdcb93-5dad-510a-96e8-42da2d959713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Shift the graph of $F(s)$ by $8$ units to the right." :db/id #edb/ref 17592186302668} :answer-field/id #uuid "44c6a275-2026-5967-a17a-985587e234ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304266}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3bbef6f-6296-5a54-8079-8df45d564e16" :question/math-academy-id "q-332063" :question/problem "Consider a function $f(t)$ for which the Laplace transform is $L{f(t)}=F(s).$ How can we obtain the graph of $L{{e}^{8t}f(t)}$ from the graph of $F(s)?$" :question/worked-solution "The first shifting theorem states that if\n$L{f(t)}=F(s),$\nthen\n$L{{e}^{at}f(t)}=F(s-a).$\n\nThis implies that multiplying a function $f(t)$ by ${e}^{at}$ shifts the corresponding Laplace transform horizontally along the $s$-axis.\n\n- If $a>0,$ the graph of $F(s)$ shifts to the right.\n\n- If $a<0,$ the graph of $F(s)$ shifts to the left.\n\nIn our case, to get the graph of $L{{e}^{8t}f(t)},$ we must shift the graph of $F(s)$ by $8$ units to the right."}]}
