#{[{:db/id #edb/ref 17592186525994 :knowledge-point/_questions [{:db/id #edb/ref 17592186064307 :knowledge-point/id #uuid "6cc92652-6746-583d-bb0e-53991d5f5e1d" :knowledge-point/title "Differentiating a Function Raised to the Power of X"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43d7666c-76e1-5d2f-89dc-846aee436e07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\operatorname{ln}⁡x)\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+x" :db/id #edb/ref 17592186525378} {:answer/id #uuid "5c26608d-4d8d-54f4-a534-875ba9e6df55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\operatorname{ln}⁡x" :db/id #edb/ref 17592186525441} {:answer/id #uuid "926b968b-b1bc-55e4-8613-842d87321837" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\operatorname{ln}⁡x)\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+1" :db/id #edb/ref 17592186525575} {:answer/id #uuid "a21062c3-c1e3-5c56-9cce-3306bba9d38a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\operatorname{ln}⁡x)\\operatorname{ln}⁡(\\operatorname{ln}⁡2x)" :db/id #edb/ref 17592186525621} {:answer/id #uuid "b2541a74-be37-50bb-bc28-98cea7545cd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\operatorname{ln}⁡x)+\\operatorname{ln}⁡(\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186525660}] :answer-field/correct {:answer/id #uuid "926b968b-b1bc-55e4-8613-842d87321837" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\operatorname{ln}⁡x)\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+1" :db/id #edb/ref 17592186525575} :answer-field/id #uuid "992c6d69-a632-50bb-813e-6c7409f3a143" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525923}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2138c134-850c-51b8-a2e7-dbdcfd2c3d24" :question/math-academy-id "q-138810" :question/problem "Consider the function $y=(\\operatorname{ln}⁡x)^{x}.$ Its derivative is given by \n\n$$\n{y}^{′}=(\\operatorname{ln}⁡x)^{x-1}\\cdot g(x).\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=(\\operatorname{ln}⁡x)^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{ln}⁡x)^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(\\operatorname{ln}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(\\operatorname{ln}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(x)^{′}\\cdot (\\operatorname{ln}⁡(\\operatorname{ln}⁡x))+(x)\\cdot {(\\operatorname{ln}⁡(\\operatorname{ln}⁡x))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =1\\cdot \\operatorname{ln}⁡(\\operatorname{ln}⁡x)+x\\cdot (\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{1}{x}) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{1}{\\operatorname{ln}⁡x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{1}{\\operatorname{ln}⁡x})\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{ln}⁡x)^{x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =(\\operatorname{ln}⁡x)^{x}(\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{1}{\\operatorname{ln}⁡x}) \\\\  & =(\\operatorname{ln}⁡x)^{x}(\\frac{(\\operatorname{ln}⁡x)\\operatorname{ln}⁡(\\operatorname{ln}⁡x)}{\\operatorname{ln}⁡x}+\\frac{1}{\\operatorname{ln}⁡x}) \\\\  & =(\\operatorname{ln}⁡x)^{x-1}((\\operatorname{ln}⁡x)\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+1).\\end{aligned}\n$$\n\n \n\nTherefore, $g(x)=(\\operatorname{ln}⁡x)\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+1.$"}] [{:db/id #edb/ref 17592186526033 :knowledge-point/_questions [{:db/id #edb/ref 17592186064308 :knowledge-point/id #uuid "94a2b8cb-aca4-5e18-bb5c-71c0738c9e30" :knowledge-point/title "Differentiating a Function Raised to the Power of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1852df64-07e6-553a-9474-3688514f45f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡x)+x" :db/id #edb/ref 17592186525255} {:answer/id #uuid "4b094227-bc65-5485-9af0-535c85dfc957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{tan}^{2}⁡x\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡x)+\\operatorname{tan}⁡x" :db/id #edb/ref 17592186525392} {:answer/id #uuid "4df98584-3d9c-5eac-bf56-d2ad321a9f20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡x)+{tan}^{2}⁡x" :db/id #edb/ref 17592186525403} {:answer/id #uuid "c523c99c-0943-5d50-866c-50af7a52bf5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡x)+\\operatorname{tan}⁡x" :db/id #edb/ref 17592186525706} {:answer/id #uuid "ec8fb22c-c2d5-5de9-9ec3-5e0357b772f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x\\,\\operatorname{ln}⁡(\\operatorname{tan}⁡x)+{cot}^{2}⁡x" :db/id #edb/ref 17592186525792}] :answer-field/correct {:answer/id #uuid "4df98584-3d9c-5eac-bf56-d2ad321a9f20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡x)+{tan}^{2}⁡x" :db/id #edb/ref 17592186525403} :answer-field/id #uuid "950df731-b35d-5f11-87f2-48d0011cad1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525922}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6c20f239-ec4b-5508-8032-829af339c105" :question/math-academy-id "q-138841" :question/problem "Consider the function $y=(\\operatorname{sec}⁡x)^{\\operatorname{tan}⁡x}.$ Its derivative is given by\n\n$$\n{y}^{′}=(\\operatorname{sec}⁡x)^{\\operatorname{tan}⁡x}\\cdot g(x).\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=(\\operatorname{sec}⁡x)^{\\operatorname{tan}⁡x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{sec}⁡x)^{\\operatorname{tan}⁡x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{tan}⁡x\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x\\operatorname{ln}⁡(\\operatorname{sec}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(\\operatorname{tan}⁡x)^{′}\\cdot (\\operatorname{ln}⁡(\\operatorname{sec}⁡x))+(\\operatorname{tan}⁡x)\\cdot {(\\operatorname{ln}⁡(\\operatorname{sec}⁡x))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & ={sec}^{2}⁡x\\cdot \\operatorname{ln}⁡(\\operatorname{sec}⁡x)+\\operatorname{tan}⁡x\\cdot (\\frac{1}{\\operatorname{sec}⁡x}\\cdot \\operatorname{tan}⁡x\\,\\operatorname{sec}⁡x) \\\\ \\frac{{y}^{′}}{y} & ={sec}^{2}⁡x\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡x)+{tan}^{2}⁡x\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y({sec}^{2}⁡x\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡x)+{tan}^{2}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{sec}⁡x)^{\\operatorname{tan}⁡x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =(\\operatorname{sec}⁡x)^{\\operatorname{tan}⁡x}({sec}^{2}⁡x\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡x)+{tan}^{2}⁡x)\\end{aligned}\n$$\n\nTherefore, $g(x)={sec}^{2}⁡x\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡x)+{tan}^{2}⁡x.$"}] [{:db/id #edb/ref 17592186495050 :knowledge-point/_questions [{:db/id #edb/ref 17592186064307 :knowledge-point/id #uuid "6cc92652-6746-583d-bb0e-53991d5f5e1d" :knowledge-point/title "Differentiating a Function Raised to the Power of X"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f14cc015-61de-559e-9d6e-4f7e934ed9c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln(2x)+1" :db/id #edb/ref 17592186494890}] :answer-field/correct {:answer/id #uuid "f14cc015-61de-559e-9d6e-4f7e934ed9c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln(2x)+1" :db/id #edb/ref 17592186494890} :answer-field/id #uuid "a47a029c-812d-5ac8-b753-06da557530dc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186494995}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "02602311-35ef-53b7-9d8d-d64db15f3075" :question/math-academy-id "q-341724" :question/problem "Given that $y={(\\frac{1}{2x})}^{x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=-{(2x)}^{-x}\\cdot ($\n{{field-1}}$)$" :question/worked-solution "We have the function \n\n$$\ny={(\\frac{1}{2x})}^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({(\\frac{1}{2x})}^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(\\frac{1}{2x})\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(\\frac{1}{2x})) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(x)^{′}\\cdot (\\operatorname{ln}⁡(\\frac{1}{2x}))+(x)\\cdot {(\\operatorname{ln}⁡(\\frac{1}{2x}))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =1\\cdot \\operatorname{ln}⁡(\\frac{1}{2x})+x\\cdot ((2x)\\cdot (-\\frac{2}{(2x)^{2}})) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡(\\frac{1}{2x})-1 \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡1-\\operatorname{ln}⁡(2x)-1 \\\\ \\frac{{y}^{′}}{y} & =-(\\operatorname{ln}⁡(2x)+1)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =-y(\\operatorname{ln}⁡(2x)+1)\\end{aligned}\n$$\n\nFinally, we substitute $y={(\\frac{1}{2x})}^{x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =-{(\\frac{1}{2x})}^{x}(\\operatorname{ln}⁡(2x)+1) \\\\  & =-{(2x)}^{-x}\\cdot (\\operatorname{ln}⁡(2x)+1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526080 :knowledge-point/_questions [{:db/id #edb/ref 17592186064307 :knowledge-point/id #uuid "6cc92652-6746-583d-bb0e-53991d5f5e1d" :knowledge-point/title "Differentiating a Function Raised to the Power of X"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50609b1c-20c3-5c9e-b651-ed00026d39e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(-7x)+1" :db/id #edb/ref 17592186525413}] :answer-field/correct {:answer/id #uuid "50609b1c-20c3-5c9e-b651-ed00026d39e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(-7x)+1" :db/id #edb/ref 17592186525413} :answer-field/id #uuid "d684987d-da0e-5a34-884e-9b8cf8692f4f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186525952}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce37fb31-a1bc-569c-81f3-e2b336f102ef" :question/math-academy-id "q-341726" :question/problem "Given that $y=(-7x)^{x}$, find ${y}^{′}.$\n\n${y}^{′}=(-7x)^{x}\\cdot ($\n{{field-1}}$)$" :question/worked-solution "We have the function \n\n$$\ny=(-7x)^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((-7x)^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(-7x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(-7x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(x)^{′}\\cdot (\\operatorname{ln}⁡(-7x))+(x)\\cdot {(\\operatorname{ln}⁡(-7x))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =1\\cdot \\operatorname{ln}⁡(-7x)+x\\cdot (\\frac{1}{-7x}\\cdot (-7)) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡(-7x)+1\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\operatorname{ln}⁡(-7x)+1)\\end{aligned}\n$$\n\nFinally, we substitute $y=(-7x)^{x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =(-7x)^{x}\\cdot (\\operatorname{ln}⁡(-7x)+1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526084 :knowledge-point/_questions [{:db/id #edb/ref 17592186064308 :knowledge-point/id #uuid "94a2b8cb-aca4-5e18-bb5c-71c0738c9e30" :knowledge-point/title "Differentiating a Function Raised to the Power of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c4aac3a-edbd-57ca-940b-81a54ff89341" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186525443}] :answer-field/correct {:answer/id #uuid "5c4aac3a-edbd-57ca-940b-81a54ff89341" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186525443} :answer-field/id #uuid "a3103677-824b-5b24-a53b-8724b60d9376" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186525928}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d653dfc3-332e-578a-824c-24d06ec11b4f" :question/math-academy-id "q-341944" :question/problem "Find the slope $m$ of the tangent line to the curve $y={(\\frac{2}{x})}^{{x}^{2}}$ at $x=2.$\n\n$m=$\n{{field-1}}" :question/worked-solution "The slope of the tangent to the curve at $x=2$ equals the function's derivative at the corresponding point.\n\nWe have the function \n\n$$\ny={(\\frac{2}{x})}^{{x}^{2}}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({(\\frac{2}{x})}^{{x}^{2}}) \\\\ \\operatorname{ln}⁡y & ={x}^{2}\\,\\operatorname{ln}⁡(\\frac{2}{x})\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}\\,\\operatorname{ln}⁡(\\frac{2}{x})) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =({x}^{2})^{′}\\cdot (\\operatorname{ln}⁡(\\frac{2}{x}))+({x}^{2})\\cdot {(\\operatorname{ln}⁡(\\frac{2}{x}))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2x\\cdot \\operatorname{ln}⁡(\\frac{2}{x})+{x}^{2}\\cdot (-\\frac{1}{x}) \\\\ \\frac{{y}^{′}}{y} & =2x\\operatorname{ln}⁡(\\frac{2}{x})-x \\\\ \\frac{{y}^{′}}{y} & =x(2\\operatorname{ln}⁡(\\frac{2}{x})-1)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =xy(2\\operatorname{ln}⁡(\\frac{2}{x})-1)\\end{aligned}\n$$\n\nFinally, we substitute $y={(\\frac{2}{x})}^{{x}^{2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =x{(\\frac{2}{x})}^{{x}^{2}}(2\\operatorname{ln}⁡(\\frac{2}{x})-1)\\end{aligned}\n$$\n\nTherefore, the slope of $y={(\\frac{2}{x})}^{{x}^{2}}$ at $x=2$ is\n\n$$\n\\begin{aligned}m={y}^{′}{|}_{x=2} & =(2){(\\frac{2}{2})}^{(2)^{2}}(2\\operatorname{ln}⁡(\\frac{2}{2})-1) \\\\  & =2(2\\operatorname{ln}⁡(1)-1) \\\\  & =-2.\\end{aligned}\n$$"}]}
