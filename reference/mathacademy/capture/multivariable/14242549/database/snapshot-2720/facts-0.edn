}_{2}(t)\\},$ and $[q(t)]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix},$ then ${x}_{1}+{x}_{2}=$" #edb/ref 17592186045443] [17592186360540 #edb/ref 1072 #uuid "fd8162f1-9125-55c3-8d42-af30755391ab" #edb/ref 17592186045417] [17592186360540 #edb/ref 1074 "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t)=q(t)\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}(2+t)+{x}_{2}(1-{t}^{2}) & =2+3t+4{t}^{2} \\\\ (2{x}_{1}+{x}_{2})+{x}_{1}t-{x}_{2}{t}^{2} & =2+3t+4{t}^{2}.\\end{aligned}\n$$\n\nEquating the coefficients of $t$, we obtain\n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}+{x}_{2} &=2 \\\\ {x}_{1} &=3 \\\\ -{x}_{2} &=4.\\end{aligned}\\right.\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=\\begin{bmatrix}2 & 1 & 2 \\\\ 1 & 0 & 3 \\\\ 0 & -1 & 4\\end{bmatrix}.\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & \\begin{bmatrix}2 & 1 & 2 \\\\ 1 & 0 & 3 \\\\ 0 & -1 & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{1}{2}){R}_{1} \\\\ ∼ & \\begin{bmatrix}2 & 1 & 2 \\\\ 0 & -\\frac{1}{2} & 2 \\\\ 0 & -1 & 4\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\ ∼ & \\begin{bmatrix}2 & 1 & 2 \\\\ 0 & -\\frac{1}{2} & 2 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}2{x}_{1}+{x}_{2} &=2 \\\\ -\\frac{1}{2}{x}_{2} &=2.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get ${x}_{2}=-4.$ Substituting this into the first equation, we obtain\n\n$$\n2{x}_{1}+(-4)=2\\,⟹\\,{x}_{1}=3.\n$$\n\nTherefore, $[q(t)]_{B}=\\begin{bmatrix}3 \\\\ -4\\end{bmatrix}.$\n\nFinally, ${x}_{1}+{x}_{2}=3+(-4)=-1.$" #edb/ref 17592186045443] [17592186360542 #edb/ref 1068 #edb/ref 17592186360435 #edb/ref 17592186045417] [17592186360542 #edb/ref 1069 "q-95030" #edb/ref 17592186045417] [17592186360542 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186360542 #edb/ref 1071 "Consider the following polynomials:\n\n$$\n{p}_{1}(t)=2{t}^{2}+t-2,\\,{p}_{2}(t)={t}^{2}+3t-6,\\,{p}_{3}(t)=-2{t}^{3}+3{t}^{2},\\,\\,q(t)=-2{t}^{3}+4{t}^{2}+3t-6.\n$$\n\nIf $B=\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\}$ is a basis of $\\text{Span}\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\},$ and $[q(t)]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix},$ then ${x}_{2}=$" #edb/ref 17592186045443] [17592186360542 #edb/ref 1072 #uuid "d482ef0a-c05c-5115-aa27-a3051b991631" #edb/ref 17592186045417] [17592186360542 #edb/ref 1074 "We need to find ${x}_{1},{x}_{2}$ and ${x}_{3}$ such that \n\n$$\n{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t)+{x}_{3}{p}_{3}(t)=q(t).\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}(2{t}^{2}+t-2)+{x}_{2}({t}^{2}+3t-6)+{x}_{3}(-2{t}^{3}+3{t}^{2}) & =-2{t}^{3}+4{t}^{2}+3t-6 \\\\ -2{x}_{3}{t}^{3}+(2{x}_{1}+{x}_{2}+3{x}_{3}){t}^{2}+({x}_{1}+3{x}_{2})t+(-2{x}_{1}-6{x}_{2}) & =-2{t}^{3}+4{t}^{2}+3t-6.\\end{aligned}\n$$\n\nEquating the coefficients of $t$, we obtain\n\n$$\n\\left\\{\\begin{aligned}-2{x}_{3} &=-2 \\\\ 2{x}_{1}+{x}_{2}+3{x}_{3} &=4 \\\\ {x}_{1}+3{x}_{2} &=3 \\\\ -2{x}_{1}-6{x}_{2} &=-6.\\end{aligned}\\right.\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=\\begin{bmatrix}0 & 0 & -2 & -2 \\\\ 2 & 1 & 3 & 4 \\\\ 1 & 3 & 0 & 3 \\\\ -2 & -6 & 0 & -6\\end{bmatrix}.\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & \\begin{bmatrix}0 & 0 & -2 & -2 \\\\ 2 & 1 & 3 & 4 \\\\ 1 & 3 & 0 & 3 \\\\ -2 & -6 & 0 & -6\\end{bmatrix} &  & {R}_{1}↔{R}_{3} \\\\ ∼ & \\begin{bmatrix}1 & 3 & 0 & 3 \\\\ 2 & 1 & 3 & 4 \\\\ 0 & 0 & -2 & -2 \\\\ -2 & -6 & 0 & -6\\end{bmatrix} &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ {R}_{4}:={R}_{4}+2{R}_{1}\\end{aligned} \\\\ ∼ & \\begin{bmatrix}1 & 3 & 0 & 3 \\\\ 0 & -5 & 3 & -2 \\\\ 0 & 0 & -2 & -2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+3{x}_{2} &=3 \\\\ -5{x}_{2}+3{x}_{3} &=-2 \\\\ -2{x}_{3} &=-2.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get ${x}_{3}=1.$ Substituting this into the second equation, we get\n\n$$\n-5{x}_{2}+3\\cdot 1=-2\\,⟹\\,{x}_{2}=1.\n$$\n\nNow, substituting the obtained values into the first equation, we get\n\n$$\n{x}_{1}+3\\cdot 1=3\\,⟹\\,{x}_{1}=0.\n$$\n\nTherefore, $[q(t)]_{B}=\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix},$ and therefore ${x}_{2}=1.$" #edb/ref 17592186045443] [17592186360543 #edb/ref 1068 #edb/ref 17592186360250 #edb/ref 17592186045417] [17592186360543 #edb/ref 1069 "q-95031" #edb/ref 17592186045417] [17592186360543 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186360543 #edb/ref 1071 "Consider the following polynomials:\n\n$$\n{p}_{1}(t)=-{t}^{3}+{t}^{2}+t,\\,{p}_{2}(t)=2{t}^{2}+4,\\,{p}_{3}(t)=3{t}^{3}-{t}^{2}-3t+3,\\,\\,q(t)=-1.\n$$\n\nIf $B={{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)}$ is a basis of $\\text{Span}{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)},$ and $[q(t)]_{B}=\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix},$ then ${x}_{3}=$" #edb/ref 17592186045443] [17592186360543 #edb/ref 1072 #uuid "03ea170e-d874-5ba1-a4f2-de4db0ee9679" #edb/ref 17592186045417] [17592186360543 #edb/ref 1074 "We need to find ${x}_{1},{x}_{2}$ and ${x}_{3}$ such that \n\n$$\n{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t)+{x}_{3}{p}_{3}(t)=q(t).\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}(-{t}^{3}+{t}^{2}+t)+{x}_{2}(2{t}^{2}+4)+{x}_{3}(3{t}^{3}-{t}^{2}-3t+3) & =-1 \\\\ (-{x}_{1}+3{x}_{3}){t}^{3}+({x}_{1}+2{x}_{2}-{x}_{3}){t}^{2}+({x}_{1}-3{x}_{3})t+(4{x}_{2}+3{x}_{3}) & =-1.\\end{aligned}\n$$\n\nEquating the coefficients of $t$, we obtain\n\n$$\n\\left\\{\\begin{aligned}-{x}_{1}+3{x}_{3} &=0 \\\\ {x}_{1}+2{x}_{2}-{x}_{3} &=0 \\\\ {x}_{1}-3{x}_{3} &=0 \\\\ 4{x}_{2}+3{x}_{3} &=-1.\\end{aligned}\\right.