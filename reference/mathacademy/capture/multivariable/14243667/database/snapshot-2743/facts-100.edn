b/ref 17592186045417] [17592186562433 #edb/ref 1072 #uuid "4de28170-b86e-539e-8022-1a0054f8d5b3" #edb/ref 17592186045417] [17592186562433 #edb/ref 1074 "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=[\\begin{aligned}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{aligned}].\n$$\n\nIn this case, we have $f(x)=\\operatorname{sin}⁡3x,$ $n=2,$ and $\\lambda =\\frac{\\pi }{6}.$\n\nSince $n=2,$ we need to compute the first $2-1=1$ derivative of $f:$\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{sin}⁡3x \\\\ {f}^{′}(x) & =3\\operatorname{cos}⁡3x\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f({J}_{2}(\\frac{\\pi }{6})) & =[\\begin{aligned}f(\\frac{\\pi }{6}) & {f}^{′}(\\frac{\\pi }{6}) \\\\ 0 & f(\\frac{\\pi }{6})\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡(\\frac{\\pi }{2}) & 3\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\ 0 & \\operatorname{sin}⁡(\\frac{\\pi }{2})\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186562436 #edb/ref 1068 #edb/ref 17592186562244 #edb/ref 17592186045417] [17592186562436 #edb/ref 1068 #edb/ref 17592186562313 #edb/ref 17592186045417] [17592186562436 #edb/ref 1068 #edb/ref 17592186562342 #edb/ref 17592186045417] [17592186562436 #edb/ref 1068 #edb/ref 17592186562349 #edb/ref 17592186045417] [17592186562436 #edb/ref 1068 #edb/ref 17592186562356 #edb/ref 17592186045417] [17592186562436 #edb/ref 1069 "q-253868" #edb/ref 17592186045417] [17592186562436 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186562436 #edb/ref 1071 "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | {{field-1}} | {{field-2}} | $0$ |  |\n| --- | --- | --- | --- | --- | --- |\n| $\\operatorname{ln}⁡({J}_{2}(2)\\,⊕\\,{J}_{1}(2))=\\,\\,$ |  | $0$ | {{field-3}} | {{field-4}} |  |\n|  |  | $0$ | $0$ | {{field-5}} |  |" #edb/ref 17592186045417] [17592186562436 #edb/ref 1072 #uuid "59f14881-731e-52d2-9146-dab6e581e8a4" #edb/ref 17592186045417] [17592186562436 #edb/ref 1074 "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=[\\begin{aligned}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{aligned}].\n$$\n\nFirst, note that\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({J}_{2}(2)\\,⊕\\,{J}_{1}(2)) & =\\operatorname{ln}⁡([\\begin{aligned}{J}_{2}(2) & 0 \\\\ 0 & {J}_{1}(2)\\end{aligned}]) \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡({J}_{2}(2)) & 0 \\\\ 0 & \\operatorname{ln}⁡({J}_{1}(2))\\end{aligned}] \\\\  & =\\operatorname{ln}⁡({J}_{2}(2))\\,⊕\\,\\operatorname{ln}⁡({J}_{1}(2)).\\end{aligned}\n$$\n\nSo, we compute the function of each Jordan block separately.\n\n- For ${J}_{2}(2),$ we have $n=2$ and $\\lambda =2.$ \\since $n=2,$ we need to compute the first derivative of $f$ only:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡x \\\\ {f}^{′}(x) & =\\frac{1}{x}\\end{aligned}\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}f({J}_{2}(2)) & =[\\begin{aligned}f(2) & {f}^{′}(2) \\\\ 0 & f(2)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡(2) & \\frac{1}{2} \\\\ 0 & \\operatorname{ln}⁡(2)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡2 & \\frac{1}{2} \\\\ 0 & \\operatorname{ln}⁡2\\end{aligned}].\\end{aligned}\n$$\n\n- For ${J}_{1}(2),$ we have $n=1$ and $\\lambda =1.$ \\since $n=1,$ we don't need any derivatives. So, we get\n\n$$\n\\begin{aligned}f({J}_{1}(2)) & =[\\begin{aligned}f(2)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({J}_{2}(2)\\,⊕\\,{J}_{1}(2)) & =\\operatorname{ln}⁡({J}_{2}(2))\\,⊕\\,\\operatorname{ln}⁡({J}_{1}(2)) \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡2 & \\frac{1}{2} & 0 \\\\ 0 & \\operatorname{ln}⁡2 & 0 \\\\ 0 & 0 & \\operatorname{ln}⁡2\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186562471 #edb/ref 1068 #edb/ref 17592186562308 #edb/ref 17592186045417] [17592186562471 #edb/ref 1069 "q-253490" #edb/ref 17592186045417] [17592186562471 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186562471 #edb/ref 1071 "Consider the following matrices:\n\n$$\nE=[\\begin{aligned}\\frac{\\pi }{6} & 0 \\\\ \\frac{5\\pi }{6} & \\pi \\end{aligned}],\\,D=[\\begin{aligned}\\frac{\\pi }{6} & 0 \\\\ 0 & \\pi \\end{aligned}],\\,P=[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}]\n$$\n\nGiven that $E=PD{P}^{-1},$ find $4\\operatorname{sin}⁡E.$" #edb/ref 17592186045417] [17592186562471 #edb/ref 1072 #uuid "a906d22b-042f-5736-a4c7-747a5da98697" #edb/ref 17592186045417] [17592186562471 #edb/ref 1074 "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)=4\\operatorname{sin}⁡E$ and the given matrix $C,$ we have\n\n$$\n4\\operatorname{sin}⁡E=4\\operatorname{sin}⁡(PD{P}^{-1})=P\\cdot (4\\operatorname{sin}⁡D)\\cdot {P}^{-1}.\n$$\n\nNow, since $D$ is a diagonal matrix, we get\n\n$$\n4\\operatorname{sin}⁡D=[\\begin{aligned}4\\operatorname{sin}⁡\\frac{\\pi }{6} & 0 \\\\ 0 & 4\\operatorname{sin}⁡\\pi \\end{aligned}]=[\\begin{aligned}2 & 0 \\\\ 0 & 0\\end{aligned}].\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{1}{1\\cdot 1-(-1)\\cdot 0}[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}].\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}4\\operatorname{sin}⁡E & =P\\cdot (4\\operatorname{sin}⁡D)\\cdot {P}^{-1} \\\\  & =[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 0 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 \\\\ -2 & 0\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186562523 #edb/ref 1058 #edb/ref 17592186562590 #edb/ref 17592186045417] [17592186562523 #edb/ref 1062 #uuid "0d997c1c-41dc-5f0e-8700-8effc36c61a0" #edb/ref 17592186045417] [17592186562523 #edb/ref 1063 #edb/ref 17592186562433 #edb/ref 17592186045417] [17592186562561 #edb/ref 1062 #uuid "9fb7473a-f50c-59df-bf1d-901518b8d010" #edb/ref 17592186045417] [17592186562561 #edb/ref 1063 #edb/ref 17592186292563 #edb/ref 17592186045417] [17592186562569 #edb/ref 1058 #edb/ref 17592186562561 #edb/ref 17592186045417] [17592186562569 #edb/ref 1062 #uuid "c506d920-1260-5365-83c3-6c1afb0675bd" #edb/ref 17592186045417] [17592186562569 #edb/ref 1063 #edb/ref 17592186562436 #edb/ref 17592186045417] [17592186562589 #edb/ref 1058 #edb/ref 17592186562569 #edb/ref 17592186045417] [17592186562589 #edb/ref 1062 #uuid "f42ad29f-f73d-564b-901a-6ddffb056cf2" #edb/ref 17592186045417] [17592186562589 #edb/ref 1063 #edb/ref 17592186562471 #edb/ref 17592186045417] [17592186562590 #edb/ref 1058 #edb/ref 17592186562589 #edb/ref 17592186045417] [17592186562590 #edb/ref 1062 #uuid "f9a607f6-7ee9-5677-aff5-e2fc7e69a8d8" #edb/ref 17592186045417] [17592186562590 #edb/ref 1063 #edb/ref 17592186414006 #edb/ref 17592186045417]}
