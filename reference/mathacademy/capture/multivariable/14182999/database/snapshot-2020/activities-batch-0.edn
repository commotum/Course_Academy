 :db/id #edb/ref 17592186497168} {:answer/id #uuid "f914fa50-6ac0-566e-b1a1-d5f660016346" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{\\{0,10\\},\\{2\\},\\{4,8,10\\}\\}" :db/id #edb/ref 17592186497192}] :answer-field/correct {:db/id #edb/ref 17592186496901} :answer-field/id #uuid "50e0add4-d87e-54cf-8530-185be76bcd24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186417770}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "84e33efb-d3f8-5005-acd9-dce160c0ccce" :question/math-academy-id "q-105882" :question/problem "If $T=\\{0,2,4,6,8,10\\}$, which collection of subsets of $T$ is a partition of $T?$" :question/worked-solution "A partition of a set $T$ is a collection of non-empty subsets of $T$ where every element of $T$ is contained in *exactly* one subset. \n\nOf the given collections, only $\\{\\{0,10\\},\\{2,4,6,8\\}\\}$ is a partition.\n\nThe rest of the collections are not partitions:\n\n- $\\{∅,\\{0,2,4,6,8\\},\\{10\\}\\}$ is not a partition because the subset $∅$ is empty.\n\n- $\\{\\{0,2,4,6,8,10,12\\}\\}$ is not a partition because the element $12$ does not appear in $T.$\n\n- $\\{\\{0,10\\},\\{2\\},\\{4,8\\}\\}$ is not a partition because the element $6\\in T$ does not appear in any subset.\n\n- $\\{\\{0,10\\},\\{2,4,6,8,10\\}\\}$ is not a partition because the element $10$ appears in two subsets."} :step/id #uuid "025155ed-e631-51d6-8fbb-0261ad6d7342"} {:db/id #edb/ref 17592186417780 :step/content {:db/id #edb/ref 17592186417777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44c57e8f-4486-5f7b-85fa-61640814a9db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∅,{f,g,h,i},{j,k,l}}" :db/id #edb/ref 17592186417748} {:answer/id #uuid "4fe8e4e3-7632-5fc6-8a3a-d2607c8963e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{{f,g,h},{h,i},{h,j,f,k,l}}" :db/id #edb/ref 17592186417750} {:answer/id #uuid "61365f38-12f9-5fa4-ad30-c4d9eaddc4b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{{f,g,h},{k,l}}" :db/id #edb/ref 17592186417752} {:answer/id #uuid "a86b6eaa-c2fb-5f2b-ae3f-a1b13df985c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{∅,{f},{g,h,i},{j,k,l}}" :db/id #edb/ref 17592186417761} {:answer/id #uuid "c75fc6b4-232d-5783-9c87-677907d0d253" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{{f,g,h},{i},{j,k,l}}" :db/id #edb/ref 17592186417764}] :answer-field/correct {:db/id #edb/ref 17592186417764} :answer-field/id #uuid "4f26576b-50b8-5584-87f0-b8bbd2b70b18" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186417769}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ec641cad-eaa5-5110-9da2-21a5ecc5614d" :question/math-academy-id "q-81136" :question/problem "If $X={f,g,h,i,j,k,l},$ which collection of subsets of $X$ is a partition of $X?$" :question/worked-solution "A partition of a set $X$ is a collection of non-empty subsets of $X$ where every element of $X$ is contained in *exactly* one subset. \n\nOf the given collections, only ${{f,g,h},{i},{j,k,l}}$ is a partition.\n\nThe rest of the collections are not partitions:\n\n- ${∅,{f,g,h,i},{j,k,l}}$ is not a partition because the subset $∅$ is empty.\n\n- ${∅,{f},{g,h,i},{j,k,l}}$ is not a partition because the subset $∅$ is empty.\n\n- ${{f,g,h},{h,i},{h,j,f,k,l}}$ is not a partition because the elements $f$ and $h$ appear in multiple subsets.\n\n- ${{f,g,h},{k,l}}$ is not a partition because the elements $i,j\\in X$ do not appear in any subset."} :step/id #uuid "1e08db77-0313-5dd5-a56e-896fb1edf300" :step/next {:db/id #edb/ref 17592186417779}} {:db/id #edb/ref 17592186417781 :step/content {:db/id #edb/ref 17592186417776 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d44e59f-200c-5c35-bd87-7f6c362b8c9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{\\{-2,-1\\},\\{-1,1\\},\\{0\\}\\}" :db/id #edb/ref 17592186496720} {:answer/id #uuid "1ee58b09-fe58-571a-bb81-5e5880123a06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{∅,\\{-2,-1\\},\\{0,1,2\\}\\}" :db/id #edb/ref 17592186496725} {:answer/id #uuid "90833dac-b8c2-56dd-8766-a7ba68594a80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{\\{-2,-1\\},\\{-1,0\\},\\{1,2\\}\\}" :db/id #edb/ref 17592186496959} {:answer/id #uuid "9748f50c-5647-5d5e-9e0f-a158875d7f00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{\\{-2,0\\},\\{-1,1\\},\\{2\\}\\}" :db/id #edb/ref 17592186496975} {:answer/id #uuid "e919aacf-dea4-501f-8011-a0194d2623c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{\\{-2,-1,0\\},\\{-2,2\\},\\{-2,1\\},\\{-1,0\\}\\}" :db/id #edb/ref 17592186497156}] :answer-field/correct {:db/id #edb/ref 17592186496975} :answer-field/id #uuid "e9ddadac-650e-54de-9a1d-e42d954b6e57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186417773}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9baec781-6727-5070-ba93-d0e0e2886415" :question/math-academy-id "q-1277" :question/problem "If $B=\\{-2,-1,0,1,2\\}$, which collection of subsets of $B$ is a partition of $B?$" :question/worked-solution "A partition of a set $B$ is a collection of non-empty subsets of $B$ where every element of $B$ is contained in *exactly* one subset. \n\nOf the given collections, only $\\{\\{-2,0\\},\\{-1,1\\},\\{2\\}\\}$ is a partition.\n\nThe rest of the collections are not partitions:\n\n- $\\{\\{-2,-1\\},\\{-1,1\\},\\{0\\}\\}$ is not a partition because the element $-1$ appears in two subsets.\n\n- $\\{\\{-2,-1\\},\\{-1,0\\},\\{1,2\\}\\}$ is not a partition because the element $-1$ appears in two subsets.\n\n- $\\{\\{-2,-1,0\\},\\{-2,2\\},\\{-2,1\\},\\{-1,0\\}\\}$ is not a partition because the elements $-2,$ $-1$ and $0$ appear in multiple subsets.\n\n- $\\{∅,\\{-2,-1\\},\\{0,1,2\\}\\}$  is not a partition because the subset $∅$ is empty."} :step/id #uuid "7c0a77fc-c624-53c0-95fb-abf597abec71" :step/next {:db/id #edb/ref 17592186417783}} {:db/id #edb/ref 17592186417782 :step/content {:db/id #edb/ref 17592186417778 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2141e768-95bf-5d32-9adc-e299b73ddded" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{{40,44,48,…,76},{80,84,88,…,92},{96,100,104,…,140}}" :db/id #edb/ref 17592186417744} {:answer/id #uuid "2c45cd19-dcfb-553b-a379-3f1258f962cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{{40,44,48,…,72},{104,108,112,…,140}}" :db/id #edb/ref 17592186417745} {:answer/id #uuid "b74b3a5d-4ac9-5479-b2b9-2d6261556f4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{{40,44,48,…,84},{56,60,64,…,140}}" :db/id #edb/ref 17592186417762} {:answer/id #uuid "c71aa468-40db-5b97-a1c1-5d40d61068b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{{24,28,32,…,140}}" :db/id #edb/ref 17592186417763} {:answer/id #uuid "fd408071-6beb-54a4-bfb8-fcb7d69d53b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{{40,44,48,52},{53,54,55,…,140}}" :db/id #edb/ref 17592186417768}] :answer-field/correct {:db/id #edb/ref 17592186417744} :answer-field/id #uuid "d810591c-e7e6-5a18-813c-ec27c24b6584" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186417772}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fc7c0eb0-4d42-5938-af4f-77dd05abbdb7" :question/math-academy-id "q-81134" :question/problem "If $E={40,44,48,…,140},$ which collection of subsets of $E$ is a partition of $E?$" :question/worked-solution "A partition of a set $E$ is a collection of non-empty subsets of $E$ where every element of $E$ is contained in *exactly* one subset. \n\nOf the given collections, only ${{40,44,48,…,76},{80,84,88,…,92},{96,100,104,…,140}}$ is a partition.\n\nThe rest of the collections are not partitions:\n\n- ${{40,44,48,…,72},{104,108,112,…,140}}$ is not a partition because many elements of $E$ (such as $96$) do not appear in any subsets.\n\n- ${{40,44,48,…,84},{56,60,64,…,140}}$ is not a partition because many elements (such as $56$) appear in both subsets.\n\n- ${{24,28,32,…,140}}$ is not a partition because it contains many elements (such as $28$) that do not appear in $E.$\n\n- ${{40,44,48,52},{53,54,55,…,140}}$ is not a partition because it contains many elements (such as $53$) that do not appear in $E.$"} :step/id #uuid "95af4ddd-1334-5fc0-8e14-ac018a7299ac" :step/next {:db/id #edb/ref 17592186417780}} {:db/id #edb/ref 17592186417783 :step/content {:db/id #edb/ref 17592186417774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5aa759dd-5b09-57af-8099-171ff4cbcde8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{\\{2,4,6,…,180\\}\\}" :db/id #edb/ref 17592186496854} {:answer/id #uuid "90fb221a-f525-5551-a4e2-e7ab19047d2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{\\{20,22,24,…,60\\},\\{62,64,66,…,120\\},\\{122,124,126,…,180\\}\\}" :db/id #edb/ref 17592186496961} {:answer/id #uuid "a1b65d64-7626-5243-8360-4705024e70ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{\\{20,22,24,…,80\\},\\{66,68,70,…,180\\}\\}" :db/id #edb/ref 17592186496994} {:answer/id #uuid "a58aef66-b4ae-59a0-a9df-95a3da99f424" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{\\{20,22,24,26\\},\\{27,28,29,…,180\\}\\}" :db/id #edb/ref 17592186496998} {:answer/id #uuid "c962addc-6fe6-5b22-82f1-c219761dcdc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{\\{20,22,24,…,70\\},\\{140,142,144,…,180\\}\\}" :db/id #edb/ref 17592186497073}] :answer-field/correct {:db/id #edb/ref 17592186496961} :answer-field/id #uuid "5fc4c085-a9cd-5c46-8659-2b2aae5381a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186417771}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2504f101-1688-516e-9a69-2239c6d88288" :question/math-academy-id "q-81133" :question/problem "If $Y=\\{20,22,24,…,180\\},$ which collection of subsets of $Y$ is a partition of $Y?$" :question/worked-solution "A partition of a set $Y$ is a collection of non-empty subsets of $Y$ where every element of $Y$ is contained in *exactly* one subset. \n\nOf the given collections, only $\\{\\{20,22,24,…,60\\},\\{62,64,66,…,120\\},\\{122,124,126,…,180\\}\\}$ is a partition.\n\nThe rest of the collections are not partitions:\n\n- $\\{\\{20,22,24,…,70\\},\\{140,142,144,…,180\\}\\}$ is not a partition because some elements of $Y,$ such as $72,74,…,138,$ do not appear in any subsets.\n\n- $\\{\\{20,22,24,…,80\\},\\{66,68,70,…,180\\}\\}$ is not a partition because the elements $66,68,…,80$ appear in both subsets.\n\n- $\\{\\{2,4,6,…,180\\}\\}$ is not a partition because it contains many elements, such as $2,4,…,20,$ that do not appear in $Y.$\n\n- $\\{\\{20,22,24,26\\},\\{27,28,29,…,180\\}\\}$ is not a partition because it contains many elements, such as $27$ and $29,$ that do not appear in $Y.$"} :step/id #uuid "c106e6f5-6822-55e3-8c4c-f3497d4f456c" :step/next {:db/id #edb/ref 17592186417782}}] :activity/title "Partitions of Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186417743}]}
