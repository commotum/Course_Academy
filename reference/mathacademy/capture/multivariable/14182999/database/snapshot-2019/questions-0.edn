#{[{:db/id #edb/ref 17592186059615 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059812 :knowledge-point/id #uuid "1b082a95-4d6e-512f-a6ed-9100498d17c8" :knowledge-point/title "Identifying Partitions"}] :question/id #uuid "6e647031-a93a-54b7-8b39-c6d3779a48ab" :question/math-academy-id "e-7008" :question/problem "If $X = \\{ a, b, c, d, e, f, g \\},$ which of the following collections of subsets of $X$ are partitions of $X?$\n\n- $\\{ a, b, \\{ c,d,e \\}, \\{ f,g \\} \\}$\n\n- $\\{ \\{ a, b, c \\}, \\{ d,e,f \\}, \\{ g \\} \\}$\n\n- $\\{ \\emptyset, \\{ a,b,c \\}, \\{ f,g \\} \\}$" :question/worked-solution "A partition of a set $X$ is a collection of non-empty subsets of $X$ where every element of $X$ is contained in *exactly* one subset. \n\nWith that in mind, let's inspect each collection of subsets.\n\n- Collection I is *not* a partition because $a$ and $b$ are not subsets.\n\n- Collection II is a partition. All the subsets are non-empty, and every element of $X$ is contained in exactly one subset.\n\n- Collection III is *not* a partition. The subset $\\emptyset$ is empty, and the elements $d$ and $e$ do not appear in any subsets.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186059616 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059813 :knowledge-point/id #uuid "8c1d9899-21e8-5ab1-9bc5-10e4a8100ed9" :knowledge-point/title "Identifying the Missing Set to Form a Partition"}] :question/id #uuid "fcf768ea-80dc-5238-9694-883204f8f1f8" :question/math-academy-id "e-7009" :question/problem "Consider the set $X = \\{ -4, -1, 2, 5, 8, 11, 14, 17 \\}.$ Which subset must be placed into the blank in the set below so that it represents a partition of $X?$\n\n$$\n\\{ \\{ -1, 5, 8 \\}, \\{ -4, 11 \\}, \\{ 14 \\}, \\, \\_\\_\\_\\_ \\, \\}\n$$" :question/worked-solution "A partition of a set $X$ is a collection of non-empty subsets of $X$ where every element of $X$ is contained in *exactly* one subset. \n\nIn order to find the subset that goes in the blank, we must identify which elements of $X$ are not yet contained within any of the given subsets.\n\nLet's go through each element of $X$ and check:\n\n- $-4 \\in \\{ -4, 11 \\} \\quad \\color{green}\\checkmark$\n\n- $-1 \\in \\{ -1, 5, 8 \\} \\quad \\color{green}\\checkmark$\n\n- $2$ does not belong to any of the given subsets $\\quad \\color{red}\\times$\n\n- $5 \\in \\{ -1, 5, 8 \\} \\quad \\color{green}\\checkmark$\n\n- $8 \\in \\{ -1, 5, 8 \\} \\quad \\color{green}\\checkmark$\n\n- $11 \\in \\{ -4, 11 \\} \\quad \\color{green}\\checkmark$\n\n- $14 \\in \\{ 14 \\} \\quad \\color{green}\\checkmark$\n\n- $17$ does not belong to any of the given subsets $\\quad \\color{red}\\times$\n\nThe elements $2$ and $17$ are not yet contained within any of the given subsets. Therefore, the subset that must go in the blank is $\\{ 2,17 \\}.$"}] [{:db/id #edb/ref 17592186059617 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059814 :knowledge-point/id #uuid "2b2a9a1d-2d20-58cf-a1ee-bee2f4cf120d" :knowledge-point/title "Identifying Partitions of Large Sets"}] :question/id #uuid "e0696e3c-de10-5b18-ba67-1d381ddbe0be" :question/math-academy-id "e-7010" :question/problem "If $X = \\{ 5, 10, 15, \\ldots, 50 \\},$ which of the following collections of subsets of $X$ are partitions of $X?$\n\n- $\\{ \\{ 5, 10 \\}, \\{ 15, 20, 25, \\ldots, 45 \\}, \\{ 50 \\} \\}$\n\n- $\\{ \\{ 5, 10, 15, \\ldots, 30 \\}, \\{ 40, 45, 50 \\} \\}$\n\n- $\\{ \\{ 5, 10, 15, \\ldots, 50 \\} \\}$" :question/worked-solution "A partition of a set $X$ is a collection of non-empty subsets of $X$ where every element of $X$ is contained in *exactly* one subset. \n\nWith that in mind, let's inspect each collection of subsets.\n\n- Collection I is a partition. All the subsets are non-empty, and every element of $X$ is contained in exactly one subset.\n\n- Collection II is *not* a partition because the element $35$ does not appear in any subsets.\n\n- Collection III is a partition. There is only one subset, but that is okay. The subset is non-empty, and every element of $X$ is contained in this subset.\n\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186371506 :knowledge-point/_questions [{:db/id #edb/ref 17592186059813 :knowledge-point/id #uuid "8c1d9899-21e8-5ab1-9bc5-10e4a8100ed9" :knowledge-point/title "Identifying the Missing Set to Form a Partition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "970565a3-899b-5282-a25a-50e6ef102f58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{9,10}" :db/id #edb/ref 17592186371508} {:answer/id #uuid "eb2877bd-82b1-5fd7-9f74-e0cb46aef96f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6,9,10}" :db/id #edb/ref 17592186371509} {:answer/id #uuid "09c72c18-8e2d-5a8f-8e2c-2c72994254fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6,9}" :db/id #edb/ref 17592186371510} {:answer/id #uuid "eb1b5251-b148-51c9-8cdd-908681e32776" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3,6,9}" :db/id #edb/ref 17592186371511} {:answer/id #uuid "6d02484b-da10-5134-a9be-857526faa302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5,6,9,10}" :db/id #edb/ref 17592186371512}] :answer-field/correct {:answer/id #uuid "eb2877bd-82b1-5fd7-9f74-e0cb46aef96f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6,9,10}" :db/id #edb/ref 17592186371509} :answer-field/id #uuid "63bac6c5-dd87-541d-a9ea-3996685c77b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371507}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc1a812c-1051-5f8d-9b27-1018f3b5ca90" :question/math-academy-id "q-105868" :question/problem "Consider the set $X={0,1,2,3,…,10}.$ Which subset must be placed into the blank in the set below so that it represents a partition of $X?$\n\n$$\n{{2,3,5,7},{0,1},\\,{4,8},\\,____\\,}\n$$" :question/worked-solution "A partition of a set $X$ is a collection of non-empty subsets of $X$ where every element of $X$ is contained in *exactly* one subset. \n\nTo find the subset that goes in the blank, we must identify which elements of $X$ are not yet contained within any of the given subsets.\n\nLet's go through each element of $X$ and check:\n\n- $0\\in {0,1}\\,✓$\n\n- $1\\in {0,1}\\,✓$\n\n- $2\\in {2,3,5,7}\\,✓$\n\n- $3\\in {2,3,5,7}\\,✓$\n\n- $4\\in {4,8}\\,✓$\n\n- $5\\in {2,3,5,7}\\,✓$\n\n- $6$ does not belong to any of the given subsets $\\,\\times $\n\n- $7\\in {2,3,5,7}$\n\n- $8\\in {4,8}\\,✓$\n\n- $9$ does not belong to any of the given subsets $\\,\\times $\n\n- $10$ does not belong to any of the given subsets $\\,\\times $\n\nThe elements $6,9,$ and $10$ are not yet contained within any of the given subsets. Therefore, the subset that must go in the blank is ${6,9,10}.$"}] [{:db/id #edb/ref 17592186386161 :knowledge-point/_questions [{:db/id #edb/ref 17592186059813 :knowledge-point/id #uuid "8c1d9899-21e8-5ab1-9bc5-10e4a8100ed9" :knowledge-point/title "Identifying the Missing Set to Form a Partition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fc6f69b-f6d2-52b5-8c5e-9b19f618ebe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2,6,10}" :db/id #edb/ref 17592186386163} {:answer/id #uuid "664d4ffd-480c-5f22-8979-8452bf37b1ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6,14}" :db/id #edb/ref 17592186386164} {:answer/id #uuid "0b3a3ab6-1188-541b-a7df-c1ae670d8a41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{10,14}" :db/id #edb/ref 17592186386165} {:answer/id #uuid "1705d56f-cd06-57b9-b296-71fa6a5b00d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6,10,14}" :db/id #edb/ref 17592186386166} {:answer/id #uuid "78f323c8-b0e7-531d-a28a-8f16987a3121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{14}" :db/id #edb/ref 17592186386167}] :answer-field/correct {:answer/id #uuid "78f323c8-b0e7-531d-a28a-8f16987a3121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{14}" :db/id #edb/ref 17592186386167} :answer-field/id #uuid "9763950a-9d31-5794-bcc0-4622ea09bfb3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386162}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "29332e57-5723-57e4-a031-105647b85293" :question/math-academy-id "q-105877" :question/problem "Consider the set $X={2,4,6,8,10,12,14}.$ Which subset must be placed into the blank in the set below so that it represents a partition of $X?$\n\n$$\n{{2,4,8},{6,12},\\,{10},\\,____\\,}\n$$" :question/worked-solution "A partition of a set $X$ is a collection of non-empty subsets of $X$ where every element of $X$ is contained in *exactly* one subset. \n\nTo find the subset that goes in the blank, we must identify which elements of $X$ are not yet contained within any of the given subsets.\n\nLet's go through each element of $X$ and check:\n\n- $2\\in {2,4,8}\\,✓$\n\n- $4\\in {2,4,8}\\,✓$\n\n- $6\\in {6,12}\\,✓$\n\n- $8\\in {2,4,8}\\,✓$\n\n- $10\\in {10}\\,✓$\n\n- $12\\in {6,12}\\,✓$\n\n- $14$ does not belong to any of the given subsets $\\,\\times $\n\nThe element $14$ is not yet contained within any of the given subsets. Therefore, the subset that must go in the blank is ${14}.$"}] [{:db/id #edb/ref 17592186417775 :knowledge-point/_questions [{:db/id #edb/ref 17592186059812 :knowledge-point/id #uuid "1b082a95-4d6e-512f-a6ed-9100498d17c8" :knowledge-point/title "Identifying Partitions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c869bde-8a87-5024-ac95-04df9e93eeca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{{0,10},{2},{4,8,10}}" :db/id #edb/ref 17592186417751} {:answer/id #uuid "766d6cca-ff04-5de7-9394-8db047eb43ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{∅,{0,2,4,6,8},{10}}" :db/id #edb/ref 17592186417754} {:answer/id #uuid "9843bcf8-699e-5c71-9c74-72e5fb9038a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{{0,2,4,6,8,10,12}}" :db/id #edb/ref 17592186417759} {:answer/id #uuid "cc423c96-b8aa-516c-883d-cdb7d4c75d2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{{0,10},{2,4,6,8,10}}" :db/id #edb/ref 17592186417765} {:answer/id #uuid "e63004bd-dc80-596b-9550-3d149c208b61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{{0,10},{2,4,6,8}}" :db/id #edb/ref 17592186417766}] :answer-field/correct {:answer/id #uuid "e63004bd-dc80-596b-9550-3d149c208b61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{{0,10},{2,4,6,8}}" :db/id #edb/ref 17592186417766} :answer-field/id #uuid "50e0add4-d87e-54cf-8530-185be76bcd24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417770}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "84e33efb-d3f8-5005-acd9-dce160c0ccce" :question/math-academy-id "q-105882" :question/problem "If $T={0,2,4,6,8,10}$, which collection of subsets of $T$ is a partition of $T?$" :question/worked-solution "A partition of a set $T$ is a collection of non-empty subsets of $T$ where every element of $T$ is contained in *exactly* one subset. \n\nOf the given collections, only ${{0,10},{2,4,6,8}}$ is a partition.\n\nThe rest of the collections are not partitions:\n\n- ${∅,{0,2,4,6,8},{10}}$ is not a partition because the subset $∅$ is empty.\n\n- ${{0,2,4,6,8,10,12}}$ is not a partition because the element $12$ does not appear in $T.$\n\n- ${{0,10},{2},{4,8}}$ is not a partition because the element $6\\in T$ does not appear in any subset.\n\n- ${{0,10},{2,4,6,8,10}}$ is not a partition because the element $10$ appears in two subsets."}] [{:db/id #edb/ref 17592186371520 :knowledge-point/_questions [{:db/id #edb/ref 17592186059814 :knowledge-point/id #uuid "2b2a9a1d-2d20-58cf-a1ee-bee2f4cf120d" :knowledge-point/title "Identifying Partitions of Large Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a63d7d4-2315-50df-a14d-4dd137fbc47d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{{2,4,6,…,100},{1,3,5,…,99}}" :db/id #edb/ref 17592186371522} {:answer/id #uuid "d216c407-b0b5-5bce-a689-70266fe334da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{{2,4,6,…,100},{5,15,25…,95}}" :db/id #edb/ref 17592186371523} {:answer/id #uuid "5ea1a99c-c4f9-50b0-bf72-1598fdceacd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{{2,4,6,…,40},{1,2,3,…,99}}" :db/id #edb/ref 17592186371524} {:answer/id #uuid "61d50d6f-5303-559d-84ae-63570c99d7a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{∅,{1,2,3,…,100}}" :db/id #edb/ref 17592186371525} {:answer/id #uuid "054e2dc4-0eee-5242-a290-5434283aac5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{{0,1,2,3,…,100}}" :db/id #edb/ref 17592186371526}] :answer-field/correct {:answer/id #uuid "1a63d7d4-2315-50df-a14d-4dd137fbc47d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{{2,4,6,…,100},{1,3,5,…,99}}" :db/id #edb/ref 17592186371522} :answer-field/id #uuid "de437438-b483-58a4-8834-be32fa469602" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371521}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3720c3a3-2cd9-5d2f-953e-a4a2f06768de" :question/math-academy-id "q-105888" :question/problem "If $Y={1,2,3,…,100},$ which collection of subsets of $Y$ is a partition of $Y?$" :question/worked-solution "A partition of a set $Y$ is a collection of non-empty subsets of $Y$ where every element of $Y$ is contained in *exactly* one subset. \n\nOf the given collections, only ${{2,4,6,…,100},{1,3,5,…,99}}$ is a partition.\n\nThe rest of the collections are not partitions:\n\n- ${{2,4,6,…,100},{5,15,25…,95}}$ is not a partition because many elements of $Y$ (such as $1$) do not appear in any subsets.\n\n- ${{2,4,6,…,40},{1,2,3,…,99}}$ is not a partition because many elements (such as $2$) appear in both subsets.\n\n- ${{0,1,2,3,…,100}}$ is not a partition because it contains the element $0$ that do not appear in $Y.$\n\n- ${∅,{1,2,3,…,100}}$ is not a partition because the subset $∅$ is empty."}] [{:db/id #edb/ref 17592186397829 :knowledge-point/_questions [{:db/id #edb/ref 17592186059814 :knowledge-point/id #uuid "2b2a9a1d-2d20-58cf-a1ee-bee2f4cf120d" :knowledge-point/title "Identifying Partitions of Large Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "517768cd-d993-5dab-8ee7-13eb0fb7a83c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{{0},{10,20,30,…,900}}" :db/id #edb/ref 17592186397831} {:answer/id #uuid "848c6957-5caa-540d-8bff-a3623c7884b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{{0,10,20,…,890},{20,40,60,…,900}}" :db/id #edb/ref 17592186397832} {:answer/id #uuid "d94b7475-aea7-5f37-8f91-5a6a224b1a14" :