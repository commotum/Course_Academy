#{[{:db/id #edb/ref 17592186540086 :knowledge-point/_questions [{:db/id #edb/ref 17592186100925 :knowledge-point/id #uuid "be83d82e-531e-52bf-bacb-b621694ce40c" :knowledge-point/title "Determining the Values of N Such That the Error in the Nth Partial Sum Is Smaller Than a Given Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0749bd24-a594-5cc9-83a7-36f58ac8d74e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{i}\\ge 50" :db/id #edb/ref 17592186539491} {:answer/id #uuid "14c36eeb-9d6a-50b7-bad3-9d44cf5ab909" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{i}\\ge 98" :db/id #edb/ref 17592186539519} {:answer/id #uuid "390e483e-d568-5e74-bc98-5844f88422f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{i}\\ge 48" :db/id #edb/ref 17592186539586} {:answer/id #uuid "4388f0fe-c065-54c2-b8d2-e04e3c15d306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{i}\\ge 100" :db/id #edb/ref 17592186539605} {:answer/id #uuid "8b29d420-50c8-516b-bbbf-e812563a039e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{i}\\ge 52" :db/id #edb/ref 17592186539712}] :answer-field/correct {:answer/id #uuid "0749bd24-a594-5cc9-83a7-36f58ac8d74e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{i}\\ge 50" :db/id #edb/ref 17592186539491} :answer-field/id #uuid "94f7bcdd-1a29-50a3-b5ca-fac98fc4f9d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539972}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bb487298-b519-5edb-8e52-6ad72f9356fb" :question/math-academy-id "q-104031" :question/problem "Given that\n\n$$\nS={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{2}^{n}}\n$$\n\nand that ${s}_{i}$ is the $i$th partial sum of $S,$ use the alternating series error bound to determine an inequality that gives the values of $i$ such that $|S-{s}_{i}|<0.01.$" :question/worked-solution "First, let ${a}_{n}=\\frac{1}{{2}^{n}}$ and ${b}_{n}=\\frac{(-1)^{n}}{{2}^{n}}.$ Then ${a}_{n}$ is decreasing for $n\\ge 1$ and ${a}_{n}\\to 0$ as $n\\to \\infty .$ So, the series is convergent by the alternating series test. \n\nBecause our series is a convergent alternating series, the alternating series error bound applies. In particular, for the $i$th partial sum, it states that\n\n$$\n|S-{s}_{i}|<|{b}_{i+1}|.\n$$\n\nSo, we require\n\n$$\n\\begin{aligned}|{b}_{i+1}|=|\\frac{(-1)^{i+1}}{{2}^{i+1}}| & \\le 0.01 \\\\ \\frac{1}{{2}^{i+1}} & \\le \\frac{1}{100} \\\\ 100 & \\le {2}^{i+1} \\\\ 100 & \\le 2\\cdot {2}^{i} \\\\ {2}^{i} & \\ge 50.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186540035 :knowledge-point/_questions [{:db/id #edb/ref 17592186100924 :knowledge-point/id #uuid "c1ad1fe5-c690-54ab-a172-fdc69668d60d" :knowledge-point/title "Finding the Alternating Series Error Bound for a Given Partial Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42b4363e-f490-5a92-947a-8650b1bc2add" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{e^{9}}" :db/id #edb/ref 17592186539602}] :answer-field/correct {:answer/id #uuid "42b4363e-f490-5a92-947a-8650b1bc2add" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{e^{9}}" :db/id #edb/ref 17592186539602} :answer-field/id #uuid "49c7b2b3-00cb-51d6-bf65-4c63b25afc6e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186539953}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "26d0f888-4d20-5d31-b520-f4c4f17a1d7e" :question/math-academy-id "q-352750" :question/problem "Suppose that\n\n$$\nS={\\sum }_{n=1}^{\\infty }\\frac{{(-1)}^{n}}{{e}^{n+2}}\n$$\n\nand that ${s}_{6}$ is the sixth partial sum of $S.$ According to the alternating series error bound, $|S-{s}_{6}|<k$ for some real number $k.$\n\nFind the value of $k.$ Do not round the answer.\n\n$k=$\n\n{{field-1}}" :question/worked-solution "Let ${a}_{n}=\\frac{1}{{e}^{n+2}}$ and ${b}_{n}=\\frac{(-1)^{n}}{{e}^{n+2}}.$ Then ${a}_{n}$ is positive and decreasing for $n\\ge 1,$ and ${a}_{n}\\to 0$ as $n\\to \\infty .$ So, the series is convergent by the alternating series test.\n\nBecause our series is a convergent alternating series, the alternating series error bound applies. In particular, for the $6$th partial sum, it states that\n\n$$\n|S-{s}_{6}|<|{b}_{7}|=|\\frac{{(-1)}^{7}}{{e}^{7+2}}|=\\frac{1}{{e}^{9}}.\n$$\n\nTherefore, $k=\\frac{1}{{e}^{9}}.$"}] [{:db/id #edb/ref 17592186540077 :knowledge-point/_questions [{:db/id #edb/ref 17592186100924 :knowledge-point/id #uuid "c1ad1fe5-c690-54ab-a172-fdc69668d60d" :knowledge-point/title "Finding the Alternating Series Error Bound for a Given Partial Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e740dac2-bdf9-576f-b582-e4da8c53bb96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{315}" :db/id #edb/ref 17592186539871}] :answer-field/correct {:answer/id #uuid "e740dac2-bdf9-576f-b582-e4da8c53bb96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{315}" :db/id #edb/ref 17592186539871} :answer-field/id #uuid "aafd742f-ff73-5b71-bc91-fdad1d0edbed" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186539980}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a26aabae-4ded-5132-8e5c-c91af894cefb" :question/math-academy-id "q-352755" :question/problem "Suppose that\n\n$$\nS={\\sum }_{n=1}^{\\infty }\\frac{{(-2)}^{n}}{(n+1)!}\n$$\n\nand that ${s}_{5}$ is the fifth partial sum of $S.$ According to the alternating series error bound, $|S-{s}_{5}|<k$ for some real number $k.$ Find the value of $k.$ Do not round the answer.\n\n$k=$\n\n{{field-1}}" :question/worked-solution "Let ${a}_{n}=\\frac{{2}^{n}}{(n+1)!}$ and ${b}_{n}=\\frac{{(-2)}^{n}}{(n+1)!}.$ Then ${a}_{n}$ is positive and decreasing for $n\\ge 1,$ and ${a}_{n}\\to 0$ as $n\\to \\infty .$ So, the series is convergent by the alternating series test.\n\nBecause our series is a convergent alternating series, the alternating series error bound applies. In particular, for the $5$th partial sum, it states that\n\n$$\n|S-{s}_{5}|<|{b}_{6}|=|\\frac{{(-2)}^{6}}{(6+1)!}|=\\frac{64}{5040}=\\frac{4}{315}.\n$$\n\nTherefore, $k=\\frac{4}{315}.$"}] [{:db/id #edb/ref 17592186101467 :knowledge-point/_questions [{:db/id #edb/ref 17592186100924 :knowledge-point/id #uuid "c1ad1fe5-c690-54ab-a172-fdc69668d60d" :knowledge-point/title "Finding the Alternating Series Error Bound for a Given Partial Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f76dabc-e965-5bd2-946b-b648a0b45235" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{60}" :db/id #edb/ref 17592186099964} {:answer/id #uuid "1e5e40ed-6ab4-5198-a8e6-354713c86281" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{120}" :db/id #edb/ref 17592186099965} {:answer/id #uuid "4261f47f-7b9d-57ec-96d7-399ccbe9f256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186099966} {:answer/id #uuid "6548e5c8-a68d-5619-8a7c-27deb3295f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{720}" :db/id #edb/ref 17592186099967} {:answer/id #uuid "708e3bce-0e4d-573c-ae65-e71e364a43b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186099968}] :answer-field/correct {:answer/id #uuid "1e5e40ed-6ab4-5198-a8e6-354713c86281" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{120}" :db/id #edb/ref 17592186099965} :answer-field/id #uuid "5d626168-faee-5bbe-9336-29515ea5b9d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099963}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cca5f54f-1a2c-5d55-ba21-def4752edd37" :question/math-academy-id "q-50830" :question/problem "Suppose that \n\n$$\nS={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}n}{n!}\n$$\n\nand that ${s}_{5}$ is the fifth partial sum of $S.$ According to the alternating series error bound, $|S-{s}_{5}|<k$ for some real number $k.$ Find the value of $k.$" :question/worked-solution "Let ${a}_{n}=\\frac{n}{n!}$ and ${b}_{n}=\\frac{(-1)^{n}n}{n!}.$ Then ${a}_{n}$ is positive and decreasing for $n\\ge 1,$ and ${a}_{n}\\to 0$ as $n\\to \\infty .$ So, the series is convergent by the alternating series test.\n\nBecause our series is a convergent alternating series, the alternating series error bound applies. In particular, for the $5$th partial sum, it states that\n\n$$\n|S-{s}_{5}|<|{b}_{6}|=|\\frac{(-1)^{6}\\cdot 6}{6!}|=\\frac{6}{720}=\\frac{1}{120}.\n$$\n\n \n\nTherefore, $k=\\frac{1}{120}.$"}] [{:db/id #edb/ref 17592186540079 :knowledge-point/_questions [{:db/id #edb/ref 17592186100925 :knowledge-point/id #uuid "be83d82e-531e-52bf-bacb-b621694ce40c" :knowledge-point/title "Determining the Values of N Such That the Error in the Nth Partial Sum Is Smaller Than a Given Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1347e9be-27c7-561f-9660-bf0eb27ab9f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{i}^{2}+2i\\ge 100" :db/id #edb/ref 17592186539517} {:answer/id #uuid "22838a7c-5f32-5a55-9a8a-210f19e97ab1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{i}^{2}+4i\\ge 10" :db/id #edb/ref 17592186539546} {:answer/id #uuid "69d0a8d6-bd8f-5e35-9b5d-e6a76b35685c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{i}^{2}+4i\\ge 98" :db/id #edb/ref 17592186539655} {:answer/id #uuid "8bc70d2a-9194-5400-ae1f-803748c50b7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{i}^{2}+2i\\ge 8" :db/id #edb/ref 17592186539715} {:answer/id #uuid "f10e5377-afe1-5456-b9e8-239ed8651fc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{i}^{2}+2i\\ge 10" :db/id #edb/ref 17592186539883}] :answer-field/correct {:answer/id #uuid "f10e5377-afe1-5456-b9e8-239ed8651fc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{i}^{2}+2i\\ge 10" :db/id #edb/ref 17592186539883} :answer-field/id #uuid "39823874-955e-5f49-9b30-1ee04d308856" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539941}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aa9e57c4-993f-58af-8f8c-2c21d29224b2" :question/math-academy-id "q-83612" :question/problem "Given that\n\n$$\nS={\\sum }_{n=2}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}-1}\n$$\n\nand that ${s}_{i}$ is the $i$th partial sum of $S,$ use the alternating series error bound to determine an inequality that gives the values of $i$ such that $|S-{s}_{i}|<0.1.$" :question/worked-solution "First, let ${a}_{n}=\\frac{1}{{n}^{2}-1}$ and ${b}_{n}=\\frac{(-1)^{n}}{{n}^{2}-1}.$ Then ${a}_{n}$ is decreasing for $n\\ge 2$ and ${a}_{n}\\to 0$ as $n\\to \\infty .$ So, the series is convergent by the alternating series test. \n\nBecause our series is a convergent alternating series, the alternating series error bound applies. In particular, for the $i$th partial sum, it states that\n\n$$\n|S-{s}_{i}|<|{b}_{i+1}|.\n$$\n\nSo, we require\n\n$$\n\\begin{aligned}|{b}_{i+1}|=|\\frac{(-1)^{i+1}}{(i+1)^{2}-1}| & \\le 0.1 \\\\ \\frac{1}{{i}^{2}+2i+1-1} & \\le \\frac{1}{10} \\\\ \\frac{1}{{i}^{2}+2i} & \\le \\frac{1}{10} \\\\ {i}^{2}+2i & \\ge 10.\\end{aligned}\n$$"}]}
