 class=\"mjx-c2061\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D703 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c73\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c6E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2061\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D703 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-msup space=\"4\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-script style=\"vertical-align: 0.413em;\"><mjx-mo class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo></mjx-script></mjx-msup><mjx-mstyle><mjx-mspace style=\"width: 1em;\"></mjx-mspace></mjx-mstyle><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c61\"></mjx-c><mjx-c class=\"mjx-c73\"></mjx-c></mjx-mtext><mjx-mstyle><mjx-mspace style=\"width: 1em;\"></mjx-mspace></mjx-mstyle><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D703 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-msup space=\"4\"><mjx-mrow><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c28 TEX-S2\"></mjx-c></mjx-mo><mjx-mstyle><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70B TEX-I\"></mjx-c></mjx-mi></mjx-num><mjx-dbox><mjx-dtable><mjx-line type=\"d\"></mjx-line><mjx-row><mjx-den><mjx-dstrut type=\"d\"></mjx-dstrut><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-den></mjx-row></mjx-dtable></mjx-dbox></mjx-frac></mjx-mfrac></mjx-mstyle><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c29 TEX-S2\"></mjx-c></mjx-mo></mjx-mrow><mjx-script style=\"vertical-align: 0.877em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo></mjx-texatom></mjx-script></mjx-msup><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml display=\"block\" unselectable=\"on\"><math display=\"block\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable columnalign=\"right\" columnspacing=\"\" displaystyle=\"true\" rowspacing=\"0.8em 0.3em\"><mtr><mtd><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mi>θ</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mi>θ</mi><mo stretchy=\"false\">)</mo><mo accent=\"false\" stretchy=\"false\">→</mo><msup><mn>0</mn><mo>−</mo></msup><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mtext>as</mtext><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mi>θ</mi><mo accent=\"false\" stretchy=\"false\">→</mo><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>π</mi><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo>−</mo></mrow></msup></mtd></mtr><mtr><mtd><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mi>θ</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mi>θ</mi><mo stretchy=\"false\">)</mo><mo accent=\"false\" stretchy=\"false\">→</mo><msup><mn>0</mn><mo>+</mo></msup><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mtext>as</mtext><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mi>θ</mi><mo accent=\"false\" stretchy=\"false\">→</mo><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>π</mi><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo>+</mo></mrow></msup></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container><p></p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Thu, Oct 15th @ 4:42 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:17</span><span class=\"answerResult\"><span style=\"color: red;\">Incorrect</span></span></div></div>",
        "answer_validation": {
          "status": "supported",
          "version": 1,
          "evidence_hash": "c01d7d420077d87e52d25c02a2816d2511bf10fd9d68df5888951520e350354f"
        }
      },
      {
        "dom_id": "question-144998",
        "name": "Question 10",
        "problem": "Consider the polar curve $r=1+\\operatorname{sin}⁡\\theta $ for $\\theta \\in [0,2\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=\\operatorname{cos}⁡(2\\theta )-\\operatorname{sin}⁡(\\theta ),\\,{y}^{′}(\\theta )=\\operatorname{cos}⁡(\\theta )+\\operatorname{sin}⁡(2\\theta ),\n$$\n\nand ${y}^{′}(\\frac{3\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${x}^{′}(\\frac{3\\pi }{2})=0$\n\nII. ${lim}_{\\theta \\to (3\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\infty $\n\nIII. The curve has a vertical tangent at $\\theta =\\frac{3\\pi }{2}$\n\n*Hint: You may wish to make use of the following results.*\n\n$$\n\\begin{aligned}-2\\operatorname{sin}⁡(2\\theta )-\\operatorname{cos}⁡(\\theta )\\to {0}^{-}\\,\\text{as}\\,\\theta \\to {(\\frac{3\\pi }{2})}^{-} \\\\ -2\\operatorname{sin}⁡(2\\theta )-\\operatorname{cos}⁡(\\theta )\\to {0}^{+}\\,\\text{as}\\,\\theta \\to {(\\frac{3\\pi }{2})}^{+}\\end{aligned}\n$$",
        "worked_solution": "For a given polar curve, there is a vertical tangent at $\\theta ={\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}\n$$\n\nis infinite. This means that\n\n$$\n{y}^{′}({\\theta }_{0})\\ne 0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})=0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a vertical tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty \\,\\text{and}\\,{lim}_{\\theta \\to {\\theta }_{0}^{+}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty .\n$$\n\nIn this case, we're told that ${y}^{′}(\\frac{3\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\frac{3\\pi }{2}$ into the expression for ${x}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{x}^{′}(\\frac{3\\pi }{2}) & =\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{2})-\\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =\\operatorname{cos}⁡(3\\pi )-\\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =-1-(-1) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Computing the limit as $\\theta \\to {(\\frac{3\\pi }{2})}^{-}$ using L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (3\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (3\\pi /2)^{-}}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to (3\\pi /2)^{-}}(\\frac{\\operatorname{cos}⁡(\\theta )+\\operatorname{sin}⁡(2\\theta )}{\\operatorname{cos}⁡(2\\theta )-\\operatorname{sin}⁡(\\theta )}) \\\\  & ={lim}_{\\theta \\to (3\\pi /2)^{-}}(\\frac{{(\\operatorname{cos}⁡(\\theta )+\\operatorname{sin}⁡(2\\theta ))}^{′}}{{(\\operatorname{cos}⁡(2\\theta )-\\operatorname{sin}⁡(\\theta ))}^{′}}) \\\\  & ={lim}_{\\theta \\to (3\\pi /2)^{-}}(\\frac{-\\operatorname{sin}⁡(\\theta )+2\\operatorname{cos}⁡(2\\theta )}{-2\\operatorname{sin}⁡(2\\theta )-\\operatorname{cos}⁡(\\theta )}).\\end{aligned}\n$$\n\nEvaluating the limit in the numerator, we get\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (3\\pi /2)^{-}}(-\\operatorname{sin}⁡(\\theta )+2\\operatorname{cos}⁡(2\\theta )) & =-\\operatorname{sin}⁡(\\frac{3\\pi }{2})+2\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{2}) \\\\  & =-\\operatorname{sin}⁡(\\frac{3\\pi }{2})+2\\operatorname{cos}⁡(3\\pi ) \\\\  & =-(-1)+2\\cdot (-1) \\\\  & =1-2 \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore, using the first hint, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (3\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (3\\pi /2)^{-}}(\\frac{-\\operatorname{sin}⁡(\\theta )+2\\operatorname{cos}⁡(2\\theta )}{-2\\operatorname{sin}⁡(2\\theta )-\\operatorname{cos}⁡(\\theta )}) \\\\  & =\\frac{-1}{{0}^{-}} \\\\  & =\\infty .\\end{aligned}\n$$\n\n- Statement III is true. Using the calculations from part II, and the second hint, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (3\\pi /2)^{+}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (3\\pi /2)^{+}}(\\frac{-\\operatorname{sin}⁡(\\theta )+2\\operatorname{cos}⁡(2\\theta )}{-2\\operatorname{sin}⁡(2\\theta )-\\operatorname{cos}⁡(\\theta )}) \\\\  & =\\frac{-1}{{0}^{+}} \\\\  & =-\\infty .\\end{aligned}\n$$\n\nSince the limits of our derivative are both infinite, there is a vertical tangent to the curve at $\\theta =\\frac{3\\pi }{2}.$\n\n![](images/f4/f4462c7c41e7d6d5d10acec7627ac54f73477569356e22857659f5110847302d.png)\n\nTherefore, the correct answer is \"I, II, and III.\"",
        "answer_fields_complete": true,
