AIN-73\" x=\"500\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E8-MJMATHI-3B8\" x=\"13524\" y=\"0\"></use>\n <use xlink:href=\"#E8-MJMAIN-2192\" x=\"14272\" y=\"0\"></use>\n<g transform=\"translate(15550,0)\">\n <use xlink:href=\"#E8-MJSZ2-28\"></use>\n<g transform=\"translate(597,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"693\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E8-MJMATHI-3C0\" x=\"60\" y=\"676\"></use>\n <use xlink:href=\"#E8-MJMAIN-32\" x=\"96\" y=\"-687\"></use>\n</g>\n</g>\n <use xlink:href=\"#E8-MJSZ2-29\" x=\"1531\" y=\"-1\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E8-MJMAIN-2B\" x=\"3010\" y=\"1240\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p><em>It is not necessary to use L'Hopital's rule to evaluate the limit in part II.</em></p>\n\n            </div>     \n\n            <div class=\"explanationHeader\">EXPLANATION</div>\n\n            <div class=\"exampleExplanation\">\n                <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                   