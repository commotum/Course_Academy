E5-MJMAIN-3D\" y=\"0\"></use>\n<g transform=\"translate(2823,0)\">\n<g transform=\"translate(120,0)\">\n<rect height=\"60\" stroke=\"none\" width=\"2235\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(96,770)\">\n<use x=\"0\" xlink:href=\"#E5-MJMATHI-79\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"706\" xlink:href=\"#E5-MJMAIN-2032\" y=\"513\"></use>\n<use x=\"794\" xlink:href=\"#E5-MJMAIN-28\" y=\"0\"></use>\n<use x=\"1183\" xlink:href=\"#E5-MJMATHI-3B8\" y=\"0\"></use>\n<use x=\"1653\" xlink:href=\"#E5-MJMAIN-29\" y=\"0\"></use>\n</g>\n<g transform=\"translate(60,-771)\">\n<use x=\"0\" xlink:href=\"#E5-MJMATHI-78\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"809\" xlink:href=\"#E5-MJMAIN-2032\" y=\"408\"></use>\n<use x=\"867\" xlink:href=\"#E5-MJMAIN-28\" y=\"0\"></use>\n<use x=\"1256\" xlink:href=\"#E5-MJMATHI-3B8\" y=\"0\"></use>\n<use x=\"1726\" xlink:href=\"#E5-MJMAIN-29\" y=\"0\"></use>\n</g>\n</g>\n</g>\n<use x=\"5576\" xlink:href=\"#E5-MJMAIN-3D\" y=\"0\"></use>\n<g transform=\"translate(6632,0)\">\n<g transform=\"translate(120,0)\">\n<rect height=\"60\" stroke=\"none\" width=\"620\" x=\"0\" y=\"220\"></rect>\n<use x=\"60\" xlink:href=\"#E5-MJMAIN-30\" y=\"676\"></use>\n<use x=\"60\" xlink:href=\"#E5-MJMAIN-30\" y=\"-687\"></use>\n</g>\n</g>\n<use x=\"7493\" xlink:href=\"#E5-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>To see what's happening at this point, let's zoom in and observe the behavior of the curve.</p>\n<div class=\"graphic\" id=\"graphic-8273a3da61da754360f4c96968036fe5\"><img src=\"/graphics/8273a3da61da754360f4c96968036fe5\"/></div>\n<p>If we look carefully, we notice that the tangent lines flatten out as we approach the point <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-6-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 760.5 936.9\" width=\"1.766ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-6-Title\">C</title>\n<defs aria-hidden=\"true\">\n<path d=\"M50 252Q50 367 117 473T286 641T490 704Q580 704 633 653Q642 643 648 636T656 626L657 623Q660 623 684 649Q691 655 699 663T715 679T725 690L740 705H746Q760 705 760 698Q760 694 728 561Q692 422 692 421Q690 416 687 415T669 413H653Q647 419 647 422Q647 423 648 429T650 449T651 481Q651 552 619 605T510 659Q484 659 454 652T382 628T299 572T226 479Q194 422 175 346T156 222Q156 108 232 58Q280 24 350 24Q441 24 512 92T606 240Q610 253 612 255T628 257Q648 257 648 248Q648 243 647 239Q618 132 523 55T319 -22Q206 -22 128 53T50 252Z\" id=\"E6-MJMATHI-43\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E6-MJMATHI-43\" y=\"0\"></use>\n</g>\n</svg></span> from either direction.</p>\n<div class=\"graphic\" id=\"graphic-156e2051a24c2eb1481a3cea6fbfe2fd\"><img src=\"/graphics/156e2051a24c2eb1481a3cea6fbfe2fd\"/></div>\n<p>Therefore, as we take the <em>limit</em> of the tangent lines as we approach <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-7-Title\" focusable=\"false\" height=\"2.509ex\" role=\"img\" style=\"vertical-align: -0.671ex;\" viewbox=\"0 -791.3 1039 1080.4\" width=\"2.413ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-7-Title\">C,</title>\n<defs aria-hidden=\"true\">\n<path d=\"M50 252Q50 367 117 473T286 641T490 704Q580 704 633 653Q642 643 648 636T656 626L657 623Q660 623 684 649Q691 655 699 663T715 679T725 690L740 705H746Q760 705 760 698Q760 694 728 561Q692 422 692 421Q690 416 687 415T669 413H653Q647 419 647 422Q647 423 648 429T650 449T651 481Q651 552 619 605T510 659Q484 659 454 652T382 628T299 572T226 479Q194 422 175 346T156 222Q156 108 232 58Q280 24 350 24Q441 24 512 92T606 240Q610 253 612 255T628 257Q648 257 648 248Q648 243 647 239Q618 132 523 55T319 -22Q206 -22 128 53T50 252Z\" id=\"E7-MJMATHI-43\" stroke-width=\"1\"></path>\n<path d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\" id=\"E7-MJMAIN-2C\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E7-MJMATHI-43\" y=\"0\"></use>\n<use x=\"760\" xlink:href=\"#E7-MJMAIN-2C\" y=\"0\"></use>\n</g>\n</svg></span> it would appear that they become horizontal. </p>\n<div class=\"graphic\" id=\"graphic-1eac80c01ce5c6cd03e8241f7b41a2fe\"><img src=\"/graphics/1eac80c01ce5c6cd03e8241f7b41a2fe\"/></div>\n<p>When the limit of the tangent lines becomes horizontal like this, we say that the curve has a horizontal tangent at <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-8-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 1039 936.9\" width=\"2.413ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-8-Title\">C.</title>\n<defs aria-hidden=\"true\">\n<path d=\"M50 252Q50 367 117 473T286 641T490 704Q580 704 633 653Q642 643 648 636T656 626L657 623Q660 623 684 649Q691 655 699 663T715 679T725 690L740 705H746Q760 705 760 698Q760 694 728 561Q692 422 692 421Q690 416 687 415T669 413H653Q647 419 647 422Q647 423 648 429T650 449T651 481Q651 552 619 605T510 659Q484 659 454 652T382 628T299 572T226 479Q194 422 175 346T156 222Q156 108 232 58Q280 24 350 24Q441 24 512 92T606 240Q610 253 612 255T628 257Q648 257 648 248Q648 243 647 239Q618 132 523 55T319 -22Q206 -22 128 53T50 252Z\" id=\"E8-MJMATHI-43\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E8-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E8-MJMATHI-43\" y=\"0\"></use>\n<use x=\"760\" xlink:href=\"#E8-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span></p>\n</div>"
        },
        {
          "math_academy_id": 38606,
          "type": "tutorial",
          "content_id": 6384,
          "title": "Using Limits to Find Horizontal Tangents",
          "position": 1,
          "dom_id": "step-38606",
          "html": "<div class=\"step\" contentid=\"6384\" id=\"step-38606\" stepid=\"38606\" steptype=\"tutorial\" style=\"display: block\">\n<div class=\"stepHeader\">\n<div class=\"stepName\">\n<a class=\"stepAnchor\" id=\"stepAnchor-38606\" name=\"step-2\">Using Limits to Find Horizontal Tangents</a>\n</div>\n<div class=\"helpButton\" stepid=\"38606\">?</div>\n</div>\n<style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direction: ltr;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            border: 0;\n                            padding: 0;\n                            margin: 0\n                            }\n\n                            .mjpage * {\n                            transition: none;\n                            -webkit-transition: none;\n                            -moz-transition: none;\n                            -ms-transition: none;\n                            -o-transition: none\n                            }\n\n                            .mjx-svg-href {\n                            fill: blue;\n                            stroke: blue\n                            }\n\n                            .MathJax_SVG_LineBox {\n                            display: table!important\n                            }\n\n                            .MathJax_SVG_LineBox span {\n                            display: table-cell!important;\n                            width: 10000em!important;\n                            min-width: 0;\n                            max-width: none;\n                            padding: 0;\n                            border: 0;\n                            margin: 0\n                            }\n\n                            .mjpage__block {\n                            text-align: center;\n                            margin: 1em 0em;\n                            position: relative;\n                            display: block!important;\n                            text-indent: 0;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            width: 100%\n                            }</style><p>So, it seems that the curve <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-1-Title\" focusable=\"false\" height=\"2.343ex\" role=\"img\" style=\"vertical-align: -0.505ex;\" viewbox=\"0 -791.3 5484.7 1008.6\" width=\"12.739ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-1-Title\">r = 1+\\cos\\theta</title>\n<defs aria-hidden=\"true\">\n<path d=\"M21 287Q22 290 23 295T28 317T38 348T53 381T73 411T99 433T132 442Q161 442 183 430T214 408T225 388Q227 382 228 382T236 389Q284 441 347 441H350Q398 441 422 400Q430 381 430 363Q430 333 417 315T391 292T366 288Q346 288 334 299T322 328Q322 376 378 392Q356 405 342 405Q286 405 239 331Q229 315 224 298T190 165Q156 25 151 16Q138 -11 108 -11Q95 -11 87 -5T76 7T74 17Q74 30 114 189T154 366Q154 405 128 405Q107 405 92 377T68 316T57 280Q55 278 41 278H27Q21 284 21 287Z\" id=\"E1-MJMATHI-72\" stroke-width=\"1\"></path>\n<path d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\" id=\"E1-MJMAIN-3D\" stroke-width=\"1\"></path>\n<path d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\" id=\"E1-MJMAIN-31\" stroke-width=\"1\"></path>\n<path d=\"M56 237T56 250T70 270H369V420L370 570Q380 583 389 583Q402 583 409 568V270H707Q722 262 722 250T707 230H409V-68Q401 -82 391 -82H389H387Q375 -82 369 -68V230H70Q56 237 56 250Z\" id=\"E1-MJMAIN-2B\" stroke-width=\"1\"></path>\n<path d=\"M370 305T349 305T313 320T297 358Q297 381 312 396Q317 401 317 402T307 404Q281 408 258 408Q209 408 178 376Q131 329 131 219Q131 137 162 90Q203 29 272 29Q313 29 338 55T374 117Q376 125 379 127T395 129H409Q415 123 415 120Q415 116 411 104T395 71T366 33T318 2T249 -11Q163 -11 99 53T34 214Q34 318 99 383T250 448T370 421T404 357Q404 334 387 320Z\" id=\"E1-MJMAIN-63\" stroke-width=\"1\"></path>\n<path d=\"M28 214Q28 309 93 378T250 448Q340 448 405 380T471 215Q471 120 407 55T250 -10Q153 -10 91 57T28 214ZM250 30Q372 30 372 193V225V250Q372 272 371 288T364 326T348 362T317 390T268 410Q263 411 252 411Q222 411 195 399Q152 377 139 338T126 246V226Q126 130 145 91Q177 30 250 30Z\" id=\"E1-MJMAIN-6F\" stroke-width=\"1\"></path>\n<path d=\"M295 316Q295 356 268 385T190 414Q154 414 128 401Q98 382 98 349Q97 344 98 336T114 312T157 287Q175 282 201 278T245 269T277 256Q294 248 310 236T342 195T359 133Q359 71 321 31T198 -10H190Q138 -10 94 26L86 19L77 10Q71 4 65 -1L54 -11H46H42Q39 -11 33 -5V74V132Q33 153 35 157T45 162H54Q66 162 70 158T75 146T82 119T101 77Q136 26 198 26Q295 26 295 104Q295 133 277 151Q257 175 194 187T111 210Q75 227 54 256T33 318Q33 357 50 384T93 424T143 442T187 447H198Q238 447 268 432L283 424L292 431Q302 440 314 448H322H326Q329 448 335 442V310L329 304H301Q295 310 295 316Z\" id=\"E1-MJMAIN-73\" stroke-width=\"1\"></path>\n<path d=\"M35 200Q35 302 74 415T180 610T319 704Q320 704 327 704T339 705Q393 701 423 656Q462 596 462 495Q462 380 417 261T302 66T168 -10H161Q125 -10 99 10T60 63T41 130T35 200ZM383 566Q383 668 330 668Q294 668 260 623T204 521T170 421T157 371Q206 370 254 370L351 371Q352 372 359 404T375 484T383 566ZM113 132Q113 26 166 26Q181 26 198 36T239 74T287 161T335 307L340 324H145Q145 321 136 286T120 208T113 132Z\" id=\"E1-MJMATHI-3B8\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E1-MJMATHI-72\" y=\"0\"></use>\n<use x=\"729\" xlink:href=\"#E1-MJMAIN-3D\" y=\"0\"></use>\n<use x=\"1785\" xlink:href=\"#E1-MJMAIN-31\" y=\"0\"></use>\n<use x=\"2508\" xlink:href=\"#E1-MJMAIN-2B\" y=\"0\"></use>\n<g transform=\"translate(3509,0)\">\n<use xlink:href=\"#E1-MJMAIN-63\"></use>\n<use x=\"444\" xlink:href=\"#E1-MJMAIN-6F\" y=\"0\"></use>\n<use x=\"945\" xlink:href=\"#E1-MJMAIN-73\" y=\"0\"></use>\n</g>\n<use x=\"5015\" xlink:href=\"#E1-MJMATHI-3B8\" y=\"0\"></use>\n</g>\n</svg></span> has a horizontal tangent at <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-2-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 2655.6 936.9\" width=\"6.168ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-2-Title\">\\theta = \\pi.</title>\n<defs aria-hidden=\"true\">\n<path d=\"M35 200Q35 302 74 415T180 610T319 704Q320 704 327 704T339 705Q393 701 423 656Q462 596 462 495Q462 380 417 261T302 66T168 -10H161Q125 -10 99 10T60 63T41 130T35 200ZM383 566Q383 668 330 668Q294 668 260 623T204 521T170 421T157 371Q206 370 254 370L351 371Q352 372 359 404T375 484T383 566ZM113 132Q113 26 166 26Q181 26 198 36T239 74T287 161T335 307L340 324H145Q145 321 136 286T120 208T113 132Z\" id=\"E2-MJMATHI-3B8\" stroke-width=\"1\"></path>\n<path d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\" id=\"E2-MJMAIN-3D\" stroke-width=\"1\"></path>\n<path d=\"M132 -11Q98 -11 98 22V33L111 61Q186 219 220 334L228 358H196Q158 358 142 355T103 336Q92 329 81 318T62 297T53 285Q51 284 38 284Q19 284 19 294Q19 300 38 329T93 391T164 429Q171 431 389 431Q549 431 553 430Q573 423 573 402Q573 371 541 360Q535 358 472 358H408L405 341Q393 269 393 222Q393 170 402 129T421 65T431 37Q431 20 417 5T381 -10Q370 -10 363 -7T347 17T331 77Q330 86 330 121Q330 170 339 226T357 318T367 358H269L268 354Q268 351 249 275T206 114T175 17Q164 -11 132 -11Z\" id=\"E2-MJMATHI-3C0\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E2-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E2-MJMATHI-3B8\" y=\"0\"></use>\n<use x=\"747\" xlink:href=\"#E2-MJMAIN-3D\" y=\"0\"></use>\n<use x=\"1803\" xlink:href=\"#E2-MJMATHI-3C0\" y=\"0\"></use>\n<use x=\"2377\" xlink:href=\"#E2-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span> However, to be sure of this, we need to check that the tangent lines flatten out as we approach <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-3-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 2655.6 936.9\" width=\"6.168ex\" xmlns=\"http://www.w3.org/2000/svg\" xm