              "correct_value": "I only",
              "correct_option": "d",
              "value_type": "text",
              "wrong_value": "I, II, and III",
              "correct_keys": [],
              "wrong_keys": [],
              "ma_value": null,
              "ma_basis": "none",
              "ma_evidence": "",
