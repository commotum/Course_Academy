ss=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-msup space=\"4\"><mjx-mrow><mjx-mo class=\"mjx-s3\"><mjx-c class=\"mjx-c28 TEX-S3\"></mjx-c></mjx-mo><mjx-mstyle><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mrow><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70B TEX-I\"></mjx-c></mjx-mi></mjx-mrow></mjx-num><mjx-dbox><mjx-dtable><mjx-line type=\"d\"></mjx-line><mjx-row><mjx-den><mjx-dstrut type=\"d\"></mjx-dstrut><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-den></mjx-row></mjx-dtable></mjx-dbox></mjx-frac></mjx-mfrac></mjx-mstyle><mjx-mo class=\"mjx-s3\"><mjx-c class=\"mjx-c29 TEX-S3\"></mjx-c></mjx-mo></mjx-mrow><mjx-script style=\"vertical-align: 1.177em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo></mjx-texatom></mjx-script></mjx-msup><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml display=\"block\" unselectable=\"on\"><math display=\"block\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable columnalign=\"right\" columnspacing=\"\" displaystyle=\"true\" rowspacing=\"0.8em 0.3em\"><mtr><mtd><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mi>θ</mi><mo stretchy=\"false\">)</mo><mo>+</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>4</mn><mi>θ</mi><mo stretchy=\"false\">)</mo><mo accent=\"false\" stretchy=\"false\">→</mo><msup><mn>0</mn><mo>−</mo></msup><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mtext>as</mtext><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mi>θ</mi><mo accent=\"false\" stretchy=\"false\">→</mo><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>3</mn><mi>π</mi></mrow><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo>−</mo></mrow></msup></mtd></mtr><mtr><mtd><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mi>θ</mi><mo stretchy=\"false\">)</mo><mo>+</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>4</mn><mi>θ</mi><mo stretchy=\"false\">)</mo><mo accent=\"false\" stretchy=\"false\">→</mo><msup><mn>0</mn><mo>+</mo></msup><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mtext>as</mtext><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle><mi>θ</mi><mo accent=\"false\" stretchy=\"false\">→</mo><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>3</mn><mi>π</mi></mrow><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo>+</mo></mrow></msup></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container><p></p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Thu, Oct 15th @ 4:41 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:17</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>",
        "answer_validation": {
          "status": "supported",
          "version": 1,
          "evidence_hash": "21ebd563516d9fa28c84b17188c54c79e210d9f395e97cef1249a8b581e4d990"
        }
      },
      {
        "dom_id": "question-145211",
        "name": "Question 7",
        "problem": "Consider the polar curve $r=8{sin}^{3}⁡\\theta -8{sin}^{5}⁡\\theta $ for $\\theta \\in (-\\pi ,\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=3\\operatorname{sin}⁡(2\\theta )\\operatorname{sin}⁡(4\\theta ),\\,{y}^{′}(\\theta )=16{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta (3{cos}^{2}⁡\\theta -1),\n$$\n\nand ${y}^{′}(0)=0,$ which of the following statements are true?\n\nI. ${x}^{′}(0)=0$\n\nII. ${lim}_{\\theta \\to {0}^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\infty $\n\nIII. The curve has a vertical tangent at $\\theta =0$",
        "worked_solution": "For a given polar curve, there is a vertical tangent at $\\theta ={\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}\n$$\n\nis infinite. This means that\n\n$$\n{y}^{′}({\\theta }_{0})\\ne 0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})=0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a vertical tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty \\,\\text{and}\\,{lim}_{\\theta \\to {\\theta }_{0}^{+}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty .\n$$\n\nIn this case, we're told that ${y}^{′}(0)=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =0$ into the expression for ${x}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{x}^{′}(0) & =3\\operatorname{sin}⁡(2\\cdot 0)\\operatorname{sin}⁡(4\\cdot 0) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Computing the limit as $\\theta \\to {0}^{-},$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to {0}^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to {0}^{-}}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to {0}^{-}}(\\frac{16{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta (3{cos}^{2}⁡\\theta -1)}{3\\operatorname{sin}⁡(2\\theta )\\operatorname{sin}⁡(4\\theta )}) \\\\  & ={lim}_{\\theta \\to {0}^{-}}(\\frac{16{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta (3{cos}^{2}⁡\\theta -1)}{6\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡(4\\theta )}) \\\\  & ={lim}_{\\theta \\to {0}^{-}}(\\frac{16{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta (3{cos}^{2}⁡\\theta -1)}{12\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡(2\\theta )\\operatorname{cos}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to {0}^{-}}(\\frac{16{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta (3{cos}^{2}⁡\\theta -1)}{24{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta \\operatorname{cos}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to {0}^{-}}(\\frac{16{sin}^{\\cancel{3}}⁡\\theta \\cancel{\\operatorname{cos}⁡\\theta }(3{cos}^{2}⁡\\theta -1)}{24\\cancel{{sin}^{2}⁡\\theta }{cos}^{\\cancel{2}}⁡\\theta \\operatorname{cos}⁡(2\\theta )}) \\\\  & ={lim}_{\\theta \\to {0}^{-}}(\\frac{16\\operatorname{sin}⁡\\theta (3{cos}^{2}⁡\\theta -1)}{24\\operatorname{cos}⁡\\theta \\operatorname{cos}⁡(2\\theta )}) \\\\  & =\\frac{16\\operatorname{sin}⁡(0)(3{cos}^{2}⁡(0)-1)}{24\\operatorname{cos}⁡(0)\\operatorname{cos}⁡(2\\cdot 0)} \\\\  & =\\frac{0}{24} \\\\  & =0.\\end{aligned}\n$$\n\n- Statement III is false. Since the right limit of our derivative is not infinite, the curve does *not* have a vertical tangent at $\\theta =0.$ In fact, it is a horizontal tangent.\n\n![](images/4a/4a525b9a7a04f228bb45dc8c0c1cb916d1e98d8907e5fb1411ea52eb964c96ef.png)\n\nTherefore, the correct answer is \"I only.\"",
        "answer_fields_complete": true,
