=\"0\"></use>\n <use xlink:href=\"#E14-MJMATHI-3B8\" x=\"5985\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-29\" x=\"6454\" y=\"0\"></use>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E14-MJSZ3-29\" x=\"7940\" y=\"-1\"></use>\n</g>\n</g>\n<g transform=\"translate(0,-803)\">\n <use xlink:href=\"#E14-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1399\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n <use xlink:href=\"#E14-MJMAIN-2212\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-31\" x=\"778\" y=\"0\"></use>\n</g>\n<g transform=\"translate(124,-827)\">\n <use xlink:href=\"#E14-MJMAIN-30\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E14-MJMAIN-2B\" x=\"707\" y=\"557\"></use>\n</g>\n</g>\n</g>\n</g>\n<g transform=\"translate(0,-3253)\">\n <use xlink:href=\"#E14-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-2212\" x=\"1334\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-221E\" x=\"2112\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-2E\" x=\"3113\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></li>\n</ul>\n<p>Since the limits of our derivative are both infinite, we conclude that there is a vertical tangent to the curve at <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"7.004ex\" height=\"4.676ex\" style=\"vertical-align: -1.838ex;\" viewBox=\"0 -1221.9 3015.6 2013.3\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-15-Title\">\n<title id=\"MathJax-SVG-15-Title\">\\theta=\\dfrac{\\pi}{2}.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E15-MJMATHI-3B8\" d=\"M35 200Q35 302 74 415T180 610T319 704Q320 704 327 704T339 705Q393 701 423 656Q462 596 462 495Q462 380 417 261T302 66T168 -10H161Q125 -10 99 10T60 63T41 130T35 200ZM383 566Q383 668 330 668Q294 668 260 623T204 521T170 421T157 371Q206 370 254 370L351 371Q352 372 359 404T375 484T383 566ZM113 132Q113 26 166 26Q181 26 198 36T239 74T287 161T335 307L340 324H145Q145 321 136 286T120 208T113 132Z\"></path>\n<path stroke-width=\"1\" id=\"E15-MJMAIN-3D\" d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\"></path>\n<path stroke-width=\"1\" id=\"E15-MJMATHI-3C0\" d=\"M132 -11Q98 -11 98 22V33L111 61Q186 219 220 334L228 358H196Q158 358 142 355T103 336Q92 329 81 318T62 297T53 285Q51 284 38 284Q19 284 19 294Q19 300 38 329T93 391T164 429Q171 431 389 431Q549 431 553 430Q573 423 573 402Q573 371 541 360Q535 358 472 358H408L405 341Q393 269 393 222Q393 170 402 129T421 65T431 37Q431 20 417 5T381 -10Q370 -10 363 -7T347 17T331 77Q330 86 330 121Q330 170 339 226T357 318T367 358H269L268 354Q268 351 249 275T206 114T175 17Q164 -11 132 -11Z\"></path>\n<path stroke-width=\"1\" id=\"E15-MJMAIN-32\" d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\"></path>\n<path stroke-width=\"1\" id=\"E15-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E15-MJMATHI-3B8\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E15-MJMAIN-3D\" x=\"747\" y=\"0\"></use>\n<g transform=\"translate(1803,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"693\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E15-MJMATHI-3C0\" x=\"60\" y=\"676\"></use>\n <use xlink:href=\"#E15-MJMAIN-32\" x=\"96\" y=\"-687\"></use>\n</g>\n</g>\n <use xlink:href=\"#E15-MJMAIN-2E\" x=\"2737\" y=\"0\"></use>\n</g>\n</svg></span> </p>\n<div id=\"graphic-3115827a82bef56fc86690040ec9d891\" class=\"graphic\"><img src=\"/graphics/3115827a82bef56fc86690040ec9d891\"></div>\n        </div>",
