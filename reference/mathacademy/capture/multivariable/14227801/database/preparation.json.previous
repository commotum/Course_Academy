                  "html": " I only"
                },
                {
                  "option": "d",
                  "dom_id": "questionWidget-choiceLetterCircle-144998-d",
                  "type": "text",
                  "value": "I and II only",
                  "html": " I and II only"
                },
                {
                  "option": "e",
                  "dom_id": "questionWidget-choiceLetterCircle-144998-e",
                  "type": "text",
                  "value": "II and III only",
