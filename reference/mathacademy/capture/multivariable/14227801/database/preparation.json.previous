-MJMATHI-3C0\" x=\"1859\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E14-MJMAIN-2F\" x=\"2433\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E14-MJMAIN-32\" x=\"2933\" y=\"0\"></use>\n<g transform=\"translate(2428,0)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E14-MJMAIN-29\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.574)\" xlink:href=\"#E14-MJMAIN-2B\" x=\"479\" y=\"538\"></use>\n</g>\n</g>\n<g transform=\"translate(3387,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1249\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(97,725)\">\n <use xlink:href=\"#E14-MJMAIN-64\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMATHI-79\" x=\"556\" y=\"0\"></use>\n</g>\n<g transform=\"translate(60,-716)\">\n <use xlink:href=\"#E14-MJMAIN-64\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMATHI-78\" x=\"556\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n<g transform=\"translate(4866,0)\">\n<g transform=\"translate(0,2430)\">\n <use xlink:href=\"#E14-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n<g transform=\"translate(915,0)\">\n <use xlink:href=\"#E14-MJMAIN-6C\"></use>\n <use xlink:href=\"#E14-MJMAIN-69\" x=\"278\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-6D\" x=\"557\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-813)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E14-MJMATHI-3B8\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E14-MJMAIN-2192\" x=\"469\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E14-MJMAIN-28\" x=\"1469\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E14-MJMATHI-3C0\" x=\"1859\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E14-MJMAIN-2F\" x=\"2433\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E14-MJMAIN-32\" x=\"2933\" y=\"0\"></use>\n<g transform=\"translate(2428,0)\">\n <use transform=\"scale(0.707)\" xlink:href=