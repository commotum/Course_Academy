                {
                  "option": "b",
                  "dom_id": "questionWidget-choiceLetterCircle-143586-b",
                  "type": "text",
                  "value": "I and II only",
                  "html": "I and II only"
                },
                {
                  "option": "c",
                  "dom_id": "questionWidget-choiceLetterCircle-143586-c",
                  "type": "text",
                  "value": "II and III only",
                  "html": "II and III only"
                },
                {
                  "option": "d",
                  "dom_id": "questionWidget-choiceLetterCircle-143586-d",
                  "type": "text",
                  "value": "III only",
                  "html": "III only "
                },
                {
                  "option": "e",
                  "dom_id": "questionWidget-choiceLetterCircle-143586-e",
                  "type": "text",
                  "value": "I, II, and III",
                  "html": "I, II, and III"
                }
