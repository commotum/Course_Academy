        "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14227801/observations/lesson-step-37995-0e88f6291460d8555cb2.html",
        "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14227801/observations/lesson-step-37995-0e88f6291460d8555cb2.png",
        "source_url": "https://mathacademy.com/topics/3895",
        "captured_at": 1792064667.8595228,
        "math_academy_id": 6269,
        "topic_id": "3895",
        "sequence_position": null,
        "source_step": {
