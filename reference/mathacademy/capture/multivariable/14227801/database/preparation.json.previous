        "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14227801/observations/step-t6269-d59e35d3779ed76ab4a5.html",
        "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14227801/observations/step-t6269-d59e35d3779ed76ab4a5.png",
