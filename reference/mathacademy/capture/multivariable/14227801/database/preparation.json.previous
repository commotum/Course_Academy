              "source_url": "https://mathacademy.com/graphics/396a4fa76091cf721c0c08a711613f67",
              "render_ready": true,
              "path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14227801/assets/40de3bbd7f8422ff4ab4af6091497579f8031b8a43296e466f8c23ed4a121097.png",
              "sha256": "40de3bbd7f8422ff4ab4af6091497579f8031b8a43296e466f8c23ed4a121097",
