)\">\n <use xlink:href=\"#E4-MJMAIN-6C\"></use>\n <use xlink:href=\"#E4-MJMAIN-69\" x=\"278\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-6D\" x=\"557\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-813)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E4-MJMATHI-3B8\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E4-MJMAIN-2192\" x=\"469\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E4-MJMAIN-28\" x=\"1469\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E4-MJMATHI-3C0\" x=\"1859\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E4-MJMAIN-2F\" x=\"2433\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E4-MJMAIN-32\" x=\"2933\" y=\"0\"></use>\n<g transform=\"translate(2428,0)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E4-MJMAIN-29\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.574)\" xlink:href=\"#E4-MJMAIN-2B\" x=\"479\" y=\"538\"></use>\n</g>\n</g>\n</g>\n<g transform=\"translate(17158,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1249\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(97,725)\">\n <use xlink:href=\"#E4-MJMAIN-64\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMATHI-79\" x=\"556\" y=\"0\"></use>\n</g>\n<g transform=\"translate(60,-716)\">\n <use xlink:href=\"#E4-MJMAIN-64\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMATHI-78\" x=\"556\" y=\"0\"></use>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E4-MJMAIN-3D\" x=\"18924\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-B1\" x=\"19981\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-221E\" x=\"20759\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2E\" x=\"21760\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>Let's now verify that this is true:</p>\n<p>Using techniques discussed in previous lessons, it's straightforward to show that</p>\n<p><span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"51.649ex\" heig