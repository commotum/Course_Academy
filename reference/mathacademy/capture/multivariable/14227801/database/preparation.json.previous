\" y=\"0\"></use>\n<use x=\"945\" xlink:href=\"#E6-MJMAIN-73\" y=\"0\"></use>\n</g>\n<use x=\"5825\" xlink:href=\"#E6-MJMATHI-3B8\" y=\"0\"></use>\n<use x=\"6517\" xlink:href=\"#E6-MJMAIN-2212\" y=\"0\"></use>\n<use x=\"7518\" xlink:href=\"#E6-MJMAIN-31\" y=\"0\"></use>\n</g>\n<g transform=\"translate(1342,-726)\">\n<use xlink:href=\"#E6-MJMAIN-73\"></use>\n<use x=\"394\" xlink:href=\"#E6-MJMAIN-69\" y=\"0\"></use>\n<use x=\"673\" xlink:href=\"#E6-MJMAIN-6E\" y=\"0\"></use>\n<use x=\"1396\" xlink:href=\"#E6-MJMAIN-32\" y=\"0\"></use>\n<use x=\"1896\" xlink:href=\"#E6-MJMATHI-3B8\" y=\"0\"></use>\n<use x=\"2588\" xlink:href=\"#E6-MJMAIN-2B\" y=\"0\"></use>\n<g transform=\"translate(3589,0)\">\n<use xlink:href=\"#E6-MJMAIN-73\"></use>\n<use x=\"394\" xlink:href=\"#E6-MJMAIN-69\" y=\"0\"></use>\n<use x=\"673\" xlink:href=\"#E6-MJMAIN-6E\" y=\"0\"></use>\n</g>\n<use x=\"4985\" xlink:href=\"#E6-MJMATHI-3B8\" y=\"0\"></use>\n</g>\n</g>\n</g>\n<use x=\"9115\" xlink:href=\"#E6-MJSZ3-29\" y=\"-1\"></use>\n</g>\n<use x=\"13909\" xlink:href=\"#E6-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>We already know that substituting <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-7-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 2377.1 936.9\" width=\"5.521ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-7-Title\">\\theta = \\pi</title>\n<defs aria-hidden=\"true\">\n<path d=\"M35 200Q35 302 74 415T180 610T319 704Q320 704 327 704T339 705Q393 701 423 656Q462 596 462 495Q462 380 417 261T302 66T168 -10H161Q125 -10 99 10T60 63T41 130T35 200ZM383 566Q383 668 330 668Q294 668 260 623T204 521T170 421T157 371Q206 370 254 370L351 371Q352 372 359 404T375 484T383 566ZM113 132Q113 26 166 26Q181 26 198 36T239 74T287 161T335 307L340 324H145Q145 321 136 286T120 208T113 132Z\" id=\"E7-MJMATHI-3B8\" stroke-width=\"1\"></path>\n<path d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\" id=\"E7-MJMAIN-3D\" stroke-width=\"1\"></path>\n<path d=\"M132 -11Q98 -11 98 22V33L111 61Q186 219 220 334L228 358H196Q158 358 142 355T103 336Q92 329 81 318T62 297T53 285Q51 284 38 284Q19 284 19 294Q19 300 38 329T93 391T164 429Q171 431 389 431Q549 431 553 430Q573 423 573 402Q573 371 541 360Q535 358 472 358H408L405 341Q393 269 393 222Q393 170 402 129T421 65T431 37Q431 20 417 5T381 -10Q370 -10 363 -7T347 17T331 77Q330 86 330 121Q330 170 339 226T357 318T367 358H269L268 354Q268 351 249 275T206 114T175 17Q164 -11 132 -11Z\" id=\"E7-MJMATHI-3C0\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E7-MJMATHI-3B8\" y=\"0\"></use>\n<use x=\"747\" xlink:href=\"#E7-MJMAIN-3D\" y=\"0\"></use>\n<use x=\"1803\" xlink:href=\"#E7-MJMATHI-3C0\" y=\"0\"></use>\n</g>\n</svg></span> gives the indeterminate form <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-8-Title\" focusable=\"false\" height=\"5.176ex\" role=\"img\" style=\"vertical-align: -1.838ex;\" viewbox=\"0 -1437.2 1139 2228.5\" width=\"2.645ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-8-Title\">\\dfrac00,</title>\n<defs aria-hidden=\"true\">\n<path d=\"M96 585Q152 666 249 666Q297 666 345 640T423 548Q460 465 460 320Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\" id=\"E8-MJMAIN-30\" stroke-width=\"1\"></path>\n<path d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\" id=\"E8-MJMAIN-2C\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<g transform=\"translate(120,0)\">\n<rect height=\"60\" stroke=\"none\" width=\"620\" x=\"0\" y=\"220\"></rect>\n<use x=\"60\" xlink:href=\"#E8-MJMAIN-30\" y=\"676\"></use>\n<use x=\"60\" xlink:href=\"#E8-MJMAIN-30\" y=\"-687\"></use>\n</g>\n<use x=\"860\" xlink:href=\"#E8-MJMAIN-2C\" y=\"0\"></use>\n</g>\n</svg></span> so evaluating this limit by direct substitution won't work. However, we can evaluate this limit using L'Hopital's rule.</p>\n<p>Applying L'Hopital's rule, we get</p>\n<p><span class=\"mjpage mjpage__block\"><svg aria-labelledby=\"MathJax-SVG-9-Title\" focusable=\"false\" height=\"55.176ex\" role=\"img\" style=\"vertical-align: -27.005ex;\" viewbox=\"0 -12129.3 18352.7 23756.2\" width=\"42.626ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-9-Title\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"2\" display=\"true\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\" display=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 18.026em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-munder><mjx-row><mjx-base style=\"padding-left: 0.026em;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c6C\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c6D\"></mjx-c></mjx-mo></mjx-base></mjx-row><mjx-row><mjx-under style=\"padding-top: 0.167em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D703 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2192\"></m