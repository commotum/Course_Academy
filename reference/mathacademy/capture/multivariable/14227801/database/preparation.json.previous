                  "dom_id": "questionWidget-choiceLetterCircle-145215-b",
                  "type": "text",
                  "value": "I and II only",
                  "html": " I and II only"
                },
                {
                  "option": "c",
                  "dom_id": "questionWidget-choiceLetterCircle-145215-c",
                  "type": "text",
                  "value": "II and III only",
                  "html": " II and III only"
                },
                {
                  "option": "d",
                  "dom_id": "questionWidget-choiceLetterCircle-145215-d",
