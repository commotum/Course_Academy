,-10923)\">\n <use xlink:href=\"#E14-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"5124\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,770)\">\n <use xlink:href=\"#E14-MJMAIN-31\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-2B\" x=\"722\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-32\" x=\"1723\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-22C5\" x=\"2446\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-28\" x=\"2946\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-2212\" x=\"3336\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-31\" x=\"4114\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-29\" x=\"4615\" y=\"0\"></use>\n</g>\n<g transform=\"translate(449,-687)\">\n <use xlink:href=\"#E14-MJMAIN-2212\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-32\" x=\"778\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-22C5\" x=\"1501\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-30\" x=\"2001\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-2212\" x=\"2724\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-30\" x=\"3725\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n<g transform=\"translate(0,-13836)\">\n <use xlink:href=\"#E14-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"2343\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n <use xlink:href=\"#E14-MJMAIN-31\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-2212\" x=\"722\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-32\" x=\"1723\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E14-MJMAIN-30\" x=\"921\" y=\"-687\"></use>\n</g>\n</g>\n</g>\n<g transform=\"translate(0,-16689)\">\n <use xlink:href=\"#E14-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1399\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n <use xlink:href=\"#E14-MJMAIN-2212\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E14-MJMAIN-31\" x=\"778\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E14-MJMAIN-30\" x=\"449\" y=\"-687\"></use>\n</g>\n</g>\n</g>\n<g transform=\"translate(0,-18998)\">\n <use xlink:href=\"#E14-MJMAIN-2260\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n <use xlink:href=\"#E14-MJMAIN-30\"></use>\n <use xlink:href=\"#E14-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n</li>\n</ul>\n<ul>\n<li>Statement III is false. Since the limit in part II does <em>not</em> equal to <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.809ex\" height=\"2.509ex\" style=\"vertical-align: -0.671ex;\" viewBox=\"0 -791.3 779 1080.4\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-15-Title\">\n<title id=\"MathJax-SVG-15-Title\">0,</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E15-MJMAIN-30\" d=\"M96 585Q152 666 249 666Q297 666 345 640T423 548Q460 465 460 320Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\"></path>\n<path stroke-width=\"1\" id=\"E15-MJMAIN-2C\" d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E15-MJMAIN-30\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E15-MJMAIN-2C\" x=\"500\" y=\"0\"></use>\n</g>\n</svg></span> there curve does <em>not</em> have a horizontal tangent at <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"8.166ex\" height=\"5.176ex\" style=\"vertical-align: -1.838ex;\" viewBox=\"0 -1437.2 3516.1 2228.5\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-16-Title\">\n<title id=\"MathJax-SVG-16-Title\">\\theta=\\dfrac{3\\pi}{2}.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E16-MJMATHI-3B8\" d=\"M35 200Q35 302 74 415T180 610T319 704Q320 704 327 704T339 705Q393 701 423 656Q462 596 462 495Q462 380 417 261T302 66T168 -10H161Q125 -10 99 10T60 63T41 130T35 200ZM383 566Q383 668 330 668Q294 668 260 623T204 521T170 421T157 371Q206 370 254 370L351 371Q352 372 359 404T375 484T383 566ZM113 132Q113 26 166 26Q181 26 198 36T239 74T287 161T335 307L340 324H145Q145 321 136 286T120 208T113 132Z\"></path>\n<path stroke-width=\"1\" id=\"E16-MJMAIN-3D\" d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\"></path>\n<path stroke-width=\"1\" id=\"E16-MJMAIN-33\" d=\"M127 463Q100 463 85 480T69 524Q69 579 117 622T233 665Q268 665 277 664Q351 652 390 611T430 522Q430 470 396 421T302 350L299 348Q299 347 308 345T337 336T375 315Q457 262 457 175Q457 96 395 37T238 -22Q158 -22 100 21T42 130Q42 158 60 175T105 193Q133 193 151 175T169 130Q169 119 166 110T159 94T148 82T136 74T126 70T118 67L114 66Q165 21 238 21Q293 21 321 74Q338 107 338 175V195Q338 290 274 322Q259 328 213 329L171 330L168 332Q166 335 166 348Q166 366 174 366Q202 366 232 371Q266 376 294 413T322 525V533Q322 590 287 612Q265 626 240 626Q208 626 181 615T143 592T132 580H135Q138 579 143 578T153 573T165 566T175 555T183 540T186 520Q186 498 172 481T127 463Z\"></path>\n<path stroke-width=\"1\" id=\"E16-MJMATHI-3C0\" d=\"M132 -11Q98 -11 98 22V33L111 61Q186 219 220 334L228 358H196Q158 358 142 355T103 336Q92 329 81 318T62 297T53 285Q51 284 38 284Q19 284 19 294Q19 300 38 329T93 391T164 429Q171 431 389 431Q549 431 553 430Q573 423 573 402Q573 371 541 360Q535 358 472 358H408L405 341Q393 269 393 222Q393 170 402 129T421 65T431 37Q431 20 417 5T381 -10Q370 -10 363 -7T347 17T331 77Q330 86 330 121Q330 170 339 226T357 318T367 358H269L268 354Q268 351 249 275T206 114T175 17Q164 -11 132 -11Z\"></path>\n<path stroke-width=\"1\" id=\"E16-MJMAIN-32\" d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\"></path>\n<path stroke-width=\"1\" id=\"E16-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E16-MJMATHI-3B8\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E16-MJMAIN-3D\" x=\"747\" y=\"0\"></use>\n<g transform=\"translate(1803,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1194\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n <use xlink:href=\"#E16-MJMAIN-33\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E16-MJMATHI-3C0\" x=\"500\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E16-MJMAIN-32\" x=\"346\" y=\"-687\"></use>\n</g>\n</g>\n <use xlink:href=\"#E16-MJMAIN-2E\" x=\"3237\" y=\"0\"></use>\n</g>\n</svg></span> In fact, it is a vertical tangent.</li>\n</ul>\n<div id=\"graphic-9358e7cfaeed727c4002fc75656e3ce7\" class=\"graphic\"><img src=\"/graphics/9358e7cfaeed727c4002fc75656e3ce7\"></div>\n\n<p>Therefore, the correct answer is \"I only.\"</p>\n<p><strong>Note</strong>: We'll discuss vertical tangents in more detail later in this lesson. </p>\n\n                    </div>     \n                </div>                            \n                    \n            </div>",
