th display=\"block\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">(</mo><mi>θ</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mi>θ</mi><mo stretchy=\"false\">)</mo><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><msup><mi>y</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">(</mo><mi>θ</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo>+</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mi>θ</mi><mo stretchy=\"false\">)</mo><mo>,</mo></math></mjx-assistive-mml></mjx-container>\nand <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"4\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mo class=\"mjx-var\" size=\"s\"><mjx-c class=\"mjx-c2032\"></mjx-c></mjx-mo></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D703 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">(</mo><mi>θ</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mn>0</mn></math></mjx-assistive-mml></mjx-container> at <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"5\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D703 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c1D70B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>θ</mi><mo>=</mo><mi>π</mi><mo>,</mo></math></mjx-assistive-mml></mjx-container> which of the following statements are true?</p>\n<p></p><ol class=\"questionStatements\"><li> <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"6\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mo class=\"mjx-var\" size=\"s\"><mjx-c class=\"mjx-c2032\"></mjx-c></mjx-mo></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>y</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo stretchy=\"false\">(</mo><mi>π</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mn>0</mn></math></mjx-assistive-mml></mjx-container> </li><li> <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"7\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-munder><mjx-row><mjx-base style=\"padding-left: 0.026em;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c6C\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c6D\"></mjx-c></mjx-mo></mjx-base></mjx-row><mjx-row><mjx-under style=\"padding-top: 0.167em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D703 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70B TEX-I\"></mjx-c></mjx-mi></mjx-texatom></mjx-under></mjx-row></mjx-munder><mjx-mstyle space=\"2\"><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mrow><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi></mjx-mrow></mjx-num><mjx-dbox><mjx-dtable><mjx-line type=\"d\"></mjx-line><mjx-row><mjx-den><mjx-dstrut type=\"d\"></mjx-dstrut><mjx-mrow><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi></mjx-mrow></mjx-den></mjx-row></mjx-dtable></mjx-dbox></mjx-frac></mjx-mfrac></mjx-mstyle><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mo data-mjx-texclass=\"OP\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>θ</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi>π</mi></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mtext>d</mtext><mi>y</mi></mrow><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle><mo>=</mo><mn>0</mn></math></mjx-assistive-mml></mjx-container> </li><li>  The curve has a horizontal tangent at <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"8\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D703 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c1D70B TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>θ</mi><mo>=</mo><mi>π</mi></math></mjx-assistive-mml></mjx-container> </li></ol>\n<em>Hint: Use L'Hopital's rule to evaluate the limit in part II.</em><p></p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Thu, Oct 15th @ 4:39 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:16</span><span class=\"answerResult\"><span style=\"color: red;\">Incorrect</span></span></div></div>",
        "answer_validation": {
          "status": "supported",
          "version": 1,
          "evidence_hash": "0dc1d04ec0cdb704a2a4d93f07204a302d393b13862d5cee492f36108c4cbce1"
        }
      },
      {
        "dom_id": "question-143720",
        "name": "Question 2",
        "problem": "Consider the polar curve $r={cos}^{3}⁡\\theta $ for $\\theta \\in [0,2\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=-4\\operatorname{sin}⁡\\theta {cos}^{3}⁡\\theta ,\\,{y}^{′}(\\theta )={cos}^{2}⁡\\theta ({cos}^{2}⁡\\theta -3{sin}^{2}⁡\\theta ),\n$$\n\nand ${x}^{′}(\\frac{\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${y}^{′}(\\frac{\\pi }{2})=0$\n\nII. ${lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x}=0$\n\nIII. The curve has a horizontal tangent at $\\theta =\\frac{\\pi }{2}$\n\n*Hint: It is not necessary to use L'Hopital's rule to evaluate the limit in part II.*",
        "worked_solution": "When a polar curve is differentiable at a point ${\\theta }_{0}$, there is a horizontal tangent at ${\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}=0\n$$\n\nwhich is equivalent to\n\n$$\n{y}^{′}({\\theta }_{0})=0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})\\ne 0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative ${y}^{′}(x)$ takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a horizontal tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}}\\frac{\\text{d}y}{\\text{d}x}=0.\n$$\n\nIn this case, we're told that ${x}^{′}(\\frac{\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\frac{\\pi }{2}$ into the expression for ${y}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & ={cos}^{2}⁡(\\frac{\\pi }{2})({cos}^{2}⁡(\\frac{\\pi }{2})-3{sin}^{2}⁡(\\frac{\\pi }{2})) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Computing the limit as $\\theta \\to \\frac{\\pi }{2},$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to \\pi /2}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{{cos}^{2}⁡\\theta ({cos}^{2}⁡\\theta -3{sin}^{2}⁡\\theta )}{-4\\operatorname{sin}⁡\\theta {cos}^{3}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\cancel{{cos}^{2}⁡\\theta }({cos}^{2}⁡\\theta -3{sin}^{2}⁡\\theta )}{-4\\operatorname{sin}⁡\\theta {cos}^{\\cancel{3}}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{{cos}^{2}⁡\\theta -3{sin}^{2}⁡\\theta }{-4\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }) \\\\  & =\\frac{{cos}^{2}⁡(\\frac{\\pi }{2})-3{sin}^{2}⁡(\\frac{\\pi }{2})}{-4\\operatorname{sin}⁡(\\frac{\\pi }{2})\\operatorname{cos}⁡(\\frac{\\pi }{2})} \\\\  & =\\frac{-3}{0} \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Statement III is false. Since the limit in part II does *not* equal to $0,$ there curve does *not* have a horizontal tangent at $\\theta =\\frac{\\pi }{2}.$ In fact, it is a vertical tangent.\n\n![](images/8b/8b68110c25bfa464c0971a396ec50908c0c0622cbdc92bf42239b984695655ca.png)\n\nTherefore, the correct answer is \"I only.\"",
        "answer_fields_complete": true,
        "result": "Correct",
        "html": "<div id=\"question-143720\" class=\"question\"><div class=\"questionHeader\"><span class=\"questionNumber\">2.</span><span class=\"helpButton\" questionid=\"143720\">?</span></div><div class=\"questionText\"><p>Consider the polar curve <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"24\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45F TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-msup space=\"4\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c63\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c73\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2061\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"2\"><mjx-c class=\"mjx-c1D703 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi><mo>=</mo><msup><mi>cos</mi><mn>3</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi></math></mjx-assistive-mml></mjx-container> for <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"25\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D703 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2208\"></mjx-c></mjx-mo><mjx-mrow space=\"4\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c5B\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-m