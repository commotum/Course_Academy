892 #edb/ref 1075 #edb/ref 17592186249336 #edb/ref 17592186045417] [17592186249892 #edb/ref 1075 #edb/ref 17592186249573 #edb/ref 17592186045417] [17592186249892 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186249892 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186249892 #edb/ref 1078 #edb/ref 17592186248852 #edb/ref 17592186045417] [17592186249892 #edb/ref 1079 #uuid "80448976-ae2f-5f8d-b8a1-8ddcc578dda8" #edb/ref 17592186045417] [17592186250284 #edb/ref 1068 #edb/ref 17592186249755 #edb/ref 17592186045417] [17592186250284 #edb/ref 1069 "q-114555" #edb/ref 17592186045417] [17592186250284 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186250284 #edb/ref 1071 "Calculate $\\int 8{x}^{3}\\operatorname{ln}⁡(3x)\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186250284 #edb/ref 1072 #uuid "9fadab91-be05-5653-9838-592471a9067d" #edb/ref 17592186045417] [17592186250284 #edb/ref 1074 "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(3x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=8{x}^{3}\\, & ⟹\\,v=\\int 8{x}^{3}\\,\\text{d}x=2{x}^{4}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 8{x}^{3}\\operatorname{ln}⁡(3x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(3x)\\cdot (2{x}^{4})-\\int \\frac{2{x}^{4}}{x}\\,\\text{d}x \\\\  & =2{x}^{4}\\operatorname{ln}⁡(3x)-2\\int {x}^{3}\\,\\text{d}x \\\\  & =2{x}^{4}\\operatorname{ln}⁡(3x)-2\\cdot \\frac{{x}^{4}}{4}+C \\\\  & =2{x}^{4}\\operatorname{ln}⁡(3x)-\\frac{{x}^{4}}{2}+C \\\\  & ={x}^{4}(2\\operatorname{ln}⁡(3x)-\\frac{1}{2})+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant." #edb/ref 17592186045417] [17592186250285 #edb/ref 1068 #edb/ref 17592186249892 #edb/ref 17592186045417] [17592186250285 #edb/ref 1069 "q-114556" #edb/ref 17592186045417] [17592186250285 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186250285 #edb/ref 1071 "Calculate $\\int \\frac{{log}_{4}⁡(2x)}{{x}^{4}}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186250285 #edb/ref 1072 #uuid "67ee7e99-c327-5643-bad9-04c09862c4b7" #edb/ref 17592186045417] [17592186250285 #edb/ref 1074 "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{4}⁡(2x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡4} \\\\ {v}^{′}=\\frac{1}{{x}^{4}}\\, & ⟹\\,v=\\int \\frac{1}{{x}^{4}}\\,\\text{d}x=-\\frac{1}{3{x}^{3}}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{4}⁡(2x)}{{x}^{4}}\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{4}⁡(2x)\\cdot (-\\frac{1}{3{x}^{3}})-\\int (-\\frac{1}{3{x}^{3}})(\\frac{1}{x\\operatorname{ln}⁡4})\\,\\text{d}x \\\\  & =-\\frac{{log}_{4}⁡(2x)}{3{x}^{3}}+\\frac{1}{3\\operatorname{ln}⁡4}\\int \\frac{1}{{x}^{4}}\\,\\text{d}x \\\\  & =-\\frac{{log}_{4}⁡(2x)}{3{x}^{3}}+\\frac{1}{3\\operatorname{ln}⁡4}(-\\frac{1}{3{x}^{3}})+C \\\\  & =-\\frac{\\operatorname{ln}⁡(2x)}{3{x}^{3}\\operatorname{ln}⁡4}-\\frac{1}{9{x}^{3}\\operatorname{ln}⁡4}+C \\\\  & =-\\frac{3\\operatorname{ln}⁡(2x)+1}{9{x}^{3}\\operatorname{ln}⁡4}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{4}⁡(2x)=\\frac{\\operatorname{ln}⁡(2x)}{\\operatorname{ln}⁡4}.$" #edb/ref 17592186045417] [17592186319973 #edb/ref 1080 "\\frac{1}{4}({e}^{2}+1)" #edb/ref 17592186045417] [17592186319973 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186319973 #edb/ref 1083 #uuid "bdf24a8d-ae4b-5eb6-8100-1ec9b629ed0b" #edb/ref 17592186045417] [17592186320217 #edb/ref 1075 #edb/ref 17592186319973 #edb/ref 17592186045417] [17592186320217 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186320217 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186320217 #edb/ref 1078 #edb/ref 17592186319973 #edb/ref 17592186045417] [17592186320217 #edb/ref 1079 #uuid "1821c5d2-49ce-5bff-b99f-8c1d72774b8c" #edb/ref 17592186045417] [17592186320776 #edb/ref 1068 #edb/ref 17592186320217 #edb/ref 17592186045417] [17592186320776 #edb/ref 1069 "q-351049" #edb/ref 17592186045417] [17592186320776 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186320776 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186320776 #edb/ref 1072 #uuid "33a27144-255d-5b60-b9f6-96470ef99a2b" #edb/ref 17592186045417] [17592186320776 #edb/ref 1074 "First, we write the integral as\n\n$$\n{\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x={\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(4x+1)\\, & ⟹\\,{u}^{′}=\\frac{4}{4x+1} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x & ={\\int }_{0}^{({e}^{2}-1)/4}u{v}^{′}\\text{d}x \\\\  & =uv{|}_{0}^{({e}^{2}-1)/4}-{\\int }_{0}^{({e}^{2}-1)/4}v{u}^{′}\\text{d}x \\\\  & =\\operatorname{ln}⁡(4x+1)\\,(x){|}_{0}^{({e}^{2}-1)/4}-{\\int }_{0}^{({e}^{2}-1)/4}x(\\frac{4}{4x+1})\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡({e}^{2})(\\frac{{e}^{2}-1}{4})-{\\int }_{0}^{({e}^{2}-1)/4}\\frac{4x}{4x+1}\\,\\text{d}x \\\\  & =\\frac{{e}^{2}-1}{4}\\cdot 2-{\\int }_{0}^{({e}^{2}-1)/4}(1-\\frac{1}{4x+1})\\,\\text{d}x \\\\  & =\\frac{{e}^{2}-1}{2}-{[x-\\frac{1}{4}\\operatorname{ln}⁡(4x+1)]}_{0}^{({e}^{2}-1)/4} \\\\  & =\\frac{{e}^{2}-1}{2}-(\\frac{{e}^{2}-1}{4}-\\frac{1}{4}\\operatorname{ln}⁡({e}^{2})) \\\\  & =\\frac{{e}^{2}-1}{2}-(\\frac{{e}^{2}-1}{4}-\\frac{1}{2}) \\\\  & =\\frac{1}{4}({e}^{2}+1).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186345794 #edb/ref 1080 "\\frac{5{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C" #edb/ref 17592186045417] [17592186345794 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186345794 #edb/ref 1083 #uuid "32f9a77b-5187-5f1e-91ab-58857644655e" #edb/ref 17592186045417] [17592186346472 #edb/ref 1080 "\\frac{25{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)-1)+C" #edb/ref 17592186045417] [17592186346472 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346472 #edb/ref 1083 #uuid "7ff153a9-ddfd-5137-be96-19b18d9528c2" #edb/ref 17592186045417] [17592186346932 #edb/ref 1080 "\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C" #edb/ref 17592186045417] [17592186346932 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346932 #edb/ref 1083 #uuid "b5bb072c-6dc8-522d-8e1e-52a3e26e7e2a" #edb/ref 17592186045417] [17592186347130 #edb/ref 1080 "\\frac{5{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)+1)+C" #edb/ref 17592186045417] [17592186347130 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186347130 #edb/ref 1083 #uuid "cb6a35da-5e50-5868-9ffe-c00ba27afa4c" #edb/ref 17592186045417] [17592186347481 #edb/ref 1080 "\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)-1)+C" #edb/ref 17592186045417] [17592186347481 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186347481 #edb/ref 1083 #uuid "f121c972-8299-519a-85af-8e6e76287a3f" #edb/ref 17592186045417] [17592186347738 #edb/ref 1075 #edb/ref 17592186345794 #edb/ref 17592186045417] [17592186347738 #edb/ref 1075 #edb/ref 17592186346472 #edb/ref 17592186045417] [17592186347738 #edb/ref 1075 #edb/ref 17592186346932 #edb/ref 17592186045417] [17592186347738 #ed