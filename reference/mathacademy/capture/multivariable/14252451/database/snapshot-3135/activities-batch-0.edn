by Parts to Compute an Integral Containing an Arbitrary Logarithm"} :step/id #uuid "fdfdcd42-ada8-5eea-ae27-e68cd87d7470" :step/math-academy-id 618392 :step/next {:db/id #edb/ref 17592186097777}} {:db/id #edb/ref 17592186097777 :step/content {:db/id #edb/ref 17592186096836 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096427 :question/id #uuid "12811582-7156-5b84-9ba9-5545f87894f3" :question/math-academy-id "e-3993"} :knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759" :knowledge-point/questions [{:db/id #edb/ref 17592186097213} {:db/id #edb/ref 17592186097283} {:db/id #edb/ref 17592186250287} {:db/id #edb/ref 17592186250288} {:db/id #edb/ref 17592186250289} {:db/id #edb/ref 17592186250290} {:db/id #edb/ref 17592186250295} {:db/id #edb/ref 17592186319110} {:db/id #edb/ref 17592186320763} {:db/id #edb/ref 17592186320765} {:db/id #edb/ref 17592186320773} {:db/id #edb/ref 17592186320776} {:db/id #edb/ref 17592186332765} {:db/id #edb/ref 17592186348146} {:db/id #edb/ref 17592186348147} {:db/id #edb/ref 17592186348150} {:db/id #edb/ref 17592186424992} {:db/id #edb/ref 17592186487307} {:db/id #edb/ref 17592186487315} {:db/id #edb/ref 17592186487389} {:db/id #edb/ref 17592186573290}] :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing a Single Logarithmic Factor"} :step/id #uuid "c0d6168f-5f91-5b54-9679-17a077751add" :step/math-academy-id 618395}] :activity/title "Using Integration by Parts to Calculate Integrals With Logarithms" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096910}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186573340} :activity/id #uuid "af920dab-d21d-519f-94ec-030e66661d5b" :activity/scope {:db/id #edb/ref 17592186050521 :topic/id #uuid "5036af57-460d-5886-bb25-967e885ae634" :topic/math-academy-id 1140} :activity/steps [{:db/id #edb/ref 17592186573327 :step/content {:db/id #edb/ref 17592186250284 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "109b22a6-d3dd-5ed0-be45-6c1e67dc6541" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{4}(\\operatorname{ln}⁡(3x)-1)+C" :db/id #edb/ref 17592186247569} {:answer/id #uuid "229a39f8-42eb-5bb6-86d4-bbfff2c4c90a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{4}(2\\operatorname{ln}⁡(3x)-\\frac{1}{2})+C" :db/id #edb/ref 17592186247733} {:answer/id #uuid "506fd08e-5636-5073-8b9b-999fb05b57d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{4}(\\frac{\\operatorname{ln}⁡(3x)}{3}-1)+C" :db/id #edb/ref 17592186248145} {:answer/id #uuid "7c2a25c7-9320-5224-a084-275ada01afa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}(2\\operatorname{ln}⁡(3x)+1)+C" :db/id #edb/ref 17592186248516} {:answer/id #uuid "eccb6e3d-85c6-5f1b-b431-8c4a9a157def" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}(\\operatorname{ln}⁡(3x)+\\frac{1}{3})+C" :db/id #edb/ref 17592186249503}] :answer-field/correct {:db/id #edb/ref 17592186247733} :answer-field/id #uuid "2c8a9067-e08c-5e41-a1c1-212dc091969f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249755}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9fadab91-be05-5653-9838-592471a9067d" :question/math-academy-id "q-114555" :question/problem "Calculate $\\int 8{x}^{3}\\operatorname{ln}⁡(3x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(3x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=8{x}^{3}\\, & ⟹\\,v=\\int 8{x}^{3}\\,\\text{d}x=2{x}^{4}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 8{x}^{3}\\operatorname{ln}⁡(3x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(3x)\\cdot (2{x}^{4})-\\int \\frac{2{x}^{4}}{x}\\,\\text{d}x \\\\  & =2{x}^{4}\\operatorname{ln}⁡(3x)-2\\int {x}^{3}\\,\\text{d}x \\\\  & =2{x}^{4}\\operatorname{ln}⁡(3x)-2\\cdot \\frac{{x}^{4}}{4}+C \\\\  & =2{x}^{4}\\operatorname{ln}⁡(3x)-\\frac{{x}^{4}}{2}+C \\\\  & ={x}^{4}(2\\operatorname{ln}⁡(3x)-\\frac{1}{2})+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant."} :step/id #uuid "02ef4fc2-6aff-5366-8724-8878c0dcf4a7" :step/next {:db/id #edb/ref 17592186573332}} {:db/id #edb/ref 17592186573332 :step/content {:db/id #edb/ref 17592186250285 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f7ca2da-40f3-525c-bac6-b29d8480b2e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\operatorname{ln}⁡(2x)-1}{9{x}^{3}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186247986} {:answer/id #uuid "a01808c9-616c-59db-89e8-974a2c400333" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3\\operatorname{ln}⁡(2x)+1}{9{x}^{3}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186248852} {:answer/id #uuid "a30f743d-6b32-58c9-9c9b-527c9b8b888a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\operatorname{ln}⁡(2x)+1}{3{x}^{3}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186248883} {:answer/id #uuid "d8eb64cc-1ef2-5428-8c6b-e34b4c97b8be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{6\\operatorname{ln}⁡(2x)-1}{9{x}^{3}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186249336} {:answer/id #uuid "f65d4aa5-8ff1-5c46-aa50-cef0172e5477" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{6\\operatorname{ln}⁡(2x)+1}{2{x}^{3}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186249573}] :answer-field/correct {:db/id #edb/ref 17592186248852} :answer-field/id #uuid "80448976-ae2f-5f8d-b8a1-8ddcc578dda8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249892}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "67ee7e99-c327-5643-bad9-04c09862c4b7" :question/math-academy-id "q-114556" :question/problem "Calculate $\\int \\frac{{log}_{4}⁡(2x)}{{x}^{4}}\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{4}⁡(2x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡4} \\\\ {v}^{′}=\\frac{1}{{x}^{4}}\\, & ⟹\\,v=\\int \\frac{1}{{x}^{4}}\\,\\text{d}x=-\\frac{1}{3{x}^{3}}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{4}⁡(2x)}{{x}^{4}}\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{4}⁡(2x)\\cdot (-\\frac{1}{3{x}^{3}})-\\int (-\\frac{1}{3{x}^{3}})(\\frac{1}{x\\operatorname{ln}⁡4})\\,\\text{d}x \\\\  & =-\\frac{{log}_{4}⁡(2x)}{3{x}^{3}}+\\frac{1}{3\\operatorname{ln}⁡4}\\int \\frac{1}{{x}^{4}}\\,\\text{d}x \\\\  & =-\\frac{{log}_{4}⁡(2x)}{3{x}^{3}}+\\frac{1}{3\\operatorname{ln}⁡4}(-\\frac{1}{3{x}^{3}})+C \\\\  & =-\\frac{\\operatorname{ln}⁡(2x)}{3{x}^{3}\\operatorname{ln}⁡4}-\\frac{1}{9{x}^{3}\\operatorname{ln}⁡4}+C \\\\  & =-\\frac{3\\operatorname{ln}⁡(2x)+1}{9{x}^{3}\\operatorname{ln}⁡4}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{4}⁡(2x)=\\frac{\\operatorname{ln}⁡(2x)}{\\operatorname{ln}⁡4}.$"} :step/id #uuid "17953158-dc5b-538f-b42d-38a61d6989eb" :step/next {:db/id #edb/ref 17592186573336}} {:db/id #edb/ref 17592186573336 :step/content {:db/id #edb/ref 17592186320776 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdf24a8d-ae4b-5eb6-8100-1ec9b629ed0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}({e}^{2}+1)" :db/id #edb/ref 17592186319973}] :answer-field/correct {:db/id #edb/ref 17592186319973} :answer-field/id #uuid "1821c5d2-49ce-5bff-b99f-8c1d72774b8c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186320217}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "33a27144-255d-5b60-b9f6-96470ef99a2b" :question/math-academy-id "q-351049" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we write the integral as\n\n$$\n{\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x={\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(4x+1)\\, & ⟹\\,{u}^{′}=\\frac{4}{4x+1} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x & ={\\int }_{0}^{({e}^{2}-1)/4}u{v}^{′}\\text{d}x \\\\  & =uv{|}_{0}^{({e}^{2}-1)/4}-{\\int }_{0}^{({e}^{2}-1)/4}v{u}^{′}\\text{d}x \\\\  & =\\operatorname{ln}⁡(4x+1)\\,(x){|}_{0}^{({e}^{2}-1)/4}-{\\int }_{0}^{({e}^{2}-1)/4}x(\\frac{4}{4x+1})\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡({e}^{2})(\\frac{{e}^{2}-1}{4})-{\\int }_{0}^{({e}^{2}-1)/4}\\frac{4x}{4x+1}\\,\\text{d}x \\\\  & =\\frac{{e}^{2}-1}{4}\\cdot 2-{\\int }_{0}^{({e}^{2}-1)/4}(1-\\frac{1}{4x+1})\\,\\text{d}x \\\\  & =\\frac{{e}^{2}-1}{2}-{[x-\\frac{1}{4}\\operatorname{ln}⁡(4x+1)]}_{0}^{({e}^{2}-1)/4} \\\\  & =\\frac{{e}^{2}-1}{2}-(\\frac{{e}^{2}-1}{4}-\\frac{1}{4}\\operatorname{ln}⁡({e}^{2})) \\\\  & =\\frac{{e}^{2}-1}{2}-(\\frac{{e}^{2}-1}{4}-\\frac{1}{2}) \\\\  & =\\frac{1}{4}({e}^{2}+1).\\end{aligned}\n$$"} :step/id #uuid "26d7382c-5c45-5750-874b-f662d2fe988d"} {:db/id #edb/ref 17592186573340 :step/content {:db/id #edb/ref 17592186487315 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1906f549-d8e9-51f3-9aa5-d06ca5758ee2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x}{x+1}-x\\operatorname{ln}⁡x+C" :db/id #edb/ref 17592186486645} {:answer/id #uuid "7fecbefd-5753-5a0f-8312-d0deda0c7c9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\operatorname{ln}⁡(x+1)+\\operatorname{ln}⁡x+C" :db/id #edb/ref 17592186486871} {:answer/id #uuid "892da78f-ab77-5373-bbb0-fa9519ed8163" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\operatorname{ln}⁡(x+1)+\\operatorname{ln}⁡(x+1)-x+C" :db/id #edb/ref 17592186486892} {:answer/id #uuid "be07ae88-63bf-5eff-9610-cc4608d58779" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\operatorname{ln}⁡(x+1)-x+C" :db/id #edb/ref 17592186487012} {:answer/id #uuid "f30a460f-4f9b-5125-8fb4-707677000f2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\operatorname{ln}⁡x+\\operatorname{ln}⁡(x+1)+C" :db/id #edb/ref 17592186487112}] :answer-field/correct {:db/id #edb/ref 17592186486892} :answer-field/id #uuid "811f8ce1-3fa6-57be-909c-b7ba034a73fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186487208}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "328d9940-84c5-5488-9fa8-98ff5e7ef880" :question/math-academy-id "q-30481" :question/problem "$\\int \\operatorname{ln}⁡(x+1)\\,\\text{d}x=$" :question/worked-solution "First, we write the integral as\n\n$$\n\\int \\operatorname{ln}⁡(x+1)\\,\\text{d}x=\\int \\operatorname{ln}⁡(x+1)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x+1)\\, & ⟹\\,{u}^{′}=\\frac{1}{x+1} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int \\,\\text{d}x=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\operatorname{ln}⁡(x+1)\\,\\text{d}x & =\\int u\\,{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(x+1)\\cdot x-\\int x\\cdot \\frac{1}{x+1}\\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡(x+1)-\\int \\frac{x}{x+1}\\,\\text{d}x.\\end{aligned}\n$$\n\nNow, we use a substitution $x+1=u,$ thus $x=u-1$ and $\\text{d}x=\\text{d}u.$ Hence,\n\n$$\n\\begin{aligned}\\int \\operatorname{ln}⁡(x+1)\\,\\text{d}x & =x\\operatorname{ln}⁡(x+1)-\\int \\frac{x}{x+1}\\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡(x+1)-\\int \\frac{u-1}{u}\\,\\text{d}u \\\\  & =x\\operatorname{ln}⁡(x+1)-\\int \\,\\text{d}u+\\int \\frac{\\text{d}u}{u} \\\\  & =x\\operatorname{ln}⁡(x+1)-u+\\operatorname{ln}⁡u+D \\\\  & =x\\operatorname{ln}⁡(x+1)-(x+1)+\\operatorname{ln}⁡(x+1)+D \\\\  & =x\\operatorname{ln}⁡(x+1)+\\operatorname{ln}⁡(x+1)-x+C,\\end{aligned}\n$$\n\nwhere $C=D-1$ is an integral constant."} :step/id #uuid "2ee83862-481b-59f6-9170-4670c5a48d20" :step/next {:db/id #edb/ref 17592186573351}} {:db/id #edb/ref 17592186573351 :step/content {:db/id #edb/ref 17592186348144 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32f9a77b-5187-5f1e-91ab-58857644655e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C" :db/id #edb/ref 17592186345794} {:answer/id #uuid "7ff153a9-ddfd-5137-be96-19b18d9528c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)-1)+C" :db/id #edb/ref 17592186346472} {:answer/id #uuid "b5bb072c-6dc8-522d-8e1e-52a3e26e7e2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C" :db/id #edb/ref 17592186346932} {:answer/id #uuid "cb6a35da-5e50-5868-9ffe-c00ba27afa4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)+1)+C" :db/id #edb/ref 17592186347130} {:answer/id #uuid "f121c972-8299-519a-85af-8e6e76287a3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)-1)+C" :db/id #edb/ref 17592186347481}] :answer-field/correct {:db/id #edb/ref 17592186346932} :answer-field/id #uuid "4e201519-7ef2-5188-bf15-bd65e9d10b4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347738}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9218e349-d846-5b44-8076-17797f61e65a" :question/math-academy-id "q-78964" :question/problem "Calculate $\\int 25{x}^{4}{log}_{5}⁡(5x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{5}⁡(5x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡5} \\\\ {v}^{′}=25{x}^{4}\\, & ⟹\\,v=\\int 25{x}^{4}\\,\\text{d}x=5{x}^{5}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 25{x}^{4}{log}_{5}⁡(5x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{5}⁡(5x)\\cdot (5{x}^{5})-\\int \\frac{5{x}^{5}}{x\\operatorname{ln}⁡5}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{5}⁡(5x)-\\frac{1}{\\operatorname{ln}⁡5}\\int 5{x}^{4}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{5}⁡(5x)-\\frac{1}{\\operatorname{ln}⁡5}\\cdot {x}^{5}+C \\\\  & =\\frac{5{x}^{5}\\operatorname{ln}⁡(5x)}{\\operatorname{ln}⁡5}-\\frac{{x}^{5}}{\\operatorname{ln}⁡5}+C \\\\  & =\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{5}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡5}.$"} :step/id #uuid "7948fa76-ce4d-5231-a455-1425634143d6" :step/next {:db/id #edb/ref 17592186573327}}] :activity/title "Using Integration by Parts to Calculate Integrals With Logarithms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186572823}]}
