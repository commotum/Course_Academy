r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}3(t-1)^{2}-2{e}^{5t-3}\\,dt.\\end{aligned}\n$$" 13194139534227 17592186045417 true] [17592186414923 1068 #edb/ref 17592186414907 13194139534227 17592186045417 true] [17592186414923 1069 "q-125143" 13194139534227 17592186045417 true] [17592186414923 1070 #edb/ref 17592186045485 13194139534227 17592186045417 true] [17592186414923 1071 "Which of the following is equivalent to the integral ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=\\sqrt{y}\\,i+{e}^{x}\\,j$ and $C$ is the curve $\\operatorname{ln}⁡y=x-2$ traversed from the point $A(2,1)$ to the point $B(4,{e}^{2})?$\n\n*Hint: Use the parametrization $r(t)=(\\operatorname{ln}⁡t+2)\\,i+t\\,j.$*" 13194139534227 17592186045417 true] [17592186414923 1072 #uuid "7481ae6d-9732-54c0-9a0f-c47726a9f80a" 13194139534227 17592186045417 true] [17592186414923 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the curve. This is given by\n\n$$\n\\begin{aligned}r(t) & =(\\operatorname{ln}⁡t+2)\\,i+t\\,j,\\,1\\le t\\le {e}^{2}.\\end{aligned}\n$$\n\nThus, along the curve $C,$ we have\n\n$$\nx=\\operatorname{ln}⁡t+2,\\,y=t.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & =\\sqrt{y}\\,i+{e}^{x}\\,j \\\\  & =\\sqrt{t}\\,i+{e}^{\\operatorname{ln}⁡t+2}\\,j \\\\  & =\\sqrt{t}\\,i+t{e}^{2}\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t+2)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =\\frac{1}{t}\\,i+j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\sqrt{t}\\,i+t{e}^{2}\\,j)\\cdot (\\frac{1}{t}\\,i+j) \\\\  & =\\sqrt{t}\\cdot \\frac{1}{t}+t{e}^{2} \\\\  & =\\frac{1}{\\sqrt{t}}+{e}^{2}t.\\end{aligned}\n$$\n\nFinally, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{1}^{{e}^{2}}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{1}^{{e}^{2}}(\\frac{1}{\\sqrt{t}}+{e}^{2}t)\\,dt.\\end{aligned}\n$$" 13194139534227 17592186045417 true] [17592186414924 1068 #edb/ref 17592186414908 13194139534227 17592186045417 true] [17592186414924 1069 "q-125028" 13194139534227 17592186045417 true] [17592186414924 1070 #edb/ref 17592186045487 13194139534227 17592186045417 true] [17592186414924 1071 "Evaluate ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=x\\,i+y\\,j$ and $C$ is the curve $y=\\sqrt{{x}^{2}+9}$ traversed from the point $A(0,3)$ to the point $B(4,5).$" 13194139534227 17592186045417 true] [17592186414924 1072 #uuid "78546b3f-b852-5bf0-8988-10eb32837ae5" 13194139534227 17592186045417 true] [17592186414924 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the curve. Since $y$ is the subject of the equation, a parametrization is given by\n\n$$\n\\begin{aligned}r(t) & =t\\,i+\\sqrt{{t}^{2}+9}\\,j,\\,0\\le t\\le 4.\\end{aligned}\n$$\n\nThus, along the curve $C,$ we have\n\n$$\nx=t,\\,y=\\sqrt{{t}^{2}+9}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & =t\\,i+\\sqrt{{t}^{2}+9}\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(\\sqrt{{t}^{2}+9})j \\\\  & =i+\\frac{t}{\\sqrt{{t}^{2}+9}}\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(t\\,i+\\sqrt{{t}^{2}+9}\\,j)\\cdot (i+\\frac{t}{\\sqrt{{t}^{2}+9}}\\,j) \\\\  & =t\\cdot 1+\\sqrt{{t}^{2}+9}\\cdot \\frac{t}{\\sqrt{{t}^{2}+9}} \\\\  & =2t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{4}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}2t\\,dt \\\\  & ={t}^{2}{|}_{0}^{4} \\\\  & =16\\end{aligned}\n$$" 13194139534227 17592186045417 true] [17592186414925 1068 #edb/ref 17592186414915 13194139534227 17592186045417 true] [17592186414925 1069 "q-125036" 13194139534227 17592186045417 true] [17592186414925 1070 #edb/ref 17592186045487 13194139534227 17592186045417 true] [17592186414925 1071 "Evaluate ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)={e}^{x}\\,i+\\operatorname{ln}⁡y\\,j$ and $C$ is the curve $y={e}^{x}$ traversed from the point $A(0,1)$ to the point $B(2,{e}^{2}).$" 13194139534227 17592186045417 true] [17592186414925 1072 #uuid "88b1af01-ca8c-54ff-810f-7581fa6aee53" 13194139534227 17592186045417 true] [17592186414925 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the curve. Since $y$ is the subject of the equation, a parametrization is given by\n\n$$\n\\begin{aligned}r(t) & =t\\,i+{e}^{t}\\,j,\\,0\\le t\\le 2.\\end{aligned}\n$$\n\nThus, along the curve $C,$ we have\n\n$$\nx=t,\\,y={e}^{t}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & ={e}^{t}\\,i+\\operatorname{ln}⁡({e}^{t})\\,j \\\\  & ={e}^{t}\\,i+t\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})j \\\\  & =i+{e}^{t}\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =({e}^{t}\\,i+t\\,j)\\cdot (i+{e}^{t}\\,j) \\\\  & ={e}^{t}+t{e}^{t}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{2}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}({e}^{t}+t{e}^{t})\\,dt \\\\  & =t{e}^{t}{|}_{0}^{2} \\\\  & =2{e}^{2}.\\end{aligned}\n$$" 13194139534227 17592186045417 true] [17592186414926 1068 #edb/ref 17592186414914 13194139534227 17592186045417 true] [17592186414926 1069 "q-76984" 13194139534227 17592186045417 true] [17592186414926 1070 #edb/ref 17592186045485 13194139534227 17592186045417 true] [17592186414926 1071 "![](images/fb/fb8c2591ed5068812fa1d184d4a93a6c71b0d2ef77bb01debd4b2a03211742f7.png)\n\nWhich of the following is equivalent to the integral ${\\int }_{C}F(r)\\cdot \\text{d}r,$ where $F(x,y)=2x\\,i+5y\\,j$ and $C$ is the the arc of the ellipse centered at the origin with horizontal and vertical semiaxes $2$ and $4$ respectively, traversed anticlockwise from $A(2,0)$ to $B(0,4).$\n\n*Hint: Use the parametrization $r(t)=2\\operatorname{cos}⁡t\\,i+4\\operatorname{sin}⁡t\\,j.$*" 13194139534227 17592186045417 true] [17592186414926 1072 #uuid "d9322f25-3d78-5fb4-87e7-1e944f82fbf4" 13194139534227 17592186045417 true] [17592186414926 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to find the parametrization of an ellipse centered at the origin with horizontal and vertical semiaxes $2$ and $4$ respectively. It can be parametrized as \n\n$$\nr(t)=2\\operatorname{cos}⁡t\\,i+4\\operatorname{sin}⁡t\\,j,\\,0\\le t\\le \\frac{\\pi }{2}.\n$$\n\nSo, along the curve $C,$ we have\n\n$$\nx=2\\operatorname{cos}⁡t,\\,y=4\\operatorname{sin}⁡t.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}F(r(t)) & =2x\\,i+5y\\,j \\\\  & =4\\operatorname{cos}⁡t\\,i+20\\operatorname{sin}⁡t\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+4\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(4\\operatorname{cos}⁡t\\,i+20\\operatorname{sin}⁡t\\,j)\\cdot (-2\\operatorname{sin}⁡t\\,i+4\\operatorname{cos}⁡t\\,j) \\\\  & =4\\operatorname{cos}⁡t\\cdot (-2\\operatorname{sin}⁡t)+20\\operatorname{sin}⁡t\\cdot 4\\operatorname{cos}⁡t \\\\  & =72\\operatorname{sin}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}F(r)\\cdot \\text{d}r & ={\\int }_{0}^{\\pi /2}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & =72{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,dt.\\end{aligned}\n$$" 13194139534227 17592186045417 true] [17592186414927 1068 #edb/ref 17592186414905 13194139534227 17592186045417 true] [17592186414927 1069 "q-125115" 13194139534227 17592186045417 true] [17592186414927 1070 #edb/ref 17592186045485 13194139534227 17592186045417 true] [17592186414927 1071 "Which of the following is equivalent to the integral ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)={x}^{2}\\,i+\\operatorname{ln}⁡y\\,j$ and $C$ is the curve $y={e}^{2x}$ traversed from the point $A(0,1)$ to the point $B(1,{e}^{2})?$\n\n*Hint: Use the parametrization $r(t)=t\\,i+{e}^{2t}\\,j.$*" 13194139534227 17592186045417 true] [17592186414927 1072 #uuid "e11373c8-2017-5040-89cd-e12dc0c5ae7b" 13194139534227 17592186045417 true] [17592186414927 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the curve. This is given by\n\n$$\n\\begin{aligned}r(t) & =t\\,i+{e}^{2t}\\,j,\\,0\\le t\\le 1.\\end{aligned}\n$$\n\nThus, along the curve $C,$ we have\n\n$$\nx=t,\\,y={e}^{2t}.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & ={x}^{2}\\,i+\\operatorname{ln}⁡y\\,j \\\\  & ={t}^{2}\\,i+\\operatorname{ln}⁡{e}^{2t}\\,j \\\\  & ={t}^{2}\\,i+2t\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}({e}^{2t})j \\\\  & =i+2{e}^{2t}\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =({t}^{2}\\,i+2t\\,j)\\cdot (i+2{e}^{2t}\\,j) \\\\  & ={t}^{2}\\cdot 1+2t\\cdot 2{e}^{2t} \\\\  & ={t}^{2}+4t{e}^{2t}.\\end{aligned}\n$$\n\nFinally, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{t}^{2}+4t{e}^{2t}\\,dt \\\\  & ={\\int }_{0}^{1}t(t+4{e}^{2t})\\,dt.\\end{aligned}\n$$" 13194139534227 17592186045417 true] [17592186414928 1068 #edb/ref 17592186414913 13194139534227 17592186045417 true] [17592186414928 1069 "q-125045" 13194139534227 17592186045417 true] [17592186414928 1070 #edb/ref 17592186045485 13194139534227 17592186045417 true] [17592186414928 1071 "Which of the following is equivalent to ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=\\operatorname{cos}⁡(x-y)\\,i+\\operatorname{sin}⁡(x+y)\\,j$ and $C$ is the line segment traversed from the point $A(-1,-2)$ to the point $B(3,4)?$\n\n*Hint: Use the parametrization $r(t)=(-1+4t)\\,i+(-2+6t)\\,j.$*" 13194139534227 17592186045417 true] [17592186414928 1072 #uuid "f6d2f16c-f6f5-5918-ae9d-9d7f59f7eba9" 13194139534227 17592186045417 true] [17592186414928 1074 "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nFirst, we need to parameterize the line segment.\nThe position vectors of the endpoints of our line segment are \n$a=-i-2\\,j$ and $b=3\\,i+4\\,j.$\nSo, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t(b-a) \\\\  & =(-i-2\\,j)+t[(3\\,i+4\\,j)-(-i-2\\,j)] \\\\  & =(-i-2\\,j)+t(4\\,i+6\\,j) \\\\  & =(-1+4t)\\,i+(-2+6t)\\,j,\\end{aligned}\n$$\n\nwhere $t$ varies from $t=0$ (at the point $A$) to $t=1$ (at the point $B$).\nThus, along the curve $C,$ we have\n\n$$\nx=-1+4t,\\,y=-2+6t.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}F(r(t)) & =\\operatorname{cos}⁡(x-y)\\,i+\\operatorname{sin}⁡(x+y)\\,j \\\\  & =\\operatorname{cos}⁡(-1+4t+2-6t)\\,i+\\operatorname{sin}⁡(-1+4t-2+6t)\\,j \\\\  & =\\operatorname{cos}⁡(1-2t)\\,i+\\operatorname{sin}⁡(10t-3)\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(-1+4t)i+\\frac{\\text{d}}{\\text{d}t}(-2+6t)j \\\\  & =4\\,i+6\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\operatorname{cos}⁡(1-2t)\\,i+\\operatorname{sin}⁡(10t-3)\\,j)\\cdot (4\\,i+6\\,j) \\\\  & =\\operatorname{cos}⁡(1-2t)\\cdot 4+\\operatorname{sin}⁡(10t-3)\\cdot 6 \\\\  & =4\\operatorname{cos}⁡(1-2t)+6\\operatorname{sin}⁡(10t-3).\\end{aligned}\n$$\n\nFinally, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}4\\operatorname{cos}⁡(1-2t)+6\\operatorname{sin}⁡(10t-3)\\,dt.\\end{aligned}\n$$" 13194139534227 17592186045417 true]] :edb/tempids {"answer-00790b3e-1877-50c1-bfcc-d335a0c8a0b2" 17592186414827 "answer-02315312-3684-5faa-a71f-6939225f794e" 17592186414828 "answer-02e28cc7-f7f3-51e1-bea0-158eef714f3a" 17592186414829 "answer-04de95bf-b731-52c7-8b53-b252f4ea7fbe" 17592186414830 "answer-08339a10-b80f-5555-8e33-e4cd3d9e86b5" 17592186414831 "answer-09128715-0b6a-5c9a-b7c4-82cfe1932e05" 17592186414832 "answer-0a2b4e96-c35f-5329-ad67-9ac58f667665" 17592186414833 "answer-0b0df5d3-d93a-5f24-a344-46796aad3425" 17592186414834 "answer-0b4c3f95-dd3c-596d-a9e6-8060319b1532" 17592186414835 "answer-0e6cbea4-6185-5837-b0fb-bf0cbd81d253" 17592186414836 "answer-1263d5b8-2a16-5cf4-bfba-339ea29a3a16" 17592186414837 "answer-130b870f-02ff-5d3c-ab1b-056597b4e00c" 17592186414838 "answer-1f27ef8e-0147-52c1-a878-3bfc73978cca" 17592186414839 "answer-223c9332-33d1-56cf-a05c-ba7cb8a837f9" 17592186414840 "answer-23d81859-b818-5dab-8b5b