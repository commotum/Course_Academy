#uuid "3674a427-b1f6-5423-9cad-a53248cc1526" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186434668} :answer-field/id #uuid "2bbf6504-629f-56a6-8d02-ea8b2cdc4409" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434737}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c719ba47-2cb2-55e7-85ae-fa0a3ade984e" :question/math-academy-id "q-164153" :question/problem "![](images/79/79971602dd6834147c3db9361c94853a5a66c8e899978df3629d2841326fe62c.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local maximum points?" :question/worked-solution "A function $f(x,y)$ has a local maximum point at $(a,b)$ if $f(x,y)\\le f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the highest point on the graph in the neighborhood.\n\nSuch neighborhood exists for the point $B.$ Hence, $B$ is a local maximum.\n\n![](images/68/685c03b86db93032c8a79334c5fa46c561dd263a9aa4f52b9d7e6f41c3bb827c.png)"}] [{:db/id #edb/ref 17592186434765 :knowledge-point/_questions [{:db/id #edb/ref 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d1effde-74f3-572c-895a-c689fd4d6886" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186434663} {:answer/id #uuid "8e775825-6245-5d2d-930c-aa1a6446fcc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186434696} {:answer/id #uuid "d3fc7d81-3c2e-547e-b4b6-9d3a5644b96e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186434722} {:answer/id #uuid "e27f6f79-0b4c-502b-ae85-1bf343f859a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ and $D$ only" :db/id #edb/ref 17592186434724} {:answer/id #uuid "e36fc252-161e-5249-b04c-21f5ae164898" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186434725}] :answer-field/correct {:answer/id #uuid "e36fc252-161e-5249-b04c-21f5ae164898" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186434725} :answer-field/id #uuid "4706282d-9a32-5f14-a57a-fcb85720d9bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434738}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e9cc186b-22af-55d8-bf89-1dd19ae7b90f" :question/math-academy-id "q-164154" :question/problem "![](images/81/81604581fae8b25776727eca4450caa7d48c42a781706455ed585d5cfc4a25fa.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local maximum points?" :question/worked-solution "A function $f(x,y)$ has a local maximum point at $(a,b)$ if $f(x,y)\\le f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the highest point on the graph in the neighborhood.\n\nSuch regions exist for the points $A$ and $C.$ Hence $A$ and $C$ are local maximum points.\n\n**Note**: For the point $A({x}_{A},{y}_{A},{z}_{A}),$ there are points $(x,y)$ in the surrounding regions such that $f({x}_{A},{y}_{A})=f(x,y).$ However, since the definition of local extrema is non-strict, $f(x,y)\\le f(a,b)$, the point $A$ does satisfy the conditions for a local maximum.\n\n![](images/36/3651b43178819666002775a26071a0bd2c9cb48b58a3c5516c38e085d50fc4a6.png)"}] [{:db/id #edb/ref 17592186434757 :knowledge-point/_questions [{:db/id #edb/ref 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04a2ce01-d899-5e97-a2f6-d48bd4f3ca01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $D$ only" :db/id #edb/ref 17592186434657} {:answer/id #uuid "0f25997d-4b61-53ec-9106-4119ee276f82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186434658} {:answer/id #uuid "1d15721b-98b5-5633-b7d7-1d495541a3bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ only" :db/id #edb/ref 17592186434662} {:answer/id #uuid "be45631c-d2cc-5229-b439-7b9b97ac9ee8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186434713} {:answer/id #uuid "fc9794fd-5fc3-53d2-9e31-d96573402693" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186434734}] :answer-field/correct {:answer/id #uuid "04a2ce01-d899-5e97-a2f6-d48bd4f3ca01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $D$ only" :db/id #edb/ref 17592186434657} :answer-field/id #uuid "dd8d1baf-33b0-5256-8cc7-c9e816543e66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434749}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f6e52f3-8502-516e-a6ab-c65771746796" :question/math-aca