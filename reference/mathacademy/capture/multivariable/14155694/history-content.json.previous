y=\"0\"></use>\n <use xlink:href=\"#E16-MJMAIN-29\" x=\"1323\" y=\"0\"></use>\n</g>\n<g transform=\"translate(37,-750)\">\n <use xlink:href=\"#E16-MJMATHI-79\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E16-MJMAIN-28\" x=\"497\" y=\"0\"></use>\n <use xlink:href=\"#E16-MJMATHI-74\" x=\"887\" y=\"0\"></use>\n <use xlink:href=\"#E16-MJMAIN-29\" x=\"1248\" y=\"0\"></use>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E16-MJSZ3-5D\" x=\"2565\" y=\"-1\"></use>\n <use xlink:href=\"#E16-MJMAIN-3D\" x=\"3371\" y=\"0\"></use>\n<g transform=\"translate(4427,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"620\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E16-MJMAIN-31\" x=\"60\" y=\"676\"></use>\n <use xlink:href=\"#E16-MJMAIN-33\" x=\"60\" y=\"-686\"></use>\n</g>\n</g>\n<g transform=\"translate(5288,0)\">\n <use xlink:href=\"#E16-MJSZ3-5B\"></use>\n<g transform=\"translate(695,0)\">\n<g transform=\"translate(-11,0)\">\n<g transform=\"translate(0,633)\">\n <use xlink:href=\"#E16-MJMATHI-65\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(466,362)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E16-MJMAIN-33\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E16-MJMATHI-74\" x=\"500\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E16-MJMAIN-2212\" x=\"1398\" y=\"0\"></use>\n <use xlink:href=\"#E16-MJMAIN-31\" x=\"2398\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E16-MJMAIN-30\" x=\"1199\" y=\"-767\"></use>\n</g>\n</g>\n <use xlink:href=\"#E16-MJSZ3-5D\" x=\"3751\" y=\"-1\"></use>\n</g>\n <use xlink:href=\"#E16-MJMAIN-2E\" x=\"9734\" y=\"0\"></use>\n</g>\n</svg>",
