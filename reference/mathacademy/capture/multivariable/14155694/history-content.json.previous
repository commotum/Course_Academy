x solid black;\" width=\"5px\"></td>\n<td style=\"text-align:center; border:hidden;\" width=\"80px\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"478\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"3\"><mjx-c class=\"mjx-c1D460 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D452 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi></mjx-texatom></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo stretchy=\"false\">(</mo><mi>t</mi><mo>−</mo><mi>s</mi><mo stretchy=\"false\">)</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><mi>t</mi></mrow></msup></math></mjx-assistive-mml></mjx-container></td>\n<td style=\"text-align:center; border:1px solid black;\" width=\"5px\"></td>\n<td height=\"30px\" rowspan=\"2\" style=\"text-align:center; border:1px solid black; border-right:hidden; border-top:hidden; border-bottom:hidden;\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"479\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D460 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>s</mi></math></mjx-assistive-mml></mjx-container></td>\n</tr>\n<tr>\n<td style=\"text-align:center; border:1px solid black; border-top:hidden;\"></td>\n<td style=\"text-align:center; border:hidden;\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"480\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn></math></mjx-assistive-mml></mjx-container></td>\n<td style=\"text-align:center; border:1px solid black; border-top:hidden;\"></td>\n<td style=\"text-align:center; border:1px solid black; border-top:hidden;\"></td>\n<td style=\"text-align:center; border:hidden;\"><div ;=\"\" class=\"freeResponseTextbox\" id=\"freeResponseTextbox-2\" style=\"min-width:76px;\n                                        margin-left:4px;\n                                        margin-right:4px;\n                                        background:;\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"481\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D452 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi></mjx-texatom></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><mi>t</mi></mrow></msup></math></mjx-assistive-mml></mjx-container></div></td>\n<td style=\"text-align:center; border:1px solid black; border-top:hidden;\"></td>\n</tr>\n</tbody></table></div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Mon, Oct 12th @ 7:57 PM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:27</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>"
    },
    {
      "dom_id": "question-335088",
      "name": null,
      "problem": "$$\n\\{\\begin{aligned}{x}^{′}(t)=3y(t) \\\\ {y}^{′}(t)=3x(t)+3,\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(3t) & \\operatorname{sinh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t) & \\operatorname{cosh}⁡(3t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 3 \\\\ 3 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td rowspan=\"2\" height=\"30px\" align=\"center\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td width=\"5px\" height=\"40px\" align=\"center\"></td>\n<td width=\"80px\" align=\"center\">{{field-1}}</td>\n<td width=\"5px\" align=\"center\"></td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\operatorname{sinh}⁡(3t)$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>",
      "worked_solution": "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 3 \\\\ 3 & 0\\end{aligned}]x(t)+g(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $g(t)=[\\begin{aligned}0 \\\\ 3\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 3 \\\\ 3 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(3t) & \\operatorname{sinh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t) & \\operatorname{cosh}⁡(3t)\\end{aligned}].\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(3t) & \\operatorname{sinh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t) & \\operatorname{cosh}⁡(3t)\\end{aligned}][\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cosh}⁡(3(t-s)) & \\operatorname{sinh}⁡(3(t-s)) \\\\ \\operatorname{sinh}⁡(3(t-s)) & \\operatorname{cosh}⁡(3(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cosh}⁡(3(t-s)) & \\operatorname{sinh}⁡(3(t-s)) \\\\ \\operatorname{sinh}⁡(3(t-s)) & \\operatorname{cosh}⁡(3(t-s))\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}3\\operatorname{sinh}⁡(3(t-s)) \\\\ 3\\operatorname{cosh}⁡(3(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}3\\operatorname{sinh}⁡(3(t-s)) \\\\ 3\\operatorname{cosh}⁡(3(t-s))\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}-\\operatorname{cosh}⁡(3(t-s)) \\\\ -\\operatorname{sinh}⁡(3(t-s))\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(3t)-1 \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]+[\\begin{aligned}\\operatorname{cosh}⁡(3t)-1 \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(3t)-1 \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}].\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "field-1",
          "type": "select",
          "dom_id": "selectList-335088-0",
          "tag": "custom-select",
          "choices": [
            {
              "option": "0",
              "dom_id": null,
