07)\" xlink:href=\"#E15-MJMAIN-61\" x=\"556\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-72\" x=\"1057\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-74\" x=\"1449\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-69\" x=\"1838\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-63\" x=\"2117\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-75\" x=\"2562\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-6C\" x=\"3118\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-61\" x=\"3397\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-72\" x=\"3897\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-73\" x=\"4643\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-6F\" x=\"5038\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-6C\" x=\"5538\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-75\" x=\"5817\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-74\" x=\"6373\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-69\" x=\"6763\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-6F\" x=\"7041\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E15-MJMAIN-6E\" x=\"7542\" y=\"0\"></use>\n</g>\n</g>\n <use xlink:href=\"#E15-MJMAIN-2C\" x=\"17334\" y=\"0\"></use>\n</g>\n</svg></span>\nwhere the first term represents the solution of the corresponding <em>homogeneous system</em>, and the second term gives a particular solution of our <em>inhomogeneous system</em>.</p>\n<p>Let's see some concrete examples.</p>\n\n        </div>",
