      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14155694/observations/lesson-step-589677-3111c5114a3006a212d8.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14155694/observations/lesson-step-589677-3111c5114a3006a212d8.png",
      "source_url": "https://mathacademy.com/topics/6691",
      "captured_at": 1791860872.5410447,
      "math_academy_id": "e-21722",
      "knowledge_point": "Identifying the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System",
