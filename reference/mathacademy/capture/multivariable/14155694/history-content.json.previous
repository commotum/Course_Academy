=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-texatom></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>A</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo>+</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy=\"false\">)</mo></mrow></msup></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></div></div></div>.</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Mon, Oct 12th @ 8:01 PM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:46</span><span class=\"answerResult\"><span style=\"color: red;\">Incorrect</span></span></div></div>"
