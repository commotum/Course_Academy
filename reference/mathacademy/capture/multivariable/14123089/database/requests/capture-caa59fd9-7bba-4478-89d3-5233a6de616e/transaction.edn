c0550cc8-1e70-5b33-a933-86d8547c33f0"] :db/ensure [:answer-field/validate]} {:db/id "answer-9002da34-adee-5fd2-97a1-8734bc2469a8" :answer/id #uuid "9002da34-adee-5fd2-97a1-8734bc2469a8" :answer/type :answer.type/math :answer/value "\\frac{1}{3\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-8b152deb-21e4-59fd-b556-58f7250c99d4" :answer/id #uuid "8b152deb-21e4-59fd-b556-58f7250c99d4" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-da0d6133-3f39-5da4-a015-da90ba3e809f" :answer/id #uuid "da0d6133-3f39-5da4-a015-da90ba3e809f" :answer/type :answer.type/math :answer/value "\\frac{1}{\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-c0550cc8-1e70-5b33-a933-86d8547c33f0" :answer/id #uuid "c0550cc8-1e70-5b33-a933-86d8547c33f0" :answer/type :answer.type/math :answer/value "\\frac{3}{\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-field-c2939d33-2683-5e5e-b87f-2f0d344063b9" :answer-field/id #uuid "c2939d33-2683-5e5e-b87f-2f0d344063b9" :answer-field/key "field-5" :answer-field/type :answer-field.type/select :answer-field/correct "answer-c8e1fc56-3d17-5a34-80f2-d7006b2e8f19" :answer-field/choices ["answer-4d7363a2-f6fb-591f-8bc8-86df8ca571e5" "answer-5af7a6f0-0077-5043-a558-dd52db115cb0" "answer-c8e1fc56-3d17-5a34-80f2-d7006b2e8f19" "answer-736d59ea-f33a-5ef5-b1fc-b2bef5e99802" "answer-2922dcf4-46a6-5e52-9fe3-e574cf0d2c19" "answer-b13038c9-0e29-5c99-ae13-0cda1eb89b60"] :db/ensure [:answer-field/validate]} {:db/id "answer-4d7363a2-f6fb-591f-8bc8-86df8ca571e5" :answer/id #uuid "4d7363a2-f6fb-591f-8bc8-86df8ca571e5" :answer/type :answer.type/math :answer/value "{\\int }_{-3}^{3}{x}^{3}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-5af7a6f0-0077-5043-a558-dd52db115cb0" :answer/id #uuid "5af7a6f0-0077-5043-a558-dd52db115cb0" :answer/type :answer.type/math :answer/value "{\\int }_{-3}^{3}{x}^{3}\\operatorname{cos}⁡(2\\pi x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-c8e1fc56-3d17-5a34-80f2-d7006b2e8f19" :answer/id #uuid "c8e1fc56-3d17-5a34-80f2-d7006b2e8f19" :answer/type :answer.type/math :answer/value "{\\int }_{-3}^{3}{x}^{3}\\operatorname{sin}⁡(2\\pi x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-736d59ea-f33a-5ef5-b1fc-b2bef5e99802" :answer/id #uuid "736d59ea-f33a-5ef5-b1fc-b2bef5e99802" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }{x}^{3}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-2922dcf4-46a6-5e52-9fe3-e574cf0d2c19" :answer/id #uuid "2922dcf4-46a6-5e52-9fe3-e574cf0d2c19" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }{x}^{3}\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-b13038c9-0e29-5c99-ae13-0cda1eb89b60" :answer/id #uuid "b13038c9-0e29-5c99-ae13-0cda1eb89b60" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }{x}^{3}\\operatorname{sin}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id 17592186222024 :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{2}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{2}x)\n$$\n\nThe Fourier series of the $4$-periodic extension $f(x)$ of the function \n\n$$\nF(x)=\\{\\begin{aligned}2, & x\\in [0,2) \\\\ -1, & x\\in [-2,0)\\end{aligned}\n$$\n\nis shown above. Find the exact value of ${a}_{3}.$\n\n${a}_{3}=$ {{field-1}}" :db/ensure [:question/validate]} {:db/id "question-fc8861f3-8c91-59c6-b70f-78e5364379e8" :question/id #uuid "fc8861f3-8c91-59c6-b70f-78e5364379e8" :question/math-academy-id "q-341817" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)\n$$\n\nThe Fourier series of the $2\\pi $-periodic extension $f(x)$ of the function \n\n$$\nF(x)=\\{\\begin{aligned}-2, & x\\in [0,\\pi ) \\\\ 3, & x\\in [-\\pi ,0)\\end{aligned}\n$$\n\nis shown above. Find the exact value of ${a}_{4}.$\n\n${a}_{4}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=\\pi .$ Also, $f(x)=-2$ for $x\\in [0,\\pi )$ and $f(x)=3$ for $x\\in [-\\pi ,0).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(4x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{0}3\\operatorname{cos}⁡(4x)\\,\\text{d}x+\\frac{1}{\\pi }{\\int }_{0}^{\\pi }(-2)\\operatorname{cos}⁡(4x)\\,\\text{d}x \\\\  & =\\frac{3}{\\pi }\\cdot \\frac{1}{4}{[\\operatorname{sin}⁡(4x)]}_{-\\pi }^{0}-\\frac{2}{\\pi }\\cdot \\frac{1}{4}{[\\operatorname{sin}⁡(4x)]}_{0}^{\\pi } \\\\  & =\\frac{3}{4\\pi }(\\operatorname{sin}⁡(0)-\\operatorname{sin}⁡(-4\\pi ))-\\frac{1}{2\\pi }(\\operatorname{sin}⁡(4\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ce23bf5e-8b29-5cf7-9b38-cc60d7fad1c9"] :db/ensure [:question/validate]} {:db/id "answer-field-ce23bf5e-8b29-5cf7-9b38-cc60d7fad1c9" :answer-field/id #uuid "ce23bf5e-8b29-5cf7-9b38-cc60d7fad1c9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-186b12e8-0537-5623-ab6f-d5dfb2e0cdcc" :answer-field/choices ["answer-186b12e8-0537-5623-ab6f-d5dfb2e0cdcc"] :db/ensure [:answer-field/validate]} {:db/id "answer-186b12e8-0537-5623-ab6f-d5dfb2e0cdcc" :answer/id #uuid "186b12e8-0537-5623-ab6f-d5dfb2e0cdcc" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id 17592186222514 :tutorial/content "When a function has period $2L$ (instead of $2\\pi$), the \"usual\" Fourier formulas still work, but the sine and cosine inputs must be rescaled so that each term completes an integer number of oscillations over one period. \n\nWe do this by converting the $2L$-periodic function into a $2\\pi$-periodic one using a change of variables.\n\nLet $f(x)$ be the $2L$-periodic extension of a function $F(x)$ from $x\\in[-L,L)$ to $x\\in\\mathbb{R}$.\nTo use the standard $2\\pi$-period Fourier formulas, define\n\n$$\ns=\\frac{\\pi}{L}x\n\\qquad\\text{and}\\qquad\ng(s)=f\\!\\left(\\frac{L}{\\pi}s\\right).\n$$\n\nThen $g$ is $2\\pi$-periodic.\n\nFor a $2\\pi$-periodic function $g$, the Fourier series is\n\n$$\ng(s)\\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}\\bigl(a_n\\cos(ns)+b_n\\sin(ns)\\bigr),\n$$\n\nwhere\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\,ds, \\\\ {a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(ns)\\,ds,\\,n\\ge 1, \\\\ {b}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{sin}⁡(ns)\\,ds,\\,n\\ge 1.\\end{aligned}\n$$\n\nNow substitute $g(s)=f\\!\\left(\\dfrac{L}{\\pi}s\\right)$ and $s=\\dfrac{\\pi}{L}x$.\nFirst, for $a_n{:}$\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(ns)\\,ds \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f\\,(\\frac{L}{\\pi }s)\\operatorname{cos}⁡(ns)\\,ds \\\\  & =\\frac{1}{\\pi }{\\int }_{-L}^{L}f\\,(\\frac{L}{\\pi }\\cdot \\frac{\\pi }{L}x)cos\\,(n\\cdot \\frac{\\pi }{L}x)\\,d\\,(\\frac{\\pi }{L}x) \\\\  & =\\frac{1}{\\pi }\\cdot \\frac{\\pi }{L}{\\int }_{-L}^{L}f(x)cos\\,(\\frac{n\\pi }{L}x)\\,dx \\\\  & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)cos\\,(\\frac{n\\pi }{L}x)\\,dx\\end{aligned}\n$$\n\nCoefficients $b_n$ (for $n \\geq 1$) and $a_0$ can be found similarly.\n\nTo summarize, the Fourier series of $f$ is\n\n$$\nf(x)\\sim \\frac{a_0}{2}+\\sum_{n=1}^{\\infty}\\left(a_n\\cos\\!\\left(\\frac{n\\pi}{L}x\\right)+b_n\\sin\\!\\left(\\frac{n\\pi}{L}x\\right)\\right),\n$$\n\nwhere the coefficients are the following:\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,dx \\\\ {a}_{n} & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)cos\\,(\\frac{n\\pi }{L}x)\\,dx,\\,n\\ge 1 \\\\ {b}_{n} & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)sin\\,(\\frac{n\\pi }{L}x)\\,dx,\\,n\\ge 1\\end{aligned}\n$$\n\nNext, let's see some concrete examples." :db/ensure [:tutorial/validate]} {:db/id 17592186221473 :activity/expected-seconds 1260.0 :db/ensure [:activity/validate]}]
