/ref 17592186045417] [17592186221445 #edb/ref 1041 #edb/ref 17592186221198 #edb/ref 17592186045417] [17592186221445 #edb/ref 1042 #uuid "c3315887-ff5c-5fd7-93bd-a58800e378b8" #edb/ref 17592186045417] [17592186221473 #edb/ref 1043 #edb/ref 17592186222376 #edb/ref 17592186045417] [17592186221473 #edb/ref 1043 #edb/ref 17592186222377 #edb/ref 17592186045417] [17592186221473 #edb/ref 1043 #edb/ref 17592186222378 #edb/ref 17592186045417] [17592186221473 #edb/ref 1043 #edb/ref 17592186222379 #edb/ref 17592186045417] [17592186221473 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186221473 #edb/ref 1045 "Fourier Series of Arbitrary Period" #edb/ref 17592186045417] [17592186221473 #edb/ref 1046 #edb/ref 17592186222376 #edb/ref 17592186045417] [17592186221473 #edb/ref 1049 #edb/ref 17592186048443 #edb/ref 17592186045417] [17592186221473 #edb/ref 1050 1260.0 #edb/ref 17592186045417] [17592186221473 #edb/ref 1053 #uuid "80e6356e-9b75-58b6-9da9-f8c9047c131d" #edb/ref 17592186045417] [17592186222024 #edb/ref 1068 #edb/ref 17592186314338 #edb/ref 17592186045417] [17592186222024 #edb/ref 1069 "q-340873" #edb/ref 17592186045417] [17592186222024 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186222024 #edb/ref 1071 "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{2}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{2}x)\n$$\n\nThe Fourier series of the $4$-periodic extension $f(x)$ of the function \n\n$$\nF(x)=\\{\\begin{aligned}2, & x\\in [0,2) \\\\ -1, & x\\in [-2,0)\\end{aligned}\n$$\n\nis shown above. Find the exact value of ${a}_{3}.$\n\n${a}_{3}=$ {{field-1}}" #edb/ref 17592186045417] [17592186222024 #edb/ref 1072 #uuid "0ed7ffbf-06f9-50a7-bc59-05cb4e317a52" #edb/ref 17592186045417] [17592186222024 #edb/ref 1074 "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=2.$ Also, $f(x)=2$ for $x\\in (0,2)$ and $f(x)=-1$ for $x\\in (-2,0).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{3} & =\\frac{1}{2}{\\int }_{-2}^{2}f(x)\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{-2}^{0}(-1)\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x+\\frac{1}{2}{\\int }_{0}^{2}2\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x \\\\  & =-\\frac{1}{2}\\cdot \\frac{2}{3\\pi }{[\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{0}+\\frac{2}{3\\pi }{[\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)]}_{0}^{2} \\\\  & =-\\frac{1}{3\\pi }(\\operatorname{sin}⁡(0)-\\operatorname{sin}⁡(-3\\pi ))+\\frac{2}{3\\pi }(\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =0.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186222376 #edb/ref 1058 #edb/ref 17592186222377 #edb/ref 17592186045417] [17592186222376 #edb/ref 1061 601031 #edb/ref 17592186045417] [17592186222376 #edb/ref 1062 #uuid "0045b15e-7a1f-5142-94c5-082ec814b34d" #edb/ref 17592186045417] [17592186222376 #edb/ref 1063 #edb/ref 17592186222514 #edb/ref 17592186045417] [17592186222377 #edb/ref 1058 #edb/ref 17592186222378 #edb/ref 17592186045417] [17592186222377 #edb/ref 1061 601032 #edb/ref 17592186045417] [17592186222377 #edb/ref 1062 #uuid "0b4fe87b-2102-5820-bc57-996b33b5332d" #edb/ref 17592186045417] [17592186222377 #edb/ref 1063 #edb/ref 17592186221443 #edb/ref 17592186045417] [17592186222378 #edb/ref 1058 #edb/ref 17592186222379 #edb/ref 17592186045417] [17592186222378 #edb/ref 1061 601035 #edb/ref 17592186045417] [17592186222378 #edb/ref 1062 #uuid "c1a6a016-3b6c-50d2-9290-1aa451df4a51" #edb/ref 17592186045417] [17592186222378 #edb/ref 1063 #edb/ref 17592186221444 #edb/ref 17592186045417] [17592186222379 #edb/ref 1061 601038 #edb/ref 17592186045417] [17592186222379 #edb/ref 1062 #uuid "b7ee00e8-fdc1-5440-bb38-f920d76832a4" #edb/ref 17592186045417] [17592186222379 #edb/ref 1063 #edb/ref 17592186221445 #edb/ref 17592186045417] [17592186222514 #edb/ref 1064 "When a function has period $2L$ (instead of $2\\pi$), the \"usual\" Fourier formulas still work, but the sine and cosine inputs must be rescaled so that each term completes an integer number of oscillations over one period. \n\nWe do this by converting the $2L$-periodic function into a $2\\pi$-periodic one using a change of variables.\n\nLet $f(x)$ be the $2L$-periodic extension of a function $F(x)$ from $x\\in[-L,L)$ to $x\\in\\mathbb{R}$.\nTo use the standard $2\\pi$-period Fourier formulas, define\n\n$$\ns=\\frac{\\pi}{L}x\n\\qquad\\text{and}\\qquad\ng(s)=f\\!\\left(\\frac{L}{\\pi}s\\right).\n$$\n\nThen $g$ is $2\\pi$-periodic.\n\nFor a $2\\pi$-periodic function $g$, the Fourier series is\n\n$$\ng(s)\\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}\\bigl(a_n\\cos(ns)+b_n\\sin(ns)\\bigr),\n$$\n\nwhere\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\,ds, \\\\ {a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(ns)\\,ds,\\,n\\ge 1, \\\\ {b}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{sin}⁡(ns)\\,ds,\\,n\\ge 1.\\end{aligned}\n$$\n\nNow substitute $g(s)=f\\!\\left(\\dfrac{L}{\\pi}s\\right)$ and $s=\\dfrac{\\pi}{L}x$.\nFirst, for $a_n{:}$\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(ns)\\,ds \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f\\,(\\frac{L}{\\pi }s)\\operatorname{cos}⁡(ns)\\,ds \\\\  & =\\frac{1}{\\pi }{\\int }_{-L}^{L}f\\,(\\frac{L}{\\pi }\\cdot \\frac{\\pi }{L}x)cos\\,(n\\cdot \\frac{\\pi }{L}x)\\,d\\,(\\frac{\\pi }{L}x) \\\\  & =\\frac{1}{\\pi }\\cdot \\frac{\\pi }{L}{\\int }_{-L}^{L}f(x)cos\\,(\\frac{n\\pi }{L}x)\\,dx \\\\  & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)cos\\,(\\frac{n\\pi }{L}x)\\,dx\\end{aligned}\n$$\n\nCoefficients $b_n$ (for $n \\geq 1$) and $a_0$ can be found similarly.\n\nTo summarize, the Fourier series of $f$ is\n\n$$\nf(x)\\sim \\frac{a_0}{2}+\\sum_{n=1}^{\\infty}\\left(a_n\\cos\\!\\left(\\frac{n\\pi}{L}x\\right)+b_n\\sin\\!\\left(\\frac{n\\pi}{L}x\\right)\\right),\n$$\n\nwhere the coefficients are the following:\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,dx \\\\ {a}_{n} & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)cos\\,(\\frac{n\\pi }{L}x)\\,dx,\\,n\\ge 1 \\\\ {b}_{n} & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)sin\\,(\\frac{n\\pi }{L}x)\\,dx,\\,n\\ge 1\\end{aligned}\n$$\n\nNext, let's see some concrete examples." #edb/ref 17592186045417] [17592186222514 #edb/ref 1065 14681 #edb/ref 17592186045417] [17592186222514 #edb/ref 1066 #uuid "5bb98db0-8e34-5cf2-8911-56a6971740ab" #edb/ref 17592186045417] [17592186222514 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186311966 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186311966 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186311966 #edb/ref 1083 #uuid "00e95e33-347b-57a5-99b1-b6350c6a1b82" #edb/ref 17592186045417] [17592186314338 #edb/ref 1075 #edb/ref 17592186311966 #edb/ref 17592186045417] [17592186314338 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186314338 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186314338 #edb/ref 1078 #edb/ref 17592186311966 #edb/ref 17592186045417] [17592186314338 #edb/ref 1079 #uuid "7b992e7c-efa0-59cc-a0fb-844e1ecd2b0b" #edb/ref 17592186045417] [17592186315334 #edb/ref 1080 "6" #edb/ref 17592186045417] [17592186315334 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186315334 #edb/ref 1083 #uuid "264561c5-9799-51c9-a009-d1202a71c2b4" #edb/ref 17592186045417] [17592186316837 #edb/ref 1075 #edb/ref 17592186315334 #edb/ref 17592186045417] [17592186316837 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186316837 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186316837 #edb/ref 1078 #edb/ref 17592186315334 #edb/ref 17592186045417] [17592186316837 #edb/ref 1079 #uuid "79eafde2-60a3-502c-bcb3-a8d0d2d51c6e" #ed