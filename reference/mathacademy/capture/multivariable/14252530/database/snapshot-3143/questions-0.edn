#{[{:db/id #edb/ref 17592186152009 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186152201 :knowledge-point/id #uuid "29c77146-872d-5120-9ce7-9a71f156a045" :knowledge-point/title "Finding the Complement of a Union"}] :question/id #uuid "9267c780-b443-58cb-bd1f-6d44d34caf02" :question/math-academy-id "e-7212" :question/problem "If $\\overline{X} = \\{ a, c, d\\}$ and $\\overline{Y} = \\{ a, e, i, o, u \\},$ then what is $\\overline{ X \\cup Y }?$" :question/worked-solution "De Morgan's law for unions states that\n\n$$\n\\overline{X \\cup Y} \\equiv \\overline{X} \\cap \\overline{Y}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\overset{―}{X\\cup Y} & =\\overset{―}{X}\\cap \\overset{―}{Y} \\\\  & ={a,c,d}\\cap {a,e,i,o,u} \\\\  & ={a}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186152010 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186152202 :knowledge-point/id #uuid "be98b214-0860-51c6-930b-756af86ec330" :knowledge-point/title "Finding the Complement of an Intersection"}] :question/id #uuid "18f20297-1f8c-5306-9e94-ddfb914a5e83" :question/math-academy-id "e-7213" :question/problem "If $\\overline{P} = \\{ 2, 4, 6 \\}$ and $\\overline{Q} = \\{ 1, 2, 4 \\},$ then what is $\\overline{ P \\cap Q }?$" :question/worked-solution "De Morgan's law for intersections states that\n\n$$\n\\overline{P \\cap Q} \\equiv \\overline{P} \\cup \\overline{Q}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\overset{―}{P\\cap Q} & =\\overset{―}{P}\\cup \\overset{―}{Q} \\\\  & ={2,4,6}\\cup {1,2,4} \\\\  & ={1,2,4,6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186407173 :knowledge-point/_questions [{:db/id #edb/ref 17592186152201 :knowledge-point/id #uuid "29c77146-872d-5120-9ce7-9a71f156a045" :knowledge-point/title "Finding the Complement of a Union"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b3eb35f-b8d5-5a84-a984-d6a9fb636973" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{8,10,12,14}" :db/id #e