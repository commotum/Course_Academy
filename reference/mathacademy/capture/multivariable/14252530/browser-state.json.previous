    "q-82017": {
      "dom_id": "step-q82017",
      "name": "Question 2",
      "problem": "If $\\overset{―}{C}=\\{3.1,4.3,5.1,7.7,9.5\\}$ and $\\overset{―}{D}=\\{1.8,2.7,4.3,7.7\\},$ then what is $\\overset{―}{C\\cup D}?$",
      "worked_solution": "De Morgan's law for unions states that\n\n$$\n\\overset{―}{C\\cup D}≡\\overset{―}{C}\\cap \\overset{―}{D}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\overset{―}{C\\cup D} & =\\overset{―}{C}\\cap \\overset{―}{D} \\\\  & =\\{3.1,4.3,5.1,7.7,9.5\\}\\cap \\{1.8,2.7,4.3,7.7\\} \\\\  & =\\{4.3,7.7\\}.\\end{aligned}\n$$",
      "calculator_instructions": "",
