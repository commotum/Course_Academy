17] [17592186259588 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186259588 #edb/ref 1071 "Let $f(x,y)=x{e}^{y+1}.$ Given that $C$ is the path along the curve $y={e}^{x}+1$ for $x\\in [0,\\operatorname{ln}⁡2],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" #edb/ref 17592186045417] [17592186259588 #edb/ref 1072 #uuid "530f83ac-873a-5207-ba3d-e9438dabfd29" #edb/ref 17592186045417] [17592186259588 #edb/ref 1074 "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\nWe start by parametrizing the curve $C.$ A suitable parametrization is\n\n$$\nr(t)=⟨t,{e}^{t}+1⟩,\\,t\\in [0,\\operatorname{ln}⁡2].\n$$\n\nThen, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,2⟩, \\\\ r(\\operatorname{ln}⁡2) & =⟨\\operatorname{ln}⁡2,3⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,2)$ and $(\\operatorname{ln}⁡2,3).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(\\operatorname{ln}⁡2))-f(r(0)) \\\\  & =f(\\operatorname{ln}⁡2,3)-f(0,2) \\\\  & =\\operatorname{ln}⁡2\\cdot {e}^{3+1}-0\\cdot {e}^{2+1} \\\\  & ={e}^{4}\\operatorname{ln}⁡2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259590 #edb/ref 1068 #edb/ref 17592186259233 #edb/ref 17592186045417] [17592186259590 #edb/ref 1069 "q-124029" #edb/ref 17592186045417] [17592186259590 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186259590 #edb/ref 1071 "Let $f(x,y)=x\\operatorname{sin}⁡y.$ Given that $C$ is the path along the curve ${y}^{2}=x$ for $y\\in [0,\\frac{\\pi }{2}],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" #edb/ref 17592186045417] [17592186259590 #edb/ref 1072 #uuid "2e457dc8-8930-562f-905f-f48a2ebaba17" #edb/ref 17592186045417] [17592186259590 #edb/ref 1074 "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\nWe start by parametrizing the curve $C.$ A suitable parametrization is\n\n$$\nr(t)=⟨{t}^{2},t⟩,\\,t\\in [0,\\frac{\\pi }{2}].\n$$\n\nThen, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,0⟩, \\\\ r(\\frac{\\pi }{2}) & =⟨\\frac{{\\pi }^{2}}{4},\\frac{\\pi }{2}⟩.\\end{aligned}\n$$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(\\frac{\\pi }{2}))-f(r(0)) \\\\  & =f(\\frac{{\\pi }^{2}}{4},\\frac{\\pi }{2})-f(0,0) \\\\  & =\\frac{{\\pi }^{2}}{4}\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{2})-0\\cdot \\operatorname{sin}⁡0 \\\\  & =\\frac{{\\pi }^{2}}{4}\\cdot 1-0 \\\\  & =\\frac{{\\pi }^{2}}{4}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186259591 #edb/ref 1068 #edb/ref 17592186259138 #edb/ref 17592186045417] [17592186259591 #edb/ref 1069 "q-124030" #edb/ref 17592186045417] [17592186259591 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186259591 #edb/ref 1071 "Let $f(x,y)={x}^{2}+{e}^{xy}.$ Given that $C$ is the path along the curve $\\frac{x}{2}=\\sqrt{y}$ for $y\\in [1,4],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" #edb/ref 17592186045417] [17592186259591 #edb/ref 1072 #uuid "33d927c3-e1a0-5a24-bd3b-65369e4fc02e" #edb/ref 17592186045417] [17592186259591 #edb/ref 1074 "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\nWe start by parametrizing the curve $C.$ A suitable parametrization is\n\n$$\nr(t)=⟨2\\sqrt{t},t⟩,\\,t\\in [1,4].\n$$\n\nThen, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(1) & =⟨2,1⟩, \\\\ r(4) & =⟨4,4⟩.\\end{aligned}\n$$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(4))-f(r(1)) \\\\  & =f(4,4)-f(2,1) \\\\  & =({4}^{2}+{e}^{4\\cdot 4})-({2}^{2}+{e}^{2\\cdot 1}) \\\\  & =(16+{e}^{16})-(4+{e}^{2}) \\\\  & ={e}^{16}-{e}^{2}+12.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186324496 #edb/ref 1080 "{\\pi }^{5}-1" #edb/ref 17592186045417] [17592186324496 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324496 #edb/ref 1083 #uuid "41011d94-bc36-5377-837a-407beee2c7d4" #edb/ref 17592186045417] [17592186325775 #edb/ref 1080 "{\\pi }^{2}({\\pi }^{3}-1)" #edb/ref 17592186045417] [17592186325775 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325775 #edb/ref 1083 #uuid "cf9dda28-e794-5e5b-a487-30e79ca01306" #edb/ref 17592186045417] [17592186325864 #edb/ref 1080 "\\pi ({\\pi }^{3}-2)" #edb/ref 17592186045417] [17592186325864 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325864 #edb/ref 1083 #uuid "d96c59c5-5422-5219-a8e3-f9082dc413ae" #edb/ref 17592186045417] [17592186325866 #edb/ref 1080 "{\\pi }^{2}({\\pi }^{2}-3)" #edb/ref 17592186045417] [17592186325866 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325866 #edb/ref 1083 #uuid "d9734389-fc6e-5cc3-bc9b-423f0f252b71" #edb/ref 17592186045417] [17592186325868 #edb/ref 1080 "{\\pi }^{2}({\\pi }^{3}-3)" #edb/ref 17592186045417] [17592186325868 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325868 #edb/ref 1083 #uuid "d9cab25b-2879-5d7f-974c-d9ca4022e0ed" #edb/ref 17592186045417] [17592186326272 #edb/ref 1075 #