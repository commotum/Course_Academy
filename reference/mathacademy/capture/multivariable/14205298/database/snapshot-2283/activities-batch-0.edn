#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186079578} :activity/id #uuid "44cc6885-bb82-5b20-bcaf-40d9c657e036" :activity/scope {:db/id #edb/ref 17592186049111 :topic/id #uuid "db673967-9a93-5184-98c4-d6168a02ca86" :topic/math-academy-id 640} :activity/steps [{:db/id #edb/ref 17592186079578 :step/content {:db/id #edb/ref 17592186079668 :tutorial/content "We've learned two methods for approximating the value of the derivative at a point by computing the rate of change between two points a distance of $h$ apart, where $h$ is small.\n\n- The forward difference approximation computes the rate of change between the point $x$ and the point $x+h,$ which is a step of $h$ units forward.\n\n$$\nf'(x)  \\approx \\dfrac{f(x+h)- f(x)}{h}\n$$\n\n- The backward difference approximation computes the rate of change between the point $x$ and the point $x-h,$ which is a step of $h$ units backward.\n\n$$\nf'(x)  \\approx \\dfrac{f(x)- f(x-h)}{h}\n$$\n\nNow, we will introduce the **central difference approximation**, also known as the **symmetric difference approximation**. In this approximation, we compute the rate of change between the points $x-h$ and $x+h,$ a distance of $2h$ apart.\n\n$$\nf'(x)  \\approx \\dfrac{f(x+h)- f(x-h)}{2h}\n$$\n\n![](images/48/48414a74d6f06fdec0f9b07c2a14f42c3a528b578b3a5f7a61cb4eff93016ac2.png)\n\nUsually, the central difference approximation is a better approximation for $f '(x)$ than the forward difference approximation and the backward difference approximation. This is because for the central difference approximation, $x$ is the midpoint between the two points $x-h$ and $x+h$ that are used in the approximation." :tutorial/id #uuid "6ac17418-b32e-5d12-97ef-d94adc56f308" :tutorial/math-academy-id 372 :tutorial/title "Introduction"} :step/id #uuid "a60aa634-136d-5259-b7e2-330e5586dcf6" :step/math-academy-id 695 :step/next {:db/id #edb/ref 17592186079579}} {:db/id #edb/ref 17592186079579 :step/content {:db/id #edb/ref 17592186078606 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078208 :question/id #uuid "98fdea06-a5ad-5d22-b928-ef893424e447" :question/math-academy-id "e-158"} :knowledge-point/id #uuid "6803a7be-e0e9-5f19-bd0b-711f49853170" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049236} {:db/id #edb/ref 17592186049934}] :knowledge-point/questions [{:db/id #edb/ref 17592186078864} {:db/id #edb/ref 17592186079173} {:db/id #edb/ref 17592186284662} {:db/id #edb/ref 17592186317456} {:db/id #edb/ref 17592186317457} {:db/id #edb/ref 17592186345032} {:db/id #edb/ref 17592186508034} {:db/id #edb/ref 17592186508037} {:db/id #edb/ref 17592186508065} {:db/id #edb/ref 17592186508103}] :knowledge-point/title "Estimating a Derivative Given Data or Tables Using a Central Difference Approximation"} :step/id #uuid "dc49f5fa-24d5-522d-94f8-c7cb90c5dfd6" :step/math-academy-id 699 :step/next {:db/id #edb/ref 17592186079580}} {:db/id #edb/ref 17592186079580 :step/content {:db/id #edb/ref 17592186078607 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078209 :question/id #uuid "62934fda-d972-50d5-acdb-e1f7b2fd63f2" :question/math-academy-id "e-159"} :knowledge-point/id #uuid "47fdd234-4281-5a38-aa51-22a8934d48a4" :knowledge-point/questions [{:db/id #edb/ref 17592186078957} {:db/id #edb/ref 17592186078962} {:db/id #edb/ref 17592186284663} {:db/id #edb/ref 17592186284664} {:db/id #edb/ref 17592186297414} {:db/id #edb/ref 17592186317458} {:db/id #edb/ref 17592186317459} {:db/id #edb/ref 17592186317460} {:db/id #edb/ref 17592186317491} {:db/id #edb/ref 17592186317492} {:db/id #edb/ref 17592186508077} {:db/id #edb/ref 17592186508079} {:db/id #edb/ref 17592186508086} {:db/id #edb/ref 17592186521517} {:db/id #edb/ref 17592186521534} {:db/id #edb/ref 17592186521548}] :knowledge-point/title "Estimating a Derivative Given a Graph Using a Central Difference Approximation"} :step/id #uuid "fa5bcebe-0da6-5538-9ccd-5d348315d13a" :step/math-academy-id 701 :step/next {:db/id #edb/ref 17592186079581}} {:db/id #edb/ref 17592186079581 :step/content {:db/id #edb/ref 17592186078608 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078212 :question/id #uuid "d405fda1-1111-56db-ae34-4c0f257852f2" :question/math-academy-id "e-160"} :knowledge-point/id #uuid "bf9fa7f8-708a-5006-9b9b-ea2c0334cb2c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048835}] :knowledge-point/questions [{:db/id #edb/ref 17592186078960} {:db/id #edb/ref 17592186078961} {:db/id #edb/ref 17592186234079} {:db/id #edb/ref 17592186297419} {:db/id #edb/ref 17592186317494} {:db/id #edb/ref 17592186317495} {:db/id #edb/ref 17592186329810} {:db/id #edb/ref 17592186329818} {:db/id #edb/ref 17592186332878} {:db/id #edb/ref 17592186332879} {:db/id #edb/ref 17592186508062} {:db/id #edb/ref 17592186508066} {:db/id #edb/ref 17592186508107} {:db/id #edb/ref 17592186521510} {:db/id #edb/ref 17592186521567}] :knowledge-point/title "Estimating a Derivative Given a Graph Using a Central Difference Approximation: Word Problem"} :step/id #uuid "a5d43107-12f5-564b-8b7e-258d9b82d9da" :step/math-academy-id 703}] :activity/title "Estimating Derivatives Using a Central Difference Quotient" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078662}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186521620} :activity/id #uuid "fc6b7687-cfeb-5f5f-a997-e613e67ace2c" :activity/scope {:db/id #edb/ref 17592186049111 :topic/id #uuid "db673967-9a93-5184-98c4-d6168a02ca86" :topic/math-academy-id 640} :activity/steps [{:db/id #edb/ref 17592186521582 :step/content {:db/id #edb/ref 17592186521548 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61dafa90-cdc3-5f41-91ad-f2638de3936e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186520985}] :answer-field/correct {:db/id #edb/ref 17592186520985} :answer-field/id #uuid "edd45b2c-b238-5306-8bee-cea5535e0e17" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186521447}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cd26c621-effc-5c15-8ae1-c10830f17e99" :question/math-academy-id "q-344028" :question/problem "![](images/0b/0bfc66c5e19ff0fe88cba465c6b045402fc5f8753befa4acb3b1cc3839acf8a7.png)\n\nThe graph of the function $y=f(x)$ is shown above. Approximate ${f}^{′}(x)$ at the point $x=3$ using a central difference approximation with step size $h=1.$\n\n*Hint: Assume that the graph passes through the points with integer $y$-coordinates when $x=2$ and $x=4.$*\n\n${f}^{′}(3)≈$\n{{field-1}}" :question/worked-solution "We use the central difference approximation\n\n$$\n{f}^{′}(x)≈\\frac{f(x+h)-f(x-h)}{2h},\n$$\n\nat the point $x=3$ with step size $h=1.$ This gives\n\n$$\n\\begin{aligned}{f}^{′}(3) & ≈\\frac{f(3+1)-f(3-1)}{2(1)} \\\\  & =\\frac{f(4)-f(2)}{2} \\\\  & =\\frac{-2-2}{2} \\\\  & =\\frac{(-4)}{2} \\\\  & =-2.\\end{aligned}\n$$"} :step/id #uuid "1a14f9f1-1b0f-594d-a6d2-e0a52c7322ee" :step/next {:db/id #edb/ref 17592186521639}} {:db/id #edb/ref 17592186521615 :step/content {:db/id #edb/ref 17592186521567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b3be121-1868-5c15-bb39-9dc444f96c37" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$800$ people per year" :db/id #edb/ref 17592186520894} {:answer/id #uuid "42d87068-7c26-500b-86bd-276963ea2b56" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$820$ people per year" :db/id #edb/ref 17592186520915} {:answer/id #uuid "4b289394-f864-5590-bd44-39400c5b19de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$620$ people per year" :db/id #edb/ref 17592186520936} {:answer/id #uuid "66768288-36bc-5a05-a7d0-09dc524837bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$220$ people per year" :db/id #edb/ref 17592186520997} {:answer/id #uuid "697d63fe-7536-5001-b451-eef387f2b71b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$400$ people per year" :db/id #edb/ref 17592186521004}] :answer-field/correct {:db/id #edb/ref 17592186520936} :answer-field/id #uuid "0af4d3cf-e65d-5887-a3c8-fbf3cb5968a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521332}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eee2d2d0-57b3-5f3a-92f2-640ee03bafc1" :question/math-academy-id "q-51403" :question/problem "The population growth of a developing rural area was studied for $25$ years. The following table shows the population $p(t),$ in hundreds, recorded $t$ years after $1990.$\n\n| **$t$** | $0$ | $5$ | $10$ | $15$ | $20$ | $25$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $p(t)$ | $90$ | $98$ | $116$ | $138$ | $178$ | $220$ |\n\n$$\n\n$$\n\nApproximate the population growth rate in the year $2005$ using a central difference approximation with step size $h=5.$" :question/worked-solution "We use the central difference approximation\n\n$$\n{p}^{′}(x)≈\\frac{p(t+h)-p(t-h)}{2h}.\n$$\n\n \nWe note that year $2005$ corresponds to $t=15.$ The step size is $h=5.$ This gives\n\n$$\n\\begin{aligned}{p}^{′}(15) & ≈\\frac{p(15+5)-p(15-5)}{2(5)} \\\\  & =\\frac{p(20)-p(10)}{2(5)} \\\\  & =\\frac{178-116}{10} \\\\  & =\\frac{62}{10} \\\\  & =6.2.\\end{aligned}\n$$\n\nSo, the population growth rate in $2005$ was $620$ people per year."} :step/id #uuid "75e3868f-a25b-5151-8a0c-5be1318bc937" :step/next {:db/id #edb/ref 17592186521652}} {:db/id #edb/ref 17592186521620 :step/content {:db/id #edb/ref 17592186521534 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fff293c-de20-5044-b28e-7478bb356eb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.5" :db/id #edb/ref 17592186520909} {:answer/id #uuid "8137a3bb-83fe-54a8-93e9-dda64e173d6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186521060} {:answer/id #uuid "b25b775f-bf2f-5603-9f95-e4800c7215ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.5" :db/id #edb/ref 17592186521161} {:answer/id #uuid "b9240be5-a3ff-50e1-956c-707b96dc2cd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.25" :db/id #edb/ref 17592186521176} {:answer/id #uuid "da88aa0d-3077-5d10-8f29-a83e3333cc00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186521253}] :answer-field/correct {:db/id #edb/ref 17592186520909} :answer-field/id #uuid "25c0ebe2-4b2c-5787-820d-66d49ff4c628" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521345}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9a46b6ba-aacd-5c29-a1ea-c98b8e558d24" :question/math-academy-id "q-47536" :question/problem "![](images/4b/4b280f9756119d26317899e07e9a23b3679555701b23096516afb7a646cda453.png)\n\nThe graph of the function $f(x)$ is shown above. \nApproximate ${f}^{′}(x)$ at the point $x=5$ using a central difference approximation with step size $h=1.$" :question/worked-solution "We use the central difference approximation\n\n$$\n{f}^{′}(x)≈\\frac{f(x+h)-f(x-h)}{2h},\n$$\n\nat the point $x=5$ with step size $h=1.$ This gives\n\n$$\n\\begin{aligned}{f}^{′}(5) & ≈\\frac{f(5+1)-f(5-1)}{2(1)} \\\\  & =\\frac{f(6)-f(4)}{2} \\\\  & =\\frac{5-2}{2} \\\\  & =\\frac{3}{2} \\\\  & =1.5.\\end{aligned}\n$$"} :step/id #uuid "837165f8-c967-55f3-b235-24e13a193e14" :step/next {:db/id #edb/ref 17592186521615}} {:db/id #edb/ref 17592186521639 :step/content {:db/id #edb/ref 17592186521510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09c0fbb2-7164-5851-b930-a2535a1ccb70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186520779}] :answer-field/correct {:db/id #edb/ref 17592186520779} :answer-field/id #uuid "e65356f5-f20f-5d3d-9cec-00adbcee6de3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186521440}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6feb34ac-08d5-5bc5-ac07-3b8f7d9f2f78" :question/math-academy-id "q-344354" :question/problem "In a physics experiment, the net charge on a sensor (in $mC$) after $t$ seconds is given by the function $Q(t).$ The values of $Q(t)$ for different values of $t$ are given in the table below:\n\n| **$t$** | $1.0$ | $1.5$ | $2.0$ | $2.5$ | $3.0$ | $3.5$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| **$Q(t)$** | $4$ | $3$ | $2$ | $1$ | $-1$ | $-2$ |\n\nApproximate the sensor’s charge instantaneous rate of change at $t=2.5$ using a central difference approximation with step size $h=0.5.$\n\nThe sensor’s charge at $t=2.5$ is decreasing at approximately \n{{field-1}} $mC$ per second." :question/worked-solution "We use the central difference approximation\n\n$$\n{Q}^{′}(t)≈\\frac{Q(t+h)-Q(t-h)}{2h},\n$$\n\nat time $t=2.5$ with step size $h=0.5.$ This gives\n\n$$\n\\begin{aligned}{Q}^{′}(2.5) & ≈\\frac{Q(2.5+0.5)-Q(2.5-0.5)}{2(0.5)} \\\\  & =\\frac{Q(3.0)-Q(2.0)}{1.0} \\\\  & =\\frac{-1-2}{1.0} \\\\  & =\\frac{-3}{1.0} \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, the sensor’s charge at $t=2.5$ is decreasing at approximately $3\\,mC$ per second."} :step/id #uuid "c47052fd-5450-5904-80f3-546487c65903"} {:db/id #edb/ref 17592186521652 :step/content {:db/id #edb/ref 17592186521517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21dcbd9a-b189-5e6a-bc35-a6c210cd27cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.75" :db/id #edb/ref 17592186520835} {:answer/id #uuid "388f9860-936a-5e7e-b68f-0a73360204b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186520886} {:answer/id #uuid "7834e1cb-c346-5829-b413-979630b7caca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.25" :db/id #edb/ref 17592186521033} {:answer/id #uuid "90b975cc-2770-51d1-9c1f-ed99aaf7a2fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.75" :db/id #edb/ref 17592186521092} {:answer/id #uuid "cd8c286e-5853-5464-a9a1-bab70973849c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5" :db/id #edb/ref 17592186521224}] :answer-field/correct {:db/id #edb/ref 17592186520835} :answer-field/id #uuid "4575b9d0-3088-5690-8faf-edd6c5589e6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186521359}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7efd0b4a-5765-528c-b6d9-1a45ad254c36" :question/math-academy-id "q-75127" :question/problem "![](images/b7/b76466e577343a234b53566b00939a3de312ad4f71106ebf3cbed3bc9d8795ea.png)\n\nThe graph of the function $y=f(x)$ is shown above. Approximate ${f}^{′}(x)$ at the point $x=8$ using a central difference approximation with step size $h=4.$" :question/worked-solution "We use the central difference approximation\n\n$$\n{f}^{′}(x)≈\\frac{f(x+h)-f(x-h)}{2h}\n$$\n\n \nat the point $x=8$ with step size $h=4.$ This gives\n\n$$\n\\begin{aligned}{f}^{′}(8) & ≈\\frac{f(8+4)-f(8-4)}{2(4)} \\\\  & =\\frac{f(12)-f(4)}{8} \\\\  & =\\frac{12-6}{8} \\\\  & =\\frac{6}{8} \\\\  & =0.75.\\end{aligned}\n$$"} :step/id #uuid "ef594372-6cb5-54ca-9621-701e5b7ba954" :step/next {:db/id #edb/ref 17592186521582}}] :activity/title "Estimating Derivatives Using a Central Difference Quotient" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186520762}]}
