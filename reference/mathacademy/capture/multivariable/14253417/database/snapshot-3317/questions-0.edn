ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472578} {:answer/id #uuid "d54291b6-7ef2-55e0-96fb-76e1195bcd41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472579}] :answer-field/correct {:answer/id #uuid "428e1b82-e6da-5eab-9b6a-0c2af131b494" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472578} :answer-field/id #uuid "fa69a530-25df-51d2-8915-d0fef8fbe9e6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473684}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8076c0f-174e-5d1d-bedf-553b0bcc1d94" :question/math-academy-id "q-127969" :question/problem "Which of the following statements are logically equivalent?\n\nI. $¬Q∧(P∨Q)$\n\nII. $P∧¬Q$\n\nIII. $¬P∧¬Q$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two statements are logically equivalent if they have the same truth table. So, we construct a truth table for the three given statements:\n\n| $\\,P\\,$ | $\\,Q\\,$ | $\\,¬Q∧(P∨Q)\\,$ | $\\,P∧¬Q\\,$ | $\\,¬P∧¬Q\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n\nWe see that only the statements $¬Q∧(P∨Q)$ and $P∧¬Q$ have the same truth table, so they are logically equivalent.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186376315 :knowledge-point/_questions [{:db/id #edb/ref 17592186157230 :knowledge-point/id #uuid "4a6a36e8-e14e-5051-acae-48de63ff3eff" :knowledge-point/title "Identifying Equivalent Statements Using Partially Completed Truth Tables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dce02e59-f386-5950-b0d1-18fc4efe6b6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186376317} {:answer/id #uuid "135a19ab-3bd3-56e7-a578-24239e1b9dda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186376318}] :answer-field/correct {:answer/id #uuid "135a19ab-3bd3-56e7-a578-24239e1b9dda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186376318} :answer-field/id #uuid "02ffb414-e6e5-5051-b034-2f19af54cfe7" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186376316} {:answer-field/choices [{:answer/id #uuid "02e3bebe-2780-58f4-b858-546aeb328ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186376320} {:answer/id #uuid "0517bfa3-732a-58b9-90de-ce72069f2a09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186376321}] :answer-field/correct {:answer/id #uuid "02e3bebe-2780-58f4-b858-546aeb328ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186376320} :answer-field/id #uuid "429a2d51-a00e-5786-a3b2-cd32d63318dc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186376319} {:answer-field/choices [{:answer/id #uuid "72a3bf66-029c-5cf9-a1c3-8c8dbc536dbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "≡" :db/id #edb/ref 17592186376323} {:answer/id #uuid "2fb1a0e8-1bd4-56d5-a2f9-9b20874c513