5417] [17592186426159 #edb/ref 1075 #edb/ref 17592186426098 #edb/ref 17592186045417] [17592186426159 #edb/ref 1075 #edb/ref 17592186426100 #edb/ref 17592186045417] [17592186426159 #edb/ref 1075 #edb/ref 17592186426104 #edb/ref 17592186045417] [17592186426159 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186426159 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186426159 #edb/ref 1078 #edb/ref 17592186426095 #edb/ref 17592186045417] [17592186426159 #edb/ref 1079 #uuid "d64a47db-1f98-5942-95f8-0a5fe8a1d806" #edb/ref 17592186045417] [17592186426160 #edb/ref 1075 #edb/ref 17592186426085 #edb/ref 17592186045417] [17592186426160 #edb/ref 1075 #edb/ref 17592186426105 #edb/ref 17592186045417] [17592186426160 #edb/ref 1075 #edb/ref 17592186426117 #edb/ref 17592186045417] [17592186426160 #edb/ref 1075 #edb/ref 17592186426119 #edb/ref 17592186045417] [17592186426160 #edb/ref 1075 #edb/ref 17592186426124 #edb/ref 17592186045417] [17592186426160 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186426160 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186426160 #edb/ref 1078 #edb/ref 17592186426119 #edb/ref 17592186045417] [17592186426160 #edb/ref 1079 #uuid "fe230e80-9c4a-5f11-8af8-1f23153eddbf" #edb/ref 17592186045417] [17592186426161 #edb/ref 1068 #edb/ref 17592186426155 #edb/ref 17592186045417] [17592186426161 #edb/ref 1069 "q-163177" #edb/ref 17592186045417] [17592186426161 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186426161 #edb/ref 1071 "A rectangular plate of mass $M$ occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 1\\}.$\nThe mass density at each point is proportional to the square of its distance from the $x$-axis.\nFind the moment of inertia of the lamina about the $x$-axis." #edb/ref 17592186045417] [17592186426161 #edb/ref 1072 #uuid "12797033-8f7a-5550-a318-a8461c5f9eb7" #edb/ref 17592186045417] [17592186426161 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFrom the description, the mass density function can be written as $\\lambda (x,y)=k{y}^{2},$ where $k$ is a constant of proportionality. We can find an expression for $k$ in terms of $M$ by integrating the density function over the plate:\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}k{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =k({\\int }_{0}^{2}\\text{d}x)({\\int }_{0}^{1}{y}^{2}\\,\\text{d}y) \\\\  & =k[x]_{0}^{2}\\cdot {[\\frac{1}{3}{y}^{3}]}_{0}^{1} \\\\  & =k(2-0)(\\frac{1}{3}-0) \\\\  & =\\frac{2k}{3}\\end{aligned}\n$$\n\nTherefore, $k=\\frac{3M}{2}$ and hence,\n\n$$\n\\lambda (x,y)=k{y}^{2}=\\frac{3M}{2}{y}^{2}.\n$$\n\nTherefore, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{3M}{2}{\\int }_{0}^{1}{\\int }_{0}^{2}{y}^{2}\\cdot {y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{3M}{2}({\\int }_{0}^{2}\\text{d}x)({\\int }_{0}^{1}{y}^{4}\\,\\text{d}y) \\\\  & =\\frac{3M}{2}[x]_{0}^{2}\\cdot {[\\frac{1}{5}{y}^{5}]}_{0}^{1} \\\\  & =\\frac{3M}{2}(2-0)(\\frac{1}{5}-0) \\\\  & =\\frac{3M}{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186426162 #edb/ref 1068 #edb/ref 17592186426157 #edb/ref 17592186045417] [17592186426162 #edb/ref 1069 "q-163176" #edb/ref 17592186045417] [17592186426162 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186426162 #edb/ref 1071 "A rectangular plate of mass $M$ occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le 1\\}.$\nThe mass density at each point is proportional to the square of its distance from the origin.\nFind the moment of inertia of the lamina about the $y$-axis." #edb/ref 17592186045417] [17592186426162 #edb/ref 1072 #uuid "288539c8-32f9-52b9-b8ac-741c3164b236" #edb/ref 17592186045417] [17592186426162 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFrom the description, the mass density function can be written as $\\lambda (x,y)=k({x}^{2}+{y}^{2}),$ where $k$ is a constant of proportionality. We can find an expression for $k$ in terms of $M$ by integrating the density function over the plate:\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}k({x}^{2}+{y}^{2})\\,\\text{d}x\\,\\text{d}y \\\\  & =k{\\int }_{0}^{1}{\\int }_{0}^{1}{x}^{2}+{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =k{\\int }_{0}^{1}{[\\frac{1}{3}{x}^{3}+x{y}^{2}]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & =k{\\int }_{0}^{1}\\frac{1}{3}+{y}^{2}\\,\\text{d}y \\\\  & =k{[\\frac{1}{3}y+\\frac{1}{3}{y}^{3}]}_{0}^{1} \\\\  & =k(\\frac{1}{3}+\\frac{1}{3}) \\\\  & =\\frac{2k}{3}\\end{aligned}\n$$\n\nTherefore, $k=\\frac{3M}{2}$ and hence,\n\n$$\n\\lambda (x,y)=k({x}^{2}+{y}^{2})=\\frac{3M}{2}({x}^{2}+{y}^{2}).\n$$\n\nTherefore, the moment of inertia about the $y$-axis is\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{3M}{2}{\\int }_{0}^{1}{\\int }_{0}^{1}{x}^{2}\\cdot ({x}^{2}+{y}^{2})\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{3M}{2}{\\int }_{0}^{1}[{\\int }_{0}^{1}{x}^{4}+{x}^{2}{y}^{2}\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{3M}{2}{\\int }_{0}^{1}{[\\frac{1}{5}{x}^{5}+\\frac{1}{3}{x}^{3}{y}^{2}]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & =\\frac{3M}{2}{\\int }_{0}^{1}\\frac{1}{5}+\\frac{1}{3}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{3M}{2}{[\\frac{1}{5}y+\\frac{1}{9}{y}^{3}]}_{0}^{1} \\\\  & =\\frac{3M}{2}(\\frac{1}{5}+\\frac{1}{9}) \\\\  & =\\frac{3M}{2}\\cdot \\frac{14}{45} \\\\  & =\\frac{7M}{15}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186426163 #edb/ref 1068 #edb/ref 17592186426154 #edb/ref 17592186045417] [17592186426163 #edb/ref 1069 "q-163253" #edb/ref 17592186045417] [17592186426163 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186426163 #edb/ref 1071 "![](images/74/74ae29ecab0a2d87fb020cc0801277a4a08dd11d38ea2b81f0718c6d30a19598.png)\n\nConsider a plate of mass $M$ that occupies the region $D$ bounded by the polar circles $r=2$ and $r=3,$ as shown above. The mass density at any point is proportional to its distance from the origin. Find the moment of inertia of the plate about the origin." #edb/ref 17592186045417] [17592186426163 #edb/ref 1072 #uuid "40276498-22d3-5917-98ab-3914446aeb38" #edb/ref 17592186045417] [17592186426163 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (r,\\theta ),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis, in polar coordinates, is given by\n\n$$\n{I}_{x}={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\n$$\n\n- The moment of inertia about the $y$-axis, in polar coordinates, is given by\n\n$$\n{I}_{y}={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}{cos}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\n$$\n\n- The moment of inertia about the origin, in polar coordinates, is given by\n\n$$\n{I}_{0}={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}\\,\\text{d}r\\,\\text{d}\\theta ={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that the region $D,$ in polar coordinates, can be expressed as\n\n$$\nD=\\{(r,\\theta )\\,:\\,2\\le r\\le 3,\\,\\,0\\le \\theta <2\\pi \\}.\n$$\n\nFrom the description, the mass density function can be written as $\\lambda (r,\\theta )=kr,$ where $k$ is a constant of proportionality. We can find an expression for $k$ in terms of $M$ by integrating the density function over the plate:\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (r,\\theta )\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{2}^{3}kr\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =k{\\int }_{0}^{2\\pi }{\\int }_{2}^{3}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =k({\\int }_{2}^{3}{r}^{2}\\,\\text{d}r)({\\int }_{0}^{2\\pi }\\text{d}\\theta ) \\\\  & =k\\cdot \\frac{1}{3}{r}^{3}\\,{|}_{2}^{3}\\cdot \\theta \\,{|}_{0}^{2\\pi } \\\\  & =k\\cdot \\frac{19}{3}\\cdot 2\\pi  \\\\  & =\\frac{38\\pi k}{3}.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\lambda (r,\\theta )=kr=\\frac{3M}{38\\pi }r.\n$$\n\nTherefore, the moment of inertia about the origin is\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{3M}{38\\pi }{\\int }_{0}^{2\\pi }{\\int }_{2}^{3}r\\cdot {r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{3M}{38\\pi }({\\int }_{2}^{3}{r}^{4}\\,\\text{d}r)({\\int }_{0}^{2\\pi }\\text{d}\\theta ) \\\\  & =\\frac{3M}{38\\pi }\\cdot \\frac{1}{5}{r}^{5}\\,{|}_{2}^{3}\\cdot \\theta \\,{|}_{0}^{2\\pi } \\\\  & =\\frac{3M}{38\\pi }\\cdot \\frac{211}{5}\\cdot 2\\pi  \\\\  & =\\frac{633M}{95}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186426164 #edb/ref 1068 #edb/ref 17592186426151 #edb/ref 17592186045417] [17592186426164 #edb/ref 1069 "q-163250" #edb/ref 17592186045417] [17592186426164 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186426164 #edb/ref 1071 "![](images/52/52a326d518bdbe32f119d131e67ae6eb35a3c72479c7ccb5a35dae030d6b9e1c.png)\n\nConsider a plate of mass $M$ that occupies the region $D$ in the second quadrant bounded by the polar circles $r=1,$ $r=\\sqrt{3},$ and the coordinate axes, as shown above. The mass density at any point is proportional to the square of its distance from the origin. Find the moment of inertia of the plate about the $x$-axis." #edb/ref 17592186045417] [17592186426164 #edb/ref 1072 #uuid "648c554b-c03a-5281-b06a-dd87f9becdf0" #edb/ref 17592186045417] [17592186426164 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (r,\\theta ),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis, in polar coordinates, is given by\n\n$$\n{I}_{x}={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\n$$\n\n- The moment of inertia about the $y$-axis, in polar coordinates, is given by\n\n$$\n{I}_{y}={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}{cos}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\n$$\n\n- The moment of inertia about the origin, in polar coordinates, is given by\n\n$$\n{I}_{0}={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}\\,\\text{d}r\\,\\text{d}\\theta ={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that the region $D,$ in polar coordinates, can be expressed as\n\n$$\nD=\\{(r,\\theta )\\,:\\,1\\le r\\le \\sqrt{3},\\,\\,\\frac{\\pi }{2}\\le \\theta \\le \\pi \\}.\n$$\n\nFrom the description, the mass density function can be written as $\\lambda (r,\\theta )=k{r}^{2},$ where $k$ is a constant of proportionality. We can find an expression for $k$ in terms of $M$ by integrating the density function over the plate:\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (r,\\theta )\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{1}^{\\sqrt{3}}k{r}^{2}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =k{\\int }_{\\pi /2}^{\\pi }{\\int }_{1}^{\\sqrt{3}}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =k({\\int }_{1}^{\\sqrt{3}}{r}^{3}\\,\\text{d}r)({\\int }_{\\pi /2}^{\\pi }\\text{d}\\theta ) \\\\  & =k\\cdot \\frac{1}{4}{r}^{4}\\,{|}_{1}^{\\sqrt{3}}\\cdot \\theta \\,{|}_{\\pi /2}^{\\pi } \\\\  & =k\\cdot 2\\cdot \\frac{\\pi }{2} \\\\  & =\\pi k.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\lambda (r,\\theta )=k{r}^{2}=\\frac{M}{\\pi }{r}^{2}.\n$$\n\nTherefore, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{M}{\\pi }{\\int }_{\\pi /2}^{\\pi }{\\int }_{1}^{\\sqrt{3}}{r}^{2}\\cdot {r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{M}{\\pi }{\\int }_{\\pi /2}^{\\pi }{\\int }_{1}^{\\sqrt{3}}{r}^{5}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{M}{\\pi }({\\int }_{1}^{\\sqrt{3}}{r}^{5}\\,\\text{d}r)({\\int }_{\\pi /2}^{\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta ) \\\\  & =\\frac{M}{\\pi }({\\int }_{1}^{\\sqrt{3}}{r}^{5}\\,\\text{d}r)({\\int }_{\\pi /2}^{\\pi }\\frac{1-\\operatorname{cos}⁡2\\theta }{2}\\,\\text{d}\\theta ) \\\\  & =\\frac{M}{\\pi }\\cdot \\frac{1}{6}{r}^{6}\\,{|}_{1}^{\\sqrt{3}}\\cdot (\\frac{1}{2}\\theta -\\frac{1}{4}\\operatorname{sin}⁡2\\theta ){|}_{\\pi /2}^{\\pi } \\\\  & =\\frac{M}{\\pi }\\cdot \\frac{13}{3}\\cdot \\frac{\\pi }{4} \\\\  & =\\frac{13M}{12}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186426165 #edb/ref 1068 #edb/ref 17592186426156 #edb/ref 17592186045417] [17592186426165 #edb/ref 1069 "q-163244" #edb/ref 17592186045417] [17592186426165 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186426165 #edb/ref 1071 "![](images/cc/ccf2ad2b3d8b39dbacdcdce6bd317c5720ce3b750249f6c328e60d3c74ddb4ef.png)\n\nConsider a plate of mass $M$ that occupies the region $D$ in the lower half plane bounded by the circle ${x}^{2}+{y}^{2}=1,$ shown above. Given that the mass is distributed uniformly across the plate, find the moment of inertia of the plate about the origin." #edb/ref 17592186045417] [17592186426165 #edb/ref 1072 #uuid "6773c2a6-0930-567e-b7b2-ce599d9b40d9" #edb/ref 17592186045417] [17592186426165 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (r,\\theta ),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis, in polar coordinates, is given by\n\n$$\n{I}_{x}={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\n$$\n\n- The moment of inertia about the $y$-axis, in polar coordinates, is given by\n\n$$\n{I}_{y}={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}{cos}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\n$$\n\n- The moment of inertia about the origin, in polar coordinates, is given by\n\n$$\n{I}_{0}={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}\\,\\text{d}r\\,\\text{d}\\theta ={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that the region $D$ in polar coordinates can be expressed as\n\n$$\nD=\\{(r,\\theta )\\,:\\,0\\le r\\le 1,\\,\\,\\pi \\le \\theta \\le 2\\pi \\}.\n$$\n\nThe area of the plate $D$ is \n\n$$\nA=\\frac{1}{2}\\pi {r}^{2}=\\frac{\\pi }{2}.\n$$\n\n \n\nSince the mass is distributed uniformly, the mass density function is given by\n\n$$\n\\lambda (r,\\theta )=\\frac{M}{A}=\\frac{2M}{\\pi }.\n$$\n\nTherefore, the moment of inertia about the origin is\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{2M}{\\pi }{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{1}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{2M}{\\pi }({\\int }_{0}^{1}{r}^{3}\\,\\text{d}r)({\\int }_{\\pi }^{2\\pi }\\text{d}\\theta ) \\\\  & =\\frac{2M}{\\pi }\\cdot \\frac{1}{4}{r}^{4}\\,{|}_{0}^{1}\\cdot \\theta \\,{|}_{\\pi }^{2\\pi } \\\\  & =\\frac{2M}{\\pi }\\cdot \\frac{1}{4}\\cdot \\pi  \\\\  & =\\frac{M}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186426166 #edb/ref 1068 #edb/ref 17592186426150 #edb/ref 17592186045417] [17592186426166 #edb/ref 1069 "q-163214" #edb/ref 17592186045417] [17592186426166 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186426166 #edb/ref 1071 "![](images/75/7545f5c48a86aa8ab7a8f46272e01f3021b7d7be10eea2019ce31c3225ca2f4d.png)\n\nA triangular plate of mass $M$ and uniform mass density occupies the region $D$ enclosed between the $x$-axis and the lines $y=x$ and $y=2-x,$ as shown above. Find the moment of inertia of the plate about the $y$-axis." #edb/ref 17592186045417] [17592186426166 #edb/ref 1072 #uuid "6c69411e-7617-5386-8531-531c78fc6d71" #edb/ref 17592186045417] [17592186426166 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that $D$ is a type II region with representation\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,\\,y\\le x\\le 2-y\\},\n$$\n\nas shown below.\n\n![](images/b1/b1ced30e4cc1fe984b56707f11e8720f2ee68c5b204b6ea7b8d607a65276acca.png)\n\nThe area of the triangular plate $D$ is \n\n$$\nA=\\frac{1}{2}\\cdot 2\\cdot 1=1.\n$$\n\nSince the plate has uniform density, every unit of area contains the same amount of mass. Therefore, the mass density is constant and is given by the total mass divided by the total area:\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=M.\n$$\n\nTherefore, the moment of inertia about the $y$-axis is\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =M{\\int }_{0}^{1}{\\int }_{y}^{2-y}{x}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =M{\\int }_{0}^{1}{[\\frac{{x}^{3}}{3}]}_{y}^{2-y}\\text{d}y \\\\  & =\\frac{M}{3}{\\int }_{0}^{1}(2-y)^{3}-{y}^{3}\\,\\text{d}y \\\\  & =\\frac{M}{3}{[-\\frac{1}{4}(2-y)^{4}-\\frac{1}{4}{y}^{4}]}_{0}^{1} \\\\  & =-\\frac{M}{12}{[(2-y)^{4}+{y}^{4}]}_{0}^{1} \\\\  & =-\\frac{M}{12}(1+1-16-0) \\\\  & =\\frac{7M}{6}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186426167 #edb/ref 1068 #edb/ref 17592186426160 #edb/ref 17592186045417] [17592186426167 #edb/ref 1069 "q-163195" #edb/ref 17592186045417] [17592186426167 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186426167 #edb/ref 1071 "![](images/1b/1bed15fe8f829f2a2248d5f366e4ca5df84274a767add87b3d26da9d3c2ab12d.png)\n\nA plate occupies the region $D$ enclosed by the $x$-axis and the lines $y=x$ and $y=4-x$, as shown above. If the mass density function of $D$ is given by $\\lambda (x,y)=2x,$ find the moment of inertia of the lamina about the $x$-axis." #edb/ref 17592186045417] [17592186426167 #edb/ref 1072 #uuid "780eb3bd-e477-5b2c-a046-3471aa40cca0" #edb/ref 17592186045417] [17592186426167 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that $D$ is a type II region with representation\n\n$$\nD=\\{(x,y)\\,:\\,y\\le x\\le 4-y,\\,\\,0\\le y\\le 2\\},\n$$\n\nas shown below.\n\n![](images/fe/fee47e2abe427ce056c77adb5df9a003263bade6e6e3e8d62ca789c162e2348c.png)\n\nUsing the formula for ${I}_{x},$ we get\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{y}^{4-y}{y}^{2}\\cdot 2x\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}[{\\int }_{y}^{4-y}2x{y}^{2}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{0}^{2}[{x}^{2}{y}^{2}]_{x=y}^{x=4-y}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{y}^{2}(4-y)^{2}-{y}^{4}\\text{d}x \\\\  & ={\\int }_{0}^{2}16{y}^{2}-8{y}^{3}\\,\\text{d}y \\\\  & ={[\\frac{16}{3}{y}^{3}-2{y}^{4}]}_{0}^{2} \\\\  & =\\frac{128}{3}-32 \\\\  & =\\frac{32}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186426168 #edb/ref 1068 #edb/ref 17592186426153 #edb/ref 17592186045417] [17592186426168 #edb/ref 1069 "q-163203" #edb/ref 17592186045417] [17592186426168 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186426168 #edb/ref 1071 "A rectangular plate of mass $M\\,\\text{kg}$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,1\\le x\\le 4,\\,\\,1\\le y\\le 3\\},$ where $x$ and $y$ are measured in meters. Find the moment of inertia of the plate about the $x$-axis." #edb/ref 17592186045417] [17592186426168 #edb/ref 1072 #uuid "a005e400-255d-52bf-b2df-866a68951503" #edb/ref 17592186045417] [17592186426168 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nThe area of the rectangular plate $D$ is $A=3\\cdot 2=6.$ \n\nSince the plate has uniform density, every unit of area contains the same amount of mass. Therefore, the mass density is constant and is given by the total mass divided by the total area:\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{6}.\n$$\n\nUsing the formula for ${I}_{x},$ we get\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{6}{\\int }_{1}^{3}{\\int }_{1}^{4}{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{6}{\\int }_{1}^{3}{y}^{2}[x]_{1}^{4}\\,\\text{d}y \\\\  & =\\frac{M}{6}{\\int }_{1}^{3}3{y}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{6}{[{y}^{3}]}_{1}^{3} \\\\  & =\\frac{M}{6}(27-1) \\\\  & =\\frac{13M}{3}.\\end{aligned}\n$$\n\nTherefore, the moment of inertia is $\\frac{13M}{3}\\,\\text{kg}\\cdot {\\text{m}}^{2}.$" #edb/ref 17592186045417] [17592186426169 #edb/ref 1068 #edb/ref 17592186426159 #edb/ref 17592186045417] [17592186426169 #edb/ref 1069 "q-163202" #edb/ref 17592186045417] [17592186426169 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186426169 #edb/ref 1071 "A rectangular plate of mass $M\\,\\text{kg}$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,1\\le x\\le 2,\\,\\,0\\le y\\le 3\\},$ where $x$ and $y$ are measured in meters. Find the moment of inertia of the plate about the $y$-axis." #edb/ref 17592186045417] [17592186426169 #edb/ref 1072 #uuid "a576d72d-3059-5635-bf8f-38bb7570610e" #edb/ref 17592186045417] [17592186426169 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nThe area of the rectangular plate $D$ is $A=1\\cdot 3=3.$ \n\nSince the plate has uniform density, every unit of area contains the same amount of mass. Therefore, the mass density is constant and is given by the total mass divided by the total area:\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{3}.\n$$\n\nUsing the formula for ${I}_{y},$ we get\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{3}{\\int }_{0}^{3}{\\int }_{1}^{2}{x}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{3}{\\int }_{0}^{3}{[\\frac{1}{3}{x}^{3}]}_{1}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{3}{\\int }_{0}^{3}\\frac{7}{3}\\,\\text{d}y \\\\  & =\\frac{7M}{9}[y]_{0}^{3} \\\\  & =\\frac{7M}{3}.\\end{aligned}\n$$\n\nTherefore, the moment of inertia is $\\frac{7M}{3}\\,\\text{kg}\\cdot {\\text{m}}^{2}.$" #edb/ref 17592186045417] [17592186426170 #edb/ref 1068 #edb/ref 17592186426149 #edb/ref 17592186045417] [17592186426170 #edb/ref 1069 "q-163190" #edb/ref 17592186045417] [17592186426170 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186426170 #edb/ref 1071 "![](images/e8/e818c7ab51d26b642039c4f5e5157dee97772eab41b130ff8c9243f102c5fa20.png)\n\nA triangular plate of mass $M$ occupies the region $D$ in the first quadrant enclosed by the lines $y=3x,$ $x=1,$ and the $x$-axis. The mass density at each point is proportional to the square of its distance from the origin. Find the moment of inertia of the plate about the $y$-axis." #edb/ref 17592186045417] [17592186426170 #edb/ref 1072 #uuid "c54dac84-cf20-51e9-9f3f-0a76f67b2f7b" #edb/ref 17592186045417] [17592186426170 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that $D$ is a type I region with representation\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le 3x\\},\n$$\n\nas shown below.\n\n![](images/b7/b7457bee1577c81fc5c04d4b1a116e82790d7d251dc61bd0611d00aae7d34bfe.png)\n\nFrom the description, the mass density function can be written as $\\lambda (x,y)=k({x}^{2}+{y}^{2}),$ where $k$ is a constant of proportionality. We can find an expression for $k$ in terms of $M$ by integrating the density function over the plate:\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3x}k({x}^{2}+{y}^{2})\\,\\text{d}y\\,\\text{d}x \\\\  & =k{\\int }_{0}^{1}[{\\int }_{0}^{3x}{x}^{2}+{y}^{2}\\,\\text{d}y]\\text{d}x \\\\  & =k{\\int }_{0}^{1}{[{x}^{2}y+\\frac{1}{3}{y}^{3}]}_{y=0}^{y=3x}\\,\\text{d}x \\\\  & =k{\\int }_{0}^{1}{x}^{2}(3x)+\\frac{1}{3}(3x)^{3}\\,\\text{d}x \\\\  & =k{\\int }_{0}^{1}12{x}^{3}\\,\\text{d}x \\\\  & =k{[3{x}^{4}]}_{0}^{1} \\\\  & =3k\\end{aligned}\n$$\n\nTherefore, $k=\\frac{M}{3}$ and hence,\n\n$$\n\\lambda (x,y)=k({x}^{2}+{y}^{2})=\\frac{M}{3}({x}^{2}+{y}^{2}).\n$$\n\nTherefore, the moment of inertia about the $y$-axis is\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{3}{\\int }_{0}^{1}{\\int }_{0}^{3x}{x}^{2}({x}^{2}+{y}^{2})\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{M}{3}{\\int }_{0}^{1}[{\\int }_{0}^{3x}{x}^{4}+{x}^{2}{y}^{2}\\,\\text{d}y]\\text{d}x \\\\  & =\\frac{M}{3}{\\int }_{0}^{1}{[{x}^{4}y+\\frac{1}{3}{x}^{2}{y}^{3}]}_{y=0}^{y=3x}\\,\\text{d}x \\\\  & =\\frac{M}{3}{\\int }_{0}^{1}{x}^{4}(3x)+\\frac{1}{3}{x}^{2}(3x)^{3}\\,\\text{d}x \\\\  & =\\frac{M}{3}{\\int }_{0}^{1}12{x}^{5}\\,\\text{d}x \\\\  & =\\frac{M}{3}{[2{x}^{6}]}_{0}^{1} \\\\  & =\\frac{2M}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186426171 #edb/ref 1068 #edb/ref 17592186426158 #edb/ref 17592186045417] [17592186426171 #edb/ref 1069 "q-163175" #edb/ref 17592186045417] [17592186426171 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186426171 #edb/ref 1071 "![](images/eb/eb4ea276f4b876ce42b3701d60c1a5967769b62b328c16e9f9e75ef050f18d6f.png)\n\nA plate occupies the region $D$ enclosed by the $y$-axis and the curves $y={x}^{2}$ and $y=x+2$ in the first quadrant, as shown above. If the mass density function of $D$ is given by $\\lambda (x,y)=15x,$ find the moment of inertia of the lamina about the $y$-axis." #edb/ref 17592186045417] [17592186426171 #edb/ref 1072 #uuid "c8a5bd24-d88b-5487-ab23-00b382428ad5" #edb/ref 17592186045417] [17592186426171 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that $D$ is a type I region with representation\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\,{x}^{2}\\le y\\le x+2\\},\n$$\n\nas shown below.\n\n![](images/f1/f11f3026c9cc7f315781470791f03d3df97d7f292f8b713a1903f021bd5bf6c6.png)\n\nUsing the formula for ${I}_{y},$ we get\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{{x}^{2}}^{x+2}{x}^{2}(15x)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}[{\\int }_{{x}^{2}}^{x+2}15{x}^{3}\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{0}^{2}15{x}^{3}[y]_{y={x}^{2}}^{y=x+2}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}15{x}^{3}(x+2-{x}^{2})\\text{d}x \\\\  & ={\\int }_{0}^{2}15{x}^{4}+30{x}^{3}-15{x}^{5}\\,\\text{d}x \\\\  & ={[3{x}^{5}+\\frac{15}{2}{x}^{4}-\\frac{5}{2}{x}^{6}]}_{0}^{2} \\\\  & =96+120-160 \\\\  & =56.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186426172 #edb/ref 1068 #edb/ref 17592186426152 #edb/ref 17592186045417] [17592186426172 #edb/ref 1069 "q-163145" #edb/ref 17592186045417] [17592186426172 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186426172 #edb/ref 1071 "A rectangular plate occupies the region\n$D=\\{(x,y)\\,:\\,2\\le x\\le 4,\\,\\,0\\le y\\le 1\\}$\nwith mass density function $\\lambda (x,y)=x{y}^{2}\\,\\text{kg}/{\\text{m}}^{2},$ where $x$ and $y$ area measured in meters. Find the moment of inertia of this lamina about the $x$-axis." #edb/ref 17592186045417] [17592186426172 #edb/ref 1072 #uuid "d5a11202-6be7-5636-bb7a-f06e82bc2539" #edb/ref 17592186045417] [17592186426172 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nUsing the formula for ${I}_{x},$ we get\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{2}^{4}{y}^{2}\\cdot x{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}[{\\int }_{2}^{4}x{y}^{4}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{4}{[\\frac{1}{2}{x}^{2}]}_{2}^{4}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}6{y}^{4}\\,\\text{d}y \\\\  & ={[\\frac{6}{5}{y}^{5}]}_{0}^{1} \\\\  & =\\frac{6}{5}-0 \\\\  & =1.2.\\end{aligned}\n$$\n\nTherefore, the moment of inertia of the lamina about the $x$-axis is $1.2\\,\\text{kg}\\cdot {\\text{m}}^{2}.$" #edb/ref 17592186045417] [17592186426173 #edb/ref 1068 #edb/ref 17592186426148 #edb/ref 17592186045417] [17592186426173 #edb/ref 1069 "q-163147" #edb/ref 17592186045417] [17592186426173 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186426173 #edb/ref 1071 "A rectangular plate occupies the region\n$D=\\{(x,y)\\,:\\,e\\le x\\le {e}^{3},\\,\\,1\\le y\\le 2\\}$\nwith mass density function $\\lambda (x,y)=\\frac{y}{x}\\,\\text{kg}/{\\text{m}}^{2},$ where $x$ and $y$ area measured in meters. Find the moment of inertia of this lamina about the $x$-axis." #edb/ref 17592186045417] [17592186426173 #edb/ref 1072 #uuid "e2c7c1bb-fa37-5eb7-bb09-c424d91d3ac4" #edb/ref 17592186045417] [17592186426173 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nUsing the formula for ${I}_{x},$ we get\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{1}^{2}{\\int }_{e}^{{e}^{3}}{y}^{2}\\cdot \\frac{y}{x}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}[{\\int }_{e}^{{e}^{3}}\\frac{{y}^{3}}{x}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{1}^{2}{y}^{3}[\\operatorname{ln}⁡x]_{e}^{{e}^{3}}\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}2{y}^{3}\\,\\text{d}y \\\\  & ={[\\frac{{y}^{4}}{2}]}_{1}^{2} \\\\  & =8-\\frac{1}{2} \\\\  & =7.5.\\end{aligned}\n$$\n\nTherefore, the moment of inertia of the lamina about the $x$-axis is $7.5\\,\\text{kg}\\cdot {\\text{m}}^{2}.$" #edb/ref 17592186045417]}
