45417] [17592186281047 #edb/ref 1075 #edb/ref 17592186280002 #edb/ref 17592186045417] [17592186281047 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186281047 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186281047 #edb/ref 1078 #edb/ref 17592186279374 #edb/ref 17592186045417] [17592186281047 #edb/ref 1079 #uuid "74d4dcbe-c022-55cf-9e37-929259d9b865" #edb/ref 17592186045417] [17592186281631 #edb/ref 1068 #edb/ref 17592186280998 #edb/ref 17592186045417] [17592186281631 #edb/ref 1069 "q-163200" #edb/ref 17592186045417] [17592186281631 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186281631 #edb/ref 1071 "A rectangular plate of mass $M\\,\\text{kg}$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 3,\\,\\,1\\le y\\le 4\\},$ where $x$ and $y$ are measured in meters. Find the moment of inertia of the plate about the origin." #edb/ref 17592186045417] [17592186281631 #edb/ref 1072 #uuid "f8b4a4d7-db6d-5f9c-bc7b-f800dc788f58" #edb/ref 17592186045417] [17592186281631 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nThe area of the rectangular plate $D$ is $A=3\\cdot 3=9.$ \n\nSince the plate has uniform density, every unit of area contains the same amount of mass. Therefore, the mass density is constant and is given by the total mass divided by the total area:\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{9}.\n$$\n\nUsing the formula for ${I}_{0},$ we get\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{9}{\\int }_{1}^{4}{\\int }_{0}^{3}{x}^{2}+{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{9}{\\int }_{1}^{4}{[\\frac{1}{3}{x}^{3}+x{y}^{2}]}_{x=0}^{x=3}\\,\\text{d}y \\\\  & =\\frac{M}{9}{\\int }_{1}^{4}9+3{y}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{9}{[9y+{y}^{3}]}_{1}^{4} \\\\  & =\\frac{M}{9}(36+64-9-1) \\\\  & =10M\\end{aligned}\n$$\n\nTherefore, the moment of inertia is $10M\\,\\text{kg}\\cdot {\\text{m}}^{2}.$" #edb/ref 17592186045417] [17592186367839 #edb/ref 1068 #edb/ref 17592186367840 #edb/ref 17592186045417] [17592186367839 #edb/ref 1069 "q-163181" #edb/ref 17592186045417] [17592186367839 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186367839 #edb/ref 1071 "A rectangular plate of mass $M$ occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 2\\}.$\nThe mass density at each point is proportional to the sum of its distance from the \n$x$-axis and its distance from the $y$-axis. Find the moment of inertia of the lamina about the $x$-axis." #edb/ref 17592186045417] [17592186367839 #edb/ref 1072 #uuid "277b81af-ece5-57d8-a083-94f5105fa453" #edb/ref 17592186045417] [17592186367839 #edb/ref 1074 "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFrom the description, the mass density function can be written as\n\n$$\n\\lambda (x,y)=k(|x|+|y|)=k(x+y),\n$$\n\nwhere $k$ is a constant of proportionality. We can find an expression for $k$ in terms of $M$ by integrating the density function over the plate:\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}k(x+y)\\,\\text{d}x\\,\\text{d}y \\\\  & =k{\\int }_{0}^{2}{\\int }_{0}^{2}x+y\\,\\text{d}x\\,\\text{d}y \\\\  & =k{\\int }_{0}^{2}{[\\frac{1}{2}{x}^{2}+xy]}_{x=0}^{x=2}\\,\\text{d}y \\\\  & =k{\\int }_{0}^{2}2+2y\\,\\text{d}y \\\\  & =k{[2y+{y}^{2}]}_{0}^{2} \\\\  & =k(4+4) \\\\  & =8k\\end{aligned}\n$$\n\nTherefore, $k=\\frac{M}{8}$ and hence,\n\n$$\n\\lambda (x,y)=k(x+y)=\\frac{M}{8}(x+y).\n$$\n\nTherefore, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}{\\int }_{0}^{2}{y}^{2}\\cdot (x+y)\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}{\\int }_{0}^{2}x{y}^{2}+{y}^{3}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}{[\\frac{1}{2}{x}^{2}{y}^{2}+x{y}^{3}]}_{x=0}^{x=2}\\,\\text{d}y \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}2{y}^{2}+2{y}^{3}\\,\\text{d}y \\\\  & =\\frac{M}{8}{[\\frac{2}{3}{y}^{3}+\\frac{1}{2}{y}^{4}]}_{0}^{2} \\\\  & =\\frac{M}{8}(\\frac{16}{3}+8) \\\\  & =\\frac{5M}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186367840 #edb/ref 1075 #edb/ref 17592186367841 #edb/ref 17592186045417] [17592186367840 #edb/ref 1075 #edb/ref 17592186367842 #edb/ref 17592186045417] [17592186367840 #edb/ref 1075 #edb/ref 17592186367843 #edb/ref 17592186045417] [17592186367840 #edb/ref 1075 #edb/ref 17592186367844 #edb/ref 17592186045417] [17592186367840 #edb/ref 1075 #edb/ref 17592186367845 #edb/ref 17592186045417] [17592186367840 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186367840 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186367840 #edb/ref 1078 #edb/ref 17592186367841 #edb/ref 17592186045417] [17592186367840 #edb/ref 1079 #uuid "836bf381-5e9c-5e6d-b2b3-b979431c05d9" #edb/ref 17592186045417] [17592186367841 #edb/ref 1080 "\\frac{5M}{3}" #edb/ref 17592186045417] [17592186367841 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186367841 #edb/ref