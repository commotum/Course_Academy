}{3}" :db/id #edb/ref 17592186278732} {:answer/id #uuid "558e7a6e-54fa-5cf5-b950-f4588987db71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18M}{5}" :db/id #edb/ref 17592186279374} {:answer/id #uuid "6e7a5abc-84ff-5f6c-a768-c87b8daaf933" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15M}{4}" :db/id #edb/ref 17592186279596} {:answer/id #uuid "8278e096-7229-5cc7-8e98-ca881cad0f81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16M}{3}" :db/id #edb/ref 17592186279760} {:answer/id #uuid "9ed658dc-c3a3-5271-904b-ccb211ce8bcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16M}{5}" :db/id #edb/ref 17592186280002}] :answer-field/correct {:answer/id #uuid "558e7a6e-54fa-5cf5-b950-f4588987db71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18M}{5}" :db/id #edb/ref 17592186279374} :answer-field/id #uuid "74d4dcbe-c022-55cf-9e37-929259d9b865" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281047}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54c0ec35-7150-5d58-acd5-421129a7e7ba" :question/math-academy-id "q-162986" :question/problem "A rectangular plate of mass $M$ occupies the region\n$D={(x,y)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le 3}.$\nThe mass density at each point is proportional to the square of its distance from the $y$-axis.\nFind the moment of inertia of the lamina about the origin." :question/worked-solution "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFrom the description, the mass density function can be written as $\\lambda (x,y)=k{x}^{2},$ where $k$ is a constant of proportionality. We can find an expression for $k$ in terms of $M$ by integrating the density function over the plate:\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{1}k{x}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =k({\\int }_{0}^{1}{x}^{2}\\,\\text{d}x)({\\int }_{0}^{3}\\,\\text{d}y) \\\\  & =k{[\\frac{1}{3}{x}^{3}]}_{0}^{1}\\cdot [y]_{0}^{3} \\\\  & =k(\\frac{1}{3}-0)(3-0) \\\\  & =k.\\end{aligned}\n$$\n\nTherefore, $k=M$ and hence $\\lambda (x,y)=k{x}^{2}=M{x}^{2}.$\nTherefore, the moment of inertia about the origin is\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & =M{\\int }_{0}^{3}{\\int }_{0}^{1}({x}^{2}+{y}^{2})\\cdot {x}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =M{\\int }_{0}^{3}[{\\int }_{0}^{1}{x}^{4}+{x}^{2}{y}^{2}\\,\\text{d}x]\\text{d}y \\\\  & =M{\\int }_{0}^{3}{[\\frac{1}{5}{x}^{5}+\\frac{1}{3}{x}^{3}{y}^{2}]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & =M{\\int }_{0}^{3}\\frac{1}{5}+\\frac{1}{3}{y}^{2}\\,\\text{d}y \\\\  & =M{[\\frac{1}{5}y+\\frac{1}{9}{y}^{3}]}_{0}^{3} \\\\  & =M(\\frac{3}{5}+3-0) \\\\  & =\\frac{18M}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129537 :knowledge-point/_questions [{:db/id #edb/ref 17592186129285 :knowledge-point/id #uuid "eba1f811-7b7d-56f6-8b49-4e7a4c7db81b" :knowledge-point/title "Calculating Moments of Inertia Using Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80de4587-dcf9-5d8e-b56f-181dbf1054a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7M}{4}" :db/id #edb/ref 17592186126720} {:answer/id #uuid "e4a24dd0-408f-55e9-b605-390bb8a9c014" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7M}{2}" :db/id #edb/ref 17592186126721} {:answer/id #uuid "058d611c-3957-50eb-a39a-d6ad31b6422b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9M}{4}" :db/id #edb/ref 17592186126722} {:answer/id #uuid "6369fd64-4d73-5d21-97c2-0a0348fe4e7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4M" :db/id #edb/ref 17592186126723} {:answer/id #uuid "67e212c8-9935-544e-a440-8c077803cbfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9M}{2}" :db/id #edb/ref 17592186126724}] :answer-field/id #uuid "ac852333-df04-5ad7-904c-15ecf5d8effb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126719}] :question/id #uuid "f503a261-8e11-5e60-9902-aca301725e95" :question/math-academy-id "q-162988" :question/problem "![](images/82/82ed1d9c8965c445488256f2319bd2e1a25b2f685d5ad39c88f2b2ba7f7f5525.png)\n\nConsider a plate of mass $M$ that occupies the region $D$ in the first quadrant bounded by the circle $x^{2} + y^{2} = 9$, shown above. Given that the mass is distributed uniformly across the plate, find the moment of inertia of the plate about the origin."}] [{:db/id #edb/ref 17592186129538 :knowledge-point/_questions [{:db/id #edb/ref 17592186129285 :knowledge-point/id #uuid "eba1f811-7b7d-56f6-8b49-4e7a4c7db81b" :knowledge-point/title "Calculating Moments of Inertia Using Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99fa06f1-9a2e-56a5-b88f-4aea93c90cc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 - 3\\sqrt{3}" :db/id #edb/ref 17592186126726} {:answer/id #uuid "bb3bd6a4-8a48-51b7-82f2-c6095617094e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 - 2\\sqrt{3}" :db/id #edb/ref 17592186126727} {:answer/id #uuid "bfc4de2a-748d-5241-bc88-1b918813c16c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9 - 4\\sqrt{3}" :db/id #edb/ref 17592186126728} {:answer/id #uuid "1755a168-7b62-5a42-8aa6-49495f178178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10 - 4\\sqrt{3}" :db/id #edb/ref 17592186126729} {:answer/id #uuid "389186b8-f7d5-5edc-929b-88ea55c9637b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5 - 2\\sqrt{3}" :db/id #edb/ref 17592186126730}] :answer-field/id #uuid "1239f0fe-7d29-5b4f-895a-1d599c74b28e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126725}] :question/id #uuid "41c034f9-14b4-5bc4-9351-1214f69c2032" :question/math-academy-id "q-162990" :question/problem "![](images/0a/0a85b0be5f8e5db2cf4d1716e4afe4a2780c500d94a1ce282a9d0044f93ba084.png)\n\nConsider the plate that occupies the region $D$ enclosed by the polar circles $r = 1$ and $r = \\sqrt{3}$ and the polar rays $θ = \\frac{π}{6}$ and $θ = \\frac{π}{3}$ in the first quadrant, as shown above. The mass density function of the plate is given by $λ(x, y) = \\frac{6}{x}$. Find the moment of inertia of the plate about the $y$-axis."}] [{:db/id #edb/ref 17592186367839 :knowledge-point/_questions [{:db/id #edb/ref 17592186129284 :knowledge-point/id #uuid "89f280af-9947-5d54-9284-9ae75d46c682" :knowledge-point/title "Calculating the Moment of Inertia Given a Description of a Mass Density Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e0e4dc6-cc83-5e7f-b79b-720783cf7352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5M}{3}" :db/id #edb/ref 17592186367841} {:answer/id #uuid "a0587d1f-391c-5f9b-b8d8-5028a4784a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M" :db/id #edb/ref 17592186367842} {:answer/id #uuid "4546c8b6-bbbc-54a2-93a7-576b3f98f83a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5M" :db/id #edb/ref 17592186367843} {:answer/id #uuid "5adb24a3-dc97-532e-a764-ed7f738bd46a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2M" :db/id #edb/ref 17592186367844} {:answer/id #uuid "ca913f2f-94bb-5779-968a-0f4050cccdc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2M}{5}" :db/id #edb/ref 17592186367845}] :answer-field/correct {:answer/id #uuid "5e0e4dc6-cc83-5e7f-b79b-720783cf7352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5M}{3}" :db/id #edb/ref 17592186367841} :answer-field/id #uuid "836bf381-5e9c-5e6d-b2b3-b979431c05d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367840}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "277b81af-ece5-57d8-a083-94f5105fa453" :question/math-academy-id "q-163181" :question/problem "A rectangular plate of mass $M$ occupies the region\n$D={(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 2}.$\nThe mass density at each point is proportional to the sum of its distance from the \n$x$-axis and its distance from the $y$-axis. Find the moment of inertia of the lamina about the $x$-axis." :question/worked-solution "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nFrom the description, the mass density function can be written as\n\n$$\n\\lambda (x,y)=k(|x|+|y|)=k(x+y),\n$$\n\nwhere $k$ is a constant of proportionality. We can find an expression for $k$ in terms of $M$ by integrating the density function over the plate:\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}k(x+y)\\,\\text{d}x\\,\\text{d}y \\\\  & =k{\\int }_{0}^{2}{\\int }_{0}^{2}x+y\\,\\text{d}x\\,\\text{d}y \\\\  & =k{\\int }_{0}^{2}{[\\frac{1}{2}{x}^{2}+xy]}_{x=0}^{x=2}\\,\\text{d}y \\\\  & =k{\\int }_{0}^{2}2+2y\\,\\text{d}y \\\\  & =k{[2y+{y}^{2}]}_{0}^{2} \\\\  & =k(4+4) \\\\  & =8k\\end{aligned}\n$$\n\nTherefore, $k=\\frac{M}{8}$ and hence,\n\n$$\n\\lambda (x,y)=k(x+y)=\\frac{M}{8}(x+y).\n$$\n\nTherefore, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}{\\int }_{0}^{2}{y}^{2}\\cdot (x+y)\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}{\\int }_{0}^{2}x{y}^{2}+{y}^{3}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}{[\\frac{1}{2}{x}^{2}{y}^{2}+x{y}^{3}]}_{x=0}^{x=2}\\,\\text{d}y \\\\  & =\\frac{M}{8}{\\int }_{0}^{2}2{y}^{2}+2{y}^{3}\\,\\text{d}y \\\\  & =\\frac{M}{8}{[\\frac{2}{3}{y}^{3}+\\frac{1}{2}{y}^{4}]}_{0}^{2} \\\\  & =\\frac{M}{8}(\\frac{16}{3}+8) \\\\  & =\\frac{5M}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281631 :knowledge-point/_questions [{:db/id #edb/ref 17592186129211 :knowledge-point/id #uuid "92cc3d27-0e31-571f-9b92-4f209c5a08e0" :knowledge-point/title "Calculating the Moment of Inertia of a Lamina With Uniform Mass Density"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10a700cc-9a80-52fe-b948-d035b0b0b50c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6M\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186278741} {:answer/id #uuid "365b10c1-9a22-5c79-b9b5-50173e8aadde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{3}\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186279066} {:answer/id #uuid "93ceeab5-b213-5adc-ad04-95c2bdacb462" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8M}{9}\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186279906} {:answer/id #uuid "97708c84-8902-5f55-921b-48e526407aec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12M\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186279931} {:answer/id #uuid "c877bf68-98d8-5d6e-ba06-a282245771bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10M\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186280346}] :answer-field/correct {:answer/id #uuid "c877bf68-98d8-5d6e-ba06-a282245771bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10M\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186280346} :answer-field/id #uuid "5e2bfd6e-e15f-531c-8cb4-6aaab1b19f82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280998}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f8b4a4d7-db6d-5f9c-bc7b-f800dc788f58" :question/math-academy-id "q-163200" :question/problem "A rectangular plate of mass $M\\,\\text{kg}$ and uniform mass density occupies the region\n$D={(x,y)\\,:\\,0\\le x\\le 3,\\,\\,1\\le y\\le 4},$ where $x$ and $y$ are measured in meters. Find the moment of inertia of the plate about the origin." :question/worked-solution "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nThe area of the rectangular plate $D$ is $A=3\\cdot 3=9.$ \n\nSince the plate has uniform density, every unit of area contains the same amount of mass. Therefore, the mass density is constant and is given by the total mass divided by the total area:\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{9}.\n$$\n\nUsing the formula for ${I}_{0},$ we get\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{9}{\\int }_{1}^{4}{\\int }_{0}^{3}{x}^{2}+{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{9}{\\int }_{1}^{4}{[\\frac{1}{3}{x}^{3}+x{y}^{2}]}_{x=0}^{x=3}\\,\\text{d}y \\\\  & =\\frac{M}{9}{\\int }_{1}^{4}9+3{y}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{9}{[9y+{y}^{3}]}_{1}^{4} \\\\  & =\\frac{M}{9}(36+64-9-1) \\\\  & =10M\\end{aligned}\n$$\n\nTherefore, the moment of inertia is $10M\\,\\text{kg}\\cdot {\\text{m}}^{2}.$"}]}
