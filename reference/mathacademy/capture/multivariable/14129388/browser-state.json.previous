      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129388/observations/step-q163214-1a1d2d0388a9d741f1e9.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129388/observations/step-q163214-1a1d2d0388a9d741f1e9.png",
      "source_url": "https://mathacademy.com/tasks/14129388/topics/2027/lesson",
