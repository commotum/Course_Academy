      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129388/observations/step-q163195-af06b27d7db5fd6d8c0c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129388/observations/step-q163195-af06b27d7db5fd6d8c0c.png",
