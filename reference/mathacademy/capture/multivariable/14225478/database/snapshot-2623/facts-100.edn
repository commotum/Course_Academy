134-af7b-577f-bb8b-2009b066b22f" #edb/ref 17592186045417] [17592186544767 #edb/ref 1075 #edb/ref 17592186544378 #edb/ref 17592186045417] [17592186544767 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186544767 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186544767 #edb/ref 1078 #edb/ref 17592186544378 #edb/ref 17592186045417] [17592186544767 #edb/ref 1079 #uuid "e8e0339e-584d-50e3-9d66-c4b5654e80f2" #edb/ref 17592186045417] [17592186544772 #edb/ref 1075 #edb/ref 17592186544093 #edb/ref 17592186045417] [17592186544772 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186544772 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186544772 #edb/ref 1078 #edb/ref 17592186544093 #edb/ref 17592186045417] [17592186544772 #edb/ref 1079 #uuid "f1988ed4-093d-51e3-9639-cb7ca3f1716c" #edb/ref 17592186045417] [17592186544796 #edb/ref 1068 #edb/ref 17592186544675 #edb/ref 17592186045417] [17592186544796 #edb/ref 1069 "q-332026" #edb/ref 17592186045417] [17592186544796 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186544796 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t)-3{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-2{x}_{1}(t)+3{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}4 \\\\ -2\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=\\frac{2(2s-3)}{s(s-5)},\\,{X}_{2}(s)=${{field-1}}." #edb/ref 17592186045417] [17592186544796 #edb/ref 1072 #uuid "229cdf1d-b683-5de3-b351-27b1d6a26233" #edb/ref 17592186045417] [17592186544796 #edb/ref 1074 "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{2{x}_{1}(t)-3{x}_{2}(t)\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{-2{x}_{1}(t)+3{x}_{2}(t)\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=2L\\{{x}_{1}(t)\\}-3L\\{{x}_{2}(t)\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=-2L\\{{x}_{1}(t)\\}+3L\\{{x}_{2}(t)\\}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)-4=2{X}_{1}(s)-3{X}_{2}(s) \\\\ s{X}_{2}(s)+2=-2{X}_{1}(s)+3{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$\n\nRewriting the system in standard form, we get the following:\n\n$$\n\\{\\begin{aligned}(s-2){X}_{1}(s)+3{X}_{2}(s)=4 \\\\ 2{X}_{1}(s)+(s-3){X}_{2}(s)=-2\\end{aligned}\n$$\n\nNow, from the second equation, we have \n\n$$\n{X}_{1}(s)=\\frac{-2-(s-3){X}_{2}(s)}{2}.\n$$\n\nSubstituting this into the first equation, we get\n\n$$\n\\begin{aligned}(s-2)[\\frac{-2-(s-3){X}_{2}(s)}{2}]+3{X}_{2}(s) & =4 \\\\ (s-2)[-2-(s-3){X}_{2}(s)]+6{X}_{2}(s) & =8 \\\\ -2(s-2)-[(s-2)(s-3)-6]{X}_{2}(s) & =8 \\\\ -({s}^{2}-5s){X}_{2}(s) & =8+2(s-2) \\\\ -s(s-5){X}_{2}(s) & =2s+4 \\\\ {X}_{2}(s) & =\\frac{-2(s+2)}{s(s-5)}.\\end{aligned}\n$$\n\nNext, we find ${X}_{1}(s):$\n\n$$\n\\begin{aligned}{X}_{1}(s) & =\\frac{-2-(s-3){X}_{2}(s)}{2} \\\\  & =\\frac{-2-(s-3)\\cdot \\frac{-2(s+2)}{s(s-5)}}{2} \\\\  & =\\frac{-2s(s+5)+2(s-3)(s+2)}{2s(s-5)} \\\\  & =\\frac{2(2s-3)}{s(s-5)}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{X}_{1}(s)=\\frac{2(2s-3)}{s(s-5)},\\,{X}_{2}(s)=\\frac{-2(s+2)}{s(s-5)}.\n$$" #edb/ref 17592186045417] [17592186544859 #edb/ref 1068 #edb/ref 17592186544671 #edb/ref 17592186045417] [17592186544859 #edb/ref 1068 #edb/ref 17592186544679 #edb/ref 17592186045417] [17592186544859 #edb/ref 1068 #edb/ref 17592186544695 #edb/ref 17592186045417] [17592186544859 #edb/ref 1068 #edb/ref 17592186544767 #edb/ref 17592186045417] [17592186544859 #edb/ref 1069 "q-332388" #edb/ref 17592186045417] [17592186544859 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186544859 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=3{x}_{1}(t)+5{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}2 \\\\ -1\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L\\{{x}_{1}(t)\\}=\\frac{2}{s-2},\\,{X}_{2}(s)=L\\{{x}_{2}(t)\\}=-\\frac{2}{s-2}+\\frac{1}{s-5}.\n$$\n\nFind the solution to the original initial value problem.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,{e}^{2t}+\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,{e}^{5t}$</td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186544859 #edb/ref 1072 #uuid "9de0e52e-4e54-5cd5-8e58-4fda732ef76e" #edb/ref 17592186045417] [17592186544859 #edb/ref 1074 "To find ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to ${X}_{1}(s)$ and ${X}_{2}(s):$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}\\{{X}_{1}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{2}{s-2}\\} \\\\  & =2{L}^{-1}\\{\\frac{1}{s-2}\\} \\\\  & =2{e}^{2\\cdot t} \\\\  & =2{e}^{2t} \\\\ {x}_{2}(t) & ={L}^{-1}\\{{X}_{2}(s)\\} \\\\  & ={L}^{-1}\\{-\\frac{2}{s-2}+\\frac{1}{s-5}\\} \\\\  & =-2{L}^{-1}\\{\\frac{1}{s-2}\\}+{L}^{-1}\\{\\frac{1}{s-5}\\} \\\\  & =-2{e}^{2\\cdot t}+{e}^{5\\cdot t} \\\\  & =-2{e}^{2t}+{e}^{5t}\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}2{e}^{2t} \\\\ -2{e}^{2t}+{e}^{5t}\\end{aligned}]=[\\begin{aligned}2 \\\\ -2\\end{aligned}]{e}^{2t}+[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{5t}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186544880 #edb/ref 1068 #edb/ref 17592186544655 #edb/ref 17592186045417] [17592186544880 #edb/ref 1068 #edb/ref 17592186544680 #edb/ref 17592186045417] [17592186544880 #edb/ref 1068 #edb/ref 17592186544700 #edb/ref 17592186045417] [17592186544880 #edb/ref 1068 #edb/ref 17592186544761 #edb/ref 17592186045417] [17592186544880 #edb/ref 1069 "q-332382" #edb/ref 17592186045417] [17592186544880 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186544880 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=3{x}_{1}(t) \\\\ {x}_{2}^{′}(t)={x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}2 \\\\ -2\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L\\{{x}_{1}(t)\\}=\\frac{2}{s-3},\\,{X}_{2}(s)=L\\{{x}_{2}(t)\\}=\\frac{1}{s-3}-\\frac{3}{s-1}.\n$$\n\nFind the solution to the original initial value problem.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,{e}^{3t}+\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,{e}^{t}$</td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186544880 #edb/ref 1072 #uuid "d0737b10-0304-5e2e-a18d-ef1cf02a07ff" #edb/ref 17592186045417] [17592186544880 #edb/ref 1074 "To find ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to ${X}_{1}(s)$ and ${X}_{2}(s):$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}\\{{X}_{1}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{2}{s-3}\\} \\\\  & =2{L}^{-1}\\{\\frac{1}{s-3}\\} \\\\  & =2{e}^{3\\cdot t} \\\\  & =2{e}^{3t} \\\\ {x}_{2}(t) & ={L}^{-1}\\{{X}_{2}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s-3}-\\frac{3}{s-1}\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s-3}\\}-3{L}^{-1}\\{\\frac{1}{s-1}\\} \\\\  & ={e}^{3\\cdot t}-3{e}^{1\\cdot t} \\\\  & ={e}^{3t}-3{e}^{t}\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}2{e}^{3t} \\\\ {e}^{3t}-3{e}^{t}\\end{aligned}]=[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{3t}+[\\begin{aligned}0 \\\\ -3\\end{aligned}]{e}^{t}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186544883 #edb/ref 1068 #edb/ref 17592186544772 #edb/ref 17592186045417] [17592186544883 #edb/ref 1069 "q-331950" #edb/ref 17592186045417] [17592186544883 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186544883 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+3{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-2{x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}2 \\\\ 4\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},\n$\\,{X}_{2}(s)=\\frac{4(s-2)}{{s}^{2}-2s+7}.$" #edb/ref 17592186045417] [17592186544883 #edb/ref 1072 #uuid "d4b0fddb-f441-5332-9904-2f366a824fe8" #edb/ref 17592186045417] [17592186544883 #edb/ref 1074 "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{{x}_{1}(t)+3{x}_{2}(t)\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{-2{x}_{1}(t)+{x}_{2}(t)\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=L\\{{x}_{1}(t)\\}+3L\\{{x}_{2}(t)\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=-2L\\{{x}_{1}(t)\\}+L\\{{x}_{2}(t)\\}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)-2={X}_{1}(s)+3{X}_{2}(s) \\\\ s{X}_{2}(s)-4=-2{X}_{1}(s)+{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$\n\nRewriting the system in standard form, we get the following:\n\n$$\n\\{\\begin{aligned}(s-1){X}_{1}(s)-3{X}_{2}(s)=2 \\\\ 2{X}_{1}(s)+(s-1){X}_{2}(s)=4\\end{aligned}\n$$\n\nNow, from the second equation, we have \n\n$$\n{X}_{1}(s)=\\frac{4-(s-1){X}_{2}(s)}{2}.\n$$\n\nSubstituting this into the first equation, we get\n\n$$\n\\begin{aligned}(s-1)[\\frac{4-(s-1){X}_{2}(s)}{2}]-3{X}_{2}(s) & =2 \\\\ 4(s-1)-(s-1)^{2}{X}_{2}(s)-6{X}_{2}(s) & =4 \\\\ 4(s-1)-[(s-1)^{2}+6]{X}_{2}(s) & =4 \\\\ 4(s-1)-({s}^{2}-2s+7){X}_{2}(s) & =4 \\\\ -({s}^{2}-2s+7){X}_{2}(s) & =4-4(s-1) \\\\ -({s}^{2}-2s+7){X}_{2}(s) & =-4s+8 \\\\ {X}_{2}(s) & =\\frac{4(s-2)}{{s}^{2}-2s+7}.\\end{aligned}\n$$\n\nNext, we find ${X}_{1}(s):$\n\n$$\n\\begin{aligned}{X}_{1}(s) & =\\frac{4-(s-1){X}_{2}(s)}{2} \\\\  & =\\frac{4-(s-1)\\cdot \\frac{4(s-2)}{{s}^{2}-2s+7}}{2} \\\\  & =\\frac{4({s}^{2}-2s+7)-(s-1)\\cdot 4(s-2)}{2({s}^{2}-2s+7)} \\\\  & =\\frac{4{s}^{2}-8s+28-4(s-1)(s-2)}{2({s}^{2}-2s+7)} \\\\  & =\\frac{4s+20}{2({s}^{2}-2s+7)} \\\\  & =\\frac{2(s+5)}{{s}^{2}-2s+7}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{X}_{1}(s)=\\frac{2(s+5)}{{s}^{2}-2s+7},\\,{X}_{2}(s)=\\frac{4(s-2)}{{s}^{2}-2s+7}.\n$$" #edb/ref 17592186045417] [17592186544904 #edb/ref 1062 #uuid "0dcaece9-51e2-51f1-b644-f84c01d3c37c" #edb/ref 17592186045417] [17592186544904 #edb/ref 1063 #edb/ref 17592186305036 #edb/ref 17592186045417] [17592186544921 #edb/ref 1058 #edb/ref 17592186544980 #edb/ref 17592186045417] [17592186544921 #edb/ref 1062 #uuid "3f14c117-f925-5183-a5be-6eabe149b5f1" #edb/ref 17592186045417] [17592186544921 #edb/ref 1063 #edb/ref 17592186544880 #edb/ref 17592186045417] [17592186544923 #edb/ref 1058 #edb/ref 17592186544921 #edb/ref 17592186045417] [17592186544923 #edb/ref 1062 #uuid "47bef454-c3f4-58da-9039-125730bb8c0a" #edb/ref 17592186045417] [17592186544923 #edb/ref 1063 #edb/ref 17592186544796 #edb/ref 17592186045417] [17592186544929 #edb/ref 1058 #edb/ref 17592186544923 #edb/ref 17592186045417] [17592186544929 #edb/ref 1062 #uuid "587c10b5-901c-515e-9d0a-14cb1187149f" #edb/ref 17592186045417] [17592186544929 #edb/ref 1063 #edb/ref 17592186544883 #edb/ref 17592186045417] [17592186544980 #edb/ref 1058 #edb/ref 17592186544904 #edb/ref 17592186045417] [17592186544980 #edb/ref 1062 #uuid "d4a5ebcb-4913-519a-afda-77425f43427c" #edb/ref 17592186045417] [17592186544980 #edb/ref 1063 #edb/ref 17592186544859 #edb/ref 17592186045417]}
