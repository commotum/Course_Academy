b/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186380586}] :answer-field/correct {:db/id #edb/ref 17592186380584} :answer-field/id #uuid "091a11e0-779c-5adc-8846-339cc5d8f182" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186380581}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "95eda20f-4166-5e69-9b5a-dd4b026bbb36" :question/math-academy-id "q-109874" :question/problem "Consider a $2\\times 4$ matrix $A.$ If $\\text{dim}(\\text{Null}({A}^{T}))=1,$ then $\\text{dim}(\\text{Col}(A))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=2,$ $n=4,$ and $m-r=1.$ \n\nSubstituting $m=2$ into $m-r=1,$ we can find the rank of $A:$\n\n$$\n(2)-r=1\\,⟹\\,r=1\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Col}(A)) & =r=1.\\end{aligned}\n$$"} :step/id #uuid "a1794f0c-c435-5d32-9d3f-3acd3b837de1" :step/next {:db/id #edb/ref 17592186495273}} {:db/id #edb/ref 17592186495262 :step/content {:db/id #edb/ref 17592186134072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07509797-308b-5e51-8c0b-7ce937096e54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Null}(A)" :db/id #edb/ref 17592186380519} {:answer/id #uuid "5d46aa8d-aee6-5949-9319-7a6d7d0087f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}(A)" :db/id #edb/ref 17592186380520} {:answer/id #uuid "3c7884a2-0ad2-55ac-be08-5ec6f1269e25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Null}({A}^{T})" :db/id #edb/ref 17592186380521} {:answer/id #uuid "072d89d9-d407-530a-8155-7168cdaab68b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186380522} {:answer/id #uuid "726d2de0-3519-5e23-aed7-7964192a471f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186380523}] :answer-field/correct {:db/id #edb/ref 17592186380522} :answer-field/id #uuid "3f23184f-d234-52a0-baf0-4d7dec1d4f26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186380518}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f6e9167d-9cc2-5340-981b-f78b8d297972" :question/math-academy-id "q-108917" :question/problem "Let $A$ be a $m\\times n$ matrix. What is the image of $\\text{Col}(A)$ under the action of ${A}^{T}?$" :question/worked-solution "First,  notice that ${A}^{T}$ is a $n\\times m$ matrix.\n\nNow, pre-multiplying a vector $x\\in {R}^{m}$ by ${A}^{T}$ gives a linear combination of the columns of ${A}^{T}:$\n\n$$\n{{\\begin{bmatrix}| & | & ⋯ & | \\\\ {a}_{1}^{T} & {a}_{2}^{T} & ⋯ & {a}_{m}^{T} \\\\ | & | & ⋯ & |\\end{bmatrix}}_{⏟}}_{{A}^{T}}\\cdot {{\\begin{bmatrix}{x}_{1} \\\\ ⋮ \\\\ {x}_{m}\\end{bmatrix}}_{⏟}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ {a}_{1}^{T} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ {a}_{2}^{T} \\\\ |\\end{bmatrix}+⋯+{x}_{m}\\begin{bmatrix}| \\\\ {a}_{m}^{T} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{m}$ under the action of ${A}^{T}$ must be $\\text{Col}({A}^{T}),$ the column space of ${A}^{T},$ or equivalently, the row space of $A.$\n\nFurthermore, since $\\text{Null}({A}^{T})$ is mapped to the zero vector $0$ by the definition of the null subspace, the image of its orthogonal complement $\\text{Col}(({A}^{T})^{T})=\\text{Col}(A)$ must be $\\text{Col}({A}^{T}).$\n\nThis can be schematically visualized, as shown below.\n\n![](images/8c/8ca8508d05e28e4c91b5a7f3c65826ce68b5dacd382bfb1a76f09c09d1d004bf.png)"} :step/id #uuid "e1b380f9-a0f5-5846-b099-eca54ee4d1fe" :step/next {:db/id #edb/ref 17592186495229}} {:db/id #edb/ref 17592186495273 :step/content {:db/id #edb/ref 17592186362784 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29c8b328-6e43-5c3b-8a74-f5fb46485859" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186362786} {:answer/id #uuid "1b5037d9-2aed-5c31-90dd-13749f1173f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186362787} {:answer/id #uuid "7121c77f-ff14-5b7a-a45e-f13b7d7f0e4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186362788} {:answer/id #uuid "92b47738-a4c5-5222-b666-47b27f0b1d15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186362789} {:answer/id #uuid "6dd3b88d-bd0d-5848-9ec4-09ca27570803" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186362790}] :answer-field/correct {:db/id #edb/ref 17592186362788} :answer-field/id #uuid "a13963a1-5122-5b42-936d-18e7d8414e4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362785}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3bb522f3-4dc5-5f07-a21d-cf9bb7dbc721" :question/math-academy-id "q-109875" :question/problem "Consider a $4\\times 5$ matrix $A.$ If $\\text{dim}(\\text{Null}(A))=1,$ then $\\text{dim}(\\text{Col}({A}^{T}))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=4,$ $n=5,$ and $n-r=1.$ \n\nSubstituting $n=5$ into $n-r=1,$ we can find the rank of $A:$\n\n$$\n(5)-r=1\\,⟹\\,r=4\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Col}({A}^{T})) & =r=4.\\end{aligned}\n$$"} :step/id #uuid "fdb62714-5e6a-5d9d-a318-b5c03ffa46c2"}] :activity/title "The Four Fundamental Subspaces of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494311}]}
