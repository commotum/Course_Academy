#{[{:db/id #edb/ref 17592186407245 :knowledge-point/_questions [{:db/id #edb/ref 17592186133888 :knowledge-point/id #uuid "75e1da77-a5dc-5f78-977e-0d6dae99c97e" :knowledge-point/title "Identifying the Images of the Four Fundamental Subspaces of the Matrix Under Its Action"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ad86372-161b-56b5-b9b3-67cb9855544f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186407216} {:answer/id #uuid "3e4b4700-8836-57b3-a254-6685beac57ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Null}({A}^{T})" :db/id #edb/ref 17592186407217} {:answer/id #uuid "65001b28-0435-5b9d-91ec-614c84c822e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{n}" :db/id #edb/ref 17592186407221} {:answer/id #uuid "bf467989-30ff-5c80-94cc-972d1936e437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186407228} {:answer/id #uuid "d63461e1-95f1-5efd-aec4-a9f50c64386c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{m}" :db/id #edb/ref 17592186407232}] :answer-field/correct {:answer/id #uuid "bf467989-30ff-5c80-94cc-972d1936e437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186407228} :answer-field/id #uuid "32cd5975-d7c1-5dd8-91de-4834a553c50c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407239}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9c49e80-5070-56aa-b070-99b1fa2fdff3" :question/math-academy-id "q-109848" :question/problem "Let $A$ be a $m\\times n$ matrix. What is the image of ${R}^{m}$ under the action of ${A}^{T}?$" :question/worked-solution "First, notice that ${A}^{T}$ is a $n\\times m$ matrix.\n\nPre-multiplying a vector $x\\in {R}^{m}$ by ${A}^{T}$ gives a linear combination of the columns of ${A}^{T}:$\n\n$$\n{{\\begin{bmatrix}| & | & ⋯ & | \\\\ {a}_{1}^{T} & {a}_{2}^{T} & ⋯ & {a}_{m}^{T} \\\\ | & | & ⋯ & |\\end{bmatrix}}_{⏟}}_{{A}^{T}}\\cdot {{\\begin{bmatrix}{x}_{1} \\\\ ⋮ \\\\ {x}_{m}\\end{bmatrix}}_{⏟}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ {a}_{1}^{T} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ {a}_{2}^{T} \\\\ |\\end{bmatrix}+⋯+{x}_{m}\\begin{bmatrix}| \\\\ {a}_{m}^{T} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{m}$ under the action of ${A}^{T}$ must be $\\text{Col}({A}^{T}),$ the row space of $A.$"}] [{:db/id #edb/ref 17592186514442 :knowledge-point/_questions [{:db/id #edb/ref 17592186133885 :knowledge-point/id #uuid "5ada5d20-89d8-5bc9-9b10-172356be0eb4" :knowledge-point/title "Identifying an Orthogonal Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48ab1b2f-ec6e-507b-9701-7686776d5ac6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186513728} {:answer/id #uuid "4b89e055-2ad7-5945-ba06-41fd9a844ae2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186513736} {:answer/id #uuid "5279f1a0-7964-5e07-bb5f-5a1cc2249ed2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186513759} {:answer/id #uuid "a13c9b82-7a72-5392-b4b2-9e4a90902573" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186513947} {:answer/id #uuid "dd1d87ab-3668-53ac-951d-faeb38987ac2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186514112}] :answer-field/correct {:answer/id #uuid "dd1d87ab-3668-53ac-951d-faeb38987ac2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186514112} :answer-field/id #uuid "ea9559f3-a3c8-59ae-9017-a04ed616a025" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514336}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9d632f6e-3556-5d97-834c-4e1de9c56681" :question/math-academy-id "q-109858" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Col}({A}^{T}+{B}^{T})$ for all compatible matrices $A$ and $B?$\n\nI. $\\text{Null}(A+B)$\n\nII. $\\text{Col}(A+B)$\n\nIII. $\\text{Null}({A}^{T}+{B}^{T})$" :question/worked-solution "Recall that $\\text{Col}({A}^{T}+{B}^{T})$ is the row space of $({A}^{T}+{B}^{T})^{T}=A+B.$ This consists of all linear combinations of the rows of $A+B.$\n\nIf a vector is orthogonal to every linear combination of the rows of $A+B,$ it must be orthogonal to each row of $A+B.$\nBut notice that when pre-multiplying a vector by $A+B,$ we actually multiply each row of $A+B$ by that vector.\nSo, $\\text{Col}({A}^{T}+{B}^{T})$ must be orthogonal to the null space of $A+B,$ which is $\\text{Null}(A+B).$\n\nTherefore, the correct answer is \"I only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)"}] [{:db/id #edb/ref 17592186362770 :knowledge-point/_questions [{:db/id #edb/ref 17592186133888 :knowledge-point/id #uuid "75e1da77-a5dc-5f78-977e-0d6dae99c97e" :knowledge-point/title "Identifying the Images of the Four Fundamental Subspaces of the Matrix Under Its Action"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab280a44-737b-5327-b8b9-37dc6ef7b3be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{6}" :db/id #edb/ref 17592186362772} {:answer/id #uuid "d5d452ec-369b-54d1-8357-79ad02025a07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{4}" :db/id #edb/ref 17592186362773} {:answer/id #uuid "99ca8573-a2e6-558c-b3c7-031132e63ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Null}({A}^{T})" :db/id #edb/ref 17592186362774} {:answer/id #uuid "f3e2aca3-e8c2-5d00-b0bc-0cf40e3489e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186362775} {:answer/id #uuid "887d2b50-662a-542d-9779-a9834c4a9b0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186362776}] :answer-field/correct {:answer/id #uuid "f3e2aca3-e8c2-5d00-b0bc-0cf40e3489e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186362775} :answer-field/id #uuid "bb6ed2ff-8856-5c19-ae37-a59672f92f3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362771}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f5df99f-1d28-5975-9513-4422bec5dfb5" :question/math-academy-id "q-109860" :question/problem "Let $A$ be a $4\\times 6$ matrix. What is the image of ${R}^{4}$ under the action of ${A}^{T}?$" :question/worked-solution "First, notice that ${A}^{T}$ is a $6\\times 4$ matrix.\n\nPre-multiplying a vector $x\\in {R}^{4}$ by ${A}^{T}$ gives a linear combination of the columns of ${A}^{T}:$\n\n$$\n{{\\begin{bmatrix}| & | & | & | \\\\ {a}_{1}^{T} & {a}_{2}^{T} & {a}_{3}^{T} & {a}_{4}^{T} \\\\ | & | & | & |\\end{bmatrix}}_{⏟}}_{{A}^{T}}\\cdot {{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{bmatrix}}_{⏟}}_{x}={x}_{1}\\begin{bmatrix}| \\\\ {a}_{1}^{T} \\\\ |\\end{bmatrix}+{x}_{2}\\begin{bmatrix}| \\\\ {a}_{2}^{T} \\\\ |\\end{bmatrix}+{x}_{3}\\begin{bmatrix}| \\\\ {a}_{3}^{T} \\\\ |\\end{bmatrix}+{x}_{4}\\begin{bmatrix}| \\\\ {a}_{4}^{T} \\\\ |\\end{bmatrix}\n$$\n\nTherefore, the image of ${R}^{4}$ under the action of ${A}^{T}$ must be $\\text{Col}({A}^{T}),$ the row space of $A.$"}] [{:db/id #edb/ref 17592186407244 :knowledge-point/_questions [{:db/id #edb/ref 17592186133887 :knowledge-point/id #uuid "1a36c7f7-4287-562b-94ea-047b38ede70f" :knowledge-point/title "Finding the Dimensions of the Four Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e0fd37b-833c-5581-bf94-abc93beffe65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186407214} {:answer/id #uuid "6203c04e-a6ad-568e-b086-f63c9a0600d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186407220} {:answer/id #uuid "a5ba999d-5dc0-5e42-af53-78dc73ee4de4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186407224} {:answer/id #uuid "ba9ba337-a858-55b1-bf28-9f915ba4dcc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186407226} {:answer/id #uuid "e18de25a-171d-5acb-88a3-6812297610fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186407234}] :answer-field/correct {:answer/id #uuid "ba9ba337-a858-55b1-bf28-9f915ba4dcc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186407226} :answer-field/id #uuid "e82e089a-caba-5439-8d15-a646e7c8e9fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186407242}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66ca173a-d952-58d1-b484-502590c17693" :question/math-academy-id "q-109873" :question/problem "Consider a $5\\times 6$ matrix $A.$ If $\\text{dim}(\\text{Col}({A}^{T}))=3,$ then $\\text{dim}(\\text{Null}({A}^{T}))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=5,$ $n=6,$ and $r=3.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Null}({A}^{T})) & =m-r=5-3=2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514400 :knowledge-point/_questions [{:db/id #edb/ref 17592186133887 :knowledge-point/id #uuid "1a36c7f7-4287-562b-94ea-047b38ede70f" :knowledge-point/title "Finding the Dimensions of the Four Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ffd03e5-d22d-5766-a803-65f19cfd5c3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186513571} {:answer/id #uuid "407da24d-3379-5bc7-b2ac-f9a5576feabc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186513702} {:answer/id #uuid "568a861a-1250-5245-9ac3-b13ddd599d76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186513766} {:answer/id #uuid "afc78170-0f40-51ef-9a2e-a8c37ba5fad6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186513995} {:answer/id #uuid "e4975b80-f61d-5eb9-898f-fe70609d075c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186514134}] :answer-field/correct {:answer/id #uuid "0ffd03e5-d22d-5766-a803-65f19cfd5c3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186513571} :answer-field/id #uuid "27448a27-2ab1-5f66-ac78-eb27dc883118" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5241b6a1-96aa-5720-ba1b-4d884df832da" :question/math-academy-id "q-109877" :question/problem "Consider a $3\\times 2$ matrix $A.$ If $\\text{dim}(\\text{Col}({A}^{T}))=2,$ then $\\text{dim}(\\text{Null}(A))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=3,$ $n=2,$ and $r=2.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Null}(A)) & =n-r=2-2=0.\\end{aligned}\n$$"}]}
