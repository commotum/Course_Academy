#{[{:db/id #edb/ref 17592186557289 :knowledge-point/_questions [{:db/id #edb/ref 17592186229131 :knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8" :knowledge-point/title "Identifying the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "646e6165-7c3a-5090-b755-0054dbd03146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "te^{4t}" :db/id #edb/ref 17592186556660}] :answer-field/correct {:answer/id #uuid "646e6165-7c3a-5090-b755-0054dbd03146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "te^{4t}" :db/id #edb/ref 17592186556660} :answer-field/id #uuid "174e2ccc-42c8-5609-b37a-59d23929885c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186557078} {:answer-field/choices [{:answer/id #uuid "aca58c0a-4a82-5bea-94ab-b3068980a554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{4t}" :db/id #edb/ref 17592186556855}] :answer-field/correct {:answer/id #uuid "aca58c0a-4a82-5bea-94ab-b3068980a554" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{4t}" :db/id #edb/ref 17592186556855} :answer-field/id #uuid "5604af13-50f7-5867-8a20-353ebbce0164" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186557114}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9f8ace62-6215-5f44-93f8-e30dfc0372e6" :question/math-academy-id "q-334828" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}4 & 1 \\\\ 0 & 4\\end{aligned}]x+[\\begin{aligned}0 \\\\ {e}^{4t}\\end{aligned}],\\,x(0)=[\\begin{aligned}0 \\\\ 1\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{aligned}],$ where $A=[\\begin{aligned}4 & 1 \\\\ 0 & 4\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">$(t-s){e}^{4t}$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">${e}^{4t}$</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =[\\begin{aligned}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}t{e}^{4t} \\\\ {e}^{4t}\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}{e}^{4(t-s)} & (t-s){e}^{4(t-s)} \\\\ 0 & {e}^{4(t-s)}\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}{e}^{4(t-s)} & (t-s){e}^{4(t-s)} \\\\ 0 & {e}^{4(t-s)}\\end{aligned}][\\begin{aligned}0 \\\\ {e}^{4s}\\end{aligned}] \\\\  & =[\\begin{aligned}(t-s){e}^{4t} \\\\ {e}^{4t}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}t{e}^{4t} \\\\ {e}^{4t}\\end{aligned}]+{\\int }_{0}^{t}[\\begin{aligned}(t-s){e}^{4t} \\\\ {e}^{4t}\\end{aligned}]\\text{d}s.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186557325 :knowledge-point/_questions [{:db/id #edb/ref 17592186229131 :knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8" :knowledge-point/title "Identifying the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5b356a7-3b0b-5f1f-bec8-e6b826f26b86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cos t" :db/id #edb/ref 17592186556876}] :answer-field/correct {:answer/id #uuid "b5b356a7-3b0b-5f1f-bec8-e6b826f26b86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cos t" :db/id #edb/ref 17592186556876} :answer-field/id #uuid "17254fb8-737c-5411-ba14-63458b8c5c1e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186557077} {:answer-field/choices [{:answer/id #uuid "c887629a-5ab0-5f5a-85b8-798e29da3914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos(t-s)" :db/id #edb/ref 17592186556912}] :answer-field/correct {:answer/id #uuid "c887629a-5ab0-5f5a-85b8-798e29da3914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos(t-s)" :db/id #edb/ref 17592186556912} :answer-field/id #uuid "adcf2066-3be2-5f5c-966d-7fbfbab80820" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186557162}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f491a1e5-e94d-5b1b-9331-94aa4176665c" :question/math-academy-id "q-334856" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}]x+[\\begin{aligned}0 \\\\ 1\\end{aligned}],\\,x(0)=[\\begin{aligned}2 \\\\ 0\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡t & \\operatorname{sin}⁡t \\\\ -\\operatorname{sin}⁡t & \\operatorname{cos}⁡t\\end{aligned}],$ where $A=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">$\\operatorname{sin}⁡(t-s)$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$-2\\operatorname{sin}⁡t$</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡t & \\operatorname{sin}⁡t \\\\ -\\operatorname{sin}⁡t & \\operatorname{cos}⁡t\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =[\\begin{aligned}\\operatorname{cos}⁡t & \\operatorname{sin}⁡t \\\\ -\\operatorname{sin}⁡t & \\operatorname{cos}⁡t\\end{aligned}][\\begin{aligned}2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{cos}⁡t \\\\ -2\\operatorname{sin}⁡t\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cos}⁡(t-s) & \\operatorname{sin}⁡(t-s) \\\\ -\\operatorname{sin}⁡(t-s) & \\operatorname{cos}⁡(t-s)\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cos}⁡(t-s) & \\operatorname{sin}⁡(t-s) \\\\ -\\operatorname{sin}⁡(t-s) & \\operatorname{cos}⁡(t-s)\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡(t-s) \\\\ \\operatorname{cos}⁡(t-s)\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}2\\operatorname{cos}⁡t \\\\ -2\\operatorname{sin}⁡t\\end{aligned}]+{\\int }_{0}^{t}[\\begin{aligned}\\operatorname{sin}⁡(t-s) \\\\ \\operatorname{cos}⁡(t-s)\\end{aligned}]\\text{d}s.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186229675 :knowledge-point/_questions [{:db/id #edb/ref 17592186229131 :knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8" :knowledge-point/title "Identifying the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c469a0d-2752-523c-9d5e-eb188c66277c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sinh}⁡(5(t-1))+\\operatorname{cosh}⁡(5(t-1))" :db/id #edb/ref 17592186556717} {:answer/id #uuid "e237bdb9-b23d-538d-8ede-1bde46c2390e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sinh}⁡(5(t-1))+2\\operatorname{cosh}⁡(5(t-1))" :db/id #edb/ref 17592186556988} {:answer/id #uuid "f34842c1-f721-52e9-9b77-d0abbbd36f97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sinh}⁡(5(t-1))-2\\operatorname{cosh}⁡(5(t-1))" :db/id #edb/ref 17592186557029}] :answer-field/correct {:answer/id #uuid "7c469a0d-2752-523c-9d5e-eb188c66277c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sinh}⁡(5(t-1))+\\operatorname{cosh}⁡(5(t-1))" :db/id #edb/ref 17592186556717} :answer-field/id #uuid "c47ab649-c3da-5673-8d86-71836125878a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186228234} {:answer-field/choices [{:answer/id #uuid "0538cbde-d100-5661-b565-1459ce5200bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5s}\\operatorname{cosh}⁡(5(t-s))" :db/id #edb/ref 17592186556439} {:answer/id #uuid "8271283e-49da-546a-bd56-2f6be5819b84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5s}\\operatorname{cosh}⁡(5(t+s))" :db/id #edb/ref 17592186556732} {:answer/id #uuid "b2307a16-a23b-5389-9b9e-da92d8558ad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5s}\\operatorname{sinh}⁡(5(t+s))" :db/id #edb/ref 17592186556867} {:answer/id #uuid "ccc40006-4513-51cc-b21e-641f0113825f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5s}\\operatorname{sinh}⁡(5(t-s))" :db/id #edb/ref 17592186556924}] :answer-field/correct {:answer/id #uuid "0538cbde-d100-5661-b565-1459ce5200bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5s}\\operatorname{cosh}⁡(5(t-s))" :db/id #edb/ref 17592186556439} :answer-field/id #uuid "48f44c01-f85c-5f3b-9309-7f51f9a7ace4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186228238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5b327bcf-2ff8-5538-9740-b586ed698ad8" :question/math-academy-id "q-334922" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}0 & 5 \\\\ 5 & 0\\end{aligned}]x+[\\begin{aligned}{e}^{5t} \\\\ 0\\end{aligned}],\\,x(1)=[\\begin{aligned}2 \\\\ 1\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(5t) & \\operatorname{sinh}⁡(5t) \\\\ \\operatorname{sinh}⁡(5t) & \\operatorname{cosh}⁡(5t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 5 \\\\ 5 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"160px\">$2\\operatorname{cosh}⁡(5(t-1))+\\operatorname{sinh}⁡(5(t-1))$</td>\n<td align=\"center\" width=\"5px\"></td><td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{1}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"160px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td><td align=\"center\"></td>\n<td align=\"center\">${e}^{5s}\\operatorname{sinh}⁡(5(t-s))$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(5t) & \\operatorname{sinh}⁡(5t) \\\\ \\operatorname{sinh}⁡(5t) & \\operatorname{cosh}⁡(5t)\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{A(t-1)}\\,x(1) & =[\\begin{aligned}\\operatorname{cosh}⁡(5(t-1)) & \\operatorname{sinh}⁡(5(t-1)) \\\\ \\operatorname{sinh}⁡(5(t-1)) & \\operatorname{cosh}⁡(5(t-1))\\end{aligned}][\\begin{aligned}2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{cosh}⁡(5(t-1))+\\operatorname{sinh}⁡(5(t-1)) \\\\ 2\\operatorname{sinh}⁡(5(t-1))+\\operatorname{cosh}⁡(5(t-1))\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cosh}⁡(5(t-s)) & \\operatorname{sinh}⁡(5(t-s)) \\\\ \\operatorname{sinh}⁡(5(t-s)) & \\operatorname{cosh}⁡(5(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cosh}⁡(5(t-s)) & \\operatorname{sinh}⁡(5(t-s)) \\\\ \\operatorname{sinh}⁡(5(t-s)) & \\operatorname{cosh}⁡(5(t-s))\\end{aligned}][\\begin{aligned}{e}^{5s} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{5s}\\operatorname{cosh}⁡(5(t-s)) \\\\ {e}^{5s}\\operatorname{sinh}⁡(5(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}2\\operatorname{cosh}⁡(5(t-1))+\\operatorname{sinh}⁡(5(t-1)) \\\\ 2\\operatorname{sinh}⁡(5(t-1))+\\operatorname{cosh}⁡(5(t-1))\\end{aligned}]+{\\int }_{1}^{t}[\\begin{aligned}{e}^{5s}\\operatorname{cosh}⁡(5(t-s)) \\\\ {e}^{5s}\\operatorname{sinh}⁡(5(t-s))\\end{aligned}]\\text{d}s.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186557281 :knowledge-point/_questions [{:db/id #edb/ref 17592186229131 :knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8" :knowledge-point/title "Identifying the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c917360-af2a-547f-83e0-3ae046b64006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sinh}⁡(6(t-1))-2\\operatorname{cosh}⁡(6(t-1))" :db/id #edb/ref 17592186556681} {:answer/id #uuid "9a272e7c-5ccc-58a1-bc0e-68ec31a26ddd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sinh}⁡(6(t-1))+2\\operatorname{cosh}⁡(6(t-1))" :db/id #edb/ref 17592186556802} {:answer/id #uuid "d2839194-a132-5ab8-875a-6230951d4cfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sinh}⁡(6(t-1))+\\operatorname{cosh}⁡(6(t-1))" :db/id #edb/ref 17592186556938} {:answer/id #uuid "e345ffd9-c7a8-5122-b489-3449540bacce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sinh}⁡(6(t-1))+2\\operatorname{cosh}⁡(6(t-1))" :db/id #edb/ref 17592186556992}] :answer-field/correct {:answer/id #uuid "d2839194-a132-5ab8-875a-6230951d4cfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sinh}⁡(6(t-1))+\\operatorname{cosh}⁡(6(t-1))" :db/id #edb/ref 17592186556938} :answer-field/id #uuid "46896807-998c-5933-b1eb-99ca4e046406" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186557105} {:answer-field/choices [{:answer/id #uuid "1b53c