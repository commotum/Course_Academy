      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14147847/observations/step-q334541-cebe0eea54027e9606e7.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14147847/observations/step-q334541-cebe0eea54027e9606e7.png",
      "source_url": "https://mathacademy.com/tasks/14147847/topics/6399/lesson",
      "captured_at": 1791833201.8053539,
      "math_academy_id": "q-334541",
      "topic_id": "6399",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q334541",
        "placement_id": null,
        "content_id": null,
