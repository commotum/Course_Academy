      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14147847/observations/step-q334564-a54f86ef58248a97ec62.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14147847/observations/step-q334564-a54f86ef58248a97ec62.png",
      "source_url": "https://mathacademy.com/tasks/14147847/topics/6399/lesson",
      "captured_at": 1791833128.0913296,
      "math_academy_id": "q-334564",
      "topic_id": "6399",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q334564",
        "placement_id": null,
