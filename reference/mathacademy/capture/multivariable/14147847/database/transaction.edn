5487e760-2bc5-53ad-bd4e-fd4334efe259" :answer/id #uuid "5487e760-2bc5-53ad-bd4e-fd4334efe259" :answer/type :answer.type/math :answer/value "0.008" :db/ensure [:answer/validate]} {:db/id "answer-effe7cda-bf42-51ba-9e55-cfbc65bdf3b7" :answer/id #uuid "effe7cda-bf42-51ba-9e55-cfbc65bdf3b7" :answer/type :answer.type/math :answer/value "0.052" :db/ensure [:answer/validate]} {:db/id "answer-6604ea4b-bbe7-5e83-a1de-80d7b0224c4f" :answer/id #uuid "6604ea4b-bbe7-5e83-a1de-80d7b0224c4f" :answer/type :answer.type/math :answer/value "0.138" :db/ensure [:answer/validate]} {:db/id "answer-a460527f-d08d-5e8f-9558-fa2fa830502e" :answer/id #uuid "a460527f-d08d-5e8f-9558-fa2fa830502e" :answer/type :answer.type/math :answer/value "0.276" :db/ensure [:answer/validate]} {:db/id "answer-c8680ff7-a796-5e28-be91-28ae1e60fffa" :answer/id #uuid "c8680ff7-a796-5e28-be91-28ae1e60fffa" :answer/type :answer.type/math :answer/value "0.692" :db/ensure [:answer/validate]} {:db/id "answer-field-e8d5da60-b415-58cd-91b5-f58b2bd119a3" :answer-field/id #uuid "e8d5da60-b415-58cd-91b5-f58b2bd119a3" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-d149b6a5-96d4-56d2-b34b-fb5c6941b716" :answer-field/choices ["answer-0a508b9f-0d5a-531f-825c-e1abd93fb8bb" "answer-d149b6a5-96d4-56d2-b34b-fb5c6941b716" "answer-f6e36dee-2678-5b5b-9982-81cfba7adeed" "answer-0b656bb6-b726-513c-9a3d-224438a3ecc4" "answer-4443a2a7-05c1-5972-ad6e-f45be9b22e2b"] :db/ensure [:answer-field/validate]} {:db/id "answer-0a508b9f-0d5a-531f-825c-e1abd93fb8bb" :answer/id #uuid "0a508b9f-0d5a-531f-825c-e1abd93fb8bb" :answer/type :answer.type/math :answer/value "10.250" :db/ensure [:answer/validate]} {:db/id "answer-d149b6a5-96d4-56d2-b34b-fb5c6941b716" :answer/id #uuid "d149b6a5-96d4-56d2-b34b-fb5c6941b716" :answer/type :answer.type/math :answer/value "16.615" :db/ensure [:answer/validate]} {:db/id "answer-f6e36dee-2678-5b5b-9982-81cfba7adeed" :answer/id #uuid "f6e36dee-2678-5b5b-9982-81cfba7adeed" :answer/type :answer.type/math :answer/value "24.375" :db/ensure [:answer/validate]} {:db/id "answer-0b656bb6-b726-513c-9a3d-224438a3ecc4" :answer/id #uuid "0b656bb6-b726-513c-9a3d-224438a3ecc4" :answer/type :answer.type/math :answer/value "3.125" :db/ensure [:answer/validate]} {:db/id "answer-4443a2a7-05c1-5972-ad6e-f45be9b22e2b" :answer/id #uuid "4443a2a7-05c1-5972-ad6e-f45be9b22e2b" :answer/type :answer.type/math :answer/value "7.812" :db/ensure [:answer/validate]} {:db/id "answer-field-251effb9-9c02-568e-85ed-f4b7bd54ba26" :answer-field/id #uuid "251effb9-9c02-568e-85ed-f4b7bd54ba26" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "answer-7d685181-3077-58b7-9df9-6de68433f229" :answer-field/choices ["answer-43cf3c31-8854-53af-adef-a8e2bab7d1e7" "answer-a9c9f221-8401-5b5d-8ccb-8da7e82c26b4" "answer-f46447fb-7aa1-5e35-a855-5d5b8945d5cc" "answer-7d685181-3077-58b7-9df9-6de68433f229" "answer-1629f72c-2b7a-5ad9-9802-4a4c18a43f8a"] :db/ensure [:answer-field/validate]} {:db/id "answer-43cf3c31-8854-53af-adef-a8e2bab7d1e7" :answer/id #uuid "43cf3c31-8854-53af-adef-a8e2bab7d1e7" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-a9c9f221-8401-5b5d-8ccb-8da7e82c26b4" :answer/id #uuid "a9c9f221-8401-5b5d-8ccb-8da7e82c26b4" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-f46447fb-7aa1-5e35-a855-5d5b8945d5cc" :answer/id #uuid "f46447fb-7aa1-5e35-a855-5d5b8945d5cc" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-7d685181-3077-58b7-9df9-6de68433f229" :answer/id #uuid "7d685181-3077-58b7-9df9-6de68433f229" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-1629f72c-2b7a-5ad9-9802-4a4c18a43f8a" :answer/id #uuid "1629f72c-2b7a-5ad9-9802-4a4c18a43f8a" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-ba7a8267-d75d-5d4b-bc96-5af23d284353" :question/id #uuid "ba7a8267-d75d-5d4b-bc96-5af23d284353" :question/math-academy-id "q-334541" :question/problem "A numerical method is used to approximate the solution to an initial value problem.\n\n- With step size $Δx=0.10,$ the observed global truncation error is $e(0.10)=0.196.$\n\n- With step size $Δx=0.05,$ the observed global truncation error is $e(0.05)=0.050.$\n\nUse this data to estimate the order of the numerical method." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the GTE by a factor of approximately ${k}^{p}.$\n\nIn our case, the step size decreases from $0.10$ to $0.05.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.10}{0.05}=2.\n$$\n\nAs a result, for a numerical method of order $p,$ the GTE should decrease by a factor of approximately\n\n$$\n{k}^{p}={2}^{p}.\n$$\n\nOn the other hand, the GTE actually decreases from $0.196$ to $0.050.$ So, it reduces by a factor of\n\n$$\n\\frac{0.196}{0.050}=3.92.\n$$\n\nComparing the two scale factors for the GTE, we get\n\n$$\n\\begin{aligned}{2}^{p} & ≈3.92 \\\\ p & ≈{log}_{2}⁡(3.92) \\\\ p & ≈1.9708….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the approximate order of the method is $2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e23d9edb-b78e-567f-ad08-a924a47e6c40"] :db/ensure [:question/validate]} {:db/id "answer-field-e23d9edb-b78e-567f-ad08-a924a47e6c40" :answer-field/id #uuid "e23d9edb-b78e-567f-ad08-a924a47e6c40" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b065544d-d7d1-5aab-89ee-6f5daceb6160" :answer-field/choices ["answer-1ca02d59-9dac-5356-af9b-e15310a7e10e" "answer-a7c992ae-d717-5944-94e5-3493912c7021" "answer-b065544d-d7d1-5aab-89ee-6f5daceb6160" "answer-85b20aa2-f27c-518a-9744-718e4205a4bd" "answer-de2ff6f1-c803-5c09-964c-a7254d25d91c"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ca02d59-9dac-5356-af9b-e15310a7e10e" :answer/id #uuid "1ca02d59-9dac-5356-af9b-e15310a7e10e" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-a7c992ae-d717-5944-94e5-3493912c7021" :answer/id #uuid "a7c992ae-d717-5944-94e5-3493912c7021" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-b065544d-d7d1-5aab-89ee-6f5daceb6160" :answer/id #uuid "b065544d-d7d1-5aab-89ee-6f5daceb6160" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-85b20aa2-f27c-518a-9744-718e4205a4bd" :answer/id #uuid "85b20aa2-f27c-518a-9744-718e4205a4bd" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-de2ff6f1-c803-5c09-964c-a7254d25d91c" :answer/id #uuid "de2ff6f1-c803-5c09-964c-a7254d25d91c" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-d97bcc9d-8c7b-5d3a-9dd6-550b8b7b1d07" :question/id #uuid "d97bcc9d-8c7b-5d3a-9dd6-550b8b7b1d07" :question/math-academy-id "q-334668" :question/problem "The local truncation error (LTE) of a numerical method with step size $Δx$ is\n\n$$\nτ(Δx)=5(Δx)^{4}+3(Δx)^{5}.\n$$\n\nComplete the following sentences.\n\n$\\,$ With step size $Δx=0.6,$ the local truncation error is $≈$\n{{field-1}}.\n\n$\\,$ With step size $Δx=0.3,$ the local truncation error is $≈$\n{{field-2}}.\n\n$\\,$ Decreasing from $Δx=0.6$ to $Δx=0.3,$ the LTE is reduced by a factor of $≈$\n{{field-3}}.\n\n$\\,$ According to this data, the order of the method is approximately\n{{field-4}}." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nFirst, we compute the LTE for the given step sizes:\n\n- With step size $Δx=0.6,$ the LTE is\n\n$$\n\\begin{aligned}τ(0.6) & =5(0.6)^{4}+3(0.6)^{5} \\\\  & =5\\cdot 0.129\\,6+3\\cdot 0.077\\,76 \\\\  & =0.648+0.233\\,28 \\\\  & =0.881\\,28 \\\\  & ≈0.881.\\end{aligned}\n$$\n\n- With step size $Δx=0.3,$ the LTE is\n\n$$\n\\begin{aligned}τ(0.3) & =5(0.3)^{4}+3(0.3)^{5} \\\\  & =5\\cdot 0.008\\,1+3\\cdot 0.002\\,43 \\\\  & =0.0405+0.007\\,29 \\\\  & =0.047\\,79 \\\\  & ≈0.048.\\end{aligned}\n$$\n\nNext, we determine the order by comparing the errors. The step size decreases from $0.6$ to $0.3.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.6}{0.3}=2.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}={2}^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.881\\,28$ to $0.047\\,79.$ So, it reduces by a factor of\n\n$$\n\\frac{0.881\\,28}{0.047\\,79}=18.440\\,67…≈18.441.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}{2}^{p+1} & ≈18.440\\,67… \\\\ p+1 & ≈{log}_{2}⁡(18.440\\,67…) \\\\ p+1 & ≈4.204… \\\\ p & ≈3.204….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is\n$3.$\n\nIndeed, this coincides with the definition of the order from the expression for the LTE:\n\n$$\nτ(Δx)=5(Δx)^{4}+3(Δx)^{5}\\,⇒\\,τ(Δx)=O\\,((Δx)^{4})=O\\,((Δx)^{3+1}),\\,Δx\\to 0.\n$$\n\nHence, the order of the method is $3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ccb57d25-2201-5fd5-bfdb-85144f4df777" "answer-field-5d8654d3-6a7c-5fee-8042-cf173e665f29" "answer-field-a6e7a704-d68b-511d-9411-9bb45589b838" "answer-field-eb2f318b-0f2a-5b89-a743-9aa784d99c39"] :db/ensure [:question/validate]} {:db/id "answer-field-ccb57d25-2201-5fd5-bfdb-85144f4df777" :answer-field/id #uuid "ccb57d25-2201-5fd5-bfdb-85144f4df777" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-dd9f3aa1-50c1-548e-8050-70a709bab83e" :answer-field/choices ["answer-043a9000-9408-5bcf-93fc-497849ff02db" "answer-41c94da1-afd2-56a4-8c05-0149c07166e2" "answer-cd004c79-7553-5f58-bc43-4438115bbd28" "answer-54b3e740-607f-5132-a67a-60fb777fcee8" "answer-dd9f3aa1-50c1-548e-8050-70a709bab83e"] :db/ensure [:answer-field/validate]} {:db/id "answer-043a9000-9408-5bcf-93fc-497849ff02db" :answer/id #uuid "043a9000-9408-5bcf-93fc-497849ff02db" :answer/type :answer.type/math :answer/value "0.048" :db/ensure [:answer/validate]} {:db/id "answer-41c94da1-afd2-56a4-8c05-0149c07166e2" :answer/id #uuid "41c94da1-afd2-56a4-8c05-0149c07166e2" :answer/type :answer.type/math :answer/value "0.075" :db/ensure [:answer/validate]} {:db/id "answer-cd004c79-7553-5f58-bc43-4438115bbd28" :answer/id #uuid "cd004c79-7553-5f58-bc43-4438115bbd28" :answer/type :answer.type/math :answer/value "0.375" :db/ensure [:answer/validate]} {:db/id "answer-54b3e740-607f-5132-a67a-60fb777fcee8" :answer/id #uuid "54b3e740-607f-5132-a67a-60fb777fcee8" :answer/type :answer.type/math :answer/value "0.550" :db/ensure [:answer/validate]} {:db/id "answer-dd9f3aa1-50c1-548e-8050-70a709bab83e" :answer/id #uuid "dd9f3aa1-50c1-548e-8050-70a709bab83e" :answer/type :answer.type/math :answer/value "0.881" :db/ensure [:answer/validate]} {:db/id "answer-field-5d8654d3-6a7c-5fee-8042-cf173e665f29" :answer-field/id #uuid "5d8654d3-6a7c-5fee-8042-cf173e665f29" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-cf28a74b-72cd-5f8f-86bf-d59857f9338