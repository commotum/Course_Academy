8-5e73-9836-bfffb8e7e7ea" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-34e9b221-f1ec-557c-a529-86f750142cb5" :answer/id #uuid "34e9b221-f1ec-557c-a529-86f750142cb5" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-1812d74c-f7ff-5b92-ad0c-d300745fe3f0" :question/id #uuid "1812d74c-f7ff-5b92-ad0c-d300745fe3f0" :question/math-academy-id "q-334643" :question/problem "A numerical method is used to approximate the solution to an initial value problem.\n\n- With step size $Δx=0.09,$ the observed local truncation error is $τ(0.09)=0.20.$\n\n- With step size $Δx=0.06,$ the observed local truncation error is $τ(0.06)=0.05.$\n\nEstimate the order of the numerical method." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.09$ to $0.06.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.09}{0.06}=1.5.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}=(1.5)^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.20$ to $0.05.$ So, it reduces by a factor of\n\n$$\n\\frac{0.20}{0.05}=4.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}(1.5)^{p+1} & ≈4 \\\\ p+1 & ≈{log}_{1.5}⁡(4) \\\\ p+1 & ≈3.419… \\\\ p & ≈2.419….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is $2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a944373a-a6f7-5cc7-b56a-d45f56447bab"] :db/ensure [:question/validate]} {:db/id "answer-field-a944373a-a6f7-5cc7-b56a-d45f56447bab" :answer-field/id #uuid "a944373a-a6f7-5cc7-b56a-d45f56447bab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d25d6992-22c7-51c6-8f7a-dcf497256df6" :answer-field/choices ["answer-2d85bffd-8755-5e9b-a7b3-89febd886899" "answer-d25d6992-22c7-51c6-8f7a-dcf497256df6" "answer-fb6df07a-d7ae-549b-8810-208c22275136" "answer-36fa518b-6582-5224-a8cb-c3138d904c19" "answer-78fccd02-9cc5-55f5-b63f-230bd2ea38ba"] :db/ensure [:answer-field/validate]} {:db/id "answer-2d85bffd-8755-5e9b-a7b3-89febd886899" :answer/id #uuid "2d85bffd-8755-5e9b-a7b3-89febd886899" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-d25d6992-22c7-51c6-8f7a-dcf497256df6" :answer/id #uuid "d25d6992-22c7-51c6-8f7a-dcf497256df6" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-fb6df07a-d7ae-549b-8810-208c22275136" :answer/id #uuid "fb6df07a-d7ae-549b-8810-208c22275136" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-36fa518b-6582-5224-a8cb-c3138d904c19" :answer/id #uuid "36fa518b-6582-5224-a8cb-c3138d904c19" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-78fccd02-9cc5-55f5-b63f-230bd2ea38ba" :answer/id #uuid "78fccd02-9cc5-55f5-b63f-230bd2ea38ba" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-a4879a58-4027-569c-b7a3-4f905f12c0fb" :question/id #uuid "a4879a58-4027-569c-b7a3-4f905f12c0fb" :question/math-academy-id "q-334725" :question/problem "The local truncation error (LTE) of a numerical method with step size $Δx$ is\n\n$$\nτ(Δx)=4(Δx)^{3}+(Δx)^{4}.\n$$\n\nComplete the following sentences.\n\n$\\,$ With step size $Δx=0.6,$ the local truncation error is $≈$\n{{field-1}}.\n\n$\\,$ With step size $Δx=0.2,$ the local truncation error is $≈$\n{{field-2}}.\n\n$\\,$ Decreasing from $Δx=0.6$ to $Δx=0.2,$ the LTE is reduced by a factor of $≈$\n{{field-3}}.\n\n$\\,$ According to this data, the order of the method is approximately\n{{field-4}}." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nFirst, we compute the LTE for the given step sizes:\n\n- With step size $Δx=0.6,$ the LTE is\n\n$$\n\\begin{aligned}τ(0.6) & =4(0.6)^{3}+(0.6)^{4} \\\\  & =4\\cdot 0.216+0.129\\,6 \\\\  & =0.993\\,6 \\\\  & ≈0.994.\\end{aligned}\n$$\n\n- With step size $Δx=0.2,$ the LTE is\n\n$$\n\\begin{aligned}τ(0.2) & =4(0.2)^{3}+(0.2)^{4} \\\\  & =4\\cdot 0.008+0.001\\,6 \\\\  & =0.033\\,6 \\\\  & ≈0.034.\\end{aligned}\n$$\n\nNext, we determine the order by comparing the errors. The step size decreases from $0.6$ to $0.2.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.6}{0.2}=3.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}={3}^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.993\\,6$ to $0.033\\,6.$ So, it reduces by a factor of\n\n$$\n\\frac{0.993\\,6}{0.033\\,6}=29.571\\,42…≈29.571.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}{3}^{p+1} & ≈29.571\\,42… \\\\ p+1 & ≈{log}_{3}⁡(29.571\\,42…) \\\\ p+1 & ≈3.083… \\\\ p & ≈2.083….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is\n$2.$\n\nIndeed, this coincides with the definition of the order from the expression for the LTE:\n\n$$\nτ(Δx)=4(Δx)^{3}+(Δx)^{4}\\,⇒\\,τ(Δx)=O\\,((Δx)^{3})=O\\,((Δx)^{2+1}),\\,Δx\\to 0.\n$$\n\nHence, the order of the method is $2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7912775d-199c-5477-a706-c53543d42878" "answer-field-be528cf4-d8cc-5ef0-bc8a-8be45340780c" "answer-field-0bfc70f9-ba83-5182-b647-bd43911d16c4" "answer-field-3bac49a8-a694-5683-a082-922ff0afbdd3"] :db/ensure [:question/validate]} {:db/id "answer-field-7912775d-199c-5477-a706-c53543d42878" :answer-field/id #uuid "7912775d-199c-5477-a706-c53543d42878" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-a83e1720-cd01-5745-a4e3-29723928dc38" :answer-field/choices ["answer-387f547e-35bc-53a4-9409-9ca8ed35c9b3" "answer-16811bb1-a290-5110-9278-74a13897fa65" "answer-8025e60e-bd13-5838-aff5-73f558fd48aa" "answer-4384b939-3d1e-52fc-b803-94336b68185b" "answer-a83e1720-cd01-5745-a4e3-29723928dc38"] :db/ensure [:answer-field/validate]} {:db/id "answer-387f547e-35bc-53a4-9409-9ca8ed35c9b3" :answer/id #uuid "387f547e-35bc-53a4-9409-9ca8ed35c9b3" :answer/type :answer.type/math :answer/value "0.034" :db/ensure [:answer/validate]} {:db/id "answer-16811bb1-a290-5110-9278-74a13897fa65" :answer/id #uuid "16811bb1-a290-5110-9278-74a13897fa65" :answer/type :answer.type/math :answer/value "0.075" :db/ensure [:answer/validate]} {:db/id "answer-8025e60e-bd13-5838-aff5-73f558fd48aa" :answer/id #uuid "8025e60e-bd13-5838-aff5-73f558fd48aa" :answer/type :answer.type/math :answer/value "0.375" :db/ensure [:answer/validate]} {:db/id "answer-4384b939-3d1e-52fc-b803-94336b68185b" :answer/id #uuid "4384b939-3d1e-52fc-b803-94336b68185b" :answer/type :answer.type/math :answer/value "0.550" :db/ensure [:answer/validate]} {:db/id "answer-a83e1720-cd01-5745-a4e3-29723928dc38" :answer/id #uuid "a83e1720-cd01-5745-a4e3-29723928dc38" :answer/type :answer.type/math :answer/value "0.994" :db/ensure [:answer/validate]} {:db/id "answer-field-be528cf4-d8cc-5