#{[{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186534139} :activity/id #uuid "09a164ce-ad3d-58c3-9305-a48a254fe99f" :activity/scope {:db/id #edb/ref 17592186048840 :topic/id #uuid "c53ff2b5-bc81-56fe-a0dc-0336484fb64d" :topic/math-academy-id 555} :activity/steps [{:db/id #edb/ref 17592186534126 :step/content {:db/id #edb/ref 17592186534092 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c3f15eb-c686-501d-80b8-1f41855dcc40" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ kilograms" :db/id #edb/ref 17592186533165} {:answer/id #uuid "1c515615-ec9e-5ba1-8ca1-601c55e23e35" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$6$ kilograms" :db/id #edb/ref 17592186533207} {:answer/id #uuid "2e9d41c5-7037-5cd7-aa0c-6d98056a697a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ kilograms" :db/id #edb/ref 17592186533252} {:answer/id #uuid "c9360364-ef93-5795-aaa0-0811fa98160b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ kilograms" :db/id #edb/ref 17592186533620} {:answer/id #uuid "f8c87a01-7ace-5e64-a20d-4355299a734e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$15$ kilograms" :db/id #edb/ref 17592186533749}] :answer-field/correct {:db/id #edb/ref 17592186533207} :answer-field/id #uuid "69d68b6c-b19c-5342-87f0-f1a951317aa9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533865}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f65ffc41-5bca-5c7e-a470-b626911bf2cd" :question/math-academy-id "q-93113" :question/problem "Samantha and Harry each bought a watermelon. The ratio of the weight of Samantha's watermelon to the weight of Harry's watermelon is $5:3.$ Samantha's watermelon weighs $12$ kilograms. By rounding this weight to the nearest ten, approximate the weight of Harry's watermelon." :question/worked-solution "First, let's approximate the weight of Samantha's watermelon to the nearest ten:\n\n$$\n12⟶10\n$$\n\nThe ratio of the weight of Samantha's watermelon to the weight of Harry's watermelon is \n\n$$\n\\frac{5}{3}.\n$$\n\n  \n\nThe numerator represents the weight of Samantha's  watermelon and the denominator represents  the weight of Harry's watermelon.\n\nWe can make a numerator of $10$ by multiplying the numerator and denominator by \n $2:$\n\n$$\n\\frac{5\\times 2}{3\\times 2}=\\frac{10}{6}\n$$\n\nTherefore, Harry's watermelon approximately weighs $6$ kilograms."} :step/id #uuid "5ae6fd03-7d26-5fc4-8d37-964087984c67" :step/next {:db/id #edb/ref 17592186534147}} {:db/id #edb/ref 17592186534139 :step/content {:db/id #edb/ref 17592186534069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02603c07-dd10-5687-84ae-5f4c0be4ab2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186533136} {:answer/id #uuid "28a8ea65-0785-5201-bbdf-14a3661d4e5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186533241} {:answer/id #uuid "3c64e603-d081-5cb3-9278-c26a4ab3e27e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186533280} {:answer/id #uuid "6ca4d6ec-255a-5d79-af66-de6061ebddfb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186533392} {:answer/id #uuid "7525cca7-6301-5a3f-84e3-2eb780c2eb28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186533417}] :answer-field/correct {:db/id #edb/ref 17592186533417} :answer-field/id #uuid "69081031-c0ac-5dc2-9f83-909e212c6666" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533863}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cceba1db-cf64-5613-ace7-49dabd9ac195" :question/math-academy-id "q-93076" :question/problem "Only apple and cherry trees grow in a garden. The following table shows the number of these trees.\n\n| Apple trees | Cherry trees |\n| --- | --- |\n| $271$ | $425$ |\n\n$$\n\n$$\n\nRounding to the nearest hundred, determine the approximate ratio of the number of apple trees to the total number of trees." :question/worked-solution "First, let's approximate the number of apple and cherry trees by rounding to the nearest hundred.\n\n- Apple trees: $271⟶300$\n\n- Cherry trees: $425⟶400$\n\nThus, the total number of trees is approximately $300+400=700.$\n\nTherefore, the ratio of the number of apple trees to the total number of trees (expressed as a fraction) is approximately\n\n$$\n\\frac{300}{700}.\n$$\n\nDividing the numerator and denominator by $100$ gives\n\n$$\n\\frac{300÷100}{700÷100}=\\frac{3}{7}.\n$$\n\nTherefore, the ratio of the number of apple trees to the total number of trees is approximately $\\frac{3}{7}.$"} :step/id #uuid "a099c9b4-d1ce-5863-8969-e24fe375544d" :step/next {:db/id #edb/ref 17592186534157}} {:db/id #edb/ref 17592186534145 :step/content {:db/id #edb/ref 17592186534035 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c08cff7-c809-5121-b744-11d3019f8279" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186533163} {:answer/id #uuid "c06d78f0-10b4-518d-8220-6a66d562d55c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186533604} {:answer/id #uuid "ce7add3f-d5d9-5c37-a278-9620c6062894" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186533640} {:answer/id #uuid "d2c04c8e-bd71-5713-91f5-1e65209c705d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186533654} {:answer/id #uuid "f23155c7-a1e2-5198-af78-7d8df533c0b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186533734}] :answer-field/correct {:db/id #edb/ref 17592186533654} :answer-field/id #uuid "94410187-a34e-500a-81d7-ff4c37da8f94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533893}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "987f037f-66db-5b9e-acaa-f2176b3629c8" :question/math-academy-id "q-349588" :question/problem "Only orange and peach trees grow in a garden. The following table shows the number of these trees.\n\n| Orange trees | Peach trees |\n| --- | --- |\n| $352$ | $618$ |\n\nRounding to the nearest hundred, determine the approximate ratio of the number of orange trees to the total number of trees." :question/worked-solution "First, let's approximate the number of orange and peach trees by rounding to the nearest $100$:\n\n- Orange trees: $352⟶400$\n\n- Peach trees: $618⟶600$\n\nThus, the total number of trees is approximately $400+600=1\\,000.$\n\nTherefore, the ratio of the number of orange trees to the total number of trees is approximately:\n\n$$\n\\frac{400}{1\\,000}\n$$\n\nWe can simplify this ratio by dividing both numbers by $100$:\n\n$$\n\\frac{400÷100}{1\\,000÷100}=\\frac{4}{10}\n$$\n\nThen, we divide by $2$:\n\n$$\n\\frac{4÷2}{10÷2}=\\frac{2}{5}\n$$\n\nTherefore, the ratio of the number of orange trees to the total number of trees is approximately $\\frac{2}{5}.$"} :step/id #uuid "b89d46db-aacc-5300-81b4-f42199193213"} {:db/id #edb/ref 17592186534147 :step/content {:db/id #edb/ref 17592186534068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55cdd9f1-49bc-529f-9cf3-7d15b171045a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$180$ grams" :db/id #edb/ref 17592186533340} {:answer/id #uuid "72bffca4-ed36-5955-afe3-b6ce9cb972ed" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$125$ grams" :db/id #edb/ref 17592186533413} {:answer/id #uuid "890baf66-3b7c-5d6b-a240-4e42025caf2d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$200$ grams" :db/id #edb/ref 17592186533467} {:answer/id #uuid "93031dca-4a2f-590b-b511-f9479c81542f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$160$ grams" :db/id #edb/ref 17592186533493} {:answer/id #uuid "f1b144a7-2a2a-5401-8855-dfc1a8d02933" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$130$ grams" :db/id #edb/ref 17592186533733}] :answer-field/correct {:db/id #edb/ref 17592186533467} :answer-field/id #uuid "7a8f5b83-2a82-5f6e-95fd-274ba7bd818d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533874}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cc81aa2c-a8cb-5dba-82e1-77d0c6319f70" :question/math-academy-id "q-93267" :question/problem "The following table shows the amount, in grams, of flax oil obtained from the corresponding amount of flaxseed:\n\n| Oil | Seed |\n| --- | --- |\n| $315$ | $945$ |\n\n$$\n\n$$\n\nThe ratio of the amount of flax oil to the amount of flaxseed is always the same. By rounding the given data to the nearest hundred, approximate the amount of flax oil that can be obtained from $600$ grams of seed." :question/worked-solution "First, let's round the amounts of flax oil and seed:\n\n- Oil: $315⟶300$\n\n- Seed: $945⟶900$\n\nTherefore, the ratio of the amount of flax oil to the amount of flaxseed (expressed as a fraction) is approximately\n\n$$\n\\frac{300}{900}.\n$$\n\nSo the numerator represents the amount of flax oil and the denominator represents the amount of flaxseed.\n\nWe can simplify this ratio by dividing both numbers by $100$:\n\n$$\n\\frac{300÷100}{900÷100}=\\frac{3}{9}\n$$\n\nThen, we divide by $3$:\n\n$$\n\\frac{3÷3}{9÷3}=\\frac{1}{3}\n$$\n\nWe can make a denominator of $600$ by multiplying the numerator and denominator by $200$:\n\n$$\n\\frac{1\\times 200}{3\\times 200}=\\frac{200}{600}\n$$\n\nTherefore, approximately $200$ grams of flax oil can be obtained from $600$ grams of flaxseed."} :step/id #uuid "bf26c5b2-fa41-5f58-9926-3debfa64da79" :step/next {:db/id #edb/ref 17592186534145}} {:db/id #edb/ref 17592186534157 :step/content {:db/id #edb/ref 17592186534078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25cb37b5-2d4e-5670-bd41-bb1e65a2f188" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186533235} {:answer/id #uuid "28656814-767a-5b15-91aa-42642f0f926b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "45" :db/id #edb/ref 17592186533239} {:answer/id #uuid "3b73f981-baed-51be-bc72-ae388cf830f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50" :db/id #edb/ref 17592186533278} {:answer/id #uuid "5dffe28d-f55c-57d9-a24f-952a67152c73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "55" :db/id #edb/ref 17592186533354} {:answer/id #uuid "a3cdbf4a-9fd3-52b6-ba6f-df93bb7df832" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60" :db/id #edb/ref 17592186533535}] :answer-field/correct {:db/id #edb/ref 17592186533278} :answer-field/id #uuid "9d04ac50-0af2-5115-b945-5c001afd6b25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533899}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "de53ade3-2006-5489-a226-17f2c3957439" :question/math-academy-id "q-93112" :question/problem "There are $98$ blue marbles and some red marbles in a box. The ratio of the number of blue marbles to the number of red ones is $2:1.$ By rounding the number of blue marbles to the nearest ten, approximate the number of red marbles in the box." :question/worked-solution "First, let's approximate the number of blue marbles:\n\n$$\n98⟶100\n$$\n\nThe ratio of the number of blue marbles to the number of red marbles is\n\n$$\n\\frac{2}{1}.\n$$\n\n  \n\nThe numerator represents the number of blue marbles and the denominator represents the number of red marbles.\n\nWe can make a numerator of $100$ by multiplying the numerator and denominator by \n $50:$\n\n$$\n\\frac{2\\times 50}{1\\times 50}=\\frac{100}{50}\n$$\n\nTherefore, there are approximately $50$ red marbles in the box."} :step/id #uuid "efa27ae5-ad45-5b59-a5b8-4d12f16c5865" :step/next {:db/id #edb/ref 17592186534126}}] :activity/title "Approximating Ratios" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186533118}]}
