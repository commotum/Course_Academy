      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14200695/observations/step-q20538-6fc1b1d7688702fdb679.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14200695/observations/step-q20538-6fc1b1d7688702fdb679.png",
