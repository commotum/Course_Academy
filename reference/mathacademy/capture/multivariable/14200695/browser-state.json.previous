      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14200695/observations/step-q115622-078f9418d67e4a9dca36.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14200695/observations/step-q115622-078f9418d67e4a9dca36.png",
