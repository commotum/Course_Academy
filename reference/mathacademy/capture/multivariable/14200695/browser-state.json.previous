      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14200695/observations/step-q115938-8ac576a0005470bba94f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14200695/observations/step-q115938-8ac576a0005470bba94f.png",
