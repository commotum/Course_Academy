      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14200695/observations/step-q115653-bd458b49bf2c2b5cc2c2.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14200695/observations/step-q115653-bd458b49bf2c2b5cc2c2.png",
      "source_url": "https://mathacademy.com/tasks/14200695/topics/1206/lesson",
      "captured_at": 1791979840.4862413,
      "math_academy_id": "q-115653",
