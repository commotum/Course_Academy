4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle><mjx-mspace style=\"width: 1em;\"></mjx-mspace></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle></math></mjx-assistive-mml></mjx-container> Therefore, the equilibrium at <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"316\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-msup><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D431 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mo class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c2217\"></mjx-c></mjx-mo></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow><mo>∗</mo></msup></math></mjx-assistive-mml></mjx-container> is \n<div id=\"selectList-335011-5\" class=\"selectList\" style=\"margin: 0px 4px 2px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-335011-5\" style=\"width: 177px; height: 17px; line-height: 17px;\">an unstable</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 624px; top: 18294px;\"><div class=\"selectListOption\" style=\"height: 17px;\">a stable</div><div class=\"selectListOption\" style=\"height: 17px;\">an asymptotically stable</div><div class=\"selectListOption selected\" style=\"height: 17px;\">an unstable</div></div></div><div id=\"selectList-335011-6\" class=\"selectList\" style=\"margin: 0px 2px 2px 4px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-335011-6\" style=\"width: 103px; height: 17px; line-height: 17px;\">saddle</div><div