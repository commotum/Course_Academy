e-589f-5db6-9827-5f3474adb012" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "saddle" :db/id #edb/ref 17592186445047} :answer-field/id #uuid "b58ed4e5-6c54-5acb-ad76-d1a197c4b886" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186445096} {:answer-field/choices [{:answer/id #uuid "40eb60bb-1ea1-5c11-a8bd-a94bf13187c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186445008} {:answer/id #uuid "55d6ac42-310a-5f26-923f-7aab979029aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186445019} {:answer/id #uuid "5bf95749-d6f3-5818-bd84-d7528a7eaeaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186445021} {:answer/id #uuid "b660c1d1-1a48-5e9a-984a-4a34dfde4a01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186445053} {:answer/id #uuid "dc357f7a-09d5-5edd-981f-d05424deb102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186445066}] :answer-field/correct {:answer/id #uuid "dc357f7a-09d5-5edd-981f-d05424deb102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186445066} :answer-field/id #uuid "ed7c7de6-3bf0-51f6-9d58-4a88df7f061e" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186445102}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8df5273a-07e4-5ba8-bfd6-b4b9ed059597" :question/math-academy-id "q-335011" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}=-4x+6xy \\\\ {y}^{′}=7y-3xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model above, where $x=x(t)$ represents the predators and $y=y(t)$ represents the prey. Select the correct options in the reasoning below.\n\n$\\,$ Evaluating the Jacobian of the system at the equilibrium ${x}^{∗}=[0,\\,0]^{T},$ we get\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$J({x}^{∗})=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"40px\">{{field-1}}</td>\n<td align=\"center\" width=\"40px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,.$</td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>\n\n$\\,$ The eigenvalues of the Jacobian matrix are \n{{field-5}}.\n\n$\\,$ Therefore, the equilibrium at ${x}^{∗}$ is \n{{field-6}}{{field-7}}." :question/worked-solution "Let's denote ${f}_{1}(x,y)=-4x+6xy$ and ${f}_{2}(x,y)=7y-3xy.$\n\nNow, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(-4x+6xy)=-4+6y,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(-4x+6xy)=6x \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(7y-3xy)=-3y,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(7y-3xy)=7-3x\\end{aligned}\n$$\n\nThus, the Jacobian matrix is\n\n$$\nJ=[\\begin{aligned}-4+6y & 6x \\\\ -3y & 7-3x\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to get\n\n$$\nJ({x}^{∗})=[\\begin{aligned}-4+6(0) & 6(0) \\\\ -3(0) & 7-3(0)\\end{aligned}]=[\\begin{aligned}-4 & 0 \\\\ 0 & 7\\end{aligned}].\n$$\n\nThe eigenvalues of the Jacobian matrix are ${\\lambda }_{1}=-4\\text{ and }{\\lambda }_{2}=7.$ Since eigenvalues are real with opposite signs, our equilibrium is $\\text{an unstable}$ $\\text{saddle}.$"}] [{:db/id #edb/ref 17592186445104 :knowledge-point/_questions [{:db/id #edb/ref 17592186166924 :knowledge-point/id #uuid "f1fa1647-1acb-50bd-95e7-26ed0c495bd4" :knowledge-point/title "Classifying Equilibria of the Lotka-Volterra Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48a649f6-8789-592c-a484-60e589544fa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.1" :db/id #edb/ref 17592186445011} {:answer/id #uuid "773b4fd0-9188-5677-bde3-76265d19e57b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.4" :db/id #edb/ref 17592186445034} {:answer/id #uuid "82f6c688-e866-5552-a88a-90013d358f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186445038} {:answer/id #uuid "d427527c-5946-5b37-b66d-728cd4def3dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186445062} {:answer/id #uuid "ef9ae683-08da-5f39-98a8-73511b960419" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.3" :db/id #edb/ref 17592186445071}] :answer-field/correct {:answer/id #uuid "773b4fd0-9188-5677-bde3-76265d19e57b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.4" :db/id #edb/ref 17592186445034} :answer-field/id #uuid "10eecd73-7ddb-53e1-8cee-ba9cc82a6721" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186445077} {:answer-field/choices [{:answer/id #uuid "65fa763e-3689-51e3-be9e-db8526498203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186445027} {:answer/id #uuid "99c3e81e-8431-5930-a4d2-6d362c1544d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.1" :db/id #edb/ref 17592186445045} {:answer/id #uuid "cfad