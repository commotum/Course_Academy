#{[{:db/id #edb/ref 17592186373799 :knowledge-point/_questions [{:db/id #edb/ref 17592186188291 :knowledge-point/id #uuid "ba211dba-23ad-5755-b1e3-082e13be59a2" :knowledge-point/title "Expressing Three-Dimensional Related Rates Using Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49a327b9-75a5-53f6-8b43-cf618bcf3524" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=K{s}^{3}" :db/id #edb/ref 17592186373801} {:answer/id #uuid "1df99bf7-929a-5903-abcf-591bb526f29e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=\\frac{K}{s}" :db/id #edb/ref 17592186373802} {:answer/id #uuid "5bbf909f-462f-5518-8013-a606f7cf41aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=\\frac{K}{{s}^{3}}" :db/id #edb/ref 17592186373803} {:answer/id #uuid "3d49d7ac-08ee-59ab-9b44-461517ebb9fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=\\frac{K}{{s}^{2}}" :db/id #edb/ref 17592186373804} {:answer/id #uuid "708d1932-73c6-5f7d-ae3b-5e1d6d9045b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=K{s}^{2}" :db/id #edb/ref 17592186373805}] :answer-field/correct {:answer/id #uuid "5bbf909f-462f-5518-8013-a606f7cf41aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=\\frac{K}{{s}^{3}}" :db/id #edb/ref 17592186373803} :answer-field/id #uuid "20ed6ed5-0a52-5e29-8c5e-f028a3e0baf7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373800}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "deb34ff2-c563-5932-95e2-cff733776593" :question/math-academy-id "q-143125" :question/problem "The volume of a cube increases at a rate that's inversely proportional to the length of its edge. Write down a differential equation describing the rate of change of the edge length, $s(t),$ in this process. Assume that $K>0.$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*The **volume** of a cube **increases** at a rate that's **inversely proportional** to the **length of its edge**.* \n\nWe note the following:\n\n- The question describes the *rate* at which the *volume $V$ of a cube* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}V}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}V}{\\text{d}t}$ *increases* at a rate that's *inversely proportional to the length of its edge.* Therefore,\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=\\frac{k}{s},\n$$\n\nwhere $k>0.$\n\nWe wish to use this information to find an expression for $\\frac{\\text{d}s}{\\text{d}t}.$\n\nThe volume $V$ of a cube is given by\n\n$$\nV={s}^{3}.\n$$\n\nDifferentiating this equation with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({s}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =3{s}^{2}\\frac{\\text{d}s}{\\text{d}t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =\\frac{k}{s} \\\\ 3{s}^{2}\\frac{\\text{d}s}{\\text{d}t} & =\\frac{k}{s} \\\\ \\frac{\\text{d}s}{\\text{d}t} & =\\frac{k}{3{s}^{3}}.\\end{aligned}\n$$\n\nWe now introduce a new constant:\n\n$$\nK=\\frac{k}{3}>0\n$$\n\n \n\nTherefore, our equation becomes\n\n$$\n\\frac{\\text{d}s}{\\text{d}t}=\\frac{K}{{s}^{3}}.\n$$"}] [{:db/id #edb/ref 17592186373834 :knowledge-point/_questions [{:db/id #edb/ref 17592186188257 :knowledge-point/id #uuid "7d868c89-ca9e-589d-917e-cfec472a44f6" :knowledge-point/title "Expressing Two-Dimensional Related Rates Using Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee8b8c0d-1ee4-5b74-98ae-a39f339006ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=-\\frac{K}{s}" :db/id #edb/ref 17592186373836} {:answer/id #uuid "f9fce73c-e33e-526e-ae9d-d604ddfe425e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=-Ks" :db/id #edb/ref 17592186373837} {:answer/id #uuid "de1fd09f-93d4-5865-b24c-0e86883ac345" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=\\frac{K}{{s}^{2}}" :db/id #edb/ref 17592186373838} {:answer/id #uuid "ec5e3a4a-13c7-547b-b482-926b18785c2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=-\\frac{K}{{s}^{2}}" :db/id #edb/ref 17592186373839} {:answer/id #uuid "344b3dd6-8a8c-5b38-83e6-babf864485c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=K{s}^{2}" :db/id #edb/ref 17592186373840}] :answer-field/correct {:answer/id #uuid "ec5e3a4a-13c7-547b-b482-926b18785c2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=-\\frac{K}{{s}^{2}}" :db/id #edb/ref 17592186373839} :answer-field/id #uuid "722e2706-48b9-573e-a5f7-472963351881" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373835}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0936be88-f149-5a42-9d58-500c046543ef" :question/math-academy-id "q-143135" :question/problem "The area of a square decreases at a rate inversely proportional to its side length. Write down a differential equation describing the rate of change of the side length, $s(t),$ in this process. Assume that $K>0.$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*The **area** of a square **decreases** at a rate **inversely proportional** to **its side length**.*\n\nWe note the following:\n\n- The question describes the *rate* at which the *area $A$ of a square* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}A}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}A}{\\text{d}t}$ *decreases* at a rate *inversely proportional its side length*. In other words,\n\n$$\n\\frac{\\text{d}A}{\\text{d}t}=-\\frac{k}{s}\n$$\n\nwhere $k>0.$\n\nWe wish to use this information to find an expression for $\\frac{\\text{d}s}{\\text{d}t}.$\n\nThe area of a square is given by \n\n$$\nA={s}^{2}.\n$$\n\nDifferentiating this equation with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({s}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =2s\\frac{\\text{d}s}{\\text{d}t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}A}{\\text{d}t} & =-\\frac{k}{s} \\\\ 2s\\frac{\\text{d}s}{\\text{d}t} & =-\\frac{k}{s} \\\\ \\frac{\\text{d}s}{\\text{d}t} & =-\\frac{k}{2{s}^{2}}.\\end{aligned}\n$$\n\nWe now introduce a new constant:\n\n$$\nK=\\frac{k}{2}>0\n$$\n\nTherefore, our equation becomes\n\n$$\n\\frac{\\text{d}s}{\\text{d}t}=-\\frac{K}{{s}^{2}}.\n$$"}] [{:db/id #edb/ref 17592186188915 :knowledge-point/_questions [{:db/id #edb/ref 17592186188292 :knowledge-point/id #uuid "474f9c82-4ae7-58e0-9457-6bda9cab8973" :knowledge-point/title "Translating Coordinate Plane Problems Into Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae469686-7a33-546f-846f-e4f40b095534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y^{′}(x) = k(x^{2} + y^{2})" :db/id #edb/ref 17592186187567} {:answer/id #uuid "c3e07204-efc5-5a07-832c-c85e05ab4faa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y^{′}(x) = kx^{2}y^{2}" :db/id #edb/ref 17592186187568} {:answer/id #uuid "ee072db2-e159-583a-a818-6b4b7789030d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y^{′}(x) = kxy" :db/id #edb/ref 17592186187569} {:answer/id #uuid "f4341f7f-9429-5cf2-9007-68da9b6a95fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y^{′}(x) = k\\sqrt{x^{2} + y^{2}}" :db/id #edb/ref 17592186187570} {:answer/id #uuid "2e1d5a0c-215b-586d-a781-3dd75baf2200" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y^{′}(x) = kx^{2}" :db/id #edb/ref 17592186187571}] :answer-field/id #uuid "6ce498ff-bed5-5a31-b8d4-a763ddd397a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186187566}] :question/id #uuid "5deb4667-ba88-546b-92cb-11999248cbcf" :question/math-academy-id "q-38329" :question/problem "At each point $P$ on a particular curve, the derivative $y^{′}(x)$ is proportional to the distance from $P$ to the origin. What differential equation describes this curve?"}]}
