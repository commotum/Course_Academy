303 469 -324T453 -348Q449 -350 436 -350L424 -349L315 -96Q206 156 205 156L171 130Q138 104 137 104L111 130L263 249Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1249\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E2-MJMAIN-64\" x=\"346\" y=\"676\"></use>\n<g transform=\"translate(60,-716)\">\n <use xlink:href=\"#E2-MJMAIN-64\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMATHI-78\" x=\"556\" y=\"0\"></use>\n</g>\n</g>\n <use xlink:href=\"#E2-MJMAIN-28\" x=\"1489\" y=\"0\"></use>\n<g transform=\"translate(1878,0)\">\n <use xlink:href=\"#E2-MJMAIN-61\"></use>\n <use xlink:href=\"#E2-MJMAIN-72\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-73\" x=\"893\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-69\" x=\"1287\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-6E\" x=\"1566\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-68\" x=\"2122\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E2-MJMATHI-78\" x=\"4724\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-29\" x=\"5296\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-3D\" x=\"5963\" y=\"0\"></use>\n<g transform=\"translate(7020,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"3870\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E2-MJMAIN-31\" x=\"1684\" y=\"676\"></use>\n<g transform=\"translate(60,-1026)\">\n <use xlink:href=\"#E2-MJSZ1-221A\" x=\"0\" y=\"94\"></use>\n<rect stroke=\"none\" width=\"2749\" height=\"60\" x=\"1000\" y=\"885\"></rect>\n<g transform=\"translate(1000,0)\">\n <use xlink:href=\"#E2-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-32\" x=\"809\" y=\"408\"></use>\n <use xlink:href=\"#E2-MJMAIN-2B\" x=\"1248\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-31\" x=\"2249\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E2-MJMAIN-2E\" x=\"11130\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>Recall that</p>\n<p><span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"29.021ex\" height=\"3.676ex\" style=\"vertical-align: -1.005ex;\" viewBox=\"0 -1150.1 12495.2 1582.7\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-3-Title\">\n<title id=\"MathJax-SVG-3-Title\">\n\\arsinh{x} = \\ln\\big(x+\\sqrt{x^2+1}\\big).\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E3-MJMAIN-61\" d=\"M137 305T115 305T78 320T63 359Q63 394 97 421T218 448Q291 448 336 416T396 340Q401 326 401 309T402 194V124Q402 76 407 58T428 40Q443 40 448 56T453 109V145H493V106Q492 66 490 59Q481 29 455 12T400 -6T353 12T329 54V58L327 55Q325 52 322 49T314 40T302 29T287 17T269 6T247 -2T221 -8T190 -11Q130 -11 82 20T34 107Q34 128 41 147T68 188T116 225T194 253T304 268H318V290Q318 324 312 340Q290 411 215 411Q197 411 181 410T156 406T148 403Q170 388 170 359Q170 334 154 320ZM126 106Q126 75 150 51T209 26Q247 26 276 49T315 109Q317 116 318 175Q318 233 317 233Q309 233 296 232T251 223T193 203T147 166T126 106Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-72\" d=\"M36 46H50Q89 46 97 60V68Q97 77 97 91T98 122T98 161T98 203Q98 234 98 269T98 328L97 351Q94 370 83 376T38 385H20V408Q20 431 22 431L32 432Q42 433 60 434T96 436Q112 437 131 438T160 441T171 442H174V373Q213 441 271 441H277Q322 441 343 419T364 373Q364 352 351 337T313 322Q288 322 276 338T263 372Q263 381 265 388T270 400T273 405Q271 407 250 401Q234 393 226 386Q179 341 179 207V154Q179 141 179 127T179 101T180 81T180 66V61Q181 59 183 57T188 54T193 51T200 49T207 48T216 47T225 47T235 46T245 46H276V0H267Q249 3 140 3Q37 3 28 0H20V46H36Z\"></path>\n<path stroke-width=\"1\" id=\"E3-MJMAIN-73\" d=\"M295 316Q295 356 268 385T190 414Q154 414 128 401Q98