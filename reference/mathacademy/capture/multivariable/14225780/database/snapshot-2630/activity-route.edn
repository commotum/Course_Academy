#{[{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186545969} :activity/id #uuid "5723046f-5fc9-5dd0-a50b-d2aa33764417" :activity/scope {:db/id #edb/ref 17592186048610 :topic/id #uuid "aea1ea1e-f383-548f-9c13-1a066dc606ed" :topic/math-academy-id 3256} :activity/steps [{:db/id #edb/ref 17592186545933 :step/content {:db/id #edb/ref 17592186545805 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30d1f9db-cf48-58a7-ad49-262d6e04facf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{5}\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186545298} {:answer/id #uuid "94dda36e-54d9-5f43-91be-1b8429ae0978" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{5}\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186545467} {:answer/id #uuid "af09f08b-a747-55cf-8a7e-67faa0a4df2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{5}\\operatorname{arcsch}⁡x+C" :db/id #edb/ref 17592186545519} {:answer/id #uuid "f70fa6c6-134e-5a03-9d62-a176b44b1e34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{artanh}⁡x+C" :db/id #edb/ref 17592186545653} {:answer/id #uuid "fa29f112-8a4b-564d-bbbf-55a8fb381552" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{artanh}⁡x+C" :db/id #edb/ref 17592186545660}] :answer-field/correct {:db/id #edb/ref 17592186545467} :answer-field/id #uuid "f50fd1fe-e6ab-5bd0-bc25-fd9fa6af50e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545788}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "225dd078-68de-5937-93c7-1f0e29e25a34" :question/math-academy-id "q-162698" :question/problem "$$\n\nCalculate $\\int -\\frac{5}{\\sqrt{5}(1-{x}^{2})}\\,\\text{d}x$ for $|x|>1.$" :question/worked-solution "$$\nThe formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int -\\frac{5}{\\sqrt{5}(1-{x}^{2})}\\,\\text{d}x=-\\frac{5}{\\sqrt{5}}\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x=-\\sqrt{5}\\operatorname{arcoth}⁡x+C.\\end{aligned}\n$$"} :step/id #uuid "63e974e4-6e99-5b3e-88d2-4bab61c51c91"} {:db/id #edb/ref 17592186545969 :step/content {:db/id #edb/ref 17592186167350 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "356280f1-a662-5ade-92a2-1f3d0ab94b36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{arcsch}⁡x+C" :db/id #edb/ref 17592186545307} {:answer/id #uuid "627738ce-ed4c-5741-ba8a-69febe68ce1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{2}\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186545385} {:answer/id #uuid "afb20b57-0fa3-5940-b9b0-92d1a6133e1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{2}\\operatorname{arcsch}⁡x+C" :db/id #edb/ref 17592186545520} {:answer/id #uuid "b5d3a9d3-ddd9-577f-9c86-cd738f45c520" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{2}\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186545531} {:answer/id #uuid "d2e23e70-4232-5a2c-a0a4-f7fc04086c68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186545583}] :answer-field/correct {:db/id #edb/ref 17592186545520} :answer-field/id #uuid "9ba60ec2-4a56-5a57-aeac-9e1b249b1391" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186165309}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "391d90c1-4dfa-5f95-b579-f610d1d49415" :question/math-academy-id "q-95355" :question/problem "$$\n\n$\\int \\frac{5}{2|x|\\sqrt{{x}^{2}+1}}\\,\\text{d}x=$" :question/worked-solution "$$\n\nThe formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{5}{2|x|\\sqrt{{x}^{2}+1}}\\,\\text{d}x=-\\frac{5}{2}\\int -\\frac{1}{|x|\\sqrt{1+{x}^{2}}}\\,\\text{d}x=-\\frac{5}{2}\\operatorname{arcsch}⁡x+C.\\end{aligned}\n$$"} :step/id #uuid "b03dadf7-7d5d-5e6c-9637-eab0fc22408a" :step/next {:db/id #edb/ref 17592186546008}} {:db/id #edb/ref 17592186545998 :step/content {:db/id #edb/ref 17592186545875 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e48fa1f-d8dd-53b3-9f18-8e67d042f50b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186545225} {:answer/id #uuid "945fffd1-e229-5466-ad6d-89a0625a4263" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186545466} {:answer/id #uuid "d86d1b04-c15b-51a1-be07-0f1a45f08e45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}^{2}+\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186545596} {:answer/id #uuid "e5812492-742c-5d48-bb3f-3dfba19457aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186545624} {:answer/id #uuid "f7c49693-2849-57c9-907f-41a95bff16a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-\\operatorname{artanh}⁡x+C" :db/id #edb/ref 17592186545654}] :answer-field/correct {:db/id #edb/ref 17592186545466} :answer-field/id #uuid "b96b62fd-4b23-57ed-92a3-5d0b1b40fd84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545760}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f9b5554f-bf8f-5e35-84b6-08592dbf3242" :question/math-academy-id "q-95835" :question/problem "$$\n\nCalculate $\\int \\frac{2{x}^{3}-2x-1}{{x}^{2}-1}\\,\\text{d}x$ for $|x|>1.$" :question/worked-solution "$$\nThe formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{2{x}^{3}-2x-1}{{x}^{2}-1}\\,\\text{d}x & =\\int (\\frac{2{x}^{3}-2x}{{x}^{2}-1}-\\frac{1}{{x}^{2}-1})\\text{d}x \\\\  & =\\int \\frac{2{x}^{3}-2x}{{x}^{2}-1}\\,\\text{d}x-\\int \\frac{1}{{x}^{2}-1}\\,\\text{d}x \\\\  & =\\int \\frac{2x({x}^{2}-1)}{{x}^{2}-1}\\,\\text{d}x-\\int \\frac{1}{{x}^{2}-1}\\,\\text{d}x \\\\  & =\\int 2x\\,\\text{d}x+\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x \\\\  & ={x}^{2}+\\operatorname{arcoth}⁡x+C.\\end{aligned}\n$$"} :step/id #uuid "dd6561c3-b1cc-549a-84b3-b91d69aa4dfb" :step/next {:db/id #edb/ref 17592186546016}} {:db/id #edb/ref 17592186546008 :step/content {:db/id #edb/ref 17592186545840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fd1ab49-aa4c-5774-9026-e6c1cff76e48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsin}⁡x-\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186545261} {:answer/id #uuid "78571539-c66a-5e8c-a578-1abbd8f92686" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsin}⁡x-\\operatorname{arcsch}⁡x+C" :db/id #edb/ref 17592186545426} {:answer/id #uuid "b263c8ee-1799-53f4-ad45-e74016e53ace" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arccos}⁡x+\\operatorname{arcsch}⁡x+C" :db/id #edb/ref 17592186545522} {:answer/id #uuid "b63a8c32-ba1f-50c5-b426-aedd68118f76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arccos}⁡x-\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186545533} {:answer/id #uuid "c785053c-82a9-5d86-a046-ee1e615e2597" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsin}⁡x+\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186545561}] :answer-field/correct {:db/id #edb/ref 17592186545261} :answer-field/id #uuid "bfc97997-ca98-512f-9c81-7c22edd719fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545763}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9e72ef97-134f-5189-9831-10898a377ff9" :question/math-academy-id "q-95825" :question/problem "$\\int \\frac{x+1}{x\\sqrt{1-{x}^{2}}}\\text{d}x=$" :question/worked-solution "$$\n\nThe formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{x+1}{x\\sqrt{1-{x}^{2}}}\\text{d}x & =\\int (1+\\frac{1}{x})\\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x-\\int -\\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =\\operatorname{arcsin}⁡x-\\operatorname{arsech}⁡x+C.\\end{aligned}\n$$"} :step/id #uuid "ed919e55-7eb1-5fbf-96d0-70bfe59588b9" :step/next {:db/id #edb/ref 17592186545998}} {:db/id #edb/ref 17592186546016 :step/content {:db/id #edb/ref 17592186545867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "255ef39c-08f3-5d31-9a16-3e46f0627a86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186545278} {:answer/id #uuid "2740976a-b1b4-511e-b9de-d3280d132dd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}\\operatorname{arcsch}⁡x+C" :db/id #edb/ref 17592186545286} {:answer/id #uuid "64fc9627-8651-50b3-8129-352614e060b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186545391} {:answer/id #uuid "9edda277-9ea0-5686-b09b-8b22517fc32f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186545491} {:answer/id #uuid "d3afc86a-72f4-5a60-904a-4ef6e5aba49e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{\\sqrt{2}}\\operatorname{arcsch}⁡x+C" :db/id #edb/ref 17592186545585}] :answer-field/correct {:db/id #edb/ref 17592186545278} :answer-field/id #uuid "1cb24d5d-ea5b-5830-8dbf-c2d38ff023f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186545685}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e33d9b0e-9690-51ed-af7a-d4f6f37918b5" :question/math-academy-id "q-162688" :question/problem "$\\int -\\frac{1}{\\sqrt{2}x\\sqrt{2-2{x}^{2}}}\\,\\text{d}x=$" :question/worked-solution "$$\n\nThe formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int -\\frac{1}{\\sqrt{2}x\\sqrt{2-2{x}^{2}}}\\,\\text{d}x & =\\int -\\frac{1}{\\sqrt{2}x\\sqrt{2(1-{x}^{2})}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{2}\\cdot \\sqrt{2}}\\int -\\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{arsech}⁡x+C.\\end{aligned}\n$$"} :step/id #uuid "f76c43cd-aa4e-597d-8c18-4856f35b6ca3" :step/next {:db/id #edb/ref 17592186545933}}] :activity/title "Integration Using Inverse Reciprocal Hyperbolic Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186545190}]}
