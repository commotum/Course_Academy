      "raw_html": "<div class=\"question\" id=\"question-161291\"><div class=\"questionHeader\"><span class=\"questionNumber\">52.</span><a class=\"questionKP\" href=\"/topics/1264#12381\">Evaluating Surface Integrals Using Polar Coordinates</a><span class=\"helpButton\" questionid=\"161291\">?</span></div><div class=\"questionGraphicFrame\"><img class=\"questionGraphic\" src=\"/graphics/q-161291\"/></div><div class=\"questionText\"><p>Evaluate the surface integral \n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"1604\" display=\"true\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\" display=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mstyle><mjx-munder><mjx-row><mjx-base><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c222C TEX-S2\"></mjx-c></mjx-mo></mjx-base></mjx-row><mjx-row><mjx-under style=\"padding-top: 0.167em; padding-left: 0.217em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D446 TEX-I\"></mjx-c></mjx-mi></mjx-texatom></mjx-under></mjx-row></mjx-munder><mjx-mn class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D446 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-mstyle></mjx-math><mjx-assistive-mml display=\"block\" unselectable=\"on\"><math display=\"block\" xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><munder><mo data-mjx-texclass=\"OP\">∬</mo><mrow data-mjx-texclass=\"ORD\"><mi>S</mi></mrow></munder><mn>6</mn><mi>y</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>S</mi><mo