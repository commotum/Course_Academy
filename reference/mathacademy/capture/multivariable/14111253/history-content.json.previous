ic\" mathvariant=\"script\">L</mi></mrow><mo fence=\"false\" stretchy=\"false\">{</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow></msup><mi>b</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo fence=\"false\" stretchy=\"false\">}</mo></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">∞</mi></mrow></msubsup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><msub><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi>s</mi><mi>t</mi></mrow></msup><mo>⋅</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow></msup><mi>b</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mi>S</mi><mn>0</mn><mo stretchy=\"false\">)</mo></mrow></msub><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">∞</mi></mrow></msubsup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><msub><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mo stretchy=\"false\">(</mo><mi>s</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mi>t</mi></mrow></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mi>S</mi><mn>1</mn><mo stretchy=\"false\">)</mo></mrow></msub><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mi>b</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><msub><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>B</mi><mo stretchy=\"false\">(</mo><mi>s</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mi>S</mi><mn>2</mn><mo stretchy=\"false\">)</mo></mrow></msub><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><mtext>for</mtext><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><msub><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>s</mi><mo>&gt;</mo><msub><mi>s</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mi>S</mi><mn>3</mn><mo stretchy=\"false\">)</mo></mrow></msub><mo data-mjx-texclass=\"CLOSE\">}</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Sat, Oct 10th @ 10:45 PM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:01</span><span class=\"answerResult\"><span style=\"color: red;\">Incorrect</span></span></div></div>"
    },
    {
      "dom_id": "question-41624",
      "name": null,
      "problem": "$$\n{a}_{1}=[\\begin{aligned}2 \\\\ 0 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}4 \\\\ 1 \\\\ 0\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}4 \\\\ 8 \\\\ -1\\end{aligned}],\\,B={[\\begin{aligned}| \\\\ {v}_{1} \\\\ |\\end{aligned}]\\,,[\\begin{aligned}| \\\\ {v}_{2} \\\\ |\\end{aligned}]\\,,[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]}\n$$\n\nSuppose that $V=\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$ Given that $B$ is an orthogonal basis for $V,$ and that $B$ is derived from $V$ using the Gram-Schmidt process, what is the value of $\\frac{a}{c}?$",
      "worked_solution": "We find an orthogonal basis $B$ of $V$ using the Gram-Schmidt process, as follows:\n\n**Step 1.** We set ${v}_{1}={a}_{1}=[\\begin{aligned}2 \\\\ 0 \\\\ 2\\end{aligned}].$\n\n**Step 2.** We find the vector ${v}_{2}$ orthogonal to $\\text{Span}{{v}_{1}}$ using the usual formula:\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =[\\begin{aligned}4 \\\\ 1 \\\\ 0\\end{aligned}]-\\frac{8}{8}[\\begin{aligned}2 \\\\ 0 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}].\\end{aligned}\n$$\n\n**Step 3.** We find the vector ${v}_{3}$ orthogonal to $\\text{Span}{{v}_{1},{v}_{2}}$ using the usual formula:\n\n$$\n\\begin{aligned}{v}_{3} & ={a}_{3}-{\\text{proj}}_{{v}_{1}}\\,{a}_{3}-{\\text{proj}}_{{v}_{2}}\\,{a}_{3} \\\\  & ={a}_{3}-\\frac{{a}_{3}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}-\\frac{{a}_{3}\\cdot {v}_{2}}{{v}_{2}\\cdot {v}_{2}}{v}_{2} \\\\  & =[\\begin{aligned}4 \\\\ 8 \\\\ -1\\end{aligned}]-\\frac{6}{8}[\\begin{aligned}2 \\\\ 0 \\\\ 2\\end{aligned}]-\\frac{18}{9}[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 8 \\\\ -1\\end{aligned}]-\\frac{3}{4}[\\begin{aligned}2 \\\\ 0 \\\\ 2\\end{aligned}]-2[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}] \\\\  & =\\frac{1}{4}(4[\\begin{aligned}4 \\\\ 8 \\\\ -1\\end{aligned}]-3[\\begin{aligned}2 \\\\ 0 \\\\ 2\\end{aligned}]-8[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}]) \\\\  & =[\\begin{aligned}-\\frac{3}{2} \\\\ 6 \\\\ \\frac{3}{2}\\end{aligned}].\\end{aligned}\n$$\n\nFinally, $a=-\\frac{3}{2},$ $c=\\frac{3}{2},$ and $\\frac{a}{c}=\\frac{(-\\frac{3}{2})}{(\\frac{3}{2})}=-1.$",
      "calculator_instructions": "",
      "fields": [],
      "answer_fields_complete": null,
      "result": "Correct",
