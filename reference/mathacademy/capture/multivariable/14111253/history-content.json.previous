c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>−</mo><mn>3</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mi>t</mi><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></div></td>\n<td style=\"text-align:center; border:1px solid black; border-top:hidden;\"></td>\n</tr></tbody></table></div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Sat, Oct 10th @ 10:56 PM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 4:52</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>"
