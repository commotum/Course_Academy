x-texclass=\"ORD\"><mi mathvariant=\"bold\">u</mi></mrow><mn>3</mn></msub><mo stretchy=\"false\">)</mo><mo fence=\"false\" stretchy=\"false\">}</mo></math></mjx-assistive-mml></mjx-container> is orthogonal </li><li> <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"736\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7B\"></mjx-c></mjx-mo><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D410 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-msub><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D42E TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-texatom space=\"2\" texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D410 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-msub><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D42E TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-texatom space=\"2\" texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D410 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-msub><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D42E TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7D\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo fence=\"false\" stretchy=\"false\">{</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">Q</mi></mrow><mo stretchy=\"false\">(</mo><msub><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">u</mi></mrow><mn>1</mn></msub><mo stretchy=\"false\">)</mo><mo>,</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">Q</mi></mrow><mo stretchy=\"false\">(</mo><msub><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">u</mi></mrow><mn>2</mn></msub><mo stretchy=\"false\">)</mo><mo>,</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">Q</mi></mrow><mo stretchy=\"false\">(</mo><msub><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">u</mi></mrow><mn>3</mn></msub><mo stretchy=\"false\">)</mo><mo fence=\"false\" stretchy=\"false\">}</mo></math></mjx-assistive-mml></mjx-container> is orthonormal </li></ol></div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Sat, Oct 10th @ 11:05 PM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 4:50</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>"
    },
    {
      "dom_id": "question-160710",
      "name": null,
      "problem": "Using the change of variables \n\n$$\nu=x-y,\\,v=x+y,\n$$\n\ncalculate the area of the finite region $D$ bounded by the lines $x+y=1,$ $x-y=1$ and the curve ${x}^{2}-{y}^{2}=2.$",
      "worked_solution": "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=x-y,\\,v=x+y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nSubstituting $x+y=v$ into the equation of the first line, we get\n\n$$\n\\begin{aligned}x+y=1\\,⟹\\,v=1,\\end{aligned}\n$$\n\nwhile substituting $x-y=u$ into the equation of the second line, we obtain\n\n$$\n\\begin{aligned}x-y=1\\,⟹\\,u=1.\\end{aligned}\n$$\n\nSubstituting $x+y=v$ and $x-y=u$ into the equation of curve, we get\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2}=2\\,⟹\\,(x-y)(x+y)=2,\\,⟹\\,uv=2.\\end{aligned}\n$$\n\nThe intersection point of the two lines in the $uv$-plane is $(1,1).$\n\nTo find the intersection of the curve with the first line in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}{\\begin{aligned}uv=2 \\\\ v=1\\end{aligned}\\,⟹\\,{\\begin{aligned}u=2 \\\\ v=1.\\end{aligned}\\end{aligned}\n$$\n\n \n\nTo find the intersections of the curve with the second line in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}{\\begin{aligned}uv=2 \\\\ u=1\\end{aligned}\\,⟹\\,{\\begin{aligned}u=1 \\\\ v=2.\\end{aligned}\\end{aligned}\n$$\n\n \n\nSo, the intersection points are $(1,1),$ $(1,2)$ and $(2,1).$\n\nTherefore, our domain in the $uv$-plane has the type I representation\n\n$$\nΔ={(u,v)\\,:\\,1\\le u\\le 2,\\,1\\le v\\le \\frac{2}{u}}.\n$$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14111253/assets/4c151e7fc8d150b9c8def69d609446b77424c2703decd9c8c55866cff2ae7437.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ 1 & \\text{ }\\text{ }1\\end{aligned}| \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=(2)^{-1}=\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|\\frac{1}{2}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}[{\\int }_{1}^{2/u}\\,dv]du \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}[v]_{1}^{2/u}\\,du \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}(\\frac{2}{u}-1)du \\\\  & =\\frac{1}{2}{[2\\operatorname{ln}⁡u-u]}_{1}^{2} \\\\  & =\\frac{1}{2}(2\\operatorname{ln}⁡2-2+1) \\\\  & =\\frac{1}{2}(2\\operatorname{ln}⁡2-1) \\\\  & =\\operatorname{ln}⁡2-\\frac{1}{2}\\end{aligned}\n$$",
      "calculator_instructions": "",
