evel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>0</mn></mtd><mtd><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mn>1</mn></mtd></mtr><mtr><mtd><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>−</mo><mn>2</mn></mtd><mtd><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>−</mo><mn>2</mn></mtd></mtr><mtr><mtd><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>−</mo><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>?</mo></math></mjx-assistive-mml></mjx-container></p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Sun, Oct 11th @ 4:17 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:02</span><span class=\"answerResult\"><span style=\"color: red;\">Incorrect</span></span></div></div>"
