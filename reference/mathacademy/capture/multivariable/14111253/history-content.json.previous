">)</mo><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>2</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></math></mjx-assistive-mml></mjx-container>\nand has a stationary point at <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"1733\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo stretchy=\"false\">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>.</mo></math></mjx-assistive-mml></mjx-container> If <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"1734\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D43B TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>H</mi></math></mjx-assistive-mml></mjx-container> denotes the Hessian determinant of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"1735\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mo>,</mo></math></mjx-assistive-mml></mjx-container> which of the following statements are true?</p>\n<ol class=\"questionStatements\"><li> <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"1736\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D43B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3E\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>H</mi><mo stretchy=\"false\">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>&gt;</mo><mn>0</mn></math></mjx-assistive-mml></mjx-container> </li><li> <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"1737\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mstyle><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mrow><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D715\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em; margin-left: 0.052em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi></mjx-mrow></mjx-num><mjx-dbox><mjx-dtable><mjx-line type=\"d\"></mjx-line><mjx-row><mjx-den><mjx-dstrut type=\"d\"></mjx-dstrut><mjx-mrow><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D715\"></mjx-c></mjx-mi><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.289em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup></mjx-mrow></mjx-den></mjx-row></mjx-dtable></mjx-dbox></mjx-frac></mjx-mfrac></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3E\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msup><mi>∂</mi><mn>2</mn></msup><mi>f</mi></mrow><mrow><mi>∂</mi><msup><mi>x</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>&gt;</mo><mn>0</mn></math></mjx-assistive-mml></mjx-container> </li><li>  The point <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"1738\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo stretchy=\"false\">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container> is a local minimum of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"1739\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi></math></mjx-assistive-mml></mjx-container> </li></ol></div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Sun, Oct 11th @ 4:06 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:07</span><span class=\"answerResult\"><span style=\"color: red;\">Incorrect</span></span></div></div>"
    },
    {
      "dom_id": "question-163242",
      "name": null,
      "problem": "![](/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14111253/assets/d1a19303937f1d515ca820516e10a73974b00f83884b05abb58dee49c81207f4.png)\n\nConsider a plate of mass $M$ that occupies the region $D$ in the upper half plane bounded by the circle ${x}^{2}+{y}^{2}=16,$ shown above. Given that the mass is distributed uniformly across the plate, find the moment of inertia of the plate about the $y$-axis.",
      "worked_solution": "For a plane lamina $D$ with mass density function $\\lambda (r,\\theta ),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis, in polar coordinates, is given by\n\n$$\n{I}_{x}={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\n$$\n\n- The moment of inertia about the $y$-axis, in polar coordinates, is given by\n\n$$\n{I}_{y}={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}{cos}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\n$$\n\n- The moment of inertia about the origin, in polar coordinates, is given by\n\n$$\n{I}_{0}={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}\\,\\text{d}r\\,\\text{d}\\theta ={I}_{x}+{I}_{y}.\n$$\n\nFirst, notice that the region $D$ in polar coordinates can be expressed as\n\n$$\nD={(r,\\theta )\\,:\\,0\\le r\\le 4,\\,\\,0\\le \\theta \\le \\pi }.\n$$\n\nThe area of the plate $D$ is \n\n$$\nA=\\frac{1}{2}\\pi {r}^{2}=8\\pi .\n$$\n\n \n\nSince the mass is distributed uniformly, the mass density function is given by\n\n$$\n\\lambda (r,\\theta )=\\frac{M}{A}=\\frac{M}{8\\pi }.\n$$\n\nTherefore, the moment of inertia about the $y$-axis is\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}{cos}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{M}{8\\pi }{\\int }_{0}^{\\pi }{\\int }_{0}^{4}{r}^{3}{cos}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{M}{8\\pi }({\\int }_{0}^{4}{r}^{3}\\,\\text{d}r)({\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,\\text{d}\\theta ) \\\\  & =\\frac{M}{8\\pi }({\\int }_{0}^{4}{r}^{3}\\,\\text{d}r)({\\int }_{0}^{\\pi }\\frac{1+\\operatorname{cos}⁡2\\theta }{2}\\,\\text{d}\\theta ) \\\\  & =\\frac{M}{8\\pi }\\cdot \\frac{1}{4}{r}^{4}{|}_{0}^{4}\\cdot (\\frac{1}{2}\\theta +\\frac{1}{4}\\operatorname{sin}⁡2\\theta ){|}_{0}^{\\pi } \\\\  & =\\frac{M}{8\\pi }\\cdot 64\\cdot \\frac{\\pi }{2} \\\\  & =4M.\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [],
      "answer_fields_complete": null,
      "result": "Incorrect",
      "proof_feedback": null,
      "html": "<div id=\"question-163242\" class=\"question\"><div class=\"questionHeader\"><span class=\"questionNumber\">59.</span><a class=\"questionKP\" href=\"/topics/2027#12483\">Calculating Moments of Inertia Using Polar Coordinates</a><span class=\"helpButton\" questionid=\"163242\">?</span></div><div class=\"questionGraphicFrame\"><img class=\"questionGraphic\" src=\"/graphics/q-163242\"></div><div class=\"questionText\"><p>Consider a plate of mass <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"1761\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D440 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi></math></mjx-assistive-mml></mjx-container> that occupies the region <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"1762\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D437 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>D</mi></math></mjx-assistive-mml></mjx-container> in the upper half plane bounded by the circle <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"1763\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-msup space=\"3\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>=</mo><mn>16</mn><mo>,</mo></math></mjx-assistive-mml></mjx-container> shown above. Given that the mass is distributed uniformly across the plate, find the moment of inertia of the plate about the <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"1764\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi></math></mjx-assistive-mml></mjx-container>-axis.</p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Sun, Oct 11th @ 4:06 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:02</span><span class=\"answerResult\"><span style=\"color: red;\">Incorrect</span></span></div></div>",
