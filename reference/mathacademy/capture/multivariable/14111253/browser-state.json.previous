rg/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><mo fence=\"false\" stretchy=\"false\">⟨</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow><mo>,</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">y</mi></mrow><mo fence=\"false\" stretchy=\"false\">⟩</mo></mtd><mtd><mi></mi><mo>=</mo><msub><mi>x</mi><mn>1</mn></msub><mover><msub><mi>y</mi><mn>1</mn></msub><mo accent=\"true\">―</mo></mover><mo>+</mo><msub><mi>x</mi><mn>2</mn></msub><mover><msub><mi>y</mi><mn>2</mn></msub><mo accent=\"true\">―</mo></mover><mo>+</mo><msub><mi>x</mi><mn>3</mn></msub><mover><msub><mi>y</mi><mn>3</mn></msub><mo accent=\"true\">―</mo></mover></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mo>+</mo><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow><mo stretchy=\"false\">)</mo><mo>⋅</mo><mo stretchy=\"false\">(</mo><mover><mrow><mn>2</mn><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow></mrow><mo accent=\"true\">―</mo></mover><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mover><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mtext>i</mtext></mrow><mo accent=\"true\">―</mo></mover><mo stretchy=\"false\">)</mo><mo>+</mo><mn>3</mn><mo>⋅</mo><mover><mn>2</mn><mo accent=\"true\">―</mo></mover></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mo>+</mo><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow><mo stretchy=\"false\">)</mo><mo>⋅</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow></mrow><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo>−</mo><mn>2</mn><mtext>i</mtext></mrow><mo stretchy=\"false\">)</mo><mo>+</mo><mn>3</mn><mo>⋅</mo><mn>2</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>4</mn><mo>+</mo><mn>7</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo>−</mo><mn>3</mn><mtext>i</mtext><mo stretchy=\"false\">)</mo><mo>+</mo><mn>6</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>9</mn><mo>+</mo><mn>4</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>  </p>\n</div></div>",
