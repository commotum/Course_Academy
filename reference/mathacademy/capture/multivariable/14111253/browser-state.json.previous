      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14111253/observations/diagnostic-18-49ae972baf98ffcf7ded.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14111253/observations/diagnostic-18-49ae972baf98ffcf7ded.png",
      "source_url": "https://mathacademy.com/tasks/14111253/diagnostics/453778",
