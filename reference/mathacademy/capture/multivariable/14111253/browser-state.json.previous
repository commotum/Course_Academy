      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14111253/observations/diagnostic-42-1e818311c7e7ff460648.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14111253/observations/diagnostic-42-1e818311c7e7ff460648.png",
      "source_url": "https://mathacademy.com/tasks/14111253/diagnostics/453778",
      "captured_at": 1791714009.500865,
