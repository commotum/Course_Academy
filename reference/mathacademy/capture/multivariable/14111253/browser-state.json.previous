      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14111253/observations/diagnostic-32-ac1e34a35d337b69822c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14111253/observations/diagnostic-32-ac1e34a35d337b69822c.png",
      "source_url": "https://mathacademy.com/tasks/14111253/diagnostics/453778",
