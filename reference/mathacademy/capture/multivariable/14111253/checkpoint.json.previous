stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo>−</mo><mn>2</mn><mtext>i</mtext></mrow><mo stretchy=\"false\">)</mo><mo>+</mo><mn>3</mn><mo>⋅</mo><mn>2</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>4</mn><mo>+</mo><mn>7</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo>−</mo><mn>3</mn><mtext>i</mtext><mo stretchy=\"false\">)</mo><mo>+</mo><mn>6</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>9</mn><mo>+</mo><mn>4</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container>  </p>\n</div></div>",
