mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow></mtd></mtr><mtr><mtd><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>4</mn><mi>t</mi></mrow></msup><mo>+</mo><mn>3</mn><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow><mo>+</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow></mtd></mtr><mtr><mtd><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>4</mn><mi>t</mi></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow><mo>+</mo><mn>7</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow></mtd></mtr><mtr><mtd><mn>3</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow><mo>−</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi></mrow></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>4</mn><mi>t</mi></mrow></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
