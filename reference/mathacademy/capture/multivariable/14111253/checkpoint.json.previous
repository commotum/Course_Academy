<mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c6D\"></mjx-c></mjx-mi><mjx-texatom texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2F\"></mjx-c></mjx-mo></mjx-texatom><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c73\"></mjx-c></mjx-mi></mjx-texatom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><msub><mi>v</mi><mrow data-mjx-texclass=\"ORD\"><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">max</mo></mrow></msub><mo>=</mo><mi>v</mi><mo stretchy=\"false\">(</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mo>=</mo><msqrt><mo>−</mo><mo stretchy=\"false\">(</mo><mn>4</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mn>8</mn><mo stretchy=\"false\">(</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>36</mn></msqrt><mo>=</mo><mn>2</mn><msqrt><mn>13</mn></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">m</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mi mathvariant=\"normal\">s</mi></mrow></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
