            "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:80px;\n                                        margin-left:0px;\n                                        margin-right:0px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"1\"><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"3\"><span class=\"mq-numerator\" mathquill-block-id=\"5\"><span mathquill-command-id=\"4\">1</span></span><span class=\"mq-denominator\" mathquill-block-id=\"7\"><span mathquill-command-id=\"6\">2</span></span><span style=\"display:inline-block;width:0\">​</span></span><var mathquill-command-id=\"9\">e</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"11\"><span class=\"mq-sup\" mathquill-block-id=\"13\"><span mathquill-command-id=\"12\" class=\"\">−</span><span mathquill-command-id=\"14\">2</span><span mathquill-command-id=\"16\">(</span><var mathquill-command-id=\"18\">t</var><span mathquill-command-id=\"20\" class=\"mq-binary-operator\">−</span><span mathquill-command-id=\"22\">2</span><span mathquill-command-id=\"24\">)</span></span></span></span></div></div>",
