up><mi>x</mi><mn>2</mn></msup><msup><mi>y</mi><mn>2</mn></msup><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo>=</mo><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo>=</mo><mn>2</mn></mrow></msubsup><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>y</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mn>1</mn></msubsup><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mn>8</mn></mfrac></mstyle><mi>y</mi><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>8</mn><mn>3</mn></mfrac></mstyle><mo>+</mo><mn>2</mn><msup><mi>y</mi><mn>2</mn></msup><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>y</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mn>1</mn></msubsup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>y</mi><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mn>4</mn></mfrac></mstyle><msup><mi>y</mi><mn>3</mn></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>y</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><msup><mi>y</mi><mn>2</mn></msup><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mn>16</mn></mfrac></mstyle><msup><mi>y</mi><mn>4</mn></msup><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mi>y</mi><mo>=</mo><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>y</mi><mo>=</mo><mn>1</mn></mrow></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>11</mn><mn>16</mn></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Finally, using the covariance formula, we get</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"564\" style=\"font-size: 119.6%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 14.585em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c43\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c76\"></mjx-c></mjx-mtext><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c5B\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"2\"><mjx-c class=\"mjx-c1D44C TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c5D\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0px; padding-bottom: 0.4em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mtext class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c45\"></mjx-c></mjx-mtext><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c5B\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44B TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44C TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c5D\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mtext class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c45\"></mjx-c></mjx-mtext><mjx-mo class=\"