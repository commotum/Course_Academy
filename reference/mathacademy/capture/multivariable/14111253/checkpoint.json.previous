/mi></mrow></msubsup><mi>f</mi><msqrt><mn>1</mn><mo>+</mo><mo stretchy=\"false\">(</mo><msup><mi>f</mi><mo data-mjx-alternate=\"1\">′</mo></msup><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>z</mi></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mi>π</mi><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msubsup><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>z</mi><msqrt><mn>1</mn><mo>+</mo><msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mi>z</mi></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mn>2</mn></msup></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>z</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mi>π</mi><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msubsup><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>z</mi><msqrt><mn>1</mn><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><msup><mi>z</mi><mn>2</mn></msup></mfrac></mstyle></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>z</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
