<mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mi>n</mi></msup></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>π</mi><mn>2</mn></msup><mn>12</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><munderover><mo data-mjx-texclass=\"OP\">∑</mo><mrow data-mjx-texclass=\"ORD\"><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant=\"normal\">∞</mi></munderover><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>π</mi><mn>2</mn></msup><mn>12</mn></mfrac></mstyle></mpadded></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
