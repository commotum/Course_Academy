5417] [17592186262370 #edb/ref 1078 #edb/ref 17592186261535 #edb/ref 17592186045417] [17592186262370 #edb/ref 1079 #uuid "8b77115e-fce9-56b5-b8af-ef860125ad2a" #edb/ref 17592186045417] [17592186262579 #edb/ref 1068 #edb/ref 17592186262370 #edb/ref 17592186045417] [17592186262579 #edb/ref 1069 "q-126031" #edb/ref 17592186045417] [17592186262579 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186262579 #edb/ref 1071 "Compute $P(X>2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{(1+x)^{2}},\\, & x\\ge 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186262579 #edb/ref 1072 #uuid "74467f4e-ddb0-5476-baee-aa2c6186829d" #edb/ref 17592186045417] [17592186262579 #edb/ref 1074 "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X>2) & =P(2<X<\\infty ) \\\\  & ={\\int }_{2}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{\\infty }\\frac{1}{(1+x)^{2}}\\,\\text{d}x \\\\  & ={[-\\frac{1}{x+1}]}_{2}^{\\infty } \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186263135 #edb/ref 1080 "y=At+Bt\\operatorname{ln}⁡t" #edb/ref 17592186045417] [17592186263135 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186263135 #edb/ref 1083 #uuid "0f5c2990-0c8a-584d-bfde-31963f7ff692" #edb/ref 17592186045417] [17592186264044 #edb/ref 1080 "y=At+B{t}^{3}" #edb/ref 17592186045417] [17592186264044 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186264044 #edb/ref 1083 #uuid "784e1679-3718-5a06-a425-4c1bcafd5944" #edb/ref 17592186045417] [17592186264349 #edb/ref 1080 "y=At+\\frac{B}{{t}^{2}}" #edb/ref 17592186045417] [17592186264349 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186264349 #edb/ref 1083 #uuid "9d9700b6-666a-5f29-a8bb-ff7cd542805c" #e