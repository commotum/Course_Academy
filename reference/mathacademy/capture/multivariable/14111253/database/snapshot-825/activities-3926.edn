#{[{:activity/first-step {:db/id #edb/ref 17592186189169} :activity/id #uuid "2c1b60fe-19a1-5c76-8d58-a10c1ae4790c" :activity/scope {:db/id #edb/ref 17592186049871 :topic/id #uuid "19e888aa-f28d-5a3a-a27d-2fb784b182ea" :topic/math-academy-id 3926} :activity/steps [{:db/id #edb/ref 17592186189167 :step/content {:db/id #edb/ref 17592186188327 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188034 :question/id #uuid "6cdc2b0e-a968-5d95-8fb6-5d469a5920b9" :question/math-academy-id "e-10302"} :knowledge-point/id #uuid "4c80ef8f-1073-5e41-bec3-860209a731bd" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048872} {:db/id #edb/ref 17592186050327}] :knowledge-point/questions [{:db/id #edb/ref 17592186188634} {:db/id #edb/ref 17592186188635}] :knowledge-point/title "Calculating a Conditional Variance Given a Conditional Mass Function"} :step/id #uuid "2ef086e9-8163-573e-9575-a78051c9420a" :step/math-academy-id 38837 :step/next {:db/id #edb/ref 17592186189183}} {:db/id #edb/ref 17592186189168 :step/content {:db/id #edb/ref 17592186188328 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188035 :question/id #uuid "49a039ae-dbe1-5faa-a9a7-014bd9549c03" :question/math-academy-id "e-10306"} :knowledge-point/id #uuid "92a52324-627c-5796-bc4f-ddeb5380f129" :knowledge-point/questions [{:db/id #edb/ref 17592186188637} {:db/id #edb/ref 17592186188689}] :knowledge-point/title "Calculating a Conditional Variance Using Column Totals"} :step/id #uuid "ac37dad4-4109-5b6c-a2d0-f6c46e058597" :step/math-academy-id 38849} {:db/id #edb/ref 17592186189169 :step/content {:db/id #edb/ref 17592186189401 :tutorial/content "Suppose that $X$ and $Y$ are discrete random variables, where the conditional expected value of $X$ given $Y=y$ is given by $\\mu_{X \\mid y}$. In other words,\n\n$$\n\\textrm{E}\\begin{bmatrix}X\\, & \\,Y=y\\end{bmatrix} = \\mu_{X \\mid y}\n$$\n\nThe **conditional variance of $X$ given $Y=y$** is defined as\n\n$$\n\\textrm{Var}\\begin{bmatrix}X\\, & \\,Y=y\\end{bmatrix} = \\textrm{E}\\big\\begin{bmatrix}(X - \\mu_{X \\mid y} \\big)^2 \\, & \\, Y=y\\end{bmatrix}\n$$\n\nThis is similar to the definition of $\\textrm{Var}[X]$ in that it represents the average (squared) distance of the random variable $X$ from the mean. The difference here is that the expected values are now dependent on the outcome of $Y$.\n\nSimilarly to the case of $\\textrm{Var}[X]$, this often isn't the easiest formula to use in practice. However, it can be shown that the definition of conditional variance is equivalent to\n\n$$\n\\begin{aligned}\nVar\\begin{bmatrix}X & Y = y\\end{bmatrix} &= E\\begin{bmatrix}X^{2} & Y = y\\end{bmatrix} - μ_{X\\begin{vmatrix}y}^{2} \\\\ = [∑_(x)x^{2}f_{X\\mid Y}(x \\mid y)] - μ_{X\\end{vmatrix}y}^{2}\n\\end{aligned}\n$$\n\nwhere $f_{X\\mid Y}(x \\, \\mid \\, y)$ is the conditional PMF of $X$ given $Y$. Note that these formulas are analogous to those for $\\textrm{Var}[X]$.\n\nFinally, we have an analogous definition for the conditional variance of $Y$ given $X=x$:\n\n$$\n\\begin{aligned}\nVar\\begin{bmatrix}Y & X = x\\end{bmatrix} &= E\\begin{bmatrix}(Y - μ_{Y \\mid x})^{2} & X = x\\end{bmatrix} \\\\\n&= E\\begin{bmatrix}Y^{2} & X = x\\end{bmatrix} - μ_{Y\\begin{vmatrix}x}^{2} \\\\ = [∑_(y)y^{2}f_{Y\\mid X}(y \\mid x)] - μ_{Y\\end{vmatrix}x}^{2}\n\\end{aligned}\n$$" :tutorial/id #uuid "ce4fb1c3-94ee-51c3-b10d-ce6ea0c7ff38" :tutorial/math-academy-id 6431 :tutorial/title "Introduction"} :step/id #uuid "12bb1f79-4af3-56c1-b495-e654c2cf5d1c" :step/math-academy-id 38850 :step/next {:db/id #edb/ref 17592186189167}} {:db/id #edb/ref 17592186189183 :step/content {:db/id #edb/ref 17592186188339 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188046 :question/id #uuid "3764cb54-7fd2-584a-9dc7-eda88368b032" :question/math-academy-id "e-10352"} :knowledge-point/id #uuid "abfaf356-6b74-5dfd-8070-e3a60dc372c5" :knowledge-point/questions [{:db/id #edb/ref 17592186188680} {:db/id #edb/ref 17592186188687}] :knowledge-point/title "Calculating a Conditional Variance Using Row Totals"} :step/id #uuid "7f447a96-6d58-5356-934d-4d4a94738359" :step/math-academy-id 38984 :step/next {:db/id #edb/ref 17592186189168}}] :activity/title "Conditional Variance for Discrete Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186188511}]}
