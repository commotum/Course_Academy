#{[{:activity/first-step {:db/id #edb/ref 17592186084159} :activity/id #uuid "dbe20a8e-3c23-5a3d-8bcc-a6dc3c286168" :activity/scope {:db/id #edb/ref 17592186049602 :topic/id #uuid "03bf032d-4826-587e-8877-e08682acc666" :topic/math-academy-id 763} :activity/steps [{:db/id #edb/ref 17592186084159 :step/content {:db/id #edb/ref 17592186084392 :tutorial/content "We can find the velocity $v(t)$ of a moving particle moving up and down the $x$-axis by computing the derivative of its position function $x(t).$ This same idea works in $2$ dimensions as well.\n\nIn two dimensions, we can represent a particle's position using a vector-valued function\n\n$$\n\\mathbf{r} = \\langle x(t), y(t)\\rangle,\n$$\n\nwhich gives the particle's position relative to a fixed origin $O$ at time $t.$ \n\nHere, $x(t)$ tells us how the $x$-coordinate of the particle changes with time, and $y(t)$ does the same for the $y$-coordinate. As time progresses, the particle moves along a **path**, and its position vector $\\mathbf{r}(t)$ changes with time.\n\n![](images/59/5936296fbeaa4bf039ff0f0ce7f1455d190daf8473e6e4ec7c60cf40cfc07a13.png)\n\nThe particle's velocity vector is then given by the derivative of its position vector,\n\n$$\n\\mathbf{v} \t= \\frac{\\textrm{d}\\mathbf{r}}{\\textrm{d}t} \n\t\t\t= \\left\\langle \\frac{\\textrm{d}x}{\\textrm{d}t},\\frac{\\textrm{d}y}{\\textrm{d}t} \\right\\rangle.\n$$\n\nIn other words, we differentiate the $x$-coordinate and the $y$-coordinate independently with respect to time. The resulting derivatives are the $x$ and $y$ components of the velocity vector." :tutorial/id #uuid "402d7689-ca4c-53dc-81ca-1483d76ebefe" :tutorial/math-academy-id 1101 :tutorial/title "Introduction"} :step/id #uuid "b7a8f1f1-0ce2-5fea-aabe-a37ea0b4ee70" :step/math-academy-id 2164 :step/next {:db/id #edb/ref 17592186084160}} {:db/id #edb/ref 17592186084160 :step/content {:db/id #edb/ref 17592186083249 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083070 :question/id #uuid "9b28994b-b161-504b-8993-d300f464a2cc" :question/math-academy-id "e-616"} :knowledge-point/id #uuid "dccdc3ad-6acb-57ae-83ef-95ffedfbff2f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048999} {:db/id #edb/ref 17592186049910} {:db/id #edb/ref 17592186050270} {:db/id #edb/ref 17592186050901}] :knowledge-point/questions [{:db/id #edb/ref 17592186083656} {:db/id #edb/ref 17592186083919} {:db/id #edb/ref 17592186256554} {:db/id #edb/ref 17592186256555} {:db/id #edb/ref 17592186320993} {:db/id #edb/ref 17592186320994} {:db/id #edb/ref 17592186320995} {:db/id #edb/ref 17592186320996} {:db/id #edb/ref 17592186320997} {:db/id #edb/ref 17592186320998} {:db/id #edb/ref 17592186387098}] :knowledge-point/title "Finding the Velocity Vector of a Particle Moving in Two Dimensions"} :step/id #uuid "632946af-4caf-5f2d-9b29-b3132e4f4493" :step/math-academy-id 2165 :step/next {:db/id #edb/ref 17592186084166}} {:db/id #edb/ref 17592186084166 :step/content {:db/id #edb/ref 17592186083253 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083071 :question/id #uuid "768aa1ca-15ff-5307-8184-6dd207f7e061" :question/math-academy-id "e-617"} :knowledge-point/id #uuid "3ca363e2-c7b7-5196-bd38-10bcc30123ce" :knowledge-point/questions [{:db/id #edb/ref 17592186083840} {:db/id #edb/ref 17592186083841} {:db/id #edb/ref 17592186256556} {:db/id #edb/ref 17592186256557} {:db/id #edb/ref 17592186256558} {:db/id #edb/ref 17592186319163} {:db/id #edb/ref 17592186320999} {:db/id #edb/ref 17592186321000} {:db/id #edb/ref 17592186321002} {:db/id #edb/ref 17592186332870} {:db/id #edb/ref 17592186345061} {:db/id #edb/ref 17592186387105} {:db/id #edb/ref 17592186387112}] :knowledge-point/title "Calculating the Velocity Vector of a Particle Moving in Two Dimensions at a Given Time"} :step/id #uuid "640e6f88-b688-5faa-95db-97363748609e" :step/math-academy-id 2168 :step/next {:db/id #edb/ref 17592186084167}} {:db/id #edb/ref 17592186084167 :step/content {:db/id #edb/ref 17592186084393 :tutorial/content "If the velocity of a particle at time $t$ is \n\n$$\n\\mathbf{v} = \\left< u, v \\right> =  \\left< \\dfrac{\\textrm dx}{\\textrm dt}, \\, \\dfrac{\\textrm dy}{\\textrm dt} \\right>,\n$$\n\nthen its speed is given by the magnitude $|\\mathbf{v}|,$ as follows:\n\n$$\n|\\mathbf{v}| = \\sqrt{ u^2 + v^2}\t= \\sqrt{\\left(\\frac{\\textrm{d}x}{\\textrm{d}t}\\right)^2 + \\left(\\frac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\n$$" :tutorial/id #uuid "07d2a599-4431-552d-8b3b-cd5ad57364cf" :tutorial/math-academy-id 1104 :tutorial/title "The Speed of a Particle"} :step/id #uuid "e4d947d1-0f1a-5646-969a-9bfd5374ca1f" :step/math-academy-id 2170 :step/next {:db/id #edb/ref 17592186084168}} {:db/id #edb/ref 17592186084168 :step/content {:db/id #edb/ref 17592186083254 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083072 :question/id #uuid "b9a41b06-e359-5e55-bad3-37922a87db14" :question/math-academy-id "e-618"} :knowledge-point/id #uuid "646467d1-f764-5a3c-b03b-7d74e588611d" :knowledge-point/questions [{:db/id #edb/ref 17592186083657} {:db/id #edb/ref 17592186083920} {:db/id #edb/ref 17592186256559} {:db/id #edb/ref 17592186319164} {:db/id #edb/ref 17592186321003} {:db/id #edb/ref 17592186321005} {:db/id #edb/ref 17592186321006} {:db/id #edb/ref 17592186321007} {:db/id #edb/ref 17592186321008} {:db/id #edb/ref 17592186321009} {:db/id #edb/ref 17592186338956} {:db/id #edb/ref 17592186345063} {:db/id #edb/ref 17592186371651}] :knowledge-point/title "Calculating the Speed of a Particle at a Given Time"} :step/id #uuid "0434cb2b-6d41-5370-ad11-3507fa446c48" :step/math-academy-id 2171 :step/next {:db/id #edb/ref 17592186084169}} {:db/id #edb/ref 17592186084169 :step/content {:db/id #edb/ref 17592186084394 :tutorial/content "A particle is stationary if its velocity is zero. This means that\n\n$$\n\\begin{aligned}⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ & =⟨0,0⟩.\\end{aligned}\n$$\n\nTherefore, to find the times when a particle is stationary, we need to solve $\\dfrac{\\textrm{d}x}{\\textrm{d}t} = 0$ and $\\dfrac{\\textrm{d}y}{\\textrm{d}t} = 0$ simultaneously." :tutorial/id #uuid "04b861d4-fe86-59fd-8f12-9da592dac1a3" :tutorial/math-academy-id 1106 :tutorial/title "Times When the Particle is Stationary"} :step/id #uuid "61807d45-05df-571e-9651-ab6a9de20a01" :step/math-academy-id 2173 :step/next {:db/id #edb/ref 17592186084170}} {:db/id #edb/ref 17592186084170 :step/content {:db/id #edb/ref 17592186083255 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083073 :question/id #uuid "c90c307e-39b7-5159-95bc-9d2961369396" :question/math-academy-id "e-619"} :knowledge-point/id #uuid "11a24997-1f1e-5968-a331-980ca14be2f6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049954}] :knowledge-point/questions [{:db/id #edb/ref 17592186083773} {:db/id #edb/ref 17592186083921} {:db/id #edb/ref 17592186256560} {:db/id #edb/ref 17592186256561} {:db/id #edb/ref 17592186297488} {:db/id #edb/ref 17592186297490} {:db/id #edb/ref 17592186319165} {:db/id #edb/ref 17592186321012} {:db/id #edb/ref 17592186321032} {:db/id #edb/ref 17592186321033} {:db/id #edb/ref 17592186321034} {:db/id #edb/ref 17592186372997} {:db/id #edb/ref 17592186398221}] :knowledge-point/title "Calculating the Times at Which a Particle Is Stationary"} :step/id #uuid "8cca70a4-79e4-535b-978b-f1e9ff7c22d8" :step/math-academy-id 2174}] :activity/title "Calculating Velocity for Plane Motion Using Differentiation" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083452}]}
