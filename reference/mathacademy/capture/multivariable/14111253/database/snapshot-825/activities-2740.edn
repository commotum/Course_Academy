#{[{:activity/first-step {:db/id #edb/ref 17592186153290} :activity/id #uuid "d59d69ae-798b-5a20-9d5f-60ce55a98799" :activity/scope {:db/id #edb/ref 17592186050522 :topic/id #uuid "503f6e39-70fd-54b8-a04b-77e9fcd7b979" :topic/math-academy-id 2740} :activity/steps [{:db/id #edb/ref 17592186153290 :step/content {:db/id #edb/ref 17592186153382 :tutorial/content "Consider the second-order linear homogeneous differential equation\n\n$$\ny'' - 5y' + 6y = 0.\n$$\n\nIt can be shown that a fundamental set of solutions is given by\n\n$$\ny_1(x) = e^{3x}, \\qquad y_2(x) = e^{2x}.\n$$\n\nThe superposition principle tells us that any linear combination of solutions to a linear, homogeneous differential equation is also a solution to the equation. Therefore, the **general solution** to this differential equation is\n\n$$\ny(x) = Ae^{3x} + Be^{2x}\n$$\n\nwhere $A$ and $B$ are **arbitrary constants.**\n\nIn general, if an $n$th order homogeneous, linear ODE has a fundamental set of solutions given by \n\n$$\ny_1(x), \\quad y_2(x),\\quad \\ldots, \\quad y_n(x),\n$$\n\nthen the general solution to the equation is \n\n$$\n\\bbox[4pt,border: 1px solid lightgray]{y(x) = C_1y_1(x)+C_2y_2(x)+\\cdots+C_ny_n(x)}\n$$\n\nfor arbitrary constants $C_1, C_2,\\ldots C_n.$\n\n**Note:** Using sigma notation, we can write the general solution more compactly as\n\n$$\ny(x) = \\sum_{i=1}^n C_i y_i(x).\n$$" :tutorial/id #uuid "d0ae06ba-917f-56b1-8d5d-fac54f464ee8" :tutorial/math-academy-id 4197 :tutorial/title "Introduction"} :step/id #uuid "c268f62a-7fd0-540c-9ff9-832b5389a31e" :step/math-academy-id 601711 :step/next {:db/id #edb/ref 17592186153291}} {:db/id #edb/ref 17592186153291 :step/content {:db/id #edb/ref 17592186152291 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151984 :question/id #uuid "bbf72227-f0da-5dab-88cd-bfed2ed773f7" :question/math-academy-id "e-6792"} :knowledge-point/id #uuid "6302f81d-4834-56a5-b014-0a97c3dccd6f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049486} {:db/id #edb/ref 17592186050032} {:db/id #edb/ref 17592186050150}] :knowledge-point/questions [{:db/id #edb/ref 17592186152635} {:db/id #edb/ref 17592186152643} {:db/id #edb/ref 17592186265795} {:db/id #edb/ref 17592186345315} {:db/id #edb/ref 17592186348312} {:db/id #edb/ref 17592186357466} {:db/id #edb/ref 17592186400443}] :knowledge-point/title "Identifying True Statements About General Solutions of Second-Order Linear ODEs"} :step/id #uuid "f0a0cdaa-70e3-5041-a39e-64dbcbe7a4a1" :step/math-academy-id 601712 :step/next {:db/id #edb/ref 17592186153292}} {:db/id #edb/ref 17592186153292 :step/content {:db/id #edb/ref 17592186152292 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151982 :question/id #uuid "bacb284c-88db-5ad5-bd7d-cbe6fbc604df" :question/math-academy-id "e-6789"} :knowledge-point/id #uuid "a67ca0bc-c946-5963-a733-2ec9eb6b07ce" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049102}] :knowledge-point/questions [{:db/id #edb/ref 17592186152640} {:db/id #edb/ref 17592186152641} {:db/id #edb/ref 17592186265788} {:db/id #edb/ref 17592186265790} {:db/id #edb/ref 17592186265791} {:db/id #edb/ref 17592186335797} {:db/id #edb/ref 17592186348313} {:db/id #edb/ref 17592186348314} {:db/id #edb/ref 17592186357490} {:db/id #edb/ref 17592186380076} {:db/id #edb/ref 17592186380277}] :knowledge-point/title "Finding General Solutions to Second-Order Homogeneous ODEs Using Reduction of Order"} :step/id #uuid "66cf83ce-b3bc-50bd-88ae-2b9f54096657" :step/math-academy-id 601715 :step/next {:db/id #edb/ref 17592186153293}} {:db/id #edb/ref 17592186153293 :step/content {:db/id #edb/ref 17592186152293 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151985 :question/id #uuid "f41bad20-5a72-5d6d-82c4-cf36f7ac74cd" :question/math-academy-id "e-6794"} :knowledge-point/id #uuid "9ef8a6ef-3e77-5e3e-ac75-c3dece0af96e" :knowledge-point/questions [{:db/id #edb/ref 17592186152636} {:db/id #edb/ref 17592186152642} {:db/id #edb/ref 17592186265797} {:db/id #edb/ref 17592186265798} {:db/id #edb/ref 17592186265800} {:db/id #edb/ref 17592186265806} {:db/id #edb/ref 17592186335798} {:db/id #edb/ref 17592186348315} {:db/id #edb/ref 17592186348316} {:db/id #edb/ref 17592186357476}] :knowledge-point/title "Finding General Solutions to Second-Order Homogeneous ODEs With Variable Coefficients"} :step/id #uuid "38e288bc-7c3f-536d-a984-63e199038d6a" :step/math-academy-id 601718 :step/next {:db/id #edb/ref 17592186153294}} {:db/id #edb/ref 17592186153294 :step/content {:db/id #edb/ref 17592186153335 :tutorial/content "Similar to first-order linear ODEs, for inhomogeneous differential equations, the **general solution** is given by\n\n$$\ny(x) = y_c(x) + y_p(x),\n$$\n\nwhere\n\n- $y_c(x)$ is the **complementary solution** (the general solution of the corresponding homogeneous equation), and\n\n- $y_p(x)$ is a **particular solution** of the original inhomogeneous equation.\n\nWe will apply this structure to a specific differential equation in the next slide." :tutorial/id #uuid "d323d4d9-40c7-5a00-aafe-a0c1ba46fd4c" :tutorial/math-academy-id 14780 :tutorial/title "General Solutions of Inhomogeneous ODEs"} :step/id #uuid "4499c456-0b30-59ea-92cd-0a6e8cc58d01" :step/math-academy-id 601721 :step/next {:db/id #edb/ref 17592186153295}} {:db/id #edb/ref 17592186153295 :step/content {:db/id #edb/ref 17592186152294 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151912 :question/id #uuid "58f2bf06-7449-5a66-9662-532ce70a8ff9" :question/math-academy-id "e-21879"} :knowledge-point/id #uuid "7640be27-8277-5a9c-bf14-83bcc7a38604" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049370}] :knowledge-point/questions [{:db/id #edb/ref 17592186152577} {:db/id #edb/ref 17592186152578} {:db/id #edb/ref 17592186314878} {:db/id #edb/ref 17592186314879} {:db/id #edb/ref 17592186314880} {:db/id #edb/ref 17592186379528} {:db/id #edb/ref 17592186379548} {:db/id #edb/ref 17592186397359} {:db/id #edb/ref 17592186397379}] :knowledge-point/title "Constructing General Solutions of Inhomogeneous ODEs"} :step/id #uuid "2779fb81-53c1-5556-969d-409a83b9a273" :step/math-academy-id 601722}] :activity/title "General Solutions of Linear ODEs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152359}]}
