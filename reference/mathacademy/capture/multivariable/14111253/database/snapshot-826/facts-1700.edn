45417] [17592186396335 #edb/ref 1080 "{e}^{st}\\cdot {e}^{-t}b(t)" #edb/ref 17592186045417] [17592186396335 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186396335 #edb/ref 1083 #uuid "a4797a91-e932-53a1-8507-a34bc4953f27" #edb/ref 17592186045417] [17592186396336 #edb/ref 1080 "{e}^{-st}\\cdot {e}^{-t}b(t)" #edb/ref 17592186045417] [17592186396336 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186396336 #edb/ref 1083 #uuid "b9f8dfdc-b500-5751-86f4-01761d3fc90d" #edb/ref 17592186045417] [17592186397263 #edb/ref 1068 #edb/ref 17592186397264 #edb/ref 17592186045417] [17592186397263 #edb/ref 1068 #edb/ref 17592186397270 #edb/ref 17592186045417] [17592186397263 #edb/ref 1069 "q-338907" #edb/ref 17592186045417] [17592186397263 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186397263 #edb/ref 1071 "Consider the boundary value problem\n\n$$\n{y}^{″}+9{\\lambda }^{2}y=0,\\,y(0)=y(\\pi )=0,\\,0\\le x\\le \\pi ,\\,\\lambda \\ge 0.\n$$\n\nFind the parameter values corresponding to the eigenvalues and the associated eigenfunctions of this problem." #edb/ref 17592186045417] [17592186397263 #edb/ref 1072 #uuid "958d5083-ae6b-5fcf-874a-f964110a9edf" #edb/ref 17592186045417] [17592186397263 #edb/ref 1074 "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions $y(0)=y(\\pi )=0$ yields the trivial solution $y≡0.$ Since the zero solution is not an eigenfunction, $\\lambda =0$ does not correspond to an eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda >0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}+9{\\lambda }^{2} & =0.\\end{aligned}\n$$\n\nSo, we have $m=\\pm 3\\text{i}\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)=\\operatorname{cos}⁡(3\\lambda x),\\,{y}_{2}(x)=\\operatorname{sin}⁡(3\\lambda x)\n$$\n\nand the general solution is\n\n$$\ny=A\\operatorname{cos}⁡(3\\lambda x)+B\\operatorname{sin}⁡(3\\lambda x).\n$$\n\nApplying the boundary condition $y(0)=0$ yields\n\n$$\nA\\operatorname{cos}⁡(0)+B\\operatorname{sin}⁡(0)=0\n$$\n\nwhich gives $A=0.$ So, we have\n\n$$\ny=B\\operatorname{sin}⁡(3\\lambda x).\n$$\n\nApplying the boundary condition $y(\\pi )=0$ yields\n\n$$\nB\\operatorname{sin}⁡(3\\lambda \\pi )=0.\n$$\n\nFor nontrivial solutions, we require \n\n$$\n3\\lambda \\pi =n\\pi \n$$\n\nfor $n\\in N.$ This gives the parameter values corresponding to the eigenvalues:\n\n$$\n{\\lambda }_{n}=\\frac{n}{3}.\n$$\n\nThe corresponding eigenfunctions are \n\n$$\n{y}_{n}(x)={B}_{n}\\operatorname{sin}⁡(3{\\lambda }_{n}x),\\,{B}_{n}\\in R.\n$$" #edb/ref 17592186045417] [17592186397264 #edb/ref 1075 #edb/ref 17592186397265 #edb/ref 17592186045417] [17592186397264 #edb/ref 1075 #edb/ref 17592186397266 #edb/ref 17592186045417] [17592186397264 #edb/ref 1075 #edb/ref 17592186397267 #edb/ref 17592186045417] [17592186397264 #edb/ref 1075 #edb/ref 17592186397268 #edb/ref 17592186045417] [17592186397264 #edb/ref 1075 #edb/ref 17592186397269 #edb/ref 17592186045417] [17592186397264 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186397264 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186397264 #edb/ref 1078 #edb/ref 17592186397265 #edb/ref 17592186045417] [17592186397264 #edb/ref 1079 #uuid "00e92f05-552a-5096-91d9-24d9da00fdbd" #edb/ref 17592186045417] [17592186397265 #edb/ref 1080 "\\frac{n}{3}" #edb/ref 17592186045417] [17592186397265 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186397265 #edb/ref 1083 #uuid "34c15024-ad26-5f05-9256-bec2be1ec08d" #edb/ref 17592186045417] [17592186397266 #edb/ref 1080 "\\frac{n\\pi }{9}" #edb/ref 17592186045417] [17592186397266 #edb/ref 1082 #edb/ref 1759218604549