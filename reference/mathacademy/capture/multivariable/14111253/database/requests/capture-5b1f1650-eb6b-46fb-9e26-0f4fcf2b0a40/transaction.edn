8157-fe69a694922d" "answer-87300a85-1a3b-5482-8d6a-77042fc3955d"] :db/ensure [:answer-field/validate]} {:db/id "answer-2cec1b04-11f1-52b4-bede-6fa1be707451" :answer/id #uuid "2cec1b04-11f1-52b4-bede-6fa1be707451" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-3233da4d-abf4-509b-8a83-199acf697664" :answer/id #uuid "3233da4d-abf4-509b-8a83-199acf697664" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{12}" :db/ensure [:answer/validate]} {:db/id "answer-56ce5d4f-b6f2-580a-8157-fe69a694922d" :answer/id #uuid "56ce5d4f-b6f2-580a-8157-fe69a694922d" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{6}" :db/ensure [:answer/validate]} {:db/id "answer-87300a85-1a3b-5482-8d6a-77042fc3955d" :answer/id #uuid "87300a85-1a3b-5482-8d6a-77042fc3955d" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{8}" :db/ensure [:answer/validate]} {:db/id 17592186396318 :question/problem "Consider a function $b(t)$ such that its Laplace transform is $L{b(t)}=B(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L{{e}^{t}b(t)}.$ Select the correct options in the reasoning below.By definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L{{e}^{t}b(t)} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,b(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186308728 :question/problem "$$\nA=[\\begin{aligned}0 & -3 \\\\ 3 & 0\\end{aligned}],\\,{e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(3t) & -\\operatorname{sin}⁡(3t) \\\\ \\operatorname{sin}⁡(3t) & \\operatorname{cos}⁡(3t)\\end{aligned}]\n$$ Given the matrices $A$ and ${e}^{At}$ above, compute $\\frac{\\text{d}}{\\text{d}t}({e}^{At}).$ \n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\frac{\\text{d}}{\\text{d}t}({e}^{At})=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"40px\">{{field-1}}</td>\n<td align=\"center\" width=\"40px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr></tbody></table>" :db/ensure [:question/validate]} {:db/id 17592186411865 :question/problem "$$\n{u}_{1}=[\\begin{aligned}3 \\\\ 0 \\\\ 1\\end{aligned}],\\,{u}_{2}=[\\begin{aligned}1 \\\\ 1 \\\\ -3\\end{aligned}],\\,{u}_{3}=[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}]\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\nI. ${u}_{1}\\cdot {u}_{3}=0$\n\nII. ${Q({u}_{1}),Q({u}_{2}),Q({u}_{3})}$ is orthogonal\n\nIII. ${Q({u}_{1}),Q({u}_{2}),Q({u}_{3})}$ is orthonormal" :db/ensure [:question/validate]} {:db/id 17592186304814 :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n\nI. $2\\cdot {x}_{1}(t)+{x}_{p}(t)$\n\nII. ${x}_{1}(t)-{x}_{2}(t)$\n\nIII. $3\\cdot {x}_{p}(t)$" :db/ensure [:question/validate]} {:db/id 17592186385178 :question/problem "For which of the following values is the implicit Euler method stable, given that $\\lambda $ is the parameter of the test equation?\n\nI. $\\lambda Δx=0.1$\n\nII. $\\lambda Δx=0.8$\n\nIII. $\\lambda Δx=1.2$\n\nIV. $\\lambda Δx=5$\n\n*Hint: The stability function $R$ of the implicit Euler method is given by*\n\n$$\nR(\\lambda Δx)=\\frac{1}{1+\\lambda Δx}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186308522 :question/problem "Consider the following initial value problem:\n\n$$\n{x}^{2}{y}^{″}+4{y}^{′}-y=0,\\,y(1)=-1,\\,{y}^{′}(1)=2\n$$\n\nUse Euler's Method with two steps to approximate $y(2)$ and ${y}^{′}(2).$\n\n$$\ny(2)≈{{field-1}},\\,{y}^{′}(2)≈{{field-2}}\n$$" :db/ensure [:question/validate]} {:db/id 17592186314869 :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=x+y,\\,y(0)=0\n$$\n\nUse the trapezoidal method with two steps to approximate $y(1)$ and $y(2),$ rounded to two decimal places.\n\n$$\ny(1)≈{{field-1}},\\,y(2)≈{{field-2}}\n$$" :db/ensure [:question/validate]} {:db/id 17592186332840 :question/problem "Which of the following series converge?\n\nI. ${\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{n!}$\n\nII. ${\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{n}}{n+2}$\n\nIII. ${\\sum }_{n=1}^{\\infty }\\frac{{n}^{3}}{n+2{n}^{2}}$" :db/ensure [:question/validate]} {:db/id 17592186179647 :knowledge-point/questions ["question-6071adb1-29d3-5cda-a599-699b41d64b95"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6071adb1-29d3-5cda-a599-699b41d64b95" :question/id #uuid "6071adb1-29d3-5cda-a599-699b41d64b95" :question/math-academy-id "q-226151" :question/problem "![](images/de/de3e018fa1382ee2250d1b2e256e3b47cafef346852007f0e6afb84342d7cb04.png)\n\nConsider the vector field $F=3x\\,i-2y\\,j$ and a rectangle $C$ with base $4$ and height $6$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" :question/worked-solution "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/09/0950c559d5d6df93cf40afd8fdbd07f090f864fa462083bfd496246e7f2bded9.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(3x\\,i-2y\\,j)\\cdot i\\,\\text{d}s \\\\  & =3{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=2i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}3{\\int }_{{C}_{1}}x\\,\\text{d}s & =3{\\int }_{-3}^{3}2\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =6{\\int }_{-3}^{3}\\text{d}t \\\\  & =6\\cdot 6 \\\\  & =36.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=36.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(3x\\,i-2y\\,j)\\cdot j\\,\\text{d}s \\\\  & =-2{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+3j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-2{\\int }_{{C}_{2}}y\\,\\text{d}s & =-2{\\int }_{-2}^{2}3\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-6{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-6)\\cdot 4 \\\\  & =-24.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=-24.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot 36+2\\cdot (-24)=24.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-dc977685-7a6f-5892-9d86-65a9ccbd87da"] :db/ensure [:question/validate]} {:db/id "answer-field-dc977685-7a6f-5892-9d86-65a9ccbd87da" :answer-field/id #uuid "dc977685-7a6f-5892-9d86-65a9ccbd87da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7860d733-39e7-5d34-930a-375944911a4e" :answer-field/choices ["answer-615383ae-5073-5a27-a6bc-b222285b07e6" "answer-a9e0b03b-9a26-5f35-8452-4cc76772c98a" "answer-0c5de29c-bfc1-53ce-83a7-41993dcf260c" "answer-7860d733-39e7-5d34-930a-375944911a4e" "answer-0aa1db5b-3f41-577b-8ee0-5f7105de71c4"] :db/ensure [:answer-field/validate]} {:db/id "answer-615383ae-5073-5a27-a6bc-b222285b07e6" :answer/id #uuid "615383ae-5073-5a27-a6bc-b222285b07e6" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-a9e0b03b-9a26-5f35-8452-4cc76772c98a" :answer/id #uuid "a9e0b03b-9a26-5f35-8452-4cc76772c98a" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-0c5de29c-bfc1-53ce-83a7-41993dcf260c" :answer/id #uuid "0c5de29c-bfc1-53ce-83a7-41993dcf260c" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-7860d733-39e7-5d34-930a-375944911a4e" :answer/id #uuid "7860d733-39e7-5d34-930a-375944911a4e" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-0aa1db5b-3f41-577b-8ee0-5f7105de71c4" :answer/id #uuid "0aa1db5b-3f41-577b-8ee0-5f7105de71c4" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id 17592186411855 :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=2x$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{n}.$\n\n$\\,{a}_{n}=$ {{field-1}}\nfor $n\\ge 1$" :db/ensure [:question/validate]} {:db/id 17592186397263 :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+9{\\lambda }^{2}y=0,\\,y(0)=y(\\pi )=0,\\,0\\le x\\le \\pi ,\\,\\lambda \\ge 0.\n$$\n\nFind the parameter values corresponding to the eigenvalues and the associated eigenfunctions of this problem.\n\n$\\,$ The eigenvalues correspond to the parameter values ${\\lambda }_{n}=$ {{field-1}}, where $n\\in N.$\n\n$\\,$ The eigenfunctions are ${y}_{n}(x)=$ {{field-2}}, where ${B}_{n}\\in R.$" :db/ensure [:question/validate]} {:db/id 17592186411856 :question/problem "Given that $A$ is a real symmetric matrix, which of the following statements are true?\n\nI. $A$ must have a complex eigenvalue\n\nII. $A$ is not diagonalizable\n\nIII. If $u$ and $v$ are two eigenvectors corresponding to different eigenvalues, then $u⊥v$" :db/ensure [:question/validate]} {:db/id 17592186357737 :question/problem "A particle is moving with forced harmonic motion without damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+16y=32t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nI. $y=R\\operatorname{cos}⁡(2t+ϕ)+16t$\n\nII. $y=R\\operatorname{sin}⁡(4t+ϕ)+2t$\n\nIII. $y=A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡2t+8t$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :db/ensure [:question/validate]} {:db/id 17592186308409 :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-x(t) \\\\ {y}^{′}(t)=2y(t)\\end{aligned}\n$$\n\nSelect the correct options below regarding the given decoupled system of linear differential equations.\n\n$\\,$\nThe $x$-axis is a {{field-1}} line.\n\n$\\,$\nThe $y$-axis is a {{field-2}} line.\n\n$\\,$\nThe equilibrium point (origin) is {{field-3}}." :db/ensure [:question/validate]}]
