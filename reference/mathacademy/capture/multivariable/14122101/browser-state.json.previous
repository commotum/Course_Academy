      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14122101/observations/step-q95981-6448a1486e9917c5382e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14122101/observations/step-q95981-6448a1486e9917c5382e.png",
      "source_url": "https://mathacademy.com/tasks/14122101/topics/3278/lesson",
      "captured_at": 1791745014.2173011,
      "math_academy_id": "q-95981",
      "topic_id": "3278",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q95981",
