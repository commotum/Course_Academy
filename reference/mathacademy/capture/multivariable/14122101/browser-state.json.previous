      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14122101/observations/step-q96276-013bf4e87973b4c48523.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14122101/observations/step-q96276-013bf4e87973b4c48523.png",
      "source_url": "https://mathacademy.com/tasks/14122101/topics/3278/lesson",
      "captured_at": 1791744987.1915338,
      "math_academy_id": "q-96276",
