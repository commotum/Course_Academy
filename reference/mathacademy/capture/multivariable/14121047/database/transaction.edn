, and\n\n- $4{b}_{n}-{d}_{n},$ $n\\ge 1$ for the sine coefficients.\n\nTherefore, the $4$th cosine coefficient of $4f(x)-g(x)$ is\n\n$$\n4{a}_{4}-{c}_{4}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4dfa34c6-5a35-5a11-b994-3c98bf4c1dd1"] :db/ensure [:question/validate]} {:db/id "answer-field-4dfa34c6-5a35-5a11-b994-3c98bf4c1dd1" :answer-field/id #uuid "4dfa34c6-5a35-5a11-b994-3c98bf4c1dd1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ebf92a57-4d42-5395-bbe2-ed657cbc2184" :answer-field/choices ["answer-a502f40b-fd58-5f47-b90f-59c017ccedad" "answer-db477f8b-1f63-5509-ab25-71148ea202f8" "answer-ebf92a57-4d42-5395-bbe2-ed657cbc2184" "answer-dd6c63d5-17cc-5e42-a3b6-72f9aa180811" "answer-4555140a-612c-5656-9db2-e93a5e1d92c5"] :db/ensure [:answer-field/validate]} {:db/id "answer-a502f40b-fd58-5f47-b90f-59c017ccedad" :answer/id #uuid "a502f40b-fd58-5f47-b90f-59c017ccedad" :answer/type :answer.type/math :answer/value "4{a}_{0}-{d}_{0}" :db/ensure [:answer/validate]} {:db/id "answer-db477f8b-1f63-5509-ab25-71148ea202f8" :answer/id #uuid "db477f8b-1f63-5509-ab25-71148ea202f8" :answer/type :answer.type/math :answer/value "4{a}_{4}-{b}_{4}" :db/ensure [:answer/validate]} {:db/id "answer-ebf92a57-4d42-5395-bbe2-ed657cbc2184" :answer/id #uuid "ebf92a57-4d42-5395-bbe2-ed657cbc2184" :answer/type :answer.type/math :answer/value "4{a}_{4}-{c}_{4}" :db/ensure [:answer/validate]} {:db/id "answer-dd6c63d5-17cc-5e42-a3b6-72f9aa180811" :answer/id #uuid "dd6c63d5-17cc-5e42-a3b6-72f9aa180811" :answer/type :answer.type/math :answer/value "4{b}_{4}-{d}_{4}" :db/ensure [:answer/validate]} {:db/id "answer-4555140a-612c-5656-9db2-e93a5e1d92c5" :answer/id #uuid "4555140a-612c-5656-9db2-e93a5e1d92c5" :answer/type :answer.type/math :answer/value "4{c}_{0}-{d}_{0}" :db/ensure [:answer/validate]} {:db/id "question-86928bbe-ce4d-5454-a36f-1b092e7b6f03" :question/id #uuid "86928bbe-ce4d-5454-a36f-1b092e7b6f03" :question/math-academy-id "q-340761" :question/problem "$$\n\\begin{aligned}f(x) & ∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx) \\\\ g(x) & ∼\\frac{{c}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{c}_{n}\\operatorname{cos}⁡(nx)+{d}_{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nLet $f(x)$ and $g(x)$ be $2\\pi $-periodic extensions of some functions from $x\\in [-\\pi ,\\pi )$ to $x\\in R$ with the Fourier series shown above. What is the constant Fourier coefficient of  $3f(x)+6g(x)?$" :question/worked-solution "Let $f(x)$ and $g(x)$ be $2\\pi $-periodic functions with Fourier series\n\n$$\n\\begin{aligned}f(x) & ∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)), \\\\ g(x) & ∼\\frac{{c}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({c}_{n}\\operatorname{cos}⁡(nx)+{d}_{n}\\operatorname{sin}⁡(nx)).\\end{aligned}\n$$\n\nThen for any constants $\\alpha $ and $\\beta $,\n\n$$\n\\alpha f(x)+\\beta g(x)∼\\frac{\\alpha {a}_{0}+\\beta {c}_{0}}{2}+{\\sum }_{n=1}^{\\infty }((\\alpha {a}_{n}+\\beta {c}_{n})\\operatorname{cos}⁡(nx)+(\\alpha {b}_{n}+\\beta {d}_{n})\\operatorname{sin}⁡(nx)).\n$$\n\nUsing the linearity property of Fourier series, the corresponding Fourier coefficients of $3f(x)+6g(x)$ are\n\n- $3{a}_{0}+6{c}_{0}$ for the constant coefficient,\n\n- $3{a}_{n}+6{c}_{n},$ $n\\ge 1$ for the cosine coefficients, and\n\n- $3{b}_{n}+6{d}_{n},$ $n\\ge 1$ for the sine coefficients.\n\nTherefore, the constant Fourier coefficient of $3f(x)+6g(x)$ is\n\n$$\n3{a}_{0}+6{c}_{0}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-072fde8c-0e45-59a5-824c-8a998014f503"] :db/ensure [:question/validate]} {:db/id "answer-field-072fde8c-0e45-59a5-824c-8a998014f503" :answer-field/id #uuid "072fde8c-0e45-59a5-824c-8a998014f503" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8a422a7