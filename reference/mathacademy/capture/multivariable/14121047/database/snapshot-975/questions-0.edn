"}] [{:db/id #edb/ref 17592186229718 :knowledge-point/_questions [{:db/id #edb/ref 17592186229175 :knowledge-point/id #uuid "532a73e6-e026-57c9-9bad-57cd2f75b6df" :knowledge-point/title "Parity Recognition and Series Type"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78347118-a192-5bee-b58d-939c8d82936e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "sine terms" :db/id #edb/ref 17592186417636} {:answer/id #uuid "7d8d0820-748e-505c-93fc-afe0435abb62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "cosine terms" :db/id #edb/ref 17592186417637}] :answer-field/correct {:answer/id #uuid "78347118-a192-5bee-b58d-939c8d82936e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "sine terms" :db/id #edb/ref 17592186417636} :answer-field/id #uuid "144e708f-bce4-5aa2-882e-202cff09afa5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186417666} {:answer-field/choices [{:answer/id #uuid "5b3b4336-5434-516f-a61d-246576df1308" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186417631} {:answer/id #uuid "aa7e0c03-665a-5c7b-a616-a0d332659fe8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186417648}] :answer-field/correct {:answer/id #uuid "5b3b4336-5434-516f-a61d-246576df1308" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186417631} :answer-field/id #uuid "31c42783-a0bc-5aa4-9ecd-25d720e96f18" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186417667}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fef4d418-70a2-5cc6-ada2-db46d9d0aa32" :question/math-academy-id "q-338656" :question/problem "Consider the function $f(x)=-5{x}^{4}+2{x}^{2}$ on $x\\in [-\\pi ,\\pi ].$ Select the correct options below.\n\n$\\,$\nThe function $f(x)$ is\n{{field-1}}.\n\n$\\,$\nConsequently, the {{field-2}}\nin the corresponding Fourier series of $f(x)$ must be zero." :question/worked-solution "To check whether $f$ is even or odd, we compare $f(-x)$ and $f(x):$\n\n$$\n\\begin{aligned}f(-x) & =-5(-x)^{4}+2(-x)^{2} \\\\  & =-5{x}^{4}+2{x}^{2} \\\\  & =f(x).\\end{aligned}\n$$\n\nSince $f(-x)=f(x),$ we have that $f$ is even.\n\nFor the Fourier series on $[-\\pi ,\\pi ],$ the sine coefficients are given by\n\n$$\n{b}_{n}=\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nHere, $f(x)$ is even and $\\operatorname{sin}⁡(nx)$ is odd, so $f(x)\\operatorname{sin}⁡(nx)$ is odd.\n\nNow, the integral of an odd function over $[-\\pi ,\\pi ]$ is $0.$ Thus, ${b}_{n}=0$ for all $n\\ge 1.$\n\nTherefore, the function $f(x)$ is $\\text{even}$ and the $\\text{sine terms}$ in its Fourier series must be zero."}] [{:db/id #edb/ref 17592186417677 :knowledge-point/_questions [{:db/id #edb/ref 17592186229173 :knowledge-point/id #uuid "eb295d6c-62fe-59bc-a139-49785ac98f1f" :knowledge-point/title "Using Linearity of Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4555140a-612c-5656-9db2-e93a5e1d92c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{c}_{0}-{d}_{0}" :db/id #edb/ref 17592186417625} {:answer/id #uuid "a502f40b-fd58-5f47-b90f-59c017ccedad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}_{0}-{d}_{0}" :db/id #edb/ref 17592186417645} {:answer/id #uuid "db477f8b-1f63-5509-ab25-71148ea202f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}_{4}-{b}_{4}" :db/id #edb/ref 17592186417653} {:answer/id #uuid 