{a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)), \\\\ g(x) & ∼\\frac{{c}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({c}_{n}\\operatorname{cos}⁡(nx)+{d}_{n}\\operatorname{sin}⁡(nx)).\\end{aligned}\n$$\n\nThen for any constants $\\alpha $ and $\\beta $,\n\n$$\n\\alpha f(x)+\\beta g(x)∼\\frac{\\alpha {a}_{0}+\\beta {c}_{0}}{2}+{\\sum }_{n=1}^{\\infty }((\\alpha {a}_{n}+\\beta {c}_{n})\\operatorname{cos}⁡(nx)+(\\alpha {b}_{n}+\\beta {d}_{n})\\operatorname{sin}⁡(nx)).\n$$\n\nUsing the linearity property of Fourier series, the corresponding Fourier coefficients of $3f(x)+6g(x)$ are\n\n- $3{a}_{0}+6{c}_{0}$ for the constant coefficient,\n\n- $3{a}_{n}+6{c}_{n},$ $n\\ge 1$ for the cosine coefficients, and\n\n- $3{b}_{n}+6{d}_{n},$ $n\\ge 1$ for the sine coefficients.\n\nTherefore, the constant Fourier coefficient of $3f(x)+6g(x)$ is\n\n$$\n3{a}_{0}+6{c}_{0}.\n$$"}] [{:db/id #edb/ref 17592186417678 :knowledge-point/_questions [{:db/id #edb/ref 17592186229173 :knowledge-point/id #uuid "eb295d6c-62fe-59bc-a139-49785ac98f1f" :knowledge-point/title "Using Linearity of Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "095dc636-bcdf-5389-b4b4-076c56cdab36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{b}_{5}-{d}_{5}" :db/id #edb/ref 17592186417618} {:answer/id #uuid "0de381fb-0d5d-57af-ad50-d5c06db2cc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}_{5}-{c}_{5}" :db/id #edb/ref 17592186417619} {:answer/id #uuid "49155e74-8a92-55f9-995f-33bf99cd888c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{a}_{0}-{c}_{0}" :db/id #edb/ref 17592186417627} {:answer/id #uuid "61203ab7-ae3c-52ad-81b4-3fedd3b1f4c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{b}_{5}-{c}_{5}" :db/id #edb/ref 17592186417632} {:answer/id #uuid "aa52fabc-721d-5494-a7ec-39f7def4aa2e" :answer/type