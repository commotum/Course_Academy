D\" x=\"2853\" y=\"-1\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E1-MJMATHI-6E\" x=\"4782\" y=\"1665\"></use>\n <use xlink:href=\"#E1-MJMAIN-3D\" x=\"4183\" y=\"0\"></use>\n<g transform=\"translate(5240,0)\">\n <use xlink:href=\"#E1-MJSZ3-5B\"></use>\n<g transform=\"translate(695,0)\">\n<g transform=\"translate(-11,0)\">\n <use xlink:href=\"#E1-MJMAIN-31\" x=\"300\" y=\"650\"></use>\n<g transform=\"translate(0,-750)\">\n <use xlink:href=\"#E1-MJMAIN-37\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMATHI-6E\" x=\"500\" y=\"0\"></use>\n</g>\n</g>\n<g transform=\"translate(2090,0)\">\n <use xlink:href=\"#E1-MJMAIN-30\" x=\"0\" y=\"650\"></use>\n <use xlink:href=\"#E1-MJMAIN-31\" x=\"0\" y=\"-750\"></use>\n</g>\n</g>\n <use xlink:href=\"#E1-MJSZ3-5D\" x=\"3453\" y=\"-1\"></use>\n</g>\n<g transform=\"translate(10388,0)\">\n <use xlink:href=\"#E1-MJMAIN-66\"></use>\n <use xlink:href=\"#E1-MJMAIN-6F\" x=\"306\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-72\" x=\"807\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-61\" x=\"1449\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-6C\" x=\"1950\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-6C\" x=\"2228\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E1-MJMATHI-6E\" x=\"13312\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJMAIN-2208\" x=\"14190\" y=\"0\"></use>\n <use xlink:href=\"#E1-MJAMS-4E\" x=\"15136\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>What are the missing entries in the proof template below?</p>\n<blockquote>\n<p><strong>Base Case</strong>: We first prove that our statement is true for the base case <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"6.302ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 2713.6 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-2-Title\">\n<title id=\"MathJax-SVG-2-Title\">n=1.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E2-MJMAT