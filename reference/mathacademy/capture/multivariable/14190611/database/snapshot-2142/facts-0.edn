#{[17592186045463 #edb/ref 10 :activity.type/lesson #edb/ref 17592186045416] [17592186045493 #edb/ref 10 :answer-field.type/radio #edb/ref 17592186045416] [17592186045498 #edb/ref 10 :answer.type/math #edb/ref 17592186045416] [17592186046644 #edb/ref 1003 #edb/ref 17592186046645 #edb/ref 17592186045417] [17592186046644 #edb/ref 1003 #edb/ref 17592186046669 #edb/ref 17592186045417] [17592186046644 #edb/ref 1003 #edb/ref 17592186046673 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045606 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045607 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045608 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045609 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045610 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045611 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045612 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045613 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045614 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045615 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045616 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045617 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045618 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045619 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045620 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045621 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045622 #edb/ref 17592186045417] [17592186046644 #edb/ref 1005 #edb/ref 17592186046774 #edb/ref 17592186045417] [17592186046644 #edb/ref 1005 #edb/ref 17592186046802 #edb/ref 17592186045417] [17592186046644 #edb/ref 1005 #edb/r