86045417] [17592186538923 #edb/ref 1079 #uuid "fe2698ca-7e20-5c2e-95df-9f69c77c58a2" #edb/ref 17592186045417] [17592186538926 #edb/ref 1068 #edb/ref 17592186538853 #edb/ref 17592186045417] [17592186538926 #edb/ref 1069 "q-97750" #edb/ref 17592186045417] [17592186538926 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186538926 #edb/ref 1071 "Calculate $\\int \\frac{\\text{d}x}{(x+1)\\sqrt{9-(3x+3)^{2}}}.$" #edb/ref 17592186045417] [17592186538926 #edb/ref 1072 #uuid "02d58382-8176-5a03-b109-135b67345884" #edb/ref 17592186045417] [17592186538926 #edb/ref 1074 "First, we note that\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}x}{(x+1)\\sqrt{9-(3x+3)^{2}}} & =\\int \\frac{\\text{d}x}{(x+1)\\sqrt{9-9{(x+1)}^{2}}}=\\frac{1}{3}\\int \\frac{1}{(x+1)\\sqrt{1-(x+1)^{2}}}\\text{d}x.\\end{aligned}\n$$\n\nLet $u=x+1.$ Then, we have \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{3}\\int \\frac{1}{(x+1)\\sqrt{1-(x+1)^{2}}}\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot \\text{d}u \\\\  & =-\\frac{1}{3}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{3}\\operatorname{arsech}⁡(x+1)+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186538952 #edb/ref 1068 #edb/ref 17592186538904 #edb/ref 17592186045417] [17592186538952 #edb/ref 1069 "q-97907" #edb/ref 17592186045417] [17592186538952 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538952 #edb/ref 1071 "$\\int \\frac{1}{6x-{x}^{2}-5}\\text{d}x=$" #edb/ref 17592186045417] [17592186538952 #edb/ref 1072 #uuid "42211531-3fd4-52dd-adb0-73d677948d1f" #edb/ref 17592186045417] [17592186538952 #edb/ref 1074 "First, we complete the square for the denominator:\n\n$$\n\\begin{aligned}6x-{x}^{2}-5 & =-({x}^{2}-6x+5) \\\\  & =-({x}^{2}-2\\cdot 3x+{3}^{2}-{3}^{2}+5) \\\\  & =-((x-3)^{2}-4) \\\\  & =4-(x-3)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the denominator of our integral, we get\n\n$$\n\\int \\frac{1}{6x-{x}^{2}-5}\\text{d}x=\\int \\frac{1}{4-(x-3)^{2}}\\text{d}x=\\frac{1}{4}\\int \\frac{1}{1-{(\\frac{1}{2}(x-3))}^{2}}\\text{d}x.\n$$\n\nLet $u=\\frac{1}{2}(x-3).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int \\frac{1}{1-{(\\frac{1}{2}(x-3))}^{2}}\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1-{u}^{2}}\\cdot 2\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{2}\\cdot \\operatorname{arcoth}⁡(\\frac{1}{2}(x-3))+C \\\\  & =\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x-3}{2})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x-3}{2}|>1.$" #edb/ref 17592186045417] [17592186538953 #edb/ref 1068 #edb/ref 17592186538923 #edb/ref 17592186045417] [17592186538953 #edb/ref 1069 "q-97313" #edb/ref 17592186045417] [17592186538953 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538953 #edb/ref 1071 "Calculate $\\int \\frac{\\text{d}x}{(6x-4)\\sqrt{9-(3x-2)^{2}}}.$" #edb/ref 17592186045417] [17592186538953 #edb/ref 1072 #uuid "46c80522-dca7-526c-a225-6cc3d9755240" #edb/ref 17592186045417] [17592186538953 #edb/ref 1074 "First, we note that\n\n$$\n\\int \\frac{\\text{d}x}{(6x-4)\\sqrt{9-(3x-2)^{2}}}=\\int \\frac{\\text{d}x}{6(x-\\frac{2}{3})\\sqrt{9-9{(x-\\frac{2}{3})}^{2}}}=\\frac{1}{18}\\int \\frac{1}{(x-\\frac{2}{3})\\sqrt{1-{(x-\\frac{2}{3})}^{2}}}\\text{d}x.\n$$\n\nLet $u=x-\\frac{2}{3}.$ Then, we have \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{18}\\int \\frac{1}{(x-\\frac{2}{3})\\sqrt{1-{(x-\\frac{2}{3})}^{2}}}\\text{d}x & =\\frac{1}{18}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\text{d}u \\\\  & =-\\frac{1}{18}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{18}\\operatorname{arsech}⁡(x-\\frac{2}{3})+C \\\\  & =-\\frac{1}{18}\\operatorname{arsech}⁡(\\frac{3x-2}{3})+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186538968 #edb/ref 1068 #edb/ref 17592186538845 #edb/ref 17592186045417] [17592186538968 #edb/ref 1069 "q-97778" #edb/ref 17592186045417] [17592186538968 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538968 #edb/ref 1071 "$\\int \\frac{1}{(3x-15)\\sqrt{10x-{x}^{2}-24}}\\text{d}x=$" #edb/ref 17592186045417] [17592186538968 #edb/ref 1072 #uuid "6858ad14-b7bc-531f-aa86-afb1603436a5" #edb/ref 17592186045417] [17592186538968 #edb/ref 1074 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}+10x-24 & =-({x}^{2}-10x+24) \\\\  & =-({x}^{2}-2\\cdot 5x+{5}^{2}-{5}^{2}+24) \\\\  & =-((x-5)^{2}-1) \\\\  & =1-(x-5)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\frac{1}{(3x-15)\\sqrt{10x-{x}^{2}-24}}\\text{d}x=\\frac{1}{3}\\int \\frac{1}{(x-5)\\sqrt{1-(x-5)^{2}}}\\,\\text{d}x.\n$$\n\nLet $u=x-5.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{(3x-15)\\sqrt{10x-{x}^{2}-24}}\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{(x-5)\\sqrt{1-(x-5)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\text{d}u \\\\  & =-\\frac{1}{3}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{3}\\operatorname{arsech}⁡(x-5)+C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186538970 #edb/ref 1068 #edb/ref 17592186538828 #edb/ref 17592186045417] [17592186538970 #edb/ref 1069 "q-97901" #edb/ref 17592186045417] [17592186538970 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538970 #edb/ref 1071 "$\\int -\\frac{6}{|x+3|\\sqrt{{x}^{2}+6x+13}}\\text{d}x=$" #edb/ref 17592186045417] [17592186538970 #edb/ref 1072 #uuid "69f3a20c-d1a0-5eb2-90e0-cb5356408eda" #edb/ref 17592186045417] [17592186538970 #edb/ref 1074 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}+6x+13 & ={x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}+13 \\\\  & =(x+3)^{2}+4\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int -\\frac{6}{|x+3|\\sqrt{{x}^{2}+6x+13}}\\,\\text{d}x & =-\\int \\frac{6}{|x+3|\\sqrt{4+(x+3)^{2}}}\\,\\text{d}x \\\\  & =-\\int \\frac{6}{2|\\frac{x+3}{2}|\\sqrt{4+4{(\\frac{x+3}{2})}^{2}}}\\,\\text{d}x \\\\  & =-\\frac{3}{2}\\int \\frac{1}{|\\frac{x+3}{2}|\\sqrt{1+{(\\frac{x+3}{2})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=\\frac{x+3}{2}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}-\\frac{3}{2}\\int \\frac{1}{|\\frac{x+3}{2}|\\sqrt{1+{(\\frac{x+3}{2})}^{2}}}\\text{d}x & =-\\frac{3}{2}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\cdot 2\\,\\text{d}u \\\\  & =-3\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =3\\operatorname{arcsch}⁡u+C \\\\  & =3\\operatorname{arcsch}⁡(\\frac{x+3}{2})+C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186538975 #edb/ref 1068 #edb/ref 17592186538844 #edb/ref 17592186045417] [17592186538975 #edb/ref 1069 "q-97766" #edb/ref 17592186045417] [17592186538975 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538975 #edb/ref 1071 "$\\int \\frac{1}{(x+1)\\sqrt{-4{x}^{2}-8x}}\\text{d}x=$" #edb/ref 17592186045417] [17592186538975 #edb/ref 1072 #uuid "726516a6-793d-5373-8298-c27b8c843f27" #edb/ref 17592186045417] [17592186538975 #edb/ref 1074 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-4{x}^{2}-8x & =-4({x}^{2}+2x) \\\\  & =-4({x}^{2}+2\\cdot x+{1}^{2}-{1}^{2}) \\\\  & =-4[(x+1)^{2}-1] \\\\  & =4[1-(x+1)^{2}]\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\frac{1}{(x+1)\\sqrt{-4{x}^{2}-8x}}\\text{d}x=\\int \\frac{1}{(x+1)\\sqrt{4[1-(x+1)^{2}]}}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{(x+1)\\sqrt{1-(x+1)^{2}}}\\,\\text{d}x.\n$$\n\nLet $u=x+1.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{(x+1)\\sqrt{-4{x}^{2}-8x}}\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{(x+1)\\sqrt{1-(x+1)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{arsech}⁡(x+1)+C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186538980 #edb/ref 1068 #edb/ref 17592186538875 #edb/ref 17592186045417] [17592186538980 #edb/ref 1069 "q-97781" #edb/ref 17592186045417] [17592186538980 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538980 #edb/ref 1071 "$\\int \\frac{3}{|3x+1|\\sqrt{9{x}^{2}+6x+10}}\\text{d}x=$" #edb/ref 17592186045417] [17592186538980 #edb/ref 1072 #uuid "87c6c320-8ad0-5a7a-8ea7-78e763a7875c" #edb/ref 17592186045417] [17592186538980 #edb/ref 1074 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}9{x}^{2}+6x+10 & =9({x}^{2}+\\frac{2}{3}x+\\frac{10}{9}) \\\\  & =9({x}^{2}+2\\cdot \\frac{1}{3}x+{(\\frac{1}{3})}^{2}-{(\\frac{1}{3})}^{2}+\\frac{10}{9}) \\\\  & =9[{(x+\\frac{1}{3})}^{2}+1]\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{3}{|3x+1|\\sqrt{9{x}^{2}+6x+10}}\\,\\text{d}x=\\int \\frac{1}{|x+\\frac{1}{3}|\\sqrt{9[1+{(x+\\frac{1}{3})}^{2}]}}\\,\\text{d}x=\\frac{1}{3}\\int \\frac{1}{|x+\\frac{1}{3}|\\sqrt{1+{(x+\\frac{1}{3})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=x+\\frac{1}{3}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{1}{3}\\int \\frac{1}{|x+\\frac{1}{3}|\\sqrt{1+{(x+\\frac{1}{3})}^{2}}}\\,\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\operatorname{arcsch}⁡u+C \\\\  & =-\\frac{1}{3}\\operatorname{arcsch}⁡(x+\\frac{1}{3})+C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186538982 #edb/ref 1068 #edb/ref 17592186538854 #edb/ref 17592186045417] [17592186538982 #edb/ref 1069 "q-98005" #edb/ref 17592186045417] [17592186538982 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186538982 #edb/ref 1071 "$\\int \\frac{1}{12+4x-{x}^{2}}\\text{d}x=$" #edb/ref 17592186045417] [17592186538982 #edb/ref 1072 #uuid "8dc0f52e-b98b-54ec-bcf4-1fa4702113db" #edb/ref 17592186045417] [17592186538982 #edb/ref 1074 "First, we complete the square for the denominator:\n\n$$\n\\begin{aligned}12+4x-{x}^{2} & =-({x}^{2}-4x-12) \\\\  & =-({x}^{2}-2\\cdot 2x+{2}^{2}-{2}^{2}-12) \\\\  & =-((x-2)^{2}-16) \\\\  & =16-(x-2)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the denominator of our integral, we get\n\n$$\n\\int \\frac{1}{12+4x-{x}^{2}}\\text{d}x=\\int \\frac{1}{16-(x-2)^{2}}\\text{d}x=\\frac{1}{16}\\int \\frac{1}{1-{(\\frac{1}{4}(x-2))}^{2}}\\text{d}x.\n$$\n\nLet $u=\\frac{1}{4}(x-2).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4}\\,⟹\\,\\text{d}x=4\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{16}\\int \\frac{1}{1-{(\\frac{1}{4}(x-2))}^{2}}\\text{d}x & =\\frac{1}{16}\\int \\frac{1}{1-{u}^{2}}\\cdot 4\\,\\text{d}u \\\\  & =\\frac{1}{4}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{4}\\cdot \\operatorname{arcoth}⁡(\\frac{1}{4}(x-2))+C \\\\  & =\\frac{1}{4}\\operatorname{arcoth}⁡(\\frac{x-2}{4})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x-2}{4}|>1.$" #edb/ref 17592186045417] [17592186539016 #edb/ref 1068 #edb/ref 17592186538876 #edb/ref 17592186045417] [17592186539016 #edb/ref 1069 "q-97758" #edb/ref 17592186045417] [17592186539016 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186539016 #edb/ref 1071 "Calculate $\\int \\frac{1}{4-(x+3)^{2}}\\text{d}x.$" #edb/ref 17592186045417] [17592186539016 #edb/ref 1072 #uuid "dbcc5371-79bd-5123-b706-5a10821a5d21" #edb/ref 17592186045417] [17592186539016 #edb/ref 1074 "First, we note that\n\n$$\n\\int \\frac{1}{4-(x+3)^{2}}\\text{d}x=\\int \\frac{1}{4-4{(\\frac{x+3}{2})}^{2}}\\text{d}x=\\frac{1}{4}\\int \\frac{1}{1-{(\\frac{x+3}{2})}^{2}}\\text{d}x.\n$$\n\nLet $u=\\frac{x+3}{2}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int \\frac{1}{1-{(\\frac{x+3}{2})}^{2}}\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1-{u}^{2}}\\cdot 2\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x+3}{2})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x+3}{2}|>1.$" #edb/ref 17592186045417] [17592186539017 #edb/ref 1068 #edb/ref 17592186538810 #edb/ref 17592186045417] [17592186539017 #edb/ref 1069 "q-98008" #edb/ref 17592186045417] [17592186539017 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186539017 #edb/ref 1071 "$\\int \\frac{1}{12x-{x}^{2}-33}\\text{d}x=$" #edb/ref 17592186045417] [17592186539017 #edb/ref 1072 #uuid "dc07885c-59ca-5761-a1b0-43a8e8cb6e2b" #edb/ref 17592186045417] [17592186539017 #edb/ref 1074 "First, we complete the square for the denominator:\n\n$$\n\\begin{aligned}12x-{x}^{2}-33 & =-({x}^{2}-12x+33) \\\\  & =-({x}^{2}-2\\cdot 6x+{6}^{2}-{6}^{2}+33) \\\\  & =-((x-6)^{2}-3) \\\\  & =3-(x-6)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the denominator of our integral, we get\n\n$$\n\\int \\frac{1}{12x-{x}^{2}-33}\\text{d}x=\\int \\frac{1}{3-(x-6)^{2}}\\text{d}x=\\frac{1}{3}\\int \\frac{1}{1-{(\\frac{1}{\\sqrt{3}}(x-6))}^{2}}\\text{d}x.\n$$\n\nLet $u=\\frac{1}{\\sqrt{3}}(x-6).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{3}}\\,⟹\\,\\text{d}x=\\sqrt{3}\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{3}\\int \\frac{1}{1-{(\\frac{1}{\\sqrt{3}}(x-6))}^{2}}\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{1-{u}^{2}}\\cdot \\sqrt{3}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{3}}{3}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{3}}{3}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{\\sqrt{3}}{3}\\cdot \\operatorname{arcoth}⁡(\\frac{1}{\\sqrt{3}}(x-6))+C \\\\  & =\\frac{\\sqrt{3}}{3}\\operatorname{arcoth}⁡(\\frac{x-6}{\\sqrt{3}})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x-6}{\\sqrt{3}}|>1.$" #edb/ref 17592186045417] [17592186539018 #edb/ref 1068 #edb/ref 17592186538907 #edb/ref 17592186045417] [17592186539018 #edb/ref 1069 "q-97762" #edb/ref 17592186045417] [17592186539018 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186539018 #edb/ref 1071 "$\\int \\frac{1}{(x-2)\\sqrt{4x-{x}^{2}-3}}\\text{d}x=$" #edb/ref 17592186045417] [17592186539018 #edb/ref 1072 #uuid "e0181c3f-486e-569d-aaa1-064715b86f7e" #edb/ref 17592186045417] [17592186539018 #edb/ref 1074 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}4x-{x}^{2}-3 & =-({x}^{2}-4x+3) \\\\  & =-({x}^{2}-2\\cdot 2x+{2}^{2}-{2}^{2}+3) \\\\  & =-((x-2)^{2}-1) \\\\  & =1-(x-2)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\frac{1}{(x-2)\\sqrt{4x-{x}^{2}-3}}\\text{d}x=\\int \\frac{1}{(x-2)\\sqrt{1-(x-2)^{2}}}\\,\\text{d}x.\n$$\n\nLet $u=x-2.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{(x-2)\\sqrt{4x-{x}^{2}-3}}\\text{d}x & =\\int \\frac{1}{(x-2)\\sqrt{1-(x-2)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\text{d}u \\\\  & =-\\operatorname{arsech}⁡u+C \\\\  & =-\\operatorname{arsech}⁡(x-2)+C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186539028 #edb/ref 1068 #edb/ref 17592186538852 #edb/ref 17592186045417] [17592186539028 #edb/ref 1069 "q-97780" #edb/ref 17592186045417] [17592186539028 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186539028 #edb/ref 1071 "$\\int \\frac{4}{|x+1|\\sqrt{{x}^{2}+2x+5}}\\text{d}x=$" #edb/ref 17592186045417] [17592186539028 #edb/ref 1072 #uuid "fa581feb-4c4c-5d1e-ad5b-763e0315938f" #edb/ref 17592186045417] [17592186539028 #edb/ref 1074 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}+2x+5 & ={x}^{2}+2\\cdot x+{1}^{2}-{1}^{2}+5 \\\\  & =(x+1)^{2}+4\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{4}{|x+1|\\sqrt{{x}^{2}+2x+5}}\\,\\text{d}x & =\\int \\frac{4}{|x+1|\\sqrt{4+(x+1)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{2}{|\\frac{x+1}{2}|\\sqrt{4+4{(\\frac{x+1}{2})}^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|\\frac{x+1}{2}|\\sqrt{1+{(\\frac{x+1}{2})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=\\frac{x+1}{2}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|\\frac{x+1}{2}|\\sqrt{1+{(\\frac{x+1}{2})}^{2}}}\\text{d}x & =\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\cdot 2\\,\\text{d}u \\\\  & =2\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-2\\operatorname{arcsch}⁡u+C \\\\  & =-2\\operatorname{arcsch}⁡(\\frac{x+1}{2})+C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417]}
