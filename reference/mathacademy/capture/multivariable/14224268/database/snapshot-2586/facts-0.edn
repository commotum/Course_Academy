86045417] [17592186167433 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186167433 #edb/ref 1071 "Calculate $\\int \\frac{\\text{d}x}{(x-1)\\sqrt{4-(2x-2)^{2}}}.$" #edb/ref 17592186045417] [17592186167433 #edb/ref 1072 #uuid "708d136b-efc4-5e95-bc0c-835335334b0a" #edb/ref 17592186045417] [17592186167433 #edb/ref 1074 "First, we note that\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}x}{(x-1)\\sqrt{4-(2x-2)^{2}}} & =\\int \\frac{\\text{d}x}{(x-1)\\sqrt{4-4{(x-1)}^{2}}}=\\frac{1}{2}\\int \\frac{1}{(x-1)\\sqrt{1-(x-1)^{2}}}\\text{d}x.\\end{aligned}\n$$\n\nLet $u=x-1.$ Then, we have \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}\\int \\frac{1}{(x-1)\\sqrt{1-(x-1)^{2}}}\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot \\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{arsech}⁡(x-1)+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186167434 #edb/ref 1068 #edb/ref 17592186165812 #edb/ref 17592186045417] [17592186167434 #edb/ref 1069 "q-95975" #edb/ref 17592186045417] [17592186167434 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186167434 #edb/ref 1071 "Calculate $\\int \\frac{\\text{d}x}{|6x-2|\\sqrt{9+(3x-1)^{2}}}.$" #edb/ref 17592186045417] [17592186167434 #edb/ref 1072 #uuid "277cde94-a375-546d-bd1f-19d53d382abd" #edb/ref 17592186045417] [17592186167434 #edb/ref 1074 "First, we note that\n\n$$\n\\int \\frac{\\text{d}x}{|6x-2|\\sqrt{9+(3x-1)^{2}}}=\\int \\frac{\\text{d}x}{6|x-\\frac{1}{3}|\\sqrt{9+9{(x-\\frac{1}{3})}^{2}}}=\\frac{1}{18}\\int \\frac{1}{|x-\\frac{1}{3}|\\sqrt{1+{(x-\\frac{1}{3})}^{2}}}\\text{d}x.\n$$\n\nLet $u=x-\\frac{1}{3}.$ Then, we have \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{18}\\int \\frac{1}{|x-\\frac{1}{3}|\\sqrt{1+{(x-\\frac{1}{3})}^{2}}}\\text{d}x & =\\frac{1}{18}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\text{d}u \\\\  & =-\\frac{1}{18}\\operatorname{arcsch}⁡u+C \\\\  & =-\\frac{1}{18}\\operatorname{arcsch}⁡(x-\\frac{1}{3})+C \\\\  & =-\\frac{1}{18}\\operatorname{arcsch}⁡(\\frac{3x-1}{3})+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186167435 #edb/ref 1068 #edb/ref 17592186165818 #edb/ref 17592186045417] [17592186167435 #edb/ref 1069 "q-95976" #edb/ref 17592186045417] [17592186167435 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186167435 #edb/ref 1071 "$\\int \\frac{1}{(x+2)\\sqrt{-{x}^{2}-4x-3}}\\text{d}x=$" #edb/ref 17592186045417] [17592186167435 #edb/ref 1072 #uuid "8c392298-33d9-51cd-a095-a21fc53f8649" #edb/ref 17592186045417] [17592186167435 #edb/ref 1074 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-4x-3 & =-({x}^{2}+4x+3) \\\\  & =-({x}^{2}+2\\cdot 2x+{2}^{2}-{2}^{2}+3) \\\\  & =-((x+2)^{2}-1) \\\\  & =1-(x+2)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\frac{1}{(x+2)\\sqrt{-{x}^{2}-4x-3}}\\text{d}x=\\int \\frac{1}{(x+2)\\sqrt{1-(x+2)^{2}}}\\,\\text{d}x.\n$$\n\nLet $u=x+2.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{(x+2)\\sqrt{-{x}^{2}-4x-3}}\\text{d}x & =\\int \\frac{1}{(x+2)\\sqrt{1-(x+2)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\text{d}u \\\\  & =-\\operatorname{arsech}⁡u+C \\\\  & =-\\operatorname{arsech}⁡(x+2)+C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186167436 #edb/ref 1068 #edb/ref 17592186165824 #edb/ref 17592186045417] [17592186167436 #edb/ref 1069 "q-95977" #edb/ref 17592186045417] [17592186167436 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186167436 #edb/ref 1071 "$\\int \\frac{2}{|4x-8|\\sqrt{{x}^{2}-4x+5}}\\text{d}x=$" #edb/ref 17592186045417] [17592186167436 #edb/ref 1072 #uuid "2e1c2ab8-7185-5af4-9bb5-d9487e392b5e" #edb/ref 17592186045417] [17592186167436 #edb/ref 1074 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-4x+5 & ={x}^{2}-2\\cdot 2x+{2}^{2}-{2}^{2}+5 \\\\  & =(x-2)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\frac{2}{|4x-8|\\sqrt{{x}^{2}-4x+5}}\\,\\text{d}x=\\int \\frac{2}{4|x-2|\\sqrt{1+(x-2)^{2}}}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{|x-2|\\sqrt{1+(x-2)^{2}}}\\,\\text{d}x.\n$$\n\nLet $u=x-2.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{1}{2}\\int \\frac{1}{|x-2|\\sqrt{1+(x-2)^{2}}}\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡(x-2)+C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186167437 #edb/ref 1068 #edb/ref 17592186165830 #edb/ref 17592186045417] [17592186167437 #edb/ref 1069 "q-95978" #edb/ref 17592186045417] [17592186167437 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186167437 #edb/ref 1071 "Calculate $\\int \\frac{1}{9-(x+4)^{2}}\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186167437 #edb/ref 1072 #uuid "2d619ef2-7b28-5e2f-b9a5-764feebd0f07" #edb/ref 17592186045417] [17592186167437 #edb/ref 1074 "First, we note that\n\n$$\n\\int \\frac{1}{9-(x+4)^{2}}\\,\\text{d}x=\\int \\frac{1}{9-9(\\frac{1}{9}(x+4)^{2})}\\,\\text{d}x=\\frac{1}{9}\\int \\frac{1}{1-{(\\frac{1}{3}(x+4))}^{2}}\\,\\text{d}x.\n$$\n\nLet $u=\\frac{1}{3}(x+4).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{9}\\int \\frac{1}{1-{(\\frac{1}{3}(x+4))}^{2}}\\,\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{1-{u}^{2}}\\,\\cdot 3\\,\\text{d}u \\\\  & =\\frac{3}{9}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{3}\\operatorname{arcoth}⁡(\\frac{x+4}{3})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x+4}{3}|>1.$" #edb/ref 17592186045417] [17592186167438 #edb/ref 1068 #edb/ref 17592186165836 #edb/ref 17592186045417] [17592186167438 #edb/ref 1069 "q-95979" #edb/ref 17592186045417] [17592186167438 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186167438 #edb/ref 1071 "$\\int \\frac{1}{1-4x-{x}^{2}}\\text{d}x=$" #edb/ref 17592186045417] [17592186167438 #edb/ref 1072 #uuid "51eaef16-8f72-5d8b-80be-64ea8ef24070" #edb/ref 17592186045417] [17592186167438 #edb/ref 1074 "First, we complete the square for the denominator:\n\n$$\n\\begin{aligned}1-4x-{x}^{2} & =-({x}^{2}+4x-1) \\\\  & =-({x}^{2}+2\\cdot 2x+{2}^{2}-{2}^{2}-1) \\\\  & =-((x+2)^{2}-5) \\\\  & =5-(x+2)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the denominator of our integral, we get\n\n$$\n\\int \\frac{1}{1-4x-{x}^{2}}\\text{d}x=\\int \\frac{1}{5-(x+2)^{2}}\\text{d}x=\\frac{1}{5}\\int \\frac{1}{1-{(\\frac{1}{\\sqrt{5}}(x+2))}^{2}}\\text{d}x.\n$$\n\nLet $u=\\frac{1}{\\sqrt{5}}(x+2).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{5}}\\,⟹\\,\\text{d}x=\\sqrt{5}\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{5}\\int \\frac{1}{1-{(\\frac{1}{\\sqrt{5}}(x+2))}^{2}}\\text{d}x & =\\frac{1}{5}\\int \\frac{1}{1-{u}^{2}}\\cdot \\sqrt{5}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{5}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{5}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{\\sqrt{5}}{5}\\cdot \\operatorname{arcoth}⁡(\\frac{1}{\\sqrt{5}}(x+2))+C \\\\  & =\\frac{\\sqrt{5}}{5}\\operatorname{arcoth}⁡(\\frac{x+2}{\\sqrt{5}})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x+2}{\\sqrt{5}}|>1.$" #edb/ref 17592186045417] [17592186167518 #edb/ref 1068 #edb/ref 17592186166316 #edb/ref 17592186045417] [17592186167518 #edb/ref 1069 "q-97776" #edb/ref 17592186045417] [17592186167518 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186167518 #edb/ref 1071 "$\\int \\frac{\\sqrt{5}}{(x-1)\\sqrt{4+2x-{x}^{2}}}\\text{d}x=$" #edb/ref 17592186045417] [17592186167518 #edb/ref 1072 #uuid "7347b447-f057-5855-9436-49c47183f8c6" #edb/ref 17592186045417] [17592186167518 #edb/ref 1074 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}+2x+4 & =-({x}^{2}-2x-4) \\\\  & =-({x}^{2}-2\\cdot x+{1}^{2}-{1}^{2}-4) \\\\  & =-((x-1)^{2}-5) \\\\  & =5-(x-1)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{5}}{(x-1)\\sqrt{4+2x-{x}^{2}}} & =\\int \\frac{\\sqrt{5}}{(x-1)\\sqrt{5-{(x-1)}^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{(\\frac{x-1}{\\sqrt{5}})\\sqrt{5-5{(\\frac{x-1}{\\sqrt{5}})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{5}}\\int \\frac{1}{(\\frac{x-1}{\\sqrt{5}})\\sqrt{1-{(\\frac{x-1}{\\sqrt{5}})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=\\frac{x-1}{\\sqrt{5}}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{5}}\\,⟹\\,\\text{d}x=\\sqrt{5}\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{\\sqrt{5}}{(x-1)\\sqrt{4+2x-{x}^{2}}}\\text{d}x & =\\frac{1}{\\sqrt{5}}\\int \\frac{1}{(\\frac{x-1}{\\sqrt{5}})\\sqrt{1-{(\\frac{x-1}{\\sqrt{5}})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{5}}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot \\sqrt{5}\\,\\text{d}u \\\\  & =\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =-\\operatorname{arsech}⁡u+C \\\\  & =-\\operatorname{arsech}⁡(\\frac{x-1}{\\sqrt{5}})+C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186167519 #edb/ref 1068 #edb/ref 17592186166322 #edb/ref 17592186045417] [17592186167519 #edb/ref 1069 "q-97903" #edb/ref 17592186045417] [17592186167519 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186167519 #edb/ref 1071 "$\\int \\frac{2}{|2x+1|\\sqrt{4{x}^{2}+4x+5}}\\text{d}x=$" #edb/ref 17592186045417] [17592186167519 #edb/ref 1072 #uuid "d0b115b9-4f73-5fd8-99ef-72eedb4e4a17" #edb/ref 17592186045417] [17592186167519 #edb/ref 1074 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}4{x}^{2}+4x+5 & =4({x}^{2}+x+\\frac{5}{4}) \\\\  & =4({x}^{2}+2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2}+\\frac{5}{4}) \\\\  & =4[{(x+\\frac{1}{2})}^{2}+1]\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{2}{|2x+1|\\sqrt{4{x}^{2}+4x+5}}\\,\\text{d}x=\\int \\frac{1}{|x+\\frac{1}{2}|\\sqrt{4[1+{(x+\\frac{1}{2})}^{2}]}}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{|x+\\frac{1}{2}|\\sqrt{1+{(x+\\frac{1}{2})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=x+\\frac{1}{2}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{1}{2}\\int \\frac{1}{|x+\\frac{1}{2}|\\sqrt{1+{(x+\\frac{1}{2})}^{2}}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{arcsch}⁡(x+\\frac{1}{2})+C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186167643 #edb/ref 1058 #edb/ref 17592186167645 #edb/ref 17592186045417] [17592186167643 #edb/ref 1061 31484 #edb/ref 17592186045417] [17592186167643 #edb/ref 1062 #uuid "99ea624f-69a6-5d1d-a35f-18894419a306" #edb/ref 17592186045417] [17592186167643 #edb/ref 1063 #edb/ref 17592186166806 #edb/ref 17592186045417] [17592186167644 #edb/ref 1058 #edb/ref 17592186167643 #edb/ref 17592186045417] [17592186167644 #edb/ref 1061 31485 #edb/ref 17592186045417] [17592186167644 #edb/ref 1062 #uuid "0f6c3062-9d6c-592d-a31f-5fb2ead310cd" #edb/ref 17592186045417] [17592186167644 #edb/ref 1063 #edb/ref 17592186166807 #edb/ref 17592186045417] [17592186167645 #edb/ref 1058 #edb/ref 17592186167646 #edb/ref 17592186045417] [17592186167645 #edb/ref 1061 31486 #edb/ref 17592186045417] [17592186167645 #edb/ref 1062 #uuid "60e05d0f-21d0-5754-8412-0060020c8e21" #edb/ref 17592186045417] [17592186167645 #edb/ref 1063 #edb/ref 17592186166808 #edb/ref 17592186045417] [17592186167646 #edb/ref 1061 31487 #edb/ref 17592186045417] [17592186167646 #edb/ref 1062 #uuid "754cf784-bf5d-5f7b-8c12-79b57d3e1f4b" #edb/ref 17592186045417] [17592186167646 #edb/ref 1063 #edb/ref 17592186166809 #edb/ref 17592186045417] [17592186167709 #edb/ref 1058 #edb/ref 17592186167644 #edb/ref 17592186045417] [17592186167709 #edb/ref 1061 32703 #edb/ref 17592186045417] [17592186167709 #edb/ref 1062 #uuid "98b81a6a-5fdd-53d9-a014-da6921adf68b" #edb/ref 17592186045417] [17592186167709 #edb/ref 1063 #edb/ref 17592186168099 #edb/ref 17592186045417] [17592186168099 #edb/ref 1064 "We can also complete the square to integrate hyperbolic *arcsecant*, *arccosecant*, and *arccotangent*.\n\nFor example, let's consider the integral\n\n$$\n\\int \\dfrac{1}{\\left(x+3\\right)\\sqrt{-x^2-6x}} \\textrm{d}x.\n$$\n\nAs it is, this integral doesn't resemble any of the basic integrals we have encountered so far. However, we can complete the square for the argument of the square root in the denominator, as follows:\n\n$$\n\\begin{aligned}-{x}^{2}-6x & =-({x}^{2}+6x) \\\\  & =-({x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}) \\\\  & =-((x+3)^{2}-9) \\\\  & =9-(x+3)^{2}\\end{aligned}\n$$\n\nIf we plug the above into our integral and collect a factor of $9$ under the square root, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x & =\\int \\frac{1}{(x+3)\\sqrt{9-(x+3)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{3(x+3)\\sqrt{1-{(\\frac{x+3}{3})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{(\\frac{x+3}{3})\\sqrt{1-{(\\frac{x+3}{3})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis now looks more familiar! Let $u = \\dfrac {x+3}{3}.$ Then\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{3}\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = 3\\,\\textrm{d}u.\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}\\int \\frac{1}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{(\\frac{x+3}{3})\\sqrt{1-{(\\frac{x+3}{3})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot (3\\,\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u.\\end{aligned}\n$$\n\nThis is a basic integral for an inverse reciprocal hyperbolic function, and we can solve it in one step:\n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u & =-\\frac{1}{3}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{3}\\operatorname{arsech}⁡(\\frac{x+3}{3})+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186168099 #edb/ref 1065 5218 #edb/ref 17592186045417] [17592186168099 #edb/ref 1066 #uuid "5f0c7466-a41d-5101-b125-8e6f68fba3ea" #edb/ref 17592186045417] [17592186168099 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186538234 #edb/ref 1080 "-\\sqrt{5}\\operatorname{arsech}⁡(\\frac{x-1}{\\sqrt{5}})+C" #edb/ref 17592186045417] [17592186538234 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186538234 #edb/ref 1083 #uuid "005434de-0921-503b-a0e7-54592318d301" #edb/ref 17592186045417] [17592186538240 #edb/ref 1080 "-\\frac{1}{3}\\operatorname{arsech}⁡(x-5)+C" #edb/ref 17592186045417] [17592186538240 #edb/ref 1082 #edb/ref 17592186045498 #e