db/ref 17592186045417] [17592186166316 #edb/ref 1078 #edb/ref 17592186538260 #edb/ref 17592186045417] [17592186166316 #edb/ref 1079 #uuid "8e78c2b7-cba3-5a4d-950c-d6f7840d0864" #edb/ref 17592186045417] [17592186166322 #edb/ref 1075 #edb/ref 17592186538428 #edb/ref 17592186045417] [17592186166322 #edb/ref 1075 #edb/ref 17592186538627 #edb/ref 17592186045417] [17592186166322 #edb/ref 1075 #edb/ref 17592186538637 #edb/ref 17592186045417] [17592186166322 #edb/ref 1075 #edb/ref 17592186538755 #edb/ref 17592186045417] [17592186166322 #edb/ref 1075 #edb/ref 17592186538790 #edb/ref 17592186045417] [17592186166322 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186166322 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186166322 #edb/ref 1078 #edb/ref 17592186538637 #edb/ref 17592186045417] [17592186166322 #edb/ref 1079 #uuid "cffcc18d-04b4-520c-afc2-9502fc33eeb7" #edb/ref 17592186045417] [17592186166644 #edb/ref 1069 "e-8452" #edb/ref 17592186045417] [17592186166644 #edb/ref 1071 "${\\displaystyle \\int \\dfrac{1}{(x-1)\\sqrt{2x-x^2}} \\textrm{d}x= }$" #edb/ref 17592186045417] [17592186166644 #edb/ref 1072 #uuid "f78d6af8-1a67-50e5-a1d0-6afbbe2b7c16" #edb/ref 17592186045417] [17592186166644 #edb/ref 1074 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\eqalign{\n2x-x^2 & = -(x^2 - 2x)\\[5pt]\n& = -(x^2 - 2\\cdot x + 1^2-1^2)\\[5pt]\n& = -((x-1)^2 - 1) \\[5pt]\n&= 1 - (x-1)^2\n}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\dfrac{1}{(x-1)\\sqrt{2x-x^2}} \\textrm{d}x  = \\int  \\dfrac{1}{(x-1)\\sqrt { 1-(x-1)^2 } }\t\\, \\textrm{d}x.\n$$\n\nLet $u = x-1.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{(x-1)\\sqrt{2x-{x}^{2}}}\\text{d}x & =\\int \\frac{1}{(x-1)\\sqrt{1-(x-1)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\text{d}u \\\\  & =-\\operatorname{arsech}⁡u+C \\\\  & =-\\operatorname{arsech}⁡(x-1)+C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166645 #edb/ref 1069 "e-8453" #edb/ref 17592186045417] [17592186166645 #edb/ref 1071 "Calculate $\\displaystyle \\int \\dfrac{1}{4-(2x-2)^2} \\textrm{d}x.$" #edb/ref 17592186045417] [17592186166645 #edb/ref 1072 #uuid "cde0faf2-8650-59c7-9a28-073516b09594" #edb/ref 17592186045417] [17592186166645 #edb/ref 1074 "First, we note that\n\n$$\n\\int \\dfrac{1}{4-(2x-2)^2}\\textrm{d}x = \n\\int \\dfrac{1}{4-4(x-1)^2}\\textrm{d}x = \n\\dfrac{1}{4} {\\int}\\dfrac{1}{ 1 - (x-1)^2 }\\textrm{d}x.\n$$\n\nLet $u = x-1.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int \\frac{1}{1-{(x-1)}^{2}}\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1-{u}^{2}}\\cdot \\text{d}u \\\\  & =\\frac{1}{4}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{4}\\operatorname{arcoth}⁡(x-1)+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $\\left|{x-1} \\right| >   1.$" #edb/ref 17592186045417] [17592186166646 #edb/ref 1069 "e-8454" #edb/ref 17592186045417] [17592186166646 #edb/ref 1071 "${\\displaystyle \\int \\dfrac{6}{|3x+9|\\sqrt{x^2+6x+10}} \\textrm{d}x= }$" #edb/ref 17592186045417] [17592186166646 #edb/ref 1072 #uuid "26cd55d1-dc94-507c-bcf9-13d619493184" #edb/ref 17592186045417] [17592186166646 #edb/ref 1074 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}+6x+10 & ={x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}+10 \\\\  & =(x+3)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\dfrac{6}{|3x\\!+\\!9|\\sqrt{x^2\\!+\\!6x\\!+\\!10}} \\,\\textrm{d}x  = \\int  \\dfrac{6}{3|x\\!+\\!3|\\sqrt {1\\!+\\!(x\\!+\\!3)^2} }\t\\, \\textrm{d}x = {2} \\int \\dfrac{1}{|x\\!+\\!3|\\sqrt{1\\!+\\!(x\\!+\\!3)^2}} \\, \\textrm{d}x.\n$$\n\nLet $u = x+3.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}2\\int \\frac{1}{|x+3|\\sqrt{1+(x+3)^{2}}}\\text{d}x & =2\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-2\\operatorname{arcsch}⁡u+C \\\\  & =-2\\operatorname{arcsch}⁡(x+3)+C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166647 #edb/ref 1069 "e-8455" #edb/ref 17592186045417] [17592186166647 #edb/ref 1071 "$\\displaystyle \\int \\dfrac{1}{3-2x-x^2} \\textrm{d}x=$" #edb/ref 17592186045417] [17592186166647 #edb/ref 1072 #uuid "aa11660f-ce84-52df-bcc4-45a6d63b6d7e" #edb/ref 17592186045417] [17592186166647 #edb/ref 1074 "First, we complete the square for the denominator:\n\n$$\n\\eqalign{\n3-2x-x^2 & = -(x^2 + 2x - 3)\\[5pt]\n& = -(x^2 + 2\\cdot x +1^2 - 1^2 - 3)\\[5pt]\n& = -((x+1)^2 - 4) \\[5pt]\n&= 4 - (x+1)^2\n}\n$$\n\nSubstituting the above into the denominator of our integral, we get\n\n$$\n\\int \\dfrac{1}{3-2x-x^2}\\textrm{d}x =\n\\int \\dfrac{1}{4-(x+1)^2}\\textrm{d}x = \n\\dfrac{1}{4} {\\int}\\dfrac{1}{ 1 - \\left( \\frac{1}{2}(x+1)\\right)^2 }\\textrm{d}x.\n$$\n\nLet $u = \\dfrac{1}{2}(x+1).$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{2}\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = 2\\,\\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int \\frac{1}{1-{(\\frac{1}{2}(x+1))}^{2}}\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1-{u}^{2}}\\cdot 2\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{2}\\cdot \\operatorname{arcoth}⁡(\\frac{1}{2}(x+1))+C \\\\  & =\\frac{1}{2}\\operatorname{arcoth}⁡(\\frac{x+1}{2})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $\\left|\\dfrac {x+1} {2} \\right| >   1.$" #edb/ref 17592186045417] [17592186166806 #edb/ref 1037 