6565385 #edb/ref 1075 #edb/ref 17592186565031 #edb/ref 17592186045417] [17592186565385 #edb/ref 1075 #edb/ref 17592186565105 #edb/ref 17592186045417] [17592186565385 #edb/ref 1075 #edb/ref 17592186565109 #edb/ref 17592186045417] [17592186565385 #edb/ref 1075 #edb/ref 17592186565231 #edb/ref 17592186045417] [17592186565385 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186565385 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186565385 #edb/ref 1078 #edb/ref 17592186565109 #edb/ref 17592186045417] [17592186565385 #edb/ref 1079 #uuid "c921d9f4-e9e5-5990-b776-9a71c2e5fae5" #edb/ref 17592186045417] [17592186565410 #edb/ref 1068 #edb/ref 17592186565358 #edb/ref 17592186045417] [17592186565410 #edb/ref 1069 "q-122991" #edb/ref 17592186045417] [17592186565410 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186565410 #edb/ref 1071 "Let $P=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ be a partition of the interval $[1,3].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}5({x}_{i}+{x}_{i-1})Δ{x}_{i}.$" #edb/ref 17592186045417] [17592186565410 #edb/ref 1072 #uuid "05eaf340-4492-5bdf-bad0-8c07f4ea4867" #edb/ref 17592186045417] [17592186565410 #edb/ref 1074 "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{i=1}^{m}5({x}_{i}+{x}_{i-1})Δ{x}_{i}=5{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}.\n$$\n\nWe can simplify the summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & =({x}_{1}+{x}_{0})Δ{x}_{1}+({x}_{2}+{x}_{1})Δ{x}_{2}+⋯+({x}_{m}+{x}_{m-1})Δ{x}_{m} \\\\  & =({x}_{1}+{x}_{0})({x}_{1}-{x}_{0})+({x}_{2}+{x}_{1})({x}_{2}-{x}_{1})+⋯+({x}_{m}+{x}_{m-1})({x}_{m}-{x}_{m-1}) \\\\  & =({x}_{1}^{2}-{x}_{0}^{2})+({x}_{2}^{2}-{x}_{1}^{2})+⋯+({x}_{m}^{2}-{x}_{m-1}^{2}) \\\\  & =(\\cancel{{x}_{1}^{2}}-{x}_{0}^{2})+(\\cancel{{x}_{2}^{2}}-\\cancel{{x}_{1}^{2}})+⋯+({x}_{m}^{2}-\\cancel{{x}_{m-1}^{2}}) \\\\  & =-{x}_{0}^{2}+{x}_{m}^{2} \\\\  & ={x}_{m}^{2}-{x}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${x}_{0}=1$ and ${x}_{m}=3$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & ={x}_{m}^{2}-{x}_{0}^{2} \\\\  & ={3}^{2}-{1}^{2} \\\\  & =8.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n5{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}=5\\cdot 8=40.\n$$" #edb/ref 17592186045417] [17592186565441 #edb/ref 1068 #edb/ref 17592186565329 #edb/ref 17592186045417] [17592186565441 #edb/ref 1069 "q-122978" #edb/ref 17592186045417] [17592186565441 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186565441 #edb/ref 1071 "Let $P=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ be a partition of the interval $[-8,-1].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}6Δ{y}_{j}.$" #edb/ref 17592186045417] [17592186565441 #edb/ref 1072 #uuid "6f562602-9739-513b-8ce5-9ee1b6ec86ba" #edb/ref 17592186045417] [17592186565441 #edb/ref 1074 "First, we take the factor $6$ outside the summation:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}6Δ{y}_{j}=6{\\sum }_{j=1}^{n}Δ{y}_{j}\\end{aligned}\n$$\n\nNote that ${\\sum }_{j=1}^{n}Δ{y}_{j}$ is just the length of the interval $[-8,-1],$ because\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}Δ{y}_{j} & =({y}_{1}-{y}_{0})+({y}_{2}-{y}_{1})+({y}_{3}-{y}_{2})+⋯+({y}_{n}-{y}_{n-1}) \\\\  & =(\\cancel{{y}_{1}}-{y}_{0})+(\\cancel{{y}_{2}}-\\cancel{{y}_{1}})+(\\cancel{{y}_{3}}-\\cancel{{y}_{2}})+⋯+({y}_{n}-\\cancel{{y}_{n-1}}) \\\\  & =-{y}_{0}+{y}_{n} \\\\  & ={y}_{n}-{y}_{0} \\\\  & =(-1)-(-8) \\\\  & =8-1 \\\\  & =7.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n6{\\sum }_{j=1}^{n}Δ{y}_{j}=6\\cdot 7=42.\n$$" #edb/ref 17592186045417] [17592186565442 #edb/ref 1068 #edb/ref 17592186565341 #edb/ref 17592186045417] [17592186565442 #edb/ref 1069 "q-122939" #edb/ref 17592186045417] [17592186565442 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186565442 #edb/ref 1071 "Which of the following are partitions of the real interval $[3,9]?$\n\nI. $\\{3,5,8,9\\}$\n\nII. $3<4<6<7<8$\n\nIII. $\\{1,3,4,8,9\\}$" #edb/ref 17592186045417] [17592186565442 #edb/ref 1072 #uuid "7147d280-b22a-57e1-b370-a9886ed9abe3" #edb/ref 17592186045417] [17592186565442 #edb/ref 1074 "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP=\\{{x}_{0},{x}_{1},…,{x}_{n}\\}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is a partition of $[3,9].$\n\n- Statement II is not a partition of $[3,9]$  since it does not include the right endpoint $b=9.$\n\n- Statement III is not a partition of $[3,9]$ since $1$ does not belong to $[3,9].$\n\nTherefore, the correct answer is \"I only.\"" #edb/ref 17592186045417] [17592186565453 #edb/ref 1068 #edb/ref 17592186565385 #edb/ref 17592186045417] [17592186565453 #edb/ref 1069 "q-122987" #edb/ref 17592186045417] [17592186565453 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186565453 #edb/ref 1071 "Let $P=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ be a partition of the interval $[3,8].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}.$" #edb/ref 17592186045417] [17592186565453 #edb/ref 1072 #uuid "a66dfc35-4f40-599b-91f5-fb79cdcce84b" #edb/ref 17592186045417] [17592186565453 #edb/ref 1074 "We can simplify the given summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & =({x}_{1}+{x}_{0})Δ{x}_{1}+({x}_{2}+{x}_{1})Δ{x}_{2}+⋯+({x}_{m}+{x}_{m-1})Δ{x}_{n} \\\\  & =({x}_{1}+{x}_{0})({x}_{1}-{x}_{0})+({x}_{2}+{x}_{1})({x}_{2}-{x}_{1})+⋯+({x}_{m}+{x}_{m-1})({x}_{m}-{x}_{m-1}) \\\\  & =({x}_{1}^{2}-{x}_{0}^{2})+({x}_{2}^{2}-{x}_{1}^{2})+⋯+({x}_{m}^{2}-{x}_{m-1}^{2}) \\\\  & =(\\cancel{{x}_{1}^{2}}-{x}_{0}^{2})+(\\cancel{{x}_{2}^{2}}-\\cancel{{x}_{1}^{2}})+⋯+({x}_{m}^{2}-\\cancel{{x}_{m-1}^{2}}) \\\\  & =-{x}_{0}^{2}+{x}_{m}^{2} \\\\  & ={x}_{m}^{2}-{x}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${x}_{0}=3$ and ${x}_{m}=8$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & ={x}_{m}^{2}-{x}_{0}^{2} \\\\  & ={8}^{2}-{3}^{2} \\\\  & =55.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186565464 #edb/ref 1068 #edb/ref 17592186565337 #edb/ref 17592186045417] [17592186565464 #edb/ref 1069 "q-122970" #edb/ref 17592186045417] [17592186565464 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186565464 #edb/ref 1071 "Let $P=\\{{z}_{0},{z}_{1},…,{z}_{q}\\}$ be a partition of the interval $[-1,5].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}Δ{z}_{k}.$" #edb/ref 17592186045417] [17592186565464 #edb/ref 1072 #uuid "cc3f1bc7-f9c3-504a-985e-91fc4c5b8f28" #edb/ref 17592186045417] [17592186565464 #edb/ref 1074 "Note that ${\\sum }_{k=1}^{q}Δ{z}_{k}$ is just the length of the interval $[-1,5],$ because\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}Δ{z}_{k} & =({z}_{1}-{z}_{0})+({z}_{2}-{z}_{1})+({z}_{3}-{z}_{2})+⋯+({z}_{q}-{z}_{q-1}) \\\\  & =(\\cancel{{z}_{1}}-{z}_{0})+(\\cancel{{z}_{2}}-\\cancel{{z}_{1}})+(\\cancel{{z}_{3}}-\\cancel{{z}_{2}})+⋯+({z}_{q}-\\cancel{{z}_{q-1}}) \\\\  & =-{z}_{0}+{z}_{q} \\\\  & ={z}_{q}-{z}_{0} \\\\  & =5-(-1) \\\\  & =6.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186565470 #edb/ref 1068 #edb/ref 17592186565345 #edb/ref 17592186045417] [17592186565470 #edb/ref 1069 "q-122974" #edb/ref 17592186045417] [17592186565470 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186565470 #edb/ref 1071 "Let $P=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ be a partition of the interval $[5,14].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}-2Δ{y}_{j}.$" #edb/ref 17592186045417] [17592186565470 #edb/ref 1072 #uuid "d8715c2d-ca5b-51c2-9a33-2dfd408c50a1" #edb/ref 17592186045417] [17592186565470 #edb/ref 1074 "First, we take the factor $(-2)$ outside the summation:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}-2Δ{y}_{j}=-2{\\sum }_{j=1}^{n}Δ{y}_{j}\\end{aligned}\n$$\n\nNote that ${\\sum }_{j=1}^{n}Δ{y}_{j}$ is just the length of the interval $[5,14],$ because\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}Δ{y}_{j} & =({y}_{1}-{y}_{0})+({y}_{2}-{y}_{1})+({y}_{3}-{y}_{2})+⋯+({y}_{n}-{y}_{n-1}) \\\\  & =(\\cancel{{y}_{1}}-{y}_{0})+(\\cancel{{y}_{2}}-\\cancel{{y}_{1}})+(\\cancel{{y}_{3}}-\\cancel{{y}_{2}})+⋯+({y}_{n}-\\cancel{{y}_{n-1}}) \\\\  & =-{y}_{0}+{y}_{n} \\\\  & ={y}_{n}-{y}_{0} \\\\  & =14-5 \\\\  & =9.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n-2{\\sum }_{j=1}^{n}Δ{y}_{j}=(-2)\\cdot 9=-18.\n$$" #edb/ref 17592186045417] [17592186565472 #edb/ref 1068 #edb/ref 17592186565327 #edb/ref 17592186045417] [17592186565472 #edb/ref 1069 "q-122990" #edb/ref 17592186045417] [17592186565472 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186565472 #edb/ref 1071 "Let $P=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ be a partition of the interval $[1,5].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}3({y}_{j}+{y}_{j-1})Δ{y}_{j}.$" #edb/ref 17592186045417] [17592186565472 #edb/ref 1072 #uuid "dc9a0f07-fee9-5b1d-8ce4-fb565f5e676a" #edb/ref 17592186045417] [17592186565472 #edb/ref 1074 "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{j=1}^{n}3({y}_{j}+{y}_{j-1})Δ{y}_{j}=3{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}.\n$$\n\nWe can simplify the summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & =({y}_{1}+{y}_{0})Δ{y}_{1}+({y}_{2}+{y}_{1})Δ{y}_{2}+⋯+({y}_{n}+{y}_{n-1})Δ{y}_{n} \\\\  & =({y}_{1}+{y}_{0})({y}_{1}-{y}_{0})+({y}_{2}+{y}_{1})({y}_{2}-{y}_{1})+⋯+({y}_{n}+{y}_{n-1})({y}_{n}-{y}_{n-1}) \\\\  & =({y}_{1}^{2}-{y}_{0}^{2})+({y}_{2}^{2}-{y}_{1}^{2})+⋯+({y}_{n}^{2}-{y}_{n-1}^{2}) \\\\  & =(\\cancel{{y}_{1}^{2}}-{y}_{0}^{2})+(\\cancel{{y}_{2}^{2}}-\\cancel{{y}_{1}^{2}})+⋯+({y}_{n}^{2}-\\cancel{{y}_{n-1}^{2}}) \\\\  & =-{y}_{0}^{2}+{y}_{n}^{2} \\\\  & ={y}_{n}^{2}-{y}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${y}_{0}=1$ and ${y}_{n}=5$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & ={y}_{n}^{2}-{y}_{0}^{2} \\\\  & ={5}^{2}-{1}^{2} \\\\  & =24.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n3{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}=3\\cdot 24=72.\n$$" #edb/ref 17592186045417] [17592186565480 #edb/ref 1068 #edb/ref 17592186565361 #edb/ref 17592186045417] [17592186565480 #edb/ref 1069 "q-122927" #edb/ref 17592186045417] [17592186565480 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186565480 #edb/ref 1071 "Which of the following are partitions of the real interval $[0,9]?$\n\nI. $1<5<9$\n\nII. $0<5<7<9<10$\n\nIII. $\\{0,1,2,6,8,9\\}$" #edb/ref 17592186045417] [17592186565480 #edb/ref 1072 #uuid "f1be0d7b-0db0-5190-8f45-38feec497f84" #edb/ref 17592186045417] [17592186565480 #edb/ref 1074 "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP=\\{{x}_{0},{x}_{1},…,{x}_{n}\\}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is not a partition of $[0,9]$ since it does not include the left endpoint $a=0.$\n\n- Statement II is not a partition of $[0,9]$ since $10$ does not belong to $[0,9].$\n\n- Statement III is a partition of $[0,9].$\n\nTherefore, the correct answer is \"III only.\"" #edb/ref 17592186045417]}
