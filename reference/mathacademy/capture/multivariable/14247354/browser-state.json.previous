></mrow></msub><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><menclose notation=\"updiagonalstrike\"><msub><mi>z</mi><mn>1</mn></msub></menclose><mo>−</mo><msub><mi>z</mi><mn>0</mn></msub><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><menclose notation=\"updiagonalstrike\"><msub><mi>z</mi><mn>2</mn></msub></menclose><mo>−</mo><menclose notation=\"updiagonalstrike\"><msub><mi>z</mi><mn>1</mn></msub></menclose><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><menclose notation=\"updiagonalstrike\"><msub><mi>z</mi><mn>3</mn></msub></menclose><mo>−</mo><menclose notation=\"updiagonalstrike\"><msub><mi>z</mi><mn>2</mn></msub></menclose><mo stretchy=\"false\">)</mo><mo>+</mo><mo>⋯</mo><mo>+</mo><mo stretchy=\"false\">(</mo><msub><mi>z</mi><mi>q</mi></msub><mo>−</mo><menclose notation=\"updiagonalstrike\"><msub><mi>z</mi><mrow data-mjx-texclass=\"ORD\"><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msub></menclose><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><msub><mi>z</mi><mn>0</mn></msub><mo>+</mo><msub><mi>z</mi><mi>q</mi></msub></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msub><mi>z</mi><mi>q</mi></msub><mo>−</mo><msub><mi>z</mi><mn>0</mn></msub></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>5</mn><mo>−</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>6.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
