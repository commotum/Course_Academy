><msub><mi>x</mi><mn>2</mn></msub></menclose><mo>−</mo><menclose notation=\"updiagonalstrike\"><msub><mi>x</mi><mn>1</mn></msub></menclose><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><menclose notation=\"updiagonalstrike\"><msub><mi>x</mi><mn>3</mn></msub></menclose><mo>−</mo><menclose notation=\"updiagonalstrike\"><msub><mi>x</mi><mn>2</mn></msub></menclose><mo stretchy=\"false\">)</mo><mo>+</mo><mo>⋯</mo><mo>+</mo><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mi>m</mi></msub><mo>−</mo><menclose notation=\"updiagonalstrike\"><msub><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msub></menclose><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><msub><mi>x</mi><mn>0</mn></msub><mo>+</mo><msub><mi>x</mi><mi>m</mi></msub></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msub><mi>x</mi><mi>m</mi></msub><mo>−</mo><msub><mi>x</mi><mn>0</mn></msub></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>8</mn><mo>−</mo><mn>2</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>6.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
