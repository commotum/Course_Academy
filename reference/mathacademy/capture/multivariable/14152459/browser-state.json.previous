mo><mo>∼</mo></math></mjx-assistive-mml></mjx-container>   \n<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:70px;\n                                        margin-left:0px;\n                                        margin-right:0px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"31\"><span mathquill-command-id=\"33\">6</span><var mathquill-command-id=\"35\">e</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"37\"><span class=\"mq-sup\" mathquill-block-id=\"39\"><span mathquill-command-id=\"38\" class=\"\">−</span><span mathquill-command-id=\"40\">4</span><var mathquill-command-id=\"42\">x</var><span mathquill-command-id=\"44\" class=\"mq-binary-operator\">−</span><span mathquill-command-id=\"46\">8</span></span></span></span></div></div> \n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"-1\" ctxtmenu_counter=\"66\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-munderover space=\"2\"><mjx-over style=\"padding-bottom: 0.192em; padding-left: 0.368em;\"><mjx-mi class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi></mjx-over><mjx-box><mjx-munder><mjx-row><mjx-base><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c2211 TEX-S2\"></mjx-c></mjx-mo></mjx-base></mjx-row><mjx-row><mjx-under style=\"padding-top: 0.167em; padding-left: 0.058em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c clas