          "dom_id": null,
          "type": "math",
          "value": "-\\operatorname{sin}⁡(\\sqrt{3}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{3}(-1)^{n}}{n{\\pi }^{3}(12-{n}^{2})}",
