0 #edb/ref 1072 #uuid "000c3cb5-99b8-5a63-a939-b4c9bbac2e4d" #edb/ref 17592186045443] [17592186478530 #edb/ref 1074 "Recall that\n\n$$\n\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta =sec⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 7sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta  & =7\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta  \\\\  & =7sec⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186478540 #edb/ref 1068 #edb/ref 17592186478545 #edb/ref 17592186045443] [17592186478540 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045443] [17592186478540 #edb/ref 1071 "$\\int (2\\operatorname{sec}⁡x\\operatorname{tan}⁡x+7\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x=$" #edb/ref 17592186045443] [17592186478540 #edb/ref 1072 #uuid "570dc35b-e80f-5ece-8e6f-394d1b6948c7" #edb/ref 17592186045443] [17592186478540 #edb/ref 1074 "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x & =\\operatorname{sec}⁡x+C, \\\\ \\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x & =-\\operatorname{csc}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2\\operatorname{sec}⁡x\\operatorname{tan}⁡x+7\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x & =2\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x+7\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =2\\operatorname{sec}⁡x+7(-\\operatorname{csc}⁡x)+C \\\\  & =2\\operatorname{sec}⁡x-7\\operatorname{csc}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186478548 #edb/ref 1068 #edb/ref 17592186478537 #edb/ref 17592186045443] [17592186478548 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186478548 #edb/ref 1071 "$\\int 4sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta =$" #edb/ref 17592186045443] [17592186478548 #edb/ref 1072 #uuid "a95250ab-14f4-581f-b870-f64fb7bfc9db" #edb/ref 17592186045443] [17592186478548 #edb/ref 1074 "Recall that\n\n$$\n\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta =sec⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 4sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta  & =4\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta  \\\\  & =4sec⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186478554 #edb/ref 1068 #edb/ref 17592186478546 #edb/ref 17592186045443] [17592186478554 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045443] [17592186478554 #edb/ref 1071 "$\\int (6\\operatorname{sec}⁡x\\operatorname{tan}⁡x+3\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x=$" #edb/ref 17592186045443] [17592186478554 #edb/ref 1072 #uuid "d69ba0b0-03dc-54aa-8ebb-decdcdfd9cde" #edb/ref 17592186045443] [17592186478554 #edb/ref 1074 "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x & =\\operatorname{sec}⁡x+C, \\\\ \\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x & =-\\operatorname{csc}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (6\\operatorname{sec}⁡x\\operatorname{tan}⁡x+3\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x & =6\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x+3\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =6\\operatorname{sec}⁡x+3(-\\operatorname{csc}⁡x)+C \\\\  & =6\\operatorname{sec}⁡x-3\\operatorname{csc}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186478558 #edb/ref 1168 "generate/scratch/17592186064179.py" #edb/ref 17592186045443] [17592186478558 #edb/ref 1169 #uuid "b41e7f14-d716-550f-9a7f-1dcefe9f4c35" #edb/ref 17592186045443] [17592186479162 #edb/ref 1068 #edb/ref 17592186479167 #edb/ref 17592186045443] [17592186479162 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045443] [17592186479162 #edb/ref 1071 "$\\int -9{csc}^{2}⁡y\\,\\text{d}y=$" #edb/ref 17592186045443] [17592186479162 #edb/ref 1072 #uuid "0ad6f73f-5761-5c28-8db7-a8660f3425