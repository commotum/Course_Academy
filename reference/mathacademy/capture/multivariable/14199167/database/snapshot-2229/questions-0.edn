#{[{:db/id #edb/ref 17592186514483 :knowledge-point/_questions [{:db/id #edb/ref 17592186078383 :knowledge-point/id #uuid "266c7322-6395-5e9b-ad8e-fe51f3c36665" :knowledge-point/title "Removing a Jump Discontinuity in a Piecewise Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c3822e0-7f7b-5338-85bf-9c5070788c44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186513825}] :answer-field/correct {:answer/id #uuid "6c3822e0-7f7b-5338-85bf-9c5070788c44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186513825} :answer-field/id #uuid "43939460-e1b0-596e-a7b7-ed6180d6c370" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514256}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fbda5c07-3c3f-5393-8bd3-32f9b514a1ca" :question/math-academy-id "q-166070" :question/problem "The function $p(x)$ is defined as\n\n$$\np(x)=\\{\\begin{aligned}k+10, & \\,x\\le 3, \\\\ g(x), & \\,x>3.\\end{aligned}\n$$\n\n \n\nFind the value of the constant $k$ that makes $p(x)$ continuous at $x=3.$\n\n$k\\,=$\n{{field-1}}" :question/worked-solution "We have the piecewise function\n\n$$\np(x)=\\{\\begin{aligned}k+10, & \\,x\\le 3, \\\\ 8x-\\frac{2}{3}{x}^{3}, & \\,x>3.\\end{aligned}\n$$\n\n \n\nAt $x=3,$ the left-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{-}}p(x) & =p(3) \\\\  & =k+10,\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{+}}p(x) & ={lim}_{x\\to {3}^{+}}(8x-\\frac{2}{3}{x}^{3}) \\\\  & =8(3)-\\frac{2}{3}(3)^{3} \\\\  & =24-18 \\\\  & =6.\\end{aligned}\n$$\n\nIn order for $p(x)$ to be continuous at $x=3,$ we require that\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{-}}p(x) & ={lim}_{x\\to {3}^{+}}p(x) \\\\ k+10 & =6 \\\\ k & =-4.\\end{aligned}\n$$\n\nTherefore, $p(x)$ is continuous at $x=3$ when $k=-4.$"}] [{:db/id #edb/ref 17592186514433 :knowledge-point/_questions [{:db/id #edb/ref 17592186059675 :knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f06a75e2-cb48-5e18-9b9c-3baddcbbb99f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\cos x" :db/id #edb/ref 17592186514159}] :answer-field/correct {:answer/id #uuid "f06a75e2-cb48-5e18-9b9c-3baddcbbb99f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\cos x" :db/id #edb/ref 17592186514159} :answer-field/id #uuid "0c175b32-cf9f-563c-b23b-dd0064f3ca32" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514214}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "83dc5138-e470-5b8f-b97c-b3006ebeb428" :question/math-academy-id "q-166071" :question/problem "$\\frac{\\text{d}h}{\\text{d}x}\\,=${{field-1}}" :question/worked-solution "We know that \n\n$$\n\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x)=\\operatorname{cos}⁡x.\n$$\n\nApplying this formula and the constant multiple rules, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}h}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{sin}⁡x) \\\\  & =-4\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x) \\\\  & =-4\\cdot (\\operatorname{cos}⁡x) \\\\  & =-4\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514409 :knowledge-point/_questions [{:db/id #edb/ref 17592186059677 :knowledge-point/id #uuid "89f65f58-bd3d-5c3f-b9e0-462d74d75b59" :knowledge-point/title "Computing Second Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75bfff0a-4c65-5fd2-b1ef-35a173aa2b7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x" :db/id #edb/ref 17592186513842}] :answer-field/correct {:answer/id #uuid "75bfff0a-4c65-5fd2-b1ef-35a173aa2b7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4x" :db/id #edb/ref 17592186513842} :answer-field/id #uuid "826eda45-40bd-506b-a5bb-0ddbb36d06dc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514287}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "60d8ee2b-aed9-5a87-bc1d-99d095c196bb" :question/math-academy-id "q-166072" :question/problem "${g}^{″}(x)=${{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(8x-\\frac{2}{3}{x}^{3}) \\\\  & =8-\\frac{2}{3}\\cdot 3{x}^{2} \\\\  & =8-2{x}^{2}.\\end{aligned}\n$$\n\nFinally, computing the second derivative, we obtain\n\n$$\n\\begin{aligned}{g}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(8-2{x}^{2}) \\\\  & =-4x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514464 :knowledge-point/_questions [{:db/id #edb/ref 17592186096619 :knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83" :knowledge-point/title "Finding the Slope of the Tangent Line to a Product  at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2f634bf-1fab-5c5c-9faf-cca696e95edd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e^{\\pi}" :db/id #edb/ref 17592186514126}] :answer-field/correct {:answer/id #uuid "e2f634bf-1fab-5c5c-9faf-cca696e95edd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e^{\\pi}" :db/id #edb/ref 17592186514126} :answer-field/id #uuid "f49d4659-1c96-5a65-a285-84ed00e2cd31" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514345}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d1eaed8d-b238-536c-b3a6-a6e7f9e94a12" :question/math-academy-id "q-166073" :question/problem "If a curve $C$ is defined by the equation $y=f(x)\\cdot h(x),$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$\n\nSlope $\\,=$\n{{field-1}}" :question/worked-solution "We differentiate using the product rule. Recall that $f(x)=\\frac{1}{2}{e}^{x}$ and $h(x)=-4\\operatorname{sin}⁡x.$ Then,\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{e}^{x})=\\frac{1}{2}{e}^{x} \\\\ \\frac{\\text{d}h}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{sin}⁡x)=-4\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =f\\frac{\\text{d}h}{\\text{d}x}+h\\frac{\\text{d}f}{\\text{d}x} \\\\  & =\\frac{1}{2}{e}^{x}\\cdot (-4\\operatorname{cos}⁡x)+(-4\\operatorname{sin}⁡x)\\cdot \\frac{1}{2}{e}^{x} \\\\  & =-2{e}^{x}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\pi } & =-2{e}^{\\pi }(\\operatorname{cos}⁡\\pi +\\operatorname{sin}⁡\\pi ) \\\\  & =-2{e}^{\\pi }(-1+0) \\\\  & =2{e}^{\\pi }.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $2{e}^{\\pi }.$"}] [{:db/id #edb/ref 17592186514424 :knowledge-point/_questions [{:db/id #edb/ref 17592186092240 :knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "190621cf-ca9e-5595-8816-3501bc000442" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x-\\pi}{2e^{\\pi}}" :db/id #edb/ref 17592186513597}] :answer-field/correct {:answer/id #uuid "190621cf-ca9e-5595-8816-3501bc000442" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x-\\pi}{2e^{\\pi}}" :db/id #edb/ref 17592186513597} :answer-field/id #uuid "059506ee-d597-56af-bfce-bf17819d6958" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514211}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "745a29fd-db69-5896-9d5f-b9b3dcaa95b6" :question/math-academy-id "q-166074" :question/problem "The equation of the normal to the curve $y=f(x)\\cdot h(x)$ at the point where $x=\\pi $ is$\\,y=$\n{{field-1}}." :question/worked-solution "When $x=\\pi ,$ we have\n\n$$\n\\begin{aligned}y(\\pi ) & =f(\\pi )\\cdot h(\\pi ) \\\\  & =\\frac{1}{2}{e}^{\\pi }\\cdot (-4\\operatorname{sin}⁡\\pi ) \\\\  & =\\frac{1}{2}{e}^{\\pi }\\cdot 0 \\\\  & =0.\\end{aligned}\n$$\n\nIn part 4, we found that the slope of the tangent line to the curve $y=f(x)\\cdot h(x)$ at the point where $x=\\pi $ is $m=2{e}^{\\pi }.$ Therefore, the slope of the normal ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{2{e}^{\\pi }}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}^{′}(x-{x}_{1}) \\\\ y-0 & =-\\frac{1}{2{e}^{\\pi }}(x-\\pi ) \\\\ y & =-\\frac{x}{2{e}^{\\pi }}+\\frac{\\pi }{2{e}^{\\pi }}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514422 :knowledge-point/_questions [{:db/id #edb/ref 17592186096621 :knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f4e9c3e-c075-5ee8-b58c-ef68c609d2b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^x(\\cos x-\\sin x)}{8\\sin^2 x}" :db/id #edb/ref 17592186513862}] :answer-field/correct {:answer/id #uuid "7f4e9c3e-c075-5ee8-b58c-ef68c609d2b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^x(\\cos x-\\sin x)}{8\\sin^2 x}" :db/id #edb/ref 17592186513862} :answer-field/id #uuid "ba412a72-8abe-5840-811a-70be04c017e7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514310}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "709bef3c-1deb-5177-94a0-6a0cd6bca192" :question/math-academy-id "q-166075" :question/problem "$\\frac{\\text{d}}{\\text{d}x}(\\frac{f}{h})\\,=${{field-1}}" :question/worked-solution "Recall that $f(x)=\\frac{1}{2}{e}^{x}$ and $h(x)=-4\\operatorname{sin}⁡x.$\n\nWe apply the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{f}{h}) & =\\frac{{f}^{′}(x)\\cdot h(x)-f(x)\\cdot {h}^{′}(x)}{[h(x)]^{2}} \\\\  & =\\frac{{(\\frac{1}{2}{e}^{x})}^{′}\\cdot (-4\\operatorname{sin}⁡x)-(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{sin}⁡x)^{′}}{(-4\\operatorname{sin}⁡x)^{2}} \\\\  & =\\frac{(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{sin}⁡x)-(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{cos}⁡x)}{16{sin}^{2}⁡x} \\\\  & =\\frac{2{e}^{x}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{16{sin}^{2}⁡x} \\\\  & =\\frac{{e}^{x}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{8{sin}^{2}⁡x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514385 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c73650fb-8ca5-5747-bbe3-f451e92a6a69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2e^{-4\\sin x}\\cos x" :db/id #edb/ref 17592186514054}] :answer-field/correct {:answer/id #uuid "c73650fb-8ca5-5747-bbe3-f451e92a6a69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2e^{-4\\sin x}\\cos x" :db/id #edb/ref 17592186514054} :answer-field/id #uuid "bb0216fd-fe08-5818-afd9-7fc21cfab6bb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514312}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d877a64-29c8-5e32-8920-d62abb73e697" :question/math-academy-id "q-166076" :question/problem "Given that $y=f(h(x)),$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}\\,=$\n{{field-1}}" :question/worked-solution "First, notice that $y$ is a composite function:\n\n$$\ny=\\frac{1}{2}{e}^{h},\\,h=-4\\operatorname{sin}⁡x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}h}=\\frac{1}{2}{e}^{h},\\,\\frac{\\text{d}h}{\\text{d}x}=-4\\operatorname{cos}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}h}\\cdot \\frac{\\text{d}h}{\\text{d}x} \\\\  & =\\frac{1}{2}{e}^{h}\\cdot (-4\\operatorname{cos}⁡x) \\\\  & =-2{e}^{-4\\operatorname{sin}⁡x}\\operatorname{cos}⁡x \\\\  & =-\\frac{2\\operatorname{cos}⁡x}{{e}^{4\\operatorname{sin}⁡x}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514466 :knowledge-point/_questions [{:db/id #edb/ref 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "233b9c64-ca46-556b-a55b-afac855b6ea4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186513630}] :answer-field/correct {:answer/id #uuid "233b9c64-ca46-556b-a55b-afac855b6ea4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186513630} :answer-field/id #uuid "0f1f1a16-dad9-5c77-b873-2409266dc186" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514216} {:answer-field/choices [{:answer/id #uuid "578b231b-5611-5088-bf50-85af5441c79a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186513769}] :answer-field/correct {:answer/id #uuid "578b231b-5611-5088-bf50-85af5441c79a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186513769} :answer-field/id #uuid "e547d708-bc0b-5d82-8783-16718788d1d8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514331}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d78b3b66-caba-5b75-9179-7631fdc0e796" :question/math-academy-id "q-166077" :question/problem "![](images/5d/5d2bfbefca5ce0a0b04accad183d0f43537d600c72000058b59f692398259a80.png)\n\nThe graph of $y=g(x)$ for $x\\in [-3,3]$ is plotted above. In ascending order, what are the $x$-coordinates of the points on this interval where ${g}^{′}(x)=0?$\n\n${g}^{′}(x)=0\\,$ when $\\,x\\,=$\n{{field-1}}\n$\\,$ and $\\,x\\,=$\n{{field-2}}\n." :question/worked-solution "A stationary point of $g(x)$ is a value of $x$ where ${g}^{′}(x)=0.$ Graphically, those are the values where the tangent to the graph is horizontal.  \n\nIn the given graph, we can see that at $x=-2$ and $x=2,$ the tangent to the graph is horizontal, so we have ${g}^{′}(x)=0$ at these points.\n\n![](images/36/36fd58470a5361250fa7852d92abe2b9c2dbf18ca97d00e51ea4013f8f3aa348.png)\n\n \n\nTherefore, there are two stationary points, and their $x$-coordinates (in ascending order) are $x=-2$ and $x=2.$"}] [{:db/id #edb/ref 17592186514384 :knowledge-point/_questions [{:db/id #edb/ref 17592186064178 :knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a232ba6-fdfc-512b-a78c-01e0aa14d08a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\cos x" :db/id #edb/ref 17592186513601}] :answer-field/correct {:answer/id #uuid "1a232ba6-fdfc-512b-a78c-01e0aa14d08a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\cos x" :db/id #edb/ref 17592186513601} :answer-field/id #uuid "685c059e-7098-5c75-b848-36830bd2c7c1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514277}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2932e26e-2b57-549a-866d-7abe171c7f20" :question/math-academy-id "q-166078" :question/problem "$\\int h(x)\\,\\text{d}x\\,=${{field-1}}\n$+\\,C,\\,$ where $C$ is an arbitrary constant." :question/worked-solution "Recall that\n\n$$\n\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int h(x)\\,\\text{d}x & =\\int -4\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-4\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-4(-\\operatorname{cos}⁡x)+C \\\\  & =4\\operatorname{cos}⁡x+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."}] [{:db/id #edb/ref 17592186514423 :knowledge-point/_questions [{:db/id #edb/ref 17592186064177 :knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "569b842d-17a2-53d4-9b00-9b5178c0a749" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e^x+12x^2-\\frac{x^4}{2}" :db/id #edb/ref 17592186513767}] :answer-field/correct {:answer/id #uuid "569b842d-17a2-53d4-9b00-9b5178c0a749" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e^x+12x^2-\\frac{x^4}{2}" :db/id #edb/ref 17592186513767} :answer-field/id #uuid "9a994c66-aac8-5b19-bc23-3cf37a49b2cc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514300}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7323da16-6dcc-5329-81f1-5b6cb91bd332" :question/math-academy-id "q-166079" :question/problem "$\\int (4f(x)+3g(x))\\,\\text{d}x\\,=${{field-1}}\n$+C,\\,$ where $C$ is an arbitrary constant." :question/worked-solution "We combine the sum and the constant multiple rules, as follows:\n\n$$\n\\begin{aligned}\\int (4f(x)+3g(x))\\text{d}x & =\\int (4\\cdot \\frac{1}{2}{e}^{x}+3(8x-\\frac{2}{3}{x}^{3}))\\text{d}x \\\\  & =\\int (2{e}^{x}+24x-2{x}^{3})\\text{d}x \\\\  & =2\\int {e}^{x}\\,\\text{d}x+24\\int x\\,\\text{d}x-2\\int {x}^{3}\\,\\text{d}x \\\\  & =2{e}^{x}+24\\cdot \\frac{{x}^{2}}{2}-2\\cdot \\frac{{x}^{4}}{4}+C \\\\  & =2{e}^{x}-\\frac{{x}^{4}}{2}+12{x}^{2}+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."}]}
