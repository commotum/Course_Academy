          "input_html": "<div class=\"matheditor-wrapper-answer\" style=\"min-width: 50px; margin-left: 5px; margin-right: 5px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"7\"><span mathquill-command-id=\"44\">2</span><var mathquill-command-id=\"46\">e</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"48\"><span class=\"mq-sup\" mathquill-block-id=\"50\"><span class=\"mq-nonSymbola\" mathquill-command-id=\"49\">π</span></span></span></span></div></div>",
          "rendered_text": "2eπ",
