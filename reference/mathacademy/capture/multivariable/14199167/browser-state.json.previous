mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msup><mi>e</mi><mi>x</mi></msup><mo stretchy=\"false\">(</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow><mo stretchy=\"false\">)</mo></mrow><mrow><mn>8</mn><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi></mrow></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>             \n\n                           \n                    </div>",
