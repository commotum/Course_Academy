          "input_html": "<div class=\"matheditor-wrapper-answer\" style=\"min-width: 100px; margin-left: 5px; margin-right: 5px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"11\"><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"70\"><span class=\"mq-numerator\" mathquill-block-id=\"72\"><var mathquill-command-id=\"71\">e</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"73\"><span class=\"mq-sup\" mathquill-block-id=\"75\"><var mathquill-command-id=\"74\">x</var></span></span><span mathquill-command-id=\"77\">(</span><var mathquill-command-id=\"80\" class=\"mq-operator-name mq-first\">c</var><var mathquill-command-id=\"81\" class=\"mq-operator-name\">o</var><var mathquill-command-id=\"82\" class=\"mq-operator-name mq-last\">s</var><var mathquill-command-id=\"84\">x</var><span mathquill-command-id=\"86\" class=\"mq-binary-operator\">−</span><var mathquill-command-id=\"89\" class=\"mq-operator-name\">s</var><var mathquill-command-id=\"90\" class=\"mq-operator-name\">i</var><var mathquill-command-id=\"91\" class=\"mq-operator-name mq-last\">n</var><var mathquill-command-id=\"93\">x</var><span mathquill-command-id=\"95\">)</span></span><span class=\"mq-denominator\" mathquill-block-id=\"98\"><span mathquill-command-id=\"97\">8</span><var mathquill-command-id=\"100\" class=\"mq-operator-name mq-first\">s</var><var mathquill-command-id=\"101\" class=\"mq-operator-name\">i</var><var mathquill-command-id=\"102\" class=\"mq-operator-name\">n</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"104\"><span class=\"mq-sup\" mathquill-block-id=\"106\"><span mathquill-command-id=\"105\">2</span></span></span><var mathquill-command-id=\"108\">x</var></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
          "rendered_text": "ex(cosx−sinx)8sin2x​",
