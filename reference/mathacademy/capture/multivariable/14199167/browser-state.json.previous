\">′</mo></msup><mo stretchy=\"false\">(</mo><mi>x</mi><mo>−</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mi>y</mi><mo>−</mo><mn>0</mn></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mn>2</mn><msup><mi>e</mi><mi>π</mi></msup></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><mi>x</mi><mo>−</mo><mi>π</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mi>y</mi></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>x</mi><mrow><mn>2</mn><msup><mi>e</mi><mi>π</mi></msup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>π</mi><mrow><mn>2</mn><msup><mi>e</mi><mi>π</mi></msup></mrow></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>             \n\n                           \n                    </div>",
