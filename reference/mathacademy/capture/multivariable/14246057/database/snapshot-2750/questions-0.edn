186045498 :db/ident :answer.type/math} :answer/value "(- ∞, 3)" :db/id #edb/ref 17592186113769} {:answer/id #uuid "12c8f503-6a7c-5f5f-bf13-5b50dabab587" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- ∞,-3)" :db/id #edb/ref 17592186113770} {:answer/id #uuid "366269f7-40c4-5f8f-a698-bf197a765746" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3, 3)" :db/id #edb/ref 17592186113771} {:answer/id #uuid "3b0c9e5e-9bd0-50e9-bb50-63b14751e217" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3, ∞)" :db/id #edb/ref 17592186113772}] :answer-field/id #uuid "23bfd070-b01a-5822-ae32-7e8a483e1cb3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113767}] :question/id #uuid "52e21306-1872-5a8d-b501-ce393b4c0493" :question/math-academy-id "q-35117" :question/problem "Find the interval where the function $f(t) \\cdot g(t)$ is differentiable, given that:\n$f(t)|= \\mid t - 1 \\mid i + \\cos tj + \\sqrt{1 - t}k; g(t)|= t^{2}i + \\sqrt{t^{2} - 9}j + \\ln (3 - t)k$"}]}
