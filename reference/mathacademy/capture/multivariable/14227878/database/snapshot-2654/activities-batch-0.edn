357-5400-9143-63f15ef64c3f" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186414002}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7819c8fe-793f-5300-ba05-a00d3d72cc5c" :question/math-academy-id "q-253884" :question/problem "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | {{field-1}} | $0$ | $0$ | $0$ |  |\n| --- | --- | --- | --- | --- | --- | --- |\n| ${e}^{({J}_{1}(3)\\,⊕\\,{J}_{3}(0))}=\\,\\,$ |  | $0$ | {{field-2}} | {{field-3}} | $\\frac{1}{2}$ |  |\n|  | $0$ | $0$ | {{field-4}} | {{field-5}} |  |  |\n|  |  | $0$ | $0$ | $0$ | {{field-6}} |  |" :question/worked-solution "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=\\begin{bmatrix}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{bmatrix}.\n$$\n\nFirst, note that\n\n$$\n\\begin{aligned}{e}^{({J}_{1}(3)\\,⊕\\,{J}_{3}(0))} & ={e}^{(\\begin{bmatrix}{J}_{1}(3) & 0 \\\\ 0 & {J}_{3}(0)\\end{bmatrix})} \\\\  & =\\begin{bmatrix}{e}^{({J}_{1}(3))} & 0 \\\\ 0 & {e}^{({J}_{3}(0))}\\end{bmatrix} \\\\  & ={e}^{({J}_{1}(3))}\\,⊕\\,{e}^{({J}_{3}(0))}.\\end{aligned}\n$$\n\nSo, we compute the function of each Jordan block separately.\n\n- For ${J}_{1}(3),$ we have $n=1$ and $\\lambda =3.$ since $n=1,$ we don't need any derivatives. So, we get\n\n$$\n\\begin{aligned}f({J}_{1}(3)) & =\\begin{bmatrix}f(3)\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{3}\\end{bmatrix} \\\\ .\\end{aligned}\n$$\n\n- For ${J}_{3}(0),$ we have $n=3$ and $\\lambda =2.$ \\since $n=3,$ we need to compute the first and second derivatives of $f$ only:\n\n$$\n\\begin{aligned}f(x) & ={e}^{x} \\\\ {f}^{′}(x) & ={e}^{x} \\\\ {f}^{″}(x) & ={e}^{x}\\end{aligned}\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}f({J}_{3}(0)) & =\\begin{bmatrix}f(0) & {f}^{′}(0) & \\frac{{f}^{″}(0)}{2} \\\\ 0 & f(0) & {f}^{′}(0) \\\\ 0 & 0 & f(0)\\end{bmatrix} \\\\  & =\\begin{bmatrix}{e}^{0} & {e}^{0} & \\frac{{e}^{0}}{2} \\\\ 0 & {e}^{0} & {e}^{0} \\\\ 0 & 0 & {e}^{0}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 & \\frac{1}{2} \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}{e}^{({J}_{1}(3)\\,⊕\\,{J}_{3}(0))} & ={e}^{({J}_{1}(3))}\\,⊕\\,{e}^{({J}_{3}(0))} \\\\  & =\\begin{bmatrix}{e}^{3} & 0 & 0 & 0 \\\\ 0 & 1 & 1 & \\frac{1}{2} \\\\ 0 & 0 & 1 & 1 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "7697fba1-0f90-5fc4-8a3d-0c36de70f971"} {:db/id #edb/ref 17592186414009 :step/content {:db/id #edb/ref 17592186414003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7017ca3d-0bfe-52d1-9050-c702cd83a55e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e" :db/id #edb/ref 17592186413967}] :answer-field/correct {:db/id #edb/ref 17592186413967} :answer-field/id #uuid "1be2dfa0-21be-544d-a1f5-2b91c1394fc1" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186413984} {:answer-field/choices [{:answer/id #uuid "50e684f7-c0dc-543a-9c28-178ef40b05b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e" :db/id #edb/ref 17592186413961}] :answer-field/correct {:db/id #edb/ref 17592186413961} :answer-field/id #uuid "2bc444ac-61d1-5d9d-a293-e4884a3c6bdc" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186413986} {:answer-field/choices [{:answer/id #uuid "6ac65ddc-f414-5326-a3bc-41c77e6c0772" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e" :db/id #edb/ref 17592186413966}] :answer-field/correct {:db/id #edb/ref 175921864139