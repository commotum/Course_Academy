b/ref 17592186045417] [17592186399074 #edb/ref 1083 #uuid "35168b7d-a9d3-5efe-bde4-cce3d83737df" #edb/ref 17592186045417] [17592186399075 #edb/ref 1080 "\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}" #edb/ref 17592186045443] [17592186399075 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186399075 #edb/ref 1083 #uuid "d4a0b590-4855-5213-be9f-29a1bf11e8f7" #edb/ref 17592186045417] [17592186399076 #edb/ref 1080 "\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}" #edb/ref 17592186045443] [17592186399076 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186399076 #edb/ref 1083 #uuid "21c2a1ab-5c06-5bdb-a757-d6d841d94d61" #edb/ref 17592186045417] [17592186404651 #edb/ref 1068 #edb/ref 17592186404652 #edb/ref 17592186045417] [17592186404651 #edb/ref 1069 "q-94159" #edb/ref 17592186045417] [17592186404651 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186404651 #edb/ref 1071 "Lagrange's method can be used to reduce the quadratic form $Q(x)={x}_{1}^{2}+18{x}_{3}^{2}-2{x}_{1}{x}_{2}+8{x}_{1}{x}_{3}-8{x}_{2}{x}_{3}$ to the canonical form given below. \n\n$$\n{y}_{1}^{2}-{y}_{2}^{2}+2{y}_{3}^{2},\\,\\left\\{\\begin{aligned}{y}_{1} &=\\boxed{} \\\\ {y}_{2} &=\\boxed{} \\\\ {y}_{3} &={x}_{3}\\end{aligned}\\right.\n$$\n\nFrom top to bottom, what is missing from the blank spaces?" #edb/ref 17592186045443] [17592186404651 #edb/ref 1072 #uuid "8abbbd8d-56c6-5a50-8378-69e23e070d79" #edb/ref 17592186045417] [17592186404651 #edb/ref 1074 "We apply Lagrange's method as follows:\n\nFirst, we group ${x}_{1}^{2}$-term with all cross-product terms that contain ${x}_{1}$ and complete the square inside the parentheses:\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}+18{x}_{3}^{2}-2{x}_{1}{x}_{2}+8{x}_{1}{x}_{3}-8{x}_{2}{x}_{3} \\\\  & =({x}_{1}^{2}-2{x}_{1}{x}_{2}+8{x}_{1}{x}_{3})-8{x}_{2}{x}_{3}+18{x}_{3}^{2} \\\\  & =({x}_{1}^{2}-2{x}_{1}({x}_{2}-4{x}_{3}))-8{x}_{2}{x}_{3}+18{x}_{3}^{2} \\\\  & =({x}_{1}^{2}-2{x}_{1}({x}_{2}-4{x}_{3})+({x}_{2}-4{x}_{3})^{2}-({x}_{2}-4{x}_{3})^{2})-8{x}_{2}{x}_{3}+18{x}_{3}^{2} \\\\  & =({x}_{1}-{x}_{2}+4{x}_{3})^{2}-({x}_{2}-4{x}_{3})^{2}-8{x}_{2}{x}_{3}+18{x}_{3}^{2} \\\\  & =({x}_{1}-{x}_{2}+4{x}_{3})^{2}-{x}_{2}^{2}+8{x}_{2}{x}_{3}-16{x}_{3}^{2}-8{x}_{2}{x}_{3}+18{x}_{3}^{2} \\\\  & =({x}_{1}-{x}_{2}+4{x}_{3})^{2}-{x}_{2}^{2}+2{x}_{3}^{2}\\end{aligned}\n$$\n\nFinally, the canonical form is\n\n$$\n{y}_{1}^{2}-{y}_{2}^{2}+2{y}_{3}^{2},\\,\\left\\{\\begin{aligned}{y}_{1} &={x}_{1}-{x}_{2}+4{x}_{3} \\\\ {y}_{2} &={x}_{2} \\\\ {y}_{3} &={x}_{3}\\end{aligned}\\right.\n$$\n\nTherefore, top to bottom, the missing parts are as follows:\n\n$\\,$ ${x}_{1}-{x}_{2}+4{x}_{3}\\,$ and $\\,{x}_{2}.$" #edb/ref 17592186045443] [17592186404652 #edb/ref 1075 #edb/ref 17592186404653 #edb/ref 17592186045417] [17592186404652 #edb/ref 1075 #edb/ref 17592186404654 #edb/ref 17592186045417] [17592186404652 #edb/ref 1075 #edb/ref 17592186404655 #edb/ref 17592186045417] [17592186404652 #edb/ref 1075 #edb/ref 17592186404656 #edb/ref 17592186045417] [17592186404652 #edb/ref 1075 #edb/ref 17592186404657 #edb/ref 17592186045417] [17592186404652 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186404652 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186404652 #edb/ref 1078 #edb/ref 17592186404657 #edb/ref 17592186045417] [17592186404652 #edb/ref 1079 #uuid "b31630c8-ab94-5333-9ad7-cc37ed818916" #edb/ref 17592186045417] [17592186404653 #edb/ref 1080 "${x}_{1}+{x}_{2}-4{x}_{3}\\,$ and $\\,4{x}_{2}$" #edb/ref 17592186045417] [17592186404653 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186404653 #edb/ref 1083 #uuid "03cd7e59-1e44-587f-b46a-21c18b58dde4" #edb/ref 17592186045417] [17592186404654 #edb/ref 1080 "${x}_{1}-4{x}_{2}+{x}_{3}\\,$ and $\\,2{x}_{2}$" #edb/ref 17592186045417] [17592186404654 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186404654 #edb/ref 1083 #uuid "3efc6564-edbb-5052-ae42-15c048d414c3" #edb/ref 1759218