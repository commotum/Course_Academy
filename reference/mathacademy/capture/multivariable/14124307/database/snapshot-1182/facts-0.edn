045417] [17592186278136 #edb/ref 1075 #edb/ref 17592186275687 #edb/ref 17592186045417] [17592186278136 #edb/ref 1075 #edb/ref 17592186275692 #edb/ref 17592186045417] [17592186278136 #edb/ref 1075 #edb/ref 17592186275928 #edb/ref 17592186045417] [17592186278136 #edb/ref 1075 #edb/ref 17592186277322 #edb/ref 17592186045417] [17592186278136 #edb/ref 1075 #edb/ref 17592186277393 #edb/ref 17592186045417] [17592186278136 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186278136 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186278136 #edb/ref 1078 #edb/ref 17592186277393 #edb/ref 17592186045417] [17592186278136 #edb/ref 1079 #uuid "e911db97-27c7-54f3-ad45-0562d2a959a7" #edb/ref 17592186045417] [17592186278509 #edb/ref 1068 #edb/ref 17592186278050 #edb/ref 17592186045417] [17592186278509 #edb/ref 1069 "q-161435" #edb/ref 17592186045417] [17592186278509 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186278509 #edb/ref 1071 "Evaluate the surface integral\n\n$$\n{∬}_{S}⟨xy,\\,x+y,\\,{e}^{z}⟩\\cdot \\text{d}S\n$$\n\nwhere the surface $S$ is defined by $z=x+y$ for $0\\le x\\le 1$ and $0\\le y\\le x.$" #edb/ref 17592186045417] [17592186278509 #edb/ref 1072 #uuid "d5fb8cb6-33d1-582b-8cf3-53ceebac82e8" #edb/ref 17592186045417] [17592186278509 #edb/ref 1074 "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of a vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(x+y)=1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(x+y)=1\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(x,y,g(x,y)) & =⟨xy,\\,x+y,\\,{e}^{z}⟩{|}_{z=x+y} \\\\  & =⟨xy,\\,x+y,\\,{e}^{x+y}⟩ \\\\  & =⟨{{xy}_{⏟}}_{P},\\,{{x+y}_{⏟}}_{Q},\\,{{{e}^{x+y}}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nTherefore, we can evaluate our surface integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}⟨xy,\\,x+y,\\,{e}^{z}⟩\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(xy)\\cdot 1-(x+y)\\cdot 1+{e}^{x+y})\\,\\text{d}A \\\\  & ={∬}_{D}(-xy-x-y+{e}^{x+y})\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{x}(-xy-x-y+{e}^{x+y})\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{[-\\frac{x{y}^{2}}{2}-xy-\\frac{{y}^{2}}{2}+{e}^{x+y}]}_{y=0}^{y=x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(-\\frac{{x}^{3}}{2}-{x}^{2}-\\frac{{x}^{2}}{2}+{e}^{2x}-{e}^{x})\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(-\\frac{{x}^{3}}{2}-\\frac{3{x}^{2}}{2}+{e}^{2x}-{e}^{x})\\,\\text{d}x \\\\  & ={[-\\frac{{x}^{4}}{8}-\\frac{{x}^{3}}{2}+\\frac{{e}^{2x}}{2}-{e}^{x}]}_{0}^{1} \\\\  & =(-\\frac{1}{8}-\\frac{1}{2}+\\frac{{e}^{2}}{2}-e)-(0+\\frac{1}{2}-1) \\\\  & =\\frac{4{e}^{2}-8e-1}{8}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278519 #edb/ref 1068 #edb/ref 17592186277822 #edb/ref 17592186045417] [17592186278519 #edb/ref 1069 "q-161465" #edb/ref 17592186045417] [17592186278519 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186278519 #edb/ref 1071 "For a surface $S$ given by $x=k(y,z)$ for $(y,z)\\in D,$ the flux of the vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(P-\\,-R\\,)\\,\\text{d}A.\n$$\n\nFrom left to right, what are the missing parts of the formula?" #edb/ref 17592186045417] [17592186278519 #edb/ref 1072 #uuid "46dbd1e0-5399-5e33-b950-1f08b8d717ef" #edb/ref 17592186045417] [17592186278519 #edb/ref 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nSince our surface $S$ is of the form $x=k(y,z),$ it can be parameterized as\n\n$$\nr(y,z)=⟨k(y,z),\\,y,\\,z⟩.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{y}^{′} & =⟨\\frac{∂k}{∂y},\\,1,\\,0⟩ \\\\ {r}_{z}^{′} & =⟨\\frac{∂k}{∂z},\\,0,\\,1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{y}^{′}\\times {r}_{z}^{′} & =|\\begin{aligned}i & j & k \\\\ \\frac{∂k}{∂y} & 1 & 0 \\\\ \\frac{∂k}{∂z} & 0 & 1\\end{aligned}|=⟨1,\\,-\\frac{∂k}{∂y},\\,-\\frac{∂k}{∂z}⟩.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(x,y))\\cdot ({r}_{y}^{′}\\times {r}_{z}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}⟨P,\\,Q,\\,R⟩\\cdot ⟨1,\\,-\\frac{∂k}{∂y},\\,-\\frac{∂k}{∂z}⟩\\,\\text{d}A \\\\  & ={∬}_{D}(P-Q\\,\\frac{∂k}{∂y}-R\\,\\frac{∂k}{∂z})\\,\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278522 #edb/ref 1068 #edb/ref 17592186277919 #edb/ref 17592186045417] [17592186278522 #edb/ref 1069 "q-161481" #edb/ref 17592186045417] [17592186278522 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186278522 #edb/ref 1071 "Evaluate the surface integral\n\n$$\n{∬}_{S}⟨1,\\,0,\\,y⟩\\cdot \\text{d}S\n$$\n\nwhere the surface $S$ is defined by $z=\\operatorname{cos}⁡(x+y)$ for $-\\pi \\le x\\le 0$ and $-x\\le y\\le 0.$" #edb/ref 17592186045417] [17592186278522 #edb/ref 1072 #uuid "da0b12bf-561c-5907-8348-62e84bca5b63" #edb/ref 17592186045417] [17592186278522 #edb/ref 1074 "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of a vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}\\operatorname{cos}⁡(x+y)=-\\operatorname{sin}⁡(x+y) \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}\\operatorname{cos}⁡(x+y)=-\\operatorname{sin}⁡(x+y)\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(x,y,g(x,y)) & =⟨1,\\,0,\\,y⟩{|}_{z=\\operatorname{cos}⁡(x+y)} \\\\  & =⟨{{1}_{⏟}}_{P},\\,{{0}_{⏟}}_{Q},\\,{{y}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nTherefore, we can evaluate our surface integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}⟨1,\\,0,\\,y⟩\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-1\\cdot (-\\operatorname{sin}⁡(x+y))-0\\cdot (-\\operatorname{sin}⁡(x+y))+y)\\,\\text{d}A \\\\  & ={∬}_{D}(\\operatorname{sin}⁡(x+y)+y)\\,\\text{d}A \\\\  & ={\\int }_{-\\pi }^{0}{\\int }_{-x}^{0}(\\operatorname{sin}⁡(x+y)+y)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{0}{[-\\operatorname{cos}⁡(x+y)+\\frac{{y}^{2}}{2}]}_{y=-x}^{y=0}\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{0}(-\\operatorname{cos}⁡x+0)-(-\\operatorname{cos}⁡0+\\frac{{x}^{2}}{2})\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{0}(-\\operatorname{cos}⁡x+1-\\frac{{x}^{2}}{2})\\,\\text{d}x \\\\  & ={[-\\operatorname{sin}⁡x+x-\\frac{{x}^{3}}{6}]}_{-\\pi }^{0} \\\\  & =0-(-0+(-\\pi )-\\frac{(-\\pi )^{3}}{6}) \\\\  & =\\pi -\\frac{{\\pi }^{3}}{6}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278548 #edb/ref 1068 #edb/ref 17592186278136 #edb/ref 17592186045417] [17592186278548 #edb/ref 1069 "q-161542" #edb/ref 17592186045417] [17592186278548 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186278548 #edb/ref 1071 "Calculate the flux of the vector field\n\n$$\nF(x,y,z)=⟨x+y,\\,y-x,\\,z⟩,\n$$\n\nwhere the surface $S$ is defined by $z=1+{x}^{2}+{y}^{2}$ for $-1\\le x\\le 1$ and $-1\\le y\\le 1.$" #edb/ref 17592186045417] [17592186278548 #edb/ref 1072 #uuid "caf172ee-9d85-5048-a736-0f63395a41ce" #edb/ref 17592186045417] [17592186278548 #edb/ref 1074 "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of a vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(1+{x}^{2}+{y}^{2})=2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(1+{x}^{2}+{y}^{2})=2y\\end{aligned}\n$$\n\nIn this case, the flux of $F$ through $S$ is given by \n\n$$\n{∬}_{S}⟨x+y,\\,y-x,\\,z⟩\\cdot \\text{d}S\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(x,y,g(x,y)) & =⟨x+y,\\,y-x,\\,z⟩{|}_{z=1+{x}^{2}+{y}^{2}} \\\\  & =⟨{{x+y}_{⏟}}_{P},\\,{{y-x}_{⏟}}_{Q},\\,{{1+{x}^{2}+{y}^{2}}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nTherefore, we can evaluate our surface integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}⟨x+y,\\,y-x,\\,z⟩\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(x+y)\\cdot (2x)-(y-x)\\cdot (2y)+1+{x}^{2}+{y}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}(-2{x}^{2}-2xy-2{y}^{2}+2xy+1+{x}^{2}+{y}^{2})\\,\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{-1}^{1}(1-{x}^{2}-{y}^{2})\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{-1}^{1}{[y-{x}^{2}y-\\frac{{y}^{3}}{3}]}_{y=-1}^{y=1}\\,\\text{d}x \\\\  & ={\\int }_{-1}^{1}[(1-{x}^{2}-\\frac{1}{3})-(-1+{x}^{2}+\\frac{1}{3})]\\,\\text{d}x \\\\  & ={\\int }_{-1}^{1}(2-2{x}^{2}-\\frac{2}{3})\\,\\text{d}x \\\\  & ={[2x-\\frac{2{x}^{3}}{3}-\\frac{2}{3}x]}_{-1}^{1} \\\\  & =(2-\\frac{2}{3}-\\frac{2}{3})-(-2+\\frac{2}{3}+\\frac{2}{3}) \\\\  & =\\frac{4}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186373972 #edb/ref 1068 #edb/ref 17592186373973 #edb/ref 17592186045417] [17592186373972 #edb/ref 1069 "q-161447" #edb/ref 17592186045417] [17592186373972 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186373972 #edb/ref 1071 "Evaluate the surface integral\n\n$$\n{∬}_{S}⟨y,\\,x+z,\\,z+2x⟩\\cdot \\text{d}S\n$$\n\nwhere the surface $S$ is defined by $z=y-2x$ for $1\\le x\\le 2$ and $0\\le y\\le 1.$" #edb/ref 17592186045417] [17592186373972 #edb/ref 1072 #uuid "9a86f1df-9194-5ee6-ac19-2bfbeca02663" #edb/ref 17592186045417] [17592186373972 #edb/ref 1074 "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of a vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(y-2x)=-2 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(y-2x)=1\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(x,y,g(x,y)) & =⟨y,\\,x+z,\\,z+2x⟩{|}_{z=y-2x} \\\\  & =⟨y,\\,x+(y-2x),\\,y-2x+2x⟩ \\\\  & =⟨{{y}_{⏟}}_{P},\\,{{y-x}_{⏟}}_{Q},\\,{{y}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nTherefore, we can evaluate our surface integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}⟨y,\\,x+z,\\,z+2x⟩\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-y\\cdot (-2)-(y-x)\\cdot (1)+y)\\,\\text{d}A \\\\  & ={∬}_{D}(2y-y+x+y)\\,\\text{d}A \\\\  & ={∬}_{D}(2y+x)\\,\\text{d}A \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{1}(2y+x)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}{[{y}^{2}+xy]}_{y=0}^{y=1}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}(1+x)\\,\\text{d}x \\\\  & ={[x+\\frac{{x}^{2}}{2}]}_{1}^{2} \\\\  & =2+2-1-\\frac{1}{2} \\\\  & =\\frac{5}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186373973 #edb/ref 1075 #edb/ref 17592186373974 #edb/ref 17592186045417] [17592186373973 #edb/ref 1075 #edb/ref 17592186373975 #edb/ref 17592186045417] [17592186373973 #edb/ref 1075 #edb/ref 17592186373976 #edb/ref 17592186045417] [17592186373973 #edb/ref 1075 #edb/ref 17592186373977 #edb/ref 17592186045417] [17592186373973 #edb/ref 1075 #edb/ref 17592186373978 #edb/ref 17592186045417] [17592186373973 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186373973 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186373973 #edb/ref 1078 #edb/ref 17592186373975 #edb/ref 17592186045417] [17592186373973 #edb/ref 1079 #uuid "05d45f19-fa05-53a9-92e1-77a6078e07fb" #edb/ref 175921860454