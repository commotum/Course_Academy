350996" #edb/ref 17592186045417] [17592186198392 #edb/ref 1037 #edb/ref 17592186049883 #edb/ref 17592186045417] [17592186198392 #edb/ref 1038 #edb/ref 17592186198602 #edb/ref 17592186045417] [17592186198392 #edb/ref 1038 #edb/ref 17592186198605 #edb/ref 17592186045417] [17592186198392 #edb/ref 1038 #edb/ref 17592186278512 #edb/ref 17592186045417] [17592186198392 #edb/ref 1038 #edb/ref 17592186278515 #edb/ref 17592186045417] [17592186198392 #edb/ref 1038 #edb/ref 17592186278516 #edb/ref 17592186045417] [17592186198392 #edb/ref 1038 #edb/ref 17592186278519 #edb/ref 17592186045417] [17592186198392 #edb/ref 1038 #edb/ref 17592186373979 #edb/ref 17592186045417] [17592186198392 #edb/ref 1038 #edb/ref 17592186401240 #edb/ref 17592186045417] [17592186198392 #edb/ref 1038 #edb/ref 17592186401247 #edb/ref 17592186045417] [17592186198392 #edb/ref 1038 #edb/ref 17592186401254 #edb/ref 17592186045417] [17592186198392 #edb/ref 1039 "Expressing Flux Over a Surface as a Repeated Integral Using a Formula" #edb/ref 17592186045417] [17592186198392 #edb/ref 1041 #edb/ref 17592186198034 #edb/ref 17592186045417] [17592186198392 #edb/ref 1042 #uuid "55cd2fdb-4cae-5f0b-bea0-e845d51190e1" #edb/ref 17592186045417] [17592186198485 #edb/ref 1043 #edb/ref 17592186199282 #edb/ref 17592186045417] [17592186198485 #edb/ref 1043 #edb/ref 17592186199295 #edb/ref 17592186045417] [17592186198485 #edb/ref 1043 #edb/ref 17592186199299 #edb/ref 17592186045417] [17592186198485 #edb/ref 1043 #edb/ref 17592186199300 #edb/ref 17592186045417] [17592186198485 #edb/ref 1043 #edb/ref 17592186199306 #edb/ref 17592186045417] [17592186198485 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186198485 #edb/ref 1045 "Calculating Flux Through Cartesian Surfaces" #edb/ref 17592186045417] [17592186198485 #edb/ref 1046 #edb/ref 17592186199306 #edb/ref 17592186045417] [17592186198485 #edb/ref 1049 #edb/ref 17592186048253 #edb/ref 17592186045417] [17592186198485 #edb/ref 1053 #uuid "0a27c707-6ea0-5c88-b3ee-852e3b460b3b" #edb/ref 17592186045417] [17592186198593 #edb/ref 1068 #edb/ref 17592186194189 #edb/ref 17592186045417] [17592186198593 #edb/ref 1069 "q-160887" #edb/ref 17592186045417] [17592186198593 #edb/ref 1071 "Consider the vector field $F(x, y, z) = ⟨z - y, 2y - z, xy⟩$ and the surface $S$ defined by $z = x + y$ for $0 \\le x \\le 4$ and $-2 \\le y \\le 3$. Using the parametrization $x = u$ and $y = v$, the flux of $F$ through $S$ can be expressed as\n$∬_(S)F \\cdot dS = \\displaystyle \\int_{0}^{4}\\displaystyle \\int_{-2}^{3}AAAAAAAdvdu$.\nWhat is the missing expression?" #edb/ref 17592186045417] [17592186198593 #edb/ref 1072 #uuid "412e405b-c9a9-5a1c-8e85-45f26189dce3" #edb/ref 17592186045417] [17592186198594 #edb/ref 1068 #edb/ref 17592186277954 #edb/ref 17592186045417] [17592186198594 #edb/ref 1069 "q-160888" #edb/ref 17592186045417] [17592186198594 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186198594 #edb/ref 1071 "Evaluate the surface integral\n\n$$\n{∬}_{S}⟨z+y,\\,2y+z,\\,xy⟩\\cdot \\text{d}S\n$$\n\nwhere the surface $S$ is defined by $z=x-y$ for $0\\le x\\le 1$ and $0\\le y\\le 2.$" #edb/ref 17592186045417] [17592186198594 #edb/ref 1072 #uuid "dd29749c-bfb5-5726-8ec7-04f9f714fe37" #edb/ref 17592186045417] [17592186198594 #edb/ref 1074 "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of a vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(x-y)=1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(x-y)=-1\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(x,y,g(x,y)) & =⟨z+y,\\,2y+z,\\,xy⟩{|}_{z=x-y} \\\\  & =⟨(x-y)+y,\\,2y+(x-y),\\,xy⟩ \\\\  & =⟨{{x}_{⏟}}_{P},\\,{{x+y}_{⏟}}_{Q},\\,{{xy}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nTherefore, we can evaluate our surface integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}⟨z+y,\\,2y+z,\\,xy⟩\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(x)\\cdot 1-(x+y)\\cdot (-1)+xy)\\,\\text{d}A \\\\  & ={∬}_{D}(-x+x+y+xy)\\,\\text{d}A \\\\  & ={∬}_{D}(y+xy)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}(y+xy)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{[\\frac{1}{2}{y}^{2}+\\frac{1}{2}x{y}^{2}]}_{y=0}^{y=2}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(2+2x)\\,\\text{d}x \\\\  & =[2x+{x}^{2}]_{0}^{1} \\\\  & =(2(1)+{1}^{2})-0 \\\\  & =3.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186199282 #edb/ref 1061 44281 #edb/ref 17592186045417] [17592186199282 #edb/ref 1062 #uuid "034ca782-bf48-515e-9d4a-b38a7f58ef97" #edb/ref 17592186045417] [17592186199282 #edb/ref 1063 #edb/ref 17592186198379 #edb/ref 17592186045417] [17592186199295 #edb/ref 1058 #edb/ref 17592186199300 #edb/ref 17592186045417] [17592186199295 #edb/ref 1061 44435 #edb/ref 17592186045417] [17592186199295 #edb/ref 1062 #uuid "3c9cbe38-cd8a-58ac-be23-3f2812d3a11e" #edb/ref 17592186045417] [17592186199295 #edb/ref 1063 #edb/ref 17592186198389 #edb/ref 17592186045417] [17592186199299 #edb/ref 1058 #edb/ref 17592186199282 #edb/ref 17592186045417] [17592186199299 #edb/ref 1061 44446 #edb/ref 17592186045417] [17592186199299 #edb/ref 1062 #uuid "4ec0f874-f1a4-5c03-8a41-bf094ee7ee97" #edb/ref 17592186045417] [17592186199299 #edb/ref 1063 #edb/ref 17592186198392 #edb/ref 17592186045417] [17592186199300 #edb/ref 1058 #edb/ref 17592186199299 #edb/ref 17592186045417] [17592186199300 #edb/ref 1061 44449 #edb/ref 17592186045417] [17592186199300 #edb/ref 1062 #uuid "299c6f48-c761-519a-8d96-161fea9d6df0" #edb/ref 17592186045417] [17592186199300 #edb/ref 1063 #edb/ref 17592186199470 #edb/ref 17592186045417] [17592186199306 #edb/ref 1058 #edb/ref 17592186199295 #edb/ref 17592186045417] [17592186199306 #edb/ref 1061 44522 #edb/ref 17592186045417] [17592186199306 #edb/ref 1062 #uuid "dd32837c-4771-57ff-abbc-360334e17eeb" #edb/ref 17592186045417] [17592186199306 #edb/ref 1063 #edb/ref 17592186199473 #edb/ref 17592186045417] [17592186199470 #edb/ref 1064 "Let's now derive a general formula for the flux through an *upward-oriented* Cartesian surface.\n\nFor a surface $S$ with parametrization $\\mathbf{r}(u,v)$ for $(u,v) \\in D,$ the flux of a vector field $\\mathbf{F}$ over $S$ is given by\n\n$$\n\\iint\\limits_S \\mathbf{F} \\cdot \\textrm{d}\\mathbf{S}\n=\n\\iint\\limits_S \\mathbf{F} \\cdot \\mathbf{n} \\,\\textrm{d}S\n=\n\\iint\\limits_D \\mathbf{F}(\\mathbf{r}(u,v)) \\cdot (\\mathbf{r}'_u \\times \\mathbf{r}'_v) \\,\\textrm{d}A.\n$$\n\nConsider a surface $S$ given by the equation $z=g(x,y).$ The canonical parameterization of the surface is\n\n$$\n\\mathbf{r}(x,y) = \\left\\langle x,\\: y,\\: g(x,y) \\right\\rangle.\n$$\n\nComputing the tangent vectors to the grid curves, we get\n\n$$\n\\begin{aligned}{r}_{x}^{'} & =⟨1,\\,0,\\,\\frac{∂g}{∂x}⟩ \\\\ {r}_{y}^{'} & =⟨0,\\,1,\\,\\frac{∂g}{∂y}⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{'}\\times {r}_{y}^{'} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & \\frac{∂g}{∂x} \\\\ 0 & 1 & \\frac{∂g}{∂y}\\end{aligned}|=⟨-\\frac{∂g}{∂x},\\,-\\frac{∂g}{∂y},\\,1⟩.\\end{aligned}\n$$\n\nNotice that the $\\mathbf k$-component is positive, which indicates that our surface is upward-oriented.\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(x,y))\\cdot ({r}_{x}^{'}\\times {r}_{y}^{'})\\,\\text{d}A \\\\  & ={∬}_{D}⟨P,\\,Q,\\,R⟩\\cdot ⟨-\\frac{∂g}{∂x},\\,-\\frac{∂g}{∂y},\\,1⟩\\,\\text{d}A \\\\  & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\,\\text{d}A.\\end{aligned}\n$$\n\nWe summarize as follows:\n\n- *For a surface $S$ given by $z = g(x,y)$ for $(x,y) \\in D,$ the flux of a vector field $\\mathbf{F}(x,y,z) = \\left\\langle P,\\: Q,\\: R \\right\\rangle$ over $S$ is given by*\n\n$$\n\\iint\\limits_S \\mathbf{F} \\cdot \\textrm{d}\\mathbf{S}\n=\n\\iint\\limits_D \\left( -P\\dfrac{\\partial g}{\\partial x} - Q\\dfrac{\\partial g}{\\partial y} + R \\right) \\textrm{d}A.\n$$\n\nWe have analogous results for surfaces of the form $y = h(x,z)$ and $x=k(y,z){:}$\n\n- *For a surface $S$ given by $y = h(x,z)$ for $(x,z) \\in D,$ the flux of a vector field $\\mathbf{F}(x,y,z) = \\left\\langle P,\\: Q,\\: R \\right\\rangle$ over $S$ is given by*\n\n$$\n\\iint\\limits_S \\mathbf{F} \\cdot \\textrm{d}\\mathbf{S}\n=\n\\iint\\limits_D \\left( -P\\dfrac{\\partial h}{\\partial x} + Q - R\\dfrac{\\partial h}{\\partial z} \\right) \\textrm{d}A,\n$$\n\n*where the unit normal to the surface is chosen such that the $\\mathbf j$-component is positive.*\n\n- *For a surface $S$ given $x = k(y,z)$ for $(y,z) \\in D,$ the flux of a vector field $\\mathbf{F}(x,y,z) = \\left\\langle P,\\: Q,\\: R \\right\\rangle$ over $S$ is given by*\n\n$$\n\\iint\\limits_S \\mathbf{F} \\cdot \\textrm{d}\\mathbf{S}\n=\n\\iint\\limits_D \\left( P - Q\\dfrac{\\partial k}{\\partial y} - R\\dfrac{\\partial k}{\\partial z} \\right) \\textrm{d}A,\n$$\n\n*where the unit normal to the surface is chosen such that the $\\mathbf i$-component is positive.*" #edb/ref 17592186045417] [17592186199470 #edb/ref 1065 7653 #edb/ref 17592186045417] [17592186199470 #edb/ref 1066 #uuid "d20203b0-e15f-5061-ae68-16676ec933dc" #edb/ref 17592186045417] [17592186199470 #edb/ref 1067 "Formulas for Flux Over Cartesian Surfaces" #edb/ref 17592186045417] [17592186199473 #edb/ref 1064 "Let's calculate the flux of the vector field\n\n$$\n\\mathbf{F}(x,y,z)=\\left\\langle (x-y)^2, \\:(x+y)^2, \\: 12xy \\right\\rangle\n$$\n\n \n\nthrough the surface $S$ defined by the Cartesian equation \n\n$$\nz=2y-2x\n$$\n\nfor $0 \\leq x \\leq 1$ and $0 \\leq y \\leq 1.$ \n\nFor surfaces like this, substituting $x=u$ and $y=v,$ we obtain a parametrization \n\n$$\n\\mathbf{r}(u,v) = \\left\\langle u,\\: v,\\: 2v-2u \\right\\rangle\n$$\n\nover the domain \n\n$$\nD = \\big\\{ (u,v) \\: : \\: 0 \\leq u \\leq 1, \\: 0 \\leq v \\leq 1 \\big\\}.\n$$\n\n \n\nRecall that for a surface $S$ with parametrization $\\mathbf{r}(u,v)$ for $(u,v) \\in D,$ the flux of a vector field $\\mathbf{F}$ over $S$ is given by\n\n$$\n\\iint\\limits_S \\mathbf{F} \\cdot \\textrm{d}\\mathbf{S}\n=\n\\iint\\limits_S \\mathbf{F} \\cdot \\mathbf{n} \\,\\textrm{d}S\n=\n\\iint\\limits_D \\mathbf{F}(\\mathbf{r}(u,v)) \\cdot (\\mathbf{r}'_u \\times \\mathbf{r}'_v) \\,\\textrm{d}A.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{'} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(2v-2u)⟩ \\\\  & =⟨1,\\,0,\\,-2⟩ \\\\ {r}_{v}^{'} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(2v-2u)⟩ \\\\  & =⟨0,\\,1,\\,2⟩\\end{aligned}\n$$\n\nSo, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{'}\\times {r}_{v}^{'} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & -2 \\\\ 0 & 1 & 2\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & -2 \\\\ 1 & 2\\end{aligned}|,\\,-|\\begin{aligned}1 & -2 \\\\ 0 & 2\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨2,\\,-2,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $\\mathbf{r}(u,v)$ into $\\mathbf{F}(x,y,z){:}$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨(x-y)^{2},\\,(x+y)^{2},\\,12xy⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=2v-2u} \\\\  & =⟨(u-v)^{2},\\,(u+v)^{2},\\,12uv⟩\\end{aligned}\n$$\n\nThen, we calculate the dot product of $\\mathbf{F}$ and $\\mathbf{r}'_u \\times \\mathbf{r}'_v{:}$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{'}\\times {r}_{v}^{'}) & =⟨(u-v)^{2},\\,(u+v)^{2},\\,12uv⟩\\cdot ⟨2,\\,-2,\\,1⟩ \\\\  & =(u-v)^{2}\\cdot 2+(u+v)^{2}\\cdot (-2)+12uv\\cdot 1 \\\\  & =4uv.\\end{aligned}\n$$\n\nTherefore, the flux of $\\mathbf F$ through $S$ is given by\n\n$$\n\\begin{aligned}{∬}_{S}⟨(x-y)^{2},\\,(x+y)^{2},\\,12xy⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{'}\\times {r}_{v}^{'})\\,\\text{d}A \\\\  & ={∬}_{D}4uv\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}4uv\\,\\text{d}v\\,\\text{d}u \\\\  & ={\\int }_{0}^{1}2u\\,\\text{d}u\\cdot {\\int }_{0}^{1}2v\\,\\text{d}v \\\\  & =[{u}^{2}]_{0}^{1}\\cdot [{v}^{2}]_{0}^{1} \\\\  & =({1}^{2}-{0}^{2})\\cdot ({1}^{2}-{0}^{2}) \\\\  & =1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186199473 #edb/ref 1065 7666 #edb/ref 17592186045417] [17592186199473 #edb/ref 1066 #uuid "f32d6993-cd62-5fe7-98f3-9a89a815dbfc" #edb/ref 17592186045417] [17592186199473 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186275638 #edb/ref 1080 "-Q,\\text{ }\\frac{∂k}{∂z},\\text{ }\\frac{∂k}{∂y}" #edb/ref 17592186045417] [17592186275638 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186275638 #edb/ref 1083 #uuid "11e71243-92a0-5d43-b5a3-d37e9d9577d3" #edb/ref 17592186045417] [17592186275639 #edb/ref 1080 "\\frac{4{e}^{2}-8e}{8}" #edb/ref 17592186045417] [17592186275639 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186275639 #edb/ref 1083 #uuid "11f73d79-8055-5bca-ad98-afa9fe1eca21" #edb/ref 17592186045417] [17592186275684 #edb/ref 1080 "\\pi +\\frac{{\\pi }^{2}}{3}" #edb/ref 17592186045417] [17592186275684 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186275684 #edb/ref 1083 #uuid "15f8ea45-7189-5de7-b023-513085bc87a0" #edb/ref 17592186045417] [17592186275687 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186275687 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186275687 #edb/ref 1083 #uuid "16be5565-2c3b-5f69-b524-980e1e2bf3d1" #edb/ref 17592186045417] [17592186275692 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186275692 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186275692 #edb/ref 1083 #uuid "17111300-baf7-5ae1-b074-f80c3453c930" #edb/ref 17592186045417] [17592186275694 #edb/ref 1080 "-Q