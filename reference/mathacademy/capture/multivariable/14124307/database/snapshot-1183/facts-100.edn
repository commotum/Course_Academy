6423118 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186423118 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186423118 #edb/ref 1078 #edb/ref 17592186423091 #edb/ref 17592186045417] [17592186423118 #edb/ref 1079 #uuid "dce1231b-682c-5119-8b60-1e600b81511c" #edb/ref 17592186045417] [17592186423119 #edb/ref 1075 #edb/ref 17592186423090 #edb/ref 17592186045417] [17592186423119 #edb/ref 1075 #edb/ref 17592186423099 #edb/ref 17592186045417] [17592186423119 #edb/ref 1075 #edb/ref 17592186423101 #edb/ref 17592186045417] [17592186423119 #edb/ref 1075 #edb/ref 17592186423103 #edb/ref 17592186045417] [17592186423119 #edb/ref 1075 #edb/ref 17592186423105 #edb/ref 17592186045417] [17592186423119 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186423119 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186423119 #edb/ref 1078 #edb/ref 17592186423103 #edb/ref 17592186045417] [17592186423119 #edb/ref 1079 #uuid "de6e4169-2fd0-5a0b-b7fe-172964aca58f" #edb/ref 17592186045417] [17592186423120 #edb/ref 1068 #edb/ref 17592186423116 #edb/ref 17592186045417] [17592186423120 #edb/ref 1069 "q-161377" #edb/ref 17592186045417] [17592186423120 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186423120 #edb/ref 1071 "Consider the vector field $F(x,y,z)=⟨{x}^{2}-{y}^{2},\\,{y}^{2}-{z}^{2},\\,{z}^{2}⟩$ and the surface $S$ defined by $z=-x-y$ for $-2\\le x\\le 2$ and $-2\\le y\\le 2.$ Using the parametrization $x=u$ and $y=v,$ the flux of $F$ through $S$ can be expressed as\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={\\int }_{-2}^{2}{\\int }_{-2}^{2}\\boxed{}\\,\\text{d}v\\,\\text{d}u.\n$$\n\nWhat is the missing expression?" #edb/ref 17592186045417] [17592186423120 #edb/ref 1072 #uuid "29805411-7a4c-51f7-893d-a0f3dc3cef10" #edb/ref 17592186045417] [17592186423120 #edb/ref 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,-u-v⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,-2\\le u\\le 2,\\,-2\\le v\\le 2\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(-u-v)⟩ \\\\  & =⟨1,\\,0,\\,-1⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(-u-v)⟩ \\\\  & =⟨0,\\,1,\\,-1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & -1 \\\\ 0 & 1 & -1\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & -1 \\\\ 1 & -1\\end{aligned}|,\\,-|\\begin{aligned}1 & -1 \\\\ 0 & -1\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨1,\\,1,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨{x}^{2}-{y}^{2},\\,{y}^{2}-{z}^{2},\\,{z}^{2}⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=-u-v} \\\\  & =⟨{u}^{2}-{v}^{2},\\,{v}^{2}-(-u-v)^{2},\\,(-u-v)^{2}⟩\\end{aligned}\n$$\n\n \n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨{u}^{2}-{v}^{2},\\,{v}^{2}-(-u-v)^{2},\\,(-u-v)^{2}⟩\\cdot ⟨1,\\,1,\\,1⟩ \\\\  & =({u}^{2}-{v}^{2})\\cdot (1)+({v}^{2}-(-u-v)^{2})\\cdot (1)+(-u-v)^{2}\\cdot 1 \\\\  & ={u}^{2}-{v}^{2}+{v}^{2}-(-u-v)^{2}+(-u-v)^{2} \\\\  & ={u}^{2}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨{x}^{2}-{y}^{2},\\,{y}^{2}-{z}^{2},\\,{z}^{2}⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}{u}^{2}\\,\\text{d}A \\\\  & ={\\int }_{-2}^{2}{\\int }_{-2}^{2}{u}^{2}\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186423121 #edb/ref 1068 #edb/ref 17592186423117 #edb/ref 17592186045417] [17592186423121 #edb/ref 1069 "q-161449" #edb/ref 17592186045417] [17592186423121 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186423121 #edb/ref 1071 "For a surface $S$ given by $z={x}^{2}y$ for $(x,y)\\in D,$ the flux of the vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(\\bbox[3pt,border:1pt solid black]{\\phantom{A}}\\,xy+\\bbox[3pt,border:1pt solid black]{\\phantom{A}}\\,{x}^{2}+R)\\,\\text{d}A.\n$$\n\nFrom left to right, what are the missing parts of the formula?" #edb/ref 17592186045417] [17592186423121 #edb/ref 1072 #uuid "431ed508-ca53-50c3-b7a4-875fc9b23084" #edb/ref 17592186045417] [17592186423121 #edb/ref 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nSince our surface $S$ is of the form $z={x}^{2}y,$ it can be parameterized as\n\n$$\nr(x,y)=⟨x,\\,y,\\,{x}^{2}y⟩.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨1,\\,0,\\,2xy⟩ \\\\ {r}_{y}^{′} & =⟨0,\\,1,\\,{x}^{2}⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{y}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 2xy \\\\ 0 & 1 & {x}^{2}\\end{aligned}|=⟨-2xy,\\,-{x}^{2},\\,1⟩.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(x,y))\\cdot ({r}_{x}^{′}\\times {r}_{y}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}⟨P,\\,Q,\\,R⟩\\cdot ⟨-2xy,\\,-{x}^{2},\\,1⟩\\,\\text{d}A \\\\  & ={∬}_{D}(-2P\\,xy+(\\,-Q\\,)\\,{x}^{2}+R)\\,\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186423122 #edb/ref 1068 #edb/ref 17592186423115 #edb/ref 17592186045417] [17592186423122 #edb/ref 1069 "q-162607" #edb/ref 17592186045417] [17592186423122 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186423122 #edb/ref 1071 "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of the vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(-P\\frac{∂g}{\\bbox[3pt,border:1pt solid black]{\\phantom{A}}}-Q\\frac{\\bbox[3pt,border:1pt solid black]{\\phantom{A}}}{∂y}+\\bbox[3pt,border:1pt solid black]{\\phantom{A}})\\,\\text{d}A.\n$$\n\nFrom left to right, what are the missing parts of the formula?" #edb/ref 17592186045417] [17592186423122 #edb/ref 1072 #uuid "5b08ff1d-1edf-523c-a8e8-287f135b6040" #edb/ref 17592186045417] [17592186423122 #edb/ref 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nSince our surface $S$ is of the form $z=g(x,y),$ it can be parameterized as\n\n$$\nr(x,y)=⟨x,\\,y,\\,g(x,y)⟩.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨1,\\,0,\\,\\frac{∂g}{∂x}⟩ \\\\ {r}_{y}^{′} & =⟨0,\\,1,\\,\\frac{∂g}{∂y}⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{y}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & \\frac{∂g}{∂x} \\\\ 0 & 1 & \\frac{∂g}{∂y}\\end{aligned}|=⟨-\\frac{∂g}{∂x},\\,-\\frac{∂g}{∂y},\\,1⟩.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(x,y))\\cdot ({r}_{x}^{′}\\times {r}_{y}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}⟨P,\\,Q,\\,R⟩\\cdot ⟨-\\frac{∂g}{∂x},\\,-\\frac{∂g}{∂y},\\,1⟩\\,\\text{d}A \\\\  & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\,\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186423123 #edb/ref 1068 #edb/ref 17592186423118 #edb/ref 17592186045417] [17592186423123 #edb/ref 1069 "q-161379" #edb/ref 17592186045417] [17592186423123 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186423123 #edb/ref 1071 "Consider the vector field $F(x,y,z)=⟨(x+y)^{2},\\,(x-y)^{2},\\,xy⟩$ and the surface $S$ defined by $z=y-x$ for $-1\\le x\\le 1$ and $-3\\le y\\le 0.$ Using the parametrization $x=u$ and $y=v,$ the flux of $F$ through $S$ can be expressed as\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={\\int }_{-1}^{1}{\\int }_{-3}^{0}\\boxed{}\\,\\text{d}v\\,\\text{d}u.\n$$\n\nWhat is the missing expression?" #edb/ref 17592186045417] [17592186423123 #edb/ref 1072 #uuid "92e8ddd2-ccb6-5c20-b74b-2f784e857a55" #edb/ref 17592186045417] [17592186423123 #edb/ref 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,v-u⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,-1\\le u\\le 1,\\,-3\\le v\\le 0\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(v-u)⟩ \\\\  & =⟨1,\\,0,\\,-1⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(v-u)⟩ \\\\  & =⟨0,\\,1,\\,1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & -1 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & -1 \\\\ 1 & 1\\end{aligned}|,\\,-|\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨1,\\,-1,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨(x+y)^{2},\\,(x-y)^{2},\\,xy⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=v-u} \\\\  & =⟨(u+v)^{2},\\,(u-v)^{2},\\,uv⟩\\end{aligned}\n$$\n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨(u+v)^{2},\\,(u-v)^{2},\\,uv⟩\\cdot ⟨1,\\,-1,\\,1⟩ \\\\  & =(u+v)^{2}\\cdot 1+(u-v)^{2}\\cdot (-1)+uv\\cdot 1 \\\\  & =5uv.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨(x+y)^{2},\\,(x-y)^{2},\\,xy⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(5uv)\\,\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{-3}^{0}5uv\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186423124 #edb/ref 1068 #edb/ref 17592186423119 #edb/ref 17592186045417] [17592186423124 #edb/ref 1069 "q-161471" #edb/ref 17592186045417] [17592186423124 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186423124 #edb/ref 1071 "Consider the vector field $F(x,y,z)=⟨x+z,\\,2z,\\,y+z⟩$ and the surface $S$ defined by $z=x-3y$ for $-1\\le x\\le 2$ and $-1\\le y\\le 3.$ Using the parametrization $x=u$ and $y=v,$ the flux of $F$ through $S$ can be expressed as\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={\\int }_{-1}^{2}{\\int }_{-1}^{3}\\boxed{}\\,\\text{d}v\\,\\text{d}u.\n$$\n\nWhat is the missing expression?" #edb/ref 17592186045417] [17592186423124 #edb/ref 1072 #uuid "ef91d27f-5ce3-5c48-b5b9-4ec732b3b2e1" #edb/ref 17592186045417] [17592186423124 #edb/ref 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,u-3v⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,-1\\le u\\le 2,\\,-1\\le v\\le 3\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(u-3v)⟩ \\\\  & =⟨1,\\,0,\\,1⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(u-3v)⟩ \\\\  & =⟨0,\\,1,\\,-3⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 1 \\\\ 0 & 1 & -3\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & 1 \\\\ 1 & -3\\end{aligned}|,\\,-|\\begin{aligned}1 & 1 \\\\ 0 & -3\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨-1,\\,3,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨x+z,\\,2z,\\,y+z⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=u-3v} \\\\  & =⟨u+u-3v,\\,2(u-3v),\\,v+u-3v⟩ \\\\  & =⟨2u-3v,\\,2u-6v,\\,u-2v⟩\\end{aligned}\n$$\n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨2u-3v,\\,2u-6v,\\,u-2v⟩\\cdot ⟨-1,\\,3,\\,1⟩ \\\\  & =(2u-3v)\\cdot (-1)+(2u-6v)\\cdot (3)+(u-2v)\\cdot 1 \\\\  & =-2u+3v+6u-18v+u-2v \\\\  & =5u-17v.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨z-y,\\,2y-z,\\,xy⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(5u-17v)\\,\\text{d}A \\\\  & ={\\int }_{-1}^{2}{\\int }_{-1}^{3}(5u-17v)\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$" #edb/ref 17592186045417]}
