/mspace></mstyle><mn>1</mn><mo data-mjx-texclass=\"CLOSE\">⟩</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>A</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">∬</mo><mi>D</mi></munder><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.470em\" maxsize=\"2.470em\">(</mo></mrow><mo>−</mo><mi>P</mi><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>∂</mi><mi>g</mi></mrow><mstyle style=\"border:1pt solid black\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mi>∂</mi><mi>x</mi></mstyle></mpadded></mstyle></mfrac></mstyle><mo>−</mo><mi>Q</mi><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mstyle style=\"border:1pt solid black\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mi>∂</mi><mi>g</mi></mstyle></mpadded></mstyle><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac></mstyle><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mstyle style=\"border:1pt solid black\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mi>R</mi></mstyle></mpadded></mstyle></mrow><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.470em\" maxsize=\"2.470em\">)</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>A</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
