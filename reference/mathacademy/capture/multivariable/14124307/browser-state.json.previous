text>d</mtext><mi>x</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></msubsup><mo stretchy=\"false\">(</mo><mn>2</mn><mo>+</mo><mn>2</mn><mi>x</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">[</mo></mrow><mn>2</mn><mi>x</mi><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><msubsup><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">]</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>+</mo><msup><mn>1</mn><mn>2</mn></msup><mo stretchy=\"false\">)</mo><mo>−</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
