f 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449590} {:answer/id #uuid "42e23434-b855-57e0-a5e5-feab08f636f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449591}] :answer-field/correct {:answer/id #uuid "ea8085ac-e799-5424-8198-147afdc52305" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449590} :answer-field/id #uuid "8ee94435-98e2-554c-8d74-17c95d5c7950" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450749}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "47d1848e-d69a-5675-a8fe-fca5e30be264" :question/math-academy-id "q-140838" :question/problem "If $A$ is a $2\\times 2$ matrix and $\\lambda =-4$ is an eigenvalue of $A,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $(A+4I)x=0$ has a nonzero solution\n- **II.** $\\text{Col}(A+4I)={R}^{2}$\n- **III.** $\\text{nullity}(A+4I)=0$" :question/worked-solution "Given a $2\\times 2$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{2} \\\\  & \\text{dim(Col}(M))=2=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nLet's now apply the theorem to the matrix $M=A+4I.$\n\n- Statement I is true. Notice that if $\\lambda =4$ is an eigenvalue of $A,$ then the nonzero solutions of $(A+4I)x=0$ are eigenvectors of $A.$ As a result, the matrix $M=A+4I$ must be singular.\n\n- Statements II and III are false. Since $M=A+4I$ is singular, by the invertible matrix theorem, we obtain that\n\n$$\n\\text{Col}(A+4I)\\ne {R}^{2},\n$$\n\nand \n\n$$\n\\text{nullity}(A+4I)\\ne 0.\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186272161 :knowledge-point/_questions [{:db/id #edb/ref 17592186124529 :knowledge-point/id #uuid "30d1a3a3-a6f0-522c-9161-6dc0fefb2e0d" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix and Rank-Nullity Theorems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8814293-c8a9-578f-8657-39a79ba1371c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449592} {:answer/id #uuid "9bfdb8f8-d8cb-528e-b9a4-cc0c1b63c6e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449593}] :answer-field/correct {:answer/id #uuid "9bfdb8f8-d8cb-528e-b9a4-cc0c1b63c6e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449593} :answer-field/id #uuid "4178ebcf-70fd-5899-ba5f-d287bb465aff" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450750} {:answer-field/choices [{:answer/id #uuid "07fbd334-3cb4-5c97-bc5d-e7ad07664145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449594} {:answer/id #uuid "86749cb9-992d-5952-84f4-2774168aaffe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449595}] :answer-field/correct {:answer/id #uuid "07fbd334-3cb4-5c97-bc5d-e7ad07664145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449594} :answer-field/id #uuid "f0ed7cb0-5034-527d-8e0b-18cfb88e3287" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450751} {:answer-field/choices [{:answer/id #uuid "80c3ee31-dad8-510e-a6f6-7b0ff0870e77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186449596} {:answer/id #uuid "52e36725-146c-55d1-82ce-88952ae9ecda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449597}] :answer-field/correct {:answer/id #uuid "52e36725-146c-55d1-82ce-88952ae9ecda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186449597} :answer-field/id #uuid "e0b37f56-b08e-5b30-9546-ef7378db28c7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186450752}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f77ae0b2-0cbc-5c99-a8dc-82a79dae8fdc" :question/math-academy-id "q-140840" :question/problem "If $A$ is a $2\\times 2$ matrix and $\\text{rank}(A-7I)=0,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A-7I$ is singular\n- **II.** $\\text{nullity}(A-7I)=0$\n- **III.** $\\lambda =7$ is an eigenvalue of $A$" :question/worked-solution "Given a $2\\times 2$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{2} \\\\  & \\text{dim(Col}(M))=2=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $M$ has $2$ columns, then \n\n$$\n\\text{rank}(M)+\\text{nullity}(M)=2.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statements I is true. By the invertible matrix theorem, since $\\text{nullity}(A-7I)\\ne 0,$ we obtain that $A-7I$ must be singular.\n\n- Statement II is false. According to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(A-7I) & =2-\\text{rank}(A-7I) \\\\  & =2-0 \\\\  & =2.\\end{aligned}\n$$\n\n- Statement III is true. Notice that if $M=A-7I$ is singular, then $(A-7I)x=0$ has nonzero solutions which will be eigenvectors of $A.$ As a result, $\\lambda =7$ is an eigenvalue of $A.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186362249 :knowledge-point/_questions [{:db/id #edb/ref 17592186124605 :knowledge-point/id #uuid "c34e7d59-6bb4-5c2f-808f-212503d55338" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6786d395-a50b-5882-ae31-36863216b6c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452449} {:answer/id #uuid "724b23f9-2a73-506f-899d-a1e9be5b76dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452450}] :answer-field/correct {:answer/id #uuid "724b23f9-2a73-506f-899d-a1e9be5b76dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452450} :answer-field/id #uuid "3e20e3ee-4bcc-5a2e-9b67-c327aaad4254" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453072} {:answer-field/choices [{:answer/id #uuid "a2209fa5-8e22-578c-b332-194b1ee18867" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452451} {:answer/id #uuid "558318e4-8fd5-5b1a-836d-4e23c5796f09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452452}] :answer-field/correct {:answer/id #uuid "a2209fa5-8e22-578c-b332-194b1ee18867" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452451} :answer-field/id #uuid "5bbe6d9a-5be5-5570-b069-1d4b26576b7f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453073} {:answer-field/choices [{:answer/id #uuid "0bb34267-89b0-514a-80f5-0d7551327ba7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452453} {:answer/id #uuid "d47f5619-55b0-58a2-956d-cdc273e67787" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452454}] :answer-field/correct {:answer/id #uuid "d47f5619-55b0-58a2-956d-cdc273e67787" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452454} :answer-field/id #uuid "cb9c7957-4ff2-56ba-b4c6-6215b77fcd71" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453074}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6fdd6535-d1b6-5f9c-9675-a9cfd3d10476" :question/math-academy-id "q-97946" :question/problem "If $B$ is a $4\\times 4$ matrix and $\\lambda =4$ is an eigenvalue of $B,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $(B-4I)x=0$ has a nonzero solution\n- **II.** $\\text{rank}(B-4I)=4$\n- **III.** $\\text{nullity}(B-4I)\\ne 0$" :question/worked-solution "Given a $4\\times 4$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{4} \\\\  & \\text{dim(Col}(M))=4=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nLet's now apply the theorem to the matrix $M=B-4I.$\n\n- Statement I is true. Notice that if $\\lambda =4$ is an eigenvalue of $B,$ then the nonzero solutions of $(B-4I)x=0$ are eigenvectors of $B.$ As a result, the matrix $M=B-4I$ must be singular.\n\n- Statement II is false. Since $M=B-4I$ is singular, by the invertible matrix theorem, we obtain that\n\n$$\n\\text{rank}(B-4I)\\ne 4.\n$$\n\n- Statement III is true. Since $M=B-4I$ is singular, by the invertible matrix theorem, we obtain that\n\n$$\n\\text{nullity}(B-4I)\\ne 0.\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186362252 :knowledge-point/_questions [{:db/id #edb/ref 17592186124605 :knowledge-point/id #uuid "c34e7d59-6bb4-5c2f-808f-212503d55338" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9837a523-42e0-533a-a0dd-b42b2ad407d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452461} {:answer/id #uuid "7952bb3e-1500-544d-a00b-8d59f4c87d8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452462}] :answer-field/correct {:answer/id #uuid "7952bb3e-1500-544d-a00b-8d59f4c87d8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452462} :answer-field/id #uuid "6f4c341a-3666-5cd8-9f18-b1da0ee0573a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453078} {:answer-field/choices [{:answer/id #uuid "bdeda81d-4c04-5009-bc27-1a8a0454cebb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452463} {:answer/id #uuid "da0e6b14-88e6-54aa-ad41-1dba2bdc0fc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452464}] :answer-field/correct {:answer/id #uuid "da0e6b14-88e6-54aa-ad41-1dba2bdc0fc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452464} :answer-field/id #uuid "d4c6c176-24dd-5b33-9a18-8161ff08d029" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453079} {:answer-field/choices [{:answer/id #uuid "288f57ed-f71f-52e4-aa4d-9812c1e3a401" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452465} {:answer/id #uuid "9f0d6501-f9de-5629-932b-a57f8dc171b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452466}] :answer-field/correct {:answer/id #uuid "288f57ed-f71f-52e4-aa4d-9812c1e3a401" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452465} :answer-field/id #uuid "ce30fe09-518e-5ee9-b44b-912d5a059e61" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453080}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1c970e5-75bc-5ce7-946f-a4ae8b32b111" :question/math-academy-id "q-97960" :question/problem "If $C$ is a $2\\times 2$ matrix and $\\lambda =1$ is an eigenvalue of $C,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $C-I$ is a singular matrix\n- **II.** $\\text{rank}(C-I)\\ne 2$\n- **III.** $\\text{nullity}(C-I)=0$" :question/worked-solution "Given a $2\\times 2$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{2} \\\\  & \\text{dim(Col}(M))=2=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nLet's now apply the theorem to the matrix $M=C-I.$\n\n- Statement I is true. Notice that if $\\lambda =1$ is an eigenvalue of $C,$ then the nonzero solutions of $(C-I)x=0$ are eigenvectors of $C.$ As a result, the matrix $M=C-I$ must be singular.\n\n- Statement II is true. Since $M=C-I$ is singular, by the invertible matrix theorem, we obtain that\n\n$$\n\\text{rank}(C-I)\\ne 2.\n$$\n\n- Statement III is false. Since $M=C-I$ is singular, by the invertible matrix theorem, we obtain that\n\n$$\n\\text{nullity}(C-I)\\ne 0.\n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186362254 :knowledge-point/_questions [{:db/id #edb/ref 17592186124529 :knowledge-point/id #uuid "30d1a3a3-a6f0-522c-9161-6dc0fefb2e0d" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix and Rank-Nullity Theorems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2cedf5f-ea78-598b-8fea-86eb4930a16e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452473} {:answer/id #uuid "ac501363-d562-542c-8971-fa619b64fb93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452474}] :answer-field/correct {:answer/id #uuid "ac501363-d562-542c-8971-fa619b64fb93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452474} :answer-field/id #uuid "6ed2e22e-171c-554d-a637-c726d3aaa309" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453084} {:answer-field/choices [{:answer/id #uuid "941dacde-a17c-5765-910f-5bc4839a1386" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452475} {:answer/id #uuid "5f487188-0cec-5f38-9e34-e190f507bb5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452476}] :answer-field/correct {:answer/id #uuid "5f487188-0cec-5f38-9e34-e190f507bb5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452476} :answer-field/id #uuid "611e09b5-b47a-5519-9300-6bc0ece8a2f0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453085} {:answer-field/choices [{:answer/id #uuid "0044e830-172d-574e-b097-e1ebe25e1adb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452477} {:answer/id #uuid "4200c14b-bbe6-5725-adaa-903da877df9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452478}] :answer-field/correct {:answer/id #uuid "0044e830-172d-574e-b097-e1ebe25e1adb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452477} :answer-field/id #uuid "2ef6a8d9-228c-5e0b-8e7a-462c8a409290" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453086}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "651bcec7-c2ce-52d1-b1e2-d8f7e6384008" :question/math-academy-id "q-97969" :question/problem "If $A$ is a $4\\times 4$ matrix and $\\text{rank}(A-3I)=4,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{nullity}(A-3I)=0$\n- **II.** $A-3I$ is invertible\n- **III.** $\\lambda =3$ is an eigenvalue of $A$" :question/worked-solution "Given a $4\\times 4$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{4} \\\\  & \\text{dim(Col}(M))=4=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $M$ has $4$ columns, then \n\n$$\n\\text{rank}(M)+\\text{nullity}(M)=4.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. According to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(A-3I) & =4-\\text{rank}(A-3I) \\\\  & =4-4 \\\\  & =0.\\end{aligned}\n$$\n\n- Statements II is true. By the invertible matrix theorem, since $\\text{nullity}(A-3I)=0,$ we obtain that $A-3I$ must be invertible.\n\n- Statement III is false. Notice that if $M=A-3I$ is invertible, then $(A-3I)x=0$ has only zero solution. As a result, $\\lambda =3$ can not be an eigenvalue of $A.$\n\nTherefore, the correct answer is \"I and II only.\""}]}
