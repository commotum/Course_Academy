              "value": "I only",
              "html": "I only"
            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-175354-b",
              "type": "text",
              "value": "I and II only",
              "html": "I and II only"
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-175354-c",
              "type": "text",
              "value": "II only",
              "html": "II only"
            },
            {
              "option": "d",
              "dom_id": "questionWidget-choiceLetterCircle-175354-d",
              "type": "text",
              "value": "I and III only",
              "html": "I and III only"
            },
            {
              "option": "e",
              "dom_id": "questionWidget-choiceLetterCircle-175354-e",
              "type": "text",
