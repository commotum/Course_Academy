[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186198279 :knowledge-point/questions ["question-b1aeeb90-b252-58b0-bd1f-5b12f471387e" "question-260f8856-8d02-57c2-89b0-9f4ad3929290" "question-b91cf75b-843d-5d15-ac06-6485f918c5af" "question-63a5ac6a-aab7-51ca-954b-e590d679441c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b1aeeb90-b252-58b0-bd1f-5b12f471387e" :question/id #uuid "b1aeeb90-b252-58b0-bd1f-5b12f471387e" :question/math-academy-id "q-175364" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $P(x):$ ${x}^{2}-8=2x$\n\nwhere the universal set is $R.$" :question/worked-solution "The *truth set* of a predicate $P(x)$ is the set of elements in its universal set $U$ such that substituting these elements for the variable makes the predicate a true statement:\n\n$$\nT=\\{x\\in U\\,|\\,P(x)\\}\n$$\n\nThe universal set for our predicate is $U=R.$\n\nWe need to find $x\\in U$ such that the following is true:\n\n$\\,$ ${x}^{2}-8=2x$\n\nNow, we solve the above equation by factoring:\n\n$$\n\\begin{aligned}{x}^{2}-8 & =2x \\\\ {x}^{2}-2x-8 & =0 \\\\ (x-4)(x+2) & =0\\end{aligned}\n$$\n\nSo, the solutions are $x=-2\\in R$ and $x=4\\in R.$\n\nTherefore, the truth set of our predicate is $T=\\{-2,4\\}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cf86a146-26ce-5ad8-bf9e-055735de44f5"] :db/ensure [:question/validate]} {:db/id "answer-field-cf86a146-26ce-5ad8-bf9e-055735de44f5" :answer-field/id #uuid "cf86a146-26ce-5ad8-bf9e-055735de44f5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-74b55427-77a5-5628-b490-8b51f45c46ac" :answer-field/choices ["answer-74b55427-77a5-5628-b490-8b51f45c46ac" "answer-4c9a04ac-26ec-5ead-8bb8-50236f13de94" "answer-2e5e32b3-c4e2-5b66-8f6f-22792540ff8d" "answer-aa928a83-e518-5b7c-90af-6f77aa25fe2a" "answer-a8dddfc1-8b64-58af-9ae6-c3ee7f6700d2"] :db/ensure [:answer-field/validate]} {:db/id "answer-74b55427-77a5-5628-b490-8b51f45c46ac" :answer/id #uuid "74b55427-77a5-5628-b490-8b51f45c46ac" :answer/type :answer.type/math :answer/value "\\{-2,4\\}" :db/ensure [:answer/validate]} {:db/id "answer-4c9a04ac-26ec-5ead-8bb8-50236f13de94" :answer/id #uuid "4c9a04ac-26ec-5ead-8bb8-50236f13de94" :answer/type :answer.type/math :answer/value "\\{-4,-2,2,4\\}" :db/ensure [:answer/validate]} {:db/id "answer-2e5e32b3-c4e2-5b66-8f6f-22792540ff8d" :answer/id #uuid "2e5e32b3-c4e2-5b66-8f6f-22792540ff8d" :answer/type :answer.type/math :answer/value "\\{-4,-2\\}" :db/ensure [:answer/validate]} {:db/id "answer-aa928a83-e518-5b7c-90af-6f77aa25fe2a" :answer/id #uuid "aa928a83-e518-5b7c-90af-6f77aa25fe2a" :answer/type :answer.type/math :answer/value "\\{2,4\\}" :db/ensure [:answer/validate]} {:db/id "answer-a8dddfc1-8b64-58af-9ae6-c3ee7f6700d2" :answer/id #uuid "a8dddfc1-8b64-58af-9ae6-c3ee7f6700d2" :answer/type :answer.type/math :answer/value "∅" :db/ensure [:answer/validate]} {:db/id "question-260f8856-8d02-57c2-89b0-9f4ad3929290" :question/id #uuid "260f8856-8d02-57c2-89b0-9f4ad3929290" :question/math-academy-id "q-175353" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $x$ is divisible by $3,$\n\nwhere the universal set is the set of integers from $5$ to $20$ inclusive." :question/worked-solution "The *truth set* $T$ of a predicate $P(x)$ is the set of elements in its universal set $U$ such that substituting these elements for the variable makes the predicate a true statement:\n\n$$\nT=\\{x\\in U\\,|\\,P(x)\\}\n$$\n\nThe universal set for our predicate is\n\n$$\nU=\\{5,6,…,20\\}.\n$$\n\nWe need to find $x\\in U$ such that the following is true:\n\n$\\,$ $x$ is divisible by $3.$\n\nThe following numbers give the elements of our truth set:\n\n- $x=6$ since $6$ is divisible by $3,$\n\n- $x=9$ since $9$ is divisible by $3,$\n\n- $x=12$ since $12$ is divisible by $3,$\n\n- $x=15$ since $15$ is divisible by $3,$\n\n- $x=18$ since $18$ is divisible by $3.$\n\nTherefore, the truth set of our predicate is\n\n$$\nT=\\{6,9,12,15,18\\}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cfa5d698-eb34-58cf-9780-238b5cb9eb58"] :db/ensure [:question/validate]} {:db/id "answer-field-cfa5d698-eb34-58cf-9780-238b5cb9eb58" :answer-field/id #uuid "cfa5d698-eb34-58cf-9780-238b5cb9eb58" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1ef07448-0b15-5f77-831a-c55328b61392" :answer-field/choices ["answer-342225e3-b744-59a4-a18e-552c1ed57177" "answer-c4b0a66d-4234-5ffe-8314-ca3a322857d3" "answer-1ef07448-0b15-5f77-831a-c55328b61392" "answer-c02e9e86-772c-50d4-8c6d-4c63a835a6f4" "answer-0b59d398-5c35-51d7-a940-fbf48c21c719"] :db/ensure [:answer-field/validate]} {:db/id "answer-342225e3-b744-59a4-a18e-552c1ed57177" :answer/id #uuid "342225e3-b744-59a4-a18e-552c1ed57177" :answer/type :answer.type/math :answer/value "\\{5,10,12,15\\}" :db/ensure [:answer/validate]} {:db/id "answer-c4b0a66d-4234-5ffe-8314-ca3a322857d3" :answer/id #uuid "c4b0a66d-4234-5ffe-8314-ca3a322857d3" :answer/type :answer.type/math :answer/value "\\{6,9,10,13,15\\}" :db/ensure [:answer/validate]} {:db/id "answer-1ef07448-0b15-5f77-831a-c55328b61392" :answer/id #uuid "1ef07448-0b15-5f77-831a-c55328b61392" :answer/type :answer.type/math :answer/value "\\{6,9,12,15,18\\}" :db/ensure [:answer/validate]} {:db/id "answer-c02e9e86-772c-50d4-8c6d-4c63a835a6f4" :answer/id #uuid "c02e9e86-772c-50d4-8c6d-4c63a835a6f4" :answer/type :answer.type/math :answer/value "\\{6,9,12,15\\}" :db/ensure [:answer/validate]} {:db/id "answer-0b59d398-5c35-51d7-a940-fbf48c21c719" :answer/id #uuid "0b59d398-5c35-51d7-a940-fbf48c21c719" :answer/type :answer.type/math :answer/value "\\{6,9,12\\}" :db/ensure [:answer/validate]} {:db/id "question-b91cf75b-843d-5d15-ac06-6485f918c5af" :question/id #uuid "b91cf75b-843d-5d15-ac06-6485f918c5af" :question/math-academy-id "q-175358" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $P(x):$ $4x-3\\ge 9,$\n\nwhere the universal set is $R.$" :question/worked-solution "The *truth set* of a predicate $P(x)$ is the set of elements in its universal set $U$ such that substituting these elements for the variable makes the predicate a true statement:\n\n$$\nT=\\{x\\in U\\,|\\,P(x)\\}\n$$\n\nWe need to find $x\\in U$ such that the following is true:\n\n$\\,$ $4x-3\\ge 9$\n\nThe universal set for our predicate is $U=R.$\n\nNow, we need to solve the above inequality:\n\n$$\n\\begin{aligned}4x-3\\ge 9 \\\\ 4x\\ge 12 \\\\ x\\ge 3\\end{aligned}\n$$\n\nTherefore, the truth set of our predicate is\n\n$$\nT=[3,\\infty ).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-20ae3d0b-c166-52e0-b469-1972d9f84ee6"] :db/ensure [:question/validate]} {:db/id "answer-field-20ae3d0b-c166-52e0-b469-1972d9f84ee6" :answer-field/id #uuid "20ae3d0b-c166-52e0-b469-1972d9f84ee6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e526436b-9a51-5f65-a668-0eb96ca49eb0" :answer-field/choices ["answer-ceb9044e-2366-52a5-89ec-803aba63111e" "answer-0b68889d-10d4-51c4-be9b-87b0c97af70e" "answer-6189dc4e-a81c-5882-83eb-6da2f69c3dcc" "answer-bace1e39-b96c-5598-91da-f2e30385e626" "answer-e526436b-9a51-5f65-a668-0eb96ca49eb0"] :db/ensure [:answer-field/validate]} {:db/id "answer-ceb9044e-2366-52a5-89ec-803aba63111e" :answer/id #uuid "ceb9044e-2366-52a5-89ec-803aba63111e" :answer/type :answer.type/math :answer/value "(-\\infty ,-3]" :db/ensure [:answer/validate]} {:db/id "answer-0b68889d-10d4-51c4-be9b-87b0c97af70e" :answer/id #uuid "0b68889d-10d4-51c4-be9b-87b0c97af70e" :answer/type :answer.type/math :answer/value "(-\\infty ,3)" :db/ensure [:answer/validate]} {:db/id "answer-6189dc4e-a81c-5882-83eb-6da2f69c3dcc" :answer/id #uuid "6189dc4e-a81c-5882-83eb-6da2f69c3dcc" :answer/type :answer.type/math :answer/value "[-3,3]" :db/ensure [:answer/validate]} {:db/id "answer-bace1e39-b96c-5598-91da-f2e30385e626" :answer/id #uuid "bace1e39-b96c-5598-91da-f2e30385e626" :answer/type :answer.type/math :answer/value "[-3,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-e526436b-9a51-5f65-a668-0eb96ca49eb0" :answer/id #uuid "e526436b-9a51-5f65-a668-0eb96ca49eb0" :answer/type :answer.type/math :answer/value "[3,\\infty )" :db/ensure [:answer/validate]} {:db/id 17592186198700 :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "question-63a5ac6a-aab7-51ca-954b-e590d679441c" :question/id #uuid "63a5ac6a-aab7-51ca-954b-e590d679441c" :question/math-academy-id "q-174455" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $P(x):$ ${x}^{2}\\ge -1$\n\nwhere the universal set is $N.$" :question/worked-solution "The *truth set* of a predicate $P(x)$ is the set of elements in its universal set $U$ such that substituting these elements for the variable makes the predicate a true statement:\n\n$$\nT=\\{x\\in U\\,|\\,P(x)\\}\n$$\n\nThe universal set for our predicate is $U=N.$\n\nWe need to find $x\\in U$ such that the following is true:\n\n$\\,$ ${x}^{2}\\ge -1$\n\nWe know that the square of any real number is greater than or equal to zero.\n\nSo, the inequality is true for every real number. In particular, it's true for every $x\\in N.$ \n\nTherefore, the truth set of our predicate is $T=N.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c66a38f3-27df-56d2-bf7d-219d907e9d61"] :db/ensure [:question/validate]} {:db/id "answer-field-c66a38f3-27df-56d2-bf7d-219d907e9d61" :answer-field/id #uuid "c66a38f3-27df-56d2-bf7d-219d907e9d61" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-28bc466a-f300-5f57-aec7-9770f3d2ff29" :answer-field/choices ["answer-2fa96fcc-d445-5126-bab7-2fc1e9c246b6" "answer-28bc466a-f300-5f57-aec7-9770f3d2ff29" "answer-49b6b7fb-0b48-59e8-9257-b19da9baea66" "answer-2849368e-65ae-57ea-a549-07c4abeb0fbf" "answer-caf2dff0-9187-5e23-869d-71431326dff5"] :db/ensure [:answer-field/validate]} {:db/id "answer-2fa96fcc-d445-5126-bab7-2fc1e9c246b6" :answer/id #uuid "2fa96fcc-d445-5126-bab7-2fc1e9c246b6" :answer/type :answer.type/math :answer/value "(-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-28bc466a-f300-5f57-aec7-9770f3d2ff29" :answer/id #uuid "28bc466a-f300-5f57-aec7-9770f3d2ff29" :answer/type :answer.type/math :answer/value "N" :db/ensure [:answer/validate]} {:db/id "answer-49b6b7fb-0b48-59e8-9257-b19da9baea66" :answer/id #uuid "49b6b7fb-0b48-59e8-9257-b19da9baea66" :answer/type :answer.type/math :answer/value "[-1,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-2849368e-65ae-57ea-a549-07c4abeb0fbf" :answer/id #uuid "2849368e-65ae-57ea-a549-07c4abeb0fbf" :answer/type :answer.type/math :answer/value "[0,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-caf2dff0-9187-5e23-869d-71431326dff5" :answer/id #uuid "caf2dff0-9187-5e23-869d-71431326dff5" :answer/type :answer.type/math :answer/value "∅" :db/ensure [:answer/validate]} {:db/id 17592186198280 :knowledge-point/questions ["question-9d2ae0ef-2e2b-52c8-a273-c086772b799e" "question-b5cdaff3-81ba-58ae-a27f-1dea94cd990d" "question-29e9adcf-4a5b-51ac-835b-f4a444c16f67"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9d2ae0ef-2e2b-52c8-a273-c086772b799e" :question/id #uuid "9d2ae0ef-2e2b-52c8-a273-c086772b799e" :question/math-academy-id "q-175354" :question/problem "Which of the following are mathematical predicates?\n\nI. $8$ divided by $t.$\n\nII. $y$ multiplied by $z.$\n\nIII. $p$ is a composite number." :question/worked-solution "A *predicate* of the variables ${x}_{1},{x}_{2},…,{x}_{n}$ is a sentence that contains the variables defined on some *universal set*, and has the property that when we substitute concrete values for all the variables into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is *not* a predicate. Substituting a concrete value for $t$ into the sentence, we do not get a statement that is either true or false.\n\n- Option II is *not* a predicate. Substituting a concrete pair of values $(y,z)$ into the sentence, we do not get a statement that is either true or false.\n\n- Option III is a predicate of one variable. Substituting a concrete value for $p$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9d057fd8-1279-514e-b87c-868f979ed1fa"] :db/ensure [:question/validate]} {:db/id "answer-field-9d057fd8-1279-514e-b87c-868f979ed1fa" :answer-field/id #uuid "9d057fd8-1279-514e-b87c-868f979ed1fa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-503d8faa-f079-5132-ade3-e4f9cc774644" :answer-field/choices ["answer-e6487afd-7bcc-5095-afa4-646349f2e953" "answer-f9fee152-d57a-5195-85ee-6823b5351b2c" "answer-6b6d8060-0176-5175-aa8f-1706ba311466" "answer-e08b2963-8bca-50ae-82c1-0c92043cecef" "answer-503d8faa-f079-5132-ade3-e4f9cc774644"] :db/ensure [:answer-field/validate]} {:db/id "answer-e6487afd-7bcc-5095-afa4-646349f2e953" :answer/id #uuid "e6487afd-7bcc-5095-afa4-646349f2e953" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-f9fee152-d57a-5195-85ee-6823b5351b2c" :answer/id #uuid "f9fee152-d57a-5195-85ee-6823b5351b2c" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-6b6d8060-0176-5175-aa8f-1706ba311466" :answer/id #uuid "6b6d8060-0176-5175-aa8f-1706ba311466" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-e08b2963-8bca-50ae-82c1-0c92043cecef" :answer/id #uuid "e08b2963-8bca-50ae-82c1-0c92043cecef" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-503d8faa-f079-5132-ade3-e4f9cc774644" :answer/id #uuid "503d8faa-f079-5132-ade3-e4f9cc774644" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-b5cdaff3-81ba-58ae-a27f-1dea94cd990d" :question/id #uuid "b5cdaff3-81ba-58ae-a27f-1dea94cd990d" :question/math-academy-id "q-175352" :question/problem "Which of the following are mathematical predicates?\n\nI. $q$ plus $3.$\n\nII. $2$ is greater than $x.$\n\nIII. $a$ is a divisor of $b.$" :question/worked-solution "A *predicate* of the variables ${x}_{1},{x}_{2},…,{x}_{n}$ is a sentence that contains the variables defined on some *universal set*, and has the property that when we substitute concrete values for all the variables into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is *not* a predicate. Substituting a concrete value for $q$ into the sentence, we do not get a statement that is either true or false.\n\n- Option II is a predicate of one variable. Substituting a concrete value for $x$ into the sentence, we get a statement that is either true or false.\n\n- Option III is a predicate of two variables. Substituting a concrete pair of values $(a,b)$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b08c9d99-93d0-59db-a882-7330c0dcbd51"] :db/ensure [:question/validate]} {:db/id "answer-field-b08c9d99-93d0-59db-a882-7330c0dcbd51" :answer-field/id #uuid "b08c9d99-93d0-59db-a882-7330c0dcbd51" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-397fc5d7-b754-5861-b332-469c54f6a149" :answer-field/choices ["answer-9ce84ceb-40f0-55b4-a8f2-42694ec7bec5" "answer-7ebde441-31ee-5c72-be00-ba395690a42b" "answer-f4b9e8c0-9717-5691-a9c7-25da739afc28" "answer-397fc5d7-b754-5861-b332-469c54f6a149" "answer-5154ad7e-edfc-5ac5-8a8b-a33d1faff605"] :db/ensure [:answer-field/validate]} {:db/id "answer-9ce84ceb-40f0-55b4-a8f2-42694ec7bec5" :answer/id #uuid "9ce84ceb-40f0-55b4-a8f2-42694ec7bec5" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-7ebde441-31ee-5c72-be00-ba395690a42b" :answer/id #uuid "7ebde441-31ee-5c72-be00-ba395690a42b" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-f4b9e8c0-9717-5691-a9c7-25da739afc28" :answer/id #uuid "f4b9e8c0-9717-5691-a9c7-25da739afc28" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-397fc5d7-b754-5861-b332-469c54f6a149" :answer/id #uuid "397fc5d7-b754-5861-b332-469c54f6a149" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-5154ad7e-edfc-5ac5-8a8b-a33d1faff605" :answer/id #uuid "5154ad7e-edfc-5ac5-8a8b-a33d1faff605" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "question-29e9adcf-4a5b-51ac-835b-f4a444c16f67" :question/id #uuid "29e9adcf-4a5b-51ac-835b-f4a444c16f67" :question/math-academy-id "q-175346" :question/problem "Which of the following are mathematical predicates?\n\nI. ${x}^{2}-{y}^{2}$ is a negative number.\n\nII. $q$ is a multiple of $3.$\n\nIII. $p$ is an irrational number." :question/worked-solution "A *predicate* of the variables ${x}_{1},{x}_{2},…,{x}_{n}$ is a sentence that contains the variables defined on some *universal set*, and has the property that when we substitute concrete values for all the variables into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is a predicate of two variables. Substituting a concrete pair of values $(x,y)$ into the sentence, we get a statement that is either true or false.\n\n- Option II is a predicate of one variable. Substituting a concrete value for $q$ into the sentence, we get a statement that is either true or false.\n\n- Option III is a predicate of one variable. Substituting a concrete value for $p$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-32567726-3501-5d0d-940f-48d231eb6ef4"] :db/ensure [:question/validate]} {:db/id "answer-field-32567726-3501-5d0d-940f-48d231eb6ef4" :answer-field/id #uuid "32567726-3501-5d0d-940f-48d231eb6ef4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d537ac14-0b1b-5cb4-8513-cee40f6be506" :answer-field/choices ["answer-e51cc954-0758-54e1-9a16-24656e0a29ea" "answer-73240a1b-211b-5c00-9d5f-311dfb49c53f" "answer-d537ac14-0b1b-5cb4-8513-cee40f6be506" "answer-9eca26cf-f171-5ff3-acfa-60e419b348ec" "answer-2a998714-cd73-5c76-8918-2d96cd4eb205"] :db/ensure [:answer-field/validate]} {:db/id "answer-e51cc954-0758-54e1-9a16-24656e0a29ea" :answer/id #uuid "e51cc954-0758-54e1-9a16-24656e0a29ea" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-73240a1b-211b-5c00-9d5f-311dfb49c53f" :answer/id #uuid "73240a1b-211b-5c00-9d5f-311dfb49c53f" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-d537ac14-0b1b-5cb4-8513-cee40f6be506" :answer/id #uuid "d537ac14-0b1b-5cb4-8513-cee40f6be506" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-9eca26cf-f171-5ff3-acfa-60e419b348ec" :answer/id #uuid "9eca26cf-f171-5ff3-acfa-60e419b348ec" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-2a998714-cd73-5c76-8918-2d96cd4eb205" :answer/id #uuid "2a998714-cd73-5c76-8918-2d96cd4eb205" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186198281 :knowledge-point/questions ["question-ca53c000-4fe4-56e9-a6ee-1afd2eed227d" "question-78dba0d1-f872-5b82-8f2b-f5d37f8cf2ad" "question-d193d524-b905-5ac6-8d71-b915f99a8936" "question-11e39500-6de6-5573-ad9b-383cb406fe12"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ca53c000-4fe4-56e9-a6ee-1afd2eed227d" :question/id #uuid "ca53c000-4fe4-56e9-a6ee-1afd2eed227d" :question/math-academy-id "q-174401" :question/problem "Consider the following predicate:\n\n$\\,$ $P(x,y):$ ${x}^{2}+4{y}^{2}<4,$\n\nwhere the universal set is ${R}^{2}.$ Which of the following shaded regions represents the truth set of the predicate?" :question/worked-solution "The *truth set* of a predicate $P({x}_{1},{x}_{2},…,{x}_{n})$ is the set of $n$-tuples in its universal set $U={U}_{1}\\times {U}_{2}\\times ⋯\\times {U}_{n}$ such that substituting these tuples for the variables makes the predicate a true statement:\n\n$$\nT=\\{({x}_{1},{x}_{2},…,{x}_{n})\\in U\\,|\\,P({x}_{1},{x}_{2},…,{x}_{n})\\}\n$$\n\nThe universal set for our predicate is $U={R}^{2}.$\n\nWe need to find $(x,y)\\in U$ such that the following is true:\n\n$\\,$ ${x}^{2}+4{y}^{2}<4$\n\nLet's first rearrange our inequality as follows:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}<4 \\\\ \\frac{{x}^{2}}{4}+\\frac{4{y}^{2}}{4}<1 \\\\ \\frac{{x}^{2}}{4}+{y}^{2}<1\\end{aligned}\n$$\n\nFrom here, we see that this represents an ellipse centered at $O$ with semi-axes $2$ and $1.$\n\nFinally, let's sketch the truth set $T$ of $P(x,y):$\n\n![](images/fd/fdb0a299dd6ee0bd58ceb1a74c9423bf5cac81857b0538dcda7f0a4cba9a1108.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f0f7f6bf-8e15-5716-bb8d-0bc39135a77f"] :db/ensure [:question/validate]} {:db/id "answer-field-f0f7f6bf-8e15-5716-bb8d-0bc39135a77f" :answer-field/id #uuid "f0f7f6bf-8e15-5716-bb8d-0bc39135a77f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9f8f7227-b926-5556-bd09-6a48c3ee78d4" :answer-field/choices ["answer-1bd102d7-98fa-5661-bd09-9693e3c677d7" "answer-adc9353f-873d-5ce4-8975-2cb89b75f945" "answer-a3b91979-e90f-57f4-8242-78efe6079f83" "answer-9f8f7227-b926-5556-bd09-6a48c3ee78d4" "answer-c345dc13-6285-512f-95b1-d0d4a4223f17"] :db/ensure [:answer-field/validate]} {:db/id "answer-1bd102d7-98fa-5661-bd09-9693e3c677d7" :answer/id #uuid "1bd102d7-98fa-5661-bd09-9693e3c677d7" :answer/type :answer.type/image :answer/value "images/14/14031d9643e2bb32ad00e8f715e62399b68a970ba56f0aede4d718ad187084d6.png" :db/ensure [:answer/validate]} {:db/id "answer-adc9353f-873d-5ce4-8975-2cb89b75f945" :answer/id #uuid "adc9353f-873d-5ce4-8975-2cb89b75f945" :answer/type :answer.type/image :answer/value "images/17/178f6746c8a9984f163b398317da9c5b40fa84331a5643625e63fcb1439c9d0c.png" :db/ensure [:answer/validate]} {:db/id "answer-a3b91979-e90f-57f4-8242-78efe6079f83" :answer/id #uuid "a3b91979-e90f-57f4-8242-78efe6079f83" :answer/type :answer.type/image :answer/value "images/c0/c058c940715b7a2a4a844a360d88cda3daa6455eed159fbee0dfb7545ddbf1a6.png" :db/ensure [:answer/validate]} {:db/id "answer-9f8f7227-b926-5556-bd09-6a48c3ee78d4" :answer/id #uuid "9f8f7227-b926-5556-bd09-6a48c3ee78d4" :answer/type :answer.type/image :answer/value "images/fd/fdb0a299dd6ee0bd58ceb1a74c9423bf5cac81857b0538dcda7f0a4cba9a1108.png" :db/ensure [:answer/validate]} {:db/id "answer-c345dc13-6285-512f-95b1-d0d4a4223f17" :answer/id #uuid "c345dc13-6285-512f-95b1-d0d4a4223f17" :answer/type :answer.type/image :answer/value "images/fe/fef6b4ac68f92490c510e0570968e0f2efbe92de0ec60b1eb4c99545a2713259.png" :db/ensure [:answer/validate]} {:db/id "question-78dba0d1-f872-5b82-8f2b-f5d37f8cf2ad" :question/id #uuid "78dba0d1-f872-5b82-8f2b-f5d37f8cf2ad" :question/math-academy-id "q-175387" :question/problem "Consider the following predicate:\n\n$\\,$ $P(x,y):$ $x+y<3,$\n\nwhere the universal set is ${R}^{2}.$ Which of the following shaded regions represents the truth set of the predicate?" :question/worked-solution "The *truth set* of a predicate $P({x}_{1},{x}_{2},…,{x}_{n})$ is the set of $n$-tuples in its universal set $U={U}_{1}\\times {U}_{2}\\times ⋯\\times {U}_{n}$ such that substituting these tuples for the variables makes the predicate a true statement:\n\n$$\nT=\\{({x}_{1},{x}_{2},…,{x}_{n})\\in U\\,|\\,P({x}_{1},{x}_{2},…,{x}_{n})\\}\n$$\n\nThe universal set for our predicate is $U={R}^{2}.$\n\nWe need to find $(x,y)\\in U$ such that the following is true:\n\n$\\,$ $x+y<3$\n\nNow, we convert the inequality into the slope-intercept form:\n\n$$\n\\begin{aligned}x+y & <3 \\\\ y & <-x+3\\end{aligned}\n$$\n\nFinally, let's sketch the truth set $T$ of $P(x,y):$\n\n![](images/bd/bde3d6ee1e58d33088ffc49913e1cd8a299f0ea91cdf4024fd0b63a598ebf456.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b0ca923a-2a7a-5fd9-9f3d-f9780ce16762"] :db/ensure [:question/validate]} {:db/id "answer-field-b0ca923a-2a7a-5fd9-9f3d-f9780ce16762" :answer-field/id #uuid "b0ca923a-2a7a-5fd9-9f3d-f9780ce16762" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f367dd50-d225-58b4-a8fd-ac8528e6d425" :answer-field/choices ["answer-9452c82b-1bc0-577c-8506-8fd46e8d9124" "answer-fb420cdf-fcbe-56fc-bc90-16106d7638d8" "answer-f367dd50-d225-58b4-a8fd-ac8528e6d425" "answer-5a439630-8d79-5b90-abcd-597163892518" "answer-0b598162-ce03-5219-b00a-ccb35c36a02e"] :db/ensure [:answer-field/validate]} {:db/id "answer-9452c82b-1bc0-577c-8506-8fd46e8d9124" :answer/id #uuid "9452c82b-1bc0-577c-8506-8fd46e8d9124" :answer/type :answer.type/image :answer/value "images/1f/1f42ddabaeb4d1feb2f08cf04dfd831deabe8c7b8d22207ad18b0b91f5696d81.png" :db/ensure [:answer/validate]} {:db/id "answer-fb420cdf-fcbe-56fc-bc90-16106d7638d8" :answer/id #uuid "fb420cdf-fcbe-56fc-bc90-16106d7638d8" :answer/type :answer.type/image :answer/value "images/33/335a6ccc2f954c7e8ac32e1eda42e97ebfffe54462facc5b6de68740600ce64b.png" :db/ensure [:answer/validate]} {:db/id "answer-f367dd50-d225-58b4-a8fd-ac8528e6d425" :answer/id #uuid "f367dd50-d225-58b4-a8fd-ac8528e6d425" :answer/type :answer.type/image :answer/value "images/71/710ef1af1d4b42cc6646272739b70c209222a0a5c7d10aaae039575b5c1040ac.png" :db/ensure [:answer/validate]} {:db/id "answer-5a439630-8d79-5b90-abcd-597163892518" :answer/id #uuid "5a439630-8d79-5b90-abcd-597163892518" :answer/type :answer.type/image :answer/value "images/8d/8dd2a6022bef5b0d739c055d6e5efaac6d17bd54b9d6a8c35eaca5749ac021cf.png" :db/ensure [:answer/validate]} {:db/id "answer-0b598162-ce03-5219-b00a-ccb35c36a02e" :answer/id #uuid "0b598162-ce03-5219-b00a-ccb35c36a02e" :answer/type :answer.type/image :answer/value "images/b1/b130d69c699465509e862d0e3f4253d0779f25b1e5677308d1e4e0dbaa18cfea.png" :db/ensure [:answer/validate]} {:db/id "question-d193d524-b905-5ac6-8d71-b915f99a8936" :question/id #uuid "d193d524-b905-5ac6-8d71-b915f99a8936" :question/math-academy-id "q-175383" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $a+b$ is an odd number,\n\nwhere the universal set is $\\{(a,b)\\,|\\,a=2,3,\\,b=5,8\\}.$" :question/worked-solution "The *truth set* of a predicate $P({x}_{1},{x}_{2},…,{x}_{n})$ is the set of $n$-tuples in its universal set $U={U}_{1}\\times {U}_{2}\\times ⋯\\times {U}_{n}$ such that substituting these tuples for the variables makes the predicate a true statement:\n\n$$\nT=\\{({x}_{1},{x}_{2},…,{x}_{n})\\in U\\,|\\,P({x}_{1},{x}_{2},…,{x}_{n})\\}\n$$\n\nThe universal set for our predicate is\n\n$$\n\\begin{aligned}U & =\\{2,3\\}\\times \\{5,8\\} \\\\  & =\\{(2,5),(2,8),(3,5),(3,8)\\}.\\end{aligned}\n$$\n\nWe need to find $(a,b)\\in U$ such that the following is true:\n\n$\\,$ $a+b$ is an odd number\n\nThe following pairs give the elements of our truth set:\n\n- $(2,5)$ since $2+5=7$ and $7$ is an odd number,\n\n- $(3,8)$ since $3+8=11$ and $11$ is an odd number.\n\nTherefore, the truth set of our predicate is\n\n$$\nT=\\{(2,5),(3,8)\\}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-28f10fe3-37fc-540c-8f33-9718dc4bbd85"] :db/ensure [:question/validate]} {:db/id "answer-field-28f10fe3-37fc-540c-8f33-9718dc4bbd85" :answer-field/id #uuid "28f10fe3-37fc-540c-8f33-9718dc4bbd85" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-efcd6648-fb9e-5966-8e39-df3feb11ef64" :answer-field/choices ["answer-f0a0106c-90ba-5cde-b9f6-7d9a1025b6fb" "answer-e101acf5-edd5-58b3-a8a9-fcbb2e84e969" "answer-efcd6648-fb9e-5966-8e39-df3feb11ef64" "answer-753a15d1-3896-52b2-8a66-8e5995eb854b" "answer-c72a41f9-ea14-50d0-8c14-045b9a0abc2a"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0a0106c-90ba-5cde-b9f6-7d9a1025b6fb" :answer/id #uuid "f0a0106c-90ba-5cde-b9f6-7d9a1025b6fb" :answer/type :answer.type/math :answer/value "\\{(2,5),(2,8),(3,5),(3,8)\\}" :db/ensure [:answer/validate]} {:db/id "answer-e101acf5-edd5-58b3-a8a9-fcbb2e84e969" :answer/id #uuid "e101acf5-edd5-58b3-a8a9-fcbb2e84e969" :answer/type :answer.type/math :answer/value "\\{(2,5),(3,5),(3,8)\\}" :db/ensure [:answer/validate]} {:db/id "answer-efcd6648-fb9e-5966-8e39-df3feb11ef64" :answer/id #uuid "efcd6648-fb9e-5966-8e39-df3feb11ef64" :answer/type :answer.type/math :answer/value "\\{(2,5),(3,8)\\}" :db/ensure [:answer/validate]} {:db/id "answer-753a15d1-3896-52b2-8a66-8e5995eb854b" :answer/id #uuid "753a15d1-3896-52b2-8a66-8e5995eb854b" :answer/type :answer.type/math :answer/value "\\{(2,8),(3,5)\\}" :db/ensure [:answer/validate]} {:db/id "answer-c72a41f9-ea14-50d0-8c14-045b9a0abc2a" :answer/id #uuid "c72a41f9-ea14-50d0-8c14-045b9a0abc2a" :answer/type :answer.type/math :answer/value "∅" :db/ensure [:answer/validate]} {:db/id "question-11e39500-6de6-5573-ad9b-383cb406fe12" :question/id #uuid "11e39500-6de6-5573-ad9b-383cb406fe12" :question/math-academy-id "q-175389" :question/problem "Consider the following predicate:\n\n$\\,$ $P(x,y):$ $-x+y\\ge -1,$\n\nwhere the universal set is ${R}^{2}.$ Which of the following shaded regions represents the truth set of the predicate?" :question/worked-solution "The *truth set* of a predicate $P({x}_{1},{x}_{2},…,{x}_{n})$ is the set of $n$-tuples in its universal set $U={U}_{1}\\times {U}_{2}\\times ⋯\\times {U}_{n}$ such that substituting these tuples for the variables makes the predicate a true statement:\n\n$$\nT=\\{({x}_{1},{x}_{2},…,{x}_{n})\\in U\\,|\\,P({x}_{1},{x}_{2},…,{x}_{n})\\}\n$$\n\nThe universal set for our predicate is $U={R}^{2}.$\n\nWe need to find $(x,y)\\in U$ such that the following is true:\n\n$\\,$ $-x+y\\ge -1$\n\nNow, we convert the inequality into the slope-intercept form:\n\n$$\n\\begin{aligned}-x+y & \\ge -1 \\\\ y & \\ge x-1\\end{aligned}\n$$\n\nFinally, let's sketch the truth set $T$ of $P(x,y):$\n\n![](images/8d/8dabb7d13ef6e46cc31a2613bf7d62a5163db96630e9a855e84b9335e3be4855.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e425688d-cefc-532f-960d-cb1285b1d995"] :db/ensure [:question/validate]} {:db/id "answer-field-e425688d-cefc-532f-960d-cb1285b1d995" :answer-field/id #uuid "e425688d-cefc-532f-960d-cb1285b1d995" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-62fc9842-761e-5620-a946-dfc980712891" :answer-field/choices ["answer-62fc9842-761e-5620-a946-dfc980712891" "answer-878fcaba-04c3-596f-b953-6f9266034438" "answer-f88622e3-3f4a-580d-a704-ac22eb4e1cc2" "answer-d5581895-7cdd-5211-b6e9-266caf79785b" "answer-3b9d16c0-f580-537f-9b8f-77b2a081c034"] :db/ensure [:answer-field/validate]} {:db/id "answer-62fc9842-761e-5620-a946-dfc980712891" :answer/id #uuid "62fc9842-761e-5620-a946-dfc980712891" :answer/type :answer.type/image :answer/value "images/2f/2f1b90e7143a3829d90ec3d9ea7c5378740f9e60a3715725f2b96a850e2037cd.png" :db/ensure [:answer/validate]} {:db/id "answer-878fcaba-04c3-596f-b953-6f9266034438" :answer/id #uuid "878fcaba-04c3-596f-b953-6f9266034438" :answer/type :answer.type/image :answer/value "images/38/382ebe19c2b0a4dc6d8c4c7c2266dbcf02bdd0e8311c627cf79bee1eb75e5126.png" :db/ensure [:answer/validate]} {:db/id "answer-f88622e3-3f4a-580d-a704-ac22eb4e1cc2" :answer/id #uuid "f88622e3-3f4a-580d-a704-ac22eb4e1cc2" :answer/type :answer.type/image :answer/value "images/57/57b5404aacae6482ee69c5e00034c30d4f0a7a9ec237c8961a2bfa7babcb6042.png" :db/ensure [:answer/validate]} {:db/id "answer-d5581895-7cdd-5211-b6e9-266caf79785b" :answer/id #uuid "d5581895-7cdd-5211-b6e9-266caf79785b" :answer/type :answer.type/image :answer/value "images/6d/6d2647e04beb52c1faaebfb234114a231ffe1c8e6ef3304e1b54787b3d363c8f.png" :db/ensure [:answer/validate]} {:db/id "answer-3b9d16c0-f580-537f-9b8f-77b2a081c034" :answer/id #uuid "3b9d16c0-f580-537f-9b8f-77b2a081c034" :answer/type :answer.type/image :answer/value "images/cf/cf7e26d20291c340dd701aee6d2c9d38c0f83059262ffc8a1408b9ac0342e762.png" :db/ensure [:answer/validate]}] "assertions" [["question-b1aeeb90-b252-58b0-bd1f-5b12f471387e" :question/id #uuid "b1aeeb90-b252-58b0-bd1f-5b12f471387e"] ["question-b1aeeb90-b252-58b0-bd1f-5b12f471387e" :question/math-academy-id "q-175364"] ["question-b1aeeb90-b252-58b0-bd1f-5b12f471387e" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $P(x):$ ${x}^{2}-8=2x$\n\nwhere the universal set is $R.$"] ["question-b1aeeb90-b252-58b0-bd1f-5b12f471387e" :question/worked-solution "The *truth set* of a predicate $P(x)$ is the set of elements in its universal set $U$ such that substituting these elements for the variable makes the predicate a true statement:\n\n$$\nT=\\{x\\in U\\,|\\,P(x)\\}\n$$\n\nThe universal set for our predicate is $U=R.$\n\nWe need to find $x\\in U$ such that the following is true:\n\n$\\,$ ${x}^{2}-8=2x$\n\nNow, we solve the above equation by factoring:\n\n$$\n\\begin{aligned}{x}^{2}-8 & =2x \\\\ {x}^{2}-2x-8 & =0 \\\\ (x-4)(x+2) & =0\\end{aligned}\n$$\n\nSo, the solutions are $x=-2\\in R$ and $x=4\\in R.$\n\nTherefore, the truth set of our predicate is $T=\\{-2,4\\}.$"] ["question-b1aeeb90-b252-58b0-bd1f-5b12f471387e" :question/difficulty :question.difficulty/moderate] ["answer-field-cf86a146-26ce-5ad8-bf9e-055735de44f5" :answer-field/id #uuid "cf86a146-26ce-5ad8-bf9e-055735de44f5"] ["answer-74b55427-77a5-5628-b490-8b51f45c46ac" :answer/id #uuid "74b55427-77a5-5628-b490-8b51f45c46ac"] ["answer-74b55427-77a5-5628-b490-8b51f45c46ac" :answer/type :answer.type/math] ["answer-74b55427-77a5-5628-b490-8b51f45c46ac" :answer/value "\\{-2,4\\}"] ["answer-4c9a04ac-26ec-5ead-8bb8-50236f13de94" :answer/id #uuid "4c9a04ac-26ec-5ead-8bb8-50236f13de94"] ["answer-4c9a04ac-26ec-5ead-8bb8-50236f13de94" :answer/type :answer.type/math] ["answer-4c9a04ac-26ec-5ead-8bb8-50236f13de94" :answer/value "\\{-4,-2,2,4\\}"] ["answer-2e5e32b3-c4e2-5b66-8f6f-22792540ff8d" :answer/id #uuid "2e5e32b3-c4e2-5b66-8f6f-22792540ff8d"] ["answer-2e5e32b3-c4e2-5b66-8f6f-22792540ff8d" :answer/type :answer.type/math] ["answer-2e5e32b3-c4e2-5b66-8f6f-22792540ff8d" :answer/value "\\{-4,-2\\}"] ["answer-aa928a83-e518-5b7c-90af-6f77aa25fe2a" :answer/id #uuid "aa928a83-e518-5b7c-90af-6f77aa25fe2a"] ["answer-aa928a83-e518-5b7c-90af-6f77aa25fe2a" :answer/type :answer.type/math] ["answer-aa928a83-e518-5b7c-90af-6f77aa25fe2a" :answer/value "\\{2,4\\}"] ["answer-a8dddfc1-8b64-58af-9ae6-c3ee7f6700d2" :answer/id #uuid "a8dddfc1-8b64-58af-9ae6-c3ee7f6700d2"] ["answer-a8dddfc1-8b64-58af-9ae6-c3ee7f6700d2" :answer/type :answer.type/math] ["answer-a8dddfc1-8b64-58af-9ae6-c3ee7f6700d2" :answer/value "∅"] ["answer-field-cf86a146-26ce-5ad8-bf9e-055735de44f5" :answer-field/key "selection"] ["answer-field-cf86a146-26ce-5ad8-bf9e-055735de44f5" :answer-field/type :answer-field.type/radio] ["answer-field-cf86a146-26ce-5ad8-bf9e-055735de44f5" :answer-field/correct "answer-74b55427-77a5-5628-b490-8b51f45c46ac"] ["answer-field-cf86a146-26ce-5ad8-bf9e-055735de44f5" :answer-field/choices "answer-74b55427-77a5-5628-b490-8b51f45c46ac"] ["answer-field-cf86a146-26ce-5ad8-bf9e-055735de44f5" :answer-field/choices "answer-4c9a04ac-26ec-5ead-8bb8-50236f13de94"] ["answer-field-cf86a146-26ce-5ad8-bf9e-055735de44f5" :answer-field/choices "answer-2e5e32b3-c4e2-5b66-8f6f-22792540ff8d"] ["answer-field-cf86a146-26ce-5ad8-bf9e-055735de44f5" :answer-field/choices "answer-aa928a83-e518-5b7c-90af-6f77aa25fe2a"] ["answer-field-cf86a146-26ce-5ad8-bf9e-055735de44f5" :answer-field/choices "answer-a8dddfc1-8b64-58af-9ae6-c3ee7f6700d2"] ["question-b1aeeb90-b252-58b0-bd1f-5b12f471387e" :question/answer-fields "answer-field-cf86a146-26ce-5ad8-bf9e-055735de44f5"] [17592186198279 :knowledge-point/questions "question-b1aeeb90-b252-58b0-bd1f-5b12f471387e"] ["question-260f8856-8d02-57c2-89b0-9f4ad3929290" :question/id #uuid "260f8856-8d02-57c2-89b0-9f4ad3929290"] ["question-260f8856-8d02-57c2-89b0-9f4ad3929290" :question/math-academy-id "q-175353"] ["question-260f8856-8d02-57c2-89b0-9f4ad3929290" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $x$ is divisible by $3,$\n\nwhere the universal set is the set of integers from $5$ to $20$ inclusive."] ["question-260f8856-8d02-57c2-89b0-9f4ad3929290" :question/worked-solution "The *truth set* $T$ of a predicate $P(x)$ is the set of elements in its universal set $U$ such that substituting these elements for the variable makes the predicate a true statement:\n\n$$\nT=\\{x\\in U\\,|\\,P(x)\\}\n$$\n\nThe universal set for our predicate is\n\n$$\nU=\\{5,6,…,20\\}.\n$$\n\nWe need to find $x\\in U$ such that the following is true:\n\n$\\,$ $x$ is divisible by $3.$\n\nThe following numbers give the elements of our truth set:\n\n- $x=6$ since $6$ is divisible by $3,$\n\n- $x=9$ since $9$ is divisible by $3,$\n\n- $x=12$ since $12$ is divisible by $3,$\n\n- $x=15$ since $15$ is divisible by $3,$\n\n- $x=18$ since $18$ is divisible by $3.$\n\nTherefore, the truth set of our predicate is\n\n$$\nT=\\{6,9,12,15,18\\}.\n$$"] ["question-260f8856-8d02-57c2-89b0-9f4ad3929290" :question/difficulty :question.difficulty/easy] ["answer-field-cfa5d698-eb34-58cf-9780-238b5cb9eb58" :answer-field/id #uuid "cfa5d698-eb34-58cf-9780-238b5cb9eb58"] ["answer-342225e3-b744-59a4-a18e-552c1ed57177" :answer/id #uuid "342225e3-b744-59a4-a18e-552c1ed57177"] ["answer-342225e3-b744-59a4-a18e-552c1ed57177" :answer/type :answer.type/math] ["answer-342225e3-b744-59a4-a18e-552c1ed57177" :answer/value "\\{5,10,12,15\\}"] ["answer-c4b0a66d-4234-5ffe-8314-ca3a322857d3" :answer/id #uuid "c4b0a66d-4234-5ffe-8314-ca3a322857d3"] ["answer-c4b0a66d-4234-5ffe-8314-ca3a322857d3" :answer/type :answer.type/math] ["answer-c4b0a66d-4234-5ffe-8314-ca3a322857d3" :answer/value "\\{6,9,10,13,15\\}"] ["answer-1ef07448-0b15-5f77-831a-c55328b61392" :answer/id #uuid "1ef07448-0b15-5f77-831a-c55328b61392"] ["answer-1ef07448-0b15-5f77-831a-c55328b61392" :answer/type :answer.type/math] ["answer-1ef07448-0b15-5f77-831a-c55328b61392" :answer/value "\\{6,9,12,15,18\\}"] ["answer-c02e9e86-772c-50d4-8c6d-4c63a835a6f4" :answer/id #uuid "c02e9e86-772c-50d4-8c6d-4c63a835a6f4"] ["answer-c02e9e86-772c-50d4-8c6d-4c63a835a6f4" :answer/type :answer.type/math] ["answer-c02e9e86-772c-50d4-8c6d-4c63a835a6f4" :answer/value "\\{6,9,12,15\\}"] ["answer-0b59d398-5c35-51d7-a940-fbf48c21c719" :answer/id #uuid "0b59d398-5c35-51d7-a940-fbf48c21c719"] ["answer-0b59d398-5c35-51d7-a940-fbf48c21c719" :answer/type :answer.type/math] ["answer-0b59d398-5c35-51d7-a940-fbf48c21c719" :answer/value "\\{6,9,12\\}"] ["answer-field-cfa5d698-eb34-58cf-9780-238b5cb9eb58" :answer-field/key "selection"] ["answer-field-cfa5d698-eb34-58cf-9780-238b5cb9eb58" :answer-field/type :answer-field.type/radio] ["answer-field-cfa5d698-eb34-58cf-9780-238b5cb9eb58" :answer-field/correct "answer-1ef07448-0b15-5f77-831a-c55328b61392"] ["answer-field-cfa5d698-eb34-58cf-9780-238b5cb9eb58" :answer-field/choices "answer-342225e3-b744-59a4-a18e-552c1ed57177"] ["answer-field-cfa5d698-eb34-58cf-9780-238b5cb9eb58" :answer-field/choices "answer-c4b0a66d-4234-5ffe-8314-ca3a322857d3"] ["answer-field-cfa5d698-eb34-58cf-9780-238b5cb9eb58" :answer-field/choices "answer-1ef07448-0b15-5f77-831a-c55328b61392"] ["answer-field-cfa5d698-eb34-58cf-9780-238b5cb9eb58" :answer-field/choices "answer-c02e9e86-772c-50d4-8c6d-4c63a835a6f4"] ["answer-field-cfa5d698-eb34-58cf-9780-238b5cb9eb58" :answer-field/choices "answer-0b59d398-5c35-51d7-a940-fbf48c21c719"] ["question-260f8856-8d02-57c2-89b0-9f4ad3929290" :question/answer-fields "answer-field-cfa5d698-eb34-58cf-9780-238b5cb9eb58"] [17592186198279 :knowledge-point/questions "question-260f8856-8d02-57c2-89b0-9f4ad3929290"] ["question-b91cf75b-843d-5d15-ac06-6485f918c5af" :question/id #uuid "b91cf75b-843d-5d15-ac06-6485f918c5af"] ["question-b91cf75b-843d-5d15-ac06-6485f918c5af" :question/math-academy-id "q-175358"] ["question-b91cf75b-843d-5d15-ac06-6485f918c5af" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $P(x):$ $4x-3\\ge 9,$\n\nwhere the universal set is $R.$"] ["question-b91cf75b-843d-5d15-ac06-6485f918c5af" :question/worked-solution "The *truth set* of a predicate $P(x)$ is the set of elements in its universal set $U$ such that substituting these elements for the variable makes the predicate a true statement:\n\n$$\nT=\\{x\\in U\\,|\\,P(x)\\}\n$$\n\nWe need to find $x\\in U$ such that the following is true:\n\n$\\,$ $4x-3\\ge 9$\n\nThe universal set for our predicate is $U=R.$\n\nNow, we need to solve the above inequality:\n\n$$\n\\begin{aligned}4x-3\\ge 9 \\\\ 4x\\ge 12 \\\\ x\\ge 3\\end{aligned}\n$$\n\nTherefore, the truth set of our predicate is\n\n$$\nT=[3,\\infty ).\n$$"] ["question-b91cf75b-843d-5d15-ac06-6485f918c5af" :question/difficulty :question.difficulty/easy] ["answer-field-20ae3d0b-c166-52e0-b469-1972d9f84ee6" :answer-field/id #uuid "20ae3d0b-c166-52e0-b469-1972d9f84ee6"] ["answer-ceb9044e-2366-52a5-89e