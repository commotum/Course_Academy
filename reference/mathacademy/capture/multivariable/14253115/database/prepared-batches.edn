nFinally, let's sketch the truth set $T$ of $P(x,y):$\n\n![](images/8d/8dabb7d13ef6e46cc31a2613bf7d62a5163db96630e9a855e84b9335e3be4855.png)"] ["question-11e39500-6de6-5573-ad9b-383cb406fe12" :question/difficulty :question.difficulty/moderate] ["answer-field-e425688d-cefc-532f-960d-cb1285b1d995" :answer-field/id #uuid "e425688d-cefc-532f-960d-cb1285b1d995"] ["answer-62fc9842-761e-5620-a946-dfc980712891" :answer/id #uuid "62fc9842-761e-5620-a946-dfc980712891"] ["answer-62fc9842-761e-5620-a946-dfc980712891" :answer/type :answer.type/image] ["answer-62fc9842-761e-5620-a946-dfc980712891" :answer/value "images/2f/2f1b90e7143a3829d90ec3d9ea7c5378740f9e60a3715725f2b96a850e2037cd.png"] ["answer-878fcaba-04c3-596f-b953-6f9266034438" :answer/id #uuid "878fcaba-04c3-596f-b953-6f9266034438"] ["answer-878fcaba-04c3-596f-b953-6f9266034438" :answer/type :answer.type/image] ["answer-878fcaba-04c3-596f-b953-6f9266034438" :answer/value "images/38/382ebe19c2b0a4dc6d8c4c7c2266dbcf02bdd0e8311c627cf79bee1eb75e5126.png"] ["answer-f88622e3-3f4a-580d-a704-ac22eb4e1cc2" :answer/id #uuid "f88622e3-3f4a-580d-a704-ac22eb4e1cc2"] ["answer-f88622e3-3f4a-580d-a704-ac22eb4e1cc2" :answer/type :answer.type/image] ["answer-f88622e3-3f4a-580d-a704-ac22eb4e1cc2" :answer/value "images/57/57b5404aacae6482ee69c5e00034c30d4f0a7a9ec237c8961a2bfa7babcb6042.png"] ["answer-d5581895-7cdd-5211-b6e9-266caf79785b" :answer/id #uuid "d5581895-7cdd-5211-b6e9-266caf79785b"] ["answer-d5581895-7cdd-5211-b6e9-266caf79785b" :answer/type :answer.type/image] ["answer-d5581895-7cdd-5211-b6e9-266caf79785b" :answer/value "images/6d/6d2647e04beb52c1faaebfb234114a231ffe1c8e6ef3304e1b54787b3d363c8f.png"] ["answer-3b9d16c0-f580-537f-9b8f-77b2a081c034" :answer/id #uuid "3b9d16c0-f580-537f-9b8f-77b2a081c034"] ["answer-3b9d16c0-f580-537f-9b8f-77b2a081c034" :answer/type :answer.type/image] ["answer-3b9d16c0-f580-537f-9b8f-77b2a081c034" :answer/value "images/cf/cf7e26d20291c340dd701aee6d2c9d38c0f83059262ffc8a1408b9ac0342e762.png"] ["ans