d-ac8528e6d425"] ["answer-field-b0ca923a-2a7a-5fd9-9f3d-f9780ce16762" :answer-field/choices "answer-9452c82b-1bc0-577c-8506-8fd46e8d9124"] ["answer-field-b0ca923a-2a7a-5fd9-9f3d-f9780ce16762" :answer-field/choices "answer-fb420cdf-fcbe-56fc-bc90-16106d7638d8"] ["answer-field-b0ca923a-2a7a-5fd9-9f3d-f9780ce16762" :answer-field/choices "answer-f367dd50-d225-58b4-a8fd-ac8528e6d425"] ["answer-field-b0ca923a-2a7a-5fd9-9f3d-f9780ce16762" :answer-field/choices "answer-5a439630-8d79-5b90-abcd-597163892518"] ["answer-field-b0ca923a-2a7a-5fd9-9f3d-f9780ce16762" :answer-field/choices "answer-0b598162-ce03-5219-b00a-ccb35c36a02e"] ["question-78dba0d1-f872-5b82-8f2b-f5d37f8cf2ad" :question/answer-fields "answer-field-b0ca923a-2a7a-5fd9-9f3d-f9780ce16762"] [17592186198281 :knowledge-point/questions "question-78dba0d1-f872-5b82-8f2b-f5d37f8cf2ad"] ["question-d193d524-b905-5ac6-8d71-b915f99a8936" :question/id #uuid "d193d524-b905-5ac6-8d71-b915f99a8936"] ["question-d193d524-b905-5ac6-8d71-b915f99a8936" :question/math-academy-id "q-175383"] ["question-d193d524-b905-5ac6-8d71-b915f99a8936" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $a+b$ is an odd number,\n\nwhere the universal set is $\\{(a,b)\\,|\\,a=2,3,\\,b=5,8\\}.$"] ["question-d193d524-b905-5ac6-8d71-b915f99a8936" :question/worked-solution "The *truth set* of a predicate $P({x}_{1},{x}_{2},…,{x}_{n})$ is the set of $n$-tuples in its universal set $U={U}_{1}\\times {U}_{2}\\times ⋯\\times {U}_{n}$ such that substituting these tuples for the variables makes the predicate a true statement:\n\n$$\nT=\\{({x}_{1},{x}_{2},…,{x}_{n})\\in U\\,|\\,P({x}_{1},{x}_{2},…,{x}_{n})\\}\n$$\n\nThe universal set for our predicate is\n\n$$\n\\begin{aligned}U & =\\{2,3\\}\\times \\{5,8\\} \\\\  & =\\{(2,5),(2,8),(3,5),(3,8)\\}.\\end{aligned}\n$$\n\nWe need to find $(a,b)\\in U$ such that the following is true:\n\n$\\,$ $a+b$ is an odd number\n\nThe following pairs give the elements of our truth set:\n\n- $(2,5)$ since $2+5=7$ and $7$ is an odd number,\n\n- $(3,8)$ since $3+8=11$ and $11$ is an odd number.\n\nTherefore, the truth set of our predicate is\n\n$$\nT=\\{(2,5),(3,8)\\}.\n$$"] ["question-d193d524-b905-5ac6-8d71-b915f99a8936" :question/difficulty :question.difficulty/easy] ["answer-field-28f10fe3-37fc-540c-8f33-9718dc4bbd85" :answer-field/id #uuid "28f10fe3-37fc-540c-8f33-9718dc4bbd85"] ["answer-f0a0106c-90ba-5cde-b9f6-7d9a1025b6fb" :answer/id #uuid "f0a0106c-90ba-5cde-b9f6-7d9a1025b6fb"] ["answer-f0a0106c-90ba-5cde-b9f6-7d9a1025b6fb" :answer/type :answer.type/math] ["answer-f0a0106c-90ba-5cde-b9f6-7d9a1025b6fb" :answer/value "\\{(2,5),(2,8),(3,5),(3,8)\\}"] ["answer-e101acf5-edd5-58b3-a8a9-fcbb2e84e969" :answer/id #uuid "e101acf5-edd5-58b3-a8a9-fcbb2e84e969"] ["answer-e101acf5-edd5-58b3-a8a9-fcbb2e84e969" :answer/type :answer.type/math] ["answer-e101acf5-edd5-58b3-a8a9-fcbb2e84e969" :answer/value "\\{(2,5),(3,5),(3,8)\\}"] ["answer-efcd6648-fb9e-5966-8e39-df3feb11ef64" :answer/id #uuid "efcd6648-fb9e-5966-8e39-df3feb11ef64"] ["answer-efcd6648-fb9e-5966-8e39-df3feb11ef64" :answer/type :answer.type/math] ["answer-efcd6648-fb9e-5966-8e39-df3feb11ef64" :answer/value "\\{(2,5),(3,8)\\}"] ["answer-753a15d1-3896-52b2-8a66-8e5995eb854b" :answer/id #uuid "753a15d1-3896-52b2-8a66-8e5995eb854b"] ["answer-753a15d1-3896-52b2-8a66-8e5995eb854b" :answer/type :answer.type/math] ["answer-753a15d1-3896-52b2-8a66-8e5995eb854b" :answer/value "\\{(2,8),(3,5)\\}"] ["answer-c72a41f9-ea14-50d0-8c14-045b9a0abc2a" :answer/id #uuid "c72a41f9-ea14-50d0-8c14-045b9a0abc2a"] ["answer-c72a41f9-ea14-50d0-8c14-045b9a0abc2a" :answer/type :answer.type/math] ["answer-c72a41f9-ea14-50d0-8c14-045b9a0abc2a" :answer/value "∅"] ["answer-field-28f10fe3-37fc-540c-8f33-9718dc4bbd85" :answer-field/key "selection"] ["answer-field-28f10fe3-37fc-540c-8f33-9718dc4bbd85" :answer-field/type :answer-field.type/radio] ["answer-field-28f10fe3-37fc-540c-8f33-9718dc4bbd85" :answer-field/correct "answer-efcd6648-fb9e-5966-8e3