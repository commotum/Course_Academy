difficulty/moderate} :question/id #uuid "ca53c000-4fe4-56e9-a6ee-1afd2eed227d" :question/math-academy-id "q-174401" :question/problem "Consider the following predicate:\n\n$\\,$ $P(x,y):$ ${x}^{2}+4{y}^{2}<4,$\n\nwhere the universal set is ${R}^{2}.$ Which of the following shaded regions represents the truth set of the predicate?" :question/worked-solution "The *truth set* of a predicate $P({x}_{1},{x}_{2},…,{x}_{n})$ is the set of $n$-tuples in its universal set $U={U}_{1}\\times {U}_{2}\\times ⋯\\times {U}_{n}$ such that substituting these tuples for the variables makes the predicate a true statement:\n\n$$\nT=\\{({x}_{1},{x}_{2},…,{x}_{n})\\in U\\,|\\,P({x}_{1},{x}_{2},…,{x}_{n})\\}\n$$\n\nThe universal set for our predicate is $U={R}^{2}.$\n\nWe need to find $(x,y)\\in U$ such that the following is true:\n\n$\\,$ ${x}^{2}+4{y}^{2}<4$\n\nLet's first rearrange our inequality as follows:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}<4 \\\\ \\frac{{x}^{2}}{4}+\\frac{4{y}^{2}}{4}<1 \\\\ \\frac{{x}^{2}}{4}+{y}^{2}<1\\end{aligned}\n$$\n\nFrom here, we see that this represents an ellipse centered at $O$ with semi-axes $2$ and $1.$\n\nFinally, let's sketch the truth set $T$ of $P(x,y):$\n\n![](images/fd/fdb0a299dd6ee0bd58ceb1a74c9423bf5cac81857b0538dcda7f0a4cba9a1108.png)"}] [{:db/id #edb/ref 17592186575553 :knowledge-point/_questions [{:db/id #edb/ref 17592186198279 :knowledge-point/id #uuid "c23caadd-1738-549f-aade-2c983dc250dc" :knowledge-point/title "Finding the Truth Set of a Predicate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2849368e-65ae-57ea-a549-07c4abeb0fbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,\\infty )" :db/id #edb/ref 17592186575011} {:answer/id #uuid "28bc466a-f300-5f57-aec7-9770f3d2ff29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186575012} {:answer/id #uuid "2fa96fcc-d445-5126-bab7-2fc1e9c246b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,\\infty )" :db/id #edb/ref 17592186575029} {:answer/id #uuid "49b6b7fb-0b48-59e8-9257-b19da9baea66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-1,\\infty )" :db/id #edb/ref 17592186575075} {:answer/id #uuid "caf2dff0-9187-5e23-869d-71431326dff5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186575309}] :answer-field/correct {:answer/id #uuid "28bc466a-f300-5f57-aec7-9770f3d2ff29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186575012} :answer-field/id #uuid "c66a38f3-27df-56d2-bf7d-219d907e9d61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575497}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63a5ac6a-aab7-51ca-954b-e590d679441c" :question/math-academy-id "q-174455" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $P(x):$ ${x}^{2}\\ge -1$\n\nwhere the universal set is $N.$" :question/worked-solution "The *truth set* of a predicate $P(x)$ is the set of elements in its universal set $U$ such that substituting these elements for the variable makes the predicate a true statement:\n\n$$\nT=\\{x\\in U\\,|\\,P(x)\\}\n$$\n\nThe universal set for our predicate is $U=N.$\n\nWe need to find $x\\in U$ such that the following is true:\n\n$\\,$ ${x}^{2}\\ge -1$\n\nWe know that the square of any real number is greater than or equal to zero.\n\nSo, the inequality is true for every real number. In particular, it's true for every $x\\in N.$ \n\nTherefore, the truth set of our predicate is $T=N.$"}] [{:db/id #edb/ref 17592186198721 :knowledge-point/_questions [{:db/id #edb/ref 17592186198280 :knowledge-point/id #uuid "aa2f2ccb-45b0-5d6a-aa94-ac3eb95c745b" :knowledge-point/title "Identifying Predicates of More Than One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "704e020e-d34a-528d-9e9d-8b82289223c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459647} {:answer/id #uuid "f766b986-cfca-589d-b307-c3cfed4a40df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459648}] :answer-field/correct {:answer/id #uuid "f766b986-cfca-589d-b307-c3cfed4a40df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459648} :answer-field/id #uuid "c8358696-c4dc-5792-a56d-b4cf06cd1f4e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460690} {:answer-field/choices [{:answer/id #uuid "f32f7ace-9473-5adf-87d1-3a0754c1f4bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459649} {:answer/id #uuid "5764e144-7231-5741-8902-987088781ec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459650}] :answer-field/correct {:answer/id #uuid "5764e144-7231-5741-8902-987088781ec6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459650} :answer-field/id #uuid "9c262398-01aa-5334-93fb-2d94d63b0e3f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460691} {:answer-field/choices [{:answer/id #uuid "a0937afd-eb79-5420-8b9b-1cc18cc13046" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459651} {:answer/id #uuid "971d785f-c08d-59dc-8767-b018db2c3a8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459652}] :answer-field/correct {:answer/id #uuid "a0937afd-eb79-5420-8b9b-1cc18cc13046" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459651} :answer-field/id #uuid "45cf6747-f781-581e-9df2-b7717fa5597b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460692}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d3a9664a-054f-5dcf-9b0e-e1b4ab3dd171" :question/math-academy-id "q-174456" :question/problem "Which of the following are mathematical predicates?\n\nI. $x<y$\n\nII. $n$ is a perfect square.\n\nIII. Are $n$ and $m$ coprime?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *predicate* of the variables ${x}_{1},{x}_{2},…,{x}_{n}$ is a sentence that contains the variables defined on some *universal set*, and has the property that when we substitute concrete values for all the variables into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is a predicate of two variables. Substituting a concrete pair of values $(x,y)$ into the sentence, we get a statement that is either true or false.\n\n- Option II is a predicate of one variable. Substituting a concrete value for $n$ into the sentence, we get a statement that is either true or false.\n\n- Option III is *not* a predicate. Substituting a concrete pair of values $(n,m)$ into the sentence, we do not get a statement that is either true or false.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186575535 :knowledge-point/_questions [{:db/id #edb/ref 17592186198280 :knowledge-point/id #uuid "aa2f2ccb-45b0-5d6a-aa94-ac3eb95c745b" :knowledge-point/title "Identifying Predicates of More Than One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a998714-cd73-5c76-8918-2d96cd4eb205" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186575016} {:answer/id #uuid "73240a1b-211b-5c00-9d5f-311dfb49c53f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186575159} {:answer/id #uuid "9eca26cf-f171-5ff3-acfa-60e419b348ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186575225} {:answer/id #uuid "d537ac14-0b1b-5cb4-8513-cee40f6be506" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186575325} {:answer/id #uuid "e51cc954-0758-54e1-9a16-24656e0a29ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186575354}] :answer-field/correct {:answer/id #uuid "d537ac14-0b1b-5cb4-8513-cee40f6be506" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186575325} :answer-field/id #uuid "32567726-3501-5d0d-940f-48d231eb6ef4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575439}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "29e9adcf-4a5b-51ac-835b-f4a444c16f67" :question/math-academy-id "q-175346" :question/problem "Which of the following are mathematical predicates?\n\nI. ${x}^{2}-{y}^{2}$ is a negative number.\n\nII. $q$ is a multiple of $3.$\n\nIII. $p$ is an irrational number." :question/worked-solution "A *predicate* of the variables ${x}_{1},{x}_{2},…,{x}_{n}$ is a sentence that contains the variables defined on some *universal set*, and has the property that when we substitute concrete values for all the variables into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is a predicate of two variables. Substituting a concrete pair of values $(x,y)$ into the sentence, we get a statement that is either true or false.\n\n- Option II is a predicate of one variable. Substituting a concrete value for $q$ into the sentence, we get a statement that is either true or false.\n\n- Option III is a predicate of one variable. Substituting a concrete value for $p$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186575590 :knowledge-point/_questions [{:db/id #edb/ref 17592186198280 :knowledge-point/id #uuid "aa2f2ccb-45b0-5d6a-aa94-ac3eb95c745b" :knowledge-point/title "Identifying Predicates of More Than One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "397fc5d7-b754-5861-b332-469c54f6a149" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186575046} {:answer/id #uuid "5154ad7e-edfc-5ac5-8a8b-a33d1faff605" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186575088} {:answer/id #uuid "7ebde441-31ee-5c72-be00-ba395690a42b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186575178} {:answer/id #uuid "9ce84ceb-40f0-55b4-a8f2-42694ec7bec5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186575216} {:answer/id #uuid "f4b9e8c0-9717-5691-a9c7-25da739afc28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186575380}] :answer-field/correct {:answer/id #uuid "397fc5d7-b754-5861-b332-469c54f6a149" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186575046} :answer-field/id #uuid "b08c9d99-93d0-59db-a882-7330c0dcbd51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575484}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5cdaff3-81ba-58ae-a27f-1dea94cd990d" :question/math-academy-id "q-175352" :question/problem "Which of the following are mathematical predicates?\n\nI. $q$ plus $3.$\n\nII. $2$ is greater than $x.$\n\nIII. $a$ is a divisor of $b.$" :question/worked-solution "A *predicate* of the variables ${x}_{1},{x}_{2},…,{x}_{n}$ is a sentence that contains the variables defined on some *universal set*, and has the property that when we substitute concrete values for all the variables into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is *not* a predicate. Substituting a concrete value for $q$ into the sentence, we do not get a statement that is either true or false.\n\n- Option II is a predicate of one variable. Substituting a concrete value for $x$ into the sentence, we get a statement that is either true or false.\n\n- Option III is a predicate of two variables. Substituting a concrete pair of values $(a,b)$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186575534 :knowledge-point/_questions [{:db/id #edb/ref 17592186198279 :knowledge-point/id #uuid "c23caadd-1738-549f-aade-2c983dc250dc" :knowledge-point/title "Finding the Truth Set of a Predicate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b59d398-5c35-51d7-a940-fbf48c21c719" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{6,9,12\\}" :db/id #edb/ref 17592186574969} {:answer/id #uuid "1ef07448-0b15-5f77-831a-c55328b61392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{6,9,12,15,18\\}" :db/id #edb/ref 17592186574998} {:answer/id #uuid "342225e3-b744-59a4-a18e-552c1ed57177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{5,10,12,15\\}" :db/id #edb/ref 17592186575037} {:answer/id #uuid "c02e9e86-772c-50d4-8c6d-4c63a835a6f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{6,9,12,15\\}" :db/id #edb/ref 17592186575291} {:answer/id #uuid "c4b0a66d-4234-5ffe-8314-ca3a322857d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{6,9,10,13,15\\}" :db/id #edb/ref 17592186575297}] :answer-field/correct {:answer/id #uuid "1ef07448-0b15-5f77-831a-c55328b61392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{6,9,12,15,18\\}" :db/id #edb/ref 17592186574998} :answer-field/id #uuid "cfa5d698-eb34-58cf-9780-238b5cb9eb58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575505}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "260f8856-8d02-57c2-89b0-9f4ad3929290" :question/math-academy-id "q-175353" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $x$ is divisible by $3,$\n\nwhere the universal set is the set of integers from $5$ to $20$ inclusive." :question/worked-solution "The *truth set* $T$ of a predicate $P(x)$ is the set of elements in its universal set $U$ such that substituting these elements for the variable makes the predicate a true statement:\n\n$$\nT=\\{x\\in U\\,|\\,P(x)\\}\n$$\n\nThe universal set for our predicate is\n\n$$\nU=\\{5,6,…,20\\}.\n$$\n\nWe need to find $x\\in U$ such that the following is true:\n\n$\\,$ $x$ is divisible by $3.$\n\nThe following numbers give the elements of our truth set:\n\n- $x=6$ since $6$ is divisible by $3,$\n\n- $x=9$ since $9$ is divisible by $3,$\n\n- $x=12$ since $12$ is divisible by $3,$\n\n- $x=15$ since $15$ is divisible by $3,$\n\n- $x=18$ since $18$ is divisible by $3.$\n\nTherefore, the truth set of our predicate is\n\n$$\nT=\\{6,9,12,15,18\\}.\n$$"}] [{:db/id #edb/ref 17592186575580 :knowledge-point/_questions [{:db/id #edb/ref 17592186198280 :knowledge-point/id #uuid "aa2f2ccb-45b0-5d6a-aa94-ac3eb95c745b" :knowledge-point/title "Identifying Predicates of More Than One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "503d8faa-f079-5132-ade3-e4f9cc774644" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186575086} {:answer/id #uuid "6b6d8060-0176-5175-aa8f-1706ba311466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186575141} {:answer/id #uuid "e08b2963-8bca-50ae-82c1-0c92043cecef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186575347} {:answer/id #uuid "e6487afd-7bcc-5095-afa4-646349f2e953" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186575357} {:answer/id #uuid "f9fee152-d57a-5195-85ee-6823b5351b2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186575394}] :answer-field/correct {:answer/id #uuid "503d8faa-f079-5132-ade3-e4f9cc774644" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186575086} :answer-field/id #uuid "9d057fd8-1279-514e-b87c-868f979ed1fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575476}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d2ae0ef-2e2b-52c8-a273-c086772b799e" :question/math-academy-id "q-175354" :question/problem "Which of the following are mathematical predicates?\n\nI. $8$ divided by $t.$\n\nII. $y$ multiplied by $z.$\n\nIII. $p$ is a composite number." :question/worked-solution "A *predicate* of the variables ${x}_{1},{x}_{2},…,{x}_{n}$ is a sentence that contains the variables defined on some *universal set*, and has the property that when we substitute concrete values for all the variables into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is *not* a predicate. Substituting a concrete value for $t$ into the sentence, we do not get a statement that is either true or false.\n\n- Option II is *not* a predicate. Substituting a concrete pair of values $(y,z)$ into the sentence, we do not get a statement that is either true or false.\n\n- Option III is a predicate of one variable. Substituting a concrete value for $p$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186575593 :knowledge-point/_questions [{:db/id #edb/ref 17592186198279 :knowledge-point/id #uuid "c23caadd-1738-549f-aade-2c983dc250dc" :knowledge-point/title "Finding the Truth Set of a Predicate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b68889d-10d4-51c4-be9b-87b0c97af70e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,3)" :db/id #edb/ref 17592186574970} {:answer/id #uuid "6189dc4e-a81c-5882-83eb-6da2f69c3dcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-3,3]" :db/id #edb/ref 17592186575125} {:answer/id #uuid "bace1e39-b96c-5598-91da-f2e30385e626" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-3,\\infty )" :db/id #edb/ref 17592186575281} {:answer/id #uuid "ceb9044e-2366-52a5-89ec-803aba63111e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-3]" :db/id #edb/ref 17592186575314} {:answer/id #uuid "e526436b-9a51-5f65-a668-0eb96ca49eb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[3,\\infty )" :db/id #edb/ref 17592186575355}] :answer-field/correct {:answer/id #uuid "e526436b-9a51-5f65-a668-0eb96ca49eb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[3,\\infty )" :db/id #edb/ref 17592186575355} :answer-field/id #uuid "20ae3d0b-c166-52e0-b469-1972d9f84ee6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575424}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b91cf75b-843d-5d15-ac06-6485f918c5af" :question/math-academy-id "q-175358" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $P(x):$ $4x-3\\ge 9,$\n\nwhere the universal set is $R.$" :question/worked-solution "The *truth set* of a predicate $P(x)$ is the set of elements in its universal set $U$ such that substituting these elements for the variable makes the predicate a true statement:\n\n$$\nT=\\{x\\in U\\,|\\,P(x)\\}\n$$\n\nWe need to find $x\\in U$ such that the following is true:\n\n$\\,$ $4x-3\\ge 9$\n\nThe universal set for our predicate is $U=R.$\n\nNow, we need to solve the above inequality:\n\n$$\n\\begin{aligned}4x-3\\ge 9 \\\\ 4x\\ge 12 \\\\ x\\ge 3\\end{aligned}\n$$\n\nTherefore, the truth set of our predicate is\n\n$$\nT=[3,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186575588 :knowledge-point/_questions [{:db/id #edb/ref 17592186198279 :knowledge-point/id #uuid "c23caadd-1738-549f-aade-2c983dc250dc" :knowledge-point/title "Finding the Truth Set of a Predicate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e5e32b3-c4e2-5b66-8f6f-22792540ff8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-4,-2\\}" :db/id #edb/ref 17592186575025} {:answer/id #uuid "4c9a04ac-26ec-5ead-8bb8-50236f13de94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-4,-2,2,4\\}" :db/id #edb/ref 17592186575080} {:answer/id #uuid "74b55427-77a5-5628-b490-8b51f45c46ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-2,4\\}" :db/id #edb/ref 17592186575163} {:answer/id #uuid "a8dddfc1-8b64-58af-9ae6-c3ee7f6700d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186575246} {:answer/id #uuid "aa928a83-e518-5b7c-90af-6f77aa25fe2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{2,4\\}" :db/id #edb/ref 17592186575251}] :answer-field/correct {:answer/id #uuid "74b55427-77a5-5628-b490-8b51f45c46ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-2,4\\}" :db/id #edb/ref 17592186575163} :answer-field/id #uuid "cf86a146-26ce-5ad8-bf9e-055735de44f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575504}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1aeeb90-b252-58b0-bd1f-5b12f471387e" :question/math-academy-id "q-175364" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $P(x):$ ${x}^{2}-8=2x$\n\nwhere the universal set is $R.$" :question/worked-solution "The *truth set* of a predicate $P(x)$ is the set of elements in its universal set $U$ such that substituting these elements for the variable makes the predicate a true statement:\n\n$$\nT=\\{x\\in U\\,|\\,P(x)\\}\n$$\n\nThe universal set for our predicate is $U=R.$\n\nWe need to find $x\\in U$ such that the following is true:\n\n$\\,$ ${x}^{2}-8=2x$\n\nNow, we solve the above equation by factoring:\n\n$$\n\\begin{aligned}{x}^{2}-8 & =2x \\\\ {x}^{2}-2x-8 & =0 \\\\ (x-4)(x+2) & =0\\end{aligned}\n$$\n\nSo, the solutions are $x=-2\\in R$ and $x=4\\in R.$\n\nTherefore, the truth set of our predicate is $T=\\{-2,4\\}.$"}] [{:db/id #edb/ref 17592186425980 :knowledge-point/_questions [{:db/id #edb/ref 17592186198280 :knowledge-point/id #uuid "aa2f2ccb-45b0-5d6a-aa94-ac3eb95c745b" :knowledge-point/title "Identifying Predicates of More Than One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f548d9d7-5c43-5510-85e7-89f665103530" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474544} {:answer/id #uuid "299c3818-e21a-5d63-9d43-edb435384b5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474545}] :answer-field/correct {:answer/id #uuid "299c3818-e21a-5d63-9d43-edb435384b5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474545} :answer-field/id #uuid "33029c5d-a58f-5846-b20f-d30fb9ae1431" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475198} {:answer-field/choices [{:answer/id #uuid "cffbbad6-2ff2-508a-a394-ef1effcca096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474546} {:answer/id #uuid "966aa064-e076-50ec-9fdb-88187a6d9994" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474547}] :answer-field/correct {:answer/id #uuid "cffbbad6-2ff2-508a-a394-ef1effcca096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474546} :answer-field/id #uuid "8eb33668-d751-5e1f-a8f1-d04525bc5ad1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475199} {:answer-field/choices [{:answer/id #uuid "a3099e3c-5a65-5e1b-a4c9-9aceb7935c7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474548} {:answer/id #uuid "517d0ea8-bd34-5d06-9d04-f78f5ae6a208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474549}] :answer-field/correct {:answer/id #uuid "517d0ea8-bd34-5d06-9d04-f78f5ae6a208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474549} :answer-field/id #uuid "3bc37e72-ebc3-54f5-abd0-30ce43dacb22" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475200}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86866e7c-73c9-5409-8743-b71ad4d3cbe4" :question/math-academy-id "q-175366" :question/problem "Which of the following are mathematical predicates?\n\nI. $P(y):$ ${y}^{2}-1=8$\n\nII. $Q(a,b):$ ${a}^{2}+{b}^{2}$\n\nIII. $R(x,y):$ $\\frac{x}{y}\\in N\\cap Q$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *predicate* of the variables ${x}_{1},{x}_{2},…,{x}_{n}$ is a sentence that contains the variables defined on some *universal set*, and has the property that when we substitute concrete values for all the variables into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is a predicate of one variable. Substituting a concrete value for $y$ into the sentence, we get a statement that is either true or false.\n\n- Option II is *not* a predicate. Substituting a concrete pair of values $(a,b)$ into the sentence, we do not get a statement that is either true or false.\n\n- Option III is a predicate of two variables. Substituting a concrete pair of values $(x,y)$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186575605 :knowledge-point/_questions [{:db/id #edb/ref 17592186198281 :knowledge-point/id #uuid "9f9703bd-92ae-51f7-902b-251a7947ba6a" :knowledge-point/title "Finding the Truth Set of a Multivariable Predicate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "753a15d1-3896-52b2-8a66-8e5995eb854b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(2,8),(3,5)\\}" :db/id #edb/ref 17592186575164} {:answer/id #uuid "c72a41f9-ea14-50d0-8c14-045b9a0abc2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186575304} {:answer/id #uuid "e101acf5-edd5-58b3-a8a9-fcbb2e84e969" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(2,5),(3,5),(3,8)\\}" :db/id #edb/ref 17592186575348} {:answer/id #uuid "efcd6648-fb9e-5966-8e39-df3feb11ef64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(2,5),(3,8)\\}" :db/id #edb/ref 17592186575371} {:answer/id #uuid "f0a0106c-90ba-5cde-b9f6-7d9a1025b6fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(2,5),(2,8),(3,5),(3,8)\\}" :db/id #edb/ref 17592186575372}] :answer-field/correct {:answer/id #uuid "efcd6648-fb9e-5966-8e39-df3feb11ef64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(2,5),(3,8)\\}" :db/id #edb/ref 17592186575371} :answer-field/id #uuid "28f10fe3-37fc-540c-8f33-9718dc4bbd85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575432}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d193d524-b905-5ac6-8d71-b915f99a8936" :question/math-academy-id "q-175383" :question/problem "Find the truth set of the following predicate:\n\n$\\,$ $a+b$ is an odd number,\n\nwhere the universal set is $\\{(a,b)\\,|\\,a=2,3,\\,b=5,8\\}.$" :question/worked-solution "The *truth set* of a predicate $P({x}_{1},{x}_{2},…,{x}_{n})$ is the set of $n$-tuples in its universal set $U={U}_{1}\\times {U}_{2}\\times ⋯\\times {U}_{n}$ such that substituting these tuples for the variables makes the predicate a true statement:\n\n$$\nT=\\{({x}_{1},{x}_{2},…,{x}_{n})\\in U\\,|\\,P({x}_{1},{x}_{2},…,{x}_{n})\\}\n$$\n\nThe universal set for our predicate is\n\n$$\n\\begin{aligned}U & =\\{2,3\\}\\times \\{5,8\\} \\\\  & =\\{(2,5),(2,8),(3,5),(3,8)\\}.\\end{aligned}\n$$\n\nWe need to find $(a,b)\\in U$ such that the following is true:\n\n$\\,$ $a+b$ is an odd number\n\nThe following pairs give the elements of our truth set:\n\n- $(2,5)$ since $2+5=7$ and $7$ is an odd number,\n\n- $(3,8)$ since $3+8=11$ and $11$ is an odd number.\n\nTherefore, the truth set of our predicate is\n\n$$\nT=\\{(2,5),(3,8)\\}.\n$$"}] [{:db/id #edb/ref 17592186575564 :knowledge-point/_questions [{:db/id #edb/ref 17592186198281 :knowledge-point/id #uuid "9f9703bd-92ae-51f7-902b-251a7947ba6a" :knowledge-point/title "Finding the Truth Set of a Multivariable Predicate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b598162-ce03-5219-b00a-ccb35c36a02e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b1/b130d69c699465509e862d0e3f4253d0779f25b1e5677308d1e4e0dbaa18cfea.png" :db/id #edb/ref 17592186574968} {:answer/id #uuid "5a439630-8d79-5b90-abcd-597163892518" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8d/8dd2a6022bef5b0d739c055d6e5efaac6d17bd54b9d6a8c35eaca5749ac021cf.png" :db/id #edb/ref 17592186575107} {:answer/id #uuid "9452c82b-1bc0-577c-8506-8fd46e8d9124" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1f/1f42ddabaeb4d1feb2f08cf04dfd831deabe8c7b8d22207ad18b0b91f5696d81.png" :db/id #edb/ref 17592186575204} {:answer/id #uuid "f367dd50-d225-58b4-a8fd-ac8528e6d425" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/71/710ef1af1d4b42cc6646272739b70c209222a0a5c7d10aaae039575b5c1040ac.png" :db/id #edb/ref 17592186575378} {:answer/id #uuid "fb420cdf-fcbe-56fc-bc90-16106d7638d8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/33/335a6ccc2f954c7e8ac32e1eda42e97ebfffe54462facc5b6de68740600ce64b.png" :db/id #edb/ref 17592186575400}] :answer-field/correct {:answer/id #uuid "f367dd50-d225-58b4-a8fd-ac8528e6d425" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/71/710ef1af1d4b42cc6646272739b70c209222a0a5c7d10aaae039575b5c1040ac.png" :db/id #edb/ref 17592186575378} :answer-field/id #uuid "b0ca923a-2a7a-5fd9-9f3d-f9780ce16762" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575485}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "78dba0d1-f872-5b82-8f2b-f5d37f8cf2ad" :question/math-academy-id "q-175387" :question/problem "Consider the following predicate:\n\n$\\,$ $P(x,y):$ $x+y<3,$\n\nwhere the universal set is ${R}^{2}.$ Which of the following shaded regions represents the truth set of the predicate?" :question/worked-solution "The *truth set* of a predicate $P({x}_{1},{x}_{2},…,{x}_{n})$ is the set of $n$-tuples in its universal set $U={U}_{1}\\times {U}_{2}\\times ⋯\\times {U}_{n}$ such that substituting these tuples for the variables makes the predicate a true statement:\n\n$$\nT=\\{({x}_{1},{x}_{2},…,{x}_{n})\\in U\\,|\\,P({x}_{1},{x}_{2},…,{x}_{n})\\}\n$$\n\nThe universal set for our predicate is $U={R}^{2}.$\n\nWe need to find $(x,y)\\in U$ such that the following is true:\n\n$\\,$ $x+y<3$\n\nNow, we convert the inequality into the slope-intercept form:\n\n$$\n\\begin{aligned}x+y & <3 \\\\ y & <-x+3\\end{aligned}\n$$\n\nFinally, let's sketch the truth set $T$ of $P(x,y):$\n\n![](images/bd/bde3d6ee1e58d33088ffc49913e1cd8a299f0ea91cdf4024fd0b63a598ebf456.png)"}] [{:db/id #edb/ref 17592186575530 :knowledge-point/_questions [{:db/id #edb/ref 17592186198281 :knowledge-point/id #uuid "9f9703bd-92ae-51f7-902b-251a7947ba6a" :knowledge-point/title "Finding the Truth Set of a Multivariable Predicate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b9d16c0-f580-537f-9b8f-77b2a081c034" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cf/cf7e26d20291c340dd701aee6d2c9d38c0f83059262ffc8a1408b9ac0342e762.png" :db/id #edb/ref 17592186575051} {:answer/id #uuid "62fc9842-761e-5620-a946-dfc980712891" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2f/2f1b90e7143a3829d90ec3d9ea7c5378740f9e60a3715725f2b96a850e2037cd.png" :db/id #edb/ref 17592186575128} {:answer/id #uuid "878fcaba-04c3-596f-b953-6f9266034438" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/38/382ebe19c2b0a4dc6d8c4c7c2266dbcf02bdd0e8311c627cf79bee1eb75e5126.png" :db/id #edb/ref 17592186575188} {:answer/id #uuid "d5581895-7cdd-5211-b6e9-266caf79785b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6d/6d2647e04beb52c1faaebfb234114a231ffe1c8e6ef3304e1b54787b3d363c8f.png" :db/id #edb/ref 17592186575326} {:answer/id #uuid "f88622e3-3f4a-580d-a704-ac22eb4e1cc2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/57/57b5404aacae6482ee69c5e00034c30d4f0a7a9ec237c8961a2bfa7babcb6042.png" :db/id #edb/ref 17592186575391}] :answer-field/correct {:answer/id #uuid "62fc9842-761e-5620-a946-dfc980712891" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2f/2f1b90e7143a3829d90ec3d9ea7c5378740f9e60a3715725f2b96a850e2037cd.png" :db/id #edb/ref 17592186575128} :answer-field/id #uuid "e425688d-cefc-532f-960d-cb1285b1d995" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575515}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11e39500-6de6-5573-ad9b-383cb406fe12" :question/math-academy-id "q-175389" :question/problem "Consider the following predicate:\n\n$\\,$ $P(x,y):$ $-x+y\\ge -1,$\n\nwhere the universal set is ${R}^{2}.$ Which of the following shaded regions represents the truth set of the predicate?" :question/worked-solution "The *truth set* of a predicate $P({x}_{1},{x}_{2},…,{x}_{n})$ is the set of $n$-tuples in its universal set $U={U}_{1}\\times {U}_{2}\\times ⋯\\times {U}_{n}$ such that substituting these tuples for the variables makes the predicate a true statement:\n\n$$\nT=\\{({x}_{1},{x}_{2},…,{x}_{n})\\in U\\,|\\,P({x}_{1},{x}_{2},…,{x}_{n})\\}\n$$\n\nThe universal set for our predicate is $U={R}^{2}.$\n\nWe need to find $(x,y)\\in U$ such that the following is true:\n\n$\\,$ $-x+y\\ge -1$\n\nNow, we convert the inequality into the slope-intercept form:\n\n$$\n\\begin{aligned}-x+y & \\ge -1 \\\\ y & \\ge x-1\\end{aligned}\n$$\n\nFinally, let's sketch the truth set $T$ of $P(x,y):$\n\n![](images/8d/8dabb7d13ef6e46cc31a2613bf7d62a5163db96630e9a855e84b9335e3be4855.png)"}] [{:db/id #edb/ref 17592186425979 :knowledge-point/_questions [{:db/id #edb/ref 17592186198281 :knowledge-point/id #uuid "9f9703bd-92ae-51f7-902b-251a7947ba6a" :knowledge-point/title "Finding the Truth Set of a Multivariable Predicate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13edba04-7016-55b3-998a-0c1a02b2d307" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/50/500233e26320d4faa984864948646c0a36b6a0672a3b5b5871b234f49656ac56.png" :db/id #edb/ref 17592186425953} {:answer/id #uuid "1a94059a-c75b-54d5-86b6-d7a3d7e98d53" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8c/8c80576fe81dd0978e5e8a4ecd937c5e71e60297dcc94ccec3751cc3bea1b11d.png" :db/id #edb/ref 17592186425954} {:answer/id #uuid "722f7e6a-002b-544e-97b2-40986c6598f4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1d/1de0fbb5b6a44423038b980a1e57e1486f02335e1a317ee143f6a6dfa76e7911.png" :db/id #edb/ref 17592186425961} {:answer/id #uuid "d49d4e89-b150-588d-b862-2ff8d4d1e8e1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a7/a7fe5877fd1ec762f6d9ebdeceb8b6739d204081430db291ad3e1284a63d12eb.png" :db/id #edb/ref 17592186425967} {:answer/id #uuid "d882ad0a-e078-5ea7-908f-611bb3476cea" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c1/c139a1b3b413a1cbf60789de2cdc831055b1407c101e4fa63992a814f44cc78d.png" :db/id #edb/ref 17592186425968}] :answer-field/correct {:answer/id #uuid "1a94059a-c75b-54d5-86b6-d7a3d7e98d53" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8c/8c80576fe81dd0978e5e8a4ecd937c5e71e60297dcc94ccec3751cc3bea1b11d.png" :db/id #edb/ref 17592186425954} :answer-field/id #uuid "fd267c3d-501f-5503-9b5e-c946c034c0d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425976}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "713f4e9c-4d96-5c9b-be62-26529dd25eb1" :question/math-academy-id "q-175390" :question/problem "Consider the following predicate:\n\n$\\,$ $P(x,y):$ $x+y\\le 0,$\n\nwhere the universal set is ${R}^{2}.$ Which of the following shaded regions represents the truth set of the predicate?" :question/worked-solution "The *truth set* of a predicate $P({x}_{1},{x}_{2},…,{x}_{n})$ is the set of $n$-tuples in its universal set $U={U}_{1}\\times {U}_{2}\\times ⋯\\times {U}_{n}$ such that substituting these tuples for the variables makes the predicate a true statement:\n\n$$\nT=\\{({x}_{1},{x}_{2},…,{x}_{n})\\in U\\,|\\,P({x}_{1},{x}_{2},…,{x}_{n})\\}\n$$\n\nThe universal set for our predicate is $U={R}^{2}.$\n\nWe need to find $(x,y)\\in U$ such that the following is true:\n\n$\\,$ $x+y\\le 0$\n\nNow, we convert the inequality into the slope-intercept form:\n\n$$\n\\begin{aligned}x+y & \\le 0 \\\\ y & \\le -x\\end{aligned}\n$$\n\nFinally, let's sketch the truth set $T$ of $P(x,y):$\n\n![](images/1e/1e8f03a8b229a8b2e46af33c700dec57a8abed693a58c75b6312e2ae5a6856c1.png)"}]}
