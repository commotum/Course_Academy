87Z\"></path>\n<path stroke-width=\"1\" id=\"E2-MJMAIN-29\" d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E2-MJMATHI-50\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-28\" x=\"751\" y=\"0\"></use>\n<g transform=\"translate(1141,0)\">\n <use xlink:href=\"#E2-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-31\" x=\"809\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E2-MJMAIN-2C\" x=\"2167\" y=\"0\"></use>\n<g transform=\"translate(2612,0)\">\n <use xlink:href=\"#E2-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMAIN-32\" x=\"809\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E2-MJMAIN-2C\" x=\"3638\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2026\" x=\"4084\" y=\"0\"></use>\n <use xlink:href=\"#E2-MJMAIN-2C\" x=\"5423\" y=\"0\"></use>\n<g transform=\"translate(5868,0)\">\n <use xlink:href=\"#E2-MJMATHI-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E2-MJMATHI-6E\" x=\"809\" y=\"-213\"></use>\n</g>\n <use xlink:href=\"#E2-MJMAIN-29\" x=\"6965\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>If <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"2.642ex\" height=\"2.509ex\" style=\"vertical-align: -0.671ex;\" viewBox=\"0 -791.3 1137.4 1080.4\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-3-Title\">\n<title id=\"MathJax-SVG-3-Title\">U_1</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E3-MJMATHI-55\" d=\"M107 637Q73 637 71 641Q70 643 70 649Q70 673 81 682Q83 683 98 683Q139 681 23