              "type": "text",
              "value": "I and II only",
              "html": "I and II only"
            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-99949-b",
              "type": "text",
              "value": "II only",
              "html": "II only"
            },
