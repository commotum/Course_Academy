nswer-field.type/radio} :db/id #edb/ref 17592186374255}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "be1815b4-c2ec-5150-bb0a-0574fce072d7" :question/math-academy-id "q-172559" :question/problem "Find the disjoint union of the sets ${a,b,c}$ and ${1,2}.$" :question/worked-solution "Notice that the sets are disjoint since\n\n$$\n{a,b,c}\\cap {1,2}=∅.\n$$\n\nTherefore, the disjoint union is simply the union:\n\n$$\n\\begin{aligned}{a,b,c}⊔{1,2} & ={a,b,c}\\cup {1,2} \\\\  & ={a,b,c,1,2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186152463 :knowledge-point/_questions [{:db/id #edb/ref 17592186152103 :knowledge-point/id #uuid "4c5188a6-60a0-5e38-9164-201c3eb60cd5" :knowledge-point/title "Finding the Disjoint Union of Overlapping Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3fa5524-ea49-5a0e-8ec2-c0b918a6a845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0, 1, 2, 3}" :db/id #edb/ref 17592186149310} {:answer/id #uuid "adf89d57-98d2-50de-b8a8-1b1eefb8dbbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1, 1), (2, 1), (3, 1), (0, 2), (2, 2)}" :db/id #edb/ref 17592186149311} {:answer/id #uuid "e1f4a258-d68a-5068-b04b-005af95c190e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1, 2, 3}" :db/id #edb/ref 17592186149312} {:answer/id #uuid "10460ef1-9c6c-5096-be9c-020abc2e4cca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1, 0), (2, 0), (3, 0), (1, 2), (2, 2), (3, 2)}" :db/id #edb/ref 17592186149313} {:answer/id #uuid "596a57c7-66aa-5fed-8f11-f1534ccf2c87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1, 1), (2, 1), (3, 1), (0, 1), (2, 1)}" :db/id #edb/ref 17592186149314}] :answer-field/id #uuid "d03a9b56-956b-5681-a0a4-72b62ad8c3c3" :answer-field/key "selection" 