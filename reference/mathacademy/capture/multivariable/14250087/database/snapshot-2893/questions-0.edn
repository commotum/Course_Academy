-8940-c72187069106" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472087} {:answer-field/choices [{:answer/id #uuid "984d326c-9652-5ab5-978b-97b03286f0e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471165} {:answer/id #uuid "332a5d32-f669-5ca5-9583-2148425f8f75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471166}] :answer-field/correct {:answer/id #uuid "984d326c-9652-5ab5-978b-97b03286f0e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471165} :answer-field/id #uuid "498b9449-b183-59dc-8461-4984778c1d56" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472088}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0311da7-2e05-528f-8234-394bbb366e6a" :question/math-academy-id "q-174352" :question/problem "Which of the following pairs of sets are disjoint?\n\nI. $\\{3,4,5\\}$ and $\\{6,7,8\\}$\n\nII. $\\{-4,-3,-2\\}$ and $\\{2,3,4\\}$\n\nIII. $[-3,0]$ and $[0,3]$\n\nSelect all that apply." :question/worked-solution "Two sets $A$ and $B$ are *disjoint* if they have no element in common, i.e., their intersection is empty:\n\n$$\nA\\cap B=∅\n$$\n\nWith that in mind, let's examine our sets.\n\n- Pair I is disjoint. Indeed, the intersection of the sets is empty:\n\n$$\n\\{3,4,5\\}\\cap \\{6,7,8\\}=∅\\,\\,✓\n$$\n\n- Pair II is also disjoint. Indeed, the intersection of the sets is empty:\n\n$$\n\\{-4,-3,-2\\}\\cap \\{2,3,4\\}=∅\\,\\,✓\n$$\n\n- Pair III is *not* disjoint since the intersection of the sets is not empty:\n\n$$\n[-3,0]\\cap [0,3]=\\{0\\}\\ne ∅\\,\\,\\times \n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186374282 :knowledge-point/_questions [{:db/id #edb/ref 17592186152101 :knowledge-point/id #uuid "fa42f9bc-e3ad-56fa-8d82-4882e95ef826" :knowledge-point/title "Identifying Disjoint Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba140682-0e8f-5aca-8de3-cdd0b1bc2c4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453556} {:answer/id #uuid "396921ad-aa40-5aaa-884e-027a229971c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453557}] :answer-field/correct {:answer/id #uuid "396921ad-aa40-5aaa-884e-027a229971c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453557} :answer-field/id #uuid "12c1e29f-4de5-524d-b3c2-f49737e7ddd2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454528} {:answer-field/choices [{:answer/id #uuid "b9cc8a9c-1c4e-51f0-8448-55d7f6853a6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453558} {:answer/id #uuid "8bfeac80-8343-5d29-8d4c-b7606b0cef90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453559}] :answer-field/correct {:answer/id #uuid "b9cc8a9c-1c4e-51f0-8448-55d7f6853a6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453558} :answer-field/id #uuid "f15d0b0f-1328-5698-88ce-b3a8655af85d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454529} {:answer-field/choices [{:answer/id #uuid "c1fc5e25-b3a0-5f36-95f2-6f8c4ab39d22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453560} {:answer/id #uuid "09b99554-6d8e-5232-a7a1-f5d7310b0eab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453561}] :answer-field/correct {:answer/id #uuid "c1fc5e25-b3a0-5f36-95f2-6f8c4ab39d22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453560} :answer-field/id #uuid "d821fb26-a386-5b30-87d9-9016c61d22a0" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454530}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e6d5c0d-f5b8-5d41-acfe-dd83480488ec" :question/math-academy-id "q-174369" :question/problem "Consider the following sets:\n\n$$\nA={2n∣n\\in N},\\,B={{2}^{n}∣n\\in N}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $B={2,4,8,16,…}$\n- **II.** $A\\cap B=∅$\n- **III.** $A$ and $B$ are disjoint" :question/worked-solution "Two sets $A$ and $B$ are *disjoint* if they have no element in common, i.e., their intersection is empty:\n\n$$\nA\\cap B=∅\n$$\n\nWith that in mind, let's examine our sets.\n\n- Statement I is true.\n\n$$\n\\begin{aligned}B & ={{2}^{n}∣n\\in N} \\\\  & ={2,4,8,16,…}\\end{aligned}\n$$\n\n- Statement II is false. Notice that\n\n$$\n\\begin{aligned}A & ={2n∣n\\in N} \\\\  & ={2,4,6,8,…}.\\end{aligned}\n$$\n\nThen, the intersection is \n\n$$\n\\begin{aligned}A\\cap B & ={2,4,6,8,…}\\text{ }\\cap {2,4,8,16,…} \\\\  & ={2,4,8,…} \\\\  & \\ne ∅.\\end{aligned}\n$$\n\n- Statement III is false. Since the intersection is not empty, the two sets are not disjoint.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186374303 :knowledge-point/_questions [{:db/id #edb/ref 17592186152102 :knowledge-point/id #uuid "7079378e-2cec-550d-a647-405a0acb9b61" :knowledge-point/title "Finding the Disjoint Union of Non-Overlapping Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "047553c8-0294-5741-8dbe-b8b1ff9c93e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0,3,5,6,7,12}" :db/id #edb/ref 17592186374305} {:answer/id #uuid "c09d6a3e-2db4-5743-861c-a11e8b4c9a3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186374306} {:answer/id #uuid "03b47efb-171d-59c8-b78f-aac588093d57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0,6,12}" :db/id #edb/ref 17592186374307} {:answer/id #uuid "5493e9e3-0fa9-5865-9c67-8a7d421c1c12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3,5,7}" :db/id #edb/ref 17592186374308} {:answer/id #uuid "2afc9a16-2ba2-5ae8-a5e2-d604d1c4a714" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(3,0),(5,6),(7,12)}" :db/id #edb/ref 17592186374309}] :answer-field/correct {:answer/id #uuid "047553c8-0294-5741-8dbe-b8b1ff9c93e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0,3,5,6,7,12}" :db/id #edb/ref 17592186374305} :answer-field/id #uuid "1945a8d0-0569-59dc-a1f7-762aa6621f83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374304}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eefa7b71-9f96-5562-bf08-51d2f36fc7cd" :question/math-academy-id "q-174403" :question/problem "${3,5,7}⊔{0,6,12}=$" :question/worked-solution "Notice that the sets are disjoint since\n\n$$\n{3,5,7}\\cap {0,6,12}=∅.\n$$\n\nTherefore, the disjoint union is simply the union:\n\n$$\n\\begin{aligned}{3,5,7}⊔{0,6,12} & ={3,5,7}\\cup {0,6,12} \\\\  & ={0,3,5,6,7,12}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374310 :knowledge-point/_questions [{:db/id #edb/ref 17592186152102 :knowledge-point/id #uuid "7079378e-2cec-550d-a647-405a0acb9b61" :knowledge-point/title "Finding the Disjoint Union of Non-Overlapping Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94224efe-afc2-56a7-bcdd-0846afac9ffb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186374312} {:answer/id #uuid "35983c8d-95f7-5457-afe6-9e397d696aac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0,1,\\sqrt{2},\\sqrt{3},\\pi ,2\\pi }" :db/id #edb/ref 17592186374313} {:answer/id #uuid "1788f778-2ec3-5c8b-b9f2-82ff9c11e4fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1,\\sqrt{2},\\pi }" :db/id #edb/ref 17592186374314} {:answer/id #uuid "e6f8565b-a80a-5de2-a2d0-76b314a468a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(1,0),(\\sqrt{2},\\sqrt{3}),(\\pi ,2\\pi )}" :db/id #edb/ref 17592186374315} {:answer/id #uuid "37083a1c-2be5-5e14-be28-e44b7451618f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0,\\sqrt{3},2\\pi }" :db/id #edb/ref 17592186374316}] :answer-field/correct {:answer/id #uuid "35983c8d-95f7-5457-afe6-9e397d696aac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0,1,\\sqrt{2},\\sqrt{3},\\pi ,2\\pi }" :db/id #edb/ref 17592186374313} :answer-field/id #uuid "2673ac17-a404-5318-bb14-e6334a9e4415" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374311}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b30ce5c9-5791-59c0-9784-0848d9452bf6" :question/math-academy-id "q-174405" :question/problem "${1,\\sqrt{2},\\pi }⊔{0,\\sqrt{3},2\\pi }=$" :question/worked-solution "Notice that the sets are disjoint since\n\n$$\n{1,\\sqrt{2},\\pi }\\cap {0,\\sqrt{3},2\\pi }=∅.\n$$\n\nTherefore, the disjoint union is simply the union:\n\n$$\n\\begin{aligned}{1,\\sqrt{2},\\pi }⊔{0,\\sqrt{3},2\\pi } & ={1,\\sqrt{2},\\pi }\\cup {0,\\sqrt{3},2\\pi } \\\\  & ={0,1,\\sqrt{2},\\sqrt{3},\\pi ,2\\pi }\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374324 :knowledge-point/_questions [{:db/id #edb/ref 17592186152103 :knowledge-point/id #uuid "4c5188a6-60a0-5e38-9164-201c3eb60cd5" :knowledge-point/title "Finding the Disjoint Union of Overlapping Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e65e9f7-197b-5c3c-abc3-3dd45f373898" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-2,-1,1,2}" :db/id #edb/ref 17592186374326} {:answer/id #uuid "18c5545a-6329-59a6-bd31-a56116b74140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-2,0),(-1,1),(0,2)}" :db/id #edb/ref 17592186374327} {:answer/id #uuid "63ae97b9-c6b3-5329-afc3-5d9165aa6033" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-2,2),(0,0),(1,1)}" :db/id #edb/ref 17592186374328} {:answer/id #uuid "47cd93bd-8fe5-5c95-91b0-d54c54bb5b4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-2,1),(-1,1),(0,1),(0,2),(1,2),(2,2)}" :db/id #edb/ref 17592186374329} {:answer/id #uuid "e392bf10-a4f4-552e-b25b-5cf926b91708" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-2,-1,0,1,2}" :db/id #edb/ref 17592186374330}] :answer-field/correct {:answer/id #uuid "47cd93bd-8fe5-5c95-91b0-d54c54bb5b4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(-2,1),(-1,1),(0,1),(0,2),(1,2),(2,2)}" :db/id #edb/ref 17592186374329} :answer-field/id #uuid "9a185d36-e999-5570-bfa0-d7234877577b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374325}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7752c98f-48a3-514a-ab51-7ca1120c778c" :question/math-academy-id "q-174423" :question/problem "Find the disjoint union of the sets ${A}_{1}={-2,-1,0}$ and ${A}_{2}={0,1,2}.$" :question/worked-solution "Notice that the sets are overlapping since\n\n$$\n{-2,-1,0}\\cap {0,1,2}={0}\\ne ∅.\n$$\n\nSo, for each of our sets, we form the associated set, where each element is tagged with the corresponding index, as follows:\n\n$$\n\\begin{aligned} & {A}_{1} &  & \\,\\to \\, &  & {A}_{1}^{∗}={(-2,1),(-1,1),(0,1)} \\\\  & {A}_{2} &  & \\,\\to \\, &  & {A}_{2}^{∗}={(0,2),(1,2),(2,2)}\\end{aligned}\n$$\n\nNow, the disjoint union of our sets is simply the union of the associated tagged sets:\n\n$$\n\\begin{aligned}{A}_{1}⊔{A}_{2} & ={-2,-1,0}⊔{0,1,2} \\\\  & ={A}_{1}^{∗}\\cup {A}_{2}^{∗} \\\\  & ={(-2,1),(-1,1),(0,1)}\\cup {(0,2),(1,2),(2,2)} \\\\  & ={(-2,1),(-1,1),(0,1),(0,2),(1,2),(2,2)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374345 :knowledge-point/_questions [{:db/id #edb/ref 17592186152103 :knowledge-point/id #uuid "4c5188a6-60a0-5e38-9164-201c3eb60cd5" :knowledge-point/title "Finding the Disjoint Union of Overlapping Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24ee7b00-554b-5b1c-ada6-9379b237565a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(a,1),(b,1),(c,1),(b,2),(c,2),(d,2)}" :db/id #edb/ref 17592186374347} {:answer/id #uuid "fb38f3b1-b729-5a7d-b739-f64f99b6dfc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(a,b),(b,c),(c,d)}" :db/id #edb/ref 17592186374348} {:answer/id #uuid "df9fe2be-0f4b-594f-b2b6-8e6de6e2a8a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a,d}" :db/id #edb/ref 17592186374349} {:answer/id #uuid "3cbd0e85-fc9a-5155-bea9-32dc83e3d56f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(a,1),(b,1),(c,1),(a,2),(b,2),(c,2)}" :db/id #edb/ref 17592186374350} {:answer/id #uuid "6ab3e8ff-aba3-58a0-a516-5c5467f87fa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a,b,c,d}" :db/id #edb/ref 17592186374351}] :answer-field/correct {:answer/id #uuid "24ee7b00-554b-5b1c-ada6-9379b237565a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(a,1),(b,1),(c,1),(b,2),(c,2),(d,2)}" :db/id #edb/ref 17592186374347} :answer-field/id #uuid "f3f17878-47d3-5775-acb2-ebf47f477dd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374346}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8208fdb5-0359-559d-8a37-1a02e518c14a" :question/math-academy-id "q-174444" :question/problem "Find the disjoint union of the sets ${A}_{1}={a,b,c}$ and ${A}_{2}={b,c,d}.$" :question/worked-solution "Notice that the sets are overlapping since\n\n$$\n{a,b,c}\\cap {b,c,d}={b,c}\\ne ∅.\n$$\n\nSo, for each of our sets, we form the associated set, where each element is tagged with the corresponding index, as follows:\n\n$$\n\\begin{aligned} & {A}_{1} &  & \\,\\to \\, &  & {A}_{1}^{∗}={(a,1),(b,1),(c,1)} \\\\  & {A}_{2} &  & \\,\\to \\, &  & {A}_{2}^{∗}={(b,2),(c,2),(d,2)}\\end{aligned}\n$$\n\nNow, the disjoint union of our sets is simply the union of the associated tagged sets:\n\n$$\n\\begin{aligned}{A}_{1}⊔{A}_{2} & ={a,b,c}⊔{b,c,d} \\\\  & ={A}_{1}^{∗}\\cup {A}_{2}^{∗} \\\\  & ={(a,1),(b,1),(c,1)}\\cup {(b,2),(c,2),(d,2)} \\\\  & ={(a,1),(b,1),(c,1),(b,2),(c,2),(d,2)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186425785 :knowledge-point/_questions [{:db/id #edb/ref 17592186152103 :knowledge-point/id #uuid "4c5188a6-60a0-5e38-9164-201c3eb60cd5" :knowledge-point/title "Finding the Disjoint Union of Overlapping Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6779eb26-6407-59f7-9e64-0e6a6276ebea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(◻,1),(△,1),(♡,2),(△,2)\\}" :db/id #edb/ref 17592186425771} {:answer/id #uuid "781ef0ad-6a53-5942-aaac-760780016fe9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{◻,△,♡\\}" :db/id #edb/ref 17592186425772} {:answer/id #uuid "a50cc518-d784-5244-9830-60a9913eafbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(◻,1),(△,1),(♡,1),(◻,2),(△,2),(♡,2)\\}" :db/id #edb/ref 17592186425774} {:answer/id #uuid "df2bea30-76c9-51e1-bdf3-bc6440af2ddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{◻,♡\\}" :db/id #edb/ref 17592186425777} {:answer/id #uuid "fb7cf750-8daa-56f4-bb4d-0fe4dac8759a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(◻,♡),(◻,△),(△,♡)\\}" :db/id #edb/ref 17592186425780}] :answer-field/correct {:answer/id #uuid "6779eb26-6407-59f7-9e64-0e6a6276ebea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{(◻,1),(△,1),(♡,2),(△,2)\\}" :db/id #edb/ref 17592186425771} :answer-field/id #uuid "564c790a-8796-57b6-afff-883bcc976300" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425782}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "485ea0fb-b130-56b0-8f46-79fa4f4014b9" :question/math-academy-id "q-174446" :question/problem "Find the disjoint union of the sets ${A}_{1}=\\{◻,△\\}$ and ${A}_{2}=\\{♡,△\\}.$" :question/worked-solution "Notice that the sets are overlapping since\n\n$$\n\\{◻,△\\}\\cap \\{♡,△\\}=\\{△\\}\\ne ∅.\n$$\n\nSo, for each of our sets, we form the associated set, where each element is tagged with the corresponding index, as follows:\n\n$$\n\\begin{aligned} & {A}_{1} &  & \\,\\to \\, &  & {A}_{1}^{∗}=\\{(◻,1),(△,1)\\} \\\\  & {A}_{2} &  & \\,\\to \\, &  & {A}_{2}^{∗}=\\{(♡,2),(△,2)\\}\\end{aligned}\n$$\n\nNow, the disjoint union of our sets is simply the union of the associated tagged sets:\n\n$$\n\\begin{aligned}{A}_{1}⊔{A}_{2} & =\\{◻,△\\}⊔\\{♡,△\\} \\\\  & ={A}_{1}^{∗}\\cup {A}_{2}^{∗} \\\\  & =\\{(◻,1),(△,1)\\}\\cup \\{(♡,2),(△,2)\\} \\\\  & =\\{(◻,1),(△,1),(♡,2),(△,2)\\}\\end{aligned}\n$$"}]}
