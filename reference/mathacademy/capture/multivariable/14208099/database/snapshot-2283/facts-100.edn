86045417] [17592186415104 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186415104 #edb/ref 1071 "Let $f(x,y)=y+{x}^{2}.$ Given that $C$ is the path along the curve $r(t)=⟨2t,{t}^{2}-1⟩$ for $t\\in [0,2],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" #edb/ref 17592186045417] [17592186415104 #edb/ref 1072 #uuid "6e8a51b9-ad21-56cd-a267-db39e81294ac" #edb/ref 17592186045417] [17592186415104 #edb/ref 1074 "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,-1⟩ \\\\ r(2) & =⟨4,3⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,-1)$ and $(4,3).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(2))-f(r(0)) \\\\  & =f(4,3)-f(0,-1) \\\\  & =(3+{4}^{2})-(-1+{0}^{2}) \\\\  & =(3+16)-(-1) \\\\  & =20.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186415107 #edb/ref 1068 #edb/ref 17592186415099 #edb/ref 17592186045417] [17592186415107 #edb/ref 1069 "q-104637" #edb/ref 17592186045417] [17592186415107 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186415107 #edb/ref 1071 "Let $f(x,y)=y{x}^{2}{e}^{xy}.$ Given that $C$ is the path along the curve $r(t)=⟨\\operatorname{cos}⁡t,2\\operatorname{sin}⁡t⟩$ for $t\\in [0,\\frac{\\pi }{2}],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" #edb/ref 17592186045417] [17592186415107 #edb/ref 1072 #uuid "f3d23b94-95d1-5af0-9020-b1e5d5ab8286" #edb/ref 17592186045417] [17592186415107 #edb/ref 1074 "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n  \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨1,0⟩, \\\\ r(\\frac{\\pi }{2}) & =⟨0,2⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(1,0)$ and $(0,2).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f((r(\\frac{\\pi }{2}))-f(r(0)) \\\\  & =f(0,2)-f(1,0) \\\\  & =2\\cdot (0)^{2}\\cdot {e}^{0(2)}-0\\cdot (1)^{2}\\cdot {e}^{1(0)} \\\\  & =0.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186423275 #edb/ref 1043 #edb/ref 17592186423276 #edb/ref 17592186045417] [17592186423275 #edb/ref 1043 #edb/ref 17592186423277 #edb/ref 17592186045417] [17592186423275 #edb/ref 1043 #edb/ref 17592186423278 #edb/ref 17592186045417] [17592186423275 #edb/ref 1043 #edb/ref 17592186423279 #edb/ref 17592186045417] [17592186423275 #edb/ref 1043 #edb/ref 17592186423280 #edb/ref 17592186045417] [17592186423275 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186423275 #edb/ref 1045 "The Fundamental Theorem for Line Integrals" #edb/ref 17592186045417] [17592186423275 #edb/ref 1046 #edb/ref 17592186423278 #edb/ref 17592186045417] [17592186423275 #edb/ref 1048 #edb/ref 17592186046660 #edb/ref 17592186045417] [17592186423275 #edb/ref 1049 #edb/ref 17592186048308 #edb/ref 17592186045417] [17592186423275 #edb/ref 1053 #uuid "f437e194-169c-50f2-945d-004eb6df919b" #edb/ref 17592186045417] [17592186423276 #edb/ref 1058 #edb/ref 17592186423279 #edb/ref 17592186045417] [17592186423276 #edb/ref 1062 #uuid "47da3408-dc6c-5c1f-9665-3466da3da017" #edb/ref 17592186045417] [17592186423276 #edb/ref 1063 #edb/ref 17592186240907 #edb/ref 17592186045417] [17592186423277 #edb/ref 1062 #uuid "5dece436-1610-