#{[{:db/id #edb/ref 17592186134059 :knowledge-point/_questions [{:db/id #edb/ref 17592186133878 :knowledge-point/id #uuid "7b643761-8eab-5bd3-a5f5-c85b6ba34a61" :knowledge-point/title "Applying the Fundamental Theorem of Line Integrals Over Parametric Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00980506-979a-5a3c-bb6b-3b50f009bfac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186415067} {:answer/id #uuid "1aeef040-2421-5b1c-b55a-b92ee77dadcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186415070} {:answer/id #uuid "5daedb86-7dd6-576d-aff0-8f7b1f0062ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186415078} {:answer/id #uuid "a2214f1f-3631-5be2-85e4-d5102a1c44c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186415083} {:answer/id #uuid "d6de32bd-280a-5c5a-aa34-19f1b3faadf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186415092}] :answer-field/correct {:answer/id #uuid "5daedb86-7dd6-576d-aff0-8f7b1f0062ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186415078} :answer-field/id #uuid "8d412271-dad8-50a6-a5b4-2d3051bb421a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415100}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63f96647-0e17-5269-a429-2d3bdcfb1cff" :question/math-academy-id "q-104616" :question/problem "Let $f(x,y)={x}^{3}+y.$ Given that $C$ is the path along the curve $r(t)=⟨3t,{t}^{3}⟩$ for $t\\in [0,1],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,0⟩ \\\\ r(1) & =⟨3,1⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,0)$ and $(3,1).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(1))-f(r(0)) \\\\  & =f(3,1)-f(0,0) \\\\  & =({3}^{3}+1)-({0}^{3}+0) \\\\  & =(27+1)-0 \\\\  & =28.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186415104 :knowledge-point/_questions [{:db/id #edb/ref 17592186133878 :knowledge-point/id #uuid "7b643761-8eab-5bd3-a5f5-c85b6ba34a61" :knowledge-point/title "Applying the Fundamental Theorem of Line Integrals Over Parametric Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12811091-da24-5f9e-a3cc-d521c187f782" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186415069} {:answer/id #uuid "48539c5b-fd63-583d-8da2-566a4dd6e0bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186415077} {:answer/id #uuid "a1d2cb1e-5c01-5454-b9f6-ddf29ce394b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186415082} {:answer/id #uuid "b864bbf5-46ca-5a26-aa58-751cd0107a9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186415087} {:answer/id #uuid "cdf966f8-fa1b-5eaf-ab84-b21f9b032f94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186415091}] :answer-field/correct {:answer/id #uuid "cdf966f8-fa1b-5eaf-ab84-b21f9b032f94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186415091} :answer-field/id #uuid "ab184202-13b3-5378-a512-5889441d45af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415101}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6e8a51b9-ad21-56cd-a267-db39e81294ac" :question/math-academy-id "q-104624" :question/problem "Let $f(x,y)=y+{x}^{2}.$ Given that $C$ is the path along the curve $r(t)=⟨2t,{t}^{2}-1⟩$ for $t\\in [0,2],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,-1⟩ \\\\ r(2) & =⟨4,3⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,-1)$ and $(4,3).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(2))-f(r(0)) \\\\  & =f(4,3)-f(0,-1) \\\\  & =(3+{4}^{2})-(-1+{0}^{2}) \\\\  & =(3+16)-(-1) \\\\  & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186415107 :knowledge-point/_questions [{:db/id #edb/ref 17592186133878 :knowledge-point/id #uuid "7b643761-8eab-5bd3-a5f5-c85b6ba34a61" :knowledge-point/title "Applying the Fundamental Theorem of Line Integrals Over Parametric Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6f935a-7227-56de-9d74-d58f3261b90a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\pi }^{2}-2" :db/id #edb/ref 17592186415071} {:answer/id #uuid "376dde01-d46a-5414-9e84-a7d099ab2f33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186415075} {:answer/id #uuid "75de655b-bac7-5de2-9e4c-ce56729e4a3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {e}^{2\\pi }" :db/id #edb/ref 17592186415080} {:answer/id #uuid "87f317ce-1ebd-53fe-bd1c-2786b6ebd37d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\pi }^{2}{e}^{{\\pi }^{2}}" :db/id #edb/ref 17592186415081} {:answer/id #uuid "db14b874-47ec-5b46-a18d-4f53face6c8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186415095}] :answer-field/correct {:answer/id #uuid "376dde01-d46a-5414-9e84-a7d099ab2f33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186415075} :answer-field/id #uuid "5fdf3bea-7332-5701-aa59-1894b6d9cc82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415099}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3d23b94-95d1-5af0-9020-b1e5d5ab8286" :question/math-academy-id "q-104637" :question/problem "Let $f(x,y)=y{x}^{2}{e}^{xy}.$ Given that $C$ is the path along the curve $r(t)=⟨\\operatorname{cos}⁡t,2\\operatorname{sin}⁡t⟩$ for $t\\in [0,\\frac{\\pi }{2}],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n  \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨1,0⟩, \\\\ r(\\frac{\\pi }{2}) & =⟨0,2⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(1,0)$ and $(0,2).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f((r(\\frac{\\pi }{2}))-f(r(0)) \\\\  & =f(0,2)-f(1,0) \\\\  & =2\\cdot (0)^{2}\\cdot {e}^{0(2)}-0\\cdot (1)^{2}\\cdot {e}^{1(0)} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259586 :knowledge-point/_questions [{:db/id #edb/ref 17592186133878 :knowledge-point/id #uuid "7b643761-8eab-5bd3-a5f5-c85b6ba34a61" :knowledge-point/title "Applying the Fundamental Theorem of Line Integrals Over Parametric Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb8367f-a159-5457-99f5-50133f64eb7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\pi }{4}" :db/id #edb/ref 17592186256893} {:answer/id #uuid "0fa182ef-4a0a-5db2-a08b-55a80052cb00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186256930} {:answer/id #uuid "228efe5e-c3c4-564d-9dab-7a9a4edeb67d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\pi " :db/id #edb/ref 17592186257068} {:answer/id #uuid "3b05dbc7-a00e-579d-9183-316aebb35c95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186257306} {:answer/id #uuid "4e044364-8237-5de2-8e2f-2b3e611819bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\pi }{2}" :db/id #edb/ref 17592186257452}] :answer-field/correct {:answer/id #uuid "4e044364-8237-5de2-8e2f-2b3e611819bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\pi }{2}" :db/id #edb/ref 17592186257452} :answer-field/id #uuid "1e3f4676-5218-53c9-a375-46cf12254dde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259080}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "615b0135-e131-5b5f-9638-4296b1aa2a4a" :question/math-academy-id "q-124005" :question/problem "Let $f(x,y)=y\\operatorname{cos}⁡x+x.$ Given that $C$ is the path along the curve $r(t)=⟨t,2t⟩$ for $t\\in [\\frac{\\pi }{2},\\pi ],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{2}) & =⟨\\frac{\\pi }{2},\\pi ⟩ \\\\ r(\\pi ) & =⟨\\pi ,2\\pi ⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(\\frac{\\pi }{2},\\pi )$ and $(\\pi ,2\\pi ).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(\\pi ))-f(r(\\frac{\\pi }{2})) \\\\  & =f(\\pi ,2\\pi )-f(\\frac{\\pi }{2},\\pi ) \\\\  & =(2\\pi \\operatorname{cos}⁡\\pi +\\pi )-(\\pi \\operatorname{cos}⁡(\\frac{\\pi }{2})+\\frac{\\pi }{2}) \\\\  & =-\\pi -\\frac{\\pi }{2} \\\\  & =-\\frac{3\\pi }{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259588 :knowledge-point/_questions [{:db/id #edb/ref 17592186133890 :knowledge-point/id #uuid "c4519f3b-0fb8-54fd-9e9e-fca3e599b80b" :knowledge-point/title "Applying the Fundamental Theorem of Line Integrals Over Cartesian Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d21652b-8d10-5c45-b44f-db44c924244e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{4}" :db/id #edb/ref 17592186257022} {:answer/id #uuid "5ad034e3-435a-54af-8b44-ed2fc0bf168f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{4}\\operatorname{ln}⁡2" :db/id #edb/ref 17592186257573} {:answer/id #uuid "863b68a3-5559-5883-8119-c9324587def7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2+1" :db/id #edb/ref 17592186257962} {:answer/id #uuid "a621cce8-352a-549d-ba06-938de99fba53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4e+\\operatorname{ln}⁡2" :db/id #edb/ref 17592186258228} {:answer/id #uuid "edd3b1c2-37e9-5a98-86ec-a93068bfe7d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}-\\operatorname{ln}⁡2" :db/id #edb/ref 17592186258839}] :answer-field/correct {:answer/id #uuid "5ad034e3-435a-54af-8b44-ed2fc0bf168f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{4}\\operatorname{ln}⁡2" :db/id #edb/ref 17592186257573} :answer-field/id #uuid "27cdb6ef-9816-548d-bfcd-7bdee6ce6dbe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259102}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "530f83ac-873a-5207-ba3d-e9438dabfd29" :question/math-academy-id "q-124027" :question/problem "Let $f(x,y)=x{e}^{y+1}.$ Given that $C$ is the path along the curve $y={e}^{x}+1$ for $x\\in [0,\\operatorname{ln}⁡2],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\nWe start by parametrizing the curve $C.$ A suitable parametrization is\n\n$$\nr(t)=⟨t,{e}^{t}+1⟩,\\,t\\in [0,\\operatorname{ln}⁡2].\n$$\n\nThen, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,2⟩, \\\\ r(\\operatorname{ln}⁡2) & =⟨\\operatorname{ln}⁡2,3⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,2)$ and $(\\operatorname{ln}⁡2,3).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(\\operatorname{ln}⁡2))-f(r(0)) \\\\  & =f(\\operatorname{ln}⁡2,3)-f(0,2) \\\\  & =\\operatorname{ln}⁡2\\cdot {e}^{3+1}-0\\cdot {e}^{2+1} \\\\  & ={e}^{4}\\operatorname{ln}⁡2.\\end{aligned}\n$$"}]}
