  "live_records": {
    "q-79741": {
      "dom_id": "step-q79741",
      "name": "Question 1",
      "problem": "Find the differential $\\text{d}f$ for the function $f(x,y)={e}^{xy}.$",
      "worked_solution": "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =y{e}^{xy}\\,\\text{d}x+x{e}^{xy}\\,\\text{d}y\\end{aligned}\n$$",
      "calculator_instructions": "",
