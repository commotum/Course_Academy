 17592186045417] [17592186546910 #edb/ref 1079 #uuid "a9413410-1a9d-50b7-9182-e546f0368ec5" #edb/ref 17592186045417] [17592186546916 #edb/ref 1075 #edb/ref 17592186546736 #edb/ref 17592186045417] [17592186546916 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186546916 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186546916 #edb/ref 1078 #edb/ref 17592186546736 #edb/ref 17592186045417] [17592186546916 #edb/ref 1079 #uuid "ae0782a8-a8ce-5695-a710-1fed57c8a4e2" #edb/ref 17592186045417] [17592186546936 #edb/ref 1075 #edb/ref 17592186546437 #edb/ref 17592186045417] [17592186546936 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186546936 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186546936 #edb/ref 1078 #edb/ref 17592186546437 #edb/ref 17592186045417] [17592186546936 #edb/ref 1079 #uuid "d77e5f19-97fb-5309-b828-6d59517070d0" #edb/ref 17592186045417] [17592186546938 #edb/ref 1075 #edb/ref 17592186546376 #edb/ref 17592186045417] [17592186546938 #edb/ref 1075 #edb/ref 17592186546504 #edb/ref 17592186045417] [17592186546938 #edb/ref 1075 #edb/ref 17592186546659 #edb/ref 17592186045417] [17592186546938 #edb/ref 1075 #edb/ref 17592186546672 #edb/ref 17592186045417] [17592186546938 #edb/ref 1075 #edb/ref 17592186546699 #edb/ref 17592186045417] [17592186546938 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186546938 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186546938 #edb/ref 1078 #edb/ref 17592186546699 #edb/ref 17592186045417] [17592186546938 #edb/ref 1079 #uuid "e0295622-35a4-5953-aa14-52d047c70fc3" #edb/ref 17592186045417] [17592186546982 #edb/ref 1068 #edb/ref 17592186546910 #edb/ref 17592186045417] [17592186546982 #edb/ref 1069 "q-344835" #edb/ref 17592186045417] [17592186546982 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186546982 #edb/ref 1071 "![](images/48/48b2ec3916610f624aa308d9c395c43eb7a34418a6457c514dc40ecc82bf2f99.png)\n\nFind the least distance $d$ between the curve $y=\\sqrt{{x}^{2}+1}+1$ and the point $(2,1).$ Do not round the answer.\n\n$d=$\n{{field-1}}" #edb/ref 17592186045417] [17592186546982 #edb/ref 1072 #uuid "2a9dfae3-b740-55e6-abd9-d9909c3ad491" #edb/ref 17592186045417] [17592186546982 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(2,1)$ and a general point $P(x,y)$:\n\n$$\nS=(x-2)^{2}+(y-1)^{2}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{{x}^{2}+1}+1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & =(x-2)^{2}+(y-1)^{2} \\\\  & =(x-2)^{2}+(\\sqrt{{x}^{2}+1}+1-1)^{2} \\\\  & =(x-2)^{2}+(\\sqrt{{x}^{2}+1})^{2} \\\\  & =(x-2)^{2}+{x}^{2}+1 \\\\  & ={x}^{2}-4x+4+{x}^{2}+1 \\\\  & =2{x}^{2}-4x+5.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=4x-4 & =0 \\\\ 4x & =4 \\\\ x & =1\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=4>0,$ so $x=1$ gives a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=1$ is given by\n\n$$\nd=\\sqrt{S(1)}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S(1)} \\\\  & =\\sqrt{2(1)^{2}-4(1)+5} \\\\  & =\\sqrt{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186547006 #edb/ref 1068 #edb/ref 17592186546936 #edb/ref 17592186045417] [17592186547006 #edb/ref 1069 "q-315639" #edb/ref 17592186045417] [17592186547006 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186547006 #edb/ref 1071 "![](images/83/835ffbb783651cfc8f6210fe46f792d7c68f41926a4775e56a570e9bb87b7462.png)\n\nFind the $x$-coordinate of the point on the curve $y=\\sqrt{9x+1}$ that is closest to the point $(8,0).$ Do not round the answer.\n\n$x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186547006 #edb/ref 1072 #uuid "5957844f-5ee9-5592-b52f-3fea8df780b1" #edb/ref 17592186045417] [17592186547006 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(8,0)$ and a general point $P(x,y)$:\n\n$$\nS=(x-8)^{2}+{y}^{2}.\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{9x+1}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & =(x-8)^{2}+{y}^{2} \\\\  & =(x-8)^{2}+(\\sqrt{9x+1})^{2} \\\\  & =(x-8)^{2}+9x+1 \\\\  & ={x}^{2}-16x+64+9x+1 \\\\  & ={x}^{2}-7x+65.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-7 & =0 \\\\ 2x & =7 \\\\ x & =\\frac{7}{2}.\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=\\frac{7}{2}$ is a minimum of $S.$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $x=\\frac{7}{2}.$" #edb/ref 17592186045417] [17592186547033 #edb/ref 1068 #edb/ref 17592186546938 #edb/ref 17592186045417] [17592186547033 #edb/ref 1069 "q-18500" #edb/ref 17592186045417] [17592186547033 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186547033 #edb/ref 1071 "Find the $y$-coordinate of the point on the curve $y={x}^{2}-2x$ that is closest to the point $(1,4).$" #edb/ref 17592186045417] [17592186547033 #edb/ref 1072 #uuid "907519ae-3321-5175-a88f-6dce32f2cb03" #edb/ref 17592186045417] [17592186547033 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(1,4)$ and a general point $P(x,y)$:\n\n$$\n\\begin{aligned}S & =(x-1)^{2}+(y-4)^{2} \\\\  & ={x}^{2}-2x+1+{y}^{2}-8y+16 \\\\  & ={x}^{2}-2x+{y}^{2}-8y+17\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y={x}^{2}-2x.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(y) & =y+{y}^{2}-8y+17 \\\\  & ={y}^{2}-7y+17.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(y)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(y)=2y-7 & =0 \\\\ 2y & =7 \\\\ y & =\\frac{7}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(y)=2>0.$ Therefore, $y=\\frac{7}{2}$ is a minimum of $S.$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $y=\\frac{7}{2}.$" #edb/ref 17592186045417] [17592186547054 #edb/ref 1068 #edb/ref 17592186546916 #edb/ref 17592186045417] [17592186547054 #edb/ref 1069 "q-344849" #edb/ref 17592186045417] [17592186547054 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186547054 #edb/ref 1071 "Find the least distance between the curve $y=\\sqrt{|x-1|}+2$ and the point $P(2,2).$ Do not round the answer.\n\n$d=$ \n{{field-1}}" #edb/ref 17592186045417] [17592186547054 #edb/ref 1072 #uuid "ceab1153-db5f-5530-aee8-9a4937774de9" #edb/ref 17592186045417] [17592186547054 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(2,2)$ and a general point $P(x,y):$\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+(y-2)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{|x-1|}+2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+(y-2)^{2} \\\\  & =(x-2)^{2}+{(\\sqrt{|x-1|}+2-2)}^{2} \\\\  & =(x-2)^{2}+|x-1|.\\end{aligned}\n$$\n\nFor $x\\ge 1,$ we have $|x-1|=x-1,$ so\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+x-1 \\\\  & ={x}^{2}-4x+4+x-1 \\\\  & ={x}^{2}-3x+3.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-3 & =0 \\\\ 2x & =3 \\\\ x & =\\frac{3}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=\\frac{3}{2}$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=\\frac{3}{2}$ is given by\n\n$$\nd=\\sqrt{S\\,(\\frac{3}{2})}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S\\,(\\frac{3}{2})} \\\\  & =\\sqrt{{(\\frac{3}{2})}^{2}-3(\\frac{3}{2})+3} \\\\  & =\\sqrt{\\frac{9}{4}-\\frac{9}{2}+3} \\\\  & =\\sqrt{\\frac{3}{4}} \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186547093 #edb/ref 1058 #edb/ref 17592186547133 #edb/ref 17592186045417] [17592186547093 #edb/ref 1062 #uuid "14d7851b-2592-5b3a-96a9-8d51149c8a93" #edb/ref 17592186045417] [17592186547093 #edb/ref 1063 #edb/ref 17592186546982 #edb/ref 17592186045417] [17592186547098 #edb/ref 1058 #edb/ref 17592186547093 #edb/ref 17592186045417] [17592186547098 #edb/ref 1062 #uuid "24b7c382-5fad-5c82-8a7d-642129b1c47a" #edb/ref 17592186045417] [17592186547098 #edb/ref 1063 #edb/ref 17592186547006 #edb/ref 17592186045417] [17592186547102 #edb/ref 1058 #edb/ref 17592186547098 #edb/ref 17592186045417] [17592186547102 #edb/ref 1062 #uuid "2c5a3b83-ee27-5938-906f-66932bc34a39" #edb/ref 17592186045417] [17592186547102 #edb/ref 1063 #edb/ref 17592186547033 #edb/ref 17592186045417] [17592186547133 #edb/ref 1062 #uuid "a088826c-f52e-5e69-8491-0696adb96bbc" #edb/ref 17592186045417] [17592186547133 #edb/ref 1063 #edb/ref 17592186547054 #edb/ref 17592186045417] [17592186547157 #edb/ref 1058 #edb/ref 17592186547102 #edb/ref 17592186045417] [17592186547157 #edb/ref 1062 #uuid "db305256-c310-5e02-ade5-477388d7db01" #edb/ref 17592186045417] [17592186547157 #edb/ref 1063 #edb/ref 17592186198944 #edb/ref 17592186045417]}
