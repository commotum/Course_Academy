186045417] [17592186194526 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186194526 #edb/ref 1083 #uuid "aa382cb2-c023-5ce5-885a-e1b72b5790e0" #edb/ref 17592186045417] [17592186194527 #edb/ref 1080 "3M" #edb/ref 17592186045417] [17592186194527 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186194527 #edb/ref 1083 #uuid "d548c7eb-c1fb-5fe3-9e43-4760ac006cbb" #edb/ref 17592186045417] [17592186194528 #edb/ref 1080 "2M" #edb/ref 17592186045417] [17592186194528 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186194528 #edb/ref 1083 #uuid "001dd569-8891-54f9-9dd6-95c9c954b57e" #edb/ref 17592186045417] [17592186194529 #edb/ref 1080 "\\frac{M}{2}" #edb/ref 17592186045417] [17592186194529 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186194529 #edb/ref 1083 #uuid "034ffee4-a514-54a1-8af5-fa58f01a0c7c" #edb/ref 17592186045417] [17592186194530 #edb/ref 1080 "\\frac{3M}{2}" #edb/ref 17592186045417] [17592186194530 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186194530 #edb/ref 1083 #uuid "40eef011-60c1-5f0d-bd81-34a57693cad5" #edb/ref 17592186045417] [17592186198057 #edb/ref 1069 "e-12485" #edb/ref 17592186045417] [17592186198057 #edb/ref 1071 "![](images/04/0405639a97f249bbcc4dc18a7eae5b4df24aefb4b4680b569365b3d841c15e6b.png)\n\n   \n\nA plate occupies the region $D$ enclosed by the $y$-axis and the lines $x=\\dfrac{y}2$ and $x=y-2$, as shown above. The mass density function of the plate is $\\lambda(x,y) =\\dfrac y8.$ Find the moment of inertia of the plate about the line $x=2.$" #edb/ref 17592186045417] [17592186198057 #edb/ref 1072 #uuid "985e1b18-0023-55ba-b4e4-69a109d8de58" #edb/ref 17592186045417] [17592186198057 #edb/ref 1074 "The moment of inertia of a plane lamina in the shape of a region $D$ about an axis of rotation $l$ is given by\n\n$$\nI_l = \\iint\\limits_D \\lambda (x,y) [r(x,y)]^2 \\:\\textrm{d}A,\n$$\n\nwhere $\\lambda(x,y)$ is the mass density function of the lamina, and $r(x,y)$ is the distance from the line $l$ to the point $(x,y)$ on $D.$\n\nFirst, notice that $D$ is a type I region with representation\n\n$$\nD = \\left\\{ (x,y) \\: : \\: 0 \\leq x \\leq 2, \\:\\: 2x \\leq y \\leq x+2 \\right\\},\n$$\n\nas shown below.\n\n![](images/69/69dcf02cc1883f2b04f81bd6dd486bbe24fedbb813db5778ae3b33ed1fb42e90.png)\n\n     \n\nThe distance between a point on $D$ and the line $x=2$ is given by\n\n$$\nr(x,y) = |x - 2|.\n$$\n\nTherefore, the moment of inertia about the line $x=2$ is\n\n$$\n\\begin{aligned}I & ={∬}_{D}\\lambda (x,y)[r(x,y)]^{2}\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{2x}^{x+2}(\\frac{y}{8})|x-2{|}^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{\\int }_{2x}^{x+2}(\\frac{y}{8})(x-2)^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(x-2)^{2}{\\int }_{2x}^{x+2}\\frac{y}{8}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(x-2)^{2}{[\\frac{{y}^{2}}{16}]}_{2x}^{x+2}\\,\\text{d}x \\\\  & =\\frac{1}{16}{\\int }_{0}^{2}(x-2)^{2}((x+2)^{2}-(2x)^{2})\\text{d}x \\\\  & =\\frac{1}{16}{\\int }_{0}^{2}({x}^{2}-4x+4)(4+4x-3{x}^{2})\\text{d}x \\\\  & =\\frac{1}{16}{\\int }_{0}^{2}(16-24{x}^{2}+16{x}^{3}-3{x}^{4})\\text{d}x \\\\  & =\\frac{1}{16}{[16x-8{x}^{3}+4{x}^{4}-\\frac{3{x}^{5}}{5}]}_{0}^{2} \\\\  & =\\frac{1}{16}(32-64+64-\\frac{96}{5})-0 \\\\  & =\\frac{1}{16}(\\frac{64}{5}) \\\\  & =\\frac{4}{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198058 #edb/ref 1069 "e-12486" #edb/ref 17592186045417] [17592186198058 #edb/ref 1071 "![](images/67/67d511da69c49e77822011936522f2b236ccc0fa0e0fcd09ce26b428cc8f738a.png)\n\n \n\nA plate with mass $M$ and uniform mass density occupies the region $D$ enclosed between the curves $y=x$ and $y=4x-x^2$, as shown above. Given that the region has an area of $\\dfrac92$ square units, find the moment of inertia of the plate about the line $x=3.$" #edb/ref 17592186045417] [17592186198058 #edb/ref 1072 #uuid "eab955a5-019b-5219-b5d5-32e3818be4b9" #edb/ref 17592186045417] [17592186198058 #edb/ref 1074 "The moment of inertia of a plane lamina in the shape of a region $D$ about an axis of rotation $l$ is given by\n\n$$\nI_l = \\iint\\limits_D \\lambda (x,y) [r(x,y)]^2 \\:\\textrm{d}A,\n$$\n\nwhere $\\lambda(x,y)$ is the mass density function of the lamina, and $r(x,y)$ is the distance from the line $l$ to the point $(x,y)$ on $D.$\n\nFirst, notice that $D$ is a type I region with representation\n\n$$\nD = \\left\\{ (x,y) \\: : \\: 0 \\leq x \\leq 3, \\:\\: x \\leq y \\leq 4x-x^2 \\right\\},\n$$\n\nas shown below.\n\n![](images/62/6291950b5483f3c102df7249674412c7c11646409cb1b43df604de6bd5ace86f.png)\n\n  \n\nThe distance between a point on $D$ and the line $x=3$ is given by\n\n$$\nr(x,y) = |x - 3|.\n$$\n\nSince the plate has uniform density, the mass density function is given by\n\n$$\n\\lambda(x,y) = \\dfrac{M}{\\mathcal{A}} = \\dfrac{2M}{9}.\n$$\n\nTherefore, the moment of inertia about the line $x=3$ is\n\n$$\n\\begin{aligned}I & ={∬}_{D}\\lambda (x,y)[r(x,y)]^{2}\\,\\text{d}A \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}{\\int }_{x}^{4x-{x}^{2}}|x-3{|}^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}{\\int }_{x}^{4x-{x}^{2}}(x-3)^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}(x-3)^{2}[y]_{y=x}^{y=4x-{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}({x}^{2}-6x+9)(3x-{x}^{2})\\,\\text{d}x \\\\  & =\\frac{2M}{9}{\\int }_{0}^{3}-{x}^{4}+9{x}^{3}-27{x}^{2}+27x\\,\\text{d}x \\\\  & =\\frac{2M}{9}{[-\\frac{{x}^{5}}{5}+\\frac{9{x}^{4}}{4}-9{x}^{3}+\\frac{27{x}^{2}}{2}]}_{0}^{3} \\\\  & =\\frac{2M}{{3}^{2}}(-\\frac{{3}^{5}}{5}+\\frac{{3}^{6}}{4}-{3}^{5}+\\frac{{3}^{5}}{2}) \\\\  & =2\\cdot {3}^{3}M(-\\frac{1}{5}+\\frac{3}{4}-1+\\frac{1}{2}) \\\\  & =\\frac{27M}{10}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198060 #edb/ref 1069 "e-12488" #edb/ref 17592186045417] [17592186198060 #edb/ref 1071 "![](images/8e/8ec9b8832f3286032413c4016e88a58a593dfd1b32164e219dc1c2e56e3b0b97.png)\n\nA plate with mass $M$ occupies the region $D$ in the first quadrant enclosed between the curve $y=\\sqrt x$ and the line $x=1,$ as shown above. \nThe mass density at each point is proportional to its distance from the $x$-axis. Find the moment of inertia of the plate about the line $x=-1.$" #edb/ref 17592186045417] [17592186198060 #edb/ref 1072 #uuid "0f7dbe9f-b448-5e76-9932-68e1ff99904e" #edb/ref 17592186045417] [17592186198060 #edb/ref 1074 "The moment of inertia of a plane lamina in the shape of a region $D$ about an axis of rotation $l$ is given by\n\n$$\nI_l = \\iint\\limits_D \\lambda (x,y) [r(x,y)]^2 \\:\\textrm{d}A,\n$$\n\nwhere $\\lambda(x,y)$ is the mass density function of the lamina, and $r(x,y)$ is the distance from the line $l$ to the point $(x,y)$ on $D.$\n\nFirst, notice that $D$ is a type I region with representation\n\n$$\nD = \\left\\{ (x,y) \\: : \\: 0 \\leq x \\leq 1, \\:\\: 0 \\leq y \\leq \\sqrt x \\right\\},\n$$\n\nas shown below.\n\n![](images/7f/7faaecf39250dbdd1b92d789f6c217afe883c27533b563dae82ed82d228d9b4d.png)\n\nAlso, the distance between a point and the line $x=-1$ is given by\n\n$$\nr(x,y) = |x-(-1)| = |x+1|.\n$$\n\nNext, the mass density can be written as $\\lambda(x,y) = k |y| = ky,$ where $k$ is a constant of proportionality. We can find the value of $k$ by integrating the mass density function over the plate.\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{x}}ky\\,\\text{d}y\\,\\text{d}x \\\\  & =k{\\int }_{0}^{1}{[\\frac{1}{2}{y}^{2}]}_{0}^{\\sqrt{x}}\\,\\text{d}x \\\\  & =\\frac{k}{2}{\\int }_{0}^{1}(x-0)\\,\\text{d}x \\\\  & =\\frac{k}{2}{\\int }_{0}^{1}x\\,\\text{d}x \\\\  & =\\frac{k}{2}\\cdot {[\\frac{1}{2}{x}^{2}]}_{0}^{1} \\\\  & =\\frac{k}{4}\\end{aligned}\n$$\n\nHence, \n\n$$\n\\lambda(x,y) = k y = 4M y.\n$$\n\nTherefore, the moment of inertia about the line $x=-1$ is\n\n$$\n\\begin{aligned}{I}_{l} & ={∬}_{D}\\lambda (x,y)[r(x,y)]^{2}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{x}}4My\\,|x+1{|}^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{x}}4My(x+1)^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & =4M{\\int }_{0}^{1}(x+1)^{2}{\\int }_{0}^{\\sqrt{x}}y\\,\\text{d}y\\,\\text{d}x \\\\  & =4M{\\int }_{0}^{1}(x+1)^{2}{[\\frac{1}{2}{y}^{2}]}_{0}^{\\sqrt{x}}\\,\\text{d}x \\\\  & =2M{\\int }_{0}^{1}(x+1)^{2}(x-0)\\,\\text{d}x \\\\  & =2M{\\int }_{0}^{1}({x}^{3}+2{x}^{2}+x)\\,\\text{d}x \\\\  & =2M{[\\frac{1}{4}{x}^{4}+\\frac{2}{3}{x}^{3}+\\frac{1}{2}{x}^{2}]}_{0}^{1} \\\\  & =2M(\\frac{1}{4}+\\frac{2}{3}+\\frac{1}{2}) \\\\  & =2M\\cdot \\frac{17}{12} \\\\  & =\\frac{17M}{6}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198415 #edb/ref 1037 #edb/ref 17592186049331 #edb/ref 17592186045417] [17592186198415 #edb/ref 1037 #edb/ref 17592186050409 #edb/ref 17592186045417] [17592186198415 #edb/ref 1038 #edb/ref 17592186198644 #edb/ref 17592186045417] [17592186198415 #edb/ref 1038 #edb/ref 17592186198646 #edb/ref 17592186045417] [17592186198415 #edb/ref 1038 #edb/ref 17592186235555 #edb/ref 17592186045417] [17592186198415 #edb/ref 1038 #edb/ref 17592186281669 #edb/ref 17592186045417] [17592186198415 #edb/ref 1038 #edb/ref 17592186281671 #edb/ref 17592186045417] [17592186198415 #edb/ref 1038 #edb/ref 17592186281674 #edb/ref 17592186045417] [17592186198415 #edb/ref 1038 #edb/ref 17592186281675 #edb/ref 17592186045417] [17592186198415 #edb/ref 1038 #edb/ref 17592186281679 #edb/ref 17592186045417] [17592186198415 #edb/ref 1038 #edb/ref 17592186372223 #edb/ref 17592186045417] [17592186198415 #edb/ref 1039 "Calculating the Moment of Inertia of a Lamina Given a Mass Density Function" #edb/ref 17592186045417] [17592186198415 #edb/ref 1041 #edb/ref 17592186198057 #edb/ref 17592186045417] [17592186198415 #edb/ref 1042 #uuid "83edde2a-daa5-50ce-b48c-3ded50a1a179" #edb/ref 17592186045417] [17592186198416 #edb/ref 1038 #edb/ref 17592186198647 #edb/ref 17592186045417] [17592186198416 #edb/ref 1038 #edb/ref 17592186198648 #edb/ref 17592186045417] [17592186198416 #edb/ref 1038 #edb/ref 17592186284384 #edb/ref 17592186045417] [17592186198416 #edb/ref 1038 #edb/ref 17592186284385 #edb/ref 17592186045417] [17592186198416 #edb/ref 1038 #edb/ref 17592186284386 #edb/ref 17592186045417] [17592186198416 #edb/ref 1038 #edb/ref 17592186284387 #edb/ref 17592186045417] [17592186198416 #edb/ref 1038 #edb/ref 17592186372230 #edb/ref 17592186045417] [17592186198416 #edb/ref 1038 #edb/ref 17592186372237 #edb/ref 17592186045417] [17592186198416 #edb/ref 1039 "Calculating the Moment of Inertia of a Lamina With Uniform Mass Density" #edb/ref 17592186045417] [17592186198416 #edb/ref 1041 #edb/ref 17592186198058 #edb/ref 17592186045417] [17592186198416 #edb/ref 1042 #uuid "7321a6d4-007e-5813-bfa7-9e06d0789358" #edb/ref 17592186045417] [17592186198418 #edb/ref 1038 #edb/ref 17592186198649 #edb/ref 17592186045417] [17592186198418 #edb/ref 1038 #edb/ref 17592186198650 #edb/ref 17592186045417] [17592186198418 #edb/ref 1038 #edb/ref 17592186284395 #edb/ref 17592186045417] [17592186198418 #edb/ref 1038 #edb/ref 17592186284398 #edb/ref 17592186045417] [17592186198418 #edb/ref 1038 #edb/ref 17592186284399 #edb/ref 17592186045417] [17592186198418 #edb/ref 1038 #edb/ref 17592186284416 #edb/ref 17592186045417] [17592186198418 #edb/ref 1038 #edb/ref 17592186372244 #edb/ref 17592186045417] [17592186198418 #edb/ref 1038 #edb/ref 17592186372251 #edb/ref 17592186045417] [17592186198418 #edb/ref 1039 "Calculating the Moment of Inertia Given a Description of a Mass Density Function" #edb/ref 17592186045417] [17592186198418 #edb/ref 1041 #edb/ref 17592186198060 #edb/ref 17592186045417] [17592186198418 #edb/ref 1042 #uuid "4820138b-483c-5ced-8df9-9849f5f2a7cb" #edb/ref 17592186045417] [17592186198499 #edb/ref 1043 #edb/ref 17592186199261 #edb/ref 17592186045417] [17592186198499 #edb/ref 1043 #edb/ref 17592186199342 #edb/ref 17592186045417] [17592186198499 #edb/ref 1043 #edb/ref 17592186199343 #edb/ref 17592186045417] [17592186198499 #edb/ref 1043 #edb/ref 17592186199345 #edb/ref 17592186045417] [17592186198499 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186198499 #edb/ref 1045 "Moments of Inertia of Laminas About Other Axes" #edb/ref 17592186045417] [17592186198499 #edb/ref 1046 #edb/ref 17592186199261 #edb/ref 17592186045417] [17592186198499 #edb/ref 1049 #edb/ref 17592186048585 #edb/ref 17592186045417] [17592186198499 #edb/ref 1053 #uuid "a0472270-5f40-5310-8129-ab5eb91d56d0" #edb/ref 17592186045417] [17592186198649 #edb/ref 1068 #edb/ref 17592186194525 #edb/ref 17592186045417] [17592186198649 #edb/ref 1069 "q-163007" #edb/ref 17592186045417] [17592186198649 #edb/ref 1071 "A rectangular plate of mass $M$ occupies the region\n$D = {(x, y): - 1 \\le x \\le 2, 0 \\le y \\le 3}$.\nThe mass density at each point is proportional to the square of its distance from the $y$-axis. Find the moment of inertia of the plate about the line $y = 3$." #edb/ref 17592186045417] [17592186198649 #edb/ref 1072 #uuid "c50ed432-0fe6-5819-a38a-01c1c51de9fd" #edb/ref 17592186045417] [17592186199261 #edb/ref 1058 #edb/ref 17592186199342 #edb/ref 17592186045417] [17592186199261 #edb/ref 1061 31760 #edb/ref 17592186045417] [17592186199261 #edb/ref 1062 #uuid "a7b5aafb-1437-5b53-ac08-026c4b750ce9" #edb/ref 17592186045417] [17592186199261 #edb/ref 1063 #edb/ref 17592186199457 #edb/ref 17592186045417] [17592186199342 #edb/ref 1058 #edb/ref 17592186199343 #edb/ref 17592186045417] [17592186199342 #edb/ref 1061 44957 #edb/ref 17592186045417] [17592186199342 #edb/ref 1062 #uuid "30041ef5-a8d3-542d-8b3b-ca183a630d86" #edb/ref 17592186045417] [17592186199342 #edb/ref 1063 #edb/ref 17592186198415 #edb/ref 17592186045417] [17592186199343 #edb/ref 1058 #edb/ref 17592186199345 #edb/ref 17592186045417] [17592186199343 #edb/ref 1061 44958 #edb/ref 17592186045417] [17592186199343 #edb/ref 1062 #uuid "c09c8fe7-04df-57bb-b640-89d79bf7712b" #edb/ref 17592186045417] [17592186199343 #edb/ref 1063 #edb/ref 17592186198416 #edb/ref 17592186045417] [17592186199345 #edb/ref 1061 44962 #edb/ref 17592186045417] [17592186199345 #edb/ref 1062 #uuid "002ea8cc-7e94-5a8f-b910-6fbfdf671dcd" #edb/ref 17592186045417] [17592186199345 #edb/ref 1063 #edb/ref 17592186198418 #edb/ref 17592186045417] [17592186199457 #edb/ref 1064 "Recall that the moments of inertia $I_x$ and $I_y$ of a thin plate $D$ about the $x$- and $y$- axes are given by\n\n$$\nI_x = \\iint\\limits_D y^2\\,\\lambda(x,y) \\:\\textrm dA \\qquad\\textrm{and}\\qquad\nI_y = \\iint\\limits_D x^2\\,\\lambda(x,y) \\:\\textrm dA,\n$$\n\nwhere the factors $y^2$ and $x^2$ represent the squared distances from a point on the plate to the $x$- and $y$-axes, respectively.\n\nIn general, the **moment of inertia about an axis $l$** of a plane lamina occupying the region $D$ with mass density function $\\lambda(x,y)$ is given by\n\n$$\nI_l = \\iint\\limits_D \\lambda(x,y) [r(x,y)]^2 \\:\\textrm{d}A,\n$$\n\nwhere $r(x,y)$ is the distance from the point $(x,y)$ to the axis $l.$\n\nFor example, consider the thin plate that occupies the region\n\n$$\nD = \\big\\{ (x,y) \\: : \\: -1 \\leq x \\leq 1, \\:\\: 0 \\leq y \\leq 1 \\big\\}\n$$\n\nwith mass density function $\\lambda(x,y) = 3x+6.$ Let's find its moment of inertia about the line $y=2.$\n\n![](images/24/2451a992f9ecdea8aa1775b64b3a182e0df3f7eab8cac87307c49ed164c6b813.png)\n\nThe distance between a point $(x,y)$ on $D$ and the line $y=2$ is given by\n\n$$\nr(x,y) = |2 - y|.\n$$\n\nTherefore, the moment of inertia about the line $y=2$ is\n\n$$\n\\begin{aligned}{I}_{l} & ={∬}_{D}\\lambda (x,y)[r(x,y)]^{2}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{1}(3x+6)\\,|2-y{|}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{1}3(x+2)(y-2)^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{-1}^{1}(x+2)\\,\\text{d}x\\cdot {\\int }_{0}^{1}3(y-2)^{2}\\,\\text{d}y \\\\  & ={[\\frac{(x+2)^{2}}{2}]}_{-1}^{1}\\cdot [(y-2)^{3}]_{0}^{1} \\\\  & =(\\frac{9}{2}-\\frac{1}{2})\\cdot (-1+8) \\\\  & =4\\cdot 7 \\\\  & =28.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186199457 #edb/ref 1065 5070 #edb/ref 17592186045417] [17592186199457 #edb/ref 1066 #uuid "a69630f6-6774-5350-b275-26cd501135dc" #edb/ref 17592186045417] [17592186199457 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186429360 #edb/ref 1030 0.5 #edb/ref 17592186045436] [17592186429360 #edb/ref 1032 "Initial Codex estimate from captured target-band crossing frequency. Selected account multivariable: 1 rises / 2 eligible passed source activities = 0.500000; nearest selected fraction = 1/2. Crossing activity numbers [1]; waits [1]. Separate account estimates: multivariable=1/2 (1/2). Selection: most observations, then lower weight, then account name; no averaging. Single-activity estimates included. Intervening target updates: True. Crossing frequency is the chosen practical estimate of encompassing coverage; a multi-band rise counts once. This does not interpret color steps as physical repetition units. Method: encompassing-report.md. Evidence: reference/mathacademy/encompassing-analysis-2026-10-11/frequency-fractions/multivariable-frequency-estimates.json, pair 4173->1061. All account evidence retained in the prepared import's selected-relationships.json." #edb/ref 17592186045436] [17592186429360 #edb/ref 1036 #edb/ref 17592186049380 #edb/ref 17592186045436] [17592186429361 #edb/ref 1030 1.0 #edb/ref 17592186045436] [17592186429361 #edb/ref 1032 "Initial Codex estimate from captured target-band crossing frequency. Selected account multivariable: 2 rises / 2 eligible passed source activities = 1.000000; nearest selected fraction = 1. Crossing activity numbers [1, 2]; waits [1, 1]. Separate account estimates: multivariable=1 (2/2). Selection: most observations, then lower weight, then account name; no averaging. Single-activity estimates included. Intervening target updates: True. Crossing frequency is the chosen practical estimate of encompassi