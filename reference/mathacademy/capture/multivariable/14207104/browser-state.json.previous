N\">(</mo><mroot><mi>x</mi><mn>4</mn></mroot><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo data-mjx-alternate=\"1\">′</mo></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>4</mn><mrow><mroot><mi>x</mi><mn>4</mn></mroot><msqrt><mn>1</mn><mo>−</mo><msqrt><mi>x</mi></msqrt></msqrt></mrow></mfrac></mstyle><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mn>4</mn><mroot><msup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow></msup><mn>4</mn></mroot></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mi>x</mi><msqrt><mn>1</mn><mo>−</mo><msqrt><mi>x</mi></msqrt></msqrt></mrow></mfrac></mstyle></mpadded></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
