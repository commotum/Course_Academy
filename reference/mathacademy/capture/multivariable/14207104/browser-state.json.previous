<mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mroot><mi>x</mi><mn>3</mn></mroot><msqrt><mn>1</mn><mo>−</mo><mroot><msup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msup><mn>3</mn></mroot></msqrt></mrow></mfrac></mstyle><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mn>3</mn><mroot><msup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msup><mn>3</mn></mroot></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mn>3</mn><mi>x</mi><msqrt><mn>1</mn><mo>−</mo><mroot><msup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msup><mn>3</mn></mroot></msqrt></mrow></mfrac></mstyle></mpadded></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
