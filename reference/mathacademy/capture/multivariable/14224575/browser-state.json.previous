          "input_html": "<div id=\"freeResponseTextbox-2\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:230px;\n                                        margin-left:4px;\n                                        margin-right:4px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"51\"><span mathquill-command-id=\"82\" class=\"\">−</span><span mathquill-command-id=\"84\">3</span><var mathquill-command-id=\"87\" class=\"mq-operator-name mq-first\">s</var><var mathquill-command-id=\"88\" class=\"mq-operator-name\">i</var><var mathquill-command-id=\"89\" class=\"mq-operator-name mq-last\">n</var><span mathquill-command-id=\"91\">(</span><span mathquill-command-id=\"93\">2</span><span mathquill-command-id=\"95\">(</span><var mathquill-command-id=\"97\">t</var><span mathquill-command-id=\"99\" class=\"mq-binary-operator\">−</span><span mathquill-command-id=\"101\">1</span><span mathquill-command-id=\"103\">)</span><span mathquill-command-id=\"105\">)</span><span mathquill-command-id=\"107\" class=\"mq-binary-operator\">+</span><var mathquill-command-id=\"110\" class=\"mq-operator-name\">c</var><var mathquill-command-id=\"111\" class=\"mq-operator-name\">o</var><var mathquill-command-id=\"112\" class=\"mq-operator-name mq-last\">s</var><span mathquill-command-id=\"114\">(</span><span mathquill-command-id=\"116\">2</span><span mathquill-command-id=\"118\">(</span><var mathquill-command-id=\"120\">t</var><span mathquill-command-id=\"122\" class=\"mq-binary-operator\">−</span><span mathquill-command-id=\"124\">1</span><span mathquill-command-id=\"126\">)</span><span mathquill-command-id=\"128\">)</span></span></div></div>",
          "rendered_text": "−3sin(2(t−1))+cos(2(t−1))",
