      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14224575/observations/step-q334926-d64a43ff43a80926304f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14224575/observations/step-q334926-d64a43ff43a80926304f.png",
