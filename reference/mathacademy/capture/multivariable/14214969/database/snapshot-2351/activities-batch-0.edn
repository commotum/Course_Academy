86302296} {:db/id #edb/ref 17592186302303} {:db/id #edb/ref 17592186332874} {:db/id #edb/ref 17592186332875} {:db/id #edb/ref 17592186341905} {:db/id #edb/ref 17592186341906}] :knowledge-point/title "Calculating the Derivative of the Inverse of a Composite Function"} :step/id #uuid "c53198f3-9bc3-55ad-9773-4cbd012d550a" :step/math-academy-id 831}] :activity/title "Differentiating Inverse Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120007}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186093335} :activity/id #uuid "21c10e32-8c2e-5d6b-a5cb-19f07aa83fdf" :activity/scope {:db/id #edb/ref 17592186049236 :topic/id #uuid "e5b028a3-9410-51df-925f-0bb38d65ee4b" :topic/math-academy-id 993} :activity/steps [{:db/id #edb/ref 17592186093089 :step/content {:db/id #edb/ref 17592186092242 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092084 :question/id #uuid "6e4ab84e-f722-557e-9740-25b3a0b3d660" :question/math-academy-id "e-6104"} :knowledge-point/id #uuid "6b175cb1-6615-540f-9145-224a838e37d0" :knowledge-point/questions [{:db/id #edb/ref 17592186092715} {:db/id #edb/ref 17592186092730} {:db/id #edb/ref 17592186317439} {:db/id #edb/ref 17592186329819} {:db/id #edb/ref 17592186339054} {:db/id #edb/ref 17592186339055} {:db/id #edb/ref 17592186508057} {:db/id #edb/ref 17592186508070} {:db/id #edb/ref 17592186508097}] :knowledge-point/title "Estimating a Derivative Given a Graph Using a Backward Difference Approximation"} :step/id #uuid "332d8f20-0643-51b2-8b43-875b7569adc3" :step/math-academy-id 22597 :step/next {:db/id #edb/ref 17592186093337}} {:db/id #edb/ref 17592186093090 :step/content {:db/id #edb/ref 17592186092243 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092085 :question/id #uuid "fb3d12e8-e413-5300-8d3f-991ddfd2a893" :question/math-academy-id "e-6105"} :knowledge-point/id #uuid "4d864064-2833-530a-b421-a57f9ec5fce5" :knowledge-point/questions [{:db/id #edb/ref 17592186092729} {:db/id #edb/ref 17592186092731} {:db/id #edb/ref 17592186317444} {:db/id #edb/ref 17592186317445} {:db/id #edb/ref 17592186317446} {:db/id #edb/ref 17592186329809} {:db/id #edb/ref 17592186354476} {:db/id #edb/ref 17592186508058} {:db/id #edb/ref 17592186508074}] :knowledge-point/title "Estimating a Derivative Given a Graph Using a Backward Difference Approximation: Word Problem"} :step/id #uuid "0358e8c8-7e96-5bb6-9fc7-eef0c1c3cde8" :step/math-academy-id 22598 :step/next {:db/id #edb/ref 17592186093338}} {:db/id #edb/ref 17592186093335 :step/content {:db/id #edb/ref 17592186093444 :tutorial/content "To approximate the derivative of a function, we can use the finite difference formula\n\n$$\nf'(x)\\approx \\frac{f(x) - f(x-h) }{h}\n$$\n\nfor small values of the step size $h,$ with $h>0.$\n\nThis expression is known as the **backward difference approximation** because if $h>0$ then $x-h$ is a step behind $x$ (i.e., to the left). \n\n![](images/dd/ddc03ba86c8c343d5733b51444cec157182894b6d0c4fccb501b1dc3bca98f57.png)\n\nAs usual, the smaller the step size $h$ is, the better the approximation to $f'(x)$ we obtain." :tutorial/id #uuid "6aff8fa6-f787-5984-944a-5648207e6830" :tutorial/math-academy-id 368 :tutorial/title "Introduction"} :step/id #uuid "5a2b7913-8af1-56e3-ae9c-6dea1ca15630" :step/math-academy-id 686 :step/next {:db/id #edb/ref 17592186093336}} {:db/id #edb/ref 17592186093336 :step/content {:db/id #edb/ref 17592186092390 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091959 :question/id #uuid "7a6fbfc8-cd6d-57fe-bcab-ab68339683bd" :question/math-academy-id "e-155"} :knowledge-point/id #uuid "494ef4f7-873c-5d87-85e5-89094c6cc376" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061} {:db/id #edb/ref 17592186049362}] :knowledge-point/questions [{:db/id #edb/ref 17592186092920} {:db/id #edb/ref 17592186092921} {:db/id #edb/ref 17592186317435} {:db/id #edb/ref 17592186317436} {:db/id #edb/ref 17592186317437} {:db/id #edb/ref 17592186339050} {:db/id #edb/ref 17592186339053} {:db/id #edb/ref 17592186508041} {:db/id #edb/ref 17592186508094} {:db/id #edb/ref 17592186508101}] :knowledge-point/title "Estimating a Derivative Given a Table Using a Backward Difference Approximation"} :step/id #uuid "f1579afd-f8b8-522d-815c-72dc7b18e4b7" :step/math-academy-id 687 :step/next {:db/id #edb/ref 17592186093089}} {:db/id #edb/ref 17592186093337 :step/content {:db/id #edb/ref 17592186092391 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091961 :question/id #uuid "cdf8854d-14ea-5564-81cc-4e5098f1acc3" :question/math-academy-id "e-156"} :knowledge-point/id #uuid "a6068e54-fa91-5078-86f8-d34f1f1a3ca4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048835}] :knowledge-point/questions [{:db/id #edb/ref 17592186092727} {:db/id #edb/ref 17592186092728} {:db/id #edb/ref 17592186317440} {:db/id #edb/ref 17592186317442} {:db/id #edb/ref 17592186329817} {:db/id #edb/ref 17592186332871} {:db/id #edb/ref 17592186339056} {:db/id #edb/ref 17592186508052} {:db/id #edb/ref 17592186508064} {:db/id #edb/ref 17592186508068} {:db/id #edb/ref 17592186508082} {:db/id #edb/ref 17592186511513}] :knowledge-point/title "Estimating a Derivative Given a Table Using a Backward Difference Approximation: Word Problem"} :step/id #uuid "84a50349-fb71-5a17-b1e7-276d47f34414" :step/math-academy-id 691 :step/next {:db/id #edb/ref 17592186093090}} {:db/id #edb/ref 17592186093338 :step/content {:db/id #edb/ref 17592186093445 :tutorial/content "Where does the formula for the backward difference come from? Remember that from the definition of derivative, we have the forward difference formula\n\n$$\nf'(x)\\approx \\frac{f(x+h) - f(x) }{h}\n$$\n\nfor small values of  $h.$ \n\nNow, replacing $h$ with $-h$ in the formula above gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & ≈\\frac{f(x-h)-f(x)}{-h} \\\\  & =\\frac{f(x)-f(x-h)}{h}.\\end{aligned}\n$$\n\nThe step of replacing $h$ with $-h$ is equivalent to stepping a distance of $h$ to the left rather than to the right." :tutorial/id #uuid "1cc2d207-71d4-53a4-8c67-5af0c5f4d173" :tutorial/math-academy-id 371 :tutorial/title "Derivation of the Formula"} :step/id #uuid "a635f38c-a7e9-57d1-aeb5-e9fe6f8751e0" :step/math-academy-id 694}] :activity/title "Estimating Derivatives Using a Backward Difference Quotient" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092467}] [{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186120906} :activity/id #uuid "2d42069d-5ae1-5bd7-8948-87caf7f08502" :activity/scope {:db/id #edb/ref 17592186049248 :topic/id #uuid "e6892f6e-116e-513d-8b41-f83291c0d8f3" :topic/math-academy-id 1784} :activity/steps [{:db/id #edb/ref 17592186120906 :step/content {:db/id #edb/ref 17592186121132 :tutorial/content "Suppose that a curve is defined by the following equation:\n\n$$\nx= y^3+y\n$$\n\nWe say that the equation of this curve is defined **implicitly** because instead of the usual [math]y = y(x),[/math] we have [math]x = x(y).[/math] Sometimes, it's convenient to define a curve this way. You'll meet more implicit curves later.\n\nTo graph this curve, we can start by selecting some values of [math]y[/math] and computing the corresponding [math]x[/math]-values as follows:\n\n\\begin{align}\n\ty=0 & \\quad \\longrightarrow\\quad  x=0^3+0=0 \\\\[5pt]\n\ty=1 & \\quad\\longrightarrow\\quad x=1^3+1=2  \\\\[5pt]\n\ty=2 & \\quad\\longrightarrow\\quad x=2^3+2=10 \\\\[5pt]\n\\end{align}\n\nSo we get the points [math](0,0),[/math] [math](2,1),[/math] and [math](10,2).[/math] If we plot these points and connect them with a smooth curve, we get the following graph:\n\nPlotting this curve in the $xy$-plane, we get the following:\n\n![](images/81/812db123dd422ff781472c73156a2f4d6e88a99aa3726668cd7a8b8882d6e0a8.png)\n\nTo find the slope of the tangent to this curve at a point, we need to follow two steps.\n\n- First, we calculate $\\dfrac{\\textrm dx}{\\textrm dy}$ by differentiating the equation of the curve with respect to $y.$\n\n- Then, we find $\\dfrac{\\textrm dy}{\\textrm dx}$ by taking the reciprocal of $\\dfrac{\\textrm dx}{\\textrm dy}{:}$\n\n$$\n\\dfrac{\\textrm dy}{\\textrm dx} = \\left( \\dfrac{\\textrm dx}{\\textrm dy} \\right)^{-1} = \\dfrac1{\\left(\\dfrac{\\textrm dx}{\\textrm dy}\\right)}\n$$\n\nWe'll explore some intuition behind this result at the end of the lesson, but for now, let's focus on carrying out the computation.\n\nWe start by differentiating $x=y^3+y$ with respect to $y\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}({y}^{3}+y) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{3})+\\frac{\\text{d}}{\\text{d}y}(y) \\\\  & =3{y}^{2}+1\\end{aligned}\n$$\n\nThen, we take its reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={(\\frac{\\text{d}x}{\\text{d}y})}^{-1} \\\\  & =\\frac{1}{(\\frac{\\text{d}x}{\\text{d}y})} \\\\  & =\\frac{1}{3{y}^{2}+1}\\end{aligned}\n$$\n\nNotice that the derivative is also defined implicitly. In other words, $\\dfrac{\\textrm dy}{\\textrm dx}$ is a function of $y,$ not $x.$\n\nTo calculate the slope of the tangent to this curve at a point, say $(2,{\\color{blue}{1}}),$ we substitute ${\\color{blue}{y}} = {\\color{blue}{1}}$ into our expression for $\\dfrac{\\textrm dy}{\\textrm dx}{:}$\n\n$$\n\\begin{aligned}{(\\frac{\\text{d}y}{\\text{d}x})}_{(2,1)} & =\\frac{1}{3(1)^{2}+1} \\\\  & =\\frac{1}{3+1} \\\\  & =\\frac{1}{4}\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve at the point $(2,1)$ equals $\\dfrac14.$" :tutorial/id #uuid "5b0053f2-47f3-5689-bf17-ed5cb69d36ff" :tutorial/math-academy-id 7757 :tutorial/title "Introduction"} :step/id #uuid "b397a95b-b908-5e5b-9f42-ed49282dc066" :step/math-academy-id 44886 :step/next {:db/id #edb/ref 17592186120907}} {:db/id #edb/ref 17592186120907 :step/content {:db/id #edb/ref 17592186119939 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119510 :question/id #uuid "9bd80a60-0f80-5cc2-8193-86fb32c79913" :question/math-academy-id "e-12467"} :knowledge-point/id #uuid "00ac6edc-908a-50be-9ef1-4b24ba597d1d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932} {:db/id #edb/ref 17592186050310} {:db/id #edb/ref 17592186050749}] :knowledge-point/questions [{:db/id #edb/ref 17592186120201} {:db/id #edb/ref 17592186120202} {:db/id #edb/ref 17592186233834} {:db/id #edb/ref 17592186233915} {:db/id #edb/ref 17592186244242} {:db/id #edb/ref 17592186284619} {:db/id #edb/ref 17592186297345} {:db/id #edb/ref 17592186315109}] :knowledge-point/title "Calculating dy/dx Using dx/dy"} :step/id #uuid "af93feeb-7b8f-59ee-be5e-0da7d777ae54" :step/math-academy-id 44887 :step/next {:db/id #edb/ref 17592186120908}} {:db/id #edb/ref 17592186120908 :step/content {:db/id #edb/ref 17592186119940 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119511 :question/id #uuid "51e74bbf-6ce4-58c4-84b1-44a2f4c46ada" :question/math-academy-id "e-12468"} :knowledge-point/id #uuid "0305491f-5ac7-5ba4-9a80-1a9a79b964f0" :knowledge-point/questions [{:db/id #edb/ref 17592186120194} {:db/id #edb/ref 17592186120195} {:db/id #edb/ref 17592186233581} {:db/id #edb/ref 17592186233919} {:db/id #edb/ref 17592186284620} {:db/id #edb/ref 17592186302307} {:db/id #edb/ref 17592186302313} {:db/id #edb/ref 17592186317157} {:db/id #edb/ref 17592186317159} {:db/id #edb/ref 17592186317173} {:db/id #edb/ref 17592186317174} {:db/id #edb/ref 17592186317175} {:db/id #edb/ref 17592186332872}] :knowledge-point/title "Calculating dy/dx at a Point Using dx/dy"} :step/id #uuid "2480daf5-3ffe-516c-866a-b654e699d3c6" :step/math-academy-id 44890 :step/next {:db/id #edb/ref 17592186120909}} {:db/id #edb/ref 17592186120909 :step/content {:db/id #edb/ref 17592186119941 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119512 :question/id #uuid "330c7f67-4c32-5ab7-9909-1835bba1b1f0" :question/math-academy-id "e-12469"} :knowledge-point/id #uuid "4ff302ba-5a3f-599b-b038-7417af1dca71" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050644}] :knowledge-point/questions [{:db/id #edb/ref 17592186120196} {:db/id #edb/ref 17592186120511} {:db/id #edb/ref 17592186233835} {:db/id #edb/ref 17592186233922} {:db/id #edb/ref 17592186247095} {:db/id #edb/ref 17592186284621} {:db/id #edb/ref 17592186284622} {:db/id #edb/ref 17592186284624} {:db/id #edb/ref 17592186284625} {:db/id #edb/ref 17592186284626} {:db/id #edb/ref 17592186297346} {:db/id #edb/ref 17592186317200} {:db/id #edb/ref 17592186317201} {:db/id #edb/ref 17592186317202}] :knowledge-point/title "Finding the Equation of a Tangent Line Using dx/dy"} :step/id #uuid "b4a418d9-3848-5c03-be63-b265c62b67cf" :step/math-academy-id 44893 :step/next {:db/id #edb/ref 17592186120910}} {:db/id #edb/ref 17592186120910 :step/content {:db/id #edb/ref 17592186121133 :tutorial/content "Throughout this lesson, we've made use of the following result:\n\n$$\n\\dfrac{\\textrm dy}{\\textrm dx} = \\left( \\dfrac{\\textrm dx}{\\textrm dy} \\right)^{-1}\n$$\n\nLet's now build some more intuition behind this result.\n\nConsider the graph of $x=f(y),$ shown below.\n\n![](images/f1/f11b52c2b788fcf1a9a161fa46843d42c10973545f2ff923750bcb4c50b9faca.png)\n\nThe slope of the tangent to $x=f(y)$ at $P$ is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{rise}}{\\text{run}}.\\end{aligned}\n$$\n\nNow, the quantity \n\n$$\n\\dfrac{\\textrm d x}{\\textrm d y}\n$$\n\n \n\nrepresents the change in $x$ *per unit change* in $y$ at $P.$ According to our diagram, this is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{run}}{\\text{rise}}.\\end{aligned}\n$$\n\nTherefore, we can write the slope of the tangent to the curve at $P$ as \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{rise}}{\\text{run}} \\\\  & ={(\\frac{\\text{run}}{\\text{rise}})}^{-1} \\\\  & =\\frac{1}{(\\frac{\\text{d}x}{\\text{d}y})}.\\end{aligned}\n$$\n\nThis result can also be proved formally using the so-called **chain rule**." :tutorial/id #uuid "2683a80b-0267-5fa3-b804-8d7b2373d85b" :tutorial/math-academy-id 7758 :tutorial/title "Justification of the Formula"} :step/id #uuid "8de8290a-13e2-54eb-b279-f4e2f96955ad" :step/math-academy-id 44896}] :activity/title "Calculating dy/dx Using dx/dy" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120006}] [{:activity/first-step {:db/id #edb/ref 17592186106842} :activity/id #uuid "c471a240-0edb-515b-884e-6ed88399df87" :activity/scope {:db/id #edb/ref 17592186050400 :topic/id #uuid "45b70174-b66e-5c6c-b00b-00ab595d2c86" :topic/math-academy-id 1282} :activity/steps [{:db/id #edb/ref 17592186106842 :step/content {:db/id #edb/ref 17592186107143 :tutorial/content "In this lesson, we'll learn how to compute derivatives of composite functions when given function data at specific points.\n\nFor example, suppose we know the values of two functions, $f(x), g(x)$, and their derivatives at the points $x=1$ and $x=2$. This data is given in the table below.\n\n| $x$ | $f(x)$ | $f'(x)$ | $g(x)$ | $g'(x)$ |\n| --- | ---: | ---: | ---: | ---: |\n| $1$ | $3$ | $-1$ | $\\color{blue}2$ | $\\color{violet}-4$ |\n| $2$ | $1$ | $\\color{red}5$ | $2$ | $-3$ |\n\nNow, let's define a new function $h(x)$ as\n\n$$\nh(x)=f(g(x))\n$$\n\nBy the chain rule, we have that\n\n$$\nh'(x) = f'(g(x)) \\cdot g'(x)\n$$\n\nTo compute, for example, $h'(1)$, we substitute $x=1$ into the expression for $h'(x)$ above.\n\n$$\nh'(1) = f'(g(1)) \\cdot g'(1)\n$$\n\nWe can now evaluate this derivative by substituting some values from the table above:\n\n$$\n\\begin{aligned}\nh^{′}(1) &= f^{′}(g(1)) \\cdot g^{′}(1) \\\\\n&= f^{′}(2) \\cdot g^{′}(1) \\\\\n&= 5 \\cdot (-4) \\\\\n&=-20\n\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\nh'(1) = -20\n$$" :tutorial/id #uuid "211d8a0e-f546-508d-8e07-742cfe71096c" :tutorial/math-academy-id 6804 :tutorial/title "Introduction"} :step/id #uuid "51fd23a1-fe82-5c3c-9f09-91136255ae36" :step/math-academy-id 41304 :step/next {:db/id #edb/ref 17592186106844}} {:db/id #edb/ref 17592186106843 :step/content {:db/id #edb/ref 17592186105862 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105446 :question/id #uuid "8776db19-9c89-596a-9c3d-ca024c5eefb9" :question/math-academy-id "e-10893"} :knowledge-point/id #uuid "55d07843-4356-52c7-80c0-0fcadbb2ff9f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048593}] :knowledge-point/questions [{:db/id #edb/ref 17592186106357} {:db/id #edb/ref 17592186106482} {:db/id #edb/ref 17592186106483}] :knowledge-point/title "Applying the Chain Rule With the Power Rule"} :step/id #uuid "7c0df726-98be-5d87-8e11-5bf81e54c112" :step/math-academy-id 41305 :step/next {:db/id #edb/ref 17592186106845}} {:db/id #edb/ref 17592186106844 :step/content {:db/id #edb/ref 17592186105863 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105447 :question/id #uuid "26d76ea2-54d3-5e10-a6d5-a0d18aeda001" :question/math-academy-id "e-10894"} :knowledge-point/id #uuid "7ca934a6-9d97-5918-a35b-d823f1e7a22a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051084}] :knowledge-point/questions [{:db/id #edb/ref 17592186106058} {:db/id #edb/ref 17592186106059}] :knowledge-point/title "Applying the Chain Rule Given Data For Two Functions"} :step/id #uuid "f2bff075-94e3-591b-b938-c12926641a39" :step/math-academy-id 41308 :step/next {:db/id #edb/ref 17592186106847}} {:db/id #edb/ref 17592186106845 :step/content {:db/id #edb/ref 17592186105864 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105448 :question/id #uuid "f6fabdb6-c5de-575a-884a-8ab4fde49d1d" :question/math-academy-id "e-10918"} :knowledge-point/id #uuid "a70226f4-4716-5208-af44-2bbc8b108a1b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050789}] :knowledge-point/questions [{:db/id #edb/ref 17592186106358} {:db/id #edb/ref 17592186106547}] :knowledge-point/title "Applying the Chain Rule With Trigonometric Functions"} :step/id #uuid "a3b6b996-b11e-5ec8-9355-1df2cd2b21da" :step/math-academy-id 41413 :step/next {:db/id #edb/ref 17592186106846}} {:db/id #edb/ref 17592186106846 :step/content {:db/id #edb/ref 17592186105865 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105449 :question/id #uuid "0ee077bf-f8c7-5fe5-969b-a8c3797fbfc8" :question/math-academy-id "e-10919"} :knowledge-point/id #uuid "6f23655a-bceb-5ee8-9ca6-e1494e76706a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049332} {:db/id #edb/ref 17592186050271}] :knowledge-point/questions [{:db/id #edb/ref 17592186106360} {:db/id #edb/ref 17592186106481}] :knowledge-point/title "Applying the Chain Rule With Exponential and Logarithmic Functions"} :step/id #uuid "5a21e8a3-2b50-510d-a20f-5b966b37aa40" :step/math-academy-id 41416} {:db/id #edb/ref 17592186106847 :step/content {:db/id #edb/ref 17592186107144 :tutorial/content "Let's now suppose we have the following data regarding the function $f(x)$ and its derivative $f'(x){:}$\n\n$$\nf(-1)={\\color{blue}2}, \\qquad\\qquad f'(-1)={\\color{red}-8}\n$$\n\nLet's use this data to evaluate the following derivative:\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left.\\left(\\dfrac{1}{f(x)}\\right)\\right|_{x=-1}\n$$\n\nFirst, we find an expression for the derivative using the chain rule:\n\n$$\n\\begin{aligned}\n\\frac{d}{dx}((1)/(f(x))) &= \\frac{d}{dx}(f(x))^{-1} \\\\\n&= - (f(x))^{-2} \\cdot f^{′}(x) \\\\\n&= - (1)/((f(x))^{2}) \\cdot f^{′}(x) \\\\\n&= - (f^{′}(x))/((f(x))^{2})\n\\end{aligned}\n$$\n\nNow, evaluating this expression at $x = -1$, we get\n\n$$\n\\begin{aligned}\n\\left.\\frac{d}{dx}((1)/(f(x)))\\right|_{x =-1} &= - (f^{′}(-1))/((f(-1))^{2}) \\\\\n&= - ((-8))/(2^{2}) \\\\\n&= \\frac{8}{4} \\\\\n&= 2\n\\end{aligned}\n$$" :tutorial/id #uuid "c9bcd9c5-3945-5522-b51e-d6af7cab658f" :tutorial/math-academy-id 6823 :tutorial/title "Using the Chain Rule With the Power Rule"} :step/id #uuid "d29136b4-446e-564d-a9f3-6b81bd88eb9f" :step/math-academy-id 41419 :step/next {:db/id #edb/ref 17592186106843}}] :activity/title "Calculating Derivatives From Data Using the Chain Rule" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105960}] [{:activity/first-step {:db/id #edb/ref 17592186101583} :activity/id #uuid "e216932a-7285-534e-b666-8b8934782d02" :activity/scope {:db/id #edb/ref 17592186050821 :topic/id #uuid "694fcacb-2468-51b2-bf00-fd3c25bc6cba" :topic/math-academy-id 1210} :activity/steps [{:db/id #edb/ref 17592186101583 :step/content {:db/id #edb/ref 17592186101997 :tutorial/content "The function $f(x)$ is differentiable on an open interval containing $x=2$. The values of $f$ and $f'$ are given in the following table:\n\n| $x$ | $f(x)$ | $f'(x)$ |\n| --- | ---: | ---: |\n| $2$ | $0$ | $4$ |\n\nLet's find\n\n$$\n\\lim\\limits_{x \\to 2} \\dfrac{f(x)}{x^3-8}\n$$\n\nNotice that if we try to substitute $x=2$ directly into the limit, we reach the indeterminate form\n\n$$\n\\dfrac{0}{0}\n$$\n\n$$\n\\begin{aligned}\nlim_(x → 2)(f(x))/(x^{3} - 8) &= \\left.(f(x))/(x^{3} - 8)\\right|_{x = 2} \\\\\n&= (f(2))/(2^{3} - 8) \\\\\n&= \\frac{0}{8 - 8} \\\\\n&= \\frac{0}{0}\n\\end{aligned}\n$$\n\nSo, we use L'Hopital's rule:\n\n$$\n\\begin{aligned}\nlim_(x → 2)(f(x))/(x^{3} - 8) &= lim_(x → 2)((f(x))^{′})/((x^{3} - 8)^{′}) \\\\\n&= lim_(x → 2)(f^{′}(x))/(3x^{2})\n\\end{aligned}\n$$\n\nWe substitute $x=2$ again, and this time, we are able to determine the result:\n\n$$\n\\begin{aligned}\nlim_(x → 2)(f^{′}(x))/(3x^{2}) &= \\left.(f^{′}(x))/(3x^{2})\\right|_{x = 2} \\\\\n&= (f^{′}(2))/(3 \\cdot 2^{2}) \\\\\n&= \\frac{4}{3 \\cdot 2^{2} - 0} \\\\\n&= \\frac{1}{3}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\lim\\limits_{x \\to 2} \\dfrac{f(x)}{x^3-8}=\\dfrac{1}{3}\n$$" :tutorial/id #uuid "c8d2f073-f126-5950-9555-61f8a6dd159a" :tutorial/math-academy-id 599 :tutorial/title "Introduction"} :step/id #uuid "e4ea661d-9e67-59ef-ae74-3ef55f82ab3a" :step/math-academy-id 1137 :step/next {:db/id #edb/ref 17592186101584}} {:db/id #edb/ref 17592186101584 :step/content {:db/id #edb/ref 17592186100811 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100623 :question/id #uuid "127247a2-3209-51aa-acb1-eceeaa0dec33" :question/math-academy-id "e-304"} :knowledge-point/id #uuid "c185115e-e3ce-5503-ab5f-a3d0b1a49cfd" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050961} {:db/id #edb/ref 17592186051036}] :knowledge-point/questions [{:db/id #edb/ref 17592186101223} {:db/id #edb/ref 17592186101224} {:db/id #edb/ref 17592186508115}] :knowledge-point/title "Determining the Limit of a Function Given as a Table of Values Using L'Hopital's Rule"} :step/id #uuid "06be6b30-b825-5dbe-9087-f089e5a3c396" :step/math-academy-id 1138 :step/next {:db/id #edb/ref 17592186101585}} {:db/id #edb/ref 17592186101585 :step/content {:db/id #edb/ref 17592186100812 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100624 :question/id #uuid "89a99552-00c5-5850-a567-1b338ab5e16b" :question/math-academy-id "e-305"} :knowledge-point/id #uuid "98e43a1e-2073-593b-9b55-4f9c25c356a8" :knowledge-point/questions [{:db/id #edb/ref 17592186101225} {:db/id #edb/ref 17592186101226} {:db/id #edb/ref 17592186234323} {:db/id #edb/ref 17592186508039} {:db/id #edb/ref 17592186508078}] :knowledge-point/title "Determining the Limit of a Function Given as a Table of Values Using L'Hopital's Rule Twice"} :step/id #uuid "97a0a8f1-3fcd-5681-9176-f997a3d0c81b" :step/math-academy-id 1142}] :activity/title "L'Hopital's Rule Applied to Tables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101065}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186508163} :activity/id #uuid "14ab7d13-6f0b-5222-a3a9-1ed470e14850" :activity/scope {:db/id #edb/ref 17592186050821 :topic/id #uuid "694fcacb-2468-51b2-bf00-fd3c25bc6cba" :topic/math-academy-id 1210} :activity/steps [{:db/id #edb/ref 17592186508133 :step/content {:db/id #edb/ref 17592186508115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c7e66c8-4fa9-5767-b29b-481d9fe42d85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{8}" :db/id #edb/ref 17592186507817}] :answer-field/correct {:db/id #edb/ref 17592186507817} :answer-field/id #uuid "45f70f8d-7947-54a7-beae-a31e706e6bd8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186507970}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f2656d5b-6dc2-54fa-8fec-eaac03937257" :question/math-academy-id "q-337001" :question/problem "The functions $f(x)$ and $g(x)$ are differentiable on an open interval containing $x=2.$ The values of $f,$ $g,$ and their respective derivatives are shown in the following table:\n\n| $x$ | $f(x)$ | ${f}^{′}(x)$ | $g(x)$ | ${g}^{′}(x)$ |\n| --- | --- | --- | --- | --- |\n| $2$ | $1$ | $3$ | $3$ | $4$ |\n\nUsing the values from the table, evaluate the following limit:\n\n${lim}_{x\\to 2}\\frac{\\sqrt{x+g(x)}-\\sqrt{5}}{f(x)+x-3}=$\n{{field-1}}" :question/worked-solution "Notice that if we try to substitute $x=2$ directly into the limit, we reach the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{\\sqrt{x+g(x)}-\\sqrt{5}}{f(x)+x-3} & ={\\frac{\\sqrt{x+g(x)}-\\sqrt{5}}{f(x)+x-3}|}_{x=2} \\\\  & =\\frac{\\sqrt{2+g(2)}-\\sqrt{5}}{f(2)+2-3} \\\\  & =\\frac{\\sqrt{2+3}-\\sqrt{5}}{1+2-3} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we use L'Hopital's rule:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{\\sqrt{x+g(x)}-\\sqrt{5}}{f(x)+x-3} & ={lim}_{x\\to 2}\\frac{(\\sqrt{x+g(x)}-\\sqrt{5})^{′}}{(f(x)+x-3)^{′}} \\\\  & ={lim}_{x\\to 2}\\frac{\\frac{1+{g}^{′}(x)}{2\\sqrt{x+g(x)}}}{{f}^{′}(x)+1}\\end{aligned}\n$$\n\nWe substitute $x=2$ again, and this time, we are actually able to determine the result:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{\\frac{1+{g}^{′}(x)}{2\\sqrt{x+g(x)}}}{{f}^{′}(x)+1} & ={\\frac{\\frac{1+{g}^{′}(x)}{2\\sqrt{x+g(x)}}}{{f}^{′}(x)+1}|}_{x=2} \\\\  & =\\frac{\\frac{1+{g}^{′}(2)}{2\\sqrt{2+g(2)}}}{{f}^{′}(2)+1} \\\\  & =\\frac{\\frac{1+4}{2\\sqrt{5}}}{3+1} \\\\  & =\\frac{5}{8\\sqrt{5}} \\\\  & =\\frac{\\sqrt{5}}{8}\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n{lim}_{x\\to 2}\\frac{\\sqrt{x+g(x)}-\\sqrt{5}}{f(x)+x-3}=\\frac{\\sqrt{5}}{8}.\n$$"} :step/id #uuid "583d5166-dcc0-5b93-bda9-b993bee6d50d" :step/next {:db/id #edb/ref 17592186508159}} {:db/id #edb/ref 17592186508147 :step/content {:db/id #edb/ref 17592186101225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "820e07be-f7af-5c55-845f-9376fcf32ba0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186098686} {:answer/id #uuid "a98a572c-078b-518f-8d0d-752b729706c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186098687} {:answer/id #uuid "c41d8e50-445e-5432-afc7-04fd27a889ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186098688} {:answer/id #uuid "19c02e67-ec8a-5bd2-a861-50e68971733c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186098690} {:answer/id #uuid "0351928c-3e28-54f2-8865-ccfc512917a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty " :db/id #edb/ref 17592186507607}] :answer-field/correct {:db/id #edb/ref 17592186098686} :answer-field/id #uuid "674fa78e-94ac-5ab1-b5f3-3afed06788d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186098685}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a7440b07-8ce3-57bb-bf61-42f3817efa6d" :question/math-academy-id "q-16174" :question/problem "The functions $f(x)$ and $g(x)$ are twice-differentiable on an open interval containing $x=10.$ The values of $f,$ $g,$ and their respective derivatives are given below:\n\n| $x$ | $f(x)$ | ${f}^{′}(x)$ | ${f}^{″}(x)$ | $g(x)$ | ${g}^{′}(x)$ | ${g}^{″}(x)$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $10$ | $-5$ | $0$ | $3$ | $-20$ | $-2$ | $-6$ |\n\n$$\n\n$$\n\nFind ${lim}_{x\\to 10}\\frac{f(x)+5}{2x+g(x)}.$" :question/worked-solution "Notice that if we try to substitute $x=10$ directly into the limit, we reach the indeterminate form $\\frac{0}{0}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to 10}\\frac{f(x)+5}{2x+g(x)} & ={\\frac{f(x)+5}{2x+g(x)}|}_{x=10} \\\\  & =\\frac{f(10)+5}{20+g(10)} \\\\  & =\\frac{-5+5}{20+(-20)} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we use L'Hopital's rule:\n\n$$\n\\begin{aligned}{lim}_{x\\to 10}\\frac{f(x)+5}{2x+g(x)} & ={lim}_{x\\to 10}\\frac{(f(x)+5)^{′}}{(2x+g(x))^{′}} \\\\  & ={lim}_{x\\to 10}\\frac{{f}^{′}(x)}{2+{g}^{′}(x)}\\end{aligned}\n$$\n\nWe substitute $x=10$ again, but once more, we reach the indeterminate form $\\frac{0}{0}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to 10}\\frac{{f}^{′}(x)}{2+{g}^{′}(x)} & ={\\frac{{f}^{′}(x)}{2+{g}^{′}(x)}|}_{x=10} \\\\  & =\\frac{{f}^{′}(10)}{2+{g}^{′}(10)} \\\\  & =\\frac{0}{2+(-2)} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nWe apply L'Hopital's rule again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 10}\\frac{{f}^{′}(x)}{2+{g}^{′}(x)} & ={lim}_{x\\to 10}\\frac{({f}^{′}(x))^{′}}{(2+{g}^{′}(x))^{′}} \\\\  & ={lim}_{x\\to 10}\\frac{{f}^{″}(x)}{{g}^{″}(x)},\\end{aligned}\n$$\n\nand this time, when we substitute $x=10,$ we are actually able to determine the result:\n\n$$\n\\begin{aligned}{lim}_{x\\to 10}\\frac{{f}^{″}(x)}{{g}^{″}(x)} & ={\\frac{{f}^{″}(x)}{{g}^{″}(x)}|}_{x=10} \\\\  & =\\frac{{f}^{″}(10)}{{g}^{″}(10)} \\\\  & =\\frac{3}{-6} \\\\  & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, ${lim}_{x\\to 10}\\frac{f(x)+5}{2x+g(x)}=-\\frac{1}{2}.$"} :step/id #uuid "a19df4dd-8442-5969-9c7a-12325b241bcc" :step/next {:db/id #edb/ref 17592186508133}} {:db/id #edb/ref 17592186508153 :step/content {:db/id #edb/ref 17592186508078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52ad2c6b-d809-5214-a3b9-4020cbd24ed3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186507723}] :answer-field/correct {:db/id #edb/ref 17592186507723} :answer-field/id #uuid "02cd3c44-7134-56fe-b1d4-7d91f48f8a31" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186507945}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8771f8a8-d420-525c-a30c-b75746b0e1ac" :question/math-academy-id "q-337304" :question/problem "The functions $f(x)$ and $g(x)$ are twice-differentiable on an open interval containing $x=1.$ The values of $f,$ $g,$ and their respective derivatives are given below:\n\n| $x$ | $f(x)$ | ${f}^{′}(x)$ | ${f}^{″}(x)$ | $g(x)$ | ${g}^{′}(x)$ | ${g}^{″}(x)$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $2$ | $-2$ | $4$ | $3$ | $-2$ | $2$ |\n\nUsing the values from the table, evaluate the following limit:\n\n${lim}_{x\\to 1}\\frac{\\,f(x)+{x}^{2}-3\\,}{\\,g(x)+{x}^{2}-4\\,}=$\n{{field-1}}" :question/worked-solution "Notice that if we try to substitute $x=1$ directly into the limit, we reach the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{f(x)+{x}^{2}-3}{g(x)+{x}^{2}-4} & ={\\frac{f(x)+{x}^{2}-3}{g(x)+{x}^{2}-4}|}_{x=1} \\\\  & =\\frac{f(1)+{1}^{2}-3}{g(1)+{1}^{2}-4} \\\\  & =\\frac{2+1-3}{3+1-4} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we use L'Hopital's rule:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{f(x)+{x}^{2}-3}{g(x)+{x}^{2}-4} & ={lim}_{x\\to 1}\\frac{(f(x)+{x}^{2}-3)^{′}}{(g(x)+{x}^{2}-4)^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{{f}^{′}(x)+2x}{{g}^{′}(x)+2x}\\end{aligned}\n$$\n\nWe substitute $x=1$ again, and once more we get the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{\\frac{{f}^{′}(x)+2x}{{g}^{′}(x)+2x}|}_{x=1} & =\\frac{{f}^{′}(1)+2(1)}{{g}^{′}(1)+2(1)} \\\\  & =\\frac{-2+2}{-2+2} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{f}^{′}(x)+2x}{{g}^{′}(x)+2x} & ={lim}_{x\\to 1}\\frac{({f}^{′}(x)+2x)^{′}}{({g}^{′}(x)+2x)^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{{f}^{″}(x)+2}{{g}^{″}(x)+2}\\end{aligned}\n$$\n\nNow we substitute $x=1$ and evaluate:\n\n$$\n\\begin{aligned}{\\frac{{f}^{″}(x)+2}{{g}^{″}(x)+2}|}_{x=1} & =\\frac{{f}^{″}(1)+2}{{g}^{″}(1)+2} \\\\  & =\\frac{4+2}{2+2} \\\\  & =\\frac{6}{4} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n{lim}_{x\\to 1}\\frac{\\,f(x)+{x}^{2}-3\\,}{\\,g(x)+{x}^{2}-4\\,}=\\frac{3}{2}.\n$$"} :step/id #uuid "b87c4769-3b0d-596e-be1a-a6f3c4ee5c2e"} {:db/id #edb/ref 17592186508159 :step/content {:db/id #edb/ref 17592186508039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cdf52d1c-d0cf-596a-b9d3-a36801c3cff4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186507883}] :answer-field/correct {:db/id #edb/ref 17592186507883} :answer-field/id #uuid "4aaa0726-be5f-51d0-b8c1-e8e9cc273212" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186507972}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "04a061b7-e5c9-583d-9ee4-5ed73b8719bb" :question/math-academy-id "q-337014" :question/problem "The functions $f(x)$ and $g(x)$ are twice-differentiable on an open interval containing $x=1.$ The values of $f,$ $g,$ and their respective derivatives are given below:\n\n| $x$ | $f(x)$ | ${f}^{′}(x)$ | ${f}^{″}(x)$ | $g(x)$ | ${g}^{′}(x)$ | ${g}^{″}(x)$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $e$ | $0$ | $0$ | $1$ | $1$ | $2$ |\n\nUsing the values from the table, evaluate the following limit:\n\n${lim}_{x\\to 1}\\frac{{e}^{x}-x\\,f(x)}{\\,f(x)g(x)-{e}^{x}\\,}=$\n{{field-1}}" :question/worked-solution "Notice that if we try to substitute $x=1$ directly into the limit, we reach the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{e}^{x}-xf(x)}{f(x)g(x)-{e}^{x}} & ={\\frac{{e}^{x}-xf(x)}{f(x)g(x)-{e}^{x}}|}_{x=1} \\\\  & =\\frac{{e}^{1}-1\\cdot f(1)}{f(1)g(1)-{e}^{1}} \\\\  & =\\frac{e-e}{(e)(1)-e} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we use L'Hopital's rule:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{e}^{x}-xf(x)}{f(x)g(x)-{e}^{x}} & ={lim}_{x\\to 1}\\frac{({e}^{x}-xf(x))^{′}}{(f(x)g(x)-{e}^{x})^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{{e}^{x}-(f(x)+x{f}^{′}(x))}{{f}^{′}(x)g(x)+f(x){g}^{′}(x)-{e}^{x}}\\end{aligned}\n$$\n\nWe substitute $x=1$ again, and once more we get the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{\\frac{{e}^{x}-(f(x)+x{f}^{′}(x))}{{f}^{′}(x)g(x)+f(x){g}^{′}(x)-{e}^{x}}|}_{x=1} & =\\frac{{e}^{1}-(f(1)+1\\cdot {f}^{′}(1))}{{f}^{′}(1)g(1)+f(1){g}^{′}(1)-{e}^{1}} \\\\  & =\\frac{e-(e+0)}{(0)(1)+(e)(1)-e} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{e}^{x}-(f(x)+x{f}^{′}(x))}{{f}^{′}(x)g(x)+f(x){g}^{′}(x)-{e}^{x}} & ={lim}_{x\\to 1}\\frac{({e}^{x}-(f(x)+x{f}^{′}(x)))^{′}}{({f}^{′}(x)g(x)+f(x){g}^{′}(x)-{e}^{x})^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{{e}^{x}-(2{f}^{′}(x)+x{f}^{″}(x))}{{f}^{″}(x)g(x)+2{f}^{′}(x){g}^{′}(x)+f(x){g}^{″}(x)-{e}^{x}}\\end{aligned}\n$$\n\nNow we substitute $x=1$ and evaluate:\n\n$$\n\\begin{aligned}{\\frac{{e}^{x}-(2{f}^{′}(x)+x{f}^{″}(x))}{{f}^{″}(x)g(x)+2{f}^{′}(x){g}^{′}(x)+f(x){g}^{″}(x)-{e}^{x}}|}_{x=1} & =\\frac{{e}^{1}-(2{f}^{′}(1)+1\\cdot {f}^{″}(1))}{{f}^{″}(1)g(1)+2{f}^{′}(1){g}^{′}(1)+f(1){g}^{″}(1)-{e}^{1}} \\\\  & =\\frac{e-(2(0)+0)}{(0)(1)+2(0)(1)+(e)(2)-e} \\\\  & =\\frac{e}{e} \\\\  & =1\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n{lim}_{x\\to 1}\\frac{{e}^{x}-x\\,f(x)}{\\,f(x)g(x)-{e}^{x}\\,}=1.\n$$"} :step/id #uuid "d7f3584e-f4ec-53ca-ac99-2039e2a0c5b7" :step/next {:db/id #edb/ref 17592186508153}} {:db/id #edb/ref 17592186508163 :step/content {:db/id #edb/ref 17592186101224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "995ee2bc-32e7-52c3-80dc-414e990c310e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186098680} {:answer/id #uuid "bdd47b6e-65a0-55fe-84a8-251b5428007d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-7" :db/id #edb/ref 17592186098681} {:answer/id #uuid "c539c20a-8046-594a-84ee-f7f4817bdc92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-49" :db/id #edb/ref 17592186098682} {:answer/id #uuid "1a103c06-551b-51c1-9bfc-8819966cdd79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{98}" :db/id #edb/ref 17592186098683} {:answer/id #uuid "20c11922-80fc-5319-973d-89251c21a028" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "49" :db/id #edb/ref 17592186098684}] :answer-field/correct {:db/id #edb/ref 17592186098683} :answer-field/id #uuid "871da4f1-95e8-5734-aac0-8ba943641482" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186098679}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "491eead7-322b-5130-8dbc-ee448e88420a" :question/math-academy-id "q-16172" :question/problem "The functions $f(x)$ and $g(x)$ are differentiable on an open interval containing $x=7.$ The values of $f,$ $g,$ and their respective derivatives are shown in the following table:\n\n| $x$ | $f(x)$ | ${f}^{′}(x)$ | $g(x)$ | ${g}^{′}(x)$ |\n| --- | --- | --- | --- | --- |\n| $7$ | $0$ | $1$ | $0$ | $2$ |\n\n$$\n\n$$\n\nFind ${lim}_{x\\to 7}\\frac{f(x)}{{x}^{2}g(x)}.$" :question/worked-solution "Notice that if we try to substitute $x=7$ directly into the limit, we reach the indeterminate form $\\frac{0}{0}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to 7}\\frac{f(x)}{{x}^{2}g(x)} & ={\\frac{f(x)}{{x}^{2}g(x)}|}_{x=7} \\\\  & =\\frac{f(7)}{{7}^{2}\\cdot g(7)} \\\\  & =\\frac{0}{49\\cdot 0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we use L'Hopital's rule:\n\n$$\n\\begin{aligned}{lim}_{x\\to 7}\\frac{f(x)}{{x}^{2}g(x)} & ={lim}_{x\\to 7}\\frac{(f(x))^{′}}{({x}^{2}g(x))^{′}} \\\\  & ={lim}_{x\\to 7}\\frac{{f}^{′}(x)}{2xg(x)+{x}^{2}{g}^{′}(x)}\\end{aligned}\n$$\n\nWe substitute $x=7$ again, and this time, we are actually able to determine the result:\n\n$$\n\\begin{aligned}{lim}_{x\\to 7}\\frac{{f}^{′}(x)}{2xg(x)+{x}^{2}{g}^{′}(x)} & ={\\frac{{f}^{′}(x)}{2xg(x)+{x}^{2}{g}^{′}(x)}|}_{x=7} \\\\  & =\\frac{{f}^{′}(7)}{2\\cdot 7\\cdot g(7)+{7}^{2}\\cdot {g}^{′}(7)} \\\\  & =\\frac{1}{0+49\\cdot 2} \\\\  & =\\frac{1}{98}\\end{aligned}\n$$\n\nTherefore, ${lim}_{x\\to 7}\\frac{f(x)}{{x}^{2}g(x)}=\\frac{1}{98}.$"} :step/id #uuid "e4ad71be-bbfe-51a4-8088-8a49f9968f26" :step/next {:db/id #edb/ref 17592186508147}}] :activity/title "L'Hopital's Rule Applied to Tables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186507598}] [{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186101607} :activity/id #uuid "e442df57-09a3-5dc2-8ca2-459fbbe7227c" :activity/scope {:db/id #edb/ref 17592186050961 :topic/id #uuid "75a8462b-b2e3-545e-a142-3221dfd27093" :topic/math-academy-id 1249} :activity/steps [{:db/id #edb/ref 17592186101607 :step/content {:db/id #edb/ref 17592186101942 :tutorial/content "Let's suppose we only know the values of the functions $f(x)$ and $g(x)$ at $x=0$ along with their derivatives, as given in the table below.\n\n| $x$ | $f(x)$ | $g(x)$ | $f'(x)$ | $g'(x)$ |\n| --- | --- | --- | --- | --- |\n| $0$ | $2$ | $3$ | $4$ | $5$ |\n\nCan we calculate $\\dfrac{\\textrm{d}}{\\textrm{d}x}\\Big( f(x)g(x)\\Big )$ at $x=0?$\n\nUsing the product rule, we have\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}\\Big( f(x)g(x)\\Big) = f'(x)g(x)+f(x)g'(x).\n$$\n\nAt the point where $x=0,$ this gives\n\n$$\n\\left.\\dfrac{\\textrm{d}}{\\textrm{d}x}\\Big( f(x)g(x)\\Big) \\right|_{x=0}\t=\tf'(0)g(0)+f(0)g'(0).\n$$\n\nAll of these values are given in the table! So, substituting the values from the table into the formula, we conclude that\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(f(x)g(x))|}_{x=0} & ={f}^{′}(0)g(0)+f(0){g}^{′}(0) \\\\  & =4\\cdot 3+2\\cdot 5 \\\\  & =22.\\end{aligned}\n$$" :tutorial/id #uuid "9df0b4fa-df54-5f34-9bdc-3fc11befd2e8" :tutorial/math-academy-id 2627 :tutorial/title "Introduction"} :step/id #uuid "060c1ce4-0c9d-5214-85ce-1b51fedd7791" :step/math-academy-id 12338 :step/next {:db/id #edb/ref 17592186101756}} {:db/id #edb/ref 17592186101608 :step/content {:db/id #edb/ref 17592186100827 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100662 :question/id #uuid "0713e68d-2b3e-5010-954f-7891d96bdbbb" :question/math-academy-id "e-3640"} :knowledge-point/id #uuid "d2b7d79a-cd1a-583f-be7a-d568bc8e32a3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048842}] :knowledge-point/questions [{:db/id #edb/ref 17592186101218} {:db/id #edb/ref 17592186101442} {:db/id #edb/ref 17592186241039} {:db/id #edb/ref 17592186297327} {:db/id #edb/ref 17592186315039} {:db/id #edb/ref 17592186315040} {:db/id #edb/ref 17592186329930} {:db/id #edb/ref 17592186329944} {:db/id #edb/ref 17592186445183} {:db/id #edb/ref 17592186445189}] :knowledge-point/title "Computing the Derivative of a Quotient Given the Necessary Data"} :step/id #uuid "22f4b88d-3d39-5cdb-8f96-eef99b7f8d43" :step/math-academy-id 12339 :step/next {:db/id #edb/ref 17592186101755}} {:db/id #edb/ref 17592186101609 :step/content {:db/id #edb/ref 17592186100828 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100663 :question/id #uuid "787e9681-8009-5ba8-acda-6d8830397d18" :question/math-academy-id "e-3641"} :knowledge-point/id #uuid "f1d07a6d-3994-5620-a756-ee6e2c0a8de6" :knowledge-