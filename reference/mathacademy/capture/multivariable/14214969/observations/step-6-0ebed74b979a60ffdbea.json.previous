n                                    \n                                 \n\n                                \n                                        </div> <!-- freeResponseLine --> \n                                    </div> <!-- freeResponse --> \n                                \n\n                                                      \n                        </div>  \n\n                        \n\n                        <div class=\"submitButtonFrame\">                     \n                            <div id=\"submitButton-6\" class=\"submitButton enabledButton\" style=\"display: none;\">Submit</div>                            \n                        </div>  \n                  \n                        <div class=\"spinnerFrame\">\n                            <img id=\"spinner-6\" class=\"spinner\" src=\"/img/spinner.gif\" style=\"display: none;\">\n                        </div>\n\n                        <div id=\"question-166148-explanationFrame\" style=\"display: block;\">\n                               \n                        <div class=\"answer\">\n                <table>\n                    <tbody><tr>\n                        <td><img class=\"answerSymbol\" src=\"/img/green-checkmark.png\"></td>\n                        <td class=\"correctAnswerText\">Correct</td>\n                    </tr>\n                </tbody></table></div><div class=\"explanationHeader\">Explanation</div><div class=\"questionExplanation\"><p>We use the backward difference approximation formula</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"74\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.413em; margin-left: 0.053em;\"><mjx-mo class=\"mjx-var\" size=\"s\"