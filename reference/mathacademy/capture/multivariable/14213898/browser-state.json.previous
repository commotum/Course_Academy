/msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo data-mjx-alternate=\"1\">′</mo></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><msup><mn>3</mn><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow></msup><msqrt><mn>1</mn><mo>−</mo><msup><mn>9</mn><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow></msup></msqrt></mrow></mfrac></mstyle><mo>⋅</mo><msup><mn>3</mn><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow></msup><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow></mrow><msqrt><mn>1</mn><mo>−</mo><msup><mn>9</mn><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow></msup></msqrt></mfrac></mstyle></mpadded></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
