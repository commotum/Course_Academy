tyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>4</mn><mi>x</mi></mfrac></mstyle><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>4</mn><mrow><mi>x</mi><msqrt><mn>1</mn><mo>+</mo><msup><mi>x</mi><mn>8</mn></msup></msqrt></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>4</mn><mi>x</mi></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><msqrt><mn>1</mn><mo>+</mo><msup><mi>x</mi><mn>8</mn></msup></msqrt></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
