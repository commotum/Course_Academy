SE\">)</mo></mrow><mo>⋅</mo><mo stretchy=\"false\">(</mo><mn>5</mn><mi>x</mi><msup><mo stretchy=\"false\">)</mo><mo data-mjx-alternate=\"1\">′</mo></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mrow><mn>5</mn><mi>x</mi><msqrt><mn>1</mn><mo>−</mo><mn>25</mn><msup><mi>x</mi><mn>2</mn></msup></msqrt></mrow></mfrac></mstyle><mo>⋅</mo><mn>5</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mrow><mi>x</mi><msqrt><mn>1</mn><mo>−</mo><mn>25</mn><msup><mi>x</mi><mn>2</mn></msup></msqrt></mrow></mfrac></mstyle></mpadded></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
