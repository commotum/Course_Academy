/mfrac></mstyle></math></mjx-assistive-mml></mjx-container>\n<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:80px;\n                                        margin-left:1px;\n                                        margin-right:0px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"21\"><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"23\"><span class=\"mq-numerator\" mathquill-block-id=\"25\"><span mathquill-command-id=\"24\">8</span></span><span class=\"mq-denominator\" mathquill-block-id=\"49\"><span class=\"mq-non-leaf\" mathquill-command-id=\"26\"><span class=\"mq-scaled mq-sqrt-prefix\" style=\"transform: scale(1, 1.31707);\">√</span><span class=\"mq-non-leaf mq-sqrt-stem\" mathquill-block-id=\"28\"><span mathquill-command-id=\"27\">4</span><var mathquill-command-id=\"29\">x</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"31\"><span class=\"mq-sup\" mathquill-block-id=\"33\"><span mathquill-command-id=\"32\">2</span></span></span><span mathquill-command-id=\"35\" class=\"mq-binary-operator\">−</span><span mathquill-command-id=\"37\">1</span><span mathquill-command-id=\"39\">2</span><var mathquill-command-id=\"41\">x</var><span mathquill-command-id=\"43\" class=\"mq-binary-operator\">+</span><span mathquill-command-id=\"45\">1</span><span mathquill-command-id=\"47\">0</span></span></span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div></div></div><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"ques