\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcsch x) = -\\dfrac{1}{|x|\\sqrt{1+x^2}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(7\\operatorname{arcsch}⁡(1-x)) \\\\  & =7\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡(1-x)) \\\\  & =7(-\\frac{1}{|1-x|\\sqrt{1+(1-x)^{2}}})\\cdot (1-x)^{′} \\\\  & =7(-\\frac{1}{|x-1|\\sqrt{1+1-2x+{x}^{2}}})\\cdot (-1) \\\\  & =\\frac{7}{|x-1|\\sqrt{{x}^{2}-2x+2}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166604 #edb/ref 1069 "e-8370" #edb/ref 17592186045417] [17592186166604 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y =  5\\arsech{2x},$ then $\\dfrac {\\textrm{d}y}{\\textrm{d}x}=$" #edb/ref 17592186045417] [17592186166604 #edb/ref 1072 #uuid "b4dd5d1a-eeae-58f5-b7a1-a6a20fb02df9" #edb/ref 17592186045417] [17592186166604 #edb/ref 1074 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arsech x) = -\\dfrac{1}{x\\sqrt{1-x^2}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5\\operatorname{arsech}⁡2x) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡2x) \\\\  & =5(-\\frac{1}{(2x)\\sqrt{1-(2x)^{2}}})\\cdot (2x)^{′} \\\\  & =-\\frac{5}{2x\\sqrt{1-4{x}^{2}}}\\cdot 2 \\\\  & =-\\frac{5}{x\\sqrt{1-4{x}^{2}}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166605 #edb/ref 1069 "e-8371" #edb/ref 17592186045417] [17592186166605 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y = \\arcoth{e^x},$ then $\\dfrac {\\textrm{d}y}{\\textrm{d}x}=$" #edb/ref 17592186045417] [17592186166605 #edb/ref 1072 #uuid "83b6c061-a8fc-5628-a199-60196b904407" #edb/ref 17592186045417] [17592186166605 #edb/ref 1074 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcoth x) = \\dfrac{1}{1-x^2}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡{e}^{x}) \\\\  & =\\frac{1}{1-({e}^{x})^{2}}\\cdot ({e}^{x})^{′} \\\\  & =\\frac{1}{1-{e}^{2x}}\\cdot {e}^{x} \\\\  & =\\frac{{e}^{x}}{1-{e}^{2x}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166606 #edb/ref 1069 "e-8372" #edb/ref 17592186045417] [17592186166606 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $f(x) = \\sin{x} \\cdot \\arcsch{x},$ then $f'(x) = \\cos{x} \\arcsch{x} + g(x).$ What is $g(x)?$" #edb/ref 17592186045417] [17592186166606 #edb/ref 1072 #uuid "8a1806e8-d99d-5107-aa63-0bf841cb44c2" #edb/ref 17592186045417] [17592186166606 #edb/ref 1074 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIn this case, the expression for $f(x)$  is a product $u(x) \\cdot v(x)$ with $u(x) = \\sin{x}$ and $v(x) = \\arcsch{x}.$ \n\nTherefore, we apply the product rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(\\operatorname{sin}⁡x)^{′}\\cdot \\operatorname{arcsch}⁡x+\\operatorname{sin}⁡x\\cdot (\\operatorname{arcsch}⁡x)^{′} \\\\  & =\\operatorname{cos}⁡x\\cdot \\operatorname{arcsch}⁡x+\\operatorname{sin}⁡x\\cdot (-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}) \\\\  & =\\operatorname{cos}⁡x\\operatorname{arcsch}⁡x+{{(-\\frac{\\operatorname{sin}⁡x}{|x|\\sqrt{1+{x}^{2}}})}_{⏟}}_{g(x)}\\end{aligned}\n$$\n\nTherefore, $g(x) = -\\dfrac{\\sin{x}}{|x|\\sqrt{1+x^2}}.$" #edb/ref 17592186045417] [17592186166765 #edb/ref 1037 #edb/ref 17592186051084 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186167345 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186167378 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186519550 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186519557 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186519567 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186519603 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186520455 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186520478 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186520480 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186520500 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186520501 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186525026 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186525041 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186525057 #edb/ref 17592186045417] [17592186166765 #edb/ref 1038 #edb/ref 17592186525063 #edb/ref 17592186045417] [17592186166765 #edb/ref 1039 "Differentiating an Inverse Csch Function" #edb/ref 17592186045417] [17592186166765 #edb/ref 1041 #edb/ref 17592186166603 #