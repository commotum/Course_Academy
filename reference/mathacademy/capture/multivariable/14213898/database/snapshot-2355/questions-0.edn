er-fields [{:answer-field/choices [{:answer/id #uuid "02f4fc9d-566b-5d57-ab60-fabca700ef9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{1-{e}^{-2x}}" :db/id #edb/ref 17592186524381} {:answer/id #uuid "0e7a943d-54c5-5b0f-baea-e089dd6d6ed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-3x}}{1-{e}^{-2x}}" :db/id #edb/ref 17592186524408} {:answer/id #uuid "1a96d37e-924f-570a-97eb-c47aad22e94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-{e}^{-2x}}{1-{e}^{-2x}}" :db/id #edb/ref 17592186524431} {:answer/id #uuid "6c93b3da-a9ec-50eb-83e6-da32af5214d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+{e}^{-x}}{1-{e}^{-2x}}" :db/id #edb/ref 17592186524558} {:answer/id #uuid "9963e428-bc98-5d5a-8bdf-bbf100df5e3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-2x}}{1-{e}^{-x}}" :db/id #edb/ref 17592186524627}] :answer-field/correct {:answer/id #uuid "0e7a943d-54c5-5b0f-baea-e089dd6d6ed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-3x}}{1-{e}^{-2x}}" :db/id #edb/ref 17592186524408} :answer-field/id #uuid "204adb77-c138-51ef-abaa-2ad33fd463d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524853}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ebac606-d705-5196-a808-5592aaa317af" :question/math-academy-id "q-95544" :question/problem "$$\n\nIf $y={e}^{-x}-\\operatorname{arcoth}⁡{e}^{-x},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({e}^{-x}-\\operatorname{arcoth}⁡{e}^{-x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{-x})-\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡{e}^{-x}) \\\\  & =-{e}^{-x}-\\frac{1}{1-({e}^{-x})^{2}}\\cdot ({e}^{-x})^{′} \\\\  & =-{e}^{-x}-\\frac{1}{1-{e}^{-2x}}\\cdot (-{e}^{-x}) \\\\  & =\\frac{{e}^{-x}}{1-{e}^{-2x}}-{e}^{-x} \\\\  & ={e}^{-x}(\\frac{1}{1-{e}^{-2x}}-1) \\\\  & ={e}^{-x}(\\frac{{e}^{-2x}}{1-{e}^{-2x}}) \\\\  & =\\frac{{e}^{-3x}}{1-{e}^{-2x}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186524974 :knowledge-point/_questions [{:db/id #edb/ref 17592186166767 :knowledge-point/id #uuid "74aa4936-437c-52c6-b5ec-f175443379a7" :knowledge-point/title "Differentiating an Inverse Coth Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04767459-77d9-53e0-8f3a-4e50f91b46c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x" :db/id #edb/ref 17592186524385} {:answer/id #uuid "6440a19f-723d-54fa-8469-a5e28443074d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{tan}^{2}⁡x" :db/id #edb/ref 17592186524546} {:answer/id #uuid "a28440b4-85d4-5314-bd6f-4661a409d1f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x" :db/id #edb/ref 17592186524641} {:answer/id #uuid "fa166499-b1c8-5634-aac0-e2d68fea0b82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡x" :db/id #edb/ref 17592186524830} {:answer/id #uuid "fa7a3b35-80dc-562d-8811-ba107d45cb51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x" :db/id #edb/ref 17592186524832}] :answer-field/correct {:answer/id #uuid "a28440b4-85d4-5314-bd6f-4661a409d1f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x" :db/id #edb/ref 17592186524641} :answer-field/id #uuid "5f722b7c-71a8-54c2-bd1f-6c40dfef6193" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524878}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "31ce7adb-3732-5d9f-92f5-a50363ba4c8e" :question/math-academy-id "q-95547" :question/problem "$$\n\nIf $y=\\operatorname{arcoth}⁡(\\operatorname{sin}⁡x),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡(\\operatorname{sin}⁡x)) \\\\  & =\\frac{1}{1-(\\operatorname{sin}⁡x)^{2}}\\cdot (\\operatorname{sin}⁡x)^{′} \\\\  & =\\frac{1}{1-{sin}^{2}⁡x}\\cdot \\operatorname{cos}⁡x \\\\  & =\\frac{\\operatorname{cos}⁡x}{{cos}^{2}⁡x} \\\\  & =\\frac{1}{\\operatorname{cos}⁡x} \\\\  & =\\operatorname{sec}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186525015 :knowledge-point/_questions [{:db/id #edb/ref 17592186166768 :knowledge-point/id #uuid "f5e40340-35cf-50ee-8a0d-7eb873490693" :knowledge-point/title "Differentiating Inverse Reciprocal Hyperbolic Functions Using the Product and Quotient Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "154fd44c-1903-5cec-bc2f-cfb042f862e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x}{\\sqrt{1+{x}^{2}}\\operatorname{arcoth}⁡x}" :db/id #edb/ref 17592186524421} {:answer/id #uuid "2e708ed0-211d-5ee2-b1e8-74d164752177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{(1-{x}^{2}){arcoth}^{2}⁡x}" :db/id #edb/ref 17592186524467} {:answer/id #uuid "5d2dd98c-0888-5e14-a9da-7bfa796c8fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡x}{(1-{x}^{2}){arcoth}^{2}⁡x}" :db/id #edb/ref 17592186524538} {:answer/id #uuid "68314971-85df-5e1a-bb8d-30df1853ed17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{sin}^{2}⁡x}{\\sqrt{1+{x}^{2}}{arcoth}^{2}⁡x}" :db/id #edb/ref 17592186524552} {:answer/id #uuid "9d4b0471-37b3-54f6-a468-ae5368af1054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{cos}^{2}⁡x}{(1-{x}^{2})\\operatorname{arcoth}⁡x}" :db/id #edb/ref 17592186524633}] :answer-field/correct {:answer/id #uuid "5d2dd98c-0888-5e14-a9da-7bfa796c8fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡x}{(1-{x}^{2}){arcoth}^{2}⁡x}" :db/id #edb/ref 17592186524538} :answer-field/id #uuid "61946e48-e92a-5775-b260-b027052600f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524881}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9939cec3-a9a6-5501-8d65-e82136850623" :question/math-academy-id "q-95558" :question/problem "$$\n\nIf $f(x)=\\frac{\\operatorname{sin}⁡x}{\\operatorname{arcoth}⁡x},$ then ${f}^{′}(x)=\\frac{\\operatorname{cos}⁡x}{\\operatorname{arcoth}⁡x}+g(x).$ What is $g(x)?$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=\\operatorname{sin}⁡x$ and $v(x)=\\operatorname{arcoth}⁡x.$\n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(\\operatorname{sin}⁡x)^{′}\\cdot \\operatorname{arcoth}⁡x-\\operatorname{sin}⁡x\\cdot (\\operatorname{arcoth}⁡x)^{′}}{{arcoth}^{2}⁡x} \\\\  & =\\frac{(\\operatorname{sin}⁡x)^{′}\\cdot \\operatorname{arcoth}⁡x}{{arcoth}^{2}⁡x}-\\frac{\\operatorname{sin}⁡x\\cdot (\\operatorname{arcoth}⁡x)^{′}}{{arcoth}^{2}⁡x} \\\\  & =\\frac{(\\operatorname{sin}⁡x)^{′}}{\\operatorname{arcoth}⁡x}-\\frac{\\operatorname{sin}⁡x\\cdot (\\operatorname{arcoth}⁡x)^{′}}{{arcoth}^{2}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x}{\\operatorname{arcoth}⁡x}-\\frac{\\operatorname{sin}⁡x}{{arcoth}^{2}⁡x}\\cdot (\\frac{1}{1-{x}^{2}}) \\\\  & =\\frac{\\operatorname{cos}⁡x}{\\operatorname{arcoth}⁡x}+{{(-\\frac{\\operatorname{sin}⁡x}{(1-{x}^{2}){arcoth}^{2}⁡x})}_{⏟}}_{g(x)}.\\end{aligned}\n$$\n\nTherefore, $g(x)=-\\frac{\\operatorname{sin}⁡x}{(1-{x}^{2}){arcoth}^{2}⁡x}.$"}]}
