e/math} :answer/value "-\\frac{2}{x\\sqrt{1-x}}" :db/id #edb/ref 17592186524529} {:answer/id #uuid "77214c0c-7d53-592a-a14c-29f5bd36ad09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{x\\sqrt{1-x}}" :db/id #edb/ref 17592186524573} {:answer/id #uuid "a8281447-5033-502d-9ea3-86ebac410880" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2x\\sqrt{1-x}}" :db/id #edb/ref 17592186524652} {:answer/id #uuid "ea8b1135-5f16-50d8-96f4-c69eeae83689" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2x\\sqrt{1-x}}" :db/id #edb/ref 17592186524797} {:answer/id #uuid "f8b7733d-aafb-5345-a612-3304ea1af449" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{x\\sqrt{1-x}}" :db/id #edb/ref 17592186524825}] :answer-field/correct {:answer/id #uuid "ea8b1135-5f16-50d8-96f4-c69eeae83689" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2x\\sqrt{1-x}}" :db/id #edb/ref 17592186524797} :answer-field/id #uuid "d42bd7e6-f1db-5a22-8dcd-e6edb8df0995" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165482}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "65936c62-e4f0-501f-bd1c-7003bd476189" :question/math-academy-id "q-95523" :question/problem "$$\n\nIf $y=\\operatorname{arsech}⁡\\sqrt{x},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡\\sqrt{x}) \\\\  & =-\\frac{1}{\\sqrt{x}\\cdot \\sqrt{1-{(\\sqrt{x})}^{2}}}\\cdot {(\\sqrt{x})}^{′} \\\\  & =-\\frac{1}{\\sqrt{x}\\cdot \\sqrt{1-x}}\\cdot \\frac{1}{2\\sqrt{x}} \\\\  & =-\\frac{1}{2x\\sqrt{1-x}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186525036 :knowledge-point/_questions [{:db/id #edb/ref 17592186166766 :knowledge-point/id #uuid "216296fc-1ce3-532f-b96c-3d352c6b6ef2" :knowledge-point/title "Differentiating an Inverse Sech Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "580baff0-5127-514b-bc2e-6c81d289eac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{(x-3)\\sqrt{{x}^{2}-6x+8}}" :db/id #edb/ref 17592186524533} {:answer/id #uuid "8917544d-559b-577c-8ba8-1430a960ff36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(x-3)^{2}\\sqrt{{x}^{2}-6x+8}}" :db/id #edb/ref 17592186524597} {:answer/id #uuid "a4bb3106-2e47-50d0-84fc-a8d09d82a983" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{(x-3)\\sqrt{-{x}^{2}+6x-8}}" :db/id #edb/ref 17592186524644} {:answer/id #uuid "cb4343a1-3927-5329-9b12-c84f24e0a18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(x-3)\\sqrt{-{x}^{2}+6x-8}}" :db/id #edb/ref 17592186524718} {:answer/id #uuid "d1ff5ad7-503f-5dfb-a830-f4530ad208c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-3}{\\sqrt{-{x}^{2}+6x-8}}" :db/id #edb/ref 17592186524730}] :answer-field/correct {:answer/id #uuid "cb4343a1-3927-5329-9b12-c84f24e0a18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(x-3)\\sqrt{-{x}^{2}+6x-8}}" :db/id #edb/ref 17592186524718} :answer-field/id #uuid "3199a6b3-9ebf-5ee0-ab91-18ad9a99a784" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524861}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bd478fb8-ad97-5721-be1e-e2165b917cab" :question/math-academy-id "q-95524" :question/problem "$$\n\nIf $y=-\\operatorname{arsech}⁡(x-3),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{arsech}⁡(x-3)) \\\\  & =-(-\\frac{1}{(x-3)\\sqrt{1-(x-3)^{2}}})\\cdot (x-3)^{′} \\\\  & =\\frac{1}{(x-3)\\sqrt{1-{x}^{2}+6x-9}}\\cdot 1 \\\\  & =\\frac{1}{(x-3)\\sqrt{-{x}^{2}+6x-8}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186525007 :knowledge-point/_questions [{:db/id #edb/ref 17592186166766 :knowledge-point/id #uuid "216296fc-1ce3-532f-b96c-3d352c6b6ef2" :knowledge-point/title "Differentiating an Inverse Sech Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01fd6b21-4e7c-562e-8083-7e0e34e7e8c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡x\\sqrt{1-{ln}^{2}⁡x}}" :db/id #edb/ref 17592186524380} {:answer/id #uuid "9e0a76b4-f502-5e5f-ac2c-3c8acd63b518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{x\\operatorname{ln}⁡x\\sqrt{1-\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186524635} {:answer/id #uuid "dd9737e3-0ec2-5ba3-add4-cec93d9b1ee2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{x\\operatorname{ln}⁡x\\sqrt{1-{ln}^{2}⁡x}}" :db/id #edb/ref 17592186524758} {:answer/id #uuid "e46fb9aa-b37c-53cd-95f3-b44d1c1a0d19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.