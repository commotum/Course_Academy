ield/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401607}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "711d64e0-f4d6-5c58-a54c-d6327695bb3b" :question/math-academy-id "q-171016" :question/problem "$\\,$ $3\\,|\\,18$ or $11$ is not prime.\n\nWhat is the negation of the compound statement above?" :question/worked-solution "De Morgan's law for disjunctions states that the negation of a disjunction of two statements is equivalent to the conjunction of the negations of the individual statements. It can be stated symbolically as follows:\n\n$$\n¬(A∨B)=¬A∧¬B.\n$$\n\nSo, the negation of our statement is\n\n$$\n\\begin{aligned}¬(3\\,|\\,18\\text{ or }11\\text{ is not prime}) & ≡¬((3\\,|\\,18)∨(11\\text{ is not prime})) \\\\  & ≡¬(3\\,|\\,18)∧¬(11\\text{ is not prime}) \\\\  & ≡(3\\,\\text{⧸}|\\,18)∧(11\\text{ is prime}) \\\\  & ≡3\\,\\text{⧸}|\\,18\\text{ and }11\\text{ is prime}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401695 :knowledge-point/_questions [{:db/id #edb/ref 17592186059696 :knowledge-point/id #uuid "d9de08e2-7bf6-5ab5-bb90-7f2896dda1dc" :knowledge-point/title "Negating a Sentence Containing a Conjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "938c3ee2-cabf-5d4b-a82f-51aa90a79cbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|{1,x}|=0$ and $x$ is rational" :db/id #edb/ref 17592186401697} {:answer/id #uuid "21140988-0342-5bc8-9482-5fe6d5552b36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|{1,x}|\\ne 0$ and $x$ is not rational" :db/id #edb/ref 17592186401698} {:answer/id #uuid "e7a791d9-ddce-54ec-9234-65d0e6facd4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|{1,x}|=0$ and $x$ is not rational" :db/id #edb/ref 17592186401699} {:answer/id #uuid "03