#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186060565} :activity/id #uuid "49ad5fef-36f7-53a5-9400-a38064d1f445" :activity/scope {:db/id #edb/ref 17592186048378 :topic/id #uuid "9a6ced87-ea51-55d6-b162-fa59131bd20f" :topic/math-academy-id 230} :activity/steps [{:db/id #edb/ref 17592186060565 :step/content {:db/id #edb/ref 17592186060982 :tutorial/content "**De Morgan's laws** for logic tell us how to distribute a negation over a conjunction or disjunction.\n\n- De Morgan's law for conjunctions states that\n\n$$\n\\neg ( A \\land B) \\equiv \\neg A \\lor \\neg B.\n$$\n\n- De Morgan's law for disjunctions states that\n\n$$\n\\neg ( A \\lor B) \\equiv \\neg A \\land \\neg B.\n$$\n\nIntuitively, you can think that the negation \"flips\" the conjunction into a disjunction, and vice versa.\n\nTo prove that these laws hold, we can construct truth tables:\n\n- The following truth table shows that $\\neg ( A \\land B) \\equiv \\neg A \\lor \\neg B{:}$\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, \\neg ( A \\land B) \\,$ | $\\, \\neg A \\lor \\neg B \\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |\n| $\\textrm T$ | $\\textrm F$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\textrm F$ | $\\textrm T$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\textrm F$ | $\\textrm F$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n\n- The following truth table shows that $\\neg ( A \\lor B) \\equiv \\neg A \\land \\neg B{:}$\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, \\neg ( A \\lor B) \\,$ | $\\, \\neg A \\land \\neg B \\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |\n| $\\textrm T$ | $\\textrm F$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |\n| $\\textrm F$ | $\\textrm F$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |" :tutorial/id #uuid "11eb79a8-713f-5d33-bb4e-af361254bcc9" :tutorial/math-academy-id 7973 :tutorial/title "Introduction"} :step/id #uuid "395fc7fe-3175-579c-a510-019d03a347ea" :step/math-academy-id 154012 :step/next {:db/id #edb/ref 17592186060566}} {:db/id #edb/ref 17592186060566 :step/content {:db/id #edb/ref 17592186059696 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059403 :question/id #uuid "fc8d6c59-5351-5ca1-95e1-fa1470799bbc" :question/math-academy-id "e-12694"} :knowledge-point/id #uuid "d9de08e2-7bf6-5ab5-bb90-7f2896dda1dc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048349} {:db/id #edb/ref 17592186048778}] :knowledge-point/questions [{:db/id #edb/ref 17592186060105} {:db/id #edb/ref 17592186060108} {:db/id #edb/ref 17592186376254} {:db/id #edb/ref 17592186376261} {:db/id #edb/ref 17592186401695} {:db/id #edb/ref 17592186401702} {:db/id #edb/ref 17592186571388} {:db/id #edb/ref 17592186571451}] :knowledge-point/title "Negating a Sentence Containing a Conjunction"} :step/id #uuid "73c107a6-14f7-5621-8623-0041277016c2" :step/math-academy-id 154013 :step/next {:db/id #edb/ref 17592186060567}} {:db/id #edb/ref 17592186060567 :step/content {:db/id #edb/ref 17592186059697 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059404 :question/id #uuid "4d1dc931-6a8c-53fc-abc7-369df54b0912" :question/math-academy-id "e-12695"} :knowledge-point/id #uuid "fe5bd766-d624-54e3-945e-7ae37b83886a" :knowledge-point/questions [{:db/id #edb/ref 17592186060106} {:db/id #edb/ref 17592186060107} {:db/id #edb/ref 17592186376374} {:db/id #edb/ref 17592186376381} {:db/id #edb/ref 17592186401709} {:db/id #edb/ref 17592186571400} {:db/id #edb/ref 17592186571402} {:db/id #edb/ref 17592186571418}] :knowledge-point/title "Negating a Sentence Containing a Disjunction"} :step/id #uuid "4ace0250-c3fc-5767-9fc3-6986b4f949f3" :step/math-academy-id 154016 :step/next {:db/id #edb/ref 17592186060568}} {:db/id #edb/ref 17592186060568 :step/content {:db/id #edb/ref 17592186059698 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059405 :question/id #uuid "a3430492-73ee-5c65-92cf-7059bb63b5a4" :question/math-academy-id "e-12696"} :knowledge-point/id #uuid "d9c85b7b-1326-5f25-aa21-ab115680582d" :knowledge-point/questions [{:db/id #edb/ref 17592186060409} {:db/id #edb/ref 17592186060410} {:db/id #edb/ref 17592186060416} {:db/id #edb/ref 17592186375993} {:db/id #edb/ref 17592186376007} {:db/id #edb/ref 17592186377858} {:db/id #edb/ref 17592186394331} {:db/id #edb/ref 17592186412403} {:db/id #edb/ref 17592186412404} {:db/id #edb/ref 17592186571384} {:db/id #edb/ref 17592186571428} {:db/id #edb/ref 17592186571439}] :knowledge-point/title "Simplifying a Statement Using De Morgan's Laws"} :step/id #uuid "3496d4e6-81b6-582f-b540-a1b948281c36" :step/math-academy-id 154019}] :activity/title "De Morgan's Laws for Logic" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059911}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186412406} :activity/id #uuid "c3cc4146-9649-5fb5-9d23-abaf47dab812" :activity/scope {:db/id #edb/ref 17592186048378 :topic/id #uuid "9a6ced87-ea51-55d6-b162-fa59131bd20f" :topic/math-academy-id 230} :activity/steps [{:db/id #edb/ref 17592186412405 :step/content {:db/id #edb/ref 17592186412404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f741991-a141-5276-a8d4-57eb0e969d65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(X∨¬Y)∨(Y∨¬X)" :db/id #edb/ref 17592186412385} {:answer/id #uuid "27d483a5-4b74-51c3-afed-f15698a3f732" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(X∧¬Y)∧(Y∧¬X)" :db/id #edb/ref 17592186412387} {:answer/id #uuid "2a6a0b74-0b77-5a06-af7f-bab166852439" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(X∧¬Y)∨(Y∧¬X)" :db/id #edb/ref 17592186412388} {:answer/id #uuid "57d56be7-2433-5af8-97e1-8cbd77845a6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(¬X∧Y)∨(¬Y∧X)" :db/id #edb/ref 17592186412391} {:answer/id #uuid "d912d6c4-6236-505e-b38a-bb93da4ffa7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(X∨¬Y)∧(Y∨¬X)" :db/id #edb/ref 17592186412398}] :answer-field/correct {:db/id #edb/ref 17592186412388} :answer-field/id #uuid "a67b8a1a-1e29-5f49-aed5-e25f5d418192" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186412401}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c2f8794d-09da-5fac-b8f1-8d4a0461ec58" :question/math-academy-id "q-82021" :question/problem "Rewrite the statement $¬((¬X∨Y)∧(¬Y∨X))$ using De Morgan's laws." :question/worked-solution "De Morgan's laws state that\n\n$$\n\\begin{aligned}¬(X∧Y)≡¬X∨¬Y, \\\\ ¬(X∨Y)≡¬X∧¬Y.\\end{aligned}\n$$\n\nSo, we can simplify the given statement as follows:\n\n$$\n\\begin{aligned}¬((¬X∨Y)∧(¬Y∨X)) & ≡¬(¬X∨Y)∨¬(¬Y∨X) \\\\  & ≡(¬(¬X)∧¬Y)∨(¬(¬Y)∧¬X) \\\\  & ≡(X∧¬Y)∨(Y∧¬X)\\end{aligned}\n$$"} :step/id #uuid "21966f1c-e6fb-5c1e-9a95-f17243e56104" :step/next {:db/id #edb/ref 17592186412407}} {:db/id #edb/ref 17592186412406 :step/content {:db/id #edb/ref 17592186060410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20acedc5-b294-5413-b17b-a5f3caa5c550" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∨Y" :db/id #edb/ref 17592186412386} {:answer/id #uuid "35e52632-f5b5-5772-ab79-32017923e196" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∧Y" :db/id #edb/ref 17592186412389} {:answer/id #uuid "7a601caa-cc1b-50ae-a2cc-5b34ed42a556" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∨¬Y" :db/id #edb/ref 17592186412393} {:answer/id #uuid "a1dba7c8-efea-5a6e-af84-29fb680cb947" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∨Y" :db/id #edb/ref 17592186412394} {:answer/id #uuid "c2e4a767-3062-5279-bea4-3a33192ca589" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∧Y" :db/id #edb/ref 17592186412396}] :answer-field/correct {:db/id #edb/ref 17592186412386} :answer-field/id #uuid "22d7e4ae-4469-5ebc-b1c2-b83f60deb2be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186412400}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ad44d3b-4c29-563d-b808-2a30dfb14db0" :question/math-academy-id "q-81866" :question/problem "Simplify the statement $¬(¬X∧¬Y)$ using De Morgan's laws." :question/worked-solution "De Morgan's laws state that\n\n$$\n\\begin{aligned}¬(X∧Y)≡¬X∨¬Y, \\\\ ¬(X∨Y)≡¬X∧¬Y.\\end{aligned}\n$$\n\nSo, we can simplify the given statement as follows:\n\n$$\n\\begin{aligned}¬(¬X∧¬Y) & ≡¬(¬X)∨¬(¬Y) \\\\  & ≡X∨Y\\end{aligned}\n$$"} :step/id #uuid "4799252c-ea6b-5670-9d5e-d175397a3f2c" :step/next {:db/id #edb/ref 17592186412405}} {:db/id #edb/ref 17592186412407 :step/content {:db/id #edb/ref 17592186412403 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40b2dd46-1198-5d87-b224-d8525e2ea132" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "M∧(M∨N)" :db/id #edb/ref 17592186412390} {:answer/id #uuid "714f9c1d-5f75-5406-8131-8c08a0f1d201" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬M∧(M∧N)" :db/id #edb/ref 17592186412392} {:answer/id #uuid "aa21de74-7e5f-5f4a-a934-8aaf6319d4b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬M∨(M∧N)" :db/id #edb/ref 17592186412395} {:answer/id #uuid "c37364bb-65e6-5ee8-876b-bf85f510962e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬M∧(M∨N)" :db/id #edb/ref 17592186412397} {:answer/id #uuid "da1e4c0f-f866-5e26-979c-4317c3877693" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬M∨(M∨N)" :db/id #edb/ref 17592186412399}] :answer-field/correct {:db/id #edb/ref 17592186412397} :answer-field/id #uuid "f01d7f51-6edf-5e38-8778-a57cf4875291" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186412402}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1cb6a373-1b10-5eb4-a08f-a0cc6efc15c9" :question/math-academy-id "q-129828" :question/problem "Rewrite the statement $¬(M∨(¬M∧¬N))$ using De Morgan's laws." :question/worked-solution "De Morgan's laws state that\n\n$$\n\\begin{aligned}¬(A∧B)≡¬A∨¬B, \\\\ ¬(A∨B)≡¬A∧¬B.\\end{aligned}\n$$\n\nSo, we can simplify the given statement as follows:\n\n$$\n\\begin{aligned}¬(M∨(¬M∧¬N)) & ≡¬M∧¬(¬M∧¬N) \\\\  & ≡¬M∧(¬(¬M)∨¬(¬N)) \\\\  & ≡¬M∧(M∨N)\\end{aligned}\n$$"} :step/id #uuid "dc0a8cf2-71ba-5e83-98a3-a4e5f830f9c6"}] :activity/title "De Morgan's Laws for Logic" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186412384}]}
