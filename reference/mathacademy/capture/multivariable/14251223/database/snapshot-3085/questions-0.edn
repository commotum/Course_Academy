er/id #uuid "2e60a72a-b148-51ff-ab94-ad143039db8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ is odd  and $10\\,\\text{⧸}|\\,50$" :db/id #edb/ref 17592186570961} {:answer/id #uuid "45dc3ec3-ff9f-557d-98cf-bb9ef4dccf38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ is even  or $10\\,|\\,50$" :db/id #edb/ref 17592186570998} {:answer/id #uuid "7b9ebd90-f63b-5341-8224-4d6f8665000a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ is even  or $10\\,\\text{⧸}|\\,50$" :db/id #edb/ref 17592186571086} {:answer/id #uuid "cce5f21d-c3a7-59c3-bfbf-2976e758d2a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ is even  and $10\\,\\text{⧸}|\\,50$" :db/id #edb/ref 17592186571206}] :answer-field/correct {:answer/id #uuid "cce5f21d-c3a7-59c3-bfbf-2976e758d2a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ is even  and $10\\,\\text{⧸}|\\,50$" :db/id #edb/ref 17592186571206} :answer-field/id #uuid "44b1fe2b-8dbf-5690-b1c2-df7624993dfd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571308}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5839b924-3e8e-5a75-a91d-b04c822d078a" :question/math-academy-id "q-182451" :question/problem "$\\,$ $10$ is odd or $10\\,|\\,50.$\n\nWhat is the negation of the compound statement above?" :question/worked-solution "De Morgan's law for disjunctions states that the negation of a disjunction of two statements is equivalent to the conjunction of the negations of the individual statements. It can be stated symbolically as follows:\n\n$$\n¬(A∨B)=¬A∧¬B\n$$\n\nSo, the negation of our statement is\n\n$$\n\\begin{aligned}¬(10\\text{ is odd}\\text{ or }10\\,|\\,50) & ≡¬((10\\text{ is odd})∨(10\\,|\\,50)) \\\\  & ≡¬(10\\text{ is odd})∧¬(10\\,|\\,50) \\\\  & ≡(10\\text{ is even})∧(10\\,\\text{⧸}|\\,50) \\\\  & ≡10\\text{ is even}\\text{ and }10\\,\\text{⧸}|\\,50.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186376374 :knowledge-point/_questions [{:db/id #edb/ref 17592186059697 :knowledge-point/id #uuid "fe5bd766-d624-54e3-945e-7ae37b83886a" :knowledge-point/title "Negating a Sentence Containing a Disjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a915252-8a28-59c6-bd86-2c6bd84206e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ is not integer or $5$ is positive" :db/id #edb/ref 17592186376376} {:answer/id #uuid "b5811ef9-2b42-5894-9f21-7047a2013a42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ is integer and $5$ is positive" :db/id #edb/ref 17592186376377} {:answer/id #uuid "8a89247a-0549-585b-92c5-4e6b3d9ce6ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ is not integer and $5$ is not positive" :db/id #edb/ref 17592186376378} {:answer/id #uuid "38569278-a785-5845-b784-b36363593133" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ is not integer or $5$ is not positive" :db/id #edb/ref 17592186376379} {:answer/id #uuid "62267499-5148-5d1e-804d-cb2c7a19ad5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ is not integer and $5$ is positive" :db/id #edb/ref 17592186376380}] :answer-field/correct {:answer/id #uuid "8a89247a-0549-585b-92c5-4e6b3d9ce6ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ is not integer and $5$ is not positive" :db/id #edb/ref 17592186376378} :answer-field/id #uuid "b28191e6-a805-5f54-8c92-ed941568714f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186376375}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f6bb99a-3d7f-5bf0-9077-86786b3b9774" :question/math-academy-id "q-182617" :question/problem "$\\,$ $5$ is integer or $5$ is positive.\n\nWhat is the negation of the compound statement above?" :question/worked-solution "De Morgan's law for disjunctions states that the negation of a disjunction of two statements is equivalent to the conjunction of the negations of the individual statements. It can be stated symbolically as follows:\n\n$$\n¬(A∨B)=¬A∧¬B\n$$\n\nSo, the negation of our statement is\n\n$$\n\\begin{aligned}¬(5\\text{ is integer}\\text{ or }5\\text{ is positive}) & ≡¬((5\\text{ is integer})∨(5\\text{ is positive})) \\\\  & ≡¬(5\\text{ is integer})∧¬(5\\text{ is positive}) \\\\  & ≡(5\\text{ is not integer})∧(5\\text{ is not positive}) \\\\  & ≡5\\text{ is not integer}\\text{ and }5\\text{ is not positive}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571402 :knowledge-point/_questions [{:db/id #edb/ref 17592186059697 :knowledge-point/id #uuid "fe5bd766-d624-54e3-945e-7ae37b83886a" :knowledge-point/title "Negating a Sentence Containing a Disjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de11b7b-2604-5a43-81c3-d473e165dec5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ is not negative or $\\{0\\}$ is empty" :db/id #edb/ref 17592186570933} {:answer/id #uuid "310400b8-3236-56fc-b8a1-822f379b20fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ is negative or $\\{0\\}$ is not empty" :db/id #edb/ref 17592186570968} {:answer/id #uuid "a1bc5761-2028-5885-9c9e-1902c4e29a4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ is not negative and $\\{0\\}$ is not empty" :db/id #edb/ref 17592186571144} {:answer/id #uuid "a5ff7803-e23e-5947-be3c-6737e32aa3ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ is not negative and $\\{0\\}$ is empty" :db/id #edb/ref 17592186571151} {:answer/id #uuid "cb90f2de-67ff-57ae-9858-b1e4e3fff3cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ is negative and $\\{0\\}$ is empty" :db/id #edb/ref 17592186571203}] :answer-field/correct {:answer/id #uuid "a5ff7803-e23e-5947-be3c-6737e32aa3ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ is not negative and $\\{0\\}$ is empty" :db/id #edb/ref 17592186571151} :answer-field/id #uuid "bf1b8432-40b7-53c4-bfee-fd2e4edc1844" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571355}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5efba9b1-d57e-5db5-8d34-ed2dd9f14d2b" :question/math-academy-id "q-182619" :question/problem "$\\,$ $0$ is negative or $\\{0\\}$ is not empty.\n\nWhat is the negation of the compound statement above?" :question/worked-solution "De Morgan's law for disjunctions states that the negation of a disjunction of two statements is equivalent to the conjunction of the negations of the individual statements. It can be stated symbolically as follows:\n\n$$\n¬(A∨B)=¬A∧¬B.\n$$\n\nSo, the negation of our statement is\n\n$$\n\\begin{aligned}¬(0\\text{ is negative}\\text{ or }\\{0\\}\\text{ is not empty}) & ≡¬((0\\text{ is negative})∨(\\{0\\}\\text{ is not empty})) \\\\  & ≡¬(0\\text{ is negative})∧¬(\\{0\\}\\text{ is not empty}) \\\\  & ≡(0\\text{ is not negative})∧(\\{0\\}\\text{ is empty}) \\\\  & ≡0\\text{ is not negative}\\text{ and }\\{0\\}\\text{ is empty}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571418 :knowledge-point/_questions [{:db/id #edb/ref 17592186059697 :knowledge-point/id #uuid "fe5bd766-d624-54e3-945e-7ae37b83886a" :knowledge-point/title "Negating a Sentence Containing a Disjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "203a29e8-cddb-51c2-b7aa-9c45eb2c1219" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ is not a rhombus or $Q$ is not a rectangle" :db/id #edb/ref 17592186570936} {:answer/id #uuid "20e1fa6a-4a62-5836-b4ba-11a2eded1e8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ is a rhombus and $Q$ is a rectangle" :db/id #edb/ref 17592186570938} {:answer/id #uuid "3f713160-3a26-5c0b-8777-1aa7e220d24c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ is a rhombus or $Q$ is a rectangle" :db/id #edb/ref 17592186570985} {:answer/id #uuid "41754bbb-e135-5737-bc6c-0219d0f8458e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ is a rhombus and $Q$ is not a rectangle" :db/id #edb/ref 17592186570989} {:answer/id #uuid "dae0852e-3db4-5738-b528-341b0bc199c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ is a rhombus or $Q$ is not a rectangle" :db/id #edb/ref 17592186571228}] :answer-field/correct {:answer/id #uuid "41754bbb-e135-5737-bc6c-0219d0f8458e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ is a rhombus and $Q$ is not a rectangle" :db/id #edb/ref 17592186570989} :answer-field/id #uuid "9b647c49-0fad-5ace-9be0-c641fb1f8973" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571342}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7bb1981d-f208-5e7e-b131-a36bdf5855b8" :question/math-academy-id "q-182620" :question/problem "$\\,$ $P$ is not a rhombus or $Q$ is a rectangle.\n\nWhat is the negation of the compound statement above?" :question/worked-solution "De Morgan's law for disjunctions states that the negation of a disjunction of two statements is equivalent to the conjunction of the negations of the individual statements. It can be stated symbolically as follows:\n\n$$\n¬(A∨B)=¬A∧¬B.\n$$\n\nSo, the negation of our statement is\n\n$$\n\\begin{aligned}\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,¬(P\\text{ is not a rhombus}\\text{ or }Q\\text{ is a rectangle}) & ≡¬((P\\text{ is not a rhombus})∨(Q\\text{ is a rectangle})) \\\\  & ≡¬(P\\text{ is not a rhombus})∧¬(Q\\text{ is a rectangle}) \\\\  & ≡(P\\text{ is a rhombus})∧(Q\\text{ is not a rectangle}) \\\\  & ≡P\\text{ is a rhombus}\\text{ and }Q\\text{ is not a rectangle}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060410 :knowledge-point/_questions [{:db/id #edb/ref 17592186059698 :knowledge-point/id #uuid "d9c85b7b-1326-5f25-aa21-ab115680582d" :knowledge-point/title "Simplifying a Statement Using De Morgan's Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20acedc5-b294-5413-b17b-a5f3caa5c550" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∨Y" :db/id #edb/ref 17592186412386} {:answer/id #uuid "35e52632-f5b5-5772-ab79-32017923e196" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬X∧Y" :db/id #edb/ref 17592186412389} {:answer/id #uuid "7a601caa-cc1b-50ae-a2cc-5b34ed42a556" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∨¬Y" :db/id #edb/ref 17592186412393} {:answer/id #uuid "a1dba7c8-efea-5a6e-af84-29fb680cb947" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬X∨Y" :db/id #edb/ref 17592186412394} {:answer/id #uuid "c2e4a767-3062-5279-bea4-3a33192ca589" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∧Y" :db/id #edb/ref 17592186412396}] :answer-field/correct {:answer/id #uuid "20acedc5-b294-5413-b17b-a5f3caa5c550" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∨Y" :db/id #edb/ref 17592186412386} :answer-field/id #uuid "22d7e4ae-4469-5ebc-b1c2-b83f60deb2be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412400}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ad44d3b-4c29-563d-b808-2a30dfb14db0" :question/math-academy-id "q-81866" :question/problem "Simplify the statement $¬(¬X∧¬Y)$ using De Morgan's laws." :question/worked-solution "De Morgan's laws state that\n\n$$\n\\begin{aligned}¬(X∧Y)≡¬X∨¬Y, \\\\ ¬(X∨Y)≡¬X∧¬Y.\\end{aligned}\n$$\n\nSo, we can simplify the given statement as follows:\n\n$$\n\\begin{aligned}¬(¬X∧¬Y) & ≡¬(¬X)∨¬(¬Y) \\\\  & ≡X∨Y\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186377858 :knowledge-point/_questions [{:db/id #edb/ref 17592186059698 :knowledge-point/id #uuid "d9c85b7b-1326-5f25-aa21-ab115680582d" :knowledge-point/title "Simplifying a Statement Using De Morgan's Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7f4b028-b351-53bb-a1e0-06459c553bab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨B" :db/id #edb/ref 17592186377860} {:answer/id #uuid "603c8fdd-37ce-5127-ac0b-80645793c34a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬A∨¬B" :db/id #edb/ref 17592186377861} {:answer/id #uuid "72b3357b-ff7a-5d9a-a739-9efa4115f5e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧¬B" :db/id #edb/ref 17592186377862} {:answer/id #uuid "90b8d944-0ee6-53eb-9ec4-cd0719a94924" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬A∧B" :db/id #edb/ref 17592186377863} {:answer/id #uuid "91413da9-af6d-5cec-92c3-b7b16c278284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨¬B" :db/id #edb/ref 17592186377864}] :answer-field/correct {:answer/id #uuid "91413da9-af6d-5cec-92c3-b7b16c278284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨¬B" :db/id #edb/ref 17592186377864} :answer-field/id #uuid "24466484-bded-5290-9119-b3c194d2d88d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377859}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9e09e71d-719e-5316-87f5-f69ed972d79d" :question/math-academy-id "q-82019" :question/problem "Simplify the statement $¬(¬A∧B)$ using De Morgan's laws." :question/worked-solution "De Morgan's laws state that\n\n$$\n\\begin{aligned}¬(A∧B)≡¬A∨¬B, \\\\ ¬(A∨B)≡¬A∧¬B.\\end{aligned}\n$$\n\nSo, we can simplify the given statement as follows:\n\n$$\n\\begin{aligned}¬(¬A∧B) & ≡¬(¬A)∨¬(B) \\\\  & ≡A∨¬B\\end{aligned}\n$$"}]}
