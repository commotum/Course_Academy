#{[{:db/id #edb/ref 17592186059403 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059696 :knowledge-point/id #uuid "d9de08e2-7bf6-5ab5-bb90-7f2896dda1dc" :knowledge-point/title "Negating a Sentence Containing a Conjunction"}] :question/id #uuid "fc8d6c59-5351-5ca1-95e1-fa1470799bbc" :question/math-academy-id "e-12694" :question/problem "What is the negation of the following compound statement? \n\n$\\qquad$ $6$ is composite and $5\\!\\not{|} \\, 3.$" :question/worked-solution "De Morgan's law posits that the negation of a conjunction of two statements is equivalent to the disjunction of the negated individual statements. It can be stated symbolically as follows.\n\n$$\n\\neg ( A \\land B) = \\neg A \\lor \\neg B\n$$\n\nSo, the negation of our statement is\n\n$$\n\\begin{aligned}¬(6\\text{ is composite}\\text{ and }5\\,\\text{⧸}|\\,3) & ≡¬((6\\text{ is composite})∧(5\\,\\text{⧸}|\\,3)) \\\\  & ≡¬(6\\text{ is composite})∨¬(5\\,\\text{⧸}|\\,3) \\\\  & ≡(6\\text{ is not composite})∨(5\\,|\\,3) \\\\  & ≡6\\text{ is not composite}\\text{ or }5\\,|\\,3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059404 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059697 :knowledge-point/id #uuid "fe5bd766-d624-54e3-945e-7ae37b83886a" :knowledge-point/title "Negating a Sentence Containing a Disjunction"}] :question/id #uuid "4d1dc931-6a8c-53fc-abc7-369df54b0912" :question/math-academy-id "e-12695" :question/problem "What is the negation of the following compound statement?\n\n$\\qquad$ $3$ is not prime or $\\pi$ is not rational." :question/worked-solution "De Morgan's law for disjunctions states that the negation of a disjunction of two statements is equivalent to the conjunction of the negations of the individual statements. It can be stated symbolically as follows:\n\n$$\n\\neg ( A \\lor B) = \\neg A \\land \\neg B.\n$$\n\nSo, the negation of our statement is\n\n$$\n\\begin{aligned}¬(3\\text{ is not prime}\\text{ or }\\pi \\text{ is not rational}) & ≡¬((3\\text{ is not prime})∨(\\pi \\text{ is not rational})) \\\\  & ≡¬(3\\text{ is not prime})∧¬(\\pi \\text{ is not rational}) \\\\  & ≡(3\\text{ is prime})∧(\\pi \\text{ is rational}) \\\\  & ≡3\\text{ is prime}\\text{ and }\\pi \\text{ is rational}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059405 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186059698 :knowledge-point/id #uuid "d9c85b7b-1326-5f25-aa21-ab115680582d" :knowledge-point/title "Simplifying a Statement Using De Morgan's Laws"}] :question/id #uuid "a3430492-73ee-5c65-92cf-7059bb63b5a4" :question/math-academy-id "e-12696" :question/problem "Simplify the statement $\\neg ( (P \\lor \\neg Q) \\land (Q \\lor \\neg P) )$ using De Morgan's laws." :question/worked-solution "De Morgan's laws state that\n\n$$\n\\begin{aligned}¬(P∧Q)≡¬P∨¬Q, \\\\ ¬(P∨Q)≡¬P∧¬Q.\\end{aligned}\n$$\n\nSo, we can simplify the given statement as follows:\n\n$$\n\\begin{aligned}¬((P∨¬Q)∧(Q∨¬P)) & ≡¬(P∨¬Q)∨¬(Q∨¬P) \\\\  & ≡(¬P∧¬(¬Q))∨(¬Q∧¬(¬P)) \\\\  & ≡(¬P∧Q)∨(¬Q∧P)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571428 :knowledge-point/_questions [{:db/id #edb/ref 17592186059698 :knowledge-point/id #uuid "d9c85b7b-1326-5f25-aa21-ab115680582d" :knowledge-point/title "Simplifying a Statement Using De Morgan's Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02330894-f5f7-5da1-b7b2-e4aecffb6072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨(B∨¬A)" :db/id #edb/ref 17592186570897} {:answer/id #uuid "9422bec2-4a9a-5902-967d-1bee95d76f81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧(B∧¬A)" :db/id #edb/ref 17592186571123} {:answer/id #uuid "a3bad151-32df-5b30-89f4-1df23fa95050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨(B∧¬A)" :db/id #edb/ref 17592186571148} {:answer/id #uuid "b278173e-938b-5dc8-9856-44dc092025a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧(B∨A)" :db/id #edb/ref 17592186571166} {:answer/id #uuid "cdee5e32-593f-5078-9ffd-bdd90283badb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧(B∨¬A)" :db/id #edb/ref 17592186571208}] :answer-field/correct {:answer/id #uuid "a3bad151-32df-5b30-89f4-1df23fa95050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨(B∧¬A)" :db/id #edb/ref 17592186571148} :answer-field/id #uuid "97779c75-c871-5f40-b22d-2c3c6f521f04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571339}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97dcc406-82e2-57c8-880f-2a83c1dc8205" :question/math-academy-id "q-129826" :question/problem "Rewrite the statement $¬(¬A∧(¬B∨A))$ using De Morgan's laws." :question/worked-solution "De Morgan's laws state that\n\n$$\n\\begin{aligned}¬(A∨B)≡¬A∧¬B, \\\\ ¬(A∧B)≡¬A∨¬B.\\end{aligned}\n$$\n\nSo, we can simplify the given statement as follows:\n\n$$\n\\begin{aligned}¬(¬A∧(¬B∨A)) & ≡¬(¬A)∨¬(¬B∨A) \\\\  & ≡A∨(¬(¬B)∧¬A) \\\\  & ≡A∨(B∧¬A)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571384 :knowledge-point/_questions [{:db/id #edb/ref 17592186059698 :knowledge-point/id #uuid "d9c85b7b-1326-5f25-aa21-ab115680582d" :knowledge-point/title "Simplifying a Statement Using De Morgan's Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a65505b-4173-5672-96fb-eeb8f53e4fb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∧Q" :db/id #edb/ref 17592186571034} {:answer/id #uuid "6bc7205a-a182-5d64-b3b5-3a2807b547a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬Q∨¬P" :db/id #edb/ref 17592186571059} {:answer/id #uuid "6bf40fe0-2946-5e5a-9e2a-be6004e4ca8b" :answer/type {:db/id #edb/ref 175