 17592186401611} {:answer/id #uuid "4e68f1f1-4450-5751-bd58-9f125f0beedf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3\\,\\text{⧸}|\\,18$ or $11$ is prime" :db/id #edb/ref 17592186401612}] :answer-field/correct {:answer/id #uuid "95645e07-ad94-5f53-94f7-cca49c5ad899" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3\\,\\text{⧸}|\\,18$ and $11$ is prime" :db/id #edb/ref 17592186401609} :answer-field/id #uuid "1c5c17af-159f-5984-9b54-f720cf946df4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401607}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "711d64e0-f4d6-5c58-a54c-d6327695bb3b" :question/math-academy-id "q-171016" :question/problem "$\\,$ $3\\,|\\,18$ or $11$ is not prime.\n\nWhat is the negation of the compound statement above?" :question/worked-solution "De Morgan's law for disjunctions states that the negation of a disjunction of two statements is equivalent to the conjunction of the negations of the individual statements. It can be stated symbolically as follows:\n\n$$\n¬(A∨B)=¬A∧¬B.\n$$\n\nSo, the negation of our statement is\n\n$$\n\\begin{aligned}¬(3\\,|\\,18\\text{ or }11\\text{ is not prime}) & ≡¬((3\\,|\\,18)∨(11\\text{ is not prime})) \\\\  & ≡¬(3\\,|\\,18)∧¬(11\\text{ is not prime}) \\\\  & ≡(3\\,\\text{⧸}|\\,18)∧(11\\text{ is prime}) \\\\  & ≡3\\,\\text{⧸}|\\,18\\text{ and }11\\text{ is prime}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186571451 :knowledge-point/_questions [{:db/id #edb/ref 17592186059696 :knowledge-point/id #uuid "d9de08e2-7bf6-5ab5-bb90-7f2896dda1dc" :knowledge-point/title "Negating a Sentence Containing a Conjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2553d01b-7172-559c-afbd-8e32700691dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x$ is not prime and $x$ is odd" :db/id #edb/ref 17592186570947} {:answer/id #uuid "7c5f3662-43e5-5841-a5cf-42b69470daef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x$ is not prime and $x$ is even" :db/id #edb/ref 17592186571087} {:answer/id #uuid "c7470ec4-1efa-5556-b1b6-87b10810db7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x$ is not prime or $x$ is odd" :db/id #edb/ref 17592186571199} {:answer/id #uuid "d38d9b90-26a9-5522-8888-b37bd17e24ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x$ is prime or $x$ is odd" :db/id #edb/ref 17592186571217} {:answer/id #uuid "ffa1df0d-e6d7-5117-92d7-78580b573150" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x$ is not prime or $x$ is even" :db/id #edb/ref 17592186571279}] :answer-field/correct {:answer/id #uuid "ffa1df0d-e6d7-5117-92d7-78580b573150" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x$ is not prime or $x$ is even" :db/id #edb/ref 17592186571279} :answer-field/id #uuid "5b8601b2-92aa-5f8b-87af-4b7a55ebbae4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571324}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f6cb1c6c-0f55-5843-930a-ea6ae4ca9cd3" :question/math-academy-id "q-182441" :question/problem "$\\,$ $x$ is prime and $x$ is odd.\n\nWhat is the negation of the compound statement above?" :question/worked-solution "De Morgan's law posits that the negation of a conjunction of two statements is equivalent to the disjunction of the negated individual statements. It can be stated symbolically as follows.\n\n$$\n¬(A∧B)=¬A∨¬B\n$$\n\nSo, the negation of our statement is\n\n$$\n\\begin{aligned}¬(x\\text{ is prime}\\text{ and }x\\text{ is odd}) & ≡¬((x\\text{ is prime})∧(x\\text{ is odd})) \\\\  & ≡¬(x\\text{ is prime})∨¬(x\\text{ is odd}) \\\\  & ≡(x\\text{ is not prime})∨(x\\text{ is even}) \\\\  & ≡x\\text{ is not prime}\\text{ or }x\\text{ is even}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401695 :knowledge-point/_questions [{:db/id #edb/ref 17592186059696 :knowledge-point/id #uuid "d9de08e2-7bf6-5ab5-bb90-7f2896dda1dc" :knowledge-point/title "Negating a Sentence Containing a Conjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "938c3ee2-cabf-5d4b-a82f-51aa90a79cbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|{1,x}|=0$ and $x$ is rational" :db/id #edb/ref 17592186401697} {:answer/id #uuid "21140988-0342-5bc8-9482-5fe6d5552b36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|{1,x}|\\ne 0$ and $x$ is not rational" :db/id #edb/ref 17592186401698} {:answer/id #uuid "e7a791d9-ddce-54ec-9234-65d0e6facd4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|{1,x}|=0$ and $x$ is not rational" :db/id #edb/ref 17592186401699} {:answer/id #uuid "03742fb6-2d4b-59f2-bd41-766fe48f2e3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|{1,x}|=0$ or $x$ is not rational" :db/id #edb/ref 17592186401700} {:answer/id #uuid "5eaf2475-ccba-521f-83c3-2e8cf83dcaf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|{1,x}|\\ne 0$ or $x$ is not rational" :db/id #edb/ref 17592186401701}] :answer-field/correct {:answer/id #uuid "03742fb6-2d4b-59f2-bd41-766fe48f2e3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$|{1,x}|=0$ or $x$ is not rational" :db/id #edb/ref 17592186401700} :answer-field/id #uuid "f122c311-1c07-5ab1-ab5b-dbf45c9499a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 