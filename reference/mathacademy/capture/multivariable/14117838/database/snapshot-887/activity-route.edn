#{[{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186413797} :activity/id #uuid "fba5b1da-9880-515c-af94-05681b35cd3b" :activity/scope {:db/id #edb/ref 17592186050841 :topic/id #uuid "6aced1c3-bd0e-5b1d-973e-105b955f9e1a" :topic/math-academy-id 2126} :activity/steps [{:db/id #edb/ref 17592186413793 :step/content {:db/id #edb/ref 17592186134064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a97740-bf4e-5245-a223-1105ad76868c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t" :db/id #edb/ref 17592186238086} {:answer/id #uuid "0ccb496a-1f3e-5f9c-9be5-7756bb97a385" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t+2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186238169} {:answer/id #uuid "9dbfd16e-b04d-5762-91cf-d69f6af7923d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t+\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239432} {:answer/id #uuid "a5578604-9539-5565-8bbb-579ff2d23c8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239490} {:answer/id #uuid "ff74f82e-113d-5ba7-9d63-962e019ecfd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186240320}] :answer-field/correct {:db/id #edb/ref 17592186238086} :answer-field/id #uuid "50e2f23b-8197-5ffd-805f-f3ecff761a73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240475}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e7a8c44b-b300-5e66-9428-e03f400ebf5f" :question/math-academy-id "q-105416" :question/problem "Let $V=C[-\\pi ,\\pi ],$ the vector space of continuous functions over $[-\\pi ,\\pi ]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=\\operatorname{sin}⁡t,\\,{f}_{2}(t)=\\operatorname{cos}⁡t,\\,g(t)={sin}^{2}⁡t-\\operatorname{cos}⁡t\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}{{f}_{1}(t),{f}_{2}(t)}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{2}(t)}$ equals $-\\operatorname{cos}⁡t.$" :question/worked-solution "Since the set ${{f}_{1}(t),{f}_{2}(t)}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{2}(t)}\\,g(t)=-\\operatorname{cos}⁡t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{1}(t)}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{1}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{1}(t)⟩}{⟨{f}_{1}(t),{f}_{1}(t)⟩}\\,{f}_{1}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{1}(t)⟩ & ={\\int }_{-\\pi }^{\\pi }g(t){f}_{1}(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡t$ is an odd function, while ${sin}^{2}⁡t-\\operatorname{cos}⁡t$ is even. Hence, their product $\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)$ must be an odd function. Now, since we have an integral over the interval $[-\\pi ,\\pi ],$ which is symmetric about the origin, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\,\\text{d}t=0.\n$$\n\n  \n\nTherefore,\n\n$$\n{\\text{proj}}_{{f}_{1}(t)}\\,g(t)=\\frac{0}{⟨{f}_{1}(t),{f}_{1}(t)⟩}\\cdot \\operatorname{sin}⁡t=0.\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =0-\\operatorname{cos}⁡t \\\\  & =-\\operatorname{cos}⁡t.\\end{aligned}\n$$"} :step/id #uuid "0a412cdd-29f8-5273-ab55-2a8dce391dae" :step/next {:db/id #edb/ref 17592186413795}} {:db/id #edb/ref 17592186413794 :step/content {:db/id #edb/ref 17592186241003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9db971-884b-5cf9-9a84-c91c9fa4fa01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8+\\operatorname{sin}⁡t" :db/id #edb/ref 17592186238276} {:answer/id #uuid "39658250-b0fe-59bb-a334-a4e517b0d75e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186238550} {:answer/id #uuid "880b7d31-ec04-56db-ad2a-f754621f1b8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239237} {:answer/id #uuid "b1b15087-e383-5255-8efc-84ad43c168b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6-2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239607} {:answer/id #uuid "cd180c30-2f84-5a24-af62-8965f36db06d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4+2\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239851}] :answer-field/correct {:db/id #edb/ref 17592186239607} :answer-field/id #uuid "51c982ce-3e72-5b74-bcb0-6eb543685681" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240480}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2bf55fb2-ca86-5707-a52a-d891899878f4" :question/math-academy-id "q-105186" :question/problem "Let $V=C[-\\pi ,\\pi ],$ the vector space of continuous functions over $[-\\pi ,\\pi ]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=2,\\,{f}_{2}(t)=\\operatorname{sin}⁡t,\\,g(t)=\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t+6\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}{{f}_{1}(t),{f}_{2}(t)}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{1}(t)}$ equals $6.$" :question/worked-solution "Since the set ${{f}_{1}(t),{f}_{2}(t)}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{1}(t)}\\,g(t)=6,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{2}(t)}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{2}(t)⟩}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\,{f}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & ={\\int }_{-\\pi }^{\\pi }g(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }(\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t+6)\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t-2{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t+6{\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡t$ is an odd function, while $\\operatorname{cos}⁡t$ is even. Hence, their product $\\operatorname{cos}⁡t\\operatorname{sin}⁡t$ must be an odd function. Now, since we have integrals over the interval $[-\\pi ,\\pi ],$ which is symmetric about the origin, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t=0.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & =-2{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{proj}}_{{f}_{2}(t)}\\,g(t) & =\\frac{-2{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\cdot \\operatorname{sin}⁡t \\\\  & =\\frac{-2{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}\\cdot \\operatorname{sin}⁡t \\\\  & =-2\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =6-2\\operatorname{sin}⁡t.\\end{aligned}\n$$"} :step/id #uuid "0bc7e18b-fdb5-5429-828f-e671a9abcbda" :step/next {:db/id #edb/ref 17592186413793}} {:db/id #edb/ref 17592186413795 :step/content {:db/id #edb/ref 17592186241059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "694bbe7e-1033-5685-8db7-c579e340a4af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186238969} {:answer/id #uuid "7187a2ab-aec2-5516-9817-82c6b1e6f0ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186239028} {:answer/id #uuid "98f9f087-a4cb-5b2b-ba88-6c34977c1ab6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186239383} {:answer/id #uuid "d0b7eedf-e87f-53c1-a7c0-62ebe727a2fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186239882} {:answer/id #uuid "f69f76e8-1b93-5cd1-b517-2cdfc888efb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186240229}] :answer-field/correct {:db/id #edb/ref 17592186239028} :answer-field/id #uuid "eabf99e8-310f-5528-b7c0-2d81c99774f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240742}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a70f1b99-0d4b-5ef2-9e7e-0dc7f6d78417" :question/math-academy-id "q-105461" :question/problem "Let $V=C[0,1],$ the vector space of functions that are continuous over $[0,1].$ Given that the inner product on $V$ is defined as \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{1}x(t)y(t)\\,\\text{d}t,\n$$\n\nfind the distance between $f(t)=3t$ and $g(t)=-3t+3$ with respect to the inner product." :question/worked-solution "The distance between $f(t)=3t$ and $g(t)=-3t+3$ with respect to the given inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-g(t)‖ \\\\  & =‖3t-(-3t+3)‖ \\\\  & =‖6t-3‖ \\\\  & =\\sqrt{⟨6t-3,6t-3⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨6t-3,6t-3⟩ & ={\\int }_{0}^{1}(6t-3)^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(36{t}^{2}-36t+9)\\text{d}t \\\\  & =[12{t}^{3}-18{t}^{2}+9t]_{0}^{1} \\\\  & =(12-18+9)-0 \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{3}.$"} :step/id #uuid "5b37fdbb-b243-534e-930c-c4161c64569a" :step/next {:db/id #edb/ref 17592186413796}} {:db/id #edb/ref 17592186413796 :step/content {:db/id #edb/ref 17592186241063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10e4eb1a-f07b-5500-9b6b-bb104419f1ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186238193} {:answer/id #uuid "1597005a-083a-5b2f-904c-d3601ce7fd24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186238235} {:answer/id #uuid "189191f2-31ca-5b6a-bb47-311abb8904ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186238264} {:answer/id #uuid "46644984-af18-5419-96cd-d6307758e813" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186238666} {:answer/id #uuid "94691432-7499-5d85-bd53-7c03102b3e45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186239340}] :answer-field/correct {:db/id #edb/ref 17592186238264} :answer-field/id #uuid "e7bf2326-7e5c-5bac-b442-4f7e564308dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240734}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5d460b9a-6ed3-5d23-955f-f3e1840b55a2" :question/math-academy-id "q-105475" :question/problem "Let $V=C[0,1],$ the vector space of functions that are continuous over $[0,1].$ Given that the inner product on $V$ is defined as \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{1}x(t)y(t)\\,\\text{d}t,\n$$\n\nfind the distance between $f(t)=8t$ and the subspace spanned by $g(t)=4t-2$ with respect to the inner product." :question/worked-solution "The orthogonal projection of $f(t)$ onto $\\text{Span}{g(t)}$ is given by\n\n$$\n\\begin{aligned}{\\text{proj}}_{g(t)}\\,f(t) & =\\frac{⟨f(t),g(t)⟩}{⟨g(t),g(t)⟩}\\,g(t) \\\\  & =\\frac{{\\int }_{0}^{1}8t\\cdot (4t-2)\\,\\text{d}t}{{\\int }_{0}^{1}(4t-2)^{2}\\,\\text{d}t}\\cdot (4t-2) \\\\  & =\\frac{{\\int }_{0}^{1}(32{t}^{2}-16t)\\,\\text{d}t}{{\\int }_{0}^{1}(16{t}^{2}-16t+4)\\,\\text{d}t}\\cdot (4t-2) \\\\  & =\\frac{[\\frac{32}{3}{t}^{3}-8{t}^{2}]_{0}^{1}}{[\\frac{16}{3}{t}^{3}-8{t}^{2}+4t]_{0}^{1}}\\cdot (4t-2) \\\\  & =\\frac{(\\frac{32}{3}-8)-0}{(\\frac{16}{3}-4)-0}\\cdot (6t-3) \\\\  & =\\frac{(\\frac{8}{3})}{(\\frac{4}{3})}\\cdot (4t+2) \\\\  & =2\\cdot (4t-2) \\\\  & =8t-4.\\end{aligned}\n$$\n\nThe distance between $f(t)=8t$ and the subspace spanned by $g(t)=4t-2$ with respect to our inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-{\\text{proj}}_{g(t)}\\,f(t)‖ \\\\  & =‖8t-(8t-4)‖ \\\\  & =‖4‖ \\\\  & =\\sqrt{⟨4,4⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨4,4⟩ & ={\\int }_{0}^{1}4\\cdot 4\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}16\\,\\text{d}t \\\\  & =16t\\,{|}_{0}^{1} \\\\  & =16-0 \\\\  & =16.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{16}=4.$"} :step/id #uuid "5b4d4a19-f8e8-5a9a-8c13-582c4e2b0863"} {:db/id #edb/ref 17592186413797 :step/content {:db/id #edb/ref 17592186240983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b29cd5-55b5-5722-ba90-23f769345723" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t+1" :db/id #edb/ref 17592186238150} {:answer/id #uuid "5bc19ba5-b098-5af2-b759-18b7d61fa0df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cos}⁡t+4\\operatorname{sin}⁡t+1" :db/id #edb/ref 17592186238854} {:answer/id #uuid "64e8e822-ab38-5fcf-a7cb-162397992404" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t" :db/id #edb/ref 17592186238937} {:answer/id #uuid "9cd846ec-dcb9-5576-8a82-5cbd0e68c90d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡t-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186239418} {:answer/id #uuid "a19047b8-6624-5f0c-b217-a2d6a5d4fcd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{cos}⁡t+5\\operatorname{sin}⁡t+1" :db/id #edb/ref 17592186239462}] :answer-field/correct {:db/id #edb/ref 17592186238937} :answer-field/id #uuid "f5a8c5d5-fcb2-5bdd-8555-14fa5c61c1d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240761}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "645a82fe-e42f-5dc9-9e79-d8bd0747a894" :question/math-academy-id "q-105136" :question/problem "Let $V=C[-\\pi ,\\pi ],$ the vector space of continuous functions over $[-\\pi ,\\pi ]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=\\operatorname{cos}⁡t,\\,{f}_{2}(t)=\\operatorname{sin}⁡t,\\,g(t)=5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t+1\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}{{f}_{1}(t),{f}_{2}(t)}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{1}(t)}$ equals $5\\operatorname{cos}⁡t.$" :question/worked-solution "Since the set ${{f}_{1}(t),{f}_{2}(t)}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{1}(t)}\\,g(t)=5\\operatorname{cos}⁡t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{2}(t)}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{2}(t)⟩}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\,{f}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & ={\\int }_{-\\pi }^{\\pi }g(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }(5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t+1)\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =5{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t+{\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡t$ is an odd function, while $\\operatorname{cos}⁡t$ is even. Hence, their product $\\operatorname{cos}⁡t\\operatorname{sin}⁡t$ must be an odd function. Now, since we have an integral over the interval $[-\\pi ,\\pi ],$ which is symmetric about the origin, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t=0.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & =-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{proj}}_{{f}_{2}(t)}\\,g(t) & =\\frac{-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\cdot \\operatorname{sin}⁡t \\\\  & =\\frac{-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}\\cdot \\operatorname{sin}⁡t \\\\  & =-4\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t.\\end{aligned}\n$$"} :step/id #uuid "681a7c6c-5a02-51e9-b790-4836129a3fb4" :step/next {:db/id #edb/ref 17592186413794}}] :activity/title "Projecting Vectors Onto Subspaces in Inner Product Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186413792}]}
