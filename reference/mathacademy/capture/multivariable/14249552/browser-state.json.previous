</mi></mrow><mrow><mtext>d</mtext><mi>t</mi></mrow></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></msubsup><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">(</mo></mrow><mn>3</mn><mo stretchy=\"false\">(</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo>+</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow><mo>⋅</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">(</mo></mrow><mn>3</mn><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">(</mo></mrow><mn>3</mn><mo stretchy=\"false\">(</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo>−</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow><mo>⋅</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">(</mo></mrow><mo>−</mo><mn>3</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>9</mn><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></msubsup><mo stretchy=\"false\">(</mo><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo>+</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo>+</mo><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>9</mn><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></msubsup><mn>1</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>t</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>9</mn><mi>t</mi><msubsup><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"2.470em\" maxsize=\"2.470em\">|</mo></mrow><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>9</mn><mo stretchy=\"false\">(</mo><mn>2</mn><mi>π</mi><mo>−</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>18</mn><mi>π</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
