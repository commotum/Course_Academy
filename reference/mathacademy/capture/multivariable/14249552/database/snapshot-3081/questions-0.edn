#{[{:db/id #edb/ref 17592186180040 :knowledge-point/_questions [{:db/id #edb/ref 17592186179744 :knowledge-point/id #uuid "4c9de11e-2195-5946-a19e-235667d39631" :knowledge-point/title "Calculating the Flux of a Vector Field Over a Closed Curve in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cfab73e-541e-5dea-a884-264b4bd8ec97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186177913} {:answer/id #uuid "1d03d1d4-83e8-5434-ba88-654e772f6034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\pi " :db/id #edb/ref 17592186539535} {:answer/id #uuid "2bedcbb9-3a20-535c-92e0-bda037bb0531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9\\pi " :db/id #edb/ref 17592186539560} {:answer/id #uuid "94ef6336-a885-5e0f-9339-fb9e597d51dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18\\pi " :db/id #edb/ref 17592186539726} {:answer/id #uuid "c61c8d76-f473-524c-b92c-3be06cc40c20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\pi " :db/id #edb/ref 17592186539821}] :answer-field/correct {:answer/id #uuid "1d03d1d4-83e8-5434-ba88-654e772f6034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\pi " :db/id #edb/ref 17592186539535} :answer-field/id #uuid "dab28699-4fc7-5cb2-8f84-87f7666ba43c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177909}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4edd3b9a-070a-593a-8f84-1b14657d2c07" :question/math-academy-id "q-127055" :question/problem "Calculate the flux of the vector field $F(x,y)=(x+y)\\,i+(y-x)\\,j$ across the closed curve $C$ given by $r(t)=3\\operatorname{cos}⁡t\\,i+3\\operatorname{sin}⁡t\\,j$ for $t\\in [0,2\\pi ).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=3\\operatorname{cos}⁡t,\\,y=3\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =x+y=3(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t), \\\\ Q(x,y) & =y-x=3(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t).\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)=-3\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)=3\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(3(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t))\\cdot (3\\operatorname{cos}⁡t)-(3(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t))\\cdot (-3\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & =9{\\int }_{0}^{2\\pi }({cos}^{2}⁡t+\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{sin}^{2}⁡t-\\operatorname{sin}⁡t\\operatorname{cos}⁡t)\\,\\text{d}t \\\\  & =9{\\int }_{0}^{2\\pi }1\\,\\text{d}t \\\\  & =9t{|}_{0}^{2\\pi } \\\\  & =9(2\\pi -0) \\\\  & =18\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262702 :knowledge-point/_questions [{:db/id #edb/ref 17592186179744 :knowledge-point/id #uuid "4c9de11e-2195-5946-a19e-235667d39631" :knowledge-point/title "Calculating the Flux of a Vector Field Over a Closed Curve in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1451c613-e020-5234-9207-ca8e2b426177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186260055} {:answer/id #uuid "545e7de3-77c0-5001-a9e8-6b1adc5f1466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{16\\pi }{3}" :db/id #edb/ref 17592186260589} {:answer/id #uuid "78acc197-697f-5085-b977-43333a81c4c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32\\pi }{3}" :db/id #edb/ref 17592186260932} {:answer/id #uuid "7b79330c-376e-54f4-b1b3-7e784422cfed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16\\pi }{3}" :db/id #edb/ref 17592186260951} {:answer/id #uuid "a87d06f4-05e6-5e25-a200-9da07f1daa38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{32\\pi }{3}" :db/id #edb/ref 17592186261345}] :answer-field/correct {:answer/id #uuid "1451c613-e020-5234-9207-ca8e2b426177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186260055} :answer-field/id #uuid "473e948e-e7b1-5fb0-bd43-b3e933074eaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262248}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6160f48-7946-52fa-bf89-f2b84f79ba1d" :question/math-academy-id "q-127060" :question/problem "Calculate the flux of the vector field $F(x,y)=xy\\,i+{x}^{2}\\,j$ across the closed curve $C$ given by $r(t)=2\\operatorname{cos}⁡t\\,i+2\\operatorname{sin}⁡t\\,j$ for $t\\in [0,2\\pi ).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=2\\operatorname{cos}⁡t,\\,y=2\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =xy=4\\operatorname{sin}⁡t\\operatorname{cos}⁡t, \\\\ Q(x,y) & ={x}^{2}=4{cos}^{2}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)=-2\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)=2\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u=\\operatorname{cos}⁡t,\\text{d}u=-\\operatorname{sin}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(4\\operatorname{sin}⁡t\\operatorname{cos}⁡t)\\cdot (2\\operatorname{cos}⁡t)-(4{cos}^{2}⁡t)\\cdot (-2\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }8\\operatorname{sin}⁡t{cos}^{2}⁡t+8\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }16\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{1}^{1}-16{u}^{2}\\,\\text{d}u \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186421762 :knowledge-point/_questions [{:db/id #edb/ref 17592186179744 :knowledge-point/id #uuid "4c9de11e-2195-5946-a19e-235667d39631" :knowledge-point/title "Calculating the Flux of a Vector Field Over a Closed Curve in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "093b5f1d-7084-5cca-af48-56a7c276ea5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186421730} {:answer/id #uuid "1755e313-29bb-5235-930c-5480eea8e580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{25e}{12}" :db/id #edb/ref 17592186421732} {:answer/id #uuid "2a42ddb5-8533-50f3-9230-498c83bae1a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7e}{12}" :db/id #edb/ref 17592186421735} {:answer/id #uuid "93070110-72d1-593c-aaa7-f43291b04560" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7e}{12}" :db/id #edb/ref 17592186421745} {:answer/id #uuid "c7b8c70b-0bf4-5466-85d5-56e8bfa6fc37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25e}{12}" :db/id #edb/ref 17592186421749}] :answer-field/correct {:answer/id #uuid "093b5f1d-7084-5cca-af48-56a7c276ea5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186421730} :answer-field/id #uuid "452bd17e-660a-568a-8108-39d6d0770162" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421756}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "90df2f56-7b61-5a49-aa6d-4d0c58b35b14" :question/math-academy-id "q-127062" :question/problem "Calculate the flux of the vector field $F(x,y)={e}^{y}\\,i+{e}^{x}\\,j$ across the closed curve $C$ given by $r(t)=3\\operatorname{cos}⁡t\\,i+4\\operatorname{sin}⁡t\\,j$ for $t\\in [0,2\\pi ).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=3\\operatorname{cos}⁡t,\\,y=4\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & ={e}^{y}={e}^{4\\operatorname{sin}⁡t}, \\\\ Q(x,y) & ={e}^{x}={e}^{3\\operatorname{cos}⁡t}.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)=-3\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)=4\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitutions $u=4\\operatorname{sin}⁡t,du=4\\operatorname{cos}⁡t\\,dt$ and $v=3\\operatorname{cos}⁡t,dv=-3\\operatorname{sin}⁡t\\,dt,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }({e}^{4\\operatorname{sin}⁡t})\\cdot (4\\operatorname{cos}⁡t)-({e}^{3\\operatorname{cos}⁡t})\\cdot (-3\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }({e}^{4\\operatorname{sin}⁡t})\\cdot (4\\operatorname{cos}⁡t)\\,\\text{d}t-{\\int }_{0}^{2\\pi }({e}^{3\\operatorname{cos}⁡t})\\cdot (-3\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{0}{e}^{u}\\,du-{\\int }_{1}^{1}{e}^{v}\\,\\text{d}v \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262711 :knowledge-point/_questions [{:db/id #edb/ref 17592186179744 :knowledge-point/id #uuid "4c9de11e-2195-5946-a19e-235667d39631" :knowledge-point/title "Calculating the Flux of a Vector Field Over a Closed Curve in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2ab957-0579-5e99-8c2c-f53cec1a64ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186260254} {:answer/id #uuid "515d246a-bf62-5921-88e9-813966854ecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186260564} {:answer/id #uuid "681d213e-13d8-58eb-9b2e-feeb4d760e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186260785} {:answer/id #uuid "787af263-8fcd-544e-a39d-804db798c96f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186260930} {:answer/id #uuid "95210164-0d4e-5860-ac8f-9ab7e9038d97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{2}" :db/id #edb/ref 17592186261171}] :answer-field/correct {:answer/id #uuid "515d246a-bf62-5921-88e9-813966854ecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186260564} :answer-field/id #uuid "b00b1074-3f5c-50fa-8cd5-1bc5332b0ac4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262440}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "610929b6-feab-56c5-9108-52a1535e1a43" :question/math-academy-id "q-127081" :question/problem "Calculate the flux of the vector field $F(x,y)=y\\,i+9{x}^{3}\\,j$ across the closed curve $C$ given by $r(t)=\\operatorname{cos}⁡t\\,i+3\\operatorname{sin}⁡t\\,j$ for $t\\in [0,2\\pi ).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡t,\\,y=3\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =y=3\\operatorname{sin}⁡t, \\\\ Q(x,y) & =9{x}^{3}=9{cos}^{3}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)=-\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)=3\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $\\operatorname{cos}⁡t=u,du=-\\operatorname{sin}⁡t\\,dt,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(3\\operatorname{sin}⁡t)\\cdot (3\\operatorname{cos}⁡t)-(9{cos}^{3}⁡t)\\cdot (-\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & =9{\\int }_{0}^{2\\pi }(\\operatorname{sin}⁡t\\operatorname{cos}⁡t+\\operatorname{sin}⁡t{cos}^{3}⁡t)\\,\\text{d}t \\\\  & =-9{\\int }_{1}^{1}(u+{u}^{3})\\,\\text{d}u \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262714 :knowledge-point/_questions [{:db/id #edb/ref 17592186179744 :knowledge-point/id #uuid "4c9de11e-2195-5946-a19e-235667d39631" :knowledge-point/title "Calculating the Flux of a Vector Field Over a Closed Curve in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8337cc5b-cbe0-5afa-9274-103e3f498697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\pi " :db/id #edb/ref 17592186261015} {:answer/id #uuid "8d8c2924-c012-51ca-aa9f-ebee29edb99a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186261114} {:answer/id #uuid "9958d4dc-9c0d-556d-9236-c69dc7ace6dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "192\\pi " :db/id #edb/ref 17592186261204} {:answer/id #uuid "9c54fcc6-cb8b-5805-9834-9c56673a0e9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32\\pi " :db/id #edb/ref 17592186261228} {:answer/id #uuid "b08ecf9c-f351-5fc2-9328-9e808bafe62f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "384\\pi " :db/id #edb/ref 17592186261434}] :answer-field/correct {:answer/id #uuid "b08ecf9c-f351-5fc2-9328-9e808bafe62f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "384\\pi " :db/id #edb/ref 17592186261434} :answer-field/id #uuid "c2ba8e33-8924-5bcc-b848-378e5d728fa7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262473}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc62686d-15ed-5e7b-a83e-66fbf5f6c46f" :question/math-academy-id "q-127140" :question/problem "Calculate the flux of the vector field $F(x,y)=4x\\,i+4y\\,j$ across the closed curve $C$ given by $r(t)=8\\operatorname{cos}⁡t\\,i+6\\operatorname{sin}⁡t\\,j$ for $t\\in [0,2\\pi ).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=8\\operatorname{cos}⁡t,\\,y=6\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =4x=4(8\\operatorname{cos}⁡t)=32\\operatorname{cos}⁡t, \\\\ Q(x,y) & =4y=4(6\\operatorname{sin}⁡t)=24\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(8\\operatorname{cos}⁡t)=-8\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{sin}⁡t)=6\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(32\\operatorname{cos}⁡t)\\cdot (6\\operatorname{cos}⁡t)-(24\\operatorname{sin}⁡t)\\cdot (-8\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }192({cos}^{2}⁡t+{sin}^{2}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }192\\,\\text{d}t \\\\  & =192t{|}_{0}^{2\\pi } \\\\  & =192(2\\pi -0) \\\\  & =384\\pi \\end{aligned}\n$$"}]}
