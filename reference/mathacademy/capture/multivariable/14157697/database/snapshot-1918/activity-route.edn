#{[{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186483447} :activity/id #uuid "5612666d-368d-549d-8c98-b899d091fd25" :activity/scope {:db/id #edb/ref 17592186048694 :topic/id #uuid "b52b86c6-5073-5d60-a17c-32a308489156" :topic/math-academy-id 2638} :activity/steps [{:db/id #edb/ref 17592186483435 :step/content {:db/id #edb/ref 17592186345246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bba08e7-72f6-5628-a032-40fab3b1523b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{2}}{4}" :db/id #edb/ref 17592186342340} {:answer/id #uuid "966bb9f4-b258-530d-bda2-5cc45dd1bfc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186343555} {:answer/id #uuid "da527ec0-d3e9-50cf-934b-d37d6ce14b54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186344156} {:answer/id #uuid "dc075c9d-4ff5-5e6a-83cc-7b9150d7aa65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186344168} {:answer/id #uuid "eb3267aa-cefb-5be3-9449-fd0ab72c839c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186344296}] :answer-field/correct {:db/id #edb/ref 17592186344168} :answer-field/id #uuid "56b83e59-aa7d-5940-925e-575b2e63efa7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344638}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fee02b99-a9f3-5976-9c5b-34d5a43071ea" :question/math-academy-id "q-76690" :question/problem "Evaluate the integral of the function $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}}$ along the polar curve $r=\\operatorname{sin}⁡\\theta \\,$ for $\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y={sin}^{2}⁡\\theta $, where $\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{2}.$ \n\nNow, since $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\sqrt{(\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )^{2}+({sin}^{2}⁡\\theta )^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +{sin}^{4}⁡\\theta } \\\\  & =\\sqrt{{sin}^{2}⁡\\theta ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\sqrt{{sin}^{2}⁡\\theta } \\\\  & =|\\operatorname{sin}⁡\\theta | \\\\  & =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNotice that $|\\operatorname{sin}⁡\\theta |=\\operatorname{sin}⁡\\theta $ because $\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{2}\\,⟹\\,\\operatorname{sin}⁡\\theta >0.$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{sin}⁡\\theta )=\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\operatorname{sin}⁡\\theta )^{2}+(\\operatorname{cos}⁡\\theta )^{2}} \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\n \n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}s & ={\\int }_{\\pi /4}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\operatorname{sin}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & =-\\operatorname{cos}⁡\\theta {|}_{\\pi /4}^{\\pi /2} \\\\  & =-0-(-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$"} :step/id #uuid "0cb113d7-5c3c-54c0-89a9-97aef97d74cf" :step/next {:db/id #edb/ref 17592186483445}} {:db/id #edb/ref 17592186483445 :step/content {:db/id #edb/ref 17592186284545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab50b4da-933b-580c-90e3-d57fe918ca3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /4}^{-\\pi /8}\\operatorname{sin}⁡\\theta \\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283174} {:answer/id #uuid "e0621d5d-1546-515b-b160-26c36601cee5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /4}^{-\\pi /8}\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283647} {:answer/id #uuid "eac1d727-6b15-5ede-a524-9f9b5cca59df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /4}^{-\\pi /8}{cos}^{2}⁡\\theta \\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283741} {:answer/id #uuid "f038538b-7314-51bc-a23b-a2dc236cb725" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /4}^{-\\pi /8}{sin}^{2}⁡\\theta \\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283787} {:answer/id #uuid "f848449c-f299-591e-af24-cf140841f848" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /4}^{-\\pi /8}\\operatorname{cos}⁡\\theta \\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283860}] :answer-field/correct {:db/id #edb/ref 17592186283647} :answer-field/id #uuid "f1857575-157f-5eb5-ba46-57df0567255a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284364}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e623a86a-8a2d-5ca1-949a-2b47126336d8" :question/math-academy-id "q-165414" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}\\frac{{y}^{4}}{{x}^{2}}\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=\\operatorname{cot}⁡\\theta \\,$ for $-\\frac{\\pi }{4}\\le \\theta \\le -\\frac{\\pi }{8}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cot}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cot}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }$ and $y=\\operatorname{cos}⁡\\theta $, where $-\\frac{\\pi }{4}\\le \\theta \\le -\\frac{\\pi }{8}.$\n\nNow, if $f(x,y)=\\frac{{y}^{4}}{{x}^{2}}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\frac{{cos}^{4}⁡\\theta }{{(\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta })}^{2}} \\\\  & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cot}⁡\\theta )=-\\frac{1}{{sin}^{2}⁡\\theta },\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{cot}⁡\\theta )}^{2}+{(-\\frac{1}{{sin}^{2}⁡\\theta })}^{2}} \\\\  & =\\sqrt{\\frac{{cos}^{2}⁡\\theta }{{sin}^{2}⁡\\theta }+\\frac{1}{{sin}^{4}⁡\\theta }} \\\\  & =\\sqrt{\\frac{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}{{sin}^{4}⁡\\theta }} \\\\  & =\\frac{\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}}{{sin}^{2}⁡\\theta }.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{{y}^{4}}{{x}^{2}}\\,\\text{d}s & ={\\int }_{-\\pi /4}^{-\\pi /8}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{-\\pi /8}{sin}^{2}⁡\\theta \\cdot \\frac{\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}}{{sin}^{2}⁡\\theta }\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{-\\pi /8}\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "21aa696c-4f6f-58d7-9ba8-f3f7ce7733c1"} {:db/id #edb/ref 17592186483447 :step/content {:db/id #edb/ref 17592186152743 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c31779c1-61a9-5ddf-9ce4-388acac151e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393613} {:answer/id #uuid "b35b8c73-b6e1-55f6-a3a8-1f84f618409d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393614} {:answer/id #uuid "d14288db-cd96-5f69-9f29-fa682d61a4a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{-\\pi /4}^{\\pi /4}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393615} {:answer/id #uuid "f83c51d2-6855-5059-8910-c179f8d7f6c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393616} {:answer/id #uuid "865a2778-efa4-5860-8c94-4fab14e1e597" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393617}] :answer-field/correct {:db/id #edb/ref 17592186393614} :answer-field/id #uuid "8116cea9-3c1b-5e81-a58c-b2147c4e208d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393612}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fda4f6af-c917-5961-9062-323f1cdf3aeb" :question/math-academy-id "q-76355" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}{x}^{2}y\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=\\sqrt{2}$ for $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\sqrt{2}\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\sqrt{2}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\sqrt{2}\\operatorname{cos}⁡\\theta $ and $y=\\sqrt{2}\\operatorname{sin}⁡\\theta $, where $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)={x}^{2}y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(\\sqrt{2}\\operatorname{cos}⁡\\theta )^{2}\\cdot \\sqrt{2}\\operatorname{sin}⁡\\theta  \\\\  & =2\\sqrt{2}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt{2})=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\sqrt{2})^{2}+{0}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}y\\,\\text{d}s & ={\\int }_{-\\pi /4}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}2\\sqrt{2}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\cdot \\sqrt{2}\\cdot \\text{d}\\theta  \\\\  & =4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "2670f88c-dfda-5312-b900-fa039a6fdb8a" :step/next {:db/id #edb/ref 17592186483462}} {:db/id #edb/ref 17592186483462 :step/content {:db/id #edb/ref 17592186483379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04d839b3-7560-5512-ab94-65b25afb8af3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32{\\int }_{0}^{\\pi /4}{(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186482817} {:answer/id #uuid "0bd0b7d8-497a-5308-9309-036b9effbae0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{0}^{\\pi /4}(\\operatorname{sin}⁡\\theta +{cos}^{2}⁡\\theta )\\text{d}\\theta " :db/id #edb/ref 17592186482828} {:answer/id #uuid "11be0602-805c-5751-80e1-20619f10d315" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{\\int }_{0}^{\\pi /4}{sin}^{2}⁡\\theta {cos}^{4}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186482841} {:answer/id #uuid "1663c28c-4cc3-57a0-901a-0782cd1f5920" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186482854} {:answer/id #uuid "e62cdbaf-ad20-51f2-b72a-b2f5ab5a24eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{\\int }_{0}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186483200}] :answer-field/correct {:db/id #edb/ref 17592186482854} :answer-field/id #uuid "63f7e3dc-e6fb-53cc-b486-dbf54e61e1b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186483273}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "80893bd5-f8f9-5d69-b7d0-36e40ddfd184" :question/math-academy-id "q-76572" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}x{y}^{2}\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=2$ for $0\\le \\theta \\le \\frac{\\pi }{4}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{cos}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)=x{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2\\operatorname{cos}⁡\\theta \\cdot (2\\operatorname{sin}⁡\\theta )^{2} \\\\  & =8\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(2)^{2}+{0}^{2}} \\\\  & =2.\\end{aligned}\n$$\n\n \n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{y}^{2}\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}8\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\cdot 2\\cdot \\text{d}\\theta  \\\\  & =16{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "5da74330-e29e-5830-9670-415d6daf1e43" :step/next {:db/id #edb/ref 17592186483476}} {:db/id #edb/ref 17592186483476 :step/content {:db/id #edb/ref 17592186345238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5daa3e96-058a-548e-9727-56398515faab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186343024} {:answer/id #uuid "65d6b8b8-c97c-5abc-aecb-7e85e4054fa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186343101} {:answer/id #uuid "7bb80056-6ab1-5d01-af98-8aaa5fd2fb1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186343301} {:answer/id #uuid "8a181e36-5fec-5c45-9657-66ff3657d6a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186343440} {:answer/id #uuid "c39755ce-fc8d-515c-bacb-72a25ce9a67d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186343959}] :answer-field/correct {:db/id #edb/ref 17592186343959} :answer-field/id #uuid "87362288-9f29-50fe-9150-93bef3fb4a45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344731}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5897420e-efe0-5c2e-8d46-6165bb9e5dd3" :question/math-academy-id "q-76616" :question/problem "Evaluate the integral of the function $f(x,y)={x}^{2}-{y}^{2}$ along the polar curve $r=2\\,$ for $0\\le \\theta \\le \\frac{\\pi }{4}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{cos}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$  \n\nNow, since $f(x,y)={x}^{2}-{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(2\\operatorname{cos}⁡\\theta )^{2}-(2\\operatorname{sin}⁡\\theta )^{2} \\\\  & =4{cos}^{2}⁡\\theta -4{sin}^{2}⁡\\theta  \\\\  & =4({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & =4\\operatorname{cos}⁡2\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\n \n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}-{y}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}4\\operatorname{cos}⁡2\\theta \\cdot 2\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}8\\operatorname{cos}⁡2\\theta \\,\\text{d}\\theta  \\\\  & =4\\operatorname{sin}⁡2\\theta \\,{|}_{0}^{\\pi /4} \\\\  & =4(\\operatorname{sin}⁡(\\pi /2)-\\operatorname{sin}⁡0) \\\\  & =4\\end{aligned}\n$$"} :step/id #uuid "76874250-4cf6-5cac-b8f3-c61d135f6019" :step/next {:db/id #edb/ref 17592186483435}}] :activity/title "Line Integrals of Scalar Functions Over Polar Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186482802}]}
