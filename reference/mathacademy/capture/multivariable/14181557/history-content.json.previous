      {
        "math_academy_id": 153506,
        "type": "example",
        "content_id": 12895,
        "title": "Finding Truth Values of Complex Statements",
        "position": 6,
        "dom_id": "step-153506",
        "html": "<div class=\"step\" contentid=\"12895\" id=\"step-153506\" stepid=\"153506\" steptype=\"example\" style=\"display: block\">\n<div class=\"stepHeader\">\n<div class=\"stepName\">\n                    Example: \n                    <a class=\"stepAnchor\" id=\"stepAnchor-153506\" name=\"step-13\" style=\"font-weight: normal;\">Finding Truth Values of Complex Statements</a>\n</div>\n<div class=\"helpButton\" stepid=\"153506\">?</div>\n</div>\n<div class=\"exampleQuestion\">\n<style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direction: ltr;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            border: 0;\n                            padding: 0;\n                            margin: 0\n                            }\n\n                            .mjpage * {\n                            transition: none;\n             