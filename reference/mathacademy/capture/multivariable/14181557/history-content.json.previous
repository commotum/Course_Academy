 transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n<g transform=\"translate(167,0)\">\n<g transform=\"translate(-11,0)\">\n<g transform=\"translate(0,-50)\">\n <use xlink:href=\"#E18-MJMATHI-41\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-2227\" x=\"972\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMATHI-43\" x=\"1862\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-2261\" x=\"2900\" y=\"0\"></use>\n<g transform=\"translate(3957,0)\">\n <use xlink:href=\"#E18-MJMAIN-74\"></use>\n <use xlink:href=\"#E18-MJMAIN-72\" x=\"389\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-75\" x=\"782\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-65\" x=\"1338\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E18-MJMAIN-2227\" x=\"5962\" y=\"0\"></use>\n<g transform=\"translate(6851,0)\">\n <use xlink:href=\"#E18-MJMAIN-66\"></use>\n <use xlink:href=\"#E18-MJMAIN-61\" x=\"306\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-6C\" x=\"807\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-73\" x=\"1085\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-65\" x=\"1480\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E18-MJMAIN-2261\" x=\"9054\" y=\"0\"></use>\n<g transform=\"translate(10110,0)\">\n <use xlink:href=\"#E18-MJMAIN-66\"></use>\n <use xlink:href=\"#E18-MJMAIN-61\" x=\"306\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-6C\" x=\"807\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-73\" x=\"1085\" y=\"0\"></use>\n <use xlink:href=\"#E18-MJMAIN-65\" x=\"1480\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n\n        </div>",
