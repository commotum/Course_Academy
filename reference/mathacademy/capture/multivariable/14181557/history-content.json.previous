          min-width: 0;\n                            min-height: 0;\n                            width: 100%\n                            }</style><p>First, let's recall the following facts about the \"and\" <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-1-Title\" focusable=\"false\" height=\"2.843ex\" role=\"img\" style=\"vertical-align: -0.838ex;\" viewbox=\"0 -863.1 1446.5 1223.9\" width=\"3.36ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-1-Title\">(\\land)</title>\n<defs aria-hidden=\"true\">\n<path d=\"M94 250Q94 319 104 381T127 488T164 576T202 643T244 695T277 729T302 750H315H319Q333 750 333 741Q333 738 316 720T275 667T226 581T184 443T167 250T184 58T225 -81T274 -167T316 -220T333 -241Q333 -250 318 -250H315H302L274 -226Q180 -141 137 -14T94 250Z\" id=\"E1-MJMAIN-28\" stroke-width=\"1\"></path>\n<path d=\"M318 591Q325 598 333 598Q344 598 348 591Q349 590 414 445T545 151T611 -4Q609 -22 591 -22Q588 -22 586 -21T581 -20T577 -17T575 -13T572 -9T570 -4L333 528L96 -4Q87 -20 80 -21Q78 -22 75 -22Q57 -22 55 -4Q55 2 120 150T251 444T318 591Z\" id=\"E1-MJMAIN-2227\" stroke-width=\"1\"></path>\n<path d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\" id=\"E1-MJMAIN-29\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E1-MJMAIN-28\" y=\"0\"></use>\n<use x=\"389\" xlink:href=\"#E1-MJMAIN-2227\" y=\"0\"></use>\n<use x=\"1057\" xlink:href=\"#E1-MJMAIN-29\" y=\"0\"></use>\n</g>\n</svg></span> and \"or\" <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-2-Title\" focusable=\"false\" height=\"2.843ex\" role=\"img\" style=\"vertical-align: -0.838ex;\" viewbox=\"0 -