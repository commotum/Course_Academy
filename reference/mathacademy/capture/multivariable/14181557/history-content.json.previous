      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14181557/observations/lesson-step-153498-0db8544c45d30cbf4986.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14181557/observations/lesson-step-153498-0db8544c45d30cbf4986.png",
      "source_url": "https://mathacademy.com/topics/60",
      "captured_at": 1791915378.322377,
      "math_academy_id": "e-12678",
      "knowledge_point": "Expressing Nested Compound Statements in Symbolic Form",
