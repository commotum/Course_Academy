-2f2297b8b049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186379038} :answer-field/id #uuid "6b5dca88-9f31-5d96-9eb5-b0a3a32a71b5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186379036}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47a7a928-8818-5470-bb61-8110f7ce659e" :question/math-academy-id "q-177347" :question/problem "$6$ is a composite number **and** $2$ is negative.\n\nConsider the compound statement above and the following notations:\n\n- $R:6\\text{ is a composite number}$\n\n- $S:2\\text{ is negative}$\n\nExpressed in symbolic form, our statement can be written as\n{{field-1}}{{field-2}}{{field-3}}." :question/worked-solution "The word \"and\" is represented by the symbol \"$∧$\".\n\nSo, the sentence reads\n\n$$\n{{6\\text{ is a composite number}}_{⏟}}_{R}\\,{{\\text{and}}_{⏟}}_{∧}\\,{{2\\text{ is negative}}_{⏟}}_{S},\n$$\n\nthat is, $R∧S.$"}] [{:db/id #edb/ref 17592186389825 :knowledge-point/_questions [{:db/id #edb/ref 17592186054644 :knowledge-point/id #uuid "2c15e521-f848-5d9c-ba06-00550277b8cb" :knowledge-point/title "Finding Truth Values of Complex Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "562c9283-48db-53e3-8e1b-90f287599846" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186389827} {:answer/id #uuid "ad7fa272-b6f8-590f-9c5b-65d9f9dfa430" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186389828}] :answer-field/correct {:answer/id #uuid "ad7fa272-b6f8-590f-9c5b-65d9f9dfa430" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186389828} :answer-field/id #uuid "48a24199-8fbc-5f8a-be94-b14