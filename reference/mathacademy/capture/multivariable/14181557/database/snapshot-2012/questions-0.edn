id #edb/ref 17592186379038} :answer-field/id #uuid "6b5dca88-9f31-5d96-9eb5-b0a3a32a71b5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186379036}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47a7a928-8818-5470-bb61-8110f7ce659e" :question/math-academy-id "q-177347" :question/problem "$6$ is a composite number **and** $2$ is negative.\n\nConsider the compound statement above and the following notations:\n\n- $R:6\\text{ is a composite number}$\n\n- $S:2\\text{ is negative}$\n\nExpressed in symbolic form, our statement can be written as\n{{field-1}}{{field-2}}{{field-3}}." :question/worked-solution "The word \"and\" is represented by the symbol \"$∧$\".\n\nSo, the sentence reads\n\n$$\n{{6\\text{ is a composite number}}_{⏟}}_{R}\\,{{\\text{and}}_{⏟}}_{∧}\\,{{2\\text{ is negative}}_{⏟}}_{S},\n$$\n\nthat is, $R∧S.$"}] [{:db/id #edb/ref 17592186496281 :knowledge-point/_questions [{:db/id #edb/ref 17592186054641 :knowledge-point/id #uuid "93bc0caa-2352-5d02-9ccf-7267dff4be2c" :knowledge-point/title "Expressing Compound Statements in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4eb50d-bdf1-56bd-ae21-6340ff65e425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∨" :db/id #edb/ref 17592186495547} {:answer/id #uuid "96b27b00-fad8-5342-a031-248b5d0c0f50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186495846} {:answer/id #uuid "da76c7cc-2d09-5707-86e8-427bb55b41a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∧" :db/id #edb/ref 17592186495992}] :answer-field/correct {:answer/id #uuid "96b27b00-fad8-5342-a031-248b5d0c0f50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17