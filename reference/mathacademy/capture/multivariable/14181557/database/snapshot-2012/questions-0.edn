}_{A}\\,{{\\text{and}}_{⏟}}_{∧}\\,{{9\\text{ is prime}}_{⏟}}_{B}\n$$\n\nFor the compound statement above, we have that\n\n$\\,$ $A$ is {{field-1}},\n$\\,$ $B$ is {{field-2}},\n$\\,$ $A∧B$ is {{field-3}}." :question/worked-solution "First, let's recall the following facts about the \"and\" $(∧)$ and \"or\" $(∨)$ logical connectives:\n\n- The statement $A∧B$ is true if *both* $A$ and $B$ are true.\n\n- The statement $A∨B$ is true if either $A$ is true, or $B$ is true, or *both* $A$ and $B$ are true.\n\nIn our case, $A$ is false, and $B$ is false. Therefore, the result is false:\n\n$$\n\\begin{aligned}{{\\{1,2\\}\\cap \\{3\\}=\\{1,2,3\\}}_{⏟}}_{A}\\,{{\\text{and}}_{⏟}}_{∧}\\,{{9\\text{ is prime}}_{⏟}}_{B} & \\,\\,≡\\,\\text{false}∧\\text{false}≡\\text{false}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186496303 :knowledge-point/_questions [{:db/id #edb/ref 17592186054644 :knowledge-point/id #uuid "2c15e521-f848-5d9c-ba06-00550277b8cb" :knowledge-point/title "Finding Truth Values of Complex Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12345e4a-d887-537f-b77e-dad11466435e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186495551} {:answer/id #uuid "4a2de7e6-e549-5c70-96e5-8a3192abc611" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186495680}] :answer-field/correct {:answer/id #uuid "12345e4a-d887-537f-b77e-dad11466435e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186495551} :answer-field/id #uuid "1c280642-33c4-5bed-b4d3-b3f46ad0d1a8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186496087} {:answer-field/choices [{:answer/id #uuid "493e6d2e-e984-5db7-8e87-4c3e03dcd6c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186495678} {:answer/id #uuid "91f2d60f-5b20-5249-b392-f82fcb256770" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186495831}] :answer-field/correct {:answer/id #uuid "91f2d60f-5b20-5249-b392-f82fcb256770" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186495831} :answer-field/id #uuid "55ff92d9-197d-537e-a612-7fa2b44af8b2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186496118} {:answer-field/choices [{:answer/id #uuid "84f1d02d-fab2-534e-ac78-73d235fea8dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186495797} {:answer/id #uuid "bcaa3233-b273-5d33-96e5-df8a354675a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186495926}] :answer-field/correct {:answer/id #uuid "84f1d02d-fab2-534e-ac78-73d235fea8dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186495797} :answer-field/id #uuid "d153c1d9-5604-5d8d-a941-1ffa64d648ba" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186496185}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bbfbaab7-10b5-57a8-a26d-3c15f79b1087" :question/math-academy-id "q-175930" :question/problem "$$\n{{\\overset{P}{\\overset{⏞}{\\{1,2\\}\\cup \\{2\\}=\\{1,2\\}}}\\,\\overset{∨}{\\overset{⏞}{\\text{or}}}\\,\\overset{Q}{\\overset{⏞}{11\\text{ is prime}}}}_{⏟}}_{P\\,∨\\,Q}\\,{{\\text{and}}_{⏟}}_{∧}\\,{{2\\text{ is a perfect square}}_{⏟}}_{R}\n$$\n\nFor the compound statement above, we have that\n\n$\\,$ $P∨Q$ is {{field-1}},\n$\\,$ $R$ is {{field-2}},\n$\\,$ $(P∨Q)∧R$ is {{field-3}}." :question/worked-solution "First, let's recall the following facts about the \"and\" $(∧)$ and \"or\" $(∨)$ logical connectives:\n\n- The statement $A∧B$ is true if *both* $A$ and $B$ are true.\n\n- The statement $A∨B$ is true if either $A$ is true, or $B$ is true, or *both* $A$ and $B$ are true.\n\nIn our case, $P$ is true, $Q$ is true, and $R$ is false. Therefore, $P∨Q$ is true, but the result is false:\n\n$$\n\\begin{aligned}(P∨Q)∧R & ≡\\overset{\\text{true}}{\\overset{⏞}{(\\text{true}∨\\text{true})}}∧\\text{false} \\\\  & ≡\\text{true}∧\\text{false} \\\\  & ≡\\text{false}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379025 :knowledge-point/_questions [{:db/id #edb/ref 17592186054641 :knowledge-point/id #uuid "93bc0caa-2352-5d02-9ccf-7267dff4be2c" :knowledge-point/title "Expressing Compound Statements in Symbolic Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aff03dac-1a8f-5dbf-a4f8-9d2fef0ad08f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∧" :db/id #edb/ref 17592186379027} {:answer/id #uuid "4e321d34-1455-5152-bc41-3a72d41cfaa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186379028} {:answer/id #uuid "be75db87-a664-505d-b84d-604754c38fda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "S" :db/id #edb/ref 17592186379029} {:answer/id #uuid "64c60aee-9293-50b9-bd71-a3a552091fdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∨" :db/id #edb/ref 17592186379030}] :answer-field/correct {:answer/id #uuid "aff03dac-1a8f-5dbf-a4f8-9d2fef0ad08f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∧" :db/id #edb/ref 17592186379027} :answer-field/id #uuid "99ec625b-9a1b-56e8-97db-0210e78a612f" :answer-field/key "field-2" :answer-field/type {:db/i