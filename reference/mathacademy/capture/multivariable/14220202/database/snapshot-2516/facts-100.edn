6045417] [17592186129340 #edb/ref 1043 #edb/ref 17592186130302 #edb/ref 17592186045417] [17592186129340 #edb/ref 1043 #edb/ref 17592186130303 #edb/ref 17592186045417] [17592186129340 #edb/ref 1043 #edb/ref 17592186130304 #edb/ref 17592186045417] [17592186129340 #edb/ref 1043 #edb/ref 17592186130305 #edb/ref 17592186045417] [17592186129340 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186129340 #edb/ref 1045 "Surface Areas of Revolution for Parametric Curves" #edb/ref 17592186045417] [17592186129340 #edb/ref 1046 #edb/ref 17592186130300 #edb/ref 17592186045417] [17592186129340 #edb/ref 1049 #edb/ref 17592186049265 #edb/ref 17592186045417] [17592186129340 #edb/ref 1050 1500.0 #edb/ref 17592186045417] [17592186129340 #edb/ref 1053 #uuid "bf654963-a5d1-5562-85bc-b7c2fbbe6d40" #edb/ref 17592186045417] [17592186130300 #edb/ref 1058 #edb/ref 17592186130301 #edb/ref 17592186045417] [17592186130300 #edb/ref 1061 618749 #edb/ref 17592186045417] [17592186130300 #edb/ref 1062 #uuid "c5c27e9e-03cb-5a93-8a56-bd33588960fe" #edb/ref 17592186045417] [17592186130300 #edb/ref 1063 #edb/ref 17592186130449 #edb/ref 17592186045417] [17592186130301 #edb/ref 1058 #edb/ref 17592186130302 #edb/ref 17592186045417] [17592186130301 #edb/ref 1061 618750 #edb/ref 17592186045417] [17592186130301 #edb/ref 1062 #uuid "031d5fb3-1834-595b-8a36-577430a0f9a7" #edb/ref 17592186045417] [17592186130301 #edb/ref 1063 #edb/ref 17592186130466 #edb/ref 17592186045417] [17592186130302 #edb/ref 1058 #edb/ref 17592186130303 #edb/ref 17592186045417] [17592186130302 #edb/ref 1061 618751 #edb/ref 17592186045417] [17592186130302 #edb/ref 1062 #uuid "a6a3e1f3-c536-58d3-a81e-7966262884ce" #edb/ref 17592186045417] [17592186130302 #edb/ref 1063 #edb/ref 17592186129318 #edb/ref 17592186045417] [17592186130303 #edb/ref 1058 #edb/ref 17592186130304 #edb/ref 17592186045417] [17592186130303 #edb/ref 1061 618754 #edb/ref 17592186045417] [17592186130303 #edb/ref 1062 #uuid "622390da-a9e6-55af-8449-1ceed5d4cec3" #edb/ref 17592186045417] [17592186130303 #edb/ref 1063 #edb/ref 17592186130450 #edb/ref 17592186045417] [17592186130304 #edb/ref 1058 #edb/ref 17592186130305 #edb/ref 17592186045417] [17592186130304 #edb/ref 1061 618755 #edb/ref 17592186045417] [17592186130304 #edb/ref 1062 #uuid "ddd7ced1-9fe0-533d-bd7a-9dfbcff663f8" #edb/ref 17592186045417] [17592186130304 #edb/ref 1063 #edb/ref 17592186129319 #edb/ref 17592186045417] [17592186130305 #edb/ref 1061 618758 #edb/ref 17592186045417] [17592186130305 #edb/ref 1062 #uuid "2f4e64a8-3397-5e7e-b805-080c59c56440" #edb/ref 17592186045417] [17592186130305 #edb/ref 1063 #edb/ref 17592186129320 #edb/ref 17592186045417] [17592186130449 #edb/ref 1064 "Recall that when we rotate a curve by $2\\pi$ radians about the $x$-axis, the area generated by this surface of revolution is given by\n\n$$\nS =  \\int 2\\pi y \\, \\textrm{d}s.\n$$\n\nNow suppose we have a parametrically defined curve: \n\n$$\nx = x(t), \\qquad\ny = y(t), \\qquad\nt \\in \\left[t_1,t_2\\right].\n$$\n\nIn the case of a parametric curve, the arc length element $\\textrm{d}s$ is given by\n\n$$\n\\textrm{d}s = \\sqrt{\\left(\\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2+\\left(\\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2} \\, \\textrm{d}t.\n$$\n\nAs a result, we obtain the following formula for the surface area generated by rotating a parametrically defined curve about the $x$-axis:\n\n$$\nS = 2\\pi \\int_{t_1}^{t_2} y(t) \\sqrt{\\left(\\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2+\\left(\\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\,\\textrm{d}t\n$$\n\n \n\nLet's see an example." #edb/ref 17592186045417] [17592186130449 #edb/ref 1065 6113 #edb/ref 17592186045417] [17592186130449 #edb/ref 1066 #uuid "36a57433-1c78-58b8-860c-0ea6e3471761" #edb/ref 17592186045417] [17592186130449 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186130450 #edb/ref 1064 "When we rotate a curve by $2\\pi$ radians about the $y$-axis, the area generated by this surface of revolution is given by\n\n$$\nS =  \\int 2\\pi x \\, \\textrm{d}s.\n$$\n\nTherefore, in the case of a parametrically defined curve \n\n$$\nx = x(t), \\qquad\ny = y(t), \\qquad\nt \\in [t_1,t_2],\n$$\n\nthe formula for the surface area generated when this curve is rotated $2\\pi$ radians about the $y$-axis is given by\n\n$$\nS = 2\\pi \\int_{t_1}^{t_2} x(t) \\sqrt{\\left(\\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2+\\left(\\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\,\\textrm{d}t.\n$$" #edb/ref 17592186045417] [17592186130450 #edb/ref 1065 6145 #edb/ref 17592186045417] [17592186130450 #edb/ref 1066 #uuid "548401c3-a52c-5444-b834-57c50c4bfa72" #edb/ref 17592186045417] [17592186130450 #edb/ref 1067 "Surface Area Generated by Functions of Y" #edb/ref 17592186045417] [17592186130466 #edb/ref 1064 "Consider the curve defined by the parametric equations\n\n$$\nx = \\cos{t}, \\qquad\ny = \\sin{t}, \\qquad\nt \\in [0,\\pi].\n$$\n\nIf we rotate this curve by $2\\pi$ radians about the $x$-axis, we obtain a sphere of radius $1.$ \n\n![](images/d0/d0d323b764b70d3f2830d821636a9bc27b40e7f7e9f45df909c81dd279dc16e4.png)\n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)=-\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)=\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, the surface area of our surface of revolution can be computed as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }\\operatorname{sin}⁡t\\sqrt{{(-\\operatorname{sin}⁡t)}^{2}+{(\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }\\operatorname{sin}⁡t\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =2\\pi (-\\operatorname{cos}⁡t){|}_{0}^{\\pi } \\\\  & =-2\\pi (\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-2\\pi (-1-1) \\\\  & =4\\pi \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186130466 #edb/ref 1065 7707 #edb/ref 17592186045417] [17592186130466 #edb/ref 1066 #uuid "f849fe7f-670f-5a7f-8dc7-dbbd33a876f1" #edb/ref 17592186045417] [17592186130466 #edb/ref 1067 "A Worked Example" #edb/ref 17592186045417] [17592186248156 #edb/ref 1080 "\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(4\\operatorname{ln}⁡x+1)+C" #edb/ref 17592186045417] [17592186248156 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248156 #edb/ref 1083 #uuid "51767ce2-04dc-5c92-be64-ecdd456e4d83" #edb/ref 17592186045417] [17592186248248 #edb/ref 1080 "\\frac{{x}^{2}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡x-1)+C" #edb/ref 17592186045417] [17592186248248 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248248 #edb/ref 1083 #uuid "5af05724-0a68-584c-bdcc-e0f997546e41" #edb/ref 17592186045417] [17592186248884 #edb/ref 1080 "\\frac{{x}^{2}}{\\operatorname{ln}⁡5}(4\\operatorname{ln}⁡x-1)+C" #edb/ref 17592186045417] [17592186248884 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248884 #edb/ref 1083 #uuid "a32c58bd-145a-53ec-98dc-145783470c2a" #edb/ref 17592186045417] [17592186249008 #edb/ref 1080 "\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(2\\operatorname{ln}⁡x-1)+C" #edb/ref 17592186045417] [17592186249008 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186249008 #edb/ref 1083 #uuid "b0502d42-a25a-5ae1-9cca-dcf3a4cbe860" #edb/ref 17592186045417] [17592186249187 #edb/ref 1080 "\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(3\\operatorname{ln}⁡x+2)+C" #edb/ref 17592186045417] [17592186249187 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186249187 #edb/ref 1083 #uuid "c64da03c-c464-59cb-81c9-d62f5d957afd" #edb/ref 17592186045417] [17592186249954 #edb/ref 1075 #edb/ref 17592186248156 #edb/ref 17592186045417] [17592186249954 #edb/ref 1075 #edb/ref 17592186248248 #edb/ref 17592186045417] [17592186249954 #edb/ref 1075 #edb/ref 17592186248884 #edb/ref 17592186045417] [17592186249954 #edb/ref 1075 #edb/ref 17592186249008 #edb/ref 17592186045417] [17592186249954 #edb/ref 1075 #edb/ref 17592186249187 #edb/ref 17592186045417] [17592186249954 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186249954 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186249954 #edb/ref 1078 #edb/ref 17592186249008 #edb/ref 17592186045417] [17592186249954 #edb/ref 1079 #uuid "a22fa253-1174-584a-9758-f3f964e75c1e" #edb/ref 17592186045417] [17592186250282 #edb/ref 1068 #edb/ref 17592186249954 #edb/ref 17592186045417] [17592186250282 #edb/ref 1069 "q-114552" #edb/ref 17592186045417] [17592186250282 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186250282 #edb/ref 1071 "Calculate $\\int 2x{log}_{5}⁡(x)\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186250282 #edb/ref 1072 #uuid "91292256-4f82-5669-95d9-e91e8b8d6af8" #edb/ref 17592186045417] [17592186250282 #edb/ref 1074 "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{5}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡5} \\\\ {v}^{′}=2x\\, & ⟹\\,v=\\int 2x\\,\\text{d}x={x}^{2}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 2x{log}_{5}⁡(x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{5}⁡(x)({x}^{2})-\\int ({x}^{2})(\\frac{1}{x\\operatorname{ln}⁡5})\\,\\text{d}x \\\\  & ={x}^{2}{log}_{5}⁡(x)-\\frac{1}{\\operatorname{ln}⁡5}\\int x\\,\\text{d}x \\\\  & ={x}^{2}{log}_{5}⁡(x)-\\frac{1}{\\operatorname{ln}⁡5}\\cdot \\frac{{x}^{2}}{2}+C \\\\  & =\\frac{{x}^{2}\\operatorname{ln}⁡x}{\\operatorname{ln}⁡5}-\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}+C \\\\  & =\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(2\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{5}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡5}.$" #edb/ref 17592186045417] [17592186250914 #edb/ref 1080 "\\frac{dP}{dt}=-0.2P(300-P)" #edb/ref 17592186045417] [17592186250914 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186250914 #edb/ref 1083 #uuid "2a356ff5-da1f-5dea-9c22-ac42a978f1f1" #edb/ref 17592186045417] [17592186251023 #edb/ref 1080 "\\frac{dP}{dt}=0.2P(300-P)" #edb/ref 17592186045417] [17592186251023 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186251023 #edb/ref 1083 #uuid "3882ae11-e665-5f98-b13e-856ea3ff067a" #edb/ref 17592186045417] [17592186251388 #edb/ref 1080 "\\frac{dP}{dt}=0.2P(300+P)" #edb/ref 17592186045417] [17592186251388 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186251388 #edb/ref 1083 #uuid "65ba5d91-2960-5f9c-b94f-a9c1cfb957b8" #edb/ref 17592186045417] [17592186251435 #edb/ref 1080 "\\frac{dy}{dt}=4y(50-y)" #edb/ref 17592186045417] [17592186251435 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186251435 #edb/ref 1083 #uuid "6bba37af-8df4-5b8c-a930-80d2186439c5" #edb/ref 17592186045417] [17592186251647 #edb/ref 1080 "\\frac{dP}{dt}=300P(0.2-P)" #edb/ref 17592186045417] [17592186251647 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186251647 #edb/ref 1083 #uuid "81afc71e-2e81-5e1d-9747-fb7bccbefe35" #edb/ref 17592186045417] [17592186252210 #edb/ref 1080 "\\frac{dy}{dt}=4y(50+y)" #edb/ref 17592186045417] [17592186252210 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186252210 #edb/ref 1083 #uuid "bbe50a92-b71b-5769-a939-63ed274c1a57" #edb/ref 17592186045417] [17592186252516 #edb/ref 1080 "\\frac{dy}{dt}=4y" #edb/ref 17592186045417] [17592186252516 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 1759218604