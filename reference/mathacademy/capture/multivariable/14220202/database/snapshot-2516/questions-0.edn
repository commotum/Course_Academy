#{[{:db/id #edb/ref 17592186250282 :knowledge-point/_questions [{:db/id #edb/ref 17592186096835 :knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51767ce2-04dc-5c92-be64-ecdd456e4d83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(4\\operatorname{ln}⁡x+1)+C" :db/id #edb/ref 17592186248156} {:answer/id #uuid "5af05724-0a68-584c-bdcc-e0f997546e41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186248248} {:answer/id #uuid "a32c58bd-145a-53ec-98dc-145783470c2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{\\operatorname{ln}⁡5}(4\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186248884} {:answer/id #uuid "b0502d42-a25a-5ae1-9cca-dcf3a4cbe860" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(2\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186249008} {:answer/id #uuid "c64da03c-c464-59cb-81c9-d62f5d957afd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(3\\operatorname{ln}⁡x+2)+C" :db/id #edb/ref 17592186249187}] :answer-field/correct {:answer/id #uuid "b0502d42-a25a-5ae1-9cca-dcf3a4cbe860" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(2\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186249008} :answer-field/id #uuid "a22fa253-1174-584a-9758-f3f964e75c1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249954}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91292256-4f82-5669-95d9-e91e8b8d6af8" :question/math-academy-id "q-114552" :question/problem "Calculate $\\int 2x{log}_{5}⁡(x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{5}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡5} \\\\ {v}^{′}=2x\\, & ⟹\\,v=\\int 2x\\,\\text{d}x={x}^{2}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 2x{log}_{5}⁡(x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{5}⁡(x)({x}^{2})-\\int ({x}^{2})(\\frac{1}{x\\operatorname{ln}⁡5})\\,\\text{d}x \\\\  & ={x}^{2}{log}_{5}⁡(x)-\\frac{1}{\\operatorname{ln}⁡5}\\int x\\,\\text{d}x \\\\  & ={x}^{2}{log}_{5}⁡(x)-\\frac{1}{\\operatorname{ln}⁡5}\\cdot \\frac{{x}^{2}}{2}+C \\\\  & =\\frac{{x}^{2}\\operatorname{ln}⁡x}{\\operatorname{ln}⁡5}-\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}+C \\\\  & =\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(2\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{5}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡5}.$"}] [{:db/id #edb/ref 17592186354291 :knowledge-point/_questions [{:db/id #edb/ref 17592186092223 :knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4" :knowledge-point/title "Using a Matrix That Represents a Rotation of 90 Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6447923e-3191-5c08-b560-016a9cca81ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469362} {:answer/id #uuid "0cc433cf-3e13-565e-b11d-47ebc6009d0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469363}] :answer-field/correct {:answer/id #uuid "0cc433cf-3e13-565e-b11d-47ebc6009d0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469363} :answer-field/id #uuid "0cdb2ef9-a7f4-5197-a4be-9be3babb8318" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470293} {:answer-field/choices [{:answer/id #uuid "b6f89934-e7fc-5003-8d75-d813ae4eddf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469364} {:answer/id #uuid "bb820a21-e923-56ac-bab5-b0c3ae2a331f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469365}] :answer-field/correct {:answer/id #uuid "bb820a21-e923-56ac-bab5-b0c3ae2a331f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469365} :answer-field/id #uuid "b8b6b289-f586-5a9d-a28a-19624f5169ef" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470294} {:answer-field/choices [{:answer/id #uuid "bd2a7885-0052-528b-b38b-7b898ccca0b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469366} {:answer/id #uuid "f9179f60-52cd-5391-9242-248f117920a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469367}] :answer-field/correct {:answer/id #uuid "bd2a7885-0052-528b-b38b-7b898ccca0b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469366} :answer-field/id #uuid "d303017f-d35d-596d-a193-c2ff0482d558" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470295}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2810540-9b59-5736-808a-d6bd469fdb33" :question/math-academy-id "q-8415" :question/problem "A triangle $S$ has vertices at $(0,0),(2,0),(2,2).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n- **I.** $(0,0)$\n- **II.** $(2,-2)$\n- **III.** $(-2,0)$\n\nSelect all that apply." :question/worked-solution "The counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ is given by the matrix\n\n$$\nR=\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}.\n$$\n\nTo find the image of $S$ under the action of ${R}_{{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}0 & 2 & 2 \\\\ 0 & 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =\\begin{bmatrix}0 & 1 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}0 & 2 & 2 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 2 \\\\ 0 & -2 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(0,0),(0,-2),(2,-2).$\n\nSo, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186092923 :knowledge-point/_questions [{:db/id #edb/ref 17592186092374 :knowledge-point/id #uuid "84a533e8-9a7c-58f3-9d3c-7c08b3c6bfd1" :knowledge-point/title "Finding the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8f421ea-e24b-5d7f-848d-e65b1eb563dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}(e^{π/2} - e^{- π/2})" :db/id #edb/ref 17592186091739} {:answer/id #uuid "32b93052-5aa7-5a79-81ef-ec4a618158f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}(e^{π/2} - 1)" :db/id #edb/ref 17592186091740} {:answer/id #uuid "37e49c42-8246-56c3-8534-ed450bbab27d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}(e^{π/2} - 1)" :db/id #edb/ref 17592186091741} {:answer/id #uuid "3a7c6d33-ec9d-5f09-8a41-23c7079e0681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186091742} {:answer/id #uuid "6ee938a5-0d87-51d8-bfb3-9b26b0f3ef68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}e^{π/2}" :db/id #edb/ref 17592186091743}] :answer-field/id #uuid "b4db8ae4-ea41-5588-80ee-f64b1cf5f458" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091738}] :question/id #uuid "d05250f7-7ca4-5099-862d-2ef2f12670bf" :question/math-academy-id "q-9536" :question/problem "![](images/fa/fa58c9d1c0680dd94bb25c04e0a268df836e14bfb217f0a20d3bd75224cec4e8.png)\n\nFind the arc length of the polar curve $r = e^{θ}$ for $0 \\le θ \\le \\frac{π}{2}$ (shown in blue in the diagram above)."}]}
