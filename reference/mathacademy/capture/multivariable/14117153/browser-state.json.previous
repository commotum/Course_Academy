      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14117153/observations/step-q94400-dca58666a85af6b5642c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14117153/observations/step-q94400-dca58666a85af6b5642c.png",
      "source_url": "https://mathacademy.com/tasks/14117153/topics/2025/lesson",
      "captured_at": 1791721382.710355,
      "math_academy_id": "q-94400",
      "topic_id": "2025",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q94400",
        "placement_id": null,
        "content_id": null,
        "type": null
      },
      "source_example_id": "e-8192",
      "knowledge_point": "Computing Mass or Charge Over a Type I or Type II Region",
