#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186495218} :activity/id #uuid "24b39a23-bcdc-53b3-a773-ff2a2a0400ae" :activity/scope {:db/id #edb/ref 17592186495275 :topic/id #uuid "04654553-f8da-5ec9-a27d-ee5bae447da5" :topic/math-academy-id 6818} :activity/steps [{:db/id #edb/ref 17592186495185 :step/content {:db/id #edb/ref 17592186495042 :knowledge-point/canonical-example {:db/id #edb/ref 17592186495129 :question/id #uuid "b63d3979-8319-52e5-833c-e4230a367cb0" :question/math-academy-id "e-4540"} :knowledge-point/id #uuid "04d9118c-9cc2-5bb5-a7c4-ce43be06a65d" :knowledge-point/questions [{:db/id #edb/ref 17592186495064} {:db/id #edb/ref 17592186495092} {:db/id #edb/ref 17592186495122} {:db/id #edb/ref 17592186495135} {:db/id #edb/ref 17592186495147} {:db/id #edb/ref 17592186514453} {:db/id #edb/ref 17592186514481}] :knowledge-point/title "Determining the Best Deal by Computing Unit Prices"} :step/id #uuid "1de7948d-68f8-5999-953c-8acb8be31016" :step/math-academy-id 616955 :step/next {:db/id #edb/ref 17592186495238}} {:db/id #edb/ref 17592186495190 :step/content {:db/id #edb/ref 17592186495281 :tutorial/content "Unit prices can be used to quantify how good of a deal a particular purchase is.\n\nFor example, suppose that a store sells two packs of shirts:\n\n- $3$ shirts for $\\[math]12$\n\n- $5$ shirts for $\\[/math]15$\n\nTo determine which pack is the better deal, we can compare their unit prices.\n\n- For the pack of $3$ shirts for $\\[math]12,$ dividing the total cost by the total number of shirts gives\n\n$$\n12 \\div 3 = 4.\n$$\n\nSo, the unit price is $\\[/math]4.$\n\n- For the pack of $5$ shirts for $\\[math]15,$ dividing the total cost by the total number of shirts gives\n\n$$\n15 \\div 5 = 3.\n$$\n\nSo, the unit price is $\\[/math]3.$\n\nNow we interpret the unit prices in the context of the problem.\n\n- In the pack of $3$ shirts for $\\[math]12,$ each shirt costs $\\[/math]4.$\n\n- In the pack of $5$ shirts for $\\[math]15,$ each shirt costs $\\[/math]3.$\n\nBased on the above, we conclude that the pack of $5$ shirts for $\\[math]15$ is the better deal because it has a lower unit price (meaning that each shirt costs less)." :tutorial/id #uuid "be64d01c-4eb7-5332-b26c-97583b224a56" :tutorial/math-academy-id 15097 :tutorial/title "Determining the Best Deal by Computing Unit Prices"} :step/id #uuid "235b590b-52bc-52e8-a4ef-db453fdea765" :step/math-academy-id 616954 :step/next {:db/id #edb/ref 17592186495185}} {:db/id #edb/ref 17592186495197 :step/content {:db/id #edb/ref 17592186495043 :knowledge-point/canonical-example {:db/id #edb/ref 17592186495075 :question/id #uuid "3a104615-4887-59c8-9722-bb07b6cca5ae" :question/math-academy-id "e-4542"} :knowledge-point/id #uuid "1321abcb-7c99-5fef-b4fb-975ae5652b90" :knowledge-point/questions [{:db/id #edb/ref 17592186495066} {:db/id #edb/ref 17592186495086} {:db/id #edb/ref 17592186495096} {:db/id #edb/ref 17592186495102} {:db/id #edb/ref 17592186495111} {:db/id #edb/ref 17592186514380} {:db/id #edb/ref 17592186514418}] :knowledge-point/title "Working With a Reciprocal Unit Price"} :step/id #uuid "30f25678-f130-575f-b357-4ffe8b59f407" :step/math-academy-id 616959} {:db/id #edb/ref 17592186495218 :step/content {:db/id #edb/ref 17592186495280 :tutorial/content "When we compare prices, it is often helpful to know the *unit price*. Knowing it helps us:\n\n- compare different products,\n\n- determine the total cost for a given amount,\n\n- decide which option is the better deal.\n\nFor example, suppose Lena wants to buy some apples. The price of apples at a nearby market is $\\[math]1.20/\\mathrm{lb}.$ How much would Lena pay for $4$ pounds of apples?\n\nThe unit price is $\\[/math]1.20$ per pound.  \n\nSince Lena is buying $4$ pounds, we multiply the unit price by the number of pounds:\n\n$$\n\\begin{aligned}1.20\\times 4 & =4.80\\end{aligned}\n$$\n\nTherefore, Lena would pay $\\[math]4.80$ for $4$ pounds of apples.\n\nWhenever we know the unit price and the quantity, we can find the total cost by multiplying:\n\n$$\n\\text{Total Cost} = \\text{Unit Price} \\times \\text{Quantity}.\n$$" :tutorial/id #uuid "55a58a08-8164-5352-9b75-43c62ba6ecc5" :tutorial/math-academy-id 15086 :tutorial/title "Introduction"} :step/id #uuid "7f189f23-779a-5ab6-9245-89a7a070f017" :step/math-academy-id 616950 :step/next {:db/id #edb/ref 17592186495245}} {:db/id #edb/ref 17592186495238 :step/content {:db/id #edb/ref 17592186495278 :tutorial/content "For every unit price in \"dollars per item\", there is also a **reciprocal unit price** in \"items per dollar\".\n\nFor example, suppose that a store sells fabric for $\\[math]2$ per yard. Taking the reciprocal, we have\n\n$$\n2 \\,\\textrm{dollars per yard} \\quad\\rightarrow\\quad \\dfrac{1}{2}  \\,\\textrm{yards per dollar} .\n$$\n\nSo, if we have $\\[/math]1,$ then we can buy $\\dfrac{1}{2}$ of a yard of fabric." :tutorial/id #uuid "18f05709-44a6-59bc-962c-dbf491ad7501" :tutorial/math-academy-id 3106 :tutorial/title "Reciprocal Unit Prices"} :step/id #uuid "aebf2791-ae4f-5ea2-8312-994b316164b5" :step/math-academy-id 616958 :step/next {:db/id #edb/ref 17592186495197}} {:db/id #edb/ref 17592186495245 :step/content {:db/id #edb/ref 17592186495046 :knowledge-point/canonical-example {:db/id #edb/ref 17592186495154 :question/id #uuid "df05a979-ea59-5937-80a7-89e9e0014ca8" :question/math-academy-id "e-4539"} :knowledge-point/id #uuid "d550bb4f-72a6-5b74-b050-8fdc2af6b23f" :knowledge-point/questions [{:db/id #edb/ref 17592186495071} {:db/id #edb/ref 17592186495072} {:db/id #edb/ref 17592186495093} {:db/id #edb/ref 17592186495136} {:db/id #edb/ref 17592186495143} {:db/id #edb/ref 17592186514462}] :knowledge-point/title "Calculating a Total Price from a Unit Price"} :step/id #uuid "b7fc4646-02d5-59f6-896d-aa9560955608" :step/math-academy-id 616951 :step/next {:db/id #edb/ref 17592186495190}}] :activity/title "Working With Unit Prices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186494301}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186514548} :activity/id #uuid "cb8ff5bb-d59c-5914-bb61-57ac943c0155" :activity/scope {:db/id #edb/ref 17592186495275 :topic/id #uuid "04654553-f8da-5ec9-a27d-ee5bae447da5" :topic/math-academy-id 6818} :activity/steps [{:db/id #edb/ref 17592186514507 :step/content {:db/id #edb/ref 17592186514453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "052a5fc9-a08a-5e7c-b988-4b6314c92427" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186513542} {:answer/id #uuid "3220a4ae-203a-54bc-8dc9-0404a172e8e0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186513669} {:answer/id #uuid "4ac7e5ef-63b7-5158-a86b-66afea0c52dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$C$ only" :db/id #edb/ref 17592186513734} {:answer/id #uuid "9da09a2e-4db0-5717-b2b6-a9683981734e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$B$ only" :db/id #edb/ref 17592186513939} {:answer/id #uuid "e8f6004b-175f-5126-90f5-0f335d97919a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ only" :db/id #edb/ref 17592186514141}] :answer-field/correct {:db/id #edb/ref 17592186513542} :answer-field/id #uuid "41add624-7a03-5829-b64c-9f93149a5a5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514253}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b32ba521-b62e-5f22-bb06-26d27c73470d" :question/math-academy-id "q-91913" :question/problem "In a snack store, there are three different types of cookies that come in boxes: \n\n- Box $A$ contains $13$ pounds, and costs $$3.77\\,.$\n\n- Box $B$ contains $10.5$ pounds, and costs $$3.15\\,.$\n\n- Box $C$ contains $12$ pounds, and costs $$3.48\\,.$\n\nWhich box of cookies is the best deal?" :question/worked-solution "The best deal is the one with the lowest unit price. So, we need to compute the unit prices for all three boxes. To compute the unit price, we divide the cost by the total number of pounds.  \n\n- Dividing the total cost by the number of pounds in box $A$,  we get\n\n$$\n3.77÷13=0.29\\,.\n$$\n\nSo, the unit price of box $A$ is $$0.29$  per pound.\n\n- Dividing the total cost by the number of pounds in box $B$,  we get\n\n$$\n3.15÷10.5=0.30\\,.\n$$\n\nSo, the unit price of bag $B$ is $$0.30$  per pound.\n\n- Dividing the total cost by the number of pounds in box $C$,  we get\n\n$$\n3.48÷12=0.29\\,.\n$$\n\nSo, the unit price of box $C$ is $$0.29$  per pound.\n\nFrom the above, we see that boxes $A$ and $C$ have the lowest unit price. Therefore, boxes $A$ and $C$ are the best deals."} :step/id #uuid "6808d3f3-1bd6-54f5-b886-4da1e7511ffe" :step/next {:db/id #edb/ref 17592186514521}} {:db/id #edb/ref 17592186514510 :step/content {:db/id #edb/ref 17592186514418 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18257edf-9868-553b-81b1-2c63d81b6b3b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.5$ pounds" :db/id #edb/ref 17592186513593} {:answer/id #uuid "67a910b8-a9f6-545c-83d3-a9a8462d00f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.4$ pounds" :db/id #edb/ref 17592186513811} {:answer/id #uuid "df252277-1b3a-5f73-86c9-24b594684032" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.25$ pounds" :db/id #edb/ref 17592186514118} {:answer/id #uuid "e1a47dec-e10b-5077-a7ac-7a5a62c0ed53" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.3$ pounds" :db/id #edb/ref 17592186514123} {:answer/id #uuid "f7498fbd-777b-58c7-84a1-2f148a7f13d7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.2$ pounds" :db/id #edb/ref 17592186514179}] :answer-field/correct {:db/id #edb/ref 17592186514179} :answer-field/id #uuid "4ee093f1-885a-5858-9c9e-fa0b646988c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514260}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6ad6d7d2-b42a-533b-a893-138de3271ac7" :question/math-academy-id "q-68919" :question/problem "At Joe's market, the unit price of tomatoes is $$5$ per pound. How many pounds of tomatoes can Geena buy for $$1?$" :question/worked-solution "We are given the unit rate of $$5$ per pound (dollars per pound). To find how many pounds of tomatoes she can buy for  $$1,$ we need to find the unit rate in pounds per dollar. So, we take the reciprocal: \n\n$$\n5\\,\\text{dollars per pound}\\,\\to \\,1÷5=0.2\\,\\text{pounds per dollar}\n$$\n\nSo, the unit rate is $0.2$ pounds per dollar. Therefore, Geena can buy $0.2$ pounds of tomatoes for $1$ dollar."} :step/id #uuid "75590325-0b56-5c97-a717-ef93b875f262" :step/next {:db/id #edb/ref 17592186514507}} {:db/id #edb/ref 17592186514521 :step/content {:db/id #edb/ref 17592186514380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4461a9e0-563a-5ac6-903f-d8ac88236689" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.5$ ounces" :db/id #edb/ref 17592186513714} {:answer/id #uuid "55ca1c43-f050-5967-bd2b-52a28533f379" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.4$ ounces" :db/id #edb/ref 17592186513765} {:answer/id #uuid "90f24755-d4bb-5615-a831-d25c0b5723db" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.2$ ounces" :db/id #edb/ref 17592186513907} {:answer/id #uuid "a9e7d584-2f09-5ba1-a845-e468f2ab21c2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.25$ ounces" :db/id #edb/ref 17592186513973} {:answer/id #uuid "c9674547-8ff9-5492-8ca5-922e240e0938" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.1$ ounces" :db/id #edb/ref 17592186514059}] :answer-field/correct {:db/id #edb/ref 17592186513714} :answer-field/id #uuid "11cd4261-4362-564b-a6e4-d1df079c1ba9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514217}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "25c7031c-7a26-5c4d-b79f-0063afe0df6f" :question/math-academy-id "q-355712" :question/problem "At the deli, the unit price of specialty cheese is $$2$ per ounce. How many ounces of specialty cheese can Rohan buy for $$1?$" :question/worked-solution "We are given the unit rate of $$2$ per ounce (dollars per ounce). To find how many ounces of specialty cheese he can buy for  $$1,$ we need to find the unit rate in ounces per dollar. So, we take the reciprocal: \n\n$$\n2\\,\\text{dollars per ounce}\\,\\to \\,1÷2=0.5\\,\\text{ounces per dollar}\n$$\n\nSo, the unit rate is $0.5$ ounces per dollar. Therefore, Rohan can buy $0.5$ ounces of specialty cheese for $1$ dollar."} :step/id #uuid "a6853681-9bf8-57e0-aa5a-d730ef04cfc0"} {:db/id #edb/ref 17592186514525 :step/content {:db/id #edb/ref 17592186514481 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "121f19df-f7ec-5869-a45c-be189aec34af" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$C$ only" :db/id #edb/ref 17592186513579} {:answer/id #uuid "194f3cf1-5137-5229-bdee-281142e918b9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ only" :db/id #edb/ref 17592186513599} {:answer/id #uuid "1ca66867-a609-5af2-ba9f-24b54371b40b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186513608} {:answer/id #uuid "9ec85867-3f96-5f17-bbbb-317d242f0548" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186513941} {:answer/id #uuid "ad5f5f79-d0dc-59fb-b9e3-e7f3e5825455" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$B$ only" :db/id #edb/ref 17592186513988}] :answer-field/correct {:db/id #edb/ref 17592186513579} :answer-field/id #uuid "580ccd6e-f901-58f3-a184-32b32c159856" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514266}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fa60ae23-8081-566e-ab07-1797ceb80d43" :question/math-academy-id "q-68901" :question/problem "Lucy's Treats sells three different boxes of raisins: \n\n- Box $A$ contains $12$ ounces, and costs $$2.28\\,.$\n\n- Box $B$ contains $32$ ounces,  and costs $$5.44\\,.$\n\n- Box $C$ contains $22$ ounces, and costs $$3.52\\,.$\n\nWhich box of raisins is the best deal?" :question/worked-solution "The best deal is the box with the lowest unit price. So, we need to compute the unit prices for all three boxes. To compute the unit price, we divide the price by the total number of ounces.   \n\n- Dividing the total cost by the number of ounces in box $A,$ we get\n\n$$\n2.28÷12=0.19\\,.\n$$\n\nSo, the unit price of box $A$ is $$0.19.$\n\n- Dividing the total cost by the number of ounces in box $B,$ we get\n\n$$\n5.44÷32=0.17\\,.\n$$\n\nSo, the unit price of box $B$ is $$0.17.$\n\n- Dividing the total cost by the number of ounces in box $C,$ we get\n\n$$\n3.52÷22=0.16\\,.\n$$\n\nSo, the unit price of box $C$ is $$0.16.$\n\nFrom the above, we see that box $C$ has the lowest unit price of $$0.16/\\text{oz}.$ Therefore, box $C$ offers the best deal."} :step/id #uuid "b67b97a8-1d26-577a-b9f1-8e74866dde08" :step/next {:db/id #edb/ref 17592186514510}} {:db/id #edb/ref 17592186514548 :step/content {:db/id #edb/ref 17592186514462 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10245252-29bb-5324-a581-26085a39fe28" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$4.94$" :db/id #edb/ref 17592186513572} {:answer/id #uuid "16a66103-9d90-5322-91a9-b6156d9743b5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$5.84$" :db/id #edb/ref 17592186513590} {:answer/id #uuid "258a35a6-2b3a-5e86-8b1f-0ce644f7d05d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$5.64$" :db/id #edb/ref 17592186513638} {:answer/id #uuid "afb02c14-0e39-54c3-8fb8-8b2b3a885193" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$5.34$" :db/id #edb/ref 17592186513994} {:answer/id #uuid "fd6a0e9a-46c1-5683-94a3-cd1426ac3273" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$5.94$" :db/id #edb/ref 17592186514197}] :answer-field/correct {:db/id #edb/ref 17592186513994} :answer-field/id #uuid "62ea6bc2-70ac-5760-9ddc-ebf3b618c556" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186514274}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c993b31b-1739-52ac-a2f5-55deea55eaf7" :question/math-academy-id "q-68863" :question/problem "Jack bought a pumpkin that weighed $3$ kilograms. The retail price of pumpkin at the store is  $$1.78/kg.$ How much did  Jack pay for the pumpkin?" :question/worked-solution "The unit price of pumpkin is $$1.78/kg.$ To find the cost of  $3$ kilograms of pumpkin, we multiply:    \n\n$$\n\\begin{aligned}1.78\\times 3 & =5.34\\end{aligned}\n$$\n\nTherefore, Jack paid  $$5.34$ for the $3$-$\\text{kg}$ pumpkin."} :step/id #uuid "fcb274d6-4201-5c3e-bf1f-dac0c5b949ad" :step/next {:db/id #edb/ref 17592186514525}}] :activity/title "Working With Unit Prices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186513522}]}
