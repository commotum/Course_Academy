#{[{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186540168} :activity/id #uuid "234f71ec-eed9-5ec5-8507-1ddeda7aa469" :activity/scope {:db/id #edb/ref 17592186495275 :topic/id #uuid "04654553-f8da-5ec9-a27d-ee5bae447da5" :topic/math-academy-id 6818} :activity/steps [{:db/id #edb/ref 17592186540133 :step/content {:db/id #edb/ref 17592186540097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0889992d-3157-57fa-a016-613a47a3e111" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$40$ word" :db/id #edb/ref 17592186539493} {:answer/id #uuid "4006bf8e-d408-5915-8dae-5778affcbf40" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$16$ words" :db/id #edb/ref 17592186539595} {:answer/id #uuid "493744f2-c626-56a3-8d5a-5b93b57f4207" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ words" :db/id #edb/ref 17592186539611} {:answer/id #uuid "6f64e556-b780-5f32-80a5-22ca75df18a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$20$ words" :db/id #edb/ref 17592186539667} {:answer/id #uuid "8633dbcf-f937-517b-8467-a84b85c9b404" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$25$ words" :db/id #edb/ref 17592186539701}] :answer-field/correct {:db/id #edb/ref 17592186539701} :answer-field/id #uuid "c63c13a8-c976-5993-9a85-24d526e9a808" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539995}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d5b928b2-4413-5ea5-b176-1122913e3fcf" :question/math-academy-id "q-68936" :question/problem "Nathan, a freelance journalist, charges $$0.04$ per word for his financial articles. How many words would it take for him to earn $1$ dollar?" :question/worked-solution "We are given the unit rate of $$0.04$ per word (dollars per word). To find how many words  it would take for him to earn $1$ dollar we need to find the unit rate in words per dollar. So, we take the reciprocal: \n\n$$\n0.04\\,\\text{dollars per word}\\,\\to \\,1÷0.04=25\\,\\text{words per dollar}\n$$\n\nSo, the unit rate is $25$ words per dollar. Therefore, Nathan writes $25$ words for $1$ dollar."} :step/id #uuid "3eca2d72-851f-5a73-aa92-3e09e338e658" :step/next {:db/id #edb/ref 17592186540148}} {:db/id #edb/ref 17592186540148 :step/content {:db/id #edb/ref 17592186540041 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa21fd6-73dc-526d-b2f6-0d0e231b3737" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.210$ pounds" :db/id #edb/ref 17592186539500} {:answer/id #uuid "11b49a80-db54-5c03-9923-d5fd10202f00" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.250$ pound" :db/id #edb/ref 17592186539512} {:answer/id #uuid "c3b1fbe7-7cdb-5ed8-99ad-2b8326100b37" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.125$ pounds" :db/id #edb/ref 17592186539816} {:answer/id #uuid "f1bc5b75-3d67-5312-97d9-c7ca2541778d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.150$ pounds" :db/id #edb/ref 17592186539885} {:answer/id #uuid "f23d6a4a-93cb-5a5d-b401-e3ef6ebf81f0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$0.075$ pounds" :db/id #edb/ref 17592186539887}] :answer-field/correct {:db/id #edb/ref 17592186539816} :answer-field/id #uuid "43ec9212-fe0d-5e1f-88ef-a1c8f1359e51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539950}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "344d25f1-e189-5dcd-8b33-971f6adcaf13" :question/math-academy-id "q-91920" :question/problem "Louis visits a snack shop, the unit price for nuts is $$8$ per pound. How many pounds of nuts can Louis buy for $$1?$" :question/worked-solution "We are given the unit rate of $$8$ per pound (dollars per pound). To find how many pounds of nuts she can buy for  $$1,$ we need to find the unit rate in pounds per dollar. So, we take the reciprocal: \n\n$$\n8\\,\\text{dollars per pound}\\,\\to \\,1÷8=0.125\\,\\text{pounds per dollar}\n$$\n\nSo, the unit rate is $0.125$ pounds per dollar. Therefore, Louis can buy $0.125$ pounds of nuts for $1$ dollar."} :step/id #uuid "6b4a79e8-7a10-5f26-950c-8e9558fcb447" :step/next {:db/id #edb/ref 17592186540157}} {:db/id #edb/ref 17592186540157 :step/content {:db/id #edb/ref 17592186540040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c61f091-e167-5937-801b-0a7747aff68e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10.5$ feet" :db/id #edb/ref 17592186539661} {:answer/id #uuid "81fe3fe8-966b-5900-bd24-053d740450d0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10.9$ feet" :db/id #edb/ref 17592186539693} {:answer/id #uuid "89067390-efb6-59e2-8c55-037c26d4f5e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$11.4$ feet" :db/id #edb/ref 17592186539708} {:answer/id #uuid "99bc3ec8-85e0-5692-91ac-d80fbf737d04" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8.7$ feet" :db/id #edb/ref 17592186539735} {:answer/id #uuid "b3b53488-c4c3-5859-a2eb-1ecd284ac00a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$12.5$ feet" :db/id #edb/ref 17592186539788}] :answer-field/correct {:db/id #edb/ref 17592186539788} :answer-field/id #uuid "29c8db4b-ef49-5208-8e02-dc13afc8222c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539936}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "33438ac4-91a4-539b-acda-ce62d65ce1c2" :question/math-academy-id "q-91921" :question/problem "Anne needs to buy copper wire, the unit price for the copper wire is $$0.08$ per foot. How many feet of cooper wire can Anne buy with $$1?$" :question/worked-solution "We are given the unit rate of $$0.08$ per foot (dollars per foot). To find the amount of copper wire that Anne can buy for $$1,$ we need to find the unit rate in feet per dollar. So, we take the reciprocal:\n\n$$\n0.08\\,\\text{dollars per foot}\\,\\to \\,1÷0.08=12.5\\,\\text{feet per dollar}\n$$\n\nSo, the unit rate is $12.5$ feet per dollar. Therefore, Anne can buy $12.5$ feet of copper wire."} :step/id #uuid "90dc62fe-8bb8-5997-9faa-e8e4bf923cfc" :step/next {:db/id #edb/ref 17592186540158}} {:db/id #edb/ref 17592186540158 :step/content {:db/id #edb/ref 17592186540029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58c57aa2-ab46-5c5d-a839-1a086731c9b5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186539630} {:answer/id #uuid "7938de04-9ab1-545b-b93d-28f4cff6244d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$C$ only" :db/id #edb/ref 17592186539681} {:answer/id #uuid "b5be8feb-c51f-5121-b18f-aa4666bb0fc4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$B$ only" :db/id #edb/ref 17592186539794} {:answer/id #uuid "be1d4c88-bd15-57f9-a145-2c672f0f54e8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186539809} {:answer/id #uuid "efeb7370-08e1-5875-a29a-51457be79925" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ only" :db/id #edb/ref 17592186539882}] :answer-field/correct {:db/id #edb/ref 17592186539809} :answer-field/id #uuid "eb5fb4d1-8797-514f-9134-467a95794481" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540010}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1ced6944-9e50-5164-8d33-69e2545adde3" :question/math-academy-id "q-355015" :question/problem "John wonders what bottle of juice to buy from three different types available at the convenience store:\n\n- Bottle $A$ contains $20$ ounces, and costs $$3.00\\,.$\n\n- Bottle $B$ contains $32$ ounces, and costs $$4.80\\,.$\n\n- Bottle $C$ contains $10$ ounces, and costs $$1.80\\,.$\n\nWhich bottle of juice is the best deal?" :question/worked-solution "The best deal is the one with the lowest unit price. So, we need to compute the unit prices for all three bottles. To compute the unit price, we divide the cost by the total number of ounces.\n\n- Dividing the total cost by the number of ounces in bottle $A$,  we get\n\n$$\n3.00÷20=0.15\\,.\n$$\n\nSo, the unit price of bottle $A$ is $$0.15$  per ounce.\n\n- Dividing the total cost by the number of ounces in bottle $B$,  we get\n\n$$\n4.80÷32=0.15\\,.\n$$\n\nSo, the unit price of bottle $B$ is $$0.15$  per ounce.\n\n- Dividing the total cost by the number of ounces in bottle $C$,  we get\n\n$$\n1.80÷10=0.18\\,.\n$$\n\nSo, the unit price of bottle $C$ is $$0.18$  per ounce.\n\nFrom the above, we see that bottles $A$ and $B$ have the lowest unit price. Therefore, bottles $A$ and $B$ are the best deal."} :step/id #uuid "9549a907-8026-59cc-92ea-59c1ebc3209a"} {:db/id #edb/ref 17592186540168 :step/content {:db/id #edb/ref 17592186540096 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05de32c3-68cd-56f4-805b-b87c3fa65534" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186539489} {:answer/id #uuid "093acaf7-e084-5171-b05c-2abfb2565913" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186539496} {:answer/id #uuid "2530f346-332f-5442-ab0f-89084d832824" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$B$ only" :db/id #edb/ref 17592186539551} {:answer/id #uuid "b2001ae7-2e08-52d6-89a9-f372a3e6c52d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186539784} {:answer/id #uuid "c54814ec-8175-53f6-8edc-9fc045e757b3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$A$  only" :db/id #edb/ref 17592186539818}] :answer-field/correct {:db/id #edb/ref 17592186539489} :answer-field/id #uuid "3a5096d0-40bb-5c75-b8cd-0eaec3bf79bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539944}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cae6f157-aca0-5d45-812b-7c9eb68fbca5" :question/math-academy-id "q-68910" :question/problem "In a store, there are three different types of cream cheese that come in boxes: \n\n- Box $A$ contains $1$ cup and costs $$1.96\\,.$\n\n- Box $B$ contains $1.2$ cups and costs $$2.40\\,.$\n\n- Box $C$ contains $1.5$ cups and costs $$2.94\\,.$\n\nWhich box of cream cheese is the best deal?" :question/worked-solution "The best deal is the one with the lowest unit price. So, we need to compute the unit prices for all three boxes. To compute the unit price, we divide the price by the total number of cups.   \n\n- Dividing the total cost by the number of cups in box $A,$ we get\n\n$$\n1.96÷1=1.96\\,.\n$$\n\nSo, the unit price of box $A$ is $$1.96.$\n\n- Dividing the total cost by the number of cups in box $B,$ we get\n\n$$\n2.40÷1.2=2\\,.\n$$\n\nSo, the unit price of box $B$ is $$2.00.$\n\n- Dividing the total cost by the number of cups in box $C,$ we get\n\n$$\n2.94÷1.5=1.96\\,.\n$$\n\nSo, the unit price of box $C$ is $$1.96$  too.\n\nFrom the above, we see that boxes $A$ and $C$  have the lowest unit price. Therefore, boxes $A$ and  $C$ are the best deal."} :step/id #uuid "d0db0307-cde5-5e6f-b088-4df904b5991b" :step/next {:db/id #edb/ref 17592186540133}}] :activity/title "Working With Unit Prices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186539466}]}
