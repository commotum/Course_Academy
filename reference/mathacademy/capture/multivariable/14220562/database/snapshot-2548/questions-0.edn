#{[{:db/id #edb/ref 17592186250317 :knowledge-point/_questions [{:db/id #edb/ref 17592186064244 :knowledge-point/id #uuid "a7d71bc2-c0f0-5504-9f79-a5f5cdb8cd92" :knowledge-point/title "Integrating a Rational Function Whose Denominator Contains a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9826cc-221a-58f0-a949-003259d10830" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{36}(1+2\\operatorname{ln}⁡3)" :db/id #edb/ref 17592186247516} {:answer/id #uuid "1935d4e4-d30d-5335-ab50-3b3fa04366e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}(1+5\\operatorname{ln}⁡2)" :db/id #edb/ref 17592186247651} {:answer/id #uuid "3c9aeadf-fded-5a2b-861d-58af4c73c465" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{25}(5+\\operatorname{ln}⁡5)" :db/id #edb/ref 17592186247959} {:answer/id #uuid "54ac800d-c455-530d-b963-3aea2be7c145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}(3+\\operatorname{ln}⁡3)" :db/id #edb/ref 17592186248185} {:answer/id #uuid "6b902fe9-3b07-57e2-870c-2a793e643e2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{36}(1+4\\operatorname{ln}⁡2)" :db/id #edb/ref 17592186248379}] :answer-field/correct {:answer/id #uuid "6b902fe9-3b07-57e2-870c-2a793e643e2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{36}(1+4\\operatorname{ln}⁡2)" :db/id #edb/ref 17592186248379} :answer-field/id #uuid "a3226bde-c895-54e8-98cf-b5b2df79f6fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249958}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "462b058c-0216-5b9a-aa39-6bb6d7bc768e" :question/math-academy-id "q-114896" :question/problem "${\\int }_{-1/12}^{0}\\frac{2x+1}{6x+1}\\,\\text{d}x=$" :question/worked-solution "First, we pull out the factor of $6$ from the denominator:\n\n$$\n\\begin{aligned}{\\int }_{-1/12}^{0}\\frac{2x+1}{6x+1}\\,\\text{d}x & ={\\int }_{-1/12}^{0}\\frac{2x+1}{6(x+\\frac{1}{6})}\\,\\text{d}x \\\\  & =\\frac{1}{6}{\\int }_{-1/12}^{0}\\frac{2x+1}{(x+\\frac{1}{6})}\\,\\text{d}x.\\end{aligned}\n$$\n\nThen, we draw up our synthetic division table to decompose the integrand into its quotient and remainder.\n\n$$\n\\begin{aligned} & x & {x}^{0} \\\\ -\\frac{1}{6} & 2 & 1 \\\\  & ↓ & -\\frac{1}{3} \\\\  & 2 & \\frac{2}{3}\\end{aligned}\n$$\n\nSo from the synthetic division, we get that\n\n$$\n\\begin{aligned}\\frac{2x+1}{(x+\\frac{1}{6})} & =2+\\frac{(\\frac{2}{3})}{(x+\\frac{1}{6})} \\\\  & =2+\\frac{4}{6x+1}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-1/12}^{0}\\frac{2x+1}{6x+1}\\,\\text{d}x & =\\frac{1}{6}{\\int }_{-1/12}^{0}(2+\\frac{4}{6x+1})\\text{d}x \\\\  & =\\frac{1}{6}[2{\\int }_{-1/12}^{0}\\text{d}x+4{\\int }_{-1/12}^{0}\\frac{1}{6x+1}\\,\\text{d}x] \\\\  & =\\frac{1}{6}{[2x+\\frac{4}{6}\\operatorname{ln}⁡|6x+1|]}_{-1/12}^{0} \\\\  & =\\frac{1}{6}{[2x+\\frac{2}{3}\\operatorname{ln}⁡|6x+1|]}_{-1/12}^{0} \\\\  & =\\frac{1}{6}[2(0-(-\\frac{1}{12}))+\\frac{2}{3}(\\operatorname{ln}⁡|6(0)+1|-\\operatorname{ln}⁡|6(-\\frac{1}{12})+1|)] \\\\  & =\\frac{1}{6}[2(\\frac{1}{12})+\\frac{2}{3}(\\operatorname{ln}⁡1-\\operatorname{ln}⁡(\\frac{1}{2}))] \\\\  & =\\frac{1}{6}[\\frac{1}{6}+\\frac{2}{3}\\operatorname{ln}⁡2] \\\\  & =\\frac{1}{36}(1+4\\operatorname{ln}⁡2).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320966 :knowledge-point/_questions [{:db/id #edb/ref 17592186064236 :knowledge-point/id #uuid "f110daa3-fd31-5e34-8a88-0e002c2e418a" :knowledge-point/title "Integrating a Rational Function Whose Denominator is Linear"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd85c349-b07a-5ce7-acbe-71dec6f51725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186320020}] :answer-field/correct {:answer/id #uuid "cd85c349-b07a-5ce7-acbe-71dec6f51725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186320020} :answer-field/id #uuid "8e1395fe-90e5-58b0-b928-c57e2255472b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320455}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "42ce6d45-7dcd-53d8-be85-5db5b0c5d792" :question/math-academy-id "q-352247" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{2}\\frac{3{x}^{3}-7{x}^{2}+5x-1}{x-1}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We first need to decompose the integrand into its quotient and remainder parts, which we can do using synthetic division.\n\nWe draw up a synthetic division table:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $1$ | $3$ | $-7$ | $5$ | $-1$ |\n|  | $↓$ | $3$ | $-4$ | $1$ |\n|  | $3$ | $-4$ | $1$ | $0$ |\n\nSo from the synthetic division, we get that\n\n$$\n\\frac{3{x}^{3}-7{x}^{2}+5x-1}{x-1}=3{x}^{2}-4x+1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{3{x}^{3}-7{x}^{2}+5x-1}{x-1}\\,\\text{d}x & ={\\int }_{1}^{2}(3{x}^{2}-4x+1)\\text{d}x \\\\  & =3{\\int }_{1}^{2}{x}^{2}\\,\\text{d}x-4{\\int }_{1}^{2}x\\,\\text{d}x+{\\int }_{1}^{2}\\,\\text{d}x \\\\  & =3\\cdot \\frac{1}{3}{x}^{3}{|}_{1}^{2}-4\\cdot \\frac{1}{2}{x}^{2}{|}_{1}^{2}+x{|}_{1}^{2} \\\\  & ={x}^{3}{|}_{1}^{2}-2{x}^{2}{|}_{1}^{2}+x{|}_{1}^{2} \\\\  & =[{2}^{3}-{1}^{3}]-2[{2}^{2}-{1}^{2}]+[2-1] \\\\  & =7\\cdot 1-2(3)+1 \\\\  & =7-6+1 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064865 :knowledge-point/_questions [{:db/id #edb/ref 17592186064236 :knowledge-point/id #uuid "f110daa3-fd31-5e34-8a88-0e002c2e418a" :knowledge-point/title "Integrating a Rational Function Whose Denominator is Linear"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42e6b1e1-c481-5131-aa9b-e51fd0e84f3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-4x+\\operatorname{ln}⁡|x-4|+C" :db/id #edb/ref 17592186488608} {:answer/id #uuid "4a697176-e9f1-5136-bc2c-f4d7b21c4c5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-x+C" :db/id #edb/ref 17592186488616} {:answer/id #uuid "62d7902c-29ca-5bc3-8e15-8a29b24dccf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{x}^{2}-x-4\\operatorname{ln}⁡|x-4|+C" :db/id #edb/ref 17592186488659} {:answer/id #uuid "ba9d1eb3-ac76-5c9d-9822-7053bfb20d04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-6\\operatorname{ln}⁡|x-4|+C" :db/id #edb/ref 17592186488844} {:answer/id #uuid "e00dd37b-1e6f-5de4-8259-64c1940bd61a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-17x+C" :db/id #edb/ref 17592186488936}] :answer-field/correct {:answer/id #uuid "4a697176-e9f1-5136-bc2c-f4d7b21c4c5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-x+C" :db/id #edb/ref 17592186488616} :answer-field/id #uuid "943cb8b2-64c1-553e-80f2-f883b3ab8a15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063246}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ea9dfa89-06eb-5760-a821-cda00c20e204" :question/math-academy-id "q-49458" :question/problem "Calculate $\\int \\frac{4{x}^{2}-17x+4}{x-4}\\,\\text{d}x.$" :question/worked-solution "We first need to decompose the integrand into its quotient and remainder parts, which we can do using synthetic division.\n\nWe draw up a synthetic division table:\n\n|  | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- |\n| $4$ | $4$ | $-17$ | $4$ |\n|  | $↓$ | $16$ | $-4$ |\n|  | $4$ | $-1$ | $0$ |\n\nSo from the synthetic division, we get that\n\n$$\n\\frac{4{x}^{2}-17x+4}{x-4}=4x-1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{4{x}^{2}-17x+4}{x-4}\\,\\text{d}x & =\\int (4x-1)\\text{d}x \\\\  & =4\\int x\\,\\text{d}x-\\int \\text{d}x \\\\  & =4\\cdot \\frac{1}{2}{x}^{2}-x+C \\\\  & =2{x}^{2}-x+C.\\end{aligned}\n$$"}]}
