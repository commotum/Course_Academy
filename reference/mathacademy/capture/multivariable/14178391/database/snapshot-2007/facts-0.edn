d-1" #edb/ref 17592186045417] [17592186494976 #edb/ref 1078 #edb/ref 17592186494695 #edb/ref 17592186045417] [17592186494976 #edb/ref 1079 #uuid "7f5cfcb1-f43f-54aa-937a-52c96207e17b" #edb/ref 17592186045417] [17592186494982 #edb/ref 1075 #edb/ref 17592186494771 #edb/ref 17592186045417] [17592186494982 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186494982 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186494982 #edb/ref 1078 #edb/ref 17592186494771 #edb/ref 17592186045417] [17592186494982 #edb/ref 1079 #uuid "8e66a9d5-c3d1-5ab6-8270-3abb2df59cb7" #edb/ref 17592186045417] [17592186495074 #edb/ref 1068 #edb/ref 17592186494982 #edb/ref 17592186045417] [17592186495074 #edb/ref 1069 "q-335068" #edb/ref 17592186045417] [17592186495074 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186495074 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=7y(t)+7 \\\\ {y}^{′}(t)=-7x(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(7t) & \\operatorname{sin}⁡(7t) \\\\ -\\operatorname{sin}⁡(7t) & \\operatorname{cos}⁡(7t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 7 \\\\ -7 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"120px\">$2\\operatorname{sin}⁡(7t)$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186495074 #edb/ref 1072 #uuid "30dbc074-1ece-5bdf-8ee0-957449e10161" #edb/ref 17592186045417] [17592186495074 #edb/ref 1074 "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 7 \\\\ -7 & 0\\end{aligned}]x(t)+g(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $g(t)=[\\begin{aligned}7 \\\\ 0\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 7 \\\\ -7 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(7t) & \\operatorname{sin}⁡(7t) \\\\ -\\operatorname{sin}⁡(7t) & \\operatorname{cos}⁡(7t)\\end{aligned}].\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(7t) & \\operatorname{sin}⁡(7t) \\\\ -\\operatorname{sin}⁡(7t) & \\operatorname{cos}⁡(7t)\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡(7t) \\\\ \\operatorname{cos}⁡(7t)\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cos}⁡(7(t-s)) & \\operatorname{sin}⁡(7(t-s)) \\\\ -\\operatorname{sin}⁡(7(t-s)) & \\operatorname{cos}⁡(7(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cos}⁡(7(t-s)) & \\operatorname{sin}⁡(7(t-s)) \\\\ -\\operatorname{sin}⁡(7(t-s)) & \\operatorname{cos}⁡(7(t-s))\\end{aligned}][\\begin{aligned}7 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}7\\operatorname{cos}⁡(7(t-s)) \\\\ -7\\operatorname{sin}⁡(7(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}7\\operatorname{cos}⁡(7(t-s)) \\\\ -7\\operatorname{sin}⁡(7(t-s))\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}-\\operatorname{sin}⁡(7(t-s)) \\\\ -\\operatorname{cos}⁡(7(t-s))\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡(7t) \\\\ \\operatorname{cos}⁡(7t)-1\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}\\operatorname{sin}⁡(7t) \\\\ \\operatorname{cos}⁡(7t)\\end{aligned}]+[\\begin{aligned}\\operatorname{sin}⁡(7t) \\\\ \\operatorname{cos}⁡(7t)-1\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{sin}⁡(7t) \\\\ 2\\operatorname{cos}⁡(7t)-1\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186495161 #edb/ref 1068 #edb/ref 17592186494976 #edb/ref 17592186045417] [17592186495161 #edb/ref 1069 "q-335166" #edb/ref 17592186045417] [17592186495161 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186495161 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=4y(t) \\\\ {y}^{′}(t)=4x(t)+4,\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 4 \\\\ 4 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\operatorname{sinh}⁡(4t)$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186495161 #edb/ref 1072 #uuid "e9f770d5-4f03-58ec-b9ae-bcbaf7705c59" #edb/ref 17592186045417] [17592186495161 #edb/ref 1074 "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 4 \\\\ 4 & 0\\end{aligned}]x(t)+g(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $g(t)=[\\begin{aligned}0 \\\\ 4\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 4 \\\\ 4 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{aligned}].\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{aligned}][\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cosh}⁡(4(t-s)) & \\operatorname{sinh}⁡(4(t-s)) \\\\ \\operatorname{sinh}⁡(4(t-s)) & \\operatorname{cosh}⁡(4(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cosh}⁡(4(t-s)) & \\operatorname{sinh}⁡(4(t-s)) \\\\ \\operatorname{sinh}⁡(4(t-s)) & \\operatorname{cosh}⁡(4(t-s))\\end{aligned}][\\begin{aligned}0 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}4\\operatorname{sinh}⁡(4(t-s)) \\\\ 4\\operatorname{cosh}⁡(4(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}4\\operatorname{sinh}⁡(4(t-s)) \\\\ 4\\operatorname{cosh}⁡(4(t-s))\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}-\\operatorname{cosh}⁡(4(t-s)) \\\\ -\\operatorname{sinh}⁡(4(t-s))\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(4t)-1 \\\\ \\operatorname{sinh}⁡(4t)\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]+[\\begin{aligned}\\operatorname{cosh}⁡(4t)-1 \\\\ \\operatorname{sinh}⁡(4t)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(4t)-1 \\\\ \\operatorname{sinh}⁡(4t)\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186495181 #edb/ref 1058 #edb/ref 17592186495188 #edb/ref 17592186045417] [17592186495181 #edb/ref 1062 #uuid "06d91f07-0fea-5beb-aa8a-cd77b3e6a896" #edb/ref 17592186045417] [17592186495181 #edb/ref 1063 #edb/ref 17592186495161 #edb/ref 17592186045417] [17592186495188 #edb/ref 1058 #edb/ref 17592186495250 #edb/ref 17592186045417] [17592186495188 #edb/ref 1062 #uuid "2231ccca-1dd5-57de-b365-dbd0a5f43637" #edb/ref 17592186045417] [17592186495188 #edb/ref 1063 #edb/ref 17592186396735 #edb/ref 17592186045417] [17592186495193 #edb/ref 1058 #edb/ref 17592186495196 #edb/ref 17592186045417] [17592186495193 #edb/ref 1062 #uuid "2a864f75-78c7-5949-a06f-5424af17ac17" #edb/ref 17592186045417] [17592186495193 #edb/ref 1063 #edb/ref 17592186308718 #edb/ref 17592186045417] [17592186495196 #edb/ref 1058 #edb/ref 17592186495181 #edb/ref 17592186045417] [17592186495196 #edb/ref 1062 #uuid "2fbeaf38-2336-5aee-bfc1-de7e502565a2" #edb/ref 175921860454