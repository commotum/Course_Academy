e \\theta \\le \\frac{\\pi }{2}.$\n\nNow, since $f(x,y)=x{e}^{y}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =3\\operatorname{cos}⁡\\theta \\,{e}^{3\\operatorname{sin}⁡\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(3)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{3}^{2}+{0}^{2}} \\\\  & =3.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{e}^{y}\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta \\,{e}^{3\\operatorname{sin}⁡\\theta }\\cdot 3\\cdot \\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta \\,{e}^{3\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=3\\operatorname{sin}⁡\\theta ,$ $\\text{d}u=3\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}3{\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta \\,{e}^{3\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  & =3{\\int }_{0}^{3}{e}^{u}\\,\\text{d}u \\\\  & =3{e}^{u}{|}_{0}^{3} \\\\  & =3({e}^{3}-{e}^{0}) \\\\  & =3({e}^{3}-1)\\end{aligned}\n$$"} :step/id #uuid "a457e0db-1973-5b6b-8d71-9a6a062a4f73" :step/next {:db/id #edb/ref 17592186531725}} {:db/id #edb/ref 17592186531725 :step/content {:db/id #edb/ref 17592186455508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "082112eb-8a26-5265-b137-26bd8c295b06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }{sin}^{3}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186454924} {:answer/id #uuid "0ae41ca2-e608-5696-b440-d41c065df75e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186454928} {:answer/id #uuid "5cbc00c8-62ae-5a6f-8037-f55f4dd09a38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186455070} {:answer/id #uuid "76d63731-dd9b-510e-8131-e402a45ba6a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }\\operatorname{cos}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186455120} {:answer/id #uuid "de572935-367e-52cb-8f52-f59649494fbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186455287}] :answer-field/correct {:db/id #edb/ref 17592186455070} :answer-field/id #uuid "436cc0aa-bff3-5b92-a639-ba2e62b0da93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455360}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ee634955-812e-57a4-9691-da172190ae0a" :question/math-academy-id "q-76611" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}(x+y)^{2}\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=\\operatorname{cos}⁡\\theta \\,$ for $0\\le \\theta \\le \\pi ?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x={cos}^{2}⁡\\theta $ and $y=\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\pi .$\n\nNow, if $f(x,y)=(x+y)^{2}$, we obtain  \n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={({cos}^{2}⁡\\theta +\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta )}^{2} \\\\  & ={(\\operatorname{cos}⁡\\theta (\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ))}^{2} \\\\  & ={cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}.\\end{aligned}\n$$\n\n \n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta )=-\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{cos}⁡\\theta )}^{2}+{(-\\operatorname{sin}⁡\\theta )}^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta } \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)^{2}\\,\\text{d}s & ={\\int }_{0}^{\\pi }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "eb57df81-a928-539a-b8d1-a80b4295d9a1" :step/next {:db/id #edb/ref 17592186531699}}] :activity/title "Line Integrals of Scalar Functions Over Polar Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186530857}] [{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186539100} :activity/id #uuid "343fca05-ef20-5032-a174-293eb482d135" :activity/scope {:db/id #edb/ref 17592186048694 :topic/id #uuid "b52b86c6-5073-5d60-a17c-32a308489156" :topic/math-academy-id 2638} :activity/steps [{:db/id #edb/ref 17592186539032 :step/content {:db/id #edb/ref 17592186483379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04d839b3-7560-5512-ab94-65b25afb8af3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32{\\int }_{0}^{\\pi /4}{(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186482817} {:answer/id #uuid "0bd0b7d8-497a-5308-9309-036b9effbae0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{0}^{\\pi /4}(\\operatorname{sin}⁡\\theta +{cos}^{2}⁡\\theta )\\text{d}\\theta " :db/id #edb/ref 17592186482828} {:answer/id #uuid "11be0602-805c-5751-80e1-20619f10d315" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{\\int }_{0}^{\\pi /4}{sin}^{2}⁡\\theta {cos}^{4}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186482841} {:answer/id #uuid "1663c28c-4cc3-57a0-901a-0782cd1f5920" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186482854} {:answer/id #uuid "e62cdbaf-ad20-51f2-b72a-b2f5ab5a24eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{\\int }_{0}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186483200}] :answer-field/correct {:db/id #edb/ref 17592186482854} :answer-field/id #uuid "63f7e3dc-e6fb-53cc-b486-dbf54e61e1b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186483273}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "80893bd5-f8f9-5d69-b7d0-36e40ddfd184" :question/math-academy-id "q-76572" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}x{y}^{2}\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=2$ for $0\\le \\theta \\le \\frac{\\pi }{4}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{cos}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)=x{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2\\operatorname{cos}⁡\\theta \\cdot (2\\operatorname{sin}⁡\\theta )^{2} \\\\  & =8\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(2)^{2}+{0}^{2}} \\\\  & =2.\\end{aligned}\n$$\n\n \n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{y}^{2}\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}8\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\cdot 2\\cdot \\text{d}\\theta  \\\\  & =16{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "03a6d759-775d-52bf-9cdd-3d6f87176b4d" :step/next {:db/id #edb/ref 17592186539110}} {:db/id #edb/ref 17592186539062 :step/content {:db/id #edb/ref 17592186152743 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c31779c1-61a9-5ddf-9ce4-388acac151e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393613} {:answer/id #uuid "b35b8c73-b6e1-55f6-a3a8-1f84f618409d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393614} {:answer/id #uuid "d14288db-cd96-5f69-9f29-fa682d61a4a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{-\\pi /4}^{\\pi /4}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393615} {:answer/id #uuid "f83c51d2-6855-5059-8910-c179f8d7f6c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393616} {:answer/id #uuid "865a2778-efa4-5860-8c94-4fab14e1e597" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393617}] :answer-field/correct {:db/id #edb/ref 17592186393614} :answer-field/id #uuid "8116cea9-3c1b-5e81-a58c-b2147c4e208d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393612}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fda4f6af-c917-5961-9062-323f1cdf3aeb" :question/math-academy-id "q-76355" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}{x}^{2}y\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=\\sqrt{2}$ for $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\sqrt{2}\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\sqrt{2}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\sqrt{2}\\operatorname{cos}⁡\\theta $ and $y=\\sqrt{2}\\operatorname{sin}⁡\\theta $, where $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)={x}^{2}y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(\\sqrt{2}\\operatorname{cos}⁡\\theta )^{2}\\cdot \\sqrt{2}\\operatorname{sin}⁡\\theta  \\\\  & =2\\sqrt{2}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt{2})=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\sqrt{2})^{2}+{0}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}y\\,\\text{d}s & ={\\int }_{-\\pi /4}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}2\\sqrt{2}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\cdot \\sqrt{2}\\cdot \\text{d}\\theta  \\\\  & =4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "56b6eb2f-f882-5b90-8451-f36f99d1a425" :step/next {:db/id #edb/ref 17592186539032}} {:db/id #edb/ref 17592186539079 :step/content {:db/id #edb/ref 17592186284545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab50b4da-933b-580c-90e3-d57fe918ca3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /4}^{-\\pi /8}\\operatorname{sin}⁡\\theta \\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283174} {:answer/id #uuid "e0621d5d-1546-515b-b160-26c36601cee5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /4}^{-\\pi /8}\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283647} {:answer/id #uuid "eac1d727-6b15-5ede-a524-9f9b5cca59df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /4}^{-\\pi /8}{cos}^{2}⁡\\theta \\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283741} {:answer/id #uuid "f038538b-7314-51bc-a23b-a2dc236cb725" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /4}^{-\\pi /8}{sin}^{2}⁡\\theta \\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283787} {:answer/id #uuid "f848449c-f299-591e-af24-cf140841f848" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /4}^{-\\pi /8}\\operatorname{cos}⁡\\theta \\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283860}] :answer-field/correct {:db/id #edb/ref 17592186283647} :answer-field/id #uuid "f1857575-157f-5eb5-ba46-57df0567255a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284364}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e623a86a-8a2d-5ca1-949a-2b47126336d8" :question/math-academy-id "q-165414" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}\\frac{{y}^{4}}{{x}^{2}}\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=\\operatorname{cot}⁡\\theta \\,$ for $-\\frac{\\pi }{4}\\le \\theta \\le -\\frac{\\pi }{8}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cot}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cot}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }$ and $y=\\operatorname{cos}⁡\\theta $, where $-\\frac{\\pi }{4}\\le \\theta \\le -\\frac{\\pi }{8}.$\n\nNow, if $f(x,y)=\\frac{{y}^{4}}{{x}^{2}}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\frac{{cos}^{4}⁡\\theta }{{(\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta })}^{2}} \\\\  & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cot}⁡\\theta )=-\\frac{1}{{sin}^{2}⁡\\theta },\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{cot}⁡\\theta )}^{2}+{(-\\frac{1}{{sin}^{2}⁡\\theta })}^{2}} \\\\  & =\\sqrt{\\frac{{cos}^{2}⁡\\theta }{{sin}^{2}⁡\\theta }+\\frac{1}{{sin}^{4}⁡\\theta }} \\\\  & =\\sqrt{\\frac{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}{{sin}^{4}⁡\\theta }} \\\\  & =\\frac{\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}}{{sin}^{2}⁡\\theta }.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{{y}^{4}}{{x}^{2}}\\,\\text{d}s & ={\\int }_{-\\pi /4}^{-\\pi /8}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{-\\pi /8}{sin}^{2}⁡\\theta \\cdot \\frac{\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}}{{sin}^{2}⁡\\theta }\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{-\\pi /8}\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "8db4ff3c-fb25-5ac9-a56d-8b7415b7e2ed"} {:db/id #edb/ref 17592186539100 :step/content {:db/id #edb/ref 17592186152740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d386b2-29ca-55a0-a4f9-2285709e1710" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186342276} {:answer/id #uuid "0724c421-8073-517d-93f3-1620e786e609" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186342301} {:answer/id #uuid "39b44baa-ac93-5399-be44-580cc1caf867" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186342714} {:answer/id #uuid "5e406d1b-7ff9-563d-ad72-bf188c813dbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186343029} {:answer/id #uuid "e4798884-9668-5922-995d-443c2be3e374" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{\\int }_{0}^{\\pi }\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186344244}] :answer-field/correct {:db/id #edb/ref 17592186342301} :answer-field/id #uuid "27ab5eb9-1fc8-5190-8bd2-5881ace73b08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344564}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aefe264e-7dab-56be-82be-12f2dc01af9b" :question/math-academy-id "q-76345" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}({x}^{2}+{y}^{2})\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=2\\operatorname{sin}⁡\\theta \\,$ for $0\\le \\theta \\le \\pi ?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =2{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y=2{sin}^{2}⁡\\theta $, where $0\\le \\theta \\le \\pi .$\n\nNow, if $f(x,y)={x}^{2}+{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={(2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )}^{2}+{(2{sin}^{2}⁡\\theta )}^{2} \\\\  & =4{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +4{sin}^{4}⁡\\theta  \\\\  & =4{sin}^{2}⁡\\theta ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =4{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2\\operatorname{sin}⁡\\theta )=2\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(2\\operatorname{sin}⁡\\theta )}^{2}+{(2\\operatorname{cos}⁡\\theta )}^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡\\theta +4{cos}^{2}⁡\\theta } \\\\  & =\\sqrt{4({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )} \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}+{y}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }4{sin}^{2}⁡\\theta \\cdot 2\\cdot \\text{d}\\theta  \\\\  & =8{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "cff504a2-c9ea-54e0-9986-3bc79b8ba652" :step/next {:db/id #edb/ref 17592186539062}} {:db/id #edb/ref 17592186539110 :step/content {:db/id #edb/ref 17592186497344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28f03a0e-89a7-5b16-bf01-1519355c07d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /8}{cos}^{2}⁡\\theta {sin}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186496747} {:answer/id #uuid "3a018c22-1a77-5e85-97e0-1ac9d6577bec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\int }_{0}^{\\pi /8}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186496784} {:answer/id #uuid "97cbc095-95df-53b0-aeb5-aa994a815950" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /8}{cos}^{3}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186496976} {:answer/id #uuid "dc6f0f30-494e-5978-8c42-1f9efcb271d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{0}^{\\pi /8}{cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186497127} {:answer/id #uuid "fb5a577e-b9f2-5c3c-87c6-fb5029ee12ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{0}^{\\pi /8}{sin}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186497197}] :answer-field/correct {:db/id #edb/ref 17592186496976} :answer-field/id #uuid "3cf0e6db-e5f4-547e-8dad-d9a52bf566a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186497243}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "284c9b33-1577-5c49-9cce-c96ae365ec69" :question/math-academy-id "q-76608" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}x(1-{y}^{2})\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=1\\,$ for $0\\le \\theta \\le \\frac{\\pi }{8}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =1\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =1\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta $ and $y=\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{8}.$\n\nNow, if $f(x,y)=x(1-{y}^{2})$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\operatorname{cos}⁡\\theta (1-{sin}^{2}⁡\\theta ) \\\\  & =\\operatorname{cos}⁡\\theta \\cdot {cos}^{2}⁡\\theta  \\\\  & ={cos}^{3}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(1)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{1}^{2}+{0}^{2}} \\\\  & =\\sqrt{1+0} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x(1-{y}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi /8}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /8}{cos}^{3}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /8}{cos}^{3}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "e6a58846-3aca-5935-a953-b68daf8654c7" :step/next {:db/id #edb/ref 17592186539079}}] :activity/title "Line Integrals of Scalar Functions Over Polar Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186538220}] [{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186548103} :activity/id #uuid "8f3ab43f-9a2a-52cf-8072-18ee6e695302" :activity/scope {:db/id #edb/ref 17592186048694 :topic/id #uuid "b52b86c6-5073-5d60-a17c-32a308489156" :topic/math-academy-id 2638} :activity/steps [{:db/id #edb/ref 17592186548103 :step/content {:db/id #edb/ref 17592186345237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12b1571f-f5f7-562d-80a0-607aa3516530" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /2}2{sin}^{3}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186342403} {:answer/id #uuid "4c9c1e54-997f-58a0-bd84-3b903059ab31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta (3-{cos}^{6}⁡\\theta )\\text{d}\\theta " :db/id #edb/ref 17592186342870} {:answer/id #uuid "7da69662-1fe5-58e3-b0c0-5897eb5c94d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /2}{sin}^{2}⁡\\theta (1-3{sin}^{2}⁡\\theta )\\text{d}\\theta " :db/id #edb/ref 17592186343322} {:answer/id #uuid "cfd26a22-60c5-5518-ab97-c388fe07fef6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta (1-\\operatorname{sin}⁡\\theta )\\text{d}\\theta " :db/id #edb/ref 17592186344065} {:answer/id #uuid "d1097377-be4e-5b0d-8118-afb24f1f0f9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /2}{sin}^{2}⁡\\theta (1-{cos}^{2}⁡\\theta )\\text{d}\\theta " :db/id #edb/ref 17592186344076}] :answer-field/correct {:db/id #edb/ref 17592186343322} :answer-field/id #uuid "2d5e348e-6403-58e5-a33c-30c8b85d2e1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344570}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d123bbf4-7b8c-5b08-b206-9ffde691a39b" :question/math-academy-id "q-76610" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}({x}^{2}-2{y}^{2})\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=\\operatorname{sin}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{2}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y={sin}^{2}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)={x}^{2}-2{y}^{2}$, we obtain  \n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={(\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )}^{2}-2{({sin}^{2}⁡\\theta )}^{2} \\\\  & ={sin}^{2}⁡\\theta {cos}^{2}⁡\\theta -2{sin}^{4}⁡\\theta  \\\\  & ={sin}^{2}⁡\\theta \\,({cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta ) \\\\  & ={sin}^{2}⁡\\theta \\,(1-{sin}^{2}⁡\\theta -2{sin}^{2}⁡\\theta ) \\\\  & ={sin}^{2}⁡\\theta \\,(1-3{sin}^{2}⁡\\theta ).\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{sin}⁡\\theta )=\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{sin}⁡\\theta )}^{2}+{(\\operatorname{cos}⁡\\theta )}^{2}} \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}-2{y}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{sin}^{2}⁡\\theta (1-3{sin}^{2}⁡\\theta )\\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{sin}^{2}⁡\\theta (1-3{sin}^{2}⁡\\theta )\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "4fb0570e-604f-5e03-b57b-2ef557a8e16c" :step/next {:db/id #edb/ref 17592186548133}} {:db/id #edb/ref 17592186548117 :step/content {:db/id #edb/ref 17592186455435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cb0f1f8-2c8c-587d-af87-78c647b1cad3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{2}-1" :db/id #edb/ref 17592186454969} {:answer/id #uuid "52950150-cf38-5785-b5c4-0a95b436b499" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2({e}^{2}-1)" :db/id #edb/ref 17592186455050} {:answer/id #uuid "84793b57-cdb0-527c-8f47-4fc489aedbaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2e({e}^{2}-1)" :db/id #edb/ref 17592186455140} {:answer/id #uuid "928594cf-1e82-52f9-95c7-79551dbc7ad9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2e({e}^{2}+1)" :db/id #edb/ref 17592186455169} {:answer/id #uuid "adebc696-6cad-5a00-9edf-015f1843d18f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2({e}^{2}+1)" :db/id #edb/ref 17592186455208}] :answer-field/correct {:db/id #edb/ref 17592186455140} :answer-field/id #uuid "61a3ae46-0e2c-5017-bfca-74625ceef8e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455366}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1b9e5c87-171d-5626-ae59-fa7b69d9a95a" :question/math-academy-id "q-76766" :question/problem "Evaluate the integral of the function $f(x,y)=x{e}^{y+1}$ along the polar curve $r=2$ for $0\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =2\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{cos}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, since $f(x,y)=x{e}^{y+1}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2\\operatorname{cos}⁡\\theta {e}^{2\\operatorname{sin}⁡\\theta +1}.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{2}^{2}+{0}^{2}} \\\\  & =2.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{e}^{y+1}\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡\\theta {e}^{2\\operatorname{sin}⁡\\theta +1}\\cdot 2\\cdot \\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡\\theta {e}^{2\\operatorname{sin}⁡\\theta +1}\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2\\operatorname{sin}⁡\\theta +1,$ $\\text{d}u=2\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}2{\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡\\theta {e}^{2\\operatorname{sin}⁡\\theta +1}\\,\\text{d}\\theta  & =2{\\int }_{1}^{3}{e}^{u}\\,\\text{d}u \\\\  & =2{e}^{u}{|}_{1}^{3} \\\\  & =2{e}^{3}-2e \\\\  & =2e({e}^{2}-1)\\end{aligned}\n$$"} :step/id #uuid "6b56d38e-560a-5855-970e-c59d2f999047" :step/next {:db/id #edb/ref 17592186548127}} {:db/id #edb/ref 17592186548127 :step/content {:db/id #edb/ref 17592186362989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3978ab12-c2c3-556b-8b3e-3e2439bb98af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186362991} {:answer/id #uuid "921abcc9-664f-5748-a32a-b8cb3a3a1679" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186362992} {:answer/id #uuid "55926885-53a5-5ed5-b872-7944d1c6177d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186362993} {:answer/id #uuid "87181d2e-ae8e-5568-bad0-b0d06ff451c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186362994} {:answer/id #uuid "70de9d14-e9f3-5545-9a7f-d37446be4ff0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186362995}] :answer-field/correct {:db/id #edb/ref 17592186362991} :answer-field/id #uuid "c54a12c4-ac53-57bf-ac59-6e5331dff070" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362990}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "05fbe250-8eb4-5b81-83cc-08a815c1aec0" :question/math-academy-id "q-123510" :question/problem "Evaluate the integral of the function $f(x,y)=x{y}^{2}$ along the polar curve $r=2$ for $0\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{cos}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, since $f(x,y)=x{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(2\\operatorname{cos}⁡\\theta )(2\\operatorname{sin}⁡\\theta )^{2} \\\\  & =8{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{2}^{2}+{0}^{2}} \\\\  & =2.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{y}^{2}\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}8{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 2\\,\\text{d}\\theta  \\\\  & =16{\\int }_{0}^{\\pi /2}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta \\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{sin}⁡\\theta ,$ $\\text{d}u=\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}16{\\int }_{0}^{\\pi /2}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  & =16{\\int }_{0}^{1}{u}^{2}\\,\\text{d}u \\\\  & =\\frac{16}{3}{u}^{3}\\,{|}_{0}^{1} \\\\  & =\\frac{16}{3}({1}^{3}-0) \\\\  & =\\frac{16}{3}\\end{aligned}\n$$"} :step/id #uuid "85c711d0-5b3c-52f0-81be-22f51de6f340"} {:db/id #edb/ref 17592186548133 :step/content {:db/id #edb/ref 17592186455445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "404520d3-d967-5b0b-9a92-89f881bf696e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186455012} {:answer/id #uuid "890fe5ec-8858-5534-8b26-e75adee4e582" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186455150} {:answer/id #uuid "90adc149-a9e2-5b9c-8313-fbc0425f524a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186455166} {:answer/id #uuid "e503b46f-e7bf-57d7-8559-2e0601cdad27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186455298} {:answer/id #uuid "ef25c8f6-c622-5edf-b418-bcdc116be329" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186455318}] :answer-field/correct {:db/id #edb/ref 17592186455012} :answer-field/id #uuid "63750d47-51f3-5cdf-a76b-72522571295c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186455367}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3f1c8267-786a-5d55-8970-d1a062c41c69" :question/math-academy-id "q-76673" :question/problem "Evaluate the integral of the function $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{{x}^{2}}$ along the polar curve $r=1$ for $0\\le \\theta \\le \\frac{\\pi }{4}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta $ and $y=\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, since $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{{x}^{2}}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\frac{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta } \\\\  & =\\frac{1}{{cos}^{2}⁡\\theta } \\\\  & ={sec}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(1)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{1}^{2}+{0}^{2}} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{{x}^{2}+{y}^{2}}{{x}^{2}}\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{sec}^{2}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{sec}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\operatorname{tan}⁡\\theta \\,{|}_{0}^{\\pi /4} \\\\  & =1-0 \\\\  & =1\\end{aligned}\n$$"} :step/id #uuid "8f5cb91b-d739-5769-854c-6dbdff5a72c8" :step/next {:db/id #edb/ref 17592186548160}} {:db/id #edb/ref 17592186548160 :step/content {:db/id #edb/ref 17592186345247 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7eee1f5-4e67-5791-ab19-b18c7b3e839f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16\\sqrt{2}}{5}" :db/id #edb/ref 17592186343993} {:answer/id #uuid "dbc4b0b3-3161-5573-8ff6-5f7ebe4c7119" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186344166} {:answer/id #uuid "e210fd40-0385-5c02-968e-6174892fbc40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186344228} {:answer/id #uuid "f3c07b9f-3789-507f-97de-8e306b0fb0a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186344384} {:answer/id #uuid "f5abf403-18d1-5fd6-8efd-732e33e8d35e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4\\sqrt{2}}{3}" :db/id #edb/ref 17592186344400}] :answer-field/correct {:db/id #edb/ref 17592186344384} :answer-field/id #uuid "7df0e8e5-c868-5ece-818b-a9164009ba5b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344718}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6d3824d0-05f9-53c5-8fe3-dac14910620a" :question/math-academy-id "q-76694" :question/problem "Evaluate the integral of the function $f(x,y)=x\\sqrt{{y}^{3}}$ along the polar curve $r=2$ for $0\\le \\theta \\le \\frac{\\pi }{6}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=3\\operatorname{cos}⁡\\theta $ and $y=3\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{6}.$\n\nNow, since $f(x,y)=x\\sqrt{{y}^{3}}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2\\operatorname{cos}⁡\\theta \\cdot \\sqrt{(2\\operatorname{sin}⁡\\theta )^{3}} \\\\  & =4\\sqrt{2}{sin}^{3/2}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{2}^{2}+{0}^{2}} \\\\  & =2.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x\\sqrt{{y}^{3}}\\,\\text{d}s & ={\\int }_{0}^{\\pi /6}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /6}4\\sqrt{2}{sin}^{3/2}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 2\\cdot \\text{d}\\theta  \\\\  & =8\\sqrt{2}{\\int }_{0}^{\\pi /6}{sin}^{3/2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{sin}⁡\\theta ,$ $\\text{d}u=\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows: \n\n$$\n\\begin{aligned}8\\sqrt{2}{\\int }_{0}^{\\pi /6}{sin}^{3/2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  & =8\\sqrt{2}{\\int }_{0}^{1/2}{u}^{3/2}\\,\\text{d}u \\\\  & =8\\sqrt{2}\\cdot \\frac{2}{5}{u}^{5/2}{|}_{0}^{1/2} \\\\  & =\\frac{16\\sqrt{2}}{5}({(\\frac{1}{2})}^{5/2}-{0}^{5/2}) \\\\  & =\\frac{16\\sqrt{2}}{5}\\cdot \\frac{1}{\\sqrt{{2}^{5}}} \\\\  & =\\frac{16\\sqrt{2}}{5}\\cdot \\frac{1}{4\\sqrt{2}} \\\\  & =\\frac{4}{5}\\end{aligned}\n$$"} :step/id #uuid "c76ec6eb-64e7-5508-82da-b33da64af211" :step/next {:db/id #edb/ref 17592186548117}}] :activity/title "Line Integrals of Scalar Functions Over Polar Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186547303}] [{:activity/course {:db/id #edb/ref 17592186046669} :activity/first-step {:db/id #edb/ref 17592186562531} :activity/id #uuid "9f98fcb3-319a-51d9-9990-f8d936618c6a" :activity/scope {:db/id #edb/ref 17592186048694 :topic/id #uuid "b52b86c6-5073-5d60-a17c-32a308489156" :topic/math-academy-id 2638} :activity/steps [{:db/id #edb/ref 17592186562531 :step/content {:db/id #edb/ref 17592186152742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1958b138-6b04-5333-b9d2-5760b56a84ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186150962} {:answer/id #uuid "3a8f81c6-87c9-58bf-8223-925f3a6025dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186150963} {:answer/id #uuid "1fc5a202-2d3d-51b8-8cc9-baf13d81b387" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}+1" :db/id #edb/ref 17592186454954} {:answer/id #uuid "23b1763b-1b62-51fc-8c26-6f829107e1d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}-1" :db/id #edb/ref 17592186454957} {:answer/id #uuid "35a3d662-0004-5272-8d96-ac26eddf6b34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(\\sqrt{2}-1)" :db/id #edb/ref 17592186454987}] :answer-field/correct {:db/id #edb/ref 17592186454987} :answer-field/id #uuid "bccab8a0-46e0-5cbd-b014-7b53de12212d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186150959}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e2100053-2a05-53a9-93f0-e3b2f1998524" :question/math-academy-id "q-76353" :question/problem "Evaluate the integral of the function $f(x,y)=x+y$ along the polar curve $r=2$ for $-\\frac{\\pi }{4}\\le \\theta \\le 0.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{cos}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta $, where $-\\frac{\\pi }{4}\\le \\theta \\le 0.$\n\nNow, since $f(x,y)=x+y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2\\operatorname{cos}⁡\\theta +2\\operatorname{sin}⁡\\theta  \\\\  & =2(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ).\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{2}^{2}+{0}^{2}} \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,\\text{d}s & ={\\int }_{-\\pi /4}^{0}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{0}2(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\cdot 2\\cdot \\text{d}\\theta  \\\\  & =4{\\int }_{-\\pi /4}^{0}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =4(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ){|}_{-\\pi /4}^{0} \\\\  & =4([0-1]-[-\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2}]) \\\\  & =4(\\sqrt{2}-1)\\end{aligned}\n$$"} :step/id #uuid "3e1fb143-31f6-50fe-a442-6e96f6c347ea" :step/next {:db/id #edb/ref 17592186562547}} {:db/id #edb/ref 17592186562537 :step/content {:db/id #edb/ref 17592186345253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e1d1f28-5484-5c86-a90a-082235f872c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "81" :db/id #edb/ref 17592186343482} {:answer/id #uuid "965afcff-952c-57f1-8381-d0d2c6cfa333" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186343554} {:answer/id #uuid "a4896ac8-ec47-5492-a067-e873101e9558" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "243" :db/id #edb/ref 17592186343690} {:answer/id #uuid "d0fcab50-4e3f-52f2-bbd9-053b07f4ba3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186344075} {:answer/id #uuid "ffb4f5db-7a15-5a8d-92fa-4882f0394575" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186344491}] :answer-field/correct {:db/id #edb/ref 17592186343482} :answer-field/id #uuid "fc4f513d-22f2-5838-ab63-68e9cd6ee512" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344934}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "20b5574b-0241-5d1f-8b06-4befe90938df" :question/math-academy-id "q-76765" :question/problem "Evaluate the integral of the function $f(x,y)=xy$ along the polar curve $r=6$ for $0\\le \\theta \\le \\frac{\\pi }{3}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =6\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =6\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=6\\operatorname{cos}⁡\\theta $ and $y=6\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{3}.$\n\nNow, since $f(x,y)=xy$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =6\\operatorname{cos}⁡\\theta \\cdot 6\\operatorname{sin}⁡\\theta  \\\\  & =36\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(6)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{6}^{2}+{0}^{2}} \\\\  & =6.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy\\,\\text{d}s & ={\\int }_{0}^{\\pi /3}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}36\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot 6\\cdot \\text{d}\\theta  \\\\  & =6{\\int }_{0}^{\\pi /3}6\\operatorname{cos}⁡\\theta \\cdot 6\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=6\\operatorname{sin}⁡\\theta ,$ $\\text{d}u=6\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}6{\\int }_{0}^{\\pi /3}6\\operatorname{cos}⁡\\theta \\cdot 6\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  & =6{\\int }_{0}^{3\\sqrt{3}}u\\,\\text{d}u \\\\  & =6\\cdot \\frac{1}{2}{u}^{2}{|}_{0}^{3\\sqrt{3}} \\\\  & =3({(3\\sqrt{3})}^{2}-{0}^{2}) \\\\  & =3\\cdot 27 \\\\  & =81\\end{aligned}\n$$"} :step/id #uuid "4e2e4bc0-1e8a-5113-b6e3-7585d391d8f4" :step/next {:db/id #edb/ref 17592186562588}} {:db/id #edb/ref 17592186562547 :step/content {:db/id #edb/ref 17592186345238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5daa3e96-058a-548e-9727-56398515faab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186343024} {:answer/id #uuid "65d6b8b8-c97c-5abc-aecb-7e85e4054fa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186343101} {:answer/id #uuid "7bb80056-6ab1-5d01-af98-8aaa5fd2fb1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186343301} {:answer/id #uuid "8a181e36-5fec-5c45-9657-66ff3657d6a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186343440} {:answer/id #uuid "c39755ce-fc8d-515c-bacb-72a25ce9a67d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186343959}] :answer-field/correct {:db/id #edb/ref 17592186343959} :answer-field/id #uuid "87362288-9f29-50fe-9150-93bef3fb4a45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344731}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5897420e-efe0-5c2e-8d46-6165bb9e5dd3" :question/math-academy-id "q-76616" :question/problem "Evaluate the integral of the function $f(x,y)={x}^{2}-{y}^{2}$ along the polar curve $r=2\\,$ for $0\\le \\theta \\le \\frac{\\pi }{4}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{cos}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$  \n\nNow, since $f(x,y)={x}^{2}-{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(2\\operatorname{cos}⁡\\theta )^{2}-(2\\operatorname{sin}⁡\\theta )^{2} \\\\  & =4{cos}^{2}⁡\\theta -4{sin}^{2}⁡\\theta  \\\\  & =4({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & =4\\operatorname{cos}⁡2\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\n \n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}-{y}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}4\\operatorname{cos}⁡2\\theta \\cdot 2\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}8\\operatorname{cos}⁡2\\theta \\,\\text{d}\\theta  \\\\  & =4\\operatorname{sin}⁡2\\theta \\,{|}_{0}^{\\pi /4} \\\\  & =4(\\operatorname{sin}⁡(\\pi /2)-\\operatorname{sin}⁡0) \\\\  & =4\\end{aligned}\n$$"} :step/id #uuid "668b84cc-dafd-5f8b-8aa0-2030bb110523" :step/next {:db/id #edb/ref 17592186562571}} {:db/id #edb/ref 17592186562571 :step/content {:db/id #edb/ref 17592186345246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bba08e7-72f6-5628-a032-40fab3b1523b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{2}}{4}" :db/id #edb/ref 17592186342340} {:answer/id #uuid "966bb9f4-b258-530d-bda2-5cc45dd1bfc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186343555} {:answer/id #uuid "da527ec0-d3e9-50cf-934b-d37d6ce14b54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186344156} {:answer/id #uuid "dc075c9d-4ff5-5e6a-83cc-7b9150d7aa65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186344168} {:answer/id #uuid "eb3267aa-cefb-5be3-9449-fd0ab72c839c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186344296}] :answer-field/correct {:db/id #edb/ref 17592186344168} :answer-field/id #uuid "56b83e59-aa7d-5940-925e-575b2e63efa7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344638}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fee02b99-a9f3-5976-9c5b-34d5a43071ea" :question/math-academy-id "q-76690" :question/problem "Evaluate the integral of the function $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}}$ along the polar curve $r=\\operatorname{sin}⁡\\theta \\,$ for $\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y={sin}^{2}⁡\\theta $, where $\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{2}.$ \n\nNow, since $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\sqrt{(\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )^{2}+({sin}^{2}⁡\\theta )^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +{sin}^{4}⁡\\theta } \\\\  & =\\sqrt{{sin}^{2}⁡\\theta ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\sqrt{{sin}^{2}⁡\\theta } \\\\  & =|\\operatorname{sin}⁡\\theta | \\\\  & =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNotice that $|\\operatorname{sin}⁡\\theta |=\\operatorname{sin}⁡\\theta $ because $\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{2}\\,⟹\\,\\operatorname{sin}⁡\\theta >0.$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{sin}⁡\\theta )=\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\operatorname{sin}⁡\\theta )^{2}+(\\operatorname{cos}⁡\\theta )^{2}} \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\n \n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}s & ={\\int }_{\\pi /4}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\operatorname{sin}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & =-\\operatorname{cos}⁡\\theta {|}_{\\pi /4}^{\\pi /2} \\\\  & =-0-(-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$"} :step/id #uuid "c6c7fb69-3617-59d6-9f6f-a15065e9e0d0" :step/next {:db/id #edb/ref 17592186562537}} {:db/id #edb/ref 17592186562588 :step/content {:db/id #edb/ref 17592186284544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec9ea01-bfeb-5dfa-bb0d-e8dda89e8cde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta -1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186281819} {:answer/id #uuid "2f167cc3-d0d4-5732-aea7-9737587d5446" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sin}^{4}⁡\\theta {cos}^{4}⁡\\theta -1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186282107} {:answer/id #uuid "a46851a8-a830-5300-ba0a-c94605be1ac1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sin}^{4}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283122} {:answer/id #uuid "a598ce3d-2796-5960-afd3-75d843fcccbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283132} {:answer/id #uuid "b7c751ad-dde6-5f48-96a4-ca006c0a37ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sin}^{2}⁡\\theta {cos}^{4}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283278}] :answer-field/correct {:db/id #edb/ref 17592186283132} :answer-field/id #uuid "f183aa4f-94f5-53a7-8fa6-3240e8f8d306" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284363}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "47feb8ed-9de6-5cab-9530-5d8b3448a054" :question/math-academy-id "q-165413" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}\\frac{{x}^{4}}{{y}^{2}}\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=\\operatorname{tan}⁡\\theta \\,$ for $\\frac{\\pi }{6}\\le \\theta \\le \\frac{\\pi }{3}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{tan}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{tan}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\frac{{sin}^{2}⁡\\theta }{\\operatorname{cos}⁡\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{sin}⁡\\theta $ and $y=\\frac{{sin}^{2}⁡\\theta }{\\operatorname{cos}⁡\\theta }$, where $\\frac{\\pi }{6}\\le \\theta \\le \\frac{\\pi }{3}.$\n\nNow, if $f(x,y)=\\frac{{x}^{4}}{{y}^{2}}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\frac{{sin}^{4}⁡\\theta }{{(\\frac{{sin}^{2}⁡\\theta }{\\operatorname{cos}⁡\\theta })}^{2}} \\\\  & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{tan}⁡\\theta )=\\frac{1}{{cos}^{2}⁡\\theta },\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{tan}⁡\\theta )}^{2}+{(\\frac{1}{{cos}^{2}⁡\\theta })}^{2}} \\\\  & =\\sqrt{\\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta }+\\frac{1}{{cos}^{4}⁡\\theta }} \\\\  & =\\sqrt{\\frac{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}{{cos}^{4}⁡\\theta }} \\\\  & =\\frac{\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}}{{cos}^{2}⁡\\theta }.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{{x}^{4}}{{y}^{2}}\\,\\text{d}s & ={\\int }_{\\pi /6}^{\\pi /3}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}{cos}^{2}⁡\\theta \\cdot \\frac{\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}}{{cos}^{2}⁡\\theta }\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "f2218919-fc6a-5a1a-8a3c-12c86b990a4d"}] :activity/title "Line Integrals of Scalar Functions Over Polar Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186561573}]}
