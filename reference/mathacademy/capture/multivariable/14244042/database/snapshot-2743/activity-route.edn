#{[{:activity/course {:db/id #edb/ref 17592186046669} :activity/first-step {:db/id #edb/ref 17592186562531} :activity/id #uuid "9f98fcb3-319a-51d9-9990-f8d936618c6a" :activity/scope {:db/id #edb/ref 17592186048694 :topic/id #uuid "b52b86c6-5073-5d60-a17c-32a308489156" :topic/math-academy-id 2638} :activity/steps [{:db/id #edb/ref 17592186562531 :step/content {:db/id #edb/ref 17592186152742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1958b138-6b04-5333-b9d2-5760b56a84ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186150962} {:answer/id #uuid "3a8f81c6-87c9-58bf-8223-925f3a6025dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186150963} {:answer/id #uuid "1fc5a202-2d3d-51b8-8cc9-baf13d81b387" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}+1" :db/id #edb/ref 17592186454954} {:answer/id #uuid "23b1763b-1b62-51fc-8c26-6f829107e1d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}-1" :db/id #edb/ref 17592186454957} {:answer/id #uuid "35a3d662-0004-5272-8d96-ac26eddf6b34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4(\\sqrt{2}-1)" :db/id #edb/ref 17592186454987}] :answer-field/correct {:db/id #edb/ref 17592186454987} :answer-field/id #uuid "bccab8a0-46e0-5cbd-b014-7b53de12212d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186150959}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e2100053-2a05-53a9-93f0-e3b2f1998524" :question/math-academy-id "q-76353" :question/problem "Evaluate the integral of the function $f(x,y)=x+y$ along the polar curve $r=2$ for $-\\frac{\\pi }{4}\\le \\theta \\le 0.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{cos}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta $, where $-\\frac{\\pi }{4}\\le \\theta \\le 0.$\n\nNow, since $f(x,y)=x+y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2\\operatorname{cos}⁡\\theta +2\\operatorname{sin}⁡\\theta  \\\\  & =2(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ).\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{2}^{2}+{0}^{2}} \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,\\text{d}s & ={\\int }_{-\\pi /4}^{0}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{0}2(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\cdot 2\\cdot \\text{d}\\theta  \\\\  & =4{\\int }_{-\\pi /4}^{0}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =4(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ){|}_{-\\pi /4}^{0} \\\\  & =4([0-1]-[-\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2}]) \\\\  & =4(\\sqrt{2}-1)\\end{aligned}\n$$"} :step/id #uuid "3e1fb143-31f6-50fe-a442-6e96f6c347ea" :step/next {:db/id #edb/ref 17592186562547}} {:db/id #edb/ref 17592186562537 :step/content {:db/id #edb/ref 17592186345253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e1d1f28-5484-5c86-a90a-082235f872c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "81" :db/id #edb/ref 17592186343482} {:answer/id #uuid "965afcff-952c-57f1-8381-d0d2c6cfa333" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186343554} {:answer/id #uuid "a4896ac8-ec47-5492-a067-e873101e9558" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "243" :db/id #edb/ref 17592186343690} {:answer/id #uuid "d0fcab50-4e3f-52f2-bbd9-053b07f4ba3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186344075} {:answer/id #uuid "ffb4f5db-7a15-5a8d-92fa-4882f0394575" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186344491}] :answer-field/correct {:db/id #edb/ref 17592186343482} :answer-field/id #uuid "fc4f513d-22f2-5838-ab63-68e9cd6ee512" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344934}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "20b5574b-0241-5d1f-8b06-4befe90938df" :question/math-academy-id "q-76765" :question/problem "Evaluate the integral of the function $f(x,y)=xy$ along the polar curve $r=6$ for $0\\le \\theta \\le \\frac{\\pi }{3}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =6\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =6\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=6\\operatorname{cos}⁡\\theta $ and $y=6\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{3}.$\n\nNow, since $f(x,y)=xy$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =6\\operatorname{cos}⁡\\theta \\cdot 6\\operatorname{sin}⁡\\theta  \\\\  & =36\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(6)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{6}^{2}+{0}^{2}} \\\\  & =6.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy\\,\\text{d}s & ={\\int }_{0}^{\\pi /3}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}36\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot 6\\cdot \\text{d}\\theta  \\\\  & =6{\\int }_{0}^{\\pi /3}6\\operatorname{cos}⁡\\theta \\cdot 6\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=6\\operatorname{sin}⁡\\theta ,$ $\\text{d}u=6\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}6{\\int }_{0}^{\\pi /3}6\\operatorname{cos}⁡\\theta \\cdot 6\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  & =6{\\int }_{0}^{3\\sqrt{3}}u\\,\\text{d}u \\\\  & =6\\cdot \\frac{1}{2}{u}^{2}{|}_{0}^{3\\sqrt{3}} \\\\  & =3({(3\\sqrt{3})}^{2}-{0}^{2}) \\\\  & =3\\cdot 27 \\\\  & =81\\end{aligned}\n$$"} :step/id #uuid "4e2e4bc0-1e8a-5113-b6e3-7585d391d8f4" :step/next {:db/id #edb/ref 17592186562588}} {:db/id #edb/ref 17592186562547 :step/content {:db/id #edb/ref 17592186345238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5daa3e96-058a-548e-9727-56398515faab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186343024} {:answer/id #uuid "65d6b8b8-c97c-5abc-aecb-7e85e4054fa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186343101} {:answer/id #uuid "7bb80056-6ab1-5d01-af98-8aaa5fd2fb1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186343301} {:answer/id #uuid "8a181e36-5fec-5c45-9657-66ff3657d6a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186343440} {:answer/id #uuid "c39755ce-fc8d-515c-bacb-72a25ce9a67d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186343959}] :answer-field/correct {:db/id #edb/ref 17592186343959} :answer-field/id #uuid "87362288-9f29-50fe-9150-93bef3fb4a45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344731}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5897420e-efe0-5c2e-8d46-6165bb9e5dd3" :question/math-academy-id "q-76616" :question/problem "Evaluate the integral of the function $f(x,y)={x}^{2}-{y}^{2}$ along the polar curve $r=2\\,$ for $0\\le \\theta \\le \\frac{\\pi }{4}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{cos}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$  \n\nNow, since $f(x,y)={x}^{2}-{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(2\\operatorname{cos}⁡\\theta )^{2}-(2\\operatorname{sin}⁡\\theta )^{2} \\\\  & =4{cos}^{2}⁡\\theta -4{sin}^{2}⁡\\theta  \\\\  & =4({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & =4\\operatorname{cos}⁡2\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\n \n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}-{y}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}4\\operatorname{cos}⁡2\\theta \\cdot 2\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}8\\operatorname{cos}⁡2\\theta \\,\\text{d}\\theta  \\\\  & =4\\operatorname{sin}⁡2\\theta \\,{|}_{0}^{\\pi /4} \\\\  & =4(\\operatorname{sin}⁡(\\pi /2)-\\operatorname{sin}⁡0) \\\\  & =4\\end{aligned}\n$$"} :step/id #uuid "668b84cc-dafd-5f8b-8aa0-2030bb110523" :step/next {:db/id #edb/ref 17592186562571}} {:db/id #edb/ref 17592186562571 :step/content {:db/id #edb/ref 17592186345246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bba08e7-72f6-5628-a032-40fab3b1523b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{2}}{4}" :db/id #edb/ref 17592186342340} {:answer/id #uuid "966bb9f4-b258-530d-bda2-5cc45dd1bfc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186343555} {:answer/id #uuid "da527ec0-d3e9-50cf-934b-d37d6ce14b54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186344156} {:answer/id #uuid "dc075c9d-4ff5-5e6a-83cc-7b9150d7aa65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186344168} {:answer/id #uuid "eb3267aa-cefb-5be3-9449-fd0ab72c839c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186344296}] :answer-field/correct {:db/id #edb/ref 17592186344168} :answer-field/id #uuid "56b83e59-aa7d-5940-925e-575b2e63efa7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344638}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fee02b99-a9f3-5976-9c5b-34d5a43071ea" :question/math-academy-id "q-76690" :question/problem "Evaluate the integral of the function $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}}$ along the polar curve $r=\\operatorname{sin}⁡\\theta \\,$ for $\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y={sin}^{2}⁡\\theta $, where $\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{2}.$ \n\nNow, since $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\sqrt{(\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )^{2}+({sin}^{2}⁡\\theta )^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +{sin}^{4}⁡\\theta } \\\\  & =\\sqrt{{sin}^{2}⁡\\theta ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\sqrt{{sin}^{2}⁡\\theta } \\\\  & =|\\operatorname{sin}⁡\\theta | \\\\  & =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNotice that $|\\operatorname{sin}⁡\\theta |=\\operatorname{sin}⁡\\theta $ because $\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{2}\\,⟹\\,\\operatorname{sin}⁡\\theta >0.$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{sin}⁡\\theta )=\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\operatorname{sin}⁡\\theta )^{2}+(\\operatorname{cos}⁡\\theta )^{2}} \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\n \n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}s & ={\\int }_{\\pi /4}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\operatorname{sin}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & =-\\operatorname{cos}⁡\\theta {|}_{\\pi /4}^{\\pi /2} \\\\  & =-0-(-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$"} :step/id #uuid "c6c7fb69-3617-59d6-9f6f-a15065e9e0d0" :step/next {:db/id #edb/ref 17592186562537}} {:db/id #edb/ref 17592186562588 :step/content {:db/id #edb/ref 17592186284544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec9ea01-bfeb-5dfa-bb0d-e8dda89e8cde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta -1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186281819} {:answer/id #uuid "2f167cc3-d0d4-5732-aea7-9737587d5446" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sin}^{4}⁡\\theta {cos}^{4}⁡\\theta -1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186282107} {:answer/id #uuid "a46851a8-a830-5300-ba0a-c94605be1ac1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sin}^{4}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283122} {:answer/id #uuid "a598ce3d-2796-5960-afd3-75d843fcccbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283132} {:answer/id #uuid "b7c751ad-dde6-5f48-96a4-ca006c0a37ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sin}^{2}⁡\\theta {cos}^{4}⁡\\theta +1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186283278}] :answer-field/correct {:db/id #edb/ref 17592186283132} :answer-field/id #uuid "f183aa4f-94f5-53a7-8fa6-3240e8f8d306" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284363}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "47feb8ed-9de6-5cab-9530-5d8b3448a054" :question/math-academy-id "q-165413" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}\\frac{{x}^{4}}{{y}^{2}}\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=\\operatorname{tan}⁡\\theta \\,$ for $\\frac{\\pi }{6}\\le \\theta \\le \\frac{\\pi }{3}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{tan}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{tan}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\frac{{sin}^{2}⁡\\theta }{\\operatorname{cos}⁡\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{sin}⁡\\theta $ and $y=\\frac{{sin}^{2}⁡\\theta }{\\operatorname{cos}⁡\\theta }$, where $\\frac{\\pi }{6}\\le \\theta \\le \\frac{\\pi }{3}.$\n\nNow, if $f(x,y)=\\frac{{x}^{4}}{{y}^{2}}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\frac{{sin}^{4}⁡\\theta }{{(\\frac{{sin}^{2}⁡\\theta }{\\operatorname{cos}⁡\\theta })}^{2}} \\\\  & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{tan}⁡\\theta )=\\frac{1}{{cos}^{2}⁡\\theta },\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{tan}⁡\\theta )}^{2}+{(\\frac{1}{{cos}^{2}⁡\\theta })}^{2}} \\\\  & =\\sqrt{\\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta }+\\frac{1}{{cos}^{4}⁡\\theta }} \\\\  & =\\sqrt{\\frac{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}{{cos}^{4}⁡\\theta }} \\\\  & =\\frac{\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}}{{cos}^{2}⁡\\theta }.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{{x}^{4}}{{y}^{2}}\\,\\text{d}s & ={\\int }_{\\pi /6}^{\\pi /3}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}{cos}^{2}⁡\\theta \\cdot \\frac{\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}}{{cos}^{2}⁡\\theta }\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}\\sqrt{{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta +1}\\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "f2218919-fc6a-5a1a-8a3c-12c86b990a4d"}] :activity/title "Line Integrals of Scalar Functions Over Polar Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186561573}]}
