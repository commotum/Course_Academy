^{T}\\,X)^{-1}{X}^{T}y.\n$$"}] [{:db/id #edb/ref 17592186371817 :knowledge-point/_questions [{:db/id #edb/ref 17592186133823 :knowledge-point/id #uuid "aa5bf185-de29-5185-ba57-c64250332dfa" :knowledge-point/title "Identifying the Elements of a Polynomial Regression Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3020655f-666f-5dd7-9f8f-11786319f4fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 & {1}^{2} & {1}^{3} \\\\ 1 & 3 & {3}^{2} & {3}^{3} \\\\ 1 & 5 & {5}^{2} & {5}^{3} \\\\ 1 & 7 & {7}^{2} & {7}^{3} \\\\ 1 & 9 & {9}^{2} & {9}^{3}\\end{bmatrix}" :db/id #edb/ref 17592186371819} {:answer/id #uuid "cfae00cb-82f7-5fde-8fa3-f054c5b80904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 \\\\ 3 & -5 \\\\ 5 & -3 \\\\ 7 & -4 \\\\ 9 & 5\\end{bmatrix}" :db/id #edb/ref 17592186371820} {:answer/id #uuid "3d348751-c0c2-52da-8055-4639f9a1d5f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 3 \\\\ 5 \\\\ 7 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186371821} {:answer/id #uuid "63a76836-a433-5012-8ce8-89d71747bdc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 & (-1)^{2} & (-1)^{3} \\\\ 1 & -5 & (-5)^{2} & (-5)^{3} \\\\ 1 & -3 & (-3)^{2} & (-3)^{3} \\\\ 1 & -4 & (-4)^{2} & (-4)^{3} \\\\ 1 & 5 & {5}^{2} & {5}^{3}\\end{bmatrix}" :db/id #edb/ref 17592186371822} {:answer/id #uuid "705a213d-809f-545f-9c4a-be92dd3bd22b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -5 \\\\ -3 \\\\ -4 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186371823}] :answer-field/correct {:answer/id #uuid "705a213d-809f-545f-9c4a-be92dd3bd22b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -5 \\\\ 