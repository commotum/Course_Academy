#{[{:activity/expected-seconds 1500.0 :activity/first-step {:db/id #edb/ref 17592186084153} :activity/id #uuid "ddf8dd4c-877a-598f-8893-a8ab19b3b308" :activity/scope {:db/id #edb/ref 17592186050162 :topic/id #uuid "3308e65f-61fe-550b-8dc0-4e4a4925cb49" :topic/math-academy-id 799} :activity/steps [{:db/id #edb/ref 17592186084153 :step/content {:db/id #edb/ref 17592186084391 :tutorial/content "Remember that to find the slope $m$ of a tangent line to a function $y=f(x),$ we compute the derivative:\n\n$$\nm = \\dfrac{\\textrm dy}{\\textrm dx} = f'(x)\n$$\n\nLikewise, to find the slope $m_n$ of a normal line to a function $y=f(x),$ we take the negative reciprocal of the tangent slope:\n\n$$\nm_n = -\\dfrac{1}{m} = -\\dfrac{1}{f'(x)}\n$$\n\nWith parametric equations $x=x(t), \\, y=y(t),$ it works the same way. The slope of the tangent line is still the derivative of $y$ with respect to $x\\mathbin{:}$\n\n$$\nm = \\dfrac{\\textrm dy}{\\textrm dx} = \\dfrac{y'(t)}{x'(t)}\n$$\n\nLikewise, the slope of the normal line is still given by the negative reciprocal:\n\n$$\nm_n = -\\dfrac{1}{m} = -\\dfrac{x'(t)}{y'(t)}\n$$" :tutorial/id #uuid "48431a98-af5d-5fb6-a9c9-0c0a82d65d84" :tutorial/math-academy-id 1071 :tutorial/title "Introduction"} :step/id #uuid "c94cfe31-d0e9-529d-b6dd-34491bfb6e2d" :step/math-academy-id 2109 :step/next {:db/id #edb/ref 17592186084154}} {:db/id #edb/ref 17592186084154 :step/content {:db/id #edb/ref 17592186083244 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083056 :question/id #uuid "879e41c3-7d67-5821-81dc-f6d3fc664ffd" :question/math-academy-id "e-597"} :knowledge-point/id #uuid "145eff6a-ad61-5001-ab14-cf77e93a7958" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050531} {:db/id #edb/ref 17592186050644}] :knowledge-point/questions [{:db/id #edb/ref 17592186083912} {:db/id #edb/ref 17592186083913} {:db/id #edb/ref 17592186256700} {:db/id #edb/ref 17592186275337} {:db/id #edb/ref 17592186319229} {:db/id #edb/ref 17592186319230}] :knowledge-point/title "Computing the Tangent Line to a Parametric Curve"} :step/id #uuid "891625df-94b1-5558-ba83-17e23764feaa" :step/math-academy-id 2110 :step/next {:db/id #edb/ref 17592186084207}} {:db/id #edb/ref 17592186084155 :step/content {:db/id #edb/ref 17592186083245 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083057 :question/id #uuid "db8c5a47-27b8-548d-8bd7-65289cff06da" :question/math-academy-id "e-598"} :knowledge-point/id #uuid "898e04b8-1b7e-59e7-b03f-3ece54aa093b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049119}] :knowledge-point/questions [{:db/id #edb/ref 17592186083545} {:db/id #edb/ref 17592186083547} {:db/id #edb/ref 17592186256744} {:db/id #edb/ref 17592186319376} {:db/id #edb/ref 17592186319377} {:db/id #edb/ref 17592186335964} {:db/id #edb/ref 17592186400065} {:db/id #edb/ref 17592186403822}] :knowledge-point/title "Computing the Normal Line to a Parametric Curve"} :step/id #uuid "175eff7b-218c-5515-9477-5ac8c765204a" :step/math-academy-id 2114 :step/next {:db/id #edb/ref 17592186084203}} {:db/id #edb/ref 17592186084201 :step/content {:db/id #edb/ref 17592186083278 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083074 :question/id #uuid "72076ddb-4a3a-530f-854c-7b1400cd9859" :question/math-academy-id "e-6240"} :knowledge-point/id #uuid "3fc81cba-b997-54bc-9e11-0a4ff130833e" :knowledge-point/questions [{:db/id #edb/ref 17592186083613} {:db/id #edb/ref 17592186083614} {:db/id #edb/ref 17592186256706} {:db/id #edb/ref 17592186288015} {:db/id #edb/ref 17592186290274} {:db/id #edb/ref 17592186319374} {:db/id #edb/ref 17592186319375} {:db/id #edb/ref 17592186323713}] :knowledge-point/title "Determining the Points Where the Tangent is Horizontal or Vertical"} :step/id #uuid "69ed9071-e55a-5c8e-b0b2-bfbf686b3484" :step/math-academy-id 23435 :step/next {:db/id #edb/ref 17592186084155}} {:db/id #edb/ref 17592186084203 :step/content {:db/id #edb/ref 17592186083280 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083075 :question/id #uuid "b2f8d797-75e8-5ac8-82e7-1c5a9788e6e3" :question/math-academy-id "e-6252"} :knowledge-point/id #uuid "12a5ad95-0cc9-53c5-8e1c-dae35d1c4447" :knowledge-point/question-generator {:db/id #edb/ref 17592186523091} :knowledge-point/questions [{:db/id #edb/ref 17592186083612} {:db/id #edb/ref 17592186083615} {:db/id #edb/ref 17592186256751} {:db/id #edb/ref 17592186256752} {:db/id #edb/ref 17592186319378} {:db/id #edb/ref 17592186319379} {:db/id #edb/ref 17592186393514} {:db/id #edb/ref 17592186523015} {:db/id #edb/ref 17592186523022} {:db/id #edb/ref 17592186523025} {:db/id #edb/ref 17592186523026} {:db/id #edb/ref 17592186523029} {:db/id #edb/ref 17592186523064} {:db/id #edb/ref 17592186523073} {:db/id #edb/ref 17592186523079} {:db/id #edb/ref 17592186523083} {:db/id #edb/ref 17592186523089}] :knowledge-point/title "Determining the Points Where the Normal is Horizontal or Vertical"} :step/id #uuid "fadade9f-f512-5c24-92c8-f8a0cc3f8c5f" :step/math-academy-id 23462} {:db/id #edb/ref 17592186084207 :step/content {:db/id #edb/ref 17592186084467 :tutorial/content "The slope $m$ of the tangent to a parametric curve $x=x(t), y=y(t),$ is given by\n\n$$\nm = \\dfrac{y'(t)}{x'(t)}.\n$$\n\nSuppose that we want to find all of the locations where the tangent to the curve is horizontal. If the tangent is horizontal, this means that $m=0,$ and so provided that $x'(t)\\neq 0,$ we have\n\n$$\n\\dfrac{y'(t)}{x'(t)} = 0\\quad \\Longrightarrow\\quad y'(t) = 0.\n$$\n\nSo, to find the locations where the tangent is horizontal, we solve the equation $y'(t) = 0.$ We also need to double-check that $x'(t)\\neq 0$ for each solution. The final step is necessary because a slope of $\\dfrac00$ is meaningless, and we cannot deduce any information regarding the tangent slope from this expression.\n\nSimilarly, if we want to find the locations where the tangent line is *vertical,* we solve the equation $x'(t)=0,$ and we also need to check that $y'(t)\\neq 0$ for each solution.\n\nLet's see some examples." :tutorial/id #uuid "fc76ffb8-75bd-55f8-8af4-6d84235bd0cf" :tutorial/math-academy-id 3964 :tutorial/title "Horizontal or Vertical Tangents to Parametric Curves"} :step/id #uuid "a295440a-1435-58d0-bb64-ea293bda1d52" :step/math-academy-id 23530 :step/next {:db/id #edb/ref 17592186084201}}] :activity/title "Calculating Tangent and Normal Lines with Parametric Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083473}]}
