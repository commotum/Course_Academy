#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186180420} :activity/id #uuid "0488d093-c253-570d-ae9f-e5f079caa8b4" :activity/scope {:db/id #edb/ref 17592186049765 :topic/id #uuid "11e8eee6-f42e-5ccd-91ca-02c0e23d2681" :topic/math-academy-id 3701} :activity/steps [{:db/id #edb/ref 17592186180411 :step/content {:db/id #edb/ref 17592186179688 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179547 :question/id #uuid "bb7ae99a-b8d9-5e4d-906c-9e18d22c1404" :question/math-academy-id "e-8742"} :knowledge-point/id #uuid "78adaeaa-a91e-53e2-a192-1440d4d41211" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932} {:db/id #edb/ref 17592186049459}] :knowledge-point/questions [{:db/id #edb/ref 17592186179909} {:db/id #edb/ref 17592186180185} {:db/id #edb/ref 17592186241093} {:db/id #edb/ref 17592186241096} {:db/id #edb/ref 17592186241097} {:db/id #edb/ref 17592186241098} {:db/id #edb/ref 17592186367359} {:db/id #edb/ref 17592186367366} {:db/id #edb/ref 17592186490261} {:db/id #edb/ref 17592186490329} {:db/id #edb/ref 17592186505751} {:db/id #edb/ref 17592186505762} {:db/id #edb/ref 17592186567041} {:db/id #edb/ref 17592186567096}] :knowledge-point/title "Finding the Divergence of a Vector Field Using Linearity Properties"} :step/id #uuid "9f1489d0-1edc-5435-abb3-f714edd9024b" :step/math-academy-id 32555 :step/next {:db/id #edb/ref 17592186180471}} {:db/id #edb/ref 17592186180414 :step/content {:db/id #edb/ref 17592186179690 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179549 :question/id #uuid "7de054d4-8384-5aab-b2c4-a43b1f86a16c" :question/math-academy-id "e-8928"} :knowledge-point/id #uuid "44d953c5-21bb-5326-bfac-e793cfe26cd2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813} {:db/id #edb/ref 17592186050885}] :knowledge-point/questions [{:db/id #edb/ref 17592186179910} {:db/id #edb/ref 17592186180310} {:db/id #edb/ref 17592186241099} {:db/id #edb/ref 17592186241100} {:db/id #edb/ref 17592186266067} {:db/id #edb/ref 17592186266068} {:db/id #edb/ref 17592186366829} {:db/id #edb/ref 17592186366850} {:db/id #edb/ref 17592186490220} {:db/id #edb/ref 17592186490254} {:db/id #edb/ref 17592186505757} {:db/id #edb/ref 17592186567031} {:db/id #edb/ref 17592186567087}] :knowledge-point/title "Finding the Divergence of a Vector Field Using the Product Rule"} :step/id #uuid "a493e9bd-6c19-5c41-b9fb-05fe7d5357d8" :step/math-academy-id 33326} {:db/id #edb/ref 17592186180420 :step/content {:db/id #edb/ref 17592186180689 :tutorial/content "Recall that if $\\mathbf F = P\\,\\mathbf i + Q\\,\\mathbf j + R\\,\\mathbf k$ is a vector field on $\\mathbb R^3,$ then the divergence of $\\mathbf F$ is given by\n\n$$\n\\textrm{div}\\,\\mathbf F = \\nabla\\cdot \\mathbf F = \\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} + \\dfrac{\\partial R}{\\partial z}.\n$$\n\nSince divergence is computed using derivatives, it's unsurprising that it shares similar properties with derivatives.\n\nFor example, if $\\mathbf F$ and $\\mathbf H$ are vector fields and $k$ is a scalar constant, then we have the following linearity properties:\n\n$$\n\\begin{aligned} & ∇\\cdot (k\\,F)=k\\,(∇\\cdot F) \\\\  & ∇\\cdot (F+H)=∇\\cdot F+∇\\cdot H\\end{aligned}\n$$\n\nApplying these rules can often help us to save time when computing divergence. Let's see some examples." :tutorial/id #uuid "f5f31027-65f9-53ab-bd9a-c3454d049b07" :tutorial/math-academy-id 5529 :tutorial/title "Introduction"} :step/id #uuid "6062f3c7-6f7f-55fd-81a5-fe282d53dde8" :step/math-academy-id 34372 :step/next {:db/id #edb/ref 17592186180411}} {:db/id #edb/ref 17592186180471 :step/content {:db/id #edb/ref 17592186180709 :tutorial/content "Recall that for functions $f(x)$ and $g(x),$ the product rule for differentiation is given by\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(f\\cdot g) = f\\dfrac{\\textrm d }{\\textrm d x}(g) +  g\\dfrac{\\textrm d }{\\textrm d x}(f).\n$$\n\nThere is an analogous rule for computing the divergence of the product of a vector field and a scalar field.\n\nSuppose that $\\mathbf F$ is a vector field and $f$ is a scalar field. Then, we have the following identity:\n\n$$\n\\nabla \\cdot (f\\,\\mathbf F) = f\\, \\nabla \\cdot \\mathbf {F}+  \\mathbf F \\cdot \\nabla \\! f\n$$\n\n  \n\nwhere $\\nabla f$ is the gradient of $f.$\n\nNotice that the del operator $\\nabla$ acts on the terms in the same way as the $\\dfrac{\\textrm d}{\\textrm d x}$ operator in the product rule for differentiation!\n\nThere are a few other tips that we can use to remember this rule:\n\n- The term $\\nabla \\cdot (f\\,\\mathbf F)$ on the left-hand side must be a scalar field because it's a divergence. So, the two terms on the right-hand side must be scalar fields, too.\n\n- The term $f\\, \\nabla \\cdot \\mathbf {F}$ on the right-hand side is a scalar field because both $f$ and $\\nabla \\cdot \\mathbf F$ are scalar fields, and the product of two scalar fields is a scalar field. Note that this \"product\" is just regular multiplication.\n\n- The term $\\mathbf F \\cdot \\nabla \\! f$ on the right-hand side is a scalar field because both $\\mathbf F$ and $\\nabla f$ are *vector* fields, and the *dot product* of two vector fields is a scalar field." :tutorial/id #uuid "c0316ea0-9d48-5155-82e8-948d53b0f677" :tutorial/math-academy-id 5795 :tutorial/title "The Product Rule for Divergence"} :step/id #uuid "6797ef0f-9f84-5dda-8b36-6c76a5fe635c" :step/math-academy-id 35539 :step/next {:db/id #edb/ref 17592186180414}}] :activity/title "Properties of the Divergence Operator" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186179855}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186505871} :activity/id #uuid "43cd0e68-5cb8-572a-ba2e-ef8b0404ffac" :activity/scope {:db/id #edb/ref 17592186049765 :topic/id #uuid "11e8eee6-f42e-5ccd-91ca-02c0e23d2681" :topic/math-academy-id 3701} :activity/steps [{:db/id #edb/ref 17592186505846 :step/content {:db/id #edb/ref 17592186366829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb80e6b3-5eec-5bc1-b118-b2f215f56474" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(y-x){e}^{-x}-x(x+y){e}^{y}" :db/id #edb/ref 17592186366831} {:answer/id #uuid "f71527c4-7d0b-5d0c-824e-c74e01fec90e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(y-x){e}^{-x}-(x+y){e}^{y}" :db/id #edb/ref 17592186366832} {:answer/id #uuid "45d127b0-856e-53d2-9108-fa49820d507a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(1-x){e}^{-x}-x(1+y){e}^{y}" :db/id #edb/ref 17592186366833} {:answer/id #uuid "482f638e-33f3-58fb-9ace-068365945fae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(2-x){e}^{-x}+x(2+y){e}^{y}" :db/id #edb/ref 17592186366834} {:answer/id #uuid "5d73ac97-8242-529d-aec9-f7267dcb85b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y(1+x){e}^{-x}+x(1-y){e}^{y}" :db/id #edb/ref 17592186366835}] :answer-field/correct {:db/id #edb/ref 17592186366833} :answer-field/id #uuid "03cf2268-b570-5c67-90e0-2744f755a552" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186366830}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7b1a781a-78fd-56cb-a627-519454aac978" :question/math-academy-id "q-105654" :question/problem "Given that $F(x,y)=⟨y{e}^{-x},-y{e}^{y}⟩$ and $f(x,y)=x,$ calculate $∇\\cdot (f\\,F).$" :question/worked-solution "We will use the following identity:\n\n$$\n∇\\cdot (f\\,F)=f\\,∇\\cdot F+F\\cdot ∇f\n$$\n\nFirst, we compute $∇\\cdot F$ and $∇f.$ We get\n\n$$\n\\begin{aligned}∇f & =⟨1,0⟩, \\\\ ∇\\cdot F & =\\frac{∂}{∂x}(y{e}^{-x})+\\frac{∂}{∂y}(-y{e}^{y})=-y{e}^{-x}-{e}^{y}-y{e}^{y}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot (f\\,F) & =f\\,∇\\cdot F+F\\cdot ∇f \\\\  & =x(-y{e}^{-x}-{e}^{y}-y{e}^{y})+⟨y{e}^{-x},-y{e}^{y}⟩\\cdot ⟨1,0⟩ \\\\  & =-yx{e}^{-x}-x{e}^{y}-yx{e}^{y}+y{e}^{-x} \\\\  & =y{e}^{-x}-yx{e}^{-x}-x{e}^{y}-yx{e}^{y} \\\\  & =y(1-x){e}^{-x}-x(1+y){e}^{y}.\\end{aligned}\n$$"} :step/id #uuid "0017b014-af13-5dd7-825c-45a467efd98c" :step/next {:db/id #edb/ref 17592186505890}} {:db/id #edb/ref 17592186505857 :step/content {:db/id #edb/ref 17592186505757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39889727-a276-5682-8ef7-8911020878d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "xz(3xz+\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186505204} {:answer/id #uuid "4441e299-9c2b-5890-9b2f-cf910acd93da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "xz(1+xz+\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186505243} {:answer/id #uuid "5670544a-efa4-5dea-bb60-d1317fd8ae11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "xz(1+3yxz+2y\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186505277} {:answer/id #uuid "b1f47d0b-4c4f-560a-896d-281726884e02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "xz(1+3{x}^{2}{z}^{2}+2xz\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186505452} {:answer/id #uuid "c2a78d89-bcff-52b4-a64b-a195e189c0f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "xz(1+3xz+2\\operatorname{ln}⁡x)" :db/id #edb/ref 17592186505481}] :answer-field/correct {:db/id #edb/ref 17592186505481} :answer-field/id #uuid "8ba8f018-adaf-5841-94d1-797bd241ddf9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186505670}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "37458a2a-1dd8-5f4b-97d7-084609fd0a20" :question/math-academy-id "q-131291" :question/problem "Given that $F(x,y,z)=⟨\\operatorname{ln}⁡x,x{z}^{3},{z}^{2}⟩$ and $f(x,y,z)={x}^{2}z,$ calculate $∇\\cdot (f\\,F).$" :question/worked-solution "We will use the following identity:\n\n$$\n∇\\cdot (f\\,F)=f\\,∇\\cdot F+F\\cdot ∇f\n$$\n\nFirst, we compute $∇\\cdot F$ and $∇f.$ We get\n\n$$\n\\begin{aligned}∇f & =⟨2xz,0,{x}^{2}⟩, \\\\ ∇\\cdot F & =\\frac{∂}{∂x}(\\operatorname{ln}⁡x)+\\frac{∂}{∂y}(x{z}^{3})+\\frac{∂}{∂z}({z}^{2})=\\frac{1}{x}+2z.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot (f\\,F) & =f\\,∇\\cdot F+F\\cdot ∇f \\\\  & ={x}^{2}z(\\frac{1}{x}+2z)+⟨\\operatorname{ln}⁡x,x{z}^{3},{z}^{2}⟩\\cdot ⟨2xz,0,{x}^{2}⟩ \\\\  & =xz+2{x}^{2}{z}^{2}+2xz\\operatorname{ln}⁡x+{x}^{2}{z}^{2} \\\\  & =xz+3{x}^{2}{z}^{2}+2xz\\operatorname{ln}⁡x \\\\  & =xz(1+3xz+2\\operatorname{ln}⁡x).\\end{aligned}\n$$"} :step/id #uuid "2ef3bb86-4410-5f70-b715-2125b5cff05f"} {:db/id #edb/ref 17592186505871 :step/content {:db/id #edb/ref 17592186179909 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143af2bb-452a-5104-bc81-562dee768a4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1+2x){e}^{2x}+2xz" :db/id #edb/ref 17592186238219} {:answer/id #uuid "7c350bea-10b9-5854-9b70-41a8fa29fd20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x{e}^{2x}+xz" :db/id #edb/ref 17592186239128} {:answer/id #uuid "99cb3b1b-8973-5a5f-b31a-75e39652f5ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x{e}^{2x}+{z}^{2}" :db/id #edb/ref 17592186239390} {:answer/id #uuid "bb06be3e-7cda-5bd7-9ebe-adf35ee7424b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1+x){e}^{2x}+xz" :db/id #edb/ref 17592186239682} {:answer/id #uuid "eb86eb60-f49f-59ee-9e69-1943bea23394" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{e}^{2x}+z" :db/id #edb/ref 17592186240127}] :answer-field/correct {:db/id #edb/ref 17592186239128} :answer-field/id #uuid "ea3400a6-fe4f-5f4f-afae-01b7fad81fd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240740}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "208c1557-4948-59e8-ace1-5a9ccf87465a" :question/math-academy-id "q-105633" :question/problem "Calculate $∇\\cdot (\\frac{1}{2}F)$ for the vector field $F$ where\n\n$$\nF=x{e}^{2x}\\,i-y{e}^{2x}\\,j+x{z}^{2}\\,k.\n$$" :question/worked-solution "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following  linearity properties for divergence:\n\n- $∇\\cdot (kF)=k∇\\cdot F$\n\n- $∇\\cdot (F+G)=∇\\cdot F+∇\\cdot G.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\cdot (\\frac{1}{2}F)=\\frac{1}{2}∇\\cdot F.\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\cdot F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂}{∂x}(x{e}^{2x})+\\frac{∂}{∂y}(-y{e}^{2x})+\\frac{∂}{∂z}(x{z}^{2}) \\\\  & ={e}^{2x}+2x{e}^{2x}-{e}^{2x}+2xz \\\\  & =2x{e}^{2x}+2xz.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\cdot (\\frac{1}{2}F) & =\\frac{1}{2}∇\\cdot F \\\\  & =\\frac{1}{2}\\cdot (2x{e}^{2x}+2xz) \\\\  & =x{e}^{2x}+xz.\\end{aligned}\n$$"} :step/id #uuid "5eb56b94-7439-5882-b527-53d920358a26" :step/next {:db/id #edb/ref 17592186505884}} {:db/id #edb/ref 17592186505884 :step/content {:db/id #edb/ref 17592186505751 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04afe455-673f-5b0e-a6fd-b296db94bc7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{sin}⁡x\\,{e}^{\\operatorname{sin}⁡x}-6y\\operatorname{sin}⁡({y}^{2})" :db/id #edb/ref 17592186505114} {:answer/id #uuid "4665da7c-47c6-56a6-8a63-2cd951c60e91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{sin}⁡x\\,{e}^{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186505249} {:answer/id #uuid "54b3d62c-789b-5344-8eb8-1b87f779cb9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{cos}⁡x\\,{e}^{\\operatorname{sin}⁡x}+6y\\operatorname{sin}⁡({y}^{2})" :db/id #edb/ref 17592186505274} {:answer/id #uuid "da097bd7-2039-56d9-b3a9-5eda69cefcfb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{cos}⁡x\\,{e}^{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186505523} {:answer/id #uuid "e85c3dd7-de42-550d-b590-57c43fa3e773" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{cos}⁡x\\,{e}^{\\operatorname{sin}⁡x}-12y\\operatorname{sin}⁡({y}^{2})" :db/id #edb/ref 17592186505558}] :answer-field/correct {:db/id #edb/ref 17592186505523} :answer-field/id #uuid "4ffd1f69-02c8-5ee4-adf9-edd55635cbea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186505646}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2c768058-b351-51d4-a894-a96f2a63f5a2" :question/math-academy-id "q-105639" :question/problem "Calculate $∇\\cdot (3F+2G)$ for the vector fields $F$ and $G,$ where\n\n$$\nF={e}^{\\operatorname{sin}⁡x}\\,i+\\operatorname{cos}⁡({y}^{2})\\,j,\\,∇\\cdot G=3y\\operatorname{sin}⁡({y}^{2}).\n$$" :question/worked-solution "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following  linearity properties for divergence:\n\n- $∇\\cdot (kF)=k∇\\cdot F$\n\n- $∇\\cdot (F+G)=∇\\cdot F+∇\\cdot G.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\cdot (3F+2G) & =∇\\cdot (3F)+∇\\cdot (2G) \\\\  & =3∇\\cdot F+2∇\\cdot G.\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\cdot F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂}{∂x}({e}^{\\operatorname{sin}⁡x})+\\frac{∂}{∂y}(\\operatorname{cos}⁡({y}^{2})) \\\\  & =\\operatorname{cos}⁡x{e}^{\\operatorname{sin}⁡x}-2y\\operatorname{sin}⁡({y}^{2}).\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\cdot (3F+2G) & =3∇\\cdot F+2∇\\cdot G \\\\  & =3(\\operatorname{cos}⁡x{e}^{\\operatorname{sin}⁡x}-2y\\operatorname{sin}⁡({y}^{2}))+2\\cdot (3y\\operatorname{sin}⁡({y}^{2})) \\\\  & =3\\operatorname{cos}⁡x\\,{e}^{\\operatorname{sin}⁡x}-6y\\operatorname{sin}⁡({y}^{2})+6y\\operatorname{sin}⁡({y}^{2}) \\\\  & =3\\operatorname{cos}⁡x\\,{e}^{\\operatorname{sin}⁡x}.\\end{aligned}\n$$"} :step/id #uuid "a7f009b6-e8bd-5ad5-a7ce-b0ae93ab904e" :step/next {:db/id #edb/ref 17592186505846}} {:db/id #edb/ref 17592186505890 :step/content {:db/id #edb/ref 17592186505762 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "321ce1f2-898d-5430-9186-5d15072c22b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4-12{y}^{2}" :db/id #edb/ref 17592186505192} {:answer/id #uuid "40bcbcfd-b0a9-5f9e-b620-2401616f5850" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1-12{y}^{2}" :db/id #edb/ref 17592186505229} {:answer/id #uuid "51f59a6c-efd5-5c01-9c0b-9478a549ed93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4xyz+{y}^{2}+1" :db/id #edb/ref 17592186505267} {:answer/id #uuid "558eb743-ed39-5b77-8c92-39d8417ede55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x{y}^{2}+1" :db/id #edb/ref 17592186505275} {:answer/id #uuid "f9c811ea-cec4-5a24-807f-3cb9271e236c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16xyz-12{y}^{2}" :db/id #edb/ref 17592186505593}] :answer-field/correct {:db/id #edb/ref 17592186505192} :answer-field/id #uuid "dc2ee70c-3ea3-5fe5-8d90-cd968896e62f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186505715}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4c942870-19a7-5088-91ca-fc84364e3087" :question/math-academy-id "q-131243" :question/problem "Calculate $∇\\cdot (-4F)$ for the vector field $F$ where\n\n$$\nF={x}^{2}yz\\,i+({y}^{3}-y)\\,j-xy{z}^{2}\\,k.\n$$" :question/worked-solution "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following  linearity properties for divergence:\n\n- $∇\\cdot (kF)=k∇\\cdot F$\n\n- $∇\\cdot (F+G)=∇\\cdot F+∇\\cdot G.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\cdot (-4F)=-4∇\\cdot F.\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\cdot F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂}{∂x}({x}^{2}yz)+\\frac{∂}{∂y}({y}^{3}-y)+\\frac{∂}{∂z}(-xy{z}^{2}) \\\\  & =2xyz+3{y}^{2}-1-2xyz \\\\  & =3{y}^{2}-1.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\cdot (-4F) & =-4∇\\cdot F \\\\  & =-4\\cdot (3{y}^{2}-1) \\\\  & =4-12{y}^{2}.\\end{aligned}\n$$"} :step/id #uuid "cff4c98e-4515-5b93-aac2-f02400e27f42" :step/next {:db/id #edb/ref 17592186505857}}] :activity/title "Properties of the Divergence Operator" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505096}]}
