6045417] [17592186490220 #edb/ref 1069 "q-105656" #edb/ref 17592186045417] [17592186490220 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186490220 #edb/ref 1071 "Given that $F(x,y,z)=⟨xy,zy,zx⟩$ and $f(x,y,z)=xyz,$ calculate $∇\\cdot (f\\,F).$" #edb/ref 17592186045417] [17592186490220 #edb/ref 1072 #uuid "19772385-86fe-59c3-9b8a-1626c506e897" #edb/ref 17592186045417] [17592186490220 #edb/ref 1074 "We will use the following identity:\n\n$$\n∇\\cdot (f\\,F)=f\\,∇\\cdot F+F\\cdot ∇f\n$$\n\nFirst, we compute $∇\\cdot F$ and $∇f.$ We get\n\n$$\n\\begin{aligned}∇f & =⟨yz,xz,xy⟩, \\\\ ∇\\cdot F & =\\frac{∂}{∂x}(xy)+\\frac{∂}{∂y}(zy)+\\frac{∂}{∂z}(zx)=y+z+x.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot (f\\,F) & =f\\,∇\\cdot F+F\\cdot ∇f \\\\  & =xyz(x+y+z)+⟨xy,zy,zx⟩\\cdot ⟨yz,xz,xy⟩ \\\\  & =xyz(x+y+z)+x{y}^{2}z+xy{z}^{2}+{x}^{2}yz \\\\  & =xyz(x+y+z)+xyz(x+y+z) \\\\  & =2xyz(x+y+z).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186490329 #edb/ref 1068 #edb/ref 17592186490193 #edb/ref 17592186045417] [17592186490329 #edb/ref 1069 "q-105634" #edb/ref 17592186045417] [17592186490329 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186490329 #edb/ref 1071 "Calculate $∇\\cdot (-3F)$ for the vector field $F$ where\n\n$$\nF=2x\\operatorname{cos}⁡x\\,i+2xy\\operatorname{sin}⁡x\\,j-4z\\,k.\n$$" #edb/ref 17592186045417] [17592186490329 #edb/ref 1072 #uuid "fe02f258-a8c1-593e-bacb-46d349ae065b" #edb/ref 17592186045417] [17592186490329 #edb/ref 1074 "If $F$ and $G$ are vector fields and $k$ is a constant, then we have the following  linearity properties for divergence:\n\n- $∇\\cdot (kF)=k∇\\cdot F$\n\n- $∇\\cdot (F+G)=∇\\cdot F+∇\\cdot G.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\cdot (-3F) & =-3∇\\cdot F.\\end{aligned}\n$$\n\nFirst, we need to calculate $∇\\cdot F.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂}{∂x}(2x\\operatorname{cos}⁡x)+\\frac{∂}{∂y}(2xy\\operatorname{sin}⁡x)-\\frac{∂}{∂z}(4z) \\\\  & =2\\operatorname{cos}⁡x-2x\\operatorname{sin}⁡x+2x\\operatorname{sin}⁡x-4 \\\\  & =2\\operatorname{cos}⁡x-4 \\\\  & =2(\\operatorname{cos}⁡x-2)\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\cdot (-3F) & =-3∇\\cdot F \\\\  & =-3\\cdot 2(\\operatorname{cos}⁡x-2) \\\\  & =6(2-\\operatorname{cos}⁡x).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186505096 #edb/ref 1043 #edb/ref 17592186505846 #edb/ref 17592186045417] [17592186505096 #edb/ref 1043 #edb/ref 17592186505857 #edb/ref 17592186045417] [17592186505096 #edb/ref 1043 #edb/ref 17592186505871 #edb/ref 17592186045417] [17592186505096 #edb/ref 1043 #edb/ref 17592186505884 #edb/ref 17592186045417] [17592186505096 #edb/ref 1043 #edb/ref 17592186505890 #edb/ref 17592186045417] [17592186505096 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186505096 #edb/ref 1045 "Properties of the Divergence Operator" #edb/ref 17592186045417] [17592186505096 #edb/ref 1046 #edb/ref 17592186505871 #edb/ref 17592186045417] [17592186505096 #edb/ref 1048 #edb/ref 17592186046659 #edb/ref 17592186045417] [17592186505096 #edb/ref 1049 #edb/ref 17592186049765 #edb/ref 17592186045417] [17592186505096 #edb/ref 1053 #uuid "43cd0e68-5cb8-572a-ba2e-ef8b0404ffac" #edb/ref 17592186045417] [17592186505114 #edb/ref 1080 "3\\operatorname{sin}⁡x\\,{e}^{\\operatorname{sin}⁡x}-6y\\operatorname{sin}⁡({y}^{2})" #edb/ref 17592186045417] [17592186505114 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186505114 #edb/ref 1083 #uuid "04afe455-673f-5b0e-a6fd-b296db94bc7e" #edb/ref 17592186045417] [17592186505192 #edb/ref 1080 "4-12{y}^{2}" #edb/ref 17592186045417] [17592186505192 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186505192 #edb/ref 1083 #uuid "321ce1f2-898d-5430-9186-5d15072c22b0" #edb/ref 17592186045417] [17592186505204 #edb/ref 1080 "xz(3xz+\\operatorname{ln}⁡x)" #edb/ref 17592186045417] [17592186505204 #edb/ref 1082