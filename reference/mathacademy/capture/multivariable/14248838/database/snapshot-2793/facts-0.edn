e23d2681" #edb/ref 17592186045417] [17592186050123 #edb/ref 1027 #edb/ref 17592186049482 #edb/ref 17592186045417] [17592186050123 #edb/ref 1027 #edb/ref 17592186050005 #edb/ref 17592186045417] [17592186050123 #edb/ref 1027 #edb/ref 17592186050851 #edb/ref 17592186045417] [17592186050123 #edb/ref 1028 #edb/ref 17592186124587 #edb/ref 17592186045417] [17592186050123 #edb/ref 1028 #edb/ref 17592186124588 #edb/ref 17592186045417] [17592186050123 #edb/ref 1031 "Cylinders" #edb/ref 17592186045417] [17592186050123 #edb/ref 1033 1895 #edb/ref 17592186045417] [17592186050123 #edb/ref 1034 1.0 #edb/ref 17592186045436] [17592186050123 #edb/ref 1035 #uuid "2eaffcb9-29e5-5903-a02d-080ab3e7a821" #edb/ref 17592186045417] [17592186050885 #edb/ref 1027 #edb/ref 17592186049147 #edb/ref 17592186045417] [17592186050885 #edb/ref 1027 #edb/ref 17592186049765 #edb/ref 17592186045417] [17592186050885 #edb/ref 1027 #edb/ref 17592186049826 #edb/ref 17592186045417] [17592186050885 #edb/ref 1027 #edb/ref 17592186050983 #edb/ref 17592186045417] [17592186050885 #edb/ref 1028 #edb/ref 17592186179712 #edb/ref 17592186045417] [17592186050885 #edb/ref 1028 #edb/ref 17592186179714 #edb/ref 17592186045417] [17592186050885 #edb/ref 1028 #edb/ref 17592186179719 #edb/ref 17592186045417] [17592186050885 #edb/ref 1029 #edb/ref 17592186429143 #edb/ref 17592186045436] [17592186050885 #edb/ref 1031 "Gradient Vector Fields" #edb/ref 17592186045417] [17592186050885 #edb/ref 1033 3692 #edb/ref 17592186045417] [17592186050885 #edb/ref 1034 0.9436080156561308 #edb/ref 17592186045436] [17592186050885 #edb/ref 1035 #uuid "6e3d5713-6e26-51db-8b8f-61d36b28e342" #edb/ref 17592186045417] [17592186179404 #edb/ref 1075 #edb/ref 17592186489587 #edb/ref 17592186045417] [17592186179404 #edb/ref 1075 #edb/ref 17592186489614 #edb/ref 17592186045417] [17592186179404 #edb/ref 1075 #edb/ref 17592186489650 #edb/ref 17592186045417] [17592186179404 #edb/ref 1075 #edb/ref 17592186489781 #edb/ref 17592186045417] [17592186179404 #edb/ref 1075 #edb/ref 17592186489967 #edb/ref 17592186045417] [17592186179404 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186179404 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186179404 #edb/ref 1078 #edb/ref 17592186489650 #edb/ref 17592186045417] [17592186179404 #edb/ref 1079 #uuid "9c37c60e-e97b-5fd7-8819-529b45993a1f" #edb/ref 17592186045417] [17592186179547 #edb/ref 1069 "e-8742" #edb/ref 17592186045417] [17592186179547 #edb/ref 1071 "Calculate $\\nabla \\cdot (\\mathbf{F}-3\\mathbf{G})$ for the vector fields $\\mathbf F$ and $\\mathbf G,$ where\n\n$$\n\\mathbf{F}=\\left(x^2+y\\right)\\,\\mathbf{i}+ \\left(xy-y^2\\right)\\,\\mathbf{j}, \\quad \\nabla \\cdot \\mathbf{G}=x+y.\n$$" #edb/ref 17592186045417] [17592186179547 #edb/ref 1072 #uuid "bb7ae99a-b8d9-5e4d-906c-9e18d22c1404" #edb/ref 17592186045417] [17592186179547 #edb/ref 1074 "If $\\mathbf F$ and $\\mathbf G$ are vector fields and $k$ is a constant, then we have the following  linearity properties for divergence:\n\n- $\\nabla \\cdot (k \\mathbf F) = k \\nabla \\cdot \\mathbf F$\n\n- $\\nabla \\cdot (\\mathbf F + \\mathbf G) = \\nabla \\cdot \\mathbf F + \\nabla \\cdot \\mathbf G$\n\nIn our case, we have\n\n$$\n\\begin{aligned}∇\\cdot (F-3G) & =∇\\cdot (F)+∇\\cdot (-3G) \\\\  & =∇\\cdot F-3∇\\cdot G.\\end{aligned}\n$$\n\nFirst, we need to calculate $\\nabla \\cdot \\mathbf{F}.$ In doing so, we get\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂}{∂x}({x}^{2}+y)+\\frac{∂}{∂y}(xy-{y}^{2}) \\\\  & =2x+x-2y \\\\  & =3x-2y.\\end{aligned}\n$$\n\nApplying the linearity properties, we get\n\n$$\n\\begin{aligned}∇\\cdot (F-3G) & =∇\\cdot F-3∇\\cdot G \\\\  & =(3x-2y)-3\\cdot (x+y) \\\\  & =-5y.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186179549 #edb/ref 1069 "e-8928" #edb/ref 17592186045417] [17592186179549 #edb/ref 1071 "Given that $\\mathbf F(x,y) = \\left\\langle \\dfrac 1x, xy \\right \\rangle$ and $f(x,y) = \\dfrac 1{x},$ calculate $\\nabla \\cdot (f\\,\\mathbf F).$" #edb/ref 17592186045417] [17592186179549 #edb/ref 1072 #uuid "7de054d4-8384-5aab-b2c4-a43b1f86a16c" #edb/ref 17592186045417] [17592186179549 #edb/ref 1074 "We will use the following identity:\n\n$$\n\\nabla \\cdot (f\\,\\mathbf F) = f\\, \\nabla \\cdot \\mathbf {F}+  \\mathbf F \\cdot \\nabla f\n$$\n\nFirst, we compute $\\nabla \\cdot \\mathbf {F}$ and $\\nabla f.$ We get\n\n$$\n\\begin{aligned}∇f & =⟨-\\frac{1}{{x}^{2}},0⟩, \\\\ ∇\\cdot F & =\\frac{∂}{∂x}(\\frac{1}{x})+\\frac{∂}{∂y}(xy)=-\\frac{1}{{x}^{2}}+x.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot (f\\,F) & =f\\,∇\\cdot F+F\\cdot ∇f \\\\  & =\\frac{1}{x}(-\\frac{1}{{x}^{2}}+x)+⟨\\frac{1}{x},xy⟩\\cdot ⟨-\\frac{1}{{x}^{2}},0⟩ \\\\  & =-\\frac{1}{{x}^{3}}+1-\\frac{1}{{x}^{3}} \\\\  & =1-\\frac{2}{{x}^{3}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186179688 #edb/ref 1037 #edb/ref 17592186048932 #edb/ref 17592186045417] [17592186179688 #edb/ref 1037 #edb/ref 17592186049459 #edb/ref 17592186045417] [17592186179688 #edb/ref 1038 #edb/ref 17592186179909 #edb/ref 17592186045417] [17592186179688 #edb/ref 1038 #edb/ref 17592186180185 #edb/ref 17592186045417] [17592186179688 #edb/ref 1038 #edb/ref 17592186241093 #edb/ref 17592186045417] [17592186179688 #edb/ref 1038 #edb/ref 17592186241096 #edb/ref 17592186045417] [17592186179688 #edb/ref 1038 #edb/ref 17592186241097 #edb/ref 17592186045417] [17592186179688 #edb/ref 1038 #edb/ref 17592186241098 #edb/ref 17592186045417] [17592186179688 #edb/ref 1038 #edb/ref 17592186367359 #edb/ref 17592186045417] [17592186179688 #edb/ref 1038 #edb/ref 17592186367366 #edb/ref 17592186045417] [17592186179688 #edb/ref 1038 #edb/ref 17592186490261 #edb/ref 17592186045417] [17592186179688 #edb/ref 1038 #edb/ref 17592186490329 #edb/ref 17592186045417] [17592186179688 #edb/ref 1038 #edb/ref 17592186505751 #edb/ref 17592186045417] [17592186179688 #edb/ref 1038 #edb/ref 17592186505762 #edb/ref 17592186045417] [17592186179688 #edb/ref 1039 "Finding the Divergence of a