#{[{:db/id #edb/ref 17592186495061 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186495044 :knowledge-point/id #uuid "247d98e4-8f13-5536-8ad6-00a14e476caf" :knowledge-point/title "Computing a Unit Price With Conversion to Larger Units"}] :question/id #uuid "13572493-e244-5164-b0c2-a6c101cfeecc" :question/math-academy-id "e-22088" :question/problem "A bottle contains $32$ fluid ounces of juice and costs $\\[math]8.00.$ What's the unit price per cup?\n\nAssume that there are $8$ fluid ounces in one cup." :question/worked-solution "First, we convert from fluid ounces to cups. There are $8$ fluid ounces in each cup, so we divide the number of fluid ounces by $8\\mathbin{:}$  \n\n$$\n32 \\div 8 = 4\n$$\n\nSo, $32$ fluid ounces is the same as $4$ cups.  \n\nNow, to find the unit price per cup, we divide the total price by $4\\mathbin{:}$  \n\n$$\n8.00 \\div 4 = 2\n$$\n\nTherefore, the juice costs $\\[math]2.00$ per cup."}] [{:db/id #edb/ref 17592186495168 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186495045 :knowledge-point/id #uuid "60ccce15-6e30-58e5-a087-52100ebb460b" :knowledge-point/title "Computing a Unit Price With Conversion to Smaller Units"}] :question/id #uuid "f60f0711-fce9-525f-a2d1-fdf86ccef7b9" :question/math-academy-id "e-4541" :question/problem "A $5$-gallon jug of water costs $\\[math] 7.60.$ What is the price per quart?" :question/worked-solution "First, we convert from gallons to quarts. There are $4$ quarts in each gallon, so we multiply the number of gallons by $4\\mathbin{:}$\n\n$$\n5 \\times 4 = 20\n$$\n\nSo $5$ gallons is the same as $20$ quarts. Now, to find the price per quart, we divide the total price by $20\\mathbin{:}$\n\n$$\n7.60 \\div 20 = 0.38\n$$\n\nTherefore, the water costs $\\[math] 0.38$ per quart."}] [{:db/id #edb/ref 17592186495053 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186495041 :knowledge-point/id #uuid "01ca542e-437b-5564-8d9a-cf9249ab53b9" :knowledge-point/title "Computing a Unit Price"}] :question/id #uuid "05aac4e0-eee5-5923-80d0-059ceee6159d" :question/math-academy-id "e-4543" :question/problem "A $3$-pound bag of flour costs $\\[math] 6.42.$ What is the price per pound?" :question/worked-solution "To find the unit price, we divide the total cost by the number of pounds:\n\n$$\n6.42  \\div 3 = 2.14\n$$\n\nTherefore, the unit price is $\\[math] 2.14$ per pound."}] [{:db/id #edb/ref 17592186495101 :knowledge-point/_questions [{:db/id #edb/ref 17592186495041 :knowledge-point/id #uuid "01ca542e-437b-5564-8d9a-cf9249ab53b9" :knowledge-point/title "Computing a Unit Price"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c389069-27bc-5179-a251-28109cbe8187" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$0.65$ per apple" :db/id #edb/ref 17592186494373} {:answer/id #uuid "2a106a49-fffa-5972-ade2-a515fcd59902" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$0.85$ per apple" :db/id #edb/ref 17592186494397} {:answer/id #uuid "35e20c59-9e9f-5a77-af97-5d9b13629e2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$0.80$ per apple" :db/id #edb/ref 17592186494428} {:answer/id #uuid "3ac5e0ac-b27d-5e66-8472-d3a3b8fce0f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$0.70$ per apple" :db/id #edb/ref 17592186494440} {:answer/id #uuid "c9df3091-07d2-5ad2-a5a7-3f7e15a91d22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$0.75$ per apple" :db/id #edb/ref 17592186494795}] :answer-field/correct {:answer/id #uuid "c9df3091-07d2-5ad2-a5a7-3f7e15a91d22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$0.75$ per apple" :db/id #edb/ref 17592186494795} :answer-field/id #uuid "604450bb-7485-5a9c-8bc9-858c05d55e75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494959}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7afa9cdc-11d7-5a67-8844-54f32a535758" :question/math-academy-id "q-354879" :question/problem "A bag of five apples costs $$3.75.$ What is the unit price per apple?" :question/worked-solution "To find the unit price, we divide the total cost by the number of apples:\n\n$$\n3.75÷5=0.75\n$$\n\nTherefore, the unit price is $$0.75$ per apple."}] [{:db/id #edb/ref 17592186495115 :knowledge-point/_questions [{:db/id #edb/ref 17592186495041 :knowledge-point/id #uuid "01ca542e-437b-5564-8d9a-cf9249ab53b9" :knowledge-point/title "Computing a Unit Price"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05d397e7-bcb2-5e73-8974-a1ed731b2bf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1.25$ per battery" :db/id #edb/ref 17592186494329} {:answer/id #uuid "358fbc67-be42-50cd-bd4d-7f09efcb7af5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1.15$ per battery" :db/id #edb/ref 17592186494426} {:answer/id #uuid "d60d1f83-8c2c-517e-9dde-b3495f84a596" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1.35$ per battery" :db/id #edb/ref 17592186494823} {:answer/id #uuid "f0df80e7-5e02-5cf0-83da-75540ba671df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1.45$ per battery" :db/id #edb/ref 17592186494888} {:answer/id #uuid "fbca79db-f831-590d-804c-1cfb99e37fcd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1.40$ per battery" :db/id #edb/ref 17592186494910}] :answer-field/correct {:answer/id #uuid "d60d1f83-8c2c-517e-9dde-b3495f84a596" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1.35$ per battery" :db/id #edb/ref 17592186494823} :a