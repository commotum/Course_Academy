#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186495248} :activity/id #uuid "a2a7902b-50ad-5025-aee1-406a52f48bac" :activity/scope {:db/id #edb/ref 17592186495276 :topic/id #uuid "cef7c109-a883-5959-842c-c3cb8202ae04" :topic/math-academy-id 2555} :activity/steps [{:db/id #edb/ref 17592186495184 :step/content {:db/id #edb/ref 17592186495041 :knowledge-point/canonical-example {:db/id #edb/ref 17592186495053 :question/id #uuid "05aac4e0-eee5-5923-80d0-059ceee6159d" :question/math-academy-id "e-4543"} :knowledge-point/id #uuid "01ca542e-437b-5564-8d9a-cf9249ab53b9" :knowledge-point/questions [{:db/id #edb/ref 17592186495087} {:db/id #edb/ref 17592186495101} {:db/id #edb/ref 17592186495115} {:db/id #edb/ref 17592186495124} {:db/id #edb/ref 17592186495163}] :knowledge-point/title "Computing a Unit Price"} :step/id #uuid "1885e554-32d8-511b-808d-67d60f7399df" :step/math-academy-id 616165 :step/next {:db/id #edb/ref 17592186495249}} {:db/id #edb/ref 17592186495214 :step/content {:db/id #edb/ref 17592186495045 :knowledge-point/canonical-example {:db/id #edb/ref 17592186495168 :question/id #uuid "f60f0711-fce9-525f-a2d1-fdf86ccef7b9" :question/math-academy-id "e-4541"} :knowledge-point/id #uuid "60ccce15-6e30-58e5-a087-52100ebb460b" :knowledge-point/questions [{:db/id #edb/ref 17592186495054} {:db/id #edb/ref 17592186495067} {:db/id #edb/ref 17592186495090} {:db/id #edb/ref 17592186495113} {:db/id #edb/ref 17592186495133}] :knowledge-point/title "Computing a Unit Price With Conversion to Smaller Units"} :step/id #uuid "76ea330a-6861-5c40-a2ba-13e287e50b81" :step/math-academy-id 616169 :step/next {:db/id #edb/ref 17592186495239}} {:db/id #edb/ref 17592186495239 :step/content {:db/id #edb/ref 17592186495044 :knowledge-point/canonical-example {:db/id #edb/ref 17592186495061 :question/id #uuid "13572493-e244-5164-b0c2-a6c101cfeecc" :question/math-academy-id "e-22088"} :knowledge-point/id #uuid "247d98e4-8f13-5536-8ad6-00a14e476caf" :knowledge-point/questions [{:db/id #edb/ref 17592186495080} {:db/id #edb/ref 17592186495104} {:db/id #edb/ref 17592186495123} {:db/id #edb/ref 17592186495127} {:db/id #edb/ref 17592186495130}] :knowledge-point/title "Computing a Unit Price With Conversion to Larger Units"} :step/id #uuid "aedb1d7d-de1a-5c5e-bb8b-a9a5130bbd17" :step/math-academy-id 616172} {:db/id #edb/ref 17592186495248 :step/content {:db/id #edb/ref 17592186495279 :tutorial/content "A **unit price** is the price of a single item. To compute a unit price, we divide the total cost of a group of items by the number of items in the group.\n\nFor example, suppose a store sells a pack of $3$ shirts for $\\[math]12.$ \n\nTo find the unit price, we divide the total cost by the number of shirts:\n\n$$\n12 \\div 3  = 4\n$$\n\nTherefore, the unit price is $\\[/math]4$ per shirt." :tutorial/id #uuid "1e8ab0cc-4a5e-57ca-a168-f89d110ff113" :tutorial/math-academy-id 3104 :tutorial/title "Introduction"} :step/id #uuid "bd03cc48-369a-5495-aa96-7aa335bd67c7" :step/math-academy-id 616164 :step/next {:db/id #edb/ref 17592186495184}} {:db/id #edb/ref 17592186495249 :step/content {:db/id #edb/ref 17592186495277 :tutorial/content "Now, suppose that installing a fence costs $\\[math]360$ per yard. What would be the unit price per foot?\n\nFirst, notice that there are $3$ feet in $1$ yard.  \n\nTo find the unit price per foot, we *divide* the price per yard by $3\\mathbin{:}$\n\n$$\n360 \\div 3 = 120\n$$\n\nTherefore, installing the fence costs $\\[/math]120$ per foot.\n\nIn reverse, if we know that installing a fence costs $\\[math]120$ per foot, to find the unit price per yard, we would need to *multiply* the price per foot by $3\\mathbin{:}$\n\n$$\n120 \\times 3 = 360\n$$" :tutorial/id #uuid "15c0e757-69bb-5bfd-a417-6de7c79fa333" :tutorial/math-academy-id 15094 :tutorial/title "Unit Prices With Units Conversions"} :step/id #uuid "c1f9c4d4-8e93-5221-9ae9-b9e48f28f0d1" :step/math-academy-id 616168 :step/next {:db/id #edb/ref 17592186495214}}] :activity/title "Finding Unit Prices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186494312}]}
