#{[{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186540138} :activity/id #uuid "7e8bd6ba-d79f-543e-8fa1-667b1c64ec38" :activity/scope {:db/id #edb/ref 17592186049599 :topic/id #uuid "037b0d93-34cd-5a42-ba84-c5981f5414d3" :topic/math-academy-id 304} :activity/steps [{:db/id #edb/ref 17592186540120 :step/content {:db/id #edb/ref 17592186360657 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34f21ae4-3bbd-5f52-9456-b5220871e5ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{sinh}⁡y-5\\operatorname{csch}⁡y+C" :db/id #edb/ref 17592186358226} {:answer/id #uuid "3df0a75d-1388-5ef4-ae4c-ce34b74fb7b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{sinh}⁡y-5\\operatorname{sech}⁡y+C" :db/id #edb/ref 17592186358283} {:answer/id #uuid "7ba5cd56-ef5b-53b3-a55e-b612b62437eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{sech}⁡y+3\\operatorname{sinh}⁡y+C" :db/id #edb/ref 17592186358824} {:answer/id #uuid "c06e8d01-a9b7-57e4-a41c-75fbf89dcdbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5\\operatorname{csch}⁡y-3\\operatorname{sinh}⁡y+C" :db/id #edb/ref 17592186359438} {:answer/id #uuid "e7dc376a-6769-594a-9b6e-1bba55651ddc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{csch}⁡y+3\\operatorname{sinh}⁡y+C" :db/id #edb/ref 17592186359808}] :answer-field/correct {:db/id #edb/ref 17592186358226} :answer-field/id #uuid "7a988df6-5d8e-5a06-9bb3-2fec94684146" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360196}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d018b49f-e1fe-58f1-a547-0984f48d4220" :question/math-academy-id "q-96003" :question/problem "$\\int (5\\operatorname{csch}⁡y\\operatorname{coth}⁡y+3\\operatorname{cosh}⁡y)\\text{d}y=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}y}(\\operatorname{sinh}⁡y)=\\operatorname{cosh}⁡y & \\,⇒\\,\\int \\operatorname{cosh}⁡y\\,\\text{d}y=\\operatorname{sinh}⁡y+C, \\\\ \\frac{\\text{d}}{\\text{d}y}(\\operatorname{csch}⁡y)=-\\operatorname{csch}⁡y\\operatorname{coth}⁡y & \\,⇒\\,\\int \\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y=-\\operatorname{csch}⁡y+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (5\\operatorname{csch}⁡y\\operatorname{coth}⁡y+3\\operatorname{cosh}⁡y)\\text{d}y & =\\int 5\\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y+\\int 3\\operatorname{cosh}⁡y\\,\\text{d}y \\\\  & =5\\int \\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y+3\\int \\operatorname{cosh}⁡y\\,\\text{d}y \\\\  & =5(-\\operatorname{csch}⁡y)+3\\operatorname{sinh}⁡y+C \\\\  & =3\\operatorname{sinh}⁡y-5\\operatorname{csch}⁡y+C.\\end{aligned}\n$$"} :step/id #uuid "0e7302eb-f9b0-5746-9b38-56ab44f97bec" :step/next {:db/id #edb/ref 17592186540173}} {:db/id #edb/ref 17592186540138 :step/content {:db/id #edb/ref 17592186360654 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1473c54b-b477-5490-a25f-73764936d54f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{csch}⁡t+C" :db/id #edb/ref 17592186357928} {:answer/id #uuid "33b02f8d-54d8-56a4-968a-25354d52b97a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sech}^{2}⁡t+C" :db/id #edb/ref 17592186358212} {:answer/id #uuid "9b48c0d2-6cc3-59d3-af8a-2f25cf4467fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{sech}⁡t+C" :db/id #edb/ref 17592186359110} {:answer/id #uuid "c7c76757-8c0a-54a2-83c8-307dd62efaf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sech}⁡t+C" :db/id #edb/ref 17592186359507} {:answer/id #uuid "cb5e41c8-6c8c-5180-94bd-f1ea710ba024" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{csch}⁡t+C" :db/id #edb/ref 17592186359538}] :answer-field/correct {:db/id #edb/ref 17592186359507} :answer-field/id #uuid "45326baa-4df9-5040-8abb-5411890e7617" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360100}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4e875766-b72a-5ff5-9925-981d435c7235" :question/math-academy-id "q-95999" :question/problem "$\\int (-\\operatorname{sech}⁡t\\operatorname{tanh}⁡t)\\,\\text{d}t=$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sech}⁡t)=-\\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,⇒\\,\\int \\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,\\text{d}t=-\\operatorname{sech}⁡t+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-\\operatorname{sech}⁡t\\operatorname{tanh}⁡t)\\,\\text{d}t & =-\\int \\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,\\text{d}t \\\\  & =-(-\\operatorname{sech}⁡t)+C \\\\  & =\\operatorname{sech}⁡t+C.\\end{aligned}\n$$"} :step/id #uuid "521b2668-06f0-5a0c-b6fd-78857ff1ecd8" :step/next {:db/id #edb/ref 17592186540120}} {:db/id #edb/ref 17592186540163 :step/content {:db/id #edb/ref 17592186540078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "415f038f-67ba-5731-a5d9-4c493aae49d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\theta +3\\operatorname{tanh}⁡\\theta +C" :db/id #edb/ref 17592186539597} {:answer/id #uuid "611583f3-73a3-5910-9337-e629d7e0cca7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\theta -3\\operatorname{coth}⁡\\theta +C" :db/id #edb/ref 17592186539642} {:answer/id #uuid "cd3bf55a-7e91-578c-ac7e-93c48a3a031c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4+3\\operatorname{coth}⁡\\theta +C" :db/id #edb/ref 17592186539832} {:answer/id #uuid "de1f39e7-a858-5e32-867a-fa83afb3cc0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\theta -3\\operatorname{tanh}⁡\\theta +C" :db/id #edb/ref 17592186539860} {:answer/id #uuid "f7abe1a8-28a1-5586-879d-579b4850ac51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4-3\\operatorname{tanh}⁡\\theta +C" :db/id #edb/ref 17592186539898}] :answer-field/correct {:db/id #edb/ref 17592186539860} :answer-field/id #uuid "4e18955b-050b-5a8f-9af9-f9eafd8a4e09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186539955}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a2700145-f14c-508c-9486-f4eea106d539" :question/math-academy-id "q-96016" :question/problem "$\\int (4-3{sech}^{2}⁡\\theta )\\,\\text{d}\\theta =$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{tanh}⁡\\theta )={sech}^{2}⁡\\theta \\,⇒\\,\\int {sech}^{2}⁡\\theta \\,\\text{d}\\theta =\\operatorname{tanh}⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (4-3{sech}^{2}⁡\\theta )\\,\\text{d}\\theta  & =\\int 4\\,\\text{d}\\theta +\\int (-3{sech}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =4\\int \\,\\text{d}\\theta -3\\int {sech}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =4\\theta -3\\operatorname{tanh}⁡\\theta +C.\\end{aligned}\n$$"} :step/id #uuid "b3337935-86ec-55dd-bf71-539e84f21a0e" :step/next {:db/id #edb/ref 17592186540180}} {:db/id #edb/ref 17592186540173 :step/content {:db/id #edb/ref 17592186360660 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04a315b7-3ed1-5502-8a2c-5245de5ec104" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tanh}⁡t+C" :db/id #edb/ref 17592186357795} {:answer/id #uuid "12b2dd2f-cbee-533e-a87e-2fc871d335c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{coth}⁡t+C" :db/id #edb/ref 17592186357912} {:answer/id #uuid "3ce50708-f792-5af5-920f-c2b0bc68c31b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{coth}⁡t+C" :db/id #edb/ref 17592186358275} {:answer/id #uuid "964e1d3c-4cdd-52fa-b88e-ed7b40b59377" :answer/type {:db/id #edb/