f 17592186045417] [17592186360362 #edb/ref 1078 #edb/ref 17592186359066 #edb/ref 17592186045417] [17592186360362 #edb/ref 1079 #uuid "d55c56fa-5bce-57b4-9368-123d78a82dab" #edb/ref 17592186045417] [17592186360654 #edb/ref 1068 #edb/ref 17592186360100 #edb/ref 17592186045417] [17592186360654 #edb/ref 1069 "q-95999" #edb/ref 17592186045417] [17592186360654 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360654 #edb/ref 1071 "$\\int (-\\operatorname{sech}⁡t\\operatorname{tanh}⁡t)\\,\\text{d}t=$" #edb/ref 17592186045417] [17592186360654 #edb/ref 1072 #uuid "4e875766-b72a-5ff5-9925-981d435c7235" #edb/ref 17592186045417] [17592186360654 #edb/ref 1074 "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sech}⁡t)=-\\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,⇒\\,\\int \\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,\\text{d}t=-\\operatorname{sech}⁡t+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-\\operatorname{sech}⁡t\\operatorname{tanh}⁡t)\\,\\text{d}t & =-\\int \\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,\\text{d}t \\\\  & =-(-\\operatorname{sech}⁡t)+C \\\\  & =\\operatorname{sech}⁡t+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360657 #edb/ref 1068 #edb/ref 17592186360196 #edb/ref 17592186045417] [17592186360657 #edb/ref 1069 "q-96003" #edb/ref 17592186045417] [17592186360657 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186360657 #edb/ref 1071 "$\\int (5\\operatorname{csch}⁡y\\operatorname{coth}⁡y+3\\operatorname{cosh}⁡y)\\text{d}y=$" #edb/ref 17592186045417] [17592186360657 #edb/ref 1072 #uuid "d018b49f-e1fe-58f1-a547-0984f48d4220" #edb/ref 17592186045417] [17592186360657 #edb/ref 1074 "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}y}(\\operatorname{sinh}⁡y)=\\operatorname{cosh}⁡y & \\,⇒\\,\\int \\operatorname{cosh}⁡y\\,\\text{d}y=\\operatorname{sinh}⁡y+C, \\\\ \\frac{\\text{d}}{\\text{d}y}(\\operatorname{csch}⁡y)=-\\operatorname{csch}⁡y\\operatorname{coth}⁡y & \\,⇒\\,\\int \\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y=-\\operatorname{csch}⁡y+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (5\\operatorname{csch}⁡y\\operatorname{coth}⁡y+3\\operatorname{cosh}⁡y)\\text{d}y & =\\int 5\\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y+\\int 3\\operatorname{cosh}⁡y\\,\\text{d}y \\\\  & =5\\int \\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y+3\\int \\operatorname{cosh}⁡y\\,\\text{d}y \\\\  & =5(-\\operatorname{csch}⁡y)+3\\operatorname{sinh}⁡y+C \\\\  & =3\\operatorname{sinh}⁡y-5\\operatorname{csch}⁡y+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360660 #edb/ref 1068 #edb/ref 17592186360362 #edb/ref 17592186045417] [17592186360660 #edb/ref 1069 "q-96010" #edb/ref 17592186045417] [17592186360660 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360660 #edb/ref 1071 "$\\int (-{sech}^{2}⁡t)\\,\\text{d}t=$" #edb/ref 17592186045417] [17592186360660 #edb/ref 1072 #uuid "99fbff3e-033b-5736-bc37-e488df1d337d" #edb/ref 17592186045417] [17592186360660 #edb/ref 1074 "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}(\\operatorname{tanh}⁡t)={sech}^{2}⁡t\\,⇒\\,\\int {sech}^{2}⁡t\\,\\text{d}t=\\operatorname{tanh}⁡t+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-{sech}^{2}⁡t)\\,\\text{d}t & =-\\int {sech}^{2}⁡t\\,\\text{d}t \\\\  & =-\\operatorname{tanh}⁡t+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360670 #edb/ref 1068 #edb/ref 17592186360080 #edb/ref 17592186045417] [17592186360670 #edb/ref 1069 "q-96056" #edb/ref 17592186045417] [17592186360670 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186360670 #edb/ref 1071 "$\\int ({csch}^{2}⁡x-4{sech}^{2}⁡x)\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186360670 #edb/ref 1072 #uuid "0bd3b030-22be-5bf9-8f81-05d6c5d82a11" #edb/ref 17592186045417] [17592186360670 #edb/ref 1074 "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)={sech}^{2}⁡x & \\,⇒\\,\\int {sech}^{2}⁡x\\,\\text{d}x=\\operatorname{tanh}⁡x+C, \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x)=-{csch}^{2}⁡x & \\,⇒\\,\\int {csch}^{2}⁡x\\,\\text{d}x=-\\operatorname{coth}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int ({csch}^{2}⁡x-4{sech}^{2}⁡x)\\,\\text{d}x & =\\int {csch}^{2}⁡x\\,\\text{d}x-4\\int {sech}^{2}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{coth}⁡x-4\\operatorname{tanh}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186539473 #edb/ref 1043 #edb/ref 17592186540120 #edb/ref 17592186045417] [17592186539473 #edb/ref 1043 #edb/ref 17592186540138 #edb/ref 17592186045417] [17592186539473 #edb/ref 1043 #edb/ref 17592186540163 #edb/ref 17592186045417] [17592186539473 #edb/ref 1043 #edb/ref 17592186540173 #edb/ref 17592186045417] [17592186539473 #edb/ref 1043 #edb/ref 17592186540180 #edb/ref 17592186045417] [17592186539473 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186539473 #edb/ref 1045 "Integrating Hyperbolic Functions" #edb/ref 17592186045417] [17592186539473 #edb/ref 1046 #edb/ref 17592186540138 #edb/ref 17592186045417] [17592186539473 #edb/ref 1048 #edb/ref 17592186046645 #edb/ref 17592186045417] [17592186539473 #edb/ref 1049 #edb/ref 17592186049599 #edb/ref 17592186045417] [17592186539473 #edb/ref 1053 #uuid "7e8bd6ba-d79f-543e-8fa1-667b1c64ec38" #edb/ref 17592186045417] [17592186539597 #edb/ref 1080 "4\\theta +3\\operatorname{tanh}⁡\\theta +C" #edb/ref 17592186045417] [17592186539597 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186539597 #edb/ref 1083 #uuid "415f038f-67ba-5731-a5d9-4c493aae49d7" #edb/ref 17592186045417] [17592186539642 #edb/ref 1080 "4\\theta -3\\operatorname{coth}⁡\\theta +C" #edb/ref 17592186045417] [17592186539642 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186539642 #edb/ref 1083 #uuid "611583f3-73a3-5910-9337-e629d7e0cca7" #edb/ref 17592186045417] [17592186539832 #edb/ref 1080 "4+3\\operatorname{co