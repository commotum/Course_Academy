  "html": "<div id=\"question-60005\" class=\"question\"><div class=\"questionHeader\"><span class=\"questionNumber\">9.</span><span class=\"helpButton\" questionid=\"60005\">?</span></div><div class=\"questionText\"><p>The following table shows the number of boys and girls at Lincoln High School.</p>\n<table align=\"center\" font-size=\"inherit\" width=\"300px\" style=\"border: 1px solid black\" rules=\"all\" cellpadding=\"5\">\n\n<tbody><tr>\n        <th width=\"50%\" style=\"text-align:center\" bgcolor=\"#D6EAF8\">    Boys    </th>\n        <th width=\"50%\" style=\"text-align:center\" bgcolor=\"#D6EAF8\"> Girls   </th>\n</tr>\n<tr>\n    <td style=\"text-align:center\">   <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"95\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c><mjx-c class=\"mjx-c33\"></mjx-c><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>331</mn></math></mjx-assistive-mml></mjx-container>   </td>\n        <td style=\"text-align:center\">   <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"96\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c34\"></mjx-c><mjx-c class=\"mjx-c35\"></mjx-c><mjx-c class=\"mjx-c37\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>457</mn></math></mjx-assistive-mml></mjx-container>   </td>\n</tr>\n\n\n\n</tbody></table>\n\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"97\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"tru