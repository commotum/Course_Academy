186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186498765} {:answer/id #uuid "3a82c760-70ad-50c5-bb52-457921085692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186498862} {:answer/id #uuid "420b707b-b03d-50d7-88ac-8059253f50ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186498882} {:answer/id #uuid "7ed51ed6-e5d1-59f3-b219-2cccee1d206f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186499016} {:answer/id #uuid "c2bff906-5002-50a8-9291-2c2ce6a14cfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186499158}] :answer-field/correct {:answer/id #uuid "7ed51ed6-e5d1-59f3-b219-2cccee1d206f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186499016} :answer-field/id #uuid "e25fd75f-c1a2-5fc4-925b-ca242e652588" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499417}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c338986-28f6-5449-8d51-483994f85450" :question/math-academy-id "q-59842" :question/problem "An election took place in a small town between two political parties, The Green Party and The Labour Party. The table below shows the total number of votes that each party received.\n\n| The Green Party | The Labour Party |\n| --- | --- |\n| $1\\,020$ | $3\\,022$ |\n\nBy rounding to the nearest hundred, find the approximate ratio of Labour Party votes to total votes." :question/worked-solution "First, let's approximate the total number of votes that each party received by rounding to the nearest hundred.\n\n- The Green Party: $1\\,020⟶1\\,000$\n\n- The Labour Party: $3\\,022⟶3\\,000$\n\nSo the total number of votes received was approximately $1\\,000+3\\,000=4\\,000.$\n\nTherefore, the ratio of Labour Party votes to total votes (expressed as a fraction) is approximately\n\n$$\n\\frac{3\\,000}{4\\,000}.\n$$\n\nDividing the numerator and denominator by $1\\,000$ gives\n\n$$\n\\frac{3\\,000÷1\\,000}{4\\,000÷1\\,000}=\\frac{3}{4}.\n$$\n\nTherefore, the ratio of Labour Party votes to total votes is approximately $\\frac{3}{4}.$"}] [{:db/id #edb/ref 17592186499472 :knowledge-point/_questions [{:db/id #edb/ref 17592186499434 :knowledge-point/id #uuid "01f99115-f376-50c2-9b7e-79800006d437" :knowledge-point/title "Finding a Value Given a Ratio by Rounding an Amount"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "145f15b2-ba16-5a91-9bf3-2a5912c459bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$680$" :db/id #edb/ref 17592186498775} {:answer/id #uuid "5a92a268-16d1-5dcb-b306-a7326a1b05cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$600$" :db/id #edb/ref 17592186498936} {:answer/id #uuid "9d016922-947d-5384-a572-6e8536e06491" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$700$" :db/id #edb/ref 17592186499063} {:answer/id #uuid "a0542525-2af1-509e-b992-a07e3969645a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$560$" :db/id #edb/ref 17592186499071} {:answer/id #uuid "f0600bda-d3d0-5f58-bde8-97ea12f74605" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$500$" :db/id #edb/ref 17592186499270}] :answer-field/correct {:answer/id #uuid "5a92a268-16d1-5dcb-b306-a7326a1b05cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$600$" :db/id #edb/ref 17592186498936} :answer-field/id #uuid "07694784-baf6-5e51-adb3-374eb4370b43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499314}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "57ef88a7-22a6-5c86-bd20-7f67801a22ad" :question/math-academy-id "q-59862" :question/problem "Sam and Justin get paid for mowing neighborhood lawns. The ratio of Sam's reward to Justin's reward is $2:3.$ \nDuring a particular week, Sam received $$416.$ By rounding Sam's earnings to the nearest hundred, approximate the amount of money that Justin received." :question/worked-solution "First, let's approximate the amount of money that Sam received:\n\n$$\n$416⟶$400\n$$\n\nThe ratio of Sam's earnings to Justin's earnings is\n\n$$\n\\frac{2}{3}.\n$$\n\n  \n\nThe numerator represents Sam's earnings  and the denominator represents Justin's earnings.\n\nWe can make a numerator of $400$ by multiplying the numerator and denominator by \n $200$:\n\n$$\n\\frac{2\\times 200}{3\\times 200}=\\frac{400}{600}.\n$$\n\nTherefore, Justin received approximately $$600.$"}] [{:db/id #edb/ref 17592186499530 :knowledge-point/_questions [{:db/id #edb/ref 17592186499435 :knowledge-point/id #uuid "10523576-ab54-5731-bfaf-999a591295e0" :knowledge-point/title "Approximating Ratios by Rounding to the Nearest Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d5d19c2-7f42-56d0-9f5f-abe6c4bc56b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2:3" :db/id #edb/ref 17592186498794} {:answer/id #uuid "54faac56-24aa-500e-95ed-dfc18c0732f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2:5" :db/id #edb/ref 17592186498924} {:answer/id #uuid "d4585957-deb7-55b1-a8b3-85df8589359a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:3" :db/id #edb/ref 17592186499203} {:answer/id #uuid "e4712f41-d6ab-57b4-839d-28002e33156f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:4" :db/id #edb/ref 17592186499245} {:answer/id #uuid "fe6df9f1-0814-56a5-98b1-c311c106ec5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3:4" :db/id #edb/ref 17592186499303}] :answer-field/correct {:answer/id #uuid "d4585957-deb7-55b1-a8b3-85df8589359a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:3" :db/id #edb/ref 17592186499203} :answer-field/id #uuid "bfad3152-da06-5163-a93b-0ab62ccba9b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499400}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b9cc6d27-c2ce-5a44-925e-4c2f0fca32a7" :question/math-academy-id "q-59865" :question/problem "The table below shows the numbers of students in a school who wear glasses and those who do not.\n\n| Wear Glasses | Don't Wear Glasses |\n| --- | --- |\n| $117$ | $361$ |\n\n$$\n\n$$\n\nBy rounding to the nearest ten, find the approximate ratio of students who wear glasses to those who don’t." :question/worked-solution "First, let's approximate the total number of students who wear glasses and those who don't by rounding to the nearest $10$:\n\n- wear glasses: $117⟶120$\n\n- don't wear Glasses: $361⟶360$\n\nTherefore, the ratio of students who wear glasses to those who don’t is approximately:\n\n$$\n\\frac{120}{360}\n$$\n\nWe can simplify this ratio by dividing both numbers by $10$:\n\n$$\n\\frac{120÷10}{360÷10}=\\frac{12}{36}\n$$\n\nThen, we divide by $12:$\n\n$$\n\\frac{12÷12}{36÷12}=\\frac{1}{3}\n$$\n\nTherefore, the ratio of students who wear glasses to those who don’t is approximately $1:3.$"}] [{:db/id #edb/ref 17592186499531 :knowledge-point/_questions [{:db/id #edb/ref 17592186499441 :knowledge-point/id #uuid "c71ff81f-388d-53c8-853e-c60430327148" :knowledge-point/title "Approximating Ratios by Rounding to the Nearest Hundred"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6530dce8-07a2-52b2-bab7-87b30045d656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186498955} {:answer/id #uuid "ab1ab197-5663-5877-b460-3a40bacba954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186499105} {:answer/id #uuid "adc9b931-87e3-5613-8fff-ad2dd92bfe02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186499112} {:answer/id #uuid "eff98b36-4279-51e6-b969-4cc21ecd61ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186499268} {:answer/id #uuid "f705e8b6-83b9-5492-aea8-cbffaba253af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186499282}] :answer-field/correct {:answer/id #uuid "6530dce8-07a2-52b2-bab7-87b30045d656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186498955} :answer-field/id #uuid "111a1315-8eca-5a55-9589-e07c401c9a1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499320}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ba8fb786-4538-58b4-8d18-8c109a83d218" :question/math-academy-id "q-59992" :question/problem "The following table shows the weight, in grams, of wheat flour and sugar in a cake mix.\n\n| Wheat Flour | Sugar |\n| --- | --- |\n| $615$ | $408$ |\n\n$$\n\n$$\n\nRounding to the nearest hundred, determine the approximate ratio of the weight of wheat flour to the weight of the mix of wheat flour and sugar." :question/worked-solution "First, let's approximate the weight of wheat flour and sugar by rounding to the nearest $100$:\n\n- Wheat flour: $615⟶600$\n\n- Sugar: $408⟶400$\n\nThus, the weight of the mix of these two ingredients is approximately $600+400=1\\,000.$\n\nTherefore, the ratio of the weight of the wheat flour to the weight of the mix is approximately:\n\n$$\n\\frac{600}{1\\,000}\n$$\n\nWe can simplify this ratio by dividing both numbers by $100$:\n\n$$\n\\frac{600÷100}{1\\,000÷100}=\\frac{6}{10}\n$$\n\nThen, we divide by $2$:\n\n$$\n\\frac{6÷2}{10÷2}=\\frac{3}{5}\n$$\n\nTherefore, the ratio of the weight of the wheat flour to the weight of the mix of wheat flour and sugar is approximately $\\frac{3}{5}.$"}] [{:db/id #edb/ref 17592186499526 :knowledge-point/_questions [{:db/id #edb/ref 17592186499441 :knowledge-point/id #uuid "c71ff81f-388d-53c8-853e-c60430327148" :knowledge-point/title "Approximating Ratios by Rounding to the Nearest Hundred"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bef2452-75c6-5875-aadc-4b65541d1a31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186498867} {:answer/id #uuid "4586244a-c02e-5cc3-9a78-31c9a9ced0c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186498890} {:answer/id #uuid "5bc36dd0-9168-579b-9067-9cfcb3b2d7b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186498939} {:answer/id #uuid "78da7013-d6f3-530e-9373-2c6eb6bfa826" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186499000} {:answer/id #uuid "f155c864-ac17-5346-9dc2-5df53d5d556d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186499271}] :answer-field/correct {:answer/id #uuid "5bc36dd0-9168-579b-9067-9cfcb3b2d7b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186498939} :answer-field/id #uuid "ca9008f6-427a-5c15-b3e3-f084de5c9a74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499407}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b48042cf-85c0-5d86-9405-062b1a5605f0" :question/math-academy-id "q-60005" :question/problem "The following table shows the number of boys and girls at Lincoln High School.\n\n| Boys | Girls |\n| --- | --- |\n| $331$ | $457$ |\n\n$$\n\n$$\n\nRounding to the nearest hundred, determine the approximate ratio of the number of girls to the number of boys." :question/worked-solution "First, let's approximate the number of boys and girls by rounding to the nearest hundred.\n\n- Boys: $331⟶300$\n\n- Girls: $457⟶500$\n\nTherefore, the ratio of the number of girls to the number of boys is approximately\n\n$$\n\\frac{500}{300}.\n$$\n\nDividing the numerator and denominator by $100$ gives\n\n$$\n\\frac{500÷100}{300÷100}=\\frac{5}{3}.\n$$\n\nTherefore, the ratio of the number of girls to the number of boys is approximately $\\frac{5}{3}.$"}] [{:db/id #edb/ref 17592186499456 :knowledge-point/_questions [{:db/id #edb/ref 17592186499435 :knowledge-point/id #uuid "10523576-ab54-5731-bfaf-999a591295e0" :knowledge-point/title "Approximating Ratios by Rounding to the Nearest Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8652dcc7-5859-51c0-bdf0-0c70f69db00f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186499032} {:answer/id #uuid "d0a38c2c-38ef-5b09-8f37-6f05b9b11887" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186499191} {:answer/id #uuid "dd3ada94-11d2-50d9-8325-388f457d8a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186499222} {:answer/id #uuid "e6311d5a-fffe-57b2-81b9-5d32d5371ddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186499251} {:answer/id #uuid "ff0e4aa5-879d-5048-85fb-83eb0fc40a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186499304}] :answer-field/correct {:answer/id #uuid "8652dcc7-5859-51c0-bdf0-0c70f69db00f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186499032} :answer-field/id #uuid "075baf84-4555-53aa-83cc-187869b704f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499313}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "36e19ee6-6d4d-5a04-b273-015238cdc5ad" :question/math-academy-id "q-60009" :question/problem "The following table shows the number of cakes and cookies sold on a charity day.\n\n| Cakes | Cookies |\n| --- | --- |\n| $23$ | $121$ |\n\nRounding to the nearest ten, find the ratio of the number of cakes sold to the number of cookies sold." :question/worked-solution "First, let's approximate the number of cakes and cookies sold by rounding to the nearest $10$:\n\n- number of cakes sold: $23⟶20$\n\n- number of cookies sold: $121⟶120$\n\nTherefore, the ratio of the number of cakes sold to the number of cookies sold is approximately:\n\n$$\n\\frac{20}{120}\n$$\n\nWe can simplify this ratio by dividing both numbers by $10$:\n\n$$\n\\frac{20÷10}{120÷10}=\\frac{2}{12}\n$$\n\nThen, we divide by $2$:\n\n$$\n\\frac{2÷2}{12÷2}=\\frac{1}{6}\n$$\n\nTherefore, the ratio of the number of cakes sold to the number of cookies sold is approximately $\\frac{1}{6}.$"}] [{:db/id #edb/ref 17592186499446 :knowledge-point/_questions [{:db/id #edb/ref 17592186499435 :knowledge-point/id #uuid "10523576-ab54-5731-bfaf-999a591295e0" :knowledge-point/title "Approximating Ratios by Rounding to the Nearest Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f712fe7-c921-55cf-8be6-689ccf2321e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186498875} {:answer/id #uuid "7d2d0983-60c7-591b-b0c4-4e918aaf9e11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186499010} {:answer/id #uuid "e4db4752-6564-5c8e-a4b2-5e33070c0ccf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186499247} {:answer/id #uuid "eddd68a6-ec62-5717-a1b3-78a728a51d44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186499264} {:answer/id #uuid "f030ff6e-a3ae-530a-8c00-7db23ecb2bab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186499269}] :answer-field/correct {:answer/id #uuid "f030ff6e-a3ae-530a-8c00-7db23ecb2bab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186499269} :answer-field/id #uuid "6bbf3d5c-7315-598c-a705-59edaee54071" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499367}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "12682823-7d0b-5372-9b66-9cc9b42322aa" :question/math-academy-id "q-60014" :question/problem "The following table shows the number of children in a park whose eyes are blue or brown.\n\n| Blue Eyes | Brown Eyes |\n| --- | --- |\n| $22$ | $35$ |\n\nRounding to the nearest ten, find the approximate ratio of the number of children with blue eyes to the number of children with brown eyes." :question/worked-solution "First, let's approximate the number of children with blue eyes and the number of children with brown eyes by rounding to the nearest $10$:\n\n- number of children with blue eyes: $22⟶20$\n\n- number of children with brown eyes: $35⟶40$\n\nTherefore, the ratio of the number of children with blue eyes to the number of children with brown eyes is approximately:\n\n$$\n\\frac{20}{40}\n$$\n\nWe can simplify this ratio by dividing both numbers by $10$:\n\n$$\n\\frac{20÷10}{40÷10}=\\frac{2}{4}\n$$\n\nThen, we divide by $2$:\n\n$$\n\\frac{2÷2}{4÷2}=\\frac{1}{2}\n$$\n\nTherefore, the ratio of the number of children with blue eyes to the number of children with brown eyes is approximately $\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186499477 :knowledge-point/_questions [{:db/id #edb/ref 17592186499435 :knowledge-point/id #uuid "10523576-ab54-5731-bfaf-999a591295e0" :knowledge-point/title "Approximating Ratios by Rounding to the Nearest Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e637fb0-1f73-5172-964c-f72cb481a8c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5:3" :db/id #edb/ref 17592186498832} {:answer/id #uuid "42b34d80-f727-5565-b95d-3ce8d7957ade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4:1" :db/id #edb/ref 17592186498884} {:answer/id #uuid "4f8ab9df-cb5e-523f-b13e-0cb1b6be59c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7:2" :db/id #edb/ref 17592186498917} {:answer/id #uuid "84433a35-0bfe-5d39-93a6-aa95ad981bb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3:2" :db/id #edb/ref 17592186499028} {:answer/id #uuid "d635d43d-6c81-5ecb-ae32-90a02117f085" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6:1" :db/id #edb/ref 17592186499210}] :answer-field/correct {:answer/id #uuid "2e637fb0-1f73-5172-964c-f72cb481a8c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5:3" :db/id #edb/ref 17592186498832} :answer-field/id #uuid "0c1bcbf6-52ae-5042-b30e-38539a89f9fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499317}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5b830f36-6958-507b-9f99-7670b58c2e50" :question/math-academy-id "q-60031" :question/problem "The following table shows the number of families in a town that have a dog and the number of families that do not.\n\n| Families who have a dog | Families that do not have a dog |\n| --- | --- |\n| $151$ | $92$ |\n\nRounding to the nearest ten, find the approximate ratio of the number of families that have a dog to those that do not." :question/worked-solution "First, let's approximate the number of families who have a dog and those who do not by rounding to the nearest $10$:\n\n- Families who have a dog: $151⟶150$\n\n- Families who do not have a dog: $92⟶90$\n\nTherefore, the ratio of the number of families who have a dog to those who do not is approximately:\n\n$$\n\\frac{150}{90}\n$$\n\nWe can simplify this ratio by dividing both numbers by $10$:\n\n$$\n\\frac{150÷10}{90÷10}=\\frac{15}{9}\n$$\n\nThen, we divide by $3$:\n\n$$\n\\frac{15÷3}{9÷3}=\\frac{5}{3}\n$$\n\nHence, the ratio of the number of families who have a dog and who do not have is approximately $5:3.$"}] [{:db/id #edb/ref 17592186499559 :knowledge-point/_questions [{:db/id #edb/ref 17592186499435 :knowledge-point/id #uuid "10523576-ab54-5731-bfaf-999a591295e0" :knowledge-point/title "Approximating Ratios by Rounding to the Nearest Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ff3556e-168c-55d0-8372-45f266865a77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:5" :db/id #edb/ref 17592186498763} {:answer/id #uuid "53c5c875-0b9d-597d-a611-64fcdaa2bd77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2:7" :db/id #edb/ref 17592186498922} {:answer/id #uuid "a51a42ac-bdf0-5461-8257-96255afc9426" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3:8" :db/id #edb/ref 17592186499088} {:answer/id #uuid "aa90b4a8-7b54-56d7-810c-e59e85b4f1af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5:6" :db/id #edb/ref 17592186499102} {:answer/id #uuid "b018535e-0eac-575e-b718-7cca5302b75a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:4" :db/id #edb/ref 17592186499119}] :answer-field/correct {:answer/id #uuid "0ff3556e-168c-55d0-8372-45f266865a77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1:5" :db/id #edb/ref 17592186498763} :answer-field/id #uuid "61576f24-7cb4-5c5a-89ff-ff9df4f9e64d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499359}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f3715793-c326-5ff1-9566-caa835ab04e3" :question/math-academy-id "q-60032" :question/problem "The following table shows the number of days it rained in Madrid during $2019.$\n\n| Rainy days | No-rain days |\n| --- | --- |\n| $63$ | $302$ |\n\nRounding to the nearest ten, determine the approximate ratio of the number of days it rained in Madrid to the number of days it did not rain." :question/worked-solution "First, let's approximate the number of days that it rained and did not rain by rounding to the nearest $10$:\n\n- Rainy days: $63⟶60$\n\n- No-rain days: $302⟶300$\n\nTherefore, the ratio of the number of days that it rained to the number of days that it did not rain is approximately:\n\n$$\n\\frac{60}{300}\n$$\n\nWe can simplify this ratio by dividing both numbers by $10$:\n\n$$\n\\frac{60÷10}{300÷10}=\\frac{6}{30}\n$$\n\nThen, we divide by $6$:\n\n$$\n\\frac{6÷6}{30÷6}=\\frac{1}{5}\n$$\n\nHence, the ratio of the number of days that it rained and did not rain is approximately $1:5.$"}] [{:db/id #edb/ref 17592186499459 :knowledge-point/_questions [{:db/id #edb/ref 17592186499434 :knowledge-point/id #uuid "01f99115-f376-50c2-9b7e-79800006d437" :knowledge-point/title "Finding a Value Given a Ratio by Rounding an Amount"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e24de99-73f2-5734-a999-e16171397584" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$200$ girls" :db/id #edb/ref 17592186499013} {:answer/id #uuid "ac534f52-7476-5be3-a254-54aa878ca486" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$220$ girls" :db/id #edb/ref 17592186499110} {:answer/id #uuid "b7ea3a5f-0c04-56de-a14c-7ac6703fa76c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$230$ girls" :db/id #edb/ref 17592186499139} {:answer/id #uuid "c2ed6cdb-443d-5476-82ff-7f8b4e155faf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$190$ girls" :db/id #edb/ref 17592186499159} {:answer/id #uuid "fd56626a-a3ea-50f6-a3e4-b9f09a5eb53f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$210$ girls" :db/id #edb/ref 17592186499297}] :answer-field/correct {:answer/id #uuid "7e24de99-73f2-5734-a999-e16171397584" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$200$ girls" :db/id #edb/ref 17592186499013} :answer-field/id #uuid "2b02d1c9-ff7f-5adc-bdd5-37b6db70e37e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499334}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ceac12d-489e-5694-8f52-b302f6787511" :question/math-academy-id "q-60057" :question/problem "There are $121$ boys in Eastwood High School. The ratio of the number of boys to the number of girls is $3:5.$ By rounding the number of boys to the nearest ten, approximate the number of girls in Eastwood High School." :question/worked-solution "First, let's approximate the number of boys:\n\n$$\n121⟶120\n$$\n\nThe ratio of the number of boys to the number of girls is\n\n$$\n\\frac{3}{5}.\n$$\n\n  \n\nThe numerator represents the number of boys and the denominator represents the number of girls.\n\nWe can make a numerator of $120$ by multiplying the numerator and denominator by \n $40$:\n\n$$\n\\frac{3\\times 40}{5\\times 40}=\\frac{120}{200}\n$$\n\nTherefore, there are approximately $200$ girls in Eastwood High School."}] [{:db/id #edb/ref 17592186499545 :knowledge-point/_questions [{:db/id #edb/ref 17592186499434 :knowledge-point/id #uuid "01f99115-f376-50c2-9b7e-79800006d437" :knowledge-point/title "Finding a Value Given a Ratio by Rounding an Amount"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15e18391-8e4a-5963-a8a7-7e77752d16d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1\\,800$ liters" :db/id #edb/ref 17592186498776} {:answer/id #uuid "1a2b62cc-53a5-556b-9fd6-5c8100d197ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2\\,100$ liters" :db/id #edb/ref 17592186498785} {:answer/id #uuid "759966ab-ba62-5527-8d0c-c8bdec663c3c" :answer/type {:db/id #edb/ref 17592186045499 :db/iden