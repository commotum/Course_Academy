#{[{:db/id #edb/ref 17592186125039 :knowledge-point/_questions [{:db/id #edb/ref 17592186124594 :knowledge-point/id #uuid "c2696e2e-7aa9-5831-9028-9adfe5889bbe" :knowledge-point/title "Calculating the Derivative of a Cartesian Function With Respect to Plane Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db88b087-b136-58ed-9ecd-7896e0822fbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r^{2}\\cos (2θ) + r^{2}\\sin (2θ)" :db/id #edb/ref 17592186122835} {:answer/id #uuid "f39a24b5-23ab-5f9d-bfe3-258ca717c94f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3r^{2}\\cos (2θ)" :db/id #edb/ref 17592186122836} {:answer/id #uuid "2a439bde-7060-5f47-907a-df53e7c751d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\sin (2θ) + 2r\\sin^{2} θ" :db/id #edb/ref 17592186122837} {:answer/id #uuid "2edc2883-3d8d-53a0-bb5d-d106db10244f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\cos (2θ) + r\\sin (2θ)" :db/id #edb/ref 17592186122838} {:answer/id #uuid "74f961ba-683e-50da-8c1a-e63f2d0ae676" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r^{2}\\cos θ + r^{2}\\sin θ" :db/id #edb/ref 17592186122839}] :answer-field/id #uuid "a86a93b6-feda-5a79-b8d8-74c4acc61388" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122834} {:answer-field/choices [{:answer/id #uuid "79830e35-fb58-5c0c-8ffe-3455034ae32b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}\\operatorname{cos}⁡\\theta +{r}^{2}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186368497} {:answer/id #uuid "e18a672b-de77-5df8-8f1b-84076247b048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡(2\\theta )+r\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186368498} {:answer/id #uuid "5d7be39b-6734-5fbb-b31d-4ee6cfc206ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{sin}⁡(2\\theta )+2r{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186368499} {:answer/id #uuid "633b9946-97ef-5a0d-a217-10b115c3dbb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{r}^{2}\\operatorname{cos}⁡(2\\theta )" :db/id #edb/ref 17592186368500} {:answer/id #uuid "1cddd4cb-d4e0-5346-8409-af4fe2ea10fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{r}^{2}\\operatorname{cos}⁡(2\\theta )+{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186368501}] :answer-field/correct {:answer/id #uuid "1cddd4cb-d4e0-5346-8409-af4fe2ea10fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{r}^{2}\\operatorname{cos}⁡(2\\theta )+{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186368501} :answer-field/id #uuid "77fe4fb6-8827-5540-a442-722c8b1aa5b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368496}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0722c4ed-9b45-5a82-9aca-63ef2538a12b" :question/math-academy-id "q-37192" :question/problem "Given that $f(x,y)=2xy+{y}^{2},$ find $\\frac{∂f}{∂\\theta },$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $f(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂\\theta } & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂\\theta } \\\\  & =-\\frac{∂f}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂f}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2y,\\,\\frac{∂f}{∂y}=2x+2y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2r\\operatorname{sin}⁡\\theta , \\\\ \\frac{∂f}{∂y} & =2r\\operatorname{cos}⁡\\theta +2r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂\\theta } & =-2r\\operatorname{sin}⁡\\theta \\,r\\operatorname{sin}⁡\\theta +(2r\\operatorname{cos}⁡\\theta +2r\\operatorname{sin}⁡\\theta )r\\operatorname{cos}⁡\\theta  \\\\  & =2{r}^{2}({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta )+{r}^{2}\\operatorname{sin}⁡(2\\theta ) \\\\  & =2{r}^{2}\\operatorname{cos}⁡(2\\theta )+{r}^{2}\\operatorname{sin}⁡(2\\theta ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360563 :knowledge-point/_questions [{:db/id #edb/ref 17592186124594 :knowledge-point/id #uuid "c2696e2e-7aa9-5831-9028-9adfe5889bbe" :knowledge-point/title "Calculating the Derivative of a Cartesian Function With Respect to Plane Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dce7e8f-7060-53e3-85cb-4987af63f4e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{cos}^{2}⁡\\theta -1" :db/id #edb/ref 17592186358164} {:answer/id #uuid "6202b197-e3e5-5891-8722-848e41ddd428" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{r}{2}" :db/id #edb/ref 17592186358606} {:answer/id #uuid "8bc5a7fb-705f-5c74-b33e-9a9c4a94bf6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r" :db/id #edb/ref 17592186358965} {:answer/id #uuid "e6251725-fa38-5c2d-a0b0-c05928f16370" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{r}" :db/id #edb/ref 17592186359789} {:answer/id #uuid "e704bf2b-93ca-5b8f-8349-92ea61dd3fa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186359797}] :answer-field/correct {:answer/id #uuid "e6251725-fa38-5c2d-a0b0-c05928f16370" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{r}" :db/id #edb/ref 17592186359789} :answer-field/id #uuid "5cbcd748-fe7e-5cef-acf6-5edffcf9bb9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360136}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3f6701f-c993-5ff2-926d-7219617af2de" :question/math-academy-id "q-95109" :question/problem "Given that $w(x,y)=\\operatorname{ln}⁡({x}^{2}+{y}^{2}),$ find $\\frac{∂w}{∂r},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $w(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂w}{∂r} & =\\frac{∂w}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂w}{∂y}\\cdot \\frac{∂y}{∂r} \\\\  & =\\frac{∂w}{∂x}\\operatorname{cos}⁡\\theta +\\frac{∂w}{∂y}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $w$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x}=\\frac{2x}{{x}^{2}+{y}^{2}},\\,\\frac{∂w}{∂y}=\\frac{2y}{{x}^{2}+{y}^{2}}\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x} & =\\frac{2r\\operatorname{cos}⁡\\theta }{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta }, \\\\ \\frac{∂w}{∂y} & =\\frac{2r\\operatorname{sin}⁡\\theta }{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta }.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂r} & =(\\frac{2r\\operatorname{cos}⁡\\theta }{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta })\\operatorname{cos}⁡\\theta +(\\frac{2r\\operatorname{sin}⁡\\theta }{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta })\\operatorname{sin}⁡\\theta  \\\\  & =\\frac{2r({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\frac{2}{r}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186479124 :knowledge-point/_questions [{:db/id #edb/ref 17592186124594 :knowledge-point/id #uuid "c2696e2e-7aa9-5831-9028-9adfe5889bbe" :knowledge-point/title "Calculating the Derivative of a Cartesian Function With Respect to Plane Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a6d8b25-1be0-507f-9e45-600b11128f7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}\\operatorname{cos}⁡(2\\theta )" :db/id #edb/ref 17592186478574} {:answer/id #uuid "194c2f16-5d03-56da-8f8a-2451146b01a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡(2\\theta )" :db/id #edb/ref 17592186478595} {:answer/id #uuid "27127698-eb1f-5556-ba20-69f2d7bce69e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186478617} {:answer/id #uuid "80a52cdb-4432-54c2-aba3-ba66914bcbe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186478752} {:answer/id #uuid "91e129af-e354-55a9-b266-adc2bb6d4a71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186478794}] :answer-field/correct {:answer/id #uuid "194c2f16-5d03-56da-8f8a-2451146b01a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡(2\\theta )" :db/id #edb/ref 17592186478595} :answer-field/id #uuid "74be8c02-d536-5d47-b824-c1806a52210c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479003}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c5298f54-bfaf-5a4f-ac68-b78b607bf15c" :question/math-academy-id "q-95115" :question/problem "Given that $h(x,y)={x}^{2}-{y}^{2},$ find $\\frac{∂h}{∂r},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $h(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r} & =\\frac{∂h}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂h}{∂y}\\cdot \\frac{∂y}{∂r} \\\\  & =\\frac{∂h}{∂x}\\operatorname{cos}⁡\\theta +\\frac{∂h}{∂y}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x}=2x,\\,\\frac{∂h}{∂y}=-2y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =2r\\operatorname{cos}⁡\\theta , \\\\ \\frac{∂h}{∂y} & =-2r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r} & =(2r\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta -(2r\\operatorname{sin}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =2r({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & =2r\\operatorname{cos}⁡(2\\theta ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360581 :knowledge-point/_questions [{:db/id #edb/ref 17592186124596 :knowledge-point/id #uuid "2ee45610-e14c-593e-9002-e2b2fcdb4517" :knowledge-point/title "Calculating the Derivative of a Cartesian Function With Respect to Cylindrical Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12192e9d-666e-5c58-ae9b-549a795d8bed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}(2z\\operatorname{cos}⁡2\\theta +\\frac{1}{2}{sin}^{2}⁡\\theta )" :db/id #edb/ref 17592186357907} {:answer/id #uuid "2313e01f-d71c-5200-a515-ee826a71b2c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{r}^{2}(z{cos}^{2}⁡\\theta +\\operatorname{sin}⁡2\\theta )" :db/id #edb/ref 17592186358058} {:answer/id #uuid "3838a62b-71f1-5444-8110-29c7f4dcb528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2z{cos}^{2}⁡\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186358248} {:answer/id #uuid "6d65b027-234d-52ec-b21e-4cda093023c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡2\\theta +{r}^{2}z\\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186358706} {:answer/id #uuid "a2650aa0-1dde-559a-991a-ef66b1ee74bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}(2z{cos}^{2}⁡\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta )" :db/id #edb/ref 17592186359169}] :answer-field/correct {:answer/id #uuid "a2650aa0-1dde-559a-991a-ef66b1ee74bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{r}^{2}(2z{cos}^{2}⁡\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta )" :db/id #edb/ref 17592186359169} :answer-field/id #uuid "41d8dcd8-411e-5bef-bfda-8f715f466b64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360090}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2f89a4f6-9145-5fdf-84a8-9fcaed162c54" :question/math-academy-id "q-95171" :question/problem "Given that $u(x,y,z)={x}^{2}{z}^{2}+{x}^{2}{y}^{2}+xyz,$ find $\\frac{∂u}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $u(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂u}{∂z} & =\\frac{∂u}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂u}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂u}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂u}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $u$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂u}{∂z}=2{x}^{2}z+xy\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂u}{∂z} & =2{r}^{2}z{cos}^{2}⁡\\theta +{r}^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & ={r}^{2}(2z{cos}^{2}⁡\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360583 :knowledge-point/_questions [{:db/id #edb/ref 17592186124596 :knowledge-point/id #uuid "2ee45610-e14c-593e-9002-e2b2fcdb4517" :knowledge-point/title "Calculating the Derivative of a Cartesian Function With Respect to Cylindrical Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129511e1-8153-5e51-95ae-9c26ed91e829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8z" :db/id #edb/ref 17592186357911} {:answer/id #uuid "22e04b8b-94b1-5f23-a25d-237f08e39a4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8z+{r}^{2}{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186358054} {:answer/id #uuid "8a775666-2516-5e21-bf4d-75577316d96d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{r}^{2}z{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186358958} {:answer/id #uuid "b5f0ea0f-66cb-5c73-84ba-025ec83912b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8z+{r}^{2}{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186359332} {:answer/id #uuid "d256b0d6-11fb-52fc-a283-8f751fba045a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{r}^{2}z{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186359590}] :answer-field/correct {:answer/id #uuid "8a775666-2516-5e21-bf4d-75577316d96d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{r}^{2}z{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186358958} :answer-field/id #uuid "57e7c9e5-29e9-5ecf-8487-914454d5c63c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360130}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e7a6bf9a-03da-5b3f-8e6f-6e42220c784c" :question/math-academy-id "q-95174" :question/problem "Given that $h(x,y,z)=2{x}^{2}+{y}^{2}+4{x}^{2}{z}^{2},$ find $\\frac{∂h}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $h(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂h}{∂z} & =\\frac{∂h}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂h}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂h}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂h}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂z}=8{x}^{2}z\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂z} & =8{r}^{2}z{cos}^{2}⁡\\theta .\\end{aligned}\n$$"}]}
