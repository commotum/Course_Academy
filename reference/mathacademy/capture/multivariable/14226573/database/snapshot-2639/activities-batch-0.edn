ref 17592186069262} {:db/id #edb/ref 17592186250313} {:db/id #edb/ref 17592186250314} {:db/id #edb/ref 17592186250319} {:db/id #edb/ref 17592186250326} {:db/id #edb/ref 17592186250327} {:db/id #edb/ref 17592186250328} {:db/id #edb/ref 17592186262709} {:db/id #edb/ref 17592186320945} {:db/id #edb/ref 17592186320946} {:db/id #edb/ref 17592186320947} {:db/id #edb/ref 17592186320956} {:db/id #edb/ref 17592186320957} {:db/id #edb/ref 17592186320958} {:db/id #edb/ref 17592186377565} {:db/id #edb/ref 17592186377594} {:db/id #edb/ref 17592186546978} {:db/id #edb/ref 17592186547030} {:db/id #edb/ref 17592186547073}] :knowledge-point/title "Computing the Integral of a Logarithmic Expression Using Integration by Parts Twice"} :step/id #uuid "fbb28f81-ea51-5172-9911-15b8c5ea0ef5" :step/math-academy-id 655427}] :activity/title "Applying the Integration By Parts Twice" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186068951}] [{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186547156} :activity/id #uuid "333b738c-50d1-58ad-bd4c-8e1bcce1c0a9" :activity/scope {:db/id #edb/ref 17592186049069 :topic/id #uuid "d7927711-e084-5b0c-97d6-05acd9686522" :topic/math-academy-id 416} :activity/steps [{:db/id #edb/ref 17592186547115 :step/content {:db/id #edb/ref 17592186320955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f8475c2-b6a4-51c9-afc7-33b04db0b7df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\pi " :db/id #edb/ref 17592186319432} {:answer/id #uuid "3dee1ca0-af04-5580-8c4b-40ffbe8b236e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6\\pi" :db/id #edb/ref 17592186546388}] :answer-field/correct {:db/id #edb/ref 17592186546388} :answer-field/id #uuid "6714774d-7da9-5f4e-89a7-0e0c1ff30a6f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186320377}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "15526c87-56a5-504c-8ad1-55f1320c8be7" :question/math-academy-id "q-352118" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi }3{x}^{2}\\operatorname{cos}⁡(x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=3{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=6x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{cos}⁡(x)\\,\\text{d}x=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int 3{x}^{2}\\operatorname{cos}⁡(x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(3{x}^{2})(\\operatorname{sin}⁡(x))-\\int (\\operatorname{sin}⁡(x))(6x)\\,\\text{d}x \\\\  & =3{x}^{2}\\operatorname{sin}⁡(x)-6\\int x\\operatorname{sin}⁡(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{sin}⁡(x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(x) & \\,⟹\\,v=\\int \\operatorname{sin}⁡(x)\\text{d}x=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡(x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x(-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))\\cdot 1\\,dx \\\\  & =-x\\operatorname{cos}⁡(x)+\\int \\operatorname{cos}⁡(x)\\,dx \\\\  & =-x\\operatorname{cos}⁡(x)+\\operatorname{sin}⁡(x)+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 3{x}^{2}\\operatorname{cos}⁡(x)\\,\\text{d}x & =3{x}^{2}\\operatorname{sin}⁡(x)-6\\int x\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =3{x}^{2}\\operatorname{sin}⁡(x)-6(-x\\operatorname{cos}⁡(x)+\\operatorname{sin}⁡(x)+D) \\\\  & =3{x}^{2}\\operatorname{sin}⁡(x)+6x\\operatorname{cos}⁡(x)-6\\operatorname{sin}⁡(x)+C,\\end{aligned}\n$$\n\nwhere $C=-6D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }3{x}^{2}\\operatorname{cos}⁡(x)\\,\\text{d}x & ={[3{x}^{2}\\operatorname{sin}⁡(x)+6x\\operatorname{cos}⁡(x)-6\\operatorname{sin}⁡(x)]}_{0}^{\\pi } \\\\  & =(3(\\pi )^{2}\\operatorname{sin}⁡(\\pi )+6(\\pi )\\operatorname{cos}⁡(\\pi )-6\\operatorname{sin}⁡(\\pi ))-(3(0)^{2}\\operatorname{sin}⁡(0)+6(0)\\operatorname{cos}⁡(0)-6\\operatorname{sin}⁡(0)) \\\\  & =0+6\\pi (-1)-0-0 \\\\  & =-6\\pi \\end{aligned}\n$$"} :step/id #uuid "64a57aef-d6e9-5810-96e6-0a4d5d4de0bb"} {:db/id #edb/ref 17592186547135 :step/content {:db/id #edb/ref 17592186547030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c1e0f93-78e7-591e-b13d-1e75cf7634cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10{e}^{3}-4}{3}" :db/id #edb/ref 17592186546383}] :answer-field/correct {:db/id #edb/ref 17592186546383} :answer-field/id #uuid "e456e79c-9696-5fd5-914c-4b58ab494688" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546941}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "88eae5cb-fb52-512e-a423-9c404ac93779" :question/math-academy-id "q-346501" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{e}18{x}^{2}(\\operatorname{ln}⁡x)^{2}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=(\\operatorname{ln}⁡x)^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡x}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=18{x}^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 18{x}^{2}\\,\\text{d}x=6{x}^{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 18{x}^{2}(\\operatorname{ln}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={(\\operatorname{ln}⁡x)}^{2}(6{x}^{3})-\\int (6{x}^{3})(\\frac{2\\operatorname{ln}⁡x}{x})\\,\\text{d}x \\\\  & =6{x}^{3}{(\\operatorname{ln}⁡x)}^{2}-12\\int {x}^{2}\\operatorname{ln}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int {x}^{2}\\operatorname{ln}⁡x\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {x}^{2}\\,\\text{d}x=\\frac{{x}^{3}}{3}\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{ln}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x(\\frac{{x}^{3}}{3})-\\int (\\frac{{x}^{3}}{3})(\\frac{1}{x})\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡x}{3}-\\frac{1}{3}\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡x}{3}-\\frac{{x}^{3}}{9}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 18{x}^{2}(\\operatorname{ln}⁡x)^{2}\\,\\text{d}x & =6{x}^{3}{(\\operatorname{ln}⁡x)}^{2}-12\\int {x}^{2}\\operatorname{ln}⁡x\\,\\text{d}x \\\\  & =6{x}^{3}{(\\operatorname{ln}⁡x)}^{2}-12(\\frac{{x}^{3}\\operatorname{ln}⁡x}{3}-\\frac{{x}^{3}}{9}+D) \\\\  & =6{x}^{3}{(\\operatorname{ln}⁡x)}^{2}-4{x}^{3}\\operatorname{ln}⁡x+\\frac{4{x}^{3}}{3}-12D \\\\  & ={x}^{3}(6{(\\operatorname{ln}⁡x)}^{2}-4\\operatorname{ln}⁡x+\\frac{4}{3})+C,\\end{aligned}\n$$\n\nwhere $C=-12D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}18{x}^{2}(\\operatorname{ln}⁡x)^{2}\\text{d}x & ={[{x}^{3}(6{(\\operatorname{ln}⁡x)}^{2}-4\\operatorname{ln}⁡x+\\frac{4}{3})]}_{1}^{e} \\\\  & =[{e}^{3}(6{(\\operatorname{ln}⁡e)}^{2}-4\\operatorname{ln}⁡e+\\frac{4}{3})]-[{1}^{3}(6{(\\operatorname{ln}⁡1)}^{2}-4\\operatorname{ln}⁡1+\\frac{4}{3})] \\\\  & =[{e}^{3}(6-4+\\frac{4}{3})]-\\frac{4}{3} \\\\  & =\\frac{10{e}^{3}-4}{3}\\end{aligned}\n$$"} :step/id #uuid "a4bbd805-d804-517d-a8e5-32021f33212a" :step/next {:db/id #edb/ref 17592186547150}} {:db/id #edb/ref 17592186547138 :step/content {:db/id #edb/ref 17592186250314 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0566e525-d41b-5762-abad-a35a60fcea73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9e+12" :db/id #edb/ref 17592186247468} {:answer/id #uuid "377a31ef-b562-5a6f-805e-2834d145cfda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e-18" :db/id #edb/ref 17592186247923} {:answer/id #uuid "928f1290-d85e-54cd-bd20-3cfebd037b5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3e-9" :db/id #edb/ref 17592186248724} {:answer/id #uuid "db06656d-5fcf-5439-bdb0-133473765928" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3e+9" :db/id #edb/ref 17592186249358} {:answer/id #uuid "f4ff3e4b-d499-52d7-802f-f1d97113fff6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9e-18" :db/id #edb/ref 17592186249564}] :answer-field/correct {:db/id #edb/ref 17592186249564} :answer-field/id #uuid "ddcf16bb-2de3-57be-904f-fe6f88d0b63a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186250051}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "25b1fd19-3728-5b2c-98ff-e3d6d85297ff" :question/math-academy-id "q-114883" :question/problem "Evaluate ${\\int }_{1}^{e}{ln}^{2}⁡({x}^{3})\\,\\text{d}x.$" :question/worked-solution "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={ln}^{2}⁡({x}^{3})\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{6\\operatorname{ln}⁡({x}^{3})}{x} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int {ln}^{2}⁡({x}^{3})\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({ln}^{2}⁡({x}^{3}))(x)-\\int (x)(\\frac{6\\operatorname{ln}⁡({x}^{3})}{x})\\,\\text{d}x \\\\  & =x{ln}^{2}⁡({x}^{3})-6\\int \\operatorname{ln}⁡({x}^{3})\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int \\operatorname{ln}⁡({x}^{3})\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡({x}^{3})\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{3}{x} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int \\operatorname{ln}⁡({x}^{3})\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(\\operatorname{ln}⁡({x}^{3}))(x)-\\int (x)(\\frac{3}{x})\\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡({x}^{3})-3\\int \\text{d}x \\\\  & =x\\operatorname{ln}⁡({x}^{3})-3x+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int {ln}^{2}⁡({x}^{3})\\,\\text{d}x & =x{ln}^{2}⁡({x}^{3})-6(x\\operatorname{ln}⁡({x}^{3})-3x+D) \\\\  & =x{ln}^{2}⁡({x}^{3})-6x\\operatorname{ln}⁡({x}^{3})+18x+C,\\end{aligned}\n$$\n\nwhere $C=-6D.$ \n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}{ln}^{2}⁡({x}^{3})\\,\\text{d}x & ={[x{ln}^{2}⁡({x}^{3})-6x\\operatorname{ln}⁡({x}^{3})+18x]}_{1}^{e} \\\\  & =[e{ln}^{2}⁡({e}^{3})-6e\\operatorname{ln}⁡({e}^{3})+18e]-[(1){ln}^{2}⁡({1}^{3})-6(1)\\operatorname{ln}⁡({1}^{3})+18(1)] \\\\  & =9e-18e+18e-18 \\\\  & =9e-18.\\end{aligned}\n$$"} :step/id #uuid "aeb6cf6a-16c5-5b68-852d-5618fe48037e" :step/next {:db/id #edb/ref 17592186547135}} {:db/id #edb/ref 17592186547150 :step/content {:db/id #edb/ref 17592186320942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8d98ca1-5383-519e-939b-8606ea79f890" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\pi }^{2}-4" :db/id #edb/ref 17592186320004} {:answer/id #uuid "aa63f575-8e52-5911-b87b-39631af04e6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi^{2}-4" :db/id #edb/ref 17592186546634}] :answer-field/correct {:db/id #edb/ref 17592186546634} :answer-field/id #uuid "ded71c5d-94de-520f-9363-1d054bf11cec" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186320624}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ce8ce801-4acf-5ae8-b6e4-25107fda723b" :question/math-academy-id "q-352028" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /3}27{x}^{2}\\operatorname{sin}⁡(3x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=27{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=54x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(3x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{sin}⁡(3x)\\,\\text{d}x=-\\frac{\\operatorname{cos}⁡(3x)}{3}.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int 27{x}^{2}\\operatorname{sin}⁡(3x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(27{x}^{2})(-\\frac{\\operatorname{cos}⁡(3x)}{3})-\\int (-\\frac{\\operatorname{cos}⁡(3x)}{3})(54x)\\,\\text{d}x \\\\  & =-9{x}^{2}\\operatorname{cos}⁡(3x)+18\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(3x) & \\,⟹\\,v=\\int \\operatorname{cos}⁡(3x)\\text{d}x=\\frac{\\operatorname{sin}⁡(3x)}{3}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x(\\frac{\\operatorname{sin}⁡(3x)}{3})-\\int (\\frac{\\operatorname{sin}⁡(3x)}{3})\\cdot 1\\,dx \\\\  & =\\frac{x\\operatorname{sin}⁡(3x)}{3}+\\frac{\\operatorname{cos}⁡(3x)}{9}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 27{x}^{2}\\operatorname{sin}⁡(3x)\\,\\text{d}x & =-9{x}^{2}\\operatorname{cos}⁡(3x)+18\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =-9{x}^{2}\\operatorname{cos}⁡(3x)+18(\\frac{x\\operatorname{sin}⁡(3x)}{3}+\\frac{\\operatorname{cos}⁡(3x)}{9}+D) \\\\  & =-9{x}^{2}\\operatorname{cos}⁡(3x)+6x\\operatorname{sin}⁡(3x)+2\\operatorname{cos}⁡(3x)+C,\\end{aligned}\n$$\n\nwhere $C=18D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}27{x}^{2}\\operatorname{sin}⁡(3x)\\,\\text{d}x & ={[-9{x}^{2}\\operatorname{cos}⁡(3x)+6x\\operatorname{sin}⁡(3x)+2\\operatorname{cos}⁡(3x)]}_{0}^{\\pi /3} \\\\  & =9{(\\frac{\\pi }{3})}^{2}-2-2 \\\\  & ={\\pi }^{2}-4 \\\\  & ={\\pi }^{2}-4\\end{aligned}\n$$"} :step/id #uuid "c9eb948f-4211-54cf-b715-46e2e89288c3" :step/next {:db/id #edb/ref 17592186547115}} {:db/id #edb/ref 17592186547156 :step/content {:db/id #edb/ref 17592186547049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52851b61-8b9c-53cc-91c6-5200fa78f1ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186546430} {:answer/id #uuid "6f2ba34b-4251-5e97-822e-7d6f89fec290" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186546498} {:answer/id #uuid "71e229f8-046f-5d88-8cf3-15d0ca09c39a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\pi }{4}" :db/id #edb/ref 17592186546502} {:answer/id #uuid "a47b0af8-b237-5b70-8f37-b67b00a01cef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\pi }{2}" :db/id #edb/ref 17592186546618} {:answer/id #uuid "ea372be5-00ac-5d06-b324-96a9d214c32b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3\\pi }{4}" :db/id #edb/ref 17592186546777}] :answer-field/correct {:db/id #edb/ref 17592186546777} :answer-field/id #uuid "60100382-bef0-5d40-8e4e-57031710307e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186546867}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bc404082-c599-5306-899d-26fb5a707805" :question/math-academy-id "q-114875" :question/problem "Evaluate the integral ${\\int }_{0}^{\\pi /2}3{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x.$" :question/worked-solution "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=3{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=6x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(2x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{cos}⁡(2x)\\,\\text{d}x=\\frac{\\operatorname{sin}⁡(2x)}{2}.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int 3{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x & =\\int u\\frac{\\text{d}x}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(3{x}^{2})(\\frac{\\operatorname{sin}⁡(2x)}{2})-\\int (\\frac{\\operatorname{sin}⁡(2x)}{2})(6x)\\,\\text{d}x \\\\  & =\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}-3{\\int }_{0}^{\\pi /2}x\\operatorname{sin}⁡(2x)\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{sin}⁡(2x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(2x) & \\,⟹\\,v=\\int \\operatorname{sin}⁡(2x)\\text{d}x=-\\frac{\\operatorname{cos}⁡(2x)}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡(2x)\\,\\text{d}x & =\\int u\\frac{\\text{d}x}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x(-\\frac{\\operatorname{cos}⁡(2x)}{2})-\\int (-\\frac{\\operatorname{cos}⁡(2x)}{2})\\cdot 1\\,dx \\\\  & =-\\frac{x\\operatorname{cos}⁡(2x)}{2}+\\frac{1}{2}\\int \\operatorname{cos}⁡(2x)\\,dx \\\\  & =-\\frac{x\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{4}+D\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 3{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x & =\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}-3\\int x\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}-3(-\\frac{x\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{4}+D) \\\\  & =\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}+\\frac{3x\\operatorname{cos}⁡(2x)}{2}-\\frac{3\\operatorname{sin}⁡(2x)}{4}+C\\end{aligned}\n$$\n\nwhere $C=-3D.$ Finally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}3{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x & ={[\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}+\\frac{3x\\operatorname{cos}⁡(2x)}{2}-\\frac{3\\operatorname{sin}⁡(2x)}{4}]}_{0}^{\\pi /2} \\\\  & =\\frac{3{(\\frac{\\pi }{2})}^{2}\\operatorname{sin}⁡(\\pi )}{2}+\\frac{3(\\frac{\\pi }{2})\\operatorname{cos}⁡(\\pi )}{2}-\\frac{3\\operatorname{sin}⁡(\\pi )}{4}-(\\frac{3(0)^{2}\\operatorname{sin}⁡(0)}{2}+\\frac{3(0)\\operatorname{cos}⁡(0)}{2}-\\frac{3\\operatorname{sin}⁡(0)}{4}) \\\\  & =0+\\frac{3\\pi (-1)}{4}-0-0 \\\\  & =-\\frac{3\\pi }{4}\\end{aligned}\n$$"} :step/id #uuid "d6dd1fb5-7500-53b2-92b3-d30c54396c8f" :step/next {:db/id #edb/ref 17592186547138}}] :activity/title "Applying the Integration By Parts Twice" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186546237}] [{:activity/expected-seconds 1380.0 :activity/first-step {:db/id #edb/ref 17592186101908} :activity/id #uuid "e770d350-fe93-58e5-a551-254f24aea748" :activity/scope {:db/id #edb/ref 17592186049280 :topic/id #uuid "e992dbdf-067e-5347-82bc-a58321ce8275" :topic/math-academy-id 1203} :activity/steps [{:db/id #edb/ref 17592186101908 :step/content {:db/id #edb/ref 17592186102034 :tutorial/content "The region $\\textrm{R},$ shown below, is the area under the graph of $f(x) = 2x+1$ over the interval $[1,3].$ What is the height of the rectangle defined over the same interval that has the same area as $\\textrm{R}?$ \n\n![](images/01/01597200b1f0e147fa8c53b6301d0c8e37208b5a6cce64cf0d9859d1220d8385.png)\n\n \n\nUsing the formula for the area of a trapezoid, we have that\n\n$$\n\\eqalign{\n\\textrm{Area}\\,(\\textrm{R}) = \\dfrac{1}{2}(3+7)(3-1)= 10.}\n$$\n\nFor the rectangle to have the same area, we must have \n\n$$\n\\begin{aligned}10 & =f(c)(3-1) \\\\ f(c) & =5 \\\\ 2c+1 & =5 \\\\ c & =2.\\end{aligned}\n$$\n\nWe can summarize what we've just done by saying that\n\n$$\n\\int_1^3 (2x +1)\\, \\textrm d x= f(2) \\cdot (3-1).\n$$\n\nThis is an example of the **mean value theorem for integrals**, which states:\n\n*If $f(x)$ is a continuous function on the closed interval $[a, b]$, then there exists a number $c$ in that interval such that*\n\n$$\n\\int_a^b f(x)\\, \\textrm d x = f(c) \\cdot (b-a).\n$$" :tutorial/id #uuid "c1b3241c-c8fd-514f-aa8c-a000710896d4" :tutorial/math-academy-id 986 :tutorial/title "Introduction"} :step/id #uuid "d75b1c61-1292-5625-8252-d8c10bae2e1b" :step/math-academy-id 618980 :step/next {:db/id #edb/ref 17592186101909}} {:db/id #edb/ref 17592186101909 :step/content {:db/id #edb/ref 17592186101021 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100733 :question/id #uuid "a0f21b4c-0f5c-5567-aaec-9da481d2e7ac" :question/math-academy-id "e-547"} :knowledge-point/id #uuid "86221215-32a6-5c5a-bcd7-220e166bcee8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048187} {:db/id #edb/ref 17592186050819}] :knowledge-point/questions [{:db/id #edb/ref 17592186101335} {:db/id #edb/ref 17592186101336} {:db/id #edb/ref 17592186101382} {:db/id #edb/ref 17592186256385} {:db/id #edb/ref 17592186256391} {:db/id #edb/ref 17592186290568} {:db/id #edb/ref 17592186290569} {:db/id #edb/ref 17592186290572} {:db/id #edb/ref 17592186290575} {:db/id #edb/ref 17592186290580} {:db/id #edb/ref 17592186317508} {:db/id #edb/ref 17592186459215} {:db/id #edb/ref 17592186459232} {:db/id #edb/ref 17592186459242} {:db/id #edb/ref 17592186459273} {:db/id #edb/ref 17592186459274}] :knowledge-point/title "Finding Points That Satisfy the Mean Value Theorem for Integrals"} :step/id #uuid "3e6aeea7-0134-5101-a19a-c37ab846bb82" :step/math-academy-id 618981 :step/next {:db/id #edb/ref 17592186101910}} {:db/id #edb/ref 17592186101910 :step/content {:db/id #edb/ref 17592186102035 :tutorial/content "The **average value** of a continuous function on a closed interval $[a,b]$ is given by\n\n$$\nf_\\textrm{avg} = \\dfrac{1}{b-a}\\int_a^b f(x) \\: \\textrm{d}x.\n$$" :tutorial/id #uuid "1cced554-b7fa-5fd4-b8b5-86c8e0bb4bc0" :tutorial/math-academy-id 988 :tutorial/title "The Average Value of a Function"} :step/id #uuid "42fd3643-e43b-5a23-8553-5171fa424230" :step/math-academy-id 618984 :step/next {:db/id #edb/ref 17592186101911}} {:db/id #edb/ref 17592186101911 :step/content {:db/id #edb/ref 17592186101022 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100734 :question/id #uuid "0c84fc6d-422e-5729-94d2-a12cda71f78d" :question/math-academy-id "e-548"} :knowledge-point/id #uuid "55fab3ac-cad3-54bd-b07b-9159554b634c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050489}] :knowledge-point/questions [{:db/id #edb/ref 17592186101365} {:db/id #edb/ref 17592186101379} {:db/id #edb/ref 17592186235502} {:db/id #edb/ref 17592186297300} {:db/id #edb/ref 17592186297301} {:db/id #edb/ref 17592186297310} {:db/id #edb/ref 17592186297311} {:db/id #edb/ref 17592186297458} {:db/id #edb/ref 17592186304792} {:db/id #edb/ref 17592186304797} {:db/id #edb/ref 17592186304800} {:db/id #edb/ref 17592186317521} {:db/id #edb/ref 17592186317528} {:db/id #edb/ref 17592186317529} {:db/id #edb/ref 17592186459207} {:db/id #edb/ref 17592186459219} {:db/id #edb/ref 17592186459253} {:db/id #edb/ref 17592186541150}] :knowledge-point/title "Finding the Average Value of a Function Over a Given Interval"} :step/id #uuid "89d80bd5-bf3f-5758-a57c-65437a4424dd" :step/math-academy-id 618985 :step/next {:db/id #edb/ref 17592186101912}} {:db/id #edb/ref 17592186101912 :step/content {:db/id #edb/ref 17592186101023 :knowledge-point/canonical-example {:db/id #edb/ref 17592186