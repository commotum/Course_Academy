f29-5fd9-9604-e25bef7d5e32" :knowledge-point/questions [{:db/id #edb/ref 17592186083974} {:db/id #edb/ref 17592186083976} {:db/id #edb/ref 17592186268917} {:db/id #edb/ref 17592186268925} {:db/id #edb/ref 17592186292923} {:db/id #edb/ref 17592186302180} {:db/id #edb/ref 17592186302182} {:db/id #edb/ref 17592186415881} {:db/id #edb/ref 17592186493898} {:db/id #edb/ref 17592186493899} {:db/id #edb/ref 17592186493917} {:db/id #edb/ref 17592186493975} {:db/id #edb/ref 17592186507489} {:db/id #edb/ref 17592186516814} {:db/id #edb/ref 17592186519528} {:db/id #edb/ref 17592186519585}] :knowledge-point/title "Finding a Probability When a Population Parameter is Unknown"} :step/id #uuid "828a2000-0cb2-577a-9a4c-50d319487a43" :step/math-academy-id 30930} {:db/id #edb/ref 17592186084297 :step/content {:db/id #edb/ref 17592186083342 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083145 :question/id #uuid "c55db5a3-2d8c-57d7-b860-8628cb8738f0" :question/math-academy-id "e-9892"} :knowledge-point/id #uuid "7f79d9ff-425b-5f2e-8380-23435a01a5b4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048615}] :knowledge-point/questions [{:db/id #edb/ref 17592186083528} {:db/id #edb/ref 17592186083529} {:db/id #edb/ref 17592186269205} {:db/id #edb/ref 17592186269206} {:db/id #edb/ref 17592186269207} {:db/id #edb/ref 17592186493926} {:db/id #edb/ref 17592186493938} {:db/id #edb/ref 17592186493946}] :knowledge-point/title "Identifying Data Sets That Could Be Normally Distributed"} :step/id #uuid "98535c60-8311-53a8-9f73-e175c3ec6497" :step/math-academy-id 37200 :step/next {:db/id #edb/ref 17592186084270}}] :activity/title "Modeling With the Normal Distribution" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083466}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186415883} :activity/id #uuid "2c1f6cc5-5968-538f-9311-8522a9dd360b" :activity/scope {:db/id #edb/ref 17592186050198 :topic/id #uuid "35c03b2e-e860-5cb2-96d6-2e103a19283f" :topic/math-academy-id 788} :activity/steps [{:db/id #edb/ref 17592186415883 :step/content {:db/id #edb/ref 17592186415882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01aac47c-bc41-58aa-a4b6-55ca3bbd11b0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ minutes" :db/id #edb/ref 17592186415873} {:answer/id #uuid "2ef719c3-66a7-50b4-a2f7-e921efeb034a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ minutes" :db/id #edb/ref 17592186415874} {:answer/id #uuid "4e4b0043-0c74-53a6-a993-6328a52b0af3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$14$ minutes" :db/id #edb/ref 17592186415875} {:answer/id #uuid "58d37435-1075-579f-a1f9-ce0f3925f1fb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$11$ minutes" :db/id #edb/ref 17592186415876} {:answer/id #uuid "f1fee109-4588-538f-b649-9c3fd53fe5ef" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$12$ minutes" :db/id #edb/ref 17592186415878}] :answer-field/correct {:db/id #edb/ref 17592186415873} :answer-field/id #uuid "0b712d39-ff45-54f8-b106-03be0d0cda60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415879}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "979b0f60-49c9-5b48-86f8-6e501f45d940" :question/math-academy-id "q-95151" :question/problem "The average duration (in minutes) of the videos produced by a popular content creator is $35\\,\\text{min}.$ Also, $5%$ of their videos have a duration of less than $20$ minutes. Assuming that the duration of the videos is normally distributed, find the standard deviation of the duration times, rounded to the near minute.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $p$ | $\\,0.01\\,$ | $\\,0.03\\,$ | $\\,0.05\\,$ | $\\,0.10\\,$ | $\\,0.15\\,$ | $\\,0.20\\,$ | $\\,0.25\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,-2.3263\\,$ | $\\,-1.8808\\,$ | $\\,-1.6449\\,$ | $\\,-1.2816\\,$ | $\\,-1.0364\\,$ | $\\,-0.8416\\,$ | $\\,-0.6745\\,$ |" :question/worked-solution "Let $X$ represent the duration of a video. Then we have $X∼N(35,{\\sigma }^{2}),$ and we want to find the standard deviation $\\sigma .$ \n\nWe know that $P(X\\le 20)=0.05.$ Converting $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X\\le 20) & =0.05 \\\\ P(Z\\le \\frac{20-35}{\\sigma }) & =0.05 \\\\ Φ(-\\frac{15}{\\sigma }) & =0.05 \\\\ -\\frac{15}{\\sigma } & ={Φ}^{-1}(0.05).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.05)=-1.6449.\n$$\n\nFinally then, \n\n$$\n\\begin{aligned}-\\frac{15}{\\sigma } & =-1.6449 \\\\ \\frac{1}{\\sigma } & =0.1097 \\\\ \\sigma  & ≈9\\,\\text{minutes}.\\end{aligned}\n$$"} :step/id #uuid "08ba30f8-c04b-524e-80f7-0ec881803edf" :step/next {:db/id #edb/ref 17592186415887}} {:db/id #edb/ref 17592186415884 :step/content {:db/id #edb/ref 17592186302161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ce3962b-9372-53e8-94dd-19aae1e9b687" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.51" :db/id #edb/ref 17592186300674}] :answer-field/correct {:db/id #edb/ref 17592186300674} :answer-field/id #uuid "752c40b7-22f4-5848-b34a-2e00b4e7dbd7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186301589}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6829b460-7921-509d-b187-5e5360672369" :question/math-academy-id "q-324314" :question/problem "The lengths of metal rods produced by a certain factory are normally distributed with a mean of $100$ centimeters and a standard deviation of $4$ centimeters. What is the probability that a randomly selected rod is longer or equal to $96.8\\,cm$ but shorter than $102.4\\,cm?$ **Round your answer to two decimal places**.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| | $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.0\\,$ | $\\,0.1587\\,$ | $\\,0.1562\\,$ | $\\,0.1539\\,$ |\n| $\\,-0.9\\,$ | $\\,0.1841\\,$ | $\\,0.1814\\,$ | $\\,0.1788\\,$ |\n| $\\,-0.8\\,$ | $\\,0.2119\\,$ | $\\,0.2090\\,$ | $\\,0.2061\\,$ | |  | | $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.4\\,$ | $\\,0.6554\\,$ | $\\,0.6591\\,$ | $\\,0.6628\\,$ |\n| $\\,0.5\\,$ | $\\,0.6915\\,$ | $\\,0.6944\\,$ | $\\,0.6985\\,$ |\n| $\\,0.6\\,$ | $\\,0.7257\\,$ | $\\,0.7291\\,$ | $\\,0.7324\\,$ | |  |\n| --- | --- | --- | --- |\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| $\\,-1.0\\,$ | $\\,0.1587\\,$ | $\\,0.1562\\,$ | $\\,0.1539\\,$ |\n| $\\,-0.9\\,$ | $\\,0.1841\\,$ | $\\,0.1814\\,$ | $\\,0.1788\\,$ |\n| $\\,-0.8\\,$ | $\\,0.2119\\,$ | $\\,0.2090\\,$ | $\\,0.2061\\,$ |\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| $\\,0.4\\,$ | $\\,0.6554\\,$ | $\\,0.6591\\,$ | $\\,0.6628\\,$ |\n| $\\,0.5\\,$ | $\\,0.6915\\,$ | $\\,0.6944\\,$ | $\\,0.6985\\,$ |\n| $\\,0.6\\,$ | $\\,0.7257\\,$ | $\\,0.7291\\,$ | $\\,0.7324\\,$ |\n\nThe probability that a randomly selected rod is longer or equal to $96.8\\,cm$ but shorter than $102.4\\,cm$ is approximately\n{{field-1}}." :question/worked-solution "Let $X$ represent the rod length (in centimeters). Then we have $X∼N(100,{4}^{2}).$\n\nWe want to find $P(96.8\\le X<102.4).$ First, we convert $X$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(96.8\\le X<102.4) & =P(\\frac{96.8-100}{4}\\le Z<\\frac{102.4-100}{4}) \\\\  & =P(-0.80\\le Z<0.60)\\end{aligned}\n$$\n\nNow, we express the required probability in terms of $Φ(z):$\n\n$$\n\\begin{aligned}P(-0.80\\le Z<0.60) & =P(Z<0.60)-P(Z<-0.80) \\\\  & =P(Z\\le 0.60)-P(Z\\le -0.80) \\\\  & =Φ(0.60)-Φ(-0.80)\\end{aligned}\n$$\n\nFrom the $z$-table, we see that\n\n$$\n\\begin{aligned}Φ(0.60) & =0.7257 \\\\ Φ(-0.80) & =0.2119.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}P(-0.80<Z<0.60) & =Φ(0.60)-Φ(-0.80) \\\\  & =0.7257-0.2119 \\\\  & =0.5138 \\\\  & ≈0.51\\end{aligned}\n$$\n\nTherefore, the probability that a randomly selected rod is longer or equal to $96.8\\,cm$ but shorter than $102.4\\,cm$ is approximately $0.51.$"} :step/id #uuid "13582afe-72fb-5625-8464-5f459b09da11" :step/next {:db/id #edb/ref 17592186415886}} {:db/id #edb/ref 17592186415885 :step/content {:db/id #edb/ref 17592186415881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83221c93-603d-5671-86b0-b2c0e8b223f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.22" :db/id #edb/ref 17592186415877}] :answer-field/correct {:db/id #edb/ref 17592186415877} :answer-field/id #uuid "3ee986dc-58c5-5a6b-9a45-c8daf6a2b863" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186415880}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "384a66a5-a5c9-58f8-aa5d-723b50b59cc7" :question/math-academy-id "q-325130" :question/problem "The fasting glucose level of a clinic’s patients is normally distributed with a mean of $\\mu \\,\\text{mg/dL}$ and a standard deviation of $15\\,\\text{mg/dL}.$ Additionally, $60%$ of the patients have a glucose level between $0.92\\mu \\,\\text{mg/dL}$ and $1.08\\mu \\,\\text{mg/dL}.$ Find the percentage of patients with a fasting glucose lower than $130\\,\\text{mg/dL}.$ **Round your answer to two decimal places.**\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.75\\,$ | $\\,0.80\\,$ | $\\,0.85\\,$ | $\\,0.90\\,$ | $\\,0.95\\,$ | $\\,0.99\\,$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,2.3263\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.04\\,$ | $\\,0.05\\,$ | $\\,0.06\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.9\\,$ | $\\,0.0262\\,$ | $\\,0.0256\\,$ | $\\,0.0250\\,$ |\n| $\\,-1.8\\,$ | $\\,0.0329\\,$ | $\\,0.0322\\,$ | $\\,0.0314\\,$ |\n| $\\,-1.7\\,$ | $\\,0.0409\\,$ | $\\,0.0401\\,$ | $\\,0.0392\\,$ |\n\nApproximately\n{{field-1}}$%$ of the patients have a fasting glucose lower than $130\\,\\text{mg/dL}.$" :question/worked-solution "Let $X$ represent the fasting glucose level of a randomly selected patient. Then we have $X∼N(\\mu ,{15}^{2}),$ and we want to find $P(X<130).$ But first, we need to find the mean $\\mu .$ \n\nWe know that $P(0.92\\mu <X<1.08\\mu )=0.60.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(0.92\\mu <X<1.08\\mu ) & =0.60 \\\\ 2P(\\mu <X<1.08\\mu ) & =0.60 \\\\ P(\\mu <X<1.08\\mu ) & =0.30 \\\\ P(X<\\mu )+P(\\mu <X<1.08\\mu ) & =0.5+0.30 \\\\ P(X<1.08\\mu ) & =0.80\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X<1.08\\mu ) & =0.80 \\\\ P(Z<\\frac{0.08\\mu }{15}) & =0.80 \\\\ Φ(\\frac{0.08\\mu }{15}) & =0.80 \\\\ \\frac{0.08\\mu }{15} & ={Φ}^{-1}(0.80).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.80)=0.8416.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{0.08\\mu }{15} & =0.8416 \\\\ 0.08\\mu  & =12.624 \\\\ \\mu  & =\\frac{12.624}{0.08} \\\\  & ≈157.80.\\end{aligned}\n$$\n\nFinally, we can solve for $P(X<130)$ as follows:\n\n$$\n\\begin{aligned}P(X<130) & =P(Z<\\frac{130-157.80}{15}) \\\\  & ≈P(Z<-1.85) \\\\  & =Φ(-1.85) \\\\  & =0.0322 \\\\  & ≈3.22%\\end{aligned}\n$$\n\nTherefore, approximately $3.22%$ of the patients have a fasting glucose lower than $130\\,\\text{mg/dL}.$"} :step/id #uuid "4bf19974-65f5-541f-96e4-687af8d2f431"} {:db/id #edb/ref 17592186415886 :step/content {:db/id #edb/ref 17592186302164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fb6f7f4-57a5-52f7-8e64-395b91ab0e51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.10" :db/id #edb/ref 17592186300689}] :answer-field/correct {:db/id #edb/ref 17592186300689} :answer-field/id #uuid "fc161ec3-c1d9-5eb1-baaa-2ab67d18a5ac" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186302031}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aace1ce7-1675-5a50-8ee4-f15b9647304c" :question/math-academy-id "q-324349" :question/problem "The flight times of a particular drone model are normally distributed with a mean of $35$ minutes and a standard deviation of $4$ minutes. What is the probability that a randomly selected drone flies more than $40.08$ minutes on a single charge? **Round your answer to two decimal places.**\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- |\n| $\\,1.1\\,$ | $\\,0.8749\\,$ | $\\,0.8770\\,$ | $\\,0.8790\\,$ |\n| $\\,1.2\\,$ | $\\,0.8944\\,$ | $\\,0.8962\\,$ | $\\,0.8980\\,$ |\n| $\\,1.3\\,$ | $\\,0.9115\\,$ | $\\,0.9131\\,$ | $\\,0.9147\\,$ |\n\nThe probability that a randomly selected drone flies more than $40.08$ minutes on a single charge is approximately\n{{field-1}}." :question/worked-solution "Let $X$ represent the drone flight time (in minutes). Then we have $X∼N(35,{4}^{2}).$\n\nWe want to find $P(X>40.08).$ Thus, we convert $X$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X>40.08) & =P(Z>\\frac{40.08-35}{4}) \\\\  & =P(Z>1.27) \\\\  & =1-P(Z\\le 1.27) \\\\  & =1-Φ(1.27)\\end{aligned}\n$$\n\nFrom the $z$-table, we see that\n\n$$\n1-Φ(1.27)=1-0.8980≈0.10.\n$$\n\nTherefore, the probability that a randomly selected drone flies more than $40.08$ minutes on a single charge is approximately $0.10.$"} :step/id #uuid "b1290537-191a-5941-898f-4165f87ba9c8" :step/next {:db/id #edb/ref 17592186415885}} {:db/id #edb/ref 17592186415887 :step/content {:db/id #edb/ref 17592186268925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "209a5dc2-51b8-5cf8-a3fd-432567049203" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8.1%" :db/id #edb/ref 17592186266433} {:answer/id #uuid "285a1d46-eca2-5392-87b2-9ae6a067d406" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7.9%" :db/id #edb/ref 17592186266502} {:answer/id #uuid "383eb090-4034-58c4-90ea-549e44d474a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11.5%" :db/id #edb/ref 17592186266633} {:answer/id #uuid "7be87196-7809-5fb8-a83b-62481b462d15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9.6%" :db/id #edb/ref 17592186267243} {:answer/id #uuid "bc16961d-f939-5b46-a020-4871a6a9d710" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8.9%" :db/id #edb/ref 17592186267828}] :answer-field/correct {:db/id #edb/ref 17592186266502} :answer-field/id #uuid "0642bb25-91a1-5589-b640-3a5b72872474" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268415}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "763a853d-691e-5772-a9d4-a4d4d0b3eb60" :question/math-academy-id "q-133053" :question/problem "The diameter of the kibble of a particular cat food brand is normally distributed with a mean of $\\mu $ and a standard deviation of $0.7\\,\\text{mm}.$ Additionally, the diameter of $20%$ of kibbles is less than $4.4\\,\\text{mm}$ in diameter. Find the percentage of kibbles whose diameter is less than $4\\,\\text{mm},$ rounded to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.01\\,$ | $\\,0.03\\,$ | $\\,0.05\\,$ | $\\,0.10\\,$ | $\\,0.15\\,$ | $\\,0.20\\,$ | $\\,0.25\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,-2.3263\\,$ | $\\,-1.8808\\,$ | $\\,-1.6449\\,$ | $\\,-1.2816\\,$ | $\\,-1.0364\\,$ | $\\,-0.8416\\,$ | $\\,-0.6745\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.4\\,$ | $\\,0.0808\\,$ | $\\,0.0793\\,$ | $\\,0.0778\\,$ |\n| $\\,-1.3\\,$ | $\\,0.0968\\,$ | $\\,0.0951\\,$ | $\\,0.0934\\,$ |\n| $\\,-1.2\\,$ | $\\,0.1151\\,$ | $\\,0.1131\\,$ | $\\,0.1112\\,$ |" :question/worked-solution "Let $X$ represent the diameter of a randomly selected kibble. Then we have $X∼N(\\mu ,{0.7}^{2}),$ and we want to find the $P(X<4).$\n\nWe know that $P(X<4.4)=0.20.$ First, we convert $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<4.4) & =0.20 \\\\ P(Z<\\frac{4.4-\\mu }{0.7}) & =0.20 \\\\ Φ(\\frac{4.4-\\mu }{0.7}) & =0.20 \\\\ \\frac{4.4-\\mu }{0.7} & ={Φ}^{-1}(0.20)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.20)≈-0.8416.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{4.4-\\mu }{0.7} & =-0.8416 \\\\ 4.4-\\mu  & =-0.58912 \\\\ \\mu  & =4.98912\\end{aligned}\n$$\n\nFinally, we can solve for $P(X<4)$ as follows:\n\n$$\n\\begin{aligned}P(X<4) & =P(X\\le 4) \\\\  & =P(Z\\le \\frac{4-4.98912}{0.7}) \\\\  & ≈P(Z\\le -1.41) \\\\  & =0.0793 \\\\  & ≈7.9%\\end{aligned}\n$$\n\nTherefore, approximately $7.9%$ of kibbles are less than $4\\,\\text{mm}$ in diameter."} :step/id #uuid "cd1c27a9-4fc5-505a-a0b1-c103e40a7537" :step/next {:db/id #edb/ref 17592186415884}}] :activity/title "Modeling With the Normal Distribution" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186415872}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186507553} :activity/id #uuid "2d2487a3-1789-5b3f-bcb6-be692fcece6c" :activity/scope {:db/id #edb/ref 17592186050198 :topic/id #uuid "35c03b2e-e860-5cb2-96d6-2e103a19283f" :topic/math-academy-id 788} :activity/steps [{:db/id #edb/ref 17592186507553 :step/content {:db/id #edb/ref 17592186083974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f04dd09-9af6-5af5-b2a7-02412d51615e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.7%" :db/id #edb/ref 17592186082776} {:answer/id #uuid "95a31260-f0cc-565e-b971-d2bd4d135ec4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3.9%" :db/id #edb/ref 17592186082777} {:answer/id #uuid "bf2a8b1e-34b7-5bdb-960e-a7263f101f35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11.2%" :db/id #edb/ref 17592186082778} {:answer/id #uuid "dd0255ec-0e04-54e7-ae22-0d510b62b4f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.8%" :db/id #edb/ref 17592186082779} {:answer/id #uuid "6ac1477f-55e1-52bb-abe7-4f577c033faa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5%" :db/id #edb/ref 17592186082780}] :answer-field/correct {:db/id #edb/ref 17592186082776} :answer-field/id #uuid "9cf9b764-d015-5366-9df6-e11472a54a5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186082775}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9debd84a-b5d9-54c6-84fa-986684bdfc9b" :question/math-academy-id "q-94702" :question/problem "In a factory, cookies contain $15$ grams of sugar on average. However, $10%$ of cookies contain more than $17$ grams of sugar. Assuming that the amount of sugar in each cookie is normally distributed, find the percent of cookies that contain fewer than $12$ grams of sugar, rounded to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution, *\n\n| $p$ | $\\,0.900\\,$ | $\\,0.950\\,$ | $\\,0.975\\,$ | $\\,0.990\\,$ | $\\,0.995\\,$ | $\\,0.999\\,$ | $\\,0.9995\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.9600\\,$ | $\\,2.3263\\,$ | $\\,2.5758\\,$ | $\\,3.0902\\,$ | $\\,3.2905\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.9\\,$ | $\\,0.0287\\,$ | $\\,0.0281\\,$ | $\\,0.0274\\,$ |\n| $\\,-1.8\\,$ | $\\,0.0359\\,$ | $\\,0.0351\\,$ | $\\,0.0344\\,$ |\n| $\\,-1.7\\,$ | $\\,0.0446\\,$ | $\\,0.0436\\,$ | $\\,0.0427\\,$ |" :question/requires-calculator true :question/worked-solution "Let $X$ represent the number of grams of sugar in a cookie. Then we have $X∼N(15,{\\sigma }^{2}),$ and we want to find $P(X<12).$ But first, we need to find the standard deviation $\\sigma .$ \n\nWe know that $P(X>17)=0.1.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(X\\le 17) & =1-P(X>17) \\\\  & =1-0.1 \\\\  & =0.9\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X\\le 17) & =0.9 \\\\ P(Z\\le \\frac{17-15}{\\sigma }) & =0.9 \\\\ Φ(\\frac{2}{\\sigma }) & =0.9 \\\\ \\frac{2}{\\sigma } & ={Φ}^{-1}(0.9)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.9)≈1.2816.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{2}{\\sigma } & =1.2816 \\\\ \\frac{1}{\\sigma } & =0.6408 \\\\ \\sigma  & =\\frac{1}{0.6408} \\\\  & ≈1.5605.\\end{aligned}\n$$\n\nFinally, we can solve for $P(X<12)$ as follows:\n\n$$\n\\begin{aligned}P(X<12) & =P(X\\le 12) \\\\  & =P(Z\\le \\frac{12-15}{1.5605}) \\\\  & ≈P(Z\\le -1.92) \\\\  & =Φ(-1.92) \\\\  & =0.0274 \\\\  & ≈2.7%\\end{aligned}\n$$\n\nTherefore, approximately $2.7%$ of cookies contain less than $12$ grams of sugar."} :step/id #uuid "5bce04ca-70c6-54fe-8fc6-e22eeb0734f9" :step/next {:db/id #edb/ref 17592186507572}} {:db/id #edb/ref 17592186507572 :step/content {:db/id #edb/ref 17592186083975 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cb42038-d4e2-5cd2-8193-28bac637ba07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.13" :db/id #edb/ref 17592186082782} {:answer/id #uuid "292516a9-9b55-5825-97e9-ce95b5702014" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.87" :db/id #edb/ref 17592186082783} {:answer/id #uuid "3b79c1d9-f7d4-5316-be66-a07d9bb8fe63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.92" :db/id #edb/ref 17592186082784} {:answer/id #uuid "698291c0-9ecf-5cf7-aa1b-9afe2e390f0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.08" :db/id #edb/ref 17592186082785} {:answer/id #uuid "6aede979-f402-5d68-8ab7-96a5935c49a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.23" :db/id #edb/ref 17592186082786}] :answer-field/correct {:db/id #edb/ref 17592186082785} :answer-field/id #uuid "d097420f-f8f8-569f-a975-5e227fecbe9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186082781}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3e774eae-3ccc-5f1e-a35b-4ce8e1ddec45" :question/math-academy-id "q-94971" :question/problem "The test scores of a group of students are normally distributed with a mean of $73$ and a standard deviation of $5.$ What is the probability that a randomly selected student got a score of $80$ or more? Round your answer to $2$ decimal places.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,1.3\\,$ | $\\,0.9032\\,$ | $\\,0.9049\\,$ | $\\,0.9066\\,$ |\n| $\\,1.4\\,$ | $\\,0.9192\\,$ | $\\,0.9207\\,$ | $\\,0.9222\\,$ |\n| $\\,1.5\\,$ | $\\,0.9332\\,$ | $\\,0.9345\\,$ | $\\,0.9357\\,$ |" :question/requires-calculator true :question/worked-solution "Let $X$ represent the score of a randomly selected student. Then we have $X∼N(73,{5}^{2}).$\n\nWe want to find $P(X\\ge 80).$ Thus, we convert $X$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\ge 80) & =P(Z\\ge \\frac{80-73}{5}) \\\\  & =P(Z\\ge 1.4) \\\\  & =1-P(Z\\le 1.4) \\\\  & =1-Φ(1.4)\\end{aligned}\n$$\n\nFrom the $z$-table, we see that\n\n$$\n1-Φ(1.40)=1-0.9192≈0.08.\n$$\n\nTherefore, the probability that a randomly selected student got $80$ or more is $0.08.$"} :step/id #uuid "b7e8932f-d2fc-59f3-abbd-cd780ac112de" :step/next {:db/id #edb/ref 17592186507574}} {:db/id #edb/ref 17592186507574 :step/content {:db/id #edb/ref 17592186400674 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6938ada6-d242-5a29-b3cc-1005ff1beb10" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2.69$ years" :db/id #edb/ref 17592186400676} {:answer/id #uuid "f4c15084-f362-505f-8950-6df3b2548ace" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2.74$ years" :db/id #edb/ref 17592186400677} {:answer/id #uuid "e01f491c-202f-5132-a3f5-3f0f2930aa15" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2.65$ years" :db/id #edb/ref 17592186400678} {:answer/id #uuid "79ea6bf2-0abb-5dd3-8132-52b2488943a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2.57$ years" :db/id #edb/ref 17592186400679} {:answer/id #uuid "7b383bc1-6fb9-59e8-b057-fb6dccdf74a2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2.79$ years" :db/id #edb/ref 17592186400680}] :answer-field/correct {:db/id #edb/ref 17592186400676} :answer-field/id #uuid "eb566678-fdf6-552d-aad6-4bf9b9328ba8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186400675}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "42e998b4-da64-533d-80e4-6303495d71cd" :question/math-academy-id "q-132852" :question/problem "The lifetime of a lithium-ion battery produced by a particular company is normally distributed with a mean of $\\mu $ years and a standard deviation of $0.5$ years.\nAdditionally, $3%$ of batteries last less than $1.75$ years. Find the mean $\\mu $, rounded to $2$ decimal places.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.01\\,$ | $\\,0.03\\,$ | $\\,0.05\\,$ | $\\,0.10\\,$ | $\\,0.15\\,$ | $\\,0.20\\,$ | $\\,0.25\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,-2.3263\\,$ | $\\,-1.8808\\,$ | $\\,-1.6449\\,$ | $\\,-1.2816\\,$ | $\\,-1.0364\\,$ | $\\,-0.8416\\,$ | $\\,-0.6745\\,$ |" :question/worked-solution "Let $X$ represent the lifetime of a randomly selected battery. Then we have $X∼N(\\mu ,{0.5}^{2}),$ and we want to find the mean $\\mu .$ \n\nWe know that $P(X<1.75)=0.03.$ Converting $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<1.75) & =0.03 \\\\ P(Z\\le \\frac{1.75-\\mu }{0.5}) & =0.03 \\\\ Φ(\\frac{1.75-\\mu }{0.5}) & =0.03 \\\\ \\frac{1.75-\\mu }{0.5} & ={Φ}^{-1}(0.03).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.03)=-1.8808.\n$$\n\nFinally then, \n\n$$\n\\begin{aligned}\\frac{1.75-\\mu }{0.5} & =-1.8808 \\\\ 1.75-\\mu  & =-0.9404 \\\\ \\mu  & ≈2.69.\\end{aligned}\n$$"} :step/id #uuid "c58cd6d2-7a47-5d68-ba83-ba5b2c86397f" :step/next {:db/id #edb/ref 17592186507584}} {:db/id #edb/ref 17592186507584 :step/content {:db/id #edb/ref 17592186507444 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d935e86d-2878-5713-88af-732c2cd4dd43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9.05" :db/id #edb/ref 17592186507145}] :answer-field/correct {:db/id #edb/ref 17592186507145} :answer-field/id #uuid "eb3c213e-a427-5f30-8b6a-3f5985900ded" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186507383}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "62a29958-3d43-5575-a73a-6517a1734f8a" :question/math-academy-id "q-324461" :question/problem "The price of a deli sandwich is normally distributed with a mean of $\\mu $ dollars and a standard deviation of $$1.10.$ In addition, in $90%$ of cases the price is between $$0.80\\mu $ and $$1.20\\mu .$ Find the average price, **rounding your answer to two decimal places**.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $p$ | $\\,0.75\\,$ | $\\,0.80\\,$ | $\\,0.85\\,$ | $\\,0.90\\,$ | $\\,0.95\\,$ | $\\,0.97\\,$ | $\\,0.99\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.8808\\,$ | $\\,2.3263\\,$ |\n\n$\\mu ≈$\n{{field-1}}\n$dollars$" :question/worked-solution "Let $X$ represent a sandwich price. Then we have $X∼N(\\mu ,{1.10}^{2}),$ and we want to find the mean $\\mu .$ \n\nWe know that $P(0.80\\mu <X<1.20\\mu )=0.90.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(0.80\\mu <X<1.20\\mu ) & =0.90 \\\\ 2P(\\mu <X<1.20\\mu ) & =0.90 \\\\ P(\\mu <X<1.20\\mu ) & =0.45 \\\\ P(X<\\mu )+P(\\mu <X<1.20\\mu ) & =0.5+0.45 \\\\ P(X<1.20\\mu ) & =0.95.\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X<1.20\\mu ) & =0.95 \\\\ P(Z<\\frac{0.20\\mu }{1.10}) & =0.95 \\\\ Φ(\\frac{0.20\\mu }{1.10}) & =0.95 \\\\ \\frac{0.20\\mu }{1.10} & ={Φ}^{-1}(0.95).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.95)=1.6449.\n$$\n\nFinally then,\n\n$$\n\\begin{aligned}\\frac{0.20\\mu }{1.10} & =1.6449 \\\\ 0.20\\mu  & =1.809\\,39 \\\\ \\mu  & =\\frac{1.809\\,39}{0.20} \\\\  & ≈9.05\\,\\text{dollars}.\\end{aligned}\n$$"} :step/id #uuid "de38d27b-caa8-5826-b9f1-c99bfdbf34b2" :step/next {:db/id #edb/ref 17592186507592}} {:db/id #edb/ref 17592186507592 :step/content {:db/id #edb/ref 17592186507489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea413de4-f41d-5bd6-8d46-90d7116bd177" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "51.99" :db/id #edb/ref 17592186507195}] :answer-field/correct {:db/id #edb/ref 17592186507195} :answer-field/id #uuid "abe2d838-2efe-5d60-8dd7-942ce7ac6cc4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186507349}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bd63f548-8bbe-5de7-9356-fc14587f7fab" :question/math-academy-id "q-325117" :question/problem "The heights of oak trees in a park are normally distributed with a mean of $\\mu $ feet and a standard deviation of $8$ feet. Additionally, $25%$ of the trees are shorter than $45$ feet. Find the percentage of trees taller than $50$ feet. **Round your answer to two decimal places.**\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $p$ | $\\,0.01\\,$ | $\\,0.03\\,$ | $\\,0.05\\,$ | $\\,0.10\\,$ | $\\,0.20\\,$ | $\\,0.25\\,$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,-2.3263\\,$ | $\\,-1.8808\\,$ | $\\,-1.6449\\,$ | $\\,-1.2816\\,$ | $\\,-0.8416\\,$ | $\\,-0.6745\\,$ |\n\n*In addition, you're given the following table of values for $p=Φ(z).$*\n\n| $z$ | $\\,0.03\\,$ | $\\,0.04\\,$ | $\\,0.05\\,$ |\n| --- | --- | --- | --- |\n| $\\,-0.2\\,$ | $\\,0.4090\\,$ | $\\,0.4052\\,$ | $\\,0.4013\\,$ |\n| $\\,-0.1\\,$ | $\\,0.4483\\,$ | $\\,0.4443\\,$ | $\\,0.4404\\,$ |\n| $\\,-0.0\\,$ | $\\,0.4880\\,$ | $\\,0.4840\\,$ | $\\,0.4801\\,$ |\n\nApproximately\n{{field-1}}$%$ of the trees are taller than $50$ feet." :question/worked-solution "Let $X$ represent the height of a randomly selected tree. Then we have $X∼N(\\mu ,{8}^{2}),$ and we want to find $P(X>50).$  \n\nWe know that $P(X<45)=0.25.$ First, we convert $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<45) & =0.25 \\\\ P(Z<\\frac{45-\\mu }{8}) & =0.25 \\\\ Φ(\\frac{45-\\mu }{8}) & =0.25 \\\\ \\frac{45-\\mu }{8} & ={Φ}^{-1}(0.25)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.25)=-0.6745.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{45-\\mu }{8} & =-0.6745 \\\\ 45-\\mu  & =-5.396 \\\\ \\mu  & =50.396.\\end{aligned}\n$$\n\nFinally, we can solve for $P(50<X)$ as follows:\n\n$$\n\\begin{aligned}P(X>50) & =P(Z>\\frac{50-50.396}{8}) \\\\  & ≈P(Z>-0.05) \\\\  & =1-Φ(-0.05) \\\\  & =1-0.4801 \\\\  & ≈51.99%\\end{aligned}\n$$\n\nTherefore, approximately $51.99%$ of the trees are taller than $50$ feet."} :step/id #uuid "fadeb461-5bd5-527d-84af-be4656af31e5"}] :activity/title "Modeling With the Normal Distribution" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186506665}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186516922} :activity/id #uuid "64330229-1f3f-5a64-b45a-9aa819eb027e" :activity/scope {:db/id #edb/ref 17592186050198 :topic/id #uuid "35c03b2e-e860-5cb2-96d6-2e103a19283f" :topic/math-academy-id 788} :activity/steps [{:db/id #edb/ref 17592186516920 :step/content {:db/id #edb/ref 17592186516814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30d8cfe9-4b93-5f75-80a5-535b163dfe29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "85.3%" :db/id #edb/ref 17592186516214} {:answer/id #uuid "34d6d3c7-1689-5248-895a-b81d7cf970d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "87.5%" :db/id #edb/ref 17592186516223} {:answer/id #uuid "6466cbf3-e0e7-5e28-a7cc-3d9c12cae870" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "89.8%" :db/id #edb/ref 17592186516331} {:answer/id #uuid "66956326-a3a4-5914-80b0-99ab80e8cc5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "87.9%" :db/id #edb/ref 17592186516334} {:answer/id #uuid "b3cebdaf-ad45-5124-8538-17b343686fe2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "89.4%" :db/id #edb/ref 17592186516484}] :answer-field/correct {:db/id #edb/ref 17592186516484} :answer-field/id #uuid "d7a92c6e-2892-5988-ae79-425c23feccca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516750}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7012a871-ceb2-5bf5-9d51-cddf37c78344" :question/math-academy-id "q-133054" :question/problem "The average volume of soda in cans is $12$ ounces. Additionally, in $3%$ of cans, the soda volume is less than $11.7$ ounces. Assuming the volume of soda is normally distributed, find the percentage of cans containing less than $12.2$ ounces of soda, rounded to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $p$ | $\\,0.01\\,$ | $\\,0.03\\,$ | $\\,0.05\\,$ | $\\,0.10\\,$ | $\\,0.15\\,$ | $\\,0.20\\,$ | $\\,0.25\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,-2.3263\\,$ | $\\,-1.8808\\,$ | $\\,-1.6449\\,$ | $\\,-1.2816\\,$ | $\\,-1.0364\\,$ | $\\,-0.8416\\,$ | $\\,-0.6745\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- |\n| $\\,1.0\\,$ | $\\,0.8531\\,$ | $\\,0.8554\\,$ | $\\,0.8577\\,$ |\n| $\\,1.1\\,$ | $\\,0.8749\\,$ | $\\,0.8770\\,$ | $\\,0.8790\\,$ |\n| $\\,1.2\\,$ | $\\,0.8944\\,$ | $\\,0.8962\\,$ | $\\,0.8980\\,$ |" :question/worked-solution "Let $X$ represent the volume of soda in a randomly selected can. Then we have $X∼N(12,{\\sigma }^{2}),$ and we want to find $P(X<12.2).$ But first, we need to find the standard deviation $\\sigma .$\n\nWe know that $P(X<11.7)=0.03.$ First, we convert $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<11.7) & =0.03 \\\\ P(Z\\le \\frac{11.7-12}{\\sigma }) & =0.03 \\\\ Φ(\\frac{-0.3}{\\sigma }) & =0.03 \\\\ \\frac{-0.3}{\\sigma } & ={Φ}^{-1}(0.03)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.03)≈-1.8808.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{-0.3}{\\sigma } & =-1.8808 \\\\ \\frac{1}{\\sigma } & =6.26933 \\\\ \\sigma  & =\\frac{1}{6.26933} \\\\  & ≈0.1595.\\end{aligned}\n$$\n\n \n\nFinally, we can solve for $P(X<12.2)$ as follows:\n\n$$\n\\begin{aligned}P(X<12.2) & =P(X\\le 12.2) \\\\  & =P(Z\\le \\frac{12.2-12}{0.1595}) \\\\  & ≈P(Z\\le 1.25) \\\\  & =Φ(1.25) \\\\  & ≈89.4%\\end{aligned}\n$$\n\nTherefore, approximately $89.4%$  of soda cans contain less than $12.2$ ounces of soda."} :step/id #uuid "748cd377-8e7f-5346-aa3b-db4fe18ddcb5" :step/next {:db/id #edb/ref 17592186516932}} {:db/id #edb/ref 17592186516922 :step/content {:db/id #edb/ref 17592186493962 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "264f5867-7c47-5f07-9b9c-b3815c6cd840" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "53.10\\,\\text{cm}" :db/id #edb/ref 17592186493452} {:answer/id #uuid "73143a86-4466-59b0-9d13-697c03f90f7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40.50\\,\\text{cm}" :db/id #edb/ref 17592186493562} {:answer/id #uuid "975eb98b-4ab0-5014-8bea-9fcf9cfaaba5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50.50\\,\\text{cm}" :db/id #edb/ref 17592186493630} {:answer/id #uuid "ec6926a3-0298-524c-9ffa-d17531745d04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "52.15\\,\\text{cm}" :db/id #edb/ref 17592186493768} {:answer/id #uuid "ff5d72e2-1423-5d98-a00f-6cea45e898da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "48.05\\,\\text{cm}" :db/id #edb/ref 17592186493801}] :answer-field/correct {:db/id #edb/ref 17592186493630} :answer-field/id #uuid "7782954d-0945-5a09-a4ad-d4eaf2acb6cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493839}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d916a01a-c116-520b-be92-bf93eddd6997" :question/math-academy-id "q-95126" :question/problem "The lengths of babies at birth in a given population are normally distributed with a mean of $\\mu \\,\\text{cm}$ and a standard deviation of $6\\,\\text{cm}.$ Additionally, the length of $60%$ of the newborns falls between $0.9\\mu \\,\\text{cm}$ and $1.1\\mu \\,\\text{cm}.$ Find the mean $\\mu $ rounded to $2$ decimal places.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.75\\,$ | $\\,0.80\\,$ | $\\,0.85\\,$ | $\\,0.90\\,$ | $\\,0.95\\,$ | $\\,0.97\\,$ | $\\,0.99\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.8808\\,$ | $\\,2.3263\\,$ |" :question/worked-solution "Let $X$ represent the length of a randomly selected newborn. Then we have $X∼N(\\mu ,{6}^{2}),$ and we want to find the mean $\\mu .$ \n\nWe know that $P(0.9\\mu <X<1.1\\mu )=0.6.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(0.9\\mu <X<1.1\\mu ) & =0.6 \\\\ 2P(\\mu <X<1.1\\mu ) & =0.6 \\\\ P(\\mu <X<1.1\\mu ) & =0.3 \\\\ P(X<\\mu )+P(\\mu <X<1.1\\mu ) & =0.5+0.3 \\\\ P(X<1.1\\mu ) & =0.8\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<1.1\\mu ) & =0.8 \\\\ P(Z<\\frac{0.1\\mu }{6}) & =0.8 \\\\ Φ(\\frac{0.1\\mu }{6}) & =0.8 \\\\ \\frac{0.1\\mu }{6} & ={Φ}^{-1}(0.8)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.8)≈0.8416.\n$$\n\nFinally then,\n\n$$\n\\begin{aligned}\\frac{0.1\\mu }{6} & =0.8416 \\\\ 0.1\\mu  & =5.0496 \\\\ \\mu  & =\\frac{5.0496}{0.1} \\\\  & ≈50.50\\,\\text{cm}.\\end{aligned}\n$$"} :step/id #uuid "7b705082-7666-5f62-ba6d-d0a2f1a92ff1" :step/next {:db/id #edb/ref 17592186516977}} {:db/id #edb/ref 17592186516932 :step/content {:db/id #edb/ref 17592186302169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0a05661-7722-5963-b806-be7baa982a14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2.13" :db/id #edb/ref 17592186301079}] :answer-field/correct {:db/id #edb/ref 17592186301079} :answer-field/id #uuid "4fef1f38-f1c6-5dcb-ab28-87a9ef1d2f28" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186301488}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c76de2b6-dcfd-5626-8f87-83f3745840b1" :question/math-academy-id "q-324458" :question/problem "In electronics manufacturing, the average resistance of a certain type of resistor is $100\\,Ω.$ However, $5%$ of resistors have resistance no more than $96.5\\,Ω.$ Assuming that resistor resistances are normally distributed, find the standard deviation, $\\sigma ,$ of the resistance, **rounded to two decimal places.**\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $\\,p\\,$ | $0.25$ | $0.20$ | $0.15$ | $0.10$ | $0.05$ | $0.01$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $\\,{Φ}^{-1}(p)\\,$ | $\\,-0.6745\\,$ | $\\,-0.8416\\,$ | $\\,-1.0364\\,$ | $\\,-1.2816\\,$ | $\\,-1.6449\\,$ | $\\,-2.3263\\,$ |\n\n$\\sigma ≈$\n{{field-1}}\n$Ω$" :question/worked-solution "Let $X$ represent the resistance (in ohms). Then we have $X∼N(100,{\\sigma }^{2}),$ and we want to find the standard deviation $\\sigma .$ \n\nWe know that $P(X\\le 96.5)=0.05.$ Converting $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X\\le 96.5) & =0.05 \\\\ P(Z\\le \\frac{96.5-100}{\\sigma }) & =0.05 \\\\ Φ(-\\frac{3.5}{\\sigma }) & =0.05 \\\\ -\\frac{3.5}{\\sigma } & ={Φ}^{-1}(0.05).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.05)=-1.6449.\n$$\n\nFinally then, \n\n$$\n\\begin{aligned}-\\frac{3.5}{\\sigma } & =-1.6449 \\\\ \\frac{3.5}{\\sigma } & =1.6449 \\\\ \\sigma  & =\\frac{3.5}{1.6449} \\\\  & ≈2.13\\,Ω.\\end{aligned}\n$$"} :step/id #uuid "84ec6b96-1b9c-5175-9b67-1af8a664fc76"} {:db/id #edb/ref 17592186516957 :step/content {:db/id #edb/ref 17592186516843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e35f18e-1bf6-5d1a-8e59-13ab06067872" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.27" :db/id #edb/ref 17592186516355} {:answer/id #uuid "9f019a42-6b8b-554e-91e3-893c44124a34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.25" :db/id #edb/ref 17592186516437} {:answer/id #uuid "cccb4d2d-b8aa-572e-aae2-f7163ea703a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.17" :db/id #edb/ref 17592186516544} {:answer/id #uuid "e80d0d28-5add-54e4-97f4-c1b73ae40982" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.23" :db/id #edb/ref 17592186516593} {:answer/id #uuid "fb074b86-3190-5f6d-8a8e-9fbdb9461d89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.22" :db/id #edb/ref 17592186516636}] :answer-field/correct {:db/id #edb/ref 17592186516437} :answer-field/id #uuid "606b941c-af91-539a-a82d-135b0666034b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516691}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bb189cdf-2b97-5db2-ae7a-d4991a5c036b" :question/math-academy-id "q-132711" :question/problem "The annual income of an employee in a large company is normally distributed with a mean of $$50\\,000$ and a standard deviation of $$15\\,000.$ What is the probability that a randomly selected employee's income is more than $$46\\,700$ but less than $$56\\,150?$ Round your answer to $2$ decimal places.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.2\\,$</th>\n<td align=\"center\"> $\\,0.4207\\,$ </td>\n<td align=\"center\"> $\\,0.4168\\,$ </td>\n<td align=\"center\"> $\\,0.4129\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.1\\,$</th>\n<td align=\"center\"> $\\,0.4602\\,$ </td>\n<td align=\"center\"> $\\,0.4562\\,$ </td>\n<td align=\"center\"> $\\,0.4522\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.0\\,$</th>\n<td align=\"center\"> $\\,0.5000\\,$ </td>\n<td align=\"center\"> $\\,0.4960\\,$ </td>\n<td align=\"center\"> $\\,0.4920\\,$ </td>\n</tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.2\\,$</th>\n<td align=\"center\"> $\\,0.5793\\,$ </td>\n<td align=\"center\"> $\\,0.5832\\,$ </td>\n<td align=\"center\"> $\\,0.5871\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.3\\,$</th>\n<td align=\"center\"> $\\,0.6179\\,$ </td>\n<td align=\"center\"> $\\,0.6217\\,$ </td>\n<td align=\"center\"> $\\,0.6255\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.4\\,$</th>\n<td align=\"center\"> $\\,0.6554\\,$ </td>\n<td align=\"center\"> $\\,0.6591\\,$ </td>\n<td align=\"center\"> $\\,0.6628\\,$ </td>\n</tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>" :question/worked-solution "Let $X$ represent the annual income (in dollars) of a randomly selected employee. Then we have $X∼N(50\\,000,15\\,{000}^{2}).$\n\nWe want to find $P(46\\,700<X<56\\,150).$ First, we convert $X$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(46\\,700<X<56\\,150) & =P(\\frac{46\\,700-50\\,000}{15\\,000}<Z<\\frac{56\\,150-50\\,000}{15\\,000}) \\\\  & =P(-0.22<Z<0.41)\\end{aligned}\n$$\n\nNow, we express the required probability in terms of $Φ(z):$\n\n$$\n\\begin{aligned}P(-0.22<Z<0.41) & =P(Z<0.41)-P(Z\\le -0.22) \\\\  & =P(Z\\le 0.41)-P(Z\\le -0.22) \\\\  & =Φ(0.41)-Φ(-0.22)\\end{aligned}\n$$\n\nFrom the $z$-table, we see that\n\n$$\n\\begin{aligned}Φ(0.41) & =0.6591 \\\\ Φ(-0.22) & =0.4129.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}P(-0.22<Z<0.41) & =Φ(0.41)-Φ(-0.22) \\\\  & =0.6591-0.4129 \\\\  & =0.2462 \\\\  & ≈0.25\\end{aligned}\n$$\n\nTherefore, the probability that a randomly selected employee's income is more than $$46\\,700$ but less than $$56\\,150$ is approximately $0.25.$"} :step/id #uuid "befbee96-262c-5724-ba3a-760d3be072eb" :step/next {:db/id #edb/ref 17592186516920}} {:db/id #edb/ref 17592186516977 :step/content {:db/id #edb/ref 17592186516780 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10a8235a-b96e-5fa1-8108-e0e6dd4ab2d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.25" :db/id #edb/ref 17592186516146} {:answer/id #uuid "4dccfb7c-69d9-5e39-bdc6-b9c1f9d8666a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.23" :db/id #edb/ref 17592186516272} {:answer/id #uuid "4e878814-1cec-558c-9ad5-c9d1d1636938" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.22" :db/id #edb/ref 17592186516273} {:answer/id #uuid "5923c2ed-ea1c-5b9b-918c-6ab0788b0527" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.27" :db/id #edb/ref 17592186516302} {:answer/id #uuid "70ba8ee7-e027-558d-ba3b-6caf25bcdd99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.17" :db/id #edb/ref 17592186516366}] :answer-field/correct {:db/id #edb/ref 17592186516273} :answer-field/id #uuid "6a80460b-81a6-5762-8a66-e56c03dc6782" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516697}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a1059d5-573e-59f8-8d92-01104e325d82" :question/math-academy-id "q-132444" :question/problem "A player's height in a particular professional basketball league is normally distributed with a mean of $77$ inches and a standard deviation of $3.57$ inches.\nWhat is the probability that the height of a randomly selected player is more than $76$ inches but less than $78$ inches?\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.07\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.08\\,$</th>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.1\\,$</th>\n<td align=\"center\"> $\\,0.5636\\,$ </td>\n<td align=\"center\"> $\\,0.5675\\,$ </td>\n<td align=\"center\"> $\\,0.5714\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.2\\,$</th>\n<td align=\"center\"> $\\,0.6026\\,$ </td>\n<td align=\"center\"> $\\,0.6064\\,$ </td>\n<td align=\"center\"> $\\,0.6103\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.3\\,$</th>\n<td align=\"center\"> $\\,0.6406\\,$ </td>\n<td align=\"center\"> $\\,0.6443\\,$ </td>\n<td align=\"center\"> $\\,0.6480\\,$ </td>\n</tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.07\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.08\\,$</th>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.3\\,$</th>\n<td align=\"center\"> $\\,0.3594\\,$ </td>\n<td align=\"center\"> $\\,0.3557\\,$ </td>\n<td align=\"center\"> $\\,0.3520\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.2\\,$</th>\n<td align=\"center\"> $\\,0.3974\\,$ </td>\n<td align=\"center\"> $\\,0.3936\\,$ </td>\n<td align=\"center\"> $\\,0.3897\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.1\\,$</th>\n<td align=\"center\"> $\\,0.4364\\,$ </td>\n<td align=\"center\"> $\\,0.4325\\,$ </td>\n<td align=\"center\"> $\\,0.4286\\,$ </td>\n</tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>" :question/worked-solution "Let $X$ represent the height (in inches) of a randomly selected player. Then we have $X∼N(77,{3.57}^{2}).$\n\nWe want to find $P(76<X<78).$ First, we convert $X$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(76<X<78) & =P(\\frac{76-77}{3.57}<Z<\\frac{78-77}{3.57}) \\\\  & =P(-0.28<Z<0.28)\\end{aligned}\n$$\n\nNow, we express the required probability in terms of $Φ(z):$\n\n$$\n\\begin{aligned}P(-0.28<Z<0.28) & =P(Z<0.28)-P(Z\\le -0.28) \\\\  & =P(Z\\le 0.28)-P(Z\\le -0.28) \\\\  & =Φ(0.28)-Φ(-0.28)\\end{aligned}\n$$\n\nFrom the $z$-table, we see that\n\n$$\n\\begin{aligned}Φ(0.28) & =0.6103 \\\\ Φ(-0.28) & =0.3897.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}P(-0.28<Z<0.28) & =Φ(0.28)-Φ(-0.28) \\\\  & =0.6103-0.3897 \\\\  & =0.2206 \\\\  & ≈0.22\\end{aligned}\n$$\n\nTherefore, the probability that the height of a randomly selected player is more than $76$ inches but less than $78$ inches is approximately $0.22.$"} :step/id #uuid "e8276290-fe52-5206-80df-9c013697fd59" :step/next {:db/id #edb/ref 17592186516957}}] :activity/title "Modeling With the Normal Distribution" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516097}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186519634} :activity/id #uuid "bf6ac6fe-4108-5b06-889b-5042a2db6611" :activity/scope {:db/id #edb/ref 17592186050198 :topic/id #uuid "35c03b2e-e860-5cb2-96d6-2e103a19283f" :topic/math-academy-id 788} :activity/steps [{:db/id #edb/ref 17592186519625 :step/content {:db/id #edb/ref 17592186519528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "032b45ef-0f8d-5228-ab53-44d951ab7b5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10.8%" :db/id #edb/ref 17592186518991} {:answer/id #uuid "0ef38244-8fdf-5af9-a467-8e572c929ba9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15.4%" :db/id #edb/ref 17592186519015} {:answer/id #uuid "3f275ff8-361f-502e-8e26-7ac774e7b63d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12.3%" :db/id #edb/ref 17592186519093} {:answer/id #uuid "c3efee66-91d8-51df-9c99-66043ccf9a2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8.7%" :db/id #edb/ref 17592186519316} {:answer/id #uuid "c9a1db81-4260-5c90-a443-a427b1dbd8f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6.3%" :db/id #edb/ref 17592186519321}] :answer-field/correct {:db/id #edb/ref 17592186518991} :answer-field/id #uuid "d314da54-c3a8-55ac-8066-a2906576f626" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519496}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "217980d1-12ff-5532-90b2-461f43899f04" :question/math-academy-id "q-95091" :question/problem "A truck travels an average distance of $21\\,\\text{mi}$ with a gallon of gas. However, $15%$ of the time, a truck travels more than $26\\,\\text{mi}$ on a gallon of gas. Assuming that the distance the truck can travel with a gallon of gas is normally distributed, find, as a percent, the proportion of journeys that the truck travels less than $15\\,\\text{mi}$ on a gallon of gas. Round your answer to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.75\\,$ | $\\,0.80\\,$ | $\\,0.85\\,$ | $\\,0.90\\,$ | $\\,0.95\\,$ | $\\,0.97\\,$ | $\\,0.99\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.8808\\,$ | $\\,2.3263\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.03\\,$ | $\\,0.04\\,$ | $\\,0.05\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.3\\,$ | $\\,0.0918\\,$ | $\\,0.0901\\,$ | $\\,0.0885\\,$ |\n| $\\,-1.2\\,$ | $\\,0.1093\\,$ | $\\,0.1075\\,$ | $\\,0.1056\\,$ |\n| $\\,-1.1\\,$ | $\\,0.1292\\,$ | $\\,0.1271\\,$ | $\\,0.1251\\,$ |" :question/worked-solution "Let $X$ represent the distance traveled by the truck with a gallon of gas. Then we have $X∼N(21,{\\sigma }^{2}),$ and we want to find $P(X\\le 15).$ But first, we need to find the standard deviation $\\sigma .$ \n\nWe know that $P(X>26)=0.15.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(X\\le 26) & =1-P(X>26) \\\\  & =1-0.15 \\\\  & =0.85\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X\\le 26) & =0.85 \\\\ P(Z\\le \\frac{26-21}{\\sigma }) & =0.85 \\\\ Φ(\\frac{5}{\\sigma }) & =0.85 \\\\ \\frac{5}{\\sigma } & ={Φ}^{-1}(0.85)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.85)≈1.0364.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{5}{\\sigma } & =1.0364 \\\\ \\frac{1}{\\sigma } & =0.2073 \\\\ \\sigma  & =\\frac{1}{0.2073} \\\\  & ≈4.8239.\\end{aligned}\n$$\n\nFinally, we can solve for $P(X\\le 15)$ as follows:\n\n$$\n\\begin{aligned}P(X\\le 15) & =P(Z\\le \\frac{15-21}{4.8239}) \\\\  & ≈P(Z\\le -1.24) \\\\  & =Φ(-1.24) \\\\  & =0.1075 \\\\  & ≈10.8%\\end{aligned}\n$$\n\nTherefore, approximately $10.8%$ of the time, a gallon of gas travels only $15\\,\\text{mi}$ or less."} :step/id #uuid "32dc4d78-bb43-5899-aa0c-4eaf5371d15f" :step/next {:db/id #edb/ref 17592186519645}} {:db/id #edb/ref 17592186519634 :step/content {:db/id #edb/ref 17592186360541 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1103e6c4-8e5a-5d60-a8d6-1e582b31d670" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.27" :db/id #edb/ref 17592186357894} {:answer/id #uuid "4beccc4b-bd42-53f7-a6ef-d29833929fbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.31" :db/id #edb/ref 17592186358408} {:answer/id #uuid "58efc89e-0bb9-5250-bf2e-d9981f1e00d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.16" :db/id #edb/ref 17592186358525} {:answer/id #uuid "ea0097db-0220-5610-aa9c-bf8496bfb7cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.13" :db/id #edb/ref 17592186359833} {:answer/id #uuid "ee51d506-3a45-567d-86d2-6491d5d72676" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.23" :db/id #edb/ref 17592186359876}] :answer-field/correct {:db/id #edb/ref 17592186358525} :answer-field/id #uuid "79790386-5ca3-5b7e-a326-b45ba6bd2fed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360193}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5563fda7-bd6a-55bd-869b-0a5d94077bb5" :question/math-academy-id "q-95024" :question/problem "The time that a particular laptop battery lasts is normally distributed with a mean of $32$ hours and a standard deviation of $4$ hours. What is the probability that a full charge lasts for $36$ hours or more? Round your answer to $2$ decimal places.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.9\\,$ | $\\,0.8159\\,$ | $\\,0.8186\\,$ | $\\,0.8212\\,$ |\n| $\\,1.0\\,$ | $\\,0.8413\\,$ | $\\,0.8438\\,$ | $\\,0.8461\\,$ |\n| $\\,1.1\\,$ | $\\,0.8643\\,$ | $\\,0.8665\\,$ | $\\,0.8686\\,$ |" :question/worked-solution "Let $X$ represent the time the full charge lasts. Then we have $X∼N(32,{4}^{2}).$\n\nWe want to find $P(X\\ge 36).$ Thus, we convert $X$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\ge 36) & =P(Z\\ge \\frac{36-32}{4}) \\\\  & =P(Z\\ge 1) \\\\  & =1-P(Z\\le 1) \\\\  & =1-Φ(1)\\end{aligned}\n$$\n\nFrom the $z$-table, we see that\n\n$$\n1-Φ(1)=1-0.8413≈0.1587.\n$$\n\nTherefore, the probability that a full charge lasts $36$ hours or more is approximately $0.16.$"} :step/id #uuid "56641216-408e-5e32-aa9c-fd0d315b82bb" :step/next {:db/id #edb/ref 17592186519652}} {:db/id #edb/ref 17592186519638 :step/content {:db/id #edb/ref 17592186519587 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83f88efb-26a7-5927-a3a0-854d67c40077" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3121" :db/id #edb/ref 17592186519199}] :answer-field/correct {:db/id #edb/ref 17592186519199} :answer-field/id #uuid "9151a6ca-f2c2-5987-ba7e-6def5ae3cbbb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186519466}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d6b501ec-18d5-51e8-9a88-2c1c73e44bb9" :question/math-academy-id "q-324738" :question/problem "The lifespan of LED light bulbs is normally distributed with a mean of $40,000$ hours and an unknown standard deviation $\\sigma .$ Tests show that $10%$ of bulbs fail before $36,000$ hours. Assuming a normal model, find the standard deviation, **rounded to the nearest integer.**\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $\\,z\\,$ | $0.75$ | $0.8$ | $0.85$ | $0.9$ | $0.95$ |\n| --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ |\n\n$\\sigma ≈$\n{{field-1}}\n$h$" :question/worked-solution "Let $X$ represent the lifespan of an LED bulb. Then we have $X∼N(40,000,{\\sigma }^{2}),$ and we want to find the standard deviation $\\sigma .$ \n\nWe know that $P(X<36,000)=0.10.$ Converting $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<36,000) & =0.10 \\\\ P(Z\\le \\frac{36,000-40,000}{\\sigma }) & =0.10 \\\\ Φ(-\\frac{4,000}{\\sigma }) & =0.10 \\\\ -\\frac{4,000}{\\sigma } & ={Φ}^{-1}(0.10).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.9)=1.2816,\n$$\n\nand therefore, by symmetry, we have\n\n$$\n{Φ}^{-1}(0.10)=-1.2816.\n$$\n\nFinally then, \n\n$$\n\\begin{aligned}-\\frac{4,000}{\\sigma } & =-1.2816 \\\\ \\frac{4,000}{\\sigma } & =1.2816 \\\\ \\sigma  & =\\frac{4,000}{1.2816} \\\\ \\sigma  & ≈3,121\\,\\text{h.}\\end{aligned}\n$$"} :step/id #uuid "6ad30f7d-f1bb-527b-8b86-a6ac3a6b2e3a"} {:db/id #edb/ref 17592186519645 :step/content {:db/id #edb/ref 17592186519585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09021ce8-047e-5b0d-92f8-36d32076c19b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "78.2%" :db/id #edb/ref 17592186519005} {:answer/id #uuid "2d58aa30-649a-5d30-86fd-836c82705dcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "83.4%" :db/id #edb/ref 17592186519065} {:answer/id #uuid "7bce9ce0-a3ff-570e-86db-d819bc4f24bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "80.8%" :db/id #edb/ref 17592186519187} {:answer/id #uuid "99059b85-08c0-5911-bef5-b258cf55a646" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "76.9%" :db/id #edb/ref 17592186519244} {:answer/id #uuid "99eaaeec-7b23-5191-b1ac-c727b2e8bc60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "81.1%" :db/id #edb/ref 17592186519246}] :answer-field/correct {:db/id #edb/ref 17592186519005} :answer-field/id #uuid "3d8d7f1f-3c0d-5b85-87f8-4a2364ded62c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519432}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d34b6be0-737c-5c5c-907f-c713ce8e6b32" :question/math-academy-id "q-133236" :question/problem "The average height of a player in a particular professional basketball league is $78$ inches. Additionally, $15%$ of players are over $82$ inches tall. Assuming that a player's height is normally distributed, find the percentage of players over $75$ inches tall, rounded to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.75\\,$ | $\\,0.80\\,$ | $\\,0.85\\,$ | $\\,0.90\\,$ | $\\,0.95\\,$ | $\\,0.97\\,$ | $\\,0.99\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.8808\\,$ | $\\,2.3263\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.07\\,$ | $\\,0.08\\,$ | $\\,0.09\\,$ |\n| --- | --- | --- | --- |\n| $\\,-0.9\\,$ | $\\,0.1660\\,$ | $\\,0.1635\\,$ | $\\,0.1611\\,$ |\n| $\\,-0.8\\,$ | $\\,0.1922\\,$ | $\\,0.1894\\,$ | $\\,0.1867\\,$ |\n| $\\,-0.7\\,$ | $\\,0.2206\\,$ | $\\,0.2177\\,$ | $\\,0.2148\\,$ |" :question/worked-solution "Let $X$ represent the height of a randomly selected player. Then we have $X∼N(78,{\\sigma }^{2}),$ and we want to find $P(X>75).$ But first, we need to find the standard deviation $\\sigma .$ \n\nWe know that $P(X>82)=0.15.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(X\\le 82) & =1-P(X>82) \\\\  & =1-0.15 \\\\  & =0.85\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X\\le 82) & =0.85 \\\\ P(Z\\le \\frac{82-78}{\\sigma }) & =0.85 \\\\ Φ(\\frac{4}{\\sigma }) & =0.85 \\\\ \\frac{4}{\\sigma } & ={Φ}^{-1}(0.85)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.85)≈1.0364.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{4}{\\sigma } & =1.0364 \\\\ \\frac{1}{\\sigma } & =0.2591 \\\\ \\sigma  & =\\frac{1}{0.2591} \\\\  & ≈3.85951.\\end{aligned}\n$$\n\nFinally, we can solve for $P(X>75)$ as follows:\n\n$$\n\\begin{aligned}P(X>75) & =1-P(X\\le 75) \\\\  & =1-P(Z\\le \\frac{75-78}{3.85951}) \\\\  & ≈1-P(Z\\le -0.78) \\\\  & =1-Φ(-0.78) \\\\  & =1-0.2177 \\\\  & =0.7823 \\\\  & ≈78.2%\\end{aligned}\n$$\n\nTherefore, approximately $78.2%$ of players are over $75$ inch tall."} :step/id #uuid "7740d24e-5ea6-5c07-adbb-1160b7ed84f3" :step/next {:db/id #edb/ref 17592186519638}} {:db/id #edb/ref 17592186519652 :step/content {:db/id #edb/ref 17592186519591 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bf6bb84-99f4-501b-898f-55beecfd0ae8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10.89" :db/id #edb/ref 17592186519011} {:answer/id #uuid "6e877167-064e-5961-ba0d-9292251730e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13.66" :db/id #edb/ref 17592186519157} {:answer/id #uuid "a07531b8-8752-5b56-b8df-4b8c0357540d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11.44" :db/id #edb/ref 17592186519253} {:answer/id #uuid "dc0bfe5f-9010-5b76-900e-a0a88d617f3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12.54" :db/id #edb/ref 17592186519356} {:answer/id #uuid "f64b54b4-f561-592c-ab77-9cb0208b121a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15.51" :db/id #edb/ref 17592186519395}] :answer-field/correct {:db/id #edb/ref 17592186519356} :answer-field/id #uuid "c153adbb-ebdd-563f-aa07-ecead9219cce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519487}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e64f0682-cd52-5135-b0b3-08e76e7a1873" :question/math-academy-id "q-95082" :question/problem "A group of students took a test and got an average score of $79.$ Also, $15%$ of the students scored lower than $66.$ Assuming that the scores of the students are normally distributed, find the standard deviation of their scores, rounded to $2$ decimal places.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.75\\,$ | $\\,0.80\\,$ | $\\,0.85\\,$ | $\\,0.90\\,$ | $\\,0.95\\,$ | $\\,0.97\\,$ | $\\,0.99\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.8808\\,$ | $\\,2.3263\\,$ |" :question/worked-solution "Let $X$ represent the grade obtained by a student. Then we have $X∼N(79,{\\sigma }^{2}),$ and we want to find the standard deviation $\\sigma .$ \n\nWe know that $P(X\\le 66)=0.15.$ Converting $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X\\le 66) & =0.15 \\\\ P(Z\\le \\frac{66-79}{\\sigma }) & =0.15 \\\\ Φ(-\\frac{13}{\\sigma }) & =0.15 \\\\ -\\frac{13}{\\sigma } & ={Φ}^{-1}(0.15).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.85)=1.0364,\n$$\n\nand therefore by symmetry, we have\n\n$$\n{Φ}^{-1}(1-0.85)={Φ}^{-1}(0.15)=-1.0364.\n$$\n\nFinally then, \n\n$$\n\\begin{aligned}-\\frac{13}{\\sigma } & =-1.0364 \\\\ \\sigma  & =\\frac{-13}{-1.0364} \\\\  & ≈12.54.\\end{aligned}\n$$"} :step/id #uuid "9bbd7fd0-91ef-5408-a5b3-5e27ebef199f" :step/next {:db/id #edb/ref 17592186519625}}] :activity/title "Modeling With the Normal Distribution" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186518985}] [{:activity/expected-seconds 840.0 :activity/first-step {:db/id #edb/ref 17592186093309} :activity/id #uuid "59e47f38-9dc9-538d-993c-2e3ee834c641" :activity/scope {:db/id #edb/ref 17592186050779 :topic/id #uuid "66051139-bfd1-53ce-b0e2-5c7d415815e5" :topic/math-academy-id 999} :activity/steps [{:db/id #edb/ref 17592186093309 :step/content {:db/id #edb/ref 17592186093361 :tutorial/content "To calculate the arc length of a polar curve $r=r(\\theta)$ between the rays $\\theta=\\theta_1$ and $\\theta=\\theta_2,$ we can use the formula\n\n$$\nL = \\int_{\\theta_1}^{\\theta_2} \\sqrt{r^2 +\\left(\\frac{\\textrm{d}r}{\\textrm{d}\\theta}\\right)^2 }\\textrm{d}\\theta.\n$$\n\nFor example, suppose that we want to find the arc length of the polar curve $r = 2,$ where $\\dfrac{\\pi}{6} \\leq \\theta \\leq \\dfrac{2\\pi}{3}.$ The required arc length is shown in blue in the picture below.\n\n![](images/e9/e91cd717469db56426e39e8975aa04710ff2357c7a0d5de9d20f99bc5edcbb1c.png)\n\nWe will use the formula to compute the arc length. Since $r=2,$ we have\n\n$$\n\\dfrac{\\textrm{d}r}{\\textrm{d}\\theta} = 0,\n$$\n\nand therefore, the arc length can be calculated as follows:\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{2\\pi /3}\\sqrt{{2}^{2}+{(0)}^{2}}\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{2\\pi /3}2\\,\\text{d}\\theta  \\\\  & =2{\\int }_{\\pi /6}^{2\\pi /3}\\text{d}\\theta  \\\\  & =2\\theta \\,{|}_{\\pi /6}^{2\\pi /3} \\\\  & =2(\\frac{2\\pi }{3}-\\frac{\\pi }{6}) \\\\  & =\\pi \\end{aligned}\n$$" :tutorial/id #uuid "46d71df2-8000-5586-bb24-748b23a02ce3" :tutorial/math-academy-id 1141 :tutorial/title "Introduction"} :step/id #uuid "cc4e82f8-a2bd-59bb-ab26-acf1b38e6eba" :step/math-academy-id 617629 :step/next {:db/id #edb/ref 17592186093310}} {:db/id #edb/ref 17592186093310 :step/content {:db/id #edb/ref 17592186092373 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092125 :question/id #uuid "8b8e3c66-fc60-57ac-baf7-0661e213d01e" :question/math-academy-id "e-7400"} :knowledge-point/id #uuid "cd0b4da9-1a0f-5a46-aff1-3ce5c0cebb3b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050277}] :knowledge-point/questions [{:db/id #edb/ref 17592186092571} {:db/id #edb/ref 17592186092764} {:db/id #edb/ref 17592186235501} {:db/id #edb/ref 17592186238061} {:db/id #edb/ref 17592186238062} {:db/id #edb/ref 17592186275260} {:db/id #edb/ref 17592186275261} {:db/id #edb/ref 17592186275263} {:db/id #edb/ref 17592186367610} {:db/id #edb/ref 17592186399405} {:db/id #edb/ref 17592186401014} {:db/id #edb/ref 17592186401021} {:db/id #edb/ref 17592186446930} {:db/id #edb/ref 17592186446933} {:db/id #edb/ref 17592186499502} {:db/id #edb/ref 17592186499546} {:db/id #edb/ref 17592186531626}] :knowledge-point/title "Creating an Integral Expression For the Arc Length of a Polar Curve"} :step/id #uuid "fb73f248-2c4e-50c5-b636-329ca36abf27" :step/math-academy-id 617630 :step/next {:db/id #edb/ref 17592186093311}} {:db/id #edb/ref 17592186093311 :step/content {:db/id #edb/ref 17592186092374 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092093 :question/id #uuid "57034318-5a6e-53f6-a8d3-ae8c61692947" :question/math-academy-id "e-641"} :knowledge-point/id #uuid "84a533e8-9a7c-58f3-9d3c-7c08b3c6bfd1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049488}] :knowledge-point/questions [{:db/id #edb/ref 17592186092922} {:db/id #edb/ref 17592186092923} {:db/id #edb/ref 17592186238064} {:db/id #edb/ref 17592186238068} {:db/id #edb/ref 17592186287977} {:db/id #edb/ref 17592186319211} {:db/id #edb/ref 17592186321141} {:db/id #edb/ref 17592186321143} {:db/id #edb/ref 17592186332861} {:db/id #edb/ref 17592186368473} {:db/id #edb/ref 17592186368927} {:db/id #edb/ref 17592186446931} {:db/id #edb/ref 17592186446932} {:db/id #edb/ref 17592186446934} {:db/id #edb/ref 17592186446935} {:db/id #edb/ref 17592186499484} {:db/id #edb/ref 17592186531565} {:db/id #edb/ref 17592186531606} {:db/id #edb/ref 17592186531628} {:db/id #edb/ref 17592186531644} {:db/id #edb/ref 17592186536832}] :knowledge-point/title "Finding the Arc Length of a Polar Curve"} :step/id #uuid "4d753f5d-a62d-581e-9242-d4c1c4d4bef5" :step/math-academy-id 617633 :step/next {:db/id #edb/ref 17592186093312}} {:db/id #edb/ref 17592186093312 :step/content {:db/id #edb/ref 17592186093364 :tutorial/content "We've been using the following formula to compute the arc length bounded by a polar curve:\n\n$$\nL = \\int_{\\theta_1}^{\\theta_2} \\sqrt{ r^2 + \\left( \\frac{\\textrm{d}r}{\\textrm{d}\\theta} \\right)^2} \\:\\textrm{d}\\theta\n$$\n\nBut where does this formula come from? Let's start with the familiar formula for the arc length of a parametric curve:\n\n$$\nL = \\int_{t_1}^{t_2} \\sqrt{ \\left(\\frac{\\textrm{d}x}{\\textrm{d}t}\\right)^2 +\\left(\\frac{\\textrm{d}y}{\\textrm{d}t}\\right)^2 }\\textrm{d}t\n$$\n\nA polar curve is really just a parametric curve with parameter $\\theta$ and parametric equations given by\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nWriting the arc length formula for a parametric function with parameter $\\theta,$ we have\n\n$$\nL = \\int_{\\theta_1}^{\\theta_2} \\sqrt{ \\left(\\frac{\\textrm{d}x}{\\textrm{d}\\theta}\\right)^2 +\\left(\\frac{\\textrm{d}y}{\\textrm{d}\\theta}\\right)^2 }\\textrm{d}\\theta .\n$$\n\nSince $x = r \\cos \\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(r\\operatorname{cos}⁡\\theta ) \\\\  & =\\frac{\\text{d}r}{\\text{d}\\theta }\\operatorname{cos}⁡\\theta +r\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta ) \\\\  & =\\frac{\\text{d}r}{\\text{d}\\theta }\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nLikewise, since $y=r\\sin \\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(r\\operatorname{sin}⁡\\theta ) \\\\  & =\\frac{\\text{d}r}{\\text{d}\\theta }\\operatorname{sin}⁡\\theta +r\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{sin}⁡\\theta ) \\\\  & =\\frac{\\text{d}r}{\\text{d}\\theta }\\operatorname{sin}⁡\\theta +r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nSubstituting the above into our expression for $L,$ we reach the desired formula:\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}\\theta })}^{2}+{(\\frac{\\text{d}y}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{(\\frac{\\text{d}r}{\\text{d}\\theta }\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta )}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta }\\operatorname{sin}⁡\\theta +r\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}{sin}^{2}⁡\\theta +{r}^{2}{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\\end{aligned}\n$$" :tutorial/id #uuid "1821e80d-8c1b-5d2f-88dd-c207d2c3d99f" :tutorial/math-academy-id 1144 :tutorial/title "Derivation of the Main Formula"} :step/id #uuid "a2419f97-10bb-5949-b766-7c403f31ea78" :step/math-academy-id 617636}] :activity/title "The Arc Length of a Polar Curve" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092470}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186499588} :activity/id #uuid "caa1b6ea-7850-5c84-a961-1177d87914d7" :activity/scope {:db/id #edb/ref 17592186050779 :topic/id #uuid "66051139-bfd1-53ce-b0e2-5c7d415815e5" :topic/math-academy-id 999} :activity/steps [{:db/id #edb/ref 17592186499574 :step/content {:db/id #edb/ref 17592186499546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "160e2a0c-f074-5874-a5f2-17cc1fc2cae2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /3}\\sqrt{1-4\\operatorname{cos}⁡\\theta +5{cos}^{2}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186498777} {:answer/id #uuid "6d20f288-51ab-5e95-ad79-fa5df49f89a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /3}^{\\pi }\\sqrt{3-4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186498973} {:answer/id #uuid "a35283a7-4adc-5de1-826d-87a387cd4479" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /3}^{\\pi }\\sqrt{5-4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186499081} {:answer/id #uuid "c87b6998-b8e9-5934-9893-be14c9c09927" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi /3}^{\\pi /3}\\sqrt{5+4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186499169} {:answer/id #uuid "d102d768-01d6-510f-bd39-ea2452eac6cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{\\pi /3}^{\\pi }\\sqrt{3+4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186499192}] :answer-field/correct {:db/id #edb/ref 17592186499081} :answer-field/id #uuid "cafcbac5-e575-5e1d-93e5-5e527facd2e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499408}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d774fdc1-484c-5e5e-b140-afbc35a348d0" :question/math-academy-id "q-51202" :question/problem "![](images/87/87a3563153fe0310767a79a96df0df5f6c0824027776b761df4a792b8b9b235e.png)\n\nWhich of the following gives the arc length of the polar curve $r=1-2\\operatorname{cos}⁡\\theta $ for $\\frac{\\pi }{3}\\le \\theta \\le \\pi $ (shown in blue in the diagram above)?" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1-2\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=2\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{(1-2\\operatorname{cos}⁡\\theta )^{2}+(2\\operatorname{sin}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{1-4\\operatorname{cos}⁡\\theta +4{cos}^{2}⁡\\theta +4{sin}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{1-4\\operatorname{cos}⁡\\theta +4}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{5-4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"} :step/id #uuid "2648cacf-aed7-52cf-9142-851e9f4e62e6" :step/next {:db/id #edb/ref 17592186499632}} {:db/id #edb/ref 17592186499588 :step/content {:db/id #edb/ref 17592186499484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39bd8942-8ea6-5f03-b9c2-980c08387095" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{10}}{3}({e}^{3\\pi /2}+{e}^{-3\\pi /2})" :db/id #edb/ref 17592186498858} {:answer/id #uuid "3f95ea7f-6aac-57fb-89fc-e3618b1effd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4\\sqrt{10}}{3}{e}^{3\\pi /2}" :db/id #edb/ref 17592186498876} {:answer/id #uuid "472465ce-5697-565a-b045-a23526f9815c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}({e}^{2\\pi /3}-{e}^{-2\\pi /3})" :db/id #edb/ref 17592186498893} {:answer/id #uuid "a7929dc7-bc71-5a90-8bb2-c5a85e81928b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{10}}{3}({e}^{3\\pi /2}-{e}^{-3\\pi /2})" :db/id #edb/ref 17592186499099} {:answer/id #uuid "e97e245e-6898-5e7c-8a99-3baaa90c0589" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}{e}^{3\\pi /2}" :db/id #edb/ref 17592186499259}] :answer-field/correct {:db/id #edb/ref 17592186499099} :answer-field/id #uuid "62f08aa4-9c3b-5881-9036-fcd624473552" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499360}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "657b78ff-bfd8-5861-b182-c1815c474783" :question/math-academy-id "q-9534" :question/problem "Find the arc length of the polar curve $r=2{e}^{3\\theta }$ for $-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=2{e}^{3\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=6{e}^{3\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{{(2{e}^{3\\theta })}^{2}+{(6{e}^{3\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{4{e}^{6\\theta }+36{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{40{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & =2\\sqrt{10}{\\int }_{-\\pi /2}^{\\pi /2}{e}^{3\\theta }\\,\\text{d}\\theta  \\\\  & =\\frac{2\\sqrt{10}}{3}{e}^{3\\theta }{|}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{2\\sqrt{10}}{3}({e}^{3\\pi /2}-{e}^{-3\\pi /2}).\\end{aligned}\n$$"} :step/id #uuid "4ff166b5-1643-51d7-8f4b-ee7431c1594b" :step/next {:db/id #edb/ref 17592186499623}} {:db/id #edb/ref 17592186499622 :step/content {:db/id #edb/ref 17592186401014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c77b2f36-6be8-50c0-ae22-868fa6cf86a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401016} {:answer/id #uuid "09d3bae4-8fa4-5410-960c-88cdf9ccbafc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+4{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401017} {:answer/id #uuid "e29d1f8d-e673-5fab-ab5a-b94d3c279c90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+4{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401018} {:answer/id #uuid "d634400e-7fcc-5b2f-8882-b33255d21d09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+4{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401019} {:answer/id #uuid "33483e89-3247-5b5b-b6c3-9a62773834b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401020}] :answer-field/correct {:db/id #edb/ref 17592186401016} :answer-field/id #uuid "4d94100e-63ab-58cf-b2c0-0f485eafe140" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186401015}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a434871-4fea-52cd-80a4-1fd81c159fb1" :question/math-academy-id "q-15133" :question/problem "![](images/3a/3a760f55b6437a39010e4d1a00bdb5fb5390d848dd74347e7736e2ac49cd562b.png)\n\nWhich of the following gives the arc length of the polar curve $r=3\\operatorname{sin}⁡(4\\theta )$ for $0\\le \\theta \\le \\frac{\\pi }{4}$ (shown in blue in the diagram above)?" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=3\\operatorname{sin}⁡(4\\theta ),$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=12\\operatorname{cos}⁡(4\\theta ).\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(3\\operatorname{sin}⁡(4\\theta ))^{2}+(12\\operatorname{cos}⁡(4\\theta ))^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{9{sin}^{2}⁡(4\\theta )+144{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{9({sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta ))}\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"} :step/id #uuid "dadf755e-73d7-51d2-8724-9a8bc861f212" :step/next {:db/id #edb/ref 17592186499574}} {:db/id #edb/ref 17592186499623 :step/content {:db/id #edb/ref 17592186499502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0989efb5-1038-59ac-8680-60117382e68a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{0}^{\\pi /4}\\sqrt{(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186498746} {:answer/id #uuid "1ce9d6eb-3f8f-56eb-a2d0-a4cfacaf7268" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\int }_{0}^{\\pi /4}\\sqrt{{\\theta }^{2}+2(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+2}\\,\\text{d}\\theta " :db/id #edb/ref 17592186498792} {:answer/id #uuid "38d06719-2aef-52ec-b523-72bbe2d5ce07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{2(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186498855} {:answer/id #uuid "51cc30b4-2098-5551-9641-1f9551e409a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{{\\theta }^{2}+2(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+2}\\,\\text{d}\\theta " :db/id #edb/ref 17592186498920} {:answer/id #uuid "52b44f14-c340-50a7-9cae-50d08c357aa5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{{\\theta }^{2}+(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186498921}] :answer-field/correct {:db/id #edb/ref 17592186498920} :answer-field/id #uuid "f107053f-9248-55df-a0bd-cf3499751023" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499425}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "85d77d15-6969-5117-952d-e2b202d58514" :question/math-academy-id "q-15123" :question/problem "Which of the following gives the arc length of the polar curve $r=\\theta +\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{2}?$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\theta +\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=1-\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(\\theta +\\operatorname{cos}⁡\\theta )^{2}+(1-\\operatorname{sin}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{({\\theta }^{2}+2\\theta \\operatorname{cos}⁡\\theta +{cos}^{2}⁡\\theta )+(1-2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{\\theta }^{2}+2(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+2}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"} :step/id #uuid "db0cc4c9-0bed-5ca2-bb65-0c11a769bc8e" :step/next {:db/id #edb/ref 17592186499622}} {:db/id #edb/ref 17592186499632 :step/content {:db/id #edb/ref 17592186321141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd1ec179-c3eb-579d-b407-4fb26d5fa6e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{2}({e}^{\\pi }-1)" :db/id #edb/ref 17592186320154} {:answer/id #uuid "048e136b-84ec-5868-b091-1a12da7bcf24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{2}(e^{\\pi}-1)" :db/id #edb/ref 17592186498739}] :answer-field/correct {:db/id #edb/ref 17592186498739} :answer-field/id #uuid "2092fbc0-9454-5cb0-afd6-99345b4a8c65" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186320241}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e21eed1a-d586-5617-ae1f-53bbb8801576" :question/math-academy-id "q-353598" :question/problem "![](images/16/16b676776dc22aece5a1fa777007a03b9e7903706cbdf5cc4ae14d8508370419.png)\n\nFind the arc length $L$ of the polar curve $r={e}^{2\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{2}$ (shown in blue in the diagram above). Do not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={e}^{2\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=2{e}^{2\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{({e}^{2\\theta })}^{2}+{(2{e}^{2\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4\\theta }+4{e}^{4\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{5{e}^{4\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{5}{\\int }_{0}^{\\pi /2}{e}^{2\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{5}{[\\frac{1}{2}{e}^{2\\theta }]}_{0}^{\\pi /2} \\\\  & =\\frac{\\sqrt{5}}{2}{[{e}^{2\\theta }]}_{0}^{\\pi /2} \\\\  & =\\frac{\\sqrt{5}}{2}({e}^{2(\\pi /2)}-{e}^{0}) \\\\  & =\\frac{\\sqrt{5}}{2}({e}^{\\pi }-1).\\end{aligned}\n$$"} :step/id #uuid "f2616e77-5be4-5384-a0e8-bab12d8f6047"}] :activity/title "The Arc Length of a Polar Curve" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186498728}] [{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186531719} :activity/id #uuid "06060959-70db-516d-a667-e9e1c5818a37" :activity/scope {:db/id #edb/ref 17592186050779 :topic/id #uuid "66051139-bfd1-53ce-b0e2-5c7d415815e5" :topic/math-academy-id 999} :activity/steps [{:db/id #edb/ref 17592186531669 :step/content {:db/id #edb/ref 17592186531628 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "901a723b-e6e5-572f-9b48-3f4f2a4dea43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi" :db/id #edb/ref 17592186531175}] :answer-field/correct {:db/id #edb/ref 17592186531175} :answer-field/id #uuid "3487b8fc-2024-52a0-8191-9d6c368ac790" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186531427}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a9290c4e-ece3-5a58-aecc-bb62b4894116" :question/math-academy-id "q-353582" :question/problem "![](images/83/83813bff1ff86036e2773d9476150de619688daec9cae2623a555a43290cace3.png)\n\nFind the arc length $L$ of the polar curve $r=3\\operatorname{sin}⁡\\theta $ for $\\frac{\\pi }{2}\\le \\theta \\le \\frac{5\\pi }{6}$ (shown in blue in the diagram above). Do not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=3\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=3\\operatorname{cos}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{{(3\\operatorname{sin}⁡\\theta )}^{2}+{(3\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{9{sin}^{2}⁡\\theta +9{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{9}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}3\\,\\text{d}\\theta  \\\\  & =3\\theta \\,{|}_{\\pi /2}^{5\\pi /6} \\\\  & =3(\\frac{5\\pi }{6}-\\frac{\\pi }{2}) \\\\  & =\\pi .\\end{aligned}\n$$"} :step/id #uuid "1fbc467c-fa74-583d-ac77-d9d3baef5bc1" :step/next {:db/id #edb/ref 17592186531706}} {:db/id #edb/ref 17592186531696 :step/content {:db/id #edb/ref 17592186531565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138e119b-9f29-5728-b024-f296e1407436" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({3}^{\\pi }-1)" :db/id #edb/ref 17592186530898} {:answer/id #uuid "4c63f797-f964-543b-8948-8fa3ef071043" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{\\operatorname{ln}⁡3}({3}^{\\pi }+1)" :db/id #edb/ref 17592186531027} {:answer/id #uuid "6b6ad79e-00af-5e1d-b171-f99e8a87b59c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡3}{\\sqrt{1+\\operatorname{ln}⁡3}}({3}^{\\pi }-1)" :db/id #edb/ref 17592186531103} {:answer/id #uuid "a24f9d67-8d4f-5f04-a33c-d625d9ff53b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}({3}^{\\pi }-1)" :db/id #edb/ref 17592186531215} {:answer/id #uuid "ee47508c-c5ac-50f6-8486-05ab49b69007" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{1+{ln}^{2}⁡3}}{\\operatorname{ln}⁡3}({3}^{\\pi }-1)" :db/id #edb/ref 17592186531346}] :answer-field/correct {:db/id #edb/ref 17592186531346} :answer-field/id #uuid "770387f5-8ab3-56b6-9ab8-582f315d1f1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531469}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1bd5daf3-8ee2-5ee2-ae53-b882ce969a04" :question/math-academy-id "q-9541" :question/problem "Find the arc length of the polar curve $r={3}^{\\theta }$ for $0\\le \\theta \\le \\pi .$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={3}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }={3}^{\\theta }\\operatorname{ln}⁡3.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{({3}^{\\theta })}^{2}+{({3}^{\\theta }\\operatorname{ln}⁡3)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{3}^{2\\theta }+{3}^{2\\theta }{ln}^{2}⁡3}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{(1+{ln}^{2}⁡3){3}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡3}{\\int }_{0}^{\\pi }{3}^{\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡3}\\cdot \\frac{1}{\\operatorname{ln}⁡3}\\cdot {3}^{\\theta }{|}_{0}^{\\pi } \\\\  & =\\sqrt{1+{ln}^{2}⁡3}\\cdot \\frac{1}{\\operatorname{ln}⁡3}\\cdot ({3}^{\\pi }-{3}^{0}) \\\\  & =\\frac{\\sqrt{1+{ln}^{2}⁡3}}{\\operatorname{ln}⁡3}({3}^{\\pi }-1).\\end{aligned}\n$$"} :step/id #uuid "8478a7a6-7989-5221-ae40-cc42a13728b8" :step/next {:db/id #edb/ref 17592186531723}} {:db/id #edb/ref 17592186531706 :step/content {:db/id #edb/ref 17592186531606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebc83588-25b8-5ff4-bfc0-bce39c4a0f4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{10}(e^{\\pi}-1)" :db/id #edb/ref 17592186531337}] :answer-field/correct {:db/id #edb/ref 17592186531337} :answer-field/id #uuid "0d00646e-dd97-589c-8e21-634590dfdfc6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186531395}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6ddfe515-d085-541a-8dab-b3a5ab40f555" :question/math-academy-id "q-353601" :question/problem "![](images/ec/ec0b88ec00ef7e7061af0b08761eb73f05a5f669208babacbd4eb86736019230.png)\n\nFind the arc length $L$ of the polar curve $r=6{e}^{3\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{3}$ (shown in blue in the diagram above). Do not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=6{e}^{3\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=18{e}^{3\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{{(6{e}^{3\\theta })}^{2}+{(18{e}^{3\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{36{e}^{6\\theta }+324{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{360{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & =6\\sqrt{10}{\\int }_{0}^{\\pi /3}{e}^{3\\theta }\\,\\text{d}\\theta  \\\\  & =6\\sqrt{10}{[\\frac{1}{3}{e}^{3\\theta }]}_{0}^{\\pi /3} \\\\  & =2\\sqrt{10}{[{e}^{3\\theta }]}_{0}^{\\pi /3} \\\\  & =2\\sqrt{10}({e}^{\\pi }-{e}^{0}) \\\\  & =2\\sqrt{10}({e}^{\\pi }-1).\\end{aligned}\n$$"} :step/id #uuid "ad84a19f-114d-5fb3-b813-cbaf4567a4df"} {:db/id #edb/ref 17592186531719 :step/content {:db/id #edb/ref 17592186531644 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce61a52-02f8-52e3-833d-f0a747be827a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡2}{\\sqrt{1+\\operatorname{ln}⁡2}}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186530920} {:answer/id #uuid "25efba17-6780-5d23-af19-6462827fe365" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{1+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186530950} {:answer/id #uuid "44549959-713e-5a87-987f-4262b4d5d3c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡2}{\\sqrt{2}}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186531009} {:answer/id #uuid "ca7da443-446d-582f-b934-dcaf57f4a7d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186531287} {:answer/id #uuid "d25fbccb-dafe-5557-83e3-f260cee1b53a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186531298}] :answer-field/correct {:db/id #edb/ref 17592186530950} :answer-field/id #uuid "2a4caf7b-52fc-5e88-b891-82cc9a3a2cf7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531417}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "da080066-6980-5e46-a310-b96dc7f7120c" :question/math-academy-id "q-9540" :question/problem "![](images/c1/c1bf9d989f1fbaeda90325b924f2c9285cd4e37e1948ba63256258b0a84c7e44.png)\n\nFind the arc length of the polar curve $r={2}^{\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{2}$ (shown in blue in the diagram above)." :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={2}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }={2}^{\\theta }\\operatorname{ln}⁡2.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{({2}^{\\theta })}^{2}+{({2}^{\\theta }\\operatorname{ln}⁡2)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{2}^{2\\theta }+{2}^{2\\theta }{ln}^{2}⁡2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(1+{ln}^{2}⁡2){2}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡2}{\\int }_{0}^{\\pi /2}{2}^{\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡2}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\cdot {2}^{\\theta }{|}_{0}^{\\pi /2} \\\\  & =\\sqrt{1+{ln}^{2}⁡2}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\cdot ({2}^{\\pi /2}-{2}^{0}) \\\\  & =\\frac{\\sqrt{1+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1).\\end{aligned}\n$$"} :step/id #uuid "d656c95b-f90d-539c-9dbd-3c2a66651730" :step/next {:db/id #edb/ref 17592186531696}} {:db/id #edb/ref 17592186531723 :step/content {:db/id #edb/ref 17592186531626 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a09810-6e1e-5a7f-a496-a308672d8fe3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186530902} {:answer/id #uuid "70d61664-e8b3-5d91-831f-2ef5a133d2af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2-\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531115} {:answer/id #uuid "75c79860-2158-5faa-be6a-5b9aa2eb7054" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1-\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531123} {:answer/id #uuid "931cc387-4c8e-5435-8982-a4705188d119" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531181} {:answer/id #uuid "ad39fb78-7dc8-5c7f-b6cd-c9732f59d8ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531238}] :answer-field/correct {:db/id #edb/ref 17592186531238} :answer-field/id #uuid "452ad711-f8a6-5c7b-b980-01feac5bbbde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531443}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a1c1460f-c5a2-5e99-b7f7-17db73e707c6" :question/math-academy-id "q-103828" :question/problem "Which of the following gives the arc length of the polar curve $r=1-\\operatorname{sin}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{4}?$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1-\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-\\operatorname{cos}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(1-\\operatorname{sin}⁡\\theta )^{2}+(-\\operatorname{cos}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(1-2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta )+{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1-2\\operatorname{sin}⁡\\theta +1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{2-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"} :step/id #uuid "e4403343-b5c6-5fde-abd9-266da3d46e06" :step/next {:db/id #edb/ref 17592186531669}}] :activity/title "The Arc Length of a Polar Curve" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186530853}]}
