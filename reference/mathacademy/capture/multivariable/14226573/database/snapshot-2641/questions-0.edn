#{[{:db/id #edb/ref 17592186548021 :knowledge-point/_questions [{:db/id #edb/ref 17592186092373 :knowledge-point/id #uuid "cd0b4da9-1a0f-5a46-aff1-3ce5c0cebb3b" :knowledge-point/title "Creating an Integral Expression For the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19a8a941-abee-5eec-a85d-2c36090c0c9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}+2{e}^{\\theta }(\\theta +1)+{e}^{2\\theta }}\\,\\text{d}\\theta " :db/id #edb/ref 17592186547369} {:answer/id #uuid "829b49d5-b322-53c3-b0f4-1c6304fa46ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}-2{e}^{\\theta }-2{e}^{2\\theta }}\\,\\text{d}\\theta " :db/id #edb/ref 17592186547594} {:answer/id #uuid "c107c606-2649-543d-89fe-4a7928489ec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}-2{e}^{\\theta }(1-\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186547735} {:answer/id #uuid "c4d84b89-ed7c-5866-bbe7-886aa45f00d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}+2{e}^{\\theta }(\\theta +1)+2{e}^{2\\theta }+1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186547741} {:answer/id #uuid "fceb4866-634d-53f1-b923-46c9e70b07f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}+2\\theta {e}^{\\theta }+2{e}^{2\\theta }}\\,\\text{d}\\theta " :db/id #edb/ref 17592186547834}] :answer-field/correct {:answer/id #uuid "c4d84b89-ed7c-5866-bbe7-886aa45f00d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}+2{e}^{\\theta }(\\theta +1)+2{e}^{2\\theta }+1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186547741} :answer-field/id #uuid "17a97da4-f06a-512c-b0f2-d273f0e4876b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547850}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8023cebc-048b-5288-9c32-1da095db126f" :question/math-academy-id "q-103827" :question/problem "Which of the following gives the arc length of the polar curve $r=\\theta +{e}^{\\theta }$ for $-\\pi \\le \\theta \\le \\pi ?$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\theta +{e}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=1+{e}^{\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi }^{\\pi }\\sqrt{(\\theta +{e}^{\\theta })^{2}+(1+{e}^{\\theta })^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}+2\\theta {e}^{\\theta }+{e}^{2\\theta }+1+2{e}^{\\theta }+{e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi }^{\\pi }\\sqrt{{\\theta }^{2}+2{e}^{\\theta }(\\theta +1)+2{e}^{2\\theta }+1}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186547038 :knowledge-point/_questions [{:db/id #edb/ref 17592186068920 :knowledge-point/id #uuid "d2a41ede-381e-55f6-99e5-1baf1ea348a1" :knowledge-point/title "Computing the Integral of a Trigonometric Expression Using Integration by Parts Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "207ce1bb-8bde-56c6-bc5c-bd9959f561ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-{x}^{2}-3x+2)\\operatorname{cos}⁡(x)-(3x+2)\\operatorname{sin}⁡(x)+C" :db/id #edb/ref 17592186546321} {:answer/id #uuid "3d5bf71e-d1f7-5404-b06d-cdd7ddc9172e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}+3x-2)\\operatorname{cos}⁡(x)-(3x+2)\\operatorname{sin}⁡(x)+C" :db/id #edb/ref 17592186546386} {:answer/id #uuid "6c1d844c-2030-5617-b47c-4ad4758ca496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-{x}^{2}-2x+3)\\operatorname{cos}⁡(x)+(x+3)\\operatorname{sin}⁡(x)+C" :db/id #edb/ref 17592186546491} {:answer/id #uuid "e9b070a4-b26f-53c6-a6cb-ac154bdd8423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-{x}^{2}-3x+2)\\operatorname{cos}⁡(x)+(2x+3)\\operatorname{sin}⁡(x)+C" :db/id #edb/ref 17592186546776} {:answer/id #uuid "fd13586a-50c7-5494-a9e4-d9a877da7ffd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}+3x-2)\\operatorname{cos}⁡(x)+(2x+3)\\operatorname{sin}⁡(x)+C" :db/id #edb/ref 17592186546819}] :answer-field/correct {:answer/id #uuid "e9b070a4-b26f-53c6-a6cb-ac154bdd8423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-{x}^{2}-3x+2)\\operatorname{cos}⁡(x)+(2x+3)\\operatorname{sin}⁡(x)+C" :db/id #edb/ref 17592186546776} :answer-field/id #uuid "113fdcf6-88f3-5444-8636-104a1da82ce5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546836}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a2a087e4-737f-55e1-b912-34c295e29547" :question/math-academy-id "q-12701" :question/problem "Calculate the integral $\\int ({x}^{2}+3x)\\operatorname{sin}⁡x\\,\\text{d}x.$" :question/worked-solution "We need to use integration by parts. \n\nIn this case, we define\n\n$$\n\\begin{aligned}u={x}^{2}+3x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=2x+3 \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{sin}⁡(x)\\,\\text{d}x=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int ({x}^{2}+3x)\\operatorname{sin}⁡(x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({x}^{2}+3x)(-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))(2x+3)\\,\\text{d}x \\\\  & =-({x}^{2}+3x)\\operatorname{cos}⁡(x)+2\\int x\\operatorname{cos}⁡(x)\\text{d}x+3\\int \\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-({x}^{2}+3x)\\operatorname{cos}⁡(x)+2\\int x\\operatorname{cos}⁡(x)\\text{d}x+3\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{cos}⁡(x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1 \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\text{d}x=\\int \\operatorname{cos}⁡(x)\\,\\text{d}x=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{cos}⁡(x)\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(x)(\\operatorname{sin}⁡(x))-\\int (\\operatorname{sin}⁡(x))(1)\\,\\text{d}x \\\\  & =x\\operatorname{sin}⁡(x)-\\int \\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =x\\operatorname{sin}⁡(x)+\\operatorname{cos}⁡(x)+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int ({x}^{2}+3x)\\operatorname{sin}⁡(x)\\,\\text{d}x & =-({x}^{2}+3x)\\operatorname{cos}⁡(x)+2(x\\operatorname{sin}⁡(x)+\\operatorname{cos}⁡(x)+D)+3\\operatorname{sin}⁡(x) \\\\  & =-({x}^{2}+3x)\\operatorname{cos}⁡(x)+2x\\operatorname{sin}⁡(x)+2\\operatorname{cos}⁡(x)+C+3\\operatorname{sin}⁡(x) \\\\  & =(-{x}^{2}-3x+2)\\operatorname{cos}⁡(x)+(2x+3)\\operatorname{sin}⁡(x)+C,\\end{aligned}\n$$\n\nwhere $C=2D.$"}] [{:db/id #edb/ref 17592186548044 :knowledge-point/_questions [{:db/id #edb/ref 17592186083325 :knowledge-point/id #uuid "f06fdfdc-bba9-5bc6-8e32-722ec21da7d6" :knowledge-point/title "Finding an Unknown Population Parameter Using a Percentage Points Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3208f809-5202-519c-a4c1-b2c071b30e1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.78$ grams" :db/id #edb/ref 17592186547420} {:answer/id #uuid "3633d1c4-a4bd-5d6c-9a1e-fe155268f04d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.82$ grams" :db/id #edb/ref 17592186547428} {:answer/id #uuid "70486f57-d8c6-5d88-9e76-73287f23fb7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.75$ grams" :db/id #edb/ref 17592186547567} {:answer/id #uuid "b360a2fc-6825-56f7-a4ae-202963cd606a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.8$ grams" :db/id #edb/ref 17592186547706} {:answer/id #uuid "bf33ba30-f07a-5c5e-8673-051f5a7fed51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.85$ grams" :db/id #edb/ref 17592186547724}] :answer-field/correct {:answer/id #uuid "3208f809-5202-519c-a4c1-b2c071b30e1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0.78$ grams" :db/id #edb/ref 17592186547420} :answer-field/id #uuid "c889ce98-c36c-5100-9ccc-2833887780d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547943}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b642f61b-90d3-52e8-a698-ed0e6fdd52ac" :question/math-academy-id "q-132849" :question/problem "In a factory, the average amount of sugar in a cookie is $15$ grams. However, $10%$ of cookies contain no more than $14$ grams of sugar. Assuming that the amount of sugar in each cookie is normally distributed, find the standard deviation of the amount of sugar in a cookie, rounded to $2$ decimal places.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.01\\,$ | $\\,0.03\\,$ | $\\,0.05\\,$ | $\\,0.10\\,$ | $\\,0.15\\,$ | $\\,0.20\\,$ | $\\,0.25\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,-2.3263\\,$ | $\\,-1.8808\\,$ | $\\,-1.6449\\,$ | $\\,-1.2816\\,$ | $\\,-1.0364\\,$ | $\\,-0.8416\\,$ | $\\,-0.6745\\,$ |" :question/worked-solution "Let $X$ represent the amount (in grams) of sugar in a cookie. Then we have $X∼N(15,{\\sigma }^{2}),$ and we want to find the standard deviation $\\sigma .$ \n\nWe know that $P(X\\le 14)=0.10.$ Converting $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X\\le 14) & =0.10 \\\\ P(Z\\le \\frac{14-15}{\\sigma }) & =0.10 \\\\ Φ(-\\frac{1}{\\sigma }) & =0.10 \\\\ -\\frac{1}{\\sigma } & ={Φ}^{-1}(0.10).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.10)=-1.2816.\n$$\n\nFinally then, \n\n$$\n\\begin{aligned}-\\frac{1}{\\sigma } & =-1.2816 \\\\ \\frac{1}{\\sigma } & =1.2816 \\\\ \\sigma  & =\\frac{1}{1.2816} \\\\  & ≈0.78.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317515 :knowledge-point/_questions [{:db/id #edb/ref 17592186101023 :knowledge-point/id #uuid "41bedcde-cbc1-5634-8846-eb58ffda32e2" :knowledge-point/title "Finding an Interval Given the Average Value of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c20d1097-852b-5f82-8d60-8924f36cf4a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316208}] :answer-field/correct {:answer/id #uuid "c20d1097-852b-5f82-8d60-8924f36cf4a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316208} :answer-field/id #uuid "357cc33c-157b-5cf7-bef4-4852d1fed751" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316672}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9972073a-20c3-5456-964a-3f9b441520bb" :question/math-academy-id "q-344601" :question/problem "The **exact** value of $c$ such that the average value of $f(x)=-15\\sqrt{x}+6$ on the interval $[0,c]$ is equal to $-4$ is\n\n$c=$\n{{field-1}}." :question/worked-solution "To solve for $c,$ we apply the average value formula:\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ -4 & =\\frac{1}{c-0}{\\int }_{0}^{c}(-15\\sqrt{x}+6)\\,\\text{d}x \\\\ -4 & ={\\frac{1}{c}(-10{x}^{3/2}+6x)|}_{0}^{c} \\\\ -4 & =\\frac{1}{c}[(-10{c}^{3/2}+6c)-0] \\\\ -4 & =-10\\sqrt{c}+6 \\\\ -10 & =-10\\sqrt{c} \\\\ 1 & =\\sqrt{c} \\\\ c & =1\\end{aligned}\n$$\n\nTherefore, the value of $c$ is \n\n$$\nc=1.\n$$"}] [{:db/id #edb/ref 17592186548079 :knowledge-point/_questions [{:db/id #edb/ref 17592186175957 :knowledge-point/id #uuid "7293561d-2ddf-581d-b086-9754fdb2ff16" :knowledge-point/title "Identifying the Point of Fastest Increase of a Logistic Growth Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e33b7888-14e2-559e-bca1-077f0916190c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2500" :db/id #edb/ref 17592186547790}] :answer-field/correct {:answer/id #uuid "e33b7888-14e2-559e-bca1-077f0916190c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2500" :db/id #edb/ref 17592186547790} :answer-field/id #uuid "dbb704d4-511c-5244-871d-d498a47768aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186547957}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fbdb7241-60ea-5f22-afcd-5e46de779c9a" :question/math-academy-id "q-353482" :question/problem "The subscriber count $P(t)$ of a streaming service follows the logistic growth model\n\n$$\n\\frac{dP}{dt}=2P(5\\,000-P),\\,P(0)=300.\n$$\n\nwhere $t$ is the time, measured in years. For which value of $P$ is the subscriber count growing at the fastest possible rate?\n\n$P=$\n{{field-1}}" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{P}^{′}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nFor a logistic growth model, the fastest rate of growth occurs when $P=\\frac{1}{2}a.$\n\n![](images/90/9019b26b417c757bbfab79afb39379c1fc7a892bc44e934c6f23c339deacfd68.png)\n\nFrom our equation, we see that $a=5000.$ Hence, the carrying capacity is $5000,$ and $P$ grows at its fastest possible rate when \n\n$$\nP=\\frac{1}{2}a=\\frac{1}{2}\\cdot 5000=2500.\n$$"}]}
