      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q117209-c2254179eb46967d8482.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q117209-c2254179eb46967d8482.png",
      "source_url": "https://mathacademy.com/tasks/14195525/topics/1213/lesson",
      "captured_at": 1791949397.7035623,
      "math_academy_id": "q-117209",
      "topic_id": "1213",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q117209",
        "placement_id": null,
        "content_id": null,
