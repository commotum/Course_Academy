      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q86451-13d2bf7d74df44c56c5e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q86451-13d2bf7d74df44c56c5e.png",
      "source_url": "https://mathacademy.com/tasks/14195525/topics/1213/lesson",
      "captured_at": 1791949646.2729902,
      "math_academy_id": "q-86451",
      "topic_id": "1213",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q86451",
        "placement_id": null,
