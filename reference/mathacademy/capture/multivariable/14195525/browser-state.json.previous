      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q315628-83b719cd8f44507fd668.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q315628-83b719cd8f44507fd668.png",
      "source_url": "https://mathacademy.com/tasks/14195525/topics/1213/lesson",
      "captured_at": 1791949507.5891194,
      "math_academy_id": "q-315628",
      "topic_id": "1213",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q315628",
        "placement_id": null,
