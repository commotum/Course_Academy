      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q346760-49c6a6db953aa9cbf811.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q346760-49c6a6db953aa9cbf811.png",
      "source_url": "https://mathacademy.com/tasks/14195525/topics/1213/lesson",
      "captured_at": 1791949476.3114622,
      "math_academy_id": "q-346760",
      "topic_id": "1213",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q346760",
        "placement_id": null,
        "content_id": null,
