      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q86444-4da8c66d2e796feb0bf6.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q86444-4da8c66d2e796feb0bf6.png",
      "source_url": "https://mathacademy.com/tasks/14195525/topics/1213/lesson",
      "captured_at": 1791949274.6406674,
      "math_academy_id": "q-86444",
      "topic_id": "1213",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q86444",
        "placement_id": null,
        "content_id": null,
