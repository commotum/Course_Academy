      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q117300-8fbb964a58573f63ff6f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q117300-8fbb964a58573f63ff6f.png",
      "source_url": "https://mathacademy.com/tasks/14195525/topics/1213/lesson",
      "captured_at": 1791949729.823395,
      "math_academy_id": "q-117300",
      "topic_id": "1213",
      "sequence_position": null,
      "source_step": {
