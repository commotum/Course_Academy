      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q18398-93b1a6d749eba1e3f9c4.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q18398-93b1a6d749eba1e3f9c4.png",
      "source_url": "https://mathacademy.com/tasks/14195525/topics/1213/lesson",
      "captured_at": 1791949705.3530042,
      "math_academy_id": "q-18398",
      "topic_id": "1213",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q18398",
        "placement_id": null,
