      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q347239-7a69da3225d12338a82b.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q347239-7a69da3225d12338a82b.png",
      "source_url": "https://mathacademy.com/tasks/14195525/topics/1213/lesson",
      "captured_at": 1791949676.7341197,
      "math_academy_id": "q-347239",
      "topic_id": "1213",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q347239",
        "placement_id": null,
