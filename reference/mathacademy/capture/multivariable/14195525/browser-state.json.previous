      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q347235-6d8e6525b48991e010eb.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195525/observations/step-q347235-6d8e6525b48991e010eb.png",
      "source_url": "https://mathacademy.com/tasks/14195525/topics/1213/lesson",
      "captured_at": 1791949583.52233,
      "math_academy_id": "q-347235",
      "topic_id": "1213",
      "sequence_position": null,
      "source_step": {
