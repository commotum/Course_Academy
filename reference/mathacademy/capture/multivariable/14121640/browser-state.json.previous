      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121640/observations/step-q163210-2a0699bd81e1f02bb6e3.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121640/observations/step-q163210-2a0699bd81e1f02bb6e3.png",
