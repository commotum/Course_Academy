498 #edb/ref 17592186045417] [17592186194546 #edb/ref 1083 #uuid "342526d3-fc92-5eb0-9b17-c088df1aefe6" #edb/ref 17592186045417] [17592186194547 #edb/ref 1080 "\\frac{1}{8}" #edb/ref 17592186045417] [17592186194547 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186194547 #edb/ref 1083 #uuid "4fca86e9-6fb0-5705-b29f-f8af6228793c" #edb/ref 17592186045417] [17592186194548 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186194548 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186194548 #edb/ref 1083 #uuid "591a4e65-cc97-596a-9556-224c589303c9" #edb/ref 17592186045417] [17592186197708 #edb/ref 1075 #edb/ref 17592186197709 #edb/ref 17592186045417] [17592186197708 #edb/ref 1075 #edb/ref 17592186197710 #edb/ref 17592186045417] [17592186197708 #edb/ref 1075 #edb/ref 17592186197711 #edb/ref 17592186045417] [17592186197708 #edb/ref 1075 #edb/ref 17592186197712 #edb/ref 17592186045417] [17592186197708 #edb/ref 1075 #edb/ref 17592186197713 #edb/ref 17592186045417] [17592186197708 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186197708 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186197708 #edb/ref 1079 #uuid "cda48d4b-6932-57c7-959c-1d532024e187" #edb/ref 17592186045417] [17592186197709 #edb/ref 1080 "\\frac{15}{2}" #edb/ref 17592186045417] [17592186197709 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186197709 #edb/ref 1083 #uuid "9390295c-2047-55db-93f2-b19050e20819" #edb/ref 17592186045417] [17592186197710 #edb/ref 1080 "7" #edb/ref 17592186045417] [17592186197710 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186197710 #edb/ref 1083 #uuid "b3514fe4-5f80-5a9c-bbdb-8de58bceec43" #edb/ref 17592186045417] [17592186197711 #edb/ref 1080 "9" #edb/ref 17592186045417] [17592186197711 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186197711 #edb/ref 1083 #uuid "bb7fe96a-bf45-5c14-aaa0-a2d45935fcca" #edb/ref 17592186045417] [17592186197712 #edb/ref 1080 "\\frac{16}{3}" #edb/ref 17592186045417] [17592186197712 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186197712 #edb/ref 1083 #uuid "c745270c-8cff-50c9-b613-62dab171bf06" #edb/ref 17592186045417] [17592186197713 #edb/ref 1080 "\\frac{9}{2}" #edb/ref 17592186045417] [17592186197713 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186197713 #edb/ref 1083 #uuid "07a1a73a-6524-5480-bf7d-4a337f3b8641" #edb/ref 17592186045417] [17592186198048 #edb/ref 1069 "e-12466" #edb/ref 17592186045417] [17592186198048 #edb/ref 1071 "The lamina $D = \\big\\{ (x,y) \\: : \\: 0 \\le x \\le y  ,\\, 0 \\le y \\le 1 \\big\\}$ has the mass density function $\\lambda(x,y) = x^2y.$ Find the moment of the lamina about the $y$-axis." #edb/ref 17592186045417] [17592186198048 #edb/ref 1072 #uuid "81b0b6e1-41c3-5329-806e-162b8b27b045" #edb/ref 17592186045417] [17592186198048 #edb/ref 1074 "The moment of a lamina $D$ with the mass density function $\\lambda(x,y)$ about the $y$-axis is given by\n\n$$\nM_y = \\iint\\limits_D x \\, \\lambda(x,y) \\: \\textrm{d}A.\n$$\n\nIn our case, $D$ is represented as a type II plane region and $\\lambda(x,y) = x^2y .$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{y} & ={∬}_{D}x\\cdot {x}^{2}y\\,\\text{d}A \\\\  & ={∬}_{D}{x}^{3}y\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{y}{x}^{3}y\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y[{\\int }_{0}^{y}{x}^{3}\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot {[\\frac{{x}^{4}}{4}]}_{x=0}^{x=y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot \\frac{{y}^{4}}{4}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{{y}^{5}}{4}\\,\\text{d}y \\\\  & ={[\\frac{{y}^{6}}{24}]}_{y=0}^{y=1} \\\\  & =\\frac{1}{24}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198049 #edb/ref 1069 "e-12470" #edb/ref 17592186045417] [17592186198049 #edb/ref 1071 "A thin plate ![](images/3c/3cfabe3c702883ca24c3188908c4cefeee43adb30797308828edd98374b5b44f.png) with the mass density function ![](images/ac/ac38ea36432f3e278a4c2deb9203fbd5e486e348976e79157a5c6885a576f656.png) is enclosed between the curve ![](images/65/65b9fa371f35bfa31a21b50bc02f64561e4c838d71ebd99bf2d2d1c1be196dff.png) and the ![](images/1f/1fd42a46221d9624ec3d81db0f5c73cd8428ee2f8d80b5d7e4ff67e7018fb194.png)-axis  for ![](images/11/11d74a99b97245c1998471b33f9b9d0974e251345f825c475db4079c02fa273a.png) Find the moment of the plate about the ![](images/b6/b63bded3ee2ad150f576fd05c209caf32bd34853f4a7132fe4ee85b59b06f61a.png)-axis." #edb/ref 17592186045417] [17592186198049 #edb/ref 1072 #uuid "9294903c-1b4c-58b6-a878-7f2220ec763d" #edb/ref 17592186045417] [17592186198049 #edb/ref 1074 "The moment of a lamina ![](images/05/05ff793b0aee1f05a79216f9e7f119afa544749c81077937f8f06a353f6ef4eb.png) with the mass density function ![](images/bb/bb3bf01e45585dbd5fe7732a1befa050d734bc46a466fea7f61f42851cfd3af8.png) about the ![](images/d7/d7d15efdd7573bd5b95e49ef05727ed1b8163a06781c393c1d3f27109fdc4eda.png)-axis is given by\n\n![](images/73/73a6e88adb05252ff114153227c13ae4f4adad9b676524179a20d9ae3d045d43.png)\n\nIn our case, ![](images/33/33d4430552670d83a2c303e8ab286d3391f5611450f4e4f0b6ad6ccb58049b0e.png) is a type I plane region, as shown below.\n\n![](images/06/067543543031a1d8cb4ceb9a7901ad7db77629243adc6658d4a9eab3e98fe09f.png)\n\nSo, we have \n\n![](images/03/03ccfab8b682725e94126f9fe59597d6e2886d3aeff64746681d0bbbed072520.png)\n\nand ![](images/17/17c342255c9bffbade441c02123bab3f7154e97b1a6a69a2874935f2dd684806.png) \n\nTherefore, the moment is\n\n![](images/ca/ca38251cdd0a97967e8e6f4200e94b00571c5cfe2b84fef1991022e4fb976e62.png)" #edb/ref 17592186045417] [17592186198238 #edb/ref 1069 "e-8182" #edb/ref 17592186045417] [17592186198238 #edb/ref 1071 "Consider a thin plate $D$ that has the mass density function $\\lambda (x,y) = x+y$ and is enclosed between the curve $y=x$ and the $x$-axis for $0 \\leq x \\leq 1.$ Given that the mass of the plate is $\\dfrac{1}{2}$ units and its center of mass is located at $( \\overline{x}, \\overline{y} ),$ what is the value of $\\overline{y}?$" #edb/ref 17592186045417] [17592186198238 #edb/ref 1072 #uuid "8199670b-efe4-537b-8f8a-228d567a0944" #edb/ref 17592186045417] [17592186198238 #edb/ref 1074 "The center of mass of a lamina $D$ with the mass density function $\\lambda(x,y)$ is given by \n\n$$\n(\\overline{x},\\overline{y}) = \\left( \\dfrac{M_y}{m}, \\dfrac{M_x}{m} \\right),\n$$\n\nwhere \n\n- $\\displaystyle m = \\iint \\limits_D \\lambda (x,y) \\: \\textrm{d}A$ is the mass of the lamina,\n\n- $\\displaystyle M_x = \\iint\\limits_D y \\, \\lambda (x,y) \\: \\textrm{d}A$ is the moment of the lamina about the $x$-axis, and\n\n- $\\displaystyle M_y = \\iint\\limits_D x \\, \\lambda (x,y) \\: \\textrm{d}A$ is the moment of the lamina about the $y$-axis.\n\nNotice that $D$ is a type I plane region:\n\n![](images/b8/b872242423692a20a9d50658c99d9e8cee7c9b2737fb96592bc2bc35b4f72c32.png)\n\nSo, we have \n\n$$\nD = \\big\\{ (x,y) \\: : \\:0 \\le x \\le 1, \\: 0 \\le y \\le x \\big\\}\n$$\n\nand $\\lambda(x,y) = x+y.$ \n\nSince we require the $y$-coordinate of the center of mass, we need to compute the moment about the $x$-axis: \n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A \\\\  & ={∬}_{D}y\\cdot (x+y)\\,\\text{d}A \\\\  & ={∬}_{D}xy+{y}^{2}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{x}xy+{y}^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{[\\frac{x{y}^{2}}{2}+\\frac{{y}^{3}}{3}]}_{y=0}^{y=x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(\\frac{{x}^{3}}{2}+\\frac{{x}^{3}}{3})\\,\\text{d}x \\\\  & =\\frac{5}{6}{\\int }_{0}^{1}{x}^{3}\\,\\text{d}x \\\\  & =\\frac{5}{6}{[\\frac{1}{4}{x}^{4}]}_{x=0}^{x=1} \\\\  & =\\frac{5}{6}(\\frac{1}{4}-0) \\\\  & =\\frac{5}{24}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\overline{y} = \\dfrac{M_x}{m} = \\dfrac{\\left(\\dfrac{5}{24}\\right)}{\\left(\\dfrac{1}{2}\\right)} = \\dfrac{5}{12}.\n$$" #edb/ref 17592186045417] [17592186198239 #edb/ref 1069 "e-8183" #edb/ref 17592186045417] [17592186198239 #edb/ref 1071 "Consider the thin plate $D$ enclosed between the curve $x=\\sqrt{1-y^2}$ and the $y$-axis for $-1 \\leq y \\leq 1.$ Find the $x$-coordinate of its centroid." #edb/ref 17592186045417] [17592186198239 #edb/ref 1072 #uuid "37d7f2ae-90b0-5e6f-83c2-7cb21ed4f089" #edb/ref 17592186045417] [17592186198239 #edb/ref 1074 "The centroid of a lamina $D$ with area $A_D$ is given by $(x_c, y_c),$ where\n\n$$\n\\displaystyle x_c = \\dfrac{1}{A_D} \\iint\\limits_D x \\, \\: \\textrm{d}A, \\qquad \n\\displaystyle y_c = \\dfrac{1}{A_D} \\iint\\limits_D y \\, \\: \\textrm{d}A.\n$$\n\nNotice that $D$ is a type II plane region:\n\n![](images/a7/a7992c54f85f85cab3d9f923b8daca62c410393b364d30bcfbf5cff5efc93bbd.png)\n\nSo, we have \n\n$$\nD = \\big\\{ (x,y) \\: : \\: 0 \\le x \\le \\sqrt{1-y^2}, \\: -1 \\le y \\le 1 \\big\\}\n$$\n\nand \n\n$$\nA_D = \\dfrac12 \\cdot \\pi\\cdot 1^2 = \\dfrac{\\pi}{2}.\n$$\n\nTherefore, the $x$-coordinate of the centroid is \n\n$$\n\\begin{aligned}{x}_{c} & =\\frac{1}{{A}_{D}}{∬}_{D}x\\,\\text{d}A \\\\  & =\\frac{2}{\\pi }{\\int }_{-1}^{1}{\\int }_{0}^{\\sqrt{1-{y}^{2}}}x\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{2}{\\pi }{\\int }_{-1}^{1}{[\\frac{{x}^{2}}{2}]}_{x=0}^{x=\\sqrt{1-{y}^{2}}}\\,\\text{d}y \\\\  & =\\frac{2}{\\pi }{\\int }_{-1}^{1}\\frac{1-{y}^{2}}{2}\\,\\text{d}y \\\\  & =\\frac{1}{\\pi }{\\int }_{-1}^{1}1-{y}^{2}\\,\\text{d}y \\\\  & =\\frac{1}{\\pi }{[y-\\frac{{y}^{3}}{3}]}_{-1}^{1} \\\\  & =\\frac{1}{\\pi }[(1-\\frac{1}{3})-(-1+\\frac{1}{3})] \\\\  & =\\frac{1}{\\pi }\\cdot \\frac{4}{3} \\\\  & =\\frac{4}{3\\pi }.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198364 #edb/ref 1038 #edb/ref 17592186198962 #edb/ref 17592186045417] [17592186198364 #edb/ref 1038 #edb/ref 17592186198975 #edb/ref 17592186045417] [17592186198364 #edb/ref 1038 #edb/ref 17592186235552 #edb/ref 17592186045417] [17592186198364 #edb/ref 1038 #edb/ref 17592186281619 #edb/ref 17592186045417] [17592186198364 #edb/ref 1038 #edb/ref 17592186281620 #edb/ref 17592186045417] [17592186198364 #edb/ref 1038 #edb/ref 17592186281664 #edb/ref 17592186045417] [17592186198364 #edb/ref 1038 #edb/ref 17592186281665 #edb/ref 17592186045417] [17592186198364 #edb/ref 1038 #edb/ref 17592186281666 #edb/ref 17592186045417] [17592186198364 #edb/ref 1039 "Find the Center of Mass of a Plane Lamina" #edb/ref 17592186045417] [17592186198364 #edb/ref 1041 #edb/ref 17592186198238 #edb/ref 17592186045417] [17592186198364 #edb/ref 1042 #uuid "3f7a06a8-0260-5b59-b3a5-c02ee03980d4" #edb/ref 17592186045417] [17592186198365 #edb/ref 1038 #edb/ref 17592186198966 #edb/ref 17592186045417] [17592186198365 #edb/ref 1038 #edb/ref 17592186198974 #edb/ref 17592186045417] [17592186198365 #edb/ref 1038 #edb/ref 17592186281667 #edb/ref 17592186045417] [17592186198365 #edb/ref 1038 #edb/ref 17592186281668 #edb/ref 17592186045417] [17592186198365 #edb/ref 1038 #edb/ref 17592186281672 #edb/ref 17592186045417] [17592186198365 #edb/ref 1038 #edb/ref 17592186281673 #edb/ref 17592186045417] [17592186198365 #edb/ref 1039 "Find the Centroid of a Plane Lamina" #edb/ref 17592186045417] [17592186198365 #edb/ref 1041 #edb/ref 17592186198239 #edb/ref 17592186045417] [17592186198365 #edb/ref 1042 #uuid "255c9985-5d85-5fd5-a2b9-c4752f04afac" #edb/ref 17592186045417] [17592186198406 #edb/ref 1038 #edb/ref 17592186198654 #edb/ref 17592186045417] [17592186198406 #edb/ref 1038 #edb/ref 17592186198973 #edb/ref 17592186045417] [17592186198406 #edb/ref 1038 #edb/ref 17592186235551 #edb/ref 17592186045417] [17592186198406 #edb/ref 1038 #edb/ref 17592186281586 #edb/ref 17592186045417] [17592186198406 #edb/ref 1038 #edb/ref 17592186281587 #edb/ref 17592186045417] [17592186198406 #edb/ref 1038 #edb/ref 17592186281613 #edb/ref 17592186045417] [17592186198406 #edb/ref 1038 #edb/ref 17592186281615 #edb/ref 17592186045417] [17592186198406 #edb/ref 1038 #edb/ref 17592186281616 #edb/ref 17592186045417] [17592