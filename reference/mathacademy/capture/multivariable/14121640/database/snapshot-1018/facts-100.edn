186045417] [17592186419221 #edb/ref 1078 #edb/ref 17592186419195 #edb/ref 17592186045417] [17592186419221 #edb/ref 1079 #uuid "e1da24df-d2f5-5a09-b4d8-15e1940c4d8b" #edb/ref 17592186045417] [17592186419222 #edb/ref 1075 #edb/ref 17592186419124 #edb/ref 17592186045417] [17592186419222 #edb/ref 1075 #edb/ref 17592186419128 #edb/ref 17592186045417] [17592186419222 #edb/ref 1075 #edb/ref 17592186419140 #edb/ref 17592186045417] [17592186419222 #edb/ref 1075 #edb/ref 17592186419144 #edb/ref 17592186045417] [17592186419222 #edb/ref 1075 #edb/ref 17592186419157 #edb/ref 17592186045417] [17592186419222 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186419222 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186419222 #edb/ref 1078 #edb/ref 17592186419124 #edb/ref 17592186045417] [17592186419222 #edb/ref 1079 #uuid "e9b9b2b2-2793-52af-9037-ca02cdc38bd0" #edb/ref 17592186045417] [17592186419223 #edb/ref 1075 #edb/ref 17592186419183 #edb/ref 17592186045417] [17592186419223 #edb/ref 1075 #edb/ref 17592186419189 #edb/ref 17592186045417] [17592186419223 #edb/ref 1075 #edb/ref 17592186419196 #edb/ref 17592186045417] [17592186419223 #edb/ref 1075 #edb/ref 17592186419201 #edb/ref 17592186045417] [17592186419223 #edb/ref 1075 #edb/ref 17592186419203 #edb/ref 17592186045417] [17592186419223 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186419223 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186419223 #edb/ref 1078 #edb/ref 17592186419196 #edb/ref 17592186045417] [17592186419223 #edb/ref 1079 #uuid "f759501f-c45a-5f7a-bf9b-32c176d77fee" #edb/ref 17592186045417] [17592186419224 #edb/ref 1068 #edb/ref 17592186419217 #edb/ref 17592186045417] [17592186419224 #edb/ref 1069 "q-162973" #edb/ref 17592186045417] [17592186419224 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186419224 #edb/ref 1071 "The lamina $D={(x,y)\\,:\\,(x,y)\\,:\\,1\\le y\\le 2,\\,y\\le x\\le 2}$ has the mass density function $\\lambda (x,y)=\\frac{2}{{x}^{2}}.$ Find the moment of the lamina about the $x$-axis." #edb/ref 17592186045417] [17592186419224 #edb/ref 1072 #uuid "0804629b-6c24-5f03-92bb-4a1347fc49ee" #edb/ref 17592186045417] [17592186419224 #edb/ref 1074 "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $x$-axis is given by\n\n$$\n{M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type II plane region and $\\lambda (x,y)=\\frac{2}{{x}^{2}}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\cdot \\frac{2}{{x}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{2y}{{x}^{2}}\\,\\text{d}A \\\\  & ={\\int }_{1}^{2}{\\int }_{y}^{2}\\frac{2y}{{x}^{2}}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}2y[{\\int }_{y}^{2}\\frac{1}{{x}^{2}}\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}2y\\cdot {[-\\frac{1}{x}]}_{x=y}^{x=2}\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}2y\\cdot [-\\frac{1}{2}+\\frac{1}{y}]\\text{ }\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}2-y\\,\\text{d}y \\\\  & ={[2y-\\frac{{y}^{2}}{2}]}_{y=1}^{y=2} \\\\  & =(4-2)-(2-\\frac{1}{2}) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186419225 #edb/ref 1068 #edb/ref 17592186419222 #edb/ref 17592186045417] [17592186419225 #edb/ref 1069 "q-163212" #edb/ref 17592186045417] [17592186419225 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186419225 #edb/ref 1071 "Consider a thin plate $D$ that has the mass density function $\\lambda (x,y)=\\frac{1}{x}$ and is enclosed between the curve $y=\\frac{4}{x}$ and the $x$-axis for $1\\le x\\le 2.$ Given that the mass of the plate is $2$ units and its center of mass is located at $(\\overset{―}{x},\\overset{―}{y}),$ what is the value of $\\overset{―}{y}?$" #edb/ref 17592186045417] [17592186419225 #edb/ref 1072 #uuid "0843dc47-16bf-5a44-aad9-6ea0121c3046" #edb/ref 17592186045417] [17592186419225 #edb/ref 1074 "The center of mass of a lamina $D$ with the mass density function $\\lambda (x,y)$ is given by \n\n$$\n(\\overset{―}{x},\\overset{―}{y})=(\\frac{{M}_{y}}{m},\\frac{{M}_{x}}{m}),\n$$\n\nwhere \n\n- $m={∬}_{D}\\lambda (x,y)\\,\\text{d}A$ is the mass of the lamina,\n\n- ${M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A\\,$ is the moment of the lamina about the $x$-axis, and\n\n- ${M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A$ is the moment of the lamina about the $y$-axis.\n\nNotice that $D$ is a type I plane region:\n\n![](images/e6/e6027dcb30cf0d638dc4472c40182ddf9bd85d52840d1268d00c4d3ecbc09abc.png)\n\nSo, we have \n\n$$\nD={(x,y)\\,:\\,1\\le x\\le 2,\\,0\\le y\\le \\frac{4}{x}}\n$$\n\nand $\\lambda (x,y)=\\frac{1}{x}.$ \n\nSince we require the $y$-coordinate of the center of mass, we need to compute the moment about the $x$-axis: \n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A \\\\  & ={∬}_{D}y\\cdot \\frac{1}{x}\\,\\text{d}A \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{4/x}y\\cdot \\frac{1}{x}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{x}[{\\int }_{0}^{4/x}y\\,\\text{d}y]\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{x}\\cdot {[\\frac{{y}^{2}}{2}]}_{y=0}^{y=4/x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{x}(\\frac{8}{{x}^{2}}-0)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{8}{{x}^{3}}\\,\\text{d}x \\\\  & ={[-\\frac{4}{{x}^{2}}]}_{x=1}^{x=2} \\\\  & =-1+4 \\\\  & =3\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\overset{―}{y}=\\frac{{M}_{x}}{m}=\\frac{3}{2}.\n$$" #edb/ref 17592186045417] [17592186419226 #edb/ref 1068 #edb/ref 17592186419216 #edb/ref 17592186045417] [17592186419226 #edb/ref 1069 "q-162985" #edb/ref 17592186045417] [17592186419226 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186419226 #edb/ref 1071 "A thin plate $D$ with the mass density function $\\lambda (x,y)=15xy$ is enclosed between the curve $x=\\sqrt{1-{y}^{2}}$ and the $y$-axis  for $0\\le y\\le 1.$ Find the moment of the plate about the $x$-axis." #edb/ref 17592186045417] [17592186419226 #edb/ref 1072 #uuid "11cc651a-be53-58b2-a4ee-ca7bbf5bb71b" #edb/ref 17592186045417] [17592186419226 #edb/ref 1074 "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $x$-axis is given by\n\n$$\n{M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is a type II plane region, as shown below.\n\n![](images/98/98a791c71bcad80b4e8427f1b2a311e1712fdbc8697d0475b2470c8e0281e8c5.png)\n\nSo, we have \n\n$$\nD={(x,y)\\,:\\,0\\le x\\le \\sqrt{1-{y}^{2}},\\,0\\le y\\le 1}\n$$\n\nand $\\lambda (x,y)=15xy.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\cdot 15xy\\,\\text{d}A \\\\  & ={∬}_{D}15x{y}^{2}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-{y}^{2}}}15x{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}15{y}^{2}[{\\int }_{0}^{\\sqrt{1-{y}^{2}}}x\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}15{y}^{2}\\cdot {[\\frac{{x}^{2}}{2}]}_{x=0}^{x=\\sqrt{1-{y}^{2}}}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{15{y}^{2}}{2}(1-{y}^{2})\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{15}{2}{y}^{2}-\\frac{15}{2}{y}^{4}]\\,\\text{d}y \\\\  & ={[\\frac{5}{2}{y}^{3}-\\frac{3}{2}{y}^{5}]}_{y=0}^{y=1} \\\\  & =\\frac{5}{2}-\\frac{3}{2} \\\\  & =1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186419227 #edb/ref 1068 #edb/ref 17592186419208 #edb/ref 17592186045417] [17592186419227 #edb/ref 1069 "q-163287" #edb/ref 17592186045417] [17592186419227 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186419227 #edb/ref 1071 "Consider the lamina that occupies the region $D={(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le {e}^{x}}.$ Given that the area of the lamina is $e-1$ square units, find the $y$-coordinate of its centroid." #edb/ref 17592186045417] [17592186419227 #edb/ref 1072 #uuid "3e1f668b-3939-5382-8535-1d312c4ff48a" #edb/ref 17592186045417] [17592186419227 #edb/ref 1074 "The centroid of a lamina $D$ with area ${A}_{D}$ is given by $({x}_{c},{y}_{c}),$ where\n\n$$\n{x}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}x\\,\\,\\text{d}A,\\,{y}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}y\\,\\,\\text{d}A.\n$$\n\nTherefore, the $y$-coordinate of the centroid is \n\n$$\n\\begin{aligned}{y}_{c} & =\\frac{1}{{A}_{D}}{∬}_{D}y\\,\\text{d}A \\\\  & =\\frac{1}{e-1}{\\int }_{0}^{1}{\\int }_{0}^{{e}^{x}}y\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{1}{e-1}{\\int }_{0}^{1}{[\\frac{{y}^{2}}{2}]}_{y=0}^{y={e}^{x}}\\,\\text{d}x \\\\  & =\\frac{1}{e-1}{\\int }_{0}^{1}\\frac{{e}^{2x}}{2}\\,\\text{d}x \\\\  & =\\frac{1}{e-1}{[\\frac{{e}^{2x}}{4}]}_{0}^{1} \\\\  & =\\frac{1}{e-1}\\cdot \\frac{{e}^{2}-1}{4} \\\\  & =\\frac{e+1}{4}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186419228 #edb/ref 1068 #edb/ref 17592186419211 #edb/ref 17592186045417] [17592186419228 #edb/ref 1069 "q-163157" #edb/ref 17592186045417] [17592186419228 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186419228 #edb/ref 1071 "A thin plate $D$ with the mass density function $\\lambda (x,y)=\\frac{1}{1+{y}^{2}}$ is enclosed between the line $y=\\operatorname{tan}⁡\\frac{\\pi x}{4}$ and the $x$-axis for $0\\le x\\le 1.$ Find the moment of the plate about the $y$-axis." #edb/ref 17592186045417] [17592186419228 #edb/ref 1072 #uuid "601852dd-a274-52fe-84a0-07108a3a4d6f" #edb/ref 17592186045417] [17592186419228 #edb/ref 1074 "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $y$-axis is given by\n\n$$\n{M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is a type I plane region, as shown below.\n\n![](images/47/4730100420adb07f9ac2d4e9e6a67a8a1c299ef552b25af1163909631d260495.png)\n\nSo, we have \n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le \\operatorname{tan}⁡\\frac{\\pi x}{4}}\n$$\n\nand $\\lambda (x,y)=\\frac{1}{1+{y}^{2}}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{y} & ={∬}_{D}x\\cdot \\frac{1}{1+{y}^{2}}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\operatorname{tan}⁡(\\pi x/4)}x\\cdot \\frac{1}{1+{y}^{2}}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x[{\\int }_{0}^{\\operatorname{tan}⁡(\\pi x/4)}\\frac{1}{1+{y}^{2}}\\,\\text{d}y]\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot [\\operatorname{arctan}⁡y]_{y=0}^{y=\\operatorname{tan}⁡(\\pi x/4)}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x(\\frac{\\pi x}{4}-0)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{\\pi {x}^{2}}{4}\\,\\text{d}x \\\\  & ={[\\frac{\\pi {x}^{3}}{12}]}_{x=0}^{x=1} \\\\  & =\\frac{\\pi }{12}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186419229 #edb/ref 1068 #edb/ref 17592186419210 #edb/ref 17592186045417] [17592186419229 #edb/ref 1069 "q-163285" #edb/ref 17592186045417] [17592186419229 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186419229 #edb/ref 1071 "Consider the thin plate $D$ enclosed between the curve $x=\\frac{1}{y}$ and the $y$-axis for $1\\le y\\le 2.$ Given that the area of the plate is $\\operatorname{ln}⁡2,$ find the $y$-coordinate of its centroid." #edb/ref 17592186045417] [17592186419229 #edb/ref 1072 #uuid "66ace88b-9157-59ee-88b0-b41cdfb4067c" #edb/ref 17592186045417] [17592186419229 #edb/ref 1074 "The centroid of a lamina $D$ with area ${A}_{D}$ is given by $({x}_{c},{y}_{c}),$ where\n\n$$\n{x}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}x\\,\\,\\text{d}A,\\,{y}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}y\\,\\,\\text{d}A.\n$$\n\nNotice that $D$ is a type II plane region:\n\n![](images/e9/e9800a42aa3086abfc36a301e6771c838d5c9413b3c3f279ee1fc85096476d9a.png)\n\nSo, we have \n\n$$\nD={(x,y)\\,:\\,0\\le x\\le \\frac{1}{y},\\,1\\le y\\le 2}\n$$\n\nand ${A}_{D}=\\operatorname{ln}⁡2.$\n\nTherefore, the $y$-coordinate of the centroid is \n\n$$\n\\begin{aligned}{y}_{c} & =\\frac{1}{{A}_{D}}{∬}_{D}y\\,\\text{d}A \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}{\\int }_{1}^{2}{\\int }_{0}^{1/y}y\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}{\\int }_{1}^{2}y{\\int }_{0}^{1/y}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}{\\int }_{1}^{2}y[x]_{x=0}^{x=1/y}\\,\\text{d}y \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}{\\int }_{1}^{2}y(\\frac{1}{y}-0)\\,\\text{d}y \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}{\\int }_{1}^{2}1\\,\\text{d}y \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}[y]_{1}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}(2-1) \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186419230 #edb/ref 1068 #edb/ref 17592186419214 #edb/ref 17592186045417] [17592186419230 #edb/ref 1069 "q-163211" #edb/ref 17592186045417] [17592186419230 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186419230 #edb/ref 1071 "Consider the lamina that occupies the region $D={(x,y)\\,:\\,0\\le x\\le 2-y,\\,0\\le y\\le 2}$ and has the mass density function $\\lambda (x,y)=xy.$ Given that the mass of the lamina is $\\frac{2}{3}$ units and its center of mass is located at $(\\overset{―}{x},\\overset{―}{y}),$ what is the value of $\\overset{―}{y}?$" #edb/ref 17592186045417] [17592186419230 #edb/ref 1072 #uuid "67539bda-8c11-5bde-87f2-4a2aeb72eb01" #edb/ref 17592186045417] [17592186419230 #edb/ref 1074 "The center of mass of a lamina $D$ with the mass density function $\\lambda (x,y)$ is given by \n\n$$\n(\\overset{―}{x},\\overset{―}{y})=(\\frac{{M}_{y}}{m},\\frac{{M}_{x}}{m}),\n$$\n\nwhere \n\n- $m={∬}_{D}\\lambda (x,y)\\,\\text{d}A$ is the mass of the lamina,\n\n- ${M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A\\,$ is the moment of the lamina about the $x$-axis, and\n\n- ${M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A$ is the moment of the lamina about the $y$-axis.\n\nSince we require the $y$-coordinate of the center of mass, we need to compute the moment about the $x$-axis: \n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A \\\\  & ={∬}_{D}y\\cdot xy\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2-y}x{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}{y}^{2}[{\\int }_{0}^{2-y}x\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}{y}^{2}\\cdot {[\\frac{{x}^{2}}{2}]}_{x=0}^{x=2-y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{1}{2}{y}^{2}(2-y)^{2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}2{y}^{2}-2{y}^{3}+\\frac{1}{2}{y}^{4}\\,\\text{d}y \\\\  & ={[\\frac{2}{3}{y}^{3}-\\frac{1}{2}{y}^{4}+\\frac{1}{10}{y}^{5}]}_{y=0}^{y=2} \\\\  & =\\frac{16}{3}-8+\\frac{16}{5} \\\\  & =\\frac{8}{15}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\overset{―}{y}=\\frac{{M}_{x}}{m}=\\frac{(\\frac{8}{15})}{(\\frac{2}{3})}=\\frac{4}{5}.\n$$" #edb/ref 17592186045417] [17592186419231 #edb/ref 1068 #edb/ref 17592186419219 #edb/ref 17592186045417] [17592186419231 #edb/ref 1069 "q-163069" #edb/ref 17592186045417] [17592186419231 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186419231 #edb/ref 1071 "The lamina $D={(x,y)\\,:\\,1\\le x\\le 2,\\,x-1\\le y\\le 1}$ has the mass density function $\\lambda (x,y)=\\frac{y}{{x}^{2}}.$ Find the moment of the lamina about the $y$-axis." #edb/ref 17592186045417] [17592186419231 #edb/ref 1072 #uuid "70b8cc23-612e-5ff7-9483-d405ee51660f" #edb/ref 17592186045417] [17592186419231 #edb/ref 1074 "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $y$-axis is given by\n\n$$\n{M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type I plane region and $\\lambda (x,y)=\\frac{y}{{x}^{2}}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{y} & ={∬}_{D}x\\cdot \\frac{y}{{x}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{y}{x}\\,\\text{d}A \\\\  & ={\\int }_{1}^{2}{\\int }_{x-1}^{1}\\frac{y}{x}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{x}[{\\int }_{x-1}^{1}y\\,\\text{d}y]\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{x}\\cdot {[\\frac{{y}^{2}}{2}]}_{y=x-1}^{y=1}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{2x}\\cdot [1-(x-1)^{2}]\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{2x}(2x-{x}^{2})\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}1-\\frac{x}{2}\\,\\text{d}x \\\\  & ={[x-\\frac{{x}^{2}}{4}]}_{x=1}^{x=2} \\\\  & =(2-1)-(1-\\frac{1}{4}) \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186419232 #edb/ref 1068 #edb/ref 17592186419221 #edb/ref 17592186045417] [17592186419232 #edb/ref 1069 "q-163283" #edb/ref 17592186045417] [17592186419232 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186419232 #edb/ref 1071 "Consider a thin plate $D$ that has the mass density function $\\lambda (x,y)=x-y$ and is enclosed between the curve $x=-y$ and the $y$-axis for $-1\\le y\\le 0.$ Given that the mass of the plate is $\\frac{1}{2}$ units and its center of mass is located at $(\\overset{―}{x},\\overset{―}{y}),$ what is the value of $\\overset{―}{y}?$" #edb/ref 17592186045417] [17592186419232 #edb/ref 1072 #uuid "71382edc-4cf1-5c73-9402-821a7a44c741" #edb/ref 17592186045417] [17592186419232 #edb/ref 1074 "The center of mass of a lamina $D$ with the mass density function $\\lambda (x,y)$ is given by \n\n$$\n(\\overset{―}{x},\\overset{―}{y})=(\\frac{{M}_{y}}{m},\\frac{{M}_{x}}{m}),\n$$\n\nwhere \n\n- $m={∬}_{D}\\lambda (x,y)\\,\\text{d}A$ is the mass of the lamina,\n\n- ${M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A\\,$ is the moment of the lamina about the $x$-axis, and\n\n- ${M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A$ is the moment of the lamina about the $y$-axis.\n\nNotice that $D$ is a type II plane region:\n\n![](images/e0/e01f73436854c4d337f4fa1dfbb31645c99ccdccbd4e36ae5145305f8b7b4a1f.png)\n\nSo, we have \n\n$$\nD={(x,y)\\,:\\,0\\le x\\le -y,\\,-1\\le y\\le 0}\n$$\n\nand $\\lambda (x,y)=x-y.$ \n\nSince we require the $y$-coordinate of the center of mass, we need to compute the moment about the $x$-axis: \n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A \\\\  & ={∬}_{D}y\\cdot (x-y)\\,\\text{d}A \\\\  & ={∬}_{D}xy-{y}^{2}\\,\\text{d}A \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{-y}xy-{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{-1}^{0}{[\\frac{{x}^{2}y}{2}-x{y}^{2}]}_{x=0}^{x=-y}\\,\\text{d}y \\\\  & ={\\int }_{-1}^{0}\\frac{{y}^{3}}{2}+{y}^{3}\\,\\text{d}y \\\\  & ={\\int }_{-1}^{0}\\frac{3{y}^{3}}{2}\\,\\text{d}y \\\\  & ={[\\frac{3{y}^{4}}{8}]}_{y=-1}^{y=0} \\\\  & =-\\frac{3}{8}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\overset{―}{y}=\\frac{{M}_{x}}{m}=\\frac{(-\\frac{3}{8})}{(\\frac{1}{2})}=-\\frac{3}{4}.\n$$" #edb/ref 17592186045417] [17592186419233 #edb/ref 1068 #edb/ref 17592186419213 #edb/ref 17592186045417] [17592186419233 #edb/ref 1069 "q-163288" #edb/ref 17592186045417] [17592186419233 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186419233 #edb/ref 1071 "Consider the thin plate $D$ enclosed between the curve $y=\\sqrt{x}$ and the $x$-axis for $0\\le x\\le 4.$ Given that the area of the plate is $\\frac{16}{3},$ find the $x$-coordinate of its centroid." #edb/ref 17592186045417] [17592186419233 #edb/ref 1072 #uuid "7d550a84-797a-542e-9e3e-d629d42af4fc" #edb/ref 17592186045417] [17592186419233 #edb/ref 1074 "The centroid of a lamina $D$ with area ${A}_{D}$ is given by $({x}_{c},{y}_{c}),$ where\n\n$$\n{x}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}x\\,\\,\\text{d}A,\\,{y}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}y\\,\\,\\text{d}A.\n$$\n\nNotice that $D$ is a type I plane region:\n\n![](images/95/951eb7592df1645f8743817809c0d4604b779de6a3112f7fcaf6aca5f214f302.png)\n\nSo, we have \n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 4,\\,0\\le y\\le \\sqrt{x}}\n$$\n\nand ${A}_{D}=\\frac{16}{3}.$\n\nTherefore, the $x$-coordinate of the centroid is \n\n$$\n\\begin{aligned}{x}_{c} & =\\frac{1}{{A}_{D}}{∬}_{D}x\\,\\text{d}A \\\\  & =\\frac{3}{16}{\\int }_{0}^{4}{\\int }_{0}^{\\sqrt{x}}x\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{3}{16}{\\int }_{0}^{4}x{\\int }_{0}^{\\sqrt{x}}\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{3}{16}{\\int }_{0}^{4}x[y]_{y=0}^{y=\\sqrt{x}}\\,\\text{d}x \\\\  & =\\frac{3}{16}{\\int }_{0}^{4}x\\sqrt{x}\\,\\text{d}x \\\\  & =\\frac{3}{16}{\\int }_{0}^{4}{x}^{3/2}\\,\\text{d}x \\\\  & =\\frac{3}{16}{[\\frac{2{x}^{5/2}}{5}]}_{0}^{4} \\\\  & =\\frac{3}{16}\\cdot \\frac{64}{5} \\\\  & =\\frac{12}{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186419234 #edb/ref 1068 #edb/ref 17592186419223 #edb/ref 17592186045417] [17592186419234 #edb/ref 1069 "q-162980" #edb/ref 17592186045417] [17592186419234 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186419234 #edb/ref 1071 "A thin plate $D$ with the mass density function $\\lambda (x,y)=\\frac{4}{{y}^{2}}$ is enclosed between the curve $y={e}^{x}$ and the line $y=e$ for $0\\le x\\le 1.$ Find the moment of the plate about the $x$-axis." #edb/ref 17592186045417] [17592186419234 #edb/ref 1072 #uuid "7e0b4e86-c1ad-51fd-8e63-09fcf1f8e1c3" #edb/ref 17592186045417] [17592186419234 #edb/ref 1074 "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $x$-axis is given by\n\n$$\n{M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is a type I plane region, as shown below.\n\n![](images/26/268322576d74a9d63d05e06f55011796e17c2b4ea7a96f583270b5c1cbdb14fb.png)\n\nSo, we have \n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,{e}^{x}\\le y\\le e}\n$$\n\nand $\\lambda (x,y)=\\frac{4}{{y}^{2}}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\cdot \\frac{4}{{y}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{4}{y}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{{e}^{x}}^{e}\\frac{4}{y}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}4[\\operatorname{ln}⁡y]_{y={e}^{x}}^{y=e}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}4(1-x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}4-4x\\,\\text{d}x \\\\  & ={[4x-2{x}^{2}]}_{x=0}^{x=1} \\\\  & =4-2-0 \\\\  & =2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186419235 #edb/ref 1068 #edb/ref 17592186419215 #edb/ref 17592186045417] [17592186419235 #edb/ref 1069 "q-163286" #edb/ref 17592186045417] [17592186419235 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186419235 #edb/ref 1071 "Consider the thin plate $D$ enclosed between the curve $y={x}^{3}$ and the line $y=1$ for $0\\le x\\le 1.$ Given that the area of the plate is $\\frac{3}{4},$ find the $x$-coordinate of its centroid." #edb/ref 17592186045417] [17592186419235 #edb/ref 1072 #uuid "95f0f4f2-b0bf-58b3-a3af-ab5290540b1c" #edb/ref 17592186045417] [17592186419235 #edb/ref 1074 "The centroid of a lamina $D$ with area ${A}_{D}$ is given by $({x}_{c},{y}_{c}),$ where\n\n$$\n{x}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}x\\,\\,\\text{d}A,\\,{y}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}y\\,\\,\\text{d}A.\n$$\n\nNotice that $D$ is a type I plane region:\n\n![](images/99/99c35aa7510a45a0df32868964f4743f44aaff3bc3d0017ee0c9f9afb90e7750.png)\n\nSo, we have \n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{3}\\le y\\le 1}\n$$\n\nand ${A}_{D}=\\frac{3}{4}.$\n\nTherefore, the $x$-coordinate of the centroid is \n\n$$\n\\begin{aligned}{x}_{c} & =\\frac{1}{{A}_{D}}{∬}_{D}x\\,\\text{d}A \\\\  & =\\frac{4}{3}{\\int }_{0}^{1}{\\int }_{{x}^{3}}^{1}x\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{4}{3}{\\int }_{0}^{1}x{\\int }_{{x}^{3}}^{1}\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{4}{3}{\\int }_{0}^{1}x[y]_{y={x}^{3}}^{y=1}\\,\\text{d}x \\\\  & =\\frac{4}{3}{\\int }_{0}^{1}x(1-{x}^{3})\\,\\text{d}x \\\\  & =\\frac{4}{3}{\\int }_{0}^{1}x-{x}^{4}\\,\\text{d}x \\\\  & =\\frac{4}{3}{[\\frac{{x}^{2}}{2}-\\frac{{x}^{5}}{5}]}_{0}^{1} \\\\  & =\\frac{4}{3}(\\frac{1}{2}-\\frac{1}{5}) \\\\  & =\\frac{4}{3}\\cdot \\frac{3}{10} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186419236 #edb/ref 1068 #edb/ref 17592186419209 #edb/ref 17592186045417] [17592186419236 #edb/ref 1069 "q-163210" #edb/ref 17592186045417] [17592186419236 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186419236 #edb/ref 1071 "Consider the lamina that occupies the region $D={(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le \\operatorname{sin}⁡\\frac{\\pi x}{4}}$ and has the mass density function $\\lambda (x,y)=\\frac{1}{\\sqrt{1-{y}^{2}}}.$ Given that the mass of the lamina is $\\frac{\\pi }{8}$ units and its center of mass is located at $(\\overset{―}{x},\\overset{―}{y}),$ what is the value of $\\overset{―}{x}?$" #edb/ref 17592186045417] [17592186419236 #edb/ref 1072 #uuid "966f4f78-b371-5721-ac9e-2f7135cb240b" #edb/ref 17592186045417] [17592186419236 #edb/ref 1074 "The center of mass of a lamina $D$ with the mass density function $\\lambda (x,y)$ is given by \n\n$$\n(\\overset{―}{x},\\overset{―}{y})=(\\frac{{M}_{y}}{m},\\frac{{M}_{x}}{m}),\n$$\n\nwhere \n\n- $m={∬}_{D}\\lambda (x,y)\\,\\text{d}A$ is the mass of the lamina,\n\n- ${M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A\\,$ is the moment of the lamina about the $x$-axis, and\n\n- ${M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A$ is the moment of the lamina about the $y$-axis.\n\nSince we require the $x$-coordinate of the center of mass, we need to compute the moment about the $y$-axis: \n\n$$\n\\begin{aligned}{M}_{y} & ={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A \\\\  & ={∬}_{D}x\\cdot \\frac{1}{\\sqrt{1-{y}^{2}}}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\operatorname{sin}⁡(\\pi x/4)}x\\cdot \\frac{1}{\\sqrt{1-{y}^{2}}}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x[{\\int }_{0}^{\\operatorname{sin}⁡(\\pi x/4)}\\frac{1}{\\sqrt{1-{y}^{2}}}\\,\\text{d}y]\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot [\\operatorname{arcsin}⁡y]_{y=0}^{y=\\operatorname{sin}⁡(\\pi x/4)}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x(\\frac{\\pi x}{4}-0)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{\\pi {x}^{2}}{4}\\,\\text{d}x \\\\  & ={[\\frac{\\pi {x}^{3}}{12}]}_{x=0}^{x=1} \\\\  & =\\frac{\\pi }{12}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\overset{―}{x}=\\frac{{M}_{y}}{m}=\\frac{(\\frac{\\pi }{12})}{(\\frac{\\pi }{8})}=\\frac{2}{3}.\n$$" #edb/ref 17592186045417] [17592186419237 #edb/ref 1068 #edb/ref 17592186419218 #edb/ref 17592186045417] [17592186419237 #edb/ref 1069 "q-163209" #edb/ref 17592186045417] [17592186419237 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186419237 #edb/ref 1071 "Consider the lamina that occupies the region $D={(x,y)\\,:\\,-y\\le x\\le 0,\\,0\\le y\\le 1}$ and has the mass density function $\\lambda (x,y)={x}^{2}y.$ Given that the mass of the lamina is $\\frac{1}{15}$ units and its center of mass is located at $(\\overset{―}{x},\\overset{―}{y}),$ what is the value of $\\overset{―}{x}?$" #edb/ref 17592186045417] [17592186419237 #edb/ref 1072 #uuid "a3000550-9bb9-5fcb-96d7-edd002b477b2" #edb/ref 17592186045417] [17592186419237 #edb/ref 1074 "The center of mass of a lamina $D$ with the mass density function $\\lambda (x,y)$ is given by \n\n$$\n(\\overset{―}{x},\\overset{―}{y})=(\\frac{{M}_{y}}{m},\\frac{{M}_{x}}{m}),\n$$\n\nwhere \n\n- $m={∬}_{D}\\lambda (x,y)\\,\\text{d}A$ is the mass of the lamina,\n\n- ${M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A\\,$ is the moment of the lamina about the $x$-axis, and\n\n- ${M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A$ is the moment of the lamina about the $y$-axis.\n\nSince we require the $x$-coordinate of the center of mass, we need to compute the moment about the $y$-axis: \n\n$$\n\\begin{aligned}{M}_{y} & ={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A \\\\  & ={∬}_{D}x\\cdot {x}^{2}y\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{-y}^{0}{x}^{3}y\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y[{\\int }_{-y}^{0}{x}^{3}\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y{[\\frac{{x}^{4}}{4}]}_{x=-y}^{x=0}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot (0-\\frac{{y}^{4}}{4})\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}-\\frac{{y}^{5}}{4}\\,\\text{d}y \\\\  & ={[-\\frac{{y}^{6}}{24}]}_{y=0}^{y=1} \\\\  & =-\\frac{1}{24}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\overset{―}{x}=\\frac{{M}_{y}}{m}=\\frac{(-\\frac{1}{24})}{(\\frac{1}{15})}=-\\frac{5}{8}.\n$$" #edb/ref 17592186045417] [17592186419238 #edb/ref 1068 #edb/ref 17592186419220 #edb/ref 17592186045417] [17592186419238 #edb/ref 1069 "q-163065" #edb/ref 17592186045417] [17592186419238 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186419238 #edb/ref 1071 "The lamina $D={(x,y)\\,:\\,0\\le x\\le 1,\\,1\\le y\\le (x+1)^{3}}$ has the mass density function $\\lambda (x,y)=\\frac{1}{\\sqrt[3]{{y}^{2}}}.$ Find the moment of the lamina about the $y$-axis." #edb/ref 17592186045417] [17592186419238 #edb/ref 1072 #uuid "a6f84ebc-ad2c-5b3f-b0ba-33fe56e0e4fe" #edb/ref 17592186045417] [17592186419238 #edb/ref 1074 "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $y$-axis is given by\n\n$$\n{M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type I plane region and $\\lambda (x,y)=\\frac{1}{\\sqrt[3]{{y}^{2}}}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{y} & ={∬}_{D}x\\cdot \\frac{1}{\\sqrt[3]{{y}^{2}}}\\,\\text{d}A \\\\  & ={∬}_{D}x{y}^{-2/3}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{(x+1)^{3}}x{y}^{-2/3}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x[{\\int }_{1}^{(x+1)^{3}}{y}^{-2/3}\\,\\text{d}y]\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot [3{y}^{1/3}]_{y=1}^{y=(x+1)^{3}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}3x(x+1-1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}3{x}^{2}\\,\\text{d}x \\\\  & ={[{x}^{3}]}_{x=0}^{x=1} \\\\  & =1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186419239 #edb/ref 1068 #edb/ref 17592186419207 #edb/ref 17592186045417] [17592186419239 #edb/ref 1069 "q-163502" #edb/ref 17592186045417] [17592186419239 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186419239 #edb/ref 1071 "Consider the lamina that occupies the region $D={(x,y)\\,:\\,0\\le x\\le 2y,\\,0\\le y\\le 3}.$ Given that the area of the lamina is $9$ square units, find the $x$-coordinate of its centroid." #edb/ref 17592186045417] [17592186419239 #edb/ref 1072 #uuid "b0dadff4-48ef-5038-93b5-63661b50e4ba" #edb/ref 17592186045417] [17592186419239 #edb/ref 1074 "The centroid of a lamina $D$ with area ${A}_{D}$ is given by $({x}_{c},{y}_{c}),$ where\n\n$$\n{x}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}x\\,\\,\\text{d}A,\\,{y}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}y\\,\\,\\text{d}A.\n$$\n\nTherefore, the $x$-coordinate of the centroid is \n\n$$\n\\begin{aligned}{x}_{c} & =\\frac{1}{{A}_{D}}{∬}_{D}x\\,\\text{d}A \\\\  & =\\frac{1}{9}{\\int }_{0}^{3}{\\int }_{0}^{2y}x\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{1}{9}{\\int }_{0}^{3}{[\\frac{{x}^{2}}{2}]}_{x=0}^{x=2y}\\,\\text{d}y \\\\  & =\\frac{1}{9}{\\int }_{0}^{3}2{y}^{2}\\,\\text{d}y \\\\  & =\\frac{1}{9}{[\\frac{2{y}^{3}}{3}]}_{0}^{3} \\\\  & =\\frac{1}{9}\\cdot 18 \\\\  & =2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186419240 #edb/ref 1068 #edb/ref 17592186419206 #edb/ref 17592186045417] [17592186419240 #edb/ref 1069 "q-162982" #edb/ref 17592186045417] [17592186419240 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186419240 #edb/ref 1071 "A thin plate $D$ with the mass density function $\\lambda (x,y)=\\frac{1}{y}$ is enclosed between the line $x=y$ and the curve  $x=\\frac{4}{y}$  for $1\\le y\\le 2.$ Find the moment of the plate about the $y$-axis." #edb/ref 17592186045417] [17592186419240 #edb/ref 1072 #uuid "d1ae976a-0923-5524-b48c-beb7b491487b" #edb/ref 17592186045417] [17592186419240 #edb/ref 1074 "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $y$-axis is given by\n\n$$\n{M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is a type II plane region, as shown below.\n\n![](images/16/163575c9a1adc54e1ccda5c3008e69413c44015596146bb435a528c4159abaa9.png)\n\nSo, we have \n\n$$\nD={(x,y)\\,:\\,y\\le x\\le \\frac{4}{y},\\,1\\le y\\le 2}\n$$\n\nand $\\lambda (x,y)=\\frac{1}{y}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{y} & ={∬}_{D}x\\cdot \\frac{1}{y}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{x}{y}\\,\\text{d}A \\\\  & ={\\int }_{1}^{2}{\\int }_{y}^{4/y}\\frac{x}{y}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{1}{y}[{\\int }_{y}^{4/y}x\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{1}{y}{[\\frac{{x}^{2}}{2}]}_{x=y}^{x=4/y}\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{1}{y}[\\frac{8}{{y}^{2}}-\\frac{{y}^{2}}{2}]\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{8}{{y}^{3}}-\\frac{y}{2}\\,\\text{d}y \\\\  & ={[-\\frac{4}{{y}^{2}}-\\frac{{y}^{2}}{4}]}_{y=1}^{y=2} \\\\  & =[-1-1]-[-4-\\frac{1}{4}] \\\\  & =\\frac{9}{4}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186419241 #edb/ref 1068 #edb/ref 17592186419212 #edb/ref 17592186045417] [17592186419241 #edb/ref 1069 "q-162978" #edb/ref 17592186045417] [17592186419241 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186419241 #edb/ref 1071 "A thin plate $D$ with the mass density function $\\lambda (x,y)=\\frac{x}{y}$ is enclosed between the lines $x=y$ and  $x=4-y$ for $1\\le y\\le 2.$ Find the moment of the plate about the $x$-axis." #edb/ref 17592186045417] [17592186419241 #edb/ref 1072 #uuid "db64ad9a-61d4-5ef8-8403-3020448e1ff0" #edb/ref 17592186045417] [17592186419241 #edb/ref 1074 "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $x$-axis is given by\n\n$$\n{M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is a type II plane region, as shown below.\n\n![](images/1e/1e0f4ff99aecd563d03f19f5d6a2ede10610ac7117048d2c0d229dbb9c05651c.png)\n\nSo, we have \n\n$$\nD={(x,y)\\,:\\,y\\le x\\le 4-y,\\,1\\le y\\le 2}\n$$\n\nand $\\lambda (x,y)=\\frac{x}{y}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\cdot \\frac{x}{y}\\,\\text{d}A \\\\  & ={∬}_{D}x\\,\\text{d}A \\\\  & ={\\int }_{1}^{2}{\\int }_{y}^{4-y}x\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}{[\\frac{{x}^{2}}{2}]}_{x=y}^{x=4-y}\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{1}{2}[(4-y)^{2}-{y}^{2}]\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\frac{1}{2}(16-8y+{y}^{2}-{y}^{2})\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}8-4y\\,\\text{d}y \\\\  & ={[8y-2{y}^{2}]}_{y=1}^{y=2} \\\\  & =(16-8)-(8-2) \\\\  & =2.\\end{aligned}\n$$" #edb/ref 17592186045417]}
