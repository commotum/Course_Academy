27-5598-b5cd-1224a8a1f8be" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186506505}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8bb9695-808d-511b-81de-dd222d55651d" :question/math-academy-id "q-331054" :question/problem "Suppose we wish to find $L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}$ given $L\\{f(t)\\}=F(s)$ for $s>{s}_{0}.$ Select the correct options in the reasoning below.\n\nLet $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ=A(τ)\\,{|}_{0}^{t}={{field-1}}.\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}=L\\{A(t)\\}={\\int }_{0}^{\\infty }{{field-2}}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & ⇒ & du={{field-3}} \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }({{field-4}}){A}^{′}(t)\\,dt\\end{aligned}\n$$\n\nSince $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=$ {{field-5}}, we have\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{{field-6}}\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$" :question/worked-solution "Let $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ & =A(τ)\\,{|}_{0}^{t} \\\\  & =A(t)-A(0) \\\\  & =A(t).\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\} & =L\\{A(t)\\}={\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & \\,⇒\\, & du={A}^{′}(t)\\,dt \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }(-\\frac{1}{s}{e}^{-st}){A}^{′}(t)\\,dt.\\end{aligned}\n$$\n\nSince $A(0)=0$ and $\\frac{1}{s}{e}^{-st}\\to 0$ as $t\\to \\infty ,$ we have $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=0$ and\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{1}{s}\\cdot F(s) \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$"} :step/id #uuid "3fcf1520-6308-5a6d-b922-4c7a55e8fbad" :step/next {:db/id #edb/ref 17592186506619}} {:db/id #edb/ref 17592186506637 :step/content {:db/id #edb/ref 17592186370079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f38863b-74f6-56b0-9ede-fdc22d79153e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{{t}^{4}}" :db/id #edb/ref 17592186370081} {:answer/id #uuid "65bdd1e2-201e-5a9a-bbd1-4af8aa33cddd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{t}^{3}}{3}" :db/id #edb/ref 17592186370082} {:answer/id #uuid "73dd4000-e170-56cf-b0bf-be74a0168abc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{t}^{4}}{4}" :db/id #edb/ref 17592186370083} {:answer/id #uuid "16906ed8-8aaa-5e95-9569-f7b9ad59835a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{t}^{5}}{20}" :db/id #edb/ref 17592186370084} {:answer/id #uuid "44eb18c9-10ed-5271-b2b0-5aa22cc230d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{t}^{3}" :db/id #edb/ref 17592186370085}] :answer-field/correct {:db/id #edb/ref 17592186370083} :answer-field/id #uuid "577af028-99a4-57d4-b6f6-ead9e4c91fc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186370080}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "55ba2de5-4728-586d-af2e-e9e7120ebc2f" :question/math-academy-id "q-330842" :question/problem "For the function\n\n$$\nG(s)=\\frac{6}{{s}^{5}},\\,s>0\n$$\n\nfind the inverse Laplace transform of $G(s),$ given that\n$L\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}.$" :question/worked-solution "Notice that we can write $G(s)$ as \n\n$$\nG(s)=\\frac{6}{{s}^{5}}=\\frac{F(s)}{s},\n$$\n\nwhere $F(s)=\\frac{6}{{s}^{4}}.$\nAlso, we know that\n\n$$\nL\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}.\n$$\n\nThus, we get\n\n$$\n\\begin{aligned}{L}^{-1}\\{F(s)\\} & ={L}^{-1}\\{\\frac{6}{{s}^{4}}\\} \\\\  & ={L}^{-1}\\{\\frac{3!}{{s}^{3+1}}\\} \\\\  & ={t}^{3}.\\end{aligned}\n$$\n\nAdditionally, we know that if $L\\{f(t)\\}=F(s)$, then\n\n$$\nL\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\}=\\frac{F(s)}{s}.\n$$\n\nUsing the property above in reverse, we obtain\n\n$$\n\\begin{aligned}{L}^{-1}\\{G(s)\\} & ={L}^{-1}\\{\\frac{F(s)}{s}\\} \\\\  & ={\\int }_{0}^{t}f(τ)\\,\\text{d}τ \\\\  & ={\\int }_{0}^{t}{τ}^{3}\\,\\text{d}τ \\\\  & =\\frac{{t}^{4}}{4}.\\end{aligned}\n$$"} :step/id #uuid "93827de0-4c93-5d34-ba6e-983d62296831" :step/next {:db/id #edb/ref 17592186506639}} {:db/id #edb/ref 17592186506639 :step/content {:db/id #edb/ref 17592186506568 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1f2a74-a853-5ec7-b0b4-0f03d890eefb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{t}^{5}" :db/id #edb/ref 17592186505984} {:answer/id #uuid "4118ae4d-b8a7-5823-87d1-3c5655dd813f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{t}^{6}}{6}" :db/id #edb/ref 17592186506020} {:answer/id #uuid "6b9598b0-732d-5f03-a1ef-718b28f8b7c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{t}^{7}}{42}" :db/id #edb/ref 17592186506099} {:answer/id #uuid "d45cf0c7-70de-5cf2-a714-6638ad61a769" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{120}{{t}^{6}}" :db/id #edb/ref 17592186506290} {:answer/id #uuid "e01c50ab-0391-5539-ad7b-4da467964cb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{t}^{5}}{5}" :db/id #edb/ref 17592186506314}] :answer-field/correct {:db/id #edb/ref 17592186506020} :answer-field/id #uuid "c608cf93-4730-5e85-9788-45b64178d3fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186506476}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "90de09a4-cb73-52eb-bce8-60541ed9cd90" :question/math-academy-id "q-330844" :question/problem "For the function\n\n$$\nG(s)=\\frac{120}{{s}^{7}},\\,s>0\n$$\n\nfind the inverse Laplace transform of $G(s),$ given that\n$L\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}.$" :question/worked-solution "Notice that we can write $G(s)$ as \n\n$$\nG(s)=\\frac{120}{{s}^{7}}=\\frac{F(s)}{s},\n$$\n\nwhere $F(s)=\\frac{120}{{s}^{6}}.$\nAlso, we know that\n\n$$\nL\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}.\n$$\n\nThus, we get\n\n$$\n\\begin{aligned}{L}^{-1}\\{F(s)\\} & ={L}^{-1}\\{\\frac{120}{{s}^{6}}\\} \\\\  & ={L}^{-1}\\{\\frac{5!}{{s}^{5+1}}\\} \\\\  & ={t}^{5}.\\end{aligned}\n$$\n\nAdditionally, we know that if $L\\{f(t)\\}=F(s)$, then\n\n$$\nL\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\}=\\frac{F(s)}{s}.\n$$\n\nUsing the property above in reverse, we obtain\n\n$$\n\\begin{aligned}{L}^{-1}\\{G(s)\\} & ={L}^{-1}\\{\\frac{F(s)}{s}\\} \\\\  & ={\\int }_{0}^{t}f(τ)\\,\\text{d}τ \\\\  & ={\\int }_{0}^{t}{τ}^{5}\\,\\text{d}τ \\\\  & =\\frac{{t}^{6}}{6}.\\end{aligned}\n$$"} :step/id #uuid "976cf9cd-7c31-5bac-94f5-19687c0018b1" :step/next {:db/id #edb/ref 17592186506620}}] :activity/title "Laplace Transforms of Integrals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186505903}]}
