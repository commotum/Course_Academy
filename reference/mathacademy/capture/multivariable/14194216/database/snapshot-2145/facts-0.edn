02e67-ec8a-5bd2-a861-50e68971733c" #edb/ref 17592186045417] [17592186100811 #edb/ref 1037 #edb/ref 17592186050961 #edb/ref 17592186045417] [17592186100811 #edb/ref 1037 #edb/ref 17592186051036 #edb/ref 17592186045417] [17592186100811 #edb/ref 1038 #edb/ref 17592186101223 #edb/ref 17592186045417] [17592186100811 #edb/ref 1038 #edb/ref 17592186101224 #edb/ref 17592186045417] [17592186100811 #edb/ref 1039 "Determining the Limit of a Function Given as a Table of Values Using L'Hopital's Rule" #edb/ref 17592186045417] [17592186100811 #edb/ref 1041 #edb/ref 17592186100623 #edb/ref 17592186045417] [17592186100811 #edb/ref 1042 #uuid "c185115e-e3ce-5503-ab5f-a3d0b1a49cfd" #edb/ref 17592186045417] [17592186100812 #edb/ref 1038 #edb/ref 17592186101225 #edb/ref 17592186045417] [17592186100812 #edb/ref 1038 #edb/ref 17592186101226 #edb/ref 17592186045417] [17592186100812 #edb/ref 1038 #edb/ref 17592186234323 #edb/ref 17592186045417] [17592186100812 #edb/ref 1039 "Determining the Limit of a Function Given as a Table of Values Using L'Hopital's Rule Twice" #edb/ref 17592186045417] [17592186100812 #edb/ref 1041 #edb/ref 17592186100624 #edb/ref 17592186045417] [17592186100812 #edb/ref 1042 #uuid "98e43a1e-2073-593b-9b55-4f9c25c356a8" #edb/ref 17592186045417] [17592186101065 #edb/ref 1043 #edb/ref 17592186101583 #edb/ref 17592186045417] [17592186101065 #edb/ref 1043 #edb/ref 17592186101584 #edb/ref 17592186045417] [17592186101065 #edb/ref 1043 #edb/ref 17592186101585 #edb/ref 17592186045417] [17592186101065 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186101065 #edb/ref 1045 "L'Hopital's Rule Applied to Tables" #edb/ref 17592186045417] [17592186101065 #edb/ref 1046 #edb/ref 17592186101583 #edb/ref 17592186045417] [17592186101065 #edb/ref 1049 #edb/ref 17592186050821 #edb/ref 17592186045417] [17592186101065 #edb/ref 1053 #uuid "e216932a-7285-534e-b666-8b8934782d02" #edb/ref 17592186045417] [17592186101224 #edb/ref 1068 #edb/ref 17592186098679 #edb/ref 17592186045417] [17592186101224 #edb/ref 1069 "q-16172" #edb/ref 17592186045417] [17592186101224 #edb/ref 1071 "The functions $f(x)$ and $g(x)$ are differentiable on an open interval containing $x = 7$. The values of $f$, $g$, and their respective derivatives are shown in the following table:\n\n| $x$ | $f(x)$ | $f^{′}(x)$ | $g(x)$ | $g^{′}(x)$ |\n| --- | ---: | ---: | ---: | ---: |\n| $7$ | $0$ | $1$ | $0$ | $2$ |\n\nFind $lim_(x → 7)(f(x))/(x^{2}g(x))$." #edb/ref 17592186045417] [17592186101224 #edb/ref 1072 #uuid "491eead7-322b-5130-8dbc-ee448e88420a" #edb/ref 17592186045417] [17592186101225 #edb/ref 1068 #edb/ref 17592186098685 #edb/ref 17592186045417] [17592186101225 #edb/ref 1069 "q-16174" #edb/ref 17592186045417] [17592186101225 #edb/ref 1071 "The functions $f(x)$ and $g(x)$ are twice-differentiable on an open interval containing $x = 10$. The values of $f$, $g$, and their respective derivatives are given below:\n\n| $x$ | $f(x)$ | $f^{′}(x)$ | $f^{″}(x)$ | $g(x)$ | $g^{′}(x)$ | $g^{″}(x)$ |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: |\n| $10$ | $-5$ | $0$ | $3$ | $-20$ | $-2$ | $-6$ |\n\nFind $lim_(x → 10)(f(x) + 5)/(2x + g(x))$." #edb/ref 17592186045417] [17592186101225 #edb/ref 1072 #uuid "a7440b07-8ce3-57bb-bf61-42f3817efa6d" #edb/ref 17592186045417] [17592186101583 #edb/ref 1058 #edb/ref 17592186101584 #edb/ref 17592186045417] [17592186101583 #edb/ref 1061 1137 #edb/ref 17592186045417] [17592186101583 #edb/ref 1062 #uuid "e4ea661d-9e67-59ef-ae74-3ef55f82ab3a" #edb/ref 17592186045417] [17592186101583 #edb/ref 1063 #edb/ref 17592186101997 #edb/ref 17592186045417] [17592186101584 #edb/ref 1058 #edb/ref 17592186101585 #edb/ref 17592186045417] [17592186101584 #edb/ref 1061 1138 #edb/ref 17592186045417] [17592186101584 #edb/ref 1062 #uuid "06be6b30-b825-5dbe-9087-f089e5a3c396" #edb/ref 17592186045417] [17592186101584 #edb/ref 1063 #edb/ref 17592186100811 #edb/ref 17592186045417] [17592186101585 #edb/ref 1061 1142 #edb/ref 17592186045417] [17592186101585 #edb/ref 1062 #uuid "97a0a8f1-3fcd-5681-9176-f997a3d0c81b" #edb/ref 17592186045417] [17592186101585 #edb/ref 1063 #edb/ref 17592186100812 #edb/ref 17592186045417] [17592186101997 #edb/ref 1064 "The function $f(x)$ is differentiable on an open interval containing $x=2$. The values of $f$ and $f'$ are given in the following table:\n\n| $x$ | $f(x)$ | $f'(x)$ |\n| --- | ---: | ---: |\n| $2$ | $0$ | $4$ |\n\nLet's find\n\n$$\n\\lim\\limits_{x \\to 2} \\dfrac{f(x)}{x^3-8}\n$$\n\nNotice that if we try to substitute $x=2$ directly into the limit, we reach the indeterminate form\n\n$$\n\\dfrac{0}{0}\n$$\n\n$$\n\\begin{aligned}\nlim_(x → 2)(f(x))/(x^{3} - 8) &= \\left.(f(x))/(x^{3} - 8)\\right|_{x = 2} \\\\\n&= (f(2))/(2^{3} - 8) \\\\\n&= \\frac{0}{8 - 8} \\\\\n&= \\frac{0}{0}\n\\end{aligned}\n$$\n\nSo, we use L'Hopital's rule:\n\n$$\n\\begin{aligned}\nlim_(x → 2)(f(x))/(x^{3} - 8) &= lim_(x → 2)((f(x))^{′})/((x^{3} - 8)^{′}) \\\\\n&= lim_(x → 2)(f^{′}(x))/(3x^{2})\n\\end{aligned}\n$$\n\nWe substitute $x=2$ again, and this time, we are able to determine the result:\n\n$$\n\\begin{aligned}\nlim_(x → 2)(f^{′}(x))/(3x^{2}) &= \\left.(f^{′}(x))/(3x^{2})\\right|_{x = 2} \\\\\n&= (f^{′}(2))/(3 \\cdot 2^{2}) \\\\\n&= \\frac{4}{3 \\cdot 2^{2} - 0} \\\\\n&= \\frac{1}{3}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\lim\\limits_{x \\to 2} \\dfrac{f(x)}{x^3-8}=\\dfrac{1}{3}\n$$" #edb/ref 17592186045417] [17592186101997 #edb/ref 1065 599 #edb/ref 17592186045417] [17592186101997 #edb/ref 1066 #uuid "c8d2f073-f126-5950-9555-61f8a6dd159a" #edb/ref 17592186045417] [17592186101997 #edb/ref 1067 "Introduction" #edb/ref 17592186045417]}
