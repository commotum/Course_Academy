c273212" #edb/ref 17592186045417] [17592186508039 #edb/ref 1068 #edb/ref 17592186507972 #edb/ref 17592186045417] [17592186508039 #edb/ref 1069 "q-337014" #edb/ref 17592186045417] [17592186508039 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186508039 #edb/ref 1071 "The functions $f(x)$ and $g(x)$ are twice-differentiable on an open interval containing $x=1.$ The values of $f,$ $g,$ and their respective derivatives are given below:\n\n| $x$ | $f(x)$ | ${f}^{′}(x)$ | ${f}^{″}(x)$ | $g(x)$ | ${g}^{′}(x)$ | ${g}^{″}(x)$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $e$ | $0$ | $0$ | $1$ | $1$ | $2$ |\n\nUsing the values from the table, evaluate the following limit:\n\n${lim}_{x\\to 1}\\frac{{e}^{x}-x\\,f(x)}{\\,f(x)g(x)-{e}^{x}\\,}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186508039 #edb/ref 1072 #uuid "04a061b7-e5c9-583d-9ee4-5ed73b8719bb" #edb/ref 17592186045417] [17592186508039 #edb/ref 1074 "Notice that if we try to substitute $x=1$ directly into the limit, we reach the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{e}^{x}-xf(x)}{f(x)g(x)-{e}^{x}} & ={\\frac{{e}^{x}-xf(x)}{f(x)g(x)-{e}^{x}}|}_{x=1} \\\\  & =\\frac{{e}^{1}-1\\cdot f(1)}{f(1)g(1)-{e}^{1}} \\\\  & =\\frac{e-e}{(e)(1)-e} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we use L'Hopital's rule:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{e}^{x}-xf(x)}{f(x)g(x)-{e}^{x}} & ={lim}_{x\\to 1}\\frac{({e}^{x}-xf(x))^{′}}{(f(x)g(x)-{e}^{x})^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{{e}^{x}-(f(x)+x{f}^{′}(x))}{{f}^{′}(x)g(x)+f(x){g}^{′}(x)-{e}^{x}}\\end{aligned}\n$$\n\nWe substitute $x=1$ again, and once more we get the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{\\frac{{e}^{x}-(f(x)+x{f}^{′}(x))}{{f}^{′}(x)g(x)+f(x){g}^{′}(x)-{e}^{x}}|}_{x=1} & =\\frac{{e}^{1}-(f(1)+1\\cdot {f}^{′}(1))}{{f}^{′}(1)g(1)+f(1){g}^{′}(1)-{e}^{1}} \\\\  & =\\frac{e-(e+0)}{(0)(1)+(e)(1)-e} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{e}^{x}-(f(x)+x{f}^{′}(x))}{{f}^{′}(x)g(x)+f(x){g}^{′}(x)-{e}^{x}} & ={lim}_{x\\to 1}\\frac{({e}^{x}-(f(x)+x{f}^{′}(x)))^{′}}{({f}^{′}(x)g(x)+f(x){g}^{′}(x)-{e}^{x})^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{{e}^{x}-(2{f}^{′}(x)+x{f}^{″}(x))}{{f}^{″}(x)g(x)+2{f}^{′}(x){g}^{′}(x)+f(x){g}^{″}(x)-{e}^{x}}\\end{aligned}\n$$\n\nNow we substitute $x=1$ and evaluate:\n\n$$\n\\begin{aligned}{\\frac{{e}^{x}-(2{f}^{′}(x)+x{f}^{″}(x))}{{f}^{″}(x)g(x)+2{f}^{′}(x){g}^{′}(x)+f(x){g}^{″}(x)-{e}^{x}}|}_{x=1} & =\\frac{{e}^{1}-(2{f}^{′}(1)+1\\cdot {f}^{″}(1))}{{f}^{″}(1)g(1)+2{f}^{′}(1){g}^{′}(1)+f(1){g}^{″}(1)-{e}^{1}} \\\\  & =\\frac{e-(2(0)+0)}{(0)(1)+2(0)(1)+(e)(2)-e} \\\\  & =\\frac{e}{e} \\\\  & =1\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n{lim}_{x\\to 1}\\frac{{e}^{x}-x\\,f(x)}{\\,f(x)g(x)-{e}^{x}\\,}=1.\n$$" #edb/ref 17592186045417] [17592186508078 #edb/ref 1068 #edb/ref 17592186507945 #edb/ref 17592186045417] [17592186508078 #edb/ref 1069 "q-337304" #edb/ref 17592186045417] [17592186508078 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186508078 #edb/ref 1071 "The functions $f(x)$ and $g(x)$ are twice-differentiable on an open interval containing $x=1.$ The values of $f,$ $g,$ and their respective derivatives are given below:\n\n| $x$ | $f(x)$ | ${f}^{′}(x)$ | ${f}^{″}(x)$ | $g(x)$ | ${g}^{′}(x)$ | ${g}^{″}(x)$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $2$ | $-2$ | $4$ | $3$ | $-2$ | $2$ |\n\nUsing the values from the table, evaluate the following limit:\n\n${lim}_{x\\to 1}\\frac{\\,f(x)+{x}^{2}-3\\,}{\\,g(x)+{x}^{2}-4\\,}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186508078 #edb/ref 1072 #uuid "8771f8a8-d420-525c-a30c-b75746b0e1ac" #edb/ref 17592186045417] [17592186508078 #edb/ref 1074 "Notice that if we try to substitute $x=1$ directly into the limit, we reach the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{f(x)+{x}^{2}-3}{g(x)+{x}^{2}-4} & ={\\frac{f(x)+{x}^{2}-3}{g(x)+{x}^{2}-4}|}_{x=1} \\\\  & =\\frac{f(1)+{1}^{2}-3}{g(1)+{1}^{2}-4} \\\\  & =\\frac{2+1-3}{3+1-4} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we use L'Hopital's rule:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{f(x)+{x}^{2}-3}{g(x)+{x}^{2}-4} & ={lim}_{x\\to 1}\\frac{(f(x)+{x}^{2}-3)^{′}}{(g(x)+{x}^{2}-4)^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{{f}^{′}(x)+2x}{{g}^{′}(x)+2x}\\end{aligned}\n$$\n\nWe substitute $x=1$ again, and once more we get the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{\\frac{{f}^{′}(x)+2x}{{g}^{′}(x)+2x}|}_{x=1} & =\\frac{{f}^{′}(1)+2(1)}{{g}^{′}(1)+2(1)} \\\\  & =\\frac{-2+2}{-2+2} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{f}^{′}(x)+2x}{{g}^{′}(x)+2x} & ={lim}_{x\\to 1}\\frac{({f}^{′}(x)+2x)^{′}}{({g}^{′}(x)+2x)^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{{f}^{″}(x)+2}{{g}^{″}(x)+2}\\end{aligned}\n$$\n\nNow we substitute $x=1$ and evaluate:\n\n$$\n\\begin{aligned}{\\frac{{f}^{″}(x)+2}{{g}^{″}(x)+2}|}_{x=1} & =\\frac{{f}^{″}(1)+2}{{g}^{″}(1)+2} \\\\  & =\\frac{4+2}{2+2} \\\\  & =\\frac{6}{4} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n{lim}_{x\\to 1}\\frac{\\,f(x)+{x}^{2}-3\\,}{\\,g(x)+{x}^{2}-4\\,}=\\frac{3}{2}.\n$$" #edb/ref 17592186045417] [17592186508115 #edb/ref 1068 #edb/ref 17592186507970 #edb/ref 17592186045417] [17592186508115 #edb/ref 1069 "q-337001" #edb/ref 17592186045417] [17592186508115 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186508115 #edb/ref 1071 "The functions $f(x)$ and $g(x)$ are differentiable on an open interval containing $x=2.$ The values of $f,$ $g,$ and their respective derivatives are shown in the following table:\n\n| $x$ | $f(x)$ | ${f}^{′}(x)$ | $g(x)