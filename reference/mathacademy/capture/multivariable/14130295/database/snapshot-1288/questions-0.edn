#{[{:db/id #edb/ref 17592186180103 :knowledge-point/_questions [{:db/id #edb/ref 17592186179779 :knowledge-point/id #uuid "94904fa2-bf02-5486-950c-979a4d12998e" :knowledge-point/title "Applying the Work-Energy Principle To Find the Work Done by a Force"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "452dcb36-4e8e-5c4d-bbab-d59aa1427bbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,J" :db/id #edb/ref 17592186279210} {:answer/id #uuid "675b5d28-9c02-5ed8-b190-60068bfd7200" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,J" :db/id #edb/ref 17592186279529} {:answer/id #uuid "7bcd8992-c86f-5ed8-8b85-3b006eb23206" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,J" :db/id #edb/ref 17592186279696} {:answer/id #uuid "98b9878b-6e3c-5263-8d0a-a4133c54e84a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,J" :db/id #edb/ref 17592186279941} {:answer/id #uuid "f3589965-bf1c-56f3-9f99-d2824d583527" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,J" :db/id #edb/ref 17592186280718}] :answer-field/correct {:answer/id #uuid "98b9878b-6e3c-5263-8d0a-a4133c54e84a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,J" :db/id #edb/ref 17592186279941} :answer-field/id #uuid "3768d6e3-78a3-5ed2-b58b-bc35eeb1c01e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280933}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c92a85dc-fea5-582a-a4d0-c749606f94b3" :question/math-academy-id "q-163601" :question/problem "A particle $P$ of mass $2\\,kg$ moves along the $x$-axis under the action of a resultant force. The particle's velocity is $2t\\,m/s,$ where $t\\ge 0$ is the time in seconds. Calculate the work done by the force between the times $t=1\\,s$ and $t=2\\,s.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nThe particle's velocity is given by $v(t)=2t,$ where $t$ is time in seconds. So, the particle's initial velocity, at $t=1$, is\n\n$$\n{v}_{0}=v(1)=2(1)=2\\,m/s,\n$$\n\nand final velocity, at $t=2$, is\n\n$$\n{v}_{1}=v(2)=2(2)=4\\,m/s.\n$$\n\nTherefore, by the work-energy principle, the work done by the force between these times is\n\n$$\n\\begin{aligned}W & =Δ\\,\\text{KE} \\\\  & =\\frac{1}{2}\\cdot 2\\cdot (4)^{2}-\\frac{1}{2}\\cdot 2\\cdot (2)^{2} \\\\  & =16-4 \\\\  & =12\\,J.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186389449 :knowledge-point/_questions [{:db/id #edb/ref 17592186179777 :knowledge-point/id #uuid "9696b3f4-42c8-5796-be3a-6c59c9600c95" :knowledge-point/title "Calculating the Work Done by a Force"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb4d826c-14ba-585c-aebd-1facb3368012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\,J" :db/id #edb/ref 17592186389451} {:answer/id #uuid "8ab762ed-0112-5d52-b62f-05b3b484b0b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\,J" :db/id #edb/ref 17592186389452} {:answer/id #uuid "6aa053a0-465d-5f0b-8742-c3a588a86e3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,J" :db/id #edb/ref 17592186389453} {:answer/id #uuid "ee6add72-368a-56d1-a701-8e8fbe0ceee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\,J" :db/id #edb/ref 17592186389454} {:answer/id #uuid "04400f5c-b01f-5a74-aa41-074c903d6463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,J" :db/id #edb/ref 17592186389455}] :answer-field/correct {:answer/id #uuid "eb4d826c-14ba-585c-aebd-1facb3368012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\,J" :db/id #edb/ref 17592186389451} :answer-field/id #uuid "7fc72668-2f1d-508f-943f-15caead3623c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389450}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d31a00a5-c404-50d8-b7f2-fda34cf2cc53" :question/math-academy-id "q-163685" :question/problem "A particle $P$ moves along the $x$-axis under the action of a force of magnitude $\\frac{1}{{x}^{2}}\\,\\text{N}$ acting in the direction of increasing $x.$ Given that $x$ is measured in meters, calculate the work done by the force in moving the particle from $x=1$ to $x=4.$" :question/worked-solution "The work done by a force $F=F(x)$ in moving a particle from $x={x}_{1}$ to $x={x}_{2}$ is given by\n\n$$\nW={\\int }_{{x}_{1}}^{{x}_{2}}F(x)\\,\\text{d}x.\n$$\n\nWhen the force and distance are measured in Newtons and meters, respectively, the work done by the force is measured in Joules ($J$).\n\nSubstituting the given values into our integral, we obtain\n\n$$\n\\begin{aligned}W & ={\\int }_{1}^{4}\\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =-\\frac{1}{x}\\,{|}_{1}^{4} \\\\  & =-(\\frac{1}{4}-1) \\\\  & =-(-\\frac{3}{4}) \\\\  & =\\frac{3}{4}\\,J.\\end{aligned}\n$$"}]}
