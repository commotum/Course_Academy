[{:db/id 17592186179777 :knowledge-point/questions ["question-720a885d-9cf4-5861-8b99-013e8190ec62"] :db/ensure [:knowledge-point/validate]} {:db/id "question-720a885d-9cf4-5861-8b99-013e8190ec62" :question/id #uuid "720a885d-9cf4-5861-8b99-013e8190ec62" :question/math-academy-id "q-163683" :question/problem "A particle $P$ moves along the $x$-axis under the action of a force of magnitude $(2x+{x}^{2})\\,\\text{N}$ acting in the direction of increasing $x.$ Given that $x$ is measured in meters, calculate the work done by the force in moving the particle from $x=0$ to $x=2.$" :question/worked-solution "The work done by a force $F=F(x)$ in moving a particle from $x={x}_{1}$ to $x={x}_{2}$ is given by\n\n$$\nW={\\int }_{{x}_{1}}^{{x}_{2}}F(x)\\,\\text{d}x.\n$$\n\nWhen the force and distance are measured in Newtons and meters, respectively, the work done by the force is measured in Joules ($J$).\n\nSubstituting the given values into our integral, we obtain\n\n$$\n\\begin{aligned}W & ={\\int }_{0}^{2}(2x+{x}^{2})\\,\\text{d}x \\\\  & ={[{x}^{2}+\\frac{1}{3}{x}^{3}]}_{0}^{2} \\\\  & ={2}^{2}+\\frac{1}{3}({2}^{3})-({0}^{2}+\\frac{1}{3}({0}^{3})) \\\\  & =4+\\frac{8}{3}-0 \\\\  & =\\frac{20}{3}\\,J.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7df70823-9962-541f-9d3b-9f6bc58730dc"] :db/ensure [:question/validate]} {:db/id "answer-field-7df70823-9962-541f-9d3b-9f6bc58730dc" :answer-field/id #uuid "7df70823-9962-541f-9d3b-9f6bc58730dc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ce34ff78-907d-5c9a-b016-26b849102736" :answer-field/choices ["answer-005f40cc-1636-56ab-b246-5737a11e79cd" "answer-5e6cfef4-3fa0-536d-accc-16bd9fddb64c" "answer-a1bab12d-028f-5c7b-8260-e0dd0f56b76b" "answer-ce34ff78-907d-5c9a-b016-26b849102736" "answer-49730251-5fc6-518d-bdf0-26723df97b08"] :db/ensure [:answer-field/validate]} {:db/id "answer-005f40cc-1636-56ab-b246-5737a11e79cd" :answer/id #uuid "005f40cc-1636-56ab-b246-5737a11e79cd" :answer/type :answer.type/math :answer/value "5\\,J" :db/ensure [:answer/validate]} {:db/id "answer-5e6cfef4-3fa0-536d-accc-16bd9fddb64c" :answer/id #uuid "5e6cfef4-3fa0-536d-accc-16bd9fddb64c" :answer/type :answer.type/math :answer/value "7\\,J" :db/ensure [:answer/validate]} {:db/id "answer-a1bab12d-028f-5c7b-8260-e0dd0f56b76b" :answer/id #uuid "a1bab12d-028f-5c7b-8260-e0dd0f56b76b" :answer/type :answer.type/math :answer/value "\\frac{15}{2}\\,J" :db/ensure [:answer/validate]} {:db/id "answer-ce34ff78-907d-5c9a-b016-26b849102736" :answer/id #uuid "ce34ff78-907d-5c9a-b016-26b849102736" :answer/type :answer.type/math :answer/value "\\frac{20}{3}\\,J" :db/ensure [:answer/validate]} {:db/id "answer-49730251-5fc6-518d-bdf0-26723df97b08" :answer/id #uuid "49730251-5fc6-518d-bdf0-26723df97b08" :answer/type :answer.type/math :answer/value "\\frac{9}{4}\\,J" :db/ensure [:answer/validate]} {:db/id "activity-595c8569-5220-5289-addf-624ae85604ef" :activity/id #uuid "595c8569-5220-5289-addf-624ae85604ef" :activity/title "The Work-Energy Principle" :activity/type :activity.type/review :activity/scope 17592186050766 :activity/course 17592186046660 :activity/steps ["step-fa49f09b-6aed-5e72-bb78-032089ad9e8e" "step-6b7802f0-312d-58fa-a3d7-a69103bfe77b" "step-593e6b92-f812-5412-8a5a-9a03f302bd99"] :activity/first-step "step-fa49f09b-6aed-5e72-bb78-032089ad9e8e" :db/ensure [:activity/validate]} {:db/id "step-fa49f09b-6aed-5e72-bb78-032089ad9e8e" :step/id #uuid "fa49f09b-6aed-5e72-bb78-032089ad9e8e" :step/content 17592186180103 :step/next "step-6b7802f0-312d-58fa-a3d7-a69103bfe77b" :db/ensure [:step/validate]} {:db/id "step-6b7802f0-312d-58fa-a3d7-a69103bfe77b" :step/id #uuid "6b7802f0-312d-58fa-a3d7-a69103bfe77b" :step/content "question-720a885d-9cf4-5861-8b99-013e8190ec62" :step/next "step-593e6b92-f812-5412-8a5a-9a03f302bd99" :db/ensure [:step/validate]} {:db/id "step-593e6b92-f812-5412-8a5a-9a03f302bd99" :step/id #uuid "593e6b9