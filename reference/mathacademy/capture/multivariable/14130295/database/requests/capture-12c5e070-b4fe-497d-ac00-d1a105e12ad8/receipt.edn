4139534601 17592186045417 true] [17592186427390 1083 #uuid "a1bab12d-028f-5c7b-8260-e0dd0f56b76b" 13194139534601 17592186045417 true] [17592186427391 1080 "\\frac{20}{3}\\,J" 13194139534601 17592186045417 true] [17592186427391 1082 #edb/ref 17592186045498 13194139534601 17592186045417 true] [17592186427391 1083 #uuid "ce34ff78-907d-5c9a-b016-26b849102736" 13194139534601 17592186045417 true] [17592186427392 1075 #edb/ref 17592186427387 13194139534601 17592186045417 true] [17592186427392 1075 #edb/ref 17592186427388 13194139534601 17592186045417 true] [17592186427392 1075 #edb/ref 17592186427389 13194139534601 17592186045417 true] [17592186427392 1075 #edb/ref 17592186427390 13194139534601 17592186045417 true] [17592186427392 1075 #edb/ref 17592186427391 13194139534601 17592186045417 true] [17592186427392 1076 #edb/ref 17592186045493 13194139534601 17592186045417 true] [17592186427392 1077 "selection" 13194139534601 17592186045417 true] [17592186427392 1078 #edb/ref 17592186427391 13194139534601 17592186045417 true] [17592186427392 1079 #uuid "7df70823-9962-541f-9d3b-9f6bc58730dc" 13194139534601 17592186045417 true] [17592186427393 1068 #edb/ref 17592186427392 13194139534601 17592186045417 true] [17592186427393 1069 "q-163683" 13194139534601 17592186045417 true] [17592186427393 1070 #edb/ref 17592186045485 13194139534601 17592186045417 true] [17592186427393 1071 "A particle $P$ moves along the $x$-axis under the action of a force of magnitude $(2x+{x}^{2})\\,\\text{N}$ acting in the direction of increasing $x.$ Given that $x$ is measured in meters, calculate the work done by the force in moving the particle from $x=0$ to $x=2.$" 13194139534601 17592186045417 true] [17592186427393 1072 #uuid "720a885d-9cf4-5861-8b99-013e8190ec62" 13194139534601 17592186045417 true] [17592186427393 1074 "The work done by a force $F=F(x)$ in moving a particle from $x={x}_{1}$ to $x={x}_{2}$ is given by\n\n$$\nW={\\int }_{{x}_{1}}^{{x}_{2}}F(x)\\,\\text{d}x.\n$$\n\nWhen the force and distance are measured in Newtons and meters, respectively, the work done by the force is measured in Joules ($J$).\n\nSubstituting the given values into our integral, we obtain\n\n$$\n\\begin{aligned}W & ={\\int }_{0}^{2}(2x+{x}^{2})\\,\\text{d}x \\\\  & ={[{x}^{2}+\\frac{1}{3}{x}^{3}]}_{0}^{2} \\\\  & ={2}^{2}+\\frac{1}{3}({2}^{3})-({0}^{2}+\\frac{1}{3}({0}^{3})) \\\\  & =4+\\frac{8}{3}-0 \\\\  & =\\frac{20}{3}\\,J.\\end{aligned}\n$$" 13194139534601 17592186045417 true] [17592186427394 1062 #uuid "593e6b92-f812-5412-8a5a-9a03f302bd99" 13194139534601 17592186045417 true] [17592186427394 1063 #edb/ref 17592186389449 13194139534601 17592186045417 true] [17592186427395 1058 #edb/ref 17592186427394 13194139534601 17592186045417 true] [17592186427395 1062 #uuid "6b7802f0-312d-58fa-a3d7-a69103bfe77b" 13194139534601 17592186045417 true] [17592186427395 1063 #edb/ref 17592186427393 13194139534601 17592186045417 true] [17592186427396 1058 #edb/ref 17592186427395 13194139534601 17592186045417 true] [17592186427396 1062 #uuid "fa49f09b-6aed-5e72-bb78-032089ad9e8e" 13194139534601 17592186045417 true] [17592186427396 1063 #edb/ref 17592186180103 13194139534601 17592186045417 true]] :edb/tempids {"activity-595c8569-5220-5289-addf-624ae85604ef" 17592186427386 "answer-005f40cc-1636-56ab-b246-5737a11e79cd" 17592186427387 "answer-49730251-5fc6-518d-bdf0-26723df97b08" 17592186427388 "answer-5e6cfef4-3fa0-536d-accc-16bd9fddb64c" 17592186427389 "answer-a1bab12d-028f-5c7b-8260-e0dd0f56b76b" 17592186427390 "answer-ce34ff78-907d-5c9a-b016-26b849102736" 17592186427391 "answer-field-7df70823-9962-541f-9d3b-9f6bc58730dc" 17592186427392 "question-720a885d-9cf4-5861-8b99-013e8190ec62" 17592186427393 "step-593e6b92-f812-5412-8a5a-9a03f302bd99" 17592186427394 "step-6b7802f0-312d-58fa-a3d7-a69103bfe77b" 17592186427395 "step-fa49f09b-6aed-5e72-bb78-032089ad9e8e" 17592186427396}}
