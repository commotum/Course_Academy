{"error":false,"activeTest":false,"task":{"id":14254548,"type":"Lesson","status":"Processed","importance":2,"reason":null,"locked":null,"proofId":null,"currentQuestionId":null,"currentQuestionTimestamp":null,"progress":1,"points":7,"passed":1,"rawPointsAwarded":4,"pointsAwarded":4,"mp":null,"mpAwarded":null,"mpDecayRate":null,"student":{"id":57964,"firstName":"William","lastName":"Parker","locale":null,"subscriptionId":"sub_1UO2MGD4gcTFRx970s7DzjQk","sequenceId":15},"course":{"id":76,"name":"Methods of Proof"},"topic":{"id":2798,"name":"Formal and Informal Language"},"test":{"id":null,"name":null,"diagnostic":null,"timeLimit":null,"questionCount":null},"created":"2026-10-16T05:09:00.000Z","started":"2026-10-16T05:11:22.000Z","completed":"2026-10-16T05:16:18.000Z","processed":"2026-10-16T05:16:29.000Z","progressStr":"100%","answers":[{"id":62321806,"studentId":57964,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":15505,"question":{"id":183655,"exampleId":12753,"difficulty":1}},{"id":62321821,"studentId":57964,"choices":null,"selectedChoice":5,"selectId":0,"correct":0,"timeElapsed":14169,"question":{"id":183654,"exampleId":12753,"difficulty":1}},{"id":62321842,"studentId":57964,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":12957,"question":{"id":172008,"exampleId":12753,"difficulty":1}},{"id":62321863,"studentId":57964,"choices":null,"selectedChoice":3,"selectId":0,"correct":0,"timeElapsed":13419,"question":{"id":172016,"exampleId":12753,"difficulty":1}},{"id":62321873,"studentId":57964,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":11457,"question":{"id":183658,"exampleId":12753,"difficulty":1}},{"id":62321896,"studentId":57964,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":17819,"question":{"id":172009,"exampleId":12752,"difficulty":2}},{"id":62321916,"studentId":57964,"choices":null,"selectedChoice":2,"selectId":0,"correct":0,"timeElapsed":16333,"question":{"id":183715,"exampleId":12752,"difficulty":2}},{"id":62321930,"studentId":57964,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":14083,"question":{"id":183717,"exampleId":12752,"difficulty":2}},{"id":62321942,"studentId":57964,"choices":null,"selectedChoice":5,"selectId":0,"correct":0,"timeElapsed":12572,"question":{"id":172010,"exampleId":12752,"difficulty":2}},{"id":62321963,"studentId":57964,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":12384,"question":{"id":172015,"exampleId":12752,"difficulty":2}},{"id":62321990,"studentId":57964,"choices":null,"selectedChoice":3,"selectId":0,"correct":0,"timeElapsed":15551,"question":{"id":183556,"exampleId":12751,"difficulty":2}},{"id":62322009,"studentId":57964,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":14944,"question":{"id":183560,"exampleId":12751,"difficulty":3}},{"id":62322021,"studentId":57964,"choices":null,"selectedChoice":5,"selectId":0,"correct":0,"timeElapsed":14954,"question":{"id":172161,"exampleId":12751,"difficulty":2}},{"id":62322037,"studentId":57964,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":17433,"question":{"id":183553,"exampleId":12751,"difficulty":1}},{"id":62322064,"studentId":57964,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":16137,"question":{"id":183567,"exampleId":12751,"difficulty":3}}],"completedStr":"Completed @ 5:16 AM","exampleAnswers":[{"id":12753,"number":1,"title":"Expressing a Plain English Sentence as a Formal Statement","answers":[{"id":62321806,"created":"2026-10-16T05:11:47.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":15505,"number":1,"createdStr":"Fri, Oct 16th @ 5:11 AM","timeElapsedFormatted":"0:16","question":{"id":183655,"format":"MC","difficulty":1,"exampleId":12753,"text":"<blockquote>\n<p>The square root of every prime number is irrational.</p>\n</blockquote>\n<p>Express the statement above in formal language.</p>\n","choice1":"$\\forall \\, p$ prime, $\\sqrt{p} \\in \\mathbb{R}\\setminus\\mathbb Q$","choice2":"$\\exists \\, p$ prime, $\\sqrt{p} \\in \\mathbb{R}\\setminus\\mathbb Q$","choice3":"$\\exists \\, p \\in \\mathbb{R}\\setminus\\mathbb Q,\\,\\sqrt{p}$ is prime","choice4":"$\\forall  \\,p \\in \\mathbb{R}\\setminus\\mathbb Q,\\,\\sqrt{p}$ is prime","choice5":"$p$ prime,$ \\forall \\, \\sqrt{p} \\in \\mathbb{R}\\setminus\\mathbb Q$","freeAnswerChoice":" ","explanation":"<p><p>Let&#39;s examine our statement:</p></p>\n<p><ul></p>\n<p><li><p>The word &quot;every&quot; indicates we use a universal quantifier, $\\forall.$</p>\n</li></p>\n<p><li><p>The sentence refers to prime numbers. So, by denoting a prime number as $p,$ we have that \n\\[\n\\forall\\, \\textrm{$p$ prime}.\n\\] </p>\n</li></p>\n<p><li><p>Finally, the condition in the statement can be written as\n\\[\n\\sqrt{p} \\in \\mathbb{R}\\setminus\\mathbb Q.\n\\]</p>\n</li>\n</ul></p>\n<p><p>Therefore, we write the statement as follows:</p></p>\n<blockquote>\n<p>$\\forall \\, p$ prime, $ \\sqrt{p} \\in \\mathbb{R}\\setminus\\mathbb Q.$</p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12753,"title":"Expressing a Plain English Sentence as a Formal Statement"},"group":{"id":24158,"calculator":"None"},"graphics":[],"selects":[{"id":null,"number":null,"answers":[]}],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62321806,"cread":"2026-10-16T05:11:47.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":15505},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62321821,"created":"2026-10-16T05:12:05.000Z","choices":null,"correct":0,"selectedChoice":5,"freeResponse":null,"timeElapsed":14169,"number":2,"createdStr":"Fri, Oct 16th @ 5:12 AM","timeElapsedFormatted":"0:14","question":{"id":183654,"format":"MC","difficulty":1,"exampleId":12753,"text":"<blockquote>\n<p> All integers are rational numbers.</p>\n</blockquote>\n<p>Express the statement above in formal language.</p>\n","choice1":"$\\forall \\, a \\in \\mathbb{Z}, \\, a \\in \\mathbb{Q}$","choice2":"$\\exists \\, a \\in \\mathbb{Z}, \\, a \\in \\mathbb{Q}$","choice3":"$\\forall \\, a \\in \\mathbb{Q}, \\, a \\in \\mathbb{Z}$","choice4":"$\\exists \\, a \\in \\mathbb{Q}, \\, a \\in \\mathbb{Z}$","choice5":"$a \\in \\mathbb{Z}, \\,\\forall \\, a \\in \\mathbb{Q}$","freeAnswerChoice":" ","explanation":"<p><p>Let&#39;s examine our statement:</p></p>\n<p><ul></p>\n<p><li><p>The word &quot;all&quot; indicates we should use a universal quantifier, $\\forall.$ </p>\n</li></p>\n<p><li><p>The sentence refers to integer numbers. So, by denoting an integer as $a,$ we have that \n\\[\n\\forall \\, a \\in \\mathbb{Z}.\n\\]</p>\n</li></p>\n<p><li><p>Finally, the condition in the statement can be written as \n\\[\na  \\in \\mathbb{Q}.\n\\]</p>\n</li>\n</ul></p>\n<p><p>Therefore, we write the statement as follows: </p></p>\n<blockquote>\n<p>$\\forall \\, a \\in \\mathbb{Z}, \\, a \\in \\mathbb{Q}.$</p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12753,"title":"Expressing a Plain English Sentence as a Formal Statement"},"group":{"id":24158,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62321821,"cread":"2026-10-16T05:12:05.000Z","choices":null,"correct":0,"selectedChoice":5,"freeResponse":null,"timeElapsed":14169},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62321842,"created":"2026-10-16T05:12:22.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":12957,"number":3,"createdStr":"Fri, Oct 16th @ 5:12 AM","timeElapsedFormatted":"0:13","question":{"id":172008,"format":"MC","difficulty":1,"exampleId":12753,"text":"<blockquote>\n<p> Every integer is either even or odd</p>\n</blockquote>\n<p>Express the statement above in formal language.</p>\n","choice1":"$\\forall \\, x \\in \\mathbb{Z}, \\, x$ is even or $x$ is odd","choice2":"$\\exists \\, x \\in \\mathbb{Z}, \\, x$ is even or $x$ is odd","choice3":"$\\forall \\, x \\in \\mathbb{R}, \\, x$ is even or $x$ is odd","choice4":"$\\exists \\, x \\in \\mathbb{R}, \\, x$ is even or $x$ is odd","choice5":"$\\exists \\, x,y \\in \\mathbb{Z}, \\, x$ is even or $y$ is odd","freeAnswerChoice":" ","explanation":"<p><p>Let&#39;s examine our statement:</p></p>\n<p><ul></p>\n<p><li><p>The word &quot;every&quot; indicates we should use a universal quantifier, $\\forall.$ </p>\n</li></p>\n<p><li><p>The sentence refers to integers. So, by denoting an integer number as $x,$ we have that \n\\[\n\\forall \\, x \\in \\mathbb{Z}.\n\\]</p>\n</li></p>\n<p><li><p>Finally, the condition in the statement can be written as \n\\[\nx \\textrm{ is even or } x \\textrm{ is odd} .\n\\]</p>\n</li>\n</ul></p>\n<p><p>Therefore, we write the statement as follows: </p></p>\n<blockquote>\n<p>$\\forall \\,  x \\in \\mathbb{Z}, \\, x$ is even or $x$ is odd.</p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12753,"title":"Expressing a Plain English Sentence as a Formal Statement"},"group":{"id":24158,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62321842,"cread":"2026-10-16T05:12:22.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":12957},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62321863,"created":"2026-10-16T05:12:40.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":13419,"number":4,"createdStr":"Fri, Oct 16th @ 5:12 AM","timeElapsedFormatted":"0:13","question":{"id":172016,"format":"MC","difficulty":1,"exampleId":12753,"text":"<blockquote>\n<p>There is some real number whose square root is greater than its square</p>\n</blockquote>\n<p>Express the statement above in formal language.</p>\n","choice1":"$\\exists \\, x \\in \\mathbb{R}, \\sqrt{x} > x^2$","choice2":"$\\forall \\, x \\in \\mathbb{R}, \\sqrt{x} > x^2$","choice3":"$\\exists \\, x \\in \\mathbb{Z}, \\sqrt{x} > x^2$","choice4":"$\\forall \\, x \\in \\mathbb{Z}, \\sqrt{x} > x^2$","choice5":"$\\exists\\, \\mathbb{R}, \\sqrt{x} > x^2$","freeAnswerChoice":" ","explanation":"<p><p>Let&#39;s examine our statement:</p></p>\n<p><ul></p>\n<p><li><p>The words &quot;there is&quot; indicate we use an existential quantifier, $\\exists.$</p>\n</li></p>\n<p><li><p>The sentence refers to real numbers. So, by denoting our number as $x,$ we have \n\\[\n\\exists \\, x \\in \\mathbb{R}.\n\\] </p>\n</li></p>\n<p><li><p>Finally, the condition in the statement can be written as</p>\n</li>\n</ul></p>\n<p><p>\\[\n\\sqrt{x} &gt; x^2.\n\\]</p></p>\n<p><p>Therefore, we write the statement as follows:</p></p>\n<blockquote>\n<p>$\\exists \\, x \\in \\mathbb{R}, \\sqrt{x} &gt; x^2$</p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12753,"title":"Expressing a Plain English Sentence as a Formal Statement"},"group":{"id":25437,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62321863,"cread":"2026-10-16T05:12:40.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":13419},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62321873,"created":"2026-10-16T05:12:56.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":11457,"number":5,"createdStr":"Fri, Oct 16th @ 5:12 AM","timeElapsedFormatted":"0:11","question":{"id":183658,"format":"MC","difficulty":1,"exampleId":12753,"text":"<blockquote>\n<p> The cube of every rational number is rational.</p>\n</blockquote>\n<p>Express the statement above in formal language.</p>\n","choice1":" $\\forall \\, x  \\in \\mathbb{Q}, \\, x^3  \\in \\mathbb{Q}$","choice2":" $\\exists \\, x  \\in \\mathbb{Q}, \\, x^3  \\in \\mathbb{Q}$","choice3":" $\\forall \\, x^3  \\in \\mathbb{Q}, \\, x  \\in \\mathbb{Q}$","choice4":" $\\exists \\, x^3  \\in \\mathbb{Q}, \\, x  \\in \\mathbb{Q}$","choice5":" $x \\in \\mathbb{Q}, \\,\\forall \\, x^3  \\in \\mathbb{Q}$","freeAnswerChoice":" ","explanation":"<p><p>Let&#39;s examine our statement:</p></p>\n<p><ul></p>\n<p><li><p>The word &quot;every&quot; indicates we should use a universal quantifier, $\\forall.$ </p>\n</li></p>\n<p><li><p>The sentence refers to rational numbers. So, by denoting a rational number as $x,$ we have that \n\\[\n\\forall \\, x \\in \\mathbb{Q}.\n\\]</p>\n</li></p>\n<p><li><p>Finally, the condition in the statement can be written as \n\\[\nx^3  \\in \\mathbb{Q}.\n\\]</p>\n</li>\n</ul></p>\n<p><p>Therefore, we write the statement as follows: </p></p>\n<blockquote>\n<p>$\\forall \\, x  \\in \\mathbb{Q}, \\, x^3  \\in \\mathbb{Q}.$</p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12753,"title":"Expressing a Plain English Sentence as a Formal Statement"},"group":{"id":24158,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62321873,"cread":"2026-10-16T05:12:56.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":11457},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}}]},{"id":12752,"number":2,"title":"Expressing a Plain English Sentence With Two Quantifiers as a Formal Statement","answers":[{"id":62321896,"created":"2026-10-16T05:13:21.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":17819,"number":6,"createdStr":"Fri, Oct 16th @ 5:13 AM","timeElapsedFormatted":"0:18","question":{"id":172009,"format":"MC","difficulty":2,"exampleId":12752,"text":"<blockquote>\n<p>The product of any two integers is divisible by those two integers.</p>\n</blockquote>\n<p>Express the statement above in formal language.</p>\n","choice1":"$\\forall\\, a,b \\in \\mathbb{Z}, \\, (a \\mid ab) \\land \\: (b \\mid ab)$","choice2":"$\\exists\\, a,b \\in \\mathbb{Z}, \\, (a \\mid ab) \\land \\: (b \\mid ab)$","choice3":"$\\forall\\, \\mathbb{Z}, \\, (a \\mid ab) \\land \\: (b \\mid ab)$","choice4":"$\\forall\\, a,b \\in \\mathbb{Z}, \\, (ab \\mid a) \\land \\: (ab \\mid b)$","choice5":"$\\exists\\, a,b \\in \\mathbb{Z}, \\, (ab \\mid a) \\land \\: (ab \\mid b)$","freeAnswerChoice":" ","explanation":"<p><p>Let&#39;s examine our statement:</p></p>\n<p><ul></p>\n<p><li><p>The word &quot;any&quot; indicates that we use a universal quantifier, $\\forall.$</p>\n</li></p>\n<p><li><p>The sentence refers to two integers. So, by denoting our numbers as $a$ and $b,$ we have\n\\[\n\\forall\\, a,b \\in \\mathbb{Z}.\n\\]</p>\n</li></p>\n<p><li><p>Finally, the condition in the statement can be written as follows:\n\\[\n(a \\mid ab) \\: \\land \\: (b \\mid ab)\n\\]</p>\n</li>\n</ul></p>\n<p><p>Therefore, we write the statement as follows:</p></p>\n<blockquote>\n<p>$\\forall a,b \\in \\mathbb{Z}, \\, (a \\mid ab) \\: \\land \\: (b \\mid ab)$</p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12752,"title":"Expressing a Plain English Sentence With Two Quantifiers as a Formal Statement"},"group":{"id":25461,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62321896,"cread":"2026-10-16T05:13:21.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":17819},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}},{"id":62321916,"created":"2026-10-16T05:13:41.000Z","choices":null,"correct":0,"selectedChoice":2,"freeResponse":null,"timeElapsed":16333,"number":7,"createdStr":"Fri, Oct 16th @ 5:13 AM","timeElapsedFormatted":"0:16","question":{"id":183715,"format":"MC","difficulty":2,"exampleId":12752,"text":"<blockquote>\n<p>There exists an integer number such that, for any rational number, the product of both numbers is the second number.</p>\n</blockquote>\n<p>Express the statement above in formal language.</p>\n","choice1":"$\\exists \\, k \\in \\mathbb{Z}, \\, \\forall \\, q \\in \\mathbb{Q}, \\, kq = q$","choice2":"$\\exists \\, k \\in \\mathbb{Z}, \\, \\exists \\, q \\in \\mathbb{Q}, \\, kq = q$","choice3":"$\\forall \\, k \\in \\mathbb{Z}, \\, \\exists \\, q \\in \\mathbb{Q}, \\, kq = k$","choice4":"$\\forall \\, q \\in \\mathbb{Q}, \\, \\exists \\, k \\in \\mathbb{Z}, \\, kq = q$","choice5":"$\\exists \\, q \\in \\mathbb{Q}, \\, \\forall \\, k \\in \\mathbb{Z}, \\, kq = k$","freeAnswerChoice":" ","explanation":"<p><p>Let&#39;s examine our statement:</p></p>\n<p><ul></p>\n<p><li><p>The words &quot;there exists&quot; indicate that we use an existential quantifier, $\\exists.$</p>\n</li></p>\n<p><li><p>The word &quot;any&quot; indicates that we use a universal quantifier, $\\forall.$ </p>\n</li></p>\n<p><li><p>The sentence refers to integers and rational numbers. So, by denoting our numbers as $k$ and $q,$ respectively, we have\n\\[\n\\exists \\, k \\in \\mathbb{Z}, \\, \\forall \\, q \\in \\mathbb{Q}.\n\\]</p>\n</li></p>\n<p><li><p>Finally, the condition in the statement can be written as follows:\n\\[\nkq = q\n\\]</p>\n</li>\n</ul></p>\n<p><p>Therefore, we write the statement as follows:</p></p>\n<blockquote>\n<p>$\\exists \\, k \\in \\mathbb{Z}, \\, \\forall \\, q \\in \\mathbb{Q}, \\, kq = q$</p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12752,"title":"Expressing a Plain English Sentence With Two Quantifiers as a Formal Statement"},"group":{"id":25463,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62321916,"cread":"2026-10-16T05:13:41.000Z","choices":null,"correct":0,"selectedChoice":2,"freeResponse":null,"timeElapsed":16333},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}},{"id":62321930,"created":"2026-10-16T05:13:59.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":14083,"number":8,"createdStr":"Fri, Oct 16th @ 5:13 AM","timeElapsedFormatted":"0:14","question":{"id":183717,"format":"MC","difficulty":2,"exampleId":12752,"text":"<blockquote>\n<p>There is a real number such that, raised to any integer, the result is a rational number.</p>\n</blockquote>\n<p>Express the statement above in formal language.</p>\n","choice1":"$\\exists \\, x \\in \\mathbb{R}, \\, \\forall \\, k \\in \\mathbb{Z}, \\, x^k \\in \\mathbb{Q}$","choice2":"$\\forall \\, x \\in \\mathbb{R}, \\, \\exists \\, k \\in \\mathbb{Z}, \\, x^k \\in \\mathbb{Q}$","choice3":"$\\forall \\, k \\in \\mathbb{Z} , \\, \\exists \\, x \\in \\mathbb{R}, \\, x^k \\in \\mathbb{Q}$","choice4":"$\\exists \\, k \\in \\mathbb{Z} , \\, \\forall \\, x \\in \\mathbb{R}, \\, x^k \\in \\mathbb{Q}$","choice5":"$\\exists \\, x \\in \\mathbb{R}, \\, \\exists \\, k \\in \\mathbb{Z}, \\, x^k \\in \\mathbb{Q}$","freeAnswerChoice":" ","explanation":"<p><p>Let&#39;s examine our statement:</p></p>\n<p><ul></p>\n<p><li><p>The words &quot;there exists&quot; indicate that we use an existential quantifier, $\\exists.$</p>\n</li></p>\n<p><li><p>The word &quot;any&quot; indicates that we use a universal quantifier, $\\forall.$ </p>\n</li></p>\n<p><li><p>The sentence refers to real numbers and integers. So, by denoting our numbers as $x$ and $k,$ respectively, we have\n\\[\n\\exists \\, x \\in \\mathbb{R}, \\, \\forall \\, k \\in \\mathbb{Z}.\n\\]</p>\n</li></p>\n<p><li><p>Finally, the condition in the statement can be written as follows:\n\\[\nx^k \\in \\mathbb{Q}\n\\]</p>\n</li>\n</ul></p>\n<p><p>Therefore, we write the statement as follows:</p></p>\n<blockquote>\n<p>$\\exists \\, x \\in \\mathbb{R}, \\, \\forall \\, k \\in \\mathbb{Z}, \\, x^k \\in \\mathbb{Q}$</p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12752,"title":"Expressing a Plain English Sentence With Two Quantifiers as a Formal Statement"},"group":{"id":25463,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62321930,"cread":"2026-10-16T05:13:59.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":14083},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}},{"id":62321942,"created":"2026-10-16T05:14:15.000Z","choices":null,"correct":0,"selectedChoice":5,"freeResponse":null,"timeElapsed":12572,"number":9,"createdStr":"Fri, Oct 16th @ 5:14 AM","timeElapsedFormatted":"0:13","question":{"id":172010,"format":"MC","difficulty":2,"exampleId":12752,"text":"<blockquote>\n<p>If the product of any two integers is divisible by $5$, then $5$ divides one of the two numbers.</p>\n</blockquote>\n<p>Express the statement above in formal language.</p>\n","choice1":"$\\forall \\,a,b\\in\\mathbb{Z}, (5 \\mid ab) \\Rightarrow (5\\mid a \\lor 5\\mid b)$ ","choice2":"$\\forall \\, a,b \\in\\mathbb{Z}, (5 \\mid a) \\lor (5 \\mid b)$","choice3":"$\\forall \\, a,b\\in\\mathbb{Z}, (5 \\mid a) \\Rightarrow (5 \\mid ab)$ ","choice4":"$\\exists \\, a,b\\in\\mathbb{Z}, (5 \\mid ab) \\Rightarrow (5\\mid a \\lor 5\\mid b)$ ","choice5":"$\\exists \\, a,b\\in\\mathbb{Z}, (5 \\mid a) \\Rightarrow (5 \\mid ab)$ ","freeAnswerChoice":" ","explanation":"<p><p>Let&#39;s examine our statement:</p></p>\n<p><ul></p>\n<p><li><p>The word &quot;any&quot; indicates that we use a universal quantifier, $\\forall.$</p>\n</li></p>\n<p><li><p>The sentence refers to two integers. So, by denoting our numbers as $a$ and $b,$ we have\n\\[\n\\forall \\,a,b\\in\\mathbb{Z}.\n\\]</p>\n</li></p>\n<p><li><p>Finally, the condition in the statement can be written as follows:\n\\[\n(5 \\mid ab) \\Rightarrow (5\\mid a \\lor 5\\mid b)\n\\]</p>\n</li>\n</ul></p>\n<p><p>Therefore, we write the statement as follows:</p></p>\n<blockquote>\n<p>$\\forall \\, a,b\\in\\mathbb{Z}, (5 \\mid ab) \\Rightarrow (5\\mid a \\lor 5\\mid b)$</p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12752,"title":"Expressing a Plain English Sentence With Two Quantifiers as a Formal Statement"},"group":{"id":25461,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62321942,"cread":"2026-10-16T05:14:15.000Z","choices":null,"correct":0,"selectedChoice":5,"freeResponse":null,"timeElapsed":12572},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}},{"id":62321963,"created":"2026-10-16T05:14:32.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":12384,"number":10,"createdStr":"Fri, Oct 16th @ 5:14 AM","timeElapsedFormatted":"0:12","question":{"id":172015,"format":"MC","difficulty":2,"exampleId":12752,"text":"<blockquote>\n<p>There is some pair of real numbers such that the difference of their squares is equal to double their sum.</p>\n</blockquote>\n<p>Express the statement above in formal language.</p>\n","choice1":"$\\exists \\, x,y \\in \\mathbb{R},\\, x^2-y^2 = 2(x+y)$","choice2":"$\\forall \\, x,y \\in \\mathbb{R},\\, x^2-y^2 = 2(x+y)$","choice3":"$\\exists \\, x,y \\in \\mathbb{R},\\,  x^2+y^2 = 2xy$","choice4":"$\\forall \\, x,y \\in \\mathbb{Z},\\, x^2+y^2 = 2xy$","choice5":"$\\exists \\, x,y \\in \\mathbb{Z},\\,  x^2-y^2 = 2(x+y)$","freeAnswerChoice":" ","explanation":"<p><p>Let&#39;s examine our statement:</p></p>\n<p><ul></p>\n<p><li><p>The words &quot;there is&quot; indicate that we use an existential quantifier, $\\exists.$</p>\n</li></p>\n<p><li><p>The sentence refers to two real numbers. So, by denoting our numbers as $x$ and $y,$ we have\n\\[\n\\exists \\, x,y \\in \\mathbb{R}.\n\\]</p>\n</li></p>\n<p><li><p>Finally, the condition in the statement can be written as follows:\n\\[\n x^2-y^2 = 2(x+y)\n\\]</p>\n</li>\n</ul></p>\n<p><p>Therefore, we write the statement as follows:</p></p>\n<blockquote>\n<p>$\\exists \\, x,y \\in \\mathbb{R},\\, x^2-y^2 = 2(x+y)$</p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12752,"title":"Expressing a Plain English Sentence With Two Quantifiers as a Formal Statement"},"group":{"id":25464,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62321963,"cread":"2026-10-16T05:14:32.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":12384},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}}]},{"id":12751,"number":3,"title":"Identifying Implicit Quantification","answers":[{"id":62321990,"created":"2026-10-16T05:14:59.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":15551,"number":11,"createdStr":"Fri, Oct 16th @ 5:14 AM","timeElapsedFormatted":"0:16","question":{"id":183556,"format":"MC","difficulty":2,"exampleId":12751,"text":"<blockquote>\n<p>$512$ is a power of base $2.$</p>\n</blockquote>\n<p>Express the statement above in formal language.</p>\n","choice1":"$\\exists \\, k \\in \\mathbb{Z}, \\, 2^k = 512$","choice2":"$\\forall \\, k \\in \\mathbb{Z}, \\, 2^k = 512$ ","choice3":"$\\exists \\, k \\in \\mathbb{Z}, \\, k = 512^2$ ","choice4":"$\\forall \\, k \\in \\mathbb{Z}, \\, k = \\sqrt{512}$ ","choice5":"$\\exists \\, k \\in \\mathbb{Z}, \\, k^2 = 512$ ","freeAnswerChoice":" ","explanation":"<p><p>Recall that &quot;$512$ is a power of base $2$&quot; means the following:</p></p>\n<blockquote>\n<p>There exists an integer $k$ such that $2^k = 512.$</p>\n</blockquote>\n<p>More formally, this reads as follows:</p>\n<blockquote>\n<p>$\\exists \\, k \\in \\mathbb{Z}, \\, 2^k = 512$</p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12751,"title":"Identifying Implicit Quantification"},"group":{"id":25450,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62321990,"cread":"2026-10-16T05:14:59.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":15551},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}},{"id":62322009,"created":"2026-10-16T05:15:17.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":14944,"number":12,"createdStr":"Fri, Oct 16th @ 5:15 AM","timeElapsedFormatted":"0:15","question":{"id":183560,"format":"MC","difficulty":3,"exampleId":12751,"text":"<blockquote>\n<p>The square of a number is a non-negative number.</p>\n</blockquote>\n<p>Express the above in formal language.</p>\n","choice1":"$\\forall \\, x \\in \\mathbb{R}, \\, \\exists \\, y \\in \\mathbb{R}_0^{+}, \\, x^2 = y$","choice2":"$\\exists \\, x \\in \\mathbb{R}, \\, \\forall \\, y \\in \\mathbb{R}_0^{+}, \\, x^2 = y$ ","choice3":"$\\forall \\, x \\in \\mathbb{R}, \\, \\exists \\, y \\in \\mathbb{R}_0^{+}, \\, x = y^2$ ","choice4":"$\\exists \\, x \\in \\mathbb{R}, \\, \\forall \\, y \\in \\mathbb{R}_0^{+}, \\, x = y^2$  ","choice5":"$\\forall \\, x \\in \\mathbb{R}, \\, \\forall \\, y \\in \\mathbb{R}_0^{+}, \\, x^2 = y$ ","freeAnswerChoice":" ","explanation":"<p><p>Notice that our sentence can be re-phrased as </p></p>\n<blockquote>\n<p>For any real number $x,$ we have that $x^2$ is a non-negative number.</p>\n</blockquote>\n<p>Now, &quot;$x^2$ is a non-negative number&quot; means that</p>\n<blockquote>\n<p>There exists a non-negative number $y$ such that $x^2 = y.$</p>\n</blockquote>\n<p>Therefore, we get the following statement:</p>\n<blockquote>\n<p>For any real number $x,$ there exists a non-negative number $y$ such that $x^2 = y.$</p>\n</blockquote>\n<p>More formally, this reads as</p>\n<blockquote>\n<p>$\\forall \\, x \\in \\mathbb{R}, \\, \\exists \\, y \\in \\mathbb{R}_0^{+}, \\, x^2 = y.$  </p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12751,"title":"Identifying Implicit Quantification"},"group":{"id":25458,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62322009,"cread":"2026-10-16T05:15:17.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":14944},"graphic":false,"difficultyClass":"difficultyHard","difficultySymbol":"H","rendered":true,"testMode":false}},{"id":62322021,"created":"2026-10-16T05:15:36.000Z","choices":null,"correct":0,"selectedChoice":5,"freeResponse":null,"timeElapsed":14954,"number":13,"createdStr":"Fri, Oct 16th @ 5:15 AM","timeElapsedFormatted":"0:15","question":{"id":172161,"format":"MC","difficulty":2,"exampleId":12751,"text":"<blockquote>\n<p>$25$ is a perfect square.</p>\n</blockquote>\n<p>Express the statement above in formal language.</p>\n","choice1":"$\\exists \\, n \\in \\mathbb{Z}, \\, n^2=25$","choice2":"$\\forall \\, n \\in \\mathbb{Z}, \\, n^2=25$","choice3":"$\\exists \\, n \\in \\mathbb{Z}, \\, n=25^2$","choice4":"$\\forall \\, n \\in \\mathbb{Z}, \\,  n=25^2$","choice5":"$\\exists \\, n \\in \\mathbb{Z}, \\, n^2=5$","freeAnswerChoice":" ","explanation":"<p><p>Recall that &quot;$25$ is a perfect square&quot; means the following:</p></p>\n<blockquote>\n<p>There exists an integer $n$ such that $n^2=25.$</p>\n</blockquote>\n<p>More formally, this reads as follows:</p>\n<blockquote>\n<p>$\\exists \\, n \\in \\mathbb{Z}, \\, n^2=25$  </p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12751,"title":"Identifying Implicit Quantification"},"group":{"id":25450,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62322021,"cread":"2026-10-16T05:15:36.000Z","choices":null,"correct":0,"selectedChoice":5,"freeResponse":null,"timeElapsed":14954},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}},{"id":62322037,"created":"2026-10-16T05:15:57.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":17433,"number":14,"createdStr":"Fri, Oct 16th @ 5:15 AM","timeElapsedFormatted":"0:17","question":{"id":183553,"format":"MC","difficulty":1,"exampleId":12751,"text":"<blockquote>\n<p>If $n^2$ is odd, then $n$ is odd.</p>\n</blockquote>\n<p>Express the statement above in formal language, given that $n$ is a natural number.</p>\n","choice1":"$\\forall \\, n \\in \\mathbb{N}, \\,$ ($n^2$ is odd) $\\Rightarrow$ ($n$ is odd)","choice2":"$\\forall \\, n \\in \\mathbb{N}, \\,$ ($n^2$ is odd) $\\Leftrightarrow$ ($n$ is odd) ","choice3":"$\\forall \\, n \\in \\mathbb{N}, \\,$ ($n^2$ is odd) $\\land$ ($n$ is odd) ","choice4":"$\\exists \\, n \\in \\mathbb{N}, \\,$ ($n^2$ is odd) $\\land$ ($n$ is odd) ","choice5":"$\\exists \\, n \\in \\mathbb{N}, \\,$ ($n^2$ is odd) $\\Rightarrow$ ($n$ is odd) ","freeAnswerChoice":" ","explanation":"<p><p>Let&#39;s denote:</p></p>\n<p><ul></p>\n<p><li><p>$P(n):$ $n^2$ is odd</p>\n</li></p>\n<p><li><p>$Q(n):$ $n$ is odd</p>\n</li>\n</ul></p>\n<p><p>Then, the given sentence has the following logical structure:\n\\[\nP(n) \\Rightarrow Q(n)\n\\]</p></p>\n<p><p>This, in turn, is equivalent to \n\\[\n\\forall \\, n \\in U, \\, P(n) \\Rightarrow Q(n)\n\\]\nwhere the universal set $U$ is usually apparent from the context. In this case, $n \\in \\mathbb{N}.$</p></p>\n<p><p>Therefore, using formal language, our statement reads </p></p>\n<blockquote>\n<p>For all natural number $n,$ if $n^2$ is odd, then $n$ is odd.</p>\n</blockquote>\n<p>Or, more formally:</p>\n<blockquote>\n<p>$\\forall \\, n \\in \\mathbb{N}, \\,$ ($n^2$ is odd) $\\Rightarrow$ ($n$ is odd)  </p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12751,"title":"Identifying Implicit Quantification"},"group":{"id":24156,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62322037,"cread":"2026-10-16T05:15:57.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":17433},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62322064,"created":"2026-10-16T05:16:18.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":16137,"number":15,"createdStr":"Fri, Oct 16th @ 5:16 AM","timeElapsedFormatted":"0:16","question":{"id":183567,"format":"MC","difficulty":3,"exampleId":12751,"text":"<blockquote>\n<p>There is a rational number whose natural powers are all less than or equal to that number.</p>\n</blockquote>\n<p>Express the above in formal language.</p>\n","choice1":"$\\exists \\, q \\in \\mathbb{Q}, \\, \\forall \\, n \\in \\mathbb{N}, \\, q^n \\leq q$","choice2":"$\\forall \\, q \\in \\mathbb{Q}, \\, \\exists \\, n \\in \\mathbb{N}, \\, q^n \\leq q$ ","choice3":"$\\exists \\, q \\in \\mathbb{Q}, \\, \\forall \\, n \\in \\mathbb{N}, \\, q \\leq q^n$ ","choice4":"$\\exists \\, q \\in \\mathbb{Q}, \\, \\forall \\, n \\in \\mathbb{N}, \\, nq \\leq q$  ","choice5":"$\\forall \\, q \\in \\mathbb{Q}, \\, \\exists \\, n \\in \\mathbb{N}, \\, q \\leq q^n$  ","freeAnswerChoice":" ","explanation":"<p><p>Notice that our sentence can be re-phrased as </p></p>\n<blockquote>\n<p>There exists a rational number $q$ whose natural powers are all less than or equal to $q.$</p>\n</blockquote>\n<p>Now, &quot;the natural powers of $q$ are all less than or equal to $q$&quot; means that</p>\n<blockquote>\n<p>For any natural number $n,$ we have that $q^n \\leq q.$</p>\n</blockquote>\n<p>Therefore, we get the following statement:</p>\n<blockquote>\n<p>There exists a rational number $q$ such that for any natural number $n$ we have that $q^n \\leq q.$</p>\n</blockquote>\n<p>More formally, this reads as</p>\n<blockquote>\n<p>$\\exists \\, q \\in \\mathbb{Q}, \\, \\forall \\, n \\in \\mathbb{N}, \\, q^n \\leq q.$  </p>\n</blockquote>\n","topic":{"id":2798,"name":"Formal and Informal Language"},"example":{"id":12751,"title":"Identifying Implicit Quantification"},"group":{"id":26331,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14254548,"answer":{"id":62322064,"cread":"2026-10-16T05:16:18.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":16137},"graphic":false,"difficultyClass":"difficultyHard","difficultySymbol":"H","rendered":true,"testMode":false}}]}],"localGraph":{"topicId":2798,"topics":[{"id":2627,"name":"Surjections","prerequisites":[2798],"frontier":1,"halfLife":0.1,"repetition":0,"stability":0},{"id":2678,"name":"Injections","prerequisites":[2798],"frontier":1,"halfLife":0.1,"repetition":0,"stability":0},{"id":2791,"name":"Negating Quantified Statements","prerequisites":[2798],"frontier":1,"halfLife":0.1,"repetition":0,"stability":0},{"id":2792,"name":"Nested Quantifiers","prerequisites":[],"frontier":0,"halfLife":0.1398983348046566,"repetition":1,"stability":0.051529080952425886},{"id":2798,"name":"Formal and Informal Language","prerequisites":[2792],"frontier":0,"halfLife":0.38981644477728006,"repetition":1,"stability":0.10613348546019291},{"id":2815,"name":"Trivial and Vacuous Proofs","prerequisites":[2798],"frontier":1,"halfLife":0.1,"repetition":0,"stability":0},{"id":3411,"name":"Parity","prerequisites":[2798],"frontier":1,"halfLife":0.1,"repetition":0,"stability":0},{"id":4342,"name":"The Limit of a Null Sequence","prerequisites":[2798],"frontier":1,"halfLife":0.1,"repetition":0,"stability":0},{"id":4344,"name":"Infinite Limits of Sequences","prerequisites":[2798],"fr