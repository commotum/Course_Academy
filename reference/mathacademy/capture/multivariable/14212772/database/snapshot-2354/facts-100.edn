db/ref 17592186045417] [17592186446477 #edb/ref 1079 #uuid "e8f37801-7fba-5407-99f3-56966d38068b" #edb/ref 17592186045417] [17592186446478 #edb/ref 1075 #edb/ref 17592186446421 #edb/ref 17592186045417] [17592186446478 #edb/ref 1075 #edb/ref 17592186446422 #edb/ref 17592186045417] [17592186446478 #edb/ref 1075 #edb/ref 17592186446430 #edb/ref 17592186045417] [17592186446478 #edb/ref 1075 #edb/ref 17592186446445 #edb/ref 17592186045417] [17592186446478 #edb/ref 1075 #edb/ref 17592186446452 #edb/ref 17592186045417] [17592186446478 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186446478 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186446478 #edb/ref 1078 #edb/ref 17592186446422 #edb/ref 17592186045417] [17592186446478 #edb/ref 1079 #uuid "f768c06e-68ed-5c8a-96fe-b36cf58285fb" #edb/ref 17592186045417] [17592186446479 #edb/ref 1068 #edb/ref 17592186446471 #edb/ref 17592186045417] [17592186446479 #edb/ref 1069 "q-83434" #edb/ref 17592186045417] [17592186446479 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186446479 #edb/ref 1071 "Find the global extrema of the function $f(x,y)=2{x}^{2}+{y}^{2}-4x+2$ on the closed region $D=\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 4\\}.$ You are given that the function has a critical point at $(1,0)\\in D.$" #edb/ref 17592186045417] [17592186446479 #edb/ref 1072 #uuid "004a7cc4-06c2-5abf-9f5d-0dfb86998289" #edb/ref 17592186045417] [17592186446479 #edb/ref 1074 "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\nTo find the extreme values, we follow three steps.\n\n**Step 1.** Find the critical points of $f$ that lie inside the region $D.$ \n\nWe have been given that $f$ has a critical point at \n\n$\\,$ $(1,0)$ \n\nwhich belongs to the interior of the region $D.$ So, we include this point in the list of candidates for the extrema. \n\n**Step 2.**  Find the points on the boundary of $D$ that could give rise to extreme values. \n\nTo find the boundary points that could give rise to extreme values, we parametrize the bounding circle ${x}^{2}+{y}^{2}=4.$ This gives\n\n$$\nr=⟨2\\operatorname{cos}⁡t,2\\operatorname{sin}⁡t⟩,\\,t\\in [0,2\\pi ).\n$$\n\nThe values of $f$ on the boundary are given by the function\n\n$$\n\\begin{aligned}F(t) & =f(x(t),y(t)) \\\\  & =f(2\\operatorname{cos}⁡t,2\\operatorname{sin}⁡t) \\\\  & =2(2\\operatorname{cos}⁡t)^{2}+(2\\operatorname{sin}⁡t)^{2}-4(2\\operatorname{cos}⁡t)+2 \\\\  & =4{cos}^{2}⁡t+4({cos}^{2}⁡t+{sin}^{2}⁡t)-8\\operatorname{cos}⁡t+2 \\\\  & =4{cos}^{2}⁡t-8\\operatorname{cos}⁡t+6.\\end{aligned}\n$$\n\nTo find the critical points of $F(t)$ on the open interval $t\\in (0,2\\pi ),$ we solve the following equation:\n\n$$\n\\begin{aligned}{F}^{′}(t) & =0 \\\\ (4{cos}^{2}⁡t-8\\operatorname{cos}⁡t+6)^{′} & =0 \\\\ -8\\operatorname{cos}⁡t\\operatorname{sin}⁡t+8\\operatorname{sin}⁡t & =0 \\\\ 8\\operatorname{sin}⁡t(1-\\operatorname{cos}⁡t) & =0\\end{aligned}\n$$\n\nThis equation gives the solution $t=\\pi \\in (0,2\\pi ).$\nWe also have to check the endpoint of the interval $t=0.$ Therefore, the only values of $t$ that can possibly give rise to extreme values are $t=0,\\,\\pi .$ Evaluating the corresponding values of $x$ and $y$ on the boundary, we obtain two candidate points:\n\n$$\n(2,0),\\,(-2,0)\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values.\n\nLet's compare the values of $f(x,y)$ evaluated at each of the points mentioned above. \n\n$$\n\\begin{aligned}f(1,0) & =2(1)^{2}+(0)^{2}-4(1)+2 \\\\  & =2+0-4+2 \\\\  & =0 \\\\ f(-2,0) & =2(-2)^{2}+(0)^{2}-4(-2)+2 \\\\  & =8+0+8+2 \\\\  & =18 \\\\ f(2,0) & =2(2)^{2}+(0)^{2}-4(2)+2 \\\\  & =8+0-8+2 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $0$ at the point $(1,0),$ and\n\n- $f$ attains the global maximum of $18$ at the point $(-2,0).$" #edb/ref 17592186045417] [17592186446484 #edb/ref 1068 #edb/ref 17592186446474 #edb/ref 17592186045417] [17592186446484 #edb/ref 1069 "q-83423" #edb/ref 17592186045417] [17592186446484 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186446484 #edb/ref 1071 "Find the global minimum of the function $f(x,y)=xy-x-y$ on the closed square $D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le 2\\}.$ You're given that $f$ has a critical point at $(1,1)$ and on the boundary of the square the points that could give rise to extreme values are the vertices." #edb/ref 17592186045417] [17592186446484 #edb/ref 1072 #uuid "8052460c-148b-5893-b35a-1e1c771c0935" #edb/ref 17592186045417] [17592186446484 #edb/ref 1074 "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\nTo find the extreme values, we follow three steps.\n\n**Step 1.** Find the critical points of $f$ that lie inside the region $D.$ \n\nTo determine the critical points, let's first sketch the region:\n\n![](images/7f/7fe1aa21de9b6354e561eb1e82f6c83b25c71770470dc8501e6b491e35e2c391.png)\n\n \n\nSince the point $(1,1)$ is in the interior of $D$, we include it in the list of candidates for extrema.\n\n**Step 2.** Find the points on the boundary that could give rise to extreme values. \n\nIn this case, we are *given* the points on the boundary of our region that could potentially be global extrema for $f.$ These are\n\n$$\n(0,0),\\,(2,0),\\,(2,2),\\,(0,2).\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following: \n\n$$\n\\begin{aligned}f(1,1) & =(1)(1)-1-1 \\\\  & =-1 \\\\ f(0,0) & =(0)(0)-0-0 \\\\  & =0 \\\\ f(2,0) & =(2)(0)-2-0 \\\\  & =-2 \\\\ f(2,2) & =(2)(2)-2-2 \\\\  & =0 \\\\ f(0,2) & =(0)(2)-0-2 \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $-2$ at the points $(2,0)$and $(0,2),$\n\n- $f$ attains the global maximum of $0$ at the points $(0,0)$ and $(2,2).$" #edb/ref 17592186045417] [17592186446485 #edb/ref 1068 #edb/ref 17592186446470 #edb/ref 17592186045417] [17592186446485 #edb/ref 1069 "q-167161" #edb/ref 17592186045417] [17592186446485 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186446485 #edb/ref 1071 "Find the global extrema of the function $f(x,y)=x{e}^{x}+{y}^{2}$ on the closed region  $D=\\{(x,y):{x}^{2}+{y}^{2}\\le 16\\}.$ You are given that $f$ has a critical point at  $(-1,0)$ and on the boundary of the region the points that could give rise to extreme values are  $(-4,0)$, and $(4,0).$" #edb/ref 17592186045417] [17592186446485 #edb/ref 1072 #uuid "8bdc5f30-6e9d-55a3-aacc-08dbc13064bd" #edb/ref 17592186045417] [17592186446485 #edb/ref 1074 "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$ \n\n**Step 1.** Find the critical points inside the region $D.$ \n\nTo determine the critical points, let's first sketch the region:\n\n![](images/dc/dc5a440d527fcf7583c4a341f08f2c6b5f6b4c1dc87b75286ea0a7f569d6babe.png)\n\nSince the critical point $(-1,0)$ lies inside $D,$ we include that point in the list of candidates for the extrema. \n\n**Step 2.** Find the points on the boundary that could give rise to extreme values.\n\nIn this case, we are *given* the points on the boundary of our region that could potentially be global extrema for $f.$ These are\n\n$$\n(-4,0),\\,(4,0).\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following:  \n\n$$\n\\begin{aligned}f(-4,0) & =-4{e}^{-4}+{0}^{2} \\\\  & =-\\frac{4}{{e}^{4}} \\\\ f(4,0) & =4{e}^{4}+{0}^{2} \\\\  & =4{e}^{4} \\\\ f(-1,0) & =-{e}^{-1}+{0}^{2} \\\\  & =-\\frac{1}{e}\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $-\\frac{1}{e}$ at the point $(-1,0),$ and\n\n- $f$ attains the global maximum of $4{e}^{4}$ at the point $(4,0).$" #edb/ref 17592186045417] [17592186446487 #edb/ref 1068 #edb/ref 17592186446473 #edb/ref 17592186045417] [17592186446487 #edb/ref 1069 "q-83437" #edb/ref 17592186045417] [17592186446487 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186446487 #edb/ref 1071 "Find the global extrema of the function $f(x,y)={x}^{2}+y$ on the closed region $D=\\{(x,y)\\,:\\,4{x}^{2}+{y}^{2}\\le 1\\}.$ You are given that the function has no critical points." #edb/ref 17592186045417] [17592186446487 #edb/ref 1072 #uuid "a2f4f1da-3ab7-5268-ad0e-cfd1ed45e614" #edb/ref 17592186045417] [17592186446487 #edb/ref 1074 "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\nTo find the extreme values, we follow three steps.\n\n**Step 1.** Find the critical points of $f$ that lie inside the region $D.$ \n\nSince f has no critical points in D , the list of candidates for the extrema won't contain critical points.\n\n**Step 2.**  Find the points on the boundary of $D$ that could give rise to extreme values. \n\nTo find the boundary points that could give rise to extreme values, we parametrize the bounding circle $4{x}^{2}+{y}^{2}=1.$ This gives\n\n$$\nr=⟨\\frac{\\operatorname{cos}⁡t}{2},\\,\\operatorname{sin}⁡t⟩,\\,t\\in [0,2\\pi ).\n$$\n\nThe values of $f$ on the boundary are given by the function \n\n$$\n\\begin{aligned}F(t) & =f(x(t),y(t)) \\\\  & =f(\\frac{\\operatorname{cos}⁡t}{2},\\,\\operatorname{sin}⁡t) \\\\  & =\\frac{{cos}^{2}⁡t}{4}+\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nTo find the critical points of $F(t)$ on the open interval $t\\in (0,2\\pi ),$ we solve the following equation:\n\n$$\n\\begin{aligned}{F}^{′}(t) & =0 \\\\ (\\frac{{cos}^{2}⁡t}{4}+\\operatorname{sin}⁡t)^{′} & =0 \\\\ \\frac{-\\operatorname{cos}⁡t\\operatorname{sin}⁡t}{2}+\\operatorname{cos}⁡t & =0 \\\\ \\operatorname{cos}⁡t(2-\\operatorname{sin}⁡t) & =0\\end{aligned}\n$$\n\nSince $|\\operatorname{sin}⁡t|\\le 1$, this equation gives the solutions $t=\\frac{\\pi }{2},\\,\\frac{3\\pi }{2}\\in (0,2\\pi ).$\nWe also have to check the endpoint of the interval,  $t=0.$ Therefore, the only values of $t$ that can possibly give rise to extreme values are $t=0,\\,\\frac{\\pi }{2},\\,$ and $\\,\\frac{3\\pi }{2}.$ Evaluating the corresponding values of $x$ and $y$ on the boundary, we obtain candidate points: \n\n$$\n(\\frac{1}{2},0),\\,(0,1),\\,(0,-1)\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values.\n\nLet's compare the values of $f(x,y)$ evaluated at each of the points mentioned above. \n\n$$\n\\begin{aligned}f(\\frac{1}{2},0) & ={(\\frac{1}{2})}^{2}+0 \\\\  & =\\frac{1}{4} \\\\ f(0,1) & ={0}^{2}+1 \\\\  & =1 \\\\ f(0,-1) & ={0}^{2}+(-1) \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $-1$ at the point $(0,-1),$ and\n\n- $f$ attains the global maximum of $1$ at the point $(0,1).$" #edb/ref 17592186045417] [17592186483555 #edb/ref 1043 #edb/ref 17592186484299 #edb/ref 17592186045417] [17592186483555 #edb/ref 1043 #edb/ref 17592186484306 #edb/ref 17592186045417] [17592186483555 #edb/ref 1043 #edb/ref 17592186484315 #edb/ref 17592186045417] [17592186483555 #edb/ref 1043 #edb/ref 17592186484340 #edb/ref 17592186045417] [17592186483555 #edb/ref 1043 #edb/ref 17592186484346 #edb/ref 17592186045417] [17592186483555 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186483555 #edb/ref 1045 "Calculating Global Extrema of Multivariable Functions" #edb/ref 17592186045417] [17592186483555 #edb/ref 1046 #edb/ref 17592186484306 #edb/ref 17592186045417] [17592186483555 #edb/ref 1048 #edb/ref 17592186046660 #edb/ref 17592186045417] [17592186483555 #edb/ref 1049 #edb/ref 17592186048450 #edb/ref 17592186045417] [17592186483555 #edb/ref 1053 #uuid "014bb5c2-0eb1-526