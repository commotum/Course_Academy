s}⁡2t\\end{aligned}]" #edb/ref 17592186045417] [17592186307108 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186307108 #edb/ref 1083 #uuid "d321f46a-76a7-5be1-b689-e83b8deece3d" #edb/ref 17592186045417] [17592186307378 #edb/ref 1080 "\\operatorname{cos}(2t)" #edb/ref 17592186045417] [17592186307378 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186307378 #edb/ref 1083 #uuid "f1d6721b-ff98-5c3e-ad88-04c1ddec1e8a" #edb/ref 17592186045417] [17592186307527 #edb/ref 1075 #edb/ref 17592186305731 #edb/ref 17592186045417] [17592186307527 #edb/ref 1075 #edb/ref 17592186305834 #edb/ref 17592186045417] [17592186307527 #edb/ref 1075 #edb/ref 17592186306167 #edb/ref 17592186045417] [17592186307527 #edb/ref 1075 #edb/ref 17592186307079 #edb/ref 17592186045417] [17592186307527 #edb/ref 1075 #edb/ref 17592186307108 #edb/ref 17592186045417] [17592186307527 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186307527 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186307527 #edb/ref 1078 #edb/ref 17592186305731 #edb/ref 17592186045417] [17592186307527 #edb/ref 1079 #uuid "034e9426-2cb9-545f-a8bf-8151560f1dcb" #edb/ref 17592186045417] [17592186307700 #edb/ref 1075 #edb/ref 17592186305212 #edb/ref 17592186045417] [17592186307700 #edb/ref 1075 #edb/ref 17592186442492 #edb/ref 17592186045417] [17592186307700 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186307700 #edb/ref 1077 "field-4" #edb/ref 17592186045417] [17592186307700 #edb/ref 1078 #edb/ref 17592186442492 #edb/ref 17592186045417] [17592186307700 #edb/ref 1079 #uuid "38ab63d4-df22-5b52-9665-41a9dd7da8dd" #edb/ref 17592186045417] [17592186307701 #edb/ref 1075 #edb/ref 17592186305540 #edb/ref 17592186045417] [17592186307701 #edb/ref 1075 #edb/ref 17592186442493 #edb/ref 17592186045417] [17592186307701 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186307701 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186307701 #edb/ref 1078 #edb/ref 17592186442493 #edb/ref 17592186045417] [17592186307701 #edb/ref 1079 #uuid "39f8022a-afa7-5402-9578-ce5abfc3468c" #edb/ref 17592186045417] [17592186307871 #edb/ref 1075 #edb/ref 17592186307378 #edb/ref 17592186045417] [17592186307871 #edb/ref 1075 #edb/ref 17592186442528 #edb/ref 17592186045417] [17592186307871 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186307871 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186307871 #edb/ref 1078 #edb/ref 17592186442528 #edb/ref 17592186045417] [17592186307871 #edb/ref 1079 #uuid "6c6472ca-2c4e-5da6-9f5a-4788af95a430" #edb/ref 17592186045417] [17592186308289 #edb/ref 1075 #edb/ref 17592186306553 #edb/ref 17592186045417] [17592186308289 #edb/ref 1075 #edb/ref 17592186442511 #edb/ref 17592186045417] [17592186308289 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186308289 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186308289 #edb/ref 1078 #edb/ref 17592186442511 #edb/ref 17592186045417] [17592186308289 #edb/ref 1079 #uuid "f2155b73-1362-5f64-bf35-7930dcaeeb4a" #edb/ref 17592186045417] [17592186308600 #edb/ref 1068 #edb/ref 17592186307527 #edb/ref 17592186045417] [17592186308600 #edb/ref 1069 "q-334330" #edb/ref 17592186045417] [17592186308600 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186308600 #edb/ref 1071 "$$\n{x}^{′}=[\\begin{aligned}-1 & -2 \\\\ 2 & -1\\end{aligned}]x,\\,{x}_{1}(t)=[\\begin{aligned}\\operatorname{cos}⁡2t \\\\ \\operatorname{sin}⁡2t\\end{aligned}]{e}^{-t},\\,{x}_{2}(t)=[\\begin{aligned}-\\operatorname{sin}⁡2t \\\\ \\operatorname{cos}⁡2t\\end{aligned}]{e}^{-t}\n$$\n\nConsider the system of linear ODEs and two of its linearly independent solutions ${x}_{1}$ and ${x}_{2},$ shown above. Which of the following is a fundamental matrix for the system?" #edb/ref 17592186045417] [17592186308600 #edb/ref 1072 #uuid "3e83b1a2-7579-5dd1-bddd-671f2c156572" #edb/ref 17592186045417] [17592186308600 #edb/ref 1074 "Given a linear system ${x}^{′}=Ax,$ where $A$ is an $n\\times n$ matrix, a *fundamental matrix* $Φ(t)$ of the system is an $n\\times n$ matrix whose columns are linearly independent solutions of the system.\n\nIn our case, we have a $2\\times 2$ system. We are also given that the two linearly independent solutions of the system are the following:\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}\\operatorname{cos}⁡2t \\\\ \\operatorname{sin}⁡2t\\end{aligned}]{e}^{-t}=[\\begin{aligned}{e}^{-t}\\operatorname{cos}⁡2t \\\\ {e}^{-t}\\operatorname{sin}⁡2t\\end{aligned}] \\\\ {x}_{2}(t) & =[\\begin{aligned}-\\operatorname{sin}⁡2t \\\\ \\operatorname{cos}⁡2t\\end{aligned}]{e}^{-t}=[\\begin{aligned}-{e}^{-t}\\operatorname{sin}⁡2t \\\\ {e}^{-t}\\operatorname{cos}⁡2t\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, our fundamental could be written as\n\n$$\nΦ(t)=[\\begin{aligned}{e}^{-t}\\operatorname{cos}⁡2t & -{e}^{-t}\\operatorname{sin}⁡2t \\\\ {e}^{-t}\\operatorname{sin}⁡2t & {e}^{-t}\\operatorname{cos}⁡2t\\end{aligned}].\n$$\n\n**Note:** The columns of $Φ$ can be written in any order." #edb/ref 17592186045417] [17592186308757 #edb/ref 1080 "definition of a fundamental matrix" #edb/ref 17592186045417] [17592186308757 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186308757 #edb/ref 1083 #uuid "019f61ec-0715-5cf3-adfc-318205b19d4d" #edb/ref 17592186045417] [17592186308888 #edb/ref 1080 "definition of matrix multiplication" #edb/ref 17592186045417] [17592186308888 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186308888 #edb/ref 1083 #uuid "1372a77a-5f40-583a-81b0-59907e180c05" #edb/ref 17592186045417] [17592186308914 #edb/ref 1080 "$Φ(t)$ is invertible for all $t$" #edb/ref 17592186045417] [17592186308914 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186308914 #edb/ref 1083 #uuid "163f0f70-1745-5d82-a520-ee8ffbaf2c9a" #edb/ref 17592186045417] [17592186309313 #edb/ref 1080 "factoring out $A$ on