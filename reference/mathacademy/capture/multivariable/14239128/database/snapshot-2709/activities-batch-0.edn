#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186499625} :activity/id #uuid "026afa17-469a-5361-b712-278c42146aba" :activity/scope {:db/id #edb/ref 17592186499633 :topic/id #uuid "76fea41a-98af-5c68-b72e-6881d877a1e9" :topic/math-academy-id 492} :activity/steps [{:db/id #edb/ref 17592186499587 :step/content {:db/id #edb/ref 17592186499436 :knowledge-point/canonical-example {:db/id #edb/ref 17592186499495 :question/id #uuid "809623d1-30aa-5672-ac4f-f3c539a51eb7" :question/math-academy-id "e-51600"} :knowledge-point/id #uuid "4e25ce9f-c93f-5dc0-9e81-2093663c6202" :knowledge-point/questions [{:db/id #edb/ref 17592186499447} {:db/id #edb/ref 17592186499466} {:db/id #edb/ref 17592186499511} {:db/id #edb/ref 17592186499556} {:db/id #edb/ref 17592186499565} {:db/id #edb/ref 17592186533978} {:db/id #edb/ref 17592186534015}] :knowledge-point/title "Identifying a Decimal Interval for a Root of an Integer"} :step/id #uuid "4f77a136-9bb5-536c-a5f5-9e3132dc7e39" :step/math-academy-id 834851 :step/next {:db/id #edb/ref 17592186499630}} {:db/id #edb/ref 17592186499590 :step/content {:db/id #edb/ref 17592186499640 :tutorial/content "**Bounds** are values that trap a number between a lower value and an upper value. For roots, **whole-number bounds** are consecutive whole numbers that the root lies between.\n\nTo find whole-number bounds, we compare the number under the radical to nearby perfect squares or perfect cubes.\n\nLet's locate ![](images/db/dbd2aff681e9d97891999f08502f4f6e7f41f487b237d6c90e18afa1f77755ef.svg) The nearby perfect squares are ![](images/24/24341571e162e3b4e2ca76590f0ed2e6d8b180365fba30c3fb9ea6041d38179a.svg) and ![](images/3c/3cba1142c4b937d3598aaaed096f8b95178d8c45baf39fb7f9f02f21a21480df.svg) because\n![](images/09/09aad9428a24389e5a19034319e2737d08cf5167bf424e1b78cf0f0e69e49102.svg)\n\nSince ![](images/11/119ef80e819318a00b93e3c34aaca245545c965604be3489dd3529df1232a453.svg) is between these perfect squares, we have\n![](images/8f/8fbdaf9d9bd26df7fe6d1c1ad4403f07ba47a94f1a7f8b0d4e728b6865a7cb23.svg)\n\nTaking the square root of each part gives\n![](images/c9/c9753a4537cde93f9b0a994a0c50bdc6528dba6926bdd021d0cc2b54732277ba.svg)\n\n![](images/44/448579015986d36689743ffeadb6a8b05c96b917778d63a0de7e4a2dd0487370.png)\n\nSo, ![](images/e8/e8219f12c397796f3e761fb39940934f3f6ff51cb7dd3656018be76bcf7db1ba.svg) lies between the consecutive whole numbers ![](images/0c/0cf2eee0cdec31b7acdc244a255aaee7d6d520cfeee67b64ac9cf215f5377477.svg) and ![](images/fe/fe34f715005da1a8b682c9650a76785673fdf25c3b7c7546bb94824470c54caf.svg) The same idea works for cube roots, except we compare to nearby perfect cubes instead." :tutorial/id #uuid "914a8dc0-a88e-5f85-bc5d-34aec57c480e" :tutorial/math-academy-id 23020 :tutorial/title "Finding Whole-Number Bounds for Roots"} :step/id #uuid "62da36f8-cd66-52bf-9d7e-c13cf03ade4e" :step/math-academy-id 835631 :step/next {:db/id #edb/ref 17592186499603}} {:db/id #edb/ref 17592186499592 :step/content {:db/id #edb/ref 17592186499437 :knowledge-point/canonical-example {:db/id #edb/ref 17592186499463 :question/id #uuid "40e25a07-249d-5649-a737-532e2634f702" :question/math-academy-id "e-51599"} :knowledge-point/id #uuid "77b54737-402a-5ce2-acda-ea818dd80b33" :knowledge-point/questions [{:db/id #edb/ref 17592186499445} {:db/id #edb/ref 17592186499488} {:db/id #edb/ref 17592186499536} {:db/id #edb/ref 17592186499544} {:db/id #edb/ref 17592186499555} {:db/id #edb/ref 17592186534084}] :knowledge-point/title "Ordering a Set of Irrational Numbers"} :step/id #uuid "650093b9-8f2e-54ea-96a0-c4ce86769990" :step/math-academy-id 834846 :step/next {:db/id #edb/ref 17592186499614}} {:db/id #edb/ref 17592186499603 :step/content {:db/id #edb/ref 17592186499439 :knowledge-point/canonical-example {:db/id #edb/ref 17592186499498 :question/id #uuid "83d31d9c-626c-5711-b7cf-1417f78d3347" :question/math-academy-id "e-4892"} :knowledge-point/id #uuid "9f6b9f6c-95f0-5c70-b22d-f60c0e9d20da" :knowledge-point/questions [{:db/id #edb/ref 17592186499444} {:db/id #edb/ref 17592186499453} {:db/id #edb/ref 17592186499468} {:db/id #edb/ref 17592186499506} {:db/id #edb/ref 17592186499540}] :knowledge-point/title "Identifying a Unit Interval for a Root of an Integer"} :step/id #uuid "9755cb4a-e49f-5626-89dc-85c19b18c155" :step/math-academy-id 834841 :step/next {:db/id #edb/ref 17592186499612}} {:db/id #edb/ref 17592186499609 :step/content {:db/id #edb/ref 17592186499438 :knowledge-point/canonical-example {:db/id #edb/ref 17592186499496 :question/id #uuid "80a9441b-918f-5c2e-9da2-6d8d0312d00d" :question/math-academy-id "e-4894"} :knowledge-point/id #uuid "83d6ac5f-99e4-5420-9047-1c43a50b43a4" :knowledge-point/questions [{:db/id #edb/ref 17592186499478} {:db/id #edb/ref 17592186499481} {:db/id #edb/ref 17592186499489} {:db/id #edb/ref 17592186499507} {:db/id #edb/ref 17592186499528} {:db/id #edb/ref 17592186533997} {:db/id #edb/ref 17592186534006}] :knowledge-point/title "Estimating a Root of an Integer"} :step/id #uuid "a9f05ba0-f57e-5845-8ac7-3153bd449a36" :step/math-academy-id 834856} {:db/id #edb/ref 17592186499612 :step/content {:db/id #edb/ref 17592186499637 :tutorial/content "When we order irrational roots, we can often compare their whole-number intervals first. A root between ![](images/0c/0cf2eee0cdec31b7acdc244a255aaee7d6d520cfeee67b64ac9cf215f5377477.svg) and ![](images/37/37e17c4a2302e6352fb7186621c9c43bb5e99d43a8a0bc700c0181d36c6cc915.svg) is greater than any root between ![](images/40/402ff5d0c0c3aaa47f18c89f6d96c95d47840eac13822d596a51bdb0c5f9a4ab.svg) and ![](images/85/85ab4d14e4ae710116ac84de4b03b3cf35723ab969b7abfba97889c497974147.svg)\n\nSuppose we want to identify the greatest number in this list:\n![](images/3b/3b5235ec98b311f2a082eeb8a35ba2e606f452a5467707a2125ce3f27fd26484.svg)\n\nWe first bracket each root.\n\n- ![](images/04/04217800f61f8a2b9dfc2b4efb67a08c1d9f5ef7e365a5ddae4d163146bc0158.svg) lies between ![](images/0c/0cf2eee0cdec31b7acdc244a255aaee7d6d520cfeee67b64ac9cf215f5377477.svg) and ![](images/b1/b1288d1c08b90d72fcd319980da7943ea4941b9f259ece4086d8b24b1bc0cfb2.svg) since ![](images/a3/a34f852d765024d8ae773b8debb02adc77fc371c656b049104a9330dc604f5a4.svg)\n\n- ![](images/5a/5aa880157a445c826aa5e51bfbdf4f3c5ab83afdadf97fc6f533aa6103d28640.svg) lies between ![](images/0c/0cf2eee0cdec31b7acdc244a255aaee7d6d520cfeee67b64ac9cf215f5377477.svg) and ![](images/b1/b1288d1c08b90d72fcd319980da7943ea4941b9f259ece4086d8b24b1bc0cfb2.svg) since ![](images/64/6442e0ee53f3ae690132986dfe60822810ae2f586296bccecba0ab6a07c871db.svg)\n\n- ![](images/39/398d865ecee9dba51e8ba4918a187f483b9291ff6ae0d2032be0d95d40190ff7.svg) lies between ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) and ![](images/39/39c9d5c6b02f72e65180a1a782af0404d25977c3627c5778e1bcb676286506c4.svg) since ![](images/5b/5bf4ba43a56be76e42af12ac6d00913b93191cb348019c518a60bb6490d412ac.svg)\n\n- ![](images/55/556af15807fb8546143a7adb4457089c3f367764397c6cf94654f30200177aba.svg) lies between ![](images/40/402ff5d0c0c3aaa47f18c89f6d96c95d47840eac13822d596a51bdb0c5f9a4ab.svg) and ![](images/e9/e94ce8a42ab6b97ee9c979dcc0a002b557e1c6339e5950f601a66a9af91f67e5.svg) since ![](images/65/65aec0b2f64e5e7991650650102102099e40d0fa3f33b9951e7f42d02bbba8d2.svg)\n\n- ![](images/ba/ba20e4e917e21ab13b9aab507e09632255fccd6346f08f31333fffd468f3eea1.svg) lies between ![](images/40/402ff5d0c0c3aaa47f18c89f6d96c95d47840eac13822d596a51bdb0c5f9a4ab.svg) and ![](images/e9/e94ce8a42ab6b97ee9c979dcc0a002b557e1c6339e5950f601a66a9af91f67e5.svg) since ![](images/f4/f4638dd2c251dd734b480e1bcaedeb9e1bee07e2f03ff4c85de10287cae9957b.svg)\n\nThe greatest value must be one of the roots between ![](images/0c/0cf2eee0cdec31b7acdc244a255aaee7d6d520cfeee67b64ac9cf215f5377477.svg) and ![](images/b1/b1288d1c08b90d72fcd319980da7943ea4941b9f259ece4086d8b24b1bc0cfb2.svg) so it is either ![](images/04/04217800f61f8a2b9dfc2b4efb67a08c1d9f5ef7e365a5ddae4d163146bc0158.svg) or ![](images/8b/8bdb2119f2b5ebc9f21dcc182d6b68e8e964156168a62cacb6048ca84b6e4dbf.svg) Since ![](images/eb/eb86e1418a307c988f3b246894cfdf9d0e9c8bbceda1641fb831d30fe9b6fd3b.svg) we know ![](images/45/45ee1b9d94d27812c364bf34c46e918d9c2df4b254adbf86932c2d350cde0822.svg)\n\nTherefore, the greatest number is ![](images/8b/8bdb2119f2b5ebc9f21dcc182d6b68e8e964156168a62cacb6048ca84b6e4dbf.svg)\n\n**Watch out!** We can compare radicands directly only when the roots are the same kind. For example, comparing ![](images/5a/5aa880157a445c826aa5e51bfbdf4f3c5ab83afdadf97fc6f533aa6103d28640.svg) and ![](images/04/04217800f61f8a2b9dfc2b4efb67a08c1d9f5ef7e365a5ddae4d163146bc0158.svg) is safe because both are square roots." :tutorial/id #uuid "52ad8c4f-2f3c-5dcf-8ac3-f9cfff01832e" :tutorial/math-academy-id 23019 :tutorial/title "Ordering Irrational Roots"} :step/id #uuid "b17102b3-2a85-5565-86ee-18a47a1d1472" :step/math-academy-id 835630 :step/next {:db/id #edb/ref 17592186499592}} {:db/id #edb/ref 17592186499614 :step/content {:db/id #edb/ref 17592186499638 :tutorial/content "**Decimal bounds** are nearby decimal values that trap a root in a smaller interval, such as between two consecutive tenths.\n\nLet's find the two consecutive tenths between which ![](images/75/75690cbc152b11d764581bab44be87acabbbf69ccaca10786de7fd41462db7c1.svg) lies. First, we find the whole-number bounds:\n![](images/67/670a358c4cfbfff0330b32c236f83d3cf1b52475f6c624873a54bc335aa11b26.svg)\nso\n![](images/0f/0f2da556fe760c541b67a1f219a28784b92ab589f10c67d8bdefe8d4a27548e3.svg)\n\nNow, we test tenths between ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) and ![](images/40/402ff5d0c0c3aaa47f18c89f6d96c95d47840eac13822d596a51bdb0c5f9a4ab.svg) by squaring them. Since ![](images/75/75690cbc152b11d764581bab44be87acabbbf69ccaca10786de7fd41462db7c1.svg) is close to ![](images/3f/3f1007009d0a0d180a52510e7c9ce724113d2deb10051c26452457286845c91c.svg) we can test ![](images/52/521ed5d9c72e7dc13edf7e79df2272294cd869bd5de324f0f7828e2c888c326c.svg) and ![](images/22/227c2d0283023dacad68c1e78194ec0be80b93d52bffea8bd61b5bafc99102df.svg)\n![](images/66/662e926243f31e64daaa74edc74dd4ef9d78e4d24260995fa38db61be6d5cecb.svg)\n\nSince ![](images/e2/e2574f61b59164e433af2aeeb4c0dd160bf84436387873b2af855fa2770b5753.svg) falls between these square values, we have\n![](images/26/26bc3e1ccf6f626db492303aa9d1493c863cf8a10a2e1e46151f1c89ce86c0bd.svg)\n\nTaking square roots gives\n![](images/d1/d1aa32699a90c28680f86d47dca927f92f769ed1e879af7972a3a97030df30db.svg)\n\n![](images/47/4729d848e2e66944d7e2da9f8fc7655a93a59ac5ee20e9454f95b583b39cd8ee.png)\n\nTherefore, ![](images/75/75690cbc152b11d764581bab44be87acabbbf69ccaca10786de7fd41462db7c1.svg) lies between the consecutive tenths ![](images/52/521ed5d9c72e7dc13edf7e79df2272294cd869bd5de324f0f7828e2c888c326c.svg) and ![](images/22/227c2d0283023dacad68c1e78194ec0be80b93d52bffea8bd61b5bafc99102df.svg)" :tutorial/id #uuid "63caa2e6-2c19-5afe-93e1-8e484d252e52" :tutorial/math-academy-id 23018 :tutorial/title "Finding Decimal Bounds for Roots"} :step/id #uuid "b59cf68c-8312-512d-83a4-ee45cfcfa2cc" :step/math-academy-id 835629 :step/next {:db/id #edb/ref 17592186499587}} {:db/id #edb/ref 17592186499625 :step/content {:db/id #edb/ref 17592186499636 :tutorial/content "Some roots are perfect. For example, ![](images/38/389d3c3681c9e50a78b79c73049365330340f56d1dd87adfa83ed9cc3e3eefed.svg) and ![](images/47/4788ae8534df07b8199121e142f69086fd3aec0f87f201fcf4997831c0b60002.svg) Other roots are not whole numbers, but we can still describe where they belong.\n\nAn **approximation** is a nearby value that helps us understand the size of a number. To approximate roots, we compare the number under the radical to nearby perfect powers.\n\nFor a square root, we compare to perfect squares. Since ![](images/96/96d11100098752a9a927d8b25751f689094ffee73faec61b29b79e0afa375a42.svg) we know\n![](images/49/49fbd1142d93edad07ad98c73bc1dafb04d1e8b5a4820274f51d8cee4e3dfbd3.svg)\n\nFor a cube root, we compare to perfect cubes. Since ![](images/2d/2de677effff1f2ce5ed73724bfdd3bead3f0baab3bac33ed272af03361ec3573.svg) we know\n![](images/7e/7ec574473402909905dc4960cca1ab56bb5790c5fcd80f4ad78cd3b9954dc925.svg)\n\nSo, the main idea is to find familiar benchmark roots first. Once we know the root’s whole-number interval, we can order roots, refine to decimal intervals, and choose reasonable estimates." :tutorial/id #uuid "4dbd01ab-76e0-5e52-b2bb-2efdd00a2058" :tutorial/math-academy-id 23022 :tutorial/title "Introduction"} :step/id #uuid "dcf6056d-ef27-5b88-b777-e073060226e7" :step/math-academy-id 835633 :step/next {:db/id #edb/ref 17592186499590}} {:db/id #edb/ref 17592186499630 :step/content {:db/id #edb/ref 17592186499635 :tutorial/content "When we **estimate** a root, we choose one nearby decimal value and check that it is reasonable. Bounds tell us the interval; the estimate tells us which value in that interval is closest.\n\nLet's estimate ![](images/39/398d865ecee9dba51e8ba4918a187f483b9291ff6ae0d2032be0d95d40190ff7.svg) rounded to ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) decimal place. First, we find nearby perfect cubes:\n![](images/bc/bca4e36ccfb33070d91ecf1f82eab6ce7d8e06f71d05000633a58ac03ce19107.svg)\nso\n![](images/cd/cdf283b9d6e8644576f4e97abe9203e4115c00fd43314a2323706d1c643e9c0b.svg)\n\n![](images/36/3636292deb3377b1dfe99da068f300f7dba4ce7fa6acd22164150451dc396ee1.png)\n\nBecause ![](images/bc/bc98a2fdf686f851fd343e6cca8ebf25186c6d4fe401df573939f8e5e1d5d044.svg) is closer to ![](images/c6/c64ba31f35ed2d1f23f3827854effc6461b82c7cfa7f27694bf545acb565c90a.svg) than to ![](images/f9/f9e10c6abbe30486481349d2f58357e01d37bfd670ed37a29313e8556b57fe2c.svg) we expect ![](images/39/398d865ecee9dba51e8ba4918a187f483b9291ff6ae0d2032be0d95d40190ff7.svg) to be closer to ![](images/40/402ff5d0c0c3aaa47f18c89f6d96c95d47840eac13822d596a51bdb0c5f9a4ab.svg) than to ![](images/9f/9fc073d1e6ebde82eb949a875e40be00b9196e9b14473ee13fa47a26a98d8450.svg) Now, we test nearby tenths:\n![](images/47/4703877c1fc434e00d2fc781d77473c9ce8f775257b953203baa76d914c2458b.svg)\n\nSo, ![](images/5d/5dfbe3c8f263be79d4c240a343aeef3ed741dc5d9a72b0b8c21b38cd9548a66c.svg) To decide which tenth is the better estimate, compare distances from ![](images/3b/3b3b7808b8023e6edb41eb64eb15e0198ce6843ff72ec8c44e79786e8932dc84.svg)\n![](images/60/60b754ce1636a8fee75de533c7961f498ac37fd7f6b471971e420985069f3c22.svg)\n\nSince ![](images/bc/bc98a2fdf686f851fd343e6cca8ebf25186c6d4fe401df573939f8e5e1d5d044.svg) is closer to ![](images/92/9252231dcb743cf6f0c6df56fdcc7e3f30a9c4d371ad30332ac7a5f93b38b3e4.svg) the root is closer to ![](images/10/106a07431c2edab74f94a851a8f9d6d4c67fb6e29b7c2090e316e5c2032195e3.svg) Therefore,\n![](images/5d/5d0fdcc02424b0794c647227784e86791079bbdbc184868c2bbbdec3ddcf86cb.svg)" :tutorial/id #uuid "199fa1b4-f88c-51c4-a84f-275792b90dee" :tutorial/math-academy-id 23017 :tutorial/title "Estimating Roots"} :step/id #uuid "ea67ea8f-3960-5050-b5de-d9bafa206de8" :step/math-academy-id 835628 :step/next {:db/id #edb/ref 17592186499609}}] :activity/title "Approximating Square Roots and Cube Roots" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186498718}] [{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186534103} :activity/id #uuid "2f0ca7fd-efb9-5658-bd3a-533b2ddcfe17" :activity/scope {:db/id #edb/ref 17592186499633 :topic/id #uuid "76fea41a-98af-5c68-b72e-6881d877a1e9" :topic/math-academy-id 492} :activity/steps [{:db/id #edb/ref 17592186534103 :step/content {:db/id #edb/ref 17592186533978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "073f9210-d9a2-5f36-800b-c48c70348e31" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5.5$ and $5.6$" :db/id #edb/ref 17592186533152} {:answer/id #uuid "141002c6-b340-5ab9-884d-d4f6694527f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5.4$ and $5.5$" :db/id #edb/ref 17592186533185} {:answer/id #uuid "21b63af1-c719-5e54-b9fb-f8ac242a95b2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5.2$ and $5.3$" :db/id #edb/ref 17592186533216} {:answer/id #uuid "a2884d9c-c9cc-5d25-8ed3-7e9a3f85ac60" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5.6$ and $5.7$" :db/id #edb/ref 17592186533532} {:answer/id #uuid "d7c71876-374e-5a61-9b3a-791e08c878c9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5.3$ and $5.4$" :db/id #edb/ref 17592186533666}] :answer-field/correct {:db/id #edb/ref 17592186533185} :answer-field/id #uuid "c6a4769f-21c1-52e4-82b5-a8a4ff749939" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533922}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14353486-3eaf-5d78-ba59-74f924378a4f" :question/math-academy-id "q-555460" :question/problem "Between which two consecutive tenths does $\\sqrt{30}$ lie?" :question/worked-solution "To find the two consecutive tenths between which $\\sqrt{30}$ lies, we need to find two numbers with one decimal place whose squares bracket $30$.\n\nFirst, let's establish between which two consecutive integers $\\sqrt{30}$ lies.\nWe know that ${5}^{2}=25$ and ${6}^{2}=36$.\nSince $25<30<36$, we know that $5<\\sqrt{30}<6$.\n\nNext, we can test decimals between $5$ and $6$ to narrow down the interval:\n\n$$\n\\begin{aligned}{5.3}^{2} & =28.09 \\\\ {5.4}^{2} & =29.16 \\\\ {5.5}^{2} & =30.25\\end{aligned}\n$$\n\nSince $29.16<30<30.25$, we can write:\n\n$$\n{5.4}^{2}<30<{5.5}^{2}\n$$\n\nTaking the square root of each part of the inequality gives:\n\n$$\n5.4<\\sqrt{30}<5.5\n$$\n\nTherefore, $\\sqrt{30}$ lies between $5.4$ and $5.5$."} :step/id #uuid "0cffe8b2-9eaa-5609-8875-f9176136dbf8" :step/next {:db/id #edb/ref 17592186534119}} {:db/id #edb/ref 17592186534104 :step/content {:db/id #edb/ref 17592186534006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "addca03f-013a-5203-a880-de3131df5bc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5.3" :db/id #edb/ref 17592186533556}] :answer-field/correct {:db/id #edb/ref 17592186533556} :answer-field/id #uuid "5ba38eb1-b536-562c-bede-07820f4ec156" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186533854}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5297aedb-eec0-5c60-a99d-266da204b16b" :question/math-academy-id "q-556465" :question/problem "Estimate the value of $\\sqrt{28},$ rounded to $1$ decimal place.\n\n$\\sqrt{28}≈$\n{{field-1}}" :question/worked-solution "To estimate $\\sqrt{28},$ we first find the two perfect squares closest to $28.$\n\nThe closest perfect squares are $25={5}^{2}$ and $36={6}^{2}.$\n\nSince $25<28<36,$ we know that the square root of $28$ lies between $5$ and $6.$\n\n![](images/9f/9f16093fe61b05142060e1dcc36cf824ec664b271499d24758831a6bc53757ac.png)\n\nSince $28$ lies between $25$ and $36,$ we expect $\\sqrt{28}$ to lie between $5$ and $6.$\n\nLet's test decimals near the middle by squaring them:\n\n$$\n\\begin{aligned}{5.2}^{2} & =27.04 \\\\ {5.3}^{2} & =28.09\\end{aligned}\n$$\n\nWe can see that $28$ lies between $27.04$ and $28.09,$ so $5.2<\\sqrt{28}<5.3.$\n\nNext, we determine which value is closer to $28:$\n\n- The distance from $28$ to ${5.2}^{2}$ is $28-27.04=0.96.$\n\n- The distance from $28$ to ${5.3}^{2}$ is $28.09-28=0.09.$\n\nSince $28$ is much closer to $28.09,$ $\\sqrt{28}$ is closer to $5.3.$\n\nTherefore, rounded to $1$ decimal place, $\\sqrt{28}≈5.3.$"} :step/id #uuid "1186a56e-84b6-50a6-9e81-6065bd0a7d6e"} {:db/id #edb/ref 17592186534107 :step/content {:db/id #edb/ref 17592186534015 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d93e06b-de31-5b20-b728-e05b071741e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9.4" :db/id #edb/ref 17592186533173}] :answer-field/correct {:db/id #edb/ref 17592186533173} :answer-field/id #uuid "106ad80c-f5c2-5906-acd9-99f57be5d5c2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186533788} {:answer-field/choices [{:answer/id #uuid "4141bac0-74e9-56ec-bc66-46fada0ad9dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9.3" :db/id #edb/ref 17592186533291}] :answer-field/correct {:db/id #edb/ref 17592186533291} :answer-field/id #uuid "d99708c6-cfde-5abe-b62f-e0c5ade1ed06" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186533930}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6581b3e4-1dde-5fc5-a59c-9d058401fe58" :question/math-academy-id "q-556451" :question/problem "The value of $\\sqrt{88}$ lies between two consecutive tenths $a$ and $b,$ where $a<b.$ Find the values of $a$ and $b.$\n\n$a=$\n{{field-1}}\nand $b=$\n{{field-2}}" :question/worked-solution "First, we find the two consecutive whole numbers that bracket $\\sqrt{88}.$ We do this by finding the perfect squares just below and just above $88:$\n\n$$\n81<88<100\n$$\n\nTaking the square root of each part gives\n\n$$\n\\sqrt{81}<\\sqrt{88}<\\sqrt{100},\n$$\n\nwhich simplifies to\n\n$$\n9<\\sqrt{88}<10.\n$$\n\nThis tells us that $\\sqrt{88}$ is between $9$ and $10.$ \n\nTo narrow this down to two consecutive tenths, we test the squares of decimals between $9.0$ and $10.0.$ Since $88$ is closer to $81$ than to $100,$ the value of $\\sqrt{88}$ will be closer to $9$ than to $10.$ We can start testing at $9.3:$\n\n$$\n\\begin{aligned}{9.3}^{2} & =86.49 \\\\ {9.4}^{2} & =88.36\\end{aligned}\n$$\n\nWe see that $88$ falls between $86.49$ and $88.36:$\n\n$$\n86.49<88<88.36\n$$\n\nTaking the square root of each part gives\n\n$$\n\\sqrt{86.49}<\\sqrt{88}<\\sqrt{88.36},\n$$\n\nwhich simplifies to\n\n$$\n9.3<\\sqrt{88}<9.4.\n$$\n\nTherefore, $\\sqrt{88}$ lies between the consecutive tenths $a=9.3$ and $b=9.4.$"} :step/id #uuid "1d3ce030-a464-5cad-80c6-c2925c812161" :step/next {:db/id #edb/ref 17592186534104}} {:db/id #edb/ref 17592186534119 :step/content {:db/id #edb/ref 17592186533997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cee2d1b8-abc0-540d-91d0-4123cd119263" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8.5" :db/id #edb/ref 17592186533642}] :answer-field/correct {:db/id #edb/ref 17592186533642} :answer-field/id #uuid "b5cdc719-89df-501a-9054-6f1aff3d4e0c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186533911}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3e4b5639-d116-5036-9ab2-4b00a6b27dd4" :question/math-academy-id "q-555923" :question/problem "Estimate the value of $\\sqrt{72},$ rounded to $1$ decimal place.\n\n$\\sqrt{72}≈$\n{{field-1}}" :question/worked-solution "To estimate $\\sqrt{72},$ we first find the two perfect squares closest to $72.$\n\nThe closest perfect squares are $64={8}^{2}$ and $81={9}^{2}.$\n\nSince $64<72<81,$ we know that the square root of $72$ lies between $8$ and $9.$\n\n![](images/e9/e931f5e15b35adb850966e40e4ad759c233d9419771998efba5dc91d9ab95bc1.png)\n\nSince $72$ lies between $64$ and $81,$ we expect $\\sqrt{72}$ to lie between $8$ and $9.$\n\nLet's test decimals near the middle by squaring them:\n\n$$\n\\begin{aligned}{8.4}^{2} & =70.56 \\\\ {8.5}^{2} & =72.25\\end{aligned}\n$$\n\nWe can see that $72$ lies between $70.56$ and $72.25,$ so $8.4<\\sqrt{72}<8.5.$\n\nNext, we determine which value is closer to $72:$\n\n- The distance from $72$ to ${8.4}^{2}$ is $72-70.56=1.44.$\n\n- The distance from $72$ to ${8.5}^{2}$ is $72.25-72=0.25.$\n\nSince $72$ is much closer to $72.25,$ $\\sqrt{72}$ is closer to $8.5.$\n\nTherefore, rounded to $1$ decimal place, $\\sqrt{72}≈8.5.$"} :step/id #uuid "463a2187-c3fe-599b-aa5d-f1c756b0cc9c" :step/next {:db/id #edb/ref 17592186534143}} {:db/id #edb/ref 17592186534143 :step/content {:db/id #edb/ref 17592186534084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c8ec4b2-8a62-5be2-bc85-cb1f42b10068" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{50}" :db/id #edb/ref 17592186533281} {:answer/id #uuid "47a27d49-a40e-50b5-a1b0-9a2ba16e708a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{40}" :db/id #edb/ref 17592186533305} {:answer/id #uuid "b335f7ec-1759-5795-9639-e0da48f10014" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{30}" :db/id #edb/ref 17592186533573} {:answer/id #uuid "b64804d5-9f57-59e0-925d-cefea393e51d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{45}" :db/id #edb/ref 17592186533585} {:answer/id #uuid "e7a88941-27e7-5202-b0d9-8572edf2d3c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{120}" :db/id #edb/ref 17592186533709}] :answer-field/correct {:db/id #edb/ref 17592186533585} :answer-field/id #uuid "7df3e984-bbc8-5964-9312-1a2d645cc83b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186533876}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ec99099b-9970-5301-8219-551157f9c01b" :question/math-academy-id "q-556441" :question/problem "Which of the following irrational numbers is the greatest?" :question/worked-solution "To identify the greatest irrational number, we can find the consecutive whole numbers between which each root lies.\n\n- $\\sqrt{45}$ lies between $6$ and $7,$ since ${6}^{2}=36$ and ${7}^{2}=49.$\n\n- $\\sqrt{40}$ lies between $6$ and $7,$ since ${6}^{2}=36$ and ${7}^{2}=49.$\n\n- $\\sqrt[3]{50}$ lies between $3$ and $4,$ since ${3}^{3}=27$ and ${4}^{3}=64.$\n\n- $\\sqrt[3]{120}$ lies between $4$ and $5,$ since ${4}^{3}=64$ and ${5}^{3}=125.$\n\n- $\\sqrt{30}$ lies between $5$ and $6,$ since ${5}^{2}=25$ and ${6}^{2}=36.$\n\nComparing these bounds, the greatest number must be between $6$ and $7.$ So, it is either $\\sqrt{45}$ or $\\sqrt{40}.$\n\nSince $45>40,$ we know that $\\sqrt{45}>\\sqrt{40}.$\n\nTherefore, $\\sqrt{45}$ is the greatest number among the given options."} :step/id #uuid "ad31145b-e901-58de-9d30-fd62353a75b5" :step/next {:db/id #edb/ref 17592186534107}}] :activity/title "Approximating Square Roots and Cube Roots" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186533120}]}
