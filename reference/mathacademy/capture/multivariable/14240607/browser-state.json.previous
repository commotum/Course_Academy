      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14240607/observations/step-q117217-a9c52e18d3efb5777438.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14240607/observations/step-q117217-a9c52e18d3efb5777438.png",
      "source_url": "https://mathacademy.com/tasks/14240607/topics/1213/review",
      "captured_at": 1792093581.0739546,
      "math_academy_id": "q-117217",
      "topic_id": "1213",
      "sequence_position": null,
