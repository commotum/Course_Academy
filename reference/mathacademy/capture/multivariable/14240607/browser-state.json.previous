      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14240607/observations/step-q346784-ab3e1138eb6c58fd6f7e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14240607/observations/step-q346784-ab3e1138eb6c58fd6f7e.png",
      "source_url": "https://mathacademy.com/tasks/14240607/topics/1213/review",
      "captured_at": 1792093602.368928,
      "math_academy_id": "q-346784",
      "topic_id": "1213",
      "sequence_position": null,
