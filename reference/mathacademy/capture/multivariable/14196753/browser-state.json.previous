      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196753/observations/step-q161775-9444eb9a6e7cdf8befb6.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196753/observations/step-q161775-9444eb9a6e7cdf8befb6.png",
      "source_url": "https://mathacademy.com/tasks/14196753/topics/2060/review",
      "captured_at": 1791960603.8694935,
      "math_academy_id": "q-161775",
      "topic_id": "2060",
      "sequence_position": null,
