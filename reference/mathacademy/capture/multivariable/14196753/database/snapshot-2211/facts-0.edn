6307 #edb/ref 17592186045417] [17592186129266 #edb/ref 1038 #edb/ref 17592186496308 #edb/ref 17592186045417] [17592186129266 #edb/ref 1039 "Evaluating a Triple Integral by Converting to Spherical Polar Coordinates" #edb/ref 17592186045417] [17592186129266 #edb/ref 1041 #edb/ref 17592186128843 #edb/ref 17592186045417] [17592186129266 #edb/ref 1042 #uuid "00ea201b-cf90-54cf-bd20-d7e990345710" #edb/ref 17592186045417] [17592186129281 #edb/ref 1038 #edb/ref 17592186129524 #edb/ref 17592186045417] [17592186129281 #edb/ref 1038 #edb/ref 17592186129760 #edb/ref 17592186045417] [17592186129281 #edb/ref 1038 #edb/ref 17592186374000 #edb/ref 17592186045417] [17592186129281 #edb/ref 1038 #edb/ref 17592186374020 #edb/ref 17592186045417] [17592186129281 #edb/ref 1038 #edb/ref 17592186374027 #edb/ref 17592186045417] [17592186129281 #edb/ref 1038 #edb/ref 17592186374041 #edb/ref 17592186045417] [17592186129281 #edb/ref 1038 #edb/ref 17592186482512 #edb/ref 17592186045417] [17592186129281 #edb/ref 1038 #edb/ref 17592186482536 #edb/ref 17592186045417] [17592186129281 #edb/ref 1038 #edb/ref 17592186482587 #edb/ref 17592186045417] [17592186129281 #edb/ref 1038 #edb/ref 17592186482590 #edb/ref 17592186045417] [17592186129281 #edb/ref 1038 #edb/ref 17592186496227 #edb/ref 17592186045417] [17592186129281 #edb/ref 1038 #edb/ref 17592186511483 #edb/ref 17592186045417] [17592186129281 #edb/ref 1039 "Rewriting a Triple Integral Defined Over a Part-Sphere" #edb/ref 17592186045417] [17592186129281 #edb/ref 1041 #edb/ref 17592186128859 #edb/ref 17592186045417] [17592186129281 #edb/ref 1042 #uuid "3d85b11c-498d-53b7-98f8-b742b46e8dc2" #edb/ref 17592186045417] [17592186129390 #edb/ref 1043 #edb/ref 17592186130203 #edb/ref 17592186045417] [17592186129390 #edb/ref 1043 #edb/ref 17592186130204 #edb/ref 17592186045417] [17592186129390 #edb/ref 1043 #edb/ref 17592186130205 #edb/ref 17592186045417] [17592186129390 #edb/ref 1043 #edb/ref 17592186130206 #edb/ref 17592186045417] [17592186129390 #edb/ref 1043 #edb/ref 17592186130228 #edb/ref 17592186045417] [17592186129390 #edb/ref 1043 #edb/ref 17592186130235 #edb/ref 17592186045417] [17592186129390 #edb/ref 1043 #edb/ref 17592186130236 #edb/ref 17592186045417] [17592186129390 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186129390 #edb/ref 1045 "Triple Integrals in Spherical Polar Coordinates" #edb/ref 17592186045417] [17592186129390 #edb/ref 1046 #edb/ref 17592186130203 #edb/ref 17592186045417] [17592186129390 #edb/ref 1049 #edb/ref 17592186050390 #edb/ref 17592186045417] [17592186129390 #edb/ref 1050 1200.0 #edb/ref 17592186045417] [17592186129390 #edb/ref 1053 #uuid "1e370681-4235-581a-8e92-bfa4ed63d765" #edb/ref 17592186045417] [17592186129523 #edb/ref 1068 #edb/ref 17592186374007 #edb/ref 17592186045417] [17592186129523 #edb/ref 1069 "q-161754" #edb/ref 17592186045417] [17592186129523 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186129523 #edb/ref 1071 "The region $R$ is enclosed inside the sphere ${x}^{2}+{y}^{2}+{z}^{2}=25.$\nExpress the following triple integral in spherical polar coordinates. \n\n$$\n{∭}_{R}\\frac{xy}{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V\n$$" #edb/ref 17592186045417] [17592186129523 #edb/ref 1072 #uuid "699f2901-2747-5828-8f8f-087336e97be3" #edb/ref 17592186045417] [17592186129523 #edb/ref 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $5$ centered at the origin. \nAs a result, in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 5,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\frac{xy}{{x}^{2}+{y}^{2}+{z}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\frac{\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ\\cdot \\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{{\\rho }^{2}} \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{2}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{xy}{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{2}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{\\rho }^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{3}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186129756 #edb/ref 1068 #edb/ref 17592186375136 #edb/ref 17592186045417] [17592186129756 #edb/ref 1069 "q-40073" #edb/ref 17592186045417] [17592186129756 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186129756 #edb/ref 1071 "The region $R$ is enclosed inside the sphere ${x}^{2}+{y}^{2}+{z}^{2}=9.$\nExpress the following triple integral in spherical polar coordinates. \n\n$$\n{∭}_{R}z\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V\n$$" #edb/ref 17592186045417] [17592186129756 #edb/ref 1072 #uuid "5e21b1a1-dd1a-5b1e-a6f4-aca8044792b9" #edb/ref 17592186045417] [17592186129756 #edb/ref 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $3$ centered at the origin. \nAs a result, in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 3,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=z\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\rho \\operatorname{cos}⁡ϕ\\cdot \\rho  \\\\  & ={\\rho }^{2}\\operatorname{cos}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}z\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{2}\\operatorname{cos}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\rho }^{4}\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186130203 #edb/ref 1058 #edb/ref 17592186130204 #edb/ref 17592186045417] [17592186130203 #edb/ref 1061 42751 #edb/ref 17592186045417] [17592186130203 #edb/ref 1062 #uuid "0355ca44-2058-5e43-b562-1ba67c747a89" #edb/ref 17592186045417] [17592186130203 #edb/ref 1063 #edb/ref 17592186130455 #edb/ref 17592186045417] [17592186130204 #edb/ref 1058 #edb/ref 17592186130228 #edb/ref 17592186045417] [17592186130204 #edb/ref 1061 42752 #edb/ref 17592186045417] [17592186130204 #edb/ref 1062 #uuid "187ae894-50e1-5dc4-a7bd-e52db3a63568" #edb/ref 17592186045417] [17592186130204 #edb/ref 1063 #edb/ref 17592186129264 #edb/ref 17592186045417] [17592186130205 #edb/ref 1058 #edb/ref 17592186130206 #edb/ref 17592186045417] [17592186130205 #edb/ref 1061 42753 #edb/ref 17592186045417] [17592186130205 #edb/ref 1062 #uuid "6ef297ec-41d5-5d03-8b56-8189aecc9f8e" #edb/ref 17592186045417] [17592186130205 #edb/ref 1063 #edb/ref 17592186129265 #edb/ref 17592186045417] [17592186130206 #edb/ref 1058 #edb/ref 17592186130235 #edb/ref 17592186045417] [17592186130206 #edb/ref 1061 42755 #edb/ref 17592186045417] [17592186130206 #edb/ref 1062 #uuid "6eb5bbde-3ae3-519e-a13a-011708f318d7" #edb/ref 17592186045417] [17592186130206 #edb/ref 1063 #edb/ref 17592186129266 #edb/ref 17592186045417] [17592186130228 #edb/ref 1058 #edb/ref 17592186130205 #edb/ref 17592186045417] [17592186130228 #edb/ref 1061 44584 #edb/ref 17592186045417] [17592186130228 #edb/ref 1062 #uuid "fb036686-92a4-5d96-ae09-318717eb493f" #edb/ref 17592186045417] [17592186130228 #edb/ref 1063 #edb/ref 17592186129281 #edb/ref 17592186045417] [17592186130235 #edb/ref 1058 #edb/ref 17592186130236 #edb/ref 17592186045417] [17592186130235 #edb/ref 1061 44767 #edb/ref 17592186045417] [17592186130235 #edb/ref 1062 #uuid "96fb4483-0ca7-52c1-9f83-46c894da5471" #edb/ref 17592186045417] [17592186130235 #edb/ref 1063 #edb/ref 17592186130468 #edb/ref 17592186045417] [17592186130236 #edb/ref 1061 44789 #edb/ref 17592186045417] [17592186130236 #edb/ref 1062 #uuid "68b6f2fa-a8c8-5b52-98b8-fd02b1454611" #edb/ref 17592186045417] [17592186130236 #edb/ref 1063 #edb/ref 17592186130469 #edb/ref 17592186045417] [17592186130455 #edb/ref 1064 "When evaluating triple integrals, it's sometimes easier to change the variables from Cartesian coordinates to spherical polar coordinates.\n\nFor example, suppose we want to evaluate the triple integral\n\n$$\n\\displaystyle \\iiint\\limits_R \\left(x^2 + y^2 + z^2\\right)^{3/2} \\: \\textrm{d}V\n$$\n\nwhere $R$ is the region enclosed by the sphere of radius $1$ centered at $O,$ as shown below.\n\n![](images/08/0809a74f0aca2b3042b7f8db6783f9d6a13bc84bfc75ddcbb4d3076dbf0a2efd.png)\n\nThis integral seems too challenging when written in Cartesian coordinates. However, we should recognize that the problem lends itself to spherical polar coordinates because\n\n- the domain $R$ has a simple spherical polar representation, and\n\n- the integrand $f(x,y,z)=\\left(x^2+y^2+z^2\\right)^{3/2}$ can also be expressed simply in spherical polar coordinates.\n\nSo, let's transform the entire problem to spherical polar coordinates using the transformation $\\mathbf{T},$ defined by\n\n$$\nx = \\rho\\cos\\theta\\sin\\phi, \\qquad\n\ny = \\rho\\sin\\theta\\sin\\phi, \\qquad \n\nz = \\rho\\cos\\phi.\n$$\n\nThe preimage of $R$ under the action of $\\mathbf{T}$ is the rectangular region $\\Delta,$ given by\n\n$$\n\\Delta = \\left\\{ (\\rho, \\theta, \\phi) \\, : \\, 0 \\leq \\rho \\leq 1, \\: 0 \\leq \\theta \\lt 2\\pi, \\: 0 \\leq \\phi \\leq \\pi \\right\\},\n$$\n\nas shown below.\n\n![](images/c2/c2ed8a57c5e66687428a524eb148f96672f3a1ace7fbd28d426de065b2fb5f1f.png)\n\nTo express our integral in terms of spherical polar coordinates, we will use the change of variables formula\n\n$$\n\\iiint\\limits_{R} f(x,y,z) \\, \\mathrm{d}V = \n\n\\iiint\\limits_{\\Delta} \\, f(\\rho\\cos\\theta\\sin\\phi, \\rho\\sin\\theta\\sin\\phi, \\rho\\cos\\phi) \\: \\left| \\dfrac{\\partial (x,y,z)}{\\partial (\\rho, \\theta, \\phi)} \\right| \\: \\mathrm{d}\\rho \\, \\mathrm{d}\\theta \\, \\mathrm{d}\\phi.\n$$\n\nIt can be shown that the absolute value of the Jacobian determinant for a spherical change of variables is\n\n$$\n\\left| \\dfrac{\\partial (x,y,z)}{\\partial (\\rho, \\theta, \\phi)} \\right| = \\rho^2\\sin\\phi.\n$$\n\nTherefore, the change of variables formula is\n\n$$\n\\iiint\\limits_{R} f(x,y,z) \\, \\mathrm{d}V = \n\n\\iiint\\limits_{\\Delta} \\, f(\\rho\\cos\\theta\\sin\\phi, \\rho\\sin\\theta\\sin\\phi, \\rho\\cos\\phi) \\:  \\rho^2\\sin\\phi \\: \\mathrm{d}\\rho \\, \\mathrm{d}\\theta \\, \\mathrm{d}\\phi.\n$$\n\nNow, let's write our function $f(x,y,z) = \\left(x^2 + y^2 + z^2\\right)^{3/2}$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & ={({\\rho }^{2})}^{3/2} \\\\  & ={\\rho }^{3}\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}{({x}^{2}+{y}^{2}+{z}^{2})}^{3/2}\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{3}\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{\\rho }^{5}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }\\operatorname{sin}⁡ϕ\\,dϕ\\cdot {\\int }_{0}^{2\\pi }d\\theta \\cdot {\\int }_{0}^{1}{\\rho }^{5}\\,d\\rho  \\\\  & =[-\\operatorname{cos}⁡ϕ]_{ϕ=0}^{ϕ=\\pi }\\cdot [\\theta ]_{\\theta =0}^{\\theta =2\\pi }\\cdot {[\\frac{1}{6}{\\rho }^{6}]}_{\\rho =0}^{\\rho =1}\\,d\\rho  \\\\  & =-(-1-1)\\cdot (2\\pi -0)\\cdot \\frac{1}{6}(1-0) \\\\  & =2\\cdot 2\\pi \\cdot \\frac{1}{6} \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186130455 #edb/ref 1065 7149 #edb/ref 17592186045417] [17592186130455 #edb/ref 1066 #uuid "b86207dc-5c0f-5e73-a894-7cd428b18036" #edb/ref 17592186045417] [17592186130455 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186130468 #edb/ref 1064 "Throughout this lesson, we've used the fact that \n\n$$\n\\left| \\dfrac{\\partial (x, y, z)}{\\partial (\\rho, \\theta, \\phi)} \\right| = \\rho^2 \\sin{\\phi}.\n$$\n\nLet's now prove this result.\n\nGiven the spherical coordinate transformations\n\n$$\nx = \\rho\\cos\\theta\\sin\\phi, \\qquad\n\ny = \\rho\\sin\\theta\\sin\\phi, \\qquad \n\nz = \\rho\\cos\\phi,\n$$\n\nwe first  calculate the required partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂\\rho } & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ & \\,\\frac{∂x}{∂\\theta } & =-\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & \\,\\frac{∂x}{∂ϕ} & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{cos}⁡ϕ \\\\ \\frac{∂y}{∂\\rho } & =\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & \\,\\frac{∂y}{∂\\theta } & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ & \\,\\frac{∂y}{∂ϕ} & =\\rho \\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ \\\\ \\frac{∂z}{∂\\rho } & =\\operatorname{cos}⁡ϕ & \\,\\frac{∂z}{∂\\theta } & =0 & \\,\\frac{∂z}{∂ϕ} & =-\\rho \\operatorname{sin}⁡ϕ\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(\\rho ,\\theta ,ϕ)} & =|\\begin{aligned}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ & -\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & \\rho \\operatorname{cos}⁡\\theta \\operatorname{cos}⁡ϕ \\\\ \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & \\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ & \\rho \\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ \\\\ \\operatorname{cos}⁡ϕ & 0 & -\\rho \\operatorname{sin}⁡ϕ\\end{aligned}| \\\\  & =\\operatorname{cos}⁡ϕ|\\begin{aligned}-\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & \\rho \\operatorname{cos}⁡\\theta \\operatorname{cos}⁡ϕ \\\\ \\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ & \\rho \\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ\\end{aligned}|-\\rho \\operatorname{sin}⁡ϕ|\\begin{aligned}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ & -\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & \\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ\\end{aligned}| \\\\  & =\\operatorname{cos}⁡ϕ\\cdot (-{\\rho }^{2}\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡ϕ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta ))-\\rho \\operatorname{sin}⁡ϕ\\cdot \\rho {sin}^{2}⁡ϕ\\cdot ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =-{\\rho }^{2}\\operatorname{sin}⁡ϕ{cos}^{2}⁡ϕ-{\\rho }^{2}\\operatorname{sin}⁡ϕ{sin}^{2}⁡ϕ \\\\  & =-{\\rho }^{2}\\operatorname{sin}⁡ϕ({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) \\\\  & =-{\\rho }^{2}\\operatorname{sin}⁡ϕ.\\end{aligned}\n$$\n\nFinally, we conclude that\n\n$$\n\\left| \\dfrac{\\partial (x, y, z)}{\\partial (\\rho, \\theta, \\phi)} \\right| = \\rho^2 \\sin{\\phi}.\n$$" #edb/ref 17592186045417] [17592186130468 #edb/ref 1065 7720 #edb/ref 17592186045417] [17592186130468 #edb/ref 1066 #uuid "86bd6cae-b4e6-5da9-80b3-b884c320bda3" #edb/ref 17592186045417] [17592186130468 #edb/ref 1067 "Deriving the Jacobian for Spherical Polar Coordinates" #edb/ref 17592186045417] [17592186130469 #edb/ref 1064 "We can also derive the change of variables formula for spherical polar coordinates using geometry.\n\nConsider a bounded spherical box $R,$ given by\n\n$$\nR = \\big\\{ (\\rho,\\theta,\\phi) \\: | \\: a \\leq \\rho \\leq b, \\:\\: \\alpha \\leq \\theta \\leq \\beta, \\:\\: \\gamma \\leq \\phi \\leq \\psi \\big\\}.\n$$\n\nWe can divide each interval into $l,m,$ and $n$ subdivisions such that \n\n$$\n\\Delta\\rho = \\dfrac{b-a}{l},\\qquad \\Delta\\theta = \\dfrac{\\beta-\\alpha}{m},\\qquad \\Delta\\phi = \\dfrac{\\psi-\\gamma}{n}.\n$$\n\nThis splits the region into \"spherical wedges,\" as shown in the following diagram.\n\n![](images/88/88be4c6a09062321d20ac7f48dfbb6be796cdd6b5bb1b7f6adc49a6ae1da609b.png)\n\nZooming in on one of these wedges, we obtain a shape resembling a rectangular solid.\n\n![](images/5e/5e5f7acb4d057e856c66e9d5626f81178ca26c0b7ce83cdf7290b1f4c64b1852.png)\n\nLet's note the volume of this solid as $\\Delta V.$ To approximate the value of $\\Delta V,$ we use the formula for the volume of a rectangular solid:\n\n$$\n\\Delta V \\approx lwh\n$$\n\nClearly, the height of the rectangular solid is $h = \\Delta \\rho.$ We can find the remaining dimensions using simple geometry. \n\nFirst, we need to find the length of the radius $r$ in the $xy$-plane. Using the following triangle and a side-on view of the wedge, we conclude that $r=\\rho\\sin\\phi.$\n\n![](images/01/0122c6c3b813bbe2821dbede794b6027cd69002dd1828925811211045a0d67e8.png)\n\nLet's add this to our diagram.\n\n![](images/d4/d41b538e9bb3add9bae1e3a24c9f87ae282a8b969f0c0dc4acd374ad777de74a.png)\n\nFinally, we can use the arc length formula $s = r \\cdot \\theta$ to find the length $l$ and width $w.$\n\n![](images/88/882b9243d1189c098aaf6e1e45ca7ec97d480b1f2c3a8fe23d5e39a6c2313ed2.png)\n\nThe length of our wedge is \n\n$$\nl = \\rho \\cdot \\Delta\\phi = \\rho\\Delta\\phi\n$$\n\n and the width is \n\n$$\nw = \\rho\\sin\\phi \\cdot \\Delta\\theta = \\rho\\sin\\phi\\Delta\\theta.\n$$\n\nCalculating the volume as a rectangular solid, we obtain\n\n$$\n\\begin{aligned}ΔV & ≈lwh \\\\  & =(\\rho Δϕ)\\cdot (\\rho \\operatorname{sin}⁡ϕΔ\\theta )\\cdot (Δ\\rho ) \\\\  & ={\\rho }^{2}\\operatorname{sin}⁡ϕ\\,Δϕ\\,Δ\\theta \\,Δ\\rho .\\end{aligned}\n$$\n\nAs a result, we define the triple integral in spherical coordinates as the limit of a triple Riemann sum, where $(\\rho_{ijk},\\theta_{ijk},\\phi_{ijk})$ being any sample point in the spherical subregion $B{ijk}{:}$\n\n$$\n\\lim\\limits_{l,m,n \\to \\infty} \\sum\\limits_{i=1}^{l} \\sum\\limits_{j=1}^{m} \\sum\\limits_{k=1}^{n} f(\\rho_{ijk},\\theta_{ijk},\\phi_{ijk}) (\\rho_{ijk})^2 \\sin \\phi_{ijk} \\:\\Delta\\rho\\:\\Delta\\theta\\:\\Delta\\phi\n$$\n\nAs we increase the number of subregions, the size of $\\Delta\\rho,$ $\\Delta\\theta,$ and $\\Delta\\phi$ all goes to zero, and the volume of $R$ is more accurately approximated, giving\n\n$$\n\\textrm{d}V = \\rho^2 \\sin\\phi \\:\\textrm{d}\\rho\\:\\textrm{d}\\theta\\:\\textrm{d}\\phi.\n$$\n\nTherefore, we conclude that if $f(\\rho,\\theta,\\phi)$ is continuous on a spherical box $R = [a,b] \\times [\\alpha,\\beta] \\times [\\gamma, \\psi],$ then\n\n$$\n\\iiint\\limits_{R} f(\\rho,\\theta,\\phi) \\:\\textrm{d}V\n=\n\\iiint\\limits_{R} f(\\rho,\\theta,\\phi) \\rho^2 \\sin\\phi \\:\\textrm{d}\\rho\\:\\textrm{d}\\theta\\:\\textrm{d}\\phi\n=\n\\int_{\\gamma}^{\\psi}\\int_{\\alpha}^{\\beta}\\int_{a}^{b} f(\\rho,\\theta,\\phi) \\rho^2 \\sin\\phi \\:\\textrm{d}\\rho\\:\\textrm{d}\\theta\\:\\textrm{d}\\phi.\n$$" #edb/ref 17592186045417] [17592186130469 #edb/ref 1065 7730 #edb/ref 17592186045417] [17592186130469 #edb/ref 1066 #uuid "444d88e7-62f3-5333-98ad-9ee9e22d6a46" #edb/ref 17592186045417] [17592186130469 #edb/ref 1067 "Deriving the Change of Variables Formula Using Geometry" #edb/ref 17592186045417] [17592186374007 #edb/ref 1075 #edb/ref 17592186374008 #edb/ref 17592186045417] [17592186374007 #edb/ref 1075 #edb/ref 17592186374009 #edb/ref 17592186045417] [17592186374007 #edb/ref 1075 #edb/ref 17592186374010 #edb/ref 17592186045417] [17592186374007 #edb/ref 1075 #edb/ref 17592186374011 #edb/ref 17592186045417] [17592186374007 #edb/ref 1075 #edb/ref 17592186374012 #edb/ref 17592186045417] [17592186374007 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186374007 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186374007 #edb/ref 1078 #edb/ref 17592186374012 #edb/ref 17592186045417] [17592186374007 #edb/ref 1079 #uuid "a3d2f399-c08f-57b6-b31d-d84d8b9705c4" #edb/ref 17592186045417] [17592186374008 #edb/ref 1080 "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\pi }{\\int }_{0}^{25}{\\rho }^{2}\\operatorname{cos}⁡\\theta {sin}^{3}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" #edb/ref 17592186045417] [17592186374008 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186374008 #edb/ref 1083 #uuid "49e9a4ed-cc02-552b-850f-590a1eabb508" #edb/ref 17592186045417] [17592186374009 #edb/ref 1080 "{\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{25}{\\rho }^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,d