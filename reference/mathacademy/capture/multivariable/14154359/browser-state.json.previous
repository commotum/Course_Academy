    "q-108924": {
      "dom_id": "step-q108924",
      "name": "Question 9",
      "problem": "Let $A$ be a $m\\times n$ matrix. What is the image of $\\text{Null}({A}^{T})$ under the action of ${A}^{T}?$",
      "worked_solution": "By definition of the null subspace, $\\text{Null}({A}^{T})$ is mapped to the zero vector $0$ under the action of ${A}^{T}.$",
