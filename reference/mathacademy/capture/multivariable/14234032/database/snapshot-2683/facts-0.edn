6045417] [17592186329711 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186329711 #edb/ref 1071 "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}5x-3y-z &=1 \\\\ x+4y+kz &=-1 \\\\ 2x+3y+4z &=9.\\end{aligned}\\right.\n$$\n\nGiven that  $z=1$ and that the determinant of the coefficient matrix is equal to $97-21k,$ find the value of $k.$" #edb/ref 17592186045443] [17592186329711 #edb/ref 1072 #uuid "53b9ad58-1c7d-58bd-abc1-d7698480a379" #edb/ref 17592186045417] [17592186329711 #edb/ref 1074 "First, let's write the determinant of the coefficient matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}5 & -3 & -1 \\\\ 1 & 4 & k \\\\ 2 & 3 & 4\\end{aligned}|=97-21k\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $z$ is given by $z=\\frac{{D}_{z}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}5 & -3 & 1 \\\\ 1 & 4 & -1 \\\\ 2 & 3 & 9\\end{aligned}| & =5\\cdot |\\begin{aligned}4 & -1 \\\\ 3 & 9\\end{aligned}|-(-3)\\cdot |\\begin{aligned}1 & -1 \\\\ 2 & 9\\end{aligned}|+1\\cdot |\\begin{aligned}1 & 4 \\\\ 2 & 3\\end{aligned}| \\\\  & =5(36+3)+3(9+2)+(3-8) \\\\  & =195+33-5 \\\\  & =223.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nz=\\frac{{D}_{z}}{D}=\\frac{223}{97-21k}.\n$$\n\nFrom the problem statement, we know that $z=1.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{223}{97-21k} & =1 \\\\ 223 & =97-21k \\\\ 21k & =-126 \\\\ k & =-6.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186329712 #edb/ref 1068 #edb/ref 17592186329396 #edb/ref 17592186045417] [17592186329712 #edb/ref 1069 "q-43124" #edb/ref 17592186045417] [17592186329712 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186329712 #edb/ref 1071 "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}2x+y-z &=1 \\\\ x-2y+2z &=3 \\\\ 3x-2y+z &=2\\end{aligned}\\right.\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $5,$ then $x=$" #edb/ref 17592186045443] [17592186329712 #edb/ref 1072 #uuid "5675fe1a-2882-51dc-95b2-11c432a8cf1f" #edb/ref 17592186045417] [17592186329712 #edb/ref 1074 "First, let's rewrite the system to reveal the coefficients:\n\n$$\n\\left\\{\\begin{aligned}2x+1y+(-1)z &=1 \\\\ 1x+(-2)y+2z &=3 \\\\ 3x+(-2)y+1z &=2.\\end{aligned}\\right.\n$$\n\nWe start by writing the determinant of the coefficients matrix, as follows:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 1 & -1 \\\\ 1 & -2 & 2 \\\\ 3 & -2 & 1\\end{aligned}|=5.\\end{aligned}\n$$\n\nNow, to find ${D}_{x}$, we replace the first column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}1 & 1 & -1 \\\\ 3 & -2 & 2 \\\\ 2 & -2 & 1\\end{aligned}| & =1\\cdot |\\begin{aligned}-2 & 2 \\\\ -2 & 1\\end{aligned}|-1\\cdot |\\begin{aligned}3 & 2 \\\\ 2 & 1\\end{aligned}|+(-1)\\cdot |\\begin{aligned}3 & -2 \\\\ 2 & -2\\end{aligned}| \\\\  & =(-2-(-4))-(3-4)-(-6-(-4)) \\\\  & =2+1+2 \\\\  & =5.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D}=\\frac{5}{5}=1.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186339195 #edb/ref 1080 "\\frac{11}{18}" #edb/ref 17592186045417] [17592186339195 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186339195 #edb/ref 1083 #uuid "082ecf9b-b55d-5307-a0f7-1da37a068915" #edb/ref 17592186045417] [17592186339230 #edb/ref 1080 "k=4" #edb/ref 17592186045417] [17592186339230 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186339230 #edb/ref 1083 #uuid "0bb35856-1ec7-5c49-be2d-613b5999c247" #edb/ref 17592186045417] [17592186339342 #edb/ref 1080 "k=7" #edb/ref 17592186045417] [17592186339342 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186339342 #edb/ref 1083 #uuid "182535ed-2c40-52e5-a8ea-da439ad71f39" #edb/ref 17592186045417] [17592186339667 #edb/ref 1080 "\\frac{2}{3}" #edb/ref 17592186045