ertical-align: 0.25em;\"></mjx-mo></mjx-mrow></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">{</mo><mtable columnalign=\"left left\" columnspacing=\"1em\" rowspacing=\".2em\"><mtr><mtd><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>2</mn></mstyle></mrow><mi>x</mi><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>3</mn></mstyle></mrow><mi>y</mi><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></mrow><mi>z</mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mn>1</mn></mstyle></mrow></mtd></mtr><mtr><mtd><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>6</mn></mstyle></mrow><mi>x</mi><mo>+</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mo>−</mo><mn>2</mn></mstyle></mrow><mo stretchy=\"false\">)</mo><mi>y</mi><mo>+</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mo>−</mo><mn>1</mn></mstyle></mrow><mo stretchy=\"false\">)</mo><mi>z</mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mo>−</mo><mn>14</mn></mstyle></mrow></mtd></mtr><mtr><mtd><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>3</mn></mstyle></mrow><mi>x</mi><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></mrow><mi>y</mi><mo>+</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><mo>−</mo><mn>1</mn></mstyle></mrow><mo stretchy=\"false\">)</mo><mi>z</mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"red\"><mn>1</mn></mstyle></mrow><mo>.</mo></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\" fence=\"true\" stretchy=\"true\" symmetric=\"true\"></mo></mrow></math></mjx-assistive-mml></mjx-container></p>\n<p>We start by writing the determinant of the coefficients matrix, as follows:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"100\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 10.495em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D437 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mrow space=\"4\"><mjx-mo class=\"mjx-n\"><mjx-stretchy-v class=\"mjx-c7C\" style=\"height: 3.8em; vertical-align: -1.65em;\"><mjx-ext><mjx-c></mjx-c></mjx-ext><mjx-mark></mjx-mark></mjx-stretchy-v></mjx-mo><mjx-mtable justify=\"right\" style=\"min-width: 5.056em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"padding-right: 0.5em; padding-bottom: 0.2em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-mstyle><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"padding-left: 0.5em; padding-right: 0.5em; padding-bottom: 0.2em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-mstyle><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"padding-left: 0.5em; padding-bottom: 0.2em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-mstyle><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr><mjx-mtr><mjx-mtd style=\"padding-right: 0.5em; padding-top: 0.2em; padding-bottom: 0.2em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn></mjx-mstyle><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"padding: 0.2em 0.5em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-mstyle><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"padding-left: 0.5em; padding-top: 0.2em; padding-bottom: 0.2em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-mstyle><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr><mjx-mtr><mjx-mtd style=\"padding-right: 0.5em; padding-top: 0.2em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-mstyle><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"padding-left: 0.5em; padding-right: 0.5em; padding-top: 0.2em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-mstyle><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"padding-left: 0.5em; padding-top: 0.2em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-mstyle><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable><mjx-mo class=\"mjx-n\"><mjx-stretchy-v class=\"mjx-c7C\" style=\"height: 3.8em; vertical-align: -1.65em;\"><mjx-ext><mjx-c></mjx-c></mjx-ext><mjx-mark></mjx-mark></mjx-stretchy-v></mjx-mo></mjx-mrow><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c37\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right\" columnspacing=\"\" rowspacing=\"3pt\"><mtr><mtd><mi>D</mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">|</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mstyle mathcolor=\"blue\"><mn>2</mn></mstyle></mtd><mtd><mstyle mathcolor=\"blue\"><mn>3</mn></mstyle></mtd><mtd><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></mtd></mtr><mtr><mtd><mstyle mathcolor=\"blue\"><mn>6</mn></mstyle></mtd><mtd><mstyle mathcolor=\"blue\"><mo>−</mo><mn>2</mn></mstyle></mtd><mtd><mstyle mathcolor=\"blue\"><mo>−</mo><mn>1</mn></mstyle></mtd></mtr><mtr><mtd><mstyle mathcolor=\"blue\"><mn>3</mn></mstyle></mtd><mtd><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></mtd><mtd><mstyle mathcolor=\"blue\"><mo>−</mo><mn>1</mn></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow><mo>=</mo><mn>27.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Now, to find <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"101\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D437 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msub></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>D</mi><mi>z</mi></msub></math></mjx-assistive-mml></mjx-container>, we replace the third column by the right-hand side of the system, and calculate the determinant:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"102\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 28.351em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\