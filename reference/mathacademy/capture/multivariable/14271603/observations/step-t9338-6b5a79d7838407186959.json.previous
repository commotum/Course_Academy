59ex\" height=\"2.009ex\" style=\"vertical-align: -0.671ex; margin-left: -0.089ex;\" viewBox=\"-38.5 -576.1 542 865.1\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-34-Title\">\n<title id=\"MathJax-SVG-34-Title\">p</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E34-MJMATHI-70\" d=\"M23 287Q24 290 25 295T30 317T40 348T55 381T75 411T101 433T134 442Q209 442 230 378L240 387Q302 442 358 442Q423 442 460 395T497 281Q497 173 421 82T249 -10Q227 -10 210 -4Q199 1 187 11T168 28L161 36Q160 35 139 -51T118 -138Q118 -144 126 -145T163 -148H188Q194 -155 194 -157T191 -175Q188 -187 185 -190T172 -194Q170 -194 161 -194T127 -193T65 -192Q-5 -192 -24 -194H-32Q-39 -187 -39 -183Q-37 -156 -26 -148H-6Q28 -147 33 -136Q36 -130 94 103T155 350Q156 355 156 364Q156 405 131 405Q109 405 94 377T71 316T59 280Q57 278 43 278H29Q23 284 23 287ZM178 102Q200 26 252 26Q282 26 310 49T356 107Q374 141 392 215T411 325V331Q411 405 350 405Q339 405 328 402T306 393T286 380T269 365T254 350T243 336T235 326L232 322Q232 321 229 308T218 264T204 212Q178 106 178 102Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E34-MJMATHI-70\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> does not divide <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.644ex\" height=\"2.509ex\" style=\"vertical-align: -0.671ex;\" viewBox=\"0 -791.3 708 1080.4\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-35-Title\">\n<title id=\"MathJax-SVG-35-Title\">b,</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E35-MJMATHI-62\" d=\"M73 647Q73 657 77 670T89 683Q90 683 161 688T234 694Q246 694 246 685T212 542Q204 508 195 472T180 418L176 399Q176 396 182 402Q231 442 283 442Q345 442 383 396T422 280Q422 169 343 79T173 -11Q123 -11 82 27T40 150V159Q40 180 48 217T97 414Q147 611 147 623T109 637Q104 637 101 637H96Q86 637 83 637T76 640T73 647ZM336 325V331Q336 405 275 405Q258 405 240 397T207 376T181 352T163 330L157 322L136 236Q114 150 114 114Q114 66 138 42Q154 26 178 26Q211 26 245 58Q270 81 285 114T318 219Q336 291 336 325Z\"></path>\n<path stroke-width=\"1\" id=\"E35-MJMAIN-2C\" d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E35-MJMATHI-62\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E35-MJMAIN-2C\" x=\"429\" y=\"0\"></use>\n</g>\n</svg></span> we get that <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"4.815ex\" height=\"2.843ex\" style=\"vertical-align: -0.838ex; margin-left: -0.089ex;\" viewBox=\"-38.5 -863.1 2072.9 1223.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-36-Title\">\n<title id=\"MathJax-SVG-36-Title\">p \\: | \\: a.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E36-MJMATHI-70\" d=\"M23 287Q24 290 25 295T30 317T40 348T55 381T75 411T101 433T134 442Q209 442 230 378L240 387Q302 442 358 442Q423 442 460 395T497 281Q497 173 421 82T249 -10Q227 -10 210 -4Q199 1 187 11T168 28L161 36Q160 35 139 -51T118 -138Q118 -144 126 -145T163 -148H188Q194 -155 194 -157T191 -175Q188 -187 185 -190T172 -194Q170 -194 161 -194T127 -193T65 -192Q-5 -192 -24 -194H-32Q-39 -187 -39 -183Q-37 -156 -26 -148H-6Q28 -147 33 -136Q36 -130 94 103T155 350Q156 355 156 364Q156 405 131 405Q109 405 94 377T71 316T59 280Q57 278 43 278H29Q23 284 23 287ZM178 102Q200 26 252 26Q282 26 310 49T356 107Q374 141 392 215T411 325V331Q411 405 350 405Q339 405 328 402T306 393T286 380T269 365T254 350T243 336T235 326L232 322Q232 321 229 308T218 264T204 212Q178 106 178 102Z\"></path>\n<path stroke-width=\"1\" id=\"E36-MJMAIN-7C\" d=\"M139 -249H137Q125 -249 119 -235V251L120 737Q130 750 139 750Q152 750 159 735V-235Q151 -249 141 -249H139Z\"></path>\n<path stroke-width=\"1\" id=\"E36-MJMATHI-61\" d=\"M33 157Q33 258 109 349T280 441Q331 441 370 392Q386 422 416 422Q429 422 439 414T449 394Q449 381 412 234T374 68Q374 43 381 35T402 26Q411 27 422 35Q443 55 463 131Q469 151 473 152Q475 153 483 153H487Q506 153 506 144Q506 138 501 117T481 63T449 13Q436 0 417 -8Q409 -10 393 -10Q359 -10 336 5T306 36L300 51Q299 52 296 50Q294 48 292 46Q233 -10 172 -10Q117 -10 75 30T33 157ZM351 328Q351 334 346 350T323 385T277 405Q242 405 210 374T160 293Q131 214 119 129Q119 126 119 118T118 106Q118 61 136 44T179 26Q217 26 254 59T298 110Q300 114 325 217T351 328Z\"></path>\n<path stroke-width=\"1\" id=\"E36-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E36-MJMATHI-70\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E36-MJMAIN-7C\" x=\"725\" y=\"0\"></use>\n <use xlink:href=\"#E36-MJMATHI-61\" x=\"1226\" y=\"0\"></use>\n <use xlink:href=\"#E36-MJMAIN-2E\" x=\"1755\" y=\"0\"></use>\n</g>\n</svg></span></em>   </p>\n</blockquote>\n<!--\nLet's see some examples. Which of the following statement are true?\n\n<ol class=\"questionStatements\">\n<li>  If [math]7 \\: | \\: 21a[/math] then [math]7 \\: | \\: a[/math] </li>\n<li>  If [math]13 \\: | \\: 15a[/math] then [math]13 \\: | \\: a[/math] </li>\n<li>  If [math]23 \\: | \\: 8a[/math] then [math]23 \\: | \\: a[/math] </li>\n</ol>\n\n* Statement I is false. For example, let [math]a=2.[/math] Then, [math]a[/math] is not divisible by [math]7[/math] but [math]21a=42[/math] is still divisible by [math]7.[/math] \n\n* Statement II is true. As [math]13[/math] is prime and [math]13 \\: | \\: 15a,[/math] we must have [math]13 \\: | \\: 15[/math] or [math]13 \\: | \\: a.[/math] Since [math]15[/math] is not divisible by [math]13,[/math] we obtain that [math]a[/math] must be divisible by [math]13.[/math]\n\n* Statement III is true. As [math]23[/math] is prime and [math]23 \\: | \\: 8a,[/math] we must have [math]23 \\: | \\: 8[/math] or [math]23 \\: | \\: a.[/math] Since [math]8[/math] is not divisible by [math]23,[/math] we obtain that [math]a[/math] must be divisible by [math]23.[/math]\n\n-->\n           \n                </div>        \n                    \n            </div>",
