    "q-221387": {
      "dom_id": "step-q221387",
      "name": "Question 1",
      "problem": "Let $s$ and $t$ be prime numbers. If ${t}^{2}∣{s}^{4},$ then{{field-1}}.",
      "worked_solution": "For any integers $m$ and $n$ and any prime numbers $s$ and $t,$ we have that\n\n$$\n{s}^{m}∣{t}^{n}\\,\\text{or}\\,{t}^{n}∣{s}^{m}\\,⟹\\,s=t.\n$$",
