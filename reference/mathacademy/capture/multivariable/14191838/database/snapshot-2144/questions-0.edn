#{[{:db/id #edb/ref 17592186124811 :knowledge-point/_questions [{:db/id #edb/ref 17592186124646 :knowledge-point/id #uuid "3ee9cbe8-ad40-5155-b42d-1802f36adf27" :knowledge-point/title "Identifying the Global Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40d51ffd-3c87-5270-834d-5cb8714970fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,2,2)$ and $(-1,-2,1)$" :db/id #edb/ref 17592186434670} {:answer/id #uuid "87e76412-257f-5583-a7e9-47e4ed2af022" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,2,2)$ and $(0,-1,0)$" :db/id #edb/ref 17592186434692} {:answer/id #uuid "acec2003-faf8-5414-9547-98be22326726" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,2,2)$ only" :db/id #edb/ref 17592186434707} {:answer/id #uuid "d277550a-a25f-5521-be5b-be206e9c7195" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,-2,1)$ only" :db/id #edb/ref 17592186434721} {:answer/id #uuid "fd7d1370-1b00-5b14-93b1-c569a931408e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,3,0)$ only" :db/id #edb/ref 17592186434735}] :answer-field/correct {:answer/id #uuid "acec2003-faf8-5414-9547-98be22326726" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,2,2)$ only" :db/id #edb/ref 17592186434707} :answer-field/id #uuid "7b1e393d-2ed4-5869-b1f2-5c448966ff34" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121463}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4d4d9349-42bf-5237-9227-2e25538cab7c" :question/math-academy-id "q-162705" :question/problem "![](images/89/897d0472039c499aee543a320f74b13bf1887f8b170ce1167a6c808d933ec676.png)\n\nThe graph $z=f(x,y)$ is shown above. What are the global maximum points of the function?" :question/worked-solution "First, we recall the following definitions:\n\n- The global maximum of a function is the largest value it attains on its domain. There can only be (at most) one global maximum.\n\n- A global maximum point is a point $(x,y,z)$ where a function reaches a global maximum. There can be zero, one, or many global maximum points.\n\nFor our function, the maximum value reached by the function is $f(x,y)=2.$ Therefore, the global maximum is $2.$ The function reaches this value when $(x,y)=(1,2),$ so the global maximum point is $(1,2,2).$\n\n![](images/69/690d407982bfa9cde8fdce5b187006af1c24f9080a0cfea77e7551ca1d5cd940.png)"}] [{:db/id #edb/ref 17592186401426 :knowledge-point/_questions [{:db/id #edb/ref 17592186124646 :knowledge-point/id #uuid "3ee9cbe8-ad40-5155-b42d-1802f36adf27" :knowledge-point/title "Identifying the Global Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d12bfd22-9e9d-5d37-bbd0-35e563e5e30a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,0,-2)$ and $(2,3,0)$" :db/id #edb/ref 17592186401428} {:answer/id #uuid "99f7cc57-ad3a-5493-ba20-b02d01c3c072" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-2,1.2)$  only" :db/id #edb/ref 17592186401429} {:answer/id #uuid "7d4d1de4-cb9d-5b3a-b919-1ee28c961db6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,3,0)$  only" :db/id #edb/ref 17592186401430} {:answer/id #uuid "27f2d2ad-7cab-5c68-bfaf-a31ab980901d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,1,3)$ only" :db/id #edb/ref 17592186401431} {:answer/id #uuid "d947cbda-24ab-58ef-b437-c399ba283d13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-2,1.2)$ and $(-2,1,3)$" :db/id #edb/ref 17592186401432}] :answer-field/correct {:answer/id #uuid "27f2d2ad-7cab-5c68-bfaf-a31ab980901d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-2,1,3)$ only" :db/id #edb/ref 17592186401431} :answer-field/id #uuid "32d7053b-a2c6-58ee-8efc-3a03178f6bd3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401427}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c163c8c-12fc-59a2-9e1d-9f264f8ad03a" :question/math-academy-id "q-163834" :question/problem "![](images/21/215b322e06280dd01e5858df9a17cd56673b5cdec69521decca205e03771ac21.png)\n\nThe graph $z=f(x,y)$ is shown above. What are the global maximum points of the function?" :question/worked-solution "First, we recall the following definitions:\n\n- The global maximum of a function is the largest value it attains on its domain. There can only be (at most) one global maximum.\n\n- A global maximum point is a point $(x,y,z)$ where a function reaches a global maximum. There can be zero, one, or many global maximum points.\n\nFor our function, the maximum value reached by the function is $f(x,y)=3.$ Therefore, the global maximum is $3.$ The function reaches this value when $(x,y)=(-2,1),$ so the global maximum point is $(-2,1,3).$\n\n![](images/d5/d5f948483a80f37257b285d48cd1e6bbf1d8a6ba9b66d1fea5edd865c787711a.png)"}] [{:db/id #edb/ref 17592186284447 :knowledge-point/_questions [{:db/id #edb/ref 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a548b762-254d-5503-9bdc-ee9b3db0343c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465537} {:answer/id #uu