eld/id #uuid "62bb3be7-ac04-517e-97e6-83c3aca76a8c" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466614} {:answer-field/choices [{:answer/id #uuid "9951cfdd-e926-5c89-b9b0-0744d28851f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465543} {:answer/id #uuid "3032c93e-22e6-5f71-81c9-c6bdd88b04e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465544}] :answer-field/correct {:answer/id #uuid "9951cfdd-e926-5c89-b9b0-0744d28851f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465543} :answer-field/id #uuid "48758690-7815-5e22-aea8-571e2ab0e1ff" :answer-field/key "D" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466615}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "140468c2-8315-56a7-adfc-2601c4482a06" :question/math-academy-id "q-164150" :question/problem "![](images/fd/fdfae6a5a321d1dbc235d06438847d5a0cc471fa4e31575f36c3967dca239824.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local minimum points?\n\nSelect all that apply." :question/worked-solution "A function $f(x,y)$ has a local minimum point at $(a,b)$ if $f(x,y)\\ge f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the lowest point on the graph in the neighborhood.\n\nSuch neighborhood exists for the point $B.$ Hence, $B$ is a local minimum.\n\n![](images/82/82291f89bd32f3a3a20d39dfc89de91b2f673bec7c802cebf6d5fa3b4136ace1.png)"}] [{:db/id #edb/ref 17592186434756 :knowledge-point/_questions [{:db/id #edb/ref 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d6a8563-51e7-5f75-b1f9-5030c16e40a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186434680} {:answer/id #uuid "671887d0-2723-5a15-b0f2-b1adf3728767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $D$ only" :db/id #edb/ref 17592186434684} {:answer/id #uuid "7eb013d8-4bec-59b6-be78-16c6b4278be3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function does not have local minima" :db/id #edb/ref 17592186434688} {:answer/id #uuid "7ec46caa-3ab4-5a82-8cef-51349b889f2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186434689} {:answer/id #uuid "c579e011-3bca-5b23-92a7-a4c2a45142bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ and $D$ only" :db/id #edb/ref 17592186434716}] :answer-field/correct {:answer/id #uuid "671887d0-2723-5a15-b0f2-b1adf3728767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $D$ only" :db/id #edb/ref 17592186434684} :answer-field/id #uuid "caaf0180-b775-51a5-8357-5dbad212c145" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434747}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73e92678-31f3-525b-9096-a06391739cab" :question/math-academy-id "q-164151" :question/problem "![](images/f7/f7429a2fc291fc9e14685208288f670cca341a260ac13b358c52d99c35e13b4f.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local minimum points?" :question/worked-solution "A function $f(x,y)$ has a local minimum point at $(a,b)$ if $f(x,y)\\ge f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the lowest point on the graph in the neighborhood.\n\nSuch neighborhoods exist for the points $A$ and $D.$ Hence, $A$ and $D$ are local minima.\n\n![](images/b8/b8952aa59c9351c9723cd62f35073d46d7ddfd46afa9a9b3ddae7ce149065c59.png)"}] [{:db/id #edb/ref 17592186434761 :knowledge-point/_questions [{:db/id #edb/ref 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2683d2d1-d298-565b-a7c7-9a4e0ec1b79e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186434665} {:answer/id #uuid "3674a427-b1f6-5423-9cad-a53248cc1526" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186434668} {:answer/id #uuid "3af27a0e-03ce-5737-81df-4b4e8b4ce792" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ and $D$ only" :db/id #edb/ref 17592186434669} {:answer/id #uuid "867414de-477d-5e96-ac86-a8231e8e612f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186434691} {:answer/id #uuid "ecbd6041-7dad-5acb-839a-6742c3614749" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function does not have local maxima" :db/id #edb/ref 17592186434727}] :answer-field/correct {:answer/id #uuid "3674a427-b1f6-5423-9cad-a53248cc1526" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186434668} :answer-field/id #uuid "2bbf6504-629f-56a6-8d02-ea8b2cdc4409" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186434737}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c719ba47-2cb2-55e7-85ae-fa0a3ade984e" :question/math-academy-id "q-164153" :question/problem "![](images/79/79971602dd6834147c3db9361c94853a5a66c8e899978df3629d2841326fe62c.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local maximum points?" :question/worked-solution "A function $f(x,y)$ has a local maximum point at $(a,b)$ if $f(x,y)\\le f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the highest point on the graph in the neighborhood.\n\nSuch neighborhood exists for the point $B.$ Hence, $B$ is a local maximum.\n\n![](images/68/685c03b86db93032c8a79334c5fa46c561dd263a9aa4f52b9d7e6f41c3bb827c.png)"}]}
