row data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msubsup><msup><mi>ρ</mi><mn>4</mn></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>ρ</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><msup><mi>cos</mi><mn>3</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>ϕ</mi></mrow><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mi>ϕ</mi><mo>=</mo><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>ϕ</mi><mo>=</mo><mi>π</mi></mrow></msubsup><mo>⋅</mo><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">[</mo></mrow><mi>θ</mi><msubsup><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">]</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mi>θ</mi><mo>=</mo><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>θ</mi><mo>=</mo><mn>2</mn><mi>π</mi></mrow></msubsup><mo>⋅</mo><msubsup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>5</mn></mfrac></mstyle><msup><mi>ρ</mi><mn>5</mn></msup><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mi>ρ</mi><mo>=</mo><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>ρ</mi><mo>=</mo><mn>2</mn></mrow></msubsup><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>ρ</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mi>π</mi><mo>−</mo><mn>0</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>5</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>32</mn><mo>−</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mn>3</mn></mfrac></mstyle><mo>⋅</mo><mn>2</mn><mi>π</mi><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>32</mn><mn>5</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>128</mn><mi>π</mi></mrow><mn>15</mn></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
