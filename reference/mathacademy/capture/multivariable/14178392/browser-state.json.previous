              "value": "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\pi }{\\int }_{0}^{3}{\\rho }^{3}\\operatorname{cos}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ",
              "html": " <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"4\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle><mjx-msubsup><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c222B TEX-S2\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: -0.896em; margin-left: -0.388em;\"><mjx-texatom size=\"s\" texclass=\"ORD\" style=\"margin-left: 0.647em;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70B TEX-I\"></mjx-c></mjx-mi></mjx-texatom><mjx-spacer style=\"margin-top: 1.506em;\"></mjx-spacer><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-texatom></mjx-script></mjx-msubsup><mjx-msubsup space=\"2\"><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c222B TEX-S2\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: -0.896em; margin-left: -0.388em;\"><mjx-texatom size=\"s\" texclass=\"ORD\" style=\"margin-left: 0.647em;\"><mjx-mstyle style=\"background-color: gainsboro;\"><mjx-mpadded><mjx-block style=\"width: 0.97em; margin: 0.2em 0px; position: relative;\"><mjx-rbox style=\"left: 0.2em; top: 0px; max-width: 0.97em;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70B TEX-I\"></mjx-c></mjx-mi></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle></mjx-texatom><mjx-spacer style=\"margin-top: 1.223em;\"></mjx-spacer><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mstyle style=\"background-color: gainsboro;\"><mjx-mpadded><mjx-block style=\"width: 0.9em; margin: 0.2em 0px; position: relative;\"><mjx-rbox style=\"left: 0.2em; top: 0px; max-width: 0.9em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle></mjx-texatom></mjx-script></mjx-msubsup><mjx-msubsup space=\"2\"><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c222B TEX-S2\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: -0.896em; margin-left: -0.388em;\"><mjx-texatom size=\"s\