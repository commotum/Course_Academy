      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14178392/observations/step-q161771-ad4f074dd5fe93587da5.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14178392/observations/step-q161771-ad4f074dd5fe93587da5.png",
      "source_url": "https://mathacademy.com/tasks/14178392/topics/2060/review",
      "captured_at": 1791913628.8473117,
      "math_academy_id": "q-161771",
      "topic_id": "2060",
      "sequence_position": null,
      "source_step": {
