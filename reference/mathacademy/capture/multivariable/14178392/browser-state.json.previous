      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14178392/observations/step-q161765-9468de4231971120eb2e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14178392/observations/step-q161765-9468de4231971120eb2e.png",
      "source_url": "https://mathacademy.com/tasks/14178392/topics/2060/review",
      "captured_at": 1791913608.3885274,
      "math_academy_id": "q-161765",
