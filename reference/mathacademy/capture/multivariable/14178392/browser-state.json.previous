>Δ</mi></munder><mi>ρ</mi><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>ϕ</mi><mo>⋅</mo><msup><mi>ρ</mi><mn>2</mn></msup><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>ϕ</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>ρ</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>θ</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>ϕ</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>π</mi></mrow></msubsup><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mstyle mathcolor=\"blue\"><mo>−</mo><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mstyle></mpadded></mstyle></mrow><mrow data-mjx-texclass=\"ORD\"><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mstyle mathcolor=\"blue\"><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mstyle></mpadded></mstyle></mrow></msubsup><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow></msubsup><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mstyle mathcolor=\"blue\"><msup><mi>ρ</mi><mn>3</mn></msup><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>ϕ</mi></mstyle></mpadded></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"