#{[{:activity/expected-seconds 1500.0 :activity/first-step {:db/id #edb/ref 17592186148392} :activity/id #uuid "0d7d228b-78f0-507d-898b-cc2078977de4" :activity/scope {:db/id #edb/ref 17592186048131 :topic/id #uuid "81e52842-e868-5110-93ce-65b6024b5770" :topic/math-academy-id 2533} :activity/steps [{:db/id #edb/ref 17592186148392 :step/content {:db/id #edb/ref 17592186148771 :tutorial/content "There are three types of equilibrium solutions for an *autonomous* differential equation of the form\n\n$$\n\\dfrac{\\mathrm{d}y}{\\mathrm{d}x} = f(y),\n$$\n\nwhere the right-hand side doesn't depend explicitly on $x.$\nWe can classify each using the differential equation's phase line.\n\nLet's see each type, and classify the equilibrium solutions for the differential equation whose phase line is shown below.\n\n![](images/c6/c6fc21e9c83b98e055751ebd4062a3019687a885e2561191ec2d0bfd9de36a85.png)\n\n- An equilibrium solution is a **sink** if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\nFor the phase line above, $y=2$ is a sink.\n\n- An equilibrium solution is a **source** if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution. \nFor the phase line above, $y=0$ is a source.\n\n- An equilibrium solution is a **node** if the arrows directly above and below it on the phase line point in the same direction.\nFor the phase line above, $y=-2$ is a node since the arrows above and below it both point downward." :tutorial/id #uuid "2f2f0bc9-a043-5c8e-92aa-88135e4033a9" :tutorial/math-academy-id 5572 :tutorial/title "Introduction"} :step/id #uuid "2e343aa9-f699-5b3e-a382-effdfef6dd15" :step/math-academy-id 594276 :step/next {:db/id #edb/ref 17592186148393}} {:db/id #edb/ref 17592186148393 :step/content {:db/id #edb/ref 17592186147494 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147389 :question/id #uuid "bb252f4f-ef82-52bc-a485-f88f0de96173" :question/math-academy-id "e-8650"} :knowledge-point/id #uuid "680a42fd-9b70-5fb2-916c-d10b71b11d82" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049741}] :knowledge-point/questions [{:db/id #edb/ref 17592186148222} {:db/id #edb/ref 17592186148227} {:db/id #edb/ref 17592186314815} {:db/id #edb/ref 17592186362313} {:db/id #edb/ref 17592186362314} {:db/id #edb/ref 17592186362315} {:db/id #edb/ref 17592186362316} {:db/id #edb/ref 17592186395535}] :knowledge-point/title "Classifying Equilibrium Points Using Phase Lines"} :step/id #uuid "29698ec0-1dda-5f69-bb67-f92175c1a371" :step/math-academy-id 594277 :step/next {:db/id #edb/ref 17592186148394}} {:db/id #edb/ref 17592186148394 :step/content {:db/id #edb/ref 17592186147495 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147387 :question/id #uuid "7aa0a0a8-05d4-532c-a830-f1df43514fdf" :question/math-academy-id "e-8538"} :knowledge-point/id #uuid "4535b48e-a33f-5f62-95d3-a5c0991c1f6d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049905}] :knowledge-point/questions [{:db/id #edb/ref 17592186148223} {:db/id #edb/ref 17592186148228} {:db/id #edb/ref 17592186314829} {:db/id #edb/ref 17592186314830} {:db/id #edb/ref 17592186314831} {:db/id #edb/ref 17592186314832} {:db/id #edb/ref 17592186362318} {:db/id #edb/ref 17592186362319} {:db/id #edb/ref 17592186362322} {:db/id #edb/ref 17592186375611}] :knowledge-point/title "Classifying Equilibrium Points Using a Graph"} :step/id #uuid "f7615658-7aa8-5de3-95ff-2d74b5889e16" :step/math-academy-id 594280 :step/next {:db/id #edb/ref 17592186148395}} {:db/id #edb/ref 17592186148395 :step/content {:db/id #edb/ref 17592186147496 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147385 :question/id #uuid "eed50b24-e97c-51c9-b625-3327783b6374" :question/math-academy-id "e-8536"} :knowledge-point/id #uuid "b114a373-697f-5005-bb1b-46202547a905" :knowledge-point/questions [{:db/id #edb/ref 17592186148220} {:db/id #edb/ref 17592186148229} {:db/id #edb/ref 17592186314936} {:db/id #edb/ref 17592186360683} {:db/id #edb/ref 17592186362323} {:db/id #edb/ref 17592186362324} {:db/id #edb/ref 17592186362325} {:db/id #edb/ref 17592186362326} {:db/id #edb/ref 17592186362327} {:db/id #edb/ref 17592186362328} {:db/id #edb/ref 17592186362329} {:db/id #edb/ref 17592186374986}] :knowledge-point/title "Classifying the Equilibrium Points of a Given Differential Equation"} :step/id #uuid "060c8c47-3b5f-5a36-b80e-757102d6f065" :step/math-academy-id 594283 :step/next {:db/id #edb/ref 17592186148396}} {:db/id #edb/ref 17592186148396 :step/content {:db/id #edb/ref 17592186147497 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147386 :question/id #uuid "dba1deed-4311-54fe-a690-8d89d4cb9592" :question/math-academy-id "e-8537"} :knowledge-point/id #uuid "b58b04cc-da5e-5c51-a583-0663d783c697" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049722}] :knowledge-point/questions [{:db/id #edb/ref 17592186148221} {:db/id #edb/ref 17592186148230} {:db/id #edb/ref 17592186314938} {:db/id #edb/ref 17592186362330} {:db/id #edb/ref 17592186362331} {:db/id #edb/ref 17592186362332} {:db/id #edb/ref 17592186391755} {:db/id #edb/ref 17592186395542} {:db/id #edb/ref 17592186395549} {:db/id #edb/ref 17592186395556} {:db/id #edb/ref 17592186395563} {:db/id #edb/ref 17592186414153}] :knowledge-point/title "Identifying Slope Fields Corresponding to Some Equilibrium Point Classifications"} :step/id #uuid "5b0fcd37-0446-59cb-b89e-24c477e9a1cc" :step/math-academy-id 594286}] :activity/title "Classifying Equilibrium Solutions of First-Order ODEs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186147712}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186414157} :activity/id #uuid "8f67b1d8-cc12-5be2-bedd-7d8ea39d1438" :activity/scope {:db/id #edb/ref 17592186048131 :topic/id #uuid "81e52842-e868-5110-93ce-65b6024b5770" :topic/math-academy-id 2533} :activity/steps [{:db/id #edb/ref 17592186414154 :step/content {:db/id #edb/ref 17592186314831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "463df15c-5e98-5585-9c0e-3ceb78f63f4b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467142} {:answer/id #uuid "9c48c703-8eb3-5e1a-bf9b-43c59c2b0628" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467143}] :answer-field/correct {:db/id #edb/ref 17592186467142} :answer-field/id #uuid "e974aded-bb59-5eb7-91a9-b986f8275520" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468292} {:answer-field/choices [{:answer/id #uuid "435fd677-3e77-505c-8238-4922b6ce07b8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467144} {:answer/id #uuid "c641b6ca-e405-5c2a-85db-dd0a74418ae6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467145}] :answer-field/correct {:db/id #edb/ref 17592186467144} :answer-field/id #uuid "f2b04eed-063d-534c-b713-a7b132e0c86d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468293} {:answer-field/choices [{:answer/id #uuid "ddeaf159-2715-57f8-9991-d2da5b57dbf9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186467146} {:answer/id #uuid "91d20914-0764-54d3-9d56-9a3b6a00b760" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186467147}] :answer-field/correct {:db/id #edb/ref 17592186467147} :answer-field/id #uuid "1d08b7a2-aa58-5bad-9650-971b2a861ebb" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186468294}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a963a554-e172-5944-b345-2fca4048d858" :question/math-academy-id "q-339709" :question/problem "![](images/78/78c4fafeaa4015c98d2a1817e47556957e00c87e265ca934c361a5f5941b6419.png)\n\nConsider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(y)$ where the graph of $f(y)$ is shown above. Which of the following statements are true?\n\n- $y=2$ is a node.\n- $y=-2$ is a sink.\n- $y=-2$ is a source.\n\nSelect all that apply." :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nThe phase line that corresponds to the given graph is as follows:\n\n![](images/90/9003cc9588b0838527f018463e2077d2d81bb5930ab70c1e3c713832e207bd99.png)\n\nTherefore, we have:\n\n- Statement I is false. From the phase line, we see that $y=2$ is a sink.\n\n- Statement II is false, while statement III is true. From the phase line, we see that $y=-2$ is a source.\n\nTherefore, the correct answer is \"III only\"."} :step/id #uuid "4301353b-f307-5ad7-9fa6-573ee6bd3b91"} {:db/id #edb/ref 17592186414155 :step/content {:db/id #edb/ref 17592186414153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a8a7f75-ccd9-5462-8bb7-2c7b1be60406" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b5/b5e7a0272bb45b9d83ec8864f58cf3b96cbb6399d079f23d168d8de5416a1c23.png" :db/id #edb/ref 17592186414141} {:answer/id #uuid "5bd318dd-9201-58a9-b18d-379eb2818d97" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8d/8d608e5ab231af991d4c55ca863e95557faae55bf44ad0e8e99f7cd0417531f2.png" :db/id #edb/ref 17592186414142} {:answer/id #uuid "80ba1f07-d31e-5ece-ad1d-7de624148041" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/3e/3ed74c49c2218d24dd5235f6a2f6df948d14a58edd6872ccef17ea0434c41c2b.png" :db/id #edb/ref 17592186414146} {:answer/id #uuid "b82bf18a-7b1c-5303-9140-3233520ff812" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/9a/9a24e2ecc59eb8d152790c6850403f74fe9193cc9e3dd9f3d6ff6f38e494752d.png" :db/id #edb/ref 17592186414148} {:answer/id #uuid "bb6b5c8a-efde-53a2-864f-7808884654c5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ae/ae926b04f1a8bb8c22cd72208b6416aa443e864083dbe4d8c2c737c049ead4f8.png" :db/id #edb/ref 17592186414149}] :answer-field/correct {:db/id #edb/ref 17592186414141} :answer-field/id #uuid "1c0eb52d-5859-5f17-a2af-047313c84ebc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414151}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "57d5be79-8453-52cc-b08d-ee25cf4792e4" :question/math-academy-id "q-98812" :question/problem "A particular autonomous differential equation has the following properties:\n\n- $y=-3$ is a sink\n\n- $y=0$ is a source\n\n- $y=3$ is a sink\n\nWhich of the following could be the slope field of the differential equation?" :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nFirst, we draw the phase line with the given information. \n\nNote that there are $3$ equilibrium points, $y=-3,$ $y=0,$ and $y=3.$\n\n- We're given that $y=-3$ is a sink. We represent this on the phase line by drawing a downward-pointing arrow just above $y=-3$ and an upward-pointing arrow just below it.\n\n- We're given that $y=0$ is a source. We represent this on the phase line by drawing an upward-pointing arrow just above $y=-2$ and a downward-pointing arrow just below it (already drawn by the above property).\n\n- We're given that $y=3$ is a sink. We represent this on the phase line by drawing a downward-pointing arrow just above $y=3$ and an upward-pointing arrow just below it (already drawn by the above property).\n\n![](images/a4/a4d0e0f44f77e0d29d6d226b058806e947b38f4784dc61ea609ac1040b73d7dd.png)\n\nOf the given options, the only slope field that correspond with this phase line is the following:\n\n![](images/b5/b5e7a0272bb45b9d83ec8864f58cf3b96cbb6399d079f23d168d8de5416a1c23.png)\n\nNote that:\n\n- The slope field is horizontal at $y=-3,$ $y=0,$ and $y=3.$\n\n- The slopes near $y=-3$ appear to converge toward this line.\n\n- The slopes near $y=0$ appear to diverge away from this line.\n\n- The slopes near $y=3$ appear to converge toward this line."} :step/id #uuid "4bcfd21f-7077-56a5-b180-c56af3baefcb" :step/next {:db/id #edb/ref 17592186414154}} {:db/id #edb/ref 17592186414156 :step/content {:db/id #edb/ref 17592186362326 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c7472dd-4374-53b0-ab00-c75e67df452a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a sink" :db/id #edb/ref 17592186361116} {:answer/id #uuid "7a5472b2-d6d6-52ea-a044-09bb2a1127bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a node" :db/id #edb/ref 17592186361376} {:answer/id #uuid "858d2406-7a62-530d-b3f3-7ae4483ae919" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a source" :db/id #edb/ref 17592186361434} {:answer/id #uuid "880f5f32-2604-52b9-a6aa-0210178b0d4d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a source and $y=-3$ is a sink" :db/id #edb/ref 17592186361442} {:answer/id #uuid "94cbc50d-4636-5057-ad39-889859bff52e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a sink and $y=-3$ is a source" :db/id #edb/ref 17592186361497}] :answer-field/correct {:db/id #edb/ref 17592186361434} :answer-field/id #uuid "431fc151-9f48-50ea-8f92-91e1f1278462" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362043}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f9765a7a-f1b5-599a-907d-e5751bd4bc1b" :question/math-academy-id "q-98761" :question/problem "Which of the following statements is true regarding the equilibrium solutions of ${y}^{′}=(y-3)({y}^{2}+3y+9)?$" :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nFirst, we need to find the equilibrium solutions. So, we solve $f(y)=0:$\n\n$$\n\\begin{aligned}f(y) & =0 \\\\ (y-3)({y}^{2}+3y+9) & =0\\end{aligned}\n$$\n\nSo, the equilibrium solution is $y=3.$ \n\nNow, we analyze the sign of $f(y)$ using a sign table, as follows:\n\n|  | $(-\\infty ,3)$ | $(3,\\infty )$ |\n| --- | --- | --- |\n| $y-3$ | $-$ | $+$ |\n| ${y}^{2}+3y+9$ | $+$ | $+$ |\n| $f(y)$ | $-$ | $+$ |\n\nSo, we have that $f(y)$ is positive for $y\\in (3,\\infty ),$ and negative for $y\\in (-\\infty ,3).$\n\nWe can now draw the phase line for this equation.\n\n![](images/24/244a46b17ad69e8d7cc3ae4f3d9c3c46c1d6e6a7ea154b849946f8ece6030071.png)\n\nFinally, we classify the equilibrium solution:\n\n- $y=3$ is a source because the nearby solutions diverge away from this point.\n\nTherefore, the correct answer is \"$y=3$ is a source\"."} :step/id #uuid "4cca875a-cd23-5293-b9eb-53796fc6ca53" :step/next {:db/id #edb/ref 17592186414158}} {:db/id #edb/ref 17592186414157 :step/content {:db/id #edb/ref 17592186148223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00f13d25-8aaa-53fe-b649-79f759aca692" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460461} {:answer/id #uuid "9b5118f7-bea8-56bb-9fa7-7066d9d15341" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460462}] :answer-field/correct {:db/id #edb/ref 17592186460461} :answer-field/id #uuid "0ed60369-6527-596a-aa20-10745731f2e3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461097} {:answer-field/choices [{:answer/id #uuid "58384368-2e9c-513d-884f-c895ead26452" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460463} {:answer/id #uuid "8ab5835d-dd16-5c59-b329-2d76fad3fea1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460464}] :answer-field/correct {:db/id #edb/ref 17592186460464} :answer-field/id #uuid "9c4a2a63-53b5-5ff5-adec-a8a211a46343" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461098} {:answer-field/choices [{:answer/id #uuid "e56d3d31-42e8-5b71-9337-634db804ceee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460465} {:answer/id #uuid "5632df88-4d15-5fcb-8683-ca20c35ee138" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460466}] :answer-field/correct {:db/id #edb/ref 17592186460465} :answer-field/id #uuid "b652d627-c7ef-5e71-8927-79a18df27daa" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461099}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "68af5d21-8052-5193-93c5-650cda389ee6" :question/math-academy-id "q-96560" :question/problem "![](images/93/936d303dcc89c5c27e77fa3d7cfc8b63643284d9e203f176c9e0c5588c27e049.png)\n\nConsiderer the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(y)$ where the graph of $f(y)$ is shown above. Which of the following statements are true?\n\n- $y=1$ is a node.\n- $y=-2$ is a sink.\n- $y=3$ is a source.\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nThe phase line that corresponds to the given graph is as follows:\n\n![](images/69/69e895d4091075f6d50eb9e44dc027c342d1fe7ca0269224c9b6a019ab312c77.png)\n\nTherefore, we have:\n\n- Statement I is false. From the phase line, we see that $y=1$ is a source.\n\n- Statement II is true. From the phase line, we see that $y=-2$ is a sink.\n\n- Statement III is false. From the phase line, we see that $y=3$ is a sink.\n\nTherefore, the correct answer is \"II only\"."} :step/id #uuid "d28d673b-fc35-5482-abfa-3f1e7616614a" :step/next {:db/id #edb/ref 17592186414156}} {:db/id #edb/ref 17592186414158 :step/content {:db/id #edb/ref 17592186362330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "037a7d4f-c46b-5ef5-9f12-e499f543ede1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/31/31519aa878fd6a9b450296552afd9bbf628e30db68a2d7c6dc6b02a48ae28b06.png" :db/id #edb/ref 17592186360845} {:answer/id #uuid "0562a68a-9113-579a-9191-136bc8b91243" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a3/a375a537b104f5bcdd8f5951277bce2494d8861a7212772a7d7050fa14091cb9.png" :db/id #edb/ref 17592186360849} {:answer/id #uuid "2f9fb8ad-c027-5308-86ad-a2260380cc77" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d7/d72110682c1959f10546b6fa49d6e4ebedf6b6d5557639c772f28a920f306df5.png" :db/id #edb/ref 17592186361050} {:answer/id #uuid "3b5da285-1e73-5eac-bb63-ee605aca7f27" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/41/41f32a097325dbe2a278da2abe4ef93b13d058ffe49431882fade3bc40bc0f48.png" :db/id #edb/ref 17592186361109} {:answer/id #uuid "bc463e5f-25db-5272-b846-75dffcfba6f4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c7/c7895d3f3db254736c4e20ff30dbe92fb7c0786291b1198ed3f727971268be31.png" :db/id #edb/ref 17592186361677}] :answer-field/correct {:db/id #edb/ref 17592186361109} :answer-field/id #uuid "fd49cbaa-d57f-5e0e-9cec-db71bf257efe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362207}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a2a6368a-0d2f-5f5f-a7f7-7f9694dc9333" :question/math-academy-id "q-98774" :question/problem "A particular autonomous differential equation has the following properties:\n\n- $y=0$ is a source\n\n- $y=-4$ is a sink\n\nWhich of the following could be the slope field of the differential equation?" :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nFirst, we draw the phase line with the given information. \n\nNote that there are $2$ equilibrium points, $y=0$ and $y=-4.$\n\n- We're given that $y=0$ is a source. We represent this on the phase line by drawing an upward-pointing arrow just above $y=0$ and a downward-pointing arrow just below it.\n\n- We're given that $y=-4$ is a sink. We represent this on the phase line by drawing a downward-pointing arrow just above $y=-4$ (already drawn by the above property) and an upward-pointing arrow just below it.\n\n![](images/e5/e5ba765b9caffab904f07c5086d3206f72e36e66cb018673ce7ed44d79d19e88.png)\n\nOf the given options, the only slope field that correspond with this phase line is the following:\n\n![](images/41/41f32a097325dbe2a278da2abe4ef93b13d058ffe49431882fade3bc40bc0f48.png)\n\nNote that:\n\n- The slope field is horizontal at $y=0$ and $y=-4.$\n\n- The slopes near $y=0$ appear to diverge away from this line.\n\n- The slopes near $y=-4$ appear to converge toward this line."} :step/id #uuid "dc1c1dd6-77b7-596c-aadc-9bd547e58f0f" :step/next {:db/id #edb/ref 17592186414155}}] :activity/title "Classifying Equilibrium Solutions of First-Order ODEs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186414140}] [{:activity/course {:db/id #edb/ref 17592186046668} :activity/first-step {:db/id #edb/ref 17592186563765} :activity/id #uuid "1c9dbcb8-61c8-5cf9-96d4-e96bf0a4fe24" :activity/scope {:db/id #edb/ref 17592186048131 :topic/id #uuid "81e52842-e868-5110-93ce-65b6024b5770" :topic/math-academy-id 2533} :activity/steps [{:db/id #edb/ref 17592186563765 :step/content {:db/id #edb/ref 17592186362318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d01b33f2-8671-5b0d-8a00-a92c63ec823d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469960} {:answer/id #uuid "0db0ab70-5d9b-5ca1-96a8-1e2b6c6570ad" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469961}] :answer-field/correct {:db/id #edb/ref 17592186469961} :answer-field/id #uuid "1db18589-06db-5ac2-bf04-cfba198ae3db" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470592} {:answer-field/choices [{:answer/id #uuid "8cae1d0b-65c4-5a6a-855e-7a286a4599be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469962} {:answer/id #uuid "3af7659c-fd25-5191-bb88-4984d69dd78a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469963}] :answer-field/correct {:db/id #edb/ref 17592186469963} :answer-field/id #uuid "5dbf469f-3d99-529e-ab96-27f2f6fb5f4a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470593} {:answer-field/choices [{:answer/id #uuid "25211a31-88db-5913-a8a1-818dcf80975b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186469964} {:answer/id #uuid "4a5bbc31-2856-55be-a056-b3b5ccf8c792" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186469965}] :answer-field/correct {:db/id #edb/ref 17592186469964} :answer-field/id #uuid "051b9c63-8c62-5632-b4f6-e084f88a10b6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186470594}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e1d8d74b-55cf-51de-803f-0cecc60a4fb1" :question/math-academy-id "q-98714" :question/problem "![](images/6b/6b9b15bd3c8cda84156d5461fb9f80f892a1dba26151cc37d381757f9f659fa1.png)\n\nConsider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(y)$ where the graph of $f(y)$ is shown above. Which of the following statements are true?\n\nI. $y=-3$ is a node.\n\nII. $y=2$ is a sink.\n\nIII. $y=2$ is a source.\n\nSelect all that apply." :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nThe phase line that corresponds to the given graph is as follows:\n\n![](images/36/362ffe8871efa8dc597708b039fa766c3603777ba12460e84d9af1fc39800288.png)\n\nTherefore, we have:\n\n- Statement I is true. From the phase line, we see that $y=-3$ is a node.\n\n- Statement II is true, while statement III is false. From the phase line, we see that $y=2$ is a sink.\n\nTherefore, the correct answer is \"I and II only\"."} :step/id #uuid "0e849385-5c84-5ebb-9c6a-2fbbf98e75fc" :step/next {:db/id #edb/ref 17592186563792}} {:db/id #edb/ref 17592186563773 :step/content {:db/id #edb/ref 17592186314938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d547b80-0952-51a1-876e-e4e3237a133b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c7/c7e7fd7cbf8c3f2f9b68f0af3ecfbdb616730dc7b7cc3b03aa6f35228843080e.png" :db/id #edb/ref 17592186312195} {:answer/id #uuid "45f2ea4f-dc22-56e7-bc03-5ea01da64a0c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/51/514e6bec32ef0d172c5d3e9df05da8613806bb60faee267702ffa17238d0f826.png" :db/id #edb/ref 17592186312546} {:answer/id #uuid "b2749a4e-2333-513b-a009-d0b54fb57f84" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c6/c697a6b80923ffb6c557d59aa2e2924561121c373b4221709e280e5d35297e33.png" :db/id #edb/ref 17592186313364} {:answer/id #uuid "eb719dc5-820f-5706-8579-b09db7a542d0" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/74/74032d1b543a7446e87b9d3c9b1737f61996cf32817a3bce4db26f229457a348.png" :db/id #edb/ref 17592186313851} {:answer/id #uuid "efe1924f-b6ff-5ccc-8cc3-150714e499b6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ef/ef9ada6ab016d70b2b14d53cb2f3021793ea78dd69048700c07d5a5161901ecf.png" :db/id #edb/ref 17592186313896}] :answer-field/correct {:db/id #edb/ref 17592186313851} :answer-field/id #uuid "7957c9fa-0c70-53b9-94b5-a3465912ab8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186314331}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "24eff55c-c123-528b-9b40-89bdd5a76ad5" :question/math-academy-id "q-340357" :question/problem "A particular autonomous differential equation has the following properties:\n\n- $y=-2$ is a node\n\n- $y=1$ is a source\n\n- $y=3$ is a sink\n\nWhich of the following could be the slope field of the differential equation?" :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nFirst, we draw the phase line with the given information. \n\nNote that there are $3$ equilibrium points, $y=-2,$ $y=1,$ and $y=3.$\n\n- We're given that $y=3$ is a sink. We represent this on the phase line by drawing a downward-pointing arrow just above $y=3$ and an upward-pointing arrow just below it.\n\n- We're given that $y=1$ is a source. We represent this on the phase line by drawing an upward-pointing arrow just above $y=1$ (already drawn by the above property) and a downward-pointing arrow just below it.\n\n- We're given that $y=-2$ is a node. This means that the arrows on either side of $y=-2$ point in the same direction. Since the arrow just above $y=-2$ points downward, the arrow just below it points downward too.\n\n![](images/b2/b2cb0682ba91ac23d418d91e7564cbb6245bf498de79b3e615f3ed2b1fcdb997.png)\n\nOf the given options, the only slope field that correspond with this phase line is the following:\n\n![](images/74/74032d1b543a7446e87b9d3c9b1737f61996cf32817a3bce4db26f229457a348.png)\n\nNote that:\n\n- The slope field is horizontal at $y=-2,$ $y=1,$ and $y=3.$\n\n- The slopes near $y=-2$ appear to diverge away from this line when we're looking below the line and appear to converge toward the line when we're looking above the line.\n\n- The slopes near $y=1$ appear to diverge away from this line.\n\n- The slopes near $y=3$ appear to converge toward this line."} :step/id #uuid "2eae129d-e797-5673-86cf-a806611e2fca"} {:db/id #edb/ref 17592186563779 :step/content {:db/id #edb/ref 17592186374986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b51afd-17cc-5f52-afd7-77de192930a6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a node" :db/id #edb/ref 17592186374988} {:answer/id #uuid "61b64586-d698-5841-adf5-803349002047" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a source and $y=-3$ is a sink" :db/id #edb/ref 17592186374989} {:answer/id #uuid "b9a800f7-3027-5549-993a-ce836a2294ac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a sink" :db/id #edb/ref 17592186374990} {:answer/id #uuid "e135b204-c1bc-5ec5-950b-2e613adeb18b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a sink and $y=-3$ is a source" :db/id #edb/ref 17592186374991} {:answer/id #uuid "2d98202e-2b70-5bc6-b94a-b9e318f37f2f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a source" :db/id #edb/ref 17592186374992}] :answer-field/correct {:db/id #edb/ref 17592186374992} :answer-field/id #uuid "d6858d42-6ccf-559c-a286-454ea7a3acd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186374987}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b343081e-f618-50fb-8cd3-8bac934f3e0f" :question/math-academy-id "q-340344" :question/problem "Which of the following statements is true regarding the equilibrium solutions of ${y}^{′}=(y-3)({y}^{2}+5)?$" :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nFirst, we need to find the equilibrium solutions. So, we solve $f(y)=0:$\n\n$$\n\\begin{aligned}f(y) & =0 \\\\ (y-3)({y}^{2}+5) & =0\\end{aligned}\n$$\n\nSo, the equilibrium solution is $y=3.$ \n\nNow, we analyze the sign of $f(y)$ using a sign table, as follows:\n\n|  | $(-\\infty ,3)$ | $(3,\\infty )$ |\n| --- | --- | --- |\n| $y-3$ | $-$ | $+$ |\n| ${y}^{2}+5$ | $+$ | $+$ |\n| $f(y)$ | $-$ | $+$ |\n\nSo, we have that $f(y)$ is positive for $y\\in (3,\\infty ),$ and negative for $y\\in (-\\infty ,3).$\n\nWe can now draw the phase line for this equation.\n\n![](images/bb/bb9204b3eb9bcf7fe536508f5635356aacdbd8e29f276b03bac9dddd916609bb.png)\n\nFinally, we classify the equilibrium solution:\n\n- $y=3$ is a source because the nearby solutions diverge away from this point.\n\nTherefore, the correct answer is \"$y=3$ is a source\"."} :step/id #uuid "40081e28-38bb-5e80-8b2b-ef32997c6f47" :step/next {:db/id #edb/ref 17592186563773}} {:db/id #edb/ref 17592186563789 :step/content {:db/id #edb/ref 17592186395542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "763068aa-2d32-5aa6-a823-b7ccf67073fc" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1a/1a9eb4ad4a219ae7b36e418fd51ab15de36940a67b5a8a4aeeef6538e18e551c.png" :db/id #edb/ref 17592186395544} {:answer/id #uuid "8c925e8a-1d13-5879-9258-7d0d5c968786" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b6/b6bbed5a54701e3e467e62fc1acfff78607c63b9d2fad07e092c826a3bca0c0e.png" :db/id #edb/ref 17592186395545} {:answer/id #uuid "b7936e16-6d5d-54da-833d-53150c5d80f0" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e4/e440928dfa83e3e653a2e508e9d01e53c73df84530402a393e82f56996eb5fde.png" :db/id #edb/ref 17592186395546} {:answer/id #uuid "31d506e6-640a-5f73-80c7-b307d35e6ee1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/fa/fa06ae341ff2c761aa3e60de7270bd0ffad885b7e602c12c7af340acc0781818.png" :db/id #edb/ref 17592186395547} {:answer/id #uuid "306b5ee5-c0bd-5f88-aaf7-65ca396796e9" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8f/8fd918e5eba15cec6472f84c64f6181920e8d02122919f844678f79aa23e27a0.png" :db/id #edb/ref 17592186395548}] :answer-field/correct {:db/id #edb/ref 17592186395546} :answer-field/id #uuid "27088d4c-aa07-554c-843f-4a1dc5c26997" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186395543}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "55d1795f-d6ac-5ff7-a9de-20bb6292950d" :question/math-academy-id "q-98781" :question/problem "A particular autonomous differential equation has the following properties:\n\n- $y=-3$ is a sink\n\n- $y=0$ is a node\n\nWhich of the following could be the slope field of the differential equation?" :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nFirst, we draw the phase line with the given information. \n\nNote that there are $2$ equilibrium points, $y=-3$ and $y=0.$\n\n- We're given that $y=-3$ is a sink. We represent this on the phase line by drawing a downward-pointing arrow just above $y=-3$ and an upward-pointing arrow just below it.\n\n- We're given that $y=0$ is a node. This means that the arrows on either side of $y=0$ point in the same direction. Since the arrow just below $y=0$ points downward, the arrow just above it points downward too.\n\n![](images/db/db7e9ea076c3a1fe2cf5341b841693e36d5b9a9030e624da88d2cfd3b0d3a1b0.png)\n\nOf the given options, the only slope field that correspond with this phase line is the following:\n\n![](images/e4/e440928dfa83e3e653a2e508e9d01e53c73df84530402a393e82f56996eb5fde.png)\n\nNote that:\n\n- The slope field is horizontal at $y=-3$ and $y=0.$\n\n- The slopes near $y=-3$ appear to converge toward this line.\n\n- The slopes near $y=0$ appear to diverge away from this line when we're looking below the line and appear to converge toward the line when we're looking above the line."} :step/id #uuid "86d18b44-9b63-5aac-a2f2-3778afdcb862" :step/next {:db/id #edb/ref 17592186563779}} {:db/id #edb/ref 17592186563792 :step/content {:db/id #edb/ref 17592186362323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dbe103d-5637-58d2-abc9-7a6c3e453573" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=0$ is a source, and $y=2$ is a sink" :db/id #edb/ref 17592186360958} {:answer/id #uuid "3827fd23-1329-5a2a-a0d6-8196083f2fa9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=0$ and $y=2$ are both sources" :db/id #edb/ref 17592186361092} {:answer/id #uuid "6d4258a4-910c-535f-aae6-df1aff234b91" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=0$ is a source, and $y=2$ is a node" :db/id #edb/ref 17592186361324} {:answer/id #uuid "c57017a6-27ae-5d87-9597-aec6a527a45f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=0$ and $y=2$ are both nodes" :db/id #edb/ref 17592186361729} {:answer/id #uuid "e247c354-519d-5aab-aeb0-bb39d5c208fe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=0$ is a sink, and $y=2$ is a source" :db/id #edb/ref 17592186361849}] :answer-field/correct {:db/id #edb/ref 17592186360958} :answer-field/id #uuid "f160c61e-3494-5d3f-ac1d-dfb66e1b47da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362199}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bd711689-2039-5e3a-97e9-854277e0ac5b" :question/math-academy-id "q-98757" :question/problem "Which of the following statements is true regarding the equilibrium solutions of ${y}^{′}=2y-{y}^{2}?$" :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nFirst, we need to find the equilibrium solutions. So, we solve $f(y)=0:$\n\n$$\n\\begin{aligned}f(y) & =0 \\\\ 2y-{y}^{2} & =0 \\\\ y(2-y) & =0 \\\\ y & =0,2\\end{aligned}\n$$\n\nSo, the equilibrium solutions are $y=0$ and $y=2.$ \n\nNow, we analyze the sign of $f(y)$ using a sign table, as follows:\n\n|  | $(-\\infty ,0)$ | $(0,2)$ | $(2,\\infty )$ |\n| --- | --- | --- | --- |\n| $y$ | $-$ | $+$ | $+$ |\n| $2-y$ | $+$ | $+$ | $-$ |\n| $f(y)$ | $-$ | $+$ | $-$ |\n\nSo, we have that $f(y)$ is negative for $y\\in (-\\infty ,0)\\cup (2,\\infty ),$ and positive for $y\\in (0,2).$\n\nWe can now draw the phase line for this equation.\n\n![](images/df/df68345e3424f1e0020a98ef8dd13456865412818067a822c01c3f50e49386ec.png)\n\nFinally, we classify the equilibrium solutions:\n\n- $y=0$ is a source because the nearby solutions diverge away from this point.\n\n- $y=2$ is a sink because the nearby solutions converge toward this point.\n\nTherefore, the correct answer is \"$y=0$ is a source, and $y=2$ is a sink\"."} :step/id #uuid "9183cf7f-7ba1-5cfc-a202-00bfee4b32c5" :step/next {:db/id #edb/ref 17592186563789}}] :activity/title "Classifying Equilibrium Solutions of First-Order ODEs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186562924}]}
