      "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:50px;\n                                        margin-left:2px;\n                                        margin-right:2px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"17\"><span mathquill-command-id=\"19\">1</span><span mathquill-command-id=\"21\">2</span><span mathquill-command-id=\"23\">9</span><span mathquill-command-id=\"25\">6</span><span class=\"mq-nonSymbola\" mathquill-command-id=\"27\">π</span></span></div></div>",
      "rendered_text": "1296π",
