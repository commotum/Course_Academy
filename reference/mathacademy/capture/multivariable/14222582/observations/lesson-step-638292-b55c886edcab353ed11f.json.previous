href=\"#E9-MJMAIN-32\" x=\"590\" y=\"816\"></use>\n</g>\n <use xlink:href=\"#E9-MJMAIN-64\" x=\"10676\" y=\"0\"></use>\n <use xlink:href=\"#E9-MJMATHI-78\" x=\"11233\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-3349)\">\n <use xlink:href=\"#E9-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n <use xlink:href=\"#E9-MJMATHI-3C0\" x=\"1334\" y=\"0\"></use>\n<g transform=\"translate(2074,0)\">\n <use xlink:href=\"#E9-MJSZ2-222B\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E9-MJMAIN-31\" x=\"1500\" y=\"1540\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E9-MJMAIN-30\" x=\"787\" y=\"-1270\"></use>\n</g>\n<g transform=\"translate(3755,0)\">\n <use xlink:href=\"#E9-MJMAIN-5B\"></use>\n <use xlink:href=\"#E9-MJMAIN-31\" x=\"278\" y=\"0\"></use>\n <use xlink:href=\"#E9-MJMAIN-2212\" x=\"1001\" y=\"0\"></use>\n<g transform=\"translate(2001,0)\">\n <use xlink:href=\"#E9-MJMAIN-221A\" x=\"0\" y=\"-109\"></use>\n<rect stroke=\"none\" width=\"572\" height=\"60\" x=\"833\" y=\"632\"></rect>\n <use xlink:href=\"#E9-MJMATHI-78\" x=\"833\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E9-MJMAIN-5D\" x=\"3407\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E9-MJMAIN-32\" x=\"5213\" y=\"678\"></use>\n</g>\n <use xlink:href=\"#E9-MJMAIN-64\" x=\"8062\" y=\"0\"></use>\n <use xlink:href=\"#E9-MJMATHI-78\" x=\"8619\" y=\"0\"></use>\n <use xlink:href=\"#E9-MJMAIN-2E\" x=\"9191\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span><p></p>\n</li>\n<li><p><strong>Step III.</strong> Find the difference.</p>\n<p>Finally, we can write the volume of the original solid as\n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"44.435ex\" height=\"57.759ex\" style=\"vertical-align: -28.255ex;\" viewBox=\"0 -12703.3 19131.7 24868.5\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-10-Title\">\n<title id=\"MathJax-SVG-10-Title\"> \n \t\\eqalign{\nV &amp;= {\\color{blue}V_{\\text{outer}}} - {\\color{brown}V_{\\text{inner}}} <span>\\</span>[5pt]\n \t\t&amp; = \\pi \\int_0^1 [1-x]^2 - \\pi \\int_0^1 [1-\\sqrt x]^2\\,\\textrm d x <span>\\</span>[5pt]\n \t\t&amp; = \\pi \\int_0^1 \\left((1-x)^2 - (1-\\sqrt x)^2\\right) \\,\\textrm d x <span>\\</span>[5pt]\n \t\t&amp; = \\pi \\int_0^1 (x^2-3x+2\\sqrt x) \\,\\,\\textrm d x <span>\\</span>[5pt]\n \t\t&amp; = \\pi\\left. \\left( \\dfrac {1} 3 x^3 - \\dfrac{3}{2} x^2 + \\dfrac{4}{3} x^{3/2 } \\ \\right)\\right|_0^1<span>\\</span>[5pt] \n \t\t&amp; =  \\pi \\left[\\left( \\dfrac {1}3 (1)^3 - \\dfrac{3}{2}(1)^2  + \\dfrac{4 }{3}(1)^{3/2 } \\right) - (0) \\right]<span>\\</span>[5pt]\n \t\t&amp; =  \\pi \\left(\\dfrac{1}3 - \\dfrac{3}{2} +\\dfrac{4}{3} \\right)<span>\\</span>[5pt]\n \t\t&amp; = \\dfrac {\\pi}{6} .\n \t\t}\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E10-MJMATHI-56\" d=\"M52 648Q52 670 65 683H76Q118 680 181 680Q299 680 320 683H330Q336 677 336 674T334 656Q329 641 325 637H304Q282 635 274 635Q245 630 242 620Q242 618 271 369T301 118L374 235Q447 352 520 471T595 594Q599 601 599 609Q599 633 555 637Q537 637 537 648Q537 649 539 661Q542 675 545 679T558 683Q560 683 570 683T604 682T668 681Q737 681 755 683H762Q769 676 769 672Q769 655 760 640Q757 637 743 637Q730 636 719 635T698 630T682 623T670 615T660 608T652 599T645 592L452 282Q272 -9 266 -16Q263 -18 259 -21L241 -22H234Q216 -22 216 -15Q213 -9 177 305Q139 623 138 626Q133 637 76 637H59Q52 642 52 648Z\"></path>\n<path stroke-width=\"1\" id=\"E10-MJMAIN-3D\" d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\"></path>\n<path stroke-width=\"1\" id=\"E10-MJMAIN-6F\" d=\"M28 214Q28 309 93 378T250 448Q340 448 405 380T471 215Q471 120 407 55T250 -10Q153 -10 91 57T28 214ZM250 30Q372 30 372 193V225V250Q372 272 371 288T364 326T348 362T317 390T268 410Q263 411 252 411Q222 411 195 399Q152 377 139 338T126 246V226Q126 1