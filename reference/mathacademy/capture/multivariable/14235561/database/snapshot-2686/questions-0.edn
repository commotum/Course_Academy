id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186300156} {:answer/id #uuid "447d16d4-e4ed-5411-a267-a5cd72c6a62a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2}" :db/id #edb/ref 17592186300301} {:answer/id #uuid "78150501-86d3-5ad2-b18d-3aa575407c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:=2{R}_{2}" :db/id #edb/ref 17592186300553} {:answer/id #uuid "e840a680-6695-5b5e-b17d-1a0d7769e11b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+{R}_{2}" :db/id #edb/ref 17592186301110}] :answer-field/correct {:answer/id #uuid "447d16d4-e4ed-5411-a267-a5cd72c6a62a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2}" :db/id #edb/ref 17592186300301} :answer-field/id #uuid "e8eef8d5-a521-5905-9cae-619b2505ad27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301965}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "67780f7b-b335-51d6-8512-e61d1ae7ee4f" :question/math-academy-id "q-32147" :question/problem "Consider $E=\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}$ and a $3\\times 3$ matrix $A.$\nFind the row operation that, when applied to $A,$ is equivalent to multiplying $A$ by the given elementary matrix $E$ from the left." :question/worked-solution "The given matrix $E$ is obtained by swapping the first and the second rows of ${I}_{3}:$\n\n$$\n\\begin{aligned}{I}_{3} & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =E\\end{aligned}\n$$\n\nTherefore, $EA$ is equivalent to applying the elementary \nrow operation ${R}_{1}↔{R}_{2}$ to $A.$"}] [{:db/id #edb/ref 17592186329665 :knowledge-point/_questions [{:db/id #edb/ref 17592186133743 :knowledge-point/id #uuid "09d8ec89-4d75-51ac-a870-1d2f8a1800ba" :knowledge-point/title "Finding the Matrix Left Multiplication Equivalent To a Given Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "255b1ea2-ed27-596e-8626-b1b2d8321ddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186327258} {:answer/id #uuid "3fe72058-46a6-5a78-b84f-026a0b8b6b89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A\\cdot \\begin{bmatrix}1 & 0 & -2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186327493} {:answer/id #uuid "6ddbe7a4-e77d-5a9e-9478-88103a828d5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -2\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186327886} {:answer/id #uuid "92b8adc9-9e6a-531d-b1f2-36d519bd89c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A\\cdot \\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -2\\end{bmatrix}" :db/id #edb/ref 17592186328212} {:answer/id #uuid "ed8ca3eb-b5a5-566a-84f2-4571a314fee3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186329015}] :answer-field/correct {:answer/id #uuid "ed8ca3eb-b5a5-566a-84f2-4571a314fee3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{bmatrix}\\cdot A" :db/id #edb/ref 17592186329015} :answer-field/id #uuid "a230bae0-2871-57b7-b729-3347db98f89d" :answ