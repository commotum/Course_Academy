      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14197610/observations/step-q161898-ce7e89de9de3375cd1c2.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14197610/observations/step-q161898-ce7e89de9de3375cd1c2.png",
      "source_url": "https://mathacademy.com/tasks/14197610/topics/4144/review",
      "captured_at": 1791964101.4793594,
      "math_academy_id": "q-161898",
