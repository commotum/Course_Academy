b/ref 1075 #edb/ref 17592186566500 #edb/ref 17592186045417] [17592186567004 #edb/ref 1075 #edb/ref 17592186566547 #edb/ref 17592186045417] [17592186567004 #edb/ref 1075 #edb/ref 17592186566597 #edb/ref 17592186045417] [17592186567004 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186567004 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186567004 #edb/ref 1078 #edb/ref 17592186566547 #edb/ref 17592186045417] [17592186567004 #edb/ref 1079 #uuid "fd4f35ba-dc99-55f4-89c9-fd9fa4a3c49f" #edb/ref 17592186045417] [17592186567009 #edb/ref 1068 #edb/ref 17592186566903 #edb/ref 17592186045417] [17592186567009 #edb/ref 1069 "q-123738" #edb/ref 17592186045417] [17592186567009 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186567009 #edb/ref 1071 "Let $R=[-4,-1]\\times [0,2]$ be a region in the $xy$-plane, and let $f(x,y)=10-x-y.$ Further, let \n\n$$\nI={∬}_{R}f(x,y)\\,\\text{d}A\n$$\n\nbe the unique number such that over all rectangular partitions $P$ of $R,$ we have \n$L(f,P)\\,\\le I\\,\\le U(f,P),$\nwhere $L(f,P)$ and $U(f,P)$ are the corresponding lower and upper Riemann sums, and \n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\\,.\n$$\n\nWhat expression is missing from the double summation above?" #edb/ref 17592186045417] [17592186567009 #edb/ref 1072 #uuid "02febc61-94f2-5b4e-865b-483532db6a43" #edb/ref 17592186045417] [17592186567009 #edb/ref 1074 "For a function $f(x,y),$ the double integral of $f$ over a rectangular region $R$ is the unique number $I$ (if it exists) such that\n\n$$\nL(f,P)\\le I\\le U(f,P),\n$$\n\nover all partitions $P$ of $R,$ where the lower and upper sums respectively are given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{m}_{ij}Δ{x}_{i}Δ{y}_{j} \\\\ U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nand ${m}_{ij}$ and ${M}_{ij}$ are the minimum and maximum values of $f$ respectively in each subregion ${R}_{ij}.$ \n\nWe need to compute $U(f,P).$ \n\nNotice that for all subregions ${R}_{ij},$ we have that\n\n- $f(x,y)=10-x-y$ decreases as $x$ increases, and\n\n- $f(x,y)=10-x-y$ decreases as $y$ increases.\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion. Therefore,\n\n$$\n{M}_{ij}=f({x}_{i-1},{y}_{j-1})=10-{x}_{i-1}-{y}_{j-1}\n$$\n\nand the upper Riemann sum is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(10-{x}_{i-1}-{y}_{j-1})Δ{x}_{i}Δ{y}_{j}.\n$$\n\nSo, the missing expression is $10-{x}_{i-1}-{y}_{j-1}.$" #edb/ref 17592186045417] [17592186567015 #edb/ref 1068 #edb/ref 17592186566935 #edb/ref 17592186045417] [17592186567015 #edb/ref 1069 "q-72911" #edb/ref 17592186045417] [17592186567015 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186567015 #edb/ref 1071 "Let $R=[-4,-1]\\times [0,3]$ be a region in the $xy$-plane, and let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the double integral\n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhere $f$ is a function such that ${m}_{ij}={M}_{ij}=7$ for all partitions $P$ of $R,$ and ${m}_{ij}$ and ${M}_{ij}$ are the minimum and maximum values of $f$ respectively in each subregion ${R}_{ij}.$" #edb/ref 17592186045417] [17592186567015 #edb/ref 1072 #uuid "0ff4898d-e534-599f-872e-88eb7fcaa580" #edb/ref 17592186045417] [17592186567015 #edb/ref 1074 "For a function $f(x,y),$ the double integral of $f$ over a rectangular region $R$ is the unique number $I$ (if it exists) such that\n\n$$\nL(f,P)\\le I\\le U(f,P),\n$$\n\nover all partitions $P$ of $R,$ where the lower and upper sums respectively are given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{m}_{ij}Δ{x}_{i}Δ{y}_{j} \\\\ U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nand ${m}_{ij}$ and ${M}_{ij}$ are the minimum and maximum values of $f$ in each subregion ${R}_{ij}.$ \n\nNow, since ${m}_{ij}={M}_{ij}=7,$ we obtain\n\n$$\n\\begin{aligned}L(f,P)=U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}7\\,Δ{x}_{i}Δ{y}_{j} \\\\  & =7({\\sum }_{i=1}^{m}Δ{x}_{i})({\\sum }_{j=1}^{n}Δ{y}_{j}) \\\\  & =7(-1-(-4))(3-0) \\\\  & =7\\cdot 3\\cdot 3 \\\\  & =63.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\nL(f,P)=63\\le {∬}_{R}f(x,y)\\,\\text{d}A\\le 63=U(f,P)\n$$\n\nwhich implies that\n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A=63.\n$$" #edb/ref 17592186045417] [17592186567043 #edb/ref 1068 #edb/ref 17592186566893 #edb/ref 17592186045417] [17592186567043 #edb/ref 1069 "q-123842" #edb/ref 17592186045417] [17592186567043 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186567043 #edb/ref 1071 "Let $R=[0,3]\\times [6,10]$ be a region in the $xy$-plane, and let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the double integral\n\n$$\n{∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhere $f$ is a function such that ${m}_{ij}={M}_{ij}=10$ for all partitions $P$ of $R,$ and ${m}_{ij}$ and ${M}_{ij}$ are the minimum and maximum values of $f$ respectively in each subregion ${R}_{ij}.$" #edb/ref 17592186045417] [17592186567043 #edb/ref 1072 #uuid "60d97de9-38ad-5bc2-ac62-24badbb7cfc3" #edb/ref 17592186045417] [17592186567043 #edb/ref 1074 "For a function $f(x,y),$ the double integral of $f$ over a rectangular region $R$ is the unique number $I$ (if it exists) such that\n\n$$\nL(f,P)\\le I\\le U(f,P),\n$$\n\nover all partitions $P$ of $R,$ where the lower and upper sums respectively are given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{m}_{ij}Δ{x}_{i}Δ{y}_{j} \\\\ U(f,P) 