>y</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>y</mi><mi>j</mi></msub><mo stretchy=\"false\">)</mo><mo>−</mo><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy=\"false\">)</mo><mo>+</mo><mn>1</mn><mo>≤</mo><mn>2</mn><msub><mi>y</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub><mo>−</mo><mn>2</mn><msub><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><mn>1.</mn></math></mjx-assistive-mml></mjx-container></p>\n<p>Multiplying this by <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"404\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c394\"></mjx-c></mjx-mi><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D456 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msub><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c394\"></mjx-c></mjx-mi><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D457 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msub></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">Δ</mi><msub><mi>x</mi><mi>i</mi></msub><mi mathvariant=\"normal\">Δ</mi><msub><mi>y</mi><mi>j</mi></msub></math></mjx-assistive-mml></mjx-container> and applying the double summation gives:\n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"405\" style=\"font-size: 119.4%; position: rel