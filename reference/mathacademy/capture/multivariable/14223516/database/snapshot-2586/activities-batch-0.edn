#{[{:activity/first-step {:db/id #edb/ref 17592186084199} :activity/id #uuid "6b249749-cdb1-5488-bab7-fd455ccb8cb2" :activity/scope {:db/id #edb/ref 17592186049404 :topic/id #uuid "f1c81203-ccec-5577-930f-78f9306ef1d9" :topic/math-academy-id 691} :activity/steps [{:db/id #edb/ref 17592186084039 :step/content {:db/id #edb/ref 17592186084428 :tutorial/content "We've been using the following formula for the sum to infinity of a geometric series with first term $a_1$ and common ratio $r$:\n\n$$\nS_\\infty = \\dfrac{a_1}{1-r}, \\qquad \\mid r \\mid < 1\n$$\n\nTo see where this formula comes from, first, we remember the formula for the sum of the first $n$ terms of a geometric series is given by\n\n$$\nS_n = a_1 \\cdot \\dfrac {1 - r ^ n} {1 - r}\n$$\n\nNotice that if $\\mid r \\mid < 1$ then $r^n\\to 0$ as $n\\to\\infty$. Therefore, as $n\\to\\infty$, we have:\n\n$$\nS_{n} \\mid → a_{1} \\cdot \\frac{1 - 0}{1 - r}; = a_{1} \\cdot \\frac{1}{1 - r}; = \\frac{a_{1}}{1 - r}; = S_{∞}\n$$" :tutorial/id #uuid "663988c8-25f5-59d4-acf5-f842aa16de74" :tutorial/math-academy-id 2833 :tutorial/title "Justification of the Formula"} :step/id #uuid "62505009-7a0f-51cc-9a7b-25de0940cb7c" :step/math-academy-id 15070} {:db/id #edb/ref 17592186084199 :step/content {:db/id #edb/ref 17592186084395 :tutorial/content "The sum $S_\\infty$ of an infinite geometric series with first term $a_1$ and common ratio $r$ can be computed using the formula\n\n$$\nS_\\infty = \\dfrac{a_1}{1-r}, \\qquad \\mid r \\mid < 1\n$$\n\nNote that $\\mid r \\mid < 1$ is a very important condition for the sum to exist. If the condition $\\mid r \\mid <1$ is *not* satisfied, then the formula does *not* work!\n\nFor example, suppose we want to calculate the sum of the infinite geometric series\n\n$$\n3 + 1 + \\dfrac 1 3 + \\dfrac 1 9 + \\dfrac{1}{27} + \\cdots\\,\n$$\n\nThe first term is $a_1=3$, and the common ratio is\n\n$$\nr = \\dfrac{a_2}{a_1} = \\dfrac{1}{3}\n$$\n\nIndeed, we have $\\mid r \\mid <1$. Therefore, the sum is\n\n$$\n\\begin{aligned}\nS_{∞} &= \\frac{a_{1}}{1 - r} \\\\\n&= (3)/((1 - \\frac{1}{3})) \\\\\n&= (3)/((\\frac{2}{3})) \\\\\n&= 3(\\frac{3}{2}) \\\\\n&= \\frac{9}{2}\n\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n3 + 1 + \\dfrac 1 3 + \\dfrac 1 9 + \\dfrac{1}{27} + \\cdots = \\dfrac{9}{2}\n$$" :tutorial/id #uuid "934f437a-4324-59f0-8c7b-7b41b40ea25b" :tutorial/math-academy-id 1193 :tutorial/title "Introduction"} :step/id #uuid "1c5667ee-1f09-5553-bc41-a03da6922e4a" :step/math-academy-id 2341 :step/next {:db/id #edb/ref 17592186084200}} {:db/id #edb/ref 17592186084200 :step/content {:db/id #edb/ref 17592186083277 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083081 :question/id #uuid "272c7490-d3b2-557b-8b23-4d24e4208dfe" :question/math-academy-id "e-679"} :knowledge-point/id #uuid "55b978ec-9ec6-5349-a103-0c11d9a904c1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048386} {:db/id #edb/ref 17592186050807} {:db/id #edb/ref 17592186050977}] :knowledge-point/questions [{:db/id #edb/ref 17592186083474} {:db/id #edb/ref 17592186083530} {:db/id #edb/ref 17592186233423} {:db/id #edb/ref 17592186233444} {:db/id #edb/ref 17592186234521} {:db/id #edb/ref 17592186538981}] :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Expressed Using Fractions"} :step/id #uuid "a33759e6-8395-5d82-80e7-58e9213ebee6" :step/math-academy-id 2342 :step/next {:db/id #edb/ref 17592186084202}} {:db/id #edb/ref 17592186084202 :step/content {:db/id #edb/ref 17592186083279 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083082 :question/id #uuid "5eff5a85-f47d-5d1b-84e7-011a61ff8fb2" :question/math-academy-id "e-680"} :knowledge-point/id #uuid "2954b59f-d701-502f-963b-b62098a87c34" :knowledge-point/questions [{:db/id #edb/ref 17592186083531} {:db/id #edb/ref 17592186083993} {:db/id #edb/ref 17592186233019} {:db/id #edb/ref 17592186234371} {:db/id #edb/ref 17592186234372} {:db/id #edb/ref 17592186319200} {:db/id #edb/ref 17592186321068} {:db/id #edb/ref 17592186345110} {:db/id #edb/ref 17592186538997} {:db/id #edb/ref 17592186538999}] :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Expressed Using Decimals"} :step/id #uuid "8378cca3-a8c1-5927-be8f-f71abbd197d0" :step/math-academy-id 2345 :step/next {:db/id #edb/ref 17592186084204}} {:db/id #edb/ref 17592186084204 :step/content {:db/id #edb/ref 17592186083281 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083083 :question/id #uuid "552467cb-c641-5b17-802a-c9cf26d95c1e" :question/math-academy-id "e-681"} :knowledge-point/id #uuid "e0adffc7-ef35-5f7a-a790-06addb354c2e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049083}] :knowledge-point/questions [{:db/id #edb/ref 17592186083907} {:db/id #edb/ref 17592186083908} {:db/id #edb/ref 17592186233964} {:db/id #edb/ref 17592186233996} {:db/id #edb/ref 17592186234027} {:db/id #edb/ref 17592186234228} {:db/id #edb/ref 17592186234229} {:db/id #edb/ref 17592186234230} {:db/id #edb/ref 17592186234231} {:db/id #edb/ref 17592186234373} {:db/id #edb/ref 17592186234374} {:db/id #edb/ref 17592186259691} {:db/id #edb/ref 17592186326814} {:db/id #edb/ref 17592186326827}] :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Given Two of Its Terms"} :step/id #uuid "212cc847-3bff-5269-b811-32a7904c769a" :step/math-academy-id 2348 :step/next {:db/id #edb/ref 17592186084039}}] :activity/title "Finding the Sum of an Infinite Geometric Series" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083403}] [{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186539086} :activity/id #uuid "5e90c252-d6d1-5d91-b294-f196d632abf7" :activity/scope {:db/id #edb/ref 17592186049404 :topic/id #uuid "f1c81203-ccec-5577-930f-78f9306ef1d9" :topic/math-academy-id 691} :activity/steps [{:db/id #edb/ref 17592186539047 :step/content {:db/id #edb/ref 17592186538997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "387e8a10-560d-5d39-9e76-fc3b36e75ef1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6.25" :db/id #edb/ref 17592186538350}] :answer-field/correct {:db/id #edb/ref 17592186538350} :answer-field/id #uuid "3dfb5c0b-4f43-521c-adf9-750f8155535e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538835}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b0043402-5216-56a5-82e2-182b3eaa6817" :question/math-academy-id "q-353145" :question/problem "Find the sum to infinity ${S}_{\\infty }$ of the geometric series \n\n$$\n2.5+1.5+0.9+0.54+⋯.\n$$\n\nDo not round the answer.\n\n${S}_{\\infty }=$\n{{field-1}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFor the given geometric series, the first term is ${a}_{1}=2.5$ and the common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{1.5}{2.5}=0.6.\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{2.5}{1-0.6} \\\\  & =\\frac{2.5}{0.4} \\\\  & =6.25.\\end{aligned}\n$$"} :step/id #uuid "2523b52f-6ffd-5128-a11b-bfb54528d1ee" :step/next {:db/id #edb/ref 17592186539109}} {:db/id #edb/ref 17592186539076 :step/content {:db/id #edb/ref 17592186538981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98179f33-36bb-5786-aba0-2e8a4ef467fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{25}{2}" :db/id #edb/ref 17592186538592}] :answer-field/correct {:db/id #edb/ref 17592186538592} :answer-field/id #uuid "377f3da4-4d13-5ed9-a0c5-00b4eaa5cff5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538832}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8ad57966-24c0-50f4-b632-7291950e6a6e" :question/math-academy-id "q-353118" :question/problem "Find the sum to infinity ${S}_{\\infty }$ of the geometric series \n\n$$\n-10-2-\\frac{2}{5}-\\frac{2}{25}-⋯.\n$$\n\nDo not round the answer.\n\n${S}_{\\infty }=$  \n{{field-1}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFor the given geometric series, the first term ${a}_{1}=-10$ and the common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{(-2)}{(-10)}=\\frac{1}{5}.\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{-10}{(1-\\frac{1}{5})} \\\\  & =-\\frac{10}{(\\frac{4}{5})} \\\\  & =-\\frac{25}{2}.\\end{aligned}\n$$"} :step/id #uuid "8a955af1-f546-5512-be6c-5091a7427f58" :step/next {:db/id #edb/ref 17592186539047}} {:db/id #edb/ref 17592186539086 :step/content {:db/id #edb/ref 17592186083907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8edc6c91-b546-52c1-abe6-c41407063d99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "27" :db/id #edb/ref 17592186082374} {:answer/id #uuid "919505ef-ab05-5d98-b28e-c95695566647" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186082375} {:answer/id #uuid "da2ba447-050d-5a58-b993-e03e063e2596" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18" :db/id #edb/ref 17592186082376} {:answer/id #uuid "f2cd4737-e139-5014-9ad2-503cc6e990b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186082377} {:answer/id #uuid "14e52f90-6097-5fb9-a840-f6e4099a1cfb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36" :db/id #edb/ref 17592186082378}] :answer-field/correct {:db/id #edb/ref 17592186082374} :answer-field/id #uuid "6375df85-f8a7-5a1a-9c25-0ace54eb1a0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186082373}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ed398a32-5acf-5617-b286-7da491ceb0a4" :question/math-academy-id "q-67203" :question/problem "Consider the positive infinite geometric sequence that has a first term equal to $18$ and a third term equal to $2.$ What is the sum to infinity of the terms of this sequence?" :question/requires-calculator true :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{1}=18$ and ${a}_{3}=2.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{3-1} & =\\frac{2}{18} \\\\ {r}^{2} & =\\frac{1}{9} \\\\ r & =\\sqrt{\\frac{1}{9}} \\\\ r & =\\frac{1}{3}\\end{aligned}\n$$\n\nNote that we have taken the positive square root since we're told that the sequence is positive.\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{18}{(1-\\frac{1}{3})} \\\\  & =\\frac{18}{(\\frac{2}{3})} \\\\  & =27.\\end{aligned}\n$$"} :step/id #uuid "a4dc42cc-fe3e-5bde-932d-e2411dc64c3b" :step/next {:db/id #edb/ref 17592186539095}} {:db/id #edb/ref 17592186539095 :step/content {:db/id #edb/ref 17592186234230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08a0745f-afdb-5fd5-896c-aecc342af1a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "72" :db/id #edb/ref 17592186538254} {:answer/id #uuid "7a8016a8-51b3-5faa-84af-ae76ac8a14e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "107" :db/id #edb/ref 17592186538511} {:answer/id #uuid "8b7e6727-bee6-581b-b90f-15564547ab7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186538557} {:answer/id #uuid "c7ae6245-2f0d-51cd-8955-540a0d399231" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "98" :db/id #edb/ref 17592186538698} {:answer/id #uuid "f5bc4753-d8a5-5d2c-9d61-78c209c31473" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "81" :db/id #edb/ref 17592186538789}] :answer-field/correct {:db/id #edb/ref 17592186538557} :answer-field/id #uuid "ed996d10-640b-5a4b-971a-4d70ea88d425" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538914}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e60b8545-b8cf-54c2-98e5-563869147ce1" :question/math-academy-id "q-67278" :question/problem "Consider the infinite geometric sequence that has a first term equal to $48$ and a fourth term equal to $\\frac{3}{4}.$ What is the sum to infinity of the terms of this sequence?" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{1}=48$ and ${a}_{4}=\\frac{3}{4}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{4-1} & =\\frac{(\\frac{3}{4})}{48} \\\\ {r}^{3} & =\\frac{1}{64} \\\\ {r}^{3} & ={(\\frac{1}{4})}^{3} \\\\ r & =\\frac{1}{4}\\end{aligned}\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{48}{(1-\\frac{1}{4})} \\\\  & =\\frac{48}{(\\frac{3}{4})} \\\\  & =48\\cdot \\frac{4}{3} \\\\  & =64.\\end{aligned}\n$$"} :step/id #uuid "bdaa0d32-b906-59e0-aef8-a329efe98651" :step/next {:db/id #edb/ref 17592186539076}} {:db/id #edb/ref 17592186539109 :step/content {:db/id #edb/ref 17592186538999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bd96e13-17b0-50fe-8699-6fd760a67ac4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{96}{11}" :db/id #edb/ref 17592186538517}] :answer-field/correct {:db/id #edb/ref 17592186538517} :answer-field/id #uuid "28af4213-b2b7-5593-a629-18a8bcae5ad5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538826}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b2fe4d85-a3ec-5968-ad10-7f316b6ab6b7" :question/math-academy-id "q-353150" :question/problem "Find the sum to infinity ${S}_{\\infty }$ of the geometric series \n\n$$\n9.6-0.96+0.096-0.0096+⋯.\n$$\n\n Do not round the answer.\n\n${S}_{\\infty }=$\n{{field-1}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFor the given geometric series, the first term is ${a}_{1}=9.6$ and the common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{-0.96}{9.6}=-0.1.\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{9.6}{1-(-0.1)} \\\\  & =\\frac{9.6}{1+0.1} \\\\  & =\\frac{9.6}{1.1} \\\\  & =\\frac{960}{110} \\\\  & =\\frac{96}{11}.\\end{aligned}\n$$"} :step/id #uuid "e1c4fdaf-d25c-5b24-896e-fae19bcc0b58"}] :activity/title "Finding the Sum of an Infinite Geometric Series" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186538223}]}
