#{[{:db/id #edb/ref 17592186083907 :knowledge-point/_questions [{:db/id #edb/ref 17592186083281 :knowledge-point/id #uuid "e0adffc7-ef35-5f7a-a790-06addb354c2e" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Given Two of Its Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8edc6c91-b546-52c1-abe6-c41407063d99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186082374} {:answer/id #uuid "919505ef-ab05-5d98-b28e-c95695566647" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186082375} {:answer/id #uuid "da2ba447-050d-5a58-b993-e03e063e2596" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186082376} {:answer/id #uuid "f2cd4737-e139-5014-9ad2-503cc6e990b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186082377} {:answer/id #uuid "14e52f90-6097-5fb9-a840-f6e4099a1cfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186082378}] :answer-field/id #uuid "6375df85-f8a7-5a1a-9c25-0ace54eb1a0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082373}] :question/id #uuid "ed398a32-5acf-5617-b286-7da491ceb0a4" :question/math-academy-id "q-67203" :question/problem "Consider the positive infinite geometric sequence that has a first term equal to $18$ and a third term equal to $2$. What is the sum to infinity of the terms of this sequence?\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186234230 :knowledge-point/_questions [{:db/id #edb/ref 17592186083281 :knowledge-point/id #uuid "e0adffc7-ef35-5f7a-a790-06addb354c2e" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Given Two of Its Terms"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e60b8545-b8cf-54c2-98e5-563869147ce1" :question/math-academy-id "q-67278" :question/problem "Consider the infinite geometric sequence that has a first term equal to $48$ and a fourth term equal to $\\frac{3}{4}.$ What is the sum to infinity of the terms of this sequence?" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{1}=48$ and ${a}_{4}=\\frac{3}{4}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{4-1} & =\\frac{(\\frac{3}{4})}{48} \\\\ {r}^{3} & =\\frac{1}{64} \\\\ {r}^{3} & ={(\\frac{1}{4})}^{3} \\\\ r & =\\frac{1}{4}\\end{aligned}\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{48}{(1-\\frac{1}{4})} \\\\  & =\\frac{48}{(\\frac{3}{4})} \\\\  & =48\\cdot \\frac{4}{3} \\\\  & =64.\\end{aligned}\n$$"}]}
