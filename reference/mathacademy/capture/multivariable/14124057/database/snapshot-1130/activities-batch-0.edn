#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186199281} :activity/id #uuid "3436fa6e-7d06-5a5e-90bb-b6107d2ecf0e" :activity/scope {:db/id #edb/ref 17592186048185 :topic/id #uuid "8698dcb0-d732-5f62-8605-520598e45185" :topic/math-academy-id 4145} :activity/steps [{:db/id #edb/ref 17592186199280 :step/content {:db/id #edb/ref 17592186198378 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198020 :question/id #uuid "9a1112c0-db94-5572-ba53-b78116b7c273" :question/math-academy-id "e-12355"} :knowledge-point/id #uuid "e9b46ce4-cfe0-5da6-bc91-65ae8c544393" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050188} {:db/id #edb/ref 17592186050508}] :knowledge-point/questions [{:db/id #edb/ref 17592186198584} {:db/id #edb/ref 17592186198585} {:db/id #edb/ref 17592186278446} {:db/id #edb/ref 17592186278470} {:db/id #edb/ref 17592186278471} {:db/id #edb/ref 17592186278507} {:db/id #edb/ref 17592186398507} {:db/id #edb/ref 17592186398534} {:db/id #edb/ref 17592186421783}] :knowledge-point/title "Expressing Flux Through a Surface as a Double Integral"} :step/id #uuid "a6470e60-331b-571e-b3d2-ff5a04e501fb" :step/math-academy-id 44278 :step/next {:db/id #edb/ref 17592186199283}} {:db/id #edb/ref 17592186199281 :step/content {:db/id #edb/ref 17592186199465 :tutorial/content "Recall that the flux of the vector field $\\mathbf F$ across a smooth, orientable surface $S$ with respect to the unit normal vector $\\mathbf{n}$ is given by \n\n$$\n\\iint\\limits_S \\mathbf F \\cdot \\textrm{d} \\mathbf{S}\n=\n\\iint\\limits_S  \\mathbf F \\cdot {\\color{blue}\\mathbf{n}} \\,\\textrm{d}S,\n$$\n\nwhere ${\\color{blue}\\mathbf{n}}$ is a unit normal vector that defines the orientation of the surface.\n\n![](images/9a/9aa63a1e4f1d278cef6c53600e8fb9c60829de972ba7409afdc32837ecbc3e07.png)\n\nIf $S$ is given by a parametric equation of the form \n\n$$\n\\mathbf{r}=\\mathbf{r}(u,v), \\qquad (u,v)\\in D\\subseteq \\mathbb{R}^2,\n$$\n\nwe can determine the unit normal vector using the fundamental product as follows:\n\n$$\n{\\color{blue}\\mathbf{n}} = \\dfrac{\\mathbf{r}'_u \\times \\mathbf{r}'_v}{\\| \\mathbf{r}'_u \\times \\mathbf{r}'_v \\|}\n$$\n\n \n\nSubstituting this into the formula for the flux, we obtain\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}F\\cdot \\frac{{r}_{u}^{′}\\times {r}_{v}^{′}}{‖{r}_{u}^{′}\\times {r}_{v}^{′}‖}\\,\\text{d}S \\\\  & ={∬}_{D}F(r(u,v))\\cdot \\frac{{r}_{u}^{′}\\times {r}_{v}^{′}}{‖{r}_{u}^{′}\\times {r}_{v}^{′}‖}\\,‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\,\\text{d}A \\\\  & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\\end{aligned}\n$$\n\nTherefore, if $S$ is a smooth, orientable surface given in parametric form by $\\mathbf{r}=\\mathbf{r}(u,v)$ for $(u,v)\\in D \\subseteq \\mathbb{R}^2,$ then the flux of the vector field $\\mathbf{F}$ across $S$ is given by\n\n$$\n\\iint\\limits_S \\mathbf F \\cdot \\textrm{d} \\mathbf{S} = \\iint\\limits_D  \\mathbf F(\\mathbf{r}(u,v)) \\cdot (\\mathbf{r}'_u \\times \\mathbf{r}'_v) \\: \\textrm{d}A.\n$$\n\nLet's see some examples." :tutorial/id #uuid "32db1cfe-d870-502c-a709-0a79ee70a616" :tutorial/math-academy-id 7633 :tutorial/title "Introduction"} :step/id #uuid "36b6d02c-b1f4-58b5-b15a-0a072e1d5cac" :step/math-academy-id 44280 :step/next {:db/id #edb/ref 17592186199280}} {:db/id #edb/ref 17592186199283 :step/content {:db/id #edb/ref 17592186198380 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198022 :question/id #uuid "0364a11f-e567-517e-acf2-471708dbdc0a" :question/math-academy-id "e-12358"} :knowledge-point/id #uuid "f322cca7-7530-50bf-b262-89faa81f5906" :knowledge-point/questions [{:db/id #edb/ref 17592186198586} {:db/id #edb/ref 17592186198592} {:db/id #edb/ref 17592186278448} {:db/id #edb/ref 17592186278449} {:db/id #edb/ref 17592186278450} {:db/id #edb/ref 17592186278455} {:db/id #edb/ref 17592186278459} {:db/id #edb/ref 17592186278461} {:db/id #edb/ref 17592186421784} {:db/id #edb/ref 17592186421785}] :knowledge-point/title "Evaluating Flux Through a Surface"} :step/id #uuid "d2e640e5-2cd0-57f1-8576-f38b3f6df4a4" :step/math-academy-id 44283}] :activity/title "Calculating Flux Through Parametric Surfaces" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186198487}]}
