  "live_records": {
    "q-143398": {
      "dom_id": "step-q143398",
      "name": "Question 1",
      "problem": "If ${X}_{1},{X}_{2},…,{X}_{80}$ is a sample of size $n=80$ drawn from a population with mean $\\mu =-2$ and variance ${\\sigma }^{2}=10,$ calculate the value of $\\text{Var}[\\overset{―}{X}].$",
      "worked_solution": "If ${X}_{1},{X}_{2},…,{X}_{n}$ is a sample of size $n$ from a population with population mean $\\mu $ and population variance ${\\sigma }^{2},$ then\n\n$$\n\\text{E}[\\overset{―}{X}]=\\mu ,\\,\\text{Var}[\\overset{―}{X}]=\\frac{{\\sigma }^{2}}{n}.\n$$\n\nSince the population variance ${\\sigma }^{2}=10$ and the sample size $n=80,$ we have that \n\n$$\n\\begin{aligned}\\text{Var}[\\overset{―}{X}] & =\\frac{10}{80} \\\\  & =\\frac{1}{8} \\\\  & =0.125.\\end{aligned}\n$$",
      "calculator_instructions": "",
