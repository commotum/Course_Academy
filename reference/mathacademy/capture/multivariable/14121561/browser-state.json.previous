              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-143402-a",
              "type": "math",
              "value": "0.06\\,{\\text{L}}^{2}",
              "html": "<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"30\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-msup><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c4C\"></mjx-c></mjx-mtext><mjx-script style=\"vertical-align: 0.41em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0.06</mn><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msup><mtext>L</mtext><mn>2</mn></msup></math></mjx-assistive-mml></mjx-container>"
            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-143402-b",
