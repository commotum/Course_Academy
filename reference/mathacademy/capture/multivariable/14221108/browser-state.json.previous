\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"23\"><span mathquill-command-id=\"25\">2</span><var mathquill-command-id=\"28\" class=\"mq-operator-name mq-first\">l</var><var mathquill-command-id=\"29\" class=\"mq-operator-name mq-last\">n</var><span mathquill-command-id=\"31\">2</span><span mathquill-command-id=\"33\" class=\"mq-binary-operator\">+</span><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"35\"><span class=\"mq-numerator\" mathquill-block-id=\"37\"><span mathquill-command-id=\"36\">3</span></span><span class=\"mq-denominator\" mathquill-block-id=\"39\"><span mathquill-command-id=\"38\">2</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div></div></div><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div class=\"questionWidget-spinner\" style=\"display: block;\"></div></div><div class=\"questionWidget-result\"><div class=\"questionWidget-correctIncorrectIcon\"><img src=\"/img/correct-answer.svg\"></div><div class=\"questionWidget-correctText\">Correct</div></div><div class=\"questionWidget-explanationHeader\">EXPLANATION</div><div class=\"questionWidget-explanation\"><p>Let's first factor the denominator of the integrand:\n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"110\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mstyle><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mrow><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" sp