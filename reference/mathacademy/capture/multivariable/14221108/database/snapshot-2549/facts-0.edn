5417] [17592186533873 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186533873 #edb/ref 1078 #edb/ref 17592186533256 #edb/ref 17592186045417] [17592186533873 #edb/ref 1079 #uuid "782cb243-75dd-5b8b-940c-de9dd816a45d" #edb/ref 17592186045417] [17592186533906 #edb/ref 1075 #edb/ref 17592186533594 #edb/ref 17592186045417] [17592186533906 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186533906 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186533906 #edb/ref 1078 #edb/ref 17592186533594 #edb/ref 17592186045417] [17592186533906 #edb/ref 1079 #uuid "a5e49120-4a4d-5acc-b35e-098953907a6f" #edb/ref 17592186045417] [17592186533938 #edb/ref 1075 #edb/ref 17592186533219 #edb/ref 17592186045417] [17592186533938 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186533938 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186533938 #edb/ref 1078 #edb/ref 17592186533219 #edb/ref 17592186045417] [17592186533938 #edb/ref 1079 #uuid "dfd3ac59-843e-571d-b47f-bc7b711b8324" #edb/ref 17592186045417] [17592186533998 #edb/ref 1068 #edb/ref 17592186533906 #edb/ref 17592186045417] [17592186533998 #edb/ref 1069 "q-346722" #edb/ref 17592186045417] [17592186533998 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186533998 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{2}\\frac{9-2x}{x(x-3)^{2}}\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186533998 #edb/ref 1072 #uuid "4254f874-a296-5085-b2f1-6690320d6f45" #edb/ref 17592186045417] [17592186533998 #edb/ref 1074 "First, we convert the integrand into a sum of partial fractions:\n\n$$\n\\frac{9-2x}{x(x-3)^{2}}=\\frac{A}{x}+\\frac{B}{x-3}+\\frac{C}{(x-3)^{2}}\n$$\n\nTo determine the coefficients $A,$ $B,$ and $C,$ we first multiply both sides of the above equation by $x(x-3)^{2}$ and get\n\n$$\n9-2x=A(x-3)^{2}+Bx(x-3)+Cx.\n$$\n\nPlugging in $x=0,$ we can eliminate $B$ and $C$ and solve for $A:$\n\n$$\n\\begin{aligned}9-2(0) & =A(0-3)^{2}+B(0)(0-3)+C(0) \\\\ 9 & =9A \\\\ A & =1\\end{aligned}\n$$\n\nPlugging in $x=3,$ we can eliminate $A$ and $B$ and solve for $C:$\n\n$$\n\\begin{aligned}9-2(3) & =A(3-3)^{2}+B(3)(3-3)+C(3) \\\\ 3 & =3C \\\\ C & =1\\end{aligned}\n$$\n\nPlugging in $x=1$ and substituting the known values of $A$ and $C,$ we can solve for $B:$\n\n$$\n\\begin{aligned}9-2(1) & =A(1-3)^{2}+B(1)(1-3)+C(1) \\\\ 7 & =4A-2B+C \\\\ 7 & =4(1)-2B+1 \\\\ B & =-1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{9-2x}{x(x-3)^{2}}=\\frac{1}{x}-\\frac{1}{x-3}+\\frac{1}{(x-3)^{2}}\n$$\n\nFinally, we integrate this expression term by term and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{9-2x}{x(x-3)^{2}}\\,\\text{d}x & ={\\int }_{1}^{2}(\\frac{1}{x}-\\frac{1}{x-3}+\\frac{1}{(x-3)^{2}})\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{x}\\,\\text{d}x-{\\int }_{1}^{2}\\frac{1}{x-3}\\,\\text{d}x+{\\int }_{1}^{2}\\frac{1}{(x-3)^{2}}\\text{d}x \\\\  & =\\operatorname{ln}⁡|x|\\,{|}_{1}^{2}-\\operatorname{ln}⁡|x-3|\\,{|}_{1}^{2}-\\frac{1}{x-3}\\,{|}_{1}^{2} \\\\  & =(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1)-(\\operatorname{ln}⁡1-\\operatorname{ln}⁡2)-(-1+\\frac{1}{2}) \\\\  & =2\\operatorname{ln}⁡2+\\frac{1}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186534018 #edb/ref 1068 #edb/ref 17592186533839 #edb/ref 17592186045417] [17592186534018 #edb/ref 1069 "q-115659" #edb/ref 17592186045417] [17592186534018 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186534018 #edb/ref 1071 "$\\int \\frac{{x}^{2}+8x+11}{(x+6)^{3}}\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186534018 #edb/ref 1072 #uuid "6d6e949e-2c23-5f49-968a-1d0b9baadd85" #edb/ref 17592186045417] [17592186534018 #edb/ref 1074 "First, we must convert the integrand into a sum of partial fractions:\n\n$$\n\\frac{{x}^{2}+8x+11}{(x+6)^{3}}=\\frac{A}{x+6}+\\frac{B}{(x+6)^{2}}+\\frac{C}{(x+6)^{3}}\n$$\n\nTo determine the coefficients $A,B,$ and $C,$ we first multiply both sides of the above equation by $(x+6)^{3}$ and get\n\n$$\n{x}^{2}+8x+11=A(x+6)^{2}+B(x+6)+C.\n$$\n\nPlugging in $x=-6,$ we can eliminate $A$ and $B$ and solve for $C:$\n\n$$\n\\begin{aligned}(-6)^{2}+8(-6)+11 & =A(-6+6)^{2}+B(-6+6)+C \\\\ -1 & =C\\end{aligned}\n$$\n\nNow, plugging in $x=0$ and substituting the known value of $C,$ we get an equation relating $A$ and $B:$\n\n$$\n\\begin{aligned}(0)^{2}+8(0)+11 & =A(0+6)^{2}+B(0+6)+C \\\\ 11 & =36A+6B-1 \\\\ 36A+6B & =12 \\\\ 6A+B & =2\\end{aligned}\n$$\n\nSimilarly, plugging in $x=-5$ and substituting the known value of $C,$ we get an equation relating $A$ and $B:$\n\n$$\n\\begin{aligned}(-5)^{2}+8(-5)+11 & =A(-5+6)^{2}+B(-5+6)+C \\\\ -4 & =A+B-1 \\\\ A+B & =-3\\end{aligned}\n$$\n\nSubtracting the equations $6A+B=2$ and $A+B=-3,$ we get\n\n$$\n\\begin{aligned}5A & =2-(-3) \\\\ A & =1,\\end{aligned}\n$$\n\nand substituting back into $A+B=-3,$ we get\n\n$$\n\\begin{aligned}1+B & =-3 \\\\ B & =-4.\\end{aligned}\n$$\n\nTherefore, we can write the integrand as the partial sum\n\n$$\n\\frac{{x}^{2}+8x+11}{(x+6)^{3}}=\\frac{1}{x+6}-\\frac{4}{(x+6)^{2}}-\\frac{1}{(x+6)^{3}}.\n$$\n\nFinally, we integrate this expression term by term to get\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}+8x+11}{(x+6)^{3}}\\,\\text{d}x & =\\int (\\frac{1}{x+6}-\\frac{4}{(x+6)^{2}}-\\frac{1}{(x+6)^{3}})\\,\\text{d}x \\\\  & =\\int \\frac{1}{x+6}\\,\\text{d}x-4\\int \\frac{1}{(x+6)^{2}}\\,\\text{d}x-\\int \\frac{1}{(x+6)^{3}}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|x+6|+\\frac{4}{(x+6)}+\\frac{1}{2(x+6)^{2}}+K,\\end{aligned}\n$$\n\nwhere $K$ is an integral constant." #edb/ref 17592186045417] [17592186534074 #edb/ref 1068 #edb/ref 17592186533873 #edb/ref 17592186045417] [17592186534074 #edb/ref 1069 "q-348615" #edb/ref 17592186045417] [17592186534074 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186534074 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-3}^{-2}\\frac{5-3x}{{x}^{2}+2x+1}\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186534074 #edb/ref 1072 #uuid "d58d6a00-0092-54a9-834c-43383db09b35" #edb/ref 17592186045417] [17592186534074 #edb/ref 1074 "Let's first factor the denominator of the integrand:\n\n$$\n\\frac{5-3x}{{x}^{2}+2x+1}=\\frac{5-3x}{(x+1)^{2}}\n$$\n\nWe must convert the integrand into a sum of partial fractions:\n\n$$\n\\frac{5-3x}{(x+1)^{2}}=\\frac{A}{x+1}+\\frac{B}{(x+1)^{2}}\n$$\n\nTo determine the coefficients $A$ and $B,$ we first multiply both sides of the above equation by $(x+1)^{2}$ and get\n\n$$\n5-3x=A(x+1)+B.\n$$\n\nPlugging in $x=-1,$ we can eliminate $A$ and solve for $B:$\n\n$$\n\\begin{aligned}5-3(-1) & =A(-1+1)+B \\\\ B & =8\\end{aligned}\n$$\n\nNow, plugging in $x=0$ and substituting the known value of $B,$ we can solve for $A:$\n\n$$\n\\begin{aligned}5-3(0) & =A(0+1)+8 \\\\ 5 & =A+8 \\\\ A & =-3\\end{aligned}\n$$\n\nTherefore, we can write the integrand as the partial sum:\n\n$$\n\\frac{5-3x}{(x+1)^{2}}=-\\frac{3}{x+1}+\\frac{8}{(x+1)^{2}}\n$$\n\nFinally, we integrate this expression term by term to get\n\n$$\n\\begin{aligned}{\\int }_{-3}^{-2}\\frac{5-3x}{(x+1)^{2}}\\,\\text{d}x & ={\\int }_{-3}^{-2}(-\\frac{3}{x+1}+\\frac{8}{(x+1)^{2}})\\text{d}x \\\\  & =-3{\\int }_{-3}^{-2}\\frac{1}{x+1}\\,\\text{d}x+8{\\int }_{-3}^{-2}\\frac{1}{(x+1)^{2}}\\,\\text{d}x \\\\  & =-3\\operatorname{ln}⁡|x+1|\\,{|}_{-3}^{-2}-8\\cdot \\frac{1}{x+1}\\,{|}_{-3}^{-2} \\\\  & =-3(\\operatorname{ln}⁡1-\\operatorname{ln}⁡2)-8(-1-(-\\frac{1}{2})) \\\\  & =-3\\operatorname{ln}⁡(\\frac{1}{2})-8(-\\frac{1}{2}) \\\\  & =3\\operatorname{ln}⁡2+4.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186534098 #edb/ref 1068 #edb/ref 17592186533938 #edb/ref 17592186045417] [17592186534098 #edb/ref 1069 "q-348616" #edb/ref 17592186045417] [17592186534098 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186534098 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{3}^{4}\\frac{2x-1}{{x}^{2}-4x+4}\\,\\text{d}x=$\n\n{{field-1}}" #edb/ref 17592186045417] [17592186534098 #edb/ref 1072 #uuid "fd717c83-b2bc-5cde-b553-20c9ad00a74f" #edb/ref 17592186045417] [17592186534098 #edb/ref 1074 "Let's first factor the denominator of the integrand:\n\n$$\n\\frac{2x-1}{{x}^{2}-4x+4}=\\frac{2x-1}{(x-2)^{2}}\n$$\n\nWe must convert the integrand into a sum of partial fractions:\n\n$$\n\\frac{2x-1}{(x-2)^{2}}=\\frac{A}{x-2}+\\frac{B}{(x-2)^{2}}\n$$\n\nTo determine the coefficients $A$ and $B,$ we first multiply both sides of the above equation by $(x-2)^{2}$ and get\n\n$$\n2x-1=A(x-2)+B.\n$$\n\nPlugging in $x=2,$ we can eliminate $A$ and solve for $B:$\n\n$$\n\\begin{aligned}2(2)-1 & =A(2-2)+B \\\\ B & =3\\end{aligned}\n$$\n\nNow, plugging in $x=0$ and substituting the known value of $B,$ we can solve for $A:$\n\n$$\n\\begin{aligned}2(0)-1 & =A(0-2)+3 \\\\ -1 & =-2A+3 \\\\ A & =2\\end{aligned}\n$$\n\nTherefore, we can write the integrand as the partial sum:\n\n$$\n\\frac{2x-1}{(x-2)^{2}}=\\frac{2}{x-2}+\\frac{3}{(x-2)^{2}}\n$$\n\nFinally, we integrate this expression term by term to get\n\n$$\n\\begin{aligned}{\\int }_{3}^{4}\\frac{2x-1}{(x-2)^{2}}\\,\\text{d}x & ={\\int }_{3}^{4}(\\frac{2}{x-2}+\\frac{3}{(x-2)^{2}})\\text{d}x \\\\  & =2{\\int }_{3}^{4}\\frac{1}{x-2}\\,\\text{d}x+3{\\int }_{3}^{4}\\frac{1}{(x-2)^{2}}\\,\\text{d}x \\\\  & =2\\operatorname{ln}⁡|x-2|\\,{|}_{3}^{4}-3\\cdot \\frac{1}{x-2}\\,{|}_{3}^{4} \\\\  & =2(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1)-3(\\frac{1}{2}-1) \\\\  & =2\\operatorname{ln}⁡(\\frac{2}{1})-3(-\\frac{1}{2}) \\\\  & =2\\operatorname{ln}⁡2+\\frac{3}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186534102 #edb/ref 1058 #edb/ref 17592186534113 #edb/ref 17592186045417] [17592186534102 #edb/ref 1062 #uuid "069d670c-cd83-5d0b-9f6b-dc9fcde46e21" #edb/ref 17592186045417] [17592186534102 #edb/ref 1063 #edb/ref 17592186534074 #edb/ref 17592186045417] [17592186534113 #edb/ref 1062 #uuid "288cf9b3-dd3f-5505-b4fa-8e8060a38d1d" #edb/ref 17592186045417] [17592186534113 