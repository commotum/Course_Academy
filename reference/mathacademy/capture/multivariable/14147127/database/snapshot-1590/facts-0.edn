0-978c-fded9c69ed78" #edb/ref 17592186045417] [17592186280859 #edb/ref 1075 #edb/ref 17592186279220 #edb/ref 17592186045417] [17592186280859 #edb/ref 1075 #edb/ref 17592186279312 #edb/ref 17592186045417] [17592186280859 #edb/ref 1075 #edb/ref 17592186279717 #edb/ref 17592186045417] [17592186280859 #edb/ref 1075 #edb/ref 17592186280086 #edb/ref 17592186045417] [17592186280859 #edb/ref 1075 #edb/ref 17592186280386 #edb/ref 17592186045417] [17592186280859 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186280859 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186280859 #edb/ref 1078 #edb/ref 17592186280386 #edb/ref 17592186045417] [17592186280859 #edb/ref 1079 #uuid "0ddaedb2-b68c-5509-aca4-917bce34c4eb" #edb/ref 17592186045417] [17592186280905 #edb/ref 1075 #edb/ref 17592186278851 #edb/ref 17592186045417] [17592186280905 #edb/ref 1075 #edb/ref 17592186279037 #edb/ref 17592186045417] [17592186280905 #edb/ref 1075 #edb/ref 17592186279196 #edb/ref 17592186045417] [17592186280905 #edb/ref 1075 #edb/ref 17592186280110 #edb/ref 17592186045417] [17592186280905 #edb/ref 1075 #edb/ref 17592186280591 #edb/ref 17592186045417] [17592186280905 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186280905 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186280905 #edb/ref 1078 #edb/ref 17592186279196 #edb/ref 17592186045417] [17592186280905 #edb/ref 1079 #uuid "27a2ccf4-8749-57d6-a76d-0242f177c147" #edb/ref 17592186045417] [17592186281070 #edb/ref 1075 #edb/ref 17592186278645 #edb/ref 17592186045417] [17592186281070 #edb/ref 1075 #edb/ref 17592186278753 #edb/ref 17592186045417] [17592186281070 #edb/ref 1075 #edb/ref 17592186279189 #edb/ref 17592186045417] [17592186281070 #edb/ref 1075 #edb/ref 17592186279411 #edb/ref 17592186045417] [17592186281070 #edb/ref 1075 #edb/ref 17592186280814 #edb/ref 17592186045417] [17592186281070 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186281070 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186281070 #edb/ref 1078 #edb/ref 17592186280814 #edb/ref 17592186045417] [17592186281070 #edb/ref 1079 #uuid "8306574e-b0dd-58d3-90c0-2fcec5bd2691" #edb/ref 17592186045417] [17592186281375 #edb/ref 1068 #edb/ref 17592186280859 #edb/ref 17592186045417] [17592186281375 #edb/ref 1069 "q-161899" #edb/ref 17592186045417] [17592186281375 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186281375 #edb/ref 1071 "![](images/8a/8a48be0b4c101babf157a05959e923576ad5614113b3eec9e93fe747d5dc3803.png)\n\nConsider the vector field $F=⟨1,\\,x,\\,0⟩$ and the closed surface $S$ that represents the boundary of the solid shown above. Let $D$ be the projection of $S$ onto the $xy$-plane. The flux of $F$ across $S$ can be expressed in terms of a double integral as \n\n$$\n{∬}_{S}F\\cdot dS={∬}_{D}\\,\\,\\text{d}A.\n$$\n\nWhich of the following could be the missing expression?" #edb/ref 17592186045417] [17592186281375 #edb/ref 1072 #uuid "a4e1f048-4c99-5435-999b-508c95c11d59" #edb/ref 17592186045417] [17592186281375 #edb/ref 1074 "Since we have a closed surface, the positive orientation is outward-pointing by convention. So, \n\n- the upper surface ${S}_{1}:z=g(x,y)=\\sqrt{1-{x}^{2}-{y}^{2}}$ is oriented upward, and\n\n- the lower surface ${S}_{2}:z=h(x,y)=0$ is oriented downward.\n\nNow, we write down the flux across each of the surfaces separately.\n\n- Consider the upper hemisphere ${S}_{1}.$\n\nWe compute the partial derivatives of $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(\\sqrt{1-{x}^{2}-{y}^{2}})=-\\frac{x}{\\sqrt{1-{x}^{2}-{y}^{2}}} \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(\\sqrt{1-{x}^{2}-{y}^{2}})=-\\frac{y}{\\sqrt{1-{x}^{2}-{y}^{2}}}\\end{aligned}\n$$\n\nIf we denote $F=⟨P,\\,Q,\\,R⟩,$ then\n\n$$\nP=1,\\,Q=x,\\,R=0.\n$$\n\n \n\nAs a result, since the positive orientation is upward, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}-1\\cdot (-\\frac{x}{\\sqrt{1-{x}^{2}-{y}^{2}}})-x\\cdot (-\\frac{y}{\\sqrt{1-{x}^{2}-{y}^{2}}})+0\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{x+xy}{\\sqrt{1-{x}^{2}-{y}^{2}}}\\,\\text{d}A.\\end{aligned}\n$$\n\n- Consider the lower plane ${S}_{2}.$ \n\nSince the positive orientation is downward, the unit normal vector to the plane is $n=⟨0,0,-1⟩.$ As a result, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot \\text{d}S & ={∬}_{{S}_{2}}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{D}⟨1,x,0⟩\\cdot ⟨0,0,-1⟩\\,\\text{d}A \\\\  & ={∬}_{D}0\\,\\text{d}A \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, the flux of $F$ across the entire surface is \n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot \\text{d}S+{∬}_{{S}_{2}}F\\cdot \\text{d}S \\\\  & ={∬}_{D}\\frac{x+xy}{\\sqrt{1-{x}^{2}-{y}^{2}}}\\,\\text{d}A+0 \\\\  & ={∬}_{D}\\frac{x+xy}{\\sqrt{1-{x}^{2}-{y}^{2}}}\\,\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186281376 #edb/ref 1068 #edb/ref 17592186281070 #edb/ref 17592186045417] [17592186281376 #edb/ref 1069 "q-161905" #edb/ref 17592186045417] [17592186281376 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186281376 #edb/ref 1071 "Consider the vector field $F=⟨z,\\,0,\\,y⟩$ and the closed surface $S$ that encloses the finite region between the paraboloid $z={x}^{2}+{y}^{2}-5$ and the plane $z=0.$ Let $D$ be the projection of $S$ onto the $xy$-plane. The flux of $F$ across $S$ can be expressed in terms of a double integral as \n\n$$\n{∬}_{S}F\\cdot dS={∬}_{D}\\,\\,\\text{d}A.\n$$\n\nWhich of the following could be the missing expression?" #edb/ref 17592186045417] [17592186281376 #edb/ref 1072 #uuid "ca856459-2199-5fb8-97c9-ba0974b5b2db" #edb/ref 17592186045417] [17592186281376 #edb/ref 1074 "Since we have a closed surface, the positive orientation is outward-pointing by convention. So,\n\n- the upper surface ${S}_{1}:z=g(x,y)=0$ is oriented upward, and\n\n- the lower surface ${S}_{2}:z=h(x,y)={x}^{2}+{y}^{2}-5$ is oriented downward.\n\nNow, we write down the flux across each of the surfaces separately.\n\n- Consider the upper plane ${S}_{1}.$\n\nSince the positive orientation is upward, the unit normal vector to the plane is $n=⟨0,0,1⟩.$ As a result, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{D}⟨z,0,y⟩\\cdot ⟨0,0,1⟩\\,\\text{d}A \\\\  & ={∬}_{D}y\\,\\text{d}A.\\end{aligned}\n$$\n\n- Consider lower paraboloid ${S}_{2}.$ \n\nWe compute the partial derivatives of $z=h(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =\\frac{∂}{∂x}({x}^{2}+{y}^{2}-5)=2x \\\\ \\frac{∂h}{∂y} & =\\frac{∂}{∂y}({x}^{2}+{y}^{2}-5)=2y\\end{aligned}\n$$\n\nIf we denote $F=⟨P,\\,Q,\\,R⟩,$ then\n\n$$\nP=z={x}^{2}+{y}^{2}-5,\\,Q=0,\\,R=y.\n$$\n\n \n\nAs a result, since the positive orientation is downward, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot \\text{d}S & =-{∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & =-{∬}_{D}(-({x}^{2}+{y}^{2}-5)\\cdot (2x)-(0)\\cdot (2y)+y)\\,\\text{d}A \\\\  & =-{∬}_{D}(-2{x}^{3}-2x{y}^{2}+10x+y)\\,\\text{d}A \\\\  & ={∬}_{D}2{x}^{3}+2x{y}^{2}-10x-y\\,\\text{d}A.\\end{aligned}\n$$\n\nTherefore, the flux across the entire surface is \n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot \\text{d}S+{∬}_{{S}_{2}}F\\cdot \\text{d}S \\\\  & ={∬}_{D}y\\,\\text{d}A+{∬}_{D}2{x}^{3}+2x{y}^{2}-10x-y\\,\\text{d}A \\\\  & ={∬}_{D}2{x}^{3}+2x{y}^{2}-10x\\,\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186371981 #edb/ref 1068 #edb/ref 17592186371982 #edb/ref 17592186045417] [17592186371981 #edb/ref 1069 "q-161898" #edb/ref 17592186045417] [17592186371981 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186371981 #edb/ref 1071 "Consider the vector field $F=⟨z,\\,0,\\,x⟩$ and the closed surface $S$ that encloses the finite region between the paraboloid $z=9-{x}^{2}-{y}^{2}$ and the plane $z=1.$ Let $D$ be the projection of $S$ onto the $xy$-plane. The flux of $F$ across $S$ can be expressed in terms of a double integral as \n\n$$\n{∬}_{S}F\\cdot dS={∬}_{D}\\,\\,\\text{d}A.\n$$\n\nWhich of the following could be the missing expression?" #edb/ref 17592186045417] [17592186371981 #edb/ref 1072 #uuid "71368570-4ef4-5d96-b173-947fce0b9458" #edb/ref 17592186045417] [17592186371981 #edb/ref 1074 "Since we have a closed surface, the positive orientation is outward-pointing by convention. So,\n\n- the upper surface ${S}_{1}:z=g(x,y)=9-{x}^{2}-{y}^{2}$ is oriented upward, and\n\n- the lower surface ${S}_{2}:z=h(x,y)=1$ is oriented downward.\n\nNow, we write down the flux across each of the surfaces separately.\n\n- Consider the upper paraboloid ${S}_{1}.$\n\nWe compute the partial derivatives of $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(9-{x}^{2}-{y}^{2})=-2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(9-{x}^{2}-{y}^{2})=-2y\\end{aligned}\n$$\n\nIf we denote $F=⟨P,\\,Q,\\,R⟩,$ then\n\n$$\nP=z=9-{x}^{2}-{y}^{2},\\,Q=0,\\,R=x.\n$$\n\n \n\nAs a result, since the positive orientation is upward, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(9-{x}^{2}-{y}^{2})\\cdot (-2x)-(0)\\cdot (-2y)+x)\\,\\text{d}A \\\\  & ={∬}_{D}(18x-2{x}^{3}-2x{y}^{2}+x)\\,\\text{d}A \\\\  & ={∬}_{D}19x-2{x}^{3}-2x{y}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\n- Consider lower plane ${S}_{2}.$ \n\nSince the positive orientation is downward, the unit normal vector to the plane is $n=⟨0,0,-1⟩.$ As a result, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot \\text{d}S & ={∬}_{{S}_{2}}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{D}⟨z,0,x⟩\\cdot ⟨0,0,-1⟩\\,\\text{d}A \\\\  & ={∬}_{D}-x\\,\\text{d}A.\\end{aligned}\n$$\n\nTherefore, the flux across the entire surface is \n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot \\text{d}S+{∬}_{{S}_{2}}F\\cdot \\text{d}S \\\\  & ={∬}_{D}19x-2{x}^{3}-2x{y}^{2}\\,\\text{d}A+{∬}_{D}-x\\,\\text{d}A \\\\  & ={∬}_{D}18x-2{x}^{3}-2x{y}^{2}\\,\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186371982 #edb/ref 1075 #edb/ref 17592186371983 #edb/ref 17592186045417] [17592186371982 #edb/ref 1075 #edb/ref 17592186371984 #edb/ref 17592186045417] [17592186371982 #edb/ref 1075 #edb/ref 17592186371985 #edb/ref 17592186045417] [17592186371982 #edb/ref 1075 #edb/ref 17592186371986 #edb/ref 17592186045417] [17592186371982 #edb/ref 1075 #edb/ref 17592186371987 #edb/ref 17592186045417] [17592186371982 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186371982 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186371982 #edb/ref 1078 #edb/ref 17592186371985 #edb/ref 17592186045417] [17592186371982 #edb/ref 1079 #uuid "106248c3-5a77-5d72-aed7-25c25eb96f2f" #edb/ref 17592186045417] [17592186371983 #edb/ref 1080 "19x-2{x}^{3}+3{y}^{2}" #edb/ref 17592186045417] [17592186371983 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186371983 #edb/ref 1083 #uuid "69acc573-b0b8-5874-aab1-a28efcd81a93" #edb/ref 17592186045417] [17592186371984 #edb/ref 1080 "16x-x{y}^{2}+2{y}^{2}" #edb/ref 17592186045417] [17592186371984 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186371984 #edb/ref 1083 #uuid "59cdcb69-6653-5e15-899a-5aa388d46281" #edb/ref 17592186045417] [17592186371985 #edb/ref 1080 "18x-2{x}^{3}-2x{y}^{2}" #edb/ref 17592186045417] [17592186371985 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186371985 #edb/ref 1083 #uuid "3bfc894d-49bf-586f-9c15-0545c41d8169" #edb/ref 17592186045417] [17592186371986 #edb/ref 1080 "20x+2y{x}^{3}-2x{y}^{2}" #edb/ref 17592186045417] [17592186371986 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186371986 #edb/ref 1083 #uuid "79846a78-79c8-5a37-ae61-84fe6a556fc5" #edb/ref 17592186045417] [17592186371987 #edb/ref 1080 "20x+{x}^{3}-2x{y}^{2}" #edb/ref 17592186045417] [17592186371987 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186371987 #edb/ref 1083 #uuid "c5c3b3f1-d211-5651-a1bd-4e92f6df7b3c" #edb/ref 17592186045417] [17592186405069 #edb/ref 1068 #edb/ref 17592186405070 #edb/ref 17592186045417] [17592186405069 #edb/ref 1069 "q-161896" #edb/ref 17592186045417] [17592186405069 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186405069 #edb/ref 1071 "![](images/14/1422e6534c001214335dcddb8888f7e2e9344e440379c47da38514e9a3ef0bd8.png)\n\nConsider the vector field $F=⟨z,\\,0,\\,2⟩$ and the closed surface $S$ that represents the boundary of the solid shown above. Let $D$ be the projection of $S$ onto the $xy$-plane. The flux of $F$ across $S$ can be expressed in terms of a double integral as \n\n$$\n{∬}_{S}F\\cdot dS={∬}_{D}\\,\\,\\text{d}A.\n$$\n\nWhich expression belongs in the blank when the upper and lower surfaces are parametrized as graphs over $D$ and their outward flux integrands are added pointwise where defined, before integration?" #edb/ref 17592186045423] [17592186405069 #edb/ref 1072 #uuid "0d7ee053-a1f8-527b-9332-a3761ff9b930" #edb/ref 17592186045417] [17592186405069 #edb/ref 1074 "Since we have a closed surface, the positive orientation is outward-pointing by convention. So, \n\n- the upper surface ${S}_{1}:z=g(x,y)=1-\\sqrt{{x}^{2}+{y}^{2}}$ is oriented upward, and\n\n- the lower surface ${S}_{2}:z=h(x,y)=0$ is oriented downward.\n\nNow, we write down the flux across each of the surfaces separately.\n\n- Consider the upper cone ${S}_{1}.$\n\nWe compute the partial derivatives of $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(1-\\sqrt{{x}^{2}+{y}^{2}})=-\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}} \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(1-\\sqrt{{x}^{2}+{y}^{2}})=-\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}}\\end{aligned}\n$$\n\nIf we denote $F=⟨P,\\,Q,\\,R⟩,$ then\n\n$$\nP=z=1-\\sqrt{{x}^{2}+{y}^{2}},\\,Q=0,\\,R=2.\n$$\n\n \n\nAs a result, since the positive orientation is upward, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}-(1-\\sqrt{{x}^{2}+{y}^{2}})\\cdot (-\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}})-0\\cdot (-\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}})+2\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}}-x+2\\,\\text{d}A.\\end{aligned}\n$$\n\n- Consider the lower plane ${S}_{2}.$ \n\nSince the positive orientation is downward, the unit normal vector to the plane is $n=⟨0,0,-1⟩.$ As a result, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot \\text{d}S & ={∬}_{{S}_{2}}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{D}⟨z,0,2⟩\\cdot ⟨0,0,-1⟩\\,\\text{d}A \\\\  & ={∬}_{D}-2\\,\\text{d}A.\\end{aligned}\n$$\n\nTherefore, the flux of $F$ across the entire surface is \n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot \\text{d}S+{∬}_{{S}_{2}}F\\cdot \\text{d}S \\\\  & ={∬}_{D}\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}}-x+2\\,\\text{d}A+{∬}_{D}-2\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}}-x\\,\\text{d}A.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186405070 #edb/ref 1075 #edb/ref 17592186405071 #edb/ref 17592186045417] [17592186405070 #edb/ref 1075 #edb/ref 17592186405072 #edb/ref 17592186045417] [17592186405070 #edb/ref 1075 #edb/ref 17592186405073 #edb/ref 17592186045417] [17592186405070 #edb/ref 1075 #edb/ref 17592186405074 #edb/ref 17592186045417] [17592186405070 #edb/ref 1075 #edb/ref 17592186405075 #edb/ref 17592186045417] [17592186405070 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186405070 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186405070 #edb/ref 1078 #edb/ref 17592186405072 #edb/ref 17592186045417] [17592186405070 #edb/ref 1079 #uuid "1886a1f4-707b-5268-9cc1-ed7effda4966" #edb/ref 17592186045417] [17592186405071 #edb/ref 1080 "\\frac{xy}{\\sqrt{{x}^{2}+{y}^{2}}}+2" #edb/ref 17592186045417] [17592186405071 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186405071 #edb/ref 1083 #uuid "855f9cab-5970-5823-b1ec-e6f8c8330244" #edb/re