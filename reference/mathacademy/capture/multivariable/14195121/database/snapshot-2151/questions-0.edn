#{[{:db/id #edb/ref 17592186184876 :knowledge-point/_questions [{:db/id #edb/ref 17592186184198 :knowledge-point/id #uuid "e2bf7196-b681-5ff6-bf16-24acefa04e6c" :knowledge-point/title "Finding the Singular Values of a Square Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ac2533-62db-535c-8dc9-3e42649cc9f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ and $2$" :db/id #edb/ref 17592186368873} {:answer/id #uuid "40993328-f48a-5d16-8477-6064543ac098" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ and $0$" :db/id #edb/ref 17592186368874} {:answer/id #uuid "02e843f4-0fc7-5f0b-a07b-3fa3bfc2abd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{10}$ and $0$" :db/id #edb/ref 17592186368875} {:answer/id #uuid "98d65d3b-180c-559c-9c5f-db57ec8866a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ and $2$" :db/id #edb/ref 17592186368876} {:answer/id #uuid "f0117d76-d5c6-543b-9609-b905ac185a64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ and $0$" :db/id #edb/ref 17592186368877}] :answer-field/correct {:answer/id #uuid "02e843f4-0fc7-5f0b-a07b-3fa3bfc2abd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{10}$ and $0$" :db/id #edb/ref 17592186368875} :answer-field/id #uuid "9f0db150-06f0-53a7-8afc-b9734abea2f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368872}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5015d1af-a116-557e-a448-94566c652f07" :question/math-academy-id "q-94773" :question/problem "What are the singular values of the matrix $A=[\\begin{aligned}1 & 2 \\\\ -1 & -2\\end{aligned}]?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}1 & 2 \\\\ -1 & -2\\end{aligned}]}^{T}[\\begin{aligned}1 & 2 \\\\ -1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ 2 & -2\\end{aligned}][\\begin{aligned}1 & 2 \\\\ -1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 4 \\\\ 4 & 8\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}2-\\lambda  & 4 \\\\ 4 & 8-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )(8-\\lambda )-16 & =0 \\\\ 16-2\\lambda -8\\lambda +{\\lambda }^{2}-16 & =0 \\\\ {\\lambda }^{2}-10\\lambda  & =0 \\\\ \\lambda (\\lambda -10) & =0 \\\\ \\lambda  & =10,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{10} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184879 :knowledge-point/_questions [{:db/id #edb/ref 17592186184199 :knowledge-point/id #uuid "e70dec8f-9828-5fe7-bdb7-47e6557fc889" :knowledge-point/title "Finding the Singular Values of a Rectangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d60bfe-9b93-5322-a886-7bb0f57eff46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5,\\,4,\\,0" :db/id #edb/ref 17592186508445} {:answer/id #uuid "2a9003af-2b01-57da-a933-16ff4579b8dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25,\\,4,\\,0" :db/id #edb/ref 17592186508455} {:answer/id #uuid "80e9ab77-14e2-509c-baf9-6e9048da53b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186508580} {:answer/id #uuid "e99a56fa-1127-5a1f-872f-bba0b1b2c89b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3,\\,3,\\,0" :db/id #edb/ref 17592186508761} {:answer/id #uuid "ebe89adf-37a2-5724-a8e8-777891808839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186508767}] :answer-field/correct {:answer/id #uuid "22d60bfe-9b93-5322-a886-7bb0f57eff46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5,\\,4,\\,0" :db/id #edb/ref 17592186508445} :answer-field/id #uuid "32eedbf9-e833-5743-ba35-1e838f8db9de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183883}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "421dde5b-98b5-58e5-8139-6656005b4621" :question/math-academy-id "q-94983" :question/problem "What are the singular values of the matrix $A=[\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}]?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}]}^{T}[\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 3 \\\\ -4 & 0 \\\\ 0 & -4\\end{aligned}][\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}9 & 0 & -12 \\\\ 0 & 16 & 0 \\\\ -12 & 0 & 16\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}9-\\lambda  & 0 & -12 \\\\ 0 & 16-\\lambda  & 0 \\\\ -12 & 0 & 16-\\lambda \\end{aligned}| & =0 \\\\ (16-\\lambda )|\\begin{aligned}9-\\lambda  & -12 \\\\ -12 & 16-\\lambda \\end{aligned}| & =0 \\\\ (16-\\lambda )((9-\\lambda )(16-\\lambda )-144) & =0 \\\\ (16-\\lambda )({\\lambda }^{2}-9\\lambda -16\\lambda +144-144) & =0 \\\\ (16-\\lambda )({\\lambda }^{2}-25\\lambda ) & =0 \\\\ \\lambda (\\lambda -16)(\\lambda -25) & =0 \\\\ \\lambda  & =25,\\,16,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{25}=5 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{16}=4 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186493969 :knowledge-point/_questions [{:db/id #edb/ref 17592186184197 :knowledge-point/id #uuid "8063bc9c-a10d-562b-93b1-508b4b26a674" :knowledge-point/title "Identifying True Statements Regarding the Singular Values of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08b31b5f-4d45-56bb-9d27-10f181056843" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186493405} {:answer/id #uuid "1f5ebfbd-349c-5710-ab1d-bffdb6d4d025" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186493445} {:answer/id #uuid "21c0505d-1159-59fb-ba8b-2bd5ac4199de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186493447} {:answer/id #uuid "94c66a12-70a7-529f-ba21-ac7f034b13c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186493623} {:answer/id #uuid "e4ada2c6-ebf0-5d58-9a21-8f0d7d2bddb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186493752}] :answer-field/correct {:answer/id #uuid "21c0505d-1159-59fb-ba8b-2bd5ac4199de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186493447} :answer-field/id #uuid "6457d0d0-1968-5324-849a-7bcaae3a3d7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493831}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dfba6eb1-d0b6-5cbc-ac16-d682a2e1cc93" :question/math-academy-id "q-95286" :question/problem "Which of the following statements are true?\n\nI. Any $6\\times 5$ matrix $A$ has at most $6$ distinct singular values.\n\nII. Any $8\\times 9$ matrix $A$ has at most $9$ distinct singular values.\n\nIII. The matrix $A=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]$ has at most two non-negative distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Since $A$ is a $6\\times 5$ matrix and ${A}^{T}$ is a $5\\times 6$ matrix, ${A}^{T}\\,A$ must be a $5\\times 5$ matrix: \n\n$$\n{{A}^{T}}_{5\\times 6}\\times {A}_{6\\times 5}={{A}^{T}\\,A}_{5\\times 5}\n$$\n\nHence, $A$ has at most $5$ distinct singular values.\n\n- Statement II is true. Indeed, since $A$ is a $8\\times 9$ matrix and ${A}^{T}$ is a $9\\times 8$ matrix, ${A}^{T}\\,A$ must be a $9\\times 9$ matrix: \n\n$$\n{{A}^{T}}_{9\\times 8}\\times {A}_{8\\times 9}={{A}^{T}\\,A}_{9\\times 9}\n$$\n\nHence, $A$ has at most $9$ distinct singular values.\n\n- Statement III is true.  Indeed, all singular values of any matrix are non-negative.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186368913 :knowledge-point/_questions [{:db/id #edb/ref 17592186184199 :knowledge-point/id #uuid "e70dec8f-9828-5fe7-bdb7-47e6557fc889" :knowledge-point/title "Finding the Singular Values of a Rectangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f0d752a-b826-5c64-be10-12da661ba4f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186368915} {:answer/id #uuid "013ec41c-cc86-5fe4-b29a-accf164dceb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$13$ and $0$" :db/id #edb/ref 17592186368916} {:answer/id #uuid "24eac0e8-069f-5b0b-9420-f802df54dfb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{13}$ and $0$" :db/id #edb/ref 17592186368917} {:answer/id #uuid "a9aa8865-fb8b-5614-b9f2-9c3837814ef1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $1$" :db/id #edb/ref 17592186368918} {:answer/id #uuid "7be86b9d-e96c-5fac-9a1f-8fb3684e2c62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{3}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186368919}] :answer-field/correct {:answer/id #uuid "24eac0e8-069f-5b0b-9420-f802df54dfb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{13}$ and $0$" :db/id #edb/ref 17592186368917} :answer-field/id #uuid "fd34787a-f30f-575c-9f6f-407c026f6c03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368914}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "40523132-fd0a-5a78-90b5-ce48c89eb124" :question/math-academy-id "q-95317" :question/problem "What are the singular values of the matrix $A=[\\begin{aligned}3 & -2\\end{aligned}]?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}3 & -2\\end{aligned}]}^{T}[\\begin{aligned}3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ -2\\end{aligned}][\\begin{aligned}3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}9 & -6 \\\\ -6 & 4\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}9-\\lambda  & -6 \\\\ -6 & 4-\\lambda \\end{aligned}| & =0 \\\\ (9-\\lambda )(4-\\lambda )-36 & =0 \\\\ {\\lambda }^{2}-9\\lambda -4\\lambda +36-36 & =0 \\\\ {\\lambda }^{2}-13\\lambda  & =0 \\\\ \\lambda (\\lambda -13) & =0 \\\\ \\lambda  & =13,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{13} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186415575 :knowledge-point/_questions [{:db/id #edb/ref 17592186184198 :knowledge-point/id #uuid "e2bf7196-b681-5ff6-bf16-24acefa04e6c" :knowledge-point/title "Finding the Singular Values of a Square Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03cdbbac-81f1-5a5a-8c0b-cc9eada2874c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ and $5$" :db/id #edb/ref 17592186415544} {:answer/id #uuid "62cb00c2-7471-5b2f-86f0-ee1821df8b74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{3}$ and $1$" :db/id #edb/ref 17592186415553} {:answer/id #uuid "903124f2-18ad-506a-90f1-7a04c1d43894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $\\sqrt{2}$" :db/id #edb/ref 17592186415559} {:answer/id #uuid "a9a954e9-faca-5755-872b-2adf607495f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{5}$ and $\\sqrt{3}$" :db/id #edb/ref 17592186415561} {:answer/id #uuid "e9b697fb-7c5f-5191-9456-d6dcf71e2749" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{8}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186415567}] :answer-field/correct {:answer/id #uuid "e9b697fb-7c5f-5191-9456-d6dcf71e2749" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\sqrt{8}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186415567} :answer-field/id #uuid "2ee60de8-7912-55ad-80bc-fd51fae2e264" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415570}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35756e17-7ddb-5db3-9246-f082e3b776e5" :question/math-academy-id "q-95362" :question/problem "What are the singular values of the matrix $A=[\\begin{aligned}2 & -1 \\\\ 2 & 1\\end{aligned}]?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}2 & -1 \\\\ 2 & 1\\end{aligned}]}^{T}[\\begin{aligned}2 & -1 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 2 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}2 & -1 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}8 & 0 \\\\ 0 & 2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}8-\\lambda  & 0 \\\\ 0 & 2-\\lambda \\end{aligned}| & =0 \\\\ (8-\\lambda )(2-\\lambda ) & =0 \\\\ \\lambda  & =8,\\,2\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{8} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{2}\\end{aligned}\n$$"}]}
