 1072 #uuid "385e16b4-f8da-593a-b039-318c70552c9e" #edb/ref 17592186045417] [17592186393968 #edb/ref 1074 "The volume of the rectangular pyramid is $V=\\frac{1}{3}{a}^{2}h.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}V(a,h) & =(\\frac{∂V}{∂a})\\,\\text{d}a+(\\frac{∂V}{∂h})\\,\\text{d}h \\\\  & =\\frac{2ah}{3}\\,\\text{d}a+\\frac{{a}^{2}}{3}\\,\\text{d}h\\end{aligned}\n$$\n\nFor $a=6$ and $h=5,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}V(6,5) & =\\frac{2\\cdot 6\\cdot 5}{3}\\,\\text{d}a+\\frac{{6}^{2}}{3}\\,\\text{d}h \\\\  & =20\\,\\text{d}a+12\\,\\text{d}h.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186393969 #edb/ref 1075 #edb/ref 17592186393970 #edb/ref 17592186045417] [17592186393969 #edb/ref 1075 #edb/ref 17592186393971 #edb/ref 17592186045417] [17592186393969 #edb/ref 1075 #edb/ref 17592186393972 #edb/ref 17592186045417] [17592186393969 #edb/ref 1075 #edb/ref 17592186393973 #edb/ref 17592186045417] [17592186393969 #edb/ref 1075 #edb/ref 17592186393974 #edb/ref 17592186045417] [17592186393969 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186393969 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186393969 #edb/ref 1078 #edb/ref 17592186393971 #edb/ref 17592186045417] [17592186393969 #edb/ref 1079 #uuid "8a999ea8-f45c-57d2-a0a1-60c9a2283d50" #edb/ref 17592186045417] [17592186393970 #edb/ref 1080 "30\\,\\text{d}a+12\\,\\text{d}h" #edb/ref 17592186045417] [17592186393970 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186393970 #edb/ref 1083 #uuid "0f3e588b-cf69-5990-aade-5d4d0d244a5f" #edb/ref 17592186045417] [17592186393971 #edb/ref 1080 "20\\,\\text{d}a+12\\,\\text{d}h" #edb/ref 17592186045417] [17592186393971 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186393971 #edb/ref 1083 #uuid "6d1c30ac-f4e5-5cae-817e-6472dd651920" #edb/ref 17592186045417] [17592186393972 #edb/ref 1080 "20\\,\\text{d}a+10\\,\\text{d}h" #edb/ref 17592186045417] [17592186393972 #