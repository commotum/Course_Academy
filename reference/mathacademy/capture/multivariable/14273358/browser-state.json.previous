      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14273358/observations/step-q115663-8278fae5b201c0c9a426.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14273358/observations/step-q115663-8278fae5b201c0c9a426.png",
      "source_url": "https://mathacademy.com/tasks/14273358/topics/1206/review",
