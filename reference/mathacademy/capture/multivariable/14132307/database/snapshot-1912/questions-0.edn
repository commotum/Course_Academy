d #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{12}" :db/id #edb/ref 17592186432921}] :answer-field/correct {:answer/id #uuid "7e56db31-f6d3-51d5-b7fe-086fdc013aee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{12}" :db/id #edb/ref 17592186432921} :answer-field/id #uuid "4a13ad8b-c1ac-5b29-a0f8-bcc463aa542f" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186432943} {:answer-field/choices [{:answer/id #uuid "2cdc0021-e56d-56b4-822f-4e6bcc470a85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186432906} {:answer/id #uuid "51dd11dd-4ac5-5faa-a170-c8bc3c889e94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186432913} {:answer/id #uuid "8209e684-c4c4-59c4-b740-992d7736cdfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186432922} {:answer/id #uuid "aa5cf91a-1e6d-5ff5-b01d-3594e0559688" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186432931}] :answer-field/correct {:answer/id #uuid "8209e684-c4c4-59c4-b740-992d7736cdfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186432922} :answer-field/id #uuid "d897fb79-ca94-52e2-ae60-cbb8a8412f6e" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186432952}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45e143eb-b4b1-5a1c-8003-efa5644a6e01" :question/math-academy-id "q-343396" :question/problem "Consider the function $F(x)={x}^{2}$ defined on $x\\in [-2,2).$ The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼\\frac{4}{3}+{\\sum }_{n=1}^{\\infty }\\frac{16(-1)^{n}}{{\\pi }^{2}{n}^{2}}\\operatorname{cos}⁡(\\frac{n\\pi }{2}x).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(\\frac{n\\pi }{2}\\cdot 0)={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{{n}^{2}}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼\\frac{4}{3}+\\frac{16}{{\\pi }^{2}}{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}}\\cdot \\operatorname{cos}⁡(\\frac{n\\pi }{2}x).\n$$\n\nNow, notice that at $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(\\frac{n\\pi }{2}\\cdot 0)=\\operatorname{cos}⁡(0)=1.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)=0.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(0) & =\\frac{4}{3}+\\frac{16}{{\\pi }^{2}}{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}}\\cdot \\operatorname{cos}⁡(\\frac{n\\pi }{2}\\cdot 0) \\\\ 0 & =\\frac{4}{3}+\\frac{16}{{\\pi }^{2}}{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}}\\cdot 1 \\\\ -\\frac{4}{3} & =\\frac{16}{{\\pi }^{2}}{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}} & =-\\frac{{\\pi }^{2}}{12} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{{n}^{2}} & =\\frac{{\\pi }^{2}}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186432959 :knowledge-point/_questions [{:db/id #edb/ref 17592186166961 :knowledge-point/id #uuid "b3cb7656-1ce6-5b6a-9e88-5ba24a943c3f" :knowledge-point/title "Finding the Value of an Infinite Sum Using Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05b97949-cde4-59f8-b397-0315bd66b7fb" :answer/typ