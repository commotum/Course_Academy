ype {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186432927} :answer-field/id #uuid "b09fcbfd-30a5-5ba2-885a-3f7d1ddc7d3d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186432947} {:answer-field/choices [{:answer/id #uuid "8a13c0dd-d5e1-5f90-86be-bcec71dc9de0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186432923} {:answer/id #uuid "980993ab-c40a-5d8d-8f66-d8a4559b997a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "discontinuous" :db/id #edb/ref 17592186432925}] :answer-field/correct {:answer/id #uuid "8a13c0dd-d5e1-5f90-86be-bcec71dc9de0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186432923} :answer-field/id #uuid "cb4c04ac-867a-5bdf-a7eb-d4c641f208eb" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186432950} {:answer-field/choices [{:answer/id #uuid "a3600d93-a343-5e2b-9fd3-b127c6636f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186432928} {:answer/id #uuid "d37a3b04-2476-50c7-9891-3a42272ddc6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186432936} {:answer/id #uuid "e8187db1-2a0f-507c-a7f2-2fbfb8f9bfe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186432938}] :answer-field/correct {:answer/id #uuid "d37a3b04-2476-50c7-9891-3a42272ddc6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186432936} :answer-field/id #uuid "fba6274c-d3f7-52f9-9f2c-91008e14aece" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186432953}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6f140ac-a7bd-5b1b-9932-ff6284a345e8" :question/math-academy-id "q-343411" :question/problem "Consider the function $F(x)=|\\operatorname{cos}⁡x|$ defined on $x\\in [-\\pi ,\\pi ).$ The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼\\frac{2}{\\pi }-{\\sum }_{n=1}^{\\infty }\\frac{4(-1)^{n}}{\\pi (4{n}^{2}-1)}\\operatorname{cos}⁡(2nx).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(2n\\cdot 0)={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{4{n}^{2}-1}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼\\frac{2}{\\pi }-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{4{n}^{2}-1}\\cdot \\operatorname{cos}⁡(2nx).\n$$\n\nNow, notice that at $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(2n\\cdot 0)=\\operatorname{cos}⁡(0)=1.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)=1.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(0) & =\\frac{2}{\\pi }-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{4{n}^{2}-1}\\cdot \\operatorname{cos}⁡(2n\\cdot 0) \\\\ 1 & =\\frac{2}{\\pi }-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{4{n}^{2}-1}\\cdot 1 \\\\ \\pi  & =2-4{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{4{n}^{2}-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{4{n}^{2}-1} & =\\frac{2-\\pi }{4} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{4{n}^{2}-1} & =\\frac{\\pi -2}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317401 :knowledge-point/_questions [{:db/id #edb/ref 17592186166961 :knowledge-point/id #uuid "b3cb7656-1ce6-5b6a-9e88-5ba24a943c3f" :knowledge-point/title "Finding the Value of an Infinite Sum Using Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02ef83eb-7903-5ed1-889b-def0c697eddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186315133} {:answer/id #uuid "27e8af18-0de0-586a-9eba-abc08ba0860f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186315346} {:answer/id #uuid "39b7289a-e50b-58ae-adf6-ed3e51b77d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315449} {:answer/id #uuid "da376413-1d3f-5fc1-a97f-75c417a4de92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n}" :db/id #edb/ref 17592186316335}] :answer-field/correct {:answer/id #uuid "02ef83eb-7903-5ed1-889b-def0c697eddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186315133} :answer-field/id #uuid "7464d8a5-08db-527e-ae6f-a39637e25763" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316824} {:answer-field/choices [{:answer/id #uuid "25ed0276-2c2c-590f-8cf3-8e9560a9382e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315332} {:answer/id #uuid "3c0beb9b-15d0-5e7d-be81-a2261768c844" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186315464} {:answer/id #uuid "83f4701d-d6ed-5779-9953-ace7e06d74cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186315