level=\"0\"><mfrac><mrow><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>4</mn></mrow></msup><mo>+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>4</mn></mrow></msup></mrow><mrow><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>4</mn></mrow></msup><mo>−</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>4</mn></mrow></msup></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>2</mn><mo>+</mo><msup><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mn>2</mn><mo>−</mo><msup><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><mo>+</mo><msup><mn>4</mn><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mn>4</mn><mo>−</mo><msup><mn>4</mn><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>5</mn><mn>3</mn></mfrac></mstyle><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>17</mn><mn>15</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>8</mn><mn>15</mn></mfrac></mstyle></mpadded></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
