4" #edb/ref 17592186045417] [17592186155677 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186155677 #edb/ref 1083 #uuid "1fd64df2-e5b8-5aaa-a2df-8978d2413927" #edb/ref 17592186045417] [17592186155678 #edb/ref 1080 "36" #edb/ref 17592186045417] [17592186155678 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186155678 #edb/ref 1083 #uuid "540f5941-edc3-564d-ab1c-16a630b65ad4" #edb/ref 17592186045417] [17592186157000 #edb/ref 1069 "e-12522" #edb/ref 17592186045417] [17592186157000 #edb/ref 1071 "Find $\\boldsymbol f''(\\pi,0)$ for the function $f(x,y)$ given that\n![](images/08/08502aa81729d4f88aec094e2e2f5c7b4a57825ef3767f1eec29700ceb6e21a3.png)" #edb/ref 17592186045417] [17592186157000 #edb/ref 1072 #uuid "332b1d25-852f-51ad-9a38-62b562ae247f" #edb/ref 17592186045417] [17592186157000 #edb/ref 1074 "For a function $f: \\mathbb R^n \\to \\mathbb R,$ given by\n![](images/02/025dd1a0b89b52e32a3e42e5bd3492261ed060f104f627051b6950c7f94d66c1.png)\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n![](images/f1/f1a47569220f01e1dc474a13a5040e969449ee0b10cfe7df39c3aec4c6175f41.png)\n\nIn our case, we have\n\n![](images/f0/f0b46d26ccc6fefc404b021bde11c4d6959c00ae0ef1145a9984da602bcc54ef.png)\n\nFirst, notice that since ![](images/96/964f8ac9ca9c305faef8562f66d063f318ecbe402df337377bd9efdf61301567.png) \n we must have\n\n$$\n\\dfrac{\\partial f}{\\partial x} = e^y\\cos x ,  \n\\qquad \n\\dfrac{\\partial f}{\\partial y} =e^y\\sin x .\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}({e}^{y}\\operatorname{cos}⁡x)=-{e}^{y}\\operatorname{sin}⁡x\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}({e}^{y}\\operatorname{sin}⁡x)={e}^{y}\\operatorname{cos}⁡x \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}({e}^{y}\\operatorname{cos}⁡x)={e}^{y}\\operatorname{cos}⁡x\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}({e}^{y}\\operatorname{sin}⁡x)={e}^{y}\\operatorname{sin}⁡x\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}-{e}^{y}\\operatorname{sin}⁡x & {e}^{y}\\operatorname{cos}⁡x \\\\ {e}^{y}\\operatorname{cos}⁡x & {e}^{y}\\operatorname{sin}⁡x\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we evaluate this matrix at $(\\pi,0).$ This gives\n\n![](images/54/540c920abd2989b29aae275eedd179c5118e82354915e591c0d1c5296ca9fa21.png)" #edb/ref 17592186045417] [17592186157001 #edb/ref 1069 "e-12523" #edb/ref 17592186045417] [17592186157001 #edb/ref 1071 "Given that \n![](images/b3/b3e96b1a54af842b69da4ae5fcb44858bffdac48b27cde6677c15c05906e890d.png) \n evaluate the Hessian determinant of $f(x,y)$ at the point $(0,1).$" #edb/ref 17592186045417] [17592186157001 #edb/ref 1072 #uuid "53ca572c-798a-5529-9702-df3291a2b500" #edb/ref 17592186045417] [17592186157001 #edb/ref 1074 "For a function $f: \\mathbb R^n \\to \\mathbb R,$ given by\n![](images/af/af5524049f5f8b3c4c4241520f2d874b454d61b1b025362f5193437f766e610b.png)\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n![](images/88/8882516e2732e419efdfb8439265212dd4f380d6a6ea58f6ff1291030bf50bfb.png)\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(\\mathbf x) = \\det \\left( \\boldsymbol{f}''(\\mathbf x) \\right)\n$$\n\nIn our case, we have\n\n![](images/4f/4fede2bb5c2306f62b55b7996488baee52c69e7d41b011e0e9d2b7405e63a8f4.png)\n\nFirst, notice that since ![](images/92/9252d1ce4f5df828f45351d01e0709cf2f2ca5df2c9c25390c111f40ca00fb22.png) we must have\n\n$$\n\\dfrac{\\partial f}{\\partial x} = \\ln y, \n\\qquad \n\\dfrac{\\partial f}{\\partial y} = \\dfrac xy.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡y)=0\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{x}{y})=\\frac{1}{y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(\\operatorname{ln}⁡y)=\\frac{1}{y}\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(\\frac{x}{y})=-\\frac{x}{{y}^{2}}\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}0 & \\frac{1}{y} \\\\ \\frac{1}{y} & -\\frac{x}{{y}^{2}}\\end{aligned}].\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(0,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,1)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(0,1) = 0 \\cdot 0 - 1\\cdot 1 = -1.\n$$" #edb/ref 17592186045417] [17592186157002 #edb/ref 1069 "e-12524" #edb/ref 17592186045417] [17592186157002 #edb/ref 1071 "Find $\\boldsymbol f''(1,0)$ for the function $f(x,y)  = x^2 e^y.$" #edb/ref 17592186045417] [17592186157002 #edb/ref 1072 #uuid "235325ea-4a42-5f63-974a-edd459a4a771" #edb/ref 17592186045417] [17592186157002 #edb/ref 1074 "For a function $f: \\mathbb R^n \\to \\mathbb R,$ given by\n![](images/74/7444a8128c085d7bf4f56a57a60c260864a50da0b744b6dbe22a2ced89a0588d.png)\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n![](images/22/22dd960829ea268e5aade685b56949f8998f87ae8c040a90f04436cbfc6b9a58.png)\n\nIn our case, we have\n\n![](images/4f/4fede2bb5c2306f62b55b7996488baee52c69e7d41b011e0e9d2b7405e63a8f4.png)\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x,y) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}({x}^{2}{e}^{y}) & \\frac{∂}{∂y}({x}^{2}{e}^{y})\\end{aligned}] \\\\  & =[\\begin{aligned}2x{e}^{y} & {x}^{2}{e}^{y}\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x\\text{ }\\,{e}^{y})=2\\text{ }\\,{e}^{y}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}({x}^{2}{e}^{y})=2x\\text{ }\\,{e}^{y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x\\text{ }\\,{e}^{y})=2x\\text{ }\\,{e}^{y}\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}({x}^{2}{e}^{y})={x}^{2}{e}^{y}\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}2\\text{ }\\,{e}^{y} & 2x\\text{ }\\,{e}^{y} \\\\ 2x\\text{ }\\,{e}^{y} & {x}^{2}{e}^{y}\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we evaluate this matrix at $\\left(1,0\\right).$ This gives\n\n$$\n\\begin{aligned}{f}^{″}(1,0)=[\\begin{aligned}2 & 2 \\\\ 2 & 1\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186157423 #edb/ref 1037 #edb/ref 17592186048781 #edb/ref 17592186045417] [17592186157423 #edb/ref 1037 #edb/ref 17592186049696 #edb/ref 17592186045417] [17592186157423 #edb/ref 1037 #edb/ref 17592186049962 #edb/ref 17592186045417] [17592186157423 #edb/ref 1037 #edb/ref 17592186050021 #edb/ref 17592186045417] [17592186157423 #edb/ref 1038 #edb/ref 17592186157540 #edb/ref 17592186045417] [17592186157423 #edb/ref 1038 #edb/ref 17592186157791 #edb/ref 17592186045417] [17592186157423 #edb/ref 1038 #edb/ref 17592186284388 #edb/ref 17592186045417] [17592186157423 #edb/ref 1038 #edb/ref 17592186351224 #edb/ref 17592186045417] [17592186157423 #edb/ref 1038 #edb/ref 17592186389421 #edb/ref 17592186045417] [17592186157423 #edb/ref 1038 #edb/ref 17592186394112 #edb/ref 17592186045417] [17592186157423 #edb/ref 1039 "Finding the Second Derivative of a Function Given Its First Derivative" #edb/ref 17592186045417] [17592186157423 #edb/ref 1041 #edb/ref 17592186157000 #edb/ref 17592186045417] [17592186157423 #edb/ref 1042 #uuid "74c4234a-3aa1-5b6b-b68b-48e6aa2b0dfb" #edb/ref 17592186045417] [17592186157424 #edb/ref 1037 #edb/ref 17592186049044 #edb/ref 17592186045417] [17592186157424 #edb/ref 1038 #edb/ref 17592186157792 #edb/ref 17592186045417] [17592186157424 #edb/ref 1038 #edb/ref 17592186157793 #edb/ref 17592186045417] [17592186157424 #edb/ref 1038 #edb/ref 17592186235547 #edb/ref 17592186045417] [17592186157424 #edb/ref 1038 #edb/ref 17592186237927 #edb/ref 17592186045417] [17592186157424 #edb/ref 1038 #edb/ref 17592186284389 #edb/ref 17592186045417] [17592186157424 #edb/ref 1038 #edb/ref 17592186284390 #edb/ref 17592186045417] [17592186157424 #edb/ref 1038 #edb/ref 17592186284391 #edb/ref 17592186045417] [17592186157424 #edb/ref 1038 #edb/ref 17592186351196 #edb/ref 17592186045417] [17592186157424 #edb/ref 1039 "Evaluating a Hessian Determinant" #edb/ref 17592186045417] [17592186157424 #edb/ref 1041 #edb/ref 17592186157001 #edb/ref 17592186045417] [17592186157424 #edb/ref 1042 #uuid "037ff08b-3246-5eed-870b-b4951f319c96" #edb/ref 17592186045417] [17592186157425 #edb/ref 1038 #edb/ref 17592186157541 #edb/ref 17592186045417] [17592186157425 #edb/ref 1038 #edb/ref 17592186157790 #edb/ref 17592186045417] [17592186157425 #edb/ref 1038 #edb/ref 17592186351225 #edb/ref 17592186045417] [17592186157425 #edb/ref 1038 #edb/ref 17592186351229 #edb/ref 17592186045417] [17592186157425 #edb/ref 1038 #edb/ref 17592186351230 #edb/ref 17592186045417] [17592186157425 #edb/ref 1038 #edb/ref 17592186394105 #edb/ref 17592186045417] [17592186157425 #edb/ref 1039 "Finding the Second Derivative of a Function" #edb/ref 17592186045417] [17592186157425 #edb/ref 1041 #edb/ref 17592186157002 #edb/ref 17592186045417] [17592186157425 #edb/ref 1042 #uuid "ddf99849-1f2b-5c34-828c-164ad4058c92" #edb/ref 17592186045417] [17592186157481 #edb/ref 1043 #edb/ref 17592186158351 #edb/ref 17592186045417] [17592186157481 #edb/ref 1043 #edb/ref 17592186158352 #edb/ref 17592186045417] [17592186157481 #edb/ref 1043 #edb/ref 17592186158353 #edb/ref 17592186045417] [17592186157481 #edb/ref 1043 #edb/ref 17592186158354 #edb/ref 17592186045417] [17592186157481 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186157481 #edb/ref 1045 "The Second Derivative of a Multivariable Function" #edb/ref 17592186045417] [17592186157481 #edb/ref 1046 #edb/ref 17592186158351 #edb/ref 17592186045417] [17592186157481 #edb/ref 1049 #edb/ref 17592186048859 #edb/ref 17592186045417] [17592186157481 #edb/ref 1053 #uuid "980e0bea-1189-578f-9781-512b76215027" #edb/ref 17592186045417] [17592186157792 #edb/ref 1068 #edb/ref 17592186155673 #edb/ref 17592186045417] [17592186157792 #edb/ref 1069 "q-80944" #edb/ref 17592186045417] [17592186157792 #edb/ref 1071 "Given that\n$f^{′}(x, y) = \\begin{bmatrix}2xy^{3} & 3x^{2}y^{2}\\end{bmatrix}$,\nevaluate the Hessian determinant of $f(x, y)$ at the point $(1, 1)$." #edb/ref 17592186045417] [17592186157792 #edb/ref 1072 #uuid "56bfdc28-d81a-5ee4-a9f9-1fab676af72b" #edb/ref 17592186045417] [17592186158351 #edb/ref 1058 #edb/ref 17592186158352 #edb/ref 17592186045417] [17592186158351 #edb/ref 1061 45105 #edb/ref 17592186045417] [17592186158351 #edb/ref 1062 #uuid "bac39a49-196c-50bd-99ec-d3c5b74be977" #edb/ref 17592186045417] [17592186158351 #edb/ref 1063 #edb/ref 17592186158568 #edb/ref 17592186045417] [17592186158352 #edb/ref 1058 #edb/ref 17592186158354 #edb/ref 17592186045417] [17592186158352 #edb/ref 1061 45106 #edb/ref 17592186045417] [17592186158352 #edb/ref 1062 #uuid "bdf28805-f615-5f91-bade-c3cb7038cfd2" #edb/ref 17592186045417] [17592186158352 #edb/ref 1063 #edb/ref 17592186157423 #edb/ref 17592186045417] [17592186158353 #edb/ref 1061 45109 #edb/ref 17592186045417] [17592186158353 #edb/ref 1062 #uuid "e732cfd5-6c10-55ef-b698-a932a1d233c3" #edb/ref 17592186045417] [17592186158353 #edb/ref 1063 #edb/ref 17592186157424 #edb/ref 17592186045417] [17592186158354 #edb/ref 1058 #edb/ref 17592186158353 #edb/ref 17592186045417] [17592186158354 #edb/ref 1061 45116 #edb/ref 17592186045417] [17592186158354 #edb/ref 1062 #uuid "8222059e-dad9-55b4-8e1d-ac327c86df18" #edb/ref 17592186045417] [17592186158354 #edb/ref 1063 #edb/ref 17592186157425 #edb/ref 17592186045417] [17592186158568 #edb/ref 1064 "We've seen how to calculate the total derivative of a function $f: \\mathbb R^n \\to \\mathbb R.$ In this lesson, we will learn how to calculate its second derivative.\n\nFor a function $f: \\mathbb R^n \\to \\mathbb R,$ given by\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]\n$$\n\nthe total derivative of $f$ is given by the matrix\n\n$$\n[\\begin{aligned}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}} & ⋯ & \\frac{∂f}{∂{x}_{n}}\\end{aligned}]\n$$\n\nTo differentiate $f$ once more, we first need to take the transpose of the first derivative:\n\n$$\n[\\begin{aligned}\\frac{∂f}{∂{x}_{1}} \\\\ \\frac{∂f}{∂{x}_{2}} \\\\ ⋮ \\\\ \\frac{∂f}{∂{x}_{n}}\\end{aligned}]\n$$\n\nTo calculate the **second derivative** of $f,$ we simply apply the definition of the total derivative to $\\left(\\boldsymbol f'(\\mathbf x)\\right)^T.$ By doing this, we get the following $n\\times n$ matrix:\n\n$$\n[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}]\n$$\n\nNotice that this matrix is *symmetric* due to the equality of mixed partial derivatives. This becomes important later. \n\nThe matrix $\\boldsymbol{f}''(\\mathbf x)$ is sometimes called the **Hessian matrix,** and its determinant, \n\n$$\nH(\\mathbf x) = \\det\\big( \\boldsymbol{f}''(\\mathbf x) \\big)\n$$\n\nis called the **Hessian determinant**.\n\nNote that in the case of a two-variable function $f(x,y),$ the second derivative is given by\n\n$$\n[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]\n$$\n\nIn this lesson, we'll primarily focus on two-variable functions $f(x,y).$ However, we should remember that the techniques discussed here can be applied to scalar functions with an arbitrary number of variables." #edb/ref 17592186045417] [17592186158568 #edb/ref 1065 7795 #edb/ref 17592186045417] [17592186158568 #edb/ref 1066 #uuid "79cc27de-f461-55d9-ab0f-3dd5a21dd4f4" #edb/ref 17592186045417] [17592186158568 #edb/ref 1067 "Introduction" #edb/ref 17592186045417]}
