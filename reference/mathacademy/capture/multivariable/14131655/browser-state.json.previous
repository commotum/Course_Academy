i>r</mi><mrow data-mjx-texclass=\"ORD\"><mn>11</mn></mrow></msub><mo>+</mo><msub><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mn>13</mn></mrow></msub><mo>+</mo><msub><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mn>33</mn></mrow></msub><mo>=</mo><mn>1</mn><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>3</mn><mo>=</mo><mn>3.</mn></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
