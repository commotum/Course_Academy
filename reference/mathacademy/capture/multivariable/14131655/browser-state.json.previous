g=\"1em\" rowspacing=\"4pt\"><mtr><mtd><msqrt><mn>2</mn></msqrt></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>3</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
