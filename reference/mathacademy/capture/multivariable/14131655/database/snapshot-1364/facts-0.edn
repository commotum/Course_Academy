5504 #edb/ref 17592186045417] [17592186133863 #edb/ref 1038 #edb/ref 17592186415505 #edb/ref 17592186045417] [17592186133863 #edb/ref 1039 "Finding a QR Factorization of a Matrix Given a Matrix With Orthogonal Columns" #edb/ref 17592186045417] [17592186133863 #edb/ref 1041 #edb/ref 17592186133679 #edb/ref 17592186045417] [17592186133863 #edb/ref 1042 #uuid "1ed5119c-5ce8-52dc-bd57-f9439ea199e6" #edb/ref 17592186045417] [17592186133864 #edb/ref 1037 #edb/ref 17592186049811 #edb/ref 17592186045417] [17592186133864 #edb/ref 1037 #edb/ref 17592186050283 #edb/ref 17592186045417] [17592186133864 #edb/ref 1037 #edb/ref 17592186050656 #edb/ref 17592186045417] [17592186133864 #edb/ref 1038 #edb/ref 17592186134546 #edb/ref 17592186045417] [17592186133864 #edb/ref 1038 #edb/ref 17592186134548 #edb/ref 17592186045417] [17592186133864 #edb/ref 1038 #edb/ref 17592186363203 #edb/ref 17592186045417] [17592186133864 #edb/ref 1038 #edb/ref 17592186363210 #edb/ref 17592186045417] [17592186133864 #edb/ref 1038 #edb/ref 17592186364571 #edb/ref 17592186045417] [17592186133864 #edb/ref 1038 #edb/ref 17592186364578 #edb/ref 17592186045417] [17592186133864 #edb/ref 1039 "Identifying Dimensions of Factors in a QR Factorization" #edb/ref 17592186045417] [17592186133864 #edb/ref 1041 #edb/ref 17592186133680 #edb/ref 17592186045417] [17592186133864 #edb/ref 1042 #uuid "1304189f-61ac-53c5-9b09-8e365f763136" #edb/ref 17592186045417] [17592186134008 #edb/ref 1043 #edb/ref 17592186134693 #edb/ref 17592186045417] [17592186134008 #edb/ref 1043 #edb/ref 17592186134694 #edb/ref 17592186045417] [17592186134008 #edb/ref 1043 #edb/ref 17592186134732 #edb/ref 17592186045417] [17592186134008 #edb/ref 1043 #edb/ref 17592186134798 #edb/ref 17592186045417] [17592186134008 #edb/ref 1043 #edb/ref 17592186134799 #edb/ref 17592186045417] [17592186134008 #edb/ref 1043 #edb/ref 17592186134800 #edb/ref 17592186045417] [17592186134008 #edb/ref 1043 #edb/ref 17592186134801 #edb/ref 17592186045417] [17592186134008 #edb/ref 1043 #edb/ref 17592186134802 #edb/ref 17592186045417] [17592186134008 #edb/ref 1043 #edb/ref 17592186134803 #edb/ref 17592186045417] [17592186134008 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186134008 #edb/ref 1045 "QR Factorization" #edb/ref 17592186045417] [17592186134008 #edb/ref 1046 #edb/ref 17592186134693 #edb/ref 17592186045417] [17592186134008 #edb/ref 1049 #edb/ref 17592186050130 #edb/ref 17592186045417] [17592186134008 #edb/ref 1053 #uuid "268bdff9-18d6-5412-ae6e-b8444e305d46" #edb/ref 17592186045417] [17592186134324 #edb/ref 1068 #edb/ref 17592186131983 #edb/ref 17592186045417] [17592186134324 #edb/ref 1068 #edb/ref 17592186392396 #edb/ref 17592186045417] [17592186134324 #edb/ref 1069 "q-40838" #edb/ref 17592186045417] [17592186134324 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186134324 #edb/ref 1071 "$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}-1 & 3 \\\\ 1 & -3 \\\\ 2 & -3\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{aligned}]}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained from the columns of $A$ using the Gram-Schmidt process, find  the value of ${q}_{22}\\cdot {r}_{12}.$" #edb/ref 17592186045417] [17592186134324 #edb/ref 1072 #uuid "77f48d85-1f2c-59c8-b53a-85db3bc9d5a4" #edb/ref 17592186045417] [17592186134324 #edb/ref 1074 "Let ${a}_{1},{a}_{2}$ be the columns of $A.$\n\nFirst, we find an orthonormal basis of $\\text{Col}(A)=\\text{Span}{{a}_{1},{a}_{2}}$ using the Gram-Schmidt process.\n\n**Step 1**. We set ${v}_{1}={a}_{1}=[\\begin{aligned}-1 \\\\ 1 \\\\ 2\\end{aligned}].$\n\n**Step 2**. We find the vector ${v}_{2}$ orthogonal to $\\text{Span}{{v}_{1}}$ using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =[\\begin{aligned}3 \\\\ -3 \\\\ -3\\end{aligned}]-(-\\frac{12}{6})[\\begin{aligned}-1 \\\\ 1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ -3 \\\\ -3\\end{aligned}]+2[\\begin{aligned}-1 \\\\ 1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nNext, we normalize ${v}_{1}$ and ${v}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{6}}[\\begin{aligned}-1 \\\\ 1 \\\\ 2\\end{aligned}] \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{3}}[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute $R:$\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =[\\begin{aligned}-\\frac{1}{\\sqrt{6}} & \\frac{1}{\\sqrt{6}} & \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & -\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}}\\end{aligned}][\\begin{aligned}-1 & 3 \\\\ 1 & -3 \\\\ 2 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}\\sqrt{6} & -2\\sqrt{6} \\\\ 0 & \\sqrt{3}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we obtain the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}-1 & 3 \\\\ 1 & -3 \\\\ 2 & -3\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}-\\frac{1}{\\sqrt{6}} & \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{6}} & -\\frac{1}{\\sqrt{3}} \\\\ \\frac{2}{\\sqrt{6}} & \\frac{1}{\\sqrt{3}}\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}\\sqrt{6} & -2\\sqrt{6} \\\\ 0 & \\sqrt{3}\\end{aligned}]}}.\n$$\n\nFinally, ${q}_{22}\\cdot {r}_{12}=(-\\frac{1}{\\sqrt{3}})\\cdot (-2\\sqrt{6})=2\\sqrt{2}.$" #edb/ref 17592186045417] [17592186134326 #edb/ref 1068 #edb/ref 17592186131995 #edb/ref 17592186045417] [17592186134326 #edb/ref 1068 #edb/ref 17592186364159 #edb/ref 17592186045417] [17592186134326 #edb/ref 1069 "q-40845" #edb/ref 17592186045417] [17592186134326 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186134326 #edb/ref 1071 "$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}-2 & 1 \\\\ 1 & -5 \\\\ 2 & -1\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{aligned}]}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained from the columns of $A$ using the Gram-Schmidt process, find  the value of ${q}_{12}\\cdot {r}_{12}.$" #edb/ref 17592186045417] [17592186134326 #edb/ref 1072 #uuid "ba99e80b-ab29-52f3-91a8-3caa3a6f75d7" #edb/ref 17592186045417] [17592186134326 #edb/ref 1074 "Let ${a}_{1},{a}_{2}$ be the columns of $A.$\n\nFirst, we find an orthonormal basis of $\\text{Col}(A)=\\text{Span}{{a}_{1},{a}_{2}}$ using the Gram-Schmidt process.\n\n**Step 1**. We set ${v}_{1}={a}_{1}=[\\begin{aligned}-2 \\\\ 1 \\\\ 2\\end{aligned}].$\n\n**Step 2**. We We find the vector ${v}_{2}$ orthogonal to $\\text{Span}{{v}_{1}}$ using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}\\,{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =[\\begin{aligned}1 \\\\ -5 \\\\ -1\\end{aligned}]-(-\\frac{9}{9})[\\begin{aligned}-2 \\\\ 1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -5 \\\\ -1\\end{aligned}]+[\\begin{aligned}-2 \\\\ 1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ -4 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nNext, we normalize ${v}_{1}$ and ${v}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{3}[\\begin{aligned}-2 \\\\ 1 \\\\ 2\\end{aligned}] \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{3\\sqrt{2}}[\\begin{aligned}-1 \\\\ -4 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute $R:$\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =[\\begin{aligned}-\\frac{2}{3} & \\frac{1}{3} & \\frac{2}{3} \\\\ -\\frac{1}{3\\sqrt{2}} & -\\frac{4}{3\\sqrt{2}} & \\frac{1}{3\\sqrt{2}}\\end{aligned}][\\begin{aligned}-2 & 1 \\\\ 1 & -5 \\\\ 2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -3 \\\\ 0 & 3\\sqrt{2}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we obtain the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}-2 & 1 \\\\ 1 & -5 \\\\ 2 & -1\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}-\\frac{2}{3} & -\\frac{1}{3\\sqrt{2}} \\\\ \\frac{1}{3} & -\\frac{4}{3\\sqrt{2}} \\\\ \\frac{2}{3} & \\frac{1}{3\\sqrt{2}}\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}3 & -3 \\\\ 0 & 3\\sqrt{2}\\end{aligned}]}}.\n$$\n\nFinally, ${q}_{12}\\cdot {r}_{12}=(-\\frac{1}{3\\sqrt{2}})\\cdot (-3)=\\frac{1}{\\sqrt{2}}.$" #edb/ref 17592186045417] [17592186134352 #edb/ref 1068 #edb/ref 17592186132151 #edb/ref 17592186045417] [17592186134352 #edb/ref 1068 #edb/ref 17592186379823 #edb/ref 17592186045417] [17592186134352 #edb/ref 1069 "q-41415" #edb/ref 17592186045417] [17592186134352 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186134352 #edb/ref 1071 "$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}{r}_{11} & {r}_{12} & {r}_{13} \\\\ 0 & {r}_{22} & {r}_{23} \\\\ 0 & 0 & {r}_{33}\\end{aligned}]}}\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. You're given that the system of equations given below connects the columns of $Q$ and the columns of $A.$  \n\n$$\n{\\begin{aligned}{q}_{1}=\\frac{1}{2}{a}_{1} \\\\ {q}_{2}=\\frac{1}{4}{a}_{2}+2{q}_{1} \\\\ {q}_{3}=\\frac{1}{6}{a}_{3}-4{q}_{1}+{q}_{2}\\end{aligned}\n$$\n\nWhat is the value of ${r}_{12}+{r}_{22}+{r}_{23}?$" #edb/ref 17592186045417] [17592186134352 #edb/ref 1072 #uuid "772d3a4c-3877-5b96-a25a-b75eff00d425" #edb/ref 17592186045417] [17592186134352 #edb/ref 1074 "Let's rewrite the vectors ${a}_{1},{a}_{2},{a}_{3}$ as a linear combination of the vectors ${q}_{1},{q}_{2},{q}_{3}:$\n\n$$\n{\\begin{aligned}{q}_{1}=\\frac{1}{2}{a}_{1} \\\\ {q}_{2}=\\frac{1}{4}{a}_{2}+2{q}_{1} \\\\ {q}_{3}=\\frac{1}{6}{a}_{3}-4{q}_{1}+{q}_{2}\\end{aligned}\\,⟹\\,{\\begin{aligned}{a}_{1}=2{q}_{1} \\\\ {a}_{2}=-8{q}_{1}+4{q}_{2} \\\\ {a}_{3}=24{q}_{1}-6{q}_{2}+6{q}_{3}.\\end{aligned}\n$$\n\nTherefore, this system can be written in matrix form as follows:\n\n$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}2 & -8 & 24 \\\\ 0 & 4 & -6 \\\\ 0 & 0 & 6\\end{aligned}]}}\n$$\n\nTherefore, \n\n$$\n{r}_{12}+{r}_{22}+{r}_{23}=-8+4+(-6)=-10.\n$$" #edb/ref 17592186045417] [17592186134356 #edb/ref 1068 #edb/ref 17592186132175 #edb/ref 17592186045417] [17592186134356 #edb/ref 1069 "q-41419" #edb/ref 17592186045417] [17592186134356 #edb/ref 1071 "$\\begin{bmatrix}1 & 2 \\\\ -2 & 1 \\\\ 3 & 0\\end{bmatrix}^(⏞)^(A) = \\begin{bmatrix}q_{11} & q 12 \\\\ q_{21} & q_{22} \\\\ q_{31} & q_{32}\\end{bmatrix}^(⏞)^(Q)\\begin{bmatrix}r_{11} & r 12 \\\\ 0 & r_{22}\\end{bmatrix}^(⏞)^(R)$.\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns $a_{1}, a_{2}$ of $A$ are orthogonal, and that the columns $q_{1}, q_{2}$ of $Q$ were obtained by normalizing the columns of $A$, what is the value of $q_{12} \\cdot r_{12}$?" #edb/ref 17592186045417] [17592186134356 #edb/ref 1072 #uuid "fad5b7f6-f745-5d1b-8800-91f91ba131b6" #edb/ref 17592186045417] [17592186134693 #edb/ref 1058 #edb/ref 17592186134800 #edb/ref 17592186045417] [17592186134693 #edb/ref 1061 20266 #edb/ref 17592186045417] [17592186134693 #edb/ref 1062 #uuid "69e8ec76-c280-55f4-8fc9-a6277b14654a" #edb/ref 17592186045417] [17592186134693 #edb/ref 1063 #edb/ref 17592186135058 #edb/ref 17592186045417] [17592186134694 #edb/ref 1061 20267 #edb/ref 17592186045417] [17592186134694 #edb/ref 1062 #uuid "154bb446-4c57-548a-b863-0bfee2ca6f92" #edb/ref 17592186045417] [17592186134694 #edb/ref 1063 #edb/ref 17592186133798 #edb/ref 17592186045417] [17592186134732 #edb/ref 1058 #edb/ref 17592186134803 #edb/ref 17592186045417] [17592186134732 #edb/ref 1061 22120 #edb/ref 17592186045417] [17592186134732 #edb/ref 1062 #uuid "909730ba-aeca-592b-b525-e38e4f18e31a" #edb/ref 17592186045417] [17592186134732 #edb/ref 1063 #edb/ref 17592186133821 #edb/ref 17592186045417] [17592186134798 #edb/ref 1058 #edb/ref 17592186134802 #edb/ref 17592186045417] [17592186134798 #edb/ref 1061 31108 #edb/ref 17592186045417] [17592186134798 #edb/ref 1062 #uuid "4035e4b7-aa8c-56a6-be26-0855ad0ce971" #edb/ref 17592186045417] [17592186134798 #edb/ref 1063 #edb/ref 17592186133862 #edb/ref 17592186045417] [17592186134799 #edb/ref 1058 #edb/ref 17592186134694 #edb/ref 17592186045417] [17592186134799 #edb/ref 1061 31109 #edb/ref 17592186045417] [17592186134799 #edb/ref 1062 #uuid "133bd600-5eaf-5eaa-99fa-64b4c2a014a2" #edb/ref 17592186045417] [17592186134799 #edb/ref 1063 #edb/ref 17592186133863 #edb/ref 17592186045417] [17592186134800 #edb/ref 1058 #edb/ref 17592186134801 #edb/ref 17592186045417] [17592186134800 #edb/ref 1061 31119 #edb/ref 17592186045417] [17592186134800 #edb/ref 1062 #uuid "28dbf6ab-32c9-578d-b6cd-07619f45dc9d" #edb/ref 17592186045417] [17592186134800 #edb/ref 1063 #edb/ref 17592186133864 #edb/ref 17592186045417] [17592186134801 #edb/ref 1058 #edb/ref 17592186134798 #edb/ref 17592186045417] [17592186134801 #edb/ref 1061 31388 #edb/ref 17592186045417] [17592186134801 #edb/ref 1062 #uuid "eebb9689-f8b3-55e2-8167-e5f5525e382a" #edb/ref 17592186045417] [17592186134801 #edb/ref 1063 #edb/ref 17592186135097 #edb/ref 17592186045417] [17592186134802 #edb/ref 1058 #edb/ref 17592186134732 #edb/ref 17592186045417] [17592186134802 #edb/ref 1061 31389 #edb/ref 17592186045417] [17592186134802 #edb/ref 1062 #uuid "fdc0053f-e37d-51ef-835e-365ca5c6da98" #edb/ref 17592186045417] [17592186134802 #edb/ref 1063 #edb/ref 17592186135098 #edb/ref 17592186045417] [17592186134803 #edb/ref 1058 #edb/ref 17592186134799 #edb/ref 17592186045417] [17592186134803 #edb/ref 1061 31390 #edb/ref 17592186045417] [17592186134803 #edb/ref 1062 #uuid "94bcb87e-b43a-5740-aaed-1937658ca1d1" #edb/ref 17592186045417] [17592186134803 #edb/ref 1063 #edb/ref 17592186135099 #edb/ref 17592186045417] [17592186135058 #edb/ref 1064 "The **QR factorization** of an $m\\times n$ matrix $A$ with linearly independent columns is the matrix product $$\\underset{{\\large m} \\times {\\large n}}{A} = \\underset{{\\large m} \\times {\\large n}}{Q} \\times \\underset{{\\large n} \\times {\\large n}}{R},$$\n\nwhere\n\n- $Q$ is an $m \\times n$ matrix whose columns form an orthonormal basis of $\\text{Col}(A),$ and\n- $R$ is an $n \\times n$ upper triangular matrix with positive entries on its diagonal.\n\nFor example, the $3\\times 2$ matrix\n\n$$A = [\\begin{aligned}2 & -3 \\\\ -4 & 3 \\\\ 4 & 0\\end{aligned}]$$\n\nhas the QR factorization\n\n$$\\overbrace{ [\\begin{aligned}2 & -3 \\\\ -4 & 3 \\\\ 4 & 0\\end{aligned}] }^{\\Large A} = \\overbrace{ [\\begin{aligned}\\frac{1}{3} & -\\frac{2}{3} \\\\ -\\frac{2}{3} & \\frac{1}{3} \\\\ \\frac{2}{3} & \\frac{2}{3}\\end{aligned}] }^{\\Large Q} \\overbrace{ [\\begin{aligned}6 & -3 \\\\ 0 & 3\\end{aligned}] }^{\\Large R}.$$" #edb/ref 17592186045417] [17592186135058 #edb/ref 1065 3635 #edb/ref 17592186045417] [17592186135058 #edb/ref 1066 #uuid "ce4cf9b1-a257-518d-befa-0bfba1cdec60" #edb/ref 17592186045417] [17592186135058 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186135097 #edb/ref 1064 "Given the matrix $Q$ in the QR factorization of an $m\\times n$ matrix $A,$ how do we find $R?$\n\nRecall that $Q$ has orthonormal columns, so pre-multiplying both sides of $A=QR$ by $Q^T,$ we obtain\n\n$$\\begin{aligned}{Q}^{T}\\cdot A & ={Q}^{T}\\cdot QR \\\\ {Q}^{T}A & ={Q}^{T}QR.\\end{aligned}$$\n\nNow, note that since the columns of $Q$ are orthonormal we have $Q^TQ = I_n.$ Therefore,\n\n$$\\begin{aligned}{Q}^{T}A & =({Q}^{T}Q)R \\\\ {Q}^{T}A & ={I}_{n}R \\\\ R & ={Q}^{T}A.\\end{aligned}$$\n\nSo, we can find $R$ by pre-multiplying $A$ by the transpose of $Q.$" #edb/ref 17592186045417] [17592186135097 #edb/ref 1065 5017 #edb/ref 17592186045417] [17592186135097 #edb/ref 1066 #uuid "20b6ab0a-cf41-550b-9242-2bb3f84c4917" #edb/ref 17592186045417] [17592186135097 #edb/ref 1067 "Computing the Matrix R Given the Matrix Q in a QR Factorization" #edb/ref 17592186045417] [17592186135098 #edb/ref 1064 "Let's consider the QR factorization of the matrix $A$ shown below:\n\n$$\\overbrace{ [\\begin{aligned}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{aligned}] }^{\\Large A} = \\overbrace{ [\\begin{aligned}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{aligned}] }^{\\Large Q} \\overbrace{ [\\begin{aligned}{r}_{11} & {r}_{12} & {r}_{13} \\\\ 0 & {r}_{22} & {r}_{23} \\\\ 0 & 0 & {r}_{33}\\end{aligned}] }^{\\Large R}$$\n\nSuppose also that we are given the following system of equations that connects the columns of $Q$ and the columns of $A{:}$\n\n$${\\begin{aligned}{q}_{1}=\\frac{1}{2}{a}_{1} \\\\ {q}_{2}=\\frac{1}{3}{a}_{2}+3{q}_{1} \\\\ {q}_{3}=\\frac{1}{4}{a}_{3}-2{q}_{1}+{q}_{2}\\end{aligned}$$\n\nHow do we find $R?$ First, let's rewrite the vectors $\\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3$ as a linear combination of the vectors $\\mathbf{q}_1, \\mathbf{q}_2, \\mathbf{q}_3 \\mathbin{:}$ $${\\begin{aligned}{q}_{1}=\\frac{1}{2}{a}_{1} \\\\ {q}_{2}=\\frac{1}{3}{a}_{2}+3{q}_{1} \\\\ {q}_{3}=\\frac{1}{4}{a}_{3}-2{q}_{1}+{q}_{2}\\end{aligned} \\qquad\\Longrightarrow\\qquad {\\begin{aligned}{a}_{1}=2{q}_{1} \\\\ {a}_{2}=-9{q}_{1}+3{q}_{2} \\\\ {a}_{3}=8{q}_{1}-4{q}_{2}+4{q}_{3}.\\end{aligned}$$\n\nIn this new system, the coefficients of $\\mathbf{q}_1$ correspond to the first-row entries of $R,$ the coefficients of $\\mathbf{q}_2$ correspond to the second-row entries of $R,$ and the coefficients of $\\mathbf{q}_3$ correspond to the third-row entries of $R.$ Therefore,\n\n$$\\overbrace{ [\\begin{aligned}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{aligned}] }^{\\Large A} = \\overbrace{ [\\begin{aligned}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{aligned}] }^{\\Large Q} \\overbrace{ [\\begin{aligned}2 & -9 & 8 \\\\ 0 & 3 & -4 \\\\ 0 & 0 & 4\\end{aligned}] }^{\\Large R}.$$\n\nTo see why this is, we can take the transpose of both sides of $A=QR{:}$ $$\\begin{aligned}A & =QR \\\\ {A}^{T} & =(QR)^{T} \\\\ {A}^{T} & ={R}^{T}{Q}^{T} \\\\ \\overset{{A}^{T}}{\\overset{⏞}{[\\begin{aligned}-\\,\\,\\,\\, & {a}_{1} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {a}_{2} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {a}_{3} & \\,\\,\\,\\,-\\end{aligned}]}} & =\\overset{{R}^{T}}{\\overset{⏞}{[\\begin{aligned}2 & 0 & 0 \\\\ -9 & 3 & 0 \\\\ 8 & -4 & 4\\end{aligned}]}}\\overset{{Q}^{T}}{\\overset{⏞}{[\\begin{aligned}-\\,\\,\\,\\, & {q}_{1} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {q}_{2} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {q}_{3} & \\,\\,\\,\\,-\\end{aligned}]}}\\end{aligned}$$\n\nIf we were to expand this matrix product, we would obtain our system of equations." #edb/ref 17592186045417] [17592186135098 #edb/ref 1065 5018 #edb/ref 17592186045417] [17592186135098 #edb/ref 1066 #uuid "9a6d9a3e-33d4-52e8-b8b0-98cd20590dd6" #edb/ref 17592186045417] [17592186135098 #edb/ref 1067 "Interpreting Relations Between Two Bases as Matrix Multiplication" #edb/ref 17592186045417] [17592186135099 #edb/ref 1064 "Let's now go through the QR factorization algorithm to find the factorization of the matrix\n\n$$A = [\\begin{aligned}2 & 1 \\\\ 4 & 3 \\\\ -4 & -1\\end{aligned}].$$\n\n**Step 1**. Orthogonalize the columns of $A$ to get the columns of $Q.$ Using the Gram-Schmidt process, we obtain\n\n$$\\begin{aligned}{q}_{1}=\\frac{1}{3}[\\begin{aligned}1 \\\\ 2 \\\\ -2\\end{aligned}],\\,{q}_{2}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}].\\end{aligned}$$\n\n**Step 2**. Compute $R=Q^TA.$ We get\n\n$$\\begin{aligned}R=[\\begin{aligned}6 & 3 \\\\ 0 & \\sqrt{2}\\end{aligned}].\\end{aligned}$$\n\nTherefore, the QR factorization of $A$ is\n\n$$\\overbrace{ [\\begin{aligned}2 & 1 \\\\ 4 & 3 \\\\ -4 & -1\\end{aligned}] }^{\\Large A} = \\overbrace{ [\\begin{aligned}\\frac{1}{3} & 0 \\\\ \\frac{2}{3} & \\frac{1}{\\sqrt{2}} \\\\ -\\frac{2}{3} & \\frac{1}{\\sqrt{2}}\\end{aligned}] }^{\\Large Q} \\overbrace{ [\\begin{aligned}6 & 3 \\\\ 0 & \\sqrt{2}\\end{aligned}] }^{\\Large R}.$$" #edb/ref 17592186045417] [17592186135099 #edb/ref 1065 5019 #edb/ref 17592186045417] [17592186135099 #edb/ref 1066 #uuid "c2f59e79-8a0c-543b-8af0-381e95a18a8a" #edb/ref 17592186045417] [17592186135099 #edb/ref 1067 "The QR Factorization Algorithm" #edb/ref 17592186045417] [17592186363203 #edb/ref 1068 #edb/ref 17592186363204 #edb/ref 17592186045417] [17592186363203 #edb/ref 1069 "q-140896" #edb/ref 17592186045417] [17592186363203 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186363203 #edb/ref 1071 "Given that $A=QR$ is a QR factorization of a $5\\times 4$ matrix $A$ with linearly independent columns, which of the following statements are true?\n\n- The columns of $Q$ are orthogonal\n- $Q$ is a $5\\times 5$ matrix\n- $R$ is a  square  matrix" #edb/ref 17592186045417] [17592186363203 #edb/ref 1072 #uuid "4ea55d3c-3433-59ef-97d4-45fcd98ab0e0" #edb/ref 17592186045417] [17592186363203 #edb/ref 1074 "Recall that if $A=QR$ is a  QR factorization of an $m\\times n$ matrix $A,$ then\n\n$$\n{A}_{m\\times n}={Q}_{m\\times n}\\times {R}_{n\\times n},\n$$\n\nwhere \n\n- $Q$ is an $m\\times n$ matrix whose columns form an orthonormal basis of $\\text{Col}(A)$\n\n- $R$ is an $n\\times n$ upper triangular matrix\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, since the columns of $Q$ form an orthonormal basis, they are orthogonal.\n\n- Statement II is false. $Q$ should be a $5\\times 4$  matrix.\n\n- Statement III is true. Indeed, $R$ must be a $4\\times 4$ upper triangular matrix.\n\nTherefore, the correct answer is \"I and III only.\"" #edb/ref 17592186045417] [17592186363204 #edb/ref 1075 #edb/ref 17592186363205 #edb/ref 17592186045417] [17592186363204 #edb/ref 1075 #edb/ref 17592186363206 #edb/ref 17592186045417] [17592186363204 #edb/ref 1075 #edb/ref 17592186363207 #edb/ref 17592186045417] [17592186363204 #edb/ref 1075 #edb/ref 17592186363208 #edb/ref 17592186045417] [17592186363204 #edb/ref 1075 #edb/ref 17592186363209 #edb/ref 17592186045417] [17592186363204 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186363204 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186363204 #edb/ref 1078 #edb/ref 17592186363206 #edb/ref 17592186045417] [17592186363204 #edb/ref 1079 #uuid "58b0761b-7cd9-5618-bf38-706cbf7f45cb" #edb/ref 17592186045417] [17592186363205 #edb/ref 1080 "II and III only" #edb/ref 17592186045417] [17592186363205 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186363205 #edb/ref 1083 #uuid "22a267aa-19c7-5a4e-b20a-596b46361ff0" #edb/ref 17592186045417] [17592186363206 #edb/ref 1080 "I and III only" #edb/ref 17592186045417] [17592186363206 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186363206 #edb/ref 1083 #uuid "9214fe6d-7921-5395-b98b-78b02b3eb40e" #edb/ref 17592186045417] [17592186363207 #edb/ref 1080 "I only" #edb/ref 17592186045417] [17592186363207 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186363207 #edb/ref 1083 #uuid "acb9ea7d-cb59-5ac8-99fb-485c266d2c73" #edb/ref 17592186045417] [17592186363208 #edb/ref 1080 "I and II only" #edb/ref 17592186045417] [17592186363208 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186363208 #edb/ref 1083 #uuid "12ee20c8-1283-5d6e-86b4-f79be9b91d2d" #edb/ref 17592186045417] [17592186363209 #edb/ref 1080 "II only" #edb/ref 17592186045417] [17592186363209 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186363209 #edb/ref 1083 #uuid "e288ffeb-c37d-5dfb-8914-81566c61db71" #edb/ref 17592186045417] [17592186363217 #edb/ref 1068 #edb/ref 17592186363218 #edb/ref 17592186045417] [17592186363217 #edb/ref 1069 "q-140900" #edb/ref 17592186045417] [17592186363217 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186363217 #edb/ref 1071 "$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}{r}_{11} & {r}_{12} & {r}_{13} \\\\ 0 & {r}_{22} & {r}_{23} \\\\ 0 & 0 & {r}_{33}\\end{aligned}]}}\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. You're given that the system of equations given below connects the columns of $Q$ and the columns of $A.$  \n\n$$\n{\\begin{aligned}{q}_{1}=\\frac{1}{4}{a}_{1} \\\\ {q}_{2}=\\frac{1}{2}{a}_{2}+{q}_{1} \\\\ {q}_{3}=\\frac{1}{3}{a}_{3}+2{q}_{1}-{q}_{2}\\end{aligned}\n$$\n\nWhat is the value of ${r}_{13}+{r}_{22}+{r}_{23}?$" #edb/ref 17592186045417] [17592186363217 #edb/ref 1072 #uuid "9d67166f-3bff-552c-8a7c-19cfbf3fd7f3" #edb/ref 17592186045417] [17592186363217 #edb/ref 1074 "Let's rewrite the vectors ${a}_{1},{a}_{2},{a}_{3}$ as a linear combination of the vectors ${q}_{1},{q}_{2},{q}_{3}:$\n\n$$\n{\\begin{aligned}{q}_{1}=\\frac{1}{4}{a}_{1} \\\\ {q}_{2}=\\frac{1}{2}{a}_{2}+{q}_{1} \\\\ {q}_{3}=\\frac{1}{3}{a}_{3}+2{q}_{1}-{q}_{2}\\end{aligned}\\,⟹\\,{\\begin{aligned}{a}_{1}=4{q}_{1} \\\\ {a}_{2}=-2{q}_{1}+2{q}_{2} \\\\ {a}_{3}=-6{q}_{1}+3{q}_{2}+3{q}_{3}.\\end{aligned}\n$$\n\nTherefore, this system can be written in matrix form as follows:\n\n$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}4 & -2 & -6 \\\\ 0 & 2 & 3 \\\\ 0 & 0 & 3\\end{aligned}]}}\n$$\n\nTherefore, \n\n$$\n{r}_{13}+{r}_{22}+{r}_{23}=-6+2+3=-1.\n$$" #edb/ref 17592186045417] [17592186363218 #edb/ref 1075 #edb/ref 17592186363219 #edb/ref 17592186045417] [17592186363218 #edb/ref 1075 #edb/ref 17592186363220 #edb/ref 17592186045417] [17592186363218 #edb/ref 1075 #edb/ref 17592186363221 #edb/ref 17592186045417] [17592186363218 #edb/ref 1075 #edb/ref 17592186363222 #edb/ref 17592186045417] [17592186363218 #edb/ref 1075 #edb/ref 17592186363223 #edb/ref 17592186045417] [17592186363218 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186363218 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186363218 #edb/ref 1078 #edb/ref 17592186363221 #edb/ref 17592186045417] [17592186363218 #edb/ref 1079 #uuid "4547ff35-0e1d-5d8f-b076-6bc2886e7c0f" #edb/ref 17592186045417] [17592186363219 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186363219 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186363219 #edb/ref 1083 #uuid "ce45e94d-baf5-5098-ac2d-d794c6429bb9" #edb/ref 17592186045417] [17592186363220 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186363220 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186363220 #edb/ref 1083 #uuid "448670c4-632d-5013-a236-b59dc6cbcc16" #edb/ref 17592186045417] [17592186363221 #edb/ref 1080 "-1" #edb/ref 17592186045417] [17592186363221 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186363221 #edb/ref 1083 #uuid "cb4bc888-dff7-59f0-a773-62a45b1023fd" #edb/ref 17592186045417] [17592186363222 #edb/ref 1080 "5" #edb/ref 17592186045417] [17592186363222 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186363222 #edb/ref 1083 #uuid "ccaa65a2-e9e6-5cda-b206-709db184a16e" #edb/ref 17592186045417] [17592186363223 #edb/ref 1080 "-2" #edb/ref 17592186045417] [17592186363223 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186363223 #edb/ref 1083 #uuid "c20f970a-bd81-5297-9fcb-5e40ddbce489" #edb/ref 17592186045417] [17592186363224 #edb/ref 1068 #edb/ref 17592186363225 #edb/ref 17592186045417] [17592186363224 #edb/ref 1069 "q-140902" #edb/ref 17592186045417] [17592186363224 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186363224 #edb/ref 1071 "$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}1 & 2 \\\\ 1 & 0 \\\\ 1 & -2\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{aligned}]}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${a}_{1},{a}_{2}$ of $A$ are orthogonal, and that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained by normalizing the columns of $A,$ what is the value of ${q}_{12}\\cdot {r}_{22}?$" #edb/ref 17592186045417] [17592186363224 #edb/ref 1072 #uuid "836a6cda-4c5e-5dc1-9726-f5d184348fd8" #edb/ref 17592186045417] [17592186363224 #edb/ref 1074 "Since the columns of $A$ are already orthogonal, to construct an orthogonal matrix $Q,$ we simply normalize ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{a}_{1}}{‖{a}_{1}‖}=\\frac{1}{\\sqrt{3}}[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ {q}_{2} & =\\frac{{a}_{2}}{‖{a}_{2}‖}=\\frac{1}{2\\sqrt{2}}[\\begin{aligned}2 \\\\ 0 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nNow, pre-multiplying both sides of $A=QR$ by ${Q}^{T},$ we obtain\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}}\\end{aligned