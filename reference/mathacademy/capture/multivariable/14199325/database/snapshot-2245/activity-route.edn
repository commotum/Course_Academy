#{[{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186516893} :activity/id #uuid "6ade1ba4-a844-5f17-ae51-ad9fb452b45a" :activity/scope {:db/id #edb/ref 17592186050814 :topic/id #uuid "68ad7925-6faa-546c-899e-dac0bbfac1ef" :topic/math-academy-id 6722} :activity/steps [{:db/id #edb/ref 17592186516884 :step/content {:db/id #edb/ref 17592186516819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00db171e-86f4-578f-baa9-eeb4a13a294d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=0}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{12})" :db/id #edb/ref 17592186516113} {:answer/id #uuid "4c7a31b2-8edf-5725-b08a-4ca04a19f52d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{6})" :db/id #edb/ref 17592186516267} {:answer/id #uuid "8cc33023-61a9-57c1-b84d-42d2debd3175" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{12})" :db/id #edb/ref 17592186516405} {:answer/id #uuid "8eef8445-476b-5036-b260-03f7d53b7715" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{6})" :db/id #edb/ref 17592186516411}] :answer-field/correct {:db/id #edb/ref 17592186516411} :answer-field/id #uuid "51585168-5999-52ac-a302-915344f4951e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186516681}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "784a3ecb-16b0-5fa6-bed2-991dfa6c8b60" :question/math-academy-id "q-344269" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+3y=f(x)\n$$\n\non $[-6,6]$, where $f$ is $12$-periodic and odd. Which Fourier-series form is appropriate for a particular solution ${y}_{p}?$\n\n$\\,$\n${y}_{p}(x)=$\n{{field-1}}" :question/worked-solution "Because $f$ is $12$-periodic on $[-6,6]$, we have $L=6$, so Fourier series on this interval use the basis \n\n$$\ncos\\,(\\frac{n\\pi x}{6})\\,\\text{and}\\,sin\\,(\\frac{n\\pi x}{6}).\n$$\n\nNext, since $f$ is odd, its Fourier series contains only sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function.\n\nTherefore, the appropriate form for ${y}_{p}$ is a sine series:\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{6})\n$$"} :step/id #uuid "2b173ba2-96ab-523d-bf33-e069587b7119" :step/next {:db/id #edb/ref 17592186516930}} {:db/id #edb/ref 17592186516891 :step/content {:db/id #edb/ref 17592186372860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe92f4fa-7615-54d2-a819-127fb1a673f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{10})" :db/id #edb/ref 17592186372862} {:answer/id #uuid "3b55cc73-4e32-591c-bee5-a9d934861abd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=0}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{10})" :db/id #edb/ref 17592186372863} {:answer/id #uuid "9f4b6aad-9479-5fcd-b841-a17705d991a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{5})" :db/id #edb/ref 17592186372864} {:answer/id #uuid "b3faa44a-d5ae-5692-901c-7fe9f2979668" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{5})" :db/id #edb/ref 17592186372865}] :answer-field/correct {:db/id #edb/ref 17592186372864} :answer-field/id #uuid "f04ef90f-3003-58fb-a7fe-77d398fbdee2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186372861}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6f67e1f7-be25-5035-9c23-854e909c6a11" :question/math-academy-id "q-344268" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+\\frac{1}{2}\\,y=f(x)\n$$\n\non $[-5,5]$, where $f$ is $10$-periodic and odd. Which Fourier-series form is appropriate for a particular solution ${y}_{p}?$\n\n$\\,$\n${y}_{p}(x)=$\n{{field-1}}" :question/worked-solution "Because $f$ is $10$-periodic on $[-5,5]$, we have $L=5$, so Fourier series on this interval use the basis \n\n$$\ncos\\,(\\frac{n\\pi x}{5})\\,\\text{and}\\,sin\\,(\\frac{n\\pi x}{5}).\n$$\n\nNext, since $f$ is odd, its Fourier series contains only sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function.\n\nTherefore, the appropriate form for ${y}_{p}$ is a sine series:\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{5})\n$$"} :step/id #uuid "37c6243c-06ec-5738-995f-c4f49f7b7696" :step/next {:db/id #edb/ref 17592186516884}} {:db/id #edb/ref 17592186516893 :step/content {:db/id #edb/ref 17592186455474 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e845a04-8cdb-5e9e-84f7-e0e83c51ac51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})" :db/id #edb/ref 17592186455073} {:answer/id #uuid "e5794dc8-ca22-54fc-a518-c6c715487e09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{6})" :db/id #edb/ref 17592186455300} {:answer/id #uuid "e6a093ac-9f78-5544-b061-1933a24a44b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=0}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{6})" :db/id #edb/ref 17592186455305} {:answer/id #uuid "f895f8f8-5c23-5c95-9255-aeebe933932a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})" :db/id #edb/ref 17592186455330}] :answer-field/correct {:db/id #edb/ref 17592186455330} :answer-field/id #uuid "8751bc0c-cc97-539c-aaed-dee2b1d55e70" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186455383}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "86bb2466-6029-5b95-bd68-985d08738376" :question/math-academy-id "q-344258" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+4y=f(x)\n$$\n\non $[-3,3]$, where $f$ is $6$-periodic and odd. Which Fourier-series form is appropriate for a particular solution ${y}_{p}?$\n\n$\\,$\n${y}_{p}(x)=$\n{{field-1}}" :question/worked-solution "Because $f$ is $6$-periodic on $[-3,3]$, we have $L=3$, so Fourier series on this interval use the basis \n\n$$\ncos\\,(\\frac{n\\pi x}{3})\\,\\text{and}\\,sin\\,(\\frac{n\\pi x}{3}).\n$$\n\nNext, since $f$ is odd, its Fourier series contains only sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function.\n\nTherefore, the appropriate form for ${y}_{p}$ is a sine series:\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})\n$$"} :step/id #uuid "3aab5294-b9a1-5c24-942b-52709d4fcd37" :step/next {:db/id #edb/ref 17592186516952}} {:db/id #edb/ref 17592186516930 :step/content {:db/id #edb/ref 17592186385296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "404cefb8-00ef-5c98-acc0-e0915a58fc3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{\\operatorname{sin}⁡(\\sqrt{5})}\\operatorname{sin}⁡(\\sqrt{5}x)" :db/id #edb/ref 17592186385298} {:answer/id #uuid "42cbf34b-8851-50bb-874f-4cdbdc1efcba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{\\operatorname{cos}⁡(\\sqrt{5})}\\operatorname{cos}⁡(\\sqrt{5}x)" :db/id #edb/ref 17592186385299} {:answer/id #uuid "439c3659-0dc0-5024-9dc2-ea98ebfc52bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{\\operatorname{cos}⁡(2)}\\operatorname{cos}⁡(2\\pi x)" :db/id #edb/ref 17592186385300} {:answer/id #uuid "81883b38-c06e-5fce-ac3e-1c8abeb4e865" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{\\operatorname{sin}⁡(2)}\\operatorname{sin}⁡(2\\pi x)" :db/id #edb/ref 17592186385301}] :answer-field/correct {:db/id #edb/ref 17592186385298} :answer-field/id #uuid "18f1e980-970f-59b0-bcb4-049b47db24a1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186385297}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a82ffc50-94c7-5ef3-8250-c59c884b5c7d" :question/math-academy-id "q-344315" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+5y=f(x),\\,y(0)=0,\\,y(1)=4\n$$\n\nwhere $f(x)$ is $1$-periodic and odd. Select the missing part in the solution of the BVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(0)=0$ and ${y}_{p}(1)=0.$*\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(2n\\pi x).\n$$" :question/worked-solution "We write the solution as $y={y}_{c}+{y}_{p}$, where ${y}_{c}$ solves the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, solve the homogeneous equation ${y}^{″}+5y=0.$ Its general solution is\n\n$$\n{y}_{c}(x)=A\\operatorname{cos}⁡(\\sqrt{5}x)+B\\operatorname{sin}⁡(\\sqrt{5}x).\n$$\n\nNow, we use the hint. Since ${y}_{p}(0)=0$ and ${y}_{p}(1)=0$, we have\n\n$$\ny(0)={y}_{c}(0)\\,\\text{and}\\,y(1)={y}_{c}(1).\n$$\n\nNext, we apply the boundary conditions.\n\n- Use $y(0)=0:$\n\n$$\n\\begin{aligned}y(0) & =A\\operatorname{cos}⁡(0)+B\\operatorname{sin}⁡(0)+{y}_{p}(0) \\\\ 0 & =A(1)+B(0)+0 \\\\ A & =0\\end{aligned}\n$$\n\nSo, ${y}_{c}(x)=B\\operatorname{sin}⁡(\\sqrt{5}x).$\n\n- Use $y(1)=4$ with $A=0:$\n\n$$\n\\begin{aligned}y(1) & =B\\operatorname{sin}⁡(\\sqrt{5})+{y}_{p}(1) \\\\ 4 & =B\\operatorname{sin}⁡(\\sqrt{5})+0 \\\\ B & =\\frac{4}{\\operatorname{sin}⁡(\\sqrt{5})}\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼\\frac{4}{\\operatorname{sin}⁡(\\sqrt{5})}\\operatorname{sin}⁡(\\sqrt{5}x)+{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(2n\\pi x).\n$$"} :step/id #uuid "8362d1b1-2815-579d-a7ce-8b445abb4156"} {:db/id #edb/ref 17592186516952 :step/content {:db/id #edb/ref 17592186391878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fea5dfa8-e050-5b5b-9d2b-31fc8471548b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡(n\\pi x)" :db/id #edb/ref 17592186391880} {:answer/id #uuid "a5716cb8-c83c-5c12-b35c-5df47e0ff3f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})" :db/id #edb/ref 17592186391881} {:answer/id #uuid "6bf8079b-959d-5ffb-a495-b8fabbba9188" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=0}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})" :db/id #edb/ref 17592186391882} {:answer/id #uuid "21391e85-1c6a-5d27-8ba8-dcfd917d5f26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(n\\pi x)" :db/id #edb/ref 17592186391883}] :answer-field/correct {:db/id #edb/ref 17592186391883} :answer-field/id #uuid "145ecaa5-9e5b-51d0-b614-a47f6e8aa702" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186391879}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7564f089-ba0c-513c-9df8-4c3c797d04cb" :question/math-academy-id "q-344266" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+2y=f(x)\n$$\n\non $[-1,1]$, where $f$ is $2$-periodic and odd. Which Fourier-series form is appropriate for a particular solution ${y}_{p}?$\n\n$\\,$\n${y}_{p}(x)=$\n{{field-1}}" :question/worked-solution "Because $f$ is $2$-periodic on $[-1,1]$, we have $L=1$, so Fourier series on this interval use the basis \n\n$$\ncos\\,(\\frac{n\\pi x}{1})\\,\\text{and}\\,sin\\,(\\frac{n\\pi x}{1}).\n$$\n\nNext, since $f$ is odd, its Fourier series contains only sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function.\n\nTherefore, the appropriate form for ${y}_{p}$ is a sine series:\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(n\\pi x)\n$$"} :step/id #uuid "b678c6bd-3133-5ec1-bed3-d0d9d93c8e3c" :step/next {:db/id #edb/ref 17592186516891}}] :activity/title "Solving BVPs Using Fourier Series" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516099}]}
