              "option": "1",
              "dom_id": null,
              "type": "text",
              "value": "sometimes true",
              "html": "sometimes true"
            },
            {
              "option": "2",
              "dom_id": null,
              "type": "text",
              "value": "always false",
              "html": "always false"
            }
          ],
