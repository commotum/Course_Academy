              "option": "2",
              "dom_id": null,
              "type": "text",
              "value": "sometimes true",
              "html": "sometimes true"
            },
            {
              "option": "3",
              "dom_id": null,
              "type": "text",
              "value": "sometimes false",
              "html": "sometimes false"
            }
          ],
