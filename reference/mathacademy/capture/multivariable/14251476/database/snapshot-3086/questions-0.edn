n/answer-fields [{:answer-field/choices [{:answer/id #uuid "873b7773-cb1d-527a-b022-ed54cf3e3f1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186059125} {:answer/id #uuid "9ae9d5d6-daa8-5722-9136-2422cd282ccd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186059126} {:answer/id #uuid "9c352a3f-2e87-52bf-887f-52edeaef88d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186059127} {:answer/id #uuid "cd044629-cd30-5538-821e-7cd06ff5d754" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186059128} {:answer/id #uuid "deafae4c-755b-5781-ad26-01dbdbafeadf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186059129}] :answer-field/id #uuid "c85480f9-22a3-59ba-bab4-92610e93ed51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186059124}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50077fd5-22af-5609-98e0-9c3d33888ef9" :question/math-academy-id "q-82070" :question/problem "Which of the following statements are true?\n\n1. **If** $5$ is a prime number, **then** $4$ is a composite number.\n2. **If** $4$ is a prime number, **then** $5$ is a composite number.\n3. **If** $5$ is a prime number, **then** $4$ is a prime number."}] [{:db/id #edb/ref 17592186572111 :knowledge-point/_questions [{:db/id #edb/ref 17592186059701 :knowledge-point/id #uuid "64a3922f-7e74-562f-9bb9-c4a41e912ce7" :knowledge-point/title "Identifying True Conditional Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03600340-b193-500c-8a4e-70becf861891" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186571544} {:answer/id #uuid "07bbe8bf-e4b6-5451-9305-d64c222d6989" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186571553} {:answer/id #uuid "750f8a1f-0e3e-56d1-aacd-4c87aae8356a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186571739} {:answer/id #uuid "9b8f287e-28c9-57fe-9ef1-b0cecd8c9262" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186571808} {:answer/id #uuid "b2fbb417-cc59-5ba7-a1fd-86459f8f2416" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186571852}] :answer-field/correct {:answer/id #uuid "03600340-b193-500c-8a4e-70becf861891" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186571544} :answer-field/id #uuid "20946566-36d6-5e03-9e40-89a2c52d5bc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186571994}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "16c76fe3-0ab1-5993-82c9-e343dae9360d" :question/math-academy-id "q-82072" :question/problem "Which of the following statements are true?\n\nI. **If** $2\\le 5,$ **then** $3\\le 1.$\n\nII. **If** $5\\le 2,$ **then** $1\\le 3.$\n\nIII. **If** $1\\le 3,$ **then** $5\\le 2.$" :question/worked-solution "An implication $A⇒B$ is true *unless* $A$ is true and $B$ is false. In other words, the implication is true unless the \"promise\" is broken.\n\n- Statement I is false. The antecedent $2\\le 5$ is true, and the consequent $3\\le 1$ is false. So the promise is broken, and the statement is false.\n\n- Statement II is true. The antecedent $5\\le 2$ is false, so the promise does not apply. Regardless of the consequent, the promise is *not* broken, and the statement is true.\n\n- Statement III is false. The antecedent $1\\le 3$ is true, and the consequent $5\\le 2$ is false. So the promise is broken, and the statement is false.\n\nTherefore, the correct answer is \"II only.\""}]}
