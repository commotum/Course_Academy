ref 17592186045417] [17592186359259 #edb/ref 1083 #uuid "add72146-efe2-5a0e-abaa-a3a2463c3158" #edb/ref 17592186045417] [17592186359374 #edb/ref 1080 "{r}^{2}\\operatorname{sin}⁡(2\\theta )" #edb/ref 17592186045417] [17592186359374 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186359374 #edb/ref 1083 #uuid "ba7b642c-5011-5fe6-b8b3-8ba15e13f44b" #edb/ref 17592186045417] [17592186359430 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186359430 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186359430 #edb/ref 1083 #uuid "bfc682ef-5b2d-5c3c-8130-e2f1ce1ee474" #edb/ref 17592186045417] [17592186359449 #edb/ref 1080 "{r}^{2}{sin}^{2}⁡\\theta " #edb/ref 17592186045417] [17592186359449 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186359449 #edb/ref 1083 #uuid "c17a4d57-ab7f-5cad-9c18-15918d10a4db" #edb/ref 17592186045417] [17592186359755 #edb/ref 1080 "{r}^{2}\\operatorname{sin}⁡(2\\theta )+r{z}^{2}\\operatorname{cos}⁡\\theta " #edb/ref 17592186045417] [17592186359755 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186359755 #edb/ref 1083 #uuid "e28e7362-9db3-53ed-accd-873077451494" #edb/ref 17592186045417] [17592186359761 #edb/ref 1080 "r{sin}^{2}⁡\\theta " #edb/ref 17592186045417] [17592186359761 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186359761 #edb/ref 1083 #uuid "e32325f6-ab86-53be-a9ca-0e5883831318" #edb/ref 17592186045417] [17592186359883 #edb/ref 1080 "r\\operatorname{sin}⁡\\theta +{z}^{2}" #edb/ref 17592186045417] [17592186359883 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186359883 #edb/ref 1083 #uuid "ef656522-486e-50e0-b47a-5e62e587789f" #edb/ref 17592186045417] [17592186359975 #edb/ref 1080 "r{cos}^{2}⁡\\theta " #edb/ref 17592186045417] [17592186359975 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186359975 #edb/ref 1083 #uuid "fb9162b2-a7fc-5e49-88a2-4b87f9188d83" #edb/ref 17592186045417] [17592186359997 #edb/ref 1080 "{r}^{2}\\operatorname{sin}⁡(2\\theta )" #edb/ref 17592186045417] [17592186359997 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186359997 #edb/ref 1083 #uuid "ff52e99a-a36a-570b-927e-6775bb16f2f8" #edb/ref 17592186045417] [17592186360139 #edb/ref 1075 #edb/ref 17592186358726 #edb/ref 17592186045417] [17592186360139 #edb/ref 1075 #edb/ref 17592186359374 #edb/ref 17592186045417] [17592186360139 #edb/ref 1075 #edb/ref 17592186359430 #edb/ref 17592186045417] [17592186360139 #edb/ref 1075 #edb/ref 17592186359761 #edb/ref 17592186045417] [17592186360139 #edb/ref 1075 #edb/ref 17592186359975 #edb/ref 17592186045417] [17592186360139 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186360139 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186360139 #edb/ref 1078 #edb/ref 17592186359430 #edb/ref 17592186045417] [17592186360139 #edb/ref 1079 #uuid "5ebf0a96-067c-5319-889e-a652fa3fcdea" #edb/ref 17592186045417] [17592186360203 #edb/ref 1075 #edb/ref 17592186358738 #edb/ref 17592186045417] [17592186360203 #edb/ref 1075 #edb/ref 17592186358845 #edb/ref 17592186045417] [17592186360203 #edb/ref 1075 #edb/ref 17592186358879 #edb/ref 17592186045417] [17592186360203 #edb/ref 1075 #edb/ref 17592186359010 #edb/ref 17592186045417] [17592186360203 #edb/ref 1075 #edb/ref 17592186359162 #edb/ref 17592186045417] [17592186360203 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186360203 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186360203 #edb/ref 1078 #edb/ref 17592186359010 #edb/ref 17592186045417] [17592186360203 #edb/ref 1079 #uuid "7d76e27a-bad6-5130-9b46-77d20a6d4839" #edb/ref 17592186045417] [17592186360304 #edb/ref 1075 #edb/ref 17592186358448 #edb/ref 17592186045417] [17592186360304 #edb/ref 1075 #edb/ref 17592186358649 #edb/ref 17592186045417] [17592186360304 #edb/ref 1075 #edb/ref 17592186359259 #edb/ref 17592186045417] [17592186360304 #edb/ref 1075 #edb/ref 17592186359755 #edb/ref 17592186045417] [17592186360304 #edb/ref 1075 #edb/ref 17592186359883 #edb/ref 17592186045417] [17592186360304 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186360304 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186360304 #edb/ref 1078 #edb/ref 17592186359259 #edb/ref 17592186045417] [17592186360304 #edb/ref 1079 #uuid "aee644e2-ce96-5e60-b711-61139e62f74c" #edb/ref 17592186045417] [17592186360352 #edb/ref 1075 #edb/ref 17592186358086 #edb/ref 17592186045417] [17592186360352 #edb/ref 1075 #edb/ref 17592186358112 #edb/ref 17592186045417] [17592186360352 #edb/ref 1075 #edb/ref 17592186358999 #edb/ref 17592186045417] [17592186360352 #edb/ref 1075 #edb/ref 17592186359449 #edb/ref 17592186045417] [17592186360352 #edb/ref 1075 #edb/ref 17592186359997 #edb/ref 17592186045417] [17592186360352 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186360352 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186360352 #edb/ref 1078 #edb/ref 17592186359997 #edb/ref 17592186045417] [17592186360352 #edb/ref 1079 #uuid "d14ca8c8-8191-546e-952e-035f83d5d2de" #edb/ref 17592186045417] [17592186360535 #edb/ref 1068 #edb/ref 17592186360203 #edb/ref 17592186045417] [17592186360535 #edb/ref 1069 "q-94999" #edb/ref 17592186045417] [17592186360535 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360535 #edb/ref 1071 "Given that $h(x,y)={x}^{2}y,$ find $\\frac{∂h}{∂r},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." #edb/ref 17592186045417] [17592186360535 #edb/ref 1072 #uuid "4970bf30-0b07-5dcd-b3de-478f21daf6db" #edb/ref 17592186045417] [17592186360535 #edb/ref 1074 "Applying the multivariable chain rule for the function $h(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r} & =\\frac{∂h}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂h}{∂y}\\cdot \\frac{∂y}{∂r} \\\\  & =\\frac{∂h}{∂x}\\operatorname{cos}⁡\\theta +\\frac{∂g}{∂y}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x}=2xy,\\,\\frac{∂h}{∂y}={x}^{2}\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =2{r}^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta , \\\\ \\frac{∂h}{∂y} & ={r}^{2}{cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r} & =(2{r}^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta +({r}^{2}{cos}^{2}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =2{r}^{2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta +{r}^{2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & =3{r}^{2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360565 #edb/ref 1068 #edb/ref 17592186360352 #edb/ref 17592186045417] [17592186360565 #edb/ref 1069 "q-95113" #edb/ref 17592186045417] [17592186360565 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360565 #edb/ref 1071 "Given that $g(x,y)={y}^{2},$ find $\\frac{∂g}{∂\\theta },$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." #edb/ref 17592186045417] [17592186360565 #edb/ref 1072 #uuid "4a5ea0e8-c2a8-56bd-bc0a-1183f811a786" #edb/ref 17592186045417] [17592186360565 #edb/ref 1074 "Applying the multivariable chain rule for the function $g(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂\\theta } & =\\frac{∂g}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂g}{∂y}\\cdot \\frac{∂y}{∂\\theta } \\\\  & =-\\frac{∂g}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂g}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $g$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x}=0,\\,\\frac{∂g}{∂y}=2y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂y} & =0, \\\\ \\frac{∂g}{∂y} & =2r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂\\theta } & =0\\,(-r\\operatorname{sin}⁡\\theta )+(2r\\operatorname{sin}⁡\\theta )\\,r\\operatorname{cos}⁡\\theta  \\\\  & ={r}^{2}\\operatorname{sin}⁡(2\\theta ).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360567 #edb/ref 1068 #edb/ref 17592186360139 #edb/ref 17592186045417] [17592186360567 #edb/ref 1069 "q-95116" #edb/ref 17592186045417] [17592186360567 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360567 #edb/ref 1071 "Given that $w(x,y)=\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{2},$ find $\\frac{∂w}{∂\\theta },$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." #edb/ref 17592186045417] [17592186360567 #edb/ref 1072 #uuid "09b6c584-862f-5f2c-8d59-a960b719bfdf" #edb/ref 17592186045417] [17592186360567 #edb/ref 1074 "Applying the multivariable chain rule for the function $w(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂w}{∂\\theta } & =\\frac{∂w}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂w}{∂y}\\cdot \\frac{∂y}{∂\\theta } \\\\  & =-\\frac{∂w}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂w}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $w$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x}=x,\\,\\frac{∂w}{∂y}=y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂y} & =r\\operatorname{cos}⁡\\theta , \\\\ \\frac{∂w}{∂y} & =r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂\\theta } & =-(r\\operatorname{cos}⁡\\theta )\\,r\\operatorname{sin}⁡\\theta +(r\\operatorname{sin}⁡\\theta )\\,r\\operatorname{cos}⁡\\theta  \\\\  & =-{r}^{2}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +{r}^{2}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =0\\end{aligned}\n$$" #edb/ref 17592186045417]}
