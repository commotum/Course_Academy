#{[{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186509034} :activity/id #uuid "8192fdb4-5ea5-58a8-b9e0-07e9449bea2f" :activity/scope {:db/id #edb/ref 17592186048635 :topic/id #uuid "b0561e68-388e-5447-b1c3-5f3b61a61231" :topic/math-academy-id 1942} :activity/steps [{:db/id #edb/ref 17592186509022 :step/content {:db/id #edb/ref 17592186125248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50fa9289-6d41-5d28-b208-877cbdbfa6c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}\\operatorname{sin}⁡\\theta +2r\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186358448} {:answer/id #uuid "667d2986-4910-56e6-9ed3-8f27b9abd76f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\operatorname{cos}⁡\\theta +2rz\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186358649} {:answer/id #uuid "add72146-efe2-5a0e-abaa-a3a2463c3158" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}{sin}^{2}⁡\\theta +2rz\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186359259} {:answer/id #uuid "e28e7362-9db3-53ed-accd-873077451494" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}\\operatorname{sin}⁡(2\\theta )+r{z}^{2}\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186359755} {:answer/id #uuid "ef656522-486e-50e0-b47a-5e62e587789f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\operatorname{sin}⁡\\theta +{z}^{2}" :db/id #edb/ref 17592186359883}] :answer-field/correct {:db/id #edb/ref 17592186359259} :answer-field/id #uuid "aee644e2-ce96-5e60-b711-61139e62f74c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360304}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "08bad6ab-1a42-5f7a-8850-36801983c246" :question/math-academy-id "q-95047" :question/problem "Given that $f(x,y,z)=xy+{y}^{2}z+x{z}^{2},$ find $\\frac{∂f}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $f(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂f}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z}={y}^{2}+2xz\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z} & ={r}^{2}{sin}^{2}⁡\\theta +2rz\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$"} :step/id #uuid "9478d728-7a8c-5a18-beaa-daba72c1c2d7" :step/next {:db/id #edb/ref 17592186509028}} {:db/id #edb/ref 17592186509028 :step/content {:db/id #edb/ref 17592186508977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12433c4a-668f-57da-9582-b6ee6515dc42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}\\operatorname{cos}⁡(2\\theta )-\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186508415} {:answer/id #uuid "5c05a8fd-c462-59f0-82be-578cd7e2ef16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}\\operatorname{cos}⁡(2\\theta )" :db/id #edb/ref 17592186508526} {:answer/id #uuid "c3a54554-40d8-5b1a-a681-1f39ccace6c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2r\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186508691} {:answer/id #uuid "d353fe5f-d6bc-5d38-8a44-d344cb894fbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186508730} {:answer/id #uuid "f972d2aa-60ae-5ae2-a173-f83d6fe3630e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}\\operatorname{sin}⁡(2\\theta )+{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186508802}] :answer-field/correct {:db/id #edb/ref 17592186508526} :answer-field/id #uuid "53289756-546a-50f2-80e0-c0a1e0a48184" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186508836}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c9126714-6e57-5593-b5b4-4801efbfb113" :question/math-academy-id "q-95111" :question/problem "Given that $q(x,y)=xy,$ find $\\frac{∂q}{∂\\theta },$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $q(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂q}{∂\\theta } & =\\frac{∂q}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂q}{∂y}\\cdot \\frac{∂y}{∂\\theta } \\\\  & =-\\frac{∂q}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂q}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $q$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂q}{∂x}=y,\\,\\frac{∂q}{∂y}=x\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂q}{∂x} & =r\\operatorname{sin}⁡\\theta , \\\\ \\frac{∂q}{∂y} & =r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂q}{∂\\theta } & =-(r\\operatorname{sin}⁡\\theta )\\,r\\operatorname{sin}⁡\\theta +(r\\operatorname{cos}⁡\\theta )\\,r\\operatorname{cos}⁡\\theta  \\\\  & =-{r}^{2}{sin}^{2}⁡\\theta +{r}^{2}{cos}^{2}⁡\\theta  \\\\  & ={r}^{2}({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & ={r}^{2}\\operatorname{cos}⁡(2\\theta ).\\end{aligned}\n$$"} :step/id #uuid "b30ffaf9-b23b-569c-9c7e-cc9390ec51b6" :step/next {:db/id #edb/ref 17592186509032}} {:db/id #edb/ref 17592186509032 :step/content {:db/id #edb/ref 17592186360565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "255b1439-4503-5ba1-9467-b4cbf23cf837" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186358086} {:answer/id #uuid "2826740b-006a-5fb8-af1b-b04cb4e430c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}(1-{sin}^{2}⁡\\theta )" :db/id #edb/ref 17592186358112} {:answer/id #uuid "8f20dc0c-2f9c-59cb-9371-1e2bab94de58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186358999} {:answer/id #uuid "c17a4d57-ab7f-5cad-9c18-15918d10a4db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186359449} {:answer/id #uuid "ff52e99a-a36a-570b-927e-6775bb16f2f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186359997}] :answer-field/correct {:db/id #edb/ref 17592186359997} :answer-field/id #uuid "d14ca8c8-8191-546e-952e-035f83d5d2de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360352}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a5ea0e8-c2a8-56bd-bc0a-1183f811a786" :question/math-academy-id "q-95113" :question/problem "Given that $g(x,y)={y}^{2},$ find $\\frac{∂g}{∂\\theta },$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $g(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂\\theta } & =\\frac{∂g}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂g}{∂y}\\cdot \\frac{∂y}{∂\\theta } \\\\  & =-\\frac{∂g}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂g}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $g$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x}=0,\\,\\frac{∂g}{∂y}=2y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂y} & =0, \\\\ \\frac{∂g}{∂y} & =2r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂\\theta } & =0\\,(-r\\operatorname{sin}⁡\\theta )+(2r\\operatorname{sin}⁡\\theta )\\,r\\operatorname{cos}⁡\\theta  \\\\  & ={r}^{2}\\operatorname{sin}⁡(2\\theta ).\\end{aligned}\n$$"} :step/id #uuid "bad45fb5-6e01-535a-822a-7b2bcb1da7a2" :step/next {:db/id #edb/ref 17592186509048}} {:db/id #edb/ref 17592186509034 :step/content {:db/id #edb/ref 17592186360535 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7120b822-0ff6-547d-b7c2-2241a49aca6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{r}^{3}\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta " :db/id #edb/ref 17592186358738} {:answer/id #uuid "7d848135-2b15-5316-9a46-e4e3b36ec08b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{r}^{2}\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186358845} {:answer/id #uuid "811e3aba-e8b3-5975-bf14-431f1c3fe93e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186358879} {:answer/id #uuid "9029ca1e-4b6a-555a-8f91-25f0d427d82f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{r}^{2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186359010} {:answer/id #uuid "a1b0a061-fad6-5c22-b008-8d6182556cb5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{r}^{2}{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186359162}] :answer-field/correct {:db/id #edb/ref 17592186359010} :answer-field/id #uuid "7d76e27a-bad6-5130-9b46-77d20a6d4839" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360203}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4970bf30-0b07-5dcd-b3de-478f21daf6db" :question/math-academy-id "q-94999" :question/problem "Given that $h(x,y)={x}^{2}y,$ find $\\frac{∂h}{∂r},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $h(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r} & =\\frac{∂h}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂h}{∂y}\\cdot \\frac{∂y}{∂r} \\\\  & =\\frac{∂h}{∂x}\\operatorname{cos}⁡\\theta +\\frac{∂g}{∂y}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x}=2xy,\\,\\frac{∂h}{∂y}={x}^{2}\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =2{r}^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta , \\\\ \\frac{∂h}{∂y} & ={r}^{2}{cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r} & =(2{r}^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta +({r}^{2}{cos}^{2}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =2{r}^{2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta +{r}^{2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & =3{r}^{2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$"} :step/id #uuid "c0e7d08d-e45f-545c-a6af-cb153d69442e" :step/next {:db/id #edb/ref 17592186509022}} {:db/id #edb/ref 17592186509048 :step/content {:db/id #edb/ref 17592186360567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fe46cca-410f-5c55-88ef-8d80e7031ebb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186358726} {:answer/id #uuid "ba7b642c-5011-5fe6-b8b3-8ba15e13f44b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{r}^{2}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186359374} {:answer/id #uuid "bfc682ef-5b2d-5c3c-8130-e2f1ce1ee474" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186359430} {:answer/id #uuid "e32325f6-ab86-53be-a9ca-0e5883831318" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186359761} {:answer/id #uuid "fb9162b2-a7fc-5e49-88a2-4b87f9188d83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186359975}] :answer-field/correct {:db/id #edb/ref 17592186359430} :answer-field/id #uuid "5ebf0a96-067c-5319-889e-a652fa3fcdea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360139}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "09b6c584-862f-5f2c-8d59-a960b719bfdf" :question/math-academy-id "q-95116" :question/problem "Given that $w(x,y)=\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{2},$ find $\\frac{∂w}{∂\\theta },$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $w(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂w}{∂\\theta } & =\\frac{∂w}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂w}{∂y}\\cdot \\frac{∂y}{∂\\theta } \\\\  & =-\\frac{∂w}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂w}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $w$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x}=x,\\,\\frac{∂w}{∂y}=y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂y} & =r\\operatorname{cos}⁡\\theta , \\\\ \\frac{∂w}{∂y} & =r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂\\theta } & =-(r\\operatorname{cos}⁡\\theta )\\,r\\operatorname{sin}⁡\\theta +(r\\operatorname{sin}⁡\\theta )\\,r\\operatorname{cos}⁡\\theta  \\\\  & =-{r}^{2}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +{r}^{2}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =0\\end{aligned}\n$$"} :step/id #uuid "fc30f928-6c4b-5fd5-b548-a7acd91c520f"}] :activity/title "The Multivariable Chain Rule With Polar Coordinates" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186508382}]}
