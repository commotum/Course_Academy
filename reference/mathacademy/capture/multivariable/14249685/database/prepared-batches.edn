eab"] ["question-e391a05d-f936-58b5-934a-ad5b4d40ee91" :question/answer-fields "answer-field-c7ba4597-ac27-5690-bf79-d5368cab1239"] ["question-e391a05d-f936-58b5-934a-ad5b4d40ee91" :question/answer-fields "answer-field-c3d09404-adf2-557f-9a06-f5a9863cc8b7"] [17592186204026 :knowledge-point/questions "question-e391a05d-f936-58b5-934a-ad5b4d40ee91"] ["question-ce47ce1b-5e64-5fb8-88b0-27f2349480f8" :question/id #uuid "ce47ce1b-5e64-5fb8-88b0-27f2349480f8"] ["question-ce47ce1b-5e64-5fb8-88b0-27f2349480f8" :question/math-academy-id "q-257214"] ["question-ce47ce1b-5e64-5fb8-88b0-27f2349480f8" :question/problem "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[0,1]\\times [0,1]⊆{R}^{2},$ where\n\n$$\nf(x,y)=6x{y}^{2}-3{x}^{2}-6xy+2x.\n$$\n\nFill in the blanks in the matrix equation below that defines the first iteration of the Newton-Raphson process starting at the point $[0,\\,1]^{T},$ and compute the components of the first iteration. Round the answer for ${x}_{1}$ to **three decimal places**.\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">$[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-1}}</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n$6$\n</td>\n<td align=\"center\" rowspan=\"2\">$]({x}_{1}-{x}_{0})\\,=[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n$-2$\n</td>\n<td align=\"left\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n$6$\n</td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-2}}</td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-3}}</td>\n</tr>\n</tbody></table>\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">${x}_{1}≈[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">$0$</td>\n<td align=\"center\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-4}}\n</td>\n</tr>\n</tbody></table>"] ["question-ce47ce1b-5e64-5fb8-88b0-27f2349480f8" :question/worked-solution "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nEquivalently, at each iteration, the above equation can be rewritten as\n\n$$\n{H}_{f}({x}_{n})({x}_{n+1}-{x}_{n})=-∇f({x}_{n}).\n$$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =[\\begin{aligned}\\frac{∂}{∂x}(6x{y}^{2}-3{x}^{2}-6xy+2x) \\\\ \\frac{∂}{∂y}(6x{y}^{2}-3{x}^{2}-6xy+2x)\\end{aligned}] \\\\  & =[\\begin{aligned}6{y}^{2}-6x-6y+2 \\\\ 12xy-6x\\end{aligned}],\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =[\\begin{aligned}\\frac{∂}{∂x}(6{y}^{2}-6x-6y+2) & \\frac{∂}{∂x}(12xy-6x) \\\\ \\frac{∂}{∂y}(6{y}^{2}-6x-6y+2) & \\frac{∂}{∂y}(12xy-6x)\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & 12y-6 \\\\ 12y-6 & 12x\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson system of equations is\n\n$$\n{[\\begin{aligned}-6 & 12y-6 \\\\ 12y-6 & 12x\\end{aligned}]}_{{x}_{n}}({x}_{n+1}-{x}_{n})=-{[\\begin{aligned}6{y}^{2}-6x-6y+2 \\\\ 12xy-6x\\end{aligned}]}_{{x}_{n}}.\n$$\n\nStarting with ${x}_{0}=[\\begin{aligned}0 \\\\ 1\\end{aligned}],$ we have\n\n$$\n\\begin{aligned}{[\\begin{aligned}-6 & 12y-6 \\\\ 12y-6 & 12x\\end{aligned}]}_{{x}_{0}}({x}_{1}-{x}_{0}) & =-{[\\begin{aligned}6{y}^{2}-6x-6y+2 \\\\ 12xy-6x\\end{aligned}]}_{{x}_{0}} \\\\ [\\begin{aligned}-6 & 12(1)-6 \\\\ 12(1)-6 & 12(0)\\end{aligned}]({x}_{1}-{x}_{0}) & =-[\\begin{aligned}6(1)^{2}-6(0)-6(1)+2 \\\\ 12(0)(1)-6(0)\\end{aligned}] \\\\ [\\begin{aligned}-6 & 6 \\\\ 6 & 0\\end{aligned}]({x}_{1}-{x}_{0}) & =[\\begin{aligned}-2 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nSolving this system of equations, we get $({x}_{1}-{x}_{0})=[\\begin{aligned}0 \\\\ -1/3\\end{aligned}].$ Hence,\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}+[\\begin{aligned}0 \\\\ -\\frac{1}{3}\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 1\\end{aligned}]+[\\begin{aligned}0 \\\\ -\\frac{1}{3}\\end{aligned}] \\\\  & ≈[\\begin{aligned}0 \\\\ 0.667\\end{aligned}].\\end{aligned}\n$$"] ["question-ce47ce1b-5e64-5fb8-88b0-27f2349480f8" :question/difficulty :question.difficulty/moderate] ["answer-field-4723ac7c-15e6-5105-8cff-0c025fd5d952" :answer-field/id #uuid "4723ac7c-15e6-5105-8cff-0c025fd5d952"] ["answer-00372683-1a17-5683-b8ec-944ce9ac2dae" :answer/id #uuid "00372683-1a17-5683-b8ec-944ce9ac2dae"] ["answer-00372683-1a17-5683-b8ec-944ce9ac2dae" :answer/type :answer.type/math] ["answer-00372683-1a17-5683-b8ec-944ce9ac2dae" :answer/value "-6"] ["answer-field-4723ac7c-15e6-5105-8cff-0c025fd5d952" :answer-field/key "field-1"] ["answer-field-4723ac7c-15e6-5105-8cff-0c025fd5d952" :answer-field/type :answer-field.type/blank] ["answer-field-4723ac7c-15e6-5105-8cff-0c025fd5d952" :answer-field/correct "answer-00372683-1a17-5683-b8ec-944ce9ac2dae"] ["answer-field-4723ac7c-15e6-5105-8cff-0c025fd5d952" :answer-field/choices "answer-00372683-1a17-5683-b8ec-944ce9ac2dae"] ["answer-field-d1f5f30c-549c-5b34-abb8-940275af359d" :answer-field/id #uuid "d1f5f30c-549c-5b34-abb8-940275af359d"] ["answer-ce8de537-983e-5c76-847d-0ef82aa8faa8" :answer/id #uuid "ce8de537-983e-5c76-847d-0ef82aa8faa8"] ["answer-ce8de537-983e-5c76-847d-0ef82aa8faa8" :answer/type :answer.type/math] ["answer-ce8de537-983e-5c76-847d-0ef82aa8faa8" :answer/value "0"] ["answer-field-d1f5f30c-549c-5b34-abb8-940275af359d" :answer-field/key "field-2"] ["answer-field-d1f5f30c-549c-5b34-abb8-940275af359d" :answer-field/type :answer-field.type/blank] ["answer-field-d1f5f30c-549c-5b34-abb8-940275af359d" :answer-field/correct "answer-ce8de537-983e-5c76-847d-0ef82aa8faa8"] ["answer-field-d1f5f30c-549c-5b34-abb8-940275af359d" :answer-field/choices "answer-ce8de537-983e-5c76-847d-0ef82aa8faa8"] ["answer-field-bfb717c0-13de-5925-8e9a-3605309732dc" :