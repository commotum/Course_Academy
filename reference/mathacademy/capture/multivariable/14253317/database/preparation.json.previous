        "solution": {
          "status": "ambiguous",
          "reasoning": "Multiplying e^{At} by (1,3)ᵀ gives x(t)=cos(4t)+3sin(4t) and y(t)=−sin(4t)+3cos(4t). These satisfy x(0)=1, y(0)=3, x'=4y, and y'=−4x. No captured Math Academy answer or grade establishes its key.",
          "confidence": 1,
          "answers": [
            {
              "key": "field-1",
              "correct_value": "\\cos(4t)+3\\sin(4t)",
              "correct_option": null,
              "value_type": "math",
              "wrong_value": "0",
              "correct_keys": [],
              "wrong_keys": [],
              "ma_value": null,
              "ma_basis": "none",
              "ma_evidence": "",
              "disagrees": false
            },
            {
              "key": "field-2",
              "correct_value": "-\\sin(4t)+3\\cos(4t)",
              "correct_option": null,
              "value_type": "math",
              "wrong_value": "0",
              "correct_keys": [],
              "wrong_keys": [],
              "ma_value": null,
              "ma_basis": "none",
              "ma_evidence": "",
