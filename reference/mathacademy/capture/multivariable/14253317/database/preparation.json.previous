              "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/browser-originals/ad9924d2feb9de31a2dd9c5c889e4367073f6377186cee1b3970a8b057b120c0.html",
              "status": 200,
              "headers": {
                "date": "Fri, 16 Oct 2026 10:43:49 GMT",
