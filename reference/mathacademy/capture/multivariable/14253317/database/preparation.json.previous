        "solution": {
          "status": "ambiguous",
          "reasoning": "Multiplying e^{At} by the arbitrary constant vector (c₁,c₂)ᵀ gives x=c₁cos(11t)−c₂sin(11t) and y=c₁sin(11t)+c₂cos(11t), exactly option b. Differentiation verifies x'=−11y and y'=11x; at t=0 the constants give arbitrary initial conditions. No captured Math Academy answer or grade establishes its key.",
          "confidence": 1,
          "answers": [
            {
              "key": "selection",
              "correct_value": "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(11t) \\\\ \\operatorname{sin}⁡(11t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡(11t) \\\\ \\operatorname{cos}⁡(11t)\\end{aligned}]",
              "correct_option": "b",
              "value_type": "math",
              "wrong_value": null,
              "correct_keys": [],
              "wrong_keys": [],
              "ma_value": null,
              "ma_basis": "none",
              "ma_evidence": "",
