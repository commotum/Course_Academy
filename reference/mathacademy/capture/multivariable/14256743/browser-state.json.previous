<mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>5</mn><mi>x</mi><mo stretchy=\"false\">)</mo></mrow><mn>25</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>I</mi></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>3</mn><mi>x</mi></mrow></msup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>3</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>5</mn><mi>x</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mn>5</mn><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mn>5</mn><mi>x</mi><mo stretchy=\"false\">)</mo><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mrow><mn>34</mn></mfrac></mstyle><mo>+</mo><mi>C</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
