:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186504337} {:answer/id #uuid "d3837867-f45b-547f-9d74-b1e884fcfe7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186504395} {:answer/id #uuid "de534e5e-3fce-5121-9f25-e5c2f538099b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\pi " :db/id #edb/ref 17592186504419}] :answer-field/correct {:answer/id #uuid "027fa49b-eaf8-5d5e-a730-1b6f7fa916e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186504035} :answer-field/id #uuid "12b2d790-750c-54c8-8acc-4cf1f5c0b6e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504484}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "275cbf3f-d183-51d1-83d2-3cab6277b499" :question/math-academy-id "q-152787" :question/problem "Evaluate ${lim}_{x\\to \\,\\sqrt{3}/3}(12\\operatorname{arctan}⁡(x)+\\pi ).$" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{arctan}⁡(x):$\n\n![](images/fc/fc06a4e63f38a315dd3944f65f871cca2dbdddee26ec268e857f79e5f4ab8848.png)\n\nThe domain of $\\operatorname{arctan}⁡(x)$ is $x\\in (-\\infty ,\\infty ).$  \n\nNow, substituting $x=\\frac{\\sqrt{3}}{3}$ directly into the limit, we have \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\sqrt{3}/3}(12\\operatorname{arctan}⁡(x)+\\pi ) & =12\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3})+\\pi  \\\\  & =12\\cdot \\frac{\\pi }{6}+\\pi  \\\\  & =3\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186504689 :knowledge-point/_questions [{:db/id #edb/ref 17592186184239 :knowledge-point/id #uuid "4bcc5d54-e7fd-5be5-9d00-4240d03e21cb" :knowledge-point/title "Finding Limits at Infinity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f9674cd-fc36-57f6-ad84-1aae9e372852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186504114} {:answer/id #uuid "3e26c0b1-8284-57e7-a9f8-8bffe588b552" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186504142} {:answer/id #uuid "424cd365-aeaf-52d2-8c6a-1f6138a6b4e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186504146} {:answer/id #uuid "69d006d7-7370-5efe-8224-5b4a44defc72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186504216} {:answer/id #uuid "ccdaf8fa-6e87-5ff4-b48f-57a493771410" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186504381}] :answer-field/correct {:answer/id #uuid "424cd365-aeaf-52d2-8c6a-1f6138a6b4e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186504146} :answer-field/id #uuid "0426dd6a-8cd9-594a-8773-894cd875c2a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504480}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d32420f7-bf1c-5010-9d26-1f698469ec0b" :question/math-academy-id "q-152807" :question/problem "${lim}_{x\\to \\,-\\infty }\\frac{1}{\\pi }(\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x))=$" :question/worked-solution "First, let's sketch the graph of $y=\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x):$ \n\n![](images/0f/0fa9338fbefb3682249a585b85d287a25868a8f137547830adf6085dae85139a.png)\n\nThe domain of $\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x)$ is $(-\\infty ,\\infty ).$ Moreover, from the graph, we see that\n\n$$\n{lim}_{x\\to -\\infty }\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x)=\\pi .\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to \\,-\\infty }\\frac{1}{\\pi }(\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x))=\\frac{1}{\\pi }\\cdot (\\pi )=1.\n$$"}] [{:db/id #edb/ref 17592186275308 :knowledge-point/_questions [{:db/id #edb/ref 17592186184240 :knowledge-point/id #uuid "5a58f115-f368-5171-af73-37084085b42a" :knowledge-point/title "Finding a Limit Involving Trigonometric Functions and Their Inverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55eb4c92-42d8-57d6-acd0-5c895b942670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186273118} {:answer/id #uuid "7d403926-4450-50ba-84c9-7d9aa1f989d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186273459} {:answer/id #uuid "a0ac37e7-92df-5ede-8595-901bef018a05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186273780} {:answer/id #uuid "c91605a5-ab4d-581f-9f88-55a0efff989c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186274131} {:answer/id #uuid "fc0629a1-6d9e-577a-b40f-38715a13225c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186274600}] :answer-field/correct {:answer/id #uuid "7d403926-4450-50ba-84c9-7d9aa1f989d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186273459} :answer-field/id #uuid "94a2e6e1-9b22-5760-a9d0-b544cf1616d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274890}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "861b507b-5ca9-5f73-9449-f84c92b1d90f" :question/math-academy-id "q-152890" :question/problem "${lim}_{x\\to \\,\\infty }\\operatorname{cos}⁡(2\\operatorname{arctan}⁡(x))=$" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{arctan}⁡(x):$\n\n![](images/ca/ca5e8035505f20619b6707d6d1f2d0b7b2f125a004a0dbd9d448840b0e4ffd99.png)\n\nThe domain of $\\operatorname{arctan}⁡(x)$ is $x\\in (-\\infty ,\\infty ).$  \n\nAs $x$ increases to $\\infty ,$ the graph tends to $y=\\frac{\\pi }{2}.$ Therefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\infty }\\operatorname{cos}⁡(2\\operatorname{arctan}⁡(x)) & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2}) \\\\  & =\\operatorname{cos}⁡(\\pi ) \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186504629 :knowledge-point/_questions [{:db/id #edb/ref 17592186184240 :knowledge-point/id #uuid "5a58f115-f368-5171-af73-37084085b42a" :knowledge-point/title "Finding a Limit Involving Trigonometric Functions and Their Inverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07850059-ddb8-59d8-9ab0-8177d5206ad1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186504046} {:answer/id #uuid "4d11d421-27fe-5c53-897b-17c35864bd3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186504171} {:answer/id #uuid "c141ccd2-2281-55be-a7bc-e600a17abbd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186504361} {:answer/id #uuid "c969f3b4-9799-57d4-a8f4-6cf2a9b701dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186504372} {:answer/id #uuid "f5168c4d-1a9d-5db6-b1eb-f2e01f7135ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186504459}] :answer-field/correct {:answer/id #uuid "c141ccd2-2281-55be-a7bc-e600a17abbd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186504361} :answer-field/id #uuid "65db8db6-731c-5056-8281-d2ccd26fd053" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504522}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55ce71ca-d33d-5c8b-9d05-07e0dca2765b" :question/math-academy-id "q-152891" :question/problem "${lim}_{x\\to \\,3}\\operatorname{sin}⁡(\\frac{3}{2}\\operatorname{arctan}⁡(\\frac{x}{\\sqrt{3}}))=$" :question/worked-solution "First, let's sketch the graph of  $y=\\frac{3}{2}\\operatorname{arctan}⁡(\\frac{x}{\\sqrt{3}}):$   \n\n![](images/4a/4abceba56f404b0b39fbde4b1f7da0ec36e69a496c4ef52d3bebfbcb8c7d3380.png)\n\nThe domain of   $\\frac{3}{2}\\operatorname{arctan}⁡(\\frac{x}{\\sqrt{3}})$ is $(-\\infty ,\\infty ).$    \n\nNow, substituting $x=3$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,3}\\operatorname{sin}⁡(\\frac{3}{2}\\operatorname{arctan}⁡(\\frac{x}{\\sqrt{3}})) & =\\operatorname{sin}⁡(\\frac{3}{2}\\operatorname{arctan}⁡(\\frac{3}{\\sqrt{3}})) \\\\  & =\\operatorname{sin}⁡(\\frac{3}{2}\\operatorname{arctan}⁡(\\sqrt{3})) \\\\  & =\\operatorname{sin}⁡(\\frac{3}{2}\\cdot \\frac{\\pi }{3}) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186504644 :knowledge-point/_questions [{:db/id #edb/ref 17592186184240 :knowledge-point/id #uuid "5a58f115-f368-5171-af73-37084085b42a" :knowledge-point/title "Finding a Limit Involving Trigonometric Functions and Their Inverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20c2c4de-610f-51d5-844f-c2ff3be490af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186504090}] :answer-field/correct {:answer/id #uuid "20c2c4de-610f-51d5-844f-c2ff3be490af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186504090} :answer-field/id #uuid "d1fc9040-4cdf-577b-b242-fcc38c2ab2bd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186504582}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "78505148-e7b2-516b-80ad-17e7629d4193" :question/math-academy-id "q-302680" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,\\sqrt{3}/2}\\operatorname{tan}⁡(\\frac{3}{4}\\operatorname{arcsin}⁡(x))=$\n{{field-1}}" :question/worked-solution "![](images/24/24f07da42a537ded7916fc2440dcf3ee1ccdfc81c7b027b47e97814fec059f5a.png)\n\n \n\nThe domain of $\\operatorname{arcsin}⁡(x)$ is $x\\in [-1,1].$  \n\nNow, substituting $x=\\frac{\\sqrt{3}}{2}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\sqrt{3}/2}\\operatorname{tan}⁡(\\frac{3}{4}\\operatorname{arcsin}⁡(x)) & =\\operatorname{tan}⁡(\\frac{3}{4}\\operatorname{arcsin}⁡(\\frac{\\sqrt{3}}{2})) \\\\  & =\\operatorname{tan}⁡(\\frac{3}{4}\\cdot \\frac{\\pi }{3}) \\\\  & =\\operatorname{tan}⁡(\\frac{\\pi }{4}) \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297280 :knowledge-point/_questions [{:db/id #edb/ref 17592186184240 :knowledge-point/id #uuid "5a58f115-f368-5171-af73-37084085b42a" :knowledge-point/title "Finding a Limit Involving Trigonometric Functions and Their Inverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5112866-46c5-505a-9ff5-4366099f77af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296488}] :answer-field/correct {:answer/id #uuid "e5112866-46c5-505a-9ff5-4366099f77af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296488} :answer-field/id #uuid "012a9099-f188-5701-8e17-e68c41ec5be9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296638}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1394c62-62a1-53db-8987-e127821ad30e" :question/math-academy-id "q-302690" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,\\infty }\\operatorname{tan}⁡(4\\operatorname{arctan}⁡(x))=$\n{{field-1}}" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{arctan}⁡(x):$\n\n![](images/fc/fc06a4e63f38a315dd3944f65f871cca2dbdddee26ec268e857f79e5f4ab8848.png)\n\nThe domain of $\\operatorname{arctan}⁡(x)$ is $x\\in (-\\infty ,\\infty ).$  \n\nAs $x$ increases to $\\infty ,$ the graph tends to $y=\\frac{\\pi }{2}.$ Therefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\infty }\\operatorname{tan}⁡(4\\operatorname{arctan}⁡(x)) & =\\operatorname{tan}⁡(4\\cdot \\frac{\\pi }{2}) \\\\  & =\\operatorname{tan}⁡(2\\pi ) \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186504648 :knowledge-point/_questions [{:db/id #edb/ref 17592186184238 :knowledge-point/id #uuid "7f458c61-bc51-5653-9ecb-1e96eb5c335e" :knowledge-point/title "Finding the Limit of an Inverse Trigonometric Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b27e927b-32d5-51a2-8e94-53fdb54a98e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186504341}] :answer-field/correct {:answer/id #uuid "b27e927b-32d5-51a2-8e94-53fdb54a98e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186504341} :answer-field/id #uuid "38a3d7b0-17b0-59c5-96a8-5a36c3c4f27d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186504500}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "81d25b33-02da-5a6a-a064-091425605527" :question/math-academy-id "q-339125" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,0}\\frac{7\\operatorname{arctan}⁡(x)}{{x}^{2}+5}=$\n{{field-1}}" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{arctan}⁡(x):$\n\n![](images/ca/ca5e8035505f20619b6707d6d1f2d0b7b2f125a004a0dbd9d448840b0e4ffd99.png)\n\nThe domain of $\\operatorname{arctan}⁡(x)$ is $x\\in (-\\infty ,\\infty ).$  \n\nNow, substituting $x=0$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,0}\\frac{7\\operatorname{arctan}⁡(x)}{{x}^{2}+5} & =\\frac{7\\operatorname{arctan}⁡(0)}{(0)^{2}+5} \\\\  & =\\frac{7(0)}{5} \\\\  & =\\frac{0}{5} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233889 :knowledge-point/_questions [{:db/id #edb/ref 17592186184238 :knowledge-point/id #uuid "7f458c61-bc51-5653-9ecb-1e96eb5c335e" :knowledge-point/title "Finding the Limit of an Inverse Trigonometric Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7134903-f0b9-5aee-8e7b-938f5505b2a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186232784}] :answer-field/correct {:answer/id #uuid "f7134903-f0b9-5aee-8e7b-938f5505b2a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186232784} :answer-field/id #uuid "88079d4b-6c8e-51b7-ba1c-82ce3c855f50" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232783}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "96ebc138-5eaf-5da2-ade9-d65adc4bc222" :question/math-academy-id "q-339133" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,{1}^{-}}\\frac{25\\operatorname{arccos}⁡(x)}{{x}^{2}+\\pi }=$\n{{field-1}}" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{arccos}⁡(x):$\n\n![](images/85/85a182aabfe64c27eaafde94e3bdbede9409b02cfd87395cb2fc5543b09c4e05.png)\n\nThe domain of $\\operatorname{arccos}⁡(x)$ is $x\\in [-1,1].$  \n\nNow, substituting $x=1$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{1}^{-}}\\frac{25\\operatorname{arccos}⁡(x)}{{x}^{2}+\\pi } & =\\frac{25\\operatorname{arccos}⁡(1)}{{1}^{2}+\\pi } \\\\  & =\\frac{25\\cdot 0}{1+\\pi } \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186504643 :knowledge-point/_questions [{:db/id #edb/ref 17592186184238 :knowledge-point/id #uuid "7f458c61-bc51-5653-9ecb-1e96eb5c335e" :knowledge-point/title "Finding the Limit of an Inverse Trigonometric Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d378d60-f48c-5380-ac0c-c03fd710b2d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186504280}] :answer-field/correct {:answer/id #uuid "8d378d60-f48c-5380-ac0c-c03fd710b2d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186504280} :answer-field/id #uuid "ba42bf53-af3f-5233-9afc-edfd0750239e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186504565}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "779dfcc0-3a36-5636-a5d6-b4ea61af4fcc" :question/math-academy-id "q-339135" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,0}\\frac{\\operatorname{arcsin}⁡(x)+6}{2x+3}=$\n{{field-1}}" :question/worked-solution "Let's sketch the graph of $y=\\operatorname{arcsin}⁡(x):$\n\n![](images/24/24f07da42a537ded7916fc2440dcf3ee1ccdfc81c7b027b47e97814fec059f5a.png)\n\nThe domain of $\\operatorname{arcsin}⁡(x)$ is $x\\in [-1,1].$  \n\nNow, substituting $x=0$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,0}\\frac{\\operatorname{arcsin}⁡(x)+6}{2x+3} & =\\frac{\\operatorname{arcsin}⁡(0)+6}{2(0)+3} \\\\  & =\\frac{6}{3} \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186504684 :knowledge-point/_questions [{:db/id #edb/ref 17592186184240 :knowledge-point/id #uuid "5a58f115-f368-5171-af73-37084085b42a" :knowledge-point/title "Finding a Limit Involving Trigonometric Functions and Their Inverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a10c49bb-a853-5a0a-96ce-acd212343d3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186504317}] :answer-field/correct {:answer/id #uuid "a10c49bb-a853-5a0a-96ce-acd212343d3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186504317} :answer-field/id #uuid "8dc400da-c09d-518f-b91a-2b22630e2790" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186504545}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cdfb619c-431d-5983-938b-5503bb7b30f1" :question/math-academy-id "q-339480" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,\\frac{1}{2}}\\operatorname{tan}⁡(\\frac{3}{4}\\operatorname{arccos}⁡(x))=$\n{{field-1}}" :question/worked-solution "![](images/85/85a182aabfe64c27eaafde94e3bdbede9409b02cfd87395cb2fc5543b09c4e05.png)\n\nThe domain of $\\operatorname{arccos}⁡(x)$ is $x\\in [-1,1].$\n\nNow, substituting $x=\\frac{1}{2}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\frac{1}{2}}\\operatorname{tan}⁡(\\frac{3}{4}\\operatorname{arccos}⁡(x)) & =\\operatorname{tan}⁡(\\frac{3}{4}\\operatorname{arccos}⁡(\\frac{1}{2})) \\\\  & =\\operatorname{tan}⁡(\\frac{3}{4}\\cdot \\frac{\\pi }{3}) \\\\  & =\\operatorname{tan}⁡(\\frac{\\pi }{4}) \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317367 :knowledge-point/_questions [{:db/id #edb/ref 17592186184239 :knowledge-point/id #uuid "4bcc5d54-e7fd-5be5-9d00-4240d03e21cb" :knowledge-point/title "Finding Limits at Infinity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "352a4a98-711e-5daf-a9a7-cb6c59b4a6a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186315428}] :answer-field/correct {:answer/id #uuid "352a4a98-711e-5daf-a9a7-cb6c59b4a6a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186315428} :answer-field/id #uuid "fc7b5b25-9f87-565d-bb02-622c4b9fbc38" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317146}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d1c4a7f6-dfa8-527f-a427-71639bc74bac" :question/math-academy-id "q-343173" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,\\infty }\\frac{7}{\\pi }(\\operatorname{arctan}⁡(6-x))=$\n{{field-1}}" :question/worked-solution "First, let's sketch the graph of $y=\\operatorname{arctan}⁡(6-x):$ \n\n![](images/04/04dd8257ef32291b930aa29f5bed4de2c41761692fd48d08ed2479f6cbd78659.png)\n\nThe domain of $\\operatorname{arctan}⁡(6-x)$ is $(-\\infty ,\\infty ).$ Moreover, from the graph, we see that\n\n$$\n{lim}_{x\\to \\infty }\\operatorname{arctan}⁡(6-x)=-\\frac{\\pi }{2}.\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to \\,\\infty }\\frac{7}{\\pi }(\\operatorname{arctan}⁡(6-x))=\\frac{7}{\\pi }\\cdot (-\\frac{\\pi }{2})=-\\frac{7}{2}.\n$$"}] [{:db/id #edb/ref 17592186233940 :knowledge-point/_questions [{:db/id #edb/ref 17592186184239 :knowledge-point/