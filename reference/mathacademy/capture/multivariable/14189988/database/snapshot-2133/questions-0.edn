6045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186232921}] :answer-field/correct {:answer/id #uuid "fa252a79-6198-5339-b8cd-9b165faf3c53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186232921} :answer-field/id #uuid "fa58ccf0-ef3f-5aee-9f0d-b90bf4397dde" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232920}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ecbfd230-3cf4-56df-961c-5ee65b48f356" :question/math-academy-id "q-344536" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,-\\infty }\\frac{2}{\\pi }\\,(\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x+1))=$\n{{field-1}}" :question/worked-solution "First, let's sketch the graph of $y=\\operatorname{arctan}⁡(x+1):$ \n\n![](images/4d/4d81187377609f2cc79f2f972b1416a00f854d8c7a72731eb306aaa17d9f7339.png)\n\nThe domain of $\\operatorname{arctan}⁡(x+1)$ is $(-\\infty ,\\infty ).$ Moreover, from the graph, we see that\n\n$$\n{lim}_{x\\to -\\infty }\\operatorname{arctan}⁡(x+1)=-\\frac{\\pi }{2}.\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to \\,-\\infty }\\frac{2}{\\pi }\\,(\\frac{\\pi }{2}-\\operatorname{arctan}⁡(x+1))=\\frac{2}{\\pi }\\,(\\frac{\\pi }{2}-(-\\frac{\\pi }{2}))=2.\n$$"}] [{:db/id #edb/ref 17592186504686 :knowledge-point/_questions [{:db/id #edb/ref 17592186184239 :knowledge-point/id #uuid "4bcc5d54-e7fd-5be5-9d00-4240d03e21cb" :knowledge-point/title "Finding Limits at Infinity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ad20156-2882-5a14-94a6-b4ce02519922" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi" :db/id #edb/ref 17592186504243}] :answer-field/correct {:answer/id #uuid "7ad20156-2882-5a14-94a6-b4ce02519922" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\pi" :db/id #edb/ref 17592186504243} :answer-field/id #uuid "b0fcb170-b0cc-55d0-ae9f-7fe8d73132e7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186504561}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0a1a56f-e520-52c2-bfca-2937cd7b17ca" :question/math-academy-id "q-344539" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,-\\infty }6\\,(\\operatorname{arctan}⁡(3-2x))=$\n{{field-1}}" :question/worked-solution "First, let's sketch the graph of $y=\\operatorname{arctan}⁡(3-2x):$ \n\n![](images/87/873a6fb793d2ae68eab172132e467a48a43ab84733ad92155fe6cc012f516382.png)\n\nThe domain of $\\operatorname{arctan}⁡(3-2x)$ is $(-\\infty ,\\infty ).$ Moreover, from the graph, we see that\n\n$$\n{lim}_{x\\to -\\infty }\\operatorname{arctan}⁡(3-2x)=\\frac{\\pi }{2}.\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to \\,-\\infty }6\\,(\\operatorname{arctan}⁡(3-2x))=6\\cdot (\\frac{\\pi }{2})=3\\pi .\n$$"}]}
