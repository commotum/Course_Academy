bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1} \\\\ {\\beta }_{2}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}-20 \\\\ -10 \\\\ 40 \\\\ 20 \\\\ 10\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector." #edb/ref 17592186045443] [17592186400806 #edb/ref 1075 #edb/ref 17592186400807 #edb/ref 17592186045417] [17592186400806 #edb/ref 1075 #edb/ref 17592186400808 #edb/ref 17592186045417] [17592186400806 #edb/ref 1075 #edb/ref 17592186400809 #edb/ref 17592186045417] [17592186400806 #edb/ref 1075 #edb/ref 17592186400810 #edb/ref 17592186045417] [17592186400806 #edb/ref 1075 #edb/ref 17592186400811 #edb/ref 17592186045417] [17592186400806 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186400806 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186400806 #edb/ref 1078 #edb/ref 17592186400810 #edb/ref 17592186045417] [17592186400806 #edb/ref 1079 #uuid "4b3c0208-2924-5883-9bed-187d0ae990ff" #edb/ref 17592186045417] [17592186400807 #edb/ref 1080 "\\begin{bmatrix}(-20)^{2} \\\\ (-10)^{2} \\\\ {40}^{2} \\\\ {20}^{2} \\\\ {10}^{2}\\end{bmatrix}" #edb/ref 17592186045443] [17592186400807 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186400807 #edb/ref 1083 #uuid "b45e5173-08b7-5057-bcd7-2ece4833aa80" #edb/ref 17592186045417] [17592186400808 #edb/ref 1080 "\\begin{bmatrix}1 \\\\ 2 \\\\ 3 \\\\ 4 \\\\ 5\\end{bmatrix}" #edb/ref 17592186045443] [17592186400808 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186400808 #edb/ref 1083 #uuid "2d628719-a5eb-5293-9d71-ebe7911e2f5b" #edb/ref 17592186045417] [17592186400809 #edb/ref 1080 "\\begin{bmatrix}{1}^{2} \\\\ {2}^{2} \\\\ {3}^{2} \\\\ {4}^{2} \\\\ {5}^{2}\\end{bmatrix}" #edb/ref 17592186045443] [17592186400809 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186400809 #edb/ref 1083 #uuid "ac08afea-c77e-