t{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1} \\\\ {\\beta }_{3}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}-5 \\\\ 2 \\\\ -3 \\\\ 5 \\\\ -2\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta$ is the parameter vector, and $y$ is the observation vector."] ["question-073aeafa-8770-5a15-8253-20c41456014f" :question/difficulty :question.difficulty/moderate] ["answer-field-a64f96cc-114f-5183-b925-394ebe4eea55" :answer-field/id #uuid "a64f96cc-114f-5183-b925-394ebe4eea55"] ["answer-b1d62a8d-a837-54b6-a8dd-4ffe9d215a5c" :answer/id #uuid "b1d62a8d-a837-54b6-a8dd-4ffe9d215a5c"] ["answer-b1d62a8d-a837-54b6-a8dd-4ffe9d215a5c" :answer/type :answer.type/math] ["answer-b1d62a8d-a837-54b6-a8dd-4ffe9d215a5c" :answer/value "\\begin{bmatrix}-5 & 2 & {2}^{2} \\\\ 2 & 3 & {3}^{2} \\\\ -3 & 4 & {4}^{2} \\\\ 5 & 5 & {5}^{2} \\\\ -2 & 6 & {6}^{2}\\end{bmatrix}"] ["answer-f404d07e-482d-5675-99d1-3553e780e555" :answer/id #uuid "f404d07e-482d-5675-99d1-3553e780e555"] ["answer-f404d07e-482d-5675-99d1-3553e780e555" :answer/type :answer.type/math] ["answer-f404d07e-482d-5675-99d1-3553e780e555" :answer/value "\\begin{bmatrix}-5 & 2 & {2}^{3} \\\\ 2 & 3 & {3}^{3} \\\\ -3 & 4 & {4}^{3} \\\\ 5 & 5 & {5}^{3} \\\\ -2 & 6 & {6}^{3}\\end{bmatrix}"] ["answer-ba8969b7-4b24-51c5-900f-eac572324377" :answer/id #uuid "ba8969b7-4b24-51c5-900f-eac572324377"] ["answer-ba8969b7-4b24-51c5-900f-eac572324377" :answer/type :answer.type/math] ["answer-ba8969b7-4b24-51c5-900f-eac572324377" :answer/value "\\begin{bmatrix}1 & 2 & {2}^{2} \\\\ 1 & 3 & {3}^{2} \\\\ 1 & 4 & {4}^{2} \\\\ 1 & 5 & {5}^{2} \\\\ 1 & 6 & {6}^{2}\\end{bmatrix}"] ["answer-1633bf06-92b9-5a46-a867-36bc73eb1b23" :answer/id #uuid "1633bf06-92b9-5a46-a867-36bc73eb1b23"] ["answer-1633bf06-92b9-5a46-a867-36bc73eb1b23" :answer/type :answer.type/math] ["answer-1633bf06-92b9-5a46-a867-36bc73eb1b23" :answer/value "\\begin{bmatrix}1 & 2 & {2}^{3} \\\\ 1 & 3 & {3}^{3} \\\\ 1 & 4 & {4}^{3} 