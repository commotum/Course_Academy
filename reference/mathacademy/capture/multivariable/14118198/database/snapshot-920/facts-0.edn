7592186045417] [17592186406658 #edb/ref 1062 #uuid "5c0620be-2d88-50a9-b295-5b90712b0a8b" #edb/ref 17592186045417] [17592186406658 #edb/ref 1063 #edb/ref 17592186406655 #edb/ref 17592186045417] [17592186406659 #edb/ref 1062 #uuid "c999b8fd-0d25-5711-adf5-8e3f0c95ef68" #edb/ref 17592186045417] [17592186406659 #edb/ref 1063 #edb/ref 17592186406654 #edb/ref 17592186045417] [17592186415149 #edb/ref 1043 #edb/ref 17592186415157 #edb/ref 17592186045417] [17592186415149 #edb/ref 1043 #edb/ref 17592186415158 #edb/ref 17592186045417] [17592186415149 #edb/ref 1043 #edb/ref 17592186415159 #edb/ref 17592186045417] [17592186415149 #edb/ref 1043 #edb/ref 17592186415160 #edb/ref 17592186045417] [17592186415149 #edb/ref 1043 #edb/ref 17592186415161 #edb/ref 17592186045417] [17592186415149 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186415149 #edb/ref 1045 "Orthogonal Linear Transformations" #edb/ref 17592186045417] [17592186415149 #edb/ref 1046 #edb/ref 17592186415158 #edb/ref 17592186045417] [17592186415149 #edb/ref 1048 #edb/ref 17592186046660 #edb/ref 17592186045417] [17592186415149 #edb/ref 1049 #edb/ref 17592186050910 #edb/ref 17592186045417] [17592186415149 #edb/ref 1053 #uuid "e4410405-361b-5f52-bbe2-fae1dae52eb7" #edb/ref 17592186045417] [17592186415150 #edb/ref 1080 "I and III only" #edb/ref 17592186045417] [17592186415150 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186415150 #edb/ref 1083 #uuid "5fce5c53-c88f-5213-9b57-f76cc256d9ec" #edb/ref 17592186045417] [17592186415151 #edb/ref 1080 "I, II, and III" #edb/ref 17592186045417] [17592186415151 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186415151 #edb/ref 1083 #uuid "75a2a860-9b99-512b-901f-14c2d162a694" #edb/ref 17592186045417] [17592186415152 #edb/ref 1080 "None of the statements are true." #edb/ref 17592186045417] [17592186415152 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186415152 #edb/ref 1083 #uuid "87e451be-c0a6-5f4f-8367-e5f2bd3d8579" #edb/ref 17592186045417] [17592186415153 #edb/ref 1080 "I only" #edb/ref 17592186045417] [17592186415153 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186415153 #edb/ref 1083 #uuid "a91a4b12-8794-5dbc-b111-cafaa0420df7" #edb/ref 17592186045417] [17592186415154 #edb/ref 1080 "I and II only" #edb/ref 17592186045417] [17592186415154 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186415154 #edb/ref 1083 #uuid "ac673688-1d30-5b45-8f99-0b4b41a43e4a" #edb/ref 17592186045417] [17592186415155 #edb/ref 1075 #edb/ref 17592186415150 #edb/ref 17592186045417] [17592186415155 #edb/ref 1075 #edb/ref 17592186415151 #edb/ref 17592186045417] [17592186415155 #edb/ref 1075 #edb/ref 17592186415152 #edb/ref 17592186045417] [17592186415155 #edb/ref 1075 #edb/ref 17592186415153 #edb/ref 17592186045417] [17592186415155 #edb/ref 1075 #edb/ref 17592186415154 #edb/ref 17592186045417] [17592186415155 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186415155 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186415155 #edb/ref 1078 #edb/ref 17592186415154 #edb/ref 17592186045417] [17592186415155 #edb/ref 1079 #uuid "288b1ab6-6f15-58b3-8714-e1582f968b3b" #edb/ref 17592186045417] [17592186415156 #edb/ref 1068 #edb/ref 17592186415155 #edb/ref 17592186045417] [17592186415156 #edb/ref 1069 "q-178014" #edb/ref 17592186045417] [17592186415156 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186415156 #edb/ref 1071 "$$\n{u}_{1}=[\\begin{aligned}3 \\\\ -6\\end{aligned}],\\,{u}_{2}=[\\begin{aligned}4 \\\\ 2\\end{aligned}]\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\n- ${u}_{1}\\cdot {u}_{2}=0$\n- ${Q({u}_{1}),Q({u}_{2})}$ is orthogonal\n- ${Q({u}_{1}),Q({u}_{2})}$ is orthonormal" #edb/ref 17592186045417] [17592186415156 #edb/ref 1072 #uuid "2a7fbace-2464-5d79-be05-e6f28745c3de" #edb/ref 17592186045417] [17592186415156 #edb/ref 1074 "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=[\\begin{aligned}3 \\\\ -6\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ 2\\end{aligned}]=12-12=0.\n$$\n\n- Statement II is true. Indeed, $Q({u}_{1})⊥Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}=0.\n$$\n\n- Statement III is false. Notice that, for example, $Q({u}_{1})$ is not a unit vector since\n\n$$\n‖Q({u}_{1})‖=‖{u}_{1}‖=\\sqrt{{3}^{2}+(-6)^{2}}\\ne 1.\n$$\n\nTherefore, the correct answer is \"I and II only.\"" #edb/ref 17592186045417] [17592186415157 #edb/ref 1058 #edb/ref 17592186415161 #edb/ref 17592186045417] [17592186415157 #edb/ref 1062 #uuid "2a7a4301-aad4-5d08-a205-223ae4b21b05" #edb/ref 17592186045417] [17592186415157 #edb/ref 1063 #edb/ref 17592186284748 #edb/ref 17592186045417] [17592186415158 #edb/ref 1058 #edb/ref 17592186415157 #edb/ref 17592186045417] [17592186415158 #edb/ref 1062 #uuid "721b390a-ee2e-5f0b-9e0f-16ccdf1c5e8b" #edb/ref 17592186045417] [17592186415158 #edb/ref 1063 #edb/ref 17592186198749 #edb/ref 17592186045417] [17592186415159 #edb/ref 1058 #edb/ref 17592186415160 #edb/ref 17592186045417] [17592186415159 #edb/ref 1062 #uuid "81b7f578-5735-5cd8-9573-a001cb417b38" #edb/ref 17592186045417] [17592186415159 #edb/ref 1063 #edb/ref 17592186284759 #edb/ref 17592186045417] [17592186415160 #edb/ref 1062 #uuid "99ecfa79-f64e-5756-8068-d2651506c9d0" #edb/ref 17592186045417] [17592186415160 #edb/ref 1063 #edb/ref 17592186415156 #edb/ref 17592186045417] [17592186415161 #edb/ref 1058 #edb/ref 17592186415159 #edb/ref 17592186045417] [17592186415161 #edb/ref 1062 #uuid "ff6d9303-29e4-5651-9e3f-2878730378dc" #edb/ref 17592186045417] [17592186415161 #edb/ref 1063 #edb/ref 17592186284757 #edb/ref 17592186045417]}
