#{[{:activity/first-step {:db/id #edb/ref 17592186199401} :activity/id #uuid "5f56a4f9-bc1e-5b83-af00-1c3cf76a9018" :activity/scope {:db/id #edb/ref 17592186050910 :topic/id #uuid "708a8959-ec54-51e9-bf31-27b3539bdb74" :topic/math-academy-id 4319} :activity/steps [{:db/id #edb/ref 17592186199401 :step/content {:db/id #edb/ref 17592186199537 :tutorial/content "A linear transformation $\\mathbf{Q}:\\mathbb{R}^n \\to \\mathbb{R}^n$ is an **orthogonal linear transformation** if for any $\\mathbf{x}, \\mathbf{y} \\in \\mathbb{R}^n,$ we have that\n\n$$\n\\mathbf{Q}(\\mathbf{x}) \\cdot \\mathbf{Q}(\\mathbf{y}) = \\mathbf{x} \\cdot \\mathbf{y}.\n$$\n\nIn this case, we say that $\\mathbf{Q}$ *preserves the dot product*.\n\nThe linear transformation $\\mathbf{Q}$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $\\mathbf{Q}$ relative to any orthonormal basis (including the standard basis) of $\\mathbb{R}^n$ is orthogonal.\n\n- $\\| \\mathbf{Q}(\\mathbf{x}) \\| = \\| \\mathbf{x} \\|$. In other words, $\\mathbf{Q}$ preserves vector norms.\n\n- If $\\mathbf{x} \\perp \\mathbf{y}$ then $\\mathbf{Q}(\\mathbf{x}) \\perp \\mathbf{Q}(\\mathbf{y})$ for any $\\mathbf{x}, \\mathbf{y} \\in \\mathbb{R}^n.$ In general, $\\mathbf{Q}$ preserves the angle between any two vectors.\n\n- $\\mathbf{Q}$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set." :tutorial/id #uuid "fed8f501-fcb5-5852-bf23-1e999e4c9e1e" :tutorial/math-academy-id 8098 :tutorial/title "Introduction"} :step/id #uuid "1ef8589c-4324-58ea-9201-f5ba88997554" :step/math-academy-id 52322 :step/next {:db/id #edb/ref 17592186199402}} {:db/id #edb/ref 17592186199402 :step/content {:db/id #edb/ref 17592186198448 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198131 :question/id #uuid "0070a453-0237-571f-84fc-a9f58446e6a9" :question/math-academy-id "e-12954"} :knowledge-point/id #uuid "455b3713-34a3-535d-8baf-d279a0341e9f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048849} {:db/id #edb/ref 17592186049045} {:db/id #edb/ref 17592186049606}] :knowledge-point/questions [{:db/id #edb/ref 17592186198978} {:db/id #edb/ref 17592186198979} {:db/id #edb/ref 17592186284757} {:db/id #edb/ref 17592186284758} {:db/id #edb/ref 17592186284759} {:db/id #edb/ref 17592186326847} {:db/id #edb/ref 17592186406654} {:db/id #edb/ref 17592186406656}] :knowledge-point/title "Applying the Angle Preserving Property of Orthogonal Linear Transformations"} :step/id #uuid "8416cf3f-5dd0-52a4-a389-a27f110ac992" :step/math-academy-id 52323 :step/next {:db/id #edb/ref 17592186199403}} {:db/id #edb/ref 17592186199403 :step/content {:db/id #edb/ref 17592186198449 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198130 :question/id #uuid "a77db107-d157-5063-b44a-1ca0a93be099" :question/math-academy-id "e-12951"} :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049811}] :knowledge-point/questions [{:db/id #edb/ref 17592186198749} {:db/id #edb/ref 17592186198750} {:db/id #edb/ref 17592186284748} {:db/id #edb/ref 17592186284761} {:db/id #edb/ref 17592186284764} {:db/id #edb/ref 17592186406655} {:db/id #edb/ref 17592186411865} {:db/id #edb/ref 17592186415156}] :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"} :step/id #uuid "49d42b8f-bd36-5613-9a00-8f0c28f5f77d" :step/math-academy-id 52326}] :activity/title "Orthogonal Linear Transformations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186198524}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186406657} :activity/id #uuid "11d38e3f-6339-5429-8d89-8272fca9a35c" :activity/scope {:db/id #edb/ref 17592186050910 :topic/id #uuid "708a8959-ec54-51e9-bf31-27b3539bdb74" :topic/math-academy-id 4319} :activity/steps [{:db/id #edb/ref 17592186406657 :step/content {:db/id #edb/ref 17592186406656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33d47db5-c434-55d6-9456-167ab8a0b67c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186406641} {:answer/id #uuid "7c3a74ea-6a6d-5da3-b53b-157fcb966ead" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186406643} {:answer/id #uuid "b81c5bc9-bfe5-5ce5-928d-fa684e207472" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186406645} {:answer/id #uuid "c6a8591a-2779-5016-a0d3-d51746099b13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186406647} {:answer/id #uuid "f3f62bc1-8a13-5efa-ad9a-759018432b14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17" :db/id #edb/ref 17592186406650}] :answer-field/correct {:db/id #edb/ref 17592186406641} :answer-field/id #uuid "ac075b6f-3299-5310-ad52-26f9cf648385" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406653}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cf616da5-d6d0-5837-a9fb-64c2cf137040" :question/math-academy-id "q-40488" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $Q(x)\\cdot Q(y)$, where $x=[\\begin{aligned}1 \\\\ 3 \\\\ -2\\end{aligned}]$ and $y=[\\begin{aligned}-3 \\\\ 4 \\\\ 1\\end{aligned}].$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}Q(x)\\cdot Q(y) & =x\\cdot y \\\\  & =1\\cdot (-3)+3\\cdot 4+(-2)\\cdot 1 \\\\  & =7.\\end{aligned}\n$$"} :step/id #uuid "0bda9774-6623-5015-9c4f-2876bc204742" :step/next {:db/id #edb/ref 17592186406658}} {:db/id #edb/ref 17592186406658 :step/content {:db/id #edb/ref 17592186406655 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dfd22c3-475e-57e7-a43b-2426876d96a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$U$ and $W$ only" :db/id #edb/ref 17592186406636} {:answer/id #uuid "18261590-5d63-59fa-a5a2-24d4904d43be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$U$ only" :db/id #edb/ref 17592186406637} {:answer/id #uuid "25feb7c8-dd5c-59a1-bec8-c633a782af5e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$V$ and $W$ only" :db/id #edb/ref 17592186406639} {:answer/id #uuid "2eca64ea-f21c-59ab-b00b-5d3ef14bd0fb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$W$ only" :db/id #edb/ref 17592186406640} {:answer/id #uuid "d2e6fe6e-e075-5371-baff-975eb86d75ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$U$ and $V$ only" :db/id #edb/ref 17592186406648}] :answer-field/correct {:db/id #edb/ref 17592186406636} :answer-field/id #uuid "90932faf-686a-5262-b048-f69de0f0ccfb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406652}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9892c6c7-24de-57f2-a3e8-0b32de0c1349" :question/math-academy-id "q-40491" :question/problem "Let $Q$ be an orthogonal linear transformation. Which of the following are orthogonal sets?\n\n- $U={Q([\\begin{aligned}9 \\\\ 6\\end{aligned}]),Q([\\begin{aligned}2 \\\\ -3\\end{aligned}])}$\n- $W={Q([\\begin{aligned}\\frac{1}{6} \\\\ 1\\end{aligned}]),Q([\\begin{aligned}6 \\\\ -1\\end{aligned}])}$\n- $V={Q([\\begin{aligned}2 \\\\ 3 \\\\ 5\\end{aligned}]),Q([\\begin{aligned}1 \\\\ 4 \\\\ -1\\end{aligned}]),Q([\\begin{aligned}3 \\\\ 3 \\\\ -3\\end{aligned}])}$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nLet's denote the elements of $U,W,$ and $V$ respectively as \n\n$\\,$ ${Q({u}_{1}),Q({u}_{2})},\\,$ ${Q({w}_{1}),Q({w}_{2})},\\,$ and $\\,{Q({v}_{1}),Q({v}_{2}),Q({v}_{3})}.$ \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- $Q({u}_{1})\\cdot Q({u}_{2})=0.$\n\n- $Q({w}_{1})\\cdot Q({w}_{2})=0.$\n\n- $Q({v}_{1})\\cdot Q({v}_{2})=0,\\,Q({v}_{1})\\cdot Q({v}_{3})=0,\\,Q({v}_{2})\\cdot Q({v}_{3})=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get \n\n$$\n\\begin{aligned}Q({u}_{1})\\cdot Q({u}_{2}) & ={u}_{1}\\cdot {u}_{2}=[\\begin{aligned}9 \\\\ 6\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -3\\end{aligned}]=18-18=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthogonal.\n\n- For the set $W,$ we get \n\n$$\n\\begin{aligned}Q({w}_{1})\\cdot Q({w}_{2}) & ={w}_{1}\\cdot {w}_{2}=[\\begin{aligned}\\frac{1}{6} \\\\ 1\\end{aligned}]\\cdot [\\begin{aligned}6 \\\\ -1\\end{aligned}]=1-1=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\n- For the Set $V,$ notice that \n\n$$\n\\begin{aligned}Q({v}_{1})\\cdot Q({v}_{2}) & ={v}_{1}\\cdot {v}_{2}=[\\begin{aligned}2 \\\\ 3 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 4 \\\\ -1\\end{aligned}]=2+12-5=9\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\nTherefore, the correct answer is \"$U$ and $W$ only\"."} :step/id #uuid "5c0620be-2d88-50a9-b295-5b90712b0a8b" :step/next {:db/id #edb/ref 17592186406659}} {:db/id #edb/ref 17592186406659 :step/content {:db/id #edb/ref 17592186406654 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24e42699-a0f0-5e81-a194-c91514b7e8ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186406638} {:answer/id #uuid "46c27bd0-b639-51d1-a04d-8098da45991e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186406642} {:answer/id #uuid "b3565871-fc75-5a3f-bb6e-506cbb0458f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186406644} {:answer/id #uuid "bfd57b0f-3965-5b70-833f-7fa36e06ae4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186406646} {:answer/id #uuid "e14e0ad1-a7b2-5023-b79c-bff39fbd35df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186406649}] :answer-field/correct {:db/id #edb/ref 17592186406644} :answer-field/id #uuid "491c6e1c-81dd-5170-b618-833ce2679d93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406651}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8a69da2c-f673-5e64-a265-9fe904a3c9ad" :question/math-academy-id "q-40514" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $‖Q(x)‖$, where $x=[\\begin{aligned}\\sqrt{6} \\\\ 1 \\\\ 3\\end{aligned}].$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}‖Q(x)‖ & =‖x‖ \\\\  & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}} \\\\  & =\\sqrt{{(\\sqrt{6})}^{2}+{1}^{2}+{3}^{2}} \\\\  & =4.\\end{aligned}\n$$"} :step/id #uuid "c999b8fd-0d25-5711-adf5-8e3f0c95ef68"}] :activity/title "Orthogonal Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186406635}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186415158} :activity/id #uuid "e4410405-361b-5f52-bbe2-fae1dae52eb7" :activity/scope {:db/id #edb/ref 17592186050910 :topic/id #uuid "708a8959-ec54-51e9-bf31-27b3539bdb74" :topic/math-academy-id 4319} :activity/steps [{:db/id #edb/ref 17592186415157 :step/content {:db/id #edb/ref 17592186284748 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19a57218-72df-52b7-a7c9-b44507555a2a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186281924} {:answer/id #uuid "236f86aa-fa00-5096-a10a-e7651f6a6f6c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186282002} {:answer/id #uuid "44f8d700-4e7f-5f15-911f-34b6d469a632" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186282274} {:answer/id #uuid "6d2190ba-be25-51f1-8832-021adf3dcc68" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186282623} {:answer/id #uuid "8f930388-ab9f-54e0-8499-291a03111580" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the statements are true." :db/id #edb/ref 17592186282934}] :answer-field/correct {:db/id #edb/ref 17592186282934} :answer-field/id #uuid "4d6f2115-fb0f-5808-a58b-b7b09276ab3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284062}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1e67e934-1049-5a47-aaca-94c1d2a3bfc1" :question/math-academy-id "q-177118" :question/problem "$$\n{u}_{1}=[\\begin{aligned}2 \\\\ 3 \\\\ 5\\end{aligned}],\\,{u}_{2}=[\\begin{aligned}1 \\\\ 4 \\\\ -1\\end{aligned}],\\,{u}_{3}=[\\begin{aligned}3 \\\\ 3 \\\\ -3\\end{aligned}]\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\n- ${u}_{1}\\cdot {u}_{2}=0$\n- ${Q({u}_{1}),Q({u}_{2}),Q({u}_{3})}$ is orthogonal\n- ${Q({u}_{1}),Q({u}_{2}),Q({u}_{3})}$ is orthonormal" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false since\n\n$$\n{u}_{1}\\cdot {u}_{2}=[\\begin{aligned}2 \\\\ 3 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 4 \\\\ -1\\end{aligned}]=2+12-5=9\\ne 0.\n$$\n\n- Statement II is false. Notice that, for example, $Q({u}_{1})⊥̸Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}\\ne 0.\n$$\n\n- Statement III is false since the set is not even orthogonal.\n\nTherefore, the correct answer is \"None of the statements are true.\""} :step/id #uuid "2a7a4301-aad4-5d08-a205-223ae4b21b05" :step/next {:db/id #edb/ref 17592186415161}} {:db/id #edb/ref 17592186415158 :step/content {:db/id #edb/ref 17592186198749 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ed6bf75-84fa-56c1-9e18-626b99c513e4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186281820} {:answer/id #uuid "266a6ff4-bf98-5301-81a2-052f525db5a3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186282025} {:answer/id #uuid "31c825c3-5c0e-5fe3-97cb-f77e3a036d29" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the statements are true." :db/id #edb/ref 17592186282137} {:answer/id #uuid "3c7824e8-1848-5392-ba1f-1d9573bb5770" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186282219} {:answer/id #uuid "e267522c-82f6-5771-9d4f-70a960c943bc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186283665}] :answer-field/correct {:db/id #edb/ref 17592186282025} :answer-field/id #uuid "10529c41-b955-59ab-bfeb-a9e21c91b899" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186283965}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "70a4471c-4be9-5243-a617-e32ac5259d39" :question/math-academy-id "q-177075" :question/problem "$$\n{u}_{1}=[\\begin{aligned}9 \\\\ 6\\end{aligned}],\\,{u}_{2}=[\\begin{aligned}2 \\\\ -3\\end{aligned}]\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\n- ${u}_{1}\\cdot {u}_{2}=0$\n- ${Q({u}_{1}),Q({u}_{2})}$ is orthogonal\n- ${Q({u}_{1}),Q({u}_{2})}$ is orthonormal" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=[\\begin{aligned}9 \\\\ 6\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -3\\end{aligned}]=18-18=0.\n$$\n\n- Statement II is true. Indeed, $Q({u}_{1})⊥Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}=0.\n$$\n\n- Statement III is false. Notice that, for example, $Q({u}_{1})$ is not a unit vector since\n\n$$\n‖Q({u}_{1})‖=‖{u}_{1}‖=\\sqrt{{9}^{2}+{6}^{2}}\\ne 1.\n$$\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "721b390a-ee2e-5f0b-9e0f-16ccdf1c5e8b" :step/next {:db/id #edb/ref 17592186415157}} {:db/id #edb/ref 17592186415159 :step/content {:db/id #edb/ref 17592186284759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a72e896-d047-5004-a73f-afd0fbcbb77b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186282058} {:answer/id #uuid "366d455d-9990-5b93-b7b2-600d62d4cc54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186282172} {:answer/id #uuid "5064ac84-ef50-510c-8a43-b86cafd44145" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186282378} {:answer/id #uuid "72a81145-45cf-5cc8-9f62-ce693367213d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186282670} {:answer/id #uuid "d2771588-d7cd-5658-8912-e696f18ee8a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186283524}] :answer-field/correct {:db/id #edb/ref 17592186283524} :answer-field/id #uuid "e4b22f39-03e5-53f5-bf7c-13b93c3d9aae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284337}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a26587c8-f4e3-50c7-8549-c17141f2d144" :question/math-academy-id "q-177950" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $Q(x)\\cdot Q(y)$, where $x=[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]$ and $y=[\\begin{aligned}-7 \\\\ -5 \\\\ 1\\end{aligned}].$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}Q(x)\\cdot Q(y) & =x\\cdot y \\\\  & =0\\cdot (-7)+1\\cdot (-5)+1\\cdot 1 \\\\  & =-4.\\end{aligned}\n$$"} :step/id #uuid "81b7f578-5735-5cd8-9573-a001cb417b38" :step/next {:db/id #edb/ref 17592186415160}} {:db/id #edb/ref 17592186415160 :step/content {:db/id #edb/ref 17592186415156 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fce5c53-c88f-5213-9b57-f76cc256d9ec" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186415150} {:answer/id #uuid "75a2a860-9b99-512b-901f-14c2d162a694" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186415151} {:answer/id #uuid "87e451be-c0a6-5f4f-8367-e5f2bd3d8579" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of the statements are true." :db/id #edb/ref 17592186415152} {:answer/id #uuid "a91a4b12-8794-5dbc-b111-cafaa0420df7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186415153} {:answer/id #uuid "ac673688-1d30-5b45-8f99-0b4b41a43e4a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186415154}] :answer-field/correct {:db/id #edb/ref 17592186415154} :answer-field/id #uuid "288b1ab6-6f15-58b3-8714-e1582f968b3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415155}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2a7fbace-2464-5d79-be05-e6f28745c3de" :question/math-academy-id "q-178014" :question/problem "$$\n{u}_{1}=[\\begin{aligned}3 \\\\ -6\\end{aligned}],\\,{u}_{2}=[\\begin{aligned}4 \\\\ 2\\end{aligned}]\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\n- ${u}_{1}\\cdot {u}_{2}=0$\n- ${Q({u}_{1}),Q({u}_{2})}$ is orthogonal\n- ${Q({u}_{1}),Q({u}_{2})}$ is orthonormal" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=[\\begin{aligned}3 \\\\ -6\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ 2\\end{aligned}]=12-12=0.\n$$\n\n- Statement II is true. Indeed, $Q({u}_{1})⊥Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}=0.\n$$\n\n- Statement III is false. Notice that, for example, $Q({u}_{1})$ is not a unit vector since\n\n$$\n‖Q({u}_{1})‖=‖{u}_{1}‖=\\sqrt{{3}^{2}+(-6)^{2}}\\ne 1.\n$$\n\nTherefore, the correct answer is \"I and II only.\""} :step/id #uuid "99ecfa79-f64e-5756-8068-d2651506c9d0"} {:db/id #edb/ref 17592186415161 :step/content {:db/id #edb/ref 17592186284757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a2dbbe-8269-5871-944e-208bd7aa03cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186281693} {:answer/id #uuid "5763789f-ad02-57d2-8abb-2d3ef223624f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{6}" :db/id #edb/ref 17592186282431} {:answer/id #uuid "5f0011b6-dd86-54dd-93e2-86e2608cd8f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186282487} {:answer/id #uuid "aa73376a-4ff1-5a4a-8b18-a94ebfa6fe03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7\\sqrt{2}" :db/id #edb/ref 17592186283167} {:answer/id #uuid "f0a08606-13ff-5fb7-8e16-1af3bdc83744" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186283789}] :answer-field/correct {:db/id #edb/ref 17592186282487} :answer-field/id #uuid "4e6e1327-d962-5a5a-86df-5a6da163058c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284063}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eeb4fa8d-201a-5a9d-8ffa-ae311083bf29" :question/math-academy-id "q-177769" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $‖Q(x)‖$, where $x=[\\begin{aligned}-1 \\\\ 3 \\\\ \\sqrt{6}\\end{aligned}].$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}‖Q(x)‖ & =‖x‖ \\\\  & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{3}^{2}+{(\\sqrt{6})}^{2}} \\\\  & =4.\\end{aligned}\n$$"} :step/id #uuid "ff6d9303-29e4-5651-9e3f-2878730378dc" :step/next {:db/id #edb/ref 17592186415159}}] :activity/title "Orthogonal Linear Transformations" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186415149}]}
