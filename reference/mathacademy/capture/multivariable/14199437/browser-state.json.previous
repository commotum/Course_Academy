mo><mi>t</mi></mrow></msup><mo>⋅</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi>t</mi></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>t</mi></mrow></msup><mo>−</mo><mn>2</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>2</mn><mi>t</mi></mrow></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
