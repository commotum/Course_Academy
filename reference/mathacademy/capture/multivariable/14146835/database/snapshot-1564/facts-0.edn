3872032-3b68-54a9-b047-b5722ee1ce8d" #edb/ref 17592186045417] [17592186442247 #edb/ref 1075 #edb/ref 17592186442226 #edb/ref 17592186045417] [17592186442247 #edb/ref 1075 #edb/ref 17592186442229 #edb/ref 17592186045417] [17592186442247 #edb/ref 1075 #edb/ref 17592186442234 #edb/ref 17592186045417] [17592186442247 #edb/ref 1075 #edb/ref 17592186442237 #edb/ref 17592186045417] [17592186442247 #edb/ref 1075 #edb/ref 17592186442238 #edb/ref 17592186045417] [17592186442247 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186442247 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186442247 #edb/ref 1078 #edb/ref 17592186442238 #edb/ref 17592186045417] [17592186442247 #edb/ref 1079 #uuid "589fe02c-92ec-567f-8354-84271d506420" #edb/ref 17592186045417] [17592186442248 #edb/ref 1075 #edb/ref 17592186442227 #edb/ref 17592186045417] [17592186442248 #edb/ref 1075 #edb/ref 17592186442235 #edb/ref 17592186045417] [17592186442248 #edb/ref 1075 #edb/ref 17592186442236 #edb/ref 17592186045417] [17592186442248 #edb/ref 1075 #edb/ref 17592186442241 #edb/ref 17592186045417] [17592186442248 #edb/ref 1075 #edb/ref 17592186442244 #edb/ref 17592186045417] [17592186442248 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186442248 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186442248 #edb/ref 1078 #edb/ref 17592186442235 #edb/ref 17592186045417] [17592186442248 #edb/ref 1079 #uuid "f5a72b7a-4d2b-5cb1-bfa9-dcf075591732" #edb/ref 17592186045417] [17592186442249 #edb/ref 1068 #edb/ref 17592186442246 #edb/ref 17592186045417] [17592186442249 #edb/ref 1069 "q-42301" #edb/ref 17592186045417] [17592186442249 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186442249 #edb/ref 1071 "![](images/ac/ac9f6016ee4c93aec58f8fff0a8002057f89d7c1bae589e5357a25709ae5a76c.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨\\operatorname{cos}⁡t-\\operatorname{cos}⁡2t,\\,\\operatorname{sin}⁡t-\\operatorname{sin}⁡2t⟩$ for $t\\in [\\frac{\\pi }{3},\\frac{5\\pi }{3}].$ The area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{\\pi /3}^{5\\pi /3}\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=-y$ and $Q(x,y)=0.$ Determine the missing part of the equation." #edb/ref 17592186045417] [17592186442249 #edb/ref 1072 #uuid "19d2b758-b269-5c92-aaaf-707449daf876" #edb/ref 17592186045417] [17592186442249 #edb/ref 1074 "Our simple, smooth, closed path $C$ is positively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}-y\\,\\text{d}x.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨-\\operatorname{sin}⁡t+2\\operatorname{sin}⁡2t,\\,\\operatorname{cos}⁡t-2\\operatorname{cos}⁡2t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}-y\\,dx & ={\\int }_{\\pi /3}^{5\\pi /3}-(\\operatorname{sin}⁡t-\\operatorname{sin}⁡2t)\\cdot (-\\operatorname{sin}⁡t+2\\operatorname{sin}⁡2t)\\,dt \\\\  & ={\\int }_{\\pi /3}^{5\\pi /3}(\\operatorname{sin}⁡t-\\operatorname{sin}⁡2t)(\\operatorname{sin}⁡t-2\\operatorname{sin}⁡2t)\\,dt.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186442250 #edb/ref 1068 #edb/ref 17592186442245 #edb/ref 17592186045417] [17592186442250 #edb/ref 1069 "q-42315" #edb/ref 17592186045417] [17592186442250 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186442250 #edb/ref 1071 "![](images/bf/bfec7cbdb26a3db773ab1f6207de436ff0856b331cda183da530dbb6b91d91bd.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨{cos}^{3}⁡t,\\,{sin}^{3}⁡t⟩$ for $t\\in [0,2\\pi ].$ The area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{2\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=-y$ and $Q(x,y)=0.$ Determine the missing part of the equation." #edb/ref 17592186045417] [17592186442250 #edb/ref 1072 #uuid "30739161-7e72-5e37-b131-9975b77440f7" #edb/ref 17592186045417] [17592186442250 #edb/ref 1074 "Our simple, piecewise-smooth, closed path $C$ is positively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}-y\\,\\text{d}x.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨-3{cos}^{2}⁡t\\operatorname{sin}⁡t,\\,3{sin}^{2}⁡t\\operatorname{cos}⁡t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}-y\\,dx & ={\\int }_{0}^{2\\pi }(-{sin}^{3}⁡t)\\cdot (-3{cos}^{2}⁡t\\operatorname{sin}⁡t)\\,dt \\\\  & ={\\int }_{0}^{2\\pi }3{sin}^{4}⁡t{cos}^{2}⁡t\\,dt.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186442251 #edb/ref 1068 #edb/ref 17592186442247 #edb/ref 17592186045417] [17592186442251 #edb/ref 1069 "q-126757" #edb/ref 17592186045417] [17592186442251 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186442251 #edb/ref 1071 "![](images/ef/ef44f01fb462cdf608f66a60dd11b8df798603bd204dca9d579ed50b370a84e3.png)\n\nUse Green's theorem to find the area of the region enclosed by the curve \n$C$ parametrized as $r(t)=-3\\operatorname{sin}⁡2t\\,i-\\operatorname{sin}⁡4t\\,j$ \nfor $t\\in [0,\\frac{\\pi }{2}].$" #edb/ref 17592186045417] [17592186442251 #edb/ref 1072 #uuid "55130439-a2e5-560a-bbed-4ce47334253d" #edb/ref 17592186045417] [17592186442251 #edb/ref 1074 "First, let $P(x,y)=-y$ and $Q(x,y)=0.$\n\nOur simple, smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since our path is negatively oriented. \n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =-6\\operatorname{cos}⁡2t\\,i-4\\operatorname{cos}⁡4t\\,j.\\end{aligned}\n$$\n\nFinally, we can evaluate our line integral using the substitution $u=\\operatorname{cos}⁡2t,\\text{d}u=-2\\operatorname{sin}⁡2t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}y\\,dx & ={\\int }_{0}^{\\pi /2}-\\operatorname{sin}⁡4t\\cdot (-6\\operatorname{cos}⁡2t)\\,\\text{d}t \\\\  & =6{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡4t\\operatorname{cos}⁡2t\\,\\text{d}t \\\\  & =6{\\int }_{0}^{\\pi /2}2\\operatorname{sin}⁡2t\\operatorname{cos}⁡2t\\cdot \\operatorname{cos}⁡2t\\,\\text{d}t \\\\  & =-6{\\int }_{0}^{\\pi /2}{cos}^{2}⁡2t\\cdot (-2\\operatorname{sin}⁡2t)\\,\\text{d}t \\\\  & =-6{\\int }_{1}^{-1}{u}^{2}\\,\\text{d}u \\\\  & =6{\\int }_{-1}^{1}{u}^{2}\\,\\text{d}u \\\\  & =2{u}^{3}{|}_{-1}^{1} \\\\  & =2({1}^{3}-(-1)^{3}) \\\\  & =4\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186442252 #edb/ref 1068 #edb/ref 17592186442248 #edb/ref 17592186045417] [17592186442252 #edb/ref 1069 "q-126746" #edb/ref 17592186045417] [17592186442252 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186442252 #edb/ref 1071 "![](images/0a/0a60729b626e1e9e219a839898cacc18aa81ec2a9b1b445e7b92b721874c2550.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨3\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t⟩$ for $t\\in [0,2\\pi ].$ The area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{2\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=0$ and $Q(x,y)=x.$ Determine the missing part of the equation." #edb/ref 17592186045417] [17592186442252 #edb/ref 1072 #uuid "6653118e-2998-5812-b728-f3217528d405" #edb/ref 17592186045417] [17592186442252 #edb/ref 1074 "Our simple, smooth, closed path $C$ is positively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}x\\,\\text{d}y.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨-3\\operatorname{sin}⁡t,\\,3\\operatorname{cos}⁡t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}x\\,dy & ={\\int }_{0}^{2\\pi }3\\operatorname{cos}⁡t\\cdot 3\\operatorname{cos}⁡t\\,dt \\\\  & ={\\int }_{0}^{2\\pi }9{cos}^{2}⁡t\\,dt.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186442253 #edb/ref 1058 #edb/ref 17592186442256 #edb/ref 17592186045417] [17592186442253 #edb/ref 1062 #uuid "26451fe3-7951-51a8-9a1b-fd3d8660fd3b" #edb/ref 17592186045417] [17592186442253 #edb/ref 1063 #edb/ref 17592186442249 #edb/ref 17592186045417] [17592186442254 #edb/ref 1058 #edb/ref 17592186442253 #edb/ref 17592186045417] [17592186442254 #edb/ref 1062 #uuid "3efe2d38-47eb-5856-81a2-431378bd1194" #edb/ref 17592186045417] [17592186442254 #edb/ref 1063 #edb/ref 17592186134386 #edb/ref 17592186045417] [1759218644225