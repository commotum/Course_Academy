 256 131 289Z\" id=\"E8-MJMATHI-73\" stroke-width=\"1\"></path>\n<path d=\"M84 520Q84 528 88 533T96 539L99 540Q106 540 253 471T544 334L687 265Q694 260 694 250T687 235Q685 233 395 96L107 -40H101Q83 -38 83 -20Q83 -19 83 -17Q82 -10 98 -1Q117 9 248 71Q326 108 378 132L626 250L378 368Q90 504 86 509Q84 513 84 520Z\" id=\"E8-MJMAIN-3E\" stroke-width=\"1\"></path>\n<path d=\"M96 585Q152 666 249 666Q297 666 345 640T423 548Q460 465 460 320Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\" id=\"E8-MJMAIN-30\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E8-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E8-MJSZ2-222E\" y=\"1\"></use>\n<use transform=\"scale(0.707)\" x=\"-70\" xlink:href=\"#E8-MJMATHI-43\" y=\"-2161\"></use>\n<use x=\"1111\" xlink:href=\"#E8-MJMAINB-46\" y=\"0\"></use>\n<use x=\"2057\" xlink:href=\"#E8-MJMAIN-22C5\" y=\"0\"></use>\n<use x=\"2558\" xlink:href=\"#E8-MJMAINB-6E\" y=\"0\"></use>\n<use x=\"3420\" xlink:href=\"#E8-MJMAIN-64\" y=\"0\"></use>\n<use x=\"3976\" xlink:href=\"#E8-MJMATHI-73\" y=\"0\"></use>\n<use x=\"4724\" xlink:href=\"#E8-MJMAIN-3E\" y=\"0\"></use>\n<g transform=\"translate(5780,0)\">\n<use xlink:href=\"#E8-MJMAIN-30\"></use>\n<use x=\"500\" xlink:href=\"#E8-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</g>\n</svg></span></p>\n<p>When measuring flux through a closed curve, the curve's orientation does not matter because the outward-pointing unit normal vector is the same in either case. </p>\n<div class=\"graphic\" id=\"graphic-bd79bd973374cd19b8b0badf8e6444c0\"><img src=\"/graphics/bd79bd973374cd19b8b0badf8e6444c0\"/></div>\n<p>So, the flux of <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-9-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 724.5 936.9\" width=\"1.683ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-9-Title\">\\mathbf F</title>\n<defs aria-hidden=\"true\">\n<path d=\"M425 0L228 3Q63 3 51 0H39V62H147V618H39V680H644V676Q647 670 659 552T675 428V424H613Q613 433 605 477Q599 511 589 535T562 574T530 599T488 612T441 617T387 618H368H304V371H333Q389 373 411 390T437 468V488H499V192H437V212Q436 244 430 263T408 292T378 305T333 309H304V62H439V0H425Z\" id=\"E9-MJMAINB-46\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E9-MJMAINB-46\" y=\"0\"></use>\n</g>\n</svg></span> across <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-10-Title\" focusable=\"false\" height=\"2.343ex\" role=\"img\" style=\"vertical-align: -0.505ex;\" viewbox=\"0 -791.3 1539 1008.6\" width=\"3.574ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-10-Title\">-C</title>\n<defs aria-hidden=\"true\">\n<path d=\"M84 237T84 250T98 270H679Q694 262 694 250T679 230H98Q84 237 84 250Z\" id=\"E10-MJMAIN-2212\" stroke-width=\"1\"></path>\n<path d=\"M50 252Q50 367 117 473T286 641T490 704Q580 704 633 653Q642 643 648 636T656 626L657 623Q660 623 684 649Q691 655 699 663T715 679T725 690L740 705H746Q760 705 760 698Q760 694 728 561Q692 422 692 421Q690 416 687 415T669 413H653Q647 419 647 422Q647 423 648 429T650 449T651 481Q651 552 619 605T510 659Q484 659 454 652T382 628T299 572T226 479Q194 422 175 346T156 222Q156 108 232 58Q280 24 350 24Q441 24 512 92T606 240Q610 253 612 255T628 257Q648 257 648 248Q648 243 647 239Q618 132 523 55T319 -22Q206 -22 128 53T50 252Z\" id=\"E10-MJMATHI-43\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E10-MJMAIN-2212\" y=\"0\"></use>\n<use x=\"778\" xlink:href=\"#E10-MJMATHI-43\" y=\"0\"></use>\n</g>\n</svg></span> is also positive, and we have\n<span class=\"mjpage mjpage__block\"><svg aria-labelledby=\"MathJax-SVG-11-Title\" focusable=\"false\" height=\"7.509ex\" role=\"img\" style=\"vertical-align: -4.171ex; margin-left: -0.447ex;\" viewbox=\"-192.5 -1437.2 6823.7 3233.2\" width=\"15.849ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-11-Title\">\n\\oint\\limits_{-C} \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s &gt; 0.\n</title>\n<defs aria-hidden=\"true\">\n<path d=\"M114 -798Q132 -824 165 -824H167Q195 -824 223 -764T275 -600T320 -391T362 -164Q365 -143 367 -133Q382 -52 390 2Q314 40 276 99Q230 167 230 249Q230 363 305 436T484 519H494L503 563Q587 939 632 1087T727 1298Q774 1360 828 1360Q884 1360 912 1325T944 1245Q944 1220 932 1205T909 1186T887 1183Q866 1183 849 1198T832 1239Q832 1287 885 1296L882 1300Q879 1303 874 1307T866 1313Q851 1323 833 1323Q766 1323 688 929Q662 811 610 496Q770 416 770 249Q770 147 701 68T516 -21H506L497 -65Q407 -464 357 -623T237 -837Q203 -862 165 -862Q125 -862 92 -831T55 -746Q55 -711 74 -698T112 -685Q133 -685 150 -700T167 -741Q167 -789 114 -798ZM480 478Q460 478 435 470T380 444T327 401T287 335T271 249Q271 124 375 56L397 43L431 223L485 478H480ZM519 20Q545 20 578 33T647 72T706 144T730 249Q730 383 603 455Q603 454 597 421T582 343T569 276Q516 22 515 20H519Z\" id=\"E11-MJSZ2-222E\" stroke-width=\"1\"></path>\n<path d=\"M84 237T84 250T98 270H679Q694 262 694 250T679 230H98Q84 237 84 250Z\" id=\"E11-MJMAIN-2212\" stroke-width=\"1\"></path>\n<path d=\"M50 252Q50 367 117 473T286 641T490 704Q580 704 633 653Q642 643 648 636T656 626L657 623Q660 623 684 649Q691 655 699 663T715 679T725 690L740 705H746Q760 705 760 698Q760 694 728 561Q692 422 692 421Q690 416 687 415T669 413H653Q647 419 647 422Q647 423 648 429T650 449T651 481Q651 552 619 605T510 659Q484 659 454 652T382 628T299 572T226 479Q194 422 175 346T156 222Q156 108 232 58Q280 24 350 24Q441 24 512 92T606 240Q610 253 612 255T628 257Q648 257 648 248Q648 243 647 239Q618 132 523 55T319 -22Q206 -22 128 53T50 252Z\" id=\"E11-MJMATHI-43\" stroke-width=\"1\"></path>\n<path d=\"M425 0L228 3Q63 3 51 0H39V62H147V618H39V680H644V676Q647 670 659 552T675 428V424H613Q613 433 605 477Q599 511 589 535T562 574T530 599T488 612T441 617T387 618H368H304V371H333Q389 373 411 390T437 468V488H499V192H437V212Q436 244 430 263T408 292T378 305T333 309H304V62H439V0H425Z\" id=\"E11-MJMAINB-46\" stroke-width=\"1\"></path>\n<path d=\"M78 250Q78 274 95 292T138 310Q162 310 180 294T199 251Q199 226 182 208T139 190T96 207T78 250Z\" id=\"E11-MJMAIN-22C5\" stroke-width=\"1\"></path>\n<path d=\"M40 442Q217 450 218 450H224V407L225 365Q233 378 245 391T289 422T362 448Q374 450 398 450Q428 450 448 447T491 434T529 402T551 346Q553 335 554 198V62H623V0H614Q596 3 489 3Q374 3 365 0H356V62H425V194V275Q425 348 416 373T371 399Q326 399 288 370T238 290Q236 281 235 171V62H304V0H295Q277 3 171 3Q64 3 46 0H37V62H106V210V303Q106 353 104 363T91 376Q77 380 50 380H37V442H40Z\" id=\"E11-MJMAINB-6E\" stroke-width=\"1\"></path>\n<path d=\"M376 495Q376 511 376 535T377 568Q377 613 367 624T316 637H298V660Q298 683 300 683L310 684Q320 685 339 686T376 688Q393 689 413 690T443 693T454 694H457V390Q457 84 458 81Q461 61 472 55T517 46H535V0Q533 0 459 -5T380 -11H373V44L365 37Q307 -11 235 -11Q158 -11 96 50T34 215Q34 315 97 378T244 442Q319 442 376 393V495ZM373 342Q328 405 260 405Q211 405 173 369Q146 341 139 305T131 211Q131 155 138 120T173 59Q203 26 251 26Q322 26 373 103V342Z\" id=\"E11-MJMAIN-64\" stroke-width=\"1\"></path>\n<path d=\"M131 289Q131 321 147 354T203 415T300 442Q362 442 390 415T419 355Q419 323 402 308T364 292Q351 292 340 300T328 326Q328 342 337 354T354 372T367 378Q368 378 368 379Q368 382 361 388T336 399T297 405Q249 405 227 379T204 326Q204 301 223 291T278 274T330 259Q396 230 396 163Q396 135 385 107T352 51T289 7T195 -10Q118 -10 86 19T53 87Q53 126 74 143T118 160Q133 160 146 151T160 120Q160 94 142 76T111 58Q109 57 108 57T107 55Q108 52 115 47T146 34T201 27Q237 27 263 38T301 66T318 97T323 122Q323 150 302 164T254 181T195 196T148 231Q131 256 131 289Z\" id=\"E11-MJMATHI-73\" stroke-width=\"1\"></path>\n<path d=\"M84 520Q84 528 88 533T96 539L99 540Q106 540 253 471T544 334L687 265Q694 260 694 250T687 235Q685 233 395 96L107 -40H101Q83 -38 83 -20Q83 -19 83 -17Q82 -10 98 -1Q117 9 248 71Q326 108 378 132L626 250L378 368Q90 504 86 509Q84 513 84 520Z\" id=\"E11-MJMAIN-3E\" stroke-width=\"1\"></path>\n<path d=\"M96 585Q152 666 249 666Q297 666 345 640T423 548Q460 465 460 320Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\" id=\"E11-MJMAIN-30\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E11-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"71\" xlink:href=\"#E11-MJSZ2-222E\" y=\"1\"></use>\n<g transform=\"translate(-253,-1528)\">\n<use transform=\"scale(0.707)\" x=\"0\" xlink:href=\"#E11-MJMAIN-2212\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"778\" xlink:href=\"#E11-MJMATHI-43\" y=\"0\"></use>\n</g>\n<use x=\"1183\" xlink:href=\"#E11-MJMAINB-46\" y=\"0\"></use>\n<use x=\"2129\" xlink:href=\"#E11-MJMAIN-22C5\" y=\"0\"></use>\n<use x=\"2630\" xlink:href=\"#E11-MJMAINB-6E\" y=\"0\"></use>\n<use x=\"3492\" xlink:href=\"#E11-MJMAIN-64\" y=\"0\"></use>\n<use x=\"4048\" xlink:href=\"#E11-MJMATHI-73\" y=\"0\"></use>\n<u