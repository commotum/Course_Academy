          "path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14123192/assets/ac3aae49f372908f2f9aeb53e3fc98bff117846fca05a8c696009e443390811c.png",
          "sha256": "ac3aae49f372908f2f9aeb53e3fc98bff117846fca05a8c696009e443390811c",
