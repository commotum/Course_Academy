      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14123192/observations/lesson-step-184969-1ce49bb82076591732e9.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14123192/observations/lesson-step-184969-1ce49bb82076591732e9.png",
