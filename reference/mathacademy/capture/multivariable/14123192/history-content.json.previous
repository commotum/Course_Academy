i mathvariant=\"bold\">F</mi></mrow></math></mjx-assistive-mml></mjx-container> across <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"82\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D436 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi></math></mjx-assistive-mml></mjx-container> is positive </li><li>  The flux of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"83\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D405 TEX-B\"></mjx-c></mjx-mi></mjx-texatom></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">F</mi></mrow></math></mjx-assistive-mml></mjx-container> across <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"84\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D436 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>−</mo><mi>C</mi></math></mjx-assistive-mml></mjx-container> is positive </li></ol></div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Sun, Oct 11th @ 12:07 PM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:16</span><span class=\"answerResult\"><span style=\"color: red;\">Incorrect</span></span></div></div>"
