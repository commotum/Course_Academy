47ced8cb410522d8e8db72\"><img src=\"/graphics/50f4143a5147ced8cb410522d8e8db72\"/></div>\n<p>If <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-7-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 724.5 936.9\" width=\"1.683ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-7-Title\">\\mathbf{F}</title>\n<defs aria-hidden=\"true\">\n<path d=\"M425 0L228 3Q63 3 51 0H39V62H147V618H39V680H644V676Q647 670 659 552T675 428V424H613Q613 433 605 477Q599 511 589 535T562 574T530 599T488 612T441 617T387 618H368H304V371H333Q389 373 411 390T437 468V488H499V192H437V212Q436 244 430 263T408 292T378 305T333 309H304V62H439V0H425Z\" id=\"E7-MJMAINB-46\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E7-MJMAINB-46\" y=\"0\"></use>\n</g>\n</svg></span> is a vector field and <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-8-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 760.5 936.9\" width=\"1.766ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-8-Title\">C</title>\n<defs aria-hidden=\"true\">\n<path d=\"M50 252Q50 367 117 473T286 641T490 704Q580 704 633 653Q642 643 648 636T656 626L657 623Q660 623 684 649Q691 655 699 663T715 679T725 690L740 705H746Q760 705 760 698Q760 694 728 561Q692 422 692 421Q690 416 687 415T669 413H653Q647 419 647 422Q647 423 648 429T650 449T651 481Q651 552 619 605T510 659Q484 659 454 652T382 628T299 572T226 479Q194 422 175 346T156 222Q156 108 232 58Q280 24 350 24Q441 24 512 92T606 240Q610 253 612 255T628 257Q648 257 648 248Q648 243 647 239Q618 132 523 55T319 -22Q206 -22 128 53T50 252Z\" id=\"E8-MJMATHI-43\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hid