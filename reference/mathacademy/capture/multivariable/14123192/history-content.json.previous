dth=\"1\"></path>\n<path d=\"M462 0Q444 3 333 3Q217 3 199 0H190V46H221Q241 46 248 46T265 48T279 53T286 61Q287 63 287 115V165H28V211L179 442Q332 674 334 675Q336 677 355 677H373L379 671V211H471V165H379V114Q379 73 379 66T385 54Q393 47 442 46H471V0H462ZM293 211V545L74 212L183 211H293Z\" id=\"E16-MJMAIN-34\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E16-MJMATHI-43\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"1011\" xlink:href=\"#E16-MJMAIN-34\" y=\"-213\"></use>\n</g>\n</svg></span> and its outward-pointing unit normal are shown below.</p>\n<div class=\"graphic\" id=\"graphic-fb2736a701d260b239001b108e3d6c40\"><img src=\"/graphics/fb2736a701d260b239001b108e3d6c40\"/></div>\n<p>Since this side is perpendicular to the <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-17-Title\" focusable=\"false\" height=\"2.009ex\" role=\"img\" style=\"vertical-align: -0.671ex;\" viewbox=\"0 -576.1 497.5 865.1\" width=\"1.155ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-17-Title\">y</title>\n<defs aria-hidden=\"true\">\n<path d=\"M21 287Q21 301 36 335T84 406T158 442Q199 442 224 419T250 355Q248 336 247 334Q247 331 231 288T198 191T182 105Q182 62 196 45T238 27Q261 27 281 38T312 61T339 94Q339 95 344 114T358 173T377 247Q415 397 419 404Q432 431 462 431Q475 431 483 424T494 412T496 403Q496 390 447 193T391 -23Q363 -106 294 -155T156 -205Q111 -205 77 -183T43 -117Q43 -95 50 -80T69 -58T89 -48T106 -45Q150 -45 150 -87Q150 -107 138 -122T115 -142T102 -147L99 -148Q101 -153 118 -160T152 -167H160Q177 -167 186 -165Q219 -156 247 -127T290 -65T313 -9T321 21L315 17Q309 13 296 6T270 -6Q250 -11 231 -11Q185 -11 150 11T104 82Q103 89 103 113Q103 170 138 262T173 379Q173 380 173 381Q173 390 173 393T169 400T158 404H154Q131 404 112 385T82 344T65 302T57 280Q55 278 41 278H27Q21 284 21 287Z\" id=\