1-MJMATHI-73\" d=\"M131 289Q131 321 147 354T203 415T300 442Q362 442 390 415T419 355Q419 323 402 308T364 292Q351 292 340 300T328 326Q328 342 337 354T354 372T367 378Q368 378 368 379Q368 382 361 388T336 399T297 405Q249 405 227 379T204 326Q204 301 223 291T278 274T330 259Q396 230 396 163Q396 135 385 107T352 51T289 7T195 -10Q118 -10 86 19T53 87Q53 126 74 143T118 160Q133 160 146 151T160 120Q160 94 142 76T111 58Q109 57 108 57T107 55Q108 52 115 47T146 34T201 27Q237 27 263 38T301 66T318 97T323 122Q323 150 302 164T254 181T195 196T148 231Q131 256 131 289Z\"></path>\n<path stroke-width=\"1\" id=\"E11-MJMAIN-3E\" d=\"M84 520Q84 528 88 533T96 539L99 540Q106 540 253 471T544 334L687 265Q694 260 694 250T687 235Q685 233 395 96L107 -40H101Q83 -38 83 -20Q83 -19 83 -17Q82 -10 98 -1Q117 9 248 71Q326 108 378 132L626 250L378 368Q90 504 86 509Q84 513 84 520Z\"></path>\n<path stroke-width=\"1\" id=\"E11-MJMAIN-30\" d=\"M96 585Q152 666 249 666Q297 666 345 640T423 548Q460 465 460 320Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\"></path>\n<path stroke-width=\"1\" id=\"E11-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E11-MJSZ2-222E\" x=\"71\" y=\"1\"></use>\n<g transform=\"translate(-253,-1528)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E11-MJMAIN-2212\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E11-MJMATHI-43\" x=\"778\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E11-MJMAINB-46\" x=\"1183\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMAIN-22C5\" x=\"2129\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMAINB-6E\" x=\"2630\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMAIN-64\" x=\"3492\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMATHI-73\" x=\"4048\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMAIN-3E\" x=\"4795\" y=\"0\"></use>\n<g transform=\"translate(5852,0)\">\n <use xlink:href=\"#E11-MJMAIN-30\"></use>\n <use xlink:href=\"#E11-MJMAIN-2E\" x=\"500\" y=\"0\"></use>\n</g>\n</g>\n</svg></span></p>\n\n        </div>",
