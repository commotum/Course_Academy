e>\n<g transform=\"translate(1334,0)\">\n <use xlink:href=\"#E19-MJSZ2-222B\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(-212,-1529)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E19-MJMATHI-43\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.574)\" xlink:href=\"#E19-MJMAIN-34\" x=\"881\" y=\"-254\"></use>\n</g>\n</g>\n <use xlink:href=\"#E19-MJMAIN-28\" x=\"2278\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMATHI-78\" x=\"2668\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMATHI-79\" x=\"3240\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMAINB-69\" x=\"3904\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMAIN-29\" x=\"4224\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMAIN-22C5\" x=\"4835\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMAIN-28\" x=\"5336\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMAIN-2212\" x=\"5726\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMAINB-6A\" x=\"6504\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMAIN-29\" x=\"6856\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMAIN-2B\" x=\"7467\" y=\"0\"></use>\n<g transform=\"translate(8468,0)\">\n <use xlink:href=\"#E19-MJSZ1-28\"></use>\n <use xlink:href=\"#E19-MJMAIN-28\" x=\"458\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMATHI-79\" x=\"848\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMAIN-2212\" x=\"1567\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMATHI-78\" x=\"2568\" y=\"0\"></use>\n<g transform=\"translate(3140,0)\">\n <use xlink:href=\"#E19-MJMAIN-29\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E19-MJMAIN-33\" x=\"550\" y=\"583\"></use>\n</g>\n <use xlink:href=\"#E19-MJMAINB-6A\" x=\"4151\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMAIN-29\" x=\"4502\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJSZ1-29\" x=\"4892\" y=\"-1\"></use>\n</g>\n <use xlink:href=\"#E19-MJMAIN-22C5\" x=\"14041\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMAIN-28\" x=\"14542\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMAIN-2212\" x=\"14931\" y=\"0\"></use>\n <use xlink:href=\"#E19-MJMAINB-6A\" x=\"157