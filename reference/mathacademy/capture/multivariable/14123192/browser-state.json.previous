      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14123192/observations/step-q127058-b55044457c7f68aca828.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14123192/observations/step-q127058-b55044457c7f68aca828.png",
      "source_url": "https://mathacademy.com/tasks/14123192/topics/3715/lesson",
