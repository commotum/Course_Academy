      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14123192/observations/step-q127026-c7221a92fd840af0e860.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14123192/observations/step-q127026-c7221a92fd840af0e860.png",
