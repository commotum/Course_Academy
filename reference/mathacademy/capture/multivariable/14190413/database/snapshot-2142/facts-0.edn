/ref 17592186045417] [17592186329126 #edb/ref 1083 #uuid "f9bafa3a-cd82-583f-a41e-2c11d39d5a39" #edb/ref 17592186045417] [17592186329195 #edb/ref 1075 #edb/ref 17592186327446 #edb/ref 17592186045417] [17592186329195 #edb/ref 1075 #edb/ref 17592186327794 #edb/ref 17592186045417] [17592186329195 #edb/ref 1075 #edb/ref 17592186328198 #edb/ref 17592186045417] [17592186329195 #edb/ref 1075 #edb/ref 17592186328437 #edb/ref 17592186045417] [17592186329195 #edb/ref 1075 #edb/ref 17592186328556 #edb/ref 17592186045417] [17592186329195 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186329195 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186329195 #edb/ref 1078 #edb/ref 17592186328437 #edb/ref 17592186045417] [17592186329195 #edb/ref 1079 #uuid "067e48ce-1116-50af-a658-609b8280dace" #edb/ref 17592186045417] [17592186329477 #edb/ref 1075 #edb/ref 17592186327103 #edb/ref 17592186045417] [17592186329477 #edb/ref 1075 #edb/ref 17592186327892 #edb/ref 17592186045417] [17592186329477 #edb/ref 1075 #edb/ref 17592186327930 #edb/ref 17592186045417] [17592186329477 #edb/ref 1075 #edb/ref 17592186328049 #edb/ref 17592186045417] [17592186329477 #edb/ref 1075 #edb/ref 17592186329126 #edb/ref 17592186045417] [17592186329477 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186329477 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186329477 #edb/ref 1078 #edb/ref 17592186329126 #edb/ref 17592186045417] [17592186329477 #edb/ref 1079 #uuid "a9517da3-5ca5-5935-9c06-686c85407828" #edb/ref 17592186045417] [17592186329813 #edb/ref 1068 #edb/ref 17592186329195 #edb/ref 17592186045417] [17592186329813 #edb/ref 1069 "q-47388" #edb/ref 17592186045417] [17592186329813 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186329813 #edb/ref 1071 "![](images/15/1534153e6a5d79400a038849b48583d2ec9a62db1fc1f52a491b751e46861f51.png)\n\nThe graph of the function $y=g(x)$ is shown above. \nApproximate ${g}^{′}(x)$ at the point $x=0$ using a forward difference approximation with step size $h=2.$" #edb/ref 17592186045417] [17592186329813 #edb/ref 1072 #uuid "43f6e718-cd5b-5458-8873-d603f1c6abcf" #edb/ref 17592186045417] [17592186329813 #edb/ref 1074 "We use the forward difference approximation\n\n$$\n{g}^{′}(x)≈\\frac{g(x+h)-g(x)}{h}\n$$\n\n \nat the point $x=0.$ Applying the above formula with $x=0$ and $h=2$ gives\n\n$$\n\\begin{aligned}{g}^{′}(0) & ≈\\frac{g(0+2)-g(0)}{2} \\\\  & =\\frac{g(2)-g(0)}{2} \\\\  & =\\frac{4-10}{2} \\\\  & =\\frac{-6}{2} \\\\  & =-3.\\end{aligned}\n$$" #edb/ref 17592186045417]}
