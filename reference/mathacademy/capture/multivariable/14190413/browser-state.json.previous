      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14190413/observations/step-q342079-186f6131622628b7cf32.png",
      "source_url": "https://mathacademy.com/tasks/14190413/topics/992/lesson",
