height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mstyle mathcolor=\"blue\"><mi>π</mi></mstyle></mpadded></mstyle></mrow></msubsup><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>π</mi></mrow></msubsup><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mstyle mathcolor=\"blue\"><msqrt><mn>2</mn></msqrt></mstyle></mpadded></mstyle></mrow></msubsup><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mstyle mathcolor=\"blue\"><msup><mi>ρ</mi><mn>5</mn></msup><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><msup><mi>sin</mi><mn>3</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>ϕ</mi></mstyle></mpadded></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>ρ</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>θ</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">d</mi></mrow><mi>ϕ</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
