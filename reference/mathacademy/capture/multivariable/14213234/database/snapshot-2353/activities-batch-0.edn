#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186167703} :activity/id #uuid "58fc78f8-8d3a-50cf-9a28-2d8426d9f197" :activity/scope {:db/id #edb/ref 17592186048979 :topic/id #uuid "d0d87d8a-8d49-55f6-80aa-919e66efaecb" :topic/math-academy-id 3253} :activity/steps [{:db/id #edb/ref 17592186167590 :step/content {:db/id #edb/ref 17592186166758 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166596 :question/id #uuid "fb41f298-ad49-5dce-819b-5ed8fab7f962" :question/math-academy-id "e-8345"} :knowledge-point/id #uuid "f360178a-5c2b-56d5-b12d-622e1aedf6ef" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049314}] :knowledge-point/questions [{:db/id #edb/ref 17592186167338} {:db/id #edb/ref 17592186167394} {:db/id #edb/ref 17592186360608} {:db/id #edb/ref 17592186360609} {:db/id #edb/ref 17592186360610} {:db/id #edb/ref 17592186360611} {:db/id #edb/ref 17592186519524}] :knowledge-point/title "Integrating Using Arcsinh"} :step/id #uuid "347cc1c3-4cbd-529a-b4ed-0b7d416fe5dc" :step/math-academy-id 31170 :step/next {:db/id #edb/ref 17592186167591}} {:db/id #edb/ref 17592186167591 :step/content {:db/id #edb/ref 17592186166759 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166597 :question/id #uuid "43e9b2da-1e6d-52b5-9312-c07d2d7a682b" :question/math-academy-id "e-8346"} :knowledge-point/id #uuid "c03f53c6-d1e5-5c54-a43f-df2fbbfb7774" :knowledge-point/questions [{:db/id #edb/ref 17592186167339} {:db/id #edb/ref 17592186167395} {:db/id #edb/ref 17592186360612} {:db/id #edb/ref 17592186360613} {:db/id #edb/ref 17592186360614} {:db/id #edb/ref 17592186360615} {:db/id #edb/ref 17592186360616} {:db/id #edb/ref 17592186360617} {:db/id #edb/ref 17592186519602}] :knowledge-point/title "Integrating Using Arcosh"} :step/id #uuid "92682fd2-413d-5454-86c3-241d087214d6" :step/math-academy-id 31171 :step/next {:db/id #edb/ref 17592186167592}} {:db/id #edb/ref 17592186167592 :step/content {:db/id #edb/ref 17592186166760 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166598 :question/id #uuid "528e7b19-3de0-5c93-8b7f-82383486eafc" :question/math-academy-id "e-8347"} :knowledge-point/id #uuid "607b412e-f875-584f-87b3-627801f20b5c" :knowledge-point/questions [{:db/id #edb/ref 17592186167340} {:db/id #edb/ref 17592186167396} {:db/id #edb/ref 17592186360618} {:db/id #edb/ref 17592186360619} {:db/id #edb/ref 17592186360620} {:db/id #edb/ref 17592186360621} {:db/id #edb/ref 17592186360622} {:db/id #edb/ref 17592186360623}] :knowledge-point/title "Integrating Using Artanh"} :step/id #uuid "a07e3608-4411-5b20-a3f8-e14096686e80" :step/math-academy-id 31172} {:db/id #edb/ref 17592186167703 :step/content {:db/id #edb/ref 17592186168093 :tutorial/content "Recall the following derivatives of the inverse hyperbolic functions:\n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}+1}}, &  & \\,x\\in (-\\infty ,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}-1}}, &  & \\,x\\in (1,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x) & =\\frac{1}{1-{x}^{2}}, &  & \\,x\\in (-1,1)\\end{aligned}\n$$\n\nSince integration is the reverse of differentiation, we arrive at the following basic integrals:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x & =\\operatorname{arsinh}⁡x+C, &  & \\,x\\in (-\\infty ,\\infty ) \\\\ \\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x & =\\operatorname{arcosh}⁡x+C, &  & \\,x\\in (1,\\infty ) \\\\ \\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x & =\\operatorname{artanh}⁡x+C, &  & \\,x\\in (-1,1)\\end{aligned}\n$$\n\nWe can now use these formulas for finding integrals. For example, let's find the integral\n\n$$\n\\int \\left(\\dfrac{5}{2\\sqrt{x^2-1}} + 2x \\right) \\textrm d x\n$$\n\nUsing the properties of integration and the formulas above, we obtain\n\n$$\n\\begin{aligned}\\int (\\frac{5}{2\\sqrt{{x}^{2}-1}}+2x)\\text{d}x & =\\frac{5}{2}\\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x+\\int 2x\\,\\text{d}x \\\\  & =\\frac{5}{2}\\operatorname{arcosh}⁡x+{x}^{2}+C.\\end{aligned}\n$$" :tutorial/id #uuid "35388b84-1b96-58fb-b1e8-46477370aa96" :tutorial/math-academy-id 5212 :tutorial/title "Introduction"} :step/id #uuid "e1dbdeed-56c4-580b-a139-6581eed4ac8a" :step/math-academy-id 32697 :step/next {:db/id #edb/ref 17592186167590}}] :activity/title "Integration Using Inverse Hyperbolic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186167020}]}
