2" :question/math-academy-id "q-95265" :question/problem "$$\n\nCalculate $\\int \\frac{\\sqrt{2}}{3(1-{x}^{2})}\\,\\text{d}x$ for $|x|<1.$" :question/worked-solution "The derivative of the inverse hyperbolic tangent function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{2}}{3(1-{x}^{2})}\\,\\text{d}x=\\frac{\\sqrt{2}}{3}\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x=\\frac{\\sqrt{2}}{3}\\operatorname{artanh}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360617 :knowledge-point/_questions [{:db/id #edb/ref 17592186166759 :knowledge-point/id #uuid "c03f53c6-d1e5-5c54-a43f-df2fbbfb7774" :knowledge-point/title "Integrating Using Arcosh"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00921b9c-3821-5a7b-a3ee-17d59e246b4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{{e}^{2}}\\operatorname{arcosh}⁡x+C" :db/id #edb/ref 17592186357756} {:answer/id #uuid "138337a3-9e56-5670-bb0e-89c11510db27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{{e}^{2}}\\operatorname{arcosh}⁡x+C" :db/id #edb/ref 17592186357918} {:answer/id #uuid "16ce7f2f-be55-58a7-bfe2-faf637cadf52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{arcosh}⁡\\frac{x}{{e}^{2}}+C" :db/id #edb/ref 17592186357950} {:answer/id #uuid "331d4867-d396-5dc9-ada2-0217eeecb8b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{{e}^{2}}\\operatorname{arsinh}⁡x+C" :db/id #edb/ref 17592186358204} {:answer/id #uuid "e6e7af3c-5908-5d8a-9843-a6c2df3f4bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arcosh}⁡\\frac{3x}{{e}^{2}}+C" :db/id #edb/ref 17592186359795}] :answer-field/correct {:answer/id #uuid "138337a3-9e56-5670-bb0e-