swer/id #uuid "578b7dec-ef64-5191-9cae-3d327ad2b856" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-{e}^{2})\\operatorname{arcosh}⁡x+C" :db/id #edb/ref 17592186358514} {:answer/id #uuid "d793769a-c9ba-55ff-944a-9a578e449764" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({e}^{2}-1)\\operatorname{artanh}⁡x+C" :db/id #edb/ref 17592186359639}] :answer-field/correct {:answer/id #uuid "519e6ee0-14fa-5b36-b38f-7d28672ea58a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-{e}^{2})\\operatorname{artanh}⁡x+C" :db/id #edb/ref 17592186358455} :answer-field/id #uuid "d2f8ffde-255a-59c3-ae91-bd2e6e6234d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360356}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6656e58d-9cf2-58cb-8d69-d187b6e20227" :question/math-academy-id "q-95652" :question/problem "$$\n\nCalculate $\\int \\frac{1-{e}^{2}}{1-{x}^{2}}\\,\\text{d}x$  for $|x|<1.$" :question/worked-solution "The derivative of the inverse hyperbolic tangent function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{1-{e}^{2}}{1-{x}^{2}}\\,\\text{d}x=(1-{e}^{2})\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x=(1-{e}^{2})\\operatorname{artanh}⁡x+C.\\end{aligned}\n$$"}]}
