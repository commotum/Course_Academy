\\operatorname{artanh}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{1-{e}^{2}}{1-{x}^{2}}\\,\\text{d}x=(1-{e}^{2})\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x=(1-{e}^{2})\\operatorname{artanh}⁡x+C.\\end{aligned}\n$$"} :step/id #uuid "5791a324-5a7e-58db-af53-d97fe8e49fad"} {:db/id #edb/ref 17592186525113 :step/content {:db/id #edb/ref 17592186360617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00921b9c-3821-5a7b-a3ee-17d59e246b4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{{e}^{2}}\\operatorname{arcosh}⁡x+C" :db/id #edb/ref 17592186357756} {:answer/id #uuid "138337a3-9e56-5670-bb0e-89c11510db27" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{{e}^{2}}\\operatorname{arcosh}⁡x+C" :db/id #edb/ref 17592186357918} {:answer/id #uuid "16ce7f2f-be55-58a7-bfe2-faf637cadf52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\operatorname{arcosh}⁡\\frac{x}{{e}^{2}}+C" :db/id #edb/ref 17592186357950} {:answer/id #uuid "331d4867-d396-5dc9-ada2-0217eeecb8b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{{e}^{2}}\\operatorname{arsinh}⁡x+C" :db/id #edb/ref 17592186358204} {:answer/id #uuid "e6e7af3c-5908-5d8a-9843-a6c2df3f4bf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcosh}⁡\\frac{3x}{{e}^{2}}+C" :db/id #edb/ref 17592186359795}] :answer-field/correct {:db/id #edb/ref 17592186357918} :answer-field/id #uuid "335143b3-11b3-5b7f-a54d-5acdae27a069" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360072}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "845b26d8-3257-53fb-bd4c-3e05a2654c1a" :question/math-academy-id "q-95651" :question/problem "$$\n\n$\\int \\frac{3}{{e}^{2}\\sqrt{{x}^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "The derivative of the inverse hyperbolic cosine function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}-1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{3}{{e}^{2}\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\frac{3}{{e}^{2}}\\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\frac{3}{{e}^{2}}\\operatorname{arcosh}⁡x+C.\\end{aligned}\n$$"} :step/id #uuid "8f8d29fb-7b44-5458-8d2c-9544a666d363" :step/next {:db/id #edb/ref 17592186525096}} {:db/id #edb/ref 17592186525132 :step/content {:db/id #edb/ref 17592186167340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03680ee2-ebc5-5006-9bd7-012b7d23b4ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{3}\\operatorname{arcosh}⁡x+C" :db/id #edb/ref 17592186357788} {:answer/id #uuid "316787bb-069c-5736-a1c1-ec0bcc4334f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{3}\\operatorname{artanh}⁡x+C" :db/id #edb/ref 17592186358190} {:answer/id #uuid "478c073f-8bb8-548f-aa11-f19b89160a01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{3}\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186358368} {:answer/id #uuid "719ceee5-3426-505e-9c91-c3ec8830ac83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{2}}{3}\\operatorname{artanh}⁡x+C" :db/id #edb/ref 17592186358744} {:answer/id #uuid "ea9756a5-441b-5e1f-b1e3-72720a72411b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{2}}{3}\\operatorname{arcosh}⁡x+C" :db/id #edb/ref 17592186359838}] :answer-field/correct {:db/id #edb/ref 17592186358190} :answer-field/id #uuid "dfdb6872-ad6b-5df9-a9a4-00fed7be26b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360392}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8b877e40-83b2-52c0-bf80-1ccb74e3d572" :question/math-academy-id "q-95265" :question/problem "$$\n\nCalculate $\\int \\frac{\\sqrt{2}}{3(1-{x}^{2})}\\,\\text{d}x$ for 