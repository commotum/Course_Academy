qrt{{x}^{2}+1}}\\,\\text{d}x=$" :question/worked-solution "The derivative of the inverse hyperbolic sine function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}+1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{{e}^{6}}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x={e}^{6}\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x={e}^{6}\\operatorname{arsinh}⁡x+C.\\end{aligned}\n$$"} :step/id #uuid "df5b6f93-2d34-5728-bd0b-f9f795729120" :step/next {:db/id #edb/ref 17592186525149}} {:db/id #edb/ref 17592186525149 :step/content {:db/id #edb/ref 17592186525024 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17c51a7f-b34d-5851-906e-2441cf3fa2b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{arsinh}⁡2x+x+C" :db/id #edb/ref 17592186524426} {:answer/id #uuid "25f06daa-ca4a-5dc5-bd3b-da45960b77ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcosh}⁡2x+x+C" :db/id #edb/ref 17592186524453} {:answer/id #uuid "2e9b8cdb-c159-5120-908b-13dd4a85f1cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{arcosh}⁡x+x+C" :db/id #edb/ref 17592186524468} {:answer/id #uuid "51c37b7d-7939-589a-acc8-fd7d126126f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{arsinh}⁡x+x+C" :db/id #edb/ref 17592186524522} {:answer/id #uuid "c5b01a17-36c9-5b62-a7f5-e79f1f6d940d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\operatorname{arcosh}⁡x+x+C" :db/id #edb/ref 17592186524699}] :answer-field/correct {:db/id #edb/ref 17592186524468} :answer-field/id #uuid "d0e7872f-98e0-55e8-bef0-ccee58ebf724" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186524932}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a85c39f1-bee3-513f-a104-f73814b0e91c" :question/math-academy-id "q-95646" :question/problem "$$\n\n$\\int (\\frac{2}{\\sqrt{{x}^{2}-1}}+1)\\text{d}x=$" :question/worked-solution "The derivative of the inverse hyperbolic cosine function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}-1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (\\frac{2}{\\sqrt{{x}^{2}-1}}+1)\\text{d}x & =2\\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x+\\int \\text{d}x \\\\  & =2\\operatorname{arcosh}⁡x+x+C.\\end{aligned}\n$$"} :step/id #uuid "fd1a936d-1667-500d-bb90-9d559b94e793" :step/next {:db/id #edb/ref 17592186525113}}] :activity/title "Integration Using Inverse Hyperbolic Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186524372}]}
