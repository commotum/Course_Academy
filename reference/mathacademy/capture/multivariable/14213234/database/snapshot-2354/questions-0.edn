2" :question/math-academy-id "q-95265" :question/problem "$$\n\nCalculate $\\int \\frac{\\sqrt{2}}{3(1-{x}^{2})}\\,\\text{d}x$ for $|x|<1.$" :question/worked-solution "The derivative of the inverse hyperbolic tangent function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{2}}{3(1-{x}^{2})}\\,\\text{d}x=\\frac{\\sqrt{2}}{3}\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x=\\frac{\\sqrt{2}}{3}\\operatorname{artanh}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186525047 :knowledge-point/_questions [{:db/id #edb/ref 17592186166758 :knowledge-point/id #uuid "f360178a-5c2b-56d5-b12d-622e1aedf6ef" :knowledge-point/title "Integrating Using Arcsinh"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1447d267-1e94-59e7-8cc2-bdf68d102cf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{6}\\operatorname{arsinh}⁡x+C" :db/id #edb/ref 17592186524420} {:answer/id #uuid "2456e542-be97-5604-8295-9ddeb7151992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{6\\operatorname{arcsin}⁡x}+C" :db/id #edb/ref 17592186524446} {:answer/id #uuid "660f35ec-7422-55ff-a4b9-a742d72bc40d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e\\operatorname{arsinh}⁡6x+C" :db/id #edb/ref 17592186524548} {:answer/id #uuid "7dc3b388-1d6a-5377-bbfd-7e690bfaab10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{6}\\operatorname{arcosh}⁡x+C" :db/id #edb/ref 17592186524579} {:answer/id #uuid "f88511bb-4494-56fe-8ace-2548c1b0cb89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{6}\\operatorname{arsinh}⁡x+C" :db/id #edb/ref 17592186524823}] :answer-field/correct {:answer/id #uuid "1447d267-1e94-59e7-8cc2-bdf68d102cf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{6}\\operatorname{arsinh}⁡x+C" :db/id #edb/ref 17592186524420} :answer-field/id #uuid "7810ca7c-722f-58fa-afb8-be8fc3259c20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524893}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d97aad73-981d-50e0-a955-015b210a6f0f" :question/math-academy-id "q-95641" :question/problem "$$\n\n$\\int \\frac{{e}^{6}}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=$" :question/worked-solution "The derivative of the inverse hyperbolic sine function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}+1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{{e}^{6}}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x={e}^{6}\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x={e}^{6}\\operatorname{arsinh}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186525024 :knowledge-point/_questions [{:db/id #edb/ref 17592186166759 :knowledge-point/id #uuid "c03f53c6-d1e5-5c54-a43f-df2fbbfb7774" :knowledge-point/title "Integrating Using Arcosh"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17c51a7f-b34d-5851-906e-2441cf3fa2b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{arsinh}⁡2x+x+C" :db/id #edb/ref 17592186524426} {:answer/id #uuid "25f06daa-ca4a-5dc5-bd3b-da45960b77ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arcosh}⁡2x+x+C" :db/id #edb/ref 17592186524453} {:answer/id #uuid "2e9b8cdb-c159-5120-908b-13dd4a85f1cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{arcosh}⁡x+x+C" :db/id #edb/ref 17592186524468} {:answer/id #uuid "51c37b7d-7939-589a-acc8-fd7d126126f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.t