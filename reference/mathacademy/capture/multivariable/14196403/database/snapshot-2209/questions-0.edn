#{[{:db/id #edb/ref 17592186315020 :knowledge-point/_questions [{:db/id #edb/ref 17592186229174 :knowledge-point/id #uuid "f30ca427-3074-56c3-828a-1327d7b172b0" :knowledge-point/title "Identifying Effects of Vertical Shifting and Horizontal Reflection on Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16acd564-8bb4-5f1c-82c3-561b03904c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{4}+1" :db/id #edb/ref 17592186312131} {:answer/id #uuid "66e3422f-b052-5204-9993-f9b920cdcc5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{a}_{4}" :db/id #edb/ref 17592186312787} {:answer/id #uuid "ac180436-b1eb-556d-a68d-e61a5de3235e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{b}_{4}" :db/id #edb/ref 17592186313323} {:answer/id #uuid "d2744563-6a41-5893-93d0-b2e699ab8ad1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{4}" :db/id #edb/ref 17592186313621} {:answer/id #uuid "f8d54e34-b41d-5b58-b634-d28765ea5ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{b}_{4}" :db/id #edb/ref 17592186313964}] :answer-field/correct {:answer/id #uuid "d2744563-6a41-5893-93d0-b2e699ab8ad1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{4}" :db/id #edb/ref 17592186313621} :answer-field/id #uuid "a57dbd7a-67e4-5987-80bd-70ad3b4f1683" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314456}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71f49ef2-3b80-5e3d-890f-74bbd2f89ef7" :question/math-academy-id "q-340782" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)\n$$\n\nLet $f(x)$ be the $2\\pi $-periodic extension of a function from $x\\in [-\\pi ,\\pi )$ to $x\\in R$ with the Fourier series shown above. What is the $4$th cosine Fourier coefficient of $f(-x)?$" :question/worked-solution "The Fourier series of $f(x)$ is\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx).\n$$\n\nRecall that the corresponding Fourier coefficients of $f(-x)$ are\n\n- ${a}_{0}$ for the constant coefficient,\n\n- ${a}_{n},$ $n\\ge 1,$ for the cosine coefficients, and\n\n- $-{b}_{n},$ $n\\ge 1,$ for the sine coefficients.\n\nTherefore, the $4$th cosine coefficient of $f(-x)$ is ${a}_{4}.$"}]}
