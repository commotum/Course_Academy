      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14178113/observations/step-q162669-8e7ba9bb17f6e18c45e8.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14178113/observations/step-q162669-8e7ba9bb17f6e18c45e8.png",
