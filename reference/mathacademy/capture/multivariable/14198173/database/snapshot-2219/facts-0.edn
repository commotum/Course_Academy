},{h}_{y},{h}_{z}⟩ \\\\ ⟨y,\\,x,\\,2z⟩ & =\\lambda ⟨-1,\\,1,\\,0⟩+\\mu ⟨2x,\\,2y,\\,2z⟩\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186401399 #edb/ref 1075 #edb/ref 17592186401400 #edb/ref 17592186045417] [17592186401399 #edb/ref 1075 #edb/ref 17592186401401 #edb/ref 17592186045417] [17592186401399 #edb/ref 1075 #edb/ref 17592186401402 #edb/ref 17592186045417] [17592186401399 #edb/ref 1075 #edb/ref 17592186401403 #edb/ref 17592186045417] [17592186401399 #edb/ref 1075 #edb/ref 17592186401404 #edb/ref 17592186045417] [17592186401399 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186401399 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186401399 #edb/ref 1078 #edb/ref 17592186401402 #edb/ref 17592186045417] [17592186401399 #edb/ref 1079 #uuid "6944c355-576e-5c8e-b344-9b3d5fd644ba" #edb/ref 17592186045417] [17592186401400 #edb/ref 1080 "$z\\,$ and $2x$" #edb/ref 17592186045417] [17592186401400 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186401400 #edb/ref 1083 #uuid "1a26a345-848a-52d6-9cff-309d48842caa" #edb/ref 17592186045417] [17592186401401 #edb/ref 1080 "$2\\,$ and $x$" #edb/ref 17592186045417] [17592186401401 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186401401 #edb/ref 1083 #uuid "0336a2fb-21ec-5932-b4bf-96df7edcc264" #edb/ref 17592186045417] [17592186401402 #edb/ref 1080 "$1\\,$ and $2z$" #edb/ref 17592186045417] [17592186401402 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186401402 #edb/ref 1083 #uuid "7d3832c6-972f-5f02-873d-640f27294ef7" #edb/ref 17592186045417] [17592186401403 #edb/ref 1080 "$1\\,$ and $2$" #edb/ref 17592186045417] [17592186401403 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186401403 #edb/ref 1083 #uuid "f73da70f-25e8-5f76-94d0-6c2f5b70918f" #edb/ref 17592186045417] [17592186401404 #edb/ref 1080 "$x\\,$ and $-y$" #edb/ref 17592186045417] [17592186401404 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 175921