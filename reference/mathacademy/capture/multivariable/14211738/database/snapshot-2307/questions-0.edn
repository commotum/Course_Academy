#{[{:db/id #edb/ref 17592186253556 :knowledge-point/_questions [{:db/id #edb/ref 17592186100943 :knowledge-point/id #uuid "a4751337-93bf-5b47-8b3f-32100820b19a" :knowledge-point/title "Identifying a Logistic Growth Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bba37af-8df4-5b8c-a930-80d2186439c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=4y(50-y)" :db/id #edb/ref 17592186251435} {:answer/id #uuid "bbe50a92-b71b-5769-a939-63ed274c1a57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=4y(50+y)" :db/id #edb/ref 17592186252210} {:answer/id #uuid "dead85fa-fe2f-53e8-b67b-e9c7315851fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=4y" :db/id #edb/ref 17592186252516} {:answer/id #uuid "fd955712-55d7-5520-b9cd-82c788b4c2f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=50-y" :db/id #edb/ref 17592186252778} {:answer/id #uuid "fe08bd02-4725-5feb-946c-394fc94ff25a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=4(50-y)" :db/id #edb/ref 17592186252781}] :answer-field/correct {:answer/id #uuid "6bba37af-8df4-5b8c-a930-80d2186439c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=4y(50-y)" :db/id #edb/ref 17592186251435} :answer-field/id #uuid "569731a1-44d9-5454-8f2b-b1754aaefd2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252956}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19423d48-c141-516d-a17c-c34914d7472c" :question/math-academy-id "q-119264" :question/problem "Which of the following differential equations is a logistic growth equation?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n\\frac{dy}{dt}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nFrom the given options, the only logistic growth equation is\n\n$$\n\\frac{dy}{dt}=4y(50-y).\n$$\n\nIn this case, the constant of proportionality is $k=4,$ and the carrying capacity is $a=50.$"}] [{:db/id #edb/ref 17592186253560 :knowledge-point/_questions [{:db/id #edb/ref 17592186100942 :knowledge-point/id #uuid "a46e688b-117f-5394-bcbb-fbfb7a5b6c7b" :knowledge-point/title "Constructing a Logistic Growth Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a356ff5-da1f-5dea-9c22-ac42a978f1f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=-0.2P(300-P)" :db/id #edb/ref 17592186250914} {:answer/id #uuid "3882ae11-e665-5f98-b13e-856ea3ff067a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=0.2P(300-P)" :db/id #edb/ref 17592186251023} {:answer/id #uuid "65ba5d91-2960-5f9c-b94f-a9c1cfb957b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=0.2P(300+P)" :db/id #edb/ref 17592186251388} {:answer/id #uuid "81afc71e-2e81-5e1d-9747-fb7bccbefe35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=300P(0.2-P)" :db/id #edb/ref 17592186251647} {:answer/id #uuid "f220ea73-cdb5-5817-8387-4873699ce350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=300P(0.2+P)" :db/id #edb/ref 17592186252671}] :answer-field/correct {:answer/id #uuid "3882ae11-e665-5f98-b13e-856ea3ff067a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=0.2P(300-P)" :db/id #edb/ref 17592186251023} :answer-field/id #uuid "225256aa-a878-5dbd-ac6b-c6508ad4090e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252866}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e07b3cd-6441-55ba-89c7-eb3d668f886b" :question/math-academy-id "q-119289" :question/problem "A pest infestation is spreading through a land with $300$ trees. The rate of growth in the number of trees $P(t)$ infected with the pest is jointly proportional to the number of trees that are infected at time $t,$ measured in months,  and the number of uninfected trees. If the constant of proportionality is $0.2,$ which differential equation could be used to model $P(t)?$" :question/worked-solution "Since the growth rate of infected trees is *jointly* proportional to the number of trees that are infected at time $t,$ and the number of uninfected trees, the number of infected trees follows a logistic growth model.\n\nA logistic growth equation has the form\n\n$$\n\\frac{dP}{dt}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nIn this case, the constant of proportionality is $k=0.2,$ and the carrying capacity is $a=300.$ Therefore, the number of trees that are infected is given by the equation\n\n$$\n\\frac{dP}{dt}=0.2P(300-P).\n$$"}] [{:db/id #edb/ref 17592186101549 :knowledge-point/_questions [{:db/id #edb/ref 17592186100943 :knowledge-point/id #uuid "a4751337-93bf-5b47-8b3f-32100820b19a" :knowledge-point/title "Identifying a Logistic Growth Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d85e959-a5d2-57fb-865e-ce7038ba9c8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=2(500-y)" :db/id #edb/ref 17592186523283} {:answer/id #uuid "3d57d462-ef3d-519d-9fd5-bf23c60439b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}