/mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">∬</mo><mi>S</mi></munder><msqrt><mn>3</mn></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>S</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>3</mn></msqrt><munder><mo data-mjx-texclass=\"OP\">∬</mo><mi>S</mi></munder><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>S</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>3</mn></msqrt><mo>⋅</mo><mtext>Area</mtext><mo stretchy=\"false\">(</mo><mi>S</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msqrt><mn>3</mn></msqrt><mo>⋅</mo><msqrt><mn>3</mn></msqrt></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>3.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
