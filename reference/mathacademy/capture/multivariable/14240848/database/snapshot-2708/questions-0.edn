#{[{:db/id #edb/ref 17592186167128 :knowledge-point/_questions [{:db/id #edb/ref 17592186166881 :knowledge-point/id #uuid "3da3cc4f-0a1d-5639-b580-95eabc198d2a" :knowledge-point/title "Computing the Flux of a Vector Field Through a Horizontal Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83738cc5-1219-53e4-93d6-345faec69645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186163847} {:answer/id #uuid "a12a7922-8eb4-5d92-9e3e-1a8d7b5d62d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186163848} {:answer/id #uuid "d5b3e9e5-8abf-5dec-a35f-5de044772de5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186163849} {:answer/id #uuid "db6f1f26-9351-585d-a665-5e9fa2429532" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186163850} {:answer/id #uuid "34f7149c-476d-5102-abff-6823eff76396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186163851}] :answer-field/correct {:answer/id #uuid "a12a7922-8eb4-5d92-9e3e-1a8d7b5d62d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186163848} :answer-field/id #uuid "b9d81c30-07ea-532f-87c1-60b50a92525b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163846}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dea0b9b2-aa9a-54da-ab21-772ddcf1f781" :question/math-academy-id "q-161152" :question/problem "Consider the vector field $F(x,y,z)=⟨z,\\,y,\\,x⟩$ and the surface $S$ defined in Cartesian coordinates as $z=1$ for $0\\le x\\le 1$ and $0\\le y\\le 1.$ Calculate the flux of $F$ through $S$ with respect to the upward-pointing unit normal vector $n.$" :question/worked-solution "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nFor the surface $z=1$ for  $0\\le x\\le 1$ and $0\\le y\\le 1,$ the upward-pointing unit normal vector is\n\n$$\nn=⟨0,\\,0,\\,1⟩.\n$$\n\nUsing the fact that $z=1$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨z,\\,y,\\,x⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =⟨1,\\,y,\\,x⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =x.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}x\\,\\text{d}S \\\\  & ={∬}_{D}x\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}x\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\text{d}y{\\int }_{0}^{1}x\\,\\text{d}x \\\\  & =1\\cdot {[\\frac{1}{2}{x}^{2}]}_{0}^{1} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186421244 :knowledge-point/_questions [{:db/id #edb/ref 17592186166881 :knowledge-point/id #uuid "3da3cc4f-0a1d-5639-b580-95eabc198d2a" :knowledge-point/title "Computing the Flux of a Vector Field Through a Horizontal Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e65dddf-58c2-5f17-8235-bfb8e2243bfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186421187} {:answer/id #uuid "5df024a4-000b-5ecc-b480-68e2ad920b0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186421191} {:answer/id #uuid "82ef2bb9-743f-5b02-a915-dfb52e0d086a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186421202} {:answer/id #uuid "958fb760-98a9-540e-9910-e0ef71c1de34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186421205} {:answer/id #uuid "9c9e92e2-eb3e-592a-a5c1-dd41305c03d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186421210}] :answer-field/correct {:answer/id #uuid "958fb760-98a9-540e-9910-e0ef71c1de34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186421205} :answer-field/id #uuid "2593ab3d-fc5b-5105-99bf-0103c2b5420d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421226}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4c6d18b-d618-53cd-9fce-a599b57a0c5a" :question/math-academy-id "q-161186" :question/problem "Consider the vector field $F(x,y,z)=⟨z,\\,y-x,\\,x+y⟩$ and the surface $S$ defined in Cartesian coordinates as $z=2$ for $0\\le x\\le 1$ and $0\\le y\\le 1.$ Calculate the flux of $F$ through $S$ with respect to the upward-pointing unit normal vector $n.$" :question/worked-solution "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nFor the surface $z=2$ for  $0\\le x\\le 1$ and $0\\le y\\le 1,$ the upward-pointing unit normal vector is\n\n$$\nn=⟨0,\\,0,\\,1⟩.\n$$\n\nUsing the fact that $z=2$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨z,\\,y-x,\\,x+y⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =⟨2,\\,y-x,\\,x+y⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =x+y.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}(x+y)\\,\\text{d}S \\\\  & ={∬}_{D}(x+y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}(x+y)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{[\\frac{{x}^{2}}{2}+xy]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}(\\frac{1}{2}+y)\\,\\text{d}y \\\\  & ={[\\frac{1}{2}\\,y+\\frac{1}{2}\\,{y}^{2}]}_{0}^{1} \\\\  & =\\frac{1}{2}+\\frac{1}{2} \\\\  & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186369880 :knowledge-point/_questions [{:db/id #edb/ref 17592186166880 :knowledge-point/id #uuid "21caaf9c-6b9b-5711-a434-21f0416e6c7e" :knowledge-point/title "Rewriting a Flux Integral as a Surface Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4db4d76a-1cbf-546e-9910-5eefab212094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-z" :db/id #edb/ref 17592186369882} {:answer/id #uuid "93b13355-74c7-5944-8894-d63214e49d4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2{y}^{2}" :db/id #edb/ref 17592186369883} {:answer/id #uuid "ad64ad66-1217-56c6-9f34-a805076c7edc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{y}^{2}+xz-z" :db/id #edb/ref 17592186369884} {:answer/id #uuid "dd863173-56c4-5d31-b3b2-62ef6fc703dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2{y}^{2}-z" :db/id #edb/ref 17592186369885} {:answer/id #uuid "2c311ac1-0e02-53d0-b880-29d744c3e07c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-2xz" :db/id #edb/ref 17592186369886}] :answer-field/correct {:answer/id #uuid "4db4d76a-1cbf-546e-9910-5eefab212094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-z" :db/id #edb/ref 17592186369882} :answer-field/id #uuid "4b0fb886-3e02-5fa7-af49-6e0fc64fadf4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369881}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6c94dc83-cb78-54c3-8e1e-5cf36cded66a" :question/math-academy-id "q-161201" :question/problem "Consider the vector field $F$ and the surface $S$ with unit normal vector $n,$ where\n\n$$\nF(x,y,z)=⟨{x}^{2}+{y}^{2},\\,xz,\\,z+{y}^{2}⟩\\,,\\,n(x,y,z)=\\frac{1}{\\sqrt{2}}⟨1,\\,0,\\,-1⟩\\,.\n$$\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S=\\frac{1}{\\sqrt{2}}{∬}_{S}\\boxed{}\\,\\text{d}S,\n$$\n\nwhat is the missing expression?" :question/worked-solution "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nCalculating the dot product, we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨{x}^{2}+{y}^{2},\\,xz,\\,z+{y}^{2}⟩\\cdot \\frac{1}{\\sqrt{2}}⟨1,\\,0,\\,-1⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨{x}^{2}+{y}^{2},\\,xz,\\,z+{y}^{2}⟩\\cdot ⟨1,\\,0,\\,-1⟩ \\\\  & =\\frac{1}{\\sqrt{2}}(({x}^{2}+{y}^{2})+0-(z+{y}^{2})) \\\\  & =\\frac{{x}^{2}-z}{\\sqrt{2}}.\\end{aligned}\n$$\n\nTherefore, the flux can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}\\frac{{x}^{2}-z}{\\sqrt{2}}\\,\\text{d}S \\\\  & =\\frac{1}{\\sqrt{2}}{∬}_{S}{x}^{2}-z\\,\\text{d}S.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186167131 :knowledge-point/_questions [{:db/id #edb/ref 17592186166881 :knowledge-point/id #uuid "3da3cc4f-0a1d-5639-b580-95eabc198d2a" :knowledge-point/title "Computing the Flux of a Vector Field Through a Horizontal Plane"} {:db/id #edb/ref 17592186166882 :knowledge-point/id #uuid "f9a62365-4278-557f-ba76-caa31abe7869" :knowledge-point/title "Computing the Flux of a Vector Field Through a Tilted Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd556fd2-277f-5c8e-9b21-8802757469bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186163865} {:answer/id #uuid "d8fcef11-1d4a-5fc1-89d3-3c46337f10b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186163866} {:answer/id #uuid "db2a56e3-5b85-5f3d-b99f-327b814e5837" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186163867} {:answer/id #uuid "0a5d670d-a079-52a1-be8c-383c7e35c122" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186163868} {:answer/id #uuid "602bdb6d-95e4-538b-b0ed-dcf372ecf31a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186163869}] :answer-field/correct {:answer/id #uuid "602bdb6d-95e4-538b-b0ed-dcf372ecf31a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186163869} :answer-field/id #uuid "15b2ef6c-c409-5bdc-8c17-bfe2e3100c8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163864}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d42bef6-ce15-55df-885d-72410b164f1c" :question/math-academy-id "q-162146" :question/problem "Consider the vector field $F(x,y,z)=⟨x,\\,y,\\,z+3⟩$ and a finite region $S$ of the plane $z=x+y$ such that $\\text{Area}(S)=\\sqrt{3}.$ Calculate the flux of $F$ through $S$ with respect to the upward-pointing unit normal vector $n.$" :question/worked-solution "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that our surface $z=x+y$ can be written using the dot product as \n\n$$\n⟨x,\\,y,\\,z⟩\\cdot {{⟨-1,\\,-1,\\,1⟩}_{⏟}}_{\\overset{~}{n}}=0,\\,\\text{or}\\,⟨x,\\,y,\\,z⟩\\cdot {{⟨1,\\,1,\\,-1⟩}_{⏟}}_{-\\overset{~}{n}}=0.\n$$\n\nSince we require an upward-pointing normal vector to our surface $S,$ we must select one where the $z$-component is positive. This gives us the normal vector\n\n$$\n\\overset{~}{n}=⟨-1,\\,-1,\\,1⟩.\n$$\n\nNormalizing this vector, we get\n\n$$\n\\begin{aligned}n & =\\frac{\\overset{~}{n}}{‖\\overset{~}{n}‖} \\\\  & =\\frac{⟨-1,\\,-1,\\,1⟩}{\\sqrt{(-1)^{2}+(-1)^{2}+{1}^{2}}} \\\\  & =\\frac{1}{\\sqrt{3}}⟨-1,\\,-1,\\,1⟩.\\end{aligned}\n$$\n\nUsing the fact that $z=x+y$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨x,\\,y,\\,z+3⟩\\cdot \\frac{1}{\\sqrt{3}}⟨-1,\\,-1,\\,1⟩ \\\\  & =\\frac{1}{\\sqrt{3}}⟨x,\\,y,\\,x+y+3⟩\\cdot ⟨-1,\\,-1,\\,1⟩ \\\\  & =\\frac{1}{\\sqrt{3}}(-x-y+(x+y+3)) \\\\  & =\\frac{3}{\\sqrt{3}} \\\\  & =\\sqrt{3}.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}\\sqrt{3}\\,\\text{d}S \\\\  & =\\sqrt{3}{∬}_{S}\\,\\text{d}S \\\\  & =\\sqrt{3}\\cdot \\text{Area}(S) \\\\  & =\\sqrt{3}\\cdot \\sqrt{3} \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323828 :knowledge-point/_questions [{:db/id #edb/ref 17592186166881 :knowledge-point/id #uuid "3da3cc4f-0a1d-5639-b580-95eabc198d2a" :knowledge-point/title "Computing the Flux of a Vector Field Through a Horizontal Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f952bca-a066-5bf9-a97c-515d3fe42d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186321515} {:answer/id #uuid "43026d0f-f21f-5932-94ad-740c584e5b0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186321677} {:answer/id #uuid "9ad76f32-878d-5906-b59b-e08f667cf2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186322376} {:answer/id #uuid "e38f54d9-6db5-595a-a0bd-7f54f38a189a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186322927} {:answer/id #uuid "e61e4c06-d5fa-5f07-8cf1-a2b931de2e10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186322948}] :answer-field/correct {:answer/id #uuid "2f952bca-a066-5bf9-a97c-515d3fe42d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186321515} :answer-field/id #uuid "56691dec-7751-59ca-8f7f-effa3fd14823" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323336}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d45c5c95-c352-5bfc-96a4-e8c0f7bd9595" :question/math-academy-id "q-365878" :question/problem "Consider the vector field $F(x,y,z)=⟨y,\\,z,\\,2x⟩$ and the surface $S$ defined in Cartesian coordinates as $z=2$ for $0\\le x\\le 3$ and $0\\le y\\le 2.$ Calculate the flux of $F$ through $S$ with respect to the upward-pointing unit normal vector $n.$" :question/worked-solution "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nFor the surface $z=2$ for $0\\le x\\le 3$ and $0\\le y\\le 2,$ the upward-pointing unit normal vector is\n\n$$\nn=⟨0,\\,0,\\,1⟩.\n$$\n\nUsing the fact that $z=2$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨y,\\,z,\\,2x⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =⟨y,\\,2,\\,2x⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =2x.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}2x\\,\\text{d}S \\\\  & ={∬}_{D}2x\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{3}2x\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\text{d}y{\\int }_{0}^{3}2x\\,\\text{d}x \\\\  & =2\\cdot {[{x}^{2}]}_{0}^{3} \\\\  & =18\\end{aligned}\n$$"}]}
