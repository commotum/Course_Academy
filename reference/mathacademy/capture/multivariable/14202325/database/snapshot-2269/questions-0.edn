tegrating Using Arcsinh"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a00e31e-1977-504e-b499-bb7f381e5cbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arcosh}⁡x+C" :db/id #edb/ref 17592186358386} {:answer/id #uuid "719474d3-dd38-5073-b844-1f469dfad2f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arsinh}⁡x+C" :db/id #edb/ref 17592186358743} {:answer/id #uuid "acce9897-8b9a-5ba4-99e8-ed88700531a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}\\operatorname{arsinh}⁡x+C" :db/id #edb/ref 17592186359244} {:answer/id #uuid "bf3cb5d3-4cb1-5414-a4fd-8896888b94da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}\\operatorname{arcosh}⁡x+C" :db/id #edb/ref 17592186359425} {:answer/id #uuid "dc6c88a3-14b0-5472-ae9c-ec83891d5b63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}\\operatorname{arsinh}⁡x+C" :db/id #edb/ref 17592186359686}] :answer-field/correct {:answer/id #uuid "719474d3-dd38-5073-b844-1f469dfad2f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arsinh}⁡x+C" :db/id #edb/ref 17592186358743} :answer-field/id #uuid "addfbe2b-c5f6-56c9-a6f0-958f997f581f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360299}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "92342467-8e42-53ef-8468-95fef40d584b" :question/math-academy-id "q-95630" :question/problem "$$\n\n$\\int \\frac{\\sqrt{2}}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=$" :question/worked-solution "The derivative of the inverse hyperbolic sine function is given by\n\n$$\n\\frac{\\text{d}