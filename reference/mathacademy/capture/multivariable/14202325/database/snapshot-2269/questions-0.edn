#{[{:db/id #edb/ref 17592186166596 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166758 :knowledge-point/id #uuid "f360178a-5c2b-56d5-b12d-622e1aedf6ef" :knowledge-point/title "Integrating Using Arcsinh"}] :question/id #uuid "fb41f298-ad49-5dce-819b-5ed8fab7f962" :question/math-academy-id "e-8345" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\displaystyle \\int \\dfrac{-3}{\\sqrt{x^2+1}}\\,\\textrm d x=$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe derivative of the inverse hyperbolic sine function is given by\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arsinh x) = \\dfrac{1}{\\sqrt{x^2+1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{-3}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=-3\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=-3\\text{\\arsinh}x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166597 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166759 :knowledge-point/id #uuid "c03f53c6-d1e5-5c54-a43f-df2fbbfb7774" :knowledge-point/title "Integrating Using Arcosh"}] :question/id #uuid "43e9b2da-1e6d-52b5-9312-c07d2d7a682b" :question/math-academy-id "e-8346" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\displaystyle \\int \\dfrac{\\ln{\\pi}}{\\sqrt{x^2-1}}\\,\\textrm d x=$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe derivative of the inverse hyperbolic cosine function is given by\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcosh x) = \\dfrac{1}{\\sqrt{x^2-1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡\\pi }{\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\operatorname{ln}⁡\\pi \\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\operatorname{ln}⁡\\pi \\text{\\arcosh}x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166598 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166760 :knowledge-point/id #uuid "607b412e-f875-584f-87b3-627801f20b5c" :knowledge-point/title "Integrating Using Artanh"}] :question/id #uuid "528e7b19-3de0-5c93-8b7f-82383486eafc" :question/math-academy-id "e-8347" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nCalculate $\\displaystyle \\int \\dfrac{1}{2(1-x^2)}\\,\\textrm d x$ for $|x|< 1.$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe derivative of the inverse hyperbolic tangent function is given by\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\artanh x) = \\dfrac{1}{1-x^2}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{1}{2(1-{x}^{2})}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x=\\frac{1}{2}\\,\\text{\\artanh}x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186167338 :knowledge-point/_questions [{:db/id #edb/ref 17592186166758 :knowledge-point/id #uuid "f360178a-5c2b-56d5-b12d-622e1aedf6ef" :knowledge-point/title "Integrating Using Arcsinh"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d570f9a-6f80-5694-ac2a-6cdd22d79226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{arcosh}⁡x+C" :db/id #edb/ref 17592186357862} {:answer/id #uuid "2052fd6d-0ba2-508b-ac71-5e2d67cf18e0" :answer/type {:db/id #edb/ref 17592186045498