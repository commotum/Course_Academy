\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}+1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{2}}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=\\sqrt{2}\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=\\sqrt{2}\\operatorname{arsinh}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360610 #edb/ref 1068 #edb/ref 17592186360109 #edb/ref 17592186045417] [17592186360610 #edb/ref 1069 "q-95639" #edb/ref 17592186045417] [17592186360610 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360610 #edb/ref 1071 "$$\n\n$\\int \\frac{\\sqrt{2}+1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186360610 #edb/ref 1072 #uuid "57a86446-8a8a-579c-ab6b-0108201455ff" #edb/ref 17592186045417] [17592186360610 #edb/ref 1074 "The derivative of the inverse hyperbolic sine function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}+1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{2}+1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=(\\sqrt{2}+1)\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=(\\sqrt{2}+1)\\operatorname{arsinh}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360611 #edb/ref 1068 #edb/ref 17592186360039 #edb/ref 17592186045417] [17592186360611 #edb/ref 1069 "q-95642" #edb/ref 17592186045417] [17592186360611 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360611 #edb/ref 1071 "$$\n\n$\\int (\\operatorname{cosh}⁡x-\\frac{5}{\\sqrt{{x}^{2}+1}})\\text{d}x=$" #edb/ref 17592186045417] [17592186360611 #edb/ref 1072 #uuid "2ed2766f-124b-5427-8fb1-ae118be1949d" #edb/ref 17592186045417] [17592186360611 #edb/ref 1074 "The derivative of the inverse hyperbolic sine function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}+1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (\\operatorname{cosh}⁡x-\\frac{5}{\\sqrt{{x}^{2}+1}})\\text{d}x & =\\int \\operatorname{cosh}⁡x\\,\\text{d}x-5\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x \\\\  & =\\operatorname{sinh}⁡x-5\\operatorname{arsinh}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360614 #edb/ref 1068 #edb/ref 17592186360305 #edb/ref 17592186045417] [17592186360614 #edb/ref 1069 "q-95647" #edb/ref 17592186045417] [17592186360614 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360614 #edb/ref 1071 "$$\n\n$\\int (6{x}^{2}-\\frac{3}{\\sqrt{{x}^{2}-1}})\\text{d}x=$" #edb/ref 17592186045417] [17592186360614 #edb/ref 1072 #uuid "5c39ca03-7ee9-5ebd-a4bf-747c05b5be03" #edb/ref 17592186045417] [17592186360614 #edb/ref 1074 "The derivative of the inverse hyperbolic cosine function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}-1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (6{x}^{2}-\\frac{3}{\\sqrt{{x}^{2}-1}})\\text{d}x & =6\\int {x}^{2}\\,\\text{d}x-3\\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =2{x}^{3}-3\\operatorname{arcosh}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360615 #edb/ref 1068 #edb/ref 17592186360111 #edb/ref 17592186045417] [17592186360615 #edb/ref 1069 "q-95648" #edb/ref 17592186045417] [17592186360615 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360615 #edb/ref 1071 "$$\n\n$\\int (2x-\\frac{5}{\\sqrt{{x}^{2}-1}})\\text{d}x=$" #edb/ref 17592186045417] [17592186360615 #edb/ref 1072 #uuid "9d5147d8-1416-5d48-9be9-af19b3ac5103" #edb/ref 17592186045417] [17592186360615 #edb/ref 1074 "The derivative of the inverse hyperbolic cosine function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}-1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2x-\\frac{5}{\\sqrt{{x}^{2}-1}})\\text{d}x & =2\\int x\\,\\text{d}x-5\\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & ={x}^{2}-5\\operatorname{arcosh}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360616 #edb/ref 1068 #edb/ref 17592186360046 #edb/ref 17592186045417] [17592186360616 #edb/ref 1069 "q-95649" #edb/ref 17592186045417] [17592186360616 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360616 #edb/ref 1071 "$$\n\n$\\int \\frac{-\\sqrt{3}}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186360616 #edb/ref 1072 #uuid "14d16d9e-325c-5c77-9043-aad75e4a2114" #edb/ref 17592186045417] [17592186360616 #edb/ref 1074 "The derivative of the inverse hyperbolic cosine function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}-1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{-\\sqrt{3}}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x=-\\sqrt{3}\\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x=-\\sqrt{3}\\operatorname{arcosh}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360620 #edb/ref 1068 #edb/ref 17592186360125 #edb/ref 17592186045417] [17592186360620 #edb/ref 1069 "q-95654" #edb/ref 17592186045417] [17592186360620 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360620 #edb/ref 1071 "$$\n\nCalculate $\\int \\frac{e-\\operatorname{ln}⁡7}{1-{x}^{2}}\\,\\text{d}x$  for $|x|<1.$" #edb/ref 17592186045417] [17592186360620 #edb/ref 1072 #uuid "0927a6a9-6856-57e2-9abc-385995506419" #edb/ref 17592186045417] [17592186360620 #edb/ref 1074 "The derivative of the inverse hyperbolic tangent function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{e-\\operatorname{ln}⁡7}{1-{x}^{2}}\\,\\text{d}x=(e-\\operatorname{ln}⁡7)\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x=(e-\\operatorname{ln}⁡7)\\operatorname{artanh}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360621 #edb/ref 1068 #edb/ref 17592186360166 #edb/ref 17592186045417] [17592186360621 #edb/ref 1069 "q-95659" #edb/ref 17592186045417] [17592186360621 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360621 #edb/ref 1071 "$$\n\nCalculate $\\int (\\frac{\\sqrt{5}}{4(1-{x}^{2})}+4x)\\text{d}x$  for $|x|<1.$" #edb/ref 17592186045417] [17592186360621 #edb/ref 1072 #uuid "cf5120f0-aec7-506c-8e33-1a2f96bf93b8" #edb/ref 17592186045417] [17592186360621 #edb/ref 1074 "The derivative of the inverse hyperbolic tangent function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (\\frac{\\sqrt{5}}{4(1-{x}^{2})}+4x)\\text{d}x & =\\frac{\\sqrt{5}}{4}\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x+4\\int x\\,\\text{d}x \\\\  & =\\frac{\\sqrt{5}}{4}\\operatorname{artanh}⁡x+2{x}^{2}+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360622 #edb/ref 1068 #edb/ref 17592186360280 #edb/ref 17592186045417] [17592186360622 #edb/ref 1069 "q-95662" #edb/ref 17592186045417] [17592186360622 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360622 #edb/ref 1071 "$$\n\nCalculate $\\int ({e}^{x}-\\frac{6}{\\operatorname{ln}⁡5(1-{x}^{2})})\\text{d}x$  for $|x|<1.$" #edb/ref 17592186045417] [17592186360622 #edb/ref 1072 #uuid "d04962ba-4270-5731-b8e6-91ba55c0a97e" #edb/ref 17592186045417] [17592186360622 #edb/ref 1074 "The derivative of the inverse hyperbolic tangent function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int ({e}^{x}-\\frac{6}{\\operatorname{ln}⁡5(1-{x}^{2})})\\text{d}x & =\\int {e}^{x}\\,\\text{d}x-\\frac{6}{\\operatorname{ln}⁡5}\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x \\\\  & ={e}^{x}-\\frac{6}{\\operatorname{ln}⁡5}\\operatorname{artanh}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360623 #edb/ref 1068 #edb/ref 17592186360276 #edb/ref 17592186045417] [17592186360623 #edb/ref 1069 "q-95666" #edb/ref 17592186045417] [17592186360623 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360623 #edb/ref 1071 "$$\n\nCalculate $\\int \\frac{\\operatorname{arsinh}⁡2}{2(1-{x}^{2})}\\,\\text{d}x$  for $|x|<1.$" #edb/ref 17592186045417] [17592186360623 #edb/ref 1072 #uuid "3398159c-7550-5418-b497-18665d2c7eeb" #edb/ref 17592186045417] [17592186360623 #edb/ref 1074 "The derivative of the inverse hyperbolic tangent function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{arsinh}⁡2}{2(1-{x}^{2})}\\,\\text{d}x=\\frac{\\operatorname{arsinh}⁡2}{2}\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x=\\frac{\\operatorname{arsinh}⁡2}{2}\\,\\operatorname{artanh}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417]}
