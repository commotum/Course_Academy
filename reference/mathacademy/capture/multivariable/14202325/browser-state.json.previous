  "live_records": {
    "q-95630": {
      "dom_id": "step-q95630",
      "name": "Question 1",
      "problem": "$$\n\n$\\int \\frac{\\sqrt{2}}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=$",
      "worked_solution": "The derivative of the inverse hyperbolic sine function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}+1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{2}}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=\\sqrt{2}\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=\\sqrt{2}\\operatorname{arsinh}⁡x+C.\\end{aligned}\n$$",
      "calculator_instructions": "",
