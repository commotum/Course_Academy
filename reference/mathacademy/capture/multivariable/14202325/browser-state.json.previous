 displaystyle=\"true\" columnalign=\"right\" columnspacing=\"\" rowspacing=\"3pt\"><mtr><mtd><mo data-mjx-texclass=\"OP\">∫</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo>−</mo><msqrt><mn>3</mn></msqrt></mrow><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></msqrt></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi><mo>=</mo><mo>−</mo><msqrt><mn>3</mn></msqrt><mo data-mjx-texclass=\"OP\">∫</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></msqrt></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi><mo>=</mo><mo>−</mo><msqrt><mn>3</mn></msqrt><mi>arcosh</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow><mo>+</mo><mi>C</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
