#{[17592186105857 #edb/ref 1038 #edb/ref 17592186106303 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186106452 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186233545 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186233759 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186234000 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186235412 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186311782 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186311783 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186311784 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186311785 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186311786 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186320803 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186362357 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186402402 #edb/ref 17592186045417] [17592186105857 #edb/ref 1038 #edb/ref 17592186402675 #edb/ref 17592186045417] [17592186105857 #edb/ref 1039 "Computing the Limit at Infinity of a General Polynomial" #edb/ref 17592186045417] [17592186105857 #edb/ref 1041 #edb/ref 17592186105576 #edb/ref 17592186045417] [17592186105857 #edb/ref 1042 #uuid "fc04f720-28f3-55ab-8e89-582db57672a4" #edb/ref 17592186045417] [17592186105950 #edb/ref 1043 #edb/ref 17592186106560 #edb/ref 17592186045417] [17592186105950 #edb/ref 1043 #edb/ref 17592186106561 #edb/ref 17592186045417] [17592186105950 #edb/ref 1043 #edb/ref 17592186106747 #edb/ref 17592186045417] [17592186105950 #edb/ref 1043 #edb/ref 17592186106812 #edb/ref 17592186045417] [17592186105950 #edb/ref 1043 #edb/ref 17592186106813 #edb/ref 17592186045417] [17592186105950 #edb/ref 1043 #edb/ref 17592186106818 #edb/ref 17592186045417] [17592186105950 #edb/ref 1043 #edb/ref 17592186