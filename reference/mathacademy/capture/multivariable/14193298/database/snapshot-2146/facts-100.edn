235181 #edb/ref 1078 #edb/ref 17592186507776 #edb/ref 17592186045417] [17592186235181 #edb/ref 1079 #uuid "a892bf8e-c9e4-57ea-ad2b-6c218780734b" #edb/ref 17592186045417] [17592186235198 #edb/ref 1075 #edb/ref 17592186234558 #edb/ref 17592186045417] [17592186235198 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186235198 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186235198 #edb/ref 1078 #edb/ref 17592186234558 #edb/ref 17592186045417] [17592186235198 #edb/ref 1079 #uuid "b85a4080-2302-5992-a9bd-3396c92df00a" #edb/ref 17592186045417] [17592186235249 #edb/ref 1075 #edb/ref 17592186234737 #edb/ref 17592186045417] [17592186235249 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186235249 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186235249 #edb/ref 1078 #edb/ref 17592186234737 #edb/ref 17592186045417] [17592186235249 #edb/ref 1079 #uuid "e5afd119-69de-52dd-bdca-4830c6ed3835" #edb/ref 17592186045417] [17592186235252 #edb/ref 1075 #edb/ref 17592186234736 #edb/ref 17592186045417] [17592186235252 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186235252 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186235252 #edb/ref 1078 #edb/ref 17592186234736 #edb/ref 17592186045417] [17592186235252 #edb/ref 1079 #uuid "e9ec9cce-dc2d-5159-b443-5beee65e20c2" #edb/ref 17592186045417] [17592186235294 #edb/ref 1084 #edb/ref 17592186235584 #edb/ref 17592186045417] [17592186235294 #edb/ref 1084 #edb/ref 17592186235591 #edb/ref 17592186045417] [17592186235294 #edb/ref 1084 #edb/ref 17592186235617 #edb/ref 17592186045417] [17592186235294 #edb/ref 1084 #edb/ref 17592186235652 #edb/ref 17592186045417] [17592186235294 #edb/ref 1084 #edb/ref 17592186235662 #edb/ref 17592186045417] [17592186235294 #edb/ref 1084 #edb/ref 17592186235669 #edb/ref 17592186045417] [17592186235294 #edb/ref 1084 #edb/ref 17592186235676 #edb/ref 17592186045417] [17592186235294 #edb/ref 1084 #edb/ref 17592186235720 #edb/ref 17592186045417] [17592186235294 #edb/ref 1084 #edb/ref 17592186235761 #edb/ref 17592186045417] [17592186235294 #edb/ref 1085 "Consider the quadratic function $f(x)=4-{x}^{2}.$" #edb/ref 17592186045417] [17592186235294 #edb/ref 1086 #uuid "42564b7c-0444-5256-983f-c909d16148da" #edb/ref 17592186045417] [17592186235294 #edb/ref 1087 #edb/ref 17592186235676 #edb/ref 17592186045417] [17592186235328 #edb/ref 1062 #uuid "54ecb7c4-25d7-5c63-9bc0-16f73f1075b7" #edb/ref 17592186045417] [17592186235328 #edb/ref 1063 #edb/ref 17592186234970 #edb/ref 17592186045417] [17592186235412 #edb/ref 1068 #edb/ref 17592186235181 #edb/ref 17592186045417] [17592186235412 #edb/ref 1069 "q-166216" #edb/ref 17592186045417] [17592186235412 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186235412 #edb/ref 1071 "Find ${lim}_{x\\to \\,\\infty }f(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,\\infty }f(x)=$\n{{field-1}}" #edb/ref 17592186045417] [17592186235412 #edb/ref 1072 #uuid "b221e8c4-69db-5e20-be69-868f9b7c5a63" #edb/ref 17592186045417] [17592186235412 #edb/ref 1074 "We identify the leading term of the polynomial and compute its limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\infty }(4-{x}^{2}) & ={lim}_{x\\to \\,\\infty }(-{x}^{2}) \\\\  & =-{lim}_{x\\to \\,\\infty }({x}^{2}) \\\\  & =-(\\infty ) \\\\  & =-\\infty \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186235413 #edb/ref 1068 #edb/ref 17592186235012 #edb/ref 17592186045417] [17592186235413 #edb/ref 1069 "q-166217" #edb/ref 17592186045417] [17592186235413 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186235413 #edb/ref 1071 "Evaluate ${lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{2}-\\sqrt{x}}{f(x)}.$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{2}-\\sqrt{x}}{f(x)}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186235413 #edb/ref 1072 #uuid "a0368281-0923-5f2f-a12f-1b2966a9564d" #edb/ref 17592186045417] [17592186235413 #edb/ref 1074 "If we attempt to evaluate the limit directly by substituting $x=2,$ we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{2}-\\sqrt{x}}{f(x)} & ={lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{2}-\\sqrt{x}}{4-{x}^{2}} \\\\  & =\\frac{\\sqrt{2}-\\sqrt{2}}{4-{2}^{2}} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since there is a radical in the numerator, we can evaluate the limit by first multiplying the numerator and the denominator by the conjugate of the numerator:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{2}-\\sqrt{x}}{f(x)} & ={lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{2}-\\sqrt{x}}{4-{x}^{2}} \\\\  & ={lim}_{x\\to \\,{2}^{+}}\\frac{(\\sqrt{2}-\\sqrt{x})(\\sqrt{2}+\\sqrt{x})}{(4-{x}^{2})(\\sqrt{2}+\\sqrt{x})} \\\\  & ={lim}_{x\\to \\,{2}^{+}}\\frac{2-x}{(2+x)(2-x)(\\sqrt{2}+\\sqrt{x})} \\\\  & ={lim}_{x\\to \\,{2}^{+}}\\frac{\\cancel{2-x}}{(2+x)\\cancel{(2-x)}(\\sqrt{2}+\\sqrt{x})} \\\\  & ={lim}_{x\\to \\,{2}^{+}}\\frac{1}{(2+x)(\\sqrt{2}+\\sqrt{x})} \\\\  & =\\frac{1}{(2+2)(\\sqrt{2}+\\sqrt{2})} \\\\  & =\\frac{1}{4(2\\sqrt{2})} \\\\  & =\\frac{1}{8\\sqrt{2}}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186235414 #edb/ref 1068 #edb/ref 17592186235070 #edb/ref 17592186045417] [17592186235414 #edb/ref 1069 "q-166218" #edb/ref 17592186045417] [17592186235414 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186235414 #edb/ref 1071 "The instantaneous rate of change of $f(x)$ at $x=2$ is given by\n\n${f}^{′}(2)={lim}_{x\\to \\,2}\\frac{f(x)-f(2)}{x-2}=-{lim}_{x\\to \\,2}(x\\,+$\n{{field-1}} \n$).$" #edb/ref 17592186045417] [17592186235414 #edb/ref 1072 #uuid "9bc4e764-dc18-56f6-860a-c9afcd11a034" #edb/ref 17592186045417] [17592186235414 #edb/ref 1074 "Simplifying the expression under the limit, we get\n\n$$\n\\begin{aligned}{f}^{′}(2) & ={lim}_{x\\to \\,2}\\frac{f(x)-f(2)}{x-2} \\\\  & ={lim}_{x\\to \\,2}\\frac{[4-{x}^{2}]-[4-{2}^{2}]}{x-2} \\\\  & ={lim}_{x\\to \\,2}\\frac{4-{x}^{2}}{x-2} \\\\  & ={lim}_{x\\to \\,2}\\frac{-({x}^{2}-4)}{x-2} \\\\  & ={lim}_{x\\to \\,2}\\frac{-(x+2)(x-2)}{x-2} \\\\  & ={lim}_{x\\to \\,2}\\frac{-(x+2)\\cancel{(x-2)}}{\\cancel{x-2}} \\\\  & =-{lim}_{x\\to \\,2}(x+2).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186235415 #edb/ref 1068 #edb/ref 17592186235140 #edb/ref 17592186045417] [17592186235415 #edb/ref 1069 "q-166219" #edb/ref 17592186045417] [17592186235415 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186235415 #edb/ref 1071 "$-{lim}_{x\\to \\,2}\\,(x+2)=${{field-1}}" #edb/ref 17592186045417] [17592186235415 #edb/ref 1072 #uuid "9532d675-5b68-52dd-87cd-d926b113aa76" #edb/ref 17592186045417] [17592186235415 #edb/ref 1074 "We first apply the sum rule, and then apply the constant rule and compute the limits of the power functions:\n\n$$\n\\begin{aligned}-{lim}_{x\\to \\,2}\\,(x+2) & =-{lim}_{x\\to \\,2}x-{lim}_{x\\to \\,2}2 \\\\  & =-2-2 \\\\  & =-4\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186235416 #edb/ref 1068 #edb/ref 17592186235198 #edb/ref 17592186045417] [17592186235416 #edb/ref 1069 "q-166220" #edb/ref 17592186045417] [17592186235416 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186235416 #edb/ref 1071 "The derivative of $f(x)$ is defined by\n\n$\\frac{\\text{d}f}{\\text{d}x}={lim}_{h\\to \\,0}\\frac{f(x+h)-f(x)}{h}={lim}_{h\\to \\,0}($\n{{field-1}} \n$-\\,h\\,).$" #edb/ref 17592186045417] [17592186235416 #edb/ref 1072 #uuid "3aa27ea3-65f2-56d9-8495-c13d6eac67fe" #edb/ref 17592186045417] [17592186235416 #edb/ref 1074 "Simplifying the expression under the limit, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & ={lim}_{h\\to \\,0}\\frac{f(x+h)-f(x)}{h} \\\\  & ={lim}_{h\\to \\,0}\\frac{4-(x+h)^{2}-[4-{x}^{2}]}{h} \\\\  & ={lim}_{h\\to \\,0}\\frac{4-{x}^{2}-2xh-{h}^{2}-4+{x}^{2}}{h} \\\\  & ={lim}_{h\\to \\,0}\\frac{-2xh-{h}^{2}}{h} \\\\  & ={lim}_{h\\to \\,0}\\frac{h(-2x-h)}{h} \\\\  & ={lim}_{h\\to \\,0}\\frac{\\cancel{h}(-2x-h)}{\\cancel{h}} \\\\  & ={lim}_{h\\to \\,0}(-2x-h).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186235417 #edb/ref 1068 #edb/ref 17592186235252 #edb/ref 17592186045417] [17592186235417 #edb/ref 1069 "q-166221" #edb/ref 17592186045417] [17592186235417 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186235417 #edb/ref 1071 "${f}^{′}(x)={lim}_{h\\to \\,0}(-2x-h)=${{field-1}}" #edb/ref 17592186045417] [17592186235417 #edb/ref 1072 #uuid "d279edb6-3312-5b4a-9920-2d9bebd67de9" #edb/ref 17592186045417] [17592186235417 #edb/ref 1074 "We first apply the sum rule, and then apply the constant rule and compute the limits of the power functions:\n\n$$\n\\begin{aligned}{lim}_{h\\to \\,0}(-2x-h) & ={lim}_{h\\to \\,0}(-2x)-{lim}_{h\\to \\,0}h \\\\  & =-2x{lim}_{h\\to \\,0}1-{lim}_{h\\to \\,0}h \\\\  & =-2x-0 \\\\  & =-2x\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186235418 #edb/ref 1068 #edb/ref 17592186235018 #edb/ref 17592186045417] [17592186235418 #edb/ref 1069 "q-166222" #edb/ref 17592186045417] [17592186235418 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186235418 #edb/ref 1071 "![](images/19/19d0c50eff5613451c833c00e2d151b93ca5d7e490366fc811d6730e383227de.png)\n\nThe graph of $y=f(x)$ is shown above (not drawn to scale). Estimate the area $A$ using a right Riemann sum with step size $Δx=0.5.$\n\n$A\\,≈\\,$\n{{field-1}}" #edb/ref 17592186045417] [17592186235418 #edb/ref 1072 #uuid "556ca87e-4786-545d-b41a-8a1cbf358c98" #edb/ref 17592186045417] [17592186235418 #edb/ref 1074 "Let's sketch our situation.\n\n![](images/e1/e13444351bb092ced6fc788ae921622f154a267e9544e928700736a53a259fc6.png)\n\nThe area $A$ under the graph can be approximated using the right Riemann sum with step size $Δx=0.5,$ as follows:\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{f(0.5)+f(1)+f(1.5)+f(2)}})\\cdot {{Δx}_{⏟}}_{\\text{width}}\n$$\n\nSo, we now set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $0.5$ | $1$ | $1.5$ | $2$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $3.75$ | $3$ | $1.75$ | $0$ |\n\nFinally, we obtain the following approximation for our area:\n\n$$\n\\begin{aligned}A & ≈(3.75+3+1.75+0)\\cdot 0.5 \\\\  & =8.5\\cdot 0.5 \\\\  & =4.25\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186235419 #edb/ref 1068 #edb/ref 17592186235150 #edb/ref 17592186045417] [17592186235419 #edb/ref 1069 "q-166223" #edb/ref 17592186045417] [17592186235419 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186235419 #edb/ref 1071 "Write the expression for the Riemann sum from part 7 in sigma notation.\n\nThe right Riemann sum $\\,=\\,0.5{\\sum }_{i=1}^{4}(4-$  \n{{field-1}} ${i}^{2})$" #edb/ref 17592186045417] [17592186235419 #edb/ref 1072 #uuid "eb5a242b-1e53-5003-a0a3-796a8596af21" #edb/ref 17592186045417] [17592186235419 #edb/ref 1074 "The right Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{\\sum }_{i=1}^{n}f({x}_{i})Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ and $Δx=\\frac{b-a}{n}.$ \n\nIn our case, we have $n=4$ subintervals, $a=0,$ $b=2,$ and $Δx=0.5.$\n\nTherefore, using sigma notation, the right Riemann sum can be expressed as\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}f({x}_{i})Δx & ={\\sum }_{i=1}^{n}f(a+iΔx)Δx \\\\  & ={\\sum }_{i=1}^{4}f(0+i\\cdot 0.5)\\cdot 0.5 \\\\  & =0.5{\\sum }_{i=1}^{4}f(0.5i) \\\\  & =0.5{\\sum }_{i=1}^{4}(4-{(0.5i)}^{2}) \\\\  & =0.5{\\sum }_{i=1}^{4}(4-0.25{i}^{2}).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186235420 #edb/ref 1068 #edb/ref 17592186235004 #edb/ref 17592186045417] [17592186235420 #edb/ref 1068 #edb/ref 17592186235026 #edb/ref 17592186045417] [17592186235420 #edb/ref 1068 #edb/ref 17592186235249 #edb/ref 17592186045417] [17592186235420 #edb/ref 1069 "q-166224" #edb/ref 17592186045417] [17592186235420 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186235420 #edb/ref 1071 "The exact value of the area $A$ from part 7 can be expressed using definite integral notation as\n\n$A={\\int }_{a}^{b}$\n{{field-1}}\n$\\text{d}x,\\,\\,$ where  \n$a\\,=\\,$\n{{field-2}}\n$\\,$ and $\\,b\\,=\\,$\n{{field-3}}" #edb/ref 17592186045417] [17592186235420 #edb/ref 1072 #uuid "5b9ceb5b-f036-574e-9859-535ce65a4a0c" #edb/ref 17592186045417] [17592186235420 #edb/ref 1074 "We can express the area $A$ as the definite integral of \n\n$$\nf(x)=4-{x}^{2}\n$$\n\nbetween \n\n* the lower limit $x=0,$ and \n\n* the upper limit $x=2.$ \n\nThis gives\n\n$$\nA={\\int }_{0}^{2}4-{x}^{2}\\,\\text{d}x.\n$$" #edb/ref 17592186045417] [17592186235584 #edb/ref 1058 #edb/ref 17592186235669 #edb/ref 17592186045417] [17592186235584 #edb/ref 1062 #uuid "0106719e-654b-54c8-b009-c0ab65f2c372" #edb/ref 17592186045417] [17592186235584 #edb/ref 1063 #edb/ref 17592186235417 #edb/ref 17592186045417] [17592186235591 #edb/ref 1058 #edb/ref 17592186235662 #edb/ref 17592186045417] [17592186235591 #edb/ref 1062 #uuid "0ac2db8a-b828-5d40-a4d8-859afa481dee" #edb/ref 17592186045417] [17592186235591 #edb/ref 1063 #edb/ref 17592186235413 #edb/ref 17592186045417] [17592186235617 #edb/ref 1058 #edb/ref 17592186235584 #edb/ref 17592186045417] [17592186235617 #edb/ref 1062 #uuid "2af65687-fb58-50a8-912c-1fde7139fe8a" #edb/ref 17592186045417] [17592186235617 #edb/ref 1063 #edb/ref 17592186235416 #edb/ref 17592186045417] [17592186235652 #edb/ref 1058 #edb/ref 17592186235720 #edb/ref 17592186045417] [17592186235652 #edb/ref 1062 #uuid "504d2b11-8108-55f6-aa0b-df38f79404ad" #edb/ref 17592186045417] [17592186235652 #edb/ref 1063 #edb/ref 17592186235419 #edb/ref 17592186045417] [17592186235662 #edb/ref 1058 #edb/ref 17592186235761 #edb/ref 17592186045417] [17592186235662 #edb/ref 1062 #uuid "5e07b6cc-1a75-594b-b9ca-3705666904cc" #edb/ref 17592186045417] [17592186235662 #edb/ref 1063 #edb/ref 17592186235414 #edb/ref 17592186045417] [17592186235669 #edb/ref 1058 #edb/ref 17592186235652 #edb/ref 17592186045417] [17592186235669 #edb/ref 106