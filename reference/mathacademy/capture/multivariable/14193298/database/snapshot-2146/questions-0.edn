#{[{:db/id #edb/ref 17592186235412 :knowledge-point/_questions [{:db/id #edb/ref 17592186105857 :knowledge-point/id #uuid "fc04f720-28f3-55ab-8e89-582db57672a4" :knowledge-point/title "Computing the Limit at Infinity of a General Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35adfae7-cfb3-5400-9c3e-f01dc70d91cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186234633} {:answer/id #uuid "7bb5d9a6-29d0-523a-bf1e-a8d90f76c3e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186507776}] :answer-field/correct {:answer/id #uuid "7bb5d9a6-29d0-523a-bf1e-a8d90f76c3e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186507776} :answer-field/id #uuid "a892bf8e-c9e4-57ea-ad2b-6c218780734b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235181}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b221e8c4-69db-5e20-be69-868f9b7c5a63" :question/math-academy-id "q-166216" :question/problem "Find ${lim}_{x\\to \\,\\infty }f(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,\\infty }f(x)=$\n{{field-1}}" :question/worked-solution "We identify the leading term of the polynomial and compute its limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\infty }(4-{x}^{2}) & ={lim}_{x\\to \\,\\infty }(-{x}^{2}) \\\\  & =-{lim}_{x\\to \\,\\infty }({x}^{2}) \\\\  & =-(\\infty ) \\\\  & =-\\infty \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235413 :knowledge-point/_questions [{:db/id #edb/ref 17592186078536 :knowledge-point/id #uuid "a441c8ef-b5b3-5438-97b9-53e4eb7b2d75" :knowledge-point/title "Calculating the Limit of a Rational Function with a Radical in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76667ac7-f6c6-58d4-bd9e-a6762c6d0cbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8\\sqrt{2}}" :db/id #edb/ref 17592186234727} {:answer/id #uuid "a0781cd4-b883-570b-8c0c-22df23deadc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{16}" :db/id #edb/ref 17592186507825}] :answer-field/correct {:answer/id #uuid "a0781cd4-b883-570b-8c0c-22df23deadc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{16}" :db/id #edb/ref 17592186507825} :answer-field/id #uuid "27e43f7d-1c68-5a21-b361-28360a1ccbff" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235012}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0368281-0923-5f2f-a12f-1b2966a9564d" :question/math-academy-id "q-166217" :question/problem "Evaluate ${lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{2}-\\sqrt{x}}{f(x)}.$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{2}-\\sqrt{x}}{f(x)}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit directly by substituting $x=2,$ we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{2}-\\sqrt{x}}{f(x)} & ={lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{2}-\\sqrt{x}}{4-{x}^{2}} \\\\  & =\\frac{\\sqrt{2}-\\sqrt{2}}{4-{2}^{2}} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since there is a radical in the numerator, we can evaluate the limit by first multiplying the numerator and the denominator by the conjugate of the numerator:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{2}-\\sqrt{x}}{f(x)} & ={lim}_{x\\to \\,{2}^{+}}\\frac{\\sqrt{2}-\\sqrt{x}}{4-{x}^{2}} \\\\  & ={lim}_{x\\to \\,{2}^{+}}\\frac{(\\sqrt{2}-\\sqrt{x})(\\sqrt{2}+\\sqrt{x})}{(4-{x}^{2})(\\sqrt{2}+\\sqrt{x})} \\\\  & ={lim}_{x\\to \\,{2}^{+}}\\frac{2-x}{(2+x)(2-x)(\\sqrt{2}+\\sqrt{x})} \\\\  & ={lim}_{x\\to \\,{2}^{+}}\\frac{\\cancel{2-x}}{(2+x)\\cancel{(2-x)}(\\sqrt{2}+\\sqrt{x})} \\\\  & ={lim}_{x\\to \\,{2}^{+}}\\frac{1}{(2+x)(\\sqrt{2}+\\sqrt{x})} \\\\  & =\\frac{1}{(2+2)(\\sqrt{2}+\\sqrt{2})} \\\\  & =\\frac{1}{4(2\\sqrt{2})} \\\\  & =\\frac{1}{8\\sqrt{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235414 :knowledge-point/_questions [{:db/id #edb/ref 17592186064337 :knowledge-point/id #uuid "f8f2e684-6cd8-5ede-9f70-1a24ada54cb9" :knowledge-point/title "Calculating the Instantaneous Rate of Change of a Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c12a1895-e957-5b34-b4ce-0ac5a1298794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234847}] :answer-field/correct {:answer/id #uuid "c12a1895-e957-5b34-b4ce-0ac5a1298794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234847} :answer-field/id #uuid "5e583577-6633-5a8c-851d-7de25d84338a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235070}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9bc4e764-dc18-56f6-860a-c9afcd11a034" :question/math-academy-id "q-166218" :question/problem "The instantaneous rate of change of $f(x)$ at $x=2$ is given by\n\n${f}^{′}(2)={lim}_{x\\to \\,2}\\frac{f(x)-f(2)}{x-2}=-{lim}_{x\\to \\,2}(x\\,+$\n{{field-1}} \n$).$" :question/worked-solution "Simplifying the expression under the limit, we get\n\n$$\n\\begin{aligned}{f}^{′}(2) & ={lim}_{x\\to \\,2}\\frac{f(x)-f(2)}{x-2} \\\\  & ={lim}_{x\\to \\,2}\\frac{[4-{x}^{2}]-[4-{2}^{2}]}{x-2} \\\\  & ={lim}_{x\\to \\,2}\\frac{4-{x}^{2}}{x-2} \\\\  & ={lim}_{x\\to \\,2}\\frac{-({x}^{2}-4)}{x-2} \\\\  & ={lim}_{x\\to \\,2}\\frac{-(x+2)(x-2)}{x-2} \\\\  & ={lim}_{x\\to \\,2}\\frac{-(x+2)\\cancel{(x-2)}}{\\cancel{x-2}} \\\\  & =-{lim}_{x\\to \\,2}(x+2).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235415 :knowledge-point/_questions [{:db/id #edb/ref 17592186124468 :knowledge-point/id #uuid "dad9bdc2-a243-5437-8904-9906c2d9a90e" :knowledge-point/title "Applying the Sum Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18fb9d9a-61c6-5061-a406-5172d8f85964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186234579}] :answer-field/correct {:answer/id #uuid "18fb9d9a-61c6-5061-a406-5172d8f85964" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186234579} :answer-field/id #uuid "8728e103-6de3-5e4b-9786-846ef09a8aef" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235140}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9532d675-5b68-52dd-87cd-d926b113aa76" :question/math-academy-id "q-166219" :question/problem "$-{lim}_{x\\to \\,2}\\,(x+2)=${{field-1}}" :question/worked-solution "We first apply the sum rule, and then apply the constant rule and compute the limits of the power functions:\n\n$$\n\\begin{aligned}-{lim}_{x\\to \\,2}\\,(x+2) & =-{lim}_{x\\to \\,2}x-{lim}_{x\\to \\,2}2 \\\\  & =-2-2 \\\\  & =-4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235416 :knowledge-point/_questions [{:db/id #edb/ref 17592186087881 :knowledge-point/id #uuid "9c6f3c71-d11b-59af-bad6-5f5c0ff6634f" :knowledge-point/title "Calculating the Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07e8cbcd-bbd6-548c-85e5-0754c40cd84e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x" :db/id #edb/ref 17592186234558}] :answer-field/correct {:answer/id #uuid "07e8cbcd-bbd6-548c-85e5-0754c40cd84e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x" :db/id #edb/ref 17592186234558} :answer-field/id #uuid "b85a4080-2302-5992-a9bd-3396c92df00a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235198}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3aa27ea3-65f2-56d9-8495-c13d6eac67fe" :question/math-academy-id "q-166220" :question/problem "The derivative of $f(x)$ is defined by\n\n$\\frac{\\text{d}f}{\\text{d}x}={lim}_{h\\to \\,0}\\frac{f(x+h)-f(x)}{h}={lim}_{h\\to \\,0}($\n{{field-1}} \n$-\\,h\\,).$" :question/worked-solution "Simplifying the expression under the limit, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & ={lim}_{h\\to \\,0}\\frac{f(x+h)-f(x)}{h} \\\\  & ={lim}_{h\\to \\,0}\\frac{4-(x+h)^{2}-[4-{x}^{2}]}{h} \\\\  & ={lim}_{h\\to \\,0}\\frac{4-{x}^{2}-2xh-{h}^{2}-4+{x}^{2}}{h} \\\\  & ={lim}_{h\\to \\,0}\\frac{-2xh-{h}^{2}}{h} \\\\  & ={lim}_{h\\to \\,0}\\frac{h(-2x-h)}{h} \\\\  & ={lim}_{h\\to \\,0}\\frac{\\cancel{h}(-2x-h)}{\\cancel{h}} \\\\  & ={lim}_{h\\to \\,0}(-2x-h).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235417 :knowledge-point/_questions [{:db/id #edb/ref 17592186124468 :knowledge-point/id #uuid "dad9bdc2-a243-5437-8904-9906c2d9a90e" :knowledge-point/title "Applying the Sum Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c662922-94e4-5b57-b8f8-dfab5fc987d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x" :db/id #edb/ref 17592186234736}] :answer-field/correct {:answer/id #uuid "7c662922-94e4-5b57-b8f8-dfab5fc987d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x" :db/id #edb/ref 17592186234736} :answer-field/id #uuid "e9ec9cce-dc2d-5159-b443-5beee65e20c2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235252}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d279edb6-3312-5b4a-9920-2d9bebd67de9" :question/math-academy-id "q-166221" :question/problem "${f}^{′}(x)={lim}_{h\\to \\,0}(-2x-h)=${{field-1}}" :question/worked-solution "We first apply the sum rule, and then apply the constant rule and compute the limits of the power functions:\n\n$$\n\\begin{aligned}{lim}_{h\\to \\,0}(-2x-h) & ={lim}_{h\\to \\,0}(-2x)-{lim}_{h\\to \\,0}h \\\\  & =-2x{lim}_{h\\to \\,0}1-{lim}_{h\\to \\,0}h \\\\  & =-2x-0 \\\\  & =-2x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235418 :knowledge-point/_questions [{:db/id #edb/ref 17592186105721 :knowledge-point/id #uuid "5f0efa50-9154-5cf3-bf01-e1b6eead489d" :knowledge-point/title "Using the Right Riemann Sum With Regular Step Size"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7fa3559-f3f9-549f-95bd-ef5299d3f930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.25" :db/id #edb/ref 17592186234828}] :answer-field/correct {:answer/id #uuid "b7fa3559-f3f9-549f-95bd-ef5299d3f930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.25" :db/id #edb/ref 17592186234828} :answer-field/id #uuid "2d2f4761-b6ec-5474-9517-2650b58218cf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235018}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "556ca87e-4786-545d-b41a-8a1cbf358c98" :question/math-academy-id "q-166222" :question/problem "![](images/19/19d0c50eff5613451c833c00e2d151b93ca5d7e490366fc811d6730e383227de.png)\n\nThe graph of $y=f(x)$ is shown above (not drawn to scale). Estimate the area $A$ using a right Riemann sum with step size $Δx=0.5.$\n\n$A\\,≈\\,$\n{{field-1}}" :question/worked-solution "Let's sketch our situation.\n\n![](images/e1/e13444351bb092ced6fc788ae921622f154a267e9544e928700736a53a259fc6.png)\n\nThe area $A$ under the graph can be approximated using the right Riemann sum with step size $Δx=0.5,$ as follows:\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{f(0.5)+f(1)+f(1.5)+f(2)}})\\cdot {{Δx}_{⏟}}_{\\text{width}}\n$$\n\nSo, we now set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $0.5$ | $1$ | $1.5$ | $2$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $3.75$ | $3$ | $1.75$ | $0$ |\n\nFinally, we obtain the following approximation for our area:\n\n$$\n\\begin{aligned}A & ≈(3.75+3+1.75+0)\\cdot 0.5 \\\\  & =8.5\\cdot 0.5 \\\\  & =4.25\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235419 :knowledge-point/_questions [{:db/id #edb/ref 17592186096629 :knowledge-point/id #uuid "8d01d6ed-1c25-5170-a1ad-7a4fa0103db7" :knowledge-point/title "Expressing a Right Riemann Sum in Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0e020d5-f4e7-569e-afef-71f67242b4b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186234844}] :answer-field/correct {:answer/id #uuid "c0e020d5-f4e7-569e-afef-71f67242b4b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186234844} :answer-field/id #uuid "931f2f8b-3f23-5824-8aee-b4294dbb52d8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235150}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eb5a242b-1e53-5003-a0a3-796a8596af21" :question/math-academy-id "q-166223" :question/problem "Write the expression for the Riemann sum from part 7 in sigma notation.\n\nThe right Riemann sum $\\,=\\,0.5{\\sum }_{i=1}^{4}(4-$  \n{{field-1}} ${i}^{2})$" :question/worked-solution "The right Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{\\sum }_{i=1}^{n}f({x}_{i})Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ and $Δx=\\frac{b-a}{n}.$ \n\nIn our case, we have $n=4$ subintervals, $a=0,$ $b=2,$ and $Δx=0.5.$\n\nTherefore, using sigma notation, the right Riemann sum can be expressed as\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}f({x}_{i})Δx & ={\\sum }_{i=1}^{n}f(a+iΔx)Δx \\\\  & ={\\sum }_{i=1}^{4}f(0+i\\cdot 0.5)\\cdot 0.5 \\\\  & =0.5{\\sum }_{i=1}^{4}f(0.5i) \\\\  & =0.5{\\sum }_{i=1}^{4}(4-{(0.5i)}^{2}) \\\\  & =0.5{\\sum }_{i=1}^{4}(4-0.25{i}^{2}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235420 :knowledge-point/_questions [{:db/id #edb/ref 17592186096630 :knowledge-point/id #uuid "89902023-09e6-50cd-b08a-9d3e82d826c9" :knowledge-point/title "Writing the Area Bounded by a Curve as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cece0155-163c-5458-a8db-34b5221175b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186234872}] :answer-field/correct {:answer/id #uuid "cece0155-163c-5458-a8db-34b5221175b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186234872} :answer-field/id #uuid "2173113b-d0a2-5410-b6c7-e8618e133698" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235004} {:answer-field/choices [{:answer/id #uuid "d9f01435-5894-5e71-8e36-f9f9e3e8a828" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-{x}^{2}" :db/id #edb/ref 17592186234888} {:answer/id #uuid "c590c56f-2ce8-56b4-a40f-e206402a78d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-x^{2}" :db/id #edb/ref 17592186507873}] :answer-field/correct {:answer/id #uuid "c590c56f-2ce8-56b4-a40f-e206402a78d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-x^{2}" :db/id #edb/ref 17592186507873} :answer-field/id #uuid "34afb644-8878-5d45-b490-16232bb8797c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235026} {:answer-field/choices [{:answer/id #uuid "7e39628f-85d4-5259-9f94-e69051ea96c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234737}] :answer-field/correct {:answer/id #uuid "7e39628f-85d4-5259-9f94-e69051ea96c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234737} :answer-field/id #uuid "e5afd119-69de-52dd-bdca-4830c6ed3835" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235249}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b9ceb5b-f036-574e-9859-535ce65a4a0c" :question/math-academy-id "q-166224" :question/problem "The exact value of the area $A$ from part 7 can be expressed using definite integral notation as\n\n$A={\\int }_{a}^{b}$\n{{field-1}}\n$\\text{d}x,\\,\\,$ where  \n$a\\,=\\,$\n{{field-2}}\n$\\,$ and $\\,b\\,=\\,$\n{{field-3}}" :question/worked-solution "We can express the area $A$ as the definite integral of \n\n$$\nf(x)=4-{x}^{2}\n$$\n\nbetween \n\n* the lower limit $x=0,$ and \n\n* the upper limit $x=2.$ \n\nThis gives\n\n$$\nA={\\int }_{0}^{2}4-{x}^{2}\\,\\text{d}x.\n$$"}]}
