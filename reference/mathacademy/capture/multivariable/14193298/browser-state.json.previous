jx-mn></mjx-num><mjx-dbox><mjx-dtable><mjx-line type=\"d\"></mjx-line><mjx-row><mjx-den><mjx-dstrut type=\"d\"></mjx-dstrut><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-den></mjx-row></mjx-dtable></mjx-dbox></mjx-frac></mjx-mfrac></mjx-mstyle><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.3em\"><mtr><mtd><munder><mo data-mjx-texclass=\"OP\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo stretchy=\"false\">→</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msup><mn>2</mn><mo>+</mo></msup></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msqrt><mn>2</mn></msqrt><mo>−</mo><msqrt><mi>x</mi></msqrt></mrow><mrow><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mo stretchy=\"false\">→</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msup><mn>2</mn><mo>+</mo></msup></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msqrt><mn>2</mn></msqrt><mo>−</mo><msqrt><mi>x</mi></msqrt></mrow><mrow><mn>4</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msqrt><mn>2</mn></msqrt><mo>−</mo><msqrt><mn>2</mn></msqrt></mrow><mrow><mn>4</mn><mo>−</mo><msup><mn>2</mn><mn>2</mn></msup></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>0</mn><mn>0</mn></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>So, we need to first simplify the limit. Since there is a radical in the numerator, we can evaluate the limit by first multiplying the numerator and the denominator by the conjugate of the numerator:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"29\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 22.164em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-munder><mjx-row><mjx-base style=\"padding-left: 0.345em;\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c6C\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c6D\"></mjx-c></mjx-mo></mjx-base></mjx-row><mjx-row><mjx-under style=\"padding-top: 0.167em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mstyle style=\"font-size: 141.4%;\"><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-msup><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-script style=\"vertical-align: 0.289em;\"><mjx-mo class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo></mjx-script></mjx-msup></mjx-texatom></mjx-under></mjx-row></mjx-munder><mjx-mstyle space=\"2\"><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mrow><mjx-msqrt><mjx-sqrt><mjx-surd><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c221A\"></mjx-c></mjx-mo></mjx-surd><mjx-box style=\"padding-top: 0.174em;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-box></mjx-sqrt></mjx-msqrt><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-msqrt space=\"3\"><mjx-sqrt><mjx-su