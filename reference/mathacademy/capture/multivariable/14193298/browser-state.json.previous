      "html": "<div id=\"question-166223\" class=\"question\">                                \n                        <div id=\"question-166223-text\" class=\"questionText\">      \n                            \n                            <!--<span style=\"font-weight: bold; margin-right: 10px;\">h.</span>-->\n\n                            <div id=\"question-166223-graphic\" class=\"questionGraphic\">\n                                \n                            </div>   \n\n\n                            Write the expression for the Riemann sum from part 7 in sigma notation.\n\n                            \n                                    \n                                        \n                                            <div class=\"freeResponse\">\n                                                <div class=\"freeResponseLine\">\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        The right Riemann sum <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"18\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mstyle space=\"4\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-munderover space=\"2\"><mjx-over style=\"padding-bottom: 0.2em; padding-left: 0.545em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn></mjx-over><mjx-box><mjx-munder><mjx-row><mjx-base><mj