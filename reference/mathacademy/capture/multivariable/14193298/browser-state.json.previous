      "html": "<div id=\"question-166220\" class=\"question\">                                \n                        <div id=\"question-166220-text\" class=\"questionText\">      \n                            \n                            <!--<span style=\"font-weight: bold; margin-right: 10px;\">e.</span>-->\n\n                            <div id=\"question-166220-graphic\" class=\"questionGraphic\">\n                                \n                            </div>   \n\n\n                            The derivative of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"10\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container> is defined by\n\n                            \n                                    \n                                        \n                                            <div class=\"freeResponse\">\n                                                <div class=\"freeResponseLine\">\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"11\" style=\"font-size: 113.1%; posi