ac{1}{\\sqrt{2}} \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n\\frac{1}{\\sqrt{2}}{x}_{1}+\\frac{1}{\\sqrt{2}}{x}_{2}=0\\,⟹\\,{x}_{1}+{x}_{2}=0,\n$$\n\nwe get the general solution \n\n$$\n[\\begin{aligned}-{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}{{[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{1}}+{x}_{3}{{[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{2}$ and ${x}_{3}$ are free variables.\n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are mutually orthogonal. Therefore, we only need to normalize them. This gives the second and third columns of $U:$   \n\n$$\n{u}_{2}=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{aligned}]\\,{u}_{3}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} & 0 \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & 0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186423864 #edb/ref 1068 #edb/ref 17592186423825 #edb/ref 17592186045417] [17592186423864 #edb/ref 1069 "q-98767" #edb/ref 17592186045417] [17592186423864 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186423864 #edb/ref 1071 "$$\nA=[\\begin{aligned}0 & 2 \\\\ -2 & 0 \\\\ -4 & -4\\end{aligned}],\\,Σ=[\\begin{aligned}6 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" #edb/ref 17592186045417] [17592186423864 #edb/ref 1072 #uuid "bfd2aceb-4fd0-5447-93c2-1fcb15c8449b" #edb/ref 17592186045417] [17592186423864 #edb/ref 1074 "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=6$ and ${\\sigma }_{2}=2.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{6}[\\begin{aligned}0 & 2 \\\\ -2 & 0 \\\\ -4 & -4\\end{aligned}][\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}\\frac{2}{\\sqrt{2}} \\\\ -\\frac{2}{\\sqrt{2}} \\\\ -\\frac{8}{\\sqrt{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{4}{3\\sqrt{2}}\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{2}[\\begin{aligned}0 & 2 \\\\ -2 & 0 \\\\ -4 & -4\\end{aligned}][\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}\\frac{2}{\\sqrt{2}} \\\\ \\frac{2}{\\sqrt{2}} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0,\\end{aligned}\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\{\\begin{aligned}\\frac{1}{3\\sqrt{2}}{x}_{1}-\\frac{1}{3\\sqrt{2}}{x}_{2}-\\frac{4}{3\\sqrt{2}}{x}_{3}=0 \\\\ \\frac{1}{\\sqrt{2}}{x}_{1}+\\frac{1}{\\sqrt{2}}{x}_{2}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{x}_{1}-{x}_{2}-4{x}_{3}=0 \\\\ {x}_{1}+{x}_{2}=0,\\end{aligned}\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=[\\begin{aligned}\\frac{2}{3} \\\\ -\\frac{2}{3} \\\\ \\frac{1}{3}\\end{aligned}].\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=[\\begin{aligned}\\frac{1}{3\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & \\frac{2}{3} \\\\ -\\frac{1}{3\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & -\\frac{2}{3} \\\\ -\\frac{4}{3\\sqrt{2}} & 0 & \\frac{1}{3}\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186423865 #edb/ref 1068 #edb/ref 17592186423841 #edb/ref 17592186045417] [17592186423865 #edb/ref 1069 "q-98649" #edb/ref 17592186045417] [17592186423865 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186423865 #edb/ref 1071 "$$\nA=[\\begin{aligned}1 & 1 \\\\ 0 & 0 \\\\ -1 & -1\\end{aligned}],\\,Σ=[\\begin{aligned}2 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrix $V?$" #edb/ref 17592186045417] [17592186423865 #edb/ref 1072 #uuid "c92aa209-5a56-5e1a-928c-2b1064eaf495" #edb/ref 17592186045417] [17592186423865 #edb/ref 1074 "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nLet's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}1 & 1 \\\\ 0 & 0 \\\\ -1 & -1\\end{aligned}]}^{T}[\\begin{aligned}1 & 1 \\\\ 0 & 0 \\\\ -1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & -1 \\\\ 1 & 0 & -1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 0 & 0 \\\\ -1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 2 \\\\ 2 & 2\\end{aligned}]\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $Σ,$ we deduce that ${\\sigma }_{1}=2$ and ${\\sigma }_{2}=0.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=4,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-4I & =[\\begin{aligned}2 & 2 \\\\ 2 & 2\\end{aligned}]-4[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-2 & 2 \\\\ 2 & -2\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-4I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{1}=[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=0,$ we have \n\n$$\n\\begin{aligned}{A}^{T}\\,A-0I & =[\\begin{aligned}2 & 2 \\\\ 2 & 2\\end{aligned}]-0[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}2 & 2 \\\\ 2 & 2\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-0I)v=0$ gives the unit eigenvector\n\n$$\n{v}_{2}=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}].\n$$\n\nFinally, we construct the matrix $V:$ \n\n$$\nV=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$" #edb/ref 17592186045417]}
