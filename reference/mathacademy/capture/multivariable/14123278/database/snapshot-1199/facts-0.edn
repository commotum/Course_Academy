 17592186045417] [17592186162858 #edb/ref 1062 #uuid "0ede58be-b8d2-5bb7-a17c-e74da723f67c" #edb/ref 17592186045417] [17592186162858 #edb/ref 1063 #edb/ref 17592186163233 #edb/ref 17592186045417] [17592186162945 #edb/ref 1058 #edb/ref 17592186162947 #edb/ref 17592186045417] [17592186162945 #edb/ref 1061 648292 #edb/ref 17592186045417] [17592186162945 #edb/ref 1062 #uuid "93a722c1-3bdf-59db-908f-c5d0b209511b" #edb/ref 17592186045417] [17592186162945 #edb/ref 1063 #edb/ref 17592186162041 #edb/ref 17592186045417] [17592186162946 #edb/ref 1058 #edb/ref 17592186162951 #edb/ref 17592186045417] [17592186162946 #edb/ref 1061 648298 #edb/ref 17592186045417] [17592186162946 #edb/ref 1062 #uuid "2a223abd-811a-561b-aba4-561597ec202e" #edb/ref 17592186045417] [17592186162946 #edb/ref 1063 #edb/ref 17592186162042 #edb/ref 17592186045417] [17592186162947 #edb/ref 1058 #edb/ref 17592186385970 #edb/ref 17592186045417] [17592186162947 #edb/ref 1061 648295 #edb/ref 17592186045417] [17592186162947 #edb/ref 1062 #uuid "1b7070be-3dac-5359-9175-8300793c3568" #edb/ref 17592186045417] [17592186162947 #edb/ref 1063 #edb/ref 17592186162043 #edb/ref 17592186045417] [17592186162948 #edb/ref 1061 648304 #edb/ref 17592186045417] [17592186162948 #edb/ref 1062 #uuid "e87c19a4-7e24-5962-880c-39d60fa71758" #edb/ref 17592186045417] [17592186162948 #edb/ref 1063 #edb/ref 17592186163258 #edb/ref 17592186045417] [17592186162951 #edb/ref 1058 #edb/ref 17592186162948 #edb/ref 17592186045417] [17592186162951 #edb/ref 1061 648301 #edb/ref 17592186045417] [17592186162951 #edb/ref 1062 #uuid "7cf890cb-057f-5300-9a99-426e3fb959db" #edb/ref 17592186045417] [17592186162951 #edb/ref 1063 #edb/ref 17592186162045 #edb/ref 17592186045417] [17592186163233 #edb/ref 1064 "We can compute a singular value decomposition (SVD) of any matrix! The algorithm for computing an SVD of a rectangular $m\\times n$ matrix $(m\\neq n)$ is similar to the algorithm for square matrices.\n\nAs an example, let's consider the matrix $A,$ given by\n\n$$A = [\\begin{aligned}1 & 1 \\\\ -1 & 1 \\\\ 1 & 1\\end{aligned}].$$\n\nNotice that $A$ is a ${\\color{blue}{3}}\\times {\\color{red}{2}}$ matrix. So, to compute the SVD of $A,$ we must write\n\n$$A=U \\Sigma V^T,$$\n\nwhere\n\n- $\\Sigma$ is a ${\\color{blue}{3}}\\times {\\color{red}{2}}$ matrix with the singular values of $A$ (ordered from largest to smallest) on the main diagonal and zeroes outside the main diagonal,\n- $U$ is an orthogonal ${\\color{blue}{3}} \\times {\\color{blue}{3}}$ matrix,\n- $V$ is an orthogonal ${\\color{red}{2}} \\times {\\color{red}{2}}$ matrix.\n\nWe proceed as follows:\n\n- **Step 1.** Compute $A^T \\! A\\mathbin{:}$ $$\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}1 & 1 \\\\ -1 & 1 \\\\ 1 & 1\\end{aligned}]}^{T}[\\begin{aligned}1 & 1 \\\\ -1 & 1 \\\\ 1 & 1\\end{aligned}] \\\\ & =[\\begin{aligned}1 & -1 & 1 \\\\ 1 & 1 & 1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ -1 & 1 \\\\ 1 & 1\\end{aligned}] \\\\ & =[\\begin{aligned}3 & 1 \\\\ 1 & 3\\end{aligned}]\\end{aligned}$$\n- **Step 2.** Find the singular values of $A.$ Computing the eigenvalues of $A^TA,$ we get $$\\lambda_1 = 4, \\qquad \\lambda_2 = 2.$$ Therefore, the singular values of $A$ are $$\\sigma_1 = \\sqrt{\\lambda_1} = 2, \\qquad \\sigma_2 = \\sqrt{\\lambda_2} = \\sqrt{2}.$$\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of $A^T A$). Seeking non-zero solutions of $(A^T \\! A - \\lambda_1 I)\\mathbf{v}=\\mathbf{0}$ and $(A^T \\! A - \\lambda_2 I)\\mathbf{v}=\\mathbf{0}$ gives the unit eigenvectors $$\\mathbf{v}_1 = [\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}], \\qquad \\mathbf{v}_2 = [\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}].$$\n- **Step 4.** Find the left singular vectors of $A.$ Since we know the singular values and right singular vectors, we can compute the first two columns of $U$ as follows:\n\n- First, we compute $\\mathbf u_1\\mathbin{:}$ $$\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\ & =\\frac{1}{2}[\\begin{aligned}1 & 1 \\\\ -1 & 1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\ & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]\\end{aligned}$$\n- Then, we compute $\\mathbf u_2\\mathbin{:}$ $$\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\ & =\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 & 1 \\\\ -1 & 1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\ & =[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]\\end{aligned}$$\n\n- The matrix $U$ is a $3\\times 3$ matrix. However, we do not have the third singular value, so we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector $$\\mathbf{u}_3 =[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$$ such that $${\\begin{aligned}{u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0,\\end{aligned} \\qquad \\|\\mathbf{u}_3\\|=1.$$ Solving this system, we get the following nonzero normalized solution:\n$$\\begin{aligned}{u}_{3} & =[\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]\\end{aligned}$$\n\nFinally, we construct the matrices $U,$ $\\Sigma,$ and $V\\mathbin{:}$\n\n$$U = [\\begin{aligned}\\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}] , \\qquad \\Sigma = [\\begin{aligned}2 & 0 \\\\ 0 & \\sqrt{2} \\\\ 0 & 0\\end{aligned}], \\qquad V = [\\begin{aligned}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]$$" #edb/ref 17592186045417] [17592186163233 #edb/ref 1065 4893 #edb/ref 17592186045417] [17592186163233 #edb/ref 1066 #uuid "670f2f0c-5dc5-54ae-9a39-2166ee2414fd" #edb/ref 17592186045417] [17592186163233 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186163258 #edb/ref 1064 "Suppose we want to find an SVD for the $2\\times 4$ matrix $A,$ given by\n\n$$A = [\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].$$\n\nDirectly applying the standard approach to $A$ could be problematic because it requires finding the eigenvalues of the $4\\times 4$ matrix $A^T \\! A.$\n\nIn such cases, it's usually more convenient to find an SVD of the transposed matrix $A^T$ and then take the transpose of the resulting SVD. In this case, we would only have to find the eigenvalues of a $2 \\times 2$ matrix.\n\nFor example, if\n\n$$A^T = U \\Sigma V^T$$\n\nis an SVD for $A^T,$ then\n\n$$A= \\left(A^T\\right)^T= \\left(U \\Sigma V^T\\right)^T=V\\Sigma^T U^T$$\n\nis an SVD for $A.$\n\nGoing through our usual process, we find that an SVD for $A^T$ is\n\n$$A^T= \\underbrace{[\\begin{aligned}\\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}} & 0 \\\\ 0 & 0 & 0 & 1 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} & 0 \\\\ 0 & 1 & 0 & 0\\end{aligned}]}_{\\large U} \\underbrace{[\\begin{aligned}\\sqrt{2} & 0 \\\\ 0 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}]}_{\\large \\Sigma} \\underbrace{[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]^T}_{\\large V^T}.$$\n\nTaking the transpose of the above equation. we find that an SVD for $A$ is\n\n$$A= V\\Sigma^T U^T = {[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]} {[\\begin{aligned}\\sqrt{2} & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]} [\\begin{aligned}\\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}} & 0 \\\\ 0 & 0 & 0 & 1 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} & 0 \\\\ 0 & 1 & 0 & 0\\end{aligned}]^T.$$" #edb/ref 17592186045417] [17592186163258 #edb/ref 1065 5110 #edb/ref 17592186045417] [17592186163258 #edb/ref 1066 #uuid "71ba93f6-01a1-54c4-bda4-b51b9b8dad77" #edb/ref 17592186045417] [17592186163258 #edb/ref 1067 "The Singular Value Decomposition of a Transposed Matrix" #edb/ref 17592186045417] [17592186370654 #edb/ref 1068 #edb/ref 17592186370655 #edb/ref 17592186045417] [17592186370654 #edb/ref 1068 #edb/ref 17592186370660 #edb/ref 17592186045417] [17592186370654 #edb/ref 1068 #edb/ref 17592186370665 #edb/ref 17592186045417] [17592186370654 #edb/ref 1068 #edb/ref 17592186370669 #edb/ref 17592186045417] [17592186370654 #edb/ref 1068 #edb/ref 17592186370674 #edb/ref 17592186045417] [17592186370654 #edb/ref 1068 #edb/ref 17592186370679 #edb/ref 17592186045417] [17592186370654 #edb/ref 1068 #edb/ref 17592186370683 #edb/ref 17592186045417] [17592186370654 #edb/ref 1068 #edb/ref 17592186370688 #edb/ref 17592186045417] [17592186370654 #edb/ref 1068 #edb/ref 17592186370692 #edb/ref 17592186045417] [17592186370654 #edb/ref 1069 "q-363824" #edb/ref 17592186045417] [17592186370654 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186370654 #edb/ref 1071 "$$\nA=[\\begin{aligned}1 & 3 \\\\ 2 & 6 \\\\ 0 & 0\\end{aligned}],\\,Σ=[\\begin{aligned}5\\sqrt{2} & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$  select the correct options in the computations of the matrix $U$ below.From the matrix $Σ,$ we deduce the singular values ${\\sigma }_{1}=5\\sqrt{2}$ and ${\\sigma }_{2}=0.$\n\nNow, we compute the $1$st column of $U.$ It is given by:\n\n|  |  | {{field-1}} |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{1}=\\,\\,$ |  | {{field-2}} |  |  |\n|  |  | $0$ |  |  |\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal.\n\nHence, we must find vectors $u=[{x}_{1},{x}_{2},{x}_{3}]^{T}$ such that ${u}_{1}\\cdot u=0,$ which is equivalent to \n\n$$\n{{field-3}}.\n$$\n\nChoosing ${x}_{2}$ and ${x}_{3}$ as free variables, the general solution is given by:\n\n|  |  | {{field-4}} |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | {{field-5}} |  |  |\n|  |  | ${x}_{3}$ |  |  |\n\nthat we can rewrite as\n\n$$\n[\\begin{aligned}-2{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}-2 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\nSince the two linearly independent solutions are already mutually orthogonal, we only need to normalize them. Hence, we obtain the second and third columns of $U:$\n\n| | ${u}_{2}=\\,\\,$ |  | {{field-6}} |  |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-7}} |  |  |  |\n|  | $0$ |  |  |  | | | ${u}_{3}=\\,\\,$ |  | {{field-8}} |  |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-9}} |  |  |  |\n|  | $1$ |  |  |  | |  |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{2}=\\,\\,$ |  | {{field-6}} |  |  |\n|  | {{field-7}} |  |  |  |\n|  | $0$ |  |  |  |\n| ${u}_{3}=\\,\\,$ |  | {{field-8}} |  |  |\n|  | {{field-9}} |  |  |  |\n|  | $1$ |  |  |  |" #edb/ref 17592186045417] [17592186370654 #edb/ref 1072 #uuid "d4516c67-259f-5935-b3cd-af66ef9e5af8" #edb/ref 17592186045417] [17592186370654 #edb/ref 1074 "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=5\\sqrt{2}$ and ${\\sigma }_{2}=0.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{5\\sqrt{2}}[\\begin{aligned}1 & 3 \\\\ 2 & 6 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}] \\\\  & =\\frac{1}{5\\sqrt{2}}[\\begin{aligned}\\sqrt{10} \\\\ 2\\sqrt{10} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n\\frac{1}{\\sqrt{5}}{x}_{1}+\\frac{2}{\\sqrt{5}}{x}_{2}=0\\,⟹\\,{x}_{1}+2{x}_{2}=0,\n$$\n\nwe get the general solution \n\n$$\n[\\begin{aligned}-2{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}{{[\\begin{aligned}-2 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{1}}+{x}_{3}{{[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{2}$ and ${x}_{3}$ are free variables.\n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are mutually orthogonal. Therefore, we only need to normalize them. This gives the second and third columns of $U:$   \n\n$$\n{u}_{2}=[\\begin{aligned}-\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} \\\\ 0\\end{aligned}]\\,{u}_{3}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=[\\begin{aligned}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} & 0 \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} & 0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186370655 #edb/ref 1075 #edb/ref 17592186370656 #edb/ref 17592186045417] [17592186370655 #edb/ref 1075 #edb/ref 17592186370657 #edb/ref 17592186045417] [17592186370655 #edb/ref 1075 #edb/ref 17592186370658 #edb/ref 17592186045417] [17592186370655 #edb/ref 1075 #edb/ref 17592186370659 #edb/ref 17592186045417] [17592186370655 #edb/ref 1076 #edb/r