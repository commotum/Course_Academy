#{[{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186444170} :activity/id #uuid "74cd288a-6d4e-5649-a0a3-fd1f66ef23c9" :activity/scope {:db/id #edb/ref 17592186050741 :topic/id #uuid "62cde46f-1bc8-533b-b62a-02ec7aac97f3" :topic/math-academy-id 4174} :activity/steps [{:db/id #edb/ref 17592186444170 :step/content {:db/id #edb/ref 17592186281677 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a8c3f43-d62e-5000-aa73-65488d3b0b24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{3}" :db/id #edb/ref 17592186278693} {:answer/id #uuid "124a91eb-fdf5-5e37-9d33-f96d11c8d50d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{\\frac{3}{5}}" :db/id #edb/ref 17592186278758} {:answer/id #uuid "4cbbd3c2-db9a-55d6-97d8-e5b35b4b7f75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{\\frac{5}{3}}" :db/id #edb/ref 17592186279281} {:answer/id #uuid "6f8c9571-4624-5e8c-9ba9-3cb3cfed6da9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186279604} {:answer/id #uuid "d0235cb5-d166-53f6-8c2a-e428ad59a7f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{\\frac{10}{3}}" :db/id #edb/ref 17592186280423}] :answer-field/correct {:db/id #edb/ref 17592186280423} :answer-field/id #uuid "65cfd582-049a-5c5a-85d6-152e3b8591a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281008}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c52b9e07-a1a1-59e3-9b59-f3ce7c050afb" :question/math-academy-id "q-163578" :question/problem "A rectangular plate of mass $M$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le 3\\}.$ Find the radius of gyration of the plate about the origin." :question/worked-solution "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the origin is defined as\n\n$$\n{I}_{0}={∬}_{D}\\lambda (x,y)({x}^{2}+{y}^{2})\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function.\n\nThe area of the rectangular plate $D$ is $A=1\\cdot 3=3.$ Since the plate has uniform density, the mass density function is given by\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{3}.\n$$\n\nTherefore, the moment of inertia about the origin is\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}\\lambda (x,y)({x}^{2}+{y}^{2})\\,\\text{d}A \\\\  & =\\frac{M}{3}{\\int }_{0}^{3}{\\int }_{0}^{1}{x}^{2}+{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{3}{\\int }_{0}^{3}{[\\frac{1}{3}{x}^{3}+x{y}^{2}]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & =\\frac{M}{3}{\\int }_{0}^{3}\\frac{1}{3}+{y}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{3}{[\\frac{1}{3}y+\\frac{1}{3}{y}^{3}]}_{0}^{3} \\\\  & =\\frac{M}{3}(1+9) \\\\  & =\\frac{10M}{3}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n{R}_{0}^{2}=\\frac{10}{3}\\,⇒\\,{R}_{0}=\\sqrt{\\frac{10}{3}}.\n$$"} :step/id #uuid "0e7b7881-d766-59e5-9ac2-17b4c071226f" :step/next {:db/id #edb/ref 17592186444173}} {:db/id #edb/ref 17592186444171 :step/content {:db/id #edb/ref 17592186198665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e41b76a-dabb-5807-a6bb-5779e0a43c8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186278869} {:answer/id #uuid "59d4646c-a8cc-5cc4-8c20-a790ad2f4d3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{\\frac{3}{5}}" :db/id #edb/ref 17592186279413} {:answer/id #uuid "74959f37-361c-597f-97f4-79fda9c4ad64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{\\frac{2}{3}}" :db/id #edb/ref 17592186279642} {:answer/id #uuid "ed79e371-e80a-5031-880e-b39448d43e87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186280675} {:answer/id #uuid "ee046b1f-ca21-54a9-88ec-7eeb4e214626" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186280677}] :answer-field/correct {:db/id #edb/ref 17592186280675} :answer-field/id #uuid "ee676f82-5c11-53e9-9b1a-845255b4b041" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281256}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2496e287-b250-5877-a40c-af954399de62" :question/math-academy-id "q-163612" :question/problem "A rectangular plate of mass $M$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,\\,4\\le y\\le 6\\}.$ Find the radius of gyration of the plate about the $y$-axis." :question/worked-solution "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the $y$-axis is defined as\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function.\n\nThe area of the rectangular plate $D$ is $A=1\\cdot 2=2.$ Since the plate has uniform density, the mass density function is given by\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{2}.\n$$\n\nTherefore, the moment of inertia about the $y$-axis is\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{2}{\\int }_{4}^{6}{\\int }_{0}^{1}{x}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{2}{\\int }_{4}^{6}{[\\frac{1}{3}{x}^{3}]}_{0}^{1}\\,\\text{d}y \\\\  & =\\frac{M}{2}{\\int }_{4}^{6}\\frac{1}{3}(1-0)\\,\\text{d}y \\\\  & =\\frac{M}{6}{\\int }_{4}^{6}\\,\\text{d}y \\\\  & =\\frac{M}{6}[y]_{4}^{6} \\\\  & =\\frac{M}{6}(6-4) \\\\  & =\\frac{M}{3}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n{R}_{y}^{2}=\\frac{1}{3}\\,⇒\\,{R}_{y}=\\sqrt{\\frac{1}{3}}=\\frac{1}{\\sqrt{3}}.\n$$"} :step/id #uuid "512ba0cc-ab8c-5fb2-8948-44914ec8fb98"} {:db/id #edb/ref 17592186444172 :step/content {:db/id #edb/ref 17592186198664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6535965a-826c-5401-b848-6255c9d1f28e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186279511} {:answer/id #uuid "7deac3bc-f281-52ad-8e6b-0601f71b4a9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186279719} {:answer/id #uuid "7f0ffd07-00a8-5c7d-b894-4de55fd2b939" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186279736} {:answer/id #uuid "e541680e-b07b-5177-9547-9e1ab1f2488d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{\\frac{3}{5}}" :db/id #edb/ref 17592186280616} {:answer/id #uuid "eb846481-780f-5fe4-beca-6607afcf5a4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{10}}{2}" :db/id #edb/ref 17592186280661}] :answer-field/correct {:db/id #edb/ref 17592186280616} :answer-field/id #uuid "2495d518-218f-5140-a76c-b46562a88454" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280897}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3adab878-1dd3-5ac8-88b6-a5059624907c" :question/math-academy-id "q-163604" :question/problem "A plate of mass $M$ occupies the region $D$ enclosed by the lines $y=x,$ $x=2,$ and the $x$-axis. Its mass density at any point on the plate is given by $\\lambda (x,y)=\\frac{3}{4}My.$ Find the radius of gyration of the plate about the $y$-axis." :question/worked-solution "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the $y$-axis is defined as\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function. The region $D$ is a type I region with representation\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le x\\}.\n$$\n\nHence, the moment of inertia about the $y$-axis is\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{x}{x}^{2}\\cdot \\frac{3}{4}My\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{3M}{4}{\\int }_{0}^{2}{\\int }_{0}^{x}{x}^{2}y\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{3M}{4}{\\int }_{0}^{2}{[\\frac{1}{2}{x}^{2}{y}^{2}]}_{y=0}^{y=x}\\,\\text{d}x \\\\  & =\\frac{3M}{4}{\\int }_{0}^{2}\\frac{1}{2}{x}^{4}\\,\\text{d}x \\\\  & =\\frac{3M}{4}{[\\frac{1}{10}{x}^{5}]}_{0}^{2} \\\\  & =\\frac{3M}{4}\\cdot \\frac{16}{5} \\\\  & =\\frac{12M}{5}.\\end{aligned}\n$$\n\nTherefore, the radius of gyration about the $y$-axis is\n\n$$\n\\begin{aligned}{R}_{y} & =\\sqrt{\\frac{{I}_{y}}{M}} \\\\  & =\\sqrt{\\frac{12M}{5}\\cdot \\frac{1}{M}} \\\\  & =\\sqrt{\\frac{12}{5}} \\\\  & =2\\sqrt{\\frac{3}{5}}.\\end{aligned}\n$$"} :step/id #uuid "c02d457b-f21d-50f7-b09e-291abfa68047" :step/next {:db/id #edb/ref 17592186444174}} {:db/id #edb/ref 17592186444173 :step/content {:db/id #edb/ref 17592186444169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e358496-a583-59a6-b4e0-5fcf99d9cafa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186444157} {:answer/id #uuid "2ca9c9b8-05e4-5eb3-8122-ad72c6a359f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{7}}{3}" :db/id #edb/ref 17592186444158} {:answer/id #uuid "688f7ffe-b0fd-57c9-821e-0495e33a6fae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{\\frac{17}{5}}" :db/id #edb/ref 17592186444161} {:answer/id #uuid "9bbfff91-ca90-559f-ae5d-5fd328a1f1e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186444163} {:answer/id #uuid "bb7abb37-0de9-58cb-8a76-9f11aa3adea3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{\\frac{21}{2}}" :db/id #edb/ref 17592186444165}] :answer-field/correct {:db/id #edb/ref 17592186444163} :answer-field/id #uuid "02ef48a6-5de2-5aeb-b94d-50e269438d16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186444166}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ae31463b-0937-5dcb-a149-ee8482b71924" :question/math-academy-id "q-163579" :question/problem "A rectangular plate of mass $M$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,1\\le x\\le 4,\\,\\,2\\le y\\le 5\\}.$ Find the radius of gyration of the plate about the $y$-axis." :question/worked-solution "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the $y$-axis is defined as\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function.\n\nThe area of the rectangular plate $D$ is $A=3\\cdot 3=9.$ Since the plate has uniform density, the mass density function is given by\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{9}.\n$$\n\nTherefore, the moment of inertia about the $y$-axis is\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{9}{\\int }_{2}^{5}{\\int }_{1}^{4}{x}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{9}{\\int }_{2}^{5}{[\\frac{1}{3}{x}^{3}]}_{1}^{4}\\,\\text{d}y \\\\  & =\\frac{M}{9}{\\int }_{2}^{5}(\\frac{64}{3}-\\frac{1}{3})\\,\\text{d}y \\\\  & =\\frac{M}{9}{\\int }_{2}^{5}21\\,\\text{d}y \\\\  & =\\frac{7M}{3}{\\int }_{2}^{5}\\,\\text{d}y \\\\  & =\\frac{7M}{3}[y]_{2}^{5} \\\\  & =\\frac{7M}{3}(5-2) \\\\  & =7M.\\end{aligned}\n$$\n\nFinally,\n\n$$\n{R}_{y}^{2}=7\\,⇒\\,{R}_{y}=\\sqrt{7}.\n$$"} :step/id #uuid "ce124292-03a7-514d-bbf3-a753805c4055" :step/next {:db/id #edb/ref 17592186444172}} {:db/id #edb/ref 17592186444174 :step/content {:db/id #edb/ref 17592186444168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "020395fa-1c94-56f4-b0cf-6b542584a05e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{21}" :db/id #edb/ref 17592186444156} {:answer/id #uuid "4e9fa620-f201-58e2-aec9-4998cb5b396c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{17}}{3}" :db/id #edb/ref 17592186444159} {:answer/id #uuid "61c6c170-edd9-5422-8928-2559bb6d8200" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{\\frac{34}{3}}" :db/id #edb/ref 17592186444160} {:answer/id #uuid "7f05bbf6-f47e-5bba-ae07-b44dd179c296" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{\\frac{61}{2}}" :db/id #edb/ref 17592186444162} {:answer/id #uuid "aed2bb04-ea3b-5b55-b733-92f0f589ec24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{17}" :db/id #edb/ref 17592186444164}] :answer-field/correct {:db/id #edb/ref 17592186444160} :answer-field/id #uuid "364a1bfa-3c03-5519-b8cb-713056748a8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186444167}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4a051470-22b3-5741-85c9-94876b2374fa" :question/math-academy-id "q-163606" :question/problem "A rectangular plate of mass $M$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,1\\le x\\le 4,\\,\\,1\\le y\\le 3\\}.$ Find the radius of gyration of the plate about the origin." :question/worked-solution "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the origin is defined as\n\n$$\n{I}_{0}={∬}_{D}\\lambda (x,y)({x}^{2}+{y}^{2})\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function.\n\nThe area of the rectangular plate $D$ is $A=3\\cdot 2=6.$ Since the plate has uniform density, the mass density function is given by\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{6}.\n$$\n\nTherefore, the moment of inertia about the origin is\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}\\lambda (x,y)({x}^{2}+{y}^{2})\\,\\text{d}A \\\\  & =\\frac{M}{6}{\\int }_{1}^{3}{\\int }_{1}^{4}{x}^{2}+{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{6}{\\int }_{1}^{3}{[\\frac{1}{3}{x}^{3}+x{y}^{2}]}_{x=1}^{x=4}\\,\\text{d}y \\\\  & =\\frac{M}{6}{\\int }_{1}^{3}(\\frac{64}{3}+4{y}^{2}-\\frac{1}{3}-{y}^{2})\\,\\text{d}y \\\\  & =\\frac{M}{6}{\\int }_{1}^{3}21+3{y}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{6}{[21y+{y}^{3}]}_{1}^{3} \\\\  & =\\frac{M}{6}(63+27-21-1) \\\\  & =\\frac{M}{6}\\cdot 68 \\\\  & =\\frac{34M}{3}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n{R}_{0}^{2}=\\frac{34}{3}\\,⇒\\,{R}_{0}=\\sqrt{\\frac{34}{3}}.\n$$"} :step/id #uuid "f1544047-bb8b-536b-b9d7-9b50cf101d4e" :step/next {:db/id #edb/ref 17592186444171}}] :activity/title "Calculating the Radius of Gyration of a Plane Lamina" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186444155}]}
