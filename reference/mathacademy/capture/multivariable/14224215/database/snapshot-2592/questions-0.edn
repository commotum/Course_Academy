#{[{:db/id #edb/ref 17592186167270 :knowledge-point/_questions [{:db/id #edb/ref 17592186166955 :knowledge-point/id #uuid "f5ee3c3f-4289-5e38-a47a-52e5c2ad3817" :knowledge-point/title "Understanding the Odd Extension of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b67846e3-9cc1-5d4f-a17f-0a6e14d91486" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x^{2} + 2x" :db/id #edb/ref 17592186164820} {:answer/id #uuid "bf7b7af4-4f32-5dab-98e3-93d16eac4587" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{2} - 2x" :db/id #edb/ref 17592186164821} {:answer/id #uuid "eb51adc1-727c-55d4-aa8f-06e219dd9867" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{vmatrix}x & ^{2} + 2 & x\\end{vmatrix}" :db/id #edb/ref 17592186164822} {:answer/id #uuid "17f3432c-342b-56ff-bda0-c8893f4b947c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x^{2} - 2x" :db/id #edb/ref 17592186164823} {:answer/id #uuid "4fbe7af0-4024-522f-b62b-1f39ff49ba0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\mid - x^{2} + 2x \\mid" :db/id #edb/ref 17592186164824}] :answer-field/id #uuid "163adf1f-a5ba-53ac-95f1-d113394667f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186164819}] :question/id #uuid "487df78e-b6e4-5124-9586-cb2ed967b312" :question/math-academy-id "q-338784" :question/problem "Let $F(x) = x^{2} - 2x$ for $x ∈ [0, π)$, and let $f(x)$ be the **odd** extension of $F(x)$ to $x ∈ (- π, π)$. What is $f(x)$ for $x ∈ (- π, 0)$?"}] [{:db/id #edb/ref 17592186315033 :knowledge-point/_questions [{:db/id #edb/ref 17592186166956 :knowledge-point/id #uuid "1a85c9c4-8563-55e0-9d4f-7d61d3be6243" :knowledge-point/title "Computing the Sine Coefficients From the Half-Range Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bc2695f-0e15-5691-a028-b150d466dcf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(-1)^{n}}{n}" :db/id #edb/ref 17592186312316} {:answer/id #uuid "725ea555-7d4c-5eaf-95eb-128a98f4ed38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6(-1)^{n}}{n}" :db/id #edb/ref 17592186312872} {:answer/id #uuid "f347fe48-c18b-5b04-9912-af36b33ea06b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6(1-(-1)^{n})}{\\pi n}" :db/id #edb/ref 17592186313921} {:answer/id #uuid "fa8ec435-d3fb-5f32-883e-f63f94659176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(1-(-1)^{n})}{\\pi n}" :db/id #edb/ref 17592186313974}] :answer-field/correct {:answer/id #uuid "725ea555-7d4c-5eaf-95eb-128a98f4ed38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6(-1)^{n}}{n}" :db/id #edb/ref 17592186312872} :answer-field/id #uuid "da0d16eb-266b-580b-b823-2ca3bad44068" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314614} {:answer-field/choices [{:answer/id #uuid "3f25da9e-c33a-5999-a8c4-ac447897722c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(nx)" :db/id #edb/ref 17592186312485} {:answer/id #uuid "525fe023-9b2c-5613-ac7a-b31e065a357b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(nx)" :db/id #edb/ref 17592186312643} {:answer/id #uuid "b69786fc-4a61-5bdb-88d2-2cf63ec7fbf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\pi x)" :db/id #edb/ref 17592186313393} {:answer/id #uuid "dfe655ac-4aeb-5468-80b5-b24c11370919" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\pi x)" :db/id #edb/ref 17592186313735}] :answer-field/correct {:answer/id #uuid "3f25da9e-c33a-5999-a8c4-ac447897722c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(nx)" :db/id #edb/ref 17592186312485} :answer-field/id #uuid "ece722c4-3730-5a44-bfa8-824b101a061a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314658}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f36f74d-9ded-58b3-8942-de350905b5b9" :question/math-academy-id "q-340922" :question/problem "Let $F(x)=-3x$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier sine series of the **odd** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$" :question/worked-solution "For our Fourier sine series, the coefficients are given by\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-3x$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{b}_{n}=-\\frac{6}{\\pi }{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=x\\, & ⇒\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡(nx)\\, & ⇒\\,v=-\\frac{1}{n}\\operatorname{cos}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{n} & =-\\frac{6}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =-\\frac{6}{\\pi }(-\\frac{1}{n}[x\\operatorname{cos}⁡(nx)]_{0}^{\\pi }+\\frac{1}{n}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{6}{n\\pi }((\\pi \\cdot \\operatorname{cos}⁡(n\\pi )-0\\cdot \\operatorname{cos}⁡(0))-\\frac{1}{n}[\\operatorname{sin}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{6}{n\\pi }(\\pi \\operatorname{cos}⁡(n\\pi )-\\frac{1}{n}(\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))) \\\\  & =\\frac{6\\operatorname{cos}⁡(n\\pi )}{n}.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{b}_{n}=\\frac{6(-1)^{n}}{n}.\n$$\n\nFinally, the Fourier sine series is\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\frac{6(-1)^{n}}{n}\\cdot \\operatorname{sin}⁡(nx).\n$$"}] [{:db/id #edb/ref 17592186379595 :knowledge-point/_questions [{:db/id #edb/ref 17592186166955 :knowledge-point/id #uuid "f5ee3c3f-4289-5e38-a47a-52e5c2ad3817" :knowledge-point/title "Understanding the Odd Extension of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "669c79c2-1922-5d4f-8294-a85dd5e7d7f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186379597}] :answer-field/correct {:answer/id #uuid "669c79c2-1922-5d4f-8294-a85dd5e7d7f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186379597} :answer-field/id #uuid "62443fee-fe96-5815-bb89-8967be450b9e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186379596}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0188791e-a7fa-5d1c-b905-419c47766caf" :question/math-academy-id "q-341203" :question/problem "Let $F(x)={x}^{2}-6x$ for $x\\in [0,12),$ and let $f(x)$ be the **odd** extension of $F(x)$ to $x\\in (-12,12).$ What is the value of $f(-4)?$\n\n$f(-4)=$\n{{field-1}}" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,12),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,12), \\\\ -F(-x), & x\\in (-12,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-12,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-((-x)^{2}-6(-x)) \\\\  & =-({x}^{2}+6x) \\\\  & =-{x}^{2}-6x.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-4) & =-(-4)^{2}-6(-4)=8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186315083 :knowledge-point/_questions [{:db/id #edb/ref 17592186166956 :knowledge-point/id #uuid "1a85c9c4-8563-55e0-9d4f-7d61d3be6243" :knowledge-point/title "Computing the Sine Coefficients From the Half-Range Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d2b4d4-59ed-5f0d-9922-89c02bc8942c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{n\\pi }((-1)^{n}(3\\pi +2)-2)" :db/id #edb/ref 17592186312144} {:answer/id #uuid "1c7dfd21-ea92-5be3-8cba-ebde5cac0a85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{n\\pi }((-1)^{n}(3\\pi -2)+2)" :db/id #edb/ref 17592186312186} {:answer/id #uuid "b1ef0a66-4c64-5da9-8e07-1ee81ddb44b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{n\\pi }((-1)^{n}(3\\pi -2)+2)" :db/id #edb/ref 17592186313358} {:answer/id #uuid "e47a9901-72d0-5e49-98e9-0f5ae120d820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(1-(-1)^{n})}{\\pi n}" :db/id #edb/ref 17592186313780}] :answer-field/correct {:answer/id #uuid "1c7dfd21-ea92-5be3-8cba-ebde5cac0a85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{n\\pi }((-1)^{n}(3\\pi -2)+2)" :db/id #edb/ref 17592186312186} :answer-field/id #uuid "27702b14-e617-57ac-90a9-1bb0c61d35a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314114} {:answer-field/choices [{:answer/id #uuid "6441ae36-adf1-5855-b981-8fc098d80d81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(nx)" :db/id #edb/ref 17592186312770} {:answer/id #uuid "7389b0c8-c427-5783-917f-54f1d71de35e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(nx)" :db/id #edb/ref 17592186312890} {:answer/id #uuid "d3f60e40-1d50-5fed-9993-320e426adf71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\pi x)" :db/id #edb/ref 17592186313640} {:answer/id #uuid "fe0e894e-bcb8-5db4-8c39-fd7a667523d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\pi x)" :db/id #edb/ref 17592186314002}] :answer-field/correct {:answer/id #uuid "7389b0c8-c427-5783-917f-54f1d71de35e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(nx)" :db/id #edb/ref 17592186312890} :answer-field/id #uuid "84d7a55f-6b4e-5c7e-90c0-f352d65aa8ea" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314361}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac9732d3-1086-5e0e-8f66-b1641de82b66" :question/math-academy-id "q-341336" :question/problem "Let $F(x)=-3x+2$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier sine series of the **odd** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$" :question/worked-solution "For our Fourier sine series, the coefficients are given by\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-3x+2$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{b}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(-3x+2)\\operatorname{sin}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-3x+2\\, & ⇒\\,{u}^{′}=-3 \\\\ {v}^{′}=\\operatorname{sin}⁡(nx)\\, & ⇒\\,v=-\\frac{1}{n}\\operatorname{cos}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(-\\frac{1}{n}[(-3x+2)\\operatorname{cos}⁡(nx)]_{0}^{\\pi }-\\frac{3}{n}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(nx)\\,\\text{d}x) \\\\  & =-\\frac{2}{n\\pi }(((-3\\pi +2)\\operatorname{cos}⁡(n\\pi )-2\\operatorname{cos}⁡(0))+\\frac{3}{n}[\\operatorname{sin}⁡(nx)]_{0}^{\\pi }) \\\\  & =-\\frac{2}{n\\pi }((-3\\pi +2)\\operatorname{cos}⁡(n\\pi )-2+\\frac{3}{n}(\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))) \\\\  & =-\\frac{2}{n\\pi }((-3\\pi +2)\\operatorname{cos}⁡(n\\pi )-2).\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{b}_{n}=-\\frac{2}{n\\pi }((-3\\pi +2)(-1)^{n}-2)=\\frac{2}{n\\pi }((-1)^{n}(3\\pi -2)+2).\n$$\n\nFinally, the Fourier sine series is\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\frac{2}{n\\pi }((-1)^{n}(3\\pi -2)+2)\\cdot \\operatorname{sin}⁡(nx).\n$$"}]}
