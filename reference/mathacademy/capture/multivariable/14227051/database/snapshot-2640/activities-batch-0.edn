#{[{:activity/expected-seconds 840.0 :activity/first-step {:db/id #edb/ref 17592186093105} :activity/id #uuid "7a7cf18a-8a95-5fc3-8d59-8391300bbcee" :activity/scope {:db/id #edb/ref 17592186048204 :topic/id #uuid "881a9e15-1557-584f-9d93-ff8b0046998b" :topic/math-academy-id 1020} :activity/steps [{:db/id #edb/ref 17592186092990 :step/content {:db/id #edb/ref 17592186092182 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092019 :question/id #uuid "5a52cc3b-4e4b-5b66-b1e0-589e3dd806e5" :question/math-academy-id "e-4219"} :knowledge-point/id #uuid "b98c8710-49f8-550f-aad3-7b78220bd08f" :knowledge-point/questions [{:db/id #edb/ref 17592186092696} {:db/id #edb/ref 17592186092790} {:db/id #edb/ref 17592186233354} {:db/id #edb/ref 17592186233355} {:db/id #edb/ref 17592186233963} {:db/id #edb/ref 17592186233984} {:db/id #edb/ref 17592186233985} {:db/id #edb/ref 17592186234233} {:db/id #edb/ref 17592186529124} {:db/id #edb/ref 17592186529140} {:db/id #edb/ref 17592186529175} {:db/id #edb/ref 17592186529180}] :knowledge-point/title "Evaluating an Infinite Geometric Series Expressed in Sigma Notation With an Arbitrary Starting Index"} :step/id #uuid "f64797fc-b1b9-5fd8-8b1c-7f10fb1d109b" :step/math-academy-id 15387 :step/next {:db/id #edb/ref 17592186093108}} {:db/id #edb/ref 17592186093105 :step/content {:db/id #edb/ref 17592186093368 :tutorial/content "Suppose we want to evaluate the infinite geometric series \n \n\n$$\n\\sum_{n = 1} ^ \\infty  3 \\left (\\dfrac 1 4\\right) ^ n.\n$$\n\nThe sum $S_\\infty$ of an infinite geometric series is given by the formula\n\n$$\nS_{\\infty} = \\dfrac {\\color{black}a_1} {1 - {\\color{black}r}},\n$$\n\nwhere ${\\color{black}r}$ is the common ratio and $\\color{black}a_1$ is the first term. So, we need to determine $\\color{black}a_1$ and $\\color{black}r$ and then plug those values into this formula.\n\nThe first term is\n\n$$\n{\\color{black}a_1} = 3 \\left( \\dfrac 1 4 \\right)^1 = {\\color{black}\\dfrac 3 4},\n$$\n\nand the common ratio is \n\n$$\n{\\color{black}r} = \\dfrac {a_2}{\\color{black}a_1} = \\dfrac {3 \\left (\\dfrac 1 4 \\right)^2}{3\\left( \\dfrac 1 4 \\right)^1}= {\\color{black}\\dfrac 1 4}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }3{(\\frac{1}{4})}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{(\\frac{3}{4})}{(1-\\frac{1}{4})} \\\\  & =\\frac{(\\frac{3}{4})}{(\\frac{3}{4})} \\\\  & =1.\\end{aligned}\n$$" :tutorial/id #uuid "05ae9ac9-5b25-58d0-b897-5d1d9d9507be" :tutorial/math-academy-id 1201 :tutorial/title "Introduction"} :step/id #uuid "ba6ff89b-2989-5ca1-b094-ea0750c3c11e" :step/math-academy-id 2359 :step/next {:db/id #edb/ref 17592186093107}} {:db/id #edb/ref 17592186093106 :step/content {:db/id #edb/ref 17592186092254 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092106 :question/id #uuid "90ac2db3-26c1-533d-8a0d-edceba8d565f" :question/math-academy-id "e-685"} :knowledge-point/id #uuid "5191b207-da9d-5408-8efd-3c616ffd3211" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050286}] :knowledge-point/questions [{:db/id #edb/ref 17592186092541} {:db/id #edb/ref 17592186092551} {:db/id #edb/ref 17592186233351} {:db/id #edb/ref 17592186233352} {:db/id #edb/ref 17592186233353} {:db/id #edb/ref 17592186233962} {:db/id #edb/ref 17592186233981} {:db/id #edb/ref 17592186233982} {:db/id #edb/ref 17592186233983} {:db/id #edb/ref 17592186529125} {:db/id #edb/ref 17592186529130} {:db/id #edb/ref 17592186529144} {:db/id #edb/ref 17592186529182} {:db/id #edb/ref 17592186529194}] :knowledge-point/title "Evaluating an Infinite Geometric Series Expressed in Sigma Notation"} :step/id #uuid "9925101a-8132-5348-b037-ee80062e4a4e" :step/math-academy-id 2360 :step/next {:db/id #edb/ref 17592186092990}} {:db/id #edb/ref 17592186093107 :step/content {:db/id #edb/ref 17592186092255 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092107 :question/id #uuid "6126f9d5-f163-5167-b524-710146791e06" :question/math-acade