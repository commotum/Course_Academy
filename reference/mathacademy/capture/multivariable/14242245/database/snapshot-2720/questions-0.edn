#{[{:db/id #edb/ref 17592186559785 :knowledge-point/_questions [{:db/id #edb/ref 17592186162013 :knowledge-point/id #uuid "4c67d532-acd9-5231-a27f-d39084863e01" :knowledge-point/title "Identifying True Statements Regarding the Spectral Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03447015-8a69-5cc9-8dc8-414b596017be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186559027} {:answer/id #uuid "2ba00610-5038-5e8c-b108-a154138d8fd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186559125} {:answer/id #uuid "367c0855-5233-510b-8d48-efa4737d7993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186559154} {:answer/id #uuid "ad12ed5f-34ad-5ed9-9497-1c2dbe2c1d2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186559451} {:answer/id #uuid "f058d428-0146-5872-86b8-f12ac8d0a722" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186559601}] :answer-field/correct {:answer/id #uuid "2ba00610-5038-5e8c-b108-a154138d8fd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186559125} :answer-field/id #uuid "8e5650dd-916f-5b6f-b0e5-9eadfbe79952" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559724}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "210e4b47-1e0a-56be-aa39-497b4081eae6" :question/math-academy-id "q-95404" :question/problem "Given that $A$ is a real symmetric matrix, which of the following statements are true?\n\nI. $A$ is diagonalizable\n\nII. If $u$ and $v$ are two eigenvectors that correspond to different eigenvalues, then $u=\\alpha v$ for some scalar $\\alpha $\n\nIII. $A$ might have a complex eigenvalue" :question/worked-solution "Given that $A$ is an $n\\times n$ symmetric matrix over $R$, the spectral theorem states the following:\n\n- The eigenvalues of $A$ are all real.\n\n- Eigenvectors corresponding to different eigenvalues are orthogonal.\n\n- The dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\n- $A$ is orthogonally diagonalizable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, any symmetric matrix with real entries is orthogonally diagonalizable, so, $A$ is diagonalizable.\n\n- Statement II is false. According to the theorem, eigenvectors corresponding to different eigenvalues must be orthogonal. So if the two eigenvalues correspond to different eigenvalues, we cannot have $u=\\alpha v$ for some scalar $\\alpha .$\n\n- Statement III is false. According to the spectral theorem, the eigenvalues are real.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186366636 :knowledge-point/_questions [{:db/id #edb/ref 17592186162013 :knowledge-point/id #uuid "4c67d532-acd9-5231-a27f-d39084863e01" :knowledge-point/title "Identifying True Statements Regarding the Spectral Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c6e59cf-eefe-5e7d-9e31-a8784bb64fdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452197} {:answer/id #uuid "21e11fcb-04eb-552c-a533-7cc128693eb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452198}] :answer-field/correct {:answer/id #uuid "21e11fcb-04eb-552c-a533-7cc128693eb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452198} :answer-field/id #uuid "99c5561a-1c1f-5380-a23d-ed36c45bd3f7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452946} {:answer-field/choices [{:answer/id #uuid "73d0b8cb-9801-5fc9-a55c-c637e3fd779a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452199} {:answer/id #uuid "f773140f-7c60-560e-8d94-6114e21180eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452200}] :answer-field/correct {:answer/id #uuid "73d0b8cb-9801-5fc9-a55c-c637e3fd779a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452199} :answer-field/id #uuid "b81448bd-7bd9-5f9c-a66a-2e21a29d3fec" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452947} {:answer-field/choices [{:answer/id #uuid "73bd6dbf-2be9-5c2b-8fad-7080e8da1057" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452201} {:answer/id #uuid "a2c1e16b-b961-57ac-90e1-29a223838bbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452202}] :answer-field/correct {:answer/id #uuid "a2c1e16b-b961-57ac-90e1-29a223838bbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452202} :answer-field/id #uuid "c352f51f-c826-5af3-a439-3bb54f1ba94c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452948}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66a9cbb1-7460-5af7-96d5-cd936a2ef154" :question/math-academy-id "q-95405" :question/problem "Given that $A$ is an $8\\times 8$ real symmetric matrix, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is orthogonally diagonalizable\n- **II.** $A$ must have $8$ real and distinct eigenvalues\n- **III.** If $u$ and $v$ are two eigenvectors that correspond to different eigenvalues, then $u⊥v$" :question/worked-solution "Given that $A$ is an $n\\times n$ symmetric matrix over $R$, the spectral theorem states the following:\n\n- The eigenvalues of $A$ are all real.\n\n- Eigenvectors corresponding to different eigenvalues are orthogonal.\n\n- The dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\n- $A$ is orthogonally diagonalizable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, any symmetric matrix with real entries is orthogonally diagonalizable.\n\n- Statement II is false. According to the spectral theorem, the eigenvalues are real but not necessarily distinct. This occurs when the characteristic polynomial has roots whose (algebraic) multiplicity is greater than $1.$\n\n- Statement III is true. Indeed, eigenvectors corresponding to different eigenvalues must be orthogonal.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186411856 :knowledge-point/_questions [{:db/id #edb/ref 17592186162013 :knowledge-point/id #uuid "4c67d532-acd9-5231-a27f-d39084863e01" :knowledge-point/title "Identifying True Statements Regarding the Spectral Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "577c6459-a68e-5617-9007-38fe998472ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454202} {:answer/id #uuid "9803254f-68b7-5b7e-936e-f2b01fcb4624" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454203}] :answer-field/correct {:answer/id #uuid "577c6459-a68e-5617-9007-38fe998472ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454202} :answer-field/id #uuid "40924b97-51ec-57fe-9300-e75dc6817c4c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454851} {:answer-field/choices [{:answer/id #uuid "3d6225d8-02a3-5861-9a49-a929038a7ee8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454204} {:answer/id #uuid "b251d743-a66c-5bae-a8cf-5ca14a90f254" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454205}] :answer-field/correct {:answer/id #uuid "3d6225d8-02a3-5861-9a49-a929038a7ee8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454204} :answer-field/id #uuid "6cae005c-ab57-5373-a6f8-1aefd15ba7ba" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454852} {:answer-field/choices [{:answer/id #uuid "c7230c31-5927-5a08-a14e-0066312e17b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454206} {:answer/id #uuid "98cbb68b-2336-539d-bb6a-8b6710f91c0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454207}] :answer-field/correct {:answer/id #uuid "98cbb68b-2336-539d-bb6a-8b6710f91c0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454207} :answer-field/id #uuid "e249821b-901a-5fb1-b815-d0984e6c7c99" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454853}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "409399cd-9cd7-53bb-83f5-ffa99003572c" :question/math-academy-id "q-95407" :question/problem "Given that $A$ is a real symmetric matrix, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ must have a complex eigenvalue\n\n- **II.** $A$ is not diagonalizable\n\n- **III.** If $u$ and $v$ are two eigenvectors corresponding to different eigenvalues, then $u⊥v$" :question/worked-solution "Given that $A$ is an $n\\times n$ symmetric matrix over $R$, the spectral theorem states the following:\n\n- The eigenvalues of $A$ are all real.\n\n- Eigenvectors corresponding to different eigenvalues are orthogonal.\n\n- The dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\n- $A$ is orthogonally diagonalizable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. According to the spectral theorem, the eigenvalues are real.\n\n- Statement II is false. According to the spectral theorem, any symmetric matrix with real entries is orthogonally diagonalizable, so, $A$ is diagonalizable.\n\n- Statement III is true. Indeed, eigenvectors corresponding to different eigenvalues must be orthogonal.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186559800 :knowledge-point/_questions [{:db/id #edb/ref 17592186162013 :knowledge-point/id #uuid "4c67d532-acd9-5231-a27f-d39084863e01" :knowledge-point/title "Identifying True Statements Regarding the Spectral Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28767abe-e741-5825-bba9-64081ca06ad7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186559117} {:answer/id #uuid "3c608fb3-267f-554d-8bf6-edba88e5c867" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186559167} {:answer/id #uuid "3c80624a-5983-591d-a673-ae4cac20ce07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186559169} {:answer/id #uuid "3d68c016-caf8-513d-b3a9-2868a44187fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186559175} {:answer/id #uuid "72c03a73-aa07-54e2-995b-498454ec7b39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186559303}] :answer-field/correct {:answer/id #uuid "72c03a73-aa07-54e2-995b-498454ec7b39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186559303} :answer-field/id #uuid "69b45667-9a66-586d-aafa-6664e3584267" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186559704}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3fb92bee-a19d-5089-88c2-ed5488b77548" :question/math-academy-id "q-95410" :question/problem "Given that $A$ is a real symmetric matrix, which of the following statements are true?\n\nI. If $u$ and $v$ are two eigenvectors that correspond to different eigenvalues, then $u⊥v$\n\nII. $A$ is orthogonally diagonalizable\n\nIII. $A$ must have all real eigenvalues" :question/worked-solution "Given that $A$ is an $n\\times n$ symmetric matrix over $R$, the spectral theorem states the following:\n\n- The eigenvalues of $A$ are all real.\n\n- Eigenvectors corresponding to different eigenvalues are orthogonal.\n\n- The dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\n- $A$ is orthogonally diagonalizable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, eigenvectors corresponding to different eigenvalues must be orthogonal.\n\n- Statement II is true. Indeed, any symmetric matrix with real entries is orthogonally diagonalizable.\n\n- Statement III is true. Indeed, the eigenvalues of a symmetric matrix are real.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186366650 :knowledge-point/_questions [{:db/id #edb/ref 17592186162013 :knowledge-point/id #uuid "4c67d532-acd9-5231-a27f-d39084863e01" :knowledge-point/title "Identifying True Statements Regarding the Spectral Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4d9fb91-ae25-53ed-a33c-52e7f364db71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452209} {:answer/id #uuid "4c814939-1a7e-5031-9e14-64d8c9b51ea6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452210}] :answer-field/correct {:answer/id #uuid "4c814939-1a7e-5031-9e14-64d8c9b51ea6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452210} :answer-field/id #uuid "1d68a3af-4038-51ee-9cc7-15a7b64191e6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452952} {:answer-field/choices [{:answer/id #uuid "7914c4bc-6016-5c15-9903-b3e24296b928" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452211} {:answer/id #uuid "98ac60b1-7d42-5198-abee-c2977adfc88a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452212}] :answer-field/correct {:answer/id #uuid "7914c4bc-6016-5c15-9903-b3e24296b928" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452211} :answer-field/id #uuid "fa8226b8-812d-57b4-8dff-7d10faebed24" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452953} {:answer-field/choices [{:answer/id #uuid "61ee797c-7e47-51b1-b65a-01a807de3be9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452213} {:answer/id #uuid "ac26379d-5127-5f07-aecb-9307a97b011c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452214}] :answer-field/correct {:answer/id #uuid "61ee797c-7e47-51b1-b65a-01a807de3be9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452213} :answer-field/id #uuid "99678f97-4a7f-57fc-8ce5-ae8e7084ae62" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452954}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0baadb2d-d441-5a17-add5-c8350f576311" :question/math-academy-id "q-95700" :question/problem "Given that $A$ is a $6\\times 6$ real symmetric matrix, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is orthogonally diagonalizable\n- **II.** $A$ must have $36$ real eigenvalues\n- **III.** If $u$ and $v$ are two eigenvectors, then $u$ is parallel to $v$" :question/worked-solution "Given that $A$ is an $n\\times n$ symmetric matrix over $R$, the spectral theorem states the following:\n\n- The eigenvalues of $A$ are all real.\n\n- Eigenvectors corresponding to different eigenvalues are orthogonal.\n\n- The dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\n- $A$ is orthogonally diagonalizable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, any symmetric matrix with real entries is orthogonally diagonalizable.\n\n- Statement II is false. According to the spectral theorem, the eigenvalues are real but there are not $36$ of them. An $n\\times n$ matrix has at most $n$ distinct eigenvalues.\n\n- Statement III is false. According to the theorem, eigenvectors corresponding to different eigenvalues must be orthogonal. So if the two eigenvalues correspond to different eigenvalues, they cannot be parallel.\n\nTherefore, the correct answer is \"I only.\""}]}
