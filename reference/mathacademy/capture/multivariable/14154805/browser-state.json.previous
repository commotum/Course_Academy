e=\"vertical-align: 0.363em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-texatom></mjx-script></mjx-msup><mjx-mstyle style=\"width: 0px; margin-right: -0.167em;\"><mjx-mspace style=\"margin-right: -0.167em;\"></mjx-mspace></mjx-mstyle><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D434 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D447 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>P</mi><mi>S</mi></msub><mo>=</mo><mi>A</mi><mo stretchy=\"false\">(</mo><msup><mi>A</mi><mi>T</mi></msup><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mi>A</mi><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><msup><mi>A</mi><mi>T</mi></msup></math></mjx-assistive-mml></mjx-container> maps any vector <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"125\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D431 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2208\"></mjx-c></mjx-mo><mjx-msup space=\"4\"><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-ds mjx-b\"><mjx-c class=\"mjx-c211D TEX-A\"></mjx-c></mjx-mi></mjx-texatom><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w