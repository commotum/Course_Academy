owspacing=\"4pt\"><mtr><mtd><mn>9</mn></mtd><mtd><mn>6</mn></mtd><mtd><mn>12</mn></mtd></mtr><mtr><mtd><mn>6</mn></mtd><mtd><mn>4</mn></mtd><mtd><mn>8</mn></mtd></mtr><mtr><mtd><mn>12</mn></mtd><mtd><mn>8</mn></mtd><mtd><mn>16</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
