d}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{aligned}])}^{-1}[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{aligned}]{[\\begin{aligned}5 & 2 \\\\ 2 & 2\\end{aligned}]}^{-1}[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{aligned}]\\cdot \\frac{1}{6}[\\begin{aligned}2 & -2 \\\\ -2 & 5\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}1 & 0 \\\\ 0 & 1 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 & -2 & 2 \\\\ -2 & 5 & 1\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}2 & -2 & 2 \\\\ -2 & 5 & 1 \\\\ 2 & 1 & 5\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186476966 #edb/ref 1068 #edb/ref 17592186476870 #edb/ref 17592186045417] [17592186476966 #edb/ref 1069 "q-95199" #edb/ref 17592186045417] [17592186476966 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186476966 #edb/ref 1071 "Find a matrix that defines the orthogonal projection of ${R}^{3}$ onto the plane whose parametric equation is $r=sv+tw$, where\n\n$$\nv=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}],\\,w=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186476966 #edb/ref 1072 #uuid "db652323-dfa8-59de-a50e-77465a8c2c78" #edb/ref 17592186045417] [17592186476966 #edb/ref 1074 "Recall that the matrix ${P}_{S}=A({A}^{T}\\,A)^{-1}\\,{A}^{T}$ maps any vector $x\\in {R}^{n}$ onto its orthogonal projection in the subspace $S$ spanned by the columns of the matrix $A.$ \n\nNotice that the plane $r=sv+tw$ is actually the subspace $\\text{Span}\\{v,w\\}.$ \nHence, we have \n\n$$\nA=[\\begin{aligned}-1 & 1 \\\\ 1 & 1 \\\\ 1 & -1\\end{aligned}].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{P}_{S} & =A({A}^{T}\\,A)^{-1}\\,{A}^{T} \\\\  & =[\\begin{aligned}-1 & 1 \\\\ 1 & 1 \\\\ 1 & -1\\end{aligned}]{([\\begin{aligned}-1 & 1 & 1 \\\\ 1 & 1 & -1\\end{aligned}][\\begin{aligned}-1 & 1 \\\\ 1 & 1 \\\\ 1 & -1\\end{aligned}])}^{-1}[\\begin{aligned}-1 & 1 & 1 \\\\ 1 & 1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 1 \\\\ 1 & 1 \\\\ 1 & -1\\end{aligned}]{[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]}^{-1}[\\begin{aligned}-1 & 1 & 1 \\\\ 1 & 1 & -1\\end{aligned}] \\\\  & =\\frac{1}{8}[\\begin{aligned}-1 & 1 \\\\ 1 & 1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}3 & 1 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}-1 & 1 & 1 \\\\ 1 & 1 & -1\\end{aligned}] \\\\  & =\\frac{1}{8}[\\begin{aligned}-1 & 1 \\\\ 1 & 1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}-2 & 4 & 2 \\\\ 2 & 4 & -2\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}1 & 0 & -1 \\\\ 0 & 2 & 0 \\\\ -1 & 0 & 1\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417]}
