/ref 17592186527329 #edb/ref 17592186045417] [17592186527902 #edb/ref 1075 #edb/ref 17592186527333 #edb/ref 17592186045417] [17592186527902 #edb/ref 1075 #edb/ref 17592186527340 #edb/ref 17592186045417] [17592186527902 #edb/ref 1075 #edb/ref 17592186527365 #edb/ref 17592186045417] [17592186527902 #edb/ref 1075 #edb/ref 17592186527584 #edb/ref 17592186045417] [17592186527902 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186527902 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186527902 #edb/ref 1078 #edb/ref 17592186527584 #edb/ref 17592186045417] [17592186527902 #edb/ref 1079 #uuid "ef334055-d235-506e-a901-ee66a80f4e9e" #edb/ref 17592186045417] [17592186527906 #edb/ref 1075 #edb/ref 17592186527321 #edb/ref 17592186045417] [17592186527906 #edb/ref 1075 #edb/ref 17592186527396 #edb/ref 17592186045417] [17592186527906 #edb/ref 1075 #edb/ref 17592186527398 #edb/ref 17592186045417] [17592186527906 #edb/ref 1075 #edb/ref 17592186527676 #edb/ref 17592186045417] [17592186527906 #edb/ref 1075 #edb/ref 17592186527713 #edb/ref 17592186045417] [17592186527906 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186527906 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186527906 #edb/ref 1078 #edb/ref 17592186527398 #edb/ref 17592186045417] [17592186527906 #edb/ref 1079 #uuid "faa2ee71-4e17-514a-a333-0d36f72cde02" #edb/ref 17592186045417] [17592186527917 #edb/ref 1068 #edb/ref 17592186527884 #edb/ref 17592186045417] [17592186527917 #edb/ref 1069 "q-75282" #edb/ref 17592186045417] [17592186527917 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527917 #edb/ref 1071 "Find the equation of the tangent line to the polar curve $r=1-2\\operatorname{sin}⁡\\theta $ at $\\theta =\\pi ,$ given that\n\n$$\n\\begin{aligned}{y}^{′}(\\theta )=\\operatorname{cos}⁡\\theta -2\\operatorname{sin}⁡(2\\theta ),\\,{x}^{′}(\\theta )=-\\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡(2\\theta ).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527917 #edb/ref 1072 #uuid "0e54ebb5-b13c-5b43-a434-8a77b6f9b884" #edb/ref 17592186045417] [17592186527917 #edb/ref 1074 "To find the equation of the tangent line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\frac{\\text{d}y}{\\text{d}x}:$\n\nIn this case, we're given that\n\n$$\n\\begin{aligned}{y}^{′}(\\theta )=\\operatorname{cos}⁡\\theta -2\\operatorname{sin}⁡(2\\theta ),\\,{x}^{′}(\\theta )=-\\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡(2\\theta ).\\end{aligned}\n$$\n\nTherefore, we can find $\\frac{\\text{d}y}{\\text{d}x}$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & =\\frac{\\operatorname{cos}⁡\\theta -2\\operatorname{sin}⁡(2\\theta )}{-\\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡(2\\theta )}\\end{aligned}\n$$\n\n**Step 2**: Find the slope of the tangent at $P:$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi } \\\\  & =\\frac{\\operatorname{cos}⁡\\pi -2\\operatorname{sin}⁡(2\\pi )}{-\\operatorname{sin}⁡\\pi -2\\operatorname{cos}⁡(2\\pi )} \\\\  & =\\frac{-1-2\\cdot 0}{-0-2\\cdot 1} \\\\  & =\\frac{-1}{-2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P:$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =(1-2\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =(1-2\\operatorname{sin}⁡\\pi )\\operatorname{cos}⁡\\pi  \\\\  & =(1-0)\\cdot (-1) \\\\  & =-1 \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =(1-2\\operatorname{sin}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =(1-2\\operatorname{sin}⁡\\pi )\\operatorname{sin}⁡\\pi  \\\\  & =(1-0)\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(-1,0).$\n\n**Step 4**: Using point-slope form, find the equation of the tangent:\n\nWe find the equation of the tangent as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =\\frac{1}{2}\\cdot (x-(-1)) \\\\ y-0 & =\\frac{1}{2}\\cdot (x+1) \\\\ y & =\\frac{1}{2}x+\\frac{1}{2}\\end{aligned}\n$$\n\n![](images/70/7065086643b98b95b5d6face85544f33b00f73614a855fb9846ba68e5d987a33.png)" #edb/ref 17592186045417] [17592186527920 #edb/ref 1068 #edb/ref 17592186527829 #edb/ref 17592186045417] [17592186527920 #edb/ref 1069 "q-103902" #edb/ref 17592186045417] [17592186527920 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527920 #edb/ref 1071 "Let $f(x)=\\operatorname{ln}⁡x$ and let ${P}_{3}(x)$ be the third-degree Taylor polynomial of $f(x)$ about $x=1.$ Use the Lagrange error bound to find an upper bound for the error when ${P}_{3}(x)$ is used to approximate $\\operatorname{ln}⁡2.$" #edb/ref 17592186045417] [17592186527920 #edb/ref 1072 #uuid "15fdecd3-2bb4-5c94-a4a3-305e0c26984d" #edb/ref 17592186045417] [17592186527920 #edb/ref 1074 "The Lagrange error bound states that an upper bound for the error ${R}_{3}$ obtained when using the third-degree Taylor polynomial ${P}_{3}$ to approximate $f(x)$ is given by\n\n$$\n|{R}_{3}|\\le \\frac{M}{4!}|x-1{|}^{4},\n$$\n\nwhere $M$ is the maximum value of $|{f}^{(4)}(x)|$ on the interval between $a=1$ and $x=2.$ \n\nPlugging $x=2$ into the above formula gives\n\n$$\n\\begin{aligned}|{R}_{3}| & \\le \\frac{M}{4!}|2-1{|}^{4} \\\\ |{R}_{3}| & \\le \\frac{M}{24}|1{|}^{4}.\\end{aligned}\n$$\n\nTo find $M,$ we need to compute $|{f}^{(4)}(x)|$ and then maximize it on the interval $[1,2].$ Taking the derivatives, we get\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡x \\\\ {f}^{′}(x) & =\\frac{1}{x} \\\\ {f}^{″}(x) & =-\\frac{1}{{x}^{2}} \\\\ {f}^{‴}(x) & =\\frac{2}{{x}^{3}} \\\\ {f}^{(4)}(x) & =-\\frac{6}{{x}^{4}} \\\\ |{f}^{(4)}(x)| & =|-\\frac{6}{{x}^{4}}|=\\frac{6}{{x}^{4}}.\\end{aligned}\n$$\n\nSince $|{f}^{(4)}(x)|=\\frac{6}{{x}^{4}}$ is a decreasing function in the interval $[1,2],$  its value is greatest at $x=1.$ So\n\n$$\nM=|{f}^{(4)}(1)|=\\frac{6}{(1)^{4}}=6,\n$$\n\nand therefore, the upper bound is\n\n$$\n|{R}_{3}|\\le \\frac{6}{24}|1{|}^{4}=\\frac{1}{4}.\n$$" #edb/ref 17592186045417] [17592186527929 #edb/ref 1068 #edb/ref 17592186527887 #edb/ref 17592186045417] [17592186527929 #edb/ref 1069 "q-122387" #edb/ref 17592186045417] [17592186527929 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527929 #edb/ref 1071 "![](images/b8/b8e332d7f53868313cc589e4ce5e991d2bcce88d15613111c4d0f920b678830d.png)\n\nWhich expression gives the total finite area enclosed between the curves $x={y}^{4}$ and $x={y}^{2},$ as shown above?\n\n*(Note: Figure not drawn to scale)*" #edb/ref 17592186045417] [17592186527929 #edb/ref 1072 #uuid "33a96099-4464-57a6-87f9-11f8046b2b50" #edb/ref 17592186045417] [17592186527929 #edb/ref 1074 "Let $f(y)={y}^{4}$ and $g(y)={y}^{2}.$ First, we find the intersections of the two curves:\n\n$$\n\\begin{aligned}f(y) & =g(y) \\\\ {y}^{4} & ={y}^{2} \\\\ {y}^{4}-{y}^{2} & =0 \\\\ {y}^{2}({y}^{2}-1) & =0 \\\\ {y}^{2}(y-1)(y+1) & =0 \\\\ y & =-1,0,1\\end{aligned}\n$$\n\nThe area we want consists of two regions: ${A}_{1}$ and ${A}_{2}.$\n\n![](images/8b/8b4cbf07b9c2a6d949a58f39489889d2a3fdd4690664e530386f6f61d9aac5fd.png)\n\n- For the area ${A}_{1},$ we have $y\\in [-1,0],$ and the right function is $g(y)$ while the left function is $f(y).$ So, the area is given by\n\n$$\n\\begin{aligned}{A}_{1} & ={\\int }_{-1}^{0}(g(y)-f(y))\\,\\text{d}y \\\\  & ={\\int }_{-1}^{0}({y}^{2}-{y}^{4})\\,\\text{d}y.\\end{aligned}\n$$\n\n- For the area ${A}_{2},$ we have $y\\in [0,1],$ and the right function is $g(y)$ while the left function is $f(y).$ So, the area is given by\n\n$$\n\\begin{aligned}{A}_{2} & ={\\int }_{0}^{1}(g(y)-f(y))\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}({y}^{2}-{y}^{4})\\,\\text{d}y.\\end{aligned}\n$$\n\nTherefore, the required area is\n\n$$\n\\begin{aligned}A & ={A}_{1}+{A}_{2}={\\int }_{-1}^{0}({y}^{2}-{y}^{4})\\,\\text{d}y+{\\int }_{0}^{1}({y}^{2}-{y}^{4})\\,\\text{d}y.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527936 #edb/ref 1068 #edb/ref 17592186527898 #edb/ref 17592186045417] [17592186527936 #edb/ref 1069 "q-118775" #edb/ref 17592186045417] [17592186527936 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186527936 #edb/ref 1071 "Evaluate ${\\int }_{-\\infty }^{\\infty }\\frac{2}{1+4{x}^{2}}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186527936 #edb/ref 1072 #uuid "46e4a876-e7eb-598f-bbec-ff44b3be1391" #edb/ref 17592186045417] [17592186527936 #edb/ref 1074 "We break up the integral as follows:\n\n$$\n{\\int }_{-\\infty }^{\\infty }\\frac{2}{1+4{x}^{2}}\\,\\text{d}x={\\int }_{-\\infty }^{0}\\frac{2}{1+4{x}^{2}}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{2}{1+4{x}^{2}}\\,\\text{d}x.\n$$\n\nEvaluating the first of these integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{2}{1+4{x}^{2}}\\,\\text{d}x & =2{lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{1}{1+4{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}{lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{1}{{x}^{2}+{(\\frac{1}{2})}^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}{lim}_{a\\to -\\infty }(2\\operatorname{arctan}⁡(2x){|}_{a}^{0}) \\\\  & ={lim}_{a\\to -\\infty }(\\operatorname{arctan}⁡0-\\operatorname{arctan}⁡(2a)) \\\\  & =0-(-\\frac{\\pi }{2}) \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nNow, notice that the integrand is an **even** function. This means that we can immediately deduce that\n\n$$\n{\\int }_{0}^{\\infty }\\frac{2}{1+4{x}^{2}}\\,\\text{d}x=\\frac{\\pi }{2}.\n$$\n\nTherefore, since both improper integrals exist, we conclude that \n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\infty }\\frac{2}{1+4{x}^{2}}\\,\\text{d}x & ={\\int }_{-\\infty }^{0}\\frac{2}{1+4{x}^{2}}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{2}{1+4{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{\\pi }{2}+\\frac{\\pi }{2} \\\\  & =\\pi .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527939 #edb/ref 1068 #edb/ref 17592186527877 #edb/ref 17592186045417] [17592186527939 #edb/ref 1069 "q-11372" #edb/ref 17592186045417] [17592186527939 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527939 #edb/ref 1071 "Calculate $\\int \\frac{9x-38}{(4-x)^{2}(2-x)}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186527939 #edb/ref 1072 #uuid "504684ef-507d-57b1-81c3-7c9672d3e28f" #edb/ref 17592186045417] [17592186527939 #edb/ref 1074 "First, we convert the integrand into a sum of partial fractions:\n\n$$\n\\frac{9x-38}{(4-x)^{2}(2-x)}=\\frac{A}{(4-x)}+\\frac{B}{(4-x)^{2}}+\\frac{C}{(2-x)}\n$$\n\nTo determine the coefficients $A,$ $B,$ and $C,$ we first multiply both sides of the above equation by $(4-x)^{2}(2-x)$ and get\n\n$$\n9x-38=A(4-x)(2-x)+B(2-x)+C(4-x)^{2}.\n$$\n\nPlugging in $x=4,$ we can eliminate $A$ and $C$ and solve for $B:$\n\n$$\n\\begin{aligned}9(4)-38 & =A(4-4)(2-4)+B(2-4)+C(4-4)^{2} \\\\ 36-38 & =B(-2) \\\\ B & =\\frac{-2}{-2} \\\\ B & =1\\end{aligned}\n$$\n\nPlugging in $x=2,$ we can eliminate $A$ and $B$ and solve for $C:$\n\n$$\n\\begin{aligned}9(2)-38 & =A(4-2)(2-2)+B(2-2)+C(4-2)^{2} \\\\ 18-38 & =C{(2)}^{2} \\\\ C & =\\frac{-20}{4} \\\\ C & =-5\\end{aligned}\n$$\n\nPlugging in $x=0$ and substituting the known values of $B$ and $C,$ we can solve for $A:$\n\n$$\n\\begin{aligned}9(0)-38 & =A(4-0)(2-0)+B(2-0)+C(4-0)^{2} \\\\ -38 & =8A+2B+16C \\\\ -38 & =8A+2(1)+16(-5) \\\\ -38 & =8A-78 \\\\ 8A & =78-38 \\\\ A & =\\frac{40}{8} \\\\ A & =5\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{9x-38}{(4-x)^{2}(2-x)}=\\frac{5}{(4-x)}+\\frac{1}{(4-x)^{2}}-\\frac{5}{(2-x)}.\n$$\n\nFinally, we integrate this expression term by term, and get\n\n$$\n\\begin{aligned}\\int \\frac{9x-38}{(4-x)^{2}(2-x)}\\,\\text{d}x & =\\int (\\frac{5}{(4-x)}+\\frac{1}{(4-x)^{2}}-\\frac{5}{(2-x)})\\,\\text{d}x \\\\  & =5\\int \\frac{1}{4-x}\\,\\text{d}x+\\int \\frac{1}{(4-x)^{2}}\\,\\text{d}x-5\\int \\frac{1}{2-x}\\,\\text{d}x \\\\  & =-5\\operatorname{ln}⁡|4-x|+\\frac{1}{4-x}+5\\operatorname{ln}⁡|2-x|+K,\\end{aligned}\n$$\n\nwhere $K$ is an integral constant." #edb/ref 17592186045417] [17592186527956 #edb/ref 1068 #edb/ref 17592186527854 #edb/ref 17592186045417] [17592186527956 #edb/ref 1069 "q-83470" #edb/ref 17592186045417] [17592186527956 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527956 #edb/ref 1071 "The acceleration $a$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\na(t)=⟨4{e}^{2t},\\,9{e}^{3t}⟩.\n$$\n\nGiven that the particle is at the position $(1,1)$ and has velocity $⟨2,4⟩$ when $t=0,$ calculate the position vector of $P$ at time $t.$" #edb/ref 17592186045417] [17592186527956 #edb/ref 1072 #uuid "743918b2-4124-5be2-a1fd-716500b8cb35" #edb/ref 17592186045417] [17592186527956 #edb/ref 1074 "To compute the position vector, we need to integrate the velocity vector. To find the velocity vector, we first need to integrate the acceleration vector. \n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int ⟨4{e}^{2t},\\,9{e}^{3t}⟩\\text{d}t \\\\  & =⟨\\int 4{e}^{2t}\\,\\text{d}t,\\int 9{e}^{3t}\\,\\text{d}t⟩ \\\\  & =⟨2{e}^{2t}+{C}_{1},\\,3{e}^{3t}+{C}_{2}⟩\\end{aligned}\n$$\n\nWe can solve for the constants of integration using the fact that $v(0)=⟨2,4⟩.$ Substituting $t=0,$ we get\n\n$$\n\\begin{aligned}v(0) & =⟨2{e}^{2(0)}+{C}_{1},\\,3{e}^{3(0)}+{C}_{2}⟩ \\\\ ⟨2,4⟩ & =⟨2+{C}_{1},3+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=0$ and ${C}_{2}=1.$ Therefore, the velocity vector is\n\n$$\nv(t)=⟨2{e}^{2t},\\,3{e}^{3t}+1⟩.\n$$\n\nWe can compute the position vector by integrating the velocity vector.\n\n$$\n\\begin{aligned}r(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int ⟨2{e}^{2t},\\,3{e}^{3t}+1⟩\\,\\text{d}t \\\\  & =⟨\\int 2{e}^{2t}\\,\\text{d}t,\\int (3{e}^{3t}+1)\\,\\text{d}t⟩ \\\\  & =⟨{e}^{2t}+{C}_{3},\\,{e}^{3t}+t+{C}_{4}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $r(0)=⟨1,1⟩.$ Substituting $t=0,$ we get\n\n$$\n\\begin{aligned}r(0) & =⟨{e}^{2(0)}+{C}_{3},\\,{e}^{3(0)}+0+{C}_{4}⟩ \\\\ ⟨1,1⟩ & =⟨1+{C}_{3},\\,1+{C}_{4}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{3}={C}_{4}=0.$ Therefore, the position of $P$ at time $t$ is\n\n$$\nr(t)=⟨{e}^{2t},\\,{e}^{3t}+t⟩.\n$$" #edb/ref 17592186045417] [17592186527958 #edb/ref 1068 #edb/ref 17592186527814 #edb/ref 17592186045417] [17592186527958 #edb/ref 1069 "q-50330" #edb/ref 17592186045417] [17592186527958 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527958 #edb/ref 1071 "![](images/31/31d4236bf58cd579c49c7259c32a2a9171e07c771b4c34040ac92896809f695f.png)\n\nThe region enclosed by the curves $x=\\frac{2}{y}$ and $x=3-y$ is rotated $2\\pi $ radians about the line $x=-2.$ Which of the following gives the volume of the resulting solid?" #edb/ref 17592186045417] [17592186527958 #edb/ref 1072 #uuid "7bcaaf90-d33e-5a2f-9583-78877f436c71" #edb/ref 17592186045417] [17592186527958 #edb/ref 1074 "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}\\frac{2}{y} & =3-y \\\\ 2 & =3y-{y}^{2} \\\\ {y}^{2}-3y+2 & =0 \\\\ (y-1)(y-2) & =0 \\\\ y & =1,2\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=1$ to $y=2.$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/b7/b73c341f4d09b1df7bea162bc7dbe10d0ee60920c847f9c24210386a3d139e61.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=\\frac{2}{y},$ and\n\n- *leaves* through the outer curve $x=3-y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=3-y.$\n\n![](images/c8/c8c8e766c66e47a54f316f54893d603b245acec8f529da3a5033d2bba547a319.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{1}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}[\\,(3-y)-(-2)\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}{[5-y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=\\frac{2}{y}.$\n\n![](images/1b/1b31331f1c0da353bee6fe29d10e9e58dd531cbc8152cbce214d1adea771b032.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{1}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}{[\\,(\\frac{2}{y})-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}{[\\frac{2}{y}+2]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{1}^{2}{[5-y]}^{2}\\,\\text{d}y-\\pi {\\int }_{1}^{2}{[\\frac{2}{y}+2]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}({[5-y]}^{2}-{[\\frac{2}{y}+2]}^{2})\\text{d}y.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527964 #edb/ref 1068 #edb/ref 17592186527873 #edb/ref 17592186045417] [17592186527964 #edb/ref 1069 "q-10207" #edb/ref 17592186045417] [17592186527964 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186527964 #edb/ref 1071 "![](images/d4/d4bcdb6515b262c070c7ed689263efbbde8a350ad6a28b4fc106de281e69ff46.png)\n\nFind the area bounded between the curve defined parametrically as\n\n$$\nx=2t,\\,y=t\\operatorname{sin}⁡t\n$$\n\nand the $x$-axis for $t\\in [0,\\pi ].$" #edb/ref 17592186045417] [17592186527964 #edb/ref 1072 #uuid "8222fa21-5fa3-52f1-a894-4b100aeb534d" #edb/ref 17592186045417] [17592186527964 #edb/ref 1074 "The unsigned area bounded by the parametric curve \n\n$$\nx=x(t),\\,y=y(t),\\,{t}_{1}\\le t\\le {t}_{2}\n$$\n\nand the $x$-axis is given by the absolute value of the integral\n\n$$\n{\\int }_{{t}_{1}}^{{t}_{2}}y\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t.\n$$\n\nFirst, we compute\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2t) \\\\  & =2.\\end{aligned}\n$$\n\nSo, we obtain the integral expression\n\n$$\n\\begin{aligned}{\\int }_{{t}_{1}}^{{t}_{2}}y\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & ={\\int }_{0}^{\\pi }t\\operatorname{sin}⁡t\\cdot 2\\,\\text{d}t \\\\  & =2{\\int }_{0}^{\\pi }t\\operatorname{sin}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nNotice that this integral will give us a positive number since $y\\frac{\\text{d}x}{\\text{d}t}\\ge 0$ for all $t\\in [0,\\pi ].$\n\nTo solve the above integral, we use integration by parts. We set\n\n$$\n\\begin{aligned}u=t & ⇒ & {u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡t & ⇒ & v=-\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}2{\\int }_{0}^{\\pi }t\\operatorname{sin}⁡t\\,\\text{d}t & =2t(-\\operatorname{cos}⁡t)\\,{|}_{0}^{\\pi }-2{\\int }_{0}^{\\pi }(-\\operatorname{cos}⁡t)(1)\\,\\text{d}t \\\\  & =-2t\\operatorname{cos}⁡t\\,{|}_{0}^{\\pi }+2{\\int }_{0}^{\\pi }\\operatorname{cos}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, the area is\n\n$$\n\\begin{aligned}A & =2{\\int }_{0}^{\\pi }t\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =-2t\\operatorname{cos}⁡t\\,{|}_{0}^{\\pi }+2{\\int }_{0}^{\\pi }\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =-2t\\operatorname{cos}⁡t\\,{|}_{0}^{\\pi }+2\\operatorname{sin}⁡t\\,{|}_{0}^{\\pi } \\\\  & =-2(\\pi \\operatorname{cos}⁡\\pi -0\\operatorname{cos}⁡0)+2(\\operatorname{sin}⁡\\pi -\\operatorname{sin}⁡0) \\\\  & =-2\\pi (-1) \\\\  & =2\\pi .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527967 #edb/ref 1068 #edb/ref 17592186527868 #edb/ref 17592186045417] [17592186527967 #edb/ref 1069 "q-84409" #edb/ref 17592186045417] [17592186527967 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527967 #edb/ref 1071 "Kevin is moving his car in a straight line. His position relative to a fixed origin $O$ is given by the function $x(t)=2{e}^{t/2}\\,\\text{m},$ where $t$ is the time in seconds. Find its average position between $2$ and $6$ seconds." #edb/ref 17592186045417] [17592186527967 #edb/ref 1072 #uuid "881af2f1-aaf5-5e5d-a46a-df43ce3ea5ee" #edb/ref 17592186045417] [17592186527967 #edb/ref 1074 "To calculate the average value of the position on $[{t}_{1},{t}_{2}],$ we use the average value formula\n\n$$\n{x}_{\\text{avg}}=\\frac{1}{{t}_{2}-{t}_{1}}\\,{\\int }_{{t}_{1}}^{{t}_{2}}x(t)\\,\\text{d}t.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}{x}_{\\text{avg}} & =\\frac{1}{6-2}\\,{\\int }_{2}^{6}2{e}^{t/2}\\text{d}t \\\\  & =\\frac{1}{4}\\cdot {2\\cdot 2({e}^{t/2})|}_{2}^{6} \\\\  & ={e}^{6/2}-{e}^{2/2} \\\\  & ={e}^{3}-e.\\end{aligned}\n$$\n\nTherefore, the average position is $({e}^{3}-e)\\,\\text{m}.$" #edb/ref 17592186045417] [17592186527970 #edb/ref 1068 #edb/ref 17592186527883 #edb/ref 17592186045417] [17592186527970 #edb/ref 1069 "q-79877" #edb/ref 17592186045417] [17592186527970 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527970 #edb/ref 1071 "![](images/49/49b119b378ac4f45c0c395ca77c5cefead3a7c811295b51ac8eaa8aef7100e25.png)\n\nThe base of a solid is the region enclosed by the curves $y=1-{x}^{2}$ and $y=-1,$  as shown in the picture. Cross-sections perpendicular to the $x$-axis are rectangles. If the height of each rectangle is $2$ times the length of its base, which integral gives the volume of the solid?" #edb/ref 17592186045417] [17592186527970 #edb/ref 1072 #uuid "8deca7b4-0aaf-504b-958b-1e6e90c74a93" #edb/ref 17592186045417] [17592186527970 #edb/ref 1074 "Let $f(x)=1-{x}^{2}$ and $g(x)=-1.$\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the two curves by setting the functions equal to one another and solving for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 1-{x}^{2} & =-1 \\\\ {x}^{2} & =2\\end{aligned}\n$$\n\nHence, the limit of integration are $x=-\\sqrt{2}$ and $x=\\sqrt{2}.$\n\nNow, consider a cross-section at some point $x$, where $x\\in (-\\sqrt{2},\\sqrt{2})$,  and its projection on the $xy$-plane: \n\n![](images/0c/0c2a676ecc781a2a7a78870eb93ee9fbe5a89a7bd754a446231c6e3237f75831.png)\n\nThe base of the cross-section is\n\n$$\n\\begin{aligned}b & =|f(x)-g(x)| \\\\  & =|1-{x}^{2}-(-1)| \\\\  & =|2-{x}^{2}|.\\end{aligned}\n$$\n\nThe area of a rectangle is\n$A=bh.$\n  So, since we have $h=2b,$ the expression for the area of the cross-section is\n\n$$\n\\begin{aligned}A(x) & =bh \\\\  & =2{b}^{2} \\\\  & =2{(2-{x}^{2})}^{2} \\\\  & =8-8{x}^{2}+2{x}^{4}.\\end{aligned}\n$$\n\nWe can now calculate the volume of the solid, as follows:\n\n$$\n\\begin{aligned}V & ={\\int }_{c}^{d}A(x)\\,\\text{d}x \\\\  & ={\\int }_{-\\sqrt{2}}^{\\sqrt{2}}(8-8{x}^{2}+2{x}^{4})\\text{d}x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527994 #edb/ref 1068 #edb/ref 17592186527906 #edb/ref 17592186045417] [17592186527994 #edb/ref 1069 "q-96454" #edb/ref 17592186045417] [17592186527994 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527994 #edb/ref 1071 "Calculate $\\int \\frac{{tanh}^{2}⁡(3x-2)}{3}\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186527994 #edb/ref 1072 #uuid "cef928b3-a5b9-5b14-83bc-17bf537996f2" #edb/ref 17592186045417] [17592186527994 #edb/ref 1074 "First, we find the hyperbolic identity that corresponds to the secant-tangent identity \n\n$$\n1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta .\n$$\n\nUsing Osborn's rule, we get the hyperbolic secant-tangent identity:\n\n$$\n1-{tanh}^{2}⁡\\theta ={sech}^{2}⁡\\theta \n$$\n\nSetting $\\theta =3x-2,$ we get \n\n$$\n\\begin{aligned}1-{tanh}^{2}⁡(3x-2) & ={sech}^{2}⁡(3x-2) \\\\ {tanh}^{2}⁡(3x-2) & =1-{sech}^{2}⁡(3x-2).\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int \\frac{{tanh}^{2}⁡(3x-2)}{3}\\,\\text{d}x & =\\frac{1}{3}\\int (1-{sech}^{2}⁡(3x-2))\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int 1\\cdot \\text{d}x-\\frac{1}{3}\\int {sech}^{2}⁡(3x-2)\\,\\text{d}x \\\\  & =\\frac{x}{3}-\\frac{1}{9}\\operatorname{tanh}⁡(3x-2)+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186527995 #edb/ref 1068 #edb/ref 17592186527819 #edb/ref 17592186045417] [17592186527995 #edb/ref 1069 "q-120180" #edb/ref 17592186045417] [17592186527995 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186527995 #edb/ref 1071 "Consider the finite region bounded by the curve $y=\\sqrt{x+2}$ and the $y$-axis from $y=2$ to $y=3.$ Which integral gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $y$-axis?" #edb/ref 17592186045417] [17592186527995 #edb/ref 1072 #uuid "d18dd5ed-e185-5cfc-926d-0d7b2a92c6df" #edb/ref 17592186045417] [17592186527995 #edb/ref 1074 "The volume of the solid generated when the region bounded by a curve $x=g(y),$ the $y$-axis, and the horizontal lines $y=c$ and $y=d$ is rotated $2\\pi $ radians about the $y$-axis is given by\n\n$$\nV=\\pi {\\int }_{c}^{d}[g(y)]^{2}\\text{d}y.\n$$\n\nFirst, we write our equation in terms of $y:$\n\n$$\n\\begin{aligned}y & =\\sqrt{x+2} \\\\ {y}^{2} & =x+2 \\\\ x & ={y}^{2}-2\\end{aligned}\n$$\n\nSo, in our example, $g(y)={y}^{2}-2$ and the limits of integration are from $y=2$ to $y=3.$\n\nFinally, the volume can be found as follows:\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{c}^{d}{[g(y)]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{2}^{3}{({y}^{2}-2)}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{2}^{3}({y}^{4}-4{y}^{2}+4)\\,\\text{d}y\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186528003 #edb/ref 1068 #edb/ref 17592186527901 #edb/ref 17592186045417] [17592186528003 #edb/ref 1069 "q-73332" #edb/ref 17592186045417] [17592186528003 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186528003 #edb/ref 1071 "Evaluate the integral ${\\int }_{1}^{2}x\\sqrt{{x}^{2}-1}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186528003 #edb/ref 1072 #uuid "dc80cc6c-733b-50ec-85a0-e9f5b6f29bef" #edb/ref 17592186045417] [17592186528003 #edb/ref 1074 "Let $u={x}^{2}-1.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,x\\text{d}x=\\frac{\\text{d}u}{2}.\n$$\n\nComputing our limits of integration, we get\n\n| **$x$** | $1$ | $2$ |\n| --- | --- | --- |\n| **$u$** | $0$ | $3$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}x\\sqrt{{x}^{2}-1}\\,\\text{d}x & ={\\int }_{1}^{2}\\sqrt{{x}^{2}-1}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}\\sqrt{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{0}^{3}\\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}{(\\frac{2{u}^{3/2}}{3})|}_{0}^{3} \\\\  & ={\\frac{{u}^{3/2}}{3}|}_{0}^{3} \\\\  & =\\frac{{3}^{3/2}}{3}-\\frac{{0}^{3/2}}{3} \\\\  & =\\sqrt{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186528009 #edb/ref 1068 #edb/ref 17592186527872 #edb/ref 17592186045417] [17592186528009 #edb/ref 1069 "q-83878" #edb/ref 17592186045417] [17592186528009 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186528009 #edb/ref 1071 "The rate of growth in the frog population $P(t)$ in a certain lake follows the logistic growth model\n\n$$\n\\frac{dP}{dt}=0.1P(5\\,000-P),\n$$\n\nwhere $t$ is the time, in years. Find an expression for the frog population after $t$ years, given that there were $100$ frogs initially." #edb/ref 17592186045417] [17592186528009 #edb/ref 1072 #uuid "ea94a739-28fe-50a1-b5d4-4f34307441cf" #edb/ref 17592186045417] [17592186528009 #edb/ref 1074 "A logistic growth equation has the form\n\n$$\n\\frac{dP}{dt}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nThe general solution to the logistic growth equation is\n\n$$\nP(t)=\\frac{a}{1+C{e}^{-akt}}.\n$$\n\nIn this case, the constant of proportionality is $k=0.1,$ and the carrying capacity is $a=5\\,000.$ \n\nTherefore, the general solution to our equation is\n\n$$\nP(t)=\\frac{5\\,000}{1+C{e}^{-(5\\,000\\cdot 0.1)t}}=\\frac{5\\,000}{1+C{e}^{-500t}}.\n$$\n\nWe now substitute the initial condition $P(0)=100$ and solve for $C.$ We get\n\n$$\n\\begin{aligned}\\frac{5\\,000}{1+C{e}^{-500\\cdot 0}} & =100 \\\\ 1+C & =\\frac{5\\,000}{100} \\\\ C & =50-1 \\\\  & =49.\\end{aligned}\n$$\n\nSo, we have\n\n$$\nP(t)=\\frac{5\\,000}{1+49{e}^{-500t}}.\n$$" #edb/ref 17592186045417] [17592186528016 #edb/ref 1062 #uuid "240bde0a-edd2-5c94-9c50-9f441bdb08ef" #edb/ref 17592186045417] [17592186528016 #edb/ref 1063 #edb/ref 17592186527929 #edb/ref 17592186045417] [17592186528018 #edb/ref 1062 #uuid "2e35343d-8855-5067-afba-636871de1ae6" #edb/ref 17592186045417] [17592186528018 #edb/ref 1063 #edb/ref 17592186527958 #edb/ref 17592186045417] [17592186528019 #edb/ref 1062 #uuid "2edaff19-4811-510a-9c53-a513b91ee9dc" #edb/ref 17592186045417] [17592186528019 #edb/ref 1063 #edb/ref 17592186188542 #edb/ref 17592186045417] [17592186528020 #edb/ref 1062 #uuid "32e5e4c0-83cd-51ce-a8af-0eb4cc07ace8" #edb/ref 17592186045417] [17592186528020 #edb/ref 1063 #edb/ref 17592186234032 #edb/ref 17592186045417] [17592186528021 #edb/ref 1062 #uuid "3e9453b3-3741-5c8a-8ead-49704c0ce73e" #edb/ref 17592186045417] [17592186528021 #edb/ref 1063 #edb/ref 17592186527994 #edb/ref 17592186045417] [17592186528023 #edb/ref 1062 #uuid "53705ca3-b02d-5e95-925f-dae53d78647f" #edb/ref 17592186045417] [17592186528023 #edb/ref 1063 #edb/ref 17592186527939 #edb/ref 17592186045417] [17592186528024 #edb/ref 1062 #uuid "5804b103-5606-587e-abd2-0a03c2202262" #edb/ref 17592186045417] [17592186528024 #edb/ref 1063 #edb/ref 17592186527936 #edb/ref 17592186045417] [17592186528026 #edb/ref 1062 #uuid "5b2f746e-59e2-5415-8c88-32df5e809be7" #edb/ref 17592186045417] [17592186528026 #edb/ref 1063 #edb/ref 17592186527995 #edb/ref 17592186045417] [17592186528027 #edb/ref 1062 #uuid "5cd64603-ba44-5341-ad01-ca7767310751" #edb/ref 17592186045417] [17592186528027 #edb/ref 1063 #edb/ref 17592186527964 #edb/ref 17592186045417] [17592186528028 #edb/ref 1062 #uuid "5e7feaa4-b8d9-5448-8303-cd1422a89e2b" #edb/ref 17592186045417] [17592186528028 #edb/ref 1063 #edb/ref 17592186234373 #edb/ref 17592186045417] [17592186528029 #edb/ref 1062 #uuid "672645cd-294c-5987-920e-81f646ed0740" #edb/ref 17592186045417] [17592186528029 #edb/ref 1063 #edb/ref 17592186351476 #edb/ref 17592186045417] [17592186528033 #edb/ref 1062 #uuid "797a3a82-2ac7-5e67-8bc3-05f3eb5bdc68" #edb/ref 17592186045417] [17592186528033 #edb/ref 1063 #edb/ref 17592186528009 #edb/ref 17592186045417] [17592186528037 #edb/ref 1062 #uuid "8eb95567-cedc-5ed3-904e-251e8cbbb1f0" #edb/ref 17592186045417] [17592186528037 #edb/ref 1063 #edb/ref 17592186101458 #edb/ref 17592186045417] [17592186528038 #edb/ref 1062 #uuid "969393d9-e073-55ff-b0f0-afacbb8b2211" #edb/ref 17592186045417] [17592186528038 #edb/ref 1063 #edb/ref 17592186527917 #edb/ref 17592186045417] [17592186528039 #edb/ref 1062 #uuid "99855eb4-1a2f-577f-9380-cf59936c9dff" #edb/ref 17592186045417] [17592186528039 #edb/ref 1063 #edb/ref 17592186399384 #edb/ref 17592186045417] [17592186528040 #edb/ref 1062 #uuid "9e830132-16cf-5d39-b4af-edcf784ec17c" #edb/ref 17592186045417] [17592186528040 #edb/ref 1063 #edb/ref 17592186527956 #edb/ref 17592186045417] [17592186528042 #edb/ref 1062 #uuid "bf1cf1cc-9e0a-54e5-b0bd-522e2d64cd52" #edb/ref 17592186045417] [17592186528042 #edb/ref 1063 #edb/ref 17592186527967 #edb/ref 17592186045417] [17592186528043 #edb/ref 1062 #uuid "bf9db98f-b58f-5afd-b4e7-7c89477ea4c3" #edb/ref 17592186045417] [17592186528043 #edb/ref 1063 #edb/ref 17592186527920 #edb/ref 17592186045417] [17592186528044 #edb/ref 1062 #uuid "cf763070-22bc-59f4-804a-e6a5cae8fe8f" #edb/ref 17592186045417] [17592186528044 #edb/ref 1063 #edb/ref 17592186256380 #edb/ref 17592186045417] [17592186528045 #edb/ref 1062 #uuid "d14a89a4-619d-505a-8391-cb54838fdafe" #edb/ref 17592186045417] [17592186528045 #edb/ref 1063 #edb/ref 17592186341961 #edb/ref 17592186045417] [175921865