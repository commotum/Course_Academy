x-frac></mjx-mfrac></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>y</mi><mo data-mjx-alternate=\"1\">′</mo></msup><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>x</mi><mi>y</mi></mfrac></mstyle></math></mjx-assistive-mml></mjx-container> </li></ol></div><table class=\"questionWidget-choicesTable\"><tbody><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-120282-a\" class=\"questionWidget-choiceLetterCircle\" style=\"background: rgb(64, 64, 64); color: white;\">a</div></td><td class=\"questionWidget-choiceText\">III only</td></tr><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-120282-b\" class=\"questionWidget-choiceLetterCircle\">b</div></td><td class=\"questionWidget-choiceText\">I and II only</td></tr><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-120282-c\" class=\"questionWidget-choiceLetterCircle\">c</div></td><td class=\"questionWidget-choiceText\">II and III only</td></tr><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-120282-d\" class=\"questionWidget-choiceLetterCircle\">d</div></td><td class=\"questionWidget-choiceText\">I only</td></tr><tr><td class=\"questionWidget-choiceLetter\"><div id=\"questionWidget-choiceLetterCircle-120282-e\" class=\"questionWidget-choiceLetterCircle\">e</div></td><td class=\"questionWidget-choiceText\">II only</td></tr></tbody></table><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-skipButton\" style=\"display: none;\">Don't Know</div><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div class=\"questionWidget-spinner\" style=\"display: block;\"></div></div><div class=\"questionWidget-result\"><div class=\"questionWidget-correctIncorrectIcon\"><img src=\"/img/correct-answer.svg\"></div><div class=\"questionWidget-correctText\">Correct</div></div><div class=\"questionWidget-explanationHeader\">EXPLANATION</div><div class=\"questionWidget-explanation\"><div id=\"graphic-q-120282-e-0\" class=\"graphic\"><img src=\"/graphics/q-120282-e-0\"></div>\n\n<p>Notice the following properties of the given slope field:</p>\n<ul>\n<li><p>For <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"412\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2260\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>≠</mo><mn>0</mn><mo>,</mo></math></mjx-assistive-mml></mjx-container> the slopes of the slope field become horizontal at <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"413\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>0</mn></math></mjx-assistive-mml></mjx-container> only.</p>\n</li>\n<li><p>For <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"414\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2260\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>≠</mo><mn>0</mn><mo>,</mo></math></mjx-assistive-mml></mjx-container> the slopes of the slope field become vertical as <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"415\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mn>0.</mn></math></mjx-assistive-mml></mjx-container></p>\n</li>\n</ul>\n<p>With that in mind, let's consider each equation.</p>\n<ul>\n<li><p>Equation I does <em>not</em> give the required behavior. The right-hand side of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"416\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mo class=\"mjx-var\" size=\"s\"><mjx-c class=\"mjx-c2032\"></mjx-c></mjx-mo></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\">