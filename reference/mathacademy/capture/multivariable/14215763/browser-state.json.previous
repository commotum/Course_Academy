><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><msqrt><mn>2</mn></msqrt></mrow><mrow data-mjx-texclass=\"ORD\"><msqrt><mn>2</mn></msqrt></mrow></msubsup><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>8</mn><mo>−</mo><mn>8</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><msup><mi>x</mi><mn>4</mn></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mtext>d</mtext><mi>x</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
