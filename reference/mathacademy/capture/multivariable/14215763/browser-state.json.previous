      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14215763/observations/diagnostic-12-6d38daaf37d855fff7af.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14215763/observations/diagnostic-12-6d38daaf37d855fff7af.png",
      "source_url": "https://mathacademy.com/tasks/14215763/diagnostics/504116",
