      "extraction_error_parts": {},
      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14215763/observations/diagnostic-15-7442e4545192581124e0.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14215763/observations/diagnostic-15-7442e4545192581124e0.png",
      "source_url": "https://mathacademy.com/tasks/14215763/diagnostics/504116",
      "captured_at": 1792013732.5264146,
      "math_academy_id": "q-96454",
      "topic_id": null,
      "sequence_position": 15,
