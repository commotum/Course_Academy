ta-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>n</mi><mo stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi></mrow></munder><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">|</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><mn>5</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mrow><mo stretchy=\"false\">(</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mi>n</mi><mo>+</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle><mo>⋅</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>n</mi><mo stretchy=\"false\">(</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><mn>5</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mi>n</mi></mrow></msup></mrow></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>n</mi><mo stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi></mrow></munder><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">|</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>n</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><mn>5</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mi>x</mi><mo>+</mo><mn>5</mn><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>n</mi><mo stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mi>n</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mi>x</mi><mo>+</mo><mn>5</mn><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>n</mi><mo stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi></mrow></munder><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>1</mn><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mi>n</mi></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mi>x</mi><mo>+</mo><mn>5</mn><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mo>⋅</mo><mn>1</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><mi>x</mi><mo>+</mo><mn>5</mn><mo stretchy=\"false\">|</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>The series converges if <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"318\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D43F TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3C\"></mjx