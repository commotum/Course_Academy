      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14215763/observations/diagnostic-16-2caca7023be262c593dc.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14215763/observations/diagnostic-16-2caca7023be262c593dc.png",
      "source_url": "https://mathacademy.com/tasks/14215763/diagnostics/504116",
      "captured_at": 1792013748.0359182,
