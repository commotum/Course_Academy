f1f" #edb/ref 17592186045417] [17592186551086 #edb/ref 1075 #edb/ref 17592186550408 #edb/ref 17592186045417] [17592186551086 #edb/ref 1075 #edb/ref 17592186550756 #edb/ref 17592186045417] [17592186551086 #edb/ref 1075 #edb/ref 17592186550938 #edb/ref 17592186045417] [17592186551086 #edb/ref 1075 #edb/ref 17592186550980 #edb/ref 17592186045417] [17592186551086 #edb/ref 1075 #edb/ref 17592186550987 #edb/ref 17592186045417] [17592186551086 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186551086 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186551086 #edb/ref 1078 #edb/ref 17592186550987 #edb/ref 17592186045417] [17592186551086 #edb/ref 1079 #uuid "25a7cb9f-7a09-5793-9cb0-c7d79f0245b3" #edb/ref 17592186045417] [17592186551117 #edb/ref 1075 #edb/ref 17592186550380 #edb/ref 17592186045417] [17592186551117 #edb/ref 1075 #edb/ref 17592186550493 #edb/ref 17592186045417] [17592186551117 #edb/ref 1075 #edb/ref 17592186550887 #edb/ref 17592186045417] [17592186551117 #edb/ref 1075 #edb/ref 17592186550935 #edb/ref 17592186045417] [17592186551117 #edb/ref 1075 #edb/ref 17592186551025 #edb/ref 17592186045417] [17592186551117 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186551117 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186551117 #edb/ref 1078 #edb/ref 17592186550887 #edb/ref 17592186045417] [17592186551117 #edb/ref 1079 #uuid "5784eef9-0ad2-5040-8dd4-135f8ec74797" #edb/ref 17592186045417] [17592186551139 #edb/ref 1075 #edb/ref 17592186550376 #edb/ref 17592186045417] [17592186551139 #edb/ref 1075 #edb/ref 17592186550482 #edb/ref 17592186045417] [17592186551139 #edb/ref 1075 #edb/ref 17592186550568 #edb/ref 17592186045417] [17592186551139 #edb/ref 1075 #edb/ref 17592186550953 #edb/ref 17592186045417] [17592186551139 #edb/ref 1075 #edb/ref 17592186550995 #edb/ref 17592186045417] [17592186551139 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186551139 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186551139 #edb/ref 1078 #edb/ref 17592186550953 #edb/ref 17592186045417] [17592186551139 #edb/ref 1079 #uuid "7cbcd786-caa3-5353-bd0b-1dabaa09f399" #edb/ref 17592186045417] [17592186551239 #edb/ref 1068 #edb/ref 17592186551139 #edb/ref 17592186045417] [17592186551239 #edb/ref 1069 "q-41739" #edb/ref 17592186045417] [17592186551239 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186551239 #edb/ref 1071 "A physics experiment consists of a small object moving along a straight line. The following table contains data collected on the distance traveled by the object (in inches) during the first five seconds. \n\n| Time $(x)$ | **$1$** | **$2$** | **$3$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| Distance $(y)$ | $8.6$ | $13.1$ | $24.6$ | $28.1$ | $38.6$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above. According to the model, what distance will the object cover after $6$ seconds, assuming the trend continues? \n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{10}[\\begin{aligned}11 & -3 \\\\ -3 & 1\\end{aligned}],\\,{X}^{T}y=[\\begin{aligned}113 \\\\ 414\\end{aligned}],\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" #edb/ref 17592186045417] [17592186551239 #edb/ref 1072 #uuid "1515bb33-4938-5f32-8710-f2dc1f06ddad" #edb/ref 17592186045417] [17592186551239 #edb/ref 1074 "The coefficients of the line that best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & 1 \\\\ 1 & 2 \\\\ 1 & 3 \\\\ 1 & 4 \\\\ 1 & 5\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}8.6 \\\\ 13.1 \\\\ 24.6 \\\\ 28.1 \\\\ 38.6\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\overset{^}{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\overset{^}{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\overset{^}{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{10}[\\begin{aligned}11 & -3 \\\\ -3 & 1\\end{aligned}]\\cdot [\\begin{aligned}113 \\\\ 414\\end{aligned}] \\\\  & =[\\begin{aligned}0.1 \\\\ 7.5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have the line $y=0.1+7.5x.$\n\nFinally, to predict the distance the object will cover after $6$ seconds, we substitute $x=6$ into the equation of the line:\n\n$$\n\\begin{aligned}y & =0.1+7.5(6) \\\\  & =45.1\\end{aligned}\n$$\n\nSo, according to the model, the object will cover a distance of $45.1$ inches in $6$ seconds.  \n\n**Note**: Since we're extrapolating ($x=6$ is not within the range of the original set of $x$-values), our result *may* be unreliable." #edb/ref 17592186045417] [17592186551337 #edb/ref 1068 #edb/ref 17592186551117 #edb/ref 17592186045417] [17592186551337 #edb/ref 1069 "q-41401" #edb/ref 17592186045417] [17592186551337 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186551337 #edb/ref 1071 "The height (in feet) and the average number of points scored per game (APG) of four players on a basketball team are shown in the following table. \n\n| Height $(x)$ | **$6$** | **$6.5$** | **$6.5$** | **$7$** |\n| --- | --- | --- | --- | --- |\n| APG $(y)$ | $5$ | $8$ | $10$ | $10$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above. According to the model, what will be the average number of points scored per game by a player whose height is $6.45\\,\\text{ft}?$\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=[\\begin{aligned}84.75 & -13 \\\\ -13 & 2\\end{aligned}],\\,{X}^{T}y=[\\begin{aligned}33 \\\\ 217\\end{aligned}],\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" #edb/ref 17592186045417] [17592186551337 #edb/ref 1072 #uuid "d6dbf98c-84c4-5c67-a15a-4f405cbbd0b5" #edb/ref 17592186045417] [17592186551337 #edb/ref 1074 "The coefficients of the line that best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & 6 \\\\ 1 & 6.5 \\\\ 1 & 6.5 \\\\ 1 & 7\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}5 \\\\ 8 \\\\ 10 \\\\ 10\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\overset{^}{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\overset{^}{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\n \n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\overset{^}{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =[\\begin{aligned}84.75 & -13 \\\\ -13 & 2\\end{aligned}][\\begin{aligned}33 \\\\ 217\\end{aligned}] \\\\  & =[\\begin{aligned}-24.25 \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have the line $y=-24.25+5x.$ \n\nFinally, to predict the average number of points scored per game by a player whose height is $6.45\\,\\text{ft},$  we substitute $x=6.45$ into the equation of the line:\n\n$$\n\\begin{aligned}y & =-24.25+5(6.45) \\\\  & =8\\end{aligned}\n$$\n\nSo, according to the model,  the average number of points scored per game by a player whose height is $6.45\\,\\text{ft}$ will be $8$  points per game." #edb/ref 17592186045417] [17592186551350 #edb/ref 1068 #edb/ref 17592186551086 #edb/ref 17592186045417] [17592186551350 #edb/ref 1069 "q-139577" #edb/ref 17592186045417] [17592186551350 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186551350 #edb/ref 1071 "| $x$ | **$-3$** | **$-2$** | **$-1$** | **$0$** | **$1$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-7$ | $-4$ | $2$ | $5$ | $10$ |\n\nThe vector of coefficients  of the line $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above can be found using linear regression as \n\n$$\n[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]=({X}^{T}\\,X)^{-1}{X}^{T}y,\n$$\n\nwhere $X$ is the corresponding design matrix and $y$ is the observation vector. Which of the following is the observation vector $y$ in this context?" #edb/ref 17592186045417] [17592186551350 #edb/ref 1072 #uuid "edc742b5-3b4b-536d-82ef-b613c6a8e953" #edb/ref 17592186045417] [17592186551350 #edb/ref 1074 "| $x$ | **$-3$** | **$-2$** | **$-1$** | **$0$** | **$1$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-7$ | $-4$ | $2$ | $5$ | $10$ |\n\nThe coefficients of the line that best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & -3 \\\\ 1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}-7 \\\\ -4 \\\\ 2 \\\\ 5 \\\\ 10\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector." #edb/ref 17592186045417]}
