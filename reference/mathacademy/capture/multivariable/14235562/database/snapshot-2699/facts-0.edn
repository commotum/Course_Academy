86045417] [17592186130792 #edb/ref 1075 #edb/ref 17592186130794 #edb/ref 17592186045417] [17592186130792 #edb/ref 1075 #edb/ref 17592186130795 #edb/ref 17592186045417] [17592186130792 #edb/ref 1075 #edb/ref 17592186130796 #edb/ref 17592186045417] [17592186130792 #edb/ref 1075 #edb/ref 17592186130797 #edb/ref 17592186045417] [17592186130792 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186130792 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186130792 #edb/ref 1079 #uuid "47431566-66ec-59a7-a8b0-d58094c893d4" #edb/ref 17592186045417] [17592186130793 #edb/ref 1080 "\\begin{bmatrix}-6 & -5 & -1 & 1 & 1\\end{bmatrix}" #edb/ref 17592186045417] [17592186130793 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186130793 #edb/ref 1083 #uuid "b20594c2-8b13-5743-9418-00ca234bb530" #edb/ref 17592186045417] [17592186130794 #edb/ref 1080 "\\begin{bmatrix}-2 & -1 & 0 & 1 & 2\\end{bmatrix}" #edb/ref 17592186045417] [17592186130794 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186130794 #edb/ref 1083 #uuid "c5c59f9d-b512-54e7-9cb1-7c7e2fe4dae6" #edb/ref 17592186045417] [17592186130795 #edb/ref 1080 "\\begin{bmatrix}-6 \\\\ -5 \\\\ -1 \\\\ 1 \\\\ 1\\end{bmatrix}" #edb/ref 17592186045417] [17592186130795 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186130795 #edb/ref 1083 #uuid "d83d477f-73fa-5372-b7a8-321ce9811cd1" #edb/ref 17592186045417] [17592186130796 #edb/ref 1080 "\\begin{bmatrix}-2 \\\\ -1 \\\\ 0 \\\\ 1 \\\\ 2\\end{bmatrix}" #edb/ref 17592186045417] [17592186130796 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186130796 #edb/ref 1083 #uuid "f1374cf2-7b4c-577f-9f53-fda2e786227d" #edb/ref 17592186045417] [17592186130797 #edb/ref 1080 "\\begin{bmatrix}1 & 1 & 1 & 1 & 1\\end{bmatrix}" #edb/ref 17592186045417] [17592186130797 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186130797 #edb/ref 1083 #uuid "19f0bcaf-a2eb-5f63-bfcc-39ae986682d2" #edb/ref 17592186045417] [17592186133613 #edb/ref 1069 "e-5610" #edb/ref 17592186045417] [17592186133613 #edb/ref 1071 "| $x$ | **$-3$** | **$-1$** | **$0$** | **$4$** |\n| --- | --- | --- | --- | --- |\n| $y$ | $10$ | $8$ | $6$ | $3$ |\n\nFind the line of the form $y=\\beta_0 + \\beta_1 x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n![](images/ba/ba4b73a8acd1ede70da8d25a67159c74420ac2fd11d15c830a460071d881ff42.png)\n*where $X$ is the corresponding design matrix and $\\mathbf{y}$ is the observation vector.*" #edb/ref 17592186045417] [17592186133613 #edb/ref 1072 #uuid "251ec7c6-a050-5deb-8f13-d81f5de4b5c9" #edb/ref 17592186045417] [17592186133613 #edb/ref 1074 "The coefficients of the line that best fits the data can be found as the least-squares solution ${\\hat{\\boldsymbol{\\beta}}}$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -3 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 4\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}10 \\\\ 8 \\\\ 6 \\\\ 3\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\boldsymbol{\\beta}$ is the parameter vector, and $\\mathbf{y}$ is the observation vector.\n\nPre-multiplying this equation by $X^T,$ we obtain the corresponding normal equation\n\n$$\nX^T \\! X {\\hat{\\boldsymbol{\\beta}}} = X^T \\mathbf{y}.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X^T}X$ is invertible and \n\n$$\n{\\hat{\\boldsymbol{\\beta}}} = (X^T \\! X )^{-1} X^T \\mathbf{y}.\n$$\n\nSubstituting the given values of $({X^T} X )^{-1}$ and $X^T \\mathbf{y}$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{104}\\begin{bmatrix}26 & 0 \\\\ 0 & 4\\end{bmatrix}\\begin{bmatrix}27 \\\\ -26\\end{bmatrix} \\\\  & =\\begin{bmatrix}6.75 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, $y = 6.75 - x.$" #edb/ref 17592186045443] [17592186133614 #edb/ref 1069 "e-5611" #edb/ref 17592186045417] [17592186133614 #edb/ref 1071 "An experiment consists of measuring how much a spring stretches (in inches) when one end of the spring is attached to the ceiling while a mass of $x$ ounces hangs from the other end. This data is shown below.\n\n| Mass $(x)$ | **$1$** | **$2$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- |\n| Stretch $(y)$ | $0.8$ | $1.8$ | $3.2$ | $4.2$ |\n\nFind the line of the form $y=\\beta_0 + \\beta_1 x$ that best fits the data above. According to the model, how much will the spring stretch if we use an $8$-ounce mass, assuming that the trend continues?  \n\n*Hint: You can use the fact that* \n![](images/40/400621e90f0419646dcd9e2b2e1bc31bc3cc280bef2be6c3d330c8b69308429c.png)\n*where $X$ is the corresponding design matrix and $\\mathbf{y}$ is the observation vector.*" #edb/ref 17592186045417] [17592186133614 #edb/ref 1072 #uuid "a763a84a-0727-58a3-b524-04afa5735706" #edb/ref 17592186045417] [17592186133614 #edb/ref 1074 "The coefficients of the line that best fits the data can be found as the least-squares solution ${\\hat{\\boldsymbol{\\beta}}}$ to the system  \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 1 \\\\ 1 & 2 \\\\ 1 & 4 \\\\ 1 & 5\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}0.8 \\\\ 1.8 \\\\ 3.2 \\\\ 4.2\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\boldsymbol{\\beta}$ is the parameter vector, and $\\mathbf{y}$ is the observation vector.\n\nPre-multiplying this equation by $X^T,$ we obtain the corresponding normal equation\n\n$$\nX^T \\! X {\\hat{\\boldsymbol{\\beta}}} = X^T \\mathbf{y}.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X^T}X$ is invertible and \n\n$$\n{\\hat{\\boldsymbol{\\beta}}} = (X^T \\! X )^{-1} X^T \\mathbf{y}.\n$$\n\nSubstituting the given values of $({X^T} X )^{-1}$ and $X^T \\mathbf{y}$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{20}\\begin{bmatrix}23 & -6 \\\\ -6 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}10 \\\\ 38.2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.04 \\\\ 0.82\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y = 0.04+ 0.82x.$\n\nFinally, to predict how much the spring will stretch if an $8$-ounce mass is hung from it,  we substitute $x=8$ into the equation of the line:\n\n$$\n\\begin{aligned}y & =0.04+0.82(8) \\\\  & =6.6\\end{aligned}\n$$\n\nThus, according to the model, if an $8$ ounce mass is hung on the spring, the spring will stretch $6.6$ inches. \n\n**Note**: Since we're extrapolating ($x=8$ is not within the range of the original set of $x$-values), our result *may* be unreliable." #edb/ref 17592186045443] [17592186133718 #edb/ref 1069 "e-9914" #edb/ref 17592186045417] [17592186133718 #edb/ref 1071 "| $x$ | **$-6$** | **$-3$** | **$-1$** | **$0$** | **$4$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-7$ | $-4$ | $2$ | $8$ | $10$ |\n\nThe vector of coefficients  of the line $y=\\beta_0 + \\beta_1 x$ that best fits the data above can be found using linear regression as \n\n![](images/80/8002d38943a0f0b72e5c9cef2e3a455915479ca86c53ebe403b60a6b49f268a4.png)\n\nwhere $X$ is the corresponding design matrix and $\\mathbf{y}$ is the observation vector. Which are the design matrix $X$ and the observation vector $\\mathbf{y}$ in this context?" #edb/ref 17592186045417] [17592186133718 #edb/ref 1072 #uuid "29b2a4d7-7e88-5f7a-9a84-ff5315c38f92" #edb/ref 17592186045417] [17592186133718 #edb/ref 1074 "| $x$ | **$\\color{blue}-6$** | **$\\color{blue}-3$** | **$\\color{blue}-1$** | **$\\color{blue}0$** | **$\\color{blue}4$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $\\color{red}-7$ | $\\color{red}-4$ | $\\color{red}2$ | $\\color{red}8$ | $\\color{red}10$ |\n\nThe coefficients of the line that best fits the data can be found as the least-squares solution ${\\hat{\\boldsymbol{\\beta}}}$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -6 \\\\ 1 & -3 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 4\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}-7 \\\\ -4 \\\\ 2 \\\\ 8 \\\\ 10\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\boldsymbol{\\beta}$ is the parameter vector, and $\\mathbf{y}$ is the observation vector." #edb/ref 17592186045443] [17592186133804 #edb/ref 1037 #edb/ref 17592186048284 #edb/ref 17592186045417] [17592186133804 #edb/ref 1038 #edb/ref 17592186134108 #edb/ref 17592186045417] [17592186133804 #edb/ref 1038 #edb/ref 17592186134359 #edb/ref 17592186045417] [17592186133804 #edb/ref 1038 #edb/ref 17592186271956 #edb/ref 17592186045417] [17592186133804 #edb/ref 1038 #edb/ref 17592186271957 #edb/ref 17592186045417] [17592186133804 #edb/ref 1038 #edb/ref 17592186271958 #edb/ref 17592186045417] [17592186133804 #edb/ref 1038 #edb/ref 17592186326907 #edb/ref 17592186045417] [17592186133804 #edb/ref 1038 #edb/ref 17592186369755 #edb/ref 17592186045417] [17592186133804 #edb/ref 1038 #edb/ref 17592186369762 #edb/ref 17592186045417] [17592186133804 #edb/ref 1038 #edb/ref 17592186551291 #edb/ref 17592186045417] [17592186133804 #edb/ref 1038 #edb/ref 17592186551310 #edb/ref 17592186045417] [17592186133804 #edb/ref 1038 #edb/ref 17592186557260 #edb/ref 17592186045417] [17592186133804 #edb/ref 1039 "Finding a Least-Squares Regression Line" #edb/ref 17592186045417] [17592186133804 #edb/ref 1041 #edb/ref 17592186133613 #edb/ref 17592186045417] [17592186133804 #edb/ref 1042 #uuid "950c1ed7-f804-54f5-bf97-16bf2d1a663b" #edb/ref 17592186045417] [17592186133805 #edb/ref 1037 #edb/ref 17592186050210 #edb/ref 17592186045417] [17592186133805 #edb/ref 1038 #edb/ref 17592186134111 #edb/ref 17592186045417] [17592186133805 #edb/ref 1038 #edb/ref 17592186134362 #edb/ref 17592186045417] [17592186133805 #edb/ref 1038 #edb/ref 17592186271966 #edb/ref 17592186045417] [17592186133805 #edb/ref 1038 #edb/ref 17592186271967 #edb/ref 17592186045417] [17592186133805 #edb/ref 1038 #edb/ref 17592186326903 #edb/ref 17592186045417] [17592186133805 #edb/ref 1038 #edb/ref 17592186400826 #edb/ref 17592186045417] [17592186133805 #edb/ref 1038 #edb/ref 17592186402736 #edb/ref 17592186045417] [17592186133805 #edb/ref 1038 #edb/ref 17592186402743 #edb/ref 17592186045417] [17592186133805 #edb/ref 1038 #edb/ref 17592186551239 #edb/ref 17592186045417] [17592186133805 #edb/ref 1038 #edb/ref 17592186551337 #edb/ref 17592186045417] [17592186133805 #edb/ref 1039 "Finding a Least-Squares Regression Line in Context" #edb/ref 17592186045417] [17592186133805 #edb/ref 1041 #edb/ref 17592186133614 #edb/ref 17592186045417] [17592186133805 #edb/ref 1042 #uuid "fd286741-bf82-5723-a9c1-acf7a8b238c2" #edb/ref 17592186045417] [17592186133905 #edb/ref 1038 #edb/ref 17592186134106 #edb/ref 17592186045417] [17592186133905 #edb/ref 1038 #edb/ref 17592186134358 #edb/ref 17592186045417] [17592186133905 #edb/ref 1038 #edb/ref 17592186269247 #edb/ref 17592186045417] [17592186133905 #edb/ref 1038 #edb/ref 17592186269255 #edb/ref 17592186045417] [17592186133905 #edb/ref 1038 #edb/ref 17592186269256 #edb/ref 17592186045417] [17592186133905 #edb/ref 1038 #edb/ref 17592186400791 #edb/ref 17592186045417] [17592186133905 #edb/ref 1038 #edb/ref 17592186551305 #edb/ref 17592186045417] [17592186133905 #edb/ref 1038 #edb/ref 17592186551332 #edb/ref 17592186045417] [17592186133905 #edb/ref 1038 #edb/ref 17592186551350 #edb/ref 17592186045417] [17592186133905 #edb/ref 1038 #edb/ref 17592186557275 #edb/ref 17592186045417] [17592186133905 #edb/ref 1038 #edb/ref 17592186557294 #edb/ref 17592186045417] [17592186133905 #edb/ref 1039 "Identifying Elements of a Regression Line in Terms of Matrices and Vectors" #edb/ref 17592186045417] [17592186133905 #edb/ref 1041 #edb/ref 17592186133718 #edb/ref 17592186045417] [17592186133905 #edb/ref 1042 #uuid "6acfe386-f7e4-54b1-9701-6ff5905b4536" #edb/ref 17592186045417] [17592186134029 #edb/ref 1043 #edb/ref 17592186134703 #edb/ref 17592186045417] [17592186134029 #edb/ref 1043 #edb/ref 17592186134704 #edb/ref 17592186045417] [17592186134029 #edb/ref 1043 #edb/ref 17592186134705 #edb/ref 17592186045417] [17592186134029 #edb/ref 1043 #edb/ref 17592186134886 #edb/ref 17592186045417] [17592186134029 #edb/ref 1043 #edb/ref 17592186134888 #edb/ref 17592186045417] [17592186134029 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186134029 #edb/ref 1045 "Linear Regression With Matrices" #edb/ref 17592186045417] [17592186134029 #edb/ref 1046 #edb/ref 17592186134703 #edb/ref 17592186045417] [17592186134029 #edb/ref 1049 #edb/ref 17592186050179 #edb/ref 17592186045417] [17592186134029 #edb/ref 1050 540.0 #edb/ref 17592186045417] [17592186134029 #edb/ref 1053 #uuid "6c1ae6c7-6771-5b39-80ac-beb1cde38bb4" #edb/ref 17592186045417] [17592186134106 #edb/ref 1068 #edb/ref 17592186130792 #edb/ref 17592186045417] [17592186134106 #edb/ref 1068 #edb/ref 17592186400757 #edb/ref 17592186045417] [17592186134106 #edb/ref 1069 "q-139517" #edb/ref 17592186045417] [17592186134106 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186134106 #edb/ref 1071 "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** | **$2$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-6$ | $-5$ | $-1$ | $1$ | $1$ |\n\nThe vector of coefficients  of the line $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above can be found using linear regression as \n\n$$\n\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}=({X}^{T}\\,X)^{-1}{X}^{T}y,\n$$\n\nwhere $X$ is the corresponding design matrix and $y$ is the observation vector. Which of the following is the observation vector $y$ in this context?" #edb/ref 17592186045443] [17592186134106 #edb/ref 1072 #uuid "07c1a1e5-eac4-585d-8460-669cc1e39819" #edb/ref 17592186045417] [17592186134106 #edb/ref 1074 "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** | **$2$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-6$ | $-5$ | $-1$ | $1$ | $1$ |\n\nThe coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1 \\\\ 1 & 2\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}-6 \\\\ -5 \\\\ -1 \\\\ 1 \\\\ 1\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector." #edb/ref 17592186045443] [17592186134703 #edb/ref 1058 #edb/ref 17592186134886 #edb/ref 17592186045417] [17592186134703 #edb/ref 1061 20307 #edb/ref 17592186045417] [17592186134703 #edb/ref 1062 #uuid "0ac1d0c2-c862-5d00-b1e2-ce846fd9a9e9" #edb/ref 17592186045417] [17592186134703 #edb/ref 1063 #edb/ref 17592186135062 #edb/ref 17592186045417] [17592186134704 #edb/ref 1058 #edb/ref 17592186134705 #edb/ref 17592186045417] [17592186134704 #edb/ref 1061 20308 #edb/ref 17592186045417] [17592186134704 #edb/ref 1062 #uuid "342fc855-0200-53f5-b531-d6f0f6dc12c4" #edb/ref 17592186045417] [17592186134704 #edb/ref 1063 #edb/ref 17592186133804 #edb/ref 17592186045417] [17592186134705 #edb/ref 1058 #edb/ref 17592186134888 #edb/ref 17592186045417] [17592186134705 #edb/ref 1061 20310 #edb/ref 17592186045417] [17592186134705 #edb/ref 1062 #uuid "db5ddd01-2672-598e-9121-f4cf661cc836" #edb/ref 17592186045417] [17592186134705 #edb/ref 1063 #edb/ref 17592186133805 #edb/ref 17592186045417] [17592186134886 #edb/ref 1058 #edb/ref 17592186134704 #edb/ref 17592186045417] [17592186134886 #edb/ref 1061 37273 #edb/ref 17592186045417] [17592186134886 #edb/ref 1062 #uuid "af2c310b-8cc3-5365-a974-d47b29df8d67" #edb/ref 17592186045417] [17592186134886 #edb/ref 1063 #edb/ref 17592186133905 #edb/ref 17592186045417] [17592186134888 #edb/ref 1061 37328 #edb/ref 17592186045417] [17592186134888 #edb/ref 1062 #uuid "7c7f5aff-10ef-54b2-b0e0-98663daec8b4" #edb/ref 17592186045417] [17592186134888 #edb/ref 1063 #edb/ref 17592186135142 #edb/ref 17592186045417] [17592186135062 #edb/ref 1064 "Consider the following data set:\n\n| $x$ | **$100$** | **$110$** | **$120$** | **$130$** |\n| --- | --- | --- | --- | --- |\n| $y$ | $12$ | $11$ | $12$ | $15$ |\n\nOur goal is to describe how to use matrices to carry out a linear regression. That is, we want to find an equation of the form\n\n$$\ny = \\beta_0 + \\beta_1 x\n$$\n\nthat best fits the given data points. \n\n![](images/8e/8ec830e3cf6154675487536afc0e09a42226eb83187b90238a0bfdcefeae5b38.png)\n\nLet's write our problem in matrix notation. Substituting the values of $x$ into the regression equation and equating the results to the corresponding observed values of $y,$ we obtain the system\n\n$$\n\\{\\begin{aligned}{\\beta }_{0}+100{\\beta }_{1}=12 \\\\ {\\beta }_{0}+110{\\beta }_{1}=11 \\\\ {\\beta }_{0}+120{\\beta }_{1}=12 \\\\ {\\beta }_{0}+130{\\beta }_{1}=15\\end{aligned}\n$$\n\nwhich can be expressed in matrix notation as\n\n![](images/8b/8bacbea6990395351aecca8befe779358d57d50f8c14f865d73c2107688fa728.svg)\n\nThe matrix $X$ is called the **design matrix,** and $\\mathbf{y}$ is called the **observation vector**. \n\nSince our points do not lie on a straight line, there will be no parameters $\\beta_0$ and $\\beta_1$ such that this equation is true. So instead, we seek parameters $\\beta_0$ and $\\beta_1$ that best approximate the solution.\n\nIn other words, we seek to find a column vector $\\boldsymbol\\beta$ such that\n\n$$\n\\| \\mathbf{y} - X\\boldsymbol{\\beta}\\|\n$$\n\nis as small as possible.\n\nNotice that this is exactly the least-squares problem for the system $X \\boldsymbol{\\beta} = \\mathbf{y}.$ Therefore, the coefficients of the line that best fits the data can be found as the solution to the corresponding least-squares problem! \n\nThis approach to finding parameters for a linear regression model is often called **ordinary least squares (OLS) regression**.\n\nPre-multiplying the equation $X \\boldsymbol{\\beta} = \\mathbf{y}$ by $X^T,$ we obtain the corresponding normal equation\n\n$$\nX^T \\! X {\\hat{\\boldsymbol{\\beta}}} = X^T \\mathbf{y}.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X^T}X$ is invertible, and \n\n$$\n{\\hat{\\boldsymbol{\\beta}}} = (X^T \\! X )^{-1} X^T \\mathbf{y}.\n$$\n\nSubstituting $X$ and $\\mathbf{y}$ into the formula above and simplifying, we get\n\n$$\n\\begin{aligned}\\overset{^}{\\beta }=[\\begin{aligned}1 \\\\ 0.1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the line of best fit (regression line) is \n\n$$\ny = 1+ 0.1x.\n$$" #edb/ref 17592186045417] [17592186135062 #edb/ref 1065 3652 #edb/ref 17592186045417] [17592186135062 #edb/ref 1066 #uuid "49c9c3ab-40d7-5e87-934c-1c3fcd16b330" #edb/ref 17592186045417] [17592186135062 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186135142 #edb/ref 1064 "Given a dataset of paired numerical observations $(x,y)$ and the corresponding linear regression model $\\widehat{y} =f(x),$ the **residual** for a particular observation $(x, y)$ is defined as\n\n$$\n\\begin{aligned}\\text{Residual} & =\\text{Actual}-\\text{Estimated} \\\\  & =y-f(x) \\\\  & =y-\\overset{^}{y}.\\end{aligned}\n$$\n\nWe subtract the *estimated* value predicted by the model from the actual *observed* value. The residuals for the data set we considered earlier are shown below.\n\n![](images/51/515aaaeef2f85bb131564b92bdaef9ef514d05c8028ae85382d231565d490665.png)\n\nIn the past, you may have seen that  calculating a regression line typically means finding a line where the sum of the squared residuals \n\n$$\n\\displaystyle\\sum_{i=1}^4 r_i^2\n$$\n\nis as small as possible. \n\nUsing matrix notation, the sum of the squared residuals can be viewed as \n\n$$\n\\sum_{i=1}^4 r_i^2 = \\| \\mathbf{y} - X\\beta\\|^2.\n$$\n\nTherefore, the condition that the sum of the squared residuals is minimized is equivalent to minimizing $\\| \\mathbf{y} - X\\beta\\|^2.$ This, in turn, is equivalent to minimizing $\\| \\mathbf{y} - X\\beta\\|.$ \n\nTherefore, the problem of minimizing the squared residuals is equivalent to solving the least squares problem for $X \\boldsymbol{\\beta} = \\mathbf{y}.$" #edb/ref 17592186045417] [17592186135142 #edb/ref 1065 6149 #edb/ref 17592186045417] [17592186135142 #edb/ref 1066 #uuid "eeb5c2f5-02c9-5579-97b5-0393df974a32" #edb/ref 17592186045417] [17592186135142 #edb/ref 1067 "Least-Squares vs. Minimizing the Sum of the Squared Residuals" #edb/ref 17592186045417] [17592186266686 #edb/ref 1080 "\\begin{bmatrix}1 & -3 \\\\ 1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1\\end{bmatrix}" #edb/ref 17592186045443] [17592186266686 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186266686 #edb/ref 1083 #uuid "3d7035cb-9675-5e56-81a6-ec1d8bb16a9a" #edb/ref 17592186045417] [17592186267493 #edb/ref 1080 "\\begin{bmatrix}-3 & -2 & -1 & 0 & 1 \\\\ -8 & -4 & 0 & 6 & 10\\end{bmatrix}" #edb/ref 17592186045443] [17592186267493 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186267493 #edb/ref 1083 #uuid "96fb95e1-8584-5c21-ba32-d2ff686b17a0" #edb/ref 17592186045417] [17592186267573 #edb/ref 1080 "\\begin{bmatrix}1 & 1 & 1 & 1 & 1 \\\\ -3 & -2 & -1 & 1 & 1\\end{bmatrix}" #edb/ref 17592186045443] [17592186267573 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186267573 #edb/ref 1083 #uuid "9e9d88cd-3142-5196-bb5e-ec238fdd81db" #edb/ref 17592186045417] [17592186267775 #edb/ref 1080 "\\begin{bmatrix}1 & -8 \\\\ 1 & -4 \\\\ 1 & 2 \\\\ 1 & 6 \\\\ 1 & 10\\end{bmatrix}" #edb/ref 17592186045443] [17592186267775 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186267775 #edb/ref 1083 #uuid "b642929f-5a9