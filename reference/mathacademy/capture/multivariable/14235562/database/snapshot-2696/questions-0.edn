7592186045498 :db/ident :answer.type/math} :answer/value "y=2+1.4x" :db/id #edb/ref 17592186271239}] :answer-field/correct {:answer/id #uuid "e0588728-a6d8-5925-a9d4-e429f8b21a28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2+1.4x" :db/id #edb/ref 17592186271239} :answer-field/id #uuid "c5f24f5e-041b-5ab7-a484-f879d53d40a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271872}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c98cf9f6-90e7-55f2-84a5-a676fae1738c" :question/math-academy-id "q-139617" :question/problem "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** | **$2$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-1$ | $1$ | $2$ | $3$ | $5$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{10}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}10 \\\\ 14\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1 \\\\ 1 & 2\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}-6 \\\\ -5 \\\\ -1 \\\\ 1 \\\\ 1\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{10}\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}10 \\\\ 14\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 1.4\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y=2+1.4x.$"}] [{:db/id #edb/ref 17592186369755 :knowledge-point/_questions [{:db/id #edb/ref 17592186133804 :knowledge-point/id #uuid "950c1ed7-f804-54f5-bf97-16bf2d1a663b" :knowledge-point/title "Finding a Least-Squares Regression Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7db9368e-c4af-56e3-b3b3-ad6a2f182507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2.8-2x" :db/id #edb/ref 17592186369757} {:answer/id #uuid "3bf4adfd-3dac-5d21-bcb8-7503f40e41bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2-2.8x" :db/id #edb/ref 17592186369758} {:answer/id #uuid "07f74642-f2f7-52f2-a580-d5a9698a5b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2-2.8x" :db/id #edb/ref 17592186369759} {:answer/id #uuid "554039b9-8112-5d6c-811a-411acff4b51f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2+2.8x" :db/id #edb/ref 17592186369760} {:answer/id #uuid "79a3e001-be87-5afe-a12f-4a88b331d823" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2.8+2x" :db/id #edb/ref 17592186369761}] :answer-field/correct {:answer/id #uuid "79a3e001-be87-5afe-a12f-4a88b331d823" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2.8+2x" :db/id #edb/ref 17592186369761} :answer-field/id #uuid "b9aa9c57-0f30-5df5-9270-ceb54bd9fc0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369756}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "59dee5e8-59ff-54dc-b1c9-fe33f65f9a33" :question/math-academy-id "q-139626" :question/problem "| $x$ | **$0$** | **$1$** | **$2$** | **$3$** | **$4$** |\n| --- | --- | --- | --- | --- | --- |\n| $y$ | $-3$ | $-1$ | $2$ | $3$ | $5$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{10}\\begin{bmatrix}6 & -2 \\\\ -2 & 1\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}6 \\\\ 32\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ 1 & 1 \\\\ 1 & 2 \\\\ 1 & 3 \\\\ 1 & 4\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}-3 \\\\ -1 \\\\ 2 \\\\ 3 \\\\ 5\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{10}\\begin{bmatrix}6 & -2 \\\\ -2 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}6 \\\\ 32\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2.8 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y=-2.8+2x.$"}] [{:db/id #edb/ref 17592186271957 :knowledge-point/_questions [{:db/id #edb/ref 17592186133804 :knowledge-point/id #uuid "950c1ed7-f804-54f5-bf97-16bf2d1a663b" :knowledge-point/title "Finding a Least-Squares Regression Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01745928-e32c-5454-a6e3-84c3244e92c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3-7.5x" :db/id #edb/ref 17592186269274} {:answer/id #uuid "9c63f558-4731-5a24-8cd6-37962eb32817" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3+7.5x" :db/id #edb/ref 17592186270648} {:answer/id #uuid "c59a290d-64c0-5f04-b6fa-aab7d8de070b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7.5-3x" :db/id #edb/ref 17592186271010} {:answer/id #uuid "d48cfe8a-e7d6-5e73-893c-7cfdac9a5635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7.5+3x" :db/id #edb/ref 17592186271138} {:answer/id #uuid "fb902028-8ca9-5246-a337-ac274bfa3708" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3+7.5x" :db/id #edb/ref 17592186271474}] :answer-field/correct {:answer/id #uuid "d48cfe8a-e7d6-5e73-893c-7cfdac9a5635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7.5+3x" :db/id #edb/ref 17592186271138} :answer-field/id #uuid "18c31747-882f-5d87-82c0-e1c176ff9aa1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271552}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d1e4cd33-5cd4-5907-994a-2099e4ec4056" :question/math-academy-id "q-139643" :question/problem "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** |\n| --- | --- | --- | --- | --- |\n| $y$ | $1$ | $5$ | $8$ | $10$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{20}\\begin{bmatrix}6 & 2 \\\\ 2 & 4\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}24 \\\\ 3\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -2 \\\\ 1 & -1 \\\\ 1 & 0 \\\\ 1 & 1\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}1 \\\\ 5 \\\\ 8 \\\\ 10\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation \n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{20}\\begin{bmatrix}6 & 2 \\\\ 2 & 4\\end{bmatrix}\\begin{bmatrix}24 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}7.5 \\\\ 3\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, $y=7.5+3x.$"}] [{:db/id #edb/ref 17592186271958 :knowledge-point/_questions [{:db/id #edb/ref 17592186133804 :knowledge-point/id #uuid "950c1ed7-f804-54f5-bf97-16bf2d1a663b" :knowledge-point/title "Finding a Least-Squares Regression Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5294a5a1-2190-5b35-b687-f1535ac6d14d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2-6.25x" :db/id #edb/ref 17592186270003} {:answer/id #uuid "986b411d-c0e5-538c-99ed-bafca3160f67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2+6.25x" :db/id #edb/ref 17592186270610} {:answer/id #uuid "b17d16d7-10f4-55f5-aa20-398254a449fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6.25+2x" :db/id #edb/ref 17592186270855} {:answer/id #uuid "bb68d1ac-0b52-557b-a57d-6d5c7518e4e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6.25-2x" :db/id #edb/ref 17592186270919} {:answer/id #uuid "ca8aa08b-4a2d-5685-9932-2099ea81504d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2-6.25x" :db/id #edb/ref 17592186271047}] :answer-field/correct {:answer/id #uuid "b17d16d7-10f4-55f5-aa20-398254a449fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6.25+2x" :db/id #edb/ref 17592186270855} :answer-field/id #uuid "357e376e-d008-5306-83a6-448fea950378" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271612}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64195b27-b671-5dc0-b27c-842f1fe0fae2" :question/math-academy-id "q-139646" :question/problem "| $x$ | **$-3$** | **$0$** | **$1$** | **$2$** |\n| --- | --- | --- | --- | --- |\n| $y$ | $1$ | $5$ | $7$ | $12$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above.\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{56}\\begin{bmatrix}14 & 0 \\\\ 0 & 4\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}25 \\\\ 28\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system  \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & -3 \\\\ 1 & 0 \\\\ 1 & 1 \\\\ 1 & 2\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}1 \\\\ 5 \\\\ 7 \\\\ 12\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{56}\\begin{bmatrix}14 & 0 \\\\ 0 & 4\\end{bmatrix}\\begin{bmatrix}25 \\\\ 28\\end{bmatrix} \\\\  & =\\begin{bmatrix}6.25 \\\\ 2\\end{bmatrix}.\\end{aligned}\n$$\n\nHence, $y=6.25+2x.$"}] [{:db/id #edb/ref 17592186271966 :knowledge-point/_questions [{:db/id #edb/ref 17592186133805 :knowledge-point/id #uuid "fd286741-bf82-5723-a9c1-acf7a8b238c2" :knowledge-point/title "Finding a Least-Squares Regression Line in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2259a17f-5cc0-5255-86c8-c5648372ce89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$2\\,800$" :db/id #edb/ref 17592186269564} {:answer/id #uuid "352e371a-5116-55e8-823a-4d8ea16c5f5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$4\\,400$" :db/id #edb/ref 17592186269756} {:answer/id #uuid "7ec6dbc9-9c7e-5f08-b5b7-2523fa7d0328" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$3\\,700$" :db/id #edb/ref 17592186270377} {:answer/id #uuid "db0484e6-fc73-549b-aacc-acee23620cda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$4\\,200$" :db/id #edb/ref 17592186271187} {:answer/id #uuid "f31f859d-103d-5d18-8576-c162b1f1e5ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$3\\,200$" :db/id #edb/ref 17592186271403}] :answer-field/correct {:answer/id #uuid "f31f859d-103d-5d18-8576-c162b1f1e5ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$3\\,200$" :db/id #edb/ref 17592186271403} :answer-field/id #uuid "26e892f1-6a97-51e5-8f0d-5824fa06ea60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271581}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2a70d052-0349-524f-90c0-17395372863f" :question/math-academy-id "q-139735" :question/problem "A company collected data on the sale price (in thousands of dollars) of a particular used car model and the car's age (in years). This data is shown below.\n\n| Age $(x)$ | **$4$** | **$5$** | **$6$** | **$7$** | **$8$** |\n| --- | --- | --- | --- | --- | --- |\n| Price $(y)$ | $12$ | $10$ | $8.5$ | $7$ | $6.5$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above. According to the model, what will be the sale price of a model that is $10$ years old, assuming the trend continues?\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{10}\\begin{bmatrix}38 & -6 \\\\ -6 & 1\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}44 \\\\ 250\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 4 \\\\ 1 & 5 \\\\ 1 & 6 \\\\ 1 & 7 \\\\ 1 & 8\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}12 \\\\ 10 \\\\ 8.5 \\\\ 7 \\\\ 6.5\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{10}\\begin{bmatrix}38 & -6 \\\\ -6 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}44 \\\\ 250\\end{bmatrix} \\\\  & =\\begin{bmatrix}17.2 \\\\ -1.4\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y=17.2-1.4x.$\n\nFinally, to predict the selling price of a car of the same model that is $10$ years old, we substitute $x=10$ into the equation of the line:\n\n$$\n\\begin{aligned}y & =17.2-1.4(10) \\\\  & =3.2\\end{aligned}\n$$\n\nSo, according to the model, the sale price will be $$3\\,200.$\n\n**Note**: Since we're extrapolating ($x=10$ is not within the range of the original set of $x$-values), our result *may* be unreliable."}] [{:db/id #edb/ref 17592186551337 :knowledge-point/_questions [{:db/id #edb/ref 17592186133805 :knowledge-point/id #uuid "fd286741-bf82-5723-a9c1-acf7a8b238c2" :knowledge-point/title "Finding a Least-Squares Regression Line in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0334f116-416e-5d14-b3bf-b66d4f75de11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8.25$  points per game" :db/id #edb/ref 17592186550380} {:answer/id #uuid "33db2298-5797-5cb1-af3d-bf806c19e083" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7.75$  points per game" :db/id #edb/ref 17592186550493} {:answer/id #uuid "bd226916-bde7-517b-871e-7e8629dd5812" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$  points per game" :db/id #edb/ref 17592186550887} {:answer/id #uuid "d2b10de6-86fa-53ca-94d7-3e008b6bfb17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$  points per game" :db/id #edb/ref 17592186550935} {:answer/id #uuid "f5961ae6-fa3a-550a-9ffb-b71a8701df1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8.75$  points per game" :db/id #edb/ref 17592186551025}] :answer-field/correct {:answer/id #uuid "bd226916-bde7-517b-871e-7e8629dd5812" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$  points per game" :db/id #edb/ref 17592186550887} :answer-field/id #uuid "5784eef9-0ad2-5040-8dd4-135f8ec74797" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551117}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d6dbf98c-84c4-5c67-a15a-4f405cbbd0b5" :question/math-academy-id "q-41401" :question/problem "The height (in feet) and the average number of points scored per game (APG) of four players on a basketball team are shown in the following table. \n\n| Height $(x)$ | **$6$** | **$6.5$** | **$6.5$** | **$7$** |\n| --- | --- | --- | --- | --- |\n| APG $(y)$ | $5$ | $8$ | $10$ | $10$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above. According to the model, what will be the average number of points scored per game by a player whose height is $6.45\\,\\text{ft}?$\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=[\\begin{aligned}84.75 & -13 \\\\ -13 & 2\\end{aligned}],\\,{X}^{T}y=[\\begin{aligned}33 \\\\ 217\\end{aligned}],\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & 6 \\\\ 1 & 6.5 \\\\ 1 & 6.5 \\\\ 1 & 7\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}5 \\\\ 8 \\\\ 10 \\\\ 10\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\overset{^}{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\overset{^}{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\n \n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\overset{^}{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =[\\begin{aligned}84.75 & -13 \\\\ -13 & 2\\end{aligned}][\\begin{aligned}33 \\\\ 217\\end{aligned}] \\\\  & =[\\begin{aligned}-24.25 \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have the line $y=-24.25+5x.$ \n\nFinally, to predict the average number of points scored per game by a player whose height is $6.45\\,\\text{ft},$  we substitute $x=6.45$ into the equation of the line:\n\n$$\n\\begin{aligned}y & =-24.25+5(6.45) \\\\  & =8\\end{aligned}\n$$\n\nSo, according to the model,  the average number of points scored per game by a player whose height is $6.45\\,\\text{ft}$ will be $8$  points per game."}] [{:db/id #edb/ref 17592186326903 :knowledge-point/_questions [{:db/id #edb/ref 17592186133805 :knowledge-point/id #uuid "fd286741-bf82-5723-a9c1-acf7a8b238c2" :knowledge-point/title "Finding a Least-Squares Regression Line in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c93ebea-33d6-548b-b12a-3b0fefae0570" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$29.8$ million" :db/id #edb/ref 17592186324462} {:answer/id #uuid "8498f4d4-ec28-50d0-9f84-9f3de7e32279" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$27.9$ million" :db/id #edb/ref 17592186325089} {:answer/id #uuid "a29c3ff4-17c9-526e-8584-e74c4fe900af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$28.5$ million" :db/id #edb/ref 17592186325349} {:answer/id #uuid "e4c65f91-7aa7-5d92-8d0d-ede3fefd70ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$28$ million" :db/id #edb/ref 17592186325987} {:answer/id #uuid "ef9b2db0-1ba5-5c3f-a06f-113ecc0be69a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$29$ million" :db/id #edb/ref 17592186326084}] :answer-field/correct {:answer/id #uuid "3c93ebea-33d6-548b-b12a-3b0fefae0570" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$29.8$ million" :db/id #edb/ref 17592186324462} :answer-field/id #uuid "ac702602-2c74-56ec-b3c7-12f968e683f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326533}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3832f676-5ec9-5b13-afe4-f7324769e216" :question/math-academy-id "q-41467" :question/problem "The relationship between the advertising budget and sales (both in millions of dollars) of a company per year over several years is shown in the following table. \n\n| Advertising $(x)$ | **$2$** | **$2.5$** | **$3$** | **$3.5$** |\n| --- | --- | --- | --- | --- |\n| Sales $(y)$ | $10$ | $12$ | $16$ | $20$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above. According to the model, what will be the total sales when the annual advertising budget is equal to $$5$ million, assuming the trend continues? \n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{5}\\begin{bmatrix}31.5 & -11 \\\\ -11 & 4\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}58 \\\\ 168\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 2 \\\\ 1 & 2.5 \\\\ 1 & 3 \\\\ 1 & 3.5\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}10 \\\\ 12 \\\\ 16 \\\\ 20\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\n \n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{5}\\begin{bmatrix}31.5 & -11 \\\\ -11 & 4\\end{bmatrix}\\begin{bmatrix}58 \\\\ 168\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4.2 \\\\ 6.8\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y=-4.2+6.8x.$ \n\nFinally, to predict the value of the sales when the advertising budget is equal to $$5$ million, we substitute $x=5$ into the equation of the line:\n\n$$\n\\begin{aligned}y & =-4.2+6.8(5) \\\\  & =29.8\\end{aligned}\n$$\n\nSo, according to the model, the total sales when the advertising budget equals $$5$ million will be $$29.8$ million. \n\n**Note**: Since we're extrapolating ($x=5$ is not within the range of the original set of $x$-values), our result *may* be unreliable."}] [{:db/id #edb/ref 17592186551239 :knowledge-point/_questions [{:db/id #edb/ref 17592186133805 :knowledge-point/id #uuid "fd286741-bf82-5723-a9c1-acf7a8b238c2" :knowledge-point/title "Finding a Least-Squares Regression Line in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0231280f-3c96-52d4-bb02-f31de91a72d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$44.7$ inches" :db/id #edb/ref 17592186550376} {:answer/id #uuid "2e066363-c73f-5f32-81f2-579f95f3d955" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$45.8$  inches" :db/id #edb/ref 17592186550482} {:answer/id #uuid "54b64262-45e4-5112-8f5a-007f27ab1984" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$46.9$ inches" :db/id #edb/ref 17592186550568} {:answer/id #uuid "d868415f-f29e-51af-aefa-fa2b3c4c46cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$45.1$  inches" :db/id #edb/ref 17592186550953} {:answer/id #uuid "e78f56b5-9629-515c-a62c-674b58e812ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$46.2$  inches" :db/id #edb/ref 17592186550995}] :answer-field/correct {:answer/id #uuid "d868415f-f29e-51af-aefa-fa2b3c4c46cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$45.1$  inches" :db/id #edb/ref 17592186550953} :answer-field/id #uuid "7cbcd786-caa3-5353-bd0b-1dabaa09f399" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551139}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1515bb33-4938-5f32-8710-f2dc1f06ddad" :question/math-academy-id "q-41739" :question/problem "A physics experiment consists of a small object moving along a straight line. The following table contains data collected on the distance traveled by the object (in inches) during the first five seconds. \n\n| Time $(x)$ | **$1$** | **$2$** | **$3$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| Distance $(y)$ | $8.6$ | $13.1$ | $24.6$ | $28.1$ | $38.6$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above. According to the model, what distance will the object cover after $6$ seconds, assuming the trend continues? \n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{10}[\\begin{aligned}11 & -3 \\\\ -3 & 1\\end{aligned}],\\,{X}^{T}y=[\\begin{aligned}113 \\\\ 414\\end{aligned}],\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\overset{^}{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{[\\begin{aligned}1 & 1 \\\\ 1 & 2 \\\\ 1 & 3 \\\\ 1 & 4 \\\\ 1 & 5\\end{aligned}]}}\\overset{\\beta }{\\overset{⏞}{[\\begin{aligned}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{aligned}]}} & =\\overset{y}{\\overset{⏞}{[\\begin{aligned}8.6 \\\\ 13.1 \\\\ 24.6 \\\\ 28.1 \\\\ 38.6\\end{aligned}]}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\overset{^}{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\overset{^}{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\overset{^}{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{10}[\\begin{aligned}11 & -3 \\\\ -3 & 1\\end{aligned}]\\cdot [\\begin{aligned}113 \\\\ 414\\end{aligned}] \\\\  & =[\\begin{aligned}0.1 \\\\ 7.5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have the line $y=0.1+7.5x.$\n\nFinally, to predict the distance the object will cover after $6$ seconds, we substitute $x=6$ into the equation of the line:\n\n$$\n\\begin{aligned}y & =0.1+7.5(6) \\\\  & =45.1\\end{aligned}\n$$\n\nSo, according to the model, the object will cover a distance of $45.1$ inches in $6$ seconds.  \n\n**Note**: Since we're extrapolating ($x=6$ is not within the range of the original set of $x$-values), our result *may* be unreliable."}] [{:db/id #edb/ref 17592186402736 :knowledge-point/_questions [{:db/id #edb/ref 17592186133805 :knowledge-point/id #uuid "fd286741-bf82-5723-a9c1-acf7a8b238c2" :knowledge-point/title "Finding a Least-Squares Regression Line in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e9ac6ff-6dc0-50d1-bcf0-e5924b445f0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$1\\,050$" :db/id #edb/ref 17592186402738} {:answer/id #uuid "fc84303a-bedd-5991-9237-200188eab34c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$950$" :db/id #edb/ref 17592186402739} {:answer/id #uuid "dc47e4af-c36a-5241-a8ef-baaa45ef2c51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$875$" :db/id #edb/ref 17592186402740} {:answer/id #uuid "21e67319-25a2-5a84-a939-d04c90f738c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$900$" :db/id #edb/ref 17592186402741} {:answer/id #uuid "82ab20d8-e65e-5a0a-ba4c-f261ab35ac4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$850$" :db/id #edb/ref 17592186402742}] :answer-field/correct {:answer/id #uuid "21e67319-25a2-5a84-a939-d04c90f738c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$900$" :db/id #edb/ref 17592186402741} :answer-field/id #uuid "ba3cb994-1bad-5429-8732-d77a5dada295" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402737}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d0007be5-4b39-5b13-9d0c-f56e380ce0f1" :question/math-academy-id "q-41741" :question/problem "A small business collected data on the number of hours of telephone usage and the total amount (in hundreds of dollars) of the company's weekly operating expenses. This data is shown below.   \n\n| Hours $(x)$ | **$2$** | **$2.4$** | **$2.8$** | **$3.2$** | **$3.6$** |\n| --- | --- | --- | --- | --- | --- |\n| Expenses $(y)$ | $4$ | $5$ | $6$ | $7$ | $8$ |\n\nFind the line of the form $y={\\beta }_{0}+{\\beta }_{1}x$ that best fits the data above. According to the model, what will be the company's weekly operating expenses if the telephone is used for a total of $4$ hours per week, assuming the trend continues?\n\n*Hint: You can use the fact that*\n\n$$\n({X}^{T}\\,X)^{-1}=\\frac{1}{8}\\begin{bmatrix}40.8 & -14 \\\\ -14 & 5\\end{bmatrix},\\,{X}^{T}y=\\begin{bmatrix}30 \\\\ 88\\end{bmatrix},\n$$\n\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*" :question/worked-solution "The coefficients of the line that best fits the data can be found as the least-squares solution $\\hat{\\beta }$ to the system \n\n$$\n\\begin{aligned}\\overset{X}{\\overset{⏞}{\\begin{bmatrix}1 & 2 \\\\ 1 & 2.4 \\\\ 1 & 2.8 \\\\ 1 & 3.2 \\\\ 1 & 3.6\\end{bmatrix}}}\\overset{\\beta }{\\overset{⏞}{\\begin{bmatrix}{\\beta }_{0} \\\\ {\\beta }_{1}\\end{bmatrix}}} & =\\overset{y}{\\overset{⏞}{\\begin{bmatrix}4 \\\\ 5 \\\\ 6 \\\\ 7 \\\\ 8\\end{bmatrix}}},\\end{aligned}\n$$\n\nwhere $X$ is the design matrix, $\\beta $ is the parameter vector, and $y$ is the observation vector.\n\nPre-multiplying this equation by ${X}^{T},$ we obtain the corresponding normal equation\n\n$$\n{X}^{T}\\,X\\hat{\\beta }={X}^{T}y.\n$$\n\nSince the columns of $X$ are linearly independent, the matrix ${X}^{T}X$ is invertible and \n\n$$\n\\hat{\\beta }=({X}^{T}\\,X)^{-1}{X}^{T}y.\n$$\n\nSubstituting the given values of $({X}^{T}X)^{-1}$ and ${X}^{T}y$ into the formula, we get\n\n$$\n\\begin{aligned}\\hat{\\beta } & =({X}^{T}\\,X)^{-1}{X}^{T}\\,y \\\\  & =\\frac{1}{8}\\begin{bmatrix}40.8 & -14 \\\\ -14 & 5\\end{bmatrix}\\cdot \\begin{bmatrix}30 \\\\ 88\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 2.5\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the line $y=-1+2.5x.$\n\nFinally, to predict the amount of the company's weekly operating expenses if the telephone is used for a total of $4$ hours, we substitute $x=4$ into the equation of the line:\n\n$$\n\\begin{aligned}y & =-1+2.5(4) \\\\  & =9\\end{aligned}\n$$\n\nSo, according to the model, the company's weekly operating expenses will be $$900.$ \n\n**Note**: Since we're extrapolating ($x=4$ is not within the range of the original set of $x$-values), our result *may* be unreliable."}]}
