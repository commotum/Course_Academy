186045417 true] [17592186434222 1075 #edb/ref 17592186434210 13194139534724 17592186045417 true] [17592186434222 1076 #edb/ref 17592186045493 13194139534724 17592186045417 true] [17592186434222 1077 "selection" 13194139534724 17592186045417 true] [17592186434222 1078 #edb/ref 17592186434199 13194139534724 17592186045417 true] [17592186434222 1079 #uuid "c1a25e81-7040-592b-a356-4ca4b3acf5c6" 13194139534724 17592186045417 true] [17592186434223 1068 #edb/ref 17592186434217 13194139534724 17592186045417 true] [17592186434223 1069 "q-353023" 13194139534724 17592186045417 true] [17592186434223 1070 #edb/ref 17592186045486 13194139534724 17592186045417 true] [17592186434223 1071 "Consider the arc of the curve $y=4x-5$ that lies between the lines $x=1$ and $x=2.$ Calculate the surface area $S$ generated when this arc is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$S=$\n{{field-1}}" 13194139534724 17592186045417 true] [17592186434223 1072 #uuid "27bd77a9-270d-5949-9f60-fbbaff8278e9" 13194139534724 17592186045417 true] [17592186434223 1074 "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $y=f(x),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x.\n$$\n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4x-5)=4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{(\\frac{\\text{d}y}{\\text{d}x})}^{2}=16.\n$$\n\nThen, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{1}^{2}x\\sqrt{1+16}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{1}^{2}x\\sqrt{17}\\,\\text{d}x \\\\  & =2\\pi \\sqrt{17}{[\\frac{{x}^{2}}{2}]}_{1}^{2} \\\\  & =2\\pi \\sqrt{17}(\\frac{4-1}{2}) \\\\  & =3\\pi \\sqrt{17}.\\end{aligned}\n$$" 13194139534724 17592186045417 true] [17592186434224 1068 #edb/ref 17592186434219 13194139534724 17592186045417 true] [17592186434224 1069 "q-126611" 13194139534724 17592186045417 true] [17592186434224 1070 #edb/ref 17592186045485 13194139534724 17592186045417 true] [17592186434224 1071 "![](images/b6/b6deaf63a158a3629a59ef3c86535681e490a08846dc6fed493d64cd788b8166.png)\n\nConsider the arc of the curve $x=\\frac{1}{y}$ that lies between $y=1$ and $y=2,$ as shown above. What integral gives the area of the surface generated when this arc is rotated $2\\pi $ radians about the $y$-axis?" 13194139534724 17592186045417 true] [17592186434224 1072 #uuid "6ebf4030-c9f4-5be7-b4a3-7a80ff890517" 13194139534724 17592186045417 true] [17592186434224 1074 "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $x=f(y),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y.\n$$\n\nWe are told that the limits of integration are from $y=1$ to $y=2.$ \n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\frac{1}{y})=-\\frac{1}{{y}^{2}}\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{1}^{2}(\\frac{1}{y})\\sqrt{1+{(-\\frac{1}{{y}^{2}})}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{1}^{2}\\frac{1}{y}\\sqrt{1+\\frac{1}{{y}^{4}}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{1}^{2}\\frac{1}{{y}^{3}}\\sqrt{{y}^{4}+1}\\,\\text{d}y.\\end{aligned}\n$$" 13194139534724 17592186045417 true] [17592186434225 1068 #edb/ref 17592186434222 13194139534724 17592186045417 true] [17592186434225 1069 "q-126712" 13194139534724 17592186045417 true] [17592186434225 1070 #edb/ref 17592186045485 13194139534724 17592186045417 true] [17592186434225 1071 "Consider the arc of the curve $y=\\sqrt{x}$ that lies between the lines $x=0$ and $x=4.$ What integral gives the area of the surface generated when this arc is rotated $2\\pi $ radians about the $y$-axis?" 13194139534724 17592186045417 true] [17592186434225 1072 #uuid "7b3d769e-6c11-5710-ab2e-a8207928fc2e" 13194139534724 17592186045417 true] [17592186434225 1074 "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $y=f(x),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x.\n$$\n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})=\\frac{1}{2\\sqrt{x}}.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{4}x\\sqrt{1+{(\\frac{1}{2\\sqrt{x}})}^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{4}x\\sqrt{1+\\frac{1}{4x}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{4}x\\sqrt{\\frac{4x+1}{4x}}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{4}\\sqrt{x(4x+1)}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{4}\\sqrt{4{x}^{2}+x}\\,\\text{d}x.\\end{aligned}\n$$" 13194139534724 17592186045417 true] [17592186434226 1068 #edb/ref 17592186434220 13194139534724 17592186045417 true] [17592186434226 1069 "q-109241" 13194139534724 17592186045417 true] [17592186434226 1070 #edb/ref 17592186045485 13194139534724 17592186045417 true] [17592186434226 1071 "![](images/52/525bd983bacfce2de8664b92947b53bdcc48d1d28073ffaa4becc03d23f6594d.png)\n\nConsider the arc of the curve $x={e}^{y}$ that lies between $y=0$ and $y=1,$ as shown above. What integral gives the area of the surface generated when this arc is rotated $2\\pi $ radians about the $y$-axis?" 13194139534724 17592186045417 true] [17592186434226 1072 #uuid "8cc15adf-0a9f-5eb3-bbf2-19adcac2887d" 13194139534724 17592186045417 true] [17592186434226 1074 "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $x=f(y),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y.\n$$\n\nWe are told that the limits of integration are from $y=0$ to $y=1.$ \n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}({e}^{y})={e}^{y}.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}x\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1}{e}^{y}\\sqrt{1+{({e}^{y})}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1}{e}^{y}\\sqrt{1+{e}^{2y}}\\,\\text{d}y.\\end{aligned}\n$$" 13194139534724 17592186045417 true] [17592186434227 1068 #edb/ref 17592186434221 13194139534724 17592186045417 true] [17592186434227 1069 "q-109409" 13194139534724 17592186045417 true] [17592186434227 1070 #edb/ref 17592186045486 13194139534724 17592186045417 true] [17592186434227 1071 "Consider the arc of the curve $y={x}^{2}$ that lies between the lines $x=0$ and $x=\\sqrt{2}.$ Calculate the surface area generated when this arc is rotated $2\\pi $ radians about the $y$-axis." 13194139534724 17592186045417 true] [17592186434227 1072 #uuid "eec48b50-4b84-5d66-bcaa-65d6d5e0e3fb" 13194139534724 17592186045417 true] [17592186434227 1074 "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $y=f(x),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x.\n$$\n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})=2x.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{(\\frac{\\text{d}y}{\\text{d}x})}^{2}=4{x}^{2}.\n$$\n\nThen, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{\\sqrt{2}}x\\sqrt{1+4{x}^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe evaluate the last integral using the substitution $u=1+4{x}^{2}.$ Then, $x\\,\\text{d}x=\\frac{1}{8}\\,\\text{d}u.$\n\nWe also need to compute new limits:\n\n| **$x$** | $0$ | $\\sqrt{2}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $9$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{\\sqrt{2}}x\\sqrt{1+4{x}^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{1}^{9}\\sqrt{u}(\\frac{1}{8}\\,\\text{d}u) \\\\  & =\\frac{\\pi }{4}{\\int }_{1}^{9}\\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{\\pi }{4}{[\\frac{2\\sqrt{{u}^{3}}}{3}]}_{1}^{9} \\\\  & =\\frac{\\pi }{6}(\\sqrt{{9}^{3}}-\\sqrt{{1}^{3}}) \\\\  & =\\frac{\\pi }{6}(27-1) \\\\  & =\\frac{13\\pi }{3}.\\end{aligned}\n$$" 13194139534724 17592186045417 true] [17592186434228 1068 #edb/ref 17592186434218 13194139534724 17592186045417 true] [17592186434228 1069 "q-109323" 13194139534724 17592186045417 true] [17592186434228 1070 #edb/ref 17592186045487 13194139534724 17592186045417 true] [17592186434228 1071 "![](images/e8/e8a154593153ff224bae3f334bd20e74c2513dab8a60e1482c98a99677b1f882.png)\n\nConsider the arc of the curve $y=\\sqrt{9-{x}^{2}}$ that lies in the first quadrant between $x=0$ and its $x$-intercept. What integral gives the area of the surface generated when this arc is rotated $2\\pi $ radians about the $y$-axis?" 13194139534724 17592186045417 true] [17592186434228 1072 #uuid "fc8d1452-14d0-5950-a51a-ccd436b17b9d" 13194139534724 17592186045417 true] [17592186434228 1074 "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $y=f(x),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x.\n$$\n\nFirst, we need to determine the limits of integration. To do this, we find where the curve intersects the $x$-axis by solving the following equation:\n\n$$\n\\begin{aligned}\\sqrt{9-{x}^{2}} & =0 \\\\ 9-{x}^{2} & =0 \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$\n\nHence, we need to integrate from $x=0$ to $x=3.$ \n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{9-{x}^{2}})=-\\frac{x}{\\sqrt{9-{x}^{2}}}.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{3}x\\sqrt{1+{(-\\frac{x}{\\sqrt{9-{x}^{2}}})}^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{3}x\\sqrt{1+\\frac{{x}^{2}}{9-{x}^{2}}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{3}x\\sqrt{\\frac{9}{9-{x}^{2}}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{3}\\frac{3x}{\\sqrt{9-{x}^{2}}}\\,\\text{d}x \\\\  & =6\\pi {\\int }_{0}^{3}\\frac{x}{\\sqrt{9-{x}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$" 13194139534724 17592186045417 true]] :edb/tempids {"answer-0f0a439a-504f-5fbf-a797-d8d2d5a4e3f2" 17592186434191 "answer-1e6601c4-61f5-5fc2-8f65-fd43da61f2a5" 17592186434192 "answer-24c53b46-962a-528e-9fc6-e411e9531226" 17592186434193 "answer-31589865-f535-5a3a-b7b1-4414f4936477" 17592186434194 "answer-349ea476-ce1d-5bac-80d6-d25fd5458680" 17592186434195 "answer-3c15a818-83c5-5f7a-9cd7-af17f309cc12" 17592186434196 "answer-583f8915-4518-5751-a398-2349f1a02d45" 17592186434197 "answer-5a6dfe71-2f6b-5438-bcf6-8c9d5717b052" 17592186434198 "answer-62badf77-cb9c-527d-9a5e-7cfd0c23f077" 17592186434199 "answer-6c634e1e-ba52-508f-b138-42359e51d46f" 17592186434200 "answer-7146614b-efeb-5c27-ab0a-13257daa2d25" 17592186434201 "answer-72aa9bb3-9944-56aa-bd00-bbc8d1adbb37" 17592186434202 "answer-7b6d0bb5-37e1-55e5-b7d3-7488aafe9a76" 17592186434203 "answer-7c2153a0-68c2-51bd-8b52-0e6dd1b5457d" 17592186434204 "answer-7e040071-4e94-5cd6-87d1-ae3d144b27f9" 17592186434205 "answer-810fbccb-2616-55f3-8583-9c4f15012373" 17592186434206 "answer-9fc2ba21-828a-5be6-b05f-65cce566357d" 17592186434207 "answer-adc417ae-0215-5b31-a7be-057c47b1168d" 17592186434208 "answer-b2ff3f80-bf67-5905-9884-001966f7dff9" 17592186434209 "answer-b6ad64ee-d4c9-5c91-9d37-e31cde2c0b5c" 17592186434210 "answer-cce3bf99-62ee-536e-96cb-c2585be7b276" 17592186434211 "answer-dc09367b-59d6-5d5d-a9c2-d317577fb240" 17592186434212 "answer-e826869f-0bf6-5b09-9f6b-76326e694dc8" 17592186434213 "answer-eab45974-348d-5ebc-82c0-2c8971315b6c" 17592186434214 "answer-f9b47f9b-80f5-5239-8051-dcf823dc9c7b" 17592186434215 "answer-fa444b67-4aaf-5b1f-bcde-42a440ada7d5" 17592186434216 "answer-field-14c07912-9558-56ad-9311-9295e5004f7f" 17592186434217 "answer-field-315dfa3c-34ec-5ed4-951a-87236532fc44" 17592186434218 "answer-field-3b9798a1-1cad-5e9e-af70-d906e8caaafa" 17592186434219 "answer-field-795be64e-9562-5769-987a-77c2ab8443c0" 17592186434220 "answer-field-8a7f8fd1-b75f-5078-bc9b-1cffb916667c" 1759218