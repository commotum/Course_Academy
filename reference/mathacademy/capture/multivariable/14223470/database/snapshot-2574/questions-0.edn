#{[{:db/id #edb/ref 17592186536883 :knowledge-point/_questions [{:db/id #edb/ref 17592186100943 :knowledge-point/id #uuid "a4751337-93bf-5b47-8b3f-32100820b19a" :knowledge-point/title "Identifying a Logistic Growth Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22b2c358-09d5-578e-8970-70cbd506ef07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=12-\\frac{3}{2}{y}^{2}" :db/id #edb/ref 17592186536331} {:answer/id #uuid "93d3472f-ebac-5e70-ab44-c478a48ef8a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=\\frac{3}{2}{y}^{2}" :db/id #edb/ref 17592186536519} {:answer/id #uuid "a05d2a83-b19c-56b6-8c4a-abda407e4876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=12y+\\frac{3}{2}{y}^{2}" :db/id #edb/ref 17592186536545} {:answer/id #uuid "bb7ed10b-16fa-58b9-9d6f-f538691e80da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=12y-\\frac{3}{2}" :db/id #edb/ref 17592186536580} {:answer/id #uuid "ea474472-9aa6-58f8-92d7-2af3c1726240" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=12y-\\frac{3}{2}{y}^{2}" :db/id #edb/ref 17592186536651}] :answer-field/correct {:answer/id #uuid "ea474472-9aa6-58f8-92d7-2af3c1726240" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=12y-\\frac{3}{2}{y}^{2}" :db/id #edb/ref 17592186536651} :answer-field/id #uuid "5145867a-16a7-5938-9452-ce8785416418" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536735}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d2dfce9f-843a-50f1-956d-65c7968632c5" :question/math-academy-id "q-119272" :question/problem "Which of the following differential equations is a logistic growth equation?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n\\frac{dy}{dt}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nFrom the given options, the only logistic growth equation is\n\n$$\n\\frac{dy}{dt}=12y-\\frac{3}{2}{y}^{2}.\n$$\n\nTo see this, let's factor the right-hand side of the equation. This gives,\n\n$$\n\\frac{dy}{dt}=\\frac{3}{2}y(8-y).\n$$\n\nFrom here, we see that the constant of proportionality is $k=\\frac{3}{2},$ and the carrying capacity is $a=8.$"}] [{:db/id #edb/ref 17592186536863 :knowledge-point/_questions [{:db/id #edb/ref 17592186100942 :knowledge-point/id #uuid "a46e688b-117f-5394-bcbb-fbfb7a5b6c7b" :knowledge-point/title "Constructing a Logistic Growth Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "743e3759-02ab-55f0-b4e0-a5e188a47db8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=30\\,000\\,000P(0.000\\,01-P)" :db/id #edb/ref 17592186536475} {:answer/id #uuid "74e2b3d2-bce7-54a2-9b79-91471f680491" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=-0.000\\,01P(30\\,000\\,000-P)" :db/id #edb/ref 17592186536476} {:answer/id #uuid "9ff927fc-13bd-58f0-ae73-06ad00980ab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=30\\,000\\,000P(0.000\\,01+P)" :db/id #edb/ref 17592186536542} {:answer/id #uuid "b5633021-65b1-5655-851a-9c5cc3387aa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=0.000\\,01P(30\\,000\\,000-P)" :db/id #edb/ref 17592186536572} {:answer/id #uuid "c1b2688a-a907-53f7-9404-a7e6a7f57da7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=0.000\\,01P(30\\,000\\,000+P)" :db/id #edb/ref 17592186536589}] :answer-field/correct {:answer/id #uuid "b5633021-65b1-5655-851a-9c5cc3387aa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=0.000\\,01P(30\\,000\\,000-P)" :db/id #edb/ref 17592186536572} :answer-field/id #uuid "06e2caa6-684d-5873-b7d1-19bd4b554ff8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536701}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9f125700-0b98-51e1-a020-af8c1b00c96f" :question/math-academy-id "q-119285" :question/problem "The growth rate of the population $P(t)$ in a certain country is jointly proportional to the population at time $t,$ measured in years, and the difference between the country's carrying capacity and the population. If the constant of proportionality is $0.000\\,01$ and the maximum possible population is $30\\,000\\,000,$ which differential equation could be used to model $P(t)?$" :question/worked-solution "Since the population's growth rate is *jointly* proportional to the population at time $t$ and the difference between the carrying capacity and the population, the population follows a logistic growth model.\n\nA logistic growth equation has the form\n\n$$\n\\frac{dP}{dt}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nIn this case, the constant of proportionality is $k=0.000\\,01,$ and the carrying capacity is $a=30\\,000\\,000.$ Therefore, the population is given by the equation\n\n$$\n\\frac{dP}{dt}=0.000\\,01P(30\\,000\\,000-P).\n$$"}] [{:db/id #edb/ref 17592186351556 :knowledge-point/_questions [{:db/id #edb/ref 17592186100943 :knowledge-point/id #uuid "a4751337-93bf-5b47-8b3f-32100820b19a" :knowledge-point/title "Identifying a Logistic Growth Differential Equation"}] :question/answer-fields [{:answer-field/choices 