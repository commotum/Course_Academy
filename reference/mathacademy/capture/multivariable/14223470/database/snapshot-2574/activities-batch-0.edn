#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186101725} :activity/id #uuid "6bc26614-e494-5e0e-b8e8-0405e49dbaa9" :activity/scope {:db/id #edb/ref 17592186048578 :topic/id #uuid "aae56e33-e57d-5843-b31c-fcba98a1ca50" :topic/math-academy-id 1163} :activity/steps [{:db/id #edb/ref 17592186101725 :step/content {:db/id #edb/ref 17592186102033 :tutorial/content "A differential equation of the form\n\n$$\n\\dfrac{\\mathrm dy}{\\mathrm dt} = ky(a-y),\n$$\n\nwhere $y=y(t)$ is called a **logistic growth equation.** \n\nNote the following:\n\n- $a$ is a positive constant called the **carrying capacity**.\n\n- $k$ is a positive constant of proportionality.\n\nA typical solution curve $y = y(t)$ to this equation is shown below:\n\n![](images/0f/0f416479bbf72d3b9c1bf48861883e0e77bbc1c1d60d7fa48fb89e6f21c104eb.png)\n\nWe will learn more about the structure of the solution curves in future lessons. But for now, it's helpful to realize that for all $t,$ we have\n\n$$\n0 < y(t) < a.\n$$\n\n \n\nAn example of a logistic growth equation is\n\n$$\n\\dfrac{\\mathrm dy}{\\mathrm dt} = 10y(50-y).\n$$\n\nHere, $k = 10$ and the carrying capacity is $a=50.$" :tutorial/id #uuid "f5791475-4f91-5859-9d5b-1f20283522ea" :tutorial/math-academy-id 982 :tutorial/title "Introduction"} :step/id #uuid "a86bd27c-35f7-56a0-9dd4-1415fb4b1ae3" :step/math-academy-id 1925 :step/next {:db/id #edb/ref 17592186101786}} {:db/id #edb/ref 17592186101785 :step/content {:db/id #edb/ref 17592186100942 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100777 :question/id #uuid "a16c2c4f-38c3-5e8c-8962-3ad6c956748a" :question/math-academy-id "e-7321"} :knowledge-point/id #uuid "a46e688b-117f-5394-bcbb-fbfb7a5b6c7b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048127} {:db/id #edb/ref 17592186048746}] :knowledge-point/questions [{:db/id #edb/ref 17592186101197} {:db/id #edb/ref 17592186101551} {:db/id #edb/ref 17592186253559} {:db/id #edb/ref 17592186253560} {:db/id #edb/ref 17592186253561} {:db/id #edb/ref 17592186351557} {:db/id #edb/ref 17592186351558} {:db/id #edb/ref 17592186447299} {:db/id #edb/ref 17592186447300} {:db/id #edb/ref 17592186447301} {:db/id #edb/ref 17592186531568} {:db/id #edb/ref 17592186536854} {:db/id #edb/ref 17592186536863}] :knowledge-point/title "Constructing a Logistic Growth Equation"} :step/id #uuid "fa88498c-b724-5dfa-b5a3-3f4d0dbea254" :step/math-academy-id 27104} {:db/id #edb/ref 17592186101786 :step/content {:db/id #edb/ref 17592186100943 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100779 :question/id #uuid "29ee4686-7e38-5000-9d89-58e572f84cd7" :question/math-academy-id "e-7404"} :knowledge-point/id #uuid "a4751337-93bf-5b47-8b3f-32100820b19a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051017}] :knowledge-point/questions [{:db/id #edb/ref 17592186101549} {:db/id #edb/ref 17592186101550} {:db/id #edb/ref 17592186253556} {:db/id #edb/ref 17592186253557} {:db/id #edb/ref 17592186253558} {:db/id #edb/ref 17592186351555} {:db/id #edb/ref 17592186351556} {:db/id #edb/ref 17592186447295} {:db/id #edb/ref 17592186447296} {:db/id #edb/ref 17592186447297} {:db/id #edb/ref 17592186447298} {:db/id #edb/ref 17592186523982} {:db/id #edb/ref 17592186536868} {:db/id #edb/ref 17592186536883}] :knowledge-point/title "Identifying a Logistic Growth Differential Equation"} :step/id #uuid "257b95d0-a448-51aa-936a-9acc386bda17" :step/math-academy-id 27468 :step/next {:db/id #edb/ref 17592186101800}} {:db/id #edb/ref 17592186101800 :step/content {:db/id #edb/ref 17592186101996 :tutorial/content "Suppose we want to create a model of the deer population in a forest. Let's denote the number of deer in the forest at time $t$ as $P(t).$\n\nImagine that we have two factors that influence the size of the deer population:\n\n- Unconstrained, the rate at which the deer population increases is proportional to the size of the deer population (i.e., exponential growth).\n\n- However, as the deer population increases, food resources become more scarce. The forest cannot sustain an arbitrarily large number of deer. Therefore, we must specify the maximum number of deer that the forest can sustain. This maximum number is the forest's carrying capacity, denoted $a,$ as before.\n\nTherefore, we say that the rate of change of the deer population $P(t)$ is **jointly proportional** to *both* the deer population $P$ itself *and* the remaining room for growth, which is $a-P.$ This gives us the logistic growth equation\n\n$$\n\\dfrac{\\textrm d P}{\\textrm d t} = kP(a-P).\n$$" :tutorial/id #uuid "136097ca-5c5c-587e-918d-decbcb156cbf" :tutorial/math-academy-id 5720 :tutorial/title "Modeling Situations Using a Logistic Growth Equation"} :step/id #uuid "80e2d4b5-6d7a-5649-8978-26fea11f0ae7" :step/math-academy-id 35117 :step/next {:db/id #edb/ref 17592186101785}}] :activity/title "Logistic Growth Models With First-Order ODEs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101030}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186524072} :activity/id #uuid "85f9efd2-54dd-542f-9fb0-3457207d9896" :activity/scope {:db/id #edb/ref 17592186048578 :topic/id #uuid "aae56e33-e57d-5843-b31c-fcba98a1ca50" :topic/math-academy-id 1163} :activity/steps [{:db/id #edb/ref 17592186524056 :step/content {:db/id #edb/ref 17592186253560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a356ff5-da1f-5dea-9c22-ac42a978f1f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=-0.2P(300-P)" :db/id #edb/ref 17592186250914} {:answer/id #uuid "3882ae11-e665-5f98-b13e-856ea3ff067a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=0.2P(300-P)" :db/id #edb/ref 17592186251023} {:answer/id #uuid "65ba5d91-2960-5f9c-b94f-a9c1cfb957b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=0.2P(300+P)" :db/id #edb/ref 17592186251388} {:answer/id #uuid "81afc71e-2e81-5e1d-9747-fb7bccbefe35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=300P(0.2-P)" :db/id #edb/ref 17592186251647} {:answer/id #uuid "f220ea73-cdb5-5817-8387-4873699ce350" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=300P(0.2+P)" :db/id #edb/ref 17592186252671}] :answer-field/correct {:db/id #edb/ref 17592186251023} :answer-field/id #uuid "225256aa-a878-5dbd-ac6b-c6508ad4090e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186252866}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6e07b3cd-6441-55ba-89c7-eb3d668f886b" :question/math-academy-id "q-119289" :question/problem "A pest infestation is spreading through a land with $300$ trees. The rate of growth in the number of trees $P(t)$ infected with the pest is jointly proportional to the number of trees that are infected at time $t,$ measured in months,  and the number of uninfected trees. If the constant of proportionality is $0.2,$ which differential equation could be used to model $P(t)?$" :question/worked-solution "Since the growth rate of infected trees is *jointly* proportional to the number of trees that are infected at time $t,$ and the number of uninfected trees, the number of infected trees follows a logistic growth model.\n\nA logistic growth equation has the form\n\n$$\n\\frac{dP}{dt}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nIn this case, the constant of proportionality is $k=0.2,$ and the carrying capacity is $a=300.$ Therefore, the number of trees that are infected is given by the equation\n\n$$\n\\frac{dP}{dt}=0.2P(300-P).\n$$"} :step/id #uuid "4245bf2c-f044-5000-a8dc-9e8cf792d0e0"} {:db/id #edb/ref 17592186524063 :step/content {:db/id #edb/ref 17592186523982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bfabfe5-1bde-5d94-bc4f-bdd3166c3f50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=20-y" :db/id #edb/ref 17592186523379} {:answer/id #uuid "46cc8677-e9f5-50f1-957a-d6c09372ed81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=5y(20+y)" :db/id #edb/ref 17592186523401} {:answer/id #uuid "55c32120-58ea-521e-945f-a4d006827dfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=5y(20-y)" :db/id #edb/ref 17592186523430} {:answer/id #uuid "674fb894-2a3f-511b-92a2-711f65663bf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=5(20-y)" :db/id #edb/ref 17592186523466} {:answer/id #uuid "80937afc-7ea6-5bca-890e-a680c897e7bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=5y" :db/id #edb/ref 17592186523529}] :answer-field/correct {:db/id #edb/ref 17592186523430} :answer-field/id #uuid "c929a608-d503-51e7-8e16-80118c54e14b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523889}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "893452ea-005e-5fa0-9579-b213ff801fba" :question/math-academy-id "q-83846" :question/problem "Which of the following differential equations is a logistic growth equation?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n\\frac{dy}{dt}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nFrom the given options, the only logistic growth equation is\n\n$$\n\\frac{dy}{dt}=5y(20-y).\n$$\n\nIn this case, the constant of proportionality is $k=5,$ and the carrying capacity is $a=20.$"} :step/id #uuid "576ab541-b8f7-5797-923d-f3afc45640a1" :step/next {:db/id #edb/ref 17592186524073}} {:db/id #edb/ref 17592186524072 :step/content {:db/id #edb/ref 17592186101549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d85e959-a5d2-57fb-865e-ce7038ba9c8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=2(500-y)" :db/id #edb/ref 17592186523283} {:answer/id #uuid "3d57d462-ef3d-519d-9fd5-bf23c60439b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=2y(500+y)" :db/id #edb/ref 17592186523383} {:answer/id #uuid "7b3d47cb-be7b-539e-8964-2c16730aedcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=500-y" :db/id #edb/ref 17592186523509} {:answer/id #uuid "cf651d75-4fcd-5021-9ec0-003f1d0c2149" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=2y(500-y)" :db/id #edb/ref 17592186523689} {:answer/id #uuid "e6223966-2351-5f3e-86f0-c546dcff0000" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=2y" :db/id #edb/ref 17592186523738}] :answer-field/correct {:db/id #edb/ref 17592186523689} :answer-field/id #uuid "09aa265b-d358-5ee1-8520-4f4d7c406505" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186100455}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9d36aaa4-be3b-5e83-9941-c6527d829fc1" :question/math-academy-id "q-83754" :question/problem "Which of the following differential equations is a logistic growth equation?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n\\frac{dy}{dt}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nFrom the given options, the only logistic growth equation is\n\n$$\n\\frac{dy}{dt}=2y(500-y).\n$$\n\nIn this case, the constant of proportionality is $k=2,$ and the carrying capacity is $a=500.$"} :step/id #uuid "845e97b0-decc-50f2-997f-93c6453f8cf7" :step/next {:db/id #edb/ref 17592186524063}} {:db/id #edb/ref 17592186524073 :step/content {:db/id #edb/ref 17592186101551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c7ca84a-cf9f-50f8-b341-b5cad100965c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=-0.6P(700\\,000+P)" :db/id #edb/ref 17592186523411} {:answer/id #uuid "6ee52ea6-c780-5145-af3b-00bf2afb2de4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=700\\,000P(0.6-P)" :db/id #edb/ref 17592186523481} {:answer/id #uuid "b251d084-9823-5f88-b5bc-44200f475b8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=700\\,000P(0.6+P)" :db/id #edb/ref 17592186523630} {:answer/id #uuid "cdb1b6f5-2157-5ffa-857f-384cd5652759" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=0.6P(700\\,000-P)" :db/id #edb/ref 17592186523684} {:answer/id #uuid "cedd52a2-345c-58b2-928e-6c0218a680ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=0.6P(700\\,000+P)" :db/id #edb/ref 17592186523688}] :answer-field/correct {:db/id #edb/ref 17592186523684} :answer-field/id #uuid "e33bf6b7-b2a2-5c1d-93df-e2640b2be937" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186100467}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5f74431a-7f46-5af6-affc-22cbe39ff9ea" :question/math-academy-id "q-83865" :question/problem "An influenza epidemic is spreading through a community of $700\\,000$ people. The rate of growth in the number of people $P(t)$ infected with the flu is jointly proportional to the number of people who have the flu at time $t,$ measured in days,  and the number of uninfected people. If the constant of proportionality is $0.6,$ which differential equation could be used to model $P(t)?$" :question/worked-solution "Since the growth rate of infected people is *jointly* proportional to the number of people who have the flu at time $t,$ and the number of uninfected people, the number of infected people follows a logistic growth model.\n\nA logistic growth equation has the form\n\n$$\n\\frac{dP}{dt}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nIn this case, the constant of proportionality is $k=0.6,$ and the carrying capacity is $a=700\\,000.$ Therefore, the number of people who have the flu is given by the equation\n\n$$\n\\frac{dP}{dt}=0.6P(700\\,000-P).\n$$"} :step/id #uuid "876b041e-48ee-59ed-9570-27aae1e87501" :step/next {:db/id #edb/ref 17592186524097}} {:db/id #edb/ref 17592186524097 :step/content {:db/id #edb/ref 17592186253556 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bba37af-8df4-5b8c-a930-80d2186439c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=4y(50-y)" :db/id #edb/ref 17592186251435} {:answer/id #uuid "bbe50a92-b71b-5769-a939-63ed274c1a57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=4y(50+y)" :db/id #edb/ref 17592186252210} {:answer/id #uuid "dead85fa-fe2f-53e8-b67b-e9c7315851fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=4y" :db/id #edb/ref 17592186252516} {:answer/id #uuid "fd955712-55d7-5520-b9cd-82c788b4c2f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=50-y" :db/id #edb/ref 17592186252778} {:answer/id #uuid "fe08bd02-4725-5feb-946c-394fc94ff25a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=4(50-y)" :db/id #edb/ref 17592186252781}] :answer-field/correct {:db/id #edb/ref 17592186251435} :answer-field/id #uuid "569731a1-44d9-5454-8f2b-b1754aaefd2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186252956}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "19423d48-c141-516d-a17c-c34914d7472c" :question/math-academy-id "q-119264" :question/problem "Which of the following differential equations is a logistic growth equation?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n\\frac{dy}{dt}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nFrom the given options, the only logistic growth equation is\n\n$$\n\\frac{dy}{dt}=4y(50-y).\n$$\n\nIn this case, the constant of proportionality is $k=4,$ and the carrying capacity is $a=50.$"} :step/id #uuid "c8f38971-defd-50cd-9dce-38d71497ce0f" :step/next {:db/id #edb/ref 17592186524056}}] :activity/title "Logistic Growth Models With First-Order ODEs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186523243}] [{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186536906} :activity/id #uuid "4e8aec36-57c4-5164-a4f1-7f136f4ea506" :activity/scope {:db/id #edb/ref 17592186048578 :topic/id #uuid "aae56e33-e57d-5843-b31c-fcba98a1ca50" :topic/math-academy-id 1163} :activity/steps [{:db/id #edb/ref 17592186536906 :step/content {:db/id #edb/ref 17592186351556 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0beaeee6-9ac5-5b93-a365-215c10551f98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=40y(37+y)" :db/id #edb/ref 17592186348549} {:answer/id #uuid "75a0ea9c-012a-527c-b0ec-69836096b979" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=370+y" :db/id #edb/ref 17592186349530} {:answer/id #uuid "9cad0f4e-385a-589f-96a5-f5961ca16edd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=40y" :db/id #edb/ref 17592186349842} {:answer/id #uuid "b2ee1c18-ada4-5e23-8abc-5cf9e5688ca5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=40y(370-y)" :db/id #edb/ref 17592186350032} {:answer/id #uuid "e530ce83-1805-5df7-8a47-c92ed09acf24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=40(37-y)" :db/id #edb/ref 17592186350459}] :answer-field/correct {:db/id #edb/ref 17592186350032} :answer-field/id #uuid "a277fbe8-63da-5b95-9e1c-12bd506e89b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186350982}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a8b03a78-a009-5ee2-9b73-413e76603e01" :question/math-academy-id "q-83849" :question/problem "Which of the following differential equations is a logistic growth equation?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n\\frac{dy}{dt}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nFrom the given options, the only logistic growth equation is\n\n$$\n\\frac{dy}{dt}=40y(370-y).\n$$\n\nIn this case, the constant of proportionality is $k=40,$ and the carrying capacity is $a=370.$"} :step/id #uuid "0d501e7d-a406-5c5a-a298-944dab97f015" :step/next {:db/id #edb/ref 17592186536963}} {:db/id #edb/ref 17592186536926 :step/content {:db/id #edb/ref 17592186536883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22b2c358-09d5-578e-8970-70cbd506ef07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=12-\\frac{3}{2}{y}^{2}" :db/id #edb/ref 17592186536331} {:answer/id #uuid "93d3472f-ebac-5e70-ab44-c478a48ef8a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=\\frac{3}{2}{y}^{2}" :db/id #edb/ref 17592186536519} {:answer/id #uuid "a05d2a83-b19c-56b6-8c4a-abda407e4876" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=12y+\\frac{3}{2}{y}^{2}" :db/id #edb/ref 17592186536545} {:answer/id #uuid "bb7ed10b-16fa-58b9-9d6f-f538691e80da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=12y-\\frac{3}{2}" :db/id #edb/ref 17592186536580} {:answer/id #uuid "ea474472-9aa6-58f8-92d7-2af3c1726240" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=12y-\\frac{3}{2}{y}^{2}" :db/id #edb/ref 17592186536651}] :answer-field/correct {:db/id #edb/ref 17592186536651} :answer-field/id #uuid "5145867a-16a7-5938-9452-ce8785416418" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536735}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d2dfce9f-843a-50f1-956d-65c7968632c5" :question/math-academy-id "q-119272" :question/problem "Which of the following differential equations is a logistic growth equation?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n\\frac{dy}{dt}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nFrom the given options, the only logistic growth equation is\n\n$$\n\\frac{dy}{dt}=12y-\\frac{3}{2}{y}^{2}.\n$$\n\nTo see this, let's factor the right-hand side of the equation. This gives,\n\n$$\n\\frac{dy}{dt}=\\frac{3}{2}y(8-y).\n$$\n\nFrom here, we see that the constant of proportionality is $k=\\frac{3}{2},$ and the carrying capacity is $a=8.$"} :step/id #uuid "4e024194-1784-50c8-99d5-8c713e4608d3" :step/next {:db/id #edb/ref 17592186536951}} {:db/id #edb/ref 17592186536951 :step/content {:db/id #edb/ref 17592186536863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "743e3759-02ab-55f0-b4e0-a5e188a47db8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=30\\,000\\,000P(0.000\\,01-P)" :db/id #edb/ref 17592186536475} {:answer/id #uuid "74e2b3d2-bce7-54a2-9b79-91471f680491" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=-0.000\\,01P(30\\,000\\,000-P)" :db/id #edb/ref 17592186536476} {:answer/id #uuid "9ff927fc-13bd-58f0-ae73-06ad00980ab2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=30\\,000\\,000P(0.000\\,01+P)" :db/id #edb/ref 17592186536542} {:answer/id #uuid "b5633021-65b1-5655-851a-9c5cc3387aa0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=0.000\\,01P(30\\,000\\,000-P)" :db/id #edb/ref 17592186536572} {:answer/id #uuid "c1b2688a-a907-53f7-9404-a7e6a7f57da7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=0.000\\,01P(30\\,000\\,000+P)" :db/id #edb/ref 17592186536589}] :answer-field/correct {:db/id #edb/ref 17592186536572} :answer-field/id #uuid "06e2caa6-684d-5873-b7d1-19bd4b554ff8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536701}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9f125700-0b98-51e1-a020-af8c1b00c96f" :question/math-academy-id "q-119285" :question/problem "The growth rate of the population $P(t)$ in a certain country is jointly proportional to the population at time $t,$ measured in years, and the difference between the country's carrying capacity and the population. If the constant of proportionality is $0.000\\,01$ and the maximum possible population is $30\\,000\\,000,$ which differential equation could be used to model $P(t)?$" :question/worked-solution "Since the population's growth rate is *jointly* proportional to the population at time $t$ and the difference between the carrying capacity and the population, the population follows a logistic growth model.\n\nA logistic growth equation has the form\n\n$$\n\\frac{dP}{dt}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nIn this case, the constant of proportionality is $k=0.000\\,01,$ and the carrying capacity is $a=30\\,000\\,000.$ Therefore, the population is given by the equation\n\n$$\n\\frac{dP}{dt}=0.000\\,01P(30\\,000\\,000-P).\n$$"} :step/id #uuid "8b7d7adf-7ba8-5309-91c3-8926ca95fe88"} {:db/id #edb/ref 17592186536959 :step/content {:db/id #edb/ref 17592186536854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd23510-2db8-57da-b03b-19947512a51c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=1\\,000P(0.05+P)" :db/id #edb/ref 17592186536325} {:answer/id #uuid "2cd7eaeb-5a1a-5699-bd57-bb98c1bd9464" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=0.05P(1\\,000-P)" :db/id #edb/ref 17592186536352} {:answer/id #uuid "3a51bae9-e725-5a29-b29e-cc1f2c4e37c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=1\\,000P(0.05-P)" :db/id #edb/ref 17592186536375} {:answer/id #uuid "e0fceb3e-eb15-5178-8697-6df9c91f70e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=-0.05P(1\\,000+P)" :db/id #edb/ref 17592186536631} {:answer/id #uuid "f2c768ba-28d5-5f1d-815a-361c780dab8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dP}{dt}=0.05P(1\\,000+P)" :db/id #edb/ref 17592186536671}] :answer-field/correct {:db/id #edb/ref 17592186536352} :answer-field/id #uuid "0175e659-cba3-56a0-ab48-25d20caff549" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536696}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8b4b9134-52af-5188-95f0-9a0da05afadf" :question/math-academy-id "q-83861" :question/problem "The growth rate of the crab population $P(t)$ in a certain lake is jointly proportional to the crab population at time $t,$ measured in years, and the difference between the lake's carrying capacity and the crab population. If the constant of proportionality is $0.05$ and the maximum possible crab population is $1\\,000,$ which differential equation could be used to model $P(t)?$" :question/worked-solution "Since the crab population's growth rate is *jointly* proportional to the crab population at time $t$ and the difference between the carrying capacity and the crab population, the crab population follows a logistic growth model.\n\nA logistic growth equation has the form\n\n$$\n\\frac{dP}{dt}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nIn this case, the constant of proportionality is $k=0.05,$ and the carrying capacity is $a=1\\,000.$ Therefore, the crab population is given by the equation\n\n$$\n\\frac{dP}{dt}=0.05P(1\\,000-P).\n$$"} :step/id #uuid "a9bc41cf-00be-5e52-9c2e-495ad57846b2" :step/next {:db/id #edb/ref 17592186536926}} {:db/id #edb/ref 17592186536963 :step/content {:db/id #edb/ref 17592186536868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba7e32a-043c-5931-9dab-fc2b20f12800" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=3y+{y}^{2}" :db/id #edb/ref 17592186536305} {:answer/id #uuid "4c2e65ff-a8f3-5761-bf62-d366e3c46fca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=3-{y}^{2}" :db/id #edb/ref 17592186536408} {:answer/id #uuid "7567addf-e4b0-589e-a11d-3a3a13e6546a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=4-y" :db/id #edb/ref 17592186536480} {:answer/id #uuid "c19039df-bdb3-5ee3-9b88-548c6a17e19b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=3+y" :db/id #edb/ref 17592186536587} {:answer/id #uuid "f5f817ac-4342-536d-890b-3ceed2d07931" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dt}=3y-4{y}^{2}" :db/id #edb/ref 17592186536678}] :answer-field/correct {:db/id #edb/ref 17592186536678} :answer-field/id #uuid "6fb6b47e-6d7c-543e-a3d2-2ef7185b7ec9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186536751}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "aac8b725-2415-58f2-86b7-ef6ffd39cf4e" :question/math-academy-id "q-83853" :question/problem "Which of the following differential equations is a logistic growth equation?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n\\frac{dy}{dt}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nFrom the given options, the only logistic growth equation is\n\n$$\n\\frac{dy}{dt}=3y-4{y}^{2}.\n$$\n\nTo see this, let's factor the right-hand side of the equation. This gives,\n\n$$\n\\frac{dy}{dt}=4y(\\frac{3}{4}-y).\n$$\n\nFrom here, we see that the constant of proportionality is $k=4,$ and the carrying capacity is $a=\\frac{3}{4}.$"} :step/id #uuid "b86f1c28-4218-562a-a0c4-16e6a30b7655" :step/next {:db/id #edb/ref 17592186536959}}] :activity/title "Logistic Growth Models With First-Order ODEs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186536272}]}
