#{[{:db/id #edb/ref 17592186351556 :knowledge-point/_questions [{:db/id #edb/ref 17592186100943 :knowledge-point/id #uuid "a4751337-93bf-5b47-8b3f-32100820b19a" :knowledge-point/title "Identifying a Logistic Growth Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0beaeee6-9ac5-5b93-a365-215c10551f98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=40y(37+y)" :db/id #edb/ref 17592186348549} {:answer/id #uuid "75a0ea9c-012a-527c-b0ec-69836096b979" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=370+y" :db/id #edb/ref 17592186349530} {:answer/id #uuid "9cad0f4e-385a-589f-96a5-f5961ca16edd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=40y" :db/id #edb/ref 17592186349842} {:answer/id #uuid "b2ee1c18-ada4-5e23-8abc-5cf9e5688ca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=40y(370-y)" :db/id #edb/ref 17592186350032} {:answer/id #uuid "e530ce83-1805-5df7-8a47-c92ed09acf24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=40(37-y)" :db/id #edb/ref 17592186350459}] :answer-field/correct {:answer/id #uuid "b2ee1c18-ada4-5e23-8abc-5cf9e5688ca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dy}{dt}=40y(370-y)" :db/id #edb/ref 17592186350032} :answer-field/id #uuid "a277fbe8-63da-5b95-9e1c-12bd506e89b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350982}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8b03a78-a009-5ee2-9b73-413e76603e01" :question/math-academy-id "q-83849" :question/problem "Which of the following differential equations is a logistic growth equation?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n\\frac{dy}{dt}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nFrom the given options, the only logistic growth equation is\n\n$$\n\\frac{dy}{dt}=40y(370-y).\n$$\n\nIn this case, the constant of proportionality is $k=40,$ and the carrying capacity is $a=370.$"}]}
