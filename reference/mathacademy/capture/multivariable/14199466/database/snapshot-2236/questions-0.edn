uid "beba90ab-c39c-5ee8-8143-2d2419efb8f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (csch x(x\\coth x + 2))/(2x^{3})" :db/id #edb/ref 17592186165276} {:answer/id #uuid "d4539643-4cd0-5c23-bd67-a4913ed31fa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4csch x(\\coth x + 2))/(x^{4})" :db/id #edb/ref 17592186165277} {:answer/id #uuid "f4fd3466-f5bf-56d2-af02-89a39628972b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (csch x(\\coth x + x))/(x^{3})" :db/id #edb/ref 17592186165278}] :answer-field/id #uuid "66bb6a07-ca7f-50c9-b79b-cace17e398e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165273}] :question/id #uuid "6a4c419a-8142-571d-8243-5f64958e4a28" :question/math-academy-id "q-95287" :question/problem "Find the derivative of $f(x) = \\frac{csch x}{2x^{2}}$."}] [{:db/id #edb/ref 17592186167368 :knowledge-point/_questions [{:db/id #edb/ref 17592186166761 :knowledge-point/id #uuid "597e3939-e6b4-5237-a16e-8bae92f9b656" :knowledge-point/title "Basic Derivatives of the Reciprocal Hyperbolic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a37b7bde-4f5b-5f94-ac7b-2867bcc3fc5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sech x\\tanh x + 2csch x\\coth x" :db/id #edb/ref 17592186165417} {:answer/id #uuid "ad24ffb3-5e6c-5b09-9fe3-18f2e715f06e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sech x(\\tanh x + 2csch x)" :db/id #edb/ref 17592186165418} {:answer/id #uuid "2afe7502-3eab-5309-8390-1399d0c80e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sech x\\tanh x + 2csch^{2} x\\coth x" :db/id #edb/ref 17592186165419} {:answer/id #uuid "389bb1c5-9ced-5f0a-b45a-cb801c45266a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sech x\\tanh x - 2csch^{2} x\\coth x" :db/id #edb/ref 17592186165420} {:answer/id #uuid "7fc9e493-b4b6-5f9f-a391-130f2cbea0fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sech x(-\\tanh x - 2sech x)" :db/id #edb/ref 17592186165421}] :answer-field/id #uuid "c0a3ff9d-4c25-52f6-a5ce-1978a3171c0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165416}] :question/id #uuid "36aad765-1c48-5148-a5cb-bc60296086fb" :question/math-academy-id "q-95451" :question/problem "Find the derivative of $y = sech x - 2csch x$."}]}
