#{[{:activity/first-step {:db/id #edb/ref 17592186167700} :activity/id #uuid "c20fbe32-d31b-52ad-8872-431ee715865b" :activity/scope {:db/id #edb/ref 17592186050543 :topic/id #uuid "52518f9a-d06e-5b21-9515-0ca55ed7e1c6" :topic/math-academy-id 3251} :activity/steps [{:db/id #edb/ref 17592186167593 :step/content {:db/id #edb/ref 17592186166761 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166599 :question/id #uuid "3817c58a-1176-5347-aa96-2846969cae32" :question/math-academy-id "e-8349"} :knowledge-point/id #uuid "597e3939-e6b4-5237-a16e-8bae92f9b656" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048192}] :knowledge-point/questions [{:db/id #edb/ref 17592186167341} {:db/id #edb/ref 17592186167368}] :knowledge-point/title "Basic Derivatives of the Reciprocal Hyperbolic Functions"} :step/id #uuid "b64d6121-c7b1-598c-88b7-d93e228e9eaa" :step/math-academy-id 31178 :step/next {:db/id #edb/ref 17592186167594}} {:db/id #edb/ref 17592186167594 :step/content {:db/id #edb/ref 17592186166762 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166600 :question/id #uuid "b14f0558-456d-51a9-85ac-0b36158bc52e" :question/math-academy-id "e-8350"} :knowledge-point/id #uuid "6fd03e86-fab7-5157-b0f3-62c522dc212c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051084}] :knowledge-point/questions [{:db/id #edb/ref 17592186167342} {:db/id #edb/ref 17592186167390}] :knowledge-point/title "Differentiating Reciprocal Hyperbolic Functions Using the Chain Rule"} :step/id #uuid "78f3cfb7-8cc3-5af3-a38d-387410a4f13c" :step/math-academy-id 31180 :step/next {:db/id #edb/ref 17592186167595}} {:db/id #edb/ref 17592186167595 :step/content {:db/id #edb/ref 17592186166763 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166601 :question/id #uuid "4baa8799-f8ce-521e-833b-8b66c747e701" :question/math-academy-id "e-8351"} :knowledge-point/id #uuid "a991a2f4-b96a-5f92-8b52-6102647be98e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813}] :knowledge-point/questions [{:db/id #edb/ref 17592186167343} {:db/id #edb/ref 17592186167393}] :knowledge-point/title "Differentiating Reciprocal Hyperbolic Functions Using the Product Rule"} :step/id #uuid "1dc4c0db-f2ea-5960-841d-325f01516019" :step/math-academy-id 31181 :step/next {:db/id #edb/ref 17592186167596}} {:db/id #edb/ref 17592186167596 :step/content {:db/id #edb/ref 17592186166764 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166602 :question/id #uuid "bec9b472-31ce-5892-8a17-c4aa3c33ef12" :question/math-academy-id "e-8352"} :knowledge-point/id #uuid "08d9798e-a4bb-5f04-9d49-494990c52bff" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048842}] :knowledge-point/questions [{:db/id #edb/ref 17592186167344} {:db/id #edb/ref 17592186167424} {:db/id #edb/ref 17592186360647} {:db/id #edb/ref 17592186385961}] :knowledge-point/title "Differentiating Reciprocal Hyperbolic Functions Using the Quotient Rule"} :step/id #uuid "5d7db477-93fd-5bed-83a1-3451d28c23a2" :step/math-academy-id 31182 :step/next {:db/id #edb/ref 17592186167711}} {:db/id #edb/ref 17592186167700 :step/content {:db/id #edb/ref 17592186168090 :tutorial/content "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe derivatives of the reciprocal hyperbolic functions are as follows:\n\n$$\n\\begin{aligned}\n\\frac{d}{dx}(sech x) &= -sech x\\tanh x \\\\\n\\frac{d}{dx}(csch x) &= -csch x\\coth x \\\\\n\\frac{d}{dx}(\\coth x) &= -csch^{2} x\n\\end{aligned}\n$$\n\nLet's use these results to find the derivative of\n\n$$\ny= \\sech x - 2\\csch x\n$$\n\nDifferentiating term-by-term, we get\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(sech x - 2csch x) \\\\\n&= \\frac{d}{dx}(sech x) + \\frac{d}{dx}(-2csch x) \\\\\n&= \\frac{d}{dx}(sech x) - 2\\frac{d}{dx}(csch x) \\\\\n&=-sech x\\tanh x - 2(-csch x\\coth x) \\\\\n&=-sech x\\tanh x + 2csch x\\coth x\n\\end{aligned}\n$$" :tutorial/id #uuid "9f94990a-0da5-522a-9d5f-7e0b269b50ac" :tutorial/math-academy-id 5208 :tutorial/title "Introduction"} :step/id #uuid "a9dbf529-bcef-5ee9-8535-112f0fae57f5" :step/math-academy-id 32692 :step/next {:db/id #edb/ref 17592186167593}} {:db/id #edb/ref 17592186167711 :step/content {:db/id #edb/ref 17592186168101 :tutorial/content "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nWe wish to prove the following result:\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\sech{x}) = -\\sech{x} \\tanh{x}\n$$\n\nTo do this, we can use the fact that\n\n$$\n\\sech x = \\dfrac{1}{\\cosh x}\n$$\n\nDifferentiating the above equation using the chain rule, we arrive at\n\n$$\n\\begin{aligned}\n\\frac{d}{dx}(sech x) &= \\frac{d}{dx}(\\frac{1}{\\cosh x}) \\\\\n&= \\frac{d}{dx}(\\cosh x)^{-1} \\\\\n&= - (\\cosh x)^{-2} \\cdot (\\cosh x)^{′} \\\\\n&=-\\frac{1}{\\cosh^{2} x} \\cdot \\sinh x \\\\\n&=-\\frac{1}{\\cosh x} \\cdot \\frac{\\sinh x}{\\cosh x} \\\\\n&=-sech x\\tanh x\n\\end{aligned}\n$$\n\nWe can prove the results for the derivatives of the hyperbolic cosecant and cotangent in a similar way." :tutorial/id #uuid "cb6ff220-98cb-5e8a-8a09-958d158b0d10" :tutorial/math-academy-id 5226 :tutorial/title "Deriving the Result for the Derivative of the Hyperbolic Secant"} :step/id #uuid "143b8be3-52fa-5eb8-99d4-c0ff1ef2dbfd" :step/math-academy-id 32719}] :activity/title "Differentiating Reciprocal Hyperbolic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186167018}]}
