se\">)</mo><mo data-mjx-alternate=\"1\">′</mo></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn><mo>⋅</mo><mi>sech</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>3</mn><mi>x</mi><mo>+</mo><mi>x</mi><mo>⋅</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>3</mn><mi>sech</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>3</mn><mi>x</mi><mo>⋅</mo><mi>tanh</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>3</mn><mi>x</mi><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>sech</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>3</mn><mi>x</mi><mo>−</mo><mn>3</mn><mi>x</mi><mi>sech</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>3</mn><mi>x</mi><mi>tanh</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>3</mn><mi>x</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>sech</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>3</mn><mi>x</mi><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><mn>3</mn><mi>x</mi><mi>tanh</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>3</mn><mi>x</mi><mo stretchy=\"false\">)</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
