      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14149541/observations/step-q333328-5b7060510d65ad5da32d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14149541/observations/step-q333328-5b7060510d65ad5da32d.png",
      "source_url": "https://mathacademy.com/tasks/14149541/topics/3239/review",
      "captured_at": 1791841480.5903828,
      "math_academy_id": "q-333328",
