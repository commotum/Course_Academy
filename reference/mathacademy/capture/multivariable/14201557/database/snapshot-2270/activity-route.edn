#{[{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186519663} :activity/id #uuid "a533a8f5-d82f-58f4-9e51-bc3fbd4d4252" :activity/scope {:db/id #edb/ref 17592186048990 :topic/id #uuid "d1a9318f-8bb8-5f48-a251-a72b43bbe791" :topic/math-academy-id 6377} :activity/steps [{:db/id #edb/ref 17592186519612 :step/content {:db/id #edb/ref 17592186311602 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32ceebdb-d7b6-51b7-86a2-d214dea3680b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\begin{bmatrix}1 \\\\ -\\frac{2}{3}\\end{bmatrix}$\nand\n$\\begin{bmatrix}-\\frac{1}{3} \\\\ -\\frac{1}{3}\\end{bmatrix}$" :db/id #edb/ref 17592186309135} {:answer/id #uuid "72a65e36-e923-57e6-8166-6283e6b8b0ee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\begin{bmatrix}-\\frac{1}{3} \\\\ \\frac{2}{3}\\end{bmatrix}$ only" :db/id #edb/ref 17592186309640} {:answer/id #uuid "738673b5-46fd-5863-a8bc-e5a27f9f15ac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\begin{bmatrix}\\frac{1}{3} \\\\ \\frac{1}{3}\\end{bmatrix}$ only" :db/id #edb/ref 17592186309645} {:answer/id #uuid "8cbc071d-da47-5eb1-8b0c-996bfba59162" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$\nand\n$\\begin{bmatrix}\\frac{4}{3} \\\\ \\frac{1}{3}\\end{bmatrix}$" :db/id #edb/ref 17592186309858} {:answer/id #uuid "f831b1c3-c0d0-50a0-a3b3-eb35cd93ec8a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\begin{bmatrix}\\frac{1}{3} \\\\ -\\frac{1}{3}\\end{bmatrix}$ only" :db/id #edb/ref 17592186310725}] :answer-field/correct {:db/id #edb/ref 17592186309645} :answer-field/id #uuid "14e31a25-a227-58c6-80ad-026b2b9a9902" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186310849}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ca82624e-361e-5ab0-8f3d-deb7e2b73fe4" :question/math-academy-id "q-335470" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=x(t)+2y(t)-1 \\\\ {y}^{′}(t)=2x(t)-2y(t)\\end{aligned}\n$$\n\nWhich of the following gives all equilibrium points of the system of linear differential equations above?" :question/worked-solution "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of linear equations:\n\n$$\n{\\begin{aligned}x+2y-1=0 \\\\ 2x-2y=0\\end{aligned}\n$$\n\nAdding both equations, we obtain\n\n$$\n3x-1=0\\,⇒\\,x=\\frac{1}{3}.\n$$\n\nSubstituting this into the first equation, we get\n\n$$\n\\frac{1}{3}+2y-1=0\\,⇒\\,y=\\frac{1}{3}.\n$$\n\nTherefore, the equilibrium point is\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}\\frac{1}{3} \\\\ \\frac{1}{3}\\end{bmatrix}.\n$$"} :step/id #uuid "178605e4-baed-5eae-a9e6-a3614ae150cd" :step/next {:db/id #edb/ref 17592186519658}} {:db/id #edb/ref 17592186519628 :step/content {:db/id #edb/ref 17592186311598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0216fb78-36e7-5fd7-9246-3e737defdfce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "but move away from" :db/id #edb/ref 17592186308762} {:answer/id #uuid "7e875b01-c0dd-5704-8b94-d2069cc3a449" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "but may not converge to" :db/id #edb/ref 17592186309736} {:answer/id #uuid "e60ff41d-00a8-5a24-9cc9-a701360fc75e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "and converge to" :db/id #edb/ref 17592186310579}] :answer-field/correct {:db/id #edb/ref 17592186310579} :answer-field/id #uuid "06846934-f0f5-5d56-967b-36e1be7d1cd7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186310812} {:answer-field/choices [{:answer/id #uuid "6cffc238-bdc2-5488-a2a9-01f8a5132fa4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "infinity" :db/id #edb/ref 17592186309590} {:answer/id #uuid "dd277782-e85c-51b6-b68c-19bbddccbff4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "equilibrium" :db/id #edb/ref 17592186310521}] :answer-field/correct {:db/id #edb/ref 17592186310521} :answer-field/id #uuid "18cdc60a-e62b-5388-a355-40ed46d8a759" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186310858} {:answer-field/choices [{:answer/id #uuid "43d0572b-c025-54a2-82a2-886ba718a716" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "away from" :db/id #edb/ref 17592186309263} {:answer/id #uuid "98df1e95-184a-5054-ab9e-aa93f0db9931" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "close to" :db/id #edb/ref 17592186309981}] :answer-field/correct {:db/id #edb/ref 17592186309981} :answer-field/id #uuid "867c4e42-08e8-5a5d-bc61-317f244c03f1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186311171} {:answer-field/choices [{:answer/id #uuid "7317786c-0ffd-5246-bf97-f1d1f32109d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\to \\infty " :db/id #edb/ref 17592186309643} {:answer/id #uuid "8b8303fa-b5e9-56fb-bb27-011c82bf94be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\to 0" :db/id #edb/ref 17592186309849}] :answer-field/correct {:db/id #edb/ref 17592186309643} :answer-field/id #uuid "876165af-35ba-5cdc-88bb-3e8200fa2314" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186311176}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d70bc07a-1c80-562a-90f6-efe6dcc9cf2e" :question/math-academy-id "q-335458" :question/problem "Select the correct options in the statement below that describe an **asymptotically stable** equilibrium point.\n\nThe solutions that start sufficiently \n{{field-1}}\nthe equilibrium remain close to the equilibrium\n{{field-2}} \nthe \n{{field-3}} \nas \n{{field-4}}." :question/worked-solution "Let's recall the definitions of stability:\n\n- An equilibrium point ${x}^{∗}$ is called *stable* if for any neighborhood $O$ of ${x}^{∗},$ there exists a neighborhood ${O}_{1}⊆O$ such that every orbit that begins inside ${O}_{1}$ at some point in time $t={t}_{0}$ remains inside $O$ for all $t>{t}_{0}.$\n\nIn plain words, this means that solutions that start sufficiently close to the equilibrium remain close, but may not converge to the equilibrium.\n\n- An equilibrium point ${x}^{∗}$ is called *asymptotically stable* if it is stable and there exists a neighborhood $O$ of ${x}^{∗}$ such that every orbit that begins inside $O$ approaches ${x}^{∗}$ as $t\\to \\infty .$\n\nIn plain words, this means that solutions that start sufficiently close to the equilibrium remain close and converge to the equilibrium as $t\\to \\infty .$\n\n- An equilibrium point ${x}^{∗}$ is called *unstable* if it is not stable.\n\nIn plain words, this means that solutions eventually move away from the equilibrium for some initial conditions arbitrarily close to it.\n\nTherefore, the correct answer is the following:\n\nThe solutions that start sufficiently $\\text{close to}$ the equilibrium remain close to the equilibrium $\\text{and converge to}$ the $\\text{equilibrium}$ as $t\\to \\infty .$"} :step/id #uuid "4316790b-9967-50da-b9e8-9e00db267c48" :step/next {:db/id #edb/ref 17592186519612}} {:db/id #edb/ref 17592186519646 :step/content {:db/id #edb/ref 17592186519546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d26d55a-2db1-5794-93cd-256be9c6f385" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Solutions can converge to the equilibrium only when the system is linear." :db/id #edb/ref 17592186519154} {:answer/id #uuid "6eb76b8e-a8f2-5c68-b70a-8cfa6fdb979b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Solutions starting close to the equilibrium stay close only for a finite time, then may behave arbitrarily." :db/id #edb/ref 17592186519159} {:answer/id #uuid "7294c019-31b4-5ece-b07f-0fa3b97c7049" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No matter how close a solution starts to the equilibrium, it will eventually leave any fixed neighborhood of the equilibrium." :db/id #edb/ref 17592186519169} {:answer/id #uuid "b2c1c5b1-aa60-5c38-89ae-5e3c68d09da5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Solutions starting close to the equilibrium may leave a small neighborhood of it but still converge to it as $t\\to \\infty .$" :db/id #edb/ref 17592186519286} {:answer/id #uuid "f9263fe6-3236-5773-93ed-b447eb0714dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Solutions that start sufficiently close to the equilibrium remain close, but do not necessarily converge to the equilibrium." :db/id #edb/ref 17592186519405}] :answer-field/correct {:db/id #edb/ref 17592186519405} :answer-field/id #uuid "c7566841-5810-5062-9cbb-2828c6d469a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186519493}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "63f582f6-9d11-5d33-b64d-69b2836d097f" :question/math-academy-id "q-335453" :question/problem "Which statement correctly describes a **stable** equilibrium point?" :question/worked-solution "Let's recall the definitions of stability:\n\n- An equilibrium point ${x}^{∗}$ is called *stable* if for any neighborhood $O$ of ${x}^{∗},$ there exists a neighborhood ${O}_{1}⊆O$ such that every orbit that begins inside ${O}_{1}$ at some point in time $t={t}_{0}$ remains inside $O$ for all $t>{t}_{0}.$\n\nIn plain words, this means that solutions that start sufficiently close to the equilibrium remain close, but may not converge to the equilibrium.\n\n- An equilibrium point ${x}^{∗}$ is called *asymptotically stable* if it is stable and there exists a neighborhood $O$ of ${x}^{∗}$ such that every orbit that begins inside $O$ approaches ${x}^{∗}$ as $t\\to \\infty .$\n\nIn plain words, this means that solutions that start sufficiently close to the equilibrium remain close and converge to the equilibrium as $t\\to \\infty .$\n\n- An equilibrium point ${x}^{∗}$ is called *unstable* if it is not stable.\n\nIn plain words, this means that solutions eventually move away from the equilibrium for some initial conditions arbitrarily close to it.\n\nTherefore, the correct answer is the following:\n\nSolutions that start sufficiently close to the equilibrium remain close, but do not necessarily converge to the equilibrium."} :step/id #uuid "7773724f-136a-56c6-a6ef-91a1e9b18f93" :step/next {:db/id #edb/ref 17592186519628}} {:db/id #edb/ref 17592186519658 :step/content {:db/id #edb/ref 17592186311617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d0af402-a3d6-5494-a083-1e02c24805bd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$ only" :db/id #edb/ref 17592186308972} {:answer/id #uuid "3d82b4e8-7462-56ad-9ed7-c1f4157071f4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$\nand\n$\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}$" :db/id #edb/ref 17592186309215} {:answer/id #uuid "88a5e0dc-5f20-5b1c-bdee-ba3493ba66ab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}$ only" :db/id #edb/ref 17592186309821} {:answer/id #uuid "8d5aeb9c-5200-5e7a-af45-7a25f416a8b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\text{ }\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},\\text{ }\\text{and}\\text{ }\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186309863} {:answer/id #uuid "aac0f80d-ef40-57e9-b971-a160b30a54b0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$\nand\n$\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$" :db/id #edb/ref 17592186310127}] :answer-field/correct {:db/id #edb/ref 17592186309863} :answer-field/id #uuid "07f44bd2-809c-553b-be26-f8df00cee6b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186310815}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9eb2e7ac-d5ca-5678-9359-e4e2a4d80ebd" :question/math-academy-id "q-335657" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=x(t)+y(t)-1 \\\\ {y}^{′}(t)={y}^{3}(t)+x(t)-1\\end{aligned}\n$$\n\nWhich of the following gives all equilibrium points of the system of differential equations above?" :question/worked-solution "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of equations:\n\n$$\n{\\begin{aligned}x+y-1=0 \\\\ {y}^{3}+x-1=0\\end{aligned}\n$$\n\nNow, we solve the first equation for $x:$\n\n$$\n\\begin{aligned}x+y-1=0\\,⇒\\,x=1-y\\end{aligned}\n$$\n\nNext, we substitute $x$ into the second equation\n\n$$\n\\begin{aligned}{y}^{3}+x-1 & =0 \\\\ {y}^{3}+(1-y)-1 & =0 \\\\ {y}^{3}-y & =0 \\\\ y({y}^{2}-1) & =0 \\\\ y(y-1)(y+1) & =0 \\\\ y & =-1,\\text{ }0,\\text{ }1.\\end{aligned}\n$$\n\nNow, we compute $x:$\n\n- For $y=0,$ we get $x=1-0=1.$\n\n- For $y=1,$ we get $x=1-1=0.$\n\n- For $y=-1,$ we get $x=1-(-1)=2.$\n\nTherefore, the equilibrium points are\n\n$$\n\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\\,\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},\\,\\text{and}\\,\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}.\n$$"} :step/id #uuid "ab29950b-5bb8-5ab5-996e-f7d41e4da9e1"} {:db/id #edb/ref 17592186519663 :step/content {:db/id #edb/ref 17592186308445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14e0b670-47dc-5a81-b6a3-73480799b684" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Stable but not asymptotically stable." :db/id #edb/ref 17592186305330} {:answer/id #uuid "155e1b96-9f12-5a78-8177-2ef3dd7dffe3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Unstable." :db/id #edb/ref 17592186305337} {:answer/id #uuid "1c49b675-9a33-5a1b-bfe1-fb87827512d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Asymptotically stable." :db/id #edb/ref 17592186305412} {:answer/id #uuid "ac0cf04c-3ed2-5c47-b074-fbdb27ec7e6b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Asymptotically stable only for nonlinear systems." :db/id #edb/ref 17592186306774} {:answer/id #uuid "c141bb23-13e7-5a1f-9653-dfc26c953e10" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Asymptotically unstable." :db/id #edb/ref 17592186306957}] :answer-field/correct {:db/id #edb/ref 17592186305412} :answer-field/id #uuid "ea866ddf-d714-574d-89e8-b458a481e7d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186308257}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4dbea5a9-54c6-5f65-9a92-c413f9e3360e" :question/math-academy-id "q-333365" :question/problem "A small perturbation away from an equilibrium causes trajectories to slowly spiral towards the equilibrium. How should the equilibrium be classified?" :question/worked-solution "Let's recall the definitions of stability:\n\n- An equilibrium point ${x}^{∗}$ is called *stable* if for any neighborhood $O$ of ${x}^{∗},$ there exists a neighborhood ${O}_{1}⊆O$ such that every orbit that begins inside ${O}_{1}$ at some point in time $t={t}_{0}$ remains inside $O$ for all $t>{t}_{0}.$\n\nIn plain words, this means that solutions that start sufficiently close to the equilibrium remain close, but may not converge to the equilibrium.\n\n- An equilibrium point ${x}^{∗}$ is called *asymptotically stable* if it is stable and there exists a neighborhood $O$ of ${x}^{∗}$ such that every orbit that begins inside $O$ approaches ${x}^{∗}$ as $t\\to \\infty .$\n\nIn plain words, this means that solutions that start sufficiently close to the equilibrium remain close and converge to the equilibrium as $t\\to \\infty .$\n\n- An equilibrium point ${x}^{∗}$ is called *unstable* if it is not stable.\n\nIn plain words, this means that solutions eventually move away from the equilibrium for some initial conditions arbitrarily close to it.\n\nTherefore, the correct answer is \"Asymptotically stable.\""} :step/id #uuid "ca26e31c-48d1-5c1f-b0d2-6caca076d885" :step/next {:db/id #edb/ref 17592186519646}}] :activity/title "Equilibrium Points and Stability for Systems of ODEs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186518982}]}
