      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14123845/observations/step-q127256-c8425def4c5f7a418eba.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14123845/observations/step-q127256-c8425def4c5f7a418eba.png",
      "source_url": "https://mathacademy.com/tasks/14123845/topics/3716/lesson",
