7-8595-5dd9-872f-af28d256f5d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{3}" :db/id #edb/ref 17592186420488}] :answer-field/correct {:answer/id #uuid "6bdb7dff-5315-5b34-963b-b23231924305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186420481} :answer-field/id #uuid "e0f59fc3-d642-5f6b-9b06-fc7d67132d2a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186420494}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "17f63cde-bca7-5760-8481-ec7b747c5fc4" :question/math-academy-id "q-343408" :question/problem "Consider the function $F(x)={x}^{2}$ defined on $x\\in [-\\pi ,\\pi ).$\nThe Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼\\frac{{\\pi }^{2}}{3}+{\\sum }_{n=1}^{\\infty }\\frac{4(-1)^{n}}{{n}^{2}}\\operatorname{cos}⁡(nx).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(n\\cdot 0)={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{{n}^{2}}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼\\frac{{\\pi }^{2}}{3}+4{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$\n\nNow, notice that at $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(n\\cdot 0)=\\operatorname{cos}⁡(0)=1.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)=0.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(0) & =\\frac{{\\pi }^{2}}{3}+4{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}}\\cdot \\operatorname{cos}⁡(n\\cdot 0) \\\\ 0 & =\\frac{{\\pi }^{2}}{3}+4{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}}\\cdot 1 \\\\ -\\frac{{\\pi }^{2}}{3} & =4{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}} & =-\\frac{{\\pi }^{2}}{12} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{{n}^{2}} & =\\frac{{\\pi }^{2}}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186402338 :knowledge-point/_questions [{:db/id #edb/ref 17592186166961 :knowledge-point/id #uuid "b3cb7656-1ce6-5b6a-9e88-5ba24a943c3f" :knowledge-point/title "Finding the Value of an Infinite Sum Using Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34e78128-47e4-5867-8d9d-3e3880cad539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186402340} {:answer/id #uuid "98c90103-4a5a-5ee2-9a58-bde0723208bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186402341} {:answer/id #uuid "72d35535-c3d9-5627-8854-f43be0b19b2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186402342}] :answer-field/correct {:answer/id #uuid "72d35535-c3d9-5627-8854-f43be0b19b2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186402342} :answer-field/id #uuid "a931e99f-1c36-5243-ab29-1d8ea37ad834" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186402339} {:answer-field/choices [{:answer/id #uuid "a6790e92-fb38-5a26-be1f-619d323d56c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186402344} {:answer/id #uuid "c6a9f00f-d083-56ca-b135-e272d4520815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/