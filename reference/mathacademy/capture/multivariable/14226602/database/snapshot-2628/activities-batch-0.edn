#{[{:activity/first-step {:db/id #edb/ref 17592186106795} :activity/id #uuid "deea7536-b449-5c82-a4db-d4a5eabbb8cf" :activity/scope {:db/id #edb/ref 17592186049706 :topic/id #uuid "0cf35b77-8669-5bf8-b746-48518894d918" :topic/math-academy-id 1274} :activity/steps [{:db/id #edb/ref 17592186106663 :step/content {:db/id #edb/ref 17592186105760 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105612 :question/id #uuid "e17be858-3226-5845-b0c9-f3cf86987ee6" :question/math-academy-id "e-5395"} :knowledge-point/id #uuid "ba3182f3-3b70-5d65-bbb3-6a5e163b3a1a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048402} {:db/id #edb/ref 17592186049568} {:db/id #edb/ref 17592186049613} {:db/id #edb/ref 17592186049869}] :knowledge-point/questions [{:db/id #edb/ref 17592186106318} {:db/id #edb/ref 17592186106319}] :knowledge-point/title "Finding the Points of Intersection of Two Circles Where One Is Centered at the Origin"} :step/id #uuid "610569f0-3fb8-5605-8fbf-2e5b8dd56936" :step/math-academy-id 19882 :step/next {:db/id #edb/ref 17592186106666}} {:db/id #edb/ref 17592186106665 :step/content {:db/id #edb/ref 17592186105762 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105614 :question/id #uuid "d58288cb-2983-5927-8436-8dbd39d6f67d" :question/math-academy-id "e-5397"} :knowledge-point/id #uuid "64910a32-96b4-59c4-8f61-84e7c532e59d" :knowledge-point/questions [{:db/id #edb/ref 17592186106084} {:db/id #edb/ref 17592186106321}] :knowledge-point/title "Finding the Points of Intersection of a Limaçon and Another Curve"} :step/id #uuid "65cfb1b7-0d03-5d02-ab96-33cf974b1149" :step/math-academy-id 19884} {:db/id #edb/ref 17592186106666 :step/content {:db/id #edb/ref 17592186105763 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105615 :question/id #uuid "716ee2b8-17d2-5754-a09d-cec35808df9d" :question/math-academy-id "e-5399"} :knowledge-point/id #uuid "179ed9f0-7568-5cb0-8f06-626e1e494b62" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049056}] :knowledge-point/questions [{:db/id #edb/ref 17592186106082} {:db/id #edb/ref 17592186106320}] :knowledge-point/title "Finding the Points of Intersection Between a Circle and Another Curve"} :step/id #uuid "b9929453-8491-5cdb-a70a-2a75f105ad3b" :step/math-academy-id 19889 :step/next {:db/id #edb/ref 17592186106665}} {:db/id #edb/ref 17592186106795 :step/content {:db/id #edb/ref 17592186107116 :tutorial/content "It is often more convenient to use polar coordinates to determine the points of intersection of two curves. This is especially true if we are dealing with two circles.\n\nSuppose, for example, that we are given the circles\n\n$$\n{\\color{}r=\\sqrt2\\, {\\sin{\\theta}}}\\,\n$$\n\nand\n\n$$\n\\, {\\color{}r=1}\n$$\n\nas shown in the figure below. How do we determine the polar coordinates of the points of intersection of these two curves?\n\n![](images/82/8225490259dfcf03d505b7f68a486a8246a46b29f6047f1c066d0e9436f8b55f.png)\n\nTo determine the polar coordinates of the intersection points, we must solve the following system of equations for $r$ and $\\theta$:\n\n$$\n{r = \\sqrt{2}\\sin θ; r = 1\n$$\n\nSo, we begin by setting the equations equal to each other and solving for $\\theta$. This gives\n\n$$\n\\begin{aligned}\n\\sqrt{2}\\sin θ &= 1 \\\\\n\\sin θ &= \\frac{1}{\\sqrt{2}} \\\\\n&= \\frac{\\sqrt{2}}{2}\n\\end{aligned}\n$$\n\nSolving this equation in the interval $[0,2\\pi)$, we obtain\n\n$$\n\\theta_1 = \\dfrac{\\pi}{4}, \\qquad \\theta_2 = \\dfrac{3\\pi}{4}\n$$\n\nAlso, notice that $r=1$ at both intersection points. Therefore, the polar coordinates of the points of intersection are\n\n$$\n(r,\\theta)=\\bigg(1, \\dfrac{\\pi}{4}\\bigg)\\qquad \\textrm{and} \\qquad(r,\\theta)=\\bigg(1, \\dfrac{3\\pi}{4}\\bigg)\n$$" :tutorial/id #uuid "5a97510f-ebf2-5d83-a3cb-b3a7143c0849" :tutorial/math-academy-id 4611 :tutorial/title "Introduction"} :step/id #uuid "ea6aa365-5d70-5501-a1ce-4004c0f719fa" :step/math-academy-id 28360 :step/next {:db/id #edb/ref 17592186106663}}] :activity/title "Finding Intersections of Polar Curves" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105953}]}
