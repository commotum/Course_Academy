#{[17592186045463 #edb/ref 10 :activity.type/lesson #edb/ref 17592186045416] [17592186045485 #edb/ref 10 :question.difficulty/easy #edb/ref 17592186045416] [17592186045486 #edb/ref 10 :question.difficulty/hard #edb/ref 17592186045416] [17592186045487 #edb/ref 10 :question.difficulty/moderate #edb/ref 17592186045416] [17592186045493 #edb/ref 10 :answer-field.type/radio #edb/ref 17592186045416] [17592186045498 #edb/ref 10 :answer.type/math #edb/ref 17592186045416] [17592186046668 #edb/ref 1003 #edb/ref 17592186046670 #edb/ref 17592186045417] [17592186046668 #edb/ref 1003 #edb/ref 17592186046671 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046416 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046417 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046418 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046419 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046420 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046421 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046422 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046423 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046424 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046425 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046426 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046427 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046428 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046429 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046430 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046431 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #edb/ref 17592186046432 #edb/ref 17592186045417] [17592186046668 #edb/ref 1004 #e