#{[{:db/id #edb/ref 17592186222023 :knowledge-point/_questions [{:db/id #edb/ref 17592186221445 :knowledge-point/id #uuid "c3315887-ff5c-5fd7-93bd-a58800e378b8" :knowledge-point/title "Computing the Coefficients For the Fourier Series"}] :question/answer-fields [{:answer-field/id #uuid "3fefa1eb-6b94-56ab-91b1-2a7b190c1a7a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220816}] :question/id #uuid "d8c14d18-5531-531f-b86c-3260af1f5733" :question/math-academy-id "q-340855" :question/problem "$f(x)∼\\frac{a_{0}}{2} + ∑_(n = 1)^(∞)a_{n}\\cos (\\frac{nπ}{3}x) + b_{n}\\sin (\\frac{nπ}{3}x)$\nLet $F(x) = 6x + 1$ for $x ∈ [- 3, 3)$. The Fourier series of the $6$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of $b_{5}$.$b_{5} =$ {{field-1}}"}] [{:db/id #edb/ref 17592186372791 :knowledge-point/_questions [{:db/id #edb/ref 17592186221444 :knowledge-point/id #uuid "cb301102-1a82-5a81-bb11-b9fc56cd1dc7" :knowledge-point/title "Computing the Constant Term For the Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b5be5de-ac24-5096-b91d-e0e0ff8e3983" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186372793}] :answer-field/correct {:answer/id #uuid "7b5be5de-ac24-5096-b91d-e0e0ff8e3983" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186372793} :answer-field/id #uuid "3cb42d37-67e0-5792-9f61-4d038363d4ad" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186372792}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7cfbfb37-8e3e-5c3d-8267-64ce726f2c24" :question/math-academy-id "q-341788" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{3}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{3}x)\n$$\n\nLet $F(x)=4{x}^{2}-6x+3$ for $x\\in [-3,3).$ The Fourier series of the $6$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=3$ and $f(x)=4{x}^{2}-6x+3$ for $x\\in [-3,3).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{3}{\\int }_{-3}^{3}(4{x}^{2}-6x+3)\\,\\text{d}x \\\\  & =\\frac{1}{3}{[\\frac{4}{3}{x}^{3}-3{x}^{2}+3x]}_{-3}^{3} \\\\  & =\\frac{1}{3}((\\frac{4}{3}\\cdot {3}^{3}-3\\cdot {3}^{2}+3\\cdot 3)-(\\frac{4}{3}\\cdot (-3)^{3}-3\\cdot (-3)^{2}+3\\cdot (-3))) \\\\  & =\\frac{1}{3}(18-(-72)) \\\\  & =30.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186372797 :knowledge-point/_questions [{:db/id #edb/ref 17592186221444 :knowledge-point/id #uuid "cb301102-1a82-5a81-bb11-b9fc56cd1dc7" :knowledge-point/title "Computing the Constant Term For the Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4377e0c6-ff5d-58c7-b0be-e00480e92ef0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{2}" :db/id #edb/ref 17592186372799}] :answer-field/correct {:answer/id #uuid "4377e0c6-ff5d-58c7-b0be-e00480e92ef0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{2}" :db/id #edb/ref 17592186372799} :answer-field/id #uuid "5b7b647f-bcd2-53cf-8319-b5595a4ddf84" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186372798}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b41ae3b-0d3e-5b1e-a78c-fa1ec34fc5b2" :question/math-academy-id "q-341794" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(2nx)+{b}_{n}\\operatorname{sin}⁡(2nx)\n$$\n\nLet $F(x)=3{x}^{2}+4x$ for $x\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}).$ The Fourier series of the $\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=\\frac{\\pi }{2}$ and $f(x)=3{x}^{2}+4x$ for $x\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}(3{x}^{2}+4x)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[{x}^{3}+2{x}^{2}]}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{2}{\\pi }((\\frac{{\\pi }^{3}}{8}+\\frac{{\\pi }^{2}}{2})-(-\\frac{{\\pi }^{3}}{8}+\\frac{{\\pi }^{2}}{2})) \\\\  & =\\frac{2}{\\pi }(\\frac{{\\pi }^{3}}{4}) \\\\  & =\\frac{{\\pi }^{2}}{2}.\\end{aligned}\n$$"}]}
