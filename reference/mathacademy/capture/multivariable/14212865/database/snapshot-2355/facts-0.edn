/ref 17592186045417] [17592186221473 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186221473 #edb/ref 1045 "Fourier Series of Arbitrary Period" #edb/ref 17592186045417] [17592186221473 #edb/ref 1046 #edb/ref 17592186222376 #edb/ref 17592186045417] [17592186221473 #edb/ref 1049 #edb/ref 17592186048443 #edb/ref 17592186045417] [17592186221473 #edb/ref 1050 1260.0 #edb/ref 17592186045417] [17592186221473 #edb/ref 1053 #uuid "80e6356e-9b75-58b6-9da9-f8c9047c131d" #edb/ref 17592186045417] [17592186222023 #edb/ref 1068 #edb/ref 17592186220816 #edb/ref 17592186045417] [17592186222023 #edb/ref 1069 "q-340855" #edb/ref 17592186045417] [17592186222023 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186222023 #edb/ref 1071 "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{3}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{3}x)\n$$\n\nLet $F(x)=6x+1$ for $x\\in [-3,3).$ The Fourier series of the $6$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${b}_{5}.$\n\n${b}_{5}=$ {{field-1}}" #edb/ref 17592186045417] [17592186222023 #edb/ref 1072 #uuid "d8c14d18-5531-531f-b86c-3260af1f5733" #edb/ref 17592186045417] [17592186222023 #edb/ref 1074 "For the Fourier series of a $2L$-periodic function, the sine coefficients are given by\n\n$$\n{b}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=3$ and $f(x)=6x+1$ for $x\\in (-3,3).$ So, substituting into the formula, we get\n\n$$\n{b}_{5}=\\frac{1}{3}{\\int }_{-3}^{3}(6x+1)\\operatorname{sin}⁡(\\frac{5\\pi }{3}x)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=6x+1\\, & ⇒\\,{u}^{′}=6 \\\\ {v}^{′}=\\operatorname{sin}⁡(\\frac{5\\pi }{3}x)\\, & ⇒\\,v=-\\frac{3}{5\\pi }\\operatorname{cos}⁡(\\frac{5\\pi }{3}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{5} & =\\frac{1}{3}(uv\\,{|}_{-3}^{3}-{\\int }_{-3}^{3}v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{3}(-\\frac{3}{5\\pi }{[(6x+1)\\operatorname{cos}⁡(\\frac{5\\pi }{3}x)]}_{-3}^{3}+\\frac{18}{5\\pi }{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(\\frac{5\\pi }{3}x)\\,\\text{d}x) \\\\  & =\\frac{1}{5\\pi }(-{[(6x+1)\\operatorname{cos}⁡(\\frac{5\\pi }{3}x)]}_{-3}^{3}+6{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(\\frac{5\\pi }{3}x)\\,\\text{d}x) \\\\  & =\\frac{1}{5\\pi }(-((6(3)+1)\\operatorname{cos}⁡(5\\pi )-(6(-3)+1)\\operatorname{cos}⁡(-5\\pi ))+\\frac{18}{5\\pi }{[\\operatorname{sin}⁡(\\frac{5\\pi }{3}x)]}_{-3}^{3}) \\\\  & =\\frac{1}{5\\pi }(36+\\frac{18}{5\\pi }(\\operatorname{sin}⁡(5\\pi )-\\operatorname{sin}⁡(-5\\pi ))) \\\\  & =\\frac{1}{5\\pi }\\cdot 36 \\\\  & =\\frac{36}{5\\pi }.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186222376 #edb/ref 1058 #edb/ref 17592186222377 #edb/ref 17592186045417] [17592186222376 #edb/ref 1061 601031 #edb/ref 17592186045417] [17592186222376 #edb/ref 1062 #uuid "0045b15e-7a1f-5142-94c5-082ec814b34d" #edb/ref 17592186045417] [17592186222376 #edb/ref 1063 #edb/ref 17592186222514 #edb/ref 17592186045417] [17592186222377 #edb/ref 1058 #edb/ref 17592186222378 #edb/ref 17592186045417] [17592186222377 #edb/ref 1061 601032 #edb/ref 17592186045417] [17592186222377 #edb/ref 1062 #uuid "0b4fe87b-2102-5820-bc57-996b33b5332d" #edb/ref 17592186045417] [17592186222377 #edb/ref 1063 #edb/ref 17592186221443 #edb/ref 17592186045417] [17592186222378 #edb/ref 1058 #edb/ref 17592186222379 #edb/ref 17592186045417] [17592186222378 #edb/ref 1061 601035 #edb/ref 17592186045417] [17592186222378 #edb/ref 1062 #uuid "c1a6a016-3b6c-50d2-9290-1aa451df4a51" #edb/ref 17592186045417] [17592186222378 #edb/ref 1063 #edb/ref 17592186221444 #edb/ref 17592186045417] [17592186222379 #edb/ref 1061 601038 #edb/ref 17592186045417] [17592186222379 #edb/ref 1062 #uuid "b7ee00e8-fdc1-5440-bb38-f920d76832a4" #edb/ref 17592186045417] [17592186222379 #edb/ref 1063 #edb/ref 17592186221445 #edb/ref 17592186045417] [17592186222514 #edb/ref 1064 "When a function has period $2L$ (instead of $2\\pi$), the \"usual\" Fourier formulas still work, but the sine and cosine inputs must be rescaled so that each term completes an integer number of oscillations over one period. \n\nWe do this by converting the $2L$-periodic function into a $2\\pi$-periodic one using a change of variables.\n\nLet $f(x)$ be the $2L$-periodic extension of a function $F(x)$ from $x\\in[-L,L)$ to $x\\in\\mathbb{R}$.\nTo use the standard $2\\pi$-period Fourier formulas, define\n\n$$\ns=\\frac{\\pi}{L}x\n\\qquad\\text{and}\\qquad\ng(s)=f\\!\\left(\\frac{L}{\\pi}s\\right).\n$$\n\nThen $g$ is $2\\pi$-periodic.\n\nFor a $2\\pi$-periodic function $g$, the Fourier series is\n\n$$\ng(s)\\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}\\bigl(a_n\\cos(ns)+b_n\\sin(ns)\\bigr),\n$$\n\nwhere\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\,ds, \\\\ {a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(ns)\\,ds,\\,n\\ge 1, \\\\ {b}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{sin}⁡(ns)\\,ds,\\,n\\ge 1.\\end{aligned}\n$$\n\nNow substitute $g(s)=f\\!\\left(\\dfrac{L}{\\pi}s\\right)$ and $s=\\dfrac{\\pi}{L}x$.\nFirst, for $a_n{:}$\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(ns)\\,ds \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f\\,(\\frac{L}{\\pi }s)\\operatorname{cos}⁡(ns)\\,ds \\\\  & =\\frac{1}{\\pi }{\\int }_{-L}^{L}f\\,(\\frac{L}{\\pi }\\cdot \\frac{\\pi }{L}x)cos\\,(n\\cdot \\frac{\\pi }{L}x)\\,d\\,(\\frac{\\pi }{L}x) \\\\  & =\\frac{1}{\\pi }\\cdot \\frac{\\pi }{L}{\\int }_{-L}^{L}f(x)cos\\,(\\frac{n\\pi }{L}x)\\,dx \\\\  & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)cos\\,(\\frac{n\\pi }{L}x)\\,dx\\end{aligned}\n$$\n\nCoefficients $b_n$ (for $n \\geq 1$) and $a_0$ can be found similarly.\n\nTo summarize, the Fourier series of $f$ is\n\n$$\nf(x)\\sim \\frac{a_0}{2}+\\sum_{n=1}^{\\infty}\\left(a_n\\cos\\!\\left(\\frac{n\\pi}{L}x\\right)+b_n\\sin\\!\\left(\\frac{n\\pi}{L}x\\right)\\right),\n$$\n\nwhere the coefficients are the following:\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,dx \\\\ {a}_{n} & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)cos\\,(\\frac{n\\pi }{L}x)\\,dx,\\,n\\ge 1 \\\\ {b}_{n} & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)sin\\,(\\frac{n\\pi }{L}x)\\,dx,\\,n\\ge 1\\end{aligned}\n$$\n\nNext, let's see some concrete examples." #edb/ref 17592186045417] [17592186222514 #edb/ref 1065 14681 #edb/ref 17592186045417] [17592186222514 #edb/ref 1066 #uuid "5bb98db0-8e34-5cf2-8911-56a6971740ab" #edb/ref 17592186045417] [17592186222514 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186372791 #edb/ref 1068 #edb/ref 17592186372792 #edb/ref 17592186045417] [17592186372791 #edb/ref 1069 "q-341788" #edb/ref 17592186045417] [17592186372791 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186372791 #edb/ref 1071 "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{3}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{3}x)\n$$\n\nLet $F(x)=4{x}^{2}-6x+3$ for $x\\in [-3,3).$ The Fourier series of the $6$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" #edb/ref 17592186045417] [17592186372791 #edb/ref 1072 #uuid "7cfbfb37-8e3e-5c3d-8267-64ce726f2c24" #edb/ref 17592186045417] [17592186372791 #edb/ref 1074 "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=3$ and $f(x)=4{x}^{2}-6x+3$ for $x\\in [-3,3).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{3}{\\int }_{-3}^{3}(4{x}^{2}-6x+3)\\,\\text{d}x \\\\  & =\\frac{1}{3}{[\\frac{4}{3}{x}^{3}-3{x}^{2}+3x]}_{-3}^{3} \\\\  & =\\frac{1}{3}((\\frac{4}{3}\\cdot {3}^{3}-3\\cdot {3}^{2}+3\\cdot 3)-(\\frac{4}{3}\\cdot (-3)^{3}-3\\cdot (-3)^{2}+3\\cdot (-3))) \\\\  & =\\frac{1}{3}(18-(-72)) \\\\  & =30.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186372792 #edb/ref 1075 #edb/ref 17592186372793 #edb/ref 17592186045417] [17592186372792 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186372792 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186372792 #edb/ref 1078 #edb/ref 17592186372793 #edb/ref 17592186045417] [17592186372792 #edb/ref 1079 #uuid "3cb42d37-67e0-5792-9f61-4d038363d4ad" #edb/ref 17592186045417] [17592186372793 #edb/ref 1080 "30" #edb/ref 17592186045417] [17592186372793 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186372793 #edb/ref 1083 #uuid "7b5be5de-ac24-5096-b91d-e0e0ff8e3983" #edb/ref 17592186045417] [17592186372797 #edb/ref 1068 #edb/ref 17592186372798 #edb/ref 17592186045417] [17592186372797 #edb/ref 1069 "q-341794" #edb/ref 17592186045417] [17592186372797 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186372797 #edb/ref 1071 "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(2nx)+{b}_{n}\\operatorname{sin}⁡(2nx)\n$$\n\nLet $F(x)=3{x}^{2}+4x$ for $x\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}).$ The Fourier series of the $\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" #edb/ref 17592186045417] [17592186372797 #edb/ref 1072 #uuid "0b41ae3b-0d3e-5b1e-a78c-fa1ec34fc5b2" #edb/ref 17592186045417] [17592186372797 #edb/ref 1074 "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=\\frac{\\pi }{2}$ and $f(x)=3{x}^{2}+4x$ for $x\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}(3{x}^{2}+4x)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[{x}^{3}+2{x}^{2}]}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{2}{\\pi }((\\frac{{\\pi }^{3