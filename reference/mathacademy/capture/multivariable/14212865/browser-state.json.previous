>x</mi><mn>3</mn></msup><mo>+</mo><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mrow></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mi>π</mi></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>π</mi><mn>3</mn></msup><mn>8</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>π</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>π</mi><mn>3</mn></msup><mn>8</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>π</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mi>π</mi></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>π</mi><mn>3</mn></msup><mn>4</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>π</mi><mn>2</mn></msup><mn>2</mn></mfrac><