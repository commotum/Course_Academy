 {:db/id #edb/ref 17592186560005} {:db/id #edb/ref 17592186560007} {:db/id #edb/ref 17592186560017} {:db/id #edb/ref 17592186560020} {:db/id #edb/ref 17592186560021} {:db/id #edb/ref 17592186560028} {:db/id #edb/ref 17592186560038} {:db/id #edb/ref 17592186560045}] :knowledge-point/title "Evaluating Surface Integrals Using Polar Coordinates"} :step/id #uuid "4324e02b-29a0-51f1-961f-3fecc2a25950" :step/math-academy-id 44421} {:db/id #edb/ref 17592186106889 :step/content {:db/id #edb/ref 17592186105889 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105459 :question/id #uuid "02451ec6-38a3-5cfc-adfb-912b91fab9dc" :question/math-academy-id "e-12382"} :knowledge-point/id #uuid "8885504f-07fb-5308-a982-608d7baa262b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050508} {:db/id #edb/ref 17592186050816}] :knowledge-point/question-generator {:db/id #edb/ref 17592186530737} :knowledge-point/questions [{:db/id #edb/ref 17592186106060} {:db/id #edb/ref 17592186106063} {:db/id #edb/ref 17592186278478} {:db/id #edb/ref 17592186278479} {:db/id #edb/ref 17592186278481} {:db/id #edb/ref 17592186401226} {:db/id #edb/ref 17592186401233} {:db/id #edb/ref 17592186415979} {:db/id #edb/ref 17592186530671} {:db/id #edb/ref 17592186530672} {:db/id #edb/ref 17592186530674} {:db/id #edb/ref 17592186530682} {:db/id #edb/ref 17592186530695} {:db/id #edb/ref 17592186530699} {:db/id #edb/ref 17592186530714} {:db/id #edb/ref 17592186530725} {:db/id #edb/ref 17592186530730} {:db/id #edb/ref 17592186530731} {:db/id #edb/ref 17592186530732} {:db/id #edb/ref 17592186535084}] :knowledge-point/title "Express Surface Integrals as Repeated Integrals"} :step/id #uuid "edfeb55c-dcca-540f-9b5b-f35820d75f59" :step/math-academy-id 44429 :step/next {:db/id #edb/ref 17592186106887}}] :activity/title "Surface Integrals Over Cartesian Surfaces" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186105951}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186545934} :activity/id #uuid "a7e447dc-efe8-5990-94ca-1d71d0aed212" :activity/scope {:db/id #edb/ref 17592186049883 :topic/id #uuid "1adf18d4-239e-50f8-b7e4-88f56c72baad" :topic/math-academy-id 1264} :activity/steps [{:db/id #edb/ref 17592186545934 :step/content {:db/id #edb/ref 17592186278475 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05c6bd5e-0a05-54b2-8760-1af815a21d72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186275528} {:answer/id #uuid "67245e6c-b985-5f9e-a895-775b667aacaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186276399} {:answer/id #uuid "77e3d978-da8c-5d68-b60a-4a8194925e3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186276562} {:answer/id #uuid "78ac9cfc-a243-510f-9152-b7aa90fe5547" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186276571} {:answer/id #uuid "d19e77ba-76c5-54e5-8b35-467bdaf0f222" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186277329}] :answer-field/correct {:db/id #edb/ref 17592186275528} :answer-field/id #uuid "455d1d44-da82-5aaf-86ed-4b3d398efe8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186277834}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "cc8526c3-3b66-50ba-a72f-6803fda09a5e" :question/math-academy-id "q-161311" :question/problem "![](images/5b/5ba2dbc746b9fe8b36202d31bbeb8193ffb9e747d6ed4c2e2f0f994499f88e8e.png)\n\nEvaluate the surface integral \n\n$$\n{∬}_{S}\\frac{x}{{x}^{2}+{y}^{2}}\\,\\text{d}S,\n$$\n\nwhere $S$ is defined by $z=-x+\\sqrt{2}y$ and whose domain is the quarter-circle of radius $3$ centered at $O$ in the second quadrant, as shown above." :question/worked-solution "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(-x+\\sqrt{2}y)=-1,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(-x+\\sqrt{2}y)=\\sqrt{2}.\n$$\n\nTherefore, the surface integral can be expressed as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\frac{x}{{x}^{2}+{y}^{2}}\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{x}{{x}^{2}+{y}^{2}}\\cdot \\sqrt{1+(-1)^{2}+(\\sqrt{2})^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{x}{{x}^{2}+{y}^{2}}\\cdot \\sqrt{4}\\,\\text{d}A \\\\  & =2{∬}_{D}\\,\\frac{x}{{x}^{2}+{y}^{2}}\\,\\text{d}A.\\end{aligned}\n$$\n\nNotice that in polar coordinates $(r,\\theta ),$ our domain can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 3,\\,\\frac{\\pi }{2}\\le \\theta \\le \\pi \\}.\n$$\n\nTherefore, using the change of variables formula for polar coordinates, where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we obtain \n\n$$\n\\begin{aligned}2{∬}_{D}\\,\\frac{x}{{x}^{2}+{y}^{2}}\\,\\text{d}A & =2{∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta  \\\\  & =2{∬}_{Δ}\\frac{r\\operatorname{cos}⁡\\theta }{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta }\\cdot r\\text{ }\\text{d}r\\text{d}\\theta  \\\\  & =2{∬}_{Δ}\\frac{{r}^{2}\\operatorname{cos}⁡\\theta }{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}\\,\\text{d}r\\text{d}\\theta  \\\\  & =2{∬}_{Δ}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{3}{\\int }_{\\pi /2}^{\\pi }\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta \\,\\text{d}r \\\\  & =2{\\int }_{0}^{3}{[\\,\\operatorname{sin}⁡\\theta \\,\\,]}_{\\pi /2}^{\\pi }\\,\\text{d}r \\\\  & =2{\\int }_{0}^{3}(-1)\\,\\text{d}r \\\\  & =2\\cdot (-1)\\cdot 3 \\\\  & =-6.\\end{aligned}\n$$"} :step/id #uuid "64217169-0cc8-5c96-92a7-60e0327f3a58" :step/next {:db/id #edb/ref 17592186545982}} {:db/id #edb/ref 17592186545941 :step/content {:db/id #edb/ref 17592186278488 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58c92c9f-f7b2-5087-b5cb-9c823dd91103" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}-1" :db/id #edb/ref 17592186276275} {:answer/id #uuid "71e45d75-8e8d-5b51-9bc8-9a9063a27f9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186276506} {:answer/id #uuid "7547c285-1634-5801-b577-f69f0bcd9c1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186276540} {:answer/id #uuid "c5f4f348-c70a-58b1-b1c6-5b7181818124" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186277239} {:answer/id #uuid "c82c5022-5c05-5a6e-8240-b77817d39cb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}-1" :db/id #edb/ref 17592186277257}] :answer-field/correct {:db/id #edb/ref 17592186276506} :answer-field/id #uuid "4d30624d-c8e2-5de7-a21a-9e4e44de6e77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186277849}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b54f01b4-5da4-54d3-8529-0362ccff055b" :question/math-academy-id "q-161341" :question/problem "Evaluate the surface integral \n\n$$\n{∬}_{S}4z\\,\\text{d}S\n$$\n\nwhere $S$ is defined by $z=x+y$ for $0\\le x\\le 1$ and $0\\le y\\le 1.$" :question/worked-solution "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(x+y)=1,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(x+y)=1.\n$$\n\nTherefore, the surface integral can be evaluated as follows:\n\n$$\n\\begin{aligned}{∬}_{S}4z\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,4(x+y)\\,\\sqrt{1+{1}^{2}+{1}^{2}}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}4(x+y)\\sqrt{3}\\,\\text{d}y\\,\\text{d}x \\\\  & =\\sqrt{3}{\\int }_{0}^{1}{[4xy+2{y}^{2}]}_{y=0}^{y=1}\\,\\text{d}x \\\\  & =\\sqrt{3}{\\int }_{0}^{1}(4x+2)\\,\\text{d}x \\\\  & =\\sqrt{3}{[2{x}^{2}+2x]}_{0}^{1} \\\\  & =4\\sqrt{3}\\end{aligned}\n$$"} :step/id #uuid "6efb6b15-91ab-572a-9dfc-ab077408f2c0" :step/next {:db/id #edb/ref 17592186546005}} {:db/id #edb/ref 17592186545942 :step/content {:db/id #edb/ref 17592186106064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "181d1c26-e67d-51c2-a26a-430f785d6acb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186275701} {:answer/id #uuid "28969ccb-d093-57d3-b212-4874bada94e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186275844} {:answer/id #uuid "2ba05209-d34b-5868-9786-58e2ff4e93bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186275874} {:answer/id #uuid "cf2683e3-eb37-586e-9160-3302e36bbab0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186277310} {:answer/id #uuid "e45df712-ce3b-5b93-9b2c-9398a0154cf8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\sqrt{3}}{2}" :db/id #edb/ref 17592186277472}] :answer-field/correct {:db/id #edb/ref 17592186275701} :answer-field/id #uuid "ca7cbc3f-0579-5978-bcda-87ea12ce82c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186278081}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1a32ff2f-f5fc-57a4-9ce0-9a59d7c231d3" :question/math-academy-id "q-161355" :question/problem "Evaluate the surface integral \n\n$$\n{∬}_{S}\\frac{z}{\\sqrt{1+2{cos}^{2}⁡(x+y)}}\\,\\text{d}S\n$$\n\nwhere $S$ is defined by $z=\\operatorname{sin}⁡(x+y)$ for $0\\le x\\le \\pi $ and $-x\\le y\\le x.$" :question/worked-solution "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}\\operatorname{sin}⁡(x+y)=\\operatorname{cos}⁡(x+y),\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}\\operatorname{sin}⁡(x+y)=\\operatorname{cos}⁡(x+y).\n$$\n\nTherefore, the surface integral can be evaluated as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\frac{z}{\\sqrt{1+2{cos}^{2}⁡(x+y)}}\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,\\frac{\\operatorname{sin}⁡(x+y)}{\\sqrt{1+2{cos}^{2}⁡(x+y)}}\\sqrt{1+2(\\operatorname{cos}⁡(x+y))^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,\\frac{\\operatorname{sin}⁡(x+y)}{\\cancel{\\sqrt{1+2{cos}^{2}⁡(x+y)}}}\\cancel{\\sqrt{1+2(\\operatorname{cos}⁡(x+y))^{2}}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,\\operatorname{sin}⁡(x+y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{-x}^{x}\\operatorname{sin}⁡(x+y)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi }[-\\operatorname{cos}⁡(x+y)]_{y=-x}^{y=x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡(2x))\\,\\text{d}x \\\\  & ={[x-\\frac{\\operatorname{sin}⁡(2x)}{2}]}_{0}^{\\pi } \\\\  & =\\pi \\end{aligned}\n$$"} :step/id #uuid "6ffb9c84-ee99-5da3-ab01-c527c118e32a"} {:db/id #edb/ref 17592186545982 :step/content {:db/id #edb/ref 17592186278486 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1117310d-a59f-5c9e-afac-07ea4e950362" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186275629} {:answer/id #uuid "632694f6-bc89-55a5-9c76-587db4efb69f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186276376} {:answer/id #uuid "71b9ff33-9fa7-56e6-aa27-7e58aa28fdea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186276503} {:answer/id #uuid "c5f23306-38b6-5585-95c9-674db2d3737e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186277238} {:answer/id #uuid "e6be6744-6027-57b8-8e56-b5d3f941e930" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186277492}] :answer-field/correct {:db/id #edb/ref 17592186275629} :answer-field/id #uuid "d3963dbe-4605-5d7a-9bdb-2239345ae704" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186278095}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e935e93c-c375-5e87-b42b-951f2a795ef1" :question/math-academy-id "q-161339" :question/problem "![](images/d1/d19d54d0e76ced24d1bd9f865578b72f2b8d67414c8506499c6ae7b1300a6275.png)\n\nEvaluate the surface integral \n\n$$\n{∬}_{S}(x+y)\\,\\text{d}S,\n$$\n\nwhere $S$ is defined by $z=-2x+2y$ and whose domain is the left half-circle of radius $1$ centered at $O$, as shown above." :question/worked-solution "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(-2x+2y)=-2,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(-2x+2y)=2.\n$$\n\n \n\nTherefore, the surface integral can be expressed as follows:\n\n$$\n\\begin{aligned}{∬}_{S}(x+y)\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}(x+y)\\cdot \\sqrt{1+(-2)^{2}+{2}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}(x+y)\\cdot \\sqrt{9}\\,\\text{d}A \\\\  & =3{∬}_{D}\\,(x+y)\\,\\text{d}A.\\end{aligned}\n$$\n\nNotice that in polar coordinates $(r,\\theta ),$ our domain can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 1,\\,\\frac{\\pi }{2}\\le \\theta \\le \\frac{3\\pi }{2}\\}.\n$$\n\nTherefore, using the change of variables formula for polar coordinates, where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we obtain \n\n$$\n\\begin{aligned}3{∬}_{D}\\,(x+y)\\,\\text{d}A & =3{∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta  \\\\  & =3{∬}_{Δ}(r\\operatorname{cos}⁡\\theta +r\\operatorname{sin}⁡\\theta )\\cdot r\\,\\text{d}r\\text{d}\\theta  \\\\  & =3{∬}_{Δ}{r}^{2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\text{d}\\theta  \\\\  & =3{\\int }_{\\pi /2}^{3\\pi /2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ){\\int }_{0}^{1}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =3{\\int }_{\\pi /2}^{3\\pi /2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ){[\\frac{{r}^{3}}{3}]}_{0}^{1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =[\\,\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ]_{\\pi /2}^{3\\pi /2} \\\\  & =-2.\\end{aligned}\n$$"} :step/id #uuid "c6dc5e58-d1a8-5fb6-8b34-42dd7fce411d" :step/next {:db/id #edb/ref 17592186545941}} {:db/id #edb/ref 17592186546005 :step/content {:db/id #edb/ref 17592186415981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20eaebd4-47b4-5a06-b816-cc531888309e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{121}{3}\\sqrt{26}" :db/id #edb/ref 17592186415951} {:answer/id #uuid "3829b03c-0d7f-5b85-969e-c475546e2d9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{395}{3}" :db/id #edb/ref 17592186415955} {:answer/id #uuid "6a510a5b-13c1-5f24-b8c2-ff019d89d2c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186415957} {:answer/id #uuid "ae2d7ec7-e4c0-578d-84f7-8e6cf8e46b7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{3}\\sqrt{26}" :db/id #edb/ref 17592186415966} {:answer/id #uuid "b2c0bc18-5385-5a20-91df-0c00a7144747" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{79}{3}\\sqrt{26}" :db/id #edb/ref 17592186415967}] :answer-field/correct {:db/id #edb/ref 17592186415967} :answer-field/id #uuid "0d471815-2895-5fb8-bed5-64d74c7a07a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415973}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4f6d27cd-0aea-5d32-8f1f-4a62535f9e3b" :question/math-academy-id "q-161351" :question/problem "Evaluate the surface integral \n\n$$\n{∬}_{S}(24xy+{z}^{2})\\,\\text{d}S\n$$\n\nwhere $S$ is defined by $z=3x-4y$ for $1\\le x\\le 2$ and $0\\le y\\le 1.$" :question/worked-solution "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(3x-4y)=3,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(3x-4y)=-4.\n$$\n\nTherefore, the surface integral can be evaluated as follows:\n\n$$\n\\begin{aligned}{∬}_{S}(24xy+{z}^{2})\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,(24xy+(3x-4y)^{2})\\sqrt{1+{3}^{2}+(-4)^{2}}\\,\\text{d}A \\\\  & =\\sqrt{26}{∬}_{D}\\,(24xy+9{x}^{2}+16{y}^{2}-24xy)\\,\\text{d}A \\\\  & =\\sqrt{26}{∬}_{D}\\,(9{x}^{2}+16{y}^{2})\\,\\text{d}A \\\\  & =\\sqrt{26}{\\int }_{1}^{2}{\\int }_{0}^{1}(9{x}^{2}+16{y}^{2})\\,\\text{d}y\\,\\text{d}x \\\\  & =\\sqrt{26}{\\int }_{1}^{2}{[9{x}^{2}y+\\frac{16}{3}{y}^{3}]}_{y=0}^{y=1}\\,\\text{d}x \\\\  & =\\sqrt{26}{\\int }_{1}^{2}(9{x}^{2}+\\frac{16}{3})\\,\\text{d}x \\\\  & =\\sqrt{26}{[3{x}^{3}+\\frac{16}{3}x]}_{1}^{2} \\\\  & =\\sqrt{26}(24+\\frac{32}{3}-3-\\frac{16}{3}) \\\\  & =\\frac{79}{3}\\sqrt{26}\\end{aligned}\n$$"} :step/id #uuid "e699603d-7b06-57fa-a1ac-56875ac67a88" :step/next {:db/id #edb/ref 17592186545942}}] :activity/title "Surface Integrals Over Cartesian Surfaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186545192}]}
