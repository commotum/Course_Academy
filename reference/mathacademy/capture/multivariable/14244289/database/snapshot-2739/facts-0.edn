} + 2 x y + 2 y^{2})=- 2 x + 2 y,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(- x^{2} + 2 x y + 2 y^{2})=2 x + 4 y.\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+(- 2 x + 2 y)^2+(2 x + 4 y)^2}\\,\\text{d}A \\\\  & ={∬}_{D}\\,(2 x (- x^{2} + 2 x y + 2 y^{2})^{2} + 2 y (- x^{2} + 2 x y + 2 y^{2}))\\cdot (\\sqrt{(- 2 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={∬}_{D}\\,(2 x^{5} - 8 x^{4} y + 16 x^{2} y^{3} - 2 x^{2} y + 8 x y^{4} + 4 x y^{2} + 4 y^{3})\\cdot (\\sqrt{(- 2 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={\\int }_{-2}^{-1}{\\int }_{0}^{2}\\,\\sqrt{(- 2 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1} (2 x^{5} - 8 x^{4} y + 16 x^{2} y^{3} - 2 x^{2} y + 8 x y^{4} + 4 x y^{2} + 4 y^{3})\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186530674 #edb/ref 1068 #edb/ref 17592186530698 #edb/ref 17592186045443] [17592186530674 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045443] [17592186530674 #edb/ref 1071 "Consider the surface integral of the function $f(x,y,z)=- x z + y z^{2},$ where the surface $S$ is defined by $z=- 2 x^{2} + 2 x y + 2 y^{2}$ for $0\\le x\\le 1$ and $0\\le y\\le 1.$\nThis surface integral can be written as a repeated integral, as shown below. \n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={\\int }_{0}^{1}{\\int }_{0}^{1}\\,\\boxed{}\\,\\,\\text{d}y\\,\\text{d}x\n$$\n\nWhat is the missing expression?" #edb/ref 17592186045443] [17592186530674 #edb/ref 1072 #uuid "3c29642f-a472-5c91-80fe-7e7c9769bea9" #edb/ref 17592186045443] [17592186530674 #edb/ref 1074 "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(- 2 x^{2} + 2 x y + 2 y^{2})=- 4 x + 2 y,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(- 2 x^{2} + 2 x y + 2 y^{2})=2 x + 4 y.\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+(- 4 x + 2 y)^2+(2 x + 4 y)^2}\\,\\text{d}A \\\\  & ={∬}_{D}\\,(- x (- 2 x^{2} + 2 x y + 2 y^{2}) + y (- 2 x^{2} + 2 x y + 2 y^{2})^{2})\\cdot (\\sqrt{(- 4 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={∬}_{D}\\,(4 x^{4} y - 8 x^{3} y^{2} + 2 x^{3} - 4 x^{2} y^{3} - 2 x^{2} y + 8 x y^{4} - 2 x y^{2} + 4 y^{5})\\cdot (\\sqrt{(- 4 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1})\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}\\,\\sqrt{(- 4 x + 2 y)^{2} + (2 x + 4 y)^{2} + 1} (4 x^{4} y - 8 x^{3} y^{2} + 2 x^{3} - 4 x^{2} y^{3} - 2 x^{2} y + 8 x y^{4} - 2 x y^{2} + 4 y^{5})\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186530682 #edb/ref 1068 #edb/ref 17592186530736 #edb/ref 17592186045443] [17592186530682 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045443] [17592186530682 #edb/ref 1071 "Consider the surface integral of the function $f(x,y,z)=- 2 x z,$ where the surface $S$ is defined by $z=2 x^{2} + x y + 2 y^{2}$ for $-2\\le x\\le -1$ and $0\\le y\\le 1.$\nThis surface integral can be written as a repeated integral, as shown below. \n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={\\int }_{-2}^{-1}{\\int }_{0}^{1}\\,\\boxed{}\\,\\,\\text{d}y\\,\\text{d}x\n$$\n\nWhat is the missing expression?" #edb/ref 17592186045443] [17592186530682 #edb/ref 1072 #uuid "56f59bc8-cc0f-5350-80f2-c0de11dad7ea" #edb/ref 17592186045443] [17592186530682 #edb/ref 1074 "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\