}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}({x}_{1}+{x}_{2}^{2})=1,\\, & \\frac{∂{f}_{1}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}({x}_{1}+{x}_{2}^{2})=2{x}_{2} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}(\\operatorname{sin}⁡({x}_{1}+{x}_{2}))=\\operatorname{cos}⁡({x}_{1}+{x}_{2}),\\, & \\frac{∂{f}_{2}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}(\\operatorname{sin}⁡({x}_{1}+{x}_{2}))=\\operatorname{cos}⁡({x}_{1}+{x}_{2})\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}1 & 2{x}_{2} \\\\ \\operatorname{cos}⁡({x}_{1}+{x}_{2}) & \\operatorname{cos}⁡({x}_{1}+{x}_{2})\\end{aligned}].\n$$\n\nEvaluating $f$ and its derivative at $x=a=[\\begin{aligned}\\frac{\\pi }{2} \\\\ \\frac{\\pi }{2}\\end{aligned}],$ we have\n\n$$\nf(a)=[\\begin{aligned}\\frac{\\pi }{2}+\\frac{{\\pi }^{2}}{4} \\\\ 0\\end{aligned}],\\,{f}^{′}(a)=[\\begin{aligned}1 & \\pi  \\\\ -1 & -1\\end{aligned}].\n$$\n\nThe linear approximation of $f$ at $x=a$ is given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nf(x)≈[\\begin{aligned}\\frac{\\pi }{2}+\\frac{{\\pi }^{2}}{4} \\\\ 0\\end{aligned}]+[\\begin{aligned}1 & \\pi  \\\\ -1 & -1\\end{aligned}](x-[\\begin{aligned}\\frac{\\pi }{2} \\\\ \\frac{\\pi }{2}\\end{aligned}]).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n0+\\pi +(-1)=\\pi -1.\n$$" #edb/ref 17592186045417] [17592186367798 #edb/ref 1075 #edb/ref 17592186367799 #edb/ref 17592186045417] [17592186367798 #edb/ref 1075 #edb/ref 17592186367800 #edb/ref 17592186045417] [17592186367798 #edb/ref 1075 #edb/ref 17592186367801 #edb/ref 17592186045417] [17592186367798 #edb/ref 1075 #edb/ref 17592186367802 #edb/ref 17592186045417] [17592186367798 #edb/ref 1075 #edb/ref 17592186367803 #edb/ref 17592186045417] [17592186367798 #edb/ref 1076