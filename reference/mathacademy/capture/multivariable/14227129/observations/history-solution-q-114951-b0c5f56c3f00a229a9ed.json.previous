CLOSE\">)</mo></mrow><mo>−</mo><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>8</mn><msup><mi>ln</mi><mn>7</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow></mrow><mi>x</mi></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mi>ln</mi><mn>9</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow><mo>−</mo><mn>8</mn><mo data-mjx-texclass=\"OP\">∫</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msup><mi>ln</mi><mn>8</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow></mrow><mi>x</mi></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mi>ln</mi><mn>9</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow><mo>−</mo><mn>8</mn><mi>I</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Finally, we solve for <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"12\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D43C TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.