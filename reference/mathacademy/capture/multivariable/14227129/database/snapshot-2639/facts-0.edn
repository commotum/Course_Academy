 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248709 #edb/ref 1083 #uuid "90961f5a-dd57-5f40-8e5f-e2727bb2f67d" #edb/ref 17592186045417] [17592186248844 #edb/ref 1080 "\\frac{{ln}^{3}⁡x}{4}+C" #edb/ref 17592186045417] [17592186248844 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248844 #edb/ref 1083 #uuid "9f6e5a27-6ad8-5b1a-b327-7847f10b1222" #edb/ref 17592186045417] [17592186249260 #edb/ref 1080 "-\\frac{\\operatorname{ln}⁡x}{3}+C" #edb/ref 17592186045417] [17592186249260 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186249260 #edb/ref 1083 #uuid "cefcf51a-b70a-5c3a-a3be-b1a5d98e9adb" #edb/ref 17592186045417] [17592186249409 #edb/ref 1080 "\\frac{{e}^{-3x}}{10}(\\operatorname{sin}⁡x-3\\operatorname{cos}⁡x)+C" #edb/ref 17592186045417] [17592186249409 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186249409 #edb/ref 1083 #uuid "e0365e69-99c7-506d-a0be-882ad819a4e2" #edb/ref 17592186045417] [17592186249843 #edb/ref 1075 #edb/ref 17592186247725 #edb/ref 17592186045417] [17592186249843 #edb/ref 1075 #edb/ref 17592186247943 #edb/ref 17592186045417] [17592186249843 #edb/ref 1075 #edb/ref 17592186248576 #edb/ref 17592186045417] [17592186249843 #edb/ref 1075 #edb/ref 17592186248844 #edb/ref 17592186045417] [17592186249843 #edb/ref 1075 #edb/ref 17592186249260 #edb/ref 17592186045417] [17592186249843 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186249843 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186249843 #edb/ref 1078 #edb/ref 17592186248576 #edb/ref 17592186045417] [17592186249843 #edb/ref 1079 #uuid "6117be46-83ef-580f-84ce-56c76fa2d084" #edb/ref 17592186045417] [17592186250023 #edb/ref 1075 #edb/ref 17592186247925 #edb/ref 17592186045417] [17592186250023 #edb/ref 1075 #edb/ref 17592186248063 #edb/ref 17592186045417] [17592186250023 #edb/ref 1075 #edb/ref 17592186248203 #edb/ref 17592186045417] [17592186250023 #edb/ref 1075 #edb/ref 17592186248709 #edb/ref 17592186045417] [17592186250023 #edb/ref 1075 #edb/ref 17592186249409 #edb/ref 17592186045417] [17592186250023 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186250023 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186250023 #edb/ref 1078 #edb/ref 17592186249409 #edb/ref 17592186045417] [17592186250023 #edb/ref 1079 #uuid "cc697f95-986c-5836-a641-1ed3e8f5e7b5" #edb/ref 17592186045417] [17592186250329 #edb/ref 1068 #edb/ref 17592186250023 #edb/ref 17592186045417] [17592186250329 #edb/ref 1069 "q-114950" #edb/ref 17592186045417] [17592186250329 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186250329 #edb/ref 1071 "Calculate $\\int {e}^{-3x}\\operatorname{cos}⁡x\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186250329 #edb/ref 1072 #uuid "2ca1f5ad-5834-5a52-8770-140ed254c545" #edb/ref 17592186045417] [17592186250329 #edb/ref 1074 "To use integration by parts, let's suppose that \n\n$$\n\\begin{aligned}u={e}^{-3x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-3{e}^{-3x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡x\\, & ⇒\\,v=\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nThen, using the formula of integration by parts, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{-3x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-3x}(\\operatorname{sin}⁡x)-\\int (\\operatorname{sin}⁡x)(-3{e}^{-3x})\\text{d}x \\\\  & ={e}^{-3x}\\operatorname{sin}⁡x+3\\int {e}^{-3x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & ={e}^{-3x}\\operatorname{sin}⁡x+3J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{-3x}\\operatorname{sin}⁡x\\,\\text{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{-3x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-3{e}^{-3x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x\\, & ⇒\\,v=\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{-3x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-3x}(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)(-3{e}^{-3x})\\text{d}x \\\\  & =-{e}^{-3x}\\operatorname{cos}⁡x-3\\int {e}^{-3x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-{e}^{-3x}\\operatorname{cos}⁡x-3I.\\end{aligned}\n$$\n\nFinally, substituting this back into our equation for $I,$ we can subsequently solve for $I.$ We remember to add a constant of integration $C$ at the end.\n\n$$\n\\begin{aligned}I & ={e}^{-3x}\\operatorname{sin}⁡x+3J \\\\ I & ={e}^{-3x}\\operatorname{sin}⁡x+3(-{e}^{-3x}\\operatorname{cos}⁡x-3I) \\\\ I & ={e}^{-3x}\\operatorname{sin}⁡x-3{e}^{-3x}\\operatorname{cos}⁡x-9I \\\\ 10I & ={e}^{-3x}\\operatorname{sin}⁡x-3{e}^{-3x}\\operatorname{cos}⁡x \\\\ I & =\\frac{{e}^{-3x}}{10}(\\operatorname{sin}⁡x-3\\operatorname{cos}⁡x)+C\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186250330 #edb/ref 1068 #edb/ref 17592186249843 #edb/ref 17592186045417] [17592186250330 #edb/ref 1069 "q-114952" #edb/ref 17592186045417] [17592186250330 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186250330 #edb/ref 1071 "Calculate $\\int \\frac{{ln}^{2}⁡x}{4x}\\,\\text{d}x$ using integration by parts." #edb/ref 17592186045417] [17592186250330 #edb/ref 1072 #uuid "4f09819e-da12-5415-9b7c-4388f9ed375d" #edb/ref 17592186045417] [17592186250330 #edb/ref 1074 "First, we let\n\n$$\nI=\\int \\frac{{ln}^{2}⁡x}{4x}\\,\\text{d}x.\n$$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={ln}^{2}⁡x & \\,⇒\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡x}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{4x} & \\,⇒\\,v=\\int \\frac{1}{4x}\\text{d}x=\\frac{\\operatorname{ln}⁡x}{4}\\,.\\end{aligned}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}I & =\\int \\frac{{ln}^{2}⁡x}{4x}\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={ln}^{2}⁡x(\\frac{\\operatorname{ln}⁡x}{4})-\\int (\\frac{\\operatorname{ln}⁡x}{4})(\\frac{2\\operatorname{ln}⁡x}{x})\\,\\text{d}x \\\\  & =\\frac{{ln}^{3}⁡x}{4}-2\\int \\frac{{ln}^{2}⁡x}{4x}\\,\\text{d}x \\\\  & =\\frac{{ln}^{3}⁡x}{4}-2I.\\end{aligned}\n$$\n\nFinally, we solve for $I,$ remembering to add a constant of integration $C$ at the very end:\n\n$$\n\\begin{aligned}I & =\\frac{{ln}^{3}⁡x}{4}-2I \\\\ 3I & =\\frac{{ln}^{3}⁡x}{4} \\\\ I & =\\frac{{ln}^{3}⁡x}{12}+C\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186272580 #edb/ref 1080 "{e}^{-2x}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)+C" #edb/ref 17592186045417] [17592186272580 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186272580 #edb/ref 1083 #uuid "15738e1f-34bd-59f4-a55c-8499650f1ee6" #edb/ref 17592186045417] [17592186272880 #edb/ref 1080 "-\\frac{{e}^{-2x}}{5}(2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)+C" #edb/ref 17592186045417] [17592186272880 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186272880 #edb/ref 1083 #uuid "38720872-3115-5e52-98be-18fa60ea6f8d" #edb/ref 17592186045417] [17592186273085 #edb/ref 1080 "\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x+C" #edb/ref 17592186045417] [17592186273085 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186273085 #edb/ref 1083 #uuid "523a702e-9370-50b1-be12-45b0487956fa" #edb/ref 17592186045417] [17592186273090 #edb/ref 1080 "\\frac{2{e}^{2x}}{3}(2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)+C" #edb/ref 17592186045417] [17592186273090 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186273090 #edb/ref 1083 #uuid "52b2827c-d7e6-5899-9970-1a8728feafba" #edb/ref 175921860