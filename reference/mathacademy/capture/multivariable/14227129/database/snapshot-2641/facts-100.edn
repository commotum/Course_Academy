\\operatorname{sin}⁡(3x)}{3}+\\frac{1}{3}\\int {e}^{-x}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{{e}^{-x}\\operatorname{sin}⁡(3x)}{3}+\\frac{1}{3}I.\\end{aligned}\n$$\n\nFinally, substituting this back into our equation for $I,$ we can subsequently solve for $I.$ We remember to add a constant of integration $C$ at the end.\n\n$$\n\\begin{aligned}I & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(3x)}{3}-\\frac{1}{3}J \\\\ I & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(3x)}{3}-\\frac{1}{3}(\\frac{{e}^{-x}\\operatorname{sin}⁡(3x)}{3}+\\frac{1}{3}I) \\\\ I & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(3x)}{3}-\\frac{{e}^{-x}\\operatorname{sin}⁡(3x)}{9}-\\frac{1}{9}I \\\\ \\frac{10}{9}I & =-\\frac{{e}^{-x}\\operatorname{sin}⁡(3x)+3{e}^{-x}\\operatorname{cos}⁡(3x)}{9} \\\\ I & =-\\frac{{e}^{-x}(\\operatorname{sin}⁡(3x)+3\\operatorname{cos}⁡(3x))}{10}+C\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186548004 #edb/ref 1068 #edb/ref 17592186547859 #edb/ref 17592186045417] [17592186548004 #edb/ref 1069 "q-115002" #edb/ref 17592186045417] [17592186548004 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186548004 #edb/ref 1071 "Evaluate ${\\int }_{0}^{\\pi /2}{e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186548004 #edb/ref 1072 #uuid "509669b5-ef46-5eb1-8d54-7bbaca5f8fc9" #edb/ref 17592186045417] [17592186548004 #edb/ref 1074 "Let's denote the indefinite integral by $I=\\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x.$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{-x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-{e}^{-x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(2x)\\, & ⇒\\,v=\\int \\operatorname{cos}⁡(2x)\\,\\text{d}x=\\frac{\\operatorname{sin}⁡(2x)}{2}.\\end{aligned}\n$$\n\nThen, using the formula of integration by parts, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-x}(\\frac{\\operatorname{sin}⁡(2x)}{2})-\\int (\\frac{\\operatorname{sin}⁡(2x)}{2})(-{e}^{-x})\\text{d}x \\\\  & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}\\int {e}^{-x}\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{-x}\\operatorname{sin}⁡(2x)\\,\\text{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{-x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-{e}^{-x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(2x)\\, & ⇒\\,v=\\int \\operatorname{sin}⁡(2x)\\,\\text{d}x=-\\frac{\\operatorname{cos}⁡(2x)}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{-x}\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-x}(-\\frac{\\operatorname{cos}⁡(2x)}{2})-\\int (-\\frac{\\operatorname{cos}⁡(2x)}{2})(-{e}^{-x})\\text{d}x \\\\  & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{2}-\\frac{1}{2}\\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{2}-\\frac{1}{2}I.\\end{aligned}\n$$\n\nSo, substituting this into our equation for $I,$ we can subsequently solve for $I:$\n\n$$\n\\begin{aligned}I & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}J \\\\ I & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}(-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{2}-\\frac{1}{2}I) \\\\ I & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{4}-\\frac{1}{4}I \\\\ \\frac{5}{4}I & =\\frac{2{e}^{-x}\\operatorname{sin}⁡(2x)-{e}^{-x}\\operatorname{cos}⁡(2x)}{4} \\\\ I & =\\frac{1}{5}{e}^{-x}(2\\operatorname{sin}⁡(2x)-\\operatorname{cos}⁡(2x))\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x & =(\\frac{1}{5}{e}^{-x}(2\\operatorname{sin}⁡(2x)-\\operatorname{cos}⁡(2x))){|}_{0}^{\\pi /2} \\\\  & =(\\frac{1}{5}{e}^{-\\pi /2}(2\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{2})-\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2})))-(\\frac{1}{5}{e}^{-0}(2\\operatorname{sin}⁡(2(0))-\\operatorname{cos}⁡(2(0)))) \\\\  & =\\frac{{e}^{-\\pi /2}}{5}+\\frac{1}{5} \\\\  & =\\frac{{e}^{-\\pi /2}+1}{5}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186548017 #edb/ref 1068 #edb/ref 17592186547900 #edb/ref 17592186045417] [17592186548017 #edb/ref 1069 "q-3402" #edb/ref 17592186045417] [17592186548017 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186548017 #edb/ref 1071 "Calculate $\\int {e}^{x}\\operatorname{cos}⁡x\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186548017 #edb/ref 1072 #uuid "706f56b6-76a3-5149-b5e7-35082287eff9" #edb/ref 17592186045417] [17592186548017 #edb/ref 1074 "To use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}={e}^{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡x\\, & ⇒\\,v=\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nThen, using the formula of integration by parts, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{x}\\operatorname{sin}⁡x-\\int (\\operatorname{sin}⁡x)({e}^{x})\\text{d}x \\\\  & ={e}^{x}\\operatorname{sin}⁡x-\\int {e}^{x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & ={e}^{x}\\operatorname{sin}⁡x-J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{x}\\operatorname{sin}⁡x\\,\\text{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}={e}^{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x\\, & ⇒\\,v=\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{x}(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)({e}^{x})\\text{d}x \\\\  & =-{e}^{x}\\operatorname{cos}⁡x+\\int {e}^{x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-{e}^{x}\\operatorname{cos}⁡x+I.\\end{aligned}\n$$\n\nFinally, substituting this back into our equation for $I,$ we can subsequently solve for $I.$ We remember to add a constant of integration $C$ at the end.\n\n$$\n\\begin{aligned}I & ={e}^{x}\\operatorname{sin}⁡x-J \\\\ I & ={e}^{x}\\operatorname{sin}⁡x-(-{e}^{x}\\operatorname{cos}⁡x+I) \\\\ I & ={e}^{x}\\operatorname{sin}⁡x+{e}^{x}\\operatorname{cos}⁡x-I \\\\ 2I & ={e}^{x}\\operatorname{sin}⁡x+{e}^{x}\\operatorname{cos}⁡x \\\\ I & =\\frac{{e}^{x}\\operatorname{sin}⁡x+{e}^{x}\\operatorname{cos}⁡x}{2}+C\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186548055 #edb/ref 1068 #edb/ref 17592186547967 #edb/ref 17592186045417] [17592186548055 #edb/ref 1069 "q-115005" #edb/ref 17592186045417] [17592186548055 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186548055 #edb/ref 1071 "Evaluate ${\\int }_{-\\pi }^{\\pi }{e}^{-x}\\operatorname{cos}⁡x\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186548055 #edb/ref 1072 #uuid "ce3e4235-61fa-5c48-8fde-1e9523a76255" #edb/ref 17592186045417] [17592186548055 #edb/ref 1074 "Let's denote the indefinite integral by $I=\\int {e}^{-x}\\operatorname{cos}⁡x\\,\\text{d}x.$\n\nTo use integration by parts, let's suppose that \n\n$$\n\\begin{aligned}u={e}^{-x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-{e}^{-x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡x\\, & ⇒\\,v=\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nThen, using the formula of integration by parts, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{-x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-x}(\\operatorname{sin}⁡x)-\\int (\\operatorname{sin}⁡x)(-{e}^{-x})\\text{d}x \\\\  & ={e}^{-x}\\operatorname{sin}⁡x+\\int {e}^{-x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & ={e}^{-x}\\operatorname{sin}⁡x+J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{-x}\\operatorname{sin}⁡x\\,\\text{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{-x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-{e}^{-x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x\\, & ⇒\\,v=\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{-x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-x}(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)(-{e}^{-x})\\text{d}x \\\\  & =-{e}^{-x}\\operatorname{cos}⁡x-\\int {e}^{-x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-{e}^{-x}\\operatorname{cos}⁡x-I.\\end{aligned}\n$$\n\nSo, substituting this into our equation for $I,$ we can subsequently solve for $I:$\n\n$$\n\\begin{aligned}I & ={e}^{-x}\\operatorname{sin}⁡x+J \\\\ I & ={e}^{-x}\\operatorname{sin}⁡x+(-{e}^{-x}\\operatorname{cos}⁡x-I) \\\\ I & ={e}^{-x}\\operatorname{sin}⁡x-{e}^{-x}\\operatorname{cos}⁡x-I \\\\ 2I & ={e}^{-x}\\operatorname{sin}⁡x-{e}^{-x}\\operatorname{cos}⁡x \\\\ I & =\\frac{{e}^{-x}}{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\pi }^{\\pi }{e}^{-x}\\operatorname{cos}⁡x\\,\\text{d}x & =(\\frac{{e}^{-x}}{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)){|}_{-\\pi }^{\\pi } \\\\  & =(\\frac{{e}^{-\\pi }}{2}(\\operatorname{sin}⁡\\pi -\\operatorname{cos}⁡\\pi ))-(\\frac{{e}^{\\pi }}{2}(\\operatorname{sin}⁡(-\\pi )-\\operatorname{cos}⁡(-\\pi ))) \\\\  & =\\frac{{e}^{-\\pi }}{2}-\\frac{{e}^{\\pi }}{2} \\\\  & =\\frac{{e}^{-\\pi }-{e}^{\\pi }}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186548059 #edb/ref 1068 #edb/ref 17592186547876 #edb/ref 17592186045417] [17592186548059 #edb/ref 1069 "q-114951" #edb/ref 17592186045417] [17592186548059 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186548059 #edb/ref 1071 "Calculate $\\int \\frac{{ln}^{8}⁡x}{x}\\,\\text{d}x$ using integration by parts." #edb/ref 17592186045417] [17592186548059 #edb/ref 1072 #uuid "d34958ec-5dd9-5a10-8bd6-7504a0d293c1" #edb/ref 17592186045417] [17592186548059 #edb/ref 1074 "First, we let\n\n$$\nI=\\int \\frac{{ln}^{8}⁡x}{x}\\,\\text{d}x.\n$$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={ln}^{8}⁡x & \\,⇒\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{8{ln}^{7}⁡x}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x} & \\,⇒\\,v=\\int \\frac{1}{x}\\text{d}x=\\operatorname{ln}⁡x\\,.\\end{aligned}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}I & =\\int \\frac{{ln}^{8}⁡x}{x}\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={ln}^{8}⁡x(\\operatorname{ln}⁡x)-\\int (\\operatorname{ln}⁡x)(\\frac{8{ln}^{7}⁡x}{x})\\,\\text{d}x \\\\  & ={ln}^{9}⁡x-8\\int \\frac{{ln}^{8}⁡x}{x}\\,\\text{d}x \\\\  & ={ln}^{9}⁡x-8I.\\end{aligned}\n$$\n\nFinally, we solve for $I,$ remembering to add a constant of integration $C$ at the very end:\n\n$$\n\\begin{aligned}I & ={ln}^{9}⁡x-8I \\\\ 9I & ={ln}^{9}⁡x \\\\ I & =\\frac{{ln}^{9}⁡x}{9}+C\\end{aligned}\n$$" #edb/ref 17592186045417]}
