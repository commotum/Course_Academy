45417] [17592186547967 #edb/ref 1079 #uuid "feba3f58-6495-56d8-aeb6-29990aa6bdd2" #edb/ref 17592186045417] [17592186547974 #edb/ref 1068 #edb/ref 17592186547863 #edb/ref 17592186045417] [17592186547974 #edb/ref 1069 "q-115003" #edb/ref 17592186045417] [17592186547974 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186547974 #edb/ref 1071 "Evaluate ${\\int }_{0}^{\\pi /2}{e}^{-2x}\\operatorname{cos}⁡x\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186547974 #edb/ref 1072 #uuid "0b786a85-3015-50d7-b6da-f38d91ed719a" #edb/ref 17592186045417] [17592186547974 #edb/ref 1074 "Let's denote the indefinite integral by $I=\\int {e}^{-2x}\\operatorname{cos}⁡x\\,\\text{d}x.$\n\nTo use integration by parts, let's suppose that \n\n$$\n\\begin{aligned}u={e}^{-2x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-2{e}^{-2x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡x\\, & ⇒\\,v=\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nThen, using the formula of integration by parts, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{-2x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-2x}(\\operatorname{sin}⁡x)-\\int (\\operatorname{sin}⁡x)(-2{e}^{-2x})\\text{d}x \\\\  & ={e}^{-2x}\\operatorname{sin}⁡x+2\\int {e}^{-2x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & ={e}^{-2x}\\operatorname{sin}⁡x+2J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{-2x}\\operatorname{sin}⁡x\\,\\text{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{-2x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-2{e}^{-2x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x\\, & ⇒\\,v=\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{-2x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-2x}(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)(-2{e}^{-2x})\\text{d}x \\\\  & =-{e}^{-2x}\\operatorname{cos}⁡x-2\\int {e}^{-2x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-{e}^{-2x}\\operatorname{cos}⁡x-2I.\\end{aligned}\n$$\n\nSo, substituting this into our equation for $I,$ we can subsequently solve for $I:$\n\n$$\n\\begin{aligned}I & ={e}^{-2x}\\operatorname{sin}⁡x+2J \\\\ I & ={e}^{-2x}\\operatorname{sin}⁡x+2(-{e}^{-2x}\\operatorname{cos}⁡x-2I) \\\\ I & ={e}^{-2x}\\operatorname{sin}⁡x-2{e}^{-2x}\\operatorname{cos}⁡x-4I \\\\ 5I & ={e}^{-2x}\\operatorname{sin}⁡x-2{e}^{-2x}\\operatorname{cos}⁡x \\\\ I & =\\frac{{e}^{-2x}}{5}(\\operatorname{sin}⁡x-2\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{e}^{-2x}\\operatorname{cos}⁡x\\,\\text{d}x & =(\\frac{{e}^{-2x}}{5}(\\operatorname{sin}⁡x-2\\operatorname{cos}⁡x)){|}_{0}^{\\pi /2} \\\\  & =(\\frac{{e}^{-2\\pi /2}}{5}(\\operatorname{sin}⁡(\\frac{\\pi }{2})-2\\operatorname{cos}⁡(\\frac{\\pi }{2})))-(\\frac{{e}^{-2(0)}}{5}(\\operatorname{sin}⁡0-2\\operatorname{cos}⁡0)) \\\\  & =\\frac{{e}^{-\\pi }}{5}+\\frac{2}{5} \\\\  & =\\frac{1}{5}({e}^{-\\pi }+2)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186547985 #edb/ref 1068 #edb/ref 17592186547847 #edb/ref 17592186045417] [17592186547985 #edb/ref 1069 "q-348879" #edb/ref 17592186045417] [17592186547985 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186547985 #edb/ref 1071 "Evaluate ${\\int }_{1}^{{e}^{3}}\\frac{{ln}^{4}⁡x}{6x}\\,\\text{d}x$ using integration by parts. Do not round the answer.\n\n${\\int }_{1}^{{e}^{3}}\\frac{{ln}^{4}⁡x}{6x}\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186547985 #edb/ref 1072 #uuid "1d4ef9d9-890a-5da6-8625-b613890df574" #edb/ref 17592186045417] [17592186547985 #edb/ref 1074 "Let's denote the indefinite integral by $I=\\int \\frac{{ln}^{4}⁡x}{6x}\\,\\text{d}x.$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={ln}^{4}⁡x & \\,⇒\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{4{ln}^{3}⁡x}{x}, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{6x} & \\,⇒\\,v=\\int \\frac{1}{6x}\\text{d}x=\\frac{\\operatorname{ln}⁡x}{6}.\\end{aligned}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}I & =\\int \\frac{{ln}^{4}⁡x}{6x}\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({ln}^{4}⁡x)(\\frac{\\operatorname{ln}⁡x}{6})-\\int (\\frac{\\operatorname{ln}⁡x}{6})(\\frac{4{ln}^{3}⁡x}{x})\\,\\text{d}x \\\\  & =\\frac{{ln}^{5}⁡x}{6}-4\\int \\frac{{ln}^{4}⁡x}{6x}\\,\\text{d}x \\\\  & =\\frac{{ln}^{5}⁡x}{6}-4I.\\end{aligned}\n$$\n\nNow, we solve for $I.$ We can ignore the constant of integration in this case, because it is insignificant for further evaluation of the definite integral.\n\n$$\n\\begin{aligned}I & =\\frac{{ln}^{5}⁡x}{6}-4I \\\\ 5I & =\\frac{{ln}^{5}⁡x}{6} \\\\ I & =\\frac{{ln}^{5}⁡x}{30}\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{3}}\\frac{{ln}^{4}⁡x}{6x}\\,\\text{d}x & =\\frac{1}{30}({ln}^{5}⁡x)\\,{|}_{1}^{{e}^{3}} \\\\  & =\\frac{1}{30}({ln}^{5}⁡({e}^{3})-{ln}^{5}⁡(1)) \\\\  & =\\frac{1}{30}((3\\operatorname{ln}⁡e)^{5}-{0}^{5}) \\\\  & =\\frac{1}{30}({3}^{5}-0) \\\\  & =\\frac{81}{10}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186547986 #edb/ref 1068 #edb/ref 17592186547940 #edb/ref 17592186045417] [17592186547986 #edb/ref 1069 "q-348848" #edb/ref 17592186045417] [17592186547986 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186547986 #edb/ref 1071 "Evaluate ${\\int }_{1}^{{e}^{5}}\\frac{{ln}^{4}⁡x}{3x}\\,\\text{d}x$ using integration by parts. Do not round the answer.\n\n${\\int }_{1}^{{e}^{5}}\\frac{{ln}^{4}⁡x}{3x}\\,\\text{d}x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186547986 #edb/ref 1072 #uuid "1d5e523f-cb45-5cb6-96e4-37ea7521523c" #edb/ref 17592186045417] [17592186547986 #edb/ref 1074 "Let's denote the indefinite integral by $I=\\int \\frac{{ln}^{4}⁡x}{3x}\\,\\text{d}x.$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={ln}^{4}⁡x & \\,⇒\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{4{ln}^{3}⁡x}{x}, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{3x} & \\,⇒\\,v=\\int \\frac{1}{3x}\\text{d}x=\\frac{\\operatorname{ln}⁡x}{3}.\\end{aligned}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}I & =\\int \\frac{{ln}^{4}⁡x}{3x}\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({ln}^{4}⁡x)(\\frac{\\operatorname{ln}⁡x}{3})-\\int (\\frac{\\operatorname{ln}⁡x}{3})(\\frac{4{ln}^{3}⁡x}{x})\\,\\text{d}x \\\\  & =\\frac{{ln}^{5}⁡x}{3}-4\\int \\frac{{ln}^{4}⁡x}{3x}\\,\\text{d}x \\\\  & =\\frac{{ln}^{5}⁡x}{3}-4I.\\end{aligned}\n$$\n\nNow, we solve for $I.$ We can ignore the constant of integration in this case, because it is insignificant for further evaluation of the definite integral.\n\n$$\n\\begin{aligned}I & =\\frac{{ln}^{5}⁡x}{3}-4I \\\\ 5I & =\\frac{{ln}^{5}⁡x}{3} \\\\ I & =\\frac{{ln}^{5}⁡x}{15}\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{5}}\\frac{{ln}^{4}⁡x}{3x}\\,\\text{d}x & =\\frac{1}{15}({ln}^{5}⁡x)\\,{|}_{1}^{{e}^{5}} \\\\  & =\\frac{1}{15}({ln}^{5}⁡({e}^{5})-{ln}^{5}⁡(1)) \\\\  & =\\frac{1}{15}((5\\operatorname{ln}⁡e)^{5}-{0}^{5}) \\\\  & =\\frac{1}{15}({5}^{5}-0) \\\\  & =\\frac{625}{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186547988 #edb/ref 1068 #edb/ref 17592186547923 #edb/ref 17592186045417] [17592186547988 #edb/ref 1069 "q-12924" #edb/ref 17592186045417] [17592186547988 #edb/ref 1070 #edb/ref 175