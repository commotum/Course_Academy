276 17592186045417 true] [17592186417061 1075 #edb/ref 17592186417038 13194139534276 17592186045417 true] [17592186417061 1075 #edb/ref 17592186417044 13194139534276 17592186045417 true] [17592186417061 1075 #edb/ref 17592186417047 13194139534276 17592186045417 true] [17592186417061 1075 #edb/ref 17592186417049 13194139534276 17592186045417 true] [17592186417061 1075 #edb/ref 17592186417056 13194139534276 17592186045417 true] [17592186417061 1076 #edb/ref 17592186045493 13194139534276 17592186045417 true] [17592186417061 1077 "selection" 13194139534276 17592186045417 true] [17592186417061 1078 #edb/ref 17592186417056 13194139534276 17592186045417 true] [17592186417061 1079 #uuid "a83eb5c9-f2db-5800-a452-9042bb3f229a" 13194139534276 17592186045417 true] [17592186417062 1075 #edb/ref 17592186417033 13194139534276 17592186045417 true] [17592186417062 1075 #edb/ref 17592186417036 13194139534276 17592186045417 true] [17592186417062 1075 #edb/ref 17592186417039 13194139534276 17592186045417 true] [17592186417062 1075 #edb/ref 17592186417048 13194139534276 17592186045417 true] [17592186417062 1075 #edb/ref 17592186417055 13194139534276 17592186045417 true] [17592186417062 1076 #edb/ref 17592186045493 13194139534276 17592186045417 true] [17592186417062 1077 "selection" 13194139534276 17592186045417 true] [17592186417062 1078 #edb/ref 17592186417055 13194139534276 17592186045417 true] [17592186417062 1079 #uuid "b97a16d2-6774-5dbd-8c93-1bf19e34efa2" 13194139534276 17592186045417 true] [17592186417063 1075 #edb/ref 17592186417030 13194139534276 17592186045417 true] [17592186417063 1075 #edb/ref 17592186417041 13194139534276 17592186045417 true] [17592186417063 1075 #edb/ref 17592186417051 13194139534276 17592186045417 true] [17592186417063 1075 #edb/ref 17592186417054 13194139534276 17592186045417 true] [17592186417063 1075 #edb/ref 17592186417057 13194139534276 17592186045417 true] [17592186417063 1076 #edb/ref 17592186045493 13194139534276 17592186045417 true] [17592186417063 1077 "selection" 13194139534276 17592186045417 true] [17592186417063 1078 #edb/ref 17592186417051 13194139534276 17592186045417 true] [17592186417063 1079 #uuid "cd13b3c7-3da9-5394-8668-03f8c929a5e4" 13194139534276 17592186045417 true] [17592186417064 1068 #edb/ref 17592186417060 13194139534276 17592186045417 true] [17592186417064 1069 "q-163010" 13194139534276 17592186045417 true] [17592186417064 1070 #edb/ref 17592186045485 13194139534276 17592186045417 true] [17592186417064 1071 "The mass density function $\\lambda ,$ measured in $\\text{kg/m},$ of a thin rod placed along the $x$-axis over the interval $0\\le x\\le 2$ is given by $\\lambda (x)=x+2,$ where $x$ is measured in meters. What is the total mass of the rod?" 13194139534276 17592186045417 true] [17592186417064 1072 #uuid "1750e7bf-7e92-5681-92a1-454eb28ef5bc" 13194139534276 17592186045417 true] [17592186417064 1074 "Given a thin rod oriented along the $x$-axis over the interval $a\\le x\\le b,$ if $\\lambda (x)$ denotes the mass density function of the rod, then the total mass of the rod is given by  \n\n$$\nm={\\int }_{a}^{b}\\lambda (x)\\,\\text{d}x.\n$$\n\nIn our case, we have\n\n$$\n\\lambda (x)=x+2,\\,a=0,\\,b=2.\n$$\n\n  \n\nWe calculate the mass of the rod as follows:\n\n$$\n\\begin{aligned}m & ={\\int }_{0}^{2}x+2\\,\\text{d}x \\\\  & ={[\\frac{{x}^{2}}{2}+2x]}_{0}^{2} \\\\  & =(\\frac{4}{2}+2\\cdot 2)-0 \\\\  & =6\\end{aligned}\n$$\n\nTherefore, the mass of the rod is $6\\,\\text{kg}.$" 13194139534276 17592186045417 true] [17592186417065 1068 #edb/ref 17592186417062 13194139534276 17592186045417 true] [17592186417065 1069 "q-163040" 13194139534276 17592186045417 true] [17592186417065 1070 #edb/ref 17592186045485 13194139534276 17592186045417 true] [17592186417065 1071 "A thin rod with mass density function $\\lambda (x)={x}^{2}+1,$ measured in $\\text{kg/m},$ is placed along the $x$-axis over the interval $0\\le x\\le 2,$ where $x$ is measured in meters. Find the moment of the rod about the origin." 13194139534276 17592186045417 true] [17592186417065 1072 #uuid "4c3e83a3-697e-51c3-b71e-01fe636e3df8" 13194139534276 17592186045417 true] [17592186417065 1074 "The moment about the origin $O$ of a rod with mass density function $\\lambda (x)$ for $a\\le x\\le b$ is given by \n\n$$\n{M}_{O}={\\int }_{a}^{b}x\\,\\lambda (x)\\,\\text{d}x.\n$$\n\nIn our case, we have\n\n$$\n\\lambda (x)={x}^{2}+1,\\,a=0,\\,b=2.\n$$\n\nWe calculate the moment of the rod about the origin as follows:\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{0}^{2}x\\cdot ({x}^{2}+1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{3}+x\\,\\text{d}x \\\\  & ={[\\frac{{x}^{4}}{4}+\\frac{{x}^{2}}{2}]}_{0}^{2} \\\\  & =(\\frac{{2}^{4}}{4}+\\frac{{2}^{2}}{2})-0 \\\\  & =6\\end{aligned}\n$$\n\n \n\nTherefore, the required moment is $6\\,\\text{kg}\\cdot \\text{m}.$" 13194139534276 17592186045417 true] [17592186417066 1068 #edb/ref 17592186417061 13194139534276 17592186045417 true] [17592186417066 1069 "q-163014" 13194139534276 17592186045417 true] [17592186417066 1070 #edb/ref 17592186045485 13194139534276 17592186045417 true] [17592186417066 1071 "The mass density function $\\lambda ,$ measured in $\\text{kg/m},$ of a thin rod placed along the $x$-axis over the interval $1\\le x\\le 2$ is given by $\\lambda (x)=4{x}^{3}-3,$ where $x$ is measured in meters. What is the total mass of the rod?" 13194139534276 17592186045417 true] [17592186417066 1072 #uuid "66286cd3-980b-5dcd-96d4-d9a56bcaa6b2" 13194139534276 17592186045417 true] [17592186417066 1074 "Given a thin rod oriented along the $x$-axis over the interval $a\\le x\\le b,$ if $\\lambda (x)$ denotes the mass density function of the rod, then the total mass of the rod is given by  \n\n$$\nm={\\int }_{a}^{b}\\lambda (x)\\,\\text{d}x.\n$$\n\nIn our case, we have\n\n$$\n\\lambda (x)=4{x}^{3}-3,\\,a=1,\\,b=2.\n$$\n\n  \n\nWe calculate the mass of the rod as follows:\n\n$$\n\\begin{aligned}m & ={\\int }_{1}^{2}4{x}^{3}-3\\,\\text{d}x \\\\  & =[{x}^{4}-3x]_{1}^{2} \\\\  & =(16-6)-(1-3) \\\\  & =12\\end{aligned}\n$$\n\nTherefore, the mass of the rod is $12\\,\\text{kg}.$" 13194139534276 17592186045417 true] [17592186417067 1068 #edb/ref 17592186417059 13194139534276 17592186045417 true] [17592186417067 1069 "q-163029" 13194139534276 17592186045417 true] [17592186417067 1070 #edb/ref 17592186045486 13194139534276 17592186045417 true] [17592186417067 1071 "Consider a thin rod along the $x$-axis over the interval $0\\le x\\le 1$ whose mass density function is $\\lambda (x)=6{x}^{2}+1.$ Find the $x$-coordinate of the center of mass of the rod." 13194139534276 17592186045417 true] [17592186417067 1072 #uuid "70f7151e-4f69-5e76-9c39-e06e4443c9a7" 13194139534276 17592186045417 true] [17592186417067 1074 "The center of mass of a rod placed along the $x$-axis over the interval $a\\le x\\le b$ whose mass density function is $\\lambda (x)$ is given by \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m},\n$$\n\n \n\nwhere \n\n- $m={\\int }_{a}^{b}\\lambda (x)\\,\\text{d}x$ is the mass of the rod,\n\n- ${M}_{O}={\\int }_{a}^{b}\\,x\\lambda (x)\\,\\text{d}x$ is the moment of the rod about the origin $O.$\n\nIn our case, we have\n\n$$\n\\lambda (x)=6{x}^{2}+1,\\,a=0,\\,b=1.\n$$\n\nSo, the mass of the rod is\n\n$$\n\\begin{aligned}m & ={\\int }_{0}^{1}6{x}^{2}+1\\,\\text{d}x \\\\  & ={[2{x}^{3}+x]}_{0}^{1} \\\\  & =2+1 \\\\  & =3\\end{aligned}\n$$\n\n \n\nand the moment of the rod about the origin is\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{0}^{1}x\\cdot (6{x}^{2}+1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}6{x}^{3}+x\\,\\text{d}x \\\\  & ={[\\frac{3}{2}{x}^{4}+\\frac{1}{2}{x}^{2}]}_{0}^{1} \\\\  & =\\frac{3}{2}+\\frac{1}{2} \\\\  & =2.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m}=\\frac{2}{3}.\n$$" 13194139534276 17592186045417 true] [17592186417068 1068 #edb/ref 17592186417058 13194139534276 17592186045417 true] [17592186417068 1069 "q-163020" 13194139534276 17592186045417 true] [17592186417068 1070 #edb/ref 17592186045487 13194139534276 17592186045417 true] [17592186417068 1071 "![](images/ad/ad5a7d1121f6ae5a471f78477a8857b75c6a5a2008e769b1b9115c2ac880d5b6.png)\n\nThe thin rod above has the mass density function $\\lambda (x)=\\frac{1}{\\sqrt[3]{x}}.$ Given that the mass of the rod is $\\frac{9}{2}$ units, what is the $x$-coordinate of its center of mass?" 13194139534276 17592186045417 true] [17592186417068 1072 #uuid "86915a7f-cf68-50dc-aafb-5f62c6d2e7e3" 13194139534276 17592186045417 true] [17592186417068 1074 "The center of mass of a rod placed along the $x$-axis over the interval $a\\le x\\le b$ whose mass density function is $\\lambda (x)$ is given by \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m},\n$$\n\n \n\nwhere \n\n- $m={\\int }_{a}^{b}\\lambda (x)\\,\\text{d}x$ is the mass of the rod,\n\n- ${M}_{O}={\\int }_{a}^{b}\\,x\\lambda (x)\\,\\text{d}x$ is the moment of the rod about the origin $O.$\n\nIn our case, we have\n\n$$\n\\lambda (x)=\\frac{1}{\\sqrt[3]{x}},\\,a=1,\\,b=8.\n$$\n\nSo,  the moment of the rod about the origin is\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{1}^{8}x\\cdot \\frac{1}{\\sqrt[3]{x}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{8}{x}^{2/3}\\,\\text{d}x \\\\  & ={[\\frac{3}{5}{x}^{5/3}]}_{1}^{8} \\\\  & =\\frac{3}{5}(32-1) \\\\  & =\\frac{93}{5}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m}=\\frac{(\\frac{93}{5})}{(\\frac{9}{2})}=\\frac{62}{15}.\n$$" 13194139534276 17592186045417 true]] :edb/tempids {"answer-13212333-e1f8-56ff-a8c7-3198d8cdf406" 17592186417028 "answer-1951745b-12ed-540f-b8d2-2e76d8598187" 17592186417029 "answer-1d449c1e-1f46-5f61-9ad7-f822f5f2a1f0" 17592186417030 "answer-2b2eba11-f54c-5b8d-8056-31c66238b541" 17592186417031 "answer-4a2af5bd-c1ed-59d9-a566-4a0c218db269" 17592186417032 "answer-4ebcc29e-8dc5-5b22-b315-99b116bd7c52" 17592186417033 "answer-52814006-a528-5e8d-b83f-56a2cb50f1ce" 17592186417034 "answer-5b862d6f-8f37-5068-9257-f93374bc563f" 17592186417035 "answer-5f93a53e-5bf0-5586-a8d2-b6408a9