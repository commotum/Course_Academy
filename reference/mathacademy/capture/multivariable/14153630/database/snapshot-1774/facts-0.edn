/ref 17592186045417] [17592186440634 #edb/ref 1072 #uuid "9dfd8a34-cf86-59cc-aba6-9a0a73cfe2af" #edb/ref 17592186045417] [17592186440634 #edb/ref 1074 "The cross-product rule states that\n\n$$\n{\\int }_{0}^{2}c\\times f(t)\\,\\text{d}t=c\\times {\\int }_{0}^{2}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the cross-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}c\\times f(t)\\,\\text{d}t & =c\\times {\\int }_{0}^{2}f(t)\\,\\text{d}t \\\\  & =(3\\,i-5\\,j+2\\,k)\\times (7\\,i-4\\,j-k) \\\\  & =|\\begin{aligned}i & j & k \\\\ 3 & -5 & 2 \\\\ 7 & -4 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}-5 & 2 \\\\ -4 & -1\\end{aligned}|i-|\\begin{aligned}3 & 2 \\\\ 7 & -1\\end{aligned}|j+|\\begin{aligned}3 & -5 \\\\ 7 & -4\\end{aligned}|k \\\\  & =(5+8)i-(-3-14)j+(-12+35)k \\\\  & =13\\,i+17\\,j+23\\,k.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186458620 #edb/ref 1080 "⟨-\\frac{1}{2},\\,\\frac{1}{2},\\,2⟩" #edb/ref 17592186045417] [17592186458620 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186458620 #edb/ref 1083 #uuid "02e12455-ce2d-515b-a4e0-f7b221799cd0" #edb/ref 17592186045417] [17592186458626 #edb/ref 1080 "⟨2-2e,\\,-2,\\,-2\\operatorname{sin}⁡1⟩" #edb/ref 17592186045417] [17592186458626 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186458626 #edb/ref 1083 #uuid "04f5cd10-e0d7-57e3-b37b-c7277d7967b7" #edb/ref 17592186045417] [17592186458634 #edb/ref 1080 "⟨5,\\,2-\\operatorname{sin}⁡1,\\,-3⟩" #edb/ref 17592186045417] [17592186458634 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186458634 #edb/ref 1083 #uuid "099c360b-8d79-50ca-9ab9-2be6125f91dd" #edb/ref 17592186045417] [17592186458652 #edb/ref 1080 "⟨-\\frac{1}{2},\\,1,\\,0⟩" #edb/ref 17592186045417] [17592186458652 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186458652 #edb/ref 1083 #uuid "1146d883-a7d0-500e-85d1-a9739b8a93e3" #edb/ref 17592186045417] [17592186458654 #edb/ref 1080 "⟨-5,\\,-2,\\,-1⟩" #edb/ref 1