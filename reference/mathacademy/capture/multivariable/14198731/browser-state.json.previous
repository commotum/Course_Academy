          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:60px;\n                                        margin-left:2px;\n                                        margin-right:2px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"51\"><span mathquill-command-id=\"53\">4</span><var mathquill-command-id=\"55\">t</var><span mathquill-command-id=\"57\" class=\"mq-binary-operator\">−</span><span mathquill-command-id=\"59\">5</span></span></div></div>",
          "rendered_text": "4t−5",
