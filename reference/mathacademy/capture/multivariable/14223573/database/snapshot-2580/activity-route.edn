#{[{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186538024} :activity/id #uuid "909a1e60-f32c-537c-a9f6-988fe797e725" :activity/scope {:db/id #edb/ref 17592186050534 :topic/id #uuid "51703412-3999-597b-8a50-c1bd75195c76" :topic/math-academy-id 2135} :activity/steps [{:db/id #edb/ref 17592186538010 :step/content {:db/id #edb/ref 17592186537920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "165fa76d-df92-5e45-90d0-0a3b012427c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "512\\pi " :db/id #edb/ref 17592186537275} {:answer/id #uuid "1fc2daa4-0f98-5208-a949-6ecc2ca8eb4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "256\\pi " :db/id #edb/ref 17592186537299} {:answer/id #uuid "8bd28949-3198-5142-8676-57b452b2eeb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{128\\pi }{3}" :db/id #edb/ref 17592186537494} {:answer/id #uuid "d99e9003-2612-560e-a604-89d922f8dac1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "288\\pi " :db/id #edb/ref 17592186537663} {:answer/id #uuid "fc5e4696-eeae-5ff1-9afd-e56c4c418a37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{64\\pi }{3}" :db/id #edb/ref 17592186537750}] :answer-field/correct {:db/id #edb/ref 17592186537663} :answer-field/id #uuid "cc272370-ecec-5e06-8147-00a26161afa7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537856}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "65b5959b-427f-58b2-a1ab-3381594e4750" :question/math-academy-id "q-162582" :question/problem "Consider the positively (outward) oriented surface $S$ given by $(x-3)^{2}+{y}^{2}+{z}^{2}=36$ and the vector field $F=(x+1)\\,i-y\\,j+z\\,k.$ Use the divergence theorem to find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(x+1)+\\frac{∂}{∂y}(-y)+\\frac{∂}{∂z}(z) \\\\  & =1+(-1)+1 \\\\  & =1.\\end{aligned}\n$$\n\nLet $R$ be the solid sphere of radius $6$ enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}1\\,\\text{d}V \\\\  & =1{∭}_{R}\\,\\text{d}V \\\\  & =1\\cdot \\text{Volume}(R) \\\\  & =1\\cdot \\frac{4}{3}\\pi \\cdot {6}^{3} \\\\  & =288\\pi .\\end{aligned}\n$$"} :step/id #uuid "3dce55ae-d084-5337-aee1-d8317edb813b" :step/next {:db/id #edb/ref 17592186538031}} {:db/id #edb/ref 17592186538017 :step/content {:db/id #edb/ref 17592186537972 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0beb80e1-b251-5f38-8c4b-335984f939ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "128\\pi " :db/id #edb/ref 17592186537245} {:answer/id #uuid "0f3756c9-bdae-5fc5-a4bd-d15ab3bd2b3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{256\\pi }{3}" :db/id #edb/ref 17592186537255} {:answer/id #uuid "2c776a19-195c-58aa-b365-bb6719e73143" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{512\\pi }{3}" :db/id #edb/ref 17592186537321} {:answer/id #uuid "95616eaf-0047-5979-a335-7f695fe9eda0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "243\\pi " :db/id #edb/ref 17592186537511} {:answer/id #uuid "e9c02b9f-29eb-57c2-9ffb-0ff1bd5df608" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64\\pi " :db/id #edb/ref 17592186537703}] :answer-field/correct {:db/id #edb/ref 17592186537255} :answer-field/id #uuid "669b5857-9476-53d2-a3ba-83114e28734b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537800}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d1625297-e3fd-57e3-914d-8b51c40eca40" :question/math-academy-id "q-162576" :question/problem "Consider the positively (outward) oriented surface $S$ given by $(x-1)^{2}+{y}^{2}+(z+3)^{2}=16$ and the vector field $F=(x+2y)\\,i+(4z-y)\\,j+(z+xy)\\,k.$ Use the divergence theorem to find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(x+2y)+\\frac{∂}{∂y}(4z-y)+\\frac{∂}{∂z}(z+xy) \\\\  & =1+(-1)+1 \\\\  & =1.\\end{aligned}\n$$\n\nLet $R$ be the solid sphere of radius $4$ enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}1\\,\\text{d}V \\\\  & =1{∭}_{R}\\,\\text{d}V \\\\  & ={∭}_{R}\\,\\text{d}V \\\\  & =\\text{Volume}(R) \\\\  & =\\frac{4}{3}\\pi \\cdot {4}^{3} \\\\  & =\\frac{256\\pi }{3}.\\end{aligned}\n$$"} :step/id #uuid "4ab52d9d-1386-5abc-93b3-5a289a8a33fe" :step/next {:db/id #edb/ref 17592186538010}} {:db/id #edb/ref 17592186538024 :step/content {:db/id #edb/ref 17592186134139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bfbacc2c-3295-5427-aa6d-abb9d46ca58b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186130991} {:answer/id #uuid "068f8b0d-155c-5288-ab99-7bef355ce630" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186130992} {:answer/id #uuid "217bf025-09a6-5388-b75e-9b4aa6c0931a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186130993} {:answer/id #uuid "3f8b540c-c595-5796-b0a9-c06e4f0ff6a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186130994} {:answer/id #uuid "4935e6a8-5d04-5659-bd19-c0da643e24ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186130995}] :answer-field/correct {:db/id #edb/ref 17592186130992} :answer-field/id #uuid "3cf5d99a-43d2-5f4d-9cab-2d45271876ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186130990}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c4d6f3d3-e8a0-54e3-96bf-06ac782d45a1" :question/math-academy-id "q-162412" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=-1,$ $x=1,$ $y=0,$ $y=1,$ $z=0,$ $z=1.$ Given that the surface $S$ is positively (outward) oriented and $F=2xz\\,i+({x}^{2}+z)\\,j+2\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(2xz)+\\frac{∂}{∂y}({x}^{2}+z)+\\frac{∂}{∂z}(2) \\\\  & =2z+0+0 \\\\  & =2z.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}2z\\,\\text{d}V \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{0}^{1}2z\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{-1}^{1}\\text{d}x\\cdot {\\int }_{0}^{1}\\text{d}y\\cdot {\\int }_{0}^{1}2z\\,\\text{d}z \\\\  & =(1-(-1))\\cdot (1-0)\\cdot [{z}^{2}]_{z=0}^{z=1} \\\\  & =2({1}^{2}-{0}^{2}) \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "56f15a00-caa2-5ac5-aa05-f8b56b93bcf4" :step/next {:db/id #edb/ref 17592186538017}} {:db/id #edb/ref 17592186538031 :step/content {:db/id #edb/ref 17592186537916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57dc0f26-61e8-54f6-8765-f4f9dd4d0d34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186537408} {:answer/id #uuid "9a2113a2-dd4d-539c-984a-b4939769ed41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186537521} {:answer/id #uuid "c491e7f1-cd3a-54c5-a9fb-12f4835abac8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186537606} {:answer/id #uuid "e023c4cd-5ab4-51c0-8881-2596a66eaf02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186537680} {:answer/id #uuid "e98c24e5-1c22-5064-93fa-bfdbc05fdb81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186537701}] :answer-field/correct {:db/id #edb/ref 17592186537521} :answer-field/id #uuid "69fd017c-8fd8-594c-96db-bb6def0c9f0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537803}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "56f4d79a-05af-516b-82f5-f4f41e31d95b" :question/math-academy-id "q-162598" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0,$ $x=1,$ $y=0,$ $y=\\pi ,$ $z=2,$ $z=4.$ Given that the surface $S$ is positively (outward) oriented and $F={z}^{3}\\,i+2xz\\operatorname{cos}⁡y\\,j+x{y}^{2}\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({z}^{3})+\\frac{∂}{∂y}(2xz\\operatorname{cos}⁡y)+\\frac{∂}{∂z}(x{y}^{2}) \\\\  & =0+(-2xz\\operatorname{sin}⁡y)+0 \\\\  & =-2xz\\operatorname{sin}⁡y.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}(-2xz\\operatorname{sin}⁡y)\\,\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\pi }{\\int }_{2}^{4}(-2xz\\operatorname{sin}⁡y)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}2x\\,\\text{d}x\\cdot {\\int }_{0}^{\\pi }(-\\operatorname{sin}⁡y)\\text{d}y\\cdot {\\int }_{2}^{4}z\\,\\text{d}z \\\\  & =[{x}^{2}]_{x=0}^{x=1}\\cdot [\\operatorname{cos}⁡y]_{y=0}^{y=\\pi }\\cdot {[\\frac{{z}^{2}}{2}]}_{z=2}^{z=4} \\\\  & =({1}^{2}-{0}^{2})\\cdot (\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0)\\cdot (\\frac{{4}^{2}}{2}-\\frac{{2}^{2}}{2}) \\\\  & =1\\cdot (-2)\\cdot 6 \\\\  & =-12.\\end{aligned}\n$$"} :step/id #uuid "79949f49-23cd-5a73-93a6-eaeb03dd99b5" :step/next {:db/id #edb/ref 17592186538036}} {:db/id #edb/ref 17592186538036 :step/content {:db/id #edb/ref 17592186537908 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28fa7678-f13a-5850-9ebd-3577ac1a0379" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186537311} {:answer/id #uuid "ae79307e-0a76-5408-ab09-a497ed81c568" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186537560} {:answer/id #uuid "b591f2b8-be38-5e17-9192-b6351f2a138c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186537579} {:answer/id #uuid "d60c91b7-6822-585c-88c2-65de5a82f0ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186537654} {:answer/id #uuid "dbc29b15-264e-5331-b92c-70ab6eedaf01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186537669}] :answer-field/correct {:db/id #edb/ref 17592186537669} :answer-field/id #uuid "9b6833fc-e197-5043-abac-1f89f7ffca8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186537828}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "46a23183-289b-59ee-a9e5-bbe0aa79406a" :question/math-academy-id "q-162603" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=1,$ $x=4,$ $y=0,$ $y=1,$ $z=1,$ $z=2.$ Given that the surface $S$ is positively (outward) oriented and $F=y\\sqrt{x}\\,i+(z-x)\\,j+{y}^{3}\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(y\\sqrt{x})+\\frac{∂}{∂y}(z-x)+\\frac{∂}{∂z}({y}^{3}) \\\\  & =\\frac{y}{2\\sqrt{x}}+0+0 \\\\  & =\\frac{y}{2\\sqrt{x}}.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}\\frac{y}{2\\sqrt{x}}\\,\\text{d}V \\\\  & ={\\int }_{1}^{4}{\\int }_{0}^{1}{\\int }_{1}^{2}\\frac{y}{2\\sqrt{x}}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}\\frac{1}{2\\sqrt{x}}\\,\\text{d}x\\cdot {\\int }_{0}^{1}y\\,\\text{d}y\\cdot {\\int }_{1}^{2}\\text{d}z \\\\  & =[\\sqrt{x}]_{x=1}^{x=4}\\cdot {[\\frac{{y}^{2}}{2}]}_{y=0}^{y=1}\\cdot (2-1) \\\\  & =(2-1)\\cdot (\\frac{1}{2}-0)\\cdot 1 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"} :step/id #uuid "94c36b82-7cd0-559d-9b66-17b2de79c924"}] :activity/title "The Divergence Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186537214}]}
