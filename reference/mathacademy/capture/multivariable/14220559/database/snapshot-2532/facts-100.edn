6}^{7\\pi /6}\\sqrt{1-10\\operatorname{cos}⁡\\theta +25}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{7\\pi /6}\\sqrt{26-10\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186483441 #edb/ref 1058 #edb/ref 17592186483473 #edb/ref 17592186045417] [17592186483441 #edb/ref 1062 #uuid "1b071591-3de0-5c1f-8aeb-668f34070824" #edb/ref 17592186045417] [17592186483441 #edb/ref 1063 #edb/ref 17592186483367 #edb/ref 17592186045417] [17592186483454 #edb/ref 1058 #edb/ref 17592186483472 #edb/ref 17592186045417] [17592186483454 #edb/ref 1062 #uuid "3c48a8d6-bb4a-559a-912c-74a8d59f12d8" #edb/ref 17592186045417] [17592186483454 #edb/ref 1063 #edb/ref 17592186483352 #edb/ref 17592186045417] [17592186483472 #edb/ref 1062 #uuid "73aaaa88-a71a-530e-8d01-e165dd7e3bfc" #edb/ref 17592186045417] [17592186483472 #edb/ref 1063 #edb/ref 17592186483419 #edb/ref 17592186045417] [17592186483473 #edb/ref 1058 #edb/ref 17592186483506 #edb/ref 17592186045417] [17592186483473 #edb/ref 1062 #uuid "748e2a73-740f-5666-bb51-de197b0e3f99" #edb/ref 17592186045417] [17592186483473 #edb/ref 1063 #edb/ref 17592186483373 #edb/ref 17592186045417] [17592186483506 #edb/ref 1058 #edb/ref 17592186483454 #edb/ref 17592186045417] [17592186483506 #edb/ref 1062 #uuid "f880bd39-bc57-5d41-b262-cb0554da3861" #edb/ref 17592186045417] [17592186483506 #edb/ref 1063 #edb/ref 17592186483421 #edb/ref 17592186045417] [17592186510756 #edb/ref 1043 #edb/ref 17592186511593 #edb/ref 17592186045417] [17592186510756 #edb/ref 1043 #edb/ref 17592186511645 #edb/ref 17592186045417] [17592186510756 #edb/ref 1043 #edb/ref 17592186511657 #edb/ref 17592186045417] [17592186510756 #edb/ref 1043 #edb/ref 17592186511661 #edb/ref 17592186045417] [17592186510756 #edb/ref 1043 #edb/ref 17592186511675 #edb/ref 17592186045417] [17592186510756 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186510756 #edb/ref 1045 "Further Properties of Line Integrals of Scalar Functions" #