bmatrix} \\\\  & =\\frac{1}{9}\\cdot \\begin{bmatrix}-54 \\\\ 81\\end{bmatrix} \\\\  & =\\frac{1}{9}v\\end{aligned}\n$$\n\nSo we have $T(v)=\\frac{1}{9}v,$ and so the linear transformation $T$ is a dilation with scale factor $k=\\frac{1}{9}.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n\\begin{bmatrix}k & 0 \\\\ 0 & k\\end{bmatrix}.\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=\\begin{bmatrix}\\frac{1}{9} & 0 \\\\ 0 & \\frac{1}{9}\\end{bmatrix}.\n$$" #edb/ref 17592186045443] [17592186393822 #edb/ref 1075 #edb/ref 17592186393823 #edb/ref 17592186045417] [17592186393822 #edb/ref 1075 #edb/ref 17592186393824 #edb/ref 17592186045417] [17592186393822 #edb/ref 1075 #edb/ref 17592186393825 #edb/ref 17592186045417] [17592186393822 #edb/ref 1075 #edb/ref 17592186393826 #edb/ref 17592186045417] [17592186393822 #edb/ref 1075 #edb/ref 17592186393827 #edb/ref 17592186045417] [17592186393822 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186393822 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186393822 #edb/ref 1078 #edb/ref 17592186393827 #edb/ref 17592186045417] [17592186393822 #edb/ref 1079 #uuid "0da0ed2f-51d0-5d07-b631-9e8cc54faa32" #edb/ref 17592186045417] [17592186393823 #edb/ref 1080 "\\begin{bmatrix}\\frac{1}{9} & 0 \\\\ 1 & 9\\end{bmatrix}" #edb/ref 17592186045443] [17592186393823 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186393823 #edb/ref 1083 #uuid "ebd1c492-bc34-536a-93af-528535ac0dc6" #edb/ref 17592186045417] [17592186393824 #edb/ref 1080 "\\begin{bmatrix}9 & 1 \\\\ 0 & \\frac{1}{9}\\end{bmatrix}" #edb/ref 17592186045443] [17592186393824 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186393824 #edb/ref 1083 #uuid "2527ce77-64be-5a89-9267-c574afcbee7d" #edb/ref 17592186045417] [17592186393825 #edb/ref 1080 "\\begin{bmatrix}0 & \\frac{1}{9} \\\\ \\frac{1}{9} & 0\\end{bmatrix}" #edb/ref 17592186045443] [17592186393825 #edb/ref 1082 #edb/ref