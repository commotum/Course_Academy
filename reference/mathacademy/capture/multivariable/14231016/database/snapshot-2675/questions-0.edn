#{[{:db/id #edb/ref 17592186198629 :knowledge-point/_questions [{:db/id #edb/ref 17592186198407 :knowledge-point/id #uuid "444e9b54-f6d4-5b70-af49-d01556bb3135" :knowledge-point/title "The Moment of a Plane Lamina About the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b03285-dd28-53bf-99ba-9f30ee298c69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186278590} {:answer/id #uuid "10ce3af1-8a51-5f04-b592-aec5e5e1dfe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186278745} {:answer/id #uuid "3539077f-9040-5793-965e-5325ff444cc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186279054} {:answer/id #uuid "94364912-1e0e-55a7-9d73-d9718bcfb22a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186279910} {:answer/id #uuid "9b49a7ff-e06c-5346-a4c3-946264967867" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186279967}] :answer-field/correct {:answer/id #uuid "10ce3af1-8a51-5f04-b592-aec5e5e1dfe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186278745} :answer-field/id #uuid "71b68058-c1ae-5f51-b1c2-303e3f7cbea6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281034}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f4e361d-2d38-571b-8fc9-56865896c6d6" :question/math-academy-id "q-162919" :question/problem "The lamina $D=\\{(x,y)\\,:\\,0\\le y\\le x,\\,0\\le x\\le 1\\}$ has the mass density function $\\lambda (x,y)=3xy.$ Find the moment of the lamina about the $x$-axis." :question/worked-solution "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $x$-axis is given by\n\n$$\n{M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type I plane region and $\\lambda (x,y)=3xy.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\cdot 3xy\\,\\text{d}A \\\\  & ={∬}_{D}3x{y}^{2}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{x}3x{y}^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot {[{y}^{3}]}_{y=0}^{y=x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\cdot {x}^{3}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{4}\\,\\text{d}x \\\\  & ={[\\frac{1}{5}{x}^{5}]}_{x=0}^{x=1} \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281559 :knowledge-point/_questions [{:db/id #edb/ref 17592186198407 :knowledge-point/id #uuid "444e9b54-f6d4-5b70-af49-d01556bb3135" :knowledge-point/title "The Moment of a Plane Lamina About the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03b80abe-a56a-5b96-ade0-aba6bb83e952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186278616} {:answer/id #uuid "2c4965d6-1789-5101-8609-670d36894c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278981} {:answer/id #uuid "37793d3a-b487-5fab-a0b3-6319133e0a2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186279077} {:answer/id #uuid "b8c7d88f-0dc4-56df-a7eb-7dddddb3bafa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186280217} {:answer/id #uuid "f876e45a-8a6b-50b3-9bf4-f6edf08defe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186280774}] :answer-field/correct {:answer/id #uuid "2c4965d6-1789-5101-8609-670d36894c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278981} :answer-field/id #uuid "1871e6ae-50f1-50ed-b4b5-c89a16ab5b1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280875}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "048f739d-8a1c-5493-b18b-4a60653b31c4" :question/math-academy-id "q-162974" :question/problem "The lamina $D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{2}\\le y\\le 1\\}$ has the mass density function $\\lambda (x,y)=\\frac{15{x}^{2}}{y}.$ Find the moment of the lamina about the $x$-axis." :question/worked-solution "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $x$-axis is given by\n\n$$\n{M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type I plane region and $\\lambda (x,y)=\\frac{15{x}^{2}}{y}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\cdot \\frac{15{x}^{2}}{y}\\,\\text{d}A \\\\  & ={∬}_{D}15{x}^{2}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{{x}^{2}}^{1}15{x}^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}15{x}^{2}[{\\int }_{{x}^{2}}^{1}\\,\\text{d}y]\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}15{x}^{2}\\cdot [y]_{y={x}^{2}}^{y=1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}15{x}^{2}\\cdot (1-{x}^{2})\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}15{x}^{2}-15{x}^{4}\\,\\text{d}x \\\\  & ={[5{x}^{3}-3{x}^{5}]}_{x=0}^{x=1} \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186553507 :knowledge-point/_questions [{:db/id #edb/ref 17592186198407 :knowledge-point/id #uuid "444e9b54-f6d4-5b70-af49-d01556bb3135" :knowledge-point/title "The Moment of a Plane Lamina About the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57c13dfc-1ac7-5356-938c-6c2321bc1f4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186553057} {:answer/id #uuid "6fc4d700-b68c-5883-8732-9a880579eb80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186553096} {:answer/id #uuid "998b0089-057f-547f-a803-33516e8d42f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186553179} {:answer/id #uuid "b3c1059f-3768-5550-b92c-3b1eac23c433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186553230} {:answer/id #uuid "eaf263e5-3844-5480-8ed4-14e1d316bb2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186553334}] :answer-field/correct {:answer/id #uuid "b3c1059f-3768-5550-b92c-3b1eac23c433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186553230} :answer-field/id #uuid "43dbda7b-1743-5761-a7b9-ff0017ff6e6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553404}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "27367b15-5da8-51eb-9ba6-49205792b06d" :question/math-academy-id "q-162976" :question/problem "The lamina $D=\\{(x,y)\\,:\\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\operatorname{sin}⁡x\\}$ has the mass density function $\\lambda (x,y)=3y\\operatorname{cos}⁡x.$ Find the moment of the lamina about the $x$-axis." :question/worked-solution "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $x$-axis is given by\n\n$$\n{M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type I plane region and $\\lambda (x,y)=3y\\operatorname{cos}⁡x.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\cdot 3y\\operatorname{cos}⁡x\\,\\text{d}A \\\\  & ={∬}_{D}3{y}^{2}\\operatorname{cos}⁡x\\,\\text{d}A \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡x}3{y}^{2}\\operatorname{cos}⁡x\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡x[{\\int }_{0}^{\\operatorname{sin}⁡x}3{y}^{2}\\,\\text{d}y]\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡x\\cdot {[{y}^{3}]}_{y=0}^{y=\\operatorname{sin}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}{sin}^{3}⁡x\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & ={[\\frac{{sin}^{4}⁡x}{4}]}_{x=0}^{x=\\pi /2} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281586 :knowledge-point/_questions [{:db/id #edb/ref 17592186198406 :knowledge-point/id #uuid "804ee2d1-5590-534d-ae11-7d2c5614a9b1" :knowledge-point/title "The Moment of a Plane Lamina About the Y-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "058f3f49-dd9b-5bcf-91d7-3a13b16a9e8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186278643} {:answer/id #uuid "77ba5e2f-a104-5d77-9899-41ca53308fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186279660} {:answer/id #uuid "c21732aa-50b9-5374-b1cf-aafdcf9b532e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186280296} {:answer/id #uuid "d3a28a67-2379-5f88-bd30-3f1a0be7c1a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186280454} {:answer/id #uuid "f6bfa4ea-979d-50bf-aa25-25d0dbfd8906" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186280752}] :answer-field/correct {:answer/id #uuid "f6bfa4ea-979d-50bf-aa25-25d0dbfd8906" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186280752} :answer-field/id #uuid "2417477b-102b-5b64-a662-c9071feb4de4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280895}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "950af147-dd8f-5a17-bc09-5c26666bfffb" :question/math-academy-id "q-163062" :question/problem "The lamina $D=\\{(x,y)\\,:\\,\\frac{1}{2}\\le x\\le 1,\\,\\operatorname{ln}⁡x\\le y\\le 0\\}$ has the mass density function $\\lambda (x,y)=2{e}^{y}.$ Find the moment of the lamina about the $y$-axis." :question/worked-solution "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $y$-axis is given by\n\n$$\n{M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type I plane region and $\\lambda (x,y)=2{e}^{y}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{y} & ={∬}_{D}x\\cdot 2{e}^{y}\\,\\text{d}A \\\\  & ={∬}_{D}2x{e}^{y}\\,\\text{d}A \\\\  & ={\\int }_{1/2}^{1}{\\int }_{\\operatorname{ln}⁡x}^{0}2x{e}^{y}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1/2}^{1}2x[{\\int }_{\\operatorname{ln}⁡x}^{0}{e}^{y}\\,\\text{d}y]\\,\\text{d}x \\\\  & ={\\int }_{1/2}^{1}2x\\cdot [{e}^{y}]_{y=\\operatorname{ln}⁡x}^{y=0}\\,\\text{d}x \\\\  & ={\\int }_{1/2}^{1}2x(1-x)\\,\\text{d}x \\\\  & ={\\int }_{1/2}^{1}2x-2{x}^{2}\\,\\text{d}x \\\\  & ={[{x}^{2}-\\frac{2{x}^{3}}{3}]}_{x=1/2}^{x=1} \\\\  & =(1-\\frac{2}{3})-(\\frac{1}{4}-\\frac{1}{12}) \\\\  & =\\frac{1}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281613 :knowledge-point/_questions [{:db/id #edb/ref 17592186198406 :knowledge-point/id #uuid "804ee2d1-5590-534d-ae11-7d2c5614a9b1" :knowledge-point/title "The Moment of a Plane Lamina About the Y-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03f5fb45-2fae-517d-b34c-c987569bdec5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186278622} {:answer/id #uuid "4526b476-fcd9-5d37-a7e3-e30a4fe882ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186279208} {:answer/id #uuid "52dfc9d3-54d9-5dc1-a00c-2582e20de483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186279345} {:answer/id #uuid "6fb03689-d055-5100-8394-403fc499e7d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186279606} {:answer/id #uuid "942cb1e4-d459-5e88-9e20-4919448700c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186279909}] :answer-field/correct {:answer/id #uuid "52dfc9d3-54d9-5dc1-a00c-2582e20de483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186279345} :answer-field/id #uuid "13279313-89f2-561e-b944-a8d52266ad9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280864}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13f35429-2bb3-5bdd-9f21-f76be76ab433" :question/math-academy-id "q-163152" :question/problem "The lamina $D=\\{(x,y)\\,:\\,{y}^{2}\\le x\\le 1,\\,\\frac{1}{2}\\le y\\le 1\\}$ has the mass density function $\\lambda (x,y)=\\frac{1}{x}.$ Find the moment of the lamina about the $y$-axis." :question/worked-solution "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $y$-axis is given by\n\n$$\n{M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type II plane region and $\\lambda (x,y)=\\frac{1}{x}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{y} & ={∬}_{D}x\\cdot \\frac{1}{x}\\,\\text{d}A \\\\  & ={∬}_{D}1\\,\\text{d}A \\\\  & ={\\int }_{1/2}^{1}{\\int }_{{y}^{2}}^{1}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1/2}^{1}[x]_{x={y}^{2}}^{x=1}\\,\\text{d}y \\\\  & ={\\int }_{1/2}^{1}1-{y}^{2}\\,\\text{d}y \\\\  & ={[y-\\frac{{y}^{3}}{3}]}_{y=1/2}^{y=1} \\\\  & =(1-\\frac{1}{3})-(\\frac{1}{2}-\\frac{1}{24}) \\\\  & =\\frac{5}{24}.\\end{aligned}\n$$"}]}
