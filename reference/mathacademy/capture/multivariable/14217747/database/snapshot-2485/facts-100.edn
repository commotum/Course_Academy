#{[17592186529160 #edb/ref 1068 #edb/ref 17592186529075 #edb/ref 17592186045417] [17592186529160 #edb/ref 1069 "q-352321" #edb/ref 17592186045417] [17592186529160 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529160 #edb/ref 1071 "Find the area $A$ bounded by the polar curve $r=3+4\\operatorname{cos}⁡\\theta $ for $-\\frac{\\pi }{3}\\le \\theta \\le \\frac{\\pi }{3}.$ Do not round the answer.\n\n$A=$\n{{field-1}}" #edb/ref 17592186045417] [17592186529160 #edb/ref 1072 #uuid "acc4627b-a75b-5710-8130-818c19bd3eef" #edb/ref 17592186045417] [17592186529160 #edb/ref 1074 "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=3+4\\operatorname{cos}⁡\\theta $, ${\\theta }_{1}=-\\frac{\\pi }{3}$ and ${\\theta }_{2}=\\frac{\\pi }{3}$, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /3}^{\\pi /3}(3+4\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /3}^{\\pi /3}(9+24\\operatorname{cos}⁡\\theta +16{cos}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /3}^{\\pi /3}(9+24\\operatorname{cos}⁡\\theta +8(1+\\operatorname{cos}⁡(2\\theta )))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(17\\theta +24\\operatorname{sin}⁡\\theta +4\\operatorname{sin}⁡(2\\theta )){|}_{-\\pi /3}^{\\pi /3} \\\\  & =\\frac{1}{2}(17\\theta \\,{|}_{-\\pi /3}^{\\pi /3}+24\\operatorname{sin}⁡\\theta \\,{|}_{-\\pi /3}^{\\pi /3}+4\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /3}^{\\pi /3}) \\\\  & =\\frac{17}{2}\\theta \\,{|}_{-\\pi /3}^{\\pi /3}+12\\operatorname{sin}⁡\\theta \\,{|}_{-\\pi /3}^{\\pi /3}+2\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /3}^{\\pi /3} \\\\  & =\\frac{17}{2}(\\frac{\\pi }{3}+\\frac{\\pi }{3})+12(\\operatorname{sin}⁡(\\frac{\\pi }{3})-\\operatorname{sin}⁡(-\\frac{\\pi }{3}))+2(\\operatorname{sin}⁡(\\frac{2\\pi }{3})-\\operatorname{sin}⁡(-\\frac{2\\pi }{3})) \\\\  & =\\frac{17\\pi }{3}+12(\\sqrt{3})+2(\\sqrt{3}) \\\\  & =\\frac{17\\pi }{3}+14\\sqrt{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529177 #edb/ref 1068 #edb/ref 17592186528993 #edb/ref 17592186045417] [17592186529177 #edb/ref 1069 "q-352336" #edb/ref 17592186045417] [17592186529177 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529177 #edb/ref 1071 "Find the area $A$ bounded by the polar curve $r=2\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{2}.$ Do not round the answer.\n\n$A=$\n{{field-1}}" #edb/ref 17592186045417] [17592186529177 #edb/ref 1072 #uuid "d870d48d-9aa5-5918-85fa-03f4b0df3775" #edb/ref 17592186045417] [17592186529177 #edb/ref 1074 "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nWhen $r(\\theta )=2\\theta $, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\frac{\\pi }{2}$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(2\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}4{\\theta }^{2}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi /2}{\\theta }^{2}\\,\\text{d}\\theta  \\\\  & =2(\\frac{{\\theta }^{3}}{3}){|}_{0}^{\\pi /2} \\\\  & =2(\\frac{(\\pi /2)^{3}}{3})-2(\\frac{{0}^{3}}{3}) \\\\  & =\\frac{{\\pi }^{3}}{12}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529179 #edb/ref 1068 #edb/ref 17592186528986 #edb/ref 17592186045417] [17592186529179 #edb/ref 1069 "q-79793" #edb/ref 17592186045417] [17592186529179 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186529179 #edb/ref 1071 "Which of the following gives the total area enclosed by the graph of the polar curve $r=\\operatorname{sin}⁡\\theta +2\\,$ for $\\,\\frac{\\pi }{4}\\le \\theta \\le \\pi ?$" #edb/ref 17592186045417] [17592186529179 #edb/ref 1072 #uuid "d9bf3624-c382-5070-9fe1-d9a42b576ac0" #edb/ref 17592186045417] [17592186529179 #edb/ref 1074 "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=\\operatorname{sin}⁡\\theta +2$, ${\\theta }_{1}=\\frac{\\pi }{4}$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{\\pi /4}^{\\pi }(\\operatorname{sin}⁡\\theta +2)^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /4}^{\\pi }({sin}^{2}⁡\\theta +4\\operatorname{sin}⁡\\theta +4)\\text{d}\\theta .\\end{aligned}\n$$" #edb/ref 17592186045417]}
