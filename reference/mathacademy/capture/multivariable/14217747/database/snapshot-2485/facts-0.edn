6045417] [17592186092396 #edb/ref 1050 1500.0 #edb/ref 17592186045417] [17592186092396 #edb/ref 1050 1500.0 #edb/ref 17592186045436] [17592186092396 #edb/ref 1053 #uuid "eaf91217-4388-5eb6-8d99-ece4485ba63a" #edb/ref 17592186045417] [17592186092628 #edb/ref 1068 #edb/ref 17592186090051 #edb/ref 17592186045417] [17592186092628 #edb/ref 1069 "q-20640" #edb/ref 17592186045417] [17592186092628 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186092628 #edb/ref 1071 "![](images/4a/4a83949bcdf4ed8d99cac451d6db21986c24819d1601578890f86fe3df99666a.png)\n\nFind the area bounded by the polar curve $r=2+2\\operatorname{cos}⁡\\theta $ for $\\frac{\\pi }{2}\\le \\theta \\le \\pi ,$ as shown above." #edb/ref 17592186045417] [17592186092628 #edb/ref 1072 #uuid "cb2c5d25-e3ba-5c5d-9450-482e68e4a749" #edb/ref 17592186045417] [17592186092628 #edb/ref 1073 true #edb/ref 17592186045417] [17592186092628 #edb/ref 1074 "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=2+2\\operatorname{cos}⁡\\theta $, ${\\theta }_{1}=\\frac{\\pi }{2}$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{\\pi }(2+2\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{\\pi }(4+8\\operatorname{cos}⁡\\theta +4{cos}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{4}{2}{\\int }_{\\pi /2}^{\\pi }(1+2\\operatorname{cos}⁡\\theta +{cos}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =2(\\theta \\,{|}_{\\pi /2}^{\\pi }+2\\operatorname{sin}⁡\\theta \\,{|}_{\\pi /2}^{\\pi }+\\frac{1}{2}{\\int }_{\\pi /2}^{\\pi }(1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta ) \\\\  & =2(\\theta \\,{|}_{\\pi /2}^{\\pi }+2\\operatorname{sin}⁡\\theta \\,{|}_{\\pi /2}^{\\pi }+\\frac{1}{2}(\\theta \\,{|}_{\\pi /2}^{\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{2}\\,{|}_{\\pi /2}^{\\pi })) \\\\  & =2(\\theta \\,{|}_{\\pi /2}^{\\pi }+2\\operatorname{sin}⁡\\theta \\,{|}_{\\pi /2}^{\\pi }+\\frac{1}{2}\\theta \\,{|}_{\\pi /2}^{\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{4}\\,{|}_{\\pi /2}^{\\pi }) \\\\  & =3\\theta \\,{|}_{\\pi /2}^{\\pi }+4\\operatorname{sin}⁡\\theta \\,{|}_{\\pi /2}^{\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{2}\\,{|}_{\\pi /2}^{\\pi } \\\\  & =3(\\pi -\\frac{\\pi }{2})+4(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(\\frac{\\pi }{2}))+\\frac{1}{2}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(\\pi )) \\\\  & =\\frac{3\\pi }{2}-4+\\frac{1}{2}(0) \\\\  & =\\frac{3\\pi -8}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186093082 #edb/ref 1058 #edb/ref 17592186093083 #edb/ref 17592186045417] [17592186093082 #edb/ref 1061 636917 #edb/ref 17592186045417] [17592186093082 #edb/ref 1062 #uuid "124bbd3f-149a-58b4-a192-cddec4a55c87" #edb/ref 17592186045417] [17592186093082 #edb/ref 1063 #edb/ref 17592186093357 #edb/ref 17592186045417] [17592186093083 #edb/ref 1058 #edb/ref 17592186093084 #edb/ref 17592186045417] [17592186093083 #edb/ref 1061 636918 #edb/ref 17592186045417] [17592186093083 #edb/ref 1062 #uuid "3976f903-173b-5b28-82c6-c4d5e43d84ee" #edb/ref 17592186045417] [17592186093083 #edb/ref 1063 #edb/ref 17592186092237 #edb/ref 17592186045417] [17592186093084 #edb/ref 1058 #edb/ref 17592186093127 #edb/ref 17592186045417] [17592186093084 #edb/ref 1061 636921 #edb/ref 17592186045417] [17592186093084 #edb/ref 1062 #uuid "4a4e1d0d-4d58-52c3-9254-7fbdf1cb4931" #edb/ref 17592186045417] [17592186093084 #edb/ref 1063 #edb/ref 17592186092238 #edb/ref 17592186045417] [17592186093127 #edb/ref 1058 #edb/ref 17592186093145 #edb/ref 17592186045417] [17592186093127 #edb/ref 1061 636924 #edb/ref 17592186045417] [17592186093127 #edb/ref 1062 #uuid "545d497e-388a-508b-8784-5ae8f6439681" #edb/ref 17592186045417] [17592186093127 #edb/ref 1063 #edb/ref 17592186092268 #edb/ref 17592186045417] [17592186093145 #edb/ref 1061 636927 #edb/ref 17592186045417] [17592186093145 #edb/ref 1062 #uuid "a348433a-cb9d-5ca7-a360-627ea0f7f338" #edb/ref 17592186045417] [17592186093145 #edb/ref 1063 #edb/ref 17592186093452 #edb/ref 17592186045417] [17592186093357 #edb/ref 1064 "Suppose we want to find the area of the region bounded by the polar curve $r = 3\\cos\\theta$ and the rays $\\theta_1 = 0$ and $\\theta_2 = \\dfrac{\\pi}{2},$ as shown in blue in the picture below. Can we calculate this area using polar coordinates?\n\n![](images/2c/2c7e638a338aed2155ef5bf388be1f83a3a67d2296d5be09987b099a07edacbd.png)\n\nIn general, the area of the region bounded by a polar curve $r=r(\\theta)$ and the rays $\\theta=\\theta_1$ and $\\theta=\\theta_2$ is given by the formula\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2 \\:\\textrm{d}\\theta.\n$$\n\nTherefore, the area of the half-circle above can be obtained as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(3\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{0}^{\\pi /2}{cos}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{0}^{\\pi /2}\\frac{1}{2}(1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{9}{4}(\\theta {|}_{0}^{\\pi /2}+\\frac{1}{2}\\operatorname{sin}⁡(2\\theta ){|}_{0}^{\\pi /2}) \\\\  & =\\frac{9}{4}(\\frac{\\pi }{2}+0) \\\\  & =\\frac{9\\pi }{8}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186093357 #edb/ref 1065 1126 #edb/ref 17592186045417] [17592186093357 #edb/ref 1066 #uuid "37d5627c-6e4c-5ffe-b3f4-9efac9c1cc1c" #edb/ref 17592186045417] [17592186093357 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186093452 #edb/ref 1064 "We've been using the following formula for the area of the region bounded by a polar curve ![](images/70/7031a0f3ab71df36bc36e925fcf4f04dbfc4feec5f374092855ef8d97b104452.svg) and the rays ![](images/38/38b971de9610efe2ed0de9f10956c73cf5cd967a86a5bcbb076791f369c22bef.svg) and ![](images/81/818e2605a585628c4becd20664b58007dbd2348ca664c80be6a838868a64693a.svg)\n\n![](images/55/55ffcf934c3a9e33a3376fa1796e6fb68ad1198d719db5ea094fe8eb46c5f47d.svg)\n\nBut where does this formula come from?\n\nTo see where the formula comes from, we can think about breaking up the area bounded by a polar curve into infinitesimally small sectors of circles.\n\nAs shown in the graph below, each sector has a radius of ![](images/3a/3a4ef1c1b261a53f9c45d0c90f2d44b155125fe1e7b1359406830111b4846f2f.svg) and spans an infinitesimally small angle, ![](images/09/0904a69fa5e6a3a10eaf74b3fdd865db92761eeeffffae1c0badd33ffdf5b34b.svg)\n\n![](images/82/82be86e7092a97ca5b2f1423f32b15030af0c8c63bf47ece8be40b45720ac905.png)\n\nThe ratio of the area of a sector to the full area of the circle must be the same as the ratio of the angle of the sector to a full revolution of the circle. So, if the area of a sector is ![](images/0b/0b2376d17b173024d6f6c82faaff585293e9830ba7ce0764ecf8338adcd14994.svg) then we can set up and solve the following proportion:\n\n![](images/5d/5d318385ab16ee14d784b33c00180a44ade7cee2e97ffeafd290171d0d44868f.svg)\n\nFinally, to find the area under the curve, we can integrate the areas of all the sectors:\n\n![](images/a7/a75940f74a02ceadff519af028783a0e704fba8a73c4abf36c6a371deb56dee7.svg)" #edb/ref 17592186045417] [17592186093452 #edb/ref 1065 4582 #edb/ref 17592186045417] [17592186093452 #edb/ref 1066 #uuid "1ba36924-1af3-515d-ac60-aab46240a7e7" #edb/ref 17592186045417] [17592186093452 #edb/ref 1067 "Intuition Behind the Formula" #edb/ref 17592186045417] [17592186319458 #edb/ref 1080 "\\frac{2{\\pi }^{3}}{3}" #edb/ref 17592186045417] [17592186319458 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186319458 #edb/ref 1083 #uuid "1722fb6a-3828-5c7b-bfd2-cfed88f52b98" #edb/ref 17592186045417] [17592186320607 #edb/ref 1075 #edb/ref 17592186319458 #edb/ref 17592186045417] [17592186320607 #edb/ref 1075 #edb/ref 17592