8976e-ecd9-52fe-8371-edaabd05c065" #edb/ref 17592186045417] [17592186092089 #edb/ref 1069 "e-632" #edb/ref 17592186045417] [17592186092089 #edb/ref 1071 "Find the area bounded by the polar curve $r = \\cos(3\\theta)$ and the lines $\\theta = -\\dfrac{\\pi}{6}$ and $\\theta = \\dfrac{\\pi}{6}.$\n\n![](images/35/350a721c254dab3a8acb2ae54ca5be0bcde6ab036e6936939194c57ae55fe4ff.png)" #edb/ref 17592186045417] [17592186092089 #edb/ref 1072 #uuid "0d1dcc59-e7af-5a86-87ba-aa7ee1b23767" #edb/ref 17592186045417] [17592186092089 #edb/ref 1074 "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,.\n$$\n\nWhen $r(\\theta) = \\cos(3\\theta),$ $\\theta_1=-\\dfrac{\\pi}{6},$ and $\\theta_2=\\dfrac{\\pi}{6},$ this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}{cos}^{2}⁡(3\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{\\int }_{-\\pi /6}^{\\pi /6}(1+\\operatorname{cos}⁡(6\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}(\\theta {|}_{-\\pi /6}^{\\pi /6}+\\frac{1}{6}\\operatorname{sin}⁡(6\\theta ){|}_{-\\pi /6}^{\\pi /6}) \\\\  & =\\frac{1}{4}((\\frac{\\pi }{6}-(-\\frac{\\pi }{6}))+\\frac{1}{6}(\\operatorname{sin}⁡\\pi -\\operatorname{sin}⁡(-\\pi ))) \\\\  & =\\frac{1}{4}(\\frac{\\pi }{3}+0) \\\\  & =\\frac{\\pi }{12}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186092090 #edb/ref 1069 "e-633" #edb/ref 17592186045417] [17592186092090 #edb/ref 1071 "Find the area bounded by the polar curve $r = 1+2\\cos\\theta$ for $\\dfrac{2\\pi}{3} \\leq \\theta \\leq \\dfrac{4\\pi}{3},$ as shown below.\n\n![](images/6b/6bfa0990b560bcb09f2a9eb0b9542296f2a8f1c196b6740702e81c59941d66c5.png)" #edb/ref 17592186045417] [17592186092090 #edb/ref 1072 #uuid "6040d180-ed1d-52b8-809c-b5820352d3d8" #edb/ref 17592186045417] [17592186092090 #edb/ref 1074 "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,.\n$$\n\nWhen $r(\\theta) = 1+2\\cos(\\theta),$ $\\theta_1=\\dfrac{2\\pi}{3},$ and $\\theta_2=\\dfrac{4\\pi}{3},$ this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{2\\pi /3}^{4\\pi /3}(1+2\\operatorname{cos}⁡(\\theta ))^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{2\\pi /3}^{4\\pi /3}(1+4\\operatorname{cos}⁡\\theta +4{cos}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+4\\operatorname{sin}⁡\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+4\\cdot \\frac{1}{2}{\\int }_{2\\pi /3}^{4\\pi /3}(1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta ) \\\\  & =\\frac{1}{2}(\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+4\\operatorname{sin}⁡\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+2\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+\\operatorname{sin}⁡(2\\theta )\\,{|}_{2\\pi /3}^{4\\pi /3}) \\\\  & =\\frac{1}{2}(3\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+4\\operatorname{sin}⁡\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+\\operatorname{sin}⁡(2\\theta )\\,{|}_{2\\pi /3}^{4\\pi /3}) \\\\  & =\\frac{1}{2}(2\\pi -4\\sqrt{3}+\\sqrt{3}) \\\\  & =\\frac{1}{2}(2\\pi -3\\sqrt{3}).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186092105 #edb/ref 1069 "e-6822" #edb/ref 17592186045417] [17592186092105 #edb/ref 1071 "![](images/d7/d7b39805131dc562e233d49a84f69d30e80ca29cb9443012032d18fdb4512054.png)\n\nFind the area bounded by the polar curve $r = 2\\sin\\theta + 2\\cos\\theta$ for $\\dfrac{\\pi}{2} \\leq \\theta \\leq \\dfrac{3\\pi}{4},$ as shown above." #edb/ref 17592186045417] [17592186092105 #edb/ref 1072 #uuid "a2d8dca5-a0f3-5b6f-81f5-4eea46ee70d8" #edb/ref 17592186045417] [17592186092105 #edb/ref 1074 "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,.\n$$\n\nWhen $r(\\theta) = 2\\sin\\theta + 2\\cos\\theta,$ $\\theta_1=\\dfrac{\\pi}{2},$ and $\\theta_2=\\dfrac{3\\pi}{4},$ this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{3\\pi /4}(2\\operatorname{sin}⁡\\theta +2\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{3\\pi /4}(4{sin}^{2}⁡\\theta +8\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +4{cos}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{3\\pi /4}(4+8\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{4}{2}{\\int }_{\\pi /2}^{3\\pi /4}(1+\\operatorname{sin}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =2(\\theta \\,{|}_{\\pi /2}^{3\\pi /4}-\\frac{\\operatorname{cos}⁡(2\\theta )}{2}\\,{|}_{\\pi /2}^{3\\pi /4}) \\\\  & =2\\theta \\,{|}_{\\pi /2}^{3\\pi /4}-\\operatorname{cos}⁡(2\\theta )\\,{|}_{\\pi /2}^{3\\pi /4} \\\\  & =2(\\frac{3\\pi }{4}-\\frac{\\pi }{2})-(\\operatorname{cos}⁡(\\frac{3\\pi }{2})-\\operatorname{cos}⁡(\\pi )) \\\\  & =\\frac{\\pi }{2}-1 \\\\  & =\\frac{\\pi -2}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186092237 #edb/ref 1037 #edb/ref 17592186048292 #edb/ref 17592186045417] [17592186092237 #edb/ref 1037 #edb/ref 17592186049303 #edb/ref 17592186045417] [17592186092237 #edb/ref 1038 #edb/ref 17592186092626 #edb/ref 17592186045417] [17592186092237 #edb/ref 1038 #edb/ref 17592186092932 #edb/ref 17592186045417] [17592186092237 #edb/ref 1038 #edb/ref 17592186259576 #edb/ref 17592186045417] [17592186092237 #edb/ref 1038 #edb/ref 17592186259577 #edb/ref 17592186045417] [17592186092237 #edb/ref 1038 #edb/ref 17592186320969 #edb/ref 17592186045417] [17592186092237 #edb/ref 1038 #edb/ref 17592186320970 #edb/ref 17592186045417] [17592186092237 #edb/ref 1038 #edb/ref 17592186400135 #edb/ref 17592186045417] [17592186092237 #edb/ref 1038 #edb/ref 17592186529113 #edb/ref 17592186045417] [17592186092237 #e