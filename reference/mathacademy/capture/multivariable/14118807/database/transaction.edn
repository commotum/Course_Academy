dc-5eb7-83dd-f992ccfbc948" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-field-5f29fb48-ed4b-52ad-b77b-99f62ab2bfc4" :answer-field/id #uuid "5f29fb48-ed4b-52ad-b77b-99f62ab2bfc4" :answer-field/key "field-10" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0dd1ea2e-80e6-5727-a974-814275f13130" :answer-field/choices ["answer-0dd1ea2e-80e6-5727-a974-814275f13130"] :db/ensure [:answer-field/validate]} {:db/id "answer-0dd1ea2e-80e6-5727-a974-814275f13130" :answer/id #uuid "0dd1ea2e-80e6-5727-a974-814275f13130" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "question-47fd4ff4-6ba7-5ef0-9848-b6ea043ad002" :question/id #uuid "47fd4ff4-6ba7-5ef0-9848-b6ea043ad002" :question/math-academy-id "q-332740" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}3 & -2 \\\\ 1 & 1\\end{aligned}]x(t)+{e}^{6t}[\\begin{aligned}1 \\\\ -3\\end{aligned}]\n$$\n\nA complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}{e}^{2t}[\\begin{aligned}\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]+{c}_{2}{e}^{2t}[\\begin{aligned}\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system can be written as \n$x(t)={x}_{c}(t)+{x}_{p}(t),$\nwhere ${x}_{p}(t)$ is a particular solution. Determine the form of the particular solution ${x}_{p}(t).$" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere (\\mathbf{x}_c(t)) is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n{e}^{6t}[\\begin{aligned}1 \\\\ -3\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is exponential. Therefore, we assume that the particular solution has the same exponential factor, i.e.\n\n$$\n{x}_{p}(t)={e}^{6t}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}],\n$$\n\nwhere ${a}_{1},{a}_{2}$ are constants that are to be determined." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c0a52ada-8c54-5615-81ca-fa8f0f0a0820"] :db/ensure [:question/validate]} {:db/id "answer-field-c0a52ada-8c54-5615-81ca-fa8f0f0a0820" :answer-field/id #uuid "c0a52ada-8c54-5615-81ca-fa8f0f0a0820" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-170117e4-3734-55f1-8a0e-dfa50d72211d" :answer-field/choices ["answer-16a7977b-7339-57b7-a923-e8d0d8e4ad67" "answer-c6a09ee3-dc65-57fb-bc76-d9010cfcc444" "answer-2dcbc6a3-2212-5cc2-8998-578a7cd88408" "answer-170117e4-3734-55f1-8a0e-dfa50d72211d" "answer-21d2e471-2f9a-5c9f-a4df-7096e53f0d75"] :db/ensure [:answer-field/validate]} {:db/id "answer-16a7977b-7339-57b7-a923-e8d0d8e4ad67" :answer/id #uuid "16a7977b-7339-57b7-a923-e8d0d8e4ad67" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c6a09ee3-dc65-57fb-bc76-d9010cfcc444" :answer/id #uuid "c6a09ee3-dc65-57fb-bc76-d9010cfcc444" :answer/type :answer.type/math :answer/value "{e}^{2t}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2dcbc6a3-2212-5cc2-8998-578a7cd88408" :answer/id #uuid "2dcbc6a3-2212-5cc2-8998-578a7cd88408" :answer/type :answer.type/math :answer/value "{e}^{6t}(\\operatorname{cos}⁡t[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}])" :db/ensure [:answer/validate]} {:db/id "answer-170117e4-3734-55f1-8a0e-dfa50d72211d" :answer/id #uuid "170117e4-3734-55f1-8a0e-dfa50d72211d" :answer/type :answer.type/math :answer/value "{e}^{6t}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-21d2e471-2f9a-5c9f-a4df-7096e53f0d75" :answer/id #uuid "21d2e471-2f9a-5c9f-a4df-7096e53f0d75" :answer/type :answer.type/math :answer/value "{e}^{t}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-0f0ab548-1239-59aa-8a8e-1144624f4ff6" :question/id #uuid "0f0ab548-1239-59aa-8a8e-1144624f4ff6" :question/math-academy-id "q-333011" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}2 & -1 \\\\ 1 & 0\\end{aligned}]x(t)+[\\begin{aligned}-3{t}^{2}+4t-4 \\\\ -{t}^{2}-2t+1\\end{aligned}].\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}t+2 \\\\ t+1\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system is\n\n| $x(t)={x}_{c}(t)+\\,\\,$ |  | $1$ |  | $\\,\\,{t}^{2}+\\,\\,$ |  | {{field-1}} |  | $\\,\\,t+\\,\\,$ |  | $1$ |  | . |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} |  |  | $2$ |  |  | {{field-3}} |  |  |  |  |  |" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n[\\begin{aligned}-3{t}^{2}+4t-4 \\\\ -{t}^{2}-2t+1\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is polynomial of degree $2.$ Therefore, we assume that the particular solution is also polynomial of degree $2,$ i.e.\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{a}_{1}{t}^{2}+{b}_{1}t+{c}_{1} \\\\ {a}_{2}{t}^{2}+{b}_{2}t+{c}_{2}\\end{aligned}]=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]{t}^{2}+[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}]t+[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}],\n$$\n\nwhere ${a}_{1},{a}_{2},{b}_{1},{b}_{2},{c}_{1},{c}_{2}$ are constants that are to be determined. \n\nCalculating the derivative of ${x}_{p}$ with respect to $t$ gives\n\n$$\n{x}_{p}^{′}(t)=[\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}]=[\\begin{aligned}2{a}_{1} \\\\ 2{a}_{2}\\end{aligned}]t+[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}].\n$$\n\nTo find the unknown constants, we substitute ${x}_{p}$ and ${x}_{p}^{′}$ into our system:\n\n$$\n\\begin{aligned}[\\begin{aligned}2{a}_{1} \\\\ 2{a}_{2}\\end{aligned}]t+[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}] & =[\\begin{aligned}2 & -1 \\\\ 1 & 0\\end{aligned}]([\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]{t}^{2}+[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}]t+[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}])+[\\begin{aligned}-3{t}^{2}+4t-4 \\\\ -{t}^{2}-2t+1\\end{aligned}] \\\\ [\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}2({a}_{1}{t}^{2}+{b}_{1}t+{c}_{1})-({a}_{2}{t}^{2}+{b}_{2}t+{c}_{2}) \\\\ {a}_{1}{t}^{2}+{b}_{1}t+{c}_{1}\\end{aligned}]+[\\begin{aligned}-3{t}^{2}+4t-4 \\\\ -{t}^{2}-2t+1\\end{aligned}] \\\\ [\\begin{aligned}0{t}^{2}+2{a}_{1}t+{b}_{1} \\\\ 0{t}^{2}+2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}(2{a}_{1}-{a}_{2}-3){t}^{2}+(2{b}_{1}-{b}_{2}+4)t+(2{c}_{1}-{c}_{2}-4) \\\\ ({a}_{1}-1){t}^{2}+({b}_{1}-2)t+({c}_{1}+1)\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}2{a}_{1}-{a}_{2}-3=0 \\\\ 2{b}_{1}-{b}_{2}+4=2{a}_{1} \\\\ 2{c}_{1}-{c}_{2}-4={b}_{1} \\\\ {a}_{1}-1=0 \\\\ {b}_{1}-2=2{a}_{2} \\\\ {c}_{1}+1={b}_{2}\\end{aligned}\n$$\n\nSolving the fourth equation and then substituting the corresponding values ​​into the first and fifth equations to solve for ${a}_{2}$ and ${b}_{2},$ we get \n\n$$\n{a}_{1}=1,\\,{a}_{2}=-1,\\,{b}_{1}=0.\n$$\n\n \n\nWe substitute these into the second equation to solve for ${b}_{2},$ and then into the sixth and third equations to solve for ${c}_{1}$ and ${c}_{2}.$ We finally get\n\n$$\n{b}_{2}=2,\\,{c}_{1}=-1,\\,{c}_{2}=-2.\n$$\n\n \n\nTherefore, the particular solution is\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{t}^{2}+1 \\\\ -\\,{t}^{2}+2t-2\\end{aligned}]=[\\begin{aligned}1 \\\\ -1\\end{aligned}]{t}^{2}+[\\begin{aligned}0 \\\\ 2\\end{aligned}]t+[\\begin{aligned}1 \\\\ -2\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-87ba22fc-b228-58c2-a360-feff99b2bf89" "answer-field-72b4e588-1c2d-5b01-8c53-24f4c15496b7" "answer-field-5f30c989-de06-575e-b0bb-9f683d4312c4"] :db/ensure [:question/validate]} {:db/id "answer-field-87ba22fc-b228-58c2-a360-feff99b2bf89" :answer-field/id #uuid "87ba22fc-b228-58c2-a360-feff99b2bf89" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e3b0faf5-c52f-5e9a-a0b2-40242658a8f1" :answer-field/choices ["answer-e3b0faf5-c52f-5e9a-a0b2-40242658a8f1"] :db/ensure [:answer-field/validate]} {:db/id "answer-e3b0faf5-c52f-5e9a-a0b2-40242658a8f1" :answer/id #uuid "e3b0faf5-c52f-5e9a-a0b2-40242658a8f1" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-72b4e588-1c2d-5b01-8c53-24f4c15496b7" :answer-field/id #uuid "72b4e588-1c2d-5b01-8c53-24f4c15496b7" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4c89c95f-fe9b-52f0-91e5-40f76e3bbf32" :answer-field/choices ["answer-4c89c95f-fe9b-52f0-91e5-40f76e3bbf32"] :db/ensure [:answer-field/validate]} {:db/id "answer-4c89c95f-fe9b-52f0-91e5-40f76e3bbf32" :answer/id #uuid "4c89c95f-fe9b-52f0-91e5-40f76e3bbf32" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-field-5f30c989-de06-575e-b0bb-9f683d4312c4" :answer-field/id #uuid "5f30c989-de06-575e-b0bb-9f683d4312c4" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a0cfcb58-9d82-5239-b7a2-55b6a5aec3bc" :answer-field/choices ["answer-a0cfcb58-9d82-5239-b7a2-55b6a5aec3bc"] :db/ensure [:answer-field/validate]} {:db/id "answer-a0cfcb58-9d82-5239-b7a2-55b6a5aec3bc" :answer/id #uuid "a0cfcb58-9d82-5239-b7a2-55b6a5aec3bc" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id 17592186167170 :question/answer-fields ["answer-field-cbafc658-89fb-5435-88ef-ee424c7542b5"] :db/ensure [:question/validate]} {:db/id "answer-field-cbafc658-89fb-5435-88ef-ee424c7542b5" :answer-field/id #uuid "cbafc658-89fb-5435-88ef-ee424c7542b5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7a07a6ab-6116-592a-a4a5-15923035ed8f" :answer-field/choices ["answer-7a07a6ab-6116-592a-a4a5-15923035ed8f"] :db/ensure [:answer-field/validate]} {:db/id "answer-7a07a6ab-6116-592a-a4a5-15923035ed8f" :answer/id #uuid "7a07a6ab-6116-592a-a4a5-15923035ed8f" :answer/type :answer.type/math :answer/value "e^{-2t}" :db/ensure [:answer/validate]} {:db/id "question-ce5740c3-890f-53a3-a4fc-da96721e3367" :question/id #uuid "ce5740c3-890f-53a3-a4fc-da96721e3367" :question/math-academy-id "q-333598" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}]x(t)+{e}^{-2t}[\\begin{aligned}-2 \\\\ -1\\end{aligned}],\\,x(0)=[\\begin{aligned}0 \\\\ 3\\end{aligned}]\n$$\n\nFind the missing coefficients in the solution to the initial value problem, shown above.\n\n$x(t)=$ \n{{field-1}} \n$\\,\\cdot \\,[\\begin{aligned}\\operatorname{cos}⁡(t) \\\\ \\operatorname{sin}⁡(t)\\end{aligned}]\\,+$\n{{field-2}}\n$\\cdot \\,[\\begin{aligned}-\\operatorname{sin}⁡(t) \\\\ \\operatorname{cos}⁡(t)\\end{aligned}]+{e}^{-2t}[\\begin{aligned}1 \\\\ 0\\end{aligned}].$" :question/worked-solution "We are told that the general solution to the system is \n\n$$\nx(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(t) \\\\ \\operatorname{sin}⁡(t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡(t) \\\\ \\operatorname{cos}⁡(t)\\end{aligned}]+{e}^{-2t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]\n$$\n\nwhere ${c}_{1},{c}_{2}$ are constants that are to be determined. \n\nNext, we find the values of ${c}_{1}$ and ${c}_{2}.$ Substituting $t=0$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}0 \\\\ 3\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(0) \\\\ \\operatorname{sin}⁡(0)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡(0) \\\\ \\operatorname{cos}⁡(0)\\end{aligned}]+{e}^{-2(0)}[\\begin{aligned}1 \\\\ 0\\end{aligned}] & =[\\begin{aligned}0 \\\\ 3\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ 0\\end{aligned}] & =[\\begin{aligned}0 \\\\ 3\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1}+1 \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}0 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the following system of linear equations:\n\n$$\n{\\begin{aligned}{c}_{1}+1=0 \\\\ {c}_{2}=3\\end{aligned}\n$$\n\nFrom the first equation, we get ${c}_{1}=-1.$ From the second equation, we have ${c}_{2}=3.$\n\nTherefore, the solution to the initial value problem is\n\n$$\nx(t)=-1\\cdot [\\begin{aligned}\\operatorname{cos}⁡(t) \\\\ \\operatorname{sin}⁡(t)\\end{aligned}]+3\\cdot [\\begin{aligned}-\\operatorname{sin}⁡(t) \\\\ \\operatorname{cos}⁡(t)\\end{aligned}]+{e}^{-2t}[\\begin{aligned}1 \\\\ 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-df03ac19-6bd9-50d7-a0ee-f66f953a1cb7" "answer-field-d93e48ac-47f0-59b3-bbaa-20638c969b46"] :db/ensure [:question/validate]} {:db/id "answer-field-df03ac19-6bd9-50d7-a0ee-f66f953a1cb7" :answer-field/id #uuid "df03ac19-6bd9-50d7-a0ee-f66f953a1cb7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f8d395c6-8c48-538a-b062-6538d7844474" :answer-field/choices ["answer-f8d395c6-8c48-538a-b062-6538d7844474"] :db/ensure [:answer-field/validate]} {:db/id "answer-f8d395c6-8c48-538a-b062-6538d7844474" :answer/id #uuid "f8d395c6-8c48-538a-b062-6538d7844474" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-field-d93e48ac-47f0-59b3-bbaa-20638c969b46" :answer-field/id #uuid "d93e48ac-47f0-59b3-bbaa-20638c969b46" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f74c8cb3-72be-50db-b9a1-4c8438217f44" :answer-field/choices ["answer-f74c8cb3-72be-50db-b9a1-4c8438217f44"] :db/ensure [:answer-field/validate]} {:db/id "answer-f74c8cb3-72be-50db-b9a1-4c8438217f44" :answer/id #uuid "f74c8cb3-72be-50db-b9a1-4c8438217f44" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-0c85ab3b-11e0-5a86-bc49-d13f4a9dbbcf" :question/id #uuid "0c85ab3b-11e0-5a86-bc49-d13f4a9dbbcf" :question/math-academy-id "q-333597" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}-1 & 1 \\\\ 0 & -1\\end{aligned}]x(t)+{e}^{2t}[\\begin{aligned}3 \\\\ 0\\end{aligned}],\\,x(0)=[\\begin{aligned}2 \\\\ 1\\end{aligned}]\n$$\n\nFind the missing coefficients in the solution to the initial value problem, shown above.\n\n$x(t)=$ \n{{field-1}} \n$\\,\\cdot \\,[\\begin{aligned}{e}^{-t} \\\\ 0\\end{aligned}]\\,+$\n{{field-2}}\n$\\,\\cdot \\,[\\begin{aligned}t{e}^{-t} \\\\ {e}^{-t}\\end{aligned}]+{e}^{2t}[\\begin{aligned}1 \\\\ 0\\end{aligned}].$" :question/worked-solution "We are told that the general solution to the system is \n\n$$\nx(t)={c}_{1}[\\begin{aligned}{e}^{-t} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}t{e}^{-t} \\\\ {e}^{-t}\\end{aligned}]+{e}^{2t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]\n$$\n\nwhere ${c}_{1},{c}_{2}$ are constants that are to be determined. \n\nNext, we find the values of ${c}_{1}$ and ${c}_{2}.$ Substituting $t=0$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}2 \\\\ 1\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}{e}^{-0} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0\\cdot {e}^{-0} \\\\ {e}^{-0}\\end{aligned}]+{e}^{2(0)}[\\begin{aligned}1 \\\\ 0\\end{aligned}] & =[\\begin{aligned}2 \\\\ 1\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ 0\\end{aligned}] & =[\\begin{aligned}2 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1}+1 \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}2 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the following system of linear equations:\n\n$$\n{\\begin{aligned}{c}_{1}+1=2 \\\\ {c}_{2}=1\\end{aligned}\n$$\n\nFrom the first equation, we get ${c}_{1}=1.$ From the second equation, we have ${c}_{2}=1.$\n\nTherefore, the solution to the initial value problem is\n\n$$\nx(t)=1\\cdot [\\begin{aligned}{e}^{-t} \\\\ 0\\end{aligned}]+1\\cdot [\\begin{aligned}t{e}^{-t} \\\\ {e}^{-t}\\end{aligned}]+{e}^{2t}[\\begin{aligned}1 \\\\ 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-71c3612b-4848-5a0c-a5e0-a4bbde9f6c2a" "answer-field-4134811a-7ec3-549d-b357-acbd0a8d70e0"] :db/ensure [:question/validate]} {:db/id "answer-field-71c3612b-4848-5a0c-a5e0-a4bbde9f6c2a" :answer-field/id #uuid "71c3612b-4848-5a0c-a5e0-a4bbde9f6c2a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-95ac22ea-edd7-52da-8646-d434dc74fca0" :answer-field/choices ["answer-95ac22ea-edd7-52da-8646-d434dc74fca0"] :db/ensure [:answer-field/validate]} {:db/id "answer-95ac22ea-edd7-52da-8646-d434dc74fca0" :answer/id #uuid "95ac22ea-edd7-52da-8646-d434dc74fca0" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-4134811a-7ec3-549d-b357-acbd0a8d70e0" :answer-field/id #uuid "4134811a-7ec3-549d-b357-acbd0a8d70e0" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-315e3e29-12dd-5d3c-8d68-6a195f6d8f65" :answer-field/choices ["answer-315e3e29-12dd-5d3c-8d68-6a195f6d8f65"] :db/ensure [:answer-field/validate]} {:db/id "answer-315e3e29-12dd-5d3c-8d68-6a195f6d8f65" :answer/id #uuid "315e3e29-12dd-5d3c-8d68-6a195f6d8f65" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id 17592186167990 :tutorial/content "Consider an **inhomogeneous** linear system of ordinary differential equations in component form:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)={a}_{11}{x}_{1}(t)+{a}_{12}{x}_{2}(t)+{f}_{1}(t) \\\\ {x}_{2}^{′}(t)={a}_{21}{x}_{1}(t)+{a}_{22}{x}_{2}(t)+{f}_{2}(t)\\end{aligned}\n$$\n\nHere, we can package the unknown functions into vectors\n![](images/03/037289f6f3a779d750cef23dc18d149786604bd477565e3708d6470f2e3c2f7a.svg)\n\nThen, the system can be written as\n![](images/77/77fc846681e1f0a98675b06f962e42f4491fd07d9bb2eab291e69cd49e4dd5f9.svg)\n\nOften, the **forcing functions** $f_1(t), f_2(t)$ are linear combinations of a few basic functions (such as $e^{3t},$ $t^2,$ or $\\sin t$).\nIn that case, it is useful to write $\\mathbf{g}(t)$ as a sum of those basic functions times constant vectors.\n\nFor example, let's write down the system of linear ODEs below in matrix form.\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=4{x}_{1}(t)+2{x}_{2}(t)+8{e}^{3t} \\\\ {x}_{2}^{′}(t)=-3{x}_{1}(t)+5{x}_{2}(t)+10{e}^{4t}\\end{aligned}\n$$\n\nFirst, let's rewrite our system, highlighting the coefficients:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=4\\cdot {x}_{1}(t)+2\\cdot {x}_{2}(t)+{e}^{3t}\\cdot 8+{e}^{4t}\\cdot 0 \\\\ {x}_{2}^{′}(t)=(-3)\\cdot {x}_{1}(t)+5\\cdot {x}_{2}(t)+{e}^{3t}\\cdot 0+{e}^{4t}\\cdot 10\\end{aligned}\n$$\n\nNow, we can write the system in matrix form:\n![](images/47/47fb751641455ab4cf85756166fa8811bd8fe3ddc6bcb6005c8e6be8c31b6fe1.svg)\nwhere ![](images/f4/f47e1272123fb8f4a5f54931929b9492f54e9d78d590b2ee28394bf29976ce44.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186168018 :tutorial/content "Recall that an inhomogeneous linear system has the form\n\n$$\n\\mathbf{x}'(t)=A\\mathbf{x}(t)+\\mathbf{g}(t),\n$$\n\nwhere $A$ is a constant matrix and $\\mathbf{g}(t)$ is a known forcing term. The associated *homogeneous* system is\n\n$$\n\\mathbf{x}'(t)=A\\mathbf{x}(t).\n$$\n\nA *general solution* of the *homogeneous* system is called the **complementary solution** and is denoted by $\\mathbf{x}_c(t)$.\nA **particular solution** is any single function $\\mathbf{x}_p(t)$ that satisfies the full inhomogeneous system.\n\nThese two pieces combine to give the *general solution* of the inhomogeneous system:\n\n$$\n\\mathbf{x}(t)=\\mathbf{x}_c(t)+\\mathbf{x}_p(t)\n$$\n\nIndeed, notice that\n\n$$\n\\begin{aligned}({x}_{c}+{x}_{p})^{′} & ={x}_{c}^{′}+{x}_{p}^{′} \\\\  & =(A{x}_{c})+(A{x}_{p}+g(t)) \\\\  & =A{x}_{c}+A{x}_{p}+g(t) \\\\  & =A({x}_{c}+{x}_{p})+g(t).\\end{aligned}\n$$\n\nSince $(\\mathbf{x}_c+\\mathbf{x}_p)' = A(\\mathbf{x}_c+\\mathbf{x}_p)+\\mathbf{g}(t)$, the sum is a solution of the inhomogeneous system.\n\nNotice that it doesn't matter which particular solution we take.\nSuppose we found two different particular solutions, $\\mathbf{x}_p(t)$ and $\\mathbf{y}_p(t).$ Let's examine their difference, $\\mathbf{w}(t) = \\mathbf{y}_p(t) - \\mathbf{x}_p(t)$.\n\nBy definition, we know that $\\mathbf{y}_p' = A\\mathbf{y}_p + \\mathbf{g}(t)$ and $\\mathbf{x}_p' = A\\mathbf{x}_p + \\mathbf{g}(t).$\nNow, let's find the derivative of the difference $\\mathbf{w}(t)$:\n\n$$\n\\begin{aligned}{w}^{′} & =({y}_{p}-{x}_{p})^{′} \\\\  & ={y}_{p}^{′}-{x}_{p}^{′} \\\\  & =(A{y}_{p}+g(t))-(A{x}_{p}+g(t)) \\\\  & =A{y}_{p}-A{x}_{p} \\\\  & =A({y}_{p}-{x}_{p}) \\\\  & =Aw\\end{aligned}\n$$\n\nThe result $\\mathbf{w}' = A\\mathbf{w}$ means that the difference between any two particular solutions is itself a solution to the *homogeneous* system.\n\nThis is why *any* particular solution is enough. Any other particular solution can be written as\n\n$$\n\\mathbf{y}_{p} = \\underbrace{(\\mathbf{y}_{p}-\\mathbf{x}_{p})}_{\\text{homogeneous}} \\:\\:\\: + \\underbrace{\\mathbf{x}_{p}}_{\\text{particular}} \\!\\!\\!\\!\\!.\n$$\n\nThe \"variety\" among particular solutions is already captured by the complementary solution $\\mathbf{x}_c(t)$." :db/ensure [:tutorial/validate]} {:db/id 17592186166987 :activity/expected-seconds 1320.0 :db/ensure [:activity/validate]}]
