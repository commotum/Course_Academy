#{[{:db/id #edb/ref 17592186243953 :knowledge-point/_questions [{:db/id #edb/ref 17592186119793 :knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2" :knowledge-point/title "Finding the LU Factorization of a Singular 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27a35bec-f769-5040-8918-554a7697cbed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186241523} {:answer/id #uuid "36cc640e-8f40-5e5c-98c3-85377385c418" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186241661} {:answer/id #uuid "5f1a9178-bb17-5d00-8b31-ca199e678655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186242035} {:answer/id #uuid "71edcb95-1b5d-5373-9c02-94ff15d39ff8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186242191} {:answer/id #uuid "ea1fd436-d401-5a2d-823f-4992d3c757fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186243253}] :answer-field/correct {:answer/id #uuid "27a35bec-f769-5040-8918-554a7697cbed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186241523} :answer-field/id #uuid "120d4359-9756-5178-aa7e-7692dc580a6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243468}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "096e63c0-3ec3-55a0-bdd9-795c7447a69e" :question/math-academy-id "q-106773" :question/problem "Given that\n$A=\\begin{bmatrix}3 & -6 \\\\ -2 & 4\\end{bmatrix}$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & -6 \\\\ -2 & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(\\frac{2}{3}){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ \\frac{2}{3} & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}3 & -6 \\\\ 0 & 0\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ \\frac{2}{3} & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ -\\frac{2}{3} & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}3 & -6 \\\\ 0 & 0\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-\\frac{2}{3},$ ${u}_{22}=0,$ and ${l}_{21}+{u}_{22}=-\\frac{2}{3}.$"}] [{:db/id #edb/ref 17592186441352 :knowledge-point/_questions [{:db/id #edb/ref 17592186119793 :knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2" :knowledge-point/title "Finding the LU Factorization of a Singular 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fb42e2c-aa24-5f95-88b6-df41338ccd5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186441322} {:answer/id #uuid "91f3cfba-511f-5a32-b5ed-37b88de9cce4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186441337} {:answer/id #uuid "94171c94-68a7-5ef2-aaba-7694ee1ad0d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186441338} {:answer/id #uuid "c55e82fd-3868-524e-a176-4ae0eb02d2d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186441343} {:answer/id #uuid "ef91d311-f5cd-5c1f-8b87-7a75202de12a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186441346}] :answer-field/correct {:answer/id #uuid "c55e82fd-3868-524e-a176-4ae0eb02d2d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186441343} :answer-field/id #uuid "29b866c9-e8f1-5844-9f9f-7ff1d2ebf13b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186441347}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "07a8a0f6-ff41-525d-a016-8184036d8c7d" :question/math-academy-id "q-32619" :question/problem "Given that $A=\\begin{bmatrix}2 & -3 \\\\ 8 & -12\\end{bmatrix}$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & -3 \\\\ 8 & -12\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}2 & -3 \\\\ 0 & 0\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}2 & -3 \\\\ 0 & 0\\end{bmatrix}}_{⏟}}_{U}.\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=4,{u}_{22}=0,$ and ${l}_{21}+{u}_{22}=4.$"}]}
