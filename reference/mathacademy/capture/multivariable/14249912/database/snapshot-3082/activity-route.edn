#{[{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186570059} :activity/id #uuid "7e7b3945-b13b-524d-bb5e-443bd4f3906c" :activity/scope {:db/id #edb/ref 17592186048743 :topic/id #uuid "ba8c9515-59e3-55c9-9d86-1de6e55c5474" :topic/math-academy-id 1779} :activity/steps [{:db/id #edb/ref 17592186570049 :step/content {:db/id #edb/ref 17592186243953 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27a35bec-f769-5040-8918-554a7697cbed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186241523} {:answer/id #uuid "36cc640e-8f40-5e5c-98c3-85377385c418" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186241661} {:answer/id #uuid "5f1a9178-bb17-5d00-8b31-ca199e678655" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186242035} {:answer/id #uuid "71edcb95-1b5d-5373-9c02-94ff15d39ff8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186242191} {:answer/id #uuid "ea1fd436-d401-5a2d-823f-4992d3c757fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186243253}] :answer-field/correct {:db/id #edb/ref 17592186241523} :answer-field/id #uuid "120d4359-9756-5178-aa7e-7692dc580a6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243468}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "096e63c0-3ec3-55a0-bdd9-795c7447a69e" :question/math-academy-id "q-106773" :question/problem "Given that\n$A=\\begin{bmatrix}3 & -6 \\\\ -2 & 4\\end{bmatrix}$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & -6 \\\\ -2 & 4\\end{bmatrix} & {R}_{2} & :={R}_{2}+(\\frac{2}{3}){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ \\frac{2}{3} & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}3 & -6 \\\\ 0 & 0\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ \\frac{2}{3} & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ -\\frac{2}{3} & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}3 & -6 \\\\ 0 & 0\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-\\frac{2}{3},$ ${u}_{22}=0,$ and ${l}_{21}+{u}_{22}=-\\frac{2}{3}.$"} :step/id #uuid "2d5dc701-7f02-5cf5-aa72-c784e2a85c45"} {:db/id #edb/ref 17592186570059 :step/content {:db/id #edb/ref 17592186570009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17429e2c-6a7d-5799-9f99-11411731d372" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569478} {:answer/id #uuid "3cbd73d2-cd1b-5b1f-b775-9c124c82a91b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-5 & 0 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569526} {:answer/id #uuid "4d58d8e8-ebbf-5227-901f-b377591464ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569550} {:answer/id #uuid "9a8638fd-45d4-525e-afd5-446d9bab6953" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569689} {:answer/id #uuid "dcdfcc6c-043a-5b9e-8a4c-0bfab8faa665" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569793}] :answer-field/correct {:db/id #edb/ref 17592186569550} :answer-field/id #uuid "808d2fc9-2e7f-5ef1-86ff-cfcf9e8e2abc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569892}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "903883c2-c07e-50f2-a202-1c38e08cadfc" :question/math-academy-id "q-32550" :question/problem "Given that \n$A=\\begin{bmatrix}1 & -2 \\\\ -5 & 6\\end{bmatrix}$ has the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & -2 \\\\ -5 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+5{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ 5 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & -2 \\\\ 0 & -4\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ 5 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & -2 \\\\ 0 & -4\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$"} :step/id #uuid "550cd94b-764b-5740-b184-608518b10bda" :step/next {:db/id #edb/ref 17592186570097}} {:db/id #edb/ref 17592186570072 :step/content {:db/id #edb/ref 17592186569998 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60d81581-c221-5494-a432-08d979f7a43d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ \\frac{4}{3} & 1\\end{bmatrix}" :db/id #edb/ref 17592186569593} {:answer/id #uuid "7ca3072c-d6ac-5918-a623-20411f8b7700" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-\\frac{4}{3} & 0 \\\\ 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569647} {:answer/id #uuid "acfff4be-1f46-5b1f-a60f-b1bb756a3b25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186569714} {:answer/id #uuid "fb15c2de-88fd-5d61-a019-1eb95f578d9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -\\frac{4}{3} & 1\\end{bmatrix}" :db/id #edb/ref 17592186569838} {:answer/id #uuid "fba3dcfb-a5b2-547c-8691-6e722e502046" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -\\frac{4}{5} & 1\\end{bmatrix}" :db/id #edb/ref 17592186569841}] :answer-field/correct {:db/id #edb/ref 17592186569838} :answer-field/id #uuid "8e1d1148-bcd2-52a8-8f81-b71b67b2ffca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569897}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "66c0358e-dcf2-5965-acb4-eb43f1da9799" :question/math-academy-id "q-74951" :question/problem "Given that\n$A=\\begin{bmatrix}3 & 2 \\\\ -4 & -3\\end{bmatrix}.$ \nhas the LU decomposition $A=LU$, then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & 2 \\\\ -4 & -3\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{4}{3}{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ \\frac{4}{3} & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}3 & 2 \\\\ 0 & -\\frac{1}{3}\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ \\frac{4}{3} & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ -\\frac{4}{3} & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}3 & 2 \\\\ 0 & -\\frac{1}{3}\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$"} :step/id #uuid "78231fa2-4b10-52a3-bb4c-c616d57e3250" :step/next {:db/id #edb/ref 17592186570077}} {:db/id #edb/ref 17592186570077 :step/content {:db/id #edb/ref 17592186569965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3286434a-593f-5cc4-acfc-6bb0f2812c00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569516} {:answer/id #uuid "4c6682e2-223f-5551-9555-606e0dc281da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 6 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569547} {:answer/id #uuid "7cb0dc58-f354-538c-8aef-2413ca8d7f9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569648} {:answer/id #uuid "97984476-2d2e-53cd-84f2-a709077ec7d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 8 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569683} {:answer/id #uuid "dd2156fb-e1ff-51c3-b81e-f5cafa615c40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -6 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569795}] :answer-field/correct {:db/id #edb/ref 17592186569683} :answer-field/id #uuid "c9382a07-3a03-5be2-b528-235df29742b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186569925}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "14def4d3-3d45-5610-862f-8d4c651f0955" :question/math-academy-id "q-106760" :question/problem "Given that \n$A=\\begin{bmatrix}-2 & 1 \\\\ -16 & 10\\end{bmatrix}$ \nhas the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-2 & 1 \\\\ -16 & 10\\end{bmatrix} & \\,{R}_{2} & :={R}_{2}+(-8){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}-2 & 1 \\\\ 0 & 2\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ 8 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-2 & 1 \\\\ 0 & 2\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$"} :step/id #uuid "a7d59289-a5d2-5908-885c-53ddeb4fe3b2" :step/next {:db/id #edb/ref 17592186570049}} {:db/id #edb/ref 17592186570097 :step/content {:db/id #edb/ref 17592186441352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fb42e2c-aa24-5f95-88b6-df41338ccd5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186441322} {:answer/id #uuid "91f3cfba-511f-5a32-b5ed-37b88de9cce4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186441337} {:answer/id #uuid "94171c94-68a7-5ef2-aaba-7694ee1ad0d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186441338} {:answer/id #uuid "c55e82fd-3868-524e-a176-4ae0eb02d2d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186441343} {:answer/id #uuid "ef91d311-f5cd-5c1f-8b87-7a75202de12a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186441346}] :answer-field/correct {:db/id #edb/ref 17592186441343} :answer-field/id #uuid "29b866c9-e8f1-5844-9f9f-7ff1d2ebf13b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186441347}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "07a8a0f6-ff41-525d-a016-8184036d8c7d" :question/math-academy-id "q-32619" :question/problem "Given that $A=\\begin{bmatrix}2 & -3 \\\\ 8 & -12\\end{bmatrix}$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & -3 \\\\ 8 & -12\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}2 & -3 \\\\ 0 & 0\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ -4 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ 4 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}2 & -3 \\\\ 0 & 0\\end{bmatrix}}_{⏟}}_{U}.\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=4,{u}_{22}=0,$ and ${l}_{21}+{u}_{22}=4.$"} :step/id #uuid "f067e383-13d1-56cf-b15c-57221a677688" :step/next {:db/id #edb/ref 17592186570072}}] :activity/title "LU Factorization of 2x2 Matrices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186569439}]}
