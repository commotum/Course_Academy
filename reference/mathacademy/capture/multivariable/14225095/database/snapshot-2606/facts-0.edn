f 1077 "field-1" #edb/ref 17592186045417] [17592186542094 #edb/ref 1078 #edb/ref 17592186541433 #edb/ref 17592186045417] [17592186542094 #edb/ref 1079 #uuid "f31d3a56-b5c5-51c7-b967-a906c3bde3cf" #edb/ref 17592186045417] [17592186542103 #edb/ref 1075 #edb/ref 17592186541430 #edb/ref 17592186045417] [17592186542103 #edb/ref 1075 #edb/ref 17592186541623 #edb/ref 17592186045417] [17592186542103 #edb/ref 1075 #edb/ref 17592186541699 #edb/ref 17592186045417] [17592186542103 #edb/ref 1075 #edb/ref 17592186541843 #edb/ref 17592186045417] [17592186542103 #edb/ref 1075 #edb/ref 17592186541916 #edb/ref 17592186045417] [17592186542103 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186542103 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186542103 #edb/ref 1078 #edb/ref 17592186541916 #edb/ref 17592186045417] [17592186542103 #edb/ref 1079 #uuid "fa2a0e8c-7f88-5fbd-86b3-0d022972fd45" #edb/ref 17592186045417] [17592186542115 #edb/ref 1068 #edb/ref 17592186542079 #edb/ref 17592186045417] [17592186542115 #edb/ref 1069 "q-141252" #edb/ref 17592186045417] [17592186542115 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186542115 #edb/ref 1071 "Find the equation of the tangent line to the polar curve $r=\\operatorname{sin}⁡(3\\theta )$ at $\\theta =\\frac{\\pi }{6},$ given that \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3\\operatorname{sin}⁡(\\theta )\\operatorname{cos}⁡(3\\theta )+\\operatorname{cos}⁡(\\theta )\\operatorname{sin}⁡(3\\theta )}{3\\operatorname{cos}⁡(\\theta )\\operatorname{cos}⁡(3\\theta )-\\operatorname{sin}⁡(\\theta )\\operatorname{sin}⁡(3\\theta )}.\n$$" #edb/ref 17592186045417] [17592186542115 #edb/ref 1072 #uuid "0c69e568-3aa6-590d-a547-523c7522fc27" #edb/ref 17592186045417] [17592186542115 #edb/ref 1074 "To find the equation of the tangent line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\frac{\\text{d}y}{\\text{d}x}:$\n\nIn this case, we're given that\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3\\operatorname{sin}⁡(\\theta )\\operatorname{cos}⁡(3\\theta )+\\operatorname{cos}⁡(\\theta )\\operatorname{sin}⁡(3\\theta )}{3\\operatorname{cos}⁡(\\theta )\\operatorname{cos}⁡(3\\theta )-\\operatorname{sin}⁡(\\theta )\\operatorname{sin}⁡(3\\theta )}.\n$$\n\n**Step 2**: Find the slope of the tangent at $P:$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /6} \\\\  & =\\frac{3\\operatorname{sin}⁡(\\theta )\\operatorname{cos}⁡(3\\theta )+\\operatorname{cos}⁡(\\theta )\\operatorname{sin}⁡(3\\theta )}{3\\operatorname{cos}⁡(\\theta )\\operatorname{cos}⁡(3\\theta )-\\operatorname{sin}⁡(\\theta )\\operatorname{sin}⁡(3\\theta )} \\\\  & =\\frac{[3\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(3\\cdot \\frac{\\pi }{6})+\\operatorname{cos}⁡(\\frac{\\pi }{6})\\operatorname{sin}⁡(3\\cdot \\frac{\\pi }{6})]}{[3\\operatorname{cos}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(3\\cdot \\frac{\\pi }{6})-\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{sin}⁡(3\\cdot \\frac{\\pi }{6})]} \\\\  & =\\frac{[3\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\operatorname{cos}⁡(\\frac{\\pi }{6})\\operatorname{sin}⁡(\\frac{\\pi }{2})]}{[3\\operatorname{cos}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{sin}⁡(\\frac{\\pi }{2})]} \\\\  & =\\frac{(3\\cdot \\frac{1}{2}\\cdot 0+\\frac{\\sqrt{3}}{2}\\cdot 1)}{(3\\cdot \\frac{\\sqrt{3}}{2}\\cdot 0-\\frac{1}{2}\\cdot 1)} \\\\  & =\\frac{(\\frac{\\sqrt{3}}{2})}{(-\\frac{1}{2})} \\\\  & =-\\sqrt{3}.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P:$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(3\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(3\\cdot \\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{2})\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{\\sqrt{3}}{2} \\\\ {y}_{1} & =\\operatorname{sin}⁡(3\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(3\\cdot \\frac{\\pi }{6})\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{2})\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(\\frac{\\sqrt{3}}{2},\\frac{1}{2}).$ \n\n**Step 4**: Using point-slope form, find the equation of the tangent:\n\nWe find the equation of the tangent as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-\\frac{1}{2} & =-\\sqrt{3}\\cdot (x-\\frac{\\sqrt{3}}{2}) \\\\ y-\\frac{1}{2} & =-\\sqrt{3}\\,x+\\frac{3}{2} \\\\ y & =-\\sqrt{3}x+2\\end{aligned}\n$$\n\n![](images/10/1018201037350f6bd231a384219d03c03fc1e2165a088e158c9ba2b2bfbb1022.png)" #edb/ref 17592186045417] [17592186542143 #edb/ref 1068 #edb/ref 17592186542085 #edb/ref 17592186045417] [17592186542143 #edb/ref 1069 "q-141356" #edb/ref 17592186045417] [17592186542143 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186542143 #edb/ref 1071 "Find the equation of the **normal** line to the polar curve $r={\\theta }^{2}$ at $\\theta =\\frac{3\\pi }{2},$ given that \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{2\\operatorname{sin}⁡\\theta +\\theta \\operatorname{cos}⁡\\theta }{2\\operatorname{cos}⁡\\theta -\\theta \\operatorname{sin}⁡\\theta }.\n$$" #edb/ref 17592186045417] [17592186542143 #edb/ref 1072 #uuid "4b160342-1c9b-5cb6-9f7b-8bf55c5af2c6" #edb/ref 17592186045417] [17592186542143 #edb/ref 1074 "To find the equation of the normal line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\frac{\\text{d}y}{\\text{d}x}:$\n\nIn this case, we're given that\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{2\\operatorname{sin}⁡\\theta +\\theta \\operatorname{cos}⁡\\theta }{2\\operatorname{cos}⁡\\theta -\\theta \\operatorname{sin}⁡\\theta }.\n$$\n\n**Step 2**: Find the slope of the tangent at $P:$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =3\\pi /2} \\\\  & =\\frac{(2\\operatorname{sin}⁡(\\frac{3\\pi }{2})+\\frac{3\\pi }{2}\\operatorname{cos}⁡(\\frac{3\\pi }{2}))}{(2\\operatorname{cos}⁡(\\frac{3\\pi }{2})-\\frac{3\\pi }{2}\\operatorname{sin}⁡(\\frac{3\\pi }{2}))} \\\\  & =\\frac{2\\cdot (-1)+\\frac{3\\pi }{2}\\cdot 0}{(2\\cdot 0-\\frac{3\\pi }{2}\\cdot (-1))} \\\\  & =\\frac{-2}{(\\frac{3\\pi }{2})} \\\\  & =-\\frac{4}{3\\pi }.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P:$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & ={\\theta }^{2}\\operatorname{cos}⁡\\theta  \\\\  & ={(\\frac{3\\pi }{2})}^{2}\\operatorname{cos}⁡(\\frac{3\\pi }{2}) \\\\  & ={(\\frac{3\\pi }{2})}^{2}\\cdot 0 \\\\  & =0 \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & ={\\theta }^{2}\\operatorname{sin}⁡\\theta  \\\\  & ={(\\frac{3\\pi }{2})}^{2}\\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & ={(\\frac{3\\pi }{2})}^{2}\\cdot (-1) \\\\  & =-\\frac{9{\\pi }^{2}}{4}\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(0,-\\frac{9{\\pi }^{2}}{4}).$\n\n**Step 4**: Using point-slope form, find the equation of the normal:\n\nWe find the equation of the normal as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =-\\frac{1}{m}(x-{x}_{1}) \\\\ y-(-\\frac{9{\\pi }^{2}}{4}) & =\\frac{3\\pi }{4}\\cdot (x-0) \\\\ y+\\frac{9{\\pi }^{2}}{4} & =\\frac{3\\pi }{4}\\,x \\\\ y & =\\frac{3\\pi }{4}x-\\frac{9{\\pi }^{2}}{4}\\end{aligned}\n$$\n\n![](images/8f/8f39669eaedc42a26d28d96f6dbb961080816e7fadd182b79a260c8de27b3d1a.png)" #edb/ref 17592186045417] [17592186542144 #edb/ref 1068 #edb/ref 17592186542041 #edb/ref 17592186045417] [17592186542144 #edb/ref 1068 #edb/ref 17592186542058 #edb/ref 17592186045417] [17592186542144 #edb/ref 1069 "q-