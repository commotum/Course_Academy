b/ref 17592186046927 #edb/ref 17592186045417] [17592186046645 #edb/ref 1005 #edb/ref 17592186046951 #edb/ref 17592186045417] [17592186046645 #edb/ref 1005 #edb/ref 17592186046984 #edb/ref 17592186045417] [17592186046645 #edb/ref 1007 "Calculus II" #edb/ref 17592186045417] [17592186046645 #edb/ref 1008 "Our Calculus II course builds upon the differential calculus covered in Calculus I , providing in-depth coverage of integral calculus including integration techniques, applications of integration. Advanced topics such as series convergence tests, Taylor series, calculus with parametric and polar equations, and introductory differential equations are also covered. This comprehensive course will prepare students for further studies in advanced mathematics, engineering, statistics, machine learning, and other fields requiring a solid foundation in integral calculus." #edb/ref 17592186045417] [17592186046645 #edb/ref 1009 "Further your understanding of calculus: master advanced integration techniques, model real-world situations using differential equations, and more." #edb/ref 17592186045417] [17592186046645 #edb/ref 1012 106 #edb/ref 17592186045417] [17592186046645 #edb/ref 1013 "CA2" #edb/ref 17592186045417] [17592186046645 #edb/ref 1014 #uuid "4965f9cc-fd21-5d50-b441-6e80983b17dd" #edb/ref 17592186045417] [17592186049327 #edb/ref 1028 #edb/ref 17592186184177 #edb/ref 17592186045417] [17592186049327 #edb/ref 1028 #edb/ref 17592186184215 #edb/ref 17592186045417] [17592186049327 #edb/ref 1031 "Tangent and Normal Lines to Polar Curves" #edb/ref 17592186045417] [17592186049327 #edb/ref 1033 3834 #edb/ref 17592186045417] [17592186049327 #edb/ref 1035 #uuid "ec1d59b5-66a8-5507-9862-10567e3ce6ab" #edb/ref 17592186045417] [17592186050162 #edb/ref 1027 #edb/ref 17592186049327 #edb/ref 17592186045417] [17592186050162 #edb/ref 1028 #edb/ref 17592186083244 #edb/ref 17592186045417] [17592186050162 #edb/ref 1028 #edb/ref 17592186083245 #edb/ref 17592186045417] [17592186050162 #edb/ref 1028 #edb/ref 17592186083278 #edb/ref 17592186045417] [17592186050162 #edb/ref 1028 #edb/ref 17592186083280 #edb/ref 17592186045417] [17592186050162 #edb/ref 1029 #edb/ref 17592186429627 #edb/ref 17592186045436] [17592186050162 #edb/ref 1029 #edb/ref 17592186429628 #edb/ref 17592186045436] [17592186050162 #edb/ref 1031 "Calculating Tangent and Normal Lines with Parametric Equations" #edb/ref 17592186045417] [17592186050162 #edb/ref 1033 799 #edb/ref 17592186045417] [17592186050162 #edb/ref 1034 1.2723178487469127 #edb/ref 17592186045436] [17592186050162 #edb/ref 1035 #uuid "3308e65f-61fe-550b-8dc0-4e4a4925cb49" #edb/ref 17592186045417] [17592186050277 #edb/ref 1027 #edb/ref 17592186048273 #edb/ref 17592186045417] [17592186050277 #edb/ref 1027 #edb/ref 17592186049327 #edb/ref 17592186045417] [17592186050277 #edb/ref 1027 #edb/ref 17592186049835 #edb/ref 17592186045417] [17592186050277 #edb/ref 1028 #edb/ref 17592186092236 #edb/ref 17592186045417] [17592186050277 #edb/ref 1028 #edb/ref 17592186092310 #edb/ref 17592186045417] [17592186050277 #edb/ref 1028 #edb/ref 17592186092311 #edb/ref 17592186045417] [17592186050277 #edb/ref 1028 #edb/ref 17592186092313 #edb/ref 17592186045417] [17592186050277 #edb/ref 1029 #edb/ref 17592186429742 #edb/ref 17592186045436] [17592186050277 #edb/ref 1029 #edb/ref 17592186429743 #edb/ref 17592186045436] [17592186050277 #edb/ref 1031 "Differentiating Curves Given in Polar Form" #edb/ref 17592186045417] [17592186050277 #edb/ref 1033 998 #edb/ref 17592186045417] [17592186050277 #edb/ref 1034 1.1128457495949047 #edb/ref 17592186045436] [17592186050277 #edb/ref 1035 #uuid "3c176860-3fcd-5563-b4a1-3988f6ed1c93" #edb/ref 17592186045417] [17592186180799 #edb/ref 1075 #edb/ref 17592186541480 #edb/ref 17592186045417] [17592186180799 #edb/ref 1075 #edb/ref 17592186541636 #edb/ref 17592186045417] [17592186180799 #edb/ref 1075 #edb/ref 17592186541686 #edb/ref 17592186045417] [17592186180799 #edb/ref 1075 #edb/ref 17592186541734 #edb/ref 17592186045417] [17592186180799 #edb/ref 1075 #edb/ref 17592186541841 #edb/ref 17592186045417] [17592186180799 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186180799 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186180799 #edb/ref 1078 #edb/ref 17592186541636 #edb/ref 17592186045417] [17592186180799 #edb/ref 1079 #uuid "f400af5e-45e9-590f-bfe9-235c2c3163f4" #edb/ref 17592186045417] [17592186184078 #edb/ref 1069 "e-629" #edb/ref 17592186045417] [17592186184078 #edb/ref 1071 "Find the equation of the tangent line to the polar curve $r = 1+2\\cos\\theta$ at $\\theta = \\dfrac{\\pi}{2},$ given that \n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = -\\dfrac{\\cos\\theta  + 2\\cos(2\\theta)}{\\sin\\theta + 2\\sin(2\\theta)}.\n$$" #edb/ref 17592186045417] [17592186184078 #edb/ref 1072 #uuid "7dbb258d-fe71-5e7b-9501-c88ffdb6fe86" #edb/ref 17592186045417] [17592186184078 #edb/ref 1074 "To find the equation of the tangent line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\dfrac{\\textrm{d}y}{\\textrm{d}x}.$\n\nIn this case, we're given that\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = -\\dfrac{\\cos\\theta  + 2\\cos(2\\theta)}{\\sin\\theta + 2\\sin(2\\theta)}.\n$$\n\n**Step 2**: Find the slope of the tangent at $P.$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /2} \\\\  & =-\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{2})+2\\operatorname{cos}⁡(\\pi )}{\\operatorname{sin}⁡(\\frac{\\pi }{2})+2\\operatorname{sin}⁡(\\pi )} \\\\  & =-\\frac{0+2(-1)}{1+2(0)} \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P.$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =(1+2\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =(1+2\\operatorname{cos}⁡(\\frac{\\pi }{2}))\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =(1+2\\cdot 0)\\cdot 0 \\\\  & =0 \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =(1+2\\operatorname{cos}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =(1+2\\operatorname{cos}⁡(\\frac{\\pi }{2}))\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =(1+2\\cdot 0)\\cdot 1 \\\\  & =1\\cdot 1 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(0,1).$\n\n**Step 4**: Using point-slope form, find the equation of the tangent.\n\nWe find the equation of the tangent as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =2(x-0) \\\\ y & =2x+1\\end{aligned}\n$$\n\n![](images/30/30b1aedfd6187ed1f936ef1faf25fcb8b99857103c656163a3e6897e5c6c5038.png)" #edb/ref 17592186045417] [17592186184120 #edb/ref 1069 "e-9955" #edb/ref 17592186045417] [17592186184120 #edb/ref 1071 "![](images/fc/fc3ec38b91c71be3e9638dfa0127f1baab5d11d30e6156d863b36758f6751e7d.png)\n\nFind the equation of the **normal** line to the polar curve $r = 1 - 2\\cos\\theta$ at $\\theta = \\dfrac{3\\pi}{2},$ given that\n\n$$\ny'(\\theta)  = \\cos\\theta-2\\cos(2\\theta) , \\qquad\nx'(\\theta) = 2\\sin(2\\theta) - \\sin\\theta.\n$$" #edb/ref 17592186045417] [17592186184120 #edb/ref 1072 #uuid "59156f24-72a1-5642-ac66-f84002c87d0b" #edb/ref 17592186045417] [17592186184120 #edb/ref 1074 "To find the equation of the normal line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\dfrac{\\textrm{d}y}{\\textrm{d}x}.$\n\nIn this case, we're given that\n\n$$\ny'(\\theta)  = \\cos\\theta-2\\cos(2\\theta) , \\qquad\nx'(\\theta) = 2\\sin(2\\theta) - \\sin\\theta.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & =\\frac{\\operatorname{cos}⁡\\theta -2\\operatorname{cos}⁡(2\\theta )}{2\\operatorname{sin}⁡(2\\theta )-\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\n**Step 2**: Find the slope of the tangent at $P.$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =3\\pi /2} \\\\  & =\\frac{(\\operatorname{cos}⁡(\\frac{3\\pi }{2})-2\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{2}))}{(2\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{2})-\\operatorname{sin}⁡(\\frac{3\\pi }{2}))} \\\\  & =\\frac{(\\operatorname{cos}⁡(\\frac{3\\pi }{2})-2\\operatorname{cos}⁡(3\\pi ))}{(2\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(\\frac{3\\pi }{2}))} \\\\  & =\\frac{0-2(-1)}{0-(-1)} \\\\  & =\\frac{0+2}{0+1} \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P.$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡(\\frac{3\\pi }{2}))\\operatorname{cos}⁡(\\frac{3\\pi }{2}) \\\\  & =(1-2\\cdot 0)\\cdot 0 \\\\  & =0 \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =(1-2\\operatorname{cos}⁡(\\frac{3\\pi }{2}))\\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =(1-2\\cdot 0)\\cdot (-1) \\\\  & =1\\cdot (-1) \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $\\left( 0, -1 \\right).$\n\n**Step 4**: Using point-slope form, find the equation of the normal.\n\nWe find the equation of the normal as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =-\\frac{1}{m}(x-{x}_{1}) \\\\ y-(-1) & =-\\frac{1}{2}\\cdot (x-0) \\\\ y+1 & =-\\frac{1}{2}x \\\\ y & =-\\frac{1}{2}x-1\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186184177 #edb/ref 1037 #edb/ref 17592186050162 #edb/ref 17592186045417] [17592186184177 #edb/ref 1037 #edb/ref 17592186050277 #edb/ref 17592186045417] [17592186184177 #edb/ref 1038 #edb/ref 17592186184535 #edb/ref 17592186045417] [17592186184177 #edb/ref 1038 #edb/ref 17592186184796 #edb/ref 17592186045417] [17592186184177 #edb/ref 1038 #edb/ref 17592186527917 #edb/ref 17592186045417] [17592186184177 #edb/ref 1038 #edb/ref 17592186542115 #edb/ref 17592186045417] [17592186184177 #edb/ref 1038 #edb/ref 17592186542198 #edb/ref 17592186045417] [17592186184177 #edb/ref 1038 #edb/ref 17592186542202 #edb/ref 17592186045417] [17592186184177 #edb/ref 1038 #edb/ref 17592186542215 #edb/ref 17592186045417] [17592186184177 #edb/ref 1038 #edb/ref 17592186542229 #edb/ref 17592186045417] [17592186184177 #edb/ref 1039 "Finding Tangent Lines to Polar Curves" #edb/ref 17592186045417] [17592186184177 #edb/ref 1041 #edb/ref 17592186184078 #edb/ref 17592186045417] [17592186184177 #edb/ref 1042 #uuid "2216cdfc-7f2a-5c53-b10b-2d66f35fbf32" #edb/ref 17592186045417] [17592186184215 #edb/ref 1038 #edb/ref 17592186184437 #edb/ref 17592186045417] [17592186184215 #edb/ref 1038 #edb/ref 17592186184536 #edb/ref 17592186045417] [17592186184215 #edb/ref 1038 #edb/ref 17592186542143 #edb/ref 17592186045417] [17592186184215 #edb/ref 1038 #edb/ref 17592186542144 #edb/ref 17592186045417] [17592186184215 #edb/ref 1038 #edb/ref 17592186542205 #edb/ref 17592186045417] [17592186184215 #edb/ref 1038 #edb/ref 17592186542206 #edb/ref 17592186045417] [17592186184215 #edb/ref 1039 "Finding Normal Lines to Polar Curves" #edb/ref 17592186045417] [17592186184215 #edb/ref 1041 #edb/ref 17592186184120 #edb/ref 17592186045417] [17592186184215 #edb/ref 1042 #uuid "3e95ede7-306b-55e1-9245-7493f0afb514" #edb/ref 17592186045417] [17592186184419 #edb/ref 1043 #edb/ref 17592186184944 #edb/ref 17592186045417] [17592186184419 #edb/ref 1043 #edb/ref 17592186185001 #edb/ref 17592186045417] [17592186184419 #edb/ref 1043 #edb/ref 17592186185006 #edb/ref 17592186045417] [17592186184419 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186184419 #edb/ref 1045 "Tangent and Normal Lines to Polar Curves" #edb/ref 17592186045417] [17592186184419 #edb/ref 1046 #edb/ref 17592186185006 #edb/ref 17592186045417] [17592186184419 #edb/ref 1049 #edb/ref 17592186049327 #edb/ref 17592186045417] [17592186184419 #edb/ref 1050 1260.0 #edb/ref 17592186045417] [17592186184419 #edb/ref 1053 #uuid "af91633b-288c-52bd-a641-7172621608f6" #edb/ref 17592186045417] [17592186184437 #edb/ref 1068 #edb/ref 17592186180799 #edb/ref 17592186045417] [17592186184437 #edb/ref 1069 "q-103835" #edb/ref 17592186045417] [17592186184437 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186184437 #edb/ref 1071 "Find the equation of the **normal** line to the polar curve $r=\\operatorname{sin}⁡(2\\theta )$ at $\\theta =\\frac{3\\pi }{4},$ given that \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3\\operatorname{sin}⁡(3\\theta )-\\operatorname{sin}⁡\\theta }{3\\operatorname{cos}⁡(3\\theta )+\\operatorname{cos}⁡\\theta }.\n$$" #edb/ref 17592186045417] [17592186184437 #edb/ref 1072 #uuid "ca4cdd59-0ef8-55a6-b3e4-91d9fcc40f65" #edb/ref 17592186045417] [17592186184437 #edb/ref 1073 true #edb/ref 17592186045417] [17592186184437 #edb/ref 1074 "To find the equation of the normal line to a polar curve at a point $P,$ we follow four steps:\n\n**Step 1**: Calculate the derivative $\\frac{\\text{d}y}{\\text{d}x}:$\n\nIn this case, we're given that\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3\\operatorname{sin}⁡(3\\theta )-\\operatorname{sin}⁡\\theta }{3\\operatorname{cos}⁡(3\\theta )+\\operatorname{cos}⁡\\theta }.\n$$\n\n**Step 2**: Find the slope of the tangent at $P:$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =3\\pi /4} \\\\  & =\\frac{(3\\operatorname{sin}⁡(\\frac{9\\pi }{4})-\\operatorname{sin}⁡(\\frac{3\\pi }{4}))}{(3\\operatorname{cos}⁡(\\frac{9\\pi }{4})+\\operatorname{cos}⁡(\\frac{3\\pi }{4}))} \\\\  & =\\frac{(\\frac{3\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2})}{(\\frac{3\\sqrt{2}}{2}+(-\\frac{\\sqrt{2}}{2}))} \\\\  & =\\frac{(\\frac{2\\sqrt{2}}{2})}{(\\frac{2\\sqrt{2}}{2})} \\\\  & =1.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P:$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(2\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(\\frac{3\\pi }{2})\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =(-1)\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{2} \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(2\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡(\\frac{3\\pi }{2})\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =(-1)\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(\\frac{\\sqrt{2}}{2},-\\frac{\\sqrt{2}}{2}).$\n\n**Step 4**: Using point-slope form, find the equation of the normal:\n\nWe find the equation of the normal as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =-\\frac{1}{m}(x-{x}_{1}) \\\\ y-(-\\frac{\\sqrt{2}}{2}) & =-1\\cdot (x-\\frac{\\sqrt{2}}{2}) \\\\ y+\\frac{\\sqrt{2}}{2} & =-x+\\frac{\\sqrt{2}}{2} \\\\ y & =-x\\end{aligned}\n$$\n\n![](images/31/3185d528869c760d55d5f01aebae58ef41c6c325c7a3cb56d67c401ecfb80b2b.png)" #edb/ref 17592186045417] [17592186184944 #edb/ref 1058 #edb/ref 17592186185001 #edb/ref 17592186045417] [17592186184944 #edb/ref 1061 642669 #edb/ref 17592186045417] [17592186184944 #edb/ref 1062 #uuid "a0ead2f8-7726-5a22-ad4d-582c7b4b8968" #edb/ref 17592186045417] [17592186184944 #edb/ref 1063 #edb/ref 17592186184177 #edb/ref 17592186045417] [17592186185001 #edb/ref 1061 642672 #edb/ref 17592186045417] [17592186185001 #edb/ref 1062 #uuid "e6c2d34a-6683-50c4-a82e-b71e985d4ed8" #edb/ref 17592186045417] [17592186185001 #edb/ref 1063 #edb/ref 17592186184215 #edb/ref 17592186045417] [17592186185006 #edb/ref 1058 #edb/ref 17592186184944 #edb/ref 17592186045417] [17592186185006 #edb/ref 1061 642668 #edb/ref 17592186045417] [17592186185006 #edb/ref 1062 #uuid "a1e51e4b-71cf-5749-aae1-c001b3a5a59b" #edb/ref 17592186045417] [17592186185006 #edb/ref 1063 #edb/ref 17592186185342 #edb/ref 17592186045417] [17592186185342 #edb/ref 1064 "![](images/a0/a0b4ad67ea80f6d6eec3a15b3df18d551d84263c7424405588bd15162ef4e7c2.png)\n\nThe polar curve shown above is defined as\n\n$$\nr(\\theta) = 4 - 3\\cos \\theta, \\qquad 0\\leq \\theta < 2\\pi.\n$$\n\nWe have $\\theta = \\dfrac{\\pi}{2}$ at the point $P.$ The tangent to the curve at $P$ is shown in the diagram. \n\nTo find the equation of the tangent line to the curve at $P,$ we follow four steps.\n\n**Step 1**: Calculate the derivative $\\dfrac{\\textrm{d}y}{\\textrm{d}x}.$\n\nUsing techniques that we've previously discussed, we can show that\n\n$$\n\\begin{aligned}{y}^{′}(\\theta )=4\\operatorname{cos}⁡\\theta -3\\operatorname{cos}⁡2\\theta ,\\,{x}^{′}(\\theta )=3\\operatorname{sin}⁡2\\theta -4\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nTherefore, we can find $\\dfrac{\\textrm{d}y}{\\textrm{d}x}$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & =\\frac{4\\operatorname{cos}⁡\\theta -3\\operatorname{cos}⁡2\\theta }{3\\operatorname{sin}⁡2\\theta -4\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\n**Step 2**: Find the slope of the tangent at $P.$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /2} \\\\  & =\\frac{4\\operatorname{cos}⁡(\\frac{\\pi }{2})-3\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2})}{3\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{2})-4\\operatorname{sin}⁡(\\frac{\\pi }{2})} \\\\  & =\\frac{4\\operatorname{cos}⁡(\\frac{\\pi }{2})-3\\operatorname{cos}⁡(\\pi )}{3\\operatorname{sin}⁡(\\pi )-4\\operatorname{sin}⁡(\\frac{\\pi }{2})} \\\\  & =\\frac{0+3}{0-4} \\\\  & =-\\frac{3}{4}.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P.$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =(4-3\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =(4-3\\operatorname{cos}⁡(\\frac{\\pi }{2}))\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =0 \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =(4-3\\operatorname{cos}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =(4-3\\operatorname{cos}⁡(\\frac{\\pi }{2}))\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $\\left( 0, 4 \\right).$\n\n**Step 4**: Using point-slope form, find the equation of the tangent.\n\nWe find the equation of the tangent as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =-\\frac{3}{4}\\cdot (x-0) \\\\ y & =-\\frac{3}{4}x+4\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186185342 #edb/ref 1065 6186 #edb/ref 17592186045417] [17592186185342 #edb/ref 1066 #uuid "febc7b49-9662-5e78-a7a5-cbe9b1f596ba" #edb/ref 17592186045417] [17592186185342 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186541430 #edb/ref 1080 "y=-4\\sqrt{3}x+3\\sqrt{3}" #edb/ref 17592186045417] [17592186541430 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186541430 #edb/ref 1083 #uuid "02fdcad9-364a-5070-981d-f9c1b4551dfc" #edb/ref 17592186045417] [17592186541433 #edb/ref 1080 "1-x" #edb/ref 17592186045417] [17592186541433 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186541433 #edb/ref 1083 #uuid "03d8a6dc-a221-59ed-82be-92d1475ae262" #edb/ref 17592186045417] [17592186541440 #edb/ref 1080 "y=\\frac{3\\pi }{2}x-\\frac{3\\pi }{4}" #edb/ref 17592186045417] [17592186541440 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186541440 #edb/ref 1083 #uuid "08ad0bb0-44b4-5377-b18a-d503eaa1b661" #edb/ref 17592186045417] [17592186541450 #edb/ref 1080 "y=-\\sqrt{3}x+2" #edb/ref 17592186045417] [17592186541450 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186541450 #edb/ref 1083 #uuid "0caec6d9-3660-5e5d-93f8-273e3177e9d2" #edb/ref 17592186045417] [17592186541466 #edb/ref 1080 "\\sqrt{3}" #edb/ref 17592186045417] [17592186541466 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [1759