r><mtd><mi>y</mi><mo>−</mo><msub><mi>y</mi><mn>1</mn></msub></mtd><mtd><mi></mi><mo>=</mo><mi>m</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo>−</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mi>y</mi><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><msqrt><mn>3</mn></msqrt><mo>⋅</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>x</mi><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd><mi>y</mi><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><msqrt><mn>3</mn></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mi>x</mi><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>y</mi></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><msqrt><mn>3</mn></msqrt><mi>x</mi><mo>+</mo><mn>2</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<div id=\"graphic-11d473cb92503904e66528596655f33b\" class=\"graphic\"><img src=\"/graphics/11d473cb92503904e66528596655f33b\"></div>\n</div></div>",
