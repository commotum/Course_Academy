#{[{:db/id #edb/ref 17592186172233 :knowledge-point/_questions [{:db/id #edb/ref 17592186172132 :knowledge-point/id #uuid "4df896f9-7094-5d49-a5cf-3d0f62164298" :knowledge-point/title "The Fundamental Vector Product of a Surface of Revolution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a647e71b-c9d9-5a69-8c75-424a41af93ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sin x" :db/id #edb/ref 17592186168262} {:answer/id #uuid "ae9fc69a-2737-5ca3-adff-50d9dbca67d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos^{2} x" :db/id #edb/ref 17592186168263} {:answer/id #uuid "c7c7598f-2d17-518b-8c20-fc494d705437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sin^{2} x" :db/id #edb/ref 17592186168264} {:answer/id #uuid "cef8a126-a40b-5aa8-ac0a-709edd34b96a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sin x\\cos x" :db/id #edb/ref 17592186168265} {:answer/id #uuid "5a037166-976e-5556-8d9f-39085004a8de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\cos x" :db/id #edb/ref 17592186168266}] :answer-field/id #uuid "03ac9810-fe85-5c89-9a23-5b035d868416" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168261}] :question/id #uuid "ff19c12b-ba54-5c73-b456-a37b42a5dcc1" :question/math-academy-id "q-106277" :question/problem "$⟨_______,-\\sin x\\cos θ,-\\sin x\\sin θ⟩$\n\nThe fundamental vector product of the surface of revolution generated by rotating the curve $y = \\sin x$ by $2π$ radians about the $x$-axis for $x ∈ [0, π]$ is given above. What is the $1$st component of the product?"}] [{:db/id #edb/ref 17592186371941 :knowledge-point/_questions [{:db/id #edb/ref 17592186172133 :knowledge-point/id #uuid "4d7d1683-4735-5c93-9ad1-542e987aed1d" :knowledge-point/title "Calculating a Surface of Revolution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19fd857a-69bb-52bc-8fb2-b57c6fb65bf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{-1}^{1}(1+{z}^{4})\\sqrt{1+8{z}^{6}}\\,\\text{d}z" :db/id #edb/ref 17592186371943} {:answer/id #uuid "1146da46-595d-55c2-874f-d7177d74a0a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{-1}^{1}(1+{z}^{4})\\sqrt{1+8{z}^{6}}\\,\\text{d}z" :db/id #edb/ref 17592186371944} {:answer/id #uuid "fc506864-2f86-51e9-b176-0329e981f791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{-1}^{1}(1+{z}^{4})\\sqrt{1+16{z}^{8}}\\,\\text{d}z" :db/id #edb/ref 17592186371945} {:answer/id #uuid "82ddc8e9-2ce1-5932-875c-df7ef67f9b63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{-1}^{1}(1+{z}^{4})\\sqrt{1+16{z}^{6}}\\,\\text{d}z" :db/id #edb/ref 17592186371946} {:answer/id #uuid "67776efe-de42-57c3-8ff4-ba76605d7146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{-1}^{1}(1+{z}^{4})\\sqrt{1+16{z}^{6}}\\,\\text{d}z" :db/id #edb/ref 17592186371947}] :answer-field/correct {:answer/id #uuid "67776efe-de42-57c3-8ff4-ba76605d7146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{-1}^{1}(1+{z}^{4})\\sqrt{1+16{z}^{6}}\\,\\text{d}z" :db/id #edb/ref 17592186371947} :answer-field/id #uuid "83cff6c6-9176-54ce-9248-48c8a44d7c5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371942}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b5f49f4b-9d27-5249-8593-5beec661bda6" :question/math-academy-id "q-161096" :question/problem "Use a fundamental vector product to determine which of the following integrals gives the surface area generated when the curve $x={z}^{4}+1$ is rotated by $2\\pi $ radians about the $z$-axis for $z\\in [-1,1].$" :question/worked-solution "Notice that $x={z}^{4}+1\\ge 0$ for all $z\\in [-1,1].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨f(z)\\operatorname{cos}⁡\\theta ,\\,f(z)\\operatorname{sin}⁡\\theta ,\\,z⟩,\\,(z,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(z)=1+{z}^{4},$ and\n\n$$\nD={(z,\\theta )\\,:\\,-1\\le z\\le 1,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{z}^{′} & =⟨\\frac{∂x}{∂z},\\,\\frac{∂y}{∂z},\\,\\frac{∂z}{∂z}⟩=⟨{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ,\\,1⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨-f\\operatorname{sin}⁡\\theta ,\\,f(y)\\operatorname{cos}⁡\\theta ,\\,0⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{z}^{′}\\times {r}_{\\theta }^{′} & =|\\begin{aligned}i & j & k \\\\ {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta  & 0\\end{aligned}| \\\\  & =⟨|\\begin{aligned}{f}^{′}\\operatorname{sin}⁡\\theta  & 1 \\\\ f\\operatorname{cos}⁡\\theta  & 0\\end{aligned}|,\\,-|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & 0\\end{aligned}|,\\,|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{aligned}|⟩ \\\\  & =⟨-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ,\\,{f}^{′}f{cos}^{2}⁡\\theta +{f}^{′}f{sin}^{2}⁡\\theta ⟩ \\\\  & =⟨-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ,\\,{f}^{′}f⟩.\\end{aligned}\n$$\n\n  \n\nand\n\n$$\n\\begin{aligned}‖{r}_{z}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(-f\\operatorname{cos}⁡\\theta )^{2}+(-f\\operatorname{sin}⁡\\theta )^{2}+({f}^{′}f)^{2}} \\\\  & =\\sqrt{{f}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+{f}^{2}({f}^{′})^{2}} \\\\  & =\\sqrt{{f}^{2}+{f}^{2}({f}^{′})^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{z}^{′}\\times {r}_{\\theta }^{′}‖\\text{d}z\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z\\,\\text{d}\\theta  \\\\  & ={\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}z \\\\  & ={\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}z \\\\  & =2\\pi {\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z.\\end{aligned}\n$$\n\nSince $f(z)=1+{z}^{4},$ we obtain ${f}^{′}(z)=4{z}^{3}.$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z & =2\\pi {\\int }_{-1}^{1}(1+{z}^{4})\\sqrt{1+(4{z}^{3})^{2}}\\,\\text{d}z \\\\  & =2\\pi {\\int }_{-1}^{1}(1+{z}^{4})\\sqrt{1+16{z}^{6}}\\,\\text{d}z.\\end{aligned}\n$$"}]}
