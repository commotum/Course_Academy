5417] [17592186415533 #edb/ref 1075 #edb/ref 17592186415521 #edb/ref 17592186045417] [17592186415533 #edb/ref 1075 #edb/ref 17592186415526 #edb/ref 17592186045417] [17592186415533 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186415533 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186415533 #edb/ref 1078 #edb/ref 17592186415511 #edb/ref 17592186045417] [17592186415533 #edb/ref 1079 #uuid "638d8ce0-aca0-5ff6-85a7-9e3d7a370c18" #edb/ref 17592186045417] [17592186415534 #edb/ref 1075 #edb/ref 17592186415513 #edb/ref 17592186045417] [17592186415534 #edb/ref 1075 #edb/ref 17592186415515 #edb/ref 17592186045417] [17592186415534 #edb/ref 1075 #edb/ref 17592186415517 #edb/ref 17592186045417] [17592186415534 #edb/ref 1075 #edb/ref 17592186415523 #edb/ref 17592186045417] [17592186415534 #edb/ref 1075 #edb/ref 17592186415528 #edb/ref 17592186045417] [17592186415534 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186415534 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186415534 #edb/ref 1078 #edb/ref 17592186415523 #edb/ref 17592186045417] [17592186415534 #edb/ref 1079 #uuid "f2a4e677-4714-5cf2-98da-8e4b0964eb3f" #edb/ref 17592186045417] [17592186415535 #edb/ref 1068 #edb/ref 17592186415534 #edb/ref 17592186045417] [17592186415535 #edb/ref 1069 "q-161060" #edb/ref 17592186045417] [17592186415535 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186415535 #edb/ref 1071 "$$\n⟨\\,\\sqrt{z-1}\\operatorname{sin}⁡\\theta \\,,\\,\\sqrt{z-1}\\operatorname{cos}⁡\\theta \\,,\\,\\text{_______}⟩\n$$\n\n \n\nThe fundamental vector product of the surface of revolution generated by rotating the curve $y=\\sqrt{z-1}$ by $2\\pi $ radians about the $z$-axis for $z\\in [1,10]$ is given above. What is the $3$rd component of the product?" #edb/ref 17592186045417] [17592186415535 #edb/ref 1072 #uuid "0c98998f-cfca-568f-8a23-cab1aa107bdb" #edb/ref 17592186045417] [17592186415535 #edb/ref 1074 "Notice that $y=\\sqrt{z-1}\\ge 0$ for all $z\\in [1,10].$ The parametrization of our surface of revolution is  \n\n$$\n\\begin{aligned}r=⟨f(z)\\operatorname{sin}⁡\\theta ,f(z)\\operatorname{cos}⁡\\theta ,\\,z⟩,\\,(z,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(z)=\\sqrt{z-1},$ and  \n\n$$\nD={(z,\\theta )\\,:\\,1\\le z\\le 10,\\,0\\le \\theta <2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{z}^{′} & =⟨\\frac{∂x}{∂z},\\,\\frac{∂y}{∂z},\\,\\frac{∂z}{∂z}⟩=⟨{f}^{′}\\operatorname{sin}⁡\\theta ,\\,{f}^{′}\\operatorname{cos}⁡\\theta ,\\,1⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ,\\,0⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{z}^{′}\\times {r}_{\\theta }^{′} & =|\\begin{aligned}i & j & k \\\\ {f}^{′}\\operatorname{sin}⁡\\theta  & {f}^{′}\\operatorname{cos}⁡\\theta  & 1 \\\\ f\\operatorname{cos}⁡\\theta  & -f\\operatorname{sin}⁡\\theta  & 0\\end{aligned}| \\\\  & =⟨|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & 0\\end{aligned}|,\\,-|\\begin{aligned}{f}^{′}\\operatorname{sin}⁡\\theta  & 1 \\\\ f\\operatorname{cos}⁡\\theta  & 0\\end{aligned}|,\\,|\\begin{aligned}{f}^{′}\\operatorname{sin}⁡\\theta  & {f}^{′}\\operatorname{cos}⁡\\theta  \\\\ f\\operatorname{cos}⁡\\theta  & -f\\operatorname{sin}⁡\\theta \\end{aligned}|⟩ \\\\  & =⟨f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ,\\,-{f}^{′}f{sin}^{2}⁡\\theta -{f}^{′}f{cos}^{2}⁡\\theta ⟩ \\\\  & =⟨f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ,\\,-{f}^{′}f⟩.\\end{aligned}\n$$\n\nSince $f=\\sqrt{z-1},$ we obtain ${f}^{′}=\\frac{1}{2\\sqrt{z-1}}.$ So, finally, we conclude that the fundamental vector product is \n\n$$\n\\begin{aligned}{r}_{z}^{′}\\times {r}_{\\theta }^{′}=⟨\\sqrt{z-1}\\operatorname{sin}⁡\\theta ,\\,\\sqrt{z-1}\\operatorname{cos}⁡\\theta ,\\,-\\frac{1}{2}⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186415536 #edb/ref 1068 #edb/ref 17592186415533 #edb/ref 17592186045417] [17592186415536 #edb/ref 1069 "q-161037" #edb/ref 17592186045417] [17592186415536 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186415536 #edb/ref 1071 "$$\nr(z,\\theta )=⟨\\sqrt{{z}^{2}-1}\\operatorname{cos}⁡\\theta ,\\,\\text{__________},\\,z⟩\n$$\n\nThe vector-valued function $r(z,\\theta )$ above parametrizes the surface of revolution generated by rotating the curve $x=\\sqrt{{z}^{2}-1}$ by  $2\\pi $ radians about the $z$-axis for $z\\in [1,5].$ What is the second  component of $r?$" #edb/ref 17592186045417] [17592186415536 #edb/ref 1072 #uuid "a20cac79-e438-5720-941d-255bfdc76ec3" #edb/ref 17592186045417] [17592186415536 #edb/ref 1074 "![](images/d3/d3302b5f4ea4c0387d70ac8f78e03e486fff9579f1a6b5e5cec08a31cde76af3.png)\n\n \n\nA point $(x,y,z)$ on the surface generated by rotating the graph of $x=f(z)$ by $2\\pi $ radians about the $z$-axis has the position vector\n\n$$\n\\begin{aligned}r=⟨f(z)\\operatorname{cos}⁡\\theta ,\\,f(z)\\operatorname{sin}⁡\\theta ,\\,z⟩,\\,z\\in [a,b],\\,\\theta \\in [0,2\\pi ).\\end{aligned}\n$$\n\nFirst, notice that $x=f(z)=\\sqrt{{z}^{2}-1}\\ge 0$ for all $z\\in [1,5].$   \n\nSo, the parametrization of our surface of revolution is\n\n$$\nr(z,\\theta )=⟨\\sqrt{{z}^{2}-1}\\operatorname{cos}⁡\\theta ,\\,\\sqrt{{z}^{2}-1}\\operatorname{sin}⁡\\theta ,\\,z⟩,\\,z\\in [1,5],\\,\\theta \\in [0,2\\pi ).\n$$\n\nTherefore, the second component of $r$ is $\\sqrt{{z}^{2}-1}\\operatorname{sin}⁡\\theta .$" #edb/ref 17592186045417] [17592186415537 #edb/ref 1068 #edb/ref 17592186415532 #edb/ref 17592186045417] [17592186415537 #edb/ref 1069 "q-161090" #edb/ref 17592186045417] [17592186415537 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186415537 #edb/ref 1071 "Use a fundamental vector product to determine which of the following integrals gives the surface area generated when the curve $x=\\operatorname{cos}⁡(\\frac{y}{2})$ is rotated by $2\\pi $ radians about the $y$-axis for $y\\in [-\\pi ,\\pi ].$" #edb/ref 17592186045417] [17592186415537 #edb/ref 1072 #uuid "b858f50b-1a14-576c-973e-c7199e8e8cdb" #edb/ref 17592186045417] [17592186415537 #edb/ref 1074 "Notice that $x=\\operatorname{cos}⁡(\\frac{y}{2})\\ge 0$ for all $y\\in [-\\pi ,\\pi ].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨f(y)\\operatorname{cos}⁡\\theta ,\\,y,\\,f(y)\\operatorname{sin}⁡\\theta ⟩,\\,(y,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(y)=\\operatorname{cos}⁡(\\frac{y}{2}),$ and\n\n$$\nD={(y,\\theta )\\,:\\,-\\pi \\le y\\le \\pi ,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{y}^{′} & =⟨\\frac{∂x}{∂y},\\,\\frac{∂y}{∂y}\\,\\frac{∂z}{∂y}⟩=⟨{f}^{′}\\operatorname{cos}⁡\\theta ,\\,1,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨-f\\operatorname{sin}⁡\\theta ,\\,0,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{y}^{′}\\times {r}_{\\theta }^{′} & =|\\begin{aligned}i & j & k \\\\ {f}^{′}\\operatorname{cos}⁡\\theta  & 1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & 0 & f\\operatorname{cos}⁡\\theta \\end{aligned}| \\\\  & =⟨|\\begin{aligned}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{aligned}|,\\,-|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{aligned}|,\\,|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & 0\\end{aligned}|⟩ \\\\  & =⟨f\\operatorname{cos}⁡\\theta ,\\,-f{f}^{′}{cos}^{2}⁡\\theta -f{f}^{′}{sin}^{2}⁡\\theta ,\\,f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f\\operatorname{cos}⁡\\theta ,\\,-f{f}^{′},\\,f\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}‖{r}_{y}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(f\\operatorname{cos}⁡\\theta )^{2}+(-f{f}^{′})^{2}+(f\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{{f}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+{f}^{2}({f}^{′})^{2}} \\\\  & =\\sqrt{{f}^{2}+{f}^{2}({f}^{′})^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{y}^{′}\\times {r}_{\\theta }^{′}‖\\text{d}y\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}y\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi }^{\\pi }f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}y \\\\  & ={\\int }_{-\\pi }^{\\pi }f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-\\pi }^{\\pi }f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}y.\\end{aligned}\n$$\n\nSince $f(y)=\\operatorname{cos}⁡(\\frac{y}{2}),$ we obtain ${f}^{′}(y)=-\\frac{1}{2}\\operatorname{sin}⁡(\\frac{y}{2}).$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{-\\pi }^{\\pi }f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}y & =2\\pi {\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡(\\frac{y}{2})\\sqrt{1+{(-\\frac{1}{2}\\operatorname{sin}⁡(\\frac{y}{2}))}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡(\\frac{y}{2})\\sqrt{1+\\frac{1}{4}{sin}^{2}⁡(\\frac{y}{2})}\\,\\text{d}y.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186415538 #edb/ref 1058 #edb/ref 17592186415542 #edb/ref 17592186045417] [17592186415538 #edb/ref 1062 #uuid "00cc2357-080e-51b5-a1e7-01af77a068b5" #edb/ref 17592186045417] [17592186415538 #edb/ref 1063 #edb/ref 17592186415536 #edb/ref 17592186045417] [17592186415539 #edb/ref 1058 #edb/ref 17592186415538 #edb/ref 17592186045417] [17592186415539 #edb/ref 1062 #uuid "62191b79-d61b