78377 #edb/ref 17592186045417] [17592186172133 #edb/ref 1038 #edb/ref 17592186278378 #edb/ref 17592186045417] [17592186172133 #edb/ref 1038 #edb/ref 17592186371941 #edb/ref 17592186045417] [17592186172133 #edb/ref 1038 #edb/ref 17592186371948 #edb/ref 17592186045417] [17592186172133 #edb/ref 1038 #edb/ref 17592186389126 #edb/ref 17592186045417] [17592186172133 #edb/ref 1038 #edb/ref 17592186415537 #edb/ref 17592186045417] [17592186172133 #edb/ref 1039 "Calculating a Surface of Revolution" #edb/ref 17592186045417] [17592186172133 #edb/ref 1041 #edb/ref 17592186171713 #edb/ref 17592186045417] [17592186172133 #edb/ref 1042 #uuid "4d7d1683-4735-5c93-9ad1-542e987aed1d" #edb/ref 17592186045417] [17592186172185 #edb/ref 1043 #edb/ref 17592186172933 #edb/ref 17592186045417] [17592186172185 #edb/ref 1043 #edb/ref 17592186172934 #edb/ref 17592186045417] [17592186172185 #edb/ref 1043 #edb/ref 17592186172935 #edb/ref 17592186045417] [17592186172185 #edb/ref 1043 #edb/ref 17592186172965 #edb/ref 17592186045417] [17592186172185 #edb/ref 1043 #edb/ref 17592186173083 #edb/ref 17592186045417] [17592186172185 #edb/ref 1043 #edb/ref 17592186173084 #edb/ref 17592186045417] [17592186172185 #edb/ref 1043 #edb/ref 17592186173085 #edb/ref 17592186045417] [17592186172185 #edb/ref 1043 #edb/ref 17592186173086 #edb/ref 17592186045417] [17592186172185 #edb/ref 1043 #edb/ref 17592186173087 #edb/ref 17592186045417] [17592186172185 #edb/ref 1043 #edb/ref 17592186173089 #edb/ref 17592186045417] [17592186172185 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186172185 #edb/ref 1045 "Surfaces of Revolution" #edb/ref 17592186045417] [17592186172185 #edb/ref 1046 #edb/ref 17592186172933 #edb/ref 17592186045417] [17592186172185 #edb/ref 1049 #edb/ref 17592186049628 #edb/ref 17592186045417] [17592186172185 #edb/ref 1053 #uuid "d69714f2-bb12-5119-931a-cf96944e88c7" #edb/ref 17592186045417] [17592186172233 #edb/ref 1068 #edb/ref 17592186415531 #edb/ref 17592186045417] [17592186172233 #edb/ref 1069 "q-106277" #edb/ref 17592186045417] [17592186172233 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186172233 #edb/ref 1071 "$$\n⟨\\text{_______}\\,,\\,-\\operatorname{sin}⁡x\\operatorname{cos}⁡\\theta ,\\,-\\operatorname{sin}⁡x\\operatorname{sin}⁡\\theta ⟩\n$$\n\nThe fundamental vector product of the surface of revolution generated by rotating the curve $y=\\operatorname{sin}⁡x$ by $2\\pi $ radians about the $x$-axis for $x\\in [0,\\pi ]$ is given above. What is the $1$st component of the product?" #edb/ref 17592186045417] [17592186172233 #edb/ref 1072 #uuid "ff19c12b-ba54-5c73-b456-a37b42a5dcc1" #edb/ref 17592186045417] [17592186172233 #edb/ref 1074 "Notice that $y=\\operatorname{sin}⁡x\\ge 0$ for all $x\\in [0,\\pi ].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨x,f(x)\\operatorname{cos}⁡\\theta ,\\,f(x)\\operatorname{sin}⁡\\theta ⟩,\\,(x,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(x)=\\operatorname{sin}⁡x,$ and\n\n$$\nD={(x,\\theta )\\,:\\,0\\le x\\le \\pi ,\\,0\\le \\theta <2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨\\frac{∂x}{∂x},\\,\\frac{∂y}{∂x},\\,\\frac{∂z}{∂x}⟩=⟨1,\\,{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨0,\\,-f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{aligned}| \\\\  & =⟨|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{aligned}|,\\,-|\\begin{aligned}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{aligned}|,\\,|\\begin{aligned}1 & {f}^{′}\\operatorname{cos}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta \\end{aligned}|⟩ \\\\  & =⟨f{f}^{′}{cos}^{2}⁡\\theta +f{f}^{′}{sin}^{2}⁡\\theta ,\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f{f}^{′},\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$\n\nSince $f=\\operatorname{sin}⁡x,$ we obtain ${f}^{′}=\\operatorname{cos}⁡x.$ So, finally, we conclude that the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′}=⟨\\operatorname{sin}⁡x\\operatorname{cos}⁡x,\\,-\\operatorname{sin}⁡x\\operatorname{cos}⁡\\theta ,\\,-\\operatorname{sin}⁡x\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186172933 #edb/ref 1058 #edb/ref 17592186173086 #edb/ref 17592186045417] [17592186172933 #edb/ref 1061 33155 #edb/ref 17592186045417] [17592186172933 #edb/ref 1062 #uuid "1d490ab1-06f7-5e16-b643-b1b0d8fab4fe" #edb/ref 17592186045417] [17592186172933 #edb/ref 1063 #edb/ref 17592186173175 #edb/ref 17592186045417] [17592186172934 #edb/ref 1058 #edb/ref 17592186172965 #edb/ref 17592186045417] [17592186172934 #edb/ref 1061 33156 #edb/ref 17592186045417] [17592186172934 #edb/ref 1062 #uuid "9771f588-30ca-519b-9cd3-5da25e6f18e1" #edb/ref 17592186045417] [17592186172934 #edb/ref 1063 #edb/ref 17592186172055 #edb/ref 17592186045417] [17592186172935 #edb/ref 1058 #edb/ref 17592186173083 #edb/ref 17592186045417] [17592186172935 #edb/ref 1061 33157 #edb/ref 17592186045417] [17592186172935 #edb/ref 1062 #uuid "8409e7cf-c975-5a30-a407-4fc56e97763f" #edb/ref 17592186045417] [17592186172935 #edb/ref 1063 #edb/ref 17592186172056 #edb/ref 17592186045417] [17592186172965 #edb/ref 1058 #edb/ref 17592186173087 #edb/ref 17592186045417] [17592186172965 #edb/ref 1061 34312 #edb/ref 17592186045417] [17592186172965 #edb/ref 1062 #uuid "23271cc4-5b18-5ab7-87a0-420c4bf3d6fc" #edb/ref 17592186045417] [17592186172965 #edb/ref 1063 #edb/ref 17592186173186 #edb/ref 17592186045417] [17592186173083 #edb/ref 1058 #edb/ref 17592186173084 #edb/ref 17592186045417] [17592186173083 #edb/ref 1061 44310 #edb/ref 17592186045417] [17592186173083 #edb/ref 1062 #uuid "2109942c-c8ff-56d5-8311-ec29a24f7390" #edb/ref 17592186045417] [17592186173083 #edb/ref 1063 #edb/ref 17592186172132 #edb/ref 17592186045417] [17592186173084 #edb/ref 1058 #edb/ref 17592186173085 #edb/ref 17592186045417] [17592186173084 #edb/ref 1061 44313 #edb/ref 17592186045417] [17592186173084 #edb/ref 1062 #uuid "8c37f4ed-7df7-5a6c-855e-263d81b3f5b0" #edb/ref 17592186045417] [17592186173084 #edb/ref 1063 #edb/ref 17592186173253 #edb/ref 17592186045417] [17592186173085 #edb/ref 1061 44314 #edb/ref 17592186045417] [17592186173085 #edb/ref 1062 #uuid "3533d6b6-1b8e-5af8-b6c0-195bca89c86d" #edb/ref 17592186045417] [17592186173085 #edb/ref 1063 #edb/ref 17592186172133 #edb/ref 17592186045417] [17592186173086 #edb/ref 1058 #edb/ref 17592186173089 #edb/ref 17592186045417] [17592186173086 #edb/ref 1061 44408 #edb/ref 17592186045417] [17592186173086 #edb/ref 1062 #uuid "93cfa70b-b133-5659-9bce-ab370759c49e" #edb/ref 17592186045417] [17592186173086 #edb/ref 1063 #edb/ref 17592186173254 #edb/ref 17592186045417] [17592186173087 #edb/ref 1058 #edb/ref 17592186172935 #edb/ref 17592186045417] [17592186173087 #edb/ref 1061 44409 #edb/ref 17592186045417] [17592186173087 #edb/ref 1062 #uuid "6100252f-8102-5700-8f5a-11a2b77335a0" #edb/ref 17592186045417] [17592186173087 #edb/ref 1063 #edb/ref 17592186173255 #edb/ref 17592186045417] [17592186173089 #edb/ref 1058 #edb/ref 17592186172934 #edb/ref 17592186045417] [17592186173089 #edb/ref 1061 44739 #edb/ref 17592186045417] [17592186173089 #edb/ref 1062 #uuid "3100ec93-73c0-5fba-bebc-ee40c07ece7d" #edb/ref 17592186045417] [17592186173089 #edb/ref 1063 #edb/ref 17592186173257 #edb/ref 17592186045417] [17592186173175 #edb/ref 1064 "Consider the planar curve $y=e^{-x}$ defined on the interval $x \\in [0,2],$ as shown below.\n\n![](images/a8/a8ce2449af085548fecc543fbd5ccfec0e8024344547b2a7825f3a6e9ccf63d4.png)\n\nBy rotating this curve $2\\pi$ radians about the $x$-axis, we get a **surface of revolution**:\n\n![](images/88/88c9c1ec629ab9967cc011aaadafebea255cd50abee9c3730bed4f53f671c71b.png)\n\nWe can parametrize this surface in the following way:\n\n- We take a point $P$ on the surface with $x$-coordinate equal to $x_0$ for some fixed $x_0 \\in [0,2].$\n\n- Now, by taking the intersection of the surface with the plane $x=x_0,$ we get a circle of radius $e^{-x_0}.$\n\n![](images/f1/f1e2cf1c571a21e06f1b25f99a64b5529fea8c65c897b3f225cfd0d307d725d7.png)\n\n \nThis circle can be parameterized as follows:\n\n$$\n\\mathbf r(x_0, \\theta) = \\big\\langle {\\color{black}x_0}, \\: e^{-x_0} \\, \\cos{\\theta}, \\: e^{-x_0} \\, \\sin{\\theta} \\big\\rangle,\n\\quad  \\theta \\in [0,2\\pi).\n$$\n\n- Finally, by allowing $x_0$ to vary over the interval $[0, 2],$ these circles will trace out the surface of revolution. Therefore, our parameterization is\n\n$$\n\\mathbf{r}(x,\\theta) = \\big\\langle x, \\: e^{-x} \\cos{\\theta}, \\: e^{-x}\\sin{\\theta} \\big\\rangle,\n\\quad \nx \\in [0,2], \n\\quad\n\\theta \\in [0,2\\pi).\n$$\n\nLet's now describe some general formulas for parametrizing surfaces of revolution." #edb/ref 17592186045417] [17592186173175 #edb/ref 1065 5305 #edb/ref 17592186045417] [17592186173175 #edb/ref 1066 #uuid "9bd13796-1bf7-5a1b-a9f4-87567fd6998c" #edb/ref 17592186045417] [17592186173175 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186173186 #edb/ref 1064 "Consider the point $(x(y),y,0)$ that lies on the curve $x=x(y)\\geq 0$ for $y\\in [a,b]$ in the $xy$-plane. Rotating this point by $2\\pi$ radians about the $y$-axis generates a circle, as shown below.\n\n![](images/98/981ed341198c54e5dffeae770d13b3d46222ad429d0315ecd057b43995b4c0d6.png)\n\nThe pair $(\\textrm{circle}_1,\\textrm{circle}_2)$ denotes any parametrization of a circle of radius $x(y)$ with parameter $y.$\n\nUsing arguments similar to those seen earlier, the corresponding surface of revolution can be parametrized as\n\n$$\n\\mathbf{r} = \\big\\langle x(y) \\cos\\theta, \\: y, \\: x(y) \\sin\\theta \\big\\rangle, \\quad y\\in[a,b], \\quad \\theta\\in [0,2\\pi).\n$$\n\n**Note:** Since a parametrization of a circle is not unique, we can obtain different parameterizations of our surface of revolution. For example, the following is also a valid parameterization:\n\\[ \n\\mathbf{r} = \\big\\langle x(y) \\sin\\theta, \\: y, \\: x(y) \\cos\\theta \\big\\rangle, \\quad y\\in[a,b], \\quad \\theta\\in [0,2\\pi). \n\\]\n\nSimilarly, the rotation of a point $(0,y,z(y))$ on the curve $z=z(y)\\geq 0$ in the $yz$-plane about the $y$-axis can be visualized as follows:\n\n![](images/59/5936d54e55c151ec2d9786a3ce2bd807970a71c10a21974562fd601bf50dfd37.png)\n\nThe corresponding surface of revolution can be parametrized as\n\n$$\n\\mathbf{r} = \\big\\langle z(y) \\cos\\theta, \\: y, \\: z(y) \\sin\\theta \\big\\rangle, \\quad y\\in[a,b], \\quad \\theta\\in [0,2\\pi).\n$$\n\nAs mentioned previously, neither of these parameterizations is unique.\n\n**Note:** Since a parametrization of a circle is not unique, we can obtain different parameterizations of our surface of revolution. For example, the following is also a valid parameterization:\n\\[\n\\mathbf{r} = \\big\\langle z(y) \\sin\\theta, \\: y, \\: z(y) \\cos\\theta \\big\\rangle, \\quad y\\in[a,b], \\quad \\theta\\in [0,2\\pi). \n\\]" #edb/ref 17592186045417] [17592186173186 #edb/ref 1065 5507 #edb/ref 17592186045417] [17592186173186 #edb/ref 1066 #uuid "ae882ec8-1ebd-5277-8224-b440b433c8ee" #edb/ref 17592186045417] [17592186173186 #edb/ref 1067 "Formulas for Rotation About the y-Axis" #edb/ref 17592186045417] [17592186173253 #edb/ref 1064 "Recall that if $S$ is a surface parametrized by a differentiable vector-valued function\n\n$$\n\\mathbf{r}(u,v) = \\big\\langle x(u,v), \\: y(u,v), \\: z(u,v) \\big\\rangle\n$$\n\ndefined over a region $D$ in the $uv$-plane, then the surface area of $S$ is given by\n\n$$\n\\iint\\limits_{S} \\: \\textrm{d}S =  \\iint\\limits_{D} \\| \\mathbf{r}'_ u \\times \\mathbf{r}'_v  \\| \\: \\textrm{d}A,\n$$\n\nwhere $\\mathbf{r}'_ u \\times \\mathbf{r}'_v$ is the fundamental vector product of the surface.\n\nLet's apply this formula to find the surface area generated by a surface of revolution.\n\nSuppose that the curve [math]y=f(x)[/math] for [math]x \\in [a,b][/math] is rotated [math]2\\pi[/math] radians about the [math]x[/math]-axis. The corresponding surface of revolution can be parametrized as\n\n\\begin{align*}\n\\mathbf{r} = \\big\\langle x, \\: f(x) \\cos\\theta, \\: f(x) \\sin\\theta \\big\\rangle, \\quad (x,\\theta) \\in D, \n\\end{align*}\n\nwhere [math]D= \\big\\{ (x,\\theta) \\: : \\: x \\in[a,b], \\: \\theta \\in [0,2\\pi) \\big\\}.[/math] How can we find the area of this surface?\n\nFirst, we now compute the tangent vectors to the grid curves:\n\n\\begin{align*}\n\\mathbf{r}'_x \n&= \\bigg\\langle \\dfrac{\\partial x}{\\partial x}, \\: \\dfrac{\\partial y}{\\partial x}, \\: \\dfrac{\\partial z}{\\partial x} \\bigg\\rangle \n= \\big\\langle 1, \\:f'(x) \\cos\\theta, \\: f'(x) \\sin\\theta \\big\\rangle \\\\[10pt]\n\n\\mathbf{r}'_\\theta \n&= \\bigg\\langle \\dfrac{\\partial x}{\\partial \\theta}, \\: \\dfrac{\\partial y}{\\partial \\theta}, \\: \\dfrac{\\partial z}{\\partial \\theta} \\bigg\\rangle \n= \\big\\langle 0, \\: -f(x) \\sin\\theta, \\: f(x) \\cos\\theta \\big\\rangle\n\\end{align*}\n\nNext, the fundamental vector product is\n\n\\begin{align*}\n\\mathbf{r}'_x \\times \\mathbf{r}'_\\theta \n&= \n\\begin{vmatrix}\n\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\\n1 & f'(x) \\cos\\theta & f'(x) \\sin\\theta \\\\\n0 & -f(x) \\sin\\theta & f(x) \\cos\\theta\n\\end{vmatrix} \\\\[5pt]\n&= \\bigg\\langle \\begin{vmatrix} f'(x) \\cos\\theta & f'(x) \\sin\\theta \\\\ -f(x) \\sin\\theta & f(x) \\cos\\theta \\end{vmatrix}, \\: -\\begin{vmatrix} 1 & f'(x) \\sin\\theta \\\\ 0  & f(x) \\cos\\theta \\end{vmatrix}, \\: \\begin{vmatrix} 1 & f'(x) \\cos\\theta \\\\ 0 & -f(x) \\sin\\theta  \\end{vmatrix} \\bigg\\rangle \\\\[5pt]\n&= \\big\\langle f(x)f'(x)\\cos^2\\theta+f(x)f'(x)\\sin^2\\theta, \\: -f(x) \\cos\\theta, \\: -f(x)\\sin\\theta \\big\\rangle \\\\[5pt]\n&= \\big\\langle f(x)f'(x), \\: -f(x) \\cos\\theta, \\:- f(x)\\sin\\theta \\big\\rangle\n\\end{align*}\n\nand\n\n\\begin{align*}\n\\left\\|  \\mathbf{r}'_y \\times \\mathbf{r}'_\\theta \\right\\|\n&= \\sqrt{\\big( f(x)f'(x) \\big)^2 + \\big( -f(x) \\cos\\theta \\big)^2 + \\big( -f(x)\\sin\\theta \\big)^2 } \\\\[3pt]\n&= \\sqrt{\\big(f(x)\\big)^2\\big(f'(x)\\big)^2 + \\big(f(x)\\big)^2 \\big( \\cos^2\\theta + \\sin^2\\theta \\big) } \\\\[3pt]\n&= \\sqrt{\\big(f(x)\\big)^2\\big(f'(x)\\big)^2 + \\big(f(x)\\big)^2 } \\\\[3pt]\n&= f(x) \\sqrt{1 + \\big(f'(x)\\big)^2 }.\n\\end{align*}\n\nTherefore, the surface area is\n\n\\begin{align*}\nA \n&= \\iint\\limits_S \\,  \\text{d}S \\\\[5pt]\n&= \\iint\\limits_D  \\left\\|  \\mathbf{r}'_y \\times \\mathbf{r}'_\\theta \\right\\|  \\text{d}x\\text{d}\\theta \\\\[5pt]\n&= \\int_{a}^{b} \\int_{0}^{2\\pi} f(x) \\sqrt{1 + \\big(f'(x)\\big)^2 } \\: \\text{d}\\theta \\: \\text{d}x \\\\[5pt]\n&= \\int_{a}^{b} f(x) \\sqrt{1 + \\big(f'(x)\\big)^2} \\: \\text{d}x \\cdot \\int_{0}^{2\\pi}  \\text{d}\\theta \\\\[5pt]\n&= \\int_{a}^{b} f(x) \\sqrt{1 + \\big(f'(x)\\big)^2} \\: \\text{d}x \\cdot \\big[ \\theta \\big]_{0}^{2\\pi}  \\\\[5pt]\n&= 2\\pi \\int_{a}^{b} f(x)\\sqrt{1 + \\big(f'(x)\\big)^2 } \\: \\text{d}x.\n\\end{align*}" #edb/ref 17592186045417] [17592186173253 #edb/ref 1065 7638 #edb/ref 17592186045417] [17592186173253 #edb/ref 1066 #uuid "79f42de8-4cc4-576a-b367-c08bd87f8bcd" #edb/ref 17592186045417] [17592186173253 #edb/ref 1067 "Computing a Surface Area of Revolution" #edb/ref 17592186045417] [17592186173254 #edb/ref 1064 "Consider the point $(x,y(x),0)$ that lies on the curve $y=y(x)$ in the $xy$-plane. Rotating this point by $2\\pi$ radians about the $x$-axis generates a circle, as shown below.\n\n![](images/86/86cbc06bd3730430665744216a702ed29cc75acae33a569e00636ee53149065d.png)\n\nIn the diagram above, the pair $(\\textrm{circle}_1,\\textrm{circle}_2)$ denotes any parametrization of a circle of radius $y(x)$ with parameter $x.$\n\nIn general, given a curve $y=y(x)\\geq 0$ for $x \\in [a,b]$ that is rotated $2\\pi$ radians about the $x$-axis, the corresponding surface of revolution can be parametrized as\n\n$$\n\\mathbf{r} = \\big\\langle x, \\: y(x) \\cos\\theta, \\: y(x) \\sin\\theta \\big\\rangle, \\quad x\\in[a,b], \\quad \\theta\\in [0,2\\pi).\n$$\n\nSince a parametrization of a circle is not unique, we can obtain different parameterizations of our surface of revolution. For example, the following is also a valid parameterization:\n\n$$\n\\mathbf{r} = \\big\\langle x, \\: y(x) \\sin\\theta, \\: y(x) \\cos\\theta \\big\\rangle, \\quad x\\in[a,b], \\quad \\theta\\in [0,2\\pi)\n$$" #edb/ref 17592186045417] [17592186173254 #edb/ref 1065 7648 #edb/ref 17592186045417] [17592186173254 #edb/ref 1066 #uuid "3148fb53-9ae7-5747-aa63-b79dd1bc224f" #edb/ref 17592186045417] [17592186173254 #edb/ref 1067 "Parametrizing a Surface Generated by Rotating y=y(x) About the x-Axis" #edb/ref 17592186045417] [17592186173255 #edb/ref 1064 "Now consider the point $(x(z),0,z)$ on the curve $x=x(z)\\geq 0$ for $z\\in [a,b]$ in the $xz$-plane. Rotating this point by $2\\pi$ radians about the $z$-axis generates a circle, as shown below.\n\n![](images/50/50473a5407143c7ec49ce8c192c256bbc184703010209767507e4b922e9f4c7b.png)\n\nThe corresponding surface of revolution can be parametrized as\n\n$$\n\\mathbf{r} = \\big\\langle x(z) \\cos\\theta, \\: x(z) \\sin\\theta, \\: z \\big\\rangle, \\quad z\\in[a,b], \\quad \\theta\\in [0,2\\pi).\n$$\n\nFinally, the rotation of a point $(0,y(z),z)$ on a curve $y=y(z)\\geq 0$ in the $yz$-plane about the $z$-axis can be visualized as follows:\n\n![](images/5f/5ff1574db4d105e7d69cc12ed609898d626b4977902f98dbcbcac6633ad56d2b.png)\n\nThe corresponding surface of revolution can be parametrized as\n\n$$\n\\mathbf{r} = \\big\\langle y(z) \\cos\\theta, \\: y(z) \\sin\\theta, \\: z \\big\\rangle, \\quad z\\in[a,b], \\quad \\theta\\in [0,2\\pi).\n$$" #edb/ref 17592186045417] [17592186173255 #edb/ref 1065 7649 #edb/ref 17592186045417] [17592186173255 #edb/ref 1066 #uuid "9e8a0947-f30a-5da6-9c3b-7b93bdba56bf" #edb/ref 17592186045417] [17592186173255 #edb/ref 1067 "Formulas for Rotation About the z-Axis" #edb/ref 17592186045417] [17592186173257 #edb/ref 1064 "Now consider the point $(x,0,z(x))$ that lies on a curve $z=z(x)$ in the $xz$-plane. Rotating this point by $2\\pi$ radians about the $x$-axis generates a circle, as shown below.\n\n![](images/74/74686e9e17ce056fea730b47bdf34ee582cc83920200f0345f75b90a6f8c9833.png)\n\nIn general, given a curve $z=z(x)\\geq 0$ for $x \\in [a,b]$ that is rotated $2\\pi$ radians about the $x$-axis, the corresponding surface of revolution can be parametrized as\n\n$$\n\\mathbf{r} = \\big\\langle x, \\: z(x) \\cos\\theta, \\: z(x) \\sin\\theta \\big\\rangle, \\quad z\\in[a,b], \\quad \\theta\\in [0,2\\pi).\n$$\n\nAgain, this parametrization is not unique. An alternative parametrization is\n\n$$\n\\mathbf{r} = \\big\\langle x, \\: z(x) \\sin\\theta, \\: z(x) \\cos\\theta \\big\\rangle, \\quad z\\in[a,b], \\quad \\theta\\in [0,2\\pi).\n$$" #edb/ref 17592186045417] [17592186173257 #edb/ref 1065 7714 #edb/ref 17592186045417] [17592186173257 #edb/ref 1066 #uuid "c06437e5-d847-5d03-aac0-497649901444" #edb/ref 17592186045417] [17592186173257 #edb/ref 1067 "Parametrizing a Surface Generated by Rotating z=z(x) About the x-Axis" #edb/ref 17592186045417] [17592186371941 #edb/ref 1068 #edb/ref 17592186371942 #edb/ref 17592186045417] [17592186371941 #edb/ref 1069 "q-161096" #edb/ref 17592186045417] [17592186371941 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186371941 #edb/ref 1071 "Use a fundamental vector product to determine which of the following integrals gives the surface area generated when the curve $x={z}^{4}+1$ is rotated by $2\\pi $ radians about the $z$-axis for $z\\in [-1,1].$" #edb/ref 17592186045417] [17592186371941 #edb/ref 1072 #uuid "b5f49f4b-9d27-5249-8593-5beec661bda6" #edb/ref 17592186045417] [17592186371941 #edb/ref 1074 "Notice that $x={z}^{4}+1\\ge 0$ for all $z\\in [-1,1].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨f(z)\\operatorname{cos}⁡\\theta ,\\,f(z)\\operatorname{sin}⁡\\theta ,\\,z⟩,\\,(z,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(z)=1+{z}^{4},$ and\n\n$$\nD={(z,\\theta )\\,:\\,-1\\le z\\le 1,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{z}^{′} & =⟨\\frac{∂x}{∂z},\\,\\frac{∂y}{∂z},\\,\\frac{∂z}{∂z}⟩=⟨{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ,\\,1⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨-f\\operatorname{sin}⁡\\theta ,\\,f(y)\\operatorname{cos}⁡\\theta ,\\,0⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{z}^{′}\\times {r}_{\\theta }^{′} & =|\\begin{aligned}i & j & k \\\\ {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta  & 0\\end{aligned}| \\\\  & =⟨|\\begin{aligned}{f}^{′}\\operatorname{sin}⁡\\theta  & 1 \\\\ f\\operatorname{cos}⁡\\theta  & 0\\end{aligned}|,\\,-|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & 0\\end{aligned}|,\\,|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{aligned}|⟩ \\\\  & =⟨-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ,\\,{f}^{′}f{cos}^{2}⁡\\theta +{f}^{′}f{sin}^{2}⁡\\theta ⟩ \\\\  & =⟨-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ,\\,{f}^{′}f⟩.\\end{aligned}\n$$\n\n  \n\nand\n\n$$\n\\begin{aligned}‖{r}_{z}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(-f\\operatorname{cos}⁡\\theta )^{2}+(-f\\operatorname{sin}⁡\\theta )^{2}+({f}^{′}f)^{2}} \\\\  & =\\sqrt{{f}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+{f}^{2}({f}^{′})^{2}} \\\\  & =\\sqrt{{f}^{2}+{f}^{2}({f}^{′})^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{z}^{′}\\times {r}_{\\theta }^{′}‖\\text{d}z\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z\\,\\text{d}\\theta  \\\\  & ={\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}z \\\\  & ={\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}z \\\\  & =2\\pi {\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z.\\end{aligned}\n$$\n\nSince $f(z)=1+{z}^{4},$ we obtain ${f}^{′}(z)=4{z}^{3}.$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}z & =2\\pi {\\int }_{-1}^{1}(1+{z}^{4})\\sqrt{1+(4{z}^{3})^{2}}\\,\\text{d}z \\\\  & =2\\pi {\\int }_{-1}^{1}(1+{z}^{4})\\sqrt{1+16{z}^{6}}\\,\\text{d}z.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186371942 #edb/ref 1075 #edb/ref 17592186371943 #edb/ref 17592186045417] [17592186371942 #edb/ref 1075 #edb/ref 17592186371944 #edb/ref 17592186045417] [17592186371942 #edb/ref 1075 #edb/ref 17592186371945 #edb/ref 17592186045417] [17592186371942 #edb/ref 1075 #edb/ref 17592186371946 #edb/ref 17592186045417] [17592186371942 #edb/ref 1075 #edb/ref 17592186371947 #edb/ref 17592186045417] [17592186371942 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186371942 #edb/ref 1077 "selection" #