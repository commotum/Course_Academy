#{[{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186532748} :activity/id #uuid "30c49c97-c553-542d-998e-6bf184027d2e" :activity/scope {:db/id #edb/ref 17592186048403 :topic/id #uuid "9c41899e-334d-5c90-83f2-ff0d4e02a917" :topic/math-academy-id 316} :activity/steps [{:db/id #edb/ref 17592186532727 :step/content {:db/id #edb/ref 17592186284633 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b49dffc-ef34-51f9-880f-343a17e7f464" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{{2}^{11}}}{7}" :db/id #edb/ref 17592186282461} {:answer/id #uuid "8972d08b-477b-5df8-8798-490e031cacfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{{2}^{7}}}{35}" :db/id #edb/ref 17592186282876} {:answer/id #uuid "a2129991-a47b-5a82-ac7c-8e1ca3a89e30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{{2}^{11}}}{35}" :db/id #edb/ref 17592186283104} {:answer/id #uuid "b46333d5-37ec-5aa4-b7d2-c43db38be685" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{{2}^{9}}}{7}" :db/id #edb/ref 17592186283251} {:answer/id #uuid "c63d1f0f-ee09-585f-b726-ba8a97ddf0c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{{2}^{9}}}{35}" :db/id #edb/ref 17592186283415}] :answer-field/correct {:db/id #edb/ref 17592186283104} :answer-field/id #uuid "54febd29-2fe4-5926-8377-9b3e1c741602" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284074}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "abf52321-10d1-5a8b-a0a2-2f3814ff9431" :question/math-academy-id "q-17045" :question/problem "Evaluate ${\\int }_{0}^{2}x\\sqrt{{(2-x)}^{3}}\\,\\text{d}x.$" :question/worked-solution "Let $u=2-x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe also note that $x=2-u.$\n\nComputing our limits of integration, we get\n\n| **$x$** | $0$ | $2$ |\n| --- | --- | --- |\n| **$u$** | $2$ | $0$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}x\\sqrt{{(2-x)}^{3}}\\,\\text{d}x & ={\\int }_{0}^{2}x{(2-x)}^{3/2}\\,\\text{d}x \\\\  & ={\\int }_{2}^{0}(2-u){u}^{3/2}(-\\text{d}u) \\\\  & ={\\int }_{2}^{0}(u-2){u}^{3/2}\\,\\text{d}u \\\\  & ={\\int }_{2}^{0}({u}^{5/2}-2{u}^{3/2})\\,\\text{d}u \\\\  & ={(\\frac{2}{7}{u}^{7/2}-2\\cdot \\frac{2}{5}{u}^{5/2})|}_{2}^{0} \\\\  & ={(\\frac{2}{7}{u}^{7/2}-\\frac{4}{5}{u}^{5/2})|}_{2}^{0} \\\\  & =\\frac{2}{7}({0}^{7/2}-{2}^{7/2})-\\frac{4}{5}({0}^{5/2}-{2}^{5/2}) \\\\  & =-\\frac{{2}^{9/2}}{7}+\\frac{{2}^{9/2}}{5} \\\\  & =\\frac{{2}^{11/2}}{35} \\\\  & =\\frac{\\sqrt{{2}^{11}}}{35}\\end{aligned}\n$$"} :step/id #uuid "00ed98fb-e0bf-57db-9750-8314959c80f1" :step/next {:db/id #edb/ref 17592186532759}} {:db/id #edb/ref 17592186532738 :step/content {:db/id #edb/ref 17592186532723 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "380d9a49-c6d8-5c6c-aad5-cf5792818606" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{39}{10}" :db/id #edb/ref 17592186532046} {:answer/id #uuid "55366fad-0795-57d6-85e8-4f68957d0932" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186532117} {:answer/id #uuid "5ce8cb92-d753-507f-8961-5d82ee267410" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{43}{10}" :db/id #edb/ref 17592186532136} {:answer/id #uuid "88a10e65-44ad-55c3-b17c-5d31a83466d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{31}{5}" :db/id #edb/ref 17592186532244} {:answer/id #uuid "be4996ff-8496-533e-9142-f9c34a17d2a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{61}{10}" :db/id #edb/ref 17592186532342}] :answer-field/correct {:db/id #edb/ref 17592186532136} :answer-field/id #uuid "ff7568f3-47d5-56fb-a003-0872e000e58b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186532619}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "faa87228-4c67-51da-9af8-97fb8de0d515" :question/math-academy-id "q-13190" :question/problem "Evaluate the integral ${\\int }_{0}^{1}x{(1+x)}^{4}\\,\\text{d}x.$" :question/worked-solution "Let $u=1+x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that $x=u-1.$\n\nComputing our limits of integration, we get\n\n| **$x$** | $0$ | $1$ |\n| --- | --- | --- |\n| **$u$** | $1$ | $2$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}x{(1+x)}^{4}\\,\\text{d}x & ={\\int }_{1}^{2}(u-1){u}^{4}\\,\\text{d}u \\\\  & ={\\int }_{1}^{2}({u}^{5}-{u}^{4})\\,\\text{d}u \\\\  & ={(\\frac{1}{6}{u}^{6}-\\frac{1}{5}{u}^{5})|}_{1}^{2} \\\\  & =\\frac{1}{6}({2}^{6}-{1}^{6})-\\frac{1}{5}({2}^{5}-{1}^{5}) \\\\  & =\\frac{1}{6}(64-1)-\\frac{1}{5}(32-1) \\\\  & =\\frac{63}{6}-\\frac{31}{5} \\\\  & =\\frac{21}{2}-\\frac{31}{5} \\\\  & =\\frac{43}{10}\\end{aligned}\n$$"} :step/id #uuid "4c5492c8-87b7-5ec2-85d4-d931b3796a40" :step/next {:db/id #edb/ref 17592186532727}} {:db/id #edb/ref 17592186532748 :step/content {:db/id #edb/ref 17592186292610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3244d82b-0c46-53a8-a660-f9290373702b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{7}\\sqrt{(1-x)^{7}}-\\frac{4}{5}\\sqrt[5]{(1-x)^{4}}+\\sqrt{(1-x)^{3}}+C" :db/id #edb/ref 17592186290834} {:answer/id #uuid "39d5bebf-6cd0-585d-82cb-e1a9d8d22ac7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{7}\\sqrt[5]{(1-x)^{7}}+\\frac{4}{5}\\sqrt[5]{(1-x)^{4}}-\\frac{2}{3}\\sqrt[5]{(1-x)^{2}}+C" :db/id #edb/ref 17592186290873} {:answer/id #uuid "832e2443-c62a-52bc-a01a-c04f3bfe80ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{7}\\sqrt{(1-x)^{7}}+\\frac{4}{5}\\sqrt{(1-x)^{5}}-\\frac{2}{3}\\sqrt{(1-x)^{3}}+C" :db/id #edb/ref 17592186291188} {:answer/id #uuid "9dbb02ca-90cb-5702-8097-54a2c304eaff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2{x}^{2}}{7}-{x}^{2}+C" :db/id #edb/ref 17592186291317} {:answer/id #uuid "ef92ec5b-c1fe-5e63-956a-e6526b88cd0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{5}\\sqrt{{x}^{9}}+\\frac{2}{7}\\sqrt{{x}^{3}}-\\frac{5}{3}\\sqrt{{x}^{3}}+C" :db/id #edb/ref 17592186291634}] :answer-field/correct {:db/id #edb/ref 17592186291188} :answer-field/id #uuid "b0bc0d7e-9c01-5db9-a9e1-8f9aad1e4e7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186292282}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "056e1c78-a9bb-5b9a-a3a2-7b12402a4162" :question/math-academy-id "q-2615" :question/problem "Calculate the integral $\\int {x}^{2}\\sqrt{1-x}\\,\\text{d}x.$" :question/worked-solution "Let $u=1-x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe also note that\n$x=1-u.$\n\nNow we can solve the integral in terms of $u,$ and then express our final answer in terms of $x:$\n\n$$\n\\begin{aligned}\\int {x}^{2}\\sqrt{1-x}\\,\\text{d}x & =-\\int (1-u)^{2}\\sqrt{u}\\,\\text{d}u \\\\  & =-\\int ({u}^{2}-2u+1)\\sqrt{u}\\,\\text{d}u \\\\  & =-\\int ({u}^{5/2}-2{u}^{3/2}+{u}^{1/2})\\,\\text{d}u \\\\  & =-(\\frac{2}{7}{u}^{7/2}-\\frac{4}{5}{u}^{5/2}+\\frac{2}{3}{u}^{3/2})+C \\\\  & =-\\frac{2}{7}\\sqrt{(1-x)^{7}}+\\frac{4}{5}\\sqrt{(1-x)^{5}}-\\frac{2}{3}\\sqrt{(1-x)^{3}}+C\\end{aligned}\n$$"} :step/id #uuid "b0ee86a5-a043-569a-8183-cad05fa71d88" :step/next {:db/id #edb/ref 17592186532764}} {:db/id #edb/ref 17592186532759 :step/content {:db/id #edb/ref 17592186532643 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "224c5398-c047-573f-95f0-b412ddff5a5f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int ({u}^{1/4}-3{u}^{-1/4})\\text{d}u" :db/id #edb/ref 17592186532005} {:answer/id #uuid "29884f8a-7e32-5907-a04f-c79f0b1e1354" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int {u}^{5/4}\\,\\text{d}u" :db/id #edb/ref 17592186532015} {:answer/id #uuid "3b263d64-e19f-5c23-b3db-3e186e391929" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int ({u}^{5/4}-3{u}^{1/4})\\text{d}u" :db/id #edb/ref 17592186532056} {:answer/id #uuid "5a6ac55b-549f-597d-a76b-816ff07700f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int ({u}^{5/4}+3{u}^{1/4})\\text{d}u" :db/id #edb/ref 17592186532133} {:answer/id #uuid "a394660e-4646-564e-9eaf-6f37082eeb48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int 3{u}^{1/4}\\,\\text{d}u" :db/id #edb/ref 17592186532302}] :answer-field/correct {:db/id #edb/ref 17592186532056} :answer-field/id #uuid "f1104bd1-f1f5-5680-a66e-cd85a4936d91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186532608}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3c5b79b6-c034-52ce-8e7b-d57a11d334d9" :question/math-academy-id "q-49530" :question/problem "Given that $u=x+3$, which integral is equivalent to $\\int x\\sqrt[4]{x+3}\\,\\text{d}x?$" :question/worked-solution "Since $u=x+3$, then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that\n$x=u-3.$\n\nNow we can rewrite the integral in terms of $u:$\n\n$$\n\\begin{aligned}\\int x\\sqrt[4]{x+3}\\,\\text{d}x & =\\int (u-3)(\\sqrt[4]{u})(\\text{d}u) \\\\  & =\\int (u-3)({u}^{1/4})\\text{d}u \\\\  & =\\int ({u}^{5/4}-3{u}^{1/4})\\text{d}u\\end{aligned}\n$$"} :step/id #uuid "da7c3597-d493-5043-8d99-feea500d55ed"} {:db/id #edb/ref 17592186532764 :step/content {:db/id #edb/ref 17592186064493 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdb53822-baac-5fae-8a07-525bb09bc52f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{15}" :db/id #edb/ref 17592186061189} {:answer/id #uuid "e753abe3-d3c9-5f7d-a9c4-602a29ff1716" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186061190} {:answer/id #uuid "338b62cb-de73-5c0d-8f35-0c6b209b10af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186061191} {:answer/id #uuid "4afa4a18-33d9-58b0-9dea-2b58714682fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186061192} {:answer/id #uuid "6ca0f78d-1bc7-59a2-9ac0-7f822a56a9fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{15}" :db/id #edb/ref 17592186061193}] :answer-field/correct {:db/id #edb/ref 17592186061193} :answer-field/id #uuid "2e7252c6-0f89-5144-8e64-8a0780e8107d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186061188}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "73f175e7-2f1a-5340-97b3-b6e69ba4df75" :question/math-academy-id "q-12910" :question/problem "Evaluate the integral ${\\int }_{-1/3}^{0}9x\\sqrt{3x+1}\\,\\text{d}x.$" :question/worked-solution "Let $u=3x+1.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe also note that $x=\\frac{1}{3}(u-1).$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $-1/3$ | $0$ |\n| --- | --- | --- |\n| **$u$** | $0$ | $1$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}9x\\sqrt{3x+1}\\,\\text{d}x & =9{\\int }_{-1/3}^{0}\\frac{u-1}{3}\\cdot \\sqrt{u}\\cdot \\frac{1}{3}\\text{d}u \\\\  & ={\\int }_{0}^{1}({u}^{3/2}-{u}^{1/2})\\,\\text{d}u \\\\  & ={(\\frac{1}{5/2}{u}^{5/2}-\\frac{1}{3/2}{u}^{3/2})|}_{0}^{1} \\\\  & ={(\\frac{2}{5}{u}^{5/2}-\\frac{2}{3}{u}^{3/2})|}_{0}^{1} \\\\  & =(\\frac{2}{5}\\cdot {1}^{5/2}-\\frac{2}{3}\\cdot {1}^{3/2})-(\\frac{2}{5}\\cdot {0}^{5/2}-\\frac{2}{3}\\cdot {0}^{3/2}) \\\\  & =\\frac{2}{5}-\\frac{2}{3} \\\\  & =-\\frac{4}{15}\\end{aligned}\n$$"} :step/id #uuid "f525329b-4628-591f-9051-adc95ac0570d" :step/next {:db/id #edb/ref 17592186532738}}] :activity/title "Further Integration of Algebraic Functions Using Substitution" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186531932}]}
