edb/ref 17592186443361} {:answer/id #uuid "c0c9127c-1f8f-54b4-a574-68f61068a6c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{\\sqrt{5}}" :db/id #edb/ref 17592186443364} {:answer/id #uuid "fca67b72-0824-5575-aa9e-9952d5126b36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186443386}] :answer-field/correct {:db/id #edb/ref 17592186443326} :answer-field/id #uuid "bdb7b068-f570-5e7a-8102-dc37c8fd15fd" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186443400} {:answer-field/choices [{:answer/id #uuid "0a9942cf-8883-5465-9f9d-7cad02983e8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{1}+2{x}_{2}=0" :db/id #edb/ref 17592186443320} {:answer/id #uuid "cc7b5cd3-1a26-57e2-b623-050e1fc0b5a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{1}-2{x}_{2}=0" :db/id #edb/ref 17592186443369} {:answer/id #uuid "e4ae6692-ab66-5a63-8a7b-a7e5d34c5b66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{1}+{x}_{2}=0" :db/id #edb/ref 17592186443380}] :answer-field/correct {:db/id #edb/ref 17592186443320} :answer-field/id #uuid "bde64c22-aceb-5850-9ac5-72a00519f50e" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186443401} {:answer-field/choices [{:answer/id #uuid "6db2170e-6d68-506c-9502-70ce6638e801" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{5}}" :db/id #edb/ref 17592186443351} {:answer/id #uuid "8162952b-25ff-5751-b514-1df0444e28a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186443356} {:answer/id #uuid "976676e3-03b4-5114-aff4-30c7c54fc42f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186443359} {:answer/id #uuid "e39dec8b-217e-525b-bce6-1e9025c172d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186443379}] :answer-field/correct {:db/id #edb/ref 17592186443359} :answer-field/id #uuid "cd7c56fa-7567-5c85-b0fb-c825f694718e" :answer-field/key "field-9" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186443403} {:answer-field/choices [{:answer/id #uuid "0e882974-a608-5b59-80b3-81a5ab2ccd4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{1}" :db/id #edb/ref 17592186443323} {:answer/id #uuid "27a95bd3-7a95-5ddc-ad8e-1cefe25e8a3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{3}" :db/id #edb/ref 17592186443330} {:answer/id #uuid "d910eab7-7132-5df5-b3c3-2fcc4066ae76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{2}" :db/id #edb/ref 17592186443373}] :answer-field/correct {:db/id #edb/ref 17592186443330} :answer-field/id #uuid "d28e5083-6111-5659-843b-b5cd8118683f" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186443404}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c1d729e8-d1cb-584b-b25e-2da8d463c255" :question/math-academy-id "q-363831" :question/problem "$$\nA=[\\begin{aligned}1 & 0 \\\\ 2 & 0 \\\\ 0 & 0\\end{aligned}],\\,Σ=[\\begin{aligned}\\sqrt{5} & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$  select the correct options in the computations of the matrix $U$ below.\n\nFrom the matrix $Σ,$ we deduce the singular values ${\\sigma }_{1}=\\sqrt{5}$ and ${\\sigma }_{2}=0.$\n\nNow, we compute the $1$st column of $U.$ It is given by:\n\n|  |  | $\\frac{1}{\\sqrt{5}}$ |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{1}=\\,\\,$ |  | {{field-1}} |  |  |\n|  |  | {{field-2}} |  |  |\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal.\n\nHence, we must find vectors $u=[{x}_{1},{x}_{2},{x}_{3}]^{T}$ such that ${u}_{1}\\cdot u=0,$ which is equivalent to \n\n$$\n{{field-3}}.\n$$\n\nChoosing ${x}_{2}$ and ${x}_{3}$ as free variables, the general solution is given by:\n\n|  |  | {{field-4}} |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | ${x}_{2}$ |  |  |\n|  |  | {{field-5}} |  |  |\n\nthat we can rewrite as\n\n$$\n[\\begin{aligned}-2{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}-2 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\nSince the two linearly independent solutions are already mutually orthogonal, we only need to normalize them. Hence, we obtain the second and third columns of $U:$\n\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{2}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-6}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-7}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{3}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-8}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                $0$\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-9}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=\\sqrt{5}$ and ${\\sigma }_{2}=0.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 & 0 \\\\ 2 & 0 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n\\frac{1}{\\sqrt{5}}{x}_{1}+\\frac{2}{\\sqrt{5}}{x}_{2}=0\\,⟹\\,{x}_{1}+2{x}_{2}=0,\n$$\n\nwe get the general solution \n\n$$\n[\\begin{aligned}-2{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}{{[\\begin{aligned}-2 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{1}}+{x}_{3}{{[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{2}$ and ${x}_{3}$ are free variables.\n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are mutually orthogonal. Therefore, we only need to normalize them. This gives the second and third columns of $U:$   \n\n$$\n{u}_{2}=[\\begin{aligned}-\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} \\\\ 0\\end{aligned}]\\,{u}_{3}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=[\\begin{aligned}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} & 0 \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} & 0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$"} :step/id #uuid "5a94b1d8-d50b-579a-8ea5-b08b0054b5d6"} {:db/id #edb/ref 17592186443411 :step/content {:db/id #edb/ref 17592186443408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31349149-08bd-53c6-9790-133dc7f5909c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186443332} {:answer/id #uuid "5de404de-f9b7-5dcf-ac57-f91f9957b36e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186443344} {:answer/id #uuid "69452e64-abf8-591a-a3d7-07720185da50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{10}}" :db/id #edb/ref 17592186443348} {:answer/id #uuid "b8c5740c-7b0b-5df5-aa14-6fc680d3ae4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{\\sqrt{10}}" :db/id #edb/ref 17592186443363}] :answer-field/correct {:db/id #edb/ref 17592186443332} :answer-field/id #uuid "00eaf422-de51-5a43-85c1-1733b5dc804e" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186443387} {:answer-field/choices [{:answer/id #uuid "014504c3-0095-55b6-8054-cf1b5f903c3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/v