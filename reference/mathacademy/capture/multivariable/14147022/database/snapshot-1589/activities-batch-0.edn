/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186407969}] :answer-field/correct {:db/id #edb/ref 17592186407940} :answer-field/id #uuid "91772e07-6e83-565d-8d1d-447dc5cf55b9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186408010} {:answer-field/choices [{:answer/id #uuid "10d8fe6f-3fe3-591d-80d2-9322b40f15c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{2}" :db/id #edb/ref 17592186407930} {:answer/id #uuid "2cb1b16c-228a-53c6-bc72-290681a250be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}_{2}" :db/id #edb/ref 17592186407942} {:answer/id #uuid "544c002b-6b57-5583-89b8-67a7d06c0b26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{3}" :db/id #edb/ref 17592186407954}] :answer-field/correct {:db/id #edb/ref 17592186407942} :answer-field/id #uuid "afc3e8b3-a87f-5531-aae5-172d75b90c7e" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186408012} {:answer-field/choices [{:answer/id #uuid "4455544e-1077-5786-b06c-150acd59d6fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186407948} {:answer/id #uuid "6c2134d3-5c63-527e-a367-c4e15b3128a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186407960} {:answer/id #uuid "d6d89300-f274-5947-89f2-4dd9342a4461" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186407990} {:answer/id #uuid "fa65a387-f6f5-504b-81e1-39a527975374" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{\\sqrt{5}}" :db/id #edb/ref 17592186407999}] :answer-field/correct {:db/id #edb/ref 17592186407960} :answer-field/id #uuid "b6d311e0-db87-5b4a-a093-65e9a5132977" :answer-field/key "field-8" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186408013} {:answer-field/choices [{:answer/id #uuid "1e8e16aa-191a-5372-aa42-d5a08358d79e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{\\sqrt{5}}" :db/id #edb/ref 17592186407938} {:answer/id #uuid "74bf3992-372f-5111-a0cc-c5cca1984f9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186407963} {:answer/id #uuid "8a71b845-85d4-5a63-a9d5-527efe5e00c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186407971} {:answer/id #uuid "a2a6f415-cf18-5af4-9313-4328606d45f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186407980}] :answer-field/correct {:db/id #edb/ref 17592186407938} :answer-field/id #uuid "cbde57c7-70c1-5c69-87cc-b1fd63b4d9b6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186408014} {:answer-field/choices [{:answer/id #uuid "4c16a768-b599-5785-b070-c28d17347a2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}_{2}+2{x}_{3}=0" :db/id #edb/ref 17592186407951} {:answer/id #uuid "59e61e3c-25e1-597c-8f73-9ab521a5d21a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}_{1}+2{x}_{2}=0" :db/id #edb/ref 17592186407956} {:answer/id #uuid "6d2882da-ca37-552c-a1de-3a04e1d44be5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{1}+2{x}_{2}=0" :db/id #edb/ref 17592186407961}] :answer-field/correct {:db/id #edb/ref 17592186407956} :answer-field/id #uuid "e2cdbe7e-0ba6-527c-a1aa-10e0c93ae65c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186408018}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "891e3ecc-7d6f-5b4d-a28c-fc1c71a2a958" :question/math-academy-id "q-363823" :question/problem "$$\nA=[\\begin{aligned}1 & -2 \\\\ -2 & 4 \\\\ 0 & 0\\end{aligned}],\\,Σ=[\\begin{aligned}5 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$  select the correct options in the computations of the matrix $U$ below.\n\nFrom the matrix $Σ,$ we deduce the singular values ${\\sigma }_{1}=5$ and ${\\sigma }_{2}=0.$\n\nNow, we compute the $1$st column of $U.$ It is given by:\n\n|  |  | {{field-1}} |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{1}=\\,\\,$ |  | {{field-2}} |  |  |\n|  |  | $0$ |  |  |\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal.\n\nHence, we must find vectors $u=[{x}_{1},{x}_{2},{x}_{3}]^{T}$ such that ${u}_{1}\\cdot u=0,$ which is equivalent to \n\n$$\n{{field-3}}.\n$$\n\nChoosing ${x}_{2}$ and ${x}_{3}$ as free variables, the general solution is given by:\n\n|  |  | {{field-4}} |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | {{field-5}} |  |  |\n|  |  | ${x}_{3}$ |  |  |\n\nthat we can rewrite as\n\n$$\n[\\begin{aligned}2{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\nSince the two linearly independent solutions are already mutually orthogonal, we only need to normalize them. Hence, we obtain the second and third columns of $U:$\n\n| | ${u}_{2}=\\,\\,$ |  | {{field-6}} |  |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-7}} |  |  |  |\n|  | $0$ |  |  |  | | | ${u}_{3}=\\,\\,$ |  | {{field-8}} |  |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-9}} |  |  |  |\n|  | $1$ |  |  |  | |\n| --- | --- |" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=5$ and ${\\sigma }_{2}=0.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{5}[\\begin{aligned}1 & -2 \\\\ -2 & 4 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}] \\\\  & =\\frac{1}{5}[\\begin{aligned}-\\sqrt{5} \\\\ 2\\sqrt{5} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n-\\frac{1}{\\sqrt{5}}{x}_{1}+\\frac{2}{\\sqrt{5}}{x}_{2}=0\\,⟹\\,-{x}_{1}+2{x}_{2}=0,\n$$\n\nwe get the general solution \n\n$$\n[\\begin{aligned}2{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]={x}_{2}{{[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{b}_{1}}+{x}_{3}{{[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{2}$ and ${x}_{3}$ are free variables.\n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are mutually orthogonal. Therefore, we only need to normalize them. This gives the second and third columns of $U:$   \n\n$$\n{u}_{2}=[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} \\\\ 0\\end{aligned}]\\,{u}_{3}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} & 0 \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} & 0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$"} :step/id #uuid "e6c10cae-3311-5de0-80be-f4f348e2b025" :step/next {:db/id #edb/ref 17592186408022}}] :activity/title "Singular Value Decomposition of Larger Matrices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186407928}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186430361} :activity/id #uuid "7a17cc21-6ccb-5439-ab56-b058df3482c5" :activity/scope {:db/id #edb/ref 17592186048143 :topic/id #uuid "82e1668e-936b-52f4-a230-dc0cb3dc1f13" :topic/math-academy-id 3133} :activity/steps [{:db/id #edb/ref 17592186430361 :step/content {:db/id #edb/ref 17592186162712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46ec70b2-790d-582b-8940-37eea292ae4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186430279} {:answer/id #uuid "4d30fcb9-4e9c-5480-91f8-be9027ba4304" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186430281} {:answer/id #uuid "5ea213a0-7cb0-59f5-98bd-30dcad60aa90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186430287} {:answer/id #uuid "84575063-53ca-5b2a-94b3-9e965df7c601" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186430299} {:answer/id #uuid "d346a1ab-d6ee-5497-ae67-93ca1862ead9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186430325}] :answer-field/correct {:db/id #edb/ref 17592186430325} :answer-field/id #uuid "53075006-3bde-5335-a07e-7b2f11fef0a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186161564}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0acab5c5-194e-580b-922b-276032b93c12" :question/math-academy-id "q-97365" :question/problem "$$\nA=[\\begin{aligned}0 & 0 \\\\ 2 & 2 \\\\ 1 & -2\\end{aligned}],\\,Σ=[\\begin{aligned}3 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=3$ and ${\\sigma }_{2}=2.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{3}[\\begin{aligned}0 & 0 \\\\ 2 & 2 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}0 \\\\ \\frac{6}{\\sqrt{5}} \\\\ -\\frac{3}{\\sqrt{5}}\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ \\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{2}[\\begin{aligned}0 & 0 \\\\ 2 & 2 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}-\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}0 \\\\ -\\frac{2}{\\sqrt{5}} \\\\ -\\frac{4}{\\sqrt{5}}\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ -\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0,\\end{aligned}\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\{\\begin{aligned}\\frac{2}{\\sqrt{5}}{x}_{2}-\\frac{1}{\\sqrt{5}}{x}_{3}=0 \\\\ -\\frac{1}{\\sqrt{5}}{x}_{2}-\\frac{2}{\\sqrt{5}}{x}_{3}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}2{x}_{2}-{x}_{3}=0 \\\\ -{x}_{2}-2{x}_{3}=0,\\end{aligned}\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}].\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=[\\begin{aligned}0 & 0 & 1 \\\\ \\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} & 0 \\\\ -\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} & 0\\end{aligned}]\n$$"} :step/id #uuid "6ec7950f-72d8-5bef-a77f-3f5e2a3e06a0" :step/next {:db/id #edb/ref 17592186430364}} {:db/id #edb/ref 17592186430362 :step/content {:db/id #edb/ref 17592186430360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "457a3842-15d8-5552-b245-a07a1675cac2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{x}_{3}" :db/id #edb/ref 17592186430278} {:answer/id #uuid "5cd9661f-8ecd-52f0-bb59-99f0d617f957" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{2}" :db/id #edb/ref 17592186430285} {:answer/id #uuid "aaf668ec-1209-510a-bec2-b439