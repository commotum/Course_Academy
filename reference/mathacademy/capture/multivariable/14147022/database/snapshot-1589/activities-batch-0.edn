f 17592186430274} {:answer/id #uuid "9ec21af1-5537-5589-890f-a2ccdb43295f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}_{1}-2{x}_{2}" :db/id #edb/ref 17592186430306}] :answer-field/correct {:db/id #edb/ref 17592186430306} :answer-field/id #uuid "d4931c23-68ae-5da4-81ee-3c97dd4f6730" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186430353} {:answer-field/choices [{:answer/id #uuid "08e2fd28-e984-57d1-8558-2dee685815ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186430260} {:answer/id #uuid "c8b54516-7b77-5569-9f95-fa0f95479108" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{\\sqrt{3}}" :db/id #edb/ref 17592186430323} {:answer/id #uuid "de097139-a41f-5439-b54c-56a6b53cd33c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186430330} {:answer/id #uuid "e81798a6-e7a3-5f6e-8cf2-7fa5b96fad65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\sqrt{3}}" :db/id #edb/ref 17592186430333}] :answer-field/correct {:db/id #edb/ref 17592186430260} :answer-field/id #uuid "d9812805-4969-5cfb-a3b4-aa190fc21fbd" :answer-field/key "field-10" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186430354} {:answer-field/choices [{:answer/id #uuid "33325077-8e81-5e76-95ce-82a85580172a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186430272} {:answer/id #uuid "3c0e1e15-8527-5c4e-9353-2a0ba96bfc76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186430275} {:answer/id #uuid "5d8ef10a-7c98-5f4a-ac31-8d86b122f115" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186430286} {:answer/id #uuid "d385eee2-ba38-56fd-b945-b5dc27aba628" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186430326}] :answer-field/correct {:db/id #edb/ref 17592186430275} :answer-field/id #uuid "dc8e70a8-daaa-5f24-ad61-245827641b0b" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186430355} {:answer-field/choices [{:answer/id #uuid "6548d6b5-487d-54bf-ae20-579bcc0c1f15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{1}" :db/id #edb/ref 17592186430288} {:answer/id #uuid "95c3ac78-d00e-59a3-84fc-7c652182e808" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{x}_{1}" :db/id #edb/ref 17592186430303} {:answer/id #uuid "c2c5b684-52c7-5af3-b745-dc21f72e1303" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}_{2}" :db/id #edb/ref 17592186430321}] :answer-field/correct {:db/id #edb/ref 17592186430288} :answer-field/id #uuid "fc6db4d2-ea1d-5421-a0db-e24e2e0720aa" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186430358}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0ba1751d-87a5-51c1-9c47-8e0f1eb46649" :question/math-academy-id "q-363846" :question/problem "$$\nA=[\\begin{aligned}1 & 1 \\\\ 2 & 2 \\\\ 1 & 1\\end{aligned}],\\,Σ=[\\begin{aligned}2\\sqrt{3} & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$  select the correct options in the computations of the matrix $U$ below.\n\nFrom the matrix $Σ,$ we deduce the singular values ${\\sigma }_{1}=2\\sqrt{3}$ and ${\\sigma }_{2}=0.$\n\nNow, we compute the $1$st column of $U.$ It is given by:\n\n|  |  | {{field-1}} |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{1}=\\,\\,$ |  | {{field-2}} |  |  |\n|  |  | $\\frac{1}{\\sqrt{6}}$ |  |  |\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal.\n\nHence, we must find vectors $u=[{x}_{1},{x}_{2},{x}_{3}]^{T}$ such that ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n{{field-3}}.\n$$\n\nChoosing ${x}_{1}$ and ${x}_{2}$ as free variables, the general solution is given by:\n\n|  |  | {{field-4}} |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | ${x}_{2}$ |  |  |\n|  |  | {{field-5}} |  |  |\n\nthat we can rewrite as:\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ -{x}_{1}-2{x}_{2}\\end{aligned}]={x}_{1}{{[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]}_{⏟}}_{{b}_{1}}+{x}_{2}{{[\\begin{aligned}0 \\\\ 1 \\\\ -2\\end{aligned}]}_{⏟}}_{{b}_{2}}.\n$$\n\nNext, we orthogonalize ${b}_{1}$ and ${b}_{2}$ using the Gram-Schmidt process to get the corresponding orthogonal vectors ${c}_{1}$ and ${c}_{2}.$\n\nLet ${c}_{1}={b}_{1},$ then:\n\n|  |  | {{field-6}} |  |  |\n| --- | --- | --- | --- | --- |\n| ${c}_{2}=\\,\\,$ |  | $1$ |  |  |\n|  |  | {{field-7}} |  |  |\n\nFinally, normalizing orthogonal vectors ${c}_{1}$ and ${c}_{2},$ we obtain the second and third columns of $U:$   \n\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{2}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-8}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-9}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                $-\\frac{1}{\\sqrt{2}}$\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{3}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-10}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                $\\frac{1}{\\sqrt{3}}$\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-11}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=2\\sqrt{3}$ and ${\\sigma }_{2}=0.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{2\\sqrt{3}}[\\begin{aligned}1 & 1 \\\\ 2 & 2 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{1}{2\\sqrt{3}}[\\begin{aligned}\\sqrt{2} \\\\ 2\\sqrt{2} \\\\ \\sqrt{2}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{6}} \\\\ \\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{6}}\\end{aligned}]\\end{aligned}\n$$\n\n  \n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n\\frac{1}{\\sqrt{6}}{x}_{1}+\\frac{2}{\\sqrt{6}}{x}_{2}+\\frac{1}{\\sqrt{6}}{x}_{3}=0\\,⟹\\,{x}_{1}+2{x}_{2}+{x}_{3}=0,\n$$\n\nwe get the general solution \n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ -{x}_{1}-2{x}_{2}\\end{aligned}]={x}_{1}{{[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]}_{⏟}}_{{b}_{1}}+{x}_{2}{{[\\begin{aligned}0 \\\\ 1 \\\\ -2\\end{aligned}]}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{1}$ and ${x}_{2}$ are free variables. \n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are *not* mutually orthogonal. Therefore, we have to orthogonalize them using the Gram-Schmidt process. So, let \n\n$$\n{c}_{1}={b}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}].\n$$\n\nThen,\n\n$$\n\\begin{aligned}{c}_{2} & ={b}_{2}-\\frac{{b}_{2}\\cdot {c}_{1}}{{c}_{1}\\cdot {c}_{1}}{c}_{1}=[\\begin{aligned}0 \\\\ 1 \\\\ -2\\end{aligned}]-\\frac{2}{2}[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nFinally, normalizing orthogonal vectors ${c}_{1}$ and ${c}_{2},$ we obtain the second and third columns of $U:$   \n\n$$\n{u}_{2}=[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}],\\,{u}_{3}=[\\begin{aligned}-\\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}}\\end{aligned}]\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=[\\begin{aligned}\\frac{1}{\\sqrt{6}} & \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{3}} \\\\ \\frac{2}{\\sqrt{6}} & 0 & \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{6}} & -\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{3}}\\end{aligned}]\n$$"} :step/id #uuid "db830862-a12c-5ef8-aeb2-df43d7cd0bdb"} {:db/id #edb/ref 17592186430364 :step/content {:db/id #edb/ref 17592186371422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65acaa42-33cd-5757-90f9-4d51036d283f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186371424} {:answer/id #uuid "c9e77905-5ec8-56d5-8779-68fa5b781883" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186371425} {:answer/id #uuid "97daab37-f8ae-5701-b85b-b2e30894a4f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 \\\\ -\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}]" :db/id #edb/ref 17592186371426} {:answer/id #uuid "b4e0b9ef-caf7-5749-a8a6-77538e234c6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186371427} {:answer/id #uuid "a5fd5a22-26d6-55d8-a7db-98cfc7d4ab6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186371428}] :answer-field/correct {:db/id #edb/ref 17592186371426} :answer-field/id #uuid "89ed90b3-a22c-5487-9e5f-dfdcd163748b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186371423}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fd52405b-2747-5b7b-9ac8-728557a18405" :question/math-academy-id "q-98769" :question/problem "$$\nA=[\\begin{aligned}0 & 2 \\\\ -2 & 0 \\\\ -1 & 0\\end{aligned}],\\,Σ=[\\begin{aligned}\\sqrt{5} & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=\\sqrt{5}$ and ${\\sigma }_{2}=2.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{5}}[\\begin{aligned}0 & 2 \\\\ -2 & 0 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{5}}[\\begin{aligned}0 \\\\ -2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ -\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{2}[\\begin{aligned}0 & 2 \\\\ -2 & 0 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 \\\\ 0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0,\\end{aligned}\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\{\\begin{aligned}-\\frac{2}{\\sqrt{5}}{x}_{2}-\\frac{1}{\\sqrt{5}}{x}_{3}=0 \\\\ {x}_{1}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}2{x}_{2}+{x}_{3}=0 \\\\ {x}_{1}=0,\\end{aligned}\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=[\\begin{aligned}0 \\\\ -\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}].\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=[\\begin{aligned}0 & 1 & 0 \\\\ -\\frac{2}{\\sqrt{5}} & 0 & -\\frac{1}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}} & 0 & \\frac{2}{\\sqrt{5}}\\end{aligned}]\n$$"} :step/id #uuid "f69ed049-06d6-5162-954f-63ae0c151052" :step/next {:db/id #edb/ref 17592186430362}}] :activity/title "Singular Value Decomposition of Larger Matrices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186430259}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186443409} :activity/id #uuid "93b447e0-191c-560c-ac25-bc9695d12742" :activity/scope {:db/id #edb/ref 17592186048143 :topic/id #uuid "82e1668e-936b-52f4-a230-dc0cb3dc1f13" :topic/math-academy-id 3133} :activity/steps [{:db/id #edb/ref 17592186443409 :step/content {:db/id #edb/ref 17592186443406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d08e6f7-0c8c-5a19-bed7-db8dc41af65e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186443350} {:answer/id #uuid "7e31c437-06d1-5826-9cb1-4684802533dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186443354} {:answer/id #uuid "89017994-b329-5175-a753-3bf33a611163" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}0 \\\\ -\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186443358} {:answer/id #uuid "c6c810b0-869e-5ce1-8f1a-3a1e0dbb11d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}\\frac{1}{3} \\\\ -\\frac{2}{3} \\\\ -\\frac{2}{3}\\end{aligned}]" :db/id #edb/ref 17592186443367} {:answer/id #uuid "dd9ebd11-88f5-552e-b5e4-2988eb8b37a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-\\frac{2}{3} \\\\ -\\frac{1}{3} \\\\ \\frac{2}{3}\\end{aligned}]" :db/id #edb/ref 17592186443377}] :answer-field/correct {:db/id #edb/ref 17592186443377} :answer-field/id #uuid "5c8bfdef-6f81-5a7f-8190-7d981c16e459" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186443393}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "77278df4-e113-5900-8941-27a77a33d7c4" :question/math-academy-id "q-98696" :question/problem "$$\nA=[\\begin{aligned}0 & 1 \\\\ -2 & -2 \\\\ -1 & 0\\end{aligned}],\\,Σ=[\\begin{aligned}3 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the $3$rd column of the matrix $U?$" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=3$ and ${\\sigma }_{2}=1.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the $1$st and $2$nd columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{3}[\\begin{aligned}0 & 1 \\\\ -2 & -2 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{4}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{3\\sqrt{2}} \\\\ -\\frac{4}{3\\sqrt{2}} \\\\ -\\frac{1}{3\\sqrt{2}}\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{1}[\\begin{aligned}0 & 1 \\\\ -2 & -2 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ 0 \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]\\end{aligned}\n$$\n\nSince we do not have the third singular value, we can't use the same formula to find the third column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector \n\n$$\n{u}_{3}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n\\{\\begin{aligned}{u}_{1}\\cdot {u}_{3}=0 \\\\ {u}_{2}\\cdot {u}_{3}=0,\\end{aligned}\\,‖{u}_{3}‖=1.\n$$\n\nSolving this system, which is equivalent to\n\n$$\n\\{\\begin{aligned}\\frac{1}{3\\sqrt{2}}{x}_{1}-\\frac{4}{3\\sqrt{2}}{x}_{2}-\\frac{1}{3\\sqrt{2}}{x}_{3}=0 \\\\ \\frac{1}{\\sqrt{2}}{x}_{1}+\\frac{1}{\\sqrt{2}}{x}_{3}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{x}_{1}-4{x}_{2}-{x}_{3}=0 \\\\ {x}_{1}+{x}_{3}=0,\\end{aligned}\n$$\n\nwe get the nonzero normalized solution \n\n$$\n{u}_{3}=[\\begin{aligned}-\\frac{2}{3} \\\\ -\\frac{1}{3} \\\\ \\frac{2}{3}\\end{aligned}].\n$$\n\nFinally, we construct the matrix $U:$\n\n$$\nU=[\\begin{aligned}\\frac{1}{3\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & -\\frac{2}{3} \\\\ -\\frac{4}{3\\sqrt{2}} & 0 & -\\frac{1}{3} \\\\ -\\frac{1}{3\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & \\frac{2}{3}\\end{aligned}]\n$$"} :step/id #uuid "46bb3e49-3990-5b69-ab08-fafc145eef1c" :step/next {:db/id #edb/ref 17592186443411}} {:db/id #edb/ref 17592186443410 :step/content {:db/id #edb/ref 17592186443407 :question/answer-fields [{:answer-f