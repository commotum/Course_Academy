2}}+\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(9x+1-\\frac{1}{x})}{(5+\\frac{3}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(9x+1-0)}{(5+0)} \\\\  & =\\frac{1}{5}{lim}_{x\\to \\infty }(9x+1) \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."} :step/id #uuid "5368d0b9-16cf-515a-9649-1cc3a2d20352" :step/next {:db/id #edb/ref 17592186503808}} {:db/id #edb/ref 17592186503789 :step/content {:db/id #edb/ref 17592186503740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12c051ac-16d1-53b0-af08-3845e1f80fcd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186503020} {:answer/id #uuid "716a5576-1477-5d48-9fac-ce2b26ac1535" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=9" :db/id #edb/ref 17592186503210} {:answer/id #uuid "c22ddc25-362a-57ac-b9a3-be8479d6a75e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{3}{2}" :db/id #edb/ref 17592186503371} {:answer/id #uuid "d43bf7b4-779c-5786-81da-db083c00f923" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=1" :db/id #edb/ref 17592186503403} {:answer/id #uuid "fe457f6b-9fd9-5669-9e55-7cc5d248f357" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186503507}] :answer-field/correct {:db/id #edb/ref 17592186503020} :answer-field/id #uuid "8358f70b-40f4-51c5-ad82-e863f6db2422" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186503579}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c664e1c1-92ad-575b-bafc-9b1ddd2a888d" :question/math-academy-id "q-35762" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{9}{{x}^{2}-6}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{9}{{x}^{2}-6} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{9}{{x}^{2}})}{(\\frac{{x}^{2}}{{x}^{2}}-\\frac{6}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{9}{{x}^{2}})}{(1-\\frac{6}{{x}^{2}})} \\\\  & =\\frac{0}{1-0} \\\\  & =0.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote of $f(x)$ is $y=0.$"} :step/id #uuid "59b57cb6-2983-5ca5-88d0-67859be7b64b" :step/next {:db/id #edb/ref 17592186503831}} {:db/id #edb/ref 17592186503808 :step/content {:db/id #edb/ref 17592186503750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d555f50e-bb12-5374-8350-a9ef5d7a920d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty" :db/id #edb/ref 17592186503405}] :answer-field/correct {:db/id #edb/ref 17592186503405} :answer-field/id #uuid "1152ef23-8437-51aa-a9aa-c16e05bf2bcd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186503522}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e026e16b-5d19-5563-a374-d9f17e04bfda" :question/math-academy-id "q-339604" :question/problem "Evaluate the limit:\n\n${lim}_{x\\to \\infty }\\,\\,\\frac{{x}^{5}+5x+3}{{x}^{4}-2}=$\n\n{{field-1}}" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{4}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\,\\,\\frac{{x}^{5}+5x+3}{{x}^{4}-2} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{{x}^{5}}{{x}^{4}}+\\frac{5x}{{x}^{4}}+\\frac{3}{{x}^{4}})}{(\\frac{{x}^{4}}{{x}^{4}}-\\frac{2}{{x}^{4}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(x+\\frac{5}{{x}^{3}}+\\frac{3}{{x}^{4}})}{(1-\\frac{2}{{x}^{4}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\text{ }\\frac{x+0+0}{1-0} \\\\  & ={lim}_{x\\to \\infty }\\,\\,x \\\\  & =\\infty .\\end{aligned}\n$$"} :step/id #uuid "8ff8a17a-a0a5-5493-8d28-ed7607b31cac" :step/next {:db/id #edb/ref 17592186503821}} {:db/id #edb/ref 17592186503821 :step/content {:db/id #edb/ref 17592186503667 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c937735b-3bc6-54e6-933f-6f49c7d3c312" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186503382}] :answer-field/correct {:db/id #edb/ref 17592186503382} :answer-field/id #uuid "fb3beee4-cb24-5c90-9eb7-a8526064661d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186503642}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "223b3e58-bcca-5fb5-a51e-27d487af6492" :question/math-academy-id "q-339640" :question/problem "The horizontal asymptote of the function $f(x)=\\frac{2{x}^{3}-1}{{x}^{5}-2x}$ is\n\n$y=$\n{{field-1}}." :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{5}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{2{x}^{3}-1}{{x}^{5}-2x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2{x}^{3}}{{x}^{5}}-\\frac{1}{{x}^{5}})}{(\\frac{{x}^{5}}{{x}^{5}}-\\frac{2x}{{x}^{5}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2}{{x}^{2}}-\\frac{1}{{x}^{5}})}{(1-\\frac{2}{{x}^{4}})} \\\\  & =\\frac{0-0}{1-0} \\\\  & =0.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote of $f(x)$ is $y=0.$"} :step/id #uuid "c3e3b25f-2076-5174-b242-050566e2054d"} {:db/id #edb/ref 17592186503831 :step/content {:db/id #edb/ref 17592186124921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "544fe8c0-00d7-5582-9b43-a7537bdb2cd4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186321810} {:answer/id #uuid "8d44af16-7047-5688-8bee-4018f24233a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-1" :db/id #edb/ref 17592186322274} {:answer/id #uuid "b0f05e28-da65-5e0b-9cd3-41729a024a5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=1" :db/id #edb/ref 17592186322534} {:answer/id #uuid "b324732c-ba06-52ac-9465-f950f027ee85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186322547} {:answer/id #uuid "d8824ca2-db5e-5819-9375-3a960341c205" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-3" :db/id #edb/ref 17592186322841}] :answer-field/correct {:db/id #edb/ref 17592186321810} :answer-field/id #uuid "1017af27-6db1-5bfd-9bf5-b120516afb73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323200}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d5a61e3c-7091-5d14-ae25-993daf76ef12" :question/math-academy-id "q-35834" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{12x-3{x}^{4}}{3{x}^{2}+7}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{12x-3{x}^{4}}{3{x}^{2}+7} \\\\  & {lim}_{x\\to \\infty }\\frac{(\\frac{12x}{{x}^{2}}-\\frac{3{x}^{4}}{{x}^{2}})}{(\\frac{3{x}^{2}}{{x}^{2}}+\\frac{7}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{12}{x}-3{x}^{2})}{(3+\\frac{7}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{0-3{x}^{2}}{3+0} \\\\  & ={lim}_{x\\to \\infty }(-{x}^{2}) \\\\  & =-\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."} :step/id #uuid "e49c9b88-a758-5641-97ee-f59eae216336" :step/next {:db/id #edb/ref 17592186503787}}] :activity/title "Limits at Infinity and Horizontal Asymptotes of Rational Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186502968}] [{:activity/first-step {:db/id #edb/ref 17592186079268} :activity/id #uuid "128934d0-aa66-5625-aab3-6d772fa10846" :activity/scope {:db/id #edb/ref 17592186050643 :topic/id #uuid "5ba94c26-75d7-5806-9fad-73f65947835b" :topic/math-academy-id 637} :activity/steps [{:db/id #edb/ref 17592186079268 :step/content {:db/id #edb/ref 17592186079652 :tutorial/content "Suppose that we wish to calculate the limit\n\n$$\nL=\\lim\\limits_{h\\to 0} \\dfrac{\\ln(2+h) -\\ln(2)}{h}\n$$\n\nThe key here is to notice that the limit looks very similar to the instantaneous rate of change formula,\n\n$$\nf'(a) = \\lim\\limits_{h\\to 0} \\dfrac{f(a+h)-f(a)}{h}\n$$\n\nfor the function\n\n$$\nf(x) = \\ln x\n$$\n\nat $a=2$.\n\nLet's substitute\n\n$$\nf(x) = \\ln x\n$$\n\nand $a=2$ into the above, just to be sure:\n\n$$\n\\begin{aligned}\nf^{′}(2) &= lim_(h → 0)(f(2 + h) - f(2))/(h) \\\\\n&= lim_(h → 0)(\\ln (2 + h) - \\ln (2))/(h) \\\\\n&= L\n\\end{aligned}\n$$\n\nThis confirms that $L = f'(2)$. So instead of working out that difficult limit, we only need to work out $f'(2)$.\n\nComputing the derivative, we have\n\n$$\nf'(x) = \\frac{1}{x}, \\qquad f'(2) = \\dfrac{1}{2}\n$$\n\nand therefore we conclude that\n\n$$\nL=\\dfrac{1}{2}\n$$" :tutorial/id #uuid "db8ca187-38da-5852-8df8-cd1cb0f754cc" :tutorial/math-academy-id 2631 :tutorial/title "Introduction"} :step/id #uuid "3b7e08e0-d936-5e59-996f-679f185c3562" :step/math-academy-id 12352 :step/next {:db/id #edb/ref 17592186079269}} {:db/id #edb/ref 17592186079269 :step/content {:db/id #edb/ref 17592186078407 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078279 :question/id #uuid "5f4f75ce-d8df-5970-bffe-99beb9d9aac9" :question/math-academy-id "e-3650"} :knowledge-point/id #uuid "3f5c089a-9506-5a0e-83ae-48efa8fd314c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048749} {:db/id #edb/ref 17592186049362} {:db/id #edb/ref 17592186050420} {:db/id #edb/ref 17592186050690}] :knowledge-point/questions [{:db/id #edb/ref 17592186078958} {:db/id #edb/ref 17592186079002} {:db/id #edb/ref 17592186234076}] :knowledge-point/title "Recognizing Derivatives in Limits Similar to the Instantaneous Rate of Change Formula"} :step/id #uuid "cca4127e-8b00-5649-abdf-3f0477315c35" :step/math-academy-id 12353 :step/next {:db/id #edb/ref 17592186079270}} {:db/id #edb/ref 17592186079270 :step/content {:db/id #edb/ref 17592186079653 :tutorial/content "We can apply the same method for calculating limits that are similar to the equivalent definition of the derivative,\n\n$$\nf'(a) = \\lim\\limits_{x\\to a} \\dfrac{f(x)-f(a)}{x-a}\n$$\n\nIt is important to choose the correct form for each limit. If the numerator of the limit looks like $f(a+h) -f(a)$ for some $a$ and the denominator looks like $h$, then use the form\n\n$$\n\\lim\\limits_{h\\to 0} \\dfrac{f(x+h)-f(x)}{h}\n$$\n\nBut if the numerator looks like $f(x)-f(a)$ and the denominator looks like $x-a$ for some $a$, then use the form\n\n$$\n\\lim\\limits_{x\\to a} \\dfrac{f(x)-f(a)}{x-a}\n$$" :tutorial/id #uuid "88b647b7-8adf-517b-848b-5323c6565ced" :tutorial/math-academy-id 2632 :tutorial/title "Recognizing the Equivalent Definition of the Derivative in Limits"} :step/id #uuid "a1fec940-4ec4-58c8-8553-9ddb7fd70bff" :step/math-academy-id 12354 :step/next {:db/id #edb/ref 17592186079271}} {:db/id #edb/ref 17592186079271 :step/content {:db/id #edb/ref 17592186078408 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078280 :question/id #uuid "3b5966f8-c23f-5ef1-8e5c-7862a020402d" :question/math-academy-id "e-3651"} :knowledge-point/id #uuid "1b613bf7-a641-547f-8487-d6af0da0f724" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048465}] :knowledge-point/questions [{:db/id #edb/ref 17592186078965} {:db/id #edb/ref 17592186079003} {:db/id #edb/ref 17592186507431} {:db/id #edb/ref 17592186507452} {:db/id #edb/ref 17592186507480} {:db/id #edb/ref 17592186522712}] :knowledge-point/title "Recognizing Derivatives in Limits Similar to the Equivalent Definition of the Derivative"} :step/id #uuid "4bbfd52a-c53b-5698-a9e3-0f3cadd9059f" :step/math-academy-id 12355 :step/next {:db/id #edb/ref 17592186079272}} {:db/id #edb/ref 17592186079272 :step/content {:db/id #edb/ref 17592186078409 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078281 :question/id #uuid "4a42aea1-4927-5d6e-af94-d43b834e295a" :question/math-academy-id "e-3652"} :knowledge-point/id #uuid "20df0d0d-a94e-55e6-8d19-25a566ab794d" :knowledge-point/questions [{:db/id #edb/ref 17592186079004} {:db/id #edb/ref 17592186079005} {:db/id #edb/ref 17592186507463} {:db/id #edb/ref 17592186507501}] :knowledge-point/title "Computing Limits Equivalent to a Derivative Using a Graph"} :step/id #uuid "6d9b76a5-30f4-5ef3-8887-46953ed35bc3" :step/math-academy-id 12356}] :activity/title "Recognizing Derivatives in Limits" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078660}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186507581} :activity/id #uuid "52ac8d49-41b5-5bd8-bf9d-dfa1ea8ebfa8" :activity/scope {:db/id #edb/ref 17592186050643 :topic/id #uuid "5ba94c26-75d7-5806-9fad-73f65947835b" :topic/math-academy-id 637} :activity/steps [{:db/id #edb/ref 17592186507532 :step/content {:db/id #edb/ref 17592186507452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33710c61-22d6-514d-a654-305c39257be0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186506801}] :answer-field/correct {:db/id #edb/ref 17592186506801} :answer-field/id #uuid "0dd58159-33f5-5db7-909d-d7a72f3ebd4b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186507249}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7fe715dd-222c-5303-8e5d-661af680f9ac" :question/math-academy-id "q-314062" :question/problem "${lim}_{x\\to \\pi /4}\\,\\frac{\\operatorname{cos}⁡(x)-\\frac{\\sqrt{2}}{2}}{x-\\frac{\\pi }{4}}=${{field-1}}" :question/worked-solution "First, we let\n\n$$\nL={lim}_{x\\to \\pi /4}\\,\\frac{\\operatorname{cos}⁡(x)-\\frac{\\sqrt{2}}{2}}{x-\\frac{\\pi }{4}}.\n$$\n\nComparing this with the formula for the instantaneous rate of change\n\n$$\n{f}^{′}(a)={lim}_{x\\to a}\\frac{f(x)-f(a)}{x-a},\n$$\n\nwe see that if we let $f(x)=\\operatorname{cos}⁡(x)$ and $a=\\frac{\\pi }{4}$, we get\n\n$$\n\\begin{aligned}{f}^{′}\\,(\\frac{\\pi }{4}) & ={lim}_{x\\to \\pi /4}\\frac{f(x)-f\\,(\\frac{\\pi }{4})}{x-\\frac{\\pi }{4}} \\\\  & ={lim}_{x\\to \\pi /4}\\frac{\\operatorname{cos}⁡(x)-cos\\,(\\frac{\\pi }{4})}{x-\\frac{\\pi }{4}} \\\\  & ={lim}_{x\\to \\pi /4}\\frac{\\operatorname{cos}⁡(x)-\\frac{\\sqrt{2}}{2}}{x-\\frac{\\pi }{4}}=L.\\end{aligned}\n$$\n\n \n\nThis confirms that $L={f}^{′}\\,(\\frac{\\pi }{4}).$\n\nComputing the derivative, we have\n\n$$\n{f}^{′}(x)=-\\operatorname{sin}⁡(x),\\,{f}^{′}\\,(\\frac{\\pi }{4})=-sin\\,(\\frac{\\pi }{4})=-\\frac{\\sqrt{2}}{2},\n$$\n\nand therefore, we conclude that $L=-\\frac{\\sqrt{2}}{2}.$"} :step/id #uuid "06ee9d72-c64c-59d0-a5fe-be8ba76923b4" :step/next {:db/id #edb/ref 17592186507593}} {:db/id #edb/ref 17592186507534 :step/content {:db/id #edb/ref 17592186507480 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d5ff7cc-8b3f-5a39-aa5b-ab6f585428d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186506701} {:answer/id #uuid "11e63def-7844-5262-ab80-238e82afc4a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186506715} {:answer/id #uuid "3f7e125d-4a64-5403-b4f5-240ac6952b77" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Does not exist" :db/id #edb/ref 17592186506826} {:answer/id #uuid "7c767c64-2e2b-560b-95b1-27629324438c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186506952} {:answer/id #uuid "ff94670c-c1ce-57cc-9599-b00476cfd5ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186507237}] :answer-field/correct {:db/id #edb/ref 17592186506701} :answer-field/id #uuid "0b3df459-f0ab-5ba2-a113-901da7e7d2cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507248}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ac305827-2b68-5246-9f72-b59f76116099" :question/math-academy-id "q-104948" :question/problem "${lim}_{x\\to 2}\\frac{{x}^{2}-4}{x-2}=$" :question/worked-solution "First, we let\n\n$$\nL={lim}_{x\\to 2}\\frac{{x}^{2}-4}{x-2}.\n$$\n\nComparing this with the formula for the instantaneous rate of change\n\n$$\n{f}^{′}(a)={lim}_{x\\to a}\\frac{f(x)-f(a)}{x-a},\n$$\n\nwe see that if we let $f(x)={x}^{2}$ and $a=2$, we get\n\n$$\n\\begin{aligned}{f}^{′}(2) & ={lim}_{x\\to 2}\\frac{f(x)-f(2)}{x-2} \\\\  & ={lim}_{x\\to 2}\\frac{{x}^{2}-{2}^{2}}{x-2} \\\\  & ={lim}_{x\\to 2}\\frac{{x}^{2}-4}{x-2}=L.\\end{aligned}\n$$\n\nThis confirms that $L={f}^{′}(2).$\n\nComputing the derivative, we have\n\n$$\n{f}^{′}(x)=2x,\\,{f}^{′}(2)=2\\cdot 2=4,\n$$\n\nand therefore we conclude that $L=4.$"} :step/id #uuid "0ffadd5f-2484-54bc-aafa-ecea2ecea3f2" :step/next {:db/id #edb/ref 17592186507536}} {:db/id #edb/ref 17592186507536 :step/content {:db/id #edb/ref 17592186507501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bb6a2c0-9b12-5d02-8114-ec93e9fd1dbb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186506895} {:answer/id #uuid "96e83254-6e53-5553-a48a-26aa54776b50" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186507006} {:answer/id #uuid "a27838c1-ffc6-51e6-ad62-1715c0672f2c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186507029} {:answer/id #uuid "b0ec119b-815d-53e3-b075-5f37bb3efbc2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186507069} {:answer/id #uuid "c8fd154a-9418-5779-9f22-3520453bf8fc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186507116}] :answer-field/correct {:db/id #edb/ref 17592186506895} :answer-field/id #uuid "008a3a74-eacb-51da-8605-e2fef59db043" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507240}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cbf6525f-a6b2-5d79-bc38-725ad8dae9c2" :question/math-academy-id "q-104976" :question/problem "![](images/e0/e03f453156d57af94b13b76e22dc366644b18f56acc5f9a5f4a2c005e6bec3f7.png)\n\nWhich of the following statements are true regarding the graph of the function $y=f(x)$ shown above?\n\nI. ${lim}_{h\\to 0}\\frac{f(h)-f(0)}{h}=0$\n\nII. ${lim}_{h\\to 0}\\frac{f(1+h)-f(1)}{h}=-1$\n\nIII. ${lim}_{h\\to 0}\\frac{f(3+h)-f(3)}{h}=-1$" :question/worked-solution "Comparing these limits with the formula for the instantaneous rate of change\n\n$$\n{f}^{′}(a)={lim}_{h\\to 0}\\frac{f(a+h)-f(a)}{h},\n$$\n\nwe see that \n\n$$\n\\begin{aligned}{lim}_{h\\to 0}\\frac{f(h)-f(0)}{h} & ={f}^{′}(0), \\\\ {lim}_{h\\to 0}\\frac{f(1+h)-f(1)}{h} & ={f}^{′}(1), \\\\ {lim}_{h\\to 0}\\frac{f(3+h)-f(3)}{h} & ={f}^{′}(3).\\end{aligned}\n$$\n\nThe function consists of three line segments. Inspecting the graph, we see that\n\n- for $-4<x<-1$, we have ${f}^{′}(x)=-1,$\n\n- for $-1<x<1$, we have ${f}^{′}(x)=0,$\n\n- for $1<x<4$, we have ${f}^{′}(x)=-1,$\n\n The derivative does not exist at $x=\\pm 1.$ So, we have  \n\n$$\n\\begin{aligned}{lim}_{h\\to 0}\\frac{f(h)-f(0)}{h} & =0, \\\\ {lim}_{h\\to 0}\\frac{f(1+h)-f(1)}{h} & =\\text{DNE}, \\\\ {lim}_{h\\to 0}\\frac{f(3+h)-f(3)}{h} & =-1.\\end{aligned}\n$$\n\nTherefore, only statements I and III are true."} :step/id #uuid "13697faa-c07f-521a-ba76-9771a21a0d13" :step/next {:db/id #edb/ref 17592186507532}} {:db/id #edb/ref 17592186507581 :step/content {:db/id #edb/ref 17592186507463 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02ebd984-f944-5735-935d-58b8e1d12c65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186506683} {:answer/id #uuid "3faecea9-9832-54b2-afe3-75ade1b40121" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II" :db/id #edb/ref 17592186506827} {:answer/id #uuid "7d3d8d44-88a4-5931-b74f-49ee9adea60b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III" :db/id #edb/ref 17592186506953} {:answer/id #uuid "c047a9a1-43b8-5862-adef-5be69f583fa9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186507100} {:answer/id #uuid "d19e8196-e4ed-521f-b41a-81344a83bfe3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III" :db/id #edb/ref 17592186507135}] :answer-field/correct {:db/id #edb/ref 17592186507135} :answer-field/id #uuid "c755ac45-18f2-5688-96b0-fcf97a72209f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507362}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9b3df8bd-2ae3-52a2-905f-ded2bd184071" :question/math-academy-id "q-48459" :question/problem "![](images/72/72e1d1f1ea1aa635441da5503a49ac4d33d5ab0df62d48aa699debc7816df1c2.png)\n\nWhich of the following statements are true regarding the graph of the function $y=f(x)$ shown above? \n\nI. ${lim}_{h\\to 0}\\frac{f(-2+h)-f(-2)}{h}=1$\n\nII. ${lim}_{h\\to 0}\\frac{f(h)-f(0)}{h}=-0.5$\n\nIII. ${lim}_{h\\to 0}\\frac{f(-3+h)-f(-3)}{h}=1$" :question/worked-solution "Comparing these limits with the formula for the instantaneous rate of change\n\n$$\n{f}^{′}(a)={lim}_{h\\to 0}\\frac{f(a+h)-f(a)}{h},\n$$\n\nwe see that \n\n$$\n\\begin{aligned}{lim}_{h\\to 0}\\frac{f(-2+h)-f(-2)}{h} & ={f}^{′}(-2), \\\\ {lim}_{h\\to 0}\\frac{f(h)-f(0)}{h} & ={f}^{′}(0), \\\\ {lim}_{h\\to 0}\\frac{f(-3+h)-f(-3)}{h} & ={f}^{′}(-3).\\end{aligned}\n$$\n\nThe function consists of three line segments. Inspecting the graph, we see that\n\n- for $x<-1$, we have  ${f}^{′}(x)=1,$\n\n- for $-1<x<1$, we have  ${f}^{′}(x)=-1,$\n\n- for $x>1$, we have  ${f}^{′}(x)=1.$\n\nThe derivative does not exist at $x=-1$ and $x=1$ . So we have\n\n$$\n\\begin{aligned}{lim}_{h\\to 0}\\frac{f(-2+h)-f(-2)}{h} & =1, \\\\ {lim}_{h\\to 0}\\frac{f(h)-f(0)}{h} & =-1, \\\\ {lim}_{h\\to 0}\\frac{f(-3+h)-f(-3)}{h} & =1.\\end{aligned}\n$$\n\nTherefore, only I and III are true."} :step/id #uuid "d8a08a0e-66bf-57d5-87e6-30f1a5ddd9cb" :step/next {:db/id #edb/ref 17592186507534}} {:db/id #edb/ref 17592186507593 :step/content {:db/id #edb/ref 17592186507431 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6a23679-6599-5401-aade-8321affdc088" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186507184}] :answer-field/correct {:db/id #edb/ref 17592186507184} :answer-field/id #uuid "101d9dd4-dd5a-5b40-bb06-cc4f4eee42ea" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186507251}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "453b5d73-89c7-511f-b2be-1d3d4f762507" :question/math-academy-id "q-339039" :question/problem "${lim}_{x\\to 5}\\frac{{x}^{2}-25}{x-5}=${{field-1}}" :question/worked-solution "First, we let\n\n$$\nL={lim}_{x\\to 5}\\frac{{x}^{2}-25}{x-5}.\n$$\n\nComparing this with the formula for the instantaneous rate of change\n\n$$\n{f}^{′}(a)={lim}_{x\\to a}\\frac{f(x)-f(a)}{x-a},\n$$\n\nwe see that if we let $f(x)={x}^{2}$ and $a=5$, we get\n\n$$\n\\begin{aligned}{f}^{′}(5) & ={lim}_{x\\to 5}\\frac{f(x)-f(5)}{x-5} \\\\  & ={lim}_{x\\to 5}\\frac{{x}^{2}-{5}^{2}}{x-5} \\\\  & ={lim}_{x\\to 5}\\frac{{x}^{2}-25}{x-5}=L.\\end{aligned}\n$$\n\nThis confirms that $L={f}^{′}(5).$\n\nComputing the derivative, we have\n\n$$\n{f}^{′}(x)=2x,\\,{f}^{′}(5)=2\\cdot 5=10,\n$$\n\nand therefore, we conclude that $L=10.$"} :step/id #uuid "fcabb837-cb68-532d-838f-39c9a0d91ee1"}] :activity/title "Recognizing Derivatives in Limits" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186506668}] [{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186134975} :activity/id #uuid "66b245e8-8d46-5eb6-a9cb-721c5323145e" :activity/scope {:db/id #edb/ref 17592186050810 :topic/id #uuid "6869b952-1056-567b-aee7-9b79143e8e5f" :topic/math-academy-id 2150} :activity/steps [{:db/id #edb/ref 17592186134752 :step/content {:db/id #edb/ref 17592186133832 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133647 :question/id #uuid "e32fb82c-2e8f-5383-b15a-8f98aa86b716" :question/math-academy-id "e-6753"} :knowledge-point/id #uuid "7d01d143-68f2-534a-8be6-4f63f9ab0d40" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050574}] :knowledge-point/questions [{:db/id #edb/ref 17592186134476} {:db/id #edb/ref 17592186134477} {:db/id #edb/ref 17592186241091} {:db/id #edb/ref 17592186329880} {:db/id #edb/ref 17592186329881} {:db/id #edb/ref 17592186329884} {:db/id #edb/ref 17592186329885} {:db/id #edb/ref 17592186511499} {:db/id #edb/ref 17592186511503} {:db/id #edb/ref 17592186511518} {:db/id #edb/ref 17592186511583}] :knowledge-point/title "Completing a Statement On the Intermediate Value Theorem"} :step/id #uuid "e944fcc1-fe2f-5c5d-9768-0e36d6d884b9" :step/math-academy-id 24962 :step/next {:db/id #edb/ref 17592186134976}} {:db/id #edb/ref 17592186134975 :step/content {:db/id #edb/ref 17592186135022 :tutorial/content "The **intermediate value theorem (IVT)** states that:\n\n*If $f(x)$ is continuous on $\\color{blue}[a,b],$ and $k$ is a number between $\\color{red}{f(a)}$ and $\\color{red}{f(b)}$ inclusively, then there exists a number $c \\in \\color{blue}{[a,b]}$ such that $f(c)=k.$*\n\nThe intuition behind the IVT is that if a function is continuous between two inputs, then between those two inputs, we must be able to draw the function without picking up our pen off the page, so the function must cover all values between the two corresponding outputs.\n\nThe IVT is often used to prove that some equation has a solution. For example, if we want to prove that there is a solution to $f(x)=3,$ and we know that $f(x)$ is a continuous function with $f({\\color{blue}{1}})={\\color{red}{2}}$ and $f({\\color{blue}{6}})={\\color{red}{6}},$ then the IVT tells us that there exists some solution $c \\in \\color{blue}{[1,6]}$ such that $f(c)=3.$\n\nWe can gain further intuition by visualizing the situation. First, let's plot what $y=f(x)$ *might* look like.\n\n![](images/98/9896ea1c3d3d7c461e78ce4b4b232ce1f13f329468cd28b2d8e743132de093df.png)\n\nFor this particular $f(x)$ there is one solution to $f(x)=3$, which is $x\\approx 2.$ Note that our solution lies inside the interval $\\color{blue}[1,6].$\n\nNow let's consider another *possible* $f(x).$\n\n![](images/de/dea5683d5b18bccf9623fb6a107e8ef818ddd1cef4adbef08be471869791ec27.png)\n\nThis time, there are three solutions to $f(x)=3$ which lie in the interval $\\color{blue}[1,6].$ \n\nWe can keep changing our $f(x),$ but no matter how we draw it, we will always have some solution to $f(x)=3$ which lies in the interval $\\color{blue}[1,6].$\n\n![](images/4d/4d4aaec84baff10a48f715eeae7e06af21beccd29b38c42b3283032ef0726fec.png)" :tutorial/id #uuid "9dc98e46-26fd-5ae1-b12b-05da48928cc5" :tutorial/math-academy-id 306 :tutorial/title "Introduction"} :step/id #uuid "b8f1b0d3-494f-537b-8e99-af2aca4fc4f6" :step/math-academy-id 564 :step/next {:db/id #edb/ref 17592186134752}} {:db/id #edb/ref 17592186134976 :step/content {:db/id #edb/ref 17592186133955 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133477 :question/id #uuid "bb373a5d-aa71-58ed-82e3-b74a8f51d144" :question/math-academy-id "e-114"} :knowledge-point/id #uuid "6388d315-340b-56a0-bc93-e380bfbf6ed3" :knowledge-point/questions [{:db/id #edb/ref 17592186134471} {:db/id #edb/ref 17592186134474} {:db/id #edb/ref 17592186241105} {:db/id #edb/ref 17592186348086} {:db/id #edb/ref 17592186397801} {:db/id #edb/ref 17592186398841} {:db/id #edb/ref 17592186511465} {:db/id #edb/ref 17592186511523} {:db/id #edb/ref 17592186522806}] :knowledge-point/title "Selecting a Specific Value For Which a Solution Is Guaranteed"} :step/id #uuid "ce1aa6a3-c0f2-525f-a909-c241964d206f" :step/math-academy-id 565 :step/next {:db/id #edb/ref 17592186134977}} {:db/id #edb/ref 17592186134977 :step/content {:db/id #edb/ref 17592186133956 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133478 :question/id #uuid "d048aae2-5773-5da7-ab18-35d41bfbb53a" :question/math-academy-id "e-115"} :knowledge-point/id #uuid "7dffa987-022c-52a2-bc21-cdace7455eab" :knowledge-point/questions [{:db/id #edb/ref 17592186134470} {:db/id #edb/ref 17592186134516} {:db/id #edb/ref 17592186317540} {:db/id #edb/ref 17592186329804} {:db/id #edb/ref 17592186348091} {:db/id #edb/ref 17592186348092} {:db/id #edb/ref 17592186399489} {:db/id #edb/ref 17592186511510} {:db/id #edb/ref 17592186511534}] :knowledge-point/title "Determining the Number of Solutions Given a Table of Values of a Continuous Function"} :step/id #uuid "804af12a-0f60-55f9-a36a-0d40e8fd270b" :step/math-academy-id 568 :step/next {:db/id #edb/ref 17592186134978}} {:db/id #edb/ref 17592186134978 :step/content {:db/id #edb/ref 17592186135023 :tutorial/content "Consider the function $f(x)$ given below.\n![](images/0d/0d18168108342ef8232063b58e46ef88cdff9fe54aa730dca872bc9755a42995.svg)\nCan we apply the intermediate value theorem to $f(x)$ on the interval $[1,4]?$\n\nRemember, the intermediate value theorem assumes that the function is continuous. Here, the function $f(x)$ not continuous on $[1,4].$ So, we cannot apply the intermediate value theorem.\n\nIf we plot the function, we can get an idea of why the intermediate value theorem cannot be applied.\n\n![](images/9b/9b9543ec11b350cea4ca18e24a8db6ae8f72ffc38e64f973f9af2f83f1226400.png)\n\nThe graph shows that, for example, the equation $f(x)=1.5$ has no solution on $[1,4]$ despite the fact that $1.5$ lies between $f(1)=4$ and $f(4)=0.$\nSo, the intermediate value theorem does not hold.\n\n**Watch out!** The interval on which we apply the intermediate value theorem must *always* be closed. For example, we can't apply the theorem on an interval like $[1,3).$" :tutorial/id #uuid "a6571cd4-d390-5e75-907d-726b500e6976" :tutorial/math-academy-id 309 :tutorial/title "Why Does the Function Have to Be Continuous?"} :step/id #uuid "ec27384a-d1f9-523f-b3ef-d8bed946e5e0" :step/math-academy-id 570 :step/next {:db/id #edb/ref 17592186134979}} {:db/id #edb/ref 17592186134979 :step/content {:db/id #edb/ref 17592186133957 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133481 :question/id #uuid "89750383-d5a6-5bf4-b6b2-abd489e44d3c" :question/math-academy-id "e-116"} :knowledge-point/id #uuid "1012ae9a-26d6-50bf-a46a-7c859d856752" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051076}] :knowledge-point/questions [{:db/id #edb/ref 17592186134472} {:db/id #edb/ref 17592186134473} {:db/id #edb/ref 17592186241118} {:db/id #edb/ref 17592186329800} {:db/id #edb/ref 17592186329801} {:db/id #edb/ref 17592186329803} {:db/id #edb/ref 17592186398834} {:db/id #edb/ref 17592186511460} {:db/id #edb/ref 17592186511473}] :knowledge-point/title "Identifying Intervals On Which the IVT Can Be Applied"} :step/id #uuid "79d4ad5d-f388-5fc5-a8b7-a72f14369138" :step/math-academy-id 571}] :activity/title "The Intermediate Value Theorem" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134019}]}
