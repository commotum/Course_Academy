#{[{:db/id #edb/ref 17592186522796 :knowledge-point/_questions [{:db/id #edb/ref 17592186105857 :knowledge-point/id #uuid "fc04f720-28f3-55ab-8e89-582db57672a4" :knowledge-point/title "Computing the Limit at Infinity of a General Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6be8746c-50a8-5427-ac7a-c3e664b70b98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186522237}] :answer-field/correct {:answer/id #uuid "6be8746c-50a8-5427-ac7a-c3e664b70b98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186522237} :answer-field/id #uuid "2efa265e-7df1-5e6e-8acc-a153499df2a5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522574}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e3a057d6-ea56-5dc0-9a37-b812d961c933" :question/math-academy-id "q-133014" :question/problem "Evaluate ${lim}_{x\\to -\\infty }f(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to -\\infty }f(x)\\,=\\,$\n{{field-1}}" :question/worked-solution "First, as $x\\to -\\infty ,$ we can assume that $x<-4.$ So, we use the following expression for $f(x):$\n\n$$\nf(x)={x}^{2}+3x\n$$\n\nNow, we identify the leading term and compute its limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }({x}^{2}+3x) & ={lim}_{x\\to -\\infty }({x}^{2}) \\\\  & =\\infty \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522761 :knowledge-point/_questions [{:db/id #edb/ref 17592186078383 :knowledge-point/id #uuid "266c7322-6395-5e9b-ad8e-fe51f3c36665" :knowledge-point/title "Removing a Jump Discontinuity in a Piecewise Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1c3fd01-f3db-57d1-9bef-ae4866fbe270" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186522385}] :answer-field/correct {:answer/id #uuid "b1c3fd01-f3db-57d1-9bef-ae4866fbe270" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186522385} :answer-field/id #uuid "f3274d1e-2207-5135-9f1c-8aaf27706f61" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522679}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9a484d05-16dc-5a62-96c8-679e46043371" :question/math-academy-id "q-133015" :question/problem "Given that the function $f(x)$ is continuous at $x=-4,$ what is the value of $a?$\n\n$a\\,=\\,$\n{{field-1}}" :question/worked-solution "At $x=-4,$ the left-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-{4}^{-}}f(x) & ={lim}_{x\\to \\,-{4}^{-}}({x}^{2}+3x) \\\\  & =(-4)^{2}+3(-4) \\\\  & =4\\end{aligned}\n$$\n\nand the right-sided limit is\n\n$$\n{lim}_{x\\to \\,-{4}^{+}}f(x)=-5a.\n$$\n\nIn order for $f(x)$ to be continuous at $x=-4,$ we require that\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-{4}^{-}}f(x) & ={lim}_{x\\to \\,-{4}^{+}}f(x) \\\\ 4 & =-5a \\\\ a & =-\\frac{4}{5}.\\end{aligned}\n$$\n\nTherefore, $f(x)$ is continuous at $x=-4$ for $a=-\\frac{4}{5}.$"}] [{:db/id #edb/ref 17592186522695 :knowledge-point/_questions [{:db/id #edb/ref 17592186100978 :knowledge-point/id #uuid "bdd4a2e4-b0e6-54e8-972c-3dc194ce4ab3" :knowledge-point/title "Computing the One-Sided Limits of a Piecewise Function when the Limits Do Not Coincide"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f171767d-97fc-5130-814c-eb1b5c08256c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186522533}] :answer-field/correct {:answer/id #uuid "f171767d-97fc-5130-814c-eb1b5c08256c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186522533} :answer-field/id #uuid "52ef212c-d780-5d6b-9568-24925b4fb51e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522602}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "03ebca0d-b111-51a4-8281-85b0168f9966" :question/math-academy-id "q-133016" :question/problem "Find the right-sided limit of $f(x)$ at $x=-2.$\n\n${lim}_{x\\to \\,-{2}^{+}}f(x)\\,=\\,$\n{{field-1}}" :question/worked-solution "Approaching from the right, we have $-2<x<-1,$ so we use the expression \n\n$$\nf(x)=\\frac{{x}^{2}-1}{x+1}.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-{2}^{+}}f(x) & ={lim}_{x\\to \\,-{2}^{+}}\\frac{{x}^{2}-1}{x+1} \\\\  & =\\frac{(-2)^{2}-1}{-2+1} \\\\  & =\\frac{3}{-1} \\\\  & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522699 :knowledge-point/_questions [{:db/id #edb/ref 17592186119937 :knowledge-point/id #uuid "2072b915-15f9-5296-96dd-707e38df3d10" :knowledge-point/title "Calculating the Limit of a Rational Function With One Quadratic Term by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27999e64-0536-50d5-af50-89cd6f7eb347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186522110}] :answer-field/correct {:answer/id #uuid "27999e64-0536-50d5-af50-89cd6f7eb347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186522110} :answer-field/id #uuid "f3a6d1ef-faa6-53ff-8a34-359343416058" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522680}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0922b64e-eb7a-5dde-9dd1-94e76b652889" :question/math-academy-id "q-133017" :question/problem "Evaluate ${lim}_{x\\to -1}f(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to -1}f(x)\\,=\\,$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n{lim}_{x\\to \\,-1}\\frac{{x}^{2}-1}{x+1}=\\frac{(-1)^{2}-1}{-1+1}=\\frac{0}{0}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-1}{x+1} & =\\frac{(x+1)(x-1)}{x+1} \\\\  & =\\frac{\\cancel{(x+1)}(x-1)}{\\cancel{x+1}} \\\\  & =x-1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-1}f(x) & ={lim}_{x\\to \\,-1}\\frac{{x}^{2}-1}{x+1} \\\\  & ={lim}_{x\\to \\,-1}(x-1) \\\\  & =-1-1 \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522767 :knowledge-point/_questions [{:db/id #edb/ref 17592186100803 :knowledge-point/id #uuid "2cd56ebd-30ee-5acf-b691-5c2e5f485b52" :knowledge-point/title "Removing Point Discontinuities From Rational Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96da5d65-9510-57fc-97ad-17fccf48bdcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186522329}] :answer-field/correct {:answer/id #uuid "96da5d65-9510-57fc-97ad-17fccf48bdcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186522329} :answer-field/id #uuid "b39b90ad-7d77-5333-a15e-740deb119d51" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522647}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "af82e941-ed72-5bda-8079-22f3d0e5359a" :question/math-academy-id "q-133018" :question/problem "Given that the function $f(x)$ is continuous at $x=-1,$ what is the value of $b?$\n\n$b\\,=\\,$\n{{field-1}}" :question/worked-solution "Previously, we found that\n\n$$\n{lim}_{x\\to \\,-1}f(x)=-2.\n$$\n\nFor $f(x)$ to be continuous at $x=-1,$ we must have\n\n$$\n\\begin{aligned}f(-1) & ={lim}_{x\\to \\,-1}f(x) \\\\ 2b & =-2 \\\\ b & =-1\\end{aligned}\n$$\n\nTherefore, for the function to be continuous at $x=-1,$ we need $b=-1.$"}] [{:db/id #edb/ref 17592186522734 :knowledge-point/_questions [{:db/id #edb/ref 17592186124662 :knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0fc3bc0-4495-5062-ae38-1bffc23ec0e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186522353}] :answer-field/correct {:answer/id #uuid "a0fc3bc0-4495-5062-ae38-1bffc23ec0e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186522353} :answer-field/id #uuid "d0041f63-d78b-5da5-99c4-ad55d0e109f1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522657}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "68787380-f6be-5299-8d7e-90d33587bc3b" :question/math-academy-id "q-133019" :question/problem "Evaluate ${lim}_{x\\to \\infty }f(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\infty }f(x)\\,=\\,$\n{{field-1}}" :question/worked-solution "First, as $x\\to \\infty ,$ we can assume that $x>-1.$ So, we use the following expression for $f(x):$\n\n$$\nf(x)=\\frac{{x}^{2}-1}{x+1}\n$$\n\nNow, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is $x.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can evaluate the resulting expression:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{x}^{2}-1}{x+1} & ={lim}_{x\\to \\infty }\\frac{(\\frac{{x}^{2}}{x}-\\frac{1}{x})}{(\\frac{x}{x}+\\frac{1}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(x-\\frac{1}{x})}{(1+\\frac{1}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{x-0}{1+0} \\\\  & ={lim}_{x\\to \\infty }x \\\\  & =\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522806 :knowledge-point/_questions [{:db/id #edb/ref 17592186133955 :knowledge-point/id #uuid "6388d315-340b-56a0-bc93-e380bfbf6ed3" :knowledge-point/title "Selecting a Specific Value For Which a Solution Is Guaranteed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08b0f249-4156-5456-83fc-ea5f028e4459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186522033}] :answer-field/correct {:answer/id #uuid "08b0f249-4156-5456-83fc-ea5f028e4459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186522033} :answer-field/id #uuid "309df97e-fe05-56dc-8a9c-33f5a7cc5b96" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522579} {:answer-field/choices [{:answer/id #uuid "1f5b811f-6d2c-50c9-a9f1-7afe2b2f75a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186522089}] :answer-field/correct {:answer/id #uuid "1f5b811f-6d2c-50c9-a9f1-7afe2b2f75a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186522089} :answer-field/id #uuid "5081ce70-78db-5736-8383-df428ff21f68" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522601}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f39faa87-98f1-5160-9f77-61fba20bbf35" :question/math-academy-id "q-133020" :question/problem "Let $a=-\\frac{4}{5}.$ For what values of $k$ does the intermediate value theorem guarantee that $f(x)=k$ has a solution on the interval $x\\in [-5,-4]?$\n\n$k\\,\\in \\,[$\n{{field-1}}\n$,\\,$\n{{field-2}}\n$]$" :question/worked-solution "In part 2, we found that the function $f(x)$ is continuous on $[-5,-4]$ when $a=-\\frac{4}{5}.$ \n\nTherefore, the intermediate value theorem guarantees that $f(x)=k$ has a solution for each value of $k$ between $f(-5)$ and $f(-4).$\n\nSince \n\n$$\n\\begin{aligned}f(-5) & =(-5)^{2}+3(-5) \\\\  & =25-15 \\\\  & =10\\end{aligned}\n$$\n\nand \n\n$$\nf(-4)=-5\\cdot (-\\frac{4}{5})=4,\n$$\n\nwe must have \n\n$$\nk\\in [4,10].\n$$"}] [{:db/id #edb/ref 17592186522804 :knowledge-point/_questions [{:db/id #edb/ref 17592186115382 :knowledge-point/id #uuid "7dcbd56f-0fc2-59c5-a016-4272be4734c7" :knowledge-point/title "Determining the Points at Which a Function is Not Differentiable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "503f0033-51ba-519e-adbf-5435e315039b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186522190}] :answer-field/correct {:answer/id #uuid "503f0033-51ba-519e-adbf-5435e315039b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186522190} :answer-field/id #uuid "08000212-c184-5a8a-8664-9c25bb3f78b8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522559}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f2a0bc3d-d9da-5c57-bc24-c5c37731d915" :question/math-academy-id "q-133021" :question/problem "![](images/8f/8fdadf35d95d884dc3b8445e24525094f830e43190eb3d1a960bbb72eb489b9e.png)\n\nThe graph of $y=f(x)$ for $a=-\\frac{4}{5}$ and $b=-1$ is depicted above.\n\nFrom the graph, the function is continuous but not differentiable at $x\\,=$\n{{field-1}}" :question/worked-solution "A function is not differentiable wherever it has a discontinuity, corner, cusp, or vertical tangent.\n\n* At $x=-4$ the function has a corner point, so it's not differentiable there.\n\n* At $x=-2$ the function has a jump discontinuity, so it's not differentiable there.\n\nOf these two points, $f(x)$ is continuous only at $x=-4.$\n\nTherefore, the function $f(x)$ is continuous but not differentiable at $x=-4.$"}] [{:db/id #edb/ref 17592186522705 :knowledge-point/_questions [{:db/id #edb/ref 17592186175902 :knowledge-point/id #uuid "205c5518-c67a-5784-8cc7-55b42ce7fb0e" :knowledge-point/title "Determining Whether the Extreme Value Theorem Is Applicable to a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e075fff3-995b-5bc1-990f-ddaeac4db283" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186522495}] :answer-field/correct {:answer/id #uuid "e075fff3-995b-5bc1-990f-ddaeac4db283" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186522495} :answer-field/id #uuid "61182370-7c34-5d40-a704-11538eab0a52" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522607}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1d096d37-4b97-520b-934c-34762c2b679b" :question/math-academy-id "q-133022" :question/problem "Assume once again that $a=-\\frac{4}{5}$ and $b=-1,$ as in the previous part. Find the smallest **integer** value of $h$ such that the extreme value theorem is applicable to $f(x)$ on the interval $[h,3].$\n\n$h\\,=$\n{{field-1}}" :question/worked-solution "The extreme value theorem states the following:\n\n> *If $f(x)$ is a continuous function defined on the closed interval $[a,b],$ then $f(x)$ always has at least one global maximum and one global minimum on $[a,b]$*.\n\nSo, the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nThe smallest possible integer $h$ such that $f(x)$ is continuous on $[h,3]$ is $h=-1,$ as shown below.\n\n![](images/ab/ab92ed0c59facac4fccb050734aba133474c8a0585c6bd981abe7ea05ed0e6be.png)"}] [{:db/id #edb/ref 17592186522712 :knowledge-point/_questions [{:db/id #edb/ref 17592186078408 :knowledge-point/id #uuid "1b613bf7-a641-547f-8487-d6af0da0f724" :knowledge-point/title "Recognizing Derivatives in Limits Similar to the Equivalent Definition of the Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23d994be-8e53-5a61-8d62-8efbab138e45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186522102}] :answer-field/correct {:answer/id #uuid "23d994be-8e53-5a61-8d62-8efbab138e45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186522102} :answer-field/id #uuid "f655fa57-5080-53ed-ba58-e3495bc76cad" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186522682}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "33443770-e725-52a7-8dbb-99ea791df2cb" :question/math-academy-id "q-133023" :question/problem "Given that $f(x)={x}^{2}+3x$ for $x<-4,$ compute the value of ${lim}_{x\\to \\,-5}\\frac{f(x)-f(-5)}{x-(-5)}.$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,-5}\\frac{f(x)-f(-5)}{x-(-5)}\\,=$\n{{field-1}}" :question/worked-solution "First, comparing\n\n$$\n{lim}_{x\\to \\,-5}\\frac{f(x)-f(-5)}{x-(-5)}\n$$\n\nwith the formula for the instantaneous rate of change,\n\n$$\n{f}^{′}(a)={lim}_{x\\to \\,a}\\frac{f(x)-f(a)}{x-a},\n$$\n\nwe see that\n\n$$\n{lim}_{x\\to \\,-5}\\frac{f(x)-f(-5)}{x-(-5)}={f}^{′}(-5).\n$$\n\nNow, computing the derivative of $f$ for $x<-1,$ we have \n\n$$\n{f}^{′}(x)=2x+3,\n$$\n\nand therefore,\n\n$$\n{f}^{′}(-5)=2(-5)+3=-7.\n$$\n\nTherefore, we conclude that \n\n$$\n{lim}_{x\\to \\,-5}\\frac{f(x)-f(-5)}{x-(-5)}=-7.\n$$"}]}
