31c80a" #edb/ref 17592186045417] [17592186050952 #edb/ref 1027 #edb/ref 17592186050536 #edb/ref 17592186045417] [17592186050952 #edb/ref 1028 #edb/ref 17592186100813 #edb/ref 17592186045417] [17592186050952 #edb/ref 1028 #edb/ref 17592186100814 #edb/ref 17592186045417] [17592186050952 #edb/ref 1028 #edb/ref 17592186100815 #edb/ref 17592186045417] [17592186050952 #edb/ref 1031 "Optimizing Distances" #edb/ref 17592186045417] [17592186050952 #edb/ref 1033 1216 #edb/ref 17592186045417] [17592186050952 #edb/ref 1034 1.447359668376152 #edb/ref 17592186045436] [17592186050952 #edb/ref 1035 #uuid "74e56fe1-9849-55f7-a81d-e8d8802fb0dd" #edb/ref 17592186045417] [17592186198079 #edb/ref 1069 "e-12596" #edb/ref 17592186045417] [17592186198079 #edb/ref 1071 "![](images/ee/eec7d2b67f0b76bb8ec6874cf63f8cb09005f451d684924118983ea1aa39269c.png)\n\nThe $x$-coordinate of the point $P$ on the curve $y=\\ln \\left(\\dfrac{1}{x}\\right)$ that is closest to the origin (as shown above) satisfies the equation \n\n$$\n2x + \\bbox[3pt, border:1pt solid black]{\\phantom{AAAA^2}}=0.\n$$\n\n \nWhat is the missing expression?" #edb/ref 17592186045417] [17592186198079 #edb/ref 1072 #uuid "39ffb646-57fa-5d6d-a81f-286948f66d83" #edb/ref 17592186045417] [17592186198079 #edb/ref 1074 "Let's consider the *squared* distance $S$ between $(0,0)$ and a general point $P(x, y)\\mathbin{:}$ \n\n$$\n\\begin{aligned}S(x,y) & =(x-0)^{2}+(y-0)^{2} \\\\  & ={x}^{2}+{y}^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\ln \\left(\\dfrac{1}{x}\\right).$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & ={x}^{2}+{y}^{2} \\\\  & ={x}^{2}+{(\\operatorname{ln}⁡(\\frac{1}{x}))}^{2} \\\\  & ={x}^{2}+{ln}^{2}⁡(\\frac{1}{x})\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x+2\\operatorname{ln}⁡(\\frac{1}{x})\\cdot \\frac{1}{(\\frac{1}{x})}\\cdot (-\\frac{1}{{x}^{2}}) & =0 \\\\ 2x-\\frac{2}{x}\\operatorname{ln}⁡(\\frac{1}{x}) & =0 \\\\ 2x-\\frac{2}{x}(\\operatorname{ln}⁡1-\\operatorname{ln}⁡x) & =0 \\\\ 2x+\\frac{2\\operatorname{ln}⁡x}{x} & =0\\end{aligned}\n$$\n\nTherefore, the missing expression is $\\dfrac{2\\ln x}{x}.$" #edb/ref 17592186045417] [17592186198080 #edb/ref 1069 "e-12597" #edb/ref 17592186045417] [17592186198080 #edb/ref 1071 "Find the $x$-coordinates of the points on the curve $y=x^2$ that are closest to the point $\\left( 0, \\dfrac{3}{2} \\right).$" #edb/ref 17592186045417] [17592186198080 #edb/ref 1072 #uuid "4b55bd03-c8ad-55b2-a51e-7f875d382627" #edb/ref 17592186045417] [17592186198080 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $\\left( 0, \\dfrac{3}{2} \\right)$ and a general point $P(x, y)$:\n\n$$\nS = x^2 + \\left(y- \\dfrac{3}{2} \\right)^2\n$$\n\nWe require that the point $P$ lies on the curve $y=x^2.$ Substituting this into the above gives\n\n$$\n\\eqalign{\nS(x) &=  x^2 + \\left(y- \\dfrac{3}{2} \\right)^2  \\[5pt]\n&=  x^2 + \\left( x^2 - \\dfrac{3}{2} \\right)^2 \\[5pt]\n&=  x^2 +  x^4 -3x^2 + \\dfrac{9}{4}\\[5pt]\n&=  x^4 - 2 x^2 + \\dfrac{9}{4}.\\\n}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=4{x}^{3}-4x & =0 \\\\ 4x({x}^{2}-1) & =0 \\\\ x & =0,\\pm 1\\end{aligned}\n$$\n\nSince there are multiple stationary points, we need to use the candidates test to identify the points of minimum distance. We compute the squared distances for each of the stationary points as follows:\n\n$$\n\\begin{aligned}S(0) & =(0)^{4}-2(0)^{2}+\\frac{9}{4}=\\frac{9}{4} \\\\ S(-1) & =(-1)^{4}-2(-1)^{2}+\\frac{9}{4}=\\frac{5}{4} \\\\ S(1) & =(1)^{4}-2(1)^{2}+\\frac{9}{4}=\\frac{5}{4}\\end{aligned}\n$$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $x=\\pm 1.$" #edb/ref 17592186045417] [17592186198083 #edb/ref 1069 "e-12606" #edb/ref 17592186045417] [17592186198083 #edb/ref 1071 "![](images/44/44ef8fc83ea0a70dcc16769ee6965727ec2c9584e97cc417e34184d633bbf876.png)\n\n  \n\nWhat is the least distance between the curve $y=\\sqrt{2x^2+3}+1$ and the point $(3,1)?$" #edb/ref 17592186045417] [17592186198083 #edb/ref 1072 #uuid "2bf999cc-9733-5f29-90e6-20d297efe352" #edb/ref 17592186045417] [17592186198083 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(3,1)$ and a general point $P(x, y){:}$\n\n$$\n\\begin{aligned}S & =(x-3)^{2}+(y-1)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{2x^2+3}+1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-3)^{2}+(y-1)^{2} \\\\  & =(x-3)^{2}+(\\sqrt{2{x}^{2}+3}+1-1)^{2} \\\\  & =(x-3)^{2}+(\\sqrt{2{x}^{2}+3})^{2} \\\\  & ={x}^{2}-6x+9+2{x}^{2}+3 \\\\  & =3{x}^{2}-6x+12.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=6x-6 & =0 \\\\ 6x & =6 \\\\ x & =1\\end{aligned}\n$$\n\nWe can see that $S''(1) =6 > 0.$ Therefore, $x = 1$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=1$ is given by\n\n$$\nd = \\sqrt{S(1)}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S(1)} \\\\  & =\\sqrt{3(1)^{2}-6(1)+12} \\\\  & =\\sqrt{9} \\\\  & =3.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198246 #edb/ref 1037 #edb/ref 17592186050952 #edb/ref 17592186045417] [17592186198246 #edb/ref 1038 #edb/ref 17592186198555 #edb/ref 17592186045417] [17592186198246 #edb/ref 1038 #edb/ref 17592186198982 #edb/ref 17592186045417] [17592186198246 #edb/ref 1038 #edb/ref 17592186253477 #edb/ref 17592186045417] [17592186198246 #edb/ref 1038 #edb/ref 17592186332656 #edb/ref 17592186045417] [17592186198246 #edb/ref 1038 #edb/ref 17592186332657 #edb/ref 17592186045417] [17592186198246 #edb/ref 1038 #edb/ref 17592186399982 #edb/ref 17592186045417] [17592186198246 #edb/ref 1038 #edb/ref 17592186403011 #edb/ref 17592186045417] [17592186198246 #edb/ref 1038 #edb/ref 17592186526011 #edb/ref 17592186045417] [17592186198246 #edb/ref 1038 #edb/ref 17592186526066 #edb/ref 17592186045417] [17592186198246 #edb/ref 1038 #edb/ref 17592186526088 #edb/ref 17592186045417] [17592186198246 #edb/ref 1038 #edb/ref 17592186526097 #edb/ref 17592186045417] [17592186198246 #edb/ref 1039 "Finding an Equation That Determines a Minimum Distance" #edb/ref 17592186045417] [17592186198246 #edb/ref 1041 #edb/ref 17592186198079 #edb/ref 17592186045417] [17592186198246 #edb/ref 1042 #uuid "38bfb48e-9b66-58a8-966a-fb6938e08073" #edb/ref 17592186045417] [17592186198247 #edb/ref 1037 #edb/ref 17592186048162 #edb/ref 17592186045417] [17592186198247 #edb/ref 1038 #edb/ref 17592186198683 #edb/ref 17592186045417] [17592186198247 #edb/ref 1038 #edb/ref 17592186198901 #edb/ref 17592186045417] [17592186198247 #edb/ref 1038 #edb/ref 17592186284674 #edb/ref 17592186045417] [17592186198247 #edb/ref 1038 #edb/ref 17592186290282 #edb/ref 17592186045417] [17592186198247 #edb/ref 1038 #edb/ref 17592186290283 #edb/ref 17592186045417] [17592186198247 #edb/ref 1038 #edb/ref 17592186317547 #edb/ref 17592186045417] [17592186198247 #edb/ref 1038 #edb/ref 17592186317549 #edb/ref 17592186045417] [17592186198247 #edb/ref 1038 #edb/ref 17592186526036 #edb/ref 17592186045417] [17592186198247 #edb/ref 1038 #edb/ref 17592186526040 #edb/ref 17592186045417] [17592186198247 #edb/ref 1038 #edb/ref 17592186526072 #edb/ref 17592186045417] [17592186198247 #edb/ref 1038 #edb/ref 17592186526099 #edb/ref 17592186045417] [17592186198247 #edb/ref 1038 #edb/ref 17592186526102 #edb/ref 17592186045417] [17592186198247 #edb/ref 1039 "Determining the Closest Points on a Curve to a Point" #edb/ref 17592186045417] [17592186198247 #edb/ref 1041 #edb/ref 17592186198080 #edb/ref 17592186045417] [17592186198247 #edb/ref 1042 #uuid "cbd4e2eb-d2c8-54