b6-e03c3d91e00c" #edb/ref 17592186045417] [17592186525930 #edb/ref 1075 #edb/ref 17592186525631 #edb/ref 17592186045417] [17592186525930 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186525930 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186525930 #edb/ref 1078 #edb/ref 17592186525631 #edb/ref 17592186045417] [17592186525930 #edb/ref 1079 #uuid "a67a7f3c-490f-5382-ace0-4fefcf0560be" #edb/ref 17592186045417] [17592186525933 #edb/ref 1075 #edb/ref 17592186525587 #edb/ref 17592186045417] [17592186525933 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186525933 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186525933 #edb/ref 1078 #edb/ref 17592186525587 #edb/ref 17592186045417] [17592186525933 #edb/ref 1079 #uuid "afacb823-875d-5437-9a23-fbc674a4d3af" #edb/ref 17592186045417] [17592186525959 #edb/ref 1075 #edb/ref 17592186525434 #edb/ref 17592186045417] [17592186525959 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186525959 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186525959 #edb/ref 1078 #edb/ref 17592186525434 #edb/ref 17592186045417] [17592186525959 #edb/ref 1079 #uuid "e1cc86a0-17b1-5127-b7bc-ea453484905d" #edb/ref 17592186045417] [17592186525996 #edb/ref 1068 #edb/ref 17592186525924 #edb/ref 17592186045417] [17592186525996 #edb/ref 1069 "q-18503" #edb/ref 17592186045417] [17592186525996 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186525996 #edb/ref 1071 "![](images/40/400427aa7dd8446124c44355959792d8e818e3118ee60ebb315c26a4b74375f1.png)\n\nWhat is the least distance between the curve $y=\\sqrt{x+1}$ and the point $(2,0)?$" #edb/ref 17592186045417] [17592186525996 #edb/ref 1072 #uuid "2a9deff8-468e-536e-b35a-37a221ceafcf" #edb/ref 17592186045417] [17592186525996 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(2,0)$ and a general point $P(x,y)$:\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+(y-0)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{x+1}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+(y)^{2} \\\\  & =(x-2)^{2}+(\\sqrt{x+1})^{2} \\\\  & =(x-2)^{2}+x+1 \\\\  & ={x}^{2}-4x+4+x+1 \\\\  & ={x}^{2}-3x+5.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-3 & =0 \\\\ 2x & =3 \\\\ x & =\\frac{3}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=\\frac{3}{2}$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=\\frac{3}{2}$ is given by\n\n$$\nd=\\sqrt{S(\\frac{3}{2})}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S(\\frac{3}{2})} \\\\  & =\\sqrt{{(\\frac{3}{2})}^{2}-3(\\frac{3}{2})+5} \\\\  & =\\sqrt{\\frac{11}{4}} \\\\  & =\\frac{\\sqrt{11}}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186526011 #edb/ref 1068 #edb/ref 17592186525855 #edb/ref 17592186045417] [17592186526011 #edb/ref 1069 "q-344802" #edb/ref 17592186045417] [17592186526011 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186526011 #edb/ref 1071 "![](images/79/79033b7dda12c84d84f668a5e3a8eeb0be25e6ad9d7b34147826ef6bdcabdce3.png)\n\nLet $P$ be the point on the curve $y={e}^{x-1}$ that is closest to the origin (as shown above). Find the equation defining the $x$-coordinate of the point $P.$\n\n$2x\\,+$\n\n{{field-1}}$=0$" #edb/ref 17592186045417] [17592186526011 #edb/ref 1072 #uuid "444cffb1-de70-54cd-8f5f-c5135af025bc" #edb/ref 17592186045417] [17592186526011 #edb/ref 1074 "Let's consider the *squared* distance $S$ between $(0,0)$ and a general point $P(x,y):$ \n\n$$\n\\begin{aligned}S(x,y) & =(x-0)^{2}+(y-0)^{2} \\\\  & ={x}^{2}+{y}^{2}.\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y={e}^{x-1}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & ={x}^{2}+{y}^{2} \\\\  & ={x}^{2}+({e}^{x-1})^{2} \\\\  & ={x}^{2}+{e}^{2(x-1)}.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x+{e}^{2(x-1)}\\cdot 2 & =0 \\\\ 2x+2{e}^{2(x-1)} & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186526036 #edb/ref 1068 #edb/ref 17592186525912 #edb/ref 17592186045417] [17592186526036 #edb/ref 1069 "q-18497" #edb/ref 17592186045417] [17592186526036 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186526036 #edb/ref 1071 "![](images/4a/4ae08104573cd8a96c47ae6d98993998622617c3dd932516055cd2b0cd4e55be.png)\n\nFind the $y$-coordinate of the points on the curve $y={x}^{2}-4x$ that are closest to the point $(2,0).$" #edb/ref 17592186045417] [17592186526036 #edb/ref 1072 #uuid "7063b461-98a7-5c7e-afa4-7c0e6c07c12e" #edb/ref 17592186045417] [17592186526036 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(2,0)$ and a general point $P(x,y)$:\n\n$$\n\\begin{aligned}D & =(x-2)^{2}+{y}^{2} \\\\  & ={x}^{2}-4x+4+{y}^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y={x}^{2}-4x.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(y) & ={x}^{2}-4x+4+{y}^{2} \\\\  & =y+4+{y}^{2} \\\\  & ={y}^{2}+y+4.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(y)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(y)=2y+1 & =0 \\\\ 2y & =-1 \\\\ y & =-\\frac{1}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(y)=2>0.$ Therefore, $y=-\\frac{1}{2}$ is a minimum of $S.$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $y=-\\frac{1}{2}.$" #edb/ref 17592186045417] [17592186526040 #edb/ref 1068 #edb/ref 17592186525885 #edb/ref 17592186045417] [17592186526040 #edb/ref 1069 "q-344818" #edb/ref 17592186045417] [17592186526040 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186526040 #edb/ref 1071 "Find the $x$-coordinate of the point on the curve $y=\\sqrt{6x+7}+1$ that is closest to the point $(2,1).$ Do not round the answer.\n\n$x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186526040 #edb/ref 1072 #uuid "72e603ef-4823-5f36-9dda-6b01a7eedbc5" #edb/ref 17592186045417] [17592186526040 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(2,1)$ and a general point $P(x,y)$:\n\n$$\nS=(x-2)^{2}+(y-1)^{2}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{6x+7}+1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & =(x-2)^{2}+(y-1)^{2} \\\\  & =(x-2)^{2}+(\\sqrt{6x+7}+1-1)^{2} \\\\  & =(x-2)^{2}+6x+7 \\\\  & ={x}^{2}-4x+4+6x+7 \\\\  & ={x}^{2}+2x+11.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x+2 & =0 \\\\ 2x & =-2 \\\\ x & =-1\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=-1$ is a minimum of $S.$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $x=-1.$" #edb/ref 17592186045417] [17592186526044 #edb/ref 1068 #edb/ref 17592186525872 #edb/ref 17592186045417] [17592186526044 #edb/ref 1069 "q-20073" #edb/ref 17592186045417] [17592186526044 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186526044 #edb/ref 1071 "![](images/c2/c2ba745f9f5f495ae177be1c93926fc74dffab6e69b3035cda2e7ed273f4dd05.png)\n\nWhat is the least distance between the curve $y=\\sqrt{x}+1$ and the point $(1,1)?$" #edb/ref 17592186045417] [17592186526044 #edb/ref 1072 #uuid "7941b15a-2aa3-5ad8-bfe5-4cdf148e4806" #edb/ref 17592186045417] [17592186526044 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(1,1)$ and a general point $P(x,y)$:\n\n$$\n\\begin{aligned}S & =(x-1)^{2}+(y-1)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{x}+1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-1)^{2}+(y-1)^{2} \\\\  & =(x-1)^{2}+(\\sqrt{x}+1-1)^{2} \\\\  & =(x-1)^{2}+(\\sqrt{x})^{2} \\\\  & =(x-1)^{2}+x \\\\  & ={x}^{2}-2x+1+x \\\\  & ={x}^{2}-x+1.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-1 & =0 \\\\ 2x & =1 \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=\\frac{1}{2}$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=\\frac{1}{2}$ is given by\n\n$$\nd=\\sqrt{S(\\frac{1}{2})}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S(\\frac{1}{2})} \\\\  & =\\sqrt{{(\\frac{1}{2})}^{2}-(\\frac{1}{2})+1} \\\\  & =\\sqrt{\\frac{3}{4}} \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186526060 #edb/ref 1068 #edb/ref 17592186525902 #edb/ref 17592186045417] [17592186526060 #edb/ref 1069 "q-211283" #edb/ref 17592186045417] [17592186526060 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186526060 #edb/ref 1071 "What is the least distance between the curve $y=\\sqrt{6x}$ and the point $P(4,0)?$" #edb/ref 17592186045417] [17592186526060 #edb/ref 1072 #uuid "9e2d86f5-ab99-5ef8-9f2c-0675ddcc3d5d" #edb/ref 17592186045417] [17592186526060 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(4,0)$ and a general point $P(x,y)$:\n\n$$\n\\begin{aligned}S & =(x-4)^{2}+(y-0)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{6x}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-4)^{2}+(y-0)^{2} \\\\  & =(x-4)^{2}+(\\sqrt{6x})^{2} \\\\  & ={x}^{2}-8x+16+6x \\\\  & ={x}^{2}-2x+16.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-2 & =0 \\\\ 2x & =2 \\\\ x & =\\frac{2}{2} \\\\ x & =1\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=1$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=1$ is given by\n\n$$\nd=\\sqrt{S(1)}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S(1)} \\\\  & =\\sqrt{{1}^{2}-2(1)+16} \\\\  & =\\sqrt{1-2+16} \\\\  & =\\sqrt{15}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186526066 #edb/ref 1068 #edb/ref 17592186525959 #edb/ref 17592186045417] [17592186526066 #edb/ref 1069 "q-344800" #edb/ref 17592186045417] [17592186526066 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186526066 #edb/ref 1071 "![](images/5b/5b73cc737e5a07d6517431a41ad81d478e54c963b8295d4fb0996b6a33a3b34e.png)\n\nLet $P$ be the point on the curve $y=\\sqrt{x+1}$ that is closest to the origin (as shown above). Find the equation defining the $x$-coordinate of the point $P.$\n\n$2x\\,+$\n\n{{field-1}}$=0$" #edb/ref 17592186045417] [17592186526066 #edb/ref 1072 #uuid "ac677013-1927-5613-9941-c7a36ba6abf3" #edb/ref 17592186045417] [17592186526066 #edb/ref 1074 "Let's consider the *squared* distance $S$ between $(0,0)$ and a general point $P(x,y):$ \n\n$$\n\\begin{aligned}S(x,y) & =(x-0)^{2}+(y-0)^{2} \\\\  & ={x}^{2}+{y}^{2}.\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{x+1}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & ={x}^{2}+{y}^{2} \\\\  & ={x}^{2}+(\\sqrt{x+1})^{2} \\\\  & ={x}^{2}+x+1.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x+1 & =0 \\\\ 2x+1 & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186526072 #edb/ref 1068 #edb/ref 17592186525925 #edb/ref 17592186045417] [17592186526072 #edb/ref 1069 "q-344817" #edb/ref 17592186045417] [17592186526072 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186526072 #edb/ref 1071 "![](images/d0/d0bfd04a904f0619093e8b6d0103f1a03c82aa2b182693fa094238667e66dd2e.png)\n\nFind the $x$-coordinate of the point on the curve $y=\\sqrt{5x+4}$ that is closest to the point $(2,0).$ Do not round the answer.\n\n$x=$\n{{field-1}}" #edb/ref 17592186045417] [17592186526072 #edb/ref 1072 #uuid "b3c46934-91bf-5aa2-b420-96168ea220bf" #edb/ref 17592186045417] [17592186526072 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(2,0)$ and a general point $P(x,y)$:\n\n$$\nS=(x-2)^{2}+{y}^{2}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{5x+4}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & =(x-2)^{2}+{y}^{2} \\\\  & =(x-2)^{2}+(\\sqrt{5x+4})^{2} \\\\  & =(x-2)^{2}+5x+4 \\\\  & ={x}^{2}-4x+4+5x+4 \\\\  & ={x}^{2}+x+8.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x+1 & =0 \\\\ 2x & =-1 \\\\ x & =-\\frac{1}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=-\\frac{1}{2}$ is a minimum of $S.$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $x=-\\frac{1}{2}.$" #edb/ref 17592186045417] [17592186526074 #edb/ref 1068 #edb/ref 17592186525914 #edb/ref 17592186045417] [17592186526074 #edb/ref 1069 "q-315643" #edb/ref 17592186045417] [17592186526074 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186526074 #edb/ref 1071 "![](images/14/144e610d70eaa52a62e4bbb2de2cd9dd9ed287a87a862d48f44cb7a161c7ee26.png)\n\nFind the least distance $d$ between the curve $y=\\sqrt{2x}+3$ and the point $(4,3).$ Do not round the answer.\n\n$d=$\n{{field-1}}" #edb/ref 17592186045417] [17592186526074 #edb/ref 1072 #uuid "bca0e45d-f143-5b0f-9307-2c5d5a1f757d" #edb/ref 17592186045417] [17592186526074 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(4,3)$ and a general point $P(x,y)$:\n\n$$\nS=(x-4)^{2}+(y-3)^{2}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{2x}+3.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & =(x-4)^{2}+(y-3)^{2} \\\\  & =(x-4)^{2}+(\\sqrt{2x}+3-3)^{2} \\\\  & =(x-4)^{2}+(\\sqrt{2x})^{2} \\\\  & =(x-4)^{2}+2x \\\\  & ={x}^{2}-8x+16+2x \\\\  & ={x}^{2}-6x+16.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-6 & =0 \\\\ 2x & =6 \\\\ x & =3\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0,$ so $x=3$ gives a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=3$ is given by\n\n$$\nd=\\sqrt{S(3)}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S(3)} \\\\  & =\\sqrt{{3}^{2}-6(3)+16} \\\\  & =\\sqrt{7}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186526086 #edb/ref 1068 #edb/ref 17592186525848 #edb/ref 17592186045417] [17592186526086 #edb/ref 1069 "q-344847" #edb/ref 17592186045417] [17592186526086 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186526086 #edb/ref 1071 "Find the least distance between the curve $y=\\sqrt{{x}^{2}-4x+5}+3$ and the point $P(2,3).$ Do not round the answer.\n\n$d=$ \n{{field-1}}" #edb/ref 17592186045417] [17592186526086 #edb/ref 1072 #uuid "de1d317e-6601-5a5d-9bc7-8e4f2a0ea625" #edb/ref 17592186045417] [17592186526086 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(2,3)$ and a general point $P(x,y):$\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+(y-3)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{{x}^{2}-4x+5}+3.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+(y-3)^{2} \\\\  & =(x-2)^{2}+{(\\sqrt{{x}^{2}-4x+5}+3-3)}^{2} \\\\  & =(x-2)^{2}+(\\sqrt{{x}^{2}-4x+5})^{2} \\\\  & =(x-2)^{2}+{x}^{2}-4x+5 \\\\  & ={x}^{2}-4x+4+{x}^{2}-4x+5 \\\\  & =2{x}^{2}-8x+9.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=4x-8 & =0 \\\\ 4x & =8 \\\\ x & =2\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=4>0.$ Therefore, $x=2$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=2$ is given by\n\n$$\nd=\\sqrt{S\\,(2)}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S\\,(2)} \\\\  & =\\sqrt{2(2)^{2}-8(2)+9} \\\\  & =\\sqrt{8-16+9} \\\\  & =1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186526088 #edb/ref 1068 #edb/ref 17592186525933 #edb/ref 17592186045417] [17592186526088 #edb/ref 1069 "q-344809" #edb/ref 17592186045417] [17592186526088 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186526088 #edb/ref 1071 "![](images/19/19ab5199ec0848b87d5ccb276e7a78ac0c7284dafb2bdeb463c15732540d43ae.png)\n\nLet $P$ be the point on the curve $y=\\operatorname{ln}⁡(x+2)$ that is closest to the point $(1,0)$ (as shown above). Find the equation defining the $x$-coordinate of the point $P.$\n\n$\\,\\,2x-2\\,+$\n\n{{field-1}} $=0$" #edb/ref 17592186045417] [17592186526088 #edb/ref 1072 #uuid "e62d164e-09b5-5d2f-b961-352e1855d4f4" #edb/ref 17592186045417] [17592186526088 #edb/ref 1074 "Let's consider the *squared* distance $S$ between $(1,0)$ and a general point $P(x,y):$ \n\n$$\n\\begin{aligned}S(x,y) & =(x-1)^{2}+(y-0)^{2} \\\\  & ={x}^{2}-2x+1+{y}^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\operatorname{ln}⁡(x+2).$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & ={x}^{2}-2x+1+(\\operatorname{ln}⁡(x+2))^{2}.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-2+2\\operatorname{ln}⁡(x+2)\\cdot \\frac{1}{x+2} & =0 \\\\ 2x-2+\\frac{2\\operatorname{ln}⁡(x+2)}{x+2} & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186526097 #edb/ref 1068 #edb/ref 17592186525903 #edb/ref 17592186045417] [17592186526097 #edb/ref 1069 "q-87494" #edb/ref 17592186045417] [17592186526097 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186526097 #edb/ref 1071 "![](images/4d/4d81bebc6bb5addfdd5f9006eba8cd4b5e5a13c6322495a6af3c5c02885ae6ee.png)\n\nThe $x$-coordinate of the point $P$ on the curve $y={3}^{-x/4}$ that is closest to the origin (as shown above) satisfies the equation \n\n$$\n2x-\\bbox[3pt,border:1pt solid black]{\\phantom{AAAAAA}}=0.\n$$\n\n \nWhat is the missing expression?" #edb/ref 17592186045417] [17592186526097 #edb/ref 1072 #uuid "f355b972-2cac-5b13-a407-9bcf1a157cec" #edb/ref 17592186045417] [17592186526097 #edb/ref 1074 "Let's consider the *squared* distance $S$ between $(0,0)$ and a general point $P(x,y):$ \n\n$$\n\\begin{aligned}S(x,y) & =(x-0)^{2}+(y-0)^{2} \\\\  & ={x}^{2}+{y}^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y={3}^{-x/4}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & ={x}^{2}+{y}^{2} \\\\  & ={x}^{2}+({3}^{-x/4})^{2} \\\\  & ={x}^{2}+{3}^{-x/2}.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-\\frac{1}{2}\\cdot \\operatorname{ln}⁡3\\cdot {3}^{-x/2} & =0 \\\\ 2x-\\frac{\\operatorname{ln}⁡3}{2}\\cdot {3}^{-x/2} & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186526099 #edb/ref 1068 #edb/ref 17592186525861 #edb/ref 17592186045417] [17592186526099 #edb/ref 1069 "q-344825" #edb/ref 17592186045417] [17592186526099 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186526099 #edb/ref 1071 "![](images/3b/3b68e9306032877d509bd8d0b38bac2dbf94ba4827ff501e200c51230442861b.png)\n\nFind the $y$-coordinate of the point on the curve $y={x}^{2}-\\sqrt{2}x$ that is closest to the point $(\\frac{\\sqrt{2}}{2},0).$ Do not round the answer.\n\n$y=$\n{{field-1}}" #edb/ref 17592186045417] [17592186526099 #edb/ref 1072 #uuid "f5383eed-0cb1-58fc-ad37-136e38e3b0f8" #edb/ref 17592186045417] [17592186526099 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(\\frac{\\sqrt{2}}{2},0)$ and a general point $P(x,y)$:\n\n$$\n\\begin{aligned}S & ={(x-\\frac{\\sqrt{2}}{2})}^{2}+(y-0)^{2} \\\\  & ={x}^{2}-\\sqrt{2}x+\\frac{1}{2}+{y}^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y={x}^{2}-\\sqrt{2}x.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(y) & =y+\\frac{1}{2}+{y}^{2} \\\\  & ={y}^{2}+y+\\frac{1}{2}.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(y)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(y)=2y+1 & =0 \\\\ 2y & =-1 \\\\ y & =-\\frac{1}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(y)=2>0.$ Therefore, $y=-\\frac{1}{2}$ is a minimum of $S.$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $y=-\\frac{1}{2}.$" #edb/ref 17592186045417] [17592186526102 #edb/ref 1068 #edb/ref 17592186525930 #edb/ref 17592186045417] [17592186526102 #edb/ref 1069 "q-344829" #edb/ref 17592186045417] [17592186526102 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186526102 #edb/ref 1071 "Find the $y$-coordinate of the point on the curve $y={x}^{2}-4x$ that is closest to the point $(2,-\\frac{7}{2}).$\n\n$y=$\n{{field-1}}" #edb/ref 17592186045417] [17592186526102 #edb/ref 1072 #uuid "f8e4323d-cb33-53b2-a6a3-9708cfb8812c" #edb/ref 17592186045417] [17592186526102 #edb/ref 1074 "Let us consider the *squared* distance $S$ between $(2,-\\frac{7}{2})$ and a general point $P(x,y)$:\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+{(y+\\frac{7}{2})}^{2} \\\\  & ={x}^{2}-4x+4+{y}^{2}+7y+\\frac{49}{4} \\\\  & ={x}^{2}-4x+{y}^{2}+7y+\\frac{65}{4}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y={x}^{2}-4x.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(y) & =y+{y}^{2}+7y+\\frac{65}{4} \\\\  & ={y}^{2}+8y+\\frac{65}{4}.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(y)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(y)=2y+8 & =0 \\\\ 2y & =-8 \\\\ y & =-4\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(y)=2>0.$ Therefore, $y=-4$ is a minimum of $S.$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $y=-4.$" #edb/ref 17592186045417]}
