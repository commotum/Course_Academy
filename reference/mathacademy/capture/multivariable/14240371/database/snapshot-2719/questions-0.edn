/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral source" :db/id #edb/ref 17592186391214} {:answer/id #uuid "602df48b-efc0-58a3-a4e8-f8eafc30ceaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "saddle" :db/id #edb/ref 17592186391215}] :answer-field/correct {:answer/id #uuid "9244b400-42ab-58df-b8b0-a3bbc7cba75f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral sink" :db/id #edb/ref 17592186391213} :answer-field/id #uuid "2afcd599-57e3-5297-b831-71b01faf8aa5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186391212} {:answer-field/choices [{:answer/id #uuid "b2c67e4d-8b9b-5f92-a771-1827d4638f4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unstable" :db/id #edb/ref 17592186391217} {:answer/id #uuid "0cd6bf2a-d1b6-56e4-984f-6951a8cdadff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "asymptotically stable" :db/id #edb/ref 17592186391218}] :answer-field/correct {:answer/id #uuid "0cd6bf2a-d1b6-56e4-984f-6951a8cdadff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "asymptotically stable" :db/id #edb/ref 17592186391218} :answer-field/id #uuid "d4eec63b-b845-54c1-bfe7-24f2abb290f1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186391216}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e06a687f-dc13-5f88-9f73-09d6b8609d29" :question/math-academy-id "q-333532" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &=\\frac{1}{\\pi }\\operatorname{sin}⁡(\\pi x(t))+y(t) \\\\ {y}^{′}(t) &=1-{x}^{2}(t)\\end{aligned}\\right.\n$$\n\nConsider the system of differential equations above. What is the behavior of the system's solutions near the equilibrium ${x}^{∗}=[1,\\text{ }0]^{T}?$\n\n$\\,$\nThe equilibrium is an \n{{field-1}}{{field-2}}." :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}$ and \n$\\text{\\boldsymbol}f(x)=\\begin{bmatrix}\\frac{1}{\\pi }\\operatorname{sin}⁡(\\pi x)+y \\\\ 1-{x}^{2}\\end{bmatrix}.$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(\\frac{1}{\\pi }\\operatorname{sin}⁡(\\pi x)+y)=\\operatorname{cos}⁡(\\pi x) \\\\ \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(\\frac{1}{\\pi }\\operatorname{sin}⁡(\\pi x)+y)=1 \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(1-{x}^{2})=-2x \\\\ \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(1-{x}^{2})=0\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=\\begin{bmatrix}\\operatorname{cos}⁡(\\pi x) & 1 \\\\ -2x & 0\\end{bmatrix}.\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=\\begin{bmatrix}\\operatorname{cos}⁡(\\pi (1)) & 1 \\\\ -2(1) & 0\\end{bmatrix}=\\begin{bmatrix}-1 & 1 \\\\ -2 & 0\\end{bmatrix}.\n$$\n\nNotice that the matrix is invertible (its determinant is not zero), so the system is almost linear at ${x}^{∗}.$\n\nTo find the eigenvalues of the Jacobian matrix, we write down the characteristic equation:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-1-\\lambda  & 1 \\\\ -2 & -\\lambda \\end{vmatrix} & =0 \\\\ -\\lambda \\cdot (-1-\\lambda )-1\\cdot (-2) & =0 \\\\ {\\lambda }^{2}+\\lambda +2 & =0\\end{aligned}\n$$\n\nSolving the equation, we get the eigenvalues ${\\lambda }_{1,2}=-\\frac{1}{2}\\pm \\frac{\\sqrt{7}}{2}\\text{i}.$\n\nFinally, since we have two complex eigenvalues with negative real parts, our equilibrium is an $\\text{asymptotically stable}$ $\\text{spiral sink}.$"}] [{:db/id #edb/ref 17592186368134 :knowledge-point/_questions [{:db/id #edb/ref 17592186221418 :knowledge-point/id #uuid "a9aeac73-8ee3-5fef-a47c-a96e3545d89c" :knowledge-point/title "Finding the Linear Approximations Near Equilibria"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17579c5b-eadf-528d-baf5-2c0423246f5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186368136}] :answer-field/correct {:answer/id #uuid "17579c5b-eadf-528d-baf5-2c0423246f5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186368136} :answer-field/id #uuid "572486b8-bc89-5344-92c2-8aa2c6647272" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368135} {:answer-field/choices [{:answer/id #uuid "159a880b-1a99-5587-abb7-68aa96e623ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186368138}] :answer-field/correct {:answer/id #uuid "159a880b-1a99-5587-abb7-68aa96e623ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186368138} :answer-field/id #uuid "1d635799-f303-5522-909a-2afd205ed96a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368137} {:answer-field/choices [{:answer/id #uuid "ed430409-83a9-5b2f-a38b-4e4cbf815f32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186368140}] :answer-field/correct {:answer/id #uuid "ed430409-83a9-5b2f-a38b-4e4cbf815f32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186368140} :answer-field/id #uuid "53bcde91-822d-54e8-93d6-e29c65078012" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368139} {:answer-field/choices [{:answer/id #uuid "3d4041d2-5655-5f55-b703-8da986fba1e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186368142}] :answer-field/correct {:answer/id #uuid "3d4041d2-5655-5f55-b703-8da986fba1e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186368142} :answer-field/id #uuid "ce4a0d20-92b4-5bba-907e-7a5e5a3873ca" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368141}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d4cf8bbe-a8bb-5848-ae43-4a663ad26c71" :question/math-academy-id "q-335128" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′}(t) &={y}^{2}(t)-x(t) \\\\ {y}^{′}(t) &={x}^{2}(t)+2y(t)\\end{aligned}\\right.\n$$\n\nConsider the system of differential equations above. What is the corresponding linearized system at the equilibrium point ${x}^{∗}=[0,\\text{ }0]^{T}?$\n\n| ${u}^{′}=\\,\\,$ |  | {{field-1}} | {{field-2}} |  | $\\,\\,u,\\,$ where $u=x-{x}^{∗}$ |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |  |" :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=\\begin{bmatrix}x(t) \\\\ y(t)\\end{bmatrix}$ and $\\text{\\boldsymbol}f(x)=\\begin{bmatrix}{y}^{2}-x \\\\ {x}^{2}+2y\\end{bmatrix}.$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=\\begin{bmatrix}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{bmatrix}\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}({y}^{2}-x)=-1,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}({y}^{2}-x)=2y \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({x}^{2}+2y)=2x,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({x}^{2}+2y)=2\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=\\begin{bmatrix}-1 & 2y \\\\ 2x & 2\\end{bmatrix}.\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=\\begin{bmatrix}-1 & 2(0) \\\\ 2(0) & 2\\end{bmatrix}=\\begin{bmatrix}-1 & 0 \\\\ 0 & 2\\end{bmatrix}.\n$$\n\nFinally, near the equilibrium, the nonlinear system is approximated by\n\n$$\n{u}^{′}=\\begin{bmatrix}-1 & 0 \\\\ 0 & 2\\end{bmatrix}u,\n$$\n\nwhere the deviation vector is\n\n$$\nu=x-{x}^{∗}=\\begin{bmatrix}x \\\\ y\\end{bmatrix}-\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}=\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\n$$"}]}
