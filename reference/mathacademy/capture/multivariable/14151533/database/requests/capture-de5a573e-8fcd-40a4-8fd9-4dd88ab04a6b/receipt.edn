heta )$ for $-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2}$ (shown in blue in the diagram above)?" 13194139534985 17592186045417 true] [17592186446930 1072 #uuid "2855547f-5d51-5448-b3d2-5e4f3624a47a" 13194139534985 17592186045417 true] [17592186446930 1074 "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1+\\operatorname{cos}⁡(2\\theta ),$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-2\\operatorname{sin}⁡(2\\theta ).\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{(1+\\operatorname{cos}⁡(2\\theta ))^{2}+(-2\\operatorname{sin}⁡(2\\theta ))^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{1+2\\operatorname{cos}⁡(2\\theta )+{cos}^{2}⁡(2\\theta )+4{sin}^{2}⁡(2\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{1+2\\operatorname{cos}⁡(2\\theta )+1+3{sin}^{2}⁡(2\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{2+2\\operatorname{cos}⁡(2\\theta )+3{sin}^{2}⁡(2\\theta )}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" 13194139534985 17592186045417 true] [17592186446931 1068 #edb/ref 17592186446925 13194139534985 17592186045417 true] [17592186446931 1069 "q-353382" 13194139534985 17592186045417 true] [17592186446931 1070 #edb/ref 17592186045487 13194139534985 17592186045417 true] [17592186446931 1071 "![](images/07/07dd1e37f29e06051c7fe84210d41857c7c871ce577c71a86781be4ce7a0ef23.png)\n\nFind the arc length $L$ of the polar curve $r=7\\operatorname{sin}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{3}$ (shown in blue in the diagram above). Do not round the answer.\n\n$L=$\n{{field-1}}" 13194139534985 17592186045417 true] [17592186446931 1072 #uuid "496b1e54-6c94-5491-8b44-b97586fa418a" 13194139534985 17592186045417 true] [17592186446931 1074 "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=7\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=7\\operatorname{cos}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{{(7\\operatorname{sin}⁡\\theta )}^{2}+{(7\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{49{sin}^{2}⁡\\theta +49{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{49}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}7\\,\\text{d}\\theta  \\\\  & =7\\theta \\,{|}_{0}^{\\pi /3} \\\\  & =7(\\frac{\\pi }{3}-0) \\\\  & =\\frac{7\\pi }{3}.\\end{aligned}\n$$" 13194139534985 17592186045417 true] [17592186446932 1068 #edb/ref 17592186446926 13194139534985 17592186045417 true] [17592186446932 1069 "q-103848" 13194139534985 17592186045417 true] [17592186446932 1070 #edb/ref 17592186045486 13194139534985 17592186045417 true] [17592186446932 1071 "Find the arc length of the polar curve $r={4}^{\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{2}.$" 13194139534985 17592186045417 true] [17592186446932 1072 #uuid "53d69396-ad38-5399-a95d-de36a99debd9" 13194139534985 17592186045417 true] [17592186446932 1074 "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={4}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }={4}^{\\theta }\\operatorname{ln}⁡4.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{({4}^{\\theta })}^{2}+{({4}^{\\theta }\\operatorname{ln}⁡4)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{4}^{2\\theta }+{4}^{2\\theta }{ln}^{2}⁡4}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(1+{ln}^{2}⁡4){4}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡4}{\\int }_{0}^{\\pi /2}{4}^{\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡4}\\cdot \\frac{1}{\\operatorname{ln}⁡4}\\cdot {4}^{\\theta }{|}_{0}^{\\pi /2} \\\\  & =\\sqrt{1+{ln}^{2}⁡4}\\cdot \\frac{1}{\\operatorname{ln}⁡4}\\cdot ({4}^{\\pi /2}-{4}^{0}) \\\\  & =\\frac{\\sqrt{1+{ln}^{2}⁡4}}{\\operatorname{ln}⁡4}({4}^{\\pi /2}-1).\\end{aligned}\n$$" 13194139534985 17592186045417 true] [17592186446933 1068 #edb/ref 17592186446927 13194139534985 17592186045417 true] [17592186446933 1069 "q-15121" 13194139534985 17592186045417 true] [17592186446933 1070 #edb/ref 17592186045485 13194139534985 17592186045417 true] [17592186446933 1071 "Which of the following gives the arc length of the polar curve $r=\\operatorname{sin}⁡(5\\theta )$ for $0\\le \\theta \\le \\frac{\\pi }{5}?$" 13194139534985 17592186045417 true] [17592186446933 1072 #uuid "7a42296f-57b5-52e8-abcc-dbabb67e9573" 13194139534985 17592186045417 true] [17592186446933 1074 "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\operatorname{sin}⁡(5\\theta ),$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=5\\operatorname{cos}⁡(5\\theta ).\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /5}\\sqrt{(\\operatorname{sin}⁡(5\\theta ))^{2}+(5\\operatorname{cos}⁡(5\\theta ))^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /5}\\sqrt{{sin}^{2}⁡(5\\theta )+25{cos}^{2}⁡(5\\theta )}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" 13194139534985 17592186045417 true] [17592186446934 1068 #edb/ref 17592186446929 13194139534985 17592186045417 true] [17592186446934 1069 "q-9538" 13194139534985 17592186045417 true] [17592186446934 1070 #edb/ref 17592186045487 13194139534985 17592186045417 true] [17592186446934 1071 "Find the arc length of the polar curve $r=1-\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\n*Hint: You may wish to use the following identity: $\\operatorname{sin}⁡(\\frac{x}{2})=\\sqrt{\\frac{1-\\operatorname{cos}⁡x}{2}}.$*" 13194139534985 17592186045417 true] [17592186446934 1072 #uuid "954fde1b-bd90-5ee0-826c-b4121bc79ca3" 13194139534985 17592186045417 true] [17592186446934 1074 "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1-\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(1-\\operatorname{cos}⁡\\theta )^{2}+{(\\operatorname{sin}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{1-2\\operatorname{cos}⁡\\theta +{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{1-2\\operatorname{cos}⁡\\theta +1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{2-2\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{0}^{\\pi /2}\\sqrt{1-\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta \\end{aligned}\n$$\n\nNow, we recall the identity for $\\operatorname{sin}⁡(\\frac{x}{2}):$\n\n$$\n\\operatorname{sin}⁡(\\frac{x}{2})=\\sqrt{\\frac{1-\\operatorname{cos}⁡x}{2}}\n$$\n\nTherefore, using $x=\\theta $ in the previous identity, the integral can be written as follows:\n\n$$\n\\begin{aligned}L & =\\sqrt{2}{\\int }_{0}^{\\pi /2}\\sqrt{2{sin}^{2}⁡(\\frac{\\theta }{2})}\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}\\cdot \\sqrt{2}\\cdot {\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(\\frac{\\theta }{2})\\,\\text{d}\\theta  \\\\  & ={2(-2)(\\operatorname{cos}⁡(\\frac{\\theta }{2}))|}_{0}^{\\pi /2} \\\\  & =-4(\\operatorname{cos}⁡(\\frac{\\pi }{4})-\\operatorname{cos}⁡0) \\\\  & =-4(\\frac{\\sqrt{2}}{2}-1) \\\\  & =4-2\\sqrt{2}.\\end{aligned}\n$$" 13194139534985 17592186045417 true] [17592186446935 1068 #edb/ref 17592186446924 13194139534985 17592186045417 true] [17592186446935 1069 "q-347923" 13194139534985 17592186045417 true] [17592186446935 1070 #edb/ref 17592186045487 13194139534985 17592186045417 true] [17592186446935 1071 "![](images/81/81632c931b0846520a056a872cdf327b9031fea4e3b91bf2374973fff1a2354b.png)\n\nFind the arc length $L$ of the polar curve $r=3+3\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{3}$ (shown in blue in the diagram above). Do not round the answer.\n\n*Hint: You may wish to use the following identity: $\\operatorname{cos}⁡(\\frac{x}{2})=\\sqrt{\\frac{1+\\operatorname{cos}⁡x}{2}}.$*\n\n$L=$\n{{field-1}}" 13194139534985 17592186045417 true] [17592186446935 1072 #uuid "f471af72-8928-5fe0-b630-625d8128766a" 13194139534985 17592186045417 true] [17592186446935 1074 "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=3+3\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-3\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{(3+3\\operatorname{cos}⁡\\theta )^{2}+{(-3\\operatorname{sin}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{9+18\\operatorname{cos}⁡\\theta +9{cos}^{2}⁡\\theta +9{sin}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3i}\\sqrt{18+18\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{18}{\\int }_{0}^{\\pi /3}\\sqrt{1+\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta \\end{aligned}\n$$\n\nNow, we recall the identity for $\\operatorname{cos}⁡(\\frac{x}{2}):$\n\n$$\n\\operatorname{cos}⁡(\\frac{x}{2})=\\sqrt{\\frac{1+\\operatorname{cos}⁡x}{2}}\n$$\n\nTherefore, using $x=\\theta $ in the previous identity, the integral can be written as follows:\n\n$$\n\\begin{aligned}L & =3\\sqrt{2}{\\int }_{0}^{\\pi /3}\\sqrt{2{cos}^{2}⁡(\\frac{\\theta }{2})}\\,\\text{d}\\theta  \\\\  & =3\\sqrt{2}\\cdot \\sqrt{2}\\cdot {\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(\\frac{\\theta }{2})\\,\\text{d}\\theta  \\\\  & ={6\\cdot 2(\\operatorname{sin}⁡(\\frac{\\theta }{2}))|}_{0}^{\\pi /3} \\\\  & =12(\\operatorname{sin}⁡(\\frac{\\pi }{6})-\\operatorname{sin}⁡(0)) \\\\  & =12(\\frac{1}{2}-0) \\\\  & =6.\\end{aligned}\n$$" 13194139534985 17592186045417 true]] :edb/tempids {"answer-05141a1b-cb9e-5283-9e45-82ca469a01e7" 17592186446902 "answer-0934e304-801c-5c0d-8b01-386d6337214b" 17592186446903 "answer-10cd98c4-ea24-55c4-a79c-cf3c9ddf5714" 17592186446904 "answer-13998c82-80d9-5cc7-a5a5-a3c689f79c8d" 17592186446905 "answer-33a0bdd4-e800-5d6d-849a-fb395e74e06a" 17592186446906 "answer-3ebaec30-3483-55e2-9524-7055da0607e1" 17592186446907 "answer-41e5d50b-2d0d-5687-83c8-c9e67c35fd0e" 17592186446908 "answer-71985b22-a29a-5e8e-a361-5aa92a2495cd" 17592186446909 "answer-7aa86582-4f58-56be-8b2e-64523909f390" 17592186446910 "answer-7b4071d8-b7bd-5947-891a-3136a4368de9" 17592186446911 "answer