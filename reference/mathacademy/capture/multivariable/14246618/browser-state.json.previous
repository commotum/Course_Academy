ata-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">⟨</mo><mn>3</mn><mo>,</mo><mo>−</mo><mn>2</mn><mo data-mjx-texclass=\"CLOSE\">⟩</mo></mrow><mo>−</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">⟨</mo><mn>2</mn><mo>,</mo><mn>5</mn><mo data-mjx-texclass=\"CLOSE\">⟩</mo></mrow><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd><mn>8</mn></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">⟨</mo><msub><mi>f</mi><mi>x</mi></msub><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">c</mi></mrow><mo stretchy=\"false\">)</mo><mo>,</mo><msub><mi>f</mi><mi>y</mi></msub><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">c</mi></mrow><mo stretchy=\"false\">)</mo><mo data-mjx-texclass=\"CLOSE\">⟩</mo></mrow><mo>⋅</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">⟨</mo><mn>1</mn><mo>,</mo><mo>−</mo><mn>7</mn><mo data-mjx-texclass=\"CLOSE\">⟩</mo></mrow></mtd></mtr><mtr><mtd><mn>8</mn></mtd><mtd><mi></mi><mo>=</mo><msub><mi>f</mi><mi>x</mi></msub><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">c</mi></mrow><mo stretchy=\"false\">)</mo><mo>−</mo><mn>7</mn><msub><mi>f</mi><mi>y</mi></msub><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">c</mi></mrow><mo stretchy=\"false\">)</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
