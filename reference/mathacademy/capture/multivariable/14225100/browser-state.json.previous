          "dom_index": 0,
          "disabled": false,
          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:45px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"115\"><span mathquill-command-id=\"119\" class=\"\">−</span><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"121\"><span class=\"mq-numerator\" mathquill-block-id=\"123\"><span class=\"mq-nonSymbola\" mathquill-command-id=\"122\">π</span></span><span class=\"mq-denominator\" mathquill-block-id=\"125\"><span mathquill-command-id=\"124\">4</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
