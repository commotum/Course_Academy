      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14225100/observations/step-q82331-4305918791bdf6b66d5d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14225100/observations/step-q82331-4305918791bdf6b66d5d.png",
      "source_url": "https://mathacademy.com/tasks/14225100/topics/1471/lesson",
      "captured_at": 1792050681.8854165,
      "math_academy_id": "q-82331",
