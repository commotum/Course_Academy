}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{2}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{\\rho }^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{3}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" 13194139535523 17592186045417 true] [17592186129523 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $5$ centered at the origin. \nAs a result, in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ={(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 5,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi }.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\frac{xy}{{x}^{2}+{y}^{2}+{z}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\frac{\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ\\cdot \\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{{\\rho }^{2}} \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{2}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{xy}{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{2}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{\\rho }^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{3}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" 13194139535523 17592186045417 false] [17592186129756 1068 17592186128017 13194139535523 17592186045417 false] [17592186129756 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $3$ centered at the origin. \nAs a result, in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 3,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=z\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\rho \\operatorname{cos}⁡ϕ\\cdot \\rho  \\\\  & ={\\rho }^{2}\\operatorname{cos}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}z\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{2}\\operatorname{cos}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\rho }^{4}\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" 13194139535523 17592186045417 true] [17592186129756 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $3$ centered at the origin. \nAs a result, in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ={(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 3,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi }.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=z\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\rho \\operatorname{cos}⁡ϕ\\cdot \\rho  \\\\  & ={\\rho }^{2}\\operatorname{cos}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}z\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{2}\\operatorname{cos}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{\\rho }^{4}\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" 13194139535523 17592186045417 false] [175921