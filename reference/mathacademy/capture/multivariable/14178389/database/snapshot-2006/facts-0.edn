/ref 17592186365059 #edb/ref 17592186045417] [17592186162014 #edb/ref 1038 #edb/ref 17592186366670 #edb/ref 17592186045417] [17592186162014 #edb/ref 1038 #edb/ref 17592186366677 #edb/ref 17592186045417] [17592186162014 #edb/ref 1038 #edb/ref 17592186378058 #edb/ref 17592186045417] [17592186162014 #edb/ref 1038 #edb/ref 17592186395038 #edb/ref 17592186045417] [17592186162014 #edb/ref 1038 #edb/ref 17592186395045 #edb/ref 17592186045417] [17592186162014 #edb/ref 1038 #edb/ref 17592186395052 #edb/ref 17592186045417] [17592186162014 #edb/ref 1038 #edb/ref 17592186407552 #edb/ref 17592186045417] [17592186162014 #edb/ref 1039 "Finding a Projection Matrix That Orthogonally Projects a Vector to the Subspace Spanned by an Eigenvector" #edb/ref 17592186045417] [17592186162014 #edb/ref 1041 #edb/ref 17592186161806 #edb/ref 17592186045417] [17592186162014 #edb/ref 1042 #uuid "84207049-12f7-514c-bfa2-51bce8631b41" #edb/ref 17592186045417] [17592186162015 #edb/ref 1038 #edb/ref 17592186162647 #edb/ref 17592186045417] [17592186162015 #edb/ref 1038 #edb/ref 17592186162665 #edb/ref 17592186045417] [17592186162015 #edb/ref 1038 #edb/ref 17592186366684 #edb/ref 17592186045417] [17592186162015 #edb/ref 1038 #edb/ref 17592186375958 #edb/ref 17592186045417] [17592186162015 #edb/ref 1038 #edb/ref 17592186378065 #edb/ref 17592186045417] [17592186162015 #edb/ref 1038 #edb/ref 17592186395059 #edb/ref 17592186045417] [17592186162015 #edb/ref 1038 #edb/ref 17592186395066 #edb/ref 17592186045417] [17592186162015 #edb/ref 1038 #edb/ref 17592186395073 #edb/ref 17592186045417] [17592186162015 #edb/ref 1038 #edb/ref 17592186407550 #edb/ref 17592186045417] [17592186162015 #edb/ref 1038 #edb/ref 17592186407551 #edb/ref 17592186045417] [17592186162015 #edb/ref 1038 #edb/ref 17592186407553 #edb/ref 17592186045417] [17592186162015 #edb/ref 1039 "Finding the Spectral Decomposition of a Symmetric Matrix" #edb/ref 17592186045417] [17592186162015 #edb/ref 1041 #edb/ref 17592186161807 #edb/ref 17592186045417] [17592186162015 #edb/ref 1042 #uuid "785b09aa-1b82-5021-8b10-271a063cb916" #edb/ref 17592186045417] [17592186162216 #edb/ref 1043 #edb/ref 17592186162849 #edb/ref 17592186045417] [17592186162216 #edb/ref 1043 #edb/ref 17592186162902 #edb/ref 17592186045417] [17592186162216 #edb/ref 1043 #edb/ref 17592186162903 #edb/ref 17592186045417] [17592186162216 #edb/ref 1043 #edb/ref 17592186162904 #edb/ref 17592186045417] [17592186162216 #edb/ref 1043 #edb/ref 17592186162905 #edb/ref 17592186045417] [17592186162216 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186162216 #edb/ref 1045 "The Spectral Theorem" #edb/ref 17592186045417] [17592186162216 #edb/ref 1046 #edb/ref 17592186162849 #edb/ref 17592186045417] [17592186162216 #edb/ref 1049 #edb/ref 17592186049849 #edb/ref 17592186045417] [17592186162216 #edb/ref 1050 780.0 #edb/ref 17592186045417] [17592186162216 #edb/ref 1053 #uuid "22c8da45-56d1-5645-85df-aa94cccb29d8" #edb/ref 17592186045417] [17592186162647 #edb/ref 1068 #edb/ref 17592186161174 #edb/ref 17592186045417] [17592186162647 #edb/ref 1068 #edb/ref 17592186366581 #edb/ref 17592186045417] [17592186162647 #edb/ref 1069 "q-94769" #edb/ref 17592186045417] [17592186162647 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186162647 #edb/ref 1071 "Suppose that\n\n$\\,$ ${v}_{1}=[\\begin{aligned}-4 \\\\ 1\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}1 \\\\ 4\\end{aligned}]$\n\nare eigenvectors of a $2\\times 2$ symmetric matrix $A$ that correspond to the eigenvalues ${\\lambda }_{1}=9$ and ${\\lambda }_{2}=-8,$ respectively. Find the matrix $A.$" #edb/ref 17592186045417] [17592186162647 #edb/ref 1072 #uuid "48eccd0e-cb0a-5561-99a4-875f56fc9de1" #edb/ref 17592186045417] [17592186162647 #edb/ref 1074 "The spectral decomposition of a $2\\times 2$ symmetric matrix $A$ is given by\n\n$$\nA={\\lambda }_{1}{u}_{1}\\cdot {u}_{1}^{T}+{\\lambda }_{2}{u}_{2}\\cdot {u}_{2}^{T},\n$$\n\nwhere ${u}_{1}$ and ${u}_{2}$ are orthonormal eigenvectors of $A$ corresponding to the eigenvalues ${\\lambda }_{1}$ and ${\\lambda }_{2},$ respectively.\n\nFirst, let's normalize our eigenvectors:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{17}}[\\begin{aligned}-4 \\\\ 1\\end{aligned}] \\\\ {u}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{17}}[\\begin{aligned}1 \\\\ 4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}A & ={\\lambda }_{1}{u}_{1}{u}_{1}^{T}+{\\lambda }_{2}{u}_{2}{u}_{2}^{T} \\\\  & =9\\cdot \\frac{1}{\\sqrt{17}}[\\begin{aligned}-4 \\\\ 1\\end{aligned}]\\cdot \\frac{1}{\\sqrt{17}}[\\begin{aligned}-4 & 1\\end{aligned}]+(-8)\\cdot \\frac{1}{\\sqrt{17}}[\\begin{aligned}1 \\\\ 4\\end{aligned}]\\cdot \\frac{1}{\\sqrt{17}}[\\begin{aligned}1 & 4\\end{aligned}] \\\\  & =9\\cdot \\frac{1}{17}[\\begin{aligned}-4 \\\\ 1\\end{aligned}][\\begin{aligned}-4 & 1\\end{aligned}]+(-8)\\cdot \\frac{1}{17}[\\begin{aligned}1 \\\\ 4\\end{aligned}][\\begin{aligned}1 & 4\\end{aligned}] \\\\  & =\\frac{1}{17}(9\\cdot [\\begin{aligned}-4 \\\\ 1\\end{aligned}][\\begin{aligned}-4 & 1\\end{aligned}]+(-8)\\cdot [\\begin{aligned}1 \\\\ 4\\end{aligned}][\\begin{aligned}1 & 4\\end{aligned}]) \\\\  & =\\frac{1}{17}(9\\cdot [\\begin{aligned}16 & -4 \\\\ -4 & 1\\end{aligned}]+(-8)\\cdot [\\begin{aligned}1 & 4 \\\\ 4 & 16\\end{aligned}]) \\\\  & =\\frac{1}{17}[\\begin{aligned}136 & -68 \\\\ -68 & -119\\end{aligned}] \\\\  & =[\\begin{aligned}8 & -4 \\\\ -4 & -7\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186162662 #edb/ref 1068 #edb/ref 17592186161264 #edb/ref 17592186045417] [17592186162662 #edb/ref 1069 "q-95714" #edb/ref 17592186045417] [17592186162662 #edb/ref 1071 "Find the orthogonal projection matrix that maps $x ∈ R^{2}$ onto the subspace spanned by an eigenvector corresponding to the eigenvalue $λ =-10$ of the matrix $A = \\begin{bmatrix}-9 & 5 \\\\ 5 & 15\\end{bmatrix}$." #edb/ref 17592186045417] [17592186162662 #edb/ref 1072 #uuid "28c27a06-cd3b-5e3d-a19e-4b46b9bccd18" #edb/ref 17592186045417] [17592186162849 #edb/ref 1058 #edb/ref 17592186162902 #edb/ref 17592186045417] [17592186162849 #edb/ref 1061 30533 #edb/ref 17592186045417] [17592186162849 #edb/ref 1062 #uuid "84b2f14e-f6c7-5b6c-b6d7-19d4d7d71f71" #edb/ref 17592186045417] [17592186162849 #edb/ref 1063 #edb/ref 17592186163224 #edb/ref 17592186045417] [17592186162902 #edb/ref 1058 #edb/ref 17592186162903 #edb/ref 17592186045417] [17592186162902 #edb/ref 1061 30970 #edb/ref 17592186045417] [17592186162902 #edb/ref 1062 #uuid "95f72e96-f84b-5b21-a070-253638be57a8" #edb/ref 17592186045417] [17592186162902 #edb/ref 1063 #edb/ref 17592186162013 #edb/ref 17592186045417] [17592186162903 #edb/ref 1058 #edb/ref 17592186162905 #edb/ref 17592186045417] [17592186162903 #edb/ref 1061 30971 #edb/ref 17592186045417] [17592186162903 #edb/ref 1062 #uuid "8df507ec-4d53-59f1-b941-07907cd14b6f" #edb/ref 17592186045417] [17592186162903 #edb/ref 1063 #edb/ref 17592186163243 #edb/ref 17592186045417] [17592186162904 #edb/ref 1061 30972 #edb/ref 17592186045417] [17592186162904 #edb/ref 1062 #uuid "2a1d5d86-333c-5361-87ec-fd7766797988" #edb/ref 17592186045417] [17592186162904 #edb/ref 1063 #edb/ref 17592186162014 #edb/ref 17592186045417] [17592186162905 #edb/ref 1058 #edb/ref 17592186162904 #edb/ref 17592186045417] [17592186162905 #edb/ref 1061 30973 #edb/ref 17592186045417] [17592186162905 #edb/ref 1062 #uuid "86248bdd-6a75-54cd-8196-8b333a64cac5" #edb/ref 17592186045417] [17592186162905 #edb/ref 1063 #edb/ref 17592186162015 #edb/ref 17592186045417] [17592186163224 #edb/ref 1064 "Suppose that $A$ is an $n\\times n$ symmetric matrix over $\\mathbb{R}.$ The **spectral theorem** states the following:\n\n- The eigenvalues of $A$ are all real.\n\n- The eigenvectors corresponding to *different* eigenvalues are orthogonal.\n\n- The dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\n- $A$ is orthogonally diagonalizable." #edb/ref 17592186045417] [17592186163224 #edb/ref 1065 4882 #edb/ref 17592186045417] [17592186163224 #edb/ref 1066 #uuid "5ecbbdd0-25a0-52ee-8f0c-987dcd8ba584" #edb/ref 17592186045417] [17592186163224 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186163243 #edb/ref 1064 "We can write an $n\\times n$ symmetric matrix $A$ in terms of a sum of products of its eigenvalues and eigenvectors.\n\nSpecifically, if $\\mathbf{u}_i$ denotes an orthonormal eigenvector of $A$ corresponding to the eigenvalue $\\lambda_i$ for $i=1,\\ldots, n$, then\n\n$$\nA=\\sum_{i=1}^n \\lambda_i \\mathbf{u}_i \\mathbf{u}_i^T.\n$$\n\nExpressing a symmetric matrix $A$ in this way is called the **spectral decomposition** of $A.$\n\nTo demonstrate, let's find the spectral decomposition of the $2\\times 2$ symmetric matrix $A,$ given by\n\n![](images/40/408e7471e4ef788758d423af97f5683186f79192fd8933c350d45bb87f089875.svg)\n\nThe eigenvalues of $A$ are $\\lambda_1 = 6$ and $\\lambda_2 = -4,$ and the corresponding eigenvectors are\n\n![](images/0c/0c22f7dd97e83c358cb3cef1fcc2db902d908140109334a8cf1c22b35b29c6d2.svg)\n\nThe spectral decomposition of $A$ is given by\n\n$$\nA =\\sum_{i=1}^2 \\lambda_i \\mathbf{u}_i \\mathbf{u}_i^T = \\lambda_1 \\mathbf u_1 \\mathbf u_1^T + \\lambda_2 \\mathbf u_2 \\mathbf u_2^T,\n$$\n\nwhere $\\mathbf u_1$ and $\\mathbf u_2$ are orthonormal eigenvectors of $A$ corresponding to $\\lambda_1$ and $\\lambda_2,$ respectively.\n\nFirst, let's normalize our eigenvectors:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}] \\\\ {u}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}3 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the spectral decomposition of $A$ is\n\n$$\n\\begin{aligned}A & ={\\lambda }_{1}{u}_{1}{u}_{1}^{T}+{\\lambda }_{2}{u}_{2}{u}_{2}^{T} \\\\  & =6\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}1 & 3\\end{aligned}]+(-4)\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}3 \\\\ -1\\end{aligned}]\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}3 & -1\\end{aligned}] \\\\  & =6\\cdot \\frac{1}{10}[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\cdot [\\begin{aligned}1 & 3\\end{aligned}]+(-4)\\cdot \\frac{1}{10}[\\begin{aligned}3 \\\\ -1\\end{aligned}]\\cdot [\\begin{aligned}3 & -1\\end{aligned}] \\\\  & ={{6}_{⏟}}_{{\\lambda }_{1}}\\cdot {{[\\begin{aligned}\\frac{1}{10} & \\frac{3}{10} \\\\ \\frac{3}{10} & \\frac{9}{10}\\end{aligned}]}_{⏟}}_{{u}_{1}{u}_{1}^{T}}+{{(-4)}_{⏟}}_{{\\lambda }_{2}}\\cdot {{[\\begin{aligned}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{aligned}]}_{⏟}}_{{u}_{2}{u}_{2}^{T}}.\\end{aligned}\n$$\n\nIn this decomposition, the matrix $\\mathbf{u}_i \\mathbf{u}_i^T$ is the orthogonal projection matrix that maps any $\\mathbf x \\in \\mathbb R^2$ onto the subspace spanned by $\\mathbf u_i.$" #edb/ref 17592186045417] [17592186163243 #edb/ref 1065 4973 #edb/ref 17592186045417] [17592186163243 #edb/ref 1066 #uuid "a90957e3-e4b9-548d-930b-e060c6b63859" #edb/ref 17592186045417] [17592186163243 #edb/ref 1067 "The Spectral Decomposition of a Symmetric Matrix" #edb/ref 17592186045417] [17592186366581 #edb/ref 1075 #edb/ref 17592186366582 #edb/ref 17592186045417] [17592186366581 #edb/ref 1075 #edb/ref 17592186366583 #edb/ref 17592186045417] [17592186366581 #edb/ref 1075 #edb/ref 17592186366584 #edb/ref 17592186045417] [17592186366581 #edb/ref 1075 #edb/ref 17592186366585 #edb/ref 17592186045417] [17592186366581 #edb/ref 1075 #edb/ref 17592186366586 #edb/ref 17592186045417] [17592186366581 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186366581 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186366581 #edb/ref 1078 #edb/ref 17592186366586 #edb/ref 17592186045417] [17592186366581 #edb/ref 1079 #uuid "f4531768-c85a-5927-b9ea-dd6e8018f412" #edb/ref 17592186045417] [17592186366582 #edb/ref 1080 "[\\begin{aligned}-8 & -2 \\\\ -2 & 9\\end{aligned}]" #edb/ref 17592186045417] [17592186366582 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186366582 #edb/ref 1083 #uuid "f9efaaf0-779f-5a72-aa61-4761f6295dad" #edb/ref 17592186045417] [17592186366583 #edb/ref 1080 "[\\begin{aligned}1 & -3 \\\\ -3 & -2\\end{aligned}]" #edb/ref 17592186045417] [17592186366583 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186366583 #edb/ref 1083 #uuid "5d20e65d-8c96-5a7e-8fea-9024d97dc82f" #edb/ref 17592186045417] [17592186366584 #edb/ref 1080 "[\\begin{aligned}-5 & -4 \\\\ -4 & 6\\end{aligned}]" #edb/ref 17592186045417] [17592186366584 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186366584 #edb/ref 1083 #uuid "d2283d99-cd32-55e5-9365-da3163600171" #edb/ref 17592186045417] [17592186366585 #edb/ref 1080 "[\\begin{aligned}9 & -5 \\\\ -5 & -8\\end{aligned}]" #edb/ref 17592186045417] [17592186366585 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186366585 #edb/ref 1083 #uuid "1172809a-fec9-5ba9-a260-4a0f08543d35" #edb/ref 17592186045417] [17592186366586 #edb/ref 1080 "[\\begin{aligned}8 & -4 \\\\ -4 & -7\\end{aligned}]" #edb/ref 17592186045417] [17592186366586 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186366586 #edb/ref 1083 #uuid "d89d3c9b-2928-5750-a596-9fb110e7f349" #edb/ref 17592186045417] [17592186378065 #edb/ref 1068 #edb/ref 17592186378066 #edb/ref 17592186045417] [17592186378065 #edb/ref 1069 "q-95723" #edb/ref 17592186045417] [17592186378065 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186378065 #edb/ref 1071 "Suppose that\n\n$\\,$ ${v}_{1}=[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}]$\n\nare eigenvectors of a $2\\times 2$ symmetric matrix $A$ that correspond to the eigenvalues ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=-5,$ respectively. Find the matrix $A.$" #edb/ref 17592186045417] [17592186378065 #edb/ref 1072 #uuid "e3527660-7336-5854-9fe8-3ed70b1dd1cc" #edb/ref 17592186045417] [17592186378065 #edb/ref 1074 "The spectral decomposition of a $2\\times 2$ symmetric matrix $A$ is given by\n\n$$\nA={\\lambda }_{1}{u}_{1}\\cdot {u}_{1}^{T}+{\\lambda }_{2}{u}_{2}\\cdot {u}_{2}^{T},\n$$\n\nwhere ${u}_{1}$ and ${u}_{2}$ are orthonormal eigenvectors of $A$ corresponding to the eigenvalues ${\\lambda }_{1}$ and ${\\lambda }_{2},$ respectively.\n\nFirst, let's normalize our eigenvectors:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}] \\\\ {u}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}A & ={\\lambda }_{1}{u}_{1}{u}_{1}^{T}+{\\lambda }_{2}{u}_{2}{u}_{2}^{T} \\\\  & =5\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}1 & 3\\end{aligned}]+(-5)\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 & 1\\end{aligned}] \\\\  & =5\\cdot \\frac{1}{10}[\\begin{aligned}1 \\\\ 3\\end{aligned}][\\begin{aligned}1 & 3\\end{aligned}]+(-5)\\cdot \\frac{1}{10}[\\begin{aligned}-3 \\\\ 1\\end{aligned}][\\begin{aligned}-3 & 1\\end{aligned}] \\\\  & =\\frac{1}{10}(5\\cdot [\\begin{aligned}1 \\\\ 3\\end{aligned}][\\begin{aligned}1 & 3\\end{aligned}]+(-5)\\cdot [\\begin{aligned}-3 \\\\ 1\\end{aligned}][\\begin{aligned}-3 & 1\\end{aligned}]) \\\\  & =\\frac{1}{10}(5\\cdot [\\begin{aligned}1 & 3 \\\\ 3 & 9\\end{aligned}]+(-5)\\cdot [\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}]) \\\\  & =\\frac{1}{10}[\\begin{aligned}-40 & 30 \\\\ 30 & 40\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & 3 \\\\ 3 & 4\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186378066 #edb/ref 1075 #edb/ref 17592186378067 #edb/ref 17592186045417] [1759218