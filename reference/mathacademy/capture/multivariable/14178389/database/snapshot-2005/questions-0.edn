6045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -3 \\\\ -3 & -2\\end{aligned}]" :db/id #edb/ref 17592186366583} {:answer/id #uuid "d2283d99-cd32-55e5-9365-da3163600171" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & -4 \\\\ -4 & 6\\end{aligned}]" :db/id #edb/ref 17592186366584} {:answer/id #uuid "1172809a-fec9-5ba9-a260-4a0f08543d35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & -5 \\\\ -5 & -8\\end{aligned}]" :db/id #edb/ref 17592186366585} {:answer/id #uuid "d89d3c9b-2928-5750-a596-9fb110e7f349" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & -4 \\\\ -4 & -7\\end{aligned}]" :db/id #edb/ref 17592186366586}] :answer-field/correct {:answer/id #uuid "d89d3c9b-2928-5750-a596-9fb110e7f349" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & -4 \\\\ -4 & -7\\end{aligned}]" :db/id #edb/ref 17592186366586} :answer-field/id #uuid "f4531768-c85a-5927-b9ea-dd6e8018f412" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366581}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48eccd0e-cb0a-5561-99a4-875f56fc9de1" :question/math-academy-id "q-94769" :question/problem "Suppose that\n\n$\\,$ ${v}_{1}=[\\begin{aligned}-4 \\\\ 1\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}1 \\\\ 4\\end{aligned}]$\n\nare eigenvectors of a $2\\times 2$ symmetric matrix $A$ that correspond to the eigenvalues ${\\lambda }_{1}=9$ and ${\\lambda }_{2}=-8,$ respectively. Find the matrix $A.$" :question/worked-solution "The spectral decomposition of a $2\\times 2$ symmetric matrix $A$ is given by\n\n$$\nA={\\lambda }_{1}{u}_{1}\\cdot {u}_{1}^{T}+{\\lambda }_{2}{u}_{2}\\cdot {u}_{2}^{T},\n$$\n\nwhere ${u}_{1}$ and ${u}_{2}$ are orthonormal eigenvectors of $A$ corresponding to the eigenvalues ${\\lambda }_{1}$ and ${\\lambda }_{2},$ respectively.\n\nFirst, let's normalize our eigenvectors:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{17}}[\\begin{aligned}-4 \\\\ 1\\end{aligned}] \\\\ {u}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{17}}[\\begin{aligned}1 \\\\ 4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}A & ={\\lambda }_{1}{u}_{1}{u}_{1}^{T}+{\\lambda }_{2}{u}_{2}{u}_{2}^{T} \\\\  & =9\\cdot \\frac{1}{\\sqrt{17}}[\\begin{aligned}-4 \\\\ 1\\end{aligned}]\\cdot \\frac{1}{\\sqrt{17}}[\\begin{aligned}-4 & 1\\end{aligned}]+(-8)\\cdot \\frac{1}{\\sqrt{17}}[\\begin{aligned}1 \\\\ 4\\end{aligned}]\\cdot \\frac{1}{\\sqrt{17}}[\\begin{aligned}1 & 4\\end{aligned}] \\\\  & =9\\cdot \\frac{1}{17}[\\begin{aligned}-4 \\\\ 1\\end{aligned}][\\begin{aligned}-4 & 1\\end{aligned}]+(-8)\\cdot \\frac{1}{17}[\\begin{aligned}1 \\\\ 4\\end{aligned}][\\begin{aligned}1 & 4\\end{aligned}] \\\\  & =\\frac{1}{17}(9\\cdot [\\begin{aligned}-4 \\\\ 1\\end{aligned}][\\begin{aligned}-4 & 1\\end{aligned}]+(-8)\\cdot [\\begin{aligned}1 \\\\ 4\\end{aligned}][\\begin{aligned}1 & 4\\end{aligned}]) \\\\  & =\\frac{1}{17}(9\\cdot [\\begin{aligned}16 & -4 \\\\ -4 & 1\\end{aligned}]+(-8)\\cdot [\\begin{aligned}1 & 4 \\\\ 4 & 16\\end{aligned}]) \\\\  & =\\frac{1}{17}[\\begin{aligned}136 & -68 \\\\ -68 & -119\\end{aligned}] \\\\  & =[\\begin{aligned}8 & -4 \\\\ -4 & -7\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162662 :knowledge-point/_questions [{:db/id #edb/ref 17592186162014 :knowledge-point/id #uuid "84207049-12f7-514c-bfa2-51bce8631b41" :knowledge-point/title "Finding a Projection Matrix That Orthogonally Projects a Vector to the Subspace Spanned by an Eigenvector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9c90ddc-3a7e-5901-9890-61a3b68c434c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{26}\\begin{bmatrix}25 & -5 \\\\ -5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186161265} {:answer/id #uuid "eec7ab0c-ede6-5bb5-a2f9-7a1836134e2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{26}}\\begin{bmatrix}25 & -5 \\\\ -5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186161266} {:answer/id #uuid "0aafc558-d8e6-5a8e-af33-565a94375e50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{26}}\\begin{bmatrix}-1 & 5 \\\\ 5 & -25\\end{bmatrix}" :db/id #edb/ref 17592186161267} {:answer/id #uuid "32e83938-5ca7-5af2-b3f2-3d3cfb083896" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{26}\\begin{bmatrix}-1 & 5 \\\\ 5 & -25\\end{bmatrix}" :db/id #edb/ref 17592186161268} {:answer/id #uuid "357c04d8-9786-5cb9-a9b7-828536bbaeee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{26}\\begin{bmatrix}25 & -5 \\\\ -5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186161269}] :answer-field/id #uuid "27a49c53-38b7-5dbb-b5f4-f47add37c5d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161264}] :question/id #uuid "28c27a06-cd3b-5e3d-a19e-4b46b9bccd18" :question/math-academy-id "q-95714" :question/problem "Find the orthogonal projection matrix that maps $x ∈ R^{2}$ onto the subspace spanned by an eigenvector corresponding to the eigenvalue $λ =-10$ of the matrix $A = \\begin{bmatrix}-9 & 5 \\\\ 5 & 15\\end{bmatrix}$."}] [{:db/id #edb/ref 17592186378065 :knowledge-point/_questions [{:db/id #edb/ref 17592186162015 :knowledge-point/id #uuid "785b09aa-1b82-5021-8b10-271a063cb916" :knowledge-point/title "Finding the Spectral Decomposition of a Symmetric Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddb77fdb-9e1a-59d2-a520-e52d80297bad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 3 \\\\ 3 & 2\\end{aligned}]" :db/id #edb/ref 17592186378067} {:answer/id #uuid "20a24a23-34cd-59e2-919c-ffa350d8078c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 1 \\\\ 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186378068} {:answer/id #uuid "a2f8cd17-d0e2-5147-8618-30de79a463fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 3 \\\\ 3 & 4\\end{aligned}]" :db/id #edb/ref 17592186378069} {:answer/id #uuid "5649503f-0459-5e9f-9fcf-d4672d0737b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 1 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186378070} {:answer/id #uuid "cc6a63c9-7482-5e58-94cf-dffcb3862ae0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 2 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186378071}] :answer-field/correct {:answer/id #uuid "a2f8cd17-d0e2-5147-8618-30de79a463fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 3 \\\\ 3 & 4\\end{aligned}]" :db/id #edb/ref 17592186378069} :answer-field/id #uuid "1ed15ba3-7536-51e1-aa4c-32ec9da0175e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378066}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e3527660-7336-5854-9fe8-3ed70b1dd1cc" :question/math-academy-id "q-95723" :question/problem "Suppose that\n\n$\\,$ ${v}_{1}=[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}]$\n\nare eigenvectors of a $2\\times 2$ symmetric matrix $A$ that correspond to the eigenvalues ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=-5,$ respectively. Find the matrix $A.$" :question/worked-solution "The spectral decomposition of a $2\\times 2$ symmetric matrix $A$ is given by\n\n$$\nA={\\lambda }_{1}{u}_{1}\\cdot {u}_{1}^{T}+{\\lambda }_{2}{u}_{2}\\cdot {u}_{2}^{T},\n$$\n\nwhere ${u}_{1}$ and ${u}_{2}$ are orthonormal eigenvectors of $A$ corresponding to the eigenvalues ${\\lambda }_{1}$ and ${\\lambda }_{2},$ respectively.\n\nFirst, let's normalize our eigenvectors:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}] \\\\ {u}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}A & ={\\lambda }_{1}{u}_{1}{u}_{1}^{T}+{\\lambda }_{2}{u}_{2}{u}_{2}^{T} \\\\  & =5\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}1 & 3\\end{aligned}]+(-5)\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]\\cdot \\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 & 1\\end{aligned}] \\\\  & =5\\cdot \\frac{1}{10}[\\begin{aligned}1 \\\\ 3\\end{aligned}][\\begin{aligned}1 & 3\\end{aligned}]+(-5)\\cdot \\frac{1}{10}[\\begin{aligned}-3 \\\\ 1\\end{aligned}][\\begin{aligned}-3 & 1\\end{aligned}] \\\\  & =\\frac{1}{10}(5\\cdot [\\begin{aligned}1 \\\\ 3\\end{aligned}][\\begin{aligned}1 & 3\\end{aligned}]+(-5)\\cdot [\\begin{aligned}-3 \\\\ 1\\end{aligned}][\\begin{aligned}-3 & 1\\end{aligned}]) \\\\  & =\\frac{1}{10}(5\\cdot [\\begin{aligned}1 & 3 \\\\ 3 & 9\\end{aligned}]+(-5)\\cdot [\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}]) \\\\  & =\\frac{1}{10}[\\begin{aligned}-40 & 30 \\\\ 30 & 40\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & 3 \\\\ 3 & 4\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395066 :knowledge-point/_questions [{:db/id #edb/ref 17592186162015 :knowledge-point/id #uuid "785b09aa-1b82-5021-8b10-271a063cb916" :knowledge-point/title "Finding the Spectral Decomposition of a Symmetric Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d17ddb9-9738-5247-980d-6346f34ca3d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186395068} {:answer/id #uuid "9112c274-741d-5926-a7e8-28550395e3fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186395069} {:answer/id #uuid "a6833e0f-d872-5f84-8fad-2cd587942a79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -1 \\\\ -1 & -2\\end{aligned}]" :db/id #edb/ref 17592186395070} {:answer/id #uuid "b6a1eeb9-2422-526b-996e-3116b894cad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 \\\\ -1 & -2\\end{aligned}]" :db/id #edb/ref 17592186395071} {:answer/id #uuid "bb3216f5-0141-54bf-b967-4b7d4a78081b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 \\\\ -1 & 2\\end{aligned}]" :db/id #edb/ref 17592186395072}] :answer-field/correct {:answer/id #uuid "7d17ddb9-9738-5247-980d-6346f34ca3d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186395068} :answer-field/id #uuid "da07241e-4465-5487-a804-a1f93208770d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395067}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4f741f54-e9ba-55b4-9c81-df73745d51c8" :question/math-academy-id "q-95724" :question/problem "Suppose that\n\n$\\,$ ${v}_{1}=[\\begin{aligned}1 \\\\ 1\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$\n\nare eigenvectors of a $2\\times 2$ symmetric matrix $A$ that correspond to the eigenvalues ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=1,$ respectively. Find the matrix $A.$" :question/worked-solution "The spectral decomposition of a $2\\times 2$ symmetric matrix $A$ is given by\n\n$$\nA={\\lambda }_{1}{u}_{1}\\cdot {u}_{1}^{T}+{\\lambda }_{2}{u}_{2}\\cdot {u}_{2}^{T},\n$$\n\nwhere ${u}_{1}$ and ${u}_{2}$ are orthonormal eigenvectors of $A$ corresponding to the eigenvalues ${\\lambda }_{1}$ and ${\\lambda }_{2},$ respectively.\n\nFirst, let's normalize our eigenvectors:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\ {u}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}A & ={\\lambda }_{1}{u}_{1}{u}_{1}^{T}+{\\lambda }_{2}{u}_{2}{u}_{2}^{T} \\\\  & =3\\cdot \\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]\\cdot \\frac{1}{\\sqrt{2}}[\\begin{aligned}1 & 1\\end{aligned}]+1\\cdot \\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\\cdot \\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 1\\end{aligned}] \\\\  & =3\\cdot \\frac{1}{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}][\\begin{aligned}1 & 1\\end{aligned}]+1\\cdot \\frac{1}{2}[\\begin{aligned}-1 \\\\ 1\\end{aligned}][\\begin{aligned}-1 & 1\\end{aligned}] \\\\  & =\\frac{1}{2}(3\\cdot [\\begin{aligned}1 \\\\ 1\\end{aligned}][\\begin{aligned}1 & 1\\end{aligned}]+1\\cdot [\\begin{aligned}-1 \\\\ 1\\end{aligned}][\\begin{aligned}-1 & 1\\end{aligned}]) \\\\  & =\\frac{1}{2}(3\\cdot [\\begin{aligned}1 & 1 \\\\ 1 & 1\\end{aligned}]+1\\cdot [\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}]) \\\\  & =\\frac{1}{2}[\\begin{aligned}4 & 2 \\\\ 2 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}].\\end{aligned}\n$$"}]}
