}\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2{e}^{t} & 2{e}^{t} \\\\ 0 & {e}^{-3t}\\end{aligned}] \\\\ {Φ}^{-1}\\,f(t) & =\\frac{1}{2}[\\begin{aligned}2{e}^{t} & 2{e}^{t} \\\\ 0 & {e}^{-3t}\\end{aligned}][\\begin{aligned}6 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}2{e}^{t} \\\\ -2{e}^{-3t}\\end{aligned}]\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int [\\begin{aligned}2{e}^{t} \\\\ -2{e}^{-3t}\\end{aligned}]\\,\\text{d}t \\\\  & =[\\begin{aligned}\\int 2{e}^{t}\\,\\text{d}t \\\\ \\int -2{e}^{-3t}\\,\\text{d}t\\end{aligned}] \\\\  & =[\\begin{aligned}2{e}^{t} \\\\ \\frac{2}{3}{e}^{-3t}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =[\\begin{aligned}{e}^{-t} & -2{e}^{3t} \\\\ 0 & 2{e}^{3t}\\end{aligned}][\\begin{aligned}2{e}^{t} \\\\ \\frac{2}{3}{e}^{-3t}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{2}{3} \\\\ \\frac{4}{3}\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186365793 #edb/ref 1075 #edb/ref 17592186365794 #edb/ref 17592186045417] [17592186365793 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186365793 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186365793 #edb/ref 1078 #edb/ref 17592186365794 #edb/ref 17592186045417] [17592186365793 #edb/ref 1079 #uuid "ef783e3c-2210-5313-90c8-cc217b3c7be3" #edb/ref 17592186045417] [17592186365794 #edb/ref 1080 "-2{e}^{-3t}" #edb/ref 17592186045417] [17592186365794 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186365794 #edb/ref 1083 #uuid "ff2cccf5-489b-5e70-b3a9-9d2661562299" #edb/ref 17592186045417] [17592186365795 #edb/ref 1075 #edb/ref 17592186365796 #edb/ref 17592186045417] [17592186365795 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186365795 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186365795 #edb/ref 1078 #