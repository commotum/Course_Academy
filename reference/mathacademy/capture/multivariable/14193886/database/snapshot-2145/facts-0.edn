17592186076872 #edb/ref 1080 "\\frac{1}{4}" #edb/ref 17592186045417] [17592186076872 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186076872 #edb/ref 1083 #uuid "378649dc-10c5-573f-8c40-5f3d305b7d0e" #edb/ref 17592186045417] [17592186076873 #edb/ref 1080 "\\frac{3}{2}" #edb/ref 17592186045417] [17592186076873 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186076873 #edb/ref 1083 #uuid "3ddb90c9-e4c6-5493-80b0-e39376fb857e" #edb/ref 17592186045417] [17592186078220 #edb/ref 1069 "e-263" #edb/ref 17592186045417] [17592186078220 #edb/ref 1071 "Given that the function\n![](images/f7/f72fd02a0488c44ac7472487222507c5739853cd25720502a726844e0c23c915.svg)\nis continuous at $x=0,$ find the value of the constant $b.$" #edb/ref 17592186045417] [17592186078220 #edb/ref 1072 #uuid "d17b0e14-aabc-5814-a242-d5fb803cb406" #edb/ref 17592186045417] [17592186078220 #edb/ref 1074 "At $x=0,$ the left-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to {0}^{-}}\\sqrt{2b-3x} \\\\  & =\\sqrt{2b-3(0)} \\\\  & =\\sqrt{2b},\\end{aligned}\n$$\n\nand the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}f(x) & ={lim}_{x\\to {0}^{+}}(-x+2) \\\\  & =-(0)+2 \\\\  & =2.\\end{aligned}\n$$\n\nIn order for $f(x)$ to be continuous at $x=0,$ we require that\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to {0}^{+}}f(x) \\\\ 2 & =\\sqrt{2b} \\\\ 4 & =2b \\\\ b & =2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186078222 #edb/ref 1069 "e-264" #edb/ref 17592186045417] [17592186078222 #edb/ref 1071 "Find the value(s) of the constant $a$ that make the function $f(x)$ below continuous at $x=2.$\n![](images/be/bee9ecfc2bcfaa7741ed1c2aca90b8a077c19715c2a642a9622856f986f434f3.svg)" #edb/ref 17592186045417] [17592186078222 #edb/ref 1072 #uuid "90e5fce3-26db-513d-9270-1e60b8dfb0d9" #edb/ref 17592186045417] [17592186078222 #edb/ref 1074 "At $x=2,$ the left-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}f(x) & ={lim}_{x\\to {2}^{-}}(2x+a)^{2} \\\\  & =(2(2)+a)^{2} \\\\  & =(4+a)^{2},\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}f(x) & ={lim}_{x\\to {2}^{+}}({x}^{2}-3) \\\\  & =(2)^{2}-3 \\\\  & =4-3 \\\\  & =1.\\end{aligned}\n$$\n\nIn order for $f(x)$ to be continuous at $x=2,$ we require that\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}f(x) & ={lim}_{x\\to {2}^{+}}f(x) \\\\ (4+a)^{2} & =1 \\\\ \\sqrt{(a+4)^{2}} & =\\sqrt{1} \\\\ |a+4| & =1 \\\\ a+4 & =\\pm 1 \\\\ a & =-4\\pm 1 \\\\ a & =-5,-3.\\end{aligned}\n$$\n\nTherefore, $f(x)$ is continuous at $x=2$ for $a=-5$ or $a=-3.$" #edb/ref 17592186045417] [17592186078225 #edb/ref 1069 "e-265" #edb/ref 17592186045417] [17592186078225 #edb/ref 1071 "Given that the function\n![](images/47/47e2bbdd0741bbac490c3ac0851e95b2103078e22d06d4a369712236529e8302.svg) \nis continuous at $x=1$, find the value of $a.$" #edb/ref 17592186045417] [17592186078225 #edb/ref 1072 #uuid "b19955e9-3e5d-597e-81bc-f8f675e78e9b" #edb/ref 17592186045417] [17592186078225 #edb/ref 1074 "At $x=1,$ the left-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}g(x) & ={lim}_{x\\to {1}^{-}}{log}_{2}⁡(ax+1) \\\\  & ={log}_{2}⁡(a(1)+1) \\\\  & ={log}_{2}⁡(a+1),\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}g(x) & ={lim}_{x\\to {1}^{+}}({log}_{3}⁡(2x+1)) \\\\  & ={log}_{3}⁡(2(1)+1) \\\\  & ={log}_{3}⁡(3) \\\\  & =1.\\end{aligned}\n$$\n\nIn order for $g(x)$ to be continuous at $x=1,$ we require that\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}g(x) & ={lim}_{x\\to {1}^{+}}g(x) \\\\ {log}_{2}⁡(a+1) & =1 \\\\ a+1 & ={2}^{1} \\\\ a & =1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186078334 #edb/ref 1069 "e-6279" #edb/ref 17592186045417] [17592186078334 #edb/ref 1071 "Find the value of the constant $c$ that makes the function $h(x)$ below continuous at $x=4.$\n![](images/6e/6ed78555d5936e679b9aecd838d8b07f95031afe831eb3ef3e7cb64c5160f7c1.svg)" #edb/ref 17592186045417] [17592186078334 #edb/ref 1072 #uuid "aef91e7a-138c-58bc-a25c-ca77284581c3" #edb/ref 17592186045417] [17592186078334 #edb/ref 1074 "At $x=4,$ the left-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{-}}h(x) & =h(4) \\\\  & ={4}^{c(4)+1} \\\\  & ={4}^{4c+1},\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{+}}h(x) & ={lim}_{x\\to {4}^{+}}(4x) \\\\  & =4(4) \\\\  & =16.\\end{aligned}\n$$\n\nIn order for $h(x)$ to be continuous at $x=4,$ we require that\n\n$$\n\\begin{aligned}{4}^{4c+1} & =16 \\\\ {4}^{4c+1} & ={4}^{2} \\\\ 4c+1 & =2 \\\\ 4c & =1 \\\\ c & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, $h(x)$ is continuous at $x=4$ for $c = \\dfrac{1}{4}.$" #edb/ref 17592186045417] [17592186078382 #edb/ref 1037 #edb/ref 17592186048784 #edb/ref 17592186045417] [17592186078382 #edb/ref 1038 #edb/ref 17592186079012 #edb/ref 17592186045417] [17592186078382 #edb/ref 1038 #edb/ref 17592186079013 #edb/ref 17592186045417] [17592186078382 #edb/ref 1038 #edb/ref 17592186507439 #edb/ref 17592186045417] [17592186078382 #edb/ref 1038 #edb/ref 17592186507451 #edb/ref 17592186045417] [17592186078382 #edb/ref 1038 #edb/ref 17592186507460 #edb/ref 17592186045417] [17592186078382 #edb/ref 1038 #edb/ref 17592186507466 #edb/ref 17592186045417] [17592186078382 #edb/ref 1039 "Removing a Jump Discontinuity in a Piecewise Radical Function" #edb/ref 17592186045417] [17592186078382 #edb/ref 1041 #edb/ref 17592186078220 #edb/ref 17592186045417] [17592186078382 #edb/ref 1042 #uuid "55607d46-d93c-5306-9b2e-b9a8e79366eb" #edb/ref 17592186045417] [17592186078383 #edb/ref 1037 #edb/ref 17592186048963 #edb/ref 17592186045417] [17592186078383 #edb/ref 1037 #edb/ref 17592186049593 #edb/ref 17592186045417] [17592186078383 #edb/ref 1037 #edb/ref 17592186050124 #edb/ref 17592186045417] [17592186078383 #edb/ref 1038 #edb/ref 17592186078949 #edb/ref 17592186045417] [17592186078383 #edb/ref 1038 #edb/ref 17592186079011 #edb/re