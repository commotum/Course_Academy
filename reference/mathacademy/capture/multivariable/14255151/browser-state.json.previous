      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14255151/observations/step-q334532-fae8c72876daf3cfc737.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14255151/observations/step-q334532-fae8c72876daf3cfc737.png",
      "source_url": "https://mathacademy.com/tasks/14255151/topics/6379/review",
