      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14255151/observations/step-q334620-058186cbffd65db8891c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14255151/observations/step-q334620-058186cbffd65db8891c.png",
      "source_url": "https://mathacademy.com/tasks/14255151/topics/6379/review",
