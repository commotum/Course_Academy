45498} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186312594} {:answer/id #uuid "72b80f7b-088d-51a1-9120-764f5e7af0ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186312880} {:answer/id #uuid "7938bdd0-ab46-5b80-9a88-703c52b67232" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{1}" :db/id #edb/ref 17592186312944}] :answer-field/correct {:db/id #edb/ref 17592186312594} :answer-field/id #uuid "bec85f47-7594-555b-98c5-7a111c7fab2e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314539}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c36e0e36-a227-5df1-b273-538c9f56de6b" :question/math-academy-id "q-340652" :question/problem "Let $F(x)={x}^{3}-3{x}^{2}$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [-\\pi ,\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${b}_{1}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[-\\pi ,\\pi ).$\n\n$$\n\\begin{aligned}{b}_{1} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [-\\pi ,\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [-\\pi ,\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{sin}⁡(x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{sin}⁡(x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{sin}⁡(x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{sin}⁡(x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{b}_{1}⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩ & ={\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡(x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}-\\frac{1}{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x-\\frac{1}{4}\\operatorname{sin}⁡(2x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))-\\frac{1}{4}(\\operatorname{sin}⁡(2\\pi )-(\\operatorname{sin}⁡(-2\\pi ))) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(x)⟩ & ={b}_{1}⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩ \\\\ {b}_{1} & =\\frac{⟨f(x),\\operatorname{sin}⁡(x)⟩}{⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩} \\\\ {b}_{1} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{-\\pi }^{\\pi }({x}^{3}-3{x}^{2})\\operatorname{sin}⁡(x)\\,\\text{d}x.\\end{aligned}\n$$"} :step/id #uuid "440f6dd4-82ee-5ff2-8be5-84dc9c2b1345" :step/next {:db/id #edb/ref 17592186555876}} {:db/id #edb/ref 17592186555903 :step/content {:db/id #edb/ref 17592186314970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18f8b6c4-dc61-5952-b970-50080ba23ded" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186312150} {:answer/id #uuid "77366691-f549-599e-bab1-698ac3eb9e62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186312930} {:answer/id #uuid "cc46ef65-e857-5164-a7e5-34465ecfdb28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186313571} {:answer/id #uuid "f6401f00-bf5f-521c-a263-60f469691296" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186313945}] :answer-field/correct {:db/id #edb/ref 17592186313945} :answer-field/id #uuid "330a3eca-372e-59a7-9bf8-d2efffe99e10" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314147} {:answer-field/choices [{:answer/id #uuid "e3bcbcb0-ba3d-57ed-97b9-85742d944618" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "are not orthogonal" :db/id #edb/ref 17592186413377} {:answer/id #uuid "f54e1f11-1b9d-5dcf-819b-ddcca88bb9fa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "are orthogonal" :db/id #edb/ref 17592186413381}] :answer-field/correct {:db/id #edb/ref 17592186413381} :answer-field/id #uuid "2d41b053-3b5f-5c34-91f8-1d643d3b5746" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186413386}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0e763dfc-e659-54e6-9b52-205e19a11f13" :question/math-academy-id "q-340528" :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [0,2\\pi ]$ defined above, select the correct options below.\n\n$\\,$\n$⟨\\operatorname{cos}⁡(3x),1⟩=$ \n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{cos}⁡(3x)$ and $g(x)=1$ \n{{field-2}}." :question/worked-solution "Evaluating the inner product, we obtain\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(3x),1⟩ & ={\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & ={[\\frac{1}{3}\\operatorname{sin}⁡(3x)]}_{0}^{2\\pi } \\\\  & =\\frac{1}{3}(\\operatorname{sin}⁡(6\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{3}(0-0) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{cos}⁡(3x)$ and $g(x)=1$ \n$\\text{are orthogonal}$ with respect to the inner product."} :step/id #uuid "53681c98-234f-5dcc-b3cd-0cc8d5f9278e" :step/next {:db/id #edb/ref 17592186555901}} {:db/id #edb/ref 17592186555929 :step/content {:db/id #edb/ref 17592186314940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "519814f5-ed1b-51b6-be42-701a06d5265e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "are not orthogonal" :db/id #edb/ref 17592186312641} {:answer/id #uuid "95b4bc14-3372-51dc-8763-57839bd1c948" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "are orthogonal" :db/id #edb/ref 17592186313172}] :answer-field/correct {:db/id #edb/ref 17592186313172} :answer-field/id #uuid "bdb0a620-4521-5768-b99c-bcb9e240ba49" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314534} {:answer-field/choices [{:answer/id #uuid "37bd8b3c-bc05-54eb-8f57-a55be5021855" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186312424} {:answer/id #uuid "44030d02-2f0e-52b1-b64d-de590270d455" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186312522} {:answer/id #uuid "d4075d04-803b-5c99-bdac-b3260aa45ef2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186313642} {:answer/id #uuid "fa59b168-761a-5bf2-b1fd-942fcfe16bcd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186313973}] :answer-field/correct {:db/id #edb/ref 17592186313642} :answer-field/id #uuid "d9d5f723-31ec-5260-873d-bac32456689b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314613}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "77cb7a42-6cad-573a-85fb-a6a039017afb" :question/math-academy-id "q-340369" :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [0,2\\pi )$ defined above, select the correct options below.\n\n$\\,$\n$⟨\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(5x)⟩=$\n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{sin}⁡(2x)$ and $g(x)=\\operatorname{cos}⁡(5x)$ \n{{field-2}}." :question/worked-solution "We begin by using the product-to-sum identity\n\n$$\n\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(5x)=\\frac{1}{2}(\\operatorname{sin}⁡(7x)-\\operatorname{sin}⁡(3x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(5x)⟩ & ={\\int }_{0}^{2\\pi }\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}\\operatorname{sin}⁡(7x)-\\frac{1}{2}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{14}\\operatorname{cos}⁡(7x)+\\frac{1}{6}\\operatorname{cos}⁡(3x)]}_{0}^{2\\pi } \\\\  & =-\\frac{1}{14}(\\operatorname{cos}⁡(14\\pi )-\\operatorname{cos}⁡(0))+\\frac{1}{6}(\\operatorname{cos}⁡(6\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{14}(1-1)+\\frac{1}{6}(1-1) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{sin}⁡(2x)$ and $g(x)=\\operatorname{cos}⁡(5x)$ $\\text{are orthogonal}$ with respect to the inner product."} :step/id #uuid "bfaa799e-2d23-5319-807d-34c9faefd8ab" :step/next {:db/id #edb/ref 17592186555903}} {:db/id #edb/ref 17592186555956 :step/content {:db/id #edb/ref 17592186397539 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d7d31a3-b2e8-5955-b7a5-8d0265e34185" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }(3x+1)\\operatorname{sin}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186397541} {:answer/id #uuid "14f752d4-26f3-5b55-951a-267514a31272" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\infty }(3x+1)\\,\\text{d}x" :db/id #edb/ref 17592186397542} {:answer/id #uuid "86ecc11d-d361-56e3-b985-f0af7df41e5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi }^{\\pi }(3x+1)\\,\\text{d}x" :db/id #edb/ref 17592186397543} {:answer/id #uuid "3ecabd1c-c6be-5ae6-a083-97bdd6237c82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }(3x+1)\\operatorname{cos}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186397544} {:answer/id #uuid "b23326b9-dc50-5189-864f-580f0beb25f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }(3x+1)\\,\\text{d}x" :db/id #edb/ref 17592186397545}] :answer-field/correct {:db/id #edb/ref 17592186397545} :answer-field/id #uuid "40e8826c-c720-5c71-8e60-9efc9028ee9f" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186397540} {:answer-field/choices [{:answer/id #uuid "74b0c5c0-5b9c-5ca0-a3b8-c0e23762591f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186397547} {:answer/id #uuid "037567f7-c39a-5a21-9477-5930025ede7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186397548} {:answer/id #uuid "5a2e6cae-f02e-5650-9bdf-362d1f1fa2b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186397549} {:answer/id #uuid "64699d60-b695-59b3-84f5-62b93bdee4e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186397550} {:answer/id #uuid "4c59d8f0-ecad-5bf2-9285-f977292bfdcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186397551}] :answer-field/correct {:db/id #edb/ref 17592186397551} :answer-field/id #uuid "df14591b-b6cc-5cdd-adc7-9dbfe95edc2a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186397546} {:answer-field/choices [{:answer/id #uuid "cd7a6256-c073-5d27-93a0-6184aec661c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(x)⟩}{⟨\\operatorname{cos}⁡(x),\\operatorname{cos}⁡(x)⟩}" :db/id #edb/ref 17592186397553} {:answer/id #uuid "e3d09424-4779-58cb-a9a8-a20b503a58f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨f(x),1⟩}{⟨1,1⟩}" :db/id #edb/ref 17592186397554} {:answer/id #uuid "fd0b285c-99a5-5dc6-b53e-349ca170a4bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2⟨f(x),1⟩}{⟨1,1⟩}" :db/id #edb/ref 17592186397555} {:answer/id #uuid "d6de7f97-87a8-587c-be9e-52648a5b0102" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(x)⟩}{⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩}" :db/id #edb/ref 17592186397556} {:answer/id #uuid "330f62f3-2b9c-5888-9cec-d52701d82d24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨1,1⟩}{⟨f(x),1⟩}" :db/id #edb/ref 17592186397557}] :answer-field/correct {:db/id #edb/ref 17592186397555} :answer-field/id #uuid "7e635cb7-5fb0-5dc2-9345-111ede6d51d4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186397552}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "73b220ad-78ed-5227-b775-ed2065f7b0fd" :question/math-academy-id "q-341308" :question/problem "Let $F(x)=3x+1$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [0,2\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${a}_{0}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[0,2\\pi ).$\n\n$$\n\\begin{aligned}{a}_{0} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [0,2\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [0,2\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $1:$\n\n$$\n\\begin{aligned}⟨f(x),1⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),1⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},1⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),1⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,1⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),1⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n\\frac{{a}_{0}}{2}⟨1,1⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨1,1⟩ & ={\\int }_{0}^{2\\pi }1\\,\\text{d}x \\\\  & ={[x]}_{-0}^{2\\pi } \\\\  & =2\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),1⟩ & =\\frac{{a}_{0}}{2}⟨1,1⟩ \\\\ {a}_{0} & =\\frac{2⟨f(x),1⟩}{⟨1,1⟩} \\\\ {a}_{0} & =\\frac{1}{\\pi }{\\int }_{0}^{2\\pi }f(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{0}^{2\\pi }(3x+1)\\,\\text{d}x.\\end{aligned}\n$$"} :step/id #uuid "f2118caf-c788-5ceb-a91a-d62e8e58f0ff"}] :activity/title "Introduction to Fourier Series" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186554997}] [{:activity/course {:db/id #edb/ref 17592186046669} :activity/first-step {:db/id #edb/ref 17592186561094} :activity/id #uuid "3fc34682-2788-5d35-a598-6c561e7bf54f" :activity/scope {:db/id #edb/ref 17592186049306 :topic/id #uuid "eb34afb7-9644-525e-b42b-cf82816ee5e0" :topic/math-academy-id 3195} :activity/steps [{:db/id #edb/ref 17592186561070 :step/content {:db/id #edb/ref 17592186560989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28c4a6e3-5da0-58a8-98e1-f77482614d3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186560451} {:answer/id #uuid "725d1c02-12f5-5f02-85e7-82273cab47b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186560608} {:answer/id #uuid "cbd85793-6947-508a-a2bc-51a8f84903cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186560771} {:answer/id #uuid "def61838-0d97-5c99-a6a2-029dbf9530cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186560802}] :answer-field/correct {:db/id #edb/ref 17592186560608} :answer-field/id #uuid "a93c54f2-4edf-5990-a1a6-6112ce35e742" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186560937} {:answer-field/choices [{:answer/id #uuid "e6d2f72f-505b-52a6-90d0-77735f112651" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "are not orthogonal" :db/id #edb/ref 17592186560815} {:answer/id #uuid "f2c187c8-63e1-5c83-9092-edcee77f622b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "are orthogonal" :db/id #edb/ref 17592186560848}] :answer-field/correct {:db/id #edb/ref 17592186560848} :answer-field/id #uuid "d4b06de8-f439-591e-a69d-d8f31e9bf9a8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186560956}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "31cb2aad-4101-56c2-adfa-13a34142aa32" :question/math-academy-id "q-340530" :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [-\\pi ,\\pi )$ defined above, select the correct options below.\n\n$\\,$\n$⟨\\operatorname{sin}⁡(4x),\\operatorname{sin}⁡(7x)⟩=$\n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{sin}⁡(4x)$ and $g(x)=\\operatorname{sin}⁡(7x)$ \n{{field-2}}." :question/worked-solution "We begin by using the product-to-sum identity\n\n$$\n\\operatorname{sin}⁡(4x)\\operatorname{sin}⁡(7x)=\\frac{1}{2}(\\operatorname{cos}⁡(3x)-\\operatorname{cos}⁡(11x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(4x),\\operatorname{sin}⁡(7x)⟩ & ={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡(4x)\\operatorname{sin}⁡(7x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}\\operatorname{cos}⁡(3x)-\\frac{1}{2}\\operatorname{cos}⁡(11x)\\,\\text{d}x \\\\  & ={[\\frac{1}{6}\\operatorname{sin}⁡(3x)-\\frac{1}{22}\\operatorname{sin}⁡(11x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{6}(\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(-3\\pi ))-\\frac{1}{22}(\\operatorname{sin}⁡(11\\pi )-\\operatorname{sin}⁡(-11\\pi )) \\\\  & =\\frac{1}{6}(0-0)-\\frac{1}{22}(0-0) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{sin}⁡(4x)$ and $g(x)=\\operatorname{sin}⁡(7x)$ \n$\\text{are orthogonal}$ with respect to the inner product."} :step/id #uuid "43c884c8-fa1e-5751-bf45-58abee1b87ae" :step/next {:db/id #edb/ref 17592186561084}} {:db/id #edb/ref 17592186561077 :step/content {:db/id #edb/ref 17592186315084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a485b2b2-9921-5fd5-bd9d-f8899940f0fb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "are orthogonal" :db/id #edb/ref 17592186313268} {:answer/id #uuid "cd2136e8-d9d6-5af6-a549-5e509b077f3d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "are not orthogonal" :db/id #edb/ref 17592186313579}] :answer-field/correct {:db/id #edb/ref 17592186313268} :answer-field/id #uuid "45a717f2-4ea4-5657-bb93-c452e09b74ae" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314202} {:answer-field/choices [{:answer/id #uuid "14b12c1a-93ae-5bc6-9fe8-42c8eda21ee1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186312119} {:answer/id #uuid "1b4f5c80-0a03-57e7-8507-5198d48c6bfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186312177} {:answer/id #uuid "4693d13b-e7f3-533f-a819-ee280e597461" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186312552} {:answer/id #uuid "7f7359a2-3aa5-59d3-a824-65f7cf6dc11f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186313001}] :answer-field/correct {:db/id #edb/ref 17592186312119} :answer-field/id #uuid "98de6f2f-ef74-5be0-a949-95ef2c54203f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186314426}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "22b987d7-9005-5317-ab10-48027150c40e" :question/math-academy-id "q-341340" :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [0,2\\pi )$ defined above, select the correct options below.\n\n$\\,$\n$⟨\\operatorname{sin}⁡(3x),\\operatorname{cos}⁡(4x)⟩=$\n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{sin}⁡(3x)$ and $g(x)=\\operatorname{cos}⁡(4x)$ \n{{field-2}}." :question/worked-solution "We begin by using the product-to-sum identity\n\n$$\n\\operatorname{sin}⁡(3x)\\operatorname{cos}⁡(4x)=\\frac{1}{2}(\\operatorname{sin}⁡(7x)-\\operatorname{sin}⁡(x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(3x),\\operatorname{cos}⁡(4x)⟩ & ={\\int }_{0}^{2\\pi }\\operatorname{sin}⁡(3x)\\operatorname{cos}⁡(4x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}\\operatorname{sin}⁡(7x)-\\frac{1}{2}\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{14}\\operatorname{cos}⁡(7x)+\\frac{1}{2}\\operatorname{cos}⁡(x)]}_{0}^{2\\pi } \\\\  & =-\\frac{1}{14}(\\operatorname{cos}⁡(14\\pi )-\\operatorname{cos}⁡(0))+\\frac{1}{2}(\\operatorname{cos}⁡(2\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{14}(1-1)+\\frac{1}{2}(1-1) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{sin}⁡(3x)$ and $g(x)=\\operatorname{cos}⁡(4x)$ $\\text{are orthogonal}$ with respect to the inner product."} :step/id #uuid "71d08261-f990-5825-b224-1a3b072f84e8"} {:db/id #edb/ref 17592186561084 :step/content {:db/id #edb/ref 17592186561049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "323dbbe1-3082-574e-a141-37fe7a4c73f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }(3x-4)\\operatorname{sin}⁡(7x)\\,\\text{d}x" :db/id #edb/ref 17592186560474} {:answer/id #uuid "5dc6d044-465e-59bd-9043-3e7128925241" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi }^{\\pi }(3x-4)\\operatorname{cos}⁡(7x)\\,\\text{d}x" :db/id #edb/ref 17592186560564} {:answer/id #uuid "85455903-4384-59bb-81d1-d48fab31a874" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi }^{\\pi }(3x-4)\\operatorname{sin}⁡(7x)\\,\\text{d}x" :db/id #edb/ref 17592186560644} {:answer/id #uuid "b0567346-ea67-5cbd-8a39-1edf72d23033" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\infty }(3x-4)\\operatorname{cos}⁡(7x)\\,\\text{d}x" :db/id #edb/ref 17592186560718} {:answer/id #uuid "b491bbd6-91a8-541b-af25-681e01942fd5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\infty }(3x-4)\\operatorname{sin}⁡(7x)\\,\\text{d}x" :db/id #edb/ref 17592186560728} {:answer/id #uuid "d60aa3ac-c858-5bd4-846e-6e412ce0854c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }(3x-4)\\operatorname{cos}⁡(7x)\\,\\text{d}x" :db/id #edb/ref 17592186560788}] :answer-field/correct {:db/id #edb/ref 17592186560788} :answer-field/id #uuid "348d6e77-d6f5-5569-b7f3-7f014d07ae33" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186560884} {:answer-field/choices [{:answer/id #uuid "2d4b053e-12c3-5e45-ae4f-2a0387470acd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186560465} {:answer/id #uuid "4c0c3a79-3121-56ca-bf4b-72af6e8e9456" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186560532} {:answer/id #uuid "50727257-50da-5481-b2ee-3b34f40e4f3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{7}" :db/id #edb/ref 17592186560540} {:answer/id #uuid "8ec92375-06a3-5bc9-b262-125ff5792a17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186560660} {:answer/id #uuid "db68e230-d768-52c1-9c2e-fd83dd64a3eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186560794}] :answer-field/correct {:db/id #edb/ref 17592186560465} :answer-field/id #uuid "52ed6280-fb1c-5efd-92cf-f0fa0ff719a2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186560895} {:answer-field/choices [{:answer/id #uuid "20144083-961b-5054-ad1d-a5de281d1d18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨\\operatorname{sin}⁡(7x),\\operatorname{sin}⁡(7x)⟩}{⟨f(x),\\operatorname{cos}⁡(7x)⟩}" :db/id #edb/ref 17592186560435} {:answer/id #uuid "6f45090e-5cbf-5b0f-abce-8d3156c3f296" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(7x)⟩}{⟨\\operatorname{sin}⁡(7x),\\operatorname{sin}⁡(7x)⟩}" :db/id #edb/ref 17592186560600} {:answer/id #uuid "80d1c28b-e18c-5913-acde-187852b1e23b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨\\operatorname{cos}⁡(7x),\\operatorname{cos}⁡(7x)⟩}{⟨f(x),\\operatorname{cos}⁡(7x)⟩}" :db/id #edb/ref 17592186560638} {:answer/id #uuid "ac98a90c-ced6-5f67-a7f0-29cf297dabc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(7x)⟩}{⟨\\operatorname{cos}⁡(7x),\\operatorname{cos}⁡(7x)⟩}" :db/id #edb/ref 17592186560711} {:answer/id #uuid "beb7e7f4-faf0-5ad6-870f-155a809a5272" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(7x)⟩}{⟨\\operatorname{sin}⁡(7x),\\operatorname{sin}⁡(7x)⟩}" :db/id #edb/ref 17592186560742}] :answer-field/correct {:db/id #edb/ref 17592186560711} :answer-field/id #uuid "6e0193b9-6155-5584-9bd2-1442c921f71c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186560907}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cf16f70d-fe20-5e04-9e8c-d37751162e97" :question/math-academy-id "q-340637" :question/problem "Let $F(x)=3x-4$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [0,2\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${a}_{7}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[0,2\\pi ).$\n\n$$\n\\begin{aligned}{a}_{7} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [0,2\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that is piecewise continuous over $x\\in [0,2\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{cos}⁡(7x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(7x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{cos}⁡(7x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{cos}⁡(7x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(7x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(7x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{cos}⁡(7x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(7x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(7x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{a}_{7}⟨\\operatorname{cos}⁡(7x),\\operatorname{cos}⁡(7x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(7x),\\operatorname{cos}⁡(7x)⟩ & ={\\int }_{0}^{2\\pi }{cos}^{2}⁡(7x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}⁡(14x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x+\\frac{1}{28}\\operatorname{sin}⁡(14x)]}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}(2\\pi -0)-\\frac{1}{28}(\\operatorname{sin}⁡(28\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(7x)⟩ & ={a}_{7}⟨\\operatorname{cos}⁡(7x),\\operatorname{cos}⁡(7x)⟩ \\\\ {a}_{7} & =\\frac{⟨f(x),\\operatorname{cos}⁡(7x)⟩}{⟨\\operatorname{cos}⁡(7x),\\operatorname{cos}⁡(7x)⟩} \\\\ {a}_{7} & =\\frac{1}{\\pi }{\\int }_{0}^{2\\pi }f(x)\\operatorname{cos}⁡(7x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{0}^{2\\pi }(3x-4)\\operatorname{cos}⁡(7x)\\,\\text{d}x.\\end{aligned}\n$$"} :step/id #uuid "9aa4ea8f-14c6-5c72-8dd1-c9ce0d451eed" :step/next {:db/id #edb/ref 17592186561090}} {:db/id #edb/ref 17592186561090 :step/content {:db/id #edb/ref 17592186561056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a5b03d8-7fa4-5401-9f31-c0c170006fd6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186560454} {:answer/id #uuid "480c4aef-5346-56fa-b6d8-38a9e3d58c5d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186560522} {:answer/id #uuid "65fc6d60-ff84-513b-be77-831a85519a67" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II  only" :db/id #edb/ref 17592186560577} {:answer/id #uuid "9b81d004-13c7-55f1-aef5-1fbc7d19388a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186560681} {:answer/id #uuid "d99e13f9-a196-576c-9387-f6d7991d38e4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186560792}] :answer-field/correct {:db/id #edb/ref 17592186560792} :answer-field/id #uuid "8f775890-b185-5534-961a-edb8b2135025" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186560924}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e89138a9-d6b8-5061-b7fa-8f7c0010f6f0" :question/math-academy-id "q-341218" :question/problem "Let $F(x)=\\operatorname{cos}⁡(3x)$ for $x\\in R.$ Suppose $f(x)$ is the $\\frac{\\pi }{3}$-periodic extension of $F(x)$ from $x\\in [0,\\frac{\\pi }{3})$ to $x\\in R.$ Which of the following statements are true?\n\nI. $f(x+\\frac{\\pi }{3})=f(x)$ for all $x\\in R$\n\nII. $f(x)=F(x)$ for all $x\\in R$\n\nIII. $f(x+\\frac{\\pi }{6})=f(x)$ for all $x\\in R$" :question/worked-solution "Since $f$ is the $\\frac{\\pi }{3}$-periodic extension of $F,$ we have  \n\n- $f(x+\\frac{\\pi }{3})=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0\\frac{\\pi }{3}).$\n\nWith that in mind, we examine each statement in turn.\n\n- Statement I is true. This is exactly the definition of $\\pi /3$-periodicity:\n\n$$\nf(x+\\frac{\\pi }{3})=f(x)\n$$\n\nfor all $x\\in R.$\n\n- Statement II is false. For example, take $x=\\frac{\\pi }{3}.$ Then,\n\n$$\n\\begin{aligned}f(\\frac{\\pi }{3})=f(0+\\frac{\\pi }{3})=f(0)=F(0)=\\operatorname{cos}⁡(0)=1,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}F(\\frac{\\pi }{3})=\\operatorname{cos}⁡(3\\cdot \\frac{\\pi }{3})=\\operatorname{cos}⁡(\\pi )=-1.\\end{aligned}\n$$\n\nHence, $f(x)\\ne F(x)$ for $x=\\frac{\\pi }{3}.$\n\n- Statement III is false. For example, take $x=0.$ Then,\n\n$$\n\\begin{aligned}f(x+\\frac{\\pi }{6})=f(0+\\frac{\\pi }{6})=f(\\frac{\\pi }{6})=F(\\frac{\\pi }{6})=\\operatorname{cos}⁡(3\\cdot \\frac{\\pi }{6})=\\operatorname{cos}⁡(\\frac{\\pi }{2})=0,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}f(x)=f(0)=1.\\end{aligned}\n$$\n\nHence, $f(x+\\frac{\\pi }{6})\\ne f(x)$ for $x=0.$\n\nTherefore, the correct answer is \"I only\"."} :step/id #uuid "b9b5ba93-4bff-5cc8-b592-e21aafc5699c" :step/next {:db/id #edb/ref 17592186561077}} {:db/id #edb/ref 17592186561094 :step/content {:db/id #edb/ref 17592186167282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2236311d-1dcf-5814-8621-6ca58ac136e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186397400} {:answer/id #uuid "80766049-c81a-5e17-9add-d24c5e9a61f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\infty }{x}^{2}\\operatorname{sin}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186397401} {:answer/id #uuid "9c2a205e-e06c-5302-98bb-33dd8ef28f57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{sin}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186397402} {:answer/id #uuid "74af64a7-831f-50b9-989b-da92fb9efa80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{\\infty }{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186397403} {:answer/id #uuid "47abc435-93f1-5e56-be4e-2906875645c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186397404} {:answer/id #uuid "84fdd6c1-2fa1-53ec-9f4e-f2c79cf04198" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }{x}^{2}\\operatorname{sin}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186397405}] :answer-field/correct {:db/id #edb/ref 17592186397400} :answer-field/id #uuid "41c0a54b-4090-5079-ad72-a367200f1bb8" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186397399} {:answer-field/choices [{:answer/id #uuid "576de101-4a4e-5d10-93f1-4794297dd084" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186397407} {:answer/id #uuid "8be2ea60-7536-54c6-8c40-2b3ca7f53e09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186397408} {:answer/id #uuid "ebd3c9f2-b034-51ed-b959-1917ee861c61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186397409} {:answer/id #uuid "a0938cb1-fa06-51a3-9682-a27947461754" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186397410} {:answer/id #uuid "16682102-e4e9-5e8e-b234-f5f85ae7a7c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{5}" :db/id #edb/ref 17592186397411}] :answer-field/correct {:db/id #edb/ref 17592186397409} :answer-field/id #uuid "acd80bdd-4dbe-5452-b9e2-03bec982eb3d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186397406} {:answer-field/choices [{:answer/id #uuid "d6896852-8238-5500-8785-a40ba1143f26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨\\operatorname{sin}⁡(5x),\\operatorname{sin}⁡(5x)⟩}{⟨f(x),\\operatorname{cos}⁡(5x)⟩}" :db/id #edb/ref 17592186397413} {:answer/id #uuid "7f0541cc-7371-58fe-8dca-eb545f614b78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(5x)⟩}{⟨\\operatorname{sin}⁡(5x),\\operatorname{sin}⁡(5x)⟩}" :db/id #edb/ref 17592186397414} {:answer/id #uuid "610883b1-a3e9-5606-b9ae-cf0dd1218917" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩}{⟨f(x),\\operatorname{cos}⁡(5x)⟩}" :db/id #edb/ref 17592186397415} {:answer/id #uuid "2c3717c9-e1f6-51ef-9d7f-0c5c74af7ae5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(5x)⟩}{⟨\\operatorname{sin}⁡(5x),\\operatorname{sin}⁡(5x)⟩}" :db/id #edb/ref 17592186397416} {:answer/id #uuid "23137492-fa85-5ebf-bdf6-f3faffc43cb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(5x)⟩}{⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩}" :db/id #edb/ref 17592186397417}] :answer-field/correct {:db/id #edb/ref 17592186397417} :answer-field/id #uuid "d466e0c2-5e9a-5545-9677-019c4fb5c4a7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186397412}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "aa20d8e3-c4d9-5112-bd9c-ec30f6aaa6fe" :question/math-academy-id "q-340418" :question/problem "Let $F(x)={x}^{2}$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [-\\pi ,\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${a}_{5}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[-\\pi ,\\pi ).$\n\n$$\n\\begin{aligned}{a}_{5} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [-\\pi ,\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [-\\pi ,\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{cos}⁡(5x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(5x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{cos}⁡(5x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(5x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(5x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{a}_{5}⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩ & ={\\int }_{-\\pi }^{\\pi }{cos}^{2}⁡(5x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}⁡(10x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x+\\frac{1}{20}\\operatorname{sin}⁡(10x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))-\\frac{1}{20}(\\operatorname{sin}⁡(10\\pi )-(\\operatorname{sin}⁡(-10\\pi ))) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(5x)⟩ & ={a}_{5}⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩ \\\\ {a}_{5} & =\\frac{⟨f(x),\\operatorname{cos}⁡(5x)⟩}{⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩} \\\\ {a}_{5} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x.\\end{aligned}\n$$"} :step/id #uuid "cce0c6d6-2f7a-5100-bbb3-4f7a6f21298b" :step/next {:db/id #edb/ref 17592186561070}}] :activity/title "Introduction to Fourier Series" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186560354}]}
