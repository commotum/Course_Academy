#{[{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186541170} :activity/id #uuid "38a625c6-f7b0-5f5a-addc-350bd81abfd9" :activity/scope {:db/id #edb/ref 17592186050651 :topic/id #uuid "5c9ec6e6-7cee-52bf-8195-078ed0bf32d7" :topic/math-academy-id 3281} :activity/steps [{:db/id #edb/ref 17592186541170 :step/content {:db/id #edb/ref 17592186541130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19b8e472-101c-591c-9d12-ddb3ce4aa147" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.0162" :db/id #edb/ref 17592186540568} {:answer/id #uuid "c0d4bf7c-79c0-59b1-b5ae-2e2017a9fe0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.0288" :db/id #edb/ref 17592186540850} {:answer/id #uuid "c86d3881-a5ac-5ea3-a168-a316059c706b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.0250" :db/id #edb/ref 17592186540864} {:answer/id #uuid "d415334a-6ee5-5b82-8191-f8fe0c93eadf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.0012" :db/id #edb/ref 17592186540885} {:answer/id #uuid "fe2ead44-1830-50be-bb8c-88e95281dd7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.0038" :db/id #edb/ref 17592186540939}] :answer-field/correct {:db/id #edb/ref 17592186540939} :answer-field/id #uuid "7b2948cb-066b-5028-aa6d-bf771aec3f1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186540992}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ca88d8b7-77e6-50f5-9c7d-7baae6691eb5" :question/math-academy-id "q-97507" :question/problem "Given that $X∼B(7,0.3),$ compute $P(X>5).$ Round your final answer to $4$ decimal places." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.3),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.3)^{x}(0.7)^{7-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X>5) & =P(X\\in \\{6,7\\}) \\\\  & =f(6)+f(7) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{6})(0.3)^{6}(0.7)^{7-6}+(\\genfrac{}{}{0pt}{}{7}{7})(0.3)^{7}(0.7)^{7-7} \\\\  & =7(0.3)^{6}(0.7)+1(0.3)^{7}(0.7)^{0} \\\\  & ≈0.0038\\end{aligned}\n$$\n\nto $4$ decimal places."} :step/id #uuid "3453a0b7-17cb-5c5d-a3a2-4c5a26ff9daa" :step/next {:db/id #edb/ref 17592186541202}} {:db/id #edb/ref 17592186541171 :step/content {:db/id #edb/ref 17592186541120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f184934c-5ddc-5c09-89b2-c3b9969b08ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.658" :db/id #edb/ref 17592186540930}] :answer-field/correct {:db/id #edb/ref 17592186540930} :answer-field/id #uuid "7cb8eed7-dd98-5bd2-8807-1eee6e64325d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540994}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b40e7c83-4aaa-5842-b161-090408598820" :question/math-academy-id "q-279714" :question/problem "If $X∼B(5,\\frac{2}{3}),$  then, **rounded to $3$ decimal places**, $P(3\\le X<5)≈${{field-1}}." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(5,\\frac{2}{3}),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{5}{x}){(\\frac{2}{3})}^{x}{(\\frac{1}{3})}^{5-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(3\\le X<5) & =P(X\\in \\{3,4\\}) \\\\  & =f(3)+f(4) \\\\  & =(\\genfrac{}{}{0pt}{}{5}{3}){(\\frac{2}{3})}^{3}{(\\frac{1}{3})}^{5-3}+(\\genfrac{}{}{0pt}{}{5}{4}){(\\frac{2}{3})}^{4}{(\\frac{1}{3})}^{5-4} \\\\  & =10{(\\frac{2}{3})}^{3}{(\\frac{1}{3})}^{2}+5{(\\frac{2}{3})}^{4}{(\\frac{1}{3})}^{1} \\\\  & ≈0.658\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "354b6f11-1fbb-5f1b-bb7f-c47976a547b4" :step/next {:db/id #edb/ref 17592186541176}} {:db/id #edb/ref 17592186541176 :step/content {:db/id #edb/ref 17592186541131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8ccf4bd-8a18-5847-ae19-0487fd1e69b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.745" :db/id #edb/ref 17592186540810}] :answer-field/correct {:db/id #edb/ref 17592186540810} :answer-field/id #uuid "9ea07dac-1cdf-58ab-b138-fc3a110b4291" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186541010}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ca99c1c6-d952-5e5e-a558-22163d61daf7" :question/math-academy-id "q-281207" :question/problem "If $X∼B(8,0.7),$ then, **rounded to $3$ decimal places**, $P(X\\le 6)≈${{field-1}}." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(8,0.7),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{8}{x}){(0.7)}^{x}{(0.3)}^{8-x}.\n$$\n\nComputing $P(X\\le 6)$ will require us to compute $f(x)$ at $x=0,1,2,…,6.$ However, if we compute the complement $P(X>6)$ instead, then we will only have to compute $f(x)$ at $x=7,8,$ which will result in a much faster computation.\n\nComputing $P(X>6),$ we get\n\n$$\n\\begin{aligned}P(X>6) & =P(X\\in \\{7,8\\}) \\\\  & =f(7)+f(8) \\\\  & =(\\genfrac{}{}{0pt}{}{8}{7}){(0.7)}^{7}{(0.3)}^{8-7}+(\\genfrac{}{}{0pt}{}{8}{8}){(0.7)}^{8}{(0.3)}^{8-8} \\\\  & =8{(0.7)}^{7}{(0.3)}^{1}+1{(0.7)}^{8}{(0.3)}^{0} \\\\  & ≈0.255\\end{aligned}\n$$\n\nrounded to $3$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 6) & =1-P(X>6) \\\\  & ≈1-0.255 \\\\  & =0.745\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "3b09c256-75c6-53e9-926e-e65cea2f5b49"} {:db/id #edb/ref 17592186541201 :step/content {:db/id #edb/ref 17592186541068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6a673f2-7816-549f-8fd7-7cd5ba2d59b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.552" :db/id #edb/ref 17592186540932}] :answer-field/correct {:db/id #edb/ref 17592186540932} :answer-field/id #uuid "7828d1b0-d4b0-550f-8d0b-d08471d793d0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540990}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1fdbae63-27df-5bf8-9dcb-6eda19028b94" :question/math-academy-id "q-279711" :question/problem "If $X∼B(7,0.6),$ then, **rounded to $3$ decimal places**, $P(3<X<6)≈${{field-1}}." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.6),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x}){(0.6)}^{x}{(0.4)}^{7-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(3<X<6) & =P(X\\in \\{4,5\\}) \\\\  & =f(4)+f(5) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{4}){(0.6)}^{4}{(0.4)}^{7-4}+(\\genfrac{}{}{0pt}{}{7}{5}){(0.6)}^{5}{(0.4)}^{7-5} \\\\  & =35{(0.6)}^{4}{(0.4)}^{3}+21{(0.6)}^{5}{(0.4)}^{2} \\\\  & ≈0.552\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "8cc84ca7-2774-520f-b516-b58e03200241" :step/next {:db/id #edb/ref 17592186541171}} {:db/id #edb/ref 17592186541202 :step/content {:db/id #edb/ref 17592186541126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de636aa5-cf99-5e6d-9779-b79decf69364" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.337" :db/id #edb/ref 17592186540907}] :answer-field/correct {:db/id #edb/ref 17592186540907} :answer-field/id #uuid "66359473-563b-5acf-a793-afdba80eb7ff" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540984}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bf9b3381-1894-58e7-8430-4bb3204c16fe" :question/math-academy-id "q-279683" :question/problem "If $X∼B(5,\\frac{2}{5}),$ then, **rounded to $3$ decimal places**, $P(X\\le 1)≈${{field-1}}." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(5,\\frac{2}{5}),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{5}{x}){(\\frac{2}{5})}^{x}{(\\frac{3}{5})}^{5-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 1) & =P(X\\in \\{0,1\\}) \\\\  & =f(0)+f(1) \\\\  & =(\\genfrac{}{}{0pt}{}{5}{0}){(\\frac{2}{5})}^{0}{(\\frac{3}{5})}^{5-0}+(\\genfrac{}{}{0pt}{}{5}{1}){(\\frac{2}{5})}^{1}{(\\frac{3}{5})}^{5-1} \\\\  & =1{(\\frac{2}{5})}^{0}{(\\frac{3}{5})}^{5}+5{(\\frac{2}{5})}^{1}{(\\frac{3}{5})}^{4} \\\\  & =0.337\\end{aligned}\n$$\n\nrounded to $3$ decimal places."} :step/id #uuid "901ed45f-da06-5711-b6bd-263161f1523b" :step/next {:db/id #edb/ref 17592186541201}}] :activity/title "The Binomial Distribution" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186540515}]}
