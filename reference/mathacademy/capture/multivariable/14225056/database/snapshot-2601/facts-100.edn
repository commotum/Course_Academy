6045417] [17592186541068 #edb/ref 1071 "If $X∼B(7,0.6),$ then, **rounded to $3$ decimal places**, $P(3<X<6)≈${{field-1}}." #edb/ref 17592186045417] [17592186541068 #edb/ref 1072 #uuid "1fdbae63-27df-5bf8-9dcb-6eda19028b94" #edb/ref 17592186045417] [17592186541068 #edb/ref 1074 "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.6),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x}){(0.6)}^{x}{(0.4)}^{7-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(3<X<6) & =P(X\\in \\{4,5\\}) \\\\  & =f(4)+f(5) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{4}){(0.6)}^{4}{(0.4)}^{7-4}+(\\genfrac{}{}{0pt}{}{7}{5}){(0.6)}^{5}{(0.4)}^{7-5} \\\\  & =35{(0.6)}^{4}{(0.4)}^{3}+21{(0.6)}^{5}{(0.4)}^{2} \\\\  & ≈0.552\\end{aligned}\n$$\n\nrounded to $3$ decimal places." #edb/ref 17592186045417] [17592186541120 #edb/ref 1068 #edb/ref 17592186540994 #edb/ref 17592186045417] [17592186541120 #edb/ref 1069 "q-279714" #edb/ref 17592186045417] [17592186541120 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186541120 #edb/ref 1071 "If $X∼B(5,\\frac{2}{3}),$  then, **rounded to $3$ decimal places**, $P(3\\le X<5)≈${{field-1}}." #edb/ref 17592186045417] [17592186541120 #edb/ref 1072 #uuid "b40e7c83-4aaa-5842-b161-090408598820" #edb/ref 17592186045417] [17592186541120 #edb/ref 1074 "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(5,\\frac{2}{3}),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{5}{x}){(\\frac{2}{3})}^{x}{(\\frac{1}{3})}^{5-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(3\\le X<5) & =P(X\\in \\{3,4\\}) \\\\  & =f(3)+f(4) \\\\  & =(\\genfrac{}{}{0pt}{}{5}{3}){(\\frac{2}{3})}^{3}{(\\frac{1}{3})}^{5-3}+(\\genfrac{}{}{0pt}{}{5}{4}){(\\frac{2}{3})}^{4}{(\\frac{1}{3})}^{5-4} \\\\  & =10{(\\frac{2}{3})}^{3}{(\\frac{1}{3})}^{2}+5{(\\frac{2}{3})}^{4}{(\\frac{1}{3})}^{1} \\\\  & ≈0.658\\end{aligned}\n$$\n\nrounded to $3$ decimal places." #edb/ref 17592186045417] [17592186541126 #edb/ref 1068 #edb/ref 17592186540984 #edb/ref 17592186045417] [17592186541126 #edb/ref 1069 "q-279683" #edb/ref 17592186045417] [17592186541126 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186541126 #edb/ref 1071 "If $X∼B(5,\\frac{2}{5}),$ then, **rounded to $3$ decimal places**, $P(X\\le 1)≈${{field-1}}." #edb/ref 17592186045417] [17592186541126 #edb/ref 1072 #uuid "bf9b3381-1894-58e7-8430-4bb3204c16fe" #edb/ref 17592186045417] [17592186541126 #edb/ref 1074 "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(5,\\frac{2}{5}),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{5}{x}){(\\frac{2}{5})}^{x}{(\\frac{3}{5})}^{5-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 1) & =P(X\\in \\{0,1\\}) \\\\  & =f(0)+f(1) \\\\  & =(\\genfrac{}{}{0pt}{}{5}{0}){(\\frac{2}{5})}^{0}{(\\frac{3}{5})}^{5-0}+(\\genfrac{}{}{0pt}{}{5}{1}){(\\frac{2}{5})}^{1}{(\\frac{3}{5})}^{5-1} \\\\  & =1{(\\frac{2}{5})}^{0}{(\\frac{3}{5})}^{5}+5{(\\frac{2}{5})}^{1}{(\\frac{3}{5})}^{4} \\\\  & =0.337\\end{aligned}\n$$\n\nrounded to $3$ decimal places." #edb/ref 17592186045417] [17592186541130 #edb/ref 1068 #edb/ref 17592186540992 #edb/ref 17592186045417] [17592186541130 #edb/ref 1069 "q-97507" #edb/ref 17592186045417] [17592186541130 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186541130 #edb/ref 1071 "Given that $X∼B(7,0.3),$ compute $P(X>5).$ Round your final answer to $4$ decimal places." #edb/ref 17592186045417] [17592186541130 #edb/ref 1072 #uuid "ca88d8b7-77e6-50f5-9c7d-7baae6691eb5" #edb/ref 17592186045417] [17592186541130 #edb/ref 1074 "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.3),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.3)^{x}(0.7)^{7-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X>5) & =P(X\\in \\{6,7\\}) \\\\  & =f(6)+f(7) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{6})(0.3)^{6}(0.7)^{7-6}+(\\genfrac{}{}{0pt}{}{7}{7})(0.3)^{7}(0.7)^{7-7} \\\\  & =7(0.3)^{6}(0.7)+1(0.3)^{7}(0.7)^{0} \\\\  & ≈0.0038\\end{aligned}\n$$\n\nto $4$ decimal places." #edb/ref 17592186045417] [17592186541131 #edb/ref 1068 #edb/ref 17592186541010 #edb/ref 17592186045417] [17592186541131 #edb/ref 1069 "q-281207" #edb/ref 17592186045417] [17592186541131 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186541131 #edb/ref 1071 "If $X∼B(8,0.7),$ then, **rounded to $3$ decimal places**, $P(X\\le 6)≈${{field-1}}." #edb/ref 17592186045417] [17592186541131 #edb/ref 1072 #uuid "ca99c1c6-d952-5e5e-a558-22163d61daf7" #edb/ref 17592186045417] [17592186541131 #edb/ref 1074 "For a binomial random variable $X∼B(n,p),$ we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(8,0.7),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{8}{x}){(0.7)}^{x}{(0.3)}^{8-x}.\n$$\n\nComputing $P(X\\le 6)$ will require us to compute $f(x)$ at $x=0,1,2,…,6.$ However, if we compute the complement $P(X>6)$ instead, then we will only have to compute $f(x)$ at $x=7,8,$ which will result in a much faster computation.\n\nComputing $P(X>6),$ we get\n\n$$\n\\begin{aligned}P(X>6) & =P(X\\in \\{7,8\\}) \\\\  & =f(7)+f(8) \\\\  & =(\\genfrac{}{}{0pt}{}{8}{7}){(0.7)}^{7}{(0.3)}^{8-7}+(\\genfrac{}{}{0pt}{}{8}{8}){(0.7)}^{8}{(0.3)}^{8-8} \\\\  & =8{(0.7)}^{7}{(0.3)}^{1}+1{(0.7)}^{8}{(0.3)}^{0} \\\\  & ≈0.255\\end{aligned}\n$$\n\nrounded to $3$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 6) & =1-P(X>6) \\\\  & ≈1-0.255 \\\\  & =0.745\\end{aligned}\n$$\n\nrounded to $3$ decimal places." #edb/ref 17592186045417] [17592186541170 #edb/ref 1058 #edb/ref 17592186541202 #edb/ref 17592186045417] [17592186541170 #edb/ref 1062 #uuid "3453a0b7-17cb-5c5d-a3a2-4c5a26ff9daa" #edb/ref 17592186045417] [17592186541170 #edb/ref 1063 #edb/ref 17592186541130 #edb/ref 17592186045417] [17592186541171 #edb/ref 1058 #edb/ref 17592186541176 #edb/ref 17592186045417] [17592186541171 #edb/ref 1062 #uuid "354b6f11-1fbb-5f1b-bb7f-c47976a547b4" #edb/ref 17592186045417] [17592186541171 #edb/ref 1063 #edb/ref 17592186541120 #edb/ref 17592186045417] [17592186541176 #edb/ref 1062 #uuid "3b09c256-75c6-53e9-926e-e65cea2f5b49" #edb/ref 17592186045417] [17592186541176 #edb/ref 1063 #edb/ref 17592186541131 #edb/ref 17592186045417] [17592186541201 #edb/ref 1058 #edb/ref 17592186541171 #edb/ref 17592186045417] [17592186541201 #edb/ref 1062 #uuid "8cc84ca7-2774-520f-b516-b58e03200241" #edb/ref 17592186045417] [17592186541201 #edb/ref 1063 #edb/ref 17592186541068 #edb/ref 17592186045417] [17592186541202 #edb/ref 1058 #edb/ref 17592186541201 #edb/ref 17592186045417] [17592186541202 #edb/ref 1062 #uuid "901ed45f-da06-5711-b6bd-263161f1523b" #edb/ref 17592186045417] [17592186541202 #edb/ref 1063 #edb/ref 17592186541126 #edb/ref 17592186045417]}
