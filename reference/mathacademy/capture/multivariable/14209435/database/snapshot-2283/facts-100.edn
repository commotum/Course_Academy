ef 1083 #uuid "7bd533fa-b6df-5f0a-82f8-f039d177607d" #edb/ref 17592186045417] [17592186521120 #edb/ref 1080 "\\frac{5}{3}" #edb/ref 17592186045417] [17592186521120 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186521120 #edb/ref 1083 #uuid "9cfbf36d-43f4-55af-88f8-c9911c1d33e5" #edb/ref 17592186045417] [17592186521124 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186521124 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186521124 #edb/ref 1083 #uuid "a0a41433-b3e1-5c92-a9c4-ccd8e0742151" #edb/ref 17592186045417] [17592186521151 #edb/ref 1080 "\\frac{5}{3}" #edb/ref 17592186045417] [17592186521151 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186521151 #edb/ref 1083 #uuid "ad5c1fce-95e2-5a1d-b0c8-18244b6208ff" #edb/ref 17592186045417] [17592186521158 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186521158 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186521158 #edb/ref 1083 #uuid "b1bd0eaf-67d3-50f4-afcf-748a5d55eeac" #edb/ref 17592186045417] [17592186521326 #edb/ref 1080 "\\frac{11}{2}" #edb/ref 17592186045417] [17592186521326 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186521326 #edb/ref 1083 #uuid "ff83ce28-20eb-50da-bedd-918638dace6d" #edb/ref 17592186045417] [17592186521393 #edb/ref 1075 #edb/ref 17592186520872 #edb/ref 17592186045417] [17592186521393 #edb/ref 1075 #edb/ref 17592186520980 #edb/ref 17592186045417] [17592186521393 #edb/ref 1075 #edb/ref 17592186521120 #edb/ref 17592186045417] [17592186521393 #edb/ref 1075 #edb/ref 17592186521124 #edb/ref 17592186045417] [17592186521393 #edb/ref 1075 #edb/ref 17592186521326 #edb/ref 17592186045417] [17592186521393 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186521393 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186521393 #edb/ref 1078 #edb/ref 17592186520872 #edb/ref 17592186045417] [17592186521393 #edb/ref 1079 #uuid "8a20ef1d-6ee3-5383-abac-10a8cde3ea7a" #edb/ref 17592186045417] [17592186521420 #edb/ref 1075 #edb/ref 17592186520782 #edb/ref 17592186045417] [17592186521420 #edb/ref 1075 #edb/ref 17592186520880 #edb/ref 17592186045417] [17592186521420 #edb/ref 1075 #edb/ref 17592186521045 #edb/ref 17592186045417] [17592186521420 #edb/ref 1075 #edb/ref 17592186521151 #edb/ref 17592186045417] [17592186521420 #edb/ref 1075 #edb/ref 17592186521158 #edb/ref 17592186045417] [17592186521420 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186521420 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186521420 #edb/ref 1078 #edb/ref 17592186520782 #edb/ref 17592186045417] [17592186521420 #edb/ref 1079 #uuid "bb4d67ee-c5f9-5907-9389-cb8d07771ac8" #edb/ref 17592186045417] [17592186521466 #edb/ref 1068 #edb/ref 17592186521420 #edb/ref 17592186045417] [17592186521466 #edb/ref 1069 "q-161694" #edb/ref 17592186045417] [17592186521466 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186521466 #edb/ref 1071 "![](images/43/4315e0e20d37935d3f5454063475fdfa5ed7a1915f82ae96194e83880ba02e76.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the top one, are parallel to the corresponding coordinate planes.*" #edb/ref 17592186045417] [17592186521466 #edb/ref 1072 #uuid "1f0b5299-7a35-5c1a-9b72-d6af14bd952f" #edb/ref 17592186045417] [17592186521466 #edb/ref 1074 "![](images/0b/0ba756dacf72b89b06c3c214e1582a74fa803f567082f57538e7a78c84d4591f.png)\n\n \n\nNotice that our solid can be written as the type I region\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,y)\\in D,\\,\\,0\\le z\\le 2+x-y\\},\n$$\n\nwhere\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 1\\}\n$$\n\nis the projection of $R$ onto the $xy$-plane, shown below.\n\n![](images/65/65c61ad7dc2964cd0de9a6bbdf259fcf3388e25da4eaabf155d58ff0c05c8d55.png)\n\nHence, the type I representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 1,\\,\\,0\\le z\\le 2+x-y\\}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{0}^{2+x-y}dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}[z]_{z=0}^{z=2+x-y}\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}(2+x-y)-0\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}2+x-y\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{[(2+x)y-\\frac{{y}^{2}}{2}]}_{y=0}^{y=1}\\,dx \\\\  & ={\\int }_{0}^{2}2+x-\\frac{1}{2}\\,dx \\\\  & ={\\int }_{0}^{2}\\frac{3}{2}+x\\,dx \\\\  & ={[\\frac{3}{2}x+\\frac{1}{2}{x}^{2}]}_{x=0}^{x=2} \\\\  & =(3+2)-0 \\\\  & =5.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186521539 #edb/ref 1068 #edb/ref 17592186521393 #edb/ref 17592186045417] [17592186521539 #edb/ref 1069 "q-161660" #edb/ref 17592186045417] [17592186521539 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186521539 #edb/ref 1071 "Find the volume of the solid $R,$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,-1\\le x\\le 1,\\,0\\le z\\le 2-{x}^{2},\\,-1\\le y\\le x\\}.\n$$" #edb/ref 17592186045417] [17592186521539 #edb/ref 1072 #uuid "b01530fa-080b-571d-ad1e-cd03aad8ce73" #edb/ref 17592186045417] [17592186521539 #edb/ref 1074 "Notice that we have a three-dimensional type III region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2-{x}^{2}}{\\int }_{-1}^{x}\\,dy\\,dz\\,dx \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2-{x}^{2}}[y]_{y=-1}^{y=x}\\,dz\\,dx \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2-{x}^{2}}(x-(-1))\\,dz\\,dx \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2-{x}^{2}}x+1\\,dz\\,dx \\\\  & ={\\int }_{-1}^{1}(x+1){[z]}_{z=0}^{z=2-{x}^{2}}\\,dx \\\\  & ={\\int }_{-1}^{1}(x+1)(2-{x}^{2}-0)\\,dx \\\\  & ={\\int }_{-1}^{1}-{x}^{3}-{x}^{2}+2x+2\\,dx \\\\  & ={[-\\frac{1}{4}{x}^{4}-\\frac{1}{3}{x}^{3}+{x}^{2}+2x]}_{x=-1}^{x=1} \\\\  & =(-\\frac{1}{4}-\\frac{1}{3}+1+2)-(-\\frac{1}{4}+\\frac{1}{3}+1-2) \\\\  & =2(2-\\frac{1}{3}) \\\\  & =\\frac{10}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186521591 #edb/ref 1062 #uuid "3af25230-3314-5d99-92ec-e984f7db309b" #edb/ref 17592186045417] [17592186521591 #edb/ref 1063 #edb/ref 17592186281299 #edb/ref 17592186045417] [17592186521604 #edb/ref 1058 #edb/ref 17592186521609 #edb/ref 17592186045417] [17592186521604 #edb/ref 1062 #uuid "5faef48e-5cda-55d7-a57a-164d8871091d" #edb/ref 17592186045417] [17592186521604 #edb/ref 1063 #edb/ref 17592186281285 #edb/ref 17592186045417] [17592186521609 #edb/ref 1058 #edb/ref 17592186521625 #edb/ref 17592186045417] [17592186521609 #edb/ref 1062 #uuid "68eda359-115c-504f-bacc-ef7faead6b39" #edb/ref 17592186045417] [17592186521609 #edb/ref 1063 #edb/ref 17592186412201 #edb/ref 17592186045417] [17592186521625 #edb/ref 1058 #edb/ref 17592186521647 #edb/ref 17592186045417] [17592186521625 #edb/ref 1062 #uuid "9f523ef4-394e-50e4-9b0c-e0ef1659a991" #edb/ref 17592186045417] [17592186521625 #edb/ref 1063 #edb/ref 17592186521539 #edb/ref 17592186045417] [17592186521647 #edb/ref 1058 #edb/ref 17592186521591 #edb/ref 17592186045417] [17592186521647 #edb/ref 1062 #uuid "dd20223b-26e1-5350-99dc-f7563663a33f" #edb/ref 17592186045417] [17592186521647 #edb/ref 1063 #edb/ref 17592186521466 #edb/ref 17592186045417]}
