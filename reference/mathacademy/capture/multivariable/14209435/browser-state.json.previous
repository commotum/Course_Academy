      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14209435/observations/step-q161694-28cd7ad73a3f9e0b1b3b.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14209435/observations/step-q161694-28cd7ad73a3f9e0b1b3b.png",
