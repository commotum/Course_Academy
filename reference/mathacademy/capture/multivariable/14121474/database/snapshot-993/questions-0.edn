 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186388365} {:answer/id #uuid "1308802d-f4ee-5836-8241-c2b84b6f00c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{2} & 1 & 0 \\\\ -\\frac{1}{4} & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186388366} {:answer/id #uuid "d4c3d1d4-2fa5-5de1-9d28-0433b0304796" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186388367}] :answer-field/correct {:answer/id #uuid "2f767430-2d0c-5029-9e31-1ba719c24d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186388363} :answer-field/id #uuid "e13047b7-1988-5639-bfb8-176b84ec5b9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388362}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b3018840-35c3-52b0-95cf-15fabeb2cbe7" :question/math-academy-id "q-135387" :question/problem "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "Notice that we're given a Frobenius matrix:\n\n- all entries on the main diagonal are ones\n\n- the matrix has only one column (the $1$st column) where some entries below the main diagonal are not zeros\n\n- all the other entries outside the main diagonal are zeros\n\nTo find the inverse of a Frobenius matrix, we simply take the non-zero entries outside the main diagonal with opposite signs. \n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 