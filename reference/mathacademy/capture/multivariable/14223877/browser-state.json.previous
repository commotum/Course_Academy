      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14223877/observations/step-q161203-22971529a2b806982d4e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14223877/observations/step-q161203-22971529a2b806982d4e.png",
      "source_url": "https://mathacademy.com/tasks/14223877/topics/4162/review",
      "captured_at": 1792038152.253639,
      "math_academy_id": "q-161203",
      "topic_id": "4162",
      "sequence_position": null,
