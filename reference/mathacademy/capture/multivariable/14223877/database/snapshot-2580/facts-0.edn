b/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186537345 #edb/ref 1083 #uuid "38c6cf47-a825-5070-89ae-ba194b490421" #edb/ref 17592186045417] [17592186537407 #edb/ref 1080 "6" #edb/ref 17592186045417] [17592186537407 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186537407 #edb/ref 1083 #uuid "570a9294-3afd-5d27-ace4-dabede751046" #edb/ref 17592186045417] [17592186537462 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186537462 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186537462 #edb/ref 1083 #uuid "753675fc-41c9-57ed-b147-8dbaf347a205" #edb/ref 17592186045417] [17592186537544 #edb/ref 1080 "8" #edb/ref 17592186045417] [17592186537544 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186537544 #edb/ref 1083 #uuid "a6c9610c-4027-5e7b-a8f2-534eb909848c" #edb/ref 17592186045417] [17592186537813 #edb/ref 1075 #edb/ref 17592186537261 #edb/ref 17592186045417] [17592186537813 #edb/ref 1075 #edb/ref 17592186537345 #edb/ref 17592186045417] [17592186537813 #edb/ref 1075 #edb/ref 17592186537407 #edb/ref 17592186045417] [17592186537813 #edb/ref 1075 #edb/ref 17592186537462 #edb/ref 17592186045417] [17592186537813 #edb/ref 1075 #edb/ref 17592186537544 #edb/ref 17592186045417] [17592186537813 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186537813 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186537813 #edb/ref 1078 #edb/ref 17592186537544 #edb/ref 17592186045417] [17592186537813 #edb/ref 1079 #uuid "8118e8d0-ad36-5eed-a94c-c49d91624022" #edb/ref 17592186045417] [17592186537913 #edb/ref 1068 #edb/ref 17592186537813 #edb/ref 17592186045417] [17592186537913 #edb/ref 1069 "q-162562" #edb/ref 17592186045417] [17592186537913 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186537913 #edb/ref 1071 "![](images/cf/cf90197ac99a066db75154200de4cbee2494fef15deed6be7b7c4cd501ae8f26.png)\n\nConsider the vector field $F(x,y,z)=⟨4x{y}^{2}{z}^{3},\\,0,\\,0⟩$ and the surface $S$ defined by the bounding region of the rectangular solid shown above in the first octant. Calculate the flux of $F$ through $S.$" #edb/ref 17592186045417] [17592186537913 #edb/ref 1072 #uuid "50078542-09f5-53cd-a63a-27e043674d5d" #edb/ref 17592186045417] [17592186537913 #edb/ref 1074 "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that only the $x$-component of $F=⟨4x{y}^{2}{z}^{3},\\,0,\\,0⟩$ is non-zero. Since the lateral sides of $S$ are parallel to the $x$-axis, the flux of $F$ through $S$ will be non-zero only at the front and back sides. \n\n![](images/dc/dc37a067eb8070ecbdfea53c1ede3e221e1873a192b50fcbf07234f33c183787.png)\n\n  \n\nLet's consider the flux of $F$ through these two sides.\n\n- Let ${S}_{1}$ denote the front surface. On this surface, we have $x=3$ for $0\\le y\\le 2$ and $0\\le z\\le 1.$ The outward-pointing unit normal vector to ${S}_{1}$ is\n\n$$\n{n}_{1}=⟨1,\\,0,\\,0⟩.\n$$\n\nUsing the fact that $x=3$ on ${S}_{1},$ we have\n\n$$\n\\begin{aligned}F\\cdot {n}_{1} & =⟨4x{y}^{2}{z}^{3},\\,0,\\,0⟩\\cdot ⟨1,\\,0,\\,0⟩ \\\\  & =⟨12{y}^{2}{z}^{3},\\,0,\\,0⟩\\cdot ⟨1,\\,0,\\,0⟩ \\\\  & =12{y}^{2}{z}^{3}.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across ${S}_{1}$ as follows:\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot {n}_{1}\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}12{y}^{2}{z}^{3}\\,\\text{d}S \\\\  & ={∬}_{D}12{y}^{2}{z}^{3}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}12{y}^{2}{z}^{3}\\,\\text{d}y\\,\\text{d}z \\\\  & ={\\int }_{0}^{1}{[4{y}^{3}{z}^{3}]}_{y=0}^{y=2}\\,\\text{d}z \\\\  & ={\\int }_{0}^{1}32{z}^{3}\\,\\text{d}z \\\\  & ={[8{z}^{4}]}_{0}^{1} \\\\  & =8\\end{aligned}\n$$\n\n- Let ${S}_{2}$ denote the back surface. On this surface, we have $x=0$ for $0\\le y\\le 2$ and $0\\le z\\le 1.$ The outward-pointing unit normal vector to ${S}_{2}$ is\n\n$$\n{n}_{2}=⟨-1,\\,0,\\,0⟩.\n$$\n\nUsing the fact that $x=0$ on ${S}_{2},$ we have\n\n$$\n\\begin{aligned}F\\cdot {n}_{2} & =⟨4x{y}^{2}{z}^{3},\\,0,\\,0⟩\\cdot ⟨-1,\\,0,\\,0⟩ \\\\  & =⟨0,\\,0,\\,0⟩\\cdot ⟨-1,\\,0,\\,0⟩ \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across ${S}_{2}$ as follows:\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot \\text{d}S & ={∬}_{{S}_{2}}F\\cdot {n}_{2}\\,\\text{d}S \\\\  & ={∬}_{{S}_{2}}0\\,\\text{d}S \\\\  & =0\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}F\\cdot n\\,\\text{d}S+{∬}_{{S}_{2}}F\\cdot n\\,\\text{d}S \\\\  & =8+0 \\\\  & =8.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186538008 #edb/ref 1058 #edb/ref 17592186538033 #edb/ref 17592186045417] [17592186538008 #edb/ref 1062 #uuid "39301e03-b48e-51b6-bb45-a99701503350" #edb/ref 17592186045417] [17592186538008 #edb/ref 1063 #edb/ref 17592186278436 #edb/ref 17592186045417]}
