5\\end{bmatrix},\\,\\{\\begin{aligned}2{x}_{1}-4{x}_{3}=0 \\\\ 6{x}_{1}-12{x}_{3}=0\\end{aligned}\n$$" :question/worked-solution "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 0 & -4 & 0 \\\\ 6 & 0 & -12 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 0 & -4 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get ${x}_{1}=2{x}_{3}.$ Therefore, the general solution is\n\n$$\n\\begin{bmatrix}2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}={x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B=\\{\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}2 \\\\ 0 \\\\ 1\\end{bmatrix}\\}$ is the basis of the solution space of the system.\n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =\\begin{bmatrix}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot {(\\begin{bmatrix}0 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}0 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}1 & 0 \\\\ 0 & 5\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}1 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\frac{1}{5}\\begin{bmatrix}5 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 1 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "0ff5b0db-5d7b-5e8e-bdd4-c67fdc4c3836" :step/next {:db/id #edb/ref 17592186510543}} {:db/id #edb/ref 17592186510494 :step/content {:db/id #edb/ref 17592186184775 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bd04cf3-0f82-5880-915b-421baec1c8d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 14\\end{bmatrix}" :db/id #edb/ref 17592186392328} {:answer/id #uuid "94ec87bc-b4dc-5e19-982e-5e16668b0ee9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}3 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186392329} {:answer/id #uuid "037e8461-8d16-565d-8e50-1138bb404110" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}8 \\\\ -6 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186392330} {:answer/id #uuid "92804d85-7803-58d2-a103-6f4edc35f482" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-2 \\\\ 6 \\\\ 10\\end{bmatrix}" :db/id #edb/ref 17592186392331} {:answer/id #uuid "205d1fda-454a-5e6f-a815-1ed3e0770ad7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186392332}] :answer-field/correct {:db/id #edb/ref 17592186392331} :answer-field/id #uuid "cc4a8c9e-ca92-5f00-a377-01527563ace3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186392327}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "27e616d4-1e96-59b7-b91d-2a687a44a3ac" :question/math-academy-id "q-39858" :question/problem "Given the vector $x$ and the system of linear equations below, find the projection of $x$ onto the solution space of the system.\n\n$$\nx=\\begin{bmatrix}0 \\\\ 0 \\\\ 14\\end{bmatrix},\\,\\{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3}=0 \\\\ 3{x}_{1}-9{x}_{2}+6{x}_{3}=0\\end{aligned}\n$$" :question/worked-solution "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -3 & 2 & 0 \\\\ 3 & -9 & 6 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, ${x}_{2},\\,{x}_{3}$ are free variables. Now, from the first equation, we get ${x}_{1}=3{x}_{2}-2{x}_{3}.$ Therefore, the general solution is\n\n$$\n\\begin{bmatrix}3{x}_{2}-2{x}_{3} \\\\ {x}_{2} \\\\ {x}_{3}\\end{bmatrix}={x}_{2}\\begin{bmatrix}3 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-2 \\\\ 0 \\\\ 1\\end{bmatrix},\\,{x}_{2},\\,{x}_{3}\\in R.\n$$\n\nConsequently, $B=\\{\\begin{bmatrix}3 \\\\ 1 \\\\ 0\\end{bmatrix},\\begin{bmatrix}-2 \\\\ 0 \\\\ 1\\end{bmatrix}\\}$ is the basis of the solution space of the system.\n\nNow, we find the orthogonal projection of $x$ onto the solution space of the system:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =\\begin{bmatrix}3 & -2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot {(\\begin{bmatrix}3 & 1 & 0 \\\\ -2 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}3 & -2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}3 & 1 & 0 \\\\ -2 & 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 0 \\\\ 14\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot {\\begin{bmatrix}10 & -6 \\\\ -6 & 5\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}0 \\\\ 14\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\frac{1}{14}\\begin{bmatrix}5 & 6 \\\\ 6 & 10\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 14\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -2 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}6 \\\\ 10\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 \\\\ 6 \\\\ 10\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "38075f58-71f8-537f-a636-74114ad736aa" :step/next {:db/id #edb/ref 17592186510481}} {:db/id #edb/ref 17592186510503 :step/content {:db/id #edb/ref 17592186269229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b1719c2-cbaf-5a8a-8ad8-6d7f32d5f2cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186266244} {:answer/id #uuid "99fb8f73-5ddb-5794-8d92-72d920d52b65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{12}" :db/id #edb/ref 17592186267537} {:answer/id #uuid "d47ccd6e-8624-5b7c-9993-a19ea7edac40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186268040} {:answer/id #uuid "e7478d11-b7f3-5a15-be65-b95013b60046" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186268194} {:answer/id #uuid "f487078a-66cc-52f3-bdfd-0b205ae902e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186268315}] :answer-field/correct {:db/id #edb/ref 17592186268194} :answer-field/id #uuid "cd83e725-b731-57f9-a6b5-a6f89fe153b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268776}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "12bd1922-22fd-5b46-aa73-11894915ba39" :question/math-academy-id "q-139478" :question/problem "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors $\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-3 \\\\ 3 \\\\ 3\\end{bmatrix},\\,x=\\begin{bmatrix}-6 \\\\ -3 \\\\ 3\\end{bmatrix}.\n$$" :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}-1 & -3 \\\\ 1 & 3 \\\\ 0 & 3\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}-1 & 1 & 0 \\\\ -3 & 3 & 3\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}-1 & -3 \\\\ 1 & 3 \\\\ 0 & 3\\end{bmatrix}\\cdot {(\\begin{bmatrix}-1 & 1 & 0 \\\\ -3 & 3 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}-1 & -3 \\\\ 1 & 3 \\\\ 0 & 3\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}-1 & 1 & 0 \\\\ -3 & 3 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}-6 \\\\ -3 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -3 \\\\ 1 & 3 \\\\ 0 & 3\\end{bmatrix}\\cdot {\\begin{bmatrix}2 & 6 \\\\ 6 & 27\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}3 \\\\ 18\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -3 \\\\ 1 & 3 \\\\ 0 & 3\\end{bmatrix}\\cdot \\frac{1}{18}\\begin{bmatrix}27 & -6 \\\\ -6 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}3 \\\\ 18\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & -3 \\\\ 1 & 3 \\\\ 0 & 3\\end{bmatrix}\\cdot \\frac{1}{2}\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}-3 \\\\ 3 \\\\ 6\\end{bmatrix}\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$ Equivalently, it is the acute angle between $x$ and any non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=\\begin{bmatrix}-6 \\\\ -3 \\\\ 3\\end{bmatrix}\\,$ and $\\,2\\,{\\text{proj}}_{S}x=\\begin{bmatrix}-3 \\\\ 3 \\\\ 6\\end{bmatrix}.$\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{(-6)\\cdot (-3)+(-3)\\cdot 3+3\\cdot 6}{\\sqrt{(-6)^{2}+(-3)^{2}+{3}^{2}}\\sqrt{(-3)^{2}+{3}^{2}+{6}^{2}}} \\\\  & =\\frac{27}{\\sqrt{54}\\sqrt{54}} \\\\  & =\\frac{27}{54} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{2})=\\frac{\\pi }{3},\n$$\n\nwhich is already an acute angle."} :step/id #uuid "53827aee-f999-5489-834a-f271697f1869"} {:db/id #edb/ref 17592186510524 :step/content {:db/id #edb/ref 17592186269228 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06ab9f5c-f9b0-5dd6-918a-bb731247e079" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186266201} {:answer/id #uuid "0a2f65bb-4526-584f-856f-27215c1529ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186266236} {:answer/id #uuid "21b515ce-8113-511c-85a0-cd526375bb7b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186266446} {:answer/id #uuid "39bf3cee-b002-50a4-ac7c-283a66da8f06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186266653} {:answer/id #uuid "90a4c538-7615-5efa-b16c-ec8c0f84764b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186267432}] :answer-field/correct {:db/id #edb/ref 17592186267432} :answer-field/id #uuid "d1bfa4e5-ee67-5872-a778-8cac048ea831" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268784}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1a3f9a9b-9c5c-5941-8f74-a42675358e73" :question/math-academy-id "q-139477" :question/problem "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors $\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}-2 \\\\ 2 \\\\ -1\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ 1 \\\\ -1\\end{bmatrix},\\,x=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}.\n$$" :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}-2 & -1 \\\\ 2 & 1 \\\\ -1 & -1\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}-2 & 2 & -1 \\\\ -1 & 1 & -1\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}-2 & -1 \\\\ 2 & 1 \\\\ -1 & -1\\end{bmatrix}\\cdot {(\\begin{bmatrix}-2 & 2 & -1 \\\\ -1 & 1 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}-2 & -1 \\\\ 2 & 1 \\\\ -1 & -1\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}-2 & 2 & -1 \\\\ -1 & 1 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -1 \\\\ 2 & 1 \\\\ -1 & -1\\end{bmatrix}\\cdot {\\begin{bmatrix}9 & 5 \\\\ 5 & 3\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}2 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -1 \\\\ 2 & 1 \\\\ -1 & -1\\end{bmatrix}\\cdot \\frac{1}{2}\\begin{bmatrix}3 & -5 \\\\ -5 & 9\\end{bmatrix}\\cdot \\begin{bmatrix}2 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -1 \\\\ 2 & 1 \\\\ -1 & -1\\end{bmatrix}\\cdot \\frac{1}{2}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$ Equivalently, it is the acute angle between $x$ and any non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}\\,$ and $\\,2\\,{\\text{proj}}_{S}x=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix}.$\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{0\\cdot (-1)+1\\cdot 1+0\\cdot 0}{\\sqrt{{0}^{2}+{1}^{2}+{0}^{2}}\\sqrt{(-1)^{2}+{1}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{1}\\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2})=\\frac{\\pi }{4},\n$$\n\nwhich is already an acute angle."} :step/id #uuid "94ff83ed-a8b2-5bdd-a995-b5717e30db92" :step/next {:db/id #edb/ref 17592186510503}} {:db/id #edb/ref 17592186510543 :step/content {:db/id #edb/ref 17592186269227 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "206f844b-a9aa-543a-b13a-3a4acc9da6a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186266430} {:answer/id #uuid "9605b247-8a44-51d4-bd86-9cbc5c513452" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186267482} {:answer/id #uuid "9d07c8ea-8eb0-51e5-9466-d659439c9524" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186267555} {:answer/id #uuid "9e8a4161-e6e2-529a-abea-93d855445919" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186267572} {:answer/id #uuid "fe6d2f84-0611-5fed-a6aa-de2e286504b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186268384}] :answer-field/correct {:db/id #edb/ref 17592186267572} :answer-field/id #uuid "9e74f88c-8d6d-562e-9858-e61dad89652f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268686}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0761cfb5-82f2-5ff1-afcd-0792aa3de132" :question/math-academy-id "q-139475" :question/problem "Find the acute angle between the vector $x$ and the subspace spanned by the linearly independent vectors $\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=\\begin{bmatrix}0 \\\\ 1 \\\\ 2\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix},\\,x=\\begin{bmatrix}-1 \\\\ -1 \\\\ 2\\end{bmatrix}.\n$$" :question/worked-solution "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have\n\n$$\nA=\\begin{bmatrix}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}0 & 1 \\\\ 1 & 2 \\\\ 2 & 3\\end{bmatrix}\\,⟹\\,{A}^{T}=\\begin{bmatrix}0 & 1 & 2 \\\\ 1 & 2 & 3\\end{bmatrix}.\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =\\begin{bmatrix}0 & 1 \\\\ 1 & 2 \\\\ 2 & 3\\end{bmatrix}\\cdot {(\\begin{bmatrix}0 & 1 & 2 \\\\ 1 & 2 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 1 \\\\ 1 & 2 \\\\ 2 & 3\\end{bmatrix})}^{-1}\\cdot \\begin{bmatrix}0 & 1 & 2 \\\\ 1 & 2 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}-1 \\\\ -1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ 1 & 2 \\\\ 2 & 3\\end{bmatrix}\\cdot {\\begin{bmatrix}5 & 8 \\\\ 8 & 14\\end{bmatrix}}^{-1}\\cdot \\begin{bmatrix}3 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ 1 & 2 \\\\ 2 & 3\\end{bmatrix}\\cdot \\frac{1}{6}\\begin{bmatrix}14 & -8 \\\\ -8 & 5\\end{bmatrix}\\cdot \\begin{bmatrix}3 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ 1 & 2 \\\\ 2 & 3\\end{bmatrix}\\cdot \\frac{1}{2}\\begin{bmatrix}6 \\\\ -3\\end{bmatrix} \\\\  & =\\frac{1}{2}\\begin{bmatrix}-3 \\\\ 0 \\\\ 3\\end{bmatrix}\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x.$ Equivalently, it is the acute angle between $x$ and any non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=\\begin{bmatrix}-1 \\\\ -1 \\\\ 2\\end{bmatrix}\\,$ and $\\,2\\,{\\text{proj}}_{S}x=\\begin{bmatrix}-3 \\\\ 0 \\\\ 3\\end{bmatrix}.$\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{(-1)\\cdot (-3)+(-1)\\cdot 0+2\\cdot 3}{\\sqrt{(-1)^{2}+(-1)^{2}+{2}^{2}}\\sqrt{(-3)^{2}+{0}^{2}+{3}^{2}}} \\\\  & =\\frac{9}{\\sqrt{6}\\sqrt{18}} \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{3}}{2})=\\frac{\\pi }{6},\n$$\n\nwhich is already an acute angle."} :step/id #uuid "cbaee31f-d677-590e-beae-05fbdab5d8ac" :step/next {:db/id #edb/ref 17592186510524}}] :activity/title "Projecting Vectors Onto Subspaces in Euclidean Spaces (Arbitrary Bases): Applications" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186509693}]}
