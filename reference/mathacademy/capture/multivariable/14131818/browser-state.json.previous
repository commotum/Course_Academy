      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131818/observations/step-q126761-b4aa34a5730ad98d0f4c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131818/observations/step-q126761-b4aa34a5730ad98d0f4c.png",
