      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131818/observations/step-q126727-e002ab9df2e2af71733e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131818/observations/step-q126727-e002ab9df2e2af71733e.png",
      "source_url": "https://mathacademy.com/tasks/14131818/topics/2198/lesson",
      "captured_at": 1791784830.303578,
      "math_academy_id": "q-126727",
