#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186176693} :activity/id #uuid "5b617917-9881-594e-8972-61a82f2871a8" :activity/scope {:db/id #edb/ref 17592186050292 :topic/id #uuid "3d6fbb46-90f2-569b-9b15-468d83e83de3" :topic/math-academy-id 3573} :activity/steps [{:db/id #edb/ref 17592186176676 :step/content {:db/id #edb/ref 17592186175950 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175806 :question/id #uuid "8ffa8b1d-6651-594f-9c86-b4629d4cc2e4" :question/math-academy-id "e-759"} :knowledge-point/id #uuid "a1e462d1-0add-520b-afbf-4c9b07970db4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048969}] :knowledge-point/questions [{:db/id #edb/ref 17592186176508} {:db/id #edb/ref 17592186176510} {:db/id #edb/ref 17592186538939} {:db/id #edb/ref 17592186538986} {:db/id #edb/ref 17592186539007}] :knowledge-point/title "Recognizing Series That Are Similar to the Maclaurin Expansion for Sine"} :step/id #uuid "02032486-ef93-5b31-a042-ff9aedc94caf" :step/math-academy-id 649412 :step/next {:db/id #edb/ref 17592186176677}} {:db/id #edb/ref 17592186176677 :step/content {:db/id #edb/ref 17592186175951 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175807 :question/id #uuid "8b102c11-e930-5b11-805a-1ff11cdb5995" :question/math-academy-id "e-760"} :knowledge-point/id #uuid "ac85697c-557a-5b74-8046-79e9c345afc1" :knowledge-point/questions [{:db/id #edb/ref 17592186176509} {:db/id #edb/ref 17592186176511} {:db/id #edb/ref 17592186538945} {:db/id #edb/ref 17592186538946} {:db/id #edb/ref 17592186538972} {:db/id #edb/ref 17592186538998} {:db/id #edb/ref 17592186539002}] :knowledge-point/title "Recognizing Series That Are Similar to the Maclaurin Expansion for Cosine"} :step/id #uuid "ded33c8c-6f4b-5349-ade4-f49fb9e69602" :step/math-academy-id 649415} {:db/id #edb/ref 17592186176693 :step/content {:db/id #edb/ref 17592186176979 :tutorial/content "We need to recognize when a particular series looks like a standard Maclaurin series. A list of some common Maclaurin series is given below.\n\n$$\n\\begin{aligned} & \\frac{1}{1-x}=1+x+{x}^{2}+⋯+{x}^{n}+⋯={\\sum }_{n=0}^{\\infty }{x}^{n}, &  & x\\in (-1,1) \\\\  & \\frac{1}{1+x}=1-x+{x}^{2}-⋯+(-1)^{n}{x}^{n}+⋯={\\sum }_{n=0}^{\\infty }(-1)^{n}{x}^{n}, &  & x\\in (-1,1) \\\\  & {e}^{x}=1+x+\\frac{1}{2!}{x}^{2}+⋯+\\frac{{x}^{n}}{n!}+⋯={\\sum }_{n=0}^{\\infty }\\frac{{x}^{n}}{n!}, &  & x\\in (-\\infty ,\\infty ) \\\\  & \\operatorname{ln}⁡(1+x)=x-\\frac{1}{2}{x}^{2}+\\frac{1}{3}{x}^{3}-⋯+\\frac{(-1)^{n+1}{x}^{n}}{n}+⋯={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}{x}^{n}}{n}, &  & x\\in (-1,1] \\\\  & \\operatorname{sin}⁡(x)=x-\\frac{1}{3!}{x}^{3}+\\frac{1}{5!}{x}^{5}+⋯+\\frac{(-1)^{n}{x}^{2n+1}}{(2n+1)!}+⋯={\\sum }_{n=0}^{\\infty }\\frac{(-1)^{n}{x}^{2n+1}}{(2n+1)!}, &  & x\\in (-\\infty ,\\infty ) \\\\  & \\operatorname{cos}⁡(x)=1-\\frac{1}{2!}{x}^{2}+\\frac{1}{4!}{x}^{4}-⋯+\\frac{(-1)^{n}{x}^{2n}}{(2n)!}+⋯={\\sum }_{n=0}^{\\infty }\\frac{(-1)^{n}{x}^{2n}}{(2n)!}, &  & x\\in (-\\infty ,\\infty )\\end{aligned}\n$$\n\nIn this lesson, we will focus on recognizing the standard Maclaurin series for the sine and cosine functions.\n\n**Note:** To remember the series for $\\sin x$ and $\\cos x$ easily, notice that they are both alternating series that contain every other term of the expansion for $e^x.$ Sine has the odd-degree terms (since it is an odd function), and cosine has the even-degree terms (since it is an even function)." :tutorial/id #uuid "d665f747-9ba7-5bcf-bb89-b9f7cf00815f" :tutorial/math-academy-id 5193 :tutorial/title "Introduction"} :step/id #uuid "ed13fe45-d03c-55c5-912d-7530fab1d9cd" :step/math-academy-id 649411 :step/next {:db/id #edb/ref 17592186176676}}] :activity/title "Recognizing Standard Maclaurin Series for Trigonometric Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176122}]}
