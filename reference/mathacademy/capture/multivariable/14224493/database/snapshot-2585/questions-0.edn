#{[{:db/id #edb/ref 17592186175806 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186175950 :knowledge-point/id #uuid "a1e462d1-0add-520b-afbf-4c9b07970db4" :knowledge-point/title "Recognizing Series That Are Similar to the Maclaurin Expansion for Sine"}] :question/id #uuid "8ffa8b1d-6651-594f-9c86-b4629d4cc2e4" :question/math-academy-id "e-759" :question/problem "What is the sum of the series $\\dfrac{\\pi}{3} - \\dfrac{(\\pi/3)^3}{3!} + \\dfrac{(\\pi/3)^5}{5!}-\\cdots + \\dfrac{(-1)^{n}(\\pi/3)^{2n+1}}{(2n+1)!}+\\cdots\\,$?" :question/worked-solution "We recognize that the series looks similar to the Maclaurin expansion for\n\n$$\nf(x) = \\sin x\n$$\n\n$$\n\\begin{aligned}\n\\sin x &= x - \\frac{x^{3}}{3!} + \\frac{x^{5}}{5!} - ⋯ + ((-1)^{n}x^{2n + 1})/((2n + 1)!) + ⋯\n\\end{aligned}\n$$\n\nSubstituting\n\n$$\nx=\\dfrac{\\pi}{3}\n$$\n\ninto our Maclaurin expansion gives\n\n$$\n\\begin{aligned}\n\\sin (\\frac{π}{3}) &= \\frac{π}{3} - ((π/3)^{3})/(3!) + ((π/3)^{5})/(5!) - ⋯ + ((-1)^{n}(π/3)^{2n + 1})/((2n + 1)!) + ⋯ \\\\\n\\frac{\\sqrt{3}}{2} &= \\frac{π}{3} - ((π/3)^{3})/(3!) + ((π/3)^{5})/(5!) - ⋯ + ((-1)^{n}(π/3)^{2n + 1})/((2n + 1)!) + ⋯\n\\end{aligned}\n$$\n\nTherefore, the sum of the series is\n\n$$\n\\dfrac{\\sqrt{3}}{2}\n$$"}] [{:db/id #edb/ref 17592186175807 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186175951 :knowledge-point/id #uuid "ac85697c-557a-5b74-8046-79e9c345afc1" :knowledge-point/title "Recognizing Series That Are Similar to the Maclaurin Expansion for Cosine"}] :question/id #uuid "8b102c11-e930-5b11-805a-1ff11cdb5995" :question/math-academy-id "e-760" :question/problem "Find the sum $1 - \\dfrac{9}{2!} + \\dfrac{81}{4!}-\\cdots + \\dfrac{(-1)^{n}3^{2n}}{(2n)!} \\,\\cdots \\,$." :question/worked-solution "We recognize that the series looks similar to the Maclaurin expansion for\n\n$$\nf(x) = \\cos x\n$$\n\n$$\n\\cos x = 1 - \\frac{1}{2!}x^{2} + \\frac{1}{4!}x^{4} - ⋯ + ((-1)^{n}x^{2n})/((2n)!) + ⋯\n$$\n\nSubstituting $x=3$ into our Maclaurin expansion gives\n\n$$\n\\begin{aligned}\n\\cos (3) &= 1 - \\frac{3^{2}}{2!} + \\frac{3^{4}}{4!} - ⋯ + ((-1)^{n}3^{2n})/((2n)!)⋯ \\\\\n\\cos (3) &= 1 - \\frac{9}{2!} + \\frac{81}{4!} - ⋯ + ((-1)^{n}3^{2n})/((2n)!)⋯\n\\end{aligned}\n$$\n\nTherefore, the sum of the series is $\\cos(3)$."}] [{:db/id #edb/ref 17592186176508 :knowledge-point/_questions [{:db/id #edb/ref 17592186175950 :knowledge-point/id #uuid "a1e462d1-0add-520b-afbf-4c9b07970db4" :knowledge-point/title "Recognizing Series That Are Similar to the Maclaurin Expansion for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9792a891-b2a8-5575-a93c-24bc7194cecc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The series is divergent" :db/id #edb/ref 17592186175187} {:answer/id #uuid "9959d047-625e-5b79-b44c-1d6fbe37dc55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sin 2" :db/id #edb/ref 17592186175188} {:answer/id #uuid "d182ce5f-b8b1-5ee6-8c95-687babfe6ac0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln 2" :db/id #edb/ref 17592186175189} {:answer/id #uuid "fc745be2-92c7-52a4-8ad3-491f01df1355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sin 2" :db/id #edb/ref 17592186175190} {:answer/id #uuid "0bce1fbe-47f6-5c47-9ba0-df4ac06ddac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186175191}] :answer-field/id #uuid "466627f8-aa23-5e1f-9d19-07970f3fffb2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175186}] :question/id #uuid "b610a1ae-13a4-52d6-8097-cd81c48ac52e" :question/math-academy-id "q-50897" :question/problem "What is the sum of the series $-2 + \\frac{8}{3!} - \\frac{32}{5!} + ⋯ + ((-1)^{n}(-2)^{2n + 1})/((