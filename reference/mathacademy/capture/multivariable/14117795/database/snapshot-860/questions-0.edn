uid "3a997686-3fba-5981-8175-9ea904bd90cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{2π}\\cos t + \\sin t + tdt" :db/id #edb/ref 17592186178604} {:answer/id #uuid "5512bee2-d86f-5916-803c-9be2337c350a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{2π}\\cos 2t + t^{2}dt" :db/id #edb/ref 17592186178605}] :answer-field/id #uuid "d23a2530-5afd-527f-b0b6-badb1a445508" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178600}] :question/id #uuid "74ba859e-96c2-518a-a67a-a55e65c7d804" :question/math-academy-id "q-39681" :question/problem "Which of the following is equivalent to $\\displaystyle \\int_(C)ydx + xdy + z^{2}dz$, where $C$ is a portion of the helix $r(t) = \\cos ti + \\sin tj + tk$ for $t ∈ [0, 2π]$?"}] [{:db/id #edb/ref 17592186180295 :knowledge-point/_questions [{:db/id #edb/ref 17592186179734 :knowledge-point/id #uuid "2daf57e1-a02d-5e5f-b4a4-bb8ae9638a75" :knowledge-point/title "Evaluating a Line Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5f2e2b1-0438-5909-87f2-78171cf97a3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2π(1 + π)" :db/id #edb/ref 17592186179315} {:answer/id #uuid "bb783085-d0d3-5913-8444-e9dd3c91a3df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1 + π" :db/id #edb/ref 17592186179316} {:answer/id #uuid "c81abad7-b2a5-5efc-bd1f-ad6127d5892f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1 - π" :db/id #edb/ref 17592186179317} {:answer/id #uuid "06d782cb-1061-5633-b909-ee01fcd9fd77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "π(2 + π)" :db/id #edb/ref 17592186179318} {:answer/id #uuid "4dca3e04-2d5e-5600-b3e