 #edb/ref 17592186051070 #edb/ref 17592186045417] [17592186049346 #edb/ref 1028 #edb/ref 17592186179669 #edb/ref 17592186045417] [17592186049346 #edb/ref 1028 #edb/ref 17592186179672 #edb/ref 17592186045417] [17592186049346 #edb/ref 1028 #edb/ref 17592186179738 #edb/ref 17592186045417] [17592186049346 #edb/ref 1031 "Properties of Line Integrals of Vector-Valued Functions" #edb/ref 17592186045417] [17592186049346 #edb/ref 1033 3704 #edb/ref 17592186045417] [17592186049346 #edb/ref 1035 #uuid "ed9d339c-fde4-545b-86b4-381d2f85203f" #edb/ref 17592186045417] [17592186050666 #edb/ref 1027 #edb/ref 17592186048540 #edb/ref 17592186045417] [17592186050666 #edb/ref 1027 #edb/ref 17592186049346 #edb/ref 17592186045417] [17592186050666 #edb/ref 1028 #edb/ref 17592186179675 #edb/ref 17592186045417] [17592186050666 #edb/ref 1028 #edb/ref 17592186179729 #edb/ref 17592186045417] [17592186050666 #edb/ref 1028 #edb/ref 17592186179734 #edb/ref 17592186045417] [17592186050666 #edb/ref 1031 "Sums of Line Integrals With Respect to X and Y Over Parametric Curves" #edb/ref 17592186045417] [17592186050666 #edb/ref 1033 3705 #edb/ref 17592186045417] [17592186050666 #edb/ref 1035 #uuid "5d68aacb-ca27-5530-ae69-05289931b444" #edb/ref 17592186045417] [17592186051000 #edb/ref 1027 #edb/ref 17592186050666 #edb/ref 17592186045417] [17592186051000 #edb/ref 1027 #edb/ref 17592186050687 #edb/ref 17592186045417] [17592186051000 #edb/ref 1028 #edb/ref 17592186133891 #edb/ref 17592186045417] [17592186051000 #edb/ref 1028 #edb/ref 17592186133892 #edb/ref 17592186045417] [17592186051000 #edb/ref 1028 #edb/ref 17592186133893 #edb/ref 17592186045417] [17592186051000 #edb/ref 1031 "Line Integrals With Respect to X and Y" #edb/ref 17592186045417] [17592186051000 #edb/ref 1033 2109 #edb/ref 17592186045417] [17592186051000 #edb/ref 1035 #uuid "789238e2-4251-5080-bbc3-e713bd84a64b" #edb/ref 17592186045417] [17592186179531 #edb/ref 1069 "e-7118" #edb/ref 17592186045417] [17592186179531 #edb/ref 1071 "Construct a definite integral that is equivalent to $\\displaystyle \\int\\limits_C (x^2+y)\\,\\mathrm{d}x + x\\,\\mathrm{d}y,$ where $C$ is parametrized by $\\mathbf{r}(t) = t\\,\\mathbf{i} + t^2\\,\\mathbf{j}$ for $t\\in\\left[0,1\\right].$" #edb/ref 17592186045417] [17592186179531 #edb/ref 1072 #uuid "7cec344e-596a-51ce-87cc-d0e44dc48df4" #edb/ref 17592186045417] [17592186179531 #edb/ref 1074 "Along the curve, we have\n\n$$\nx(t) = t, \\qquad\ny(t) = t^2.\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j \\\\  & =i+2t\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}+y)\\,dx+x\\,dy & ={\\int }_{0}^{1}({x}^{2}+y)\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}(({x}^{2}+y)\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{1}({t}^{2}+{t}^{2})\\cdot 1+t\\cdot 2t\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}2{t}^{2}+2{t}^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}4{t}^{2}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{1}{t}^{2}\\,\\text{d}t\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186179591 #edb/ref 1069 "e-9517" #edb/ref 17592186045417] [17592186179591 #edb/ref 1071 "Construct a definite integral that is equivalent to $\\displaystyle \\int\\limits_C x^3\\,\\mathrm{d}x + z\\,\\mathrm{d}y + y\\,\\mathrm{d}z,$ where $C$ is a portion of the helix $\\mathbf{r}(t)=2t\\,\\mathbf{i} + \\cos t\\,\\mathbf{j} + \\sin t\\,\\mathbf{k}$ for $t\\in[0,\\pi]?$" #edb/ref 17592186045417] [17592186179591 #edb/ref 1072 #uuid "2b0b2d1f-df55-56cf-9ae9-ccef499e2352" #edb/ref 17592186045417] [17592186179591 #edb/ref 1074 "Along the curve, we have\n\n$$\nx(t) =2t, \\qquad \ny(t) = \\cos t , \\qquad \nz(t) = \\sin t.\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,k \\\\  & =2\\,i-\\operatorname{sin}⁡t\\,j+\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{3}\\,dx+z\\,dy+y\\,dz & ={\\int }_{0}^{\\pi }{x}^{3}\\frac{\\text{d}x}{\\text{d}t}\\,dt+z\\frac{\\text{d}y}{\\text{d}t}\\,dt+y\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }({x}^{3}\\frac{\\text{d}x}{\\text{d}t}+z\\frac{\\text{d}y}{\\text{d}t}+y\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{\\pi }(2t)^{3}\\cdot (2)+\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{cos}⁡t\\cdot (\\operatorname{cos}⁡t)\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}-{sin}^{2}⁡t+{cos}^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}+({cos}^{2}⁡t-{sin}^{2}⁡t)\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}+\\operatorname{cos}⁡2t\\,dt\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186179596 #edb/ref 1069 "e-9528" #edb/ref 17592186045417] [17592186179596 #edb/ref 1071 "Evaluate $\\displaystyle \\int\\limits_C y\\,\\mathrm{d}x -x\\,\\mathrm{d}y ,$ where $C$ is a portion of the ellipse parametrized by $\\mathbf{r}(t)=\\cos t\\,\\mathbf{i} + 3\\sin t\\,\\mathbf{j}$ for $t\\in[0,\\pi].$" #edb/ref 17592186045417] [17592186179596 #edb/ref 1072 #uuid "c18fbc4a-24d5-517d-9a3c-949a11787076" #edb/ref 17592186045417] [17592186179596 #edb/ref 1074 "Along the curve, we have\n\n$$\nx(t) = \\cos t, \\qquad\ny(t) = 3\\sin t.\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)\\,j \\\\  & =-\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}y\\,dx-x\\,dy & ={\\int }_{0}^{\\pi }y\\cdot \\frac{\\text{d}x}{\\text{d}t}\\,dt-x\\cdot \\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }(y\\cdot \\frac{\\text{d}x}{\\text{d}t}-x\\cdot \\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{\\pi }3\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)-(\\operatorname{cos}⁡t)\\cdot 3\\operatorname{cos}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi }-3{sin}^{2}⁡t-3{cos}^{2}⁡t\\,dt \\\\  & =-3{\\int }_{0}^{\\pi }{sin}^{2}⁡t+{cos}^{2}⁡t\\,dt \\\\  & =-3{\\int }_{0}^{\\pi }\\,dt \\\\  & =-3{t|}_{0}^{\\pi } \\\\  & =-3\\pi \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186179675 #edb/ref 1037 #edb/ref 17592186048362 #edb/ref 17592186045417] [17592186179675 #edb/ref 1037 #edb/ref 17592186048703 #edb/ref 17592186045417] [17592186179675 #edb/ref 1037 #edb/ref 17592186051000 #edb/ref 17592186045417] [17592186179675 #edb/ref 1038 #edb/ref 17592186180007 #edb/ref 17592186045417] [17592186179675 #edb/ref 1038 #edb/ref 17592186180013 #edb/ref 17592186045417] [17592186179675 #edb/ref 1038 #edb/ref 17592186259745 #edb/ref 17592186045417] [17592186179675 #edb/ref 1038 #edb/ref 17592186259747 #edb/ref 17592186045417] [17592186179675 #edb/ref 1038 #edb/ref 17592186259748 #edb/ref 17592186045417] [17592186179675 #edb/ref 1038 #edb/ref 17592186387595 #edb/ref 17592186045417] [17592186179675 #edb/ref 1038 #edb/ref 17592186387602 #edb/ref 17592186045417] [17592186179675 #edb/ref 1039 "Constructing a Sum of Line Integrals With Respect to X and Y" #edb/ref 17592186045417] [17592186179675 #edb/ref 1041 #edb/ref 17592186179531 #edb/ref 17592186045417] [17592186179675 #edb/ref 1042 #uuid "3be2c44e-775f-53fa-a078-cff25eaea903" #edb/ref 17592186045417] [17592186179729 #edb/ref 1038 #edb/ref 17592186180014 #edb/ref 17592186045417] [17592186179729 #