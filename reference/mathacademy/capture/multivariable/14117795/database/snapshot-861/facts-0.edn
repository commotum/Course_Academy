e5f-b4a4-bb8ae9638a75" #edb/ref 17592186045417] [17592186179858 #edb/ref 1043 #edb/ref 17592186180394 #edb/ref 17592186045417] [17592186179858 #edb/ref 1043 #edb/ref 17592186180395 #edb/ref 17592186045417] [17592186179858 #edb/ref 1043 #edb/ref 17592186180476 #edb/ref 17592186045417] [17592186179858 #edb/ref 1043 #edb/ref 17592186180477 #edb/ref 17592186045417] [17592186179858 #edb/ref 1043 #edb/ref 17592186180487 #edb/ref 17592186045417] [17592186179858 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186179858 #edb/ref 1045 "Sums of Line Integrals With Respect to X and Y Over Parametric Curves" #edb/ref 17592186045417] [17592186179858 #edb/ref 1046 #edb/ref 17592186180395 #edb/ref 17592186045417] [17592186179858 #edb/ref 1049 #edb/ref 17592186050666 #edb/ref 17592186045417] [17592186179858 #edb/ref 1050 720.0 #edb/ref 17592186045417] [17592186179858 #edb/ref 1053 #uuid "e609e5db-3168-57af-8ec3-6779df22874b" #edb/ref 17592186045417] [17592186180007 #edb/ref 1068 #edb/ref 17592186413040 #edb/ref 17592186045417] [17592186180007 #edb/ref 1069 "q-124594" #edb/ref 17592186045417] [17592186180007 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186180007 #edb/ref 1071 "Which of the following is equivalent to ${\\int }_{C}(x+y)\\,dx+(x-y)\\,dy,$ where $C$ is parametrized by $r(t)=4t\\,i+(4-4t)\\,j$ for $t\\in [0,1]?$" #edb/ref 17592186045417] [17592186180007 #edb/ref 1072 #uuid "fb63c8a6-afef-5638-9fea-8aaeb2054ae5" #edb/ref 17592186045417] [17592186180007 #edb/ref 1074 "Along the curve, we have\n\n$$\nx(t)=4t,\\,y(t)=4-4t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4t)\\,i+\\frac{\\text{d}}{\\text{d}t}(4-4t)\\,j \\\\  & =4\\,i+(-4)\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,dx+(x-y)\\,dy & ={\\int }_{0}^{1}(x+y)\\frac{\\text{d}x}{\\text{d}t}\\,dt+(x-y)\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}((x+y)\\frac{\\text{d}x}{\\text{d}t}+(x-y)\\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{1}(4t+(4-4t))\\cdot 4+(4t-(4-4t))\\cdot (-4)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}16t+16-16t-16t+16-16t\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}32-32t\\,\\text{d}t \\\\  & =32{\\int }_{0}^{1}1-t\\,\\text{d}t\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186180013 #edb/ref 1068 #edb/ref 17592186413037 #edb/ref 17592186045417] [17592186180013 #edb/ref 1069 "q-124868" #edb/ref 17592186045417] [17592186180013 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186180013 #edb/ref 1071 "Which of the following is equivalent to ${\\int }_{C}\\operatorname{ln}⁡(x+y)\\,dx+(x+y)\\,dy,$ where $C$ is parametrized by $r(t)=i+t\\,j$ for $t\\in [0,2]?$" #edb/ref 17592186045417] [17592186180013 #edb/ref 1072 #uuid "a86d0f21-fc9f-5f42-9338-116e42667bb8" #edb/ref 17592186045417] [17592186180013 #edb/ref 1074 "Along the curve, we have\n\n$$\nx(t)=1,\\,y(t)=t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(1)\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j \\\\  & =j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\operatorname{ln}⁡(x+y)\\,dx+(x+y)\\,dy & ={\\int }_{0}^{2}\\operatorname{ln}⁡(x+y)\\frac{\\text{d}x}{\\text{d}t}\\,dt+(x+y)\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{2}(\\operatorname{ln}⁡(x+y)\\frac{\\text{d}x}{\\text{d}t}+(x+y)\\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{2}\\operatorname{ln}⁡(1+t)\\cdot 0+(1+t)\\cdot 1\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}1+t\\,\\text{d}t\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186180176 #edb/ref 1068 #edb/ref 17592186413036 #edb/ref 17592186045417] [17592186180176 #edb/ref 1069 "q-39681" #edb/ref 17592186045417] [17592186180176 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186180176 #edb/ref 1071 "Which of the following is equivalent to ${\\int }_{C}y\\,dx+x\\,dy+{z}^{2}\\,dz,$ where $C$ is a portion of the helix $r(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j+t\\,k$ for $t\\in [0,2\\pi ]?$" #edb/ref 17592186045417] [17592186180176 #edb/ref 1072 #uuid "74ba859e-96c2-518a-a67a-a55e65c7d804" #edb/ref 17592186045417] [17592186180176 #edb/ref 1074 "Along the curve, we have\n\n$$\nx(t)=\\operatorname{cos}⁡t,\\,y(t)=\\operatorname{sin}⁡t,\\,z(t)=t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}y\\,dx+x\\,dy+{z}^{2}\\,dz & ={\\int }_{0}^{2\\pi }y\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt+{z}^{2}\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{2\\pi }(y\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t}+{z}^{2}\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{cos}⁡t\\cdot (\\operatorname{cos}⁡t)+{t}^{2}\\cdot 1\\,dt \\\\  & ={\\int }_{0}^{2\\pi }{cos}^{2}⁡t-{sin}^{2}⁡t+{t}^{2}\\,dt \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{cos}⁡2t+{t}^{2}\\,dt\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186180295 #edb/ref 1068 #edb/ref 17592186413039 #edb/ref 17592186045417] [17592186180295 #edb/ref 1069 "q-90724" #edb/ref 17592186045417] [17592186180295 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186180295 #edb/ref 1071 "Evaluate ${\\int }_{C}-y\\,dx+x\\,dy+z\\,dz,$ where $C$ is a portion of the helix $r(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j+t\\,k$ for $t\\in [0,2\\pi ].$" #edb/ref 17592186045417] [17592186180295 #edb/ref 1072 #uuid "428d05f1-93a8-5aa4-b7d0-699c4ffafa60" #edb/ref 17592186045417] [17592186180295 #edb/ref 1074 "Along the curve, we have\n\n$$\nx(t)=\\operatorname{cos}⁡t,\\,y(t)=\\operatorname{sin}⁡t,\\,z(t)=t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+k.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}-y\\,dx+x\\,dy+z\\,dz & ={\\int }_{0}^{2\\pi }-y\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt+z\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{2\\pi }(-y\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t}+z\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{2\\pi }-\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{cos}⁡t\\cdot \\operatorname{cos}⁡t+t\\cdot 1\\,dt \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡t+{cos}^{2}⁡t+t\\,dt \\\\  & ={\\int }_{0}^{2\\pi }1+t\\,dt \\\\  & =(t+\\frac{{t}^{2}}{2}){|}_{0}^{2\\pi } \\\\  & =2\\pi +\\frac{(2\\pi )^{2}}{2} \\\\  & =2\\pi (1+\\pi )\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186180394 #edb/ref 1058 #edb/ref 17592186180477 #edb/ref 17592186045417] [17592186180394 #edb/ref 1061 26175 #edb/ref 17592186045417] [17592186180394 #edb/ref 1062 #uuid "1221b846-bf07-5b93-bf5a-5f8ba64ac365" #edb/ref 17592186045417] [17592186180394 #edb/ref 1063 #edb/ref 17592186179675 #edb/ref 17592186045417] [17592186180395 #edb/ref 1058 #edb/ref 17592186180394 #edb/ref 17592186045417] [17592186180395 #edb/ref 1061 27289 #edb/ref 17592186045417] [17592186180395 #edb/ref 1062 #uuid "621fd314-933c-56a6-97f4-7a591c8ceee3" #edb/ref 17592186045417] [17592186180395 #edb/ref 1063 #edb/ref 17592186180681 #edb/ref 17592186045417] [17592186180476 #edb/ref 1058 #edb/ref 17592186180487 #edb/ref 17592186045417] [17592186180476 #edb/ref 1061 35620 #edb/ref 17592186045417] [17592186180476 #edb/ref 1062 #uuid "3d3c67b4-ef9a-5648-81cf-8ed48d14fa68" #edb/ref 17592186045417] [17592186180476 #edb/ref 1063 #edb/ref 17592186179729 #edb/ref 17592186045417] [17592186180477 #edb/ref 1058 #edb/ref 17592186180476 #edb/ref 17592186045417] [17592186180477 #edb/ref 1061 35621 #edb/ref 17592186045417] [17592186180477 #edb/ref 1062 #uuid "643f2b27-0aa4-53bd-995f-f4862424f404" #edb/ref 17592186045417] [17592186180477 #edb/ref 1063 #edb/ref 17592186180712 #edb/ref 17592186045417] [17592186180487 #edb/ref 1061 35687 #edb/ref 17592186045417] [17592186180487 #edb/ref 1062 #uuid "d3d36521-e553-55b3-9ce0-83868054277e" #edb/ref 17592186045417] [17592186180487 #edb/ref 1063 #edb/ref 17592186179734 #edb/ref 17592186045417] [17592186180681 #edb/ref 1064 "Line integrals with respect to $x$ and $y$ often come in pairs. For example, \n\n$$\n\\int\\limits_C (x+y) \\, \\textrm dx + \\int\\limits_C (x-y) \\, \\textrm dy.\n$$\n\nWe usually express a sum of line integrals with respect to $x$ and $y$ as a single integral. In the case above, we can write this sum as\n\n$$\n\\int\\limits_C (x+y) \\, \\textrm dx + (x-y) \\, \\textrm dy.\n$$\n\nLet's evaluate this integral in this case where $C$ is given by the line segment\n\n$$\n\\mathbf{r}(t)=\\underbrace{(6t+1)}_{x(t)} \\,\\mathbf{i} + \\underbrace{(2t+1)}_{y(t)} \\,\\mathbf{j}, \\qquad t\\in\\left[0,1\\right].\n$$\n\nAlong the path $C,$ we have\n\n$$\nx = 6t+1, \\qquad y = 2t+1.\n$$\n\nComputing the derivative of $\\mathbf r(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6t+1)\\,i+\\frac{\\text{d}}{\\text{d}t}(2t+1)\\,j \\\\  & =6\\,i+2\\,j.\\end{aligned}\n$$\n\nNow, we evaluate the line integral by applying a change of variables, as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,\\text{d}x+(x-y)\\,\\text{d}y & ={\\int }_{0}^{1}(x+y)\\cdot \\frac{\\text{d}x}{\\text{d}t}\\,dt+(x-y)\\cdot \\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}((x+y)\\cdot \\frac{\\text{d}x}{\\text{d}t}+(x-y)\\cdot \\frac{\\text{d}y}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{1}(6t+1+2t+1)\\cdot 6+(6t+1-(2t+1))\\cdot 2\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(8t+2)\\cdot 6+(4t)\\cdot 2\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}48t+12+8t\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}56t+12\\,\\text{d}t \\\\  & ={28{t}^{2}+12t|}_{0}^{1} \\\\  & =28+12 \\\\  & =40.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186180681 #edb/ref 1065 4437 #edb/ref 17592186045417] [17592186180681 #edb/ref 1066 #uuid "7c3e84f3-cbc8-5522-87f2-5accaa3854e2" #edb/ref 17592186045417] [17592186180681 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186180712 #edb/ref 1064 "Let $f(x,y,z)$ be a function of three variables and $C$ be a path in three-dimensional space. Suppose we want to calculate the following sum of line integrals:\n\n$$\n\\int\\limits_C f \\, \\textrm dx + \\int\\limits_C f \\, \\textrm dy +  \\int\\limits_C f \\, \\textrm dz\n$$\n\nFor notational simplicity, we can express this as a single integral, as follows:  \n\n$$\n\\int\\limits_C f \\, \\textrm dx + f \\, \\textrm dy +   f \\, \\textrm dz\n$$\n\nAs before, we can evaluate this integral by parameterizing the curve $C$ using the parameter $t\\in [a,b]$ and then rewriting the integral using a change of variables, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}f\\,\\text{d}x+f\\,\\text{d}y+f\\,\\text{d}z & ={\\int }_{a}^{b}f\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+f\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t+f\\frac{\\text{d}z}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{a}^{b}(f\\frac{\\text{d}x}{\\text{d}t}+f\\frac{\\text{d}y}{\\text{d}t}+f\\frac{\\text{d}z}{\\text{d}t})\\,\\text{d}t\\end{aligned}\n$$\n\nNote that we often omit the large parentheses and simply write\n\n$$\n\\int_a^b f\\dfrac{\\textrm d x}{\\textrm d t} + f \\dfrac{\\textrm d y}{\\textrm d t} +   f \\dfrac{\\textrm d z}{\\textrm d t} \\,\\textrm d t.\n$$\n\nFinally, it can be helpful to switch to prime notation for the derivatives when dealing with complex integrands. In this case, the above formula becomes\n\n$$\n\\int_a^b f x'+ f y' +   f z' \\,\\textrm d t,\n$$\n\nwhere the primes denote differentiation with respect to $t.$" #edb/ref 17592186045417] [17592186180712 #edb/ref 1065 5813 #edb/ref 17592186045417] [17592186180712 #edb/ref 1066 #uuid "8db52e8b-f669-5f77-b902-168c59d3b98f" #edb/ref 17592186045417] [17592186180712 #edb/ref 1067 "Line Integrals With Respect to X, Y, and Z" #edb/ref 17592186045417] [17592186413006 #edb/ref 1080 "16{\\int }_{0}^{2}2t-1\\,\\text{d}t" #edb/ref 17592186045417] [17592186413006 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186413006 #edb/ref 1083 #uuid "0f99d644-a1ad-5b43-b8be-36588f2a8d57" #edb/ref 17592186045417] [17592186413007 #edb/ref 1080 "{\\int }_{1}^{4}8{t}^{3}-8{t}^{2}+3t\\,dt" #edb/ref 17592186045417] [17592186413007 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186413007 #edb/ref 1083 #uuid "207e611c-1715-5848-8636-a148354824ca" #edb/ref 17592186045417] [17592186413008 #edb/ref 1080 "{\\int }_{0}^{2}\\operatorname{ln}⁡(1+t)+t+1\\,\\text{d}t" #edb/ref 17592186045417] [17592186413008 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186413008 #edb/ref 1083 #uuid "355201fd-a87c-5acd-a773-040c3348da1d" #edb/ref 17592186045417] [17592186413009 #edb/ref 1080 "60" #edb/ref 17592186045417] [17592186413009 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186413009 #edb/ref 1083 #uuid "3ea3a