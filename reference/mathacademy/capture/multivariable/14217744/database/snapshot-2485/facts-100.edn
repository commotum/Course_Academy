17] [17592186529047 #edb/ref 1078 #edb/ref 17592186528365 #edb/ref 17592186045417] [17592186529047 #edb/ref 1079 #uuid "c3c0ce87-8111-5c96-ab4f-9edca6a3f6b6" #edb/ref 17592186045417] [17592186529054 #edb/ref 1075 #edb/ref 17592186528847 #edb/ref 17592186045417] [17592186529054 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186529054 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186529054 #edb/ref 1078 #edb/ref 17592186528847 #edb/ref 17592186045417] [17592186529054 #edb/ref 1079 #uuid "d13a95c4-8252-5e9e-aaed-c7750144cf3c" #edb/ref 17592186045417] [17592186529058 #edb/ref 1075 #edb/ref 17592186528369 #edb/ref 17592186045417] [17592186529058 #edb/ref 1075 #edb/ref 17592186528467 #edb/ref 17592186045417] [17592186529058 #edb/ref 1075 #edb/ref 17592186528666 #edb/ref 17592186045417] [17592186529058 #edb/ref 1075 #edb/ref 17592186528839 #edb/ref 17592186045417] [17592186529058 #edb/ref 1075 #edb/ref 17592186528930 #edb/ref 17592186045417] [17592186529058 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186529058 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186529058 #edb/ref 1078 #edb/ref 17592186528930 #edb/ref 17592186045417] [17592186529058 #edb/ref 1079 #uuid "d3c44b61-550f-50e7-828e-641fd371090c" #edb/ref 17592186045417] [17592186529077 #edb/ref 1075 #edb/ref 17592186528345 #edb/ref 17592186045417] [17592186529077 #edb/ref 1075 #edb/ref 17592186528411 #edb/ref 17592186045417] [17592186529077 #edb/ref 1075 #edb/ref 17592186528412 #edb/ref 17592186045417] [17592186529077 #edb/ref 1075 #edb/ref 17592186528617 #edb/ref 17592186045417] [17592186529077 #edb/ref 1075 #edb/ref 17592186528653 #edb/ref 17592186045417] [17592186529077 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186529077 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186529077 #edb/ref 1078 #edb/ref 17592186528412 #edb/ref 17592186045417] [17592186529077 #edb/ref 1079 #uuid "ec27395b-38a3-58fa-99e7-8f30382149a4" #edb/ref 17592186045417] [17592186529093 #edb/ref 1068 #edb/ref 17592186528977 #edb/ref 17592186045417] [17592186529093 #edb/ref 1069 "q-50498" #edb/ref 17592186045417] [17592186529093 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186529093 #edb/ref 1071 "Given that ${a}_{1}=-\\frac{5}{2}$ and $\\frac{{a}_{n+1}}{{a}_{n}}=-\\frac{1}{10}$ for all integers $n\\ge 1,$ find the value of ${\\sum }_{n=1}^{\\infty }{a}_{n}.$" #edb/ref 17592186045417] [17592186529093 #edb/ref 1072 #uuid "14f76056-5e3c-539d-8f82-855878eb07d3" #edb/ref 17592186045417] [17592186529093 #edb/ref 1074 "Notice that the given series is geometric series because the ratio of any two consecutive terms is constant.\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nWe're told that the first term is\n\n$$\n{a}_{1}=-\\frac{5}{2}.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-\\frac{1}{10}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }{a}_{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{-\\frac{5}{2}}{(1-(-\\frac{1}{10}))} \\\\  & =\\frac{-\\frac{5}{2}}{(\\frac{11}{10})} \\\\  & =-\\frac{5}{2}\\cdot \\frac{10}{11} \\\\  & =-\\frac{25}{11}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529118 #edb/ref 1068 #edb/ref 17592186528945 #edb/ref 17592186045417] [17592186529118 #edb/ref 1069 "q-5362" #edb/ref 17592186045417] [17592186529118 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529118 #edb/ref 1071 "Evaluate the geometric series ${\\sum }_{n=1}^{\\infty }\\frac{7}{10}{(-\\frac{2}{5})}^{2n}.$" #edb/ref 17592186045417] [17592186529118 #edb/ref 1072 #uuid "499dc119-15d3-5a33-9631-8bc1b2a65d1c" #edb/ref 17592186045417] [17592186529118 #edb/ref 1074 "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1.\n$$\n\nThe first term is \n\n$$\n{a}_{1}=\\frac{7}{10}{(-\\frac{2}{5})}^{2(1)}=\\frac{7}{10}{(-\\frac{2}{5})}^{2}\n$$\n\n \n\nand the second term is \n\n$$\n{a}_{2}=\\frac{7}{10}{(-\\frac{2}{5})}^{2(2)}=\\frac{7}{10}{(-\\frac{2}{5})}^{4}.\n$$\n\nTherefore, the common ratio is \n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{\\frac{7}{10}{(-\\frac{2}{5})}^{4}}{\\frac{7}{10}{(-\\frac{2}{5})}^{2}}={(-\\frac{2}{5})}^{2}=\\frac{4}{25}.\n$$\n\n \n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{7}{10}{(-\\frac{2}{5})}^{2n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{\\frac{7}{10}{(-\\frac{2}{5})}^{2}}{1-\\frac{4}{25}} \\\\  & =\\frac{\\frac{7}{10}(\\frac{4}{25})}{\\frac{21}{25}} \\\\  & =\\frac{7}{10}\\cdot \\frac{4}{25}\\cdot \\frac{25}{21} \\\\  & =\\frac{2}{15}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529119 #edb/ref 1068 #edb/ref 17592186528972 #edb/ref 17592186045417] [17592186529119 #edb/ref 1069 "q-350625" #edb/ref 17592186045417] [17592186529119 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529119 #edb/ref 1071 "Evaluate the following series. Do not round the answer.\n\n${\\sum }_{n=1}^{\\infty }(-7)(0.3)^{2n}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186529119 #edb/ref 1072 #uuid "4db8cfdc-3e22-5283-b109-341d9daf5b09" #edb/ref 17592186045417] [17592186529119 #edb/ref 1074 "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1.\n$$\n\nThe first term is\n\n$$\n{a}_{1}=(-7)(0.3)^{2(1)}=(-7)(0.3)^{2}=(-7)(0.09)=-0.63,\n$$\n\nand the second term is\n\n$$\n{a}_{2}=(-7)(0.3)^{2(2)}=(-7)(0.3)^{4}.\n$$\n\nTherefore, the common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{(-7)(0.3)^{4}}{(-7)(0.3)^{2}}=(0.3)^{2}=0.09.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }(-7)(0.3)^{2n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{(-0.63)}{1-0.09} \\\\  & =-\\frac{0.63}{0.91} \\\\  & =-\\frac{9}{13}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529124 #edb/ref 1068 #edb/ref 17592186528953 #edb/ref 17592186045417] [17592186529124 #edb/ref 1069 "q-350607" #edb/ref 17592186045417] [17592186529124 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529124 #edb/ref 1071 "Evaluate the following series. Do not round the answer.\n\n${\\sum }_{n=4}^{\\infty }{(\\frac{2}{3})}^{n}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186529124 #edb/ref 1072 #uuid "54f15411-79a5-546c-8ee4-965cb1e88cd5" #edb/ref 17592186045417] [17592186529124 #edb/ref 1074 "First, note that the index $n$ starts from $4.$ However, it is still a geometric series because it is in the form\n$\\sum a{r}^{n}.$\n\nIn this case, the first term is ${a}_{4},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{4}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{4} & ={(\\frac{2}{3})}^{4}=\\frac{16}{81} \\\\ {a}_{5} & ={(\\frac{2}{3})}^{5}=\\frac{32}{243}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{5}}{{a}_{4}}=\\frac{(\\frac{32}{243})}{(\\frac{16}{81})}=\\frac{2}{3}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=4}^{\\infty }{(\\frac{2}{3})}^{n} & =\\frac{{a}_{4}}{1-r} \\\\  & =\\frac{(\\frac{16}{81})}{(1-\\frac{2}{3})} \\\\  & =\\frac{(\\frac{16}{81})}{(\\frac{1}{3})} \\\\  & =\\frac{16}{27}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529125 #edb/ref 1068 #edb/ref 17592186529054 #edb/ref 17592186045417] [17592186529125 #edb/ref 1069 "q-350582" #edb/ref 17592186045417] [17592186529125 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186529125 #edb/ref 1071 "Evaluate the following series. Do not round the answer.\n\n${\\sum }_{n=1}^{\\infty }8{(\\frac{3}{8})}^{n}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186529125 #edb/ref 1072 #uuid "56e0e8e1-0cfd-5d25-b2ed-327a18d60529" #edb/ref 17592186045417] [17592186529125 #edb/ref 1074 "Notice that the given series is a geometric series because it is in the form\n$\\sum a{r}^{n}.$\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=8{(\\frac{3}{8})}^{1}=3.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{8{(\\frac{3}{8})}^{2}}{8{(\\frac{3}{8})}^{1}}=\\frac{3}{8}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }8{(\\frac{3}{8})}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{3}{(1-\\frac{3}{8})} \\\\  & =\\frac{3}{(\\frac{5}{8})} \\\\  & =\\frac{24}{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529130 #edb/ref 1068 #edb/ref 17592186529009 #edb/ref 17592186045417] [17592186529130 #edb/ref 1069 "q-350579" #edb/ref 17592186045417] [17592186529130 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186529130 #edb/ref 1071 "Evaluate the following series. Do not round the answer.\n\n${\\sum }_{n=1}^{\\infty }4{(\\frac{3}{5})}^{n}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186529130 #edb/ref 1072 #uuid "5c0c2f91-9457-576f-ab5b-77c8f4a530ad" #edb/ref 17592186045417] [17592186529130 #edb/ref 1074 "Notice that the given series is a geometric series because it is in the form\n$\\sum a{r}^{n}.$\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=4{(\\frac{3}{5})}^{1}=\\frac{12}{5}.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{4{(\\frac{3}{5})}^{2}}{4{(\\frac{3}{5})}^{1}}=\\frac{3}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }4{(\\frac{3}{5})}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{(\\frac{12}{5})}{(1-\\frac{3}{5})} \\\\  & =\\frac{(\\frac{12}{5})}{(\\frac{2}{5})} \\\\  & =6.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529140 #edb/ref 1068 #edb/ref 17592186529042 #edb/ref 17592186045417] [17592186529140 #edb/ref 1069 "q-78591" #edb/ref 17592186045417] [17592186529140 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529140 #edb/ref 1071 "Evaluate the series ${\\sum }_{n=2}^{\\infty }{(\\frac{4}{5})}^{n}.$" #edb/ref 17592186045417] [17592186529140 #edb/ref 1072 #uuid "75a391e4-92f0-5306-8519-d804235fa403" #edb/ref 17592186045417] [17592186529140 #edb/ref 1074 "First, note that the index $n$ starts from $2.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{2},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{2}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{2} & ={(\\frac{4}{5})}^{2}=\\frac{16}{25} \\\\ {a}_{3} & ={(\\frac{4}{5})}^{3}=\\frac{64}{125}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{3}}{{a}_{2}}=\\frac{(\\frac{64}{125})}{(\\frac{16}{25})}=\\frac{4}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=2}^{\\infty }{(\\frac{4}{5})}^{n} & =\\frac{{a}_{2}}{1-r} \\\\  & =\\frac{(\\frac{16}{25})}{(1-\\frac{4}{5})} \\\\  & =\\frac{(\\frac{16}{25})}{(\\frac{1}{5})} \\\\  & =\\frac{16}{25}\\cdot 5 \\\\  & =\\frac{16}{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529142 #edb/ref 1068 #edb/ref 17592186528998 #edb/ref 17592186045417] [17592186529142 #edb/ref 1069 "q-350624" #edb/ref 17592186045417] [17592186529142 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529142 #edb/ref 1071 "Evaluate the following series. Do not round the answer.\n\n${\\sum }_{n=1}^{\\infty }6(0.5)^{2n}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186529142 #edb/ref 1072 #uuid "7a6fcb51-44e7-59f8-9078-8afece3073a1" #edb/ref 17592186045417] [17592186529142 #edb/ref 1074 "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1.\n$$\n\nThe first term is\n\n$$\n{a}_{1}=6(0.5)^{2(1)}=6(0.5)^{2}=6(0.25)=1.5,\n$$\n\nand the second term is\n\n$$\n{a}_{2}=6(0.5)^{2(2)}=6(0.5)^{4}.\n$$\n\nTherefore, the common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{6(0.5)^{4}}{6(0.5)^{2}}=(0.5)^{2}=0.25.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }6(0.5)^{2n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{1.5}{1-0.25} \\\\  & =\\frac{1.5}{0.75} \\\\  & =2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529144 #edb/ref 1068 #edb/ref 17592186529047 #edb/ref 17592186045417] [17592186529144 #edb/ref 1069 "q-78588" #edb/ref 17592186045417] [17592186529144 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186529144 #edb/ref 1071 "${\\sum }_{n=1}^{\\infty }\\frac{5}{2}{(0.4)}^{n}=$" #edb/ref 17592186045417] [17592186529144 #edb/ref 1072 #uuid "7e8589d7-77a6-5ea2-bd7d-7f7a24b35382" #edb/ref 17592186045417] [17592186529144 #edb/ref 1074 "Notice that the given series is a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=\\frac{5}{2}{(0.4)}^{1}=1.\n$$\n\n \n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{\\frac{5}{2}{(0.4)}^{2}}{\\frac{5}{2}{(0.4)}^{1}}=0.4.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{5}{2}{(0.4)}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{1}{1-0.4} \\\\  & =\\frac{1}{0.6} \\\\  & =\\frac{10}{6} \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529159 #edb/ref 1068 #edb/ref 17592186529020 #edb/ref 17592186045417] [17592186529159 #edb/ref 1069 "q-350577" #edb/ref 17592186045417] [17592186529159 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186529159 #edb/ref 1071 "Given that ${a}_{1}=5$ and $\\frac{{a}_{n+1}}{{a}_{n}}=-0.2$ for all integers $n\\ge 1,$ find the value of ${\\sum }_{n=1}^{\\infty }{a}_{n}.$\n\n${\\sum }_{n=1}^{\\infty }{a}_{n}=$\n{{field-1}}" #edb/ref 17592186045417] [17592186529159 #edb/ref 1072 #uuid "ac1cfe40-911c-5173-ab2c-22ea711c204a" #edb/ref 17592186045417] [17592186529159 #edb/ref 1074 "Notice that the given series is a geometric series because the ratio of any two consecutive terms is constant.\n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nWe're told that the first term is\n\n$$\n{a}_{1}=5.\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{n+1}}{{a}_{n}}=-0.2.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }{a}_{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{5}{(1-(-0.2))} \\\\  & =\\frac{5}{(1+0.2)} \\\\  & =\\frac{5}{1.2} \\\\  & =\\frac{25}{6}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529175 #edb/ref 1068 #edb/ref 17592186529077 #edb/ref 17592186045417] [17592186529175 #edb/ref 1069 "q-78592" #edb/ref 17592186045417] [17592186529175 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529175 #edb/ref 1071 "${\\sum }_{n=2}^{\\infty }\\frac{1}{3}{(\\frac{3}{5})}^{n}=$" #edb/ref 17592186045417] [17592186529175 #edb/ref 1072 #uuid "d588b5a8-8a0c-5e4d-8e17-d8c93ee42445" #edb/ref 17592186045417] [17592186529175 #edb/ref 1074 "First, note that the index $n$ starts from $2.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{2},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{2}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{2} & =\\frac{1}{3}{(\\frac{3}{5})}^{2}=\\frac{1}{3}(\\frac{9}{25})=\\frac{3}{25} \\\\ {a}_{3} & =\\frac{1}{3}{(\\frac{3}{5})}^{3}=\\frac{1}{3}(\\frac{27}{125})=\\frac{9}{125}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{3}}{{a}_{2}}=\\frac{(\\frac{9}{125})}{(\\frac{3}{25})}=\\frac{9}{125}\\cdot \\frac{25}{3}=\\frac{3}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=2}^{\\infty }\\frac{1}{3}{(\\frac{3}{5})}^{n} & =\\frac{{a}_{2}}{1-r} \\\\  & =\\frac{(\\frac{3}{25})}{(1-\\frac{3}{5})} \\\\  & =\\frac{(\\frac{3}{25})}{(\\frac{2}{5})} \\\\  & =\\frac{3}{25}\\cdot \\frac{5}{2} \\\\  & =\\frac{3}{10}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529180 #edb/ref 1068 #edb/ref 17592186528990 #edb/ref 17592186045417] [17592186529180 #edb/ref 1069 "q-124588" #edb/ref 17592186045417] [17592186529180 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186529180 #edb/ref 1071 "Evaluate the series ${\\sum }_{n=2}^{\\infty }180{(\\frac{1}{6})}^{n}.$" #edb/ref 17592186045417] [17592186529180 #edb/ref 1072 #uuid "dd479934-e321-5035-bf71-51bd7984a9a8" #edb/ref 17592186045417] [17592186529180 #edb/ref 1074 "First, note that the index $n$ starts from $2.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{2},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{2}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{2} & =180{(\\frac{1}{6})}^{2}=5 \\\\ {a}_{3} & =180{(\\frac{1}{6})}^{3}=\\frac{5}{6}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{3}}{{a}_{2}}=\\frac{(\\frac{5}{6})}{5}=\\frac{1}{6}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=2}^{\\infty }180{(\\frac{1}{6})}^{n} & =\\frac{{a}_{2}}{1-r} \\\\  & =\\frac{5}{(1-\\frac{1}{6})} \\\\  & =\\frac{5}{(\\frac{5}{6})} \\\\  & =6.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529182 #edb/ref 1068 #edb/ref 17592186528952 #edb/ref 17592186045417] [17592186529182 #edb/ref 1069 "q-124584" #edb/ref 17592186045417] [17592186529182 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186529182 #edb/ref 1071 "${\\sum }_{n=1}^{\\infty }10{(\\frac{3}{5})}^{n}=$" #edb/ref 17592186045417] [17592186529182 #edb/ref 1072 #uuid "df45f3a3-f545-5c42-98d5-edf671e88e36" #edb/ref 17592186045417] [17592186529182 #edb/ref 1074 "Notice that the given series is a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=10{(\\frac{3}{5})}^{1}=6.\n$$\n\n \n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{10{(\\frac{3}{5})}^{2}}{10{(\\frac{3}{5})}^{1}}=\\frac{3}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }10{(\\frac{3}{5})}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{6}{(1-\\frac{3}{5})} \\\\  & =\\frac{6}{(\\frac{2}{5})} \\\\  & =6\\cdot \\frac{5}{2} \\\\  & =15.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186529194 #edb/ref 1068 #edb/ref 17592186529058 #edb/ref 17592186045417] [17592186529194 #edb/ref 1069 "q-67301" #edb/ref 17592186045417] [17592186529194 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186529194 #edb/ref 1071 "${\\sum }_{n=1}^{\\infty }8{(\\frac{3}{4})}^{n}=$" #edb/ref 17592186045417] [17592186529194 #edb/ref 1072 #uuid "fbd76d75-8ee7-5bcd-acb2-1f5ae9aa3787" #edb/ref 17592186045417] [17592186529194 #edb/ref 1074 "Notice that the given series is a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given 