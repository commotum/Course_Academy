\"></mjx-line><mjx-row><mjx-den><mjx-dstrut type=\"d\"></mjx-dstrut><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn></mjx-den></mjx-row></mjx-dtable></mjx-dbox></mjx-frac></mjx-mfrac></mjx-mstyle><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>t</mi></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mtext>d</mtext><mrow><mtext>d</mtext><mi>t</mi></mrow></mfrac></mstyle><mo stretchy=\"false\">(</mo><msup><mi>z</mi><mn>2</mn></msup><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mn>2</mn><mi>x</mi><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mtext>d</mtext><mi>x</mi></mrow><mrow><mtext>d</mtext><mi>t</mi></mrow></mfrac></mstyle><mo>+</mo><mn>2</mn><mi>y</mi><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mtext>d</mtext><mi>y</mi></mrow><mrow><mtext>d</mtext><mi>t</mi></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mi>z</mi><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mtext>d</mtext><mi>z</mi></mrow><mrow><mtext>d</mtext><mi>t</mi></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd><mn>2</mn><mo stretchy=\"false\">(</mo><mn>12</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mn>16</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mn>20</mn><mo stretchy=\"false\">)</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mtext>d</mtext><mi>z</mi></mrow><mrow><mtext>d</mtext><mi>t</mi></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd><mn>8</mn></mtd><mtd><mi></mi><mo>=</mo><mn>40</mn><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mtext>d</mtext><mi>z</mi></mrow><mrow><mtext>d</mtext><mi>t</mi></mrow></mfrac></mstyle></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mtext>d</mtext><mi>z</mi></mrow><mrow><mtext>d</mtext><mi>t</mi></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>8</mn><mn>40</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mtext>d</mtext><mi>z</mi></mrow><mrow><mtext>d</mtext><mi>t</mi></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>5</mn></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore, the length of the hypotenuse is changing at a rate of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"211\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-num><mjx-dbox><mjx-dtable><mjx-line type=\"d\"></mjx-line><mjx-row><mjx-den><mjx-dstrut type=\"d\"></mjx-dstrut><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn></mjx-den></mjx-row></mjx-dtable></mjx-dbox></mjx-frac></mjx-mfrac></mjx-mstyle><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6D\"></mjx-c></mjx-mtext><mjx-texatom texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2F\"></mjx-c></mjx-mo></mjx-texatom><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c73\"></mjx-c></mjx-mtext><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>5</mn></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>m</mtext><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mtext>s</mtext><mo>.</mo></math></mjx-assistive-mml></mjx-container> </p>\n</div></div>",
