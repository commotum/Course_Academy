      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14208490/observations/step-q2588-325cc4c1d8efab24c72f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14208490/observations/step-q2588-325cc4c1d8efab24c72f.png",
      "source_url": "https://mathacademy.com/tasks/14208490/topics/345/lesson",
