#{[{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186508164} :activity/id #uuid "ce471d2f-8379-598a-8823-8380010372f1" :activity/scope {:db/id #edb/ref 17592186049506 :topic/id #uuid "fa5d4de4-2fdf-59d1-aea5-7f62da44a307" :topic/math-academy-id 3216} :activity/steps [{:db/id #edb/ref 17592186508119 :step/content {:db/id #edb/ref 17592186262783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "193eadf3-4d9d-5560-876d-95d6202e9c93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{y}{2x}" :db/id #edb/ref 17592186260095} {:answer/id #uuid "35d44e75-ae76-5b88-839e-6d033a89f631" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x}{4y}" :db/id #edb/ref 17592186260357} {:answer/id #uuid "5f1dc785-7cef-5337-90f3-1ba825d33fc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4x}{y}" :db/id #edb/ref 17592186260694} {:answer/id #uuid "76364d2a-ee13-58e3-90a7-aedf8b7a207f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2x}{y}" :db/id #edb/ref 17592186260907} {:answer/id #uuid "85fa198d-352f-536a-a28b-55a7d967de78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{y}{4x}" :db/id #edb/ref 17592186261038}] :answer-field/correct {:db/id #edb/ref 17592186260694} :answer-field/id #uuid "f89dbf13-8c69-578f-a637-7a5acc775b45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262554}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "adf3739c-b726-56b2-925a-36974745f33e" :question/math-academy-id "q-127511" :question/problem "![](images/c0/c0295c7cdc1abc16273efda842a0aa7a892ece2f5dda5e29f7baab25320b23ec.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at the origin and has semiaxes $1$ and $2,$ its equation is given by\n\n$$\n\\frac{{x}^{2}}{{1}^{2}}+\\frac{{y}^{2}}{{2}^{2}}=1\\,⟹\\,{x}^{2}+\\frac{{y}^{2}}{4}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+\\frac{{y}^{2}}{4}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(\\frac{{y}^{2}}{4}) & =0 \\\\ 2x+\\frac{2y}{4}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{y}{2}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{4x}{y}\\end{aligned}\n$$"} :step/id #uuid "0f0d24bd-29e8-5c71-ac39-9ab1f02977b5" :step/next {:db/id #edb/ref 17592186508160}} {:db/id #edb/ref 17592186508154 :step/content {:db/id #edb/ref 17592186167096 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b50d0c40-6788-57f6-abfc-e79bf313d479" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{y}{2}" :db/id #edb/ref 17592186163655} {:answer/id #uuid "0872fa03-25f1-5ab1-8e8a-b7add5e28113" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{y}" :db/id #edb/ref 17592186163656} {:answer/id #uuid "40308631-4569-53b4-a049-a0c1e9473978" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{y}" :db/id #edb/ref 17592186163657} {:answer/id #uuid "515e1940-de9b-5005-bcc4-522fce4979f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{y}" :db/id #edb/ref 17592186163658} {:answer/id #uuid "77251aea-0d1b-53cd-8e9c-1840b159150c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2y}" :db/id #edb/ref 17592186163659}] :answer-field/correct {:db/id #edb/ref 17592186163657} :answer-field/id #uuid "106254b3-fb7a-53e5-9145-bedbc3b56b87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186163654}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2b2fc0d7-ecff-5b63-8ad8-a6faaff8e7b2" :question/math-academy-id "q-127374" :question/problem "![](images/88/88bec66b7ece961f2f0fc4083ce317f2bdc414e0a219d61bbf9bf73ae667ca0f.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the left-opening parabola shown above." :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(-2,2).$\n\nThe general equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=-2$ and $y=2$ into the equation above, we get\n\n$$\n\\begin{aligned}(2)^{2} & =4p(-2) \\\\ 4 & =-8p \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=-2x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(-2x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{y}\\end{aligned}\n$$"} :step/id #uuid "c0cf1faf-8197-51f4-9104-97a7b1c9b0bb" :step/next {:db/id #edb/ref 17592186508155}} {:db/id #edb/ref 17592186508155 :step/content {:db/id #edb/ref 17592186508059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5efdb2c0-9881-5a00-b565-3f359e70c7a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{9y}{2}" :db/id #edb/ref 17592186507737} {:answer/id #uuid "93f161f4-832c-5426-af71-c7778005d5fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{4y}" :db/id #edb/ref 17592186507807} {:answer/id #uuid "e3a24980-5105-538e-8c74-64c4ebc803d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3y}{4}" :db/id #edb/ref 17592186507904} {:answer/id #uuid "e5c9d2d6-91af-5536-9214-6c10a18ce267" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2y}" :db/id #edb/ref 17592186507909} {:answer/id #uuid "ef20abea-8c5e-5aa2-aa09-5d4772fb2a0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4y}" :db/id #edb/ref 17592186507922}] :answer-field/correct {:db/id #edb/ref 17592186507922} :answer-field/id #uuid "293366ad-ad39-5d08-a9c8-a7c1154b5526" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507956}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3f2a3f8a-3c25-5094-b1ff-9932bec29ec7" :question/math-academy-id "q-127503" :question/problem "![](images/4c/4c6a99f62a77f7fc16dbb95e8a8d03c42b266fffee10ed3739ab13820729be44.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the right-opening parabola shown above." :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(2,-3).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=2$ and $y=-3$ into the equation above, we get\n\n$$\n\\begin{aligned}(-3)^{2} & =4p(2) \\\\ 9 & =8p \\\\ p & =\\frac{9}{8}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=\\frac{9}{2}x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{9}{2}x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =\\frac{9}{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{9}{4y}\\end{aligned}\n$$"} :step/id #uuid "c7e032e9-4bef-54c2-b560-78520348dd9a" :step/next {:db/id #edb/ref 17592186508119}} {:db/id #edb/ref 17592186508160 :step/content {:db/id #edb/ref 17592186317217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ce1afa-8b88-5a8a-8cdc-4e464a1bb102" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{6y}" :db/id #edb/ref 17592186315162}] :answer-field/correct {:db/id #edb/ref 17592186315162} :answer-field/id #uuid "4ad31bfe-fcf5-5162-a8e6-4281f1f124b2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186316722}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "28f921c8-6fd7-5d79-b2ff-0d1df567197f" :question/math-academy-id "q-342215" :question/problem "![](images/c4/c403f11093b76facafbecb72bcc413640ac67fe6ed73d6b64374230f39e29aba.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the left-opening parabola shown above. Express the answer in terms of the variable $y.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(-3,-1).$\n\nThe general equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=-3$ and $y=-1$ into the equation above, we get\n\n$$\n\\begin{aligned}(-1)^{2} & =4p(-3) \\\\ 1 & =-12p \\\\ p & =-\\frac{1}{12}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=-\\frac{1}{3}x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{1}{3}x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{3} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{6y}\\end{aligned}\n$$"} :step/id #uuid "d8e0b28f-9d0a-5880-9a89-290ee7f36789"} {:db/id #edb/ref 17592186508164 :step/content {:db/id #edb/ref 17592186167094 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8de18c-3f57-5375-af7f-efa2e0197549" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3(y+1)}{4(x-2)}" :db/id #edb/ref 17592186507652} {:answer/id #uuid "a673094f-6307-5b33-92bf-06c740822bf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{16(x-2)}{9(y+1)}" :db/id #edb/ref 17592186507832} {:answer/id #uuid "db7d24c3-d19d-5779-b9b1-949d29cf47df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{9(y+1)}{16(x-2)}" :db/id #edb/ref 17592186507894} {:answer/id #uuid "f0580d29-12ed-56aa-ba70-461fe3aa6008" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16(x-2)}{9(y+1)}" :db/id #edb/ref 17592186507923} {:answer/id #uuid "f95d1962-8d93-5d37-a3ac-481ea9ea1974" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4(x-2)}{3(y+1)}" :db/id #edb/ref 17592186507935}] :answer-field/correct {:db/id #edb/ref 17592186507832} :answer-field/id #uuid "ae32260f-36b3-5a38-a8ce-a21db00f57c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186163642}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "321fa992-8b54-51c4-9c6a-89b1f36a3444" :question/math-academy-id "q-127364" :question/problem "![](images/b5/b56ff4cb47d9b529762c6364eac2eed4b666c7ca9eab6f6ba7d3bc161387433e.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at $(2,-1)$ and has semiaxes $3$ and $4,$ its equation is given by\n\n$$\n\\frac{(x-2)^{2}}{{3}^{2}}+\\frac{(y-(-1))^{2}}{{4}^{2}}=1\\,⟹\\,\\frac{(x-2)^{2}}{9}+\\frac{(y+1)^{2}}{16}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{(x-2)^{2}}{9}+\\frac{(y+1)^{2}}{16}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{(x-2)^{2}}{9})+\\frac{\\text{d}}{\\text{d}x}(\\frac{(y+1)^{2}}{16}) & =0 \\\\ \\frac{2(x-2)}{9}+\\frac{2(y+1)}{16}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{y+1}{8}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2(x-2)}{9} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{16(x-2)}{9(y+1)}\\end{aligned}\n$$"} :step/id #uuid "e76417a4-f617-5d20-b0b3-117a2a97deb3" :step/next {:db/id #edb/ref 17592186508154}}] :activity/title "Calculating Slopes of Circles, Ellipses, and Parabolas" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186507604}]}
