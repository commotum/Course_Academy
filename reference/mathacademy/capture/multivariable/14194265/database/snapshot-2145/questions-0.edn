ola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b50d0c40-6788-57f6-abfc-e79bf313d479" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{2}" :db/id #edb/ref 17592186163655} {:answer/id #uuid "0872fa03-25f1-5ab1-8e8a-b7add5e28113" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}" :db/id #edb/ref 17592186163656} {:answer/id #uuid "40308631-4569-53b4-a049-a0c1e9473978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{y}" :db/id #edb/ref 17592186163657} {:answer/id #uuid "515e1940-de9b-5005-bcc4-522fce4979f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{y}" :db/id #edb/ref 17592186163658} {:answer/id #uuid "77251aea-0d1b-53cd-8e9c-1840b159150c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2y}" :db/id #edb/ref 17592186163659}] :answer-field/id #uuid "106254b3-fb7a-53e5-9145-bedbc3b56b87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163654}] :question/id #uuid "2b2fc0d7-ecff-5b63-8ad8-a6faaff8e7b2" :question/math-academy-id "q-127374" :question/problem "![](images/88/88bec66b7ece961f2f0fc4083ce317f2bdc414e0a219d61bbf9bf73ae667ca0f.png)\n\nFind $\\frac{dy}{dx}$ for the left-opening parabola shown above."}] [{:db/id #edb/ref 17592186262783 :knowledge-point/_questions [{:db/id #edb/ref 17592186166866 :knowledge-point/id #uuid "1e118393-2388-5add-b516-e565abe1e36a" :knowledge-point/title "Calculating the Slope of the Tangent to an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "193eadf3-4d9d-5560-876d-95d6202e9c93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y}{2x}" :db/id #edb/ref 17592186260095} {:answer/id #uuid "35d44e75-ae76-5b88-839e-6d033a89f631" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{4y}" :db/id #edb/ref 17592186260357} {:answer/id #uuid "5f1dc785-7cef-5337-90f3-1ba825d33fc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4x}{y}" :db/id #edb/ref 17592186260694} {:answer/id #uuid "76364d2a-ee13-58e3-90a7-aedf8b7a207f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x}{y}" :db/id #edb/ref 17592186260907} {:answer/id #uuid "85fa198d-352f-536a-a28b-55a7d967de78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{4x}" :db/id #edb/ref 17592186261038}] :answer-field/correct {:answer/id #uuid "5f1dc785-7cef-5337-90f3-1ba825d33fc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4x}{y}" :db/id #edb/ref 17592186260694} :answer-field/id #uuid "f89dbf13-8c69-578f-a637-7a5acc775b45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262554}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "adf3739c-b726-56b2-925a-36974745f33e" :question/math-academy-id "q-127511" :question/problem "![](images/c0/c0295c7cdc1abc16273efda842a0aa7a892ece2f5dda5e29f7baab25320b23ec.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at the origin and has semiaxes $1$ and $2,$ its equation is given by\n\n$$\n\\frac{{x}^{2}}{{1}^{2}}+\\frac{{y}^{2}}{{2}^{2}}=1\\,⟹\\,{x}^{2}+\\frac{{y}^{2}}{4}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+\\frac{{y}^{2}}{4}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(\\frac{{y}^{2}}{4}) & =0 \\\\ 2x+\\frac{2y}{4}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{y}{2}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{4x}{y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317217 :knowledge-point/_questions [{:db/id #edb/ref 17592186166867 :knowledge-point/id #uuid "53a1649d-4279-5b7c-839c-728f333b2c3f" :knowledge-point/title "Calculating the Slope of the Tangent to a Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ce1afa-8b88-5a8a-8cdc-4e464a1bb102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6y}" :db/id #edb/ref 17592186315162}] :answer-field/correct {:answer/id #uuid "08ce1afa-8b88-5a8a-8cdc-4e464a1bb102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6y}" :db/id #edb/ref 17592186315162} :answer-field/id #uuid "4ad31bfe-fcf5-5162-a8e6-4281f1f124b2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316722}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "28f921c8-6fd7-5d79-b2ff-0d1df567197f" :question/math-academy-id "q-342215" :question/problem "![](images/c4/c403f11093b76facafbecb72bcc413640ac67fe6ed73d6b64374230f39e29aba.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the left-opening parabola shown above. Express the answer in terms of the variable $y.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(-3,-1).$\n\nThe general equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=-3$ and $y=-1$ into the equation above, we get\n\n$$\n\\begin{aligned}(-1)^{2} & =4p(-3) \\\\ 1 & =-12p \\\\ p & =-\\frac{1}{12}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=-\\frac{1}{3}x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{1}{3}x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{3} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{6y}\\end{aligned}\n$$"}]}
