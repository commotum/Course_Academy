#{[{:activity/first-step {:db/id #edb/ref 17592186084209} :activity/id #uuid "599eb266-615f-5404-b22e-4ae2f5fb387a" :activity/scope {:db/id #edb/ref 17592186050529 :topic/id #uuid "508d3e6c-0cb1-59bd-b93a-329774355507" :topic/math-academy-id 689} :activity/steps [{:db/id #edb/ref 17592186084209 :step/content {:db/id #edb/ref 17592186084397 :tutorial/content "A repeating decimal can be expressed as a geometric series whose common ratio is a power of\n\n$$\n\\dfrac 1 {10}\n$$\n\nFor example, the number $0.\\overline{8}$ can be expressed as\n\n$$\n\\begin{aligned}\n0.8^(―) &= 0.8 + 0.08 + 0.008 + … \\\\\n&= \\frac{8}{10} + \\frac{8}{100} + \\frac{8}{1000} + …\n\\end{aligned}\n$$\n\nWe have\n\n$$\na_1 = \\dfrac{8}{10}\n$$\n\nand\n\n$$\nr = \\dfrac {0.08}{0.8} = \\dfrac 1 {10}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n0.8^(―) &= ∑_(n = 1)^(∞)a_{1}r^{n - 1} \\\\\n&= ∑_(n = 1)^(∞)\\frac{8}{10}(\\frac{1}{10})^{n - 1} \\\\\n&= ∑_(n = 1)^(∞)8 \\cdot \\frac{1}{10} \\cdot (\\frac{1}{10})^{n} \\cdot (\\frac{1}{10})^{-1} \\\\\n&= ∑_(n = 1)^(∞)8 \\cdot \\frac{1}{10} \\cdot (\\frac{1}{10})^{n} \\cdot (\\frac{1}{10})^{-1} \\\\\n&= ∑_(n = 1)^(∞)8 \\cdot \\frac{1}{10} \\cdot (\\frac{1}{10})^{n} \\cdot 10 \\\\\n&= ∑_(n = 1)^(∞)8(\\frac{1}{10})^{n}\n\\end{aligned}\n$$" :tutorial/id #uuid "3998b477-1c28-5edc-8605-2738ce474d94" :tutorial/math-academy-id 1212 :tutorial/title "Introduction"} :step/id #uuid "d0db37f3-c116-58a6-a33d-41ca478ae931" :step/math-academy-id 2380 :step/next {:db/id #edb/ref 17592186084210}} {:db/id #edb/ref 17592186084210 :step/content {:db/id #edb/ref 17592186083284 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083086 :question/id #uuid "acebcd95-16ed-5087-8d04-0d6d503e31f3" :question/math-academy-id "e-694"} :knowledge-point/id #uuid "367fe9fb-9d92-5105-9959-f3861994aa3c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050286}] :knowledge-point/questions [{:db/id #edb/ref 17592186083792} {:db/id #edb/ref 17592186083793}] :knowledge-point/title "Expressing a Repeating Decimal as an Infinite Geometric Series"} :step/id #uuid "af145878-806f-54bc-991b-28bc9b80cc8a" :step/math-academy-id 2381 :step/next {:db/id #edb/ref 17592186084211}} {:db/id #edb/ref 17592186084211 :step/content {:db/id #edb/ref 17592186083285 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083087 :question/id #uuid "ed24fd0c-69c1-502a-a05f-6e859724214a" :question/math-academy-id "e-695"} :knowledge-point/id #uuid "8813b8a0-3b5e-5cd8-a37d-6b921f2882b8" :knowledge-point/questions [{:db/id #edb/ref 17592186083523} {:db/id #edb/ref 17592186083691} {:db/id #edb/ref 17592186234032}] :knowledge-point/title "Expressing a Repeating Decimal as the Sum of a Number and a Geometric Series"} :step/id #uuid "4af12d7e-248c-5555-bd4c-98e9849f98a8" :step/math-academy-id 2385}] :activity/title "Repeating Decimals as Infinite Geometric Series" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186083401}]}
