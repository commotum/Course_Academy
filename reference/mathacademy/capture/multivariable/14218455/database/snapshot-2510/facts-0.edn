b/ref 17592186046951 #edb/ref 17592186045417] [17592186046645 #edb/ref 1005 #edb/ref 17592186046984 #edb/ref 17592186045417] [17592186046645 #edb/ref 1007 "Calculus II" #edb/ref 17592186045417] [17592186046645 #edb/ref 1008 "Our Calculus II course builds upon the differential calculus covered in Calculus I , providing in-depth coverage of integral calculus including integration techniques, applications of integration. Advanced topics such as series convergence tests, Taylor series, calculus with parametric and polar equations, and introductory differential equations are also covered. This comprehensive course will prepare students for further studies in advanced mathematics, engineering, statistics, machine learning, and other fields requiring a solid foundation in integral calculus." #edb/ref 17592186045417] [17592186046645 #edb/ref 1009 "Further your understanding of calculus: master advanced integration techniques, model real-world situations using differential equations, and more." #edb/ref 17592186045417] [17592186046645 #edb/ref 1012 106 #edb/ref 17592186045417] [17592186046645 #edb/ref 1013 "CA2" #edb/ref 17592186045417] [17592186046645 #edb/ref 1014 #uuid "4965f9cc-fd21-5d50-b441-6e80983b17dd" #edb/ref 17592186045417] [17592186050286 #edb/ref 1027 #edb/ref 17592186048204 #edb/ref 17592186045417] [17592186050286 #edb/ref 1027 #edb/ref 17592186050529 #edb/ref 17592186045417] [17592186050286 #edb/ref 1027 #edb/ref 17592186050868 #edb/ref 17592186045417] [17592186050286 #edb/ref 1028 #edb/ref 17592186083282 #edb/ref 17592186045417] [17592186050286 #edb/ref 1028 #edb/ref 17592186083283 #edb/ref 17592186045417] [17592186050286 #edb/ref 1031 "Writing an Infinite Geometric Series in Sigma Notation" #edb/ref 17592186045417] [17592186050286 #edb/ref 1033 686 #edb/ref 17592186045417] [17592186050286 #edb/ref 1035 #uuid "3d2565fe-3398-554f-a31a-0bf45334348f" #edb/ref 17592186045417] [17592186050529 #edb/ref 1028 #edb/ref 17592186083284 #edb/ref 17592186045417] [17592186050529 #edb/ref 1028 #edb/ref 17592186083285 #edb/ref 17592186045417] [17592186050529 #edb/ref 1031 "Repeating Decimals as Infinite Geometric Series" #edb/ref 17592186045417] [17592186050529 #edb/ref 1033 689 #edb/ref 17592186045417] [17592186050529 #edb/ref 1035 #uuid "508d3e6c-0cb1-59bd-b93a-329774355507" #edb/ref 17592186045417] [17592186081077 #edb/ref 1075 #edb/ref 17592186529610 #edb/ref 17592186045417] [17592186081077 #edb/ref 1075 #edb/ref 17592186529653 #edb/ref 17592186045417] [17592186081077 #edb/ref 1075 #edb/ref 17592186529669 #edb/ref 17592186045417] [17592186081077 #edb/ref 1075 #edb/ref 17592186529962 #edb/ref 17592186045417] [17592186081077 #edb/ref 1075 #edb/ref 17592186530193 #edb/ref 17592186045417] [17592186081077 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186081077 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186081077 #edb/ref 1078 #edb/ref 17592186530193 #edb/ref 17592186045417] [17592186081077 #edb/ref 1079 #uuid "7ef4297c-0c05-56d2-a418-f8b435501b80" #edb/ref 17592186045417] [17592186083086 #edb/ref 1069 "e-694" #edb/ref 17592186045417] [17592186083086 #edb/ref 1071 "Write $0.\\overline{23}$ as geometric series." #edb/ref 17592186045417] [17592186083086 #edb/ref 1072 #uuid "acebcd95-16ed-5087-8d04-0d6d503e31f3" #edb/ref 17592186045417] [17592186083086 #edb/ref 1074 "The given repeating decimal can be written as \n\n$$\n0.\\overline{23} = 0.23 + 0.002\\,3 + 0.000\\,023 + \\dots\n$$\n\n$$\n0.\\overline{23} = \\dfrac{23}{100} + \\dfrac{23}{10\\,000} + \\dfrac{23}{1\\,000\\,000}+\\dots\n$$\n\nwhere the first term is $a_1 = \\dfrac{23}{100}$ and the common ratio is $\\dfrac{1}{100}.$ Therefore,\n\n$$\n\\begin{aligned}0.\\overset{―}{23} & ={\\sum }_{n=1}^{\\infty }{a}_{1}{r}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{23}{100}\\cdot {(\\frac{1}{100})}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }23\\cdot \\frac{1}{100}\\cdot {(\\frac{1}{100})}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }23\\cdot \\frac{1}{100}\\cdot {(\\frac{1}{100})}^{n}\\cdot {(\\frac{1}{100})}^{-1} \\\\  & ={\\sum }_{n=1}^{\\infty }23{(\\frac{1}{100})}^{n}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186083087 #edb/ref 1069 "e-695" #edb/ref 17592186045417] [17592186083087 #edb/ref 1071 "Write $0.1\\overline{4}$ as geometric series." #edb/ref 17592186045417] [17592186083087 #edb/ref 1072 #uuid "ed24fd0c-69c1-502a-a05f-6e859724214a" #edb/ref 17592186045417] [17592186083087 #edb/ref 1074 "The given repeating decimal can be written as \n\n$$\n\\begin{aligned}0.1\\overset{―}{4} & =0.144\\,4... \\\\  & =0.1+0.04+0.004+0.000\\,4+… \\\\  & =\\frac{1}{10}+(\\frac{4}{100}+\\frac{4}{1000}+\\frac{4}{10\\,000}+…).\\end{aligned}\n$$\n\nThe series in the parentheses is a geometric series with the first term $a_1 = \\dfrac{4}{100}$ and the common ratio $r=\\dfrac{1}{10}.$ Therefore,\n\n$$\n\\begin{aligned}0.1\\overset{―}{4} & =\\frac{1}{10}+{\\sum }_{n=1}^{\\infty }{a}_{1}{r}^{n-1} \\\\  & =\\frac{1}{10}+{\\sum }_{n=1}^{\\infty }\\frac{4}{100}{(\\frac{1}{10})}^{n-1} \\\\  & =\\frac{1}{10}+{\\sum }_{n=1}^{\\infty }\\frac{4\\cdot 10}{100}{(\\frac{1}{10})}^{n} \\\\  & =\\frac{1}{10}+{\\sum }_{n=1}^{\\infty }\\frac{4}{10}{(\\frac{1}{10})}^{n}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186083284 #edb/ref 1037 #edb/ref 17592186050286 #edb/ref 17592186045417] [17592186083284 #edb/ref 1038 #edb/ref 17592186083792 #edb/ref 17592186045417] [17592186083284 #edb/ref 1038 #edb/ref 17592186083793 #edb/ref 17592186045417] [17592186083284 #edb/ref 1038 #edb/ref 17592186530453 #edb/ref 17592186045417] [17592186083284 #edb/ref 1038 #edb/ref 17592186530477 #edb/ref 17592186045417] [17592186083284 #edb/ref 1038 #edb/ref 17592186530485 #edb/ref 17592186045417] [17592186083284 #edb/ref 1038 #edb/ref 17592186530507 #edb/ref 17592186045417] [17592186083284 #edb/ref 1038 #edb/ref 17592186530533 #edb/ref 17592186045417] [17592186083284 #edb/ref 1039 "Expressing a Repeating Decimal as an Infinite Geometric Series" #edb/ref 17592186045