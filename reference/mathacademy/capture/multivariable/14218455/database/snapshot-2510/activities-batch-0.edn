#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186084209} :activity/id #uuid "599eb266-615f-5404-b22e-4ae2f5fb387a" :activity/scope {:db/id #edb/ref 17592186050529 :topic/id #uuid "508d3e6c-0cb1-59bd-b93a-329774355507" :topic/math-academy-id 689} :activity/steps [{:db/id #edb/ref 17592186084209 :step/content {:db/id #edb/ref 17592186084397 :tutorial/content "A repeating decimal can be expressed as a geometric series whose common ratio is a power of $\\dfrac 1 {10}.$\n\nFor example, the number $0.\\overline{8}$ can be expressed as \n![](images/03/03acd5b86ea1c8f214f08482c17a8631bd8d55754d4e5ddd974fa17a9ac9cb02.svg)\nWe have $a_1 = \\dfrac{8}{10}$ and $r = \\dfrac {0.08}{0.8} = \\dfrac 1 {10}.$ Therefore,\n\n$$\n\\begin{aligned}0.\\overset{―}{8} & ={\\sum }_{n=1}^{\\infty }{a}_{1}{r}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{8}{10}{(\\frac{1}{10})}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }8\\cdot \\frac{1}{10}\\cdot {(\\frac{1}{10})}^{n}\\cdot {(\\frac{1}{10})}^{-1} \\\\  & ={\\sum }_{n=1}^{\\infty }8\\cdot \\frac{1}{10}\\cdot {(\\frac{1}{10})}^{n}\\cdot {(\\frac{1}{10})}^{-1} \\\\  & ={\\sum }_{n=1}^{\\infty }8\\cdot \\frac{1}{10}\\cdot {(\\frac{1}{10})}^{n}\\cdot 10 \\\\  & ={\\sum }_{n=1}^{\\infty }8{(\\frac{1}{10})}^{n}.\\end{aligned}\n$$" :tutorial/id #uuid "3998b477-1c28-5edc-8605-2738ce474d94" :tutorial/math-academy-id 1212 :tutorial/title "Introduction"} :step/id #uuid "d0db37f3-c116-58a6-a33d-41ca478ae931" :step/math-academy-id 2380 :step/next {:db/id #edb/ref 17592186084210}} {:db/id #edb/ref 17592186084210 :step/content {:db/id #edb/ref 17592186083284 :knowledge-point/canonical-example {:db/id #edb/ref 17592186083086 :question/id #uuid "acebcd95-16ed-5087-8d04-0d6d503e31f3" :question/math-academy-id "e-694"} :knowledge-point/id #uuid "367fe9fb-9d92-5105-9959-f3861994aa3c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050286}] :knowledge-point/questions [{:db/id #edb/ref 17592186083792} {:db/id #edb/ref 175