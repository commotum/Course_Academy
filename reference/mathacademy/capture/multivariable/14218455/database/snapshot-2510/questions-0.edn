#{[{:db/id #edb/ref 17592186083086 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083284 :knowledge-point/id #uuid "367fe9fb-9d92-5105-9959-f3861994aa3c" :knowledge-point/title "Expressing a Repeating Decimal as an Infinite Geometric Series"}] :question/id #uuid "acebcd95-16ed-5087-8d04-0d6d503e31f3" :question/math-academy-id "e-694" :question/problem "Write $0.\\overline{23}$ as geometric series." :question/worked-solution "The given repeating decimal can be written as \n\n$$\n0.\\overline{23} = 0.23 + 0.002\\,3 + 0.000\\,023 + \\dots\n$$\n\n$$\n0.\\overline{23} = \\dfrac{23}{100} + \\dfrac{23}{10\\,000} + \\dfrac{23}{1\\,000\\,000}+\\dots\n$$\n\nwhere the first term is $a_1 = \\dfrac{23}{100}$ and the common ratio is $\\dfrac{1}{100}.$ Therefore,\n\n$$\n\\begin{aligned}0.\\overset{―}{23} & ={\\sum }_{n=1}^{\\infty }{a}_{1}{r}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{23}{100}\\cdot {(\\frac{1}{100})}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }23\\cdot \\frac{1}{100}\\cdot {(\\frac{1}{100})}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }23\\cdot \\frac{1}{100}\\cdot {(\\frac{1}{100})}^{n}\\cdot {(\\frac{1}{100})}^{-1} \\\\  & ={\\sum }_{n=1}^{\\infty }23{(\\frac{1}{100})}^{n}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083087 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186083285 :knowledge-point/id #uuid "8813b8a0-3b5e-5cd8-a37d-6b921f2882b8" :knowledge-point/title "Expressing a Repeating Decimal as the Sum of a Number and a Geometric Series"}] :question/id #uuid "ed24fd0c-69c1-502a-a05f-6e859724214a" :question/math-academy-id "e-695" :question/problem "Write $0.1\\overline{4}$ as geometric series." :question/worked-solution "The given repeating decimal can be written as \n\n$$\n\\begin{aligned}0.1\\overset{―}{4} & =0.144\\,4... \\\\  & =0.1+0.04+0.004+0.000\\,4+… \\\\  & =\\frac{1}{10}+(\\frac{4}{100}+\\frac{4}{1000}+\\frac{4}{10\\,000}+…).\\end{aligned}\n$$\n\nThe series in the parentheses is a geometric series with the first term $a_1 = \\dfrac{4}{100}$ and the common ratio $r=\\dfrac{1}{10}.$ Therefore,\n\n$$\n\\begin{aligned}0.1\\overset{―}{4} & =\\frac{1}{10}+{\\sum }_{n=1}^{\\infty }{a}_{1}{r}^{n-1} \\\\  & =\\frac{1}{10}+{\\sum }_{n=1}^{\\infty }\\frac{4}{100}{(\\frac{1}{10})}^{n-1} \\\\  & =\\frac{1}{10}+{\\sum }_{n=1}^{\\infty }\\frac{4\\cdot 10}{100}{(\\frac{1}{10})}^{n} \\\\  & =\\frac{1}{10}+{\\sum }_{n=1}^{\\infty }\\frac{4}{10}{(\\frac{1}{10})}^{n}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530431 :knowledge-point/_questions [{:db/id #edb/ref 17592186083285 :knowledge-point/id #uuid "8813b8a0-3b5e-5cd8-a37d-6b921f2882b8" :knowledge-point/title "Expressing a Repeating Decimal as the Sum of a Number and a Geometric Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f341c83-40a1-51c8-a948-eca000c145ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+{\\sum }_{n=1}^{\\infty }7{(\\frac{1}{100})}^{n}" :db/id #edb/ref 17592186529682} {:answer/id #uuid "4f633459-3d49-5dae-91c2-c677b7f99e15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+{\\sum }_{n=1}^{\\infty }7{(\\frac{1}{100})}^{n}" :db/id #edb/ref 17592186529771} {:answer/id #uuid "d35c6ff9-930c-5ef8-91d5-af70c973c0a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+{\\sum }_{n=1}^{\\infty }\\frac{1}{7}{(\\frac{1}{10})}^{n}" :db/id #edb/ref 17592186530110} {:answer/id #uuid "d4d421d5-51de-5a32-811b-45d752d21a36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7+{\\sum }_{n=1}^{\\infty }\\frac{1}{3}{(\\frac{1}{10})}^{n}" :db/id #edb/ref 17592186530112} {:answer/id #uuid "de6e0b19-b1eb-5a46-af3b-45dea8fca98f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+{\\sum }_{n=1}^{\\infty }7{(\\frac{1}{10})}^{n}" :db/id #edb/ref 17592186530135}] :answer-field/correct {:answer/id #uuid "de6e0b19-b1eb-5a46-af3b-45dea8fca98f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+{\\sum }_{n=1}^{\\infty }7{(\\frac{1}{10})}^{n}" :db/id #edb/ref 17592186530135} :answer-field/id #uuid "62d66ce1-cb4b-511c-ad96-64a90b9a6b51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186530292}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1bafea49-a0df-5bff-bc08-39fb7ee3f6d7" :question/math-academy-id "q-103290" :question/problem "$3.\\overset{―}{7}=$" :question/worked-solution "The given repeating decimal can be expressed as\n\n$$\n\\begin{aligned}3.\\overset{―}{7} & =3.777… \\\\  & =3+0.7+0.07+0.007+… \\\\  & =3+(\\frac{7}{10}+\\frac{7}{100}+\\frac{7}{1\\,000}+…).\\end{aligned}\n$$\n\nThe series in the parentheses is a geometric series with first term ${a}_{1}=\\frac{7}{10}$ and common ratio $r=\\frac{1}{10}.$ Therefore,\n\n$$\n\\begin{aligned}3.\\overset{―}{7} & =3+{\\sum }_{n=1}^{\\infty }{a}_{1}{r}^{n-1} \\\\  & =3+{\\sum }_{n=1}^{\\infty }\\frac{7}{10}{(\\frac{1}{10})}^{n-1} \\\\  & =3+{\\sum }_{n=1}^{\\infty }7(\\frac{1}{10}){(\\frac{1}{10})}^{n-1} \\\\  & =3+{\\sum }_{n=1}^{\\infty }7{(\\frac{1}{10})}^{n}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530485 :knowledge-point/_questions [{:db/id #edb/ref 17592186083284 :knowledge-point/id #uuid "367fe9fb-9d92-5105-9959-f3861994aa3c" :knowledge-point/title "Expressing a Repeating Decimal as an Infinite Geometric Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4501e66c-e936-5828-bdbf-7fc69696d45b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{\\infty }75{(\\frac{1}{1\\,000})}^{n}" :db/id #edb/ref 17592186529741} {:answer/id #uuid "4f2423a1-6aa1-554e-9ac3-fa0e7e8a1303" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/