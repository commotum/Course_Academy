m }_{n=1}^{\\infty }{a}_{1}{r}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{75}{100}{(\\frac{1}{100})}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }75(\\frac{1}{100}){(\\frac{1}{100})}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }75{(\\frac{1}{100})}^{n}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186530453 :knowledge-point/_questions [{:db/id #edb/ref 17592186083284 :knowledge-point/id #uuid "367fe9fb-9d92-5105-9959-f3861994aa3c" :knowledge-point/title "Expressing a Repeating Decimal as an Infinite Geometric Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f9e5a1d-3f4a-5463-86bd-0a7d49d5ac4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "300" :db/id #edb/ref 17592186529810}] :answer-field/correct {:answer/id #uuid "5f9e5a1d-3f4a-5463-86bd-0a7d49d5ac4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "300" :db/id #edb/ref 17592186529810} :answer-field/id #uuid "042655a5-af48-5ad5-8a8e-790078669a6e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530217} {:answer-field/choices [{:answer/id #uuid "9ffdcfd8-bb52-5ed3-b6b0-c9aba03c3e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{100}" :db/id #edb/ref 17592186529976}] :answer-field/correct {:answer/id #uuid "9ffdcfd8-bb52-5ed3-b6b0-c9aba03c3e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{100}" :db/id #edb/ref 17592186529976} :answer-field/id #uuid "34435d1f-0b9d-51d1-a200-90903e9fb178" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186530260}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4eef4f5e-6db7-5b25-85cf-e831027c6756" :question/math-academy-id "q-351710" :