#{[{:activity/first-step {:db/id #edb/ref 17592186167733} :activity/id #uuid "193c6c55-9c5f-534c-a4fd-3813e9a5ca50" :activity/scope {:db/id #edb/ref 17592186050888 :topic/id #uuid "6e5e65de-23e7-594c-bf7e-0dbcc93f4656" :topic/math-academy-id 3261} :activity/steps [{:db/id #edb/ref 17592186167630 :step/content {:db/id #edb/ref 17592186166795 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166633 :question/id #uuid "2281e86d-4f21-53da-b6fa-1f178d4862a5" :question/math-academy-id "e-8433"} :knowledge-point/id #uuid "1df2e164-251d-5ea1-a49a-fe5bc8d67ae6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048717} {:db/id #edb/ref 17592186048878}] :knowledge-point/questions [{:db/id #edb/ref 17592186167408} {:db/id #edb/ref 17592186167409}] :knowledge-point/title "Integrating a Function Using the Hyperbolic Pythagorean Identity"} :step/id #uuid "e99f7bb7-2c5d-59b4-aebb-4a77afde4a43" :step/math-academy-id 31414 :step/next {:db/id #edb/ref 17592186167734}} {:db/id #edb/ref 17592186167631 :step/content {:db/id #edb/ref 17592186166796 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166634 :question/id #uuid "9b63d35a-f1c5-554f-ac4c-68d18afa153a" :question/math-academy-id "e-8434"} :knowledge-point/id #uuid "97c01757-f2bf-5b7b-b51b-ff490b54f555" :knowledge-point/questions [{:db/id #edb/ref 17592186167410} {:db/id #edb/ref 17592186167411}] :knowledge-point/title "Integrating a Function Using the Hyperbolic Secant-Tangent Identity"} :step/id #uuid "e2ca22ef-592a-5048-ab56-3633a1be0db3" :step/math-academy-id 31415 :step/next {:db/id #edb/ref 17592186167632}} {:db/id #edb/ref 17592186167632 :step/content {:db/id #edb/ref 17592186166797 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166635 :question/id #uuid "7af9f5f6-1e14-55ea-8a09-25d211cb40d8" :question/math-academy-id "e-8435"} :knowledge-point/id #uuid "a5f377f3-700a-57a9-96e5-954aed678e62" :knowledge-point/questions [{:db/id #edb/ref 17592186167412} {:db/id #edb/ref 17592186167413}] :knowledge-point/title "Integrating a Function Using the Hyperbolic Cosecant-Cotangent Identity"} :step/id #uuid "e260970c-9980-5233-ab9d-73344e2691fa" :step/math-academy-id 31416 :step/next {:db/id #edb/ref 17592186167633}} {:db/id #edb/ref 17592186167633 :step/content {:db/id #edb/ref 17592186166798 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166636 :question/id #uuid "14733493-2ad9-5fc2-9afe-26384f6ce9ed" :question/math-academy-id "e-8436"} :knowledge-point/id #uuid "a95e37c6-66f4-5a70-87e8-31f3694a20a4" :knowledge-point/questions [{:db/id #edb/ref 17592186167414} {:db/id #edb/ref 17592186167415} {:db/id #edb/ref 17592186527994}] :knowledge-point/title "Integrating Hyperbolic Functions With Linear Arguments"} :step/id #uuid "35e1d4ff-896a-599d-bb79-ecb5cec36df6" :step/math-academy-id 31417} {:db/id #edb/ref 17592186167733 :step/content {:db/id #edb/ref 17592186168118 :tutorial/content "We can compute integrals containing hyperbolic functions using the hyperbolic counterparts of the Pythagorean identity. We use Osborn's rule to convert a trigonometric identity to a corresponding hyperbolic identity.\n\nOsborn's rule states that to convert a trigonometric identity to a corresponding hyperbolic identity, we\n\n- replace every trigonometric function with its corresponding hyperbolic function, and\n- for any product of two trigonometric sines, change the sign of the corresponding product of hyperbolic sines.\n\n$$\n\\displaystyle \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nFor example, suppose we want to calculate the following integral:\n\n$$\n\\int \\cosh^2{x} - \\sinh^2{x} \\: \\textrm{d}x\n$$\n\nFirst, we recall the Pythagorean identity\n\n$$\n\\cos^2{x} + \\sin^2{x} = 1\n$$\n\nUsing Osborn's rule, we get the corresponding hyperbolic identity\n\n$$\n\\cosh^2{x} - \\sinh^2{x} = 1\n$$\n\nTherefore, we evaluate our integral as follows:\n\n$$\n\\int\\cosh^{2} x - \\sinh^{2} x_(⏟)_(1)dx = \\int1dx = x + C\n$$\n\nLet's see another example." :tutorial/id #uuid "250a3423-70a4-5d38-9b0f-6f801a0479d1" :tutorial/math-academy-id 5553 :tutorial/title "Introduction"} :step/id #uuid "1283c2a5-d791-5099-bd72-546a74c8f4b8" :step/math-academy-id 34427 :step/next {:db/id #edb/ref 17592186167630}} {:db/id #edb/ref 17592186167734 :step/content {:db/id #edb/ref 17592186168119 :tutorial/content "$$\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nWe can use Osborn's rule to write down the hyperbolic equivalents of the sectant-tangent and cotangent-cosecant identities.\n\nFrom the secant-tangent identity\n\n$$\n1 + \\tan^2 x = \\sec^2 x\n$$\n\nwe have the equivalent hyperbolic identity\n\n$$\n1 - \\tanh^2 x = \\sech^2 x\n$$\n\nSimilarly, from the cotangent-cosecant identity\n\n$$\n1+\\cot^2 x = \\csc^2 x\n$$\n\nwe have the equivalent hyperbolic identity\n\n$$\n1-\\coth^2 x = -\\csch^2 x\n$$\n\nwhich we can rewrite as\n\n$$\n\\coth^2 x - 1 = \\csch^2 x\n$$\n\nThese identities can be used to solve certain integrals involving the expressions $\\tanh^2{x}$, $\\coth^2 x$, $\\sech^2 x$, or $\\csch^2{x}$." :tutorial/id #uuid "525b90c4-f6ea-5c55-8602-49547e261df1" :tutorial/math-academy-id 5554 :tutorial/title "Calculating Integrals Using Related Hyperbolic Identities"} :step/id #uuid "ec6b416a-7645-5f7b-b41d-c553c9f1a62b" :step/math-academy-id 34428 :step/next {:db/id #edb/ref 17592186167631}}] :activity/title "Integration Using the Hyperbolic Pythagorean Identities" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186167027}]}
