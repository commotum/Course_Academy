db/ref 17592186193022 #edb/ref 17592186045417] [17592186192712 #edb/ref 1038 #edb/ref 17592186193068 #edb/ref 17592186045417] [17592186192712 #edb/ref 1039 "Approximating Volumes of Revolution" #edb/ref 17592186045417] [17592186192712 #edb/ref 1041 #edb/ref 17592186192420 #edb/ref 17592186045417] [17592186192712 #edb/ref 1042 #uuid "ea7448d8-a235-52f4-a475-006943f8a142" #edb/ref 17592186045417] [17592186192870 #edb/ref 1043 #edb/ref 17592186193530 #edb/ref 17592186045417] [17592186192870 #edb/ref 1043 #edb/ref 17592186193531 #edb/ref 17592186045417] [17592186192870 #edb/ref 1043 #edb/ref 17592186193532 #edb/ref 17592186045417] [17592186192870 #edb/ref 1043 #edb/ref 17592186193533 #edb/ref 17592186045417] [17592186192870 #edb/ref 1043 #edb/ref 17592186193546 #edb/ref 17592186045417] [17592186192870 #edb/ref 1043 #edb/ref 17592186193547 #edb/ref 17592186045417] [17592186192870 #edb/ref 1043 #edb/ref 17592186193694 #edb/ref 17592186045417] [17592186192870 #edb/ref 1043 #edb/ref 17592186193695 #edb/ref 17592186045417] [17592186192870 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186192870 #edb/ref 1045 "Approximating Areas Under Graphs of Composite Functions" #edb/ref 17592186045417] [17592186192870 #edb/ref 1046 #edb/ref 17592186193530 #edb/ref 17592186045417] [17592186192870 #edb/ref 1049 #edb/ref 17592186048304 #edb/ref 17592186045417] [17592186192870 #edb/ref 1053 #uuid "15829972-de8f-5398-aedc-ee127d53c955" #edb/ref 17592186045417] [17592186193530 #edb/ref 1058 #edb/ref 17592186193531 #edb/ref 17592186045417] [17592186193530 #edb/ref 1061 39566 #edb/ref 17592186045417] [17592186193530 #edb/ref 1062 #uuid "1997ebaf-5bad-5fd7-875b-27650eb3f5b6" #edb/ref 17592186045417] [17592186193530 #edb/ref 1063 #edb/ref 17592186193827 #edb/ref 17592186045417] [17592186193531 #edb/ref 1058 #edb/ref 17592186193694 #edb/ref 17592186045417] [17592186193531 #edb/ref 1061 39567 #edb/ref 17592186045417] [17592186193531 #edb/ref 1062 #uuid "99cb3798-47dd-5790-b2f7-fdfbcde6185f" #edb/ref 17592186045417] [17592186193531 #edb/ref 1063 #edb/ref 17592186192700 #edb/ref 17592186045417] [17592186193532 #edb/ref 1058 #edb/ref 17592186193547 #edb/ref 17592186045417] [17592186193532 #edb/ref 1061 39568 #edb/ref 17592186045417] [17592186193532 #edb/ref 1062 #uuid "7001e0a2-bc0e-5f22-adfb-6688e2d5c0c7" #edb/ref 17592186045417] [17592186193532 #edb/ref 1063 #edb/ref 17592186192701 #edb/ref 17592186045417] [17592186193533 #edb/ref 1061 39569 #edb/ref 17592186045417] [17592186193533 #edb/ref 1062 #uuid "d04db767-8034-5d9f-8871-0fb87a4da642" #edb/ref 17592186045417] [17592186193533 #edb/ref 1063 #edb/ref 17592186192702 #edb/ref 17592186045417] [17592186193546 #edb/ref 1058 #edb/ref 17592186193695 #edb/ref 17592186045417] [17592186193546 #edb/ref 1061 39706 #edb/ref 17592186045417] [17592186193546 #edb/ref 1062 #uuid "b9769694-1018-5682-8dd1-facf2627a6f4" #edb/ref 17592186045417] [17592186193546 #edb/ref 1063 #edb/ref 17592186192712 #edb/ref 17592186045417] [17592186193547 #edb/ref 1058 #edb/ref 17592186193533 #edb/ref 17592186045417] [17592186193547 #edb/ref 1061 39707 #edb/ref 17592186045417] [17592186193547 #edb/ref 1062 #uuid "6cc57411-9166-578d-ad5d-18fd5906fee2" #edb/ref 17592186045417] [17592186193547 #edb/ref 1063 #edb/ref 17592186193831 #edb/ref 17592186045417] [17592186193694 #edb/ref 1058 #edb/ref 17592186193546 #edb/ref 17592186045417] [17592186193694 #edb/ref 1061 44209 #edb/ref 17592186045417] [17592186193694 #edb/ref 1062 #uuid "5ed00cb2-4d94-5a81-8e1c-488592b9d60c" #edb/ref 17592186045417] [17592186193694 #edb/ref 1063 #edb/ref 17592186193904 #edb/ref 17592186045417] [17592186193695 #edb/ref 1058 #edb/ref 17592186193532 #edb/ref 17592186045417] [17592186193695 #edb/ref 1061 44210 #edb/ref 17592186045417] [17592186193695 #edb/ref 1062 #uuid "4da87fab-f669-5510-93d3-55fea59cbf65" #edb/ref 17592186045417] [17592186193695 #edb/ref 1063 #edb/ref 17592186193905 #edb/ref 17592186045417] [17592186193827 #edb/ref 1064 "In this lesson, we'll learn how to use Riemann sums to approximate definite integrals of *composite* functions. As we'll see, this has some interesting applications.\n\nFor example, suppose $f(x)$ is a positive, continuous function. Some values for $f(x)$ over the interval $x\\in [1,5]$ are given by the following table:\n\n| $x$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | ---: | ---: | ---: | ---: | ---: |\n| $f(x)$ | $3$ | $2$ | $1$ | $1$ | $2$ |\n\nLet's use this data to approximate the following integral:\n\n$$\n\\int_{1}^{5} x^2 \\cdot f(x) \\,\\textrm{d}x\n$$\n\nTo approximate this definite integral, we first define a new function $g(x)$ as\n\n$$\ng(x) = x^2\\cdot f(x)\n$$\n\nNow, our task is to approximate\n\n$$\n\\int_{1}^{5} g(x) \\,\\textrm{d}x\n$$\n\nLet's approximate this integral using a left Riemann sum with $4$ equal subintervals.\n\nThe (regular) step size $\\Delta x$ is given by\n\n$$\n\\Delta x = \\dfrac{5-1}{4} = 1\n$$\n\nWe can approximate this integral using a left Riemann sum with $4$ equal subintervals and step size $\\Delta x$ as follows:\n\n$$\n\\int_{1}^{5} g(x) \\,\\textrm{d}x \\approx (g(1) + g(2) + g(3) + g(4)) \\cdot \\Delta x\n$$\n\nLet's add a row to our table with values of $g(x)$ at each point:\n\n| $x$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | ---: | ---: | ---: | ---: | ---: |\n| $f(x)$ | $3$ | $2$ | $1$ | $1$ | $2$ |\n| $g(x) = x^2 \\cdot f(x)$ | $3$ | $8$ | $9$ | $16$ | $50$ |\n\nFinally, we obtain the following approximation for our definite integral:\n\n$$\n\\begin{aligned}\nA &= \\int_{1}^{5}g(x)dx \\\\\n&\\approx (3 + 8 + 9 + 16) \\cdot 1 \\\\\n&= 36 \\cdot 1 \\\\\n&= 36\n\\end{aligned}\n$$\n\nLet's now look at an example involving a right Riemann sum." #edb/ref 17592186045417] [17592186193827 #edb/ref 1065 6553 #edb/ref 17592186045417] [17592186193827 #edb/ref 1066 #uuid "c2502b79-d3d8-53e4-be62-b01752a16be9" #edb/ref 17592186045417] [17592186193827 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186193831 #edb/ref 1064 "We've seen how to use Riemann sums to approximate areas under curves of composite functions. Our final task is determining whether these approximations overestimate or underestimate the true areas.\n\nWe start by considering *right* Riemann sums. Recall the following facts:\n\n- If a function is strictly *increasing*, the right Riemann sum *overestimates* the area under the curve $y = g(x)$.\n- If a function is strictly *decreasing*, the right Riemann sum *underestimates* the area under the curve $y = g(x)$.\n\nLet $f(x)$ be positive and strictly increasing for $x \\in [1,2]$, and differentiable for $x \\in (1,2)$. Now, consider the function\n\n$$\ng(x) = x^2 \\cdot f(x)\n$$\n\nSuppose we use a right Riemann sum to approximate the area under the curve $y = g(x)$ over $x\\in [1,2]$. Does the right Riemann sum overestimate or underestimate the true area?\n\nWe note the following:\n\n- Since $f(x)$ is strictly increasing, we have $f'(x) \\gt 0$.\n- Differentiating our expression for $g(x)$ using the product rule, we get\n$g^{′}(x)|= (x^{2})^{′} \\cdot f(x) + x^{2} \\cdot f^{′}(x); = 2x \\cdot f(x) + x^{2} \\cdot f^{′}(x)$.\nWe now examine the sign of each factor in this expression to determine the sign of $g'(x)$.Since $f(x)$ is positive and strictly increasing over the interval $(1,2)$, we have\n$2x \\gt 0, \\qquad f(x) \\gt 0, \\qquad x^2 \\gt 0, \\qquad f'(x) \\gt 0$.\nHence, we obtain\n$g'(x) = \\underbrace{2x}_{\\gt 0} \\cdot \\underbrace{f(x)}_{\\gt 0} + \\underbrace{x^2}_{> 0} \\cdot \\underbrace{f'(x)}_{\\gt 0} = \\underbrace{2x \\cdot f(x)}_{\\gt 0} + \\underbrace{x^2 \\cdot f'(x)}_{\\gt 0} \\gt 0$.\n\nTherefore, since $g'(x) \\gt 0$, the function $g(x)$ is strictly increasing. Therefore, the right Riemann sum *overestimates* the area under the curve $y = g(x)$.\n\nLet's now look at an example involving a left Riemann sum." #edb/ref 17592186045417] [17592186193831 #edb/ref 1065 6582 #edb/ref 17592186045417] [17592186193831 #edb/ref 1066 #uuid "4017a527-6912-5d2d-a92d-3424c1399d67" #edb/ref 17592186045417] [17592186193831 #edb/ref 1067 "Determining Overestimates and Underestimates" #edb/ref 17592186045417] [17592186193904 #edb/ref 1064 "Consider the finite region bounded by the curve $y=f(x)$, the $x$-axis, and the vertical lines $x=a$ and $x=b$, as shown in the picture below.\n\n![](images/59/59f9a4f76889bf4323c7bcf7dad2dd5269698d94f294458eafdd4c5da0fa0580.png)\n\nWhen we rotate this region $360^\\circ$ about the $x$-axis (called the **axis of revolution**), we get a **solid of revolution,** as shown below.\n\n![](images/fc/fc2858aac81addf1d5c19cd3836361d42de4ce844117ab4d42960e45a274026d.png)\n\nIt can be shown that the volume $V$ of this solid of revolution is given by the formula\n\n$$\nV = \\pi \\int_{a}^{b} y^2 \\:\\textrm{d}x = \\pi \\int_{a}^{b} \\left[ f(x) \\right]^2 \\:\\textrm{d}x\n$$" #edb/ref 17592186045417] [17592186193904 #edb/ref 1065 7613 #edb/ref 17592186045417] [17592186193904 #edb/ref 1066 #uuid "169b0392-4eed-5202-921f-c379f4264c6d" #edb/ref 17592186045417] [17592186193904 #edb/ref 1067 "Volumes of Revolution" #edb/ref 17592186045417] [17592186193905 #edb/ref 1064 "Consider the curve $y=f(x)$ between two points where $x=a$ and $x=b$.\n\n![](images/e7/e7fb3f6e11e0e2b51fc4ecae9827a4e378a7981450775f2b9330057c319688bf.png)\n\nThe length of the curve between these two points is known as the **arc length** of the curve.\n\nIt can be shown that the arc length is given by the formula\n\n$$\nL = \\int_a^b \\sqrt{1+\\left[f'(x)\\right]^2}\\,\\mathrm{d} x\n$$\n\nwhere $f'(x)$ is the derivative of $f(x)$.\n\nWe can use Riemann sums to approximate arc lengths. Let's see an example." #edb/ref 17592186045417] [17592186193905 #edb/ref 1065 7614 #edb/ref 17592186045417] [17592186193905 #edb/ref 1066 #uuid "c6c4aa50-1ce8-52f8-aa97-b2bce6c85623" #edb/ref 17592186045417] [17592186193905 #edb/ref 1067 "Arc Length" #edb/ref 17592186045417] [17592186233097 #edb/ref 1068 #edb/ref 17592186503589 #edb/ref 17592186045417] [17592186233097 #edb/ref 1069 "q-107412" #edb/ref 17592186045417] [17592186233097 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186233097 #edb/ref 1071 "Given that $f(x)=\\frac{2{x}^{2}+3x-2}{4-{x}^{2}},$ which of the following statements is correct?\n\nI. ${lim}_{x\\to {2}^{+}}f(x)=-\\infty $\n\nII. ${lim}_{x\\to (-2)^{+}}f(x)=\\infty $\n\nIII. ${lim}_{x\\to {2}^{-}}f(x)=-\\infty $" #edb/ref 17592186045417] [17592186233097 #edb/ref 1072 #uuid "7e3d6fb3-96ca-598d-b899-4cfc00c51648" #edb/ref 17592186045417] [17592186233097 #edb/ref 1074 "First, let's factor the numerator and denominator:\n\n$$\n\\begin{aligned}f(x) & =\\frac{2{x}^{2}+3x-2}{4-{x}^{2}} \\\\  & =-\\frac{(x+2)(2x-1)}{(x-2)(x+2)}\\end{aligned}\n$$\n\nTherefore, the domain is  $x\\ne \\pm 2,$ and we notice that the function can be simplified:\n\n$$\n\\begin{aligned}f(x)=-\\frac{2x-1}{x-2}.\\end{aligned}\n$$\n\nNow we see that the function has the only vertical asymptote $x=2.$ So statement II is false.\n\nTo find  ${lim}_{x\\to {2}^{+}}f(x)$ and ${lim}_{x\\to {2}^{-}}f(x),$ we evaluate $f(x)$ at $x$-values very close to $x=2$ from the left and right.\n\n| $x$ | $1.99$ | $1.999$ | $2$ | $2.001$ | $2.01$ |\n| --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $298$ | $2\\,998$ | $\\text{undefined}$ | $-3\\,002$ | $-302$ |\n\nAll values are positive and get larger and larger as $x\\to 2$ from the left and all values are negative and get smaller and smaller as $x\\to 2$ from the right . Therefore, \n\n$$\n{lim}_{x\\to {2}^{+}}f(x)=-\\infty \\,{lim}_{x\\to {2}^{-}}f(x)=\\infty \n$$\n\nConsequently, statement I is true and III is false.\n\nIn conclusion, only statement I is correct. A plot of the function is shown below.\n\n![](images/9e/9e96d6a81813c1c89a498d0206234f2685f0a53c1bab626ce7430d84f9c0f506.png)" #edb/ref 17592186045417] [17592186233198 #edb/ref 1068 #edb/ref 17592186250085 #edb/ref 17592186045417] [17592186233198 #edb/ref 1069 "q-113941" #edb/ref 17592186045417] [17592186233198 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186233198 #edb/ref 1071 "What is ${\\int }_{4}^{9}\\sqrt{x}\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" #edb/ref 17592186045417] [17592186233198 #edb/ref 1072 #uuid "de045223-79af-5400-bb3f-2538c755ef59" #edb/ref 17592186045417] [17592186233198 #edb/ref 1074 "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{4}^{9}\\sqrt{x}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\sqrt{x},$ the lower bound is $a=4$ and the upper bound is $b=9.$ So, we have\n\n$$\nΔx=\\frac{9-4}{n}=\\frac{5}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{4}^{9}\\sqrt{x}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(4+k\\cdot \\frac{5}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(4+\\frac{5k}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{4+\\frac{5k}{n}}\\cdot \\frac{5}{n}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186233232 #edb/ref 1068 #edb/ref 17592186503609 #edb/ref 17592186045417] [17592186233232 #edb/ref 1069 "q-116735" #edb/ref 17592186045417] [17592186233232 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186233232 #edb/ref 1071 "![](images/63/63fe9cf3a61a5cef09f9c19e16a18318338faa6837eeb77b83f49b636157bb95.png)\n\nA sphere is decreasing in volume at a rate of $54\\pi \\,{\\text{cm}}^{3}\\text{/s}.$ Calculate the rate at which the radius of the sphere is decreasing at the moment when the radius is $3\\,\\text{cm}.$" #edb/ref 17592186045417] [17592186233232 #edb/ref 1072 #uuid "f2d45e40-2970-570b-ba18-c7ae81412efd" #edb/ref 17592186045417] [17592186233232 #edb/ref 1074 "Let $r$ be the radius of the balloon and $V$ its volume. Both $r$ and $V$ change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=-54\\pi \\,{\\text{cm}}^{3}/\\text{s},\n$$\n\nand we want to find $\\frac{\\text{d}r}{\\text{d}t}$ when $r=3\\,\\text{cm}.$\n\nTo start, let's write down the volume formula for the sphere and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}V & =\\frac{4}{3}\\pi {r}^{3} \\\\ \\frac{\\text{d}}{\\text{d}t}(V) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi {r}^{2}.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}V}{\\text{d}t}=-54\\pi $ and $r=3,$ and solve for $\\frac{\\text{d}r}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}-54\\pi  & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi (3)^{2} \\\\ -54\\pi  & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 36\\pi  \\\\ \\frac{\\text{d}r}{\\text{d}t} & =-1.5.\\end{aligned}\n$$\n\nTherefore, the radius of the sphere is decreasing at a rate of $1.5\\text{ cm/s}$ when the radius is $3\\,\\text{cm}.$" #edb/ref 17592186045417] [17592186233441 #edb/ref 1068 #edb/ref 17592186503590 #edb/ref 17592186045417] [17592186233441 #edb/ref 1069 "q-138848" #edb/ref 17592186045417] [17592186233441 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186233441 #edb/ref 1071 "Consider the function $y=\\sqrt{({x}^{2}+6x){sin}^{2}⁡x}.$  The derivative of this function for $x\\in (0,\\pi )$ is given by\n\n$$\n{y}^{′}=\\frac{g(x)\\operatorname{sin}⁡x+h(x)\\operatorname{cos}⁡x}{\\sqrt{{x}^{2}+6x}}.\n$$\n\nFind the function $g(x)+h(x).$" #edb/ref 17592186045417] [17592186233441 #edb/ref 1072 #uuid "3ac66977-fb7e-55ea-b01a-306cc1fa6e11" #edb/ref 17592186045417] [17592186233441 #edb/ref 1074 "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{({x}^{2}+6x){sin}^{2}⁡x} \\\\  & =\\sqrt{{x}^{2}+6x}\\cdot \\sqrt{{sin}^{2}⁡x} \\\\  & =({x}^{2}+6x)^{1/2}\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the product and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+6x)^{1/2}\\operatorname{sin}⁡x) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+6x)^{1/2})+\\operatorname{ln}⁡(\\operatorname{sin}⁡x) \\\\ \\operatorname{ln}⁡y & =\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+6x)+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+6x)+\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{2}\\cdot \\frac{1}{{x}^{2}+6x}\\cdot (2x+6)+\\frac{1}{\\operatorname{sin}⁡x}\\cdot \\operatorname{cos}⁡x \\\\ \\frac{{y}^{′}}{y} & =\\frac{x+3}{{x}^{2}+6x}+\\operatorname{cot}⁡x\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{x+3}{{x}^{2}+6x}+\\operatorname{cot}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{({x}^{2}+6x){sin}^{2}⁡x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{({x}^{2}+6x){sin}^{2}⁡x}(\\frac{x+3}{{x}^{2}+6x}+\\operatorname{cot}⁡x) \\\\  & =\\sqrt{({x}^{2}+6x){sin}^{2}⁡x}(\\frac{x+3}{{x}^{2}+6x}+\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}) \\\\  & =\\sqrt{({x}^{2}+6x){sin}^{2}⁡x}(\\frac{(x+3)\\operatorname{sin}⁡x+({x}^{2}+6x)\\operatorname{cos}⁡x}{({x}^{2}+6x)\\operatorname{sin}⁡x}) \\\\  & =\\frac{|\\operatorname{sin}⁡x|}{\\operatorname{sin}⁡x}\\frac{(x+3)\\operatorname{sin}⁡x+({x}^{2}+6x)\\operatorname{cos}⁡x}{\\sqrt{{x}^{2}+6x}}\\end{aligned}\n$$\n\n \n\nGiven that $x\\in (0,\\pi ),$ then $|\\operatorname{sin}⁡x|=\\operatorname{sin}⁡x,$ so the fraction $\\frac{|\\operatorname{sin}⁡x|}{\\operatorname{sin}⁡x}$ simplifies to $1:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+3)\\operatorname{sin}⁡x+({x}^{2}+6x)\\operatorname{cos}⁡x}{\\sqrt{{x}^{2}+6x}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)+h(x)=x+3+{x}^{2}+6x={x}^{2}+7x+3.\n$$" #edb/ref 17592186045417] [17592186233510 #edb/ref 1068 #edb/ref 17592186503546 #edb/ref 17592186045417] [17592186233510 #edb/ref 1069 "q-152889" #edb/ref 17592186045417] [17592186233510 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186233510 #edb/ref 1071 "${lim}_{x\\to \\,1/2}\\operatorname{tan}⁡(6\\operatorname{arccos}⁡(x))=$" #edb/ref 17592186045417] [17592186233510 #edb/ref 1072 #uuid "f20a6552-65e3-58b7-b9da-e6bf558e0b66" #edb/ref 17592186045417] [17592186233510 #edb/ref 1074 "![](images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)\n\nThe domain of $\\operatorname{arccos}⁡(x)$ is $x\\in [-1,1].$  \n\nNow, substituting $x=\\frac{1}{2}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1/2}\\operatorname{tan}⁡(6\\operatorname{arccos}⁡(x)) & =\\operatorname{tan}⁡(6\\operatorname{arccos}⁡(\\frac{1}{2})) \\\\  & =\\operatorname{tan}⁡(6\\cdot \\frac{\\pi }{3}) \\\\  & =\\operatorname{tan}⁡(2\\pi ) \\\\  & =0.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186234014 #edb/ref 1068 #edb/ref 17592186503601 #edb/ref 17592186045417] [17592186234014 #edb/ref 1069 "q-38592" #edb/ref 17592186045417] [17592186234014 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186234014 #edb/ref 1071 "Let $f(x)$ be the function defined below. For what value of $k$ is $f(x)$ continuous at $x=-1?$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{k}{x-1}, & x<-1 \\\\ 2x-k, & x\\ge -1\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186234014 #edb/ref 1072 #uuid "d3161c6d-15b1-5502-a086-55781c56e488" #edb/ref 17592186045417] [17592186234014 #edb/ref 1074 "From the definition of $f(x)$, the left-sided limit of $f(x)$ at $x=-1$ is\n\n$$\n\\begin{aligned}{lim}_{x\\to -{1}^{-}}f(x) & ={lim}_{x\\to -{1}^{-}}\\frac{k}{x-1} \\\\  & =\\frac{k}{-1-1} \\\\  & =-\\frac{k}{2}.\\end{aligned}\n$$\n\nOn the other hand, the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to -{1}^{+}}f(x) & ={lim}_{x\\to -{1}^{+}}(2x-k) \\\\  & =2(-1)-k \\\\  & =-2-k.\\end{aligned}\n$$\n\nWe also note that $f(-1)=-2-k.$ \n\nSo, for $f(x)$ to be continuous at $x=-1,$ we must have\n\n$$\n\\begin{aligned}{lim}_{x\\to -{1}^{+}}f(x) & ={lim}_{x\\to -{1}^{-}}f(x) \\\\ -2-k & =-\\frac{k}{2} \\\\ -4-2k & =-k \\\\ k & =-4.\\end{aligned}\n$$\n\nTherefore, $k=-4$ removes the discontinuity at $x=-1.$" #edb/ref 17592186045417] [17592186234076 #edb/ref 1068 #edb/ref 17592186503558 #edb/ref 17592186045417] [17592186234076 #edb/ref 1069 "q-4740" #edb/ref 17592186045417] [17592186234076 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186234076 #edb/ref 1071 "${lim}_{h\\to 0}\\frac{{e}^{2+h}-{e}^{2}}{h}=$" #edb/ref 17592186045417] [17592186234076 #edb/ref 1072 #uuid "ef423eeb-a6a9-5a03-bbd4-f26b7d9971da" #edb/ref 17592186045417] [17592186234076 #edb/ref 1074 "First, we let\n\n$$\nL={lim}_{h\\to 0}\\frac{{e}^{2+h}-{e}^{2}}{h}.\n$$\n\nComparing this with the formula for the instantaneous rate of change\n\n$$\n{f}^{′}(a)={lim}_{h\\to 0}\\frac{f(a+h)-f(a)}{h}.\n$$\n\nWe see that if we let $f(x)={e}^{x}$ and $a=2$, we get\n\n$$\n\\begin{aligned}{f}^{′}(2) & ={lim}_{h\\to 0}\\frac{f(2+h)-f(2)}{h} \\\\  & ={lim}_{h\\to 0}\\frac{{e}^{2+h}-{e}^{2}}{h}=L.\\end{aligned}\n$$\n\nThis confirms that $L={f}^{′}(2).$  \n\nComputing the derivative, we have\n \n\n$$\n{f}^{′}(x)={e}^{x},\\,{f}^{′}(2)={e}^{2},\n$$\n\nand therefore we conclude tha $L={e}^{2}.$" #edb/ref 17592186045417] [17592186234079 #edb/ref 1068 #edb/ref 17592186503556 #edb/ref 17592186045417] [17592186234079 #edb/ref 1069 "q-47501" #edb/ref 17592186045417] [17592186234079 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186234079 #edb/ref 1071 "Anna decides to go jogging. Her position from the starting point, measured in meters, is given by the function $s(t),$ where $t$ is the time in seconds. The values of $s(t)$ for different values of $t$ are given in the table below:\n\n| **$t$** | $1$ | $3$ | $5$ | $7$ | $9$ | $11$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $s(t)$ | $1$ | $2$ | $4$ | $6$ | $14$ | $25$ |\n\n$$\n\n$$\n\nApproximate the velocity ${s}^{′}(t)$ at the point $t=7$ using a central difference approximation with the step size $h=2.$" #edb/ref 17592186045417] [17592186234079 #edb/ref 1072 #uuid "fa4f2b60-2a66-5f4f-a213-69e38a19fcc6" #edb/ref 17592186045417] [17592186234079 #edb/ref 1074 "We use the central difference approximation\n\n$$\n{s}^{′}(t)≈\\frac{s(t+h)-s(t-h)}{2h},\n$$\n\n \nat the time $t=7$ with step size $h=2.$ This gives\n\n$$\n\\begin{aligned}{s}^{′}(7) & ≈\\frac{s(7+2)-s(7-2)}{2(2)} \\\\  & =\\frac{s(9)-s(5)}{2(2)} \\\\  & =\\frac{14-4}{4} \\\\  & =\\frac{10}{4} \\\\  & =2.5.\\end{aligned}\n$$\n\nThus, the velocity of Anna at the instant of time $t=7$ is $2.5\\,\\text{m}/\\text{s}.$" #edb/ref 17592186045417] [17592186234323 #edb/ref 1068 #edb/ref 17592186503525 #edb/ref 17592186045417] [17592186234323 #edb/ref 1069 "q-72361" #edb/ref 17592186045417] [17592186234323 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186234323 #edb/ref 1071 "The functions $f(x)$ and $g(x)$ are twice-differentiable on an open interval containing $x=1.$ The values of $f,$ $g,$ and their respective derivatives are given below:\n\n| $x$ | $f(x)$ | ${f}^{′}(x)$ | ${f}^{″}(x)$ | $g(x)$ | ${g}^{′}(x)$ | ${g}^{″}(x)$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $-1$ | $4$ | $1$ | $1$ | $-2$ |\n\n$$\n\n$$\n\nFind ${lim}_{x\\to 1}\\frac{f(x)+x}{g(x)-x}.$" #edb/ref 17592186045417] [17592186234323 #edb/ref 1072 #uuid "fed62691-6668-5c74-90ca-07c937644bed" #edb/ref 17592186045417] [17592186234323 #edb/ref 1074 "Notice that if we try to substitute $x=1$ directly into the limit, we reach the indeterminate form $\\frac{0}{0}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{f(x)+x}{g(x)-x} & ={\\frac{f(x)+x}{g(x)-x}|}_{x=1} \\\\  & =\\frac{f(1)+1}{g(1)-1} \\\\  & =\\frac{-1+1}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we use L'Hopital's rule:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{f(x)+x}{g(x)-x} & ={lim}_{x\\to 1}\\frac{(f(x)+x)^{′}}{(g(x)-x)^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{{f}^{′}(x)+1}{{g}^{′}(x)-1}\\end{aligned}\n$$\n\nWe substitute $x=1$ again, but once more, we reach the indeterminate form $\\frac{0}{0}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{f}^{′}(x)+1}{{g}^{′}(x)-1} & ={\\frac{{f}^{′}(x)+1}{{g}^{′}(x)-1}|}_{x=1} \\\\  & =\\frac{{f}^{′}(1)+1}{{g}^{′}(1)-1} \\\\  & =\\frac{-1+1}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nWe apply L'Hopital's rule again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{f}^{′}(x)+1}{{g}^{′}(x)-1} & ={lim}_{x\\to 1}\\frac{({f}^{′}(x)+1)^{′}}{({g}^{′}(x)-1)^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{{f}^{″}(x)}{{g}^{″}(x)},\\end{aligned}\n$$\n\nand this time, when we substitute $x=1,$ we are actually able to determine the result:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{f}^{″}(x)}{{g}^{″}(x)} & ={\\frac{{f}^{″}(x)}{{g}^{″}(x)}|}_{x=1} \\\\  & =\\frac{{f}^{″}(1)}{{g}^{″}(1)} \\\\  & =\\frac{4}{-2} \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, ${lim}_{x\\to 1}\\frac{f(x)+x}{g(x)-x}=-2.$" #edb/ref 17592186045417] [17592186234351 #edb/ref 1068 #edb/ref 17592186503528 #edb/ref 17592186045417] [17592186234351 #edb/ref 1069 "q-73427" #edb/ref 17592186045417] [17592186234351 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186234351 #edb/ref 1071 "Find all of the points where the function $f(x)=\\frac{{x}^{2}+3x}{{x}^{2}+4x+3}$ has discontinuities due to vertical asymptotes." #edb/ref 17592186045417] [17592186234351 #edb/ref 1072 #uuid "e3cc6eed-e52f-5a0b-bc51-e9a47cb4eee9" #edb/ref 17592186045417] [17592186234351 #edb/ref 1074 "To find the vertical asymptotes, let's start by factoring the expressions in the numerator and denominator. This gives\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}+3x}{{x}^{2}+4x+3} \\\\  & =\\frac{x(x+3)}{(x+1)(x+3)} \\\\  & =\\frac{x\\cancel{(x+3)}}{(x+1)\\cancel{(x+3)}} \\\\  & =\\frac{x}{x+1}.\\end{aligned}\n$$\n\nTo find the vertical asymptotes, we set the denominator equal to zero and solve:\n\n$$\nx+1=0\\,⟹\\,x=-1\n$$\n\nTherefore, the function has a discontinuity due to a vertical asymptote at $x=-1$ only." #edb/ref 17592186045417] [17592186234352 #edb/ref 1068 #edb/ref 17592186503542 #edb/ref 17592186045417] [17592186234352 #edb/ref 1069 "q-73492" #edb/ref 17592186045417] [17592186234352 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186234352 #edb/ref 1071 "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}\\operatorname{sin}⁡x, & x\\le 0 \\\\ \\operatorname{ln}⁡x, & x>0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nI. $[-2,-1]$\n\nII. $[-1,1]$\n\nIII. $(0,1]$" #edb/ref 17592186045417] [17592186234352 #edb/ref 1072 #uuid "bf7b7ef5-50f5-5f18-b878-7ff1f9484b60" #edb/ref 17592186045417] [17592186234352 #edb/ref 1074 "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- First, consider $[-2,-1].$ In this interval, $f(x)=\\operatorname{sin}⁡x$ and so $f(x)$ is continuous on $[-2,-1].$  Therefore, the extreme value theorem is applicable on this interval.\n\n- Now, consider the interval $[-1,1].$ In this case, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}f(x) & ={lim}_{x\\to {0}^{+}}(\\operatorname{ln}⁡x)=-\\infty .\\end{aligned}\n$$\n\nHence, $f(x)$ has an essential discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1],$ and the extreme value theorem is not applicable on this interval.\n\n- Finally, we note that the interval $(0,1]$ is not closed, so the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is \"I only\"." #edb/ref 17592186045417] [17592186247462 #edb/ref 1080 "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{1+\\frac{9k}{n}}\\cdot \\frac{9}{n}]" #edb/ref 17592186045417] [17592186247462 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247462 #edb/ref 1083 #uuid "050f0089-3abb-5b33-a522-9fcf6da51184" #edb/ref 17592186045417] [17592186247536 #edb/ref 1080 "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{4+\\frac{5k}{n}}\\cdot \\frac{5}{n}]" #edb/ref 17592186045417] [17592186247536 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247536 #edb/ref 1083 #uuid "0c7ba62d-655c-5d2f-9e39-d57cfcb4fd9c" #edb/ref 17592186045417] [17592186248762 #edb/ref 1080 "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{9+\\frac{4k}{n}}\\cdot \\frac{4}{n}]" #edb/ref 17592186045417] [17592186248762 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248762 #edb/ref 1083 #uuid "967f4525-a652-56db-858b-313b2768da07" #edb/ref 17592186045417] [17592186248830 #edb/ref 1080 "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{1+\\frac{5k}{n}}\\cdot \\frac{5}{n}]" #edb/ref 17592186045417] [17592186248830 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248830 #edb/ref 1083 #uuid "9e70dee7-9dc6-5645-af86-ccdb7c1fd656" #edb/ref 17592186045417] [17592186249147 #edb/ref 1080 "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{4+\\frac{5k}{n}}\\cdot \\frac{9}{n}]" #edb/ref 17592186045417] [17592186249147 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186249147 #edb/ref 1083 #uuid "c19dabf5-82d5-51cb-a5a0-053c1d283106" #edb/ref 17592186045417] [17592186250085 #edb/ref 1075 #edb/ref 17592186247462 #edb/ref 17592186045417] [17592186250085 #edb/ref 1075 #edb/ref 17592186247536 #edb/ref 17592186045417] [17592186250085 #edb/ref 1075 #edb/ref 17592186248762 #edb/ref 17592186045417] [17