#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186172927} :activity/id #uuid "da0a118d-376a-5230-a1dc-46ce7816f56d" :activity/scope {:db/id #edb/ref 17592186049150 :topic/id #uuid "deab20e7-248d-57af-ad42-5509f60f2d31" :topic/math-academy-id 3360} :activity/steps [{:db/id #edb/ref 17592186172927 :step/content {:db/id #edb/ref 17592186173169 :tutorial/content "The fundamental theorem of line integrals states that\n\n$$\n\\int_{C} \\nabla f \\cdot \\textrm{d}\\mathbf r = f(\\mathbf r(b)) - f(\\mathbf r(a))\n$$\n\n \n\nwhere $C$ is a piecewise-smooth curve $\\mathbf r(t)$ for $t\\in [a,b],$ and $f$ is differentiable function such that $\\nabla f$ is continuous on $C.$ \n\nThis theorem tells us that the line integral of a conservative vector field $\\mathbf{F} = \\nabla f$ is determined by the values of $f$ at the endpoints $A$ and $B$ of $C$ only. The integral does *not* depend on the path between $A$ and $B.$ \n\nIn particular, if $\\mathbf F$ is conservative, then we say that $\\displaystyle\\int_{C} \\mathbf F \\cdot \\textrm{d}\\mathbf r$ is **path-independent.**" :tutorial/id #uuid "ab2cc7cb-1fa4-5e9c-92d4-551aeb945c53" :tutorial/math-academy-id 5145 :tutorial/title "Introduction"} :step/id #uuid "16937ae1-27e8-5337-99ff-6a5dd1b9e446" :step/math-academy-id 32376 :step/next {:db/id #edb/ref 17592186173007}} {:db/id #edb/ref 17592186172932 :step/content {:db/id #edb/ref 17592186172054 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171860 :question/id #uuid "06e592bb-3ebe-57f1-a282-635599780593" :question/math-academy-id "e-8753"} :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048916}] :knowledge-point/questions [{:db/id #edb/ref 17592186172299} {:db/id #edb/ref 17592186172300} {:db/id #edb/ref 17592186259847} {:db/id #edb/ref 17592186259853} {:db/id #edb/ref 17592186259861} {:db/id #edb/ref 17592186259862} {:db/id #edb/ref 17592186259863} {:db/id #edb/ref 17592186259864} {:db/id #edb/ref 17592186415272} {:db/id #edb/ref 17592186415275} {:db/id #edb/ref 17592186415281} {:db/id #edb/ref 17592186419017}] :knowledge-point/title "Identifying Vector Fields That Are Independent of Path"} :step/id #uuid "cab8518e-c3d7-56ce-a74a-1da8815349ad" :step/math-academy-id 32601} {:db/id #edb/ref 17592186173007 :step/content {:db/id #edb/ref 17592186172097 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171903 :question/id #uuid "a9f1b212-7d45-566a-95d3-fa2697ad8c3a" :question/math-academy-id "e-9548"} :knowledge-point/id #uuid "5598fb5a-b749-56ec-8b86-49d73206b58c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048308}] :knowledge-point/questions [{:db/id #edb/ref 17592186172302} {:db/id #edb/ref 17592186172675} {:db/id #edb/ref 17592186259848} {:db/id #edb/ref 17592186259850} {:db/id #edb/ref 17592186259851} {:db/id #edb/ref 17592186259852} {:db/id #edb/ref 17592186259854} {:db/id #edb/ref 17592186415278} {:db/id #edb/ref 17592186415279} {:db/id #edb/ref 17592186415280} {:db/id #edb/ref 17592186424097}] :knowledge-point/title "Calculating a Line Integral Over an Arbitrary Path"} :step/id #uuid "a55b03af-55fa-5584-8ba8-abdc7dda9f46" :step/math-academy-id 35770 :step/next {:db/id #edb/ref 17592186173008}} {:db/id #edb/ref 17592186173008 :step/content {:db/id #edb/ref 17592186172098 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171904 :question/id #uuid "d659bb69-1a8d-5fb2-837c-27e454877021" :question/math-academy-id "e-9549"} :knowledge-point/id #uuid "28bf8f3a-e97e-5ec1-bb18-3ebfa213aa46" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050983}] :knowledge-point/questions [{:db/id #edb/ref 17592186172301} {:db/id #edb/ref 17592186172303} {:db/id #edb/ref 17592186259855} {:db/id #edb/ref 17592186259856} {:db/id #edb/ref 17592186259857} {:db/id #edb/ref 17592186259858} {:db/id #edb/ref 17592186259859} {:db/id #edb/ref 17592186259860} {:db/id #edb/ref 17592186415273} {:db/id #edb/ref 17592186415274} {:db/id #edb/ref 17592186415276} {:db/id #edb/ref 17592186415277}] :knowledge-point/title "Calculating a Line Integral Over an Arbitrary Path When the Potential Function Is Not Given"} :step/id #uuid "d161b477-2d2f-52f2-881b-e7e6f77d4ecc" :step/math-academy-id 35774 :step/next {:db/id #edb/ref 17592186172932}}] :activity/title "Path Independence of Line Integrals" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186172180}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186424098} :activity/id #uuid "a2243f17-089c-5e52-a019-0035fd16e9e3" :activity/scope {:db/id #edb/ref 17592186049150 :topic/id #uuid "deab20e7-248d-57af-ad42-5509f60f2d31" :topic/math-academy-id 3360} :activity/steps [{:db/id #edb/ref 17592186424098 :step/content {:db/id #edb/ref 17592186259848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35348fe3-9c3a-5329-8e93-1436583e7d76" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186257251} {:answer/id #uuid "75b868e6-319b-563d-831f-92bee29e5558" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186257815} {:answer/id #uuid "8988ff7c-7ded-5728-ab29-45c3901aa9d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186257990} {:answer/id #uuid "b84a0627-05af-5fa3-8be1-e5e0905f69e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186258394} {:answer/id #uuid "ebe19d67-ace6-5f6f-971e-e78991d0fb68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-11" :db/id #edb/ref 17592186258825}] :answer-field/correct {:db/id #edb/ref 17592186258825} :answer-field/id #uuid "2ac9611f-eb21-5ce8-9755-c7ccbc9751f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259108}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5064d3f6-e78c-56b7-8d2f-396471e7bc8b" :question/math-academy-id "q-125726" :question/problem "Consider the scalar field $f(x,y)={x}^{2}y.$ Calculate ${\\int }_{C}∇f\\cdot \\text{d}r,$ where $C$ is any smooth path from $(-3,1)$ to $(1,-2)$ in ${R}^{2}.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nIn our case, the coordinates of the endpoints of the path $C$ are $A(-3,1)$ and $B(1,-2).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(1,-2)-f(-3,1) \\\\  & =(1)^{2}(-2)-(-3)^{2}(1) \\\\  & =-2-9 \\\\  & =-11.\\end{aligned}\n$$"} :step/id #uuid "342f3d25-ce3a-5f3c-b57d-c4d0387248ff" :step/next {:db/id #edb/ref 17592186424099}} {:db/id #edb/ref 17592186424099 :step/content {:db/id #edb/ref 17592186424097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a818aab-75ac-5369-aa04-7b5968c78bdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186424091} {:answer/id #uuid "5b41497c-0b03-518e-b827-be965cbad632" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186424092} {:answer/id #uuid "80844163-7141-53d5-b539-4be5b4478368" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186424093} {:answer/id #uuid "aa971f18-d59c-541a-a8c1-bc17ca502230" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186424094} {:answer/id #uuid "b0ca885d-c4f1-58d6-b2f7-daed73d87732" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186424095}] :answer-field/correct {:db/id #edb/ref 17592186424095} :answer-field/id #uuid "bf3ea97d-4f26-5777-a472-6a585002f0c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186424096}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "af7a572f-0636-5725-9441-ef6582928ab9" :question/math-academy-id "q-125729" :question/problem "Consider the scalar field $f(x,y)={x}^{2}-2{y}^{3}.$ Calculate ${\\int }_{C}∇f\\cdot \\text{d}r,$ where $C$ is any smooth path from $(-4,1)$ to $(0,-2)$ in ${R}^{2}.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nIn our case, the coordinates of the endpoints of the path $C$ are $A(-4,1)$ and $B(0,-2).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(0,-2)-f(-4,1) \\\\  & =({0}^{2}-2(-2)^{3})-((-4)^{2}-2(1)^{3}) \\\\  & =16-16+2 \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "64a5e538-5a25-5466-a330-6b9f2d52b686" :step/next {:db/id #edb/ref 17592186424101}} {:db/id #edb/ref 17592186424100 :step/content {:db/id #edb/ref 17592186259851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15deefdc-05ae-5086-a5f0-c1dc6044e9b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{10}" :db/id #edb/ref 17592186256977} {:answer/id #uuid "2247900f-b21b-584e-a22b-427516ec3d48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186257062} {:answer/id #uuid "5a2d5949-bfc8-5763-bd36-6a74f995a834" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186257566} {:answer/id #uuid "7187435a-9b2a-5138-bdc3-8e258afbb442" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186257779} {:answer/id #uuid "cd8bcb5c-084b-52f8-b5f5-1853ba91623b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186258561}] :answer-field/correct {:db/id #edb/ref 17592186257779} :answer-field/id #uuid "568ddf7f-5eb1-53a7-8971-663ff621802f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259181}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "30e624bb-f7e4-561a-be9c-3d2d751b4f13" :question/math-academy-id "q-125735" :question/problem "Consider the scalar field $f(x,y)=\\frac{y}{{x}^{2}+1}.$ Calculate ${\\int }_{C}∇f\\cdot \\text{d}r,$ where $C$ is any smooth path from $(-2,1)$ to $(0,3)$ in ${R}^{2}.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nIn our case, the coordinates of the endpoints of the path $C$ are $A(-2,1)$ and $B(0,3).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(0,3)-f(-2,1) \\\\  & =\\frac{3}{{0}^{2}+1}-\\frac{1}{(-2)^{2}+1} \\\\  & =3-\\frac{1}{5} \\\\  & =\\frac{14}{5}.\\end{aligned}\n$$"} :step/id #uuid "9d21a388-bd37-58ca-99a7-53b6bd2958a7" :step/next {:db/id #edb/ref 17592186424102}} {:db/id #edb/ref 17592186424101 :step/content {:db/id #edb/ref 17592186259850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "046fdfb7-5908-5b1c-90e7-05dd1219d510" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186256819} {:answer/id #uuid "0494c2e3-4f93-51c9-97b4-abdfd2bbd422" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186256820} {:answer/id #uuid "0c87d320-18b0-5f77-bb7b-34ad58ca38b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186256902} {:answer/id #uuid "2cc2089f-6561-53d8-b5ee-acdc74d9f43b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186257182} {:answer/id #uuid "c02c18c1-a46b-54b2-8cf2-af2aecbb3d12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186258459}] :answer-field/correct {:db/id #edb/ref 17592186256902} :answer-field/id #uuid "8f5a55be-ee74-53ab-9b52-5cbae09ff6ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259281}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6d312ac8-d0a5-5f87-aa22-804248c3f5d0" :question/math-academy-id "q-125732" :question/problem "Consider the scalar field $f(x,y)=\\operatorname{sin}⁡y-\\operatorname{cos}⁡x.$ Calculate ${\\int }_{C}∇f\\cdot \\text{d}r,$ where $C$ is any smooth path from $(-\\pi ,0)$ to $(0,\\frac{\\pi }{2})$ in ${R}^{2}.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nIn our case, the coordinates of the endpoints of the path $C$ are $A(-\\pi ,0)$ and $B(0,\\frac{\\pi }{2}).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(0,\\frac{\\pi }{2})-f(-\\pi ,0) \\\\  & =(\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡0)-(\\operatorname{sin}⁡0-\\operatorname{cos}⁡(-\\pi )) \\\\  & =(1-1)-(0+1) \\\\  & =-1.\\end{aligned}\n$$"} :step/id #uuid "bf2721f1-961a-51a7-9951-c9a433cd01de" :step/next {:db/id #edb/ref 17592186424100}} {:db/id #edb/ref 17592186424102 :step/content {:db/id #edb/ref 17592186259857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06828943-2517-5788-afbf-83f2f355cc96" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186256836} {:answer/id #uuid "a816432d-4895-55c2-953a-1699f10ab4b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186258249} {:answer/id #uuid "c83059f8-61f6-50d7-9ebe-a77e51cd568a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186258528} {:answer/id #uuid "f86cf986-18fe-5093-aa80-ac15fc51982d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186258960} {:answer/id #uuid "ff7fca20-5bdf-5366-9789-fd9cfe5d4ea6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186259028}] :answer-field/correct {:db/id #edb/ref 17592186258960} :answer-field/id #uuid "3e700bf1-abf6-54f9-a024-9c52cdfe7394" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259144}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f0148bc8-aabc-5dbc-868a-3905d42c3ea4" :question/math-academy-id "q-125751" :question/problem "Consider the vector field $F(x,y)=({y}^{2}-2x)\\,i+2xy\\,j.$ Calculate ${\\int }_{C}F\\cdot \\text{d}r,$ where $C$ is any smooth path from $(0,1)$ to $(1,3)$ in ${R}^{2}.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nIn our case, the coordinates of the endpoints of the path $C$ are $A(0,1)$ and $B(1,3).$\n\nNotice that $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ with domain $D={R}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}=2y.\n$$\n\nSince the partial derivatives exist and are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative. Therefore, we know there exists a function $f$ such that $∇f=F.$\n\nReconstructing $f$ from its gradient in the usual way, we get\n\n$$\nf=x{y}^{2}-{x}^{2}.\n$$\n\nFinally, applying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{C}∇f\\cdot \\text{d}r \\\\  & =f(1,3)-f(0,1) \\\\  & =(1(3)^{2}-{1}^{2})-(0(1)^{2}-{0}^{2}) \\\\  & =8-0 \\\\  & =8.\\end{aligned}\n$$"} :step/id #uuid "fdf40bb8-48bd-542e-b098-e878dafa270b"}] :activity/title "Path Independence of Line Integrals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186424090}]}
