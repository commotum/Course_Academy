#{[{:activity/first-step {:db/id #edb/ref 17592186101902} :activity/id #uuid "0e211b6d-7f83-5173-9b92-9e29afdbbe93" :activity/scope {:db/id #edb/ref 17592186048985 :topic/id #uuid "d10de7de-f23e-5cf3-b20d-fb6542a1ea1d" :topic/math-academy-id 1218} :activity/steps [{:db/id #edb/ref 17592186101902 :step/content {:db/id #edb/ref 17592186102014 :tutorial/content "There are several quantities that businesses need to keep track of to ensure that the business remains healthy:\n\n- Revenue: This is the total amount of money (in dollars) that a company gains after selling $x$ units of product.\n- Cost: This is the total amount of money (in dollars) that a company spends to create $x$ units of product.\n- Profit. The difference between revenue and cost. It represents the amount of *additional* money that the business has earned after paying its costs.\n\nBusinesses often strive to maximize revenue and profit. They also often seek to minimize cost. The candidates test gives them a method for doing this. Let's find out how." :tutorial/id #uuid "7d29b308-bacd-5426-b6c8-43b0da8fcd75" :tutorial/math-academy-id 682 :tutorial/title "Introduction"} :step/id #uuid "1fc21a4d-0b82-5f3e-b8d9-126d7179656f" :step/math-academy-id 606252 :step/next {:db/id #edb/ref 17592186101903}} {:db/id #edb/ref 17592186101903 :step/content {:db/id #edb/ref 17592186101017 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100661 :question/id #uuid "e47dca19-6772-532a-9955-ebe6f3db0d28" :question/math-academy-id "e-359"} :knowledge-point/id #uuid "1aca5854-177d-5ebe-9a63-caaa7d916c4d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048116} {:db/id #edb/ref 17592186048162} {:db/id #edb/ref 17592186048883}] :knowledge-point/questions [{:db/id #edb/ref 17592186101195} {:db/id #edb/ref 17592186101481}] :knowledge-point/title "Optimizing a Profit, Revenue, or Cost Function"} :step/id #uuid "822eb919-1779-5cf4-9c9e-2c66f15e9e2a" :step/math-academy-id 606253 :step/next {:db/id #edb/ref 17592186101904}} {:db/id #edb/ref 17592186101904 :step/content {:db/id #edb/ref 17592186101994 :tutorial/content "Recall that the price function $p(x)$ gives the *price per unit* at which a company sells $x$ units of a good.\n\nThe revenue function $R(x)$ associated with a price function $p(x)$ is given by\n\n$$\n\\begin{aligned}\nR(x) &= (number of units) \\cdot (price per unit) \\\\\n&= x \\cdot p(x)\n\\end{aligned}\n$$\n\nAlso, recall that the cost function $C(x)$ associated with producing $x$ units of a good can be calculated as follows:\n\n$$\n\\begin{aligned}\nC(x) &= (fixed cost) + (number of units) \\cdot (cost per unit) \\\\\n&= (fixed cost) + x \\cdot (cost per unit)\n\\end{aligned}\n$$\n\nThe quantity $x\\cdot (\\textrm{cost per unit})$ is sometimes called the **variable cost** since it is the part of the cost function $C(x)$ that is dependent on the number of units $x$ produced by the company.\n\nFinally, if we know the revenue function $R(x)$ and the cost function $C(x)$, then the profit function $P(x)$ is given by\n\n$$\nP(x) = R(x) - C(x)\n$$" :tutorial/id #uuid "fb6a794d-d60c-5d16-8912-b69af938c892" :tutorial/math-academy-id 4663 :tutorial/title "A Review of Price and Cost Functions"} :step/id #uuid "9f61e403-b029-5b57-97a2-0449bc4a4ffd" :step/math-academy-id 606256 :step/next {:db/id #edb/ref 17592186101905}} {:db/id #edb/ref 17592186101905 :step/content {:db/id #edb/ref 17592186101018 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100788 :question/id #uuid "7996afa5-da25-51e5-915c-5f0acdccb8bd" :question/math-academy-id "e-7697"} :knowledge-point/id #uuid "f2d19236-d6ea-57da-b2a4-b926fdddb30e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049326}] :knowledge-point/questions [{:db/id #edb/ref 17592186101562} {:db/id #edb/ref 17592186101563}] :knowledge-point/title "Maximizing a Revenue Function Given a Price Function"} :step/id #uuid "ab8f2b97-af90-5292-ad79-44e12e42010b" :step/math-academy-id 606257 :step/next {:db/id #edb/ref 17592186101906}} {:db/id #edb/ref 17592186101906 :step/content {:db/id #edb/ref 17592186101019 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100660 :question/id #uuid "6c44b63d-72f8-599a-a89c-29fdc2227ab5" :question/math-academy-id "e-357"} :knowledge-point/id #uuid "9c30919c-c2b9-5e09-8512-98fcbe339564" :knowledge-point/questions [{:db/id #edb/ref 17592186101111} {:db/id #edb/ref 17592186101112} {:db/id #edb/ref 17592186101503} {:db/id #edb/ref 17592186101504} {:db/id #edb/ref 17592186101564}] :knowledge-point/title "Maximizing a Profit Function Given a Revenue and Cost Function"} :step/id #uuid "f5614397-09dd-526a-abea-3acccf854d69" :step/math-academy-id 606260 :step/next {:db/id #edb/ref 17592186101907}} {:db/id #edb/ref 17592186101907 :step/content {:db/id #edb/ref 17592186101020 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100784 :question/id #uuid "a63d3bdb-ca20-51f5-b876-7ec8950a46dd" :question/math-academy-id "e-7574"} :knowledge-point/id #uuid "6d2b1036-0ea4-5fd1-bfed-885dcbae618b" :knowledge-point/questions [{:db/id #edb/ref 17592186101113} {:db/id #edb/ref 17592186101196} {:db/id #edb/ref 17592186101285} {:db/id #edb/ref 17592186101378} {:db/id #edb/ref 17592186101482}] :knowledge-point/title "Maximizing a Profit Function by Constructing a Revenue and Cost Function"} :step/id #uuid "ca0f41cd-a2e3-5d80-9d45-4b2c58377bc5" :step/math-academy-id 606266}] :activity/title "Optimization Problems in Economics" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101072}]}
