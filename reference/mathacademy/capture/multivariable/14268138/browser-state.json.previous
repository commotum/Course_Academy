ace=\"2\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2208\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c1D445 TEX-I\"></mjx-c></mjx-mi></mjx-texatom></mjx-mrow></mjx-mstyle></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mrow><mtext>and&nbsp;</mtext><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy=\"false\">)</mo><mo>∈</mo><mi>R</mi></mrow></mrow></mstyle></mpadded></mstyle><mo>,</mo></math></mjx-assistive-mml></mjx-container> the relation is <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"351\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle style=\"background-color: gainsboro;\"><mjx-mpadded><mjx-block style=\"width: 13.811em; margin: 0.3em 0px; position: relative;\"><mjx-rbox style=\"left: 0.3em; top: 0px; max-width: 13.811em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6E\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c74\"></mjx-c><mjx-c class=\"mjx-c68\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c72\"></mjx-c><mjx-c class=\"mjx-c20\"></mjx-c><mjx-c class=\"mjx-c72\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c66\"></mjx-c><mjx-c class=\"mjx-c6C\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c78\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c76\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c20\"></mjx-c><mjx-c class=\"mjx-c6E\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c72\"></mjx-c><mjx-c class=\"mjx-c20\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c72\"></mjx-c><mjx-c class=\"mjx-c72\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c66\"></mjx-c><mjx-c class=\"mjx-c6C\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c78\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c76\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c></mjx-mtext></mjx-mstyle></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mtext>neither reflexive nor irreflexive</mtext></mstyle></mpadded></mstyle><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
