#{[{:db/id #edb/ref 17592186162350 :knowledge-point/_questions [{:db/id #edb/ref 17592186162093 :knowledge-point/id #uuid "b21c27bd-5c7a-5645-93b5-0af73c59f685" :knowledge-point/title "Finding the Solution to a Weighted Least-Squares Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "088981d3-114e-574b-937a-924f96c1a577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{3} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186412634} {:answer/id #uuid "495b45ed-6e05-5844-806a-6ba5b784755f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{3} \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186412639} {:answer/id #uuid "552d678b-530b-5d1a-bf8b-91ab4eb12691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186412640} {:answer/id #uuid "e4052908-8f95-52dd-aefc-cb82ac135212" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{4}{3} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186412649} {:answer/id #uuid "fb119cac-1cdf-5bd7-b4cf-2acfdf9b0565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186412653}] :answer-field/correct {:answer/id #uuid "088981d3-114e-574b-937a-924f96c1a577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{3} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186412634} :answer-field/id #uuid "fea215fb-04f0-534e-86ff-be0201f49602" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412657}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6bb363c-48b6-5047-89db-8e3fcc537bc7" :question/math-academy-id "q-137102" :question/problem "Find the solution for the weighted least-squares problem $W\\,Ax=Wb,$ where\n\n$$\nA=\\begin{bmatrix}1 & -1 \\\\ 1 & 0 \\\\ 2 & -1\\end{bmatrix},\\,b=\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix},\\,W=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=\\begin{bmatrix}{2}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {1}^{2}\\end{bmatrix}=\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix},\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & -1 \\\\ 1 & 0 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ 2 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}4 & -4 \\\\ 4 & 0 \\\\ 2 & -1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 1 & 2 \\\\ -1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}4 \\\\ 8 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}12 & -6 \\\\ -6 & 5\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}14 \\\\ -5\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, since the matrix on the left-hand side is invertible, we obtain\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & ={\\begin{bmatrix}12 & -6 \\\\ -6 & 5\\end{bmatrix}}^{-1}\\begin{bmatrix}14 \\\\ -5\\end{bmatrix} \\\\  & =\\frac{1}{12\\cdot 5-(-6)\\cdot (-6)}\\begin{bmatrix}5 & 6 \\\\ 6 & 12\\end{bmatrix}\\begin{bmatrix}14 \\\\ -5\\end{bmatrix} \\\\  & =\\frac{1}{24}\\begin{bmatrix}40 \\\\ 24\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{3} \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269155 :knowledge-point/_questions [{:db/id #edb/ref 17592186162092 :knowledge-point/id #uuid "af51b0b6-4ae7-5b6a-b151-7f8cb88fa186" :knowledge-point/title "Finding the Normal Equation for a Weighted Least-Squares Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "291f85e7-4c75-50ac-b046-a9fdef85c25e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186266507} {:answer/id #uuid "2f9c1357-0658-525c-af46-1ec98bf32770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "135" :db/id #edb/ref 17592186266566} {:answer/id #uuid "50bb84ce-6a1c-5afa-90d0-25a92e86c024" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "88" :db/id #edb/ref 17592186266864} {:answer/id #uuid "898744eb-45fa-5338-ba36-a4522751b6ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "116" :db/id #edb/ref 17592186267367} {:answer/id #uuid "b6b853bd-19be-5128-bd16-174e21099e23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "101" :db/id #edb/ref 17592186267777}] :answer-field/correct {:answer/id #uuid "b6b853bd-19be-5128-bd16-174e21099e23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "101" :db/id #edb/ref 17592186267777} :answer-field/id #uuid "3d2189fb-be78-556b-85e5-5e311d4befa0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268506}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f70e05d-29be-52e1-b2aa-ee6c5f7555cb" :question/math-academy-id "q-137887" :question/problem "$$\nA=\\begin{bmatrix}-2 & 3 \\\\ 4 & -6 \\\\ 2 & 3\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 1 \\\\ 2\\end{bmatrix},\\,W=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ above. If the normal equation for the corresponding weighted least-squares problem $W\\,Ax=Wb$ is given by\n\n$$\n\\begin{bmatrix}a & -42 \\\\ -42 & b\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix}=\\begin{bmatrix}c \\\\ 36\\end{bmatrix}\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=\\begin{bmatrix}{2}^{2} & 0 & 0 \\\\ 0 & {1}^{2} & 0 \\\\ 0 & 0 & {1}^{2}\\end{bmatrix}=\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix},\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-2 & 4 & 2 \\\\ 3 & -6 & 3\\end{bmatrix}\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}-2 & 3 \\\\ 4 & -6 \\\\ 2 & 3\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-2 & 4 & 2 \\\\ 3 & -6 & 3\\end{bmatrix}\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}3 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}-2 & 4 & 2 \\\\ 3 & -6 & 3\\end{bmatrix}\\begin{bmatrix}-8 & 12 \\\\ 4 & -6 \\\\ 2 & 3\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-8 & 4 & 2 \\\\ 12 & -6 & 3\\end{bmatrix}\\begin{bmatrix}3 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}36 & -42 \\\\ -42 & 81\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}-16 \\\\ 36\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=36+81+(-16)=101.\n$$"}] [{:db/id #edb/ref 17592186389009 :knowledge-point/_questions [{:db/id #edb/ref 17592186162093 :knowledge-point/id #uuid "b21c27bd-5c7a-5645-93b5-0af73c59f685" :knowledge-point/title "Finding the Solution to a Weighted Least-Squares Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77509710-558f-57d7-aa0b-d2c981268322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186389011} {:answer/id #uuid "1ea03b7e-02ea-578c-913e-693044d40660" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186389012} {:answer/id #uuid "16afd48a-f37f-5caa-9c97-076511b40cdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186389013} {:answer/id #uuid "a84f2641-ea85-514d-b1d7-5c6aa198ca55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186389014} {:answer/id #uuid "315b04de-d0f3-59f7-b632-32a7cf9a8ecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186389015}] :answer-field/correct {:answer/id #uuid "16afd48a-f37f-5caa-9c97-076511b40cdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186389013} :answer-field/id #uuid "68cf1131-7e03-5583-b36c-8f53f5e6d06d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389010}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed199a9d-a3a2-5954-968b-924b5a1b21d0" :question/math-academy-id "q-158372" :question/problem "Find the solution for the weighted least-squares problem $W\\,Ax=Wb,$ where\n\n$$\nA=\\begin{bmatrix}1 & 2 \\\\ 1 & 1 \\\\ 3 & 1\\end{bmatrix},\\,b=\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix},\\,W=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=\\begin{bmatrix}{1}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {1}^{2}\\end{bmatrix}=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix},\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & 1 & 3 \\\\ 2 & 1 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 1 & 1 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 1 & 3 \\\\ 2 & 1 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}1 & 1 & 3 \\\\ 2 & 1 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 4 & 4 \\\\ 3 & 1\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}1 & 1 & 3 \\\\ 2 & 1 & 1\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix} \\\\ \\begin{bmatrix}14 & 9 \\\\ 9 & 9\\end{bmatrix}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, since the matrix on the left-hand side is invertible, we obtain\n\n$$\n\\begin{aligned}\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}\\end{bmatrix} & ={\\begin{bmatrix}14 & 9 \\\\ 9 & 9\\end{bmatrix}}^{-1}\\begin{bmatrix}5 \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{14\\cdot 9-9\\cdot 9}\\begin{bmatrix}9 & -9 \\\\ -9 & 14\\end{bmatrix}\\begin{bmatrix}5 \\\\ 0\\end{bmatrix} \\\\  & =\\frac{1}{45}\\begin{bmatrix}45 \\\\ -45\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$"}]}
