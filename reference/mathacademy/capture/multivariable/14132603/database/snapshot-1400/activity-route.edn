#{[{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186433631} :activity/id #uuid "2b8eb350-78af-5600-9e7a-328caccbfa84" :activity/scope {:db/id #edb/ref 17592186049196 :topic/id #uuid "e289a183-5534-5388-8ee7-3fc0d8f4ee68" :topic/math-academy-id 1833} :activity/steps [{:db/id #edb/ref 17592186433631 :step/content {:db/id #edb/ref 17592186433630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1367431b-f708-53d0-907c-401baf44b1b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186433618} {:answer/id #uuid "5ddff454-cafc-5d0a-8e73-761ad50a723b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{{(8{t}^{2}+2)}^{3/2}}" :db/id #edb/ref 17592186433620} {:answer/id #uuid "ae9b1f32-4af7-5ccc-b6f9-f8acc59e69d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{8}}{{(8{t}^{2}+1)}^{3/2}}" :db/id #edb/ref 17592186433621} {:answer/id #uuid "e1ed4446-c062-507c-a44a-cf42f43f3e0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186433624} {:answer/id #uuid "f9cd5e7a-fd43-5ce4-9986-155332afc1c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186433626}] :answer-field/correct {:db/id #edb/ref 17592186433621} :answer-field/id #uuid "c90f0f81-e6f6-5365-9a31-9800a129aea5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186433628}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d3e668b2-3360-5bad-970e-ebd786d68368" :question/math-academy-id "q-64696" :question/problem "Find the curvature at an arbitrary point on the curve $r(t)={t}^{2}\\,i+{t}^{2}\\,j+t\\,k.$" :question/worked-solution "Let $T(t)$ denote the unit tangent to the given curve as a function of the parameter $t.$ Since we are given the curve $r(t)$ parametrized by the parameter $t$ (not the arc length $s$), we will use the following formula for the curvature: \n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we calculate ${r}^{′}(t)$ and find its magnitude:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})j+\\frac{\\text{d}}{\\text{d}t}(t)k \\\\  & =2t\\,i+2t\\,j+1\\,k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(2t)^{2}+(2t)^{2}+{1}^{2}} \\\\  & =\\sqrt{8{t}^{2}+1}\\end{aligned}\n$$\n\n   \n\nHence, the corresponding unit tangent vector is\n\n$$\n\\begin{aligned}T(t) & =\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖} \\\\  & =\\frac{1}{\\sqrt{8{t}^{2}+1}}(2t\\,i+2t\\,j+k).\\end{aligned}\n$$\n\n \n\nNext, we calculate ${T}^{′}(t)$ and find its magnitude:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{2t}{\\sqrt{8{t}^{2}+1}})\\,i+\\frac{\\text{d}}{\\text{d}t}(\\frac{2t}{\\sqrt{8{t}^{2}+1}})\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{8{t}^{2}+1}})\\,k \\\\  & =\\frac{1}{{(8{t}^{2}+1)}^{3/2}}(2\\,i+2\\,j-8t\\,k) \\\\ ‖{T}^{′}(t)‖ & =\\frac{\\sqrt{{2}^{2}+{2}^{2}+(-8t)^{2}}}{{(8{t}^{2}+1)}^{3/2}} \\\\  & =\\frac{\\sqrt{8+{8}^{2}{t}^{2}}}{{(8{t}^{2}+1)}^{3/2}} \\\\  & =\\frac{\\sqrt{8(1+8{t}^{2})}}{{(8{t}^{2}+1)}^{3/2}} \\\\  & =\\frac{\\sqrt{8}\\sqrt{8{t}^{2}+1}}{{(8{t}^{2}+1)}^{3/2}}\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{(\\frac{\\sqrt{8}\\sqrt{8{t}^{2}+1}}{{(8{t}^{2}+1)}^{3/2}})}{\\sqrt{8{t}^{2}+1}}=\\frac{\\sqrt{8}}{{(8{t}^{2}+1)}^{3/2}}.\\end{aligned}\n$$"} :step/id #uuid "00d70dc7-07a1-5030-82b3-0ddd637fbfb1" :step/next {:db/id #edb/ref 17592186433632}} {:db/id #edb/ref 17592186433632 :step/content {:db/id #edb/ref 17592186120495 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0c9c1f0-df55-556e-833a-7fb64732dde4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186119085} {:answer/id #uuid "f30dc2a4-65fc-5750-b501-c7c5b426ccda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186119086} {:answer/id #uuid "092a0aaf-082d-545c-9806-110ce43d35b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186119087} {:answer/id #uuid "3ef17328-d207-5798-8681-f24753e09c81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186119088} {:answer/id #uuid "62750844-6757-5328-89ca-54678ebfa45e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186119089}] :answer-field/correct {:db/id #edb/ref 17592186119087} :answer-field/id #uuid "4ccd57a8-0a01-50d0-ac4b-6f5f8f6b6e44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186119084}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4163ce17-8c2e-5e7a-b5d2-d7191ad32de0" :question/math-academy-id "q-64700" :question/problem "Find the curvature at an arbitrary point on the curve $r(s)$ parametrized by its arc length $s$, where\n\n$$\nr(s)=⟨\\operatorname{cos}⁡s,\\,\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡s,\\,\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡s⟩,\\,0\\le s<2\\pi .\n$$" :question/worked-solution "Let $T(s)$ denote the unit tangent to the given curve as a function of the arc length $s.$ Since we are given the curve $r(s)$ parametrized by the arc length $s$, we will use the following formula for the curvature:\n\n$$\nκ(s)=‖{T}^{′}(s)‖=‖{r}^{″}(s)‖\n$$\n\nNow, we calculate ${r}^{′}(s)$ and ${r}^{″}(s)$:\n\n$$\n\\begin{aligned}{r}^{′}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(\\operatorname{cos}⁡s),\\,\\frac{\\text{d}}{\\text{d}s}(\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡s),\\,\\frac{\\text{d}}{\\text{d}s}(\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡s)⟩ \\\\  & =⟨-\\operatorname{sin}⁡s,\\,\\frac{\\sqrt{2}}{2}\\operatorname{cos}⁡s,\\,\\frac{\\sqrt{2}}{2}\\operatorname{cos}⁡s⟩ \\\\ {r}^{″}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(-\\operatorname{sin}⁡s),\\,\\frac{\\text{d}}{\\text{d}s}(\\frac{\\sqrt{2}}{2}\\operatorname{cos}⁡s),\\,\\frac{\\text{d}}{\\text{d}s}(\\frac{\\sqrt{2}}{2}\\operatorname{cos}⁡s)⟩ \\\\  & =⟨-\\operatorname{cos}⁡s,\\,-\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡s,\\,-\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡s⟩\\end{aligned}\n$$\n\nFinally, the curvature is  \n\n$$\n\\begin{aligned}κ(s) & =‖{r}^{″}(s)‖ \\\\  & =\\sqrt{{(-\\operatorname{cos}⁡s)}^{2}+{(-\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡s)}^{2}+{(-\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡s)}^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡s+\\frac{1}{2}{sin}^{2}⁡s+\\frac{1}{2}{sin}^{2}⁡s} \\\\  & =\\sqrt{{cos}^{2}⁡s+{sin}^{2}⁡s} \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "59cb16be-b5c6-5ba7-9b02-4ee7270ded13" :step/next {:db/id #edb/ref 17592186433633}} {:db/id #edb/ref 17592186433633 :step/content {:db/id #edb/ref 17592186433629 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1251bed4-415d-5590-a871-e4a9657e13d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186433617} {:answer/id #uuid "481e6b9f-c5af-58b8-b98e-c12965a43b0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186433619} {:answer/id #uuid "c86e68ce-7275-5906-ac2f-57213bf72bac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186433622} {:answer/id #uuid "d87a76ef-7c66-5822-bbbd-0695f641dc2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186433623} {:answer/id #uuid "e5a5693f-64fa-5920-9519-f34d893234c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186433625}] :answer-field/correct {:db/id #edb/ref 17592186433622} :answer-field/id #uuid "5ef00e22-7033-5539-a4d7-5c70d771c4f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186433627}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c48a3e25-1a31-5723-bb94-d587dcc4bb55" :question/math-academy-id "q-80546" :question/problem "Find the curvature at an arbitrary point on the curve $r(t)$ given that its derivative ${r}^{′}(t)$ and the derivative of the corresponding unit tangent ${T}^{′}(t)$ are as follows:\n\n$$\n\\begin{aligned}{r}^{′}(t)=⟨-4\\operatorname{sin}⁡(2t),\\,-4\\operatorname{cos}⁡(2t)⟩,\\,{T}^{′}(t)=⟨-2\\operatorname{cos}⁡(2t),\\,2\\operatorname{sin}⁡(2t)⟩\\end{aligned}\n$$" :question/worked-solution "Since we are given both the derivative of the curve ${r}^{′}(t)$ and the derivative of the unit tangent ${T}^{′}(t)$, we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we find the magnitudes of ${T}^{′}(t)$ and ${r}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =\\sqrt{{(-2\\operatorname{cos}⁡(2t))}^{2}+{(2\\operatorname{sin}⁡(2t))}^{2}} \\\\  & =\\sqrt{4{cos}^{2}⁡(2t)+4{sin}^{2}⁡(2t)} \\\\  & =\\sqrt{4({cos}^{2}⁡(2t)+{sin}^{2}⁡(2t))} \\\\  & =\\sqrt{4} \\\\  & =2 \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(-4\\operatorname{sin}⁡(2t))^{2}+(-4\\operatorname{cos}⁡(2t))^{2}} \\\\  & =\\sqrt{16{sin}^{2}⁡(2t)+16{cos}^{2}⁡(2t)} \\\\  & =\\sqrt{16({sin}^{2}⁡(2t)+{cos}^{2}⁡(2t))} \\\\  & =\\sqrt{16} \\\\  & =4\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{\\,2\\,}{4}=\\frac{1}{2}.\\end{aligned}\n$$"} :step/id #uuid "cb9b8003-d330-530b-a31a-213d60c41132"}] :activity/title "Introduction to Curvature" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186433616}]}
