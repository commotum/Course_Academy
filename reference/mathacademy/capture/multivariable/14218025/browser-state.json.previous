le=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup><msup><mo stretchy=\"false\">)</mo><mn>3</mn></msup><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup><msup><mo stretchy=\"false\">)</mo><mn>4</mn></msup><mo>+</mo><mo>⋯</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>4</mn><msup><mi>x</mi><mn>4</mn></msup><mo stretchy=\"false\">)</mo><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>3</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>8</mn><msup><mi>x</mi><mn>6</mn></msup><mo stretchy=\"false\">)</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo stretchy=\"false\">(</mo><mn>16</mn><msup><mi>x</mi><mn>8</mn></msup><mo stretchy=\"false\">)</mo><mo>+</mo><mo>⋯</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mn>2</mn><msup><mi>x</mi><mn>4</mn></msup><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>8</mn><msup><mi>x</mi><mn>6</mn></msup></mrow><mn>3</mn></mfrac></mstyle></mpadded></mstyle><mo>−</mo><mn>4</mn><msup><mi>x</mi><mn>8</mn></msup><mo>+</mo><mo>⋯</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
