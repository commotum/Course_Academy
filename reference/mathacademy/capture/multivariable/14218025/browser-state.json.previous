mn></msup></mrow><mn>3</mn></mfrac></mstyle></mpadded></mstyle><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>625</mn><msup><mi>x</mi><mn>4</mn></msup></mrow><mn>4</mn></mfrac></mstyle><mo>+</mo><mo>⋯</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
