86045417] [17592186198421 #edb/ref 1038 #edb/ref 17592186435470 #edb/ref 17592186045417] [17592186198421 #edb/ref 1038 #edb/ref 17592186435476 #edb/ref 17592186045417] [17592186198421 #edb/ref 1039 "Calculating the Radius of Gyration of a Non-Uniform, Non-Rectangular Laminar" #edb/ref 17592186045417] [17592186198421 #edb/ref 1041 #edb/ref 17592186198063 #edb/ref 17592186045417] [17592186198421 #edb/ref 1042 #uuid "aa0241de-b852-5c1f-962b-559e05edf39e" #edb/ref 17592186045417] [17592186198500 #edb/ref 1043 #edb/ref 17592186199262 #edb/ref 17592186045417] [17592186198500 #edb/ref 1043 #edb/ref 17592186199344 #edb/ref 17592186045417] [17592186198500 #edb/ref 1043 #edb/ref 17592186199348 #edb/ref 17592186045417] [17592186198500 #edb/ref 1043 #edb/ref 17592186199351 #edb/ref 17592186045417] [17592186198500 #edb/ref 1043 #edb/ref 17592186199368 #edb/ref 17592186045417] [17592186198500 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186198500 #edb/ref 1045 "Calculating the Radius of Gyration of a Plane Lamina" #edb/ref 17592186045417] [17592186198500 #edb/ref 1046 #edb/ref 17592186199262 #edb/ref 17592186045417] [17592186198500 #edb/ref 1049 #edb/ref 17592186050741 #edb/ref 17592186045417] [17592186198500 #edb/ref 1050 1380.0 #edb/ref 17592186045417] [17592186198500 #edb/ref 1053 #uuid "ee989efc-2e02-5faf-9663-d0e67a72db66" #edb/ref 17592186045417] [17592186198956 #edb/ref 1068 #edb/ref 17592186326355 #edb/ref 17592186045417] [17592186198956 #edb/ref 1069 "q-38824" #edb/ref 17592186045417] [17592186198956 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186198956 #edb/ref 1071 "A plate of mass $M$ occupies the region $D$ bounded by the curves $y={x}^{2}$ and $x={y}^{2}.$ Its mass density at any point on the plate is given by $\\lambda (x,y)=12Mxy.$ Find the radius of gyration of the plate about the $x$-axis." #edb/ref 17592186045417] [17592186198956 #edb/ref 1072 #uuid "2db88b84-fe57-56b2-8d78-b4ac01dd1164" #edb/ref 17592186045417] [17592186198956 #edb/ref 1074 "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the $x$-axis is defined as\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function. The region $D$ is a type I region with representation\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,\\,{x}^{2}\\le y\\le \\sqrt{x}\\}.\n$$\n\nHence, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{{x}^{2}}^{\\sqrt{x}}{y}^{2}\\cdot 12Mxy\\,\\text{d}y\\,\\text{d}x \\\\  & =M{\\int }_{0}^{1}{\\int }_{{x}^{2}}^{\\sqrt{x}}12x{y}^{3}\\,\\text{d}y\\,\\text{d}x \\\\  & =M{\\int }_{0}^{1}[3x{y}^{4}]_{y={x}^{2}}^{y=\\sqrt{x}}\\,\\text{d}x \\\\  & =M{\\int }_{0}^{1}3{x}^{3}-3{x}^{9}\\,\\text{d}x \\\\  & =M{[\\frac{3}{4}{x}^{4}-\\frac{3}{10}{x}^{10}]}_{0}^{1} \\\\  & =M(\\frac{3}{4}-\\frac{3}{10}) \\\\  & =\\frac{9M}{20}.\\end{aligned}\n$$\n\nTherefore, the radius of gyration about the $x$-axis is\n\n$$\n\\begin{aligned}{R}_{x} & =\\sqrt{\\frac{{I}_{x}}{M}} \\\\  & =\\sqrt{\\frac{9M}{20}\\cdot \\frac{1}{M}} \\\\  & =\\sqrt{\\frac{9}{20}} \\\\  & =\\frac{3}{2\\sqrt{5}} \\\\  & =\\frac{3\\sqrt{5}}{10}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186199262 #edb/ref 1058 #edb/ref 17592186199368 #edb/ref 17592186045417] [17592186199262 #edb/ref 1061 31767 #edb/ref 17592186045417] [17592186199262 #edb/ref 1062 #uuid "76c2c5a5-4cc8-5b16-af7c-3ebae501b962" #edb/ref 17592186045417] [17592186199262 #edb/ref 1063 #edb/ref 17592186199458 #edb/ref 17592186045417] [17592186199344 #edb/ref 1058 #edb/ref 17592186199351 #edb/ref 17592186045417] [17592186199344 #edb/ref 1061 44959 #edb/ref 17592186045417] [17592186199344 #edb/ref 1062 #uuid "b8d3d2ed-b979-53cc-a718-ce66bcb92672" #edb/ref 17592186045417] [17592186199344 #edb/ref 1063 #edb/ref 17592186198417 #edb/ref 17592186045417] [17592186199348 #edb/ref 1061 45033 #edb/ref 17592186045417] [17592186199348 #edb/ref 1062 #uuid "4f7fed02-59a7-5116-a7d3-2d07448fbbfa" #edb/ref 17592186045417] [17592186199348 #edb/ref 1063 #edb/ref 17592186198419 #edb/ref 17592186045417] [17592186199351 #edb/ref 1058 #edb/ref 17592186199348 #edb/ref 17592186045417] [17592186199351 #edb/ref 1061 45077 #edb/ref 17592186045417] [17592186199351 #edb/ref 1062 #uuid "b3e8808b-6d9a-533e-98f7-fae6b2f81961" #edb/ref 17592186045417] [17592186199351 #edb/ref 1063 #edb/ref 17592186198421 #edb/ref 17592186045417] [17592186199368 #edb/ref 1058 #edb/ref 17592186199344 #edb/ref 17592186045417] [17592186199368 #edb/ref 1061 45253 #edb/ref 17592186045417] [17592186199368 #edb/ref 1062 #uuid "b488dfc8-1a77-5eca-8218-1163bb51565d" #edb/ref 17592186045417] [17592186199368 #edb/ref 1063 #edb/ref 17592186199498 #edb/ref 17592186045417] [17592186199458 #edb/ref 1064 "In this lesson, we discuss a concept analogous to *center of mass* that applies to rotating bodies.\n\nRecall that the *center of mass* of a plane lamina is defined as the point $(\\bar{x},\\bar{y})$ in the coordinate plane where the entire mass of the lamina could be concentrated to produce the same *total moment* about the coordinate axes as the original laminar. \n\nAnalogously, the **radius of gyration** of a plane lamina is the distance $R$ from an axis of rotation $L$ that the entire mass $M$ of the lamina would need to be concentrated to produce the same *moment of inertia* as the original lamina. \n\n![](images/c9/c9999bf30a93a857db731488739f0a640edc7b91de907cd772b777489a011fb8.png)\n\nTo derive an explicit formula for the radius of gyration, recall that the moment of inertia of a particle $P$ of mass $m$ at a distance of $r$ from an axis of rotation equals\n\n$$\nmr^2.\n$$\n\nSo, for a particle of mass $M$ at a distance of $R$ from the axis of rotation $L,$ the moment of inertia about $L$ is given by\n\n$$\nMR^2.\n$$\n\nThe radius of gyration is defined as the distance $R$ that a particle of mass $M$ must be placed to give the same moment of inertia as the original lamina. Therefore, it is the solution to the equation\n\n$$\nI = MR^2,\n$$\n\nwhere $I$ is the moment of inertia of the lamina about $L.$\n\nRearranging this equation, we find that the radius of gyration is given by\n\n$$\nR = \\sqrt{\\dfrac{I}{M}}.\n$$" #edb/ref 17592186045417] [17592186199458 #edb/ref 1065 5074 #edb/ref 17592186045417] [17592186199458 #edb/ref 1066 #uuid "9694de04-ca38-5d55-a60f-6663ca34e7cf" #edb/ref 17592186045417] [17592186199458 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186199498 #edb/ref 1064 "In this lesson, we'll limit the axis of rotation to the $x$-axis, the $y$-axis, and the origin. We summarize the key results below:\n\n- The radius of gyration $R_x$ of a lamina about the $x$-axis is given by $R_x = \\sqrt{\\dfrac{I_x}{M}},$ where $I_x$ is the moment of inertia of the lamina about the $x$-axis.\n\n- The radius of gyration $R_y$ of a lamina about the $y$-axis is given by $R_y = \\sqrt{\\dfrac{I_y}{M}},$ where $I_y$ is the moment of inertia of the lamina about the $y$-axis.\n\n- The radius of gyration $R_0$ of a lamina about the origin is given by $R_0 = \\sqrt{\\dfrac{I_0}{M}},$ where $I_0$ is the moment of inertia of the lamina about the origin." #edb/ref 17592186045417] [17592186199498 #edb/ref 1065 7823 #edb/ref 17592186045417] [17592186199498 #edb/ref 1066 #uuid "096487a4-3e7b-571a-94b9-ec4e84d689bd" #edb/ref 17592186045417] [17592186199498 #edb/ref 1067 "A Summary of Key Results" #edb/ref 17592186045417] [17592186278807 #edb/ref 1080 "\\frac{\\sqrt{7}}{2}" #edb/ref 17592186045417] [17592186278807 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278807 #edb/ref 1083 #uuid "186d7b54-9bd8-5d11-9531-f6a71e93a075" #edb/ref 17592186045417] [17592186278825 #edb/ref 1080 "\\frac{\\sqrt{15}}{11}" #edb/ref 17592186045417] [17592186278825 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186278825 #edb/ref 1083 #uuid "1a3d51b7-d2a1-5f5c-a8bc-237dc2ebcf80" #edb/ref 17592186045417] [17592186279022 #edb/ref 1080 "\\frac{4}{5}" #edb/ref 17592186045417] [17592186279022 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186279022 #edb/ref 1083 #uuid "3123b7ca-d40c-5a3f-9f98-6e63415985f2" #edb/ref 17592186045417] [17592186279026 #edb/ref 1080 "\\sqrt{\\frac{5}{22}}" #edb/ref 17592186045417] [17592186279026 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186279026 #edb/ref 1083 #uuid "3164c091-f58c-54eb-aad1-8e0c43c91c30" #edb/ref 17592186045417] [17592186279333 #edb/ref 1080 "\\frac{\\sqrt{11}}{4}" #edb/ref 17592186045417] [17592186279333 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186279333 #edb/ref 1083 #uuid "5162df6b-de8d-5520-abbe-dd93a6e59038" #edb/ref 17592186045417] [17592186279831 #edb/ref 1080 "2\\sqrt{\\frac{2}{3}}" #edb/ref 17592186045417] [17592186279831 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186279831 #edb/ref 1083 #uuid "8ac43d7e-86dc-5795-8a22-dbc422ca5a71" #edb/ref 17592186045417] [17592186279987 #edb/ref 1080 "\\frac{\\sqrt{11}}{4}" #edb/ref 17592186045417] [17592186279987 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186279987 #edb/ref 1083 #uuid "9cdb7243-3730-53b1-89b2-148b6e07ef81" #edb/ref 17592186045417] [17592186280312 #edb/ref 1080 "\\frac{2}{3}" #edb/ref 17592186045417] [17592186280312 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186280312 #edb/ref 1083 #uuid "c37d6da3-3c86-5674-9e53-305507ca31b7" #edb/ref 17592186045417] [17592186280490 #edb/ref 1080 "\\frac{1}{2}\\sqrt{\\frac{21}{5}}" #edb/ref 17592186045417] [17592186280490 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186280490 #edb/ref 1083 #uuid "d708a39e-f2ac-5bfb-ada1-0904857be453" #edb/ref 17592186045417] [17592186280508 #edb/ref 1080 "\\frac{3}{5}" #edb/ref 17592186045417] [17592186280508 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186280508 #edb/ref 1083 #uuid "d8cc174a-d9b8-5495-89b1-4ebe90c0ea93" #edb/ref 17592186045417] [17592186281012 #edb/ref 1075 #edb/ref 17592186278825 #edb/ref 17592186045417] [17592186281012 #edb/ref 1075 #edb/ref 17592186279026 #edb/ref 17592186045417] [17592186281012 #edb/ref 1075 #edb/ref 17592186279333 #edb/ref 17592186045417] [17592186281012 #edb/ref 1075 #edb/ref 17592186280312 #edb/ref 17592186045417] [17592186281012 #edb/ref 1075 #edb/ref 17592186280508 #edb/ref 17592186045417] [17592186281012 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186281012 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186281012 #edb/ref 1078 #edb/ref 17592186279026 #edb/ref 17592186045417] [17592186281012 #edb/ref 1079 #uuid "6784d72f-0415-5f04-8903-764281948f3e" #edb/ref 17592186045417] [17592186281235 #edb/ref 1075 #edb/ref 17592186278807 #edb/ref 17592186045417] [17592186281235 #edb/ref 1075 #edb/ref 17592186279022 #edb/ref 17592186045417] [17592186281235 #edb/ref 1075 #edb/ref 17592186279831 #edb/ref 17592186045417] [17592186281235 #edb/ref 1075 #edb/ref 17592186279987 #edb/ref 17592186045417] [17592186281235 #edb/ref 1075 #edb/ref 17592186280490 #edb/ref 17592186045417] [17592186281235 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186281235 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186281235 #edb/ref 1078 #edb/ref 17592186280490 #edb/ref 17592186045417] [17592186281235 #edb/ref 1079 #uuid "e52c417e-4191-554a-91d8-c604aad807bd" #edb/ref 17592186045417] [17592186281682 #edb/ref 1068 #edb/ref 17592186281235 #edb/ref 17592186045417] [17592186281682 #edb/ref 1069 "q-163600" #edb/ref 17592186045417] [17592186281682 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281682 #edb/ref 1071 "A plate of mass $M$ occupies the region $D$ bounded by the curve $y=\\sqrt{x},$ the line $y=1,$ and the $y$-axis. Its mass density at any point on the plate is given by $\\lambda (x,y)=12Mxy.$ Find the radius of gyration of the plate about the origin." #edb/ref 17592186045417] [17592186281682 #edb/ref 1072 #uuid "ad1b682f-b157-528a-b0f7-855122eb923c" #edb/ref 17592186045417] [17592186281682 #edb/ref 1074 "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the origin is defined as\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function. The region $D$ is a type I region with representation\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,\\,\\sqrt{x}\\le y\\le 1\\}.\n$$\n\nHence, the moment of inertia about the origin is\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{\\sqrt{x}}^{1}({x}^{2}+{y}^{2})\\cdot 12Mxy\\,\\text{d}y\\,\\text{d}x \\\\  & =12M{\\int }_{0}^{1}{\\int }_{\\sqrt{x}}^{1}{x}^{3}y+x{y}^{3}\\,\\text{d}y\\,\\text{d}x \\\\  & =12M{\\int }_{0}^{1}{[\\frac{1}{2}{x}^{3}{y}^{2}+\\frac{1}{4}x{y}^{4}]}_{y=\\sqrt{x}}^{y=1}\\,\\text{d}x \\\\  & =12M{\\int }_{0}^{1}(\\frac{1}{2}{x}^{3}+\\frac{1}{4}x)-(\\frac{1}{2}{x}^{4}+\\frac{1}{4}{x}^{3})\\,\\text{d}x \\\\  & =12M{\\int }_{0}^{1}\\frac{1}{4}x+\\frac{1}{4}{x}^{3}-\\frac{1}{2}{x}^{4}\\,\\text{d}x \\\\  & =12M{[\\frac{1}{8}{x}^{2}+\\frac{1}{16}{x}^{4}-\\frac{1}{10}{x}^{5}]}_{0}^{1} \\\\  & =12M(\\frac{1}{8}+\\frac{1}{16}-\\frac{1}{10}) \\\\  & =12M\\cdot \\frac{7}{80} \\\\  & =\\frac{21M}{20}.\\end{aligned}\n$$\n\nTherefore, the radius of gyration about the origin is\n\n$$\n\\begin{aligned}{R}_{0} & =\\sqrt{\\frac{{I}_{0}}{M}} \\\\  & =\\sqrt{\\frac{21M}{20}\\cdot \\frac{1}{M}} \\\\  & =\\sqrt{\\frac{21}{20}} \\\\  & =\\frac{1}{2}\\sqrt{\\frac{21}{5}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186281686 #edb/ref 1068 #edb/ref 17592186281012 #edb/ref 17592186045417] [17592186281686 #edb/ref 1069 "q-163614" #edb/ref 17592186045417] [17592186281686 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186281686 #edb/ref 1071 "A plate of mass $M$ occupies the region $D$ bounded by the curves $y={x}^{3}$ and $y={x}^{2}.$ Its mass density at any point on the plate is given by $\\lambda (x,y)=20Mx.$ Find the radius of gyration of the plate about the $x$-axis." #edb/ref 17592186045417] [17592186281686 #edb/ref 1072 #uuid "25ae87ad-380a-5a1b-8a33-907df3e00ff1" #edb/ref 17592186045417] [17592186281686 #edb/ref 1074 "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the $x$-axis is defined as\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function. The region $D$ is a type I region with representation\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,\\,{x}^{3}\\le y\\le {x}^{2}\\}.\n$$\n\nHence, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{{x}^{3}}^{{x}^{2}}{y}^{2}\\cdot 20Mx\\,\\text{d}y\\,\\text{d}x \\\\  & =20M{\\int }_{0}^{1}{\\int }_{{x}^{3}}^{{x}^{2}}x{y}^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & =20M{\\int }_{0}^{1}{[\\frac{1}{3}x{y}^{3}]}_{y={x}^{3}}^{y={x}^{2}}\\,\\text{d}x \\\\  & =\\frac{20M}{3}{\\int }_{0}^{1}{x}^{7}-{x}^{10}\\,\\text{d}x \\\\  & =\\frac{20M}{3}{[\\frac{1}{8}{x}^{8}-\\frac{1}{11}{x}^{11}]}_{0}^{1} \\\\  & =\\frac{20M}{3}(\\frac{1}{8}-\\frac{1}{11}) \\\\  & =\\frac{20M}{3}\\cdot \\frac{3}{88} \\\\  & =\\frac{5M}{22}.\\end{aligned}\n$$\n\nTherefore, the radius of gyration about the $x$-axis is\n\n$$\n\\begin{aligned}{R}_{x} & =\\sqrt{\\frac{{I}_{x}}{M}} \\\\  & =\\sqrt{\\frac{5M}{22}\\cdot \\frac{1}{M}} \\\\  & =\\sqrt{\\frac{5}{22}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186282075 #edb/ref 1080 "\\sqrt{2}" #edb/ref 17592186045417] [17592186282075 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186282075 #edb/ref 1083 #uuid "2c11e011-ddea-59e8-8dff-d43e8421c05b" #edb/ref 17592186045417] [17592186282173 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186282173 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186282173 #edb/ref 1083 #uuid "36bb4490-4039-5683-91a8-0a65f669f1e1" #edb/ref 17592186045417] [17592186282346 #edb/ref 1080 "\\sqrt{\\frac{52}{41}}" #edb/ref 17592186045417] [17592186282346 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186282346 #edb/ref 1083 #uuid "4c85455b-d139-5529-bab2-45b2402995e5" #edb/ref 17592186045417] [17592186282355 #edb/ref 1080 "\\sqrt{\\frac{67}{60}}" #edb/ref 17592186045417] [17592186282355 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186282355 #edb/ref 1083 #uuid "4d3d630b-464d-5f06-83fd-c3957186b264" #edb/ref 17592186045417] [17592186282425 #edb/ref 1080 "\\sqrt{\\frac{3}{2}}" #edb/ref 17592186045417] [17592186282425 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186282425 #edb/ref 1083 #uuid "56d26e9d-75f1-50b6-8862-bb604ee95175" #edb/ref 17592186045417] [17592186283553 #edb/ref 1080 "\\frac{1}{3}" #edb/ref 17592186045417] [17592186283553 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186283553 #edb/ref 1083 #uuid "d64f12cb-2342-5b14-a877-2b90fa45fea0" #edb/ref 17592186045417] [17592186283574 #edb/ref 1080 "\\sqrt{\\frac{7}{5}}" #edb/ref 17592186045417] [17592186283574 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186283574 #edb/ref 1083 #uuid "d843aee0-301b-5b09-a077-abfdb2a72f16" #edb/ref 17592186045417] [17592186283701 #edb/ref 1080 "\\sqrt{\\frac{17}{15}}" #edb/ref 17592186045417] [17592186283701 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186283701 #edb/ref 1083 #uuid "e735c20e-83c3-513b-a594-3908a91217d7" #edb/ref 17592186045417] [17592186283808 #edb/ref 1080 "\\sqrt{\\frac{3}{5}}" #edb/ref 17592186045417] [17592186283808 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186283808 #edb/ref 1083 #uuid "f291a168-3756-5501-8c49-8ca24e7425b9" #edb/ref 17592186045417] [17592186283809 #edb/ref 1080 "\\sqrt{\\frac{93}{70}}" #edb/ref 17592186045417] [17592186283809 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186283809 #edb/ref 1083 #uuid "f2a31c4e-3057-59d9-9eff-b136a1e834fe" #edb/ref 17592186045417] [17592186283973 #edb/ref 1075 #edb/ref 17592186282075 #edb/ref 17592186045417] [17592186283973 #edb/ref 1075 #edb/ref 17592186282173 #edb/ref 17592186045417] [17592186283973 #edb/ref 1075 #edb/ref 17592186282425 #edb/ref 17592186045417] [17592186283973 #edb/ref 1075 #edb/ref 17592186283553 #edb/ref 17592186045417] [17592186283973 #edb/ref 1075 #edb/ref 17592186283808 #edb/ref 17592186045417] [17592186283973 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186283973 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186283973 #edb/ref 1078 #edb/ref 17592186282173 #edb/ref 17592186045417] [17592186283973 #edb/ref 1079 #uuid "131473c8-21f1-5275-8cd8-8aaf77c5c763" #edb/ref 17592186045417] [17592186283984 #edb/ref 1075 #edb/ref 17592186282346 #edb/ref 17592186045417] [17592186283984 #edb/ref 1075 #edb/ref 17592186282355 #edb/ref 17592186045417] [17592186283984 #edb/ref 1075 #edb/ref 17592186283574 #edb/ref 17592186045417] [17592186283984 #edb/ref 1075 #edb/ref 17592186283701 #edb/ref 17592186045417] [17592186283984 #edb/ref 1075 #edb/ref 17592186283809 #edb/ref 17592186045417] [17592186283984 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186283984 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186283984 #edb/ref 1078 #edb/ref 17592186283809 #edb/ref 17592186045417] [17592186283984 #edb/ref 1079 #uuid "17a94be4-e4e1-5140-99a8-e71aa3065376" #edb/ref 17592186045417] [17592186284392 #edb/ref 1068 #edb/ref 17592186283984 #edb/ref 17592186045417] [17592186284392 #edb/ref 1069 "q-163645" #edb/ref 17592186045417] [17592186284392 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186284392 #edb/ref 1071 "A plate of mass $M$ occupies region bounded by two circles ${x}^{2}+{y}^{2}=1$ and ${x}^{2}+{y}^{2}=4.$ Its mass density at any point is given by $\\lambda (x,y)=\\frac{3}{14\\pi }M\\sqrt{{x}^{2}+{y}^{2}}.$ Find the radius of gyration of the plate about the $x$-axis." #edb/ref 17592186045417] [17592186284392 #edb/ref 1072 #uuid "f598df43-5e0b-5786-812e-47618ac821c2" #edb/ref 17592186045417] [17592186284392 #edb/ref 1074 "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nIn polar coordinates, the region occupied by the plate is given by\n\n$$\nD=\\{(r,\\theta )\\,:\\,1\\le r\\le 2,\\,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nThe moment of inertia about the $x$-axis, in polar coordinates, is defined as\n\n$$\n{I}_{x}={∬}_{D}\\lambda (r,\\theta ){r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta ,\n$$\n\nwhere $\\lambda (r,\\theta )$ is the mass density function.\n\nAlso, the mass density in terms of polar coordinates is $\\lambda (r,\\theta )=\\frac{3}{14\\pi }Mr.$\nTherefore, the moment of inertia about the $y$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}\\lambda (r,\\theta ){r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{3}{14\\pi }M{\\int }_{0}^{2\\pi }{\\int }_{1}^{2}{r}^{4}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{3M}{14\\pi }({\\int }_{1}^{2}{r}^{4}\\,\\text{d}r)({\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta ) \\\\  & =\\frac{3M}{14\\pi }\\cdot \\frac{1}{5}{r}^{5}{|}_{1}^{2}\\cdot ({\\int }_{0}^{2\\pi }\\frac{(1-\\operatorname{cos}⁡2\\theta )}{2}\\,\\text{d}\\theta ) \\\\  & =\\frac{3M}{14\\pi }\\cdot \\frac{31}{5}\\cdot {[\\frac{1}{2}\\theta -\\frac{1}{4}\\operatorname{sin}⁡2\\theta ]}_{0}^{2\\pi } \\\\  & =\\frac{3M}{14\\pi }\\cdot \\frac{31}{5}\\cdot \\pi  \\\\  & =\\frac{93M}{70}.\\end{aligned}\n$$\n\nTherefore, the radius of gyration about the $x$-axis is\n\n$$\n\\begin{aligned}{R}_{x} & =\\sqrt{\\frac{{I}_{x}}{M}} \\\\  & =\\sqrt{\\frac{93M}{70}\\cdot \\frac{1}{M}} \\\\  & =\\sqrt{\\frac{93}{70}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186284397 #edb/ref 1068 #edb/ref 17592186283973 #edb/ref 17592186045417] [17592186284397 #edb/ref 1069 "q-163658" #edb/ref 17592186045417] [17592186284397 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186284397 #edb/ref 1071 "A plate of mass $M$ occupies the circle ${x}^{2}+{y}^{2}=3.$ Its mass density at any point is given by $\\lambda (x,y)=\\frac{2}{9\\pi }M({x}^{2}+{y}^{2}).$ Find the radius of gyration of the plate about the $y$-axis." #edb/ref 17592186045417] [17592186284397 #edb/ref 1072 #uuid "2bedf3e3-7671-5f19-9c93-56fbbbe7e210" #edb/ref 17592186045417] [17592186284397 #edb/ref 1074 "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nIn polar coordinates, the region occupied by the plate is given by\n\n$$\nD=\\{(r,\\theta )\\,:\\,0\\le r\\le \\sqrt{3},\\,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nThe moment of inertia about the $y$-axis, in polar coordinates, is defined as\n\n$$\n{I}_{y}={∬}_{D}\\lambda (r,\\theta ){r}^{3}{cos}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta ,\n$$\n\nwhere $\\lambda (r,\\theta )$ is the mass density function.\n\nAlso, the mass density in terms of polar coordinates is $\\lambda (r,\\theta )=\\frac{2}{9\\pi }M{r}^{2}.$\nTherefore, the moment of inertia about the $y$-axis is\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}\\lambda (r,\\theta ){r}^{3}{cos}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{2}{9\\pi }M{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\sqrt{3}}{r}^{5}{cos}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{2}{9\\pi }M({\\int }_{0}^{\\sqrt{3}}{r}^{5}\\,\\text{d}r)({\\int }_{0}^{2\\pi }{cos}^{2}⁡\\theta \\,\\text{d}\\theta ) \\\\  & =\\frac{2}{9\\pi }M\\cdot \\frac{1}{6}{r}^{6}{|}_{0}^{\\sqrt{3}}({\\int }_{0}^{2\\pi }\\frac{1+\\operatorname{cos}⁡2\\theta }{2}\\,\\text{d}\\theta ) \\\\  & =\\frac{2}{9\\pi }M\\cdot \\frac{9}{2}\\cdot {[\\frac{\\theta }{2}+\\frac{\\operatorname{sin}⁡2\\theta }{4}]}_{0}^{2\\pi } \\\\  & =\\frac{M}{\\pi }\\cdot \\pi  \\\\  & =M.\\end{aligned}\n$$\n\nTherefore, the radius of gyration about the $x$-axis is\n\n$$\n\\begin{aligned}{R}_{y} & =\\sqrt{\\frac{{I}_{y}}{M}} \\\\  & =\\sqrt{M\\cdot \\frac{1}{M}} \\\\  & =1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186324382 #edb/ref 1080 "\\frac{3\\sqrt{5}}{5}" #edb/ref 17592186045417] [17592186324382 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324382 #edb/ref 1083 #uuid "3351a977-67e9-5729-9f52-df2558d96ff9" #edb/ref 17592186045417] [17592186325222 #edb/ref 1080 "\\frac{3\\sqrt{5}}{10}" #edb/ref 17592186045417] [17592186325222 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325222 #edb/ref 1083 #uuid "932f7c2b-3f40-5389-ac98-de506f230f12" #edb/ref 17592186045417] [17592186325584 #edb/ref 1080 "\\frac{3\\sqrt{10}}{10}" #edb/ref 17592186045417] [17592186325584 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325584 #edb/ref 1083 #uuid "bbae2ed1-86a0-5ff8-863e-27c615c837ef" #edb/ref 17592186045417] [17592186325591 #edb/ref 1080 "\\frac{\\sqrt{35}}{10}" #edb/ref 17592186045417] [17592186325591 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325591 #edb/ref 1083 #uuid "bcb93644-b3b1-5875-9679-fff47517c804" #edb/ref 17592186045417] [17592186326136 #edb/ref 1080 "\\frac{\\sqrt{70}}{10}" #edb/ref 17592186045417] [17592186326136 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186326136 #edb/ref 1083 #uuid "f5ca1dc1-4e5c-551b-b50e-860d36431c9c" #edb/ref 17592186045417] [17592186326355 #edb/ref 1075 #edb/ref 17592186324382 #edb/ref 17592186045417] [17592186326355 #edb/ref 1075 #edb/ref 17592186325222 #edb/ref 17592186045417] [17592186326355 #edb/ref 1075 #edb/ref 17592186325584 #edb/ref 17592186045417] [17592186326355 #edb/ref 1075 #edb/ref 17592186325591 #edb/ref 17592186045417] [17592186326355 #edb/ref 1075 #edb/ref 17592186326136 #edb/ref 17592186045417] [17592186326355 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186326355 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186326355 #edb/ref 1078 #edb/ref 17592186325222 #edb/ref 17592186045417] [17592186326355 #edb/ref 1079 #uuid "50936af7-7240-5cd9-ace8-59f75d8060e9" #edb/ref 17592186045417] [17592186369943 #edb/ref 1068 #edb/ref 17592186369944 #edb/ref 17592186045417] [17592186369943 #edb/ref 1069 "q-163647" #edb/ref 17592186045417] [17592186369943 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186369943 #edb/ref 1071 "![](images/f7/f7232aba64209d02a92806df522484a1e233b4ad083bd2479a4e9bfabd7b3e63.png)\n\nA plate of mass $M$ occupies region bounded by two circles ${x}^{2}+{y}^{2}=1$ and ${x}^{2}+{y}^{2}=4$ and two lines $y=x$ and $y=-x$ in the first and second quadrant, as shown above. Its mass density at any point is given by $\\lambda (x,y)=\\frac{M\\sqrt{{x}^{2}+{y}^{2}}}{2{y}^{2}}.$ Find the radius of gyration of the plate about the $x$-axis." #edb/ref 17592186045417] [17592186369943 #edb/ref 1072 #uuid "067d7788-9583-5931-934f-e2fcc0afe2cd" #edb/ref 17592186045417] [17592186369943 #edb/ref 1074 "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nIn polar coordinates, the region occupied by the plate is given by\n\n$$\nD=\\{(r,\\theta )\\,:\\,1\\le r\\le 2,\\,\\,\\frac{\\pi }{4}\\le \\theta \\le \\frac{3\\pi }{4}\\}.\n$$\n\nThe moment of inertia about the $x$-axis, in polar coordinates, is defined as\n\n$$\n{I}_{x}={∬}_{D}\\lambda (r,\\theta ){r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta ,\n$$\n\nwhere $\\lambda (r,\\theta )$ is the mass density function.\n\nAlso, the mass density in terms of polar coordinates is $\\lambda (r,\\theta )=\\frac{M}{2r{sin}^{2}⁡\\theta }.$\nTherefore, the moment of inertia about the $y$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}\\lambda (r,\\theta ){r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{M}{2}{\\int }_{\\pi /4}^{3\\pi /4}{\\int }_{1}^{2}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{M}{2}({\\int }_{1}^{2}{r}^{2}\\,\\text{d}r)({\\int }_{\\pi /4}^{3\\pi /4}\\,\\text{d}\\theta ) \\\\  & =\\frac{M}{2}\\cdot \\frac{1}{3}{r}^{3}{|}_{1}^{2}\\cdot \\theta {|}_{\\pi /4}^{3\\pi /4} \\\\  & =\\frac{M}{2}\\cdot \\frac{7}{3}\\cdot \\frac{\\pi }{2} \\\\  & =\\frac{7\\pi M}{12}.\\end{aligned}\n$$\n\nTherefore, the radius of gyration about the $x$-axis is\n\n$$\n\\begin{aligned}{R}_{x} & =\\sqrt{\\frac{{I}_{x}}{M}} \\\\  & =\\sqrt{\\frac{7\\pi M}{12}\\cdot \\frac{1}{M}} \\\\  & =\\frac{1}{2}\\sqrt{\\frac{7\\pi }{3}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186369944 #edb/ref 1075 #edb/ref 17592186369945 #edb/ref 17592186045417] [17592186369944 #edb/ref 1075 #edb/ref 17592186369946 #edb/ref 17592186045417] [17592186369944 #edb/ref 1075 #edb/ref 17592186369947 #edb/ref 17592186045417] [17592186369944 #edb/ref 1075 #edb/ref 17592186369948 #edb/ref 17592186045417] [17592186369944 #edb/ref 1075 #edb/ref 17592186369949 #edb/ref 17592186045417] [17592186369944 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186369944 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186369944 #edb/ref 1078 #edb/ref 17592186369949 #edb/ref 17592186045417] [17592186369944 #edb/ref 1079 #uuid "830fee00-f820-56a3-8ac9-9fc9427d0db6" #edb/ref 17592186045417] [17592186369945 #edb/ref 1080 "\\sqrt{\\frac{5\\pi }{6}}" #edb/ref 17592186045417] [17592186369945 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369945 #edb/ref 1083 #uuid "e0262f9a-c23f-5c35-a027-03b3fc81a75c" #edb/ref 17592186045417] [17592186369946 #edb/ref 1080 "3\\sqrt{\\frac{5\\pi }{2}}" #edb/ref 17592186045417] [17592186369946 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369946 #edb/ref 1083 #uuid "9f361312-5827-5b0a-b58d-b9eddb41de0b" #edb/ref 17592186045417] [17592186369947 #edb/ref 1080 "\\sqrt{\\frac{7\\pi }{5}}" #edb/ref 17592186045417] [17592186369947 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369947 #edb/ref 1083 #uuid "8c081c70-f75d-5718-b946-60bbec11cfd6" #edb/ref 17592186045417] [17592186369948 #edb/ref 1080 "\\frac{1}{2}\\sqrt{\\frac{3\\pi }{2}}" #edb/ref 17592186045417] [17592186369948 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369948 #edb/ref 1083 #uuid "1a6e95a5-bbc3-5d39-9bea-68dc8e2271a2" #edb/ref 17592186045417] [17592186369949 #edb/ref 1080 "\\frac{1}{2}\\sqrt{\\frac{7\\pi }{3}}" #edb/ref 17592186045417] [17592186369949 #