#{[{:db/id #edb/ref 17592186240907 :knowledge-point/_questions [{:db/id #edb/ref 17592186133890 :knowledge-point/id #uuid "c4519f3b-0fb8-54fd-9e9e-fca3e599b80b" :knowledge-point/title "Applying the Fundamental Theorem of Line Integrals Over Cartesian Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "324fc058-3716-52e2-915c-a8ff8548ce66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}-e" :db/id #edb/ref 17592186238492} {:answer/id #uuid "40f10544-0cd1-50c6-9897-c035b59965c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186238616} {:answer/id #uuid "99009bfa-183e-50ad-b31d-4a8cd8b1b4fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+e" :db/id #edb/ref 17592186239384} {:answer/id #uuid "ae9e232f-a132-5ae1-a985-ee43b1e859ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-{e}^{4}" :db/id #edb/ref 17592186239575} {:answer/id #uuid "b4578f1a-d647-5132-b9c6-b097afd1fc07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186239632}] :answer-field/correct {:answer/id #uuid "b4578f1a-d647-5132-b9c6-b097afd1fc07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186239632} :answer-field/id #uuid "0bc00398-8a1c-5911-a2b1-71601fb149ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240344}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45e3e133-a99c-58ca-b74f-4cbfe235bb72" :question/math-academy-id "q-104625" :question/problem "Let $f(x,y)={e}^{x}\\operatorname{sin}⁡(\\frac{\\pi y}{2}).$ Given that $C$ is the path along the curve $y={x}^{3}+1$ for $x\\in [1,2],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\nWe start by parametrizing the curve $C.$ A suitable parametrization is\n\n$$\nr(t)=⟨t,{t}^{3}+1⟩,\\,t\\in [1,2].\n$$\n\nThen, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(1) & =⟨1,2⟩, \\\\ r(2) & =⟨2,9⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(1,2)$ and $(2,9).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(2))-f(r(1)) \\\\  & =f(2,9)-f(1,2) \\\\  & ={e}^{2}\\cdot \\operatorname{sin}⁡(\\frac{9\\pi }{2})-{e}^{1}\\cdot \\operatorname{sin}⁡(\\frac{2\\pi }{2}) \\\\  & ={e}^{2}\\cdot 1-{e}^{1}\\cdot 0 \\\\  & ={e}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259584 :knowledge-point/_questions [{:db/id #edb/ref 17592186133878 :knowledge-point/id #uuid "7b643761-8eab-5bd3-a5f5-c85b6ba34a61" :knowledge-point/title "Applying the Fundamental Theorem of Line Integrals Over Parametric Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "302b8581-4a68-5c5c-8795-9744e9d4a2d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "76" :db/id #edb/ref 17592186257206} {:answer/id #uuid "953e0310-1f6a-5dcb-9428-9966108f8f1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "98" :db/id #edb/ref 17592186258094} {:answer/id #uuid "b72e2f4d-4041-5680-a701-550b3147bc12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "87" :db/id #edb/ref 17592186258378} {:answer/id #uuid "ca82cadd-75e5-598b-bacc-17ec432f7824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "109" :db/id #edb/ref 17592186258541} {:answer/id #uuid "f5b95c82-3200-5da8-b666-432aa9c1aa8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "106" :db/id #edb/ref 17592186258928}] :answer-field/correct {:answer/id #uuid "f5b95c82-3200-5da8-b666-432aa9c1aa8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "106" :db/id #edb/ref 17592186258928} :answer-field/id #uuid "0b2dc29a-3749-5531-9860-c3324dac8a28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259054}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "003b8481-988f-56eb-a4c6-1362503d86f0" :question/math-academy-id "q-124002" :question/problem "Let $f(x,y)={x}^{2}{y}^{2}+x+y.$ Given that $C$ is the path along the curve $r(t)=⟨\\sqrt{t},t+1⟩$ for $t\\in [0,4],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,1⟩ \\\\ r(4) & =⟨2,5⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,1)$ and $(2,5).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(4))-f(r(0)) \\\\  & =f(2,5)-f(0,1) \\\\  & =({2}^{2}\\cdot {5}^{2}+2+5)-({0}^{2}\\cdot {1}^{2}+0+1) \\\\  & =107-1 \\\\  & =106.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259585 :knowledge-point/_questions [{:db/id #edb/ref 17592186133878 :knowledge-point/id #uuid "7b643761-8eab-5bd3-a5f5-c85b6ba34a61" :knowledge-point/title "Applying the Fundamental Theorem of Line Integrals Over Parametric Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eea1d61-c31a-52a0-9c80-b705eeabdf54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e+1" :db/id #edb/ref 17592186256925} {:answer/id #uuid "32a24c80-640c-5f96-9d30-3886433c358a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+e" :db/id #edb/ref 17592186257225} {:answer/id #uuid "89fe846b-c77b-5114-acc8-ae328a43149b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e" :db/id #edb/ref 17592186257994} {:answer/id #uuid "d080e35c-13c8-5910-bdbc-1433606170a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{2}" :db/id #edb/ref 17592186258595} {:answer/id #uuid "de2288dd-737a-5b6e-99cf-5d7174075a26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}-1" :db/id #edb/ref 17592186258714}] :answer-field/correct {:answer/id #uuid "d080e35c-13c8-5910-bdbc-1433606170a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{2}" :db/id #edb/ref 17592186258595} :answer-field/id #uuid "13ff9e85-14c9-5103-9111-1d260075e876" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259067}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c23e8787-68ef-58ab-bf57-8f769ed64353" :question/math-academy-id "q-124003" :question/problem "Let $f(x,y)=y{e}^{2x}.$ Given that $C$ is the path along the curve $r(t)=⟨t,3{t}^{2}⟩$ for $t\\in [0,1],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,0⟩ \\\\ r(1) & =⟨1,3⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,0)$ and $(1,3).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(1))-f(r(0)) \\\\  & =f(1,3)-f(0,0) \\\\  & =(3{e}^{2\\cdot 1})-(0\\cdot {e}^{2(0)}) \\\\  & =3{e}^{2}-0 \\\\  & =3{e}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259587 :knowledge-point/_questions [{:db/id #edb/ref 17592186133878 :knowledge-point/id #uuid "7b643761-8eab-5bd3-a5f5-c85b6ba34a61" :knowledge-point/title "Applying the Fundamental Theorem of Line Integrals Over Parametric Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "543ba384-51b6-557c-bf16-43ac82ca0e5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}+3e" :db/id #edb/ref 17592186257502} {:answer/id #uuid "bfd16522-1981-538e-a666-611647c995ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{e}^{2}-2" :db/id #edb/ref 17592186258455} {:answer/id #uuid "e2c6cd51-6e8f-5103-b8e1-9cf9c4743823" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}+2e-3" :db/id #edb/ref 17592186258755} {:answer/id #uuid "ebc320e3-b118-5e6b-bdc4-5e336a48b133" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}-2" :db/id #edb/ref 17592186258824} {:answer/id #uuid "f7bffceb-ddbe-55f4-ac78-cfd9d1162748" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3e-3" :db/id #edb/ref 17592186258955}] :answer-field/correct {:answer/id #uuid "e2c6cd51-6e8f-5103-b8e1-9cf9c4743823" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}+2e-3" :db/id #edb/ref 17592186258755} :answer-field/id #uuid "63cb2a76-38cc-5ba0-833b-b7d3644b3675" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259204}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "26e83fe0-4239-5444-b048-589ba5747a08" :question/math-academy-id "q-124008" :question/problem "Let $f(x,y,z)={e}^{x}+{e}^{y}+{e}^{z}.$ Given that $C$ is the path along the curve $r(t)=⟨t,{t}^{2},2{t}^{3}⟩$ for $t\\in [0,1],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,0,0⟩ \\\\ r(1) & =⟨1,1,2⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,0,0)$ and $(1,1,2).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(1))-f(r(0)) \\\\  & =f(1,1,2)-f(0,0,0) \\\\  & =({e}^{1}+{e}^{1}+{e}^{2})-({e}^{0}+{e}^{0}+{e}^{0}) \\\\  & =(2e+{e}^{2})-3 \\\\  & ={e}^{2}+2e-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134236 :knowledge-point/_questions [{:db/id #edb/ref 17592186133890 :knowledge-point/id #uuid "c4519f3b-0fb8-54fd-9e9e-fca3e599b80b" :knowledge-point/title "Applying the Fundamental Theorem of Line Integrals Over Cartesian Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41011d94-bc36-5377-837a-407beee2c7d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\pi }^{5}-1" :db/id #edb/ref 17592186324496} {:answer/id #uuid "cf9dda28-e794-5e5b-a487-30e79ca01306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\pi }^{2}({\\pi }^{3}-1)" :db/id #edb/ref 17592186325775} {:answer/id #uuid "d96c59c5-5422-5219-a8e3-f9082dc413ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi ({\\pi }^{3}-2)" :db/id #edb/ref 17592186325864} {:answer/id #uuid "d9734389-fc6e-5cc3-bc9b-423f0f252b71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\pi }^{2}({\\pi }^{2}-3)" :db/id #edb/ref 17592186325866} {:answer/id #uuid "d9cab25b-2879-5d7f-974c-d9ca4022e0ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\pi }^{2}({\\pi }^{3}-3)" :db/id #edb/ref 17592186325868}] :answer-field/correct {:answer/id #uuid "d9cab25b-2879-5d7f-974c-d9ca4022e0ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\pi }^{2}({\\pi }^{3}-3)" :db/id #edb/ref 17592186325868} :answer-field/id #uuid "1bbf6d50-6f3e-5cf9-904b-81299d3aca6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326272}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "119e34da-cc6f-596d-82b2-8381c511738d" :question/math-academy-id "q-39749" :question/problem "Let $f(x,y)={x}^{2}y.$ Given that $C$ is the path along the curve $y=\\operatorname{cos}⁡x+{x}^{3}-2$ for $x\\in [0,\\pi ],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nWe start by parametrizing the curve $C.$ A suitable parametrization is\n\n$$\nr(t)=⟨t,\\operatorname{cos}⁡t+{t}^{3}-2⟩,\\,t\\in [0,\\pi ].\n$$\n\nThen, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,-1⟩, \\\\ r(\\pi ) & =⟨\\pi ,{\\pi }^{3}-3⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,-1)$ and $(\\pi ,{\\pi }^{3}-3).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(\\pi ))-f(r(0)) \\\\  & =f(\\pi ,{\\pi }^{3}-3)-f(0,0) \\\\  & ={\\pi }^{2}\\cdot ({\\pi }^{3}-3)-{0}^{2}\\cdot 0 \\\\  & ={\\pi }^{2}({\\pi }^{3}-3).\\end{aligned}\n$$"}]}
