      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14253507/observations/step-q21275-ddffae386dd687646fe8.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14253507/observations/step-q21275-ddffae386dd687646fe8.png",
      "source_url": "https://mathacademy.com/tasks/14253507/topics/1043/review",
      "captured_at": 1792149121.8613102,
      "math_academy_id": "q-21275",
      "topic_id": "1043",
      "sequence_position": null,
