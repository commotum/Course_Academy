      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14253507/observations/step-q10206-10b867c27878021d43ef.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14253507/observations/step-q10206-10b867c27878021d43ef.png",
      "source_url": "https://mathacademy.com/tasks/14253507/topics/1043/review",
      "captured_at": 1792149050.9695094,
