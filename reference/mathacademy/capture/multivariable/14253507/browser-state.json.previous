          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:40px;\n                                        margin-left:4px;\n                                        margin-right:0px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"1\"><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"3\"><span class=\"mq-numerator\" mathquill-block-id=\"5\"><span class=\"mq-nonSymbola\" mathquill-command-id=\"4\">π</span></span><span class=\"mq-denominator\" mathquill-block-id=\"7\"><span mathquill-command-id=\"6\">4</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
          "rendered_text": "π4​",
