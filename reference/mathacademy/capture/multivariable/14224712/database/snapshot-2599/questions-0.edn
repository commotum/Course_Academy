#{[{:db/id #edb/ref 17592186360827 :knowledge-point/_questions [{:db/id #edb/ref 17592186166887 :knowledge-point/id #uuid "8a03ad88-dc53-582c-b2ed-1aeb0ee2d0f5" :knowledge-point/title "Computing a Binomial Probability Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1757289e-0855-595f-9588-9fbbdc1ac9b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0170" :db/id #edb/ref 17592186357954} {:answer/id #uuid "48971816-b3a4-50b7-bba0-300278ce79b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0016" :db/id #edb/ref 17592186358373} {:answer/id #uuid "7c82e5f7-f27d-5840-a6b8-3eb28d78e6ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0030" :db/id #edb/ref 17592186358830} {:answer/id #uuid "8dcdf750-3b7b-5ae1-882c-ee9009f8df4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0084" :db/id #edb/ref 17592186358987} {:answer/id #uuid "b9cf1c6a-e88c-5068-8968-1fd2e27e2e7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0154" :db/id #edb/ref 17592186359363}] :answer-field/correct {:answer/id #uuid "48971816-b3a4-50b7-bba0-300278ce79b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0016" :db/id #edb/ref 17592186358373} :answer-field/id #uuid "b1c7f7e5-eeb2-5311-b80b-866939de58a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360308}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a2f49332-b965-5b6e-9513-00e213772e19" :question/math-academy-id "q-97510" :question/problem "Given that $X∼B(6,0.2),$ compute $P(X>4).$" :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(6,0.2),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{6}{x})(0.2)^{x}(0.8)^{6-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X>4) & =P(X\\in {5,6}) \\\\  & =f(5)+f(6) \\\\  & =(\\genfrac{}{}{0pt}{}{6}{5})(0.2)^{5}(0.8)^{6-5}+(\\genfrac{}{}{0pt}{}{6}{6})(0.2)^{6}(0.8)^{6-6} \\\\  & =6(0.2)^{5}(0.8)+1(0.2)^{6}(0.8)^{0} \\\\  & =0.0016.\\end{aligned}\n$$"}]}
