      "raw_html": "<div class=\"question\" id=\"question-332968\"><div class=\"questionHeader\"><span class=\"questionNumber\">3.</span><span class=\"helpButton\" questionid=\"332968\">?</span></div><div class=\"questionText\"><p>Which statement correctly describes an <strong>asymptotically stable</strong> equilibrium point?</p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Sun, Oct 11th @ 10:17 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:12</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>",
      "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14120884/repairs/completeness-3a664355ebebc796/source/acfc63154f2d4d69ed475b6c3babd6f30e309a6e18ec9fcc510d3a189ac6efa3.html",
      "recovery": {
        "extractor_sha256": "af03036879151d6bc1d8a980c3dbf01d042d978e39d96a25bdfe63cd50ef1a10",
