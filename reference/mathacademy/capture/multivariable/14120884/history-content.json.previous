50 -11 231 -11Q185 -11 150 11T104 82Q103 89 103 113Q103 170 138 262T173 379Q173 380 173 381Q173 390 173 393T169 400T158 404H154Q131 404 112 385T82 344T65 302T57 280Q55 278 41 278H27Q21 284 21 287Z\" id=\"E22-MJMATHI-79\" stroke-width=\"1\"></path>\n<path d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\" id=\"E22-MJMAIN-3D\" stroke-width=\"1\"></path>\n<path d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\" id=\"E22-MJMAIN-31\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E22-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E22-MJMATHI-79\" y=\"0\"></use>\n<use x=\"775\" xlink:href=\"#E22-MJMAIN-3D\" y=\"0\"></use>\n<g transform=\"translate(1831,0)\">\n<use xlink:href=\"#E22-MJMAIN-31\"></use>\n<use x=\"500\" xlink:href=\"#E22-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</g>\n</svg></span> </p>\n</li>\n</ul>\n<p>Therefore, the system has a single equilibrium point <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-23-Title\" focusable=\"false\" height=\"6.176ex\" role=\"img\" style=\"vertical-align: -2.505ex;\" viewbox=\"0 -1580.7 4721.7 2659.1\" width=\"10.967ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-23-Title\">\\mathbf{x}^\\ast = <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"5\" display=\"true\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\" di