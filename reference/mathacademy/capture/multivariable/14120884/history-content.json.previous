16 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\" id=\"E3-MJMAIN-2217\" stroke-width=\"1\"></path>\n<path d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\" id=\"E3-MJMAIN-2C\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E3-MJMAINB-78\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"859\" xlink:href=\"#E3-MJMAIN-2217\" y=\"513\"></use>\n<use x=\"1061\" xlink:href=\"#E3-MJMAIN-2C\" y=\"0\"></use>\n</g>\n</svg></span> there exists a neighborhood <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-4-Title\" focusable=\"false\" height=\"2.384ex\" role=\"img\" style=\"vertical-align: -0.505ex;\" viewbox=\"0 -809.3 3315 1026.6\" width=\"7.699ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-4-Title\">O_1 \\subseteq O</title>\n<defs aria-hidden=\"true\">\n<path d=\"M740 435Q740 320 676 213T511 42T304 -22Q207 -22 138 35T51 201Q50 209 50 244Q50 346 98 438T227 601Q351 704 476 704Q514 704 524 703Q621 689 680 617T740 435ZM637 476Q637 565 591 615T476 665Q396 665 322 605Q242 542 200 428T157 216Q157 126 200 73T314 19Q404 19 485 98T608 313Q637 408 637 476Z\" id=\"E4-MJMATHI-4F\" stroke-width=\"1\"></path>\n<path d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\" id=\"E4-MJMAIN-31\" stroke-width=\"1\"></path>\n<path d=\"M84 346Q84 468 166 546T360 635Q361 635 370 635T395 635T430 636T475 636T524 636H679Q694 628 694 616Q694 607 681 597L522 596H470H441Q366 596 338 592T266 568Q244 557 224 542T179 500T139 433T124 346V341Q124 253 185 185Q244 121 328 103Q348 98 366 98T522 96H681Q694 86 694 76Q694 64 679 56H526Q510 56 480 56T434 55Q350 55 289 71T172 141Q84 223 84 346ZM104 -131T104 -118T118 -98H679Q694 -106 694 -118T679 -138H118Q104 -131 104 -118Z\" id=\"E4-MJMAIN-2286\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E4-MJMATHI-4F\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"1079\" xlink:href=\"#E4-MJMAIN-31\" y=\"-213\"></use>\n<use x=\"1495\" xlink:href=\"#E4-MJMAIN-2286\" y=\"0\"></use>\n<use x=\"2551\" xlink:href=\"#E4-MJMATHI-4F\" y=\"0\"></use>\n</g>\n</svg></span> such that every orbit that begins inside <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-5-Title\" focusable=\"false\" height=\"2.384ex\" role=\"img\" style=\"vertical-align: -0.505ex;\" viewbox=\"0 -809.3 1217.4 1026.6\" width=\"2.828ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-5-Title\">O_1</title>\n<defs aria-hidden=\"true\">\n<path d=\"M740 435Q740 320 676 213T511 42T304 -22Q207 -22 138 35T51 201Q50 209 50 244Q50 346 98 438T227 601Q351 704 476 704Q514 704 524 703Q621 689 680 617T740 435ZM637 476Q637 565 591 615T476 665Q396 665 322 605Q242 542 200 428T157 216Q157 126 200 73T314 19Q404 19 485 98T608 313Q637 408 637 476Z\" id=\"E5-MJMATHI-4F\" stroke-width=\"1\"></path>\n<path d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\" id=\"E5-MJMAIN-31\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E5-MJMATHI-4F\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"1079\" xlink:href=\"#E5-MJMAIN-31\" y=\"-213\"></use>\n</g>\n</svg></span> at some point in time <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-6-Title\" focusable=\"false\" height=\"2.259ex\" role=\"img\" style=\"vertical-align: -0.63ex;\" viewbox=\"0 -701.7 2511 972.7\" width=\"5.832ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-6-Title\">t=t_0</title>\n<defs aria-hidden=\"true\">\n<path d=\"M26 385Q19 392 19 395Q19 399 22 411T27 425Q29 430 36 430T87 431H140L159 511Q162 522 166 540T173 566T179 586T187 603T197 615T211 624T229 626Q247 625 254 615T261 596Q261 589 252 549T232 470L222 433Q222 431 272 431H323Q330 424 330 420Q330 398 317 385H210L174 240Q135 80 135 68Q135 26 162 26Q197 26 230 60T283 144Q285 150 288 151T303 153H307Q322 153 322 145Q322 142 319 133Q314 117 301 95T267 48T216 6T155 -11Q125 -11 98 4T59 56Q57 64 57 83V101L92 241Q127 382 128 383Q128 385 77 385H26Z\" id=\"E6-MJMATHI-74\" stroke-width=\"1\"></path>\n<path d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\" id=\"E6-MJMAIN-3D\" stroke-width=\"1\"></path>\n<path d=\"M96 585Q152 666 249 666Q297 666 345 640T423 548Q460 465 460 320Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\" id=\"E6-MJMAIN-30\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E6-MJMATHI-74\" y=\"0\"></use>\n<use x=\"639\" xlink:href=\"#E6-MJMAIN-3D\" y=\"0\"></use>\n<g transform=\"translate(1695,0)\">\n<use x=\"0\" xlink:href=\"#E6-MJMATHI-74\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"511\" xlink:href=\"#E6-MJMAIN-30\" y=\"-213\"></use>\n</g>\n</g>\n</svg></span> remains inside <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-7-Title\" focusable=\"false\" height=\"2.134ex\" role=\"img\" style=\"vertical-align: -0.255ex;\" viewbox=\"0 -809.3 763.5 918.9\" width=\"1.773ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-7-Title\">O</title>\n<defs aria-hidden=\"true\">\n<path d=\"M740 435Q740 320 676 213T511 42T304 -22Q207 -22 138 35T51 201Q50 209 50 244Q50 346 98 438T227 601Q351 704 476 704Q514 704 524 703Q621 689 680 617T740 435ZM637 476Q637 565 591 615T476 665Q396 665 322 605Q242 542 200 428T157 216Q157 126 200 73T314 19Q404 19 485 98T608 313Q637 408 637 476Z\" id=\"E7-MJMATHI-4F\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E7-MJMATHI-4F\" y=\"0\"></use>\n</g>\n</svg></span> for all <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-8-Title\" focusable=\"false\" height=\"2.259ex\" role=\"img\" style=\"vertical-align: -0.63ex;\" viewbox=\"0 -701.7 2789.5 972.7\" width=\"6.479ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-8-Title\">t &gt; t_0.</title>\n<defs aria-hidden=\"true\">\n<path d=\"M26 385Q19 392 19 395Q19 399 22 411T27 425Q29 430 36 430T87 431H140L159 511Q162 522 166 540T173 566T179 586T187 603T197 615T211 624T229 626Q247 625 254 615T261 596Q261 589 252 549T232 470L222 433Q222 431 272 431H323Q330 424 330 420Q330 398 317 385H210L174 240Q135 80 135 68Q135 26 162 26Q197 26 230 60T283 144Q285 150 288 151T303 153H307Q322 153 322 145Q322 142 319 133Q314 117 301 95T267 48T216 6T155 -11Q125 -11 98 4T59 56Q57 64 57 83V101L92 241Q127 382 128 383Q128 385 77 385H26Z\" id=\"E8-MJMATHI-74\" stroke-width=\"1\"></path>\n<path d=\"M84 520Q84 528 88 533T96 539L99 540Q106 540 253 471T544 334L687 265Q694 260 694 250T687 235Q685 233 395 96L107 -40H101Q83 -38 83 -20Q83 -19 83 -17Q82 -10 98 -1Q117 9 248 71Q326 108 378 132L626 250L378 368Q90 504 86 509Q84 513 84 520Z\" id=\"E8-MJMAIN-3E\" stroke-width=\"1\"></path>\n<path d=\"M96 585Q152 666 249 666Q297 666 345 640T423 548Q460 465 460 320Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\" id=\"E8-MJMAIN-30\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E8-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E8-MJMATHI-74\" y=\"0\"></use>\n<use x=\"639\" xlink:href=\"#E8-MJMAIN-3E\" y=\"0\"></use>\n<g transform=\"translate(1695,0)\">\n<use x=\"0\" xlink:href=\"#E8-MJMATHI-74\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"511\" xlink:href=\"#E8-MJMAIN-30\" y=\"-213\"></use>\n</g>\n<use x=\"2510\" xlink:href=\"#E8-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>In plain words, this means that solutions that start sufficiently close to the equilibrium remain close, but may not converge to the equilibrium.</p>\n</li>\n<li><p>An equilibrium point <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-9-Title\" focusable=\"false\" height=\"2.009ex\" role=\"img\" style=\"vertical-align: -0.255ex;\" viewbox=\"0 -755.5 1061.4 865.1\" width=\"2.465ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-9-Title\">\\mathbf{x}^\\ast</title>\n<defs aria-hidden=\"true\">\n<path d=\"M227 0Q212 3 121 3Q40 3 28 0H21V62H117L245 213L109 382H26V444H34Q49 441 143 441Q247 441 265 444H274V382H246L281 339Q315 297 316 297Q320 297 354 341L389 382H352V444H360Q375 441 466 441Q547 441 559 444H566V382H471L355 246L504 63L545 62H586V0H578Q563 3 469 3Q365 3 347 0H338V62H366Q366 63 326 112T285 163L198 63L217 62H235V0H227Z\" id=\"E9-MJMAINB-78\" stroke-width=\"1\"></path>\n<path d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\" id=\"E9-MJMAIN-2217\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E9-MJMAINB-78\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"859\" xlink:href=\"#E9-MJMAIN-2217\" y=\"513\"></use>\n</g>\n</svg></span> is called <em>asymptotically stable</em> if it is stable and there exists a neighborhood <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-10-Title\" focusable=\"false\" height=\"2.134ex\" role=\"img\" style=\"vertical-align: -0.255ex;\" viewbox=\"0 -809.3 763.5 918.9\" width=\"1.773ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-10-Title\">O</title>\n<defs aria-hidden=\"true\">\n<path d=\"M740 435Q740 320 676 213T511 42T304 -22Q207 -22 138 35T51 201Q50 209 50 244Q50 346 98 438T227 601Q351 704 476 704Q514 704 524 703Q621 689 680 617T740 435ZM637 476Q637 565 591 615T476 665Q396 665 322 605Q242 542 200 428T157 216Q157 126 200 73T314 19Q404 19 485 98T608 313Q637 408 637 476Z\" id=\"E10-MJMATHI-4F\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E10-MJMATHI-4F\" y=\"0\"></use>\n</g>\n</svg></span> of <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-11-Title\" focusable=\"false\" height=\"2.009ex\" role=\"img\" style=\"vertical-align: -0.255ex;\" viewbox=\"0 -755.5 1061.4 865.1\" width=\"2.465ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-11-Title\">\\mathbf{x}^\\ast</title>\n<defs aria-hidden=\"true\">\n<path d=\"M227 0Q212 3 121 3Q40 3 28 0H21V62H117L245 213L109 382H26V444H34Q49 441 143 441Q247 441 265 444H274V382H246L281 339Q315 297 316 297Q320 297 354 341L389 382H352V444H360Q375 441 466 441Q547 441 559 444H566V382H471L355 246L504 63L545 62H586V0H578Q563 3 469 3Q365 3 347 0H338V62H366Q366 63 326 112T285 163L198 63L217 62H235V0H227Z\" id=\"E11-MJMAINB-78\" stroke-width=\"1\"></path>\n<path d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\" id=\"E11-MJMAIN-2217\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E11-MJMAINB-78\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"859\" xlink:href=\"#E11-MJMAIN-2217\" y=\"513\"></use>\n</g>\n</svg></span> such that every orbit that begins inside <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-12-Title\" focusable=\"false\" height=\"2.134ex\" role=\"img\" style=\"vertical-align: -0.255ex;\" viewbox=\"0 -809.3 763.5 918.9\" width=\"1.773ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-12-Title\">O</title>\n<defs aria-hidden=\"true\">\n<path d=\"M740 435Q740 320 676 213T511 42T304 -22Q207 -22 138 35T51 201Q50 209 50 244Q50 346 98 438T227 601Q351 704 476 704Q514 704 524 703Q621 689 680 617T740 435ZM637 476Q637 565 591 615T476 665Q396 665 322 605Q242 542 200 428T157 216Q157 126 200 73T314 19Q404 19 485 98T608 313Q637 408 637 476Z\" id=\"E12-MJMATHI-4F\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E12-MJMATHI-4F\" y=\"0\"></use>\n</g>\n</svg></span> approaches <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-13-Title\" focusable=\"false\" height=\"2.009ex\" role=\"img\" style=\"vertical-align: -0.255ex;\" viewbox=\"0 -755.5 1061.4 865.1\" width=\"2.465ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-13-Title\">\\mathbf{x}^\\ast</title>\n<defs aria-hidden=\"true\">\n<path d=\"M227 0Q212 3 121 3Q40 3 28 0H21V62H117L245 213L109 382H26V444H34Q49 441 143 441Q247 441 265 444H274V382H246L281 339Q315 297 316 297Q320 297 354 341L389 382H352V444H360Q375 441 466 441Q547 441 559 444H566V382H471L355 246L504 63L545 62H586V0H578Q563 3 469 3Q365 3 347 0H338V62H366Q366 63 326 112T285 163L198 63L217 62H235V0H227Z\" id=\"E13-MJMAINB-78\" stroke-width=\"1\"></path>\n<path d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\" id=\"E13-MJMAIN-2217\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E13-MJMAINB-78\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"859\" xlink:href=\"#E13-MJMAIN-2217\" y=\"513\"></use>\n</g>\n</svg></span> as <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-14-Title\" focusable=\"false\" height=\"1.884ex\" role=\"img\" style=\"vertical-align: -0.255ex;\" viewbox=\"0 -701.7 3196.6 811.3\" width=\"7.424ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-14-Title\">t \\to \\infty.</title>\n<defs aria-hidden=\"true\">\n<path d=\"M26 385Q19 392 19 395Q19 399 22 411T27 425Q29 430 36 430T87 431H140L159 511Q162 522 166 540T173 566T179 586T187 603T197 615T211 624T229 626Q247 625 254 615T261 596Q261 589 252 549T232 470L222 433Q222 431 272 431H323Q330 424 330 420Q330 398 317 385H210L174 240Q135 80 135 68Q135 26 162 26Q197 26 230 60T283 144Q285 150 288 151T303 153H307Q322 153 322 145Q322 142 319 133Q314 117 301 95T267 48T216 6T155 -11Q125 -11 98 4T59 56Q57 64 57 83V101L92 241Q127 382 128 383Q128 385 77 385H26Z\" id=\"E14-MJMATHI-74\" stroke-width=\"1\"></path>\n<path d=\"M56 237T56 250T70 270H835Q719 357 692 493Q692 494 692 496T691 499Q691 511 708 511H711Q720 511 723 510T729 506T732 497T735 481T743 456Q765 389 816 336T935 261Q944 258 944 250Q944 244 939 241T915 231T877 212Q836 186 806 152T761 85T740 35T732 4Q730 -6 727 -8T711 -11Q691 -11 691 0Q691 7 696 25Q728 151 835 230H70Q56 237 56 250Z\" id=\"E14-MJMAIN-2192\" stroke-width=\"1\"></path>\n<path d=\"M55 217Q55 305 111 373T254 442Q342 442 419 381Q457 350 493 303L507 284L514 294Q618 442 747 442Q833 442 888 374T944 214Q944 128 889 59T743 -11Q657 -11 580 50Q542 81 506 128L492 147L485 137Q381 -11 252 -11Q166 -11 111 57T55 217ZM907 217Q907 285 869 341T761 397Q740 397 720 392T682 378T648 359T619 335T594 310T574 285T559 263T548 246L543 238L574 198Q605 158 622 138T664 94T714 61T765 51Q827 51 867 100T907 217ZM92 214Q92 145 131 89T239 33Q357 33 456 193L425 233Q364 312 334 337Q285 380 233 380Q171 380 132 331T92 214Z\" id=\"E14-MJMAIN-221E\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E14-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E14-MJMATHI-74\" y=\"0\"></use>\n<use x=\"639\" xlink:href=\"#E14-MJMAIN-2192\" y=\"0\"></use>\n<use x=\"1917\" xlink:href=\"#E14-MJMAIN-221E\" y=\"0\"></use>\n<use x=\"2918\" xlink:href=\"#E14-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>In plain words, this means that solutions that start sufficiently close to the equilibrium remain close and converge to the equilibrium as <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-15-Title\" focusable=\"false\" height=\"1.884ex\" role=\"img\" style=\"vertical-align: -0.255ex;\" viewbox=\"0 -701.7 3196.6 811.3\" width=\"7.424ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-15-Title\">t \\to \\infty.</title>\n<defs aria-hidden=\"true\">\n<path d=\"M26 385Q19 392 19 395Q19 399 22 411T27 425Q29 430 36 430T87 431H140L159 511Q162 522 166 540T173 566T179 586T187 603T197 615T211 624T229 626Q247 625 254 615T261 596Q261 589 252 549T232 470L222 433Q222 431 272 431H323Q330 424 330 420Q330 398 317 385H210L174 240Q135 80 135 68Q135 26 162 26Q197 26 230 60T283 144Q285 150 288 151T303 153H307Q322 153 322 145Q322 142 319 133Q314 117 301 95T267 48T216 6T155 -11Q125 -11 98 4T59 56Q57 64 57 83V101L92 241Q127 382 128 383Q128 385 77 385H26Z\" id=\"E15-MJMATHI-74\" stroke-width=\"1\"></path>\n<path d=\"M56 237T56 250T70 270H835Q719 357 692 493Q692 494 692 496T691 499Q691 511 708 511H711Q720 511 723 510T729 506T732 497T735 481T743 456Q765 389 816 336T935 261Q944 258 944 250Q944 244 939 241T915 231T877 212Q836 186 806 152T761 85T740 35T732 4Q730 -6 727 -8T711 -11Q691 -11 691 0Q691 7 696 25Q728 151 835 230H70Q56 237 56 250Z\" id=\"E15-MJMAIN-2192\" stroke-width=\"1\"></path>\n<path d=\"M55 217Q55 305 111 373T254 442Q342 442 419 381Q457 350 493 303L507 284L514 294Q618 442 747 442Q833 442 888 374T944 214Q944 128 889 59T743 -11Q657 -11 580 50Q542 81 506 128L492 147L485 137Q381 -11 252 -11Q166 -11 111 57T55 217ZM907 217Q907 285 869 341T761 397Q740 397 720 392T682 378T648 359T619 335T594 310T574 285T559 263T548 246L543 238L574 198Q605 158 622 138T664 94T714 61T765 51Q827 51 867 100T907 217ZM92 214Q92 145 131 89T239 33Q357 33 456 193L425 233Q364 312 334 337Q285 380 233 380Q171 380 132 331T92 214Z\" id=\"E15-MJMAIN-221E\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E15-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E15-MJMATHI-74\" y=\"0\"></use>\n<use x=\"639\" xlink:href=\"#E15-MJMAIN-2192\" y=\"0\"></use>\n<use x=\"1917\" xlink:href=\"#E15-MJMAIN-221E\" y=\"0\"></use>\n<use x=\"2918\" xlink:href=\"#E15-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span></p>\n</li>\n<li><p>An equilibrium point <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-16-Title\" focusable=\"false\" height=\"2.009ex\" role=\"img\" style=\"vertical-align: -0.255ex;\" viewbox=\"0 -755.5 1061.4 865.1\" width=\"2.465ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-16-Title\">\\mathbf{x}^\\ast</title>\n<defs aria-hidden=\"true\">\n<path d=\"M227 0Q212 3 121 3Q40 3 28 0H21V62H117L245 213L109 382H26V444H34Q49 441 143 441Q247 441 265 444H274V382H246L281 339Q315 297 316 297Q320 297 354 341L389 382H352V444H360Q375 441 466 441Q547 441 559 444H566V382H471L355 246L504 63L545 62H586V0H578Q563 3 469 3Q365 3 347 0H338V62H366Q366 63 326 112T285 163L198 63L217 62H235V0H227Z\" id=\"E16-MJMAINB-78\" stroke-width=\"1\"></path>\n<path d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\" id=\"E16-MJMAIN-2217\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E16-MJMAINB-78\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"859\" xlink:href=\"#E16-MJMAIN-2217\" y=\"513\"></use>\n</g>\n</svg></span> is called <em>unstable</em> if it is not stable.</p>\n<p>In plain words, this means that solutions eventually move away from the equilibrium for some initial conditions arbitrarily close to it.</p>\n</li>\n</ul>\n<p>Therefore, the correct answer is II only:</p>\n<blockquote>\n<p>Solutions that start sufficiently close to the equilibrium remain close and converge to the equilibrium as <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-17-Title\" focusable=\"false\" height=\"1.884ex\" role=\"img\" style=\"vertical-align: -0.255ex;\" viewbox=\"0 -701.7 3196.6 811.3\" width=\"7.424ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-17-Title\">t \\to \\infty.</title>\n<defs aria-hidden=\"true\">\n<path d=\"M26 385Q19 392 19 395Q19 399 22 411T27 425Q29 430 36 430T87 431H140L159 511Q162 522 166 540T173 566T179 586T187 603T197 615T211 624T229 626Q247 625 254 615T261 596Q261 589 252 549T232 470L222 433Q222 431 272 431H323Q330 424 330 420Q330 398 317 385H210L174 240Q135 80 135 68Q135 26 162 26Q197 26 230 60T283 144Q285 150 288 151T303 153H307Q322 153 322 145Q322 142 319 133Q314 117 301 95T267 48T216 6T155 -11Q125 -11 98 4T59 56Q57 64 57 83V101L92 241Q127 382 128 383Q128 385 77 385H26Z\" id=\"E17-MJMATHI-74\" stroke-width=\"1\"></path>\n<path d=\"M56 237T56 250T70 270H835Q719 357 692 493Q692 494 692 496T691 499Q691 511 708 511H711Q720 511 723 510T729 506T732 497T735 481T743 456Q765 389 816 336T935 261Q944 258 944 250Q944 244 939 241T915 231T877 212Q836 186 806 152T761 85T740 35T732 4Q730 -6 727 -8T711 -11Q691 -11 691 0Q691 7 696 25Q728 151 835 230H70Q56 237 56 250Z\" id=\"E17-MJMAIN-2192\" stroke-width=\"1\"></path>\n<path d=\"M55 217Q55 305 111 373T254 442Q342 442 419 381Q457 350 493 303L507 284L514 294Q618 442 747 442Q833 442 888 374T944 214Q944 128 889 59T743 -11Q657 -11 580 50Q542 81 506 128L492 147L485 137Q381 -11 252 -11Q166 -11 111 57T55 217ZM907 217Q907 285 869 341T761 397Q740 397 720 392T682 378T648 359T619 335T594 310T574 285T559 263T548 246L543 238L574 198Q605 158 622 138T664 94T714 61T765 51Q827 51 867 100T907 217ZM92 214Q92 145 131 89T239 33Q357 33 456 193L425 233Q364 312 334 337Q285 380 233 380Q171 380 132 331T92 214Z\" id=\"E17-MJMAIN-221E\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E17-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E17-MJMATHI-74\" y=\"0\"></use>\n<use x=\"639\" xlink:href=\"#E17-MJMAIN-2192\" y=\"0\"></use>\n<use x=\"1917\" xlink:href=\"#E17-MJMAIN-221E\" y=\"0\"></use>\n<use x=\"2918\" xlink:href=\"#E17-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span></p>\n</blockquote>\n</div>\n</div>"
      }
