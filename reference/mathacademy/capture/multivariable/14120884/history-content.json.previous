L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\" id=\"E13-MJMAIN-2217\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E13-MJMAINB-78\" y=\"0\"></use>\n<use x=\"607\" xlink:href=\"#E13-MJMAIN-28\" y=\"0\"></use>\n<use x=\"997\" xlink:href=\"#E13-MJMATHI-74\" y=\"0\"></use>\n<use x=\"1358\" xlink:href=\"#E13-MJMAIN-29\" y=\"0\"></use>\n<use x=\"2025\" xlink:href=\"#E13-MJMAIN-3D\" y=\"0\"></use>\n<g transform=\"translate(3082,0)\">\n<use x=\"0\" xlink:href=\"#E13-MJMAINB-78\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"859\" xlink:href=\"#E13-MJMAIN-2217\" y=\"513\"></use>\n</g>\n</g>\n</svg></span> for all <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-14-Title\" focusable=\"false\" height=\"2.009ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -719.6 640 865.1\" width=\"1.486ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-14-Title\">t.</title>\n<defs aria-hidden=\"true\">\n<path d=\"M26 385Q19 392 19 395Q19 399 22 411T27 425Q29 430 36 430T87 431H140L159 511Q162 522 166 540T173 566T179 586T187 603T197 615T211 624T229 626Q247 625 254 615T261 596Q261 589 252 549T232 470L222 433Q222 431 272 431H323Q330 424 330 420Q330 398 317 385H210L174 240Q135 80 135 68Q135 26 162 26Q197 26 230 60T283 144Q285 150 288 151T303 153H307Q322 153 322 145Q322 142 319 133Q314 117 301 95T267 48T216 6T155 -11Q125 -11 98 4T59 56Q57 64 57 83V101L92 241Q127 382 128 383Q128 385 77 385H26Z\" id=\"E14-MJMATHI-74\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E14-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E14-MJMATHI-74\" y=\"0\"></use>\n<use x=\"361\" xlink:href=\"#E14-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span> The state does not change.</p>\n<p><strong>Note:</strong> In the phase plane, <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-15-Title\" focusable=\"false\" height=\"2.843ex\" role=\"img\" style=\"vertical-align: -0.838ex;\" viewbox=\"0 -863.1 2747.7 1223.9\" width=\"6.382ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-15-Title\">\\mathbf{f}(x,y)</title>\n<defs aria-hidden=\"true\">\n<path d=\"M308 0Q290 3 172 3Q58 3 49 0H40V62H109V382H42V444H109V503L110 562L112 572Q127 625 178 658T316 699Q318 699 330 699T348 700Q381 698 404 687T436 658T449 629T452 606Q452 576 432 557T383 537Q355 537 335 555T314 605Q314 635 328 649H325Q311 649 293 644T253 618T227 560Q226 555 226 498V444H340V382H232V62H318V0H308Z\" id=\"E15-MJMAINB-66\" stroke-width=\"1\"></path>\n<path d=\"M94 250Q94 319 104 381T127 488T164 576T202 643T244 695T277 729T302 750H315H319Q333 750 333 741Q333 738 316 720T275 667T226 581T184 443T167 250T184 58T225 -81T274 -167T316 -220T333 -241Q333 -250 318 -250H315H302L274 -226Q180 -141 137 -14T94 250Z\" id=\"E15-MJMAIN-28\" stroke-width=\"1\"></path>\n<path d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40Q91 39 97 36T113 29T132 26Q168 26 194 71Q203 87 217 139T245 247T261 313Q266 340 266 352Q266 380 251 392T217 404Q177 404 142 372T93 290Q91 281 88 280T72 278H58Q52 284 52 289Z\" id=\"E15-MJMATHI-78\" stroke-width=\"1\"></path>\n<path d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\" id=\"E15-MJMAIN-2C\" stroke-width=\"1\"></path>\n<path d=\"M21 287Q21 301 36 335T84 406T158 442Q199 442 224 419T250 355Q248 336 247 334Q247 331 231 288T198 191T182 105Q182 62 196 45T238 27Q261 27 281 38T312 61T339 94Q339 95 344 114T358 173T377 247Q415 397 419 404Q432 431 462 431Q475 431 483 424T494 412T496 403Q496 390 447 193T391 -23Q363 -106 294 -155T156 -205Q111 -205 77 -183T43 -117Q43 -95 50 -80T69 -58T89 -48T106 -45Q150 -45 150 -87Q150 -107 138 -122T115 -142T102 -147L99 -148Q101 -153 118 -160T152 -167H160Q177 -167 186 -165Q219 -156 247 -127T290 -65T313 -9T321 21L315 17Q309 13 296 6T270 -6Q250 -11 231 -11Q185 -11 150 11T104 82Q103 89 103 113Q103 170 138 262T173 379Q173 380 173 381Q173 390 173 393T169 400T158 404H154Q131 404 112 385T82 344T65 302T57 280Q55 278 41 278H27Q21 284 21 287Z\" id=\"E15-MJMATHI-79\" stroke-width=\"1\"></path>\n<path d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\" id=\"E15-MJMAIN-29\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E15-MJMAINB-66\" y=\"0\"></use>\n<use x=\"453\" xlink:href=\"#E15-MJMAIN-28\" y=\"0\"></use>\n<use x=\"843\" xlink:href=\"#E15-MJMATHI-78\" y=\"0\"></use>\n<use x=\"1415\" xlink:href=\"#E15-MJMAIN-2C\" y=\"0\"></use>\n<use x=\"1860\" xlink:href=\"#E15-MJMATHI-79\" y=\"0\"></use>\n<use x=\"2358\" xlink:href=\"#E15-MJMAIN-29\" y=\"0\"></use>\n</g>\n</svg></span> represents velocity. At an equilibrium <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-16-Title\" focusable=\"false\" height=\"2.509ex\" role=\"img\" style=\"vertical-align: -0.671ex;\" viewbox=\"0 -791.3 1339.9 1080.4\" width=\"3.112ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-16-Title\">\\mathbf{x}^\\ast,</title>\n<defs aria-hidden=\"true\">\n<path d=\"M227 0Q212 3 121 3Q40 3 28 0H21V62H117L245 213L109 382H26V444H34Q49 441 143 441Q247 441 265 444H274V382H246L281 339Q315 297 316 297Q320 297 354 341L389 382H352V444H360Q375 441 466 441Q547 441 559 444H566V382H471L355 246L504 63L545 62H586V0H578Q563 3 469 3Q365 3 347 0H338V62H366Q366 63 326 112T285 163L198 63L217 62H235V0H227Z\" id=\"E16-MJMAINB-78\" stroke-width=\"1\"></path>\n<path d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\" id=\"E16-MJMAIN-2217\" stroke-width=\"1\"></path>\n<path d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\" id=\"E16-MJMAIN-2C\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E16-MJMAINB-78\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"859\" xlink:href=\"#E16-MJMAIN-2217\" y=\"513\"></use>\n<use x=\"1061\" xlink:href=\"#E16-MJMAIN-2C\" y=\"0\"></use>\n</g>\n</svg></span> the velocity is <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-17-Title\" focusable=\"false\" height=\"2.509ex\" role=\"img\" style=\"vertical-align: -0.671ex;\" viewbox=\"0 -791.3 854 1080.4\" width=\"1.983ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-17-Title\">\\mathbf{0},</title>\n<defs aria-hidden=\"true\">\n<path d=\"M266 654H280H282Q500 654 524 418Q529 370 529 320Q529 125 456 52Q397 -10 287 -10Q110 -10 63 154Q45 212 45 316Q45 504 113 585Q140 618 185 636T266 654ZM374 548Q347 604 286 604Q247 604 218 575Q197 552 193 511T188 311Q188 159 196 116Q202 87 225 64T287 41Q339 41 367 87Q379 107 382 152T386 329Q386 518 374 548Z\" id=\"E17-MJMAINB-30\" stroke-width=\"1\"></path>\n<path d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\" id=\"E17-MJMAIN-2C\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E17-MJMAINB-30\" y=\"0\"></use>\n<use x=\"575\" xlink:href=\"#E17-MJMAIN-2C\" y=\"0\"></use>\n</g>\n</svg></span> so trajectories starting there stay there forever.</p>\n<p>For example, let's find the equilibrium points of the following system:\n<span class=\"mjpage mjpage__block\"><svg aria-labelledby=\"MathJax-SVG-18-Title\" focusable=\"false\" height=\"6.176ex\" role=\"img\" style=\"vertical-align: -2.505ex;\" viewbox=\"0 -1580.7 7219 2659.1\" width=\"16.767ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-18-Title\">\n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"3\" display=\"true\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\"