 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E14-MJMAINB-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E14-MJMAIN-2217\" x=\"859\" y=\"513\"></use>\n</g>\n</svg></span> as <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"7.424ex\" height=\"1.884ex\" style=\"vertical-align: -0.255ex;\" viewBox=\"0 -701.7 3196.6 811.3\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-15-Title\">\n<title id=\"MathJax-SVG-15-Title\">t \\to \\infty.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E15-MJMATHI-74\" d=\"M26 385Q19 392 19 395Q19 399 22 411T27 425Q29 430 36 430T87 431H140L159 511Q162 522 166 540T173 566T179 586T187 603T197 615T211 624T229 626Q247 625 254 615T261 596Q261 589 252 549T232 470L222 433Q222 431 272 431H323Q330 424 330 420Q330 398 317 385H210L174 240Q135 80 135 68Q135 26 162 26Q197 26 230 60T283 144Q285 150 288 151T303 153H307Q322 153 322 145Q322 142 319 133Q314 117 301 95T267 48T216 6T155 -11Q125 -11 98 4T59 56Q57 64 57 83V101L92 241Q127 382 128 383Q128 385 77 385H26Z\"></path>\n<path stroke-width=\"1\" id=\"E15-MJMAIN-2192\" d=\"M56 237T56 250T70 270H835Q719 357 692 493Q692 494 692 496T691 499Q691 511 708 511H711Q720 511 723 510T729 506T732 497T735 481T743 456Q765 389 816 336T935 261Q944 258 944 250Q944 244 939 241T915 231T877 212Q836 186 806 152T761 85T740 35T732 4Q730 -6 727 -8T711 -11Q691 -11 691 0Q691 7 696 25Q728 151 835 230H70Q56 237 56 250Z\"></path>\n<path stroke-width=\"1\" id=\"E15-MJMAIN-221E\" d=\"M55 217Q55 305 111 373T254 442Q342 442 419 381Q457 350 493 303L507 284L514 294Q618 442 747 442Q833 442 888 374T944 214Q944 128 889 59T743 -11Q657 -11 580 50Q542 81 506 128L492 147L485 137Q381 -11 252 -11Q166 -11 111 57T55 217ZM907 217Q907 285 869 341T761 397Q740 397 720 392T682 378T648 359T619 335T594 310T574 285T559 263T548 246L543 238L574 198Q605 158 622 138T664 94T714 61T765 51Q827 51 867 100T907 217ZM92 214Q92 145 131 89T239 33Q357 33 456 193L425 233Q364 312 334 337Q285 380 233 380Q171 380 132 331T92 214Z\"></path>\n<path stroke-width=\"1\" id=\"E15-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E15-MJMATHI-74\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E15-MJMAIN-2192\" x=\"639\" y=\"0\"></use>\n <use xlink:href=\"#E15-MJMAIN-221E\" x=\"1917\" y=\"0\"></use>\n <use xlink:href=\"#E15-MJMAIN-2E\" x=\"2918\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>In plain words, this means that solutions which start sufficiently\nclose to the equilibrium remain close to it <em>and</em> converge to it as\n<span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"7.424ex\" height=\"1.884ex\" style=\"vertical-align: -0.255ex;\" viewBox=\"0 -701.7 3196.6 811.3\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-16-Title\">\n<title id=\"MathJax-SVG-16-Title\">t \\to \\infty.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E16-MJMATHI-74\" d=\"M26 385Q19 392 19 395Q19 399 22 411T27 425Q29 430 36 430T87 431H140L159 511Q162 522 166 540T173 566T179 586T187 603T197 615T211 624T229 626Q247 625 254 615T261 596Q261 589 252 549T232 470L222 433Q222 431 272 431H323Q330 424 330 420Q330 398 317 385H210L174 240Q135 80 135 68Q135 26 162 26Q197 26 230 60T283 144Q285 150 288 151T303 153H307Q322 153 322 145Q322 142 319 133Q314 117 301 95T267 48T216 6T155 -11Q125 -11 98 4T59 56Q57 64 57 83V101L92 241Q127 382 128 383Q128 385 77 385H26Z\"></path>\n<path stroke-width=\"1\" id=\"E16-MJMAIN-2192\" d=\"M56 237T56 250T70 270H835Q719 357 692 493Q692 494 692 496T691 499Q691 511 708 511H711Q720 511 723 510T729 506T732 497T735 481T743 456Q765 389 816 336T935 261Q944 258 944 250Q944 244 939 241T915 231T877 212Q836 186 806 152T761 85T740 35T732 4Q730 -6 727 -8T711 -11Q691 -11 691 0Q691 7 696 25Q728 151 835 230H70Q56 237 56 250Z\"></path>\n<path stroke-width=\"1\" id=\"E16-MJMAIN-221E\" d=\"M55 217Q55 305 111 373T254 442Q342 442 419 381Q457 350 493 303L507 284L514 294Q618 442 747 442Q833 442 888 374T944 214Q944 128 889 59T743 -11Q657 -11 580 50Q542 81 506 128L492 147L485 137Q381 -11 252 -11Q166 -11 111 57T55 217ZM907 217Q907 285 869 341T761 397Q740 397 720 392T682 378T648 359T619 335T594 310T574 285T559 263T548 246L543 238L574 198Q605 158 622 138T664 94T714 61T765 51Q827 51 867 100T907 217ZM92 214Q92 145 131 89T239 33Q357 33 456 193L425 233Q364 312 334 337Q285 380 233 380Q171 380 132 331T92 214Z\"></path>\n<path stroke-width=\"1\" id=\"E16-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E16-MJMATHI-74\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E16-MJMAIN-2192\" x=\"639\" y=\"0\"></use>\n <use xlink:href=\"#E16-MJMAIN-221E\" x=\"1917\" y=\"0\"></use>\n <use xlink:href=\"#E16-MJMAIN-2E\" x=\"2918\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>Note that asymptotic stability is a stronger condition than stability:\nit adds the requirement that nearby solutions actually reach\n<span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"2.465ex\" height=\"2.009ex\" style=\"vertical-align: -0.255ex;\" viewBox=\"0 -755.5 1061.4 865.1\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-17-Title\">\n<title id=\"MathJax-SVG-17-Title\">\\mathbf{x}^\\ast</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E17-MJMAINB-78\" d=\"M227 0Q212 3 121 3Q40 3 28 0H21V62H117L245 213L109 382H26V444H34Q49 441 143 441Q247 441 265 444H274V382H246L281 339Q315 297 316 297Q320 297 354 341L389 382H352V444H360Q375 441 466 441Q547 441 559 444H566V382H471L355 246L504 63L545 62H586V0H578Q563 3 469 3Q365 3 347 0H338V62H366Q366 63 326 112T285 163L198 63L217 62H235V0H227Z\"></path>\n<path stroke-width=\"1\" id=\"E17-MJMAIN-2217\" d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E17-MJMAINB-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E17-MJMAIN-2217\" x=\"859\" y=\"513\"></use>\n</g>\n</svg></span> in the limit.</p>\n</li>\n</ul>\n<!-- tikz -->\n<p></p><div id=\"graphic-588266b947fc3d811d83d47136a57793\" class=\"graphic\"><img src=\"/graphics/588266b947fc3d811d83d47136a57793\"></div>\n<!-- /tikz --><p></p>\n<ul>\n<li><p>An equilibrium point <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"2.465ex\" height=\"2.009ex\" style=\"vertical-align: -0.255ex;\" viewBox=\"0 -755.5 1061.4 865.1\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-18-Title\">\n<title id=\"MathJax-SVG-18-Title\">\\mathbf{x}^\\ast</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E18-MJMAINB-78\" d=\"M227 0Q212 3 121 3Q40 3 28 0H21V62H117L245 213L109 382H26V444H34Q49 441 143 441Q247 441 265 444H274V382H246L281 339Q315 297 316 297Q320 297 354 341L389 382H352V444H360Q375 441 466 441Q547 441 559 444H566V382H471L355 246L504 63L545 62H586V0H578Q563 3 469 3Q365 3 347 0H338V62H366Q366 63 326 112T285 163L198 63L217 62H235V0H227Z\"></path>\n<path stroke-width=\"1\" id=\"E18-MJMAIN-2217\" d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E18-MJMAINB-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E18-MJMAIN-2217\" x=\"859\" y=\"513\"></use>\n</g>\n</svg></span> is called <strong>unstable</strong> if it\nis not stable.</p>\n<p>In plain words, this means there is some neighborhood <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.773ex\" height=\"2.134ex\" style=\"vertical-align: -0.255ex;\" viewBox=\"0 -809.3 763.5 918.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-19-Title\">\n<title id=\"MathJax-SVG-19-Title\">O</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E19-MJMATHI-4F\" d=\"M740 435Q740 320 676 213T511 42T304 -22Q207 -22 138 35T51 201Q50 209 50 244Q50 346 98 438T227 601Q351 704 476 704Q514 704 524 703Q621 689 680 617T740 435ZM637 476Q637 565 591 615T476 665Q396 665 322 605Q242 542 200 428T157 216Q157 126 200 73T314 19Q404 19 485 98T608 313Q637 408 637 476Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E19-MJMATHI-4F\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> of <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"2.465ex\" height=\"2.009ex\" style=\"vertical-align: -0.255ex;\" viewBox=\"0 -755.5 1061.4 865.1\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-20-Title\">\n<title id=\"MathJax-SVG-20-Title\">\\mathbf{x}^\\ast</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E20-MJMAINB-78\" d=\"M227 0Q212 3 121 3Q40 3 28 0H21V62H117L245 213L109 382H26V444H34Q49 441 143 441Q247 441 265 444H274V382H246L281 339Q315 297 316 297Q320 297 354 341L389 382H352V444H360Q375 441 466 441Q547 441 559 444H566V382H471L355 246L504 63L545 62H586V0H578Q563 3 469 3Q365 3 347 0H338V62H366Q366 63 326 112T285 163L198 63L217 62H235V0H227Z\"></path>\n<path stroke-width=\"1\" id=\"E20-MJMAIN-2217\" d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E20-MJMAINB-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E20-MJMAIN-2217\" x=\"859\" y=\"513\"></use>\n</g>\n</svg></span> from which trajectories can escape, even when started\narbitrarily close to <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"3.112ex\" height=\"2.009ex\" style=\"vertical-align: -0.255ex;\" viewBox=\"0 -755.5 1339.9 865.1\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-21-Title\">\n<title id=\"MathJax-SVG-21-Title\">\\mathbf{x}^\\ast.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E21-MJMAINB-78\" d=\"M227 0Q212 3 121 3Q40 3 28 0H21V62H117L245 213L109 382H26V444H34Q49 441 143 441Q247 441 265 444H274V382H246L281 339Q315 297 316 297Q320 297 354 341L389 382H352V444H360Q375 441 466 441Q547 441 559 444H566V382H471L355 246L504 63L545 62H586V0H578Q563 3 469 3Q365 3 347 0H338V62H366Q366 63 326 112T285 163L198 63L217 62H235V0H227Z\"></path>\n<path stroke-width=\"1\" id=\"E21-MJMAIN-2217\" d=\"M229 286Q216 420 216 436Q216 454 240 464Q241 464 245 464T251 465Q263 464 273 456T283 436Q283 419 277 356T270 286L328 328Q384 369 389 372T399 375Q412 375 423 365T435 338Q435 325 425 315Q420 312 357 282T289 250L355 219L425 184Q434 175 434 161Q434 146 425 136T401 125Q393 125 383 131T328 171L270 213Q283 79 283 63Q283 53 276 44T250 35Q231 35 224 44T216 63Q216 80 222 143T229 213L171 171Q115 130 110 127Q106 124 100 124Q87 124 76 134T64 161Q64 166 64 169T67 175T72 181T81 188T94 195T113 204T138 215T170 230T210 250L74 315Q65 324 65 338Q65 353 74 363T98 374Q106 374 116 368T171 328L229 286Z\"></path>\n<path stroke-width=\"1\" id=\"E21-MJMAIN-2E\" d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E21-MJMAINB-78\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E21-MJMAIN-2217\" x=\"859\" y=\"513\"></use>\n <use xlink:href=\"#E21-MJMAIN-2E\" x=\"1061\" y=\"0\"></use>\n</g>\n</svg></span> Note that this does not\nrequire trajectories to stay outside <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.773ex\" height=\"2.134ex\" style=\"vertical-align: -0.255ex;\" viewBox=\"0 -809.3 763.5 918.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-22-Title\">\n<title id=\"MathJax-SVG-22-Title\">O</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E22-MJMATHI-4F\" d=\"M740 435Q740 320 676 213T511 42T304 -22Q207 -22 138 35T51 201Q50 209 50 244Q50 346 98 438T227 601Q351 704 476 704Q514 704 524 703Q621 689 680 617T740 435ZM637 476Q637 565 591 615T476 665Q396 665 322 605Q242 542 200 428T157 216Q157 126 200 73T314 19Q404 19 485 98T608 313Q637 408 637 476Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E22-MJMATHI-4F\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> forever; it only requires them to\nleave <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.773ex\" height=\"2.134ex\" style=\"vertical-align: -0.255ex;\" viewBox=\"0 -809.3 763.5 918.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-23-Title\">\n<title id=\"MathJax-SVG-23-Title\">O</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E23-MJMATHI-4F\" d=\"M740 435Q740 320 676 213T511 42T304 -22Q207 -22 138 35T51 201Q50 209 50 244Q50 346 98 438T227 601Q351 704 476 704Q514 704 524 703Q621 689 680 617T740 435ZM637 476Q637 565 591 615T476 665Q396 665 322 605Q242 542 200 428T157 216Q157 126 200 73T314 19Q404 19 485 98T608 313Q637 408 637 476Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E23-MJMATHI-4F\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> at some moment, even if they return later.</p>\n</li>\n</ul>\n<!-- tikz -->\n<p></p><div id=\"graphic-7bd24dff17d4c74518d99aed1e1ed09d\" class=\"graphic\"><img src=\"/graphics/7bd24dff17d4c74518d99aed1e1ed09d\"></div>\n<!-- /tikz --><p></p>\n<p><strong>Watch out!</strong> These descriptions are <em>local</em>: they describe what\nhappens when the initial condition is sufficiently close to the\nequilibrium. They do not require that all trajectories in the entire\nplane behave the same way.</p>\n<p>Next, let's see some examples.</p>\n\n        </div>",
