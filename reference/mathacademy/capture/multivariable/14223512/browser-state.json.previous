      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14223512/observations/step-q50157-8b594136441a99b482c7.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14223512/observations/step-q50157-8b594136441a99b482c7.png",
      "source_url": "https://mathacademy.com/tasks/14223512/topics/3350/review",
      "captured_at": 1792035975.4574034,
      "math_academy_id": "q-50157",
      "topic_id": "3350",
      "sequence_position": null,
