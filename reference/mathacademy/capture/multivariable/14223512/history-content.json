      "raw_html": "<div class=\"question\" id=\"question-50133\"><div class=\"questionHeader\"><span class=\"questionNumber\">1.</span><a class=\"questionKP\" href=\"/topics/3350#6986\">Identifying an Equation That Generates a Slope Field Using Asymptotes</a><span class=\"helpButton\" questionid=\"50133\">?</span></div><div class=\"questionGraphicFrame\"><img class=\"questionGraphic\" src=\"/graphics/q-50133\"/></div><div class=\"questionText\"><p>Identify the differential equation that generated the slope field above.</p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyHard\">H</div><span class=\"answerCreated\">Wed, Oct 14th @ 8:45 PM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:16</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>"
