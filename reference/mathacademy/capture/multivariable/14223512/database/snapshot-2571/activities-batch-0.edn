#{[{:activity/first-step {:db/id #edb/ref 17592186172979} :activity/id #uuid "dd0bd3a2-aeb8-58a5-aac7-31019071b253" :activity/scope {:db/id #edb/ref 17592186048885 :topic/id #uuid "c96ee93a-fd82-595c-824f-e11934066ffc" :topic/math-academy-id 3350} :activity/steps [{:db/id #edb/ref 17592186172868 :step/content {:db/id #edb/ref 17592186172016 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171820 :question/id #uuid "8a1be39d-6621-5d71-b1a4-3669d210ee8e" :question/math-academy-id "e-6986"} :knowledge-point/id #uuid "d3e3fdc8-67d0-5b46-9c6b-c1ec8d4ea24f" :knowledge-point/questions [{:db/id #edb/ref 17592186172564} {:db/id #edb/ref 17592186172570} {:db/id #edb/ref 17592186256380} {:db/id #edb/ref 17592186256382} {:db/id #edb/ref 17592186332816} {:db/id #edb/ref 17592186332817} {:db/id #edb/ref 17592186332818} {:db/id #edb/ref 17592186348439} {:db/id #edb/ref 17592186382964}] :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Asymptotes"} :step/id #uuid "c590d4ee-83a9-5629-b80d-5b9bf0fef93a" :step/math-academy-id 25710} {:db/id #edb/ref 17592186172869 :step/content {:db/id #edb/ref 17592186172017 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171821 :question/id #uuid "f43aebf0-6aa9-58cf-9475-69f5af74d71f" :question/math-academy-id "e-6988"} :knowledge-point/id #uuid "1616167b-5679-5ff6-b385-3e1b59352c64" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048272}] :knowledge-point/questions [{:db/id #edb/ref 17592186172563} {:db/id #edb/ref 17592186172601} {:db/id #edb/ref 17592186253444} {:db/id #edb/ref 17592186256373} {:db/id #edb/ref 17592186256374} {:db/id #edb/ref 17592186256376} {:db/id #edb/ref 17592186332806} {:db/id #edb/ref 17592186348438}] :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes and Factoring"} :step/id #uuid "df729ab0-2123-5f4d-8bcf-9b5d2fb448d1" :step/math-academy-id 25712 :step/next {:db/id #edb/ref 17592186172868}} {:db/id #edb/ref 17592186172870 :step/content {:db/id #edb/ref 17592186172018 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171822 :question/id #uuid "4dabeee5-1c46-5198-9c51-9099fb5df617" :question/math-academy-id "e-7126"} :knowledge-point/id #uuid "244419de-9b13-5923-b0a5-1bdc6f9b03b2" :knowledge-point/questions [{:db/id #edb/ref 17592186172567} {:db/id #edb/ref 17592186172569} {:db/id #edb/ref 17592186253438} {:db/id #edb/ref 17592186253665} {:db/id #edb/ref 17592186253667} {:db/id #edb/ref 17592186332802} {:db/id #edb/ref 17592186332807}] :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes"} :step/id #uuid "cf643e99-f61d-5e66-8afd-c5e23c2c54df" :step/math-academy-id 26196 :step/next {:db/id #edb/ref 17592186172869}} {:db/id #edb/ref 17592186172979 :step/content {:db/id #edb/ref 17592186173195 :tutorial/content "Let's consider the differential equation $y' = -4xy.$ The slope field for this equation is shown below.\n\n![](images/a4/a47ec9497553fdcc9d20607f309bdaee00bb1fc0af4d39dea8a6a843a2e417e6.png)\n\nLet's see how much information we can gather about the differential equation by referring *only* to its slope field.\n\n- First, note that the slope field has neither vertical nor horizontal symmetry. Therefore, the associated differential equation must be of the form $y' = f(x,y).$ Indeed, the equation $y' =-4xy$ is of this form.\n\n- Second, notice that the solution curves appear to have stationary points along the lines $x=0$ and $y=0.$ This means that the right-hand side of our differential equation must evaluate to zero on these lines. Indeed, this is true of our equation.\n\n![](images/7b/7beccfd6840c2715bfd3c923f4fe6ac05bdf07f9ed65931b016efd937b1a0b63.png)\n\n- Third, the lines $x=0$ and $y=0$ split the plane into four regions. The slopes of the solution curves in each of these regions are summarized in the table below.\n\n| $y > 0$ | $\\nearrow$\n\n$({\\color{blue}{+}})$ | $\\searrow$\n\n$({\\color{red}{-}})$ |\n| --- | --- | --- |\n| $y <       0$ | $\\searrow$\n\n$({\\color{red}{-}})$ | $\\nearrow$\n\n$({\\color{blue}{+}})$ |\n|  | $x<       0$ | $x> 0$ |\n\nNotice that the sign of $f(x,y)$ in the four regions agrees with the above table:\n\n- $f(x,y)=-4xy$ is positive in the second and fourth quadrants, and\n\n- $f(x,y)=-4xy$ is negative in the first and third quadrants." :tutorial/id #uuid "dd16b3e1-53b3-55bf-af84-540daaefde15" :tutorial/math-academy-id 5672 :tutorial/title "Introduction"} :step/id #uuid "9018b840-14fc-5403-a85b-0696a121416b" :step/math-academy-id 34802 :step/next {:db/id #edb/ref 17592186172982}} {:db/id #edb/ref 17592186172982 :step/content {:db/id #edb/ref 17592186172082 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171888 :question/id #uuid "95746e3f-5cdf-58e2-8dbb-39b3cbe5cfc1" :question/math-academy-id "e-9356"} :knowledge-point/id #uuid "cd82d96b-34d5-5d20-b810-7ea88b0b5797" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048489} {:db/id #edb/ref 17592186049722} {:db/id #edb/ref 17592186050480}] :knowledge-point/questions [{:db/id #edb/ref 17592186172566} {:db/id #edb/ref 17592186172568} {:db/id #edb/ref 17592186253664} {:db/id #edb/ref 17592186332800} {:db/id #edb/ref 17592186332801} {:db/id #edb/ref 17592186332803}] :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Stationary Points"} :step/id #uuid "de33aa28-2c66-5a35-b972-8287ff822b59" :step/math-academy-id 35034 :step/next {:db/id #edb/ref 17592186172870}}] :activity/title "Analyzing Slope Fields for Nonautonomous Differential Equations" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186172172}]}
