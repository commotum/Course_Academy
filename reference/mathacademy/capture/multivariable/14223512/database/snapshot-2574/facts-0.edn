y" #edb/ref 17592186045417] [17592186536508 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186536508 #edb/ref 1083 #uuid "8a594017-dd00-5e85-8323-b197a7f40e84" #edb/ref 17592186045417] [17592186536532 #edb/ref 1080 "{y}^{′}=2x+2xy" #edb/ref 17592186045417] [17592186536532 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186536532 #edb/ref 1083 #uuid "9a697427-3416-5d0c-94de-b62ae70838f4" #edb/ref 17592186045417] [17592186536541 #edb/ref 1080 "{y}^{′}={x}^{2}" #edb/ref 17592186045417] [17592186536541 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186536541 #edb/ref 1083 #uuid "9f9da200-0ade-54bf-b021-af17d6df52d1" #edb/ref 17592186045417] [17592186536559 #edb/ref 1080 "{y}^{′}=\\frac{1}{x}" #edb/ref 17592186045417] [17592186536559 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186536559 #edb/ref 1083 #uuid "aaff3195-01f3-5afb-88f1-a42822d0cbe3" #edb/ref 17592186045417] [17592186536582 #edb/ref 1080 "{y}^{′}={x}^{2}-4" #edb/ref 17592186045417] [17592186536582 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186536582 #edb/ref 1083 #uuid "bc223e25-78a4-519a-96e6-70f92377c549" #edb/ref 17592186045417] [17592186536591 #edb/ref 1080 "{y}^{′}=(x+1)(y+2)" #edb/ref 17592186045417] [17592186536591 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186536591 #edb/ref 1083 #uuid "c2b99d07-755c-5bef-bc57-98238ed75afa" #edb/ref 17592186045417] [17592186536616 #edb/ref 1080 "{y}^{′}=(x-1)^{2}{y}^{2}" #edb/ref 17592186045417] [17592186536616 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186536616 #edb/ref 1083 #uuid "d38d8b71-d94d-5a16-84ce-3da13f0fbb57" #edb/ref 17592186045417] [17592186536654 #edb/ref 1080 "{y}^{′}=(x+1)^{2}(y+2)" #edb/ref 17592186045417] [17592186536654 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186536654 #edb/ref 1083 #uuid "eaf33ee7-68ac-5522-9117-9e92aa0afd2e" #edb/ref 17592186045417] [17592186536694 #edb/ref 1080 "{y}^{′}=(x+1)(y-2)" #edb/ref 17592186045417] [17592186536694 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186536694 #edb/ref 1083 #uuid "ffca65b3-4207-5784-b911-da4d96590ea7" #edb/ref 17592186045417] [17592186536725 #edb/ref 1075 #edb/ref 17592186536385 #edb/ref 17592186045417] [17592186536725 #edb/ref 1075 #edb/ref 17592186536416 #edb/ref 17592186045417] [17592186536725 #edb/ref 1075 #edb/ref 17592186536472 #edb/ref 17592186045417] [17592186536725 #edb/ref 1075 #edb/ref 17592186536508 #edb/ref 17592186045417] [17592186536725 #edb/ref 1075 #edb/ref 17592186536616 #edb/ref 17592186045417] [17592186536725 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186536725 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186536725 #edb/ref 1078 #edb/ref 17592186536416 #edb/ref 17592186045417] [17592186536725 #edb/ref 1079 #uuid "41f0f8e8-48f1-5e24-ab08-3b3bcbba4475" #edb/ref 17592186045417] [17592186536728 #edb/ref 1075 #edb/ref 17592186536285 #edb/ref 17592186045417] [17592186536728 #edb/ref 1075 #edb/ref 17592186536378 #edb/ref 17592186045417] [17592186536728 #edb/ref 1075 #edb/ref 17592186536591 #edb/ref 17592186045417] [17592186536728 #edb/ref 1075 #edb/ref 17592186536654 #edb/ref 17592186045417] [17592186536728 #edb/ref 1075 #edb/ref 17592186536694 #edb/ref 17592186045417] [17592186536728 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186536728 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186536728 #edb/ref 1078 #edb/ref 17592186536591 #edb/ref 17592186045417] [17592186536728 #edb/ref 1079 #uuid "476162ce-d7d2-51ce-9444-b2f25f2ae279" #edb/ref 17592186045417] [17592186536765 #edb/ref 1075 #edb/ref 17592186536314 #edb/ref 17592186045417] [17592186536765 #edb/ref 1075 #edb/ref 17592186536339 #edb/ref 17592186045417] [17592186536765 #edb/ref 1075 #edb/ref 17592186536354 #edb/ref 17592186045417] [17592186536765 #edb/ref 1075 #edb/ref 17592186536532 #edb/ref 17592186045417] [17592186536765 #edb/ref 1075 #edb/ref 17592186536582 #edb/ref 17592186045417] [17592186536765 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186536765 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186536765 #edb/ref 1078 #edb/ref 17592186536339 #edb/ref 17592186045417] [17592186536765 #edb/ref 1079 #uuid "a19fb674-3a6d-5382-99ac-6066604aff59" #edb/ref 17592186045417] [17592186536803 #edb/ref 1075 #edb/ref 17592186536286 #edb/ref 17592186045417] [17592186536803 #edb/ref 1075 #edb/ref 17592186536400 #edb/ref 17592186045417] [17592186536803 #edb/ref 1075 #edb/ref 17592186536452 #edb/ref 17592186045417] [17592186536803 #edb/ref 1075 #edb/ref 17592186536541 #edb/ref 17592186045417] [17592186536803 #edb/ref 1075 #edb/ref 17592186536559 #edb/ref 17592186045417] [17592186536803 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186536803 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186536803 #edb/ref 1078 #edb/ref 17592186536559 #edb/ref 17592186045417] [17592186536803 #edb/ref 1079 #uuid "fb57608e-2ee3-5d75-9465-c30eb8072dad" #edb/ref 17592186045417] [17592186536850 #edb/ref 1068 #edb/ref 17592186536803 #edb/ref 17592186045417] [17592186536850 #edb/ref 1069 "q-50133" #edb/ref 17592186045417] [17592186536850 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186536850 #edb/ref 1071 "![](images/93/9389d3d0d9206b72f379a328819e4624da3a294fc3222f048edc53957a8679ac.png)\n\nIdentify the differential equation that generated the slope field above." #edb/ref 17592186045417] [17592186536850 #edb/ref 1072 #uuid "8972fb0a-9f6e-50fc-86fb-a54e4588df90" #edb/ref 17592186045417] [17592186536850 #edb/ref 1074 "![](images/31/310d05d05284201c4914de171e6ee6a7574784da4c9bf7d4e442cdf2a210722d.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- First, the slope lines on the same vertical line are all the same. This means that the slope does not vary with $y.$ In other words, ${y}^{′}$ is a function of $x$ only.\n\nOf the given equations, the only equations that satisfy this condition are the following:\n\n$$\n\\begin{aligned} & {y}^{′}=\\frac{1}{x} \\\\  & {y}^{′}={e}^{x} \\\\  & {y}^{′}={x}^{2}\\end{aligned}\n$$\n\n- Second, the slopes become vertical as $x\\to 0.$ \n\nOf the remaining options, the only one that gives this behavior is\n\n$$\n{y}^{′}=\\frac{1}{x}.\n$$\n\nNotice that\n\n$$\n|{y}^{′}|=|\\frac{1}{x}|\\to \\infty \\,\\text{as}\\,x\\to 0.\n$$\n\nTherefore, the slopes of the slope field for the differential equation ${y}^{′}=\\frac{1}{x}$ become vertical as $x\\to 0.$\nBy contrast, \n\n$$\n{y}^{′}={e}^{x}\\to 1\\,\\text{as}\\,x\\to 0,\n$$\n\nand\n\n$$\n{y}^{′}={x}^{2}\\to 0\\,\\text{as}\\,x\\to 0.\n$$\n\nTherefore, the required equation is\n\n$$\n{y}^{′}=\\frac{1}{x}.\n$$" #edb/ref 17592186045417] [17592186536865 #edb/ref 1068 #edb/ref 17592186536725 #edb/ref 17592186045417] [17592186536865 #edb/ref 1069 "q-86442" #edb/ref 17592186045417] [17592186536865 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186536865 #edb/ref 1071 "![](images/90/9000c061a8826c4492400671b3ee8e6700420e1e553ceda47e6f086a474211c2.png)\n\nThe diagram shown above is the slope field for which of the following differential equations?" #edb/ref 17592186045417] [17592186536865 #edb/ref 1072 #uuid "a2ee811e-ffbe-53ee-9b06-888771cc6f39" #edb/ref 17592186045417] [17592186536865 #edb/ref 1074 "![](images/a7/a71217d2b2e610b38f78f4471cc122de7098708900e3658cda449118df0e63dd.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=0$ and $y=-1,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nOf the given equations, the only equations that satisfy this condition are the following:\n\n$$\n\\begin{aligned}{y}^{′} & ={x}^{2}{y}^{2}+2{x}^{2}y+{x}^{2}={x}^{2}(y+1)^{2} \\\\ {y}^{′} & =x(y+1)\\end{aligned}\n$$\n\n- Second, the lines $x=0$ and $y=-1$ divide the plane into $4$ regions. The sign of the slopes in each of the $4$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| $y>-1$ | $↗$\n\n$(+)$ | $↗$\n\n$(+)$ |\n| --- | --- | --- |\n| $y<-1$ | $↗$\n\n$(+)$ | $↗$\n\n$(+)$ |\n|  | $x<0$ | $x>0$ |\n\n \nOf the remaining options, the only one that gives this behavior is\n\n$$\n{y}^{′}={x}^{2}{y}^{2}+2{x}^{2}y+{x}^{2}={x}^{2}(y+1)^{2}.\n$$\n\nTherefore, the correct answer is ${y}^{′}={x}^{2}{y}^{2}+2{x}^{2}y+{x}^{2}.$" #edb/ref 17592186045417] [17592186536881 #edb/ref 1068 #edb/ref 17592186536765 #edb/ref 17592186045417] [17592186536881 #edb/ref 1069 "q-80709" #edb/ref 17592186045417] [17592186536881 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186536881 #edb/ref 1071 "![](images/84/84597fa3c8e0a187df5792e8a8289033e6549599b1df5a34073049a5b3322770.png)\n\nThe diagram shown above is the slope field for which of the following differential equations?" #edb/ref 17592186045417] [17592186536881 #edb/ref 1072 #uuid "cd64c565-f297-5346-b626-26857f890c09" #edb/ref 17592186045417] [17592186536881 #edb/ref 1074 "![](images/36/3673d384035d7febd8540e34143c2a490f7aa3968752785ef809cff16d2524ce.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=0$ and $x=2,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines. \n\nOf the given equations, the only equations that satisfy this condition are the following:\n\n$$\n\\begin{aligned}{y}^{′} & ={x}^{2}-2x=x(x-2) \\\\ {y}^{′} & =2{x}^{2}-{x}^{3}={x}^{2}(2-x)\\end{aligned}\n$$\n\n- Second, the lines $x=0$ and $x=2$ divide the plane into $3$ regions. The sign of the slopes in each of the $3$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| $x<0$ | $0<x<2$ | $x<2$ |\n| --- | --- | --- |\n| $↗$\n\n$(+)$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n\n \nOf the remaining options, the only one that gives this behavior is\n\n$$\n{y}^{′}={x}^{2}-2x=x(x-2).\n$$\n\nTherefore, the correct answer is ${y}^{′}={x}^{2}-2x.$" #edb/ref 17592186045417] [17592186536893 #edb/ref 1068 #edb/ref 17592186536728 #edb/ref 17592186045417] [17592186536893 #edb/ref 1069 "q-50157" #edb/ref 17592186045417] [17592186536893 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186536893 #edb/ref 1071 "![](images/b4/b45ab87c3b5f6b083ca5828676ca96486e3825b3b3fbbfc3f31d19fa65a215b5.png)\n\nThe diagram shown above is the slope field for which of the following differential equations?" #edb/ref 17592186045417] [17592186536893 #edb/ref 1072 #uuid "e7d6da00-83dc-5f7a-b7e3-c9a339c8d8c8" #edb/ref 17592186045417] [17592186536893 #edb/ref 1074 "![](images/ef/ef837c5bdd4198651302e77b70d592c7771071a1ee3543ce76a3685b0439fa82.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=-1$ and $y=-2,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines. \n\nOf the given equations, the only equations that satisfy this condition are the following:\n\n$$\n\\begin{aligned}{y}^{′} & =(x+1)(y+2) \\\\ {y}^{′} & =(x+1)^{2}(y+2)\\end{aligned}\n$$\n\n- Second, the lines $x=-1$ and $y=-2$ divide the plane into $4$ regions. The sign of the slopes in each of the $4$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| $y>-2$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n| --- | --- | --- |\n| $y<-2$ | $↗$\n\n$(+)$ | $↘$\n\n$(-)$ |\n|  | $x<-1$ | $x>-1$ |\n\nOf the remaining options, the only one that gives this behavior is\n\n$$\n{y}^{′}=(x+1)(y+2).\n$$" #edb/ref 17592186045417] [17592186536905 #edb/ref 1062 #uuid "082ae2ae-0aa5-5392-9f40-e5a1a5b40f7e" #edb/ref 17592186045417] [17592186536905 #edb/ref 1063 #edb/ref 17592186536865 #edb/ref 17592186045417] [17592186536922 #edb/ref 1058 #edb/ref 17592186536970 #edb/ref 17592186045417] [17592186536922 #edb/ref 1062 #uuid "4063bcf2-9c80-51dd-b5c4-c46157272fde" #edb/ref 17592186045417] [17592186536922 #edb/ref 1063 #edb/ref 17592186536893 #edb/ref 17592186045417] [17592186536925 #edb/ref 1058 #edb/ref 17592186536922 #edb/ref 17592186045417] [17592186536925 #edb/ref 1062 #uuid "44f60c0c-5d2f-59e4-aaaa-1e285c4c8203" #edb/ref 17592186045417] [17592186536925 #edb/ref 1063 #edb/ref 17592186536850 #edb/ref 17592186045417] [17592186536970 #edb/ref 1058 #edb/ref 17592186536976 #edb/ref 17592186045417] [17592186536970 #edb/ref 1062 #uuid "cffe8872-3258-5dea-971d-7ad093112cb1" #edb/ref 17592186045417] [17592186536970 #edb/ref 1063 #edb/ref 17592186172601 #edb/ref 17592186045417] [17592186536976 #edb/ref 1058 #edb/ref 17592186536905 #edb/ref 17592186045417] [17592186536976 #edb/ref 1062 #uuid "df0c9231-2d00-5a28-90a3-a4c777823c60" #edb/ref 17592186045417] [17592186536976 #edb/ref 1063 #edb/ref 17592186536881 #edb/ref 17592186045417]}
