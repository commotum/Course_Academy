#{[{:db/id #edb/ref 17592186125033 :knowledge-point/_questions [{:db/id #edb/ref 17592186124656 :knowledge-point/id #uuid "e38cefde-a663-56de-a81d-dcea6fed89b3" :knowledge-point/title "Finding Global Maxima and Minima Given the Critical Points Inside the Function's Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f08487e-af26-5c1f-962f-ed237732c2fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=4$ and ${f}_{max}=6$" :db/id #edb/ref 17592186446405} {:answer/id #uuid "0f5adf40-0426-5a10-8817-dc97f008412e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-50$ and ${f}_{max}=20$" :db/id #edb/ref 17592186446406} {:answer/id #uuid "95dff366-2d95-5d09-afa0-223b43913ab4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-50$ and ${f}_{max}=4$" :db/id #edb/ref 17592186446440} {:answer/id #uuid "e08526c7-85a2-54ab-b8bb-bc02be965b47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-50$ and ${f}_{max}=6$" :db/id #edb/ref 17592186446459} {:answer/id #uuid "f5d065ac-c348-5dd1-a57c-c5e5b0070028" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-20$ and ${f}_{max}=20$" :db/id #edb/ref 17592186446464}] :answer-field/correct {:answer/id #uuid "e08526c7-85a2-54ab-b8bb-bc02be965b47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-50$ and ${f}_{max}=6$" :db/id #edb/ref 17592186446459} :answer-field/id #uuid "78b2ba2b-f79b-5ccd-88fe-1d78549d2f08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122798}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc6c7d4b-ed06-5426-80f2-415a147181e1" :question/math-academy-id "q-37149" :question/problem "Find the global extrema of the function $f(x,y)=2+6x-3y+xy$ on the closed region $D$ enclosed by $y=2{x}^{2}$ and $y=8.$ You are given that $f$ has a critical point at $(3,-6),$ and on the boundary of the region the points that could give rise to extreme values are $(-2,8),$ $(1,2),$ and $(2,8).$" :question/worked-solution "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\n**Step 1.** Find the critical points inside the region $D.$ \n\nTo determine the critical points, let's first sketch the region:\n\n![](images/06/06660df896e67cef560398ca24217cdba2e2b9a34fe40f1829b3e1d5d2db24e3.png)\n\nSince the critical point $(3,-6)$ does not lie inside $D,$ we do not include that point in the list of candidates for the extrema.\n\n**Step 2.** Find the points on the boundary that could give rise to extreme values.\n\nIn this case, we are *given* the points on the boundary of our region that could potentially be global extrema for $f.$ These are\n\n$$\n(-2,8),\\,(1,2),\\,(2,8).\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following: \n\n$$\n\\begin{aligned}f(-2,8) & =2+6(-2)-3(8)+(-2)(8) \\\\  & =-50 \\\\ f(1,2) & =2+6(1)-3(2)+(1)(2) \\\\  & =4 \\\\ f(2,8) & =2+6(2)-3(8)+(2)(8) \\\\  & =6\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $-50$ at the point $(-2,8),$ and\n\n- $f$ attains the global maximum of $6$ at the point $(2,8).$"}] [{:db/id #edb/ref 17592186446490 :knowledge-point/_questions [{:db/id #edb/ref 17592186124656 :knowledge-point/id #uuid "e38cefde-a663-56de-a81d-dcea6fed89b3" :knowledge-point/title "Finding Global Maxima and Minima Given the Critical Points Inside the Function's Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52624a61-59b3-504e-b08d-3b0fb6689de1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=0$ and ${f}_{max}=2$" :db/id #edb/ref 17592186446421} {:answer/id #uuid "57d35883-bcf4-5fb7-9e76-479830e77caf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=2$ and ${f}_{max}=4$" :db/id #edb/ref 17592186446422} {:answer/id #uuid "817543f2-9556-5cde-ba81-e834fd869803" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-2$ and ${f}_{max}=4$" :db/id #edb/ref 17592186446430} {:answer/id #uuid "a584c5a2-465a-5915-9a0f-ed12a25b03f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-4$ and ${f}_{max}=-2$" :db/id #edb/ref 17592186446445} {:answer/id #uuid "ca91afc3-4d89-510b-bc13-24a1f97adc1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-2$ and ${f}_{max}=2$" :db/id #edb/ref 17592186446452}] :answer-field/correct {:answer/id #uuid "57d35883-bcf4-5fb7-9e76-479830e77caf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=2$ and ${f}_{max}=4$" :db/id #edb/ref 17592186446422} :answer-field/id #uuid "f768c06e-68ed-5c8a-96fe-b36cf58285fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446478}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f2504620-1607-5645-b4d2-e55a27da4e3f" :question/math-academy-id "q-37555" :question/problem "Find the global extrema of the function $f(x,y)=(x-2)^{2}+y$ on the closed region \n$D=\\{(x,y)\\in {R}^{2}:\\,0\\le x\\le 2,\\,{x}^{2}\\le y\\le 2x\\}.$ \nYou are given  that $f$ has no critical points in the region and on the boundary of the region,  the points that can possibly give rise to extreme values are $(0,0)$, $(2,4),$ and  $(1,1).$" :question/worked-solution "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$  \n\n**Step 1.** Find the critical points inside the region $D.$ \n\nNotice that we are told that $f$ has no critical points in the region.\n\n**Step 2.** Find the points on the boundary that could give rise to extreme values.\n\nIn this case, we are *given* the points on the boundary of our region that could potentially be global extrema for $f.$ These are\n\n$$\n(0,0),\\,(2,4),\\,(1,1).\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following: \n\n$$\n\\begin{aligned}f(0,0) & =(0-2)^{2}+0 \\\\  & =4 \\\\ f(2,4) & =(2-2)^{2}+(4) \\\\  & =4 \\\\ f(1,1) & =(1-2)^{2}+(1) \\\\  & =2\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $2$ at the point $(1,1),$ and\n\n- $f$ attains the global maximum of $4$ at the points $(0,0)$ and $(2,4).$"}] [{:db/id #edb/ref 17592186446480 :knowledge-point/_questions [{:db/id #edb/ref 17592186124656 :knowledge-point/id #uuid "e38cefde-a663-56de-a81d-dcea6fed89b3" :knowledge-point/title "Finding Global Maxima and Minima Given the Critical Points Inside the Function's Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0461d323-c426-57d7-8a31-96c6ccb0b392" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-2$ and ${f}_{max}=2$" :db/id #edb/ref 17592186446403} {:answer/id #uuid "1b49ff3f-4e51-53f3-a015-1753de86c110" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=0$ and ${f}_{max}=1$" :db/id #edb/ref 17592186446409} {:answer/id #uuid "2fcbaf68-d293-51cc-a576-3b40121223bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-1$ and ${f}_{max}=1$" :db/id #edb/ref 17592186446411} {:answer/id #uuid "49abf9f2-669a-576a-a19a-889756e18ecd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-2$ and ${f}_{max}=0$" :db/id #edb/ref 17592186446419} {:answer/id #uuid "7cbe1154-dbaf-5151-a42d-da24649ac300" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=0$ and ${f}_{max}=2$" :db/id #edb/ref 17592186446428}] :answer-field/correct {:answer/id #uuid "2fcbaf68-d293-51cc-a576-3b40121223bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-1$ and ${f}_{max}=1$" :db/id #edb/ref 17592186446411} :answer-field/id #uuid "e8f37801-7fba-5407-99f3-56966d38068b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186446477}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11bccf6f-4ced-5e74-80c9-222565fe2e6b" :question/math-academy-id "q-83418" :question/problem "Find the global extrema of the function $f(x,y)=(x-1)^{3}+{y}^{2}$ on the closed region $D=\\{(x,y)\\in {R}^{2}:\\,0\\le x\\le 1,\\,{x}^{3}\\le y\\le x\\}.$ \nYou are given that $f$ has a critical point at $(1,0),$ and on the boundary of the region the points that could give rise to extreme values are $(0,0)$ and $(1,1).$" :question/worked-solution "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\n**Step 1.** Find the critical points inside the region $D.$ \n\nTo determine the critical points, let's first sketch the region: \n\n![](images/21/21edc0f327ce949027b6cfb26789442ea0f7a3be7d7c9638d540dff77062870a.png)\n\nSince the critical point $(1,0)$ does not lie inside $D,$ we do not include that point in the list of candidates for the extrema.\n\n**Step 2.** Find the points on the boundary that could give rise to extreme values.\n\nIn this case, we are *given* the points on the boundary of our region that could potentially be global extrema for $f.$ These are\n\n$$\n(0,0),\\,(1,1).\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following: \n\n$$\n\\begin{aligned}f(0,0) & =(0-1)^{3}+(0)^{2} \\\\  & =-1 \\\\ f(1,1) & =(1-1)^{3}+(1)^{2} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $-1$ at the point $(0,0),$ and\n\n- $f$ attains the global maximum of $1$ at the point $(1,1).$"}] [{:db/id #edb/ref 17592186404364 :knowledge-point/_questions [{:db/id #edb/ref 17592186124657 :knowledge-point/id #uuid "608bbe95-edf0-54a6-bd05-5578ba073319" :knowledge-point/title "Finding Global Maxima and Minima of a Function Whose Domain Is a Smooth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "233ac657-1b6c-5153-ae47-c73f6a18839b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-8$ and ${f}_{max}=10$" :db/id #edb/ref 17592186404366} {:answer/id #uuid "1398af4c-7ac7-570a-a8f9-3e7b4fb50230" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=1$ and ${f}_{max}=10$" :db/id #edb/ref 17592186404367} {:answer/id #uuid "9e7069d6-ca3e-5408-8724-9f786c398052" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-1$ and ${f}_{max}=10$" :db/id #edb/ref 17592186404368} {:answer/id #uuid "ff9e5045-1ffc-5c1d-8753-b170299e5ae5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-8$ and ${f}_{max}=1$" :db/id #edb/ref 17592186404369} {:answer/id #uuid "015fd256-8e43-5c2a-9c03-aa641f0627f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-8$ and ${f}_{max}=8$" :db/id #edb/ref 17592186404370}] :answer-field/correct {:answer/id #uuid "233ac657-1b6c-5153-ae47-c73f6a18839b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-8$ and ${f}_{max}=10$" :db/id #edb/ref 17592186404366} :answer-field/id #uuid "20a29c76-a92d-5a15-9982-689804fc2dba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404365}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8392959c-a393-5152-9307-9f96b5859277" :question/math-academy-id "q-86722" :question/problem "Find the global extrema of the function $f(x,y)=1-4xy$ on the closed elliptical region $D={(x,y)\\,:\\,{x}^{2}+4{y}^{2}\\le 9}.$" :question/worked-solution "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$  \n\nTo find the extreme values, we follow three steps.\n\n**Step 1.** Find the critical points of $f$ inside the region. \n\nTo do that, we solve ${f}^{′}=0.$ Computing the derivative gives\n\n$$\n{f}^{′}(x,y)=\\begin{bmatrix}-4y,\\,-4x\\end{bmatrix}.\n$$\n\nThe derivative exists at each point inside $D,$ and it equals zero when\n\n$$\n\\begin{aligned}{\\begin{aligned}-4y=0 \\\\ -4x=0\\end{aligned}\\,⟹\\,{\\begin{aligned}x=0 \\\\ y=0.\\end{aligned}\\end{aligned}\n$$\n\nThis gives us a single point $(0,0)\\in D,$ which we include in the list of candidates for the extrema.\n\n**Step 2.**  Find the points on the boundary of $D$ that could give rise to extreme values. \n\nTo find the boundary points that could give rise to extreme values, we parametrize the bounding ellipse ${x}^{2}+4{y}^{2}=9.$ This gives\n\n$$\nr=⟨3\\operatorname{cos}⁡t,\\,\\frac{3}{2}\\operatorname{sin}⁡t⟩,\\,t\\in [0,2\\pi ).\n$$\n\nThe values of $f$ on the boundary are given by the function\n\n$$\n\\begin{aligned}F(t) & =f(x(t),y(t)) \\\\  & =f(3\\operatorname{cos}⁡t,\\,\\frac{3}{2}\\operatorname{sin}⁡t) \\\\  & =1-4(3\\operatorname{cos}⁡t)(\\frac{3}{2}\\operatorname{sin}⁡t) \\\\  & =1-18\\operatorname{cos}⁡t\\operatorname{sin}⁡t \\\\  & =1-9\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\n \n\nTo find the critical points of $F(t)$ on the open interval $t\\in (0,2\\pi ),$ we solve the following equation:\n\n$$\n\\begin{aligned}{F}^{′}(t) & =0 \\\\ (1-9\\operatorname{sin}⁡(2t))^{′} & =0 \\\\ -18\\operatorname{cos}⁡(2t) & =0 \\\\ \\operatorname{cos}⁡(2t) & =0\\end{aligned}\n$$\n\nThe final equation gives four solutions, namely\n\n$$\nt=\\frac{\\pi }{4},\\,\\frac{3\\pi }{4},\\,\\frac{5\\pi }{4},\\,\\frac{7\\pi }{4}\\in (0,2\\pi ).\n$$\n\nWe also have to check the endpoint of the interval $t=0.$ Therefore, the only values of $t$ that can give rise to extreme values are \n\n$$\nt=0,\\,\\frac{\\pi }{4},\\,\\frac{3\\pi }{4},\\,\\frac{5\\pi }{4},\\,\\frac{7\\pi }{4}.\n$$\n\nEvaluating the corresponding values of $x$ and $y$ on the boundary, we obtain five candidate points:\n\n$$\n(3,0),\\,(\\frac{3\\sqrt{2}}{2},\\frac{3\\sqrt{2}}{4}),\\,(-\\frac{3\\sqrt{2}}{2},\\frac{3\\sqrt{2}}{4}),\\,(-\\frac{3\\sqrt{2}}{2},-\\frac{3\\sqrt{2}}{4}),\\,(\\frac{3\\sqrt{2}}{2},-\\frac{3\\sqrt{2}}{4})\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following: \n\n| $(x,y)$ | $(0,0)$ | $(3,0)$ | $(\\frac{3\\sqrt{2}}{2},\\frac{3\\sqrt{2}}{4})$ | $(-\\frac{3\\sqrt{2}}{2},\\frac{3\\sqrt{2}}{4})$ | $(-\\frac{3\\sqrt{2}}{2},-\\frac{3\\sqrt{2}}{4})$ | $(\\frac{3\\sqrt{2}}{2},-\\frac{3\\sqrt{2}}{4})$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x,y)$ | $1$ | $1$ | $-8$ | $10$ | $-8$ | $10$ |\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $-8$ at the points $(\\frac{3\\sqrt{2}}{2},\\frac{3\\sqrt{2}}{4})$ and $(-\\frac{3\\sqrt{2}}{2},-\\frac{3\\sqrt{2}}{4}),$ and\n\n- $f$ attains the global maximum of $10$ at the points $(-\\frac{3\\sqrt{2}}{2},\\frac{3\\sqrt{2}}{4})$ and $(\\frac{3\\sqrt{2}}{2},-\\frac{3\\sqrt{2}}{4}).$"}] [{:db/id #edb/ref 17592186404371 :knowledge-point/_questions [{:db/id #edb/ref 17592186124656 :knowledge-point/id #uuid "e38cefde-a663-56de-a81d-dcea6fed89b3" :knowledge-point/title "Finding Global Maxima and Minima Given the Critical Points Inside the Function's Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf37b4ad-f1a1-5a13-8dd8-d35dc56030e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-1$ and ${f}_{max}=16$" :db/id #edb/ref 17592186404373} {:answer/id #uuid "5980b150-496c-55d6-8d60-52afa76e9b6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-11$ and ${f}_{max}=-1$" :db/id #edb/ref 17592186404374} {:answer/id #uuid "d5651eb6-a478-51ea-b582-8eee402be230" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-7$ and ${f}_{max}=17$" :db/id #edb/ref 17592186404375} {:answer/id #uuid "e56bac34-6636-58da-9694-caed75b4198b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=0$ and ${f}_{max}=17$" :db/id #edb/ref 17592186404376} {:answer/id #uuid "08b74c80-69bd-5d43-8f58-45d6f43cbc2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-11$ and ${f}_{max}=16$" :db/id #edb/ref 17592186404377}] :answer-field/correct {:answer/id #uuid "d5651eb6-a478-51ea-b582-8eee402be230" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${f}_{min}=-7$ and ${f}_{max}=17$" :db/id #edb/ref 17592186404375} :answer-field/id #uuid "6009c72a-9f51-5ad2-ae87-7dc2fbcb6754" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404372}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "24be252f-8729-57e6-8082-158ca3588445" :question/math-academy-id "q-86724" :question/problem "Find the global extrema of the function $f(x,y)={x}^{2}-6x+{y}^{2}+1$ on the closed region  $D=\\{(x,y):{x}^{2}+{y}^{2}\\le 4\\}.$ You are given that $f$ has a critical point at  $(3,0)$ and on the boundary of the region the points that could give rise to extreme values are  $(-2,0)$, and $(2,0).$" :question/worked-solution "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$ \n\n**Step 1.** Find the critical points inside the region $D.$ \n\nTo determine the critical points, let's first sketch the region:\n\n![](images/75/752c84f5ab0fb122102629e9ceada21c1bba0b8f0e93b3fffe0639e4284badab.png)\n\nSince the critical point $(3,0)$ does not lie inside $D,$ we do not include that point in the list of candidates for the extrema.\n\n**Step 2.** Find the points on the boundary that could give rise to extreme values.\n\nIn this case, we are *given* the points on the boundary of our region that could potentially be global extrema for $f.$ These are\n\n$$\n(-2,0),\\,(2,0).\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following:  \n\n$$\n\\begin{aligned}f(-2,0) & =(-2)^{2}-6(-2)+(0)^{2}+1 \\\\  & =17 \\\\ f(2,0) & =(2)^{2}-6(2)+(0)^{2}+1 \\\\  & =-7\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $-7$ at the point $(2,0),$ and\n\n- $f$ attains the global maximum of $17$ at the point $(-2,0).$"}]}
