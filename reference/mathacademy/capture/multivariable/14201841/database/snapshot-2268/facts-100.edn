45417] [17592186446477 #edb/ref 1075 #edb/ref 17592186446419 #edb/ref 17592186045417] [17592186446477 #edb/ref 1075 #edb/ref 17592186446428 #edb/ref 17592186045417] [17592186446477 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186446477 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186446477 #edb/ref 1078 #edb/ref 17592186446411 #edb/ref 17592186045417] [17592186446477 #edb/ref 1079 #uuid "e8f37801-7fba-5407-99f3-56966d38068b" #edb/ref 17592186045417] [17592186446478 #edb/ref 1075 #edb/ref 17592186446421 #edb/ref 17592186045417] [17592186446478 #edb/ref 1075 #edb/ref 17592186446422 #edb/ref 17592186045417] [17592186446478 #edb/ref 1075 #edb/ref 17592186446430 #edb/ref 17592186045417] [17592186446478 #edb/ref 1075 #edb/ref 17592186446445 #edb/ref 17592186045417] [17592186446478 #edb/ref 1075 #edb/ref 17592186446452 #edb/ref 17592186045417] [17592186446478 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186446478 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186446478 #edb/ref 1078 #edb/ref 17592186446422 #edb/ref 17592186045417] [17592186446478 #edb/ref 1079 #uuid "f768c06e-68ed-5c8a-96fe-b36cf58285fb" #edb/ref 17592186045417] [17592186446480 #edb/ref 1068 #edb/ref 17592186446477 #edb/ref 17592186045417] [17592186446480 #edb/ref 1069 "q-83418" #edb/ref 17592186045417] [17592186446480 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186446480 #edb/ref 1071 "Find the global extrema of the function $f(x,y)=(x-1)^{3}+{y}^{2}$ on the closed region $D=\\{(x,y)\\in {R}^{2}:\\,0\\le x\\le 1,\\,{x}^{3}\\le y\\le x\\}.$ \nYou are given that $f$ has a critical point at $(1,0),$ and on the boundary of the region the points that could give rise to extreme values are $(0,0)$ and $(1,1).$" #edb/ref 17592186045417] [17592186446480 #edb/ref 1072 #uuid "11bccf6f-4ced-5e74-80c9-222565fe2e6b" #edb/ref 17592186045417] [17592186446480 #edb/ref 1074 "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\n**Step 1.** Find the critical points inside the region $D.$ \n\nTo determine the critical points, let's first sketch the region: \n\n![](images/21/21edc0f327ce949027b6cfb26789442ea0f7a3be7d7c9638d540dff77062870a.png)\n\nSince the critical point $(1,0)$ does not lie inside $D,$ we do not include that point in the list of candidates for the extrema.\n\n**Step 2.** Find the points on the boundary that could give rise to extreme values.\n\nIn this case, we are *given* the points on the boundary of our region that could potentially be global extrema for $f.$ These are\n\n$$\n(0,0),\\,(1,1).\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following: \n\n$$\n\\begin{aligned}f(0,0) & =(0-1)^{3}+(0)^{2} \\\\  & =-1 \\\\ f(1,1) & =(1-1)^{3}+(1)^{2} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $-1$ at the point $(0,0),$ and\n\n- $f$ attains the global maximum of $1$ at the point $(1,1).$" #edb/ref 17592186045417] [17592186446490 #edb/ref 1068 #edb/ref 17592186446478 #edb/ref 17592186045417] [17592186446490 #edb/ref 1069 "q-37555" #edb/ref 17592186045417] [17592186446490 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186446490 #edb/ref 1071 "Find the global extrema of the function $f(x,y)=(x-2)^{2}+y$ on the closed region \n$D=\\{(x,y)\\in {R}^{2}:\\,0\\le x\\le 2,\\,{x}^{2}\\le y\\le 2x\\}.$ \nYou are given  that $f$ has no critical points in the region and on the boundary of the region,  the points that can possibly give rise to extreme values are $(0,0)$, $(2,4),$ and  $(1,1).$" #edb/ref 17592186045417] [17592186446490 #edb/ref 1072 #uuid "f2504620-1607-5645-b4d2-e55a27da4e3f" #edb/ref 17592186045417] [17592186446490 #edb/ref 1074 "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$  \n\n**Step 1.** Find the critical points inside the region $D.$ \n\nNotice that we are told that $f$ has no critical points in the region.\n\n**Step 2.** Find the points on the boundary that could give rise to extreme values.\n\nIn this case, we are *given* the points on the boundary of our region that could potentially be global extrema for $f.$ These are\n\n$$\n(0,0),\\,(2,4),\\,(1,1).\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following: \n\n$$\n\\begin{aligned}f(0,0) & =(0-2)^{2}+0 \\\\  & =4 \\\\ f(2,4) & =(2-2)^{2}+(4) \\\\  & =4 \\\\ f(1,1) & =(1-2)^{2}+(1) \\\\  & =2\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $2$ at the point $(1,1),$ and\n\n- $f$ attains the global maximum of $4$ at the points $(0,0)$ and $(2,4).$" #edb/ref 17592186045417] [17592186483555 #edb/ref 1043 #edb/ref 17592186484299 #edb/ref 17592186045417] [17592186483555 #edb/ref 1043 #edb/ref 17592186484306 #edb/ref 17592186045417] [17592186483555 #edb/ref 1043 #edb/ref 17592186484315 #edb/ref 17592186045417] [17592186483555 #edb/ref 1043 #edb/ref 17592186484340 #edb/ref 17592186045417] [17592186483555 #edb/ref 1043 #edb/ref 17592186484346 #edb/ref 17592186045417] [17592186483555 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186483555 #edb/ref 1045 "Calculating Global Extrema of Multivariable Functions" #edb/ref 17592186045417] [17592186483555 #edb/ref 1046 #edb/ref 17592186484306 #edb/ref 17592186045417] [17592186483555 #edb/ref 1048 #edb/ref 17592186046660 #edb/ref 17592186045417] [17592186483555 #edb/ref 1049 #edb/ref 17592186048450 #edb/ref 17592186045417] [17592186483555 #edb/ref 1053 #uuid "014bb5c2-0eb1-526d-946d-25c9eb45386c" #edb/ref 17592186045417] [17592186483667 #edb/ref 1080 "1" #edb/ref 17592186045417] 