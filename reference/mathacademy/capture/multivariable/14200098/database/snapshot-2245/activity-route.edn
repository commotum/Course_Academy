#{[{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186516918} :activity/id #uuid "df4cdd91-8906-5e4a-b0e5-b2f695c09521" :activity/scope {:db/id #edb/ref 17592186050011 :topic/id #uuid "2609ace5-5513-5f84-a7cf-f0413860fe14" :topic/math-academy-id 3551} :activity/steps [{:db/id #edb/ref 17592186516905 :step/content {:db/id #edb/ref 17592186516864 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02150670-428b-56e2-9985-6194ff4b8ee1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "600" :db/id #edb/ref 17592186516116} {:answer/id #uuid "0c56636a-f906-5735-8c37-7b2138e8f77d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,000" :db/id #edb/ref 17592186516136} {:answer/id #uuid "4562e56f-79a7-5953-82dc-cdefccb01ccd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "800" :db/id #edb/ref 17592186516253} {:answer/id #uuid "bf315d70-83f5-5ea5-abd9-3ae3cfc47fdb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "320" :db/id #edb/ref 17592186516517} {:answer/id #uuid "f7d2bf34-d828-5bcd-970b-c54ad54643d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "860" :db/id #edb/ref 17592186516628}] :answer-field/correct {:db/id #edb/ref 17592186516253} :answer-field/id #uuid "701ad097-1360-59f4-8891-d19c7b1ca762" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516702}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f4a129bc-20d0-5e0c-8e4d-26304c226b31" :question/math-academy-id "q-118558" :question/problem "The population $y(t)$ of beavers in a river follows the logistic growth model\n\n$$\n{y}^{′}=0.2y(8-\\frac{y}{100}),\\,y(0)=200,\n$$\n\nwhere $t$ is the time, in years, since the observations began. According to this model, what is the maximum possible beaver population?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity. \n\nThe carrying capacity $a$ represents the maximum possible population. A diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}{y}^{′} & =0.2y(8-\\frac{y}{100}) \\\\  & =0.2y(\\frac{800-y}{100}) \\\\  & =\\frac{0.2y}{100}(800-y) \\\\  & =0.002y(800-y)\\end{aligned}\n$$\n\nFrom here, we see that $a=800.$ Hence, the carrying capacity is $800,$ and we conclude that the number of beavers cannot exceed $800.$"} :step/id #uuid "547b9566-7a7e-5c10-8c3a-e62cae9ff92e" :step/next {:db/id #edb/ref 17592186516915}} {:db/id #edb/ref 17592186516915 :step/content {:db/id #edb/ref 17592186516827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33fd38fb-b73c-5e14-af38-22ca47425e43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,300" :db/id #edb/ref 17592186516222} {:answer/id #uuid "3bd45c43-fd6b-5dfa-8ec5-d8595124bde2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,600" :db/id #edb/ref 17592186516232} {:answer/id #uuid "8ed5ba35-1c17-5530-84e8-dc60fa32a602" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,200" :db/id #edb/ref 17592186516409} {:answer/id #uuid "d449452a-bba6-5329-88f3-21fa31072558" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "130\\,000" :db/id #edb/ref 17592186516558} {:answer/id #uuid "f8137660-b678-5be7-9f4e-4e308f57cd8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13\\,000" :db/id #edb/ref 17592186516629}] :answer-field/correct {:db/id #edb/ref 17592186516558} :answer-field/id #uuid "85a62696-1e6e-54dd-bb76-a23cc2767801" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516714}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "94d0a8c6-e1cc-589d-baf5-ae5d11bc5ecc" :question/math-academy-id "q-119848" :question/problem "The population $y(t)$ of elephants on a certain African wildlife reserve follows the logistic growth model\n\n$$\n{y}^{′}=26y-0.0002{y}^{2},\\,y(0)=120,\n$$\n\nwhere $t$ is the time, in years, since the observations began. According to this model, what is the maximum possible population of elephants?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity. \n\nThe carrying capacity $a$ represents the maximum possible population. A diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}{y}^{′} & =26y-0.0002{y}^{2} \\\\  & =0.0002y(130\\,000-y)\\end{aligned}\n$$\n\nFrom here, we see that $a=130\\,000.$ Hence, the carrying capacity is $130\\,000,$ and we conclude that the number of elephants cannot exceed $130\\,000.$"} :step/id #uuid "6b2c3692-cb7d-5953-88f2-5e6b531cfc44" :step/next {:db/id #edb/ref 17592186516971}} {:db/id #edb/ref 17592186516918 :step/content {:db/id #edb/ref 17592186516840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cfd9676-eb74-5ebe-b031-0a788f78718e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75\\,000" :db/id #edb/ref 17592186516140} {:answer/id #uuid "3d4fb25d-27d2-5e5c-bcfd-c01b03fe7b16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "120\\,000" :db/id #edb/ref 17592186516233} {:answer/id #uuid "4b70a52a-3757-5bac-863c-6e7a9ca75c5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30\\,000" :db/id #edb/ref 17592186516266} {:answer/id #uuid "8f83a6a6-3e56-5e96-b0ee-342a84b5b56d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60\\,000" :db/id #edb/ref 17592186516413} {:answer/id #uuid "f4473ebd-4861-56d2-8435-0aad1abb7b6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "45\\,000" :db/id #edb/ref 17592186516618}] :answer-field/correct {:db/id #edb/ref 17592186516266} :answer-field/id #uuid "c19ec431-2d31-55ac-9370-03580e2d85ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516740}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b63e7390-032d-5732-93f4-683f3a627416" :question/math-academy-id "q-15495" :question/problem "A rumor is spreading in a city. The rate of growth in the number of people $P(t)$ who heard the rumor follows the logistic growth model\n\n$$\n\\frac{dP}{dt}=12P-0.000\\,2{P}^{2},\\,P(0)=2\\,000.\n$$\n\nwhere $t$ is the time, measured in hours. For which value of $P$ is the number of people who heard the rumor growing at the fastest possible rate?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{P}^{′}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nFor a logistic growth model, the fastest rate of growth occurs when $P=\\frac{1}{2}a.$\n\n![](images/9d/9d8f5340bba4d3c407e43f2bc64a4aa2ea986be89b8024baaa4e8ae65e96e5d5.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}\\frac{dP}{dt} & =12P-0.000\\,2{P}^{2} \\\\  & =0.000\\,02P(60\\,000-P)\\end{aligned}\n$$\n\nFrom here, we see that $a=60\\,000.$ Hence, the carrying capacity is $60\\,000,$ and $P$ grows at its fastest possible rate when \n\n$$\nP=\\frac{1}{2}a=\\frac{1}{2}\\cdot 60\\,000=30\\,000.\n$$"} :step/id #uuid "6f1e6e85-1cc9-56f5-81c5-125a6a2d7028" :step/next {:db/id #edb/ref 17592186516942}} {:db/id #edb/ref 17592186516942 :step/content {:db/id #edb/ref 17592186176305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e11bfc06-4f07-5209-8c0b-4dd495bb95cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "100" :db/id #edb/ref 17592186174090} {:answer/id #uuid "efd3be5e-7270-5d26-8763-b867cdbeae9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186174091} {:answer/id #uuid "2335c4d7-b3f8-5bed-b59f-86c5b955e524" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186174093} {:answer/id #uuid "67918e66-eb46-5022-8e71-699c7b27de4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty " :db/id #edb/ref 17592186516337} {:answer/id #uuid "c00bef54-cb61-5193-b9dc-726065db63fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,000" :db/id #edb/ref 17592186516520}] :answer-field/correct {:db/id #edb/ref 17592186174090} :answer-field/id #uuid "1d72255e-ec91-5b72-bb1f-7ee2e464e74e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186174088}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cb420906-a342-521a-b8a1-6dfcb9eb4dbe" :question/math-academy-id "q-118474" :question/problem "Consider the following differential equation for the function $y=y(t):$\n\n$$\n{y}^{′}=1\\,000y-10{y}^{2},\\,y(0)=40\n$$\n\nWhat is ${lim}_{t\\to \\infty }y(t)?$" :question/requires-calculator true :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nA diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's factor the right-hand side of the given equation. This gives\n\n$$\n{y}^{′}=10y(100-y),\\,y(0)=40.\n$$\n\nFrom here, we see that $a=100.$ Hence, the carrying capacity is $100.$\n\nFor a given logistic growth model, $y\\to a$ as $t\\to \\infty .$ Therefore,\n\n$$\n{lim}_{t\\to \\infty }y(t)=100.\n$$"} :step/id #uuid "9fd0633c-ca54-5dbc-adf5-6d3546b046c8" :step/next {:db/id #edb/ref 17592186516905}} {:db/id #edb/ref 17592186516971 :step/content {:db/id #edb/ref 17592186516842 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4083cc71-3bcb-5360-9978-e4ce2aebb68e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2500" :db/id #edb/ref 17592186516239}] :answer-field/correct {:db/id #edb/ref 17592186516239} :answer-field/id #uuid "aa8b8268-0d26-5cf4-8d60-0789f0a8afa9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186516730}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b8a8e489-11e9-52ae-86cf-436bdb177f60" :question/math-academy-id "q-353486" :question/problem "The population $P(t)$ of elk in a protected national park follows the logistic growth model\n\n$$\n\\frac{dP}{dt}=5P-0.001{P}^{2},\\,P(0)=200,\n$$\n\nwhere $t$ is the time, measured in years. For which value of $P$ is the elk population growing at the fastest possible rate?\n\n$P=$\n{{field-1}}" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{P}^{′}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nFor a logistic growth model, the fastest rate of growth occurs when $P=\\frac{1}{2}a.$\n\n![](images/90/9019b26b417c757bbfab79afb39379c1fc7a892bc44e934c6f23c339deacfd68.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}\\frac{dP}{dt} & =5P-0.001{P}^{2} \\\\  & =0.001P(5000-P)\\end{aligned}\n$$\n\nFrom here, we see that $a=5000.$ Hence, the carrying capacity is $5000,$ and $P$ grows at its fastest possible rate when \n\n$$\nP=\\frac{1}{2}a=\\frac{1}{2}\\cdot 5000=2500.\n$$"} :step/id #uuid "d4938297-4932-5247-bb96-9911519542a2"}] :activity/title "Qualitative Analysis of the Logistic Growth Equation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516109}]}
