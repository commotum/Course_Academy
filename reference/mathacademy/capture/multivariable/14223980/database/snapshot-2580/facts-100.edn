\frac{1}{14}\\operatorname{cosh}⁡14x+C \\\\  & =\\frac{2}{7}\\operatorname{cosh}⁡7x-\\frac{1}{28}\\operatorname{cosh}⁡14x+C \\\\  & =\\frac{1}{7}(2\\operatorname{cosh}⁡7x-\\frac{1}{4}\\operatorname{cosh}⁡14x)+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186537982 #edb/ref 1068 #edb/ref 17592186537785 #edb/ref 17592186045417] [17592186537982 #edb/ref 1069 "q-165868" #edb/ref 17592186045417] [17592186537982 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186537982 #edb/ref 1071 "Calculate\n$\\int \\operatorname{sinh}⁡x(1-4\\operatorname{cosh}⁡x)\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186537982 #edb/ref 1072 #uuid "e9856d89-c407-5a27-9255-59fdcff13d87" #edb/ref 17592186045417] [17592186537982 #edb/ref 1074 "First, we find the hyperbolic identity that corresponds to the double-angle formula for sine:\n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nUsing Osborn's rule, we get the double-angle formula for the hyperbolic sine:\n\n$$\n\\operatorname{sinh}⁡2x=2\\operatorname{sinh}⁡x\\operatorname{cosh}⁡x\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\int \\operatorname{sinh}⁡x(1-4\\operatorname{cosh}⁡x)\\,\\text{d}x & =\\int (\\operatorname{sinh}⁡x-4\\operatorname{sinh}⁡x\\operatorname{cosh}⁡x)\\,\\text{d}x \\\\  & =\\int (\\operatorname{sinh}⁡x-2\\operatorname{sinh}⁡2x)\\,\\text{d}x \\\\  & =\\operatorname{cosh}⁡x-\\operatorname{cosh}⁡2x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186537987 #edb/ref 1068 #edb/ref 17592186537782 #edb/ref 17592186045417] [17592186537987 #edb/ref 1069 "q-96997" #edb/ref 17592186045417] [17592186537987 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186537987 #edb/ref 1071 "Calculate\n$\\int \\operatorname{cosh}⁡x(2+3\\operatorname{sinh}⁡x)\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186537987 #edb/ref 1072 #uuid "f63f0268-1410-54a1-bbf2-06e90b1cc575" #edb/ref 17592186045417] [17592186537987 #edb/ref 1074 "First, we find the hyperbolic identity that corresponds to the double-angle formula for sine:\n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nUsing Osborn's rule, we get the double-angle formula for the hyperbolic sine:\n\n$$\n\\operatorname{sinh}⁡2x=2\\operatorname{sinh}⁡x\\operatorname{cosh}⁡x\n$$\n\nRearranging the above formula, we get\n\n$$\n\\frac{1}{2}\\operatorname{sinh}⁡2x=\\operatorname{sinh}⁡x\\operatorname{cosh}⁡x.\n$$\n\n \n\nTherefore, \n\n$$\n\\begin{aligned}\\int \\operatorname{cosh}⁡x(2+3\\operatorname{sinh}⁡x)\\,\\text{d}x & =\\int (2\\operatorname{cosh}⁡x+3\\operatorname{sinh}⁡x\\operatorname{cosh}⁡x)\\,\\text{d}x \\\\  & =\\int (2\\operatorname{cosh}⁡x+3\\cdot \\frac{1}{2}\\operatorname{sinh}⁡2x)\\,\\text{d}x \\\\  & =2\\int \\operatorname{cosh}⁡x\\,\\text{d}x+\\frac{3}{2}\\int \\operatorname{sinh}⁡2x\\,\\text{d}x \\\\  & =2\\operatorname{sinh}⁡x+\\frac{3}{2}\\cdot \\frac{1}{2}\\operatorname{cosh}⁡2x+C \\\\  & =2\\operatorname{sinh}⁡x+\\frac{3}{4}\\operatorname{cosh}⁡2x+C.\\end{aligned}\n$$" #edb/ref 17592186045417]}
