#{[{:activity/expected-seconds 1260.0 :activity/first-step {:db/id #edb/ref 17592186167735} :activity/id #uuid "2381411d-8882-5a1a-a548-365b45d93d20" :activity/scope {:db/id #edb/ref 17592186049810 :topic/id #uuid "15758f02-6fcf-5bc6-93c8-c4364239ef4c" :topic/math-academy-id 3262} :activity/steps [{:db/id #edb/ref 17592186167638 :step/content {:db/id #edb/ref 17592186166802 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166640 :question/id #uuid "41c8053f-0ad2-5b59-ba77-8f4fda1db022" :question/math-academy-id "e-8440"} :knowledge-point/id #uuid "ac76054a-1e1c-5091-bd52-39d12fe4e5d8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048878} {:db/id #edb/ref 17592186049303}] :knowledge-point/questions [{:db/id #edb/ref 17592186167416} {:db/id #edb/ref 17592186167417} {:db/id #edb/ref 17592186537898} {:db/id #edb/ref 17592186537973} {:db/id #edb/ref 17592186537982} {:db/id #edb/ref 17592186537987}] :knowledge-point/title "Integrating Expressions Using the Double-Angle Formula for Sine"} :step/id #uuid "395f50bb-2ee7-5efe-bd0b-fd5e3bf3643e" :step/math-academy-id 31435 :step/next {:db/id #edb/ref 17592186167639}} {:db/id #edb/ref 17592186167639 :step/content {:db/id #edb/ref 17592186166803 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166641 :question/id #uuid "b6c11fbd-00db-5506-baf0-2b6a94bfa6e8" :question/math-academy-id "e-8441"} :knowledge-point/id #uuid "425eb518-c5c6-5815-adf2-a54350f59d4d" :knowledge-point/questions [{:db/id #edb/ref 17592186167418} {:db/id #edb/ref 17592186167419} {:db/id #edb/ref 17592186537885} {:db/id #edb/ref 17592186537895} {:db/id #edb/ref 17592186537934}] :knowledge-point/title "Integrating Expressions Using the Double-Angle Formula for Cosine"} :step/id #uuid "8c1d7230-7a0f-5272-ab0d-dd538abc9384" :step/math-academy-id 31436 :step/next {:db/id #edb/ref 17592186167640}} {:db/id #edb/ref 17592186167640 :step/content {:db/id #edb/ref 17592186166804 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166642 :question/id #uuid "c91d7451-c9b5-57a1-9284-ec3fb617220c" :question/math-academy-id "e-8442"} :knowledge-point/id #uuid "e604fdb1-483e-54fb-b6ab-53912c968506" :knowledge-point/questions [{:db/id #edb/ref 17592186167420} {:db/id #edb/ref 17592186167421} {:db/id #edb/ref 17592186537887} {:db/id #edb/ref 17592186537892} {:db/id #edb/ref 17592186537923} {:db/id #edb/ref 17592186537970}] :knowledge-point/title "Integrating Expressions Using the Squared Cosine Double-Angle Formula"} :step/id #uuid "e8db643f-737e-55a3-9cb1-79d0ef4fba2e" :step/math-academy-id 31437 :step/next {:db/id #edb/ref 17592186167641}} {:db/id #edb/ref 17592186167641 :step/content {:db/id #edb/ref 17592186166805 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166643 :question/id #uuid "5d3a47d6-5a07-5fb6-9f57-23e74a7ba24f" :question/math-academy-id "e-8443"} :knowledge-point/id #uuid "d245094e-5e59-5dd9-85c1-9f0b5ca764e3" :knowledge-point/questions [{:db/id #edb/ref 17592186167422} {:db/id #edb/ref 17592186167423} {:db/id #edb/ref 17592186537886} {:db/id #edb/ref 17592186537891} {:db/id #edb/ref 17592186537909} {:db/id #edb/ref 17592186537963} {:db/id #edb/ref 17592186537971}] :knowledge-point/title "Integrating Expressions Using the Squared Sine Double-Angle Formula"} :step/id #uuid "216b7d60-59dd-599b-b414-ed79dbefb05e" :step/math-academy-id 31438} {:db/id #edb/ref 17592186167735 :step/content {:db/id #edb/ref 17592186168120 :tutorial/content "We can compute integrals containing hyperbolic functions using the hyperbolic counterparts of the trigonometric double-angle formulas. We use Osborn's rule to convert a trigonometric identity to a corresponding hyperbolic identity. \n\nOsborn's rule states that to convert a trigonometric identity to a corresponding hyperbolic identity, we\n\n- replace every trigonometric function with its corresponding hyperbolic function, and\n\n- for any product of two trigonometric sines, change the sign of the corresponding product of hyperbolic sines.\n\n$\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n        \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n        \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n        \\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits}\n        \\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits}\n        \\newcommand{\\tanh}{\\mathop{\\rm tanh}\\nolimits}\n        \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n        \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n        \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFor example, let's consider the following integral:\n\n$$\n\\displaystyle{\\int} \\sinh x \\cosh x \\, \\textrm{d}x\n$$\n\n  \n\nNotice that the corresponding trigonometric integral is\n\n$$\n\\displaystyle{\\int} \\sin x \\cos x \\, \\textrm{d}x.\n$$\n\n  \n\nOne way of solving this trigonometric integral is to use the double-angle formula for sine:\n\n$$\n\\sin 2x = 2\\sin x \\cos x\n$$\n\nApplying Osborn's rule, we get an equivalent hyperbolic identity:\n\n$$\n\\sinh 2x = 2\\sinh x \\cosh x\n$$\n\nRearranging the above formula, we get\n\n$$\n\\dfrac{1}{2}\\sinh {2x}= \\sinh x \\cosh x.\n$$\n\n \n\nTherefore, we can calculate our original integral as follows:\n\n$$\n\\begin{aligned}\\int \\operatorname{sinh}⁡x\\operatorname{cosh}⁡x\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{sinh}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\operatorname{sinh}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{2}\\operatorname{cosh}⁡2x+C \\\\  & =\\frac{1}{4}\\operatorname{cosh}⁡2x+C\\end{aligned}\n$$" :tutorial/id #uuid "5aeb4951-903e-5815-85fe-2b3fdd1c992e" :tutorial/math-academy-id 5558 :tutorial/title "Introduction"} :step/id #uuid "bfc4d4ca-c5b7-55a0-9d68-e0e086fc3de2" :step/math-academy-id 34434 :step/next {:db/id #edb/ref 17592186167638}}] :activity/title "Integration Using the Hyperbolic Double-Angle Formulas" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186167028}]}
