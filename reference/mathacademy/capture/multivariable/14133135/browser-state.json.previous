mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><msub><mi>X</mi><mn>1</mn></msub><mo stretchy=\"false\">(</mo><mi>s</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mi>s</mi><mo>−</mo><mn>3</mn></mrow></mfrac></mstyle><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><msub><mi>X</mi><mn>2</mn></msub><mo stretchy=\"false\">(</mo><mi>s</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>2</mn><msup><mi>s</mi><mn>2</mn></msup><mo>−</mo><mi>s</mi><mo>−</mo><mn>9</mn></mrow><mrow><mi>s</mi><mo stretchy=\"false\">(</mo><mi>s</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><mi>s</mi><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle></mpadded></mstyle><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
