ffd-4738bf877016" #edb/ref 17592186045417] [17592186304245 #edb/ref 1075 #edb/ref 17592186303058 #edb/ref 17592186045417] [17592186304245 #edb/ref 1075 #edb/ref 17592186303811 #edb/ref 17592186045417] [17592186304245 #edb/ref 1075 #edb/ref 17592186303824 #edb/ref 17592186045417] [17592186304245 #edb/ref 1075 #edb/ref 17592186303839 #edb/ref 17592186045417] [17592186304245 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186304245 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186304245 #edb/ref 1078 #edb/ref 17592186303058 #edb/ref 17592186045417] [17592186304245 #edb/ref 1079 #uuid "3d0f55e6-615e-5589-8583-791c7c78ee7a" #edb/ref 17592186045417] [17592186304314 #edb/ref 1075 #edb/ref 17592186302799 #edb/ref 17592186045417] [17592186304314 #edb/ref 1075 #edb/ref 17592186303070 #edb/ref 17592186045417] [17592186304314 #edb/ref 1075 #edb/ref 17592186303272 #edb/ref 17592186045417] [17592186304314 #edb/ref 1075 #edb/ref 17592186303659 #edb/ref 17592186045417] [17592186304314 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186304314 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186304314 #edb/ref 1078 #edb/ref 17592186303272 #edb/ref 17592186045417] [17592186304314 #edb/ref 1079 #uuid "571b82f8-3f2d-5456-bb83-188a9b88182f" #edb/ref 17592186045417] [17592186304448 #edb/ref 1075 #edb/ref 17592186303251 #edb/ref 17592186045417] [17592186304448 #edb/ref 1075 #edb/ref 17592186434029 #edb/ref 17592186045417] [17592186304448 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186304448 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186304448 #edb/ref 1078 #edb/ref 17592186434029 #edb/ref 17592186045417] [17592186304448 #edb/ref 1079 #uuid "8acdc256-05ee-570c-8605-17d181b69a3c" #edb/ref 17592186045417] [17592186305119 #edb/ref 1068 #edb/ref 17592186304448 #edb/ref 17592186045417] [17592186305119 #edb/ref 1069 "q-332784" #edb/ref 17592186045417] [17592186305119 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186305119 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=-{x}_{1}(t)+5 \\\\ {x}_{2}^{′}(t)=2{x}_{1}(t)+4{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}1 \\\\ -1\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=\\frac{s+5}{s(s+1)},\\,$\n${X}_{2}(s)=$ {{field-1}}." #edb/ref 17592186045417] [17592186305119 #edb/ref 1072 #uuid "53d3abf7-a9e9-5b69-8cf5-e63a711cb51d" #edb/ref 17592186045417] [17592186305119 #edb/ref 1074 "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{-{x}_{1}(t)+5\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{2{x}_{1}(t)+4{x}_{2}(t)\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=-L\\{{x}_{1}(t)\\}+5L\\{1\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=2L\\{{x}_{1}(t)\\}+4L\\{{x}_{2}(t)\\}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)-1=-{X}_{1}(s)+\\frac{5}{s} \\\\ s{X}_{2}(s)+1=2{X}_{1}(s)+4{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\},$ and we have used the fact that $L\\{1\\}=\\frac{1}{s}.$\n\nNow, solving the first equation for ${X}_{1}(s),$ we get\n\n$$\n\\begin{aligned}s{X}_{1}(s)-1 & =-{X}_{1}(s)+\\frac{5}{s} \\\\ (s+1){X}_{1}(s) & =1+\\frac{5}{s} \\\\ (s+1){X}_{1}(s) & =\\frac{s+5}{s} \\\\ {X}_{1}(s) & =\\frac{s+5}{s(s+1)}.\\end{aligned}\n$$\n\nSubstituting this in the second equation and solving for ${X}_{2}(s),$ we have\n\n$$\n\\begin{aligned}s{X}_{2}(s)+1 & =2{X}_{1}(s)+4{X}_{2}(s) \\\\ (s-4){X}_{2}(s) & =2{X}_{1}(s)-1 \\\\ (s-4){X}_{2}(s) & =2(\\frac{s+5}{s(s+1)})-1 \\\\ (s-4){X}_{2}(s) & =\\frac{2(s+5)-s(s+1)}{s(s+1)} \\\\ (s-4){X}_{2}(s) & =\\frac{-{s}^{2}+s+10}{s(s+1)} \\\\ {X}_{2}(s) & =\\frac{-{s}^{2}+s+10}{s(s+1)(s-4)}.\\end{aligned}\n$$\n\nTherefore, the solution of the new system  in terms of parameter $s$ is \n\n$$\n{X}_{1}(s)=\\frac{s+5}{s(s+1)},\\,{X}_{2}(s)=\\frac{-{s}^{2}+s+10}{s(s+1)(s-4)}.\n$$" #edb/ref 17592186045417] [17592186305121 #edb/ref 1068 #edb/ref 17592186304079 #edb/ref 17592186045417] [17592186305121 #edb/ref 1068 #edb/ref 17592186304245 #edb/ref 17592186045417] [17592186305121 #edb/ref 1068 #edb/ref 17592186304314 #edb/ref 17592186045417] [17592186305121 #edb/ref 1069 "q-332796" #edb/ref 17592186045417] [17592186305121 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186305121 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+3{t}^{2}+1 \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+4{x}_{2}(t)-2,\\end{aligned}\\,x(0)=[\\begin{aligned}1 \\\\ -1\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n\\{\\begin{aligned}{{field-1}}={{field-2}}+\\frac{1}{s} \\\\ s{X}_{2}(s)+1=-{X}_{1}(s)+4{X}_{2}(s)-{{field-3}}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." #edb/ref 17592186045417] [17592186305121 #edb/ref 1072 #uuid "158ccd60-79bd-5986-bdf7-58471b693523" #edb/ref 17592186045417] [17592186305121 #edb/ref 1074 "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{{x}_{1}(t)+3{t}^{2}+1\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{-{x}_{1}(t)+4{x}_{2}(t)-2\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=L\\{{x}_{1}(t)\\}+3L\\{{t}^{2}\\}+L\\{1\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=-L\\{{x}_{1}(t)\\}+4L\\{{x}_{2}(t)\\}-2L\\{1\\}\\end{aligned}\n$$\n\nFinally, using the results\n\n$$\nL\\{1\\}=\\frac{1}{s},\\,L\\{{t}^{2}\\}=\\frac{2}{{s}^{3}},\n$$\n\n we can write our system as follows:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)-1={X}_{1}(s)+\\frac{6}{{s}^{3}}+\\frac{1}{s} \\\\ s{X}_{2}(s)+1=-{X}_{1}(s)+4{X}_{2}(s)-\\frac{2}{s}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." #edb/ref 17592186045417] [17592186305329 #edb/ref 1080 "3{e}^{t}-1+2{e}^{-2t}" #edb/ref 17592186045417] [17592186305329 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186305329 #edb/ref 1083 #uuid "14a9d938-5d30-5c6c-b0a5-7c4e863e76a6" #edb/ref 17592186045417] [17592186306262 #edb/ref 1080 "{e}^{t}+2" #edb/ref 17592186045417] [17592186306262 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186306262 #edb/ref 1083 #uuid "74c732f2-4f86-504b-8cdd-aa1fa2e5c7f4" #edb/ref 17592186045417] [17592186307916 #edb/ref 1075 #edb/ref 17592186306262 #edb/ref 17592186045417] [17592186307916 #edb/ref 1075 #edb/ref 17592186434000 #edb/ref 17592186045417] [17592186307916 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186307916 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186307916 #edb/ref 1078 #edb/ref 17592186434000 #edb/ref 17592186045417] [17592186307916 #edb/ref 1079 #uuid "7d7b7b8a-07e2-5e92-88b6-369bfe5faec3" #edb/ref 17592186045417] [17592186308320 #edb/ref 1075 #edb/ref 17592186305329 #edb/ref 17592186045417] [17592186308320 #edb/ref 1075 #edb/ref 17592186434028 #edb/ref 17592186045417] [17592186308320 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186308320 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186308320 #edb/ref 1078 #edb/ref 17592186434028 #edb/ref 17592186045417] [17592186308320 #edb/ref 1079 #uuid "faba