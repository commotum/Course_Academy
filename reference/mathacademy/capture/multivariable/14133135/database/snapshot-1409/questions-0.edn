b/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{X}_{1}(s)" :db/id #edb/ref 17592186434018} {:answer/id #uuid "e66ec9ec-e7e4-5526-a4dc-c8046355a46e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{X}_{1}(s)" :db/id #edb/ref 17592186434025}] :answer-field/correct {:answer/id #uuid "a52d0672-5ea6-5aa6-aabc-a0f6a404f18b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s{X}_{1}(s)" :db/id #edb/ref 17592186434014} :answer-field/id #uuid "e33e0829-2491-5da0-ad4e-1b61cf04faeb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186434052}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66762fbf-e11e-5167-966c-39877463d24c" :question/math-academy-id "q-332822" :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t)+2{e}^{-t} \\\\ {x}_{2}^{′}(t)={x}_{1}(t)+{x}_{2}(t)+3,\\end{aligned}\\,x(0)=[\\begin{aligned}0 \\\\ -1\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n\\{\\begin{aligned}{{field-1}}=2{X}_{1}(s)+{{field-2}} \\\\ s{X}_{2}(s)+1={X}_{1}(s)+{X}_{2}(s)+{{field-3}}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." :question/worked-solution "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{2{x}_{1}(t)+2{e}^{-t}\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{{x}_{1}(t)+{x}_{2}(t)+3\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=2L\\{{x}_{1}(t)\\}+2L\\{{e}^{-t}\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=L\\{{x}_{1}(t)\\}+L\\{{x}_{2}(t)\\}+3L\\{1\\}\\end{aligned}\n$$\n\nFinally, using the results\n\n$$\nL\\{1\\}=\\frac{1}{s},\\,L\\{{e}^{-t}\\}=\\frac{1}{s+1},\n$$\n\nwe can write our system as follows:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)=2{X}_{1}(s)+\\frac{2}{s+1} \\\\ s{X}_{2}(s)+1={X}_{1}(s)+{X}_{2}(s)+\\frac{3}{s}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively."}] [{:db/id #edb/ref 17592186434060 :knowledge-point/_questions [{:db/id #edb/ref 17592186166933 :knowledge-point/id #uuid "ca890a8e-9ddd-51f7-9784-c9c1f020adef" :knowledge-point/title "Applying the Laplace Transform to a System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b7a2bd7-9605-5038-a6aa-2bd7a389479f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s{X}_{2}(s)+1" :db/id #edb/ref 17592186433975} {:answer/id #uuid "5fe9e4c2-6857-5e76-a5e1-c934b29bbccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{X}_{2}(s)+1" :db/id #edb/ref 17592186433993} {:answer/id #uuid "9525fbfe-8003-5680-8079-d4437207527a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{X}_{2}(s)-1" :db/id #edb/ref 17592186434009} {:answer/id #uuid "a6c1bbeb-8d1d-5bfb-84a6-750229aefdcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s{X}_{2}(s)-1" :db/id #edb/ref 17592186434016}] :answer-field/correct {:answer/id #uuid "1b7a2bd7-9605-5038-a6aa-2bd7a389479f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s{X}_{2}(s)+1" :db/id #edb/ref 17592186433975} :answer-field/id #uuid "310c7a56-5779-5193-ba63-3d051a163d7b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186434035} {:answer-field/choices [{:answer/id #uuid "18467ecb-f872-52de-8c3a-954144e25dbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{s}^{2}+1}" :db/id #edb/ref 17592186433973} {:answer/id #uuid "1a137370-2307-53aa-a7de-2e2ccb14dc29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s}" :db/id #edb/ref 17592186433974} {:answer/id #uuid "90f6c40c-3a38-5e50-a7e2-2e00bd8dd8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2s}{{s}^{2}+1}" :db/id #edb/ref 17592186434007} {:answer/id #uuid "a1467a02-00fe-5443-8742-43d39ae173dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{s}^{2}+1}" :db/id #edb/ref 17592186434011}] :answer-field/correct {:answer/id #uuid "18467ecb-f872-52de-8c3a-954144e25dbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{s}^{2}+1}" :db/id #edb/ref 17592186433973} :answer-field/id #uuid "47cd9c17-da01-57dd-b7a4-e1e589cf3c59" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186434039} {:answer-field/choices [{:answer/id #uuid "0f342f7d-f1a7-517d-9ceb-fa32f8e654c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{X}_{1}(s)-\\frac{5s}{{s}^{2}+1}" :db/id #edb/ref 17592186433970} {:answer/id #uuid "276559b7-acce-5afc-8493-8fd35dab3650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{X}_{1}(s)-\\frac{5s}{{s}^{2}+1}" :db/id #edb/ref 17592186433979} {:answer/id #uuid "5e5a58fc-5744-57b6-9455-edc920e17333" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{X}_{1}(s)-\\frac{4s}{{s}^{2}+1}" :db/id #edb/ref 17592186433990} {:answer/id #uuid "d0808cce-237e-5b98-ac4f-919a009b9a9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{X}_{1}(s)-\\frac{5}{{s}^{2}+1}" :db/id #edb/ref 17592186434023}] :answer-field/correct {:answer/id #uuid "276559b7-acce-5afc-8493-8fd35dab3650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{X}_{1}(s)-\\frac{5s}{{s}^{2}+1}" :db/id #edb/ref 17592186433979} :answer-field/id #uuid "c8055394-ff54-59e8-97af-e59ec5d57577" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186434049}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7ee61787-7fd7-52ae-8d70-3b4f4209ed09" :question/math-academy-id "q-332827" :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)-5\\operatorname{cos}⁡(t) \\\\ {x}_{2}^{′}(t)=-2{x}_{1}(t)+4{x}_{2}(t)+2\\operatorname{sin}⁡(t),\\end{aligned}\\,x(0)=[\\begin{aligned}2 \\\\ -1\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)-2={{field-1}} \\\\ {{field-2}}=-2{X}_{1}(s)+4{X}_{2}(s)+{{field-3}}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." :question/worked-solution "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{{x}_{1}(t)-5\\operatorname{cos}⁡(t)\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{-2{x}_{1}(t)+4{x}_{2}(t)+2\\operatorname{sin}⁡(t)\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=L\\{{x}_{1}(t)\\}-5L\\{\\operatorname{cos}⁡(t)\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=-2L\\{{x}_{1}(t)\\}+4L\\{{x}_{2}(t)\\}+2L\\{\\operatorname{sin}⁡(t)\\}\\end{aligned}\n$$\n\nFinally, using the results\n\n$$\nL\\{\\operatorname{cos}⁡(t)\\}=\\frac{s}{{s}^{2}+1},\\,L\\{\\operatorname{sin}⁡(t)\\}=\\frac{1}{{s}^{2}+1},\n$$\n\nwe can write our system as follows:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)-2={X}_{1}(s)-\\frac{5s}{{s}^{2}+1} \\\\ s{X}_{2}(s)+1=-2{X}_{1}(s)+4{X}_{2}(s)+\\frac{2}{{s}^{2}+1}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively."}] [{:db/id #edb/ref 17592186434059 :knowledge-point/_questions [{:db/id #edb/ref 17592186166933 :knowledge-point/id #uuid "ca890a8e-9ddd-51f7-9784-c9c1f020adef" :knowledge-point/title "Applying the Laplace Transform to a System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dccf10f-d077-5468-b48f-f956501801cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{{s}^{2}+16}" :db/id #edb/ref 17592186433997} {:answer/id #uuid "80c98707-d2a6-56bc-b4e8-81eefc396241" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{{s}^{2}+16}" :db/id #edb/ref 17592186434003} {:answer/id #uuid "b70f3ed1-093d-5994-b6e8-c09c12b4ee0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12s}{{s}^{2}+16}" :db/id #edb/ref 17592186434019} {:answer/id #uuid "e723be1e-3436-5f1e-ae9b-8aed6f8e9333" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{{s}^{2}+16}" :db/id #edb/ref 17592186434026}] :answer-field/correct {:answer/id #uuid "6dccf10f-d077-5468-b48f-f956501801cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{{s}^{2}+16}" :db/id #edb/ref 17592186433997} :answer-field/id #uuid "5228e2cb-78f1-515d-8ae9-dcbf7952ba53" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 1759218