\\  & ={e}^{3t}-2\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}2{e}^{3t}+{e}^{t}-1 \\\\ {e}^{3t}-2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186434058 :knowledge-point/_questions [{:db/id #edb/ref 17592186166935 :knowledge-point/id #uuid "dff314a2-9059-5a37-8c2c-2b7a2fe6dcd9" :knowledge-point/title "Solving an Initial Value Problem Given the Laplace Transformed Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe5816cf-57c0-58c1-b85d-cb4c08ed65b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{t}+e^{3t}-1" :db/id #edb/ref 17592186434030}] :answer-field/correct {:answer/id #uuid "fe5816cf-57c0-58c1-b85d-cb4c08ed65b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{t}+e^{3t}-1" :db/id #edb/ref 17592186434030} :answer-field/id #uuid "64259115-8467-5355-9ba3-628dcd4e0781" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186434042} {:answer-field/choices [{:answer/id #uuid "94645582-a111-50c2-9426-8d1ed31b5cb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e^{t}+1" :db/id #edb/ref 17592186434008}] :answer-field/correct {:answer/id #uuid "94645582-a111-50c2-9426-8d1ed31b5cb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e^{t}+1" :db/id #edb/ref 17592186434008} :answer-field/id #uuid "f09a48b6-6147-5c33-8f73-ea1439dfbd04" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186434053}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "69e91785-0e6d-5932-8b31-7b7666b19d7a" :questio