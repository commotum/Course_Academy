b/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s}" :db/id #edb/ref 17592186302799} {:answer/id #uuid "64e25b69-fb0b-58c9-bb85-f7c4c1c1964b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{s}" :db/id #edb/ref 17592186303070} {:answer/id #uuid "82ac8fa2-cadc-50d8-82da-d554595934c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{s}" :db/id #edb/ref 17592186303272} {:answer/id #uuid "c4007cf6-f03a-5099-aa50-99917a6d166f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{s}^{2}}" :db/id #edb/ref 17592186303659}] :answer-field/correct {:answer/id #uuid "82ac8fa2-cadc-50d8-82da-d554595934c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{s}" :db/id #edb/ref 17592186303272} :answer-field/id #uuid "571b82f8-3f2d-5456-bb83-188a9b88182f" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186304314}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "158ccd60-79bd-5986-bdf7-58471b693523" :question/math-academy-id "q-332796" :question/problem "$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+3{t}^{2}+1 \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+4{x}_{2}(t)-2,\\end{aligned}\\,x(0)=[\\begin{aligned}1 \\\\ -1\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n\\{\\begin{aligned}{{field-1}}={{field-2}}+\\frac{1}{s} \\\\ s{X}_{2}(s)+1=-{X}_{1}(s)+4{X}_{2}(s)-{{field-3}}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." :question/worked-solution "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\}=L\\{{x}_{1}(t)+3{t}^{2}+1\\} \\\\ L\\{{x}_{2}^{′}(t)\\}=L\\{-{x}_{1}(t)+4{x}_{2}(t)-2\\}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0)=L\\{{x}_{1}(t)\\}+3L\\{{t}^{2}\\}+L\\{1\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0)=-L\\{{x}_{1}(t)\\}+4L\\{{x}_{2}(t)\\}-2L\\{1\\}\\end{aligned}\n$$\n\nFinally, using the results\n\n$$\nL\\{1\\}=\\frac{1}{s},\\,L\\{{t}^{2}\\}=\\frac{2}{{s}^{3}},\n$$\n\n we can write our system as follows:\n\n$$\n\\{\\begin{aligned}s{X}_{1}(s)-1={X}_{1}(s)+\\frac{6}{{s}^{3}}+\\frac{1}{s} \\\\ s{X}_{2}(s)+1=-{X}_{1}(s)+4{X}_{2}(s)-\\frac{2}{s}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L\\{{x}_{1}(t)\\}$ and ${X}_{2}(s)=L\\{{x}_{2}(t)\\}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively."}] [{:db/id #edb/ref 17592186434056 :knowledge-point/_questions [{:db/id #edb/ref 17592186166933 :knowledge-point/id #uuid "ca890a8e-9ddd-51f7-9784-c9c1f020adef" :knowledge-point/title "Applying the Laplace Transform to a System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "356f21fe-a1c7-5137-8d1b-2746f4b08fb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{X}_{1}(s)+\\frac{2}{{s}^{3}}" :db/id #edb/ref 17592186433983} {:answer/id #uuid "5fe66e76-0d0f-5d26-8ee9-b827b97e4539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{X}_{1}(s)+\\frac{2}{{s}^{2}}" :db/id #edb/ref 17592186433992} {:answer/id #uuid "6579df18-faf4-5454-8272-7e532385de39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{X}_{1}(s)+\\frac{4}{{s}^{3}}" :db/id #edb/ref 17592186433995} {:answer/id #uuid "e18df4c6-9fa8-5d8a-a157-1c59373bfda9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math}