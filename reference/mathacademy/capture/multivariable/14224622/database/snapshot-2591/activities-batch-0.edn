#{[{:activity/first-step {:db/id #edb/ref 17592186176702} :activity/id #uuid "d4bf6855-3ee9-564c-a98f-cca62f229eef" :activity/scope {:db/id #edb/ref 17592186048568 :topic/id #uuid "aa7fefd1-2912-58e4-b2a0-bbf07ec60fc5" :topic/math-academy-id 3641} :activity/steps [{:db/id #edb/ref 17592186176702 :step/content {:db/id #edb/ref 17592186176983 :tutorial/content "Consider the region enclosed by the curves $x=f(y)$ on the right, $x=g(y)$ on the left, and the horizontal lines $y=c$ and $y=d$, as shown below. We assume that\n\n$$\nf(y) \\geq g(y)\n$$\n\nfor all $y \\in [c,d]$.\n\n![](images/9a/9a3970253f710223a77fe43f717df908fc20f27950744166ea7197897d64936d.png)\n\nTo find the volume of the solid generated when this region is rotated $2\\pi$ radians about the $x$-axis, we use the shell method as follows:\n\n$$\n\\begin{aligned}\nV &= 2π\\int_{c}^{d}y([right] - [left])dy \\\\\n&= 2π\\int_{c}^{d}y([f(y)] - [g(y)])dy\n\\end{aligned}\n$$" :tutorial/id #uuid "ee650309-6a00-514b-83cf-cc7028b14529" :tutorial/math-academy-id 5293 :tutorial/title "Introduction"} :step/id #uuid "0e02ebde-56c8-5084-9591-4df36f3cd368" :step/math-academy-id 33079 :step/next {:db/id #edb/ref 17592186176704}} {:db/id #edb/ref 17592186176703 :step/content {:db/id #edb/ref 17592186175968 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175818 :question/id #uuid "7520ab43-c5b9-541b-80a9-4af1b91b2428" :question/math-academy-id "e-8855"} :knowledge-point/id #uuid "2737d1a7-2af9-54ed-8c42-5191fc68a31b" :knowledge-point/questions [{:db/id #edb/ref 17592186176404} {:db/id #edb/ref 17592186176406}] :knowledge-point/title "Finding the Volume of a Solid Using the Shell Method"} :step/id #uuid "06aa8368-cb63-543a-ad96-6e6d78f9e484" :step/math-academy-id 33080} {:db/id #edb/ref 17592186176704 :step/content {:db/id #edb/ref 17592186175969 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175819 :question/id #uuid "9f7f3606-5c49-51d0-b4e5-cffd0310b6c1" :question/math-academy-id "e-8857"} :knowledge-point/id #uuid "3cd62b9c-0fbc-5a1e-b923-b2be8a55e44a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050159}] :knowledge-point/questions [{:db/id #edb/ref 17592186176215} {:db/id #edb/ref 17592186176403}] :knowledge-point/title "Constructing an Integral Representing the Volume of a Solid"} :step/id #uuid "0f92ebc5-99c7-586a-a2b6-1b4a35a8f655" :step/math-academy-id 33083 :step/next {:db/id #edb/ref 17592186176703}}] :activity/title "The Shell Method: Rotating a Region Between Two Curves About the X-Axis" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176158}]}
