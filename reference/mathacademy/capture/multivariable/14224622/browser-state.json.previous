      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14224622/observations/step-q107304-b1f07414ab4a7cde7433.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14224622/observations/step-q107304-b1f07414ab4a7cde7433.png",
      "source_url": "https://mathacademy.com/tasks/14224622/topics/3641/lesson",
      "captured_at": 1792042758.353792,
      "math_academy_id": "q-107304",
      "topic_id": "3641",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q107304",
        "placement_id": null,
