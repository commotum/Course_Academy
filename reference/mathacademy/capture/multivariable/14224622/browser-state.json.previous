      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14224622/observations/step-q107142-b082f7283d62d7b583db.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14224622/observations/step-q107142-b082f7283d62d7b583db.png",
      "source_url": "https://mathacademy.com/tasks/14224622/topics/3641/lesson",
      "captured_at": 1792042736.0685647,
      "math_academy_id": "q-107142",
