      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14224622/observations/step-q126191-2403e1f02a250cd7319d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14224622/observations/step-q126191-2403e1f02a250cd7319d.png",
      "source_url": "https://mathacademy.com/tasks/14224622/topics/3641/lesson",
