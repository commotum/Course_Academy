      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14224622/observations/step-q106122-48d1469bfea274a29c29.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14224622/observations/step-q106122-48d1469bfea274a29c29.png",
      "source_url": "https://mathacademy.com/tasks/14224622/topics/3641/lesson",
      "captured_at": 1792042599.3428614,
      "math_academy_id": "q-106122",
      "topic_id": "3641",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q106122",
        "placement_id": null,
        "content_id": null,
