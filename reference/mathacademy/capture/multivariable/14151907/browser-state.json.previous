      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14151907/observations/step-q163582-82afaafcf16fdc6b470d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14151907/observations/step-q163582-82afaafcf16fdc6b470d.png",
      "source_url": "https://mathacademy.com/tasks/14151907/topics/4174/review",
