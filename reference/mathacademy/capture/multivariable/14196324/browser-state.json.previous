      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196324/observations/step-q344371-ba97c0b7612e5be42e7c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196324/observations/step-q344371-ba97c0b7612e5be42e7c.png",
      "source_url": "https://mathacademy.com/tasks/14196324/topics/1217/lesson",
