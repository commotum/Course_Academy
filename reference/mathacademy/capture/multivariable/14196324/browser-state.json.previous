      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196324/observations/step-q344541-fa2839a1aeccebbe48b4.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196324/observations/step-q344541-fa2839a1aeccebbe48b4.png",
      "source_url": "https://mathacademy.com/tasks/14196324/topics/1217/lesson",
      "captured_at": 1791953757.6319516,
      "math_academy_id": "q-344541",
