      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196324/observations/step-q344350-6bde3355e3b8258afb1d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196324/observations/step-q344350-6bde3355e3b8258afb1d.png",
      "source_url": "https://mathacademy.com/tasks/14196324/topics/1217/lesson",
      "captured_at": 1791953651.1745317,
