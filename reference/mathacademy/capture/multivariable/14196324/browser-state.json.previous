      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196324/observations/step-q118820-a2fb4fd29e671dec5c3f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14196324/observations/step-q118820-a2fb4fd29e671dec5c3f.png",
      "source_url": "https://mathacademy.com/tasks/14196324/topics/1217/lesson",
      "captured_at": 1791953692.0760283,
      "math_academy_id": "q-118820",
      "topic_id": "1217",
      "sequence_position": null,
      "source_step": {
