      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14243229/observations/step-q344169-09f7c0eb3e882d9375fd.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14243229/observations/step-q344169-09f7c0eb3e882d9375fd.png",
