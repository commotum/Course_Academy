t style=\"vertical-align: -0.15em; margin-left: -0.06em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6D\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c6E\"></mjx-c></mjx-mtext></mjx-texatom></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>f</mi><mrow data-mjx-texclass=\"ORD\"><mtext>min</mtext></mrow></msub><mo>=</mo></math></mjx-assistive-mml></mjx-container>\n<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:35px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"9\"><span mathquill-command-id=\"11\" class=\"\">−</span><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"13\"><span class=\"mq-numerator\" mathquill-block-id=\"15\"><span mathquill-command-id=\"14\">1</span><span mathquill-command-id=\"16\">3</span></span><span class=\"mq-denominator\" mathquill-block-id=\"19\"><span mathquill-command-id=\"18\">4</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div></div></div><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div class=\"questionWidget-spinner\" style=\"display: block;\"></div></div><div class=\"questionWidget-result\"><div class=\"quest