      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14243229/observations/step-q344177-2b81e2b139ad778b6dc7.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14243229/observations/step-q344177-2b81e2b139ad778b6dc7.png",
      "source_url": "https://mathacademy.com/tasks/14243229/topics/3896/review",
      "captured_at": 1792100732.818938,
      "math_academy_id": "q-344177",
