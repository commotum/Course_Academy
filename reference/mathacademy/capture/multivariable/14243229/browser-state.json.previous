      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14243229/observations/step-q104053-0b1b8f26755920216dee.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14243229/observations/step-q104053-0b1b8f26755920216dee.png",
      "source_url": "https://mathacademy.com/tasks/14243229/topics/3896/review",
      "captured_at": 1792100639.5522325,
