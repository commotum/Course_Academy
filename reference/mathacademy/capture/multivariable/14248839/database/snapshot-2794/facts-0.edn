71-557c-9aa6-b1f458fd2aba" #edb/ref 17592186045417] [17592186050483 #edb/ref 1027 #edb/ref 17592186048628 #edb/ref 17592186045417] [17592186050483 #edb/ref 1027 #edb/ref 17592186049409 #edb/ref 17592186045417] [17592186050483 #edb/ref 1027 #edb/ref 17592186049727 #edb/ref 17592186045417] [17592186050483 #edb/ref 1027 #edb/ref 17592186050118 #edb/ref 17592186045417] [17592186050483 #edb/ref 1028 #edb/ref 17592186092370 #edb/ref 17592186045417] [17592186050483 #edb/ref 1028 #edb/ref 17592186092371 #edb/ref 17592186045417] [17592186050483 #edb/ref 1028 #edb/ref 17592186092372 #edb/ref 17592186045417] [17592186050483 #edb/ref 1031 "Newton's Method" #edb/ref 17592186045417] [17592186050483 #edb/ref 1033 912 #edb/ref 17592186045417] [17592186050483 #edb/ref 1035 #uuid "4d42e8ab-7d60-5380-b9d4-046ff9069092" #edb/ref 17592186045417] [17592186202982 #edb/ref 1075 #edb/ref 17592186566453 #edb/ref 17592186045417] [17592186202982 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186202982 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186202982 #edb/ref 1078 #edb/ref 17592186566453 #edb/ref 17592186045417] [17592186202982 #edb/ref 1079 #uuid "87e64f3c-51b1-5434-ba7f-f814d56f0237" #edb/ref 17592186045417] [17592186203013 #edb/ref 1075 #edb/ref 17592186566399 #edb/ref 17592186045417] [17592186203013 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186203013 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186203013 #edb/ref 1078 #edb/ref 17592186566399 #edb/ref 17592186045417] [17592186203013 #edb/ref 1079 #uuid "d5af280c-c756-592a-9a39-676c0b8ff81b" #edb/ref 17592186045417] [17592186203014 #edb/ref 1075 #edb/ref 17592186566514 #edb/ref 17592186045417] [17592186203014 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186203014 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186203014 #edb/ref 1078 #edb/ref 17592186566514 #edb/ref 17592186045417] [17592186203014 #edb/ref 1079 #uuid "4f26550d-f8be-5b43-b6c1-b97ec83cf43b" #edb/ref 17592186045417] [17592186203825 #edb/ref 1069 "e-16569" #edb/ref 17592186045417] [17592186203825 #edb/ref 1071 "Suppose we wish to find a zero of the function $\\boldsymbol{f}(x,y)$ in the region $[-2,2] \\times [0,2] \\subseteq \\mathbb{R}^2,$ where\n![](images/0f/0f5dda7937b1ffed646730040efe11464d46ef1f3ec6ae5dacf84075bd5be01b.png)\nCalculate one iteration of the Newton-Raphson process that starts with $\\mathbf x_0 = \\big[1, \\: 2 \\big]^T.$" #edb/ref 17592186045417] [17592186203825 #edb/ref 1072 #uuid "37f0d2c0-c174-5478-a007-5fb3d32bafe2" #edb/ref 17592186045417] [17592186203825 #edb/ref 1074 "The Newton-Raphson method of finding the zeros of a multivariable function $\\boldsymbol{f} : \\mathbb{R}^n \\to \\mathbb{R}^n$ is\n\n$$\n\\mathbf{x}_{n+1} = \\mathbf{x}_n - [J_\\boldsymbol{f}(\\mathbf{x}_n)]^{-1} \\boldsymbol{f}(\\mathbf{x}_n),\n$$\n\nwhere $J_\\boldsymbol{f}(\\mathbf{x}_n)$ is the Jacobian of $\\boldsymbol f$ evaluated at $\\mathbf{x}_n.$\n\nIn our case, the Jacobian is\n\n$$\n\\begin{aligned}{J}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}({x}^{2}y-x-2) & \\frac{∂}{∂y}({x}^{2}y-x-2) \\\\ \\frac{∂}{∂x}(x{y}^{2}-y+1) & \\frac{∂}{∂y}(x{y}^{2}-y+1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2xy-1 & {x}^{2} \\\\ {y}^{2} & 2xy-1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n![](images/c3/c3ec90119193ca9c0cb886bc7b7c698eb155e6a801fd267c0a17a0d329eff84d.png)\n\nStarting with ![](images/ef/eff9e5b8ab46002bd82fa42d59f60b1bb78ca04228d7c73b52d131d222ccb894.png) we have\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}-{\\begin{bmatrix}2xy-1 & {x}^{2} \\\\ {y}^{2} & 2xy-1\\end{bmatrix}}_{{x}_{0}}^{-1}{\\begin{bmatrix}{x}^{2}y-x-2 \\\\ x{y}^{2}-y+1\\end{bmatrix}}_{{x}_{0}} \\\\  & =\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}-{\\begin{bmatrix}2(1)(2)-1 & (1)^{2} \\\\ (2)^{2} & 2(1)(2)-1\\end{bmatrix}}^{-1}\\begin{bmatrix}(1)^{2}(2)-1-2 \\\\ 1(2)^{2}-2+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}-{\\begin{bmatrix}3 & 1 \\\\ 4 & 3\\end{bmatrix}}^{-1}\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}-\\frac{1}{3\\cdot 3-4\\cdot 1}\\begin{bmatrix}3 & -1 \\\\ -4 & 3\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}-\\frac{1}{5}\\begin{bmatrix}-6 \\\\ 13\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{11}{5} \\\\ -\\frac{3}{5}\\end{bmatrix} \\\\  & =\\begin{bmatrix}2.2 \\\\ -0.6\\end{bmatrix}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186203826 #edb/ref 1069 "e-16570" #edb/ref 17592186045417] [17592186203826 #edb/ref 1071 "Suppose we wish to find a zero of the function $\\boldsymbol{f}(x,y)$ in the region $[1,3] \\times [-2,0] \\subseteq \\mathbb{R}^2,$ where\n![](images/89/891b79a977ea7d9f4062d3614d7001ade71cfc10de54fcbae6608eebed7e8d1a.png)\nCalculate the second iteration of the Newton-Raphson process that starts at $\\mathbf x_0 = \\big[1, \\: 0 \\big]^T$ if the first iteration of the algorithm gives $\\mathbf{x}_1 = \\big[ 3, \\: -1 \\big]^T.$ Round your final answer to three decimal places (if needed)." #edb/ref 17592186045417] [17592186203826 #edb/ref 1072 #uuid "1fa3ed18-5fb9-53b2-a067-5db623a289d3" #edb/ref 17592186045417] [17592186203826 #edb/ref 1074 "The Newton-Raphson method of finding the zeros of a multivariable function $\\boldsymbol{f} : \\mathbb{R}^n \\to \\mathbb{R}^n$ is\n\n$$\n\\mathbf{x}_{n+1} = \\mathbf{x}_n - [J_\\boldsymbol{f}(\\mathbf{x}_n)]^{-1} \\boldsymbol{f}(\\mathbf{x}_n),\n$$\n\nwhere $J_\\boldsymbol{f}(\\mathbf{x}_n)$ is the Jacobian of $\\boldsymbol f$ evaluated at $\\mathbf{x}_n.$\n\nIn our case, the Jacobian is\n\n$$\n\\begin{aligned}{J}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}({x}^{2}+y-4) & \\frac{∂}{∂y}({x}^{2}+y-4) \\\\ \\frac{∂}{∂x}(x+{y}^{2}-3) & \\frac{∂}{∂y}(x+{y}^{2}-3)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x & 1 \\\\ 1 & 2y\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n![](images/95/95e234c5c9b32e1ea965f1cd184563699fbd2793d51a9d1e4ec96ffb4e42dc50.png)\n\nFor the second iteration, we have\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-{\\begin{bmatrix}2x & 1 \\\\ 1 & 2y\\end{bmatrix}}_{{x}_{1}}^{-1}{\\begin{bmatrix}{x}^{2}+y-4 \\\\ x+{y}^{2}-3\\end{bmatrix}}_{{x}_{1}} \\\\  & =\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}-{\\begin{bmatrix}2(3) & 1 \\\\ 1 & 2(-1)\\end{bmatrix}}^{-1}\\begin{bmatrix}{3}^{2}+(-1)-4 \\\\ 3+(-1)^{2}-3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}-{\\begin{bmatrix}6 & 1 \\\\ 1 & -2\\end{bmatrix}}^{-1}\\begin{bmatrix}4 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}-\\frac{1}{6\\cdot (-2)-1\\cdot 1}\\begin{bmatrix}-2 & -1 \\\\ -1 & 6\\end{bmatrix}\\begin{bmatrix}4 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}+\\frac{1}{13}\\begin{bmatrix}-9 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{30}{13} \\\\ -\\frac{11}{13}\\end{bmatrix} \\\\  & ≈\\begin{bmatrix}2.308 \\\\ -0.846\\end{bmatrix},\\end{aligned}\n$$\n\nrounded to three decimal places." #edb/ref 17592186045443] [17592186203827 #edb/ref 1069 "e-16571" #edb/ref 17592186045417] [17592186203827 #edb/ref 1071 "Suppose we wish to find a zero of the function $\\boldsymbol{f}(x,y)$ in the region $[0,1] \\times [0,1] \\subseteq \\mathbb{R}^2,$ where\n![](images/c3/c3c2b2e7a9d5b2b8f76499b0ad62d628f9d79bc7c41b6bcaf9926df4f368cdbf.png)\nFind the matrix equation that defines the first iteration of the Newton-Raphson process starting at the point $\\big[ 1, \\: 1 \\big]^T,$ and compute the components of the first iteration." #edb/ref 17592186045417] [17592186203827 #edb/ref 1072 #uuid "5da362d4-cb58-5b51-acc0-582e3a0d42e4" #edb/ref 17592186045417] [17592186203827 #edb/ref 1074 "The Newton-Raphson method of finding the zeros of a multivariable function $\\boldsymbol{f} : \\mathbb{R}^n \\to \\mathbb{R}^n$ is\n\n$$\n\\mathbf{x}_{n+1} = \\mathbf{x}_n - [J_\\boldsymbol{f}(\\mathbf{x}_n)]^{-1} \\boldsymbol{f}(\\mathbf{x}_n),\n$$\n\nwhere $J_\\boldsymbol{f}(\\mathbf{x}_n)$ is the Jacobian of $\\boldsymbol f$ evaluated at $\\mathbf{x}_n.$\n\nEquivalently, at each iteration, the above equation can be re-written as \n\n$$\nJ_\\boldsymbol{f}(\\mathbf{x}_n)(\\mathbf{x}_{n+1}-\\mathbf{x}_n) = -\\boldsymbol{f}(\\mathbf{x}_n).\n$$\n\nIn our case, the Jacobian is\n\n$$\n\\begin{aligned}{J}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}({x}^{2}-{y}^{2}) & \\frac{∂}{∂y}({x}^{2}-{y}^{2}) \\\\ \\frac{∂}{∂x}(2xy-1) & \\frac{∂}{∂y}(2xy-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2x & -2y \\\\ 2y & 2x\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson system of equations is\n\n![](images/13/13f9eb9850462317be5a5c7da22fe53ee89b24d9ce1a9226c2d0ee1e6355ba19.png)\n\nStarting with ![](images/8b/8bdb55b26b462507d9810675499558be66e7b970d2f9fdb78e708807e617ce8d.png) we have\n\n$$\n\\begin{aligned}{\\begin{bmatrix}2x & -2y \\\\ 2y & 2x\\end{bmatrix}}_{{x}_{0}}({x}_{1}-{x}_{0}) & =-{\\begin{bmatrix}{x}^{2}-{y}^{2} \\\\ 2xy-1\\end{bmatrix}}_{{x}_{0}} \\\\ \\begin{bmatrix}2(1) & -2(1) \\\\ 2(1) & 2(1)\\end{bmatrix}({x}_{1}-{x}_{0}) & =-\\begin{bmatrix}(1)^{2}-(1)^{2} \\\\ 2(1)(1)-1\\end{bmatrix} \\\\ \\begin{bmatrix}2 & -2 \\\\ 2 & 2\\end{bmatrix}({x}_{1}-{x}_{0}) & =\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nSolving this system of equations, we get ![](images/d5/d5eb5a91fdd96bf6ca50539d2119a97ce9e5600b3114f708cda4d95a047e8b81.png) Hence,\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}+\\begin{bmatrix}-0.25 \\\\ -0.25\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}-0.25 \\\\ -0.25\\end{bmatrix} \\\\  & =\\begin{bmatrix}0.75 \\\\ 0.75\\end{bmatrix}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186204082 #edb/ref 1037 #edb/ref 17592186048219 #edb/ref 17592186045417] [17592186204082 #edb/ref 1037 #edb/ref 17592186049548 #edb/ref 17592186045417] [17592186204082 #edb/ref 1037 #edb/ref 17592186050483 #edb/ref 17592186045417] [17592186204082 #edb/ref 1038 #edb/ref 17592186204498 #edb/ref 17592