a }_{1}t & =-{e}^{6t}t \\\\  & ={e}^{6t}(-t), \\\\ 5{\\alpha }_{1}t+{\\alpha }_{0} & =5{e}^{6t}t+{e}^{6t}(1-6t) \\\\  & ={e}^{6t}(1-t)\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{e}^{At}={e}^{6t}\\begin{bmatrix}1+t & t \\\\ -t & 1-t\\end{bmatrix}.\n$$" #edb/ref 17592186045443] [17592186370130 #edb/ref 1075 #edb/ref 17592186370131 #edb/ref 17592186045417] [17592186370130 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186370130 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186370130 #edb/ref 1078 #edb/ref 17592186370131 #edb/ref 17592186045417] [17592186370130 #edb/ref 1079 #uuid "8717736e-bf1d-56b9-8978-2ee27ddc1c10" #edb/ref 17592186045417] [17592186370131 #edb/ref 1080 "\\operatorname{sin}(t)" #edb/ref 17592186045417] [17592186370131 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186370131 #edb/ref 1083 #uuid "7afe076b-ab10-5a6d-92ee-d9bda36095eb" #edb/ref 17592186045417] [17592186370132 #edb/ref 1075 #edb/ref 17592186370133 #edb/ref 17592186045417] [17592186370132 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186370132 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186370132 #edb/ref 1078 #edb/ref 17592186370133 #edb/ref 17592186045417] [17592186370132 #edb/ref 1079 #uuid "6684d3cf-4512-5e44-a922-9538752b4a1d" #edb/ref 17592186045417] [17592186370133 #edb/ref 1080 "-\\operatorname{sin}(t)" #edb/ref 17592186045417] [17592186370133 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186370133 #edb/ref 1083 #uuid "116b716d-7743-526a-8367-67bb770fa2aa" #edb/ref 17592186045417] [17592186531935 #edb/ref 1043 #edb/ref 17592186532728 #edb/ref 17592186045417] [17592186531935 #edb/ref 1043 #edb/ref 17592186532736 #edb/ref 17592186045417] [17592186531935 #edb/ref 1043 #edb/ref 17592186532744 #edb/ref 17592186045417] [17592186531935 #edb/ref 1043 #edb/ref 17592186532761 #edb/ref 17592186045417] [17592186531935 #edb/ref 1043 #edb/ref 17592186532762 #edb/ref 17592186045417] [1759218