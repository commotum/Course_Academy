-8d7e-311d4a4c980d" #edb/ref 17592186045417] [17592186185426 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186185426 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186185426 #edb/ref 1083 #uuid "c30e5ea3-e2d6-5c94-88aa-d763c1948734" #edb/ref 17592186045417] [17592186185427 #edb/ref 1080 "-8" #edb/ref 17592186045417] [17592186185427 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186185427 #edb/ref 1083 #uuid "c68099e9-f773-54d9-a3e5-42bd9bdb5311" #edb/ref 17592186045417] [17592186185428 #edb/ref 1080 "-5" #edb/ref 17592186045417] [17592186185428 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186185428 #edb/ref 1083 #uuid "d288b09f-39a9-530c-aa67-bbf726fea5ef" #edb/ref 17592186045417] [17592186185429 #edb/ref 1080 "-4" #edb/ref 17592186045417] [17592186185429 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186185429 #edb/ref 1083 #uuid "e3bca3e6-7175-5376-9f18-97b44e4a39fd" #edb/ref 17592186045417] [17592186188024 #edb/ref 1069 "e-10246" #edb/ref 17592186045417] [17592186188024 #edb/ref 1071 "![](images/02/025ea896b8ef2253530a6392fc5b5c89c70df5083a673de14a1c6e13108068bd.png)\n\nThe function $f(x)$ is defined and differentiable on $[-6,2]$. The graph of $f'(x)$, the derivative of $f(x)$, is shown above. Find the maximum value of the function $f(x)$ on the interval $[-6,2]$ given that $f(2) = 4$." #edb/ref 17592186045417] [17592186188024 #edb/ref 1072 #uuid "d97c3cf2-b627-5274-853a-be3d7e5cda40" #edb/ref 17592186045417] [17592186188024 #edb/ref 1074 "According to the candidates test, the maximum value of $f(x)$ on $[-6,2]$ must occur at a critical point or an endpoint of the interval.\n\n**Step 1**: Find the critical points.\n\nWe see that $f'(x)$ is defined everywhere on $x\\in (-6,2)$, and $f'(x)=0$ at $x=-2$ Therefore, the candidates are $x=-6,-2,2$.\n\n**Step 2**: Compute the value of $f$ for each candidate using the fundamental theorem of calculus.\n\nThe function is made up of $1$ trapezoid and $1$ triangle. Let's add the areas bounded by these shapes to our diagram:\n\n![](images/1b/1bcd6d6800caf6abdca868bba4abff3935f26e984807f13c25d4368dc858f2c1.png)\n\nUsing the given information and the fundamental theorem of calculus, we have the following:\n\n$$\n\\begin{aligned}\nf(2) &= 4 \\\\\nf(-2) &= f(2) + \\int_{2}^{-2}f^{′}(x)dx \\\\\n&= f(2) - \\int_{-2}^{2}f^{′}(x)dx \\\\\n&= 4 - 8 \\\\\n&=-4 \\\\\nf(-6) &= f(2) + \\int_{2}^{-6}f^{′}(x)dx \\\\\n&= f(2) - \\int_{-6}^{2}f^{′}(x)dx \\\\\n&= 4 - (-6 + 8) \\\\\n&= 4 - 2 \\\\\n&= 2\n\\end{aligned}\n$$\n\n**Step 3**: Select the largest value of $f$ from our candidates.\n\nComparing the values of $f$ found in step $2$, we have\n\n$$\nf_{\\text{max}} = \\max\\{4,-4,2\\} = 4\n$$\n\nTherefore, the maximum value of $f$ is\n\n$$\nf_{\\text{max}}=4\n$$\n\nand the value of $x$ that maximizes $f(x)$ is\n\n$$\nx_\\text{max}=2\n$$" #edb/ref 17592186045417] [17592186188025 #edb/ref 1069 "e-10247" #edb/ref 17592186045417] [17592186188025 #edb/ref 1071 "The function $f(x)$ is defined and differentiable on $[-6,6]$. The graph of $f'(x)$, the derivative of $f(x)$, is shown below, where the areas of the regions between the graph and the $x$-axis are $9, 3$ and $5$, respectively (from left to right). Find the minimum value of $f(x)$ on the interval $[-6,6]$ given that $f(6) = 2$.\n\n![](images/ab/ab98f2f27ff11ddb40138bf09900a865ca006bc8f26c95dfe03ea17fd4e49387.png)" #edb/ref 17592186045417] [17592186188025 #edb/ref 1072 #uuid "b28b6939-847d-51ab-a97d-4367323d0d01" #edb/ref 17592186045417] [17592186188025 #edb/ref 1074 "According to the candidates test, the minimum value of $f(x)$ on $[-6,6]$ must occur at a critical point or an endpoint of the interval.\n\n**Step 1**: Find the critical points.\n\nWe see that $f'(x)$ is defined everywhere on $x \\in (-6,6)$, and $f'(x) = 0$ at $x=0$ and $x=3$. Therefore, the candidates are $x=-6,0,3,6$.\n\n**Step 2**: Compute the value of $f$ for each candidate using the fundamental theorem of calculus.\n\nUsing the given information and the fundamental theorem of calculus, we have the following:\n\n$$\n\\begin{aligned}\nf(6) &= 2 \\\\\nf(3) &= f(6) + \\int_{6}^{3}f^{′}(x)dx \\\\\n&= f(6) - \\int_{3}^{6}f^{′}(x)dx \\\\\n&= 2 - (-5) \\\\\n&= 7 \\\\\nf(0) &= f(6) + \\int_{6}^{0}f^{′}(x)dx \\\\\n&= f(6) - \\int_{0}^{6}f^{′}(x)dx \\\\\n&= 2 - (3 - 5) \\\\\n&= 4 \\\\\nf(-6) &= f(6) + \\int_{6}^{-6}f^{′}(x)dx \\\\\n&= f(6) - \\int_{-6}^{6}f^{′}(x)dx \\\\\n&= 2 - (-9 + 3 - 5) \\\\\n&= 13\n\\end{aligned}\n$$\n\n**Step 3**: Select the smallest value of $f$ from our candidates.\n\nComparing the values of $f$ found in step $2$, we have\n\n$$\nf_{\\text{min}} = \\min\\{2, 7, 4, 13\\} = 2\n$$\n\nTherefore, the minimum value of $f$ is\n\n$$\nf_\\text{min} = 2\n$$\n\nand the value of $x$ that minimizes $f(x)$ is\n\n$$\nx_\\text{min} = 6\n$$" #edb/ref 17592186045417] [17592186188026 #edb/ref 1069 "e-10248" #edb/ref 17592186045417] [17592186188026 #edb/ref 1071 "![](images/69/69d2d66022521424f9c6cda6ad901eb9ed1dbdb01044f5fa2d2954049770a3d4.png)\n\nThe function $f(x)$ is defined and differentiable on $[-4,4]$. The graph of $f'(x)$, the derivative of $f(x)$, is shown above, where the areas of the regions between the graph and the $x$-axis are $9$, $7$ and $8$, respectively (from left to right). Find the maximum value of $f(x)$ on the interval $[-4,4]$ given that $f(1) = 10$." #edb/ref 17592186045417] [17592186188026 #edb/ref 1072 #uuid "71cc1f65-437f-5928-82c2-be3dc4b0985f" #edb/ref 17592186045417] [17592186188026 #edb/ref 1074 "According to the candidates test, the maximum value of $f(x)$ on $[-4,4]$ must occur at a critical point or an endpoint of the interval.\n\n**Step 1**: Find the critical points.\n\nWe see that $f'(x)$ is defined everywhere on $x \\in (-4,4)$, and $f'(x) = 0$ at $x=-2$ and $x=1$. Therefore, the candidates are\n\n$$\nx=-4,-2,1,4\n$$\n\n**Step 2**: Compute the value of $f$ for each candidate using the fundamental theorem of calculus.\n\nUsing the given information and the fundamental theorem of calculus, we have the following:\n\n$$\n\\begin{aligned}\nf(1) &= 10 \\\\\nf(-2) &= f(1) + \\int_{1}^{-2}f^{′}(t)dt \\\\\n&= f(1) - \\int_{-2}^{1}f^{′}(t)dt \\\\\n&= 10 - (-7) \\\\\n&= 10 + 7 \\\\\n&= 17 \\\\\nf(-4) &= f(1) + \\int_{1}^{-4}f^{′}(t)dt \\\\\n&= f(1) - \\int_{-4}^{1}f^{′}(t)dt \\\\\n&= 10 - (-9 - 7) \\\\\n&= 10 - (-16) \\\\\n&= 10 + 16 \\\\\n&= 26 \\\\\nf(4) &= f(1) + \\int_{1}^{4}f^{′}(t)dt \\\\\n&= 10 + 8 \\\\\n&= 18\n\\end{aligned}\n$$\n\n**Step 3**: Select the largest value of $f$ from our candidates.\n\nComparing the values of $f$ found in step $2$, we have\n\n$$\nf_{\\text{max}} = \\max\\{10,17,26,18\\} = 26\n$$\n\nTherefore, the maximum value of $f$ is\n\n$$\nf_\\text{max} = 26\n$$\n\nand the value of $x$ that maximizes $f(x)$ is\n\n$$\nx_\\text{max} = -4\n$$" #edb/ref 17592186045417] [17592186188027 #edb/ref 1069 "e-10249" #edb/ref 17592186045417] [17592186188027 #edb/ref 1071 "The function $f(x)$ is defined and differentiable on $[-5,5]$. The graph of $f'(x)$, the derivative of $f(x)$, is shown below, where the areas of the regions between the graph and the $x$-axis are $2$, $14$ and $2$, respectively (from left to right). Find the minimum value of $f(x)$ on the interval $[-5,5]$ given that $f(3) = -2$.\n\n![](images/de/deb5d80fe70d31fe768a180f3afd8a6054eda8e9fc3d1d0cd52c696c9de47660.png)" #edb/ref 17592186045417] [17592186188027 #edb/ref 1072 #uuid "708db737-4215-5df0-8940-c9d17dbd2b5b" #edb/ref 17592186045417] [17592186188027 #edb/ref 1074 "According to the candidates test, the minimum value of $f(x)$ on $[-5,5]$ must occur at a critical point or an endpoint of the interval.\n\n**Step 1**: Find the critical points.\n\nWe see that $f'(x)$ is defined everywhere on $x \\in (-5,5)$, and $f'(x) = 0$ at $x=-3$ and $x=3$. Therefore, the candidates are\n\n$$\nx=-5,-3,3,5\n$$\n\n**Step 2**: Compute the value of $f$ for each candidate using the fundamental theorem of calculus.\n\nUsing the given information and the fundamental theorem of calculus, we have the following:\n\n$$\n\\begin{aligned}\nf(3) &= -2 \\\\\nf(5) &= f(3) + \\int_{3}^{5}f^{′}(x)dx \\\\\n&=-2 + (-2) \\\\\n&=-4 \\\\\nf(-3) &= f(3) + \\int_{3}^{-3}f^{′}(x)dx \\\\\n&= f(3) - \\int_{-3}^{3}f^{′}(x)dx \\\\\n&=-2 - 14 \\\\\n&=-16 \\\\\nf(-5) &= f(3) + \\int_{3}^{-5}f^{′}(x)dx \\\\\n&= f(3) - \\int_{-5}^{3}f^{′}(x)dx \\\\\n&=-2 - (-2 + 14) \\\\\n&=-14\n\\end{aligned}\n$$\n\n**Step 3**: Select the smallest value of $f$ from our candidates.\n\nComparing the values of $f$ found in step $2$, we have\n\n$$\nf_{\\text{min}} = \\min\\{-2, -4, -16, -14\\} = -16\n$$\n\nTherefore, the minimum value of $f$ is\n\n$$\nf_\\text{min} = -16\n$$\n\nand the value of $x$ that minimizes $f(x)$ is\n\n$$\nx_\\text{min} = -3\n$$" #edb/ref 17592186045417] [17592186188317 #edb/ref 1037 #edb/ref 17592186048525 #edb/ref 17592186045417] [17592186188317 #edb/ref 1037 #edb/ref 17592186048716 #edb/ref 17592186045417] [17592186188317 #edb/ref 1038 #edb/ref 17592186188524 #edb/ref 17592186045417] [17592186188317 #edb/ref 1038 #edb/ref 17592186188552 #edb/ref 17592186045417] [17592186188317 #edb/ref 1039 "Finding a Maximum Value Given a Derivative Graph and a Value at the Right Endpoint" #edb/ref 17592186045417] [17592186188317 #edb/ref 1041 #edb/ref 17592186188024 #edb/ref 17592186045417] [17592186188317 #edb/ref 1042 #uuid "81dea8fe-5a5b-5a29-9aaa-2c0d4f1764e9" #edb/ref 17592186045417] [17592186188318 #edb/ref 1038 #edb/ref 17592186188525 #edb/ref 17592186045417] [17592186188318 #edb/ref 1038 #edb/ref 17592186188528 #edb/ref 17592186045417] [17592186188318 #edb/ref 1039 "Finding a Minimum Value Given a Derivative Graph and a Value at the Right Endpoint" #edb/ref 17592186045417] [17592186188318 #edb/ref 1041 #edb/ref 17592186188025 #edb/ref 17592186045417] [17592186188318 #edb/ref 1042 #uuid "373ecc37-7913-5b59-adea-7ad3d5d78f28" #edb/ref 17592186045417] [17592186188319 #edb/ref 1038 #edb/ref 17592186188584 #edb/ref 175921860