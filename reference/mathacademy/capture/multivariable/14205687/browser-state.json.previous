      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14205687/observations/step-q344108-e064d9bd4850e841a8a9.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14205687/observations/step-q344108-e064d9bd4850e841a8a9.png",
      "source_url": "https://mathacademy.com/tasks/14205687/topics/3896/lesson",
