      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14205687/observations/step-q344182-e09a07648acc8847be8e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14205687/observations/step-q344182-e09a07648acc8847be8e.png",
      "source_url": "https://mathacademy.com/tasks/14205687/topics/3896/lesson",
      "captured_at": 1791991306.3718379,
      "math_academy_id": "q-344182",
      "topic_id": "3896",
      "sequence_position": null,
      "source_step": {
