      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14205687/observations/step-q144839-2dac8395b24a9e58b855.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14205687/observations/step-q144839-2dac8395b24a9e58b855.png",
      "source_url": "https://mathacademy.com/tasks/14205687/topics/3896/lesson",
      "captured_at": 1791991253.9113634,
      "math_academy_id": "q-144839",
