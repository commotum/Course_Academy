      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14205687/observations/step-q344104-77839454885c76f86501.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14205687/observations/step-q344104-77839454885c76f86501.png",
      "source_url": "https://mathacademy.com/tasks/14205687/topics/3896/lesson",
      "captured_at": 1791991108.1959076,
      "math_academy_id": "q-344104",
      "topic_id": "3896",
