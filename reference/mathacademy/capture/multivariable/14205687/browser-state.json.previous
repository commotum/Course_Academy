      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14205687/observations/step-q104045-c98e1d868167df8c6f50.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14205687/observations/step-q104045-c98e1d868167df8c6f50.png",
