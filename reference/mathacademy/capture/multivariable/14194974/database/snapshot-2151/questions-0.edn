/ident :answer.type/math} :answer/value "u(x){e}^{x}" :db/id #edb/ref 17592186503019} {:answer/id #uuid "363e73c3-14d2-5aca-b3ba-4ef206b7ef08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-6x}" :db/id #edb/ref 17592186503078} {:answer/id #uuid "732d4a6f-1012-548f-b6da-4987a64f221e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{3x}" :db/id #edb/ref 17592186503213} {:answer/id #uuid "f80b0984-cac5-5225-97ae-b6ef195606a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-3x}" :db/id #edb/ref 17592186503491} {:answer/id #uuid "fc81d441-b5a7-5ee4-9c97-4238d1d269e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-x}" :db/id #edb/ref 17592186503505}] :answer-field/correct {:answer/id #uuid "f80b0984-cac5-5225-97ae-b6ef195606a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-3x}" :db/id #edb/ref 17592186503491} :answer-field/id #uuid "920d47b2-3068-590e-abf0-2fae86113747" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186503587} {:answer-field/choices [{:answer/id #uuid "15ddfe20-b79c-5165-8331-392575132b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{-3x}" :db/id #edb/ref 17592186503026} {:answer/id #uuid "5fe7d00c-76aa-574c-969b-e41afc21f245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3x}" :db/id #edb/ref 17592186503168} {:answer/id #uuid "9694c5a6-3a43-5500-8040-5188f8885538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{3x}" :db/id #edb/ref 17592186503279} {:answer/id #uuid "df205db7-4aa9-531f-bc0d-d78eb84cc322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3x}" :db/id #edb/ref 17592186503433}] :answer-field/correct {:answer/id #uuid "15ddfe20-b79c-5165-8331-392575132b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{-3x}" :db/id #edb/ref 17592186503026} :answer-field/id #uuid "ac2790fa-4124-595d-b202-1fbf531eba53" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186503603}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6116c6c-0d2d-5d26-9e6b-b6dd0de87989" :question/math-academy-id "q-337452" :question/problem "Consider the first-order linear ODE\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+3y={e}^{-3x}.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\,$ According to VOP, we assume a particular solution of the form {{field-1}}.\n\n$\\,$ Solving for $u,$ we have $u(x)=$ {{field-2}}.\n\n$\\,$ Therefore, the particular solution is ${y}_{p}(x)=$ {{field-3}}." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}+3{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{-3x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable ${y}_{p},$ we set $A=u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\n{y}_{p}(x)=u(x){e}^{-3x}\n$$\n\nIntuitively, this form of ${y}_{p}$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate ${u}^{′}:$\n\n$$\n\\begin{aligned}{(u{e}^{-3x})}^{′}+3(u{e}^{-3x}) & ={e}^{-3x} \\\\ {u}^{′}{e}^{-3x}-3u{e}^{-3x}+3u{e}^{-3x} & ={e}^{-3x} \\\\ {u}^{′}{e}^{-3x}-\\cancel{3u{e}^{-3x}}+\\cancel{3u{e}^{-3x}} & ={e}^{-3x} \\\\ {u}^{′}{e}^{-3x} & ={e}^{-3x} \\\\ {u}^{′} & =1\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & =1 \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int \\,\\text{d}x \\\\ u & =x.\\end{aligned}\n$$\n\nFinally, since ${y}_{p}=u(x){e}^{-3x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{-3x} \\\\  & =x{e}^{-3x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186508936 :knowledge-point/_questions [{:db/id #edb/ref 17592186157457 :knowledge-point/id #uuid "a5fb547a-2518-5db9-b1b1-aab8d80328af" :knowledge-point/title "Solving First-Order Linear ODEs Using VOP When the Forcing Term is Part of the Complementary Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "441fd9ba-02ad-5b58-b31f-7123f793b71d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3x}+\\frac{1}{2}x{e}^{-3x}" :db/id #edb/ref 17592186508489} {:answer/id #uuid "969dac44-be6b-55c3-9e32-bc9b239ac320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x{e}^{-3x}+\\frac{1}{2}{e}^{3x}" :db/id #edb/ref 17592186508615} {:answer/id #uuid "9cf4b20a-605e-5c2b-bb92-3273af82d50d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x{e}^{3x}-\\frac{1}{2}{e}^{-3x}" :db/id #edb/ref 17592186508627} {:answer/id #uuid "fcd05d60-383c-5086-b2f2-a8d58e22437d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x{e}^{3x}+\\frac{1}{2}{e}^{-3x}" :db/id #edb/ref 17592186508804}] :answer-field/correct {:answer/id #uuid "fcd05d60-383c-5086-b2f2-a8d58e22437d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x{e}^{3x}+\\frac{1}{2}{e}^{-3x}" :db/id #edb/ref 17592186508804} :answer-field/id #uuid "1a7bb3c4-5f99-5055-85cf-792009ea367b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186508820} {:answer-field/choices [{:answer/id #uuid "8ad355eb-c779-513f-be3e-7ffebc0b039b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+\\frac{1}{2}{e}^{-6x}" :db/id #edb/ref 17592186508597} {:answer/id #uuid "9a08cb88-e308-5923-8a7a-40f0260d87f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+\\frac{1}{6}{e}^{-6x}" :db/id #edb/ref 17592186508621} {:answer/id #uuid "a2025edc-5ef5-5831-9d2e-09965e794712" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-\\frac{1}{2}{e}^{-6x}" :db/id #edb/ref 17592186508634} {:answer/id #uuid "bf951e29-b66d-506c-9922-457610fdd7f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{1}{2}x{e}^{-6x}" :db/id #edb/ref 17592186508682}] :answer-field/correct {:answer/id #uuid "8ad355eb-c779-513f-be3e-7ffebc0b039b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+\\frac{1}{2}{e}^{-6x}" :db/id #edb/ref 17592186508597} :answer-field/id #uuid "8f2b4430-672a-5bf3-807e-80a3453382c0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186508857} {:answer-field/choices [{:answer/id #uuid "051c9750-97c1-5281-b90e-9994fbef376b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{3x}" :db/id #edb/ref 17592186508395} {:answer/id #uuid "7f15f83b-8c0f-5827-b511-b0cca04cf4c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{6x}" :db/id #edb/ref 17592186508575} {:answer/id #uuid "a8312813-e54b-52a6-b6b9-51feaefb1de9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-3x}" :db/id #edb/ref 17592186508644} {:answer/id #uuid "c8881434-0fe7-5f65-a6ba-6bbdbf42ac37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{9x}" :db/id #edb/ref 17592186508703} {:answer/id #uuid "f55f4069-0947-5902-9b9e-4194006e3fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-6x}" :db/id #edb/ref 17592186508792}] :answer-field/correct {:answer/id #uuid "051c9750-97c1-5281-b90e-9994fbef376b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{3x}" :db/id #edb/ref 17592186508395} :answer-field/id #uuid "a17ac1c5-d149-5ebf-8927-158723ddb605" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186508866}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fdf7d2e-21a5-5a00-afb9-716691a79836" :question/math-academy-id "q-337475" :question/problem "Consider the first-order linear ODE\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-3y=6\\operatorname{sinh}⁡3x.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\,$ According to VOP, we assume a particular solution of the form {{field-1}}.\n\n$\\,$ Solving for $u,$ we have $u(x)=$ {{field-2}}.\n\n$\\,$ Therefore, the particular solution is ${y}_{p}(x)=$ {{field-3}}." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-3{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{3x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable ${y}_{p},$ we set $A=u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\n{y}_{p}(x)=u(x){e}^{3x}\n$$\n\nIntuitively, this form of ${y}_{p}$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate ${u}^{′}:$\n\n$$\n\\begin{aligned}{(u{e}^{3x})}^{′}-3(u{e}^{3x}) & =6\\operatorname{sinh}⁡3x \\\\ {u}^{′}{e}^{3x}+3u{e}^{3x}-3u{e}^{3x} & =6\\operatorname{sinh}⁡3x \\\\ {u}^{′}{e}^{3x}+\\cancel{3u{e}^{3x}}-\\cancel{3u{e}^{3x}} & =6\\operatorname{sinh}⁡3x \\\\ {u}^{′}{e}^{3x} & =6\\operatorname{sinh}⁡3x \\\\ {u}^{′} & =6{e}^{-3x}\\operatorname{sinh}⁡3x\\end{aligned}\n$$\n\nUsing the fact that \n\n$$\n\\operatorname{sinh}⁡3x=\\frac{{e}^{3x}-{e}^{-3x}}{2}\n$$\n\nour equation for $u$ becomes\n\n$$\n\\begin{aligned}{u}^{′} & =6{e}^{-3x}\\operatorname{sinh}⁡3x \\\\  & =6{e}^{-3x}(\\frac{{e}^{3x}-{e}^{-3x}}{2}) \\\\  & =3{e}^{-3x}({e}^{3x}-{e}^{-3x}) \\\\  & =3-3{e}^{-6x}.\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & =3-3{e}^{-6x} \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int 3-3{e}^{-6x}\\,\\text{d}x \\\\ u & =3x+\\frac{1}{2}{e}^{-6x}.\\end{aligned}\n$$\n\nFinally, since ${y}_{p}=u(x){e}^{3x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{3x} \\\\  & =3x{e}^{3x}+\\frac{1}{2}{e}^{-3x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186508968 :knowledge-point/_questions [{:db/id #edb/ref 17592186157457 :knowledge-point/id #uuid "a5fb547a-2518-5db9-b1b1-aab8d80328af" :knowledge-point/title "Solving First-Order Linear ODEs Using VOP When the For