/ident :answer.type/math} :answer/value "u(x){e}^{x}" :db/id #edb/ref 17592186503019} {:answer/id #uuid "363e73c3-14d2-5aca-b3ba-4ef206b7ef08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-6x}" :db/id #edb/ref 17592186503078} {:answer/id #uuid "732d4a6f-1012-548f-b6da-4987a64f221e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{3x}" :db/id #edb/ref 17592186503213} {:answer/id #uuid "f80b0984-cac5-5225-97ae-b6ef195606a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-3x}" :db/id #edb/ref 17592186503491} {:answer/id #uuid "fc81d441-b5a7-5ee4-9c97-4238d1d269e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-x}" :db/id #edb/ref 17592186503505}] :answer-field/correct {:answer/id #uuid "f80b0984-cac5-5225-97ae-b6ef195606a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-3x}" :db/id #edb/ref 17592186503491} :answer-field/id #uuid "920d47b2-3068-590e-abf0-2fae86113747" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186503587} {:answer-field/choices [{:answer/id #uuid "15ddfe20-b79c-5165-8331-392575132b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{-3x}" :db/id #edb/ref 17592186503026} {:answer/id #uuid "5fe7d00c-76aa-574c-969b-e41afc21f245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3x}" :db/id #edb/ref 17592186503168} {:answer/id #uuid "9694c5a6-3a43-5500-8040-5188f8885538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{3x}" :db/id #edb/ref 17592186503279} {:answer/id #uuid "df205db7-4aa9-531f-bc0d-d78eb84cc322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3x}" :db/id #edb/ref 17592186503433}] :answer-field/correct {:answer/id #uuid "15ddfe20-b79c-5165-8331-392575132b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x{e}^{-3x}" :db/id #edb/ref 17592186503026} :answer-field/id #uuid "ac2790fa-4124-595d-b202-1fbf531eba53" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186503603}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6116c6c-0d2d-5d26-9e6b-b6dd0de87989" :question/math-academy-id "q-337452" :question/problem "Consider the first-order linear ODE\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+3y={e}^{-3x}.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\,$ According to VOP, we assume a particular solution of the form {{field-1}}.\n\n$\\,$ Solving for $u,$ we have $u(x)=$ {{field-2}}.\n\n$\\,$ Therefore, the particular solution is ${y}_{p}(x)=$ {{field-3}}." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}+3{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{-3x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable ${y}_{p},$ we set $A=u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\n{y}_{p}(x)=u(x){e}^{-3x}\n$$\n\nIntuitively, this form of ${y}_{p}$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate ${u}^{′}:$\n\n$$\n\\begin{aligned}{(u{e}^{-3x})}^{′}+3(u{e}^{-3x}) & ={e}^{-3x} \\\\ {u}^{′}{e}^{-3x}-3u{e}^{-3x}+3u{e}^{-3x} & ={e}^{-3x} \\\\ {u}^{′}{e}^{-3x}-\\cancel{3u{e}^{-3x}}+\\cancel{3u{e}^{-3x}} & ={e}^{-3x} \\\\ {u}^{′}{e}^{-3x} & ={e}^{-3x} \\\\ {u}^{′} & =1\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & =1 \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int \\,\\text{d}x \\\\ u & =x.\\end{aligned}\n$$\n\nFinally, since ${y}_{p}=u(x){e}^{-3x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{-3x} \\\\  & =x{e}^{-3x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186397752 :knowledge-point/_questions [{:db/id #edb/ref 17592186157456 :knowledge-point/id #uuid "7ac34a18-053d-5eab-8c2c-bd0f15658186" :knowledge-point/title "Solving First-Order Linear ODEs Using Variation of Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36dc406b-5149-5aeb-99f4-c422c56adc09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3x}\\int {e}^{-3x}(1-4x)\\,\\text{d}x" :db/id #edb/ref 17592186397754} {:answer/id #uuid "11154d93-5ccc-5c68-a857-aee315edeb48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3x}\\int {e}^{3x}(1-4x)\\,\\text{d}x" :db/id #edb/ref 17592186397755} {:answer/id #uuid "23e73190-9abd-5014-8776-a3e439817b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3x}\\int {e}^{-3x}(1-4x)\\,\\text{d}x" :db/id #edb/ref 17592186397756} {:answer/id #uuid "2db97ceb-c880-55bd-9dad-60e6eed828e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3x}\\int {e}^{3x}(1-4x)\\,\\text{d}x" :db/id #edb/ref 17592186397757}] :answer-field/correct {:answer/id #uuid "2db97ceb-c880-55bd-9dad-60e6eed828e7" :answer/type 