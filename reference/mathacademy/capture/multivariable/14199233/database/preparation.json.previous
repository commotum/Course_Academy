              "captured_at": 1791971840.0825722,
              "source_sha256": "b19f1438aef49b920c9fdce5553b478084d7c65febee808232617d1ed236089d",
              "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/browser-originals/b19f1438aef49b920c9fdce5553b478084d7c65febee808232617d1ed236089d.html",
              "status": 200,
              "headers": {
                "date": "Wed, 14 Oct 2026 09:57:20 GMT",
                "etag": "W/\"38eb7-MN3bYvIqsP0Dq2MunUz5Q4qnwCs\""
              },
              "transformation": null,
