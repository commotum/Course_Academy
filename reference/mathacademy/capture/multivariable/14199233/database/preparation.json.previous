"#E4-MJMAIN-32\" x=\"5966\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMATHI-78\" x=\"6466\" y=\"0\"></use>\n<g transform=\"translate(7206,0)\">\n <use xlink:href=\"#E4-MJMAIN-73\"></use>\n <use xlink:href=\"#E4-MJMAIN-65\" x=\"394\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-63\" x=\"839\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-68\" x=\"1283\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E4-MJMAIN-32\" x=\"2602\" y=\"598\"></use>\n</g>\n <use xlink:href=\"#E4-MJMATHI-78\" x=\"9666\" y=\"0\"></use>\n</g>\n<g transform=\"translate(0,-2597)\">\n <use xlink:href=\"#E4-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-32\" x=\"1334\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-28\" x=\"1834\" y=\"0\"></use>\n<g transform=\"translate(2224,0)\">\n <use xlink:href=\"#E4-MJMAIN-74\"></use>\n <use xlink:href=\"#E4-MJMAIN-61\" x=\"389\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-6E\" x=\"890\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-68\" x=\"1446\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E4-MJMATHI-78\" x=\"4393\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2B\" x=\"5188\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMATHI-78\" x=\"6189\" y=\"0\"></use>\n<g transform=\"translate(6928,0)\">\n <use xlink:href=\"#E4-MJMAIN-73\"></use>\n <use xlink:href=\"#E4-MJMAIN-65\" x=\"394\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-63\" x=\"839\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-68\" x=\"1283\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E4-MJMAIN-32\" x=\"2602\" y=\"598\"></use>\n</g>\n <use xlink:href=\"#E4-MJMATHI-78\" x=\"9388\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-29\" x=\"9961\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n\n            </div>           \n        </div>",
