=\"#E6-MJMAIN-63\"></use>\n <use xlink:href=\"#E6-MJMAIN-6F\" x=\"444\" y=\"0\"></use>\n <use xlink:href=\"#E6-MJMAIN-73\" x=\"945\" y=\"0\"></use>\n <use xlink:href=\"#E6-MJMAIN-68\" x=\"1339\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E6-MJMAIN-32\" x=\"2681\" y=\"598\"></use>\n <use xlink:href=\"#E6-MJMATHI-78\" x=\"2516\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n\n            </div>           \n        </div>",
