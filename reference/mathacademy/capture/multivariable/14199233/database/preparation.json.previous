            {
              "key": "selection",
              "correct_value": "-\\frac{3{x}^{2}\\operatorname{cosh}⁡{x}^{3}}{{sinh}^{2}⁡{x}^{3}}",
              "correct_option": "a",
              "value_type": "math",
              "wrong_value": "-\\frac{3{x}^{2}}{\\operatorname{sinh}⁡{x}^{3}}",
