n>2</mn></msup><mo>+</mo><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow><mo>⋅</mo><mo stretchy=\"false\">(</mo><mi>cosh</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><msup><mi>x</mi><mn>2</mn></msup><msup><mo stretchy=\"false\">)</mo><mo data-mjx-alternate=\"1\">′</mo></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mi>x</mi></mfrac></mstyle><mo>⋅</mo><mi>cosh</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow><mo>⋅</mo><mn>2</mn><mi>x</mi><mi>sinh</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><msup><mi>x</mi><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>cosh</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><msup><mi>x</mi><mn>2</mn></msup></mrow><mi>x</mi></mfrac></mstyle><mo>+</mo><mn>2</mn><mi>x</mi><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow><mi>sinh</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><msup><mi>x</mi><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mi>x</mi></mfrac></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mi>cosh</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow><mi>sinh</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><msup><mi>x</mi><mn>2</mn></msup><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
