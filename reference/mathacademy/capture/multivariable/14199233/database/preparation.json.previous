62Q359 79 369 104L379 128Q382 131 395 131H398Q415 131 415 121Q415 117 412 108Q393 53 349 21T250 -11Q155 -11 92 58T28 218ZM333 275Q322 403 238 411H236Q228 411 220 410T195 402T166 381T143 340T127 274V267H333V275Z\" id=\"E2-MJMAIN-65\" stroke-width=\"1\"></path>\n<path d=\"M370 305T349 305T313 320T297 358Q297 381 312 396Q317 401 317 402T307 404Q281 408 258 408Q209 408 178 376Q131 329 131 219Q131 137 162 90Q203 29 272 29Q313 29 338 55T374 117Q376 125 379 127T395 129H409Q415 123 415 120Q415 116 411 104T395 71T366 33T318 2T249 -11Q163 -11 99 53T34 214Q34 318 99 383T250 448T370 421T404 357Q404 334 387 320Z\" id=\"E2-MJMAIN-63\" stroke-width=\"1\"></path>\n<path d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\" id=\"E2-MJMAIN-32\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<g transform=\"translate(120,0)\">\n<rect height=\"60\" stroke=\"none\" width=\"1249\" x=\"0\" y=\"220\"></rect>\n<use x=\"346\" xlink:href=\"#E2-MJMAIN-64\" y=\"676\"></use>\n<g transform=\"translate(60,-716)\">\n<use x=\"0\" xlink:href=\"#E2-MJMAIN-64\" y=\"0\"></use>\n<use x=\"556\" xlink:href=\"#E2-MJMATHI-78\" y=\"0\"></use>\n</g>\n</g>\n<use x=\"1489\" xlink:href=\"#E2-MJMAIN-28\" y=\"0\"></use>\n<g transform=\"translate(1878,0)\">\n<use xlink:href=\"#E2-MJMAIN-74\"></use>\n<use x=\"389\" xlink:href=\"#E2-MJMAIN-61\" y=\"0\"></use>\n<use x=\"890\" xlink:href=\"#E2-MJMAIN-6E\" y=\"0\"></use>\n<use x=\"1446\" xlink:href=\"#E2-MJMAIN-68\" y=\"0\"></use>\n</g>\n<use x=\"4048\" xlink:href=\"#E2-MJMATHI-78\" y=\"0\"></use>\n<use x=\"4620\" xlink:href=\"#E2-MJMAIN-29\" y=\"0\"></use>\n<use x=\"5287\" xlink:href=\"#E2-MJMAIN-3D\" y=\"0\"></use>\n<g transform=\"translate(6344,0)\">\n<use xlink:href=\"#E2-MJMAIN-73\"></use>\n<use x=\"394\" xlink:href=\"#E2-MJMAIN-65\" y=\"0\"></use>\n<use x=\"839\" xlink:href=\"#E2-MJMAIN-63\" y=\"0\"></use>\n<use x=\"1283\" xlink:href=\"#E2-MJMAIN-68\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"2602\" xlink:href=\"#E2-MJMAIN-32\" y=\"598\"></use>\n</g>\n<use x=\"8804\" xlink:href=\"#E2-MJMATHI-78\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>We do this using the definition of the hyperbolic tangent. The most convenient definition to work with for this purpose is</p>\n<p><span class=\"mjpage mjpage__block\"><svg aria-labelledby=\"MathJax-SVG-3-Title\" focusable=\"false\" height=\"6.176ex\" role=\"img\" style=\"vertical-align: -2.338ex;\" viewbox=\"0 -1652.5 7763.4 2659.1\" width=\"18.031ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-3-Title\">\n\\tanh{x} = \\dfrac{e^{2x}-1}{e^{2x}+1}.\n</title>\n<defs aria-hidden=\"true\">\n<path d=\"M27 422Q80 426 109 478T141 600V615H181V431H316V385H181V241Q182 116 182 100T189 68Q203 29 238 29Q282 29 292 100Q293 108 293 146V181H333V146V134Q333 57 291 17Q264 -10 221 -10Q187 -10 162 2T124 33T105 68T98 100Q97 107 97 248V385H18V422H27Z\" id=\"E3-MJMAIN-74\" stroke-width=\"1\"></path>\n<path d=\"M137 305T115 305T78 320T63 359Q63 394 97 421T218 448Q291 448 336 416T396 340Q401 326 401 309T402 194V124Q402 76 407 58T428 40Q443 40 448 56T453 109V145H493V106Q492 66 490 59Q481 29 455 12T400 -6T353 12T329 54V58L327 55Q325 52 322 49T314 40T302 29T287 17T269 6T247 -2T221 -8T190 -11Q130 -11 82 20T34 107Q34 128 41 147T68 188T116 225T194 253T304 268H318V290Q318 324 312 340Q290 411 215 411Q197 411 181 410T156 406T148 403Q170 388 170 359Q170 334 154 320ZM126 106Q126 75 150 51T209 26Q247 26 276 49T315 109Q317 116 318 175Q318 233 317 233Q309 233 296 232T251 223T193 203T147 166T126 106Z\" id=\"E3-MJMAIN-61\" stroke-width=\"1\"></path>\n<path d=\"M41 46H55Q94 46 102 60V68Q102 77 102 91T102 122T103 161T103 203Q103 234 103 269T102 328V351Q99 370 88 376T43 385H25V408Q25 431 27 431L37 432Q47 433 65 434T102 436Q119 437 138 438T167 441T178 442H181V402Q181 364 182 364T187 369T199 384T218 402T247 421T285 437Q305 442 336 442Q450 438 463 329Q464 322 464 190V104Q464 66 466 59T477 49Q498 46 526 46H542V0H534L510 1Q487 2 460 2T422 3Q319 3 310 0H302V46H318Q379 46 379 62Q380 64 380 200Q379 335 378 343Q372 371 358 385T334 402T308 404Q263 404 229 370Q202 343 195 315T187 232V168V108Q187 78 188 68T191 55T200 49Q221 46 249 46H265V0H257L234 1Q210 2 183 2T145 3Q42 3 33 0H25V46H41Z\" id=\"E3-MJMAIN-6E\" stroke-width=\"1\"></path>\n<path d=\"M41 46H55Q94 46 102 60V68Q102 77 102 91T102 124T102 167T103 217T103 272T103 329Q103 366 103 407T103 482T102 542T102 586T102 603Q99 622 88 628T43 637H25V660Q25 683 27 683L37 684Q47 685 66 686T103 688Q120 689 140 690T170 693T181 694H184V367Q244 442 328 442Q451 442 463 329Q464 322 464 190V104Q464 66 466 59T477 49Q498 46 526 46H542V0H534L510 1Q487 2 460 2T422 3Q319 3 310 0H302V46H318Q379 46 379 62Q380 64 380 200Q379 335 378 343Q372 371 358 385T334 402T308 404Q263 404 229 370Q202 343 195 315T187 232V168V108Q187 78 188 68T191 55T200 49Q221 46 249 46H265V0H257L234 1Q210 2 183 2T145 3Q42 3 33 0H25V46H41Z\" id=\"E3-MJMAIN-68\" stroke-width=\"1\"></path>\n<path d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40Q91 39 97 36T113 29T132 26Q168 26 194 71Q203 87 217 139T245 247T261 313Q266 340 266 352Q266 380 251 392T217 404Q177 404 142 372T93 290Q91 281 88 280T72 278H58Q52 284 52 289Z\" id=\"E3-MJMATHI-78\" stroke-width=\"1\"></path>\n<path d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\" id=\"E3-MJMAIN-3D\" stroke-width=\"1\"></path>\n<path d=\"M39 168Q39 225 58 272T107 350T174 402T244 433T307 442H310Q355 442 388 420T421 355Q421 265 310 237Q261 224 176 223Q139 223 138 221Q138 219 132 186T125 128Q125 81 146 54T209 26T302 45T394 111Q403 121 406 121Q410 121 419 112T429 98T420 82T390 55T344 24T281 -1T205 -11Q126 -11 83 42T39 168ZM373 353Q367 405 305 405Q272 405 244 391T199 357T170 316T154 280T149 261Q149 260 169 260Q282 260 327 284T373 353Z\" id=\"E3-MJMATHI-65\" stroke-width=\"1\"></path>\n<path d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\" id=\"E3-MJMAIN-32\" stroke-width=\"1\"></path>\n<path d=\"M84 237T84 250T98 270H679Q694 262 694 250T679 230H98Q84 237 84 250Z\" id=\"E3-MJMAIN-2212\" stroke-width=\"1\"></path>\n<path d=\"M213 578L200 573Q186 568 160 563T102 556H83V602H102Q149 604 189 617T245 641T273 663Q275 666 285 666Q294 666 302 660V361L303 61Q310 54 315 52T339 48T401 46H427V0H416Q395 3 257 3Q121 3 100 0H88V46H114Q136 46 152 46T177 47T193 50T201 52T207 57T213 61V578Z\" id=\"E3-MJMAIN-31\" stroke-width=\"1\"></path>\n<path d=\"M56 237T56 250T70 270H369V420L370 570Q380 583 389 583Q402 583 409 568V270H707Q722 262 722 250T707 230H409V-68Q401 -82 391 -82H389H387Q375 -82 369 -68V230H70Q56 237 56 250Z\" id=\"E3-M