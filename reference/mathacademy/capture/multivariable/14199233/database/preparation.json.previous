:href=\"#E5-MJSZ3-28\"></use>\n<g transform=\"translate(736,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"620\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E5-MJMAIN-31\" x=\"60\" y=\"676\"></use>\n <use xlink:href=\"#E5-MJMAIN-32\" x=\"60\" y=\"-687\"></use>\n</g>\n</g>\n<g transform=\"translate(1597,0)\">\n <use xlink:href=\"#E5-MJSZ1-28\"></use>\n<g transform=\"translate(458,0)\">\n <use xlink:href=\"#E5-MJMATHI-65\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMATHI-78\" x=\"659\" y=\"583\"></use>\n</g>\n <use xlink:href=\"#E5-MJMAIN-2212\" x=\"1652\" y=\"0\"></use>\n<g transform=\"translate(2652,0)\">\n <use xlink:href=\"#E5-MJMATHI-65\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(466,412)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMAIN-2212\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMATHI-78\" x=\"778\" y=\"0\"></use>\n</g>\n</g>\n <use xlink:href=\"#E5-MJSZ1-29\" x=\"4174\" y=\"-1\"></use>\n</g>\n <use xlink:href=\"#E5-MJSZ3-29\" x=\"6230\" y=\"-1\"></use>\n</g>\n</g>\n<g transform=\"translate(0,642)\">\n <use xlink:href=\"#E5-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"620\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E5-MJMAIN-31\" x=\"60\" y=\"676\"></use>\n <use xlink:href=\"#E5-MJMAIN-32\" x=\"60\" y=\"-687\"></use>\n</g>\n</g>\n <use xlink:href=\"#E5-MJMAIN-22C5\" x=\"2416\" y=\"0\"></use>\n<g transform=\"translate(2917,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1249\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E5-MJMAIN-64\" x=\"346\" y=\"676\"></use>\n<g transform=\"translate(60,-716)\">\n <use xlink:href=\"#E5-MJMAIN-64\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMATHI-78\" x=\"556\" y=\"0\"></use>\n</g>\n</g>\n</g>\n<g transform=\"translate(4406,0)\">\n <use xlink:href=\"#E5-MJSZ1-28\"></use>\n<g transform=\"translate(458,0)\">\n <use xlink:href=\"#E5-MJMATHI-65\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMATHI-78\" x=\"659\" y=\"583\"></use>\n</g>\n <use xlink:href=\"#E5-MJMAIN-2212\" x=\"1652\" y=\"0\"></use>\n<g transform=\"translate(2652,0)\">\n <use xlink:href=\"#E5-MJMATHI-65\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(466,412)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMAIN-2212\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMATHI-78\" x=\"778\" y=\"0\"></use>\n</g>\n</g>\n <use xlink:href=\"#E5-MJSZ1-29\" x=\"4174\" y=\"-1\"></use>\n</g>\n</g>\n<g transform=\"translate(0,-2229)\">\n <use xlink:href=\"#E5-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"620\" height=\"60\" x=\"0\" y=\"220\"></rect>\n <use xlink:href=\"#E5-MJMAIN-31\" x=\"60\" y=\"676\"></use>\n <use xlink:href=\"#E5-MJMAIN-32\" x=\"60\" y=\"-687\"></use>\n</g>\n</g>\n<g transform=\"translate(2194,0)\">\n <use xlink:href=\"#E5-MJSZ1-28\"></use>\n<g transform=\"translate(458,0)\">\n <use xlink:href=\"#E5-MJMATHI-65\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMATHI-78\" x=\"659\" y=\"583\"></use>\n</g>\n <use xlink:href=\"#E5-MJMAIN-2B\" x=\"1652\" y=\"0\"></use>\n<g transform=\"translate(2652,0)\">\n <use xlink:href=\"#E5-MJMATHI-65\" x=\"0\" y=\"0\"></use>\n<g transform=\"translate(466,412)\">\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMAIN-2212\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E5-MJMATHI-78\" x=\"778\" y=\"0\"></use>\n</g>\n</g>\n <use xlink:href=\"#E5-MJSZ1-29\" x=\"4174\" y=\"-1\"></use>\n</g>\n</g>\n<g transform=\"translate(0,-4516)\">\n <use xlink:href=\"#E5-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n <use xlink:href=\"#E5-MJMAIN-63\"></use>\n <use xlink:href=\"#E5-MJMAIN-6F\" x=\"444\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-73\" x=\"945\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-68\" x=\"1339\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E5-MJMATHI-78\" x=\"3396\" y=\"0\"></use>\n <use xlink:href=\"#E5-MJMAIN-2E\" x=\"3969\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>The proof for the derivative of the hyperbolic cosine is very similar. You may wish to try it for yourself.</p>\n\n        </div>",
