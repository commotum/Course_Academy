6045417] [17592186105406 #edb/ref 1075 #edb/ref 17592186513796 #edb/ref 17592186045417] [17592186105406 #edb/ref 1075 #edb/ref 17592186513918 #edb/ref 17592186045417] [17592186105406 #edb/ref 1075 #edb/ref 17592186514060 #edb/ref 17592186045417] [17592186105406 #edb/ref 1075 #edb/ref 17592186514121 #edb/ref 17592186045417] [17592186105406 #edb/ref 1075 #edb/ref 17592186514128 #edb/ref 17592186045417] [17592186105406 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186105406 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186105406 #edb/ref 1078 #edb/ref 17592186514121 #edb/ref 17592186045417] [17592186105406 #edb/ref 1079 #uuid "6159fd9b-5adf-5789-a137-567ebbd5c693" #edb/ref 17592186045417] [17592186105684 #edb/ref 1069 "e-8328" #edb/ref 17592186045417] [17592186105684 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFind the derivative of $y = 3\\tanh{x}- \\sinh{x}.$" #edb/ref 17592186045417] [17592186105684 #edb/ref 1072 #uuid "ec8ac943-1880-5f2a-81c3-35c136126ec1" #edb/ref 17592186045417] [17592186105684 #edb/ref 1074 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFirst, we recall the results for the derivatives of the basic hyperbolic functions:\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x} ( \\sinh x ) = \\cosh x,\n\\quad \n\\dfrac{\\textrm{d}}{\\textrm{d}x} ( \\cosh x ) = \\sinh x,\n\\quad \n\\dfrac{\\textrm{d}}{\\textrm{d}x} ( \\tanh x ) = \\sech^2 x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{tanh}⁡x-\\operatorname{sinh}⁡x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)-\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x) \\\\  & =3{sech}^{2}⁡x-\\operatorname{cosh}⁡x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186105685 #edb/ref 1069 "e-8329" #edb/ref 17592186045417] [17592186105685 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFind the derivative of $f(x) = 2x\\tanh{x}.$" #edb/ref 17592186045417] [17592186105685 #edb/ref 1072 #uuid "3dcfc1f2-40ee-54b4-a937-0e101c7238d4" #edb/ref 17592186045417] [17592186105685 #edb/ref 1074 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nHere, we have the product of two functions $u(x) = 2x$ and $v(x)=\\tanh x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(2x)^{′}\\cdot \\operatorname{tanh}⁡x+2x\\cdot (\\operatorname{tanh}⁡x)^{′} \\\\  & =2\\cdot \\operatorname{tanh}⁡x+2x\\cdot {sech}^{2}⁡x \\\\  & =2\\operatorname{tanh}⁡x+2x{sech}^{2}⁡x \\\\  & =2(\\operatorname{tanh}⁡x+x{sech}^{2}⁡x)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186105686 #edb/ref 1069 "e-8330" #edb/ref 17592186045417] [17592186105686 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFind the derivative of $w(x) = \\dfrac{x^3}{\\cosh{x}}.$" #edb/ref 17592186045417] [17592186105686 #edb/ref 1072 #uuid "1da70111-4e82-5fe4-b4be-08d0cc6f1110" #edb/ref 17592186045417] [17592186105686 #edb/ref 1074 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIn this case, the expression for $w(x)$ is a quotient $\\dfrac{u(x)}{v(x)}$ with $u(x) = x^3$ and $v(x) = \\cosh{x}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{w}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({x}^{3})^{′}\\cdot \\operatorname{cosh}⁡x-{x}^{3}\\cdot (\\operatorname{cosh}⁡x)^{′}}{(\\operatorname{cosh}⁡x)^{2}} \\\\  & =\\frac{3{x}^{2}\\cdot \\operatorname{cosh}⁡x-{x}^{3}\\cdot \\operatorname{sinh}⁡x}{{cosh}^{2}⁡x} \\\\  & =\\frac{{x}^{2}(3\\operatorname{cosh}⁡x-x\\operatorname{sinh}⁡x)}{{cosh}^{2}⁡x}\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186105687 #edb/ref 1069 "e-8332" #edb/ref 17592186045417] [17592186105687 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFind the derivative of $f(x) = \\cosh{\\sqrt x}.$" #edb/ref 17592186045417] [17592186105687 #edb/ref 1072 #uuid "192e6748-24e3-5688-87d9-cdf379e24101" #edb/ref 17592186045417] [17592186105687 #edb/ref 1074 "First, we express $f(x)$ as a composite function:\n\n$$\nf = \\cosh g, \\qquad g = \\sqrt x\n$$\n\nThe chain rule states that\n\n$$\n\\dfrac {\\textrm{d}f} {\\textrm{d}x} = \\dfrac {\\textrm{d}f} {\\textrm{d}g} \\cdot \\dfrac {\\textrm{d}g} {\\textrm{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\dfrac {\\textrm{d}f} {\\textrm{d}g}  = \\sinh g,\n$$\n\nand\n\n$$\n\\dfrac {\\textrm{d}g} {\\textrm{d}x} = \\dfrac{1}{2\\sqrt x}.\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\operatorname{sinh}⁡g\\cdot \\frac{1}{2\\sqrt{x}} \\\\  & =\\operatorname{sinh}⁡\\sqrt{x}\\cdot \\frac{1}{2\\sqrt{x}} \\\\  & =\\frac{\\operatorname{sinh}⁡\\sqrt{x}}{2\\sqrt{x}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186105845 #edb/ref 1037 #edb/ref 17592186048192 #edb/ref 17592186045417] [17592186105845 #edb/ref 1037 #edb/ref 17592186050125 #edb/ref 17592186045417] [17592186105845 #edb/ref 1038 #edb/ref 17592186106536 #edb/ref 17592186045417] [17592186105845 #edb/ref 1038 #edb/ref 17592186106542 #edb/ref 17592186045417] [17592186105845 #edb/ref 1038 #edb/ref 17592186514360 #edb/ref 17592186045417] [17592186105845 #edb/ref 1038 #edb/ref 17592186514372 #edb/ref 17592186045417] [17592186105845 #edb/ref 1038 #edb/ref 17592186514436 #edb/ref 17592186045417] [17592186105845 #edb/ref 1039 "Basic Derivatives of the Hyperbolic Functions" #edb/ref 17592186045417] [17592186105845 #edb/ref 1041 #edb/ref 17592186105684 #edb/ref 17592186045417] [17592186105845 #edb/ref 1042 #uuid "a91e7c54-7ba7-5ea2-99a1-80510e77ac88" #edb/ref 17592186045417] [17592186105846 #edb/ref 1037 #edb/ref 17592186048813 #edb/ref 17592186045417] [17592186105846 #edb/ref 1038 #edb/ref 17592186106538 #edb/ref 17592186045417] [17592186105846 #edb/ref 1038 #edb/ref 17592186106540 #edb/ref 17592186045417] [17592186105846 #edb/ref 1038 #edb/ref 17592186514406 #edb/ref 17592186045417] [17592186105846 #edb/ref 1038 #edb/ref 17592186514408 #edb/ref 17592186045417] [17592186105846 #edb/ref 1038 #edb/ref 17592186514447 #edb/ref 17592186045417] [17592186105846 #edb/ref 1039 "Differentiating Hyperbolic Functions Using the Product Rule" #edb/ref 17592186045417] [17592186105846 #edb/ref 1041 #edb/ref 17592186105685 #edb/ref 17592186045417] [17592186105846 #edb/ref 1042 #uuid "a2992a46-063e-589d-a7e9-129e9f97eee6" #edb/ref 17592186045417] [17592186105847 #edb/ref 1037 #edb/ref 17592186048842 #edb/ref 17592186045417] [17592186105847 #edb/ref 1038 #edb/ref 17592186106539 #edb/ref 17592186045417] [17592186105847 #edb/ref 1038 #edb/ref 17592186106541 #edb/ref 17592186045417] [17592186105847 #edb/ref 1038 #edb/ref 17592186503709 #edb/ref 17592186045417] [17592186105847 #edb/ref 1038 #edb/ref 17592186514410 #edb/ref 17592186045417] [17592186105847 #edb/ref 1038 #edb/ref 17592186514471 #edb/ref 17592186045417] [17592186105847 #edb/ref 1038 #edb/ref 17592186514478 #edb/ref 17592186045417] [17592186105847 #edb/ref 1039 "Differentiating Hyperbolic Functions Using the Quotient Rule" #edb/ref 17592186045417] [17592186105847 #edb/ref 1041 #edb/ref 17592186105686 #edb/ref 17592186045417] [17592186105847 #edb/ref 1042 #uuid "dbeb43f0-d94d-5ee0-b7fb-fbbe0a804cb7" #edb/ref 17592186045417] [17592186105848 #edb/ref 1037 #edb/ref 17592186051084 #edb/ref 17592186045417] [17592186105848 #edb/ref 1038 #edb/ref 17592186106537 #edb/ref 17592186045417] [17592186105848 #edb/ref 1038 #edb/ref 17592186106543 #edb/ref 17592186045417] [17592186105848 #edb/ref 1038 #edb/ref 17592186514396 #edb/ref 17592186045417] [17592186105848 #edb/ref 1038 #edb/ref 17592186514398 #edb/ref 17592186045417] [17592186105848 #edb/ref 1038 #edb/ref 17592186514429 #edb/ref 17592186045417] [17592186105848 #edb/ref 1038 #edb/ref 17592186514477 #edb/ref 17592186045417] [17592186105848 #edb/ref 1039 "Differentiating Hyperbolic Functions Using the Chain Rule" #edb/ref 17592186045417] [17592186105848 #edb/ref 1041 #edb/ref 17592186105687 #edb/ref 17592186045417] [17592186105848 #edb/ref 1042 #uuid "0016464f-27c3-5f1b-a6d3-fe7b5ffb7fbd" #edb/ref 17592186045417] [17592186105995 #edb/ref 1043 #edb/ref 17592186106804 #edb/ref 17592186045417] [17592186105995 #edb/ref 1043 #edb/ref 17592186106805 #edb/ref 17592186045417] [17592186105995 #edb/ref 1043 #edb/ref 17592186106806 #edb/ref 17592186045417] [17592186105995 #edb/ref 1043 #edb/ref 17592186106807 #edb/ref 17592186045417] [17592186105995 #edb/ref 1043 #edb/ref 17592186106808 #edb/ref 17592186045417] [17592186105995 #edb/ref 1043 #edb/ref 17592186106809 #edb/ref 17592186045417] [17592186105995 #edb/ref 1043 #edb/ref 17592186106810 #edb/ref 17592186045417] [17592186105995 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186105995 #edb/ref 1045 "Differentiating Hyperbolic Functions" #edb/ref 17592186045417] [17592186105995 #edb/ref 1046 #edb/ref 17592186106808 #edb/ref 17592186045417] [17592186105995 #edb/ref 1049 #edb/ref 17592186049713 #edb/ref 17592186045417] [17592186105995 #edb/ref 1050 540.0 #edb/ref 17592186045417] [17592186105995 #edb/ref 1053 #uuid "b97eef31-cdcb-509f-a8e2-7468bee3daec" #edb/ref 17592186045417] [17592186106536 #edb/ref 1068 #edb/ref 17592186105364 #edb/ref 17592186045417] [17592186106536 #edb/ref 1069 "q-95231" #edb/ref 17592186045417] [17592186106536 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186106536 #edb/ref 1071 "$$\n\nFind the derivative of $y=2\\operatorname{sinh}⁡x+3\\operatorname{cosh}⁡x.$" #edb/ref 17592186045417] [17592186106536 #edb/ref 1072 #uuid "24a50221-f040-5e4c-8f25-a9b0f659dfcf" #edb/ref 17592186045417] [17592186106536 #edb/ref 1074 "First, we recall the results for the derivatives of the basic hyperbolic functions:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x)=\\operatorname{cosh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x)=\\operatorname{sinh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)={sech}^{2}⁡x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{sinh}⁡x+3\\operatorname{cosh}⁡x) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x)+3\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x) \\\\  & =2\\operatorname{cosh}⁡x+3\\operatorname{sinh}⁡x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186106538 #edb/ref 1068 #edb/ref 17592186105376 #edb/ref 17592186045417] [17592186106538 #edb/ref 1069 "q-95234" #edb/ref 17592186045417] [17592186106538 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186106538 #edb/ref 1071 "$$\n\nFind the derivative of $f(x)={x}^{2}\\operatorname{sinh}⁡2x.$" #edb/ref 17592186045417] [17592186106538 #edb/ref 1072 #uuid "a2499a99-2aa2-5a6d-9f00-3489bba29f35" #edb/ref 17592186045417] [17592186106538 #edb/ref 1074 "Here, we have the product of two functions $u(x)={x}^{2}$ and $v(x)=\\operatorname{sinh}⁡2x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =({x}^{2})^{′}\\cdot \\operatorname{sinh}⁡2x+{x}^{2}\\cdot (\\operatorname{sinh}⁡2x)^{′} \\\\  & =2x\\cdot \\operatorname{sinh}⁡2x+{x}^{2}\\cdot 2\\operatorname{cosh}⁡2x \\\\  & =2x\\operatorname{sinh}⁡2x+2{x}^{2}\\operatorname{cosh}⁡2x \\\\  & =2x(\\operatorname{sinh}⁡2x+x\\operatorname{cosh}⁡2x)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186106539 #edb/ref 1068 #edb/ref 17592186105382 #edb/ref 17592186045417] [17592186106539 #edb/ref 1069 "q-95235" #edb/ref 17592186045417] [17592186106539 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186106539 #edb/ref 1071 "$$\n\nFind the derivative of $f(x)=\\frac{{x}^{2}}{\\operatorname{sinh}⁡x}.$" #edb/ref 17592186045417] [17592186106539 #edb/ref 1072 #uuid "539990c8-b61b-5bae-b1f8-037c34589599" #edb/ref 17592186045417] [17592186106539 #edb/ref 1074 "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={x}^{2}$ and $v(x)=\\operatorname{sinh}⁡x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({x}^{2})^{′}\\cdot \\operatorname{sinh}⁡x-{x}^{2}\\cdot (\\operatorname{sinh}⁡x)^{′}}{(\\operatorname{sinh}⁡x)^{2}} \\\\  & =\\frac{2x\\operatorname{sinh}⁡x-{x}^{2}\\operatorname{cosh}⁡x}{{sinh}^{2}⁡x} \\\\  & =\\frac{x(2\\operatorname{sinh}⁡x-x\\operatorname{cosh}⁡x)}{{sinh}^{2}⁡x}\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186106540 #edb/ref 1068 #edb/ref 17592186105388 #edb/ref 17592186045417] [17592186106540 #edb/ref 1069 "q-95278" #edb/ref 17592186045417] [17592186106540 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186106540 #edb/ref 1071 "$$\n\nFind the derivative of $w(x)={e}^{2x}\\operatorname{cosh}⁡2x.$" #edb/ref 17592186045417] [17592186106540 #edb/ref 1072 #uuid "3bd0a0d9-82c0-5151-b93d-74bd99605d18" #edb/ref 17592186045417] [17592186106540 #edb/ref 1074 "Here, we have the product of two functions $u(x)={e}^{2x}$ and $v(x)=\\operatorname{cosh}⁡2x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{w}^{′}(x) & =({e}^{2x})^{′}\\cdot \\operatorname{cosh}⁡2x+{e}^{2x}\\cdot (\\operatorname{cosh}⁡2x)^{′} \\\\  & =2{e}^{2x}\\cdot \\operatorname{cosh}⁡2x+{e}^{2x}\\cdot 2\\operatorname{sinh}⁡2x \\\\  & =2{e}^{2x}\\operatorname{cosh}⁡2x+2{e}^{2x}\\operatorname{sinh}⁡2x \\\\  & =2{e}^{2x}(\\operatorname{cosh}⁡2x+\\operatorname{sinh}⁡2x)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186106541 #edb/ref 1068 #edb/ref 17592186105394 #edb/ref 17592186045417] [17592186106541 #edb/ref 1069 "q-95320" #edb/ref 17592186045417] [17592186106541 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186106541 #edb/ref 1071 "$$\n\nIf $w(x)=\\frac{{e}^{x}}{\\operatorname{tanh}⁡2x},$ then ${w}^{′}(x)=\\frac{{e}^{x}\\cdot g(x)}{{tanh}^{2}⁡2x}.$ What is $g(x)?$" #edb/ref 17592186045417] [17592186106541 #edb/ref 1072 #uuid "d0908157-429d-5cf0-a396-e72a48ee6365" #edb/ref 17592186045417] [17592186106541 #edb/ref 1074 "In this case, the expression for $w(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={e}^{x}$ and $v(x)=\\operatorname{tanh}⁡2x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{w}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({e}^{x})^{′}\\cdot \\operatorname{tanh}⁡2x-{e}^{x}\\cdot (\\operatorname{tanh}⁡2x)^{′}}{(\\operatorname{tanh}⁡2x)^{2}} \\\\  & =\\frac{{e}^{x}\\operatorname{tanh}⁡2x-{e}^{x}\\cdot 2{sech}^{2}⁡2x}{{tanh}^{2}⁡2x} \\\\  & =\\frac{{e}^{x}\\overset{g(x)}{\\overset{⏞}{(\\operatorname{tanh}⁡2x-2{sech}^{2}⁡2x)}}}{{tanh}^{2}⁡2x}\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $g(x)=\\operatorname{tanh}⁡2x-2{sech}^{2}⁡2x.$" #edb/ref 17592186045417] [17592186106542 #edb/ref 1068 #edb/ref 17592186105400 #edb/ref 17592186045417] [17592186106542 #edb/ref 1069 "q-95672" #edb/ref 17592186045417] [17592186106542 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186106542 #edb/ref 1071 "$$\n\nFind the derivative of $y=-14\\operatorname{tanh}⁡x.$" #edb/ref 17592186045417] [17592186106542 #edb/ref 1072 #uuid "19bef744-c854-5471-bcbd-79165509be1f" #edb/ref 17592186045417] [17592186106542 #edb/ref 1074 "First, we recall the results for the derivatives of the basic hyperbolic functions:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x)=\\operatorname{cosh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x)=\\operatorname{sinh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)={sech}^{2}⁡x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-14\\operatorname{tanh}⁡x) \\\\  & =-14\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x) \\\\  & =-14{sech}^{2}⁡x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186106543 #edb/ref 1068 #edb/ref 17592186105406 #edb/ref 17592186045417] [17592186106543 #edb/ref 1069 "q-95686" #edb/ref 17592186045417] [17592186106543 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186106543 #edb/ref 1071 "$$\n\nFind the derivative of $f(x)=4{sinh}^{3}⁡x.$" #edb/ref 17592186045417] [17592186106543 #edb/ref 1072 #uuid "d2c0a118-2d4e-50b2-93bb-bfb098208306" #edb/ref 17592186045417] [17592186106543 #edb/ref 1074 "First, we express $f(x)$ as a composite function:\n\n$$\nf=4{g}^{3},\\,g=\\operatorname{sinh}⁡x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=12{g}^{2}\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=\\operatorname{cosh}⁡x.\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =12{g}^{2}\\cdot \\operatorname{cosh}⁡x \\\\  & =12{sinh}^{2}⁡x\\operatorname{cosh}⁡x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186106804 #edb/ref 1058 #edb/ref 17592186106807 #edb/ref 17592186045417] [17592186106804 #edb/ref 1061 31128 #edb/ref 17592186045417] [17592186106804 #edb/ref 1062 #uuid "287f42f8-ca6c-5b35-9c81-f905b16d1d70" #edb/ref 17592186045417] [17592186106804 #edb/ref 1063 #edb/ref 17592186105845 #edb/ref 17592186045417] [17592186106805 #edb/ref 1058 #edb/ref 17592186106806 #edb/ref 17592186045417] [17592186106805 #edb/ref 1061 31129 #edb/ref 17592186045417] [17592186106805 #edb/ref 1062 #uuid "ae60fdbc-8100-5f74-88dd-dc11838ae028" #edb/ref 17592186045417] [17592186106805 #edb/ref 1063 #edb/ref 17592186105846 #edb/ref 17592186045417] [17592186106806 #edb/ref 1058 #edb/ref 17592186106809 #edb/ref 17592186045417] [17592186106806 #edb/ref 1061 31130 #edb/ref 17592186045417] [17592186106806 #edb/ref 1062 #uuid "2a2959f5-bf52-5984-b73d-213061968d0f" #edb/ref 17592186045417] [17592186106806 #edb/ref 1063 #edb/ref 17592186105847 #edb/ref 17592186045417] [17592186106807 #edb/ref 1058 #edb/ref 17592186106805 #edb/ref 17592186045417] [17592186106807 #edb/ref 1061 31133 #edb/ref 17592186045417] [17592186106807 #edb/ref 1062 #uuid "c2857b6c-e2ae-51ac-8fed-6318597083dc" #edb/ref 17592186045417] [17592186106807 #edb/ref 1063 #edb/ref 17592186105848 #edb/ref 17592186045417] [17592186106808 #edb/ref 1058 #edb/ref 17592186106804 #edb/ref 17592186045417] [17592186106808 #edb/ref 1061 32691 #edb/ref 17592186045417] [17592186106808 #edb/ref 1062 #uuid "5afd4693-e1ad-5f9f-94cf-364eceabce7d" #edb/ref 17592186045417] [17592186106808 #edb/ref 1063 #edb/ref 17592186107119 #edb/ref 17592186045417] [17592186106809 #edb/ref 1058 #edb/ref 17592186106810 #edb/ref 17592186045417] [17592186106809 #edb/ref 1061 32711 #edb/ref 17592186045417] [17592186106809 #edb/ref 1062 #uuid "e126b8c5-2d87-5d89-bbf3-8265d50ec279" #edb/ref 17592186045417] [17592186106809 #edb/ref 1063 #edb/ref 17592186107120 #edb/ref 17592186045417] [17592186106810 #edb/ref 1061 32713 #edb/ref 17592186045417] [17592186106810 #edb/ref 1062 #uuid "0acbbc47-60c9-5d52-bac4-6df37c07940b" #edb/ref 17592186045417] [17592186106810 #edb/ref 1063 #edb/ref 17592186107121 #edb/ref 17592186045417] [17592186107119 #edb/ref 1064 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nSince the hyperbolic functions are defined in terms of exponential functions, we can easily calculate their derivatives. \n\nThe derivatives of the basic hyperbolic functions are as follows:  \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x) & =\\operatorname{cosh}⁡x \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x) & =\\operatorname{sinh}⁡x \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x) & ={sech}^{2}⁡x\\end{aligned}\n$$\n\nLet's use these results to find the derivative of the following function:\n\n$$\ny = \\sinh{x} - 2\\cosh{x}\n$$\n\nUsing the usual properties of derivatives, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x-2\\operatorname{cosh}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x)+\\frac{\\text{d}}{\\text{d}x}(-2\\operatorname{cosh}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x)-2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x) \\\\  & =\\operatorname{cosh}⁡x-2\\operatorname{sinh}⁡x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186107119 #edb/ref 1065 5207 #edb/ref 17592186045417] [17592186107119 #edb/ref 1066 #uuid "df316238-1ead-50db-80ec-d47656e6acad" #edb/ref 17592186045417] [17592186107119 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186107120 #edb/ref 1064 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n%$\n\nWe would like the prove the following result:\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\sinh{x}) = \\cosh x\n$$\n\nTo do this, we revert to the definition of the hyperbolic sine:\n\n$$\n\\sinh x = \\dfrac{1}{2}(e^x-e^{-x}).\n$$\n\nDifferentiating the above equation with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}({e}^{x}-{e}^{-x})) \\\\  & =\\frac{1}{2}\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x}-{e}^{-x}) \\\\  & =\\frac{1}{2}({e}^{x}+{e}^{-x}) \\\\  & =\\operatorname{cosh}⁡x.\\end{aligned}\n$$\n\nThe proof for the derivative of the hyperbolic cosine is very similar. You may wish to try it for yourself." #edb/ref 17592186045417] [17592186107120 #edb/ref 1065 5221 #edb/ref 17592186045417] [17592186107120 #edb/ref 1066 #uuid "11e38932-d6a4-5649-bbbe-205fb1bad98d" #edb/ref 17592186045417] [17592186107120 #edb/ref 1067 "Deriving the Formula for the Derivative of the Hyperbolic Sine" #edb/ref 17592186045417] [17592186107121 #edb/ref 1064 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nWe would like the prove the following result:\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\tanh{x}) = \\sech^2{x}\n$$\n\nWe do this using the definition of the hyperbolic tangent. The most convenient definition to work with for this purpose is\n\n$$\n\\tanh{x} = \\dfrac{e^{2x}-1}{e^{2x}+1}.\n$$\n\nDifferentiating the above equation with respect to $x$ using the quotient rule, we arrive at\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{{e}^{2x}-1}{{e}^{2x}+1}) \\\\  & =\\frac{({e}^{2x}-1)^{′}\\cdot ({e}^{2x}+1)-({e}^{2x}-1)\\cdot ({e}^{2x}+1)^{′}}{({e}^{2x}+1)^{2}} \\\\  & =\\frac{(2{e}^{2x})({e}^{2x}+1)-({e}^{2x}-1)(2{e}^{2x})}{({e}^{2x}+1)^{2}} \\\\  & =\\frac{2{e}^{4x}+2{e}^{2x}-2{e}^{4x}+2{e}^{2x}}{({e}^{2x}+1)^{2}} \\\\  & =\\frac{4{e}^{2x}}{({e}^{2x}+1)^{2}} \\\\  & ={(\\frac{2{e}^{x}}{{e}^{2x}+1})}^{2} \\\\  & ={(\\frac{2}{{e}^{x}+{e}^{-x}})}^{2} \\\\  & ={sech}^{2}⁡x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186107121 #edb/ref 1065 5223 #edb/ref 17592186045417] [17592186107121 #edb/ref 1066 #uuid "2a7389d5-4ba5-5fd7-8edb-b983483e6099" #edb/ref 17592186045417] [17592186107121 #edb/ref 1067 "Deriving the Formula for the Derivative of the Hyperbolic Tangent" #edb/ref 17592186045417] [17592186513528 #edb/ref 1080 "2x(\\operatorname{sinh}⁡2x-x\\operatorname{cosh}⁡2x)" #edb/ref 17592186045417] [17592186513528 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186513528 #edb/ref 1083 #uuid "0116124c-af9a-5e9f-874b