b/ref 17592186106542 :knowledge-point/_questions [{:db/id #edb/ref 17592186105845 :knowledge-point/id #uuid "a91e7c54-7ba7-5ea2-99a1-80510e77ac88" :knowledge-point/title "Basic Derivatives of the Hyperbolic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13626e40-5158-5225-8551-4e45700e1cfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14sech^{2} x" :db/id #edb/ref 17592186105401} {:answer/id #uuid "1a8c01da-9f36-56a1-b0e9-b5790d04b6f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14sech x" :db/id #edb/ref 17592186105402} {:answer/id #uuid "1b064487-a3a6-500d-b901-af10f1674d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14csch^{2} x" :db/id #edb/ref 17592186105403} {:answer/id #uuid "251dd90c-30ce-51ca-9ecc-c2337ec8c4a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14sech^{2} x" :db/id #edb/ref 17592186105404} {:answer/id #uuid "252810d9-398c-56c6-a60b-8fb10057c53c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14csch^{2} x" :db/id #edb/ref 17592186105405}] :answer-field/id #uuid "1a44efd7-9e2b-5307-9969-1480fd09d472" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186105400}] :question/id #uuid "19bef744-c854-5471-bcbd-79165509be1f" :question/math-academy-id "q-95672" :question/problem "Find the derivative of $y =-14\\tanh x$."}] [{:db/id #edb/ref 17592186106543 :knowledge-point/_questions [{:db/id #edb/ref 17592186105848 :knowledge-point/id #uuid "0016464f-27c3-5f1b-a6d3-fe7b5ffb7fbd" :knowledge-point/title "Differentiating Hyperbolic Functions Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8aa18368-59e2-5af7-b220-1fbfba09d2a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ide