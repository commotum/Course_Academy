6045417] [17592186105407 #edb/ref 1083 #uuid "8aa18368-59e2-5af7-b220-1fbfba09d2a9" #edb/ref 17592186045417] [17592186105408 #edb/ref 1080 "12\\sinh x\\cosh^{2} x" #edb/ref 17592186045417] [17592186105408 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186105408 #edb/ref 1083 #uuid "1d18a1ca-7a5a-5e8b-a59d-0ff3a683eb1f" #edb/ref 17592186045417] [17592186105409 #edb/ref 1080 "-12\\cosh^{2} x" #edb/ref 17592186045417] [17592186105409 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186105409 #edb/ref 1083 #uuid "3e87192c-d709-5716-916f-1c4923bcc5b5" #edb/ref 17592186045417] [17592186105410 #edb/ref 1080 "12\\sinh^{2} x\\cosh x" #edb/ref 17592186045417] [17592186105410 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186105410 #edb/ref 1083 #uuid "52639abf-8d0d-5d21-9b60-0a9f1c539360" #edb/ref 17592186045417] [17592186105411 #edb/ref 1080 "12\\cosh^{2} x" #edb/ref 17592186045417] [17592186105411 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186105411 #edb/ref 1083 #uuid "6881985f-9391-5617-b765-6b15e14b901e" #edb/ref 17592186045417] [17592186105684 #edb/ref 1069 "e-8328" #edb/ref 17592186045417] [17592186105684 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFind the derivative of $y = 3\\tanh{x}- \\sinh{x}$." #edb/ref 17592186045417] [17592186105684 #edb/ref 1072 #uuid "ec8ac943-1880-5f2a-81c3-35c136126ec1" #edb/ref 17592186045417] [17592186105684 #edb/ref 1074 "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nFirst, we recall the results for the derivatives of the basic hyperbolic functions:\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x} (\\sinh x) = \\cosh x, \\quad \\dfrac{\\textrm{d}}{\\textrm{d}x} (\\cosh x) = \\sinh x, \\quad \\dfrac{\\textrm{d}}{\\textrm{d}x} (\\tanh x) = \\sech^2 x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(3\\tanh x - \\sinh x) \\\\\n&= 3\\frac{d}{dx}(\\tanh x) - \\frac{d}{dx}(\\sinh x) \\\\\n&= 3sech^{2} x - \\cosh x\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186105685 #edb/ref 1069 "e-8329" #edb/ref 17592186045417] [17592186105685 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFind the derivative of $f(x) = 2x\\tanh{x}$." #edb/ref 17592186045417] [17592186105685 #edb/ref 1072 #uuid "3dcfc1f2-40ee-54b4-a937-0e101c7238d4" #edb/ref 17592186045417] [17592186105685 #edb/ref 1074 "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nHere, we have the product of two functions $u(x) = 2x$ and\n\n$$\nv(x)=\\tanh x\n$$\n\nSo, we apply the product rule:\n\n$$\n\\begin{aligned}\nf^{′}(x) &= (2x)^{′} \\cdot \\tanh x + 2x \\cdot (\\tanh x)^{′} \\\\\n&= 2 \\cdot \\tanh x + 2x \\cdot sech^{2} x \\\\\n&= 2\\tanh x + 2xsech^{2} x \\\\\n&= 2(\\tanh x + xsech^{2} x)\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186105686 #edb/ref 1069 "e-8330" #edb/ref 17592186045417] [17592186105686 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFind the derivative of $w(x) = \\dfrac{x^3}{\\cosh{x}}$." #edb/ref 17592186045417] [17592186105686 #edb/ref 1072 #uuid "1da70111-4e82-5fe4-b4be-08d0cc6f1110" #edb/ref 17592186045417] [17592186105686 #edb/ref 1074 "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nIn this case, the expression for $w(x)$ is a quotient\n\n$$\n\\dfrac{u(x)}{v(x)}\n$$\n\nwith $u(x) = x^3$ and\n\n$$\nv(x) = \\cosh{x}\n$$\n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\nw^{′}(x) &= (u^{′}(x) \\cdot v(x) - u(x) \\cdot v^{′}(x))/([v(x)]^{2}) \\\\\n&= ((x^{3})^{′} \\cdot \\cosh x - x^{3} \\cdot (\\cosh x)^{′})/((\\cosh x)^{2}) \\\\\n&= \\frac{3x^{2} \\cdot \\cosh x - x^{3} \\cdot \\sinh x}{\\cosh^{2} x} \\\\\n&= (x^{2}(3\\cosh x - x\\sinh x))/(\\cosh^{2} x)\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186105687 #edb/ref 1069 "e-8332" #edb/ref 17592186045417] [17592186105687 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFind the derivative of $f(x) = \\cosh{\\sqrt x}$." #edb/ref 17592186045417] [17592186105687 #edb/ref 1072 #uuid "192e6748-24e3-5688-87d9-cdf379e24101" #edb/ref 17592186045417] [17592186105687 #edb/ref 1074 "First, we express $f(x)$ as a composite function:\n\n$$\nf = \\cosh g, \\qquad g = \\sqrt x\n$$\n\nThe chain rule states that\n\n$$\n\\dfrac {\\textrm{d}f} {\\textrm{d}x} = \\dfrac {\\textrm{d}f} {\\textrm{d}g} \\cdot \\dfrac {\\textrm{d}g} {\\textrm{d}x}\n$$\n\nDifferentiating, we have\n\n$$\n\\dfrac {\\textrm{d}f} {\\textrm{d}g} = \\sinh g\n$$\n\nand\n\n$$\n\\dfrac {\\textrm{d}g} {\\textrm{d}x} = \\dfrac{1}{2\\sqrt x}\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\n\\frac{df}{dx} &= \\sinh g \\cdot \\frac{1}{2\\sqrt{x}} \\\\\n&= \\sinh \\sqrt{x} \\cdot \\frac{1}{2\\sqrt{x}} \\\\\n&= \\frac{\\sinh \\sqrt{x}}{2\\sqrt{x}}\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186105845 #edb/ref 1037 #edb/ref 17592186048192 #edb/ref 17592186045417] [17592186105845 #edb/ref 1037 #edb/ref 17592186050125 #edb/ref 17592186045417] [17592186105845 #edb/ref 1038 #edb/ref 17592186106536 #edb/ref 17592186045417] [17592186105845 #edb/ref 1038 #edb/ref 17592186106542 #edb/ref 17592186045417] [17592186105845 #edb/ref 1039 "Basic Derivatives of the Hyperbolic Functions" #edb/ref 17592186045417] [17592186105845 #edb/ref 1041 #edb/ref 17592186105684 #edb/ref 17592186045417] [17592186105845 #edb/ref 1042 #uuid "a91e7c54-7ba7-5ea2-99a1-80510e77ac88" #edb/ref 17592186045417] [17592186105846 #edb/ref 1037 #edb/ref 17592186048813 #edb/ref 17592186045417] [17592186105846 #edb/ref 1038 #edb/ref 17592186106538 #edb/ref 17592186045417] [17592186105846 #edb/ref 1038 #edb/ref 17592186106540 #edb/ref 17592186045417] [17592186105846 #edb/ref 1039 "Differentiating Hyperbolic Functions Using the Product Rule" #edb/ref 17592186045417] [17592186105846 #edb/ref 1041 #edb/ref 17592186105685 #edb/ref 17592186045417] [17592186105846 #edb/ref 1042 #uuid "a2992a46-063e-589d-a7e9-129e9f97eee6" #edb/ref 17592186045417] [17592186105847 #edb/ref 1037 #edb/ref 17592186048842 #edb/ref 17592186045417] [17592186105847 #edb/ref 1038 #edb/ref 17592186106539 #edb/ref 17592186045417] [17592186105847 #edb/ref 1038 #edb/ref 17592186106541 #edb/ref 17592186045417] [17592186105847 #edb/ref 1038 #edb/ref 17592186503709 #edb/ref 17592186045417] [17592186105847 #edb/ref 1039 "Differentiating Hyperbolic Functions Using the Quotient Rule" #edb/ref 17592186045417] [17592186105847 #edb/ref 1041 #edb/ref 17592186105686 #edb/ref 17592186045417] [17592186105847 #edb/ref 1042 #uuid "dbeb43f0-d94d-5ee0-b7fb-fbbe0a804cb7" #edb/ref 17592186045417] [17592186105848 #edb/ref 1037 #edb/ref 17592186051084 #edb/ref 17592186045417] [17592186105848 #edb/ref 1038 #edb/ref 17592186106537 #edb/ref 17592186045417] [17592186105848 #edb/ref 1038 #e