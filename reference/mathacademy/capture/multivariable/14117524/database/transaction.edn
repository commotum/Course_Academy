{3} \\\\  & =3+5+6 \\\\  & =14\\,\\text{kg}\\end{aligned}\n$$\n\nand the moment of the system about the origin is\n\n$$\n\\begin{aligned}{M}_{O} & ={\\sum }_{i=1}^{n}{m}_{i}{x}_{i} \\\\  & ={m}_{1}{x}_{1}+{m}_{2}{x}_{2}+{m}_{3}{x}_{3} \\\\  & =3\\cdot 2+5\\cdot 4+6\\cdot 5 \\\\  & =6+20+30 \\\\  & =56\\,\\text{kg}\\cdot \\text{m}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m}=\\frac{56}{14}=4.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a786b852-ce88-5fc0-90a1-2feaa736f213"] :db/ensure [:question/validate]} {:db/id "answer-field-a786b852-ce88-5fc0-90a1-2feaa736f213" :answer-field/id #uuid "a786b852-ce88-5fc0-90a1-2feaa736f213" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-97980ade-bc2d-54c0-b5c3-c28f97d318ed" :answer-field/choices ["answer-90ea0bcf-6a12-562a-bef7-5d131f00899e" "answer-97980ade-bc2d-54c0-b5c3-c28f97d318ed" "answer-7ed59f16-4bc8-54e9-a2d6-8863cb88af14" "answer-c3158375-b30c-56ac-8256-f1e5cb6e6603" "answer-a270d78f-853a-55bd-b125-cdc4937a0cd0"] :db/ensure [:answer-field/validate]} {:db/id "answer-90ea0bcf-6a12-562a-bef7-5d131f00899e" :answer/id #uuid "90ea0bcf-6a12-562a-bef7-5d131f00899e" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-97980ade-bc2d-54c0-b5c3-c28f97d318ed" :answer/id #uuid "97980ade-bc2d-54c0-b5c3-c28f97d318ed" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-7ed59f16-4bc8-54e9-a2d6-8863cb88af14" :answer/id #uuid "7ed59f16-4bc8-54e9-a2d6-8863cb88af14" :answer/type :answer.type/math :answer/value "\\frac{17}{4}" :db/ensure [:answer/validate]} {:db/id "answer-c3158375-b30c-56ac-8256-f1e5cb6e6603" :answer/id #uuid "c3158375-b30c-56ac-8256-f1e5cb6e6603" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "answer-a270d78f-853a-55bd-b125-cdc4937a0cd0" :answer/id #uuid "a270d78f-853a-55bd-b125-cdc4937a0cd0" :answer/type :answer.type/math :answer/value "\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "question-7ff6628f-789d-5102-a51c-36a2bdf1a544" :question/id #uuid "7ff6628f-789d-5102-a51c-36a2bdf1a544" :question/math-academy-id "q-163266" :question/problem "![](images/ec/ec5be4034607896656ff6613f05843529f6673783fdb30fdd4eb355c3acf6573.png)\n\nConsider the collection of point masses above, where the $x$-coordinates are measured in meters. What is the $x$-coordinate of the center of mass for this system?" :question/worked-solution "The center of mass, denoted $\\overset{―}{x},$ of a collection of point masses ${m}_{1},{m}_{2},…,{m}_{n}$ located at ${x}_{1},{x}_{2},…,{x}_{n}$ along the $x$-axis is given by \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m},\n$$\n\n \n\nwhere \n\n- $m={\\sum }_{i=1}^{n}{m}_{i}$ is the total mass of the system,\n\n- ${M}_{O}={\\sum }_{i=1}^{n}{m}_{i}{x}_{i}$ is the total moment of the system about the origin $O.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{m}_{1} & =4, & \\,{m}_{2} & =7, & \\,{m}_{3} & =1, \\\\ {x}_{1} & =3, & \\,{x}_{2} & =4, & \\,{x}_{3} & =8.\\end{aligned}\n$$\n\nSo, the total mass of the system is\n\n$$\n\\begin{aligned}m & ={\\sum }_{i=1}^{n}{m}_{i} \\\\  & ={m}_{1}+{m}_{2}+{m}_{3} \\\\  & =4+7+1 \\\\  & =12\\end{aligned}\n$$\n\nand the total moment of the system about the origin is\n\n$$\n\\begin{aligned}{M}_{O} & ={\\sum }_{i=1}^{n}{m}_{i}{x}_{i} \\\\  & ={m}_{1}{x}_{1}+{m}_{2}{x}_{2}+{m}_{3}{x}_{3} \\\\  & =4\\cdot 3+7\\cdot 4+1\\cdot 8 \\\\  & =12+28+8 \\\\  & =48.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m}=\\frac{48}{12}=4.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-df76c1aa-2e4e-59a1-93d8-e361d723313c"] :db/ensure [:question/validate]} {:db/id "answer-field-df76c1aa-2e4e-59a1-93d8-e361d723313c" :answer-field/id #uuid "df76c1aa-2e4e-59a1-93d8-e361d723313c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4d7a5683-d99c-5977-99d9-4fb4c88bacb5" :answer-field/choices ["answer-4d7a5683-d99c-5977-99d9-4fb4c88bacb5" "answer-ac154ac0-65aa-5198-be49-5bbf65f41126" "answer-7f319919-f387-5594-89e5-07e8cad4aa6a" "answer-7055f2c4-9e20-5534-8a6e-5f1ae2cab7ec" "answer-3f1608a6-a6e8-5baa-952a-23d871596e61"] :db/ensure [:answer-field/validate]} {:db/id "answer-4d7a5683-d99c-5977-99d9-4fb4c88bacb5" :answer/id #uuid "4d7a5683-d99c-5977-99d9-4fb4c88bacb5" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-ac154ac0-65aa-5198-be49-5bbf65f41126" :answer/id #uuid "ac154ac0-65aa-5198-be49-5bbf65f41126" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-7f319919-f387-5594-89e5-07e8cad4aa6a" :answer/id #uuid "7f319919-f387-5594-89e5-07e8cad4aa6a" :answer/type :answer.type/math :answer/value "\\frac{11}{2}" :db/ensure [:answer/validate]} {:db/id "answer-7055f2c4-9e20-5534-8a6e-5f1ae2cab7ec" :answer/id #uuid "7055f2c4-9e20-5534-8a6e-5f1ae2cab7ec" :answer/type :answer.type/math :answer/value "\\frac{21}{12}" :db/ensure [:answer/validate]} {:db/id "answer-3f1608a6-a6e8-5baa-952a-23d871596e61" :answer/id #uuid "3f1608a6-a6e8-5baa-952a-23d871596e61" :answer/type :answer.type/math :answer/value "\\frac{25}{4}" :db/ensure [:answer/validate]} {:db/id 17592186129541 :question/problem "Consider the collection of point masses ${m}_{1}=2\\,\\text{kg},$ ${m}_{2}=5\\,\\text{kg},$ and ${m}_{3}=7\\,\\text{kg}$ located at ${x}_{1}=1.5,$ ${x}_{2}=5,$ and ${x}_{3}=10,$ respectively, along the $x$-axis, where the $x$-coordinates are measured in meters. What is the $x$-coordinate of the center of mass for this system?" :question/worked-solution "The center of mass, denoted $\\overset{―}{x},$ of a collection of point masses ${m}_{1},{m}_{2},…,{m}_{n}$ located at ${x}_{1},{x}_{2},…,{x}_{n}$ along the $x$-axis is given by \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m},\n$$\n\n \n\nwhere \n\n- $m={\\sum }_{i=1}^{n}{m}_{i}$ is the total mass of the system,\n\n- ${M}_{O}={\\sum }_{i=1}^{n}{m}_{i}{x}_{i}$ is the total moment of the system about the origin $O.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{m}_{1} & =2, & \\,{m}_{2} & =5, & \\,{m}_{3} & =7, \\\\ {x}_{1} & =1.5, & \\,{x}_{2} & =5, & \\,{x}_{3} & =10.\\end{aligned}\n$$\n\nSo, the total mass of the system is\n\n$$\n\\begin{aligned}m & ={\\sum }_{i=1}^{n}{m}_{i} \\\\  & ={m}_{1}+{m}_{2}+{m}_{3} \\\\  & =2+5+7 \\\\  & =14\\,\\text{kg}\\end{aligned}\n$$\n\nand the moment of the system about the origin is\n\n$$\n\\begin{aligned}{M}_{O} & ={\\sum }_{i=1}^{n}{m}_{i}{x}_{i} \\\\  & ={m}_{1}{x}_{1}+{m}_{2}{x}_{2}+{m}_{3}{x}_{3} \\\\  & =2\\cdot 1.5+5\\cdot 5+7\\cdot 10 \\\\  & =3+25+70 \\\\  & =98\\,\\text{kg}\\cdot \\text{m}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m}=\\frac{98}{14}=7.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1297a3b8-09e4-59c7-9a4f-11c1e13a704e"] :db/ensure [:question/validate]} {:db/id "answer-field-1297a3b8-09e4-59c7-9a4f-11c1e13a704e" :answer-field/id #uuid "1297a3b8-09e4-59c7-9a4f-11c1e13a704e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cf14b1f1-4857-5b68-b5f9-9d01f50b5681" :answer-field/choices ["answer-cf14b1f1-4857-5b68-b5f9-9d01f50b5681" "answer-7d775062-7b75-55a1-8203-4ce972509d59" "answer-32cfb2b9-4b3d-58ae-b734-18eba9f93747" "answer-27d86410-57d4-58f3-9c9c-e3d3e05cd601" "answer-488f8ad7-aef1-565d-99a2-5a515dc3999a"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf14b1f1-4857-5b68-b5f9-9d01f50b5681" :answer/id #uuid "cf14b1f1-4857-5b68-b5f9-9d01f50b5681" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-7d775062-7b75-55a1-8203-4ce972509d59" :answer/id #uuid "7d775062-7b75-55a1-8203-4ce972509d59" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-32cfb2b9-4b3d-58ae-b734-18eba9f93747" :answer/id #uuid "32cfb2b9-4b3d-58ae-b734-18eba9f93747" :answer/type :answer.type/math :answer/value "\\frac{105}{14}" :db/ensure [:answer/validate]} {:db/id "answer-27d86410-57d4-58f3-9c9c-e3d3e05cd601" :answer/id #uuid "27d86410-57d4-58f3-9c9c-e3d3e05cd601" :answer/type :answer.type/math :answer/value "\\frac{15}{2}" :db/ensure [:answer/validate]} {:db/id "answer-488f8ad7-aef1-565d-99a2-5a515dc3999a" :answer/id #uuid "488f8ad7-aef1-565d-99a2-5a515dc3999a" :answer/type :answer.type/math :answer/value "\\frac{28}{3}" :db/ensure [:answer/validate]} {:db/id "question-b1025740-1de0-548c-b755-7aea427a0e9c" :question/id #uuid "b1025740-1de0-548c-b755-7aea427a0e9c" :question/math-academy-id "q-163275" :question/problem "![](images/21/216250fd3d35779c87c90a0eacc6c05c4084e1eb4d602f65051372b0ada2e45f.png)\n\nConsider the collection of point masses shown above. Given that the center of mass for the collection is located at $(\\overset{―}{x},\\overset{―}{y}),$ what is the value of $\\overset{―}{y}?$" :question/worked-solution "The center of mass of a collection of point masses ${m}_{1},{m}_{2},…,{m}_{n}$ located at $({x}_{1}{y}_{1}),({x}_{2},{y}_{2}),…,({x}_{n},{y}_{n})$ on the plane is given by \n\n$$\n(\\overset{―}{x},\\overset{―}{y})=(\\frac{{M}_{y}}{m},\\frac{{M}_{x}}{m}),\n$$\n\n \n\nwhere \n\n- $m={\\sum }_{i=1}^{n}{m}_{i}$ is the total mass of the system,\n\n- ${M}_{x}={\\sum }_{i=1}^{n}{m}_{i}{y}_{i}$ is the total moment of the system about the $x$-axis, and\n\n- ${M}_{y}={\\sum }_{i=1}^{n}{m}_{i}{x}_{i}$ is the total moment of the system about the $y$-axis.\n\nSince we require the $y$-coordinate of the center of mass, we need to compute the moment about the $x$-axis.\n\nLet's denote the masses as\n\n$$\n{m}_{1}=4,\\,{m}_{2}=2,\\,{m}_{3}=2,\\,{m}_{4}=6.\n$$\n\nThen, the corresponding $y$-coordinates of the masses are\n\n$$\n{y}_{1}=1,\\,{y}_{2}=4,\\,{y}_{3}=1,\\,{y}_{4}=3.\n$$\n\nSo, the total mass of the system is\n\n$$\n\\begin{aligned}m & ={\\sum }_{i=1}^{n}{m}_{i} \\\\  & ={m}_{1}+{m}_{2}+{m}_{3}+{m}_{4} \\\\  & =4+2+2+6 \\\\  & =14\\end{aligned}\n$$\n\nand the moment of the system about the $x$-axis is\n\n$$\n\\begin{aligned}{M}_{x} & ={\\sum }_{i=1}^{n}{m}_{i}{y}_{i} \\\\  & ={m}_{1}{y}_{1}+{m}_{2}{y}_{2}+{m}_{3}{y}_{3}+{m}_{4}{y}_{4} \\\\  & =4\\cdot 1+2\\cdot 4+2\\cdot 1+6\\cdot 3 \\\\  & =4+8+2+18 \\\\  & =32.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\overset{―}{y}=\\frac{{M}_{x}}{m}=\\frac{32}{14}=\\frac{16}{7}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-9a499806-baa5-50d7-9b89-5faa59aa0a85"] :db/ensure [:question/validate]} {:db/id "answer-field-9a499806-baa5-50d7-9b89-5faa59aa0a85" :answer-field/id #uuid "9a499806-baa5-50d7-9b89-5faa59aa0a85" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-02206a54-56f4-5ead-ad37-aef168ba495a" :answer-field/choices ["answer-7f7c7e98-6ff1-505c-9e7b-bdda6d8c5b32" "answer-02206a54-56f4-5ead-ad37-aef168ba495a" "answer-1cfc721f-771a-5768-8d3b-abba97fdfa3b" "answer-0ec37fae-c8ad-518e-b28d-d13e005224dd" "answer-11f897f5-4210-55ff-9b2d-96768050bd5f"] :db/ensure [:answer-field/validate]} {:db/id "answer-7f7c7e98-6ff1-505c-9e7b-bdda6d8c5b32" :answer/id #uuid "7f7c7e98-6ff1-505c-9e7b-bdda6d8c5b32" :answer/type :answer.type/math :answer/value "\\frac{12}{7}" :db/ensure [:answer/validate]} {:db/id "answer-02206a54-56f4-5ead-ad37-aef168ba495a" :answer/id #uuid "02206a54-56f4-5ead-ad37-aef168ba495a" :answer/type :answer.type/math :answer/value "\\frac{16}{7}" :db/ensure [:answer/validate]} {:db/id "answer-1cfc721f-771a-5768-8d3b-abba97fdfa3b" :answer/id #uuid "1cfc721f-771a-5768-8d3b-abba97fdfa3b" :answer/type :answer.type/math :answer/value "\\frac{29}{14}" :db/ensure [:answer/validate]} {:db/id "answer-0ec37fae-c8ad-518e-b28d-d13e005224dd" :answer/id #uuid "0ec37fae-c8ad-518e-b28d-d13e005224dd" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-11f897f5-4210-55ff-9b2d-96768050bd5f" :answer/id #uuid "11f897f5-4210-55ff-9b2d-96768050bd5f" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "question-a4435932-14e7-5d5c-ae2a-cc6b7883581b" :question/id #uuid "a4435932-14e7-5d5c-ae2a-cc6b7883581b" :question/math-academy-id "q-163272" :question/problem "![](images/86/8628c638fd2820222f494bb2a06bc685964cf9da249fa64e953040ac623faeb7.png)\n\nConsider the collection of point masses shown above. Given that the center of mass for the collection is located at $(\\overset{―}{x},\\overset{―}{y}),$ what is the value of $\\overset{―}{y}?$" :question/worked-solution "The center of mass of a collection of point masses ${m}_{1},{m}_{2},…,{m}_{n}$ located at $({x}_{1}{y}_{1}),({x}_{2},{y}_{2}),…,({x}_{n},{y}_{n})$ on the plane is given by \n\n$$\n(\\overset{―}{x},\\overset{―}{y})=(\\frac{{M}_{y}}{m},\\frac{{M}_{x}}{m}),\n$$\n\n \n\nwhere \n\n- $m={\\sum }_{i=1}^{n}{m}_{i}$ is the total mass of the system,\n\n- ${M}_{x}={\\sum }_{i=1}^{n}{m}_{i}{y}_{i}$ is the total moment of the system about the $x$-axis, and\n\n- ${M}_{y}={\\sum }_{i=1}^{n}{m}_{i}{x}_{i}$ is the total moment of the system about the $y$-axis.\n\nSince we require the $y$-coordinate of the center of mass, we need to compute the moment about the $x$-axis.\n\nLet's denote the masses as\n\n$$\n{m}_{1}=4,\\,{m}_{2}=3,\\,{m}_{3}=5.\n$$\n\nThen, the corresponding $y$-coordinates of the masses are\n\n$$\n{y}_{1}=2,\\,{y}_{2}=-1,\\,{y}_{3}=3.\n$$\n\nSo, the total mass of the system is\n\n$$\n\\begin{aligned}m & ={\\sum }_{i=1}^{n}{m}_{i} \\\\  & ={m}_{1}+{m}_{2}+{m}_{3} \\\\  & =4+3+5 \\\\  & =12\\end{aligned}\n$$\n\nand the moment of the system about the $x$-axis is\n\n$$\n\\begin{aligned}{M}_{x} & ={\\sum }_{i=1}^{n}{m}_{i}{y}_{i} \\\\  & ={m}_{1}{y}_{1}+{m}_{2}{y}_{2}+{m}_{3}{y}_{3} \\\\  & =4\\cdot 2+3\\cdot (-1)+5\\cdot 3 \\\\  & =8-3+15 \\\\  & =20.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\overset{―}{y}=\\frac{{M}_{x}}{m}=\\frac{20}{12}=\\frac{5}{3}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-dd74df0e-f4f6-5d5d-8a66-f72d1112faa4"] :db/ensure [:question/validate]} {:db/id "answer-field-dd74df0e-f4f6-5d5d-8a66-f72d1112faa4" :answer-field/id #uuid "dd74df0e-f4f6-5d5d-8a66-f72d1112faa4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3017b1bd-f48b-5127-9b89-953e5a0d869b" :answer-field/choices ["answer-0abdc611-4f3e-54ea-95e5-40b79900ddf8" "answer-7d91d1fc-2844-5ef9-b203-cdb0c0ce239e" "answer-3017b1bd-f48b-5127-9b89-953e5a0d869b" "answer-99e6cd00-788a-560a-858b-d047dc181998" "answer-3f5b1fa2-54b3-587c-8bc4-e55e99e4478a"] :db/ensure [:answer-field/validate]} {:db/id "answer-0abdc611-4f3e-54ea-95e5-40b79900ddf8" :answer/id #uuid "0abdc611-4f3e-54ea-95e5-40b79900ddf8" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-7d91d1fc-2844-5ef9-b203-cdb0c0ce239e" :answer/id #uuid "7d91d1fc-2844-5ef9-b203-cdb0c0ce239e" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-3017b1bd-f48b-5127-9b89-953e5a0d869b" :answer/id #uuid "3017b1bd-f48b-5127-9b89-953e5a0d869b" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "answer-99e6cd00-788a-560a-858b-d047dc181998" :answer/id #uuid "99e6cd00-788a-560a-858b-d047dc181998" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "answer-3f5b1fa2-54b3-587c-8bc4-e55e99e4478a" :answer/id #uuid "3f5b1fa2-54b3-587c-8bc4-e55e99e4478a" :answer/type :answer.type/math :answer/value "\\frac{7}{4}" :db/ensure [:answer/validate]} {:db/id 17592186129543 :question/problem "![](images/46/467a702d26a9e8c088a74aca889e2adbc68c8f86192b7138b37bdbdff09a7582.png)\n\nConsider the collection of point masses shown above, where the distances along the $x$ and $y$ axes are measured in meters. Given that the center of mass for the collection is located at $(\\overset{―}{x},\\overset{―}{y}),$ what is the value of $\\overset{―}{x}?$" :question/worked-solution "The center of mass of a collection of point masses ${m}_{1},{m}_{2},…,{m}_{n}$ located at $({x}_{1}{y}_{1}),({x}_{2},{y}_{2}),…,({x}_{n},{y}_{n})$ on the plane is given by \n\n$$\n(\\overset{―}{x},\\overset{―}{y})=(\\frac{{M}_{y}}{m},\\frac{{M}_{x}}{m}),\n$$\n\n \n\nwhere \n\n- $m={\\sum }_{i=1}^{n}{m}_{i}$ is the total mass of the system,\n\n- ${M}_{x}={\\sum }_{i=1}^{n}{m}_{i}{y}_{i}$ is the total moment of the system about the $x$-axis, and\n\n- ${M}_{y}={\\sum }_{i=1}^{n}{m}_{i}{x}_{i}$ is the total moment of the system about the $y$-axis.\n\nSince we require the $x$-coordinate of the center of mass, we need to compute the moment about the $y$-axis.\n\nLet's denote the masses as\n\n$$\n{m}_{1}=2,\\,{m}_{2}=3,\\,{m}_{3}=1,\\,{m}_{4}=5.\n$$\n\nThen, the corresponding $x$-coordinates of the masses are\n\n$$\n{x}_{1}=1,\\,{x}_{2}=-2,\\,{x}_{3}=1,\\,{x}_{4}=-3.\n$$\n\nSo, the total mass of the system is\n\n$$\n\\begin{aligned}m & ={\\sum }_{i=1}^{n}{m}_{i} \\\\  & ={m}_{1}+{m}_{2}+{m}_{3}+{m}_{4} \\\\  & =2+3+1+5 \\\\  & =11\\,\\text{kg}\\end{aligned}\n$$\n\nand the moment of the system about the $y$-axis is\n\n$$\n\\begin{aligned}{M}_{y} & ={\\sum }_{i=1}^{n}{m}_{i}{x}_{i} \\\\  & ={m}_{1}{x}_{1}+{m}_{2}{x}_{2}+{m}_{3}{x}_{3}+{m}_{4}{x}_{4} \\\\  & =2\\cdot 1+3\\cdot (-2)+1\\cdot 1+5\\cdot (-3) \\\\  & =2-6+1-15 \\\\  & =-18.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\overset{―}{x}=\\frac{{M}_{y}}{m}=-\\frac{18}{11}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-642ad4c4-8839-50bc-a8d3-ba15b1b47dd8"] :db/ensure [:question/validate]} {:db/id "answer-field-642ad4c4-8839-50bc-a8d3-ba15b1b47dd8" :answer-field/id #uuid "642ad4c4-8839-50bc-a8d3-ba15b1b47dd8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fe18ca9d-d11e-52d3-bd3e-9341e7a6e309" :answer-field/choices ["answer-b4d264e8-4361-5ae6-b05a-9868d4a6167e" "answer-ac729b9d-ed55-5527-aca5-13c304b26552" "answer-c8e97068-6e60-53e0-92b0-457d117a5f82" "answer-554d96a1-8bbd-562e-bf06-6ba5cdfe1b9e" "answer-fe18ca9d-d11e-52d3-bd3e-9341e7a6e309"] :db/ensure [:answer-field/validate]} {:db/id "answer-b4d264e8-4361-5ae6-b05a-9868d4a6167e" :answer/id #uuid "b4d264e8-4361-5ae6-b05a-9868d4a6167e" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-ac729b9d-ed55-5527-aca5-13c304b26552" :answer/id #uuid "ac729b9d-ed55-5527-aca5-13c304b26552" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-c8e97068-6e60-53e0-92b0-457d117a5f82" :answer/id #uuid "c8e97068-6e60-53e0-92b0-457d117a5f82" :answer/type :answer.type/math :answer/value "-\\frac{12}{11}" :db/ensure [:answer/validate]} {:db/id "answer-554d96a1-8bbd-562e-bf06-6ba5cdfe1b9e" :answer/id #uuid "554d96a1-8bbd-562e-bf06-6ba5cdfe1b9e" :answer/type :answer.type/math :answer/value "-\\frac{16}{11}" :db/ensure [:answer/validate]} {:db/id "answer-fe18ca9d-d11e-52d3-bd3e-9341e7a6e309" :answer/id #uuid "fe18ca9d-d11e-52d3-bd3e-9341e7a6e309" :answer/type :answer.type/math :answer/value "-\\frac{18}{11}" :db/ensure [:answer/validate]} {:db/id "question-e7aab632-bc8c-5d87-8d6b-6366b876ba3c" :question/id #uuid "e7aab632-bc8c-5d87-8d6b-6366b876ba3c" :question/math-academy-id "q-163267" :question/problem "![](images/7e/7ef79655f2689ab5987631a89ccb8d91c0ed6f67375750f6c0720224f92dddd6.png)\n\nConsider the collection of point masses shown above, where the distances along the $x$ and $y$ axes are measured in meters. Given that the center of mass for the collection is located at $(\\overset{―}{x},\\overset{―}{y}),$ what is the value of $\\overset{―}{x}?$" :question/worked-solution "The center of mass of a collection of point masses ${m}_{1},{m}_{2},…,{m}_{n}$ located at $({x}_{1}{y}_{1}),({x}_{2},{y}_{2}),…,({x}_{n},{y}_{n})$ on the plane is given by \n\n$$\n(\\overset{―}{x},\\overset{―}{y})=(\\frac{{M}_{y}}{m},\\frac{{M}_{x}}{m}),\n$$\n\n \nwhere \n\n- $m={\\sum }_{i=1}^{n}{m}_{i}$ is the total mass of the system,\n\n- ${M}_{x}={\\sum }_{i=1}^{n}{m}_{i}{y}_{i}$ is the total moment of the system about the $x$-axis, and\n\n- ${M}_{y}={\\sum }_{i=1}^{n}{m}_{i}{x}_{i}$ is the total moment of the system about the $y$-axis.\n\nSince we require the $x$-coordinate of the center of mass, we need to compute the moment about the $y$-axis.\n\nLet's denote the masses as\n\n$$\n{m}_{1}=3,\\,{m}_{2}=6,\\,{m}_{3}=4,\\,{m}_{4}=2.\n$$\n\nThen, the corresponding $x$-coordinates of the masses are\n\n$$\n{x}_{1}=-4,\\,{x}_{2}=-1,\\,{x}_{3}=3,\\,{x}_{4}=4.\n$$\n\nSo, the total mass of the system is\n\n$$\n\\begin{aligned}m & ={\\sum }_{i=1}^{n}{m}_{i} \\\\  & ={m}_{1}+{m}_{2}+{m}_{3}+{m}_{4} \\\\  & =3+6+4+2 \\\\  & =15\\,\\text{kg}\\end{aligned}\n$$\n\nand the moment of the system about the $y$-axis is\n\n$$\n\\begin{aligned}{M}_{y} & ={\\sum }_{i=1}^{n}{m}_{i}{x}_{i} \\\\  & ={m}_{1}{x}_{1}+{m}_{2}{x}_{2}+{m}_{3}{x}_{3}+{m}_{4}{x}_{4} \\\\  & =3\\cdot (-4)+6\\cdot (-1)+4\\cdot 3+2\\cdot 4 \\\\  & =-12-6+12+8 \\\\  & =2.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\overset{―}{x}=\\frac{{M}_{y}}{m}=\\frac{2}{15}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-86e0cad2-c40a-5e72-b86a-02758a0ed851"] :db/ensure [:question/validate]} {:db/id "answer-field-86e0cad2-c40a-5e72-b86a-02758a0ed851" :answer-field/id #uuid "86e0cad2-c40a-5e72-b86a-02758a0ed851" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6ffa0990-f586-5414-9540-2ed813589a95" :answer-field/choices ["answer-26624de5-ee6e-5d9a-bd83-6ee6eed36a2f" "answer-31ec2b5e-e22d-5580-be0a-1e02d625f9ac" "answer-1784f214-d984-5a5a-8ec4-2a3f10d4876f" "answer-6ffa0990-f586-5414-9540-2ed813589a95" "answer-54e199f8-09f4-5cac-80ad-2234045fbfcf"] :db/ensure [:answer-field/validate]} {:db/id "answer-26624de5-ee6e-5d9a-bd83-6ee6eed36a2f" :answer/id #uuid "26624de5-ee6e-5d9a-bd83-6ee6eed36a2f" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-31ec2b5e-e22d-5580-be0a-1e02d625f9ac" :answer/id #uuid "31ec2b5e-e22d-5580-be0a-1e02d625f9ac" :answer/type :answer.type/math :answer/value "-\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "answer-1784f214-d984-5a5a-8ec4-2a3f10d4876f" :answer/id #uuid "1784f214-d984-5a5a-8ec4-2a3f10d4876f" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-6ffa0990-f586-5414-9540-2ed813589a95" :answer/id #uuid "6ffa0990-f586-5414-9540-2ed813589a95" :answer/type :answer.type/math :answer/value "\\frac{2}{15}" :db/ensure [:answer/validate]} {:db/id "answer-54e199f8-09f4-5cac-80ad-2234045fbfcf" :answer/id #uuid "54e199f8-09f4-5cac-80ad-2234045fbfcf" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "question-71003ac4-a6c7-5375-9693-7a03dcbed8fa" :question/id #uuid "71003ac4-a6c7-5375-9693-7a03dcbed8fa" :question/math-academy-id "q-163274" :question/problem "![](images/f4/f4950acfb535c32e4f7e275bcd17b72717c717c5a4ed17834d6a9c5561cc433e.png)\n\nConsider the collection of point masses shown above. Given that the center of mass for the collection is located at $(\\overset{―}{x},\\overset{―}{y}),$ what is the value of $\\overset{―}{y}?$" :question/worked-solution "The center of mass of a collection of point masses ${m}_{1},{m}_{2},…,{m}_{n}$ located at $({x}_{1}{y}_{1}),({x}_{2},{y}_{2}),…,({x}_{n},{y}_{n})$ on the plane is given by \n\n$$\n(\\overset{―}{x},\\overset{―}{y})=(\\frac{{M}_{y}}{m},\\frac{{M}_{x}}{m}),\n$$\n\n \n\nwhere \n\n- $m={\\sum }_{i=1}^{n}{m}_{i}$ is the total mass of the system,\n\n- ${M}_{x}={\\sum }_{i=1}^{n}{m}_{i}{y}_{i}$ is the total moment of the system about the $x$-axis, and\n\n- ${M}_{y}={\\sum }_{i=1}^{n}{m}_{i}{x}_{i}$ is the total moment of the system about the $y$-axis.\n\nSince we require the $y$-coordinate of the center of mass, we need to compute the moment about the $x$-axis.\n\nLet's denote the masses as\n\n$$\n{m}_{1}=4,\\,{m}_{2}=1,\\,{m}_{3}=3.\n$$\n\nThen, the corresponding $y$-coordinates of the masses are\n\n$$\n{y}_{1}=2,\\,{y}_{2}=0,\\,{y}_{3}=4.\n$$\n\nSo, the total mass of the system is\n\n$$\n\\begin{aligned}m & ={\\sum }_{i=1}^{n}{m}_{i} \\\\  & ={m}_{1}+{m}_{2}+{m}_{3} \\\\  & =4+1+3 \\\\  & =8\\end{aligned}\n$$\n\nand the moment of the system about the $x$-axis is\n\n$$\n\\begin{aligned}{M}_{x} & ={\\sum }_{i=1}^{n}{m}_{i}{y}_{i} \\\\  & ={m}_{1}{y}_{1}+{m}_{2}{y}_{2}+{m}_{3}{y}_{3} \\\\  & =4\\cdot 2+1\\cdot 0+3\\cdot 4 \\\\  & =8+0+12 \\\\  & =20.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\overset{―}{y}=\\frac{{M}_{x}}{m}=\\frac{20}{8}=\\frac{5}{2}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-54ac5df5-45ed-5bba-bbdc-954b28eff2c7"] :db/ensure [:question/validate]} {:db/id "answer-field-54ac5df5-45ed-5bba-bbdc-954b28eff2c7" :answer-field/id #uuid "54ac5df5-45ed-5bba-bbdc-954b28eff2c7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ba50ba89-6037-5f8b-b3a0-a58041d65c22" :answer-field/choices ["answer-cdd32cf2-4f94-5bee-8f96-f744ae03a0fd" "answer-d5a33a3a-3978-5e1b-a801-67542010ee4d" "answer-ba50ba89-6037-5f8b-b3a0-a58041d65c22" "answer-704c7047-9708-525c-8116-ec7452daf164" "answer-be0de875-2f88-58c9-8a47-8e4cbf39ed2f"] :db/ensure [:answer-field/validate]} {:db/id "answer-cdd32cf2-4f94-5bee-8f96-f744ae03a0fd" :answer/id #uuid "cdd32cf2-4f94-5bee-8f96-f744ae03a0fd" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-d5a33a3a-3978-5e1b-a801-67542010ee4d" :answer/id #uuid "d5a33a3a-3978-5e1b-a801-67542010ee4d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-ba50ba89-6037-5f8b-b3a0-a58041d65c22" :answer/id #uuid "ba50ba89-6037-5f8b-b3a0-a58041d65c22" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-704c7047-9708-525c-8116-ec7452daf164" :answer/id #uuid "704c7047-9708-525c-8116-ec7452daf164" :answer/type :answer.type/math :answer/value "\\frac{8}{5}" :db/ensure [:answer/validate]} {:db/id "answer-be0de875-2f88-58c9-8a47-8e4cbf39ed2f" :answer/id #uuid "be0de875-2f88-58c9-8a47-8e4cbf39ed2f" :answer/type :answer.type/math :answer/value "\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id 17592186130475 :tutorial/content "Suppose we have two point masses $A$ and $B$ of mass $20\\,\\textrm{kg}$ and $40\\,\\textrm{kg},$ respectively, connected by a rigid, massless rod of length $1\\,\\textrm{m}$, as shown below.\n\n![](images/09/0948ebde55c4a5f8819f741e70a44c31fca75218a65d1f88d503367f213c9e31.png)\n\nOur intuition tells us that if we place a **fulcrum** (i.e., a balancing point) at the *midpoint* between the two masses, the rod will tip down at the right end, as shown below.\n\n![](images/93/93e4ca7726e4c01793440e23823622d19ec284104e5a062af40a6b35407d410d.png)\n\nTo balance the rod perfectly, we must move the fulcrum closer to the larger mass. \n\n![](images/00/00fb578163a19566869582929dfe9dc351ed3b75c44221f8d3e68157f40f08f7.png)\n\nAt what distance from the first mass ($d_1$ in the picture) should the fulcrum be placed for the masses to balance perfectly?\n\nTo answer this, we must introduce the concept of a **moment**:\n\n*The moment of a mass about a point $P$ equals the product of the mass and its displacement from $P.$*\n\nNote the following:\n\n- Loosely speaking, moment describes the amount of *turning effect* produced by a mass about a point (usually the tip of the fulcrum).\n\n- For masses measured in kilograms and distances in meters, the units of a moment are $\\textrm{kg}\\cdot\\textrm m.$\n\n- Moment is a *vector* quantity. A moment is either *positive* (representing *clockwise* induced motion) or *negative* (for *counterclockwise* motion). A moment's sign (positive/clockwise or negative/counterclockwise) is determined by the direction the rod would rotate if the corresponding mass were the only mass in the system.\n\nLet's now see how to use moments to calculate the required distance $d_1.$" :db/ensure [:tutorial/validate]} {:db/id 17592186130478 :tutorial/content "Suppose we have a collection of masses $m_1,m_2,\\ldots,m_n$ located at $x_1,x_2,\\ldots,x_n$ along the $x$-axis. \n\nThe system's **center of mass** is the point $\\bar{x}$ on the $x$-axis where the system's total mass could be concentrated to give the same total moment as the original system. \n\n![](images/e2/e2d7dcb177010f0105d7887e14b84e52527381caa17ca01b91027db6d6cd40a7.png)\n\n \n\nLet's derive the equation for the center of mass $\\bar{x}$ for this system.\n\nThe total moment of the distributed masses about the origin is given by\n\n$$\n\\begin{aligned}{M}_{O}={\\sum }_{i=1}^{n}{m}_{i}{x}_{i}.\\end{aligned}\n$$\n\nIf the total mass of the system is\n\n$$\nm = m_1+m_2+\\cdots m_n = \\sum_{i=1}^n m_i ,\n$$\n\nthen the total moment about the origin of the single mass $m$ located at $\\bar{x}$ equals\n\n$$\nm \\bar{x}.\n$$\n\nEquating our two moments, we get\n\n$$\nM_O = m \\bar{x}.\n$$\n\nSolving for $\\bar{x}$, we have\n\n$$\n\\bar{x} = \\dfrac{M_O}{m}.\n$$\n\n \n\nThe center of mass is an important physical quantity, as it gives the location where a fulcrum would need to be placed for the system to balance perfectly." :db/ensure [:tutorial/validate]} {:db/id 17592186130479 :tutorial/content "When a collection of masses is distributed in two or more dimensions of space, we must take moments about a fixed **axis.**\n\nIn the following work, we will only consider moments about the coordinate axes. \n\nConsider the collection of point masses below, where the distances along the $x$- and $y$-axes are measured in meters. \n\n![](images/32/32f9c207b835469dba729e3d5745dd1225eed6153aac4517e2c40e61b7edb126.png)\n\nThe center of mass of this two-dimensional system, denoted $(\\overline{x}, \\overline{y}),$ is the point where the entire mass of the system could be concentrated to give the same total moment about the $x$- and $y$-axes as the original system. \n\nMore precisely, the center of mass of a collection of point masses $m_1,m_2,\\ldots,m_n$ located at $(x_1,y_1),(x_2,y_2),\\ldots,(x_n,y_n)$ in the plane is given by \n\n$$\n(\\overline{x},\\overline{y}) = \\left(\\dfrac{M_y}{m},\\dfrac{M_x}{m}\\right),\n$$\n\n \nwhere \n\n- $\\displaystyle m = \\sum\\limits_{i=1}^n m_i$ is the total mass of the system,\n\n- $\\displaystyle M_x = \\sum_{i=1}^n m_i y_i$ is the total moment of the system about the $x$-axis, and\n\n- $\\displaystyle M_y = \\sum_{i=1}^n m_i x_i$ is the total moment of the system about the $y$-axis.\n\nLet's compute $\\bar{x},$ the $x$-coordinate of the center of mass for this system. \n\nFirst, we denote the masses as\n\n$$\nm_1 = 3, \\qquad m_2 = 5, \\qquad m_3 = 4.\n$$\n\nThen, the corresponding $x$-coordinates of these masses are\n\n$$\nx_1 = -2, \\qquad x_2 = -1, \\qquad x_3 = 4.\n$$\n\nSo, the total mass of the system is\n\n$$\n\\begin{aligned}m & ={\\sum }_{i=1}^{n}{m}_{i} \\\\  & ={m}_{1}+{m}_{2}+{m}_{3} \\\\  & =3+5+4 \\\\  & =12\\,\\text{kg}\\end{aligned}\n$$\n\nand the moment of the system about the $\\boldsymbol y$**-axis** is\n\n$$\n\\begin{aligned}{M}_{y} & ={\\sum }_{i=1}^{n}{m}_{i}{x}_{i} \\\\  & ={m}_{1}{x}_{1}+{m}_{2}{x}_{2}+{m}_{3}{x}_{3} \\\\  & =3\\cdot (-2)+5\\cdot (-1)+4\\cdot 4 \\\\  & =-6-5+16 \\\\  & =5.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\overline{x} = \\dfrac{M_y}{m} = \\dfrac{5}{12}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186129368 :activity/expected-seconds 840.0 :db/ensure [:activity/validate]}]
