}0 & \\,\\,-1 & 0 \\\\ 0 & \\,\\,-1 & 0 \\\\ 1 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}1-\\lambda  & 0 & 1 \\\\ 0 & 2-\\lambda  & 0 \\\\ 1 & 0 & 1-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )|\\begin{aligned}2-\\lambda  & 0 \\\\ 0 & 1-\\lambda \\end{aligned}|+|\\begin{aligned}0 & 2-\\lambda  \\\\ 1 & 0\\end{aligned}| & =0 \\\\ (1-\\lambda )(2-\\lambda )(1-\\lambda )-(2-\\lambda ) & =0 \\\\ (2-\\lambda )((1-\\lambda )(1-\\lambda )-1) & =0 \\\\ (2-\\lambda )({\\lambda }^{2}-2\\lambda ) & =0 \\\\ \\lambda (2-\\lambda )^{2} & =0 \\\\ \\lambda  & =2,\\,2,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{2} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{2} \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186404787 :knowledge-point/_questions [{:db/id #edb/ref 17592186184199 :knowledge-point/id #uuid "e70dec8f-9828-5fe7-bdb7-47e6557fc889" :knowledge-point/title "Finding the Singular Values of a Rectangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "684d0d7c-6c21-5d44-b7c3-71eab50414a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5,\\,3,\\,0" :db/id #edb/ref 17592186404789} {:answer/id #uuid "1cb76c1a-945d-5de9-8a45-072766c1ef8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3},\\,1,\\,0" :db/id #edb/ref 17592186404790} {:answer/id #uuid "b7a6892e-2b71-58c4-8195-ae2ebdcda46b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5},\\,2,\\,0" :db/id #edb/ref 17592186404791} {:answer/id #uuid "caa0c8c7-3e7b-52f8-87b0-6d3a1f9c7