 \\\\ 1 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 1 \\\\ -1 & -4\\end{aligned}][\\begin{aligned}4 & -1 \\\\ 1 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}17 & -8 \\\\ -8 & 17\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}17-\\lambda  & -8 \\\\ -8 & 17-\\lambda \\end{aligned}| & =0 \\\\ (17-\\lambda )(17-\\lambda )-64 & =0 \\\\ {\\lambda }^{2}-34\\lambda +289-64 & =0 \\\\ {\\lambda }^{2}-34\\lambda +225 & =0 \\\\ (\\lambda -9)(\\lambda -25) & =0 \\\\ \\lambda  & =25,\\,9\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{25}=5 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{9}=3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186415574 :knowledge-point/_questions [{:db/id #edb/ref 17592186184198 :knowledge-point/id #uuid "e2bf7196-b681-5ff6-bf16-24acefa04e6c" :knowledge-point/title "Finding the Singular Values of a Square Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22fab31e-219e-5d18-813a-a8d06acc3248" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4,\\,1,\\,0" :db/id #edb/ref 17592186415548} {:answer/id #uuid "7f5778c2-893f-5035-ae58-7208c5dc0a69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4,\\,1,\\,1" :db/id #edb/ref 17592186415556} {:answer/id #uuid "8e8616be-5d4c-5647-8715-109f64e7adf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2,\\,2,\\,0" :db/id #edb/ref 17592186415558} {:answer/id #uuid "c1276a11-417f-5453-89d9-104681d36b19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8,\\,4,\\,0" :db/id #edb/ref 17592186415563} {:answer/id #uuid "cf324114-3726-57f4-b073-13b1533f0488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2,\\,1,\\,0" :db/id #edb/ref 17592186415565}] :answer-field/correct {:answer/id #uuid "cf324114-3726-57f4-b073-13b1533f0488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2,\\,1,\\,0" :db/id #edb/ref 17592186415565} :answer-field/id #uuid "2503f0e3-6a58-532b-b8da-6c772b852974" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415569}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2512d16d-c375-5bf3-9c3b-0ab4d79702bf" :question/math-academy-id "q-95374" :question/problem "What are the singular values of the matrix $A=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{aligned}]?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{aligned}]}^{T}[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & -1 & -1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & -2 \\\\ 0 & -2 & 2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}1-\\lambda  & 0 & 0 \\\\ 0 & 2-\\lambda  & -2 \\\\ 0 & -2 & 2-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )|\\begin{aligned}2-\\lambda  & -2 \\\\ -2 & 2-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )((2-\\lambda )(2-\\lambda )-4) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-4\\lambda ) & =0 \\\\ -\\lambda (\\lambda -1)(\\lambda -4) & =0 \\\\ \\lambda  & =4,\\,1,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{4}=2 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186415577 :knowledge-point/_questions [{:db/id #edb/ref 17592186184199 :knowledge-point/id #uuid "e70dec8f-9828-5fe7-bdb7-47e6557fc889" :knowledge-point/title "Finding the Singular Values of a Rectangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f16480c-d86a-5db9-b802-4ced71c8377c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5},\\,2,\\,0" :db/id #edb/ref 17592186415549} {:answer/id #uuid "5febb191-7c5d-5f4e-82d6-efc23b4d4485" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16,\\,9,\\,0" :db/id #edb/ref 17592186415551} {:answer/id #uuid "73c9cf54-1f9b-52f1-b8ed-dd9e193c12b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186415555} {:answer/id #uuid "9d3fcfba-14a5-5b55-ba3e-4a632953d6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186415560} {:answer/id #uuid "be6dbb3a-d9f4-5182-87d2-f89ac41af4ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5,\\,3,\\,0" :db/id #edb/ref 17592186415562}] :answer-field/correct {:answer/id #uuid "9d3fcfba-14a5-5b55-ba3e-4a632953d6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186415560} :answer-field/id #uuid "b838eb18-ab2d-5fe6-b6c3-92ea8e153a8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415573}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ba2e577-1f2d-586f-a5db-7d03c7c71c22" :question/math-academy-id "q-95375" :question/problem "What are the singular values of the matrix $A=[\\begin{aligned}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{aligned}]?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{aligned}]}^{T}[\\begin{aligned}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ -1 & 2 \\\\ 2 & 0\\end{aligned}][\\begin{aligned}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 4 & 0 \\\\ 4 & 5 & -2 \\\\ 0 & -2 & 4\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}4-\\lambda  & 4 & 0 \\\\ 4 & 5-\\lambda  & -2 \\\\ 0 & -2 & 4-\\lambda \\end{aligned}| & =0 \\\\ (4-\\lambda )|\\begin{aligned}5-\\lambda  & -2 \\\\ -2 & 4-\\lambda \\end{aligned}|-4|\\begin{aligned}4 & -2 \\\\ 0 & 4-\\lambda \\end{aligned}| & =0 \\\\ (4-\\lambda )[(5-\\lambda )(4-\\lambda )-4)]-16(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda +16)-16(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda ) & =0 \\\\ \\lambda (4-\\lambda )(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"}]}
