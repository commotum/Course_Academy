 & \\,\\,-1 & 0 \\\\ 0 & \\,\\,-1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]}^{T}[\\begin{aligned}0 & \\,\\,-1 & 0 \\\\ 0 & \\,\\,-1 & 0 \\\\ 1 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 & 1 \\\\ \\,\\,-1 & \\,\\,-1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}0 & \\,\\,-1 & 0 \\\\ 0 & \\,\\,-1 & 0 \\\\ 1 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}1-\\lambda  & 0 & 1 \\\\ 0 & 2-\\lambda  & 0 \\\\ 1 & 0 & 1-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )|\\begin{aligned}2-\\lambda  & 0 \\\\ 0 & 1-\\lambda \\end{aligned}|+|\\begin{aligned}0 & 2-\\lambda  \\\\ 1 & 0\\end{aligned}| & =0 \\\\ (1-\\lambda )(2-\\lambda )(1-\\lambda )-(2-\\lambda ) & =0 \\\\ (2-\\lambda )((1-\\lambda )(1-\\lambda )-1) & =0 \\\\ (2-\\lambda )({\\lambda }^{2}-2\\lambda ) & =0 \\\\ \\lambda (2-\\lambda )^{2} & =0 \\\\ \\lambda  & =2,\\,2,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{2} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{2} \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186404781 #edb/ref 1075 #edb/ref 17592186404782 #edb/ref 17592186045417] [17592186404781 #edb/ref 1075 #edb/ref 17592186404783 #edb/ref 17592186045417] [17592186404781 #edb/ref 1075 #edb/ref 17592186404784 #edb/ref 17592186045417] [17592186404781 #edb/ref 1075 #edb/ref 17592186404785 #edb/ref 17592186045417] [17592186404781 #edb/ref 1075 #edb/ref 17592186404786 #edb/ref 17592186045417] [17592186404781 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186404781 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186404781 #edb/ref 1078 #edb/ref 17592186404785 #edb/ref 17592186045417] [17592186404781 #