 v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)({{field-4}}){|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }(-\\frac{1}{s}{e}^{-st}){A}^{′}(t)\\,dt\\end{aligned}\n$$\n\nSince $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=$ {{field-5}}, we have\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & ={{field-6}}.\\end{aligned}\n$$" :question/worked-solution "Let $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ & =A(τ)\\,{|}_{0}^{t} \\\\  & =A(t)-A(0) \\\\  & =A(t).\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\} & =L\\{A(t)\\}={\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & \\,⇒\\, & du={A}^{′}(t)\\,dt \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }(-\\frac{1}{s}{e}^{-st}){A}^{′}(t)\\,dt.\\end{aligned}\n$$\n\nSince $A(0)=0$ and $\\frac{1}{s}{e}^{-st}\\to 0$ as $t\\to \\infty ,$ we have $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=0$ and\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{1}{s}\\cdot F(s) \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5170c363-4e67-51f6-b130-fd0a17a1796b" "answer-field-6da3b0d3-6b5c-5e60-962c-307a26bf1c26" "answer-field-1857e8b9-447f-5c15-8cd4-31d3203930a4" "answer-field-c1998247-feae-5761-8354-c898923b4ac3" "answer-field-16585d61-f1b2-5fe2-834a-db1e07b8788c" "answer-field-b42be66f-2f5e-5b5e-8bde-f1bb580ea2f4"] :db/ensure [:question/validate]} {:db/id "answer-field-5170c363-4e67-51f6-b130-fd0a17a1796b" :answer-field/id #uuid "5170c363-4e67-51f6-b130-fd0a17a1796b" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-c657a7f0-11d1-5c9d-a1da-31ea2243162e" :answer-field/choices ["answer-6def77f9-265b-55f8-a802-3f3511668bde" "answer-c657a7f0-11d1-5c9d-a1da-31ea2243162e" "answer-cfcfa0df-1647-55a9-9c87-1e03313e3e34"] :db/ensure [:answer-field/validate]} {:db/id "answer-6def77f9-265b-55f8-a802-3f3511668bde" :answer/id #uuid "6def77f9-265b-55f8-a802-3f3511668bde" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-c657a7f0-11d1-5c9d-a1da-31ea2243162e" :answer/id #uuid "c657a7f0-11d1-5c9d-a1da-31ea2243162e" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-cfcfa0df-1647-55a9-9c87-1e03313e3e34" :answer/id #uuid "cfcfa0df-1647-55a9-9c87-1e03313e3e34" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-6da3b0d3-6b5c-5e60-962c-307a26bf1c26" :answer-field/id #uuid "6da3b0d3-6b5c-5e60-962c-307a26bf1c26" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-39c02819-40bd-5059-a783-65b80eec32c3" :answer-field/choices ["answer-39c02819-40bd-5059-a783-65b80eec32c3" "answer-193f22df-b786-5f14-a1f2-c1ec092974ab" "answer-e66def89-4cf0-5306-8e47-60a16d37e49a"] :db/ensur