70-fd5c-52bf-8d60-a3a53e6b049c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F(s)" :db/id #edb/ref 17592186441962}] :answer-field/correct {:answer/id #uuid "33c2a665-68e3-5397-aad1-394033317b09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{F(s)}{s}" :db/id #edb/ref 17592186441951} :answer-field/id #uuid "b42be66f-2f5e-5b5e-8bde-f1bb580ea2f4" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186442014} {:answer-field/choices [{:answer/id #uuid "2202e53c-8362-54c1-a712-585510d9289a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{s}{e}^{-st}" :db/id #edb/ref 17592186441944} {:answer/id #uuid "244f06ac-0ae7-5008-8b27-bc7253233120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{t}{e}^{-st}" :db/id #edb/ref 17592186441945} {:answer/id #uuid "3a91e5a1-a660-55f2-baab-40111b102a41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{t}{e}^{-st}" :db/id #edb/ref 17592186441957} {:answer/id #uuid "c02bcd62-55f7-5751-8615-61871609fdcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s}{e}^{-st}" :db/id #edb/ref 17592186441984}] :answer-field/correct {:answer/id #uuid "2202e53c-8362-54c1-a712-585510d9289a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{s}{e}^{-st}" :db/id #edb/ref 17592186441944} :answer-field/id #uuid "c1998247-feae-5761-8354-c898923b4ac3" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186442017}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72ddd4c8-8e72-5f66-b964-d1ec00d699bb" :question/math-academy-id "q-331053" :question/problem "Suppose we wish to find $L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}$ given $L\\{f(t)\\}=F(s)$ for $s>{s}_{0}.$ Select the correct options in the reasoning below.\n\nLet $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=$  {{field-1}}. Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ=A(τ)\\,{|}_{0}^{t}=A(t).\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}=L\\{{{field-2}}\\}={\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & ⇒ & du={{field-3}} \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)({{field-4}}){|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }(-\\frac{1}{s}{e}^{-st}){A}^{′}(t)\\,dt\\end{aligned}\n$$\n\nSince $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=$ {{field-5}}, we have\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & ={{field-6}}.\\end{aligned}\n$$" :question/worked-solution "Let $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ & =A(τ)\\,{|}_{0}^{t} \\\\  & =A(t)-A(0) \\\\  & =A(t).\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\} & =L\\{A(t)\\}={\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & \\,⇒\\, & du={A}^{′}(t)\\,dt \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }(-\\frac{1}{s}{e}^{-st}){A}^{′}(t)\\,dt.\\end{aligned}\n$$\n\nSince $A(0)=0$ and $\\frac{1}{s}{e}^{-st}\\to 0$ as $t\\to \\infty ,$ we have $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=0$ and\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{1}{s}\\cdot F(s) \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186442021 :knowledge-point/_questions [{:db/id #edb/ref 17592186221432 :knowledge-point/id #uuid "51dfecdb-ad66-5e07-8873-ca8e116b27bd" :knowledge-point/title "Proving the Formula for Laplace Transforms of Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b991022-71e3-511d-bc60-1c00da984bcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{e}^{st}\\text{ }dt" :db/id #edb/ref 17592186441976} {:answer/id #uuid "9be9cec4-a70c-5f29-bfdb-e851e013edfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-st}\\text{ }dt" :db/id #edb/ref 17592186441977}] :answer-field/correct {:answer/id #uuid "9be9cec4-a70c-5f29-bfdb-e851e013edfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-st}\\text{ }dt" :db/id #edb/ref 17592186441977} :answer-field/id #uuid "6a91cc8a-1893-57a4-ab18-b6701b21fd12" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186442008} {:answer-field/choices [{:answer