m/s}" :db/id #edb/ref 17592186414195} {:answer/id #uuid "74489a4f-0f2e-5d3d-b8ce-522969cbe4d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{3}\\text{ m/s}" :db/id #edb/ref 17592186414198} {:answer/id #uuid "a14dcc4c-31b8-57fe-9ac6-4fcf63038a6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}\\text{ m/s}" :db/id #edb/ref 17592186414205} {:answer/id #uuid "d93d225c-e122-533c-8881-688bb8703984" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{3}\\text{ m/s}" :db/id #edb/ref 17592186414212}] :answer-field/correct {:answer/id #uuid "d93d225c-e122-533c-8881-688bb8703984" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{3}\\text{ m/s}" :db/id #edb/ref 17592186414212} :answer-field/id #uuid "bba5b4d7-4309-5292-8088-c53e4d246dcb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414221}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a62921c3-0ad7-5f20-8061-cad8dd0b028d" :question/math-academy-id "q-97641" :question/problem "An object moves along a circular path with position $r(t)=\\sqrt{3}\\operatorname{cos}⁡4t\\,i+\\sqrt{3}\\operatorname{sin}⁡4t\\,j$ meters. Find the speed of the object at time $t,$ measured in seconds." :question/worked-solution "**Method 1**\n\nFirst, we find the velocity vector by differentiating the position vector. We get\n\n$$\n\\begin{aligned}v(t) & =(r(t))^{′} \\\\  & =(\\sqrt{3}\\operatorname{cos}⁡4t\\,i+\\sqrt{3}\\operatorname{sin}⁡4t)^{′} \\\\  & =-4\\sqrt{3}\\operatorname{sin}⁡4t\\,i+4\\sqrt{3}\\operatorname{cos}⁡4t\\,j.\\end{aligned}\n$$\n\nTo find the speed, we calculate the magnitude of the velocity vector, as follows:\n\n$$\n\\begin{aligned}||v(t)|| & =\\sqrt{(-4\\sqrt{3}\\operatorname{sin}⁡4t)^{2}+(4\\sqrt{3}\\operatorname{cos}⁡4t)^{2}} \\\\  & =\\sqrt{48{sin}^{2}⁡4t+48{cos}^{2}⁡4t} \\\\  & =\\sqrt{48({sin}^{2}⁡4t+{cos}^{2}⁡4t)} \\\\  & =4\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the speed of the object is $4\\sqrt{3}\\text{ m/s}.$\n\nNote that the speed is constant, but the velocity is not. \n\n**Method 2**\n\nFor uniform circular motion in the $xy$-plane, we have\n\n$$\n||v||=R|\\omega |,\n$$\n\nwhere $R$ is the radius of the circle, and $\\omega $ is the angular velocity.\n\nIn our case, the radius of the circle is $R=\\sqrt{3}\\,\\text{m}$ and the angular frequency $\\omega =4\\,\\text{rad/s}.$ Therefore,\n\n$$\n||v||=\\sqrt{3}\\cdot |4|=4\\sqrt{3}\\text{ m/s}.\n$$"}] [{:db/id #edb/ref 17592186414225 :knowledge-point/_questions [{:db/id #edb/ref 17592186172046 :knowledge-point/id #uuid "17787055-19de-5dca-b1f9-e97a3a7c2aff" :knowledge-point/title "Finding the Acceleration of a Particle Moving With Circular Motion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "126ae55a-4a80-5260-86e9-62365c375f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186414188} {:answer/id #uuid "3e7e470c-cb69-5444-a607-ccc44143b6f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186414191} {:answer/id #uuid "82f2b053-c9f0-50de-95d9-735df747f7c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186414200} {:answer/id #uuid "d2ef61b8-9ee3-5679-99e0-7100e1e56454" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186414210} {:answer/id #uuid "ef9ccac3-25f9-53ec-a5de-8b587099fa5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186414213}] :answer-field/correct {:answer/id #uuid "d2ef61b8-9ee3-5679-99e0-7100e1e56454" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186414210} :answer-field/id #uuid "3b486493-d623-5a70-9e04-14e7a723162e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414218}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a71f6e18-3665-5500-82e7-6236632d7d47" :question/math-academy-id "q-97667" :question/problem "An object moves along a circular path with position $r(t)=2(\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j)$ meters. Find the magnitude of the acceleration of the object at time $t,$ measured in seconds." :question/worked-solution "**Method 1**\n\nFirst, we find the velocity vector by differentiating the position vector. We get\n\n$$\n\\begin{aligned}v(t) & =(r(t))^{′} \\\\  & =(2(\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j))^{′} \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j\\end{aligned}\n$$\n\nThen, we find the acceleration vector by differentiating the velocity vector. \n\n$$\n\\begin{aligned}a(t) & =(v(t))^{′} \\\\  & =(-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j)^{′} \\\\  & =-2\\operatorname{cos}⁡t\\,i-2\\operatorname{sin}⁡t\\,j.\\end{aligned}\n$$\n\nFinally, we calculate the magnitude of the acceleration as follows:\n\n$$\n\\begin{aligned}||a(t)|| & =\\sqrt{(-2\\operatorname{cos}⁡t)^{2}+(-2\\operatorname{sin}⁡t)^{2}} \\\\  & =\\sqrt{4{cos}^{2}⁡t+4{sin}^{2}⁡t} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the magnitude of the acceleration is $2\\,{\\text{m/s}}^{2}.$\n\nNote that $||a||$ is constant, but $a$ is not. \n\n**Method 2**\n\nFor uniform circular motion in the $xy$-plane, we have\n\n$$\na=-{\\omega }^{2}r\\,⇒\\,||a||={\\omega }^{2}||r||.\n$$\n\nIn our case, the radius of the circle is $a=2\\,\\text{m}$ and the angular frequency $\\omega =1\\,\\text{rad/s}.$ Therefore,\n\n$$\n||a||={1}^{2}\\cdot 2=2\\,{\\text{m/s}}^{2}.\n$$"}] [{:db/id #edb/ref 17592186414223 :knowledge-point/_questions [{:db/id #edb/ref 17592186172046 :knowledge-point/id #uuid "17787055-19de-5dca-b1f9-e97a3a7c2aff" :knowledge-point/title "Finding the Acceleration of a Particle Moving With Circular Motion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c31bcf8-56dc-552c-82e1-a8f67c126734" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186414187} {:answer/id #uuid "4eb2dfc5-f3e1-5fac-9360-84971d459fb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186414193} {:answer/id #uuid "924e4d02-78b5-5671-b9e0-e9d2328dc287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186414201} {:answer/id #uuid "93fbaf52-d067-5773-b619-d86ddfbfd800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186414203} {:answer/id #uuid "f56becbb-9dcc-5d4f-a4dc-2fba708f2c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186414214}] :answer-field/correct {:answer/id #uuid "f56becbb-9dcc-5d4f-a4dc-2fba708f2c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186414214} :answer-field/id #uuid "3ce185f1-3680-5849-be4c-996d545fcfb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414219}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6774c327-b1ba-5269-8425-5f0d3e5c0aaa" :question/math-academy-id "q-97669" :question/problem "An object moves along a circular path with position $r(t)=2(\\operatorname{cos}⁡5t\\,i+\\operatorname{sin}⁡5t\\,j)$ meters. Find the magnitude of the acceleration of the object at time $t,$ measured in seconds." :question/worked-solution "**Method 1**\n\nFirst, we find the velocity vector by differentiating the position vector. We get\n\n$$\n\\begin{aligned}v(t) & =(r(t))^{′} \\\\  & =(2(\\operatorname{cos}⁡5t\\,i+\\operatorname{sin}⁡5t\\,j))^{′} \\\\  & =-10\\operatorname{sin}⁡5t\\,i+10\\operatorname{cos}⁡5t\\,j\\end{aligned}\n$$\n\nThen, we find the acceleration vector by differentiating the velocity vector. \n\n$$\n\\begin{aligned}a(t) & =(v(t))^{′} \\\\  & =(-10\\operatorname{sin}⁡5t\\,i+10\\operatorname{cos}⁡5t\\,j)^{′} \\\\  & =-50\\operatorname{cos}⁡5t\\,i-50\\operatorname{sin}⁡5t\\,j.\\end{aligned}\n$$\n\nFinally, we calculate the magnitude of the acceleration as follows:\n\n$$\n\\begin{aligned}||a(t)|| & =\\sqrt{(-50\\operatorname{cos}⁡5t)^{2}+(-50\\operatorname{sin}⁡5t)^{2}} \\\\  & =\\sqrt{{50}^{2}{cos}^{2}⁡5t+{50}^{2}{sin}^{2}⁡5t} \\\\  & =\\sqrt{{50}^{2}} \\\\  & =50\\end{aligned}\n$$\n\nTherefore, the magnitude of the acceleration is $50\\,{\\text{m/s}}^{2}.$\n\nNote that $||a||$ is constant, but $a$ is not. \n\n**Method 2**\n\nFor uniform circular motion in the $xy$-plane, we have\n\n$$\na=-{\\omega }^{2}r\\,⇒\\,||a||={\\omega }^{2}||r||.\n$$\n\nIn our case, the radius of the circle is $a=2\\,\\text{m}$ and the angular frequency $\\omega =5\\,\\text{rad/s}.$ Therefore,\n\n$$\n||a||={5}^{2}\\cdot 2=50\\,{\\text{m/s}}^{2}.\n$$"}]}
