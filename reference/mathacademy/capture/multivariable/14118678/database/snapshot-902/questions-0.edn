orname{sin}⁡\\frac{t}{4}\\,j.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186414226 :knowledge-point/_questions [{:db/id #edb/ref 17592186172044 :knowledge-point/id #uuid "eb1745c5-6485-5a9d-9e8f-19492928e4b4" :knowledge-point/title "Finding the Position Function of an Object Moving With Circular Motion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c30bb07-72a4-5565-8468-407beb723740" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=4(\\operatorname{cos}⁡9t\\,i+\\operatorname{sin}⁡9t\\,j)" :db/id #edb/ref 17592186414192} {:answer/id #uuid "7099fb71-cfb9-5667-9c1d-abef4c2a8aa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=4(\\operatorname{cos}⁡9t\\,i-\\operatorname{sin}⁡9t\\,j)" :db/id #edb/ref 17592186414197} {:answer/id #uuid "96a4c154-63c8-5129-8a57-787e1d065082" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=9(\\operatorname{cos}⁡4t\\,i-\\operatorname{sin}⁡4t\\,j)" :db/id #edb/ref 17592186414204} {:answer/id #uuid "bf5777b7-1448-5d2a-b0b0-a3758610ba8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=-9(\\operatorname{cos}⁡4t\\,i+\\operatorname{sin}⁡4t\\,j)" :db/id #edb/ref 17592186414207} {:answer/id #uuid "d1b8a56f-3561-5330-b6e7-4fd473165781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=9(\\operatorname{cos}⁡4t\\,i+\\operatorname{sin}⁡4t\\,j)" :db/id #edb/ref 17592186414209}] :answer-field/correct {:answer/id #uuid "96a4c154-63c8-5129-8a57-787e1d065082" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r(t)=9(\\operatorname{cos}⁡4t\\,i-\\operatorname{sin}⁡4t\\,j)" :db/id #edb/ref 17592186414204} :answer-field/id #uuid "eb6d2d2c-d5c5-59c6-8a10-7880e9a9bc99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/r