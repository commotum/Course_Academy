    "q-221400": {
      "dom_id": "step-q221400",
      "name": "Question 7",
      "problem": "Let $l,m,$ and $n$ be integers. If $l∣mn$ and $\\text{gcd}(l,n)=1$ then{{field-1}}.",
      "worked_solution": "For any integers $l,$ $m,$ and $n,$ we have that\n\n$$\nl∣mn\\,\\text{and}\\,\\text{gcd}(l,n)=1\\,⟹\\,l∣m.\n$$",
