            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-93657-b",
              "type": "text",
              "value": "I only",
              "html": "I only"
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-93657-c",
              "type": "text",
              "value": "II only",
              "html": "II only"
            },
            {
              "option": "d",
              "dom_id": "questionWidget-choiceLetterCircle-93657-d",
              "type": "text",
              "value": "III only",
              "html": "III only"
