h=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n</tr>\n\n<tr>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; border-right: hidden; padding: 0\">$-$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; border-right: hidden; padding: 0\">$3x^3$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; border-right: hidden; padding: 0\">$+$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; border-right: hidden; padding: 0\">$2x^2$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n</tr>\n\n<tr style=\"border: 1.5px solid\">\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"