=\"text-align:center; border-right: hidden; border-right: hidden; padding: 0\">$6x$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; border-right: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; border-right: hidden; padding: 0\"></td>\n</tr>\n\n<tr style=\"border: 1.5px solid\">\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-top: hidden; border-right: hidden; padding: 0\">$11x^2$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-top: hidden; border-right: hidden; padding: 0\">$+$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-top: hidden; border-right: hidden; padding: 0\">$33x$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-top: hidden; border-right: hidden; padding: 0\">$-$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-top: hidden; border-right: hidden; padding: 0\">$22$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n</tr>\n\n<tr>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; border-right: hidden; padding: 0\">$-$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; border-right: hidden; padding: 0\">$39x$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; border-right: hidden; padding: 0\">$+$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border-right: hidden; border-right: hidden; padding: 0\">$22$</td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n<td width=\"20\" height=\"20\" style=\"text-align:center; border: hidden; padding: 0\"></td>\n</tr>\n\n</table>\n\n\n<p>Therefore, we can write $x^4$ as </p>\n<p>\\begin{align}\n\tx^4 &= q(x)p(x) + (-39x+22),\n\\end{align}\nwhere $q(x) = x^2-3x+11.$  Replacing $x$ with $A,$ we have</p>\n<p>\\[\nA^4 = q(A)p(A) + (-39A+22I). \n\\]</p>\n<p>Now, according to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,</p>\n<p>\\begin{align}\nA^4 \n&= q(A)p(A)+ (-39A+22I) \\\\[5pt]\n&= q(A)\\cdot O+ (-39A+22I) \\\\[5pt]\n&= -39A+22I.\n\\end{align}</p>\n","topic":{"id":1972,"name":"The Cayley-Hamilton Theorem"},"example":{"id":5512,"title":"Evaluating a Matrix Polynomial Using the Cayley-Hamilton Theorem"},"group":{"id":12824,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14274469,"answer":{"id":62411519,"cread":"2026-10-16T23:54:51.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":12820},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}}],"completedStr":"Completed on Fri, Oct 16th","l