(bt)p+\\operatorname{cos}⁡(bt)q).\\end{aligned}\n$$\n\nTherefore, the general solution of the system is\n\n$$\n\\text{x}(t)={c}_{1}{e}^{at}(\\operatorname{cos}⁡(bt)p-\\operatorname{sin}⁡(bt)q)+{c}_{2}{e}^{at}(\\operatorname{sin}⁡(bt)p+\\operatorname{cos}⁡(bt)q),\n$$\n\nwhere the parts $(\\operatorname{cos}⁡(bt)p-\\operatorname{sin}⁡(bt)q)$ and $(\\operatorname{sin}⁡(bt)p+\\operatorname{cos}⁡(bt)q)$ are bounded.\n\nNow, notice that the given curve is $\\text{bounded}$ (and closed), representing $\\text{an ellipse}$ that is traversed $\\text{counterclockwise}.$\n\nBut we have that:\n\n- ${e}^{at}\\to \\infty $ as $t\\to \\infty $ when $a>0,$ and\n\n- ${e}^{at}\\to 0$ as $t\\to \\infty $ when $a<0.$\n\nThus, we must have $a=0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-89b392be-6bfe-5887-a4ae-2c2f7f38f0c4" "answer-field-67fe24b1-f8bf-5e58-ba73-46d45bbacc6e" "answer-field-b43329db-c49b-5cae-a0d0-88d411d89292" "answer-field-e3854fdb-754f-5225-8e33-2513e7fb53ca"] :db/ensure [:question/validate]} {:db/id "answer-field-89b392be-6bfe-5887-a4ae-2c2f7f38f0c4" :answer-field/id #uuid "89b392be-6bfe-5887-a4ae-2c2f7f38f0c4" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-1603c7b9-db79-5f4e-aaaa-8db20bd28197" :answer-field/choices ["answer-1603c7b9-db79-5f4e-aaaa-8db20bd28197" "answer-c6235c16-97de-5d7d-9ce8-5b49098e30d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-1603c7b9-db79-5f4e-aaaa-8db20bd28197" :answer/id #uuid "1603c7b9-db79-5f4e-aaaa-8db20bd28197" :answer/type :answer.type/text :answer/value "bounded" :db/ensure [:answer/validate]} {:db/id "answer-c6235c16-97de-5d7d-9ce8-5b49098e30d8" :answer/id #uuid "c6235c16-97de-5d7d-9ce8-5b49098e30d8" :answer/type :answer.type/text :answer/value "unbounded" :db/ensure [:answer/validate]} {:db/id "answer-field-67fe24b1-f8bf-5e58-ba73-46d45bbacc6e" :answer-field/id #uuid "67fe24b1-f8bf-5e58-ba73-46d45bbacc6e" :answer-field/key 