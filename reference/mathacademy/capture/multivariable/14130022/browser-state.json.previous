Menu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"329\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"367\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"406\" style=\"font-size: 119.5%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi><mo>,</mo></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container> the curve\n<div id=\"selectList-333752-4\" class=\"selectList\" style=\"margin: 0px 2px 2px 4px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-333752-4\" style=\"width: 87px; height: 17px; line-height: 17px;\">converges</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 523px; top: 8492px;\"><div class=\"selectListOption selected\" style=\"height: 17px;\">converges</div><div class=\"selectListOption\" style=\"height: 17px;\">diverges</div></div></div>.\nSo, we have\n<div id=\"selectList-333752-5\" class=\"selectList\" style=\"margin: 0px 4px 2px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-333752-5\" style=\"width: 81px; height: 17px; line-height: 17px;\">a spiral</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 727px; top: 8492px;\"><div class=\"selectListOption\" style=\"height: 17px;\">an ellipse</div><div class=\"selectListOption selected\" style=\"height: 17px;\">a spiral</div></div></div>\nthat is traversed \n<div id=\"selectList-333752-6\" class=\"selectList\" style=\"margin: 0px 2px 2px 4px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-333752-6\" style=\"width: 132px; height: 17px; line-height: 17px;\">counterclockwise</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 374px; top: 8527px;\"><div class=\"selectListOption selected\" style=\"height: 17px;\">counterclockwise</div><div class=\"selectListOption\" style=\"height: 17px;\">clockwise</div></div></div>.</span><span class=\"proofSection\"></span><span class=\"proofSection\"><p></p>The spiral is traversed toward \n<div id=\"selectList-333752-7\" class=\"selectList\" style=\"margin: 0px 4px 2px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-333752-7\" style=\"width: 80px; height: 17px; line-height: 17px;\">the origin</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 575px; top: 8565px;\"><div class=\"selectListOption\" style=\"height: 17px;\">infinity</div><div class=\"selectListOption selected\" style=\"height: 17px;\">the origin</div></div></div>\nas <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"368\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"407\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi><mo>.</mo></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></span><span class=\"proofSection\"></span><span class=\"proofSection\"><p></p>The <div id=\"selectList-333752-8\" class=\"selectList\" style=\"margin: 0px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-333752-8\" style=\"width: 110px; height: 17px; line-height: 17px;\">phase portrait</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 400px; top: 8609px;\"><div class=\"selectListOption\" style=\"height: 17px;\">vector field</div><div class=\"selectListOption selected\" style=\"height: 17px;\">phase portrait</div></div></div> of our system looks as follows:<p></p><div id=\"graphic-6f6b66194eacdb5c33277dd75455942a\" class=\"graphic\"><img src=\"/graphics/6f6b66194eacdb5c33277dd75455942a\"></div></span></div><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div class=\"questionWidget-spinner\" style=\"display: block;\"></div></div><div class=\"questionWidget-result\"><div class=\"questionWidget-correctIncorrectIcon\"><img src=\"/img/green-checkmark.png\"></div><div class=\"questionWidget-correctText\">Partial Credit</div></div><div class=\"questionWidget-explanationHeader\">EXPLANATION</div><div class=\"questionWidget-explanation\"><p>The general solution of the system is\n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"408\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mrow><mjx-mo class=\"mjx-s3\"><mjx-c class=\"mjx-c5B TEX-S3\"></mjx-c></mjx-mo><mjx-mtable style=\"min-width: 1.711em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"padding-bottom: 0.2em;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr><mjx-mtr><mjx-mtd style=\"padding-top: 0.2em;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\