      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14130022/observations/step-q333743-cce48c9c78bbb0b81e8e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14130022/observations/step-q333743-cce48c9c78bbb0b81e8e.png",
      "source_url": "https://mathacademy.com/tasks/14130022/topics/3241/lesson",
