mjx-c32\"></mjx-c><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"195\" style=\"font-size: 119.5%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c36\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0.26</mn></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></div></div></div></td>\n</tr>\n</tbody></table></span><span class=\"proofSection\"></span><span class=\"proofSection\"><p></p>Let's sketch this solution in the phase space.<p></p><div id=\"graphic-74ea13ed7d9d3f4cc0b8c067a1d62e8e\" class=\"graphic\"><img src=\"/graphics/74ea13ed7d9d3f4cc0b8c067a1d62e8e\"></div><p></p>As <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"119\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"157\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"196\" style=\"font-size: 119.5%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi><mo>,</mo></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container> the curve\n<div id=\"selectList-333743-4\" class=\"selectList\" style=\"margin: 0px 2px 2px 4px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-333743-4\" style=\"width: 87px; height: 17px; line-height: 17px;\">diverges</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 523px; top: 5397px;\"><div class=\"selectListOption selected\" style=\"height: 17px;\">diverges</div><div class=\"selectListOption\" style=\"height: 17px;\">converges</div></div></div>.\nSo, we have\n<div id=\"selectList-333743-5\" class=\"selectList\" style=\"margin: 0px 4px 2px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-333743-5\" style=\"width: 81px; height: 17px; line-height: 17px;\">a spiral</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 727px; top: 5397px;\"><div class=\"selectListOption\" style=\"height: 17px;\">an ellipse</div><div class=\"selectListOption selected\" style=\"height: 17px;\">a spiral</div></div></div>\nthat is traversed \n<div id=\"selectList-333743-6\" class=\"selectList\" style=\"margin: 0px 2px 2px 4px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-333743-6\" style=\"width: 132px; height: 17px; line-height: 17px;\">counterclockwise</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 374px; top: 5432px;\"><div class=\"selectListOption\" style=\"height: 17px;\">clockwise</div><div class=\"selectListOption selected\" style=\"height: 17px;\">counterclockwise</div></div></div>.</span><span class=\"proofSection\"></span><span class=\"proofSection\"><p></p>The spiral is traversed toward \n<div id=\"selectList-333743-7\" class=\"selectList\" style=\"margin: 0px 4px 2px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-333743-7\" style=\"width: 80px; height: 17px; line-height: 17px;\">infinity</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 575px; top: 5470px;\"><div class=\"selectListOption\" style=\"height: 17px;\">the origin</div><div class=\"selectListOption selected\" style=\"height: 17px;\">infinity</div></div></div>\nas <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"158\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"197\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D461 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi><mo>.</mo></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></span><span class=\"proofSection\"></span><span class=\"proofSection\"><p></p>The <div id=\"selectList-333743-8\" class=\"selectList\" style=\"margin: 0px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-333743-8\" style=\"width: 110px; height: 17px; line-height: 17px;\">phase portrait</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 400px; top: 5514px;\"><div class=\"selectListOption\" style=\"height: 17px;\">vector field</div><div class=\"selectListOption selected\" style=\"height: 17px;\">phase portrait</div></div></div> of our system looks as follows:<p></p><div id=\"graphic-120f8feac9eed810c50ebca86221f95c\" class=\"graphic\"><img src=\"/graphics/120f8feac9eed810c50ebca86221f95c\"></div></span></div><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div class=\"questionWidget-spinner\" style=\"display: block;\"></div></div><div class=\"questionWidget-result\"><div class=\"questionWidget-correctIncorrectIcon\"><img src=\"/img/green-checkmark.png\"></div><div class=\"questionWidget-correctText\">Correct</div></div><div class=\"questionWidget-explanationHeader\">EXPLANATION</div><div class=