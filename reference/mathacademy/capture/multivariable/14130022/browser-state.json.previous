      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14130022/observations/step-q334300-ff578bb26a3b82c8d2d7.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14130022/observations/step-q334300-ff578bb26a3b82c8d2d7.png",
