69 "q-176865" #edb/ref 17592186045417] [17592186398631 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186398631 #edb/ref 1071 "$\\frac{1}{2}$ is **not** a rational number, or $-2$ is negative.\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:\\frac{1}{2}\\text{ is a rational number}$\n\n- $Q:-2\\text{ is negative}$" #edb/ref 17592186045417] [17592186398631 #edb/ref 1072 #uuid "9b8bbb71-5c94-5fce-b0d2-f79d72a9b4c7" #edb/ref 17592186045417] [17592186398631 #edb/ref 1074 "The sentence\n\n$\\frac{1}{2}$ is **not** a rational number \n\ncan be expressed symbolically as $¬P.$ \n\nThe sentence\n\n$-2$ is negative\n\ncan be expressed symbolically as $Q.$\n\nTherefore, the sentence\n\n$\\frac{1}{2}$ is **not** a rational number, or $-2$ is negative\n\ncan be expressed symbolically as $¬P∨Q.$" #edb/ref 17592186045417] [17592186398632 #edb/ref 1075 #edb/ref 17592186398633 #edb/ref 17592186045417] [17592186398632 #edb/ref 1075 #edb/ref 17592186398634 #edb/ref 17592186045417] [17592186398632 #edb/ref 1075 #edb/ref 17592186398635 #edb/ref 17592186045417] [17592186398632 #edb/ref 1075 #edb/ref 17592186398636 #edb/ref 17592186045417] [17592186398632 #edb/ref 1075 #edb/ref 17592186398637 #edb/ref 17592186045417] [17592186398632 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186398632 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186398632 #edb/ref 1078 #edb/ref 17592186398636 #edb/ref 17592186045417] [17592186398632 #edb/ref 1079 #uuid "4aa8db07-0769-5153-9ab7-dcb3cda6e4d9" #edb/ref 17592186045417] [17592186398633 #edb/ref 1080 "¬P∧Q" #edb/ref 17592186045417] [17592186398633 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186398633 #edb/ref 1083 #uuid "ca03f4c6-f43c-599e-ae00-4805c10c1a34" #edb/ref 17592186045417] [17592186398634 #edb/ref 1080 "¬P∨¬Q" #edb/ref 17592186045417] [17592186398634 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186398634 #e