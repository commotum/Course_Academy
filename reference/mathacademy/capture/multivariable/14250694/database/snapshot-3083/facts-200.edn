 [17592186570677 #edb/ref 1078 #edb/ref 17592186570432 #edb/ref 17592186045417] [17592186570677 #edb/ref 1079 #uuid "d1054d29-077f-5163-ac93-fb66f447c9b8" #edb/ref 17592186045417] [17592186570683 #edb/ref 1075 #edb/ref 17592186570299 #edb/ref 17592186045417] [17592186570683 #edb/ref 1075 #edb/ref 17592186570355 #edb/ref 17592186045417] [17592186570683 #edb/ref 1075 #edb/ref 17592186570372 #edb/ref 17592186045417] [17592186570683 #edb/ref 1075 #edb/ref 17592186570506 #edb/ref 17592186045417] [17592186570683 #edb/ref 1075 #edb/ref 17592186570530 #edb/ref 17592186045417] [17592186570683 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186570683 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186570683 #edb/ref 1078 #edb/ref 17592186570530 #edb/ref 17592186045417] [17592186570683 #edb/ref 1079 #uuid "e24bf6e9-63fc-5389-a07c-31a47adb1c69" #edb/ref 17592186045417] [17592186570718 #edb/ref 1068 #edb/ref 17592186570611 #edb/ref 17592186045417] [17592186570718 #edb/ref 1069 "q-176857" #edb/ref 17592186045417] [17592186570718 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186570718 #edb/ref 1071 "Consider the following statement.\n\n$0.75$ does **not** belong to the set of rational numbers.\n\nWhat is the negation of this statement?" #edb/ref 17592186045417] [17592186570718 #edb/ref 1072 #uuid "32db5c7a-ebc7-5981-a2ce-a4afccfedb03" #edb/ref 17592186045417] [17592186570718 #edb/ref 1074 "Let's denote the given statement as $P.$\n\nThe symbol \"$¬$\" represents negation. So, our task is to negate the given sentence. \n\nTo negate our plain English sentence, we place the words \"It is not true that\" in front of it. This gives the following:\n\nIt is **not** true that $0.75$ does **not** belong to the set of rational numbers.\n\nIn other words, $0.75$ belongs to the set of rational numbers. Therefore, $¬P$ means the following:\n\n$0.75$ belongs to the set of rational numbers.\n\nNote that $P$ is **false,** while $¬P$ is **true.**" #edb/ref 17592186045417] [17592186570722 #edb/ref 1068 #edb/ref 17592186570638 #edb/ref 17592186045417] [17592186570722 #edb/ref 1069 "q-176052" #edb/ref 17592186045417] [17592186570722 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186570722 #edb/ref 1071 "Given the statement\n\n$$\nP:2\\text{ divides }8\n$$\n\n \nwhich of the following represents the statement $¬P?$" #edb/ref 17592186045417] [17592186570722 #edb/ref 1072 #uuid "3d714d9e-2644-5dbb-a0ee-6c22b2b05b9a" #edb/ref 17592186045417] [17592186570722 #edb/ref 1074 "The symbol \"$¬$\" represents negation. So, our task is to negate the given sentence. \n\nTo negate our plain English sentence, we place the words \"It is not true that\" in front of it. This gives the following:\n\n$$\n¬P:\\text{It is not true that }2\\text{ divides }8,\n$$\n\n \n\nIn other words, $2$ does *not* divide $8.$ Therefore, $¬P$ means the following:\n\n$$\n¬P:2\\text{ does }\\text{not}\\text{ divide }8.\n$$\n\nNote that $P$ is **true,** while $¬P$ is **false.**" #edb/ref 17592186045417] [17592186570731 #edb/ref 1068 #edb/ref 17592186570654 #edb/ref 17592186045417] [17592186570731 #edb/ref 1069 "q-81368" #edb/ref 17592186045417] [17592186570731 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186570731 #edb/ref 1071 "Simplify the statement $¬[¬(¬B∨¬(¬A))].$" #edb/ref 17592186045417] [17592186570731 #edb/ref 1072 #uuid "5c770e58-f7f7-5bfc-9f03-f5a78e6b4cee" #edb/ref 17592186045417] [17592186570731 #edb/ref 1074 "Two negations in a row cancel each other out. So, we can simplify  $¬(¬A)$ to $A.$ \n\nAs a result of this, the statement simplifes to \n\n$$\n¬[¬(¬B∨A)]\n$$\n\nThen, we can simplify $¬(¬(¬B∨A))$ to $¬B∨A.$\n\nTherefore, the given statement can be simplified to \n\n$$\n¬B∨A.\n$$" #edb/ref 17592186045417] [17592186570737 #edb/ref 1068 #edb/ref 17592186570648 #edb/ref 17592186045417] [17592186570737 #edb/ref 1069 "q-176853" #edb/ref 17592186045417] [17592186570737 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186570737 #edb/ref 1071 "Consider the following statement.\n\n$5$ belongs to the set of integer numbers.\n\nWhat is the negation of this statement?" #edb/ref 17592186045417] [17592186570737 #edb/ref 1072 #uuid "66c0453d-a98f-5149-84be-bb8778729997" #edb/ref 17592186045417] [17592186570737 #edb/ref 1074 "Let's denote the given statement as $P.$\n\nThe symbol \"$¬$\" represents negation. So, our task is to negate the given sentence. \n\nTo negate our plain English sentence, we place the words \"It is not true that\" in front of it. This gives the following:\n\nIt is not true that $5$  belongs to the set of integer numbers.\n\nIn other words, $5$ does *not* belong to the set of integer numbers. Therefore, $¬P$ means the following:\n\n$5$ does **not** belong to the set of integer numbers.\n\nNote that $P$ is **true,** while $¬P$ is **false.**" #edb/ref 17592186045417] [17592186570751 #edb/ref 1068 #edb/ref 17592186570677 #edb/ref 17592186045417] [17592186570751 #edb/ref 1069 "q-176866" #edb/ref 17592186045417] [17592186570751 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186570751 #edb/ref 1071 "$9$ is divisible by $4$, or $8$ is **not** divisible by $3.$\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:9\\text{ is divisible by }4$\n\n- $Q:8\\text{ is divisible by }3$" #edb/ref 17592186045417] [17592186570751 #edb/ref 1072 #uuid "846f1209-a84b-5c13-a0c8-7374d18fc658" #edb/ref 17592186045417] [17592186570751 #edb/ref 1074 "The sentence\n\n$9$ is divisible by $4$ \n\ncan be expressed symbolically as $P.$ \n\nThe sentence\n\n$8$ is **not** divisible by $3$\n\ncan be expressed symbolically as $¬Q.$\n\nTherefore, the sentence\n\n$9$ is divisible by $4$, or $8$ is **not** divisible by $3$\n\ncan be expressed symbolically as $P∨¬Q.$" #edb/ref 17592186045417] [17592186570756 #edb/ref 1068 #edb/ref 17592186570580 #edb/ref 17592186045417] [17592186570756 #edb/ref 1069 "q-176871" #edb/ref 17592186045417] [17592186570756 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186570756 #edb/ref 1071 "Simplify the statement $¬(¬P)∨¬(¬(P∧Q)).$" #edb/ref 17592186045417] [17592186570756 #edb/ref 1072 #uuid "91ef8c77-f388-589e-b268-cf2103e707d0" #edb/ref 17592186045417] [17592186570756 #edb/ref 1074 "Two negations in a row cancel each other out. So: \n\n- we can simplify $¬(¬P)$ to $P,$ and\n\n- we can also simplify $¬(¬(P∧Q))$ to $P∧Q.$\n\nTherefore, the given statement can be simplified to \n\n$$\nP∨(P∧Q).\n$$" #edb/ref 17592186045417] [17592186570757 #edb/ref 1068 #edb/ref 17592186570683 #edb/ref 17592186045417] [17592186570757 #edb/ref 1069 "q-81357" #edb/ref 17592186045417] [17592186570757 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186570757 #edb/ref 1071 "Simplify the statement $¬(¬A)∧¬(¬B).$" #edb/ref 17592186045417] [17592186570757 #edb/ref 1072 #uuid "928cf87e-e0b7-5063-acab-2224d29c8984" #edb/ref 17592186045417] [17592186570757 #edb/ref 1074 "Two negations in a row cancel each other out. So:\n\n- we can simplify $¬(¬A)$ to $A,$ and\n\n- we can also simplify  $¬(¬B)$ to $B.$\n\nTherefore, the given statement can be simplified to \n\n$$\nA∧B.\n$$" #edb/ref 17592186045417] [17592186570760 #edb/ref 1068 #edb/ref 17592186570622 #edb/ref 17592186045417] [17592186570760 #edb/ref 1069 "q-81399" #edb/ref 17592186045417] [17592186570760 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186570760 #edb/ref 1071 "$9$ is **not** both even and prime.\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:9\\text{ is even}$\n\n- $Q:9\\text{ is prime}$" #edb/ref 17592186045417] [17592186570760 #edb/ref 1072 #uuid "97de13ba-d851-57a8-a13f-4fcc5cdc4d81" #edb/ref 17592186045417] [17592186570760 #edb/ref 1074 "The given sentence is the negation of the following sentence: \n\n$9$ is both even and prime,  \n\nwhich can be expressed symbolically as $P∧Q.$\n\nThe negation is represented by the symbol \"$¬$\". \n\nTherefore, the given sentence is expressed symbolically as $¬(P∧Q).$" #edb/ref 17592186045417] [17592186570769 #edb/ref 1068 #edb/ref 17592186570629 #edb/ref 17592186045417] [17592186570769 #edb/ref 1069 "q-176050" #edb/ref 17592186045417] [17592186570769 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186570769 #edb/ref 1071 "Consider the following statement.\n\n$5$ is **not** prime.\n\nWhat is the negation of this statement?" #edb/ref 17592186045417] [17592186570769 #edb/ref 1072 #uuid "b52e0c2d-bb10-5ec6-8bde-b55f004808c0" #edb/ref 17592186045417] [17592186570769 #edb/ref 1074 "Let's denote the given statement as $P.$\n\nThe symbol \"$¬$\" represents negation. So, our task is to negate the given sentence. \n\nTo negate our plain English sentence, we place the words \"It is not true that\" in front of it. This gives the following:\n\nIt is **not** true that $5$ is **not** prime.\n\nIn other words, $5$ is prime. Therefore, $¬P$ means the following:\n\n$5$ is prime.\n\nNote that $P$ is **false,** while $¬P$ is **true.**" #edb/ref 17592186045417]}
