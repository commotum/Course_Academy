n the column $P∧¬Q.$\n\n| $\\,P\\,$ | $\\,Q\\,$ | $\\,¬Q\\,$ | $\\,P∨¬Q\\,$ | $\\,¬(P∨¬Q)\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |"}] [{:db/id #edb/ref 17592186410105 :knowledge-point/_questions [{:db/id #edb/ref 17592186152053 :knowledge-point/id #uuid "7c49d316-3552-5ace-a749-5070b64230c3" :knowledge-point/title "Completing a Truth Table for a Compound Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a760ee-5936-56b4-bcc6-367c6cb4e864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186410063} {:answer/id #uuid "e236a867-6c27-5383-a8c6-c14b93397b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186410090}] :answer-field/correct {:answer/id #uuid "e236a867-6c27-5383-a8c6-c14b93397b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186410090} :answer-field/id #uuid "2fc94c3d-55a6-52a8-befa-23370d9ac2eb" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186410094} {:answer-field/choices [{:answer/id #uuid "31a1a336-0977-5fd7-b705-264101c48ef3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186410067} {:answer/id #uuid "60aec5ee-3aa6-551a-9801-5a69fcafe967" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186410073}] :answer-field/correct {:answer/id #uuid "60aec5ee-3aa6-551a-9801-5a69fcafe967" :answer/t