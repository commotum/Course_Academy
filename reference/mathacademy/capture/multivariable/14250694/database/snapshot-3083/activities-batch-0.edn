} {:answer-field/choices [{:answer/id #uuid "b14e0483-a372-5fd9-9aac-a4c6418f0a40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410084} {:answer/id #uuid "e24ff342-e818-59d7-8686-5fbf7bfd82cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410091}] :answer-field/correct {:db/id #edb/ref 17592186410091} :answer-field/id #uuid "7deb5fe1-b953-59ea-8d33-11d1bf079ff6" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410098} {:answer-field/choices [{:answer/id #uuid "5aeaae2d-638b-50a2-9bc8-5391e436e264" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410071} {:answer/id #uuid "f725e384-3087-53ec-8dea-0de0981c9118" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410093}] :answer-field/correct {:db/id #edb/ref 17592186410071} :answer-field/id #uuid "9689e0cd-e889-5811-9b2c-26c58d6abd6c" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410100} {:answer-field/choices [{:answer/id #uuid "68f75dcd-4b71-5caa-9634-a7a3ad02f645" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410074} {:answer/id #uuid "844e1f82-b2f7-50b6-a9e7-d4d1243f25fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410080}] :answer-field/correct {:db/id #edb/ref 17592186410080} :answer-field/id #uuid "e14512f5-568b-572f-88e5-8b63aa118ca8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410103}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f8845516-a376-50cc-8625-12673b114608" :question/math-academy-id "q-182350" :question/problem "Find the missing values in the following truth table:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A∧¬B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | {{field-1}} |\n| $\\text{T}$ | $\\text{F}$ | {{field-2}} |\n| $\\text{F}$ | $\\text{T}$ | {{field-3}} |\n| $\\text{F}$ | $\\text{F}$ | {{field-4}} |" :question/worked-solution "First, we add a column for $¬B,$ where the truth values are opposite to the corresponding values in the column for $B.$ \n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n\nThen, we add a column for $A∧¬B.$ Remember that $A∧¬B$ is true if both $A$ and $¬B$ are true.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬B\\,$ | $\\,A∧¬B\\,$ |\n| --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |"} :step/id #uuid "94ad02f3-e1b3-5f12-96c2-27d98011331b" :step/next {:db/id #edb/ref 17592186419029}} {:db/id #edb/ref 17592186419028 :step/content {:db/id #edb/ref 17592186410108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29224407-55cf-551f-b649-9fde0ff90969" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∨¬Q" :db/id #edb/ref 17592186410065} {:answer/id #uuid "70bc8ea3-93c8-58ea-848f-ec99ae31061f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∧Q)" :db/id #edb/ref 17592186410075} {:answer/id #uuid "72bcfa5c-5b94-5b39-8907-f5e55b173ceb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∨Q" :db/id #edb/ref 17592186410076} {:answer/id #uuid "b3a7f504-4ca7-5894-b89f-b544a051e640" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P∧¬Q" :db/id #edb/ref 17592186410085} {:answer/id #uuid "bf299fda-072c-544f-b29f-e8fcc1aa3744" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∨Q)" :db/id #edb/ref 17592186410086}] :answer-field/correct {:db/id #edb/ref 17592186410086} :answer-field/id #uuid "3485fc02-497e-5efc-b575-32abe89dc9c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410095}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e5ae3f5a-c838-553b-8c0d-d176aea1d388" :question/math-academy-id "q-176861" :question/problem "$\\pi $ is **not** a rational or negative number.\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:\\pi \\text{ is a rational number}$\n\n- $Q:\\pi \\text{ is a negative number}$" :question/worked-solution "The given sentence is the negation of the following sentence: \n\n$\\pi $ is a rational or negative number, \n\nwhich can be expressed symbolically as $P∨Q.$\n\nThe negation is represented by the symbol \"$¬$\".  \n\nTherefore, the given sentence is expressed symbolically as $¬(P∨Q).$"} :step/id #uuid "94f8a49c-36c4-5117-aef4-ce993a2dc394" :step/next {:db/id #edb/ref 17592186419027}} {:db/id #edb/ref 17592186419029 :step/content {:db/id #edb/ref 17592186410105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a760ee-5936-56b4-bcc6-367c6cb4e864" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186410063} {:answer/id #uuid "e236a867-6c27-5383-a8c6-c14b93397b44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410090}] :answer-field/correct {:db/id #edb/ref 17592186410090} :answer-field/id #uuid "2fc94c3d-55a6-52a8-befa-23370d9ac2eb" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186410094} {:answer-field/choices [{:answer/id #uuid "31a1a336-0977-5fd7-b705-264101c48ef3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186410067} {:answer/id #uuid "60aec5ee-3aa6-551a-9801-5a69fcafe967" :answer/type {:db/id #edb/re