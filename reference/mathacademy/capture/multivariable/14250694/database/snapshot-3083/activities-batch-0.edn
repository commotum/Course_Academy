#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186152882} :activity/id #uuid "04492e62-1f36-5743-ad74-130604e26e5a" :activity/scope {:db/id #edb/ref 17592186048349 :topic/id #uuid "97a8f3f2-67ab-5291-a6e0-b7d19b4541f0" :topic/math-academy-id 2790} :activity/steps [{:db/id #edb/ref 17592186152882 :step/content {:db/id #edb/ref 17592186153426 :tutorial/content "The **negation** of a mathematical statement is its *opposite* statement. A mathematical statement and its negation have opposite truth values. \n\nFor example: \n\n- The negation of the *true* statement \"$4$ is divisible by $2$\" is the *false* statement \"$4$ is **not** divisible by $2.$\"\n\n- The negation of the *false* statement \"$5$ is even\" is the *true* statement \"$5$ is odd.\"\n\nWe can express negations using the symbol \"$\\neg$\". The negation of $A$ is denoted $\\neg A,$ and has the opposite truth values as $A{:}$\n\n| $\\,A\\,$ | $\\,\\neg A\\,$ |\n| --- | --- |\n| $\\textrm T$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ |\n\nWe can negate compound statements as well. For example, the statement $\\neg (A \\land B)$ has the opposite truth values as the statement $A \\land B{:}$\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, A \\land B \\,$ | $\\, \\neg (A \\land B) \\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm F$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm T$ |" :tutorial/id #uuid "65ae07d1-2d1e-5f50-9c5f-4b45ca435aed" :tutorial/math-academy-id 7965 :tutorial/title "Introduction"} :step/id #uuid "d6231d40-48ba-5c9d-855d-04ce17a699e2" :step/math-academy-id 120073 :step/next {:db/id #edb/ref 17592186152883}} {:db/id #edb/ref 17592186152883 :step/content {:db/id #edb/ref 17592186152051 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151803 :question/id #uuid "e803903e-e272-5bd9-97a2-6b7cf12c359c" :question/math-academy-id "e-12702"} :knowledge-point/id #uuid "637030d2-d58f-56af-bf16-f33f755b65f9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049002}] :knowledge-point/questions [{:db/id #edb/ref 17592186152433} {:db/id #edb/ref 17592186152434} {:db/id #edb/ref 17592186374359} {:db/id #edb/ref 17592186374366} {:db/id #edb/ref 17592186374373} {:db/id #edb/ref 17592186401660} {:db/id #edb/ref 17592186401667} {:db/id #edb/ref 17592186570718} {:db/id #edb/ref 17592186570722} {:db/id #edb/ref 17592186570737} {:db/id #edb/ref 17592186570769}] :knowledge-point/title "Negating a Plain English Statement"} :step/id #uuid "05ea8d4a-447c-5dfe-bc07-9429c6506a99" :step/math-academy-id 120074 :step/next {:db/id #edb/ref 17592186152884}} {:db/id #edb/ref 17592186152884 :step/content {:db/id #edb/ref 17592186152052 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151800 :question/id #uuid "f652a287-03b1-5e0b-9d77-9a681b1bb873" :question/math-academy-id "e-12681"} :knowledge-point/id #uuid "93415651-fbcb-56d3-ad93-2b7f34e7bf4c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048778}] :knowledge-point/questions [{:db/id #edb/ref 17592186152829} {:db/id #edb/ref 17592186152833} {:db/id #edb/ref 17592186374380} {:db/id #edb/ref 17592186374387} {:db/id #edb/ref 17592186375453} {:db/id #edb/ref 17592186398631} {:db/id #edb/ref 17592186399152} {:db/id #edb/ref 17592186399159} {:db/id #edb/ref 17592186410106} {:db/id #edb/ref 17592186410108} {:db/id #edb/ref 17592186559838} {:db/id #edb/ref 17592186570751} {:db/id #edb/ref 17592186570760}] :knowledge-point/title "Expressing a Negated Sentence in Symbolic Form"} :step/id #uuid "1b41146a-7652-5f80-8f71-bd202ae02ffb" :step/math-academy-id 120077 :step/next {:db/id #edb/ref 17592186152885}} {:db/id #edb/ref 17592186152885 :step/content {:db/id #edb/ref 17592186152053 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151801 :question/id #uuid "3e19d03f-5298-52f4-a839-b4b7c5a1a4bf" :question/math-academy-id "e-12682"} :knowledge-point/id #uuid "7c49d316-3552-5ace-a749-5070b64230c3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049269}] :knowledge-point/questions [{:db/id #edb/ref 17592186152465} {:db/id #edb/ref 17592186152466} {:db/id #edb/ref 17592186374492} {:db/id #edb/ref 17592186374505} {:db/id #edb/ref 17592186374518} {:db/id #edb/ref 17592186381598} {:db/id #edb/ref 17592186389949} {:db/id #edb/ref 17592186389962} {:db/id #edb/ref 17592186389975} {:db/id #edb/ref 17592186410105} {:db/id #edb/ref 17592186410109}] :knowledge-point/title "Completing a Truth Table for a Compound Statement"} :step/id #uuid "88af8584-370e-538d-bc31-ffbea331ec2f" :step/math-academy-id 120080 :step/next {:db/id #edb/ref 17592186152886}} {:db/id #edb/ref 17592186152886 :step/content {:db/id #edb/ref 17592186153427 :tutorial/content "When we have two negations in a row, we can cancel them out.\n\n- For example, $\\neg (\\neg A)$ can be simplified to $A.$\n\n- Likewise, $\\neg (\\neg (A \\land B))$ can be simplified to $A \\land B.$\n\nTo understand why negations cancel with each other, consider the following statement: \n\n$4$ is divisible by $2.$\n\nThe negation of this statement is \n\n$4$ is **not** divisible by $2.$\n\nIf we negate again, we get back the original sentence: \n\n$4$ divisible by $2.$\n\nSo, if we negate a statement twice, we end up with the original statement.\n\nMore formally, we can prove that $\\neg (\\neg A) \\equiv A$ using a truth table.\n\n| $\\,A\\,$ | $\\,\\neg A\\,$ | $\\,\\neg(\\neg A)\\,$ |\n| --- | --- | --- |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ |\n\nSince $A$ and $\\neg(\\neg A)$ have the same truth values, they are logically equivalent." :tutorial/id #uuid "96c8056f-c1d0-5453-ba7f-71700a48506c" :tutorial/math-academy-id 7966 :tutorial/title "Double Negations"} :step/id #uuid "42a89cf9-ea00-5196-9579-5a0eda504d5a" :step/math-academy-id 120083 :step/next {:db/id #edb/ref 17592186152887}} {:db/id #edb/ref 17592186152887 :step/content {:db/id #edb/ref 17592186152054 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151802 :question/id #uuid "503739b1-ea2e-5c6a-8270-6e1fdc050bc4" :question/math-academy-id "e-12683"} :knowledge-point/id #uuid "69612c9a-699f-5635-8c9c-649a93ab4583" :knowledge-point/questions [{:db/id #edb/ref 17592186152830} {:db/id #edb/ref 17592186152832} {:db/id #edb/ref 17592186373729} {:db/id #edb/ref 17592186373736} {:db/id #edb/ref 17592186375439} {:db/id #edb/ref 17592186375446} {:db/id #edb/ref 17592186380726} {:db/id #edb/ref 17592186380733} {:db/id #edb/ref 17592186410107} {:db/id #edb/ref 17592186559820} {:db/id #edb/ref 17592186570731} {:db/id #edb/ref 17592186570756} {:db/id #edb/ref 17592186570757}] :knowledge-point/title "Simplifying a Double Negation"} :step/id #uuid "4ca4d75a-1805-5443-b3f6-3a98bafec5cc" :step/math-academy-id 120084}] :activity/title "The \"Not\" Connective" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152374}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186419030} :activity/id #uuid "bfb8308f-9d2a-5c3b-904c-dfb00bba239f" :activity/scope {:db/id #edb/ref 17592186048349 :topic/id #uuid "97a8f3f2-67ab-5291-a6e0-b7d19b4541f0" :topic/math-academy-id 2790} :activity/steps [{:db/id #edb/ref 17592186419026 :step/content {:db/id #edb/ref 17592186410106 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cf34be5-c594-5496-aa61-41f145440bc7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∨¬Q" :db/id #edb/ref 17592186410072} {:answer/id #uuid "7371329d-96b6-51ea-bfe7-14de7b40abf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∧Q)" :db/id #edb/ref 17592186410077} {:answer/id #uuid "964b4c56-2ede-5a41-8d97-6bcfd3830f9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∧Q" :db/id #edb/ref 1759218