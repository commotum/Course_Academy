Re}(\\overset{―}{v})}+\\text{i}{{\\begin{bmatrix}3 \\\\ 0\\end{bmatrix}}_{⏟}}_{\\text{Im}(\\overset{―}{v})}\\end{aligned}\n$$\n\nFinally, we can now construct $P:$ \n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}| & | \\\\ \\text{Re}(\\overset{―}{v}) & \\text{Im}(\\overset{―}{v}) \\\\ | & |\\end{bmatrix}=\\begin{bmatrix}0 & 3 \\\\ 9 & 0\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395665 :knowledge-point/_questions [{:db/id #edb/ref 17592186129214 :knowledge-point/id #uuid "88f3ba21-6407-503e-aec0-fa4462a69e73" :knowledge-point/title "Converting a Matrix to Rotation-Scaling Form Using the Complex Conjugate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e196512e-1c8e-5187-b969-8d1f8f8d5c47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -1 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186395667} {:answer/id #uuid "3dcd7441-6b21-57de-a31c-17ca6a0f1cda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ -3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186395668} {:answer/id #uuid "ee707b83-d226-5ed6-baf9-f30ac78abcc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 0 \\\\ 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186395669} {:answer/id #uuid "6a5b4235-cc67-53b5-a8a9-129a5d3f6ab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 1 \\\\ 2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186395670} {:answer/id #uuid "99e977e9-1f82-5a4e-93e5-ff723aa90c12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -1 \\\\ 2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186395671}] :answer-field/correct {:answer/id #uuid "99e977e9-1f82-5a4e-93e5-ff723aa90c12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatri