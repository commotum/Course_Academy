      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14244484/observations/step-q99476-a3adb353f39303945f43.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14244484/observations/step-q99476-a3adb353f39303945f43.png",
      "source_url": "https://mathacademy.com/tasks/14244484/topics/2018/lesson",
