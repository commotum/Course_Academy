      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14244484/observations/step-q140501-d9e315e3161168c6e239.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14244484/observations/step-q140501-d9e315e3161168c6e239.png",
      "source_url": "https://mathacademy.com/tasks/14244484/topics/2018/lesson",
