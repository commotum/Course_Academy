lse\">|</mo></mtd></mtr><mtr><mtd><mtext>Re</mtext><mo stretchy=\"false\">(</mo><mover><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">v</mi></mrow><mo accent=\"true\">―</mo></mover><mo stretchy=\"false\">)</mo></mtd><mtd><mtext>Im</mtext><mo stretchy=\"false\">(</mo><mover><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">v</mi></mrow><mo accent=\"true\">―</mo></mover><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd><mo data-mjx-texclass=\"ORD\" fence=\"false\" stretchy=\"false\">|</mo></mtd><mtd><mo data-mjx-texclass=\"ORD\" fence=\"false\" stretchy=\"false\">|</mo></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mo>−</mo><mn>3</mn></mtd><mtd><mo>−</mo><mn>1</mn></mtd></mtr><mtr><mtd><mn>2</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
