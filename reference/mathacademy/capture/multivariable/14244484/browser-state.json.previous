      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14244484/observations/step-q99469-8adba162606be634dff1.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14244484/observations/step-q99469-8adba162606be634dff1.png",
      "source_url": "https://mathacademy.com/tasks/14244484/topics/2018/lesson",
      "captured_at": 1792101978.4497058,
      "math_academy_id": "q-99469",
