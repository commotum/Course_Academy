2624f325da35" #edb/ref 17592186045417] [17592186119852 #edb/ref 1037 #edb/ref 17592186048146 #edb/ref 17592186045417] [17592186119852 #edb/ref 1037 #edb/ref 17592186050129 #edb/ref 17592186045417] [17592186119852 #edb/ref 1038 #edb/ref 17592186120441 #edb/ref 17592186045417] [17592186119852 #edb/ref 1038 #edb/ref 17592186120443 #edb/ref 17592186045417] [17592186119852 #edb/ref 1038 #edb/ref 17592186271992 #edb/ref 17592186045417] [17592186119852 #edb/ref 1038 #edb/ref 17592186342059 #edb/ref 17592186045417] [17592186119852 #edb/ref 1038 #edb/ref 17592186392515 #edb/ref 17592186045417] [17592186119852 #edb/ref 1038 #edb/ref 17592186393348 #edb/ref 17592186045417] [17592186119852 #edb/ref 1038 #edb/ref 17592186554545 #edb/ref 17592186045417] [17592186119852 #edb/ref 1038 #edb/ref 17592186554565 #edb/ref 17592186045417] [17592186119852 #edb/ref 1038 #edb/ref 17592186554598 #edb/ref 17592186045417] [17592186119852 #edb/ref 1039 "Identifying Parts of Cramer's Rule" #edb/ref 17592186045417] [17592186119852 #edb/ref 1041 #edb/ref 17592186119667 #edb/ref 17592186045417] [17592186119852 #edb/ref 1042 #uuid "b9c2dc67-95ca-52f2-a292-32891000b76a" #edb/ref 17592186045417] [17592186119998 #edb/ref 1043 #edb/ref 17592186120648 #edb/ref 17592186045417] [17592186119998 #edb/ref 1043 #edb/ref 17592186120649 #edb/ref 17592186045417] [17592186119998 #edb/ref 1043 #edb/ref 17592186120651 #edb/ref 17592186045417] [17592186119998 #edb/ref 1043 #edb/ref 17592186120706 #edb/ref 17592186045417] [17592186119998 #edb/ref 1043 #edb/ref 17592186120745 #edb/ref 17592186045417] [17592186119998 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186119998 #edb/ref 1045 "Cramer’s Rule for 3x3 Systems" #edb/ref 17592186045417] [17592186119998 #edb/ref 1046 #edb/ref 17592186120648 #edb/ref 17592186045417] [17592186119998 #edb/ref 1049 #edb/ref 17592186049788 #edb/ref 17592186045417] [17592186119998 #edb/ref 1050 720.0 #edb/ref 17592186045417] [17592186119998 #edb/ref 1053 #uuid "8734274c-15b6-589a-a77f-6fd025ab063a" #edb/ref 17592186045417] [17592186120458 #edb/ref 1068 #edb/ref 17592186329617 #edb/ref 17592186045417] [17592186120458 #edb/ref 1069 "q-43113" #edb/ref 17592186045417] [17592186120458 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186120458 #edb/ref 1071 "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n\\left\\{\\begin{aligned}2x-y+2z &=6 \\\\ 3x+2y-z &=k \\\\ 4x+3y-3z &=1\\end{aligned}\\right.\n$$\n\nGiven that $x=1$ and that the determinant of the coefficient matrix is equal to $-9,$ find the value of $k.$" #edb/ref 17592186045443] [17592186120458 #edb/ref 1072 #uuid "d9b84023-6745-5aae-a304-bc4f9a263b31" #edb/ref 17592186045417] [17592186120458 #edb/ref 1074 "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & -1 & 2 \\\\ 3 & 2 & -1 \\\\ 4 & 3 & -3\\end{aligned}|=-9\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}6 & -1 & 2 \\\\ k & 2 & -1 \\\\ 1 & 3 & -3\\end{aligned}| & =6\\cdot |\\begin{aligned}2 & -1 \\\\ 3 & -3\\end{aligned}|-(-1)\\cdot |\\begin{aligned}k & -1 \\\\ 1 & -3\\end{aligned}|+2\\cdot |\\begin{aligned}k & 2 \\\\ 1 & 3\\end{aligned}| \\\\  & =6(-6+3)+(-3k+1)+2(3k-2) \\\\  & =-18-3k+1+6k-4 \\\\  & =3k-21.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nx=\\frac{{D}_{x}}{D}=\\frac{3k-21}{-9}.\n$$\n\nFrom the problem statement, we know that $x=1.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{-9}{3k-21} & =1 \\\\ -9 & =3k-21 \\\\ 12 & =3k \\\\ k & =4.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186120648 #edb/ref 1058 #edb/ref 17592186120706 #edb/ref 17592186045417] [17592186120648 #edb/ref 1061 16705 #edb/ref 17592186045417] [17592186120648 #edb/ref 1062 #uuid "620dc976-5ed3-54d8-a37a-7483259c65bb" #edb/ref 17592186045417] [17592186120648 #edb/ref 1063 #edb/ref 17592186121026 #edb/ref 17592186045417] [17592186120649 #edb/ref 1058 #edb/ref 17592186120651 #edb/ref 17592186045417] [17592186120649 #edb/ref 1061 16707 #edb/ref 17592186045417] [17592186120649 #edb/ref 1062 #uuid "c34a23fc-50c9-5fb1-b89d-0a53b98720ed" #edb/ref 17592186045417] [17592186120649 #edb/ref 1063 #edb/ref 17592186119789 #edb/ref 17592186045417] [17592186120651 #edb/ref 1061 16711 #edb/ref 17592186045417] [17592186120651 #edb/ref 1062 #uuid "bd4aa514-64cb-5bde-8bf4-8e5364299dc3" #edb/ref 17592186045417] [17592186120651 #edb/ref 1063 #edb/ref 17592186119791 #edb/ref 17592186045417] [17592186120706 #edb/ref 1058 #edb/ref 17592186120745 #edb/ref 17592186045417] [17592186120706 #edb/ref 1061 17835 #edb/ref 17592186045417] [17592186120706 #edb/ref 1062 #uuid "e9ce92e1-dc54-5375-b685-ec0fb5099a5c" #edb/ref 17592186045417] [17592186120706 #edb/ref 1063 #edb/ref 17592186121047 #edb/ref 17592186045417] [17592186120745 #edb/ref 1058 #edb/ref 17592186120649 #edb/ref 17592186045417] [17592186120745 #edb/ref 1061 23061 #edb/ref 17592186045417] [17592186120745 #edb/ref 1062 #uuid "d5e91e09-6b2c-5a23-a95e-c5b4f8576a52" #edb/ref 17592186045417] [17592186120745 #edb/ref 1063 #edb/ref 17592186119852 #edb/ref 17592186045417] [17592186121026 #edb/ref 1064 "Cramer's rule applies to square systems of linear equations with any number of variables. In this lesson, we will practice applying Cramer's rule to solve $3 \\times 3$ systems of equations.\n\nSuppose we have a square system of linear equations\n\n$$\n\\{\\begin{aligned}{a}_{11}x+{a}_{12}y+{a}_{13}z={b}_{1} \\\\ {a}_{21}x+{a}_{22}y+{a}_{23}z={b}_{2} \\\\ {a}_{31}x+{a}_{32}y+{a}_{33}z={b}_{3},\\end{aligned}\n$$\n\nwhere ![](images/39/39c4a39573975acc249a4402799f40ef8d72666d4da03d6c4ed6cc299bc7fc52.svg). \nThen Cramer's rule states that\n\n$$\n\\left< x,y,z \\right> = \\left\\langle  \\dfrac{D_x}{D}, \\dfrac{D_y}{D}, \\dfrac{D_z}{D} \\right\\rangle\n$$\n\nis the unique solution of the system, where\n\n![](images/dc/dcda1374b4582e7978133bbf3cea0375b40095d353573f826a3bac7f212dfc03.svg)" #edb/ref 17592186045417] [17592186121026 #edb/ref 1065 3079 #edb/ref 17592186045417] [17592186121026 #edb/ref 1066 #uuid "f245bf99-3b45-5a27-9aca-aaee391628ed" #edb/ref 17592186045417] [17592186121026 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186121047 #edb/ref 1064 "To demonstrate using Cramer's rule on a $3 \\times 3$ system, consider the following system of equations:\n\n$$\n\\{\\begin{aligned}4x+2y+z=9 \\\\ 2y+3z=7 \\\\ -8x+y+6z=0\\end{aligned}\n$$\n\nFirst, let's rewrite the system to reveal the coefficients:\n\n$$\n\\{\\begin{aligned}4x+2y+1z=9 \\\\ 0x+2y+3z=7 \\\\ -8x+1y+6z=0\\end{aligned}\n$$\n\nWe start finding the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}4 & 2 & 1 \\\\ 0 & 2 & 3 \\\\ -8 & 1 & 6\\end{aligned}| & =4\\cdot |\\begin{aligned}2 & 3 \\\\ 1 & 6\\end{aligned}|-2\\cdot |\\begin{aligned}0 & 3 \\\\ -8 & 6\\end{aligned}|+1\\cdot |\\begin{aligned}0 & 2 \\\\ -8 & 1\\end{aligned}| \\\\  & =4(12-3)-2(0+24)+(0+16) \\\\  & =36-48+16 \\\\  & =4\\end{aligned}\n$$\n\nNow, let's find $D_x,$ $D_y,$ and $D_z.$\n\n- To find $D_x,$ we take the coefficients matrix, replace the *first* column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}9 & 2 & 1 \\\\ 7 & 2 & 3 \\\\ 0 & 1 & 6\\end{aligned}| & =9\\cdot |\\begin{aligned}2 & 3 \\\\ 1 & 6\\end{aligned}|-2\\cdot |\\begin{aligned}7 & 3 \\\\ 0 & 6\\end{aligned}|+1\\cdot |\\begin{aligned}7 & 2 \\\\ 0 & 1\\end{aligned}| \\\\  & =9(12-3)-2(42-0)+(7-0) \\\\  & =81-84+7 \\\\  & =4\\end{aligned}\n$$\n\n- To find $D_y,$ we take the coefficients matrix, replace the *second* column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}4 & 9 & 1 \\\\ 0 & 7 & 3 \\\\ -8 & 0 & 6\\end{aligned}| & =4\\cdot |\\begin{aligned}7 & 3 \\\\ 0 & 6\\end{aligned}|-9\\cdot |\\begin{aligned}0 & 3 \\\\ -8 & 6\\end{aligned}|+1\\cdot |\\begin{aligned}0 & 7 \\\\ -8 & 0\\end{aligned}| \\\\  & =4(42)-9(0+24)+(0+56) \\\\  & =168-216+56 \\\\  & =8\\end{aligned}\n$$\n\n- To find $D_z,$ we take the coefficients matrix, replace the *third* column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}4 & 2 & 9 \\\\ 0 & 2 & 7 \\\\ -8 & 1 & 0\\end{aligned}| & =4\\cdot |\\begin{aligned}2 & 7 \\\\ 1 & 0\\end{aligned}|-2\\cdot |\\begin{aligned}0 & 7 \\\\ -8 & 0\\end{aligned}|+9\\cdot |\\begin{aligned}0 & 2 \\\\ -8 & 1\\end{aligned}| \\\\  & =4(-7)-2(0+56)+9(0+16) \\\\  & =-28-112+144 \\\\  & =4\\end{aligned}\n$$\n\nFinally, the solution to the system is given by\n\n$$\n\\begin{aligned}⟨x,y,z⟩ & =⟨\\frac{{D}_{x}}{D},\\frac{{D}_{y}}{D},\\frac{{D}_{z}}{D}⟩ \\\\  & =⟨\\frac{4}{4},\\frac{8}{4},\\frac{4}{4}⟩ \\\\  & =⟨1,2,1⟩.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186121047 #edb/ref 1065 3241 #edb/ref 17592186045417] [17592186121047 #edb/ref 1066 #uuid "9d916943-4be4-554c-a4f5-51aef55e8254" #edb/ref 17592186045417] [17592186121047 #edb/ref 1067 "A Demonstration of Cramer's Rule on a 3x3 Linear System" #edb/ref 17592186045417] [17592186269454 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186269454 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186269454 #edb/ref 1083 #uuid "15a6e5ce-0937-5891-acbd-fe85f7b69928" #edb/ref 17592186045417] [17592186269549 #edb/ref 1080 "14" #edb/ref 17592186045417] [17592186269549 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186269549 #edb/ref 1083 #uuid "210764b5-81bd-5952-a203-b8566ae3024c" #edb/ref 17592186045417] [17592186269680 #edb/ref 1080 "-14" #edb/ref 17592186045417] [17592186269680 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186269680 #edb/ref 1083 #uuid "2dbb50f3-7690-5e1c-a197-81d54236aeff" #edb/ref 17592186045417] [17592186269749 #edb/ref 1080 "k=2" #edb/ref 17592186045417] [17592186269749 #edb/ref 1082 #edb/re