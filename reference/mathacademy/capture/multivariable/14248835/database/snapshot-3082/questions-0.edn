#{[{:db/id #edb/ref 17592186569957 :knowledge-point/_questions [{:db/id #edb/ref 17592186221420 :knowledge-point/id #uuid "af871f3d-da9e-5fd3-a61f-94e155ccf2b3" :knowledge-point/title "Constructing a Fundamental Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b36848b-2da9-5c7b-a35d-1737517ad9ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{e}^{3t} & {e}^{t} \\\\ -2{e}^{3t} & 2{e}^{t}\\end{bmatrix}" :db/id #edb/ref 17592186569461} {:answer/id #uuid "5ebdfe62-fb66-595a-82e4-7cd305075f0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{e}^{3} & 2e \\\\ -2{e}^{3} & e\\end{bmatrix}" :db/id #edb/ref 17592186569588} {:answer/id #uuid "6aa1970d-083b-5e55-bd6c-f1afc347972b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 2 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569611} {:answer/id #uuid "7eff2f7a-e7a9-5224-a158-a8a18a72ea74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{e}^{3t} & 2{e}^{t} \\\\ -2{e}^{3t} & {e}^{t}\\end{bmatrix}" :db/id #edb/ref 17592186569654} {:answer/id #uuid "d6fa3d3b-1a20-5cf5-a0f8-b6beb40484d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 \\\\ -2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569781}] :answer-field/correct {:answer/id #uuid "7eff2f7a-e7a9-5224-a158-a8a18a72ea74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{e}^{3t} & 2{e}^{t} \\\\ -2{e}^{3t} & {e}^{t}\\end{bmatrix}" :db/id #edb/ref 17592186569654} :answer-field/id #uuid "9da6b88c-3427-5d82-9c0a-0c12e0c3ee52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569907}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "047ba9d9-f028-5122-88f6-0f2794537abb" :question/math-academy-id "q-334280" :question/problem "$$\n{x}^{′}=\\begin{bmatrix}4 & 2 \\\\ -1 & 1\\end{bmatrix}x,\\,{x}_{1}(t)=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}{e}^{3t},\\,{x}_{2}(t)=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{t}\n$$\n\nConsider the system of linear ODEs and two of its linearly independent solutions ${x}_{1}$ and ${x}_{2},$ shown above. Which of the following is a fundamental matrix for the system?" :question/worked-solution "Given a linear system ${x}^{′}=Ax,$ where $A$ is an $n\\times n$ matrix, a *fundamental matrix* $Φ(t)$ of the system is an $n\\times n$ matrix whose columns are linearly independent solutions of the system.\n\nIn our case, we have a $2\\times 2$ system. We are also given that the two linearly independent solutions of the system are the following:\n\n$$\n\\begin{aligned}{x}_{1}(t) & =\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}{e}^{3t}=\\begin{bmatrix}{e}^{3t} \\\\ -2{e}^{3t}\\end{bmatrix} \\\\ {x}_{2}(t) & =\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{t}=\\begin{bmatrix}2{e}^{t} \\\\ {e}^{t}\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nTherefore, our fundamental matrix could be written as\n\n$$\nΦ(t)=\\begin{bmatrix}{e}^{3t} & 2{e}^{t} \\\\ -2{e}^{3t} & {e}^{t}\\end{bmatrix}.\n$$\n\n**Note:** The columns of $Φ$ can be written in any order."}] [{:db/id #edb/ref 17592186569972 :knowledge-point/_questions [{:db/id #edb/ref 17592186221420 :knowledge-point/id #uuid "af871f3d-da9e-5fd3-a61f-94e155ccf2b3" :knowledge-point/title "Constructing a Fundamental Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48b0a4b1-4b5e-5cdf-aad0-ef4cdc22aa18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2{e}^{t} & {e}^{5t} \\\\ -{e}^{t} & 3{e}^{5t}\\end{bmatrix}" :db/id #edb/ref 17592186569542} {:answer/id #uuid "b9e625ba-41d6-5d24-be1f-0affef1526a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2e & {e}^{5} \\\\ -e & 3{e}^{5}\\end{bmatrix}" :db/id #edb/ref 17592186569738} {:answer/id #uuid "daaacd2a-601c-5c33-b2d1-7e81075a79a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ -1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186569788} {:answer/id #uuid "e6cecb96-8354-55c0-b574-aa891b5ab7fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 1 \\\\ -2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186569810} {:answer/id #uuid "eb7ccb52-fb72-55ec-b8fb-e2926647ecb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2{e}^{t} & 3{e}^{5t} \\\\ -{e}^{t} & {e}^{5t}\\end{bmatrix}" :db/id #edb/ref 17592186569816}] :answer-field/correct {:answer/id #uuid "48b0a4b1-4b5e-5cdf-aad0-ef4cdc22aa18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2{e}^{t} & {e}^{5t} \\\\ -{e}^{t} & 3{e}^{5t}\\end{bmatrix}" :db/id #edb/ref 17592186569542} :answer-field/id #uuid "7e1c8270-c94c-5afb-bb4e-783c3deb13c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569891}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2812ec6f-62e9-58a6-b999-e2e9bb1ef20a" :question/math-academy-id "q-334287" :question/problem "$$\n{x}^{′}=\\begin{bmatrix}3 & 1 \\\\ -2 & 4\\end{bmatrix}x,\\,{x}_{1}(t)=\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}{e}^{t},\\,{x}_{2}(t)=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}{e}^{5t}\n$$\n\nConsider the system of linear ODEs and two of its linearly independent solutions ${x}_{1}$ and ${x}_{2},$ shown above. Which of the following is a fundamental matrix for the system?" :question/worked-solution "Given a linear system ${x}^{′}=Ax,$ where $A$ is an $n\\times n$ matrix, a *fundamental matrix* $Φ(t)$ of the system is an $n\\times n$ matrix whose columns are linearly independent solutions of the system.\n\nIn our case, we have a $2\\times 2$ system. We are also given that the two linearly independent solutions of the system are the following:\n\n$$\n\\begin{aligned}{x}_{1}(t) & =\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}{e}^{t}=\\begin{bmatrix}2{e}^{t} \\\\ -{e}^{t}\\end{bmatrix} \\\\ {x}_{2}(t) & =\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}{e}^{5t}=\\begin{bmatrix}{e}^{5t} \\\\ 3{e}^{5t}\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nTherefore, our fundamental could be written as\n\n$$\nΦ(t)=\\begin{bmatrix}2{e}^{t} & {e}^{5t} \\\\ -{e}^{t} & 3{e}^{5t}\\end{bmatrix}.\n$$\n\n**Note:** The columns of $Φ$ can be written in any order."}] [{:db/id #edb/ref 17592186570004 :knowledge-point/_questions [{:db/id #edb/ref 17592186221420 :knowledge-point/id #uuid "af871f3d-da9e-5fd3-a61f-94e155ccf2b3" :knowledge-point/title "Constructing a Fundamental Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "673f5ad9-21c2-5daa-bb9e-6ee3d9dfe87f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & t+2 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186569603} {:answer/id #uuid "6a2ea612-1a2e-591a-bff2-d4dd86480b2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}(t+2){e}^{-t} & {e}^{-t} \\\\ 0 & {e}^{-t}\\end{bmatrix}" :db/id #edb/ref 17592186569609} {:answer/id #uuid "a8593261-be32-5d9e-8dd8-02d165c8aae2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{e}^{-t} & (t+2){e}^{-t} \\\\ 0 & {e}^{-t}\\end{bmatrix}" :db/id #edb/ref 17592186569711} {:answer/id #uuid "b2aa5fbe-791f-52df-a6f5-eca385deaf15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{e}^{-1} & 3{e}^{-1} \\\\ 0 & {e}^{-1}\\end{bmatrix}" :db/id #edb/ref 17592186569725} {:answer/id #uuid "e765c34c-543a-5dd2-bfde-69ac7c6edaa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 1 \\\\ 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186569811}] :answer-field/correct {:answer/id #uuid "a8593261-be32-5d9e-8dd8-02d165c8aae2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}{e}^{-t} & (t+2){e}^{-t} \\\\ 0 & {e}^{-t}\\end{bmatrix}" :db/id #edb/ref 17592186569711} :answer-field/id #uuid "a8483fff-76a3-580a-a83e-5302b7c416d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569912}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "808ef5db-aeee-5e2b-ba0b-cf24a0046d0e" :question/math-academy-id "q-334308" :question/problem "$$\n{x}^{′}=\\begin{bmatrix}-1 & 1 \\\\ 0 & -1\\end{bmatrix}x,\\,{x}_{1}(t)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{-t},\\,{x}_{2}(t)=\\begin{bmatrix}t+2 \\\\ 1\\end{bmatrix}{e}^{-t}\n$$\n\nConsider the system of linear ODEs and two of its linearly independent solutions ${x}_{1}$ and ${x}_{2},$ shown above. Which of the following is a fundamental matrix for the system?" :question/worked-solution "Given a linear system ${x}^{′}=Ax,$ where $A$ is an $n\\times n$ matrix, a *fundamental matrix* $Φ(t)$ of the system is an $n\\times n$ matrix whose columns are linearly independent solutions of the system.\n\nIn our case, we have a $2\\times 2$ system. We are also given that the two linearly independent solutions of the system are the following:\n\n$$\n\\begin{aligned}{x}_{1}(t) & =\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{-t}=\\begin{bmatrix}{e}^{-t} \\\\ 0\\end{bmatrix} \\\\ {x}_{2}(t) & =\\begin{bmatrix}t+2 \\\\ 1\\end{bmatrix}{e}^{-t}=\\begin{bmatrix}(t+2){e}^{-t} \\\\ {e}^{-t}\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nTherefore, our fundamental could be written as\n\n$$\nΦ(t)=\\begin{bmatrix}{e}^{-t} & (t+2){e}^{-t} \\\\ 0 & {e}^{-t}\\end{bmatrix}.\n$$\n\n**Note:** The columns of $Φ$ can be written in any order."}]}
