      "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:45px;\n                                        margin-left:2px;\n                                        margin-right:2px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"1\"><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"3\"><span class=\"mq-numerator\" mathquill-block-id=\"5\"><span mathquill-command-id=\"4\">5</span><span mathquill-command-id=\"6\">0</span><span mathquill-command-id=\"8\">0</span><span class=\"mq-nonSymbola\" mathquill-command-id=\"10\">π</span></span><span class=\"mq-denominator\" mathquill-block-id=\"13\"><span mathquill-command-id=\"12\">3</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
      "rendered_text": "500π3​",
