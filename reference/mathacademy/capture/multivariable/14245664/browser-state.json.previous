<mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi>π</mi></mrow></munder><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mstyle></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi>π</mi></mrow></munder><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mn>1</mn><mo>+</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mstyle></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi>π</mi></mrow></munder><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><mi>t</mi></mrow><mi>π</mi></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>π</mi></mtd></mtr><mtr><mtd><mn>1</mn><mo>+</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>π</mi></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>4</mn><mi>π</mi></mrow><mi>π</mi></mfrac></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>4</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr><mtr><mtd><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi>π</mi></mrow></munder><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">g</mi></mrow><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi>π</mi></mrow></munder><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mstyle></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>t</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mi>π</mi></mrow></munder><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mn>2</mn><mo>+</mo><mi>tan</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo stretchy=\"fa