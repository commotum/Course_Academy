3614} {:answer/id #uuid "5d7050e8-5e7e-5d1d-a4ab-29bc3f6573b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,-6 - \\sqrt{2},-11⟩" :db/id #edb/ref 17592186113615}] :answer-field/id #uuid "e10a875d-c5bb-5531-8b0a-fc52f08b4474" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113610}] :question/id #uuid "94647436-6c02-573c-afcc-f91bf56c72c9" :question/math-academy-id "q-32973" :question/problem "Find $lim_(t → 0)[3f(t) - g(t)]$ given that\n$f(t)$ and $g(t)$ are defined as:\n\n$f(t)|= ⟨\\cos t, t^{2} - 2, \\frac{t - 3}{t^{2} + 1}⟩; g(t)|= ⟨\\sin t, \\sqrt{t} + \\sqrt{2}, 2⟩$"}]}
