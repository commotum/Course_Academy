bf1-517e-ac51-8b35d51e8bb9" 13194139534695 17592186045417 true] [17592186433105 1080 "4\\pi " 13194139534695 17592186045417 true] [17592186433105 1082 #edb/ref 17592186045498 13194139534695 17592186045417 true] [17592186433105 1083 #uuid "e249f9ca-86be-5b5a-b69e-663670da563c" 13194139534695 17592186045417 true] [17592186433106 1080 "3-3{y}^{2}-{z}^{2}" 13194139534695 17592186045417 true] [17592186433106 1082 #edb/ref 17592186045498 13194139534695 17592186045417 true] [17592186433106 1083 #uuid "e57d5e52-da19-5261-a231-8c6edbb04f78" 13194139534695 17592186045417 true] [17592186433107 1080 "12" 13194139534695 17592186045417 true] [17592186433107 1082 #edb/ref 17592186045498 13194139534695 17592186045417 true] [17592186433107 1083 #uuid "ffc1ff97-663c-52fc-b66c-d6dbd7166ad9" 13194139534695 17592186045417 true] [17592186433108 1075 #edb/ref 17592186433094 13194139534695 17592186045417 true] [17592186433108 1075 #edb/ref 17592186433100 13194139534695 17592186045417 true] [17592186433108 1075 #edb/ref 17592186433102 13194139534695 17592186045417 true] [17592186433108 1075 #edb/ref 17592186433104 13194139534695 17592186045417 true] [17592186433108 1075 #edb/ref 17592186433107 13194139534695 17592186045417 true] [17592186433108 1076 #edb/ref 17592186045493 13194139534695 17592186045417 true] [17592186433108 1077 "selection" 13194139534695 17592186045417 true] [17592186433108 1078 #edb/ref 17592186433100 13194139534695 17592186045417 true] [17592186433108 1079 #uuid "678a936d-2d59-5cda-bb5b-7ba53ed50f15" 13194139534695 17592186045417 true] [17592186433109 1075 #edb/ref 17592186433096 13194139534695 17592186045417 true] [17592186433109 1075 #edb/ref 17592186433097 13194139534695 17592186045417 true] [17592186433109 1075 #edb/ref 17592186433099 13194139534695 17592186045417 true] [17592186433109 1075 #edb/ref 17592186433101 13194139534695 17592186045417 true] [17592186433109 1075 #edb/ref 17592186433103 13194139534695 17592186045417 true] [17592186433109 1076 #edb/ref 17592186045493 13194139534695 17592186045417 true] [17592186433109 1077 "selection" 13194139534695 17592186045417 true] [17592186433109 1078 #edb/ref 17592186433103 13194139534695 17592186045417 true] [17592186433109 1079 #uuid "a2bfe536-1acc-532a-b70b-2b468372d22d" 13194139534695 17592186045417 true] [17592186433110 1075 #edb/ref 17592186433091 13194139534695 17592186045417 true] [17592186433110 1075 #edb/ref 17592186433092 13194139534695 17592186045417 true] [17592186433110 1075 #edb/ref 17592186433095 13194139534695 17592186045417 true] [17592186433110 1075 #edb/ref 17592186433098 13194139534695 17592186045417 true] [17592186433110 1075 #edb/ref 17592186433106 13194139534695 17592186045417 true] [17592186433110 1076 #edb/ref 17592186045493 13194139534695 17592186045417 true] [17592186433110 1077 "selection" 13194139534695 17592186045417 true] [17592186433110 1078 #edb/ref 17592186433092 13194139534695 17592186045417 true] [17592186433110 1079 #uuid "b0c34a23-22e6-559b-8ba1-968780133734" 13194139534695 17592186045417 true] [17592186433111 1068 #edb/ref 17592186433109 13194139534695 17592186045417 true] [17592186433111 1069 "q-163119" 13194139534695 17592186045417 true] [17592186433111 1070 #edb/ref 17592186045487 13194139534695 17592186045417 true] [17592186433111 1071 "Find the volume of the solid region enclosed by the plane $x=-2,$ the surface $x={z}^{2}+y,$ and the planes $y=0,$ $y=2,$ $z=0,$ $z=1.$" 13194139534695 17592186045417 true] [17592186433111 1072 #uuid "6188e65a-2be8-551f-95a7-3b11de49478d" 13194139534695 17592186045417 true] [17592186433111 1074 "Notice that our solid can be written as a type II region: \n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y\\le 2,\\,\\,0\\le z\\le 1,\\,\\,-2\\le x\\le {z}^{2}+y\\}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{-2}^{{z}^{2}+y}\\,dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}[x]_{x=-2}^{x={z}^{2}+y}\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{z}^{2}+y-(-2)\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{z}^{2}+y+2\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{[\\frac{1}{3}{z}^{3}+(y+2)z]}_{z=0}^{z=1}\\,dy \\\\  & ={\\int }_{0}^{2}\\frac{1}{3}+y+2\\,dy \\\\  & ={\\int }_{0}^{2}\\frac{7}{3}+y\\,dy \\\\  & ={[\\frac{7}{3}y+\\frac{1}{2}{y}^{2}]}_{y=0}^{y=2} \\\\  & =\\frac{7}{3}\\cdot 2+\\frac{1}{2}\\cdot {2}^{2}-0 \\\\  & =\\frac{20}{3}\\end{aligned}\n$$" 13194139534695 17592186045417 true] [17592186433112 1068 #edb/ref 17592186433110 13194139534695 17592186045417 true] [17592186433112 1069 "q-161713" 13194139534695 17592186045417 true] [17592186433112 1070 #edb/ref 17592186045486 13194139534695 17592186045417 true] [17592186433112 1071 "Consider the solid enclosed between the paraboloid $x={y}^{2}+2{z}^{2}$ and the parabolic cylinder $x=3-2{y}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-1}^{1}{\\int }_{a(y)}^{b(y)}\\,f(y,z)\\,dz\\,dy\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" 13194139534695 17592186045417 true] [17592186433112 1072 #uuid "6fae9a19-909c-5d4f-9c8f-4d34e1cb3eba" 13194139534695 17592186045417 true] [17592186433112 1074 "First, we need to determine the projection of the intersection of our surfaces onto the $yz$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}{y}^{2}+2{z}^{2} & =3-2{y}^{2} \\\\ 3{y}^{2}+2{z}^{2} & =3\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $yz$-plane is an ellipse.\n\nNotice that our solid can be written as a type II region: \n\n$$\nR=\\{(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,{y}^{2}+2{z}^{2}\\le x\\le 3-2{y}^{2}\\},\n$$\n\nwhere $D$ is the interior of the ellipse $3{y}^{2}+2{z}^{2}=3.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{{y}^{2}+2{z}^{2}}^{3-2{y}^{2}}\\text{d}x]\\text{d}A \\\\  & ={∬}_{D}(3-2{y}^{2})-({y}^{2}+2{z}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}3-3{y}^{2}-2{z}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $z=-\\sqrt{\\frac{3(1-{y}^{2})}{2}},$ and\n\n- the upper part $z=\\sqrt{\\frac{3(1-{y}^{2})}{2}},$\n\nfor $-1\\le y\\le 1.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}3-3{y}^{2}-2{z}^{2}\\,\\text{d}A & ={\\int }_{-1}^{1}{\\int }_{-\\sqrt{3(1-{y}^{2})/2}}^{\\sqrt{3(1-{y}^{2})/2}}\\,3-3{y}^{2}-2{z}^{2}\\,dz\\,dy.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\sqrt{\\frac{3(1-{y}^{2})}{2}})}^{2}+{(\\sqrt{\\frac{3(1-{y}^{2})}{2}})}^{2}+(3-3{y}^{2}-2{z}^{2}) \\\\  & =\\frac{3(1-{y}^{2})}{2}+\\frac{3(1-{y}^{2})}{2}+(3-3{y}^{2}-2{z}^{2}) \\\\  & =6-6{y}^{2}-2{z}^{2}.\\end{aligned}\n$$" 13194139534695 17592186045417 true] [17592186433113 1068 #edb/ref 17592186433108 13194139534695 17592186045417 true] [17592186433113 1069 "q-161697" 13194139534695 17592186045417 true] [17592186433113 1070 #edb/ref 17592186045486 13194139534695 17592186045417 true] [17592186433113 1071 "![](images/a0/a0ad9cb5ea68b0018680d57d86d88a8dfcf7581a238e9368f566b2396f119579.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the right one, are parallel to the corresponding coordinate planes.*" 13194139534695 17592186045417 true] [17592186433113 1072 #uuid "8fb4dc8a-610a-5632-95eb-19ebf2c9f8b3" 13194139534695 17592186045417 true] [17592186433113 1074 "![](images/d7/d72b3c8aac80a46894d2b7c0c4956ced9eb5b4ebd663b73ba86096550e993bb8.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR=\\{(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 3+\\frac{x}{3}-z\\},\n$$\n\nwhere\n\n$$\nD=\\{(x,z)\\,:\\,0\\le x\\le 3,\\,\\,0\\le z\\le 2\\}\n$$\n\nis the projection of $R$ onto the $xz$-plane, shown below.\n\n![](images/a2/a2dbcefff1b7c28156f117b012c522dd65bca1c1ddd9e2bac4bf2e6ea1ce3722.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 3,\\,\\,0\\le z\\le 2,\\,\\,0\\le y\\le 3+\\frac{x}{3}-z\\}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}{\\int }_{0}^{3+x/3-z}dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}[y]_{y=0}^{y=3+x/3-z}\\,dz\\,dx \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}(3+\\frac{x}{3}-z)-0\\,dz\\,dx \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}3+\\frac{x}{3}-z\\,dz\\,dx \\\\  & ={\\int }_{0}^{3}{[(3+\\frac{x}{3})z-\\frac{{z}^{2}}{2}]}_{z=0}^{z=2}\\,dx \\\\  & ={\\int }_{0}^{3}((3+\\frac{x}{3})(2)-\\frac{{2}^{2}}{2})-0\\,dx \\\\  & ={\\int }_{0}^{3}4+\\frac{2x}{3}\\,dx \\\\  & ={[4x+\\frac{{x}^{2}}{3}]}_{x=0}^{x=3} \\\\  & =(12+3)-0 \\\\  & =15.\\end{aligned}\n$$" 13194139534695 17592186045417 true] [17592186433114 1062 #uuid "15cb8356-aeba-5ea0-a7ab-4e524fdb6298" 13194139534695 17592186045417 true] [17592186433114 1063 #edb/ref 17592186433111 13194139534695 17592186045417 true] [17592186433115 1058 #edb/ref 17592186433118 13194139534695 17592186045417 true] [17592186433115 1062 #uuid "3af6cb17-64ea-5a89-8d5c-b4cd183ea4db" 13194139534695 17592186045417 true] [17592186433115 1063 #edb/ref 17592186433113 13194139534695 17592186045417 true] [17592186433116 1058 #edb/ref 17592186433117 13194139534695 17592186045417 true] [17592186433116 1062 #uuid "808ca638-ac49-5675-8a17-db421c44f255" 13194139534695 17592186045417 true] [17592186433116 1063 #edb/ref 17592186129762 13194139534695 17592186045417 true] [17592186433117 1058 #edb/ref 17592186433115 13194139534695 17592186045417 true] [17592186433117 1062 #uuid "c83aa896-3d0a-5926-8f0d-13b4a640fdef" 13194139534695 17592186045417 true] [17592186433117 1063 #edb/ref 17592186129763 13194139534695 17592186045417 true] [17592186433118 1058 #edb/ref 17592186433114 13194139534695 17592186045417 true] [17592186433118 1062 #uuid "fe1c9984-4492-5bc7-9f8a-f367a564a7b2" 13194139534695 17592186045417 true] [17592186433118 1063 #edb/ref 17592186433112 13194139534695 