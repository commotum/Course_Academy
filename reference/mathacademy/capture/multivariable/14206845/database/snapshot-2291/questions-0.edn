#{[{:db/id #edb/ref 17592186435475 :knowledge-point/_questions [{:db/id #edb/ref 17592186198417 :knowledge-point/id #uuid "2bfe2e3e-9d7b-5c53-8de8-2717237d3e9c" :knowledge-point/title "Calculating the Radius of Gyration of a Uniform Rectangular Laminar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140b7266-c859-561d-b75b-e3f29a126a9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{10}{3}}" :db/id #edb/ref 17592186435419} {:answer/id #uuid "643cc17f-db19-5bf8-8684-83020777531b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{13}{3}}" :db/id #edb/ref 17592186435431} {:answer/id #uuid "70c125cc-f04b-53ec-bec6-4f74b1e334fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{26}}{3}" :db/id #edb/ref 17592186435435} {:answer/id #uuid "dbbdc915-6418-5ba6-8548-0bf03990396d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{11}{2}}" :db/id #edb/ref 17592186435453} {:answer/id #uuid "e4a8f5db-6338-5c46-ae6f-364fe6d2bdf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{15}{4}}" :db/id #edb/ref 17592186435455}] :answer-field/correct {:answer/id #uuid "643cc17f-db19-5bf8-8684-83020777531b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{13}{3}}" :db/id #edb/ref 17592186435431} :answer-field/id #uuid "e4932278-fd35-5668-a02a-427a9d1bc8b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435467}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cba3666c-1980-5c09-82de-e7dd19c40b69" :question/math-academy-id "q-163575" :question/problem "A rectangular plate of mass $M$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 3,\\,\\,1\\le y\\le 3\\}.$ Find the radius of gyration of the plate about the $x$-axis." :question/worked-solution "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the $x$-axis is defined as\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function.\n\nThe area of the rectangular plate $D$ is $A=3\\cdot 2=6.$ Since the plate has uniform density, the mass density function is given by\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{6}.\n$$\n\nTherefore, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{6}{\\int }_{1}^{3}{\\int }_{0}^{3}{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{6}{\\int }_{1}^{3}[x{y}^{2}]_{x=0}^{x=3}\\,\\text{d}y \\\\  & =\\frac{M}{6}{\\int }_{1}^{3}3{y}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{6}[{y}^{3}]_{1}^{3} \\\\  & =\\frac{M}{6}(27-1) \\\\  & =\\frac{13M}{3}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n{R}_{x}^{2}=\\frac{13}{3}\\,⇒\\,{R}_{x}=\\sqrt{\\frac{13}{3}}.\n$$"}] [{:db/id #edb/ref 17592186435469 :knowledge-point/_questions [{:db/id #edb/ref 17592186198417 :knowledge-point/id #uuid "2bfe2e3e-9d7b-5c53-8de8-2717237d3e9c" :knowledge-point/title "Calculating the Radius of Gyration of a Uniform Rectangular Laminar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c55e985-99d7-510d-94c4-cdefd528164b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{17}{2}}" :db/id #edb/ref 17592186435423} {:answer/id #uuid "3db4c8ac-db31-5972-9d3f-65cb573f87d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{34}{3}}" :db/id #edb/ref 17592186435425} {:answer/id #uuid "77cb1250-c861-5412-bfeb-953b40015636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{21}}{2}" :db/id #edb/ref 17592186435436} {:answer/id #uuid "886e0c3d-268d-59a3-b4e6-c11fe4f62ef9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{14}" :db/id #edb/ref 17592186435440} {:answer/id #uuid "974dc7bd-feb4-507f-bf72-f126baafb27c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186435443}] :answer-field/correct {:answer/id #uuid "974dc7bd-feb4-507f-bf72-f126baafb27c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186435443} :answer-field/id #uuid "80bbb187-dc3c-5b0f-ba62-a0ca8ff3dda3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435462}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "07899bf0-acd5-5cb5-8654-0b2936590b7d" :question/math-academy-id "q-163577" :question/problem "A rectangular plate of mass $M$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,2\\le x\\le 3,\\,\\,1\\le y\\le 4\\}.$ Find the radius of gyration of the plate about the $x$-axis." :question/worked-solution "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the $x$-axis is defined as\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function.\n\nThe area of the rectangular plate $D$ is $A=1\\cdot 3=3.$ Since the plate has uniform density, the mass density function is given by\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{3}.\n$$\n\nTherefore, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{3}{\\int }_{1}^{4}{\\int }_{2}^{3}{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{3}{\\int }_{1}^{4}[x{y}^{2}]_{x=2}^{x=3}\\,\\text{d}y \\\\  & =\\frac{M}{3}{\\int }_{1}^{4}3{y}^{2}-2{y}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{3}{\\int }_{1}^{4}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{3}{[\\frac{1}{3}{y}^{3}]}_{1}^{4} \\\\  & =\\frac{M}{3}(\\frac{64}{3}-\\frac{1}{3}) \\\\  & =\\frac{M}{3}\\cdot 21 \\\\  & =7M.\\end{aligned}\n$$\n\nFinally,\n\n$$\n{R}_{x}^{2}=7\\,⇒\\,{R}_{x}=\\sqrt{7}.\n$$"}] [{:db/id #edb/ref 17592186444169 :knowledge-point/_questions [{:db/id #edb/ref 17592186198417 :knowledge-point/id #uuid "2bfe2e3e-9d7b-5c53-8de8-2717237d3e9c" :knowledge-point/title "Calculating the Radius of Gyration of a Uniform Rectangular Laminar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e358496-a583-59a6-b4e0-5fcf99d9cafa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186444157} {:answer/id #uuid "2ca9c9b8-05e4-5eb3-8122-ad72c6a359f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{3}" :db/id #edb/ref 17592186444158} {:answer/id #uuid "688f7ffe-b0fd-57c9-821e-0495e33a6fae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{17}{5}}" :db/id #edb/ref 17592186444161} {:answer/id #uuid "9bbfff91-ca90-559f-ae5d-5fd328a1f1e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186444163} {:answer/id #uuid "bb7abb37-0de9-58cb-8a76-9f11aa3adea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{21}{2}}" :db/id #edb/ref 17592186444165}] :answer-field/correct {:answer/id #uuid "9bbfff91-ca90-559f-ae5d-5fd328a1f1e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186444163} :answer-field/id #uuid "02ef48a6-5de2-5aeb-b94d-50e269438d16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186444166}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae31463b-0937-5dcb-a149-ee8482b71924" :question/math-academy-id "q-163579" :question/problem "A rectangular plate of mass $M$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,1\\le x\\le 4,\\,\\,2\\le y\\le 5\\}.$ Find the radius of gyration of the plate about the $y$-axis." :question/worked-solution "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the $y$-axis is defined as\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function.\n\nThe area of the rectangular plate $D$ is $A=3\\cdot 3=9.$ Since the plate has uniform density, the mass density function is given by\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{9}.\n$$\n\nTherefore, the moment of inertia about the $y$-axis is\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{9}{\\int }_{2}^{5}{\\int }_{1}^{4}{x}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{9}{\\int }_{2}^{5}{[\\frac{1}{3}{x}^{3}]}_{1}^{4}\\,\\text{d}y \\\\  & =\\frac{M}{9}{\\int }_{2}^{5}(\\frac{64}{3}-\\frac{1}{3})\\,\\text{d}y \\\\  & =\\frac{M}{9}{\\int }_{2}^{5}21\\,\\text{d}y \\\\  & =\\frac{7M}{3}{\\int }_{2}^{5}\\,\\text{d}y \\\\  & =\\frac{7M}{3}[y]_{2}^{5} \\\\  & =\\frac{7M}{3}(5-2) \\\\  & =7M.\\end{aligned}\n$$\n\nFinally,\n\n$$\n{R}_{y}^{2}=7\\,⇒\\,{R}_{y}=\\sqrt{7}.\n$$"}] [{:db/id #edb/ref 17592186435473 :knowledge-point/_questions [{:db/id #edb/ref 17592186198417 :knowledge-point/id #uuid "2bfe2e3e-9d7b-5c53-8de8-2717237d3e9c" :knowledge-point/title "Calculating the Radius of Gyration of a Uniform Rectangular Laminar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "014bd219-6bb7-5591-94da-c8e05e6257db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186435415} {:answer/id #uuid "033f9c9a-b36b-5812-9012-d79d61e31523" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186435416} {:answer/id #uuid "40971c50-7326-5588-bfcf-cffa95a31ea9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{5}{3}}" :db/id #edb/ref 17592186435426} {:answer/id #uuid "52222829-b82c-52b5-a96b-b5832b8620cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{3}}" :db/id #edb/ref 17592186435429} {:answer/id #uuid "e0f7f856-a434-5213-900c-1eab2db4aba9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{7}{2}}" :db/id #edb/ref 17592186435454}] :answer-field/correct {:answer/id #uuid "014bd219-6bb7-5591-94da-c8e05e6257db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186435415} :answer-field/id #uuid "2bb25b16-fefe-543c-8d2a-1f870068fdf2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435460}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8f6939e-ee8d-5d31-921b-202a2621754c" :question/math-academy-id "q-163581" :question/problem "A rectangular plate of mass $M$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,1\\le x\\le 5,\\,\\,0\\le y\\le 3\\}.$ Find the radius of gyration of the plate about the $x$-axis." :question/worked-solution "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the $x$-axis is defined as\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function.\n\nThe area of the rectangular plate $D$ is $A=4\\cdot 3=12.$ Since the plate has uniform density, the mass density function is given by\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{12}.\n$$\n\nTherefore, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{12}{\\int }_{0}^{3}{\\int }_{1}^{5}{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{12}{\\int }_{0}^{3}[x{y}^{2}]_{x=1}^{x=5}\\,\\text{d}y \\\\  & =\\frac{M}{12}{\\int }_{0}^{3}5{y}^{2}-{y}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{12}{\\int }_{0}^{3}4{y}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{12}{[\\frac{4}{3}{y}^{3}]}_{0}^{3} \\\\  & =\\frac{M}{12}(36-0) \\\\  & =3M.\\end{aligned}\n$$\n\nFinally,\n\n$$\n{R}_{x}^{2}=3\\,⇒\\,{R}_{x}=\\sqrt{3}.\n$$"}] [{:db/id #edb/ref 17592186435471 :knowledge-point/_questions [{:db/id #edb/ref 17592186198417 :knowledge-point/id #uuid "2bfe2e3e-9d7b-5c53-8de8-2717237d3e9c" :knowledge-point/title "Calculating the Radius of Gyration of a Uniform Rectangular Laminar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "458a3feb-6d5f-529e-9852-6b7cd6d3d2b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{3}}{6}" :db/id #edb/ref 17592186435427} {:answer/id #uuid "472bb346-d7e9-59df-ad9b-e5241908409c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186435428} {:answer/id #uuid "6c33d1a4-bd46-5a6d-bf07-88e9c1f6f6d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{\\sqrt{3}}" :db/id #edb/ref 17592186435432} {:answer/id #uuid "7ea3a2dc-05fc-5d4f-b99c-ded1d1df4630" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186435438} {:answer/id #uuid "fa94c9b2-ed2f-5e6a-a41c-3606d9f544e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{7}{2}}" :db/id #edb/ref 17592186435457}] :answer-field/correct {:answer/id #uuid "6c33d1a4-bd46-5a6d-bf07-88e9c1f6f6d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{\\sqrt{3}}" :db/id #edb/ref 17592186435432} :answer-field/id #uuid "ca4abcbb-4080-56b3-9f3e-dfec3322b962" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186435465}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "464dc60e-dfa3-5c24-8df3-bdca1e567180" :question/math-academy-id "q-163608" :question/problem "A rectangular plate of mass $M$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 3,\\,\\,0\\le y\\le 5\\}.$ Find the radius of gyration of the plate about the $x$-axis." :question/worked-solution "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the $x$-axis is defined as\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function.\n\nThe area of the rectangular plate $D$ is $A=3\\cdot 5=15.$ Since the plate has uniform density, the mass density function is given by\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{15}.\n$$\n\nTherefore, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{15}{\\int }_{0}^{5}{\\int }_{0}^{3}{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{15}{\\int }_{0}^{5}[x{y}^{2}]_{x=0}^{x=3}\\,\\text{d}y \\\\  & =\\frac{M}{15}{\\int }_{0}^{5}3{y}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{15}[{y}^{3}]_{0}^{5} \\\\  & =\\frac{M}{15}(125-0) \\\\  & =\\frac{25M}{3}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n{R}_{x}^{2}=\\frac{25}{3}\\,⇒\\,{R}_{x}=\\sqrt{\\frac{25}{3}}=\\frac{5}{\\sqrt{3}}.\n$$"}]}
