139534745 17592186045417 true] [17592186434828 1077 "selection" 13194139534745 17592186045417 true] [17592186434828 1078 #edb/ref 17592186434819 13194139534745 17592186045417 true] [17592186434828 1079 #uuid "5a1a0c12-6b57-5589-b4e1-416cdc457a68" 13194139534745 17592186045417 true] [17592186434829 1075 #edb/ref 17592186434818 13194139534745 17592186045417 true] [17592186434829 1075 #edb/ref 17592186434820 13194139534745 17592186045417 true] [17592186434829 1075 #edb/ref 17592186434824 13194139534745 17592186045417 true] [17592186434829 1075 #edb/ref 17592186434825 13194139534745 17592186045417 true] [17592186434829 1075 #edb/ref 17592186434826 13194139534745 17592186045417 true] [17592186434829 1076 #edb/ref 17592186045493 13194139534745 17592186045417 true] [17592186434829 1077 "selection" 13194139534745 17592186045417 true] [17592186434829 1078 #edb/ref 17592186434820 13194139534745 17592186045417 true] [17592186434829 1079 #uuid "c1855324-ee18-529c-ba15-53c93565cb17" 13194139534745 17592186045417 true] [17592186434830 1068 #edb/ref 17592186434829 13194139534745 17592186045417 true] [17592186434830 1069 "q-161253" 13194139534745 17592186045417 true] [17592186434830 1070 #edb/ref 17592186045487 13194139534745 17592186045417 true] [17592186434830 1071 "Consider the vector field $F$ and the surface $S$ with parametrization $r(u,v),$ where\n\n$$\nF(x,y,z)=⟨z,\\,xz,\\,yz⟩,\\,r(u,v)=⟨u,\\,{u}^{2},\\,v⟩,\\,(u,v)\\in D⊂{R}^{2}.\n$$\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}auv+b{u}^{2}v\\,\\text{d}A\n$$\n\nwhat is the value of $a+b?$" 13194139534745 17592186045417 true] [17592186434830 1072 #uuid "22bda1b7-731c-5be9-8f1b-6668d9e068b6" 13194139534745 17592186045417 true] [17592186434830 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}({u}^{2}),\\,\\frac{∂}{∂u}(v)⟩ \\\\  & =⟨1,\\,2u,\\,0⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}({u}^{2}),\\,\\frac{∂}{∂v}(v)⟩ \\\\  & =⟨0,\\,0,\\,1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 2u & 0 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =⟨|\\begin{aligned}2u & 0 \\\\ 0 & 1\\end{aligned}|,\\,-|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|,\\,|\\begin{aligned}1 & 2u \\\\ 0 & 0\\end{aligned}|⟩ \\\\  & =⟨2u,\\,-1,\\,0⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨z,\\,xz,\\,yz⟩{|}_{x=u\\,y={u}^{2}\\,z=v} \\\\  & =⟨v,\\,uv,\\,{u}^{2}v⟩.\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨v,\\,uv,\\,{u}^{2}v⟩\\cdot ⟨2u,\\,-1,\\,0⟩ \\\\  & =v\\cdot 2u+uv\\cdot (-1)+{u}^{2}v\\cdot 0 \\\\  & =2uv-uv+0 \\\\  & =uv.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}1\\cdot uv+0\\cdot {u}^{2}v\\,\\text{d}A.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b=1+0=1.\n$$" 13194139534745 17592186045417 true] [17592186434831 1068 #edb/ref 17592186434828 13194139534745 17592186045417 true] [17592186434831 1069 "q-161259" 13194139534745 17592186045417 true] [17592186434831 1070 #edb/ref 17592186045487 13194139534745 17592186045417 true] [17592186434831 1071 "Evaluate the surface integral\n\n$$\n{∬}_{S}⟨x,\\,y,\\,-z⟩\\cdot \\text{d}S\n$$\n\nwhere the parametric surface $S$ is defined by\n\n$$\nr(u,v)=⟨u+v,\\,v-u,\\,uv⟩\n$$\n\nover the domain $D=\\{(u,v)\\,:\\,-2\\le u\\le 0,\\,0\\le v\\le 1\\}.$\n\n*Hint: You can use the fact that ${r}_{u}^{′}\\times {r}_{v}^{′}=⟨-u-v,\\,v-u,\\,2⟩.$*" 13194139534745 17592186045417 true] [17592186434831 1072 #uuid "f5815497-10bb-5d31-b1ef-c78b6eb79a17" 13194139534745 17592186045417 true] [17592186434831 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nWe're given that the fundamental vector product for our surface is\n\n$$\n{r}_{u}^{′}\\times {r}_{v}^{′}=⟨-u-v,\\,v-u,\\,2⟩.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & ={⟨x,\\,y,\\,-z⟩|}_{x=u+v\\,y=v-u\\,z=uv} \\\\  & =⟨u+v,\\,v-u,\\,-uv⟩\\end{aligned}\n$$\n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨u+v,\\,v-u,\\,-uv⟩\\cdot ⟨-u-v,\\,v-u,\\,2⟩ \\\\  & =(u+v)\\cdot (-u-v)+(v-u)\\cdot (v-u)+(-uv)\\cdot 2 \\\\  & =-{u}^{2}-2uv-{v}^{2}+{v}^{2}-2uv+{u}^{2}-2uv \\\\  & =-6uv\\end{aligned}\n$$\n\nTherefore, the surface integral evaluates to\n\n$$\n\\begin{aligned}{∬}_{S}⟨x,\\,y,\\,-z⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(-6uv)\\,\\text{d}A \\\\  & =-6{\\int }_{0}^{1}{\\int }_{-2}^{0}uv\\,\\text{d}u\\,\\text{d}v \\\\  & =-6{\\int }_{0}^{1}v\\,\\text{d}v{\\int }_{-2}^{0}u\\,\\text{d}u \\\\  & =-6\\cdot [\\frac{1}{2}{v}^{2}]_{0}^{1}\\cdot {[\\frac{1}{2}{u}^{2}]}_{-2}^{0} \\\\  & =-6\\cdot \\frac{1}{2}\\cdot (-2) \\\\  & =6.\\end{aligned}\n$$" 13194139534745 17592186045417 true] [17592186434832 1058 #edb/ref 17592186434833 13194139534745 17592186045417 true] [17592186434832 1062 #uuid "764dfadc-7353-5f72-bb5e-9db6eccbfeca" 13194139534745 17592186045417 true] [17592186434832 1063 #edb/ref 17592186434830 13194139534745 17592186045417 true] [17592186434833 1062 #uuid "9468f911-b5bd-557b-9a6f-8e025c4a65c6" 13194139534745 17592186045417 true] [17592186434833 1063 #edb/ref 17592186434831 13194139534745 17592186045417 true] [17592186434834 1058 #edb/ref 17592186434832 13194139534745 17592186045417 true] [17592186434834 1062 #uuid "e88e2f68-fd58-50c1-9108-060ce4b3171a" 13194139534745 17592186045417 true] [17592186434834 1063 #edb/ref 17592186198585 13194139534745 17592186045417 true]] :edb/tempids {"activity-67831f4f-8138-536f-9514-23aeb5868445" 17592186434817 "answer-02b1374a-677b-550b-816a-6cbd02c5f061" 17592186434818 "answer-1c4ed277-51d3-5190-9f15-e73dd884cf47" 17592186434819 "answer-29ead56c-2949-5fb0-8895-cdd6a87df4b8" 17592186434820 "answer-471dabbc-d133-52dc-b559-394801c709a2" 17592186434821 "answer-777af6b2-9aef-5099-aac7-98b1ec37120e" 17592186434822 "answer-8a1f231c-84b6-5409-b4c5-4c9196b18b4b" 17592186434823 "answer-bb3bf5e7-fb1f-5845-863a-15bfb2564e17" 17592186434824 "answer-c3e03b7e-e933-5e07-a534-f79399c89baf" 17592186434825 "answer-c757d8e1-3c0b-5fc9-9360-e929a186b1fe" 17592186434826 "answer-de47629f-21da-52b1-941b-ae2f3625cecc" 17592186434827 "answer-field-5a1a0c12-6b57-5589-b4e1-416cdc457a68" 17592186434828 "answer-field-c1855324-ee18-529c-ba15-53c93565cb17" 17592186434829 "question-22bda1b7-731c-5be9-8f1b-6668d9e068b6" 17592186434830 "question-f5815497-10bb-5d31-b1ef-c78b6eb79a17" 17592186434831 "step-764dfadc-7353-5f72-bb5e-9db6eccbfeca" 17592186434832 "step-9468f911-b5bd-557b-9a6f-8e025c4a65c6" 17592186434833 "step-e88e2f68-fd58-50c1-9108-060ce4b3171a" 17592186434834} :edb/committed false :edb/speculative true}
