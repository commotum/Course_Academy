      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14199393/observations/step-q344695-f28327b0c2d7b9bc00f1.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14199393/observations/step-q344695-f28327b0c2d7b9bc00f1.png",
      "source_url": "https://mathacademy.com/tasks/14199393/topics/1203/review",
      "captured_at": 1791976320.8302758,
      "math_academy_id": "q-344695",
      "topic_id": "1203",
      "sequence_position": null,
