#{[{:activity/expected-seconds 1380.0 :activity/first-step {:db/id #edb/ref 17592186101908} :activity/id #uuid "e770d350-fe93-58e5-a551-254f24aea748" :activity/scope {:db/id #edb/ref 17592186049280 :topic/id #uuid "e992dbdf-067e-5347-82bc-a58321ce8275" :topic/math-academy-id 1203} :activity/steps [{:db/id #edb/ref 17592186101908 :step/content {:db/id #edb/ref 17592186102034 :tutorial/content "The region $\\textrm{R},$ shown below, is the area under the graph of $f(x) = 2x+1$ over the interval $[1,3].$ What is the height of the rectangle defined over the same interval that has the same area as $\\textrm{R}?$ \n\n![](images/01/01597200b1f0e147fa8c53b6301d0c8e37208b5a6cce64cf0d9859d1220d8385.png)\n\n \n\nUsing the formula for the area of a trapezoid, we have that\n\n$$\n\\eqalign{\n\\textrm{Area}\\,(\\textrm{R}) = \\dfrac{1}{2}(3+7)(3-1)= 10.}\n$$\n\nFor the rectangle to have the same area, we must have \n\n$$\n\\begin{aligned}10 & =f(c)(3-1) \\\\ f(c) & =5 \\\\ 2c+1 & =5 \\\\ c & =2.\\end{aligned}\n$$\n\nWe can summarize what we've just done by saying that\n\n$$\n\\int_1^3 (2x +1)\\, \\textrm d x= f(2) \\cdot (3-1).\n$$\n\nThis is an example of the **mean value theorem for integrals**, which states:\n\n*If $f(x)$ is a continuous function on the closed interval $[a, b]$, then there exists a number $c$ in that interval such that*\n\n$$\n\\int_a^b f(x)\\, \\textrm d x = f(c) \\cdot (b-a).\n$$" :tutorial/id #uuid "c1b3241c-c8fd-514f-aa8c-a000710896d4" :tutorial/math-academy-id 986 :tutorial/title "Introduction"} :step/id #uuid "d75b1c61-1292-5625-8252-d8c10bae2e1b" :step/math-academy-id 618980 :step/next {:db/id #edb/ref 17592186101909}} {:db/id #edb/ref 17592186101909 :step/content {:db/id #edb/ref 17592186101021 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100733 :question/id #uuid "a0f21b4c-0f5c-5567-aaec-9da481d2e7ac" :question/math-academy-id "e-547"} :knowledge-point/id #uuid "86221215-32a6-5c5a-bcd7-220e166bcee8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048187} {:db/id #edb/ref 17592186050819}] :knowledge-point/questions [{:db/id #edb/ref 17592186101335} {:db/id #edb/ref 17592186101336} {:db/id #edb/ref 17592186101382} {:db/id #edb/ref 17592186256385} {:db/id #edb/ref 17592186256391} {:db/id #edb/ref 17592186290568} {:db/id #edb/ref 17592186290569} {:db/id #edb/ref 17592186290572} {:db/id #edb/ref 17592186290575} {:db/id #edb/ref 17592186290580} {:db/id #edb/ref 17592186317508} {:db/id #edb/ref 17592186459215} {:db/id #edb/ref 17592186459232} {:db/id #edb/ref 17592186459242} {:db/id #edb/ref 17592186459273} {:db/id #edb/ref 17592186459274}] :knowledge-point/title "Finding Points That Satisfy the Mean Value Theorem for Integrals"} :step/id #uuid "3e6aeea7-0134-5101-a19a-c37ab846bb82" :step/math-academy-id 618981 :step/next {:db/id #edb/ref 17592186101910}} {:db/id #edb/ref 17592186101910 :step/content {:db/id #edb/ref 17592186102035 :tutorial/content "The **average value** of a continuous function on a closed interval $[a,b]$ is given by\n\n$$\nf_\\textrm{avg} = \\dfrac{1}{b-a}\\int_a^b f(x) \\: \\textrm{d}x.\n$$" :tutorial/id #uuid "1cced554-b7fa-5fd4-b8b5-86c8e0bb4bc0" :tutorial/math-academy-id 988 :tutorial/title "The Average Value of a Function"} :step/id #uuid "42fd3643-e43b-5a23-8553-5171fa424230" :step/math-academy-id 618984 :step/next {:db/id #edb/ref 17592186101911}} {:db/id #edb/ref 17592186101911 :step/content {:db/id #edb/ref 17592186101022 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100734 :question/id #uuid "0c84fc6d-422e-5729-94d2-a12cda71f78d" :question/math-academy-id "e-548"} :knowledge-point/id #uuid "55fab3ac-cad3-54bd-b07b-9159554b634c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050489}] :knowledge-point/questions [{:db/id #edb/ref 17592186101365} {:db/id #edb/ref 17592186101379} {:db/id #edb/ref 17592186235502} {:db/id #edb/ref 17592186297300} {:db/id #edb/ref 17592186297301} {:db/id #edb/ref 17592186297310} {:db/id #edb/ref 17592186297311} {:db/id #edb/ref 17592186297458} {:db/id #edb/ref 17592186304792} {:db/id #edb/ref 17592186304797} {:db/id #edb/ref 17592186304800} {:db/id #edb/ref 17592186317521} {:db/id #edb/ref 17592186317528} {:db/id #edb/ref 17592186317529} {:db/id #edb/ref 17592186459207} {:db/id #edb/ref 17592186459219} {:db/id #edb/ref 17592186459253}] :knowledge-point/title "Finding the Average Value of a Function Over a Given Interval"} :step/id #uuid "89d80bd5-bf3f-5758-a57c-65437a4424dd" :step/math-academy-id 618985 :step/next {:db/id #edb/ref 17592186101912}} {:db/id #edb/ref 17592186101912 :step/content {:db/id #edb/ref 17592186101023 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100735 :question/id #uuid "244bb10c-4c6f-5be0-bd9a-72b4defee245" :question/math-academy-id "e-549"} :knowledge-point/id #uuid "41bedcde-cbc1-5634-8846-eb58ffda32e2" :knowledge-point/questions [{:db/id #edb/ref 17592186101366} {:db/id #edb/ref 17592186101380} {:db/id #edb/ref 17592186297304} {:db/id #edb/ref 17592186297459} {:db/id #edb/ref 17592186297460} {:db/id #edb/ref 17592186317511} {:db/id #edb/ref 17592186317513} {:db/id #edb/ref 17592186317514} {:db/id #edb/ref 17592186317515} {:db/id #edb/ref 17592186342141} {:db/id #edb/ref 17592186342142} {:db/id #edb/ref 17592186342143} {:db/id #edb/ref 17592186399996} {:db/id #edb/ref 17592186459230} {:db/id #edb/ref 17592186459251} {:db/id #edb/ref 17592186459276} {:db/id #edb/ref 17592186459304} {:db/id #edb/ref 17592186516835}] :knowledge-point/title "Finding an Interval Given the Average Value of a Function"} :step/id #uuid "3a6cc496-9cd7-5d8a-b41a-b6ed6646b019" :step/math-academy-id 618989 :step/next {:db/id #edb/ref 17592186101913}} {:db/id #edb/ref 17592186101913 :step/content {:db/id #edb/ref 17592186101024 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100736 :question/id #uuid "a1572338-79f7-5da7-b9f6-552dcb7984a6" :question/math-academy-id "e-550"} :knowledge-point/id #uuid "cd9167b4-572f-589f-9b94-b62ba57eb28f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048227}] :knowledge-point/questions [{:db/id #edb/ref 17592186101216} {:db/id #edb/ref 17592186101269} {:db/id #edb/ref 17592186275280} {:db/id #edb/ref 17592186287681} {:db/id #edb/ref 17592186297461} {:db/id #edb/ref 17592186297462} {:db/id #edb/ref 17592186317530} {:db/id #edb/ref 17592186317531} {:db/id #edb/ref 17592186317532} {:db/id #edb/ref 17592186317533} {:db/id #edb/ref 17592186342169} {:db/id #edb/ref 17592186342170} {:db/id #edb/ref 17592186459216} {:db/id #edb/ref 17592186459287} {:db/id #edb/ref 17592186459291}] :knowledge-point/title "Finding the Average Value of a Function Given a Graph"} :step/id #uuid "3d3e3cfa-978d-5956-a57b-742f51ee2e89" :step/math-academy-id 618992}] :activity/title "The Average Value of a Function" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101060}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186516931} :activity/id #uuid "42b474a5-8681-5ff6-964e-1f1f239512b0" :activity/scope {:db/id #edb/ref 17592186049280 :topic/id #uuid "e992dbdf-067e-5347-82bc-a58321ce8275" :topic/math-academy-id 1203} :activity/steps [{:db/id #edb/ref 17592186516877 :step/content {:db/id #edb/ref 17592186297458 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e03faf3-3e92-514d-a666-b56caff650f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{9\\pi }" :db/id #edb/ref 17592186295437} {:answer/id #uuid "ceae20b4-51bc-53f3-a56b-409b71e224ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{9\\pi}" :db/id #edb/ref 17592186516550}] :answer-field/correct {:db/id #edb/ref 17592186516550} :answer-field/id #uuid "46fed9e6-b6f9-583b-951d-71398609b0ba" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186296765}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a9a63b25-eb4e-543f-9169-7fae6ed27cad" :question/math-academy-id "q-316302" :question/problem "Find the average value ${f}_{\\text{avg}}$ of the function $f(x)={cos}^{8}⁡x\\operatorname{sin}⁡x$ on the interval $[0,\\pi ].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}" :question/worked-solution "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi -0}{\\int }_{0}^{\\pi }{cos}^{8}⁡x\\operatorname{sin}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe calculate this integral using a substitution $u=\\operatorname{cos}⁡x.$ Differentiating, we have \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x\\,⟹\\,\\text{d}u=-\\operatorname{sin}⁡x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\pi $ |\n| --- | --- | --- |\n| $u$ | $1$ | $-1$ |\n\nWe now substitute and evaluate, as follows:\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{\\pi }{\\int }_{0}^{\\pi }{cos}^{8}⁡x\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-\\frac{1}{\\pi }{\\int }_{1}^{-1}{u}^{8}\\,\\text{d}u \\\\  & =-{\\frac{1}{\\pi }(\\frac{{u}^{9}}{9})|}_{1}^{-1} \\\\  & =-\\frac{1}{9\\pi }[(-1)^{9}-{1}^{9}] \\\\  & =-\\frac{1}{9\\pi }(-2) \\\\  & =\\frac{2}{9\\pi }.\\end{aligned}\n$$"} :step/id #uuid "0a91efd6-aedd-507e-aa7c-d5175154e395" :step/next {:db/id #edb/ref 17592186516882}} {:db/id #edb/ref 17592186516882 :step/content {:db/id #edb/ref 17592186297459 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "339eefdd-be81-5592-a01a-49ac8b31465b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186295558}] :answer-field/correct {:db/id #edb/ref 17592186295558} :answer-field/id #uuid "7617b7a0-eac2-59c6-b90b-60cddec4dd19" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186296876}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f0bab2f3-434f-5bc7-bbe6-28166bd448b1" :question/math-academy-id "q-316303" :question/problem "Find the value of $c$ such that the average value of $h(x)=10x-4$ on the interval $[0,c]$ is equal to $6.$ Do not round the answer.\n\n$c=$\n{{field-1}}" :question/worked-solution "To solve for $c,$ we apply the average value formula:\n\n$$\n\\begin{aligned}{h}_{\\text{avg}} & =\\frac{1}{b-a}\\,{\\int }_{a}^{b}h(x)\\,\\text{d}x \\\\ 6 & =\\frac{1}{c-0}\\,{\\int }_{0}^{c}(10x-4)\\,\\text{d}x \\\\ 6 & =\\frac{1}{c}(5{x}^{2}-4x){|}_{0}^{c} \\\\ 6 & =\\frac{1}{c}[(5{c}^{2}-4c)-0] \\\\ 6 & =5c-4 \\\\ 10 & =5c \\\\ c & =2\\end{aligned}\n$$"} :step/id #uuid "20a5bad1-0380-5cbe-880b-37b9d31deb30" :step/next {:db/id #edb/ref 17592186516934}} {:db/id #edb/ref 17592186516895 :step/content {:db/id #edb/ref 17592186317532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46e8b462-2441-51eb-ae60-4aff0a2f6fe7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186315531}] :answer-field/correct {:db/id #edb/ref 17592186315531} :answer-field/id #uuid "6d94eeb7-653c-5604-8ed4-f4eb869367bb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186316812}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f0199315-7b83-568e-8a38-7bc403eadc2a" :question/math-academy-id "q-344715" :question/problem "![](images/df/dfa665cf99f35e5cd2edef04b3f334f0054bbce7fc9b66c519d59d30e77ba2a1.png)\n\nThe graph of the function $f(x),$ which is defined on $[0,10],$ is shown above. It consists of line segments.\n\nFind the average value ${f}_{\\text{avg}}$ of $f(x)$ on $[1,9].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}" :question/worked-solution "The average value of a function on a given interval $[a,b]$ is \n\n$$\n{f}_{\\text{avg}}=\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nUsing the additive property of the definite integral, we write\n\n$$\n{\\int }_{1}^{9}f(x)\\,\\text{d}x={{{\\int }_{1}^{5}f(x)\\,\\text{d}x}_{⏟}}_{-{A}_{1}}+{{{\\int }_{5}^{9}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{2}}.\n$$\n\nThe 1st integral represents the signed area between the curve and the $x$-axis, where $x\\in [1,5].$ The corresponding region is a triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 2 \\\\  & =4.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have \n\n$$\n{\\int }_{1}^{5}f(x)\\,\\text{d}x=-{A}_{1}=-4.\n$$\n\nThe 2nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [5,9].$ The corresponding region is a triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 3 \\\\  & =6.\\end{aligned}\n$$\n\nSo, we have \n\n$$\n{\\int }_{5}^{9}f(x)\\,\\text{d}x={A}_{2}=6.\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}{\\int }_{1}^{9}f(x)\\,\\text{d}x & =-{A}_{1}+{A}_{2} \\\\  & =-4+6 \\\\  & =2.\\end{aligned}\n$$\n\nFinally, using the formula for the average value, we get\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{9-1}\\cdot 2 \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$"} :step/id #uuid "3ea34d17-8a70-5fd7-9907-80cd1fee528f"} {:db/id #edb/ref 17592186516931 :step/content {:db/id #edb/ref 17592186516835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30d4cfcd-4ddc-537e-b949-5338d53ece3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186516213} {:answer/id #uuid "32a1e531-1ccd-5a93-b077-640516633b66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186516218} {:answer/id #uuid "55d8a23c-b830-57d0-a5c7-64f48c868528" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186516293} {:answer/id #uuid "ada54ccc-dafd-57ee-a1f0-3847e2e0224c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186516473} {:answer/id #uuid "fcd390d4-2d1d-5cf8-8e2d-09168ddad98c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186516642}] :answer-field/correct {:db/id #edb/ref 17592186516218} :answer-field/id #uuid "32499d7d-98ec-5c26-b24c-0196cd9865ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516667}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ab409300-c391-5504-81d8-684da401e891" :question/math-academy-id "q-120716" :question/problem "Find the numbers $c$ such that the average value of $f(x)=24{x}^{2}+20x+4$ on the interval $[0,c]$ is equal to $7.$" :question/worked-solution "To solve for $c,$ we apply the average value formula:\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ 7 & =\\frac{1}{c-0}{\\int }_{0}^{c}(24{x}^{2}+20x+4)\\,\\text{d}x \\\\ 7 & ={\\frac{1}{c}(8{x}^{3}+10{x}^{2}+4x)|}_{0}^{c} \\\\ 7 & =\\frac{1}{c}[(8{c}^{3}+10{c}^{2}+4c)-0] \\\\ 7 & =8{c}^{2}+10c+4 \\\\ 0 & =8{c}^{2}+10c-3 \\\\ 0 & =(2c+3)(4c-1) \\\\ c & =-\\frac{3}{2},\\,\\frac{1}{4}\\end{aligned}\n$$\n\nNow, since $c>0,$ we conclude that $c=\\frac{1}{4}$ only."} :step/id #uuid "839c2a35-6ec1-5d74-a95d-02cfbee1b3eb" :step/next {:db/id #edb/ref 17592186516877}} {:db/id #edb/ref 17592186516934 :step/content {:db/id #edb/ref 17592186317528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed2abe4d-57c0-599d-b2da-3bc3a8e57a74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186316437} {:answer/id #uuid "9019925a-fde9-5e42-9741-5b09732117ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{\\pi}" :db/id #edb/ref 17592186516414}] :answer-field/correct {:db/id #edb/ref 17592186516414} :answer-field/id #uuid "492b509c-6314-53ae-a2da-64e59ff1f2cb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186316716}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ce1dc838-ac3c-58a3-9be3-5a30e3211516" :question/math-academy-id "q-344695" :question/problem "Find the average value ${f}_{\\text{avg}}$ of the function $f(x)=\\operatorname{sin}⁡(3x)$ on the interval $[0,\\frac{\\pi }{3}].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}" :question/worked-solution "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{(\\frac{\\pi }{3}-0)}{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{3}{\\pi }{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & ={\\frac{3}{\\pi }(-\\frac{\\operatorname{cos}⁡(3x)}{3})|}_{0}^{\\pi /3} \\\\  & =\\frac{3}{\\pi }[(-\\frac{1}{3}\\operatorname{cos}⁡(\\pi ))-(-\\frac{1}{3}\\operatorname{cos}⁡(0))] \\\\  & =\\frac{3}{\\pi }[(-\\frac{1}{3}\\cdot (-1))-(-\\frac{1}{3}\\cdot 1)] \\\\  & =\\frac{3}{\\pi }(\\frac{1}{3}+\\frac{1}{3}) \\\\  & =\\frac{3}{\\pi }\\cdot \\frac{2}{3} \\\\  & =\\frac{2}{\\pi }.\\end{aligned}\n$$"} :step/id #uuid "8d90c070-8a52-56ce-b438-2598dfd524f5" :step/next {:db/id #edb/ref 17592186516895}}] :activity/title "The Average Value of a Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516095}]}
