              "value": "I and III only",
              "html": "I and III only"
            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-103153-b",
              "type": "text",
              "value": "I and II only",
              "html": "I and II only"
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-103153-c",
