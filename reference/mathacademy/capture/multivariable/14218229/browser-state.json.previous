              "value": "II and III only",
              "html": "II and III only"
            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-103150-b",
              "type": "text",
              "value": "I and III only",
              "html": "I and III only"
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-103150-c",
              "type": "text",
              "value": "I only",
              "html": "I only"
