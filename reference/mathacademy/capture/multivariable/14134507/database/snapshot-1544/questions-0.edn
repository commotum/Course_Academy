cd-af29-5292-b6c9-2c6c27d003cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-(s-9)t}" :db/id #edb/ref 17592186368072} {:answer/id #uuid "42388404-5c1c-553a-ad5e-d772fbaedda0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-(s+9)t}" :db/id #edb/ref 17592186368073} {:answer/id #uuid "27566925-17b0-557c-9087-2becaaac8c26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{(s+9)t}" :db/id #edb/ref 17592186368074} {:answer/id #uuid "670a204b-dbd0-5762-9954-fc001e5f533d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{(s-9)t}" :db/id #edb/ref 17592186368075}] :answer-field/correct {:answer/id #uuid "5ab293cd-af29-5292-b6c9-2c6c27d003cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-(s-9)t}" :db/id #edb/ref 17592186368072} :answer-field/id #uuid "ec7afe59-29fd-5b24-8255-f5b581a6ba68" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186368071} {:answer-field/choices [{:answer/id #uuid "01a989fc-e8e2-5596-b19b-18c8318b979c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{st}\\cdot {e}^{-9t}q(t)" :db/id #edb/ref 17592186368077} {:answer/id #uuid "e712aa1e-27e0-5c55-b9b9-c4995f8ad8e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{-9t}q(t)" :db/id #edb/ref 17592186368078} {:answer/id #uuid "0b9f5ac0-0ad4-510b-8d06-44e1d96e1da7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{st}\\cdot {e}^{9t}q(t)" :db/id #edb/ref 17592186368079} {:answer/id #uuid "2bda30ae-8042-58bd-8658-26b8557e0ed0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{9t}q(t)" :db/id #edb/ref 17592186368080}] :answer-field/correct {:answer/id #uuid "2bda30ae-8042-58bd-8658-26b8557e0ed0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{9t}q(t)" :db/id #edb/ref 17592186368080} :answer-field/id #uuid "8ff60236-5483-532f-997e-f3321f9ebbbf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186368076}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9cd6f01-d8c7-5536-9f5a-869210d50728" :question/math-academy-id "q-331799" :question/problem "Consider a function $q(t)$ such that its Laplace transform is $L{q(t)}=Q(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L{{e}^{9t}q(t)}.$ Select the correct options in the reasoning below.By definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L{{e}^{9t}q(t)} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,q(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L{{e}^{9t}q(t)} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{9t}\\,q(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s-9)t}\\,q(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $Q(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,q(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s-9)t}\\,q(t)\\,\\text{d}t=Q(s-9),\n$$\n\nwhere \n\n$$\ns-9>{s}_{0}\\,⇒\\,s>{s}_{0}+9.\n$$"}] [{:db/id #edb/ref 17592186221946 :knowledge-point/_questions [{:db/id #edb/ref 17592186221433 :knowledge-point/id #uuid "2a921795-a527-5528-afcb-5881f188a665" :knowledge-point/title "Applying the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9a33e75-7f63-51a8-acb8-0090c89d185f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(s + 4)/((s + 4)^{2} + 49)" :db/id #edb/ref 17592186220285} {:answer/id #uuid "128682a4-a3ed-5845-bf96-083aa0557681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(s)/((s + 4)^{2} + 49)" :db/id #edb/ref 17592186220286} {:answer/id #uuid "33ceeb7a-a971-5b14-aae5-09c30403997d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(s + 4)/((s + 4)^{2} + 7)" :db/id #edb/ref 17592186220287} {:answer/id #uuid "3656dd84-1841-5325-970f-bb70e4604657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(s - 4)/((s - 4)^{2} + 49)" :db/id #edb/ref 17592186220288} {:answer/id #uuid "4ca5dced-db3f-512c-bade-e052a9f228df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(s + 4)/((s - 4)^{2} + 49)" :db/id #edb/ref 17592186220289}] :answer-field/id #uuid "1a144e16-0a72-5286-bcc9-e70abbff2563" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186220284}] :question/id #uuid "9ea945f3-bef2-521b-aa15-dff430408da0" :question/math-academy-id "q-331855" :question/problem "Given that $L{\\cos (ωt)} = \\frac{s}{s^{2} + ω^{2}}$, find the Laplace transform $L{e^{-4t} \\cdot \\cos (7t)}$."}] [{:db/id #edb/ref 17592186304947 :knowledge-point/_questions [{:db/id #edb/ref 17592186221433 :knowledge-point/id #uuid "2a921795-a527-5528-afcb-5881f188a665" :knowledge-point/title "Applying the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ea27038-03d7-5405-b680-15df02fceab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s+3}{(s-3)^{2}+36}" :db/id #edb/ref 17592186303033} {:answer/id #uuid "7d261f62-a215-5cab-9a32-3f9873b831ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s}{(s+3)^{2}+36}" :db/id #edb/ref 17592186303237} {:answer/id #uuid "a689eeff-fafc-5013-b3f1-24e7bf3ac6a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s+3}{(s+3)^{2}+6}" :db/id #edb/ref 17592186303478} {:answer/id #uuid "ccb7c1d2-5303-5915-b07b-79a0ecfeec04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s+3}{(s+3)^{2}+36}" :db/id #edb/ref 17592186303718} {:answer/id #uuid "db6afb8e-6f9c-51db-b412-cba19033f667" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s-3}{(s-3)^{2}+36}" :db/id #edb/ref 17592186303822}] :answer-field/correct {:answer/id #uuid "ccb7c1d2-5303-5915-b07b-79a0ecfeec04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{s+3}{(s+3)^{2}+36}" :db/id #edb/ref 17592186303718} :answer-field/id #uuid "3956f331-82d9-5a12-8507-4fc3e5638275" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304229}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "050795d3-56ec-5162-9d13-5f770f4a560b" :question/math-academy-id "q-331860" :question/problem "Given that $L{\\operatorname{cos}⁡(\\omega t)}=\\frac{s}{{s}^{2}+{\\omega }^{2}},$ find the Laplace transform $L{{e}^{-3t}\\cdot \\operatorname{cos}⁡(6t)}.$" :question/worked-solution "The first shifting theorem states that if\n$L{f(t)}=F(s),$\nthen\n$L{{e}^{at}f(t)}=F(s-a).$\n\nUsing the given result, we have\n\n$$\nL{\\operatorname{cos}⁡(6t)}=\\frac{s}{{s}^{2}+{6}^{2}}.\n$$\n\nTherefore, applying the first shifting theorem, we get\n\n$$\n\\begin{aligned}L{{e}^{-3t}\\cdot \\operatorname{cos}⁡(6t)} & =\\frac{s+3}{(s+3)^{2}+{6}^{2}} \\\\  & =\\frac{s+3}{(s+3)^{2}+36}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304950 :knowledge-point/_questions [{:db/id #edb/ref 17592186221433 :knowledge-point/id #uuid "2a921795-a527-5528-afcb-5881f188a665" :knowledge-point/title "Applying the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b1003b9-4336-57aa-86fd-d5e21ab2eb2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(s-4)^{2}-9}{(s-4)^{2}+9}" :db/id #edb/ref 17592186302931} {:answer/id #uuid "4fe90190-2cf7-5464-8d8a-a650e6f8ed5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{s}^{2}-9}{((s-4)^{2}+9)^{2}}" :db/id #edb/ref 17592186302957} {:answer/id #uuid "9ef3c2bd-911c-5207-813a-6b7556254441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(s-4)^{2}-4}{((s-4)^{2}+9)^{2}}" :db/id #edb/ref 17592186303445} {:answer/id #uuid "aa79092f-9062-510c-99ee-d9aba5103524" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(s+4)^{2}-9}{((s+4)^{2}+9)^{2}}" :db/id #edb/ref 17592186303507} {:answer/id #uuid "f0e6c536-ba00-52cd-a829-d7109b17cfaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(s-4)^{2}-9}{((s-4)^{2}+9)^{2}}" :db/id #edb/ref 17592186303963}] :answer-field/correct {:answer/id #uuid "f0e6c536-ba00-52cd-a829-d7109b17cfaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(s-4)^{2}-9}{((s-4)^{2}+9)^{2}}" :db/id #edb/ref 17592186303963} :answer-field/id #uuid "57e76e4b-092d-5811-b802-05998a840f59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304317}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e98f8075-941a-5e1c-9a37-f46cd62e24a4" :question/math-academy-id "q-331872" :question/problem "Given that  $L{t\\operatorname{cos}⁡(\\omega t)}=\\frac{{s}^{2}-{\\omega }^{2}}{({s}^{2}+{\\omega }^{2})^{2}},$ find the Laplace transform $L{{e}^{4t}\\cdot t\\operatorname{cos}⁡(3t)}.$" :question/worked-solution "The first shifting theorem states that if\n$L{f(t)}=F(s),$\nthen\n$L{{e}^{at}f(t)}=F(s-a).$\n\nUsing the given result, we have\n\n$$\nL{t\\operatorname{cos}⁡(3t)}=\\frac{{s}^{2}-{3}^{2}}{({s}^{2}+{3}^{2})^{2}}.\n$$\n\nTherefore, applying the first shifting theorem, we get\n\n$$\n\\begin{aligned}L{{e}^{4t}\\cdot t\\operatorname{cos}⁡(3t)} & =\\frac{(s-4)^{2}-{3}^{2}}{((s-4)^{2}+{3}^{2})^{2}} \\\\  & =\\frac{(s-4)^{2}-9}{((s-4)^{2}+9)^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186221947 :knowledge-point/_questions [{:db/id #edb/ref 17592186221435 :knowledge-point/id #uuid "7b6ba61d-2e00-539a-84d0-84b63bf92be0" :knowledge-point/title "Identifying Graph Shifts From the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80a2b3a2-2a1c-5657-9a0c-46c3d1d0b071" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Scale the graph of $F(s)$ by a scale factor of $2$ vertically." :db/id #edb/ref 17592186220291} {:answer/id #uuid "c68eb1a4-0e89-5167-8c50-da7595818ba2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Shift the graph of $F(s)$ by $2$ units to the right." :db/id #edb/ref 17592186220292} {:answer/id #uuid "45a5925f-203c-5ff0-ba1d-13bd03e18a2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Scale the graph of $F(s)$ by a scale factor of $2$ horizontally." :db/id #edb/ref 17592186220293} {:answer/id #uuid "52465464-3cc9-5d3e-be71-9ddda92ffee4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Shift the graph of $F(s)$ by $2$ units to the left." :db/id #edb/ref 17592186220294} {:answer/id #uuid "6b9d9e20-287a-52d4-ae92-343b1c4d6e2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The Laplace transform is unchanged." :db/id #edb/ref 17592186220295}] :answer-field/id #uuid "87c83dc8-2008-503f-a501-9ad228213d1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186220290}] :question/id #uuid "2fa333ab-b95e-5e37-a5a1-bded577fcc62" :question/math-academy-id "q-332055" :question/problem "Consider a function $f(t)$ for which the Laplace transform is $L{f(t)} = F(s)$. How can we obtain the graph of $L{e^{-2t}f(t)}$ from the graph of $F(s)$?"}] [{:db/id #edb/ref 17592186304979 :knowledge-point/_questions [{:db/id #edb/ref 17592186221435 :knowledge-point/id #uuid "7b6ba61d-2e00-539a-84d0-84b63bf92be0" :knowledge-point/title "Identifying Graph Shifts From the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "054b45a4-571c-51d5-8916-deb99bc5b866" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Scale the graph of $F(s)$ by a scale factor of $5$ horizontally." :db/id #edb/ref 17592186302492} {:answer/id #uuid "4ca22da3-5ee1-5636-8493-a9e95b0feb27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Scale the graph of $F(s)$ by a scale factor of $5$ vertically." :db/id #edb/ref 17592186302938} {:answer/id #uuid "99cc8503-b394-5afa-bcf3-b92224bdd7c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The Laplace transform is unchanged." :db/id #edb/ref 17592186303409} {:answer/id #uuid "d181ebc5-ac4e-53ee-a2b6-83f29a3544fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Shift the graph of $F(s)$ by $5$ units to the right." :db/id #edb/ref 17592186303748} {:answer/id #uuid "d55441dc-9527-50c3-8c30-0068b0b8c212" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Shift the graph of $F(s)$ by $5$ units to the left." :db/id #edb/ref 17592186303778}] :answer-field/correct {:answer/id #uuid "d181ebc5-ac4e-53ee-a2b6-83f29a3544fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Shift the graph of $F(s)$ by $5$ units to the right." :db/id #edb/ref 17592186303748} :answer-field/id #uuid "7b950977-e300-5887-b9b0-d9617038a686" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304405}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a494f0da-488f-5d2c-a912-87d73ea366c9" :question/math-academy-id "q-332059" :question/problem "Consider a function $f(t)$ for which the Laplace transform is $L{f(t)}=F(s).$ How can we obtain the graph of $L{{e}^{5t}f(t)}$ from the graph of $F(s)?$" :question/worked-solution "The first shifting theorem states that if\n$L{f(t)}=F(s),$\nthen\n$L{{e}^{at}f(t)}=F(s-a).$\n\nThis implies that multiplying a function $f(t)$ by ${e}^{at}$ shifts the corresponding Laplace transform horizontally along the $s$-axis.\n\n- If $a>0,$ the graph of $F(s)$ shifts to the right.\n\n- If $a<0,$ the graph of $F(s)$ shifts to the left.\n\nIn our case, to get the graph of $L{{e}^{5t}f(t)},$ we must shift the graph of $F(s)$ by $5$ units to the right."}] [{:db/id #edb/ref 17592186368081 :knowledge-point/_questions [{:db/id #edb/ref 17592186221435 :knowledge-point/id #uuid "7b6ba61d-2e00-539a-84d0-84b63bf92be0" :knowledge-point/title "Identifying Graph Shifts From the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebfe2578-7c5f-5df7-9d72-39a56be2386e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8d/8daba7e586feeff02624e5d0fb508c9d2adedb23d5a79fe329f83a42e1f8256e.png" :db/id #edb/ref 17592186368083} {:answer/id #uuid "8e2c1dfa-8219-593c-b78b-6240e600685c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/82/82d01729627b5871739120d2e512cf54610eaaf43f6f2f2c454b7e39803937a2.png" :db/id #edb/ref 17592186368084} {:answer/id #uuid "0d7c5a3d-eb7d-5081-ba8b-a26f602f1890" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e6d497165f1dbc9fd9db77e6a8943f6acd45262cb74ebafd4a418d612be884b7.png" :db/id #edb/ref 17592186368085} {:answer/id #uuid "134ca311-f8fb-5d46-8687-e4802cae00a3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a9/a902bac22ba86af8de8b49d5aba5bb34f35433230f303432e1f4327708f41a7d.png" :db/id #edb/ref 17592186368086} {:answer/id #uuid "63430f1f-817b-5c2a-bd77-427ce4f138a1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/ef457f3f2030bd9399e707ea5bc32f9fe58aae29f848c270c5b971afd98315bd.png" :db/id #edb/ref 17592186368087}] :answer-field/correct {:answer/id #uuid "134ca311-f8fb-5d46-8687-e4802cae00a3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a9/a902bac22ba86af8de8b49d5aba5bb34f35433230f303432e1f4327708f41a7d.png" :db/id #edb/ref 17592186368086} :answer-field/id #uuid "84509ec0-1233-5211-bf4c-8b7806b1f61b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368082}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2acfbcc3-d517-5f68-a1bd-d612fba90c87" :question/math-academy-id "q-332104" :question/problem "![](images/82/82d01729627b5871739120d2e512cf54610eaaf43f6f2f2c454b7e39803937a2.png)\n\nConsider a function $f(t)$ for which the graph of the Laplace transform $L{f(t)}=F(s)$ is shown above. Which of the following could be the graph of $L{{e}^{-2t}f(t)}?$" :question/worked-solution "The first shifting theorem states that if\n$L{f(t)}=F(s),$\nthen\n$L{{e}^{at}f(t)}=F(s-a).$\n\nThis implies that multiplying a function $f(t)$ by ${e}^{at}$ shifts the corresponding Laplace transform horizontally along the $s$-axis.\n\n- If $a>0,$ the graph of $F(s)$ shifts to the right.\n\n- If $a<0,$ the graph of $F(s)$ shifts to the left.\n\nIn our case, to get the graph of $L{{e}^{-2t}f(t)},$ we must shift the graph of $F(s)$ by $2$ units to the left.\n\n![](images/a9/a902bac22ba86af8de8b49d5aba5bb34f35433230f303432e1f4327708f41a7d.png)"}] [{:db/id #edb/ref 17592186304995 :knowledge-point/_questions [{:db/id #edb/ref 17592186221434 :knowledge-point/id #uuid "1dd5c036-7a05-5ca4-aae9-1cf585839ebb" :knowledge-point/title "Applying the First Shifting Theorem and Linearity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a660670-5b82-51e4-a4ab-75bcae056619" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s-4}+\\frac{30}{(s+1)^{4}}" :db/id #edb/ref 17592186302526} {:answer/id #uuid "3b4b8dff-d7ea-505c-a49d-8634294ac8cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s-4}+\\frac{6}{(s+1)^{4}}" :db/id #edb/ref 17592186302825} {:answer/id #uuid "c97503fc-5bd7-579d-87d8-6fa4397ab911" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s-4}+\\frac{30}{(s-1)^{4}}" :db/id #edb/ref 17592186303692} {:answer/id #uuid "e47fa138-b693-5da5-97e9-fe4656a6782a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s+4}+\\frac{30}{(s+1)^{4}}" :db/id #edb/ref 17592186303878} {:answer/id #uuid "e8b266e2-584a-5034-8951-74c07eb426bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{s-4}+\\frac{30}{(s+1)^{4}}" :db/id #edb/ref 17592186303906}] :answer-field/correct {:answer/id #uuid "0a660670-5b82-51e4-a4ab-75bcae056619" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s-4}+\\frac{30}{(s+1)^{4}}" :db/id #edb/ref 17592186302526} :answer-field/id #uuid "9d437068-b018-5153-b0ab-ced1037b5d47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304498}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75147345-f194-5790-8fe4-ff587f8030d2" :question/math-academy-id "q-332183" :question/problem "Given that\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}, &  & s>0,\\end{aligned}\n$$\n\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of $f(t)={e}^{4t}+5{t}^{3}{e}^{-t}$ for $s>4.$" :question/worked-solution "First, we apply the linearity properties of Laplace transforms:\n\n$$\n\\begin{aligned}L{f(t)} & =L{{e}^{4t}+5{t}^{3}{e}^{-t}} \\\\  & =L{{e}^{4t}}+L{5{t}^{3}{e}^{-t}} \\\\  & =L{{e}^{4t}}+5L{{t}^{3}{e}^{-t}}\\end{aligned}\n$$\n\nWe are given that, for $s>0,$\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{t}^{3}} & =\\frac{6}{{s}^{4}}\\end{aligned}\n$$\n\nThe first shifting theorem states that if $L{f(t)}=F(s),$ then $L{{e}^{at}f(t)}=F(s-a).$ Therefore,\n\n$$\n\\begin{aligned}L{{t}^{3}{e}^{-t}} & =\\frac{6}{(s+1)^{4}}.\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =L{{e}^{4t}}+5L{{t}^{3}{e}^{-t}} \\\\  & =\\frac{1}{s-4}+5\\cdot \\frac{6}{(s+1)^{4}} \\\\  & =\\frac{1}{s-4}+\\frac{30}{(s+1)^{4}}.\\end{aligned}\n$$\n\nThis transform is valid for $s>4.$"}] [{:db/id #edb/ref 17592186368095 :knowledge-point/_questions [{:db/id #edb/ref 17592186221434 :knowledge-point/id #uuid "1dd5c036-7a05-5ca4-aae9-1cf585839ebb" :knowledge-point/title "Applying the First Shifting Theorem and Linearity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "878ecff6-a045-5595-bd46-b23e255ce047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s-4}+\\frac{10}{(s-3)^{3}}" :db/id #edb/ref 17592186368097} {:answer/id #uuid "3368f758-7753-54d9-9a94-24de4fff6921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s-4}+\\frac{10}{(s+3)^{3}}" :db/id #edb/ref 17592186368098} {:answer/id #uuid "2b16dd07-1cb7-536e-a033-0738cd8c6049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s+4}+\\frac{10}{(s+3)^{3}}" :db/id #edb/ref 17592186368099} {:answer/id #uuid "fb7bea03-166d-517e-82ce-2d9193e98053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s+4}+\\frac{10}{(s-3)^{3}}" :db/id #edb/ref 17592186368100} {:answer/id #uuid "3f82a2b5-0ff1-5e48-a8d3-81fc3ec2e66e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s+4}+\\frac{5}{(s-3)^{3}}" :db/id #edb/ref 17592186368101}] :answer-field/correct {:answer/id #uuid "fb7bea03-166d-517e-82ce-2d9193e98053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s+4}+\\frac{10}{(s-3)^{3}}" :db/id #edb/ref 17592186368100} :answer-field/id #uuid "57a3b290-92fa-54bf-93a0-2c8ff4a08c1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368096}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20b395e8-6914-5e1c-ade5-fc76b7cc76a8" :question/math-academy-id "q-332198" :question/problem "Given that\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}, &  & s>0,\\end{aligned}\n$$\n\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of  $f(t)={e}^{-4t}+5{t}^{2}{e}^{3t}$ for $s>3.$" :question/worked-solution "First, we apply the linearity properties of Laplace transforms:\n\n$$\n\\begin{aligned}L{f(t)} & =L{{e}^{-4t}+5{t}^{2}{e}^{3t}} \\\\  & =L{{e}^{-4t}}+L{5{t}^{2}{e}^{3t}} \\\\  & =L{{e}^{-4t}}+5L{{t}^{2}{e}^{3t}}\\end{aligned}\n$$\n\nWe are given that, for $s>0,$\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{t}^{2}} & =\\frac{2}{{s}^{3}}\\end{aligned}\n$$\n\nThe first shifting theorem states that if $L{f(t)}=F(s),$ then $L{{e}^{at}f(t)}=F(s-a).$ Therefore,\n\n$$\n\\begin{aligned}L{{t}^{2}{e}^{3t}} & =\\frac{2}{(s-3)^{3}}.\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =L{{e}^{-4t}}+5L{{t}^{2}{e}^{3t}} \\\\  & =\\frac{1}{s+4}+5\\cdot \\frac{2}{(s-3)^{3}} \\\\  & =\\frac{1}{s+4}+\\frac{10}{(s-3)^{3}}.\\end{aligned}\n$$\n\nThis transform is valid for $s>3.$"}] [{:db/id #edb/ref 17592186305000 :knowledge-point/_questions [{:db/id #edb/ref 17592186221434 :knowledge-point/id #uuid "1dd5c036-7a05-5ca4-aae9-1cf585839ebb" :knowledge-point/title "Applying the First Shifting Theorem and Linearity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "186d0804-d9b7-5c1e-a48b-f2497e2f89ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{s-2}+\\frac{12}{(s+4)^{4}}" :db/id #edb/ref 17592186302619} {:answer/id #uuid "3f20e213-0393-5db6-aa8d-bdc2e21fb5c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{s-2}+\\frac{12}{(s-4)^{4}}" :db/id #edb/ref 17592186302852} {:answer/id #uuid "6e9e6ad2-5cf7-566d-b99b-539b2a803a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{s-2}+\\frac{12}{(s+4)^{4}}" :db/id #edb/ref 17592186303131} {:answer/id #uuid "6ebb0b7d-433c-517d-8ef8-4167f92e9fdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{s+2}+\\frac{12}{(s+4)^{4}}" :db/id #edb/ref 17592186303133} {:answer/id #uuid "e1abe34e-4cb8-53ca-9efd-417f01fc56ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{s-2}+\\frac{6}{(s+4)^{4}}" :db/id #edb/ref 17592186303862}] :answer-field/correct {:answer/id #uuid "6e9e6ad2-5cf7-566d-b99b-539b2a803a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{s-2}+\\frac{12}{(s+4)^{4}}" :db/id #edb/ref 17592186303131} :answer-field/id #uuid "d6eec93c-0666-55e7-b6ac-2e919c02dc8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304665}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d34dedd9-0917-526a-8fa5-cdd60c269ceb" :question/math-academy-id "q-332199" :question/problem "Given that\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}, &  & s>0,\\end{aligned}\n$$\n\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of  $f(t)=6{e}^{2t}+2{t}^{3}{e}^{-4t}$ for $s>2.$" :question/worked-solution "First, we apply the linearity properties of Laplace transforms:\n\n$$\n\\begin{aligned}L{f(t)} & =L{6{e}^{2t}+2{t}^{3}{e}^{-4t}} \\\\  & =L{6{e}^{2t}}+L{2{t}^{3}{e}^{-4t}} \\\\  & =6L{{e}^{2t}}+2L{{t}^{3}{e}^{-4t}}\\end{aligned}\n$$\n\nWe are given that, for $s>0,$\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{t}^{3}} & =\\frac{6}{{s}^{4}}\\end{aligned}\n$$\n\nThe first shifting theorem states that if $L{f(t)}=F(s),$ then $L{{e}^{at}f(t)}=F(s-a).$ Therefore,\n\n$$\n\\begin{aligned}L{{t}^{3}{e}^{-4t}} & =\\frac{6}{(s+4)^{4}}.\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =6L{{e}^{2t}}+2L{{t}^{3}{e}^{-4t}} \\\\  & =6\\cdot \\frac{1}{s-2}+2\\cdot \\frac{6}{(s+4)^{4}} \\\\  & =\\frac{6}{s-2}+\\frac{12}{(s+4)^{4}}.\\end{aligned}\n$$\n\nThis transform is valid for $s>2.$"}] [{:db/id #edb/ref 17592186391762 :knowledge-point/_questions [{:db/id #edb/ref 17592186221435 :knowledge-point/id #uuid "7b6ba61d-2e00-539a-84d0-84b63bf92be0" :knowledge-point/title "Identifying Graph Shifts From the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7688a707-770a-5d26-8326-a3a0e9adea9a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fe5d17ffdb189defcd001b26eadf333df4d19157af44beeaa4c270083d1a625d.png" :db/id #edb/ref 17592186391764} {:answer/id #uuid "53a678d2-9902-5f47-87db-4b0cf14c0bfb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/6f/6fd173c18910a9b2c428e7c4e5c52e13935a2439442610fea134ac9bb63fdf01.png" :db/id #edb/ref 17592186391765} {:answer/id #uuid "196682d7-8bb1-57df-ac61-d81412a74a55" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/af/afbe8291979d90666756181ca898851c5f0f30755ba985c32d56bd4b65e1fa5d.png" :db/id #edb/ref 17592186391766} {:answer/id #uuid "b7743ef4-153d-5bf1-9a95-2e67eec1dc0c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/15/15227beae514ccbfe85f3ba5d1ac4bd47fc130c5c15ff4ecd4de1a2813f8f2db.png" :db/id #edb/ref 17592186391767} {:answer/id #uuid "93d16724-e79f-567d-8131-03ecce9ca2c6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ac/ac72ad6572e3dd3b9b75c5d7a681ab14df055031cf3b1baa3c5b0df2de7ae5a4.png" :db/id #edb/ref 17592186391768}] :answer-field/correct {:answer/id #uuid "7688a707-770a-5d26-8326-a3a0e9adea9a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fe/fe5d17ffdb189defcd001b26eadf333df4d19157af44beeaa4c270083d1a625d.png" :db/id #edb/ref 17592186391764} :answer-field/id #uuid "2e3194f8-8dc6-5b04-9805-27bc947704b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391763}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e769abe-27f5-51cc-8d1a-a0d37ed70a2c" :question/math-academy-id "q-341512" :question/problem "![](images/ac/ac72ad6572e3dd3b9b75c5d7a681ab14df055031cf3b1baa3c5b0df2de7ae5a4.png)\n\nConsider a function $f(t)$ for which the graph of the Laplace transform $L{f(t)}=F(s)$ is shown above. Which of the following could be the graph of $L{{e}^{-6t}f(t)}?$" :question/worked-solution "The first shifting theorem states that if\n$L{f(t)}=F(s),$\nthen\n$L{{e}^{at}f(t)}=F(s-a).$\n\nThis implies that multiplying a function $f(t)$ by ${e}^{at}$ shifts the corresponding Laplace transform horizontally along the $s$-axis.\n\n- If $a>0,$ the graph of $F(s)$ shifts to the right.\n\n- If $a<0,$ the graph of $F(s)$ shifts to the left.\n\nIn our case, to get the graph of $L{{e}^{-6t}f(t)},$ we must shift the graph of $F(s)$ by $6$ units to the left.\n\n![](images/fe/fe5d17ffdb189defcd001b26eadf333df4d19157af44beeaa4c270083d1a625d.png)"}]}
