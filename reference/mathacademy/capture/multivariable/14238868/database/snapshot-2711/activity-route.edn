#{[{:activity/course {:db/id #edb/ref 17592186046669} :activity/first-step {:db/id #edb/ref 17592186558651} :activity/id #uuid "2e3a769b-9e00-513a-a8ad-2f8452e782d3" :activity/scope {:db/id #edb/ref 17592186049331 :topic/id #uuid "ec6fdbaa-c722-5e5b-b092-5ba93bdf0c02" :topic/math-academy-id 2027} :activity/steps [{:db/id #edb/ref 17592186558633 :step/content {:db/id #edb/ref 17592186281621 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "257070d0-96de-5c56-8968-f3132c5ed6ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "35\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186278924} {:answer/id #uuid "29c35d3d-762a-5353-98f8-756b472452d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "31\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186278960} {:answer/id #uuid "9c50a528-be93-5d42-9d1d-5373833eb8d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "23.5\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186279981} {:answer/id #uuid "9ec6f369-7250-5e34-b528-cb5dc49bdb12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32.4\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186280001} {:answer/id #uuid "eab5e69e-ea27-5171-a0d9-9069f47edb95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30.1\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186280654}] :answer-field/correct {:db/id #edb/ref 17592186278960} :answer-field/id #uuid "cd949b6b-ce75-5adf-a47b-6ef31d9ee89f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281193}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e47b1623-c58d-5075-9113-1251be6ca292" :question/math-academy-id "q-163170" :question/problem "A rectangular plate occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 3,\\,\\,0\\le y\\le 1\\}$\nwith mass density function $\\lambda (x,y)=(4y+1)\\,\\text{kg}/{\\text{m}}^{2},$ where $x$ and $y$ area measured in meters. Find the moment of inertia of this lamina about the origin." :question/worked-solution "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nUsing the formula for ${I}_{0},$ we get\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3}({x}^{2}+{y}^{2})(4y+1)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{3}4{x}^{2}y+{x}^{2}+4{y}^{3}+{y}^{2}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{0}^{1}{[\\frac{4}{3}{x}^{3}y+\\frac{1}{3}{x}^{3}+4x{y}^{3}+x{y}^{2}]}_{x=0}^{x=3}\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}36y+9+12{y}^{3}+3{y}^{2}\\,\\text{d}y \\\\  & =[18{y}^{2}+9y+3{y}^{4}+{y}^{3}]_{0}^{1} \\\\  & =18+9+3+1 \\\\  & =31.\\end{aligned}\n$$\n\nTherefore, the moment of inertia of the lamina about the origin is $31\\,\\text{kg}\\cdot {\\text{m}}^{2}.$"} :step/id #uuid "694957c5-8135-525b-8f04-fd9c7bd1a04e" :step/next {:db/id #edb/ref 17592186558691}} {:db/id #edb/ref 17592186558651 :step/content {:db/id #edb/ref 17592186129531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c5c064b-08ea-5bfd-ab69-59d08747b4f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4M}{3}\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186278982} {:answer/id #uuid "36add068-fc21-5310-b6d6-2c342cf02faa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2M\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186279070} {:answer/id #uuid "402db993-f88f-5fbe-94b2-191a8a4097a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2M}{3}\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186279160} {:answer/id #uuid "a97f6f5d-dae7-50c8-b1bc-6c5e4d06a4bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{M}{3}\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186280096} {:answer/id #uuid "bf6093ca-d163-58ee-a9e0-b840646a5e22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5M}{3}\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186280274}] :answer-field/correct {:db/id #edb/ref 17592186280274} :answer-field/id #uuid "8415b494-bfb5-5759-9d5d-906937712b89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281071}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d5a597a5-f786-5891-91b3-c78b73413f55" :question/math-academy-id "q-162905" :question/problem "A rectangular plate of mass $M\\,\\text{kg}$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le 2\\},$ where $x$ and $y$ are measured in meters. Find the moment of inertia of the plate about the origin." :question/worked-solution "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nThe area of the rectangular plate $D$ is $A=1\\cdot 2=2.$ \n\nSince the plate has uniform density, every unit of area contains the same amount of mass. Therefore, the mass density is constant and is given by the total mass divided by the total area:\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{2}.\n$$\n\nUsing the formula for ${I}_{0},$ we get\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{2}{\\int }_{0}^{2}{\\int }_{0}^{1}{x}^{2}+{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{2}{\\int }_{0}^{2}{[\\frac{1}{3}{x}^{3}+x{y}^{2}]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & =\\frac{M}{2}{\\int }_{0}^{2}\\frac{1}{3}+{y}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{2}{[\\frac{1}{3}y+\\frac{1}{3}{y}^{3}]}_{0}^{2} \\\\  & =\\frac{M}{2}(\\frac{2}{3}+\\frac{8}{3}) \\\\  & =\\frac{M}{2}\\cdot \\frac{10}{3} \\\\  & =\\frac{5M}{3}.\\end{aligned}\n$$\n\nTherefore, the moment of inertia is $\\frac{5M}{3}\\,\\text{kg}\\cdot {\\text{m}}^{2}.$"} :step/id #uuid "8237ba76-775f-50f6-89e1-feac0674be53" :step/next {:db/id #edb/ref 17592186558701}} {:db/id #edb/ref 17592186558667 :step/content {:db/id #edb/ref 17592186281631 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10a700cc-9a80-52fe-b948-d035b0b0b50c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6M\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186278741} {:answer/id #uuid "365b10c1-9a22-5c79-b9b5-50173e8aadde" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{3}\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186279066} {:answer/id #uuid "93ceeab5-b213-5adc-ad04-95c2bdacb462" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8M}{9}\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186279906} {:answer/id #uuid "97708c84-8902-5f55-921b-48e526407aec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12M\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186279931} {:answer/id #uuid "c877bf68-98d8-5d6e-ba06-a282245771bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10M\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186280346}] :answer-field/correct {:db/id #edb/ref 17592186280346} :answer-field/id #uuid "5e2bfd6e-e15f-531c-8cb4-6aaab1b19f82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280998}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f8b4a4d7-db6d-5f9c-bc7b-f800dc788f58" :question/math-academy-id "q-163200" :question/problem "A rectangular plate of mass $M\\,\\text{kg}$ and uniform mass density occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 3,\\,\\,1\\le y\\le 4\\},$ where $x$ and $y$ are measured in meters. Find the moment of inertia of the plate about the origin." :question/worked-solution "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nThe area of the rectangular plate $D$ is $A=3\\cdot 3=9.$ \n\nSince the plate has uniform density, every unit of area contains the same amount of mass. Therefore, the mass density is constant and is given by the total mass divided by the total area:\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{M}{9}.\n$$\n\nUsing the formula for ${I}_{0},$ we get\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{M}{9}{\\int }_{1}^{4}{\\int }_{0}^{3}{x}^{2}+{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{M}{9}{\\int }_{1}^{4}{[\\frac{1}{3}{x}^{3}+x{y}^{2}]}_{x=0}^{x=3}\\,\\text{d}y \\\\  & =\\frac{M}{9}{\\int }_{1}^{4}9+3{y}^{2}\\,\\text{d}y \\\\  & =\\frac{M}{9}{[9y+{y}^{3}]}_{1}^{4} \\\\  & =\\frac{M}{9}(36+64-9-1) \\\\  & =10M\\end{aligned}\n$$\n\nTherefore, the moment of inertia is $10M\\,\\text{kg}\\cdot {\\text{m}}^{2}.$"} :step/id #uuid "a10163e9-da0c-5d78-a52e-6dbbcd5e5563"} {:db/id #edb/ref 17592186558691 :step/content {:db/id #edb/ref 17592186481404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9485ad-0d2d-50b4-b908-d8715c6808c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186480793} {:answer/id #uuid "1b253e13-148e-5e5e-a20a-b5b94224af45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "94.2\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186480795} {:answer/id #uuid "54795f54-0a40-564c-911b-ae120e159861" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "82\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186480891} {:answer/id #uuid "6d69e97d-0fc0-5bb2-b5a3-efd04876068d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "90\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186480945} {:answer/id #uuid "746e5210-a7d2-5781-83fe-86be72c56d8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "86.4\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186480953}] :answer-field/correct {:db/id #edb/ref 17592186480945} :answer-field/id #uuid "362d2433-4c99-52b8-885b-22db14bc5af2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186481257}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a91e5e5e-7869-5527-a5f1-b8a7012a6c8a" :question/math-academy-id "q-163171" :question/problem "A rectangular plate occupies the region\n$D=\\{(x,y)\\,:\\,2\\le x\\le 4,\\,\\,0\\le y\\le \\operatorname{ln}⁡2\\}$\nwith mass density function $\\lambda (x,y)=x{e}^{2y}\\,\\text{kg}/{\\text{m}}^{2},$ where $x$ and $y$ area measured in meters. Find the moment of inertia of this lamina about the $y$-axis." :question/worked-solution "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nUsing the formula for ${I}_{y},$ we get\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}{\\int }_{2}^{4}{x}^{2}\\cdot x{e}^{2y}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}[{\\int }_{2}^{4}{x}^{3}{e}^{2y}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}{e}^{2y}{[\\frac{1}{4}{x}^{4}]}_{2}^{4}\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}60{e}^{2y}\\,\\text{d}y \\\\  & =[30{e}^{2y}]_{0}^{\\operatorname{ln}⁡2} \\\\  & =120-30 \\\\  & =90.\\end{aligned}\n$$\n\nTherefore, the moment of inertia of the lamina about the $y$-axis is $90\\,\\text{kg}\\cdot {\\text{m}}^{2}.$"} :step/id #uuid "d2332004-af3c-506b-af8f-826103645c0d" :step/next {:db/id #edb/ref 17592186558667}} {:db/id #edb/ref 17592186558701 :step/content {:db/id #edb/ref 17592186129533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5b79f0-fe1f-5968-a6d9-ee148fae971f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "87.5\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186278874} {:answer/id #uuid "4e3f6e9e-364f-5a41-b13a-37d28222531f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186279301} {:answer/id #uuid "721017c5-8b67-597e-9158-5d6c86e5e6b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "97.5\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186279628} {:answer/id #uuid "89ce2a87-a695-5f87-a1c3-117382df04e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "102.5\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186279820} {:answer/id #uuid "a013ac40-9905-5921-9ec1-6a069c738d7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "95\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186280015}] :answer-field/correct {:db/id #edb/ref 17592186279628} :answer-field/id #uuid "7b28007f-9cca-5200-a487-d957cfccad04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281057}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e40dca43-d21c-5ed7-bbc5-5f37b500695b" :question/math-academy-id "q-162922" :question/problem "A rectangular plate occupies the region\n$D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 3\\}$\nwith mass density function $\\lambda (x,y)=(6-xy)\\,\\text{kg}/{\\text{m}}^{2},$ where $x$ and $y$ area measured in meters. Find the moment of inertia of this lamina about the origin." :question/worked-solution "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nUsing the formula for ${I}_{0},$ we get\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}({x}^{2}+{y}^{2})(6-xy)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}[{\\int }_{0}^{2}6{x}^{2}-{x}^{3}y+6{y}^{2}-x{y}^{3}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{0}^{3}{[2{x}^{3}-\\frac{1}{4}{x}^{4}y+6x{y}^{2}-\\frac{1}{2}{x}^{2}{y}^{3}]}_{x=0}^{x=2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}16-4y+12{y}^{2}-2{y}^{3}\\,\\text{d}y \\\\  & =[16y-2{y}^{2}+4{y}^{3}-\\frac{1}{2}{y}^{4}]_{0}^{3} \\\\  & =48-18+108-\\frac{81}{2}-0 \\\\  & =97.5.\\end{aligned}\n$$\n\nTherefore, the moment of inertia of the lamina about the origin is $97.5\\,\\text{kg}\\cdot {\\text{m}}^{2}.$"} :step/id #uuid "e3d7ed7d-52f6-52a0-bfe7-33b01761ebe1" :step/next {:db/id #edb/ref 17592186558633}}] :activity/title "Moments of Inertia of Laminas About the Coordinate Axes" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186557856}]}
