">(</mo><mn>2</mn><msup><mi>π</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>π</mi><mo>+</mo><mn>4</mn><mi>π</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>π</mi><mo>−</mo><mn>4</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>π</mi><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>1</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>0</mn><mo>+</mo><mn>4</mn><mo stretchy=\"false\">(</mo><mn>0</mn><mo stretchy=\"false\">)</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>0</mn><mo>−</mo><mn>4</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mn>0</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>0</mn><mo>−</mo><mn>4</mn><mi>π</mi><mo>−</mo><mn>0</mn><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>−</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mn>4</mn><mi>π</mi></mpadded></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
