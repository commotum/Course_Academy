7] [17592186068921 #edb/ref 1038 #edb/ref 17592186377594 #edb/ref 17592186045417] [17592186068921 #edb/ref 1039 "Computing the Integral of a Logarithmic Expression Using Integration by Parts Twice" #edb/ref 17592186045417] [17592186068921 #edb/ref 1041 #edb/ref 17592186068572 #edb/ref 17592186045417] [17592186068921 #edb/ref 1042 #uuid "98a67346-c2c9-5d22-8adf-479fea81eaa2" #edb/ref 17592186045417] [17592186068951 #edb/ref 1043 #edb/ref 17592186069905 #edb/ref 17592186045417] [17592186068951 #edb/ref 1043 #edb/ref 17592186069906 #edb/ref 17592186045417] [17592186068951 #edb/ref 1043 #edb/ref 17592186069907 #edb/ref 17592186045417] [17592186068951 #edb/ref 1043 #edb/ref 17592186069908 #edb/ref 17592186045417] [17592186068951 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186068951 #edb/ref 1045 "Applying the Integration By Parts Twice" #edb/ref 17592186045417] [17592186068951 #edb/ref 1046 #edb/ref 17592186069905 #edb/ref 17592186045417] [17592186068951 #edb/ref 1049 #edb/ref 17592186049069 #edb/ref 17592186045417] [17592186068951 #edb/ref 1053 #uuid "347053fb-b31c-5623-b4db-4c770ada4d18" #edb/ref 17592186045417] [17592186069032 #edb/ref 1068 #edb/ref 17592186065625 #edb/ref 17592186045417] [17592186069032 #edb/ref 1069 "q-12700" #edb/ref 17592186045417] [17592186069032 #edb/ref 1071 "Calculate $\\displaystyle \\int(3x^{2} + 5)e^{x}dx$." #edb/ref 17592186045417] [17592186069032 #edb/ref 1072 #uuid "5a014a29-8bc7-5ab9-a7b1-a2c515a94e18" #edb/ref 17592186045417] [17592186069905 #edb/ref 1058 #edb/ref 17592186069906 #edb/ref 17592186045417] [17592186069905 #edb/ref 1061 618537 #edb/ref 17592186045417] [17592186069905 #edb/ref 1062 #uuid "944ebf60-fe41-58ac-91a8-63c93b565add" #edb/ref 17592186045417] [17592186069905 #edb/ref 1063 #edb/ref 17592186070031 #edb/ref 17592186045417] [17592186069906 #edb/ref 1058 #edb/ref 17592186069907 #edb/ref 17592186045417] [17592186069906 #edb/ref 1061 618538 #edb/ref 17592186045417] [17592186069906 #edb/ref 1062 #uuid "f13b1e1c-2034-5d26-b6a0-2b5227d65b96" #edb/ref 17592186045417] [17592186069906 #edb/ref 1063 #edb/ref 17592186068919 #edb/ref 17592186045417] [17592186069907 #edb/ref 1058 #edb/ref 17592186069908 #edb/ref 17592186045417] [17592186069907 #edb/ref 1061 618541 #edb/ref 17592186045417] [17592186069907 #edb/ref 1062 #uuid "c22a3f17-9151-565b-8158-62703c1da221" #edb/ref 17592186045417] [17592186069907 #edb/ref 1063 #edb/ref 17592186068920 #edb/ref 17592186045417] [17592186069908 #edb/ref 1061 618544 #edb/ref 17592186045417] [17592186069908 #edb/ref 1062 #uuid "fbb28f81-ea51-5172-9911-15b8c5ea0ef5" #edb/ref 17592186045417] [17592186069908 #edb/ref 1063 #edb/ref 17592186068921 #edb/ref 17592186045417] [17592186070031 #edb/ref 1064 "We know that we can use the method of integration by parts to evaluate $\\displaystyle \\int xe^{4x} \\textrm{d}x.$ Now, suppose that we want to calculate $\\displaystyle \\int x^2e^{4x} \\textrm{d}x.$ Can we use integration by parts in this case?\n\nLet's  try. We define $u$ and $v$ as follows:\n\n$$\n\\begin{aligned}u={x}^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=2x\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{4x} & \\,⟹\\,v=\\int {e}^{4x}\\text{d}x=\\frac{1}{4}\\,{e}^{4x}\\,.\\end{aligned}\n$$\n\nSo the formula for integration by parts leads to\n\n$$\n\\begin{aligned}\\int {x}^{2}{e}^{4x}\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & ={x}^{2}(\\frac{1}{4}\\,{e}^{4x})-\\int (\\frac{1}{4}\\,{e}^{4x})2x\\,\\text{d}x \\\\  & =\\frac{1}{4}\\,{x}^{2}{e}^{4x}-\\frac{1}{2}\\int x{e}^{4x}\\text{d}x.\\end{aligned}\n$$\n\nWe still don't have an answer, but the problem is reduced to the calculation of a simpler integral  $\\displaystyle \\int xe^{4x} \\textrm{d}x.$ To compute this integral, we just need to apply the integration by parts formula again. For this second integral, we take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{4x} & \\,⟹\\,v=\\int {e}^{4x}\\text{d}x=\\frac{1}{4}\\,{e}^{4x}\\,.\\end{aligned}\n$$\n\nNow, integration by parts gives\n\n$$\n\\begin{aligned}\\int x{e}^{4x}\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & =x(\\frac{1}{4}\\,{e}^{4x})-\\int (\\frac{1}{4}\\,{e}^{4x})\\cdot 1\\,\\text{d}x \\\\  & =\\frac{1}{4}\\,x{e}^{4x}-\\frac{1}{4}(\\frac{1}{4}\\,{e}^{4x})+{C}_{1} \\\\  & =\\frac{1}{4}\\,x{e}^{4x}-\\frac{1}{16}\\,{e}^{4x}+{C}_{1}\\,,\\end{aligned}\n$$\n\nwhere $C_1$ is a constant of integration.\nSo we have\n\n$$\n\\begin{aligned}\\int {x}^{2}{e}^{4x}\\text{d}x & =\\frac{1}{4}\\,{x}^{2}{e}^{4x}-\\frac{1}{2}\\int x{e}^{4x}\\text{d}x \\\\  & =\\frac{1}{4}\\,{x}^{2}{e}^{4x}-\\frac{1}{2}(\\frac{1}{4}\\,x{e}^{4x}-\\frac{1}{16}\\,{e}^{4x}+{C}_{1}) \\\\  & =\\frac{1}{4}\\,{x}^{2}{e}^{4x}-\\frac{1}{8}\\,x{e}^{4x}+\\frac{1}{32}\\,{e}^{4x}-\\frac{{C}_{1}}{2} \\\\  & =\\frac{1}{32}\\,{e}^{4x}(8{x}^{2}-4x+1)+C\\end{aligned}\n$$\n\nwhere $C = -\\dfrac{C_1}{2}.$" #edb/ref 17592186045417] [17592186070031 #edb/ref 1065 901 #edb/ref 17592186045417] [17592186070031 #edb/ref 1066 #uuid "35a2eb7b-569b-5939-bcc0-2261596617e8" #edb/ref 17592186045417] [17592186070031 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186247435 #edb/ref 1080 "\\frac{2{e}^{2}-3}{4{ln}^{2}⁡2}" #edb/ref 17592186045417] [17592186247435 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247435 #edb/ref 1083 #uuid "01c50259-96ff-5091-b6d8-d010aabcd87a" #edb/ref 17592186045417] [17592186248249 #edb/ref 1080 "2{e}^{2}+3" #edb/ref 17592186045417] [17592186248249 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248249 #edb/ref 1083 #uuid "5b1b58be-7936-591f-a3c9-e22825f21d58" #edb/ref 17592186045417] [17592186248293 #edb/ref 1080 "4{e}^{3}-1" #edb/ref 17592186045417] [17592186248293 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248293 #edb/ref 1083 #uuid "602d95a8-3c49-5628-a5fc-26ae6d4442af" #edb/ref 17592186045417] [17592186248981 #edb/ref 1080 "\\frac{5{e}^{3}-2}{3{ln}^{2}⁡2}" #edb/ref 17592186045417] [17592186248981 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248981 #edb/ref 1083 #uuid "ae45cdbd-b5db-5833-8170-fccfe8733b9e" #edb/ref 17592186045417] [17592186249543 #edb/ref 1080 "\\frac{{e}^{3}-1}{{ln}^{2}⁡2}" #edb/ref 17592186045417] [17592186249543 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186249543 #edb/ref 1083 #uuid "f16fc0ad-7654-55ab-873b-8984cf712d78" #edb/ref 17592186045417] [17592186249799 #edb/ref 1075 #edb/ref 17592186247435 #edb/ref 17592186045417] [17592186249799 #edb/ref 1075 #edb/ref 17592186248249 #edb/ref 17592186045417] [17592186249799 #edb/ref 1075 #edb/ref 17592186248293 #edb/ref 17592186045417] [17592186249799 #edb/ref 1075 #edb/ref 17592186248981 #edb/ref 17592186045417] [17592186249799 #edb/ref 1075 #edb/ref 17592186249543 #edb/ref 17592186045417] [17592186249799 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186249799 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186249799 #edb/ref 1078 #edb/ref 17592186248981 #edb/ref 17592186045417] [17592186249799 #edb/ref 1079 #uuid "46bceeef-1e66-56f1-87c4-0b40ebcc4c53" #edb/ref 17592186045417] [17592186250326 #edb/ref 1068 #edb/ref 17592186249799 #edb/ref 17592186045417] [17592186250326 #edb/ref 1069 "q-114942" #edb/ref 17592186045417] [17592186250326 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186250326 #edb/ref 1071 "Evaluate ${\\int }_{1}^{e}9{x}^{2}({log}_{2}⁡x)^{2}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186250326 #edb/ref 1072 #uuid "c7237523-38ec-5167-93d0-30747905ffb7" #edb/ref 17592186045417] [17592186250326 #edb/ref 1074 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=({log}_{2}⁡x)^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2{log}_{2}⁡x}{x\\operatorname{ln}⁡2} \\\\ \\frac{\\text{d}v}{\\text{d}x}=9{x}^{2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 9{x}^{2}\\,\\text{d}x=3{x}^{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 9{x}^{2}({log}_{2}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={({log}_{2}⁡x)}^{2}(3{x}^{3})-\\int (3{x}^{3})(\\frac{2{log}_{2}⁡x}{x\\operatorname{ln}⁡2})\\,\\text{d}x \\\\  & =3{x}^{3}{({log}_{2}⁡x)}^{2}-\\frac{6}{\\operatorname{ln}⁡2}\\int {x}^{2}{log}_{2}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate  $\\int {x}^{2}{log}_{2}⁡x\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u={log}_{2}⁡x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2} \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {x}^{2}\\,\\text{d}x=\\frac{{x}^{3}}{3}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{2}{log}_{2}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{2}⁡x)(\\frac{{x}^{3}}{3})-\\int (\\frac{{x}^{3}}{3})(\\frac{1}{x\\operatorname{ln}⁡2})\\,\\text{d}x \\\\  & =\\frac{{x}^{3}{log}_{2}⁡x}{3}-\\frac{1}{3\\operatorname{ln}⁡2}\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}{log}_{2}⁡x}{3}-\\frac{{x}^{3}}{9\\operatorname{ln}⁡2}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int 9{x}^{2}({log}_{2}⁡x)^{2}\\,\\text{d}x & =3{x}^{3}{({log}_{2}⁡x)}^{2}-\\frac{6}{\\operatorname{ln}⁡2}(\\frac{{x}^{3}{log}_{2}⁡x}{3}-\\frac{{x}^{3}}{9\\operatorname{ln}⁡2}+D) \\\\  & =3{x}^{3}{({log}_{2}⁡x)}^{2}-\\frac{2{x}^{3}{log}_{2}⁡x}{\\operatorname{ln}⁡2}+\\frac{2{x}^{3}}{3{ln}^{2}⁡2}+C \\\\  & =\\frac{3{x}^{3}{ln}^{2}⁡x}{{ln}^{2}⁡2}-\\frac{2{x}^{3}\\operatorname{ln}⁡x}{{ln}^{2}⁡2}+\\frac{2{x}^{3}}{3{ln}^{2}⁡2}+C \\\\  & =\\frac{{x}^{3}}{{ln}^{2}⁡2}(3{ln}^{2}⁡x-2\\operatorname{ln}⁡x+\\frac{2}{3})+C.\\end{aligned}\n$$\n\nwhere $C=-\\frac{6D}{\\operatorname{ln}⁡2}.$\n\nNote that in the above calculation we used the change of base formula ${log}_{2}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}.$\n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}9{x}^{2}({log}_{2}⁡x)^{2}\\,\\text{d}x & ={[\\frac{{x}^{3}}{{ln}^{2}⁡2}(3{ln}^{2}⁡x-2\\operatorname{ln}⁡x+\\frac{2}{3})]}_{1}^{e} \\\\  & =\\frac{{e}^{3}}{{ln}^{2}⁡2}(3{ln}^{2}⁡e-2\\operatorname{ln}⁡e+\\frac{2}{3})-\\frac{{1}^{3}}{{ln}^{2}⁡2}(3{ln}^{2}⁡1-2\\operatorname{ln}⁡1+\\frac{2}{3}) \\\\  & =\\frac{{e}^{3}}{{ln}^{2}⁡2}(3-2+\\frac{2}{3})-\\frac{1}{{ln}^{2}⁡2}(0-0+\\frac{2}{3}) \\\\  & =\\frac{5{e}^{3}}{3{ln}^{2}⁡2}-\\frac{2}{3{ln}^{2}⁡2} \\\\  & =\\frac{5{e}^{3}-2}{3{ln}^{2}⁡2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186319999 #edb/ref 1080 "15{e}^{3}-6" #edb/ref 17592186045417] [17592186319999 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186319999 #edb/ref 1083 #uuid "c6fd4649-2cb0-50b2-a4a2-46c4c7a01fc5" #edb/ref 17592186045417] [17592186320632 #edb/ref 1075 #edb/ref 17592186319999 #edb/ref 17592186045417] [17592186320632 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186320632 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186320632 #edb/ref 1078 #edb/ref 17592186319999 #edb/ref 17592186045417] [17592186320632 #edb/ref 1079 #uuid "e16c7d3b-53ab-5ba9-8034-5398c600be0c" #edb/ref 17592186045417] [17592186320956 #edb/ref 1068 #edb/ref 17592186320632 #edb/ref 17592186045417] [17592186320956 #edb/ref 1069 "q-352122" #edb/ref 17592186045417] [17592186320956 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186320956 #edb/ref 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{e}81{x}^{2}({log}_{4}⁡x)^{2}\\,\\text{d}x=\\frac{1}{{ln}^{2}⁡4}(${{field-1}}$)$" #edb/ref 17592186045417] [17592186320956 #edb/ref 1072 #uuid "ebbb3ae8-e373-5e9a-af80-1375d64670c5" #edb/ref 17592186045417] [17592186320956 #edb/ref 1074 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=({log}_{4}⁡x)^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2{log}_{4}⁡x}{x\\operatorname{ln}⁡4} \\\\ \\frac{\\text{d}v}{\\text{d}x}=81{x}^{2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 81{x}^{2}\\,\\text{d}x=27{x}^{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 81{x}^{2}({log}_{4}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={({log}_{4}⁡x)}^{2}(27{x}^{3})-\\int (27{x}^{3})(\\frac{2{log}_{4}⁡x}{x\\operatorname{ln}⁡4})\\,\\text{d}x \\\\  & =27{x}^{3}{({log}_{4}⁡x)}^{2}-\\frac{54}{\\operatorname{ln}⁡4}\\int {x}^{2}{log}_{4}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate  $\\int {x}^{2}{log}_{4}⁡x\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u={log}_{4}⁡x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4} \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {x}^{2}\\,\\text{d}x=\\frac{{x}^{3}}{3}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{2}{log}_{4}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{4}⁡x)(\\frac{{x}^{3}}{3})-\\int (\\frac{{x}^{3}}{3})(\\frac{1}{x\\operatorname{ln}⁡4})\\,\\text{d}x \\\\  & =\\frac{{x}^{3}{log}_{4}⁡x}{3}-\\frac{1}{3\\operatorname{ln}⁡4}\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}{log}_{4}⁡x}{3}-\\frac{{x}^{3}}{9\\operatorname{ln}⁡4}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int 81{x}^{2}({log}_{4}⁡x)^{2}\\,\\text{d}x & =27{x}^{3}{({log}_{4}⁡x)}^{2}-\\frac{54}{\\operatorname{ln}⁡4}(\\frac{{x}^{3}{log}_{4}⁡x}{3}-\\frac{{x}^{3}}{9\\operatorname{ln}⁡4}+D) \\\\  & =27{x}^{3}{({log}_{4}⁡x)}^{2}-\\frac{18{x}^{3}{log}_{4}⁡x}{\\operatorname{ln}⁡4}+\\frac{6{x}^{3}}{{ln}^{2}⁡4}+C \\\\  & =\\frac{27{x}^{3}{ln}^{2}⁡x}{{ln}^{2}⁡4}-\\frac{18{x}^{3}\\operatorname{ln}⁡x}{{ln}^{2}⁡4}+\\frac{6{x}^{3}}{{ln}^{2}⁡4}+C \\\\  & =\\frac{{x}^{3}}{{ln}^{2}⁡4}(27{ln}^{2}⁡x-18\\operatorname{ln}⁡x+6)+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{54D}{\\operatorname{ln}⁡4}.$\n\nNote that in the above calculation, we used the change of base formula ${log}_{4}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡4}.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}81{x}^{2}({log}_{4}⁡x)^{2}\\,\\text{d}x & ={[\\frac{{x}^{3}}{{ln}^{2}⁡4}(27{ln}^{2}⁡x-18\\operatorname{ln}⁡x+6)]}_{1}^{e} \\\\  & =\\frac{{e}^{3}}{{ln}^{2}⁡4}(27{ln}^{2}⁡e-18\\operatorname{ln}⁡e+6)-\\frac{{1}^{3}}{{ln}^{2}⁡4}(27{ln}^{2}⁡1-18\\operatorname{ln}⁡1+6) \\\\  & =\\frac{{e}^{3}}{{ln}^{2}⁡4}(27-18+6)-\\frac{1}{{ln}^{2}⁡4}(0-0+6) \\\\  & =\\frac{15{e}^{3}}{{ln}^{2}⁡4}-\\frac{6}{{ln}^{2}⁡4} \\\\  & =\\frac{1}{{ln}^{2}⁡4}(\\,15{e}^{3}-6\\,)\\end{aligned}\n$$" #edb/ref 17592186045417]}
