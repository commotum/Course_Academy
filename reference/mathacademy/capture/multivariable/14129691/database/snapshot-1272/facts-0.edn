edb/ref 17592186045417] [17592186050929 #edb/ref 1027 #edb/ref 17592186050355 #edb/ref 17592186045417] [17592186050929 #edb/ref 1027 #edb/ref 17592186050521 #edb/ref 17592186045417] [17592186050929 #edb/ref 1027 #edb/ref 17592186050787 #edb/ref 17592186045417] [17592186050929 #edb/ref 1028 #edb/ref 17592186064245 #edb/ref 17592186045417] [17592186050929 #edb/ref 1028 #edb/ref 17592186064246 #edb/ref 17592186045417] [17592186050929 #edb/ref 1028 #edb/ref 17592186064274 #edb/ref 17592186045417] [17592186050929 #edb/ref 1031 "Introduction to Integration by Parts" #edb/ref 17592186045417] [17592186050929 #edb/ref 1033 317 #edb/ref 17592186045417] [17592186050929 #edb/ref 1035 #uuid "7280f087-059d-5524-8f8b-a1fe79b4ef9d" #edb/ref 17592186045417] [17592186065625 #edb/ref 1075 #edb/ref 17592186065626 #edb/ref 17592186045417] [17592186065625 #edb/ref 1075 #edb/ref 17592186065627 #edb/ref 17592186045417] [17592186065625 #edb/ref 1075 #edb/ref 17592186065628 #edb/ref 17592186045417] [17592186065625 #edb/ref 1075 #edb/ref 17592186065629 #edb/ref 17592186045417] [17592186065625 #edb/ref 1075 #edb/ref 17592186065630 #edb/ref 17592186045417] [17592186065625 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186065625 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186065625 #edb/ref 1079 #uuid "a4f06b9e-a3ba-5cdd-b2de-b01063749823" #edb/ref 17592186045417] [17592186065626 #edb/ref 1080 "e^{x}(3x^{2} - 2x + 7) + C" #edb/ref 17592186045417] [17592186065626 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186065626 #edb/ref 1083 #uuid "97206e85-b5fa-5758-939d-0840debe9d8d" #edb/ref 17592186045417] [17592186065627 #edb/ref 1080 "e^{x}(6x^{2} - 3x + 1) + C" #edb/ref 17592186045417] [17592186065627 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186065627 #edb/ref 1083 #uuid "d2b01923-dacc-5ee7-aa33-53c34299f420" #edb/ref 17592186045417] [17592186065628 #edb/ref 1080 "e^{x}(x^{2} + 2x - 11) + C" #edb/ref 17592186045417] [17592186065628 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186065628 #edb/ref 1083 #uuid "ea52abfd-2f18-593d-ad80-f97bee360e03" #edb/ref 17592186045417] [17592186065629 #edb/ref 1080 "e^{x}(3x^{2} - 6x + 11) + C" #edb/ref 17592186045417] [17592186065629 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186065629 #edb/ref 1083 #uuid "67d840a8-0c83-5837-97b3-6b0f4527be00" #edb/ref 17592186045417] [17592186065630 #edb/ref 1080 "e^{x}(3x^{2} + 6x - 1) + C" #edb/ref 17592186045417] [17592186065630 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186065630 #edb/ref 1083 #uuid "7dbbbdc4-edfe-548b-aba2-a9f23937a0c6" #edb/ref 17592186045417] [17592186068571 #edb/ref 1069 "e-495" #edb/ref 17592186045417] [17592186068571 #edb/ref 1071 "Evaluate the integral $\\displaystyle \\int x^2\\cos(3x) \\textrm{d}x.$" #edb/ref 17592186045417] [17592186068571 #edb/ref 1072 #uuid "c1dcb0a7-441f-5628-ba23-71d43d9ea96c" #edb/ref 17592186045417] [17592186068571 #edb/ref 1074 "In this case, we define\n\n$$\n\\begin{aligned}u={x}^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=2x\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(3x) & \\,⟹\\,v=\\int \\operatorname{cos}⁡(3x)\\text{d}x=\\frac{1}{3}\\,\\operatorname{sin}⁡(3x)\\,.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{cos}⁡(3x)\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & =({x}^{2})(\\frac{1}{3}\\,\\operatorname{sin}⁡(3x))-\\int (\\frac{1}{3}\\,\\operatorname{sin}⁡(3x))2x\\,\\text{d}x \\\\  & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)-\\frac{2}{3}\\int x\\operatorname{sin}⁡(3x)\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\displaystyle \\int x\\sin(3x) \\textrm{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(3x) & \\,⟹\\,v=\\int \\operatorname{sin}⁡(3x)\\text{d}x=-\\,\\frac{1}{3}\\,\\operatorname{cos}⁡(3x)\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡(3x)\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & =x(-\\,\\frac{1}{3}\\,\\operatorname{cos}⁡(3x))-\\int (-\\,\\frac{1}{3}\\,\\operatorname{cos}⁡(3x))\\cdot 1\\,\\text{d}x \\\\  & =-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{3}\\int \\operatorname{cos}⁡(3x)\\text{d}x \\\\  & =-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{3}(\\frac{1}{3}\\,\\operatorname{sin}⁡(3x))+{C}_{1} \\\\  & =-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{9}\\,\\operatorname{sin}⁡(3x)+{C}_{1}\\,\\end{aligned}\n$$\n\nwhere $C_1$ is a constant of integration.\nSo we have\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{cos}⁡(3x)\\text{d}x & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)-\\frac{2}{3}\\int x\\operatorname{sin}⁡(3x)\\text{d}x \\\\  & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)-\\frac{2}{3}(-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{9}\\,\\operatorname{sin}⁡(3x)+{C}_{1}) \\\\  & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)+\\frac{2}{9}x\\operatorname{cos}⁡(3x)-\\frac{2}{27}\\operatorname{sin}⁡(3x)-\\frac{2{C}_{1}}{3} \\\\  & =\\frac{1}{27}((9{x}^{2}-2)\\operatorname{sin}⁡(3x)+6x\\operatorname{cos}⁡(3x))+C,\\end{aligned}\n$$\n\nwhere $C = -\\dfrac{2C_1}{3}.$" #edb/ref 17592186045417] [17592186068572 #edb/ref 1069 "e-496" #edb/ref 17592186045417] [17592186068572 #edb/ref 1071 "Evaluate the integral $\\displaystyle \\int_1^e 32x^3(\\ln x)^2 \\textrm{d}x.$" #edb/ref 17592186045417] [17592186068572 #edb/ref 1072 #uuid "b81ff533-2067-5d1a-b265-df1ad91fa8da" #edb/ref 17592186045417] [17592186068572 #edb/ref 1074 "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=(\\operatorname{ln}⁡x)^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡x}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=32{x}^{3} & \\,⟹\\,v=\\int 32{x}^{3}\\text{d}x=8{x}^{4}\\,.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 32{x}^{3}(\\operatorname{ln}⁡x)^{2}\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & ={(\\operatorname{ln}⁡x)}^{2}(8{x}^{4})-\\int (8{x}^{4})(\\frac{2\\operatorname{ln}⁡x}{x})\\text{d}x \\\\  & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-16\\int {x}^{3}\\operatorname{ln}⁡(x)\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\displaystyle\\int {x^3\\ln(x)} \\textrm{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x) & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{3} & \\,⟹\\,v=\\int {x}^{3}\\text{d}x=\\frac{{x}^{4}}{4}\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{3}\\operatorname{ln}⁡(x)\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & =\\operatorname{ln}⁡(x)(\\frac{{x}^{4}}{4})-\\int (\\frac{{x}^{4}}{4})(\\frac{1}{x})\\text{d}x \\\\  & =\\frac{{x}^{4}\\operatorname{ln}⁡(x)}{4}-\\frac{1}{4}\\int {x}^{3}\\text{d}x \\\\  & =\\frac{{x}^{4}\\operatorname{ln}⁡(x)}{4}-\\frac{{x}^{4}}{16}+{C}_{1}\\end{aligned}\n$$\n\nwhere $C_1$ is an integral constant. So, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 32{x}^{3}(\\operatorname{ln}⁡x)^{2}\\text{d}x & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-16\\int {x}^{3}\\operatorname{ln}⁡(x)\\text{d}x \\\\  & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-16(\\frac{{x}^{4}\\operatorname{ln}⁡(x)}{4}-\\frac{{x}^{4}}{16}+{C}_{1}) \\\\  & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-4{x}^{4}\\operatorname{ln}⁡(x)+{x}^{4}-16{C}_{1} \\\\  & ={x}^{4}(8{(\\operatorname{ln}⁡x)}^{2}-4\\operatorname{ln}⁡(x)+1)+C\\,\\end{aligned}\n$$\n\nwhere $C = -4C_1.$ Finally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}32{x}^{3}\\operatorname{ln}⁡(x)\\text{d}x & ={{x}^{4}(8{(\\operatorname{ln}⁡x)}^{2}-4\\operatorname{ln}⁡(x)+1)|}_{1}^{e} \\\\  & =[(e)^{4}(8{(\\operatorname{ln}⁡(e))}^{2}-4\\operatorname{ln}⁡(e)+1)]-[(1)^{4}(8{(\\operatorname{ln}⁡(1))}^{2}-4\\operatorname{ln}⁡(1)+1)] \\\\  & =[{e}^{4}(8-4+1)]-1 \\\\  & =5{e}^{4}-1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186068636 #edb/ref 1069 "e-7053" #edb/ref 17592186045417] [17592186068636 #edb/ref 1071 "Evaluate the integral $\\displaystyle \\int_0^1 (t^2+1)e^{2t+1} \\, \\textrm{d} t.$" #edb/ref 17592186045417] [17592186068636 #edb/ref 1072 #uuid "8ec71af3-4534-5ef1-8745-3220102ba838" #edb/ref 17592186045417] [17592186068636 #edb/ref 1074 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={t}^{2}+1\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=2t, \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{2t+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{2t+1}\\,\\text{d}t=\\frac{{e}^{2t+1}}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get \n\n$$\n\\begin{aligned}\\int ({t}^{2}+1){e}^{2t+1}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =({t}^{2}+1)(\\frac{{e}^{2t+1}}{2})-\\int (\\frac{{e}^{2t+1}}{2})(2t)\\,\\text{d}t \\\\  & =\\frac{({t}^{2}+1){e}^{2t+1}}{2}-\\int t\\,{e}^{2t+1}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\displaystyle\\int t\\,e^{2t+1}\\,\\textrm{d}t.$ We take\n\n$$\n\\begin{aligned}u=t\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=1 \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{2t+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{2t+1}\\,\\text{d}t=\\frac{{e}^{2t+1}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int t\\,{e}^{2t+1}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =(t)(\\frac{{e}^{2t+1}}{2})-\\int (\\frac{{e}^{2t+1}}{2})(1)\\,\\text{d}t \\\\  & =\\frac{t\\,{e}^{2t+1}}{2}-\\frac{1}{2}\\int {e}^{2t+1}\\,\\text{d}t \\\\  & =\\frac{t\\,{e}^{2t+1}}{2}-\\frac{{e}^{2t+1}}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int ({t}^{2}+1){e}^{2t+1}\\,\\text{d}t & =\\frac{({t}^{2}+1){e}^{2t+1}}{2}-\\int t\\,{e}^{2t+1}\\,\\text{d}t \\\\  & =\\frac{({t}^{2}+1){e}^{2t+1}}{2}-(\\frac{t\\,{e}^{2t+1}}{2}-\\frac{{e}^{2t+1}}{4}+D) \\\\  & =\\frac{({t}^{2}+1){e}^{2t+1}}{2}-\\frac{t\\,{e}^{2t+1}}{2}+\\frac{{e}^{2t+1}}{4}-D \\\\  & =\\frac{{e}^{2t+1}}{4}(2{t}^{2}-2t+3)+C,\\end{aligned}\n$$\n\nwhere $C = -{D}.$ \n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}({t}^{2}+1){e}^{2t+1}\\,\\text{d}t & ={[\\frac{{e}^{2t+1}}{4}(2{t}^{2}-2t+3)]}_{0}^{1} \\\\  & =(\\frac{{e}^{2(1)+1}}{4}(2(1)^{2}-2(1)+3))-(\\frac{{e}^{2(0)+1}}{4}(2(0)^{2}-2(0)+3)) \\\\  & =\\frac{{e}^{3}}{4}(2-2+3)-\\frac{e}{4}(0-0+3) \\\\  & =\\frac{3{e}^{3}}{4}-\\frac{3e}{4} \\\\  & =\\frac{3{e}^{3}-3e}{4}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186068919 #edb/ref 1037 #edb/ref 17592186050929 #edb/ref 17592186045417] [17592186068919 #edb/ref 1038 #edb/ref 17592186069032 #edb/ref 17592186045417] [17592186068919 #edb/ref 1038 #edb/ref 17592186069034 #edb/ref 17592186045417] [17592186068919 #edb/ref 1038 #edb/ref 17592186250302 #edb/ref 17592186045417] [17592186068919 #edb/ref 1038 #edb/ref 17592186250303 #edb/ref 17592186045417] [17592186068919 #edb/ref 1038 #edb/re