\\ 1\\end{aligned}]$\nmust also approach infinity as $t\\to \\infty .$ So, we must have ${\\lambda }_{2}>0.$\n\nAmong the options, the only system that satisfies ${\\lambda }_{1}>0$ and ${\\lambda }_{2}>0$ is the following:\n\n$$\n\\{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=5y(t)\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186304228 :answer-field/correct "answer-26cb1313-cc4b-5e31-9f18-3cfc7ec110a8" :answer-field/choices ["answer-ffd9cbe1-e326-51cf-a4ba-bd78d4502dbc" "answer-440195cb-4e5f-52fe-ad78-0e0489a4ecb2" "answer-bce893e8-8e10-5fc4-b034-d7d313166c75" "answer-0de9ddad-24fb-5905-a359-2bc196905c9c" "answer-26cb1313-cc4b-5e31-9f18-3cfc7ec110a8"] :db/ensure [:answer-field/validate]} {:db/id "answer-ffd9cbe1-e326-51cf-a4ba-bd78d4502dbc" :answer/id #uuid "ffd9cbe1-e326-51cf-a4ba-bd78d4502dbc" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}{x}^{′}(t)=-2x(t) \\\\ {y}^{′}(t)=-5y(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-440195cb-4e5f-52fe-ad78-0e0489a4ecb2" :answer/id #uuid "440195cb-4e5f-52fe-ad78-0e0489a4ecb2" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}{x}^{′}(t)=-2x(t) \\\\ {y}^{′}(t)=5y(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-bce893e8-8e10-5fc4-b034-d7d313166c75" :answer/id #uuid "bce893e8-8e10-5fc4-b034-d7d313166c75" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}{x}^{′}(t)=-5x(t) \\\\ {y}^{′}(t)=-2y(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-0de9ddad-24fb-5905-a359-2bc196905c9c" :answer/id #uuid "0de9ddad-24fb-5905-a359-2bc196905c9c" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=-5y(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-26cb1313-cc4b-5e31-9f18-3cfc7ec110a8" :answer/id #uuid "26cb1313-cc4b-5e31-9f18-3cfc7ec110a8" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=5y(t)\\end{aligned}" :d