-a93f-16a91719aedb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}{x}^{′}(t)=-2x(t) \\\\ {y}^{′}(t)=-5y(t)\\end{aligned}" :db/id #edb/ref 17592186302711} {:answer/id #uuid "3c01e9b5-15d3-52f0-8f07-a189f7082c92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=-5y(t)\\end{aligned}" :db/id #edb/ref 17592186302829} {:answer/id #uuid "427e2b97-1fea-56d0-bae7-a59bd9759556" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}{x}^{′}(t)=-2x(t) \\\\ {y}^{′}(t)=5y(t)\\end{aligned}" :db/id #edb/ref 17592186302874} {:answer/id #uuid "a261cdba-cb5e-56eb-97fa-18ea9aa170f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=5y(t)\\end{aligned}" :db/id #edb/ref 17592186303457} {:answer/id #uuid "d1ed05c5-97f5-58a2-b3db-f6921d66323c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}{x}^{′}(t)=5x(t) \\\\ {y}^{′}(t)=-2y(t)\\end{aligned}" :db/id #edb/ref 17592186303753}] :answer-field/correct {:answer/id #uuid "27ab3534-2651-5e43-a93f-16a91719aedb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}{x}^{′}(t)=-2x(t) \\\\ {y}^{′}(t)=-5y(t)\\end{aligned}" :db/id #edb/ref 17592186302711} :answer-field/id #uuid "944c7b25-3884-507a-a956-181eee6a96ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304474}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3495d1a5-5d34-547b-9b7d-bfc79add2594" :question/math-academy-id "q-332717" :question/problem "![](images/03/039bae0d2eedf7d12d8283b2b134855c531efcba1bd0fa14fe9f841b28d5204e.png)\n\nConsider the phase portrait for a decoupled system above.\nWhich of the following systems could correspond to the given portrait?" :question/worked-solution "Writing a decoupled system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nSince our system is decoupled, its eigenvectors are parallel to the axes. These correspond to so-called straight-line solutions of the form\n\n$$\n{c}_{1}{e}^{{\\lambda }_{1}t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]\\,\\text{and}\\,{c}_{2}{e}^{{\\lambda }_{2}t}[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nNow, notice that:\n\n- The tangents along the $x$-axis are pointing toward the origin, meaning that the solutions of the form \n${c}_{1}{e}^{{\\lambda }_{1}t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nmust approach the origin as $t\\to \\infty .$ So, we must have ${\\lambda }_{1}<0.$\n\n- The tangents along the $y$-axis are also pointing toward the origin, meaning that the solutions of the form \n${c}_{2}{e}^{{\\lambda }_{2}t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nmust also approach the origin as $t\\to \\infty .$ So, we must have ${\\lambda }_{2}<0.$\n\nAmong the options, the only system that satisfies ${\\lambda }_{1}<0$ and ${\\lambda }_{2}<0$ is the following:\n\n$$\n{\\begin{aligned}{x}^{′}(t)=-2x(t) \\\\ {y}^{′}(t)=-5y(t)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308404 :knowledge-point/_questions [{:db/id #edb/ref 17592186166914 :knowledge-point/id #uuid "1c5ee85e-c6ce-5c8e-bb14-d0a32d6810e4" :knowledge-point/title "Identifying the Phase Portrait Given a System: Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085486de-a0c1-555a-9181-b4b425a4fe03" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/ef7ed85b18002aeec299826750ecc6306c90db8bf2c9bbd9bd8173af0ee9ea41.png" :db/id #edb/ref 17592186305229} {:answer/id #uuid "6560fb87-3260-5d7b-9f4a-a880c5cbdb8c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b9/b930f98928e3c4af06434c720d953ad0fcee17500113ed9a72492eda4219a7fd.png" :db/id #edb/ref 17592186306127} {:answer/id #uuid "a66b10fb-fc03-5ace-b7f9-3b049191a810" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0b/0b2cfbe650613293fe807be4ff7e38fa6f10b2e792dae8f7f4b78f27560f59d7.png" :db/id #edb/ref 17592186306718} {:answer/id #uuid "bc1a1504-015b-5c38-b69c-6616892e04ab" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e8/e8110ea6d6a113e72e35502030afb495a23bc81106d64874582d03aae81b7c73.png" :db/id #edb/ref 17592186306904} {:answer/id #uuid "c3faec70-b3c6-579b-bf25-6087a8f1f205" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ff/ff9ffa100793101811d8aa6e0e95587ec912ef1e3f64d59fbac617a521479a5d.png" :db/id #edb/ref 17592186306976}] :answer-field/correct {:answer/id #uuid "bc1a1504-015b-5c38-b69c-6616892e04ab" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e8/e8110ea6d6a113e72e35502030afb495a23bc81106d64874582d03aae81b7c73.png" :db/id #edb/ref 17592186306904} :answer-field/id #uuid "8230b11d-8bb8-5c4c-873b-8b24da7d6f03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307929}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bf46b344-09be-5328-8704-8fe72b540c14" :question/math-academy-id "q-333184" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=6x(t) \\\\ {y}^{′}(t)=4y(t)\\end{aligned}\n$$\n\nWhich of the following could represent the phase portrait of the decoupled system above?" :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}6 & 0 \\\\ 0 & 4\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=6$ with the corresponding eigenvector $[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\n- Eigenvalue ${\\lambda }_{2}=4$ with the corresponding eigenvector $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{6t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{4t}[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nNow, notice that:\n\n- The straight-line solutions of the form\n${c}_{1}{e}^{6t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on the $x$-axis. Since ${e}^{6t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\n- The straight-line solutions of the form\n${c}_{2}{e}^{4t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nlie on the $y$-axis. Since ${e}^{4t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\nAmong the given options, there are two phase portraits satisfying these conditions:\n\n![](images/24/2473117cdca4318187b94374820c0a12576e998e7f631a6e7bf51e56c985be43.png)\n\nLet's consider the solutions $x(t)={c}_{1}{e}^{6t}$ and $y(t)={c}_{2}{e}^{4t}$ provided that ${c}_{1},{c}_{2}\\ne 0.$ Then,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}=\\frac{({c}_{2}{e}^{4t})^{′}}{({c}_{1}{e}^{6t})^{′}}=\\frac{4{c}_{2}{e}^{4t}}{6{c}_{1}{e}^{6t}}=\\frac{2{c}_{2}}{3{c}_{1}}{e}^{-2t}.\\end{aligned}\n$$\n\nSo, $\\frac{\\text{d}y}{\\text{d}x}\\to 0$ as $t\\to \\infty ,$ meaning that the tangents to the solution become more and more horizontal as we move away from the origin. This corresponds to the following phase portrait:\n\n![](images/e8/e8110ea6d6a113e72e35502030afb495a23bc81106d64874582d03aae81b7c73.png)"}] [{:db/id #edb/ref 17592186391151 :knowledge-point/_questions [{:db/id #edb/ref 17592186166914 :knowledge-point/id #uuid "1c5ee85e-c6ce-5c8e-bb14-d0a32d6810e4" :knowledge-point/title "Identifying the Phase Portrait Given a System: Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6009f5a2-68a9-5943-8731-39f000ed0199" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e8/e8e9a97ed196b5677e3c2ea6be32f4a1ab04f7721b3d9c41e4db284d69e6805a.png" :db/id #edb/ref 17592186391153} {:answer/id #uuid "1b93024f-8207-52ad-845f-920de06ed5b7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/85/85cb5c01c72b8b903cc0b5fc8c593c0b6e96550380e6bc7af55d5db5b5f40d4e.png" :db/id #edb/ref 17592186391154} {:answer/id #uuid "4a78d0da-5220-5127-8319-73b4acac217f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b4/b414b76f1fe20b5238e75281e57bb851c8e67777e225d7610631dab1b4921b82.png" :db/id #edb/ref 17592186391155} {:answer/id #uuid "c5cd3807-c498-5cde-99b9-07cd5a9bfab8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d1/d19a6d30c12f5d966578cd950db1f16a9bc309f3a24a8e2480e52edca1281f75.png" :db/id #edb/ref 17592186391156} {:answer/id #uuid "cfaa09e6-0c8b-54b3-b59e-baf355087c3e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0c/0c70e2c185d054b8cc62411736ecec2e60a716d265819a82a171076d999ef4e6.png" :db/id #edb/ref 17592186391157}] :answer-field/correct {:answer/id #uuid "6009f5a2-68a9-5943-8731-39f000ed0199" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e8/e8e9a97ed196b5677e3c2ea6be32f4a1ab04f7721b3d9c41e4db284d69e6805a.png" :db/id #edb/ref 17592186391153} :answer-field/id #uuid "69405513-1dbb-597a-8b25-1607c72536b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391152}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "619ed97d-e84b-53da-afc0-cbcda9b4c479" :question/math-academy-id "q-333193" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-3x(t) \\\\ {y}^{′}(t)=-4y(t)\\end{aligned}\n$$\n\nWhich of the following could represent the phase portrait of the decoupled system above?" :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-3 & 0 \\\\ 0 & -4\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=-3$ with the corresponding eigenvector $[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\n- Eigenvalue ${\\lambda }_{2}=-4$ with the corresponding eigenvector $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{-3t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{-4t}[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nNow, notice that:\n\n- The straight-line solutions of the form\n${c}_{1}{e}^{-3t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on the $x$-axis. Since ${e}^{-3t}\\to 0$ as $t\\to \\infty ,$ these solutions approach the origin as $t\\to \\infty .$\n\n- The straight-line solutions of the form\n${c}_{2}{e}^{-4t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nlie on the $y$-axis. Since ${e}^{-4t}\\to 0$ as $t\\to \\infty ,$ these solutions also approach the origin as $t\\to \\infty .$\n\nAmong the given options, there are two phase portraits satisfying these conditions:\n\n![](images/3f/3fdbeba46a0f4640e909b0ba489c1aec1fa87a6aa7740f19d08f274b7351d11b.png)\n\nLet's consider the solutions $x(t)={c}_{1}{e}^{-3t}$ and $y(t)={c}_{2}{e}^{-4t}$ provided that ${c}_{1},{c}_{2}\\ne 0.$ Then,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}=\\frac{({c}_{2}{e}^{-4t})^{′}}{({c}_{1}{e}^{-3t})^{′}}=\\frac{-4{c}_{2}{e}^{-4t}}{-3{c}_{1}{e}^{-3t}}=\\frac{4{c}_{2}}{3{c}_{1}}{e}^{-t}.\\end{aligned}\n$$\n\nSo, $\\frac{\\text{d}y}{\\text{d}x}\\to 0$ as $t\\to \\infty ,$ meaning that the tangents to the solution become more and more horizontal as the trajectories approach the origin. This corresponds to the following phase portrait:\n\n![](images/41/4193300af5a8950ce70e2c469812424235665faac279dac0c89289a0307ab46a.png)"}] [{:db/id #edb/ref 17592186308410 :knowledge-point/_questions [{:db/id #edb/ref 17592186166915 :knowledge-point/id #uuid "24bd917d-c4b3-5bf5-9426-a87a579b03c1" :knowledge-point/title "Classifying Decoupled Systems of Linear Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44c097c8-85f1-5397-9634-4aa36563680e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "stable" :db/id #edb/ref 17592186305825} {:answer/id #uuid "a2a0bc60-9b43-50d2-b9bf-0df6c2e76b63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unstable" :db/id #edb/ref 17592186306681} {:answer/id #uuid "de43acd4-4c97-5f63-9795-3e8b6656e915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "stable" :db/id #edb/ref 17592186307213}] :answer-field/correct {:answer/id #uuid "de43acd4-4c97-5f63-9795-3e8b6656e915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "stable" :db/id #edb/ref 17592186307213} :answer-field/id #uuid "31cafb5c-d763-5fb1-87c4-e9c2e8c3ac22" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186307679} {:answer-field/choices [{:answer/id #uuid "93b4667e-7d7f-57a7-a31f-8a61dfe45347" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a saddle point" :db/id #edb/ref 17592186306545} {:answer/id #uuid "9ec0b3b7-e0e9-5608-a90e-327de36c846e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "a stable node (sink)" :db/id #edb/ref 17592186306640} {:answer/id #uuid "d082ee8e-eefb-5bbe-841c-6485ffddeb82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a saddle point" :db/id #edb/ref 17592186307080} {:answer/id #uuid "d891b893-e54a-5b08-bfc3-413a524e9707" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "an unstable node (source)" :db/id #edb/ref 17592186307159}] :answer-field/correct {:answer/id #uuid "d082ee8e-eefb-5bbe-841c-6485ffddeb82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a saddle point" :db/id #edb/ref 17592186307080} :answer-field/id #uuid "337c1171-efd2-5892-8314-2112fd9080ec" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186307683} {:answer-field/choices [{:answer/id #uuid "2996080e-4ff9-54fb-af3b-dee66e12a2de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "unstable" :db/id #edb/ref 17592186305547} {:answer/id #uuid "3e631efa-19fd-53df-99f6-49cc8e963648" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "stable" :db/id #edb/ref 17592186305755} {:answer/id #uuid "5ed18be1-62dc-535c-89c4-e559314ebe9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unstable" :db/id #edb/ref 17592186306064}] :answer-field/correct {:answer/id #uuid "2996080e-4ff9-54fb-af3b-dee66e12a2de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "unstable" :db/id #edb/ref 17592186305547} :answer-field/id #uuid "9e4bd274-b5ff-536c-adca-f46c1bdd94e2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186308020}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "59947953-f704-5cbc-beaf-56322b9434f5" :question/math-academy-id "q-333214" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=x(t) \\\\ {y}^{′}(t)=-3y(t)\\end{aligned}\n$$\n\nSelect the correct options below regarding the given decoupled system of linear differential equations.$\\,$\nThe $x$-axis is a {{field-1}} line.\n\n$\\,$\nThe $y$-axis is a {{field-2}} line.\n\n$\\,$\nThe equilibrium point (origin) is {{field-3}}." :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}1 & 0 \\\\ 0 & -3\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nRecall that a homogeneous system of linear differential equations has a single equilibrium (fixed point) at the origin.\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=1$ with the eigenvector $[\\begin{aligned}1 \\\\ 0\\end{aligned}].$ The corresponding straight-line solutions of the form\n${c}_{1}{e}^{t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on the $x$-axis and move away from the origin as $t\\to \\infty .$ So, the $x$-axis is the $\\text{unstable}$ line.\n\n- Eigenvalue ${\\lambda }_{2}=-3$ with the eigenvector $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$ The corresponding straight-line solutions of the form\n${c}_{2}{e}^{-3t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nlie on the $y$-axis and approach the origin as $t\\to \\infty .$ So, the $y$-axis is the $\\text{stable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{a saddle point}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/6d/6dc8ceb9a1c771f18d6e90d450cd837fe80c6bab7943ab7d397d90eb45754594.png)"}]}
