      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121715/observations/step-q333188-0b280532651b8adc37f9.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121715/observations/step-q333188-0b280532651b8adc37f9.png",
      "source_url": "https://mathacademy.com/tasks/14121715/topics/3242/lesson",
      "captured_at": 1791742956.8912256,
      "math_academy_id": "q-333188",
