      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121715/observations/step-q333184-2554e94dd9ca25e0733e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121715/observations/step-q333184-2554e94dd9ca25e0733e.png",
      "source_url": "https://mathacademy.com/tasks/14121715/topics/3242/lesson",
      "captured_at": 1791742983.9423773,
      "math_academy_id": "q-333184",
