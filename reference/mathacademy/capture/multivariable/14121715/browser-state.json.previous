      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121715/observations/step-q332594-8191d9a767cbc5e18f0e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121715/observations/step-q332594-8191d9a767cbc5e18f0e.png",
