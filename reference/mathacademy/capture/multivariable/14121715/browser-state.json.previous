      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121715/observations/step-q333189-502d536a078690393cd8.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121715/observations/step-q333189-502d536a078690393cd8.png",
      "source_url": "https://mathacademy.com/tasks/14121715/topics/3242/lesson",
      "captured_at": 1791742930.1091378,
      "math_academy_id": "q-333189",
