db/ref 17592186045417] [17592186150962 #edb/ref 1083 #uuid "1958b138-6b04-5333-b9d2-5760b56a84ef" #edb/ref 17592186045417] [17592186150963 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186150963 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186150963 #edb/ref 1083 #uuid "3a8f81c6-87c9-58bf-8223-925f3a6025dd" #edb/ref 17592186045417] [17592186150964 #edb/ref 1080 "\\frac{\\sqrt{2}}{2} - 1" #edb/ref 17592186045417] [17592186150964 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186150964 #edb/ref 1083 #uuid "40179b66-de19-50e7-a649-f18747b267a0" #edb/ref 17592186045417] [17592186151949 #edb/ref 1069 "e-6313" #edb/ref 17592186045417] [17592186151949 #edb/ref 1071 "Find a definite integral with respect to $\\theta$ that is equivalent to $\\displaystyle \\int \\limits_{C} (y^2-x) \\, \\textrm ds,$ where $C$ is the section of the polar curve $r = \\cos{\\theta}\\:$ for $0 \\le \\theta \\le\\dfrac{ \\pi}4.$" #edb/ref 17592186045417] [17592186151949 #edb/ref 1072 #uuid "287a493f-e988-5cef-b0d0-4205d1eaf74e" #edb/ref 17592186045417] [17592186151949 #edb/ref 1074 "In polar coordinates, the formula for the line integral is given by\n\n$$\n\\int\\limits_C f(x,y) \\, \\textrm{d}s  = \\int_{\\theta_1}^{\\theta_2}  f(r\\cos\\theta,r\\sin\\theta) \\,\\sqrt{r^2 + \\left(\\dfrac{\\textrm d r}{\\textrm d \\theta}\\right)^2}\\,\\textrm d \\theta\\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\cos^2\\theta$ and $y=\\cos\\theta \\sin{\\theta}$, where $0 \\leq \\theta \\leq \\dfrac{\\pi}4.$\n\nNow, if $f(x,y) =y^2-x$, we obtain  \n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={(\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta )}^{2}-{cos}^{2}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta \\text{ }{sin}^{2}⁡\\theta -{cos}^{2}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta ({sin}^{2}⁡\\theta -1) \\\\  & ={cos}^{2}⁡\\theta (-{cos}^{2}⁡\\theta ) \\\\  & =-{cos}^{4}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta )=-\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{cos}⁡\\theta )}^{2}+{(-\\operatorname{sin}⁡\\theta )}^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta } \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}({y}^{2}-x)\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}-{cos}^{4}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & =-{\\int }_{0}^{\\pi /4}{cos}^{4}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186151950 #edb/ref 1069 "e-6314" #edb/ref 17592186045417] [17592186151950 #edb/ref 1071 "Evaluate the integral of the function $f(x,y)=\\dfrac{x^2+y^2}{y^2}$ along the polar curve $r=1$ for $\\dfrac{\\pi}{6}\\leq \\theta \\leq \\dfrac\\pi 2.$" #edb/ref 17592186045417] [17592186151950 #edb/ref 1072 #uuid "63aa09fb-9839-5f73-9f98-2eb9784ead43" #edb/ref 17592186045417] [17592186151950 #edb/ref 1074 "In polar coordinates, the formula for the line integral is given by\n\n$$\n\\int\\limits_C f(x,y) \\, \\textrm{d}s  = \\int_{\\theta_1}^{\\theta_2}  f(r\\cos\\theta,r\\sin\\theta) \\,\\sqrt{r^2 + \\left(\\dfrac{\\textrm d r}{\\textrm d \\theta}\\right)^2}\\,\\textrm d \\theta\\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\cos\\theta$ and $y=\\sin\\theta$, where $\\dfrac{\\pi}{6} \\leq \\theta \\leq \\dfrac{\\pi}2.$\n\nNow, since $f(x,y) = \\dfrac{x^2+y^2}{y^2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\frac{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta }{{sin}^{2}⁡\\theta } \\\\  & =\\frac{1}{{sin}^{2}⁡\\theta } \\\\  & ={csc}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(1)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta =\\sqrt{{1}^{2}+{0}^{2}}=1.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{{x}^{2}+{y}^{2}}{{y}^{2}}\\,\\text{d}s & ={\\int }_{\\pi /6}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /2}{csc}^{2}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{\\pi /2}{csc}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =-\\operatorname{cot}⁡\\theta \\,{|}_{\\pi /6}^{\\pi /2} \\\\  & =-(0-\\sqrt{3}) \\\\  & =\\sqrt{3}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186151951 #edb/ref 1069 "e-6315" #edb/ref 17592186045417] [17592186151951 #edb/ref 1071 "Evaluate the integral $\\displaystyle\\int_\\limits{C} xy(1-x^2) \\,\\textrm{d}s$, where $C$ is the polar curve $r=\\cos{\\theta}\\:$ for $0 \\leq \\theta \\leq \\dfrac{\\pi}{2}.$" #edb/ref 17592186045417] [17592186151951 #edb/ref 1072 #uuid "00b29cf2-6a73-5fd6-b8bd-04ba8c5f1a46" #edb/ref 17592186045417] [17592186151951 #edb/ref 1074 "In polar coordinates, the formula for the line integral is given by\n\n$$\n\\int\\limits_C f(x,y) \\, \\textrm{d}s  = \\int_{\\theta_1}^{\\theta_2}  f(r\\cos\\theta,r\\sin\\theta) \\,\\sqrt{r^2 + \\left(\\dfrac{\\textrm d r}{\\textrm d \\theta}\\right)^2}\\,\\textrm d \\theta\\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\cos^2\\theta$ and $y=\\cos\\theta\\sin\\theta$, where $0 \\leq \\theta \\leq \\dfrac{\\pi}{2}.$\n\nNow, if $f(x,y) = xy(1-x^2)$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={cos}^{2}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta (1-({cos}^{2}⁡\\theta )^{2}) \\\\  & ={cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta (1-{cos}^{4}⁡\\theta ).\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta }=\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta )=-\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\operatorname{cos}⁡\\theta )^{2}+(-\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta } \\\\  & =1.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy(1-{x}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta (1-{cos}^{4}⁡\\theta )\\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta (1-{cos}^{4}⁡\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\cos\\theta,$ $\\textrm d u=-\\sin\\theta\\,\\textrm d \\theta$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta (1-{cos}^{4}⁡\\theta )\\,\\text{d}\\theta  & ={\\int }_{1}^{0}-{u}^{3}(1-{u}^{4})\\,\\text{d}u \\\\  & ={\\int }_{0}^{1}({u}^{3}-{u}^{7})\\,\\text{d}u \\\\  & ={[\\frac{{u}^{4}}{4}-\\frac{{u}^{8}}{8}]}_{0}^{1} \\\\  & =(\\frac{1}{4}-\\frac{1}{8})-0 \\\\  & =\\frac{1}{8}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186152160 #edb/ref 1037 #edb/ref 17592186049041 #edb/ref 17592186045417] [17592186152160 #edb/ref 1038 #edb/ref 17592186152740 #edb/ref 17592186045417] [17592186152160 #edb/ref 1038 #edb/ref 17592186152743 #edb/ref 17592186045417] [17592186152160 #edb/ref 1038 #edb/ref 17592186284544 #edb/ref 17592186045417] [17592186152160 #edb/ref 1038 #edb/ref 17592186284545 #edb/ref 17592186045417] [17592186152160 #edb/ref 1038 #edb/ref 17592186345237 #edb/ref 17592186045417] [17592186152160 #edb/ref 1039 "Reducing the Line Integral of a Scalar Function Along a Curve to a Definite Integral" #edb/ref 17592186045417] [17592186152160 #edb/ref 1041 #edb/ref 17592186151949 #edb/ref 17592186045417] [17592186152160 #edb/ref 1042 #uuid "7e68ae67-2175-55a3-ac4a-117a340a32a4" #edb/ref 17592186045417] [17592186152161 #edb/ref 1038 #edb/ref 17592186152599 #edb/ref 17592186045417] [17592186152161 #edb/ref 1038 #edb/ref 17592186152742 #edb/ref 17592186045417] [17592186152161 #edb/ref 1038 #edb/ref 17592186345238 #edb/ref 17592186045417] [17592186152161 #edb/ref 1038 #edb/ref 17592186345242 #edb/ref 17592186045417] [17592186152161 #edb/ref 1038 #edb/r