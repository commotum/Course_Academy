mstyle style=\"color: blue;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44E TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2262\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c1D44F TEX-I\"></mjx-c></mjx-mi></mjx-mstyle></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6D\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mn>5</mn><mi>a</mi><mo>≡</mo><mn>5</mn><mi>b</mi></mstyle></mpadded></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>20</mn><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><mtext>and</mtext><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mi>a</mi><mo>≢</mo><mi>b</mi></mstyle></mpadded></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mtext>mod</mtext><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>20</mn><mo stretchy=\"false\">)</mo><mo>.</mo></math></mjx-assistive-mml></mjx-container></p>\n</blockquote>\n</div></div>",
