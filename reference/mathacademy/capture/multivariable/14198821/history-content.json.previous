=\"scale(0.707)\" xlink:href=\"#E4-MJMAIN-2212\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E4-MJMATHI-74\" x=\"778\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E4-MJMAIN-2B\" x=\"1594\" y=\"0\"></use>\n<g transform=\"translate(2595,0)\">\n <use xlink:href=\"#E4-MJMATHI-65\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E4-MJMATHI-74\" x=\"659\" y=\"408\"></use>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E4-MJMAIN-2E\" x=\"5111\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n\n            </div>           \n        </div>",
