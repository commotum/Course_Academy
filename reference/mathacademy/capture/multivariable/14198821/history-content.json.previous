"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-mrow></mjx-den></mjx-row></mjx-dtable></mjx-dbox></mjx-frac></mjx-mfrac></mjx-mstyle></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>2</mn><mi>e</mi></mrow><mrow><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msup><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle></math></mjx-assistive-mml></mjx-container></div></div></div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Wed, Oct 14th @ 2:09 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:58</span><span class=\"answerResult\"><span style=\"color: red;\">Incorrect</span></span></div></div>"
