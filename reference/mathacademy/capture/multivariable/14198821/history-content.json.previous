n>5</mn><mn>3</mn></mfrac></mstyle></math></mjx-assistive-mml></mjx-container></div></div></div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Wed, Oct 14th @ 2:13 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:39</span><span class=\"answerResult\"><span style=\"color: red;\">Incorrect</span></span></div></div>"
