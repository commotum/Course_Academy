#{[{:db/id #edb/ref 17592186166648 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166810 :knowledge-point/id #uuid "56fbaea3-3655-54cf-a3e1-5e0a5ce77c0d" :knowledge-point/title "Evaluating Hyperbolic Secant"}] :question/id #uuid "c0e85144-6e01-5311-84d4-1042856272da" :question/math-academy-id "e-8456" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nEvaluate $\\sech  \\left( -t \\right).$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe definition of $\\sech{x}$ is\n\n$$\n\\sech{x} = \\dfrac{1}{\\cosh x} = \\dfrac{2}{e^{x}+e^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡(-t) & =\\frac{2}{{e}^{-t}+{e}^{-(-t)}} \\\\  & =\\frac{2}{{e}^{-t}+{e}^{t}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166649 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166811 :knowledge-point/id #uuid "59907a9d-8d46-51d0-b568-0928211eb7e7" :knowledge-point/title "Evaluating Hyperbolic Cosecant"}] :question/id #uuid "65b73c5e-690f-5ed6-b245-c96f2b61662a" :question/math-academy-id "e-8457" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nEvaluate $\\csch (-9).$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe definition of $\\csch x$ is \n\n$$\n\\csch x = \\dfrac{1}{\\sinh x} = \\dfrac {2}{e^{x} - e^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\csch (-9) =\\dfrac{2}{e^{-9}-e^{-(-9)}}=\\dfrac{2}{e^{-9}-e^{9}}.\n$$"}] [{:db/id #edb/ref 17592186166650 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166812 :knowledge-point/id #uuid "20904d6c-07bd-5e38-818d-17cb0d608dfb" :knowledge-point/title "Evaluating Hyperbolic Cotangent"}] :question/id #uuid "40c32ead-4f17-57d2-acd3-f65f6de1fe80" :question/math-academy-id "e-8458" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nEvaluate $\\coth  (-\\ln 3).$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe definition of $\\coth x$ is \n\n$$\n\\begin{aligned}\\operatorname{coth}⁡x & =\\frac{1}{\\operatorname{tanh}⁡x} \\\\  & =\\frac{{e}^{x}+{e}^{-x}}{{e}^{x}-{e}^{-x}} \\\\  & =\\frac{{e}^{2x}+1}{{e}^{2x}-1} \\\\  & =\\frac{1+{e}^{-2x}}{1-{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the fourth definition, we get\n\n$$\n\\begin{aligned}\\operatorname{coth}⁡(-\\operatorname{ln}⁡3) & =\\frac{1+{e}^{-2(-\\operatorname{ln}⁡3)}}{1-{e}^{-2(-\\operatorname{ln}⁡3)}} \\\\  & =\\frac{1+{e}^{2\\operatorname{ln}⁡3}}{1-{e}^{2\\operatorname{ln}⁡3}} \\\\  & =\\frac{1+{e}^{\\operatorname{ln}⁡{3}^{2}}}{1-{e}^{\\operatorname{ln}⁡{3}^{2}}} \\\\  & =\\frac{1+{3}^{2}}{1-{3}^{2}} \\\\  & =\\frac{1+9}{1-9} \\\\  & =\\frac{10}{(-8)} \\\\  & =-\\frac{5}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514358 :knowledge-point/_questions [{:db/id #edb/ref 17592186166811 :knowledge-point/id #uuid "59907a9d-8d46-51d0-b568-0928211eb7e7" :knowledge-point/title "Evaluating Hyperbolic Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "411b926d-e45a-5b4c-b68a-72246da46d99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{-1/5}-{e}^{1/5}}" :db/id #edb/ref 17592186513704} {:answer/id #uuid "5104cd77-09cf-5a3e-8e98-75fadbbba893" :answer/type {:db/id #ed