-fields [{:answer-field/choices [{:answer/id #uuid "410867ce-b3b8-5f10-9651-ff906f7a04b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{\\sqrt{3}}-{e}^{-\\sqrt{3}}}" :db/id #edb/ref 17592186513703} {:answer/id #uuid "a56701fe-c949-521f-9fec-0e1cc7862336" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{\\sqrt{3}}+{e}^{-\\sqrt{3}}}" :db/id #edb/ref 17592186513957} {:answer/id #uuid "e577b69e-d3d3-55ba-8919-20b88a350fc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{3}-{e}^{-3}}" :db/id #edb/ref 17592186514135} {:answer/id #uuid "fc2e0dae-54b9-5461-9300-18d71043228a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{-\\sqrt{3}}-{e}^{\\sqrt{3}}}" :db/id #edb/ref 17592186514189} {:answer/id #uuid "fd453a3f-f5da-584f-80e4-d0e06bbaaa18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{3}+{e}^{-3}}" :db/id #edb/ref 17592186514194}] :answer-field/correct {:answer/id #uuid "fc2e0dae-54b9-5461-9300-18d71043228a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{-\\sqrt{3}}-{e}^{\\sqrt{3}}}" :db/id #edb/ref 17592186514189} :answer-field/id #uuid "375a804b-87fc-5142-975b-318473d44915" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514248}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fab073b9-61b0-51f3-a69e-3645145ce1fa" :question/math-academy-id "q-125696" :question/problem "$$\n\n$\\operatorname{csch}⁡(-\\sqrt{3})=$" :question/worked-solution "$$\n\nThe definition of $\\operatorname{csch}⁡x$ is \n\n$$\n\\operatorname{csch}⁡x=\\frac{1}{\\operatorname{sinh}⁡x}=\\frac{2}{{e}^{x}-{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{csch}⁡(-\\sqrt{3}) & =\\frac{2}{{e}^{-\\sqrt{3}}-{e}^{-(-\\sqrt{3})}} \\\\  & =\\frac{2}{{e}^{-\\sqrt{3}}-{e}^{\\sqrt{3}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514365 :knowledge-point/_questions [{:db/id #edb/ref 17592186166811 :knowledge-point/id #uuid "59907a9d-8d46-51d0-b568-0928211eb7e7" :knowledge-point/title "Evaluating Hyperbolic Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51c3df0e-f346-58f8-a1a7-e2f348dc3a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{\\sqrt{7}\\,t}-{e}^{-\\sqrt{7}\\,t}}" :db/id #edb/ref 17592186513757} {:answer/id #uuid "a756acf0-aa6d-52e6-88e8-2d4bcfb72051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{\\sqrt{7}\\,t}+{e}^{-\\sqrt{7}\\,t}}" :db/id #edb/ref 17592186513964} {:answer/id #uuid "ec243bc5-3d7b-52fd-ab4b-73c0c6a79dac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{7t}-{e}^{-7t}}" :db/id #edb/ref 17592186514152} {:answer/id #uuid "ee9d8b4f-f902-5aa7-9fd9-c20bea2a594d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{-\\sqrt{7}\\,t}-{e}^{\\sqrt{7}\\,t}}" :db/id #edb/ref 17592186514154} {:answer/id #uuid "efeddf4f-a4bb-59b8-be1d-5e20bb9b7d50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{7t}+{e}^{-7t}}" :db/id #edb/ref 17592186514157}] :answer-field/correct {:answer/id #uuid "51c3df0e-f346-58f8-a1a7-e2f348dc3a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{{e}^{\\sqrt{7}\\,t}-{e}^{-\\sqrt{7}\\,t}}" :db/id #edb/ref 17592186513757} :answer-field/id #uuid "7d773b97-3525-57be-a57f-ceea3ffecda1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514285}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0af3be74-c5b3-5ec8-af78-1603fe65ae67" :question/math-academy-id "q-125697" :question/problem "$$\n\nGiven that $t\\ne 0,$ which of the following is equivalent to $\\operatorname{csch}⁡(\\sqrt{7}\\,t)?$" :question/worked-solution "$$\n\nThe definition of $\\operatorname{csch}⁡x$ is \n\n$$\n\\operatorname{csch}⁡x=\\frac{1}{\\operatorname{sinh}⁡x}=\\frac{2}{{e}^{x}-{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\operatorname{csch}⁡(\\sqrt{7}\\,t)=\\frac{2}{{e}^{\\sqrt{7}\\,t}-{e}^{-\\sqrt{7}\\,t}}.\n$$"}] [{:db/id #edb/ref 17592186514458 :knowledge-point/_questions [{:db/id #edb/ref 17592186166810 :knowledge-point/id #uuid "56fbaea3-3655-54cf-a3e1-5e0a5ce77c0d" :knowledge-point/title "Evaluating Hyperbolic Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e707ecd-c178-55dc-854b-4e79cc7e337f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{t}}{\\sqrt{t}+1}" :db/id #edb/ref 17592186513785} {:answer/id #uuid "95c44a7e-df43-50bc-a5cd-70761f467a3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{t}}{t+1}" :db/id #edb/ref 17592186513920} {:answer/id #uuid "ea931382-e509-5b41-b3c4-5c291f5e42e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{t}}{t+1}" :db/id #edb/ref 17592186514145} {:answer/id #uuid "ebb5e7fd-8833-595e-8978-65b4198dc5b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{t}}{\\sqrt{t}+1}" :db/id #edb/ref 17592186514149} {:answer/id #uuid "fc20631b-64e7-56b3-b072-c5a52e914f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{t}}{t+1}" :db/id #edb/ref 17592186514188}] :answer-field/correct {:answer/id #uuid "95c44a7e-df43-50bc-a5cd-70761f467a3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{t}}{t+1}" :db/id #edb/ref 17592186513920} :answer-field/id #uuid "0ad40e26-871d-5735-a53a-4f67d90f045a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514212}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bc92dd53-1396-50af-a160-bf5a5b938587" :question/math-academy-id "q-125698" :question/problem "$$\n\nGiven that $t>0,$ which of the following is equivalent to $\\operatorname{sech}⁡(\\operatorname{ln}⁡\\sqrt{t})?$" :question/worked-solution "$$\n\nThe definition of $\\operatorname{sech}⁡x$ is\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡x=\\frac{1}{\\operatorname{cosh}⁡x}=\\frac{2}{{e}^{x}+{e}^{-x}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡(\\operatorname{ln}⁡\\sqrt{t}) & =\\frac{2}{{e}^{\\operatorname{ln}⁡\\sqrt{t}}+{e}^{-\\operatorname{ln}⁡\\sqrt{t}}} \\\\  & =\\frac{2}{{e}^{\\operatorname{ln}⁡\\sqrt{t}}+{e}^{\\operatorname{ln}⁡(\\sqrt{t})^{-1}}} \\\\  & =\\frac{2}{\\sqrt{t}+(\\sqrt{t})^{-1}} \\\\  & =\\frac{2}{(\\sqrt{t}+\\frac{1}{\\sqrt{t}})} \\\\  & =\\frac{2}{(\\frac{t+1}{\\sqrt{t}})} \\\\  & =\\frac{2\\sqrt{t}}{t+1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514404 :knowledge-point/_questions [{:db/id #edb/ref 17592186166810 :knowledge-point/id #uuid "56fbaea3-3655-54cf-a3e1-5e0a5ce77c0d" :knowledge-point/title "Evaluating Hyperbolic Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "041ce06a-3f86-5e30-a3fa-868512983162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2z}{1-{z}^{2}}" :db/id #edb/ref 17592186513540} {:answer/id #uuid "30f00be7-84e1-5894-80e6-57a208b88c62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2z}{{z}^{2}+1}" :db/id #edb/ref 17592186513662} {:answer/id #uuid "69fcfaa8-1f10-5a22-a6a0-edbaf0ccf489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2z}{{z}^{2}-1}" :db/id #edb/ref 17592186513817} {:answer/id #uuid "cf67f338-3bbd-5b2b-b73c-d6f9874a475c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{z}{{z}^{2}-1}" :db/id #edb/ref 17592186514075} {:answer/id #uuid "d881232c-3fdd-51aa-bc26-114e5f59ead6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{z}{{z}^{2}+1}" :db/id #edb/ref 17592186514097}] :answer-field/correct {:answer/id #uuid "30f00be7-84e1-5894-80e6-57a208b88c62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2z}{{z}^{2}+1}" :db/id #edb/ref 17592186513662} :answer-field/id #uuid "5fdec476-5453-533f-ba1c-e55425c49aeb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514272}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "558ac263-8cd5-56f3-9f79-c76511bfad24" :question/math-academy-id "q-125700" :question/problem "$$\n\nGiven that $z>0,$ which of the following is equivalent to $\\operatorname{sech}⁡(\\operatorname{ln}⁡z)?$" :question/worked-solution "$$\n\nThe definition of $\\operatorname{sech}⁡x$ is\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡x=\\frac{1}{\\operatorname{cosh}⁡x}=\\frac{2}{{e}^{x}+{e}^{-x}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡(\\operatorname{ln}⁡z) & =\\frac{2}{{e}^{\\operatorname{ln}⁡z}+{e}^{-\\operatorname{ln}⁡z}} \\\\  & =\\frac{2}{{e}^{\\operatorname{ln}⁡z}+{e}^{\\operatorname{ln}⁡{z}^{-1}}} \\\\  & =\\frac{2}{z+(z)^{-1}} \\\\  & =\\frac{2}{(z+\\frac{1}{z})} \\\\  & =\\frac{2}{(\\frac{{z}^{2}+1}{z})} \\\\  & =\\frac{2z}{{z}^{2}+1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514377 :knowledge-point/_questions [{:db/id #edb/ref 17592186166810 :knowledge-point/id #uuid "56fbaea3-3655-54cf-a3e1-5e0a5ce77c0d" :knowledge-point/title "Evaluating Hyperbolic Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fb09ddc-f58b-57c4-b0f8-adf015a93e1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{e^{7}+e^{-7}}" :db/id #edb/ref 17592186513864}] :answer-field/correct {:answer/id #uuid "7fb09ddc-f58b-57c4-b0f8-adf015a93e1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{e^{7}+e^{-7}}" :db/id #edb/ref 17592186513864} :answer-field/id #uuid "b0c89911-0451-57b8-bb87-aa95e175c6d8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514309}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "221afffc-6058-53ae-8f4b-ca54ee801c93" :question/math-academy-id "q-300672" :question/problem "$$\nEvaluate $\\operatorname{sech}⁡7.$ **Do not round** your answer.\n\n$$\n$\\operatorname{sech}⁡7=$\n{{field-1}}" :question/worked-solution "$$\n\nThe definition of $\\operatorname{sech}⁡x$ is\n\n$$\n\\operatorname{sech}⁡x=\\frac{1}{\\operatorname{cosh}⁡x}=\\frac{2}{{e}^{x}+{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡7 & =\\frac{2}{{e}^{7}+{e}^{-7}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514448 :knowledge-point/_questions [{:db/id #edb/ref 17592186166810 :knowledge-point/id #uuid "56fbaea3-3655-54cf-a3e1-5e0a5ce77c0d" :knowledge-point/title "Evaluating Hyperbolic Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3d08d87-5e72-5cee-a7d3-5556366a9ad0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{3}" :db/id #edb/ref 17592186514131}] :answer-field/correct {:answer/id #uuid "e3d08d87-5e72-5cee-a7d3-5556366a9ad0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{3}" :db/id #edb/ref 17592186514131} :answer-field/id #uuid "5fea91a9-b09a-5a02-bb27-07b1b9e3e60e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514273}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a717dc62-f0d0-579e-9ded-2923a5f96442" :question/math-academy-id "q-300677" :question/problem "$$\nEvaluate $\\operatorname{sech}⁡(\\operatorname{ln}⁡\\sqrt{5}).$ **Do not round** your answer.\n\n$$\n$\\operatorname{sech}⁡(\\operatorname{ln}⁡\\sqrt{5})=$\n{{field-1}}" :question/worked-solution "$$\n\nThe definition of $\\operatorname{sech}⁡x$ is\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡x=\\frac{1}{\\operatorname{cosh}⁡x}=\\frac{2}{{e}^{x}+{e}^{-x}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡(\\operatorname{ln}⁡\\sqrt{5}) & =\\frac{2}{{e}^{\\operatorname{ln}⁡\\sqrt{5}}+{e}^{-\\operatorname{ln}⁡\\sqrt{5}}} \\\\  & =\\frac{2}{{e}^{\\operatorname{ln}⁡\\sqrt{5}}+{e}^{\\operatorname{ln}⁡(\\sqrt{5})^{-1}}} \\\\  & =\\frac{2}{\\sqrt{5}+(\\sqrt{5})^{-1}} \\\\  & =\\frac{2}{(\\sqrt{5}+\\frac{1}{\\sqrt{5}})} \\\\  & =\\frac{2}{(\\frac{6}{\\sqrt{5}})} \\\\  & =\\frac{\\sqrt{5}}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514449 :knowledge-point/_questions [{:db/id #edb/ref 17592186166812 :knowledge-point/id #uuid "20904d6c-07bd-5e38-818d-17cb0d608dfb" :knowledge-point/title "Evaluating Hyperbolic Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa02a9fd-da12-51d0-8e53-1443370bbe7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{6}+1}{e^{6}-1}" :db/id #edb/ref 17592186514184}] :answer-field/correct {:answer/id #uuid "fa02a9fd-da12-51d0-8e53-1443370bbe7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{6}+1}{e^{6}-1}" :db/id #edb/ref 17592186514184} :answer-field/id #uuid "2c2ce44e-4f1e-519d-a1b9-c6fbfc2dc7c4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514242}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8d94db5-30b8-5d58-91bd-e8bbc8dd17c5" :question/math-academy-id "q-300702" :question/problem "Evaluate $\\operatorname{coth}⁡3.$ **Do not round** your answer.\n$$$$\n\n$\\operatorname{coth}⁡3=$\n {{field-1}}" :question/worked-solution "$$\n\nThe definition of $\\operatorname{coth}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{coth}⁡x & =\\frac{1}{\\operatorname{tanh}⁡x} \\\\  & =\\frac{{e}^{x}+{e}^{-x}}{{e}^{x}-{e}^{-x}} \\\\  & =\\frac{{e}^{2x}+1}{{e}^{2x}-1} \\\\  & =\\frac{1+{e}^{-2x}}{1-{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}\\operatorname{coth}⁡3 & =\\frac{{e}^{2(3)}+1}{{e}^{2(3)}-1}=\\frac{{e}^{6}+1}{{e}^{6}-1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514485 :knowledge-point/_questions [{:db/id #edb/ref 17592186166811 :knowledge-point/id #uuid "59907a9d-8d46-51d0-b568-0928211eb7e7" :knowledge-point/title "Evaluating Hyperbolic Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f84a058-98da-5a43-85a6-c9443bc774a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186513657}] :answer-field/correct {:answer/id #uuid "2f84a058-98da-5a43-85a6-c9443bc774a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186513657} :answer-field/id #uuid "53b6dda4-c668-5dd7-ba0c-f66c9657a070" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514262}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff24eb5c-4023-53e8-863a-4c063695bc62" :question/math-academy-id "q-340819" :question/problem "$$\nEvaluate $\\operatorname{csch}⁡(-\\operatorname{ln}⁡\\sqrt{5}).$ **Do not round** your answer.\n\n$$\n$\\operatorname{csch}⁡(-\\operatorname{ln}⁡\\sqrt{5})=$\n{{field-1}}" :question/worked-solution "$$\n\nThe definition of $\\operatorname{csch}⁡x$ is \n\n$$\n\\operatorname{csch}⁡x=\\frac{1}{\\operatorname{sinh}⁡x}=\\frac{2}{{e}^{x}-{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{csch}⁡(-\\operatorname{ln}⁡\\sqrt{5}) & =\\frac{2}{{e}^{-\\operatorname{ln}⁡\\sqrt{5}}-{e}^{-(-\\operatorname{ln}⁡\\sqrt{5})}} \\\\  & =\\frac{2}{{e}^{-\\operatorname{ln}⁡\\sqrt{5}}-{e}^{\\operatorname{ln}⁡\\sqrt{5}}} \\\\  & =\\frac{2}{{e}^{\\operatorname{ln}⁡{(\\sqrt{5})}^{-1}}-{e}^{\\operatorname{ln}⁡\\sqrt{5}}} \\\\  & =\\frac{2}{(\\frac{1}{\\sqrt{5}}-\\sqrt{5})} \\\\  & =\\frac{2}{(\\frac{1-5}{\\sqrt{5}})} \\\\  & =\\frac{2}{(-\\frac{4}{\\sqrt{5}})} \\\\  & =2\\times (-\\frac{\\sqrt{5}}{4}) \\\\  & =-\\frac{\\sqrt{5}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514451 :knowledge-point/_questions [{:db/id #edb/ref 17592186166810 :knowledge-point/id #uuid "56fbaea3-3655-54cf-a3e1-5e0a5ce77c0d" :knowledge-point/title "Evaluating Hyperbolic Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "972c2fc3-94db-5577-8544-208982267693" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2e}{{e}^{2}+1}" :db/id #edb/ref 17592186513922}] :answer-field/correct {:answer/id #uuid "972c2fc3-94db-5577-8544-208982267693" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2e}{{e}^{2}+1}" :db/id #edb/ref 17592186513922} :answer-field/id #uuid "414b1934-a60c-5b00-b690-7baace00611d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514252}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aa7fb149-1626-56db-aafd-3693bf4f703f" :question/math-academy-id "q-340820" :question/problem "$$\nEvaluate $\\operatorname{sech}⁡1.$ **Do not round** your answer.\n\n$$\n$\\operatorname{sech}⁡1=$\n{{field-1}}" :question/worked-solution "$$\n\nThe definition of $\\operatorname{sech}⁡x$ is\n\n$$\n\\operatorname{sech}⁡x=\\frac{1}{\\operatorname{cosh}⁡x}=\\frac{2}{{e}^{x}+{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡1 & =\\frac{2}{{e}^{1}+{e}^{-1}} \\\\  & =\\frac{2}{(e+\\frac{1}{e})} \\\\  & =\\frac{2}{(\\frac{{e}^{2}+1}{e})} \\\\  & =\\frac{2e}{{e}^{2}+1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514387 :knowledge-point/_questions [{:db/id #edb/ref 17592186166812 :knowledge-point/id #uuid "20904d6c-07bd-5e38-818d-17cb0d608dfb" :knowledge-point/title "Evaluating Hyperbolic Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c82cb5ba-2e25-559f-9acb-9f9f141709ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{2\\sqrt{5}}+1}{e^{2\\sqrt{5}}-1}" :db/id #edb/ref 17592186514057}] :answer-field/correct {:answer/id #uuid "c82cb5ba-2e25-559f-9acb-9f9f141709ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e^{2\\sqrt{5}}+1}{e^{2\\sqrt{5}}-1}" :db/id #edb/ref 17592186514057} :answer-field/id #uuid "54daf4bc-b2ca-5b98-8707-23b1d3105f92" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514264}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3203ea85-5b81-5f7d-8926-d8feaf4a8223" :question/math-academy-id "q-340827" :question/problem "$$\nEvaluate $\\operatorname{coth}⁡(\\sqrt{5}).$ **Do not round** your answer.\n\n$$\n$\\operatorname{coth}⁡(\\sqrt{5})=$\n {{field-1}}" :question/worked-solution "$$\n\nThe definition of $\\operatorname{coth}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{coth}⁡x & =\\frac{1}{\\operatorname{tanh}⁡x} \\\\  & =\\frac{{e}^{x}+{e}^{-x}}{{e}^{x}-{e}^{-x}} \\\\  & =\\frac{{e}^{2x}+1}{{e}^{2x}-1} \\\\  & =\\frac{1+{e}^{-2x}}{1-{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\operatorname{coth}⁡(\\sqrt{5})=\\frac{{e}^{2\\sqrt{5}}+1}{{e}^{2\\sqrt{5}}-1}.\n$$"}] [{:db/id #edb/ref 17592186514480 :knowledge-point/_questions [{:db/id #edb/ref 17592186166812 :knowledge-point/id #uuid "20904d6c-07bd-5e38-818d-17cb0d608dfb" :knowledge-point/title "Evaluating Hyperbolic Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ffcd5731-2069-5efb-ac00-2f8ff3414dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186514208}] :answer-field/correct {:answer/id #uuid "ffcd5731-2069-5efb-ac00-2f8ff3414dd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186514208} :answer-field/id #uuid "cad4afc6-9656-5283-837f-a8416585d0c4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514322}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f714102a-964b-532c-b041-8149ac6f2160" :question/math-academy-id "q-340828" :question/problem "$$\nEvaluate $\\operatorname{coth}⁡(-\\operatorname{ln}⁡\\frac{1}{2}).$ **Do not round** your answer.\n\n$$\n$\\operatorname{coth}⁡(-\\operatorname{ln}⁡\\frac{1}{2})=$\n {{field-1}}" :question/worked-solution "$$\nThe definition of $\\operatorname{coth}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{coth}⁡x & =\\frac{1}{\\operatorname{tanh}⁡x} \\\\  & =\\frac{{e}^{x}+{e}^{-x}}{{e}^{x}-{e}^{-x}} \\\\  & =\\frac{{e}^{2x}+1}{{e}^{2x}-1} \\\\  & =\\frac{1+{e}^{-2x}}{1-{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the fourth definition, we get\n\n$$\n\\begin{aligned}\\operatorname{coth}⁡(-\\operatorname{ln}⁡\\frac{1}{2}) & =\\frac{1+{e}^{-2(-\\operatorname{ln}⁡\\frac{1}{2})}}{1-{e}^{-2(-\\operatorname{ln}⁡\\frac{1}{2})}} \\\\  & =\\frac{1+{e}^{2\\operatorname{ln}⁡\\frac{1}{2}}}{1-{e}^{2\\operatorname{ln}⁡\\frac{1}{2}}} \\\\  & =\\frac{1+{e}^{\\operatorname{ln}⁡{(\\frac{1}{2})}^{2}}}{1-{e}^{\\operatorname{ln}⁡{(\\frac{1}{2})}^{2}}} \\\\  & =\\frac{(1+\\frac{1}{4})}{(1-\\frac{1}{4})} \\\\  & =\\frac{5}{4}÷\\frac{3}{4} \\\\  & =\\frac{5}{4}\\cdot \\frac{4}{3} \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186167431 :knowledge-point/_questions [{:db/id #edb/ref 17592186166812 :knowledge-point/id #uuid "20904d6c-07bd-5e38-818d-17cb0d608dfb" :knowledge-point/title "Evaluating Hyperbolic Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27a46a59-fb25-5554-b96c-1989028bd9f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186165795} {:answer/id #uuid "3ae362f8-9d98-5671-b21b-8240a31fc8ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186165796} {:answer/id #uuid "671c6c5b-3016-5368-987d-2761b7cb21c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186165797} {:answer/id #uuid "6f2a475d-097a-5fa4-b0b7-005d1b4e5af7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186165798} {:answer/id #uuid "7ffb8635-f9e2-56e6-93b5-748d3c051257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186165799}] :answer-field/correct {:answer/id #uuid "6f2a475d-097a-5fa4-b0b7-005d1b4e5af7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186165798} :answer-field/id #uuid "ab7c1af8-6b5d-598c-9d45-898bccc3335a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165794}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a04f8f4-15f5-56c5-8877-8884c38345fc" :question/math-academy-id "q-95951" :question/problem "$$\n$\\operatorname{coth}⁡(\\operatorname{ln}⁡2)=$" :question/worked-solution "$$\nThe definition of $\\operatorname{coth}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{coth}⁡x & =\\frac{1}{\\operatorname{tanh}⁡x} \\\\  & =\\frac{{e}^{x}+{e}^{-x}}{{e}^{x}-{e}^{-x}} \\\\  & =\\frac{{e}^{2x}+1}{{e}^{2x}-1} \\\\  & =\\frac{1+{e}^{-2x}}{1-{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}\\operatorname{coth}⁡(\\operatorname{ln}⁡2) & =\\frac{{e}^{2\\operatorname{ln}⁡2}+1}{{e}^{2\\operatorname{ln}⁡2}-1} \\\\  & =\\frac{{e}^{\\operatorname{ln}⁡{2}^{2}}+1}{{e}^{\\operatorname{ln}⁡{2}^{2}}-1} \\\\  & =\\frac{{2}^{2}+1}{{2}^{2}-1} \\\\  & =\\frac{4+1}{4-1} \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514374 :knowledge-point/_questions [{:db/id #edb/ref 17592186166811 :knowledge-point/id #uuid "59907a9d-8d46-51d0-b568-0928211eb7e7" :knowledge-point/title "Evaluating Hyperbolic Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fed9afb-d84e-5a5c-9427-67c85f80b53f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{15}{2}" :db/id #edb/ref 17592186513617} {:answer/id #uuid "6ac49a99-6c9e-556a-a07b-1d7dbcc6149f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{17}" :db/id #edb/ref 17592186513819} {:answer/id #uuid "978426ac-e8fc-5307-a926-b42029a81429" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{15}" :db/id #edb/ref 17592186513924} {:answer/id #uuid "bcbb33a9-826e-5e2e-b378-e4b369c0ac56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{15}" :db/id #edb/ref 17592186514034} {:answer/id #uuid "c2fb5695-2b16-5a62-9ddc-880edd81d5c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186514047}] :answer-field/correct {:answer/id #uuid "978426ac-e8fc-5307-a926-b42029a81429" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{15}" :db/id #edb/ref 17592186513924} :answer-field/id #uuid "273b91a1-bbe7-504f-a91e-d8be18aa8ef2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514237}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "196ecf31-b7aa-5c38-b760-a54c4f34d305" :question/math-academy-id "q-96531" :question/problem "$$\n\n$\\operatorname{csch}⁡(-2\\operatorname{ln}⁡2)=$" :question/worked-solution "$$\n\nThe definition of $\\operatorname{csch}⁡x$ is \n\n$$\n\\operatorname{csch}⁡x=\\frac{1}{\\operatorname{sinh}⁡x}=\\frac{2}{{e}^{x}-{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{csch}⁡(-2\\operatorname{ln}⁡2) & =\\frac{2}{{e}^{-2\\operatorname{ln}⁡2}-{e}^{-(-2\\operatorname{ln}⁡2)}} \\\\  & =\\frac{2}{{e}^{-2\\operatorname{ln}⁡2}-{e}^{2\\operatorname{ln}⁡2}} \\\\  & =\\frac{2}{{e}^{\\operatorname{ln}⁡{2}^{-2}}-{e}^{\\operatorname{ln}⁡{2}^{2}}} \\\\  & =\\frac{2}{{2}^{-2}-{2}^{2}} \\\\  & =\\frac{2}{(\\frac{1}{4}-4)} \\\\  & =\\frac{2}{(-\\frac{15}{4})} \\\\  & =-\\frac{8}{15}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186514437 :knowledge-point/_questions [{:db/id #edb/ref 17592186166812 :knowledge-point/id #uuid "20904d6c-07bd-5e38-818d-17cb0d608dfb" :knowledge-point/title "Evaluating Hyperbolic Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a960892-473d-5c82-96ca-897b1bb8f323" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{w}^{2}+1}{2{w}^{2}-1}" :db/id #edb/ref 17592186513647} {:answer/id #uuid "9034ce28-781f-5290-a4bd-28ca70b5eaef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{w}^{2}+1}{4{w}^{2}-1}" :db/id #edb/ref 17592186513905} {:answer/id #uuid "a4d34bd2-ecc4-5d35-809a-9e7699733f9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4w+1}{4w-1}" :db/id #edb/ref 17592186513956} {:answer/id #uuid "f386b932-7e8f-5621-8229-0b3482f235be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{w}^{2}-1}{4{w}^{2}+1}" :db/id #edb/ref 17592186514165} {:answer/id #uuid "fd4c3ed9-c949-547b-9857-3b5b4ceae3bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{w}^{2}-1}{2{w}^{2}+1}" :db/id #edb/ref 17592186514196}] :answer-field/correct {:answer/id #uuid "9034ce28-781f-5290-a4bd-28ca70b5eaef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{w}^{2}+1}{4{w}^{2}-1}" :db/id #edb/ref 17592186513905} :answer-field/id #uuid "757863fe-7e0e-5689-8cb2-227d3255cde1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514282}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9460a409-51fa-5175-bdf4-3dbd6c50a02e" :question/math-academy-id "q-96551" :question/problem "$$\n\nWhich of the following is equivalent to  $\\operatorname{coth}⁡(\\operatorname{ln}⁡2w)?$" :question/worked-solution "$$\n\nThe definition of $\\operatorname{coth}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{coth}⁡x & =\\frac{1}{\\operatorname{tanh}⁡x} \\\\  & =\\frac{{e}^{x}+{e}^{-x}}{{e}^{x}-{e}^{-x}} \\\\  & =\\frac{{e}^{2x}+1}{{e}^{2x}-1} \\\\  & =\\frac{1+{e}^{-2x}}{1-{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}\\operatorname{coth}⁡(\\operatorname{ln}⁡2w) & =\\frac{{e}^{2\\operatorname{ln}⁡2w}+1}{{e}^{2\\operatorname{ln}⁡2w}-1} \\\\  & =\\frac{{e}^{\\operatorname{ln}⁡4{w}^{2}}+1}{{e}^{\\operatorname{ln}⁡4{w}^{2}}-1} \\\\  & =\\frac{4{w}^{2}+1}{4{w}^{2}-1}.\\end{aligned}\n$$"}]}
