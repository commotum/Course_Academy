-e8abb5e89637" #edb/ref 17592186045417] [17592186167649 #edb/ref 1063 #edb/ref 17592186166812 #edb/ref 17592186045417] [17592186167699 #edb/ref 1058 #edb/ref 17592186167648 #edb/ref 17592186045417] [17592186167699 #edb/ref 1061 32684 #edb/ref 17592186045417] [17592186167699 #edb/ref 1062 #uuid "08c055e4-f0a6-557f-8e3a-2c5a642e161a" #edb/ref 17592186045417] [17592186167699 #edb/ref 1063 #edb/ref 17592186168089 #edb/ref 17592186045417] [17592186167718 #edb/ref 1058 #edb/ref 17592186167647 #edb/ref 17592186045417] [17592186167718 #edb/ref 1061 33483 #edb/ref 17592186045417] [17592186167718 #edb/ref 1062 #uuid "d5ff79b9-342e-5736-b506-5b930d5a43f8" #edb/ref 17592186045417] [17592186167718 #edb/ref 1063 #edb/ref 17592186168105 #edb/ref 17592186045417] [17592186167719 #edb/ref 1058 #edb/ref 17592186167649 #edb/ref 17592186045417] [17592186167719 #edb/ref 1061 33484 #edb/ref 17592186045417] [17592186167719 #edb/ref 1062 #uuid "ce8d00e0-fe25-5d82-8ae5-565d740702c0" #edb/ref 17592186045417] [17592186167719 #edb/ref 1063 #edb/ref 17592186168106 #edb/ref 17592186045417] [17592186168089 #edb/ref 1064 "$$\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nWe can define the **reciprocal hyperbolic functions** similarly to how we define reciprocal trigonometric functions.\n\nThe **hyperbolic cosecant function** (pronounced \"cosetch\") is defined as\n\n$$\n\\csch{x} = \\dfrac{1}{\\sinh{x}} = \\dfrac{2}{e^x-e^{-x}}\\,\\,\\,\n$$\n\nThe graph of $y=\\csch x$ is shown below.\n\n![](images/cc/cc0b2c19d1606c8a0a2c11411a0b0a4fbc09f264d9d28d0fcb2fb81f6c576a8a.png)\n\nNote the following properties of $y=\\csch x$:\n\n- Its domain is $x \\in (-\\infty, 0)\\cup (0,\\infty)$.\n- Its range is $y \\in (-\\infty, 0)\\cup (0,\\infty)$.\n- It is an odd function." #edb/ref 17592186045417] [17592186168089 #edb/ref 1065 5205 #edb/ref 17592186045417] [17592186168089 #edb/ref 1066 #uuid "81b4b2c8-5e07-5602-9aa1-a529be58c17b" #edb/ref 17592186045417] [17592186168089 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186168105 #edb/ref 1064 "$$\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe **hyperbolic secant function** (pronounced \"sesh\") is defined as\n\n$$\n\\sech{x} = \\dfrac{1}{\\cosh{x}} = \\dfrac{2}{e^x+e^{-x}}\\,\\,\\,\n$$\n\nThe graph of $y=\\sech x$ is shown below.\n\n![](images/b2/b228f9fba9d1b981d64730de4b3836de914e2565332780a3fd803c165fb7d2ba.png)\n\nNote the following properties of $y=\\sech x$:\n\n- Its domain is $x \\in (-\\infty, \\infty)$.\n- Its range is $y \\in (0, 1]$.\n- It has the horizontal asymptote $y=0$.\n- It is an even function." #edb/ref 17592186045417] [17592186168105 #edb/ref 1065 5353 #edb/ref 17592186045417] [17592186168105 #edb/ref 1066 #uuid "efaf14f0-74f5-5f20-bd4f-eb1015699d33" #edb/ref 17592186045417] [17592186168105 #edb/ref 1067 "Hyperbolic Secant" #edb/ref 17592186045417] [17592186168106 #edb/ref 1064 "The **hyperbolic cotangent function** (pronounced \"coth\") is defined as\n\n$$\n\\begin{aligned}\n\\coth x = \\frac{1}{\\tanh x} &= \\frac{e^{x} + e^{-x}}{e^{x} - e^{-x}}\n\\end{aligned}\n$$\n\nThe graph of $y=\\coth x$ is shown below.\n\n![](images/d3/d3d4f5cbe846f7725399fa1b1769c4f476be439575043537a2caa80c318a5ec9.png)\n\nNote the following properties of $y=\\coth x$:\n\n- Its domain is $x\\in (-\\infty, 0)\\cup (0,\\infty)$.\n- Its range is $y \\in (-\\infty, -1)\\cup (1,\\infty)$.\n- It has horizontal asymptotes $y=\\pm 1$.\n- It is an odd function.\n\nUsing the alternative definitions of $\\tanh x$, we can write down two more definitions for $\\coth x$:\n\n$$\n\\begin{aligned}\n\\coth x &= \\frac{1}{\\tanh x} \\\\\n&= \\frac{e^{2x} + 1}{e^{2x} - 1} \\\\\n&= \\frac{1 + e^{-2x}}{1 - e^{-2x}}\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186168106 #edb/ref 1065 5354 #edb/ref 17592186045417] [17592186168106 #edb/ref 1066 #uuid "e64e0ad4-0bf1-549c-a2fd-9ac26f9049f6" #edb/ref 17592186045417] [17592186168106 #edb/ref 1067 "Hyperbolic Cotangent" #edb/ref 17592186045417]}
