olimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nEvaluate $\\sech \\left(-t \\right)$." #edb/ref 17592186045417] [17592186166648 #edb/ref 1072 #uuid "c0e85144-6e01-5311-84d4-1042856272da" #edb/ref 17592186045417] [17592186166648 #edb/ref 1074 "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe definition of $\\sech{x}$ is\n\n$$\n\\sech{x} = \\dfrac{1}{\\cosh x} = \\dfrac{2}{e^{x}+e^{-x}}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nsech (-t) &= (2)/(e^{-t} + e^{- (-t)}) \\\\\n&= \\frac{2}{e^{-t} + e^{t}}\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166649 #edb/ref 1069 "e-8457" #edb/ref 17592186045417] [17592186166649 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nEvaluate $\\csch (-9)$." #edb/ref 17592186045417] [17592186166649 #edb/ref 1072 #uuid "65b73c5e-690f-5ed6-b245-c96f2b61662a" #edb/ref 17592186045417] [17592186166649 #edb/ref 1074 "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe definition of $\\csch x$ is\n\n$$\n\\csch x = \\dfrac{1}{\\sinh x} = \\dfrac {2}{e^{x} - e^{-x}}\n$$\n\nTherefore,\n\n$$\n\\csch (-9) =\\dfrac{2}{e^{-9}-e^{-(-9)}}=\\dfrac{2}{e^{-9}-e^{9}}\n$$" #edb/ref 17592186045417] [17592186166650 #edb/ref 1069 "e-8458" #edb/ref 17592186045417] [17592186166650 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nEvaluate $\\coth (-\\ln 3)$." #edb/ref 17592186045417] [17592186166650 #edb/ref 1072 #uuid "40c32ead-4f17-57d2-acd3-f65f6de1fe80" #edb/ref 17592186045417] [17592186166650 #edb/ref 1074 "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe definition of $\\coth x$ is\n\n$$\n\\begin{aligned}\n\\coth x &= \\frac{1}{\\tanh x} \\\\\n&= \\frac{e^{x} + e^{-x}}{e^{x} - e^{-x}} \\\\\n&= \\frac{e^{2x} + 1}{e^{2x} - 1} \\\\\n&= \\frac{1 + e^{-2x}}{1 - e^{-2x}}\n\\end{aligned}\n$$\n\nUsing the fourth definition, we get\n\n$$\n\\begin{aligned}\n\\coth (-\\ln 3) &= (1 + e^{-2(-\\ln 3)})/(1 - e^{-2(-\\ln 3)}) \\\\\n&= \\frac{1 + e^{2\\ln 3}}{1 - e^{2\\ln 3}} \\\\\n&= \\frac{1 + e^{\\ln 3^{2}}}{1 - e^{\\ln 3^{2}}} \\\\\n&= \\frac{1 + 3^{2}}{1 - 3^{2}} \\\\\n&= \\frac{1 + 9}{1 - 9} \\\\\n&= (10)/((-8)) \\\\\n&=-\\frac{5}{4}\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166810 #edb/ref 1038 #edb/ref 17592186167429 #edb/ref 17592186045417] [17592186166810 #edb/ref 1038 #edb/ref 17592186167430 #edb/ref 17592186045417] [17592186166810 #edb/ref 1039 "Evaluating Hyperbolic Secant" #edb/ref 17592186045417] [17592186166810 #edb/ref 1041 #edb/ref 17592186166648 #edb/ref 17592186045417] [17592186166810 #edb/ref 1042 #uuid "56fbaea3-3655-54cf-a3e1-5e0a5ce77c0d" #edb/ref 17592186045417] [17592186166811 #edb/ref 1037 #edb/ref 17592186050125 #edb/ref 17592186045417] [17592186166811 #edb/ref 1038 #edb/ref 17592186167427 #edb/ref 17592186045417] [17592186166811 #edb/ref 1038 #edb/ref 17592186167428 #edb/ref 17592186045417] [17592186166811 #edb/ref 1039 "Evaluating Hyperbolic Cosecant" #edb/ref 17592186045417] [17592186166811 #edb/ref 1041 #edb/ref 17592186166649 #edb/ref 17592186045417] [17592186166811 #edb/ref 1042 #uuid "59907a9d-8d46-51d0-b568-0928211eb7e7" #edb/ref 17592186045417] [17592186166812 #edb/ref 1038 #edb/ref 17592186167431 #edb/ref 17592186045417] [17592186166812 #edb/ref 1038 #edb/ref 17592186167432 #edb/ref 17592186045417] [17592186166812 #edb/ref 1039 "Evaluating Hyperbolic Cotangent" #edb/ref 17592186045417] [17592186166812 #edb/ref 1041 #edb/ref 17592186166650 #edb/ref 17592186045417] [17592186166812 #edb/ref 1042 #uuid "20904d6c-07bd-5e38-818d-17cb0d608dfb" #edb/ref 1759218