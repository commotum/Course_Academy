#{[{:db/id #edb/ref 17592186166648 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166810 :knowledge-point/id #uuid "56fbaea3-3655-54cf-a3e1-5e0a5ce77c0d" :knowledge-point/title "Evaluating Hyperbolic Secant"}] :question/id #uuid "c0e85144-6e01-5311-84d4-1042856272da" :question/math-academy-id "e-8456" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nEvaluate $\\sech \\left(-t \\right)$." :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe definition of $\\sech{x}$ is\n\n$$\n\\sech{x} = \\dfrac{1}{\\cosh x} = \\dfrac{2}{e^{x}+e^{-x}}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nsech (-t) &= (2)/(e^{-t} + e^{- (-t)}) \\\\\n&= \\frac{2}{e^{-t} + e^{t}}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166649 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166811 :knowledge-point/id #uuid "59907a9d-8d46-51d0-b568-0928211eb7e7" :knowledge-point/title "Evaluating Hyperbolic Cosecant"}] :question/id #uuid "65b73c5e-690f-5ed6-b245-c96f2b61662a" :question/math-academy-id "e-8457" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nEvaluate $\\csch (-9)$." :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe definition of $\\csch x$ is\n\n$$\n\\csch x = \\dfrac{1}{\\sinh x} = \\dfrac {2}{e^{x} - e^{-x}}\n$$\n\nTherefore,\n\n$$\n\\csch (-9) =\\dfrac{2}{e^{-9}-e^{-(-9)}}=\\dfrac{2}{e^{-9}-e^{9}}\n$$"}] [{:db/id #edb/ref 17592186166650 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166812 :knowledge-point/id #uuid "20904d6c-07bd-5e38-818d-17cb0d608dfb" :knowledge-point/title "Evaluating Hyperbolic Cotangent"}] :question/id #uuid "40c32ead-4f17-57d2-acd3-f65f6de1fe80" :question/math-academy-id "e-8458" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nEvaluate $\\coth (-\\ln 3)$." :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe definition of $\\coth x$ is\n\n$$\n\\begin{aligned}\n\\coth x &= \\frac{1}{\\tanh x} \\\\\n&= \\frac{e^{x} + e^{-x}}{e^{x} - e^{-x}} \\\\\n&= \\frac{e^{2x} + 1}{e^{2x} - 1} \\\\\n&= \\frac{1 + e^{-2x}}{1 - e^{-2x}}\n\\end{aligned}\n$$\n\nUsing the fourth definition, we get\n\n$$\n\\begin{aligned}\n\\coth (-\\ln 3) &= (1 + e^{-2(-\\ln 3)})/(1 - e^{-2(-\\ln 3)}) \\\\\n&= \\frac{1 + e^{2\\ln 3}}{1 - e^{2\\ln 3}} \\\\\n&= \\frac{1 + e^{\\ln 3^{2}}}{1 - e^{\\ln 3^{2}}} \\\\\n&= \\frac{1 + 3^{2}}{1 - 3^{2}} \\\\\n&= \\frac{1 + 9}{1 - 9} \\\\\n&= (10)/((-8)) \\\\\n&=-\\frac{5}{4}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186167431 :knowledge-point/_questions [{:db/id #edb/ref 17592186166812 :knowledge-point/id #uuid "20904d6c-07bd-5e38-818d-17cb0d608dfb" :knowledge-point/title "Evaluating Hyperbolic Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27a46a59-fb25-5554-b96c-1989028bd9f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186165795} {:answer/id #uuid "3ae362f8-9d98-5671-b21b-8240a31fc8ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186165796} {:answer/id #uuid "671c6c5b-3016-5368-987d-2761b7cb21c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186165797} {:answer/id #uuid "6f2a475d-097a-5fa4-b0b7-005d1b4e5af7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186165798} {:answer/id #uuid "7ffb8635-f9e2-56e6-93b5-748d3c051257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186165799}] :answer-field/id #uuid "ab7c1af8-6b5d-598c-9d45-898bccc3335a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165794}] :question/id #uuid "4a04f8f4-15f5-56c5-8877-8884c38345fc" :question/math-academy-id "q-95951" :question/problem "What is $\\coth (\\ln 2)$?"}]}
