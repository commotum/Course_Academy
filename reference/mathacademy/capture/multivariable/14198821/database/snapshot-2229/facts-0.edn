 17592186045417] [17592186514322 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186514322 #edb/ref 1078 #edb/ref 17592186514208 #edb/ref 17592186045417] [17592186514322 #edb/ref 1079 #uuid "cad4afc6-9656-5283-837f-a8416585d0c4" #edb/ref 17592186045417] [17592186514358 #edb/ref 1068 #edb/ref 17592186514231 #edb/ref 17592186045417] [17592186514358 #edb/ref 1069 "q-125371" #edb/ref 17592186045417] [17592186514358 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186514358 #edb/ref 1071 "$$\n\n$\\operatorname{csch}⁡(-5)=$" #edb/ref 17592186045417] [17592186514358 #edb/ref 1072 #uuid "0325034f-c697-5e84-82d0-1d5908709799" #edb/ref 17592186045417] [17592186514358 #edb/ref 1074 "$$\n\nThe definition of $\\operatorname{csch}⁡x$ is \n\n$$\n\\operatorname{csch}⁡x=\\frac{1}{\\operatorname{sinh}⁡x}=\\frac{2}{{e}^{x}-{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{csch}⁡(-5) & =\\frac{2}{{e}^{-5}-{e}^{-(-5)}} \\\\  & =\\frac{2}{{e}^{-5}-{e}^{5}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514365 #edb/ref 1068 #edb/ref 17592186514285 #edb/ref 17592186045417] [17592186514365 #edb/ref 1069 "q-125697" #edb/ref 17592186045417] [17592186514365 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186514365 #edb/ref 1071 "$$\n\nGiven that $t\\ne 0,$ which of the following is equivalent to $\\operatorname{csch}⁡(\\sqrt{7}\\,t)?$" #edb/ref 17592186045417] [17592186514365 #edb/ref 1072 #uuid "0af3be74-c5b3-5ec8-af78-1603fe65ae67" #edb/ref 17592186045417] [17592186514365 #edb/ref 1074 "$$\n\nThe definition of $\\operatorname{csch}⁡x$ is \n\n$$\n\\operatorname{csch}⁡x=\\frac{1}{\\operatorname{sinh}⁡x}=\\frac{2}{{e}^{x}-{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\operatorname{csch}⁡(\\sqrt{7}\\,t)=\\frac{2}{{e}^{\\sqrt{7}\\,t}-{e}^{-\\sqrt{7}\\,t}}.\n$$" #edb/ref 17592186045417] [17592186514374 #edb/ref 1068 #edb/ref 17592186514237 #edb/ref 17592186045417] [17592186514374 #edb/ref 1069 "q-96531" #edb/ref 17592186045417] [17592186514374 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186514374 #edb/ref 1071 "$$\n\n$\\operatorname{csch}⁡(-2\\operatorname{ln}⁡2)=$" #edb/ref 17592186045417] [17592186514374 #edb/ref 1072 #uuid "196ecf31-b7aa-5c38-b760-a54c4f34d305" #edb/ref 17592186045417] [17592186514374 #edb/ref 1074 "$$\n\nThe definition of $\\operatorname{csch}⁡x$ is \n\n$$\n\\operatorname{csch}⁡x=\\frac{1}{\\operatorname{sinh}⁡x}=\\frac{2}{{e}^{x}-{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{csch}⁡(-2\\operatorname{ln}⁡2) & =\\frac{2}{{e}^{-2\\operatorname{ln}⁡2}-{e}^{-(-2\\operatorname{ln}⁡2)}} \\\\  & =\\frac{2}{{e}^{-2\\operatorname{ln}⁡2}-{e}^{2\\operatorname{ln}⁡2}} \\\\  & =\\frac{2}{{e}^{\\operatorname{ln}⁡{2}^{-2}}-{e}^{\\operatorname{ln}⁡{2}^{2}}} \\\\  & =\\frac{2}{{2}^{-2}-{2}^{2}} \\\\  & =\\frac{2}{(\\frac{1}{4}-4)} \\\\  & =\\frac{2}{(-\\frac{15}{4})} \\\\  & =-\\frac{8}{15}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514377 #edb/ref 1068 #edb/ref 17592186514309 #edb/ref 17592186045417] [17592186514377 #edb/ref 1069 "q-300672" #edb/ref 17592186045417] [17592186514377 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186514377 #edb/ref 1071 "$$\nEvaluate $\\operatorname{sech}⁡7.$ **Do not round** your answer.\n\n$$\n$\\operatorname{sech}⁡7=$\n{{field-1}}" #edb/ref 17592186045417] [17592186514377 #edb/ref 1072 #uuid "221afffc-6058-53ae-8f4b-ca54ee801c93" #edb/ref 17592186045417] [17592186514377 #edb/ref 1074 "$$\n\nThe definition of $\\operatorname{sech}⁡x$ is\n\n$$\n\\operatorname{sech}⁡x=\\frac{1}{\\operatorname{cosh}⁡x}=\\frac{2}{{e}^{x}+{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡7 & =\\frac{2}{{e}^{7}+{e}^{-7}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514387 #edb/ref 1068 #edb/ref 17592186514264 #edb/ref 17592186045417] [17592186514387 #edb/ref 1069 "q-340827" #edb/ref 17592186045417] [17592186514387 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186514387 #edb/ref 1071 "$$\nEvaluate $\\operatorname{coth}⁡(\\sqrt{5}).$ **Do not round** your answer.\n\n$$\n$\\operatorname{coth}⁡(\\sqrt{5})=$\n {{field-1}}" #edb/ref 17592186045417] [17592186514387 #edb/ref 1072 #uuid "3203ea85-5b81-5f7d-8926-d8feaf4a8223" #edb/ref 17592186045417] [17592186514387 #edb/ref 1074 "$$\n\nThe definition of $\\operatorname{coth}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{coth}⁡x & =\\frac{1}{\\operatorname{tanh}⁡x} \\\\  & =\\frac{{e}^{x}+{e}^{-x}}{{e}^{x}-{e}^{-x}} \\\\  & =\\frac{{e}^{2x}+1}{{e}^{2x}-1} \\\\  & =\\frac{1+{e}^{-2x}}{1-{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\operatorname{coth}⁡(\\sqrt{5})=\\frac{{e}^{2\\sqrt{5}}+1}{{e}^{2\\sqrt{5}}-1}.\n$$" #edb/ref 17592186045417] [17592186514404 #edb/ref 1068 #edb/ref 17592186514272 #edb/ref 17592186045417] [17592186514404 #edb/ref 1069 "q-125700" #edb/ref 17592186045417] [17592186514404 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186514404 #edb/ref 1071 "$$\n\nGiven that $z>0,$ which of the following is equivalent to $\\operatorname{sech}⁡(\\operatorname{ln}⁡z)?$" #edb/ref 17592186045417] [17592186514404 #edb/ref 1072 #uuid "558ac263-8cd5-56f3-9f79-c76511bfad24" #edb/ref 17592186045417] [17592186514404 #edb/ref 1074 "$$\n\nThe definition of $\\operatorname{sech}⁡x$ is\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡x=\\frac{1}{\\operatorname{cosh}⁡x}=\\frac{2}{{e}^{x}+{e}^{-x}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡(\\operatorname{ln}⁡z) & =\\frac{2}{{e}^{\\operatorname{ln}⁡z}+{e}^{-\\operatorname{ln}⁡z}} \\\\  & =\\frac{2}{{e}^{\\operatorname{ln}⁡z}+{e}^{\\operatorname{ln}⁡{z}^{-1}}} \\\\  & =\\frac{2}{z+(z)^{-1}} \\\\  & =\\frac{2}{(z+\\frac{1}{z})} \\\\  & =\\frac{2}{(\\frac{{z}^{2}+1}{z})} \\\\  & =\\frac{2z}{{z}^{2}+1}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514437 #edb/ref 1068 #edb/ref 17592186514282 #edb/ref 17592186045417] [17592186514437 #edb/ref 1069 "q-96551" #edb/ref 17592186045417] [17592186514437 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186514437 #edb/ref 1071 "$$\n\nWhich of the following is equivalent to  $\\operatorname{coth}⁡(\\operatorname{ln}⁡2w)?$" #edb/ref 17592186045417] [17592186514437 #edb/ref 1072 #uuid "9460a409-51fa-5175-bdf4-3dbd6c50a02e" #edb/ref 17592186045417] [17592186514437 #edb/ref 1074 "$$\n\nThe definition of $\\operatorname{coth}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{coth}⁡x & =\\frac{1}{\\operatorname{tanh}⁡x} \\\\  & =\\frac{{e}^{x}+{e}^{-x}}{{e}^{x}-{e}^{-x}} \\\\  & =\\frac{{e}^{2x}+1}{{e}^{2x}-1} \\\\  & =\\frac{1+{e}^{-2x}}{1-{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}\\operatorname{coth}⁡(\\operatorname{ln}⁡2w) & =\\frac{{e}^{2\\operatorname{ln}⁡2w}+1}{{e}^{2\\operatorname{ln}⁡2w}-1} \\\\  & =\\frac{{e}^{\\operatorname{ln}⁡4{w}^{2}}+1}{{e}^{\\operatorname{ln}⁡4{w}^{2}}-1} \\\\  & =\\frac{4{w}^{2}+1}{4{w}^{2}-1}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514448 #edb/ref 1068 #edb/ref 17592186514273 #edb/ref 17592186045417] [17592186514448 #edb/ref 1069 "q-300677" #edb/ref 17592186045417] [17592186514448 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186514448 #edb/ref 1071 "$$\nEvaluate $\\operatorname{sech}⁡(\\operatorname{ln}⁡\\sqrt{5}).$ **Do not round** your answer.\n\n$$\n$\\operatorname{sech}⁡(\\operatorname{ln}⁡\\sqrt{5})=$\n{{field-1}}" #edb/ref 17592186045417] [17592186514448 #edb/ref 1072 #uuid "a717dc62-f0d0-579e-9ded-2923a5f96442" #edb/ref 17592186045417] [17592186514448 #edb/ref 1074 "$$\n\nThe definition of $\\operatorname{sech}⁡x$ is\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡x=\\frac{1}{\\operatorname{cosh}⁡x}=\\frac{2}{{e}^{x}+{e}^{-x}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡(\\operatorname{ln}⁡\\sqrt{5}) & =\\frac{2}{{e}^{\\operatorname{ln}⁡\\sqrt{5}}+{e}^{-\\operatorname{ln}⁡\\sqrt{5}}} \\\\  & =\\frac{2}{{e}^{\\operatorname{ln}⁡\\sqrt{5}}+{e}^{\\operatorname{ln}⁡(\\sqrt{5})^{-1}}} \\\\  & =\\frac{2}{\\sqrt{5}+(\\sqrt{5})^{-1}} \\\\  & =\\frac{2}{(\\sqrt{5}+\\frac{1}{\\sqrt{5}})} \\\\  & =\\frac{2}{(\\frac{6}{\\sqrt{5}})} \\\\  & =\\frac{\\sqrt{5}}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514449 #edb/ref 1068 #edb/ref 17592186514242 #edb/ref 17592186045417] [17592186514449 #edb/ref 1069 "q-300702" #edb/ref 17592186045417] [17592186514449 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186514449 #edb/ref 1071 "Evaluate $\\operatorname{coth}⁡3.$ **Do not round** your answer.\n$$$$\n\n$\\operatorname{coth}⁡3=$\n {{field-1}}" #edb/ref 17592186045417] [17592186514449 #edb/ref 1072 #uuid "a8d94db5-30b8-5d58-91bd-e8bbc8dd17c5" #edb/ref 17592186045417] [17592186514449 #edb/ref 1074 "$$\n\nThe definition of $\\operatorname{coth}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{coth}⁡x & =\\frac{1}{\\operatorname{tanh}⁡x} \\\\  & =\\frac{{e}^{x}+{e}^{-x}}{{e}^{x}-{e}^{-x}} \\\\  & =\\frac{{e}^{2x}+1}{{e}^{2x}-1} \\\\  & =\\frac{1+{e}^{-2x}}{1-{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}\\operatorname{coth}⁡3 & =\\frac{{e}^{2(3)}+1}{{e}^{2(3)}-1}=\\frac{{e}^{6}+1}{{e}^{6}-1}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514451 #edb/ref 1068 #edb/ref 17592186514252 #edb/ref 17592186045417] [17592186514451 #edb/ref 1069 "q-340820" #edb/ref 17592186045417] [17592186514451 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186514451 #edb/ref 1071 "$$\nEvaluate $\\operatorname{sech}⁡1.$ **Do not round** your answer.\n\n$$\n$\\operatorname{sech}⁡1=$\n{{field-1}}" #edb/ref 17592186045417] [17592186514451 #edb/ref 1072 #uuid "aa7fb149-1626-56db-aafd-3693bf4f703f" #edb/ref 17592186045417] [17592186514451 #edb/ref 1074 "$$\n\nThe definition of $\\operatorname{sech}⁡x$ is\n\n$$\n\\operatorname{sech}⁡x=\\frac{1}{\\operatorname{cosh}⁡x}=\\frac{2}{{e}^{x}+{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡1 & =\\frac{2}{{e}^{1}+{e}^{-1}} \\\\  & =\\frac{2}{(e+\\frac{1}{e})} \\\\  & =\\frac{2}{(\\frac{{e}^{2}+1}{e})} \\\\  & =\\frac{2e}{{e}^{2}+1}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186514458 #edb/ref 1068 #edb/ref 17592186514212 #edb/ref 17592186045417] [17592186514458 #edb/ref 1069 "q-125698" #edb/ref 17592186045417] [17592186514458 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186514458 #edb/ref 1071 "$$\n\nGiven that $t>0,$ which of the following is equivalent to $\\operatorname{sech}⁡(\\operatorname{ln}⁡\\sqrt{t})?$" #edb/ref 17592186045417] [17592186514458 #edb/ref 1072 #uuid "bc92dd53-1396-50af-a160-bf5a5b938587" #edb/ref 17592186045417] [17592186514458 #edb/ref 1074 "$$\n\nThe definition of $\\operatorname{sech}⁡x$ is\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡x=\\frac{1}{\\operatorname{cosh}⁡x}=\\frac{2}{{e}^{x}+{e}^{-x}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡(\\operatorname{ln}⁡\\sqrt{t}) & =\\frac{2}{{e}^{\\operatorname{ln}⁡\\sqrt{t}}+{e}^{-\\operatorname{ln}⁡\\sqrt{t}}} \\\\  & =\\frac{2}{{e}^{\\operatorname{ln}⁡\\sqrt{t}}+{e}^{\\operatorname{ln}⁡(\\sqrt{t})^{-1}}} \\\\  & =\\frac{2}{\\sqrt{t}+(\\sqrt{t})^{-1}} \\\\  & =\\frac{2}{(\\sqrt{t}+\\frac{1}{\\sqrt{t}})} \\\\  & =\\frac{2}{(\\frac{t+1}{\\sqrt{t}})} \\\\  & =\\frac{2\\sqrt{t}}{t+1}.\\end{aligned}\n$$" #edb/ref 17592186045417]}
