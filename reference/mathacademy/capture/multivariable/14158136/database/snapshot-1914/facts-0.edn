b/ref 17592186045498 #edb/ref 17592186045417] [17592186197658 #edb/ref 1083 #uuid "7557b355-b5e6-5c35-9ec5-ce7baaeba82d" #edb/ref 17592186045417] [17592186197660 #edb/ref 1075 #edb/ref 17592186197661 #edb/ref 17592186045417] [17592186197660 #edb/ref 1075 #edb/ref 17592186197662 #edb/ref 17592186045417] [17592186197660 #edb/ref 1075 #edb/ref 17592186197663 #edb/ref 17592186045417] [17592186197660 #edb/ref 1075 #edb/ref 17592186197664 #edb/ref 17592186045417] [17592186197660 #edb/ref 1075 #edb/ref 17592186197665 #edb/ref 17592186045417] [17592186197660 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186197660 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186197660 #edb/ref 1078 #edb/ref 17592186197663 #edb/ref 17592186045417] [17592186197660 #edb/ref 1079 #uuid "3cd3b3e1-98ae-532b-94b3-c5b9b8ab641b" #edb/ref 17592186045417] [17592186197661 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186197661 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186197661 #edb/ref 1083 #uuid "881b0dd0-01c6-5013-9685-0e58c6da71c5" #edb/ref 17592186045417] [17592186197662 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186197662 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186197662 #edb/ref 1083 #uuid "c8a11a8a-6503-5229-93d1-630340faec00" #edb/ref 17592186045417] [17592186197663 #edb/ref 1080 "\\frac{4}{5}" #edb/ref 17592186045417] [17592186197663 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186197663 #edb/ref 1083 #uuid "33e5fb8a-a7fa-5959-b381-9183f9303802" #edb/ref 17592186045417] [17592186197664 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186197664 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186197664 #edb/ref 1083 #uuid "3404d280-8cad-5644-8ec1-3e6e08824288" #edb/ref 17592186045417] [17592186197665 #edb/ref 1080 "-\\frac{2}{5}" #edb/ref 17592186045417] [17592186197665 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186197665 #edb/ref 1083 #uuid "4cd7243b-48c8-50fa-aaa2-6aa1ef439e80" #edb/ref 17592186045417] [17592186198039 #edb/ref 1069 "e-12406" #edb/ref 17592186045417] [17592186198039 #edb/ref 1071 "Consider the finite region $R$ in Cartesian $xyz$-space, given by\n\n$$\nR = \\big\\{ (x,y,z) \\: : \\:1 \\leq xy \\leq  2, \\: 1 \\leq y \\leq 2, \\: 0 \\leq z\\leq 1 \\big\\}.\n$$\n\nBy performing the change of variables\n\n$$\nu=xy,  \\qquad\nv=y, \\qquad\nw=2z,\n$$\n\n \n\nwrite down the triple integral\n\n$$\n\\displaystyle \n\\iiint\\limits_R 3xy^2+6yz \\, \\mathrm{d}V\n$$\n\nas a repeated integral in terms of $u,$ $v,$ and $w.$" #edb/ref 17592186045417] [17592186198039 #edb/ref 1072 #uuid "d123b7fd-5a13-50c0-aa8c-dc196f4b1bcd" #edb/ref 17592186045417] [17592186198039 #edb/ref 1074 "Let's define a transformation $\\mathbf{T}$ as follows:\n\n![](images/b0/b072e1c4e9b4eee6d79c46996af36a570696aa43b52009aed4c0242bbdbc174b.svg)\n\nThis transformation maps some region $\\Delta$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n\\iiint\\limits_{R} f(x,y,z) \\ \\mathrm{d}V = \\iiint\\limits_{\\Delta} \\ f(x(u,v,w), y(u,v,w), z(u,v,w)) \\: \\left| \\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} \\right|  \\: \\textrm{d}u \\textrm{d}v \\textrm{d}w\n$$\n\nwhere $\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)}$ is the Jacobian determinant corresponding to $\\mathbf{T}.$\n\nNote that the change of variables\n\n$$\nu=xy,  \\qquad\nv=y, \\qquad\nw=2z,\n$$\n\n \n\ngives us the *inverse* function $\\mathbf T^{-1},$ that is\n\n![](images/43/43eda6a90b6650ff4e9fe8b73bb22126201c860e33060a256ff71761ff1530be.svg)\n\nTo find the required integral, we proceed in four steps:\n\n**Step 1**: Find $\\Delta,$ which is the image of $R$ under the action of $\\mathbf{T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,1\\le u\\le 2,\\,1\\le v\\le 2,\\,0\\le w\\le 2\\}.\\end{aligned}\n$$\n\n  \n\n**Step 2**: Compute the Jacobian determinant corresponding to $\\mathbf T^{-1}{:}$\n\nThe Jacobian determinant corresponding to $\\mathbf T^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}y & x & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 2\\end{aligned}| \\\\  & =2|\\begin{aligned}y & x \\\\ 0 & 1\\end{aligned}| \\\\  & =2(y-0) \\\\  & =2y \\\\  & =2v.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $\\mathbf T{:}$\n\nThe Jacobian determinant corresponding to $\\mathbf T$ is\n\n$$\n\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} = \\left( \\dfrac{\\partial (u, v, w)}{\\partial (x, y, z)} \\right)^{-1} =\\dfrac{1}{2v}.\n$$\n\nNote that $\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} \\neq 0$ everywhere inside $\\Delta.$ In other words, $\\mathbf{T}$ has no critical points inside $\\Delta.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}3x{y}^{2}+6yz\\,dV & ={∭}_{Δ}(3uv+3vw)\\cdot |\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}3v(u+w)\\cdot |\\frac{1}{2v}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{0}^{2}\\frac{3}{2}(u+w)\\,dw\\,dv\\,du\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198040 #edb/ref 1069 "e-12407" #edb/ref 17592186045417] [17592186198040 #edb/ref 1071 "Use the change of variables \n\n$$\nu = x+y^2, \\qquad\nv=  y+z, \\qquad\nw = 2z\n$$\n\nto evaluate the triple integral\n\n$$\n\\displaystyle \n\\iiint \\limits_R (x+y^2)^{15}z \\: \\mathrm{d}V,\n$$\n\n \nwhere the region $R$ is given by\n\n$$\nR = \\big\\{ (x,y,z) \\: : \\:  0 \\leq x+y^2 \\leq 1, \\: 0 \\leq y+z \\leq 4, \\: 0\\leq z\\leq 2 \\big\\}.\n$$" #edb/ref 17592186045417] [17592186198040 #edb/ref 1072 #uuid "3fccb151-d67f-525b-8804-62589913084a" #edb/ref 17592186045417] [17592186198040 #edb/ref 1074 "Let's define a transformation $\\mathbf{T}$ as follows:\n\n![](images/c7/c71a8a9cf964b3c0a6123c616da0eed54a2a8dcfae2ca2bb6f83bb135d008442.svg)\n\nThis transformation maps some region $\\Delta$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n\\iiint\\limits_{R} f(x,y,z) \\ \\mathrm{d}V = \\iiint\\limits_{\\Delta} \\ f(x(u,v,w), y(u,v,w), z(u,v,w)) \\: \\left| \\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} \\right|  \\: \\textrm{d}u \\textrm{d}v \\textrm{d}w\n$$\n\nwhere $\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)}$ is the Jacobian determinant corresponding to $\\mathbf{T}.$\n\nNote that the change of variables\n\n$$\nu = x+y^2, \\qquad\nv=  y+z, \\qquad\nw = 2z\n$$\n\ngives us the *inverse* function $\\mathbf T^{-1},$ that is\n\n![](images/68/68ee2a9eee49a479542cf9b1c6342b14d313fa2ad3c6e82f38bc4e584d7f15e2.svg)\n\nTo compute the required integral, we proceed in four steps:\n\n**Step 1**: Find $\\Delta,$ which is the image of $R$ under the action of $\\mathbf{T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 4,\\,0\\le w\\le 4\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to $\\mathbf T^{-1}{:}$\n\nThe Jacobian determinant corresponding to $\\mathbf T^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 2y & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 2\\end{aligned}| \\\\  & =1\\cdot 1\\cdot 2 \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $\\mathbf T{:}$\n\nThe Jacobian determinant corresponding to $\\mathbf T$ is\n\n$$\n\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} = \\left( \\dfrac{\\partial (u, v, w)}{\\partial (x, y, z)} \\right)^{-1} = \\dfrac{1}{2}.\n$$\n\nNote that $\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} \\neq 0$ everywhere inside $\\Delta.$ In other words, $\\mathbf{T}$ has no critical points inside $\\Delta.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}(x+{y}^{2})^{15}z\\,dV & ={∭}_{Δ}{u}^{15}\\cdot \\frac{w}{2}\\cdot |\\frac{1}{2}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & =\\frac{1}{4}{∭}_{Δ}{u}^{15}w\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & =\\frac{1}{4}{\\int }_{0}^{1}{\\int }_{0}^{4}{\\int }_{0}^{4}{u}^{15}w\\,dw\\,dv\\,du \\\\  & =\\frac{1}{4}{\\int }_{0}^{1}{u}^{15}\\,du\\cdot {\\int }_{0}^{4}dv\\cdot {\\int }_{0}^{4}w\\,dw \\\\  & =\\frac{1}{4}\\cdot [\\frac{{u}^{16}}{16}]_{u=0}^{u=1}\\cdot {[v]}_{v=0}^{v=4}\\cdot [\\frac{{w}^{2}}{2}]_{w=0}^{w=4} \\\\  & =\\frac{1}{4}\\cdot (\\frac{1}{16}-0)\\cdot (4-0)\\cdot (8-0) \\\\  & =\\frac{1}{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198041 #edb/ref 1069 "e-12408" #edb/ref 17592186045417] [17592186198041 #edb/ref 1071 "Find the volume bounded by the region $R,$ given by\n\n$$\nR = \\big\\{ (x,y,z) \\: : \\: 0 \\leq x+y \\leq 1, \\:-2 \\leq y-2x \\leq 2, \\: 1 \\leq z^3 \\leq 8 \\big\\}.\n$$" #edb/ref 17592186045417] [17592186198041 #edb/ref 1072 #uuid "e00a8e15-e738-5fee-80f7-405844fa1422" #edb/ref 17592186045417] [17592186198041 #edb/ref 1074 "Recall that the volume of $R$ can be found as \n\n$$\nV = \\iiint\\limits_R \\textrm{d}V.\n$$\n\nLet's define a transformation $\\mathbf{T}$ as follows:\n\n![](images/8a/8a5074508ee964b1d8a8e06748967bb8cbfa4be838a9b60df643e14f2534057c.svg)\n\nThis transformation maps some region $\\Delta$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required volume, we can use the change of variables formula\n\n$$\n\\iiint\\limits_{R} f(x,y,z) \\ \\mathrm{d}V = \\iiint\\limits_{\\Delta} \\ f(x(u,v,w), y(u,v,w), z(u,v,w)) \\: \\left| \\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} \\right|  \\: \\textrm{d}u \\textrm{d}v \\textrm{d}w\n$$\n\nwhere $\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)}$ is the Jacobian determinant corresponding to $\\mathbf{T}.$\n\nThe inequalities that define the region $R,$\n\n$$\n0 \\leq x+y \\leq 1, \\qquad\n-2 \\leq y-2x \\leq 2, \\qquad\n1 \\leq z^3 \\leq 8,\n$$\n\nsuggest that we use the change of variables\n\n$$\nu = x+y, \\qquad\nv = y-2x, \\qquad\nw = z^3.\n$$\n\nThis change of variables gives us the *inverse* function $\\mathbf T^{-1},$ that is\n\n![](images/bf/bf84bc5921637c5f5c7fda7b8cb549c993444a6eb1e2df6468e22c3ed041fdd7.svg)\n\nTo compute the required volume, we proceed in four steps:\n\n**Step 1**: Find $\\Delta,$ which is the image of $R$ under the action of $\\mathbf{T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,0\\le u\\le 1,\\,-2\\le v\\le 2,\\,1\\le w\\le 8\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to $\\mathbf T^{-1}{:}$\n\nThe Jacobian determinant corresponding to $\\mathbf T^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 1 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 3{z}^{2}\\end{aligned}| \\\\  & =3{z}^{2}(-1)^{3+3}|\\begin{aligned}1 & 1 \\\\ -2 & 1\\end{aligned}| \\\\  & =9{z}^{2} \\\\  & =9{w}^{2/3}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $\\mathbf T{:}$\n\nThe Jacobian determinant corresponding to $\\mathbf T$ is\n\n$$\n\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} = \\left( \\dfrac{\\partial (u, v, w)}{\\partial (x, y, z)} \\right)^{-1} = \\dfrac 19 w^{-2/3}.\n$$\n\nNote that $\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} \\neq 0$ everywhere inside $\\Delta.$ In other words, $\\mathbf{T}$ has no critical points inside $\\Delta.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}dV & ={∭}_{Δ}1\\cdot |\\frac{1}{9}{w}^{-2/3}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{0}^{1}{\\int }_{-2}^{2}{\\int }_{1}^{8}\\frac{1}{9}{w}^{-2/3}\\,dw\\,dv\\,du \\\\  & =\\frac{1}{9}{\\int }_{0}^{1}du\\cdot {\\int }_{-2}^{2}dv\\cdot {\\int }_{1}^{8}{w}^{-2/3}dw \\\\  & =\\frac{1}{9}[u]_{0}^{1}\\cdot [v]_{-2}^{2}\\cdot [3{w}^{1/3}]_{1}^{8} \\\\  & =\\frac{1}{9}\\cdot (1-0)\\cdot (2-(-2))\\cdot 3({8}^{1/3}-{1}^{1/3}) \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198397 #edb/ref 1037 #edb/ref 17592186048839 #edb/ref 17592186045417] [17592186198397 #edb/ref 1037 #edb/ref 17592186049530 #edb/ref 17592186045417] [17592186198397 #edb/ref 1037 #edb/ref 17592186050482 #edb/ref 17592186045417] [17592186198397 #edb/ref 1038 #edb/ref 17592186198959 #edb/ref 17592186045417] [17592186198397 #edb/ref 1038 #edb/ref 17592186198963 #edb/ref 17592186045417] [17592186198397 #edb/ref 1038 #edb/ref 17592186374083 #edb/ref 17592186045417] [17592186198397 #edb/ref 1038 #edb/ref 17592186375123 #edb/ref 17592186045417] [17592186198397 #edb/ref 1038 #edb/ref 17592186401302 #edb/ref 17592186045417] [17592186198397 #edb/ref 1038 #edb/ref 17592186482511 #edb/ref 17592186045417] [17592186198397 #edb/ref 1038 #edb/ref 17592186482515 #edb/ref 17592186045417] [17592186198397 #edb/ref 1038 #edb/ref 17592186482534 #edb/ref 17592186045417] [17592186198397 #edb/ref 1038 #edb/ref 17592186482540 #edb/ref 17592186045417] [17592186198397 #edb/ref 1039 "Performing a Change of Variables in a Triple Integral" #edb/ref 17592186045417] [17592186198397 #edb/ref 1041 #edb/ref 17592186198039 #edb/ref 17592186045417] [17592186198397 #edb/ref 1042 #uuid "a898f345-9210-5976-9a42-f415a0e7eaf5" #edb/ref 17592186045417] [17592186198398 #edb/ref 1038 #edb/ref 17592186198623 #edb/ref 17592186045417] [17592186198398 #edb/ref 1038 #edb/ref 17592186198964 #edb/ref 17592186045417] [17592186198398 #edb/ref 1038 #edb/ref 17592186374090 #edb/ref 17592186045417] [17592186198398 #edb/ref 1038 #edb/ref 17592186374097 #edb/ref 17592186045417] [17592186198398 #edb/ref 1038 #edb/ref 17592186374125 #edb/ref 17592186045417] [17592186198398 #edb/ref 1038 #edb/ref 17592186374132 #edb/ref 17592186045417] [17592186198398 #edb/ref 1038 #edb/ref 17592186374139 #edb/ref 17592186045417] [17592186198398 #edb/ref 1038 #edb/ref 17592186482530 #edb/ref 17592186045417] [17592186198398 #edb/ref 1038 #edb/ref 17592186482599 #edb/ref 17592186045417] [17592186198398 #edb/ref 1038 #edb/ref 17592186482606 #edb/ref 17592186045417] [17592186198398 #edb/ref 1039 "Evaluating a Triple Integral Using a Change of Variables" #edb/ref 17592186045417] [17592186198398 #edb/ref 1041 #edb/ref 17592186198040 #edb/ref 17592186045417] [17592186198398 #edb/ref 1042 #uuid "832dc2b8-873f-56c6-bd87-5e886a586fb1" #edb/ref 17592186045417] [17592186198399 #edb/ref 1037 #edb/ref 17592186048997 #edb/ref 17592186045417] [17592186198399 #edb/ref 1038 #edb/ref 17592186198624 #edb/ref 17592186045417] [17592186198399 #edb/ref 1038 #edb/ref 17592186198965 #edb/ref 17592186045417] [17592186198399 #edb/ref 1038 #edb/ref 17592186374152 #edb/ref 17592186045417] [17592186198399 #edb/ref 1038 #edb/ref 17592186374159 #edb/ref 17592186045417] [17592186198399 #edb/ref 1038 #edb/ref 17592186374166 #edb/ref 17592186045417] [17592186198399 #edb/ref 1038 #edb/ref 17592186374173 #edb/ref 17592186045417] [17592186198399 #edb/ref 1038 #edb/ref 17592186482547 #edb/ref 17592186045417] [17592186198399 #edb/ref 1038 #edb/ref 17592186482580 #edb/ref 17592186045417] [17592186198399 #edb/ref 1038 #edb/ref 17592186482615 #edb/ref 17592186045417] [17592186198399 #edb/ref 1038 #edb/ref 17592186482616 #edb/ref 17592186045417] [17592186198399 #edb/ref 1039 "Computing the Volume of a Region Using a Change of Variables" #edb/ref 17592186045417] [17592186198399 #edb/ref 1041 #edb/ref 17592186198041 #edb/ref 17592186045417] [17592186198399 #edb/ref 1042 #uuid "a8a79d4e-f9e0-583e-8e52-aa60c14fd4a3" #edb/ref 17592186045417] [17592186198490 #edb/ref 1043 #edb/ref 17592186199269 #edb/ref 17592186045417] [17592186198490 #edb/ref 1043 #edb/ref 17592186199311 #edb/ref 17592186045417] [17592186198490 #edb/ref 1043 #edb/ref 17592186199312 #edb/ref 17592186045417] [17592186198490 #edb/ref 1043 #edb/ref 17592186199313 #edb/ref 17592186045417] [17592186198490 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186198490 #edb/ref 1045 "Computing Triple Integrals Using a Change of Variables" #edb/ref 17592186045417] [17592186198490 #edb/ref 1046 #edb/ref 17592186199269 #edb/ref 17592186045417] [17592186198490 #edb/ref 1049 #edb/ref 17592186049639 #edb/ref 17592186045417] [17592186198490 #edb/ref 1050 1080.0 #edb/ref 17592186045417] [17592186198490 #edb/ref 1053 #uuid "9c0cd1dd-d41d-511e-aa18-44cf1df53bbc" #edb/ref 17592186045417] [17592186198623 #edb/ref 1068 #edb/ref 17592186194369 #edb/ref 17592186045417] [17592186198623 #edb/ref 1069 "q-162139" #edb/ref 17592186045417] [17592186198623 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186198623 #edb/ref 1071 "Use the change of variables \n\n$$\nu=3x-2y,\\,v=y+2z,\\,w=z\n$$\n\nto evaluate the triple integral\n\n$$\n{∭}_{R}(3x-2y)^{2}(y+2z)\\,dV,\n$$\n\n \nwhere the region $R$ is given by\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le 3x-2y\\le 3,\\,0\\le y+2z\\le 2,\\,0\\le 2z\\le 1\\}.\n$$" #edb/ref 17592186045417] [17592186198623 #edb/ref 1072 #uuid "1d5d9726-730c-531d-b668-66f3dda1040e" #edb/ref 17592186045417] [17592186198623 #edb/ref 1074 "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=3x-2y,\\,v=y+2z,\\,w=z\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo compute the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is \n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,0\\le u\\le 3,\\,0\\le v\\le 2,\\,0\\le w\\le \\frac{1}{2}\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}3 & -2 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =3\\cdot 1\\cdot 1 \\\\  & =3.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=\\frac{1}{3}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}(3x-2y)^{2}(y+2z)\\,dV & ={∭}_{Δ}{u}^{2}v\\cdot |\\frac{1}{3}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}\\frac{1}{3}{u}^{2}v\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & =\\frac{1}{3}{\\int }_{0}^{3}{\\int }_{0}^{2}{\\int }_{0}^{1/2}{u}^{2}v\\,dw\\,dv\\,du \\\\  & =\\frac{1}{3}{\\int }_{0}^{3}{u}^{2}\\,du\\cdot {\\int }_{0}^{2}v\\,dv\\cdot {\\int }_{0}^{1/2}dw \\\\  & =\\frac{1}{3}\\cdot {[\\frac{{u}^{3}}{3}]}_{u=0}^{u=3}\\cdot {[\\frac{{v}^{2}}{2}]}_{v=0}^{v=2}\\cdot [w]_{w=0}^{w=1/2} \\\\  & =\\frac{1}{3}\\cdot (9-0)\\cdot (2-0)\\cdot (\\frac{1}{2}-0) \\\\  & =3\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198963 #edb/ref 1068 #edb/ref 17592186197648 #edb/ref 17592186045417] [17592186198963 #edb/ref 1069 "q-39054" #edb/ref 17592186045417] [17592186198963 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186198963 #edb/ref 1071 "Consider the finite region $R$ in the $xyz$-space, given by\n\n$$\nR=\\{(x,y,z)\\,:\\,\\frac{3\\pi }{4}\\le 2x+y\\le \\pi ,\\,0\\le y+z\\le \\frac{\\pi }{2},\\,-1\\le z\\le 1\\}.\n$$\n\nGiven the change of variables\n\n$$\nu=2x+y,\\,v=y+z,\\,w=z,\n$$\n\nwhich of the following could be the missing part of the expression below?\n\n$$\n{∭}_{R}\\operatorname{sin}⁡(2x+y)\\operatorname{cos}⁡(y+z)\\,dV={\\int }_{3\\pi /4}^{\\pi }{\\int }_{0}^{\\pi /2}{\\int }_{-1}^{1}\\bbox[3pt,border: 1pt solid black]{\\phantom{AAAAAA}}\\,dw\\,dv\\,du\n$$" #edb/ref 17592186045417] [17592186198963 #edb/ref 1072 #uuid "9d27a7ac-3737-5071-b997-af83c998bd7d" #edb/ref 17592186045417] [17592186198963 #edb/ref 1074 "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=2x+y,\\,v=y+z,\\,w=z\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo find the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,\\frac{3\\pi }{4}\\le u\\le \\pi ,\\,0\\le v\\le \\frac{\\pi }{2},\\,-1\\le w\\le 1\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =2|\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}| \\\\  & =2(1-0) \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}\\operatorname{sin}⁡(2x+y)\\operatorname{cos}⁡(y+z)\\,dV & ={∭}_{Δ}\\operatorname{sin}⁡u\\operatorname{cos}⁡v\\cdot |\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}\\operatorname{sin}⁡u\\operatorname{cos}⁡v\\cdot |\\frac{1}{2}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{3\\pi /4}^{\\pi }{\\int }_{0}^{\\pi /2}{\\int }_{-1}^{1}\\,\\frac{1}{2}\\operatorname{sin}⁡u\\operatorname{cos}⁡v\\,\\,dw\\,dv\\,du\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198964 #edb/ref 1068 #edb/ref 17592186197654 #edb/ref 17592186045417] [17592186198964 #edb/ref 1069 "q-39055" #edb/ref 17592186045417] [17592186198964 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186198964 #edb/ref 1071 "Use the change of variables \n\n$$\nu={x}^{2}+y,\\,v=x+z,\\,w=z\n$$\n\nto evaluate the triple integral\n\n$$\n{∭}_{R}(x+z)\\operatorname{cos}⁡({x}^{2}+y)\\,dV,\n$$\n\n \nwhere the region $R$ is given by\n\n$$\nR=\\{(x,y,z)\\,:\\,\\frac{\\pi }{6}\\le {x}^{2}+y\\le \\frac{\\pi }{2},\\,0\\le x+z\\le 2,\\,-1\\le z\\le 1\\}.\n$$" #edb/ref 17592186045417] [17592186198964 #edb/ref 1072 #uuid "3982f9b1-ca56-5e4b-8f97-4f23fb6f2fc3" #edb/ref 17592186045417] [17592186198964 #edb/ref 1074 "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu={x}^{2}+y,\\,v=x+z,\\,w=z\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo compute the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,\\frac{\\pi }{6}\\le u\\le \\frac{\\pi }{2},\\,0\\le v\\le 2,\\,-1\\le w\\le 1\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}2x & 1 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =1(-1)^{3+3}|\\begin{aligned}2x & 1 \\\\ 1 & 0\\end{aligned}| \\\\  & =0-1 \\\\  & =-1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=-1.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}(x+z)\\operatorname{cos}⁡({x}^{2}+y)\\,dV & ={∭}_{Δ}v\\operatorname{cos}⁡u\\cdot |-1|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}v\\operatorname{cos}⁡u\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{\\pi /6}^{\\pi /2}{\\int }_{0}^{2}{\\int }_{-1}^{1}v\\operatorname{cos}⁡u\\,dw\\,dv\\,du \\\\  & ={\\int }_{\\pi /6}^{\\pi /2}\\operatorname{cos}⁡u\\,du\\cdot {\\int }_{0}^{2}v\\,dv\\cdot {\\int }_{-1}^{1}dw \\\\  & =[\\operatorname{sin}⁡u]_{u=\\pi /6}^{u=\\pi /2}\\cdot {[\\frac{{v}^{2}}{2}]}_{v=0}^{v=2}\\cdot [w]_{w=-1}^{w=1} \\\\  & =(1-\\frac{1}{2})\\cdot (\\frac{{2}^{2}}{2}-0)\\cdot (1-(-1)) \\\\  & =2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186198965 #edb/ref 1068 #edb/ref 17592186197660 #edb/ref 17592186045417] [17592186198965 #edb/ref 1069 "q-39060" #edb/ref 17592186045417] [17592186198965 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186198965 #edb/ref 1071 "Find the volume bounded by the region $R,$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,1\\le y\\le 2,\\,1\\le \\sqrt{y}+x\\le 2,\\,1\\le \\frac{1}{z+1}\\le 5\\}.\n$$" #edb/ref 17592186045417] [17592186198965 #edb/ref 1072 #uuid "8b45928b-ff82-5faf-a3d8-f16998390abd" #edb/ref 17592186045417] [17592186198965 #edb/ref 1074 "Recall that the volume of $R$ can be found as \n\n$$\nV={∭}_{R}\\text{d}V.\n$$\n\nLet's define a transformation $T$ as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required volume, we can use the change of variables formula\n\n$$\n{∬}_{R}f(x,y,z)\\text{ }dA={∬}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nThe inequalities that define the region $R,$\n\n$$\n1\\le y\\le 2,\\,1\\le \\sqrt{y}+x\\le 2,\\,1\\le \\frac{1}{z+1}\\le 5,\n$$\n\nsuggest that we use the change of variables\n\n$$\nu=y,\\,v=\\sqrt{y}+x,\\,w=\\frac{1}{z+1}.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo compute the required volume, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,1\\le u\\le 2,\\,1\\le v\\le 2,\\,1\\le w\\le 5\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 1 & 0 \\\\ 1 & \\frac{1}{2\\sqrt{y}} & 0 \\\\ 0 & 0 & -(z+1)^{-2}\\end{aligned}| \\\\  & =1(-1)^{1+2}|\\begin{aligned}1 & 0 \\\\ 0 & -(z+1)^{-2}\\end{aligned}| \\\\  & =-(-(z+1)^{-2}-0) \\\\  & =\\frac{1}{(z+1)^{2}} \\\\  & ={w}^{2}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=\\frac{1}{{w}^{2}}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}dV & ={∭}_{Δ}1\\cdot |\\frac{1}{{w}^{2}}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{5}{w}^{-2}\\,dw\\,dv\\,du \\\\  & ={\\int }_{1}^{2}du\\cdot {\\int }_{1}^{2}dv\\cdot {\\int }_{1}^{5}{w}^{-2}dw \\\\  & =[u]_{u=1}^{u=2}\\cdot [v]_{v=1}^{v=2}\\cdot [-{w}^{-1}]_{w=1}^{w=5} \\\\  & =(2-1)\\cdot (2-1)\\cdot (-\\frac{1}{5}+1) \\\\  & =\\frac{4}{5}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186199269 #edb/ref 1058 #edb/ref 17592186199311 #edb/ref 17592186045417] [17592186199269 #edb/ref 1061 42964 #edb/ref 17592186045417] [17592186199269 #edb/ref 1062 #uuid "c8fb7bf0-e270-5a21-96df-05f4bb90a104" #edb/ref 17592186045417] [17592186199269 #edb/ref 1063 #edb/ref 17592186199461 #edb/ref 17592186045417] [17592186199311 #edb/ref 1058 #edb/ref 17592186199312 #edb/ref 17592186045417] [17592186199311 #edb/ref 1061 44576 #edb/ref 17592186045417] [17592186199311 #edb/ref 1062 #uuid "9ff6a5f7-0ed3-5407-9add-6b4b8b9f9576" #edb/ref 17592186045417] [17592186199311 #edb/ref 1063 #edb/ref 17592186198397 #edb/ref 17592186045417] [17592186199312 #edb/ref 1058 #edb/ref 17592186199313 #edb/ref 17592186045417] [17592186199312 #edb/ref 1061 44578 #edb/ref 17592186045417] [17592186199312 #edb/ref 1062 #uuid "72db4d82-680c-5663-9ec8-49034717bf11" #edb/ref 17592186045417] [17592186199312 #edb/ref 1063 #edb/ref 17592186198398 #edb/ref 17592186045417] [17592186199313 #edb/ref 1061 44583 #edb/ref 17592186045417] [17592186199313 #edb/ref 1062 #uuid "63e21bf5-1c47-551b-9e3f-4385831c5ab7" #edb/ref 17592186045417] [17592186199313 #edb/ref 1063 #edb/ref 17592186198399 #edb/ref 17592186045417] [17592186199461 #edb/ref 1064 "Suppose that the transformation $\\mathbf T,$ given by\n\n$$\n\\mathbf T: (u,v,w) \\longrightarrow \\left(x(u,v,w), \\, y(u,v,w), \\, z(u,v,w) \\right)\n$$\n\nis a $C^1$ transformation that has no critical points (i.e., it is invertible) inside some region $\\Delta\\subset \\mathbb R^3,$ and that $\\mathbf T(\\Delta) = R,$ as shown below.\n\n![](images/d7/d7875753545cba8babd08fccaf55236c6b32bfc56f43f496343174acc198f1d9.png)\n\n \n\nTo compute the integral of a function $f(x,y,z)$ over $R,$ we use the change of variables formula\n\n$$\n\\iiint\\limits_{R} f(x,y,z) \\ \\mathrm{d}V = \\iiint\\limits_{\\Delta} \\ f(x(u,v,w), y(u,v,w), z(u,v,w)) \\: \\left| \\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} \\right|  \\: \\textrm{d}u \\textrm{d}v \\textrm{d}w\n$$\n\nwhere $\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)}$ is the Jacobian determinant corresponding to $\\mathbf{T}.$\n\nNote the similarity with the change of variables formula for double integrals." #edb/ref 17592186045417] [17592186199461 #edb/ref 1065 7217 #edb/ref 17592186045417] [17592186199461 #edb/ref 1066 #uuid "a43397ab-8a32-5928-ba64-90ad84532ab1" #edb/ref 17592186045417] [17592186199461 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186481792 #edb/ref 1080 "{\\int }_{1}^{2}{\\int }_{0}^{2}{\\int }_{0}^{3w}\\frac{1}{3}(u+\\frac{vw}{u})\\,dw\\,dv\\,du" #edb/ref 17592186045417] [17592186481792 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186481792 #edb/ref 1083 #uuid "0a545db6-b2c1-5af7-bab8-a92a067e183d" #edb/ref 17592186045417] [17592186481795 #edb/ref 1080 "16" #edb/ref 17592186045417] [17592186481795 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [175921