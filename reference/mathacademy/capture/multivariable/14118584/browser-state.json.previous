              "type": "image",
              "value": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14118584/assets/7d6d07e888cd0dd55fd37a8a620c8be054eee0e6abc170133a4188667dcc65b4.png",
