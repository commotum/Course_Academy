      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14223941/observations/step-q121678-2b56d1177b622d2b0de2.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14223941/observations/step-q121678-2b56d1177b622d2b0de2.png",
      "source_url": "https://mathacademy.com/tasks/14223941/topics/346/review",
      "captured_at": 1792041202.240214,
      "math_academy_id": "q-121678",
