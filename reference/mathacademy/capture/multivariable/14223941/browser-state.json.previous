      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14223941/observations/step-q346635-339e55f3519316039400.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14223941/observations/step-q346635-339e55f3519316039400.png",
      "source_url": "https://mathacademy.com/tasks/14223941/topics/346/review",
      "captured_at": 1792041223.0663297,
      "math_academy_id": "q-346635",
