#{[{:activity/expected-seconds 1500.0 :activity/first-step {:db/id #edb/ref 17592186065330} :activity/id #uuid "8d3375a4-6e38-5507-bb65-38b3c2679448" :activity/scope {:db/id #edb/ref 17592186050645 :topic/id #uuid "5bfd7882-2604-57b4-bd18-ab558a07257a" :topic/math-academy-id 346} :activity/steps [{:db/id #edb/ref 17592186065179 :step/content {:db/id #edb/ref 17592186064290 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064133 :question/id #uuid "5a66344e-2092-5bd6-a4d0-5663f83866b3" :question/math-academy-id "e-7556"} :knowledge-point/id #uuid "93452be9-27a3-5c5d-b4f2-11b6b1896bca" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049112}] :knowledge-point/questions [{:db/id #edb/ref 17592186064699} {:db/id #edb/ref 17592186064891} {:db/id #edb/ref 17592186523966} {:db/id #edb/ref 17592186523974} {:db/id #edb/ref 17592186523977} {:db/id #edb/ref 17592186524020} {:db/id #edb/ref 17592186524037} {:db/id #edb/ref 17592186538944} {:db/id #edb/ref 17592186538989}] :knowledge-point/title "Calculating the Rate of Change of Fluid Level Using Similar Solids"} :step/id #uuid "3221fdfa-82ca-53c8-b3b8-3f64fe8fa9db" :step/math-academy-id 631148 :step/next {:db/id #edb/ref 17592186065332}} {:db/id #edb/ref 17592186065180 :step/content {:db/id #edb/ref 17592186064291 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064134 :question/id #uuid "3de34c88-a367-5e9f-b8de-c46953be4655" :question/math-academy-id "e-7557"} :knowledge-point/id #uuid "1ab44410-8968-52e0-983f-318416a68cb5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048214} {:db/id #edb/ref 17592186048930} {:db/id #edb/ref 17592186049658}] :knowledge-point/questions [{:db/id #edb/ref 17592186064623} {:db/id #edb/ref 17592186064964} {:db/id #edb/ref 17592186523968} {:db/id #edb/ref 17592186523990} {:db/id #edb/ref 17592186523998}] :knowledge-point/title "Calculating a Rate of Change of Volume Given a Rate of Change of Radius or Height"} :step/id #uuid "9d699428-5e3b-56fd-9632-aa59ba1c3b22" :step/math-academy-id 631141 :step/next {:db/id #edb/ref 17592186065331}} {:db/id #edb/ref 17592186065330 :step/content {:db/id #edb/ref 17592186065389 :tutorial/content "We can use differentiation to solve related rates problems in the context of cones. In general, we follow the usual three steps:\n\n**Step 1:** Draw a diagram and identify the variables that change with time.\n\n**Step 2:** Write down a relation between the time-dependent variables.\n\n**Step 3:** Differentiate the relation with respect to time and plug in the known values.\n\nBefore we start, recall that the volume $v$ of a right cone of radius $r$ and height $h$ (shown below) is given by the formula\n\n$$\nv = \\dfrac13 \\pi r^2 h.\n$$\n\n![](images/cf/cf4e3b5b9f0d827bccaee008e006ad62d870fb2d782df8dd94f61bc4a3ca4050.png)" :tutorial/id #uuid "312c7731-2fba-5fc2-9a6b-e551caf483da" :tutorial/math-academy-id 505 :tutorial/title "Introduction"} :step/id #uuid "98362ef7-51a3-58ec-b8a6-e61dd3fe2604" :step/math-academy-id 631140 :step/next {:db/id #edb/ref 17592186065180}} {:db/id #edb/ref 17592186065331 :step/content {:db/id #edb/ref 17592186064387 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064031 :question/id #uuid "808feb74-65a8-5339-b263-f92ef91bfefb" :question/math-academy-id "e-235"} :knowledge-point/id #uuid "4b2d47c1-0f0c-5722-8778-6f2c3236401b" :knowledge-point/questions [{:db/id #edb/ref 17592186064651} {:db/id #edb/ref 17592186064661} {:db/id #edb/ref 17592186523973} {:db/id #edb/ref 17592186523989} {:db/id #edb/ref 17592186524006} {:db/id #edb/ref 17592186524011} {:db/id #edb/ref 17592186524018} {:db/id #edb/ref 17592186538987} {:db/id #edb/ref 17592186538990}] :knowledge-point/title "Calculating a Rate of Change of Radius or Height Given a Rate of Change of Volume"} :step/id #uuid "048a3659-fb35-56bd-968d-481e141e8dc0" :step/math-academy-id 631145 :step/next {:db/id #edb/ref 17592186065179}} {:db/id #edb/ref 17592186065332 :step/content {:db/id #edb/ref 17592186064388 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064032 :question/id #uuid "6ce9d38b-08d9-5372-b501-298970a2f11f" :question/math-academy-id "e-236"} :knowledge-point/id #uuid "ca9039f1-d299-55fe-8242-b3a6edcb49e6" :knowledge-point/questions [{:db/id #edb/ref 17592186064698} {:db/id #edb/ref 17592186064965} {:db/id #edb/ref 17592186523929} {:db/id #edb/ref 17592186523993} {:db/id #edb/ref 17592186524000} {:db/id #edb/ref 17592186524015} {:db/id #edb/ref 17592186524023} {:db/id #edb/ref 17592186538976}] :knowledge-point/title "Calculating a Rate of Change of Volume Using Similar Solids"} :step/id #uuid "b587e57d-1015-5614-bb4a-85ca3b85dc4f" :step/math-academy-id 631153}] :activity/title "Calculating Related Rates With Cones" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064437}] [{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186539037} :activity/id #uuid "98f05ba6-bc0e-5c52-a668-77d2d398ff27" :activity/scope {:db/id #edb/ref 17592186050645 :topic/id #uuid "5bfd7882-2604-57b4-bd18-ab558a07257a" :topic/math-academy-id 346} :activity/steps [{:db/id #edb/ref 17592186539037 :step/content {:db/id #edb/ref 17592186538989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3de78098-2f30-5690-a297-c93784039e6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1.5\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186538358} {:answer/id #uuid "5fb7824d-c0c6-5aa8-963a-415d8fba6461" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.5\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186538443} {:answer/id #uuid "b514ce4c-c0a9-56cf-b77b-d76239980c0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186538653} {:answer/id #uuid "dce2f00a-8e3b-5f21-85eb-ac015d859b8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186538739} {:answer/id #uuid "ebb12994-1f15-5905-ac9f-a9912f0659fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.25\\,\\text{cm}/\\text{min}" :db/id #edb/ref 17592186538770}] :answer-field/correct {:db/id #edb/ref 17592186538653} :answer-field/id #uuid "b3b0ce1e-2140-5aca-87cb-414958166a8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538891}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a327d128-352b-50f9-99e7-ff67c5f44d4a" :question/math-academy-id "q-31996" :question/problem "![](images/13/135ce8e277c0895d36972e12fb7df68447af79765c4acaaba6fb0e63fc498d73.png)\n\nThe height of an ice-cream cone is $6\\,\\text{cm}$ and the radius at the top of the cone is $1.5\\,\\text{cm}.$ Some ice-cream is leaking from a small hole at the bottom at a rate of $\\pi \\,{\\text{cm}}^{3}/\\text{min}.$ If the ice-cream level is $4\\,\\text{cm}$ at a particular moment, how fast is the ice-cream level decreasing at that moment?" :question/worked-solution "First, let's consider the dimensions of the cone. Let's call $H=6\\,\\text{cm}$ the height of the cone, and $R=1.5\\,\\text{cm}$ its radius at the top. These quantities are fixed and do not change with time.\n\nNow, let's consider the ice cream level. We call $h$ the height of the ice cream in the cone and $r$ the radius of the ice cream top surface. Both of these quantities, and the ice cream volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-\\pi \\,{\\text{cm}}^{3}/\\text{min},\n$$\n\nand we want to find the rate of change of the ice cream level $\\frac{\\text{d}h}{\\text{d}t}$ when $h=4\\,\\text{cm}.$\n\nWe need to find a relation between $v$ and the variable for which we know the rate of change, which is $h.$ This is given by the formula for the volume of the ice cream:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nNote that the cone and the ice cream part of the cone must be similar. Therefore, we have\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{R}{H} \\\\ \\frac{r}{h} & =\\frac{1.5}{6} \\\\ r & =\\frac{h}{4}\\,.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\n\\begin{aligned}v & =\\frac{1}{3}\\pi {(\\frac{h}{4})}^{2}h \\\\  & =\\frac{1}{48}\\pi {h}^{3}\\,.\\end{aligned}\n$$\n\nNow that we have an equation relating $v$ and $h,$ we differentiate with respect to time using the chain rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}v & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{48}\\pi {h}^{3}) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =\\frac{1}{16}\\pi {h}^{2}\\frac{\\text{d}h}{\\text{d}t}\\end{aligned}\n$$\n\nWe want to find the rate of change of the ice cream level in the cone when $h=4\\,\\text{cm}.$ We can compute the value of $h$ at this moment as follows:\n\n$$\n\\begin{aligned}-\\pi  & =\\frac{1}{16}\\pi ({4}^{2})\\frac{\\text{d}h}{\\text{d}t} \\\\ \\frac{\\text{d}h}{\\text{d}t} & =-1\\,\\text{cm/min}.\\end{aligned}\n$$\n\nTherefore, the height of the ice cream is decreasing at a rate of $1\\,\\text{cm/min}.$"} :step/id #uuid "125a3193-2ae0-5ff5-92df-173786bf1da3" :step/next {:db/id #edb/ref 17592186539093}} {:db/id #edb/ref 17592186539045 :step/content {:db/id #edb/ref 17592186538990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7957cff2-b385-535f-994d-5aa194c21c9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186538508}] :answer-field/correct {:db/id #edb/ref 17592186538508} :answer-field/id #uuid "77b9569b-ea54-5309-956e-f4f9379e5a45" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538865}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a403c1d3-ab4a-51b5-846b-0a043ce7d6fd" :question/math-academy-id "q-359420" :question/problem "![](images/ff/ffdfbbfcbc2a01e79fd9490f05744b2d0bf1d24dd616a0b318ee95acfa26e9ba.png)\n\nA cone-shaped pile of salt is being depleted so that the volume of the pile decreases at $5\\pi \\,{\\text{m}}^{3}/\\text{hr}.$ The height of the pile is always one-half of its base diameter. Find the rate of the pile’s height decrease when the height is $5\\,\\text{m}.$ Do not round the answer.\n\n*Hint*: Assume that the rate of decrease is positive.\n\nThe height is decreasing at a rate of\n{{field-1}} $\\text{m}/\\text{hr}.$" :question/worked-solution "Let's call $h$ the height of the pile and $r$ the radius of its base. Both of these quantities, as well as the volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-5\\pi \\,{\\text{m}}^{3}/\\text{hr},\n$$\n\nand we want to find $\\frac{\\text{d}h}{\\text{d}t}$ when $h=5\\,\\text{m}.$\n\nWe need to find a relation between $h$ and the variable for which we know the rate of change, which is $v.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nWe're told that the height is always one-half of its base diameter. So, we have \n\n$$\n\\begin{aligned}h & =\\frac{1}{2}d \\\\ h & =\\frac{1}{2}(2r) \\\\ r & =h.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\n\\begin{aligned}v & =\\frac{1}{3}\\pi {r}^{2}h \\\\  & =\\frac{1}{3}\\pi (h)^{2}h \\\\  & =\\frac{1}{3}\\pi {h}^{3}.\\end{aligned}\n$$\n\nNow that we have an equation relating $v$ and $h,$ we differentiate with respect to time using the chain rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}v & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}\\pi {h}^{3}) \\\\  & =\\pi {h}^{2}\\frac{\\text{d}h}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting the known values and solving for $\\frac{\\text{d}h}{\\text{d}t},$ we get\n\n$$\n\\begin{aligned}-5\\pi  & =\\pi (5)^{2}\\frac{\\text{d}h}{\\text{d}t} \\\\ -5\\pi  & =25\\pi \\frac{\\text{d}h}{\\text{d}t} \\\\ \\frac{\\text{d}h}{\\text{d}t} & =-\\frac{1}{5}\\,\\text{m}/\\text{hr}.\\end{aligned}\n$$\n\nTherefore, the height of the pile is decreasing at a rate of $\\frac{1}{5}\\,\\text{m}/\\text{hr}.$"} :step/id #uuid "217c1f67-06e1-5601-8b23-b9092c598e3b"} {:db/id #edb/ref 17592186539067 :step/content {:db/id #edb/ref 17592186538944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2840fb0c-b24c-5ace-8c60-e5f1d39630ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12.1\\,\\text{in}/\\text{h}" :db/id #edb/ref 17592186538315} {:answer/id #uuid "5278ff3e-cb2e-5401-af52-b131b740deb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11.1\\,\\text{in}/\\text{h}" :db/id #edb/ref 17592186538410} {:answer/id #uuid "7aa711cb-bd92-5be9-85c2-c50e7b5fcea3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13.5\\,\\text{in}/\\text{h}" :db/id #edb/ref 17592186538512} {:answer/id #uuid "9b96d177-b725-5a00-a09c-c5f9e4a3f622" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14.7\\,\\text{in}/\\text{h}" :db/id #edb/ref 17592186538600} {:answer/id #uuid "f476b44e-8168-549a-91d7-1e7d0fc87e75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15.9\\,\\text{in}/\\text{h}" :db/id #edb/ref 17592186538785}] :answer-field/correct {:db/id #edb/ref 17592186538315} :answer-field/id #uuid "269b10db-2af0-5890-bf3b-16469d2146ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538822}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "371ac971-2ba8-5a04-9b8d-bbb2a2347b46" :question/math-academy-id "q-121678" :question/problem "![](images/b1/b18b1e3a686f70a4c583324ddc253e8d334f63f017639bd47f6f483d42582801.png)\n\nAn inverted conical dispenser has a diameter of $100\\,\\text{in}$ and a depth of $110\\,\\text{in}.$ If a liquid is flowing out of the vertex of container at a rate of $9\\,000\\pi \\,{\\text{in}}^{3}\\text{/h}$, how fast is the height of the liquid dropping when the liquid is $60\\,\\text{in}$ deep?" :question/worked-solution "First, let's consider the dimensions of the container. Let's call $H=110\\,\\text{in}$ the height of the container, and $R=\\frac{100}{2}=50\\,\\text{in}$ its radius at the top. These quantities are fixed and do not change with time.\n\nNow, let's consider the water level. We call $h$ the water level's height and $r$ the radius of the cone formed by the water. Both of these quantities, and the water volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-9\\,000\\pi \\,{\\text{in}}^{3}/\\text{h},\n$$\n\nand we want to find $\\frac{\\text{d}h}{\\text{d}t}$ when $h=60\\,\\text{in}.$\n\nWe need to find a relation between $h$ and the variable for which we know the rate of change, which is $v.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nNote that the cones formed by the container and the water must be similar. Therefore, we must have\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{R}{H} \\\\ \\frac{r}{h} & =\\frac{50}{110} \\\\ r & =\\frac{5h}{11}.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\n\\begin{aligned}v & =\\frac{1}{3}\\pi {r}^{2}h \\\\  & =\\frac{1}{3}\\pi {(\\frac{5h}{11})}^{2}h \\\\  & =\\frac{25}{363}\\pi {h}^{3}.\\end{aligned}\n$$\n\nNow that we have an equation relating $v$ and $h,$ we differentiate with respect to time using the chain rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}v & =\\frac{\\text{d}}{\\text{d}t}(\\frac{25}{363}\\pi {h}^{3}) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =\\frac{25}{121}\\pi {h}^{2}\\frac{\\text{d}h}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, we plug in the known values, and we get\n\n$$\n\\begin{aligned}-9\\,000\\pi  & =\\frac{25}{121}\\pi (60)^{2}\\frac{\\text{d}h}{\\text{d}t} \\\\ -9\\,000\\pi  & =\\frac{90\\,000}{121}\\pi \\frac{\\text{d}h}{\\text{d}t} \\\\ \\frac{\\text{d}h}{\\text{d}t} & =-12.1\\,\\text{in}/\\text{h}.\\end{aligned}\n$$\n\nTherefore, the water height is decreasing at a rate of $12.1\\,\\text{in}/\\text{h}.$"} :step/id #uuid "778d15c7-7abe-5b61-895e-a2769683bde1" :step/next {:db/id #edb/ref 17592186539121}} {:db/id #edb/ref 17592186539093 :step/content {:db/id #edb/ref 17592186538987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05258157-23e2-526c-899d-ec024306a2de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{15\\pi }\\,\\text{in}/\\text{min}" :db/id #edb/ref 17592186538244} {:answer/id #uuid "08fd375d-6272-539b-937a-1c9b075b15f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{45\\pi }\\,\\text{in}/\\text{min}" :db/id #edb/ref 17592186538256} {:answer/id #uuid "1bf036d6-1a5e-5945-b9ba-cc1297978d36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{60}\\,\\text{in}/\\text{min}" :db/id #edb/ref 17592186538294} {:answer/id #uuid "9f237ac4-89bf-501b-8ab3-6322efde53b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{30}\\,\\text{in}/\\text{min}" :db/id #edb/ref 17592186538610} {:answer/id #uuid "faf91b57-eac5-5ead-9e6c-cdc5db530bc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{45}\\,\\text{in}/\\text{min}" :db/id #edb/ref 17592186538796}] :answer-field/correct {:db/id #edb/ref 17592186538256} :answer-field/id #uuid "f86e5ed2-3fa8-525a-9f5d-79abb731828e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186538919}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9d29b6dd-70c7-586b-8075-827c46bfd599" :question/math-academy-id "q-121589" :question/problem "![](images/ad/ad22dcd0793dbd4f7135598f94d3cfce514b8966bb18ea7edbe34058c208404e.png)\n\nA child is tearing the border of a paper party cone-shaped hat in such a way that the volume inside the hat decreases at $10\\,{\\text{in}}^{3}\\text{/min}.$ The height of the cone is always two times its base radius. At what rate is the radius of the hat decreasing when the radius is $15\\,\\text{in}?$" :question/worked-solution "Let's call $h$ the height of the hat and $r$ the radius of its base. Both of these quantities, as well as the volume $v,$ change with time. In particular, we know that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-10\\,{\\text{in}}^{3}/\\text{min},\n$$\n\nand we want to find $\\frac{\\text{d}r}{\\text{d}t}$ when $r=15\\,\\text{in}.$\n\nWe need to find a relation between $h$ and the variable for which we know the rate of change, which is $v.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $h$ also appears in the formula. So, we need to simplify the formula by writing $h$ in terms of $r.$\n\nWe're told that the height is always two times its base diameter. So, we have $h=2r.$\n\nTherefore, we can write the volume formula as\n\n$$\n\\begin{aligned}v & =\\frac{1}{3}\\pi {r}^{2}h \\\\  & =\\frac{1}{3}\\pi {r}^{2}(2r) \\\\  & =\\frac{2}{3}\\pi {r}^{3}.\\end{aligned}\n$$\n\nNow that we have an equation relating $v$ and $r,$ we differentiate with respect to time using the chain rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}v & =\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{3}\\pi {r}^{3}) \\\\  & =2\\pi {r}^{2}\\frac{\\text{d}r}{\\text{d}t}.\\end{aligned}\n$$\n\nFinally, substituting the known values and solving for $\\frac{\\text{d}r}{\\text{d}t},$ we get\n\n$$\n\\begin{aligned}-10 & =2\\pi (15)^{2}\\frac{\\text{d}r}{\\text{d}t} \\\\ -10 & =450\\pi \\frac{\\text{d}r}{\\text{d}t} \\\\ \\frac{\\text{d}r}{\\text{d}t} & =-\\frac{1}{45\\pi }\\,\\text{in}/\\text{min}.\\end{aligned}\n$$\n\nTherefore, the radius of the hat is decreasing at a rate of $\\frac{1}{45\\pi }\\,\\text{in}/\\text{min}.$"} :step/id #uuid "b71258e3-9bb9-52db-8c85-bf85be1fe3bb" :step/next {:db/id #edb/ref 17592186539067}} {:db/id #edb/ref 17592186539121 :step/content {:db/id #edb/ref 17592186538976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3225ce6-163f-5ab0-848d-eac7a030fd95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "90\\pi" :db/id #edb/ref 17592186538780}] :answer-field/correct {:db/id #edb/ref 17592186538780} :answer-field/id #uuid "380c73ef-343d-548e-9c09-eeac68deca83" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186538833}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "75da158e-460b-5ea3-876d-2ea3f7a43576" :question/math-academy-id "q-346635" :question/problem "![](images/47/479e2f20fea6b5e22b11fa8f8e5015ad81a57a10ed43a53d5669b0363d33b185.png)\n\nA conical grain container has a height of $450\\,\\text{cm}$ and the radius at the bottom of the container is $90\\,\\text{cm}.$ The container is being emptied so that the distance $h$ from the top of the container to the grain surface increases at a rate of $\\frac{25}{3h}\\,\\text{cm/min}.$ Find the rate at which the volume of the grain is decreasing when the grain level is $180\\,\\text{cm}.$ Do not round the answer.\n\nThe volume of grain is decreasing at a rate of\n{{field-1}} ${\\text{cm}}^{3}/\\text{min}.$" :question/worked-solution "First, let's consider the dimensions of the container. Let's call $H=450\\,\\text{cm}$ the height of the conical container, and $R=90\\,\\text{cm}$ its radius at the bottom. These quantities are fixed and do not change with time.\n\nNow, let's consider the grain level. We call $h$ the distance from the top of the container to the surface of the grain, $r$ the radius of the cone at the grain surface, and $v$ the volume of the empty space in the container. All of these quantities change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}h}{\\text{d}t}=\\frac{25}{3h}\\,\\text{cm}/\\text{min},\n$$\n\nwhich is positive because the distance from the top of the container to the grain surface increases as the level of the grain in the container decreases. \n\nWe want to know $\\frac{\\text{d}v}{\\text{d}t}$ when the level of the grain is $180\\,\\text{cm}.$ At this moment, we have\n\n$$\n\\begin{aligned}h & =H-180 \\\\  & =450-180 \\\\  & =270\\,\\text{cm}.\\end{aligned}\n$$\n\nWe need to find a relation between $v$ and the variable for which we know the rate of change, which is $h.$ This is given by the formula for the volume of a cone:\n\n$$\nv=\\frac{1}{3}\\pi {r}^{2}h\n$$\n\nBefore we differentiate the equation with respect to time, note that $r$ also appears in the formula. So, we need to simplify the formula by writing $r$ in terms of $h.$\n\nNote that the cones formed by the container and the empty space located between the container's top and the grain surface must be similar. Therefore, we have\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{R}{H} \\\\ \\frac{r}{h} & =\\frac{90}{450} \\\\ r & =\\frac{h}{5}.\\end{aligned}\n$$\n\nTherefore, we can write the volume formula as\n\n$$\n\\begin{aligned}v & =\\frac{1}{3}\\pi {(\\frac{h}{5})}^{2}h \\\\ v & =\\frac{1}{75}\\pi {h}^{3}.\\end{aligned}\n$$\n\nNow that we have an equation relating $v$ and $h,$ we differentiate with respect to time using the chain rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}v & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{75}\\pi {h}^{3}) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =\\frac{1}{25}\\pi {h}^{2}\\frac{\\text{d}h}{\\text{d}t} \\\\ \\frac{\\text{d}v}{\\text{d}t} & =\\frac{1}{25}\\pi {h}^{2}(\\frac{25}{3h}) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =\\frac{1}{3}\\pi h\\end{aligned}\n$$\n\nFinally, substituting the known values, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}t} & =\\frac{1}{3}\\pi (270) \\\\ \\frac{\\text{d}v}{\\text{d}t} & =90\\pi \\,{\\text{cm}}^{3}/\\text{min}.\\end{aligned}\n$$\n\nTherefore, the volume of grain is decreasing at a rate of $90\\pi \\,{\\text{cm}}^{3}/\\text{min}.$"} :step/id #uuid "fbb1492c-6373-5bb6-9549-06c0c86b5e1b" :step/next {:db/id #edb/ref 17592186539045}}] :activity/title "Calculating Related Rates With Cones" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186538224}]}
