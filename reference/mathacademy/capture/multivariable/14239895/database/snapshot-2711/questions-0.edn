#{[{:db/id #edb/ref 17592186558539 :knowledge-point/_questions [{:db/id #edb/ref 17592186499434 :knowledge-point/id #uuid "01f99115-f376-50c2-9b7e-79800006d437" :knowledge-point/title "Finding a Value Given a Ratio by Rounding an Amount"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3753fd0b-c081-5341-ae6b-6434522711ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$900$" :db/id #edb/ref 17592186557978} {:answer/id #uuid "45d235ac-7712-5ca4-877d-63407f23d444" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$600$" :db/id #edb/ref 17592186558006} {:answer/id #uuid "5b98ffd4-63ed-5add-bf98-ecf5d6492c8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$760$" :db/id #edb/ref 17592186558042} {:answer/id #uuid "807be663-7835-5fd3-82ec-350b159ded0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$700$" :db/id #edb/ref 17592186558117} {:answer/id #uuid "881d6191-65af-5d92-988e-e00ce240a7fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$840$" :db/id #edb/ref 17592186558133}] :answer-field/correct {:answer/id #uuid "45d235ac-7712-5ca4-877d-63407f23d444" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$600$" :db/id #edb/ref 17592186558006} :answer-field/id #uuid "0db908f9-7a3a-5a7e-a3ec-6a328a11d897" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558367}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "92ab7ff7-d02e-5687-bfb0-2e6e2beec2cb" :question/math-academy-id "q-364163" :question/problem "Maya and Leon get paid for painting houses. The ratio of Maya's reward to Leon's reward is $3:4.$ \nDuring a particular week, Leon received $$806.$ By rounding Leon's earnings to the nearest hundred, approximate the amount of money that Maya received." :question/worked-solution "First, let's approximate the amount of money that Leon received:\n\n$$\n$806⟶$800\n$$\n\nThe ratio of Maya's earnings to Leon's earnings is\n\n$$\n\\frac{3}{4}.\n$$\n\n  \n\nThe numerator represents Maya's earnings  and the denominator represents Leon's earnings.\n\nWe can make a denominator of $800$ by multiplying the numerator and denominator by \n $200$:\n\n$$\n\\frac{3\\times 200}{4\\times 200}=\\frac{600}{800}.\n$$\n\nTherefore, Maya received approximately $$600.$"}] [{:db/id #edb/ref 17592186558561 :knowledge-point/_questions [{:db/id #edb/ref 17592186499440 :knowledge-point/id #uuid "a02676df-7c77-5303-9d8e-7c83fdfd2060" :knowledge-point/title "Finding a Value by Approximating Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022a4a93-f3c4-5aee-abd1-90bc3255912b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$16$ tablets" :db/id #edb/ref 17592186557873} {:answer/id #uuid "3d704850-2838-563c-aef8-e418a2b3c148" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$20$ tablets" :db/id #edb/ref 17592186557993} {:answer/id #uuid "8e38cfb0-b6b5-576f-8f18-ac6fe927d170" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$25$ tablets" :db/id #edb/ref 17592186558144} {:answer/id #uuid "c3f809e8-955b-5304-81e5-e3dc3285884c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$30$ tablets" :db/id #edb/ref 17592186558259} {:answer/id #uuid "e1a0f6ae-38cb-5459-b690-6d6809dc0a7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$15$ tablets" :db/id #edb/ref 17592186558316}] :answer-field/correct {:answer/id #uuid "3d704850-2838-563c-aef8-e418a2b3c148" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$20$ tablets" :db/id #edb/ref 17592186557993} :answer-field/id #uuid "5db6ae51-1959-57ad-8dff-d3275311dd80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558403}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4649cc4-2caa-54b1-a9d4-13acf6f413f0" :question/math-academy-id "q-364172" :question/problem "The number of laptops and tablets in store A is shown in the following table:\n\n| Laptops | Tablets |\n| --- | --- |\n| $72$ | $38$ |\n\nIn store B there are approximately $35$ laptops. The ratio of the number of laptops to the number of tablets in both stores is the same. By rounding the given data to the nearest ten, approximate the number of tablets in store B." :question/worked-solution "First, let's round the number of laptops and tablets in store A:\n\n- Laptops: $72⟶70$\n\n- Tablets: $38⟶40$\n\nTherefore, the ratio of the number of laptops to the number of tablets (expressed as a fraction) is approximately:\n\n$$\n\\frac{70}{40}\n$$\n\nSo the numerator represents the number of laptops and the denominator represents the number of tablets.\n\nDividing the numerator and denominator by $10$ gives an equivalent fraction:\n\n$$\n\\frac{70÷10}{40÷10}=\\frac{7}{4}\n$$\n\nWe can make a numerator of $35$ by multiplying the numerator and denominator by $5$:\n\n$$\n\\frac{7\\times 5}{4\\times 5}=\\frac{35}{20}\n$$\n\nTherefore, there are approximately $20$ tablets in store B."}] [{:db/id #edb/ref 17592186558515 :knowledge-point/_questions [{:db/id #edb/ref 17592186499441 :knowledge-point/id #uuid "c71ff81f-388d-53c8-853e-c60430327148" :knowledge-point/title "Approximating Ratios by Rounding to the Nearest Hundred"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d823593-d438-5d97-8b01-142529984e0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186558047} {:answer/id #uuid "9a744675-7473-5107-89cd-7f5bda0b2c17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{15}" :db/id #edb/ref 17592186558166} {:answer/id #uuid "b1a1d657-a365-52a6-93bd-7432c4dc6cff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186558219} {:answer/id #uuid "c8118063-eee9-5ee4-95c2-103ff9c67e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186558266} {:answer/id #uuid "dda00e49-ce3c-5659-ba54-882d075f24ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186558307}] :answer-field/correct {:answer/id #uuid "b1a1d657-a365-52a6-93bd-7432c4dc6cff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186558219} :answer-field/id #uuid "2ddd74be-973a-5825-bb01-179a7478c7d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558378}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4f394066-5fc4-5966-8c8c-7e49bac1b23a" :question/math-academy-id "q-93064" :question/problem "The following table shows the width and length,  in meters, of a rectangular agriculture field.\n\n| Width | Length |\n| --- | --- |\n| $667$ | $1\\,432$ |\n\nRounding to the nearest hundred, determine the approximate ratio of width to length for this field." :question/worked-solution "First, let's approximate the width and length by rounding to the nearest $100$:\n\n- width: $667⟶700$\n\n- length: $1\\,432⟶1\\,400$\n\nTherefore, the ratio of width to length is approximately:\n\n$$\n\\frac{700}{1\\,400}\n$$\n\nWe can simplify this ratio by dividing both numbers by $100$:\n\n$$\n\\frac{700÷100}{1\\,400÷100}=\\frac{7}{14}\n$$\n\nThen, we divide by $7$:\n\n$$\n\\frac{7÷7}{14÷7}=\\frac{1}{2}\n$$\n\nTherefore, the ratio of width to length is approximately $\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186558491 :knowledge-point/_questions [{:db/id #edb/ref 17592186499440 :knowledge-point/id #uuid "a02676df-7c77-5303-9d8e-7c83fdfd2060" :knowledge-point/title "Finding a Value by Approximating Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06919843-5a8b-5259-9299-09b587346303" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$300$ kilograms" :db/id #edb/ref 17592186557884} {:answer/id #uuid "1007f262-7909-5942-b76a-6cedb12bc50f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$250$ kilograms" :db/id #edb/ref 17592186557900} {:answer/id #uuid "568cf1d0-2c6f-5140-b128-a52b31b4c1fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$200$ kilograms" :db/id #edb/ref 17592186558029} {:answer/id #uuid "6bd745a4-5e02-5a78-9cf9-9af54448a980" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$400$ kilograms" :db/id #edb/ref 17592186558076} {:answer/id #uuid "dd8242bf-e0b6-5d87-afa2-323f38a9d5ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$350$ kilograms" :db/id #edb/ref 17592186558305}] :answer-field/correct {:answer/id #uuid "568cf1d0-2c6f-5140-b128-a52b31b4c1fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$200$ kilograms" :db/id #edb/ref 17592186558029} :answer-field/id #uuid "f5b374f4-e768-52a0-9c29-d75461c01b9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558472}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "132a5e4f-2931-5c22-94d5-e6d628c0a5d8" :question/math-academy-id "q-93081" :question/problem "The weight of ore and the weight of copper obtained from it, in kilograms, is shown in the following table:\n\n| Ore | Copper |\n| --- | --- |\n| $423$ | $68$ |\n\nThe ratio of the weight of ore to the weight of copper is always the same.  By rounding the given data to the nearest ten, approximate the weight of copper that can be obtained from $1\\,200$ kilograms of ore." :question/worked-solution "First, let's round the weights of ore and copper:\n\n- Ore: $423⟶420$\n\n- Copper: $68⟶70$\n\nTherefore, the ratio of ore to copper (expressed as a fraction) is approximately\n\n$$\n\\frac{420}{70}\n$$\n\nSo the numerator represents the weight of ore, and the denominator represents the weight of copper.\n\nWe can simplify this ratio by dividing both numbers by $10$:\n\n$$\n\\frac{420÷10}{70÷10}=\\frac{42}{7}\n$$\n\nThen, we divide by $7$:\n\n$$\n\\frac{42÷7}{7÷7}=\\frac{6}{1}\n$$\n\nWe can make a numerator of $1\\,200$ by multiplying the numerator and denominator by $200$:\n\n$$\n\\frac{6\\times 200}{1\\times 200}=\\frac{1\\,200}{200}\n$$\n\nTherefore, $200$ kilograms of copper can be obtained from $1\\,200$ kilograms of ore."}] [{:db/id #edb/ref 17592186558540 :knowledge-point/_questions [{:db/id #edb/ref 17592186499434 :knowledge-point/id #uuid "01f99115-f376-50c2-9b7e-79800006d437" :knowledge-point/title "Finding a Value Given a Ratio by Rounding an Amount"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3615741b-46a4-5227-b3d1-750afe938f70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$350$ grams" :db/id #edb/ref 17592186557977} {:answer/id #uuid "60e762ea-1c99-5415-9c61-1cb6553b4b84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$400$ grams" :db/id #edb/ref 17592186558052} {:answer/id #uuid "61007c72-a194-5bd7-9737-2ab6110d4866" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$450$ grams" :db/id #edb/ref 17592186558053} {:answer/id #uuid "642d5471-d8d0-5f30-b841-f9ddb78ad020" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$300$ grams" :db/id #edb/ref 17592186558060} {:answer/id #uuid "9bb2834b-2c4a-5de7-a43c-ec0d2aebeaa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$250$ grams" :db/id #edb/ref 17592186558170}] :answer-field/correct {:answer/id #uuid "642d5471-d8d0-5f30-b841-f9ddb78ad020" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$300$ grams" :db/id #edb/ref 17592186558060} :answer-field/id #uuid "6c802e76-90be-5a83-ad3b-13ee92d8dca1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186558409}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9587827d-60b3-5a55-a4d3-895d1d528b37" :question/math-academy-id "q-93115" :question/problem "Grant and Stephanie ate a whole cake together. The ratio of the amount of cake eaten by Grant to the amount of cake eaten by Stephanie is $7:3.$ Grant ate $745$ grams of cake. By rounding this weight to the nearest hundred, approximate the weight of Stephanie's portion." :question/worked-solution "First, let's approximate the weight of the cake Grant ate to the nearest hundred:\n\n$$\n745⟶700\n$$\n\nThe ratio of the weight of Grant's portion to the weight of Stephanie's portion is \n\n$$\n\\frac{7}{3}.\n$$\n\n  \n\nThe numerator represents the weight of Grant's  part and the denominator represents  the weight of Stephanies part.\n\nWe can make a numerator of $700$ by multiplying the numerator and denominator by \n $100:$\n\n$$\n\\frac{7\\times 100}{3\\times 100}=\\frac{700}{300}\n$$\n\nTherefore, Stephanie ate approximately $300$ grams of cake."}]}
