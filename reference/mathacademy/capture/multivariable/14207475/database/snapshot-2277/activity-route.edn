#{[{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186520608} :activity/id #uuid "63195741-23b2-5a66-a987-8d1b10be7716" :activity/scope {:db/id #edb/ref 17592186051084 :topic/id #uuid "7fcc3a06-676a-55a2-9979-d3726053babe" :topic/math-academy-id 1108} :activity/steps [{:db/id #edb/ref 17592186520538 :step/content {:db/id #edb/ref 17592186520484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e10ad36-36ec-5632-8f07-eff850b3becf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x^{3}-9x^{2}" :db/id #edb/ref 17592186520153}] :answer-field/correct {:db/id #edb/ref 17592186520153} :answer-field/id #uuid "8b7fd03c-605a-5e8e-8867-8d3e258ab8cf" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186520410}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "930f9486-b8c5-5ccf-b917-a4806acde6bf" :question/math-academy-id "q-314207" :question/problem "Given that $f(x)={({x}^{4}-3{x}^{3})}^{2},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=2({x}^{4}-3{x}^{3})($\n{{field-1}}\n$)$" :question/worked-solution "Let $g(x)={x}^{4}-3{x}^{3}$ and $f(g(x))=g(x)^{2}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{2})^{′}=2g, \\\\ {g}^{′}(x) & =({x}^{4}-3{x}^{3})^{′}=4{x}^{3}-9{x}^{2}.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =2g\\cdot (4{x}^{3}-9{x}^{2}) \\\\  & =2({x}^{4}-3{x}^{3})(\\,4{x}^{3}-9{x}^{2}\\,).\\end{aligned}\n$$"} :step/id #uuid "35b3efb8-a2d4-59c0-b538-ee4b244189e0"} {:db/id #edb/ref 17592186520543 :step/content {:db/id #edb/ref 17592186520473 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bf96aed-c4c2-50a0-9312-269557ced95f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8(1-3x)^{7}" :db/id #edb/ref 17592186520029} {:answer/id #uuid "4793072d-d61e-5f93-bb0c-993627ee72c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24(1+3x)^{7}" :db/id #edb/ref 17592186520100} {:answer/id #uuid "99709777-eb56-5d41-ac58-1c43410ac856" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24(1-3x)^{7}" :db/id #edb/ref 17592186520209} {:answer/id #uuid "d2298536-2087-59b8-a435-384b956031dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24(1+3x)^{7}" :db/id #edb/ref 17592186520286} {:answer/id #uuid "e7514498-fddf-54d8-9478-ff10ceb72766" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3(1-3x)^{7}" :db/id #edb/ref 17592186520330}] :answer-field/correct {:db/id #edb/ref 17592186520209} :answer-field/id #uuid "44da7608-9cb4-57b2-9694-53ee352f7833" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186520387}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "73597027-954f-5bff-8c64-de058a3fe822" :question/math-academy-id "q-107296" :question/problem "Given that $f(x)={(1-3x)}^{8},$ find ${f}^{′}(x).$" :question/worked-solution "Let $g(x)=1-3x$ and $f(g(x))=g(x)^{8}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{8})^{′}=8{g}^{7}, \\\\ {g}^{′}(x) & =(1-3x)^{′}=-3.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =8{g}^{7}\\cdot (-3) \\\\  & =-24(1-3x)^{7}.\\end{aligned}\n$$"} :step/id #uuid "4350c72e-f9bd-5210-90fd-d37e9cc293c0" :step/next {:db/id #edb/ref 17592186520579}} {:db/id #edb/ref 17592186520551 :step/content {:db/id #edb/ref 17592186520516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33c7c493-bcdb-5703-aa16-7951eec23ed2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186520068}] :answer-field/correct {:db/id #edb/ref 17592186520068} :answer-field/id #uuid "3b694189-fec1-5a06-8456-a524e215acf6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186520382}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fa666076-05a3-50c7-be3d-b7a39d6d4f55" :question/math-academy-id "q-314192" :question/problem "The slope of the tangent to the curve $y=\\sqrt{4x+1}$ at the point where $x=0$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=4x+1.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot 4 \\\\  & =\\frac{4}{2\\sqrt{4x+1}}.\\end{aligned}\n$$\n\nFinally, substituting $x=0,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & ={(\\frac{4}{2\\sqrt{4x+1}})|}_{x=0} \\\\  & =\\frac{4}{2\\sqrt{4(0)+1}} \\\\  & =2.\\end{aligned}\n$$"} :step/id #uuid "51f59503-df73-54cc-af64-3dcb163fe7d6" :step/next {:db/id #edb/ref 17592186520538}} {:db/id #edb/ref 17592186520579 :step/content {:db/id #edb/ref 17592186520487 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "454a250f-2e0e-5eff-ad08-2e1a4569c3b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2x-1}}" :db/id #edb/ref 17592186520091} {:answer/id #uuid "4cf36f6a-ac30-5d76-9499-88f79530ef58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\sqrt{2x-1}}" :db/id #edb/ref 17592186520108} {:answer/id #uuid "a63c2527-a87a-5317-bb52-435b49980a68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{\\sqrt{2x-1}}" :db/id #edb/ref 17592186520218} {:answer/id #uuid "ceae46e6-5020-51b1-a35e-422b64ddda99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4\\sqrt{2x-1}}" :db/id #edb/ref 17592186520281} {:answer/id #uuid "edcc6c31-a212-5340-8bdb-e1b0f8c22746" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4\\sqrt{2x-1}}" :db/id #edb/ref 17592186520341}] :answer-field/correct {:db/id #edb/ref 17592186520091} :answer-field/id #uuid "7e463a5a-0bf7-5c15-8a84-e8fb513aab4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186520404}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "98cde390-f268-5ffd-9f2f-31f016a0c432" :question/math-academy-id "q-107303" :question/problem "Given that $y=\\sqrt{2x-1},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=2x-1.$ Then $y=\\sqrt{u}={u}^{1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2}{u}^{-1/2}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot 2 \\\\  & =\\frac{1}{\\sqrt{u}} \\\\  & =\\frac{1}{\\sqrt{2x-1}}.\\end{aligned}\n$$"} :step/id #uuid "828caf19-ec46-5c3a-829e-707d043329c0" :step/next {:db/id #edb/ref 17592186520551}} {:db/id #edb/ref 17592186520608 :step/content {:db/id #edb/ref 17592186520457 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bd0f410-6e9b-5a13-84b6-2793313eb013" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}-3}{\\sqrt{({x}^{3}-2x)^{3}}}" :db/id #edb/ref 17592186520005} {:answer/id #uuid "0e0c3af3-091e-560d-ac8e-abe55cc9d0f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3{x}^{2}-2}{\\sqrt{({x}^{3}-2x)^{3}}}" :db/id #edb/ref 17592186520009} {:answer/id #uuid "75d7df1e-163d-51cf-9003-0d07b95639d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3{x}^{2}-2}{\\sqrt{{x}^{3}-2x}}" :db/id #edb/ref 17592186520161} {:answer/id #uuid "86d89cd3-8e55-5f29-83ed-c409f606d553" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2{x}^{2}-3}{\\sqrt{{x}^{3}-2x}}" :db/id #edb/ref 17592186520189} {:answer/id #uuid "996b8fd1-b20a-565b-98d1-c22e6ee7d68a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{x}^{2}+3}{\\sqrt{({x}^{3}-2x)^{3}}}" :db/id #edb/ref 17592186520208}] :answer-field/correct {:db/id #edb/ref 17592186520009} :answer-field/id #uuid "686cff4f-8265-5ba3-8560-bcdf5671d8d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186520397}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "321f22b7-0ca5-594c-82a7-c5cf5cf23fad" :question/math-academy-id "q-71952" :question/problem "Find ${f}^{′}(x)$ for $f(x)=\\frac{2}{\\sqrt{{x}^{3}-2x}}.$" :question/worked-solution "Let $g(x)={x}^{3}-2x$ and $f(g(x))=\\frac{2}{\\sqrt{g}}=2{g}^{-1/2}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =2({g}^{-1/2})^{′}=-2\\cdot \\frac{1}{2}{g}^{-3/2}=-\\frac{1}{{g}^{3/2}}, \\\\ {g}^{′}(x) & =({x}^{3}-2x)^{′}=3{x}^{2}-2.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =-\\frac{1}{{g}^{3/2}}\\cdot (3{x}^{2}-2) \\\\  & =-\\frac{3{x}^{2}-2}{{g}^{3/2}} \\\\  & =-\\frac{3{x}^{2}-2}{\\sqrt{({x}^{3}-2x)^{3}}}.\\end{aligned}\n$$"} :step/id #uuid "dcb12c9b-27b2-535b-bf95-11fa19d50067" :step/next {:db/id #edb/ref 17592186520543}}] :activity/title "The Chain Rule for Differentiation" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186519990}]}
