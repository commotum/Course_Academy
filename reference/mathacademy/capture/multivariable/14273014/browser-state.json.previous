    "q-183558": {
      "dom_id": "step-q183558",
      "name": "Question 3",
      "problem": "The square root of $1\\,024$ is a natural number.\n\nExpress the statement above in formal language.",
      "worked_solution": "Recall that \"The square root of $1\\,024$ is a natural number\" means the following:\n\nThere exists a natural number $n$ such that $\\sqrt{1\\,024}=n.$\n\nMore formally, this reads as follows:\n\n$∃\\,n\\in N,\\,\\sqrt{1\\,024}=n$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-183558-a",
