#{[{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186575649} :activity/id #uuid "9a0c4459-7e42-515e-ba77-ca28d96e8d50" :activity/scope {:db/id #edb/ref 17592186050912 :topic/id #uuid "70abc32f-7c95-5eaa-bc37-2779f513c439" :topic/math-academy-id 1174} :activity/steps [{:db/id #edb/ref 17592186575639 :step/content {:db/id #edb/ref 17592186575574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccf8156a-5145-53a0-acb6-e6e427f7cdcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186575312}] :answer-field/correct {:db/id #edb/ref 17592186575312} :answer-field/id #uuid "3de1ab9d-bf97-57ce-8fb8-7959134261a6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186575445}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8f270d15-6fe5-55df-829e-27dd74957fdc" :question/math-academy-id "q-352774" :question/problem "Given that\n\n$$\nS={\\sum }_{n=3}^{\\infty }\\frac{{2(-1)}^{n}}{\\operatorname{ln}⁡(2n+1)}\n$$\n\nand that ${s}_{i}$ is the $i$th partial sum of $S,$ use the alternating series error bound to determine an inequality that gives the values of $i$ such that $|S-{s}_{i}|<0.2.$\n\n$\\operatorname{ln}⁡(2i+3)\\ge$\n{{field-1}}" :question/worked-solution "First, let ${a}_{n}=\\frac{2}{\\operatorname{ln}⁡(2n+1)}$ and ${b}_{n}=\\frac{{(-1)}^{n}\\,2}{\\operatorname{ln}⁡(2n+1)}.$ Then ${a}_{n}$ is decreasing for $n\\ge 3$ and ${a}_{n}\\to 0$ as $n\\to \\infty .$ So, the series is convergent by the alternating series test. \n\nBecause our series is a convergent alternating series, the alternating series error bound applies. In particular, for the $i$th partial sum, it states that\n\n$$\n|S-{s}_{i}|<|{b}_{i+1}|.\n$$\n\nSo, we require\n\n$$\n\\begin{aligned}|{b}_{i+1}|=|\\frac{(-1)^{i+1}\\,2}{\\operatorname{ln}⁡(2(i+1)+1)}| & \\le 0.2 \\\\ \\frac{2}{\\operatorname{ln}⁡(2i+3)} & \\le 0.2 \\\\ \\frac{2}{\\operatorname{ln}⁡(2i+3)} & \\le \\frac{1}{5} \\\\ 10 & \\le \\operatorname{ln}⁡(2i+3) \\\\ \\operatorname{ln}⁡(2i+3) & \\ge 10.\\end{aligned}\n$$"} :step/id #uuid "212a1ba6-0439-5eb5-9fa6-0549590c783c"} {:db/id #edb/ref 17592186575649 :step/content {:db/id #edb/ref 17592186575557 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19048534-c446-541b-92e4-f87a572f0445" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{25}" :db/id #edb/ref 17592186574990} {:answer/id #uuid "2986023f-c3b0-5d34-89e7-d5b18cc1b181" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{25}" :db/id #edb/ref 17592186575013} {:answer/id #uuid "660039ee-808b-5909-a6a4-855d47eca687" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{49}" :db/id #edb/ref 17592186575132} {:answer/id #uuid "c054db7d-8b25-59ff-85a1-fc53976cbd21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{49}" :db/id #edb/ref 17592186575292} {:answer/id #uuid "f26e9ff2-3fea-5e99-8496-28dd0c86a06d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{49}" :db/id #edb/ref 17592186575376}] :answer-field/correct {:db/id #edb/ref 17592186575376} :answer-field/id #uuid "1a59751e-949f-5d36-80c1-fa6f0759ee0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186575420}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6c4bc11a-cdaa-550d-94a0-3ff2e50cf498" :question/math-academy-id "q-15103" :question/problem "Suppose that\n\n$$\nS={\\sum }_{n=1}^{\\infty }\\frac{{(-1)}^{n}}{{n}^{2}}\n$$\n\nand that ${s}_{6}$ is the sixth partial sum of $S.$ According to the alternating series error bound, $|S-{s}_{6}|<k$ for some real number $k.$ Find the value of $k.$" :question/worked-solution "Let ${a}_{n}=\\frac{1}{{n}^{2}}$ and ${b}_{n}=\\frac{{(-1)}^{n}}{{n}^{2}}.$ Then ${a}_{n}$ is positive and decreasing for $n\\ge 1,$ and ${a}_{n}\\to 0$ as $n\\to \\infty .$ So, the series is convergent by the alternating series test.\n\nBecause our series is a convergent alternating series, the alternating series error bound applies. In particular, for the $6$th partial sum, it states that\n\n$$\n|S-{s}_{6}|<|{b}_{7}|=|\\frac{(-1)^{7}}{{7}^{2}}|=\\frac{1}{49}.\n$$\n\n \n\nTherefore, $k=\\frac{1}{49}.$"} :step/id #uuid "50136f0e-287a-5a86-9add-5cd78eb80231" :step/next {:db/id #edb/ref 17592186575684}} {:db/id #edb/ref 17592186575652 :step/content {:db/id #edb/ref 17592186575591 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fbc8956-7af9-5d82-88ed-b5cd5cfd7c9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "60" :db/id #edb/ref 17592186575152}] :answer-field/correct {:db/id #edb/ref 17592186575152} :answer-field/id #uuid "fdd473d7-ac4e-56be-8ce8-60ffb0f1e888" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186575522}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b6f1577d-5608-56ec-bbab-86d743866f2e" :question/math-academy-id "q-352762" :question/problem "Given that\n\n$$\nS={\\sum }_{n=2}^{\\infty }\\frac{3(-1)^{n+1}}{n({n}^{2}+4)}\n$$\n\nand that ${s}_{i}$ is the $i$th partial sum of $S,$ use the alternating series error bound to determine an inequality that gives the values of $i$ such that\n$|S-{s}_{i}|<0.05.$\n\n${i}^{3}+3{i}^{2}+7i+5\\ge$\n{{field-1}}" :question/worked-solution "First, let\n\n$$\n{a}_{n}=\\frac{3}{n({n}^{2}+4)}\\,\\text{and}\\,{b}_{n}=\\frac{3(-1)^{n+1}}{n({n}^{2}+4)}.\n$$\n\nThen ${a}_{n}$ is decreasing for $n\\ge 2$ and ${a}_{n}\\to 0$ as $n\\to \\infty .$ Therefore, the series is convergent by the alternating series test.\n\nBecause the series is a convergent alternating series, the alternating series error bound applies. In particular, for the $i$th partial sum, it states that\n\n$$\n|S-{s}_{i}|<|{b}_{i+1}|.\n$$\n\nThus, we require\n\n$$\n\\begin{aligned}|{b}_{i+1}|=|\\frac{3(-1)^{i+2}}{(i+1)((i+1)^{2}+4)}| & \\le 0.05 \\\\ \\frac{3}{(i+1)((i+1)^{2}+4)} & \\le \\frac{1}{20} \\\\ 60 & \\le (i+1)((i+1)^{2}+4) \\\\ 60 & \\le (i+1)({i}^{2}+2i+1+4) \\\\ 60 & \\le (i+1)({i}^{2}+2i+5) \\\\ 60 & \\le {i}^{3}+3{i}^{2}+7i+5 \\\\ {i}^{3}+3{i}^{2}+7i+5 & \\ge 60.\\end{aligned}\n$$"} :step/id #uuid "53829707-e1e6-5a85-8f73-c25dca5844f9" :step/next {:db/id #edb/ref 17592186575667}} {:db/id #edb/ref 17592186575667 :step/content {:db/id #edb/ref 17592186575625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b170842b-5b2d-5078-a5a6-acb218dd45e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9998" :db/id #edb/ref 17592186575266}] :answer-field/correct {:db/id #edb/ref 17592186575266} :answer-field/id #uuid "3bf1afec-fd1f-50cb-988c-1d344a155a6e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186575444}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fd9b72de-d1e8-5e4c-b443-057fdab0329d" :question/math-academy-id "q-352763" :question/problem "Given that\n\n$$\nS={\\sum }_{n=1}^{\\infty }\\frac{{(-1)}^{n+1}}{\\sqrt{n+1}}\n$$\n\nand that ${s}_{i}$ is the $i$th partial sum of $S,$ use the alternating series error bound to determine the values of $i$ such that $|S-{s}_{i}|<0.01.$\n\n$i\\ge$\n{{field-1}}" :question/worked-solution "First, let ${a}_{n}=\\frac{1}{\\sqrt{n+1}}$ and ${b}_{n}=\\frac{(-1)^{n+1}}{\\sqrt{n+1}}.$ Then ${a}_{n}$ is decreasing for $n\\ge 1$ and ${a}_{n}\\to 0$ as $n\\to \\infty .$ So, the series is convergent by the alternating series test. \n\nBecause our series is a convergent alternating series, the alternating series error bound applies. In particular, for the $i$th partial sum, it states that\n\n$$\n|S-{s}_{i}|<|{b}_{i+1}|.\n$$\n\nSo, we require\n\n$$\n\\begin{aligned}|\\frac{(-1)^{i+2}}{\\sqrt{(i+1)+1}}| & \\le 0.01 \\\\ \\frac{1}{\\sqrt{i+2}} & \\le \\frac{1}{100} \\\\ \\sqrt[2]{i+2} & \\ge 100 \\\\ (i+2)^{1/2} & \\ge 100 \\\\ i+2 & \\ge (100)^{2} \\\\ i+2 & \\ge 10000 \\\\ i & \\ge 9998.\\end{aligned}\n$$"} :step/id #uuid "882b7db4-09fc-5e93-b1f6-eb88c65a7948" :step/next {:db/id #edb/ref 17592186575639}} {:db/id #edb/ref 17592186575684 :step/content {:db/id #edb/ref 17592186575573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc145cd2-9498-5331-8842-8de1cc06800b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{7920}" :db/id #edb/ref 17592186575310}] :answer-field/correct {:db/id #edb/ref 17592186575310} :answer-field/id #uuid "159b45da-df98-533e-a437-a9180419cd3d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186575414}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8f164f90-e76a-54c1-a336-782b45d61bdf" :question/math-academy-id "q-352756" :question/problem "Suppose that\n\n$$\nS={\\sum }_{n=1}^{\\infty }\\frac{{(-1)}^{n}\\,n!}{(n+4)!}\n$$\n\nand that ${s}_{6}$ is the sixth partial sum of $S.$ According to the alternating series error bound, $|S-{s}_{6}|<k$ for some real number $k.$ Find the value of $k.$ Do not round the answer.\n\n$k=$\n\n{{field-1}}" :question/worked-solution "Let ${a}_{n}=\\frac{n!}{(n+4)!}$ and ${b}_{n}=\\frac{{(-1)}^{n}\\,n!}{(n+4)!}.$ Then ${a}_{n}$ is positive and decreasing for $n\\ge 1,$ and ${a}_{n}\\to 0$ as $n\\to \\infty .$ So, the series is convergent by the alternating series test.\n\nBecause our series is a convergent alternating series, the alternating series error bound applies. In particular, for the $6$th partial sum, it states that\n\n$$\n|S-{s}_{6}|<|{b}_{7}|=|\\frac{{(-1)}^{7}\\,7!}{(7+4)!}|=\\frac{7!}{11!}=\\frac{1}{8\\cdot 9\\cdot 10\\cdot 11}=\\frac{1}{7920}.\n$$\n\nTherefore, $k=\\frac{1}{7920}.$"} :step/id #uuid "d8a5ca47-6ee4-5751-a8ec-ed05ca31f3fd" :step/next {:db/id #edb/ref 17592186575652}}] :activity/title "The Alternating Series Error Bound" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186574944}]}
