b/ref 17592186045417] [17592186522630 #edb/ref 1075 #edb/ref 17592186522351 #edb/ref 17592186045417] [17592186522630 #edb/ref 1075 #edb/ref 17592186522382 #edb/ref 17592186045417] [17592186522630 #edb/ref 1075 #edb/ref 17592186522508 #edb/ref 17592186045417] [17592186522630 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186522630 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186522630 #edb/ref 1078 #edb/ref 17592186522382 #edb/ref 17592186045417] [17592186522630 #edb/ref 1079 #uuid "8cec229b-c780-5301-8ffe-447f6b02d795" #edb/ref 17592186045417] [17592186522678 #edb/ref 1075 #edb/ref 17592186522084 #edb/ref 17592186045417] [17592186522678 #edb/ref 1075 #edb/ref 17592186522162 #edb/ref 17592186045417] [17592186522678 #edb/ref 1075 #edb/ref 17592186522197 #edb/ref 17592186045417] [17592186522678 #edb/ref 1075 #edb/ref 17592186522339 #edb/ref 17592186045417] [17592186522678 #edb/ref 1075 #edb/ref 17592186522375 #edb/ref 17592186045417] [17592186522678 #edb/ref 1075 #edb/ref 17592186522554 #edb/ref 17592186045417] [17592186522678 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186522678 #edb/ref 1077 "field-2" #edb/ref 17592186045417] [17592186522678 #edb/ref 1078 #edb/ref 17592186522162 #edb/ref 17592186045417] [17592186522678 #edb/ref 1079 #uuid "f2b1e7ca-994b-5508-b638-3a8f99c45170" #edb/ref 17592186045417] [17592186522787 #edb/ref 1068 #edb/ref 17592186522578 #edb/ref 17592186045417] [17592186522787 #edb/ref 1068 #edb/ref 17592186522630 #edb/ref 17592186045417] [17592186522787 #edb/ref 1069 "q-338898" #edb/ref 17592186045417] [17592186522787 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186522787 #edb/ref 1071 "Consider the boundary value problem\n\n$$\n{y}^{″}-12\\lambda {y}^{′}+36{\\lambda }^{2}y=0,\\,{y}^{′}(1)=0,\\,y(2)+6{y}^{′}(2)=0,\\,1\\le x\\le 2,\\,\\lambda \\in R.\n$$\n\nFind the eigenvalues and eigenfunctions of this problem. Assume that $B$ and $C$ are constants.\n\n$\\,$ The eigenvalues are $\\lambda =$ {{field-1}}.\n\n$\\,$ The eigenfunctions are $y=$ {{field-2}}." #edb/ref 17592186045417] [17592186522787 #edb/ref 1072 #uuid "d3e4d429-39a4-5565-a491-a0dbab9cb6bc" #edb/ref 17592186045417] [17592186522787 #edb/ref 1074 "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions.\n\n**Case 1**: First, we consider $\\lambda =0.$\n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions ${y}^{′}(1)=0$ and $y(2)+6{y}^{′}(2)=0$ yields the trivial solution $y≡0.$ Since the zero solution is not an eigenfunction, $\\lambda =0$ is not an eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda \\ne 0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-12\\lambda m+36{\\lambda }^{2} & =0 \\\\ (m-6\\lambda )(m-6\\lambda ) & =0.\\end{aligned}\n$$\n\nSo, we have the double root $m=6\\lambda .$ So, the fundamental solutions are\n\n$$\n{y}_{1}(x)={e}^{6\\lambda x},\\,{y}_{2}(x)=x{e}^{6\\lambda x}\n$$\n\nand the general solution is\n\n$$\ny=A{e}^{6\\lambda x}+Bx{e}^{6\\lambda x}.\n$$\n\nDifferentiating gives\n\n$$\n\\begin{aligned}{y}^{′} & =6A\\lambda {e}^{6\\lambda x}+B{e}^{6\\lambda x}+6B\\lambda x{e}^{6\\lambda x}.\\end{aligned}\n$$\n\nApplying the boundary condition ${y}^{′}(1)=0$ yields\n\n$$\n\\begin{aligned}6A\\lambda {e}^{6\\lambda }+B{e}^{6\\lambda }+6B\\lambda {e}^{6\\lambda } & =0 \\\\ 6A\\lambda +B+6B\\lambda  & =0 \\\\ (6\\lambda )A+(1+6\\lambda )B & =0.\\end{aligned}\n$$\n\nApplying the boundary condition $y(2)+6{y}^{′}(2)=0$ yields\n\n$$\n\\begin{aligned}A{e}^{12\\lambda }+2B{e}^{12\\lambda }+6(6A\\lambda {e}^{12\\lambda }+B{e}^{12\\lambda }+12B\\lambda {e}^{12\\lambda }) & =0 \\\\ A+2B+6(6A\\lambda +B+12B\\lambda ) & =0 \\\\ A+2B+36A\\lambda +6B+72B\\lambda  & =0 \\\\ (1+36\\lambda )A+(8+72\\lambda )B & =0 \\\\ (1+36\\lambda )A+8(1+9\\lambda )B & =0.\\end{aligned}\n$$\n\nSo, we have the following systems of equations for $A$ and $B:$\n\n$$\n\\{\\begin{aligned}(6\\lambda )A+(1+6\\lambda )B=0 \\\\ (1+36\\lambda )A+(8+72\\lambda )B=0\\end{aligned}\n$$\n\nThis homogeneous linear system has a nontrivial solution if and only if the determinant is zero. This gives\n\n$$\n|\\begin{aligned}6\\lambda  & 1+6\\lambda  \\\\ 1+36\\lambda  & 8+72\\lambda \\end{aligned}|=0.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}6\\lambda (8+72\\lambda )-(1+6\\lambda )(1+36\\lambda ) & =0 \\\\ 48\\lambda +432{\\lambda }^{2}-(1+42\\lambda +216{\\lambda }^{2}) & =0 \\\\ 216{\\lambda }^{2}+6\\lambda -1 & =0 \\\\ (12\\lambda +1)(18\\lambda -1) & =0.\\end{aligned}\n$$\n\nThus, we have the eigenvalues ${\\lambda }_{1}=-\\frac{1}{12}\\text{ and }{\\lambda }_{2}=\\frac{1}{18}.$\n\nFinally, we find the eigenfunction corresponding to each eigenvalue:\n\n- Consider ${\\lambda }_{1}=-\\frac{1}{12}.$ Then, we have the solution\n\n$$\n\\begin{aligned}{y}_{1}(x) & =A{e}^{6{\\lambda }_{1}x}+Bx{e}^{6{\\lambda }_{1}x} \\\\  & =A{e}^{-x/2}+Bx{e}^{-x/2}\\end{aligned}\n$$\n\nand substituting ${\\lambda }_{1}$ into\n\n$$\n(6\\lambda )A+(1+6\\lambda )B=0\n$$\n\nwe get\n\n$$\n-\\frac{1}{2}A+\\frac{1}{2}B=0\n$$\n\nwhich gives $A=B,$ where $B$ is a free parameter. Thus, the eigenfunction corresponding to this eigenvalue is\n\n$$\n\\begin{aligned}{y}_{1}(x) & =B{e}^{-x/2}+Bx{e}^{-x/2} \\\\  & =B{e}^{-x/2}(x+1).\\end{aligned}\n$$\n\n- For ${\\lambda }_{2}=\\frac{1}{18},$ we have\n\n$$\n\\begin{aligned}{y}_{2}(x) & =A{e}^{6{\\lambda }_{2}x}+Bx{e}^{6{\\lambda }_{2}x} \\\\  & =A{e}^{x/3}+Bx{e}^{x/3}\\end{aligned}\n$$\n\nand substituting ${\\lambda }_{2}$ into\n\n$$\n(6\\lambda )A+(1+6\\lambda )B=0\n$$\n\nwe get\n\n$$\n\\frac{1}{3}A+\\frac{4}{3}B=0\\,⇒\\,A=-4B\n$$\n\nwhere $B$ is a free parameter. Thus, the eigenfunction corresponding to this eigenvalue is\n\n$$\n\\begin{aligned}{y}_{2}(x) & =-4B{e}^{x/3}+Bx{e}^{x/3} \\\\  & =B{e}^{x/3}(x-4) \\\\  & =C{e}^{x/3}(x-4)\\end{aligned}\n$$\n\nwhere we have set $C=B.$\n\nSo, the eigenfunctions corresponding to ${\\lambda }_{1}$ and ${\\lambda }_{2},$ respectively, are $B{e}^{-x/2}(x+1)\\text{ and }C{e}^{x/3}(x-4).$" #edb/ref 17592186045417] [17592186522793 #edb/ref 1068 #edb/ref 17592186522581 #edb/ref 17592186045417] [17592186522793 #edb/ref 1068 #edb/ref 17592186522678 #edb/ref 17592186045417] [17592186522793 #edb/ref 1069 "q-338911" #edb/ref 17592186045417] [17592186522793 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186522793 #edb/ref 1071 "Consider the boundary value problem\n\n$$\n{y}^{″}+25{\\lambda }^{2}y=0,\\,y(0)=0,\\,{y}^{′}(2)=0,\\,0\\le x\\le 2,\\,\\lambda \\ge 0.\n$$\n\nFind the parameter values corresponding to the eigenvalues and the associated eigenfunctions of this problem.\n\n$\\,$ The eigenvalues correspond to the parameter values ${\\lambda }_{n}=$ {{field-1}}, where $n\\in N.$\n\n$\\,$ The eigenfunctions are ${y}_{n}(x)=$ {{field-2}}, where ${B}_{n}\\in R.$" #edb/ref 17592186045417] [17592186522793 #edb/ref 1072 #uuid "e119a1c3-3fb4-5a0d-b097-eb9b2cba2dd5" #edb/ref 17592186045417] [17592186522793 #edb/ref 1074 "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions $y(0)=0$ and ${y}^{′}(2)=0$ yields the trivial solution $y≡0.$ Since the zero solution is not an eigenfunction, $\\lambda =0$ does not correspond to an eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda >0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}+25{\\lambda }^{2} & =0.\\end{aligned}\n$$\n\nSo, we have $m=\\pm 5\\text{i}\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)=\\operatorname{cos}⁡(5\\lambda x),\\,{y}_{2}(x)=\\operatorname{sin}⁡(5\\lambda x)\n$$\n\nand the general solution is\n\n$$\ny=A\\operatorname{cos}⁡(5\\lambda x)+B\\operatorname{sin}⁡(5\\lambda x).\n$$\n\nApplying the boundary condition $y(0)=0$ yields\n\n$$\nA\\operatorname{cos}⁡(0)+B\\operatorname{sin}⁡(0)=0\n$$\n\nwhich gives $A=0.$ So, we have\n\n$$\ny=B\\operatorname{sin}⁡(5\\lambda x).\n$$\n\nDifferentiating gives\n\n$$\n{y}^{′}=5B\\lambda \\operatorname{cos}⁡(5\\lambda x).\n$$\n\nApplying the boundary condition ${y}^{′}(2)=0$ yields\n\n$$\n5B\\lambda \\operatorname{cos}⁡(10\\lambda )=0.\n$$\n\nFor nontrivial solutions, we require \n\n$$\n10\\lambda =\\frac{\\pi }{2}+n\\pi =\\frac{(2n+1)\\pi }{2}\n$$\n\nfor $n\\in N.$ This gives the parameter values corresponding to the eigenvalues:\n\n$$\n{\\lambda }_{n}=\\frac{(2n+1)\\pi }{20}.\n$$\n\nThe corresponding eigenfunctions are \n\n$$\n{y}_{n}(x)={B}_{n}\\operatorname{sin}⁡(5{\\lambda }_{n}x),\\,{B}_{n}\\in R.\n$$" #edb/ref 17592186045417] [17592186522834 #edb/ref 1058 #edb/ref 17592186522856 #edb/ref 17592186045417] [17592186522834 #edb/ref 1062 #uuid "2a58e732-9b94-5f3d-88a9-7a4d9823485f" #edb/ref 17592186045417] [17592186522834 #edb/ref 1063 #edb/ref 17592186522793 #edb/ref 17592186045417] [17592186522842 #edb/ref 1058 #edb/ref 17592186522872 #edb/ref 17592186045417] [17592186522842 #edb/ref 1062 #uuid "4affdd5b-9eb0-5e02-a8fc-15da98d24def" #edb/ref 17592186045417] [17592186522842 #edb/ref 1063 #edb/ref 17592186522787 #edb/ref 17592186045417] [17592186522856 #edb/ref 1062 #uuid "843f985f-228b-50fa-8fb3-bdfb81168ccb" #edb/ref 17592186045417] [17592186522856 #edb/ref 1063 #edb/ref 17592186314746 #edb/ref 17592186045417] [17592186522861 #edb/ref 1058 #edb/ref 17592186522842 #edb/ref 17592186045417] [17592186522861 #edb/ref 1062 #uuid "9413bf48-d935-5135-a6f0-348e7d65f04d" #edb/ref 17592186045417] [17592186522861 #edb/ref 1063 #edb/ref 17592186167267 #edb/ref 17592186045417] [17592186522872 #edb/ref 1058 #edb/ref 17592186522834 #edb/ref 17592186045417] [17592186522872 #