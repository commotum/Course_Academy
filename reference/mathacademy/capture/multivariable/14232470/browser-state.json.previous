          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:70px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"9\"><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"11\"><span class=\"mq-numerator\" mathquill-block-id=\"13\"><span mathquill-command-id=\"12\">3</span></span><span class=\"mq-denominator\" mathquill-block-id=\"15\"><span mathquill-command-id=\"14\">1</span><span mathquill-command-id=\"16\">0</span></span><span style=\"display:inline-block;width:0\">​</span></span><var mathquill-command-id=\"20\" class=\"mq-operator-name\">s</var><var mathquill-command-id=\"21\" class=\"mq-operator-name\">i</var><var mathquill-command-id=\"22\" class=\"mq-operator-name\">n</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"24\"><span class=\"mq-sup\" mathquill-block-id=\"26\"><span mathquill-command-id=\"25\">2</span></span></span><var mathquill-command-id=\"28\">θ</var></span></div></div>",
