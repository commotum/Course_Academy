      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14232470/observations/step-q53199-70a6394ad63758e9935c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14232470/observations/step-q53199-70a6394ad63758e9935c.png",
      "source_url": "https://mathacademy.com/tasks/14232470/topics/369/review",
