      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14232470/observations/step-q121713-6cbe1b9ceb0baf038d56.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14232470/observations/step-q121713-6cbe1b9ceb0baf038d56.png",
      "source_url": "https://mathacademy.com/tasks/14232470/topics/369/review",
      "captured_at": 1792079293.9468775,
      "math_academy_id": "q-121713",
      "topic_id": "369",
      "sequence_position": null,
