      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14232470/observations/step-q314883-54a533583dea8e6d9634.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14232470/observations/step-q314883-54a533583dea8e6d9634.png",
      "source_url": "https://mathacademy.com/tasks/14232470/topics/369/review",
      "captured_at": 1792079312.0681975,
      "math_academy_id": "q-314883",
