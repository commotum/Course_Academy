      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14232470/observations/step-q53189-f5037396e6389d124096.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14232470/observations/step-q53189-f5037396e6389d124096.png",
      "source_url": "https://mathacademy.com/tasks/14232470/topics/369/review",
      "captured_at": 1792079249.1666183,
      "math_academy_id": "q-53189",
      "topic_id": "369",
      "sequence_position": null,
