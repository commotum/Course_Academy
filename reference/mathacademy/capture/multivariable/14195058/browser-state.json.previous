sup><mo stretchy=\"false\">(</mo><mn>0.4</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>7</mn><mo>−</mo><mn>2</mn></mrow></msup><mo>+</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">(</mo></mrow><mfrac linethickness=\"0\"><mn>7</mn><mn>3</mn></mfrac><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"2.047em\" maxsize=\"2.047em\">)</mo></mrow></mrow><mo stretchy=\"false\">(</mo><mn>0.6</mn><msup><mo stretchy=\"false\">)</mo><mn>3</mn></msup><mo stretchy=\"false\">(</mo><mn>0.4</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>7</mn><mo>−</mo><mn>3</mn></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>21</mn><mo stretchy=\"false\">(</mo><mn>0.6</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mo stretchy=\"false\">(</mo><mn>0.4</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>5</mn></mrow></msup><mo>+</mo><mn>35</mn><mo stretchy=\"false\">(</mo><mn>0.6</mn><msup><mo stretchy=\"false\">)</mo><mn>3</mn></msup><mo stretchy=\"false\">(</mo><mn>0.4</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mn>4</mn></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mn>0.2710</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>to <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"16\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math></mjx-assistive-mml></mjx-container> decimal places.</p>\n</div></div>",
