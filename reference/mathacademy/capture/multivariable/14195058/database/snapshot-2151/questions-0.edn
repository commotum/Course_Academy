#{[{:db/id #edb/ref 17592186508997 :knowledge-point/_questions [{:db/id #edb/ref 17592186166889 :knowledge-point/id #uuid "b4844e17-9365-5a6f-a5f4-b9fa83fd81e1" :knowledge-point/title "Computing a Probability Over an Interval Using the Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34af392b-1136-50d8-a203-652c8d606c68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.8410" :db/id #edb/ref 17592186508468} {:answer/id #uuid "57c3c507-2e75-561a-bece-cbf7a22ed1b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9382" :db/id #edb/ref 17592186508520} {:answer/id #uuid "bf4229ee-a75e-56ad-8370-aa5a487d6cda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.8792" :db/id #edb/ref 17592186508680} {:answer/id #uuid "e377b303-c9d0-5210-973d-2b50b7f6f27d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.8543" :db/id #edb/ref 17592186508752} {:answer/id #uuid "f827e693-1cfa-5aac-8c0d-f7f620f2e41c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9590" :db/id #edb/ref 17592186508799}] :answer-field/correct {:answer/id #uuid "f827e693-1cfa-5aac-8c0d-f7f620f2e41c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9590" :db/id #edb/ref 17592186508799} :answer-field/id #uuid "b8debddd-d193-5cbb-9714-1e57ecfc0d4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508877}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f971c3b7-c38e-56ce-b09c-6e2a701c1e91" :question/math-academy-id "q-129982" :question/problem "Given that $X∼B(6,0.6),$ compute $P(X\\ge 2).$ Round your final answer to $4$ decimal places." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(6,0.6),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{6}{x})(0.6)^{x}(0.4)^{6-x}.\n$$\n\nComputing $P(X\\ge 2)$ will require us to compute $f(x)$ at $x=2,3,4,5,6.$ However, if we compute the complement $P(X<2)$ instead, then we will only have to compute $f(x)$ at $x=0,1,$ which will result in a much faster computation.\n\nComputing $P(X<2),$ we get\n\n$$\n\\begin{aligned}P(X<2) & =P(X\\in \\{0,1\\}) \\\\  & =f(0)+f(1) \\\\  & =(\\genfrac{}{}{0pt}{}{6}{0})(0.6)^{0}(0.4)^{6-0}+(\\genfrac{}{}{0pt}{}{6}{1})(0.6)^{1}(0.4)^{6-1} \\\\  & =1(0.6)^{0}(0.4)^{6}+6(0.6)^{1}(0.4)^{5} \\\\  & ≈0.0410\\end{aligned}\n$$\n\nrounded to $4$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\ge 2) & =1-P(X<2) \\\\  & ≈1-0.0410 \\\\  & =0.9590\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}] [{:db/id #edb/ref 17592186508995 :knowledge-point/_questions [{:db/id #edb/ref 17592186166888 :knowledge-point/id #uuid "5f98ff81-db37-590b-8910-58928af97f44" :knowledge-point/title "Computing a Probability Over a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06093a48-e545-54b9-8ae5-487035b494fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.691" :db/id #edb/ref 17592186508397}] :answer-field/correct {:answer/id #uuid "06093a48-e545-54b9-8ae5-487035b494fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.691" :db/id #edb/ref 17592186508397} :answer-field/id #uuid "82753b1d-4114-53cd-9ba7-e76ac29f8bca" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186508851}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "efd53794-367f-547c-a3cb-0e0a7df2cfac" :question/math-academy-id "q-276035" :question/problem "If $X∼B(4,\\frac{1}{3}),$  then, **rounded to $3$ decimal places**, $P(1\\le X<3)≈${{field-1}} ." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(4,\\frac{1}{3}),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{4}{x}){(\\frac{1}{3})}^{x}{(\\frac{2}{3})}^{4-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(1\\le X<3) & =P(X\\in \\{1,2\\}) \\\\  & =f(1)+f(2) \\\\  & =(\\genfrac{}{}{0pt}{}{4}{1}){(\\frac{1}{3})}^{1}{(\\frac{2}{3})}^{4-1}+(\\genfrac{}{}{0pt}{}{4}{2}){(\\frac{1}{3})}^{2}{(\\frac{2}{3})}^{4-2} \\\\  & =4{(\\frac{1}{3})}^{1}{(\\frac{2}{3})}^{3}+6{(\\frac{1}{3})}^{2}{(\\frac{2}{3})}^{2} \\\\  & ≈0.691\\end{aligned}\n$$\n\n \nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186167480 :knowledge-point/_questions [{:db/id #edb/ref 17592186166888 :knowledge-point/id #uuid "5f98ff81-db37-590b-8910-58928af97f44" :knowledge-point/title "Computing a Probability Over a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbfe0ccc-b157-5117-bcab-cb594271efcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3218" :db/id #edb/ref 17592186166089} {:answer/id #uuid "c9e887c8-e3c3-59f6-9e0e-6148417fbb0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2289" :db/id #edb/ref 17592186166090} {:answer/id #uuid "cad181cf-2e9c-5e87-88ce-c659a4097c47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1853" :db/id #edb/ref 17592186166091} {:answer/id #uuid "270d6c2f-fbca-5d3d-9aa1-56d790b94597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2710" :db/id #edb/ref 17592186166092} {:answer/id #uuid "5fb830dc-3c12-5953-9c22-8bcb681eb530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3067" :db/id #edb/ref 17592186166093}] :answer-field/correct {:answer/id #uuid "270d6c2f-fbca-5d3d-9aa1-56d790b94597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2710" :db/id #edb/ref 17592186166092} :answer-field/id #uuid "e99f304d-23f7-55f8-b5bf-1b40e7bbc41d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186166088}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "490aa863-0761-57d7-8d60-f966b763e6e6" :question/math-academy-id "q-96729" :question/problem "Given $X∼B(7,0.6),$ compute $P(1<X\\le 3).$ Round your final answer to $4$ decimal places." :question/requires-calculator true :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.6),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.6)^{x}(0.4)^{7-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(1<X\\le 3) & =P(X\\in \\{2,3\\}) \\\\  & =f(2)+f(3) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{2})(0.6)^{2}(0.4)^{7-2}+(\\genfrac{}{}{0pt}{}{7}{3})(0.6)^{3}(0.4)^{7-3} \\\\  & =21(0.6)^{2}(0.4)^{5}+35(0.6)^{3}(0.4)^{4} \\\\  & ≈0.2710\\end{aligned}\n$$\n\nto $4$ decimal places."}] [{:db/id #edb/ref 17592186167481 :knowledge-point/_questions [{:db/id #edb/ref 17592186166889 :knowledge-point/id #uuid "b4844e17-9365-5a6f-a5f4-b9fa83fd81e1" :knowledge-point/title "Computing a Probability Over an Interval Using the Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d658e87f-f83c-5265-b896-09df8ec63665" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9387" :db/id #edb/ref 17592186166095} {:answer/id #uuid "f71b1ed8-8dc3-596d-b557-787cd3952614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9996" :db/id #edb/ref 17592186166096} {:answer/id #uuid "3dcf4f73-dc6f-5564-945f-306f19a0bdf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9821" :db/id #edb/ref 17592186166097} {:answer/id #uuid "5259e5d3-1e03-56ae-b35c-cd373e9c3f55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9964" :db/id #edb/ref 17592186166098} {:answer/id #uuid "7e00d113-cbc6-5ae0-8975-e630744ab4f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9576" :db/id #edb/ref 17592186166099}] :answer-field/correct {:answer/id #uuid "f71b1ed8-8dc3-596d-b557-787cd3952614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9996" :db/id #edb/ref 17592186166096} :answer-field/id #uuid "132d4363-edc2-5569-9f96-55e397049cfd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186166094}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c8a34cbc-1a60-5866-a9b3-4176aeb40665" :question/math-academy-id "q-96730" :question/problem "Given that $X∼B(9,0.3),$ compute $P(X\\le 7).$ Round your final answer to $4$ decimal places." :question/requires-calculator true :question/worked-solution "For a binomial random variable $X∼B(n,p),$ we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(9,0.3),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{9}{x})(0.3)^{x}(0.7)^{9-x}.\n$$\n\nComputing $P(X\\le 7)$ will require us to compute $f(x)$ at $x=0,1,2,…,7.$ However, if we compute the complement $P(X>7)$ instead, then we will only have to compute $f(x)$ at $x=8,9,$ which will result in a much faster computation.\n\nComputing $P(X>7),$ we get\n\n$$\n\\begin{aligned}P(X>7) & =P(X\\in \\{8,9\\}) \\\\  & =f(8)+f(9) \\\\  & =(\\genfrac{}{}{0pt}{}{9}{8})(0.3)^{8}(0.7)^{9-8}+(\\genfrac{}{}{0pt}{}{9}{9})(0.3)^{9}(0.7)^{9-9} \\\\  & =9(0.3)^{8}(0.7)+(0.3)^{9} \\\\  & ≈0.0004\\end{aligned}\n$$\n\nrounded to $4$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 7) & =1-P(X>7) \\\\  & ≈1-0.0004 \\\\  & =0.9996\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}] [{:db/id #edb/ref 17592186508987 :knowledge-point/_questions [{:db/id #edb/ref 17592186166887 :knowledge-point/id #uuid "8a03ad88-dc53-582c-b2ed-1aeb0ee2d0f5" :knowledge-point/title "Computing a Binomial Probability Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db86219-2eac-5c9f-a3bf-973d5602b642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4613" :db/id #edb/ref 17592186508439} {:answer/id #uuid "2d77499c-5ed0-5cea-aa1b-50bd167e5262" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5801" :db/id #edb/ref 17592186508458} {:answer/id #uuid "31bf5d69-eb49-5b8a-a67c-fc27f690f962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4199" :db/id #edb/ref 17592186508462} {:answer/id #uuid "79d1b1e6-898f-5dd4-b846-71873e97741c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4414" :db/id #edb/ref 17592186508569} {:answer/id #uuid "9469b8cc-2e3f-5043-bf24-87474596ac91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5586" :db/id #edb/ref 17592186508610}] :answer-field/correct {:answer/id #uuid "31bf5d69-eb49-5b8a-a67c-fc27f690f962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4199" :db/id #edb/ref 17592186508462} :answer-field/id #uuid "93f42f81-64bc-5bdc-8f24-11963ed6c867" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508860}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dda52838-e549-5595-ba17-f5adb7013bf8" :question/math-academy-id "q-97505" :question/problem "Given that $X∼B(7,0.4),$ compute $P(X\\le 2).$ Round your final answer to $4$ decimal places." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.4),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.4)^{x}(0.6)^{7-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 2) & =P(X\\in \\{0,1,2\\}) \\\\  & =f(0)+f(1)+f(2) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{0})(0.4)^{0}(0.6)^{7-0}+(\\genfrac{}{}{0pt}{}{7}{1})(0.4)^{1}(0.6)^{7-1}+(\\genfrac{}{}{0pt}{}{7}{2})(0.4)^{2}(0.6)^{7-2} \\\\  & =1(0.4)^{0}(0.6)^{7}+7(0.4)(0.6)^{6}+21(0.4)^{2}(0.6)^{5} \\\\  & ≈0.4199\\end{aligned}\n$$\n\nto $4$ decimal places."}]}
