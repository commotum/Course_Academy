477 49Q498 46 526 46H542V0H534L510 1Q487 2 460 2T422 3Q319 3 310 0H302V46H318Q379 46 379 62Q380 64 380 200Q379 335 378 343Q372 371 358 385T334 402T308 404Q263 404 229 370Q202 343 195 315T187 232V168V108Q187 78 188 68T191 55T200 49Q221 46 249 46H265V0H257L234 1Q210 2 183 2T145 3Q42 3 33 0H25V46H41Z\" id=\"E1-MJMAIN-6D\" stroke-width=\"1\"></path>\n<path d=\"M423 750Q432 750 438 744T444 730Q444 725 271 248T92 -240Q85 -250 75 -250Q68 -250 62 -245T56 -231Q56 -221 230 257T407 740Q411 750 423 750Z\" id=\"E1-MJMAIN-2F\" stroke-width=\"1\"></path>\n<path d=\"M295 316Q295 356 268 385T190 414Q154 414 128 401Q98 382 98 349Q97 344 98 336T114 312T157 287Q175 282 201 278T245 269T277 256Q294 248 310 236T342 195T359 133Q359 71 321 31T198 -10H190Q138 -10 94 26L86 19L77 10Q71 4 65 -1L54 -11H46H42Q39 -11 33 -5V74V132Q33 153 35 157T45 162H54Q66 162 70 158T75 146T82 119T101 77Q136 26 198 26Q295 26 295 104Q295 133 277 151Q257 175 194 187T111 210Q75 227 54 256T33 318Q33 357 50 384T93 424T143 442T187 447H198Q238 447 268 432L283 424L292 431Q302 440 314 448H322H326Q329 448 335 442V310L329 304H301Q295 310 295 316Z\" id=\"E1-MJMAIN-73\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E1-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use xlink:href=\"#E1-MJMAIN-32\"></use>\n<use x=\"500\" xlink:href=\"#E1-MJMAIN-30\" y=\"0\"></use>\n<g transform=\"translate(1001,0)\">\n<use x=\"250\" xlink:href=\"#E1-MJMAIN-63\" y=\"0\"></use>\n<use x=\"694\" xlink:href=\"#E1-MJMAIN-6D\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"2160\" xlink:href=\"#E1-MJMAIN-32\" y=\"513\"></use>\n</g>\n<g transform=\"translate(2982,0)\">\n<use xlink:href=\"#E1-MJMAIN-2F\"></use>\n<use x=\"500\" xlink:href=\"#E1-MJMAIN-73\" y=\"0\"></use>\n</g>\n<use x=\"3877\" xlink:href=\"#E1-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span> If <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-2-Title\" focusable=\"false\" height=\"1.676ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -576.1 572.5 721.6\" width=\"1.33ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-2-Title\">x</title>\n<defs aria-hidden=\"true\">\n<path d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40Q91 39 97 36T113 29T132 26Q168 26 194 71Q203 87 217 139T245 247T261 313Q266 340 266 352Q266 380 251 392T217 404Q177 404 142 372T93 290Q91 281 88 280T72 278H58Q52 284 52 289Z\" id=\"E2-MJMATHI-78\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E2-MJMATHI-78\" y=\"0\"></use>\n</g>\n</svg></span> and <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-3-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 750.5 936.9\" width=\"1.743ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-3-Title\">A</title>\n<defs aria-hidden=\"true\">\n<path d=\"M208 74Q208 50 254 46Q272 46 272 35Q272 34 270 22Q267 8 264 4T251 0Q249 0 239 0T205 1T141 2Q70 2 50 0H42Q35 7 35 11Q37 38 48 46H62Q132 49 164 96Q170 102 345 401T523 704Q530 716 547 716H555H572Q578 707 578 706L606 383Q634 60 636 57Q641 46 701 46Q726 46 726 36Q726 34 723 22Q720 7 718 4T704 0Q701 0 690 0T651 1T578 2Q484 2 455 0H443Q437 6 437 9T439 27Q443 40 445 43L449 46H469Q523 49 533 63L521 213H283L249 155Q208 86 208 74ZM516 260Q516 271 504 416T490 562L463 519Q447 492 400 412L310 260L413 259Q516 259 516 260Z\" id=\"E3-MJMATHI-41\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E3-MJMATHI-41\" y=\"0\"></use>\n</g>\n</svg></span> denote the side length and area of the square respectively, then find an expression for <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-4-Title\" focusable=\"false\" height=\"5.509ex\" role=\"img\" style=\"vertical-align: -2.005ex;\" viewbox=\"0 -1508.9 1489 2372\" width=\"3.458ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-4-Title\">\\dfrac{\\textrm d x}{\\textrm d t}</title>\n<defs aria-hidden=\"true\">\n<path d=\"M376 495Q376 511 376 535T377 568Q377 613 367 624T316 637H298V660Q298 683 300 683L310 684Q320 685 339 686T376 688Q393 689 413 690T443 693T454 694H457V390Q457 84 458 81Q461 61 472 55T517 46H535V0Q533 0 459 -5T380 -11H373V44L365 37Q307 -11 235 -11Q158 -11 96 50T34 215Q34 315 97 378T244 442Q319 442 376 393V495ZM373 342Q328 405 260 405Q211 405 173 369Q146 341 139 305T131 211Q131 155 138 120T173 59Q203 26 251 26Q322 26 373 103V342Z\" id=\"E4-MJMAIN-64\" stroke-width=\"1\"></path>\n<path d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40Q91 39 97 36T113 29T132 26Q168 26 194 71Q203 87 217 139T245 247T261 313Q266 340 266 352Q266 380 251 392T217 404Q177 404 142 372T93 290Q91 281 88 280T72 278H58Q52 284 52 289Z\" id=\"E4-MJMATHI-78\" stroke-width=\"1\"></path>\n<path d=\"M26 385Q19 392 19 395Q19 399 22 411T27 425Q29 430 36 430T87 431H140L159 511Q162 522 166 540T173 566T179 586T187 603T197 615T211 624T229 626Q247 625 254 615T261 596Q261 589 252 549T232 470L222 433Q222 431 272 431H323Q330 424 330 420Q330 398 317 385H210L174 240Q135 80 135 68Q135 26 162 26Q197 26 230 60T283 144Q285 150 288 151T303 153H307Q322 153 322 145Q322 142 319 133Q314 117 301 95T267 48T216 6T155 -11Q125 -11 98 4T59 56Q57 64 57 83V101L92 241Q127 382 128 383Q128 385 77 385H26Z\" id=\"E4-MJMATHI-74\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<g transform=\"translate(120,0)\">\n<rect height=\"60\" stroke=\"none\" width=\"1249\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n<use x=\"0\" xlink:href=\"#E4-MJMAIN-64\" y=\"0\"></use>\n<use x=\"556\" xlink:href=\"#E4-MJMATHI-78\" y=\"0\"></use>\n</g>\n<g transform=\"translate(165,-716)\">\n<use x=\"0\" xlink:href=\"#E4-MJMAIN-64\" y=\"0\"></use>\n<use x=\"556\" xlink:href=\"#E4-MJMATHI-74\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</svg></span>, where <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-5-Title\" focusable=\"false\" height=\"2.009ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -719.6 361.5 865.1\" width=\"0.84ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-5-Title\">t</title>\n<defs aria-hidden=\"true\">\n<path d=\"M26 385Q19 392 19 395Q19 399 22 411T27 425Q29 430 36 430T87 431H140L159 511Q162 522 166 540T173 566T179 586T187 603T197 615T211 624T229 626Q247 625 254 615T261 596Q261 589 252 549T232 470L222 433Q222 431 272 431H323Q330 424 330 420Q330 398 317 385H210L174 240Q135 80 135 68Q135 26 162 26Q197 26 230 60T283 144Q285 150 288 151T303 153H307Q322 153 322 145Q322 142 319 133Q314 117 301 95T267 48T216 6T155 -11Q125 -11 98 4T59 56Q57 64 57 83V101L92 241Q127 382 128 383Q128 385 77 385H26Z\" id=\"E5-MJMATHI-74\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E5-MJMATHI-74\" y=\"0\"></use>\n</g>\n</svg></span> is the time in seconds.</p>\n</div>\n<div class=\"explanationHeader\">EXPLANATION</div>\n<div class=\"exampleExplanation\">\n<style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direction: ltr;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            border: 0;\n                            padding: 0;\n                            margin: 0\n                            }\n\n                            .mjpage * {\n                            transition: none;\n                            -webkit-transition: none;\n                            -moz-transition: none;\n                            -ms-transition: none;\n                            -o-transition: none\n                            }\n\n                            .mjx-svg-href {\n                            fill: blue;\n                            stroke: blue\n                            }\n\n                            .MathJax_SVG_LineBox {\n                            display: table!important\n                            }\n\n                            .MathJax_SVG_LineBox span {\n                            display: table-cell!important;\n                            width: 10000em!important;\n                            min-width: 0;\n                            max-width: none;\n                            padding: 0;\n                            border: 0;\n                            margin: 0\n                            }\n\n                            .mjpage__block {\n                            text-align: center;\n                            margin: 1em 0em;\n                            position: relative;\n                            display: block!important;\n                            text-indent: 0;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            width: 100%\n                            }</style><p>This situation is different. Here, the <em>area</em> is changing at a constant rate,  and we want to know the rate at which the side lengths are changing.</p>\n<p>First, let's draw a diagram:</p>\n<div class=\"graphic\" id=\"graphic-737482d642e7a65211b9ac7f4b5574ed\"><img src=\"/graphics/737482d642e7a65211b9ac7f4b5574ed\"/></div>\n<p>We want to find <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-1-Title\" focusable=\"false\" height=\"5.509ex\" role=\"img\" style=\"vertical-align: -2.005ex;\" viewbox=\"0 -1508.9 1767.5 2372\" width=\"4.105ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-1-Title\">\\dfrac{\\textrm d x}{\\textrm d t}.</title>\n<defs aria-hidden=\"true\">\n<path d=\"M376 495Q376 511 376 535T377 568Q377 613 367 624T316 637H298V660Q298 683 300 683L310 684Q320 685 339 686T376 688Q393 689 413 690T443 693T454 694H457V390Q457 84 458 81Q461 61 472 55T517 46H535V0Q533 0 459 -5T380 -11H373V44L365 37Q307 -11 235 -11Q158 -11 96 50T34 215Q34 315 97 378T244 442Q319 442 376 393V495ZM373 342Q328 405 260 405Q211 405 173 369Q146 341 139 305T131 211Q131 155 138 120T173 59Q203 26 251 26Q322 26 373 103V342Z\" id=\"E1-MJMAIN-64\" stroke-width=\"1\"></path>\n<path d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40Q91 39 97 36T113 29T132 26Q168 26 194 71Q203 87 217 139T245 247T261 313Q266 340 266 352Q266 380 251 392T217 404Q177 404 142 372T93 290Q91 281 88 280T72 278H58Q52 284 52 289Z\" id=\"E1-MJMATHI-78\" stroke-width=\"1\"></path>\n<path d=\"M26 385Q19 392 19 395Q19 399 22 411T27 425Q29 430 36 430T87 431H140L159 511Q162 522 166 540T173 566T179 586T187 603T197 615T211 624T229 626Q247 625 254 615T261 596Q261 589 252 549T232 470L222 433Q222 431 272 431H323Q330 424 330 420Q330 398 317 385H210L174 240Q135 80 135 68Q135 26 162 26Q197 26 230 60T283 144Q285 150 288 151T303 153H307Q322 153 322 145Q322 142 319 133Q314 117 301 95T267 48T216 6T155 -11Q125 -11 98 4T59 56Q57 64 57 83V101L92 241Q127 382 128 383Q128 385 77 385H26Z\" id=\"E1-MJMATHI-74\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E1-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<g transform=\"translate(120,0)\">\n<rect height=\"60\" stroke=\"none\" width=\"1249\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n<use x=\"0\" xlink:href=\"#E1-MJMAIN-64\" y=\"0\"></use>\n<use x=\"556\" xlink:href=\"#E1-MJMATHI-78\" y=\"0\"></use>\n</g>\n<g transform=\"translate(165,-716)\">\n<use x=\"0\" xlink:href=\"#E1-MJMAIN-64\" y=\"0\"></use>\n<use x=\"556\" xlink:href=\"#E1-MJMATHI-74\" y=\"0\"></use>\n</g>\n</g>\n<use x=\"1489\" xlink:href=\"#E1-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span> The area <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-2-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 750.5 936.9\" width=\"1.743ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-2-Title\">A</title>\n<defs aria-hidden=\"true\">\n<path d=\"M208 74Q208 50 254 46Q272 46 272 35Q272 34 270 22Q267 8 264 4T251 0Q249 0 239 0T205 1T141 2Q70 2 50 0H42Q35 7 35 11Q37 38 48 46H62Q132 49 164 96Q170 102 345 401T523 704Q530 716 547 716H555H572Q578 707 578 706L606 383Q634 60 636 57Q641 46 701 46Q726 46 726 36Q726 34 723 22Q720 7 718 4T704 0Q701 0 690 0T651 1T578 2Q484 2 455 0H443Q437 6 437 9T439 27Q443 40 445 43L449 46H469Q523 49 533 63L521 213H283L249 155Q208 86 208 74ZM516 260Q516 271 504 416T490 562L463 519Q447 492 400 412L310 260L413 259Q516 259 516 260Z\" id=\"E2-MJMATHI-41\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E2-MJMATHI-41\" y=\"0\"></use>\n</g>\n</svg></span> is related to side length <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-3-Title\" focusable=\"false\" height=\"1.676ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -576.1 572.5 721.6\" width=\"1.33ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-3-Title\">x</title>\n<defs aria-hidden=\"true\">\n<path d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40Q91 39 97 36T113 29T132 26Q168 26 194 71Q203 87 217 139T245 247T261 313Q266 340 266 352Q266 380 251 392T217 404Q177 404 142 372T93 290Q91 281 88 280T72 278H58Q52 284 52 289Z\" id=\"E3-MJMATHI-78\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E3-MJMATHI-78\" y=\"0\"></use>\n</g>\n</svg></span> by the formula</p>\n<p><span class=\"mjpage mjpage__block\"><svg aria-labelledby=\"MathJax-SVG-4-Title\" focusable=\"false\" height=\"2.676ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -1006.6 3389.5 1152.1\" width=\"7.872ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-4-Title\">\nA = x^2.\n</title>\n<defs aria-hidden=\"true\">\n<path d=\"M208 74Q208 50 254 46Q272 46 272 35Q272 34 270 22Q267 8 264 4T251 0Q249 0 239 0T205 1T141 2Q70 2 50 0H42Q35 7 35 11Q37 38 48 46H62Q132 49 164 96Q170 102 345 401T523 704Q530 716 547 716H555H572Q578 707 578 706L606 383Q634 60 636 57Q641 46