e\" width=\"1253\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n<use x=\"0\" xlink:href=\"#E9-MJMAIN-64\" y=\"0\"></use>\n<use x=\"556\" xlink:href=\"#E9-MJMATHI-68\" y=\"0\"></use>\n</g>\n<g transform=\"translate(167,-716)\">\n<use x=\"0\" xlink:href=\"#E9-MJMAIN-64\" y=\"0\"></use>\n<use x=\"556\" xlink:href=\"#E9-MJMATHI-74\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n<g transform=\"translate(0,-623)\">\n<use x=\"277\" xlink:href=\"#E9-MJMAIN-3D\" y=\"0\"></use>\n<use x=\"1334\" xlink:href=\"#E9-MJMATHI-68\" y=\"0\"></use>\n<g transform=\"translate(1910,0)\">\n<g transform=\"translate(275,0)\">\n<g transform=\"translate(120,0)\">\n<rect height=\"60\" stroke=\"none\" width=\"1253\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n<use x=\"0\" xlink:href=\"#E9-MJMAIN-64\" y=\"0\"></use>\n<use x=\"556\" xlink:href=\"#E9-MJMATHI-68\" y=\"0\"></use>\n</g>\n<g transform=\"translate(167,-716)\">\n<use x=\"0\" xlink:href=\"#E9-MJMAIN-64\" y=\"0\"></use>\n<use x=\"556\" xlink:href=\"#E9-MJMATHI-74\" y=\"0\"></use>\n</g>\n</g>\n</g>\n<line fill=\"none\" stroke-width=\"75\" x1=\"37\" x2=\"2005\" y1=\"-965\" y2=\"1610\"></line>\n</g>\n</g>\n<g transform=\"translate(0,-3225)\">\n<use x=\"277\" xlink:href=\"#E9-MJMAIN-3D\" y=\"0\"></use>\n<use x=\"1334\" xlink:href=\"#E9-MJMATHI-68\" y=\"0\"></use>\n<use x=\"1910\" xlink:href=\"#E9-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>So at that particular moment, we have <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-10-Title\" focusable=\"false\" height=\"2.509ex\" role=\"img\" style=\"vertical-align: -0.671ex;\" viewbox=\"0 -791.3 2689.6 1080.4\" width=\"6.247ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-10-Title\">h=2,</title>\n<defs aria-hidden=\"true\">\n<path d=\"M137 683Q138 683 209 688T282 694Q294 694 294 685Q294 674 258 534Q220 386 220 383Q220 381 227 388Q288 442 357 442Q411 442 444 415T478 336Q478 285 440 178T402 50Q403 36 407 31T422 26Q450 26 474 56T513 138Q516 149 519 151T535 153Q555 153 555 145Q555 144 551 130Q535 71 500 33Q466 -10 419 -10H414Q367 -10 346 17T325 74Q325 90 361 192T398 345Q398 404 354 404H349Q266 404 205 306L198 293L164 158Q132 28 127 16Q114 -11 83 -11Q69 -11 59 -2T48 16Q48 30 121 320L195 616Q195 629 188 632T149 637H128Q122 643 122 645T124 664Q129 683 137 683Z\" id=\"E10-MJMATHI-68\" stroke-width=\"1\"></path>\n<path d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\" id=\"E10-MJMAIN-3D\" stroke-width=\"1\"></path>\n<path d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\" id=\"E10-MJMAIN-32\" stroke-width=\"1\"></path>\n<path d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\" id=\"E10-MJMAIN-2C\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E10-MJMATHI-68\" y=\"0\"></use>\n<use x=\"854\" xlink:href=\"#E10-MJMAIN-3D\" y=\"0\"></use>\n<use x=\"1910\" xlink:href=\"#E10-MJMAIN-32\" y=\"0\"></use>\n<use x=\"2411\" xlink:href=\"#E10-MJMAIN-2C\" y=\"0\"></use>\n</g>\n</svg></span> and therefore the area of the square at that moment is</p>\n<p><span class=\"mjpage mjpage__block\"><svg aria-labelledby=\"MathJax-SVG-11-Title\" focusable=\"false\" height=\"5.676ex\" role=\"img\" style=\"vertical-align: -1.838ex;\" viewbox=\"0 -1652.5 5512 2443.8\" width=\"12.802ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-11-Title\">\nA = \\dfrac{2^2}{2} = 2.\n</title>\n<defs aria-hidden=\"true\">\n<path d=\"M208 74Q208 50 254 46Q272 46 272 35Q272 34 270 22Q267 8 264 4T251 0Q249 0 239 0T205 1T141 2Q70 2 50 0H42Q35 7 35 11Q37 38 48 46H62Q132 49 164 96Q170 102 345 401T523 704Q530 716 547 716H555H572Q578 707 578 706L606 383Q634 60 636 57Q641 46 701 46Q726 46 726 36Q726 34 723 22Q720 7 718 4T704 0Q701 0 690 0T651 1T578 2Q484 2 455 0H443Q437 6 437 9T439 27Q443 40 445 43L449 46H469Q523 49 533 63L521 213H283L249 155Q208 86 208 74ZM516 260Q516 271 504 416T490 562L463 519Q447 492 400 412L310 260L413 259Q516 259 516 260Z\" id=\"E11-MJMATHI-41\" stroke-width=\"1\"></path>\n<path d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\" id=\"E11-MJMAIN-3D\" stroke-width=\"1\"></path>\n<path d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\" id=\"E11-MJMAIN-32\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E11-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E11-MJMATHI-41\" y=\"0\"></use>\n<use x=\"10