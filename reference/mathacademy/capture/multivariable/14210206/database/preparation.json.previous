IN-29\" x=\"3002\" y=\"0\"></use>\n <use xlink:href=\"#E13-MJMAIN-22C5\" x=\"3614\" y=\"0\"></use>\n <use xlink:href=\"#E13-MJMAIN-32\" x=\"4115\" y=\"0\"></use>\n <use xlink:href=\"#E13-MJMAIN-28\" x=\"4615\" y=\"0\"></use>\n<g transform=\"translate(5005,0)\">\n <use xlink:href=\"#E13-MJMAIN-31\"></use>\n <use xlink:href=\"#E13-MJMAIN-30\" x=\"500\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E13-MJMAIN-29\" x=\"6006\" y=\"0\"></use>\n <use xlink:href=\"#E13-MJMAIN-3D\" x=\"6673\" y=\"0\"></use>\n <use xlink:href=\"#E13-MJMAIN-2212\" x=\"7729\" y=\"0\"></use>\n<g transform=\"translate(8508,0)\">\n <use xlink:href=\"#E13-MJMAIN-34\"></use>\n <use xlink:href=\"#E13-MJMAIN-30\" x=\"500\" y=\"0\"></use>\n</g>\n<g transform=\"translate(9509,0)\">\n <use xlink:href=\"#E13-MJMAIN-63\" x=\"250\" y=\"0\"></use>\n <use xlink:href=\"#E13-MJMAIN-6D\" x=\"694\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E13-MJMAIN-32\" x=\"2160\" y=\"583\"></use>\n</g>\n<g transform=\"translate(11490,0)\">\n <use xlink:href=\"#E13-MJMAIN-2F\"></use>\n <use xlink:href=\"#E13-MJMAIN-6D\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E13-MJMAIN-69\" x=\"1334\" y=\"0\"></use>\n <use xlink:href=\"#E13-MJMAIN-6E\" x=\"1612\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E13-MJMAIN-2E\" x=\"13659\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>Therefore, the area of the square decreases at a rate of <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"12.419ex\" height=\"3.009ex\" style=\"vertical-align: -0.838ex;\" viewBox=\"0 -934.9 5347.1 1295.7\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-14-Title\">\n<title id=\"MathJax-SVG-14-Title\"> 40\\,\\text{cm}^2/\\text{min}.</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E14-MJMAIN-34\" d=\"M462 0Q444 3 333 3Q217 3 199 0H190V46H221Q241 46 248 46T265 48T279 53T286 61Q287 63 287 115V165H28V211L179 442Q332 674 334 675Q336 67