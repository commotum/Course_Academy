              "captured_at": 1791997850.3290045,
              "source_sha256": "9a478718207201c2cde5b116063ba2688da395e412d920ac5181a5cdeda71c93",
              "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/browser-originals/9a478718207201c2cde5b116063ba2688da395e412d920ac5181a5cdeda71c93.html",
              "status": 200,
              "headers": {
                "date": "Wed, 14 Oct 2026 17:10:50 GMT",
