              "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:35px;\n                                        margin-left:4px;\n                                        margin-right:2px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"69\"><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"71\"><span class=\"mq-numerator\" mathquill-block-id=\"73\"><span mathquill-command-id=\"72\">7</span></span><span class=\"mq-denominator\" mathquill-block-id=\"75\"><span mathquill-command-id=\"74\">5</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
