          "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14210206/observations/step-t478-7fa6ae06b623a383b9d2.html",
          "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14210206/observations/step-t478-7fa6ae06b623a383b9d2.png",
          "source_url": "https://mathacademy.com/tasks/14210206/topics/368/lesson",
          "captured_at": 1791997864.5299373,
          "math_academy_id": "478",
