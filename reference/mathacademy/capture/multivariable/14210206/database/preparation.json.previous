                  "option": "a",
                  "dom_id": "questionWidget-choiceLetterCircle-116049-a",
                  "type": "math",
                  "value": "8\\text{ feet}/\\text{hour}",
                  "html": "<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"202\" style=\"font-size: 119.6%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c38\"></mjx-c></mjx-mn><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-cA0\"></mjx-c><mjx-c class=\"mjx-c66\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c65\"></mjx-c><mjx-c class=\"mjx-c74\"></mjx-c></mjx-mtext><mjx-texatom texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2F\"></mjx-c></mjx-mo></mjx-texatom><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c68\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c75\"></mjx-c><mjx-c class=\"mjx-c72\"></mjx-c></mjx-mtext></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mtext>&nbsp;feet</mtext><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mtext>hour</mtext></math></mjx-assistive-mml></mjx-container>"
