        "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14210206/observations/lesson-step-892-62341e45acd517b6495c.html",
        "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14210206/observations/lesson-step-892-62341e45acd517b6495c.png",
