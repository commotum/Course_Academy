4T251 0Q249 0 239 0T205 1T141 2Q70 2 50 0H42Q35 7 35 11Q37 38 48 46H62Q132 49 164 96Q170 102 345 401T523 704Q530 716 547 716H555H572Q578 707 578 706L606 383Q634 60 636 57Q641 46 701 46Q726 46 726 36Q726 34 723 22Q720 7 718 4T704 0Q701 0 690 0T651 1T578 2Q484 2 455 0H443Q437 6 437 9T439 27Q443 40 445 43L449 46H469Q523 49 533 63L521 213H283L249 155Q208 86 208 74ZM516 260Q516 271 504 416T490 562L463 519Q447 492 400 412L310 260L413 259Q516 259 516 260Z\" id=\"E5-MJMATHI-41\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E5-MJMATHI-41\" y=\"0\"></use>\n</g>\n</svg></span> of a square is given by <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-6-Title\" focusable=\"false\" height=\"2.509ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -934.9 3389.5 1080.4\" width=\"7.872ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-6-Title\">A = x^2.</title>\n<defs aria-hidden=\"true\">\n<path d=\"M208 74Q208 50 254 46Q272 46 272 35Q272 34 270 22Q267 8 264 4T251 0Q249 0 239 0T205 1T141 2Q70 2 50 0H42Q35 7 35 11Q37 38 48 46H62Q132 49 164 96Q170 102 345 401T523 704Q530 716 547 716H555H572Q578 707 578 706L606 383Q634 60 636 57Q641 46 701 46Q726 46 726 36Q726 34 723 22Q720 7 718 4T704 0Q701 0 690 0T651 1T578 2Q484 2 455 0H443Q437 6 437 9T439 27Q443 40 445 43L449 46H469Q523 49 533 63L521 213H283L249 155Q208 86 208 74ZM516 260Q516 271 504 416T490 562L463 519Q447 492 400 412L310 260L413 259Q516 259 516 260Z\" id=\"E6-MJMATHI-41\" stroke-width=\"1\"></path>\n<path d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\" id=\"E6-MJMAIN-3D\" stroke-width=\"1\"></path>\n<path d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40Q91 39 97 36T113 29T132 26Q168 26 194 71Q203 87 217 139T245 247T261 313Q266 340 266 352Q266 380 251 392T217 404Q177 404 142 372T93 290Q91 281 88 280T72 278H58Q52 284 52 289Z\" id=\"E6-MJMATHI-78\" stroke-width=\"1\"></path>\n<path d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\" id=\"E6-MJMAIN-32\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E6-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E6-MJMATHI-41\" y=\"0\"></use>\n<use x=\"1028\" xlink:href=\"#E6-MJMAIN-3D\" y=\"0\"></use>\n<g transform=\"translate(2084,0)\">\n<use x=\"0\" xlink:href=\"#E6-MJMATHI-78\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"809\" xlink:href=\"#E6-MJMAIN-32\" y=\"513\"></use>\n</g>\n<use x=\"3110\" xlink:href=\"#E6-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span> So, since <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-7-Title\" focusable=\"false\" height=\"5.676ex\" role=\"img\" style=\"vertical-align: -1.838ex;\" viewbox=\"0 -1652.5 4029.4 2443.8\" width=\"9.359ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-7-Title\">x^2 = \\dfrac{h^2}{2},</title>\n<defs aria-hidden=\"true\">\n<path d=\"M52 289Q59 331 106 386T222 442Q257 442 286 424T329 379Q371 442 430 442Q467 442 494 420T522 361Q522 332 508 314T481 292T458 288Q439 288 427 299T415 328Q415 374 465 391Q454 404 425 404Q412 404 406 402Q368 386 350 336Q290 115 290 78Q290 50 306 38T341 26Q378 26 414 59T463 140Q466 150 469 151T485 153H489Q504 153 504 145Q504 144 502 134Q486 77 440 33T333 -11Q263 -11 227 52Q186 -10 133 -10H127Q78 -10 57 16T35 71Q35 103 54 123T99 143Q142 143 142 101Q142 81 130 66T107 46T94 41L91 40Q91 39 97 36T113 29T132 26Q168 26 194 71Q203 87 217 139T245 247T261 313Q266 340 266 352Q266 380 251 392T217 404Q177 404 142 372T93 290Q91 281 88 280T72 278H58Q52 284 52 289Z\" id=\"E7-MJMATHI-78\" stroke-width=\"1\"></path>\n<path d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\" id=\"E7-MJMAIN-32\" stroke-width=\"1\"></path>\n<path d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\" id=\"E7-MJMAIN-3D\" stroke-width=\"1\"></path>\n<path d=\"M137 683Q138 683 209 688T282 694Q294 694 294 685Q294 674 258 534Q220 386 220 383Q220 381 227 388Q288 442 357 442Q411 442 444 415T478 336Q478 285 440 178T402 50Q403 36 407 31T422 26Q450 26 474 56T513 138Q516 149 519 151T535 153Q555 153 555 145Q555 144 551 130Q535 71 500 33Q466 -10 419 -10H414Q367 -10 346 17T325 74Q325 90 361 192T398 345Q398 404 354 404H349Q266 404 205 306L198 293L164 158Q132 28 127 16Q114 -11 83 -11Q69 -11 59 -2T48 16Q48 30 121 320L195 616Q195 629 188 632T149 637H128Q122 643 122 645T124 664Q129 683 137 683Z\" id=\"E7-MJMATHI-68\" stroke-width=\"1\"></path>\n<path d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\" id=\"E7-MJMAIN-2C\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E7-MJMATHI-78\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"809\" xlink:href=\"#E7-MJMAIN-32\" y=\"513\"></use>\n<use x=\"1304\" xlink:href=\"#E7-MJMAIN-3D\" y=\"0\"></use>\n<g transform=\"translate(2360,0)\">\n<g transform=\"translate(120,0)\">\n<rect height=\"60\" stroke=\"none\" width=\"1150\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n<use x=\"0\" xlink:href=\"#E7-MJMATHI-68\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"815\" xlink:href=\"#E7-MJMAIN-32\" y=\"513\"></use>\n</g>\n<use x=\"324\" xlink:href=\"#E7-MJMAIN-32\" y=\"-687\"></use>\n</g>\n</g>\n<use x=\"3750\" xlink:href=\"#E7-MJMAIN-2C\" y=\"0\"></use>\n</g>\n</svg></span> we have</p>\n<p><span class=\"mjpage mjpage__block\"><svg aria-labelledby=\"MathJax-SVG-8-Title\" focusable=\"false\" height=\"5.676ex\" role=\"img\" style=\"vertical-align: -1.838ex;\" viewbox=\"0 -1652.5 3753.5 2443.8\" width=\"8.718ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-8-Title\">\nA = \\dfrac{h^2}{2}.\n</title>\n<defs aria-hidden=\"true\">\n<path d=\"M208 74Q208 50 254 46Q272 46 272 35Q272 34 270 22Q267 8 264 4T251 0Q249 0 239 0T205 1T141 2Q70 2 50 0H42Q35 7 35 11Q37 38 48 46H62Q132 49 164 96Q170 102 345 401T523 704Q530 716 547 716H555H572Q578 707 578 706L606 383Q634 60 636 57Q641 46 701 46Q726 46 726 36Q726 34 723 22Q720 7 718 4T704 0Q701 0 690 0T651 1T578 2Q484 2 455 0H443Q437 6 437 9T439 27Q443 40 445 43L449 46H469Q523 49 533 63L521 213H283L249 155Q208 86 208 74ZM516 260Q516 271 504 416T490 562L463 519Q447 492 400 412L310 260L413 259Q516 259 516 260Z\" id=\"E8-MJMATHI-41\" stroke-width=\"1\"></path>\n<path d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\" id=\"E8-MJMAIN-3D\" stroke-width=\"1\"></path>\n<path d=\"M137 683Q138 683 209 688T282 694Q294 694 294 685Q294 674 258 534Q220 386 220 383Q220 381 227 388Q288 442 357 442Q411 442 444 415T478 336Q478 285 440 178T402 50Q403 36 407 31T422 26Q450 26 474 56T513 138Q516 149 519 151T535 153Q555 153 555 145Q555 144 551 130Q535 71 500 33Q466 -10 419 -10H414Q367 -10 346 17T325 74Q325 90 361 192T398 345Q398 404 354 404H349Q266 404 205 306L198 293L164 158Q132 28 127 16Q114 -11 83 -11Q69 -11 59 -2T48 16Q48 30 121 320L195 616Q195 629 188 632T149 637H128Q122 643 122 645T124 664Q129 683 137 683Z\" id=\"E8-MJMATHI-68\" stroke-width=\"1\"></path>\n<path d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\" id=\"E8-MJMAIN-32\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E8-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E8-MJMATHI-41\" y=\"0\"></use>\n<use x=\"1028\" xlink:href=\"#E8-MJMAIN-3D\" y=\"0\"></use>\n<g transform=\"translate(2084,0)\">\n<g transform=\"translate(120,0)\">\n<rect height=\"60\" stroke=\"none\" width=\"1150\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n<use x=\"0\" xlink:href=\"#E8-MJMATHI-68\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"815\" xlink:href=\"#E8-MJMAIN-32\" y=\"513\"></use>\n</g>\n<use x=\"324\" xlink:href=\"#E8-MJMAIN-32\" y=\"-687\"></use>\n</g>\n</g>\n<use x=\"3474\" xlink:href=\"#E8-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>This formula will prove particularly handy in the next example.</p>\n</div>"
        },
        {
          "math_academy_id": 895,
          "type": "example",
          "content_id": 221,
          "title": "Relating the Rate of Change of a Diagonal Length to Another Rate of Change",
          "position": 4,
          "dom_id": "step-895",
          "html": "<div class=\"step\" contentid=\"221\" id=\"step-895\" stepid=\"895\" steptype=\"example\" style=\"display: block\">\n<div class=\"stepHeader\">\n<div class=\"stepName\">\n                    Example: \n                    <a class=\"stepAnchor\" id=\"stepAnchor-895\" name=\"step-9\" style=\"font-weight: normal;\">Relating the Rate of Change of a Diagonal Length to Another Rate of Change</a>\n</div>\n<div class=\"helpButton\" stepid=\"895\">?</div>\n</div>\n<div class=\"exampleQuestion\">\n<p>The sides of a square are increasing. At a particular moment, the rate of increase of the area of the square is numerically equal to twice the rate of increase of the diagonal. What is the area of the square at that moment?</p>\n</div>\n<div class=\"explanationHeader\">EXPLANATION</div>\n<div class=\"exampleExplanation\">\n<style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direction: ltr;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            border: 0;\n                            padding: 0;\n                            margin: 0\n                            }\n\n                            .mjpage * {\n                            transition: none;\n                            -webkit-transition: none;\n                            -moz-transition: none;\n                            -ms-transition: none;\n                            -o-transition: none\n                            }\n\n                            .mjx-svg-href {\n                            fill: blue;\n                            stroke: blue\n                            }\n\n                            .MathJax_SVG_LineBox {\n                            display: table!important\n                            }\n\n                            .MathJax_SVG_LineBox span {\n                            display: table-cell!important;\n                            width: 10000em!important;\n                            min-width: 0;\n                            max-width: none;\n                            padding: 0;\n                            border: 0;\n                            margin: 0\n                            }\n\n                            .mjpage__block {\n                            text-align: center;\n                            margin: 1em 0em;\n                            position: relative;\n                            display: block!important;\n                            text-indent: 0;\n                            max-width: none;\n                            max-height: none;\n                            min-width: 0;\n                            min-height: 0;\n                            width: 100%\n                            }</style><p>Let <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-1-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 750.5 936.9\" width=\"1.743ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-1-Title\">A</title>\n<defs aria-hidden=\"true\">\n<path d=\"M208 74Q208 50 254 46Q272 46 272 35Q272 34 270 22Q267 8 264 4T251 0Q249 0 239 0T205 1T141 2Q70 2 50 0H42Q35 7 35 11Q37 38 48 46H62Q132 49 164 96Q170 102 345 401T523 704Q530 716 547 716H555H572Q578 707 578 706L606 383Q634 60 636 57Q641 46 701 46Q726 46 726 36Q726 34 723 22Q720 7 718 4T704 0Q701 0 690 0T651 1T578 2Q484 2 455 0H443Q437 6 437 9T439 27Q443 40 445 43L449 46H469Q523 49 533 63L521 213H283L249 155Q208 86 208 74ZM516 260Q516 271 504 416T490 562L463 519Q447 492 400 412L310 260L413 259Q516 259 516 260Z\" id=\"E1-MJMATHI-41\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E1-MJMATHI-41\" y=\"0\"></use>\n</g>\n</svg></span> be the area of the square, and <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-2-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 576.5 936.9\" width=\"1.339ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-2-Title\">h</title>\n<defs aria-hidden=\"true\">\n<path d=\"M137 683Q138 683 209 688T282 694Q294 694 294 685Q294 674 258 534Q220 386 220 383Q220 381 227 388Q288 442 357 442Q411 442 444 415T478 336Q478 285 440 178T402 50Q403 36 407 31T422 26Q450 26 474 56T513 138Q516 149 519 151T535 153Q555 153 555 145Q555 144 551 130Q535 71 500 33Q466 -10 419 -10H414Q367 -10 346 17T325 74Q325 90 361 192T398 345Q398 404 354 404H349Q266 404 205 306L198 293L164 158Q132 28 127 16Q114 -11 83 -11Q69 -11 59 -2T48 16Q48 30 121 320L195 616Q195 629 188 632T149 637H128Q122 643 122 645T124 664Q129 683 137 683Z\" id=\"E2-MJMATHI-68\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E2-MJMATHI-68\" y=\"0\"></use>\n</g>\n</svg></span> be the length of the diagonal. The relationship between <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-3-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 750.5 936.9\" width=\"1.743ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-3-Title\">A</title>\n<defs aria-hidden=\"true\">\n<path d=\"M208 74Q208 50 254 46Q272 46 272 35Q272 34 270 22Q267 8 264 4T251 0Q249 0 239 0T205 1T141 2Q70 2 50 0H42Q35 7 35 11Q37 38 48 46H62Q132 49 164 96Q170 102 345 401T523 704Q530 716 547 716H555H572Q578 707 578 706L606 383Q634 60 636 57Q641 46 701 46Q726 46 726 36Q726 34 723 22Q720 7 718 4T704 0Q701 0 690 0T651 1T578 2Q484 2 455 0H443Q437 6 437 9T439 27Q443 40 445 43L449 46H469Q523 49 533 63L521 213H283L249 155Q208 86 208 74ZM516 260Q516 271 504 416T490 562L463 519Q447 492 400 412L310 260L413 259Q516 259 516 260Z\" id=\"E3-MJMATHI-41\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E3-MJMATHI-41\" y=\"0\"></use>\n</g>\n</svg></span> and <span class=\"mjpage\"><svg aria-labelledby=\"MathJax-SVG-4-Title\" focusable=\"false\" height=\"2.176ex\" role=\"img\" style=\"vertical-align: -0.338ex;\" viewbox=\"0 -791.3 576.5 936.9\" width=\"1.339ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-4-Title\">h</title>\n<defs aria-hidden=\"true\">\n<path d=\"M137 683Q138 683 209 688T282 694Q294 694 294 685Q294 674 258 534Q220 386 220 383Q220 381 227 388Q288 442 357 442Q411 442 444 415T478 336Q478 285 440 178T402 50Q403 36 407 31T422 26Q450 26 474 56T513 138Q516 149 519 151T535 153Q555 153 555 145Q555 144 551 130Q535 71 500 33Q466 -10 419 -10H414Q367 -10 346 17T325 74Q325 90 361 192T398 345Q398 404 354 404H349Q266 404 205 306L198 293L164 158Q132 28 127 16Q114 -11 83 -11Q69 -11 59 -2T48 16Q48 30 121 320L195 616Q195 629 188 632T149 637H128Q122 643 122 645T124 664Q129 683 137 683Z\" id=\"E4-MJMATHI-68\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E4-MJMATHI-68\" y=\"0\"></use>\n</g>\n</svg></span> is</p>\n<p><span class=\"mjpage mjpage__block\"><svg aria-labelledby=\"MathJax-SVG-5-Title\" focusable=\"false\" height=\"5.676ex\" role=\"img\" style=\"vertical-align: -1.838ex;\" viewbox=\"0 -1652.5 3753.5 2443.8\" width=\"8.718ex\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<title id=\"MathJax-SVG-5-Title\">\nA = \\dfrac{h^2}{2}.\n</title>\n<defs aria-hidden=\"true\">\n<path d=\"M208 74Q208 50 254 46Q272 46 272 35Q272 34 270 22Q267 8 264 4T251 0Q249 0 239 0T205 1T141 2Q70 2 50 0H42Q35 7 35 11Q37 38 48 46H62Q132 49 164 96Q170 102 345 401T523 704Q530 716 547 716H555H572Q578 707 578 706L606 383Q634 60 636 57Q641 46 701 46Q726 46 726 36Q726 34 723 22Q720 7 718 4T704 0Q701 0 690 0T651 1T578 2Q484 2 455 0H443Q437 6 437 9T439 27Q443 40 445 43L449 46H469Q523 49 533 63L521 213H283L249 155Q208 86 208 74ZM516 260Q516 271 504 416T490 562L463 519Q447 492 400 412L310 260L413 259Q516 259 516 260Z\" id=\"E5-MJMATHI-41\" stroke-width=\"1\"></path>\n<path d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\" id=\"E5-MJMAIN-3D\" stroke-width=\"1\"></path>\n<path d=\"M137 683Q138 683 209 688T282 694Q294 694 294 685Q294 674 258 534Q220 386 220 383Q220 381 227 388Q288 442 357 442Q411 442 444 415T478 336Q478 285 440 178T402 50Q403 36 407 31T422 26Q450 26 474 56T513 138Q516 149 519 151T535 153Q555 153 555 145Q555 144 551 130Q535 71 500 33Q466 -10 419 -10H414Q367 -10 346 17T325 74Q325 90 361 192T398 345Q398 404 354 404H349Q266 404 205 306L198 293L164 158Q132 28 127 16Q114 -11 83 -11Q69 -11 59 -2T48 16Q48 30 121 320L195 616Q195 629 188 632T149 637H128Q122 643 122 645T124 664Q129 683 137 683Z\" id=\"E5-MJMATHI-68\" stroke-width=\"1\"></path>\n<path d=\"M109 429Q82 429 66 447T50 491Q50 562 103 614T235 666Q326 666 387 610T449 465Q449 422 429 383T381 315T301 241Q265 210 201 149L142 93L218 92Q375 92 385 97Q392 99 409 186V189H449V186Q448 183 436 95T421 3V0H50V19V31Q50 38 56 46T86 81Q115 113 136 137Q145 147 170 174T204 211T233 244T261 278T284 308T305 340T320 369T333 401T340 431T343 464Q343 527 309 573T212 619Q179 619 154 602T119 569T109 550Q109 549 114 549Q132 549 151 535T170 489Q170 464 154 447T109 429Z\" id=\"E5-MJMAIN-32\" stroke-width=\"1\"></path>\n<path d=\"M78 60Q78 84 95 102T138 120Q162 120 180 104T199 61Q199 36 182 18T139 0T96 17T78 60Z\" id=\"E5-MJMAIN-2E\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E5-MJMATHI-41\" y=\"0\"></use>\n<use x=\"1028\" xlink:href=\"#E5-MJMAIN-3D\" y=\"0\"></use>\n<g transform=\"translate(2084,0)\">\n<g transform=\"translate(120,0)\">\n<rect height=\"60\" stroke=\"none\" width=\"1150\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n<use x=\"0\" xlink:href=\"#E5-MJMATHI-68\" y=\"0\"></use>\n<use transform=\"scale(0.707)\" x=\"815\" xlink:href=\"#E5-MJMAIN-32\" y=\"513\"></use>\n</g>\n<use x=\"324\" xlink:href=\"#E5-MJMAIN-32\" y=\"-687\"></use>\n</g>\n</g>\n<use x=\"3474\" xlink:href=\"#E5-MJMAIN-2E\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>Using implicit differentiation and the chain rule, we get</p>\n<p><span class=\"mjpage mjpage__block\"><svg aria-labelledby=\"MathJax-SVG-6-Title\" focusable=\"false\" height=\"20.509ex\" role=\"img\" st