              "choices": [],
              "dom_index": 0,
              "disabled": false,
              "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:35px;\n                                        margin-left:2px;\n                                        margin-right:4px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"37\"><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"39\"><span class=\"mq-numerator\" mathquill-block-id=\"41\"><span mathquill-command-id=\"40\">1</span><span mathquill-command-id=\"42\">0</span></span><span class=\"mq-denominator\" mathquill-block-id=\"45\"><var mathquill-command-id=\"44\">x</var></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
              "rendered_text": "10x​",
