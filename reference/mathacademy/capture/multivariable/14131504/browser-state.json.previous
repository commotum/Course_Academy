    "q-335515": {
      "dom_id": "step-q335515",
      "name": "Question 5",
      "problem": "A system of ODEs has an unstable saddle point at ${x}^{∗}.$ The system is then shifted using $u=x-{x}^{∗}.$ Which of the following best describes the point $(0,0)$ for the shifted system?",
      "worked_solution": "Shifting does not alter the local behavior near an equilibrium. So, the equilibrium retains its original classification (saddle, node, spiral, center, etc.).\n\nRecall that the shift moves the equilibrium to the origin.\n\nThus, the equilibrium at $(0,0)$ in the shifted system has the same classification as ${x}^{∗}$ in the original system.\n\nTherefore, the correct answer is \"An unstable saddle point\".",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-335515-a",
              "type": "text",
              "value": "An asymptotically stable spiral sink",
              "html": "An asymptotically stable spiral sink"
            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-335515-b",
              "type": "text",
              "value": "A stable center",
              "html": "A stable center"
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-335515-c",
              "type": "text",
              "value": "An asymptotically stable sink (stable node)",
              "html": "An asymptotically stable sink (stable node)"
            },
            {
              "option": "d",
              "dom_id": "questionWidget-choiceLetterCircle-335515-d",
              "type": "text",
              "value": "An unstable spiral source",
              "html": "An unstable spiral source"
            },
            {
              "option": "e",
              "dom_id": "questionWidget-choiceLetterCircle-335515-e",
              "type": "text",
              "value": "An unstable saddle point",
              "html": "An unstable saddle point"
            }
          ],
          "choices_complete": true
        }
      ],
      "problem_field_keys": [],
