#{[{:activity/course {:db/id #edb/ref 17592186046669} :activity/first-step {:db/id #edb/ref 17592186559959} :activity/id #uuid "50c42498-d1ce-5a54-97b7-c0af9956a7d8" :activity/scope {:db/id #edb/ref 17592186050148 :topic/id #uuid "30d88a85-9b00-5b6d-90cc-41ac3f6c9da8" :topic/math-academy-id 1808} :activity/steps [{:db/id #edb/ref 17592186559904 :step/content {:db/id #edb/ref 17592186559858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40fa63da-8d25-5d94-97fe-f363984d351a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-24,4,6)" :db/id #edb/ref 17592186559182} {:answer/id #uuid "54bfb8e5-1bc3-55dc-b6bb-ca377e8ee977" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186559232} {:answer/id #uuid "a0e9bf2c-81b2-536b-98ec-2dd8b4e53ea4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,1,6)" :db/id #edb/ref 17592186559423} {:answer/id #uuid "abe12585-4813-5617-a74b-afa58fdb9f12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,1,6)" :db/id #edb/ref 17592186559447} {:answer/id #uuid "b300f230-78be-5357-879b-21a0f3bf43a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,6,0)" :db/id #edb/ref 17592186559462}] :answer-field/correct {:db/id #edb/ref 17592186559232} :answer-field/id #uuid "fff9c6a5-d7fa-5ed1-9590-bb662eb6e249" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559771}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c9dd16b9-4054-5136-a332-5517b98207e0" :question/math-academy-id "q-33977" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨4,1,6⟩+t⟨2,6,0⟩,\\,Π:r\\cdot ⟨-24,8,6⟩=-32.\n$$" :question/worked-solution "Let's write the equation of the line as\n\n$$\nr=⟨4+2t,1+6t,6⟩.\n$$\n\nNow, substituting $r=⟨4+2t,1+6t,6⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-24,8,6⟩ & =-32 \\\\ ⟨4+2t,1+6t,6⟩\\cdot ⟨-24,8,6⟩ & =-32 \\\\ -24(4+2t)+8(1+6t)+6\\cdot 6 & =-32 \\\\ -96-48t+8+48t+36 & =-32 \\\\ -52 & =-32.\\end{aligned}\n$$\n\nThe equation has no solution. Therefore, we conclude that the line $l$ and the plane $Π$ do not intersect."} :step/id #uuid "17f1e51d-aa7f-5439-b877-0e6bb77db4bf" :step/next {:db/id #edb/ref 17592186559948}} {:db/id #edb/ref 17592186559913 :step/content {:db/id #edb/ref 17592186484201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20fc86f8-0368-54eb-a3e0-3cf6b0379332" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-16,-16,13)" :db/id #edb/ref 17592186483621} {:answer/id #uuid "2143e54b-67d5-5002-957a-3bf88c230ca4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(24,-11,11)" :db/id #edb/ref 17592186483624} {:answer/id #uuid "257b548a-b52d-5b2d-8a2f-57d74b50d39c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186483630} {:answer/id #uuid "7944f3e7-3b31-5e5a-b5cb-a1562208eb42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(11,-13,11)" :db/id #edb/ref 17592186483813} {:answer/id #uuid "a0a4f2b9-c6e0-5e67-8ab6-66d592472d45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(26,12,12)" :db/id #edb/ref 17592186483899}] :answer-field/correct {:db/id #edb/ref 17592186483621} :answer-field/id #uuid "15f90597-4c03-5ae4-b2c2-f42eae091087" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484091}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "12b4f5c6-720f-5c2c-b1e8-295eb7dcb29c" :question/math-academy-id "q-73991" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\left\\{\\begin{aligned}x &=-2-2t \\\\ y &=5-3t \\\\ z &=-1+2t\\end{aligned}\\right.\\,\\text{and}\\,Π:3x-2y+6z=62.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}3x-2y+6z & =62 \\\\ 3(-2-2t)-2(5-3t)+6(-1+2t) & =62 \\\\ -6-6t-10+6t-6+12t & =62 \\\\ 12t & =84 \\\\ t & =7\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=6$ into the parametric equations of the line:\n\n$$\n\\left\\{\\begin{aligned}x &=-2-2(7)=-16 \\\\ y &=5-3(7)=-16 \\\\ z &=-1+2(7)=13\\end{aligned}\\right.\n$$\n\nSo, the intersection point is $P(-16,-16,13).$"} :step/id #uuid "2c8a2fa0-140a-5e16-9bdf-6e1de01aec40" :step/next {:db/id #edb/ref 17592186559974}} {:db/id #edb/ref 17592186559948 :step/content {:db/id #edb/ref 17592186402256 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee24fdf4-e1ee-5f88-bc78-1cd69107c3af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,4,2)" :db/id #edb/ref 17592186402258} {:answer/id #uuid "3cff9213-8332-5106-9a38-96d7ec4a4378" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9,5,3)" :db/id #edb/ref 17592186402259} {:answer/id #uuid "9d7ebdfb-49aa-56f4-a0ad-f4d48aa68b14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,5,9)" :db/id #edb/ref 17592186402260} {:answer/id #uuid "6adfa3c5-c5cd-56cd-841d-1fd0fc016077" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,-1,6)" :db/id #edb/ref 17592186402261} {:answer/id #uuid "cd22fb61-25ce-5f17-bad1-fbd4ce2f0694" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186402262}] :answer-field/correct {:db/id #edb/ref 17592186402262} :answer-field/id #uuid "f9e05243-350c-5a1d-ad1e-5c71c37318cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402257}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cbfd2820-3a30-53a2-832d-407032fe3cf1" :question/math-academy-id "q-33987" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨3,5,9⟩+t⟨4,-1,6⟩,\\,Π:-2x+4y+2z-16=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨3+4t,5-t,9+6t⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}-2x+4y+2z-16 & =0 \\\\ -2x+4y+2z & =16 \\\\ ⟨x,y,z⟩\\cdot ⟨-2,4,2⟩ & =16 \\\\ r\\cdot ⟨-2,4,2⟩ & =16\\end{aligned}\n$$\n\nNow, substituting $r=⟨3+4t,5-t,9+6t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-2,4,2⟩ & =16 \\\\ ⟨3+4t,5-t,9+6t⟩\\cdot ⟨-2,4,2⟩ & =16 \\\\ -2(3+4t)+4(5-t)+2(9+6t) & =16 \\\\ -6-8t+20-4t+18+12t & =16 \\\\ 32 & =16.\\end{aligned}\n$$\n\nThe equation has no solution. Therefore, we conclude that the line $l$ and the plane $Π$ do not intersect."} :step/id #uuid "85bcb97e-37af-5ca8-9d58-81d4ae0c6fbe" :step/next {:db/id #edb/ref 17592186559913}} {:db/id #edb/ref 17592186559959 :step/content {:db/id #edb/ref 17592186304971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ccad579-7ffd-5028-82c9-8be517c44ccf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,8,2)" :db/id #edb/ref 17592186303432} {:answer/id #uuid "c5a96f69-83dc-57ab-88b1-de0764e272b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,2,8)" :db/id #edb/ref 17592186303669} {:answer/id #uuid "dc88a9e0-a58d-507d-8dbf-f29575569623" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,4,4)" :db/id #edb/ref 17592186303833} {:answer/id #uuid "f8782171-7da4-599e-a483-393f0200a20e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,8,7)" :db/id #edb/ref 17592186304012} {:answer/id #uuid "f9f6c3e0-0705-5423-bdeb-301d579540f0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186304023}] :answer-field/correct {:db/id #edb/ref 17592186303432} :answer-field/id #uuid "a0993881-1ebc-59b3-9c71-cbd4dfde3c44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186304507}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c249fd8c-dcff-5201-89e1-bb6d2a206072" :question/math-academy-id "q-33201" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨3,0,-4⟩+t⟨2,4,3⟩,\\,Π:4x+3y+4z-60=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨3+2t,4t,-4+3t⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}4x+3y+4z-60 & =0 \\\\ 4x+3y+4z & =60 \\\\ ⟨x,y,z⟩\\cdot ⟨4,3,4⟩ & =60 \\\\ r\\cdot ⟨4,3,4⟩ & =60\\end{aligned}\n$$\n\nNow, substituting $r=⟨3+2t,4t,-4+3t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨4,3,4⟩ & =60 \\\\ ⟨3+2t,4t,-4+3t⟩\\cdot ⟨4,3,4⟩ & =60 \\\\ 4(3+2t)+3(4t)+4(-4+3t) & =60 \\\\ 12+8t+12t-16+12t & =60 \\\\ 32t & =64 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨3+2(2),4(2),-4+3(2)⟩ \\\\  & =⟨7,8,2⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(7,8,2).$"} :step/id #uuid "ae8d1bdd-e6e6-5260-8dba-9c55868390df" :step/next {:db/id #edb/ref 17592186559904}} {:db/id #edb/ref 17592186559974 :step/content {:db/id #edb/ref 17592186559813 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d0857e4-1338-5c7a-ad65-1684adcb89b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,-5,12)" :db/id #edb/ref 17592186559130} {:answer/id #uuid "2fdae745-6cbf-5dbe-bdd2-ea7547e9e300" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(10,9,1)" :db/id #edb/ref 17592186559139} {:answer/id #uuid "8cea1e50-21c3-5c40-9866-c7a6949c9931" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,6,8)" :db/id #edb/ref 17592186559371} {:answer/id #uuid "98765244-eaa1-58ef-9963-d3e5ae56d7ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,7,18)" :db/id #edb/ref 17592186559400} {:answer/id #uuid "df482e11-da20-5e10-9235-bb050ae6ebf4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186559566}] :answer-field/correct {:db/id #edb/ref 17592186559400} :answer-field/id #uuid "f4196ccd-0e24-51af-ad66-5ad460d2a7e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559763}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "63cc57b7-1fbb-5327-9f12-ff47fb613fec" :question/math-academy-id "q-73995" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\{\\begin{aligned}x=-3+t \\\\ y=-1+2t \\\\ z=2+4t\\end{aligned}\\,\\text{and}\\,Π:6x+4y+3z=88.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}6x+4y+3z & =88 \\\\ 6(-3+t)+4(-1+2t)+3(2+4t) & =88 \\\\ -18+6t-4+8t+6+12t & =88 \\\\ 26t & =104 \\\\ t & =4\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=4$ into the parametric equations of the line:\n\n$$\n\\{\\begin{aligned}x=-3+4=1 \\\\ y=-1+2(4)=7 \\\\ z=2+4(4)=18\\end{aligned}\n$$\n\nSo, the intersection point is $P(1,7,18).$"} :step/id #uuid "d89e8710-7753-5df9-a5a6-86101a7dcce9"}] :activity/title "The Intersection Between a Line and a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186559005}]}
