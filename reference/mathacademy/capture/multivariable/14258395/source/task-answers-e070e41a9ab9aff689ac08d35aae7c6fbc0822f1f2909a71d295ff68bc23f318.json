 false.</p>\n</blockquote>\n<p>Finally, we can make the following conclusion:</p>\n<blockquote>\n<p>Therefore, the theorem is vacuously true.</p>\n</blockquote>\n","topic":{"id":2815,"name":"Trivial and Vacuous Proofs"},"example":{"id":6948,"title":"Proving a Trivial or Vacuous Statement"},"group":{"id":32087,"calculator":"None"},"graphics":[],"selects":[{"options":["|x| \\lt 0","x \\in \\mathbb{Q}"],"margin":{"left":0,"right":0,"top":0,"bottom":0},"context":"mathJax","index":0,"id":6259,"sectionIndex":0,"answers":[{"selectedIndex":1,"correct":0},{"selectedIndex":0,"correct":1}],"correct":1,"selectedIndex":0,"correctIndex":0},{"options":["x \\in \\mathbb{Q}","|x| \\lt 0"],"margin":{"left":0,"right":0,"top":0,"bottom":0},"context":"mathJax","index":1,"id":6260,"sectionIndex":0,"answers":[{"selectedIndex":0,"correct":1}],"correct":1,"selectedIndex":0,"correctIndex":0},{"options":["antecedent","consequent"],"margin":{"left":4,"right":4,"top":0,"bottom":2},"context":"text","index":2,"id":6261,"sectionIndex":1,"answers":[{"selectedIndex":0,"correct":1}],"correct":1,"selectedIndex":0,"correctIndex":0},{"options":["$|x| \\lt 0$","$x \\in \\mathbb{Q}$"],"margin":{"left":4,"right":4,"top":0,"bottom":2},"context":"text","index":3,"id":6262,"sectionIndex":1,"answers":[{"selectedIndex":0,"correct":1}],"correct":1,"selectedIndex":0,"correctIndex":0},{"options":["false","true"],"margin":{"left":4,"right":2,"top":0,"bottom":2},"context":"text","index":4,"id":6263,"sectionIndex":1,"answers":[{"selectedIndex":0,"correct":1}],"correct":1,"selectedIndex":0,"correctIndex":0},{"options":["vacuously","trivially"],"margin":{"left":4,"right":4,"top":0,"bottom":2},"context":"text","index":5,"id":6264,"sectionIndex":2,"answers":[{"selectedIndex":0,"correct":1}],"correct":1,"selectedIndex":0,"correctIndex":0},{"options":["true","false"],"margin":{"left":4,"right":2,"top":0,"bottom":2},"context":"text","index":6,"id":6265,"sectionIndex":2,"answers":[{"selectedIndex":0,"correct":1}],"correct":1