xampleId":6951,"difficulty":2}},{"id":62339684,"studentId":57964,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":19293,"question":{"id":216033,"exampleId":6951,"difficulty":1}},{"id":62339728,"studentId":57964,"choices":null,"selectedChoice":2,"selectId":0,"correct":0,"timeElapsed":11952,"question":{"id":216056,"exampleId":6951,"difficulty":2}},{"id":62339761,"studentId":57964,"choices":null,"selectedChoice":1,"selectId":0,"correct":1,"timeElapsed":16461,"question":{"id":216321,"exampleId":6951,"difficulty":1}},{"id":62339930,"studentId":57964,"choices":null,"selectedChoice":null,"selectId":0,"correct":1,"timeElapsed":66213,"question":{"id":216190,"exampleId":6948,"difficulty":1}},{"id":62340170,"studentId":57964,"choices":null,"selectedChoice":null,"selectId":0,"correct":1,"timeElapsed":89727,"question":{"id":216317,"exampleId":6948,"difficulty":1}}],"completedStr":"Completed @ 7:58 AM","exampleAnswers":[{"id":6945,"number":1,"title":"Completing Trivial Statements","answers":[{"id":62339258,"created":"2026-10-16T07:51:52.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":14279,"number":1,"createdStr":"Fri, Oct 16th @ 7:51 AM","timeElapsedFormatted":"0:14","question":{"id":215828,"format":"MC","difficulty":1,"exampleId":6945,"text":"<p>Let $p\\in \\mathbb{Z}.$ Consider the following statement:</p>\n<p>$\\qquad$ If 3 is prime, then $\\_\\_\\_\\_\\_\\_.$</p>\n<p>Which of the following could be placed into the blank space above to create a statement whose proof is trivial?</p>\n<ol class=\"questionStatements\"><li>  $\\sqrt{3} $ is rational </li><li>  $3^2$ is composite </li><li>  $p$ is prime </li></ol>","choice1":"II only","choice2":"III only","choice3":"II and III only","choice4":"I only","choice5":"I and III only","freeAnswerChoice":" ","explanation":"<p>We say that an implication has a <em>trivial proof</em> if the consequent is always true:</p>\n<p>\\[\nP \\quad \\Rightarrow \\overbrace{{\\color{blue}Q}}^{\\textrm{Always true}}\n\\]</p>\n<p>It does not matter whether the antecedent is true or false.</p>\n<p>With that in mind, let&#39;s examine our consequents in turn.</p>\n<ul>\n<li><p>Statement I is always false. $\\:{\\color{red}\\times}$</p>\n</li>\n<li><p>Statement II is always true. $\\:{\\color{darkgreen}\\checkmark}$</p>\n</li>\n<li><p>Predicate III, defined for $p \\in \\mathbb{Z},$ is <em>not</em> always true. $\\:{\\color{red}\\times}$</p>\n</li>\n</ul>\n<p>Therefore, the correct answer is &quot;II only.&quot;</p>\n","topic":{"id":2815,"name":"Trivial and Vacuous Proofs"},"example":{"id":6945,"title":"Completing Trivial Statements"},"group":{"id":15078,"calculator":"None"},"graphics":[],"selects":[{"id":null,"number":null,"answers":[]}],"inputAnswers":[],"body":null,"taskId":14258395,"answer":{"id":62339258,"cread":"2026-10-16T07:51:52.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":14279},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62339297,"created":"2026-10-16T07:52:10.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":13851,"number":2,"createdStr":"Fri, Oct 16th @ 7:52 AM","timeElapsedFormatted":"0:14","question":{"id":216028,"format":"MC","difficulty":1,"exampleId":6945,"text":"<p>Let $x \\in \\mathbb{Q}.$ Consider the following statement:</p>\n<p>$\\qquad$ If $\\sqrt8 \\in \\mathbb Q,$ then $\\_\\_\\_\\_\\_\\_.$</p>\n<p>Which of the following could be placed into the blank space above to create a statement whose proof is trivial?</p>\n<ol class=\"questionStatements\"><li>  $2&lt;\\sqrt 8 &lt;3$ </li><li>  $x^3 &lt; 0$ </li><li>  $ 8^{-1}\\notin \\mathbb{Q}$ </li></ol>","choice1":"I only","choice2":"I and II only","choice3":"II only","choice4":"II and III only","choice5":"III only","freeAnswerChoice":" ","explanation":"<p>We say that an implication has a <em>trivial proof</em> if the consequent is always true:</p>\n<p>\\[\nP \\quad \\Rightarrow \\overbrace{{\\color{blue}Q}}^{\\textrm{Always true}}\n\\]</p>\n<p>It does not matter whether the antecedent is true or false.</p>\n<p>With that in mind, let&#39;s examine our consequents in turn.</p>\n<ul>\n<li><p>Statement I is always true. $\\:{\\color{darkgreen}\\checkmark}$</p>\n</li>\n<li><p>Predicate II, defined for $x \\in \\mathbb{Q},$ is <em>not</em> always true. $\\:{\\color{red}\\times}$</p>\n</li>\n<li><p>Statement III is always false. $\\:{\\color{red}\\times}$</p>\n</li>\n</ul>\n<p>Therefore, the correct answer is &quot;I only.&quot;</p>\n","topic":{"id":2815,"name":"Trivial and Vacuous Proofs"},"example":{"id":6945,"title":"Completing Trivial Statements"},"group":{"id":31929,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14258395,"answer":{"id":62339297,"cread":"2026-10-16T07:52:10.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":13851},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62339340,"created":"2026-10-16T07:52:29.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":14793,"number":3,"createdStr":"Fri, Oct 16th @ 7:52 AM","timeElapsedFormatted":"0:15","question":{"id":216026,"format":"MC","difficulty":1,"exampleId":6945,"text":"<p>Let $n \\in \\mathbb{Z}.$ Consider the following statement:</p>\n<p>$\\qquad$ If $\\dfrac1n = 0,$ then $\\_\\_\\_\\_\\_\\_.$</p>\n<p>Which of the following could be placed into the blank space above to create a statement whose proof is trivial?</p>\n<ol class=\"questionStatements\"><li>  $\\emptyset \\not\\subset \\mathbb{Z}$ </li><li>  $4n$ is even </li><li>  $n^2+1$ is prime </li></ol>","choice1":"II only","choice2":"III only","choice3":"II and III only","choice4":"I only","choice5":"I and II only","freeAnswerChoice":" ","explanation":"<p>We say that an implication has a <em>trivial proof</em> if the consequent is always true:</p>\n<p>\\[\nP \\quad \\Rightarrow \\overbrace{{\\color{blue}Q}}^{\\textrm{Always true}}\n\\]</p>\n<p>It does not matter whether the antecedent is true or false.</p>\n<p>With that in mind, let&#39;s examine our consequents in turn.</p>\n<ul>\n<li><p>Statement I is always false. $\\:{\\color{red}\\times}$</p>\n</li>\n<li><p>Predicate II, defined for $n \\in \\mathbb{Z},$ is always true. $\\:{\\color{darkgreen}\\checkmark}$</p>\n</li>\n<li><p>Predicate III, defined for $n \\in \\mathbb{Z},$ is <em>not</em> always true. $\\:{\\color{red}\\times}$</p>\n</li>\n</ul>\n<p>Therefore, the correct answer is &quot;II only.&quot;</p>\n","topic":{"id":2815,"name":"Trivial and Vacuous Proofs"},"example":{"id":6945,"title":"Completing Trivial Statements"},"group":{"id":31929,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14258395,"answer":{"id":62339340,"cread":"2026-10-16T07:52:29.000Z","choices":null,"correct":0,"selectedChoice":3,"freeResponse":null,"timeElapsed":14793},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62339407,"created":"2026-10-16T07:52:50.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":15121,"number":4,"createdStr":"Fri, Oct 16th @ 7:52 AM","timeElapsedFormatted":"0:15","question":{"id":80083,"format":"MC","difficulty":1,"exampleId":6945,"text":"<p>Let $n \\in \\mathbb{Z}.$ Consider the following statement:</p>\n<p>$\\qquad$ If $2$ is even, then $\\_\\_\\_\\_\\_\\_.$</p>\n<p>Which of the following could be placed into the blank space above to create a statement whose proof is trivial?</p>\n<ol class=\"questionStatements\"><li>  $3$ is odd </li><li>  $4$ is odd </li><li>  $n$ is odd </li></ol>","choice1":"I only","choice2":"I and III only","choice3":"II only","choice4":"III only","choice5":"II and III only","freeAnswerChoice":" ","explanation":"<p>We say that an implication has a <em>trivial proof</em> if the consequent is always true:</p>\n<p>\\[\nP \\quad \\Rightarrow \\overbrace{{\\color{blue}Q}}^{\\textrm{Always true}}\n\\]</p>\n<p>It does not matter whether the antecedent is true or false.</p>\n<p>With that in mind, let&#39;s examine our consequents in turn.</p>\n<ul>\n<li><p>Statement I is always true. $\\:{\\color{darkgreen}\\checkmark}$</p>\n</li>\n<li><p>Statement II is always false. $\\:{\\color{red}\\times}$</p>\n</li>\n<li><p>Predicate III, defined for $n \\in \\mathbb{Z},$ is <em>not</em> always true. $\\:{\\color{red}\\times}$</p>\n</li>\n</ul>\n<p>Therefore, the correct answer is &quot;I only.&quot;</p>\n","topic":{"id":2815,"name":"Trivial and Vacuous Proofs"},"example":{"id":6945,"title":"Completing Trivial Statements"},"group":{"id":15078,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14258395,"answer":{"id":62339407,"cread":"2026-10-16T07:52:50.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":15121},"graphic":false,"difficultyClass":"difficultyEasy","difficultySymbol":"E","rendered":true,"testMode":false}},{"id":62339456,"created":"2026-10-16T07:53:14.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":20818,"number":5,"createdStr":"Fri, Oct 16th @ 7:53 AM","timeElapsedFormatted":"0:21","question":{"id":216031,"format":"MC","difficulty":2,"exampleId":6945,"text":"<p>Let $x \\in \\mathbb{R}.$ Consider the following statement:</p>\n<p>$\\qquad$ If $|x| &gt; 2,$ then $\\_\\_\\_\\_\\_\\_.$</p>\n<p>Which of the following could be placed into the blank space above to create a statement whose proof is trivial?</p>\n<ol class=\"questionStatements\"><li>  $3+x^4 \\geq 1$ </li><li>  $\\sqrt{x}\\in\\mathbb{R}$ </li><li>  $\\dfrac34 &gt; \\dfrac 56$ </li></ol>","choice1":"I only","choice2":"II only","choice3":"III only","choice4":"I and III only","choice5":"II and III only","freeAnswerChoice":" ","explanation":"<p>We say that an implication has a <em>trivial proof</em> if the consequent is always true:</p>\n<p>\\[\nP \\quad \\Rightarrow \\overbrace{{\\color{blue}Q}}^{\\textrm{Always true}}\n\\]</p>\n<p>It does not matter whether the antecedent is true or false.</p>\n<p>With that in mind, let&#39;s examine our consequents in turn.</p>\n<ul>\n<li><p>Predicate I, defined for $x \\in \\mathbb{R},$ is always true. $\\:{\\color{darkgreen}\\checkmark}$</p>\n</li>\n<li><p>Predicate II, defined for $x \\in \\mathbb{R},$ is <em>not</em> always true. $\\:{\\color{red}\\times}$</p>\n</li>\n<li><p>Statement III is always false. $\\:{\\color{red}\\times}$</p>\n</li>\n</ul>\n<p>Therefore, the correct answer is &quot;I only.&quot;</p>\n","topic":{"id":2815,"name":"Trivial and Vacuous Proofs"},"example":{"id":6945,"title":"Completing Trivial Statements"},"group":{"id":31930,"calculator":"None"},"graphics":[],"selects":[],"inputAnswers":[],"body":null,"taskId":14258395,"answer":{"id":62339456,"cread":"2026-10-16T07:53:14.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":20818},"graphic":false,"difficultyClass":"difficultyModerate","difficultySymbol":"M","rendered":true,"testMode":false}}]},{"id":6951,"number":2,"title":"Completing Vacuous Statement","answers":[{"id":62339555,"created":"2026-10-16T07:53:50.000Z","choices":null,"correct":1,"selectedChoice":1,"freeResponse":null,"timeElapsed":19468,"number":6,"createdStr":"Fri, Oct 16th @ 7:53 AM","timeElapsedFormatted":"0:19","question":{"id":216055,"format":"MC","difficulty":2,"exampleId":6951,"text":"<p>Let $n \\in \\mathbb{N}.$ Consider the following statement:</p>\n<p>$\\qquad$ If $\\_\\_\\_\\_\\_\\_,$ then $n$ is prime. </p>\n<p>Which of the following could be placed into the blank space above to create a statement whose proof is vacuous?</p>\n<ol class=\"questionStatements\"><li>  $6n$ is prime </li><li>  $2n+1 $ is even </li><li>  $12$ is composite </li></ol>","choice1":"I and II only","choice2":"III only","choice3":"I and III o