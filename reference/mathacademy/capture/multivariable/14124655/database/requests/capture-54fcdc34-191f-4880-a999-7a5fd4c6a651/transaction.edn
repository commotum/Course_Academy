-b0ea-5074-bf03-9504e31e376b"] :db/ensure [:answer-field/validate]} {:db/id "answer-dff933a5-8e41-527a-86c1-89d0384248c7" :answer/id #uuid "dff933a5-8e41-527a-86c1-89d0384248c7" :answer/type :answer.type/math :answer/value "2t{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "answer-c8c78ef7-e815-5303-8ca1-91fade5a18ba" :answer/id #uuid "c8c78ef7-e815-5303-8ca1-91fade5a18ba" :answer/type :answer.type/math :answer/value "2t{e}^{t}" :db/ensure [:answer/validate]} {:db/id "answer-916951fe-d9e1-5790-967a-6b774b71b771" :answer/id #uuid "916951fe-d9e1-5790-967a-6b774b71b771" :answer/type :answer.type/math :answer/value "2{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "answer-83a03c22-b0ea-5074-bf03-9504e31e376b" :answer/id #uuid "83a03c22-b0ea-5074-bf03-9504e31e376b" :answer/type :answer.type/math :answer/value "t{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "answer-field-638c2f17-4597-5952-9fe9-dd882f69171d" :answer-field/id #uuid "638c2f17-4597-5952-9fe9-dd882f69171d" :answer-field/key "field-7" :answer-field/type :answer-field.type/select :answer-field/correct "answer-645d1841-589b-5f2c-855b-850c8aee2f36" :answer-field/choices ["answer-224da477-1c8f-5938-b87e-1e7e7ebbf8fb" "answer-fd8cba5b-2e88-5cc7-9b81-99edce6728a3" "answer-645d1841-589b-5f2c-855b-850c8aee2f36" "answer-be46147f-888e-537d-bdfc-07d3ee55a027"] :db/ensure [:answer-field/validate]} {:db/id "answer-224da477-1c8f-5938-b87e-1e7e7ebbf8fb" :answer/id #uuid "224da477-1c8f-5938-b87e-1e7e7ebbf8fb" :answer/type :answer.type/math :answer/value "-0.60" :db/ensure [:answer/validate]} {:db/id "answer-fd8cba5b-2e88-5cc7-9b81-99edce6728a3" :answer/id #uuid "fd8cba5b-2e88-5cc7-9b81-99edce6728a3" :answer/type :answer.type/math :answer/value "-1.09" :db/ensure [:answer/validate]} {:db/id "answer-645d1841-589b-5f2c-855b-850c8aee2f36" :answer/id #uuid "645d1841-589b-5f2c-855b-850c8aee2f36" :answer/type :answer.type/math :answer/value "0.60" :db/ensure [:answer/validate]} {:db/id "answer-be46147f-888e-537d-bdfc-07d3ee55a027" :answer/id #uuid "be46147f-888e-537d-bdfc-07d3ee55a027" :answer/type :answer.type/math :answer/value "1.09" :db/ensure [:answer/validate]} {:db/id "answer-field-7adbc8ed-eed3-5790-9d2d-6cc7f28de90b" :answer-field/id #uuid "7adbc8ed-eed3-5790-9d2d-6cc7f28de90b" :answer-field/key "field-8" :answer-field/type :answer-field.type/select :answer-field/correct "answer-b5757ce7-481d-5372-9669-ed7483ff56e1" :answer-field/choices ["answer-859bace1-4cb4-568f-bc44-b22bf4e34b2d" "answer-512f9374-ba46-50ea-9917-38cd826cb53c" "answer-b5757ce7-481d-5372-9669-ed7483ff56e1" "answer-88f68abb-ca0a-5075-ad94-8e70ea20ef91"] :db/ensure [:answer-field/validate]} {:db/id "answer-859bace1-4cb4-568f-bc44-b22bf4e34b2d" :answer/id #uuid "859bace1-4cb4-568f-bc44-b22bf4e34b2d" :answer/type :answer.type/math :answer/value "1.65" :db/ensure [:answer/validate]} {:db/id "answer-512f9374-ba46-50ea-9917-38cd826cb53c" :answer/id #uuid "512f9374-ba46-50ea-9917-38cd826cb53c" :answer/type :answer.type/math :answer/value "2.72" :db/ensure [:answer/validate]} {:db/id "answer-b5757ce7-481d-5372-9669-ed7483ff56e1" :answer/id #uuid "b5757ce7-481d-5372-9669-ed7483ff56e1" :answer/type :answer.type/math :answer/value "3.58" :db/ensure [:answer/validate]} {:db/id "answer-88f68abb-ca0a-5075-ad94-8e70ea20ef91" :answer/id #uuid "88f68abb-ca0a-5075-ad94-8e70ea20ef91" :answer/type :answer.type/math :answer/value "4.74" :db/ensure [:answer/validate]} {:db/id "question-6510dfcd-a99e-5730-8a08-a25b49094096" :question/id #uuid "6510dfcd-a99e-5730-8a08-a25b49094096" :question/math-academy-id "q-333674" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=3x(t) \\\\ {y}^{′}(t)=3y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. Select the correct options below regarding the given system.\n\n$\\,$ The equilibrium point (origin) is a \n{{field-1}}{{field-2}}\nnode." :question/worked-solution "The matrix of our system is\n\n$$\nA=[\\begin{aligned}3 & 0 \\\\ 0 & 3\\end{aligned}].\n$$\n\nNotice that:\n\n- Since the only (repeated) eigenvalue of $A$ is $\\lambda =3$ and it's positive, we have a $\\text{unstable}$ node.\n\n- Since $A$ is diagonal and has a repeated eigenvalue, there are infinitely many linearly independent eigenvectors. So, we have a $\\text{star}$ node.\n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/95/95bb5be106524711e86d2e1ff9cb21d61141c25eb0a2f8958b51c29791806ccc.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-52ba5050-79f5-5038-b180-5f46df5f54fd" "answer-field-3895b1d1-8fde-5e9c-8254-eb743b48b9d3"] :db/ensure [:question/validate]} {:db/id "answer-field-52ba5050-79f5-5038-b180-5f46df5f54fd" :answer-field/id #uuid "52ba5050-79f5-5038-b180-5f46df5f54fd" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-f8cc45aa-4540-5bbd-9f20-b56a06897950" :answer-field/choices ["answer-5f3f427d-a11c-5581-802d-503fcc0ff60b" "answer-f8cc45aa-4540-5bbd-9f20-b56a06897950"] :db/ensure [:answer-field/validate]} {:db/id "answer-5f3f427d-a11c-5581-802d-503fcc0ff60b" :answer/id #uuid "5f3f427d-a11c-5581-802d-503fcc0ff60b" :answer/type :answer.type/text :answer/value "stable" :db/ensure [:answer/validate]} {:db/id "answer-f8cc45aa-4540-5bbd-9f20-b56a06897950" :answer/id #uuid "f8cc45aa-4540-5bbd-9f20-b56a06897950" :answer/type :answer.type/text :answer/value "unstable" :db/ensure [:answer/validate]} {:db/id "answer-field-3895b1d1-8fde-5e9c-8254-eb743b48b9d3" :answer-field/id #uuid "3895b1d1-8fde-5e9c-8254-eb743b48b9d3" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-9bffdd4a-dba1-5509-8e3d-c18282eca373" :answer-field/choices ["answer-d5288d39-b196-5969-af50-0a4f38dc67d0" "answer-9bffdd4a-dba1-5509-8e3d-c18282eca373"] :db/ensure [:answer-field/validate]} {:db/id "answer-d5288d39-b196-5969-af50-0a4f38dc67d0" :answer/id #uuid "d5288d39-b196-5969-af50-0a4f38dc67d0" :answer/type :answer.type/text :answer/value "degenerate" :db/ensure [:answer/validate]} {:db/id "answer-9bffdd4a-dba1-5509-8e3d-c18282eca373" :answer/id #uuid "9bffdd4a-dba1-5509-8e3d-c18282eca373" :answer/type :answer.type/text :answer/value "star" :db/ensure [:answer/validate]} {:db/id 17592186391219 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-x(t)-y(t) \\\\ {y}^{′}(t)=x(t)-3y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above, where the system's matrix has repeated eigenvalue $\\lambda =-2$ of multiplicity two. Select the correct options below regarding the given system.\n\n$\\,$ The equilibrium point (origin) is a \n{{field-1}}{{field-2}}\nnode." :db/ensure [:question/validate]} {:db/id 17592186167240 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=x(t) \\\\ {y}^{′}(t)=y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. Select the correct options below regarding the given system.\n\n$\\,$ The equilibrium point (origin) is a \n{{field-1}}{{field-2}}\nnode." :db/ensure [:question/validate]} {:db/id 17592186308312 :answer-field/correct 17592186307345 :db/ensure [:answer-field/validate]} {:db/id 17592186307567 :answer-field/correct 17592186307413 :db/ensure [:answer-field/validate]} {:db/id 17592186391257 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-x(t) \\\\ {y}^{′}(t)=-y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. Select the correct options below regarding the given system.\n\n$\\,$ The equilibrium point (origin) is a \n{{field-1}}{{field-2}}\nnode." :db/ensure [:question/validate]} {:db/id "question-fc362b82-7598-58e4-b9cc-cf1f2a033f38" :question/id #uuid "fc362b82-7598-58e4-b9cc-cf1f2a033f38" :question/math-academy-id "q-333667" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-2x(t)+2y(t) \\\\ {y}^{′}(t)=-2y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above, where the system's matrix has only one eigenvalue. Select the correct options below regarding the given system.\n\n$\\,$ The equilibrium point (origin) is a \n{{field-1}}{{field-2}}\nnode." :question/worked-solution "The matrix of our system is\n\n$$\nA=[\\begin{aligned}-2 & 2 \\\\ 0 & -2\\end{aligned}].\n$$\n\nNotice that:\n\n- Since the only (repeated) eigenvalue of $A$ is $\\lambda =-2$ and it's negative, we have a $\\text{stable}$ node.\n\n- Since $A$ is not diagonal and has a repeated eigenvalue, there is only one linearly independent eigenvector. So, we have a $\\text{degenerate}$ node.\n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/94/94f722ae71911d6b6967e55922301e771753078302aef950e1215d1fead75289.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3007b7e8-b0aa-517c-b7ed-d47324656b6c" "answer-field-f63bded0-5eca-5ef0-8469-313f1af281d1"] :db/ensure [:question/validate]} {:db/id "answer-field-3007b7e8-b0aa-517c-b7ed-d47324656b6c" :answer-field/id #uuid "3007b7e8-b0aa-517c-b7ed-d47324656b6c" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-b15abd56-8ff1-5940-9908-64440b2f7303" :answer-field/choices ["answer-b15abd56-8ff1-5940-9908-64440b2f7303" "answer-f89e8a56-5742-5f30-a939-70f76c6deb0b"] :db/ensure [:answer-field/validate]} {:db/id "answer-b15abd56-8ff1-5940-9908-64440b2f7303" :answer/id #uuid "b15abd56-8ff1-5940-9908-64440b2f7303" :answer/type :answer.type/text :answer/value "stable" :db/ensure [:answer/validate]} {:db/id "answer-f89e8a56-5742-5f30-a939-70f76c6deb0b" :answer/id #uuid "f89e8a56-5742-5f30-a939-70f76c6deb0b" :answer/type :answer.type/text :answer/value "unstable" :db/ensure [:answer/validate]} {:db/id "answer-field-f63bded0-5eca-5ef0-8469-313f1af281d1" :answer-field/id #uuid "f63bded0-5eca-5ef0-8469-313f1af281d1" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-24e84d6a-bff5-5bb2-b795-aa9cf9834a3e" :answer-field/choices ["answer-24e84d6a-bff5-5bb2-b795-aa9cf9834a3e" "answer-0dead613-6310-5d03-ae0a-f9d87e3caec5"] :db/ensure [:answer-field/validate]} {:db/id "answer-24e84d6a-bff5-5bb2-b795-aa9cf9834a3e" :answer/id #uuid "24e84d6a-bff5-5bb2-b795-aa9cf9834a3e" :answer/type :answer.type/text :answer/value "degenerate" :db/ensure [:answer/validate]} {:db/id "answer-0dead613-6310-5d03-ae0a-f9d87e3caec5" :answer/id #uuid "0dead613-6310-5d03-ae0a-f9d87e3caec5" :answer/type :answer.type/text :answer/value "star" :db/ensure [:answer/validate]} {:db/id 17592186168023 :tutorial/content "In this topic, we'll study phase portraits of linear systems\n![](images/6f/6f6a92e2b8fb89f833268a5526876cb3af5215db0193a2aaaad8aac5790752ea.svg)\nwhere the $2 \\times 2$ matrix $A$ has a *repeated* real eigenvalue $\\lambda$ (algebraic multiplicity $2$).\n\nIf $A$ has *two independent eigenvectors*, then $A$ is the scalar matrix\n![](images/69/69199c6f84ebe1f9587b9207a3f1fc42c909fc9a1e43041e11fcab9ce881e5d1.svg)\nIn this case, every direction through the origin behaves like an eigenvector direction, and trajectories are straight lines:\n\n$$\n\\mathbf{x}(t)=e^{\\lambda t} \\mathbf{v}, \\qquad \\mathbf{v} \\in \\mathbb{R}^2.\n$$\n\nSo the phase portrait is a **star node**:\n\n- If $\\lambda>0,$ trajectories move *away* from the origin and we have an **unstable star node**.\n\n- If $\\lambda<0,$ trajectories move *toward* the origin and we have a **stable star node**.\n\nLet's see an example." :db/ensure [:tutorial/validate]} {:db/id 17592186168005 :tutorial/content "Let's sketch the phase portrait of the following linear system:\n\n$$\n\\{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=2y(t)\\end{aligned}\n$$\n\nWriting our system in matrix form, we have\n![](images/f5/f58fb57caaba8c5f6a110c72565c24803ac233f41b8eb2db0c5221bcf12d7fe2.svg)\nwhere ![](images/65/65298928a44147868c82da753a731e35c3aa0ad5e4b3400819d9d9f16f546a34.svg)\n\nSince our system is decoupled, its eigenvalues are $\\lambda_1=\\lambda_2=2$ with the corresponding eigenvectors $[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ and ![](images/69/694a89326f61bbbba7e91db5dcb607a74f99881ce16059450dbe1bbac7ee797e.svg)\n\nThe general solution of the system is\n![](images/ab/abd4dbe3156abbcd645e670fb893f93cc8765cba4b1da9bde11075e211f1eeaa.svg)\n\nNotice that for each vector ![](images/9d/9df6cb20bf3163f53850730242138ec62412ccc8af23098130d71228cac4b82a.svg) we get the straight-line solutions of the form\n![](images/71/7166c456c7912bf31d4ff2d98f4e4206537f8d01aca086fdba3c15b394db4b81.svg)\nthat represent the line passing through the origin and parallel to the vector ![](images/23/23074d10911b113811cc92bdc88a61a6758dbd8772c21425159c5e95d30b1075.svg)\n\nSince $e^{2t} \\to \\infty$ as $t \\to \\infty,$ these solutions move away from the origin as $t \\to \\infty,$ so the origin is an unstable node.\n\nThe phase portrait satisfying these conditions is the following:\n\n![](images/b3/b32b5666c0138f5c17ff1622cef9bca6fb019375f6748b6422c11a547cfad282.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186168024 :tutorial/content "Recall that in this topic, we're studying phase portraits of linear systems\n![](images/28/28d8900ae13325f715af9679fdeab6f26645e322ea0df016618826a5b3dee328.svg)\nwhere the $2 \\times 2$ matrix $A$ has a *repeated* real eigenvalue $\\lambda$ (algebraic multiplicity $2$).\n\nIf $A$ has *only one eigenvector* $\\mathbf{v},$ and if $\\mathbf{w}$ is a generalized eigenvector satisfying\n\n$$\n(A-\\lambda I)\\mathbf{w}=\\mathbf{v},\n$$\n\nthen the general solution takes the form\n\n$$\n\\mathbf{x}(t)=c_1 e^{\\lambda t}\\mathbf{v}+c_2 e^{\\lambda t}\\bigl(t\\,\\mathbf{v}+\\mathbf{w}\\bigr).\n$$\n\nHere, the eigenvector line (the line through the origin parallel to $\\mathbf{v}$) is still a straight-line solution, but other trajectories are *curved* and become tangent to that eigenvector line.\n\nIn cases like this, the phase portrait is a **degenerate node**:\n\n- If $\\lambda>0,$ trajectories move *away* from the origin and we have an **unstable degenerate node**.\n\n- If $\\lambda<0,$ trajectories move *toward* the origin and we have a **stable degenerate node**.\n\nLet's see an example." :db/ensure [:tutorial/validate]} {:db/id 17592186168006 :tutorial/content "Consider the following system of linear differential equations: \n\n$$\n\\{\\begin{aligned}{x}^{′}(t)=x(t)+y(t) \\\\ {y}^{′}(t)=y(t)\\end{aligned}\n$$\n\nThe eigenvector corresponding to the only eigenvalue of the system's matrix $A$ is ![](images/23/23616d197363a3fd8ad4689a0b1e547c7b1044e0929cfd96add65a26e940731f.svg) The vector ![](images/3e/3e434cc0b5ca5d288695abb58500e8f4ca6be0c0cf2ecb5200d03f5fbcf522c2.svg) is such that $(A - \\lambda I)\\mathbf{w}= \\mathbf{v}.$ \n\nLet's sketch the phase portrait of the system.\n\nSince we have a repeated eigenvalue $\\lambda=1$ (of multiplicity two) and only one corresponding eigenvector $\\mathbf{v},$ the solution of the system is given by\n\n$$\n\\mathbf{x}(t) = c_1\\mathbf{v} e^{\\lambda t}  + c_2 (\\mathbf{v}  te^{\\lambda t}  +  \\mathbf{w}e^{\\lambda t} \\, ),\n$$\n\nwhere $\\mathbf{w}$ is a solution to the equation $(A - \\lambda I)\\mathbf{w}= \\mathbf{v}.$\n\nIn our case, \n![](images/0f/0f7c56980abff1ad84ca69aa98730bca2988cf5430f181f69d191f1e3c28eff0.svg) \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{t}+{c}_{2}([\\begin{aligned}1 \\\\ 0\\end{aligned}]t{e}^{t}+[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{t}) \\\\  & ={c}_{1}{e}^{t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{t}[\\begin{aligned}t \\\\ 1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe straight-line solutions of the form\n![](images/c9/c9d65d3792c7cced40b86834fbd66769daa714ed58ffcde025cb956763c2c670.svg)\nlie on the $x$-axis. Since $e^{t} \\to \\infty$ as $t \\to \\infty,$ these solutions move toward infinity in the phase plane as $t \\to \\infty.$\n\nLet's add the solutions to the phase space.\n\n![](images/98/98fc60d566b520f3d943e42ee8f4e07aa0bdd33b53fbb04981c2e8f4001210fd.png)\n\nNow, consider solutions of the form\n![](images/61/6170eec4537e26afef2a794426b4f5231b0f4366c21b8860c332f1ec7573b96a.svg)\nWhen $c_2=1,$ we get the following curve:\n\n$$\n\\{\\begin{aligned}x=t{e}^{t} \\\\ y={e}^{t}\\end{aligned}\n$$\n\n \n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $1.2$ |\n| --- | --- | --- | --- |\n| $x$ | $-0.30$ | $0$ | $3.98$ |\n| $y$ | $0.61$ | $1$ | $3.32$ |\n\nLet's add the solutions to the phase space.\n\n![](images/4f/4fbc1650377d580d7129701d745dc8cad89d2d1d061b8f6dca8127f0ce062dc8.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/49/499391b5bc015bd96bbe85d72e3937e87a5e89081951aaad0a752582cb87f15f.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186167011 :activity/expected-seconds 600.0 :db/ensure [:activity/validate]}]
