db/ref 17592186045417] [17592186308312 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186308312 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186308312 #edb/ref 1078 #edb/ref 17592186307345 #edb/ref 17592186045417] [17592186308312 #edb/ref 1079 #uuid "f8bb0cc5-f12a-525d-a29f-a4a6e34ca991" #edb/ref 17592186045417] [17592186308423 #edb/ref 1068 #edb/ref 17592186308306 #edb/ref 17592186045417] [17592186308423 #edb/ref 1069 "q-333270" #edb/ref 17592186045417] [17592186308423 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186308423 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=x(t) \\\\ {y}^{′}(t)=y(t)\\end{aligned}\n$$\n\nWhich of the following could represent the phase portrait of the decoupled system above?" #edb/ref 17592186045417] [17592186308423 #edb/ref 1072 #uuid "83d7fadd-8088-5133-921f-95c4d7994bd0" #edb/ref 17592186045417] [17592186308423 #edb/ref 1074 "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nSince our system is decoupled, its eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=1$ with the corresponding eigenvectors $[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ and $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]={e}^{t}[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nNotice that for each vector $[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}],$ we get the straight-line solutions of the form\n${e}^{t}[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}]$\nthat represent the line passing through the origin and parallel to the vector $[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}].$\n\nSince ${e}^{t}\\to \\infty $ as $t\\to \\infty ,$ these solutions move away from the origin as $t\\to \\infty .$ \n\nAmong the given options, the only phase portrait satisfying these conditions is the following:\n\n![](images/90/904ec8bfe5c8f1b9a63becd782c82da68ef2a70894368418c3710d09bc029db1.png)" #edb/ref 17592186045417] [17592186308424 #edb/ref 1068 #edb/ref 17592186308220 #edb/ref 17592186045417] [17592186308424 #edb/ref 1069 "q-333274" #edb/ref 17592186045417] [17592186308424 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186308424 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=6x(t) \\\\ {y}^{′}(t)=6y(t)\\end{aligned}\n$$\n\nWhich of the following could represent the phase portrait of the decoupled system above?" #edb/ref 17592186045417] [17592186308424 #edb/ref 1072 #uuid "3453e3b1-d01b-5d4c-b10e-7d0ad14fbf35" #edb/ref 17592186045417] [17592186308424 #edb/ref 1074 "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}6 & 0 \\\\ 0 & 6\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nSince our system is decoupled, its eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=6$ with the corresponding eigenvectors $[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ and $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{6t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{6t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]={e}^{6t}[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nNotice that for each vector $[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}],$ we get the straight-line solutions of the form\n${e}^{6t}[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}]$\nthat represent the line passing through the origin and parallel to the vector $[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}].$\n\nSince ${e}^{6t}\\to \\infty $ as $t\\to \\infty ,$ these solutions move away from the origin as $t\\to \\infty .$\n\nAmong the given options, the only phase portrait satisfying these conditions is the following:\n\n![](images/40/404c1f68f360e2916a6281033c8a7e9771b648c61156da903ce2f66b931b924e.png)" #edb/ref 17592186045417] [17592186308435 #edb/ref 1068 #edb/ref 17592186307627 #edb/ref 17592186045417] [17592186308435 #edb/ref 1068 #edb/ref 17592186307778 #edb/ref 17592186045417] [17592186308435 #edb/ref 1068 #edb/ref 17592186307851 #edb/ref 17592186045417] [17592186308435 #edb/ref 1068 #edb/ref 17592186307994 #edb/ref 17592186045417] [17592186308435 #edb/ref 1068 #edb/ref 17592186308014 #edb/ref 17592186045417] [17592186308435 #edb/ref 1068 #edb/ref 17592186308057 #edb/ref 17592186045417] [17592186308435 #edb/ref 1068 #edb/ref 17592186308147 #edb/ref 17592186045417] [17592186308435 #edb/ref 1068 #edb/ref 17592186308208 #edb/ref 17592186045417] [17592186308435 #edb/ref 1069 "q-333300" #edb/ref 17592186045417] [17592186308435 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186308435 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=-3x(t)+y(t) \\\\ {y}^{′}(t)=-3y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvector corresponding to the only eigenvalue of the system's matrix $A$ is $v=[1,\\text{ }0]^{T}.$ The vector $w=[0,\\text{ }1]^{T}$ is such that $(A-\\lambda I)w=v.$ Select the correct options in the reasoning below.\n\nThe general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-3t}+{c}_{2}([\\begin{aligned}1 \\\\ 0\\end{aligned}]{{field-1}}+[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-3t}) \\\\  & ={c}_{1}{e}^{-3t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{-3t}{{field-2}},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe straight-line solutions of the form\n${c}_{1}{e}^{-3t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on the \n{{field-3}} \nSince ${e}^{-3t}\\to $ \n{{field-4}} \nas $t\\to \\infty ,$ these solutions approach \n{{field-5}}  \nas $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/8d/8dc90697da27e52e0c1818d5529247d132944f30603936bedc191c4a14cb7d9c.png)\n\nNow, consider solutions of the form\n${c}_{2}{e}^{-3t}[\\begin{aligned}t \\\\ 1\\end{aligned}].$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n\\{\\begin{aligned}x={{field-6}} \\\\ y={e}^{-3t}\\end{aligned}\n$$\n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.5$ |\n| --- | --- | --- | --- |\n| $x$ | $-2.24$ | $0$ | {{field-7}} |\n| $y$ | $4.48$ | $1$ | {{field-8}} |\n\nLet's add the solutions to the phase space.\n\n![](images/39/3981c3c5bdfc66850798ee3c34031acb0d1cdfea7181eb34a0a0422b44cc2ef0.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/f2/f2b5b95167b1ecd07aa1152aeac6dd454fbe71ba953b05c4da22d8c36f76277a.png)" #edb/ref 17592186045417] [17592186308435 #edb/ref 1072 #uuid "db8bd58e-f203-50b9-91f2-a939090e4f8a" #edb/ref 17592186045417] [17592186308435 #edb/ref 1074 "Since we have a repeated eigenvalue $\\lambda =-3$ (of multiplicity two) and only one corresponding eigenvector $v,$ the solution of the system is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nIn our case, \n\n$$\n\\lambda =-3,\\,v=[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,w=[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\n \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-3t}+{c}_{2}([\\begin{aligned}1 \\\\ 0\\end{aligned}]t{e}^{-3t}+[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-3t}) \\\\  & ={c}_{1}{e}^{-3t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{-3t}[\\begin{aligned}t \\\\ 1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe straight-line solutions of the form\n${c}_{1}{e}^{-3t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on the $x\\text{-axis}.$ Since ${e}^{-3t}\\to 0$ as $t\\to \\infty ,$ these solutions approach $\\text{the origin}$ as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/8d/8dc90697da27e52e0c1818d5529247d132944f30603936bedc191c4a14cb7d9c.png)\n\nNow, consider solutions of the form\n${c}_{2}{e}^{-3t}[\\begin{aligned}t \\\\ 1\\end{aligned}].$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n\\{\\begin{aligned}x=t{e}^{-3t} \\\\ y={e}^{-3t}\\end{aligned}\n$$\n\n \n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.5$ |\n| --- | --- | --- | --- |\n| $x$ | $-2.24$ | $0$ | $0.11$ |\n| $y$ | $4.48$ | $1$ | $0.22$ |\n\nLet's add the solutions to the phase space.\n\n![](images/39/3981c3c5bdfc66850798ee3c34031acb0d1cdfea7181eb34a0a0422b44cc2ef0.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/f2/f2b5b95167b1ecd07aa1152aeac6dd454fbe71ba953b05c4da22d8c36f76277a.png)" #edb/ref 17592186045417]}
