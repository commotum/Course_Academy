e/7e48266d30ae7c204b25e6eddca968d1b4ce9cd8e1c7b19cd20247fa66070f0b.png" #edb/ref 17592186045417] [17592186164487 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186164487 #edb/ref 1083 #uuid "85c55197-972e-5ae8-adc5-35de8dcbd9a2" #edb/ref 17592186045417] [17592186164488 #edb/ref 1080 "images/ea/ea7ff4f032bade692953813c58b34ba62ab9c525c71ac13a2256dda6285e6620.png" #edb/ref 17592186045417] [17592186164488 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186164488 #edb/ref 1083 #uuid "aed621ee-dc79-51f3-b217-0d285b403ab2" #edb/ref 17592186045417] [17592186164489 #edb/ref 1080 "images/7b/7be65c63a4e5dcbe73fbc63faf3f061476ecd478cef8d58776bb843bfe84df2c.png" #edb/ref 17592186045417] [17592186164489 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186164489 #edb/ref 1083 #uuid "b77e3e0a-5eb0-5077-bf3d-98a59c2ef736" #edb/ref 17592186045417] [17592186164490 #edb/ref 1080 "images/eb/eba955015a4b919c65dc24facb0baa6e745df134feac32feeae07c99d40ff4ec.png" #edb/ref 17592186045417] [17592186164490 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186164490 #edb/ref 1083 #uuid "6b10b504-d34f-55f9-9884-1fbd9169b090" #edb/ref 17592186045417] [17592186166545 #edb/ref 1069 "e-21642" #edb/ref 17592186045417] [17592186166545 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=-8x(t) \\\\ {y}^{′}(t)=-8y(t)\\end{aligned}\n$$\n\nSketch the phase portrait of the linear system above." #edb/ref 17592186045417] [17592186166545 #edb/ref 1072 #uuid "a38dad3a-1afd-5e97-9046-87e413574865" #edb/ref 17592186045417] [17592186166545 #edb/ref 1074 "Writing our system in matrix form, we have\n![](images/73/737c96109e65d59f4df2c2fa574737fe604483fe4ccc9772a3d2bf22ee32e55a.svg)\nwhere ![](images/22/22dbda7d3b169206071e5af49fd1fe1af28d86ef1e0a8b37d58eacb62b44c1d2.svg)\n\nSince our system is decoupled, its eigenvalues are $\\lambda_1=\\lambda_2=-8$ with the corresponding eigenvectors $[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ and ![](images/5b/5bd691bbaa9542184d90e55aeb16f4dfcd3d22d092b4652e8bddba7bf0b926aa.svg)\n\nThe general solution of the system is\n![](images/8b/8b25789fb45234e4299e4b5ce3371c1afafc181c64f9802d212ae7cbefc0970f.svg)\n\nNotice that for each vector ![](images/67/674212f0d815e0588faaf276bd797e9822ac5659e5d4b15a7635d7f1327d5dc5.svg) we get the straight-line solutions of the form\n![](images/d4/d4c31285e6f31a229bc6fc5cbe2d78e2bf50f73bb6305d91687c5dcc31c3885a.svg)\nthat represent the line passing through the origin and parallel to the vector ![](images/26/268764bbe776b03647daac7fc77e8ed24107e1bb0cf16d955f7a845a12c65755.svg)\n\nSince $e^{-8t} \\to 0$ as $t \\to \\infty,$ these solutions approach the origin as $t \\to \\infty,$ so the origin is a stable node.\n\nThe phase portrait satisfying these conditions is the following:\n\n![](images/4c/4c337f7f6b80f340859844e8217525db98230660d22e760c70218f0c282d21e9.png)" #edb/ref 17592186045417] [17592186166546 #edb/ref 1069 "e-21643" #edb/ref 17592186045417] [17592186166546 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=-x(t)+y(t) \\\\ {y}^{′}(t)=-x(t)-3y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvector $\\mathbf{v} = [1, \\ -1]^T$ corresponds to the repeated eigenvalue $\\lambda=-2$ of the system's matrix $A.$ The vector $\\mathbf{w} = [0, \\ 1]^T$ is such that $(A - \\lambda I)\\mathbf{w}= \\mathbf{v}.$ Sketch the phase portrait of the linear system above." #edb/ref 17592186045417] [17592186166546 #edb/ref 1072 #uuid "e3e083fd-2421-5f66-acb5-69e1523e7fb0" #edb/ref 17592186045417] [17592186166546 #edb/ref 1074 "Since we have a repeated eigenvalue $\\lambda=-2$ (of multiplicity two) and only one corresponding eigenvector $\\mathbf{v},$ the solution of the system is given by\n\n$$\n\\mathbf{x}(t) = c_1\\mathbf{v} e^{\\lambda t}  + c_2 (\\mathbf{v}  te^{\\lambda t}  +  \\mathbf{w}e^{\\lambda t} \\, ),\n$$\n\nwhere $\\mathbf{w}$ is a solution to the equation $(A - \\lambda I)\\mathbf{w}= \\mathbf{v}.$\n\nIn our case, \n![](images/72/72cfb513575d6481a4ee3206ff4d74568dc8397e10fec34ae89242a444a6b2d2.svg) \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{-2t}+{c}_{2}([\\begin{aligned}1 \\\\ -1\\end{aligned}]t{e}^{-2t}+[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-2t}) \\\\  & ={c}_{1}{e}^{-2t}[\\begin{aligned}1 \\\\ -1\\end{aligned}]+{c}_{2}{e}^{-2t}[\\begin{aligned}t \\\\ -t+1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe line that passes through the origin and is parallel to ![](images/46/461a22d18752e55eada19b3f0bb58be61bee7a9cd88437304f291c4a9992bdae.svg) has the equation \n\n$$\ny= -x\n$$\n\nand the straight-line solutions of the form\n![](images/ed/ed2fb464c555b2cbf0ffa7f67084e5565fc7c9e80e0263647e1303f69a91895d.svg)\nlie on that line. \n\nSince $e^{-2t} \\to 0$ as $t \\to \\infty,$ these solutions approach the origin as $t \\to \\infty.$\n\nLet's add the solutions to the phase space.\n\n![](images/52/523dccf73169d02b6bdf4297e96ec84bcc6c43213cdd722000f3a987a534b218.png)\n\nNow, consider solutions of the form\n![](images/05/0589d1749aed66b91a94b49e4a8815bc4a8621eef3b45e535d2117e81d4f416d.svg)\nWhen $c_2=1,$ we get the following curve:\n\n$$\n\\{\\begin{aligned}x=t{e}^{-2t} \\\\ y=(-t+1){e}^{-2t}\\end{aligned}\n$$\n\n \n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.5$ |\n| --- | --- | --- | --- |\n| $x$ | $-1.36$ | $0$ | $0.18$ |\n| $y$ | $4.08$ | $1$ | $0.18$ |\n\nLet's add the solutions to the phase space.\n\n![](images/db/dbf5a13ecd5e81c399204fd29d235e410fcb62274555cf3e5b32a383c1078d24.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/6c/6c84cd04f3b037bee48d02d3183114e2668fbbd110bd44e9311e7ff454db8bac.png)" #edb/ref 17592186045417] [17592186166547 #edb/ref 1069 "e-21645" #edb/ref 17592186045417] [17592186166547 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=6x(t)+y(t) \\\\ {y}^{′}(t)=-x(t)+4y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above, where the system's matrix has repeated eigenvalue $\\lambda=5$ of multiplicity two. Determine the type and stability of the equilibrium point for this linear system." #edb/ref 17592186045417] [17592186166547 #edb/ref 1072 #uuid "4aa5583f-003b-55a7-bfac-ae42ac44a380" #edb/ref 17592186045417] [17592186166547 #edb/ref 1074 "The matrix of our system is\n![](images/dd/dda3aceadd2c3bc3b53422d9533f3b5926906de522137d2e0edc4794d658b1fd.svg)\n\nNotice that:\n\n- Since the only (repeated) eigenvalue of $A$ is positive, we have a unstable node.\n\n- Since $A$ is not diagonal and has a repeated eigenvalue, there is only one linearly independent eigenvector. So, we have a degenerate node.\n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/32/32f9fd5ff34d75a7b82427a5ab7233613da3bdbaefdaef37058e65b1691b6c4a.png)" #edb/ref 17592186045417] [17592186166919 #edb/ref 1037 #edb/ref 17592186048395 #edb/ref 17592186045417] [17592186166919 #edb/ref 1038 #edb/ref 17592186167214 #edb/ref 17592186045417] [17592186166919 #edb/ref 1038 #edb/ref 17592186167237 #edb/ref 17592186045417] [17592186166919 #edb/ref 1038 #edb/ref 17592186308423 #edb/ref 17592186045417] [17592186166919 #edb/ref 1038 #edb/ref 17592186308424 #edb/ref 17592186045417] [17592186166919 #edb/ref 1038 #edb/ref 17592186308431 #edb/ref 17592186045417] [17592186166919 #edb/ref 1038 #edb/ref 17592186308433 #edb/ref 17592186045417] [17592186166919 #edb/ref 1038 #edb/ref 17592186391187 #edb/ref 17592186045417] [17592186166919 #edb/ref 1038 #edb/ref 17592186391194 #edb/ref 17592186045417] [17592186166919 #edb/ref 1038 #edb/ref 17592186425335 #edb/ref 17592186045417] [17592186166919 #edb/ref 1038 #edb/ref 17592186425336 #edb/ref 17592186045417] [17592186166919 #edb/ref 1039 "Identifying the Phase Portrait of a Decoupled System With Repeated Eigenvalues" #edb/ref 17592186045417] [17592186166919 #edb/ref 1041 #edb/ref 17592186166545 #edb/ref 17592186045417] [17592186166919 #edb/ref 1042 #uuid "371d99ed-a060-51da-8f0f-7b38a0267bb7" #edb/ref 17592186045417] [17592186166920 #edb/ref 1037 #edb/ref 17592186048293 #edb/ref 17592186045417] [17592186166920 #edb/ref 1037 #edb/ref 17592186048992 #edb/ref 17592186045417] [17592186166920 #edb/ref 1037 #edb/ref 17592186050450 #edb/ref 17592186045417] [17592186166920 #edb/ref 1038 #edb/ref 17592186167218 #edb/ref 17592186045417] [17592186166920 #edb/ref 1038 #edb/ref 17592186167220 #edb/ref 17592186045417] [17592186166920 #edb/ref 1038 #edb/ref 17592186308435 #edb/ref 17592186045417] [17592186166920 #edb/ref 1038 #edb/ref 17592186308469 #edb/ref 17592186045417] [17592186166920 #edb/ref 1038 #edb/ref 17592186308471 #edb/ref 17592186045417] [17592186166920 #edb/ref 1038 #edb/ref 17592186425337 #edb/ref 17592186045417] [17592186166920 #edb/ref 1039 "Identifying the Phase Portrait of a System With Repeated Eigenvalues" #edb/ref 17592186045417] [17592186166920 #edb/ref 1041 #edb/ref 17592186166546 #edb/ref 17592186045417] [17592186166920 #edb/ref 1042 #uuid "a2c335ee-467a-5114-a7d9-4c2692562d9e" #edb/ref 17592186045417] [17592186166921 #edb/ref 1037 #edb/ref 17592186048990 #edb/ref 17592186045417] [17592186166921 #edb/ref 1038 #edb/ref 17592186167221 #edb/ref 17592186045417] [17592186166921 #edb/ref 1038 #edb/ref 17592186167240 #edb/ref 17592186045417] [17592186166921 #edb/ref 1038 #edb/ref 17592186308476 #edb/ref 17592186045417] [17592186166921 #edb/ref 1038 #edb/ref 17592186308477 #edb/ref 17592186045417] [17592186166921 #edb/ref 1038 #edb/ref 17592186391219 #edb/ref 17592186045417] [17592186166921 #edb/ref 1038 #edb/ref 17592186391257 #edb/ref 17592186045417] [17592186166921 #edb/ref 1038 #edb/ref 17592186425334 #edb/ref 17592186045417] [17592186166921 #edb/ref 1038 #edb/ref 17592186425338 #edb/ref 17592186045417] [17592186166921 #edb/ref 1039 "Classifying Systems of Linear Differential Equations With Repeated Eigenvalues" #edb/ref 17592186045417] [17592186166921 #edb/ref 1041 #edb/ref 17592186166547 #edb/ref 17592186045417] [17592186166921 #edb/ref 1042 #uuid "7aa8246d-6476-5574-a9d2-6133bcd169f7" #edb/ref 17592186045417] [17592186167011 #edb/ref 1043 #edb/ref 17592186167860 #edb/ref 17592186045417] [17592186167011 #edb/ref 1043 #edb/ref 17592186167861 #edb/ref 17592186045417] [17592186167011 #edb/ref 1043 #edb/ref 17592186167862 #edb/ref 17592186045417] [17592186167011 #edb/ref 1043 #edb/ref 17592186167863 #edb/ref 17592186045417] [17592186167011 #edb/ref 1043 #edb/ref 17592186167864 #edb/ref 17592186045417] [17592186167011 #edb/ref 1043 #edb/ref 17592186167865 #edb/ref 17592186045417] [17592186167011 #edb/ref 1043 #edb/ref 17592186167866 #edb/ref 17592186045417] [17592186167011 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186167011 #edb/ref 1045 "Phase Portraits for Linear Systems With Repeated Eigenvalues" #edb/ref 17592186045417] [17592186167011 #edb/ref 1046 #edb/ref 17592186167860 #edb/ref 17592186045417] [17592186167011 #edb/ref 1049 #edb/ref 17592186050967 #edb/ref 17592186045417] [17592186167011 #edb/ref 1050 600.0 #edb/ref 17592186045417] [17592186167011 #edb/ref 1053 #uuid "0a53a252-6ac4-561a-b529-a6d8a0a14ceb" #edb/ref 17592186045417] [17592186167237 #edb/ref 1068 #edb/ref 17592186164485 #edb/ref 17592186045417] [17592186167237 #edb/ref 1069 "q-333267" #edb/ref 17592186045417] [17592186167237 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186167237 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=5x(t) \\\\ {y}^{′}(t)=5y(t)\\end{aligned}\n$$\n\nWhich of the following could represent the phase portrait of the decoupled system above?" #edb/ref 17592186045417] [17592186167237 #edb/ref 1072 #uuid "a2b2a037-2ba8-540a-a005-ca472e5f4072" #edb/ref 17592186045417] [17592186167237 #edb/ref 1074 "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nSince our system is decoupled, its eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=5$ with the corresponding eigenvectors $[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ and $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{5t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{5t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]={e}^{5t}[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nNotice that for each vector $[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}],$ we get the straight-line solutions of the form\n${e}^{5t}[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}]$\nthat represent the line passing through the origin and parallel to the vector $[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}].$\n\nSince ${e}^{5t}\\to \\infty $ as $t\\to \\infty ,$ these solutions move away from the origin as $t\\to \\infty .$\n\nAmong the given options, the only phase portrait satisfying these conditions is the following:\n\n![](images/2a/2acd3b0de16138b460a332cf6e4841e6caeeb5dbb23eef8f411dbdb5ce48ea42.png)" #edb/ref 17592186045417] [17592186167240 #edb/ref 1068 #edb/ref 17592186307567 #edb/ref 17592186045417] [17592186167240 #edb/ref 1068 #edb/ref 17592186308312 #edb/ref 17592186045417] [17592186167240 #edb/ref 1069 "q-333672" #edb/ref 17592186045417] [17592186167240 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186167240 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=x(t) \\\\ {y}^{′}(t)=y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. Select the correct options below regarding the given system.\n\n$\\,$ The equilibrium point (origin) is a \n{{field-1}}{{field-2}}\nnode." #edb/ref 17592186045417] [17592186167240 #edb/ref 1072 #uuid "b699002a-13ee-52d0-9a5f-852554c5f030" #edb/ref 17592186045417] [17592186167240 #edb/ref 1074 "The matrix of our system is\n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}].\n$$\n\nNotice that:\n\n- Since the only (repeated) eigenvalue of $A$ is $\\lambda =1$ and it's positive, we have a $\\text{unstable}$ node.\n\n- Since $A$ is diagonal and has a repeated eigenvalue, there are infinitely many linearly independent eigenvectors. So, we have a $\\text{star}$ node.\n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/0e/0e2180fe05500bcff2d0a1e2c066e2364eea0fd481a63866578a07e8f46b3825.png)" #edb/ref 17592186045417] [17592186167860 #edb/ref 1058 #edb/ref 17592186167861 #edb/ref 17592186045417] [17592186167860 #edb/ref 1061 588332 #edb/ref 17592186045417] [17592186167860 #edb/ref 1062 #uuid "b7f1536f-3909-5575-8eee-90d0181e7613" #edb/ref 17592186045417] [17592186167860 #edb/ref 1063 #edb/ref 17592186168023 #edb/ref 17592186045417] [17592186167861 #edb/ref 1058 #edb/ref 17592186167862 #edb/ref 17592186045417] [17592186167861 #edb/ref 1061 588333 #edb/ref 17592186045417] [17592186167861 #edb/ref 1062 #uuid "b1d8e327-701e-5016-9351-b19e915b0311" #edb/ref 17592186045417] [17592186167861 #edb/ref 1063 #edb/ref 17592186168005 #edb/ref 17592186045417] [17592186167862 #edb/ref 1058 #edb/ref 17592186167863 #edb/ref 17592186045417] [17592186167862 #edb/ref 1061 588334 #edb/ref 17592186045417] [17592186167862 #edb/ref 1062 #uuid "470270ef-3713-5eab-bed1-4ac8b8cff293" #edb/ref 17592186045417] [17592186167862 #edb/ref 1063 #edb/ref 17592186166919 #edb/ref 17592186045417] [17592186167863 #edb/ref 1058 #edb/ref 17592186167864 #edb/ref 17592186045417] [17592186167863 #edb/ref 1061 588337 #edb/ref 17592186045417] [17592186167863 #edb/ref 1062 #uuid "75bd8867-e725-5442-988b-67f110d201f4" #edb/ref 17592186045417] [17592186167863 #edb/ref 1063 #edb/ref 17592186168024 #edb/ref 17592186045417] [17592186167864 #edb/ref 1058 #edb/ref 17592186167865 #edb/ref 17592186045417] [17592186167864 #edb/ref 1061 588338 #edb/ref 17592186045417] [17592186167864 #edb/ref 1062 #uuid "459bdc90-2dce-52cb-8f50-0ae602e390e4" #edb/ref 17592186045417] [17592186167864 #edb/ref 1063 #edb/ref 17592186168006 #edb/ref 17592186045417] [17592186167865 #edb/ref 1058 #edb/ref 17592186167866 #edb/ref 17592186045417] [17592186167865 #edb/ref 1061 588339 #edb/ref 17592186045417] [17592186167865 #edb/ref 1062 #uuid "4664ec49-c2f9-5bce-aa8d-00c4ee9589e6" #edb/ref 17592186045417] [17592186167865 #edb/ref 1063 #edb/ref 17592186166920 #edb/ref 17592186045417] [17592186167866 #edb/ref 1061 588342 #edb/ref 17592186045417] [17592186167866 #edb/ref 1062 #uuid "eb9d67cc-acaf-5e2e-a509-7e2eb99610dd" #edb/ref 17592186045417] [17592186167866 #edb/ref 1063 #edb/ref 17592186166921 #edb/ref 17592186045417] [17592186168005 #edb/ref 1064 "Let's sketch the phase portrait of the following linear system:\n\n$$\n\\{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=2y(t)\\end{aligned}\n$$\n\nWriting our system in matrix form, we have\n![](images/f5/f58fb57caaba8c5f6a110c72565c24803ac233f41b8eb2db0c5221bcf12d7fe2.svg)\nwhere ![](images/65/65298928a44147868c82da753a731e35c3aa0ad5e4b3400819d9d9f16f546a34.svg)\n\nSince our system is decoupled, its eigenvalues are $\\lambda_1=\\lambda_2=2$ with the corresponding eigenvectors $[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ and ![](images/69/694a89326f61bbbba7e91db5dcb607a74f99881ce16059450dbe1bbac7ee797e.svg)\n\nThe general solution of the system is\n![](images/ab/abd4dbe3156abbcd645e670fb893f93cc8765cba4b1da9bde11075e211f1eeaa.svg)\n\nNotice that for each vector ![](images/9d/9df6cb20bf3163f53850730242138ec62412ccc8af23098130d71228cac4b82a.svg) we get the straight-line solutions of the form\n![](images/71/7166c456c7912bf31d4ff2d98f4e4206537f8d01aca086fdba3c15b394db4b81.svg)\nthat represent the line passing through the origin and parallel to the vector ![](images/23/23074d10911b113811cc92bdc88a61a6758dbd8772c21425159c5e95d30b1075.svg)\n\nSince $e^{2t} \\to \\infty$ as $t \\to \\infty,$ these solutions move away from the origin as $t \\to \\infty,$ so the origin is an unstable node.\n\nThe phase portrait satisfying these conditions is the following:\n\n![](images/b3/b32b5666c0138f5c17ff1622cef9bca6fb019375f6748b6422c11a547cfad282.png)" #edb/ref 17592186045417] [17592186168005 #edb/ref 1065 14467 #edb/ref 17592186045417] [17592186168005 #edb/ref 1066 #uuid "ae2e5f22-ed77-5781-b5af-ab6ead3ca6d6" #edb/ref 17592186045417] [17592186168005 #edb/ref 1067 "A Worked Example of a Star Node" #edb/ref 17592186045417] [17592186168006 #edb/ref 1064 "Consider the following system of linear differential equations: \n\n$$\n\\{\\begin{aligned}{x}^{′}(t)=x(t)+y(t) \\\\ {y}^{′}(t)=y(t)\\end{aligned}\n$$\n\nThe eigenvector corresponding to the only eigenvalue of the system's matrix $A$ is ![](images/23/23616d197363a3fd8ad4689a0b1e547c7b1044e0929cfd96add65a26e940731f.svg) The vector ![](images/3e/3e434cc0b5ca5d288695abb58500e8f4ca6be0c0cf2ecb5200d03f5fbcf522c2.svg) is such that $(A - \\lambda I)\\mathbf{w}= \\mathbf{v}.$ \n\nLet's sketch the phase portrait of the system.\n\nSince we have a repeated eigenvalue $\\lambda=1$ (of multiplicity two) and only one corresponding eigenvector $\\mathbf{v},$ the solution of the system is given by\n\n$$\n\\mathbf{x}(t) = c_1\\mathbf{v} e^{\\lambda t}  + c_2 (\\mathbf{v}  te^{\\lambda t}  +  \\mathbf{w}e^{\\lambda t} \\, ),\n$$\n\nwhere $\\mathbf{w}$ is a solution to the equation $(A - \\lambda I)\\mathbf{w}= \\mathbf{v}.$\n\nIn our case, \n![](images/0f/0f7c56980abff1ad84ca69aa98730bca2988cf5430f181f69d191f1e3c28eff0.svg) \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{t}+{c}_{2}([\\begin{aligned}1 \\\\ 0\\end{aligned}]t{e}^{t}+[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{t}) \\\\  & ={c}_{1}{e}^{t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{t}[\\begin{aligned}t \\\\ 1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe straight-line solutions of the form\n![](images/c9/c9d65d3792c7cced40b86834fbd66769daa714ed58ffcde025cb956763c2c670.svg)\nlie on the $x$-axis. Since $e^{t} \\to \\infty$ as $t \\to \\infty,$ these solutions move toward infinity in the phase plane as $t \\to \\infty.$\n\nLet's add the solutions to the phase space.\n\n![](images/98/98fc60d566b520f3d943e42ee8f4e07aa0bdd33b53fbb04981c2e8f4001210fd.png)\n\nNow, consider solutions of the form\n![](images/61/6170eec4537e26afef2a794426b4f5231b0f4366c21b8860c332f1ec7573b96a.svg)\nWhen $c_2=1,$ we get the following curve:\n\n$$\n\\{\\begin{aligned}x=t{e}^{t} \\\\ y={e}^{t}\\end{aligned}\n$$\n\n \n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $1.2$ |\n| --- | --- | --- | --- |\n| $x$ | $-0.30$ | $0$ | $3.98$ |\n| $y$ | $0.61$ | $1$ | $3.32$ |\n\nLet's add the solutions to the phase space.\n\n![](images/4f/4fbc1650377d580d7129701d745dc8cad89d2d1d061b8f6dca8127f0ce062dc8.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/49/499391b5bc015bd96bbe85d72e3937e87a5e89081951aaad0a752582cb87f15f.png)" #edb/ref 17592186045417] [17592186168006 #edb/ref 1065 14468 #edb/ref 17592186045417] [17592186168006 #edb/ref 1066 #uuid "bfa66c2a-6bb2-552c-b495-e33f1eabed8c" #edb/ref 17592186045417] [17592186168006 #edb/ref 1067 "A Worked Example for a System With Repeated Eigenvalues" #edb/ref 17592186045417] [17592186168023 #edb/ref 1064 "In this topic, we'll study phase portraits of linear systems\n![](images/6f/6f6a92e2b8fb89f833268a5526876cb3af5215db0193a2aaaad8aac5790752ea.svg)\nwhere the $2 \\times 2$ matrix $A$ has a *repeated* real eigenvalue $\\lambda$ (algebraic multiplicity $2$).\n\nIf $A$ has *two independent eigenvectors*, then $A$ is the scalar matrix\n![](images/69/69199c6f84ebe1f9587b9207a3f1fc42c909fc9a1e43041e11fcab9ce881e5d1.svg)\nIn this case, every direction through the origin behaves like an eigenvector direction, and trajectories are straight lines:\n\n$$\n\\mathbf{x}(t)=e^{\\lambda t} \\mathbf{v}, \\qquad \\mathbf{v} \\in \\mathbb{R}^2.\n$$\n\nSo the phase portrait is a **star node**:\n\n- If $\\lambda>0,$ trajectories move *away* from the origin and we have an **unstable star node**.\n\n- If $\\lambda<0,$ trajectories move *toward* the origin and we have a **stable star node**.\n\nLet's see an example." #edb/ref 17592186045417] [17592186168023 #edb/ref 1065 14569 #edb/ref 17592186045417] [17592186168023 #edb/ref 1066 #uuid "8fe5f0d1-38d4-5cd2-98f8-8935d82677de" #edb/ref 17592186045417] [17592186168023 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186168024 #edb/ref 1064 "Recall that in this topic, we're studying phase portraits of linear systems\n![](images/28/28d8900ae13325f715af9679fdeab6f26645e322ea0df016618826a5b3dee328.svg)\nwhere the $2 \\times 2$ matrix $A$ has a *repeated* real eigenvalue $\\lambda$ (algebraic multiplicity $2$).\n\nIf $A$ has *only one eigenvector* $\\mathbf{v},$ and if $\\mathbf{w}$ is a generalized eigenvector satisfying\n\n$$\n(A-\\lambda I)\\mathbf{w}=\\mathbf{v},\n$$\n\nthen the general solution takes the form\n\n$$\n\\mathbf{x}(t)=c_1 e^{\\lambda t}\\mathbf{v}+c_2 e^{\\lambda t}\\bigl(t\\,\\mathbf{v}+\\mathbf{w}\\bigr).\n$$\n\nHere, the eigenvector line (the line through the origin parallel to $\\mathbf{v}$) is still a straight-line solution, but other trajectories are *curved* and become tangent to that eigenvector line.\n\nIn cases like this, the phase portrait is a **degenerate node**:\n\n- If $\\lambda>0,$ trajectories move *away* from the origin and we have an **unstable degenerate node**.\n\n- If $\\lambda<0,$ trajectories move *toward* the origin and we have a **stable degenerate node**.\n\nLet's see an example." #edb/ref 17592186045417] [17592186168024 #edb/ref 1065 14570 #edb/ref 17592186045417] [17592186168024 #edb/ref 1066 #uuid "f7b031de-59cf-53fe-be90-ac3711677246" #edb/ref 17592186045417] [17592186168024 #edb/ref 1067 "Systems With Repeated Eigenvalues" #edb/ref 17592186045417] [17592186305197 #edb/ref 1080 "images/87/87dfef6eaac680d1730a6b5537ecab4e5d1abee35dd58abf80c72c3afa01107b.png" #edb/ref 17592186045417] [17592186305197 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186305197 #edb/ref 1083 #uuid "05091666-67ba-551c-b9f1-c3ee8b2d8246" #edb/ref 17592186045417] [17592186305205 #edb/ref 1080 "-\\infty " #edb/ref 17592186045417] [17592186305205 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186305205 #edb/ref 1083 #uuid "06033864-6970-592a-9e3f-cec109e1c0b3" #edb/ref 17592186045417] [17592186305225 #edb/ref 1080 "-0.75" #edb/ref 17592186045417] [17592186305225 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186305225 #edb/ref 1083 #uuid "07f9b35e-267f-5871-b89f-c9b83f3fd38f" #edb/ref 17592186045417] [17592186305290 #edb/ref 1080 "0.22" #edb/ref 17592186045417] [17592186305290 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186305290 #edb/ref 1083 #uuid "0fca6345-ada7-56a3-af4b-585de46aac63" #edb/ref 17592186045417] [17592186305478 #edb/ref 1080 "degenerate" #edb/ref 17592186045417] [17592186305478 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186305478 #edb/ref 1083 #uuid "223862d4-0ce2-5e4a-ba6c-0e2e05a1a8de" #edb/ref 17592186045417] [17592186305503 #edb/ref 1080 "images/54/54eba0116ac434bdadbc878e8bd173b6174a42642cfcfe6825a8bdb178a3282c.png" #edb/ref 17592186045417] [17592186305503 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186305503 #edb/ref 1083 #uuid "252d0ad7-d5cd-50c4-be35-c39d84a2074f" #edb/ref 17592186045417] [17592186305645 #edb/ref 1080 "infinity" #edb/ref 17592186045417] [17592186305645 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186305645 #edb/ref 1083 #uuid "34222a53-dee2-5c63-adfd-d7a0f7260b54" #edb/ref 17592186045417] [17592186305665 #edb/ref 1080 "images/90/904ec8bfe5c8f1b9a63becd782c82da68ef2a708