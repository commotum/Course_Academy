#{[{:db/id #edb/ref 17592186492827 :knowledge-point/_questions [{:db/id #edb/ref 17592186176088 :knowledge-point/id #uuid "390ecc8f-2938-5466-b49b-964a67f79755" :knowledge-point/title "Determining the One-Dimensional Image of a Linear Transformation in the Cartesian Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b324769-9430-5f5c-80c0-9c13d075c858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186492307} {:answer/id #uuid "4ca6c8b6-2f80-5c70-9069-f0586e112d1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{3}x" :db/id #edb/ref 17592186492366} {:answer/id #uuid "88430c53-2ff5-5c57-bc6b-a66b7136b41c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186492487} {:answer/id #uuid "a0602523-5644-52d8-bb00-13c7914d03e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186492537} {:answer/id #uuid "a8cca849-8dd3-5d33-8394-2e0d4cedf5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186492559}] :answer-field/correct {:answer/id #uuid "a8cca849-8dd3-5d33-8394-2e0d4cedf5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186492559} :answer-field/id #uuid "fe0672c6-a8a1-54ee-b67e-0f22d1bf3419" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492818}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ea7759f-f796-5f54-9f1a-8b557e8042a4" :question/math-academy-id "q-111788" :question/problem "Let\n$T=\\begin{bmatrix}1 & 1 \\\\ 3 & 3\\end{bmatrix}$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the point $(1,3),$ which is defined by the (repeated) columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{3-0}{1-0}=3.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=3x.$"}] [{:db/id #edb/ref 17592186380615 :knowledge-point/_questions [{:db/id #edb/ref 17592186176089 :knowledge-point/id #uuid "ba9d2401-4e30-5327-b8eb-b4db7108dd0c" :knowledge-point/title "Identifying True Statements Regarding Linear Transformations in the Cartesian Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48355326-ad4b-578d-906e-404260be62dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453288} {:answer/id #uuid "137c30dc-eac8-5144-aa6e-ecac88c88768" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453289}] :answer-field/correct {:answer/id #uuid "137c30dc-eac8-5144-aa6e-ecac88c88768" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453289} :answer-field/id #uuid "029df452-27e1-55c2-95cc-c51c4094c660" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454394} {:answer-field/choices [{:answer/id #uuid "c79a7166-446d-5b5a-a95f-e732499d72f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453290} {:answer/id #uuid "1d2b1e1d-e940-5f7a-a610-b38db6adeb6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453291}] :answer-field/correct {:answer/id #uuid "c79a7166-446d-5b5a-a95f-e732499d72f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453290} :answer-field/id #uuid "e492fc36-ff9b-5ce9-b63f-47f732639a39" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454395} {:answer-field/choices [{:answer/id #uuid "3f22ea7c-9234-582e-9fd8-6c4d53049067" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453292} {:answer/id #uuid "5ae5ae4c-d9b5-5c1e-8df4-fc71fc9b7598" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453293}] :answer-field/correct {:answer/id #uuid "5ae5ae4c-d9b5-5c1e-8df4-fc71fc9b7598" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453293} :answer-field/id #uuid "21f48fb4-a9ca-5657-b58f-f9b05523a3e0" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6d9c3015-ea78-542d-9de3-a1c266f8369d" :question/math-academy-id "q-111793" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $⟨1,1⟩\\in \\text{Im}(T)$\n- **II.** $\\text{Ker}(T)\\ne {0}$\n- **III.** $\\text{nullity}(T)=0$, where $T$ is the standard matrix of $T$" :question/worked-solution "Recall that a linear transformation $T$ maps ${R}^{2}$ onto  ${R}^{2}$ if and only if \n\n$$\n\\text{rank}(T)=\\text{rank}(T)=2\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, The condition $\\text{rank}(T)=2$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Im}(T)={R}^{2}.\n$$\n\nHence, $T$ is surjective and so  $⟨1,1⟩\\in \\text{Im}(T).$\n\n- Statement II is false. The condition $\\text{nullity}(T)=0$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Ker}(T)={0}.\n$$\n\n- Statement III is true. Indeed, we have that \n\n$$\n\\text{nullity}(T)=0.\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186176475 :knowledge-point/_questions [{:db/id #edb/ref 17592186176088 :knowledge-point/id #uuid "390ecc8f-2938-5466-b49b-964a67f79755" :knowledge-point/title "Determining the One-Dimensional Image of a Linear Transformation in the Cartesian Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a942b5d1-7b1a-5fc4-bd44-8277a11d5922" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R^{2}" :db/id #edb/ref 17592186174989} {:answer/id #uuid "c4c68240-98d9-514f-9240-be81ecbac1ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 3x" :db/id #edb/ref 17592186174990} {:answer/id #uuid "e747930b-6ed3-5180-ad7b-d7d4f0fb64db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0, 0)" :db/id #edb/ref 17592186174991} {:answer/id #uuid "298996ce-0479-5e8f-8843-c67a96f5c06b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = x" :db/id #edb/ref 17592186174992} {:answer/id #uuid "43722a77-85c3-5aa4-a12d-664a740790d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = \\frac{1}{3}x" :db/id #edb/ref 17592186174993}] :answer-field/id #uuid "4366e1f6-501e-5781-bcac-0878c93b7f0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186174988} {:answer-field/choices [{:answer/id #uuid "a9fe1b78-433c-504f-a583-950509a9b7ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186395893} {:answer/id #uuid "0108eb21-5320-5ff8-96d7-8f8de5fcef1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186395894} {:answer/id #uuid "bf907f2a-341b-5baa-a98d-8d7e0ddb910a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186395895} {:answer/id #uuid "1cd9ad35-c837-57f3-ade6-3a3db7427a6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{3}x" :db/id #edb/ref 17592186395896} {:answer/id #uuid "e20ea794-ad35-5073-91ed-1a4d6170f723" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186395897}] :answer-field/correct {:answer/id #uuid "bf907f2a-341b-5baa-a98d-8d7e0ddb910a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186395895} :answer-field/id #uuid "de87dec5-6939-5a03-ab02-65e0d9863a39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395892}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "326587d3-f0fa-5430-a120-481fbe187c4a" :question/math-academy-id "q-38229" :question/problem "Let\n$T=\\begin{bmatrix}1 & 2 \\\\ 3 & 6\\end{bmatrix}$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the points $(1,3)$ and $(2,6),$ which are defined by the columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{6-3}{2-1}=3.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=3x.$"}] [{:db/id #edb/ref 17592186572167 :knowledge-point/_questions [{:db/id #edb/ref 17592186176089 :knowledge-point/id #uuid "ba9d2401-4e30-5327-b8eb-b4db7108dd0c" :knowledge-point/title "Identifying True Statements Regarding Linear Transformations in the Cartesian Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "429cbe16-f5e3-5043-b6c8-816c129c4f64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186571659} {:answer/id #uuid "44066267-1187-5ad1-ae24-12c19959375d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186571661} {:answer/id #uuid "98ea171d-32ec-53f1-bbbd-33159ec58a82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186571804} {:answer/id #uuid "af071dd2-7bf2-5139-91db-22d623177322" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186571841} {:answer/id #uuid "c376bd76-aedb-536d-88ca-18c1489c93b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186571888}] :answer-field/correct {:answer/id #uuid "429cbe16-f5e3-5043-b6c8-816c129c4f64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186571659} :answer-field/id #uuid "b089493b-c4d4-51a9-971f-914da25cc8a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572063}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b0a0a680-c34b-55b6-a46f-cafc346112a6" :question/math-academy-id "q-38231" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto the line $y=6x.$ Which of the following statements are true?\n\nI. $⟨2,\\,12⟩\\in \\text{Im}(T)$\n\nII. $\\text{Ker}(T)=\\{0\\}$\n\nIII. $\\text{nullity}(T)=1$, where $T$ is the standard matrix of $T$" :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is a one-dimensional line, then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=1\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, the point $(2,12)$ satisfies the equation of the line $y=6x$ since $12=6\\cdot 2.$ Hence, \n\n$$\n⟨2,\\,12⟩\\in \\text{Im}(T).\n$$\n\n- Statement II is false. Since $\\text{nullity}(T)=1,$ we get \n\n$$\n\\text{Ker}(T)\\ne \\{0\\}.\n$$\n\n- Statement III is true. Indeed, we have that \n\n$$\n\\text{nullity}(T)=1.\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186176588 :knowledge-point/_questions [{:db/id #edb/ref 17592186176088 :knowledge-point/id #uuid "390ecc8f-2938-5466-b49b-964a67f79755" :knowledge-point/title "Determining the One-Dimensional Image of a Linear Transformation in the Cartesian Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "175bf4de-4457-5893-9e70-48b016ba1c87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x" :db/id #edb/ref 17592186564001} {:answer/id #uuid "3cc44505-66d5-5275-ab67-b9b56ad13597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186564070} {:answer/id #uuid "51381d98-4b2c-5d35-b328-a422e2a36439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186564098} {:answer/id #uuid "53c0aaa8-38d2-5451-8a27-0bab44551579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x" :db/id #edb/ref 17592186564103} {:answer/id #uuid "9049bcb9-bcf9-552e-88ca-aa47961cecd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186564194}] :answer-field/correct {:answer/id #uuid "3cc44505-66d5-5275-ab67-b9b56ad13597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186564070} :answer-field/id #uuid "2b1ac556-d4ef-5630-9e88-eb68dd60c483" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175666}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "950ea572-58c1-514e-8c7a-a1bc5bc62c33" :question/math-academy-id "q-97038" :question/problem "Let\n$T=[\\begin{aligned}2 & 2 \\\\ 2 & 2\\end{aligned}]$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the point $(2,2),$ which is defined by the (repeated) columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{2-0}{2-0}=1.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=x.$"}]}
