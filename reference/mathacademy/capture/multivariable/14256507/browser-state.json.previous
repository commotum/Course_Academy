      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14256507/observations/step-q82570-726bf7889db26835aa66.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14256507/observations/step-q82570-726bf7889db26835aa66.png",
