#{[{:db/id #edb/ref 17592186533978 :knowledge-point/_questions [{:db/id #edb/ref 17592186499436 :knowledge-point/id #uuid "4e25ce9f-c93f-5dc0-9e81-2093663c6202" :knowledge-point/title "Identifying a Decimal Interval for a Root of an Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "073f9210-d9a2-5f36-800b-c48c70348e31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5.5$ and $5.6$" :db/id #edb/ref 17592186533152} {:answer/id #uuid "141002c6-b340-5ab9-884d-d4f6694527f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5.4$ and $5.5$" :db/id #edb/ref 17592186533185} {:answer/id #uuid "21b63af1-c719-5e54-b9fb-f8ac242a95b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5.2$ and $5.3$" :db/id #edb/ref 17592186533216} {:answer/id #uuid "a2884d9c-c9cc-5d25-8ed3-7e9a3f85ac60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5.6$ and $5.7$" :db/id #edb/ref 17592186533532} {:answer/id #uuid "d7c71876-374e-5a61-9b3a-791e08c878c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5.3$ and $5.4$" :db/id #edb/ref 17592186533666}] :answer-field/correct {:answer/id #uuid "141002c6-b340-5ab9-884d-d4f6694527f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5.4$ and $5.5$" :db/id #edb/ref 17592186533185} :answer-field/id #uuid "c6a4769f-21c1-52e4-82b5-a8a4ff749939" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533922}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14353486-3eaf-5d78-ba59-74f924378a4f" :question/math-academy-id "q-555460" :question/problem "Between which two consecutive tenths does $\\sqrt{30}$ lie?" :question/worked-solution "To find the two consecutive tenths between which $\\sqrt{30}$ lies, we need to find two numbers with one decimal place whose squares bracket $30$.\n\nFirst, let's establish between which two consecutive integers $\\sqrt{30}$ lies.\nWe know that ${5}^{2}=25$ and ${6}^{2}=36$.\nSince $25<30<36$, we know that $5<\\sqrt{30}<6$.\n\nNext, we can test decimals between $5$ and $6$ to narrow down the interval:\n\n$$\n\\begin{aligned}{5.3}^{2} & =28.09 \\\\ {5.4}^{2} & =29.16 \\\\ {5.5}^{2} & =30.25\\end{aligned}\n$$\n\nSince $29.16<30<30.25$, we can write:\n\n$$\n{5.4}^{2}<30<{5.5}^{2}\n$$\n\nTaking the square root of each part of the inequality gives:\n\n$$\n5.4<\\sqrt{30}<5.5\n$$\n\nTherefore, $\\sqrt{30}$ lies between $5.4$ and $5.5$."}] [{:db/id #edb/ref 17592186533997 :knowledge-point/_questions [{:db/id #edb/ref 17592186499438 :knowledge-point/id #uuid "83d6ac5f-99e4-5420-9047-1c43a50b43a4" :knowledge-point/title "Estimating a Root of an Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cee2d1b8-abc0-540d-91d0-4123cd119263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.5" :db/id #edb/ref 17592186533642}] :answer-field/correct {:answer/id #uuid "cee2d1b8-abc0-540d-91d0-4123cd119263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.5" :db/id #edb/ref 17592186533642} :answer-field/id #uuid "b5cdc719-89df-501a-9054-6f1aff3d4e0c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533911}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3e4b5639-d116-5036-9ab2-4b00a6b27dd4" :question/math-academy-id "q-555923" :question/problem "Estimate the value of $\\sqrt{72},$ rounded to $1$ decimal place.\n\n$\\sqrt{72}≈$\n{{field-1}}" :question/worked-solution "To estimate $\\sqrt{72},$ we first find the two perfect squares closest to $72.$\n\nThe closest perfect squares are $64={8}^{2}$ and $81={9}^{2}.$\n\nSince $64<72<81,$ we know that the square root of $72$ lies between $8$ and $9.$\n\n![](images/e9/e931f5e15b35adb850966e40e4ad759c233d9419771998efba5dc91d9ab95bc1.png)\n\nSince $72$ lies between $64$ and $81,$ we expect $\\sqrt{72}$ to lie between $8$ and $9.$\n\nLet's test decimals near the middle by squaring them:\n\n$$\n\\begin{aligned}{8.4}^{2} & =70.56 \\\\ {8.5}^{2} & =72.25\\end{aligned}\n$$\n\nWe can see that $72$ lies between $70.56$ and $72.25,$ so $8.4<\\sqrt{72}<8.5.$\n\nNext, we determine which value is closer to $72:$\n\n- The distance from $72$ to ${8.4}^{2}$ is $72-70.56=1.44.$\n\n- The distance from $72$ to ${8.5}^{2}$ is $72.25-72=0.25.$\n\nSince $72$ is much closer to $72.25,$ $\\sqrt{72}$ is closer to $8.5.$\n\nTherefore, rounded to $1$ decimal place, $\\sqrt{72}≈8.5.$"}] [{:db/id #edb/ref 17592186534084 :knowledge-point/_questions [{:db/id #edb/ref 17592186499437 :knowledge-point/id #uuid "77b54737-402a-5ce2-acda-ea818dd80b33" :knowledge-point/title "Ordering a Set of Irrational Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c8ec4b2-8a62-5be2-bc85-cb1f42b10068" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{50}" :db/id #edb/ref 17592186533281} {:answer/id #uuid "47a27d49-a40e-50b5-a1b0-9a2ba16e708a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{40}" :db/id #edb/ref 17592186533305} {:answer/id #uuid "b335f7ec-1759-5795-9639-e0da48f10014" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{30}" :db/id #edb/ref 17592186533573} {:answer/id #uuid "b64804d5-9f57-59e0-925d-cefea393e51d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{45}" :db/id #edb/ref 17592186533585} {:answer/id #uuid "e7a88941-27e7-5202-b0d9-8572edf2d3c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{120}" :db/id #edb/ref 17592186533709}] :answer-field/correct {:answer/id #uuid "b64804d5-9f57-59e0-925d-cefea393e51d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{45}" :db/id #edb/ref 17592186533585} :answer-field/id #uuid "7df3e984-bbc8-5964-9312-1a2d645cc83b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533876}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ec99099b-9970-5301-8219-551157f9c01b" :question/math-academy-id "q-556441" :question/problem "Which of the following irrational numbers is the greatest?" :question/worked-solution "To identify the greatest irrational number, we can find the consecutive whole numbers between which each root lies.\n\n- $\\sqrt{45}$ lies between $6$ and $7,$ since ${6}^{2}=36$ and ${7}^{2}=49.$\n\n- $\\sqrt{40}$ lies between $6$ and $7,$ since ${6}^{2}=36$ and ${7}^{2}=49.$\n\n- $\\sqrt[3]{50}$ lies between $3$ and $4,$ since ${3}^{3}=27$ and ${4}^{3}=64.$\n\n- $\\sqrt[3]{120}$ lies between $4$ and $5,$ since ${4}^{3}=64$ and ${5}^{3}=125.$\n\n- $\\sqrt{30}$ lies between $5$ and $6,$ since ${5}^{2}=25$ and ${6}^{2}=36.$\n\nComparing these bounds, the greatest number must be between $6$ and $7.$ So, it is either $\\sqrt{45}$ or $\\sqrt{40}.$\n\nSince $45>40,$ we know that $\\sqrt{45}>\\sqrt{40}.$\n\nTherefore, $\\sqrt{45}$ is the greatest number among the given options."}] [{:db/id #edb/ref 17592186534015 :knowledge-point/_questions [{:db/id #edb/ref 17592186499436 :knowledge-point/id #uuid "4e25ce9f-c93f-5dc0-9e81-2093663c6202" :knowledge-point/title "Identifying a Decimal Interval for a Root of an Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d93e06b-de31-5b20-b728-e05b071741e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.4" :db/id #edb/ref 17592186533173}] :answer-field/correct {:answer/id #uuid "0d93e06b-de31-5b20-b728-e05b071741e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.4" :db/id #edb/ref 17592186533173} :answer-field/id #uuid "106ad80c-f5c2-5906-acd9-99f57be5d5c2" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533788} {:answer-field/choices [{:answer/id #uuid "4141bac0-74e9-56ec-bc66-46fada0ad9dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.3" :db/id #edb/ref 17592186533291}] :answer-field/correct {:answer/id #uuid "4141bac0-74e9-56ec-bc66-46fada0ad9dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.3" :db/id #edb/ref 17592186533291} :answer-field/id #uuid "d99708c6-cfde-5abe-b62f-e0c5ade1ed06" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533930}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6581b3e4-1dde-5fc5-a59c-9d058401fe58" :question/math-academy-id "q-556451" :question/problem "The value of $\\sqrt{88}$ lies between two consecutive tenths $a$ and $b,$ where $a<b.$ Find the values of $a$ and $b.$\n\n$a=$\n{{field-1}}\nand $b=$\n{{field-2}}" :question/worked-solution "First, we find the two consecutive whole numbers that bracket $\\sqrt{88}.$ We do this by finding the perfect squares just below and just above $88:$\n\n$$\n81<88<100\n$$\n\nTaking the square root of each part gives\n\n$$\n\\sqrt{81}<\\sqrt{88}<\\sqrt{100},\n$$\n\nwhich simplifies to\n\n$$\n9<\\sqrt{88}<10.\n$$\n\nThis tells us that $\\sqrt{88}$ is between $9$ and $10.$ \n\nTo narrow this down to two consecutive tenths, we test the squares of decimals between $9.0$ and $10.0.$ Since $88$ is closer to $81$ than to $100,$ the value of $\\sqrt{88}$ will be closer to $9$ than to $10.$ We can start testing at $9.3:$\n\n$$\n\\begin{aligned}{9.3}^{2} & =86.49 \\\\ {9.4}^{2} & =88.36\\end{aligned}\n$$\n\nWe see that $88$ falls between $86.49$ and $88.36:$\n\n$$\n86.49<88<88.36\n$$\n\nTaking the square root of each part gives\n\n$$\n\\sqrt{86.49}<\\sqrt{88}<\\sqrt{88.36},\n$$\n\nwhich simplifies to\n\n$$\n9.3<\\sqrt{88}<9.4.\n$$\n\nTherefore, $\\sqrt{88}$ lies between the consecutive tenths $a=9.3$ and $b=9.4.$"}] [{:db/id #edb/ref 17592186534006 :knowledge-point/_questions [{:db/id #edb/ref 17592186499438 :knowledge-point/id #uuid "83d6ac5f-99e4-5420-9047-1c43a50b43a4" :knowledge-point/title "Estimating a Root of an Integer"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "addca03f-013a-5203-a880-de3131df5bc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.3" :db/id #edb/ref 17592186533556}] :answer-field/correct {:answer/id #uuid "addca03f-013a-5203-a880-de3131df5bc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.3" :db/id #edb/ref 17592186533556} :answer-field/id #uuid "5ba38eb1-b536-562c-bede-07820f4ec156" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533854}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5297aedb-eec0-5c60-a99d-266da204b16b" :question/math-academy-id "q-556465" :question/problem "Estimate the value of $\\sqrt{28},$ rounded to $1$ decimal place.\n\n$\\sqrt{28}≈$\n{{field-1}}" :question/worked-solution "To estimate $\\sqrt{28},$ we first find the two perfect squares closest to $28.$\n\nThe closest perfect squares are $25={5}^{2}$ and $36={6}^{2}.$\n\nSince $25<28<36,$ we know that the square root of $28$ lies between $5$ and $6.$\n\n![](images/9f/9f16093fe61b05142060e1dcc36cf824ec664b271499d24758831a6bc53757ac.png)\n\nSince $28$ lies between $25$ and $36,$ we expect $\\sqrt{28}$ to lie between $5$ and $6.$\n\nLet's test decimals near the middle by squaring them:\n\n$$\n\\begin{aligned}{5.2}^{2} & =27.04 \\\\ {5.3}^{2} & =28.09\\end{aligned}\n$$\n\nWe can see that $28$ lies between $27.04$ and $28.09,$ so $5.2<\\sqrt{28}<5.3.$\n\nNext, we determine which value is closer to $28:$\n\n- The distance from $28$ to ${5.2}^{2}$ is $28-27.04=0.96.$\n\n- The distance from $28$ to ${5.3}^{2}$ is $28.09-28=0.09.$\n\nSince $28$ is much closer to $28.09,$ $\\sqrt{28}$ is closer to $5.3.$\n\nTherefore, rounded to $1$ decimal place, $\\sqrt{28}≈5.3.$"}]}
