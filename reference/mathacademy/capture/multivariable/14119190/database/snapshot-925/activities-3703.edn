#{[{:activity/expected-seconds 1140.0 :activity/first-step {:db/id #edb/ref 17592186180392} :activity/id #uuid "b5724cde-5bc2-5852-a8c8-fc07daea7df1" :activity/scope {:db/id #edb/ref 17592186048540 :topic/id #uuid "a83fec6b-7cfc-5d6a-8354-4213d7005db0" :topic/math-academy-id 3703} :activity/steps [{:db/id #edb/ref 17592186180391 :step/content {:db/id #edb/ref 17592186179673 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179529 :question/id #uuid "1cadcaa9-876e-56cb-b8b3-17695827c4f3" :question/math-academy-id "e-7035"} :knowledge-point/id #uuid "e5b5c517-8e13-5b70-bd1f-15ae495f0632" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049512} {:db/id #edb/ref 17592186050616}] :knowledge-point/questions [{:db/id #edb/ref 17592186180008} {:db/id #edb/ref 17592186180287} {:db/id #edb/ref 17592186259700} {:db/id #edb/ref 17592186259701} {:db/id #edb/ref 17592186259703} {:db/id #edb/ref 17592186259706} {:db/id #edb/ref 17592186387533} {:db/id #edb/ref 17592186387540} {:db/id #edb/ref 17592186387547} {:db/id #edb/ref 17592186415439} {:db/id #edb/ref 17592186415440}] :knowledge-point/title "Computing Line Integrals With Respect to X and Y Along Circles and Ellipses"} :step/id #uuid "b5ba14cd-f6f4-57b8-b3fd-9fe9b4b7cf07" :step/math-academy-id 25934} {:db/id #edb/ref 17592186180392 :step/content {:db/id #edb/ref 17592186180680 :tutorial/content "Let $f(x,y)$ be a function of two variables and $C$ be a path in the $xy$-plane. Recall that the line integral\n\n$$\n\\int\\limits_C f(x,y) \\, \\textrm dx +  f(x,y)\\,\\textrm d y\n$$\n\ncan be evaluated by parameterizing $C$ using the parameter $t\\in [a,b]$ and then applying a change of variables, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x+f(x,y)\\,\\text{d}y & ={\\int }_{a}^{b}f(x,y)\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+f(x,y)\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{a}^{b}(f(x,y)\\frac{\\text{d}x}{\\text{d}t}+f(x,y)\\frac{\\text{d}y}{\\text{d}t})\\,\\text{d}t\\end{aligned}\n$$\n\nThe hardest part is often finding a suitable parameterization for curve $C.$ We'll discuss a number of different cases in this lesson." :tutorial/id #uuid "ffb7dba6-a1f1-50a3-a8a2-c1bf8b0b495d" :tutorial/math-academy-id 4271 :tutorial/title "Introduction"} :step/id #uuid "4617b3e7-d106-54fa-a698-38ed80409cb9" :step/math-academy-id 25938 :step/next {:db/id #edb/ref 17592186180475}} {:db/id #edb/ref 17592186180393 :step/content {:db/id #edb/ref 17592186179674 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179530 :question/id #uuid "5a63ca22-0b1a-5584-8b43-c80457016cd3" :question/math-academy-id "e-7038"} :knowledge-point/id #uuid "9f04a969-e7e0-592f-b5cd-e92fedb217a8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048645} {:db/id #edb/ref 17592186049633}] :knowledge-point/questions [{:db/id #edb/ref 17592186180174} {:db/id #edb/ref 17592186180286} {:db/id #edb/ref 17592186259705} {:db/id #edb/ref 17592186259707} {:db/id #edb/ref 17592186326776} {:db/id #edb/ref 17592186351189} {:db/id #edb/ref 17592186351216} {:db/id #edb/ref 17592186351250} {:db/id #edb/ref 17592186357487} {:db/id #edb/ref 17592186357488} {:db/id #edb/ref 17592186415442}] :knowledge-point/title "Evaluating Line Integrals With Respect to X and Y Along Cartesian Curves"} :step/id #uuid "85d02000-0eb4-519a-9890-2d8078563dbf" :step/math-academy-id 25939 :step/next {:db/id #edb/ref 17592186180391}} {:db/id #edb/ref 17592186180475 :step/content {:db/id #edb/ref 17592186179728 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179590 :question/id #uuid "9d13f401-5e07-5b07-8916-df2b0b6b8f74" :question/math-academy-id "e-9515"} :knowledge-point/id #uuid "223ec615-045d-543e-96f4-fec8882bec9e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048512} {:db/id #edb/ref 17592186050666}] :knowledge-point/questions [{:db/id #edb/ref 17592186180009} {:db/id #edb/ref 17592186180284} {:db/id #edb/ref 17592186259699} {:db/id #edb/ref 17592186259702} 