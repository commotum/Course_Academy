39534237 17592186045417 true] [17592186415438 1078 #edb/ref 17592186415417 13194139534237 17592186045417 true] [17592186415438 1079 #uuid "b64329ed-5836-53c3-881a-5ef3bf67996e" 13194139534237 17592186045417 true] [17592186415439 1068 #edb/ref 17592186415433 13194139534237 17592186045417 true] [17592186415439 1069 "q-81186" 13194139534237 17592186045417 true] [17592186415439 1070 #edb/ref 17592186045487 13194139534237 17592186045417 true] [17592186415439 1071 "Evaluate ${\\int }_{C}y\\,dx+x\\,dy,$ where $C$ is part of the circle ${x}^{2}+{y}^{2}=4$ traversed in the counterclockwise direction from the point $A(-2,0)$ to the point $B(0,-2).$" 13194139534237 17592186045417 true] [17592186415439 1072 #uuid "228970be-ca08-547c-9937-b7e76a0b4145" 13194139534237 17592186045417 true] [17592186415439 1074 "First, we need to find the parametrization of the curve $C.$ Since it's a circle if radius $2$ centered at the origin, the curve $C$ can be parametrized as follows:\n\n$$\n\\begin{aligned}r(t) & =x(t)\\,i+y(t)\\,j=2\\operatorname{cos}⁡(t)\\,i+2\\operatorname{sin}⁡(t)\\,j,\\,t\\in [\\pi ,\\frac{3\\pi }{2}].\\end{aligned}\n$$\n\nSo, along the curve we have that $x(t)=2\\operatorname{cos}⁡t$ and $y(t)=2\\operatorname{sin}⁡t.$ \n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=-2\\operatorname{sin}⁡(t)\\,i+2\\operatorname{cos}⁡(t)\\,j.\\end{aligned}\n$$\n\nTherefore, we can calculate the line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}y\\,dx+x\\,dy & ={\\int }_{\\pi }^{3\\pi /2}y\\,\\frac{dx}{\\text{d}t}\\,\\text{d}t+x\\,\\frac{dy}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{3\\pi /2}(y\\,\\frac{dx}{\\text{d}t}+x\\,\\frac{dy}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{\\pi }^{3\\pi /2}(2\\operatorname{sin}⁡t\\cdot (-2\\operatorname{sin}⁡t)+2\\operatorname{cos}⁡t\\cdot 2\\operatorname{cos}⁡t)\\text{d}t \\\\  & ={\\int }_{\\pi }^{3\\pi /2}(-4{sin}^{2}⁡t+4{cos}^{2}⁡t)\\text{d}t \\\\  & =4{\\int }_{\\pi }^{3\\pi /2}({cos}^{2}⁡t-{sin}^{2}⁡t)\\text{d}t \\\\  & =4{\\int }_{\\pi }^{3\\pi /2}\\operatorname{cos}⁡(2t)\\,\\text{d}t \\\\  & =2\\operatorname{sin}⁡2t{|}_{\\pi }^{3\\pi /2} \\\\  & =2[\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(2\\pi )] \\\\  & =2(0-0) \\\\  & =0\\end{aligned}\n$$" 13194139534237 17592186045417 true] [17592186415440 1068 #edb/ref 17592186415438 13194139534237 17592186045417 true] [17592186415440 1069 "q-90895" 13194139534237 17592186045417 true] [17592186415440 1070 #edb/ref 17592186045487 13194139534237 17592186045417 true] [17592186415440 1071 "Evaluate ${\\int }_{C}y\\,dx-x\\,dy,$ where $C$ is part of the circle ${x}^{2}+{y}^{2}=2$ traversed in the counterclockwise direction from the point $A(\\sqrt{2},0)$ to the point $B(0,\\sqrt{2}).$" 13194139534237 17592186045417 true] [17592186415440 1072 #uuid "26043436-d017-5e07-ac9c-a4df40dc0429" 13194139534237 17592186045417 true] [17592186415440 1074 "First, we need to find the parametrization of the curve $C.$ Since it's a circle if radius $\\sqrt{2}$ centered at the origin, the curve $C$ can be parametrized as follows:\n\n$$\n\\begin{aligned}r(t) & =x(t)\\,i+y(t)\\,j=\\sqrt{2}\\operatorname{cos}⁡(t)\\,i+\\sqrt{2}\\operatorname{sin}⁡(t)\\,j,\\,t\\in [0,\\frac{\\pi }{2}].\\end{aligned}\n$$\n\nSo, along the curve we have that $x(t)=\\sqrt{2}\\operatorname{cos}⁡t$ and $y(t)=\\sqrt{2}\\operatorname{sin}⁡t.$ \n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=-\\sqrt{2}\\operatorname{sin}⁡(t)\\,i+\\sqrt{2}\\operatorname{cos}⁡(t)\\,j.\\end{aligned}\n$$\n\nTherefore, we can calculate the line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}y\\,dx-x\\,dy & ={\\int }_{0}^{\\pi /2}y\\,\\frac{dx}{\\text{d}t}\\,\\text{d}t-x\\,\\frac{dy}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}(y\\,\\frac{dx}{\\text{d}t}-x\\,\\frac{dy}{\\text{d}t})\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}(\\sqrt{2}\\operatorname{sin}⁡t\\cdot (-\\sqrt{2}\\operatorname{sin}⁡t)-\\sqrt{2}\\operatorname{cos}⁡t\\cdot \\sqrt{2}\\operatorname{cos}⁡t)\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}(-2{sin}^{2}⁡t-2{cos}^{2}⁡t)\\text{d}t \\\\  & =-2{\\int }_{0}^{\\pi /2}\\text{d}t \\\\  & =-2t{|}_{0}^{\\pi /2} \\\\  & =-2[\\frac{\\pi }{2}-0] \\\\  & =-\\pi \\end{aligned}\n$$" 13194139534237 17592186045417 true] [17592186415441 1068 #edb/ref 17592186415435 13194139534237 17592186045417 true] [17592186415441 1069 "q-124660" 13194139534237 17592186045417 true] [17592186415441 1070 #edb/ref 17592186045485 13194139534237 17592186045417 true] [17592186415441 1071 "If the path $C$ is the line segment $\\overset{―}{AB}$ traversed from the point $A(0,0)$ to the point $B(1,1),$ then ${\\int }_{C}\\operatorname{sin}⁡\\pi y\\,dx-\\operatorname{cos}⁡\\pi x\\,dy=$" 13194139534237 17592186045417 true] [17592186415441 1072 #uuid "36f8b820-02e2-5d5e-8155-bd2e7c9da1db" 13194139534237 17592186045417 true] [17592186415441 1074 "The position vectors of the endpoints of our line segment are $a=0\\,i+0\\,j$ and $b=i+j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =0\\,i+0\\,j+t(i+j-(0\\,i+0\\,j)) \\\\  & =t\\,i+t\\,j,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x(t)=t$ and $y(t)=t$ along the segment.\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=i+j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}\\operatorname{sin}⁡\\pi y\\,dx-\\operatorname{cos}⁡\\pi x\\,dy & ={\\int }_{0}^{1}\\operatorname{sin}⁡\\pi y\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t-\\operatorname{cos}⁡\\pi x\\,\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}(\\operatorname{sin}⁡\\pi y\\,\\frac{\\text{d}x}{\\text{d}t}-\\operatorname{cos}⁡\\pi x\\,\\frac{\\text{d}y}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{1}\\operatorname{sin}⁡\\pi t\\cdot 1-\\operatorname{cos}⁡\\pi t\\cdot 1\\,dt \\\\  & ={\\int }_{0}^{1}\\operatorname{sin}⁡\\pi t-\\operatorname{cos}⁡\\pi t\\,dt \\\\  & ={[-\\frac{\\operatorname{cos}⁡\\pi t}{\\pi }-\\frac{\\operatorname{sin}⁡\\pi t}{\\pi }]}_{0}^{1} \\\\  & =-\\frac{1}{\\pi }[\\operatorname{cos}⁡(\\pi )+\\operatorname{sin}⁡(\\pi )-\\operatorname{cos}⁡(0)-\\operatorname{sin}⁡(0)] \\\\  & =-\\frac{1}{\\pi }[-1+0-1-0] \\\\  & =\\frac{2}{\\pi }\\end{aligned}\n$$" 13194139534237 17592186045417 true] [17592186415442 1068 #edb/ref 17592186415436 13194139534237 17592186045417 true] [17592186415442 1069 "q-124666" 13194139534237 17592186045417 true] [17592186415442 1070 #edb/ref 17592186045487 13194139534237 17592186045417 true] [17592186415442 1071 "If the path $C$ is a part of the graph $y={x}^{2}-1$ traversed from the point $P(1,0)$ to point $Q(2,3),$ then ${\\int }_{C}{y}^{2}\\,dx+x\\,dy=$" 13194139534237 17592186045417 true] [17592186415442 1072 #uuid "4ee6b1fc-a5dc-5685-b3c9-ad25e0e1efc1" 13194139534237 17592186045417 true] [17592186415442 1074 "Notice that our curve is given by the explicit Cartesian equation $y={x}^{2}-1.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}r(t)=x(t)\\,i+y(t)\\,j=t\\,i+({t}^{2}-1)\\,j,\\,t\\in [1,2]\\end{aligned}\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=i+2t\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}{y}^{2}\\,dx+x\\,dy & ={\\int }_{1}^{2}{y}^{2}\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+x\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}({y}^{2}\\,\\frac{\\text{d}x}{\\text{d}t}+x\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{1}^{2}{({t}^{2}-1)}^{2}\\cdot 1+t\\cdot 2t\\,dt \\\\  & ={\\int }_{1}^{2}{t}^{4}-2{t}^{2}+1+2{t}^{2}\\,dt \\\\  & ={\\int }_{1}^{2}{t}^{4}+1\\,dt \\\\  & ={[\\frac{{t}^{5}}{5}+t]}_{1}^{2} \\\\  & =[\\frac{{2}^{5}}{5}+2]-[\\frac{{1}^{5}}{5}+1] \\\\  & =\\frac{32}{5}+2-\\frac{1}{5}-1 \\\\  & =\\frac{36}{5}\\end{aligned}\n$$" 13194139534237 17592186045417 true] [17592186415443 1068 #edb/ref 17592186415437 13194139534237 17592186045417 true] [17592186415443 1069 "q-90714" 13194139534237 17592186045417 true] [17592186415443 1070 #edb/ref 17592186045485 13194139534237 17592186045417 true] [17592186415443 1071 "If the path $C$ is the line segment $\\overset{―}{FG}$ traversed from the point $F(1,0)$ to the point $G(2,3),$ then ${\\int }_{C}x\\,dx-xy\\,dy=$" 13194139534237 17592186045417 true] [17592186415443 1072 #uuid "b73ad7ec-dc24-5c99-a917-9ce5919adbcd" 13194139534237 17592186045417 true] [17592186415443 1074 "The position vectors of the endpoints of our line segment are $a=i$ and $b=2\\,i+3\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =i+t(2\\,i+3\\,j-i) \\\\  & =i+t(i+3\\,j) \\\\  & =(1+t)\\,i+3t\\,j,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x(t)=1+t$ and $y(t)=3t$ along the segment.\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=i+3\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}x\\,dx-xy\\,dy & ={\\int }_{0}^{1}x\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t-xy\\,\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}(x\\,\\frac{\\text{d}x}{\\text{d}t}-xy\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}(1+t)\\cdot 1-(1+t)\\cdot 3t\\cdot 3\\,dt \\\\  & ={\\int }_{0}^{1}1-8t-9{t}^{2}\\,dt \\\\  & ={[t-4{t}^{2}-3{t}^{3}]}_{0}^{1} \\\\  & =[1-4(1)^{2}-3(1)^{3}]-[0] \\\\  & =-6\\end{aligned}\n$$" 13194139534237 17592186045417 true]] :edb/tempids {"answer-225888f9-79d1-51ec-b69e-df715e48a48c" 17592186415403 "answer-256764