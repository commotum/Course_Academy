#{[{:db/id #edb/ref 17592186535954 :knowledge-point/_questions [{:db/id #edb/ref 17592186096718 :knowledge-point/id #uuid "6d62ff71-fe48-5612-8f37-bab7cb7f2931" :knowledge-point/title "Calculating the Average Acceleration of a Particle Given Its Velocity Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12b4a368-f228-50e0-a65e-e556685ce4e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186535467}] :answer-field/correct {:answer/id #uuid "12b4a368-f228-50e0-a65e-e556685ce4e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186535467} :answer-field/id #uuid "82e292da-04ee-55d1-86e2-4a2230088d1d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535878}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f1c0a58-fb01-5814-8e30-7c47e655e50c" :question/math-academy-id "q-353938" :question/problem "A robotic rover moves in a straight line with velocity \n$v(t)=3{t}^{2}-t,$ where $t$ is measured in seconds and $v$ is measured in meters per second. \n\nFind the average acceleration ${a}_{\\text{avg}}$ of the rover over the time interval $t\\in [0,2].$ Do not round your answer.\n\n${a}_{\\text{avg}}=$ \n{{field-1}}\n${\\text{m/s}}^{2}$" :question/worked-solution "The average acceleration is the average rate of change of the velocity, so\n\n$$\n\\begin{aligned}{a}_{\\text{avg}} & =\\frac{v(b)-v(a)}{b-a} \\\\  & =\\frac{v(2)-v(0)}{2-0} \\\\  & =\\frac{[3(2)^{2}-2]-[3(0)^{2}-0]}{2} \\\\  & =\\frac{(12-2)-0}{2} \\\\  & =\\frac{10}{2} \\\\  & =5\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$\n\nTherefore, the average acceleration is $5\\,{\\text{m/s}}^{2}.$"}] [{:db/id #edb/ref 17592186535989 :knowledge-point/_questions [{:db/id #edb/ref 17592186096719 :knowledge-point/id #uuid "803ac4f0-61fe-5efc-b7a5-c73a4235f4bc" :knowledge-point/title "Calculating the Average Velocity of a Particle Using Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "561dec26-edfd-5f06-be74-04ce011e37e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32}{9}" :db/id #edb/ref 17592186535571}] :answer-field/correct {:answer/id #uuid "561dec26-edfd-5f06-be74-04ce011e37e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32}{9}" :db/id #edb/ref 17592186535571} :answer-field/id #uuid "8d89cc03-11cb-5a33-a4d3-defd63d2cbf9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535883}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c00bebe5-d517-59a2-a7ee-fce25fbbc516" :question/math-academy-id "q-354478" :question/problem "A small rover moves along a straight track with velocity \n$v(t)=\\sqrt{t}+2,$ where $t$ is measured in seconds and $v$ is measured in meters per second.\n\nFind the average velocity ${v}_{\\text{avg}}$ on the interval $[1,4].$ Do not round your answer.\n\n${v}_{\\text{avg}}=$ \n{{field-1}}\n$\\text{m/s}$" :question/worked-solution "To calculate the average value of the velocity on $[{t}_{1},{t}_{2}],$ we use the average value formula\n\n$$\n{v}_{\\text{avg}}=\\frac{1}{{t}_{2}-{t}_{1}}{\\int }_{{t}_{1}}^{{t}_{2}}v(t)\\,\\text{d}t.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}{v}_{\\text{avg}} & =\\frac{1}{4-1}{\\int }_{1}^{4}(\\sqrt{t}+2)\\,\\text{d}t \\\\  & =\\frac{1}{3}{(\\frac{2}{3}{t}^{3/2}+2t)|}_{1}^{4} \\\\  & =\\frac{1}{3}[(\\frac{2}{3}\\cdot 8+8)-(\\frac{2}{3}\\cdot 1+2)] \\\\  & =\\frac{1}{3}[(\\frac{16}{3}+8)-(\\frac{2}{3}+2)] \\\\  & =\\frac{1}{3}[\\frac{40}{3}-\\frac{8}{3}] \\\\  & =\\frac{1}{3}(\\frac{32}{3}) \\\\  & =\\frac{32}{9}\\,\\text{m/s}.\\end{aligned}\n$$\n\nTherefore, the average velocity is $\\frac{32}{9}\\,\\text{m/s}.$"}] [{:db/id #edb/ref 17592186535972 :knowledge-point/_questions [{:db/id #edb/ref 17592186096720 :knowledge-point/id #uuid "3046ebca-8a30-5228-a003-b8155cd1a62a" :knowledge-point/title "Calculating the Average Position or Acceleration of a Particle Using Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5859ef23-64ea-5f95-8062-f7664d1b6145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{9}" :db/id #edb/ref 17592186535576}] :answer-field/correct {:answer/id #uuid "5859ef23-64ea-5f95-8062-f7664d1b6145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{9}" :db/id #edb/ref 17592186535576} :answer-field/id #uuid "2ab3c0e2-4bdc-50da-b2cf-5a837a9baa2c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "948c8637-9616-53cf-93bb-0432892cbe59" :question/math-academy-id "q-354500" :question/problem "A particle’s acceleration in ${\\text{m/s}}^{2}$ is given by the function $a(t)=\\sqrt{t},$ where $t$ is the time in seconds.  \n\nFind the average acceleration ${a}_{\\text{avg}}$ of the particle on the interval $[1,4].$ Do not round your answer.\n\n${a}_{\\text{avg}}=$ \n{{field-1}}\n${\\text{m/s}}^{2}$" :question/worked-solution "To calculate the average value of the acceleration on $[{t}_{1},{t}_{2}],$ we use the average value formula\n\n$$\n{a}_{\\text{avg}}=\\frac{1}{{t}_{2}-{t}_{1}}{\\int }_{{t}_{1}}^{{t}_{2}}a(t)\\,\\text{d}t.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}{a}_{\\text{avg}} & =\\frac{1}{4-1}{\\int }_{1}^{4}\\sqrt{t}\\,\\text{d}t \\\\  & =\\frac{1}{3}{(\\frac{2}{3}{t}^{3/2})|}_{1}^{4} \\\\  & =\\frac{1}{3}[(\\frac{2}{3}\\cdot 8)-(\\frac{2}{3}\\cdot 1)] \\\\  & =\\frac{1}{3}(\\frac{16}{3}-\\frac{2}{3}) \\\\  & =\\frac{1}{3}(\\frac{14}{3}) \\\\  & =\\frac{14}{9}\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$\n\nTherefore, the average acceleration is $\\frac{14}{9}\\,{\\text{m/s}}^{2}.$"}] [{:db/id #edb/ref 17592186097292 :knowledge-point/_questions [{:db/id #edb/ref 17592186096720 :knowledge-point/id #uuid "3046ebca-8a30-5228-a003-b8155cd1a62a" :knowledge-point/title "Calculating the Average Position or Acceleration of a Particle Using Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04edbe72-2860-5445-9b78-8c22cc20067e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32\\,\\text{m}" :db/id #edb/ref 17592186535444} {:answer/id #uuid "42d18385-9cde-5883-ac5a-37781eda6692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "31\\,\\text{m}" :db/id #edb/ref 17592186535538} {:answer/id #uuid "b4d8c80f-bf74-5759-9834-cd33f9e368f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{63}{2}\\,\\text{m}" :db/id #edb/ref 17592186535712} {:answer/id #uuid "e90ae4b7-57a0-56d4-b078-d5b219cd95b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,\\text{m}" :db/id #edb/ref 17592186535795} {:answer/id #uuid "f81b9df8-fff8-5d97-9c34-430dd36b2e04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{31}{2}\\,\\text{m}" :db/id #edb/ref 17592186535814}] :answer-field/correct {:answer/id #uuid "42d18385-9cde-5883-ac5a-37781eda6692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "31\\,\\text{m}" :db/id #edb/ref 17592186535538} :answer-field/id #uuid "e2f77a72-36b9-58bf-9d44-3ce7efb23445" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095676}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "06277fd5-c6be-5879-81ac-2b86cefe4004" :question/math-academy-id "q-50029" :question/problem "A cat’s position relative to a fixed origin $O$ is given by the function $x(t)=3{t}^{2}+t$ meters, where $t$ is the time in hours. Find the average position of the cat between $2$ and $4$ hours." :question/requires-calculator true :question/worked-solution "To calculate the average value of the position on $[{t}_{1},{t}_{2}],$ we use the average value formula\n\n$$\n{x}_{\\text{avg}}=\\frac{1}{{t}_{2}-{t}_{1}}\\,{\\int }_{{t}_{1}}^{{t}_{2}}x(t)\\,\\text{d}t.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}{x}_{\\text{avg}} & =\\frac{1}{4-2}\\,{\\int }_{2}^{4}(3{t}^{2}+t)\\,\\text{d}t \\\\  & =\\frac{1}{2}{({t}^{3}+\\frac{{t}^{2}}{2})|}_{2}^{4} \\\\  & =\\frac{1}{2}[({4}^{3}+\\frac{{4}^{2}}{2})-({2}^{3}+\\frac{{2}^{2}}{2})] \\\\  & =\\frac{1}{2}[(64+8)-(8+2)] \\\\  & =31.\\end{aligned}\n$$\n\nTherefore, the average position is $31\\,\\text{m}.$"}] [{:db/id #edb/ref 17592186097294 :knowledge-point/_questions [{:db/id #edb/ref 17592186096719 :knowledge-point/id #uuid "803ac4f0-61fe-5efc-b7a5-c73a4235f4bc" :knowledge-point/title "Calculating the Average Velocity of a Particle Using Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44246c94-6d8c-5f04-baa0-79045398a988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "166\\,\\text{km/h}" :db/id #edb/ref 17592186535540} {:answer/id #uuid "7e5d16bc-cb25-52d2-b98e-5bb7f17439e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160\\,\\text{km/h}" :db/id #edb/ref 17592186535633} {:answer/id #uuid "81eb2493-7567-5c70-bfd8-ceecf2a4addb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "158\\,\\text{km/h}" :db/id #edb/ref 17592186535641} {:answer/id #uuid "b0d18fe2-8169-5eb1-b785-85e842c937f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "162\\,\\text{km/h}" :db/id #edb/ref 17592186535707} {:answer/id #uuid "c0e9b334-945a-5161-b29a-cb81ea2bb950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "164\\,\\text{km/h}" :db/id #edb/ref 17592186535730}] :answer-field/correct {:answer/id #uuid "b0d18fe2-8169-5eb1-b785-85e842c937f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "162\\,\\text{km/h}" :db/id #edb/ref 17592186535707} :answer-field/id #uuid "aa9db443-300e-5082-920a-12147e35440b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095688}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e6f31648-32f5-5f87-b9bb-fc4d6a7438c9" :question/math-academy-id "q-50036" :question/problem "A train is moving north-east with velocity $v(t)=6{t}^{2}+8t+100\\,\\text{km/h},$ where $t$ is the time in hours. Find the average velocity of the train on the interval $t\\in [1,4].$" :question/requires-calculator true :question/worked-solution "To calculate the average value of the velocity on $[{t}_{1},{t}_{2}],$ we use the average value formula\n\n$$\n{v}_{\\text{avg}}=\\frac{1}{{t}_{2}-{t}_{1}}{\\int }_{{t}_{1}}^{{t}_{2}}v(t)\\,\\text{d}t.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}{v}_{\\text{avg}} & =\\frac{1}{4-1}\\,{\\int }_{1}^{4}(6{t}^{2}+8t+100)\\text{d}t \\\\  & =\\frac{1}{3}(2{t}^{3}+4{t}^{2}+100t){|}_{1}^{4} \\\\  & =\\frac{1}{3}((2(4)^{3}+4(4)^{2}+100(4))-(2(1)^{3}+4(1)^{2}+100(1))) \\\\  & =\\frac{1}{3}((128+64+400)-(2+4+100)) \\\\  & =162.\\end{aligned}\n$$\n\nTherefore, the average velocity is $162\\,\\text{km/h}.$"}]}
