03b7-5e8d-a4e5-e4bf91fb6e3a" #edb/ref 17592186045417] [17592186269244 #edb/ref 1068 #edb/ref 17592186268633 #edb/ref 17592186045417] [17592186269244 #edb/ref 1069 "q-139547" #edb/ref 17592186045417] [17592186269244 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186269244 #edb/ref 1071 "![](images/d4/d4947e37239d2ac2950b536d7afc2d0810ea713c437b7095a43e123d50ff2b34.png)\n\nA $2\\times 3$ matrix $A$ maps the unit sphere ${x\\,|\\,‖x‖=1}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ The corresponding ellipse and its principal axes are depicted in the diagram above. Given that ${v}_{1}$ and ${v}_{2}$ are unit eigenvectors of ${A}^{T}A,$ what are the nonzero singular values of $A?$" #edb/ref 17592186045417] [17592186269244 #edb/ref 1072 #uuid "f71d275b-8f83-5bf3-90f9-5e8ed34d76ff" #edb/ref 17592186045417] [17592186269244 #edb/ref 1074 "Suppose $A$ is an $m\\times n$ matrix. Let \n\n$$\n{{v}_{1},{v}_{2}\\,…,{v}_{n}}\n$$\n\nbe an *orthonormal* basis of ${R}^{n}$ consisting of the eigenvectors of ${A}^{T}A$ with corresponding eigenvalues \n\n$$\n{\\lambda }_{1}\\ge {\\lambda }_{2}\\ge …\\ge {\\lambda }_{n}.\n$$\n\nThen,\n\n- ${\\sigma }_{1}=\\sqrt{{\\lambda }_{1}}$ is the length of $A{v}_{1},$\n\n- ${\\sigma }_{2}=\\sqrt{{\\lambda }_{2}}$ is the length of $A{v}_{2},$\n\n- $⋯$\n\nIn our example, we see that\n\n- $||A{v}_{1}||=8={\\sigma }_{1},$ and\n\n- $||A{v}_{2}||=5={\\sigma }_{2}.$\n\nTherefore, the nonzero singular values of $A$ are ${\\sigma }_{1}=8$ and ${\\sigma }_{2}=5.$" #edb/ref 17592186045417] [17592186269246 #edb/ref 1068 #edb/ref 17592186268634 #edb/ref 17592186045417] [17592186269246 #edb/ref 1069 "q-139555" #edb/ref 17592186045417] [17592186269246 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186269246 #edb/ref 1071 "![](images/2d/2d1cefc0c789518d21279c5c49a18f80220a2aad80973f0e84fda0ddaf25493b.png)\n\nA $2\\times 2$ matrix $A$ maps the unit circle ${x\\,|\\,‖x‖=1}$ from ${R}^{2}$ onto an ellipse in ${R}^{2}.$ The corresponding ellipse and its principal axes are depicted in the diagram above. Given that ${v}_{1}$ and ${v}_{2}$ are unit eigenvectors of ${A}^{T}A,$ which of the following is an eigenvector corresponding to the eigenvalue $100$ of ${A}^{T}A?$" #edb/ref 17592186045417] [17592186269246 #edb/ref 1072 #uuid "5f621452-f60c-5e1d-b4df-620aa05fd780" #edb/ref 17592186045417] [17592186269246 #edb/ref 1074 "Suppose $A$ is an $m\\times n$ matrix. Let \n\n$$\n{{v}_{1},{v}_{2}\\,…,{v}_{n}}\n$$\n\nbe an *orthonormal* basis of ${R}^{n}$ consisting of the eigenvectors of ${A}^{T}A$ with corresponding eigenvalues \n\n$$\n{\\lambda }_{1}\\ge {\\lambda }_{2}\\ge …\\ge {\\lambda }_{n}.\n$$\n\nThen,\n\n- ${\\sigma }_{1}=\\sqrt{{\\lambda }_{1}}$ is the length of $A{v}_{1},$\n\n- ${\\sigma }_{2}=\\sqrt{{\\lambda }_{2}}$ is the length of $A{v}_{2},$\n\n- $⋯$\n\nIn our example, we see that\n\n- $||A{v}_{1}||=10={\\sigma }_{1},$ which means that ${\\lambda }_{1}={10}^{2}=100,$ and\n\n- $||A{v}_{2}||=8={\\sigma }_{2},$ which means that ${\\lambda }_{2}={8}^{2}=64.$\n\nTherefore, an eigenvector corresponding to the eigenvalue ${\\lambda }_{1}=100$ of ${A}^{T}A$ is ${v}_{1}.$" #edb/ref 17592186045417] [17592186369714 #edb/ref 1075 #edb/ref 17592186369715 #edb/ref 17592186045417] [17592186369714 #edb/ref 1075 #edb/ref 17592186369716 #edb/ref 17592186045417] [17592186369714 #edb/ref 1075 #edb/ref 17592186369717 #edb/ref 17592186045417] [17592186369714 #edb/ref 1075 #edb/ref 17592186369718 #edb/ref 17592186045417] [17592186369714 #edb/ref 1075 #edb/ref 17592186369719 #edb/ref 17592186045417] [17592186369714 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186369714 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186369714 #edb/ref 1078 #edb/ref 17592186369716 #edb/ref 17592186045417] [17592186369714 #edb/ref 1079 #uuid "12561a6a-dd60-5043-b724-be8966244b1b" #edb/ref 17592186045417] [17592186369715 #edb/ref 1080 "9" #edb/ref 17592186045417] [17592186369715 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369715 #edb/ref 1083 #uuid "843730e5-1d6c-590a-be6f-f5bc76d354a2" #edb/ref 17592186045417] [17592186369716 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186369716 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369716 #edb/ref 1083 #uuid "7d127bbd-7566-53f6-8abe-dfa396d7a93b" #edb/ref 17592186045417] [17592186369717 #edb/ref 1080 "\\sqrt{3}" #edb/ref 17592186045417] [17592186369717 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369717 #edb/ref 1083 #uuid "9b31420c-6449-52e6-a9be-475a6ec94b85" #edb/ref 17592186045417] [17592186369718 #edb/ref 1080 "8" #edb/ref 17592186045417] [17592186369718 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369718 #edb/ref 1083 #uuid "b308a8e3-0047-576e-8cfc-a0c1e309ab3c" #edb/ref 17592186045417] [17592186369719 #edb/ref 1080 "2\\sqrt{2}" #edb/ref 17592186045417] [17592186369719 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369719 #edb/ref 1083 #uuid "fdcdf069-d67b-5c89-b3b7-b34c02297e84" #edb/ref 17592186045417] [17592186369734 #edb/ref 1068 #edb/ref 17592186369735 #edb/ref 17592186045417] [17592186369734 #edb/ref 1069 "q-139536" #edb/ref 17592186045417] [17592186369734 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186369734 #edb/ref 1071 "A $2\\times 2$ matrix $A$ maps the unit circle ${x\\,|\\,‖x‖=1}$ from ${R}^{2}$ onto an ellipse in ${R}^{2}.$ Given that the singular values of $A$ are ${\\sigma }_{1}=11$ and ${\\sigma }_{2}=3\\sqrt{3},$ find the length of the semi-major axis of the ellipse." #edb/ref 17592186045417] [17592186369734 #edb/ref 1072 #uuid "26241502-86a3-53fb-a4ec-a6023ba45794" #edb/ref 17592186045417] [17592186369734 #edb/ref 1074 "The matrix $A$ maps the unit circle ${x\\,|\\,‖x‖=1}$ from ${R}^{2}$ onto the ellipse ${Ax\\,|\\,‖x‖=1}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the symmetric matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$ \n\nThe square roots of the eigenvalues of ${A}^{T}A$ are called the *singular values* of $A.$ Since the largest singular value of $A$ is ${\\sigma }_{1}=11,$ the largest eigenvalue of ${A}^{T}A$ must be ${\\lambda }_{1}={\\sigma }_{1}^{2}={11}^{2}.$ So, we obtain that\n\n$$\n{max}_{‖x‖=1}{‖Ax{‖}^{2}}={11}^{2}\\,⟹\\,{max}_{‖x‖=1}{‖Ax‖}=11.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is ${\\sigma }_{1}=11.$" #edb/ref 17592186045417] [17592186369735 #edb/ref 1075 #edb/ref 17592186369736 #edb/ref 17592186045417] [17592186369735 #edb/ref 1075 #edb/ref 17592186369737 #edb/ref 17592186045417] [17592186369735 #edb/ref 1075 #edb/ref 17592186369738 #edb/ref 17592186045417] [17592186369735 #edb/ref 1075 #edb/ref 17592186369739 #edb/ref 17592186045417] [17592186369735 #edb/ref 1075 #edb/ref 17592186369740 #edb/ref 17592186045417] [17592186369735 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186369735 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186369735 #edb/ref 1078 #edb/ref 17592186369738 #edb/ref 17592186045417] [17592186369735 #edb/ref 1079 #uuid "90c9b181-3d57-5309-98db-647cea5eb04e" #edb/ref 17592186045417] [17592186369736 #edb/ref 1080 "9" #edb/ref 17592186045417] [17592186369736 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369736 #edb/ref 1083 #uuid "1121018b-9990-5e8d-875a-4699d6eff1d1" #edb/ref 17592186045417] [17592186369737 #edb/ref 1080 "\\sqrt{11}" #edb/ref 17592186045417] [17592186369737 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369737 #edb/ref 1083 #uuid "11ca46e8-c877-512b-b761-4afdcf87aea2" #edb/ref 17592186045417] [17592186369738 #edb/ref 1080 "11" #edb/ref 17592186045417] [17592186369738 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369738 #edb/ref 1083 #uuid "24c9aa0d-688d-5de3-bf46-b7faa7b10dc4" #edb/ref 17592186045417] [17592186369739 #edb/ref 1080 "\\sqrt{3}" #edb/ref 17592186045417] [17592186369739 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369739 #edb/ref 1083 #uuid "779e6a3e-9b87-50db-92fd-b72e345a265b" #edb/ref 17592186045417] [17592186369740 #edb/ref 1080 "3\\sqrt{3}" #edb/ref 17592186045417] [17592186369740 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186369740 #edb/ref 1083 #uuid "15aacf44-9909-5b15-91a3-740aeedf74a7" #edb/ref 17592186045417]}
