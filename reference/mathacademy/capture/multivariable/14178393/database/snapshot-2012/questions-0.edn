#{[{:db/id #edb/ref 17592186167245 :knowledge-point/_questions [{:db/id #edb/ref 17592186166923 :knowledge-point/id #uuid "4f77fc78-6c6b-5dd0-ac2b-7822e4cb961f" :knowledge-point/title "Finding Equilibrium Points of the Lotka-Volterra System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f5c3169-d779-521a-8197-1104e5c087d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186495867}] :answer-field/correct {:answer/id #uuid "9f5c3169-d779-521a-8197-1104e5c087d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186495867} :answer-field/id #uuid "d2a964f9-cc26-5d58-9dc8-4e4f3ec7ff0d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186164545} {:answer-field/choices [{:answer/id #uuid "a18a65b5-78bf-5bcc-a5ae-bc42d6062064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186495871}] :answer-field/correct {:answer/id #uuid "a18a65b5-78bf-5bcc-a5ae-bc42d6062064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186495871} :answer-field/id #uuid "eecf0f04-faa2-5ba0-be4b-55b15c49c548" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186164546}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a1666d90-74ae-56ff-b146-0bf87963aa16" :question/math-academy-id "q-334640" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}=2x-3xy \\\\ {y}^{′}=-5y+4xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model above, where $x=x(t)$ represents the prey and $y=y(t)$ represents the predators. Find the nonzero equilibrium of the model.\n\n$(${{field-1}}\n$,$\n{{field-2}}$)$" :question/worked-solution "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of linear equations:\n\n$$\n\\{\\begin{aligned}2x-3xy=0 \\\\ -5y+4xy=0\\end{aligned}\n$$\n\nSolving the first equation, we get\n\n$$\n\\begin{aligned}2x-3xy & =0 \\\\ x(2-3y) & =0.\\end{aligned}\n$$\n\nSo, $x=0$ or $y=\\frac{2}{3}.$ We consider both cases separately.\n\n- If $x=0,$ substituting it into the second equation, we have\n\n$$\n\\begin{aligned}-5y+4(0)y=0\\,⇒\\,y=0.\\end{aligned}\n$$\n\nThus, one equilibrium is $(0,0).$\n\n- If $y=\\frac{2}{3},$ substituting it into the second equation, we have\n\n$$\n\\begin{aligned}-5y+4xy & =0 \\\\ y(-5+4x) & =0 \\\\ \\frac{2}{3}(-5+4x) & =0 \\\\ -5+4x & =0 \\\\ x & =\\frac{5}{4}.\\end{aligned}\n$$\n\nThus, another equilibrium is $(\\frac{5}{4},\\frac{2}{3}).$\n\nTherefore, the nonzero equilibrium of the model is\n$(\\frac{5}{4},\\frac{2}{3}).$"}] [{:db/id #edb/ref 17592186370181 :knowledge-point/_questions [{:db/id #edb/ref 17592186166923 :knowledge-point/id #uuid "4f77fc78-6c6b-5dd0-ac2b-7822e4cb961f" :knowledge-point/title "Finding Equilibrium Points of the Lotka-Volterra System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7ca91be-1147-5049-8064-d763eb6133e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186370183}] :answer-field/correct {:answer/id #uuid "f7ca91be-1147-5049-8064-d763eb6133e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186370183} :answer-field/id #uuid "4f4acca5-dac1-54fa-9e21-9915bff82215" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370182} {:answer-field/choices [{:answer/id #uuid "412cc220-b5ee-5f02-87a4-33b233723962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186370185}] :answer-field/correct {:answer/id #uuid "412cc220-b5ee-5f02-87a4-33b233723962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186370185} :answer-field/id #uuid "96278b61-4187-511e-8e54-0a1a2d062155" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370184}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ef04316-d6de-5c0d-a680-25266abf9b77" :question/math-academy-id "q-334998" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}=6x-5xy \\\\ {y}^{′}=-7y+3xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model above, where $x=x(t)$ represents the prey and $y=y(t)$ represents the predators. Find the nonzero equilibrium of the model.\n\n$(${{field-1}}\n$,$\n{{field-2}}$)$" :question/worked-solution "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of linear equations:\n\n$$\n\\{\\begin{aligned}6x-5xy=0 \\\\ -7y+3xy=0\\end{aligned}\n$$\n\nSolving the first equation, we get\n\n$$\n\\begin{aligned}6x-5xy & =0 \\\\ x(6-5y) & =0.\\end{aligned}\n$$\n\nSo, $x=0$ or $y=\\frac{6}{5}.$ We consider both cases separately.\n\n- If $x=0,$ substituting it into the second equation, we have\n\n$$\n\\begin{aligned}-7y+3(0)y=0\\,⇒\\,y=0.\\end{aligned}\n$$\n\nThus, one equilibrium is $(0,0).$\n\n- If $y=\\frac{6}{5},$ substituting it into the second equation, we have\n\n$$\n\\begin{aligned}-7y+3xy & =0 \\\\ y(-7+3x) & =0 \\\\ \\frac{6}{5}(-7+3x) & =0 \\\\ -7+3x & =0 \\\\ x & =\\frac{7}{3}.\\end{aligned}\n$$\n\nThus, another equilibrium is $(\\frac{7}{3},\\frac{6}{5}).$\n\nTherefore, the nonzero equilibrium of the model is\n$(\\frac{7}{3},\\frac{6}{5}).$"}] [{:db/id #edb/ref 17592186370201 :knowledge-point/_questions [{:db/id #edb/ref 17592186166924 :knowledge-point/id #uuid "f1fa1647-1acb-50bd-95e7-26ed0c495bd4" :knowledge-point/title "Classifying Equilibria of the Lotka-Volterra Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71e64735-7edd-5494-af06-bbbb33ad6243" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186370203} {:answer/id #uuid "b3da64f5-e8b6-5e48-8c4a-eb58ea65cb85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186370204} {:answer/id #uuid "cc8ec66b-a1bf-5776-9bd9-e27f2ad9dd04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186370205} {:answer/id #uuid "34f063c9-2ad4-5270-bfe9-7a1136da9dd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186370206} {:answer/id #uuid "fe89431f-b8d5-5439-a4cc-38f3871d0d93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186370207}] :answer-field/correct {:answer/id #uuid "cc8ec66b-a1bf-5776-9bd9-e27f2ad9dd04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186370205} :answer-field/id #uuid "4ef9f7f0-f01e-58ff-b35e-f5b5ae651346" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186370202} {:answer-field/choices [{:answer/id #uuid "f4656f4c-6484-54dc-ae13-af40fabae14e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral sink" :db/id #edb/ref 17592186370209} {:answer/id #uuid "b81964b9-741d-5af6-9b71-405aeaf4fb3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral source" :db/id #edb/ref 17592186370