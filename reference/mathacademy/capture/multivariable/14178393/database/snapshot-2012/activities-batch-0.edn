92186045498} :answer/value "0" :db/id #edb/ref 17592186370227} {:answer/id #uuid "7abf4c6f-472e-5660-b9f5-a6f793a01f84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186370228} {:answer/id #uuid "767f81a2-4549-572f-a0ca-3d4761f6b605" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186370229}] :answer-field/correct {:db/id #edb/ref 17592186370227} :answer-field/id #uuid "0956ce2c-9f41-58ab-b1f4-0c6cbd8b8374" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186370224} {:answer-field/choices [{:answer/id #uuid "c825a4c6-ca12-56cd-86dd-328ca717174d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "a stable" :db/id #edb/ref 17592186370231} {:answer/id #uuid "c1322868-5de0-5d54-a941-842f5b359efc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "an asymptotically stable" :db/id #edb/ref 17592186370232} {:answer/id #uuid "13efac0c-a377-53e2-bf4d-da405b1a0200" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "an unstable" :db/id #edb/ref 17592186370233}] :answer-field/correct {:db/id #edb/ref 17592186370233} :answer-field/id #uuid "7ea4f603-eca1-5f34-ae2f-c1cbbbbf7bb2" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186370230} {:answer-field/choices [{:answer/id #uuid "e43f6c0a-1764-5e65-b6e1-15203fd2cf03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186370235} {:answer/id #uuid "61e2af4b-ee17-5880-9051-a40f0a30f1c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186370236} {:answer/id #uuid "c61b84a5-1108-5878-8da3-372dd27a7e00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186370237} {:answer/id #uuid "9e09dc0c-6ad4-5e93-80e0-5b63815671cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186370238} {:answer/id #uuid "f995075a-ec4a-54dc-8d31-72b28d14d079" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186370239}] :answer-field/correct {:db/id #edb/ref 17592186370236} :answer-field/id #uuid "53efb467-1771-57c2-a34a-f98af9fc7bb3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186370234}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "238e2eda-b356-520d-9329-99af591a6032" :question/math-academy-id "q-335008" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}=4x-2xy \\\\ {y}^{′}=-3y+5xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model above, where $x=x(t)$ represents the prey and $y=y(t)$ represents the predators. Select the correct options in the reasoning below.\n\n$\\,$ Evaluating the Jacobian of the system at the equilibrium ${x}^{∗}=[0,\\,0]^{T},$ we get\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$J({x}^{∗})=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"40px\">{{field-1}}</td>\n<td align=\"center\" width=\"40px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,.$</td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>\n\n$\\,$ The eigenvalues of the Jacobian matrix are \n{{field-5}}.\n\n$\\,$ Therefore, the equilibrium at ${x}^{∗}$ is \n{{field-6}}{{field-7}}." :question/worked-solution "Let's denote ${f}_{1}(x,y)=4x-2xy$ and ${f}_{2}(x,y)=-3y+5xy.$\n\nNow, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(4x-2xy)=4-2y,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(4x-2xy)=-2x \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(-3y+5xy)=5y,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(-3y+5xy)=-3+5x\\end{aligned}\n$$\n\nThus, the Jacobian matrix is\n\n$$\nJ=[\\begin{aligned}4-2y & -2x \\\\ 5y & -3+5x\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to get\n\n$$\nJ({x}^{∗})=[\\begin{aligned}4-2(0) & -2(0) \\\\ 5(0) & -3+5(0)\\end{aligned}]=[\\begin{aligned}4 & 0 \\\\ 0 & -3\\end{aligned}].\n$$\n\nThe eigenvalues of the Jacobian matrix are ${\\lambda }_{1}=4\\text{ and }{\\lambda }_{2}=-3.$ Since eigenvalues are real with opposite signs, our equilibrium is $\\text{an unstable}$ $\\text{saddle}.$"} :step/id #uuid "fdb3e243-a44e-5cfb-8bf4-f284a98094ba"}] :activity/title "The Lotka-Volterra Predator-Prey Model" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186495507}]}
