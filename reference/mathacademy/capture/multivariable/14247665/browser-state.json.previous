      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14247665/observations/step-q106583-8d4c748f5bf9af9039e5.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14247665/observations/step-q106583-8d4c748f5bf9af9039e5.png",
