9" :question/answer-fields "answer-field-25b8c52c-93f3-50f7-bc90-b28b8caa646b"] [17592186198457 :knowledge-point/questions "question-6bc5c0d6-8790-5f1a-b2ea-1f90b9088589"] ["question-677a9cb6-017c-50f2-b91d-96687fdfe48d" :question/id #uuid "677a9cb6-017c-50f2-b91d-96687fdfe48d"] ["question-677a9cb6-017c-50f2-b91d-96687fdfe48d" :question/math-academy-id "q-175403"] ["question-677a9cb6-017c-50f2-b91d-96687fdfe48d" :question/problem "$\\,$ $x$ divides $8.$\n\nThe predicate $P(x)$ is given above. Which of following represents $¬P(x)?$"] ["question-677a9cb6-017c-50f2-b91d-96687fdfe48d" :question/worked-solution "The symbol \"$¬$\" represents negation. So, our task is to negate the given sentence. \n\nTo negate our plain English sentence, we place the words \"It is not true that\" in front of it. This gives the following:\n\n$\\,$ It is not true that $x$ divides $8.$\n\nIn other words, $x$ does *not* divide $8.$ Therefore, $¬P(x)$ means the following:\n\n$\\,$ $x$ does **not** divide $8.$"] ["question-677a9cb6-017c-50f2-b91d-96687fdfe48d" :question/difficulty :question.difficulty/easy] ["answer-field-865644b8-65a0-53e4-9681-7d5de2ca9066" :answer-field/id #uuid "865644b8-65a0-53e4-9681-7d5de2ca9066"] ["answer-5e7c14a1-7856-5f07-8417-01492b343b03" :answer/id #uuid "5e7c14a1-7856-5f07-8417-01492b343b03"] ["answer-5e7c14a1-7856-5f07-8417-01492b343b03" :answer/type :answer.type/text] ["answer-5e7c14a1-7856-5f07-8417-01492b343b03" :answer/value "$8$ divides $x$"] ["answer-6b8b4cf9-b20a-5222-b2c6-b3835475c774" :answer/id #uuid "6b8b4cf9-b20a-5222-b2c6-b3835475c774"] ["answer-6b8b4cf9-b20a-5222-b2c6-b3835475c774" :answer/type :answer.type/text] ["answer-6b8b4cf9-b20a-5222-b2c6-b3835475c774" :answer/value "$8$ does not divide $x$"] ["answer-d3a88203-aff3-5411-95e3-bb5493a9c44c" :answer/id #uuid "d3a88203-aff3-5411-95e3-bb5493a9c44c"] ["answer-d3a88203-aff3-5411-95e3-bb5493a9c44c" :answer/type :answer.type/text] ["answer-d3a88203-aff3-5411-95e3-bb5493a9c44c" :answer/value "$x$ divi