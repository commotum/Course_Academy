[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186198457 :knowledge-point/questions ["question-3f57645e-6a86-5bd3-8b5a-df92495bea5e" "question-6bc5c0d6-8790-5f1a-b2ea-1f90b9088589" "question-677a9cb6-017c-50f2-b91d-96687fdfe48d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3f57645e-6a86-5bd3-8b5a-df92495bea5e" :question/id #uuid "3f57645e-6a86-5bd3-8b5a-df92495bea5e" :question/math-academy-id "q-175407" :question/problem "$\\,$ $5$ is equal to $x.$\n\nThe predicate $P(x)$ is given above. Which of following represents $¬P(x)?$" :question/worked-solution "The symbol \"$¬$\" represents negation. So, our task is to negate the given sentence. \n\nTo negate our plain English sentence, we place the words \"It is not true that\" in front of it. This gives the following:\n\n$\\,$ It is not true that $5$ is equal to $x.$\n\nIn other words, $5$ is *not* equal to $x.$ Therefore, $¬P(x)$ means the following:\n\n$\\,$ $5$ is **not** equal to $x.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d5cb436a-b53f-5af9-855c-293c1a829960"] :db/ensure [:question/validate]} {:db/id "answer-field-d5cb436a-b53f-5af9-855c-293c1a829960" :answer-field/id #uuid "d5cb436a-b53f-5af9-855c-293c1a829960" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fd56bdc8-b73c-50ab-935e-2aae3b8b0287" :answer-field/choices ["answer-7a3d4f2d-73fd-5fdd-a7b9-d48aee572f3e" "answer-e33ca47f-eb3b-5674-b9ca-b1081afb2c4c" "answer-7ca0dacc-4323-5ec1-a2e3-396fed55abc1" "answer-fd56bdc8-b73c-50ab-935e-2aae3b8b0287" "answer-3fa34dcc-249c-5965-9509-274d72ed4411"] :db/ensure [:answer-field/validate]} {:db/id "answer-7a3d4f2d-73fd-5fdd-a7b9-d48aee572f3e" :answer/id #uuid "7a3d4f2d-73fd-5fdd-a7b9-d48aee572f3e" :answer/type :answer.type/text :answer/value "$5$ is equal to $x$" :db/ensure [:answer/validate]} {:db/id "answer-e33ca47f-eb3b-5674-b9ca-b1081afb2c4c" :answer/id #uuid "e33ca47f-eb3b-5674-b9ca-b1081afb2c4c" :answer/type :answer.type/text :answer/value "$5$ is greater than $x$" :db/ensure [:answer/validate]} {:db/id "answer-7ca0dacc-4323-5ec1-a2e3-396fed55abc1" :answer/id #uuid "7ca0dacc-4323-5ec1-a2e3-396fed55abc1" :answer/type :answer.type/text :answer/value "$5$ is less than $x$" :db/ensure [:answer/validate]} {:db/id "answer-fd56bdc8-b73c-50ab-935e-2aae3b8b0287" :answer/id #uuid "fd56bdc8-b73c-50ab-935e-2aae3b8b0287" :answer/type :answer.type/text :answer/value "$5$ is not equal to $x$" :db/ensure [:answer/validate]} {:db/id "answer-3fa34dcc-249c-5965-9509-274d72ed4411" :answer/id #uuid "3fa34dcc-249c-5965-9509-274d72ed4411" :answer/type :answer.type/text :answer/value "not $5$ is equal to $x$" :db/ensure [:answer/validate]} {:db/id "question-6bc5c0d6-8790-5f1a-b2ea-1f90b9088589" :question/id #uuid "6bc5c0d6-8790-5f1a-b2ea-1f90b9088589" :question/math-academy-id "q-175466" :question/problem "$\\,$ $x$ is a member of the set of rational numbers.\n\nThe predicate $P(x)$ is given above. Which of following represents $¬P(x)?$" :question/worked-solution "The symbol \"$¬$\" represents negation. So, our task is to negate the given sentence. \n\nTo negate our plain English sentence, we place the words \"It is not true that\" in front of it. This gives the following:\n\n$\\,$ It is not true that $x$ is a member of the set of rational numbers.\n\nIn other words, $x$ is *not* a member of the set of rational numbers. Therefore, $¬P(x)$ means the following:\n\n$\\,$ $x$ is **not** a member of the set of rational numbers." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-25b8c52c-93f3-50f7-bc90-b28b8caa646b"] :db/ensure [:question/validate]} {:db/id "answer-field-25b8c52c-93f3-50f7-bc90-b28b8caa646b" :answer-field/id #uuid "25b8c52c-93f3-50f7-bc90-b28b8caa646b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d2131fd3-c9f3-5761-9ac7-fb5aa6814482" :answer-field/choices ["answer-1ca139be-fd24-58cb-9a9a-c30a15cdf76b" "answer-5f8bd105-c7db-5e86-9c30-d68ce5b1bf63" "answer-70aa5d23-91a7-5e8f-9750-22a0f2a51c79" "answer-b30b3364-8852-5821-844f-bb140229fc0f" "answer-d2131fd3-c9f3-5761-9ac7-fb5aa6814482"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ca139be-fd24-58cb-9a9a-c30a15cdf76b" :answer/id #uuid "1ca139be-fd24-58cb-9a9a-c30a15cdf76b" :answer/type :answer.type/text :answer/value "$x$ is a member of the set of integer numbers" :db/ensure [:answer/validate]} {:db/id "answer-5f8bd105-c7db-5e86-9c30-d68ce5b1bf63" :answer/id #uuid "5f8bd105-c7db-5e86-9c30-d68ce5b1bf63" :answer/type :answer.type/text :answer/value "$x$ is a member of the set of rational numbers" :db/ensure [:answer/validate]} {:db/id "answer-70aa5d23-91a7-5e8f-9750-22a0f2a51c79" :answer/id #uuid "70aa5d23-91a7-5e8f-9750-22a0f2a51c79" :answer/type :answer.type/text :answer/value "$x$ is a member of the set of real numbers" :db/ensure [:answer/validate]} {:db/id "answer-b30b3364-8852-5821-844f-bb140229fc0f" :answer/id #uuid "b30b3364-8852-5821-844f-bb140229fc0f" :answer/type :answer.type/text :answer/value "$x$ is not a member of the set of integer numbers" :db/ensure [:answer/validate]} {:db/id "answer-d2131fd3-c9f3-5761-9ac7-fb5aa6814482" :answer/id #uuid "d2131fd3-c9f3-5761-9ac7-fb5aa6814482" :answer/type :answer.type/text :answer/value "$x$ is not a member of the set of rational numbers" :db/ensure [:answer/validate]} {:db/id "question-677a9cb6-017c-50f2-b91d-96687fdfe48d" :question/id #uuid "677a9cb6-017c-50f2-b91d-96687fdfe48d" :question/math-academy-id "q-175403" :question/problem "$\\,$ $x$ divides $8.$\n\nThe predicate $P(x)$ is given above. Which of following represents $¬P(x)?$" :question/worked-solution "The symbol \"$¬$\" represents negation. So, our task is to negate the given sentence. \n\nTo negate our plain English sentence, we place the words \"It is not true that\" in front of it. This gives the following:\n\n$\\,$ It is not true that $x$ divides $8.$\n\nIn other words, $x$ does *not* divide $8.$ Therefore, $¬P(x)$ means the following:\n\n$\\,$ $x$ does **not** divide $8.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-865644b8-65a0-53e4-9681-7d5de2ca9066"] :db/ensure [:question/validate]} {:db/id "answer-field-865644b8-65a0-53e4-9681-7d5de2ca9066" :answer-field/id #uuid "865644b8-65a0-53e4-9681-7d5de2ca9066" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-71e475d2-5646-5f44-9db9-ce47d4f5e32a" :answer-field/choices ["answer-5e7c14a1-7856-5f07-8417-01492b343b03" "answer-6b8b4cf9-b20a-5222-b2c6-b3835475c774" "answer-d3a88203-aff3-5411-95e3-bb5493a9c44c" "answer-71e475d2-5646-5f44-9db9-ce47d4f5e32a" "answer-57544332-969f-5e0b-9f24-812674b4686f"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e7c14a1-7856-5f07-8417-01492b343b03" :answer/id #uuid "5e7c14a1-7856-5f07-8417-01492b343b03" :answer/type :answer.type/text :answer/value "$8$ divides $x$" :db/ensure [:answer/validate]} {:db/id "answer-6b8b4cf9-b20a-5222-b2c6-b3835475c774" :answer/id #uuid "6b8b4cf9-b20a-5222-b2c6-b3835475c774" :answer/type :answer.type/text :answer/value "$8$ does not divide $x$" :db/ensure [:answer/validate]} {:db/id "answer-d3a88203-aff3-5411-95e3-bb5493a9c44c" :answer/id #uuid "d3a88203-aff3-5411-95e3-bb5493a9c44c" :answer/type :answer.type/text :answer/value "$x$ divides $8$" :db/ensure [:answer/validate]} {:db/id "answer-71e475d2-5646-5f44-9db9-ce47d4f5e32a" :answer/id #uuid "71e475d2-5646-5f44-9db9-ce47d4f5e32a" :answer/type :answer.type/text :answer/value "$x$ does not divide $8$" :db/ensure [:answer/validate]} {:db/id "answer-57544332-969f-5e0b-9f24-812674b4686f" :answer/id #uuid "57544332-969f-5e0b-9f24-812674b4686f" :answer/type :answer.type/text :answer/value "not $x$ divides $8$" :db/ensure [:answer/validate]} {:db/id 17592186198458 :knowledge-point/questions ["question-42b9c224-be1d-5fec-8f82-de83cb0fe7e2" "question-076d7f24-862e-5e64-88fd-d20b20270e73" "question-33e1981c-2431-5133-b452-2914244ddb3a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-42b9c224-be1d-5fec-8f82-de83cb0fe7e2" :question/id #uuid "42b9c224-be1d-5fec-8f82-de83cb0fe7e2" :question/math-academy-id "q-175718" :question/problem "$\\,$ $x\\ne 5$\n\nThe predicate $P(x)$ is given above. Which of following represents $¬P(x)?$" :question/worked-solution "In plain English, our predicate $P(x)$ means the following:\n\n$\\,$ $x$ is not equal to $5.$\n\nThe symbol \"$¬$\" represents negation. To negate our plain English expression, we place the words \"It is not true that\" in front of it. This gives the following:\n\n$\\,$ It is not true that $x$ is not equal to $5.$\n\nIn other words, $x$ is *equal to* $5.$ Therefore, $¬P(x)$ means the following:\n\n$\\,$ $x=5$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-01de8a95-d062-58e2-afe0-8a22b1e61e77"] :db/ensure [:question/validate]} {:db/id "answer-field-01de8a95-d062-58e2-afe0-8a22b1e61e77" :answer-field/id #uuid "01de8a95-d062-58e2-afe0-8a22b1e61e77" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6aaf7244-69b3-5336-8d0a-b57e7ad2c6e1" :answer-field/choices ["answer-249437af-7141-5420-811d-9dc55a5823e7" "answer-6aaf7244-69b3-5336-8d0a-b57e7ad2c6e1" "answer-a65400eb-0cb2-5bb1-b76a-c972dba233e8" "answer-01af366a-5160-5dc4-9eb0-b7cb7d0a0867" "answer-42db29d5-89cc-5b7c-8fb8-bddbe222fac8"] :db/ensure [:answer-field/validate]} {:db/id "answer-249437af-7141-5420-811d-9dc55a5823e7" :answer/id #uuid "249437af-7141-5420-811d-9dc55a5823e7" :answer/type :answer.type/math :answer/value "x<5" :db/ensure [:answer/validate]} {:db/id "answer-6aaf7244-69b3-5336-8d0a-b57e7ad2c6e1" :answer/id #uuid "6aaf7244-69b3-5336-8d0a-b57e7ad2c6e1" :answer/type :answer.type/math :answer/value "x=5" :db/ensure [:answer/validate]} {:db/id "answer-a65400eb-0cb2-5bb1-b76a-c972dba233e8" :answer/id #uuid "a65400eb-0cb2-5bb1-b76a-c972dba233e8" :answer/type :answer.type/math :answer/value "x>5" :db/ensure [:answer/validate]} {:db/id "answer-01af366a-5160-5dc4-9eb0-b7cb7d0a0867" :answer/id #uuid "01af366a-5160-5dc4-9eb0-b7cb7d0a0867" :answer/type :answer.type/math :answer/value "x\\ne -5" :db/ensure [:answer/validate]} {:db/id "answer-42db29d5-89cc-5b7c-8fb8-bddbe222fac8" :answer/id #uuid "42db29d5-89cc-5b7c-8fb8-bddbe222fac8" :answer/type :answer.type/math :answer/value "x\\ne \\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "question-076d7f24-862e-5e64-88fd-d20b20270e73" :question/id #uuid "076d7f24-862e-5e64-88fd-d20b20270e73" :question/math-academy-id "q-175310" :question/problem "$\\,$ $x<3$\n\nThe predicate $P(x)$ is given above. Which of following represents $¬P(x)?$" :question/worked-solution "In plain English, our predicate $P(x)$ means the following:\n\n$\\,$ $x$ is smaller than $3.$\n\nThe symbol \"$¬$\" represents negation. To negate our plain English expression, we place the words \"It is not true that\" in front of it. This gives the following:\n\n$\\,$ It is not true that $x$ is smaller than $3.$\n\nIn other words, $x$ is *larger than or equal to* $3.$ Therefore, $¬P(x)$ means the following:\n\n$\\,$ $x\\ge 3$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a09c4e3a-c62a-585f-b74a-3e139e2999c2"] :db/ensure [:question/validate]} {:db/id "answer-field-a09c4e3a-c62a-585f-b74a-3e139e2999c2" :answer-field/id #uuid "a09c4e3a-c62a-585f-b74a-3e139e2999c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-09820e56-4bf7-52b8-bac4-733b13453868" :answer-field/choices ["answer-006b0149-0acd-57c4-9fb8-35ea3655b954" "answer-20256131-7965-5f7d-bd6c-c66c8c3645d2" "answer-09820e56-4bf7-52b8-bac4-733b13453868" "answer-044a3c99-f6d4-53e3-bb9c-d0fc290c0257" "answer-b090db9a-7a8e-5f71-9bb6-8735caf50dd9"] :db/ensure [:answer-field/validate]} {:db/id "answer-006b0149-0acd-57c4-9fb8-35ea3655b954" :answer/id #uuid "006b0149-0acd-57c4-9fb8-35ea3655b954" :answer/type :answer.type/math :answer/value "x<\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-20256131-7965-5f7d-bd6c-c66c8c3645d2" :answer/id #uuid "20256131-7965-5f7d-bd6c-c66c8c3645d2" :answer/type :answer.type/math :answer/value "x>3" :db/ensure [:answer/validate]} {:db/id "answer-09820e56-4bf7-52b8-bac4-733b13453868" :answer/id #uuid "09820e56-4bf7-52b8-bac4-733b13453868" :answer/type :answer.type/math :answer/value "x\\ge 3" :db/ensure [:answer/validate]} {:db/id "answer-044a3c99-f6d4-53e3-bb9c-d0fc290c0257" :answer/id #uuid "044a3c99-f6d4-53e3-bb9c-d0fc290c0257" :answer/type :answer.type/math :answer/value "x\\le -3" :db/ensure [:answer/validate]} {:db/id "answer-b090db9a-7a8e-5f71-9bb6-8735caf50dd9" :answer/id #uuid "b090db9a-7a8e-5f71-9bb6-8735caf50dd9" :answer/type :answer.type/math :answer/value "x\\le 3" :db/ensure [:answer/validate]} {:db/id "question-33e1981c-2431-5133-b452-2914244ddb3a" :question/id #uuid "33e1981c-2431-5133-b452-2914244ddb3a" :question/math-academy-id "q-176029" :question/problem "$\\,$ $x∤3$\n\nThe predicate $P(x)$ is given above. Which of following represents $¬P(x)?$" :question/worked-solution "In plain English, our predicate $P(x)$ means the following:\n\n$\\,$ $x$ does not divide $3.$\n\nThe symbol \"$¬$\" represents negation. So, our task is to negate the given sentence. \n\nTo negate our plain English sentence, we place the words \"It is not true that\" in front of it. This gives the following:\n\n$\\,$ It is not true that $x$ does not divide $3$,\n\nIn other words, $x$ divides $3.$ Therefore, $¬P(x)$ means the following:\n\n$\\,$ $x∣3$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-eec43fcf-c739-5b39-9e81-d434aedc8ff1"] :db/ensure [:question/validate]} {:db/id "answer-field-eec43fcf-c739-5b39-9e81-d434aedc8ff1" :answer-field/id #uuid "eec43fcf-c739-5b39-9e81-d434aedc8ff1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c28c55ef-428e-53c0-a1f4-e4d5f3d50b7e" :answer-field/choices ["answer-56c40f5b-b63d-5c67-8891-f754ecb7b048" "answer-b0301f55-41b5-54ab-95db-c2ced72ac16b" "answer-8e0560b9-8503-558e-b628-da8774f73cf1" "answer-c28c55ef-428e-53c0-a1f4-e4d5f3d50b7e" "answer-0961639c-8a99-5f34-902d-172ef4817558"] :db/ensure [:answer-field/validate]} {:db/id "answer-56c40f5b-b63d-5c67-8891-f754ecb7b048" :answer/id #uuid "56c40f5b-b63d-5c67-8891-f754ecb7b048" :answer/type :answer.type/math :answer/value "-x∤3" :db/ensure [:answer/validate]} {:db/id "answer-b0301f55-41b5-54ab-95db-c2ced72ac16b" :answer/id #uuid "b0301f55-41b5-54ab-95db-c2ced72ac16b" :answer/type :answer.type/math :answer/value "3∣x" :db/ensure [:answer/validate]} {:db/id "answer-8e0560b9-8503-558e-b628-da8774f73cf1" :answer/id #uuid "8e0560b9-8503-558e-b628-da8774f73cf1" :answer/type :answer.type/math :answer/value "3∤x" :db/ensure [:answer/validate]} {:db/id "answer-c28c55ef-428e-53c0-a1f4-e4d5f3d50b7e" :answer/id #uuid "c28c55ef-428e-53c0-a1f4-e4d5f3d50b7e" :answer/type :answer.type/math :answer/value "x∣3" :db/ensure [:answer/validate]} {:db/id "answer-0961639c-8a99-5f34-902d-172ef4817558" :answer/id #uuid "0961639c-8a99-5f34-902d-172ef4817558" :answer/type :answer.type/math :answer/value "x∤3" :db/ensure [:answer/validate]} {:db/id 17592186198459 :knowledge-point/questions ["question-c10a018a-81ad-5ca3-aa1e-62d5a7f08abd" "question-47bf2910-5b88-5885-9dd5-4d92d20a68db"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c10a018a-81ad-5ca3-aa1e-62d5a7f08abd" :question/id #uuid "c10a018a-81ad-5ca3-aa1e-62d5a7f08abd" :question/math-academy-id "q-176821" :question/problem "![](images/2b/2b7e93b99c5ff7cc66a8d012e8c2ba6f828228bd8ea4e17f838723f8f9c91ae6.png)\n\nThe shaded region above represents the truth set of a predicate $P(x),$ defined over the universal set ${R}^{2}.$ Which of the following is the truth set of $¬P(x).$" :question/worked-solution "The truth set of $¬P(x)$ is the *complement* of the truth set of $P(x):$\n\n$$\n{T}_{¬P}={\\overset{―}{T}}_{P}\n$$\n\nTherefore, to get the truth set of $¬P(x),$ we take all the points that belong to $U$ and do not lie in ${T}_{p},$ as shown below.\n\n![](images/c5/c5534ee4c3d936431b2fc51c5f906838671552f615629cd05882917064f7ad0d.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f85b2755-7ce4-5ac1-8bc6-e09c236111dd"] :db/ensure [:question/validate]} {:db/id "answer-field-f85b2755-7ce4-5ac1-8bc6-e09c236111dd" :answer-field/id #uuid "f85b2755-7ce4-5ac1-8bc6-e09c236111dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8d6b9b8b-9f9f-5f67-a1a0-8f10ba670150" :answer-field/choices ["answer-3ada1cbc-ae65-5530-88d7-a11d128eb80c" "answer-bdc4ccf3-2126-54d6-b4e0-822d22ccfd6c" "answer-9783ad38-e8b5-57b0-8d9a-bf87b49e6bc3" "answer-d9649c3b-bf31-58ae-a068-1637ee5fbd7d" "answer-8d6b9b8b-9f9f-5f67-a1a0-8f10ba670150"] :db/ensure [:answer-field/validate]} {:db/id "answer-3ada1cbc-ae65-5530-88d7-a11d128eb80c" :answer/id #uuid "3ada1cbc-ae65-5530-88d7-a11d128eb80c" :answer/type :answer.type/image :answer/value "images/20/2066e7be5a62a804f39aa114b64884c155cb943e2a68d60711926e0a84af20cb.png" :db/ensure [:answer/validate]} {:db/id "answer-bdc4ccf3-2126-54d6-b4e0-822d22ccfd6c" :answer/id #uuid "bdc4ccf3-2126-54d6-b4e0-822d22ccfd6c" :answer/type :answer.type/image :answer/value "images/2b/2b7e93b99c5ff7cc66a8d012e8c2ba6f828228bd8ea4e17f838723f8f9c91ae6.png" :db/ensure [:answer/validate]} {:db/id "answer-9783ad38-e8b5-57b0-8d9a-bf87b49e6bc3" :answer/id #uuid "9783ad38-e8b5-57b0-8d9a-bf87b49e6bc3" :answer/type :answer.type/image :answer/value "images/45/452f55de659edda207fd7c9a91fffdb0607e3826cadce23bcdee77a2c7a5936b.png" :db/ensure [:answer/validate]} {:db/id "answer-d9649c3b-bf31-58ae-a068-1637ee5fbd7d" :answer/id #uuid "d9649c3b-bf31-58ae-a068-1637ee5fbd7d" :answer/type :answer.type/image :answer/value "images/95/95a8c32fe0dd4b26a4fa85a72cbc83a0374def48eaade594ae8658c1c203ec8e.png" :db/ensure [:answer/validate]} {:db/id "answer-8d6b9b8b-9f9f-5f67-a1a0-8f10ba670150" :answer/id #uuid "8d6b9b8b-9f9f-5f67-a1a0-8f10ba670150" :answer/type :answer.type/image :answer/value "images/c5/c5534ee4c3d936431b2fc51c5f906838671552f615629cd05882917064f7ad0d.png" :db/ensure [:answer/validate]} {:db/id "question-47bf2910-5b88-5885-9dd5-4d92d20a68db" :question/id #uuid "47bf2910-5b88-5885-9dd5-4d92d20a68db" :question/math-academy-id "q-175515" :question/problem "Find the truth set of $¬P(x)$ given the following predicate defined over the universal set $R:$\n\n$\\,$ $P(x):$ $3x+2>8$" :question/worked-solution "The truth set of $¬P(x)$ is the *complement* of the truth set of $P(x):$\n\n$$\n{T}_{¬P}={\\overset{―}{T}}_{P}\n$$\n\nTo find the the truth set of $P(x),$ we solve the inequality:\n\n$$\n\\begin{aligned}3x+2 & >8 \\\\ 3x & >6 \\\\ x & >2\\end{aligned}\n$$\n\nSo, the truth set of $P(x)$ is\n${T}_{P}=(2,\\infty ).$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{T}_{¬P} & ={\\overset{―}{T}}_{P} \\\\  & =\\overset{―}{(2,\\infty )} \\\\  & =(-\\infty ,2].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7b433756-abce-5e65-9a41-9ca1f36d94b8"] :db/ensure [:question/validate]} {:db/id "answer-field-7b433756-abce-5e65-9a41-9ca1f36d94b8" :answer-field/id #uuid "7b433756-abce-5e65-9a41-9ca1f36d94b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a96a2954-c618-5c1d-8981-c4359202a3ac" :answer-field/choices ["answer-99773e8e-1dd3-55c6-9ec4-2b0c92faccb1" "answer-a96a2954-c618-5c1d-8981-c4359202a3ac" "answer-7a42e16e-4b1a-5fa2-94ad-3880067141ba" "answer-25483408-e183-505b-af39-bf31ad8295a3" "answer-9b013398-96a1-5775-bef3-bf147045cb56"] :db/ensure [:answer-field/validate]} {:db/id "answer-99773e8e-1dd3-55c6-9ec4-2b0c92faccb1" :answer/id #uuid "99773e8e-1dd3-55c6-9ec4-2b0c92faccb1" :answer/type :answer.type/math :answer/value "(-\\infty ,2)" :db/ensure [:answer/validate]} {:db/id "answer-a96a2954-c618-5c1d-8981-c4359202a3ac" :answer/id #uuid "a96a2954-c618-5c1d-8981-c4359202a3ac" :answer/type :answer.type/math :answer/value "(-\\infty ,2]" :db/ensure [:answer/validate]} {:db/id "answer-7a42e16e-4b1a-5fa2-94ad-3880067141ba" :answer/id #uuid "7a42e16e-4b1a-5fa2-94ad-3880067141ba" :answer/type :answer.type/math :answer/value "(2,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-25483408-e183-505b-af39-bf31ad8295a3" :answer/id #uuid "25483408-e183-505b-af39-bf31ad8295a3" :answer/type :answer.type/math :answer/value "R" :db/ensure [:answer/validate]} {:db/id "answer-9b013398-96a1-5775-bef3-bf147045cb56" :answer/id #uuid "9b013398-96a1-5775-bef3-bf147045cb56" :answer/type :answer.type/math :answer/value "∅" :db/ensure [:answer/validate]}] "assertions" [["question-3f57645e-6a86-5bd3-8b5a-df92495bea5e" :question/id #uuid "3f57645e-6a86-5bd3-8b5a-df92495bea5e"] ["question-3f57645e-6a86-5bd3-8b5a-df92495bea5e" :question/math-academy-id "q-175407"] ["question-3f57645e-6a86-5bd3-8b5a-df92495bea5e" :question/problem "$\\,$ $5$ is equal to $x.$\n\nThe predicate $P(x)$ is given above. Which of following represents $¬P(x)?$"] ["question-3f57645e-6a86-5bd3-8b5a-df92495bea5e" :question/worked-solution "The symbol \"$¬$\" represents negation. So, our task is to negate the given sentence. \n\nTo negate our plain English sentence, we place the words \"It is not true that\" in front of it. This gives the following:\n\n$\\,$ It is not true that $5$ is equal to $x.$\n\nIn other words, $5$ is *not* equal to $x.$ Therefore, $¬P(x)$ means the following:\n\n$\\,$ $5$ is **not** equal to $x.$"] ["question-3f57645e-6a86-5bd3-8b5a-df92495bea5e" :question/difficulty :question.difficulty/easy] ["answer-field-d5cb436a-b53f-5af9-855c-293c1a829960" :answer-field/id #uuid "d5cb436a-b53f-5af9-855c-293c1a829960"] ["answer-7a3d4f2d-73fd-5fdd-a7b9-d48aee572f3e" :answer/id #uuid "7a3d