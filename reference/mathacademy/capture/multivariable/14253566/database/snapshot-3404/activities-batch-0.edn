#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186199416} :activity/id #uuid "fa35d201-6dec-5ad9-8120-8f14bb512b33" :activity/scope {:db/id #edb/ref 17592186049546 :topic/id #uuid "fdd24948-21e1-5057-8235-cc584d9c1be2" :topic/math-academy-id 4256} :activity/steps [{:db/id #edb/ref 17592186199416 :step/content {:db/id #edb/ref 17592186199522 :tutorial/content "The **negation** of the predicate $P(x_1,x_2,\\ldots,x_n)$ is a new predicate that we denote as follows:\n\n$$\n\\lnot P(x_1,x_2,\\ldots,x_n)\n$$\n\nThis predicate is true if and only if $P$ is false for a specific set of assignment variables $x_1,x_2, \\ldots x_n.$\n\nFor example, consider the following predicate defined over the universal set $\\mathbb Z.$\n\n$\\qquad$ *$P(m):$ $m$ is even*\n\nThen, $\\lnot P(m)$ is a new predicate that reads as follows:\n\n$\\qquad$ *$m$ is **not** even*\n\nThis can be simplified as:\n\n$\\qquad$ *$m$ is odd*\n\nFor example:\n\n- $P(2)$ is true while $\\lnot P(2)$ is false\n\n- $P(3)$ is false while $\\lnot P(3)$ is true" :tutorial/id #uuid "282e591f-3d63-58ed-8e4e-852ba57975cb" :tutorial/math-academy-id 7988 :tutorial/title "Introduction"} :step/id #uuid "689313ef-ffe1-58c6-8b2b-9b55b7db42a3" :step/math-academy-id 62556 :step/next {:db/id #edb/ref 17592186199417}} {:db/id #edb/ref 17592186199417 :step/content {:db/id #edb/ref 17592186198457 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198102 :question/id #uuid "12d987fd-f966-522d-9370-48f7306930ed" :question/math-academy-id "e-12731"} :knowledge-point/id #uuid "391bb8ae-88ba-520c-a5cf-7e2fa5474788" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048349} {:db/id #edb/ref 17592186049002}] :knowledge-point/questions [{:db/id #edb/ref 17592186198706} {:db/id #edb/ref 17592186198707} {:db/id #edb/ref 17592186381509} {:db/id #edb/ref 17592186381516} {:db/id #edb/ref 17592186381523} {:db/id #edb/ref 17592186401634} {:db/id #edb/ref 17592186401641} {:db/id #edb/ref 17592186430212} {:db/id #edb/ref 17592186430214}] :knowledge-point/title "Negating a Predicate Expressed in Plain English"} :step/id #uuid "f06746b0-83de-5f4b-aa37-7e80db4e4a56" :step/math-academy-id 62557 :step/next {:db/id #edb/ref 17592186199418}} {:db/id #edb/ref 17592186199418 :step/content {:db/id #edb/ref 17592186198458 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198111 :question/id #uuid "adacf679-91a6-500f-b13a-18418d851d5b" :question/math-academy-id "e-12883"} :knowledge-point/id #uuid "7943a26b-d4fa-5ce1-bc47-5ea4873fc367" :knowledge-point/questions [{:db/id #edb/ref 17592186198722} {:db/id #edb/ref 17592186198746} {:db/id #edb/ref 17592186381558} {:db/id #edb/ref 17592186381565} {:db/id #edb/ref 17592186381572} {:db/id #edb/ref 17592186398611} {:db/id #edb/ref 17592186430215} {:db/id #edb/ref 17592186430216}] :knowledge-point/title "Negating a Predicate Expressed Using Notation"} :step/id #uuid "0d9a565f-fee0-59f8-bc74-1f86aac39bf7" :step/math-academy-id 62560 :step/next {:db/id #edb/ref 17592186199419}} {:db/id #edb/ref 17592186199419 :step/content {:db/id #edb/ref 17592186199543 :tutorial/content "Let $T_P$ be the truth set of the predicate $P(x_1,x_2,\\ldots,x_n).$\n\nFrom the definition of the negation of a predicate, we have that $\\lnot P$ is true if and only if $P$ is false. Therefore, the truth set of $\\neg P$ is the *complement* of the truth set of $P{:}$\n\n$$\nT_{\\neg P} = \\overline{T}_P\n$$\n\nFor example, consider the following predicate defined over the universal set $\\mathbb{R}{:}$\n\n$P(x):$ $-2x +3 \\leq 5$\n\nTo find the the truth set of $P(x),$ we solve the inequality:\n\n$$\n\\begin{aligned}-2x+3 & \\le 5 \\\\ -2x & \\le 2 \\\\ x & \\ge -1\\end{aligned}\n$$\n\nSo, the truth set of $P(x)$ is $T_P = [-1,\\infty).$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{T}_{¬P} & ={\\overset{―}{T}}_{P} \\\\  & =\\overset{―}{[-1,\\infty )} \\\\  & =(-\\infty ,-1).\\end{aligned}\n$$" :tutorial/id #uuid "3dd43712-0f20-5210-9cba-7ef53f91ef83" :tutorial/math-academy-id 8141 :tutorial/title "Truth Sets of Negations"} :step/id #uuid "b38cd7f4-1fed-50b1-8e85-1cc61e0ab9f3" :step/math-academy-id 62563 :step/next {:db/id #edb/ref 17592186199420}} {:db/id #edb/ref 17592186199420 :step/content {:db/id #edb/ref 17592186198459 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198103 :question/id #uuid "fcee0d41-9ff9-5f84-b8fe-73bfad36c7bb" :question/math-academy-id "e-12732"} :knowledge-point/id #uuid "adbddf14-3aca-50dd-80f8-4146193c91ff" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048592} {:db/id #edb/ref 17592186049691}] :knowledge-point/questions [{:db/id #edb/ref 17592186198708} {:db/id #edb/ref 17592186198709} {:db/id #edb/ref 17592186381530} {:db/id #edb/ref 17592186381537} {:db/id #edb/ref 17592186381544} {:db/id #edb/ref 17592186389754} {:db/id #edb/ref 17592186389761} {:db/id #edb/ref 17592186430213}] :knowledge-point/title "Finding the Truth Set of Predicate's Negation"} :step/id #uuid "36c3a3d4-465b-5645-a63b-4df3e07d3a80" :step/math-academy-id 62564}] :activity/title "The \"Not\" Connective With Predicates" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186198515}]}
