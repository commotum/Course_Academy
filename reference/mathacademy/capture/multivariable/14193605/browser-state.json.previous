olumnalign=\"right left right left right left\" columnspacing=\"0em 2em 0em 2em 0em\" rowspacing=\"0.8em 0.8em 0.3em\"><mtr><mtd><mn>2</mn><msup><mi>e</mi><mi>x</mi></msup><mo>−</mo><mn>3</mn></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd><mtd></mtd><mtd><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle></mtd><mtd><msup><mi>e</mi><mi>x</mi></msup><mo>−</mo><mn>1</mn></mtd><mtd><mi></mi><mo>=</mo><mn>0</mn></mtd></mtr><mtr><mtd><msup><mi>e</mi><mi>x</mi></msup></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle></mtd><mtd></mtd><mtd><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle></mtd><mtd><msup><mi>e</mi><mi>x</mi></msup></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn></mtd></mtr><mtr><mtd><msup><mi>e</mi><mi>x</mi></msup></mtd><mtd><mi></mi><mo>=</mo><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd><mtd></mtd><mtd><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle></mtd><mtd><mi>x</mi></mtd><mtd><mi></mi><mo>=</mo><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow><mo>=</mo><mn>0</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore, <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"20\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/