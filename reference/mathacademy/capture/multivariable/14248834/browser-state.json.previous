      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14248834/observations/step-q126408-42dba35b41aeca531bf8.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14248834/observations/step-q126408-42dba35b41aeca531bf8.png",
      "source_url": "https://mathacademy.com/tasks/14248834/topics/1001/review",
      "captured_at": 1792117877.1405342,
      "math_academy_id": "q-126408",
      "topic_id": "1001",
      "sequence_position": null,
