#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186167700} :activity/id #uuid "c20fbe32-d31b-52ad-8872-431ee715865b" :activity/scope {:db/id #edb/ref 17592186050543 :topic/id #uuid "52518f9a-d06e-5b21-9515-0ca55ed7e1c6" :topic/math-academy-id 3251} :activity/steps [{:db/id #edb/ref 17592186167593 :step/content {:db/id #edb/ref 17592186166761 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166599 :question/id #uuid "3817c58a-1176-5347-aa96-2846969cae32" :question/math-academy-id "e-8349"} :knowledge-point/id #uuid "597e3939-e6b4-5237-a16e-8bae92f9b656" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048192}] :knowledge-point/questions [{:db/id #edb/ref 17592186167341} {:db/id #edb/ref 17592186167368} {:db/id #edb/ref 17592186515545} {:db/id #edb/ref 17592186515590} {:db/id #edb/ref 17592186515609}] :knowledge-point/title "Basic Derivatives of the Reciprocal Hyperbolic Functions"} :step/id #uuid "b64d6121-c7b1-598c-88b7-d93e228e9eaa" :step/math-academy-id 31178 :step/next {:db/id #edb/ref 17592186167594}} {:db/id #edb/ref 17592186167594 :step/content {:db/id #edb/ref 17592186166762 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166600 :question/id #uuid "b14f0558-456d-51a9-85ac-0b36158bc52e" :question/math-academy-id "e-8350"} :knowledge-point/id #uuid "6fd03e86-fab7-5157-b0f3-62c522dc212c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051084}] :knowledge-point/questions [{:db/id #edb/ref 17592186167342} {:db/id #edb/ref 17592186167390} {:db/id #edb/ref 17592186515540} {:db/id #edb/ref 17592186515553} {:db/id #edb/ref 17592186515555} {:db/id #edb/ref 17592186515561} {:db/id #edb/ref 17592186515591} {:db/id #edb/ref 17592186523987} {:db/id #edb/ref 17592186524008}] :knowledge-point/title "Differentiating Reciprocal Hyperbolic Functions Using the Chain Rule"} :step/id #uuid "78f3cfb7-8cc3-5af3-a38d-387410a4f13c" :step/math-academy-id 31180 :step/next {:db/id #edb/ref 17592186167595}} {:db/id #edb/ref 17592186167595 :step/content {:db/id #edb/ref 17592186166763 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166601 :question/id #uuid "4baa8799-f8ce-521e-833b-8b66c747e701" :question/math-academy-id "e-8351"} :knowledge-point/id #uuid "a991a2f4-b96a-5f92-8b52-6102647be98e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813}] :knowledge-point/questions [{:db/id #edb/ref 17592186167343} {:db/id #edb/ref 17592186167393} {:db/id #edb/ref 17592186515518} {:db/id #edb/ref 17592186515547} {:db/id #edb/ref 17592186515565} {:db/id #edb/ref 17592186515601} {:db/id #edb/ref 17592186523940}] :knowledge-point/title "Differentiating Reciprocal Hyperbolic Functions Using the Product Rule"} :step/id #uuid "1dc4c0db-f2ea-5960-841d-325f01516019" :step/math-academy-id 31181 :step/next {:db/id #edb/ref 17592186167596}} {:db/id #edb/ref 17592186167596 :step/content {:db/id #edb/ref 17592186166764 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166602 :question/id #uuid "bec9b472-31ce-5892-8a17-c4aa3c33ef12" :question/math-academy-id "e-8352"} :knowledge-point/id #uuid "08d9798e-a4bb-5f04-9d49-494990c52bff" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048842}] :knowledge-point/questions [{:db/id #edb/ref 17592186167344} {:db/id #edb/ref 17592186167424} {:db/id #edb/ref 17592186360647} {:db/id #edb/ref 17592186385961} {:db/id #edb/ref 17592186515559} {:db/id #edb/ref 17592186515569} {:db/id #edb/ref 17592186515575} {:db/id #edb/ref 17592186515605} {:db/id #edb/ref 17592186523925}] :knowledge-point/title "Differentiating Reciprocal Hyperbolic Functions Using the Quotient Rule"} :step/id #uuid "5d7db477-93fd-5bed-83a1-3451d28c23a2" :step/math-academy-id 31182 :step/next {:db/id #edb/ref 17592186167711}} {:db/id #edb/ref 17592186167700 :step/content {:db/id #edb/ref 17592186168090 :tutorial/content "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe derivatives of the reciprocal hyperbolic functions are as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x) & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{csch}⁡x) & =-\\operatorname{csch}⁡x\\operatorname{coth}⁡x \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x) & =-{csch}^{2}⁡x\\end{aligned}\n$$\n\nLet's use these results to find the derivative of \n\n$$\ny= \\sech x - 2\\csch x.\n$$\n\nDifferentiating term-by-term, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x-2\\operatorname{csch}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)+\\frac{\\text{d}}{\\text{d}x}(-2\\operatorname{csch}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)-2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{csch}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x-2(-\\operatorname{csch}⁡x\\operatorname{coth}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x+2\\operatorname{csch}⁡x\\operatorname{coth}⁡x.\\end{aligned}\n$$" :tutorial/id #uuid "9f94990a-0da5-522a-9d5f-7e0b269b50ac" :tutorial/math-academy-id 5208 :tutorial/title "Introduction"} :step/id #uuid "a9dbf529-bcef-5ee9-8535-112f0fae57f5" :step/math-academy-id 32692 :step/next {:db/id #edb/ref 17592186167593}} {:db/id #edb/ref 17592186167711 :step/content {:db/id #edb/ref 17592186168101 :tutorial/content "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$ \n\nWe wish to prove the following result:\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\sech{x}) = -\\sech{x} \\tanh{x}.\n$$\n\nTo do this, we can use the fact that\n\n$$\n\\sech x = \\dfrac{1}{\\cosh x}.\n$$\n\nDifferentiating the above equation using the chain rule, we arrive at\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{\\operatorname{cosh}⁡x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}{(\\operatorname{cosh}⁡x)}^{-1} \\\\  & =-{(\\operatorname{cosh}⁡x)}^{-2}\\cdot (\\operatorname{cosh}⁡x)^{′} \\\\  & =-\\frac{1}{{cosh}^{2}⁡x}\\cdot \\operatorname{sinh}⁡x \\\\  & =-\\frac{1}{\\operatorname{cosh}⁡x}\\cdot \\frac{\\operatorname{sinh}⁡x}{\\operatorname{cosh}⁡x} \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\end{aligned}\n$$\n\nWe can prove the results for the derivatives of the hyperbolic cosecant and cotangent in a similar way." :tutorial/id #uuid "cb6ff220-98cb-5e8a-8a09-958d158b0d10" :tutorial/math-academy-id 5226 :tutorial/title "Deriving the Result for the Derivative of the Hyperbolic Secant"} :step/id #uuid "143b8be3-52fa-5eb8-99d4-c0ff1ef2dbfd" :step/math-academy-id 32719}] :activity/title "Differentiating Reciprocal Hyperbolic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186167018}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186524087} :activity/id #uuid "eb9e0140-b867-5e68-babf-1d38ffa4ad68" :activity/scope {:db/id #edb/ref 17592186050543 :topic/id #uuid "52518f9a-d06e-5b21-9515-0ca55ed7e1c6" :topic/math-academy-id 3251} :activity/steps [{:db/id #edb/ref 17592186524065 :step/content {:db/id #edb/ref 17592186523940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a262826-fbb0-5320-bb2e-6379a76bc331" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sech}^{2}⁡x(1-2x\\operatorname{tanh}⁡x)" :db/id #edb/ref 17592186523406} {:answer/id #uuid "51c51e52-9010-5b3c-8047-10aa85488383" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sech}^{2}⁡x(1-2x{tanh}^{2}⁡x)" :db/id #edb/ref 17592186523419} {:answer/id #uuid "a095eeaa-71bd-5a30-9655-035de8150b53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{sech}^{2}⁡x(1+2x\\operatorname{coth}⁡x)" :db/id #edb/ref 17592186523588} {:answer/id #uuid "cc9239d3-c5f2-52a5-a408-c11d0f1f88ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sech}⁡x(1+2x\\operatorname{tanh}⁡x)" :db/id #edb/ref 17592186523681} {:answer/id #uuid "e28ecdb1-81b7-55ae-928b-208d2f35a6c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sech}⁡x(1-2x{coth}^{2}⁡x)" :db/id #edb/ref 17592186523728}] :answer-field/correct {:db/id #edb/ref 17592186523406} :answer-field/id #uuid "c10c01cc-e0f9-571f-a0fb-7e4e517f6d40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523886}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "26dd88c1-a8ad-595c-af19-c13d906feda9" :question/math-academy-id "q-95587" :question/problem "$$\n\nFind the derivative of $f(x)=x{sech}^{2}⁡x.$" :question/worked-solution "Here, we have the product of two functions $u(x)=x$ and $v(x)={sech}^{2}⁡x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(x)}^{′}\\cdot {sech}^{2}⁡x+x\\cdot {({sech}^{2}⁡x)}^{′} \\\\  & =1\\cdot {sech}^{2}⁡x+x\\cdot (2\\operatorname{sech}⁡x)\\cdot (-\\operatorname{sec}⁡x\\operatorname{tanh}⁡x) \\\\  & ={sech}^{2}⁡x-2x{sech}^{2}⁡x\\operatorname{tanh}⁡x \\\\  & ={sech}^{2}⁡x(1-2x\\operatorname{tanh}⁡x)\\end{aligned}\n$$"} :step/id #uuid "67b9f987-8c65-5ef3-b902-335deeb911ed" :step/next {:db/id #edb/ref 17592186524098}} {:db/id #edb/ref 17592186524087 :step/content {:db/id #edb/ref 17592186524008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0718ee2b-934a-5775-88b9-654a98a3df48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4x{csch}^{2}⁡4x" :db/id #edb/ref 17592186523271} {:answer/id #uuid "15d0f986-68fd-5c05-b61f-2cb59af8e4c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\operatorname{sech}⁡4x\\operatorname{coth}⁡4x" :db/id #edb/ref 17592186523303} {:answer/id #uuid "b0b12e96-3aee-519e-afa6-98c880294233" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{csch}^{2}⁡4x" :db/id #edb/ref 17592186523626} {:answer/id #uuid "cc4b8906-6e7c-5f46-b779-8abef094c635" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8{sech}^{2}⁡4x" :db/id #edb/ref 17592186523679} {:answer/id #uuid "ea15c1a2-ef8e-52bd-843d-747ef10b4c18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\operatorname{csch}⁡4x\\operatorname{coth}⁡4x" :db/id #edb/ref 17592186523744}] :answer-field/correct {:db/id #edb/ref 17592186523626} :answer-field/id #uuid "d79f42f3-7a3e-5cfc-ae54-7f17a62555f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523894}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c4169769-2e08-50ac-8627-9cd65f653a9b" :question/math-academy-id "q-95567" :question/problem "$$\n\nFind the derivative of $f(x)=-2\\operatorname{coth}⁡4x.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=-2\\operatorname{coth}⁡g,\\,g=4x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=2{csch}^{2}\\,g,\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=4.\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =2{csch}^{2}⁡g\\cdot 4 \\\\  & =8{csch}^{2}⁡g \\\\  & =8{csch}^{2}⁡4x.\\end{aligned}\n$$"} :step/id #uuid "ad7abaa3-35f9-55c7-b149-f9e8e8e19cba" :step/next {:db/id #edb/ref 17592186524101}} {:db/id #edb/ref 17592186524091 :step/content {:db/id #edb/ref 17592186523925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58a1b07b-7bfc-5b97-8af6-3ca183bb6652" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2x{csch}^{2}⁡2x+\\operatorname{coth}⁡2x}{2{x}^{2}}" :db/id #edb/ref 17592186523436} {:answer/id #uuid "6cf34f11-a6ed-51e9-8bc5-739fb989d58d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2x{sech}^{2}⁡2x+\\operatorname{coth}⁡2x}{{x}^{2}}" :db/id #edb/ref 17592186523475} {:answer/id #uuid "9cb97b6b-b48e-57d0-b4f2-a804af9d0be7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x{sech}^{2}⁡2x-\\operatorname{coth}⁡2x}{4{x}^{2}}" :db/id #edb/ref 17592186523581} {:answer/id #uuid "bd8e33a9-dc6f-59b9-918f-d2977e259e1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2x{csch}^{2}⁡2x+\\operatorname{coth}⁡2x}{2{x}^{2}}" :db/id #edb/ref 17592186523648} {:answer/id #uuid "e33ea1d6-0d1e-5b38-a621-13b06c55032e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}{sech}^{2}⁡2x-\\operatorname{coth}⁡2x}{4x}" :db/id #edb/ref 17592186523731}] :answer-field/correct {:db/id #edb/ref 17592186523648} :answer-field/id #uuid "7b899f25-79c8-5b1d-9f3a-fc090dc3cb6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523849}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "04ba3fd8-1522-5fe9-a412-8ecb77ad06a4" :question/math-academy-id "q-95894" :question/problem "$$\n\nFind the derivative of $f(x)=\\frac{\\operatorname{coth}⁡2x}{2x}.$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=\\operatorname{coth}⁡2x$ and $v(x)=2x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{{(\\operatorname{coth}⁡2x)}^{′}\\cdot 2x-\\operatorname{coth}⁡2x\\cdot {(2x)}^{′}}{{(2x)}^{2}} \\\\  & =\\frac{(-2{csch}^{2}⁡2x)\\cdot 2x-\\operatorname{coth}⁡2x\\cdot (2)}{4{x}^{2}} \\\\  & =-\\frac{2(2x{csch}^{2}⁡2x+\\operatorname{coth}⁡2x)}{4{x}^{2}} \\\\  & =-\\frac{2x{csch}^{2}⁡2x+\\operatorname{coth}⁡2x}{2{x}^{2}}\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "b6ba3a49-e9bd-51c0-9196-2a99672203a3"} {:db/id #edb/ref 17592186524098 :step/content {:db/id #edb/ref 17592186167424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0546a58c-c189-5300-98ab-59e9dfa06285" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{csch}^{2}⁡x-\\operatorname{coth}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186523262} {:answer/id #uuid "20d8011e-02b2-51c3-977c-1f56b7e9e7b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\operatorname{csch}⁡x+\\operatorname{coth}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186523319} {:answer/id #uuid "2d5366df-ea2b-5885-a020-a71b3a496864" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{csch}^{2}⁡x+\\operatorname{coth}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186523346} {:answer/id #uuid "8b14f7f2-bbd6-5875-adfd-d43889b7fb7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{{sech}^{2}⁡x+\\operatorname{coth}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186523541} {:answer/id #uuid "d65566be-873f-5b60-b8d3-57f1caa7ee23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{sech}⁡x-\\operatorname{coth}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186523704}] :answer-field/correct {:db/id #edb/ref 17592186523346} :answer-field/id #uuid "0223c3cc-e13e-53e5-9f9c-5759402c0960" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186165752}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c093bf1b-024d-5e9e-8cfa-be2b2599bfe5" :question/math-academy-id "q-95891" :question/problem "$$\n\nFind the derivative of $f(x)=\\frac{\\operatorname{coth}⁡x}{{e}^{x}}.$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=\\operatorname{coth}⁡x$ and $v(x)={e}^{x}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{{(\\operatorname{coth}⁡x)}^{′}\\cdot {e}^{x}-\\operatorname{coth}⁡x\\cdot {({e}^{x})}^{′}}{{({e}^{x})}^{2}} \\\\  & =\\frac{(-{csch}^{2}⁡x)\\cdot {e}^{x}-\\operatorname{coth}⁡x\\cdot ({e}^{x})}{{e}^{2x}} \\\\  & =-\\frac{{e}^{x}({csch}^{2}⁡x+\\operatorname{coth}⁡x)}{{e}^{2x}} \\\\  & =-\\frac{{csch}^{2}⁡x+\\operatorname{coth}⁡x}{{e}^{x}}\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "ce8110a4-9d2c-5b3b-9898-9ddc1bc1bc21" :step/next {:db/id #edb/ref 17592186524091}} {:db/id #edb/ref 17592186524101 :step/content {:db/id #edb/ref 17592186523987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10bda358-e756-5a52-bd52-be83ca51ee6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\operatorname{csch}⁡x" :db/id #edb/ref 17592186523291} {:answer/id #uuid "7fd63de1-2c45-5706-8764-86c4c4a37694" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6{csch}^{2}⁡x\\operatorname{coth}⁡x" :db/id #edb/ref 17592186523524} {:answer/id #uuid "b333d000-5330-53c7-b6f3-3aea595f25e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\operatorname{csch}⁡x{coth}^{2}⁡x" :db/id #edb/ref 17592186523632} {:answer/id #uuid "c03bde7f-fe4b-5a37-b96a-bf72de4e1aed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\operatorname{csch}⁡x{coth}^{2}⁡x" :db/id #edb/ref 17592186523657} {:answer/id #uuid "ced58843-851c-5823-a2b2-32f84d2a86b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{csch}^{2}⁡x\\operatorname{coth}⁡x" :db/id #edb/ref 17592186523687}] :answer-field/correct {:db/id #edb/ref 17592186523524} :answer-field/id #uuid "3aa2d316-4c50-510d-84fd-3aca1c107d6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186523817}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9541bdac-540f-537e-a50e-b6a223ada95f" :question/math-academy-id "q-95575" :question/problem "$$\n\nFind the derivative of $f(x)=3{csch}^{2}⁡x.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=3{g}^{2},\\,g=\\operatorname{csch}⁡x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=6g,\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-\\operatorname{csch}⁡x\\operatorname{coth}⁡x.\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =6g(-\\operatorname{csch}⁡x\\operatorname{coth}⁡x) \\\\  & =6(\\operatorname{csch}⁡x)(-\\operatorname{csch}⁡x\\operatorname{coth}⁡x) \\\\  & =-6{csch}^{2}⁡x\\operatorname{coth}⁡x.\\end{aligned}\n$$"} :step/id #uuid "e4dec1c3-78d1-5931-a7d8-f44f4625ddc5" :step/next {:db/id #edb/ref 17592186524065}}] :activity/title "Differentiating Reciprocal Hyperbolic Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186523247}]}
