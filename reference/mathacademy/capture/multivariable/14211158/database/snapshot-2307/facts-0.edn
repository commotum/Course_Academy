64 #edb/ref 1038 #edb/ref 17592186515569 #edb/ref 17592186045417] [17592186166764 #edb/ref 1038 #edb/ref 17592186515575 #edb/ref 17592186045417] [17592186166764 #edb/ref 1038 #edb/ref 17592186515605 #edb/ref 17592186045417] [17592186166764 #edb/ref 1038 #edb/ref 17592186523925 #edb/ref 17592186045417] [17592186166764 #edb/ref 1039 "Differentiating Reciprocal Hyperbolic Functions Using the Quotient Rule" #edb/ref 17592186045417] [17592186166764 #edb/ref 1041 #edb/ref 17592186166602 #edb/ref 17592186045417] [17592186166764 #edb/ref 1042 #uuid "08d9798e-a4bb-5f04-9d49-494990c52bff" #edb/ref 17592186045417] [17592186167018 #edb/ref 1043 #edb/ref 17592186167593 #edb/ref 17592186045417] [17592186167018 #edb/ref 1043 #edb/ref 17592186167594 #edb/ref 17592186045417] [17592186167018 #edb/ref 1043 #edb/ref 17592186167595 #edb/ref 17592186045417] [17592186167018 #edb/ref 1043 #edb/ref 17592186167596 #edb/ref 17592186045417] [17592186167018 #edb/ref 1043 #edb/ref 17592186167700 #edb/ref 17592186045417] [17592186167018 #edb/ref 1043 #edb/ref 17592186167711 #edb/ref 17592186045417] [17592186167018 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186167018 #edb/ref 1045 "Differentiating Reciprocal Hyperbolic Functions" #edb/ref 17592186045417] [17592186167018 #edb/ref 1046 #edb/ref 17592186167700 #edb/ref 17592186045417] [17592186167018 #edb/ref 1049 #edb/ref 17592186050543 #edb/ref 17592186045417] [17592186167018 #edb/ref 1050 600.0 #edb/ref 17592186045417] [17592186167018 #edb/ref 1053 #uuid "c20fbe32-d31b-52ad-8872-431ee715865b" #edb/ref 17592186045417] [17592186167424 #edb/ref 1068 #edb/ref 17592186165752 #edb/ref 17592186045417] [17592186167424 #edb/ref 1069 "q-95891" #edb/ref 17592186045417] [17592186167424 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186167424 #edb/ref 1071 "$$\n\nFind the derivative of $f(x)=\\frac{\\operatorname{coth}⁡x}{{e}^{x}}.$" #edb/ref 17592186045417] [17592186167424 #edb/ref 1072 #uuid "c093bf1b-024d-5e9e-8cfa-be2b2599bfe5" #edb/ref 17592186045417] [17592186167424 #edb/ref 1074 "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=\\operatorname{coth}⁡x$ and $v(x)={e}^{x}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{{(\\operatorname{coth}⁡x)}^{′}\\cdot {e}^{x}-\\operatorname{coth}⁡x\\cdot {({e}^{x})}^{′}}{{({e}^{x})}^{2}} \\\\  & =\\frac{(-{csch}^{2}⁡x)\\cdot {e}^{x}-\\operatorname{coth}⁡x\\cdot ({e}^{x})}{{e}^{2x}} \\\\  & =-\\frac{{e}^{x}({csch}^{2}⁡x+\\operatorname{coth}⁡x)}{{e}^{2x}} \\\\  & =-\\frac{{csch}^{2}⁡x+\\operatorname{coth}⁡x}{{e}^{x}}\\end{aligned}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186167593 #edb/ref 1058 #edb/ref 17592186167594 #edb/ref 17592186045417] [17592186167593 #edb/ref 1061 31178 #edb/ref 17592186045417] [17592186167593 #edb/ref 1062 #uuid "b64d6121-c7b1-598c-88b7-d93e228e9eaa" #edb/ref 17592186045417] [17592186167593 #edb/ref 1063 #edb/ref 17592186166761 #edb/ref 17592186045417] [17592186167594 #edb/ref 1058 #edb/ref 17592186167595 #edb/ref 17592186045417] [17592186167594 #edb/ref 1061 31180 #edb/ref 17592186045417] [17592186167594 #edb/ref 1062 #uuid "78f3cfb7-8cc3-5af3-a38d-387410a4f13c" #edb/ref 17592186045417] [17592186167594 #edb/ref 1063 #edb/ref 17592186166762 #edb/ref 17592186045417] [17592186167595 #edb/ref 1058 #edb/ref 17592186167596 #edb/ref 17592186045417] [17592186167595 #edb/ref 1061 31181 #edb/ref 17592186045417] [17592186167595 #edb/ref 1062 #uuid "1dc4c0db-f2ea-5960-841d-325f01516019" #edb/ref 17592186045417] [17592186167595 #edb/ref 1063 #edb/ref 17592186166763 #edb/ref 17592186045417] [17592186167596 #edb/ref 1058 #edb/ref 17592186167711 #edb/ref 17592186045417] [17592186167596 #edb/ref 1061 31182 #edb/ref 17592186045417] [17592186167596 #edb/ref 1062 #uuid "5d7db477-93fd-5bed-83a1-3451d28c23a2" #edb/ref 17592186045417] [17592186167596 #edb/ref 1063 #edb/ref 17592186166764 #edb/ref 17592186045417] [17592186167700 #edb/ref 1058 #edb/ref 17592186167593 #edb/ref 17592186045417] [17592186167700 #edb/ref 1061 32692 #edb/ref 17592186045417] [17592186167700 #edb/ref 1062 #uuid "a9dbf529-bcef-5ee9-8535-112f0fae57f5" #edb/ref 17592186045417] [17592186167700 #edb/ref 1063 #edb/ref 17592186168090 #edb/ref 17592186045417] [17592186167711 #edb/ref 1061 32719 #edb/ref 17592186045417] [17592186167711 #edb/ref 1062 #uuid "143b8be3-52fa-5eb8-99d4-c0ff1ef2dbfd" #edb/ref 17592186045417] [17592186167711 #edb/ref 1063 #edb/ref 17592186168101 #edb/ref 17592186045417] [17592186168090 #edb/ref 1064 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe derivatives of the reciprocal hyperbolic functions are as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x) & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{csch}⁡x) & =-\\operatorname{csch}⁡x\\operatorname{coth}⁡x \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x) & =-{csch}^{2}⁡x\\end{aligned}\n$$\n\nLet's use these results to find the derivative of \n\n$$\ny= \\sech x - 2\\csch x.\n$$\n\nDifferentiating term-by-term, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x-2\\operatorname{csch}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)+\\frac{\\text{d}}{\\text{d}x}(-2\\operatorname{csch}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)-2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{csch}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x-2(-\\operatorname{csch}⁡x\\operatorname{coth}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x+2\\operatorname{csch}⁡x\\operatorname{coth}⁡x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186168090 #edb/ref 1065 5208 #edb/ref 17592186045417] [17592186168090 #edb/ref 1066 #uuid "9f94990a-0da5-522a-9d5f-7e0b269b50ac" #edb/ref 17592186045417] [17592186168090 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186168101 #edb/ref 1064 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$ \n\nWe wish to prove the following result:\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\sech{x}) = -\\sech{x} \\tanh{x}.\n$$\n\nTo do this, we can use the fact that\n\n$$\n\\sech x = \\dfrac{1}{\\cosh x}.\n$$\n\nDifferentiating the above equation using the chain rule, we arrive at\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{\\operatorname{cosh}⁡x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}{(\\operatorname{cosh}⁡x)}^{-1} \\\\  & =-{(\\operatorname{cosh}⁡x)}^{-2}\\cdot (\\operatorname{cosh}⁡x)^{′} \\\\  & =-\\frac{1}{{cosh}^{2}⁡x}\\cdot \\operatorname{sinh}⁡x \\\\  & =-\\frac{1}{\\operatorname{cosh}⁡x}\\cdot \\frac{\\operatorname{sinh}⁡x}{\\operatorname{cosh}⁡x} \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\end{aligned}\n$$\n\nWe can prove the results for the derivatives of the hyperbolic cosecant and cotangent in a similar way." #e