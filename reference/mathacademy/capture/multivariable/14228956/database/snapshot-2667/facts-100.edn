226952983" #edb/ref 17592186045417] [17592186411460 #edb/ref 1068 #edb/ref 17592186411455 #edb/ref 17592186045417] [17592186411460 #edb/ref 1069 "q-95002" #edb/ref 17592186045417] [17592186411460 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186411460 #edb/ref 1071 "Which curve is defined by the equation $3{x}_{1}^{2}+10{x}_{1}{x}_{2}+3{x}_{2}^{2}=32?$" #edb/ref 17592186045417] [17592186411460 #edb/ref 1072 #uuid "6abf962b-d107-56b7-9263-80678639c14a" #edb/ref 17592186045417] [17592186411460 #edb/ref 1074 "Consider the quadratic form $Q(x)=3{x}_{1}^{2}+10{x}_{1}{x}_{2}+3{x}_{2}^{2}.$ To determine the curve defined by the given equation, we reduce $Q(x)$ to its canonical (diagonal) form.  \n\nFirst, we write down the matrix of $Q(x),$ which is\n\n$$\nA=\\begin{bmatrix}3 & 5 \\\\ 5 & 3\\end{bmatrix}.\n$$\n\nNext, we find the eigenvalues of $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ \\begin{vmatrix}3-\\lambda  & 5 \\\\ 5 & 3-\\lambda \\end{vmatrix} & =0 \\\\ {\\lambda }^{2}-6\\lambda -16 & =0 \\\\ \\lambda  & =8,\\,-2\\end{aligned}\n$$\n\n \n\nSo, our quadratic form can be reduced to $8{y}_{1}^{2}-2{y}_{2}^{2}.$  \n\nIn the new variables, the curve has the following equation:\n\n$$\n\\begin{aligned}8{y}_{1}^{2}-2{y}_{2}^{2} & =32 \\\\ \\frac{{y}_{1}^{2}}{4}-\\frac{{y}_{2}^{2}}{16} & =1 \\\\ \\frac{{y}_{1}^{2}}{{2}^{2}}-\\frac{{y}_{2}^{2}}{{4}^{2}} & =1\\end{aligned}\n$$\n\nThis is a hyperbola with semiaxes  $2$ and $4.$" #edb/ref 17592186045443] [17592186411462 #edb/ref 1068 #edb/ref 17592186411456 #edb/ref 17592186045417] [17592186411462 #edb/ref 1069 "q-94985" #edb/ref 17592186045417] [17592186411462 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186411462 #edb/ref 1071 "Which curve is defined by the equation $9{x}_{1}^{2}+4{x}_{1}{x}_{2}+6{x}_{2}^{2}=10?$" #edb/ref 17592186045417] [17592186411462 #edb/ref 1072 #uuid "f8d1da1f-2237-5249-8b88-e74004bb86c1" #edb/ref 17592186045417] [17592186411462 #edb/ref 1074 "Consider the quadratic form $Q(x)=9{x}_{1}^{2}+4{x}_{1}{x}_{2}+6{x}_{2}^{2}.$ To determine the curve defined by the given equation, we reduce $Q(x)$ to its canonical (diagonal) form.  \n\nFirst, we write down the matrix of $Q(x),$ which is\n\n$$\nA=\\begin{bmatrix}9 & 2 \\\\ 2 & 6\\end{bmatrix}.\n$$\n\nNext, we find the eigenvalues of $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ \\begin{vmatrix}9-\\lambda  & 2 \\\\ 2 & 6-\\lambda \\end{vmatrix} & =0 \\\\ {\\lambda }^{2}-15\\lambda +50 & =0 \\\\ \\lambda  & =5,\\,10\\end{aligned}\n$$\n\nSo, our quadratic form can be reduced to $5{y}_{1}^{2}+10{y}_{2}^{2}.$ \n\nIn the new variables, the curve has the following equation:\n\n$$\n\\begin{aligned}5{y}_{1}^{2}+10{y}_{2}^{2} & =10 \\\\ \\frac{{y}_{1}^{2}}{2}+\\frac{{y}_{2}^{2}}{1} & =1 \\\\ \\frac{{y}_{1}^{2}}{(\\sqrt{2})^{2}}+\\frac{{y}_{2}^{2}}{1} & =1\\end{aligned}\n$$\n\nThis is an ellipse with semiaxes $\\sqrt{2}$ and $1.$" #edb/ref 17592186045443] [17592186411463 #edb/ref 1058 #edb/ref 17592186411467 #edb/ref 17592186045417] [17592186411463 #edb/ref 1062 #uuid "19ff91ae-0eac-5f3c-95d1-bb03c7aa3351" #edb/ref 17592186045417] [17592186411463 #edb/ref 1063 #edb/ref 17592186162668 #edb/ref 17592186045417] [17592186411464 #edb/ref 1058 #edb/ref 17592186411466 #edb/ref 17592186045417] [17592186411464 #edb/ref 1062 #uuid "226f8cb7-5c22-5a4b-8d5c-99f40fa38b6f" #edb/ref 17592186045417] [17592186411464 #edb/ref 1063 #edb/ref 17592186411460 #edb/ref 17592186045417] [17592186411465 #edb/ref 1058 #edb/ref 17592186411464 #edb/ref 17592186045417] [17592186411465 #edb/ref 1062 #uuid "8ca779b8-f452-5804-afcb-78fa42b0b171" #edb/ref 17592186045417] [17592186411465 #edb/ref 1063 #edb/ref 17592186411462 #edb/ref 17592186045417] [17592186411466 #edb/ref 1058 #edb/ref 17592186411463 #edb/ref 17592186045417] [17592186411466 #edb/ref 1062 #uuid "a7ad5297-15e9-5030-bffe-fb54ed0eec36" #edb/ref 17592186045417] [17592186411466 #edb/ref 1063 #edb/ref 17592186411461 #edb/ref 17592186045417] [1