17592186402964} {:db/id #edb/ref 17592186402971} {:db/id #edb/ref 17592186403919} {:db/id #edb/ref 17592186531567} {:db/id #edb/ref 17592186531569}] :knowledge-point/title "Identifying Functions That Satisfy the Mean Value Theorem"} :step/id #uuid "4737b469-c8a4-5051-b73e-2b3bd7b686fa" :step/math-academy-id 24870}] :activity/title "The Mean Value Theorem" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064394}] [{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186531664} :activity/id #uuid "5a848c20-0415-5b02-b95f-ce0a23286fca" :activity/scope {:db/id #edb/ref 17592186048434 :topic/id #uuid "9ef976b2-cf49-59ec-9689-0ec6f4a92d3c" :topic/math-academy-id 288} :activity/steps [{:db/id #edb/ref 17592186531664 :step/content {:db/id #edb/ref 17592186531571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e9674ae-a147-5879-9568-2a43d2058b4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1\\,,\\sqrt{2}" :db/id #edb/ref 17592186530890} {:answer/id #uuid "4010086b-848a-5ea5-82de-eb24b3bb903e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}\\,,1" :db/id #edb/ref 17592186530999} {:answer/id #uuid "56368eb0-62cd-5b47-9649-8a52b20f1665" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186531052} {:answer/id #uuid "65d4cdaf-8675-5f83-94c6-0e9ced9ebd24" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm 1" :db/id #edb/ref 17592186531090} {:answer/id #uuid "7c35d7e8-37ab-5494-bf3b-b68ee9403499" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,,-2" :db/id #edb/ref 17592186531136}] :answer-field/correct {:db/id #edb/ref 17592186531052} :answer-field/id #uuid "c188be5e-98c5-59a5-b9d1-5475ca041c52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531515}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "25541256-5bc3-5680-8cfb-415ab2841d24" :question/math-academy-id "q-2343" :question/problem "Find the values of $c$ that satisfy the mean value theorem for \n $f(x)=2\\sqrt{x}$ on the interval $[0,4].$" :question/worked-solution "The function $f(x)$ is continuous on $[0,4]$ and differentiable on $(0,4),$ hence we can apply the mean value theorem. \n\nSo, the mean value theorem states that there exists a $c\\in (0,4)$ such that\n\n$$\n{f}^{′}(c)=\\frac{f(b)-f(a)}{b-a}.\n$$\n\nPlugging in $a=0$ and $b=4$ into the above gives\n\n$$\n\\begin{aligned}{f}^{′}(c) & =\\frac{f(4)-f(0)}{4-0} \\\\  & =\\frac{2\\sqrt{4}-2\\sqrt{0}}{4} \\\\  & =1.\\end{aligned}\n$$\n\nDifferentiating the function, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\sqrt{x})=\\frac{1}{\\sqrt{x}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{f}^{′}(c)=\\frac{1}{\\sqrt{c}}.\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{c}} & =1 \\\\ \\sqrt{c} & =1 \\\\ c & =1.\\end{aligned}\n$$"} :step/id #uuid "0b76c144-7c47-52de-9ea9-c39e20d2a05c" :step/next {:db/id #edb/ref 17592186531665}} {:db/id #edb/ref 17592186531665 :step/content {:db/id #edb/ref 17592186531632 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1831d77f-6d94-535e-ba17-45caba096ee5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b0/b00ecf32276a82367046a6cdc46a17ea16b7fd3a035db7fb89125129f4a98f36.png" :db/id #edb/ref 17592186530911} {:answer/id #uuid "361edf4f-989a-5330-8717-5e168840ee5f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4b/4ba47b9edb9b81c308f10cd894f30647e0717d72c2e4b410fab64d8b6d363013.png" :db/id #edb/ref 17592186530983} {:answer/id #uuid "9a397c28-aebc-5165-84c8-77548e6c6984" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c6/c6dd83eb0ca7715be6eae23d99b994fb5c999c723174360ab76891b13524e320.png" :db/id #edb/ref 17592186531194} {:answer/id #uuid "ac0dd388-1826-523a-8f01-94e20b377afb" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/49/498484746591fb92b30dc1dd6e85b5c09aa92beb87685942b2d750461cbe8d0d.png" :db/id #edb/ref 17592186531234} {:answer/id #uuid "fc586a0d-ed5f-586b-95eb-1d8d3942c34d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/71/717c5ea51719c9f25058408d34b40fc2d380047805f987d505ee950dfbe87c7b.png" :db/id #edb/ref 17592186531377}] :answer-field/correct {:db/id #edb/ref 17592186531234} :answer-field/id #uuid "1a9534ff-8431-5338-90d3-6411bea7e74e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531407}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b1af75bd-8ab0-5a82-8a2c-c57f1e5066dc" :question/math-academy-id "q-48398" :question/problem "Which of the following functions satisfies the conditions of the mean value theorem over the interval $[-1,2]?$" :question/worked-solution "For a function to satisfy the conditions of the mean value theorem over the interval $[-1,2],$ the function must be continuous on $[-1,2]$ and differentiable on $(-1,2).$\n\nFirst, notice that the function $s(x)$ is continuous on $[-1,2]$ and differentiable on $(-1,2)$, so it satisfies the conditions of the mean value theorem.\n\nLet's check each of the other functions individually.\n\n- The function  $f(x)$ is continuous on $[-1,2]$ but has a corner point at $x=1.$   Hence, is not differentiable at $x=1,$ which means it is not differentiable on $(-1,2).$  Therefore, $f(x)$ does not satisfy the conditions of the mean value theorem.\n\n- The function  $h(x)$ has a jump discontinuity at $x=0.$ Hence, it  is not continuous on $[-1,2].$ Therefore, $h(x)$ does not satisfy the conditions of the mean value theorem.\n\n- The function  $t(x)$ is continuous on $[-1,2]$ but has a corner point at $x=0.5.$   Hence, it is not differentiable on $(-1,2).$  Therefore, $t(x)$ does not satisfy the conditions of the mean value theorem.\n\n- The function $g(x)$ has a vertical asymptote at $x=0.$ Hence, it is not continuous on $[-1,2].$ Therefore, $g(x)$ does not satisfy the conditions of the mean value theorem."} :step/id #uuid "110a422c-b425-51b1-9039-ab22fcb85ae9" :step/next {:db/id #edb/ref 17592186531685}} {:db/id #edb/ref 17592186531685 :step/content {:db/id #edb/ref 17592186531569 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25b53ada-f0fa-5620-859d-46e155938572" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186530948} {:answer/id #uuid "4b606b0d-c85c-5360-bdd7-67fd8245daac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186531025} {:answer/id #uuid "890029d8-4943-5351-a156-ee82a4b37c23" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186531164} {:answer/id #uuid "a9ff7038-2739-5c1e-85fc-4d2fdc8e845d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186531231} {:answer/id #uuid "fef64265-7919-570e-9e0f-096179d44242" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186531381}] :answer-field/correct {:db/id #edb/ref 17592186531381} :answer-field/id #uuid "9b8e4d58-166a-531b-89d6-01969b1f483c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531491}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "225c5ace-861b-5b33-b01d-abc5c6cb132b" :question/math-academy-id "q-77862" :question/problem "Which of the following functions satisfies the conditions of the mean value theorem over the interval $[2,4]?$\n\nI. $f(x)={e}^{x}+1$\n\nII. $g(x)=\\operatorname{ln}⁡x$\n\nIII. $h(x)=\\frac{1}{x+1}$" :question/worked-solution "For a function to satisfy the conditions of the mean value theorem over the interval $[2,4],$ the function must be continuous on $[2,4]$ and differentiable on $(2,4).$\n\nLet's check each function individually.\n\n- The function $f(x)={e}^{x}+1$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it is continuous on $[2,4]$ and differentiable on $(2,4).$ Therefore, $f(x)$ satisfies the conditions of the mean value theorem.\n\n- The function $g(x)=\\operatorname{ln}⁡x$ is continuous and differentiable on $(0,\\infty ).$ In particular, it is continuous on $[2,4]$ and differentiable on $(2,4).$ Therefore, $g(x)$ satisfies the conditions of the mean value theorem.\n\n- The function $h(x)=\\frac{1}{x+1}$ is continuous and differentiable on $(-\\infty ,-1)\\cup (-1,\\infty ).$ In particular, it is continuous on $[2,4]$ and differentiable on $(2,4).$ Therefore, $h(x)$ satisfies the conditions of the mean value theorem.\n\nTherefore, the functions I, II, and III satisfy the conditions for the mean value theorem over the interval $[2,4].$"} :step/id #uuid "4388043b-7356-590d-9a11-82470f55a57a" :step/next {:db/id #edb/ref 17592186531716}} {:db/id #edb/ref 17592186531698 :step/content {:db/id #edb/ref 17592186064956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a96f50a5-7721-5945-b9c7-f525bdf78a7b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/95/959db01677f31ea4f7e10e0c4db590010e8ba7ff64f2deabca824cd34b68a6d1.png" :db/id #edb/ref 17592186063792} {:answer/id #uuid "d6d6fecd-2235-5c00-b701-55f360b03be1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/3d/3dee4ba9c2e7b12dda550efe2fb081fc6cd4c2396fe31d2f31e8245dac3575e2.png" :db/id #edb/ref 17592186063793} {:answer/id #uuid "15aef9f9-6b3a-522c-b204-c33657691514" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e7/e7b6ba63ee9acb2629563641ae602579a763430dfe7486c2ba25b085495efe3e.png" :db/id #edb/ref 17592186063794} {:answer/id #uuid "19b3875e-e443-54ec-a935-a1419e4f2722" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/f8/f843e90ba3ad7b26108e0815335fb9b44344e183065c67c6a8278ca7e4d54242.png" :db/id #edb/ref 17592186063795} {:answer/id #uuid "4e6f00cb-f8f8-593e-bb15-3d38a95f0dd6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/43/4324a20e8c78f511091a31db7e4394c1e51757ba42c1863057fa0a922987053f.png" :db/id #edb/ref 17592186063796}] :answer-field/correct {:db/id #edb/ref 17592186063793} :answer-field/id #uuid "7406c7fa-38d3-558f-a244-487dfb4d1270" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186063791}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bb231cda-9e8d-5f1f-b35c-880fa7f744f7" :question/math-academy-id "q-77891" :question/problem "Which of the following functions satisfies the conditions of the mean value theorem over the interval $[-2,2]?$" :question/worked-solution "For a function to satisfy the conditions of the mean value theorem over the interval $[-2,2],$ the function must be continuous on $[-2,2]$ and differentiable on $(-2,2).$\n\nFirst, notice that the function $s(x)$ is continuous on $[-2,2]$ and differentiable on $(-2,2)$, so it satisfies the conditions of the mean value theorem.\n\nLet's check each of the other functions individually.\n\n- The function $f(x)$ is continuous on $[-2,2]$ but has a corner point at $x=1.$ Hence, $f(x)$ is not differentiable at $x=1,$ which means it is not differentiable on $(-2,2).$ Therefore, $f(x)$ does not satisfiy the conditions of the mean value theorem.\n\n- The function  $h(x)$ is continuous on $[-2,2]$ but has corner points at $x=\\pm 1.$ Hence, $h(x)$ is not differentiable at $x=\\pm 1,$ which means it is not differentiable on $(-2,2).$ Therefore, $h(x)$ does not satisfiy the conditions of the mean value theorem.\n\n- The function $p(x)$ has a jump discontinuity at $x=-1.$ Hence, $p(x)$ is not continuous on $[-2,2].$ Therefore, $p(x)$ does not satisfiy the conditions of the mean value theorem.\n\n- The function $t(x)$ has a vertical asymptote at $x=1.$ Hence, $t(x)$  is not continuous on $[-2,2].$ Therefore, $t(x)$ does not satisfiy the conditions of the mean value theorem."} :step/id #uuid "87d4cbb3-7160-5663-9f62-7416ecf098d0"} {:db/id #edb/ref 17592186531716 :step/content {:db/id #edb/ref 17592186531567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c1ef230-0d99-5c1f-8d27-3c9c320c2d37" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186530993} {:answer/id #uuid "64f8f555-b29a-5712-b45f-4405639612a0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186531086} {:answer/id #uuid "8a89ac6f-c58e-5f2e-b088-1f3e54ca549f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186531166} {:answer/id #uuid "e0f14253-e313-5d66-a24f-f584115125d2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186531324} {:answer/id #uuid "e1d6750e-77d4-5a7f-9f58-2a3cb2171378" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186531326}] :answer-field/correct {:db/id #edb/ref 17592186531166} :answer-field/id #uuid "29ef2aff-afe9-507f-b7de-dc2ad513b4a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186531416}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1d671ef3-a015-5e44-a360-62d57b505322" :question/math-academy-id "q-77866" :question/problem "Which of the following functions satisfies the conditions of the mean value theorem over the interval $[-1,1]?$\n\nI. $f(x)=\\frac{1}{{x}^{2}-1}$\n\nII. $g(x)={x}^{2}-1$\n\nIII. $h(x)={e}^{{x}^{2}-1}$" :question/worked-solution "For a function to satisfy the conditions of the mean value theorem over the interval $[-1,1],$ the function must be continuous on $[-1,1]$ and differentiable on $(-1,1).$\n\nLet's check each function individually.\n\n- The function $f(x)=\\frac{1}{{x}^{2}-1}$ is not defined at $x=\\pm 1,$ hence, it is not continuous at $x=\\pm 1,$ and so it is not continuous on $[-1,1].$ Therefore, $f(x)$ does not satisfiy the conditions of the mean value theorem.\n\n- The function $g(x)={x}^{2}-1$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it is continuous on $[-1,1]$ and differentiable on $(-1,1).$ Therefore, $g(x)$ satisfies the conditions of the mean value theorem.\n\n- The function $h(x)={e}^{{x}^{2}-1}$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it is continuous on $[-1,1]$ and differentiable on $(-1,1).$ Therefore, $h(x)$ satisfies the conditions of the mean value theorem.\n\nTherefore, only the functions II and III satisfy the conditions for the mean value theorem over the interval $[-1,1].$"} :step/id #uuid "ceb8fe3c-9091-5a0f-b315-d9d7d76bdc62" :step/next {:db/id #edb/ref 17592186531698}}] :activity/title "The Mean Value Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186530856}]}
