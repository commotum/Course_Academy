ctive Statements as Conditionals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb4ad52e-c1dd-5079-bf6f-6f08096788a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you water the plants, they won't grow." :db/id #edb/ref 17592186057284} {:answer/id #uuid "c3c04a1f-1007-562d-a24a-d4e9da7a0948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't water the plants, they will grow." :db/id #edb/ref 17592186057285} {:answer/id #uuid "e1b08f6a-2a82-5bb6-847d-d9e21319234a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Water the plants, and they will grow." :db/id #edb/ref 17592186057286} {:answer/id #uuid "e91aac3c-d79a-549a-9ebc-ac66773de2cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't water the plants, they won't grow." :db/id #edb/ref 17592186057287} {:answer/id #uuid "23b9824a-bf06-5a7c-8405-baec3031c9f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you water the plants, they will grow." :db/id #edb/ref 17592186057288}] :answer-field/id #uuid "ae4fbb4b-bcb7-589e-82fa-0dcaa8d296d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057283} {:answer-field/choices [{:answer/id #uuid "202c8237-3888-53f9-b30f-02e259152607" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you water the plants, they will grow." :db/id #edb/ref 17592186401744} {:answer/id #uuid "118d90f3-6d32-5afe-8e02-cbf41ba95880" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't water the plants, they will grow." :db/id #edb/ref 17592186401745} {:answer/id #uuid "89772d8b-75f5-5288-933b-dbba82a0628b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't water the plants, they won't grow." :db/id #edb/ref 17592186401746} {:answer/id #uuid "a723dd49-b3ce-5d3b-8bbe-d9d5caf0b650" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you water the plants, they won't grow." :db/id #edb/ref 17592186401747} {:answer/id #uuid "69265ef0-339f-5ed1-8244-d0a8e9f42458" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Water the plants, and they will grow." :db/id #edb/ref 17592186401748}] :answer-field/correct {:answer/id #uuid "202c8237-3888-53f9-b30f-02e259152607" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you water the plants, they will grow." :db/id #edb/ref 17592186401744} :answer-field/id #uuid "95a3fcff-39ee-51ea-961b-901f1fa75b71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401743}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c37bd0c3-9779-5d09-a1bb-d6c4e0fab0c7" :question/math-academy-id "q-182595" :question/problem "$\\,$ Either you do not water the plants, or they will grow.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ You do not water the plants.\n\n- $B:$ The plants will grow.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You water the plants.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you water the plants, then they will grow.\n\nWe can write this in more everyday language as follows:\n\n$\\,$ If you water the plants, they will grow.\n\n**Note**: \n\nUsing the word \"Either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(¬P∨Q)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true."}] [{:db/id #edb/ref 17592186411064 :knowledge-point/_questions [{:db/id #edb/ref 17592186059688 :knowledge-point/id #uuid "0936217d-66d2-5360-b88b-a30683720415" :knowledge-point/title "Expressing Disjunctive Statements as Conditionals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50d09d1f-cca0-5966-9603-721e0fd176bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't wear a seatbelt, you won't be safe." :db/id #edb/ref 17592186411010} {:answer/id #uuid "54410627-bf6a-5ebd-8c2f-24cf4377b4c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't wear a seatbelt, you'll be safe." :db/id #edb/ref 17592186411011} {:answer/id #uuid "63d8127b-ac0b-521d-8659-2c189d0397b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you wear a seatbelt, you won't be safe." :db/id #edb/ref 17592186411015} {:answer/id #uuid "7f017770-d6b6-5bde-a043-0413160c76ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you wear a seatbelt, you'll be safe." :db/id #edb/ref 17592186411021} {:answer/id #uuid "88f19e57-12d9-52cf-9408-6a343c734323" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Wear a seatbelt, and you'll be safe." :db/id #edb/ref 17592186411024}] :answer-field/correct {:answer/id #uuid "7f017770-d6b6-5bde-a043-0413160c76ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you wear a seatbelt, you'll be safe." :db/id #edb/ref 17592186411021} :answer-field/id #uuid "0a91c6d7-ac78-5cf8-b390-0e03441f721f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411048}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94ae2108-4770-5706-9cb7-823f98b8c863" :question/math-academy-id "q-182596" :question/problem "$\\,$ Either you do not wear a seatbelt, or you'll be safe.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ You do not wear a seatbelt.\n\n- $B:$ You'll be safe.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You wear a seatbelt.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you wear a seatbelt, then you'll be safe.\n\nWe can write this in more everyday language as follows:\n\n$\\,$ If you wear a seatbelt, you'll be safe.\n\n**Note**: \n\nUsing the word \"Either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(¬P∨Q)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true."}] [{:db/id #edb/ref 17592186522795 :knowledge-point/_questions [{:db/id #edb/ref 17592186059688 :knowledge-point/id #uuid "0936217d-66d2-5360-b88b-a30683720415" :knowledge-point/title "Expressing Disjunctive Statements as Conditionals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07787d1c-e983-5e3a-9efd-7d51b93c7d0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you don't get enough sleep, you will be alert the next day." :db/id #edb/ref 17592186522029} {:answer/id #uuid "20c41708-7e4a-50b6-b570-ad244db5adbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "If you 