              "value": "If you water the plants, they will grow.",
              "html": "If you water the plants, they will grow."
            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-182595-b",
              "type": "text",
              "value": "If you don't water the plants, they will grow.",
              "html": "If you don't water the plants, they will grow."
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-182595-c",
              "type": "text",
              "value": "If you water the plants, they won't grow.",
