            },
            {
              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-182509-b",
              "type": "text",
              "value": "Either you follow the recipe, or the dish will be delicious.",
              "html": "Either you follow the recipe, or the dish will be delicious."
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-182509-c",
              "type": "text",
              "value": "Either you do not follow the recipe, or the dish will be delicious.",
