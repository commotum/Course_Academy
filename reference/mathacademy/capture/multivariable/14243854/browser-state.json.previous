      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14243854/observations/step-q39208-bc854141ed75563e7b80.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14243854/observations/step-q39208-bc854141ed75563e7b80.png",
      "source_url": "https://mathacademy.com/tasks/14243854/topics/2017/lesson",
      "captured_at": 1792100113.6874602,
      "math_academy_id": "q-39208",
