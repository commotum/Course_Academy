      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14243854/observations/step-q81702-6f5581d14c7f5411dfd9.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14243854/observations/step-q81702-6f5581d14c7f5411dfd9.png",
