lass=\"ORD\"><mn>21</mn></mrow></msub><mo>⋅</mo><mtext>Area</mtext><mo stretchy=\"false\">(</mo><msub><mi>R</mi><mrow data-mjx-texclass=\"ORD\"><mn>21</mn></mrow></msub><mo stretchy=\"false\">)</mo><mo>+</mo><msub><mi>M</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn></mrow></msub><mo>⋅</mo><mtext>Area</mtext><mo stretchy=\"false\">(</mo><msub><mi>R</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn></mrow></msub><mo stretchy=\"false\">)</mo><mo>+</mo><msub><mi>M</mi><mrow data-mjx-texclass=\"ORD\"><mn>22</mn></mrow></msub><mo>⋅</mo><mtext>Area</mtext><mo stretchy=\"false\">(</mo><msub><mi>R</mi><mrow data-mjx-texclass=\"ORD\"><mn>22</mn></mrow></msub><mo stretchy=\"false\">)</mo><mo>,</mo></math></mjx-assistive-mml></mjx-container></p>\n<p>where <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"250\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D440 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em; margin-left: -0.081em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D456 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D457 TEX-I\"></mjx-c></mjx-mi></mjx-texatom></mjx-script></mjx-msub></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>M</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mi>j</mi></mrow></msub></math></mjx-assistive-mml></mjx-container> is the <em>maximum</em> value of <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"251\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org