}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}) \\\\  & ={x}^{x}(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+\\frac{1}{{cos}^{2}⁡x}) \\\\  & ={x}^{x}(\\operatorname{tan}⁡x\\operatorname{ln}⁡x+\\operatorname{tan}⁡x+{sec}^{2}⁡x)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186506546 #edb/ref 1068 #edb/ref 17592186506439 #edb/ref 17592186045417] [17592186506546 #edb/ref 1068 #edb/ref 17592186506493 #edb/ref 17592186045417] [17592186506546 #edb/ref 1068 #edb/ref 17592186506501 #edb/ref 17592186045417] [17592186506546 #edb/ref 1069 "q-312655" #edb/ref 17592186045417] [17592186506546 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186506546 #edb/ref 1071 "Given that $y=({x}^{3}-2x){e}^{{x}^{4}+5x},$ find ${y}^{′}.$\n\n${y}^{′}={e}^{{x}^{4}+5x}($\n{{field-1}}${x}^{6}\\,-$\n{{field-2}}${x}^{4}\\,+$\n{{field-3}}${x}^{3}+3{x}^{2}-10x-2)$" #edb/ref 17592186045417] [17592186506546 #edb/ref 1072 #uuid "62910e77-69f8-56ea-ac31-ee2dbfe3c8ff" #edb/ref 17592186045417] [17592186506546 #edb/ref 1074 "We have the function \n\n$$\ny=({x}^{3}-2x){e}^{{x}^{4}+5x}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{3}-2x){e}^{{x}^{4}+5x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{3}-2x)+\\operatorname{ln}⁡({e}^{{x}^{4}+5x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{3}-2x)+{x}^{4}+5x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{3}-2x)+{x}^{4}+5x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5 \\\\ \\frac{{y}^{′}}{y} & =\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5)\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{3}-2x){e}^{{x}^{4}+5x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =({x}^{3}-2x){e}^{{x}^{4}+5x}(\\frac{3{x}^{2}-2}{{x}^{3}-2x}+4{x}^{3}+5) \\\\  & ={e}^{{x}^{4}+5x}[3{x}^{2}-2+(4{x}^{3}+5)({x}^{3}-2x)] \\\\  & ={e}^{{x}^{4}+5x}(4{x}^{6}-8{x}^{4}+5{x}^{3}+3{x}^{2}-10x-2)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186506552 #edb/ref 1068 #edb/ref 17592186506389 #edb/ref 17592186045417] [17592186506552 #edb/ref 1069 "q-138849" #edb/ref 17592186045417] [17592186506552 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186506552 #edb/ref 1071 "Consider the function $y=\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\sqrt{{x}^{2}+1}(x-3)^{3}(a{x}^{2}+bx+c).\n$$\n\nFind the value of $a+b+c.$" #edb/ref 17592186045417] [17592186506552 #edb/ref 1072 #uuid "76085196-6a2f-5c76-90cb-5c742aa98a2b" #edb/ref 17592186045417] [17592186506552 #edb/ref 1074 "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}} \\\\  & =\\sqrt{({x}^{2}+1)^{3}}\\cdot \\sqrt{(x-3)^{8}} \\\\  & =({x}^{2}+1)^{3/2}(x-3)^{8/2} \\\\  & =({x}^{2}+1)^{3/2}(x-3)^{4}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the product and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)^{3/2}(x-3)^{4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)^{3/2})+\\operatorname{ln}⁡((x-3)^{4}) \\\\ \\operatorname{ln}⁡y & =\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+1)+4\\operatorname{ln}⁡(x-3)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+1)+4\\operatorname{ln}⁡(x-3)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{3}{2}\\cdot \\frac{1}{{x}^{2}+1}\\cdot 2x+4\\cdot \\frac{1}{x-3} \\\\ \\frac{{y}^{′}}{y} & =\\frac{3x}{{x}^{2}+1}+\\frac{4}{x-3}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{3x}{{x}^{2}+1}+\\frac{4}{x-3})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}(\\frac{3x}{{x}^{2}+1}+\\frac{4}{x-3}) \\\\  & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}(\\frac{3x(x-3)+4({x}^{2}+1)}{({x}^{2}+1)(x-3)}) \\\\  & =\\sqrt{({x}^{2}+1)^{3}(x-3)^{8}}(\\frac{7{x}^{2}-9x+4}{({x}^{2}+1)(x-3)}) \\\\  & =({x}^{2}+1)^{3/2}(x-3)^{4}(\\frac{7{x}^{2}-9x+4}{({x}^{2}+1)(x-3)}) \\\\  & =({x}^{2}+1)^{1/2}(x-3)^{3}(7{x}^{2}-9x+4) \\\\  & =\\sqrt{{x}^{2}+1}(x-3)^{3}(7{x}^{2}-9x+4)\\end{aligned}\n$$\n\n  \n\nTherefore,\n\n$$\na+b+c=7+(-9)+4=2.\n$$" #edb/ref 17592186045417] [17592186506564 #edb/ref 1068 #edb/ref 17592186506398 #edb/ref 17592186045417] [17592186506564 #edb/ref 1068 #edb/ref 17592186506448 #edb/ref 17592186045417] [17592186506564 #edb/ref 1068 #edb/ref 17592186506461 #edb/ref 17592186045417] [17592186506564 #edb/ref 1069 "q-338291" #edb/ref 17592186045417] [17592186506564 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186506564 #edb/ref 1071 "Consider the function $y=\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}.$  Find the derivative of $y.$\n\n| ${y}^{′}$ | $=$ | $(x+2)^{3}\\,(-5{x}^{3}\\,-$\n{{field-1}}${x}^{2}\\,+$ \n{{field-2}}$x\\,-$\n{{field-3}}$)$ |\n| --- | --- | --- |\n|  |  | ${({x}^{3}+2x-1)}^{4}$ |" #edb/ref 17592186045417] [17592186506564 #edb/ref 1072 #uuid "8a442047-ed6e-5bb4-89b9-beaee4b1e553" #edb/ref 17592186045417] [17592186506564 #edb/ref 1074 "We have the function \n\n$$\ny=\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+2)^{4})-\\operatorname{ln}⁡({({x}^{3}+2x-1)}^{3}) \\\\ \\operatorname{ln}⁡y & =4\\operatorname{ln}⁡(x+2)-3\\operatorname{ln}⁡({x}^{3}+2x-1)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{ln}⁡(x+2))-\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{ln}⁡({x}^{3}+2x-1)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =4\\cdot \\frac{1}{x+2}-3\\cdot \\frac{1}{{x}^{3}+2x-1}\\cdot (3{x}^{2}+2) \\\\ \\frac{{y}^{′}}{y} & =\\frac{4}{x+2}-\\frac{3(3{x}^{2}+2)}{{x}^{3}+2x-1} \\\\ \\frac{{y}^{′}}{y} & =\\frac{4}{x+2}-\\frac{9{x}^{2}+6}{{x}^{3}+2x-1}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{4}{x+2}-\\frac{9{x}^{2}+6}{{x}^{3}+2x-1})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}(\\frac{4}{x+2}-\\frac{9{x}^{2}+6}{{x}^{3}+2x-1}) \\\\  & =\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}(\\frac{4({x}^{3}+2x-1)-(x+2)(9{x}^{2}+6)}{(x+2)({x}^{3}+2x-1)}) \\\\  & =\\frac{(x+2)^{4}}{{({x}^{3}+2x-1)}^{3}}(\\frac{-5{x}^{3}-18{x}^{2}+2x-16}{(x+2)({x}^{3}+2x-1)}) \\\\  & =\\frac{(x+2)^{3}(-5{x}^{3}-18{x}^{2}+2x-16)}{{({x}^{3}+2x-1)}^{4}}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186506577 #edb/ref 1068 #edb/ref 17592186506387 #edb/ref 17592186045417] [17592186506577 #edb/ref 1069 "q-138830" #edb/ref 17592186045417] [17592186506577 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186506577 #edb/ref 1071 "Consider the function $y=\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{(x+3)^{5}(x+8)^{4}}{{sin}^{8}⁡x}(ax+63-8({x}^{2}+bx+c)\\operatorname{cot}⁡x).\n$$\n\nFind the value of $a+b+c.$" #edb/ref 17592186045417] [17592186506577 #edb/ref 1072 #uuid "adde1803-10ec-5c3d-8c04-d7e2c5d99587" #edb/ref 17592186045417] [17592186506577 #edb/ref 1074 "We have the function \n\n$$\ny=\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product, quotient, and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+3)^{6})+\\operatorname{ln}⁡((x+8)^{5})-\\operatorname{ln}⁡({sin}^{8}⁡x) \\\\ \\operatorname{ln}⁡y & =6\\operatorname{ln}⁡(x+3)+5\\operatorname{ln}⁡(x+8)-8\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\n \n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(6\\operatorname{ln}⁡(x+3)+5\\operatorname{ln}⁡(x+8)-8\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =6\\cdot \\frac{1}{x+3}+5\\cdot \\frac{1}{x+8}-8\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot \\operatorname{cos}⁡x \\\\ \\frac{{y}^{′}}{y} & =\\frac{6}{x+3}+\\frac{5}{x+8}-8\\operatorname{cot}⁡x\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{6}{x+3}+\\frac{5}{x+8}-8\\operatorname{cot}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}(\\frac{6}{x+3}+\\frac{5}{x+8}-8\\operatorname{cot}⁡x) \\\\  & =\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}(\\frac{6(x+8)+5(x+3)-8\\operatorname{cot}⁡x(x+3)(x+8)}{(x+3)(x+8)}) \\\\  & =\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}(\\frac{6x+48+5x+15-8\\operatorname{cot}⁡x({x}^{2}+11x+24)}{(x+3)(x+8)}) \\\\  & =\\frac{(x+3)^{6}(x+8)^{5}}{{sin}^{8}⁡x}(\\frac{11x+63-8\\operatorname{cot}⁡x({x}^{2}+11x+24)}{(x+3)(x+8)}) \\\\  & =\\frac{(x+3)^{5}(x+8)^{4}}{{sin}^{8}⁡x}(11x+63-8\\operatorname{cot}⁡x({x}^{2}+11x+24))\\end{aligned}\n$$\n\nTherefore,\n\n$$\na+b+c=11+11+24=46.\n$$" #edb/ref 17592186045417] [17592186506581 #edb/ref 1068 #edb/ref 17592186506416 #edb/ref 17592186045417] [17592186506581 #edb/ref 1068 #edb/ref 17592186506436 #edb/ref 17592186045417] [17592186506581 #edb/ref 1068 #edb/ref 17592186506472 #edb/ref 17592186045417] [17592186506581 #edb/ref 1069 "q-343327" #edb/ref 17592186045417] [17592186506581 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186506581 #edb/ref 1071 "Given that $y={(2x-3)}^{7}{({x}^{3}+5)}^{4},$ find ${y}^{′}.$\n\n${y}^{′}={(2x-3)}^{6}{({x}^{3}+5)}^{3}($\n{{field-1}}${x}^{3}\\,-$\n{{field-2}}${x}^{2}\\,+$\n{{field-3}}$)$" #edb/ref 17592186045417] [17592186506581 #edb/ref 1072 #uuid "b9ab7545-6c81-5c20-9f25-5d780715f99d" #edb/ref 17592186045417] [17592186506581 #edb/ref 1074 "We have the function \n\n$$\ny={(2x-3)}^{7}{({x}^{3}+5)}^{4}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the product rule for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({(2x-3)}^{7}{({x}^{3}+5)}^{4}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({(2x-3)}^{7})+\\operatorname{ln}⁡({({x}^{3}+5)}^{4}) \\\\ \\operatorname{ln}⁡y & =7\\operatorname{ln}⁡(2x-3)+4\\operatorname{ln}⁡({x}^{3}+5)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(7\\operatorname{ln}⁡(2x-3)+4\\operatorname{ln}⁡({x}^{3}+5)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5} \\\\ \\frac{{y}^{′}}{y} & =7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5})\\end{aligned}\n$$\n\nFinally, we substitute $y={(2x-3)}^{7}{({x}^{3}+5)}^{4}:$\n\n$$\n\\begin{aligned}{y}^{′} & ={(2x-3)}^{7}{({x}^{3}+5)}^{4}(7\\cdot \\frac{2}{2x-3}+4\\cdot \\frac{3{x}^{2}}{{x}^{3}+5}) \\\\  & ={(2x-3)}^{6}{({x}^{3}+5)}^{3}[14({x}^{3}+5)+12{x}^{2}(2x-3)] \\\\  & ={(2x-3)}^{6}{({x}^{3}+5)}^{3}(38{x}^{3}-36{x}^{2}+70)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186506582 #edb/ref 1068 #edb/ref 17592186506489 #edb/ref 17592186045417] [17592186506582 #edb/ref 1069 "q-138865" #edb/ref 17592186045417] [17592186506582 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186506582 #edb/ref 1071 "Consider the function $y=\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{a{x}^{5}+3{x}^{4}+b{x}^{3}-{x}^{2}+c}{({x}^{2}+2x+2)^{3/2}\\sqrt{{x}^{4}+2x}}.\n$$\n\nFind the value of $a+b+c.$" #edb/ref 17592186045417] [17592186506582 #edb/ref 1072 #uuid "bc8a78e5-ffc8-5ad6-abfc-11fb82c73f1a" #edb/ref 17592186045417] [17592186506582 #edb/ref 1074 "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}} \\\\  & =\\frac{\\sqrt{{x}^{4}+2x}}{\\sqrt{{x}^{2}+2x+2}} \\\\  & =\\frac{({x}^{4}+2x)^{1/2}}{({x}^{2}+2x+2)^{1/2}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{({x}^{4}+2x)^{1/2}}{({x}^{2}+2x+2)^{1/2}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{4}+2x)^{1/2})-\\operatorname{ln}⁡(({x}^{2}+2x+2)^{1/2}) \\\\ \\operatorname{ln}⁡y & =\\frac{1}{2}\\operatorname{ln}⁡({x}^{4}+2x)-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+2x+2)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$ \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}\\operatorname{ln}⁡({x}^{4}+2x)-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+2x+2)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{1}{2}\\cdot \\frac{1}{{x}^{4}+2x}\\cdot (4{x}^{3}+2)-\\frac{1}{2}\\cdot \\frac{1}{{x}^{2}+2x+2}\\cdot (2x+2) \\\\ \\frac{{y}^{′}}{y} & =\\frac{2{x}^{3}+1}{{x}^{4}+2x}-\\frac{x+1}{{x}^{2}+2x+2}\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{2{x}^{3}+1}{{x}^{4}+2x}-\\frac{x+1}{{x}^{2}+2x+2})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}(\\frac{2{x}^{3}+1}{{x}^{4}+2x}-\\frac{x+1}{{x}^{2}+2x+2}) \\\\  & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}(\\frac{(2{x}^{3}+1)({x}^{2}+2x+2)-(x+1)({x}^{4}+2x)}{({x}^{4}+2x)({x}^{2}+2x+2)}) \\\\  & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}(\\frac{2{x}^{5}+4{x}^{4}+4{x}^{3}+{x}^{2}+2x+2-({x}^{5}+{x}^{4}+2{x}^{2}+2x)}{({x}^{4}+2x)({x}^{2}+2x+2)}) \\\\  & =\\sqrt{\\frac{{x}^{4}+2x}{{x}^{2}+2x+2}}(\\frac{{x}^{5}+3{x}^{4}+4{x}^{3}-{x}^{2}+2}{({x}^{4}+2x)({x}^{2}+2x+2)}) \\\\  & =\\frac{1{x}^{5}+3{x}^{4}+4{x}^{3}-{x}^{2}+2}{({x}^{2}+2x+2)^{3/2}\\sqrt{{x}^{4}+2x}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\na+b+c=1+4+2=7.\n$$" #edb/ref 17592186045417] [17592186506591 #edb/ref 1068 #edb/ref 17592186506421 #edb/ref 17592186045417] [17592186506591 #edb/ref 1069 "q-138839" #edb/ref 17592186045417] [17592186506591 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186506591 #edb/ref 1071 "Consider the function $y=\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}((x+2)^{2}+g(x)).\n$$\n\nFind the function $g(x).$" #edb/ref 17592186045417] [17592186506591 #edb/ref 1072 #uuid "dbe4c4ed-7bf7-5234-8564-800989eb5aa4" #edb/ref 17592186045417] [17592186506591 #edb/ref 1074 "We have the function \n\n$$\ny=\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x+1)^{{x}^{2}})-\\operatorname{ln}⁡({e}^{2-4x}) \\\\ \\operatorname{ln}⁡y & ={x}^{2}\\operatorname{ln}⁡(x+1)-(2-4x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}\\operatorname{ln}⁡(x+1)-2+4x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2x\\operatorname{ln}⁡(x+1)+{x}^{2}\\cdot \\frac{1}{x+1}+4 \\\\ \\frac{{y}^{′}}{y} & =2x\\operatorname{ln}⁡(x+1)+\\frac{{x}^{2}}{x+1}+4\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =y(2x\\operatorname{ln}⁡(x+1)+\\frac{{x}^{2}}{x+1}+4)\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}(2x\\operatorname{ln}⁡(x+1)+\\frac{{x}^{2}}{x+1}+4) \\\\  & =\\frac{(x+1)^{{x}^{2}}}{{e}^{2-4x}}(\\frac{2x(x+1)\\operatorname{ln}⁡(x+1)+{x}^{2}+4(x+1)}{x+1}) \\\\  & =\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}(2x(x+1)\\operatorname{ln}⁡(x+1)+{x}^{2}+4(x+1)) \\\\  & =\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}(2x(x+1)\\operatorname{ln}⁡(x+1)+{x}^{2}+4x+4) \\\\  & =\\frac{(x+1)^{{x}^{2}-1}}{{e}^{2-4x}}(2x(x+1)\\operatorname{ln}⁡(x+1)+(x+2)^{2})\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=2x(x+1)\\operatorname{ln}⁡(x+1).\n$$" #edb/ref 17592186045417]}
