#{[{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186483468} :activity/id #uuid "573c8163-64a6-518f-9257-259186333e47" :activity/scope {:db/id #edb/ref 17592186049282 :topic/id #uuid "e9af0219-7eb8-5b10-84c1-b7b5e8e30ae2" :topic/math-academy-id 3135} :activity/steps [{:db/id #edb/ref 17592186483456 :step/content {:db/id #edb/ref 17592186381167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f91c060-1fa0-55c9-82ca-586858149896" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186381169} {:answer/id #uuid "4711cefb-885c-5942-9f66-c806cb454df0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40" :db/id #edb/ref 17592186381170} {:answer/id #uuid "d4ae897b-52f5-58cc-a221-7597c77bcfe6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "56" :db/id #edb/ref 17592186381171} {:answer/id #uuid "0f5add15-e5e2-590a-b0b9-6d2e985be77b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "72" :db/id #edb/ref 17592186381172} {:answer/id #uuid "a5c22afc-36e6-5a76-858a-e48fbc55caaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "48" :db/id #edb/ref 17592186381173}] :answer-field/correct {:db/id #edb/ref 17592186381169} :answer-field/id #uuid "e1e9584a-673b-51f0-b53c-287d33ed13f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186381168}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "af4d9872-e5f1-5908-9e2c-823c372b1386" :question/math-academy-id "q-158689" :question/problem "$$\nA=[\\begin{aligned}0 & 2 \\\\ 2 & 1 \\\\ -1 & 1\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}],\\,W=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 4\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ above. If the normal equation for the corresponding weighted least-squares problem $W\\,Ax=Wb$ is given by\n\n$$\n[\\begin{aligned}a & -8 \\\\ -8 & b\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}8 \\\\ c\\end{aligned}]\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=[\\begin{aligned}{1}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {4}^{2}\\end{aligned}]=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 16\\end{aligned}],\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}0 & 2 & -1 \\\\ 2 & 1 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 16\\end{aligned}][\\begin{aligned}0 & 2 \\\\ 2 & 1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}0 & 2 & -1 \\\\ 2 & 1 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 16\\end{aligned}][\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}0 & 2 & -1 \\\\ 2 & 1 & 1\\end{aligned}][\\begin{aligned}0 & 2 \\\\ 8 & 4 \\\\ -16 & 16\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}0 & 2 & -1 \\\\ 2 & 1 & 1\\end{aligned}][\\begin{aligned}2 \\\\ 4 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}32 & -8 \\\\ -8 & 24\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}8 \\\\ 8\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=32+24+8=64.\n$$"} :step/id #uuid "410908c7-9a98-57f0-be29-8a517140c24f"} {:db/id #edb/ref 17592186483468 :step/content {:db/id #edb/ref 17592186269153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aec2b63-f6ab-57d8-9cbf-7cfe2f6a0ab4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "83" :db/id #edb/ref 17592186266373} {:answer/id #uuid "6776d505-0ea9-5d82-98b8-abdd249a6f37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "125" :db/id #edb/ref 17592186267062} {:answer/id #uuid "8f277fb5-3e68-5daa-a4b1-45aca22b5340" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186267421} {:answer/id #uuid "98253d3e-d45f-5786-9812-228cadeaf451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "115" :db/id #edb/ref 17592186267507} {:answer/id #uuid "ff7e0d0e-2bc3-5a94-90ce-4884cd539fa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "155" :db/id #edb/ref 17592186268396}] :answer-field/correct {:db/id #edb/ref 17592186267507} :answer-field/id #uuid "c1ae9b0b-4f23-5327-89b8-fe2ff5687954" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268753}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d251c204-1fcf-5b0d-a53c-6a871be40e20" :question/math-academy-id "q-137881" :question/problem "$$\nA=[\\begin{aligned}1 & 3 \\\\ -1 & 1 \\\\ -1 & 0\\end{aligned}],\\,b=[\\begin{aligned}1 \\\\ -1 \\\\ 0\\end{aligned}],\\,W=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 2\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ above. If the normal equation for the corresponding weighted least-squares problem $W\\,Ax=Wb$ is given by\n\n$$\n[\\begin{aligned}a & 23 \\\\ 23 & b\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}c \\\\ 23\\end{aligned}]\n$$\n\nwhat is the value of $a+b+c?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=[\\begin{aligned}{3}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {2}^{2}\\end{aligned}]=[\\begin{aligned}9 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{aligned}],\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & -1 & -1 \\\\ 3 & 1 & 0\\end{aligned}][\\begin{aligned}9 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}1 & 3 \\\\ -1 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & -1 & -1 \\\\ 3 & 1 & 0\\end{aligned}][\\begin{aligned}9 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}1 \\\\ -1 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}1 & -1 & -1 \\\\ 3 & 1 & 0\\end{aligned}][\\begin{aligned}9 & 27 \\\\ -4 & 4 \\\\ -4 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & -1 & -1 \\\\ 3 & 1 & 0\\end{aligned}][\\begin{aligned}9 \\\\ -4 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}17 & 23 \\\\ 23 & 85\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}13 \\\\ 23\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=17+85+13=115.\n$$"} :step/id #uuid "6e709a23-5648-505a-9cf2-c078b18494cd" :step/next {:db/id #edb/ref 17592186483499}} {:db/id #edb/ref 17592186483470 :step/content {:db/id #edb/ref 17592186278195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1837262d-ff49-5dc0-83dc-18a2a52a47d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186275702} {:answer/id #uuid "83ad3cee-ea0e-56c1-b1e1-0033f7ef2b3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-17" :db/id #edb/ref 17592186276660} {:answer/id #uuid "a6db5086-e388-525f-b82e-43ab2607f8e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186276982} {:answer/id #uuid "da92de70-9727-5c4f-a7b9-538c8d5065dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186277394} {:answer/id #uuid "ddd8000e-3029-5f03-9736-b53484ed1a2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{17}" :db/id #edb/ref 17592186277423}] :answer-field/correct {:db/id #edb/ref 17592186277394} :answer-field/id #uuid "ebadb5d8-fe72-566c-b39f-5c8e9dc439a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186278139}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "36a6e17d-f83c-53ad-b495-79ac2ba0a0eb" :question/math-academy-id "q-158458" :question/problem "$$\nA=[\\begin{aligned}3 & -6 \\\\ 2 & -4 \\\\ 1 & -2\\end{aligned}],\\,b=[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}],\\,W=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 2\\end{aligned}].\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ shown above. If the general solution for the weighted least-squares problem $W\\,Ax=Wb$ is \n\n$$\n[\\begin{aligned}a \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}b \\\\ c\\end{aligned}],\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of  $17a+\\frac{b}{c}?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=[\\begin{aligned}{1}^{2} & 0 & 0 \\\\ 0 & {1}^{2} & 0 \\\\ 0 & 0 & {2}^{2}\\end{aligned}]=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{aligned}],\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}3 & 2 & 1 \\\\ -6 & -4 & -2\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}3 & -6 \\\\ 2 & -4 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}3 & 2 & 1 \\\\ -6 & -4 & -2\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\ [\\begin{aligned}3 & 2 & 1 \\\\ -6 & -4 & -2\\end{aligned}][\\begin{aligned}3 & -6 \\\\ 2 & -4 \\\\ 4 & -8\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}3 & 2 & 1 \\\\ -6 & -4 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 2 \\\\ -4\\end{aligned}] \\\\ [\\begin{aligned}17 & -34 \\\\ -34 & 68\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}3 \\\\ -6\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}17 & -34 & 3 \\\\ -34 & 68 & -6\\end{aligned}] & {R}_{2}:={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}17 & -34 & 3 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=\\frac{3}{17}+2{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n[\\begin{aligned}\\frac{3}{17}+2{x}_{2} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}\\frac{3}{17} \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\n17a+\\frac{b}{c}=17(\\frac{3}{17})+\\frac{2}{1}=5.\n$$"} :step/id #uuid "702d868a-a1c8-52cb-817f-20990764bc4d" :step/next {:db/id #edb/ref 17592186483456}} {:db/id #edb/ref 17592186483475 :step/content {:db/id #edb/ref 17592186269158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78477676-aaff-5c06-b1ee-eed5c9f6e6a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186267201} {:answer/id #uuid "790ad49f-51e6-5334-ae95-279f0ce3dc86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186267211} {:answer/id #uuid "bd677b76-300d-5ff0-a2d1-18c188c2bcc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186267841} {:answer/id #uuid "e775e691-a907-5ec0-a57d-a631428e4806" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186268196} {:answer/id #uuid "f4b80e3d-d6ae-5ee2-a000-d151a92c4224" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186268316}] :answer-field/correct {:db/id #edb/ref 17592186267841} :answer-field/id #uuid "b8b344ad-6420-5f55-82f7-f81014532210" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186268734}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f530dfca-e960-58b4-85b6-e3859f215c3f" :question/math-academy-id "q-137926" :question/problem "$$\nA=[\\begin{aligned}1 & 2 \\\\ -2 & -4 \\\\ 0 & 0\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ -4 \\\\ 4\\end{aligned}],\\,W=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 3\\end{aligned}].\n$$\n\nConsider the matrices $A$ and $W,$ and the vector $b$ shown above. If the general solution for the weighted least-squares problem $W\\,Ax=Wb$ is \n\n$$\n[\\begin{aligned}a \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}b \\\\ c\\end{aligned}],\\,{x}_{2}\\in R,\n$$\n\nwhat is the value of  $a+\\frac{b}{c}?$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=[\\begin{aligned}{3}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {3}^{2}\\end{aligned}]=[\\begin{aligned}9 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 9\\end{aligned}],\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & -2 & 0 \\\\ 2 & -4 & 0\\end{aligned}][\\begin{aligned}9 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 9\\end{aligned}][\\begin{aligned}1 & 2 \\\\ -2 & -4 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & -2 & 0 \\\\ 2 & -4 & 0\\end{aligned}][\\begin{aligned}9 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 9\\end{aligned}][\\begin{aligned}2 \\\\ -4 \\\\ 4\\end{aligned}] \\\\ [\\begin{aligned}1 & -2 & 0 \\\\ 2 & -4 & 0\\end{aligned}][\\begin{aligned}9 & 18 \\\\ -8 & -16 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & -2 & 0 \\\\ 2 & -4 & 0\\end{aligned}][\\begin{aligned}18 \\\\ -16 \\\\ 36\\end{aligned}] \\\\ [\\begin{aligned}25 & 50 \\\\ 50 & 100\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}50 \\\\ 100\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the system corresponding to the above matrix equation using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}25 & 50 & 50 \\\\ 50 & 100 & 100\\end{aligned}] & {R}_{2}:={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}25 & 50 & 50 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we have \n\n$$\n{x}_{1}=2-2{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n[\\begin{aligned}2-2{x}_{2} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}2 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}-2 \\\\ 1\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, we have\n\n$$\na+\\frac{b}{c}=2+\\frac{(-2)}{1}=0.\n$$"} :step/id #uuid "751743ec-996c-5a2a-bfd6-fa0a4fc9b5c2" :step/next {:db/id #edb/ref 17592186483470}} {:db/id #edb/ref 17592186483499 :step/content {:db/id #edb/ref 17592186388511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a098abef-eb06-522c-858c-8b857ee8a01f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186388513} {:answer/id #uuid "5aed0d3b-0792-5228-9ce6-408af4d938ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}2 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186388514} {:answer/id #uuid "d738c650-2185-5af3-9c36-fdda0ee056af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186388515} {:answer/id #uuid "b9398833-d22e-5297-be90-347916839a20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186388516} {:answer/id #uuid "09d5b5d2-4025-5a44-aced-68c3caf11839" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}-2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186388517}] :answer-field/correct {:db/id #edb/ref 17592186388515} :answer-field/id #uuid "390c184b-3595-5e47-8db5-afa305ac9721" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186388512}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "12606daf-a2ce-5ddc-9fc1-a30958174a13" :question/math-academy-id "q-137905" :question/problem "Find the solution for the weighted least-squares problem $W\\,Ax=Wb,$ where\n\n$$\nA=[\\begin{aligned}1 & 2 \\\\ -1 & 1 \\\\ -1 & 0\\end{aligned}],\\,b=[\\begin{aligned}3 \\\\ -4 \\\\ 2\\end{aligned}],\\,W=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 2\\end{aligned}].\n$$" :question/worked-solution "To get the normal equation corresponding to $W\\,Ax=Wb,$ we pre-multiply both sides of the equation by $(W\\,A)^{T}:$\n\n$$\n\\begin{aligned}(W\\,A)^{T}\\cdot W\\,Ax & =(W\\,A)^{T}\\cdot Wb \\\\ {A}^{T}({W}^{T}W)Ax & ={A}^{T}({W}^{T}W)b\\end{aligned}\n$$\n\nNow, since\n\n$$\n{W}^{T}W=[\\begin{aligned}{1}^{2} & 0 & 0 \\\\ 0 & {2}^{2} & 0 \\\\ 0 & 0 & {2}^{2}\\end{aligned}]=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{aligned}],\n$$\n\nour normal equation can be written as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & -1 & -1 \\\\ 2 & 1 & 0\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}1 & 2 \\\\ -1 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & -1 & -1 \\\\ 2 & 1 & 0\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}3 \\\\ -4 \\\\ 2\\end{aligned}] \\\\ [\\begin{aligned}1 & -1 & -1 \\\\ 2 & 1 & 0\\end{aligned}][\\begin{aligned}1 & 2 \\\\ -4 & 4 \\\\ -4 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & -1 & -1 \\\\ 2 & 1 & 0\\end{aligned}][\\begin{aligned}3 \\\\ -16 \\\\ 8\\end{aligned}] \\\\ [\\begin{aligned}9 & -2 \\\\ -2 & 8\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}11 \\\\ -10\\end{aligned}]\\end{aligned}\n$$\n\nFinally, since the matrix on the left-hand side is invertible, we obtain\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & ={[\\begin{aligned}9 & -2 \\\\ -2 & 8\\end{aligned}]}^{-1}[\\begin{aligned}11 \\\\ -10\\end{aligned}] \\\\  & =\\frac{1}{9\\cdot 8-(-2)\\cdot (-2)}[\\begin{aligned}8 & 2 \\\\ 2 & 9\\end{aligned}][\\begin{aligned}11 \\\\ -10\\end{aligned}] \\\\  & =\\frac{1}{68}[\\begin{aligned}68 \\\\ -68\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -1\\end{aligned}].\\end{aligned}\n$$"} :step/id #uuid "d99942ec-6a5c-5573-82e8-6cbe4cc7bec4" :step/next {:db/id #edb/ref 17592186483475}}] :activity/title "Weighted Least-Squares" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186482803}]}
