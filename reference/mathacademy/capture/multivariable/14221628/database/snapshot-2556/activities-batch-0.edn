#{[{:activity/expected-seconds 1380.0 :activity/first-step {:db/id #edb/ref 17592186079388} :activity/id #uuid "90d79c17-70ff-5e9b-8f6f-cc71f6ec671c" :activity/scope {:db/id #edb/ref 17592186049650 :topic/id #uuid "07fde130-1b24-5086-ac8d-0443c3af56b8" :topic/math-academy-id 648} :activity/steps [{:db/id #edb/ref 17592186079388 :step/content {:db/id #edb/ref 17592186079607 :tutorial/content "For a particle moving in the $xy$-plane with position vector $\\mathbf{r}(t),$ we calculate the velocity vector $\\mathbf{v}(t)$ by differentiating $\\mathbf{r}$ with respect to $t.$ So, how do we find the position vector $\\mathbf{r}(t)$ of a particle given its velocity $\\mathbf{v}(t)?$\n\nWe need to do the reverse of differentiation, so we integrate $\\mathbf{v}(t)$ with respect to $t\\mathbin{:}$\n\n$$\n\\mathbf{v}(t) = \\frac{\\textrm{d}\\mathbf{r}}{\\textrm{d}t} \\quad\\Longrightarrow\\quad \\mathbf{r}(t) = \\int \\mathbf{v}(t)\\,\\textrm{d}t.\n$$\n\nWe're often given the position at some time $t,$ and we can determine the arbitrary constant of integration using that information." :tutorial/id #uuid "86fda900-3920-531f-aae7-34d7141e5eea" :tutorial/math-academy-id 1115 :tutorial/title "Introduction"} :step/id #uuid "3bc53c85-8fb5-53fa-8831-b99bb3039a65" :step/math-academy-id 2193 :step/next {:db/id #edb/ref 17592186079389}} {:db/id #edb/ref 17592186079389 :step/content {:db/id #edb/ref 17592186078483 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078331 :question/id #uuid "14f41e91-3d92-5977-b42f-578d4caba951" :question/math-academy-id "e-625"} :knowledge-point/id #uuid "47989094-35d2-561f-add4-f1d427cd8a20" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049202} {:db/id #edb/ref 17592186050951}] :knowledge-point/questions [{:db/id #edb/ref 17592186079154} {:db/id #edb/ref 17592186079195} {:db/id #edb/ref 17592186256638} {:db/id #edb/ref 17592186320789} {:db/id #edb/ref 17592186320791} {:db/id #edb/ref 17592186332876} {:db/id #edb/ref 17592186403537}] :knowledge-point/title "Finding a Position Vector Given a Velocity Vector"} :step/id #uuid "0d98d580-624f-5dab-997b-63fb52fe39c5" :step/math-academy-id 2194 :step/next {:db/id #edb/ref 17592186079390}} {:db/id #edb/ref 17592186079390 :step/content {:db/id #edb/ref 17592186078484 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078332 :question/id #uuid "b5a4461e-fda6-50d2-98df-0c4937cc3e50" :question/math-academy-id "e-626"} :knowledge-point/id #uuid "5ff12d64-7e03-596b-83e6-c91d22600452" :knowledge-point/questions [{:db/id #edb/ref 17592186079052} {:db/id #edb/ref 17592186079057} {:db/id #edb/ref 17592186320792} {:db/id #edb/ref 17592186320793} {:db/id #edb/ref 17592186351510} {:db/id #edb/ref 17592186354415} {:db/id #edb/ref 17592186387187} {:db/id #edb/ref 17592186535044}] :knowledge-point/title "Calculating a Position Vector Given a Velocity Vector and Time"} :step/id #uuid "f6dd2a26-a41b-5180-8053-8f7f3b27d963" :step/math-academy-id 2197 :step/next {:db/id #edb/ref 17592186079391}} {:db/id #edb/ref 17592186079391 :step/content {:db/id #edb/ref 17592186078485 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078333 :question/id #uuid "ea193f94-9171-5f20-9167-207761800c93" :question/math-academy-id "e-627"} :knowledge-point/id #uuid "49aa6b33-42fb-5f28-89c5-019eadcaf1a0" :knowledge-point/questions [{:db/id #edb/ref 17592186079051} {:db/id #edb/ref 17592186079211} {:db/id #edb/ref 17592186319169} {:db/id #edb/ref 17592186320804} {:db/id #edb/ref 17592186320808} {:db/id #edb/ref 17592186320809} {:db/id #edb/ref 17592186354416} {:db/id #edb/ref 17592186535073} {:db/id #edb/ref 17592186535076}] :knowledge-point/title "Finding the Times When a Particle Is at a Certain Location Given Its Velocity Vector"} :step/id #uuid "1fc76cfc-b7b4-5a46-aac3-978342efa3ff" :step/math-academy-id 2200 :step/next {:db/id #edb/ref 17592186079414}} {:db/id #edb/ref 17592186079414 :step/content {:db/id #edb/ref 17592186078504 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078356 :question/id #uuid "7ef2b355-cfca-5d57-b0f2-acd534663662" :question/math-academy-id "e-7343"} :knowledge-point/id #uuid "279c5e4e-db19-584b-becb-10864fcba188" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050510}] :knowledge-point/questions [{:db/id #edb/ref 17592186079196} {:db/id #edb/ref 17592186079197} {:db/id #edb/ref 17592186320861} {:db/id #edb/ref 17592186320866} {:db/id #edb/ref 17592186339068} {:db/id #edb/ref 17592186387194} {:db/id #edb/ref 17592186527956} {:db/id #edb/ref 17592186534975} {:db/id #edb/ref 17592186535013}] :knowledge-point/title "Finding a Position Vector Given an Acceleration Vector"} :step/id #uuid "69c7797b-d04e-501d-a037-f445a1d28b90" :step/math-academy-id 27228}] :activity/title "Finding Displacement Vectors in Two Dimensions Using Integration" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186078670}] [{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186535101} :activity/id #uuid "e32a9487-7283-5482-91ff-0280d5cfa3d2" :activity/scope {:db/id #edb/ref 17592186049650 :topic/id #uuid "07fde130-1b24-5086-ac8d-0443c3af56b8" :topic/math-academy-id 648} :activity/steps [{:db/id #edb/ref 17592186535097 :step/content {:db/id #edb/ref 17592186535073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f4d3e58-1a06-55b3-8d8a-253f122c2f7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=2" :db/id #edb/ref 17592186534328} {:answer/id #uuid "3b11ce37-8ee8-5667-b95d-c6c40475adaf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=5" :db/id #edb/ref 17592186534378} {:answer/id #uuid "7306054b-0128-5b0d-b3f4-b15c499deeaa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The particle is never at the origin" :db/id #edb/ref 17592186534509} {:answer/id #uuid "76d77a6a-9075-58d1-96c5-7903feb7ab81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=3" :db/id #edb/ref 17592186534520} {:answer/id #uuid "975ce232-2b73-5609-a251-e2146288e6c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t=0" :db/id #edb/ref 17592186534599}] :answer-field/correct {:db/id #edb/ref 17592186534520} :answer-field/id #uuid "52d8812b-e4f6-535d-8703-947e3c409cdb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534881}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d9799b8b-4af9-5ece-b36d-864fdc8c4517" :question/math-academy-id "q-50514" :question/problem "The velocity $v$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\nv(t)=⟨2t-2,2t⟩\\,,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nGiven that the particle is at the position  $r=⟨-4,-8⟩$ when $t=1,$ find the times when the particle is at the origin." :question/worked-solution "The particle is at the origin when its position is $r=⟨0,0⟩.$ So first, we need to compute the position function of the particle.\n\nTo compute the position vector, we need to integrate the velocity vector:\n\n$$\n\\begin{aligned}r(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int ⟨2t-2,2t⟩\\,\\text{d}t \\\\  & =⟨\\int (2t-2)\\,\\text{d}t,\\,\\int 2t\\,\\text{d}t⟩ \\\\  & =⟨{t}^{2}-2t+{C}_{1},\\,{t}^{2}+{C}_{2}⟩.\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $r(0)=⟨-4,\\,-8⟩.$ Substituting $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =⟨(1)^{2}-2(1)+{C}_{1},\\,(1)^{2}+{C}_{2}⟩ \\\\ ⟨-4,\\,-8⟩ & =⟨-1+{C}_{1},\\,1+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=-3$ and ${C}_{2}=-9.$ Therefore, the position of $P$ at time $t$ is given by\n\n$$\n\\begin{aligned}r(t) & =⟨{t}^{2}-2t-3,\\,{t}^{2}-9⟩.\\end{aligned}\n$$\n\nTo find the times at which the particle is at the origin, we solve the equation $r(t)=0.$\n\n$$\n\\begin{aligned}r(t) & =0 \\\\ ⟨{t}^{2}-2t-3,\\,{t}^{2}-9⟩ & =⟨0,0⟩.\\end{aligned}\n$$\n\nSo we need\n\n$$\n\\begin{aligned}{t}^{2}-2t-3=(t-3)(t+1) & =0\\,⇒\\,t=-1,3, \\\\ {t}^{2}-9=(t+3)(t-3) & =0\\,⇒\\,t=\\pm 3.\\end{aligned}\n$$\n\nThe only solution that satisfies both equations is $t=3.$"} :step/id #uuid "197c6117-5c00-5077-8365-1a9c9af6dfe0" :step/next {:db/id #edb/ref 17592186535116}} {:db/id #edb/ref 17592186535101 :step/content {:db/id #edb/ref 17592186535013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f750c9c-9563-5dff-b76b-6cdab6489c2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨{t}^{2}-6t-3,\\,{t}^{2}-6t+3⟩" :db/id #edb/ref 17592186534299} {:answer/id #uuid "73c2b755-2071-5c0c-9b6a-6f55d2c24877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨{t}^{2}-6t-1,\\,{t}^{2}-6t+1⟩" :db/id #edb/ref 17592186534514} {:answer/id #uuid "8196c611-8269-5b46-aaab-fcda97fa7905" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨{t}^{2}-4t+1,\\,{t}^{2}-4t+1⟩" :db/id #edb/ref 17592186534546} {:answer/id #uuid "d06485ea-0969-5fee-ab0d-205e477ec3d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨{t}^{2}-4t-1,\\,{t}^{2}-4t+1⟩" :db/id #edb/ref 17592186534732} {:answer/id #uuid "e1a93bdc-1551-59df-9664-dd4c01781ef6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r=⟨{t}^{2}-4t-3,\\,{t}^{2}-4t+3⟩" :db/id #edb/ref 17592186534767}] :answer-field/correct {:db/id #edb/ref 17592186534514} :answer-field/id #uuid "73458c53-8f94-50f4-87a0-6b7b8f52ee68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534894}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "581fcb98-ffbb-541a-98a8-b1aad8f2210c" :question/math-academy-id "q-7220" :question/problem "The acceleration $a$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\na(t)=⟨2,2⟩.\n$$\n\nGiven that the particle is at the position $(-10,-8)$ and has velocity $⟨0,0⟩$ when $t=3,$ calculate the position vector of $P$ at time $t.$" :question/worked-solution "To compute the position vector, we need to integrate the velocity vector. To find the velocity vector, we first need to integrate the acceleration vector. \n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int ⟨2,2⟩\\,\\text{d}t \\\\  & =⟨\\int 2\\,\\text{d}t,\\int 2\\,\\text{d}t⟩ \\\\  & =⟨2t+{C}_{1},\\,2t+{C}_{2}⟩\\end{aligned}\n$$\n\nWe can solve for the constants of integration using the fact that $v(3)=⟨0,0⟩.$ Substituting $t=3,$ we get\n\n$$\n\\begin{aligned}v(3) & =⟨2(3)+{C}_{1},\\,2(3)+{C}_{2}⟩ \\\\ ⟨0,0⟩ & =⟨6+{C}_{1},6+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=-6$ and ${C}_{2}=-6.$ Therefore, the velocity vector is\n\n$$\nv(t)=⟨2t-6,\\,2t-6⟩.\n$$\n\nWe can compute the position vector by integrating the velocity vector.\n\n$$\n\\begin{aligned}r(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int ⟨2t-6,\\,2t-6⟩\\,\\text{d}t \\\\  & =⟨\\int (2t-6)\\,\\text{d}t,\\int (2t-6)\\,\\text{d}t⟩ \\\\  & =⟨{t}^{2}-6t+{C}_{3},\\,{t}^{2}-6t+{C}_{4}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $r(3)=⟨-10,-8⟩.$ Substituting $t=3,$ we get\n\n$$\n\\begin{aligned}r(3) & =⟨(3)^{2}-6(3)+{C}_{3},\\,(3)^{2}-6(3)+{C}_{4}⟩ \\\\ ⟨-10,-8⟩ & =⟨-9+{C}_{3},\\,-9+{C}_{4}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{3}=-1$ and ${C}_{4}=1.$ Therefore, the position of $P$ at time $t$ is\n\n$$\nr(t)=⟨{t}^{2}-6t-1,\\,{t}^{2}-6t+1⟩.\n$$"} :step/id #uuid "2699fe8b-82db-50e1-8352-adb382bcf01e" :step/next {:db/id #edb/ref 17592186535097}} {:db/id #edb/ref 17592186535116 :step/content {:db/id #edb/ref 17592186534975 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04cb33d6-59ad-5314-b00b-9e2eb864c2c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r(t)=⟨-4{t}^{4}-1,{e}^{-t}-5⟩" :db/id #edb/ref 17592186534271} {:answer/id #uuid "09cc6717-a213-5f9b-b691-d2184fbd9f56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r(t)=⟨2{t}^{4}-1,-{e}^{-t}-3⟩" :db/id #edb/ref 17592186534281} {:answer/id #uuid "79627921-0fbf-53b2-af26-839975422f40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r(t)=⟨{t}^{4}-1,{e}^{-t}-5⟩" :db/id #edb/ref 17592186534523} {:answer/id #uuid "a9bffbe1-0ad0-5e0b-9f4c-ef4ebf05851f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r(t)=⟨{t}^{4}-1,-{e}^{-t}-3⟩" :db/id #edb/ref 17592186534642} {:answer/id #uuid "eae18b35-0d1e-5dff-bc1d-614ad89c032c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "r(t)=⟨2{t}^{4}-1,2{e}^{-t}-6⟩" :db/id #edb/ref 17592186534788}] :answer-field/correct {:db/id #edb/ref 17592186534642} :answer-field/id #uuid "b5d207ef-09f8-5f25-8bd3-232e40b6944c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186534936}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0ad91671-88c2-5e5d-8e1f-e5e0e6fbe489" :question/math-academy-id "q-122473" :question/problem "The acceleration $a$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\na(t)=⟨12{t}^{2},-{e}^{-t}⟩.\n$$\n\nGiven that the particle is at the position $(-1,-4)$ and has velocity $⟨0,1⟩$ when $t=0,$ calculate the position vector of $P$ at time $t.$" :question/worked-solution "To compute the position vector, we need to integrate the velocity vector. To find the velocity vector, we first need to integrate the acceleration vector. \n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int ⟨12{t}^{2},-{e}^{-t}⟩\\,\\text{d}t \\\\  & =⟨\\int 12{t}^{2}\\,\\text{d}t,\\int (-{e}^{-t})\\,\\text{d}t⟩ \\\\  & =⟨4{t}^{3}+{C}_{1},{e}^{-t}+{C}_{2}⟩\\end{aligned}\n$$\n\nWe can solve for the constants of integration using the fact that $v(0)=⟨0,1⟩.$ Substituting $t=0,$ we get\n\n$$\n\\begin{aligned}v(0) & =⟨4({0}^{3})+{C}_{1},{e}^{-0}+{C}_{2}⟩ \\\\ ⟨0,1⟩ & =⟨{C}_{1},1+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=0$ and ${C}_{2}=0.$ Therefore, the velocity vector is\n\n$$\n\\begin{aligned}v(t) & =⟨4{t}^{3},{e}^{-t}⟩.\\end{aligned}\n$$\n\nWe can compute the position vector by integrating the velocity vector.\n\n$$\n\\begin{aligned}r(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int ⟨4{t}^{3},{e}^{-t}⟩\\,\\text{d}t \\\\  & =⟨\\int 4{t}^{3}\\,\\text{d}t,\\int {e}^{-t}\\,\\text{d}t⟩ \\\\  & =⟨{t}^{4}+{C}_{3},-{e}^{-t}+{C}_{4}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $r(0)=⟨-1,-4⟩.$ Substituting $t=0,$ we get\n\n$$\n\\begin{aligned}r(0) & =⟨{0}^{4}+{C}_{3},-{e}^{-0}+{C}_{4}⟩ \\\\ ⟨-1,-4⟩ & =⟨{C}_{3},-1+{C}_{4}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{3}=-1$ and ${C}_{4}=-3.$ Therefore, the position of $P$ at time $t$ is\n\n$$\n\\begin{aligned}r(t) & =⟨{t}^{4}-1,-{e}^{-t}-3⟩.\\end{aligned}\n$$"} :step/id #uuid "964e993d-11f9-583e-a087-b27639c1cb55" :step/next {:db/id #edb/ref 17592186535139}} {:db/id #edb/ref 17592186535139 :step/content {:db/id #edb/ref 17592186535044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c630aef-e5a0-5435-bc55-02515d7f328e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186534414}] :answer-field/correct {:db/id #edb/ref 17592186534414} :answer-field/id #uuid "35fe18d9-346e-5613-a2e9-e0356df52875" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534863} {:answer-field/choices [{:answer/id #uuid "96145c9c-17f6-5fc5-8bc3-7eda2b993795" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2e^{\\pi/2}-2" :db/id #edb/ref 17592186534595}] :answer-field/correct {:db/id #edb/ref 17592186534595} :answer-field/id #uuid "f16ea21d-f232-5a8c-ae03-fff1dd1ddc4f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534961}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "990e6c9c-e46f-5a33-8086-74712d90c327" :question/math-academy-id "q-351160" :question/problem "The velocity $v$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\nv(t)=⟨\\operatorname{cos}⁡t,\\,2{e}^{t}⟩.\n$$\n\nGiven that the particle is at the position $r=⟨0,0⟩$ when $t=0,$ calculate the position of $P$ at time $t=\\frac{\\pi }{2}.$ Do not round the answers.\n\n$r\\,(\\frac{\\pi }{2})=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the position vector, we need to integrate the velocity vector:\n\n$$\n\\begin{aligned}r(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int ⟨\\operatorname{cos}⁡t,\\,2{e}^{t}⟩\\,\\text{d}t \\\\  & =⟨\\int \\operatorname{cos}⁡t\\,\\text{d}t,\\,\\int 2{e}^{t}\\,\\text{d}t⟩ \\\\  & =⟨\\operatorname{sin}⁡t+{C}_{1},\\,2{e}^{t}+{C}_{2}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $r(0)=⟨0,0⟩.$ Substituting $t=0,$ we get\n\n$$\n\\begin{aligned}r(0) & =⟨\\operatorname{sin}⁡0+{C}_{1},\\,2{e}^{0}+{C}_{2}⟩ \\\\ ⟨0,0⟩ & =⟨{C}_{1},\\,2+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=0$ and ${C}_{2}=-2.$ Therefore, the position vector at time $t$ is given by\n\n$$\nr(t)=⟨\\operatorname{sin}⁡t,\\,2{e}^{t}-2⟩.\n$$\n\nTo find the position vector at time $t=\\frac{\\pi }{2},$ we substitute $t=\\frac{\\pi }{2}$ into the above, and we get\n\n$$\n\\begin{aligned}r\\,(\\frac{\\pi }{2}) & =⟨sin\\,(\\frac{\\pi }{2}),\\,2{e}^{\\pi /2}-2⟩ \\\\  & =⟨1,\\,2{e}^{\\pi /2}-2⟩ \\\\  & =⟨1,\\,2{e}^{\\pi /2}-2⟩.\\end{aligned}\n$$"} :step/id #uuid "e7d30afe-5727-5f33-9bdf-09c7bc31d07b" :step/next {:db/id #edb/ref 17592186535140}} {:db/id #edb/ref 17592186535140 :step/content {:db/id #edb/ref 17592186535076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ade985d-cf13-5aa8-a581-d30b23b27b60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186534565}] :answer-field/correct {:db/id #edb/ref 17592186534565} :answer-field/id #uuid "4102c924-5446-5636-aa75-3bbf2bddd5bc" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534869} {:answer-field/choices [{:answer/id #uuid "0173d36c-b8c7-54e9-b4c6-43de7fb95975" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186534267}] :answer-field/correct {:db/id #edb/ref 17592186534267} :answer-field/id #uuid "a97684fb-8cc0-5f02-9df1-855ab912afe7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186534924}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e49b201b-78f0-5668-9145-a0f21b5a41c8" :question/math-academy-id "q-351222" :question/problem "The velocity $v$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\nv(t)=⟨6t,\\,4t⟩,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nGiven that the particle is at the position  $r=⟨-12,\\,-8⟩$ when $t=0,$ calculate the times when the particle is at the origin. Do not round the answers.\n\nIn **ascending order**, the particle is at the origin when $t=$\n{{field-1}}\nand $t=$\n{{field-2}}." :question/worked-solution "The particle is at the origin when its position is $r=⟨0,0⟩.$ So first, we need to compute the position function of the particle.\n\nTo compute the position vector, we need to integrate the velocity vector:\n\n$$\n\\begin{aligned}r(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int ⟨6t,\\,4t⟩\\,\\text{d}t \\\\  & =⟨\\int 6t\\,\\text{d}t,\\,\\int 4t\\,\\text{d}t⟩ \\\\  & =⟨3{t}^{2}+{C}_{1},\\,2{t}^{2}+{C}_{2}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $r(0)=⟨-12,-8⟩.$ Substituting $t=0,$ we get\n\n$$\n\\begin{aligned}r(0) & =⟨3(0)^{2}+{C}_{1},\\,2(0)^{2}+{C}_{2}⟩ \\\\ ⟨-12,-8⟩ & =⟨{C}_{1},\\,{C}_{2}⟩.\\end{aligned}\n$$\n\nSo, we must have ${C}_{1}=-12$ and ${C}_{2}=-8.$ Therefore, the position of $P$ at time $t$ is given by\n\n$$\n\\begin{aligned}r(t) & =⟨3{t}^{2}-12,\\,2{t}^{2}-8⟩.\\end{aligned}\n$$\n\nTo find the times at which the particle is at the origin, we solve the equation $r(t)=⟨0,0⟩.$\n\n$$\n\\begin{aligned}⟨3{t}^{2}-12,\\,2{t}^{2}-8⟩ & =⟨0,0⟩.\\end{aligned}\n$$\n\nSo we need\n\n$$\n\\begin{aligned}3{t}^{2}-12 & =3(t-2)(t+2)=0\\,⇒\\,t=\\pm 2, \\\\ 2{t}^{2}-8 & =2(t-2)(t+2)=0\\,⇒\\,t=\\pm 2.\\end{aligned}\n$$\n\nTherefore, in ascending order, the particle is at the origin when $t=-2$ and $t=2.$"} :step/id #uuid "ee45541b-f89f-5b43-9e6c-25e482e11d0b"}] :activity/title "Finding Displacement Vectors in Two Dimensions Using Integration" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186534263}]}
