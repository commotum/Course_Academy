#{[{:activity/expected-seconds 1380.0 :activity/first-step {:db/id #edb/ref 17592186079388} :activity/id #uuid "90d79c17-70ff-5e9b-8f6f-cc71f6ec671c" :activity/scope {:db/id #edb/ref 17592186049650 :topic/id #uuid "07fde130-1b24-5086-ac8d-0443c3af56b8" :topic/math-academy-id 648} :activity/steps [{:db/id #edb/ref 17592186079388 :step/content {:db/id #edb/ref 17592186079607 :tutorial/content "For a particle moving in the $xy$-plane with position vector $\\mathbf{r}(t),$ we calculate the velocity vector $\\mathbf{v}(t)$ by differentiating $\\mathbf{r}$ with respect to $t.$ So, how do we find the position vector $\\mathbf{r}(t)$ of a particle given its velocity $\\mathbf{v}(t)?$\n\nWe need to do the reverse of differentiation, so we integrate $\\mathbf{v}(t)$ with respect to $t\\mathbin{:}$\n\n$$\n\\mathbf{v}(t) = \\frac{\\textrm{d}\\mathbf{r}}{\\textrm{d}t} \\quad\\Longrightarrow\\quad \\mathbf{r}(t) = \\int \\mathbf{v}(t)\\,\\textrm{d}t.\n$$\n\nWe're often given the position at some time $t,$ and we can determine the arbitrary constant of integration using that information." :tutorial/id #uuid "86fda900-3920-531f-aae7-34d7141e5eea" :tutorial/math-academy-id 1115 :tutorial/title "Introduction"} :step/id #uuid "3bc53c85-8fb5-53fa-8831-b99bb3039a65" :step/math-academy-id 2193 :step/next {:db/id #edb/ref 17592186079389}} {:db/id #edb/ref 17592186079389 :step/content {:db/id #edb/ref 17592186078483 :knowledge-point/canonical-example {:db/id #edb/ref 17592186078331 :question/id #uuid "14f41e91-3d92-5977-b42f-578d4caba951" :question/math-academy-id "e-625"} :knowledge-point/id #uuid "47989094-35d2-561f-add4-f1d427cd8a20" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049202} {:db/id #edb/ref 17592186050951}] :knowledge-point/questions [{:db/id #edb/ref 17592186079154} {:db/id #edb/ref 17592186079195} {:db/id #edb/ref 17592186256638} {:db/id #edb/ref 17592186320789} {:db/id #edb/ref 17592186320791} {:db/id #edb/ref 17592186332876} {:db/id #edb/ref 1759218640353