#{[{:db/id #edb/ref 17592186512951 :knowledge-point/_questions [{:db/id #edb/ref 17592186221402 :knowledge-point/id #uuid "42c41150-5104-58cc-927b-f55b94529cb2" :knowledge-point/title "Determining the Order of a Numerical Method By Comparing LTE for Different Step Sizes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36011859-1afd-5d56-97d3-4bd6c1c53226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186512219} {:answer/id #uuid "713dc69b-eedb-57c7-b566-963d0364f484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186512369} {:answer/id #uuid "7557f1ef-873e-57b4-b6d6-7690a0ee0f59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186512375} {:answer/id #uuid "a804836a-c5a1-5048-8cb1-94c9973a4fc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186512500} {:answer/id #uuid "e6ae3264-3b35-5e19-bcf1-18378d20d72c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186512652}] :answer-field/correct {:answer/id #uuid "36011859-1afd-5d56-97d3-4bd6c1c53226" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186512219} :answer-field/id #uuid "0f815379-499f-5491-abe7-bd5c1ed810d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512733}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ebc091be-da12-5892-8a06-6dc1bcb20797" :question/math-academy-id "q-334642" :question/problem "A numerical method is used to approximate the solution to an initial value problem.\n\n- With step size $Δx=0.10,$ the observed local truncation error is $τ(0.10)=0.24.$\n\n- With step size $Δx=0.05,$ the observed local truncation error is $τ(0.05)=0.02.$\n\nEstimate the order of the numerical method." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.10$ to $0.05.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.10}{0.05}=2.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}={2}^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.24$ to $0.02.$ So, it reduces by a factor of\n\n$$\n\\frac{0.24}{0.02}=12.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}{2}^{p+1} & ≈12 \\\\ p+1 & ≈{log}_{2}⁡(12) \\\\ p+1 & ≈3.585… \\\\ p & ≈2.585….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is $3.$"}] [{:db/id #edb/ref 17592186512881 :knowledge-point/_questions [{:db/id #edb/ref 17592186221403 :knowledge-point/id #uuid "11217aba-7942-5c3a-84cf-37f22aa209e3" :knowledge-point/title "Determining the Order of a Numerical Method Given the GTE or LTE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03959187-9418-5be5-ac79-7e4967d9b00d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186512109} {:answer/id #uuid "585966c4-0f5a-5998-b590-6b01a0ed43b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186512301} {:answer/id #uuid "82ff2bc6-4ad2-5485-9688-6c45d0274b48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186512405} {:answer/id #uuid "c274000b-29cf-5c45-9c94-1b409cdb85c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186512563} {:answer/id #uuid "c735b7b9-b2be-5342-be94-4a2ee43a5709" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186512579}] :answer-field/correct {:answer/id #uuid "c274000b-29cf-5c45-9c94-1b409cdb85c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186512563} :answer-field/id #uuid "01277570-5a55-57cd-b355-f92266d0d444" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512722}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "288ecca2-4a65-5e47-af70-06519e1d4ea1" :question/math-academy-id "q-334747" :question/problem "Which of the following global truncation error expressions represent a third-order numerical method?\n\nI. $e(Δx)=2(Δx)^{4}+5(Δx)^{6}$\n\nII. $e(Δx)=4(Δx)^{2}+3(Δx)^{3}$\n\nIII. $e(Δx)=6(Δx)^{3}+8(Δx)^{5}$" :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nWith that in mind, let's check each option in turn:\n\n- For $e(Δx)=2(Δx)^{4}+5(Δx)^{6},$ the dominant term as $Δx\\to 0$ is $2(Δx)^{4}.$\nSo, statement I corresponds to an order $4$ method.\n\n- For $e(Δx)=4(Δx)^{2}+3(Δx)^{3},$ the dominant term as $Δx\\to 0$ is $4(Δx)^{2}.$\nSo, statement II corresponds to an order $2$ method.\n\n- For $e(Δx)=6(Δx)^{3}+8(Δx)^{5},$ the dominant term as $Δx\\to 0$ is $6(Δx)^{3}.$\nSo, statement III corresponds to an order $3$ method.\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186512903 :knowledge-point/_questions [{:db/id #edb/ref 17592186221403 :knowledge-point/id #uuid "11217aba-7942-5c3a-84cf-37f22aa209e3" :knowledge-point/title "Determining the Order of a Numerical Method Given the GTE or LTE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "424a9e92-70d2-56e9-9aed-a2fa1212a8eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186512238} {:answer/id #uuid "5981bd8d-11b6-5c7a-91f1-9aca33191d67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186512308} {:answer/id #uuid "6d96eeb8-a870-5867-9c64-0e82e01c23ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186512358} {:answer/id #uuid "b5c4497b-4049-5d0b-93c0-4a718cf248a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186512531} {:answer/id #uuid "f6852f41-c0ac-53c8-b2e9-1ad22c6166af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186512697}] :answer-field/correct {:answer/id #uuid "5981bd8d-11b6-5c7a-91f1-9aca33191d67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186512308} :answer-field/id #uuid "27aac6e5-28a9-5d6f-bdc3-723dde44ae4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186512743}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "80296baf-83a9-58bd-9c2b-7e79ee3813aa" :question/math-academy-id "q-334749" :question/problem "Which of the following local truncation error expressions represent a third-order numerical method?\n\nI. $τ(Δx)=3(Δx)^{4}+2(Δx)^{6}$\n\nII. $τ(Δx)=0.5(Δx)^{4}+8(Δx)^{7}$\n\nIII. $τ(Δx)=7(Δx)^{5}+5(Δx)^{6}$" :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nWith that in mind, let's check each option in turn:\n\n- For $τ(Δx)=3(Δx)^{4}+2(Δx)^{6},$ the dominant term as $Δx\\to 0$ is $3(Δx)^{4}=3(Δx)^{3+1}.$ So, statement I corresponds to an order $3$ method.\n\n- For $τ(Δx)=0.5(Δx)^{4}+8(Δx)^{7},$ the dominant term as $Δx\\to 0$ is $0.5(Δx)^{4}=0.5(Δx)^{3+1}.$ So, statement II corresponds to an order $3$ method.\n\n- For $τ(Δx)=7(Δx)^{5}+5(Δx)^{6},$ the dominant term as $Δx\\to 0$ is $7(Δx)^{5}=7(Δx)^{4+1}.$ So, statement III corresponds to an order $4$ method.\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186308683 :knowledge-point/_questions [{:db/id #edb/ref 17592186221404 :knowledge-point/id #uuid "f4c7f962-87af-53af-8167-d24ade127366" :knowledge-point/title "Making Inferences Given the Order of a Numerical Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17647057-986e-5b9c-a8af-af759b573b59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.008" :db/id #edb/ref 17592186305366}] :answer-field/correct {:answer/id #uuid "17647057-986e-5b9c-a8af-af759b573b59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.008" :db/id #edb/ref 17592186305366} :answer-field/id #uuid "d4007ccd-444f-5475-a4c0-493bff543247" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308182}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e11ea327-0283-5223-89c9-1dcc1d605dba" :question/math-academy-id "q-334763" :question/problem "A numerical method for approximating a solution to an initial value problem is known to be order $3.$  Suppose that using step size $Δx=0.2$ produces a global truncation error (GTE) of $e(0.2)≈0.064.$  If we instead use a step size $Δx=0.1,$ what GTE should we expect?\n\n$e(0.1)≈$\n{{field-1}}" :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the GTE by a factor of approximately ${k}^{p}.$\n\nIn our case, the step size decreases from $0.2$ to $0.1.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.2}{0.1}=2.\n$$\n\nNow, since the numerical method is of order $3,$ the error is expected to decrease by a factor of\n\n$$\n{k}^{3}={2}^{3}=8.\n$$\n\nTherefore, using a step size of $Δx=0.1,$ the expected GTE is\n\n$$\ne(0.1)≈\\frac{0.064}{8}=0.008.\n$$"}] [{:db/id #edb/ref 17592186512904 :knowledge-point/_questions [{:db/id #edb/ref 17592186221404 :knowledge-point/id #uuid "f4c7f962-87af-53af-8167-d24ade127366" :knowledge-point/title "Making Inferences Given the Order of a Numerical Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27539fe2-4c37-500d-b2f1-bf9c12b924fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.008" :db/id #edb/ref 17592186512184}] :answer-field/correct {:answer/id #uuid "27539fe2-4c37-500d-b2f1-bf9c12b924fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.008" :db/id #edb/ref 17592186512184} :answer-field/id #uuid "290c0fd4-796b-5b98-9efb-32925a5e1121" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186512745}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "87976b3b-af1b-5fcb-8c01-533b581f6a90" :question/math-academy-id "q-334826" :question/problem "A numerical method for approximating a solution to an initial value problem is known to be order $4.$  Suppose that using step size $Δx=0.25$ produces a global truncation error (GTE) of $e(0.25)≈0.3125.$  If we instead use a step size $Δx=0.10,$ what GTE should we expect?\n\n$e(0.10)≈$\n{{field-1}}" :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the GTE by a factor of approximately ${k}^{p}.$\n\nIn our case, the step size decreases from $0.25$ to $0.10.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.25}{0.10}=2.5.\n$$\n\nNow, since the numerical method is of order $4,$ the error is expected to decrease by a factor of\n\n$$\n{k}^{4}=(2.5)^{4}=39.0625.\n$$\n\nTherefore, using a step size of $Δx=0.10,$ the expected GTE is\n\n$$\ne(0.10)≈\\frac{0.3125}{39.0625}=0.008.\n$$"}]}
