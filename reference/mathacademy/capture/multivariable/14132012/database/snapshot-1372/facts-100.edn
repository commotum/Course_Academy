17] [17592186432595 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186432595 #edb/ref 1083 #uuid "ffb3d5ad-4c33-5033-8c68-0522a4f523a1" #edb/ref 17592186045417] [17592186432596 #edb/ref 1075 #edb/ref 17592186432587 #edb/ref 17592186045417] [17592186432596 #edb/ref 1075 #edb/ref 17592186432589 #edb/ref 17592186045417] [17592186432596 #edb/ref 1075 #edb/ref 17592186432591 #edb/ref 17592186045417] [17592186432596 #edb/ref 1075 #edb/ref 17592186432592 #edb/ref 17592186045417] [17592186432596 #edb/ref 1075 #edb/ref 17592186432593 #edb/ref 17592186045417] [17592186432596 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186432596 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186432596 #edb/ref 1078 #edb/ref 17592186432591 #edb/ref 17592186045417] [17592186432596 #edb/ref 1079 #uuid "2881387b-754e-56f3-834a-ac7d858e2ecf" #edb/ref 17592186045417] [17592186432597 #edb/ref 1068 #edb/ref 17592186432596 #edb/ref 17592186045417] [17592186432597 #edb/ref 1069 "q-138516" #edb/ref 17592186045417] [17592186432597 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186432597 #edb/ref 1071 "$$\nU=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}],\\,Σ=[\\begin{aligned}2 & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ find the pseudoinverse ${A}^{+}.$" #edb/ref 17592186045417] [17592186432597 #edb/ref 1072 #uuid "3fcee73d-521b-5fd0-a9c6-c7b6d8e05cce" #edb/ref 17592186045417] [17592186432597 #edb/ref 1074 "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ then the pseudoinverse of $A$ is given by\n\n$$\nV\\,{Σ}^{+}\\,{U}^{T},\n$$\n\nwhere ${Σ}^{+}$ is the pseudoinverse of $Σ.$\n\nFirst, notice that\n\n$$\nV=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}],\\,{Σ}^{+}=\\frac{1}{2}[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}],\\,{U}^{T}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}].\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{A}^{+} & =V\\,{Σ}^{+}\\,{U}^{T} \\\\  & =\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}]\\cdot \\frac{1}{2}[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]\\cdot \\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]\\cdot [\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}-1 & 0 \\\\ 1 & 0\\end{aligned}]\\cdot [\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417]}
