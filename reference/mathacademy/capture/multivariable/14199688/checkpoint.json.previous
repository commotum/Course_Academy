" x=\"8108\" y=\"0\"></use>\n<g transform=\"translate(9219,0)\">\n <use xlink:href=\"#E3-MJMAIN-73\"></use>\n <use xlink:href=\"#E3-MJMAIN-65\" x=\"394\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-63\" x=\"839\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-68\" x=\"1283\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E3-MJMAIN-32\" x=\"2602\" y=\"598\"></use>\n</g>\n <use xlink:href=\"#E3-MJMATHI-78\" x=\"11680\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-64\" x=\"12419\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMATHI-78\" x=\"12975\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-3D\" x=\"13825\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-36\" x=\"14882\" y=\"0\"></use>\n<g transform=\"translate(15549,0)\">\n <use xlink:href=\"#E3-MJMAIN-74\"></use>\n <use xlink:href=\"#E3-MJMAIN-61\" x=\"389\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-6E\" x=\"890\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-68\" x=\"1446\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E3-MJMATHI-78\" x=\"17719\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-2B\" x=\"18513\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMATHI-43\" x=\"19514\" y=\"0\"></use>\n <use xlink:href=\"#E3-MJMAIN-2E\" x=\"20275\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</svg></span></p>\n\n            </div>           \n        </div>",
