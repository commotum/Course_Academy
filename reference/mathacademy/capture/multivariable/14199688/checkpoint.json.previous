<mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c64\"></mjx-c></mjx-mtext><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo></mjx-mstyle></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mo data-mjx-texclass=\"OP\">∫</mo><mo stretchy=\"false\">(</mo><mn>5</mn><msup><mi>csch</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo>−</mo><mi>sech</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"ORD\"><mi>x</mi></mrow><mi>tanh</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi><mo>=</mo></mstyle></math></mjx-assistive-mml></mjx-container></p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Wed, Oct 14th @ 3:57 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:20</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>"
