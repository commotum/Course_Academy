=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-3D\" x=\"5180\" y=\"0\"></use>\n<g transform=\"translate(6237,0)\">\n <use xlink:href=\"#E4-MJMAIN-73\"></use>\n <use xlink:href=\"#E4-MJMAIN-69\" x=\"394\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-6E\" x=\"673\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-68\" x=\"1229\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E4-MJMATHI-78\" x=\"8189\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-21D2\" x=\"11040\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJSZ2-222B\" x=\"14318\" y=\"0\"></use>\n<g transform=\"translate(15429,0)\">\n <use xlink:href=\"#E4-MJMAIN-73\"></use>\n <use xlink:href=\"#E4-MJMAIN-69\" x=\"394\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-6E\" x=\"673\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-68\" x=\"1229\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E4-MJMATHI-78\" x=\"17382\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-64\" x=\"18204\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMATHI-78\" x=\"18761\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-3D\" x=\"19611\" y=\"0\"></use>\n<g transform=\"translate(20667,0)\">\n <use xlink:href=\"#E4-MJMAIN-63\"></use>\n <use xlink:href=\"#E4-MJMAIN-6F\" x=\"444\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-73\" x=\"945\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-68\" x=\"1339\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E4-MJMATHI-78\" x=\"22730\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2B\" x=\"23525\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMATHI-43\" x=\"24525\" y=\"0\"></use>\n <use xlink:href=\"#E4-MJMAIN-2E\" x=\"25286\" y=\"0\"></use>\n</g>\n</svg></span></p>\n\n        </div>",
        "errors": [],
