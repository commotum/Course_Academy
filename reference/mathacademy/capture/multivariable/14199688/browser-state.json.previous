</mo><mi>C</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>2</mn><mi>coth</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo>+</mo><mi>cosh</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>t</mi><mo>+</mo><mi>C</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
