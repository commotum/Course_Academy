db/ref 17592186065185 :step/content {:db/id #edb/ref 17592186064295 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064138 :question/id #uuid "ed338404-097d-55ca-8d99-18e421934afd" :question/math-academy-id "e-8343"} :knowledge-point/id #uuid "e1992086-0858-551d-a6dc-042276c5d7f9" :knowledge-point/questions [{:db/id #edb/ref 17592186064969} {:db/id #edb/ref 17592186064972} {:db/id #edb/ref 17592186360660} {:db/id #edb/ref 17592186360661} {:db/id #edb/ref 17592186360662} {:db/id #edb/ref 17592186360663} {:db/id #edb/ref 17592186360664}] :knowledge-point/title "Integrating the Square of the Hyperbolic Secant"} :step/id #uuid "bcb0a218-1513-5d1d-85e5-7b570144cc6f" :step/math-academy-id 31162 :step/next {:db/id #edb/ref 17592186065186}} {:db/id #edb/ref 17592186065186 :step/content {:db/id #edb/ref 17592186064296 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064139 :question/id #uuid "cdb3db67-7734-5828-8b55-2faa5aee8541" :question/math-academy-id "e-8344"} :knowledge-point/id #uuid "273bab01-0930-5580-b073-8bafe7505887" :knowledge-point/questions [{:db/id #edb/ref 17592186064971} {:db/id #edb/ref 17592186064973} {:db/id #edb/ref 17592186360665} {:db/id #edb/ref 17592186360666} {:db/id #edb/ref 17592186360667} {:db/id #edb/ref 17592186360668} {:db/id #edb/ref 17592186360669} {:db/id #edb/ref 17592186360670}] :knowledge-point/title "Integrating the Square of the Hyperbolic Cosecant"} :step/id #uuid "f069fdaf-bc51-5862-b950-cab4852e7f1c" :step/math-academy-id 31163} {:db/id #edb/ref 17592186065187 :step/content {:db/id #edb/ref 17592186065390 :tutorial/content "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nWe know that the derivative of the hyperbolic sine is the hyperbolic cosine:\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(\\sinh{x}) = \\cosh{x}\n$$\n\nSince integration is the reverse of differentiation, we have\n\n$$\n\\int \\cosh{x}\\,\\textrm d x = \\sinh{x} + C.\n$$\n\nSimilarly, by considering the derivative of the hyperbolic cosine, we have\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(\\cosh x) = \\sinh{x} \\qquad\\Rightarrow\\qquad \\int \\sinh x\\  \\textrm{d}x = \\cosh x + C.\n$$" :tutorial/id #uuid "d780519f-20fa-5840-be56-4a5f0539ed6e" :tutorial/math-academy-id 5211 :tutorial/title "Introduction"} :step/id #uuid "1f4742a6-369c-57f0-9437-c9e83653cf97" :step/math-academy-id 32696 :step/next {:db/id #edb/ref 17592186065183}} {:db/id #edb/ref 17592186065188 :step/content {:db/id #edb/ref 17592186065392 :tutorial/content "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nBy considering the derivatives of the hyperbolic tangent, secant, cosecant, and cotangent, we arrive at the following results:\n\n$$\n\\begin{aligned}\\int {\\text{\\sech}}^{2}x\\text{ }\\text{d}x & =\\operatorname{tanh}x+C \\\\ \\int \\text{\\sech}x\\operatorname{tanh}x\\text{ }\\text{d}x & =-\\text{\\sech}x+C \\\\ \\int \\text{\\csch}x\\operatorname{coth}x\\text{ }\\text{d}x & =-\\text{\\csch}x+C \\\\ \\int {\\text{\\csch}}^{2}x\\text{ }\\text{d}x & =-\\operatorname{coth}x+C\\end{aligned}\n$$" :tutorial/id #uuid "9e3a8b50-3176-54c9-a9a3-e21f958ab6b2" :tutorial/math-academy-id 5371 :tutorial/title "Integration Using Reciprocal Hyperbolic Functions"} :step/id #uuid "3f62612b-f4cd-5d40-b847-4a223de13998" :step/math-academy-id 33535 :step/next {:db/id #edb/ref 17592186065184}}] :activity/title "Integrating Hyperbolic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064404}]}
