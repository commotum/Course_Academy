 [17592186360655 #edb/ref 1069 "q-96000" #edb/ref 17592186045417] [17592186360655 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360655 #edb/ref 1071 "$\\int 7\\operatorname{tanh}⁡t\\operatorname{sech}⁡t\\,\\text{d}t=$" #edb/ref 17592186045417] [17592186360655 #edb/ref 1072 #uuid "a7e00ad3-4e53-5cf6-950d-0df61bdd6838" #edb/ref 17592186045417] [17592186360655 #edb/ref 1074 "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sech}⁡t)=-\\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,⇒\\,\\int \\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,\\text{d}t=-\\operatorname{sech}⁡t+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 7\\operatorname{tanh}⁡t\\operatorname{sech}⁡t\\,\\text{d}t & =7\\int \\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,\\text{d}t \\\\  & =7(-\\operatorname{sech}⁡t)+C \\\\  & =-7\\operatorname{sech}⁡t+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360656 #edb/ref 1068 #edb/ref 17592186360369 #edb/ref 17592186045417] [17592186360656 #edb/ref 1069 "q-96002" #edb/ref 17592186045417] [17592186360656 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186360656 #edb/ref 1071 "$\\int (2\\operatorname{sinh}⁡x-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x)\\text{d}x=$" #edb/ref 17592186045417] [17592186360656 #edb/ref 1072 #uuid "72d8182e-5e03-52fa-97a8-74736548a0c8" #edb/ref 17592186045417] [17592186360656 #edb/ref 1074 "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x)=\\operatorname{sinh}⁡x\\, & ⇒\\,\\int \\operatorname{sinh}⁡x\\,\\text{d}x=\\operatorname{cosh}⁡x+C, \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)=-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\, & ⇒\\,\\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x=-\\operatorname{sech}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2\\operatorname{sinh}⁡x-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x)\\text{d}x & =\\int 2\\operatorname{sinh}⁡x\\,\\text{d}x+\\int (-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x)\\,\\text{d}x \\\\  & =2\\int \\operatorname{sinh}⁡x\\,\\text{d}x-\\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x \\\\  & =2\\operatorname{cosh}⁡x-(-\\operatorname{sech}⁡x)+C \\\\  & =2\\operatorname{cosh}⁡x+\\operatorname{sech}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360658 #edb/ref 1068 #edb/ref 17592186360081 #edb/ref 17592186045417] [17592186360658 #edb/ref 1069 "q-96004" #edb/ref 17592186045417] [17592186360658 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186360658 #edb/ref 1071 "$\\int (2\\operatorname{csch}⁡y\\operatorname{coth}⁡y-9\\operatorname{sech}⁡y\\operatorname{tanh}⁡y)\\text{d}y=$" #edb/ref 17592186045417] [17592186360658 #edb/ref 1072 #uuid "d589c3bf-9aa8-5c68-9f78-e4e864208d85" #edb/ref 17592186045417] [17592186360658 #edb/ref 1074 "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}y}(\\operatorname{sech}⁡y)=-\\operatorname{sech}⁡y\\operatorname{tanh}⁡y\\,⇒\\,\\int \\operatorname{sech}⁡y\\operatorname{tanh}⁡y\\,\\text{d}y=-\\operatorname{sech}⁡y+C,\n$$\n\n$$\n\\frac{\\text{d}}{\\text{d}y}(\\operatorname{csch}⁡y)=-\\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,⇒\\,\\int \\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y=-\\operatorname{csch}⁡y+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2\\operatorname{csch}⁡y\\operatorname{coth}⁡y-9\\operatorname{sech}⁡y\\operatorname{tanh}⁡y)\\text{d}y & =\\int 2\\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y+\\int (-9\\operatorname{sech}⁡y\\operatorname{tanh}⁡y)\\,\\text{d}y \\\\  & =2\\int \\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y-9\\int \\operatorname{sech}⁡y\\operatorname{tanh}⁡y\\,\\text{d}y \\\\  & =2(-\\operatorname{csch}⁡y)-9(-\\operatorname{sech}⁡y)+C \\\\  & =9\\operatorname{sech}⁡y-2\\operatorname{csch}⁡y+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360661 #edb/ref 1068 #edb/ref 17592186360197 #edb/ref 17592186045417] [17592186360661 #edb/ref 1069 "q-96017" #edb/ref 17592186045417] [17592186360661 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360661 #edb/ref 1071 "$$\n\n$\\int {e}^{2}{sech}^{2}⁡x\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186360661 #edb/ref 1072 #uuid "6909e4f6-4189-5042-b77b-1df3f8ab59ae" #edb/ref 17592186045417] [17592186360661 #edb/ref 1074 "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)={sech}^{2}⁡x\\,⇒\\,\\int {sech}^{2}⁡x\\,\\text{d}x=\\operatorname{tanh}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int {e}^{2}{sech}^{2}⁡x\\,\\text{d}x & ={e}^{2}\\int {sech}^{2}⁡x\\,\\text{d}x \\\\  & ={e}^{2}\\operatorname{tanh}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360662 #edb/ref 1068 #edb/ref 17592186360372 #edb/ref 17592186045417] [17592186360662 #edb/ref 1069 "q-96020" #edb/ref 17592186045417] [17592186360662 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186360662 #edb/ref 1071 "$\\int \\operatorname{sech}⁡y(5\\operatorname{tanh}⁡y-\\operatorname{sech}⁡y)\\text{d}y=$" #edb/ref 17592186045417] [17592186360662 #edb/ref 1072 #uuid "ea484553-957b-5771-abac-a89322b8ab06" #edb/ref 17592186045417] [17592186360662 #edb/ref 1074 "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}y}(\\operatorname{sech}⁡y)=-\\operatorname{sech}⁡y\\operatorname{tanh}⁡y & \\,⇒\\,\\int \\operatorname{sech}⁡y\\operatorname{tanh}⁡y\\,\\text{d}y=-\\operatorname{sech}⁡y+C, \\\\ \\frac{\\text{d}}{\\text{d}y}(\\operatorname{tanh}⁡y)={sech}^{2}⁡y & \\,⇒\\,\\int {sech}^{2}⁡y\\,\\text{d}y=\\operatorname{tanh}⁡y+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\operatorname{sech}⁡y(5\\operatorname{tanh}⁡y-\\operatorname{sech}⁡y)\\text{d}y & =\\int (5\\operatorname{sech}⁡y\\operatorname{tanh}⁡y-{sech}^{2}⁡y)\\,\\text{d}y \\\\  & =5\\int \\operatorname{sech}⁡y\\operatorname{tanh}⁡y\\,\\text{d}y-\\int {sech}^{2}⁡y\\,\\text{d}y \\\\  & =-5\\operatorname{sech}⁡y-\\operatorname{tanh}⁡y+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360664 #edb/ref 1068 #edb/ref 17592186360230 #edb/ref 17592186045417] [17592186360664 #edb/ref 1069 "q-96023" #edb/ref 17592186045417] [17592186360664 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186360664 #edb/ref 1071 "$\\int ({sech}^{2}⁡x-2\\operatorname{sinh}⁡x)\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186360664 #edb/ref 1072 #uuid "7cdc0fff-49e9-589d-91ec-37569e987244" #edb/ref 17592186045417] [17592186360664 #edb/ref 1074 "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x)=\\operatorname{sinh}⁡x & \\,⇒\\,\\int \\operatorname{sinh}⁡x\\,\\text{d}x=\\operatorname{cosh}⁡x+C, \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)={sech}^{2}⁡x & \\,⇒\\,\\int {sech}^{2}⁡x\\,\\text{d}x=\\operatorname{tanh}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int ({sech}^{2}⁡x-2\\operatorname{sinh}⁡x)\\,\\text{d}x & =\\int {sech}^{2}⁡x\\,\\text{d}x+\\int (-2\\operatorname{sinh}⁡x)\\,\\text{d}x \\\\  & =\\int {sech}^{2}⁡x\\,\\text{d}x-2\\int \\operatorname{sinh}⁡x\\,\\text{d}x \\\\  & =\\operatorname{tanh}⁡x-2\\operatorname{cosh}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360665 #edb/ref 1068 #edb/ref 17592186360149 #edb/ref 17592186045417] [17592186360665 #edb/ref 1069 "q-96050" #edb/ref 17592186045417] [17592186360665 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360665 #edb/ref 1071 "$\\int (3{csch}^{2}⁡t+10)\\,\\text{d}t=$" #edb/ref 17592186045417] [17592186360665 #edb/ref 1072 #uuid "b67139fb-2953-569c-b989-1ce7d60c75f1" #edb/ref 17592186045417] [17592186360665 #edb/ref 1074 "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}(\\operatorname{coth}⁡t)=-{csch}^{2}⁡t\\,⇒\\,\\int {csch}^{2}⁡t\\,\\text{d}t=-\\operatorname{coth}⁡t+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (3{csch}^{2}⁡t+10)\\,\\text{d}t & =\\int 3{csch}^{2}⁡t\\,\\text{d}t+\\int 10\\,\\text{d}t\\,\\text{d}t \\\\  & =3\\int {csch}^{2}⁡t\\,\\text{d}t+10\\int \\text{d}t \\\\  & =-3\\operatorname{coth}⁡t+10t+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360669 #edb/ref 1068 #edb/ref 17592186360005 #edb/ref 17592186045417] [17592186360669 #edb/ref 1069 "q-96055" #edb/ref 17592186045417] [17592186360669 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186360669 #edb/ref 1071 "$\\int (2{csch}^{2}⁡t+\\operatorname{sinh}⁡t)\\,\\text{d}t=$" #edb/ref 17592186045417] [17592186360669 #edb/ref 1072 #uuid "50f4306d-0560-5c49-bc54-cddc46f3f3c5" #edb/ref 17592186045417] [17592186360669 #edb/ref 1074 "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cosh}⁡t)=\\operatorname{sinh}⁡t & \\,⇒\\,\\int \\operatorname{sinh}⁡t\\,\\text{d}t=\\operatorname{cosh}⁡t+C, \\\\ \\frac{\\text{d}}{\\text{d}t}(\\operatorname{coth}⁡t)=-{csch}^{2}⁡t & \\,⇒\\,\\int {csch}^{2}⁡t\\,\\text{d}t=-\\operatorname{coth}⁡t+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2{csch}^{2}⁡t+\\operatorname{sinh}⁡t)\\,\\text{d}t & =2\\int {csch}^{2}⁡t\\,\\text{d}t+\\int \\operatorname{sinh}⁡t\\,\\text{d}t \\\\  & =2(-\\operatorname{coth}⁡t)+\\operatorname{cosh}⁡t+C \\\\  & =-2\\operatorname{coth}⁡t+\\operatorname{cosh}⁡t+C.\\end{aligned}\n$$" #edb/ref 17592186045417]}
