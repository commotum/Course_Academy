#{[{:db/id #edb/ref 17592186064136 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064293 :knowledge-point/id #uuid "f07c0f22-39fe-5576-8aab-e2dfdb3227b8" :knowledge-point/title "Integrating the Hyperbolic Sine and the Hyperbolic Cosine"}] :question/id #uuid "82a52178-7e95-554c-aedb-34e2f0336fa5" :question/math-academy-id "e-8341" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nCalculate $\\displaystyle \\int 8\\cosh t \\,\\textrm{d}t.$" :question/worked-solution "Recall that\n\n$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n\\dfrac{\\textrm d}{\\textrm d t}(\\sinh t) = \\cosh{t} \\quad\\Rightarrow\\quad  \\int \\cosh{t} \\, \\textrm dt = \\sinh{t} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 8\\operatorname{cosh}⁡t\\,\\text{d}t=8\\int \\operatorname{cosh}⁡t\\,\\text{d}t=8\\operatorname{sinh}⁡t+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064137 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064294 :knowledge-point/id #uuid "4daf1299-2291-5bf0-8267-68efcfe4e27d" :knowledge-point/title "Integrating Hyperbolic Secant-Tangent and Cosecant-Cotangent"}] :question/id #uuid "94c41155-d10a-55e6-8483-34750849a283" :question/math-academy-id "e-8342" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\displaystyle \\int \\left(-3\\sech x \\tanh x\\right) \\,\\textrm{d}x =$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nRecall that\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\sech x) = -\\sech{x}\\tanh x \n\\quad\\Rightarrow\\quad  \n\\int \\sech{x}\\tanh{x} \\, \\textrm dx = -\\sech{x} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-3\\text{\\sech}x\\operatorname{tanh}⁡x)\\,\\text{d}x & =-3\\int \\text{\\sech}x\\operatorname{tanh}⁡x\\,\\text{d}x \\\\  & =-3(-\\text{\\sech}x)+C \\\\  & =3\\text{\\sech}x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064138 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064295 :knowledge-point/id #uuid "e1992086-0858-551d-a6dc-042276c5d7f9" :knowledge-point/title "Integrating the Square of the Hyperbolic Secant"}] :question/id #uuid "ed338404-097d-55ca-8d99-18e421934afd" :question/math-academy-id "e-8343" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\displaystyle \\int 6\\sech^2 x \\,\\textrm{d}x =$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nRecall that\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\tanh x) = \\sech^2{x} \\quad\\Rightarrow\\quad  \\int \\sech^2{x} \\, \\textrm dx = \\tanh{x} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 6{\\text{\\sech}}^{2}x\\,\\text{d}x=6\\int {\\text{\\sech}}^{2}x\\,\\text{d}x=6\\operatorname{tanh}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064139 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064296 :knowledge-point/id #uuid "273bab01-0930-5580-b073-8bafe7505887" :knowledge-point/title "Integrating the Square of the Hyperbolic Cosecant"}] :question/id #uuid "cdb3db67-7734-5828-8b55-2faa5aee8541" :question/math-academy-id "e-8344" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\displaystyle \\int (-8\\csch^2 x )\\,\\textrm{d}x =$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nRecall that\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\coth x) = -\\csch^2{x} \\quad\\Rightarrow\\quad  \\int \\csch^2{x} \\, \\textrm dx = -\\coth{x} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-8{\\text{\\csch}}^{2}x)\\,\\text{d}x & =-8\\int {\\text{\\csch}}^{2}x\\,\\text{d}x \\\\  & =-(-8\\operatorname{coth}⁡x)+C \\\\  & =8\\operatorname{coth}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064966 :knowledge-point/_questions [{:db/id #edb/ref 17592186064293 :knowledge-point/id #uuid "f07c0f22-39fe-5576-8aab-e2dfdb3227b8" :knowledge-point/title "Integrating the Hyperbolic Sine and the Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82601945-c756-5239-95b7-b3f4c606898d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\cosh x + C" :db/id #edb/ref 17592186063852} {:answer/id #uuid "a94a7480-12a0-5c0a-a466-325995f53a7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cosh x + C" :db/id #edb/ref 1759218606385