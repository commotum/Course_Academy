h}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x \\\\  & =5(-\\operatorname{coth}⁡x)-(-\\operatorname{sech}⁡x)+C \\\\  & =-5\\operatorname{coth}⁡x+\\operatorname{sech}⁡x+C.\\end{aligned}\n$$"}]}
