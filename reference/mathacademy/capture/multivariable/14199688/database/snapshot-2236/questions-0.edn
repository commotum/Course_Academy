:db/id #edb/ref 17592186359737} :answer-field/id #uuid "02f8a4d4-148f-5887-828f-772623b95315" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50f4306d-0560-5c49-bc54-cddc46f3f3c5" :question/math-academy-id "q-96055" :question/problem "$\\int (2{csch}^{2}⁡t+\\operatorname{sinh}⁡t)\\,\\text{d}t=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cosh}⁡t)=\\operatorname{sinh}⁡t & \\,⇒\\,\\int \\operatorname{sinh}⁡t\\,\\text{d}t=\\operatorname{cosh}⁡t+C, \\\\ \\frac{\\text{d}}{\\text{d}t}(\\operatorname{coth}⁡t)=-{csch}^{2}⁡t & \\,⇒\\,\\int {csch}^{2}⁡t\\,\\text{d}t=-\\operatorname{coth}⁡t+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2{csch}^{2}⁡t+\\operatorname{sinh}⁡t)\\,\\text{d}t & =2\\int {csch}^{2}⁡t\\,\\text{d}t+\\int \\operatorname{sinh}⁡t\\,\\text{d}t \\\\  & =2(-\\operatorname{coth}⁡t)+\\operatorname{cosh}⁡t+C \\\\  & =-2\\operatorname{coth}⁡t+\\operatorname{cosh}⁡t+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064973 :knowledge-point/_questions [{:db/id #edb/ref 17592186064296 :knowledge-point/id #uuid "273bab01-0930-5580-b073-8bafe7505887" :knowledge-point/title "Integrating the Square of the Hyperbolic Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ef4b406-1c2c-5f52-a1f0-b52478a2d78a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\operatorname{coth}⁡x+\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186358170} {:answer/id #uuid "4df6a0d4-af15-5aeb-90ce-f321161abc45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\operatorname{coth}⁡x-\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186358424} {:answer/id #uuid "d8b82f02-66bd-50a8-be33-d79