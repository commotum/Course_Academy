 {:answer/id #uuid "71419f58-deb9-5e21-bf59-8954a8f6a89a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\operatorname{sech}⁡t+C" :db/id #edb/ref 17592186358740} :answer-field/id #uuid "7cec91c3-2957-56e8-9b55-c7a60213824e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360201}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a7e00ad3-4e53-5cf6-950d-0df61bdd6838" :question/math-academy-id "q-96000" :question/problem "$\\int 7\\operatorname{tanh}⁡t\\operatorname{sech}⁡t\\,\\text{d}t=$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sech}⁡t)=-\\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,⇒\\,\\int \\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,\\text{d}t=-\\operatorname{sech}⁡t+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 7\\operatorname{tanh}⁡t\\operatorname{sech}⁡t\\,\\text{d}t & =7\\int \\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,\\text{d}t \\\\  & =7(-\\operatorname{sech}⁡t)+C \\\\  & =-7\\operatorname{sech}⁡t+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360656 :knowledge-point/_questions [{:db/id #edb/ref 17592186064294 :knowledge-point/id #uuid "4daf1299-2291-5bf0-8267-68efcfe4e27d" :knowledge-point/title "Integrating Hyperbolic Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "159c1649-b89f-5380-b033-21083526e873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cosh}⁡x-\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186357942} {:answer/id #uuid "17d21c85-7e7e-5cea-8fc2-97a3cf928c13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cosh}⁡x+\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186357959} {:answer/id #uuid "6b2bf3ac-f29a-54e