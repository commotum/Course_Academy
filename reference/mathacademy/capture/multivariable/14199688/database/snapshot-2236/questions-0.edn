orname{sinh}⁡x\\,\\text{d}x+\\int (-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x)\\,\\text{d}x \\\\  & =2\\int \\operatorname{sinh}⁡x\\,\\text{d}x-\\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x \\\\  & =2\\operatorname{cosh}⁡x-(-\\operatorname{sech}⁡x)+C \\\\  & =2\\operatorname{cosh}⁡x+\\operatorname{sech}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360658 :knowledge-point/_questions [{:db/id #edb/ref 17592186064294 :knowledge-point/id #uuid "4daf1299-2291-5bf0-8267-68efcfe4e27d" :knowledge-point/title "Integrating Hyperbolic Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ab750bc-0b2c-5887-8063-1eb725833741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{csch}⁡y-9\\operatorname{sech}⁡y+C" :db/id #edb/ref 17592186358539} {:answer/id #uuid "688b36a1-a898-5183-8b81-e11de4f9b0f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{csch}⁡y-2\\operatorname{sech}⁡y+C" :db/id #edb/ref 17592186358668} {:answer/id #uuid "97c2cc98-4278-55d7-84e1-70c70f03ac87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{sech}⁡y-2\\operatorname{csch}⁡y+C" :db/id #edb/ref 17592186359082} {:answer/id #uuid "aa8a252c-a92a-5f1c-9ef9-fe34ba03f7af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sech}⁡y-9\\operatorname{csch}⁡y+C" :db/id #edb/ref 17592186359219} {:answer/id #uuid "e0d300c5-c6be-5a6c-aedf-95c363e1e89c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{csch}⁡y-9\\operatorname{sech}⁡y+C" :db/id #edb/ref 17592186359727}] :answer-field/correct {:answer/id #uuid "97c2cc98-4278-55d7-84e1-70c70f03ac87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{sech}⁡y-2\\operatorna