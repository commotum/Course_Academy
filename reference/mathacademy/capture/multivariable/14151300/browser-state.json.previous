tlevel=\"0\"><mfrac><mi>π</mi><mn>3</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>3</mn><msqrt><mn>3</mn></msqrt></mrow><mn>2</mn></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p><strong>Note:</strong> It's easy to show that the obtained point is indeed the maximum (and not the minimum). To do that, we could compare the value of the function at this point with the value of the function at any other (arbitrary) point belonging to the domain. For example, \n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"482\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 20.404em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.4em;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D453 TEX-I\"></mjx-c></mjx-mi><mjx-mrow space=\"2\"><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c28 TEX-S2\"></mjx-c></mjx-mo><mjx-mstyle><mjx-mfrac><mjx-frac type=\"d\"><mjx-num><mjx-nstrut type=\"d\"></mjx-nstrut><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70B TEX-I\"></mjx-c></mjx-mi></mjx-num><mjx-dbox><mjx-dtable><mjx-line type=\"d\"></mjx-line><mjx-row><mjx-den><mjx-dstrut type=\"d\"></mjx-dstrut><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-