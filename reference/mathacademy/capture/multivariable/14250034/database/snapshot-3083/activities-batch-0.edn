5498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 9 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117390}] :answer-field/id #uuid "e8b8fe9e-844d-56b5-bf1c-f6dfd12aac18" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186117385}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dc32164c-8031-5582-afee-c921d1e93ba9" :question/math-academy-id "q-32721" :question/problem "Suppose that a $3 \\cdot 3$ matrix $H$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n$R_{2}:=R_{2} + 9R_{1}, R_{3}:=R_{3} - 2R_{1}$.\nGiven that $H$ has the LU factorization $H = LU$, then $L =$"} :step/id #uuid "083d0182-6210-5520-86dd-1a05fdb0f8a2" :step/next {:db/id #edb/ref 17592186570816}} {:db/id #edb/ref 17592186570797 :step/content {:db/id #edb/ref 17592186243968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0103ed51-38eb-56e1-b5b6-506ac5114dcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186241194} {:answer/id #uuid "28f58628-e349-51a5-9381-2a6c3f3e63d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186241538} {:answer/id #uuid "362edb3b-c2c6-5e35-b27f-a4726544a314" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186241655} {:answer/id #uuid "88c00484-3dac-50cd-9b40-2f30d2fe5429" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186242384} {:answer/id #uuid "d8290906-4330-5010-8b90-d9121d42fcb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186243101}] :answer-field/correct {:db/id #edb/ref 17592186243101} :answer-field/id #uuid "97841af7-3445-571b-82d4-01c790eeec83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186243720}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "715f2529-cb8e-5152-b727-a6588c23a27e" :question/math-academy-id "q-106856" :question/problem "Given that \n$A=\\begin{bmatrix}1 & -2 & 2 \\\\ 4 & -5 & 9 \\\\ -3 & 0 & -5\\end{bmatrix}$ has the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & -2 & 2 \\\\ 4 & -5 & 9 \\\\ -3 & 0 & -5\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ -3 & 0 & -5\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & -6 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} & ⟺ & \\,\\overset{{E}_{3}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{bmatrix}}}\\cdot {E}_{2}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{3}{E}_{2}{E}_{1}A=U,$ we can invert ${E}_{3},$ ${E}_{2},$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{3}{E}_{2}{E}_{1}A & =U \\\\ {E}_{2}{E}_{1}A & ={E}_{3}^{-1}U \\\\ {E}_{1}A & ={E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}{E}_{3}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -2 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ -3 & -2 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 3 & 1 \\\\ 0 & 0 & 3\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=-2,$ ${u}_{33}=3,$ and ${l}_{32}\\cdot {u}_{33}=-6.$"} :step/id #uuid "0bda8fd9-13f2-5c84-b50a-70fa5ee8f0e8"} {:db/id #edb/ref 17592186570816 :step/content {:db/id #edb/ref 17592186302329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08da2c73-b3f3-5f9e-bdca-1b5b280e8ca5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186299976} {:answer/id #uuid "19ab99ee-abb1-5365-b563-f8e7f4d626a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300075} {:answer/id #uuid "19c8433d-ce31-55b1-ace0-59e14900aabb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300076} {:answer/id #uuid "7190b1cb-7787-5bdb-9600-71dbc81662e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300527} {:answer/id #uuid "c9f2b7f6-5083-5e02-a198-e7a6dbb7f6c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300969}] :answer-field/correct {:db/id #edb/ref 17592186300075} :answer-field/id #uuid "1a4a2fa1-bb43-517d-8181-7f72736b0a79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186301310}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b1cd1efa-f609-59d5-a15c-c2a561c4fae4" :question/math-academy-id "q-32722" :question/problem "Given that\n$K=\\begin{bmatrix}4 & 4 & 0 \\\\ 7 & 0 & -1 \\\\ 0 & 7 & 3\\end{bmatrix}$\nhas the LU decomposition $K=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $K$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $K$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}K & =\\begin{bmatrix}4 & 4 & 0 \\\\ 7 & 0 & -1 \\\\ 0 & 7 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-\\frac{7}{4}){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot K \\\\  & ∼\\begin{bmatrix}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 7 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot K \\\\  & ∼\\begin{bmatrix}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}K=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}K & =U \\\\ {E}_{1}K & ={E}_{2}^{-1}U \\\\ K & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ K & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}}^{-1}U \\\\ K & =(\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix})U \\\\ K & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 0 & 2\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$"} :step/id #uuid "45b77baa-f090-5774-adc4-9d0d0efce649" :step/next {:db/id #edb/ref 17592186570850}} {:db/id #edb/ref 17592186570850 :step/content {:db/id #edb/ref 17592186504625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27e167e3-3c1a-5a94-aedd-937cca7aa527" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{3} & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186504100} {:answer/id #uuid "4776454d-1433-55b0-a3f1-6744fa92a4be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -\\frac{1}{3} & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186504161} {:answer/id #uuid "869d1c4e-d590-57e1-8c7b-108e1a80a41c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{3} & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186504267} {:answer/id #uuid "a85269ed-a160-5cdf-ba28-b8d04e6cc4a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & -\\frac{1}{3} & 1\\end{aligned}]" :db/id #edb/ref 17592186504325} {:answer/id #uuid "e5adc569-5d12-5e17-a6da-903c09507f69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ \\frac{1}{3} & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186504428}] :answer-field/correct {:db/id #edb/ref 17592186504100} :answer-field/id #uuid "dc30e01e-9aef-5e28-9a4c-abb1934ac9fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186504585}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "445c4dee-b549-5e10-93bb-06205e66703c" :question/math-academy-id "q-106854" :question/problem "Given that \n$A=[\\begin{aligned}-3 & 6 & 0 \\\\ 1 & -3 & 2 \\\\ 3 & -6 & 3\\end{aligned}]$ has the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-3 & 6 & 0 \\\\ 1 & -3 & 2 \\\\ 3 & -6 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+(\\frac{1}{3}){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{3} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-3 & 6 & 0 \\\\ 0 & -1 & 2 \\\\ 3 & -6 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}-3 & 6 & 0 \\\\ 0 & -1 & 2 \\\\ 0 & 0 & 3\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{3} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{3} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{3} & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-3 & 6 & 0 \\\\ 0 & -1 & 2 \\\\ 0 & 0 & 3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$"} :step/id #uuid "ae574887-66dc-55be-86f5-550b61aba1dd" :step/next {:db/id #edb/ref 17592186570797}} {:db/id #edb/ref 17592186570863 :step/content {:db/id #edb/ref 17592186485526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b5da53a-52b7-5054-b17e-10efb6d5d1e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186484941} {:answer/id #uuid "6feaaa27-6016-50e2-ab67-806898239c33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186485057} {:answer/id #uuid "991fd0bd-bc76-5b7e-872e-9c22a18a7550" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186485147} {:answer/id #uuid "c59dd4d5-dd58-59a9-80c3-46d088dbc409" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186485242} {:answer/id #uuid "f927a745-51e1-571d-b0fb-d5b522daaeab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186485350}] :answer-field/correct {:db/id #edb/ref 17592186485057} :answer-field/id #uuid "5fc75bcb-654b-5ec8-b6e8-acbbd32d2b3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186485404}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "485b91ef-f664-5968-befd-b6e37e67e294" :question/math-academy-id "q-32628" :question/problem "Suppose that a $3\\times 3$ matrix $C$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}-2{R}_{1},\\,{R}_{3}:={R}_{3}-3{R}_{1}\n$$\n\nGiven that $C$ has the LU factorization $C=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+(-3)\\cdot {R}_{1}$ is equivalent to multiplying $C$ from the left by the following elementary matrices:\n\n$$\n{{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}}_{⏟}}_{{E}_{2}}\\cdot {{\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}_{⏟}}_{{E}_{1}}\\cdot C=U.\n$$\n\nNow, since ${E}_{2}{E}_{1}C=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}C & =U \\\\ {E}_{1}C & ={E}_{2}^{-1}U \\\\ C & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ C & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ C & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix})U \\\\ C & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot U.\\end{aligned}\n$$"} :step/id #uuid "db817617-49ee-56e3-ae65-d4a3e9478415" :step/next {:db/id #edb/ref 17592186570794}}] :activity/title "LU Factorization of 3x3 Matrices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570108}]}
