3 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot U.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120204 :knowledge-point/_questions [{:db/id #edb/ref 17592186119795 :knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8de611d7-7313-5fdd-89dd-41dc72d2340e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 9 & 1 & 0 \\\\ -2 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117386} {:answer/id #uuid "fd0596a2-9f9e-5955-835f-e995d8b20534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & -9 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117387} {:answer/id #uuid "0b7adc4b-cb74-5784-bdde-0ef21765e563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -9 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117388} {:answer/id #uuid "5570b71d-293a-54ed-a33c-c63644634573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 9 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117389} {:answer/id #uuid "7a2a88cc-2bf2-5155-a3a2-7f97c7c59a14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 9 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117390}] :answer-field/id #uuid "e8b8fe9e-844d-56b5-bf1c-f6dfd12aac18" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117385}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc32164c-8031-5582-afee-c921d1e93ba9" :question/math-acad