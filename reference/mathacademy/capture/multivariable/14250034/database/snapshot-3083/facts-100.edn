\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{3} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{3} & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-3 & 6 & 0 \\\\ 0 & -1 & 2 \\\\ 0 & 0 & 3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186504724 #edb/ref 1062 #uuid "530508d1-6940-5254-bd77-c4cc627eefbd" #edb/ref 17592186045417] [17592186504724 #edb/ref 1063 #edb/ref 17592186504625 #edb/ref 17592186045417] [17592186504728 #edb/ref 1058 #edb/ref 17592186504739 #edb/ref 17592186045417] [17592186504728 #edb/ref 1062 #uuid "79d727ae-2ed7-5a1a-bf76-f90f26abe612" #edb/ref 17592186045417] [17592186504728 #edb/ref 1063 #edb/ref 17592186120183 #edb/ref 17592186045417] [17592186504733 #edb/ref 1058 #edb/ref 17592186504737 #edb/ref 17592186045417] [17592186504733 #edb/ref 1062 #uuid "a85a1ef4-0643-5a34-aa1c-63793030b26e" #edb/ref 17592186045417] [17592186504733 #edb/ref 1063 #edb/ref 17592186403815 #edb/ref 17592186045417] [17592186504737 #edb/ref 1058 #edb/ref 17592186504724 #edb/ref 17592186045417] [17592186504737 #edb/ref 1062 #uuid "d61be35e-6d1f-53f2-b082-5c2589abd825" #edb/ref 17592186045417] [17592186504737 #edb/ref 1063 #edb/ref 17592186504696 #edb/ref 17592186045417] [17592186504739 #edb/ref 1058 #edb/ref 17592186504733 #edb/ref 17592186045417] [17592186504739 #edb/ref 1062 #uuid "dec2dbf2-e550-5e9f-9032-4f396f415ee3" #edb/ref 17592186045417] [17592186504739 #edb/ref 1063 #edb/ref 17592186504690 #edb/ref 17592186045417] [17592186570108 #edb/ref 1043 #edb/ref 17592186570794 #edb/ref 17592186045417] [17592186570108 #edb/ref 1043 #edb/ref 17592186570797 #edb/ref 17592186045417] [17592186570108 #edb/ref 1043 #edb/ref 17592186570816 #edb/ref 17592186045417] [17592186570108 #edb/ref 1043 #edb/ref 17592186570850 #edb/ref 1759218