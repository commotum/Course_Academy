      "assets": [
        {
          "index": 0,
          "path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14158590/assets/759ebc78c794f433bba8c1f555bc68b2da52de62741711f13bd9c9156e3c485e.png",
          "sha256": "759ebc78c794f433bba8c1f555bc68b2da52de62741711f13bd9c9156e3c485e",
          "source_url": "https://mathacademy.com/graphics/q-161861",
