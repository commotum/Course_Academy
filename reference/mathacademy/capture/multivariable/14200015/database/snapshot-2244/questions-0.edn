#{[{:db/id #edb/ref 17592186166592 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166754 :knowledge-point/id #uuid "8e25ae0e-d10c-5fa4-924e-4c6a7efebac6" :knowledge-point/title "Differentiating an Inverse Sinh Function"}] :question/id #uuid "181b2a5e-7caf-5527-8602-e67a945affde" :question/math-academy-id "e-8337" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y = 2\\arsinh{x^2}$, then find $\\dfrac {\\textrm{d}y}{\\textrm{d}x}$." :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe formula for the derivative of the inverse hyperbolic sine function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arsinh x) = \\dfrac{1}{\\sqrt{x^2+1}}\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(2arsinh x^{2}) \\\\\n&= 2 \\cdot \\frac{d}{dx}(arsinh x^{2}) \\\\\n&= 2 \\cdot (1)/(\\sqrt{(x^{2})^{2} + 1}) \\cdot (x^{2})^{′} \\\\\n&= 2 \\cdot \\frac{1}{\\sqrt{x^{4} + 1}} \\cdot 2x \\\\\n&= \\frac{4x}{\\sqrt{x^{4} + 1}}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166593 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166755 :knowledge-point/id #uuid "eaab6e41-d34d-5eca-a41f-5ebe58a6b178" :knowledge-point/title "Differentiating an Inverse Cosh Function"}] :question/id #uuid "ce19d882-3c04-5ef1-8393-7de582df188d" :question/math-academy-id "e-8338" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y =\\arcosh(x+1)$, then find $\\dfrac {\\textrm{d}y}{\\textrm{d}x}$." :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe formula for the derivative of the inverse hyperbolic cosine function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcosh x) = \\dfrac{1}{\\sqrt{x^2-1}}\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(arcosh (x + 1)) \\\\\n&= (1)/(\\sqrt{(x + 1)^{2} - 1}) \\cdot (x + 1)^{′} \\\\\n&= (1)/(\\sqrt{(x^{2} + 2x + 1) - 1}) \\cdot 1 \\\\\n&= \\frac{1}{\\sqrt{x^{2} + 2x}} \\\\\n&= (1)/(\\sqrt{x(x + 2)})\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166594 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166756 :knowledge-point/id #uuid "1979b91d-2ac0-5d35-b4cc-1c9c9505b503" :knowledge-point/title "Differentiating an Inverse Tanh Function"}] :question/id #uuid "d5eeb5a1-4bfd-5f1e-b261-548c91eec64b" :question/math-academy-id "e-8339" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y = \\artanh{4x}$, then find $\\dfrac {\\textrm{d}y}{\\textrm{d}x}$." :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe formula for the derivative of the inverse hyperbolic tangent function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\artanh x) = \\dfrac{1}{1-x^2}\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(artanh 4x) \\\\\n&= (1)/(1 - (4x)^{2}) \\cdot (4x)^{′} \\\\\n&= \\frac{1}{1 - 16x^{2}} \\cdot 4 \\\\\n&= \\frac{4}{1 - 16x^{2}}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166595 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166757 :knowledge-point/id #uuid "57d851ce-44b5-5713-ba65-7f5a9cc1122f" :knowledge-point/title "Differentiating Inverse Hyperbolic Functions Using the Product and Quotient Rules"}] :question/id #uuid "7cd3958b-aa1c-5c9a-b2ef-a21002aa7ff1" :question/math-academy-id "e-8340" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $w(x) = e^{2x}\\artanh{x}$, then $w'(x)=2e^{2x}\\artanh{x} + y(x)$. What is $y(x)$?" :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nHere, we have the product of two functions\n\n$$\nu(x) = e^{2x}\n$$\n\nand\n\n$$\nv(x)=\\artanh{x}\n$$\n\nSo, we apply the product rule:\n\n$$\n\\begin{aligned}\nw^{′}(x) &= (e^{2x})^{′} \\cdot artanh x + e^{2x} \\cdot (artanh x)^{′} \\\\\n&= 2e^{2x} \\cdot artanh x + e^{2x} \\cdot \\frac{1}{1 - x^{2}} \\\\\n&= 2e^{2x}artanh x + \\frac{e^{2x}}{1 - x^{2}}_(⏟)_(y(x))\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\ny(x) = \\dfrac{e^{2x}}{1 - x^2}\n$$"}] [{:db/id #edb/ref 17592186167377 :knowledge-point/_questions [{:db/id #edb/ref 17592186166755 :knowledge-point/id #uuid "eaab6e41-d34d-5eca-a41f-5ebe58a6b178" :knowledge-point/title "Differentiating an Inverse Cosh Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41fa042a-ae62-595a-a028-df07e36761ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (8)/(\\sqrt{x(x - 1)})" :db/id #edb/ref 17592186165471} {:answer/id #uuid "44bcbda6-a0d4-5a22-bf5d-edf5b1930d8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8)/(\\sqrt{x(x + 1)})" :db/id #edb/ref 17592186165472} {:answer/id #uuid "46786da4-42ac-539a-aff0-6e033a99b6c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x - 1}}" :db/id #edb/ref 17592186165473} {:answer/id #uuid "51ac1491-118d-5ab5-9c62-2c8eec4dd7cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (4)/(\\sqrt{x(x - 1)})" :db/id #edb/ref 17592186165474} {:answer/id #uuid "73c25b6b-b1c4-5db4-9ed4-27a892a44cf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{\\sqrt{x - 1}}" :db/id #edb/ref 17592186165475}] :answer-field/id #uuid "69f902f3-a692-59e5-9182-a1ffd7507170" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165470}] :question/id #uuid "42791671-1939-52f6-ab50-2487917a0006" :question/math-academy-id "q-95498" :question/problem "If $y =-8arcosh \\sqrt{x}$, then $\\frac{dy}{dx} =$"}]}
