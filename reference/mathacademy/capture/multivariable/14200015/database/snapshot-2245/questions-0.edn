′} \\\\  & =6\\cdot \\frac{1}{\\sqrt{\\frac{{x}^{2}}{4}+1}}\\cdot \\frac{1}{2} \\\\  & =\\frac{6}{\\sqrt{{x}^{2}+4}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186167377 :knowledge-point/_questions [{:db/id #edb/ref 17592186166755 :knowledge-point/id #uuid "eaab6e41-d34d-5eca-a41f-5ebe58a6b178" :knowledge-point/title "Differentiating an Inverse Cosh Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "576cfe49-6667-5e72-b2dd-dc26db23ddd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{x(x+1)}}" :db/id #edb/ref 17592186516296} {:answer/id #uuid "8279b346-e76a-535f-99e9-6adf90b8339d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{\\sqrt{x(x-1)}}" :db/id #edb/ref 17592186516388} {:answer/id #uuid "ab24f10e-0d46-5b11-b506-e94241fbdcda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8}{\\sqrt{x(x-1)}}" :db/id #edb/ref 17592186516471} {:answer/id #uuid "c374c74b-d03c-5c8e-bfd1-2fb0eedd425f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{\\sqrt{x-1}}" :db/id #edb/ref 17592186516524} {:answer/id #uuid "df05a861-2443-5a4e-9a6f-773c26ed6267" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x-1}}" :db/id #edb/ref 17592186516585}] :answer-field/correct {:answer/id #uuid "8279b346-e76a-535f-99e9-6adf90b8339d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{\\sqrt{x(x-1)}}" :db/id #edb/ref 17592186516388} :answer-field/id #uuid "69f902f3-a692-59e5-9182-a1ffd7507170" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165470}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "42791671-1939-52f6-ab50-2487917a0006" :question/math-academy-id "q-95498" :question/problem "$$\n\nIf $y=-8\\operatorname{arcosh}⁡\\sqrt{x},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosine function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-8\\operatorname{arcosh}⁡\\sqrt{x}) \\\\  & =-8\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡\\sqrt{x}) \\\\  & =-8\\cdot \\frac{1}{\\sqrt{{(\\sqrt{x})}^{2}-1}}\\cdot {(\\sqrt{x})}^{′} \\\\  & =-8\\cdot \\frac{1}{\\sqrt{x-1}}\\cdot \\frac{1}{2\\sqrt{x}} \\\\  & =-\\frac{4}{\\sqrt{x(x-1)}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186516866 :knowledge-point/_questions [{:db/id #edb/ref 17592186166755 :knowledge-point/id #uuid "eaab6e41-d34d-5eca-a41f-5ebe58a6b178" :knowledge-point/title "Differentiating an Inverse Cosh Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26ae5fb3-e188-5a9c-8eba-eb22ae5a01ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x}{\\sqrt{{e}^{2x}-1}}" :db/id #edb/ref 17592186516187} {:answer/id #uuid "70004764-4c25-59c4-a4fd-790640bfeec6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{\\sqrt{{e}^{2x}+1}}" :db/id #edb/ref 17592186516362} {:answer/id #uuid "8cf95fed-380f-5323-9ad8-414868c12e3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{e}^{2x}}{\\sqrt{{e}^{x}+1}}" :db/id #edb/ref 17592186516407} {:answer/id #uuid "f05f982b-8fd9-5753-b491-bc78c9c9cc93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{\\sqrt{1-{e}^{2x}}}" :db/id #edb/ref 17592186516607} {:answer/id #uuid "f2608f60-ae