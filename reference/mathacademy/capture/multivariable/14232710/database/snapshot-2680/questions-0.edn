#{[{:db/id #edb/ref 17592186176476 :knowledge-point/_questions [{:db/id #edb/ref 17592186176089 :knowledge-point/id #uuid "ba9d2401-4e30-5327-b8eb-b4db7108dd0c" :knowledge-point/title "Identifying True Statements Regarding Linear Transformations in the Cartesian Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec8c126b-beb0-5259-95a8-ee03317b9dbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477289} {:answer/id #uuid "05b4a708-dd67-557a-9e5d-3cec0dfaf56e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477290}] :answer-field/correct {:answer/id #uuid "ec8c126b-beb0-5259-95a8-ee03317b9dbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477289} :answer-field/id #uuid "6e9fdd20-93bb-54d2-8f45-dd434f374b95" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477614} {:answer-field/choices [{:answer/id #uuid "2ca155e7-6b82-5264-aff3-a5b9bbf22322" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477291} {:answer/id #uuid "d241b648-c419-53a1-bd11-5a4510ba9eba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477292}] :answer-field/correct {:answer/id #uuid "2ca155e7-6b82-5264-aff3-a5b9bbf22322" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477291} :answer-field/id #uuid "8474779a-6aa5-57d6-8c8a-638b08fec6e2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477615} {:answer-field/choices [{:answer/id #uuid "85d7e293-6acb-57a3-84e4-89d7e0daf5c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477293} {:answer/id #uuid "c9be56df-604d-5bf1-b89a-a5381de8206d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477294}] :answer-field/correct {:answer/id #uuid "c9be56df-604d-5bf1-b89a-a5381de8206d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477294} :answer-field/id #uuid "6637f2a2-acef-52c2-99ff-897ed538dbfe" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477616}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4acbb26f-7e4b-53ce-a37d-bd74763516c8" :question/math-academy-id "q-38297" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ to the origin. Which of the following statements are true?\n- **I.** $\\text{rank}(T)=1$,  where $T$ is the standard matrix of $T$\n- **II.** $\\text{Im}(T)$ contains no vectors of ${R}^{2}$\n- **III.** $\\text{Ker}(T)={R}^{2}$\n\nSelect all that apply." :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is the zero-subspace ${0},$ then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=0\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-0 \\\\  & =2.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. In our case, we have \n\n$$\n\\text{rank}(T)=0.\n$$\n\n- Statement II is false. The image of $T$ contains the vector zero vector $0=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}.$\n\n- Statement III is true. Indeed, the condition $\\text{nullity}(T)=2$ in ${R}^{2}$ is equivalent to \n\n$$\n\\text{Ker}(T)={R}^{2}.\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186366052 :knowledge-point/_questions [{:db/id #edb/ref 17592186176089 :knowledge-point/id #uuid "ba9d2401-4e30-5327-b8eb-b4db7108dd0c" :knowledge-point/title "Identifying True Statements Regarding Linear Transformations in the Cartesian Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d07d408-4bd4-52a2-b369-1432edfe2c77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469020} {:answer/id #uuid "eaeb8c45-a223-54ca-b996-e4cc9a54fe8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469021}] :answer-field/correct {:answer/id #uuid "6d07d408-4bd4-52a2-b369-1432edfe2c77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469020} :answer-field/id #uuid "246b7ed5-a7fd-53be-80d4-b0d726f0fda5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470122} {:answer-field/choices [{:answer/id #uuid "4f53549c-840d-53f3-bf45-f0d90bcc6ab3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469022} {:answer/id #uuid "215f631a-fd6a-5cc0-906f-13e0a5fbd25e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469023}] :answer-field/correct {:answer/id #uuid "215f631a-fd6a-5cc0-906f-13e0a5fbd25e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469023} :answer-field/id #uuid "8a6bf326-d27f-5130-ad2f-4b066b4f2754" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470123} {:answer-field/choices [{:answer/id #uuid "5bb3b5e2-0da0-57b0-a807-697b0aeddec8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469024} {:answer/id #uuid "a8fd395f-d3c4-53ed-b990-698626ffd03e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469025}] :answer-field/correct {:answer/id #uuid "5bb3b5e2-0da0-57b0-a807-697b0aeddec8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469024} :answer-field/id #uuid "435f823d-9228-557b-a231-fc7e35bab06c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470124}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "34581764-4087-5b06-9eff-4679fe703405" :question/math-academy-id "q-38300" :question/problem "If the linear transformation $T$ maps ${R}^{2}$ onto the line $y=-3x$ then, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $⟨1,3⟩$ belongs to the range of $T$\n\n- **II.** $\\text{Ker}(T)\\ne {0}$\n\n- **III.** $\\text{Im}(T)={0}$" :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is a one-dimensional line, then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=1\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn. \n\n- Statement I is false. \nNotice that the point $(1,3)$ does not satisfy the equation of the line $y=-3x$ since $3\\ne -3\\cdot 1.$ Therefore, the vector $⟨1,3⟩\\notin \\text{Im}(T).$\n\n- Statement II is true. Indeed, \nsince $T$ maps ${R}^{2}$ onto a line passing through the origin, we have that the standard matrix $T$ is singular. Hence, $\\text{Ker}(T)\\ne {0}.$\n\n- Statement III is false. \nFor example,  the point $(1,-3)$ satisfies the equation  $y=-3x$ since $-3=-3\\cdot 1.$ Therefore, the vector $⟨1,-3⟩\\in \\text{Im}(T).$ Thus, $\\text{Im}(T)\\ne {0}.$"}] [{:db/id #edb/ref 17592186366752 :knowledge-point/_questions [{:db/id #edb/ref 17592186176088 :knowledge-point/id #uuid "390ecc8f-2938-5466-b49b-964a67f79755" :knowledge-point/title "Determining the One-Dimensional Image of a Linear Transformation in the Cartesian Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f40948d-6a2c-590f-8a11-24b48ddadb86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186366754} {:answer/id #uuid "0f77d896-8399-547f-8c3f-2490b781e097" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x" :db/id #edb/ref 17592186366755} {:answer/id #uuid "e4ca92a7-2ef3-53a1-8ddd-54bea50ff463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{3}{2}x" :db/id #edb/ref 17592186366756} {:answer/id #uuid "963c7644-d7cd-502e-9404-7dfcb73af315" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186366757} {:answer/id #uuid "c8765811-b618-5407-abfc-5f01d72ccdd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x" :db/id #edb/ref 17592186366758}] :answer-field/correct {:answer/id #uuid "c8765811-b618-5407-abfc-5f01d72ccdd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x" :db/id #edb/ref 17592186366758} :answer-field/id #uuid "292d5352-84c3-580e-88ff-42f528f9a4e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366753}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1afcec6c-a31f-5b1b-826d-d0232bfbe82b" :question/math-academy-id "q-97034" :question/problem "Let\n$T=\\begin{bmatrix}1 & -1 \\\\ -1 & 1\\end{bmatrix}$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the points $(1,-1)$ and $(-1,1),$ which are defined by the columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{1-(-1)}{-1-1}=-1.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=-x.$"}] [{:db/id #edb/ref 17592186366759 :knowledge-point/_questions [{:db/id #edb/ref 17592186176088 :knowledge-point/id #uuid "390ecc8f-2938-5466-b49b-964a67f79755" :knowledge-point/title "Determining the One-Dimensional Image of a Linear Transformation in the Cartesian Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98ef481a-705d-5f82-9a19-92ceb01cfee8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186366761} {:answer/id #uuid "7a54ef0a-64c9-5842-8675-a775bf4e73ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186366762} {:answer/id #uuid "c8f8f571-4006-5417-916b-8b1ccb869c3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x" :db/id #edb/ref 17592186366763} {:answer/id #uuid "52efde24-9a00-5780-9f50-bdae742b41f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x" :db/id #edb/ref 17592186366764} {:answer/id #uuid "fccc2756-9459-5499-8770-f77a30708a59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4x" :db/id #edb/ref 17592186366765}] :answer-field/correct {:answer/id #uuid "c8f8f571-4006-5417-916b-8b1ccb869c3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x" :db/id #edb/ref 17592186366763} :answer-field/id #uuid "1ca72594-5be6-5643-b9f7-7c9ff9fc7016" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366760}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eff617ee-6ce3-51e8-bcd8-61c31ebef8f9" :question/math-academy-id "q-97068" :question/problem "Let\n$T=\\begin{bmatrix}1 & 2 \\\\ 4 & 8\\end{bmatrix}$\nbe the standard matrix of the linear transformation $T.$ Then $T$ maps ${R}^{2}$ onto" :question/worked-solution "Notice that $T$ has proportional rows, and yet $T$ is not the zero matrix. \n\nTherefore, $\\text{rank}(T)=1$ and $T$ maps ${R}^{2}$ onto a line that passes through the origin.\n\nMoreover, the line must pass through the origin $(0,0)$ and the points $(1,4)$ and $(2,8),$ which are defined by the columns of the matrix $T.$ \n\nComputing the slope $m$ of this line, we get\n\n$$\nm=\\frac{8-4}{2-1}=4.\n$$\n\n \n\nTherefore, $T$ maps ${R}^{2}$ onto the line $y=4x.$"}] [{:db/id #edb/ref 17592186366780 :knowledge-point/_questions [{:db/id #edb/ref 17592186176089 :knowledge-point/id #uuid "ba9d2401-4e30-5327-b8eb-b4db7108dd0c" :knowledge-point/title "Identifying True Statements Regarding Linear Transformations in the Cartesian Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12eb12db-c865-5a15-995f-57d1e99856b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452323} {:answer/id #uuid "fa2992f7-296f-52e8-8e2f-b1875fa14a31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452324}] :answer-field/correct {:answer/id #uuid "12eb12db-c865-5a15-995f-57d1e99856b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452323} :answer-field/id #uuid "12ebab7b-febe-5850-8be3-97869ab43f9b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453009} {:answer-field/choices [{:answer/id #uuid "dff232c6-f90e-549a-bf5d-1544c0d7eb35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452325} {:answer/id #uuid "cc22eb64-3d36-5f56-935a-3d6d0d508e49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452326}] :answer-field/correct {:answer/id #uuid "cc22eb64-3d36-5f56-935a-3d6d0d508e49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452326} :answer-field/id #uuid "9583cd23-de18-5d81-9215-33038a6df612" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453010} {:answer-field/choices [{:answer/id #uuid "d092dba5-3f4c-5126-93c1-b72bf8d37079" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452327} {:answer/id #uuid "3d4acc6c-2043-51df-a00b-c80988412bef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452328}] :answer-field/correct {:answer/id #uuid "d092dba5-3f4c-5126-93c1-b72bf8d37079" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452327} :answer-field/id #uuid "5957978d-2e1f-5607-8d63-c7b81149356e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186453011}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2335439b-17b4-5a3d-b1ce-91063205bf0d" :question/math-academy-id "q-97079" :question/problem "Consider a linear transformation $T$ that maps ${R}^{2}$ onto the line $y=2x.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $⟨2,1⟩\\in \\text{Im}(T)$\n- **II.** $\\text{Ker}(T)\\ne {0}$\n- **III.** $\\text{nullity}(T)=2$, where $T$ is the standard matrix of $T$" :question/worked-solution "Recall that when the image of a linear transformation $T$ in ${R}^{2}$ with the standard matrix $T$ is a one-dimensional line, then\n\n$$\n\\text{rank}(T)=\\text{rank}(T)=1,\n$$\n\nand, according to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(T)=\\text{nullity}(T) & =2-\\text{rank}(T) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. The point $(2,1)$ does not satisfy the equation of the line $y=2x$ since $1\\ne 2\\cdot 2.$ Hence, \n\n$$\n⟨2,1⟩\\notin \\text{Im}(T).\n$$\n\n- Statement II is true. Since $\\text{nullity}(T)=1,$ we get \n\n$$\n\\text{Ker}(T)\\ne {0}.\n$$\n\n- Statement III is false. We have that \n\n$$\n\\text{nullity}(T)=1.\n$$\n\nTherefore, the correct answer is \"II only.\""}]}
