86084561 #edb/ref 1083 #uuid "860dda14-285e-5ad7-82aa-2698e5c97a3f" #edb/ref 17592186045417] [17592186084562 #edb/ref 1080 "\\displaystyle \\int_{0}^{1/2}\\frac{1}{1 - 2x^{3}}dx = 1 - \\frac{1}{2} + \\frac{1}{28} - ⋯" #edb/ref 17592186045417] [17592186084562 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186084562 #edb/ref 1083 #uuid "8a517055-c594-50c1-9465-337f036984a7" #edb/ref 17592186045417] [17592186084563 #edb/ref 1080 "\\displaystyle \\int_{0}^{1/2}\\frac{1}{1 - 2x^{3}}dx = \\frac{1}{2} + \\frac{1}{32} + \\frac{1}{224} + ⋯" #edb/ref 17592186045417] [17592186084563 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186084563 #edb/ref 1083 #uuid "13c1e798-5b4f-5a7f-b3ec-b6c3b4de50ee" #edb/ref 17592186045417] [17592186084564 #edb/ref 1080 "\\displaystyle \\int_{0}^{1/2}\\frac{1}{1 - 2x^{3}}dx = \\frac{1}{2} - \\frac{1}{16} + \\frac{1}{121} - ⋯" #edb/ref 17592186045417] [17592186084564 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186084564 #edb/ref 1083 #uuid "31c21ecf-014a-59e0-833d-9e75a5a81625" #edb/ref 17592186045417] [17592186084565 #edb/ref 1080 "\\displaystyle \\int_{0}^{1/2}\\frac{1}{1 - 2x^{3}}dx = \\frac{1}{2} + \\frac{1}{32} + \\frac{1}{144} + ⋯" #edb/ref 17592186045417] [17592186084565 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186084565 #edb/ref 1083 #uuid "7b191157-86c7-5fd3-b21d-4ca18bd1db83" #edb/ref 17592186045417] [17592186084728 #edb/ref 1075 #edb/ref 17592186084729 #edb/ref 17592186045417] [17592186084728 #edb/ref 1075 #edb/ref 17592186084730 #edb/ref 17592186045417] [17592186084728 #edb/ref 1075 #edb/ref 17592186084731 #edb/ref 17592186045417] [17592186084728 #edb/ref 1075 #edb/ref 17592186084732 #edb/ref 17592186045417] [17592186084728 #edb/ref 1075 #edb/ref 17592186084733 #edb/ref 17592186045417] [17592186084728 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186084728 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186084728 #edb/ref 1079 #uuid "82032938-ca92-55b7-b0fb-f0c89679a907" #edb/ref 17592186045417] [17592186084729 #edb/ref 1080 "\\intxe^{-x^{2}}dx = C + \\frac{1}{5}x - \\frac{1}{10}x^{2} + \\frac{1}{15}x^{3} + ⋯" #edb/ref 17592186045417] [17592186084729 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186084729 #edb/ref 1083 #uuid "1a579397-1cbf-5516-a8f8-2c51ff44f6c7" #edb/ref 17592186045417] [17592186084730 #edb/ref 1080 "\\intxe^{-x^{2}}dx = C + \\frac{1}{2}x^{2} - \\frac{1}{4}x^{4} + \\frac{1}{16}x^{6} + ⋯" #edb/ref 17592186045417] [17592186084730 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186084730 #edb/ref 1083 #uuid "292922fa-e2d4-58bf-89aa-273b1fee71d4" #edb/ref 17592186045417] [17592186084731 #edb/ref 1080 "\\intxe^{-x^{2}}dx = C + \\frac{1}{2}x - \\frac{1}{4}x^{2} + \\frac{1}{12}x^{3} + ⋯" #edb/ref 17592186045417] [17592186084731 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186084731 #edb/ref 1083 #uuid "370fe6aa-706d-5cc3-b539-462ecc16e492" #edb/ref 17592186045417] [17592186084732 #edb/ref 1080 "\\intxe^{-x^{2}}dx = C + \\frac{1}{2}x^{2} + \\frac{1}{4}x^{4} + \\frac{1}{16}x^{6} + ⋯" #edb/ref 17592186045417] [17592186084732 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186084732 #edb/ref 1083 #uuid "4f94f60a-8d32-5a77-ad1b-3f7cb1136a7e" #edb/ref 17592186045417] [17592186084733 #edb/ref 1080 "\\intxe^{-x^{2}}dx = C + \\frac{1}{2}x^{2} - \\frac{1}{4}x^{4} + \\frac{1}{12}x^{6} + ⋯" #edb/ref 17592186045417] [17592186084733 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186084733 #edb/ref 1083 #uuid "7b446b23-d104-5ae8-a540-3c2823eed09b" #edb/ref 17592186045417] [17592186087639 #edb/ref 1069 "e-765" #edb/ref 17592186045417] [17592186087639 #edb/ref 1071 "Starting with the standard Maclaurin result for $e^x$, find the first three terms of the series expansion for $\\displaystyle{\\displaystyle \\int e^{-x^2}\\textrm{d}x}$." #edb/ref 17592186045417] [17592186087639 #edb/ref 1072 #uuid "16b3f250-dfcb-5fa6-bfdb-4acf92d8bd37" #edb/ref 17592186045417] [17592186087639 #edb/ref 1074 "The series expansion of $e^{x}$ is\n\n$$\n\\begin{aligned}\ne^{x} &= 1 + x + \\frac{1}{2!}x^{2} + ⋯\n\\end{aligned}\n$$\n\nReplacing $x$ with $-x^2$ in the above formula, we get\n\n$$\n\\begin{aligned}\ne^{-x^{2}} &= 1 + (-x^{2}) + \\frac{1}{2!}(-x^{2})^{2} + ⋯ \\\\\n&= 1 - x^{2} + \\frac{1}{2}x^{4} + ⋯\n\\end{aligned}\n$$\n\nFinally, integrating with respect to $x$, we get\n\n$$\n\\begin{aligned}\n\\inte^{-x^{2}}dx &= \\int(1 - x^{2} + \\frac{1}{2}x^{4} + ⋯)dx \\\\\n&= C + x - \\frac{1}{3}x^{3} + \\frac{1}{10}x^{5} + ⋯\n\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186087640 #edb/ref 1069 "e-766" #edb/ref 17592186045417] [17592186087640 #edb/ref 1071 "Using the standard form of the Maclaurin series of $\\ln(1+x)$, find the first three non-zero terms of the series expansion of the definite integral\n$\\displaystyle{\\displaystyle \\int_0^{1/2}\\ln(1-x^2)\\text{d}x}$." #edb/ref 17592186045417] [17592186087640 #edb/ref 1072 #uuid "4211b707-bff1-5855-9449-16e14858e6ad" #edb/ref 17592186045417] [17592186087640 #edb/ref 1074 "The power series expansion of $\\ln(1+x)$ is given by\n\n$$\n\\ln (1 + x) = x - \\frac{1}{2}x^{2} + \\frac{1}{3}x^{3} + ⋯\n$$\n\nReplacing $x$ with $-x^2$ in the above, we get\n\n$$\n\\begin{aligned}\n\\ln (1 - x^{2}) &= (-x^{2}) - \\frac{1}{2}(-x^{2})^{2} + \\frac{1}{3}(-x^{2})^{3} + ⋯ \\\\\n&=-x^{2} - \\frac{1}{2}x^{4} - \\frac{1}{3}x^{6} + ⋯\n\\end{aligned}\n$$\n\nFinally, we calculate the definite integral, as follows:\n\n$$\n\\begin{aligned}\n\\int_{0}^{1/2}\\ln (1 - x^{2})dx &= \\int(-x^{2} - \\frac{1}{2}x^{4} - \\frac{1}{3}x^{6} + ⋯)dx \\\\\n&= \\left.(-\\frac{x^{3}}{3} - \\frac{1}{2} \\cdot \\frac{x^{5}}{5} - \\frac{1}{3} \\cdot \\frac{x^{7}}{7} + ⋯)\\right|_{0}^{1/2} \\\\\n&=-\\frac{1}{3 \\cdot 2^{3}} - \\frac{1}{2 \\cdot 5 \\cdot 2^{5}} - \\frac{1}{3 \\cdot 7 \\cdot 2^{7}} \\\\\n&=-\\frac{1}{24} - \\frac{1}{320} - \\frac{1}{2688} + ⋯\n\\end{aligned}\n$$\n\n**Note:** We can get a numerical approximation by evaluating the first three terms. This gives\n\n$$\n\\int_{0}^{1/2}\\ln (1 - x^{2})dx \\mid \\approx - \\frac{1}{24} - \\frac{1}{320} - \\frac{1}{2688} =-0.04516\n$$\n\nrounded to five decimal places.\n\nThe exact value of the integral, rounded to five decimal places, is\n\n$$\n\\begin{aligned}\n\\int_{0}^{1/2}\\ln (1 - x^{2})dx &= -0.04523\n\\end{aligned}\n$$\n\nSo, our estimation was pretty good!" #edb/ref 17592186045417] [17592186087793 #edb/ref 1037 #edb/ref 17592186049182 #edb/ref 17592186045417] [17592186087793 #edb/ref 1037 #edb/ref 17592186050321 #edb/ref 17592186045417] [17592186087793 #edb/ref 1038 #edb/ref 17592186087970 #edb/ref 17592186045417] [17592186087793 #edb/ref 1038 #edb/ref 17592186087999 #edb/ref 17592186045417] [17592186087793 #edb/ref 1039 "Computing Indefinite Integrals Using Taylor Series" #edb/ref 17592186045417] [17592186087793 #edb/ref 1041 #edb/ref 17592186087639 #edb/ref 17592186045417] [17592186087793 #edb/ref 1042 #uuid "eea68c90-99a8-5254-b799-5f0ed51615a9" #edb/ref 17592186045417] [17592186087794 #edb/ref 1037 #edb/ref 17592186050819 #edb/ref 17592186045417] [17592186087794 #edb/ref 1038 #edb/ref 17592186087971 #edb/ref 17592186045417] [17592186087794 #edb/ref 1038 #edb/ref 17592186088413 #edb/ref 17592186045417] [17592186087794 #edb/ref 1039 "Computing Definite Integrals Using Taylor Series" #edb/ref 17592186045417] [17592186087794 #edb/ref 1041 #edb/ref 17592186087640 #edb/ref 17592186045417] [17592186087794 #edb/ref 1042 #uuid "1f133583-cb11-5007-bdef-641838aff5e4" #edb/ref 17592186045417] [17592186087951 #edb/ref 1043 #edb/ref 17592186088678 #edb/ref 17592186045417] [17592186087951 #edb/ref 1043 #edb/ref 17592186088679 #edb/ref 17592186045417] [17592186087951 #edb/ref 1043 #edb/ref 17592186088680 #edb/ref 17592186045417] [17592186087951 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186087951 #edb/ref 1045 "Appro