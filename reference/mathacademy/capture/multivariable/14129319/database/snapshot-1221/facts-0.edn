493 #edb/ref 17592186045417] [17592186168705 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186168705 #edb/ref 1078 #edb/ref 17592186168706 #edb/ref 17592186045417] [17592186168705 #edb/ref 1079 #uuid "744dba16-b85d-5809-875d-1211f267487f" #edb/ref 17592186045417] [17592186168706 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186168706 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186168706 #edb/ref 1083 #uuid "d24203b1-5e2d-543b-b875-84082292041c" #edb/ref 17592186045417] [17592186168707 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186168707 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186168707 #edb/ref 1083 #uuid "12450fac-5904-57a0-92e2-bc8a3468008b" #edb/ref 17592186045417] [17592186168708 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186168708 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186168708 #edb/ref 1083 #uuid "23c8d906-57d9-5dfc-98ed-afb30ba1cec2" #edb/ref 17592186045417] [17592186168709 #edb/ref 1080 "2\\sqrt{2}" #edb/ref 17592186045417] [17592186168709 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186168709 #edb/ref 1083 #uuid "58920047-051c-5179-a311-88f110077114" #edb/ref 17592186045417] [17592186168710 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186168710 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186168710 #edb/ref 1083 #uuid "5d55495b-d3c0-5a44-b16e-2735230596b3" #edb/ref 17592186045417] [17592186168711 #edb/ref 1075 #edb/ref 17592186424462 #edb/ref 17592186045417] [17592186168711 #edb/ref 1075 #edb/ref 17592186424477 #edb/ref 17592186045417] [17592186168711 #edb/ref 1075 #edb/ref 17592186424483 #edb/ref 17592186045417] [17592186168711 #edb/ref 1075 #edb/ref 17592186424484 #edb/ref 17592186045417] [17592186168711 #edb/ref 1075 #edb/ref 17592186424496 #edb/ref 17592186045417] [17592186168711 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186168711 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186168711 #edb/ref 1078 #edb/ref 17592186424477 #edb/ref 17592186045417] [17592186168711 #edb/ref 1079 #uuid "6725b75c-c66c-52af-8566-302236c9d990" #edb/ref 17592186045417] [17592186171905 #edb/ref 1069 "e-9563" #edb/ref 17592186045417] [17592186171905 #edb/ref 1071 "Use the flux form of Green's theorem to calculate the flux of the vector field\n\n$$\n\\mathbf{F}(x,y) = \\left\\langle -3xy^2 , \\: y+\\cos x \\right\\rangle\n$$\n\nthrough the boundary of the triangle with vertices $(0,0), (2,2),$ and $(-2,2).$" #edb/ref 17592186045417] [17592186171905 #edb/ref 1072 #uuid "1c03777d-2ead-5333-bf75-0e9a96fdb0e3" #edb/ref 17592186045417] [17592186171905 #edb/ref 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf F = P\\,\\mathbf i + Q\\,\\mathbf j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n\\oint\\limits_C \\mathbf F\\cdot\\mathbf n\\,\\textrm d s = \\iint\\limits_D \\textrm{div}\\,\\mathbf F\\,\\textrm{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n\\oint\\limits_C P \\,\\mathrm{d}y - Q \\, \\mathrm{d}x = \\iint\\limits_D \\left( \\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} \\right) \\,\\textrm{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/aa/aa822f0b9259d6d9eb5c6f439588e70d4b9bee16b2b868fae36c7cbac72d3c3f.png)\n\nWe have that $P(x,y) = -3xy^2$ and $Q(x,y) = y+\\cos x .$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=-3{y}^{2},\\,\\frac{∂Q}{∂y} & =1.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type II region as follows:\n\n$$\nD = \\left\\{(x,y) :  -y \\leq x \\leq y, \\, 0 \\leq y \\leq 2 \\right\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(-3{y}^{2}+1)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{-y}^{y}(-3{y}^{2}+1)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}(-3{y}^{2}+1)[x]_{-y}^{y}\\,dy \\\\  & ={\\int }_{0}^{2}(-3{y}^{2}+1)(y-(-y))\\,dy \\\\  & ={\\int }_{0}^{2}(-3{y}^{2}+1)\\cdot 2y\\,dy \\\\  & ={\\int }_{0}^{2}(-6{y}^{3}+2y)\\,dy \\\\  & =[-6\\cdot \\frac{{y}^{4}}{4}+2\\cdot \\frac{{y}^{2}}{2}]_{0}^{2} \\\\  & =[-\\frac{3{y}^{4}}{2}+{y}^{2}]_{0}^{2} \\\\  & =(-24+4)-0 \\\\  & =-20.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186171906 #edb/ref 1069 "e-9564" #edb/ref 17592186045417] [17592186171906 #edb/ref 1071 "Consider the rectangle $C$ with vertices $(-1,0), (-1,-3), (1,-3),$ and $(1,0),$  traversed counterclockwise. Using the flux form of Green's theorem, express the flux of the vector field\n$\\mathbf{F}(x,y) = (7x^2y^6 +x^3)\\, \\mathbf{i} + (- 2xy^7+4x^2y) \\, \\mathbf{j}$\nthrough $C$ as a repeated integral." #edb/ref 17592186045417] [17592186171906 #edb/ref 1072 #uuid "a9d748d6-d688-5b77-a250-cb534a371765" #edb/ref 17592186045417] [17592186171906 #edb/ref 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf F = P\\,\\mathbf i + Q\\,\\mathbf j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n\\oint\\limits_C \\mathbf F\\cdot\\mathbf n\\,\\textrm d s = \\iint\\limits_D \\textrm{div}\\,\\mathbf F\\,\\textrm{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n\\oint\\limits_C P \\,\\mathrm{d}y - Q \\, \\mathrm{d}x = \\iint\\limits_D \\left( \\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} \\right) \\,\\textrm{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/02/02964b07e45daba2d560fa16d34bcc92ddb8d0e0e83f644f8284dbe9d4b4557b.png)\n\nWe have that $P(x,y) =  7x^2y^6 +x^3$ and $Q(x,y) =- 2xy^7+4x^2y.$ So, \n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=14x{y}^{6}+3{x}^{2},\\,\\frac{∂Q}{∂y} & =-14x{y}^{6}+4{x}^{2}.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD = \\{(x,y) :  -1\\leq x\\leq 1, \\, -3\\leq y \\leq 0\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(14x{y}^{6}+3{x}^{2})+(-14x{y}^{6}+4{x}^{2})\\,\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{-3}^{0}7{x}^{2}\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186171907 #edb/ref 1069 "e-9565" #edb/ref 17592186045417] [17592186171907 #edb/ref 1071 "Use the flux form of Green's theorem to calculate the flux of the vector field\n\n$$\n\\mathbf{F}(x,y) = \\left\\langle \\sin(\\pi y) - x , \\: \\cos(\\pi x) + 2xy \\right\\rangle\n$$\n\nthrough the boundary of the square with vertices $(0,-1), (2,-1), (2,1),$ and $(0,1).$" #edb/ref 17592186045417] [17592186171907 #edb/ref 1072 #uuid "ed1dfb37-d01e-5d35-82f2-a441cdd54f3e" #edb/ref 17592186045417] [17592186171907 #edb/ref 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $\\mathbf F = P\\,\\mathbf i + Q\\,\\mathbf j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n\\oint\\limits_C \\mathbf F\\cdot\\mathbf n\\,\\textrm d s = \\iint\\limits_D \\textrm{div}\\,\\mathbf F\\,\\textrm{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n\\oint\\limits_C P \\,\\mathrm{d}y - Q \\, \\mathrm{d}x = \\iint\\limits_D \\left( \\dfrac{\\partial P}{\\partial x} + \\dfrac{\\partial Q}{\\partial y} \\right) \\,\\textrm{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/2f/2f3374de4a29c62587a79f6286dfe788e64c37e09e9d9b83b3a67b4dac10dc21.png)\n\nWe have that $P(x,y) = \\sin(\\pi y) - x$ and $Q(x,y) = \\cos(\\pi x) + 2xy.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=-1,\\,\\frac{∂Q}{∂y} & =2x.\\end{aligned}\n$$\n\nWe can express the rectangular region $D$ as follows:\n\n$$\nD = \\left\\{(x,y) :  0 \\leq x \\leq 2, \\, -1 \\leq y \\leq 1 \\right\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(-1+2x)\\,\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2}(2x-1)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{-1}^{1}({x}^{2}-x)\\,{|}_{0}^{2}\\,dy \\\\  & ={\\int }_{-1}^{1}({2}^{2}-2)\\,dy \\\\  & ={\\int }_{-1}^{1}2\\,dy \\\\  & =2y\\,{|}_{-1}^{1} \\\\  & =2(1)-2(-1) \\\\  & =4.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186172099 #edb/ref 1038 #edb/ref 17592186172304 #edb/ref 17592186045417] [17592186172099 #edb/ref 1038 #edb/ref 17592186172305 #edb/ref 17592186045417] [17592186172099 #edb/ref 1038 #edb/ref 17592186262754 #edb/ref 17592186045417] [17592186172099 #edb/ref 1038 #edb/ref 17592186262755 #edb/ref 17592186045417] [17592186172099 #edb/ref 1038 #edb/ref 17592186262758 #edb/ref 17592186045417] [17592186172099 #edb/ref 1038 #edb/ref 17592186262760 #edb/ref 17592186045417] [17592186172099 #edb/ref 1038 #edb/ref 17592186262762 #edb/ref 17592186045417] [17592186172099 #edb/ref 1038 #edb/ref 17592186424515 #edb/ref 17592186045417] [17592186172099 #edb/ref 1038 #edb/ref 17592186424516 #edb/ref 17592186045417] [17592186172099 #edb/ref 1038 #edb/ref 17592186424520 #edb/ref 17592186045417] [17592186172099 #edb/ref 1039 "Calculating Flux Across Other Type I and Type II Regions" #edb/ref 17592186045417] [17592186172099 #edb/ref 1041 #edb/ref 17592186171905 #edb/ref 17592186045417] [17592186172099 #edb/ref 1042 #uuid "629dd9d1-1c53-5a04-97bf-5799e71b9573" #edb/ref 17592186045417] [17592186172100 #edb/ref 1037 #edb/ref 17592186050793 #edb/ref 17592186045417] [17592186172100 #edb/ref 1037 #edb/ref 17592186051070 #edb/ref 17592186045417] [17592186172100 #edb/ref 1038 #edb/ref 17592186172308 #edb/ref 17592186045417] [17592186172100 #edb/ref 1038 #edb/ref 17592186172309 #edb/ref 17592186045417] [17592186172100 #edb/ref 1038 #edb/ref 17592186262728 #edb/ref 17592186045417] [17592186172100 #edb/ref 1038 #edb/ref 17592186262736 #edb/ref 17592186045417] [17592186172100 #edb/ref 1038 #edb/ref 17592186262737 #edb/ref 17592186045417] [17592186172100 #edb/ref 1038 #edb/ref 17592186387803 #edb/ref 17592186045417] [17592186172100 #edb/ref 1038 #edb/ref 17592186424519 #edb/ref 17592186045417] [17592186172100 #edb/ref 1038 #edb/ref 17592186424521 #edb/ref 17592186045417] [17592186172100 #edb/ref 1038 #edb/ref 17592186424522 #edb/ref 17592186045417] [17592186172100 #edb/ref 1038 #edb/ref 17592186424524 #edb/ref 17592186045417] [17592186172100 #edb/ref 1039 "Expressing Flux as a Double Integral Using Green's Theorem in Flux Form" #edb/ref 17592186045417] [17592186172100 #edb/ref 1041 #edb/ref 17592186171906 #edb/ref 17592186045417] [17592186172100 #edb/ref 1042 #uuid "d5c7e707-c978-566d-8a69-98c84c7eb53e" #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186172306 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186172307 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186262752 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186262753 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186262757 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186262759 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186424514 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186424517 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186424518 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186424523 #edb/ref 17592186045417] [17592186172101 #edb/ref 1039 "Calculating Flux Across Rectangles" #edb/ref 17592186045417] [17592186172101 #edb/ref 1041 #edb/ref 17592186171907 #edb/ref 17592186045417] [17592186172101 #edb/ref 1042 #uuid "f2a418f9-b4da-53b4-a39c-75d28dfa8595" #edb/ref 17592186045417] [17592186172181 #edb/ref 1043 #edb/ref 17592186173009 #edb/ref 17592186045417] [17592186172181 #edb/ref 1043 #edb/ref 17592186173010 #edb/ref 17592186045417] [17592186172181 #edb/ref 1043 #edb/ref 17592186173011 #edb/ref 17592186045417] [17592186172181 #edb/ref 1043 #edb/ref 17592186173012 #edb/ref 17592186045417] [17592186172181 #edb/ref 1043 #edb/ref 17592186173013 #edb/ref 17592186045417] [17592186172181 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186172181 #edb/ref 1045 "Green's Theorem in Flux Form" #edb/ref 17592186045417] [17592186172181 #edb/ref 1046 #edb/ref 17592186173013 #edb/ref 17592186045417] [17592186172181 #edb/ref 1049 #edb/ref 17592186050694 #edb/ref 17592186045417] [17592186172181 #edb/ref 1050 600.0 #edb/ref 17592186045417] [17592186172181 #edb/ref 1053 #uuid "1b7424bb-16f3-51a5-8f12-862fc36f5a2a" #edb/ref 17592186045417] [17592186172304 #edb/ref 1068 #edb/ref 17592186168687 #edb/ref 17592186045417] [17592186172304 #edb/ref 1069 "q-126814" #edb/ref 17592186045417] [17592186172304 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186172304 #edb/ref 1071 "Use the flux form of Green's theorem to calculate the flux of the vector field\n\n$$\nF(x,y)=⟨3{x}^{5}+2y,\\,3{y}^{2}-{e}^{x}⟩\n$$\n\nthrough the boundary of the triangle with vertices $(0,0),(1,1),$ and $(-1,1).$" #edb/ref 17592186045417] [17592186172304 #edb/ref 1072 #uuid "5f0fa3f4-0fcf-5a8c-888e-2010c07d0c94" #edb/ref 17592186045417] [17592186172304 #edb/ref 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\,\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/26/269e3c7f92cee66c78f3226e7c967eb51153503c598d2e4d1e4b56a33e646ac4.png)\n\nWe have that $P(x,y)=3{x}^{5}+2y$ and $Q(x,y)=3{y}^{2}-{e}^{x}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=15{x}^{4},\\,\\frac{∂Q}{∂y} & =6y.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type II region as follows:\n\n$$\nD=\\{(x,y):-y\\le x\\le y,\\,0\\le y\\le 1\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(15{x}^{4}+6y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{-y}^{y}(15{x}^{4}+6y)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}[3{x}^{5}+6xy]_{-y}^{y}\\,dy \\\\  & ={\\int }_{0}^{1}[(3{y}^{5}+6{y}^{2})-(-3{y}^{5}-6{y}^{2})]\\,dy \\\\  & ={\\int }_{0}^{1}(6{y}^{5}+12{y}^{2})\\,dy \\\\  & =[{y}^{6}+4{y}^{3}]_{0}^{1} \\\\  & =(1+4)-0 \\\\  & =5.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186172305 #edb/ref 1068 #edb/ref 17592186168693 #edb/ref 17592186045417] [17592186172305 #edb/ref 1069 "q-126817" #edb/ref 17592186045417] [17592186172305 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186172305 #edb/ref 1071 "Use the flux form of Green's theorem to calculate the flux of the vector field\n\n$$\nF(x,y)=⟨{x}^{2}+2y,\\,{x}^{2}+2xy⟩\n$$\n\nthrough the boundary of the region enclosed by the curve $y={x}^{2}$ and the lines $y=0$ and $x=1.$" #edb/ref 17592186045417] [17592186172305 #edb/ref 1072 #uuid "e7800f0b-56af-56c9-9f5d-febc0c902fbd" #edb/ref 17592186045417] [17592186172305 #edb/ref 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\,\\text{d}A\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/91/9168d2ed7eeaa5f1dd331a0a986ac7ecfd6b964217a2cb614deb0cdd54437d65.png)\n\nWe have that $P(x,y)={x}^{2}+2y$ and $Q(x,y)={x}^{2}+2xy.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2x,\\,\\frac{∂Q}{∂y} & =2x.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD=\\{(x,y):0\\le x\\le 1,\\,0\\le y\\le {x}^{2}\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2x+2x)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{{x}^{2}}4x\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}4xy\\,{|}_{0}^{{x}^{2}}\\,dx \\\\  & ={\\int }_{0}^{1}4{x}^{3}\\,dx \\\\  & ={x}^{4}\\,{|}_{0}^{1} \\\\  & ={1}^{4}-0 \\\\  & =1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186172307 #edb/ref 1068 #edb/ref 17592186168705 #edb/ref 17592186045417] [17592186172307 #edb/ref 1069 "q-126821" #edb/ref 17592186045417] [17592186172307 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186172307 #edb/ref 1071 "Use the flux form of Green's theorem to calculate the flux of the vector field\n\n$$\nF(x,y)=⟨\\operatorname{cos}⁡(\\pi y)-{x}^{2},\\,\\operatorname{sin}⁡(\\pi x)+2y⟩\n$$\n\nthrough the boundary of the square $0\\le x\\le 1,0\\le y\\le 1.$" #edb/ref 17592186045417] [17592186172307 #edb/ref 1072 #uuid "ceef6c7e-683c-550f-97a1-9156380979d7" #edb/ref 17592186045417] [17592186172307 #edb/ref 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\,\\text{d}A\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n \n\n![](images/37/3786d0a5fb99d1a32d761e067f9c49b6b7da05a11fc555dd94a4ef42d753f129.png)\n\nWe have that $P(x,y)=\\operatorname{cos}⁡(\\pi y)-{x}^{2}$ and $Q(x,y)=\\operatorname{sin}⁡(\\pi x)+2y.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=-2x,\\,\\frac{∂Q}{∂y} & =2.\\end{aligned}\n$$\n\nWe can express the rectangular region $D$ as follows:\n\n$$\nD=\\{(x,y):0\\le x\\le 1,\\,0\\le y\\le 1\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(-2x+2)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}(2-2x)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}[2x-{x}^{2}]_{0}^{1}\\,dy \\\\  & ={\\int }_{0}^{1}[(2-1)-0]\\,dy \\\\  & ={\\int }_{0}^{1}\\,dy \\\\  & =y\\,{|}_{0}^{1} \\\\  & =1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186172308 #edb/ref 1068 #edb/ref 17592186168711 #edb/ref 17592186045417] [17592186172308 #edb/ref 1069 "q-127070" #edb/ref 17592186045417] [17592186172308 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186172308 #edb/ref 1071 "According to the flux form of Green's theorem, the flux of the vector field \n$F(x,y)=⟨{x}^{2}+1,\\,{y}^{2}⟩$\nacross the triangle $C$ with vertices $(0,0),(1,0),$ and $(0,2)$ can be represented as\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}f(x,y)\\,\\text{d}A,\n$$\n\nwhere $C$ is traversed counterclockwise, $n$ is the outward-pointing unit normal vector to $C,$ and $D$ is the region bounded by $C.$ Calculate the function $f(x,y).$" #edb/ref 17592186045417] [17592186172308 #edb/ref 1072 #uuid "eeef3f59-4373-5478-9f71-3d8588687de5" #edb/ref 17592186045417] [17592186172308 #edb/ref 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\,\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n \n\n![](images/c3/c3c617522488e6ebf47dd2b2a52c43a1fe06ccaef8cd1e8752ab4df5e2d4bd64.png)\n\nWe have that $P(x,y)={x}^{2}+1$ and $Q(x,y)={y}^{2}.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2x,\\,\\frac{∂Q}{∂y} & =2y.\\end{aligned}\n$$\n\nTherefore, applying the flux form of Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2x+2y)\\,\\text{d}A \\\\  & ={∬}_{D}2(x+y)\\,\\text{d}A.\\end{aligned}\n$$\n\nHence, $f(x,y)=2(x+y).$" #edb/ref 17592186045417] [17592186173009 #edb/ref 1061 35835 #edb/ref 17592186045417] [17592186173009 #edb/ref 1062 #uuid "ff8c90c5-7280-517d-b629-b9fcf49eb545" #edb/ref 17592186045417] [17592186173009 #edb/ref 1063 #edb/ref 17592186172099 #edb/ref 17592186045417] [17592186173010 #edb/ref 1058 #edb/ref 17592186173011 #edb/ref 17592186045417] [17592186173010 #edb/ref 1061 35836 #edb/ref 17592186045417] [17592186173010 #edb/ref 1062 #uuid "176aba1b-a4f1-53bf-b585-f21efd3b5ea7" #edb/ref 17592186045417] [17592186173010 #edb/ref 1063 #edb/ref 17592186172100 #edb/ref 17592186045417] [17592186173011 #edb/ref 1058 #edb/ref 17592186173009 #edb/ref 17592186045417] [17592186173011 #edb/ref 1061 35837 #edb/ref 17592186045417] [17592186173011 #edb/ref 1062 #uuid "b533c8b3-90f2-54ee-ae35-a98929d6ba6e" #edb/ref 17592186045417] [17592186173011 #edb/ref 1063 #edb/ref 17592186172101 #edb/ref 17592186045417] [17592186173012 #edb/ref 1058 #edb/ref 17592186173010 #edb/ref 17592186045417] [17592186173012 #edb/ref 1061 35877 #edb/ref 17592186045417] [17592186173012 #edb/ref 1062 #uuid "e5c29654-0b83-51e0-a3d0-c6fbf08c8f2d" #edb/ref 17592186045417] [17592186173012 #edb/ref 1063 #edb/ref 17592186173207 #edb/ref 17592186045417] [17592186173013 #edb/ref 1058 #edb/ref 17592186173012 #edb/ref 17592186045417] [17592186173013 #edb/ref 1061 35900 #edb/ref 17592186045417] [17592186173013 #edb/ref 1062 #uuid "528120c2-edf7-5b3d-a8d3-0b481b460d90" #edb/ref 17592186045417] [17592186173013 #edb/ref 1063 #edb/ref 17592186173208 #edb/ref 17592186045417] [17592186173207 #edb/ref 1064 "There is some nice intuition behind the flux form of Green's theorem that makes it easier to remember.\n\nSuppose that $\\mathbf F$ is a vector field on $\\mathbb R^2$ with component functions $P$ and $Q$ defined over a region $D.$ So, we have\n\n$$\n\\mathbf F(x,y) = P(x,y)\\,\\mathbf i + Q(x,y)\\,\\mathbf j.\n$$\n\nGreen's theorem in flux form states that the sum of the microscopic \"fluxes\" (divergences) of $\\mathbf F$ inside $D$ equals the macroscopic flux of $\\mathbf F$ across the boundary of $D.$\n\n![](images/47/47a81125069be94b4ccda6f228ff1b8253f99595c6f3c4ae0ca710bdb796215f.png)\n\n    \n\nRecall that the divergence (i.e., the microscopic flux) of $\\mathbf F$ at a point is given by\n\n$$\n\\textrm{div}\\,\\mathbf F = \\nabla \\cdot \\mathbf F = \\dfrac{\\partial P }{\\partial x} + \\dfrac{\\partial Q }{\\partial y}.\n$$\n\nIf we sum (integrate) the divergence at every point over the entire domain $D,$ we get\n\n$$\n\\iint\\limits_D \\left( \\dfrac{\\partial P }{\\partial x} + \\dfrac{\\partial Q }{\\partial y} \\right)\\textrm d A.\n$$\n\nThis expression gives us one side of Green's theorem in flux form.\n\nThe macroscopic divergence is simply the flux of $\\mathbf F$ across the boundary of $D{:}$\n\n$$\n\\oint\\limits_C\\mathbf F\\cdot \\mathbf n \\, \\textrm d s\n$$\n\nEquating the sum of the divergences with the flux, we have\n\n$$\n\\iint\\limits_D \\left( \\dfrac{\\partial P }{\\partial x} + \\dfrac{\\partial Q }{\\partial y} \\right)\\textrm d A = \\oint\\limits_C\\mathbf F\\cdot \\mathbf n \\, \\textrm d s.\n$$\n\nThe flux form of Green's theorem can be summarized in a single picture, as follows:\n\n![](images/0f/0f8ba4b7e853e3b59e8677b0954c3cfae1b9c482750e13a742bd4d45eda8005d.png)" #edb/ref 17592186045417] [17592186173207 #edb/ref 1065 5862 #edb/ref 17592186045417] [17592186173207 #edb/ref 1066 #uuid "9016229b-93aa-58fc-857c-2a2d3f337ca4" #edb/ref 17592186045417] [17592186173207 #edb/ref 1067 "Intuition Behind Green's Theorem in Flux Form" #edb/ref 17592186045417] [17592186173208 #edb/ref 1064 "Green's theorem allows us to write line integrals as double integrals, and we've seen how Green's theorem simplifies circulation calculations. Even more, Green's theorem can also be used to simplify flux calculations!\n\nTo see how, we first recall that the flux of $\\mathbf{F}(x,y) =  P(x,y)\\,\\mathbf i + Q(x,y)\\mathbf j$ across $C$ can be calculated as follows:\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s= \\oint\\limits_C P\\, \\textrm{d}y -Q\\, \\textrm{d}x\n$$\n\nwhere $C$ is closed and $\\mathbf n$ is the outward-pointing unit normal vector to $C.$\n\nNow, let's set $M= -Q$ and $N=P$. Then, by the circulation form of Green's theorem, we have\n\n$$\n\\begin{aligned}{∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x & ={∮}_{C}N\\,\\text{d}y+M\\,\\text{d}x \\\\  & ={∮}_{C}M\\,\\text{d}x+N\\,\\text{d}y \\\\  & ={∬}_{D}(\\frac{∂N}{∂x}-\\frac{∂M}{∂y})\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}-(-\\frac{∂Q}{∂y}))\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\\end{aligned}\n$$\n\nAs a result, we've obtained the **Green's theorem in flux form**, which we restate below:\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\iint\\limits_D \\left(\\dfrac{\\partial P }{\\partial x} +\\dfrac{\\partial  Q}{\\partial y}\\right)\\textrm d A\n$$\n\nNow, recall that the divergence of $\\mathbf F$ is given by\n\n$$\n\\textrm{div}\\,\\mathbf F =  \\dfrac{\\partial P }{\\partial x} + \\dfrac{\\partial Q }{\\partial y}.\n$$\n\nTherefore, we can also write Green's theorem in flux form as\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\iint\\limits_D \\textrm{div}\\,\\mathbf F\\,\\textrm{d}A.\n$$\n\nGreen's theorem in flux form allows us to convert a flux line integral into an equivalent double integral." #edb/ref 17592186045417] [17592186173208 #edb/ref 1065 5868 #edb/ref 17592186045417] [17592186173208 #edb/ref 1066 #uuid "7f3b4b70-8b58-53d1-bc8d-a42daddfab4d" #edb/ref 17592186045417] [17592186173208 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186424443 #edb/ref 1080 "8" #edb/ref 17592186045417] [17592186424443 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186424443 #edb/ref 1083 #uuid "036be383-69ad-5c54-97f4-245cc64ebdc5" #edb/ref 17592186045417] [17592186424444 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186424444 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186424444 #edb/ref 1083 #uuid "072b4d5b-a518-50b1-9fd5-372915316f5c" #edb/ref 17592186045417] [17592186424445 #edb/ref 1080 "5{e}^{2}" #edb/ref 17592186045417] [17592186424445 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186424445 #edb/ref 1083 #uuid "091bc970-fa77-5e71-85b9-f1ab8c6a0482" #edb/ref 17592186045417] [17592186424446 #edb/ref 1080 "\\frac{3}{2}" #edb/ref 17592186045417] [17592186424446 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186424446 #edb/ref 1083 #uuid "1afc0e4b-7ec3-5e04-a320-b09bbb7450d5" #edb/ref 17592186045417] [17592186424447 #edb/ref 1080 "2{x}^{3}-3{y}^{2}" #ed