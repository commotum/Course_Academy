d #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168693}] :question/id #uuid "e7800f0b-56af-56c9-9f5d-febc0c902fbd" :question/math-academy-id "q-126817" :question/problem "Use the flux form of Green's theorem to calculate the flux of the vector field\n$F(x, y) = ⟨x^{2} + 2y, x^{2} + 2xy⟩$\nthrough the boundary of the region enclosed by the curve $y = x^{2}$ and the lines $y = 0$ and $x = 1$."}] [{:db/id #edb/ref 17592186172307 :knowledge-point/_questions [{:db/id #edb/ref 17592186172101 :knowledge-point/id #uuid "f2a418f9-b4da-53b4-a39c-75d28dfa8595" :knowledge-point/title "Calculating Flux Across Rectangles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d24203b1-5e2d-543b-b875-84082292041c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186168706} {:answer/id #uuid "12450fac-5904-57a0-92e2-bc8a3468008b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186168707} {:answer/id #uuid "23c8d906-57d9-5dfc-98ed-afb30ba1cec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186168708} {:answer/id #uuid "58920047-051c-5179-a311-88f110077114" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186168709} {:answer/id #uuid "5d55495b-d3c0-5a44-b16e-2735230596b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186168710}] :answer-field/id #uuid "744dba16-b85d-5809-875d-1211f267487f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168705}] :question/id #uuid "ceef6c7e-683c-550f-97a1-9156380979d7" :question/math-academy-id "q-126821" :question/problem "Use the flux form of Green's theorem to calculate the flux of the vector field\n$F(x, y) = ⟨\\cos (πy) - x^{2}, \\sin (πx) + 2y⟩$\nthrough the boundary of the square $0 \\le x \\le 1, 0 \\le y \\le 1$."}] [{:db/id #edb/ref 17592186172308 :knowledge-point/_questions [{:db/id #edb/ref 17592186172100 :knowledge-point/id #uuid "d5c7e707-c978-566d-8a69-98c84c7eb53e" :knowledge-point/title "Expressing Flux as a Double Integral Using Green's Theorem in Flux Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92524a07-a3e1-5079-a783-a2c3939a0144" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(x - y)" :db/id #edb/ref 17592186168712} {:answer/id #uuid "0e61397f-92af-5d0d-b6d9-a91fcccf055b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(x + y)" :db/id #edb/ref 17592186168713} {:answer/id #uuid "1cfac84a-5548-5538-b921-90b81934181d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}(x^{2} + y^{2})" :db/id #edb/ref 17592186168714} {:answer/id #uuid "64e84502-cab6-5b40-ac60-48ec2879b68c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(y - x)" :db/id #edb/ref 17592186168715} {:answer/id #uuid "6802eb91-025c-5c5c-abc5-05ce7e442b6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}(x^{2} - y^{2})" :db/id #edb/ref 17592186168716}] :answer-field/id #uuid "6725b75c-c66c-52af-8566-302236c9d990" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168711}] :question/id #uuid "eeef3f59-4373-5478-9f71-3d8588687de5" :question/math-academy-id "q-127070" :question/problem "According to the flux form of Green's theorem, the flux of the vector field\n$F(x, y) = ⟨x^{2} + 1, y^{2}⟩$\nacross the triangle $C$ with vertices $(0, 0), (1, 0)$, and $(0, 2)$ can be represented as\n\n$∮_(C)F \\cdot nds = ∬_(D)f(x, y)dA$,\n\nwhere $C$ is traversed counterclockwise, $n$ is the outward-pointing unit normal vector to $C$, and $D$ is the region bounded by $C$. Calculate the function $f(x, y)$."}]}
