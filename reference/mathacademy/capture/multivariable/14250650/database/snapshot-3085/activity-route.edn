#{[{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186571493} :activity/id #uuid "6a557ca9-7a93-510a-b204-bd1296cf335a" :activity/scope {:db/id #edb/ref 17592186050159 :topic/id #uuid "32cf9e59-1dd8-51df-b1af-51ac52d78285" :topic/math-academy-id 415} :activity/steps [{:db/id #edb/ref 17592186571492 :step/content {:db/id #edb/ref 17592186571395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ba3a988-67bf-5829-9981-f9cf880f3bc3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\pi }{9}" :db/id #edb/ref 17592186570981} {:answer/id #uuid "cbad17f3-9c38-537a-bdd3-f2e9cbdf9adc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186571204} {:answer/id #uuid "cc3700c5-3cd8-53dd-ad0e-aa6f7f89811e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186571205} {:answer/id #uuid "ccecad03-8fcd-507c-9d96-5c67bc77b34c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186571207} {:answer/id #uuid "fd2f37a3-ca1f-5389-9d5a-ce4762cbcf9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186571276}] :answer-field/correct {:db/id #edb/ref 17592186571204} :answer-field/id #uuid "ecddd1b8-00da-5bd7-a5d9-f8af1c70264b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571370}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4f112823-f777-5f74-ab7d-687fcdb73828" :question/math-academy-id "q-105740" :question/problem "Consider the finite region bounded by the curve $x=5{y}^{3}-5{y}^{4}$ and the $y$-axis. Calculate the volume of the solid generated when this region is rotated $2\\pi$ radians about the $x$-axis." :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}5{y}^{3}-5{y}^{4} & =0 \\\\ 5{y}^{3}(1-y) & =0\\end{aligned}\n$$\n\nThe solutions are $y=0$ and $y=1.$ So, we need to integrate from $y=0$ to $y=1.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1}y(5{y}^{3}-5{y}^{4})\\text{d}y \\\\  & =10\\pi {\\int }_{0}^{1}({y}^{4}-{y}^{5})\\text{d}y \\\\  & =10\\pi ({\\int }_{0}^{1}{y}^{4}\\,\\text{d}y-{\\int }_{0}^{1}{y}^{5}\\text{d}y) \\\\  & =10\\pi ({\\frac{{y}^{5}}{5}|}_{0}^{1}-{\\frac{{y}^{6}}{6}|}_{0}^{1}) \\\\  & =10\\pi ((\\frac{1}{5}-0)-(\\frac{1}{6}-0)) \\\\  & =10\\pi (\\frac{1}{5}-\\frac{1}{6}) \\\\  & =\\frac{\\pi }{3}\\end{aligned}\n$$"} :step/id #uuid "8d03fea6-c5c4-5d31-b587-b42678eb1cd0" :step/next {:db/id #edb/ref 17592186571520}} {:db/id #edb/ref 17592186571493 :step/content {:db/id #edb/ref 17592186571430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67cd5b99-2c08-5337-96e7-18e6ea444e4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{0}^{\\sqrt{3}}{(3{y}^{2}-{y}^{3})}^{2}\\text{d}y" :db/id #edb/ref 17592186571051} {:answer/id #uuid "a0817336-df3b-51ab-9ac0-700055776676" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{0}^{3}{(3{y}^{2}-{y}^{3})}^{2}\\text{d}y" :db/id #edb/ref 17592186571140} {:answer/id #uuid "ab5dea82-8e37-5384-b0e3-ed2d52489c88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi {\\int }_{0}^{\\sqrt{3}}y(3{y}^{2}-{y}^{3})\\text{d}y" :db/id #edb/ref 17592186571159} {:answer/id #uuid "b12bb577-b2fe-5bd1-84d4-8ff76cc692d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi {\\int }_{0}^{3}y(3{y}^{2}-{y}^{3})\\text{d}y" :db/id #edb/ref 17592186571165} {:answer/id #uuid "d8e3fabf-7ba9-566c-ae98-17b03c9b1228" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi {\\int }_{0}^{3}(3{y}^{2}-{y}^{3})\\text{d}y" :db/id #edb/ref 17592186571226}] :answer-field/correct {:db/id #edb/ref 17592186571165} :answer-field/id #uuid "edb95141-3ad9-54ec-a8b4-67b0e62cf950" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571371}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9e08ef03-042b-5ef4-bd8e-13473edc79ae" :question/math-academy-id "q-105677" :question/problem "![](images/af/af0f21f914c1a773cf80ba80a43547a382a1bf4007b1916cca8ce90f6b2d15b2.png)\n\nConsider the finite region bounded by the curve $x=3{y}^{2}-{y}^{3}$ and the $y$-axis, as shown above. What integral gives the volume of the solid generated when that region is rotated $2\\pi$ radians about the $x$-axis?" :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}3{y}^{2}-{y}^{3} & =0 \\\\ {y}^{2}(3-y) & =0\\end{aligned}\n$$\n\nThe solutions are $y=0,\\,3.$ So, we need to integrate from $y=0$ to $y=3.$ \n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{3}y(3{y}^{2}-{y}^{3})\\text{d}y\\end{aligned}\n$$"} :step/id #uuid "8e96fcaf-3825-5afc-b540-f2f106da0fb4" :step/next {:db/id #edb/ref 17592186571508}} {:db/id #edb/ref 17592186571499 :step/content {:db/id #edb/ref 17592186571419 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2063900e-a5bb-505d-a56c-ffbb8015f598" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{27\\pi }{6\\,250}" :db/id #edb/ref 17592186570937} {:answer/id #uuid "25ba7a39-0faa-584a-b636-d552b75ef30c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6\\,250}" :db/id #edb/ref 17592186570948} {:answer/id #uuid "a1b348ee-b44b-559b-ab92-6aec9c390e36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi }{6\\,250}" :db/id #edb/ref 17592186571143} {:answer/id #uuid "bbd3c117-dfc5-5139-9f10-1f99cce8bfa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9\\pi }{3\\,125}" :db/id #edb/ref 17592186571180} {:answer/id #uuid "fbbb14af-13a9-556e-b543-a0172a174ca6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3\\,125}" :db/id #edb/ref 17592186571274}] :answer-field/correct {:db/id #edb/ref 17592186570948} :answer-field/id #uuid "7a83f496-fbd8-5701-a047-62d0e562d2fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571330}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8025abae-d2ce-537b-9664-a4fb5d59e410" :question/math-academy-id "q-126114" :question/problem "Consider the finite region bounded by the curve $x={y}^{2}-5{y}^{3}$ and the $y$-axis. Calculate the volume of the solid generated when this region is rotated $2\\pi$ radians about the $x$-axis." :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}{y}^{2}-5{y}^{3} & =0 \\\\ {y}^{2}(1-5y) & =0\\end{aligned}\n$$\n\nThe solutions are $y=0$ and $y=\\frac{1}{5}.$ So, we need to integrate from $y=0$ to $y=\\frac{1}{5}.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1/5}y({y}^{2}-5{y}^{3})\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1/5}({y}^{3}-5{y}^{4})\\text{d}y \\\\  & =2\\pi ({\\frac{{y}^{4}}{4}|}_{0}^{1/5}-5\\cdot {\\frac{{y}^{5}}{5}|}_{0}^{1/5}) \\\\  & =2\\pi (\\frac{1}{4\\cdot {5}^{4}}-\\frac{1}{{5}^{5}}) \\\\  & =\\frac{2\\pi }{{5}^{4}}(\\frac{1}{4}-\\frac{1}{5}) \\\\  & =\\frac{2\\pi }{20\\cdot {5}^{4}} \\\\  & =\\frac{\\pi }{6\\,250}\\end{aligned}\n$$"} :step/id #uuid "c08bf546-3c9a-5b7a-b09e-fceefa06f284"} {:db/id #edb/ref 17592186571508 :step/content {:db/id #edb/ref 17592186571417 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22968325-f0bc-5a5e-afd8-7899db95af90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{0}^{\\sqrt{2}}{(2{y}^{3}-{y}^{4})}^{2}\\text{d}y" :db/id #edb/ref 17592186570940} {:answer/id #uuid "53062cc0-a982-5374-a7a2-4902d13970e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{0}^{2}{(2{y}^{3}-{y}^{4})}^{2}\\text{d}y" :db/id #edb/ref 17592186571017} {:answer/id #uuid "5bba9e90-64fa-5409-8ec7-36b4fabd173f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi {\\int }_{0}^{2}(2{y}^{3}-{y}^{4})\\text{d}y" :db/id #edb/ref 17592186571036} {:answer/id #uuid "954a8d5d-1191-5868-9419-c6d80134e700" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi {\\int }_{0}^{2}y(2{y}^{3}-{y}^{4})\\text{d}y" :db/id #edb/ref 17592186571124} {:answer/id #uuid "e773a89d-eef5-5433-b270-7313a2f284de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi {\\int }_{0}^{\\sqrt{2}}y(2{y}^{3}-{y}^{4})\\text{d}y" :db/id #edb/ref 17592186571252}] :answer-field/correct {:db/id #edb/ref 17592186571124} :answer-field/id #uuid "d9256cfa-3a8e-5a21-89fd-ea3ec6a4be6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571365}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7b1c2b26-9aae-5367-9691-64e9ca75fb9b" :question/math-academy-id "q-105679" :question/problem "Consider the finite region bounded by the curve $x=2{y}^{3}-{y}^{4}$ and the $y$-axis. What integral gives the volume of the solid generated when that region is rotated $2\\pi$ radians about the $x$-axis?" :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}2{y}^{3}-{y}^{4} & =0 \\\\ {y}^{3}(2-y) & =0\\end{aligned}\n$$\n\nThe solutions are $y=0,\\,2.$ So, we need to integrate from $y=0$ to $y=2.$ \n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{2}y(2{y}^{3}-{y}^{4})\\text{d}y\\end{aligned}\n$$"} :step/id #uuid "d6e843e1-379e-5dab-ac11-b1d60046f2d5" :step/next {:db/id #edb/ref 17592186571492}} {:db/id #edb/ref 17592186571520 :step/content {:db/id #edb/ref 17592186571377 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "050b1a2d-390a-5cca-ba66-abe1a81fc0b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi {\\int }_{0}^{4}y(-8+6y-{y}^{2})\\text{d}y" :db/id #edb/ref 17592186570899} {:answer/id #uuid "7a3ccc49-8996-5d4a-bf7f-39d68a647521" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi {\\int }_{2}^{4}y(-8+6y-{y}^{2})\\text{d}y" :db/id #edb/ref 17592186571081} {:answer/id #uuid "95e473b2-f5c4-5b02-ae5a-5c17d81d6906" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{2}^{4}{(-8+6y-{y}^{2})}^{2}\\text{d}y" :db/id #edb/ref 17592186571127} {:answer/id #uuid "e4502299-a253-55a2-aafe-cef6f38bdf90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi {\\int }_{2}^{4}(-8+6y-{y}^{2})\\text{d}y" :db/id #edb/ref 17592186571246} {:answer/id #uuid "f670e967-be71-5966-bb43-e648c3783902" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi {\\int }_{0}^{4}{(-8+6y-{y}^{2})}^{2}\\text{d}y" :db/id #edb/ref 17592186571261}] :answer-field/correct {:db/id #edb/ref 17592186571081} :answer-field/id #uuid "4d3ed104-ec6c-5ae1-a397-51e099e513ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186571314}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0342016a-166b-5391-a2e8-8b20bd450fa2" :question/math-academy-id "q-126104" :question/problem "Consider the finite region bounded by the curve $x=-8+6y-{y}^{2}$ and the $y$-axis. What integral gives the volume of the solid generated when that region is rotated $2\\pi$ radians about the $x$-axis?" :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}-8+6y-{y}^{2} & =0 \\\\ {y}^{2}-6y+8 & =0 \\\\ (y-2)(y-4) & =0\\end{aligned}\n$$\n\nThe solutions are $y=2$ and $y=4.$ So, we need to integrate from $y=2$ to $y=4.$\n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{2}^{4}y(-8+6y-{y}^{2})\\text{d}y\\end{aligned}\n$$"} :step/id #uuid "ff168382-b5a6-589b-a738-530a2fb9b146" :step/next {:db/id #edb/ref 17592186571499}}] :activity/title "The Shell Method: Rotating a Region About the X-Axis" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186570883}]}
