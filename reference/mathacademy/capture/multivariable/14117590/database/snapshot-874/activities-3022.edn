#{[{:activity/first-step {:db/id #edb/ref 17592186163007} :activity/id #uuid "fa26629c-b4dd-57db-9661-3b43692ea236" :activity/scope {:db/id #edb/ref 17592186050535 :topic/id #uuid "51d67380-dd70-5f91-a192-de8ab2b56b57" :topic/math-academy-id 3022} :activity/steps [{:db/id #edb/ref 17592186163007 :step/content {:db/id #edb/ref 17592186163291 :tutorial/content "We can easily extend the notion of conditional probability distributions for discrete random variables to continuous random variables.\n\nFor continuous random variables $X$ and $Y$, the **conditional probability density function of $X$ given $Y = y$** is given by\n\n$$\nf_{X \\mid Y} (x \\mid y) =\\dfrac{f(x, y)}{f_Y (y)}, \\qquad f_Y(y) \\neq 0\n$$\n\nand the conditional probability density function of $Y$ given $X = x$ is given by\n\n$$\nf_{Y \\mid X} (y \\mid x) =\\dfrac{f(x, y)}{f_X (x)}, \\qquad f_X(x) \\neq 0\n$$\n\nNotice that these definitions are analogous to those for discrete random variables.\n\nTo compute probabilities, we work directly with these conditional PDFs. For example, to calculate the **conditional probability of $X$ given $Y$,** we use\n\n$$\nP(X \\in A \\mid Y = y) =\\int_A f_{X \\mid Y} (x \\mid y)\\, \\textrm dx\n$$\n\nIn general, the conditional distribution of $X$ given $Y$ does not equal the conditional distribution of $Y$ given $X$. That is\n\n$$\nf_{X\\mid Y}(x \\mid y) \\ne f_{Y\\mid X}(y \\mid x)\n$$\n\nFinally, if $X$ and $Y$ are independent, then\n\n$$\nf_{X\\mid Y}(x \\mid y)=f_X(x),\\qquad f_{Y\\mid X}(y \\mid x)=f_Y(y)\n$$" :tutorial/id #uuid "4e66c559-ad43-5152-a04e-7aa8b01374ef" :tutorial/math-academy-id 5625 :tutorial/title "Introduction"} :step/id #uuid "cc469a65-06a8-5cb9-9eed-1c3d9f00c4c2" :step/math-academy-id 34590 :step/next {:db/id #edb/ref 17592186163078}} {:db/id #edb/ref 17592186163078 :step/content {:db/id #edb/ref 17592186162112 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161678 :question/id #uuid "29e739b1-8745-517f-9011-d1761364c4c3" :question/math-academy-id "e-10099"} :knowledge-point/id #uuid "444ad045-3c7b-5668-bc3a-e3cb49a5b6f2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049149} {:db/id #edb/ref 17592186049553}] :knowledge-point/questions [{:db/id #edb/ref 17592186162389} {:db/id #edb/ref 17592186162393}] :knowledge-point/title "Working With the Definition of a Conditional PDF"} :step/id #uuid "5d645e06-ba3d-5245-bff3-396e4a4a04e4" :step/math-academy-id 38091 :step/next {:db/id #edb/ref 17592186163080}} {:db/id #edb/ref 17592186163079 :step/content {:db/id #edb/ref 17592186162113 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161679 :question/id #uuid "3439786b-905b-5642-89d1-61b0345f79e6" :question/math-academy-id "e-10100"} :knowledge-point/id #uuid "184d9e09-3335-5617-8989-e5ab08ca04e7" :knowledge-point/questions [{:db/id #edb/ref 17592186162391} {:db/id #edb/ref 17592186162392} {:db/id #edb/ref 17592186411871}] :knowledge-point/title "Computing a Conditional Probability"} :step/id #uuid "f08e3c7b-ff47-5108-9d4d-3471aa625605" :step/math-academy-id 38092} {:db/id #edb/ref 17592186163080 :step/content {:db/id #edb/ref 17592186162114 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161680 :question/id #uuid "f1c9e136-57b3-59ae-90e0-b28921be44ee" :question/math-academy-id "e-10101"} :knowledge-point/id #uuid "eb3b4b6a-3a24-5079-bf33-ed1c5576ffa7" :knowledge-point/questions [{:db/id #edb/ref 17592186162390} {:db/id #edb/ref 17592186162396}] :knowledge-point/title "Finding a Conditional PDF"} :step/id #uuid "ccc00629-902d-501f-86c2-7072c1aad6a6" :step/math-academy-id 38093 :step/next {:db/id #edb/ref 17592186163079}}] :activity/title "Conditional Distributions for Continuous Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162176}]}
