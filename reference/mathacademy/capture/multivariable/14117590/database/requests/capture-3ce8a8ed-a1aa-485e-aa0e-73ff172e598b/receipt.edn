34187 17592186045417 true] [17592186413413 1076 #edb/ref 17592186045493 13194139534187 17592186045417 true] [17592186413413 1077 "selection" 13194139534187 17592186045417 true] [17592186413413 1078 #edb/ref 17592186413404 13194139534187 17592186045417 true] [17592186413413 1079 #uuid "7133b6f3-994d-586b-8bc7-52facdb8edd3" 13194139534187 17592186045417 true] [17592186413414 1075 #edb/ref 17592186413397 13194139534187 17592186045417 true] [17592186413414 1075 #edb/ref 17592186413398 13194139534187 17592186045417 true] [17592186413414 1075 #edb/ref 17592186413399 13194139534187 17592186045417 true] [17592186413414 1075 #edb/ref 17592186413401 13194139534187 17592186045417 true] [17592186413414 1075 #edb/ref 17592186413407 13194139534187 17592186045417 true] [17592186413414 1076 #edb/ref 17592186045493 13194139534187 17592186045417 true] [17592186413414 1077 "selection" 13194139534187 17592186045417 true] [17592186413414 1078 #edb/ref 17592186413398 13194139534187 17592186045417 true] [17592186413414 1079 #uuid "76914fbd-7e46-5e1e-a2ea-82b62a7c5f3c" 13194139534187 17592186045417 true] [17592186413415 1068 #edb/ref 17592186413414 13194139534187 17592186045417 true] [17592186413415 1069 "q-143574" 13194139534187 17592186045417 true] [17592186413415 1070 #edb/ref 17592186045486 13194139534187 17592186045417 true] [17592186413415 1071 "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)={\\begin{aligned}8xy, & \\,0\\le x\\le y,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nFind $P(\\frac{1}{4}<X<\\frac{1}{2}\\,|\\,Y=\\frac{2}{3}).$" 13194139534187 17592186045417 true] [17592186413415 1072 #uuid "6fd86b7a-aa64-5ea3-a90b-7af5da2353f8" 13194139534187 17592186045417 true] [17592186413415 1074 "Recall that \n\n$$\nP(Y\\in A\\,|\\,X=x)={\\int }_{A}{f}_{X\\,|\\,Y}(x\\,|\\,y)\\,\\text{d}y,\n$$\n\nwhere ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ is the conditional probability density function of $X$ given $Y=y.$ \n\nUsing the formula for the marginal density function for $Y,$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{y}8xy\\,\\text{d}x \\\\  & =8y{\\int }_{0}^{y}x\\,\\text{d}x \\\\  & =8y{[\\frac{1}{2}{x}^{2}]}_{0}^{y} \\\\  & =4y({y}^{2}-0) \\\\  & =4{y}^{3}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)={\\begin{aligned}4{y}^{3}, & \\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $0\\le x\\le 1,0\\le y\\le x,$ we have\n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{8xy}{4{y}^{3}} \\\\  & =\\frac{2x}{{y}^{2}}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)={\\begin{aligned}\\frac{2x}{{y}^{2}}, & \\,0\\le x\\le y,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFinally, we compute our probability:\n\n$$\n\\begin{aligned}P(\\frac{1}{4}<X<\\frac{1}{2}\\,|\\,Y=\\frac{2}{3}) & ={\\int }_{1/4}^{1/2}{f}_{X\\,|\\,Y}(x\\,|\\,y=\\frac{2}{3})\\text{d}x \\\\  & ={\\int }_{1/4}^{1/2}\\frac{2x}{{(\\frac{2}{3})}^{2}}\\,\\text{d}x \\\\  & =\\frac{9}{4}{\\int }_{1/4}^{1/2}2x\\,\\text{d}x \\\\  & =\\frac{9}{4}{[{x}^{2}]}_{1/4}^{1/2} \\\\  & =\\frac{9}{4}(\\frac{1}{4}-\\frac{1}{16}) \\\\  & =\\frac{9}{4}(\\frac{3}{16}) \\\\  & =\\frac{27}{64}.\\end{aligned}\n$$" 13194139534187 17592186045417 true] [17592186413416 1058 #edb/ref 17592186413417 13194139534187 17592186045417 true] [17592186413416 1062 #uuid "9476e3d9-7d05-54ea-ba2e-44132f1512b5" 13194139534187 17592186045417 true] [17592186413416 1063 #edb/ref 17592186413415 13194139534187 17592186045417 true] [17592186413417 1062 #uuid "a4e2ce8c-ef99-5939-91ca-5637d283ed7e" 13194139534187 17592186045417 true] [17592186413417 1063 #edb/ref 17592186162396 13194139534187 17592186045417 true] [17592186413418 1058 #edb/ref 17592186413416 13194139534187 17592186045417 true] [17592186413418 1062 #uuid "cd604f93-e377-5bb5-97aa-db0cfd4f422a" 13194139534187 17592186045417 true] [17592186413418 1063 #edb/ref 17592186162392 13194139534187 17592186045417 true]] :edb/tempids {"activity-8d71dbb8-3f6b-51a3-b4b2-a5b2c8b23a9b" 17592186413396 "answer-0232ff5b-0d05-5778-88a0-ff0af66fc111" 17592186413397 "answer-0d7ebaa8-7f99-5427-8a2f-237d9f6e4410" 17592186413398 "answer-291ffaa1-af34-572c-8208-632d599387b4" 17592186413399 "answer-2b4b973f-cb9d-5e7e-8beb-4c556f2b875c" 17592186413400 "answer-2bab8694-81fe-5f61-ab63-c2f3224466f2" 17592186413401 "answer-6a95ee3c-3035-5909-a68e-b2eac9893340" 17592186413402 "answer-726964d4-b990-596e-9009-e83d6d208a25" 17592186413403 "answer-76dedc47-c082-5f11-bb91-f5c53a5feef0" 17592186413404 "answer-b6e703b0-4bd0-5a40-af83-db0c989a5aba" 17592186413405 "answer-b7e4876d-bca4-5991-b345-bf1e1f8f35e9" 17592186413406 "answer-cb999cce-827d-57cd-aed2-f09c922819e1" 17592186413407 "answer-db303bfa-69cf-5cf1-86a5-b4a2624334a1" 17592186413408 "answer-e77674d9-5e17-517e-8f5b-956421030e91" 17592186413409 "answer-efd7c23f-d7a0-5417-baaf-c56cd1849f93" 17592186413410 "answer-fcf61311-9fef-553a-a566-6bcfee2063e1" 17592186413411 "answer-field-2b4844fd-48c8-5187-86c9-fcbf91d0bc32" 17592186413412 "answer-field-7133b6f3-994d-586b-8bc7-52facdb8edd3" 17592186413413 "answer-field-76914fbd-7e46-5e1e-a2ea-82b62a7c5f3c" 17592186413414 "question-6fd86b7a-aa64-5ea3-a90b-7af5da2353f8" 17592186413415 "step-9476e3d9-7d05-54ea-ba2e-