#{[{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186548142} :activity/id #uuid "214227dc-fd64-5b29-a98a-53e4687a838c" :activity/scope {:db/id #edb/ref 17592186048976 :topic/id #uuid "d0827a60-1270-5e75-a5db-1a9836dc00b1" :topic/math-academy-id 1079} :activity/steps [{:db/id #edb/ref 17592186548101 :step/content {:db/id #edb/ref 17592186548076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00674e18-ee02-59cd-b3dc-a6f698a1d859" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4\\operatorname{ln}⁡2}\\,\\text{m/s}" :db/id #edb/ref 17592186547317} {:answer/id #uuid "89c053ae-f87b-53b5-b9ff-dddaf3e41c2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2\\operatorname{ln}⁡2}\\,\\text{m/s}" :db/id #edb/ref 17592186547615} {:answer/id #uuid "8fea7db7-de80-5d17-aee5-ba303c413efc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{8\\operatorname{ln}⁡2}\\,\\text{m/s}" :db/id #edb/ref 17592186547636} {:answer/id #uuid "910d3bad-81e3-5314-864f-7990eaa9b236" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}\\,\\text{m/s}" :db/id #edb/ref 17592186547640} {:answer/id #uuid "a5081cba-4b6f-5bf9-b175-aba9c3e125ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{8}\\,\\text{m/s}" :db/id #edb/ref 17592186547678}] :answer-field/correct {:db/id #edb/ref 17592186547317} :answer-field/id #uuid "7d349dd1-b5a9-5935-ae21-26e3ea46f260" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547905}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f371caa1-75a3-5280-8f9d-dfa2d56f63d8" :question/math-academy-id "q-83246" :question/problem "A golden eagle is moving in a straight line with a velocity of $v(t)=\\frac{{2}^{t}}{12}\\,\\text{m/s},$ where $t$ is the time in seconds. Find the average velocity of the golden eagle on the interval $[2,6].$" :question/worked-solution "To calculate the average value of the velocity on $[{t}_{1},{t}_{2}],$ we use the average value formula\n\n$$\n{v}_{\\text{avg}}=\\frac{1}{{t}_{2}-{t}_{1}}{\\int }_{{t}_{1}}^{{t}_{2}}v(t)\\,\\text{d}t.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}{v}_{\\text{avg}} & =\\frac{1}{6-2}\\,{\\int }_{2}^{6}(\\frac{{2}^{t}}{12})\\text{d}t \\\\  & =\\frac{1}{4\\cdot 12\\cdot \\operatorname{ln}⁡2}({2}^{t}){|}_{2}^{6} \\\\  & =\\frac{1}{48\\operatorname{ln}⁡2}({2}^{6}-{2}^{2}) \\\\  & =\\frac{60}{48\\operatorname{ln}⁡2} \\\\  & =\\frac{5}{4\\operatorname{ln}⁡2}.\\end{aligned}\n$$\n\nTherefore, the average velocity is $\\frac{5}{4\\operatorname{ln}⁡2}\\,\\text{m/s}.$"} :step/id #uuid "4de83977-8c26-5f9c-9592-d123404947ae" :step/next {:db/id #edb/ref 17592186548187}} {:db/id #edb/ref 17592186548104 :step/content {:db/id #edb/ref 17592186548039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63c71e9a-e2a4-5acf-9c3f-1545635639b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186547535}] :answer-field/correct {:db/id #edb/ref 17592186547535} :answer-field/id #uuid "1fb540b7-e7ae-5a07-bd6e-28e04440e173" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186547858}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a7420375-7675-57fc-8640-9f218c433ea5" :question/math-academy-id "q-353947" :question/problem "A test cart moves in a straight line with velocity \n$v(t)=\\frac{3}{t},$ where $t$ is measured in seconds and $v$ is measured in feet per second.\n\nFind the average acceleration ${a}_{\\text{avg}}$ over the time interval $t\\in [1,3].$ Do not round your answer.\n\n${a}_{\\text{avg}}=$ \n{{field-1}}\n${\\text{ft/s}}^{2}$" :question/worked-solution "The average acceleration is the average rate of change of the velocity, so\n\n$$\n\\begin{aligned}{a}_{\\text{avg}} & =\\frac{v(3)-v(1)}{3-1} \\\\  & =\\frac{[\\frac{3}{3}]-[\\frac{3}{1}]}{2} \\\\  & =\\frac{1-3}{2} \\\\  & =\\frac{-2}{2} \\\\  & =-1\\,{\\text{ft/s}}^{2}.\\end{aligned}\n$$\n\nTherefore, the average acceleration is $-1\\,{\\text{ft/s}}^{2}.$"} :step/id #uuid "52a18bf8-46c8-55cc-86be-84ef4fc0b8e5"} {:db/id #edb/ref 17592186548111 :step/content {:db/id #edb/ref 17592186548075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37a3d483-228d-5bd2-9d7d-ce2ef8b4ae21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186547432}] :answer-field/correct {:db/id #edb/ref 17592186547432} :answer-field/id #uuid "4686715d-a18c-51be-a9b1-884139acad2f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186547877}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f05a5b67-91d9-5027-a739-e465c398f589" :question/math-academy-id "q-353941" :question/problem "A robotic sled moves along a straight track with velocity \n$v(t)={t}^{3}-t,$ where $t$ is measured in seconds and $v$ is measured in meters per second.\n\nFind the average acceleration ${a}_{\\text{avg}}$ over the time interval $t\\in [1,3].$ Do not round your answer.\n\n${a}_{\\text{avg}}=$ \n{{field-1}}\n${\\text{m/s}}^{2}$" :question/worked-solution "The average acceleration is the average rate of change of the velocity, so\n\n$$\n\\begin{aligned}{a}_{\\text{avg}} & =\\frac{v(b)-v(a)}{b-a} \\\\  & =\\frac{v(3)-v(1)}{3-1} \\\\  & =\\frac{[(3)^{3}-(3)]-[(1)^{3}-(1)]}{2} \\\\  & =\\frac{(27-3)-(1-1)}{2} \\\\  & =\\frac{24-0}{2} \\\\  & =\\frac{24}{2} \\\\  & =12\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$\n\nTherefore, the average acceleration is $12\\,{\\text{m/s}}^{2}.$"} :step/id #uuid "61e5473c-1f0c-5045-8fdc-52635fbe7581" :step/next {:db/id #edb/ref 17592186548104}} {:db/id #edb/ref 17592186548142 :step/content {:db/id #edb/ref 17592186548080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d1be747-8a94-5aed-aafa-3f8e379525df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2-\\sqrt{2}}{2}\\,\\text{m}" :db/id #edb/ref 17592186547374} {:answer/id #uuid "2bcb7040-6f3f-5555-bdad-85da6ddd1886" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\,\\text{m}" :db/id #edb/ref 17592186547401} {:answer/id #uuid "59823227-e905-5977-a5d2-bb84aa45354b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{8}\\,\\text{m}" :db/id #edb/ref 17592186547512} {:answer/id #uuid "a6c9df96-aec1-55e9-a6fa-579b1f853ec1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}\\,\\text{m}" :db/id #edb/ref 17592186547684} {:answer/id #uuid "e0fc4746-3be8-5122-9467-181003e3756b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{4}\\,\\text{m}" :db/id #edb/ref 17592186547784}] :answer-field/correct {:db/id #edb/ref 17592186547784} :answer-field/id #uuid "1f66651c-8f9c-52e6-9972-14e6f7d0c2a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547856}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fbeb0099-1c78-5b43-8e43-b8ec47f11368" :question/math-academy-id "q-50028" :question/problem "A fly’s position relative to a fixed origin $O$ is given by the function $x(t)=\\frac{t}{2}-\\frac{\\pi }{8}\\operatorname{sin}⁡(\\frac{\\pi }{8}t)\\,\\text{m},$ where $t$ is the time in minutes. Find its average position of the fly between $0$ and $2$ minutes." :question/worked-solution "To calculate the average value of the position on $[{t}_{1},{t}_{2}],$ we use the average value formula\n\n$$\n{x}_{\\text{avg}}=\\frac{1}{{t}_{2}-{t}_{1}}\\,{\\int }_{{t}_{1}}^{{t}_{2}}x(t)\\,\\text{d}t.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}{x}_{\\text{avg}} & =\\frac{1}{2-0}\\,{\\int }_{0}^{2}(\\frac{t}{2}-\\frac{\\pi }{8}\\operatorname{sin}⁡(\\frac{\\pi }{8}t))\\text{d}t \\\\  & =\\frac{1}{2}{(\\frac{{t}^{2}}{4}+\\operatorname{cos}⁡(\\frac{\\pi }{8}t))|}_{0}^{2} \\\\  & =\\frac{1}{2}((\\frac{{2}^{2}}{4}+\\operatorname{cos}⁡(\\frac{\\pi }{8}\\cdot 2))-(\\frac{{0}^{2}}{4}+\\operatorname{cos}⁡(\\frac{\\pi }{8}\\cdot 0))) \\\\  & =\\frac{1}{2}((1+\\frac{\\sqrt{2}}{2})-(0+1)) \\\\  & =\\frac{\\sqrt{2}}{4}.\\end{aligned}\n$$\n\nTherefore, the average position is $\\frac{\\sqrt{2}}{4}\\,\\text{m}.$"} :step/id #uuid "a39df73e-bba8-5942-8e42-4b6f03a5f8e7" :step/next {:db/id #edb/ref 17592186548101}} {:db/id #edb/ref 17592186548187 :step/content {:db/id #edb/ref 17592186548036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021687c4-7f27-5cfb-bfb5-dc034943da18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({e}^{2}+4)\\,{\\text{mm/s}}^{2}" :db/id #edb/ref 17592186547321} {:answer/id #uuid "6afc054d-1902-5c8f-94a1-83ead8f48431" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}({e}^{2}-1)\\,{\\text{mm/s}}^{2}" :db/id #edb/ref 17592186547553} {:answer/id #uuid "a0081eee-8909-542d-b183-dcd4d72c126a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2e+3)\\,{\\text{mm/s}}^{2}" :db/id #edb/ref 17592186547665} {:answer/id #uuid "db17edff-e21c-5200-a414-f3d057a203d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}({e}^{2}+3)\\,{\\text{mm/s}}^{2}" :db/id #edb/ref 17592186547777} {:answer/id #uuid "ec3107cf-6266-5c72-895b-2d1cbe80c372" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}({e}^{2}+1)\\,{\\text{mm/s}}^{2}" :db/id #edb/ref 17592186547806}] :answer-field/correct {:db/id #edb/ref 17592186547777} :answer-field/id #uuid "76075077-a9d5-595a-9adb-0f742d7f6853" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186547899}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a23536ce-7cba-5974-838f-a84131e7f6d9" :question/math-academy-id "q-83252" :question/problem "Find the average acceleration of a particle on the interval $[0,2]$ if its acceleration in ${\\text{mm/s}}^{2}$ is given by the function $a(t)={e}^{t}+2t,$ where $t$ is the time in seconds." :question/worked-solution "To calculate the average value of the acceleration on $[{t}_{1},{t}_{2}],$ we use the average value formula\n\n$$\n{a}_{\\text{avg}}=\\frac{1}{{t}_{2}-{t}_{1}}\\,{\\int }_{{t}_{1}}^{{t}_{2}}a(t)\\,\\text{d}t.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}{a}_{\\text{avg}} & =\\frac{1}{2-0}\\,{\\int }_{0}^{2}({e}^{t}+2t)\\,\\text{d}t \\\\  & =\\frac{1}{2}({e}^{t}+{t}^{2}){|}_{0}^{2} \\\\  & =\\frac{1}{2}[({e}^{2}+{2}^{2})-({e}^{0}+{0}^{2})] \\\\  & =\\frac{1}{2}({e}^{2}+4-1) \\\\  & =\\frac{1}{2}({e}^{2}+3).\\end{aligned}\n$$\n\nTherefore, the average acceleration is $\\frac{1}{2}({e}^{2}+3)\\,{\\text{mm/s}}^{2}.$"} :step/id #uuid "fe08ca81-b796-5651-89ae-d412960171ff" :step/next {:db/id #edb/ref 17592186548111}}] :activity/title "Average Position, Velocity, and Acceleration" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186547294}]}
