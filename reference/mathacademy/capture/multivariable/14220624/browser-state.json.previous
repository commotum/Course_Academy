<mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.3em\"><mtr><mtd><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>2</mn></mrow></msup><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>3</mn></mrow></msup><mn>3</mn></mfrac></mstyle><mo>−</mo><mo>⋯</mo><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mi>n</mi></mrow></msup></mrow><mi>n</mi></mfrac></mstyle><mo>+</mo><mo>⋯</mo></mtd><mtd><mi></mi><mo>=</mo></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup></mstyle></mrow><mo stretchy=\"false\">)</mo><mo>−</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup></mstyle></mrow><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mstyle mathcolor=\"blue\"><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup></mstyle></mrow><msup><mo stretchy=\"false\">)</mo><mn>3</mn></msup></mrow><mn>3</mn></mfrac></mstyle><mo>−</mo><mo>⋯</mo><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo stretchy=\"false\">