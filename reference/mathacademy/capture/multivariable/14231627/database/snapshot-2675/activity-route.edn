#{[{:activity/course {:db/id #edb/ref 17592186046669} :activity/first-step {:db/id #edb/ref 17592186553665} :activity/id #uuid "6497987c-07cf-5a53-aba2-92075ada7bf1" :activity/scope {:db/id #edb/ref 17592186048720 :topic/id #uuid "b86a089a-2daf-5959-af2d-4dfdfa1f55e6" :topic/math-academy-id 2927} :activity/steps [{:db/id #edb/ref 17592186553592 :step/content {:db/id #edb/ref 17592186363595 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78d66bb7-295d-5426-85d5-ecc60dac6869" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186363597}] :answer-field/correct {:db/id #edb/ref 17592186363597} :answer-field/id #uuid "1a9dd6a1-550f-5ff1-ac0d-0d56b1c23d4f" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186363596} {:answer-field/choices [{:answer/id #uuid "6a6b076b-e766-5c8f-a0cd-03e5ed12203c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186363599}] :answer-field/correct {:db/id #edb/ref 17592186363599} :answer-field/id #uuid "c21edd57-5874-58ec-99eb-20eab351adac" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186363598} {:answer-field/choices [{:answer/id #uuid "969f3547-f1ea-5d49-aedd-8aea07982cdc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186363601}] :answer-field/correct {:db/id #edb/ref 17592186363601} :answer-field/id #uuid "c69bc05e-3061-5ad4-a12b-c0cee73a6a62" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186363600} {:answer-field/choices [{:answer/id #uuid "54767c70-f1e8-5c2a-9645-45bac744baa3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186363603}] :answer-field/correct {:db/id #edb/ref 17592186363603} :answer-field/id #uuid "e2abb45a-5a37-5e8a-8dec-08ca46eb293c" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186363602} {:answer-field/choices [{:answer/id #uuid "59a6f51e-666c-56d3-ba03-4f7283a04750" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186363605}] :answer-field/correct {:db/id #edb/ref 17592186363605} :answer-field/id #uuid "1b6eb381-0284-5836-85ce-d79a42d2b9b7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186363604} {:answer-field/choices [{:answer/id #uuid "482359e7-082a-504d-bc57-f6163c9f176a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186363607}] :answer-field/correct {:db/id #edb/ref 17592186363607} :answer-field/id #uuid "61590ccc-fca1-55ef-a95d-40c03c2fae1e" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186363606}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "290de3f9-01bf-5fef-a22f-da08c098a0ae" :question/math-academy-id "q-253323" :question/problem "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | {{field-1}} | {{field-2}} | {{field-3}} |  |\n| --- | --- | --- | --- | --- | --- |\n| $\\operatorname{tan}⁡({J}_{3}(\\frac{\\pi }{4}))=\\,\\,$ |  | $0$ | {{field-4}} | {{field-5}} |  |\n|  |  | $0$ | $0$ | {{field-6}} |  |" :question/worked-solution "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=\\begin{bmatrix}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{bmatrix}.\n$$\n\nIn this case, we have $f(x)=\\operatorname{tan}⁡x,$ $n=3,$ and $\\lambda =\\frac{\\pi }{4}.$\n\nSince $n=3,$ we need to compute the first $3-1=2$ derivative of $f:$\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{tan}⁡x \\\\ {f}^{′}(x) & ={sec}^{2}⁡x \\\\ {f}^{″}(x) & =2{sec}^{2}⁡x\\operatorname{tan}⁡x\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f({J}_{3}(\\pi )) & =\\begin{bmatrix}f(\\frac{\\pi }{4}) & {f}^{′}(\\frac{\\pi }{4}) & \\frac{1}{2!}{f}^{″}(\\frac{\\pi }{4}) \\\\ 0 & f(\\frac{\\pi }{4}) & {f}^{′}(\\frac{\\pi }{4}) \\\\ 0 & 0 & f(\\frac{\\pi }{4})\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{tan}⁡(\\frac{\\pi }{4}) & {sec}^{2}⁡(\\frac{\\pi }{4}) & \\frac{1}{2}\\cdot 2{sec}^{2}⁡(\\frac{\\pi }{4})\\operatorname{tan}⁡(\\frac{\\pi }{4}) \\\\ 0 & \\operatorname{tan}⁡(\\frac{\\pi }{4}) & {sec}^{2}⁡(\\frac{\\pi }{4}) \\\\ 0 & 0 & \\operatorname{tan}⁡(\\frac{\\pi }{4})\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 & 2 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "01736ca0-0aab-5201-a60f-25493a6b2fd7" :step/next {:db/id #edb/ref 17592186553654}} {:db/id #edb/ref 17592186553625 :step/content {:db/id #edb/ref 17592186377013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3f7e99e-94b4-5e9b-9bad-05d7b6014436" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186377015}] :answer-field/correct {:db/id #edb/ref 17592186377015} :answer-field/id #uuid "db8bfa7f-442b-51d5-808b-ac5c79ddf792" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186377014} {:answer-field/choices [{:answer/id #uuid "c78d75d6-55e8-599e-8254-758bdadb9493" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186377017}] :answer-field/correct {:db/id #edb/ref 17592186377017} :answer-field/id #uuid "b895470a-054b-5ad4-a5ff-8d5bb48cbf4a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186377016} {:answer-field/choices [{:answer/id #uuid "af117d8d-702c-5f89-85a6-96a05f202f5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186377019}] :answer-field/correct {:db/id #edb/ref 17592186377019} :answer-field/id #uuid "62ff6a4d-d728-5072-81ce-f0c70fcf798b" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186377018} {:answer-field/choices [{:answer/id #uuid "a4b9a14d-317b-576b-b67c-05410d05c2c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186377021}] :answer-field/correct {:db/id #edb/ref 17592186377021} :answer-field/id #uuid "27ca53cf-44db-561d-8ba9-ab83738f1d5f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186377020} {:answer-field/choices [{:answer/id #uuid "ecbe735a-c5cb-5feb-b4b2-8a45d1e58c58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186377023}] :answer-field/correct {:db/id #edb/ref 17592186377023} :answer-field/id #uuid "8272e4c5-2429-505b-927b-2750e3b5d005" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186377022}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a1a8e997-11f9-5693-8fe0-4790fffa9c36" :question/math-academy-id "q-253879" :question/problem "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n|  |  | {{field-1}} | {{field-2}} | {{field-3}} | $0$ |  |\n| --- | --- | --- | --- | --- | --- | --- |\n| $\\operatorname{cos}⁡({J}_{3}(\\frac{\\pi }{3})\\,⊕\\,{J}_{1}(\\pi ))=\\,\\,$ |  | $0$ | $\\frac{1}{2}$ | {{field-4}} | $0$ |  |\n|  | $0$ | $0$ | $\\frac{1}{2}$ | $0$ |  |  |\n|  |  | $0$ | $0$ | $0$ | {{field-5}} |  |" :question/worked-solution "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=\\begin{bmatrix}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{bmatrix}.\n$$\n\nFirst, note that\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡({J}_{3}(\\frac{\\pi }{3})\\,⊕\\,{J}_{1}(\\frac{\\pi }{4})) & =\\operatorname{cos}⁡(\\begin{bmatrix}{J}_{3}(\\frac{\\pi }{3}) & 0 \\\\ 0 & {J}_{1}(\\pi )\\end{bmatrix}) \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡({J}_{3}(\\frac{\\pi }{3})) & 0 \\\\ 0 & \\operatorname{cos}⁡({J}_{1}(\\pi ))\\end{bmatrix} \\\\  & =\\operatorname{cos}⁡({J}_{3}(\\frac{\\pi }{3}))\\,⊕\\,\\operatorname{cos}⁡({J}_{1}(\\pi )).\\end{aligned}\n$$\n\nSo, we compute the function of each Jordan block separately.\n\n- For ${J}_{3}(\\frac{\\pi }{3}),$ we have $n=3$ and $\\lambda =2.$ \\since $n=3,$ we need to compute the first and second derivatives of $f$ only:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{cos}⁡x \\\\ {f}^{′}(x) & =-\\operatorname{sin}⁡x \\\\ {f}^{″}(x) & =-\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}f({J}_{3}(\\frac{\\pi }{3})) & =\\begin{bmatrix}f(\\frac{\\pi }{3}) & {f}^{′}(\\frac{\\pi }{3}) & \\frac{1}{2}{f}^{″}(\\frac{\\pi }{3}) \\\\ 0 & f(\\frac{\\pi }{3}) & {f}^{′}(\\frac{\\pi }{3}) \\\\ 0 & 0 & f(\\frac{\\pi }{3})\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(\\frac{\\pi }{3}) & -\\operatorname{sin}⁡(\\frac{\\pi }{3}) & -\\frac{1}{2}\\operatorname{cos}⁡(\\frac{\\pi }{3}) \\\\ 0 & \\operatorname{cos}⁡(\\frac{\\pi }{3}) & -\\operatorname{sin}⁡(\\frac{\\pi }{3}) \\\\ 0 & 0 & \\operatorname{cos}⁡(\\frac{\\pi }{3})\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{2} & -\\frac{\\sqrt{3}}{2} & -\\frac{1}{4} \\\\ 0 & \\frac{1}{2} & -\\frac{\\sqrt{3}}{2} \\\\ 0 & 0 & \\frac{1}{2}\\end{bmatrix}.\\end{aligned}\n$$\n\n- For ${J}_{1}(\\pi ),$ we have $n=1$ and $\\lambda =1.$ since $n=1,$ we don't need any derivatives. So, we get\n\n$$\n\\begin{aligned}f({J}_{1}(\\pi )) & =\\begin{bmatrix}f(\\pi )\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{cos}⁡(\\pi )\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡({J}_{3}(\\frac{\\pi }{3})\\,⊕\\,{J}_{1}(\\pi )) & =\\operatorname{cos}⁡({J}_{3}(\\frac{\\pi }{3}))\\,⊕\\,\\operatorname{cos}⁡({J}_{1}(\\pi )) \\\\  & =\\begin{bmatrix}\\frac{1}{2} & -\\frac{\\sqrt{3}}{2} & -\\frac{1}{4} & 0 \\\\ 0 & \\frac{1}{2} & -\\frac{\\sqrt{3}}{2} & 0 \\\\ 0 & 0 & \\frac{1}{2} & 0 \\\\ 0 & 0 & 0 & -1\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "6490f6a7-a2fa-5388-aee9-2fd4430c4a1f"} {:db/id #edb/ref 17592186553631 :step/content {:db/id #edb/ref 17592186363647 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5526c323-a2c1-5c5b-97ef-7fe8dc93120e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186363649} {:answer/id #uuid "047b15e1-e229-59bd-ae6f-4c8c03b091db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & -1 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186363650} {:answer/id #uuid "4de571fa-6b40-524d-9743-5964efb8c012" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186363651} {:answer/id #uuid "cdd35503-f16c-5a9e-8b68-9a58e3b5810d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186363652} {:answer/id #uuid "c854110d-1b0f-5794-affe-f3486969e32d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186363653}] :answer-field/correct {:db/id #edb/ref 17592186363649} :answer-field/id #uuid "c4428f89-e5a9-5f0c-ab0a-de1fa79f0c7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186363648}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "260b8d2c-8f9e-56a2-81b8-5ecd16019589" :question/math-academy-id "q-253493" :question/problem "Consider the following matrices:\n\n$$\nE=\\begin{bmatrix}1 & 1 \\\\ -1 & 3\\end{bmatrix},\\,J=\\begin{bmatrix}2 & 1 \\\\ 0 & 2\\end{bmatrix},\\,P=\\begin{bmatrix}1 & 2 \\\\ 1 & 3\\end{bmatrix}\n$$\n\nGiven that $E=PJ{P}^{-1},$ find $\\operatorname{cos}⁡(\\pi E).$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)=\\operatorname{cos}⁡(\\pi x)$ and the given matrix $E,$ we have\n\n$$\n\\operatorname{cos}⁡(\\pi E)=\\operatorname{cos}⁡(\\pi PJ{P}^{-1})=P\\cdot (\\operatorname{cos}⁡\\pi J)\\cdot {P}^{-1}.\n$$\n\nNow, since $J$ is a Jordan block with $2$s on the main diagonal, we have\n\n$$\nf(J)=\\begin{bmatrix}f(2) & {f}^{′}(2) \\\\ 0 & f(2)\\end{bmatrix}.\n$$\n\nThe derivative of $f$ is ${f}^{′}(x)=-\\pi \\operatorname{sin}⁡(\\pi x).$ So, we get\n\n$$\n\\operatorname{cos}⁡(\\pi E)=\\begin{bmatrix}f(2) & {f}^{′}(2) \\\\ 0 & f(2)\\end{bmatrix}=\\begin{bmatrix}\\operatorname{cos}⁡(2\\pi ) & -\\pi \\operatorname{sin}⁡(2\\pi ) \\\\ 0 & \\operatorname{cos}⁡(2\\pi )\\end{bmatrix}=\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{1}{1\\cdot 3-1\\cdot 2}\\begin{bmatrix}3 & -2 \\\\ -1 & 1\\end{bmatrix}=\\begin{bmatrix}3 & -2 \\\\ -1 & 1\\end{bmatrix}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}cos(\\pi E) & =P\\cdot (\\operatorname{cos}⁡(\\pi J))\\cdot {P}^{-1} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 1 & 3\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}3 & -2 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 1 & 3\\end{bmatrix}\\begin{bmatrix}3 & -2 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "72a96283-220e-5289-b060-a3483006b0f8" :step/next {:db/id #edb/ref 17592186553625}} {:db/id #edb/ref 17592186553654 :step/content {:db/id #edb/ref 17592186292559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "137e534f-bd6f-5c02-a6f5-0e5fdadf5e06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 4 \\\\ -1 & 1\\end{bmatrix}." :db/id #edb/ref 17592186290713} {:answer/id #uuid "462c0bc3-ae5d-5e7d-ba6c-584073583cc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 0 & -4\\end{bmatrix}." :db/id #edb/ref 17592186290921} {:answer/id #uuid "70f6d2e4-7bdd-5df2-a189-1ec0ba9e8bd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}." :db/id #edb/ref 17592186291116} {:answer/id #uuid "a0ea62a0-6627-5db1-881f-af6d402bcf16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 & 0 \\\\ 4 & 1\\end{bmatrix}." :db/id #edb/ref 17592186291333} {:answer/id #uuid "b6f2e637-dd26-5470-a0dc-0787ea0ddf23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-1 & 4 \\\\ 0 & 1\\end{bmatrix}." :db/id #edb/ref 17592186291424}] :answer-field/correct {:db/id #edb/ref 17592186291424} :answer-field/id #uuid "be47bb85-4317-5a50-92bc-2c97250cebc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186292320}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dbb79f16-63e6-597b-b683-9d7f2d6be154" :question/math-academy-id "q-253480" :question/problem "Consider the following matrices:\n\n$$\nC=\\begin{bmatrix}\\pi  & 2\\pi  \\\\ 0 & 2\\pi \\end{bmatrix},\\,D=\\begin{bmatrix}\\pi  & 0 \\\\ 0 & 2\\pi \\end{bmatrix},\\,P=\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}\n$$\n\nGiven that $C=PD{P}^{-1},$ find $\\operatorname{cos}⁡C.$" :question/worked-solution "Given a function $f$ and matrices $A$ and $S,$ where $S$ is invertible, we have\n\n$$\nf(SA{S}^{-1})=S\\cdot f(A)\\cdot {S}^{-1}.\n$$\n\nFor $f(x)=\\operatorname{cos}⁡C$ and the given matrix $C,$ we have\n\n$$\n\\operatorname{cos}⁡C=\\operatorname{cos}⁡(PD{P}^{-1})=P\\cdot (\\operatorname{cos}⁡D)\\cdot {P}^{-1}.\n$$\n\nNow, since $D$ is a diagonal matrix, we get\n\n$$\n\\operatorname{cos}⁡D=\\begin{bmatrix}\\operatorname{cos}⁡\\pi  & 0 \\\\ 0 & \\operatorname{cos}⁡2\\pi \\end{bmatrix}=\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nAlso, the inverse of $P$ is\n\n$$\n{P}^{-1}=\\frac{1}{1\\cdot 1-2\\cdot 0}\\begin{bmatrix}1 & -2 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}1 & -2 \\\\ 0 & 1\\end{bmatrix}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡C & =P\\cdot (\\operatorname{cos}⁡D)\\cdot {P}^{-1} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}-1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}-1 & 2 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 4 \\\\ 0 & 1\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "98382843-44b7-53a8-b1a3-61c2c6739e6c" :step/next {:db/id #edb/ref 17592186553631}} {:db/id #edb/ref 17592186553665 :step/content {:db/id #edb/ref 17592186363586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afd8d41a-bb06-5cea-8b85-8050627b3550" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "125" :db/id #edb/ref 17592186363588}] :answer-field/correct {:db/id #edb/ref 17592186363588} :answer-field/id #uuid "0806ead2-441e-535f-8c5f-faa5d813ac46" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186363587} {:answer-field/choices [{:answer/id #uuid "afecd274-e1e4-5c6b-a82a-1b760fce67ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186363590}] :answer-field/correct {:db/id #edb/ref 17592186363590} :answer-field/id #uuid "d3ae8ac8-e420-5629-92cc-c96a0a86fefb" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186363589} {:answer-field/choices [{:answer/id #uuid "79b3578f-d844-5293-a325-c401019cf333" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "125" :db/id #edb/ref 17592186363592}] :answer-field/correct {:db/id #edb/ref 17592186363592} :answer-field/id #uuid "f75e4db4-f4cb-53c0-8c4e-d0b9d6764408" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186363591} {:answer-field/choices [{:answer/id #uuid "ddaa3cdb-523f-566b-9d1c-15b0cbb37802" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "75" :db/id #edb/ref 17592186363594}] :answer-field/correct {:db/id #edb/ref 17592186363594} :answer-field/id #uuid "0c472a39-9041-5665-ab95-735f443f5378" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186363593}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5e8ed750-3b8f-5ed4-8834-e9a265b0a6e0" :question/math-academy-id "q-253307" :question/problem "Let ${J}_{n}(\\lambda )$ denote an $n\\times n$ Jordan block with $\\lambda $ on the main diagonal. Fill in the missing entries in the matrix below.\n\n| ${({J}_{2}(5))}^{3}=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "Given a function $f$ and a Jordan block ${J}_{n}(\\lambda ),$ we have\n\n$$\nf({J}_{n}(\\lambda ))=\\begin{bmatrix}f(\\lambda ) & {f}^{′}(\\lambda ) & \\frac{{f}^{″}(\\lambda )}{2!} & ⋯ & \\frac{{f}^{(n-1)}(\\lambda )}{(n-1)!} \\\\ 0 & f(\\lambda ) & {f}^{′}(\\lambda ) & ⋯ & \\frac{{f}^{(n-2)}(\\lambda )}{(n-2)!} \\\\ ⋮ & ⋱ & ⋱ & ⋱ & ⋮ \\\\ 0 & ⋯ & 0 & f(\\lambda ) & {f}^{′}(\\lambda ) \\\\ 0 & ⋯ & ⋯ & 0 & f(\\lambda )\\end{bmatrix}.\n$$\n\nIn this case, we have $f(x)={x}^{3},$ $n=2,$ and $\\lambda =5.$\nSince $n=2,$ we need to compute the first $2-1=1$ derivatives of $f:$\n\n$$\n\\begin{aligned}f(x) & ={x}^{3} \\\\ {f}^{′}(x) & =3{x}^{2}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f({J}_{2}(5)) & =\\begin{bmatrix}f(5) & {f}^{′}(5) \\\\ 0 & f(5)\\end{bmatrix} \\\\  & =\\begin{bmatrix}{5}^{3} & 3\\cdot {5}^{2} \\\\ 0 & {5}^{3}\\end{bmatrix} \\\\  & =\\begin{bmatrix}125 & 75 \\\\ 0 & 125\\end{bmatrix}\\end{aligned}\n$$"} :step/id #uuid "bb7a4a6d-71f1-5525-a73c-4b6460efbd23" :step/next {:db/id #edb/ref 17592186553592}}] :activity/title "Matrix Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186552857}]}
