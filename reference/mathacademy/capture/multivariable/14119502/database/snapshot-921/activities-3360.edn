#{[{:activity/first-step {:db/id #edb/ref 17592186172927} :activity/id #uuid "da0a118d-376a-5230-a1dc-46ce7816f56d" :activity/scope {:db/id #edb/ref 17592186049150 :topic/id #uuid "deab20e7-248d-57af-ad42-5509f60f2d31" :topic/math-academy-id 3360} :activity/steps [{:db/id #edb/ref 17592186172927 :step/content {:db/id #edb/ref 17592186173169 :tutorial/content "The fundamental theorem of line integrals states that\n\n$$\n\\int_{C} \\nabla f \\cdot \\textrm{d}\\mathbf r = f(\\mathbf r(b)) - f(\\mathbf r(a))\n$$\n\n \n\nwhere $C$ is a piecewise-smooth curve $\\mathbf r(t)$ for $t\\in [a,b],$ and $f$ is differentiable function such that $\\nabla f$ is continuous on $C.$ \n\nThis theorem tells us that the line integral of a conservative vector field $\\mathbf{F} = \\nabla f$ is determined by the values of $f$ at the endpoints $A$ and $B$ of $C$ only. The integral does *not* depend on the path between $A$ and $B.$ \n\nIn particular, if $\\mathbf F$ is conservative, then we say that $\\displaystyle\\int_{C} \\mathbf F \\cdot \\textrm{d}\\mathbf r$ is **path-independent.**" :tutorial/id #uuid "ab2cc7cb-1fa4-5e9c-92d4-551aeb945c53" :tutorial/math-academy-id 5145 :tutorial/title "Introduction"} :step/id #uuid "16937ae1-27e8-5337-99ff-6a5dd1b9e446" :step/math-academy-id 32376 :step/next {:db/id #edb/ref 17592186173007}} {:db/id #edb/ref 17592186172932 :step/content {:db/id #edb/ref 17592186172054 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171860 :question/id #uuid "06e592bb-3ebe-57f1-a282-635599780593" :question/math-academy-id "e-8753"} :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048916}] :knowledge-point/questions [{:db/id #edb/ref 17592186172299} {:db/id #edb/ref 17592186172300} {:db/id #edb/ref 17592186259847} {:db/id #edb/ref 17592186259853} {:db/id #edb/ref 17592186259861} {:db/id #edb/ref 17592186259862} {:db/id #edb/ref 17592186259863} {:db/id #edb/ref 17592186259864}] :kn