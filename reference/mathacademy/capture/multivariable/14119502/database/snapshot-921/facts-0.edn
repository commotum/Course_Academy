fe-bdf8-11fc33d9d123" #edb/ref 17592186045417] [17592186168680 #edb/ref 1080 "12" #edb/ref 17592186045417] [17592186168680 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186168680 #edb/ref 1083 #uuid "6aac6d3c-652c-5b99-bfe3-442ce8d4a895" #edb/ref 17592186045417] [17592186171675 #edb/ref 1075 #edb/ref 17592186171676 #edb/ref 17592186045417] [17592186171675 #edb/ref 1075 #edb/ref 17592186171677 #edb/ref 17592186045417] [17592186171675 #edb/ref 1075 #edb/ref 17592186171678 #edb/ref 17592186045417] [17592186171675 #edb/ref 1075 #edb/ref 17592186171679 #edb/ref 17592186045417] [17592186171675 #edb/ref 1075 #edb/ref 17592186171680 #edb/ref 17592186045417] [17592186171675 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186171675 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186171675 #edb/ref 1079 #uuid "12d1fd06-9549-53ed-8960-7b958b76dab0" #edb/ref 17592186045417] [17592186171676 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186171676 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186171676 #edb/ref 1083 #uuid "8493c4a0-871c-5177-a611-79d399da4583" #edb/ref 17592186045417] [17592186171677 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186171677 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186171677 #edb/ref 1083 #uuid "90ab2fa7-f0bb-5995-ad6a-bd36390a5a5c" #edb/ref 17592186045417] [17592186171678 #edb/ref 1080 "\\frac{1}{2}" #edb/ref 17592186045417] [17592186171678 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186171678 #edb/ref 1083 #uuid "d8825434-5542-58e1-8d22-d6f921f5fe04" #edb/ref 17592186045417] [17592186171679 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186171679 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186171679 #edb/ref 1083 #uuid "1cf1d5fb-e457-5937-b9f7-3ecebe2aa922" #edb/ref 17592186045417] [17592186171680 #edb/ref 1080 "0" #edb/ref 17592186045417] [17592186171680 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186171680 #edb/ref 1083 #uuid "658a6bb9-761f-5506-bb42-6b75e9c861d3" #edb/ref 17592186045417] [17592186171860 #edb/ref 1069 "e-8753" #edb/ref 17592186045417] [17592186171860 #edb/ref 1071 "Consider the vector field $\\mathbf F(x,y) =  \\left\\langle ye^{xy},\\, xe^{xy}\\right\\rangle$ and the points $A(1,1)$ and $B(2,2)$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\n- $\\mathbf F$ is conservative.\n\n- $\\displaystyle\\int\\limits_{C_1} \\mathbf F\\cdot \\textrm d \\mathbf r = e^4-e,$ where $C_1$ is the path along the curve $y=\\sqrt{2x},$ traversed from $A$ to $B.$\n\n- $\\displaystyle\\int\\limits_{C_2} \\mathbf F\\cdot \\textrm d \\mathbf r = e^4-e,$ where $C_2$ is the path along along the line segment $\\overline{AB},$ traversed from $A$ to $B.$" #edb/ref 17592186045417] [17592186171860 #edb/ref 1072 #uuid "06e592bb-3ebe-57f1-a282-635599780593" #edb/ref 17592186045417] [17592186171860 #edb/ref 1074 "Let $C$ be a piecewise-smooth curve given by the vector-valued function $\\mathbf r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $\\nabla f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n\\int_{C} \\nabla f \\cdot \\textrm{d}\\mathbf r = f(\\mathbf r(b)) - f(\\mathbf r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement I is true. Notice that $\\mathbf F = P\\,\\mathbf i + Q\\,\\mathbf j$ is a vector field on $\\mathbb R^2$ with domain $D = \\mathbb R^2.$ Computing the partial derivatives, we get\n\n$$\n\\dfrac{\\partial P}{\\partial y} = \\dfrac{\\partial Q}{\\partial x} = (1+xy)e^{xy}.\n$$\n\nSince the partial derivatives exist and are continuous and equal everywhere on $\\mathbb R^2,$ we conclude that $\\mathbf F$ is conservative. Therefore, we know there exists a function $f$ such that $\\nabla f = \\mathbf F.$\n\n- Statement II is true. Since $\\mathbf F$ is conservative, there exists a function $f$ such that $\\nabla f = \\mathbf F.$ Reconstructing the function $f$ from its gradient in the usual way, we get\n\n$$\nf = e^{xy}.\n$$\n\nApplying the fundamental theorem for line integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}∇f\\cdot \\text{d}r \\\\  & =f(2,2)-f(1,1) \\\\  & ={e}^{2\\cdot 2}-{e}^{1\\cdot 1} \\\\  & ={e}^{4}-e.\\end{aligned}\n$$\n\n- Statement III is true. Since $\\mathbf F$ is conservative and $C_2$ has the same initial and terminal points as $C_1,$ we have\n\n$$\n\\int\\limits_{C_2} \\mathbf F\\cdot \\textrm d \\mathbf r = \\displaystyle\\int\\limits_{C_1} \\mathbf F\\cdot \\textrm d \\mathbf r = e^{4}-e.\n$$\n\nTherefore, the correct answer is \"I, II, and III.\"" #edb/ref 17592186045417] [17592186171903 #edb/ref 1069 "e-9548" #edb/ref 17592186045417] [17592186171903 #edb/ref 1071 "Consider the scalar field $f(x,y,z) = x^2 + y^2 + z^2.$ Calculate $\\displaystyle{\\int_C \\nabla f \\cdot \\textrm d\\mathbf r},$ where $C$ is any smooth path from $(-2, 1, 0)$ to $(-1, 0, -1)$ in $\\mathbb R^3.$" #edb/ref 17592186045417] [17592186171903 #edb/ref 1072 #uuid "a9f1b212-7d45-566a-95d3-fa2697ad8c3a" #edb/ref 17592186045417] [17592186171903 #edb/ref 1074 "Let $C$ be a piecewise-smooth curve given by the vector-valued function $\\mathbf r(t)$ for $t \\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $\\nabla f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n\\int_{C} \\nabla f \\cdot \\textrm{d}\\mathbf r = f(\\mathbf r(b)) - f(\\mathbf r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nIn our case, the coordinates of the endpoints of the path $C$ are $A(-2, 1, 0)$ and $B(-1, 0, -1).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(-1,0,-1)-f(-2,1,0) \\\\  & =((-1)^{2}+{0}^{2}+(-1)^{2})-((-2)^{2}+{1}^{2}+{0}^{2}) \\\\  & =2-5 \\\\  & =-3.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186171904 #edb/ref 1069 "e-9549" #edb/ref 17592186045417] [17592186171904 #edb/ref 1071 "Consider the vector field $\\mathbf F(x, y) = -2x\\,\\mathbf i + 6y^2\\,\\mathbf j.$ Calculate $\\displaystyle{\\int_C \\mathbf F \\cdot \\textrm d\\mathbf r},$ where $C$ is any smooth path from $(-2, 0)$ to $(1, 2)$ in $\\mathbb R^2.$" #edb/ref 17592186045417] [17592186171904 #edb/ref 1072 #uuid "d659bb69-1a8d-5fb2-837c-27e454877021" #edb/ref 17592186045417] [17592186171904 #edb/ref 1074 "Let $C$ be a piecewise-smooth curve given by the vector-valued function $\\mathbf r(t)$ for $t \\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $\\nabla f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n\\int_{C} \\nabla f \\cdot \\textrm{d}\\mathbf r = f(\\mathbf r(b)) - f(\\mathbf r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nIn our case, the coordinates of the endpoints of the path $C$ are $A(-2,0)$ and $B(1, 2).$\n\nNotice that $\\mathbf F = P\\,\\mathbf i + Q\\,\\mathbf j$ is a vector field on $\\mathbb R^2$ with domain $D = \\mathbb R^2.$ Computing the partial derivatives, we get\n\n$$\n\\dfrac{\\partial P}{\\partial y} = \\dfrac{\\partial Q}{\\partial x} = 0.\n$$\n\nSince the partial derivatives exist and are continuous and equal everywhere on $\\mathbb R^2,$ we conclude that $\\mathbf F$ is conservative. Therefore, we know there exists a function $f$ such that $\\nabla f = \\mathbf F.$\n\nReconstructing $f$ from its gradient in the usual way, we get\n\n$$\nf = 2y^3 - x^2.\n$$\n\nFinally, applying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{C}∇f\\cdot \\text{d}r \\\\  & =f(1,2)-f(-2,0) \\\\  & =(2(2)^{3}-{1}^{2})-(2(0)^{3}-(-2)^{2}) \\\\  & =16-1+4 \\\\  & =19.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186172054 #edb/ref 1037 #edb/ref 17592186048916 #edb/ref 17592186045417] [17592186172054 #edb/ref 1038 #edb/ref 17592186172299 #edb/ref 17592186045417] [17592186172054 #edb/ref 1038 #edb/ref 17592186172300 #edb/ref 17592186045417] [17592186172054 #edb/ref 1038 #edb/ref 17592186259847 #edb/ref 17592186045417] [17592186172054 #edb/ref 1038 #edb/ref 17592186259853 #edb/ref 17592186045417] [17592186172054 #edb/ref 1038 #edb/ref 17592186259861 #edb/ref 17592186045417] [17592186172054 #edb/ref 1038 #edb/ref 17592186259862 #edb/ref 17592186045417] [17592186172054 #edb/ref 1038 #edb/ref 17592186259863 #edb/ref 17592186045417] [17592186172054 #edb/ref 1038 #edb/ref 17592186259864 #edb/ref 17592186045417] [17592186172054 #edb/ref 1039 "Identifying Vector Fields That Are Independent of Path" #edb/ref 17592186045417] [17592186172054 #edb/ref 1041 #edb/ref 17592186171860 #edb/ref 17592186045417] [17592186172054 #edb/ref 1042 #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" #edb/ref 17592186045417] [17592186172097 #edb/ref 1037 #edb/ref 17592186048308 #edb/ref 17592186045417] [17592186172097 #edb/ref 1038 #edb/ref 17592186172302 #edb/ref 17592186045417] [17592186172097 #edb/ref 1038 #edb/ref 17592186172675 #edb/ref 17592186045417] [17592186172097 #edb/ref 1038 #edb/ref 17592186259848 #edb/ref 17592186045417] [17592186172097 #edb/ref 1038 #edb/ref 17592186259850 #edb/ref 17592186045417] [17592186172097 #edb/ref 1038 #edb/ref 17592186259851 #edb/ref 17592186045417] [17592186172097 #edb/ref 1038 #edb/ref 17592186259852 #edb/re