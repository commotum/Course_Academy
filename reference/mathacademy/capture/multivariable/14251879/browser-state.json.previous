    "q-83016": {
      "dom_id": "step-q83016",
      "name": "Question 16",
      "problem": "Simplify $P∨(Q∨P).$",
      "worked_solution": "Using the commutative, associative, and idempotent laws, we get\n\n$$\n\\begin{aligned}P∨(Q∨P) & ≡P∨(P∨Q) \\\\  & ≡(P∨P)∨Q \\\\  & ≡P∨Q.\\end{aligned}\n$$",
      "calculator_instructions": "",
