              "option": "b",
              "dom_id": "questionWidget-choiceLetterCircle-82723-b",
              "type": "text",
              "value": "The marker is purple and black.",
              "html": "The marker is purple and black."
            },
            {
              "option": "c",
              "dom_id": "questionWidget-choiceLetterCircle-82723-c",
              "type": "text",
              "value": "The marker is black but not purple.",
              "html": " The marker is black but not purple."
            },
            {
              "option": "d",
              "dom_id": "questionWidget-choiceLetterCircle-82723-d",
              "type": "text",
              "value": "The marker is black.",
