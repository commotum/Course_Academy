    "q-89254": {
      "dom_id": "step-q89254",
      "name": "Question 4",
      "problem": "Simplify the following sentence: \"The actor is talented and the actor is successful, and the actor is successful or is a successful actor.\"",
      "worked_solution": "First, we simplify the phrase \"the actor is successful or is a successful actor\" to just \"the actor is successful.\" The sentence now reads\n\n\"The actor is talented and the actor is successful, and the actor is successful.\"\n\nThen, using the associative law, we can move the comma in the sentence:\n\n\"The actor is talented, and the actor is successful and the actor is successful.\"\n\nNow, we simplify the phrase \"the actor is successful and the actor is successful\" to just \"the actor is successful.\" The sentence now reads\n\n\"The actor is talented, and the actor is successful.\"\n\nFinally, we simplify the sentence to\n\n\"The actor is talented and successful.\"",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-89254-a",
              "type": "text",
              "value": "The actor is successful",
              "html": "The actor is successful"
            },
            {
