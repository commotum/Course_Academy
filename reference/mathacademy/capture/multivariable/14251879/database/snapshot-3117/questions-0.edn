 red." :db/id #edb/ref 17592186404221} {:answer/id #uuid "2b83dfed-9c07-56fa-b16a-12c95687af8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The pen is blue and red." :db/id #edb/ref 17592186404222} {:answer/id #uuid "924f8062-92c3-57c2-a169-650f347777d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The pen is blue or red but not both." :db/id #edb/ref 17592186404223}] :answer-field/correct {:answer/id #uuid "0f1aeba2-f7a1-5ed9-8109-e70dd146aca4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The pen is blue or red." :db/id #edb/ref 17592186404221} :answer-field/id #uuid "ca5578dd-0a57-5cc2-809c-152390f18874" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404218}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ae3ad46-5289-52fe-9fde-b40fc7aa7003" :question/math-academy-id "q-82720" :question/problem "Simplify the following sentence: \"The pen is blue and it is a blue pen, or the pen is blue or it is a red pen.\"" :question/worked-solution "First, we simplify the phrase \"the pen is blue and it is a blue pen\" to just \"the pen is blue.\" The sentence now reads\n\n\"The pen is blue, or the pen is blue or it is a red pen.\"\n\nThen, using the associative law, we can move the comma in the sentence:\n\n\"The pen is blue or the pen is blue, or it is a red pen.\"\n\nNow, we simplify the phrase \"the pen is blue or the pen is blue\" to just \"the pen is blue.\" The sentence now reads\n\n\"The pen is blue, or it is a red pen.\"\n\nFinally, we simplify the sentence to\n\n\"The pen is blue or red.\""}] [{:db/id #edb/ref 17592186157823 :knowledge-point/_questions [{:db/id #edb/ref 17592186157241 :knowledge-point/id #uuid "149709f4-f9d8-529f-87af-a022ec1d46a8" :knowledge-point/title "Simplifying Sentences Using the Commutative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adcb851e-858e-57b0-a3ec-17e8bcca9b7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The marker is purple." :db/id #edb/ref 17592186155860} {:answer/id #uuid "b0d85b60-eeb9-5495-9f7f-a31118c097c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The marker is black but not purple." :db/id #edb/ref 17592186155861} {:answer/id #uuid "f5533829-6017-5c94-960e-d24b4abc189c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The marker is purple or black." :db/id #edb/ref 17592186155862} {:answer/id #uuid "11499491-c7c6-5aa9-be33-26ec1ad4f1d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The marker is purple and black." :db/id #edb/ref 17592186155863} {:answer/id #uuid "6aa73c61-4962-56e4-a7d4-f4d012e90444" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The marker is black." :db/id #edb/ref 17592186155864}] :answer-field/id #uuid "970ba248-4f05-563c-9453-e80422d1588f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186155859} {:answer-field/choices [{:answer/id #uuid "c3cac5ef-1b47-5caf-a2e4-d08061715839" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The marker is purple or black." :db/id #edb/ref 17592186394457} {:answer/id #uuid "1336472a-f455-53e9-b12c-9e6d8de50b23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The marker is purple." :db/id #edb/ref 17592186394458} {:answer/id #uuid "7ed530b5-6881-5426-af89-c8326c89f354" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The marker is black but not purple." :db/id #edb/ref 17592186394459} {:answer