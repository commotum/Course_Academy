 is a wristwatch, or it is a pocket watch.\"\n\nNow, we can simplify the phrase \"The watch is a wristwatch or it is a wristwatch\" to just \"The watch is a wristwatch.\" The sentence now reads\n\n\"The watch is a wristwatch, or it is a pocket watch.\"\n\nFinally, we can write the sentence more concisely:\n\n\"The watch is a wristwatch or a pocket watch.\""}] [{:db/id #edb/ref 17592186572717 :knowledge-point/_questions [{:db/id #edb/ref 17592186157240 :knowledge-point/id #uuid "331fa12f-a113-5aba-bd6e-5bd5bf62298f" :knowledge-point/title "Simplifying Symbolic Statements Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32de8613-7145-50c9-a220-2dd9e1312c68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186572375} {:answer/id #uuid "3aeaee8f-2b2c-55f2-99ed-c102b8b481a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧B" :db/id #edb/ref 17592186572386} {:answer/id #uuid "83d69269-84d5-571c-8693-4a986abd2c75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧(B∨A)" :db/id #edb/ref 17592186572457} {:answer/id #uuid "c1db5d1d-6b1a-57e7-bc72-e8ad66a8c43e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B" :db/id #edb/ref 17592186572533} {:answer/id #uuid "de074457-6612-5b22-ac70-e1e4c2cdd6a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨B" :db/id #edb/ref 17592186572559}] :answer-field/correct {:answer/id #uuid "3aeaee8f-2b2c-55f2-99ed-c102b8b481a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧B" :db/id #edb/ref 17592186572386} :answer-field/id #uuid "2b7f6e3a-4054-5010-b8a8-f9194134898b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572606}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4c8e41b-9e14-5786-91ae-524e6c4c4e4d" :question/math-academy-id "q-83011" :question/problem "Simplify $(A∨A)∧(A∧B).$" :question/worked-solution "Using the associative and idempotent laws, we get\n\n$$\n\\begin{aligned}(A∨A)∧(A∧B) & ≡A∧(A∧B) \\\\  & ≡(A∧A)∧B \\\\  & ≡A∧B.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572712 :knowledge-point/_questions [{:db/id #edb/ref 17592186157242 :knowledge-point/id #uuid "1e18ca89-35ef-5360-b3a1-8c9496247abb" :knowledge-point/title "Simplifying Symbolic Statements Using the Commutative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d3ae000-e416-54e1-88ce-65be7c22e71c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧Q" :db/id #edb/ref 17592186572409} {:answer/id #uuid "61ae890b-0ba2-5131-a806-a7d9e03bc836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P" :db/id #edb/ref 17592186572432} {:answer/id #uuid "97822d8a-3aff-518e-abc9-9e9d7d91e9d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∨Q" :db/id #edb/ref 17592186572479} {:answer/id #uuid "9d077b2f-2317-542b-8f04-527868cded9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q" :db/id #edb/ref 17592186572484} {:answer/id #uuid "c93ffbeb-8751-5d7e-a9b6-48a4a9215956" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧(Q∨P)" :db/id #edb/ref 17592186572544}] :answer-field/correct {:answer/id #uuid "97822d8a-3aff-518e-abc9-9e9d7d91e9d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∨Q" :db/id #edb/ref 17592186572479} :answer-field/id #uuid "d7957362-7aab-525b-b527-7c314c364d56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572652}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8b24239-40f1-5136-9956-57abae0c726e" :question/math-academy-id "q-83016" :question/problem "Simplify $P∨(Q∨P).$" :question/worked-solution "Using the commutative, associative, and idempotent laws, we get\n\n$$\n\\begin{aligned}P∨(Q∨P) & ≡P∨(P∨Q) \\\\  & ≡(P∨P)∨Q \\\\  & ≡P∨Q.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572663 :knowledge-point/_questions [{:db/id #edb/ref 17592186157242 :knowledge-point/id #uuid "1e18ca89-35ef-5360-b3a1-8c9496247abb" :knowledge-point/title "Simplifying Symbolic Statements Using the Commutative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44a4fac6-cae7-5e38-920f-49434cc841c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∨C)∧B" :db/id #edb/ref 17592186572399} {:answer/id #uuid "68233117-22ad-5c96-b609-248f60a2900b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨C" :db/id #edb/ref 17592186572438} {:answer/id #uuid "9df37840-4f95-58d0-9255-4bf4ff868e29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨(B∧C)" :db/id #edb/ref 17592186572487} {:answer/id #uuid "b0f15ef4-dce3-572a-a6fa-42cc2175cc99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∨C)∨B" :db/id #edb/ref 17592186572513} {:answer/id #uuid "b8f552b0-c912-58c1-af76-a07b69cd681f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧C" :db/id #edb/ref 17592186572520}] :answer-field/correct {:answer/id #uuid "b0f15ef4-dce3-572a-a6fa-42cc2175cc99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∨C)∨B" :db/id #edb/ref 17592186572513} :answer-field/id #uuid "730a3a57-2813-527b-aba4-8d7d6fcf61ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572624}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0268bb49-20bf-526d-b894-f6feb846e8a0" :question/math-academy-id "q-83019" :question/problem "Simplify $(A∨B)∨(C∨B).$" :question/worked-solution "Using the associative, commutative, and idempotent laws, we get\n\n$$\n\\begin{aligned}(A∨B)∨(C∨B) & ≡(A∨B)∨(B∨C) \\\\  & ≡A∨(B∨B)∨C \\\\  & ≡A∨B∨C \\\\  & ≡A∨C∨B \\\\  & ≡(A∨C)∨B.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572718 :knowledge-point/_questions [{:db/id #edb/ref 17592186157239 :knowledge-point/id #uuid "857d696d-6a3f-5fff-a5e1-b05148f28f55" :knowledge-point/title "Simplifying Sentences Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fd2fa9e-c448-5ee2-b9a5-702dde25e51b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The dress is red or elegant" :db/id #edb/ref 17592186572358} {:answer/id #uuid "942d99b7-aea0-57c8-8b7f-7dcec3391369" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The dress is red and elegant" :db/id #edb/ref 17592186572476} {:answer/id #uuid "983f8529-d969-51aa-b1fb-4ab9bc9aea40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The dress is red" :db/id #edb/ref 17592186572480} {:answer/id #uuid "bd90bfca-45a9-5803-ab50-a07756ddd50f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The dress is elegant" :db/id #edb/ref 17592186572529} {:answer/id #uuid "c8669e19-9283-51c0-8c7b-3e84e6818ef6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The dress is red and it is not elegant" :db/id #edb/ref 17592186572543}] :answer-field/correct {:answer/id #uuid "942d99b7-aea0-57c8-8b7f-7dcec3391369" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The dress is red and elegant" :db/id #edb/ref 17592186572476} :answer-field/id #uuid "f9852f19-1bc8-5b08-8e67-b849c3edbd0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572661}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d9600c9e-6c82-5b6e-b3f2-54ca64b173d3" :question/math-academy-id "q-89251" :question/problem "Simplify the sentence \"The dress is red and elegant, and it is elegant.\"" :question/worked-solution "First, let's rewrite the phrase \"The dress is red and elegant\" as the equivalent phrase \"The dress is red and the dress is elegant.\" The sentence now reads\n\n\"The dress is red and the dress is elegant, and it is elegant.\"\n\nThen, using the associative law, we can move the comma:\n\n\"The dress is red, and the dress is elegant and it is elegant.\"\n\nNow, we can simplify the phrase \"the dress is elegant and it is elegant\" to just \"the dress is elegant.\" The sentence now reads\n\n\"The dress is red, and the dress is elegant.\"\n\nFinally, we can write the sentence more concisely as\n\n\"The dress is red and elegant.\""}] [{:db/id #edb/ref 17592186404447 :knowledge-point/_questions [{:db/id #edb/ref 17592186157239 :knowledge-point/id #uuid "857d696d-6a3f-5fff-a5e1-b05148f28f55" :knowledge-point/title "Simplifying Sentences Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b5b70db-2b05-51ba-84eb-8426d1e48801" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The movie is romantic" :db/id #edb/ref 17592186404449} {:answer/id #uuid "203b1139-b63c-55f9-93a5-2e112bba5b55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The movie is romantic but not comic" :db/id #edb/ref 17592186404450} {:answer/id #uuid "3bd3bdcc-15fc-5268-bfaf-aeee4a0fee8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The movie is comic" :db/id #edb/ref 17592186404451} {:answer/id #uuid "541680c1-2b24-55c6-8afc-6a4bedb19ce9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The movie is romantic or comic" :db/id #edb/ref 17592186404452} {:answer/id #uuid "7aecce06-d66d-5e1f-8e08-ac26cc73bd78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The movie is romantic and comic" :db/id #edb/ref 17592186404453}] :answer-field/correct {:answer/id #uuid "541680c1-2b24-55c6-8afc-6a4bedb19ce9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The movie is romantic or comic" :db/id #edb/ref 17592186404452} :answer-field/id #uuid "d0ec9b14-67d1-5d44-aaf5-9a87460b11fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404448}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0026e046-e84c-5c78-8cfa-12a3749b6a2d" :question/math-academy-id "q-89252" :question/problem "Simplify the sentence \"The movie is romantic, or the movie is romantic or comic.\"" :question/worked-solution "First, let's rewrite the phrase \"the movie is romantic or comic\" as the equivalent phrase \"the movie is romantic or the movie is comic.\" The sentence now reads\n\n\"The movie is romantic, or the movie is romantic or the movie is comic.\"\n\nThen, using the associative law, we can move the comma:\n\n\"The movie is romantic or the movie is romantic, or the movie is comic.\"\n\nNow, we can simplify the phrase \"The movie is romantic or the movie is romantic\" to just \"The movie is romantic.\" The sentence now reads\n\n\"The movie is romantic, or the movie is comic.\"\n\nFinally, we can write the sentence more concisely as\n\n\"The movie is romantic or comic.\""}] [{:db/id #edb/ref 17592186380249 :knowledge-point/_questions [{:db/id #edb/ref 17592186157239 :knowledge-point/id #uuid "857d696d-6a3f-5fff-a5e1-b05148f28f55" :knowledge-point/title "Simplifying Sentences Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cfe5cf7b-34eb-579b-9de5-66399500f2a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The actor is talented or successful" :db/id #edb/ref 17592186380251} {:answer/id #uuid "30244b4c-438e-5366-9917-43241c71cfc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The actor is talented" :db/id #edb/ref 17592186380252} {:answer/id #uuid "b3a60427-f52c-5b3a-ae20-3a29782bff43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The actor is talented but not successful" :db/id #edb/ref 17592186380253} {:answer/id #uuid "e604e0e4-76fa-58b1-8eb9-2a0132713d34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The actor is successful" :db/id #edb/ref 17592186380254} {:answer/id #uuid "3723d2e4-7af5-507a-8e12-579bed0e2c54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The actor is talented and successful" :db/id #edb/ref 17592186380255}] :answer-field/correct {:answer/id #uuid "3723d2e4-7af5-507a-8e12-579bed0e2c54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The actor is talented and successful" :db/id #edb/ref 17592186380255} :answer-field/id #uuid "abb97ba1-9dda-568d-8499-4d801e4f661c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380250}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2f240e16-b06d-50d1-bdc6-1009b836ca04" :question/math-academy-id "q-89254" :question/problem "Simplify the following sentence: \"The actor is talented and the actor is successful, and the actor is successful or is a successful actor.\"" :question/worked-solution "First, we simplify the phrase \"the actor is successful or is a successful actor\" to just \"the actor is successful.\" The sentence now reads\n\n\"The actor is talented and the actor is successful, and the actor is successful.\"\n\nThen, using the associative law, we can move the comma in the sentence:\n\n\"The actor is talented, and the actor is successful and the actor is successful.\"\n\nNow, we simplify the phrase \"the actor is successful and the actor is successful\" to just \"the actor is successful.\" The sentence now reads\n\n\"The actor is talented, and the actor is successful.\"\n\nFinally, we simplify the sentence to\n\n\"The actor is talented and successful.\""}] [{:db/id #edb/ref 17592186394820 :knowledge-point/_questions [{:db/id #edb/ref 17592186157240 :knowledge-point/id #uuid "331fa12f-a113-5aba-bd6e-5bd5bf62298f" :knowledge-point/title "Simplifying Symbolic Statements Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41602012-bb04-5534-99d3-1c336df87d22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q∨(P∧Q)" :db/id #edb/ref 17592186394822} {:answer/id #uuid "d42d1bd4-4961-5827-8390-3da0a398ab43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P" :db/id #edb/ref 17592186394823} {:answer/id #uuid "02b88ca0-c86b-513b-804e-f3b44341424b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧Q" :db/id #edb/ref 17592186394824} {:answer/id #uuid "e43ee3bb-80df-5c31-80d1-c1a57e26a965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧(Q∨P)" :db/id #edb/ref 17592186394825} {:answer/id #uuid "662d7345-9f00-55a6-9a0c-dea7cf22c9c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∨Q" :db/id #edb/ref 17592186394826}] :answer-field/correct {:answer/id #uuid "662d7345-9f00-55a6-9a0c-dea7cf22c9c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∨Q" :db/id #edb/ref 17592186394826} :answer-field/id #uuid "5bd8780b-5e12-55d9-bb80-be017170c855" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394821}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c8088540-0f2b-5602-b820-b1ed9dad2fb7" :question/math-academy-id "q-89266" :question/problem "Simplify $(P∨Q)∨(Q∧Q).$" :question/worked-solution "Using the associative and idempotent laws, we get\n\n$$\n\\begin{aligned}(P∨Q)∨(Q∧Q) & ≡(P∨Q)∨Q \\\\  & ≡P∨(Q∨Q) \\\\  & ≡P∨Q.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572688 :knowledge-point/_questions [{:db/id #edb/ref 17592186157240 :knowledge-point/id #uuid "331fa12f-a113-5aba-bd6e-5bd5bf62298f" :knowledge-point/title "Simplifying Symbolic Statements Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01076016-2b98-5013-8e02-c4b5eb6f67a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186572318} {:answer/id #uuid "333269a7-6b88-54a4-948a-f4ffe6eead44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M" :db/id #edb/ref 17592186572377} {:answer/id #uuid "49496c4d-d575-5244-bbc8-8a94d1599d81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∧N" :db/id #edb/ref 17592186572404} {:answer/id #uuid "798ad3ef-9c9f-53a7-8ced-5bfd1d9ebce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N∨M" :db/id #edb/ref 17592186572452} {:answer/id #uuid "83034094-5b9d-51b1-be1e-205733704989" :answer/type {:db/id #edb/ref 17592186045498 :