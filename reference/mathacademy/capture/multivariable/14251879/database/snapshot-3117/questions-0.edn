#{[{:db/id #edb/ref 17592186157003 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157239 :knowledge-point/id #uuid "857d696d-6a3f-5fff-a5e1-b05148f28f55" :knowledge-point/title "Simplifying Sentences Using the Associative Law"}] :question/id #uuid "a14e5d71-82ca-5df6-8875-f28eece240c6" :question/math-academy-id "e-12697" :question/problem "Simplify the sentence \"The car is fancy and big, and the car is big.\"" :question/worked-solution "First, let's rewrite the phrase \"the car is fancy and big\" as the equivalent phrase \"the car is fancy and the car is big.\" The sentence now reads\n\n\"The car is fancy and the car is big, and the car is big.\"\n\nThen, using the associative law, we can move the comma:\n\n\"The car is fancy, and the car is big and the car is big.\"\n\nNow, we can simplify the phrase \"the car is big and the car is big\" to just \"the car is big.\" The sentence now reads\n\n\"The car is fancy, and the car is big.\"\n\nFinally, we can write the sentence more concisely as\n\n\"The car is fancy and big.\""}] [{:db/id #edb/ref 17592186157004 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157240 :knowledge-point/id #uuid "331fa12f-a113-5aba-bd6e-5bd5bf62298f" :knowledge-point/title "Simplifying Symbolic Statements Using the Associative Law"}] :question/id #uuid "ec2031e2-5f0b-5f12-bf52-1ef26fd84b61" :question/math-academy-id "e-12698" :question/problem "Simplify $(P \\land Q) \\land (Q \\lor Q).$" :question/worked-solution "Using the associative and idempotent laws, we get\n\n$$\n\\begin{aligned}(P∧Q)∧(Q∨Q) & ≡(P∧Q)∧Q \\\\  & ≡P∧(Q∧Q) \\\\  & ≡P∧Q.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186157005 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157241 :knowledge-point/id #uuid "149709f4-f9d8-529f-87af-a022ec1d46a8" :knowledge-point/title "Simplifying Sentences Using the Commutative Law"}] :question/id #uuid "1f69673c-7b2d-50ab-9df8-3de7c1933739" :question/math-academy-id "e-12699" :question/problem "Simplify the following sentence: \"The table is brown and it is high, and it is brown.\"" :question/worked-solution "Using the commutative law, we can replace the phrase \"the table is brown and it is high\" with the phrase \"the table is high and it is brown.\" The sentence now reads\n\n\"The table is high and it is brown, and it is brown.\"\n\nThen, using the associative law, we can move the comma:\n\n\"The table is high, and it is brown and it is brown.\"\n\nNow, we can simplify the phrase \"it is brown and it is brown\" to just \"it is brown.\" The sentence now reads\n\n\"The table is high and it is brown.\"\n\nFinally, we can write the sentence more concisely:\n\n\"The table is high and brown.\""}] [{:db/id #edb/ref 17592186157006 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157242 :knowledge-point/id #uuid "1e18ca89-35ef-5360-b3a1-8c9496247abb" :knowledge-point/title "Simplifying Symbolic Statements Using the Commutative Law"}] :question/id #uuid "fc7f518c-c6f3-5968-bc59-148277395bf9" :question/math-academy-id "e-12700" :question/problem "Simplify $(A \\land B) \\land (B \\land A).$" :question/worked-solution "Using the associative, commutative, and idempotent laws, we get\n\n$$\n\\begin{aligned}(A∧B)∧(B∧A) & ≡A∧(B∧B)∧A \\\\  & ≡A∧B∧A \\\\  & ≡(A∧A)∧B \\\\  & ≡A∧B.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378545 :knowledge-point/_questions [{:db/id #edb/ref 17592186157240 :knowledge-point/id #uuid "331fa12f-a113-5aba-bd6e-5bd5bf62298f" :knowledge-point/title "Simplifying Symbolic Statements Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "024f757b-b34e-5919-a1c0-4007dfbe0e73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(P∨Q)∧R" :db/id #edb/ref 17592186378547} {:answer/id #uuid "ac752121-76c8-575a-930f-9e019ee9981b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(P∧Q)∨R" :db/id #edb/ref 17592186378548} {:answer/id #uuid "2a585d1f-7b32-51e1-b008-e9c9a394440e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(P∧Q)∧R" :db/id #edb/ref 17592186378549} {:answer/id #uuid "8f27be41-5974-5971-9b11-5b508a5bf90a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(P∨Q)∨R" :db/id #edb/ref 17592186378550} {:answer/id #uuid "317bb9c2-0240-5d1d-b8f8-bdef4487074c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∨R" :db/id #edb/ref 17592186378551}] :answer-field/correct {:answer/id #uuid "8f27be41-5974-5971-9b11-5b508a5bf90a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(P∨Q)∨R" :db/id #edb/ref 17592186378550} :answer-field/id #uuid "0b1fac27-c0cd-5308-af4a-258bcdb90eca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378546}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7611f5de-4aff-57f9-acd6-7bfb622415d1" :question/math-academy-id "q-127973" :question/problem "Simplify $(P∨Q)∨(Q∨R).$" :question/worked-solution "Using the associative and idempotent laws, we get\n\n$$\n\\begin{aligned}(P∨Q)∨(Q∨R) & ≡((P∨Q)∨Q)∨R \\\\  & ≡(P∨(Q∨Q))∨R \\\\  & ≡(P∨Q)∨R.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378580 :knowledge-point/_questions [{:db/id #edb/ref 17592186157240 :knowledge-point/id #uuid "331fa12f-a113-5aba-bd6e-5bd5bf62298f" :knowledge-point/title "Simplifying Symbolic Statements Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65472356-f9c2-5150-9218-550ac82a0d89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∧C)∨B" :db/id #edb/ref 17592186378582} {:answer/id #uuid "53533b77-c826-517c-b640-b47e0f9e3c80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨C" :db/id #edb/ref 17592186378583} {:answer/id #uuid "3e24e92e-e217-5102-a6e8-52ae47fc9d3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∧C)∧B" :db/id #edb/ref 17592186378584} {:answer/id #uuid "342724a5-4f1f-5147-95e9-39458335051b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∨C)∧B" :db/id #edb/ref 17592186378585} {:answer/id #uuid "722262c2-a9e9-5588-89b2-8e371cdfc30e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∨C)∨B" :db/id #edb/ref 17592186378586}] :answer-field/correct {:answer/id #uuid "722262c2-a9e9-5588-89b2-8e371cdfc30e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∨C)∨B" :db/id #edb/ref 17592186378586} :answer-field/id #uuid "5aabfb69-0432-50db-89ca-330b25cab9fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378581}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a787032c-44b0-561f-8f0b-52f38953bf0c" :question/math-academy-id "q-128516" :question/problem "Simplify $A∨(C∨(B∧B)).$" :question/worked-solution "Using the associative and idempotent laws, we get\n\n$$\n\\begin{aligned}A∨(C∨(B∧B)) & ≡A∨(C∨B) \\\\  & ≡(A∨C)∨B.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378587 :knowledge-point/_questions [{:db/id #edb/ref 17592186157241 :knowledge-point/id #uuid "149709f4-f9d8-529f-87af-a022ec1d46a8" :knowledge-point/title "Simplifying Sentences Using the Commutative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbfac57f-020d-52b3-ad37-9821bbf0beb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ is divisible by $3$ or $2$" :db/id #edb/ref 17592186378589} {:answer/id #uuid "cab0b42d-7e9a-5bb8-87c4-473c1bd37fe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ is divisible by $3$ and $2$" :db/id #edb/ref 17592186378590} {:answer/id #uuid "9f3264b9-a08d-53d6-ba63-0d1ac025c8f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ is divisible by $2$ but not by $3$" :db/id #edb/ref 17592186378591} {:answer/id #uuid "47565ba1-0f58-565c-8252-46bdce34dc43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ is divisible by $3$" :db/id #edb/ref 17592186378592} {:answer/id #uuid "77967022-afb3-5e7b-a142-02d7cf313bfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ is divisible by $3$ but not by $2$" :db/id #edb/ref 17592186378593}] :answer-field/correct {:answer/id #uuid "cab0b42d-7e9a-5bb8-87c4-473c1bd37fe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ is divisible by $3$ and $2$" :db/id #edb/ref 17592186378590} :answer-field/id #uuid "6985d158-a011-58b4-8bc9-1e36bb1fde28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378588}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a460320-13cc-5323-976d-d299cba54735" :question/math-academy-id "q-128523" :question/problem "Identify the sentence that is equivalent to the following: \"$6$ is divisible by $2$ and it is divisible by $3.$\"" :question/worked-solution "First, let's write the sentence more concisely:\n\n\"$6$ is divisible by $2$ and $3.$\"\n\nUsing the commutative law, we can swap the order of the numbers \"$2$\" and \" $3.$\" The sentence now reads\n\n\"$6$ is divisible by $3$ and $2.$\""}] [{:db/id #edb/ref 17592186572693 :knowledge-point/_questions [{:db/id #edb/ref 17592186157242 :knowledge-point/id #uuid "1e18ca89-35ef-5360-b3a1-8c9496247abb" :knowledge-point/title "Simplifying Symbolic Statements Using the Commutative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "428a7000-87f8-574a-b165-faf77e2503d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B∧A" :db/id #edb/ref 17592186572395} {:answer/id #uuid "473f1abd-f24c-5e83-aa4b-ba852c22e489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186572401} {:answer/id #uuid "645bff79-8345-53ff-9db5-d834609884bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B" :db/id #edb/ref 17592186572434} {:answer/id #uuid "83e753b0-ad8d-59e9-b744-b3bc1620b5a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B∨A" :db/id #edb/ref 17592186572458} {:answer/id #uuid "a84af6db-a147-5333-bbd1-35ac479b2e48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧(B∨A)" :db/id #edb/ref 17592186572494}] :answer-field/correct {:answer/id #uuid "83e753b0-ad8d-59e9-b744-b3bc1620b5a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B∨A" :db/id #edb/ref 17592186572458} :answer-field/id #uuid "eb39d5b7-afe7-5304-9593-d45a86244179" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572655}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5aad22c2-f4b5-5b1b-92ab-159f5eea4c65" :question/math-academy-id "q-128616" :question/problem "Simplify $(A∨B)∨A.$" :question/worked-solution "Using the commutative, associative, and idempotent laws, we get\n\n$$\n\\begin{aligned}(A∨B)∨A & ≡(B∨A)∨A \\\\  & ≡B∨(A∨A) \\\\  & ≡B∨A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186572696 :knowledge-point/_questions [{:db/id #edb/ref 17592186157242 :knowledge-point/id #uuid "1e18ca89-35ef-5360-b3a1-8c94