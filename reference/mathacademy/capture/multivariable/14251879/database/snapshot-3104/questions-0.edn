er/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The pen is blue and red." :db/id #edb/ref 17592186404222} {:answer/id #uuid "924f8062-92c3-57c2-a169-650f347777d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The pen is blue or red but not both." :db/id #edb/ref 17592186404223}] :answer-field/correct {:answer/id #uuid "0f1aeba2-f7a1-5ed9-8109-e70dd146aca4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The pen is blue or red." :db/id #edb/ref 17592186404221} :answer-field/id #uuid "ca5578dd-0a57-5cc2-809c-152390f18874" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404218}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ae3ad46-5289-52fe-9fde-b40fc7aa7003" :question/math-academy-id "q-82720" :question/problem "Simplify the following sentence: \"The pen is blue and it is a blue pen, or the pen is blue or it is a red pen.\"" :question/worked-solution "First, we simplify the phrase \"the pen is blue and it is a blue pen\" to just \"the pen is blue.\" The sentence now reads\n\n\"The pen is blue, or the pen is blue or it is a red pen.\"\n\nThen, using the associative law, we can move the comma in the sentence:\n\n\"The pen is blue or the pen is blue, or it is a red pen.\"\n\nNow, we simplify the phrase \"the pen is blue or the pen is blue\" to just \"the pen is blue.\" The sentence now reads\n\n\"The pen is blue, or it is a red pen.\"\n\nFinally, we simplify the sentence to\n\n\"The pen is blue or red.\""}] [{:db/id #edb/ref 17592186157823 :knowledge-point/_questions [{:db/id #edb/ref 17592186157241 :knowledge-point/id #uuid "149709f4-f9d8-529f-87af-a022ec1d46a8" :knowledge-point/title "Simplifying Sentences Using the Commutative Law"}] :question/answer-fields [{:answer-field/choices [{:answer