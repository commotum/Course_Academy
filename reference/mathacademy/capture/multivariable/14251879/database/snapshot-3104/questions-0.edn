nt :answer.type/text} :answer/value "The marker is purple and black." :db/id #edb/ref 17592186394460} {:answer/id #uuid "57fc7e4d-8296-5795-b432-65971ee7c6ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The marker is black." :db/id #edb/ref 17592186394461}] :answer-field/correct {:answer/id #uuid "c3cac5ef-1b47-5caf-a2e4-d08061715839" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The marker is purple or black." :db/id #edb/ref 17592186394457} :answer-field/id #uuid "fe3d96ad-4b61-540e-96d0-27c595924a8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394456}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d7ddd93-2035-565c-b8ce-d5d380ba961f" :question/math-academy-id "q-82723" :question/problem "Simplify the following sentence: \"The marker is black or it is purple, or it is black.\"" :question/worked-solution "Using the commutative law, we can replace the phrase \"the marker is black or it is purple\" with the phrase \"the marker is purple or it is black.\" The sentence now reads\n\n\"The marker is purple or it is black, or it is black.\"\n\nThen, using the associative law, we can move the comma:\n\n\"The marker is purple, or it is black or it is black.\"\n\nNow, we can simplify the phrase \"it is black or it is black\" to just \"it is black.\" The sentence now reads\n\n\"The marker is purple, or it is black.\"\n\nFinally, we can write the sentence more concisely:\n\n\"The marker is purple or black.\""}] [{:db/id #edb/ref 17592186404447 :knowledge-point/_questions [{:db/id #edb/ref 17592186157239 :knowledge-point/id #uuid "857d696d-6a3f-5fff-a5e1-b05148f28f55" :knowledge-point/title "Simplifying Sentences Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b5b70db-2b05-51ba-8