#{[{:activity/first-step {:db/id #edb/ref 17592186158028} :activity/id #uuid "1edb2ed5-a24c-5fb1-ac9e-f2c5f14ef8a6" :activity/scope {:db/id #edb/ref 17592186049824 :topic/id #uuid "16d9828c-8d8f-5f94-9530-7dc3e79040cf" :topic/math-academy-id 2830} :activity/steps [{:db/id #edb/ref 17592186158028 :step/content {:db/id #edb/ref 17592186158576 :tutorial/content "The **associative law for conjunctions** states that when we have multiple conjunctions in a row, the placement of parentheses does not matter:\n\n$$(A \\land B) \\land C \\equiv A \\land (B \\land C)$$\n\nWe can prove this equivalence using a truth table.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,C\\,$ | $\\, A \\land B\\,$ | $\\, B \\land C\\,$ | $\\, (A \\land B) \\land C\\,$ | $\\, A\\land (B \\land C)\\,$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n\nIn natural language, the associative law for conjunctions amounts to moving a comma between \"and\" statements. For example, the associative law states that the sentence\n\n$$\\underbrace{\\vphantom{p}\\textrm{The cat is quiet}}_{(A} \\quad \\underbrace{\\textrm{and}\\vphantom{p}}_{\\land} \\quad \\underbrace{\\vphantom{p}\\textrm{the dog is loud}}_{B)} \\quad , \\quad \\underbrace{\\vphantom{p}\\textrm{and}}_{\\land} \\quad \\underbrace{\\vphantom{p}\\textrm{the turtle is slow}}_{C}$$\n\nis logically equivalent to the sentence\n\n$$\\underbrace{\\vphantom{p}\\textrm{The cat is quiet}}_{A} \\quad , \\quad \\underbrace{\\vphantom{p}\\textrm{and}}_{\\land} \\quad \\underbrace{\\vphantom{p}\\textrm{the dog is loud}}_{(B} \\quad \\underbrace{\\textrm{and}\\vphantom{p}}_{\\land} \\quad \\underbrace{\\textrm{the turtle is slow}}_{C)}.$$" :tutorial/id #uuid "ce01eb47-13d6-5f82-8e3e-f1bd91846d71" :tutorial/math-academy-id 7974 :tutorial/title "Introduction"} :step/id #uuid "7d8dc71c-270b-5830-a591-a5450808c4c5" :step/math-academy-id 153690 :step/next {:db/id #edb/ref 17592186158029}} {:db/id #edb/ref 17592186158029 :step/content {:db/id #edb/ref 17592186158586 :tutorial/content "The **associative law for disjunctions** is similar:\n\n$$(A \\lor B) \\lor C \\equiv A \\lor (B \\lor C)$$\n\nWe can prove this equivalence using a truth table.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,C\\,$ | $\\, A \\lor B\\,$ | $\\, B \\lor C\\,$ | $\\, (A \\lor B) \\lor C\\,$ | $\\, A\\lor (B \\lor C)\\,$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n\nIn natural language, the associative law for disjunctions amounts to moving a comma between \"or\" statements. For example, the associative law states that the sentence\n\n$$\\underbrace{\\vphantom{p}\\textrm{The cat is quiet}}_{(A} \\quad \\underbrace{\\textrm{or}\\vphantom{p}}_{\\lor} \\quad \\underbrace{\\vphantom{p}\\textrm{the dog is loud}}_{B)} \\quad , \\quad \\underbrace{\\vphantom{p}\\textrm{or}}_{\\lor} \\quad \\underbrace{\\vphantom{p}\\textrm{the turtle is slow}}_{C}$$\n\nis logically equivalent to the sentence\n\n$$\\underbrace{\\vphantom{p}\\textrm{The cat is quiet}}_{A} \\quad , \\quad \\underbrace{\\vphantom{p}\\textrm{or}}_{\\lor} \\quad \\underbrace{\\vphantom{p}\\textrm{the dog is loud}}_{(B} \\quad \\underbrace{\\textrm{or}\\vphantom{p}}_{\\lor} \\quad \\underbrace{\\textrm{the turtle is slow}}_{C)}.$$" :tutorial/id #uuid "c6260eed-7f32-50cb-8351-8a4f61b4f3fe" :tutorial/math-academy-id 9053 :tutorial/title "The Associative Law for Disjunctions"} :step/id #uuid "0e89e049-ffb3-5480-a3b3-55323e3b4f5b" :step/math-academy-id 153691 :step/next {:db/id #edb/ref 17592186158030}} {:db/id #edb/ref 17592186158030 :step/content {:db/id #edb/ref 17592186157239 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157003 :question/id #uuid "a14e5d71-82ca-5df6-8875-f28eece240c6" :question/math-academy-id "e-12697"} :knowledge-point/id #uuid "857d696d-6a3f-5fff-a5e1-b05148f28f55" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048778}] :knowledge-point/questions [{:db/id #edb/ref 17592186157821} {:db/id #edb/ref 17592186157822} {:db/id #edb/ref 17592186378594} {:db/id #edb/ref 17592186378601} {:db/id #edb/ref 17592186380249} {:db/id #edb/ref 17592186404447}] :knowledge-point/title "Simplifying Sentences Using the Associative Law"} :step/id #uuid "6d7662d2-2b02-5f6e-8668-bc055379040c" :step/math-academy-id 153692 :step/next {:db/id #edb/ref 17592186158031}} {:db/id #edb/ref 17592186158031 :step/content {:db/id #edb/ref 17592186157240 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157004 :question/id #uuid "ec2031e2-5f0b-5f12-bf52-1ef26fd84b61" :question/math-academy-id "e-12698"} :knowledge-point/id #uuid "331fa12f-a113-5aba-bd6e-5bd5bf62298f" :knowledge-point/questions [{:db/id #edb/ref 17592186157600} {:db/id #edb/ref 17592186157819} {:db/id #edb/ref 17592186378545} {:db/id #edb/ref 17592186378580} {:db/id #edb/ref 17592186380256} {:db/id #edb/ref 17592186387894} {:db/id #edb/ref 17592186394820}] :knowledge-point/title "Simplifying Symbolic Statements Using the Associative Law"} :step/id #uuid "f2c0043a-b347-50c7-90f8-e8e2974c3705" :step/math-academy-id 153695 :step/next {:db/id #edb/ref 17592186158032}} {:db/id #edb/ref 17592186158032 :step/content {:db/id #edb/ref 17592186158577 :tutorial/content "The **commutative law for conjunctions** states that we can switch the order of a conjunction:\n\n$$A \\land B \\equiv B \\land A$$\n\nWe can prove this result using a truth table.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A \\land B\\,$ | $\\,B \\land A\\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n\nIn natural language, the commutative law for conjunctions amounts to swapping two phrases surrounding the word \"and.\" For example, the commutative law states that the sentence\n\n$$\\underbrace{\\vphantom{p}\\textrm{The cat is quiet}}_{(A} \\quad \\underbrace{\\textrm{and}\\vphantom{p}}_{\\land} \\quad \\underbrace{\\vphantom{p}\\textrm{the dog is loud}}_{B)}$$\n\nis logically equivalent to the sentence\n\n$$\\underbrace{\\vphantom{p}\\textrm{The dog is loud}}_{(B} \\quad \\underbrace{\\textrm{and}\\vphantom{p}}_{\\land} \\quad \\underbrace{\\vphantom{p}\\textrm{the cat is quiet}}_{A)}.$$" :tutorial/id #uuid "e31a6885-bdfb-5354-8825-aecfd2a54a20" :tutorial/math-academy-id 7975 :tutorial/title "The Commutative Law for Conjunctions"} :step/id #uuid "4c21fc98-e914-5678-8b78-7b6fccb2e021" :step/math-academy-id 153698 :step/next {:db/id #edb/ref 17592186158033}} {:db/id #edb/ref 17592186158033 :step/content {:db/id #edb/ref 17592186158587 :tutorial/content "The **commutative law for disjunctions** is similar:\n\n$$A \\lor B \\equiv B \\lor A$$\n\nWe can prove this result using a truth table.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A \\lor B\\,$ | $\\,B \\lor A\\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n\nLikewise, in natural language, the commutative law for disjunctions amounts to swapping two phrases surrounding the word \"or.\" For example, the commutative law states that the sentence\n\n$$\\underbrace{\\vphantom{p}\\textrm{The cat is quiet}}_{(A} \\quad \\underbrace{\\textrm{or}\\vphantom{p}}_{\\lor} \\quad \\underbrace{\\vphantom{p}\\textrm{the dog is loud}}_{B)}$$\n\nis logically equivalent to the sentence\n\n$$\\underbrace{\\vphantom{p}\\textrm{The dog is loud}}_{(B} \\quad \\underbrace{\\textrm{or}\\vphantom{p}}_{\\lor} \\quad \\underbrace{\\vphantom{p}\\textrm{the cat is quiet}}_{A)}.$$" :tutorial/id #uuid "995e4380-991c-589d-9001-fc91cbd2d0b2" :tutorial/math-academy-id 9054 :tutorial/title "The Commutative Law for Disjunctions"} :step/id #uuid "71eb950d-a2bb-508b-a83b-f15317dd21a0" :step/math-academy-id 153699 :step/next {:db/id #edb/ref 17592186158034}} {:db/id #edb/ref 17592186158034 :step/content {:db/id #edb/ref 17592186157241 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157005 :question/id #uuid "1f69673c-7b2d-50ab-9df8-3de7c1933739" :question/math-academy-id "e-12699"} :knowledge-point/id #uuid "149709f4-f9d8-529f-87af-a022ec1d46a8" :knowledge-point/questions [{:db/id #edb/ref 17592186157823} {:db/id #edb/ref 17592186157824} {:db/id #edb/ref 17592186378587} {:db/id #edb/ref 17592186380228} {:db/id #edb/ref 17592186380270} {:db/id #edb/ref 17592186404224}] :knowledge-point/title "Simplifying Sentences Using the Commutative Law"} :step/id #uuid "a9f2076e-3568-5bf4-a054-9644fa797633" :step/math-academy-id 153700 :step/next {:db/id #edb/ref 17592186158035}} {:db/id #edb/ref 17592186158035 :step/content {:db/id #edb/ref 17592186157242 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157006 :question/id #uuid "fc7f518c-c6f3-5968-bc59-148277395bf9" :question/math-academy-id "e-12700"} :knowledge-point/id #uuid "1e18ca89-35ef-5360-b3a1-8c9496247abb" :knowledge-point/questions [{:db/id #edb/ref 17592186157601} {:db/id #edb/ref 17592186157820} {:db/id #edb/ref 17592186378608} {:db/id #edb/ref 17592186378615} {:db/id #edb/ref 17592186380263} {:db/id #edb/ref 17592186387915} {:db/id #edb/ref 17592186394462}] :knowledge-point/title "Simplifying Symbolic Statements Using the Commutative Law"} :step/id #uuid "7ef38ea9-0380-5b43-8ce2-a62160452609" :step/math-academy-id 153703}] :activity/title "Logical Associative and Commutative Laws" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157487}]}
