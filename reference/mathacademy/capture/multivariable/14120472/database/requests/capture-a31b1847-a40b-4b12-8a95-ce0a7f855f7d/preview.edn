f-5672-935c-ff24abe14152" 13194139534266 17592186045417 true] [17592186416639 1075 #edb/ref 17592186416620 13194139534266 17592186045417 true] [17592186416639 1075 #edb/ref 17592186416626 13194139534266 17592186045417 true] [17592186416639 1075 #edb/ref 17592186416628 13194139534266 17592186045417 true] [17592186416639 1075 #edb/ref 17592186416633 13194139534266 17592186045417 true] [17592186416639 1075 #edb/ref 17592186416635 13194139534266 17592186045417 true] [17592186416639 1076 #edb/ref 17592186045493 13194139534266 17592186045417 true] [17592186416639 1077 "selection" 13194139534266 17592186045417 true] [17592186416639 1078 #edb/ref 17592186416635 13194139534266 17592186045417 true] [17592186416639 1079 #uuid "4e908b69-05cf-5c42-8fda-9f3d685c5ae8" 13194139534266 17592186045417 true] [17592186416640 1075 #edb/ref 17592186416622 13194139534266 17592186045417 true] [17592186416640 1075 #edb/ref 17592186416623 13194139534266 17592186045417 true] [17592186416640 1075 #edb/ref 17592186416624 13194139534266 17592186045417 true] [17592186416640 1075 #edb/ref 17592186416630 13194139534266 17592186045417 true] [17592186416640 1075 #edb/ref 17592186416632 13194139534266 17592186045417 true] [17592186416640 1076 #edb/ref 17592186045493 13194139534266 17592186045417 true] [17592186416640 1077 "selection" 13194139534266 17592186045417 true] [17592186416640 1078 #edb/ref 17592186416630 13194139534266 17592186045417 true] [17592186416640 1079 #uuid "a35070d4-02b5-5d30-b418-f640a67c5011" 13194139534266 17592186045417 true] [17592186416641 1075 #edb/ref 17592186416621 13194139534266 17592186045417 true] [17592186416641 1075 #edb/ref 17592186416625 13194139534266 17592186045417 true] [17592186416641 1075 #edb/ref 17592186416629 13194139534266 17592186045417 true] [17592186416641 1075 #edb/ref 17592186416631 13194139534266 17592186045417 true] [17592186416641 1075 #edb/ref 17592186416637 13194139534266 17592186045417 true] [17592186416641 1076 #edb/ref 17592186045493 13194139534266 17592186045417 true] [17592186416641 1077 "selection" 13194139534266 17592186045417 true] [17592186416641 1078 #edb/ref 17592186416637 13194139534266 17592186045417 true] [17592186416641 1079 #uuid "d3788d99-c3b5-5c40-99f4-4ba2896c1904" 13194139534266 17592186045417 true] [17592186416642 1068 #edb/ref 17592186416639 13194139534266 17592186045417 true] [17592186416642 1069 "q-152023" 13194139534266 17592186045417 true] [17592186416642 1070 #edb/ref 17592186045487 13194139534266 17592186045417 true] [17592186416642 1071 "In a plumbing store, the length of a water pipe is normally distributed with a mean of $2\\,\\text{m}$ and a standard deviation of $0.05\\,\\text{m}.$ If Carl bought $25$ pipes, what is the probability that the total length of the pipes he purchased is more than $49.8\\,m$ and less $50.2\\,m?$ It can be assumed that the lengths of pipes are mutually independent.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\,0.7\\,$ | $\\,0.7580\\,$ | $\\,0.7611\\,$ | $\\,0.7642\\,$ | $\\,0.7673\\,$ |\n| $\\,0.8\\,$ | $\\,0.7881\\,$ | $\\,0.7910\\,$ | $\\,0.7939\\,$ | $\\,0.7967\\,$ |\n| $\\,0.9\\,$ | $\\,0.8159\\,$ | $\\,0.8186\\,$ | $\\,0.8212\\,$ | $\\,0.8238\\,$ |" 13194139534266 17592186045417 true] [17592186416642 1072 #uuid "059f78b6-6d35-5bee-b74d-2081324d31e2" 13194139534266 17592186045417 true] [17592186416642 1074 "Let ${X}_{i}$ denote the length in the $i$th pipe. Then, we have\n\n$$\n{X}_{i}∼N(2,{0.05}^{2}),\\,1\\le i\\le 25.\n$$\n\nLet the random variable $L$ denote the total length of $25$ randomly selected pipes. Then, since\n\n$$\nL={X}_{1}+{X}_{2}+⋯+{X}_{25},\n$$\n\nwe have that $L$ is normally distributed, where\n\n$$\n\\begin{aligned}\\text{E}[L] & =25\\cdot 2 \\\\  & =50, \\\\ \\text{Var}[L] & =25\\cdot {0.05}^{2} \\\\  & =0.0625.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nL∼N(50,0.0625).\n$$\n\nIn order to find $P(49.8<L<50.2),$ we convert $L$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(49.8<L<50.2) & =P(\\frac{49.8-50}{\\sqrt{0.0625}}<Z<\\frac{50.2-50}{\\sqrt{0.0625}}) \\\\  & ≈P(-0.8<Z<0.8) \\\\  & =1-2P(Z>0.8) \\\\  & =1-2[1-P(Z<0.8)] \\\\  & =2P(Z<0.8)-1 \\\\  & =2Φ(0.8)-1\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\nΦ(0.8)≈0.7881.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(49.8<L<50.2) & ≈2Φ(0.8)-1 \\\\  & ≈2\\cdot 0.7881-1 \\\\  & ≈0.5762.\\end{aligned}\n$$" 13194139534266 17592186045417 true] [17592186416643 1068 #edb/ref 17592186416641 13194139534266 17592186045417 true] [17592186416643 1069 "q-152013" 13194139534266 17592186045417 true] [17592186416643 1070 #edb/ref 17592186045486 13194139534266 17592186045417 true] [17592186416643 1071 "Given that ${X}_{1},{X}_{2},…,{X}_{16}$ are I.I.D random variables, where\n\n$$\n{X}_{i}∼N(0.5,{0.3}^{2}),\\,1\\le i\\le 16,\n$$\n\ncalculate $P(8\\le Y\\le 9),$ where  $Y={X}_{1}+{X}_{2}+⋯+{X}_{16}.$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\,0.7\\,$ | $\\,0.7611\\,$ | $\\,0.7642\\,$ | $\\,0.7673\\,$ | $\\,0.7704\\,$ |\n| $\\,0.8\\,$ | $\\,0.7910\\,$ | $\\,0.7939\\,$ | $\\,0.7967\\,$ | $\\,0.7995\\,$ |\n| $\\,0.9\\,$ | $\\,0.8186\\,$ | $\\,0.8212\\,$ | $\\,0.8238\\,$ | $\\,0.8264\\,$ |" 13194139534266 17592186045417 true] [17592186416643 1072 #uuid "c445f3d3-7d56-5451-92cd-caec3d662075" 13194139534266 17592186045417 true] [17592186416643 1074 "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed (I.I.D) normal random variables, where \n\n$$\n{X}_{i}∼N(\\mu ,{\\sigma }^{2}),\\,1\\le i\\le n,\n$$\n\nthen \n\n$$\nY={X}_{1}+{X}_{2}+⋯+{X}_{n}∼N(n\\mu ,\\,n{\\sigma }^{2}).\n$$\n\nTherefore, since ${X}_{1},{X}_{2},…,{X}_{16}$ are independent and identically distributed, we have \n\n$$\n\\begin{aligned}Y={X}_{1}+{X}_{2}+⋯+{X}_{16} & ∼N(16\\cdot 0.5,\\,16\\cdot {0.3}^{2}) \\\\  & ∼N(16\\cdot 0.5,\\,16\\cdot 0.09) \\\\  & =N(8,1.44).\\end{aligned}\n$$\n\nWe wish to compute the probability $P(8\\le Y\\le 9).$ We first convert $Y$ into a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(8\\le Y\\le 9) & =P(\\frac{8-8}{\\sqrt{1.44}}\\le Z\\le \\frac{9-8}{\\sqrt{1.44}}) \\\\  & =P(\\frac{0}{1.2}\\le Z\\le \\frac{1}{1.2}) \\\\  & =P(0\\le Z\\le 0.83) \\\\  & =Φ(0.83)-Φ(0) \\\\  & =Φ(0.83)-0.5\\end{aligned}\n$$\n\nFrom the $z$-table, we have\n\n$$\nΦ(0.83)=0.7967\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(8\\le Y\\le 9) & =Φ(0.83)-0.5 \\\\  & =0.7967-0.5 \\\\  & =0.2967.\\end{aligned}\n$$" 13194139534266 17592186045417 true] [17592186416644 1068 #edb/ref 17592186416638 13194139534266 17592186045417 true] [17592186416644 1069 "q-143339" 13194139534266 17592186045417 true] [17592186416644 1070 #edb/ref 17592186045487 13194139534266 17592186045417 true] [17592186416644 1071 "Given that ${X}_{1},{X}_{2},…,{X}_{15}$ are I.I.D random variables, where\n\n$$\n{X}_{i}∼N(0,{(\\frac{2}{5})}^{2}),\\,1\\le i\\le 15,\n$$\n\ncalculate $P(Y\\ge 1),$ where  $Y={X}_{1}+{X}_{2}+⋯+{X}_{15}.$\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.04\\,$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\,0.5\\,$ | $\\,0.7054\\,$ | $\\,0.7088\\,$ | $\\,0.7123\\,$ | $\\,0.7157\\,$ |\n| $\\,0.6\\,$ | $\\,0.7389\\,$ | $\\,0.7422\\,$ | $\\,0.7454\\,$ | $\\,0.7486\\,$ |\n| $\\,0.7\\,$ | $\\,0.7704\\,$ | $\\,0.7734\\,$ | $\\,0.7764\\,$ | $\\,0.7794\\,$ |" 13194139534266 17592186045417 true] [17592186416644 1072 #uuid "c95c5475-5100-54a8-b160-4567ec570e4d" 13194139534266 17592186045417 true] [17592186416644 1074 "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed (I.I.D) normal random variables, where \n\n$$\n{X}_{i}∼N(\\mu ,{\\sigma }^{2}),\\,1\\le i\\le n,\n$$\n\nthen \n\n$$\nY={X}_{1}+{X}_{2}+⋯+{X}_{n}∼N(n\\mu ,\\,n{\\sigma }^{2}).\n$$\n\nTherefore, since ${X}_{1},{X}_{2},…,{X}_{15}$ are independent and identically distributed, we have \n\n$$\n\\begin{aligned}Y={X}_{1}+{X}_{2}+⋯+{X}_{15} & ∼N(15\\cdot 0,\\,15\\cdot {(\\frac{2}{5})}^{2}) \\\\  & ∼N(15\\cdot 0,\\,15\\cdot \\frac{4}{25}) \\\\  & =N(0,\\frac{12}{5}).\\end{aligned}\n$$\n\nWe wish to compute the probability $P(Y\\ge 1).$ We first convert $Y$ into a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\ge 1) & =P(Z\\ge \\frac{1-0}{\\sqrt{\\frac{12}{5}}}) \\\\  & =P(Z\\ge \\sqrt{\\frac{5}{12}}) \\\\  & =P(Z\\ge 0.65) \\\\  & =1-P(Z\\le 0.65) \\\\  & =1-Φ(0.65)\\end{aligned}\n$$\n\nFrom the $z$-table, we have\n\n$$\nΦ(0.65)=0.7422.\n$$\n\nTherefore,\n\n$$\nP(Y\\ge 1)=1-Φ(0.65)=0.2578.\n$$" 13194139534266 17592186045417 true] [17592186416645 1068 #edb/ref 17592186416640 13194139534266 17592186045417 true] [17592186416645 1069 "q-143408" 13194139534266 17592186045417 true] [17592186416645 1070 #edb/ref 17592186045486 13194139534266 17592186045417 true] [17592186416645 1071 "The time it takes John to get to school, in minutes, is normally distributed with a mean of $20\\,\\text{min}$ and a standard deviation of $6\\,\\text{min}.$\nWhat is the probability that the sum of the times John takes to get to school on $5$ randomly selected school days is more than $90\\,\\text{min}?$\nYou may assume that the times of each day are mutually independent.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ | $\\,0.05\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\,0.5\\,$ | $\\,0.6985\\,$ | $\\,0.7019\\,$ | $\\,0.7054\\,$ | $\\,0.7088\\,$ |\n| $\\,0.6\\,$ | $\\,0.7324\\,$ | $\\,0.7357\\,$ | $\\,0.7389\\,$ | $\\,0.7422\\,$ |\n| $\\,0.7\\,$ | $\\,0.7642\\,$ | $\\,0.7673\\,$ | $\\,0.7704\\,$ | $\\,0.7734\\,$ |" 13194139534266 17592186045417 true] [17592186416645 1072 #uuid "ca09d1d4-8ed3-5be9-8d9b-e96bfc72481d" 13194139534266 17592186045417 true] [17592186416645 1074 "Let ${X}_{i}$ denote the time it took John to get to school on the $i$th day. Then, we have\n\n$$\n{X}_{i}∼N(20,{6}^{2}),\\,1\\le i\\le 5.\n$$\n\nLet the random variable $W$ denote the time John takes to get to school on $5$ randomly selected days. Then, since\n\n$$\nW={X}_{1}+{X}_{2}+⋯+{X}_{5},\n$$\n\nwe have that $W$ is normally distributed, where\n\n$$\n\\begin{aligned}\\text{E}[W] & =5\\cdot 20 \\\\  & =100, \\\\ \\text{Var}[W] & =5\\cdot {6}^{2} \\\\  & =180.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nW∼N(100,180).\n$$\n\nIn order to find $P(W>90),$ we convert $W$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(W>90) & =P(Z>\\frac{90-100}{\\sqrt{180}}) \\\\  & ≈P(Z>-0.75) \\\\  & =P(Z<0.75)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\nΦ(0.75)≈0.7734.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(W>90) & ≈0.7734.\\end{aligned}\n$$" 13194139534266 17592186045417 true]] :edb/tempids {"answer-020bc723-6af1-5316-aaf4-e9de001b448a" 17592186416618 "answer-0b1b048e-b282-560b-8713-335a9004952e" 17592186416619 "answer-16785778-8057-554c-8271-d87d44dd9e29" 17592186416620 "answer-29e4a75e-a311-5d28-9bf0-f84a736c11a0" 17592186416621 "answer-3121b90f-0af1-5d7b-81b3-a401dae948b6" 17592186416622 "answer-38ccee7a-03a8-518f-922b-65abb94e2d9d" 17592186416623 "answer-42557eb4-4a13-5772-9500-1fb4860965eb" 17592186416624 "answer-43cc1043-6ae8-5d14-8170-f1ce77fb6d3c" 17592186416625 "answer-60af78be-1051-5303-9f10-219c33144a4b" 17592186416626 "answer-693ff683-c441-5136-b7ec-abf843bb1296" 175