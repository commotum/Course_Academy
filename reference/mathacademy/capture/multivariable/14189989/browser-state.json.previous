><mo>=</mo><mi>e</mi><msup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mo>−</mo><mn>5</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></msup><mo>⋅</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mo>−</mo><mn>10</mn><mi>x</mi><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo>−</mo><mn>5</mn><mi>x</mi><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mi>x</mi></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>e</mi><msup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo>−</mo><mn>5</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></msup><mo>⋅</mo><mi>x</mi><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mo>−</mo><mn>10</mn><mi>x</mi><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo>−</mo><mn>5</mn><mi>x</mi><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>2</mn><mi>x</mi></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>e</mi><msup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo>−</mo><mn>5</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></msup><mo>⋅</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mn>10</mn><msup><mi>x</mi><mn>2</mn></msup><mi>ln</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>x</mi><mo>−</mo><mn>5</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn></mpadded></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
