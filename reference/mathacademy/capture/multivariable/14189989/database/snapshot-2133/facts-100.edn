 17592186045417] [17592186504567 #edb/ref 1079 #uuid "ba9151a4-b3b8-572e-a482-a0acf45515d6" #edb/ref 17592186045417] [17592186504574 #edb/ref 1075 #edb/ref 17592186504063 #edb/ref 17592186045417] [17592186504574 #edb/ref 1075 #edb/ref 17592186504136 #edb/ref 17592186045417] [17592186504574 #edb/ref 1075 #edb/ref 17592186504144 #edb/ref 17592186045417] [17592186504574 #edb/ref 1075 #edb/ref 17592186504320 #edb/ref 17592186045417] [17592186504574 #edb/ref 1075 #edb/ref 17592186504420 #edb/ref 17592186045417] [17592186504574 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186504574 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186504574 #edb/ref 1078 #edb/ref 17592186504136 #edb/ref 17592186045417] [17592186504574 #edb/ref 1079 #uuid "c8108104-8398-500c-9620-e32d585bdb8d" #edb/ref 17592186045417] [17592186504581 #edb/ref 1075 #edb/ref 17592186504349 #edb/ref 17592186045417] [17592186504581 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186504581 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186504581 #edb/ref 1078 #edb/ref 17592186504349 #edb/ref 17592186045417] [17592186504581 #edb/ref 1079 #uuid "d1418ec4-9e2c-5aec-b01d-aff904f686c2" #edb/ref 17592186045417] [17592186504589 #edb/ref 1075 #edb/ref 17592186504078 #edb/ref 17592186045417] [17592186504589 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186504589 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186504589 #edb/ref 1078 #edb/ref 17592186504078 #edb/ref 17592186045417] [17592186504589 #edb/ref 1079 #uuid "e5ec8274-52d3-526d-accb-2a89c9a62542" #edb/ref 17592186045417] [17592186504612 #edb/ref 1068 #edb/ref 17592186504497 #edb/ref 17592186045417] [17592186504612 #edb/ref 1069 "q-138809" #edb/ref 17592186045417] [17592186504612 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186504612 #edb/ref 1071 "Consider the function $y=(\\sqrt{x})^{x}.$ Its derivative is given by \n\n$$\n{y}^{′}=\\frac{1}{2}{(\\sqrt{x})}^{x}\\cdot g(x).\n$$\n\nFind the function $g(x).$" #edb/ref 17592186045417] [17592186504612 #edb/ref 1072 #uuid "22063a8c-2673-5c08-b0b7-4fcd50355c5f" #edb/ref 17592186045417] [17592186504612 #edb/ref 1074 "We have the function \n\n$$\ny=(\\sqrt{x})^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\sqrt{x})^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(\\sqrt{x})\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(\\sqrt{x})) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(x)^{′}\\cdot (\\operatorname{ln}⁡(\\sqrt{x}))+(x)\\cdot {(\\operatorname{ln}⁡(\\sqrt{x}))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =1\\cdot \\operatorname{ln}⁡(\\sqrt{x})+x\\cdot (\\frac{1}{\\sqrt{x}}\\cdot \\frac{1}{2\\sqrt{x}}) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡(\\sqrt{x})+\\frac{1}{2} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{2}\\operatorname{ln}⁡(x)+\\frac{1}{2} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{2}(\\operatorname{ln}⁡(x)+1)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{1}{2}y(\\operatorname{ln}⁡(x)+1)\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\sqrt{x})^{x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{1}{2}(\\sqrt{x})^{x}(\\operatorname{ln}⁡(x)+1)\\end{aligned}\n$$\n\nTherefore, $g(x)=(\\operatorname{ln}⁡(x)+1).$" #edb/ref 17592186045417] [17592186504618 #edb/ref 1068 #edb/ref 17592186504552 #edb/ref 17592186045417] [17592186504618 #edb/ref 1069 "q-138791" #edb/ref 17592186045417] [17592186504618 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186504618 #edb/ref 1071 "Consider the function $y={x}^{5{x}^{2}-2}.$ Its derivative is given by\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={x}^{5{x}^{2}-3}\\cdot g(x).\n$$\n\nFind the function $g(x).$" #edb/ref 17592186045417] [17592186504618 #edb/ref 1072 #uuid "358ad886-8781-5867-add0-1dfbbd99e7fd" #edb/ref 17592186045417] [17592186504618 #edb/ref 1074 "We have the function \n\n$$\ny={x}^{5{x}^{2}-2}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{5{x}^{2}-2}) \\\\ \\operatorname{ln}⁡y & =(5{x}^{2}-2)\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}((5{x}^{2}-2)\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{2}-2)\\cdot (\\operatorname{ln}⁡x)+(5{x}^{2}-2)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =10x\\cdot \\operatorname{ln}⁡x+(5{x}^{2}-2)\\cdot \\frac{1}{x} \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =10x\\operatorname{ln}⁡x+\\frac{5{x}^{2}-2}{x}\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y(\\frac{5{x}^{2}-2}{x}+10x\\operatorname{ln}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y={x}^{5{x}^{2}-2}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={x}^{5{x}^{2}-2}(\\frac{5{x}^{2}-2}{x}+10x\\operatorname{ln}⁡x) \\\\  & ={x}^{5{x}^{2}-2}(\\frac{5{x}^{2}-2}{x}+\\frac{10{x}^{2}\\operatorname{ln}⁡x}{x}) \\\\  & ={x}^{5{x}^{2}-3}(5{x}^{2}+10{x}^{2}\\operatorname{ln}⁡x-2)\\end{aligned}\n$$\n\nTherefore, $g(x)=5{x}^{2}+10{x}^{2}\\operatorname{ln}⁡x-2.$" #edb/ref 17592186045417] [17592186504623 #edb/ref 1068 #edb/ref 17592186504507 #edb/ref 17592186045417] [17592186504623 #edb/ref 1069 "q-138749" #edb/ref 17592186045417] [17592186504623 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186504623 #edb/ref 1071 "Consider the function $y=6{x}^{x}.$ Its derivative is given by\n\n$$\n{y}^{′}=6{x}^{x}\\cdot g(x).\n$$\n\nFind the function $g(x).$" #edb/ref 17592186045417] [17592186504623 #edb/ref 1072 #uuid "3fe57972-490a-52da-b89f-179c602b71c5" #edb/ref 17592186045417] [17592186504623 #edb/ref 1074 "We have the function \n\n$$\ny=6{x}^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(6{x}^{x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡6+\\operatorname{ln}⁡{x}^{x} \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡6+x\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡6+x\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & ={(\\operatorname{ln}⁡6)}^{′}+(x)^{′}\\cdot (\\operatorname{ln}⁡x)+(x)\\cdot {(\\operatorname{ln}⁡x)}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =0+1\\cdot \\operatorname{ln}⁡x+x\\cdot \\frac{1}{x} \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡x+1\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\operatorname{ln}⁡x+1)\\end{aligned}\n$$\n\nFinally, we substitute $y=6{x}^{x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =6{x}^{x}(\\operatorname{ln}⁡x+1)\\end{aligned}\n$$\n\nTherefore, $g(x)=\\operatorname{ln}⁡x+1$" #edb/ref 17592186045417] [17592186504637 #edb/ref 1068 #edb/ref 17592186504499 #edb/ref 17592186045417] [17592186504637 #edb/ref 1069 "q-341951" #edb/ref 17592186045417] [17592186504637 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186504637 #edb/ref 1071 "Find the slope $m$ of the tangent line to the curve $y=(\\operatorname{ln}⁡(3x))^{{x}^{2}}$ at $x=\\frac{e}{3}.$\n\n$m=$\n{{field-1}}" #edb/ref 17592186045417] [17592186504637 #edb/ref 1072 #uuid "650ff22d-86ac-5784-9e2d-04a2cd40b0db" #edb/ref 17592186045417] [17592186504637 #edb/ref 1074 "The slope of the tangent to the curve at $x=\\frac{e}{3}$ equals the function's derivative at the corresponding point.\n\nWe have the function \n\n$$\ny=(\\operatorname{ln}⁡(3x))^{{x}^{2}}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{ln}⁡(3x))^{{x}^{2}}) \\\\ \\operatorname{ln}⁡y & ={x}^{2}\\,\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}\\,\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =({x}^{2})^{′}\\cdot (\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x)))+({x}^{2})\\cdot {(\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x)))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2x\\cdot \\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))+{x}^{2}\\cdot (\\frac{1}{\\operatorname{ln}⁡(3x)}\\cdot \\frac{1}{x}) \\\\ \\frac{{y}^{′}}{y} & =2x\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))+\\frac{x}{\\operatorname{ln}⁡(3x)}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(2x\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))+\\frac{x}{\\operatorname{ln}⁡(3x)})\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{ln}⁡(3x))^{{x}^{2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =(\\operatorname{ln}⁡(3x))^{{x}^{2}}(2x\\operatorname{ln}⁡(\\operatorname{ln}⁡(3x))+\\frac{x}{\\operatorname{ln}⁡(3x)})\\end{aligned}\n$$\n\nTherefore, the slope of $y=(\\operatorname{ln}⁡(3x))^{{x}^{2}}$ at $x=\\frac{e}{3}$ is\n\n$$\n\\begin{aligned}m={y}^{′}{|}_{x=e/3} & =(\\operatorname{ln}⁡(e))^{(e/3)^{2}}(2(\\frac{e}{3})\\operatorname{ln}⁡(\\operatorname{ln}⁡(e))+\\frac{(\\frac{e}{3})}{\\operatorname{ln}⁡(e)}) \\\\  & =(1)^{(e/3)^{2}}(2(\\frac{e}{3})\\operatorname{ln}⁡(1)+\\frac{(\\frac{e}{3})}{1}) \\\\  & =1\\cdot (0+\\frac{e}{3}) \\\\  & =\\frac{e}{3}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186504641 #edb/ref 1068 #edb/ref 17592186504508 #edb/ref 17592186045417] [17592186504641 #edb/ref 1069 "q-138837" #edb/ref 17592186045417] [17592186504641 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186504641 #edb/ref 1071 "Consider the function $y=(\\operatorname{tan}⁡x)^{x}.$ Its derivative is given by  \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=(\\operatorname{tan}⁡x)^{x}\\cdot g(x).\n$$\n\nFind the function $g(x).$" #edb/ref 17592186045417] [17592186504641 #edb/ref 1072 #uuid "73c29bd9-9c93-5235-9a81-b902322f8bb3" #edb/ref 17592186045417] [17592186504641 #edb/ref 1074 "We have the function \n\n$$\ny=(\\operatorname{tan}⁡x)^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{tan}⁡x)^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(\\operatorname{tan}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(\\operatorname{tan}⁡x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x)\\cdot (\\operatorname{ln}⁡(\\operatorname{tan}⁡x))+(x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(\\operatorname{tan}⁡x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1\\cdot \\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\cdot (\\frac{1}{\\operatorname{tan}⁡x}\\cdot {sec}^{2}⁡x) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\operatorname{csc}⁡x\\operatorname{sec}⁡x\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y(\\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\operatorname{csc}⁡x\\operatorname{sec}⁡x)\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{tan}⁡x)^{x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =(\\operatorname{tan}⁡x)^{x}(\\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\operatorname{csc}⁡x\\operatorname{sec}⁡x)\\end{aligned}\n$$\n\nTherefore, $g(x)=\\operatorname{ln}⁡(\\operatorname{tan}⁡x)+x\\operatorname{csc}⁡x\\operatorname{sec}⁡x.$" #edb/ref 17592186045417] [17592186504656 #edb/ref 1068 #edb/ref 17592186504581 #edb/ref 17592186045417] [17592186504656 #edb/ref 1069 "q-341907" #edb/ref 17592186045417] [17592186504656 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186504656 #edb/ref 1071 "Given that $y=(\\operatorname{sec}⁡(x))^{\\operatorname{sin}⁡(x)}$, find ${y}^{′}.$\n\n${y}^{′}=(\\operatorname{sec}⁡(x))^{\\operatorname{sin}⁡(x)}\\cdot (\\operatorname{cos}⁡(x)\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))\\,+$\n{{field-1}}$)$" #edb/ref 17592186045417] [17592186504656 #edb/ref 1072 #uuid "965ab36a-7265-52be-bed3-0fcb25681407" #edb/ref 17592186045417] [17592186504656 #edb/ref 1074 "We have the function \n\n$$\ny=(\\operatorname{sec}⁡(x))^{\\operatorname{sin}⁡(x)}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{sec}⁡(x))^{\\operatorname{sin}⁡(x)}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{sin}⁡(x)\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡(x)\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(\\operatorname{sin}⁡(x))^{′}\\cdot (\\operatorname{ln}⁡(\\operatorname{sec}⁡(x)))+(\\operatorname{sin}⁡(x))\\cdot {(\\operatorname{ln}⁡(\\operatorname{sec}⁡(x)))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\operatorname{cos}⁡(x)\\cdot \\operatorname{ln}⁡(\\operatorname{sec}⁡(x))+\\operatorname{sin}⁡(x)\\cdot (\\frac{1}{\\operatorname{sec}⁡x}\\cdot \\operatorname{sec}⁡(x)\\operatorname{tan}⁡(x)) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{cos}⁡(x)\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))+\\operatorname{sin}⁡(x)\\operatorname{tan}⁡(x)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\operatorname{cos}⁡(x)\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))+\\operatorname{sin}⁡(x)\\operatorname{tan}⁡(x))\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{sec}⁡(x)^{\\operatorname{sin}⁡(x)}:$\n\n$$\n\\begin{aligned}{y}^{′} & =(\\operatorname{sec}⁡(x))^{\\operatorname{sin}⁡(x)}\\cdot (\\operatorname{cos}⁡(x)\\,\\operatorname{ln}⁡(\\operatorname{sec}⁡(x))+\\operatorname{sin}⁡(x)\\operatorname{tan}⁡(x))\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186504657 #edb/ref 1068 #edb/ref 17592186504589 #edb/ref 17592186045417] [17592186504657 #edb/ref 1069 "q-341719" #edb/ref 17592186045417] [17592186504657 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186504657 #edb/ref 1071 "Given that $y=(5{x}^{2}+2x)^{x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=(5{x}^{2}+2x)^{x-1}\\cdot ($\n{{field-1}}$+10{x}^{2}+2x)$" #edb/ref 17592186045417] [17592186504657 #edb/ref 1072 #uuid "9798e200-13a6-549b-86eb-d44d6cb98aeb" #edb/ref 17592186045417] [17592186504657 #edb/ref 1074 "We have the function \n\n$$\ny=(5{x}^{2}+2x)^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((5{x}^{2}+2x)^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡(5{x}^{2}+2x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡(5{x}^{2}+2x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x)\\cdot (\\operatorname{ln}⁡(5{x}^{2}+2x))+(x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(5{x}^{2}+2x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1\\cdot \\operatorname{ln}⁡(5{x}^{2}+2x)+x\\cdot (\\frac{1}{5{x}^{2}+2x}\\cdot (10x+2)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{ln}⁡(5{x}^{2}+2x)+\\frac{10{x}^{2}+2x}{5{x}^{2}+2x}\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y(\\operatorname{ln}⁡(5{x}^{2}+2x)+\\frac{10{x}^{2}+2x}{5{x}^{2}+2x})\\end{aligned}\n$$\n\nFinally, we substitute $y=(5{x}^{2}+2x)^{x}:$    \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =(5{x}^{2}+2x)^{x}\\cdot (\\operatorname{ln}⁡(5{x}^{2}+2x)+\\frac{10{x}^{2}+2x}{5{x}^{2}+2x}) \\\\  & =(5{x}^{2}+2x)^{x}\\cdot (\\frac{(5{x}^{2}+2x)\\operatorname{ln}⁡(5{x}^{2}+2x)}{5{x}^{2}+2x}+\\frac{10{x}^{2}+2x}{5{x}^{2}+2x}) \\\\  & =(5{x}^{2}+2x)^{x-1}\\cdot ((5{x}^{2}+2x)\\operatorname{ln}⁡(5{x}^{2}+2x)+10{x}^{2}+2x).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186504663 #edb/ref 1068 #edb/ref 17592186504567 #edb/ref 17592186045417] [17592186504663 #edb/ref 1069 "q-138863" #edb/ref 17592186045417] [17592186504663 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186504663 #edb/ref 1071 "Find the slope of the tangent to the curve $y=(\\operatorname{ln}⁡x)^{5x}$ at $x=e.$" #edb/ref 17592186045417] [17592186504663 #edb/ref 1072 #uuid "a8502904-ea72-54be-8bde-7a62b1b58e76" #edb/ref 17592186045417] [17592186504663 #edb/ref 1074 "The slope of the tangent to the curve at $x=e$ equals the function's derivative at the corresponding point.\n\nWe have the function \n\n$$\ny=(\\operatorname{ln}⁡x)^{5x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡((\\operatorname{ln}⁡x)^{5x}) \\\\ \\operatorname{ln}⁡y & =5x\\,\\operatorname{ln}⁡(\\operatorname{ln}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(5x\\,\\operatorname{ln}⁡(\\operatorname{ln}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(5x)^{′}\\cdot (\\operatorname{ln}⁡(\\operatorname{ln}⁡x))+(5x)\\cdot {(\\operatorname{ln}⁡(\\operatorname{ln}⁡x))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =5\\cdot \\operatorname{ln}⁡(\\operatorname{ln}⁡x)+5x\\cdot (\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{1}{x}) \\\\ \\frac{{y}^{′}}{y} & =5\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{5}{\\operatorname{ln}⁡x} \\\\ \\frac{{y}^{′}}{y} & =5(\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{1}{\\operatorname{ln}⁡x})\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(5(\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{1}{\\operatorname{ln}⁡x}))\\end{aligned}\n$$\n\nFinally, we substitute $y=(\\operatorname{ln}⁡x)^{5x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =5(\\operatorname{ln}⁡x)^{5x}(\\operatorname{ln}⁡(\\operatorname{ln}⁡x)+\\frac{1}{\\operatorname{ln}⁡x})\\end{aligned}\n$$\n\nTherefore, the slope of $y=(\\operatorname{ln}⁡x)^{5x}$ at $x=e$ is\n\n$$\n\\begin{aligned}{y}^{′}{|}_{x=e} & =5(\\operatorname{ln}⁡e)^{5\\cdot e}(\\operatorname{ln}⁡(\\operatorname{ln}⁡e)+\\frac{1}{\\operatorname{ln}⁡e}) \\\\  & =5(1)^{5e}(\\operatorname{ln}⁡(1)+\\frac{1}{1}) \\\\  & =5.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186504682 #edb/ref 1068 #edb/ref 17592186504574 #edb/ref 17592186045417] [17592186504682 #edb/ref 1069 "q-138840" #edb/ref 17592186045417] [17592186504682 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186504682 #edb/ref 1071 "Consider the function $y=({x}^{2}+3x)^{x}.$ Its derivative is given by \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=({x}^{2}+3x)^{x-1}\\cdot g(x).\n$$\n\nFind the function $g(x).$" #edb/ref 17592186045417] [17592186504682 #edb/ref 1072 #uuid "cdcbfec1-c9f8-5550-af44-736f646a25ea" #edb/ref 17592186045417] [17592186504682 #edb/ref 1074 "We have the function \n\n$$\ny=({x}^{2}+3x)^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+3x)^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡({x}^{2}+3x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡({x}^{2}+3x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x)\\cdot (\\operatorname{ln}⁡({x}^{2}+3x))+(x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{2}+3x)) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1\\cdot \\operatorname{ln}⁡({x}^{2}+3x)+x\\cdot (\\frac{1}{{x}^{2}+3x}\\cdot 2x+3) \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{ln}⁡({x}^{2}+3x)+\\frac{2{x}^{2}+3x}{{x}^{2}+3x}\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y(\\operatorname{ln}⁡({x}^{2}+3x)+\\frac{2{x}^{2}+3x}{{x}^{2}+3x})\\end{aligned}\n$$\n\nFinally, we substitute $y=({x}^{2}+3x)^{x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =({x}^{2}+3x)^{x}(\\operatorname{ln}⁡({x}^{2}+3x)+\\frac{2{x}^{2}+3x}{{x}^{2}+3x}) \\\\  & =({x}^{2}+3x)^{x}(\\frac{({x}^{2}+3x)\\operatorname{ln}⁡({x}^{2}+3x)}{{x}^{2}+3x}+\\frac{2{x}^{2}+3x}{{x}^{2}+3x}) \\\\  & =({x}^{2}+3x)^{x-1}(({x}^{2}+3x)\\operatorname{ln}⁡({x}^{2}+3x)+(2{x}^{2}+3x)).\\end{aligned}\n$$\n\n \n\nTherefore, $g(x)=({x}^{2}+3x)\\operatorname{ln}⁡({x}^{2}+3x)+(2{x}^{2}+3x).$" #edb/ref 17592186045417] [17592186504692 #edb/ref 1068 #edb/ref 17592186504550 #edb/ref 17592186045417] [17592186504692 #edb/ref 1069 "q-341717" #edb/ref 17592186045417] [17592186504692 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186504692 #edb/ref 1071 "Given that $y={x}^{\\operatorname{sec}⁡x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}={x}^{\\operatorname{sec}⁡x-1}\\operatorname{sec}⁡x\\cdot ($\n{{field-1}}$)$" #edb/ref 17592186045417] [17592186504692 #edb/ref 1072 #uuid "d597eea3-7247-5548-9071-6c8d8bbf677d" #edb/ref 17592186045417] [17592186504692 #edb/ref 1074 "We have the function \n\n$$\ny={x}^{\\operatorname{sec}⁡x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({x}^{\\operatorname{sec}⁡x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{sec}⁡x\\,\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sec}⁡x\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =(\\frac{\\text{d}}{\\text{d}x}\\operatorname{sec}⁡x)\\operatorname{ln}⁡x+\\operatorname{sec}⁡x(\\frac{\\text{d}}{\\text{d}x}\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =(\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\operatorname{ln}⁡x+\\operatorname{sec}⁡x\\cdot \\frac{1}{x}\\end{aligned}\n$$\n\nNow, we solve for $\\frac{\\text{d}y}{\\text{d}x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y(\\operatorname{ln}⁡x\\,\\operatorname{sec}⁡x\\operatorname{tan}⁡x+\\frac{\\operatorname{sec}⁡x}{x})\\end{aligned}\n$$\n\nFinally, we substitute $y={x}^{\\operatorname{sec}⁡x}:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={x}^{\\operatorname{sec}⁡x}\\cdot (\\operatorname{ln}⁡x\\,\\operatorname{sec}⁡x\\operatorname{tan}⁡x+\\frac{\\operatorname{sec}⁡x}{x}) \\\\  & ={x}^{\\operatorname{sec}⁡x}\\cdot \\frac{\\operatorname{sec}⁡x}{x}\\cdot (x\\operatorname{ln}⁡x\\,\\operatorname{tan}⁡x+1) \\\\  & ={x}^{\\operatorname{sec}⁡x-1}\\operatorname{sec}⁡x\\cdot (x\\operatorname{ln}⁡x\\operatorname{tan}⁡x+1).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186504703 #edb/ref 1068 #edb/ref 17592186504543 #edb/ref 17592186045417] [17592186504703 #edb/ref 1069 "q-341713" #edb/ref 17592186045417] [17592186504703 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186504703 #edb/ref 1071 "Given that $y=5e{x}^{1/x}$, find ${y}^{′}.$\n\n${y}^{′}=5e{x}^{1/x-2}\\cdot ($\n{{field-1}}$)$" #edb/ref 17592186045417] [17592186504703 #edb/ref 1072 #uuid "e9eb4864-b21d-5e66-84e3-4be25804889c" #edb/ref 17592186045417] [17592186504703 #edb/ref 1074 "We have the function \n\n$$\ny=5e{x}^{1/x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(5e{x}^{1/x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(5e)+\\operatorname{ln}⁡({x}^{1/x}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(5e)+(\\frac{1}{x})\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(5e)+(\\frac{1}{x})\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =0+{(\\frac{1}{x})}^{′}\\cdot (\\operatorname{ln}⁡x)+(\\frac{1}{x})\\cdot {(\\operatorname{ln}⁡x)}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(-\\frac{1}{{x}^{2}})\\operatorname{ln}⁡x+(\\frac{1}{x})\\cdot \\frac{1}{x} \\\\ \\frac{{y}^{′}}{y} & =-\\frac{\\operatorname{ln}⁡x}{{x}^{2}}+\\frac{1}{{x}^{2}} \\\\ \\frac{{y}^{′}}{y} & =\\frac{1}{{x}^{2}}(1-\\operatorname{ln}⁡x) \\\\ \\frac{{y}^{′}}{y} & ={x}^{-2}(1-\\operatorname{ln}⁡x)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y[{x}^{-2}(1-\\operatorname{ln}⁡x)]\\end{aligned}\n$$\n\nFinally, we substitute $y=5e{x}^{1/x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =5e{x}^{1/x}[{x}^{-2}(1-\\operatorname{ln}⁡x)] \\\\  & =5e{x}^{1/x-2}\\cdot (1-\\operatorname{ln}⁡x)\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186504706 #edb/ref 1068 #edb/ref 17592186504537 #edb/ref 17592186045417] [17592186504706 #edb/ref 1069 "q-341711" #edb/ref 17592186045417] [17592186504706 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186504706 #edb/ref 1071 "Given that $y=e{x}^{2-5{x}^{2}}$, find ${y}^{′}.$\n\n${y}^{′}=e{x}^{1-5{x}^{2}}\\cdot ($\n{{field-1}}$)$" #edb/ref 17592186045417] [17592186504706 #edb/ref 1072 #uuid "f33cce2a-3b3e-5ad7-89aa-ae8325e4e759" #edb/ref 17592186045417] [17592186504706 #edb/ref 1074 "We have the function \n\n$$\ny=e{x}^{2-5{x}^{2}}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(e{x}^{2-5{x}^{2}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡e+\\operatorname{ln}⁡({x}^{2-5{x}^{2}}) \\\\ \\operatorname{ln}⁡y & =1+(2-5{x}^{2})\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(1+(2-5{x}^{2})\\operatorname{ln}⁡x) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =0+(2-5{x}^{2})^{′}\\cdot (\\operatorname{ln}⁡x)+(2-5{x}^{2})\\cdot {(\\operatorname{ln}⁡x)}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(-10x)\\cdot \\operatorname{ln}⁡x+(2-5{x}^{2})\\cdot \\frac{1}{x} \\\\ \\frac{{y}^{′}}{y} & =-10x\\operatorname{ln}⁡x+\\frac{2-5{x}^{2}}{x} \\\\ \\frac{{y}^{′}}{y} & =-10x\\operatorname{ln}⁡x-5x+\\frac{2}{x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(-10x\\operatorname{ln}⁡x-5x+\\frac{2}{x})\\end{aligned}\n$$\n\nFinally, we substitute $y=e{x}^{2-5{x}^{2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =e{x}^{2-5{x}^{2}}\\cdot (-10x\\operatorname{ln}⁡x-5x+\\frac{2}{x}) \\\\  & =e{x}^{1-5{x}^{2}}\\cdot x(-10x\\operatorname{ln}⁡x-5x+\\frac{2}{x}) \\\\  & =e{x}^{1-5{x}^{2}}\\cdot (-10{x}^{2}\\operatorname{ln}⁡x-5{x}^{2}+2)\\end{aligned}\n$$" #edb/ref 17592186045417]}
