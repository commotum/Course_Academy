5417] [17592186124657 #edb/ref 1038 #edb/ref 17592186446479 #edb/ref 17592186045417] [17592186124657 #edb/ref 1038 #edb/ref 17592186446482 #edb/ref 17592186045417] [17592186124657 #edb/ref 1038 #edb/ref 17592186446486 #edb/ref 17592186045417] [17592186124657 #edb/ref 1038 #edb/ref 17592186446487 #edb/ref 17592186045417] [17592186124657 #edb/ref 1038 #edb/ref 17592186446489 #edb/ref 17592186045417] [17592186124657 #edb/ref 1039 "Finding Global Maxima and Minima of a Function Whose Domain Is a Smooth Curve" #edb/ref 17592186045417] [17592186124657 #edb/ref 1041 #edb/ref 17592186124220 #edb/ref 17592186045417] [17592186124657 #edb/ref 1042 #uuid "608bbe95-edf0-54a6-bd05-5578ba073319" #edb/ref 17592186045417] [17592186124658 #edb/ref 1037 #edb/ref 17592186049485 #edb/ref 17592186045417] [17592186124658 #edb/ref 1037 #edb/ref 17592186049508 #edb/ref 17592186045417] [17592186124658 #edb/ref 1038 #edb/ref 17592186125037 #edb/ref 17592186045417] [17592186124658 #edb/ref 1038 #edb/ref 17592186125065 #edb/ref 17592186045417] [17592186124658 #edb/ref 1038 #edb/ref 17592186284579 #edb/ref 17592186045417] [17592186124658 #edb/ref 1038 #edb/ref 17592186351513 #edb/ref 17592186045417] [17592186124658 #edb/ref 1038 #edb/ref 17592186363548 #edb/ref 17592186045417] [17592186124658 #edb/ref 1038 #edb/ref 17592186373325 #edb/ref 17592186045417] [17592186124658 #edb/ref 1038 #edb/ref 17592186399180 #edb/ref 17592186045417] [17592186124658 #edb/ref 1038 #edb/ref 17592186404252 #edb/ref 17592186045417] [17592186124658 #edb/ref 1038 #edb/ref 17592186404357 #edb/ref 17592186045417] [17592186124658 #edb/ref 1038 #edb/ref 17592186446481 #edb/ref 17592186045417] [17592186124658 #edb/ref 1038 #edb/ref 17592186446483 #edb/ref 17592186045417] [17592186124658 #edb/ref 1038 #edb/ref 17592186446488 #edb/ref 17592186045417] [17592186124658 #edb/ref 1039 "Finding Global Maxima and Minima of a Function Whose Domain Is Piecewise Smooth" #edb/ref 17592186045417] [17592186124658 #edb/ref 1041 #edb/ref 17592186124221 #edb/ref 17592186045417] [17592186124658 #edb/ref 1042 #uuid "82691436-7076-5c46-bb45-462ea9218db8" #edb/ref 17592186045417] [17592186124737 #edb/ref 1043 #edb/ref 17592186125655 #edb/ref 17592186045417] [17592186124737 #edb/ref 1043 #edb/ref 17592186125656 #edb/ref 17592186045417] [17592186124737 #edb/ref 1043 #edb/ref 17592186125657 #edb/ref 17592186045417] [17592186124737 #edb/ref 1043 #edb/ref 17592186125658 #edb/ref 17592186045417] [17592186124737 #edb/ref 1043 #edb/ref 17592186125659 #edb/ref 17592186045417] [17592186124737 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186124737 #edb/ref 1045 "Calculating Global Extrema of Multivariable Functions" #edb/ref 17592186045417] [17592186124737 #edb/ref 1046 #edb/ref 17592186125655 #edb/ref 17592186045417] [17592186124737 #edb/ref 1049 #edb/ref 17592186048450 #edb/ref 17592186045417] [17592186124737 #edb/ref 1050 1020.0 #edb/ref 17592186045417] [17592186124737 #edb/ref 1053 #uuid "feaa62a5-6a44-51be-9efd-89d2c7e4938d" #edb/ref 17592186045417] [17592186125035 #edb/ref 1068 #edb/ref 17592186323640 #edb/ref 17592186045417] [17592186125035 #edb/ref 1069 "q-37155" #edb/ref 17592186045417] [17592186125035 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186125035 #edb/ref 1071 "Find the global extrema of the function $f(x,y)={x}^{2}+{y}^{2}-4x+4$ on the closed region $D=\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 9\\}.$ You are given that the function has a critical point at $(2,0)\\in D.$" #edb/ref 17592186045417] [17592186125035 #edb/ref 1072 #uuid "db6b4d4c-efe8-5d52-b8df-1c7481ef870b" #edb/ref 17592186045417] [17592186125035 #edb/ref 1074 "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\nTo find the extreme values, we follow three steps.\n\n**Step 1.** Find the critical points of $f$ that lie inside the region $D.$ \n\nWe have been given that $f$ has a critical point at \n\n$\\,$ $(2,0)$ \n\nwhich belongs to the interior of the region $D.$ So, we include this point in the list of candidates for the extrema. \n\n**Step 2.**  Find the points on the boundary of $D$ that could give rise to extreme values. \n\nTo find the boundary points that could give rise to extreme values, we parametrize the bounding circle ${x}^{2}+{y}^{2}=9.$ This gives\n\n$$\nr=⟨3\\operatorname{cos}⁡t,3\\operatorname{sin}⁡t⟩,\\,t\\in [0,2\\pi ).\n$$\n\nThe values of $f$ on the boundary are given by the function\n\n$$\n\\begin{aligned}F(t) & =f(x(t),y(t)) \\\\  & =f(3\\operatorname{cos}⁡t,3\\operatorname{sin}⁡t) \\\\  & =(3\\operatorname{cos}⁡t)^{2}+(3\\operatorname{sin}⁡t)^{2}-4(3\\operatorname{cos}⁡t)+4 \\\\  & =9{cos}^{2}⁡t+9{sin}^{2}⁡t-12\\operatorname{cos}⁡t+4 \\\\  & =13-12\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTo find the critical points of $F(t)$ on the open interval $t\\in (0,2\\pi ),$ we solve the following equation:\n\n$$\n\\begin{aligned}{F}^{′}(t) & =0 \\\\ (13-12\\operatorname{cos}⁡t)^{′} & =0 \\\\ 12\\operatorname{sin}⁡t & =0 \\\\ \\operatorname{sin}⁡t & =0\\end{aligned}\n$$\n\nThis equation gives one solution $t=\\pi \\in (0,2\\pi ).$\nWe also have to check the endpoint of the interval $t=0.$ Therefore, the only values of $t$ that can possibly give rise to extreme values are $t=0,\\,\\pi .$ Evaluating the corresponding values of $x$ and $y$ on the boundary, we obtain two candidate points:\n\n$$\n(3,0),\\,(-3,0)\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values.\n\nLet's compare the values of $f(x,y)$ evaluated at each of the points mentioned above. \n\n$$\n\\begin{aligned}f(2,0) & =(2)^{2}+(0)^{2}-4(2)+4 \\\\  & =4+0-8+4 \\\\  & =0 \\\\ f(3,0) & =(3)^{2}+(0)^{2}-4(3)+4 \\\\  & =9+0-12+4 \\\\  & =1 \\\\ f(-3,0) & =(-3)^{2}+(0)^{2}-4(-3)+4 \\\\  & =9+0+12+4 \\\\  & =25\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $0$ at the point $(2,0),$ and\n\n- $f$ attains the global maximum of $25$ at the point $(-3,0).$" #edb/ref 17592186045417] [17592186125655 #edb/ref 1058 #edb/ref 17592186125656 #edb/ref 17592186045417] [17592186125655 #edb/ref 1061 45426 #edb/ref 17592186045417] [17592186125655 #edb/ref 1062 #uuid "85def1da-b072-51a0-ae08-591a0d352331" #edb/ref 17592186045417] [17592186125655 #edb/ref 1063 #edb/ref 17592186125892 #edb/ref 17592186045417] [17592186125656 #edb/ref 1058 #edb/ref 17592186125657 #edb/ref 17592186045417] [17592186125656 #edb/ref 1061 45427 #edb/ref 17592186045417] [17592186125656 #edb/ref 1062 #uuid "ac225680-0726-58b8-b03b-f62ad289bb51" #edb/ref 17592186045417] [17592186125656 #edb/ref 1063 #edb/ref 17592186124656 #edb/ref 17592186045417] [17592186125657 #edb/ref 1058 #edb/ref 17592186125658 #edb/ref 17592186045417] [17592186125657 #edb/ref 1061 45430 #edb/ref 17592186045417] [17592186125657 #edb/ref 1062 #uuid "7c1f6a3a-a0f9-5d34-85e4-3cbe4e6bca0e" #edb/ref 17592186045417] [17592186125657 #edb/ref 1063 #edb/ref 17592186124657 #edb/ref 17592186045417] [17592186125658 #edb/ref 1058 #edb/ref 17592186125659 #edb/ref 17592186045417] [17592186125658 #edb/ref 1061 45433 #edb/ref 17592186045417] [17592186125658 #edb/ref 1062 #uuid "8d1553dd-1fe4-5a34-9376-7547f1b2b500" #edb/ref 17592186045417] [17592186125658 #edb/ref 1063 #edb/ref 17592186125893 #edb/ref 17592186045417] [17592186125659 #edb/ref 1061 45434 #edb/ref 17592186045417] [17592186125659 #edb/ref 1062 #uuid "ccc80dce-cc5f-5576-95e2-9236c9281336" #edb/ref 17592186045417] [17592186125659 #edb/ref 1063 #edb/ref 17592186124658 #edb/ref 17592186045417] [17592186125892 #edb/ref 1064 "Suppose we want to find the **global maximum** and **global minimum** of a function $f(x,y).$ Recall that the global maximum and minimum of a function are collectively known as **global extrema.** \n\nThe procedure we will describe for finding the global extrema is based on a general principle called the **extreme-value theorem,** which states the following:\n\n*Every function that is continuous on a closed, bounded region $D$ has global extrema (i.e., both a global maximum and a global minimum) on $D$*.\n\nLet's consider the function $f(x,y) =  e^{x^2- y^2}$ on the closed  region $D=\\{(x,y)\\in \\mathbb R^2: \\,  x^2 +y^2  \\leq 1\\}.$ How do we find the global extrema?\n\nTo find the global extrema of a differentiable function on a closed, bounded region $D,$ we follow these steps:\n\n**Step 1**:  Determine the critical points of $f$ in the interior of $D.$\n\n![](images/50/5057a4a96daa4819a70e733519c89802c28bde184183db2b4efbe69d3db36e56.png)\n\nTo determine the critical points, we solve $\\boldsymbol f' = \\mathbf 0.$ Computing the derivative gives\n\n![](images/b4/b48de1dcd3a240a1f1904dd290ef0665fc603c4cc5f99915915c6a12f79d74d9.svg)\n\nThe derivative exists at each point inside $D,$ and it equals zero when\n\n$$\n\\begin{aligned}\\{\\begin{aligned}2x{e}^{{x}^{2}-{y}^{2}}=0 \\\\ -2y{e}^{{x}^{2}-{y}^{2}}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}x=0 \\\\ y=0.\\end{aligned}\\end{aligned}\n$$\n\n \n\nThis gives us a single point $(0,0).$ Since the point $(0,0)$ is in the interior of $D,$ we include it in the list of candidates for extrema.\n\n**Step 2.**  Find the points on the boundary of ${D}$ that could give rise to extreme values. \n\nTo find the boundary points that could give rise to extreme values, we parametrize the bounding circle $x^2 + y^2 =1.$ This gives\n\n$$\n\\mathbf{r} = \\langle \\cos{t}, \\sin{t} \\rangle, \\qquad t \\in [0,2\\pi).\n$$\n\nThe values of $f$ on the boundary are given by the function\n\n$$\n\\begin{aligned}F(t) & =f(x(t),y(t)) \\\\  & =f(\\operatorname{cos}⁡t,\\operatorname{sin}⁡t) \\\\  & ={e}^{{cos}^{2}⁡t-{sin}^{2}⁡t} \\\\  & ={e}^{\\operatorname{cos}⁡(2t)}.\\end{aligned}\n$$\n\nTo find the critical points of $F(t)$ on the open interval $t \\in (0,2\\pi),$ we solve the following equation:\n\n$$\n\\begin{aligned}{F}^{′}(t) & =0 \\\\ ({e}^{\\operatorname{cos}⁡(2t)})^{′} & =0 \\\\ -2\\operatorname{sin}⁡(2t){e}^{\\operatorname{cos}⁡(2t)} & =0 \\\\ \\operatorname{sin}⁡(2t) & =0\\end{aligned}\n$$\n\nThis equation has three solutions, namely \n\n$$\nt =\\dfrac\\pi 2, \\: \\pi, \\: \\dfrac{3\\pi}2 \\in (0,2\\pi).\n$$\n\nWe also have to check the endpoint of the interval, namely, $t=0.$ Therefore, the only values of $t$ that can give rise to extreme values are \n\n$$\nt=0, \\: \\dfrac{\\pi}{2}, \\:  \\pi, \\: \\dfrac{3\\pi}{2}.\n$$\n\nEvaluating the corresponding values of $x$ and $y$ for each value of $t$, we obtain the following candidate points:\n\n$$\n(1,0), \\: (0,1), \\: (-1,0), \\: (0,-1)\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values.\n\nEvaluating $f$ at the five points we've found gives the following table of values:\n\n| $(x,y)$ | $(0,0)$ | $(1,0)$ | $(0,1)$ | $(-1,0)$ | $(0,-1)$ |\n| --- | --- | --- | --- | --- | --- |\n| $f(x,y)$ | $1$ | $e$ | $1/e$ | $e$ | $1/e$ |\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $\\dfrac1e$ at the points $(0,1), \\, (0,-1),$ and\n\n- $f$ attains the global maximum of $e$ at the points $(1,0), \\, (-1,0).$" #edb/ref 17592186045417] [17592186125892 #edb/ref 1065 7879 #edb/ref 17592186045417] [17592186125892 #edb/ref 1066 #uuid "b8b379fb-f7e4-5cdb-b25a-69a6c2ae9cf2" #edb/ref 17592186045417] [17592186125892 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186125893 #edb/ref 1064 "Consider a function $f(\\mathbf{x})$ and a closed and bounded region $D$ enclosed by several curves, like the one shown below.\n\n![](images/04/042e4b736bdaa93033af34cc4ff738d1976a6595a448c8b697e717a74d19b67f.png)\n\nIn such cases, we need to search for extrema candidates among the following three categories:\n\nI. The critical points of $f$ that belong to the interior of $D.$\n\nII. The critical points of the function $f(\\mathbf{r}),$ where $\\mathbf{r}$ traverses each of the given parts of the boundary. In the example above, we would have to parametrize each of the $\\color{blue}4$ parts of the boundary separately.\n\nIII. The corner points of the boundary, i.e., the points where the different parts of the boundary meet. In the example above, we'd have to consider $\\color{red}4$ such points." #edb/ref 17592186045417] [17592186125893 #edb/ref 1065 7880 #edb/ref 17592186045417] [17592186125893 #edb/ref 1066 #uuid "e1ab24b0-a5c2-5d72-bc3e-614864010365" #edb/ref 17592186045417] [17592186125893 #edb/ref 1067 "Determining the Candidates for Extrema on a Piecewise Smooth Boundary" #edb/ref 17592186045417] [17592186321793 #edb/ref 1080 "${f}_{min}=0$ and ${f}_{max}=25$" #edb/ref 17592186045417] [17592186321793 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186321793 #edb/ref 1083 #uuid "51e8f2b2-e881-54be-8bfe-5a90a63da983" #edb/ref 17592186045417] [17592186321843 #edb/ref 1080 "${f}_{min}=-5$ and ${f}_{max}=5$" #edb/ref 17592186045417] [17592186321843 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186321843 #edb/ref 1083 #uuid "58776b4d-dfad-5418-8461-511cc2520627" #edb/ref 17592186045417] [17592186321978 #edb/ref 1080 "${f}_{min}=-1$ and ${f}_{max}=0$" #edb/ref 17592186045417] [17592186321978 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186321978 #edb/ref 1083 #uuid "6a96826c-9c27-5fd9-82e2-7b681ef6be75" #edb/ref 17592186045417] [17592186322333 #edb/ref 1080 "${f}_{min}=-1$ and ${f}_{max}=5$" #edb/ref 17592186045417] [17592186322333 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186322333 #edb/ref 1083 #uuid "94d8e7cb-be9a-518f-a277-ee731c13382d" #edb/ref 17592186045417] [17592186323085 #edb/ref 1080 "${f}_{min}=1$ and ${f}_{max}=25$" #edb/ref 17592186045417] [17592186323085 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186323085 #edb/ref 1083 #uuid "f6f68fc9-b908-5124-a8a9-322a05564d15" #edb/ref 17592186045417] [17592186323640 #edb/ref 1075 #edb/ref 17592186321793 #edb/ref 17592186045417] [17592186323640 #edb/ref 1075 #edb/ref 17592186321843 #edb/ref 17592186045417] [17592186323640 #edb/ref 1075 #edb/ref 17592186321978 #edb/ref 17592186045417] [17592186323640 #edb/ref 1075 #edb/ref 17592186322333 #edb/ref 17592186045417] [17592186323640 #edb/ref 1075 #edb/ref 17592186323085 #edb/ref 17592186045417] [17592186323640 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186323640 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186323640 #edb/ref 1078 #edb/ref 17592186321793 #edb/ref 17592186045417] [17592186323640 #edb/ref 1079 #uuid "eedde66f-83fc-5633-be9a-580fbbeb170c" #edb/ref 17592186045417] [17592186351746 #edb/ref 1080 "2\\sqrt[4]{e}" #edb/ref 17592186045417] [17592186351746 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186351746 #edb/ref 1083 #uuid "148c3c70-3db7-55f7-8111-88c0343f9bd4" #edb/ref 17592186045417] [17592186351960 #edb/ref 1080 "2{e}^{-2}" #edb/ref 17592186045417] [17592186351960 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186351960 #edb/ref 1083 #uuid "2b5b8adf-77e5-5a78-94b3-8706a2ac286c" #edb/ref 17592186045417] [17592186352924 #edb/ref 1080 "{e}^{-2}" #edb/ref 17592186045417] [17592186352924 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186352924 #edb/ref 1083 #uuid "9eacec04-ca0d-50a6-98e3-da77f9822ab8" #edb/ref 17592186045417] [17592186353362 #edb/ref 1080 "{e}^{2}" #edb/ref 17592186045417] [17592186353362 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186353362 #edb/ref 1083 #uuid "cf33c688-22a9-5f87-ab62-f656a7ea1b5a" #edb/ref 17592186045417] [17592186353526 #edb/ref 1080 "2\\sqrt{e}" #edb/ref 17592186045417] [17592186353526 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186353526 #edb/ref 1083 #uuid "e1bb70c0-87ec-593e-850c-1115f0e6beea" #edb/ref 17592186045417] [17592186354068 #edb/ref 1075 #edb/ref 17592186351746 #edb/ref 17592186045417] [17592186354068 #edb/ref 1075 #edb/ref 17592186351960 #edb/ref 17592186045417] [17592186354068 #edb/ref 1075 #edb/ref 17592186352924 #edb/ref 17592186045417] [17592186354068 #edb/ref 1075 #edb/ref 17592186353362 #edb/ref 17592186045417] [17592186354068 #edb/ref 1075 #edb/ref 17592186353526 #edb/ref 17592186045417] [17592186354068 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186354068 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186354068 #edb/ref 1078 #edb/ref 17592186351746 #edb/ref 17592186045417] [17592186354068 #edb/ref 1079 #uuid "8bd8154f-1898-5372-9fda-b77df68be7d1" #edb/ref 17592186045417] [17592186354505 #edb/ref 1068 #edb/ref 17592186354068 #edb/ref 17592186045417] [17592186354505 #edb/ref 1069 "q-86725" #edb/ref 17592186045417] [17592186354505 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186354505 #edb/ref 1071 "Find the global maximum of the function $f(x,y)=2{e}^{xy-x}$ on the closed triangular region  $D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le 2-x\\}.$ You're given that $f$ has a critical point at $(0,1)$ and on the boundary of the triangle the points that could give rise to extreme values are the vertices and the point $(\\frac{1}{2},\\frac{3}{2}).$" #edb/ref 17592186045417] [17592186354505 #edb/ref 1072 #uuid "9e5511a5-af5b-54bb-a9ab-113418cf34fa" #edb/ref 17592186045417] [17592186354505 #edb/ref 1074 "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\nTo find the extreme values, we follow three steps.\n\n**Step 1.** Find the critical points of $f$ that lie inside the region $D.$ \n\nTo determine the critical points, let's first sketch the region:\n\n![](images/42/42b9bcda74e29cf7012fd9576ee7bcea92bfc3f58fab4c43c854892afe3acc44.png)\n\n \n\nSince the point $(0,1)$ does not belong to the interior of $D$, we do not yet include it in the list of candidates for extrema (it lies on the boundary of $D,$ so we will consider it in the next step).\n\n**Step 2.** Find the points on the boundary that could give rise to extreme values. \n\nIn this case, we are *given* the points on the boundary of our region that could potentially be global extrema for $f.$ These are\n\n$$\n(0,0),\\,(2,0),\\,(0,1),\\,(0,2),\\,(\\frac{1}{2},\\frac{3}{2})\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following: \n\n$$\n\\begin{aligned}f(0,0) & =2{e}^{(0)(0)-(0)} \\\\  & =2 \\\\ f(2,0) & =2{e}^{(2)(0)-(2)} \\\\  & =2{e}^{-2} \\\\ f(0,1) & =2{e}^{(0)(1)-(0)} \\\\  & =2 \\\\ f(0,2) & =2{e}^{(0)(2)-(0)} \\\\  & =2 \\\\ f(\\frac{1}{2},\\frac{3}{2}) & =2{e}^{(1/2)(3/2)-(1/2)} \\\\  & =2\\sqrt[4]{e}.\\end{aligned}\n$$\n\n \n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $2{e}^{-2}$ at the point $(2,0),$ and\n\n- $f$ attains the global maximum of $2\\sqrt[4]{e}$ at the point $(\\frac{1}{2},\\frac{3}{2}).$" #edb/ref 17592186045417] [17592186404350 #edb/ref 1068 #edb/ref 17592186404351 #edb/ref 17592186045417] [17592186404350 #edb/ref 1069 "q-86709" #edb/ref 17592186045417] [17592186404350 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186404350 #edb/ref 1071 "Find the global extrema of the function $f(x,y)=2xy+6x-3$ on the closed region $D$ enclosed by $y=-{x}^{2}$ and $y=-4.$ You are given that $f$ has a critical point at $(0,-3),$ and on the boundary of the region the points that could give rise to extreme values are $(-2,-4),$ $(-1,-1),$ $(1,-1),$ and $(2,-4).$" #edb/ref 17592186045417] [17592186404350 #edb/ref 1072 #uuid "32f5ebff-a024-5f63-b943-142f3a504252" #edb/ref 17592186045417] [17592186404350 #edb/ref 1074 "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\n**Step 1.** Find the critical points inside the region $D.$ \n\nTo determine the critical points, let's first sketch the region:\n\n![](images/96/96096b5f8944785f1af1bbc4fd4942e081b4b3999887c0fa8d5d76008af454d5.png)\n\nSince the point $(0,-3)$ is in the interior of $D,$ we include it in the list of candidates for extrema.\n\n**Step 2.** Find the points on the boundary that could give rise to extreme values.\n\nIn this case, we are *given* the points on the boundary of our region that could potentially be global extrema for $f.$ These are\n\n$$\n(-2,-4),\\,(-1,-1),\\,(1,-1),\\,(2,-4).\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following: \n\n$$\n\\begin{aligned}f(0,-3) & =2(0)(-3)+6(0)-3 \\\\  & =-3 \\\\ f(-2,-4) & =2(-2)(-4)+6(-2)-3 \\\\  & =1 \\\\ f(-1,-1) & =2(-1)(-1)+6(-1)-3 \\\\  & =-7 \\\\ f(1,-1) & =2(1)(-1)+6(1)-3 \\\\  & =1 \\\\ f(2,-4) & =2(2)(-4)+6(2)-3 \\\\  & =-7\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $-7$ at the points $(-1,-1)$ and $(2,-4),$\n\n- $f$ attains the global maximum of $1$ at the points $(-2,-4)$ and $(1,-1).$" #edb/ref 17592186045417] [17592186404351 #edb/ref 1075 #edb/ref 17592186404352 #edb/ref 17592186045417] [17592186404351 #edb/ref 1075 #edb/ref 17592186404353 #edb/ref 17592186045417] [17592186404351 #edb/ref 1075 #edb/ref 17592186404354 #edb/ref 17592186045417] [17592186404351 #edb/ref 1075 #edb/ref 17592186404355 #edb/ref 17592186045417] [17592186404351 #edb/ref 1075 #edb/ref 17592186404356 #edb/ref 17592186045417] [17592186404351 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186404351 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186404351 #edb/ref 1078 #edb/ref 17592186404354 #edb/ref 17592186045417] [17592186404351 #edb/ref 1079 #uuid "c1c6b9bc-2cad-5aef-8fbc-0df5f811dfbb" #edb/ref 17592186045417] [17592186404352 #edb/ref 1080 "${f}_{min}=-1$ and ${f}_{max}=7$" #edb/ref 17592186045417] [17592186404352 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 175921