rt></mrow></mfrac></mstyle><mo>+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><msqrt><mi>s</mi></msqrt></mrow></msup><mo>⋅</mo><mn>1</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mi>s</mi></msqrt><mn>2</mn></mfrac></mstyle><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><msqrt><mi>s</mi></msqrt></mrow></msup><mo>+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><msqrt><mi>s</mi></msqrt></mrow></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>1</mn><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><msqrt><mi>s</mi></msqrt><mn>2</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><msqrt><mi>s</mi></msqrt></mrow></msup><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
