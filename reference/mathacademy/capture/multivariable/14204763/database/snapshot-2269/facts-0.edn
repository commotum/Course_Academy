ef 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360552 #edb/ref 1071 "If $f(x,y)=\\sqrt{2xy},x=t$ and $y=\\operatorname{ln}⁡t,$ compute $\\frac{\\text{d}f}{\\text{d}t}.$" #edb/ref 17592186045417] [17592186360552 #edb/ref 1072 #uuid "e0f22ddd-635a-5638-92e4-fbad8751067f" #edb/ref 17592186045417] [17592186360552 #edb/ref 1074 "![](images/f0/f01b253f560405a8c0f4be8f8797c652fb0ddf774f4db110b8822313b8ac50f3.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $t,$ where $x=x(t)$ and $y=y(t),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}t}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{y}{\\sqrt{2xy}},\\,\\frac{∂f}{∂y}=\\frac{x}{\\sqrt{2xy}}\\end{aligned}\n$$\n\nWriting the above results in terms of $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{\\operatorname{ln}⁡t}{\\sqrt{2t\\operatorname{ln}⁡t}}, \\\\ \\frac{∂f}{∂y} & =\\frac{t}{\\sqrt{2t\\operatorname{ln}⁡t}}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}=1,\\,\\frac{\\text{d}y}{\\text{d}t}=\\frac{1}{t}.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}t} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t} \\\\  & =\\frac{\\operatorname{ln}⁡t}{\\sqrt{2t\\operatorname{ln}⁡t}}\\cdot 1+\\frac{t}{\\sqrt{2t\\operatorname{ln}⁡t}}\\cdot \\frac{1}{t} \\\\  & =\\frac{\\operatorname{ln}⁡t}{\\sqrt{2t\\operatorname{ln}⁡t}}+\\frac{1}{\\sqrt{2t\\operatorname{ln}⁡t}} \\\\  & =\\frac{1+\\operatorname{ln}⁡t}{\\sqrt{2t\\operatorname{ln}⁡t}}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360556 #edb/ref 1068 #edb/ref 17592186360348 #edb/ref 17592186045417] [17592186360556 #edb/ref 1069 "q-95084" #edb/ref 17592186045417] [17592186360556 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186360556 #edb/ref 1071 "If $f(x,y)=\\frac{x}{y},x=\\operatorname{cos}⁡2s$ and $y=\\operatorname{sin}⁡2s,$ compute $\\frac{\\text{d}f}{\\text{d}s}.$" #edb/ref 17592186045417] [17592186360556 #edb/ref 1072 #uuid "f22cdf5c-424c-5c09-91c4-a4b6bd7748c9" #edb/ref 17592186045417] [17592186360556 #edb/ref 1074 "![](images/7e/7e5b5001794ecdf2c9b9e9102f334a63d2c59bc6f7511c2eb7fa358fc94cb0c5.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $s,$ where $x=x(s)$ and $y=y(s),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}s}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{1}{y},\\,\\frac{∂f}{∂y}=-\\frac{x}{{y}^{2}}\\end{aligned}\n$$\n\nWriting the above results in terms of $s,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{1}{\\operatorname{sin}⁡2s}, \\\\ \\frac{∂f}{∂y} & =-\\frac{\\operatorname{cos}⁡2s}{{sin}^{2}⁡2s}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}s}=-2\\operatorname{sin}⁡2s,\\,\\frac{\\text{d}y}{\\text{d}s}=2\\operatorname{cos}⁡2s.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}s} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s} \\\\  & =\\frac{1}{\\operatorname{sin}⁡2s}\\cdot (-2\\operatorname{sin}⁡2s)+(-\\frac{\\operatorname{cos}⁡2s}{{sin}^{2}⁡2s})\\cdot 2\\operatorname{cos}⁡2s \\\\  & =-2-2\\cdot \\frac{{cos}^{2}⁡2s}{{sin}^{2}⁡2s} \\\\  & =-2-2{cot}^{2}⁡2s \\\\  & =-2{csc}^{2}⁡2s.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186383615 #edb/ref 1075 #edb/ref 17592186383616 #edb/ref 17592186045417] [17592186383615 #edb/ref 1075 #edb/ref 17592186383617 #edb/ref 17592186045417] [17592186383615 #edb/ref 1075 #edb/ref 17592186383618 #edb/ref 17592186045417] [17592186383615 #edb/ref 1075 #edb/ref 17592186383619 #edb/ref 17592186045417] [17592186383615 #edb/ref 1075 #edb/ref 17592186383620 #edb/ref 17592186045417] [17592186383615 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186383615 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186383615 #edb/ref 1078 #edb/ref 17592186383618 #edb/ref 17592186045417] [17592186383615 #edb/ref 1079 #uuid "a31244f4-c1a2-50a4-adcb-bc5510fae670" #edb/ref 17592186045417] [17592186383616 #edb/ref 1080 "{e}^{s}" #edb/ref 17592186045417] [17592186383616 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186383616 #edb/ref 1083 #uuid "8172957c-8ded-58d3-9a23-800391f6abc1" #edb/ref 17592186045417] [17592186383617 #edb/ref 1080 "{e}^{s}-2t" #edb/ref 17592186045417] [17592186383617 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186383617 #edb/ref 1083 #uuid "65fc28e8-01f1-5779-81a2-95006d854621" #edb/ref 17592186045417] [17592186383618 #edb/ref 1080 "-{e}^{s}-2" #edb/ref 17592186045417] [17592186383618 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186383618 #edb/ref 1083 #uuid "78f76e21-a29b-5ac4-bef0-5e96cc36b301" #edb/ref 17592186045417] [17592186383619 #edb/ref 1080 "{e}^{s}+2+t" #edb/ref 17592186045417] [17592186383619 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186383619 #edb/ref 1083 #uuid "1650585c-4f5b-5c09-98dc-1b8f36155d98" #edb/ref 17592186045417] [17592186383620 #edb/ref 1080 "-{e}^{s}+t" #edb/ref 17592186045417] [17592186383620 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186383620 #edb/ref 1083 #uuid "9d243851-27bb-5ff4