a }_{2}}=\\sqrt{1}=1 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "42d7236d-92fe-52f5-8b19-b1b09a4e3d89" :step/next {:db/id #edb/ref 17592186551382}} {:db/id #edb/ref 17592186551400 :step/content {:db/id #edb/ref 17592186367540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f72538-1df2-5400-9f78-cb8409f95ed7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $2$" :db/id #edb/ref 17592186367542} {:answer/id #uuid "aaed5f82-08d1-5931-9dc0-ef6782cb00fd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $3$" :db/id #edb/ref 17592186367543} {:answer/id #uuid "85459f08-ebd2-5de2-af01-144d2aeb100c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $1$" :db/id #edb/ref 17592186367544} {:answer/id #uuid "d4be0251-97f5-5981-bda6-e62b677f0ba2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $4$" :db/id #edb/ref 17592186367545} {:answer/id #uuid "c7dc7fb6-4c25-5dc1-b337-7a9abd5eaf65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186367546}] :answer-field/correct {:db/id #edb/ref 17592186367544} :answer-field/id #uuid "2b11b93b-5ed4-5c27-8e1f-ae8a252505fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186367541}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a7d5c241-f1dd-539c-bc82-e319298f04d9" :question/math-academy-id "q-139500" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}3 & 2 \\\\ -2 & -3\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}3 & 2 \\\\ -2 & -3\\end{bmatrix}}^{T}\\begin{bmatrix}3 & 2 \\\\ -2 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -2 \\\\ 2 & -3\\end{bmatrix}\\begin{bmatrix}3 & 2 \\\\ -2 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}13 & 12 \\\\ 12 & 13\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}13-\\lambda  & 12 \\\\ 12 & 13-\\lambda \\end{vmatrix} & =0 \\\\ (13-\\lambda )(13-\\lambda )-144 & =0 \\\\ 169-26\\lambda +{\\lambda }^{2}-144 & =0 \\\\ {\\lambda }^{2}-26\\lambda +25 & =0 \\\\ (\\lambda -1)(\\lambda -25) & =0 \\\\ \\lambda  & =25,\\,1\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{25}=5 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1\\end{aligned}\n$$"} :step/id #uuid "52507521-8d80-5625-b78a-9c6bf63ea91d"} {:db/id #edb/ref 17592186551457 :step/content {:db/id #edb/ref 17592186368913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f0d752a-b826-5c64-be10-12da661ba4f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186368915} {:answer/id #uuid "013ec41c-cc86-5fe4-b29a-accf164dceb1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$13$ and $0$" :db/id #edb/ref 17592186368916} {:answer/id #uuid "24eac0e8-069f-5b0b-9420-f802df54dfb4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{13}$ and $0$" :db/id #edb/ref 17592186368917} {:answer/id #uuid "a9aa8865-fb8b-5614-b9f2-9c3837814ef1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $1$" :db/id #edb/ref 17592186368918} {:answer/id #uuid "7be86b9d-e96c-5fac-9a1f-8fb3684e2c62" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186368919}] :answer-field/correct {:db/id #edb/ref 17592186368917} :answer-field/id #uuid "fd34787a-f30f-575c-9f6f-407c026f6c03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 