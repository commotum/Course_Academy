 #edb/ref 17592186184404}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186415583} :activity/id #uuid "53b5db0f-521e-5c61-9c0c-fdff9e2691c7" :activity/scope {:db/id #edb/ref 17592186049462 :topic/id #uuid "f7488799-2322-5ff9-8065-6852954f5eb5" :topic/math-academy-id 3819} :activity/steps [{:db/id #edb/ref 17592186415579 :step/content {:db/id #edb/ref 17592186415575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03cdbbac-81f1-5a5a-8c0b-cc9eada2874c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $5$" :db/id #edb/ref 17592186415544} {:answer/id #uuid "62cb00c2-7471-5b2f-86f0-ee1821df8b74" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $1$" :db/id #edb/ref 17592186415553} {:answer/id #uuid "903124f2-18ad-506a-90f1-7a04c1d43894" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $\\sqrt{2}$" :db/id #edb/ref 17592186415559} {:answer/id #uuid "a9a954e9-faca-5755-872b-2adf607495f9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{5}$ and $\\sqrt{3}$" :db/id #edb/ref 17592186415561} {:answer/id #uuid "e9b697fb-7c5f-5191-9456-d6dcf71e2749" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{8}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186415567}] :answer-field/correct {:db/id #edb/ref 17592186415567} :answer-field/id #uuid "2ee60de8-7912-55ad-80bc-fd51fae2e264" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415570}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "35756e17-7ddb-5db3-9246-f082e3b776e5" :question/math-academy-id "q-95362" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix}}^{T}\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 2 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 0 \\\\ 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}8-\\lambda  & 0 \\\\ 0 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (8-\\lambda )(2-\\lambda ) & =0 \\\\ \\lambda  & =8,\\,2\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{8} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{2}\\end{aligned}\n$$"} :step/id #uuid "12c4c78d-1201-5f3b-8360-4897312bf437" :step/next {:db/id #edb/ref 17592186415582}} {:db/id #edb/ref 17592186415580 :step/content {:db/id #edb/ref 17592186415578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a190c4a-9cc2-50ab-a107-16fc3f92fc4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3},\\,2,\\,0" :db/id #edb/ref 17592186415545} {:answer/id #uuid "1e594ce1-22ea-5fd6-afb9-6b06b4b9255c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,1,\\,0" :db/id #edb/ref 17592186415546} {:answer/id #uuid "70323d57-c32e-523a-902e-eb0de24ca0c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,\\sqrt{3},\\,0" :db/id #edb/ref 17592186415554} {:answer/id #uuid "83f12e6b-62c0-5595-a194-e0065cfb501d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,\\sqrt{3},\\,0" :db/id #edb/ref 17592186415557} {:answer/id #uuid "c6eb0c7d-ecb7-57ee-81fb-a558588e214e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2},\\,1,\\,0" :db/id #edb/ref 17592186415564}] :answer-field/correct {:db/id #edb/ref 17592186415564} :answer-field/id #uuid "646b1b63-2cd4-5c4d-b0e4-160d844e1954" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415571}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9d417d43-c45e-500b-a5bf-a441848f66ea" :question/math-academy-id "q-95378" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$  \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{T}\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}1-\\lambda  & 1 & 0 \\\\ 1 & 1-\\lambda  & 0 \\\\ 0 & 0 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )\\begin{vmatrix}1-\\lambda  & 1 \\\\ 1 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )((1-\\lambda )^{2}-1) & =0 \\\\ (1-\\lambda )(1-2\\lambda +{\\lambda }^{2}-1) & =0 \\\\ -\\lambda (\\lambda -1)(\\lambda -2) & =0 \\\\ \\lambda  & =2,\\,1,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{2} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "5d5c433e-0023-555a-a2d0-920150952da3"} {:db/id #edb/ref 17592186415581 :step/content {:db/id #edb/ref 17592186415577 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f16480c-d86a-5db9-b802-4ced71c8377c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5},\\,2,\\,0" :db/id #edb/ref 17592186415549} {:answer/id #uuid "5febb191-7c5d-5f4e-82d6-efc23b4d4485" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16,\\,9,\\,0" :db/id #edb/ref 17592186415551} {:answer/id #uuid "73c9cf54-1f9b-52f1-b8ed-dd9e193c12b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186415555} {:answer/id #uuid "9d3fcfba-14a5-5b55-ba3e-4a632953d6dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186415560} {:answer/id #uuid "be6dbb3a-d9f4-5182-87d2-f89ac41af4ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,3,\\,0" :db/id #edb/ref 17592186415562}] :answer-field/correct {:db/id #edb/ref 17592186415560} :answer-field/id #uuid "b838eb18-ab2d-5fe6-b6c3-92ea8e153a8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415573}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9ba2e577-1f2d-586f-a5db-7d03c7c71c22" :question/math-academy-id "q-95375" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{bmatrix}}^{T}\\begin{bmatrix}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ -1 & 2 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 4 & 0 \\\\ 4 & 5 & -2 \\\\ 0 & -2 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 4 & 0 \\\\ 4 & 5-\\lambda  & -2 \\\\ 0 & -2 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}5-\\lambda  & -2 \\\\ -2 & 4-\\lambda \\end{vmatrix}-4\\begin{vmatrix}4 & -2 \\\\ 0 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )[(5-\\lambda )(4-\\lambda )-4)]-16(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda +16)-16(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda ) & =0 \\\\ \\lambda (4-\\lambda )(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "70681b4b-0f8d-5f23-9042-59cb06bbe55f" :step/next {:db/id #edb/ref 17592186415580}} {:db/id #edb/ref 17592186415582 :step/content {:db/id #edb/ref 17592186415574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22fab31e-219e-5d18-813a-a8d06acc3248" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,1,\\,0" :db/id #edb/ref 17592186415548} {:answer/id #uuid "7f5778c2-893f-5035-ae58-7208c5dc0a69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,1,\\,1" :db/id #edb/ref 17592186415556} {:answer/id #uuid "8e8616be-5d4c-5647-8715-109f64e7adf8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,2,\\,0" :db/id #edb/ref 17592186415558} {:answer/id #uuid "c1276a11-417f-5453-89d9-104681d36b19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8,\\,4,\\,0" :db/id #edb/ref 17592186415563} {:answer/id #uuid "cf324114-3726-57f4-b073-13b1533f0488" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,1,\\,0" :db/id #edb/ref 17592186415565}] :answer-field/correct {:db/id #edb/ref 17592186415565} :answer-field/id #uuid "2503f0e3-6a58-532b-b8da-6c772b852974" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415569}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2512d16d-c375-5bf3-9c3b-0ab4d79702bf" :question/math-academy-id "q-95374" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{bmatrix}}^{T}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & -1 & -1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & -2 \\\\ 0 & -2 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}1-\\lambda  & 0 & 0 \\\\ 0 & 2-\\lambda  & -2 \\\\ 0 & -2 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )\\begin{vmatrix}2-\\lambda  & -2 \\\\ -2 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )((2-\\lambda )(2-\\lambda )-4) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-4\\lambda ) & =0 \\\\ -\\lambda (\\lambda -1)(\\lambda -4) & =0 \\\\ \\lambda  & =4,\\,1,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{4}=2 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "944a1de7-f0ef-562b-9fc3-c518a5f0b063" :step/next {:db/id #edb/ref 17592186415581}} {:db/id #edb/ref 17592186415583 :step/content {:db/id #edb/ref 17592186415576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "226f1dbb-e586-5c42-93b7-43b8c5544971" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,3,\\,0" :db/id #edb/ref 17592186415547} {:answer/id #uuid "4f6c601f-dc07-56ea-bef7-25b4a444358f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15,\\,9,\\,0" :db/id #edb/ref 17592186415550} {:answer/id #uuid "6266bf60-cbee-534e-aaad-f1b70c7c6e56" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,4,\\,0" :db/id #edb/ref 17592186415552} {:answer/id #uuid "e2b2ea65-38c0-59e1-8092-216f0cd8d2d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186415566} {:answer/id #uuid "f993a82a-65cc-57a6-9da0-7876fb553640" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186415568}] :answer-field/correct {:db/id #edb/ref 17592186415568} :answer-field/id #uuid "9da244a1-6637-5db7-b8ef-33283dce2b41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415572}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "42bc3fa3-d1ed-5eee-8e63-dbe17bc3a3c7" :question/math-academy-id "q-95349" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & -2 & 0\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & -2 & 0\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & -2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 2 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 0\\end{bmatrix}\\begin{bmatrix}2 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & -2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 2 & 0 \\\\ 2 & 5 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}8-\\lambda  & 2 & 0 \\\\ 2 & 5-\\lambda  & 0 \\\\ 0 & 0 & 0-\\lambda \\end{vmatrix} & =0 \\\\ (-\\lambda )\\begin{vmatrix}8-\\lambda  & 2 \\\\ 2 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (-\\lambda )((8-\\lambda )(5-\\lambda )-4) & =0 \\\\ (-\\lambda )({\\lambda }^{2}-13\\lambda +36) & =0 \\\\ \\lambda (\\lambda -4)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "bd730162-8216-5edd-a4e4-aa3f9eb30275" :step/next {:db/id #edb/ref 17592186415579}}] :activity/title "Computing the Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186415543}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186434793} :activity/id #uuid "f7bf5624-eb3d-524c-adc4-5621731bf40f" :activity/scope {:db/id #edb/ref 17592186049462 :topic/id #uuid "f7488799-2322-5ff9-8065-6852954f5eb5" :topic/math-academy-id 3819} :activity/steps [{:db/id #edb/ref 17592186434791 :step/content {:db/id #edb/ref 17592186368920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17453e7d-2501-500c-988d-632cc6dfbc65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $0$" :db/id #edb/ref 17592186368922} {:answer/id #uuid "3e7fa423-ce11-5e4b-941d-b20daa102519" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $4$" :db/id #edb/ref 17592186368923} {:answer/id #uuid "7cf839ad-4dca-5536-a5e6-2102abbf3175" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $2$" :db/id #edb/ref 17592186368924} {:answer/id #uuid "d0871187-035d-52b5-b781-f70eaa3bf24c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186368925} {:answer/id #uuid "0183a8ef-a247-5fec-a72f-23430bb57861" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $1$" :db/id #edb/ref 17592186368926}] :answer-field/correct {:db/id #edb/ref 17592186368925} :answer-field/id #uuid "bbd50738-594a-50f0-9455-2e79aec8430d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186368921}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "80bd1a5b-eef3-57d3-b7a8-ea1d67708737" :question/math-academy-id "q-95364" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}1 & -3 \\\\ 3 & -1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}1 & -3 \\\\ 3 & -1\\end{bmatrix}}^{T}\\begin{bmatrix}1 & -3 \\\\ 3 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 3 \\\\ -3 & -1\\end{bmatrix}\\begin{bmatrix}1 & -3 \\\\ 3 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}10 & -6 \\\\ -6 & 10\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}10-\\lambda  & -6 \\\\ -6 & 10-\\lambda \\end{vmatrix} & =0 \\\\ (10-\\lambda )(10-\\lambda )-36 & =0 \\\\ {\\lambda }^{2}-20\\lambda +100-36 & =0 \\\\ {\\lambda }^{2}-20\\lambda +64 & =0 \\\\ (\\lambda -4)(\\lambda -16) & =0 \\\\ \\lambda  & =16,\\,4\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{16}=4 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2\\end{aligned}\n$$"} :step/id #uuid "0b89f8b4-c620-53dc-98a8-673f79519cb0" :step/next {:db/id #edb/ref 17592186434794}} {:db/id #edb/ref 17592186434792 :step/content {:db/id #edb/ref 17592186368906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5aacda77-04a2-5890-a544-02a590c4abbe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{10}$ and $1$" :db/id #edb/ref 17592186368908} {:answer/id #uuid "d7d351a9-304d-59f9-bb2a-64ac42ed426b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$5$ and $0$" :db/id #edb/ref 17592186368909} {:answer/id #uuid "37198688-7720-5bf5-9d97-18a4fc4f1eae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$25$ and $0$" :db/id #edb/ref 17592186368910} {:answer/id #uuid "11993b50-f9b2-5859-af25-cf8175b4ff5c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{5}$ and $0$" :db/id #edb/ref 17592186368911} {:answer/id #uuid "4633659c-497d-54ae-9280-c13bf99f6b0b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$25$ and $1$" :db/id #edb/ref 17592186368912}] :answer-field/correct {:db/id #edb/ref 17592186368909} :answer-field/id #uuid "08930f82-1a1a-57e2-874c-8663b93ed935" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186368907}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bc0c7469-fdf7-5096-ab3b-9c5617b672e6" :question/math-academy-id "q-95316" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}3 & 4\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}3 & 4\\end{bmatrix}}^{T}\\begin{bmatrix}3 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}\\begin{bmatrix}3 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & 12 \\\\ 12 & 16\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}9-\\lambda  & 12 \\\\ 12 & 16-\\lambda \\end{vmatrix} & =0 \\\\ (9-\\lambda )(16-\\lambda )-144 & =0 \\\\ {\\lambda }^{2}-9\\lambda -16\\lambda +144-144 & =0 \\\\ {\\lambda }^{2}-25\\lambda  & =0 \\\\ \\lambda (\\lambda -25) & =0 \\\\ \\lambda  & =25,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{25}=5 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=0\\end{aligned}\n$$"} :step/id #uuid "579fd70b-a4f5-506a-a516-6e2012961957" :step/next {:db/id #edb/ref 17592186434791}} {:db/id #edb/ref 17592186434793 :step/content {:db/id #edb/ref 17592186184878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea50afa6-cf48-5a28-88f9-d3e965d42d17" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186404740} {:answer/id #uuid "58501d70-837f-5aaa-b030-23424dea0d8b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{10}$ and $0$" :db/id #edb/ref 17592186404741} {:answer/id #uuid "5b30f13e-19e7-5a1b-8f5a-9d9ae0821275" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $2$" :db/id #edb/ref 17592186404742} {:answer/id #uuid "09c94f4b-6a80-5db2-b8a4-38435a2f0752" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $1$" :db/id #edb/ref 17592186404743} {:answer/id #uuid "185ef847-122c-55fe-afa8-642c48c26e9f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ and $0$" :db/id #edb/ref 17592186404744}] :answer-field/correct {:db/id #edb/ref 17592186404743} :answer-field/id #uuid "d1608723-f0ef-5251-b5a7-f10ee403c96e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186404739}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a7c1d3e-ea07-5462-b92b-00ccbee66e53" :question/math-academy-id "q-94982" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 & 0 \\\\ 2 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 4 \\\\ 4 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}5-\\lambda  & 4 \\\\ 4 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(5-\\lambda )-16 & =0 \\\\ {\\lambda }^{2}-10\\lambda +25-16 & =0 \\\\ {\\lambda }^{2}-10\\lambda +9 & =0 \\\\ (\\lambda -1)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,1\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1\\end{aligned}\n$$"} :step/id #uuid "7fbe2269-e57f-5576-bab4-acdbbf9470a5" :step/next {:db/id #edb/ref 17592186434792}} {:db/id #edb/ref 17592186434794 :step/content {:db/id #edb/ref 17592186385852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57ba2282-d4ab-5fbf-9130-d06a2eed65a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186385854} {:answer/id #uuid "b45ecc1a-07a7-50a1-a446-cf4a96064ceb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,2,\\,0" :db/id #edb/ref 17592186385855} {:answer/id #uuid "f1a83de7-3a30-52e2-a29e-09bdd3418bd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,2,\\,1" :db/id #edb/ref 17592186385856} {:answer/id #uuid "01e6f9da-3643-528a-9879-9df01fb0203d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186385857} {:answer/id #uuid "d58280f6-ca95-52bf-80d9-6a8986b3c8bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,1,\\,0" :db/id #edb/ref 17592186385858}] :answer-field/correct {:db/id #edb/ref 17592186385854} :answer-field/id #uuid "7a01643e-564d-5068-bf87-5773a11495bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186385853}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "63c30a7c-7d2d-5a6c-adcf-5b929543dd1a" :question/math-academy-id "q-95369" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}0 & 0 & -2 \\\\ 0 & 2 & 0 \\\\ 0 & -1 & 2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & 0 & -2 \\\\ 0 & 2 & 0 \\\\ 0 & -1 & 2\\end{bmatrix}}^{T}\\begin{bmatrix}0 & 0 & -2 \\\\ 0 & 2 & 0 \\\\ 0 & -1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 2 & -1 \\\\ -2 & 0 & 2\\end{bmatrix}\\begin{bmatrix}0 & 0 & -2 \\\\ 0 & 2 & 0 \\\\ 0 & -1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 5 & -2 \\\\ 0 & -2 & 8\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}0-\\lambda  & 0 & 0 \\\\ 0 & 5-\\lambda  & -2 \\\\ 0 & -2 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (-\\lambda )\\begin{vmatrix}5-\\lambda  & -2 \\\\ -2 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (-\\lambda )((5-\\lambda )(8-\\lambda )-4) & =0 \\\\ (-\\lambda )({\\lambda }^{2}-13\\lambda +36) & =0 \\\\ -\\lambda (\\lambda -4)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "a3a70805-ef62-5a01-8da2-b71b9b73402a" :step/next {:db/id #edb/ref 17592186434795}} {:db/id #edb/ref 17592186434795 :step/content {:db/id #edb/ref 17592186383410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81eab9b6-2c22-56c2-8b09-bb7ba88bb023" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4,$ $2,$ $1$" :db/id #edb/ref 17592186383412} {:answer/id #uuid "45fdf803-5c63-5fd1-98ac-6d33e693cf05" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4,$ $3,$ $1$" :db/id #edb/ref 17592186383413} {:answer/id #uuid "8b43b2a5-0f26-58bc-89b2-44f5ea0b5aee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4,$ $4,$ $4$" :db/id #edb/ref 17592186383414} {:answer/id #uuid "e057365e-ebcb-5deb-8291-d5e0f828271e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3,$ $2,$ $1$" :db/id #edb/ref 17592186383415} {:answer/id #uuid "8afd4451-cbc1-5888-a4c6-5aa0879d00a4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2,$ $2,$ $2$" :db/id #edb/ref 17592186383416}] :answer-field/correct {:db/id #edb/ref 17592186383415} :answer-field/id #uuid "2d2e9298-f7ae-583b-b56c-2427f10af7e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186383411}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a2eadfc-214c-5e6d-a649-83f2e39bac57" :question/math-academy-id "q-139505" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 4 & 0 \\\\ 4 & 5 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}5-\\lambda  & 4 & 0 \\\\ 4 & 5-\\lambda  & 0 \\\\ 0 & 0 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}5-\\lambda  & 4 \\\\ 4 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )((5-\\lambda )(5-\\lambda )-16) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-10\\lambda +9) & =0 \\\\ (4-\\lambda )(\\lambda -1)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,1\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{1}=1\\end{aligned}\n$$"} :step/id #uuid "b00be353-af3c-5697-8948-437078c60988"}] :activity/title "Computing the Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186434790}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186508145} :activity/id #uuid "3ae952a1-d458-5f9b-a574-b6f1f970522e" :activity/scope {:db/id #edb/ref 17592186049462 :topic/id #uuid "f7488799-2322-5ff9-8065-6852954f5eb5" :topic/math-academy-id 3819} :activity/steps [{:db/id #edb/ref 17592186508120 :step/content {:db/id #edb/ref 17592186383410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81eab9b6-2c22-56c2-8b09-bb7ba88bb023" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4,$ $2,$ $1$" :db/id #edb/ref 17592186383412} {:answer/id #uuid "45fdf803-5c63-5fd1-98ac-6d33e693cf05" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4,$ $3,$ $1$" :db/id #edb/ref 17592186383413} {:answer/id #uuid "8b43b2a5-0f26-58bc-89b2-44f5ea0b5aee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$4,$ $4,$ $4$" :db/id #edb/ref 17592186383414} {:answer/id #uuid "e057365e-ebcb-5deb-8291-d5e0f828271e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3,$ $2,$ $1$" :db/id #edb/ref 17592186383415} {:answer/id #uuid "8afd4451-cbc1-5888-a4c6-5aa0879d00a4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2,$ $2,$ $2$" :db/id #edb/ref 17592186383416}] :answer-field/correct {:db/id #edb/ref 17592186383415} :answer-field/id #uuid "2d2e9298-f7ae-583b-b56c-2427f10af7e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186383411}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a2eadfc-214c-5e6d-a649-83f2e39bac57" :question/math-academy-id "q-139505" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 4 & 0 \\\\ 4 & 5 & 0 \\\\ 0 & 0 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}5-\\lambda  & 4 & 0 \\\\ 4 & 5-\\lambda  & 0 \\\\ 0 & 0 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}5-\\lambda  & 4 \\\\ 4 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )((5-\\lambda )(5-\\lambda )-16) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-10\\lambda +9) & =0 \\\\ (4-\\lambda )(\\lambda -1)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,1\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{1}=1\\end{aligned}\n$$"} :step/id #uuid "133f1769-65af-55a0-a3e5-d73c5f21e18d"} {:db/id #edb/ref 17592186508123 :step/content {:db/id #edb/ref 17592186404794 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d7b9b80-3654-5da0-af41-f1dd281a1ec6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,3,\\,1" :db/id #edb/ref 17592186404796} {:answer/id #uuid "adfd1028-f71d-5fb8-bf65-f6a904a4cad3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,1,\\,0" :db/id #edb/ref 17592186404797} {:answer/id #uuid "421f5096-6ffe-58b8-95fd-205273c0d9f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,1,\\,0" :db/id #edb/ref 17592186404798} {:answer/id #uuid "2a9e32e2-6234-54e2-a995-a9f7bc9f67fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,2,\\,0" :db/id #edb/ref 17592186404799} {:answer/id #uuid "b769f855-028a-56bf-bb0f-d1970e2ab6bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1,\\,1,\\,0" :db/id #edb/ref 17592186404800}] :answer-field/correct {:db/id #edb/ref 17592186404798} :answer-field/id #uuid "3e48eb31-ad56-59b2-a6ab-bf3fcb90c449" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186404795}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "de321704-9fad-5ba9-910c-dac492b8f0a2" :question/math-academy-id "q-95377" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}0 & -2 & -1 \\\\ 1 & -2 & 0\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & -2 & -1 \\\\ 1 & -2 & 0\\end{bmatrix}}^{T}\\begin{bmatrix}0 & -2 & -1 \\\\ 1 & -2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ -2 & \\,\\,-2 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}0 & -2 & -1 \\\\ 1 & -2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 & 0 \\\\ -2 & 8 & 2 \\\\ 0 & 2 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}1-\\lambda  & -2 & 0 \\\\ -2 & 8-\\lambda  & 2 \\\\ 0 & 2 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )\\begin{vmatrix}8-\\lambda  & 2 \\\\ 2 & 1-\\lambda \\end{vmatrix}+2\\begin{vmatrix}-2 & 2 \\\\ 0 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )[(8-\\lambda )(1-\\lambda )-4)]+2(-2)(1-\\lambda ) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-9\\lambda +4)+(-4)(1-\\lambda ) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-9\\lambda +4-4) & =0 \\\\ \\lambda (1-\\lambda )(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,1,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "2d8686d7-e3c0-5b66-a1a1-2340938e1450" :step/next {:db/id #edb/ref 17592186508120}} {:db/id #edb/ref 17592186508139 :step/content {:db/id #edb/ref 17592186416486 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17199cb6-adea-5b61-919d-b8c404e0acce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454196} {:answer/id #uuid "8d2c651a-9fde-5d68-8dc6-db31d39c222f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454197}] :answer-field/correct {:db/id #edb/ref 17592186454197} :answer-field/id #uuid "4075aa54-0dff-530d-8aaa-0316bbe68384" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454848} {:answer-field/choices [{:answer/id #uuid "ecfe78bb-58cf-5df3-9fec-25b0e56a5cf4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454198} {:answer/id #uuid "1cdaafa5-1a83-54e7-855b-cedee6333689" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454199}] :answer-field/correct {:db/id #edb/ref 17592186454198} :answer-field/id #uuid "ebe209e3-0b27-5e04-917c-a2a111895c0f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454849} {:answer-field/choices [{:answer/id #uuid "72750c08-7405-534f-a4d7-2b63080f7417" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186454200} {:answer/id #uuid "cf58434d-bb62-5004-8244-73fdeaf3e6f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186454201}] :answer-field/correct {:db/id #edb/ref 17592186454200} :answer-field/id #uuid "7b11c932-8a01-5b51-9317-14a5c84895c3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186454850}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fef86daf-091a-52fa-bcf0-1d2b609bb348" :question/math-academy-id "q-95281" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** Any $6\\times 3$ matrix $A$ has at most $3$ distinct singular values.\n- **II.** The matrix $A=\\begin{bmatrix}-1 & -1 \\\\ -1 & -2\\end{bmatrix}$ has one negative singular value.\n- **III.** Any $4\\times 5$ matrix $A$ has at most $4$ distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, since $A$ is a $6\\times 3$ matrix and ${A}^{T}$ is a $3\\times 6$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 6}\\times {A}_{6\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\n- Statement II is false. All singular values of any matrix are non-negative. So, $A$ can't have a negative singular value.\n\n- Statement III is false. Since $A$ is a $4\\times 5$ matrix and ${A}^{T}$ is a $5\\times 4$ matrix, ${A}^{T}\\,A$ must be a $5\\times 5$ matrix: \n\n$$\n{{A}^{T}}_{5\\times 4}\\times {A}_{4\\times 5}={{A}^{T}\\,A}_{5\\times 5}\n$$\n\nHence, $A$ has at most $5$ distinct singular values.\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "65534646-ddcd-5bd8-a87f-2133012193c1" :step/next {:db/id #edb/ref 17592186508123}} {:db/id #edb/ref 17592186508145 :step/content {:db/id #edb/ref 17592186184877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7d4ed93-75bb-5db0-9900-2362979d6c53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,3,\\,0" :db/id #edb/ref 17592186404734} {:answer/id #uuid "aac056f1-2c7a-51fc-b3b8-c7516856527b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186404735} {:answer/id #uuid "2ef4562a-20e9-5af5-80a4-ced17b367b83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,2,\\,0" :db/id #edb/ref 17592186404736} {:answer/id #uuid "fd4157e7-a2cf-562a-af6a-fea80f5a7f86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16,\\,9,\\,0" :db/id #edb/ref 17592186404737} {:answer/id #uuid "95d80c78-37a1-5b82-8b12-a47780191024" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186404738}] :answer-field/correct {:db/id #edb/ref 17592186404735} :answer-field/id #uuid "ce3dc232-fc1d-50e4-99b4-15ed1b8fa187" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186404733}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e9152817-159b-5a54-868d-fe52d19640cc" :question/math-academy-id "q-94981" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & -2 & 2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & -2 & 2\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 0 & -2 \\\\ -1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 & -2 \\\\ 0 & 4 & -4 \\\\ -2 & -4 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 0 & -2 \\\\ 0 & 4-\\lambda  & -4 \\\\ -2 & -4 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}4-\\lambda  & -4 \\\\ -4 & 5-\\lambda \\end{vmatrix}-2\\begin{vmatrix}0 & 4-\\lambda  \\\\ -2 & -4\\end{vmatrix} & =0 \\\\ (4-\\lambda )((4-\\lambda )(5-\\lambda )-16)-4(4-\\lambda ) & =0 \\\\ (4-\\lambda )(20-4\\lambda -5\\lambda +{\\lambda }^{2}-16)-4(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda +4)-4(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda +4-4) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda ) & =0 \\\\ \\lambda (\\lambda -4)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "9e4e734e-1d30-5972-b2b0-d48c4de710d5" :step/next {:db/id #edb/ref 17592186508146}} {:db/id #edb/ref 17592186508146 :step/content {:db/id #edb/ref 17592186184878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea50afa6-cf48-5a28-88f9-d3e965d42d17" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186404740} {:answer/id #uuid "58501d70-837f-5aaa-b030-23424dea0d8b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{10}$ and $0$" :db/id #edb/ref 17592186404741} {:answer/id #uuid "5b30f13e-19e7-5a1b-8f5a-9d9ae0821275" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $2$" :db/id #edb/ref 17592186404742} {:answer/id #uuid "09c94f4b-6a80-5db2-b8a4-38435a2f0752" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $1$" :db/id #edb/ref 17592186404743} {:answer/id #uuid "185ef847-122c-55fe-afa8-642c48c26e9f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ and $0$" :db/id #edb/ref 17592186404744}] :answer-field/correct {:db/id #edb/ref 17592186404743} :answer-field/id #uuid "d1608723-f0ef-5251-b5a7-f10ee403c96e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186404739}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a7c1d3e-ea07-5462-b92b-00ccbee66e53" :question/math-academy-id "q-94982" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 & 0 \\\\ 2 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & 2 \\\\ 1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 4 \\\\ 4 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}5-\\lambda  & 4 \\\\ 4 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (5-\\lambda )(5-\\lambda )-16 & =0 \\\\ {\\lambda }^{2}-10\\lambda +25-16 & =0 \\\\ {\\lambda }^{2}-10\\lambda +9 & =0 \\\\ (\\lambda -1)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,1\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1\\end{aligned}\n$$"} :step/id #uuid "a11d8c53-0d85-5382-8004-1a8f6e94884d" :step/next {:db/id #edb/ref 17592186508139}}] :activity/title "Computing the Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186507599}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186509031} :activity/id #uuid "25c36865-a3f4-539d-ab87-b42995a49a22" :activity/scope {:db/id #edb/ref 17592186049462 :topic/id #uuid "f7488799-2322-5ff9-8065-6852954f5eb5" :topic/math-academy-id 3819} :activity/steps [{:db/id #edb/ref 17592186509001 :step/content {:db/id #edb/ref 17592186493969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08b31b5f-4d45-56bb-9d27-10f181056843" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186493405} {:answer/id #uuid "1f5ebfbd-349c-5710-ab1d-bffdb6d4d025" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186493445} {:answer/id #uuid "21c0505d-1159-59fb-ba8b-2bd5ac4199de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186493447} {:answer/id #uuid "94c66a12-70a7-529f-ba21-ac7f034b13c8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186493623} {:answer/id #uuid "e4ada2c6-ebf0-5d58-9a21-8f0d7d2bddb7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186493752}] :answer-field/correct {:db/id #edb/ref 17592186493447} :answer-field/id #uuid "6457d0d0-1968-5324-849a-7bcaae3a3d7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493831}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "dfba6eb1-d0b6-5cbc-ac16-d682a2e1cc93" :question/math-academy-id "q-95286" :question/problem "Which of the following statements are true?\n\nI. Any $6\\times 5$ matrix $A$ has at most $6$ distinct singular values.\n\nII. Any $8\\times 9$ matrix $A$ has at most $9$ distinct singular values.\n\nIII. The matrix $A=\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix}$ has at most two non-negative distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Since $A$ is a $6\\times 5$ matrix and ${A}^{T}$ is a $5\\times 6$ matrix, ${A}^{T}\\,A$ must be a $5\\times 5$ matrix: \n\n$$\n{{A}^{T}}_{5\\times 6}\\times {A}_{6\\times 5}={{A}^{T}\\,A}_{5\\times 5}\n$$\n\nHence, $A$ has at most $5$ distinct singular values.\n\n- Statement II is true. Indeed, since $A$ is a $8\\times 9$ matrix and ${A}^{T}$ is a $9\\times 8$ matrix, ${A}^{T}\\,A$ must be a $9\\times 9$ matrix: \n\n$$\n{{A}^{T}}_{9\\times 8}\\times {A}_{8\\times 9}={{A}^{T}\\,A}_{9\\times 9}\n$$\n\nHence, $A$ has at most $9$ distinct singular values.\n\n- Statement III is true.  Indeed, all singular values of any matrix are non-negative.\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "08b16f9c-1a48-5e48-899f-7bdd30c63128" :step/next {:db/id #edb/ref 17592186509043}} {:db/id #edb/ref 17592186509031 :step/content {:db/id #edb/ref 17592186184876 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ac2533-62db-535c-8dc9-3e42649cc9f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ and $2$" :db/id #edb/ref 17592186368873} {:answer/id #uuid "40993328-f48a-5d16-8477-6064543ac098" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $0$" :db/id #edb/ref 17592186368874} {:answer/id #uuid "02e843f4-0fc7-5f0b-a07b-3fa3bfc2abd4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{10}$ and $0$" :db/id #edb/ref 17592186368875} {:answer/id #uuid "98d65d3b-180c-559c-9c5f-db57ec8866a2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$3$ and $2$" :db/id #edb/ref 17592186368876} {:answer/id #uuid "f0117d76-d5c6-543b-9609-b905ac185a64" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$10$ and $0$" :db/id #edb/ref 17592186368877}] :answer-field/correct {:db/id #edb/ref 17592186368875} :answer-field/id #uuid "9f0db150-06f0-53a7-8afc-b9734abea2f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186368872}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5015d1af-a116-557e-a448-94566c652f07" :question/math-academy-id "q-94773" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix}}^{T}\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -1 \\\\ 2 & -2\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 4 \\\\ 4 & 8\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}2-\\lambda  & 4 \\\\ 4 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (2-\\lambda )(8-\\lambda )-16 & =0 \\\\ 16-2\\lambda -8\\lambda +{\\lambda }^{2}-16 & =0 \\\\ {\\lambda }^{2}-10\\lambda  & =0 \\\\ \\lambda (\\lambda -10) & =0 \\\\ \\lambda  & =10,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{10} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=0\\end{aligned}\n$$"} :step/id #uuid "b7075bef-316c-5493-a497-4195378a1e59" :step/next {:db/id #edb/ref 17592186509045}} {:db/id #edb/ref 17592186509040 :step/content {:db/id #edb/ref 17592186415575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03cdbbac-81f1-5a5a-8c0b-cc9eada2874c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$8$ and $5$" :db/id #edb/ref 17592186415544} {:answer/id #uuid "62cb00c2-7471-5b2f-86f0-ee1821df8b74" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $1$" :db/id #edb/ref 17592186415553} {:answer/id #uuid "903124f2-18ad-506a-90f1-7a04c1d43894" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $\\sqrt{2}$" :db/id #edb/ref 17592186415559} {:answer/id #uuid "a9a954e9-faca-5755-872b-2adf607495f9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{5}$ and $\\sqrt{3}$" :db/id #edb/ref 17592186415561} {:answer/id #uuid "e9b697fb-7c5f-5191-9456-d6dcf71e2749" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{8}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186415567}] :answer-field/correct {:db/id #edb/ref 17592186415567} :answer-field/id #uuid "2ee60de8-7912-55ad-80bc-fd51fae2e264" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415570}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "35756e17-7ddb-5db3-9246-f082e3b776e5" :question/math-academy-id "q-95362" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix}}^{T}\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 2 \\\\ -1 & 1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 0 \\\\ 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}8-\\lambda  & 0 \\\\ 0 & 2-\\lambda \\end{vmatrix} & =0 \\\\ (8-\\lambda )(2-\\lambda ) & =0 \\\\ \\lambda  & =8,\\,2\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{8} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{2}\\end{aligned}\n$$"} :step/id #uuid "d6b3e1f2-3037-5a02-a9b8-d618b9003666"} {:db/id #edb/ref 17592186509043 :step/content {:db/id #edb/ref 17592186368913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f0d752a-b826-5c64-be10-12da661ba4f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186368915} {:answer/id #uuid "013ec41c-cc86-5fe4-b29a-accf164dceb1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$13$ and $0$" :db/id #edb/ref 17592186368916} {:answer/id #uuid "24eac0e8-069f-5b0b-9420-f802df54dfb4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{13}$ and $0$" :db/id #edb/ref 17592186368917} {:answer/id #uuid "a9aa8865-fb8b-5614-b9f2-9c3837814ef1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $1$" :db/id #edb/ref 17592186368918} {:answer/id #uuid "7be86b9d-e96c-5fac-9a1f-8fb3684e2c62" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186368919}] :answer-field/correct {:db/id #edb/ref 17592186368917} :answer-field/id #uuid "fd34787a-f30f-575c-9f6f-407c026f6c03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186368914}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "40523132-fd0a-5a78-90b5-ce48c89eb124" :question/math-academy-id "q-95317" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}3 & -2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}3 & -2\\end{bmatrix}}^{T}\\begin{bmatrix}3 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}\\begin{bmatrix}3 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & -6 \\\\ -6 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}9-\\lambda  & -6 \\\\ -6 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (9-\\lambda )(4-\\lambda )-36 & =0 \\\\ {\\lambda }^{2}-9\\lambda -4\\lambda +36-36 & =0 \\\\ {\\lambda }^{2}-13\\lambda  & =0 \\\\ \\lambda (\\lambda -13) & =0 \\\\ \\lambda  & =13,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{13} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=0\\end{aligned}\n$$"} :step/id #uuid "e0f1a8d8-c027-55c3-946a-482b070b07cc" :step/next {:db/id #edb/ref 17592186509040}} {:db/id #edb/ref 17592186509045 :step/content {:db/id #edb/ref 17592186184879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d60bfe-9b93-5322-a886-7bb0f57eff46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,4,\\,0" :db/id #edb/ref 17592186508445} {:answer/id #uuid "2a9003af-2b01-57da-a933-16ff4579b8dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25,\\,4,\\,0" :db/id #edb/ref 17592186508455} {:answer/id #uuid "80e9ab77-14e2-509c-baf9-6e9048da53b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186508580} {:answer/id #uuid "e99a56fa-1127-5a1f-872f-bba0b1b2c89b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,3,\\,0" :db/id #edb/ref 17592186508761} {:answer/id #uuid "ebe89adf-37a2-5724-a8e8-777891808839" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186508767}] :answer-field/correct {:db/id #edb/ref 17592186508445} :answer-field/id #uuid "32eedbf9-e833-5743-ba35-1e838f8db9de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186183883}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "421dde5b-98b5-58e5-8139-6656005b4621" :question/math-academy-id "q-94983" :question/problem "What are the singular values of the matrix $A=[\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}]?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}]}^{T}[\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 3 \\\\ -4 & 0 \\\\ 0 & -4\\end{aligned}][\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}9 & 0 & -12 \\\\ 0 & 16 & 0 \\\\ -12 & 0 & 16\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}9-\\lambda  & 0 & -12 \\\\ 0 & 16-\\lambda  & 0 \\\\ -12 & 0 & 16-\\lambda \\end{aligned}| & =0 \\\\ (16-\\lambda )|\\begin{aligned}9-\\lambda  & -12 \\\\ -12 & 16-\\lambda \\end{aligned}| & =0 \\\\ (16-\\lambda )((9-\\lambda )(16-\\lambda )-144) & =0 \\\\ (16-\\lambda )({\\lambda }^{2}-9\\lambda -16\\lambda +144-144) & =0 \\\\ (16-\\lambda )({\\lambda }^{2}-25\\lambda ) & =0 \\\\ \\lambda (\\lambda -16)(\\lambda -25) & =0 \\\\ \\lambda  & =25,\\,16,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{25}=5 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{16}=4 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "f17c08c3-3583-5a53-8194-3b1d81d7c6a0" :step/next {:db/id #edb/ref 17592186509001}}] :activity/title "Computing the Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186508379}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186551457} :activity/id #uuid "50cb0aa0-643b-56c3-935c-3bd9615919f8" :activity/scope {:db/id #edb/ref 17592186049462 :topic/id #uuid "f7488799-2322-5ff9-8065-6852954f5eb5" :topic/math-academy-id 3819} :activity/steps [{:db/id #edb/ref 17592186551366 :step/content {:db/id #edb/ref 17592186415578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a190c4a-9cc2-50ab-a107-16fc3f92fc4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3},\\,2,\\,0" :db/id #edb/ref 17592186415545} {:answer/id #uuid "1e594ce1-22ea-5fd6-afb9-6b06b4b9255c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,1,\\,0" :db/id #edb/ref 17592186415546} {:answer/id #uuid "70323d57-c32e-523a-902e-eb0de24ca0c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,\\sqrt{3},\\,0" :db/id #edb/ref 17592186415554} {:answer/id #uuid "83f12e6b-62c0-5595-a194-e0065cfb501d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,\\sqrt{3},\\,0" :db/id #edb/ref 17592186415557} {:answer/id #uuid "c6eb0c7d-ecb7-57ee-81fb-a558588e214e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2},\\,1,\\,0" :db/id #edb/ref 17592186415564}] :answer-field/correct {:db/id #edb/ref 17592186415564} :answer-field/id #uuid "646b1b63-2cd4-5c4d-b0e4-160d844e1954" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415571}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9d417d43-c45e-500b-a5bf-a441848f66ea" :question/math-academy-id "q-95378" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$  \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{T}\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}1-\\lambda  & 1 & 0 \\\\ 1 & 1-\\lambda  & 0 \\\\ 0 & 0 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )\\begin{vmatrix}1-\\lambda  & 1 \\\\ 1 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )((1-\\lambda )^{2}-1) & =0 \\\\ (1-\\lambda )(1-2\\lambda +{\\lambda }^{2}-1) & =0 \\\\ -\\lambda (\\lambda -1)(\\lambda -2) & =0 \\\\ \\lambda  & =2,\\,1,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{2} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "0f51217a-fd5d-5fe6-b533-50d56f781766" :step/next {:db/id #edb/ref 17592186551400}} {:db/id #edb/ref 17592186551382 :step/content {:db/id #edb/ref 17592186415577 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f16480c-d86a-5db9-b802-4ced71c8377c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5},\\,2,\\,0" :db/id #edb/ref 17592186415549} {:answer/id #uuid "5febb191-7c5d-5f4e-82d6-efc23b4d4485" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16,\\,9,\\,0" :db/id #edb/ref 17592186415551} {:answer/id #uuid "73c9cf54-1f9b-52f1-b8ed-dd9e193c12b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186415555} {:answer/id #uuid "9d3fcfba-14a5-5b55-ba3e-4a632953d6dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186415560} {:answer/id #uuid "be6dbb3a-d9f4-5182-87d2-f89ac41af4ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,3,\\,0" :db/id #edb/ref 17592186415562}] :answer-field/correct {:db/id #edb/ref 17592186415560} :answer-field/id #uuid "b838eb18-ab2d-5fe6-b6c3-92ea8e153a8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415573}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9ba2e577-1f2d-586f-a5db-7d03c7c71c22" :question/math-academy-id "q-95375" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{bmatrix}}^{T}\\begin{bmatrix}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 2 \\\\ -1 & 2 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}0 & -1 & 2 \\\\ 2 & 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 4 & 0 \\\\ 4 & 5 & -2 \\\\ 0 & -2 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 4 & 0 \\\\ 4 & 5-\\lambda  & -2 \\\\ 0 & -2 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}5-\\lambda  & -2 \\\\ -2 & 4-\\lambda \\end{vmatrix}-4\\begin{vmatrix}4 & -2 \\\\ 0 & 4-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )[(5-\\lambda )(4-\\lambda )-4)]-16(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda +16)-16(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda ) & =0 \\\\ \\lambda (4-\\lambda )(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "32d51e09-dfa1-5fdb-a2f2-601b26efdfc6" :step/next {:db/id #edb/ref 17592186551366}} {:db/id #edb/ref 17592186551394 :step/content {:db/id #edb/ref 17592186415574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22fab31e-219e-5d18-813a-a8d06acc3248" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,1,\\,0" :db/id #edb/ref 17592186415548} {:answer/id #uuid "7f5778c2-893f-5035-ae58-7208c5dc0a69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,1,\\,1" :db/id #edb/ref 17592186415556} {:answer/id #uuid "8e8616be-5d4c-5647-8715-109f64e7adf8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,2,\\,0" :db/id #edb/ref 17592186415558} {:answer/id #uuid "c1276a11-417f-5453-89d9-104681d36b19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8,\\,4,\\,0" :db/id #edb/ref 1759