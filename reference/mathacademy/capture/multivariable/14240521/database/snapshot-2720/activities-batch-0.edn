38ed" :step/next {:db/id #edb/ref 17592186552552}} {:db/id #edb/ref 17592186552578 :step/content {:db/id #edb/ref 17592186385852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57ba2282-d4ab-5fbf-9130-d06a2eed65a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186385854} {:answer/id #uuid "b45ecc1a-07a7-50a1-a446-cf4a96064ceb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,2,\\,0" :db/id #edb/ref 17592186385855} {:answer/id #uuid "f1a83de7-3a30-52e2-a29e-09bdd3418bd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5,\\,2,\\,1" :db/id #edb/ref 17592186385856} {:answer/id #uuid "01e6f9da-3643-528a-9879-9df01fb0203d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186385857} {:answer/id #uuid "d58280f6-ca95-52bf-80d9-6a8986b3c8bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,1,\\,0" :db/id #edb/ref 17592186385858}] :answer-field/correct {:db/id #edb/ref 17592186385854} :answer-field/id #uuid "7a01643e-564d-5068-bf87-5773a11495bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186385853}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "63c30a7c-7d2d-5a6c-adcf-5b929543dd1a" :question/math-academy-id "q-95369" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}0 & 0 & -2 \\\\ 0 & 2 & 0 \\\\ 0 & -1 & 2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & 0 & -2 \\\\ 0 & 2 & 0 \\\\ 0 & -1 & 2\\end{bmatrix}}^{T}\\begin{bmatrix}0 & 0 & -2 \\\\ 0 & 2 & 0 \\\\ 0 & -1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 2 & -1 \\\\ -2 & 0 & 2\\end{bmatrix}\\begin{bmatrix}0 & 0 & -2 \\\\ 0 & 2 & 0 \\\\ 0 & -1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 5 & -2 \\\\ 0 & -2 & 8\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}0-\\lambda  & 0 & 0 \\\\ 0 & 5-\\lambda  & -2 \\\\ 0 & -2 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (-\\lambda )\\begin{vmatrix}5-\\lambda  & -2 \\\\ -2 & 8-\\lambda \\end{vmatrix} & =0 \\\\ (-\\lambda )((5-\\lambda )(8-\\lambda )-4) & =0 \\\\ (-\\lambda )({\\lambda }^{2}-13\\lambda +36) & =0 \\\\ -\\lambda (\\lambda -4)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "8ef0778d-f6a1-565d-bac6-d274ae87b47f" :step/next {:db/id #edb/ref 17592186552562}} {:db/id #edb/ref 17592186552588 :step/content {:db/id #edb/ref 17592186368913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f0d752a-b826-5c64-be10-12da661ba4f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186368915} {:answer/id #uuid "013ec41c-cc86-5fe4-b29a-accf164dceb1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$13$ and $0$" :db/id #edb/ref 17592186368916} {:answer/id #uuid "24eac0e8-069f-5b0b-9420-f802df54dfb4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{13}$ and $0$" :db/id #edb/ref 17592186368917} {:answer/id #uuid "a9aa8865-fb8b-5614-b9f2-9c3837814ef1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$2$ and $1$" :db/id #edb/ref 17592186368918} {:answer/id #uuid "7be86b9d-e96c-5fac-9a1f-8fb3684e2c62" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\sqrt{3}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186368919}] :answer-field