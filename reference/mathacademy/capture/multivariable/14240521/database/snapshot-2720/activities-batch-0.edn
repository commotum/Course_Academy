 0\\end{bmatrix}\\begin{bmatrix}2 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & -2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}8 & 2 & 0 \\\\ 2 & 5 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}8-\\lambda  & 2 & 0 \\\\ 2 & 5-\\lambda  & 0 \\\\ 0 & 0 & 0-\\lambda \\end{vmatrix} & =0 \\\\ (-\\lambda )\\begin{vmatrix}8-\\lambda  & 2 \\\\ 2 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (-\\lambda )((8-\\lambda )(5-\\lambda )-4) & =0 \\\\ (-\\lambda )({\\lambda }^{2}-13\\lambda +36) & =0 \\\\ \\lambda (\\lambda -4)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "dee7abde-0f42-56cc-828b-bd569fbf629b"} {:db/id #edb/ref 17592186558700 :step/content {:db/id #edb/ref 17592186184877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7d4ed93-75bb-5db0-9900-2362979d6c53" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,3,\\,0" :db/id #edb/ref 17592186404734} {:answer/id #uuid "aac056f1-2c7a-51fc-b3b8-c7516856527b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,2,\\,0" :db/id #edb/ref 17592186404735} {:answer/id #uuid "2ef4562a-20e9-5af5-80a4-ced17b367b83" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,2,\\,0" :db/id #edb/ref 17592186404736} {:answer/id #uuid "fd4157e7-a2cf-562a-af6a-fea80f5a7f86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16,\\,9,\\,0" :db/id #edb/ref 17592186404737} {:answer/id #uuid "95d80c78-37a1-5b82-8b12-a47780191024" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,4,\\,0" :db/id #edb/ref 17592186404738}] :answer-field/correct {:db/id #edb/ref 17592186404735} :answer-field/id #uuid "ce3dc232-fc1d-50e4-99b4-15ed1b8fa187" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186404733}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e9152817-159b-5a54-868d-fe52d19640cc" :question/math-academy-id "q-94981" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & -2 & 2\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & -2 & 2\\end{bmatrix}}^{T}\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & 0 & -2 \\\\ -1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}2 & 0 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 & -2 \\\\ 0 & 4 & -4 \\\\ -2 & -4 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}4-\\lambda  & 0 & -2 \\\\ 0 & 4-\\lambda  & -4 \\\\ -2 & -4 & 5-\\lambda \\end{vmatrix} & =0 \\\\ (4-\\lambda )\\begin{vmatrix}4-\\lambda  & -4 \\\\ -4 & 5-\\lambda \\end{vmatrix}-2\\begin{vmatrix}0 & 4-\\lambda  \\\\ -2 & -4\\end{vmatrix} & =0 \\\\ (4-\\lambda )((4-\\lambda )(5-\\lambda )-16)-4(4-\\lambda ) & =0 \\\\ (4-\\lambda )(20-4\\lambda -5\\lambda +{\\lambda }^{2}-16)-4(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda +4)-4(4-\\lambda ) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda +4-4) & =0 \\\\ (4-\\lambda )({\\lambda }^{2}-9\\lambda ) & =0 \\\\ \\lambda (\\lambda -4)(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,4,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "e2e9eeef-a204-5531-9b0b-bcb266bb0e85" :step/next {:db/id #edb/ref 17592186558711}} {:db/id #edb/ref 17592186558711 :step/content {:db/id #edb/ref 17592186543511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09638aaf-77e9-5651-870e-522b6cc8115f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186542658} {:answer/id #uuid "1d848745-0d69-5731-947e-0a9ae11809b4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186542715} {:answer/id #uuid "aa4333dc-3ea2-5e37-ab50-ec3e34c12a9e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186543088} {:answer/id #uuid "c588edce-5cf5-501a-93b4-d2734b483461" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186543157} {:answer/id #uuid "db2d98c7-af14-5f48-be6c-f11b82999c7b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186543200}] :answer-field/correct {:db/id #edb/ref 17592186543088} :answer-field/id #uuid "a29f2b28-9204-5899-8070-b3f5ffe02498" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543407}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "66207faf-3d6b-5406-8c58-c05d9d84a48f" :question/math-academy-id "q-95283" :question/problem "Which of the following statements are true?\n\nI. The matrix $A=[\\begin{aligned}-10 & 0 \\\\ 0 & 0\\end{aligned}]$ has one negative singular value.\n\nII. Any $2\\times 4$ matrix $A$ has at most $4$ distinct singular values.\n\nIII. Any $6\\times 3$ matrix $A$ has at most $6$ distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false.  All singular values of any matrix are non-negative. So, \n$A$  can't have any negative singular value.\n\n- Statement II is true. Indeed,  since $A$ is a $2\\times 4$ matrix and ${A}^{T}$ is a $4\\times 2$ matrix, ${A}^{T}\\,A$ must be a $4\\times 4$ matrix: \n\n$$\n{{A}^{T}}_{4\\times 2}\\times {A}_{2\\times 4}={{A}^{T}\\,A}_{4\\times 4}\n$$\n\nHence, $A$ has at most $4$ distinct singular values.\n\n- Statement III is false. Since $A$ is a $6\\times 3$ matrix and ${A}^{T}$ is a $3\\times 6$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 6}\\times {A}_{6\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "f44a7619-d9b3-5f27-ae19-cd25ea476dc4" :step/next {:db/id #edb/ref 17592186558699}}] :activity/title "Computing the Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186557854}] [{:activity/course {:db/id #edb/ref 17592186046669} :activity/first-step {:db/id #edb/ref 17592186559962} :activity/id #uuid "456c2843-f8fd-5ae4-a5f7-4b0d67446bb6" :activity/scope {:db/id #edb/ref 17592186049462 :topic/id #uuid "f7488799-2322-5ff9-8065-6852954f5eb5" :topic/math-academy-id 3819} :activity/steps [{:db/id #edb/ref 17592186559952 :step/content {:db/id #edb/ref 17592186404794 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d7b9b80-3654-5da0-af41-f1dd281a1ec6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,3,\\,1" :db/id #edb/ref 17592186404796} {:answer/id #uuid "adfd1028-f71d-5fb8-bf65-f6a904a4cad3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9,\\,1,\\,0" :db/id #edb/ref 17592186404797} {:answer/id #uuid "421f5096-6ffe-58b8-95fd-205273c0d9f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,1,\\,0" :db/id #edb/ref 17592186404798} {:answer/id #uuid "2a9e32e2-6234-54e2-a995-a9f7bc9f67fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,2,\\,0" :db/id #edb/ref 17592186404799} {:answer/id #uuid "b769f855-028a-56bf-bb0f-d1970e2ab6bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1,\\,1,\\,0" :db/id #edb/ref 17592186404800}] :answer-field/correct {:db/id #edb/ref 17592186404798} :answer-field/id #uuid "3e48eb31-ad56-59b2-a6ab-bf3fcb90c449" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186404795}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "de321704-9fad-5ba9-910c-dac492b8f0a2" :question/math-academy-id "q-95377" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}0 & -2 & -1 \\\\ 1 & -2 & 0\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}0 & -2 & -1 \\\\ 1 & -2 & 0\\end{bmatrix}}^{T}\\begin{bmatrix}0 & -2 & -1 \\\\ 1 & -2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 1 \\\\ -2 & \\,\\,-2 \\\\ -1 & 0\\end{bmatrix}\\begin{bmatrix}0 & -2 & -1 \\\\ 1 & -2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 & 0 \\\\ -2 & 8 & 2 \\\\ 0 & 2 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}1-\\lambda  & -2 & 0 \\\\ -2 & 8-\\lambda  & 2 \\\\ 0 & 2 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )\\begin{vmatrix}8-\\lambda  & 2 \\\\ 2 & 1-\\lambda \\end{vmatrix}+2\\begin{vmatrix}-2 & 2 \\\\ 0 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )[(8-\\lambda )(1-\\lambda )-4)]+2(-2)(1-\\lambda ) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-9\\lambda +4)+(-4)(1-\\lambda ) & =0 \\\\ (1-\\lambda )({\\lambda }^{2}-9\\lambda +4-4) & =0 \\\\ \\lambda (1-\\lambda )(\\lambda -9) & =0 \\\\ \\lambda  & =9,\\,1,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "92011cee-25ec-5645-8649-3c5082cdb2df" :step/next {:db/id #edb/ref 17592186559969}} {:db/id #edb/ref 17592186559962 :step/content {:db/id #edb/ref 17592186543482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "026e9975-ba0c-5eae-815a-fcd1e665b3d2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186542645} {:answer/id #uuid "79ac5216-69de-5dc4-a92b-b636df49e5d3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186542962} {:answer/id #uuid "7f21a217-b4f0-55ce-b377-f084a5b14d24" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186542982} {:answer/id #uuid "c2c913d4-93f7-5765-8bb6-090f7d52622b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186543150} {:answer/id #uuid "e014b07e-27e4-516d-adc5-1ef689408d39" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186543210}] :answer-field/correct {:db/id #edb/ref 17592186542962} :answer-field/id #uuid "0c3c93af-58f9-530c-baad-0a629ae81ede" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186543298}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1e0723ce-a987-5c3e-a185-24b9f3aa7c5c" :question/math-academy-id "q-95270" :question/problem "Which of the following statements are true?\n\nI. Any $3\\times 4$ matrix $A$ has at most $4$ distinct singular values.\n\nII. Any $8\\times 6$ matrix $A$ has at most $8$ distinct singular values.\n\nIII. The matrix $A=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]$ has one negative singular value." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Since $A$ is a $3\\times 4$ matrix and ${A}^{T}$ is a $4\\times 3$ matrix, ${A}^{T}\\,A$ must be a $4\\times 4$ matrix: \n\n$$\n{{A}^{T}}_{4\\times 3}\\times {A}_{3\\times 4}={{A}^{T}\\,A}_{4\\times 4}\n$$\n\nHence, $A$ has at most $4$ distinct singular values.\n\n- Statement II is false. Since $A$ is a $8\\times 6$ matrix and ${A}^{T}$ is a $6\\times 8$ matrix, ${A}^{T}\\,A$ must be a $6\\times 6$ matrix: \n\n$$\n{{A}^{T}}_{6\\times 8}\\times {A}_{8\\times 6}={{A}^{T}\\,A}_{6\\times 6}\n$$\n\nHence, $A$ has at most $6$ distinct singular values.\n\n- Statement III is false.  All singular values of any matrix are non-negative. So, \n$A$  can't have a negative singular value.\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "b2c6bcad-aab2-51b4-8844-1a9ba59e06d8" :step/next {:db/id #edb/ref 17592186559973}} {:db/id #edb/ref 17592186559969 :step/content {:db/id #edb/ref 17592186415578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a190c4a-9cc2-50ab-a107-16fc3f92fc4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3},\\,2,\\,0" :db/id #edb/ref 17592186415545} {:answer/id #uuid "1e594ce1-22ea-5fd6-afb9-6b06b4b9255c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2,\\,1,\\,0" :db/id #edb/ref 17592186415546} {:answer/id #uuid "70323d57-c32e-523a-902e-eb0de24ca0c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3,\\,\\sqrt{3},\\,0" :db/id #edb/ref 17592186415554} {:answer/id #uuid "83f12e6b-62c0-5595-a194-e0065cfb501d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,\\,\\sqrt{3},\\,0" :db/id #edb/ref 17592186415557} {:answer/id #uuid "c6eb0c7d-ecb7-57ee-81fb-a558588e214e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2},\\,1,\\,0" :db/id #edb/ref 17592186415564}] :answer-field/correct {:db/id #edb/ref 17592186415564} :answer-field/id #uuid "646b1b63-2cd4-5c4d-b0e4-160d844e1954" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415571}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9d417d43-c45e-500b-a5bf-a441848f66ea" :question/math-academy-id "q-95378" :question/problem "What are the singular values of the matrix $A=\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$  \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{T}\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 1 & 0 \\\\ 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ \\begin{vmatrix}1-\\lambda  & 1 & 0 \\\\ 1 & 1-\\lambda  & 0 \\\\ 0 & 0 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )\\begin{vmatrix}1-\\lambda  & 1 \\\\ 1 & 1-\\lambda \\end{vmatrix} & =0 \\\\ (1-\\lambda )((1-\\lambda )^{2}-1) & =0 \\\\ (1-\\lambda )(1-2\\lambda +{\\lambda }^{2}-1) & =0 \\\\ -\\lambda (\\lambda -1)(\\lambda -2) & =0 \\\\ \\lambda  & =2,\\,1,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{2} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{1}=1 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$"} :step/id #uuid "c7261c21-321e-5abd-8187-70f19af061de" :step/next {:db/id #edb/ref 17592186559972}} {:db/id #edb/ref 17592186559972 :step/content {:db/id #edb/ref 17592186559855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "349f736d-de0d-599c-94b3-d79307c82b40" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186559148} {:answer/id #uuid "4ae6732b-eca3-5cb4-9976-d76d9aaaaa62" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186559211} {:answer/id #uuid "705cd4e5-6f0f-570c-82b2-98b917b98f02" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186559294} {:answer/id #uuid "ce9dcab1-550f-5fde-9320-31c024c5bc69" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186559515} {:answer/id #uuid "faf2a892-5d88-5731-80fa-930f46707b27" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186559634}] :answer-field/correct {:db/id #edb/ref 17592186559634} :answer-field/id #uuid "38f6bcff-7304-5d0b-a0af-efe2d713e856" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559674}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c14fd620-27ea-593f-816e-9c2134638c65" :question/math-academy-id "q-139496" :question/problem "Which of the following statements are true?\n\nI. Any $5\\times 3$ matrix $A$ has at most $3$ distinct singular values.\n\nII. Any $3\\times 5$ matrix $A$ has at most $3$ distinct singular values.\n\nIII. The singular values of the matrix $A=[\\begin{aligned}-1 & 0 \\\\ 0 & -2\\end{aligned}]$ are negative." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Since $A$ is a $5\\times 3$ matrix and ${A}^{T}$ is a $3\\times 5$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 5}\\times {A}_{5\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\n- Statement II is false. Since $A$ is a $3\\times 5$ matrix and ${A}^{T}$ is a $5\\times 3$ matrix, ${A}^{T}\\,A$ must be a $5\\times 5$ matrix: \n\n$$\n{{A}^{T}}_{5\\times 3}\\times {A}_{3\\times 5}={{A}^{T}\\,A}_{5\\times 5}\n$$\n\nHence, $A$ has at most $5$ distinct singular values.\n\n- Statement III is false. All singular values of any matrix are non-negative.\n\nTherefore, the correct answer is \"I only.\""} :step/id #uuid "d141f860-642e-5d1b-b75f-8196aeaa74cc"} {:db/id #edb/ref 17592186559973 :step/content {:db/id #edb/ref 17592186559891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2884dfb8-f94e-5c91-ad86-e9f24321844f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186559118} {:answer/id #uuid "357cad34-4bc7-513b-b925-b09513a89749" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186559149} {:answer/id #uuid "6d73a7ca-949e-5940-a71c-8360af1c5dd7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186559286} {:answer/id #uuid "a72b1823-445c-5fca-a1a8-59da7d424147" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186559437} {:answer/id #uuid "d14824a1-5da1-565c-9821-2d89beac20eb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186559528}] :answer-field/correct {:db/id #edb/ref 17592186559118} :answer-field/id #uuid "0ff2e77b-8d7a-52d3-9995-01bf83f68824" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186559647}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ffe00adb-b1a9-53a2-98b2-87735ab0e412" :question/math-academy-id "q-95279" :question/problem "Which of the following statements are true?\n\nI. The matrix $A=[\\begin{aligned}-2 & 0 \\\\ 0 & -2\\end{aligned}]$ has two negative singular values.\n\nII. Any $4\\times 5$ matrix $A$ has at most $5$ distinct singular values.\n\nIII. Any $8\\times 4$ matrix $A$ has at most $8$ distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false.  All singular values of any matrix are non-negative. So, \n$A$  can't have any negative singular value.\n\n- Statement II is true. Indeed, since $A$ is a $4\\times 5$ matrix and ${A}^{T}$ is a $5\\times 4$ matrix, ${A}^{T}\\,A$ must be a $5\\times 5$ matrix: \n\n$$\n{{A}^{T}}_{5\\times 4}\\times {A}_{4\\times 5}={{A}^{T}\\,A}_{5\\times 5}\n$$\n\nHence, $A$ has at most $5$ distinct singular values.\n\n- Statement III is false. Since $A$ is a $8\\times 4$ matrix and ${A}^{T}$ is a $4\\times 8$ matrix, ${A}^{T}\\,A$ must be a $4\\times 4$ matrix: \n\n$$\n{{A}^{T}}_{4\\times 8}\\times {A}_{8\\times 4}={{A}^{T}\\,A}_{4\\times 4}\n$$\n\nHence, $A$ has at most $4$ distinct singular values.\n\nTherefore, the correct answer is \"II only.\""} :step/id #uuid "d45aa491-e815-5760-826e-8fe2c46d302f" :step/next {:db/id #edb/ref 17592186559952}}] :activity/title "Computing the Singular Values of a Matrix" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186559003}]}
