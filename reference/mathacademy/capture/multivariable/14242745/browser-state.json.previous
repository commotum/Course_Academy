>t</mi></mrow></msup></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mn>2</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>2</mn><mi>t</mi></mrow></msup></mpadded></mstyle></mtd><mtd><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><mn>2</mn><mi>t</mi><mo stretchy=\"false\">)</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>2</mn><mi>t</mi></mrow></msup></mpadded></mstyle></mtd></mtr><mtr><mtd><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>0</mn></mpadded></mstyle></mtd><mtd><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mn>2</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>2</mn><mi>t</mi></mrow></msup></mpadded></mstyle></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
