17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301919}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c0d346a2-b012-5c0d-b429-60020e32ca6b" :question/math-academy-id "q-326002" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=Ax(t),\\,x(0)=[\\begin{aligned}5 \\\\ 3\\end{aligned}]\n$$\n\ngiven that the general solution to our differential equation is\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}3 \\\\ -1\\end{aligned}]{e}^{-t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThe solution to the initial value problem is\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,{e}^{t}+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{-t}.$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |" :question/worked-solution "To find the values of ${c}_{1}$ and ${c}_{2}$, we substitute $t=0$ in the general solution:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}5 \\\\ 3\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{0}+{c}_{2}[\\begin{aligned}3 \\\\ -1\\end{aligned}]{e}^{0} & =[\\begin{aligned}5 \\\\ 3\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1}+3{c}_{2} \\\\ 2{c}_{1}-{c}_{2}\\end{aligned}] & =[\\begin{aligned}5 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}{c}_{1}+3{c}_{2}=5 \\\\ 2{c}_{1}-{c}_{2}=3.\\end{aligned}\n$$\n\nMultiplying the first equation by $-2$ and adding the result to the second equation, we get\n\n$$\n-7{c}_{2}=-7\\,⟹\\,{c}_{2}=1.\n$$\n\nSubstituting this into the first equation, we obtain \n\n$$\n{c}_{1}+3\\cdot 1=5\\,⟹\\,{c}_{1}=2.\n$$\n\n \n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =2\\cdot [\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{t}+1\\cdot [\\begin{aligned}3 \\\\ -1\\end{aligned}]{e}^{-t} \\\\  & =[\\begin{aligned}2 \\\\ 4\\end{aligned}]{e}^{t}+[\\begin{aligned}3 \\\\ -1\\end{aligned}]{e}^{-t}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302281 :knowledge-point/_questions [{:db/id #edb/ref 17592186129311 :knowledge-point/id #uuid "83399378-8815-5602-a60a-6901114416f7" :knowledge-point/title "Solving an Initial Value Problem Given the General Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8d14c6-940a-5c30-9c64-8d3111b48209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186300173}] :answer-field/correct {:answer/id #uuid "2b8d14c6-940a-5c30-9c64-8d3111b48209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186300173} :answer-field/id #uuid "27d90ee8-9b7b-5655-bdb9-b35845b8a020" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301352} {:answer-field/choices [{:answer/id #uuid "4b905818-47d0-5688-8e53-754b61b8cf9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186300353}] :answer-field/correct {:answer/id #uuid "4b905818-47d0-5688-8e53-754b61b8cf9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186300353} :answer-field/id #uuid "880cdb09-c976-533d-a356-040777056247" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301656} {:answer-field/choices [{:answer/id #uuid "9478b209-aa69-503e-aa6d-1ebfe41e52ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186300708}] :answer-field/correct {:answer/id #uuid "9478b209-aa69-503e-aa6d-1ebfe41e52ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186300708} :answer-field/id #uuid "a811076c-a4be-5e04-9fa0-014067261388" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301766} {:answer-field/choices [{:answer/id #uuid "b9181077-b445-5c90-b720-eda52579a89b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300888}] :answer-field/correct {:answer/id #uuid "b9181077-b445-5c90-b720-eda52579a89b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186300888} :answer-field/id #uuid "bf1f9988-a21d-5a26-952f-f3fed6834923" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301852}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad687230-8844-51e9-a75a-cfbd2d9890e7" :question/math-academy-id "q-326294" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=Ax(t),\\,x(0)=[\\begin{aligned}5 \\\\ -5\\end{aligned}]\n$$\n\ngiven that the general solution to our differential equation is\n\n$$\nx(t)={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}1 \\\\ -2\\end{aligned}]{e}^{-t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThe solution to the initial value problem is\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,{e}^{t}+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{-t}.$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |" :question/worked-solution "To find the values of ${c}_{1}$ and ${c}_{2}$, we substitute $t=0$ in the general solution:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}5 \\\\ -5\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{0}+{c}_{2}[\\begin{aligned}1 \\\\ -2\\end{aligned}]{e}^{0} & =[\\begin{aligned}5 \\\\ -5\\end{aligned}] \\\\ [\\begin{aligned}2{c}_{1}+{c}_{2} \\\\ {c}_{1}-2{c}_{2}\\end{aligned}] & =[\\begin{aligned}5 \\\\ -5\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}2{c}_{1}+{c}_{2}=5 \\\\ {c}_{1}-2{c}_{2}=-5.\\end{aligned}\n$$\n\nMultiplying the first equation by $2$ and adding the result to the second equation, we get\n\n$$\n5{c}_{1}=5\\,⟹\\,{c}_{1}=1.\n$$\n\nSubstituting this into the first equation, we obtain \n\n$$\n2\\cdot 1+{c}_{2}=5\\,⟹\\,{c}_{1}=3.\n$$\n\n \nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =1\\cdot [\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{t}+3\\cdot [\\begin{aligned}1 \\\\ -2\\end{aligned}]{e}^{-t} \\\\  & =[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{t}+[\\begin{aligned}3 \\\\ -6\\end{aligned}]{e}^{-t}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186413788 :knowledge-point/_questions [{:db/id #edb/ref 17592186129311 :knowledge-point/id #uuid "83399378-8815-5602-a60a-6901114416f7" :knowledge-point/title "Solving an Initial Value Problem Given the General Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc789ad9-fd8d-540d-b522-2e14081e3a89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186413770}] :answer-field/correct {:answer/id #uuid "fc789ad9-fd8d-540d-b522-2e14081e3a89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186413770} :answer-field/id #uuid "50a25668-c10b-5eab-bdcc-4ddc7f6b1b4e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186413773} {:answer-field/choices [{:answer/id #uuid "7c786fd8-d7ed-5f2a-9e53-0a7f840fdbdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186413755}] :answer-field/correct {:answer/id #uuid "7c786fd8-d7ed-5f2a-9e53-0a7f840fdbdb" :ans