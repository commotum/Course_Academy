5\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{0}+{c}_{2}[\\begin{aligned}1 \\\\ -2\\end{aligned}]{e}^{0} & =[\\begin{aligned}2 \\\\ 5\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1}+{c}_{2} \\\\ {c}_{1}-2{c}_{2}\\end{aligned}] & =[\\begin{aligned}2 \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}{c}_{1}+{c}_{2}=2 \\\\ {c}_{1}-2{c}_{2}=5.\\end{aligned}\n$$\n\nMultiplying the first equation by $2$ and adding the result to the second equation, we get\n\n$$\n3{c}_{1}=9\\,⟹\\,{c}_{1}=3.\n$$\n\nSubstituting this into the first equation, we obtain \n\n$$\n3+{c}_{2}=2\\,⟹\\,{c}_{2}=-1.\n$$\n\n \n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =3\\cdot [\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{2t}+(-1)\\cdot [\\begin{aligned}1 \\\\ -2\\end{aligned}]{e}^{-t} \\\\  & =[\\begin{aligned}3 \\\\ 3\\end{aligned}]{e}^{2t}+[\\begin{aligned}-1 \\\\ 2\\end{aligned}]{e}^{-t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-976e8d31-0eac-5826-97fb-e5a72ed1f999" "answer-field-5f0ddeaa-0a2f-529a-a7bd-3d095a96c1bc" "answer-field-fe194b1f-4a94-5286-8851-0626336088fd" "answer-field-81df9d5d-2f2e-5227-b53d-455a1bcfec46"] :db/ensure [:question/validate]} {:db/id "answer-field-976e8d31-0eac-5826-97fb-e5a72ed1f999" :answer-field/id #uuid "976e8d31-0eac-5826-97fb-e5a72ed1f999" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8084dc72-05d6-52af-90fe-7e244dfcffda" :answer-field/choices ["answer-8084dc72-05d6-52af-90fe-7e244dfcffda"] :db/ensure [:answer-field/validate]} {:db/id "answer-8084dc72-05d6-52af-90fe-7e244dfcffda" :answer/id #uuid "8084dc72-05d6-52af-90fe-7e244dfcffda" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-field-5f0ddeaa-0a2f-529a-a7bd-3d095a96c1bc" :answer-field/id #uuid "5f0ddeaa-0a2f-529a-a7bd-3d0