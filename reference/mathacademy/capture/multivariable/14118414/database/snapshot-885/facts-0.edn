d9-5491-87d1-10edaa216544" #edb/ref 17592186045417] [17592186126983 #edb/ref 1080 "x(t) = 5\\begin{bmatrix}2 \\\\ 1\\end{bmatrix} - \\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}e^{3t}" #edb/ref 17592186045417] [17592186126983 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186126983 #edb/ref 1083 #uuid "d480ee8e-c462-5601-8382-949607afa12e" #edb/ref 17592186045417] [17592186126984 #edb/ref 1080 "x(t) = 5\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}e^{-t} + \\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}e^{-t}" #edb/ref 17592186045417] [17592186126984 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186126984 #edb/ref 1083 #uuid "15448add-38c9-53d2-b4e3-3353b9b4d023" #edb/ref 17592186045417] [17592186126985 #edb/ref 1080 "x(t) = 5\\begin{bmatrix}2 \\\\ 1\\end{bmatrix} + \\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}e^{3t}" #edb/ref 17592186045417] [17592186126985 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186126985 #edb/ref 1083 #uuid "255e5efd-84ae-555c-9fac-86642813a343" #edb/ref 17592186045417] [17592186126986 #edb/ref 1080 "x(t) = 5\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix}e^{-t} + \\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}e^{-t}" #edb/ref 17592186045417] [17592186126986 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186126986 #edb/ref 1083 #uuid "7d5c9215-0b08-500e-ab14-8f6f596a37cd" #edb/ref 17592186045417] [17592186128884 #edb/ref 1069 "e-21137" #edb/ref 17592186045417] [17592186128884 #edb/ref 1071 "Solve the initial value problem\n![](images/c4/c49d8a92f1fa8e94c78250d9b4aa771ef97e322603be667d3be98aa25c82cf81.png)\ngiven that the general solution to our differential equation is\n![](images/e2/e2e235f7970c2f644302c2f119837b14dc5e6f6a94969c53f92c0193f6aca629.png)\n\nThe solution to the initial value problem is\n\n![](images/72/729acfdc97d8800458a057a419b8efdcb5d9087af3374125cfb293584e47394a.png)" #edb/ref 17592186045417] [17592186128884 #edb/ref 1072 #uuid "e16376f2-ffb9-580c-a7e7-57f5814f8289" #edb/ref 17592186045417] [17592186128884 #edb/ref 1074 "To find the values of $c_1$ and $c_2$, we substitute $t=0$ in the general solution:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}7 \\\\ -1\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}3 \\\\ 1\\end{aligned}]{e}^{0}+{c}_{2}[\\begin{aligned}2 \\\\ -1\\end{aligned}]{e}^{0} & =[\\begin{aligned}7 \\\\ -1\\end{aligned}] \\\\ [\\begin{aligned}3{c}_{1}+2{c}_{2} \\\\ {c}_{1}-{c}_{2}\\end{aligned}] & =[\\begin{aligned}7 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}3{c}_{1}+2{c}_{2}=7 \\\\ {c}_{1}-{c}_{2}=-1.\\end{aligned}\n$$\n\nMultiplying the second equation by $2$ and adding the result to the first equation, we get\n\n$$\n5c_1= 5 \n\\qquad\\Longrightarrow\\qquad\nc_1 = 1.\n$$\n\nSubstituting this into the second equation, we obtain \n\n$$\n1 - c_2 = -1\n\\qquad\\Longrightarrow\\qquad\nc_2 = 2.\n$$\n\n \nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =1\\cdot [\\begin{aligned}3 \\\\ 1\\end{aligned}]{e}^{t}+2\\cdot [\\begin{aligned}2 \\\\ -1\\end{aligned}]{e}^{-t} \\\\  & =[\\begin{aligned}3 \\\\ 1\\end{aligned}]{e}^{t}+[\\begin{aligned}4 \\\\ -2\\end{aligned}]{e}^{-t}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186128953 #edb/ref 1069 "e-5608" #edb/ref 17592186045417] [17592186128953 #edb/ref 1071 "Find the solution to the initial value problem\n![](images/e3/e3f6d6e26983db7b894d0bb2ba09e66fdc55edecb0d9bc9d8a35821449707b7e.png)\n\n*Hint: The eigenvalues of the system's matrix are $\\lambda_1=2$ and $\\lambda_2=-3.$*" #edb/ref 17592186045417] [17592186128953 #edb/ref 1072 #uuid "d2768264-6d1a-5e62-9af4-025c877e138b" #edb/ref 17592186045417] [17592186128953 #edb/ref 1074 "Let's construct the matrix differential equation $\\mathbf{x}'(t)=A\\mathbf{x}(t)$ for the given system\n![](images/47/4790200622ff45c885147ca0c897eefcbb4bdcefe10d67b8960cc167c3b2cccf.png)\n\n- We are given that the eigenvalues are\n\n$$\n\\lambda_1= 2\n\\qquad\\text{and}\\qquad\n\\lambda_2= -3.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For $\\lambda_1 =2,$ we get \n![](images/10/10bbcec99a48d331c21836dc104a1db2db241e50a534baf0db23c138168c5663.png)\nSo, we get an eigenvector \n![](images/c2/c2bff2faa79d780c5f89b28e72468c84a388d50e8c566b80e5d5677f90a5e3af.png)\n\n- For $\\lambda_2 =-3,$ we get \n![](images/70/704493d5ac4f48c88a9c521c4e43c41acfd80b6d6959237944fbc0d638e6012f.png)\nSo, we get an eigenvector \n![](images/a7/a77312d93a804e69dabb70aff5bc7bbf9798781c728dfc50fff1440da86b5b5c.png)\n\nNow, we write down the general solution to the given linear system of differential equations:\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{2t}+{c}_{2}[\\begin{aligned}1 \\\\ 6\\end{aligned}]{e}^{-3t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$\n\nNow, to find the values of $c_1$ and $c_2,$ we substitute $t=0$ in the general solution and use the initial values:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}5 \\\\ 0\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{0}+{c}_{2}[\\begin{aligned}1 \\\\ 6\\end{aligned}]{e}^{0} & =[\\begin{aligned}5 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1}+{c}_{2} \\\\ {c}_{1}+6{c}_{2}\\end{aligned}] & =[\\begin{aligned}5 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}{c}_{1}+{c}_{2}=5 \\\\ {c}_{1}+6{c}_{2}=0\\end{aligned}\n$$\n\nSubtracting the first equation from the second equation, we get\n\n$$\n\\begin{aligned}5{c}_{2}=-5\\,⟹\\,{c}_{2}=-1.\\end{aligned}\n$$\n\nSubstituting $c_2 = -1$ into the first equation, we obtain \n\n$$\n\\begin{aligned}{c}_{1}-1=5\\,⟹\\,{c}_{1}=6.\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =6[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{2t}-[\\begin{aligned}1 \\\\ 6\\end{aligned}]{e}^{-3t}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186128954 #edb/ref 1069 "e-5609" #edb/ref 17592186045417] [17592186128954 #edb/ref 1071 "Let $\\lambda_1=3$ and $\\lambda_2=-2$ be eigenvalues of the $2\\times 2$ matrix  $A$ that correspond to eigenvectors \n![](images/15/15d8764ce12b985a991ca9a0704ba037ccc29fa488a3f23ee643688ceebae60c.png) \nGiven that the position of a particle at time $t$ seconds is given by the vector $\\mathbf{x}(t)$ and that $\\mathbf{x}(t)$ is the solution to the initial value problem\n![](images/88/88cd1c87501899a5d6b49ce3fd1678fe9485300a2da638fb496f2c80b298ea86.png)\nfind the position of the particle after $2$ seconds." #edb/ref 17592186045417] [17592186128954 #edb/ref 1072 #uuid "226a5f8f-ac26-5f3e-8f8f-f145c314820f" #edb/ref 17592186045417] [17592186128954 #edb/ref 1074 "Given a system of first-order linear ODEs in the form\n\n$$\n\\mathbf{x}'(t)=A\\mathbf{x}(t)\n$$\n\nwhere $A$ has two distinct eigenvalues ${\\color{red}\\lambda_1}, {\\color{blue}\\lambda_2}$ with corresponding eigenvectors ${\\color{red}\\mathbf{v}_1}$ and ${\\color{blue}\\mathbf{v}_2},$ the formula for the general solution is\n\n$$\n\\mathbf{x}(t) = c_1{\\color{red}\\mathbf{v}_1} e^{{\\color{red}\\lambda_1} t} + c_2{\\color{blue}\\mathbf{v}_2} e^{{\\color{blue}\\lambda_2} t}, \\qquad c_1,c_2 \\in \\mathbb{R}.\n$$\n\nTherefore, the general solution to our matrix differential equation is\n\n$$\n\\begin{aligned}x(t)={c}_{1}[\\begin{aligned}6 \\\\ -2\\end{aligned}]{e}^{3t}+{c}_{2}[\\begin{aligned}1 \\\\ -3\\end{aligned}]{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nNow, to find the values of $c_1$ and $c_2,$ we substitute $t=0$ into the general solution:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}-11 \\\\ 1\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}6 \\\\ -2\\end{aligned}]{e}^{0}+{c}_{2}[\\begin{aligned}1 \\\\ -3\\end{aligned}]{e}^{0} & =[\\begin{aligned}-11 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}6{c}_{1}+{c}_{2} \\\\ -2{c}_{1}-3{c}_{2}\\end{aligned}] & =[\\begin{aligned}-11 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}6{c}_{1}+{c}_{2}=-11 \\\\ -2{c}_{1}-3{c}_{2}=1.\\end{aligned}\n$$\n\nMultiplying the first equation by $3$ and adding the result to the second equation, we get\n\n$$\n16c_1 = -32\n\\qquad\\Longrightarrow\\qquad\nc_1=-2.\n$$\n\nSubstituting this into the second equation, we obtain \n\n$$\n-2\\cdot(-2) -3c_2 = 1\n\\qquad\\Longrightarrow\\qquad\nc_2=1.\n$$\n\n \n\nTherefore, the solution for the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =-2\\cdot [\\begin{aligned}6 \\\\ -2\\end{aligned}]{e}^{3t}+1\\cdot [\\begin{aligned}1 \\\\ -3\\end{aligned}]{e}^{-2t} \\\\  & =[\\begin{aligned}-12 \\\\ 4\\end{aligned}]{e}^{3t}+[\\begin{aligned}1 \\\\ -3\\end{aligned}]{e}^{-2t}.\\end{aligned}\n$$\n\nFinally, we calculate $\\mathbf x(2)\\mathbin{:}$\n\n$$\n\\begin{aligned}x(2) & =[\\begin{aligned}-12 \\\\ 4\\end{aligned}]{e}^{3\\cdot 2}+[\\begin{aligned}1 \\\\ -3\\end{aligned}]{e}^{-2\\cdot 2} \\\\  & =[\\begin{aligned}-12{e}^{6}+{e}^{-4} \\\\ 4{e}^{6}-3{e}^{-4}\\end{aligned}]\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186129311 #edb/ref 1037 #edb/ref 17592186049852 #edb/ref 17592186045417] [17592186129311 #edb/ref 1038 #edb/ref 17592186129578 #edb/ref 17592186045417] [17592186129311 #edb/ref 1038 #edb/ref 17592186129584 #edb/ref 17592186045417] [17592186129311 #edb/ref 1038 #edb/ref 17592186302280 #edb/ref 17592186045417] [17592186129311 #edb/ref 1038 #edb/ref 17592186302281 #edb/ref 17592186045417] [17592186129311 #edb/ref 1038 #edb/ref 17592186302282 #edb/ref 17592186045417] [17592186129311 #edb/ref 1038 #edb/ref 17592186302283 #edb/ref 17592186045417] [17592186129311 #edb/ref 1038 #edb/ref 17592186370049 #edb/ref 17592186045417] [17592186129311 #edb/ref 1039 "Solving an Initial Value Problem Given the General Solution" #edb/ref 17592186045417] [17592186129311 #edb/ref 1041 #edb/ref 17592186128884 #edb/r