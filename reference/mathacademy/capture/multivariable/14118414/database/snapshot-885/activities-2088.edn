#{[{:activity/first-step {:db/id #edb/ref 17592186130288} :activity/id #uuid "cf0445f2-a611-590c-9874-d90229e6ea42" :activity/scope {:db/id #edb/ref 17592186050098 :topic/id #uuid "2d131eff-4143-5f33-ab1b-d2795c01303f" :topic/math-academy-id 2088} :activity/steps [{:db/id #edb/ref 17592186130288 :step/content {:db/id #edb/ref 17592186130360 :tutorial/content "An **initial value problem (IVP)** for a homogeneous linear system has the form\n\n$$\n\\mathbf{x}'(t)=A\\mathbf{x}(t),\n\\qquad \n\\mathbf{x}(t_0)=\\mathbf{x}_0,\n$$\n\nwhere $A$ is a constant $2 \\times 2$ matrix and $\\mathbf{x}_0\\in\\mathbb{R}^2$ is the given initial state at $t=t_0.$ In other words, in an IVP we seek the solution of $\\mathbf{x}'(t)=A\\mathbf{x}(t)$ that passes through the point $\\mathbf{x}_0$ at $t=t_0.$\n\nTo solve an IVP, we proceed as follows:\n\n- Find the general solution of the system $\\mathbf{x}'(t)=A\\mathbf{x}(t){:}$\n\n$$\n\\mathbf{x}(t)=c_1\\mathbf{x}_1(t)+c_2\\mathbf{x}_2(t)\n$$\n\n- Substitute $t=t_0$ into the general solution and use the initial condition $\\mathbf{x}(t_0)=\\mathbf{x}_0{:}$\n\n$$\n\\mathbf{x}(t_0)=c_1\\mathbf{x}_1(t_0)+c_2\\mathbf{x}_2(t_0)\n\\qquad\\Rightarrow\\qquad\nc_1\\mathbf{x}_1(t_0)+c_2\\mathbf{x}_2(t_0)=\\mathbf{x}_0\n$$\n\n- Solve the resulting linear system for $c_1$ and $c_2,$ then substitute those values back into $\\mathbf{x}(t).$\n\nThe definition (and the procedure) above generalizes directly to the $n\\times n$ case.\n\nLet's see some concrete examples of solving an IVP." :tutorial/id #uuid "92ec67c9-079c-5825-825b-08cca4b2cf25" :tutorial/math-academy-id 3651 :tutorial/title "Introduction"} :step/id #uuid "c26cbdb9-e4ae-57e4-8ad0-478213ccd227" :step/math-academy-id 587180 :step/next {:db/id #edb/ref 17592186130289}} {:db/id #edb/ref 17592186130289 :step/content {:db/id #edb/ref 17592186129311 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128884 :question/id #uuid "e16376f2-ffb9-580c-a7e7-57f5814f8289" :question/math-academy-id "e-21137"} :knowledge-point/id #uuid "83399378-8815-5602-a60a-6901114416f7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049852}] :knowledge-point/questions [{:db/id #edb/ref 17592186129578} {:db/id #edb/ref 17592186129584} {:db/id #edb/ref 17592186302280} {:db/id #edb/ref 17592186302281} {:db/id #edb/ref 17592186302282} {:db/id #edb/ref 17592186302283} {:db/id #edb/ref 17592186370049}] :knowledge-point/title "Solving an Initial Value Problem Given the General Solution"} :step/id #uuid "d0ac3561-63c3-5604-a2d7-f38c8ca2d824" :step/math-academy-id 587181 :step/next {:db/id #edb/ref 17592186130290}} {:db/id #edb/ref 17592186130290 :step/content {:db/id #edb/ref 17592186129312 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128954 :question/id #uuid "226a5f8f-ac26-5f3e-8f8f-f145c314820f" :question/math-academy-id "e-5609"} :knowledge-point/id #uuid "35a8694d-4fa1-54a6-a492-3025cb627fa1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048452}] :knowledge-point/questions [{:db/id #edb/ref 17592186129725} {:db/id #edb/ref 17592186129726} {:db/id #edb/ref 17592186326756} {:db/id #edb/ref 17592186371105} {:db/id #edb/ref 17592186389608} {:db/id #edb/ref 17592186389615} {:db/id #edb/ref 17592186393961}] :knowledge-point/title "Solving an Initial Value Problem Given the Eigenvectors and Eigenvalues of the Corresponding Matrix"} :step/id #uuid "89c5622e-b252-5578-bb6d-ccdb5821b61d" :step/math-academy-id 587184 :step/next {:db/id #edb/ref 17592186130291}} {:db/id #edb/ref 17592186130291 :step/content {:db/id #edb/ref 17592186129313 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128953 :question/id #uuid "d2768264-6d1a-5e62-9af4-025c877e138b" :question/math-academy-id "e-5608"} :knowledge-point/id #uuid "833d0ec0-d895-5d66-b2ad-d058858caf9e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048775} {:db/id #edb/ref 17592186050001}] :knowledge-point/questions [{:db/id #edb/ref 17592186129582} {:db/id #edb/ref 1759