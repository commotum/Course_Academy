#{[{:db/id #edb/ref 17592186508911 :knowledge-point/_questions [{:db/id #edb/ref 17592186176022 :knowledge-point/id #uuid "9308a83f-ed86-5cbc-9b23-c1fec9fca6a4" :knowledge-point/title "Evaluating a Limit Using a Variable Substitution: Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cc1ba37-52fc-50dc-b984-9dc568bfe31c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{e}" :db/id #edb/ref 17592186508478} {:answer/id #uuid "3f0635c7-95c2-5ca0-b103-4151020dda21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186508481} {:answer/id #uuid "7affb6d5-dcf4-5d5f-997f-81bf1706c88d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{2}}" :db/id #edb/ref 17592186508570} {:answer/id #uuid "fdebe404-8aed-5769-8c60-015f60d99e5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186508806} {:answer/id #uuid "fef041c0-b3ba-511a-a1db-5120dc4f98a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e}{2}" :db/id #edb/ref 17592186508809}] :answer-field/correct {:answer/id #uuid "3f0635c7-95c2-5ca0-b103-4151020dda21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186508481} :answer-field/id #uuid "9e72dc91-9bb2-5a52-9ea8-c8a3392b078f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508865}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00868e65-0caa-53d3-bac1-8c3f5e5b6143" :question/math-academy-id "q-118712" :question/problem "Evaluate ${lim}_{x\\to \\infty }{(\\frac{x+2}{x+1})}^{2x+2}.$" :question/worked-solution "Notice that as $x\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{x\\to \\infty }{(\\frac{x+2}{x+1})}^{2x+2}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}=e\n$$\n\nWe rewrite the given limit as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }{(\\frac{x+2}{x+1})}^{2x+2} & ={lim}_{x\\to \\infty }{(\\frac{(x+1)+1}{x+1})}^{2x+2} \\\\  & ={lim}_{x\\to \\infty }{(1+\\frac{1}{x+1})}^{2(x+1)}\\end{aligned}\n$$\n\nLet $x+1=n.$ Therefore, since $n\\to \\infty $ as $x\\to \\infty ,$ we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }{(\\frac{x+2}{x+1})}^{2x+2} & ={lim}_{x\\to \\infty }{(1+\\frac{1}{x+1})}^{2(x+1)} \\\\  & ={lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{2n} \\\\  & ={lim}_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{2} \\\\  & ={[{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{2} \\\\  & ={e}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186508959 :knowledge-point/_questions [{:db/id #edb/ref 17592186176022 :knowledge-point/id #uuid "9308a83f-ed86-5cbc-9b23-c1fec9fca6a4" :knowledge-point/title "Evaluating a Limit Using a Variable Substitution: Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "141e356a-c0b9-53fb-a3fa-1c304d6a2600" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3}" :db/id #edb/ref 17592186508418} {:answer/id #uuid "24156e2e-8841-555a-a19b-1a625b98dde5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186508448} {:answer/id #uuid "35e61fc0-40f6-5aef-922f-50f62512b14d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{2}}" :db/id #edb/ref 17592186508469} {:answer/id #uuid "5e34251a-f4f3-549b-a7a0-aeaadf3cbdfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{7}" :db/id #edb/ref 17592186508531} {:answer/id #uuid "8cfcba74-2e37-531b-b078-1a79a99a831c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{6}" :db/id #edb/ref 17592186508603}] :answer-field/correct {:answer/id #uuid "24156e2e-8841-555a-a19b-1a625b98dde5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186508448} :answer-field/id #uuid "ac530e0e-d3d1-5a9a-9415-9ac86edc2ff1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508870}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "981ba9c5-75b9-5f37-b62a-2b2258f28bdb" :question/math-academy-id "q-118714" :question/problem "Evaluate ${lim}_{x\\to \\infty }{(\\frac{3x+1}{3x})}^{6x}.$" :question/worked-solution "Notice that as $x\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{x\\to \\infty }{(\\frac{3x+1}{3x})}^{6x}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}=e\n$$\n\nWe rewrite the given limit as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }{(\\frac{3x+1}{3x})}^{6x} & ={lim}_{x\\to \\infty }{(1+\\frac{1}{3x})}^{2(3x)}\\end{aligned}\n$$\n\nLet $3x=n.$ Therefore, since $n\\to \\infty $ as $x\\to \\infty ,$ we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }{(\\frac{3x+1}{3x})}^{6x} & ={lim}_{x\\to \\infty }{(1+\\frac{1}{3x})}^{2(3x)} \\\\  & ={lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{2n} \\\\  & ={lim}_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{2} \\\\  & ={[{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{2} \\\\  & ={e}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186508976 :knowledge-point/_questions [{:db/id #edb/ref 17592186176022 :knowledge-point/id #uuid "9308a83f-ed86-5cbc-9b23-c1fec9fca6a4" :knowledge-point/title "Evaluating a Limit Using a Variable Substitution: Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19cd2332-d9e4-5f07-a6f6-b1f461806d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{2}}" :db/id #edb/ref 17592186508431} {:answer/id #uuid "31e0be61-4604-5a58-b042-bc92fc457d48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{e}" :db/id #edb/ref 17592186508463} {:answer/id #uuid "edae2223-31c8-57b8-91a2-c2b71c6e6090" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186508771} {:answer/id #uuid "f7b08025-f86f-5c45-b65e-e33d0d2c521c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{e}}" :db/id #edb/ref 17592186508795} {:answer/id #uuid "f7b94c54-bdfd-5cd4-a505-1c37eeea500c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186508796}] :answer-field/correct {:answer/id #uuid "31e0be61-4604-5a58-b042-bc92fc457d48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{e}" :db/id #edb/ref 17592186508463} :answer-field/id #uuid "c7bcd67e-475b-5366-91b7-b32feba0f989" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508882}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c8a37d3e-d129-5ae7-8ba8-cbd709bbd8bf" :question/math-academy-id "q-118721" :question/problem "Evaluate ${lim}_{x\\to \\infty }{(\\frac{2x-1}{2x-2})}^{x-1}.$" :question/worked-solution "Notice that as $x\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{x\\to \\infty }{(\\frac{2x-1}{2x-2})}^{x-1}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}=e\n$$\n\nWe rewrite the given limit as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }{(\\frac{2x-1}{2x-2})}^{x-1} & ={lim}_{x\\to \\infty }{(\\frac{(2x-2)+1}{2x-2})}^{x-1} \\\\  & ={lim}_{x\\to \\infty }{(1+\\frac{1}{2x-2})}^{x-1} \\\\  & ={lim}_{x\\to \\infty }{(1+\\frac{1}{2(x-1)})}^{x-1}\\end{aligned}\n$$\n\nLet $2(x-1)=n$ Then, we have \n\n$$\n\\begin{aligned}2(x-1) & =n \\\\ x-1 & =\\frac{n}{2}.\\end{aligned}\n$$\n\nTherefore, since $n\\to \\infty $ as $x\\to \\infty ,$ we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }{(\\frac{2x-1}{2x-2})}^{x-1} & ={lim}_{x\\to \\infty }{(1+\\frac{1}{2(x-1)})}^{x-1} \\\\  & ={lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n/2} \\\\  & ={lim}_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{1/2} \\\\  & ={[{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{1/2} \\\\  & ={e}^{1/2} \\\\  & =\\sqrt{e}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186508953 :knowledge-point/_questions [{:db/id #edb/ref 17592186176019 :knowledge-point/id #uuid "6dbad5d4-6001-5be5-9ed3-0b959f4d7d92" :knowledge-point/title "Evaluating a Limit Using a Variable Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "142517b8-196c-572d-bb30-b593804d312b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{e}" :db/id #edb/ref 17592186508419} {:answer/id #uuid "2e13745f-0660-51aa-b3c9-308fbcc11a7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{{e}^{3}}" :db/id #edb/ref 17592186508459} {:answer/id #uuid "b79e0202-007e-5255-baf6-8ab1013d2835" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{{e}^{2}}" :db/id #edb/ref 17592186508665} {:answer/id #uuid "d1fa933c-70d4-5eac-8738-8875677c238c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{3}}" :db/id #edb/ref 17592186508726} {:answer/id #uuid "eab3a712-8119-5c80-9935-77d99f9b65c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt[3]{e}}" :db/id #edb/ref 17592186508765}] :answer-field/correct {:answer/id #uuid "142517b8-196c-572d-bb30-b593804d312b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{e}" :db/id #edb/ref 17592186508419} :answer-field/id #uuid "b4d49d40-4bea-500d-bdf8-019158dcd1ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186508875}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "91b96bb8-d0ec-5384-8420-38fd513a4a78" :question/math-academy-id "q-127543" :question/problem "Evaluate ${lim}_{t\\to \\infty }{(1+\\frac{1}{3t-6})}^{t-2}.$" :question/worked-solution "Notice that as $t\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{t\\to \\infty }{(1+\\frac{1}{3t-6})}^{t-2}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}=e\n$$\n\nIn the given limit, we let $3t-6=n.$ Thus, we have\n\n$$\n\\begin{aligned}3t-6 & =n \\\\ 3(t-2) & =n \\\\ t-2 & =\\frac{n}{3}\\end{aligned}\n$$\n\nTherefore, since $n\\to \\infty $ as $t\\to \\infty ,$ we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{t\\to \\infty }{(1+\\frac{1}{3t-6})}^{t-2} & ={lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n/3} \\\\  & ={lim}_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{1/3} \\\\  & ={[{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{1/3} \\\\  & ={e}^{1/3} \\\\  & =\\sqrt[3]{e}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186508979 :knowledge-point/_questions [{:db/id #edb/ref 17592186176019 :knowledge-point/id #uuid "6dbad5d4-6001-5be5-9ed3-0b959f4d7d92" :knowledge-point/title "Evaluating a Limit Using a Variable Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c1642b7-884e-5096-ad66-1a3b13f3c305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{6}" :db/id #edb/ref 17592186508623}] :answer-field/correct {:answer/id #uuid "9c1642b7-884e-5096-ad66-1a3b13f3c305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{6}" :db/id #edb/ref 17592186508623} :answer-field/id #uuid "eb677ded-facb-5ee5-9acc-a1da685a4a6b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186508900}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cff12c80-2e8b-52fc-a40b-42f5ea296e0f" :question/math-academy-id "q-338566" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\infty }{(1+\\frac{3}{x})}^{2x}=$\n{{field-1}}" :question/worked-solution "Notice that as $x\\to \\infty ,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{x\\to \\infty }{(1+\\frac{3}{x})}^{2x}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}=e\n$$\n\nIn the given limit, we let $\\frac{3}{x}=\\frac{1}{n}.$ Thus, we have\n\n$$\n\\begin{aligned}\\frac{3}{x} & =\\frac{1}{n} \\\\ x & =3n.\\end{aligned}\n$$\n\nTherefore, since $n\\to \\infty $ as $x\\to \\infty ,$ we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }{(1+\\frac{3}{x})}^{2x} & ={lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{2(3n)} \\\\  & ={lim}_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{6} \\\\  & ={[{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{6} \\\\  & ={e}^{6}\\end{aligned}\n$$"}]}
