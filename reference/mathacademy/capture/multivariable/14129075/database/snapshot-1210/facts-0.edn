b/ref 17592186045417] [17592186402685 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186402685 #edb/ref 1083 #uuid "5cdabe0b-331f-59b0-be6a-e0b333cf7d10" #edb/ref 17592186045417] [17592186402686 #edb/ref 1080 "The critical points lie on the plane $w=u.$" #edb/ref 17592186045417] [17592186402686 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186402686 #edb/ref 1083 #uuid "edca51bc-5f25-52b9-81ee-5e945aaea583" #edb/ref 17592186045417] [17592186402687 #edb/ref 1080 "The critical points lie on the $uv-$plane." #edb/ref 17592186045417] [17592186402687 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186402687 #edb/ref 1083 #uuid "2daa5374-5e80-5f12-9e7f-d5612c496bb5" #edb/ref 17592186045417] [17592186406760 #edb/ref 1080 "The critical points lie on the $uw-$plane." #edb/ref 17592186045417] [17592186406760 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186406760 #edb/ref 1083 #uuid "06cfa4e4-4978-5d07-b498-b67163d323ba" #edb/ref 17592186045417] [17592186406762 #edb/ref 1080 "The critical points lie on the sphere ${x}^{2}+{y}^{2}+{z}^{2}=1.$" #edb/ref 17592186045417] [17592186406762 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186406762 #edb/ref 1083 #uuid "47f0e73b-3fcc-5922-ac4c-5cbbb15dc078" #edb/ref 17592186045417] [17592186406763 #edb/ref 1080 "The critical points lie on the $vw-$plane." #edb/ref 17592186045417] [17592186406763 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186406763 #edb/ref 1083 #uuid "4cd27081-6df8-5fcc-87e8-0b763e12dd24" #edb/ref 17592186045417] [17592186406766 #edb/ref 1080 "The critical points lie on the plane $v=1.$" #edb/ref 17592186045417] [17592186406766 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186406766 #edb/ref 1083 #uuid "bdd4d236-b060-5654-b754-6a3374d3448b" #edb/ref 17592186045417] [17592186406768 #edb/ref 1080 "The critical points lie on the plane $v=u.$" #edb/ref 17592186045417] [17592186406768 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186406768 #edb/ref 1083 #uuid "ddaabaf5-f0e8-54a9-9f5a-d6c4751feaf2" #edb/ref 17592186045417] [17592186406769 #edb/ref 1075 #edb/ref 17592186406760 #edb/ref 17592186045417] [17592186406769 #edb/ref 1075 #edb/ref 17592186406762 #edb/ref 17592186045417] [17592186406769 #edb/ref 1075 #edb/ref 17592186406763 #edb/ref 17592186045417] [17592186406769 #edb/ref 1075 #edb/ref 17592186406766 #edb/ref 17592186045417] [17592186406769 #edb/ref 1075 #edb/ref 17592186406768 #edb/ref 17592186045417] [17592186406769 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186406769 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186406769 #edb/ref 1078 #edb/ref 17592186406760 #edb/ref 17592186045417] [17592186406769 #edb/ref 1079 #uuid "06a97003-66fd-5b44-944b-7b4ac3d8364b" #edb/ref 17592186045417] [17592186406771 #edb/ref 1068 #edb/ref 17592186406769 #edb/ref 17592186045417] [17592186406771 #edb/ref 1069 "q-161810" #edb/ref 17592186045417] [17592186406771 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186406771 #edb/ref 1071 "Find the locations of all of the critical points of the transformation $T,$ where $T$ is defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}u+vw \\\\ {v}^{2} \\\\ w+v\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186406771 #edb/ref 1072 #uuid "84951e54-c705-5b01-85eb-275b777e397c" #edb/ref 17592186045417] [17592186406771 #edb/ref 1074 "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w)=u+vw,\\,y(u,v,w)={v}^{2},\\,z(u,v,w)=w+v.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =1 & \\,\\frac{∂x}{∂v} & =w & \\,\\frac{∂x}{∂w} & =v \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & =2v & \\,\\frac{∂y}{∂w} & =0 \\\\ \\frac{∂z}{∂u} & =0 & \\,\\frac{∂z}{∂v} & =1 & \\,\\frac{∂z}{∂w} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}1 & w & v \\\\ 0 & 2v & 0 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =1|\\begin{aligned}2v & 0 \\\\ 1 & 1\\end{aligned}| \\\\  & =1(2v-0) \\\\  & =2v.\\end{aligned}\n$$\n\nThe function has critical points when $\\frac{∂(x,y,z)}{∂(u,v,w)}=0.$ So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =0 \\\\ 2v & =0 \\\\ v & =0.\\end{aligned}\n$$\n\nThe equation $v=0$ defines the plane $v=0,$ i.e., $uw$-plane." #edb/ref 17592186045417] [17592186416646 #edb/ref 1043 #edb/ref 17592186416647 #edb/ref 17592186045417] [17592186416646 #edb/ref 1043 #edb/ref 17592186416648 #edb/ref 17592186045417] [17592186416646 #edb/ref 1043 #edb/ref 17592186416649 #edb/ref 17592186045417] [17592186416646 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186416646 #edb/ref 1045 "The Jacobian of a Three-Dimensional Transformation" #edb/ref 17592186045417] [17592186416646 #edb/ref 1046 #edb/ref 17592186416648 #edb/ref 17592186045417] [17592186416646 #edb/ref 1048 #edb/ref 17592186046659 #edb/ref 17592186045417] [17592186416646 #edb/ref 1049 #edb/ref 17592186049530 #edb/ref 17592186045417] [17592186416646 #edb/ref 1053 #uuid "44c9ee16-7425-5861-8f66-16a66ae948b5" #edb/ref 17592186045417] [17592186416647 #edb/ref 1058 #edb/ref 17592186416649 #edb/ref 17592186045417] [17592186416647 #edb/ref 1062 #uuid "1059b764-2977-50ff-bfe0-2e03c6d8a3b7" #edb/ref 17592186045417] [17592186416647 #edb/ref 1063 #edb/ref 17592186129754 #edb/ref 1759218