-5bfd-8df3-5bd27cd65640" :knowledge-point/title "Determining the Dimension of a Polynomial Vector Space Given Its Standard Monomial Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "017dfaf7-4ac9-510d-9d61-b37c8e931dad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186561584} {:answer/id #uuid "1edeb7da-5493-544c-87e7-d2e7db00b8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186561664} {:answer/id #uuid "7d3c4f5a-d312-52c5-9d3b-d9a1692c2a6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186561895} {:answer/id #uuid "86bd66e0-30c4-510e-b030-d1eb20be4d9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186561920} {:answer/id #uuid "a7657467-0037-5ac7-a3db-1430713499d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186561997}] :answer-field/correct {:answer/id #uuid "1edeb7da-5493-544c-87e7-d2e7db00b8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186561664} :answer-field/id #uuid "ecd3bf12-b1f6-5c4e-9bad-9599ba17393a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562374}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa31176f-d01d-551f-8a93-0788b21bb0df" :question/math-academy-id "q-106870" :question/problem "What is the dimension of ${R}_{13}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $13?$" :question/worked-solution "The standard basis of ${R}_{n}[t]$ is\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{n}\\}.\n$$\n\nSo, the standard basis of ${R}_{13}[t]$ is \n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{13}\\}.\n$$\n\nTherefore, we have that \n\n$$\n\\text{dim}({R}_{13}[t])=13+1=14.\n$$\n\nIn general,\n\n$$\n\\text{dim}({R}_{n}[t])=n+1.\n$$"}] [{:db/id #edb/ref 17592186562468 :knowledge-point/_questions [{:db/id #edb/ref 17592186152222 :knowledge-point/id #uuid "b61a755f-23e8-5039-b2f5-b5984fdb420c" :knowledge-point/title "Determining the Dimension of a Matrix Vector Space Given Its Standard Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48724e40-2537-5993-a9ac-f90136d4706d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "51" :db/id #edb/ref 17592186561765} {:answer/id #uuid "704ca1d5-8fbc-545a-a7fc-7fef0adaebcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186561860} {:answer/id #uuid "ac081ada-e903-5cd6-86dc-983aac36c0ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186562010} {:answer/id #uuid "e7eef5a1-6369-528c-8470-5e884104b19a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186562153} {:answer/id #uuid "f989d214-29fe-5513-93bb-4bb8188098f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186562199}] :answer-field/correct {:answer/id #uuid "e7eef5a1-6369-528c-8470-5e884104b19a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186562153} :answer-field/id #uuid "fee18a9e-3a2d-5f93-9c78-89a367b51148" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562384}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ec0dc53-4341-5ee6-84a6-d12231a31e63" :question/math-academy-id "q-106875" :question/problem "What is the dimension of ${\\text{M}}_{5\\times 1}(R),$ the vector space of all $5\\times 1$ matrices over $R?$" :question/worked-solution "The standard basis of ${\\text{M}}_{n\\times m}(R)$ contains a total of $n\\cdot m$ matrices, each with one nonzero entry that is equal to $1.$ \n\nThus, the standard basis of ${\\text{M}}_{5\\times 1}(R)$ contains $5\\cdot 1=5$ elements, and is given by\n\n$$\n\\{[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}0 \\\\ 1 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}0 \\\\ 0 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}0 \\\\ 0 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}0 \\\\ 0 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]\\}.\n$$\n\nTherefore, for ${\\text{M}}_{5\\times 1}(R),$ we have, indeed, \n\n$$\n\\text{dim}({\\text{M}}_{5\\times 1}(R))=5\\cdot 1=5.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.\n$$"}] [{:db/id #edb/ref 17592186495081 :knowledge-point/_questions [{:db/id #edb/ref 17592186152222 :knowledge-point/id #uuid "b61a755f-23e8-5039-b2f5-b5984fdb420c" :knowledge-point/title "Determining the Dimension of a Matrix Vector Space Given Its Standard Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bd1a089-11bd-5537-b24d-b5320d066943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186494404} {:answer/id #uuid "7b41ed65-ebd8-5e8a-9322-4359d606455b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186494583} {:answer/id #uuid "98625c99-1d21-5d81-8b45-7668916611fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186494665} {:answer/id #uuid "c68081df-1e95-51e2-8875-d1f0093b0cbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186494784} {:answer/id #uuid "ca864cf8-1d57-54a6-bac6-6cdaa11ca7a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186494796}] :answer-field/correct {:answer/id #uuid "98625c99-1d21-5d81-8b45-7668916611fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186494665} :answer-field/id #uuid "b725a1ed-492c-532e-82ae-acdc74378877" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186495005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4868b354-15b9-5c4c-bfd0-122202f40c50" :question/math-academy-id "q-106882" :question/problem "What is the dimension of ${\\text{M}}_{6\\times 5}(R),$ the vector space of all $6\\times 5$ matrices over $R?$" :question/worked-solution "The standard basis of ${\\text{M}}_{n\\times m}(R)$ contains a total of $n\\cdot m$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{3\\times 2}(R)$ contains $3\\cdot 2=6$ elements, and is given by\n\n$$\n\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 1 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 0 \\\\ 1 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}.\n$$\n\nTherefore, for ${\\text{M}}_{6\\times 5}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{6\\times 5}(R))=6\\cdot 5=30.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.\n$$"}] [{:db/id #edb/ref 17592186562429 :knowledge-point/_questions [{:db/id #edb/ref 17592186152222 :knowledge-point/id #uuid "b61a755f-23e8-5039-b2f5-b5984fdb420c" :knowledge-point/title "Determining the Dimension of a Matrix Vector Space Given Its Standard Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07714214-c4d9-5b08-a2c8-6c1f7e8ec203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186561605} {:answer/id #uuid "1eea31bf-e3b1-5614-bfbd-d7f54109fa12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186561665} {:answer/id #uuid "8dc27688-e270-59b6-bbc0-9254bca9da7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186561937} {:answer/id #uuid "b7e18e7f-729e-5ce5-b8db-386712a47470" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186562044} {:answer/id #uuid "eccebf2d-98a8-5ea0-a876-f56acb406b2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186562175}] :answer-field/correct {:answer/id #uuid "eccebf2d-98a8-5ea0-a876-f56acb406b2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186562175} :answer-field/id #uuid "fd01ea1f-a466-5fd9-8311-a2132252bc1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562382}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43503f70-a039-563c-bedc-d1b2782aedca" :question/math-academy-id "q-106884" :question/problem "What is the dimension of ${\\text{M}}_{4\\times 9}(R),$ the vector space of all $4\\times 9$ matrices over $R?$" :question/worked-solution "The standard basis of ${\\text{M}}_{n\\times m}(R)$ contains a total of $n\\cdot m$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{3\\times 2}(R)$ contains $3\\cdot 2=6$ elements, and is given by\n\n$$\n\\{[\\begin{aligned}1 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 1 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 1 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 0 \\\\ 1 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 0 \\\\ 0 & 1\\end{aligned}]\\}.\n$$\n\nTherefore, for ${\\text{M}}_{4\\times 9}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{4\\times 9}(R))=4\\cdot 9=36.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.\n$$"}] [{:db/id #edb/ref 17592186484271 :knowledge-point/_questions [{:db/id #edb/ref 17592186152220 :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "009a8a79-709d-5587-ad2d-d2fc9b774237" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186483570} {:answer/id #uuid "01f93fad-b91d-5d83-8760-997fde54eb2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II  and III only" :db/id #edb/ref 17592186483572} {:answer/id #uuid "3afef46f-fb68-5e1e-b10a-4ddb1eb3b89e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186483677} {:answer/id #uuid "56ca0553-38e4-50b8-9a28-89a7241ec7f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186483724} {:answer/id #uuid "973cca31-9547-529d-9e9d-26a46076e6cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186483876}] :answer-field/correct {:answer/id #uuid "01f93fad-b91d-5d83-8760-997fde54eb2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II  and III only" :db/id #edb/ref 17592186483572} :answer-field/id #uuid "6cc0ee2b-b921-5134-908e-7834e4e7600e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484133}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c2dac37f-1586-5572-8aef-afd7b8fea459" :question/math-academy-id "q-106898" :question/problem "Which of the following vector spaces has a dimension of $15?$\n\nI. ${R}^{14}$\n\nII. ${\\text{M}}_{3\\times 5}(R),$ the vector space of all $3\\times 5$ matrices over $R$\n\nIII. ${R}_{14}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $14$" :question/worked-solution "Let's examine each of the vector spaces in turn.\n\nI. Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n  $$\n  \\text{dim}({R}^{14})=14\\ne 15.\\,\\times \n  $$\n\nII. Recall that $\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.$ Therefore, \n\n  $$\n  \\text{dim}({\\text{M}}_{3\\times 5}(R))=3\\cdot 5=15.\\,✓\n  $$\n\nIII. Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n  $$\n  \\text{dim}({R}_{14}[t])=14+1=15.\\,✓\n  $$\n\nHence, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186243976 :knowledge-point/_questions [{:db/id #edb/ref 17592186152220 :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8961339-1a5c-5154-b431-7f4c1915d7a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461473} {:answer/id #uuid "70ebb621-c996-5bb4-bb6f-d250e25c7d85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 