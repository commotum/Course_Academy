#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186153161} :activity/id #uuid "656cb00f-9a01-5d98-b674-14d57dda7e9a" :activity/scope {:db/id #edb/ref 17592186049808 :topic/id #uuid "15638861-fef2-549b-9318-e9b1cdad2ec4" :topic/math-academy-id 2759} :activity/steps [{:db/id #edb/ref 17592186153161 :step/content {:db/id #edb/ref 17592186153408 :tutorial/content "The standard basis of the vector space $\\mathbb{R}_2[t]$ of all polynomials in the variable $t$ over $\\mathbb{R}$ with degree at most $2$ is \n\n$$\n\\{1, \\: t, \\: t^2\\}.\n$$\n\nAnother basis of $\\mathbb{R}_2[t]$ is\n\n$$\n\\big\\{ t^2-1, \\: t+3, \\: 2t-1 \\big\\}.\n$$\n\nIn general, vector spaces have infinitely many bases. \n\nLet's now consider the following theorem:\n\n*If a basis of a vector space $V$ has $n$ elements, then every basis of $V$ has $n$ elements.*\n\nThe number $n$ is called the **dimension** of the vector space, and we write $\\textrm{dim}(V)=n.$\n\nSo, since the standard basis of $\\mathbb{R}_2[t]$ has $3$ elements, all of its bases have $3$ elements, and we write\n\n$$\n\\textrm{dim}(\\mathbb{R}_2[t])=3.\n$$" :tutorial/id #uuid "91a87b01-a3a9-5fd9-865d-2e7fa9fb4636" :tutorial/math-academy-id 4971 :tutorial/title "Introduction"} :step/id #uuid "1c281721-48ee-5e84-901c-07d72bf77044" :step/math-academy-id 653421 :step/next {:db/id #edb/ref 17592186153162}} {:db/id #edb/ref 17592186153162 :step/content {:db/id #edb/ref 17592186152219 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152029 :question/id #uuid "2bcc7bb9-1b5e-5858-811d-1e5c14f0bc29" :question/math-academy-id "e-8288"} :knowledge-point/id #uuid "2a8bf202-99c5-5bfd-8df3-5bd27cd65640" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048218} {:db/id #edb/ref 17592186048552}] :knowledge-point/questions [{:db/id #edb/ref 17592186152584} {:db/id #edb/ref 17592186152875} {:db/id #edb/ref 17592186243970} {:db/id #edb/ref 17592186243971} {:db/id #edb/ref 17592186397856} {:db/id #edb/ref 17592186397863} {:db/id #edb/ref 17592186484197} {:db/id #edb/ref 17592186484206} {:db/id #edb/ref 17592186484214} {:db/id #edb/ref 17592186484265}] :knowledge-point/title "Determining the Dimension of a Polynomial Vector Space Given Its Standard Monomial Basis"} :step/id #uuid "977a3893-c3c0-5448-ab25-3271a4a3a0ff" :step/math-academy-id 653422 :step/next {:db/id #edb/ref 17592186153166}} {:db/id #edb/ref 17592186153163 :step/content {:db/id #edb/ref 17592186152220 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152030 :question/id #uuid "e1ae146f-04ae-5662-9ea3-178a23b3c366" :question/math-academy-id "e-8289"} :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/questions [{:db/id #edb/ref 17592186152586} {:db/id #edb/ref 17592186152587} {:db/id #edb/ref 17592186243975} {:db/id #edb/ref 17592186243976} {:db/id #edb/ref 17592186243977} {:db/id #edb/ref 17592186360587} {:db/id #edb/ref 17592186360588} {:db/id #edb/ref 17592186364723} {:db/id #edb/ref 17592186484271} {:db/id #edb/ref 17592186484288} {:db/id #edb/ref 17592186484294} {:db/id #edb/ref 17592186495073} {:db/id #edb/ref 17592186495107}] :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces"} :step/id #uuid "32c06dcf-98e2-59eb-83b8-eaa3a8573b55" :step/math-academy-id 653428 :step/next {:db/id #edb/ref 17592186153164}} {:db/id #edb/ref 17592186153164 :step/content {:db/id #edb/ref 17592186153409 :tutorial/content "When a vector space $V$ has a finite dimension $\\textrm{dim}(V) = n < \\infty,$ the vector space is **finite-dimensional**.\n\nSome vector spaces can have arbitrarily large linearly independent sets. In such cases, the vector space is **infinite-dimensional**.\n\nAn example of an infinite-dimensional vector space is the space of all continuous functions $C(\\mathbb{R})$ defined on $f : \\mathbb{R} \\to \\mathbb{R}.$\n\nTo understand why $C(\\mathbb{R})$ is an infinite-dimensional vector space, we note that for any positive integer $n,$ the following set of continuous functions is linearly independent:\n\n$$\n\\big\\{ 1, \\: t, \\: t^2, \\: \\ldots, t^n \\big\\}\n$$\n\nIndeed, we have that\n\n$$\n\\sum\\limits_{i=0}^n x_i t^i = 0\n$$\n\nfor all $t\\in\\mathbb{R}$ if and only if $x_i=0$ for all $i=0,1,2,\\ldots,n.$ Since $n$ can be arbitrarily large, our vector space cannot have finite dimension." :tutorial/id #uuid "cdc61d9a-3a5b-5d82-b2f8-17ebc848ac95" :tutorial/math-academy-id 4972 :tutorial/title "Infinite-Dimensional Vector Spaces"} :step/id #uuid "17e7956b-85c4-535f-b3e9-ef87f6a27c75" :step/math-academy-id 653431 :step/next {:db/id #edb/ref 17592186153165}} {:db/id #edb/ref 17592186153165 :step/content {:db/id #edb/ref 17592186152221 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152031 :question/id #uuid "6d2ba662-f58e-56ec-bf87-c1f26c12c1c1" :question/math-academy-id "e-8290"} :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/questions [{:db/id #edb/ref 17592186152873} {:db/id #edb/ref 17592186152876} {:db/id #edb/ref 17592186243979} {:db/id #edb/ref 17592186360589} {:db/id #edb/ref 17592186360590} {:db/id #edb/ref 17592186360591} {:db/id #edb/ref 17592186360600} {:db/id #edb/ref 17592186364730} {:db/id #edb/ref 17592186366608} {:db/id #edb/ref 17592186484202} {:db/id #edb/ref 17592186484260} {:db/id #edb/ref 17592186484277} {:db/id #edb/ref 17592186495165}] :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces"} :step/id #uuid "7a4fa43c-f576-546c-b417-c6b36b6e838e" :step/math-academy-id 653432} {:db/id #edb/ref 17592186153166 :step/content {:db/id #edb/ref 17592186152222 :knowledge-point/canonical-example {:db/id #edb/ref 17592186152032 :question/id #uuid "61fa85c6-5b27-5f81-a7ba-363eb68e8d3e" :question/math-academy-id "e-8315"} :knowledge-point/id #uuid "b61a755f-23e8-5039-b2f5-b5984fdb420c" :knowledge-point/questions [{:db/id #edb/ref 17592186152585} {:db/id #edb/ref 17592186152874} {:db/id #edb/ref 17592186360584} {:db/id #edb/ref 17592186360585} {:db/id #edb/ref 17592186360586} {:db/id #edb/ref 17592186397870} {:db/id #edb/ref 17592186397877} {:db/id #edb/ref 17592186399282} {:db/id #edb/ref 17592186484212} {:db/id #edb/ref 17592186484285} {:db/id #edb/ref 17592186495081}] :knowledge-point/title "Determining the Dimension of a Matrix Vector Space Given Its Standard Basis"} :step/id #uuid "cb8f5e62-9e00-5ea4-b454-29f57b6bd487" :step/math-academy-id 653425 :step/next {:db/id #edb/ref 17592186153163}}] :activity/title "Dimension in Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186152367}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186495236} :activity/id #uuid "8fd7c257-aa59-5f20-b67e-9f32e957099a" :activity/scope {:db/id #edb/ref 17592186049808 :topic/id #uuid "15638861-fef2-549b-9318-e9b1cdad2ec4" :topic/math-academy-id 2759} :activity/steps [{:db/id #edb/ref 17592186495209 :step/content {:db/id #edb/ref 17592186495107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d9255a3-f808-53ab-9a1d-bce0b2aee8d7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186494406} {:answer/id #uuid "4ad4f74f-98bf-5d22-9457-443e51eb0e44" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186494468} {:answer/id #uuid "a6d9093c-41de-586e-8b9a-a4e06e3dceda" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186494702} {:answer/id #uuid "b2867c1c-1f11-5f60-8eeb-04a47f542fab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186494734} {:answer/id #uuid "c9096bb1-9011-5dc6-aea5-546459a5a73c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186494790}] :answer-field/correct {:db/id #edb/ref 17592186494734} :answer-field/id #uuid "7b5c8af9-d959-569a-8058-100af23b2c12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494973}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "872bbc86-b2d9-5fc0-a340-666aa227cedf" :question/math-academy-id "q-95225" :question/problem "Which of the following vector spaces has a dimension of $12?$\n\nI. ${R}^{12}$\n\nII. ${\\text{M}}_{3\\times 4}(R),$ the vector space of all $3\\times 4$ matrices over $R$\n\nIII. ${R}_{11}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $11$" :question/worked-solution "Let's examine each of the vector spaces in turn.\n\nI. Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n  $$\n  \\text{dim}({R}^{12})=12.\\,✓\n  $$\n\nII. Recall that $\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.$ Therefore, \n\n  $$\n  \\text{dim}({\\text{M}}_{3\\times 4}(R))=3\\cdot 4=12.\\,✓\n  $$\n\nIII. Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n  $$\n  \\text{dim}({R}_{11}[t])=11+1=12.\\,✓\n  $$\n\nHence, the correct answer is \"I, II, and III.\""} :step/id #uuid "6ac3edfc-26f8-589b-8f2c-b805c5ecd692" :step/next {:db/id #edb/ref 17592186495231}} {:db/id #edb/ref 17592186495217 :step/content {:db/id #edb/ref 17592186495165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08461b80-8ee5-589b-a179-259194936ce8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186494340} {:answer/id #uuid "5af31435-c11c-5c3f-b06e-2a10c6c1c500" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186494502} {:answer/id #uuid "771ae68d-4a83-5f4f-9dcc-443975716b04" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186494573} {:answer/id #uuid "b2a39110-5421-5df4-bfb4-13a5169af020" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186494735} {:answer/id #uuid "c31ee08d-68d0-5e26-b97b-8161c20fe5c3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186494777}] :answer-field/correct {:db/id #edb/ref 17592186494340} :answer-field/id #uuid "01e9553e-a36d-5ce4-9531-7c5e67d94d60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494918}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f0776bb6-a5c9-57f2-a5dc-9cd00549186b" :question/math-academy-id "q-95233" :question/problem "Which of the following vector spaces are finite-dimensional?\n\nI. ${R}^{750}$\n\nII. ${R}^{\\infty },$ the vector space of infinite real sequences\n\nIII. ${\\text{M}}_{50}(R),$ the vector space of all $50\\times 50$ matrices over $R$" :question/worked-solution "Let's examine our vector spaces.\n\n- ${R}^{\\infty }$ is *not* finite-dimensional. To understand why, we first note that the following set of sequences is linearly independent:\n\n$$\n\\{{e}_{1},\\,{e}_{2},\\,…,{e}_{n}\\},\\,n\\in N\n$$\n\nwhere, for each $j\\in \\{1,2,…,n\\},$\n\n$$\n{e}_{j}=(0,…,0,\\,\\,\\,\\,\\,\\,\\,\\,\\,{1,}_{{↑}_{{j}^{\\text{th}}\\text{ position}}}\\,\\,\\,\\,\\,\\,\\,\\,0,…).\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{x}_{i}{e}_{i}=0\n$$\n\nif and only if ${x}_{i}=0$ for all $i=0,1,2,…,n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of ${R}^{\\infty }$ of size $n,$ which imples that  ${R}^{\\infty }$ cannot have finite dimension.\n\n- ${R}^{750}$ and ${\\text{M}}_{50}(R)$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({R}^{750})=750,\n$$\n\nand\n\n$$\n\\text{dim}({\\text{M}}_{50}(R))={50}^{2}=2\\,500\n$$\n\n \nare both finite numbers.\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "7b787e2b-3bc8-5c8f-b9c3-b74f50bd3683" :step/next {:db/id #edb/ref 17592186495223}} {:db/id #edb/ref 17592186495223 :step/content {:db/id #edb/ref 17592186495081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bd1a089-11bd-5537-b24d-b5320d066943" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "21" :db/id #edb/ref 17592186494404} {:answer/id #uuid "7b41ed65-ebd8-5e8a-9322-4359d606455b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186494583} {:answer/id #uuid "98625c99-1d21-5d81-8b45-7668916611fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30" :db/id #edb/ref 17592186494665} {:answer/id #uuid "c68081df-1e95-51e2-8875-d1f0093b0cbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10" :db/id #edb/ref 17592186494784} {:answer/id #uuid "ca864cf8-1d57-54a6-bac6-6cdaa11ca7a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186494796}] :answer-field/correct {:db/id #edb/ref 17592186494665} :answer-field/id #uuid "b725a1ed-492c-532e-82ae-acdc74378877" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186495005}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4868b354-15b9-5c4c-bfd0-122202f40c50" :question/math-academy-id "q-106882" :question/problem "What is the dimension of ${\\text{M}}_{6\\times 5}(R),$ the vector space of all $6\\times 5$ matrices over $R?$" :question/worked-solution "The standard basis of ${\\text{M}}_{n\\times m}(R)$ contains a total of $n\\cdot m$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{3\\times 2}(R)$ contains $3\\cdot 2=6$ elements, and is given by\n\n$$\n\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 1 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 0 \\\\ 1 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}.\n$$\n\nTherefore, for ${\\text{M}}_{6\\times 5}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{6\\times 5}(R))=6\\cdot 5=30.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.\n$$"} :step/id #uuid "8c095d32-ef2b-570d-930d-b9c7020f763d"} {:db/id #edb/ref 17592186495231 :step/content {:db/id #edb/ref 17592186495073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32aca3cf-a5e2-53e0-9465-8c5812ddcb24" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186494418} {:answer/id #uuid "500ce576-4c92-5f17-8883-d14fb5dd6073" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186494479} {:answer/id #uuid "9317dd78-6bb1-51d8-9527-c7283331155e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186494653} {:answer/id #uuid "cab46aea-83c2-537f-b7c2-3ead6ff50e30" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186494797} {:answer/id #uuid "ce013736-d830-5648-bf13-13959d355826" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186494808}] :answer-field/correct {:db/id #edb/ref 17592186494418} :answer-field/id #uuid "ae053587-50f1-5f8c-b674-29dc44c5f648" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186494998}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "300def0f-69c7-5821-80a9-ead2c4071d95" :question/math-academy-id "q-95228" :question/problem "Which of the following vector spaces has a dimension of $18?$\n\nI. ${R}_{17}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $17$\n\nII. ${\\text{M}}_{6\\times 3}(R),$ the vector space of all $6\\times 3$ matrices over $R$\n\nIII. ${R}^{17}$" :question/worked-solution "Let's examine each of the vector spaces in turn.\n\nI. Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n  $$\n  \\text{dim}({R}_{17}[t])=17+1=18.\\,✓\n  $$\n\nII. Recall that $\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.$ Therefore, \n\n  $$\n  \\text{dim}({\\text{M}}_{6\\times 3}(R))=6\\cdot 3=18.\\,✓\n  $$\n\nIII. Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n  $$\n  \\text{dim}({R}^{17})=17\\ne 18.\\,\\times \n  $$\n\nHence, the correct answer is \"I and II only.\""} :step/id #uuid "9ee124b4-4e89-5c70-ae8c-f8a1677ea468" :step/next {:db/id #edb/ref 17592186495217}} {:db/id #edb/ref 17592186495236 :step/content {:db/id #edb/ref 17592186360586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21209143-d6f3-527a-95fc-698f6fe33a0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186358043} {:answer/id #uuid "5bddb206-b7cb-5ec9-a288-f2949be70a2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186358550} {:answer/id #uuid "8a3475b2-1900-543b-9144-6a374fa7f5a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20" :db/id #edb/ref 17592186358956} {:answer/id #uuid "b011e497-97d8-5a66-bc41-ff74a3cf84e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186359280} {:answer/id #uuid "d0d5201c-0d42-5c30-b6c4-c732698b84a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186359580}] :answer-field/correct {:db/id #edb/ref 17592186359280} :answer-field/id #uuid "c2fb2713-16be-554b-924a-e6711ddefc4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360329}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aa93d1d7-d70a-58d2-9a8d-2974756902aa" :question/math-academy-id "q-95221" :question/problem "What is the dimension of ${\\text{M}}_{4}(R),$ the vector space of all $4\\times 4$ matrices over $R?$" :question/worked-solution "The standard basis of ${\\text{M}}_{n}(R)$ contains a total of ${n}^{2}$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{2}(R)$ contains ${2}^{2}=4$ elements, and is given by\n\n$$\n\\{\\begin{bmatrix}1 & 0 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 1 \\\\ 0 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 1 & 0\\end{bmatrix},\\,\\begin{bmatrix}0 & 0 \\\\ 0 & 1\\end{bmatrix}\\}.\n$$\n\nTherefore, for ${\\text{M}}_{4}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{4}(R))={4}^{2}=16.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n}(R))={n}^{2}.\n$$"} :step/id #uuid "a70eb95a-1d4a-5112-b093-41836097c112" :step/next {:db/id #edb/ref 17592186495209}}] :activity/title "Dimension in Abstract Vector Spaces" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186494309}]}
