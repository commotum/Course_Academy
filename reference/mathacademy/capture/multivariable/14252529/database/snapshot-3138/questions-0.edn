#{[{:db/id #edb/ref 17592186198167 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198306 :knowledge-point/id #uuid "64180fa2-2268-5954-aadb-2982a2d7a224" :knowledge-point/title "Finding the Maximum and Minimum of a Set"}] :question/id #uuid "b817524b-bf24-5f11-a0c8-d544f026b0b8" :question/math-academy-id "e-13188" :question/problem "What are the minimum and maximum of the set $A = \\left[0,3\\right]?$" :question/worked-solution "Recall that \n\n- $x_{\\max}$ is the maximum of a set $S$ if $x_{\\max} \\in S$ and $x \\leq x_{\\max}$ for all $x \\in S,$ and\n\n- $x_{\\min}$ is the minimum of a set $S$ if $x_{\\min} \\in S$ and $x_{\\min} \\leq x$ for all $x \\in S.$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}min(A) & =min[0,3]=0 \\\\ max(A) & =max[0,3]=3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186198168 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198308 :knowledge-point/id #uuid "f8ed1932-b363-5a07-a816-93f3078cb801" :knowledge-point/title "Maximums and Minimums in More Complex Settings"}] :question/id #uuid "cf3362e1-4d5b-5cb4-bcef-523f9927044b" :question/math-academy-id "e-13189" :question/problem "What are the maximum and minimum values of the set $A = \\{ n \\in \\mathbb{Z} \\mid \\: 3 \\lt n \\leq 8 \\}?$" :question/worked-solution "Recall that \n\n- $x_{\\max}$ is the maximum of a set $S$ if $x_{\\max} \\in S$ and $x \\leq x_{\\max}$ for all $x \\in S,$ and\n\n- $x_{\\min}$ is the minimum of a set $S$ if $x_{\\min} \\in S$ and $x_{\\min} \\leq x$ for all $x \\in S.$\n\nNotice that the elements of the set can be listed as \n\n$$\nA = \\{ 4, \\: 5, \\: 6, \\: 7, 8\\}.\n$$\n\nTherefore, the minimum of the set equals $4,$ while the maximum of the set equals $8.$"}] [{:db/id #edb/ref 17592186198170 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198307 :knowledge-point/id #uuid "8f45befc-412b-58aa-8901-d10e63858b52" :knowledge-point/title "Explaining the Existence of a Maximum or Minimum"}] :question/id #uuid "2bf6f02e-e7af-5b94-880d-6f1760a666ec" :question/math-academy-id "e-13194" :question/problem "Given the set $S = (-\\infty,7],$ explain why $\\max(S) = 7.$" :question/worked-solution "Recall that $x_{\\max}$ is the maximum of a set $S$ if \n\n- $x_{\\max} \\in S,$ and\n\n- $x\\leq x_{\\max}$ for all $x \\in S.$\n\nIn our case, we have that $7$ is the maximum of the set $S$ because\n\n- $7 \\in S,$ and\n\n- $x \\leq 7$ for all $x \\in S.$"}] [{:db/id #edb/ref 17592186198795 :knowledge-point/_questions [{:db/id #edb/ref 17592186198306 :knowledge-point/id #uuid "64180fa2-2268-5954-aadb-2982a2d7a224" :knowledge-point/title "Finding the Maximum and Minimum of a Set"}] :question/answer-fields [{:answer-field/id #uuid "baa14cce-b7cb-5a32-ab6e-5df43e5f5784" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186195511} {:answer-field/id #uuid "291d10b5-8aa9-56be-9ba4-9b5151da6e9e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186195512}] :question/id #uuid "a8a5d360-a9c2-56aa-83b8-ef7ddfdb7058" :question/math-academy-id "q-181716" :question/problem "What are the minimum and maximum of the set $A = {1, π, 3,-2}$?$min(A) =$\n{{field-1}}\n$max(A) =$\n{{field-2}}"}] [{:db/id #edb/ref 17592186198796 :knowledge-point/_questions [{:db/id #edb/ref 17592186198306 :knowledge-point/id #uuid "64180fa2-2268-5954-aadb-2982a2d7a224" :knowledge-point/title "Finding the Maximum and Minimum of a Set"}] :question/answer-fields [{:answer-field/id #uuid "9944a089-a76b-5528-a82d-ebb0e9d2c79b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186195513} {:answer-field/id #uuid "c5eb9d0b-6737-5807-a155-db93244a4bef" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/