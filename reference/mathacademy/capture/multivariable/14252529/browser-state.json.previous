><mtd><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">max</mo><mo stretchy=\"false\">(</mo><mi>B</mi><mo stretchy=\"false\">)</mo></mtd><mtd><mi></mi><mo>=</mo><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">max</mo><mo fence=\"false\" stretchy=\"false\">{</mo><mn>9</mn><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>3</mn><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>0</mn><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>7</mn><mo fence=\"false\" stretchy=\"false\">}</mo><mo>=</mo><mstyle style=\"border: 1px solid lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mn>9</mn></mpadded></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
