</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mo stretchy=\"false\">(</mo><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn><msup><mo stretchy=\"false\">)</mo><mo>+</mo></msup></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mtext>d</mtext><mi>y</mi></mrow><mrow><mtext>d</mtext><mi>x</mi></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>θ</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mo stretchy=\"false\">(</mo><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn><msup><mo stretchy=\"false\">)</mo><mo>+</mo></msup></mrow></munder><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mi>θ</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mn>3</mn><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mi>θ</mi><mo stretchy=\"false\">)</mo></mrow><mrow><mo>−</mo><mn>4</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mi>θ</mi><mo stretchy=\"false\">)</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mi>θ</mi><mo stretchy=\"false\">)</mo></mrow></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mo>−</mo><mn>3</mn></mrow><msup><mn>0</mn><mrow data-mjx-texclass=\"ORD\"><mo>+</mo></mrow></msup></mfrac></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mi mathvariant=\"normal\">∞</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</li>\n</ul>\n<ul>\n<li>Statement III is true. Using the calculations from part II, and the first hint, we have\n<mjx-container clas