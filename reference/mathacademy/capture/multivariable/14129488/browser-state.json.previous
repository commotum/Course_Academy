      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129488/observations/step-q77145-58b27f21d94c0c624ca4.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129488/observations/step-q77145-58b27f21d94c0c624ca4.png",
      "source_url": "https://mathacademy.com/tasks/14129488/topics/3704/review",
      "captured_at": 1791771282.9833748,
      "math_academy_id": "q-77145",
