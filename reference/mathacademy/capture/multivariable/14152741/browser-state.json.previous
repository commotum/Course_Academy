      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14152741/observations/step-q126677-bbfbd108ea05b86d8282.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14152741/observations/step-q126677-bbfbd108ea05b86d8282.png",
      "source_url": "https://mathacademy.com/tasks/14152741/topics/3627/review",
