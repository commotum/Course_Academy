      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14152741/observations/step-q126532-f258551987127c49bf1d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14152741/observations/step-q126532-f258551987127c49bf1d.png",
      "source_url": "https://mathacademy.com/tasks/14152741/topics/3627/review",
      "captured_at": 1791849069.6022885,
      "math_academy_id": "q-126532",
