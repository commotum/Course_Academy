#{[17592186045463 #edb/ref 10 :activity.type/lesson #edb/ref 17592186045416] [17592186045464 #edb/ref 10 :activity.type/review #edb/ref 17592186045416] [17592186045485 #edb/ref 10 :question.difficulty/easy #edb/ref 17592186045416] [17592186045486 #edb/ref 10 :question.difficulty/hard #edb/ref 17592186045416] [17592186045487 #edb/ref 10 :question.difficulty/moderate #edb/ref 17592186045416] [17592186045492 #edb/ref 10 :answer-field.type/blank #edb/ref 17592186045416] [17592186045493 #edb/ref 10 :answer-field.type/radio #edb/ref 17592186045416] [17592186045498 #edb/ref 10 :answer.type/math #edb/ref 17592186045416] [17592186046644 #edb/ref 1003 #edb/ref 17592186046645 #edb/ref 17592186045417] [17592186046644 #edb/ref 1003 #edb/ref 17592186046669 #edb/ref 17592186045417] [17592186046644 #edb/ref 1003 #edb/ref 17592186046673 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045606 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045607 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045608 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045609 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045610 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045611 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045612 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045613 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045614 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045615 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045616 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045617 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045618 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/ref 17592186045619 #edb/ref 17592186045417] [17592186046644 #edb/ref 1004 #edb/re