#{[{:activity/expected-seconds 1320.0 :activity/first-step {:db/id #edb/ref 17592186093159} :activity/id #uuid "a4a9429f-a3d9-515f-9589-b6a42b363bed" :activity/scope {:db/id #edb/ref 17592186050797 :topic/id #uuid "67a4c8b0-845c-55dc-ad90-cd6044fd5591" :topic/math-academy-id 969} :activity/steps [{:db/id #edb/ref 17592186093153 :step/content {:db/id #edb/ref 17592186092289 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092136 :question/id #uuid "6fc6a60d-11e9-56c1-9328-0179059d4c56" :question/math-academy-id "e-8389"} :knowledge-point/id #uuid "7d3383cb-2322-5ed0-bd5b-631596d72af9" :knowledge-point/questions [{:db/id #edb/ref 17592186092924} {:db/id #edb/ref 17592186092928} {:db/id #edb/ref 17592186505735} {:db/id #edb/ref 17592186505738} {:db/id #edb/ref 17592186505790} {:db/id #edb/ref 17592186505792} {:db/id #edb/ref 17592186505845}] :knowledge-point/title "Applying the Definition of Inverse Hyperbolic Sine"} :step/id #uuid "44a89e4d-3f22-5cc4-9a84-768d256c3961" :step/math-academy-id 31243 :step/next {:db/id #edb/ref 17592186093154}} {:db/id #edb/ref 17592186093154 :step/content {:db/id #edb/ref 17592186092290 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092137 :question/id #uuid "a8951542-ff6f-5b96-a287-b4c7f928b572" :question/math-academy-id "e-8390"} :knowledge-point/id #uuid "69ebb184-52aa-5fde-8956-50b69fde3561" :knowledge-point/questions [{:db/id #edb/ref 17592186092925} {:db/id #edb/ref 17592186092927} {:db/id #edb/ref 17592186505734} {:db/id #edb/ref 17592186505760} {:db/id #edb/ref 17592186505784} {:db/id #edb/ref 17592186505786} {:db/id #edb/ref 17592186505793} {:db/id #edb/ref 17592186520502} {:db/id #edb/ref 17592186520508}] :knowledge-point/title "Applying the Definition of Inverse Hyperbolic Cosine"} :step/id #uuid "9c37bc5f-181a-519b-99c1-ff45fd6ec950" :step/math-academy-id 31244 :step/next {:db/id #edb/ref 17592186093155}} {:db/id #edb/ref 17592186093155 :step/content {:db/id #edb/ref 17592186092291 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092138 :question/id #uuid "13299051-2164-5d54-b90e-52c7a8f1d7f2" :question/math-academy-id "e-8391"} :knowledge-point/id #uuid "d68a11bd-7a2d-5f1f-8be7-c8904fdfb3e7" :knowledge-point/questions [{:db/id #edb/ref 17592186092926} {:db/id #edb/ref 17592186092929} {:db/id #edb/ref 17592186505772} {:db/id #edb/ref 17592186505778} {:db/id #edb/ref 17592186505789} {:db/id #edb/ref 17592186505806} {:db/id #edb/ref 17592186505812} {:db/id #edb/ref 17592186520483} {:db/id #edb/ref 17592186520485}] :knowledge-point/title "Applying the Definition of Inverse Hyperbolic Tangent"} :step/id #uuid "8ad7b4f1-5165-5f3a-b42e-2ad2eda221fc" :step/math-academy-id 31245 :step/next {:db/id #edb/ref 17592186093160}} {:db/id #edb/ref 17592186093158 :step/content {:db/id #edb/ref 17592186092293 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092140 :question/id #uuid "4fbdc166-4225-5fa5-aaa2-0f09073e8e2e" :question/math-academy-id "e-8768"} :knowledge-point/id #uuid "50501d8e-9c4c-5650-a50f-5d847d29435a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050125}] :knowledge-point/questions [{:db/id #edb/ref 17592186092930} {:db/id #edb/ref 17592186092931} {:db/id #edb/ref 17592186505745} {:db/id #edb/ref 17592186505748} {:db/id #edb/ref 17592186505763} {:db/id #edb/ref 17592186505814} {:db/id #edb/ref 17592186505825} {:db/id #edb/ref 17592186520475}] :knowledge-point/title "Calculating an Inverse Hyperbolic Function From First-Principles"} :step/id #uuid "0ad68353-836a-50b6-ac4a-7e9b88a98c32" :step/math-academy-id 32687} {:db/id #edb/ref 17592186093159 :step/content {:db/id #edb/ref 17592186093454 :tutorial/content "The hyperbolic functions have inverse functions that are easy to define. The **inverse hyperbolic functions** are the following:\n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n- The **inverse hyperbolic sine**, defined as\n\n$$\n\\sinh^{-1}{x} = \\arsinh{x} = \\ln\\big(x+\\sqrt{x^2+1}\\big), \\qquad x \\in (-\\infty, \\infty).\n$$\n\nThe graph of the inverse hyperbolic sine function is given below.\n\n![](images/1f/1f07f38b11cf297e099341df2ab062d4691c4502098c060de565b70f1ea7e360.png)\n\n- The **inverse hyperbolic cosine**, defined as\n\n$$\n\\cosh^{-1}{x} = \\arcosh{x} = \\ln\\big(x+\\sqrt{x^2-1}\\big), \\qquad x \\in [1, \\infty).\n$$\n\nThe graph of the inverse hyperbolic cosine function is given below.\n\n![](images/60/60607a764c50807dcb0f4f05328d900c626079654995cffbaa84fa2214788835.png)\n\n- The **inverse hyperbolic tangent**, defined as\n\n$$\n\\tanh^{-1}{x} = \\artanh{x} = \\dfrac12\\ln\\left(\\dfrac{1+x}{1-x}\\right), \\qquad x \\in (-1, 1).\n$$\n\nThe graph of the inverse hyperbolic tangent function is given below.\n\n![](images/96/96b4f7aa06ee165751dcaa2101e9dea104d95d5bebdaea7bc4f317d9160b5a7a.png)\n\nFor example, to calculate $\\arcosh(\\sqrt2)$ we substitute $x$ for $\\sqrt2$ in the formula for $\\arcosh$ and get\n\n$$\n\\begin{aligned}\\operatorname{arcosh}⁡(\\sqrt{2}) & =\\operatorname{ln}⁡(\\sqrt{2}+\\sqrt{{(\\sqrt{2})}^{2}-1}) \\\\  & =\\operatorname{ln}⁡(\\sqrt{2}+\\sqrt{2-1}) \\\\  & =\\operatorname{ln}⁡(\\sqrt{2}+1).\\end{aligned}\n$$" :tutorial/id #uuid "afeb7395-4188-5e5e-8d91-200a65a1cbb9" :tutorial/math-academy-id 5206 :tutorial/title "Introduction"} :step/id #uuid "6f5b5a8c-0e08-5ad0-9503-4a131c8d5c2e" :step/math-academy-id 32690 :step/next {:db/id #edb/ref 17592186093153}} {:db/id #edb/ref 17592186093160 :step/content {:db/id #edb/ref 17592186093455 :tutorial/content "We can derive the formulas from inverse hyperbolic sine, cosine, and tangent from the definition of these base functions. \n\nFor example, let's show that\n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\cosh^{-1}{x} = \\arcosh{x} = \\ln\\big(x+\\sqrt{x^2-1}\\big), \\qquad x \\in [1, \\infty).\n$$\n\nRecall that\n\n$$\n\\cosh{x} = \\dfrac12 \\left( e^x + e^{-x} \\right).\n$$\n\nFirst, let $y = \\cosh{x}$ and $x \\geq 0.$ Then we have $y\\geq 1.$\n\nTo find the inverse function we swap $x$ and $y{:}$ \n\n$$\n\\begin{aligned}x & =\\operatorname{cosh}⁡y\\end{aligned}\n$$\n\nSo, now we have that $x \\geq 1$ and $y \\geq 0.$\n\nNext, we use the definition of $\\cosh x$ and bring everything to the left-hand side:\n\n$$\n\\begin{aligned}x & =\\frac{1}{2}({e}^{y}+{e}^{-y}) \\\\ 2x & ={e}^{y}+{e}^{-y} \\\\ 2x{e}^{y} & ={e}^{2y}+1 \\\\ {e}^{2y}-2x{e}^{y}+1 & =0 \\\\ {({e}^{y})}^{2}-2x({e}^{y})+1 & =0.\\end{aligned}\n$$\n\nLetting $Y = e^{y},$ we form a quadratic equation in $Y$ and solve it by completing the square:\n\n$$\n\\begin{aligned}{Y}^{2}-2xY+1 & =0 \\\\ (Y-x)^{2}-{x}^{2}+1 & =0 \\\\ (Y-x)^{2} & ={x}^{2}-1 \\\\ Y-x & =\\pm \\sqrt{{x}^{2}-1} \\\\ Y & =x\\pm \\sqrt{{x}^{2}-1} \\\\ {e}^{y} & =x\\pm \\sqrt{{x}^{2}-1} \\\\ y & =\\operatorname{ln}⁡(x\\pm \\sqrt{{x}^{2}-1})\\end{aligned}\n$$\n\nNote that for  $x\\ge 1,$ we have $x-\\sqrt{x^{2}-1}\\leq 1$ and  $x+\\sqrt{x^{2}-1}\\geq 1.$ Since $y \\ge 0,$ the logarithm in the above equality must be positive, so we reject the alternative with the negative sign. This gives\n\n$$\n\\begin{aligned}y & =\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1}).\\end{aligned}\n$$\n\nSo, we obtain our formula for $\\arcosh{:}$\n\n$$\nf^{-1}(x)=\n\\arcosh{x} = \\ln\\big(x+\\sqrt{x^2-1}\\big).\n$$" :tutorial/id #uuid "edf0d23e-aec4-5b77-befa-2433291ed5af" :tutorial/math-academy-id 5219 :tutorial/title "Deriving the Formulas for the Inverse Hyperbolic Functions"} :step/id #uuid "c7e64c95-cb61-5b1e-ac3c-639ae6f35144" :step/math-academy-id 32709 :step/next {:db/id #edb/ref 17592186093158}}] :activity/title "The Inverse Hyperbolic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092452}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186520604} :activity/id #uuid "5326f489-c4a2-5092-8c77-6ec4ee9bd4a1" :activity/scope {:db/id #edb/ref 17592186050797 :topic/id #uuid "67a4c8b0-845c-55dc-ad90-cd6044fd5591" :topic/math-academy-id 969} :activity/steps [{:db/id #edb/ref 17592186520560 :step/content {:db/id #edb/ref 17592186520475 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d9f22e8-2426-54ec-8e4d-ceebb5065f00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(x-1-\\sqrt{{x}^{2}-1})" :db/id #edb/ref 17592186520034} {:answer/id #uuid "46b674e3-477c-5d6b-8938-c0aa7e7328b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1})+1" :db/id #edb/ref 17592186520097} {:answer/id #uuid "5683b63e-518f-5920-9350-c68914ed0bc4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1})-1" :db/id #edb/ref 17592186520128} {:answer/id #uuid "6c6a5d1c-174d-5af0-a15b-bcbed198a09b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1})" :db/id #edb/ref 17592186520152} {:answer/id #uuid "f79ae12a-4fbf-5066-b81a-c94e70a59044" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(x-1+\\sqrt{{x}^{2}-1})" :db/id #edb/ref 17592186520353}] :answer-field/correct {:db/id #edb/ref 17592186520128} :answer-field/id #uuid "2a874508-e5a5-5caf-a21a-b4d69dce3efa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186520376}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7e900458-4a34-53b2-8b6d-fd38c3b57268" :question/math-academy-id "q-125986" :question/problem "Using the definition of the hyperbolic cosine, calculate ${f}^{-1}(x)$ given that $f(x)=\\operatorname{cosh}⁡(x+1)$ and $x\\ge -1.$" :question/worked-solution "Let $y=\\operatorname{cosh}⁡(x+1).$ Since $x\\ge -1,$ we have $y\\ge 1.$\n\nTo find the inverse function we swap $x$ and $y:$ \n\n$$\nx=\\operatorname{cosh}⁡(y+1),\n$$\n\nwhere $x\\ge 1$ and $y\\ge -1.$\n\nNext, we apply the definition of $\\operatorname{cosh}⁡x:$\n\n$$\n\\begin{aligned}x & =\\frac{1}{2}({e}^{y+1}+{e}^{-(y+1)}) \\\\ 2x & ={e}^{y+1}+{e}^{-(y+1)} \\\\ 2x{e}^{y+1} & ={e}^{2(y+1)}+1\\end{aligned}\n$$\n\nBringing everything to the left-hand side, we get\n\n$$\n\\begin{aligned}{e}^{2(y+1)}-2x{e}^{y+1}+1 & =0 \\\\ {({e}^{y+1})}^{2}-2x({e}^{y+1})+1 & =0.\\end{aligned}\n$$\n\nLet $Y={e}^{y+1}.$ We can form a quadratic equation in $Y$ and solve it by completing the square, as follows:\n\n$$\n\\begin{aligned}{Y}^{2}-2xY+1 & =0 \\\\ (Y-x)^{2}-{x}^{2}+1 & =0 \\\\ (Y-x)^{2} & ={x}^{2}-1 \\\\ Y-x & =\\pm \\sqrt{{x}^{2}-1} \\\\ Y & =x\\pm \\sqrt{{x}^{2}-1} \\\\ {e}^{y+1} & =x\\pm \\sqrt{{x}^{2}-1} \\\\ y+1 & =\\operatorname{ln}⁡(x\\pm \\sqrt{{x}^{2}-1})\\end{aligned}\n$$\n\nNote that for  $x\\ge 1,$ we have $x-\\sqrt{{x}^{2}-1}\\le 1$ and  $x+\\sqrt{{x}^{2}-1}\\ge 1.$ Since $y+1\\ge 0,$ the logarithm in the above equality must be non-negative. This requires its argument to be greater than or equal to $1$ for $x\\ge 1$, so we reject the alternative with the negative sign. This gives\n\n$$\n\\begin{aligned}y+1 & =\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1}) \\\\ y & =\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1})-1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{f}^{-1}(x)=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1})-1.\n$$"} :step/id #uuid "5ead7583-af5a-50aa-b7c8-b27d60003f5d" :step/next {:db/id #edb/ref 17592186520574}} {:db/id #edb/ref 17592186520573 :step/content {:db/id #edb/ref 17592186520485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cca56e0-bd46-5cdc-92e5-fbf4d373740e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(t+\\frac{1}{2})" :db/id #edb/ref 17592186520059} {:answer/id #uuid "4ac055dd-9f86-515e-b1ae-23330cb8d42f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(2t+1)" :db/id #edb/ref 17592186520104} {:answer/id #uuid "5f33329f-ed6e-55fc-8a52-3418bf264493" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(t+\\frac{1}{2})" :db/id #edb/ref 17592186520139} {:answer/id #uuid "728d87fa-4ae9-5abf-a254-4e2127b85d13" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(2t+2)" :db/id #edb/ref 17592186520156} {:answer/id #uuid "72957adc-bbda-5a70-8bcf-de083ff0510a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(2t+1)" :db/id #edb/ref 17592186520157}] :answer-field/correct {:db/id #edb/ref 17592186520157} :answer-field/id #uuid "08605099-e0ee-5781-8ffd-d1bea3536f65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186520370}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9750db93-431a-52f4-a35e-36e894133bed" :question/math-academy-id "q-125859" :question/problem "$$\n\nGiven that $t>-\\frac{1}{2},$ which of the following is equivalent to $\\operatorname{artanh}⁡(\\frac{t}{t+1})?$" :question/worked-solution "The definition of $\\operatorname{artanh}⁡x$ is \n\n$$\n\\operatorname{artanh}⁡x=\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1+x}{1-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{artanh}⁡(\\frac{t}{t+1}) & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1+\\frac{t}{t+1}}{1-\\frac{t}{t+1}}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{\\frac{t+1+t}{t+1}}{\\frac{t+1-t}{t+1}}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{\\frac{2t+1}{t+1}}{\\frac{1}{t+1}}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(2t+1).\\end{aligned}\n$$"} :step/id #uuid "75b8f4f6-638e-52c0-9e51-b84790620338" :step/next {:db/id #edb/ref 17592186520560}} {:db/id #edb/ref 17592186520574 :step/content {:db/id #edb/ref 17592186520502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fbe8f32-b269-5817-8957-1ff911e57228" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln(3+2\\sqrt{2})" :db/id #edb/ref 17592186520113}] :answer-field/correct {:db/id #edb/ref 17592186520113} :answer-field/id #uuid "f7cb44d4-8640-5f83-ba9b-96604fc838db" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186520442}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "da7e5a10-376b-5a22-a310-bd1bf7fa24cf" :question/math-academy-id "q-300604" :question/problem "$$\n\nEvaluate $\\operatorname{arcosh}⁡3.$ **Do not round** your answer.\n\n$\\operatorname{arcosh}⁡3=$\n{{field-1}}" :question/worked-solution "By definition,\n\n$$\n\\operatorname{arcosh}⁡x=ln\\,(x+\\sqrt{{x}^{2}-1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arcosh}⁡3 & =\\operatorname{ln}⁡(3+\\sqrt{{3}^{2}-1}) \\\\  & =\\operatorname{ln}⁡(3+\\sqrt{9-1}) \\\\  & =\\operatorname{ln}⁡(3+\\sqrt{8}).\\end{aligned}\n$$"} :step/id #uuid "796ec98d-fdc6-5152-8f17-0c07206d2a8e"} {:db/id #edb/ref 17592186520596 :step/content {:db/id #edb/ref 17592186520483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2645204e-4a2f-5bad-beb3-763d90807c2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186520046} {:answer/id #uuid "294f333b-a9d4-562a-8eae-492cfcc89909" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186520049} {:answer/id #uuid "536f3405-9be4-55d8-a59a-c53890d35b59" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{ln}⁡2" :db/id #edb/ref 17592186520118} {:answer/id #uuid "66bb441d-dd19-59af-b152-79149e4a3104" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡2" :db/id #edb/ref 17592186520146} {:answer/id #uuid "c82d5f0d-b3be-5af8-87e6-5da9ad05a797" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186520270}] :answer-field/correct {:db/id #edb/ref 17592186520049} :answer-field/id #uuid "c6245f27-68e2-534e-b326-9a13a0b95dff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186520423}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8ddac48b-cef1-5d70-9862-741511be4eb3" :question/math-academy-id "q-125855" :question/problem "$$\n\n$\\operatorname{artanh}⁡(-\\frac{15}{17})=$" :question/worked-solution "The definition of $\\operatorname{artanh}⁡x$ is \n\n$$\n\\operatorname{artanh}⁡x=\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1+x}{1-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{artanh}⁡(-\\frac{15}{17}) & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1+(-\\frac{15}{17})}{1-(-\\frac{15}{17})}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1-\\frac{15}{17}}{1+\\frac{15}{17}}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{\\frac{2}{15}}{\\frac{32}{15}}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1}{16}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡{2}^{-4} \\\\  & =-2\\operatorname{ln}⁡2.\\end{aligned}\n$$"} :step/id #uuid "a8b3c09c-22c0-55de-a5ad-4942d464fdf0" :step/next {:db/id #edb/ref 17592186520573}} {:db/id #edb/ref 17592186520604 :step/content {:db/id #edb/ref 17592186520508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "456e44ed-b28e-597a-8a94-9a42b91da0d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(\\sqrt{y}+\\sqrt{y-1})" :db/id #edb/ref 17592186520092} {:answer/id #uuid "4e657d76-cffa-595b-9bca-194435c0c985" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(\\sqrt{y+1}-\\sqrt{y})" :db/id #edb/ref 17592186520111} {:answer/id #uuid "786a2bb6-f534-5ec7-b7ad-24c1e39a3327" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(\\sqrt{y}-\\sqrt{y-1})" :db/id #edb/ref 17592186520166} {:answer/id #uuid "8086c909-031a-5d75-b37d-adde7d12e254" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(\\sqrt{y}+\\sqrt{y+1})" :db/id #edb/ref 17592186520177} {:answer/id #uuid "f593fa3e-303f-519f-8158-523c93d1ab3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(y-\\sqrt{y-1})" :db/id #edb/ref 17592186520350}] :answer-field/correct {:db/id #edb/ref 17592186520092} :answer-field/id #uuid "70bd243f-e07d-55ba-afe6-e9424079d1a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186520401}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e77b2e22-83c2-5884-b6a1-4a4bd43f7297" :question/math-academy-id "q-125854" :question/problem "$$\n\nGiven that $y\\ge 1,$ which of the following is equivalent to $\\operatorname{arcosh}⁡\\sqrt{y}?$" :question/worked-solution "The definition of $\\operatorname{arcosh}⁡x$ is \n\n$$\n\\operatorname{arcosh}⁡x=\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}-1}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arcosh}⁡\\sqrt{y} & =\\operatorname{ln}⁡(\\sqrt{y}+\\sqrt{{(\\sqrt{y})}^{2}-1}) \\\\  & =\\operatorname{ln}⁡(\\sqrt{y}+\\sqrt{y-1}).\\end{aligned}\n$$"} :step/id #uuid "ca8b15bf-37da-5a6c-b30c-f92d0c220666" :step/next {:db/id #edb/ref 17592186520596}}] :activity/title "The Inverse Hyperbolic Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186519989}]}
