#{[{:db/id #edb/ref 17592186166603 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166765 :knowledge-point/id #uuid "319572db-8eed-59f2-95c4-d21a63642eb8" :knowledge-point/title "Differentiating an Inverse Csch Function"}] :question/id #uuid "6e692dca-1bbc-59e7-999f-4acb806ddd38" :question/math-academy-id "e-8369" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y =7\\arcsch(1-x)$, then $\\dfrac {\\textrm{d}y}{\\textrm{d}x}=$" :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcsch x) = -\\dfrac{1}{\\mid x \\mid \\sqrt{1+x^2}}\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(7arcsch (1 - x)) \\\\\n&= 7\\frac{d}{dx}(arcsch (1 - x)) \\\\\n&= 7(- (1)/(\\mid 1 - x\\begin{vmatrix}\\sqrt{1 + (1 - x)^{2}})) \\cdot (1 - x)^{′} \\\\ = 7(-\\frac{1}{\\mid x - 1 \\mid \\sqrt{1 + 1 - 2x + x^{2}}}) \\cdot (-1) \\\\ = \\frac{7}{\\mid x - 1\\end{vmatrix}\\sqrt{x^{2} - 2x + 2}}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166604 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166766 :knowledge-point/id #uuid "216296fc-1ce3-532f-b96c-3d352c6b6ef2" :knowledge-point/title "Differentiating an Inverse Sech Function"}] :question/id #uuid "b4dd5d1a-eeae-58f5-b7a1-a6a20fb02df9" :question/math-academy-id "e-8370" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y = 5\\arsech{2x}$, then $\\dfrac {\\textrm{d}y}{\\textrm{d}x}=$" :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arsech x) = -\\dfrac{1}{x\\sqrt{1-x^2}}\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(5arsech 2x) \\\\\n&= 5\\frac{d}{dx}(arsech 2x) \\\\\n&= 5(- (1)/((2x)\\sqrt{1 - (2x)^{2}})) \\cdot (2x)^{′} \\\\\n&=-\\frac{5}{2x\\sqrt{1 - 4x^{2}}} \\cdot 2 \\\\\n&=-\\frac{5}{x\\sqrt{1 - 4x^{2}}}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166605 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166767 :knowledge-point/id #uuid "74aa4936-437c-52c6-b5ec-f175443379a7" :knowledge-point/title "Differentiating an Inverse Coth Function"}] :question/id #uuid "83b6c061-a8fc-5628-a199-60196b904407" :question/math-academy-id "e-8371" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y = \\arcoth{e^x}$, then $\\dfrac {\\textrm{d}y}{\\textrm{d}x}=$" :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcoth x) = \\dfrac{1}{1-x^2}\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(arcoth e^{x}) \\\\\n&= (1)/(1 - (e^{x})^{2}) \\cdot (e^{x})^{′} \\\\\n&= \\frac{1}{1 - e^{2x}} \\cdot e^{x} \\\\\n&= \\frac{e^{x}}{1 - e^{2x}}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166606 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166768 :knowledge-point/id #uuid "f5e40340-35cf-50ee-8a0d-7eb873490693" :knowledge-point/title "Differentiating Inverse Reciprocal Hyperbolic Functions Using the Product and Quotient Rules"}] :question/id #uuid "8a1806e8-d99d-5107-aa63-0bf841cb44c2" :question/math-academy-id "e-8372" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $f(x) = \\sin{x} \\cdot \\arcsch{x}$, then $f'(x) = \\cos{x} \\arcsch{x} + g(x)$. What is $g(x)$?" :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nIn this case, the expression for $f(x)$ is a product $u(x) \\cdot v(x)$ with\n\n$$\nu(x) = \\sin{x}\n$$\n\nand\n\n$$\nv(x) = \\arcsch{x}\n$$\n\nTherefore, we apply the product rule as follows:\n\n$$\n\\begin{aligned}\nf^{′}(x) &= u^{′}(x) \\cdot v(x) + u(x) \\cdot v^{′}(x) \\\\\n&= (\\sin x)^{′} \\cdot arcsch x + \\sin x \\cdot (arcsch x)^{′} \\\\\n&= \\cos x \\cdot arcsch x + \\sin x \\cdot (-\\frac{1}{\\mid x\\begin{vmatrix}\\sqrt{1 + x^{2}}}) \\\\ = \\cos xarcsch x + (-\\frac{\\sin x}{\\mid x\\end{vmatrix}\\sqrt{1 + x^{2}}})_(⏟)_(g(x))\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\ng(x) = -\\dfrac{\\sin{x}}{\\mid x \\mid \\sqrt{1+x^2}}\n$$"}] [{:db/id #edb/ref 17592186167345 :knowledge-point/_questions [{:db/id #edb/ref 17592186166765 :knowledge-point/id #uuid "319572db-8eed-59f2-95c4-d21a63642eb8" :knowledge-point/title "Differentiating an Inverse Csch Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6147089-f08b-519b-8082-b2d5dfc88d84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x\\sqrt{1 + x^{4}}}" :db/id #edb/ref 17592186165280} {:answer/id #uuid "ef524753-cc26-5111-aa12-149c74d7e45c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x}{\\sqrt{1 + x^{4}}}" :db/id #edb/ref 17592186165281} {:answer/id #uuid "184d0c08-4a96-5516-b453-711a5be64fc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{x^{2}\\sqrt{1 - x^{4}}}" :db/id #edb/ref 17592186165282} {:answer/id #uuid "379d1bd6-8330-540f-90d2-72e123741339" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{x\\sqrt{1 + x^{2}}}" :db/id #edb/ref 17592186165283} {:answer/id #uuid "72ee406d-b923-53b3-a00c-7133425e97e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x}{\\sqrt{1 - x^{4}}}" :db/id #edb/ref 17592186165284}] :answer-field/id #uuid "483dd5ca-6b7d-5085-88c4-f59f04b7faf4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186165279}] :question/id #uuid "d5e2b948-b294-5c79-aebf-65f70417475a" :question/math-academy-id "q-95318" :question/problem "If $y =-2arcsch x^{2}$, then $\\frac{dy}{dx} =$"}] [{:db/id #edb/ref 17592186167346 :knowledge-point/_questions [{:db/id #edb/ref 17592186166766 :knowledge-point/id #uuid "216296fc-1ce3-532f-b96c-3d352c6b6ef2" :knowledge-point/title "Differentiating an Inverse Sech Function"}] :question/answer-fields