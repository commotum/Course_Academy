#{[{:activity/first-step {:db/id #edb/ref 17592186167702} :activity/id #uuid "edcec73a-7591-579c-9044-e521d0cecbfa" :activity/scope {:db/id #edb/ref 17592186049311 :topic/id #uuid "eb7d984c-ade9-57a6-bd36-3c2ed797077f" :topic/math-academy-id 3255} :activity/steps [{:db/id #edb/ref 17592186167597 :step/content {:db/id #edb/ref 17592186166765 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166603 :question/id #uuid "6e692dca-1bbc-59e7-999f-4acb806ddd38" :question/math-academy-id "e-8369"} :knowledge-point/id #uuid "319572db-8eed-59f2-95c4-d21a63642eb8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051084}] :knowledge-point/questions [{:db/id #edb/ref 17592186167345} {:db/id #edb/ref 17592186167378}] :knowledge-point/title "Differentiating an Inverse Csch Function"} :step/id #uuid "1b8caf6f-2428-5c44-beeb-66136b28cd56" :step/math-academy-id 31204 :step/next {:db/id #edb/ref 17592186167598}} {:db/id #edb/ref 17592186167598 :step/content {:db/id #edb/ref 17592186166766 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166604 :question/id #uuid "b4dd5d1a-eeae-58f5-b7a1-a6a20fb02df9" :question/math-academy-id "e-8370"} :knowledge-point/id #uuid "216296fc-1ce3-532f-b96c-3d352c6b6ef2" :knowledge-point/questions [{:db/id #edb/ref 17592186167346} {:db/id #edb/ref 17592186167379}] :knowledge-point/title "Differentiating an Inverse Sech Function"} :step/id #uuid "63b227f6-59b4-5b4a-9487-4abf040ea99b" :step/math-academy-id 31205 :step/next {:db/id #edb/ref 17592186167599}} {:db/id #edb/ref 17592186167599 :step/content {:db/id #edb/ref 17592186166767 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166605 :question/id #uuid "83b6c061-a8fc-5628-a199-60196b904407" :question/math-academy-id "e-8371"} :knowledge-point/id #uuid "74aa4936-437c-52c6-b5ec-f175443379a7" :knowledge-point/questions [{:db/id #edb/ref 17592186167347} {:db/id #edb/ref 17592186167386}] :knowledge-point/title "Differentiating an Inverse Coth Function"} :step/id #uuid "498469fb-171d-514d-a919-a53218e62672" :step/math-academy-id 31206 :step/next {:db/id #edb/ref 17592186167600}} {:db/id #edb/ref 17592186167600 :step/content {:db/id #edb/ref 17592186166768 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166606 :question/id #uuid "8a1806e8-d99d-5107-aa63-0bf841cb44c2" :question/math-academy-id "e-8372"} :knowledge-point/id #uuid "f5e40340-35cf-50ee-8a0d-7eb873490693" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813} {:db/id #edb/ref 17592186048842}] :knowledge-point/questions [{:db/id #edb/ref 17592186167348} {:db/id #edb/ref 17592186167349}] :knowledge-point/title "Differentiating Inverse Reciprocal Hyperbolic Functions Using the Product and Quotient Rules"} :step/id #uuid "719532f0-a4af-5600-ad0a-b29865e84e93" :step/math-academy-id 31207} {:db/id #edb/ref 17592186167702 :step/content {:db/id #edb/ref 17592186168092 :tutorial/content "The derivatives of the inverse reciprocal hyperbolic functions are shown below:\n\n$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}\\frac{d}{dx}(arcsch x) &= -\\frac{1}{\\mid x \\mid \\sqrt{1 + x^{2}}}, & x ∈ (- ∞, 0)∪(0, ∞) \\\\ \\frac{d}{dx}(arsech x)|=-\\frac{1}{x\\sqrt{1 - x^{2}}}, & x ∈ (0, 1) \\\\ \\frac{d}{dx}(arcoth x)|= \\frac{1}{1 - x^{2}}, & x ∈ (- ∞,-1)∪(1, ∞)\\end{bmatrix}\n\\end{aligned}\n$$\n\nNow that we know the derivative of the base inverse reciprocal hyperbolic functions, we can differentiate combinations of these functions, by using the properties of differentiation.\n\nFor example, let's find the derivative of\n\n$$\ny = \\arsech{(-x^2)}\n$$\n\nUsing the formulas above together with the chain rule, we get\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(arsech (-x^{2})) \\\\\n&= - (1)/((-x^{2})\\sqrt{1 - (-x^{2})^{2}}) \\cdot (-x^{2})^{′} \\\\\n&=-\\frac{1}{-x^{2}\\sqrt{1 - x^{4}}} \\cdot (-2x) \\\\\n&=-\\frac{2}{x\\sqrt{1 - x^{4}}}\n\\end{aligned}\n$$" :tutorial/id #uuid "dc2da505-a8d0-5680-b8a0-ddeb66c32295" :tutorial/math-academy-id 5210 :tutorial/title "Introduction"} :step/id #uuid "20757712-075c-58c5-8cc7-4422f34ec28e" :step/math-academy-id 32695 :step/next {:db/id #edb/ref 17592186167597}}] :activity/title "Differentiating Inverse Reciprocal Hyperbolic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186167021}]}
