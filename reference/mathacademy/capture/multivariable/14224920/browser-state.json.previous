               \n                                    \n                                        \n                                        The eagle is approximately<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"52\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle></math></mjx-assistive-mml></mjx-container>\n\n\n                                    \n                                \n                                    \n                            \n                                        <div class=\"matheditor-wrapper-answer\" style=\"min-width: 30px; margin-left: 4px; margin-right: 4px;\">\n                                             \n                                        <div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"19\"><span mathquill-command-id=\"123\">3</span><span mathquill-command-id=\"125\">1</span><span mathquill-command-id=\"127\">.</span><span mathquill-command-id=\"129\">6</span><span mathquill-command-id=\"131\">8</span></span></div></div>                \n                                    \n                                \n                                    \n                                        \n                                        \n<mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"53\" style=\"font-size: 113.1%; position: relative;\"><mjx