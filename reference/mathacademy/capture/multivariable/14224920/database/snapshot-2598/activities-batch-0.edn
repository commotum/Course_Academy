186233946} {:db/id #edb/ref 17592186234354} {:db/id #edb/ref 17592186247161} {:db/id #edb/ref 17592186247162} {:db/id #edb/ref 17592186247163} {:db/id #edb/ref 17592186287921} {:db/id #edb/ref 17592186287922} {:db/id #edb/ref 17592186297407} {:db/id #edb/ref 17592186341997}] :knowledge-point/title "Differentiating Inverse Trigonometric Functions Using the Product or Quotient Rule"} :step/id #uuid "f0374828-ab62-597d-af5c-8e7cd5a900e2" :step/math-academy-id 848} {:db/id #edb/ref 17592186065300 :step/content {:db/id #edb/ref 17592186064368 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064012 :question/id #uuid "cbeacfa8-783e-5761-a74a-50b78a19ce20" :question/math-academy-id "e-206"} :knowledge-point/id #uuid "552973a7-4ab5-5918-83f4-15ee0e3ee052" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051084}] :knowledge-point/questions [{:db/id #edb/ref 17592186064741} {:db/id #edb/ref 17592186064951} {:db/id #edb/ref 17592186233136} {:db/id #edb/ref 17592186233672} {:db/id #edb/ref 17592186247078} {:db/id #edb/ref 17592186341995} {:db/id #edb/ref 17592186341996} {:db/id #edb/ref 17592186354460} {:db/id #edb/ref 17592186354461}] :knowledge-point/title "Differentiating an Inverse Sine Function"} :step/id #uuid "31b9d73c-30d5-56fb-88cf-1cfd862792fc" :step/math-academy-id 850 :step/next {:db/id #edb/ref 17592186065298}}] :activity/title "Differentiating Inverse Trigonometric Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064403}]}
