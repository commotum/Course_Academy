b/ref 1027 #edb/ref 17592186049288 #edb/ref 17592186045417] [17592186050010 #edb/ref 1028 #edb/ref 17592186221449 #edb/ref 17592186045417] [17592186050010 #edb/ref 1028 #edb/ref 17592186221450 #edb/ref 17592186045417] [17592186050010 #edb/ref 1028 #edb/ref 17592186221451 #edb/ref 17592186045417] [17592186050010 #edb/ref 1031 "Differentiating and Integrating Fourier Series" #edb/ref 17592186045417] [17592186050010 #edb/ref 1033 6383 #edb/ref 17592186045417] [17592186050010 #edb/ref 1035 #uuid "2602318d-f33f-5fd6-9721-6e9791bc0896" #edb/ref 17592186045417] [17592186050378 #edb/ref 1027 #edb/ref 17592186048396 #edb/ref 17592186045417] [17592186050378 #edb/ref 1027 #edb/ref 17592186048622 #edb/ref 17592186045417] [17592186050378 #edb/ref 1027 #edb/ref 17592186049288 #edb/ref 17592186045417] [17592186050378 #edb/ref 1027 #edb/ref 17592186050395 #edb/ref 17592186045417] [17592186050378 #edb/ref 1028 #edb/ref 17592186087779 #edb/ref 17592186045417] [17592186050378 #edb/ref 1028 #edb/ref 17592186087780 #edb/ref 17592186045417] [17592186050378 #edb/ref 1028 #edb/ref 17592186087785 #edb/ref 17592186045417] [17592186050378 #edb/ref 1031 "Second-Order Inhomogeneous ODEs With Sinusoidal Forcing" #edb/ref 17592186045417] [17592186050378 #edb/ref 1033 883 #edb/ref 17592186045417] [17592186050378 #edb/ref 1035 #uuid "44594723-00b7-53c1-8509-39704843a698" #edb/ref 17592186045417] [17592186220920 #edb/ref 1075 #edb/ref 17592186220921 #edb/ref 17592186045417] [17592186220920 #edb/ref 1075 #edb/ref 17592186220922 #edb/ref 17592186045417] [17592186220920 #edb/ref 1075 #edb/ref 17592186220923 #edb/ref 17592186045417] [17592186220920 #edb/ref 1075 #edb/ref 17592186220924 #edb/ref 17592186045417] [17592186220920 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186220920 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186220920 #edb/ref 1079 #uuid "f19ae7dd-5f1e-5b74-9ed5-f098fbd5c4d7" #edb/ref 17592186045417] [17592186220921 #edb/ref 1080 "n = 4" #edb/ref 17592186045417] [17592186220921 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186220921 #edb/ref 1083 #uuid "d423e01f-ec38-5c78-a360-f8ff9162a9bd" #edb/ref 17592186045417] [17592186220922 #edb/ref 1080 "n = 3" #edb/ref 17592186045417] [17592186220922 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186220922 #edb/ref 1083 #uuid "db84b894-e8b1-5fe3-be64-702e6d191a73" #edb/ref 17592186045417] [17592186220923 #edb/ref 1080 "n = 1" #edb/ref 17592186045417] [17592186220923 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186220923 #edb/ref 1083 #uuid "1cd298eb-8396-5e23-9f3b-1ee477c3257c" #edb/ref 17592186045417] [17592186220924 #edb/ref 1080 "n = 2" #edb/ref 17592186045417] [17592186220924 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186220924 #edb/ref 1083 #uuid "38911852-8718-556f-8556-fb745b53ceef" #edb/ref 17592186045417] [17592186221203 #edb/ref 1069 "e-21857" #edb/ref 17592186045417] [17592186221203 #edb/ref 1071 "Find the Fourier series of a particular solution of the differential equation\n\n$$\ny'-2y=f(x),\n$$\n\nwhere the Fourier series of the $6$-periodic forcing function is given by\n\n$$\nf(x) \\sim 3 + \\sum_{n=1}^\\infty \\dfrac{12}{n^2\\pi}\\cos\\left(\\dfrac{n\\pi x}{3}\\right).\n$$" #edb/ref 17592186045417] [17592186221203 #edb/ref 1072 #uuid "03fbfe2c-b12f-5220-9fae-e0dfe210a505" #edb/ref 17592186045417] [17592186221203 #edb/ref 1074 "We assume that a particular solution has the following Fourier series:\n\n$$\ny_p \\sim \\dfrac{a_0}{2} + \\sum_{n=1}^\\infty a_n \\cos\\left(\\dfrac{n\\pi x}{3}\\right) + b_n \\sin\\left(\\dfrac{n\\pi x}{3}\\right).\n$$\n\nNow, we compute the derivative:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})) \\\\  & ∼0+{\\sum }_{n=1}^{\\infty }{a}_{n}\\cdot (-\\frac{n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3}))+{b}_{n}\\cdot \\frac{n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & ∼{\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})+\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3}).\\end{aligned}\n$$\n\nNext, we substitute the expressions for $y'_p$ and $y_p$ into the equation:\n\n$$\n\\begin{aligned} & ({\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})+\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})) \\\\  & \\,-2(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})) \\\\  & \\,\\,=3+{\\sum }_{n=1}^{\\infty }\\frac{12}{{n}^{2}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{3}).\\end{aligned}\n$$\n\nRearranging the terms, we get\n\n$$\n\\begin{aligned} & -{a}_{0}+{\\sum }_{n=1}^{\\infty }(\\frac{{b}_{n}n\\pi }{3}-2{a}_{n})\\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & \\,\\,+{\\sum }_{n=1}^{\\infty }(-\\frac{{a}_{n}n\\pi }{3}-2{b}_{n})\\operatorname{sin}⁡(\\frac{n\\pi x}{3}) \\\\  & \\,\\,\\,\\,=3+{\\sum }_{n=1}^{\\infty }\\frac{12}{{n}^{2}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{3}).\\end{aligned}\n$$\n\nNow, equating the free terms and the coefficients next to sines and cosines, we obtain the following system:\n\n$$\n{\\begin{aligned}-{a}_{0}=3 \\\\ \\frac{{b}_{n}n\\pi }{3}-2{a}_{n}=\\frac{12}{{n}^{2}\\pi } \\\\ -\\frac{{a}_{n}n\\pi }{3}-2{b}_{n}=0\\end{aligned}\n$$\n\nFrom the first equation,\n\n$$\na_0=-3,\n$$\n\nwhich means the constant term is\n\n$$\n\\dfrac{a_0}{2}=-\\dfrac{3}{2}.\n$$\n\nNext, from the third equation,\n$b_n=-\\dfrac{a_n n\\pi}{6}.$\nSubstituting this into the second equation gives\n\n$$\n\\left(-\\dfrac{a_n n\\pi}{6}\\right)\\dfrac{n\\pi}{3}-2a_n=\\dfrac{12}{n^2\\pi}\n\\qquad\\Rightarrow\\qquad\na_n=-\\dfrac{216}{n^2\\pi(n^2\\pi^2+36)}.\n$$\n\nTherefore, for $b_n$ with $n\\ge 1,$ we have\n\n$$\n\\begin{aligned}{b}_{n} & =-\\frac{{a}_{n}n\\pi }{6} \\\\  & =-\\frac{n\\pi }{6}\\cdot (-\\frac{216}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}) \\\\  & =\\frac{36}{n({n}^{2}{\\pi }^{2}+36)}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{y}_{p}∼-\\frac{3}{2} & +{\\sum }_{n=1}^{\\infty }\\,-\\frac{216}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}\\cdot \\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & +{\\sum }_{n=1}^{\\infty }\\,\\frac{36}{n({n}^{2}{\\pi }^{2}+36)}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186221204 #edb/ref 1069 "e-21858" #edb/ref 17592186045417] [17592186221204 #edb/ref 1071 "Find the Fourier series of a particular solution of the differential equation $y''-y=f(x),$ where the Fourier series of the $2$-periodic forcing function is given by\n\n$$\nf(x) \\sim 1 + \\sum_{n=1}^\\infty \\dfrac{(-1)^{n+1}}{n^3\\pi} \\sin(n\\pi x).\n$$\n\n*Hint: We may assume that all the cosine coefficients in the Fourier series of the particular solution are equal to zero.*" #edb/ref 17592186045417] [17592186221204 #edb/ref 1072 #uuid "3944f6e4-a3a8-5bad-87c5-18227ce223bc" #edb/ref 17592186045417] [17592186221204 #edb/ref 1074 "Because the forcing function has only a constant term and sine terms, we assume a particular solution of the form\n\n$$\ny_p \\sim \\dfrac{a_0}{2} + \\sum_{n=1}^\\infty b_n \\sin(n\\pi x).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(n\\pi x))∼{\\sum }_{n=1}^{\\infty }{b}_{n}n\\pi \\operatorname{cos}⁡(n\\pi x) \\\\ {y}_{p}^{″} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }{b}_{n}n\\pi \\operatorname{cos}⁡(n\\pi x))∼{\\sum }_{n=1}^{\\infty }-{b}_{n}{n}^{2}{\\pi }^{2}\\operatorname{sin}⁡(n\\pi x)\\end{aligned}\n$$\n\nNext, we substitute the expressions for $y''_p$ and $y_p$ into the equation and have\n\n$$\n\\sum_{n=1}^\\infty -b_n n^2\\pi^2 \\sin(n\\pi x)\n-\n\\left( \\dfrac{a_0}{2} + \\sum_{n=1}^\\infty b_n \\sin(n\\pi x) \\right)\n=\n1 + \\sum_{n=1}^\\infty \\dfrac{(-1)^{n+1}}{n^3\\pi} \\sin(n\\pi x).\n$$\n\nRearranging the terms, we get\n\n$$\n-\\dfrac{a_0}{2} + \\sum_{n=1}^\\infty b_n(-n^2\\pi^2-1)\\sin(n\\pi x)\n=\n1 + \\sum_{n=1}^\\infty \\dfrac{(-1)^{n+1}}{n^3\\pi} \\sin(n\\pi x).\n$$\n\nNow, equating the free terms and sine coefficients, we obtain:\n![](images/24/249067c54bdeee50fdddb787db0d9fc6e95eeddd7cbf322cb425c08a2a25d97c.png)\n\nTherefore, our particular solution is\n\n$$\ny_p \\sim \n-1\n+ \\sum_{n=1}^\\infty \\:\n\\dfrac{(-1)^n}{n^3\\pi(n^2\\pi^2+1)}\n\\cdot\n\\sin(n\\pi x).\n$$" #edb/ref 17592186045417] [17592186221206 #edb/ref 1069 "e-21875" #edb/ref 17592186045417] [17592186221206 #edb/ref 1071 "Consider the differential equation $y'' + 9\\pi^2 y = f(x),$ where the $2$-periodic forcing function is given by\n\n$$\nf(x) \\sim \\sum_{n=1}^\\infty \\dfrac{1}{n^2}\\sin(n\\pi x).\n$$\n\nWhat harmonic of the forcing function does the natural frequency of the system match?\nAnd what is the resonant component of a particular solution?" #edb/ref 17592186045417] [17592186221206 #edb/ref 1072 #uuid "926606c2-1e1a-5aab-8f2e-826163a204a2" #edb/ref 17592186045417] [17592186221206 #edb/ref 1074 "We begin by identifying resonance. The differential equation\n\n$$\ny''+9\\pi^2 y=f(x)\n$$\n\nhas a natural frequency of\n\n$$\n\\omega=\\sqrt{9\\pi^2}=3\\pi.\n$$\n\nThe frequencies of the forcing harmonics for a $2$-periodic function $\\left(L=1\\right)$ are\n\n$$\n\\omega_n=\\dfrac{n\\pi}{1}=n\\pi.\n$$\n\nFor $n=3$, we have $\\omega_3=3\\pi.$ Since $\\omega_3=\\omega,$ the natural frequency of the system matches the frequency of the $n=3$ harmonic of the forcing function. This is the answer to the first question.\n\nFor the $n=3$ harmonic, the forcing term is \n\n$$\nf_3(x)=\\dfrac{1}{9}\\sin(3\\pi x).\n$$\n\nBecause this frequency matches the natural frequency, we assume a particular solution of the form\n\n$$\ny_{p_3}=x(A\\cos(3\\pi x)+B\\sin(3\\pi x)).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{{p}_{3}}^{′} & =(A\\operatorname{cos}⁡(3\\pi x)+B\\operatorname{sin}⁡(3\\pi x))+x(-3\\pi A\\operatorname{sin}⁡(3\\pi x)+3\\pi B\\operatorname{cos}⁡(3\\pi x)) \\\\ {y}_{{p}_{3}}^{″} & =-6\\pi A\\operatorname{sin}⁡(3\\pi x)+6\\pi B\\operatorname{cos}⁡(3\\pi x)-9{\\pi }^{2}x(A\\operatorname{cos}⁡(3\\pi x)+B\\operatorname{sin}⁡(3\\pi x))\\end{aligned}\n$$\n\nNext, we substitute the expressions for $y''_{p_3}$ and $y_{p_3}$ into the equation $y''+9\\pi^2 y=\\dfrac{1}{9}\\sin(3\\pi x){:}$\n\n$$\n\\left[-6\\pi A\\sin(3\\pi x)+6\\pi B\\cos(3\\pi x)-9\\pi^2 y_{p_3}\\right]+9\\pi^2 y_{p_3}=\\dfrac{1}{9}\\sin(3\\pi x)\n$$\n\nThe resonant terms involving $x$ cancel out, leaving\n\n$$\n-6\\pi A\\sin(3\\pi x)+6\\pi B\\cos(3\\pi x)=\\dfrac{1}{9}\\sin(3\\pi x).\n$$\n\nNow, equating the sine and cosine coefficients, we obtain:\n![](images/59/599de8dda7f476da630651310a373eae36280c75676a44da91105c9a1751456b.png)\n\nTherefore, the resonant component of a particular solution is\n\n$$\ny_{p_3}=-\\dfrac{x}{54\\pi}\\cos(3\\pi x).\n$$" #edb/ref 17592186045417] [17592186221455 #edb/ref 1037 #edb/ref 17592186049370 #edb/ref 17592186045417] [17592186221455 #edb/ref 1037 #edb/ref 17592186050010 #edb/ref 17592186045417] [17592186221455 #edb/ref 1038 #edb/ref 17592186222031 #edb/ref 17592186045417] [17592186221455 #edb/ref 1038 #edb/ref 17592186222032 #edb/ref 17592186045417] [17592186221455 #edb/ref 1038 #edb/ref 17592186317443 #edb/ref 17592186045417] [17592186221455 #edb/ref 1038 #edb/ref 17592186397662 #edb/ref 17592186045417] [17592186221455 #edb/ref 1038 #edb/ref 17592186397676 #edb/ref 17592186045417] [17592186221455 #edb/ref 1039 "Solving First Order ODEs Given the Fourier Series of the Forcing Function" #edb/ref 17592186045417] [17592186221455 #edb/ref 1041 #edb/ref 17592186221203 #edb/ref 17592186045417] [17592186221455 #edb/ref 1042 #uuid "4733fab7-18ca-5336-9aba-53212ddbf87b" #edb/ref 17592186045417] [17592186221456 #edb/ref 1037 #edb/ref 17592186050378 #edb/ref 17592186045417] [17592186221456 #edb/ref 1038 #edb/ref 17592186222035 #edb/ref 17592186045417] [17592186221456 #edb/ref 1038 #edb/ref 17592186222037 #edb/ref 17592186045417] [17592186221456 #edb/ref 1038 #edb/ref 17592186317447 #edb/ref 17592186045417] [17592186221456 #edb/ref 1038 #edb/ref 17592186317448 #edb/ref 17592186045417] [17592186221456 #edb/ref 1038 #edb/ref 17592186317449 #edb/ref 17592186045417] [17592186221456 #edb/ref 1038 #edb/ref 17592186317450 #edb/ref 17592186045417] [17592186221456 #edb/ref 1038 #edb/ref 17592186368331 #edb/ref 17592186045417] [17592186221456 #edb/ref 1038 #edb/ref 17592186368337 #edb/ref 17592186045417] [17592186221456 #edb/ref 1039 "Solving Second Order ODEs Given the Fourier Series of the Forcing Function" #edb/ref 17592186045417] [17592186221456 #edb/ref 1041 #edb/ref 17592186221204 #edb/ref 17592186045417] [17592186221456 #edb/ref 1042 #uuid "5e39d476-7dcb-5213-a461-df7bd1919b9f" #edb/ref 17592186045417] [17592186221457 #edb/ref 1037 #edb/ref 17592186048966 #edb/ref 17592186045417] [17592186221457 #edb/ref 1038 #edb/ref 17592186222039 #edb/ref 17592186045417] [17592186221457 #edb/ref 1038 #edb/ref 17592186222040 #edb/ref 17592186045417] [17592186221457 #edb/ref 1038 #edb/ref 17592186317451 #edb/ref 17592186045417] [17592186221457 #edb/ref 1038 #edb/ref 17592186317452 #edb/ref 17592186045417] [17592186221457 #edb/ref 1038 #edb/ref 17592186317453 #edb/ref 17592186045417] [17592186221457 #edb/ref 1038 #edb/ref 17592186368351 #edb/ref 17592186045417] [17592186221457 #edb/ref 1038 #edb/ref 17592186368362 #edb/ref 17592186045417] [17592186221457 #edb/ref 1038 #edb/ref 17592186397690 #edb/ref 17592186045417] [17592186221457 #edb/ref 1038 #edb/ref 17592186397701 #edb/ref 17592186045417] [17592186221457 #edb/ref 1038 #edb/ref 17592186397712 #edb/ref 17592186045417] [17592186221457 #edb/ref 1039 "Identifying Resonant Harmonics" #edb/ref 17592186045417] [17592186221457 #edb/ref 1041 #edb/ref 17592186221206 #edb/ref 17592186045417] [17592186221457 #edb/ref 1042 #uuid "9e42e65b-6e26-5a3f-9275-25a291e13138" #edb/ref 17592186045417] [17592186221475 #edb/ref 1043 #edb/ref 17592186222397 #edb/ref 17592186045417] [17592186221475 #edb/ref 1043 #edb/ref 17592186222398 #edb/ref 17592186045417] [17592186221475 #edb/ref 1043 #edb/ref 17592186222399 #edb/ref 17592186045417] [17592186221475 #edb/ref 1043 #edb/ref 17592186222400 #edb/ref 17592186045417] [17592186221475 #edb/ref 1043 #edb/ref 17592186222401 #edb/ref 17592186045417] [17592186221475 #edb/ref 1043 #edb/ref 17592186222402 #edb/ref 17592186045417] [17592186221475 #edb/ref 1043 #edb/ref 17592186222403 #edb/ref 17592186045417] [17592186221475 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186221475 #edb/ref 1045 "Solving ODEs Using Fourier Series" #edb/ref 17592186045417] [17592186221475 #edb/ref 1046 #edb/ref 17592186222397 #edb/ref 17592186045417] [17592186221475 #edb/ref 1049 #edb/ref 17592186049288 #edb/ref 17592186045417] [17592186221475 #edb/ref 1053 #uuid "2774bc0e-42a3-5956-a4b7-a719151ea7c2" #edb/ref 17592186045417] [17592186222037 #edb/ref 1068 #edb/ref 17592186316576 #edb/ref 17592186045417] [17592186222037 #edb/ref 1069 "q-343373" #edb/ref 17592186045417] [17592186222037 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186222037 #edb/ref 1071 "Select the missing parts in a particular solution of the differential equation ${y}^{″}+16y=f(x),$ where the Fourier series of the $6$-periodic forcing function is given by\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\n$$\n\n*Hint: You may assume that the free term and all the cosine coefficients in the Fourier series of the particular solution are equal to zero.*\n\nThe Fourier series of a particular solution is\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{3})\n$$" #edb/ref 17592186045417] [17592186222037 #edb/ref 1072 #uuid "d2c6150b-3687-5b67-8114-c6babfa1ec19" #edb/ref 17592186045417] [17592186222037 #edb/ref 1074 "We assume that a solution of our equation has the following Fourier series:\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3}))∼{\\sum }_{n=1}^{\\infty }\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\ {y}_{p}^{″} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3}))∼{\\sum }_{n=1}^{\\infty }-\\frac{{b}_{n}{n}^{2}{\\pi }^{2}}{9}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{″}$ and ${y}_{p}$ into the equation:\n\n$$\n{\\sum }_{n=1}^{\\infty }-\\frac{{b}_{n}{n}^{2}{\\pi }^{2}}{9}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})+16({\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3}))={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\n$$\n\nRearranging the terms to find a common denominator:\n\n$$\n{\\sum }_{n=1}^{\\infty }{b}_{n}(16-\\frac{{n}^{2}{\\pi }^{2}}{9})\\operatorname{sin}⁡(\\frac{n\\pi x}{3})={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{3})\n$$\n\n$$\n{\\sum }_{n=1}^{\\infty }{b}_{n}(\\frac{144-{n}^{2}{\\pi }^{2}}{9})\\operatorname{sin}⁡(\\frac{n\\pi x}{3})={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\n$$\n\nNow, equating the sine coefficients:\n\n$$\n\\frac{{b}_{n}(144-{n}^{2}{\\pi }^{2})}{9}=\\frac{(-1)^{n}}{{n}^{2}\\pi }\\,⇒\\,{b}_{n}=\\frac{9(-1)^{n}}{{n}^{2}\\pi (144-{n}^{2}{\\pi }^{2})}.\n$$\n\nTherefore, our particular solution is\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }\\,\\frac{9(-1)^{n}}{{n}^{2}\\pi (144-{n}^{2}{\\pi }^{2})}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\n$$" #edb/ref 17592186045417] [17592186222039 #edb/ref 1068 #edb/ref 17592186220920 #edb/ref 17592186045417] [17592186222039 #edb/ref 1069 "q-343382" #edb/ref 17592186045417] [17592186222039 #edb/ref 1071 "Consider the differential equation $y^{″} + 4π^{2}y = f(x)$, where the $1$-periodic forcing function is given by\n$f(x)∼∑_(n = 1)^(∞)\\frac{1}{n^{2}}\\cos (2nπx)$.\n\nSelect the correct options in the reasoning below regarding the resonant component of a particular solution of the equation.\n\nThe natural frequency of the system matches the frequency of the {{field-1}} harmonic of the forcing function." #edb/ref 17592186045417] [17592186222039 #edb/ref 1072 #uuid "9ad9a596-b8c8-5727-be8e-f1a040ae71ac" #edb/ref 17592186045417] [17592186222397 #edb/ref 1058 #edb/ref 17592186222398 #edb/ref 17592186045417] [17592186222397 #edb/ref 1061 607546 #edb/ref 17592186045417] [17592186222397 #edb/ref 1062 #uuid "0521dca3-2fe6-50aa-8dc9-282e35ffe718" #edb/ref 17592186045417] [17592186222397 #edb/ref 1063 #edb/ref 17592186222522 #edb/ref 17592186045417] [17592186222398 #edb/ref 1058 #edb/ref 17592186222399 #edb/ref 17592186045417] [17592186222398 #edb/ref 1061 607547 #edb/ref 17592186045417] [17592186222398 #edb/ref 1062 #uuid "ab947003-2e2f-5620-996d-e8070699c2a1" #edb/ref 17592186045417] [17592186222398 #edb/ref 1063 #edb/ref 17592186221455 #edb/ref 17592186045417] [17592186222399 #edb/ref 1058 #edb/ref 17592186222403 #edb/ref 17592186045417] [17592186222399 #edb/ref 1061 607550 #edb/ref 17592186045417] [17592186222399 #edb/ref 1062 #uuid "d1b21edf-14d7-5094-a313-f622ad12149b" #edb/ref 17592186045417] [17592186222399 #edb/ref 1063 #edb/ref 17592186222523 #edb/ref 17592186045417] [17592186222400 #edb/ref 1058 #edb/ref 17592186222401 #edb/ref 17592186045417] [17592186222400 #edb/ref 1061 607551 #edb/ref 17592186045417] [17592186222400 #edb/ref 1062 #uuid "2fb61d84-6e73-5592-aa15-0582c4b7b2f2" #edb/ref 17592186045417] [17592186222400 #edb/ref 1063 #edb/ref 17592186221456 #edb/ref 17592186045417] [17592186222401 #edb/ref 1058 #edb/ref 17592186222402 #edb/ref 17592186045417] [17592186222401 #edb/ref 1061 607555 #edb/ref 17592186045417] [17592186222401 #edb/ref 1062 #uuid "6d7e21fe-4716-5031-8d15-1ac9a8196ed5" #edb/ref 17592186045417] [17592186222401 #edb/ref 1063 #edb/ref 17592186222528 #edb/ref 17592186045417] [17592186222402 #edb/ref 1061 607556 #edb/ref 17592186045417] [17592186222402 #edb/ref 1062 #uuid "ca55a627-e4f5-543f-96b1-6632f3610f35" #edb/ref 17592186045417] [17592186222402 #edb/ref 1063 #edb/ref 17592186221457 #edb/ref 17592186045417] [17592186222403 #edb/ref 1058 #edb/ref 17592186222400 #edb/ref 17592186045417] [17592186222403 #edb/ref 1061 607559 #edb/ref 17592186045417] [17592186222403 #edb/ref 1062 #uuid "483f5b2d-f9cb-5272-a15f-759e449ff9c0" #edb/ref 17592186045417] [17592186222403 #edb/ref 1063 #edb/ref 17592186222530 #edb/ref 17592186045417] [17592186222522 #edb/ref 1064 "Suppose a linear ODE has a periodic forcing term whose Fourier series is known, for example\n\n$$\ny' + ky = f(x),\n\\qquad\\text{where}\\qquad\nf(x) \\sim \\frac{c_0}{2} + \\sum_{n=1}^\\infty \\Big(c_n\\cos(\\omega_n x) + d_n\\sin(\\omega_n x)\\Big).\n$$\n\nA standard strategy is to look for a *particular* solution with the *same Fourier frequencies*:\n\n$$\ny_p \\sim \\frac{a_0}{2} + \\sum_{n=1}^\\infty \\Big(a_n\\cos(\\omega_n x) + b_n\\sin(\\omega_n x)\\Big)\n$$\n\nThen, the method includes the following steps:\n\n- **Step 1:** Differentiate term-by-term.\n\nUsing $\\dfrac{\\text{d}}{\\text{d}x}\\cos(\\omega_n x)=-\\omega_n\\sin(\\omega_n x)$ and $\\dfrac{\\text{d}}{\\text{d}x}\\sin(\\omega_n x)=\\omega_n\\cos(\\omega_n x)$, we get\n\n$$\ny_p' \\sim \\sum_{n=1}^\\infty \\Big(-a_n\\omega_n\\sin(\\omega_n x) + b_n\\omega_n\\cos(\\omega_n x)\\Big).\n$$\n\n- **Step 2:** Substitute into the ODE and collect like terms\n\nThen, we plug $y_p$ and $y_p'$ into the equation, and rewrite the left-hand side as\n\n$$\n\\Big(\\substack{\\large\\text{free} \\[3pt] \\large\\text{term}}\\Big) \\;+\\; \n\\sum_{n=1}^\\infty \\Big(\\substack{\\large\\text{cosine} \\[3pt] \\large\\text{coefficient}}\\Big) \\cos(\\omega_n x) \\;+\\; \n\\sum_{n=1}^\\infty \\Big(\\substack{\\large\\text{sine} \\[3pt] \\large\\text{coefficient}}\\Big) \\sin(\\omega_n x).\n$$\n\n- **Step 3:** Equate coefficients.\n\nBecause the Fourier series representation is unique (up to convergence issues we ignore here), we match:\n\n- the free terms, and\n\n- for each $n\\ge 1$, the cosine coefficients and sine coefficients.\n\nThis produces:\n\n- one equation for $a_0$ (from the constant term), and\n\n- a $2\\times 2$ linear system for $(a_n,b_n)$ for each $n\\ge 1$.\n\n- **Step 4:** Write the Fourier series of $y_p.$\n\nAfter solving for $a_0$, $a_n$, and $b_n$, substitute them back into\n\n$$\ny_p \\sim \\frac{a_0}{2} + \\sum_{n=1}^\\infty \\Big(a_n\\cos(\\omega_n x) + b_n\\sin(\\omega_n x)\\Big).\n$$\n\nLet's see some examples." #edb/ref 17592186045417] [17592186222522 #edb/ref 1065 14711 #edb/ref 17592186045417] [17592186222522 #edb/ref 1066 #uuid "84328521-7170-5404-8ec2-a41475c2ad15" #edb/ref 17592186045417] [17592186222522 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186222523 #edb/ref 1064 "For second-order linear ODEs, the overall algorithm is the same as for first-order equations: \n\n- we assume a Fourier series for $y_p$,\n\n- substitute into the ODE, and\n\n- match coefficients.\n\nBefore we start, we can use the forcing series properties to simplify our work. For a second-order equation of the form \n\n$$\ny'' + \\omega^2 y = f(x)\n$$\n\nwith no $y'$ (damping) term, the particular solution can be simplified.\n\nThe key insight comes from the fact that the differential operator \n\n$$\nL[y] = y'' + \\omega^2 y\n$$\n\nmaps cosines to cosines and sines to sines. This means we can match the form of our assumed solution $y_p$ to the form of the forcing function $f(x),$ which saves a great deal of work.\n\nThis leads to some powerful shortcuts:\n\n- If $f(x)$ is a *pure cosine series* (an even function), we can assume $y_p$ is also a pure cosine series (all $b_n=0$).\n\n- If $f(x)$ is a *pure sine series* (an odd function), we can assume $y_p$ is also a pure sine series (all $a_n=0$, including $a_0=0$).\n\n- If the constant term in the series for $f(x)$ is zero, the constant term in $y_p$ will also be zero (so $a_0=0$).\n\nLet's see an example." #edb/ref 17592186045417] [17592186222523 #edb/ref 1065 14712 #edb/ref 17592186045417] [17592186222523 #edb/ref 1066 #uuid "12f51f58-a298-5fc1-9540-6d9f4611481b" #edb/ref 17592186045417] [17592186222523 #edb/ref 1067 "Second Order ODEs With Fourier Series" #edb/ref 17592186045417] [17592186222528 #edb/ref 1064 "A forcing harmonic can cause *resonance* when its frequency matches the natural frequency of the homogeneous equation.\n\nIn cases like that, we proceed as follows:\n\n- **Step 1:** Find the natural frequency.\n\nFor an equation of the form\n\n$$\ny''+\\omega^2 y = f(x),\n$$\n\nthe homogeneous solution oscillates with natural frequency $\\omega$.\n\n- **Step 2:** Find the forcing frequencies.\n\nIf $f$ is $2L$-periodic, then its Fourier series uses harmonics\n\n$$\n\\cos\\left(\\frac{n\\pi x}{L}\\right),\\qquad \\sin\\left(\\frac{n\\pi x}{L}\\right),\n$$\n\nwhose frequencies are\n\n$$\n\\omega_n=\\frac{n\\pi}{L}\\qquad(n\\ge 1).\n$$\n\nA harmonic is *resonant* exactly when $\\omega_n=\\omega$.\n\n- **Step 3:** Form the particular solution ansatz for each harmonic.\n\n- For a *non-resonant* harmonic ($\\omega_n\\ne \\omega$), we use the standard ansatz:\n\n$$\ny_{p_n}=A\\cos(\\omega_n x)+B\\sin(\\omega_n x)\n$$\n\n- For a *resonant* harmonic ($\\omega_n=\\omega$), this form overlaps with the homogeneous solution. We must use the *modified ansatz* by multiplying by $x{:}$\n\n$$\ny_{p_n}=x\\left(A\\cos(\\omega x)+B\\sin(\\omega x)\\right)\n$$\n\nThis extra factor of $x$ produces a new trial function that can match the forcing term.\n\nWhen $f$ is given as a Fourier series, we check each harmonic:\n\n- *non-resonant* harmonics contribute ordinary sine/cosine terms to $y_p,$ while\n\n- *resonant* harmonics contribute terms multiplied by $x.$\n\nIn particular, the resonant harmonic is the one with index $n$ satisfying\n\n$$\n\\frac{n\\pi}{L}=\\omega.\n$$\n\nLet's see how this works in practice." #edb/ref 17592186045417] [17592186222528 #edb/ref 1065 14776 #edb/ref 17592186045417] [17592186222528 #edb/ref 1066 #uuid "1aff3ba6-cd76-5ae7-bcd6-d05e9fb44694" #edb/ref 17592186045417] [17592186222528 #edb/ref 1067 "Cases Where the Forcing Term Induces Resonance" #edb/ref 17592186045417] [17592186222530 #edb/ref 1064 "Consider the differential equation $y''-4y=f(x),$ where the Fourier series of the $2$-periodic forcing function is given by\n\n$$\nf(x) \\sim \\sum_{n=1}^\\infty \\dfrac{2}{n^2}\\cos(n\\pi x).\n$$\n\nBecause $f$ has no free term and is a pure cosine series, we assume\n\n$$\ny_p \\sim \\sum_{n=1}^\\infty a_n\\cos(n\\pi x).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{p}^{'} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}(n\\pi x))∼{\\sum }_{n=1}^{\\infty }-{a}_{n}n\\pi \\operatorname{sin}(n\\pi x) \\\\ {y}_{p}^{''} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }-{a}_{n}n\\pi \\operatorname{sin}(n\\pi x))∼{\\sum }_{n=1}^{\\infty }-{a}_{n}{n}^{2}{\\pi }^{2}\\operatorname{cos}(n\\pi x)\\end{aligned}\n$$\n\nNext, we substitute $y''_p$ and $y_p$ into the equation and have\n\n$$\n\\sum_{n=1}^\\infty -a_n n^2\\pi^2\\cos(n\\pi x)\n-\n4\\left(\\sum_{n=1}^\\infty a_n\\cos(n\\pi x)\\right)\n=\n\\sum_{n=1}^\\infty \\dfrac{2}{n^2}\\cos(n\\pi x).\n$$\n\nRearranging the terms, we get\n\n$$\n\\sum_{n=1}^\\infty -a_n(n^2\\pi^2+4)\\cos(n\\pi x)\n=\n\\sum_{n=1}^\\infty \\dfrac{2}{n^2}\\cos(n\\pi x).\n$$\n\nNow, equating the cosine coefficients, we obtain\n\n$$\n-a_n(n^2\\pi^2+4)=\\dfrac{2}{n^2}\n\\qquad\\Rightarrow\\qquad\na_n=-\\dfrac{2}{n^2(n^2\\pi^2+4)}.\n$$\n\nTherefore, a Fourier series for a particular solution is\n\n$$\ny_p \\sim \\sum_{n=1}^\\infty \\: -\\dfrac{2}{n^2(n^2\\pi^2+4)} \\cdot \\cos(n\\pi x).\n$$" #edb/ref 17592186045417] [17592186222530 #edb/ref 1065 14873 #edb/ref 17592186045417] [17592186222530 #edb/ref 1066 #uuid "f2d6d8f9-00d1-552b-889a-e54ed8d22d21" #edb/ref 17592186045417] [17592186222530 #edb/ref 1067 "A Worked Example of Solving a Second Order ODE" #edb/ref 17592186045417] [17592186315206 #edb/ref 1080 "\\frac{3(-1)^{n}}{n{\\pi }^{2}(4+n\\pi )}" #edb/ref 17592186045417] [17592186315206 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186315206 #edb/ref 1083 #uuid "0eac6c01-7323-5cfa-8a28-9ee89e883eb3" #edb/ref 17592186045417] [17592186315259 #edb/ref 1080 "-\\frac{9(-1)^{n}}{{n}^{2}{\\pi }^{2}(16-{n}^{2})}" #edb/ref 17592186045417] [17592186315259 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186315259 #edb/ref 1083 #uuid "182aace0-6eea-5683-b022-6752de8edb23" #edb/ref 17592186045417] [17592186315290 #edb/ref 1080 "-\\frac{15x}{8\\pi }\\operatorname{cos}⁡(\\frac{2\\pi x}{3})" #edb/ref 17592186045417] [17592186315290 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186315290 #edb/ref 1083 #uuid "1d996731-b251-5b34-875b-e57bb6c2b7c7" #edb/ref 17592186045417] [17592186315338 #edb/ref 1080 "\\frac{24}{{n}^{2}({n}^{2}{\\pi }^{2}+36)}" #edb/ref 17592186045417] [17592186315338 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186315338 #edb/ref 1083 #uuid "26f91b7c-20bf-51fd-a393-6190c6c8e355" #edb/ref 17592186045417] [17592186315379 #edb/ref 1080 "-2" #edb/ref 17592186045417] [17592186315379 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186315379 #edb/ref 1083 #uuid "2c374525-0d10-5050-a300-a79dcfbe1344" #edb/ref 17592186045417] [17592186315396 #edb/ref 1080 "2" #edb/ref 17592186045417] [175921