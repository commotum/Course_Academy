{a}_{n}n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})+\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{′}$ and ${y}_{p}$ into the equation:\n\n$$\n\\begin{aligned} & ({\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})+\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})) \\\\  & \\,-2(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})) \\\\  & \\,\\,=-2+{\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$\n\nRearranging the terms, we get \n\n$$\n\\begin{aligned} & -2\\cdot \\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }(\\frac{{b}_{n}n\\pi }{3}-2{a}_{n})\\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & \\,\\,+{\\sum }_{n=1}^{\\infty }(-\\frac{{a}_{n}n\\pi }{3}-2{b}_{n})\\operatorname{sin}⁡(\\frac{n\\pi x}{3}) \\\\  & \\,\\,\\,\\,=-2+{\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{3}).\\end{aligned}\n$$\n\nNow, equating the free terms and the coefficients next to sines and cosines, we obtain the following system:\n\n$$\n{\\begin{aligned}-2\\cdot \\frac{{a}_{0}}{2}=-2 \\\\ \\frac{{b}_{n}n\\pi }{3}-2{a}_{n}=\\frac{4}{{n}^{2}\\pi } \\\\ -\\frac{{a}_{n}n\\pi }{3}-2{b}_{n}=0\\end{aligned}\n$$\n\nFrom the first equation, ${a}_{0}=2,$ which means the constant term is given by\n\n$$\n\\frac{{a}_{0}}{2}=1.\n$$\n\nNext, from the third equation, ${b}_{n}=-\\frac{{a}_{n}n\\pi }{6}.$ Substituting this into the third equation, gives\n\n$$\n(-\\frac{{a}_{n}n\\pi }{6})\\frac{n\\pi }{3}-2{a}_{n}=\\frac{4}{{n}^{2}\\pi }\\,⇒\\,{a}_{n}=-\\frac{72}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}.\n$$\n\nTherefore, for ${a}_{n}$ with $n\\ge 1,$ we have\n\n$$\n\\begin{aligned}{b}_{n} & =-\\frac{{a}_{n}n\\pi }{6} \\\\  & =-\\frac{n\\pi }{6}\\cdot (-\\frac{72}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}) \\\\  & =\\frac{12}{n({n}^{2}{\\pi }^{2}+36)}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{y}_{p}∼1 & +{\\sum }_{n=1}^{\\infty }\\,-\\frac{72}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}\\cdot \\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & +{\\sum }_{n=1}^{\\infty }\\,\\frac{12}{n({n}^{2}{\\pi }^{2}+36)}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186317452 #edb/ref 1068 #edb/ref 17592186317060 #edb/ref 17592186045417] [17592186317452 #edb/ref 1068 #edb/ref 17592186317103 #edb/ref 17592186045417] [17592186317452 #edb/ref 1069 "q-343905" #edb/ref 17592186045417] [17592186317452 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186317452 #edb/ref 1071 "Consider the differential equation ${y}^{″}+\\frac{4{\\pi }^{2}}{9}y=f(x),$ where the $6$-periodic forcing function is given by \n\n$$\nf(x)∼-3+{\\sum }_{n=1}^{\\infty }\\frac{5}{{n}^{2}}\\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\n$$\n\nSelect the correct options in the reasoning below regarding the resonant component of a particular solution of the equation.\n\nThe natural frequency of the system matches the frequency of the {{field-1}} harmonic of the forcing function. \n\nConsequently, the particular solution contains a resonant term of the form\n\n$$\n{y}_{{p}_{2}}={{field-2}}.\n$$" #edb/ref 17592186045417] [17592186317452 #edb/ref 1072 #uuid "de35c174-f52d-54b1-9320-5816b5069f2c" #edb/ref 17592186045417] [17592186317452 #edb/ref 1074 "We begin by identifying resonance. The differential equation \n\n$$\n{y}^{″}+\\frac{4{\\pi }^{2}}{9}y=f(x)\n$$\n\nhas a natural frequency of \n\n$$\n\\omega =\\sqrt{\\frac{4{\\pi }^{2}}{9}}=\\frac{2\\pi }{3}.\n$$\n\nThe frequencies of the forcing harmonics for a $6$-periodic function $(L=3)$ are \n\n$$\n{\\omega }_{n}=\\frac{n\\pi }{3}.\n$$\n\nFor $n=2$, we have ${\\omega }_{2}=\\frac{2\\pi }{3}.$ Since ${\\omega }_{2}=\\omega ,$ the $n=2$ harmonic of the forcing function causes resonance.\n\nFor the $n=2$ harmonic, the forcing term is \n\n$$\n{f}_{2}(x)=\\frac{5}{4}\\operatorname{sin}⁡(\\frac{2\\pi x}{3}).\n$$\n\nBecause this frequency matches the natural frequency, we assume a particular solution of the form\n\n$$\n{y}_{{p}_{2}}=x(A\\operatorname{cos}⁡(\\frac{2\\pi x}{3})+B\\operatorname{sin}⁡(\\frac{2\\pi x}{3})).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{y}_{{p}_{2}}^{′} & =(A\\operatorname{cos}⁡(\\frac{2\\pi x}{3})+B\\operatorname{sin}⁡(\\frac{2\\pi x}{3}))+x(-\\frac{2\\pi }{3}A\\operatorname{sin}⁡(\\frac{2\\pi x}{3})+\\frac{2\\pi }{3}B\\operatorname{cos}⁡(\\frac{2\\pi x}{3})) \\\\ \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{y}_{{p}_{2}}^{″} & =-\\frac{4\\pi }{3}A\\operatorname{sin}⁡(\\frac{2\\pi x}{3})+\\frac{4\\pi }{3}B\\operatorname{cos}⁡(\\frac{2\\pi x}{3})-\\frac{4{\\pi }^{2}}{9}x(A\\operatorname{cos}⁡(\\frac{2\\pi x}{3})+B\\operatorname{sin}⁡(\\frac{2\\pi x}{3}))\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{{p}_{2}}^{″}$ and ${y}_{{p}_{2}}$ into the equation ${y}^{″}+\\frac{4{\\pi }^{2}}{9}y=\\frac{5}{4}\\operatorname{sin}⁡(\\frac{2\\pi x}{3}):$\n\n$$\n[-\\frac{4\\pi }{3}A\\operatorname{sin}⁡(\\frac{2\\pi x}{3})+\\frac{4\\pi }{3}B\\operatorname{cos}⁡(\\frac{2\\pi x}{3})-\\frac{4{\\pi }^{2}}{9}{y}_{{p}_{2}}]+\\frac{4{\\pi }^{2}}{9}{y}_{{p}_{2}}=\\frac{5}{4}\\operatorname{sin}⁡(\\frac{2\\pi x}{3})\n$$\n\nThe resonant terms involving $x$ cancel out, leaving\n\n$$\n-\\frac{4\\pi }{3}A\\operatorname{sin}⁡(\\frac{2\\pi x}{3})+\\frac{4\\pi }{3}B\\operatorname{cos}⁡(\\frac{2\\pi x}{3})=\\frac{5}{4}\\operatorname{sin}⁡(\\frac{2\\pi x}{3}).\n$$\n\nNow, equating the sine and cosine coefficients, we obtain:\n\n$$\n{\\begin{aligned}-\\frac{4\\pi }{3}A=\\frac{5}{4} \\\\ \\frac{4\\pi }{3}B=0\\end{aligned}\\,⇒\\,{\\begin{aligned}A=-\\frac{15}{16\\pi } \\\\ B=0\\end{aligned}\n$$\n\nTherefore, the resonant component of a particular solution is\n\n$$\n{y}_{{p}_{2}}=-\\frac{15x}{16\\pi }\\operatorname{cos}⁡(\\frac{2\\pi x}{3}).\n$$" #edb/ref 17592186045417] [17592186368331 #edb/ref 1068 #edb/ref 17592186368332 #edb/ref 17592186045417] [17592186368331 #edb/ref 1069 "q-343876" #edb/ref 17592186045417] [17592186368331 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186368331 #edb/ref 1071 "Select the missing parts in a particular solution of the differential equation ${y}^{″}+25y=f(x),$ where the Fourier series of the $2$-periodic forcing function is given by\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(n\\pi x).\n$$\n\n*Hint: You may assume that the free term and all the cosine coefficients in the Fourier series of the particular solution are equal to zero.*\n\nThe Fourier series of a particular solution is\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot \\operatorname{sin}⁡(n\\pi x)\n$$" #edb/ref 17592186045417] [17592186368331 #edb/ref 1072 #uuid "fdf0a8e9-3b28-5328-8c13-b8779f952184" #edb/ref 17592186045417] [17592186368331 #edb/ref 1074 "We assume that a solution of our equation has the following Fourier series:\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(n\\pi x).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(n\\pi x))∼{\\sum }_{n=1}^{\\infty }{b}_{n}n\\pi \\operatorname{cos}⁡(n\\pi x) \\\\ {y}_{p}^{″} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }{b}_{n}n\\pi \\operatorname{cos}⁡(n\\pi x))∼{\\sum }_{n=1}^{\\infty }-{b}_{n}{n}^{2}{\\pi }^{2}\\operatorname{sin}⁡(n\\pi x)\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{″}$ and ${y}_{p}$ into the equation:\n\n$$\n{\\sum }_{n=1}^{\\infty }-{b}_{n}{n}^{2}{\\pi }^{2}\\operatorname{sin}⁡(n\\pi x)+25({\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(n\\pi x))={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(n\\pi x).\n$$\n\nRearranging the terms to find a common denominator:\n\n$$\n{\\sum }_{n=1}^{\\infty }{b}_{n}(25-{n}^{2}{\\pi }^{2})\\operatorname{sin}⁡(n\\pi x)={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(n\\pi x)\n$$\n\nNow, equating the sine coefficients:\n\n$$\n{b}_{n}(25-{n}^{2}{\\pi }^{2})=\\frac{(-1)^{n}}{{n}^{2}\\pi }\\,⇒\\,{b}_{n}=\\frac{(-1)^{n}}{{n}^{2}\\pi (25-{n}^{2}{\\pi }^{2})}.\n$$\n\nTherefore, our particular solution is\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }\\,\\frac{(-1)^{n}}{{n}^{2}\\pi (25-{n}^{2}{\\pi }^{2})}\\cdot \\operatorname{sin}⁡(n\\pi x).\n$$" #edb/ref 17592186045417] [17592186368332 #edb/ref 1075 #edb/ref 17592186368333 #edb/ref 17592186045417] [17592186368332 #edb/ref 1075 #edb/ref 17592186368334 #edb/ref 17592186045417] [17592186368332 #edb/ref 1075 #edb/ref 17592186368335 #edb/ref 17592186045417] [17592186368332 #edb/ref 1075 #edb/ref 17592186368336 #edb/ref 17592186045417] [17592186368332 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186368332 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186368332 #edb/ref 1078 #edb/ref 17592186368336 #edb/ref 17592186045417] [17592186368332 #edb/ref 1079 #uuid "3dd85012-cb13-5af2-aa01-15ea4bd3072a" #edb/ref 17592186045417] [17592186368333 #edb/ref 1080 "\\frac{25(-1)^{n}}{{n}^{2}\\pi (25-{n}^{2}{\\pi }^{2})}" #edb/ref 17592186045417] [17592186368333 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186368333 #edb/ref 1083 #uuid "4dce7229-1a2d-5e8a-9b24-81a137c060a1" #edb/ref 17592186045417] [17592186368334 #edb/ref 1080 "-\\frac{(-1)^{n}}{{n}^{2}\\pi (25-{n}^{2}{\\pi }^{2})}" #edb/ref 17592186045417] [17592186368334 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186368334 #edb/ref 1083 #uuid "f0a00450-0f8a-5ca2-a742-5dd6a893e2ab" #edb/ref 17592186045417] [17592186368335 #edb/ref 1080 "\\frac{(-1)^{n}}{n\\pi (25-{