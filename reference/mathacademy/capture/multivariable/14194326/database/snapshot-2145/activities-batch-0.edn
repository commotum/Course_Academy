#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186093335} :activity/id #uuid "21c10e32-8c2e-5d6b-a5cb-19f07aa83fdf" :activity/scope {:db/id #edb/ref 17592186049236 :topic/id #uuid "e5b028a3-9410-51df-925f-0bb38d65ee4b" :topic/math-academy-id 993} :activity/steps [{:db/id #edb/ref 17592186093089 :step/content {:db/id #edb/ref 17592186092242 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092084 :question/id #uuid "6e4ab84e-f722-557e-9740-25b3a0b3d660" :question/math-academy-id "e-6104"} :knowledge-point/id #uuid "6b175cb1-6615-540f-9145-224a838e37d0" :knowledge-point/questions [{:db/id #edb/ref 17592186092715} {:db/id #edb/ref 17592186092730} {:db/id #edb/ref 17592186317439} {:db/id #edb/ref 17592186329819} {:db/id #edb/ref 17592186339054} {:db/id #edb/ref 17592186339055}] :knowledge-point/title "Estimating a Derivative Given a Graph Using a Backward Difference Approximation"} :step/id #uuid "332d8f20-0643-51b2-8b43-875b7569adc3" :step/math-academy-id 22597 :step/next {:db/id #edb/ref 17592186093337}} {:db/id #edb/ref 17592186093090 :step/content {:db/id #edb/ref 17592186092243 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092085 :question/id #uuid "fb3d12e8-e413-5300-8d3f-991ddfd2a893" :question/math-academy-id "e-6105"} :knowledge-point/id #uuid "4d864064-2833-530a-b421-a57f9ec5fce5" :knowledge-point/questions [{:db/id #edb/ref 17592186092729} {:db/id #edb/ref 17592186092731} {:db/id #edb/ref 17592186317444} {:db/id #edb/ref 17592186317445} {:db/id #edb/ref 17592186317446} {:db/id #edb/ref 17592186329809} {:db/id #edb/ref 17592186354476}] :knowledge-point/title "Estimating a Derivative Given a Graph Using a Backward Difference Approximation: Word Problem"} :step/id #uuid "0358e8c8-7e96-5bb6-9fc7-eef0c1c3cde8" :step/math-academy-id 22598 :step/next {:db/id #edb/ref 17592186093338}} {:db/id #edb/ref 17592186093335 :step/content {:db/id #edb/ref 17592186093444 :tutorial/content "To approximate the derivative of a function, we can use the finite difference formula\n\n$$\nf'(x)\\approx \\frac{f(x) - f(x-h) }{h}\n$$\n\nfor small values of the step size $h,$ with $h>0.$\n\nThis expression is known as the **backward difference approximation** because if $h>0$ then $x-h$ is a step behind $x$ (i.e., to the left). \n\n![](images/dd/ddc03ba86c8c343d5733b51444cec157182894b6d0c4fccb501b1dc3bca98f57.png)\n\nAs usual, the smaller the step size $h$ is, the better the approximation to $f'(x)$ we obtain." :tutorial/id #uuid "6aff8fa6-f787-5984-944a-5648207e6830" :tutorial/math-academy-id 368 :tutorial/title "Introduction"} :step/id #uuid "5a2b7913-8af1-56e3-ae9c-6dea1ca15630" :step/math-academy-id 686 :step/next {:db/id #edb/ref 17592186093336}} {:db/id #edb/ref 17592186093336 :step/content {:db/id #edb/ref 17592186092390 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091959 :question/id #uuid "7a6fbfc8-cd6d-57fe-bcab-ab68339683bd" :question/math-academy-id "e-155"} :knowledge-point/id #uuid "494ef4f7-873c-5d87-85e5-89094c6cc376" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061} {:db/id #edb/ref 17592186049362}] :knowledge-point/questions [{:db/id #edb/ref 17592186092920} {:db/id #edb/ref 17592186092921} {:db/id #edb/ref 17592186317435} {:db/id #edb/ref 17592186317436} {:db/id #edb/ref 17592186317437} {:db/id #edb/ref 17592186339050} {:db/id #edb/ref 17592186339053}] :knowledge-point/title "Estimating a Derivative Given a Table Using a Backward Difference Approximation"} :step/id #uuid "f1579afd-f8b8-522d-815c-72dc7b18e4b7" :step/math-academy-id 687 :step/next {:db/id #edb/ref 17592186093089}} {:db/id #edb/ref 17592186093337 :step/content {:db/id #edb/ref 17592186092391 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091961 :question/id #uuid "cdf8854d-14ea-5564-81cc-4e5098f1acc3" :question/math-academy-id "e-156"} :knowledge-point/id #uuid "a6068e54-fa91-5078-86f8-d34f1f1a3ca4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048835}] :knowledge-point/questions [{:db/id #edb/ref 17592186092727} {:db/id #edb/ref 17592186092728} {:db/id #edb/ref 17592186317440} {:db/id #edb/ref 17592186317442} {:db/id #edb/ref 17592186329817} {:db/id #edb/ref 17592186332871} {:db/id #edb/ref 17592186339056}] :knowledge-point/title "Estimating a Derivative Given a Table Using a Backward Difference Approximation: Word Problem"} :step/id #uuid "84a50349-fb71-5a17-b1e7-276d47f34414" :step/math-academy-id 691 :step/next {:db/id #edb/ref 17592186093090}} {:db/id #edb/ref 17592186093338 :step/content {:db/id #edb/ref 17592186093445 :tutorial/content "Where does the formula for the backward difference come from? Remember that from the definition of derivative, we have the forward difference formula\n\n$$\nf'(x)\\approx \\frac{f(x+h) - f(x) }{h}\n$$\n\nfor small values of  $h.$ \n\nNow, replacing $h$ with $-h$ in the formula above gives\n\n$$\n\\begin{aligned}{f}^{'}(x) & \\approx \\frac{f(x-h)-f(x)}{-h} \\\\  & =\\frac{f(x)-f(x-h)}{h}.\\end{aligned}\n$$\n\nThe step of replacing $h$ with $-h$ is equivalent to stepping a distance of $h$ to the left rather than to the right." :tutorial/id #uuid "1cc2d207-71d4-53a4-8c67-5af0c5f4d173" :tutorial/math-academy-id 371 :tutorial/title "Derivation of the Formula"} :step/id #uuid "a635f38c-a7e9-57d1-aeb5-e9fe6f8751e0" :step/math-academy-id 694}] :activity/title "Estimating Derivatives Using a Backward Difference Quotient" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092467}]}
