db/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452842} {:answer-field/choices [{:answer/id #uuid "66d69f0d-a54c-5690-98ab-9eb78f75c963" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451991} {:answer/id #uuid "01f64f3a-256c-5b22-a4f9-411d66aeef70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451992}] :answer-field/correct {:answer/id #uuid "01f64f3a-256c-5b22-a4f9-411d66aeef70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451992} :answer-field/id #uuid "cc95f6fb-f3c0-5b76-b045-537413682258" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452843}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6847dae1-289b-5050-b4ae-95ca49b57e85" :question/math-academy-id "q-94632" :question/problem "Consider the vector space $C[0,1]$ of all continuous functions $f:[0,1]\\to R$ and its subset $L$ containing all polynomials of degree exactly $1.$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $L$ is closed under function addition\n\n- **II.** $L$ is closed under scalar multiplication\n\n- **III.** $L$ is a subspace of $C[0,1]$\n\n- **IV.** $L$ is **not** a subspace of $C[0,1]$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. For example, if $f(x)=x$ and $g(x)=1-x,$ then\n\n$$\n\\begin{aligned}f(x)+g(x) & =x+(1-x) \\\\  & =(x-x)+1 \\\\  & =1.\\end{aligned}\n$$\n\nSo, $L$ is *not* closed under addition.\n\n- Statement II is false. For example, if $f(x)=x$ and $k=0,$ then\n\n$$\nkf(x)=0\\cdot x=0.\n$$\n\n \nSo, $L$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $L$ is *not* a subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"IV only.\""}] [{:db/id #edb/ref 17592186360468 :knowledge-point/_questions [{:db/id #edb/ref 17592186124488 :knowledge-point/id #uuid "ef65513d-1e9e-571f-8b93-4e2d63aed68e" :knowledge-point/title "Identifying Subspaces of Function Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "991f2f73-ac23-5191-ab80-7de9efee7e9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452009} {:answer/id #uuid "2ead1013-7e82-50d2-9ea0-c2b7d5a04066" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452010}] :answer-field/correct {:answer/id #uuid "2ead1013-7e82-50d2-9ea0-c2b7d5a04066" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452010} :answer-field/id #uuid "506cf49e-9f52-5299-8ed3-6ff8e24478db" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452852} {:answer-field/choices [{:answer/id #uuid "fed6d2ec-aee8-5542-8372-ae559f20b93f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452011} {:answer/id #uuid "c05c0c3e-d50a-5489-b880-65368c86a869" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452012}] :answer-field/correct {:answer/id #uuid "c05c0c3e-d50a-5489-b880-65368c86a869" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452012} :answer-field/id #uuid "5b6ad786-f4e4-5537-b235-5beb1d76d0c8" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452853} {:answer-field/choices [{:answer/id #uuid "1e1613e4-3825-5163-955a-c508dc5a7424" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452013} {:answer/id #uuid "f5a4d7ea-1e52-5939-b1ad-c82fa09897e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452014}] :answer-field/correct {:answer/id #uuid "f5a4d7ea-1e52-5939-b1ad-c82fa09897e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452014} :answer-field/id #uuid "860bab32-e063-5c7b-9daf-21735a207ce5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452854} {:answer-field/choices [{:answer/id #uuid "902ecaea-e103-52f1-8446-e92ffd5c7e4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452015} {:answer/id #uuid "b5359c31-2887-5291-8d2f-9c2c74acea93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186452016}] :answer-field/correct {:answer/id #uuid "902ecaea-e103-52f1-8446-e92ffd5c7e4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186452015} :answer-field/id #uuid "063b6651-61e1-5617-8f54-44670f58aa5b" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452855}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "44096d11-ac2c-5302-8668-0431e5543e9f" :question/math-academy-id "q-94642" :question/problem "Consider the vector space $C[-2,2]$ of all continuous functions $f:[-2,2]\\to R$ and its subset $E$ containing all even functions.\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $E$ is closed under function addition\n- **II.** $E$ is closed under scalar multiplication\n- **III.** $E$ is a subspace of $C[-2,2]$\n- **IV.** $E$ is **not** a subspace of $C[-2,2]$\n\n*Hint: $f$ is even if $f(-x)=f(x)$ for all $x\\in [-2,2].$*" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. If $f(x),g(x)\\in E,$ then\n\n$$\n\\begin{aligned}(f+g)(-x) & =f(-x)+g(-x) \\\\  & =f(x)+g(x) \\\\  & =(f+g)(x)\\end{aligned}\n$$\n\nSo, $E$ is closed under addition.\n\n- Statement II is true. If $f(x)\\in E$ and $k\\in R,$ then \n\n$$\n\\begin{aligned}(kf)(-x) & =kf(-x) \\\\  & =kf(x) \\\\  & =(kf)(x)\\end{aligned}\n$$\n\nSo, $E$ is closed under scalar multiplication.\n\n- Statement III is true, while statement IV is false. $E$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"I, II, and III only.\""}]}
