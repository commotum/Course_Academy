      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153257/observations/step-q18135-b87ceb718dfdef85d488.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153257/observations/step-q18135-b87ceb718dfdef85d488.png",
      "source_url": "https://mathacademy.com/tasks/14153257/topics/1203/lesson",
      "captured_at": 1791849732.4475572,
      "math_academy_id": "q-18135",
      "topic_id": "1203",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q18135",
        "placement_id": null,
        "content_id": null,
