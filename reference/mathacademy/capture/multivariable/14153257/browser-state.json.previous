      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153257/observations/step-q344604-5b3bbd223cd7626952bf.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153257/observations/step-q344604-5b3bbd223cd7626952bf.png",
      "source_url": "https://mathacademy.com/tasks/14153257/topics/1203/lesson",
      "captured_at": 1791849635.4565983,
      "math_academy_id": "q-344604",
      "topic_id": "1203",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q344604",
        "placement_id": null,
        "content_id": null,
        "type": null
