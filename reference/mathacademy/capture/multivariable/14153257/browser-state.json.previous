      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153257/observations/step-q15237-c98627743233eb5deeed.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153257/observations/step-q15237-c98627743233eb5deeed.png",
      "source_url": "https://mathacademy.com/tasks/14153257/topics/1203/lesson",
      "captured_at": 1791849685.39968,
      "math_academy_id": "q-15237",
