      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153257/observations/step-q316309-30eef8970128d377d82b.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153257/observations/step-q316309-30eef8970128d377d82b.png",
      "source_url": "https://mathacademy.com/tasks/14153257/topics/1203/lesson",
      "captured_at": 1791849661.3928628,
      "math_academy_id": "q-316309",
      "topic_id": "1203",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q316309",
