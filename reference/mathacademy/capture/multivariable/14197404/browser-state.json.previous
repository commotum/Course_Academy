><mtd><mi></mi><mo>=</mo><mn>4</mn><mo stretchy=\"false\">(</mo><mn>25</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>4</mn><mo stretchy=\"false\">(</mo><mn>5</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>4</mn><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>121</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>&gt;</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>5</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>5</mn><mo stretchy=\"false\">)</mo><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
