ption selected\" style=\"height: 17px;\">False</div><div class=\"selectListOption\" style=\"height: 17px;\">True</div></div></div></td>\n</tr>\n<tr> \n<td style=\"text-align:left; border:hidden;\">The relation is transitive</td>\n<td style=\"text-align:left; border:hidden;\"><div id=\"selectList-214250-2\" class=\"selectList\" style=\"margin: 0px 2px 2px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-214250-2\" style=\"width: 55px; height: 17px; line-height: 17px;\">True</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 839px; top: 3081px;\"><div class=\"selectListOption selected\" style=\"height: 17px;\">True</div><div class=\"selectListOption\" style=\"height: 17px;\">False</div></div></div></td>\n</tr>\n<tr> \n<td style=\"text-align:left; border:hidden;\">The relation is an equivalence relation</td>\n<td style=\"text-align:left; border:hidden;\"><div id=\"selectList-214250-3\" class=\"selectList\" style=\"margin: 0px 2px 2px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-214250-3\" style=\"width: 55px; height: 17px; line-height: 17px;\">False</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 839px; top: 3126px;\"><div class=\"selectListOption\" style=\"height: 17px;\">True</div><div class=\"selectListOption selected\" style=\"height: 17px;\">False</div></div></div></td>\n</tr>\n</tbody></table></div><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div class=\"questionWidget-spinner\" style=\"display: block;\"></div></div><div class=\"questionWidget-result\"><div class=\"questionWidget-incorrectIcon\"><img src=\"/img/incorrect-answer.svg\"></div><div class=\"questionWidget-incorrectText\">Incorrect</div></div><div class=\"questionWidget-explanationHeader\">EXPLANATION</div><div class=\"questionWidge