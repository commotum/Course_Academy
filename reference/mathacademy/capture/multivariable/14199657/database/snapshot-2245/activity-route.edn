#{[{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186516966} :activity/id #uuid "215c7a81-d36e-5609-8320-0dd250b50425" :activity/scope {:db/id #edb/ref 17592186049050 :topic/id #uuid "d5d3e7a8-b91e-501f-841f-df61b10e029f" :topic/math-academy-id 6372} :activity/steps [{:db/id #edb/ref 17592186516875 :step/content {:db/id #edb/ref 17592186370086 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5db6aba9-6cbd-5512-a3ea-6f40db46a0bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}({e}^{-3t}-1)" :db/id #edb/ref 17592186370088} {:answer/id #uuid "cbc763d3-259f-5b21-8237-15af711651e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-3t}" :db/id #edb/ref 17592186370089} {:answer/id #uuid "36e87f42-d4ef-52b0-8e1e-8d04ef9a352e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{t+3}" :db/id #edb/ref 17592186370090} {:answer/id #uuid "2a97d9b6-6569-5dc8-a7a6-9ed5332f6d21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}(1-{e}^{-3t})" :db/id #edb/ref 17592186370091} {:answer/id #uuid "10a0052f-0e56-5c86-96e4-acfa2390fd1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}(1-{e}^{-t})" :db/id #edb/ref 17592186370092}] :answer-field/correct {:db/id #edb/ref 17592186370091} :answer-field/id #uuid "fcb64710-408a-53fa-9bef-4e2f33202084" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186370087}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "edb23ffa-161e-5239-9f82-d504d4a4ac87" :question/math-academy-id "q-330850" :question/problem "For the function\n\n$$\nG(s)=\\frac{1}{s(s+3)},\\,s>-3\n$$\n\nfind the inverse Laplace transform of $G(s),$ given that\n$L\\{{e}^{at}\\}=\\frac{1}{s-a},\\text{ }s>a.$" :question/worked-solution "Notice that we can write $G(s)$ as \n\n$$\nG(s)=\\frac{1}{s(s+3)}=\\frac{F(s)}{s},\n$$\n\nwhere $F(s)=\\frac{1}{s+3}.$\nAlso, we know that\n\n$$\nL\\{{e}^{at}\\}=\\frac{1}{s-a}.\n$$\n\nThus, we get\n\n$$\n\\begin{aligned}{L}^{-1}\\{F(s)\\} & ={L}^{-1}\\{\\frac{1}{s+3}\\} \\\\  & ={L}^{-1}\\{\\frac{1}{s-(-3)}\\} \\\\  & ={e}^{-3t}.\\end{aligned}\n$$\n\nAdditionally, we know that if $L\\{f(t)\\}=F(s)$, then\n\n$$\nL\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\}=\\frac{F(s)}{s}.\n$$\n\nUsing the property above in reverse, we obtain\n\n$$\n\\begin{aligned}{L}^{-1}\\{G(s)\\} & ={L}^{-1}\\{\\frac{F(s)}{s}\\} \\\\  & ={\\int }_{0}^{t}f(τ)\\,\\text{d}τ \\\\  & ={\\int }_{0}^{t}{e}^{-3τ}\\,\\text{d}τ \\\\  & =-\\frac{1}{3}{e}^{-3τ}\\,{|}_{0}^{t} \\\\  & =\\frac{1}{3}(1-{e}^{-3t}).\\end{aligned}\n$$"} :step/id #uuid "044a61a9-ca8b-543e-a987-591524bfb608" :step/next {:db/id #edb/ref 17592186516984}} {:db/id #edb/ref 17592186516966 :step/content {:db/id #edb/ref 17592186516870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51d3524b-853a-5f24-bead-4dc7191f32e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\operatorname{sin}⁡(3t)" :db/id #edb/ref 17592186516281} {:answer/id #uuid "9e4377c0-d77d-5c2c-a21f-23409edc6aa6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\operatorname{cos}⁡(3t)" :db/id #edb/ref 17592186516435} {:answer/id #uuid "9f842f87-8cb2-57b2-a9ce-91a5cee4adee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\operatorname{sin}⁡(6t)" :db/id #edb/ref 17592186516438} {:answer/id #uuid "a0d7f93d-9d98-505e-9264-9db48cd4c908" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{sin}⁡(3t)" :db/id #edb/ref 17592186516442} {:answer/id #uuid "ea10f27b-e911-5268-92bf-ea025a05f69d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}(1-\\operatorname{cos}⁡(3t))" :db/id #edb/ref 17592186516599}] :answer-field/correct {:db/id #edb/ref 17592186516281} :answer-field/id #uuid "3469b6e6-3937-5bae-a2c1-ec22b3cd921a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516669}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fe889695-c274-5d10-8ca5-8cda9ca89ff9" :question/math-academy-id "q-330841" :question/problem "For the function\n\n$$\nG(s)=\\frac{1}{{s}^{2}+9},\\,s>0\n$$\n\nfind the inverse Laplace transform of $G(s),$ given that\n$L\\{\\operatorname{cos}⁡(\\omega t)\\}=\\frac{s}{{s}^{2}+{\\omega }^{2}}.$" :question/worked-solution "Notice that we can write $G(s)$ as \n\n$$\nG(s)=\\frac{1}{{s}^{2}+9}=\\frac{F(s)}{s},\n$$\n\nwhere \n\n$$\nF(s)=\\frac{s}{{s}^{2}+9}.\n$$\n\nAlso, we know that\n\n$$\nL\\{\\operatorname{cos}⁡(\\omega t)\\}=\\frac{s}{{s}^{2}+{\\omega }^{2}}.\n$$\n\nThus, we get\n\n$$\n\\begin{aligned}{L}^{-1}\\{F(s)\\} & ={L}^{-1}\\,\\{\\frac{s}{{s}^{2}+9}\\} \\\\  & ={L}^{-1}\\,\\{\\frac{s}{{s}^{2}+{3}^{2}}\\} \\\\  & =\\operatorname{cos}⁡(3t).\\end{aligned}\n$$\n\nAdditionally, we know that if $L\\{f(t)\\}=F(s)$, then\n\n$$\nL\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\}=\\frac{F(s)}{s}.\n$$\n\nUsing the property above in reverse, we obtain\n\n$$\n\\begin{aligned}{L}^{-1}\\{G(s)\\} & ={L}^{-1}\\{\\frac{F(s)}{s}\\} \\\\  & ={\\int }_{0}^{t}f(τ)\\,\\text{d}τ \\\\  & ={\\int }_{0}^{t}\\operatorname{cos}⁡(3τ)\\,\\text{d}τ \\\\  & =\\frac{1}{3}\\operatorname{sin}⁡(3t).\\end{aligned}\n$$"} :step/id #uuid "c9fbfbe4-24a6-552a-87eb-2773ea07012c" :step/next {:db/id #edb/ref 17592186516875}} {:db/id #edb/ref 17592186516984 :step/content {:db/id #edb/ref 17592186516859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a2b1c83-f538-5666-957f-d0272fd104f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{{\\pi }^{2}}\\,(1-\\operatorname{cos}⁡(\\pi t))" :db/id #edb/ref 17592186516130} {:answer/id #uuid "17b46602-87a2-5cfd-baef-de3d2c2aeeb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡(\\pi t)" :db/id #edb/ref 17592186516161} {:answer/id #uuid "21c06364-24ac-5f7f-96e9-05eee9ac4264" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\pi }\\,\\operatorname{cos}⁡(\\pi t)" :db/id #edb/ref 17592186516177} {:answer/id #uuid "a4e47355-a3e9-51c9-8b45-6331f5a2c118" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡(\\pi t)" :db/id #edb/ref 17592186516454} {:answer/id #uuid "b9738824-4f34-5c6a-96f2-709deddf8f72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\pi }\\,\\operatorname{sin}⁡(\\pi t)" :db/id #edb/ref 17592186516500}] :answer-field/correct {:db/id #edb/ref 17592186516500} :answer-field/id #uuid "02445787-c7a8-5ffc-846c-db1bdad30898" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516650}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e4186181-b281-5425-a9bd-de0a0cf53688" :question/math-academy-id "q-330854" :question/problem "For the function\n\n$$\nG(s)=\\frac{1}{{s}^{2}+{\\pi }^{2}},\\,s>0\n$$\n\nfind the inverse Laplace transform of $G(s),$ given that\n$L\\{\\operatorname{cos}⁡(\\omega t)\\}=\\frac{s}{{s}^{2}+{\\omega }^{2}}.$" :question/worked-solution "Notice that we can write $G(s)$ as \n\n$$\nG(s)=\\frac{1}{{s}^{2}+{\\pi }^{2}}=\\frac{F(s)}{s},\n$$\n\nwhere $F(s)=\\frac{s}{{s}^{2}+{\\pi }^{2}}.$\nAlso, we know that\n\n$$\nL\\{\\operatorname{cos}⁡(\\omega t)\\}=\\frac{s}{{s}^{2}+{\\omega }^{2}}.\n$$\n\nThus, we get\n\n$$\n\\begin{aligned}{L}^{-1}\\{F(s)\\} & ={L}^{-1}\\{\\frac{s}{{s}^{2}+{\\pi }^{2}}\\} \\\\  & =\\operatorname{cos}⁡(\\pi t).\\end{aligned}\n$$\n\nAdditionally, we know that if $L\\{f(t)\\}=F(s)$, then\n\n$$\nL\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\}=\\frac{F(s)}{s}.\n$$\n\nUsing the property above in reverse, we obtain\n\n$$\n\\begin{aligned}{L}^{-1}\\{G(s)\\} & ={L}^{-1}\\{\\frac{F(s)}{s}\\} \\\\  & ={\\int }_{0}^{t}f(τ)\\,\\text{d}τ \\\\  & ={\\int }_{0}^{t}\\operatorname{cos}⁡(\\pi τ)\\,\\text{d}τ \\\\  & =\\frac{1}{\\pi }\\,\\operatorname{sin}⁡(\\pi t).\\end{aligned}\n$$"} :step/id #uuid "fdfe3af1-4411-537a-ae83-ab05398ed910"}] :activity/title "Laplace Transforms of Integrals" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516088}]}
