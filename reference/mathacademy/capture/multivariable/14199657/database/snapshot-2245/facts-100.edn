/ref 17592186516500 #edb/ref 17592186045417] [17592186516650 #edb/ref 1079 #uuid "02445787-c7a8-5ffc-846c-db1bdad30898" #edb/ref 17592186045417] [17592186516669 #edb/ref 1075 #edb/ref 17592186516281 #edb/ref 17592186045417] [17592186516669 #edb/ref 1075 #edb/ref 17592186516435 #edb/ref 17592186045417] [17592186516669 #edb/ref 1075 #edb/ref 17592186516438 #edb/ref 17592186045417] [17592186516669 #edb/ref 1075 #edb/ref 17592186516442 #edb/ref 17592186045417] [17592186516669 #edb/ref 1075 #edb/ref 17592186516599 #edb/ref 17592186045417] [17592186516669 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186516669 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186516669 #edb/ref 1078 #edb/ref 17592186516281 #edb/ref 17592186045417] [17592186516669 #edb/ref 1079 #uuid "3469b6e6-3937-5bae-a2c1-ec22b3cd921a" #edb/ref 17592186045417] [17592186516859 #edb/ref 1068 #edb/ref 17592186516650 #edb/ref 17592186045417] [17592186516859 #edb/ref 1069 "q-330854" #edb/ref 17592186045417] [17592186516859 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186516859 #edb/ref 1071 "For the function\n\n$$\nG(s)=\\frac{1}{{s}^{2}+{\\pi }^{2}},\\,s>0\n$$\n\nfind the inverse Laplace transform of $G(s),$ given that\n$L\\{\\operatorname{cos}⁡(\\omega t)\\}=\\frac{s}{{s}^{2}+{\\omega }^{2}}.$" #edb/ref 17592186045417] [17592186516859 #edb/ref 1072 #uuid "e4186181-b281-5425-a9bd-de0a0cf53688" #edb/ref 17592186045417] [17592186516859 #edb/ref 1074 "Notice that we can write $G(s)$ as \n\n$$\nG(s)=\\frac{1}{{s}^{2}+{\\pi }^{2}}=\\frac{F(s)}{s},\n$$\n\nwhere $F(s)=\\frac{s}{{s}^{2}+{\\pi }^{2}}.$\nAlso, we know that\n\n$$\nL\\{\\operatorname{cos}⁡(\\omega t)\\}=\\frac{s}{{s}^{2}+{\\omega }^{2}}.\n$$\n\nThus, we get\n\n$$\n\\begin{aligned}{L}^{-1}\\{F(s)\\} & ={L}^{-1}\\{\\frac{s}{{s}^{2}+{\\pi }^{2}}\\} \\\\  & =\\operatorname{cos}⁡(\\pi t).\\end{aligned}\n$$\n\nAdditionally, we know that if $L\\{f(t)\\}=F(s)$, then\n\n$$\nL\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\}=\\frac{F(s)}{s}.\n$$\n\nUsing the property above in reverse, we obtain\n\n$$\n\\begin{aligned}{L}^{-1}\\{G(s)\\} & ={L}^{-1}\\{\\frac{F(s)}{s}\\} \\\\  & ={\\int }_{0}^{t}f(τ)\\,\\text{d}τ \\\\  & ={\\int }_{0}^{t}\\operatorname{cos}⁡(\\pi τ)\\,\\text{d}τ \\\\  & =\\frac{1}{\\pi }\\,\\operatorname{sin}⁡(\\pi t).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186516870 #edb/ref 1068 #edb/ref 17592186516669 #edb/ref 17592186045417] [17592186516870 #edb/ref 1069 "q-330841" #edb/ref 17592186045417] [17592186516870 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186516870 #edb/ref 1071 "For the function\n\n$$\nG(s)=\\frac{1}{{s}^{2}+9},\\,s>0\n$$\n\nfind the inverse Laplace transform of $G(s),$ given that\n$L\\{\\operatorname{cos}⁡(\\omega t)\\}=\\frac{s}{{s}^{2}+{\\omega }^{2}}.$" #edb/ref 17592186045417] [17592186516870 #edb/ref 1072 #uuid "fe889695-c274-5d10-8ca5-8cda9ca89ff9" #edb/ref 17592186045417] [17592186516870 #edb/ref 1074 "Notice that we can write $G(s)$ as \n\n$$\nG(s)=\\frac{1}{{s}^{2}+9}=\\frac{F(s)}{s},\n$$\n\nwhere \n\n$$\nF(s)=\\frac{s}{{s}^{2}+9}.\n$$\n\nAlso, we know that\n\n$$\nL\\{\\operatorname{cos}⁡(\\omega t)\\}=\\frac{s}{{s}^{2}+{\\omega }^{2}}.\n$$\n\nThus, we get\n\n$$\n\\begin{aligned}{L}^{-1}\\{F(s)\\} & ={L}^{-1}\\,\\{\\frac{s}{{s}^{2}+9}\\} \\\\  & ={L}^{-1}\\,\\{\\frac{s}{{s}^{2}+{3}^{2}}\\} \\\\  & =\\operatorname{cos}⁡(3t).\\end{aligned}\n$$\n\nAdditionally, we know that if $L\\{f(t)\\}=F(s)$, then\n\n$$\nL\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\}=\\frac{F(s)}{s}.\n$$\n\nUsing the property above in reverse, we obtain\n\n$$\n\\begin{aligned}{L}^{-1}\\{G(s)\\} & ={L}^{-1}\\{\\frac{F(s)}{s}\\} \\\\  & ={\\int }_{0}^{t}f(τ)\\,\\text{d}τ \\\\  & ={\\int }_{0}^{t}\\operatorname{cos}⁡(3τ)\\,\\text{d}τ \\\\  & =\\frac{1}{3}\\operatorname{sin}⁡(3t).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186516875 #edb/ref 1058 #edb/ref 17592186516984 #edb/ref 17592186045417] [17592186516875 #edb/ref 1062 #uuid "044a61a9-c