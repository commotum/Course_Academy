5f3c-9d58-8db833728dc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-st}{A}^{′}(t)" :db/id #edb/ref 17592186370121} {:answer/id #uuid "c7426aba-d42c-5b6b-88a2-780a40303536" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-st}{A}^{″}(t)" :db/id #edb/ref 17592186370122} {:answer/id #uuid "859b9c4c-2a74-560a-a2b9-b82d3b6f862e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "sF(s)" :db/id #edb/ref 17592186370123}] :answer-field/correct {:db/id #edb/ref 17592186370121} :answer-field/id #uuid "6cc14be5-39a5-569e-be12-a55397184034" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186370119} {:answer-field/choices [{:answer/id #uuid "38524dc2-7fc9-5667-813e-537bade34cf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{s}{e}^{-st}" :db/id #edb/ref 17592186370125} {:answer/id #uuid "dc0e232c-e0de-5e88-9f66-7fb9f0cb3a2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{t}{e}^{-st}" :db/id #edb/ref 17592186370126} {:answer/id #uuid "58430c99-2d4b-567c-a9a1-21a8c3b6df7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{t}{e}^{-st}" :db/id #edb/ref 17592186370127} {:answer/id #uuid "7ced9ac9-5c16-5302-8ab4-bead51741598" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{s}{e}^{-st}" :db/id #edb/ref 17592186370128}] :answer-field/correct {:db/id #edb/ref 17592186370128} :answer-field/id #uuid "de8f7848-c18e-57c4-805b-bdc740617941" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186370124}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c7ba6935-6849-517e-9bd9-9735ae2d6fb9" :question/math-academy-id "q-331076" :question/problem "Suppose we wish to find $L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}$ given $L\\{f(t)\\}=F(s)$ for $s>{s}_{0}.$ Select the correct options in the reasoning below.\n\nLet $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ={{field-1}}\\,{|}_{0}^{t}=A(t).\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,dτ\\}=L\\{A(t)\\}={\\int }_{0}^{\\infty }{{field-2}}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & ⇒ & du={A}^{′}(t)\\text{ }dt \\\\ dv={{field-3}} & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }({{field-4}}){A}^{′}(t)\\,dt\\end{aligned}\n$$\n\nSince $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=$ {{field-5}}, we have\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{{field-6}}\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$" :question/worked-solution "Let $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ & =A(τ)\\,{|}_{0}^{t} \\\\  & =A(t)-A(0) \\\\  & =A(t).\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\} & =L\\{A(t)\\}={\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & \\,⇒\\, & du={A}^{′}(t)\\,dt \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }(-\\frac{1}{s}{e}^{-st}){A}^{′}(t)\\,dt.\\end{aligned}\n$$\n\nSince $A(0)=0$ and $\\frac{1}{s}{e}^{-st}\\to 0$ as $t\\to \\infty ,$ we have $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=0$ and\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{1}{s}\\cdot F(s) \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$"} :step/id #uuid "1157fa95-5ca0-5552-8548-4e37f9ab0aa7"} {:db/id #edb/ref 17592186493990 :step/content {:db/id #edb/ref 17592186304857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11988bb4-bd76-5da0-89ba-38a30472093a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{t}^{4}}{4}" :db/id #edb/ref 17592186302571} {:answer/id #uuid "3b6e7e94-7dde-537c-98cb-20b59c24b1fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{t}^{6}}{30}" :db/id #edb/ref 17592186302827} {:answer/id #uuid "5b39dec8-6f4d-5a1c-8367-b4a6120b8574" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{24}{{t}^{5}}" :db/id #edb/ref 17592186303013} {:answer/id #uuid "6aa8899d-beae-5941-a3d4-82e94a1d2266" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{t}^{5}}{5}" :db/id #edb/ref 17592186303108} {:answer/id #uuid "e6893c52-98ee-5b15-a3f0-a746742b6299" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{t}^{4}" :db/id #edb/ref 17592186303890}] :answer-field/correct {:db/id #edb/ref 17592186303108} :answer-field/id #uuid "95522057-6f76-5a8c-85b6-0d8377b32c14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186304476}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c43f625b-d110-5aef-9243-2a1cae536c09" :question/math-academy-id "q-330843" :question/problem "For the function\n\n$$\nG(s)=\\frac{24}{{s}^{6}},\\,s>0\n$$\n\nfind the inverse Laplace transform of $G(s),$ given that\n$L\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}.$" :question/worked-solution "Notice that we can write $G(s)$ as \n\n$$\nG(s)=\\frac{24}{{s}^{6}}=\\frac{F(s)}{s},\n$$\n\nwhere $F(s)=\\frac{24}{{s}^{5}}.$\nAlso, we know that\n\n$$\nL\\{{t}^{n}\\}=\\frac{n!}{{s}^{n+1}}.\n$$\n\nThus, we get\n\n$$\n\\begin{aligned}{L}^{-1}\\{F(s)\\} & ={L}^{-1}\\{\\frac{24}{{s}^{5}}\\} \\\\  & ={L}^{-1}\\{\\frac{4!}{{s}^{4+1}}\\} \\\\  & ={t}^{4}.\\end{aligned}\n$$\n\nAdditionally, we know that if $L\\{f(t)\\}=F(s)$, then\n\n$$\nL\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\}=\\frac{F(s)}{s}.\n$$\n\nUsing the property above in reverse, we obtain\n\n$$\n\\begin{aligned}{L}^{-1}\\{G(s)\\} & ={L}^{-1}\\{\\frac{F(s)}{s}\\} \\\\  & ={\\int }_{0}^{t}f(τ)\\,\\text{d}τ \\\\  & ={\\int }_{0}^{t}{τ}^{4}\\,\\text{d}τ \\\\  & =\\frac{{t}^{5}}{5}.\\end{aligned}\n$$"} :step/id #uuid "3298c911-4b68-58bb-83be-c53fead7b7b9" :step/next {:db/id #edb/ref 17592186494001}} {:db/id #edb/ref 17592186494001 :step/content {:db/id #edb/ref 17592186304859 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b30fb93-d4f5-57ff-89d5-4ae27e848f3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{s-5}" :db/id #edb/ref 17592186302824} {:answer/id #uuid "45bc93fe-5bb2-55dd-8c94-74f48290abdc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}(1-{e}^{5t})" :db/id #edb/ref 17592186302897} {:answer/id #uuid "69b71edb-5681-5b89-9393-9ba3e46b6fbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}({e}^{t}-1)" :db/id #edb/ref 17592186303100} {:answer/id #uuid "75e53d4a-6a6b-5a91-815b-dc87331bce6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{5t}" :db/id #edb/ref 17592186303176} {:answer/id #uuid "7906a1bc-f57e-5117-b624-76a26363e3f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}({e}^{5t}-1)" :db/id #edb/ref 17592186303204}] :answer-field/correct {:db/id #edb/ref 17592186303204} :answer-field/id #uuid "6c0df3ef-2be2-59de-94c6-d27577149ad2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186304367}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8064a487-d480-5cc5-97a5-d474531a9775" :question/math-academy-id "q-330849" :question/problem "For the function\n\n$$\nG(s)=\\frac{1}{s(s-5)},\\,s>5\n$$\n\nfind the inverse Laplace transform of $G(s),$ given that\n$L\\{{e}^{at}\\}=\\frac{1}{s-a},\\text{ }s>a.$" :question/worked-solution "Notice that we can write $G(s)$ as \n\n$$\nG(s)=\\frac{1}{s(s-5)}=\\frac{F(s)}{s},\n$$\n\nwhere $F(s)=\\frac{1}{s-5}.$\nAlso, we know that\n\n$$\nL\\{{e}^{at}\\}=\\frac{1}{s-a}.\n$$\n\nThus, we get\n\n$$\n\\begin{aligned}{L}^{-1}\\{F(s)\\} & ={L}^{-1}\\{\\frac{1}{s-5}\\} \\\\  & ={e}^{5t}.\\end{aligned}\n$$\n\nAdditionally, we know that if $L\\{f(t)\\}=F(s)$, then\n\n$$\nL\\{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ\\}=\\frac{F(s)}{s}.\n$$\n\nUsing the property above in reverse, we obtain\n\n$$\n\\begin{aligned}{L}^{-1}\\{G(s)\\} & ={L}^{-1}\\{\\frac{F(s)}{s}\\} \\\\  & ={\\int }_{0}^{t}f(τ)\\,\\text{d}τ \\\\  & ={\\int }_{0}^{t}{e}^{5τ}\\,\\text{d}τ \\\\  & =\\frac{1}{5}{e}^{5τ}\\,{|}_{0}^{t} \\\\  & =\\frac{1}{5}({e}^{5t}-1).\\end{aligned}\n$$"} :step/id #uuid "4e4e4c22-0f71-57e6-bb91-c83cf64a6cfe" :step/next {:db/id #edb/ref 17592186493979}} {:db/id #edb/ref 17592186494055 :step/content {:db/id #edb/ref 17592186221939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a287c4c-314b-5a3d-a1a5-ee8569803cd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{t-3}" :db/id #edb/ref 17592186493461} {:answer/id #uuid "31498a6a-f3af-5dd5-be6d-11d44f51fea5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}({e}^{3t}-1)" :db/id #edb/ref 17592186493474} {:answer/id #uuid "44996372-2e93-5895-8