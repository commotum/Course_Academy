#{[{:activity/first-step {:db/id #edb/ref 17592186566322} :activity/id #uuid "2e158a7f-51b3-581a-b996-045e00f882e4" :activity/steps [{:db/id #edb/ref 17592186566322 :step/content {:assigned-problem/content {:db/id #edb/ref 17592186566196 :multistep/context "A company produces two types of products, type A and type B. The revenue function of the company, in thousands of dollars, is given by $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)=2{x}^{4}+8{x}^{2}{y}^{2}-8{x}^{2}+6{y}^{2}-1,\n$$\n\nwhere $x={[\\begin{aligned}\\,x & y\\,\\end{aligned}]}^{T},$ $x$ is the price (in thousands of dollars) per unit of product A, and $y$ is the price (in thousands of dollars) per unit of product B. The company can adjust the prices per unit for both types of products by adding or removing certain features." :multistep/first-step {:db/id #edb/ref 17592186566278} :multistep/id #uuid "d9a60175-ea7e-5ff5-a696-1e759f0e8e78" :multistep/steps [{:db/id #edb/ref 17592186566278 :step/content {:db/id #edb/ref 17592186566225 :question/id #uuid "4d7ebf34-a035-5c2e-ad76-841acaa3c221" :question/math-academy-id "q-168886"} :step/id #uuid "0f155874-d644-5c6d-a1bc-950a7f264867" :step/next {:db/id #edb/ref 17592186566288}} {:db/id #edb/ref 17592186566281 :step/content {:db/id #edb/ref 17592186566270 :question/id #uuid "ed3eb4a9-71c7-55f2-a5c3-dcaf4e7245dc" :question/math-academy-id "q-168890"} :step/id #uuid "11cf8195-97e7-51c0-b62c-f526c31dc712" :step/next {:db/id #edb/ref 17592186566298}} {:db/id #edb/ref 17592186566288 :step/content {:db/id #edb/ref 17592186566263 :question/id #uuid "c7c3402d-fbe9-5875-8d06-b63e54fe220e" :question/math-academy-id "q-168887"} :step/id #uuid "4f476aaa-d1ae-51b7-98e7-b3b01846bd0c" :step/next {:db/id #edb/ref 17592186566293}} {:db/id #edb/ref 17592186566293 :step/content {:db/id #edb/ref 17592186566206 :question/id #uuid "187224fe-1282-5974-b5d9-f692bdbb4202" :question/math-academy-id "q-168888"} :step/id #uuid "58d0d71f-5f0f-5b59-82c6-8d354187fa5e" :step/next {:db/id #edb/r