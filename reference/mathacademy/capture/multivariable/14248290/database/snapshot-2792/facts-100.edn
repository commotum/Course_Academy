aca64-f3ac-5a3a-837c-b8cb8fa44772" #edb/ref 17592186045417] [17592186193661 #edb/ref 1063 #edb/ref 17592186192785 #edb/ref 17592186045417] [17592186193671 #edb/ref 1058 #edb/ref 17592186193661 #edb/ref 17592186045417] [17592186193671 #edb/ref 1061 41983 #edb/ref 17592186045417] [17592186193671 #edb/ref 1062 #uuid "2a951cc5-70fa-5cd6-a379-4cfe861c71d4" #edb/ref 17592186045417] [17592186193671 #edb/ref 1063 #edb/ref 17592186192790 #edb/ref 17592186045417] [17592186193672 #edb/ref 1058 #edb/ref 17592186193671 #edb/ref 17592186045417] [17592186193672 #edb/ref 1061 41989 #edb/ref 17592186045417] [17592186193672 #edb/ref 1062 #uuid "c3b7bd9a-f6d4-521a-ab11-4ff2cecfbe07" #edb/ref 17592186045417] [17592186193672 #edb/ref 1063 #edb/ref 17592186193890 #edb/ref 17592186045417] [17592186193680 #edb/ref 1058 #edb/ref 17592186193698 #edb/ref 17592186045417] [17592186193680 #edb/ref 1061 42238 #edb/ref 17592186045417] [17592186193680 #edb/ref 1062 #uuid "4bae0aea-9643-5e83-9379-45ac0682c9ca" #edb/ref 17592186045417] [17592186193680 #edb/ref 1063 #edb/ref 17592186192794 #edb/ref 17592186045417] [17592186193698 #edb/ref 1058 #edb/ref 17592186193660 #edb/ref 17592186045417] [17592186193698 #edb/ref 1061 44640 #edb/ref 17592186045417] [17592186193698 #edb/ref 1062 #uuid "1014e39c-1f7c-5989-8916-134b9e90b165" #edb/ref 17592186045417] [17592186193698 #edb/ref 1063 #edb/ref 17592186193907 #edb/ref 17592186045417] [17592186193890 #edb/ref 1064 "We can use the chain, product, and quotient rules to find partial derivatives of multivariable functions. \n\nFor example, consider the following function: \n\n$$\nf(x,y) = \\cos(xy^2) + 3x\n$$\n\nTo compute the partial derivative of $f$ with respect to $x,$ we \"fix\" the variable ${\\color{blue}y}$ (in other words, we treat ${\\color{blue}y}$ as if it were constant). Then, we take the derivative with respect to $x,$ as usual.\n\nFirst, we use the sum rule for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\operatorname{cos}⁡(x{y}^{2})+3x) \\\\  & =\\frac{∂}{∂x}(\\operatorname{cos}⁡(x{y}^{2}))+\\frac{∂}{∂x}(3x)\\end{aligned}\n$$\n\nNow, we use the chain rule and the constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}(\\operatorname{cos}⁡(x{y}^{2}))+\\frac{∂}{∂x}(3x) & =-\\operatorname{sin}⁡(x{y}^{2})\\cdot \\frac{∂}{∂x}(x{y}^{2})+\\frac{∂}{∂x}(3x) \\\\  & =-\\operatorname{sin}⁡(x{y}^{2})\\cdot {y}^{2}\\cdot \\frac{∂}{∂x}(x)+3\\cdot \\frac{∂}{∂x}(x) \\\\  & =-\\operatorname{sin}⁡(x{y}^{2})\\cdot {y}^{2}\\cdot 1+3\\cdot 1 \\\\  & =3-{y}^{2}\\operatorname{sin}⁡(x{y}^{2})\\end{aligned}\n$$\n\nTo compute the partial derivative of $f$ with respect to $y,$ we \"fix\" the variable ${\\color{blue}x}$ (in other words, we treat ${\\color{blue}x}$ as if it were constant). Then, we take the derivative with respect to $y,$ as usual.\n\nFirst, we use the sum rule for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\operatorname{cos}⁡(x{y}^{2})+3x) \\\\  & =\\frac{∂}{∂y}(\\operatorname{cos}⁡(x{y}^{2}))+\\frac{∂}{∂y}(3x)\\end{aligned}\n$$\n\nNow, we use the chain rule and the constant multiple rules for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\operatorname{cos}⁡(x{y}^{2}))+\\frac{∂}{∂y}(3x) & =-\\operatorname{sin}⁡(x{y}^{2})\\cdot \\frac{∂}{∂y}(x{y}^{2})+\\frac{∂}{∂y}(3x) \\\\  & =-\\operatorname{sin}⁡(x{y}^{2})\\cdot x\\cdot \\frac{∂}{∂y}({y}^{2})+0 \\\\  & =-\\operatorname{sin}⁡(x{y}^{2})\\cdot x\\cdot 2y \\\\  & =-2xy\\operatorname{sin}⁡(x{y}^{2})\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186193890 #edb/ref 1065 6937 #edb/ref 17592186045417] [17592186193890 #edb/ref 1066 #uuid "66f2199e-b3f8-5590-80f3-bbac79027096" #edb/ref 17592186045417] [17592186193890 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186193907 #edb/ref 1064 "We can also compute partial derivatives of functions with three or even more variables. \n\nFor example, suppose we have the function $f(x,y,z).$ We find its partial derivatives as follows:\n\n- To compute $\\dfrac{\\partial f}{\\partial x},$ we differentiate with respect to $x,$ treating $y$ *and* $z$ as constants.\n\n- To compute $\\dfrac{\\partial f}{\\partial y},$ we differentiate with respect to $y,$ treating $x$ *and* $z$ as constants.\n\n- To compute $\\dfrac{\\partial f}{\\partial z},$ we differentiate with respect to $z,$ treating $x$ *and* $y$ as constants.\n\nLet's see an example." #edb/ref 17592186045417] [17592186193907 #edb/ref 1065 7692 #edb/ref 17592186045417] [17592186193907 #edb/ref 1066 #uuid "c87e2fef-e77f-5c67-a502-0d900d85ee40" #edb/ref 17592186045417] [17592186193907 #edb/ref 1067 "Partial Derivatives of Three-Variable Functions" #edb/ref 17592186045417] [17592186198411 #edb/ref 1037 #edb/ref 17592186049809 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186198634 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186198642 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186235543 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186281579 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186281580 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186281581 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186367755 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186367762 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186389381 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186389388 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186389395 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186427518 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186434997 #edb/ref 17592186045417] [17592186198411 #edb/ref 1038 #edb/ref 17592186566263 #edb/ref 17592186045417] [17592186198411 #edb/ref 1039 "Finding the Derivative of a Scalar Function" #edb/ref 17592186045417] [1759218