#{[{:activity/course {:db/id #edb/ref 17592186046668} :activity/first-step {:db/id #edb/ref 17592186563795} :activity/id #uuid "0cd59e01-3499-5e0d-9dff-47c2f8678675" :activity/scope {:db/id #edb/ref 17592186049052 :topic/id #uuid "d5eeaed9-a618-5662-a81f-c1e67aebd8d7" :topic/math-academy-id 3264} :activity/steps [{:db/id #edb/ref 17592186563769 :step/content {:db/id #edb/ref 17592186563651 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09596fbb-5f17-590f-b8c6-41aea4206883" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}\\operatorname{arcoth}⁡(\\frac{3x+2}{4})+C" :db/id #edb/ref 17592186562958} {:answer/id #uuid "85052561-0afa-5d49-a8cd-46da05f90e90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12}\\operatorname{arcoth}⁡(\\frac{3x+2}{4})+C" :db/id #edb/ref 17592186563244} {:answer/id #uuid "8adcb99e-b119-5618-808f-7b0725c00dbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{16}\\operatorname{arcoth}⁡(3x+2)+C" :db/id #edb/ref 17592186563254} {:answer/id #uuid "e08a4d2f-d017-5f6c-b6cc-e8a0f88c0fb9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12}\\operatorname{arcoth}⁡(3x+2)+C" :db/id #edb/ref 17592186563438} {:answer/id #uuid "e861d624-48ec-543a-aaf6-deee37e2e5ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{arcoth}⁡(\\frac{3x+2}{4})+C" :db/id #edb/ref 17592186563464}] :answer-field/correct {:db/id #edb/ref 17592186563244} :answer-field/id #uuid "4fbff315-ecc9-5c1a-aaa6-d1781060ca7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563564}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1369cbfd-a46c-5064-baa1-cbe5720fb540" :question/math-academy-id "q-97910" :question/problem "Calculate $\\int \\frac{1}{16-(3x+2)^{2}}\\,\\text{d}x=$" :question/worked-solution "First, we note that\n\n$$\n\\int \\frac{1}{16-(3x+2)^{2}}\\,\\text{d}x=\\int \\frac{1}{16-16(\\frac{1}{16}(3x+2)^{2})}\\,\\text{d}x=\\frac{1}{16}\\int \\frac{1}{1-{(\\frac{1}{4}(3x+2))}^{2}}\\,\\text{d}x.\n$$\n\nLet $u=\\frac{1}{4}(3x+2).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{3}{4}\\,⟹\\,\\text{d}x=\\frac{4}{3}\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{16}\\int \\frac{1}{1-{(\\frac{1}{4}(3x+2))}^{2}}\\,\\text{d}x & =\\frac{1}{16}\\int \\frac{1}{1-{u}^{2}}\\,\\cdot \\frac{4}{3}\\,\\text{d}u \\\\  & =\\frac{1}{12}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{12}\\operatorname{arcoth}⁡(\\frac{3x+2}{4})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{3x+2}{4}|>1.$"} :step/id #uuid "227deb9f-a9be-5caf-9b21-75db4f696e28"} {:db/id #edb/ref 17592186563781 :step/content {:db/id #edb/ref 17592186563668 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a472c55-b621-565c-b578-f92c20cbb266" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arsech}⁡(\\frac{x-5}{\\sqrt{2}})+C" :db/id #edb/ref 17592186563146} {:answer/id #uuid "6b7d1c78-ae26-55ef-86e8-9c531b3f1a3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{2}}{2}\\operatorname{arcsch}⁡(\\frac{x-5}{\\sqrt{2}})+C" :db/id #edb/ref 17592186563193} {:answer/id #uuid "bf7b4cd4-4878-5393-9a31-5c5c09f3bcdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{2}\\operatorname{arcsch}⁡(\\frac{x-5}{\\sqrt{2}})+C" :db/id #edb/ref 17592186563367} {:answer/id #uuid "ddb986c7-c26a-5de1-8745-8a63847438c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}\\operatorname{arsech}⁡(\\frac{x-5}{\\sqrt{2}})+C" :db/id #edb/ref 17592186563431} {:answer/id #uuid "fba7141a-d135-5744-8bbd-0158aa2f9308" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{arcsch}⁡(\\frac{x-5}{\\sqrt{2}})+C" :db/id #edb/ref 17592186563508}] :answer-field/correct {:db/id #edb/ref 17592186563508} :answer-field/id #uuid "0b36eef3-f0c2-5b45-97f7-a2607c73a159" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563522}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "38a6fd7f-85a4-5b9d-9914-3bd5a2ab420c" :question/math-academy-id "q-97904" :question/problem "$\\int \\frac{\\sqrt{2}}{|x-5|\\sqrt{{x}^{2}-10x+27}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-10x+27 & ={x}^{2}-2\\cdot 5x+{5}^{2}-{5}^{2}+27 \\\\  & =(x-5)^{2}+2\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{2}}{|x-5|\\sqrt{{x}^{2}-10x+27}}\\,\\text{d}x & =\\int \\frac{\\sqrt{2}}{|x-5|\\sqrt{2+(x-5)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|\\frac{x-5}{\\sqrt{2}}|\\sqrt{2+2{(\\frac{x-5}{\\sqrt{2}})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{2}}\\int \\frac{1}{|\\frac{x-5}{\\sqrt{2}}|\\sqrt{1+{(\\frac{x-5}{\\sqrt{2}})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=\\frac{x-5}{\\sqrt{2}}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{2}}\\,⟹\\,\\text{d}x=\\sqrt{2}\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{1}{\\sqrt{2}}\\int \\frac{1}{|\\frac{x-5}{\\sqrt{2}}|\\sqrt{1+{(\\frac{x-5}{\\sqrt{2}})}^{2}}}\\text{d}x & =\\frac{1}{\\sqrt{2}}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\cdot \\sqrt{2}\\,\\text{d}u \\\\  & =\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-\\operatorname{arcsch}⁡u+C \\\\  & =-\\operatorname{arcsch}⁡(\\frac{x-5}{\\sqrt{2}})+C.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "49d1f9ce-7282-5ee1-8586-6e53e7242013" :step/next {:db/id #edb/ref 17592186563798}} {:db/id #edb/ref 17592186563795 :step/content {:db/id #edb/ref 17592186563720 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cb145f1-f9ae-5d5e-9acb-c2e8557eb522" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}\\operatorname{arcsch}⁡(\\frac{x+2}{2})+C" :db/id #edb/ref 17592186562967} {:answer/id #uuid "259a3844-82ae-5b24-a85f-f38b2f21f870" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{4}\\operatorname{arsech}⁡(\\frac{x+2}{2})+C" :db/id #edb/ref 17592186563031} {:answer/id #uuid "4e03b87e-8d9e-547f-803e-f3b920ae8222" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{arcsch}⁡(\\frac{x+2}{2})+C" :db/id #edb/ref 17592186563122} {:answer/id #uuid "aa279346-be14-5108-9c91-ebb49fea3432" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}\\operatorname{arsech}⁡(\\frac{x+2}{2})+C" :db/id #edb/ref 17592186563328} {:answer/id #uuid "bb94fb36-58d4-5f5c-9e67-67e40c60505c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4\\operatorname{arsech}⁡(\\frac{x+2}{2})+C" :db/id #edb/ref 17592186563356}] :answer-field/correct {:db/id #edb/ref 17592186563328} :answer-field/id #uuid "0526b46b-564d-561d-a9aa-fedc41539160" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563520}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a95ee677-1642-5975-8b50-8432d56de160" :question/math-academy-id "q-97770" :question/problem "$\\int \\frac{1}{(x+2)\\sqrt{-{x}^{2}-4x}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-4x & =-({x}^{2}+4x) \\\\  & =-({x}^{2}+2\\cdot 2x+{2}^{2}-{2}^{2}) \\\\  & =-((x+2)^{2}-4) \\\\  & =4-(x+2)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{(x+2)\\sqrt{-{x}^{2}-4x}}\\text{d}x & =\\int \\frac{1}{(x+2)\\sqrt{4-(x+2)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{2(x+2)\\sqrt{1-{(\\frac{x+2}{2})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{(\\frac{x+2}{2})\\sqrt{1-{(\\frac{x+2}{2})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=\\frac{x+2}{2}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{(x+2)\\sqrt{-{x}^{2}-4x}}\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{(\\frac{x+2}{2})\\sqrt{1-{(\\frac{x+2}{2})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot 2\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{arsech}⁡(\\frac{x+2}{2})+C.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "9ddb5345-ef98-5ee3-a8a7-421a3b7a527f" :step/next {:db/id #edb/ref 17592186563802}} {:db/id #edb/ref 17592186563798 :step/content {:db/id #edb/ref 17592186563699 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a909a9b-174b-5639-8410-d7e274a5815f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}\\operatorname{arsech}⁡(x+2)+C" :db/id #edb/ref 17592186563147} {:answer/id #uuid "6890919f-3dff-518f-b537-36ec02be3bc0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}\\operatorname{arcsch}⁡(x+2)+C" :db/id #edb/ref 17592186563186} {:answer/id #uuid "7f16f630-7db7-5f3c-9f65-39971597a4cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}\\operatorname{arcsch}⁡(x+2)+C" :db/id #edb/ref 17592186563223} {:answer/id #uuid "ba54fe97-ce78-59e0-ba7b-9401d786d8de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{arcsch}⁡(x+2)+C" :db/id #edb/ref 17592186563353} {:answer/id #uuid "e66f808f-00b9-5dfa-be64-b5ad0a17a5cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\operatorname{arsech}⁡(x+2)+C" :db/id #edb/ref 17592186563451}] :answer-field/correct {:db/id #edb/ref 17592186563353} :answer-field/id #uuid "96a55f92-f39f-5881-94c0-2f84b4c3471a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563598}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6a55ffae-eeb7-54cf-a5ce-c644ed8a6a5a" :question/math-academy-id "q-97905" :question/problem "$\\int -\\frac{15}{|5x+10|\\sqrt{{x}^{2}+4x+5}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}+4x+5 & ={x}^{2}+2\\cdot 2x+{2}^{2}-{2}^{2}+5 \\\\  & =(x+2)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int -\\frac{15}{|5x-10|\\sqrt{{x}^{2}+4x+5}}\\,\\text{d}x=-\\int \\frac{15}{5|x+2|\\sqrt{1+(x+2)^{2}}}\\,\\text{d}x=-3\\int \\frac{1}{|x+2|\\sqrt{1+(x+2)^{2}}}\\,\\text{d}x.\n$$\n\nLet $u=x+2.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}-3\\int \\frac{1}{|x+2|\\sqrt{1+(x+2)^{2}}}\\text{d}x & =-3\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =3\\operatorname{arcsch}⁡u+C \\\\  & =3\\operatorname{arcsch}⁡(x+2)+C.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "aaa68476-6aa2-5a3d-89b3-b111ae8473a4" :step/next {:db/id #edb/ref 17592186563769}} {:db/id #edb/ref 17592186563802 :step/content {:db/id #edb/ref 17592186563744 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1065a3b5-7eb0-5108-b4e2-8a64406d6063" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsch}⁡(\\frac{x+3}{3})+C" :db/id #edb/ref 17592186562978} {:answer/id #uuid "39d34837-ebfe-5409-b1ab-da122aa01d5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\operatorname{arsech}⁡(\\frac{x+3}{3})+C" :db/id #edb/ref 17592186563075} {:answer/id #uuid "4c246a52-305e-5adb-972f-c828583b7f6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}\\operatorname{arcsch}⁡(\\frac{x+3}{3})+C" :db/id #edb/ref 17592186563115} {:answer/id #uuid "7b8de859-a1f8-5dd2-834f-fa91b60b37c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3\\operatorname{arsech}⁡(\\frac{x+3}{3})+C" :db/id #edb/ref 17592186563215} {:answer/id #uuid "b61c450a-f091-5a01-bd84-81b3a853a9d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}\\operatorname{arsech}⁡(\\frac{x+3}{3})+C" :db/id #edb/ref 17592186563347}] :answer-field/correct {:db/id #edb/ref 17592186563075} :answer-field/id #uuid "a1d9e3fb-7750-5a4b-a417-c4a5e9cfd326" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186563606}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d6b27f7b-e94e-5d63-abcb-feb8d8bed4dd" :question/math-academy-id "q-97777" :question/problem "$\\int \\frac{3}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-6x & =-({x}^{2}+6x) \\\\  & =-({x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}) \\\\  & =-((x+3)^{2}-9) \\\\  & =9-(x+3)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{3}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x & =\\int \\frac{3}{(x+3)\\sqrt{9-{(x+3)}^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{(\\frac{x+3}{3})\\sqrt{9-9{(\\frac{x+3}{3})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{(\\frac{x+3}{3})\\sqrt{1-{(\\frac{x+3}{3})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=\\frac{x+3}{3}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{(\\frac{x+3}{3})\\sqrt{1-{(\\frac{x+3}{3})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot 3\\,\\text{d}u \\\\  & =\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =-\\operatorname{arsech}⁡u+C \\\\  & =-\\operatorname{arsech}⁡(\\frac{x+3}{3})+C.\\end{aligned}\\end{aligned}\n$$"} :step/id #uuid "b873437c-8a91-5a52-b7b4-61177581823b" :step/next {:db/id #edb/ref 17592186563781}}] :activity/title "Integration Using Inverse Reciprocal Hyperbolic Functions and Completing the Square" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186562923}]}
