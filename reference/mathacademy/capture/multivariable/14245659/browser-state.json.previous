" columnalign=\"right\" columnspacing=\"\" rowspacing=\"3pt\"><mtr><mtd><mtable rowspacing=\"1em 1em 1em\" columnspacing=\"0.278em\" displaystyle=\"true\" columnalign=\"right left\"><mtr><mtd><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow><mo data-mjx-texclass=\"OP\">∫</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mo stretchy=\"false\">|</mo><mi>x</mi><mo>+</mo><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><msqrt><mn>1</mn><mo>+</mo><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><mn>2</mn><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></msqrt></mrow></mfrac></mstyle><mtext>d</mtext><mi>x</mi></mtd><mtd><mo>=</mo><mo>−</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow><mo data-mjx-texclass=\"OP\">∫</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><mrow><mo stretchy=\"false\">|</mo><mi>u</mi><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">|</mo></mrow><msqrt><mn>1</mn><mo>+</mo><msup><mi>u</mi><mn>2</mn></msup></msqrt></mrow></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>u</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow><mi>arcsch</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>u</mi><mo>+</mo><mi>C</mi></mtd></mtr><mtr><mtd></mtd><mtd><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow><mi>arcsch</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><mn>2</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mi>C</mi><mo>.</mo></mtd></mtr></mtable></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
