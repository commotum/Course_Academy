#{[{:db/id #edb/ref 17592186531626 :knowledge-point/_questions [{:db/id #edb/ref 17592186092373 :knowledge-point/id #uuid "cd0b4da9-1a0f-5a46-aff1-3ce5c0cebb3b" :knowledge-point/title "Creating an Integral Expression For the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a09810-6e1e-5a7f-a496-a308672d8fe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186530902} {:answer/id #uuid "70d61664-e8b3-5d91-831f-2ef5a133d2af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2-\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531115} {:answer/id #uuid "75c79860-2158-5faa-be6a-5b9aa2eb7054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1-\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531123} {:answer/id #uuid "931cc387-4c8e-5435-8982-a4705188d119" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531181} {:answer/id #uuid "ad39fb78-7dc8-5c7f-b6cd-c9732f59d8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531238}] :answer-field/correct {:answer/id #uuid "ad39fb78-7dc8-5c7f-b6cd-c9732f59d8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186531238} :answer-field/id #uuid "452ad711-f8a6-5c7b-b980-01feac5bbbde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531443}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a1c1460f-c5a2-5e99-b7f7-17db73e707c6" :question/math-academy-id "q-103828" :question/problem "Which of the following gives the arc length of the polar curve $r=1-\\operatorname{sin}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{4}?$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1-\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-\\operatorname{cos}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(1-\\operatorname{sin}⁡\\theta )^{2}+(-\\operatorname{cos}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(1-2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta )+{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1-2\\operatorname{sin}⁡\\theta +1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{2-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186531628 :knowledge-point/_questions [{:db/id #edb/ref 17592186092374 :knowledge-point/id #uuid "84a533e8-9a7c-58f3-9d3c-7c08b3c6bfd1" :knowledge-point/title "Finding the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "901a723b-e6e5-572f-9b48-3f4f2a4dea43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186531175}] :answer-field/correct {:answer/id #uuid "901a723b-e6e5-572f-9b48-3f4f2a4dea43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186531175} :answer-field/id #uuid "3487b8fc-2024-52a0-8191-9d6c368ac790" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186531427}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9290c4e-ece3-5a58-aecc-bb62b4894116" :question/math-academy-id "q-353582" :question/problem "![](images/83/83813bff1ff86036e2773d9476150de619688daec9cae2623a555a43290cace3.png)\n\nFind the arc length $L$ of the polar curve $r=3\\operatorname{sin}⁡\\theta $ for $\\frac{\\pi }{2}\\le \\theta \\le \\frac{5\\pi }{6}$ (shown in blue in the diagram above). Do not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=3\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=3\\operatorname{cos}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{{(3\\operatorname{sin}⁡\\theta )}^{2}+{(3\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{9{sin}^{2}⁡\\theta +9{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{9}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}3\\,\\text{d}\\theta  \\\\  & =3\\theta \\,{|}_{\\pi /2}^{5\\pi /6} \\\\  & =3(\\frac{5\\pi }{6}-\\frac{\\pi }{2}) \\\\  & =\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186531606 :knowledge-point/_questions [{:db/id #edb/ref 17592186092374 :knowledge-point/id #uuid "84a533e8-9a7c-58f3-9d3c-7c08b3c6bfd1" :knowledge-point/title "Finding the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebc83588-25b8-5ff4-bfc0-bce39c4a0f4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{10}(e^{\\pi}-1)" :db/id #edb/ref 17592186531337}] :answer-field/correct {:answer/id #uuid "ebc83588-25b8-5ff4-bfc0-bce39c4a0f4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{10}(e^{\\pi}-1)" :db/id #edb/ref 17592186531337} :answer-field/id #uuid "0d00646e-dd97-589c-8e21-634590dfdfc6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186531395}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ddfe515-d085-541a-8dab-b3a5ab40f555" :question/math-academy-id "q-353601" :question/problem "![](images/ec/ec0b88ec00ef7e7061af0b08761eb73f05a5f669208babacbd4eb86736019230.png)\n\nFind the arc length $L$ of the polar curve $r=6{e}^{3\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{3}$ (shown in blue in the diagram above). Do not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=6{e}^{3\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=18{e}^{3\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{{(6{e}^{3\\theta })}^{2}+{(18{e}^{3\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{36{e}^{6\\theta }+324{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{360{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & =6\\sqrt{10}{\\int }_{0}^{\\pi /3}{e}^{3\\theta }\\,\\text{d}\\theta  \\\\  & =6\\sqrt{10}{[\\frac{1}{3}{e}^{3\\theta }]}_{0}^{\\pi /3} \\\\  & =2\\sqrt{10}{[{e}^{3\\theta }]}_{0}^{\\pi /3} \\\\  & =2\\sqrt{10}({e}^{\\pi }-{e}^{0}) \\\\  & =2\\sqrt{10}({e}^{\\pi }-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186531644 :knowledge-point/_questions [{:db/id #edb/ref 17592186092374 :knowledge-point/id #uuid "84a533e8-9a7c-58f3-9d3c-7c08b3c6bfd1" :knowledge-point/title "Finding the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce61a52-02f8-52e3-833d-f0a747be827a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{\\sqrt{1+\\operatorname{ln}⁡2}}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186530920} {:answer/id #uuid "25efba17-6780-5d23-af19-6462827fe365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186530950} {:answer/id #uuid "44549959-713e-5a87-987f-4262b4d5d3c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{\\sqrt{2}}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186531009} {:answer/id #uuid "ca7da443-446d-582f-b934-dcaf57f4a7d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186531287} {:answer/id #uuid "d25fbccb-dafe-5557-83e3-f260cee1b53a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186531298}] :answer-field/correct {:answer/id #uuid "25efba17-6780-5d23-af19-6462827fe365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1)" :db/id #edb/ref 17592186530950} :answer-field/id #uuid "2a4caf7b-52fc-5e88-b891-82cc9a3a2cf7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531417}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "da080066-6980-5e46-a310-b96dc7f7120c" :question/math-academy-id "q-9540" :question/problem "![](images/c1/c1bf9d989f1fbaeda90325b924f2c9285cd4e37e1948ba63256258b0a84c7e44.png)\n\nFind the arc length of the polar curve $r={2}^{\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{2}$ (shown in blue in the diagram above)." :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={2}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }={2}^{\\theta }\\operatorname{ln}⁡2.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{({2}^{\\theta })}^{2}+{({2}^{\\theta }\\operatorname{ln}⁡2)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{2}^{2\\theta }+{2}^{2\\theta }{ln}^{2}⁡2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(1+{ln}^{2}⁡2){2}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡2}{\\int }_{0}^{\\pi /2}{2}^{\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡2}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\cdot {2}^{\\theta }{|}_{0}^{\\pi /2} \\\\  & =\\sqrt{1+{ln}^{2}⁡2}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\cdot ({2}^{\\pi /2}-{2}^{0}) \\\\  & =\\frac{\\sqrt{1+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186531565 :knowledge-point/_questions [{:db/id #edb/ref 17592186092374 :knowledge-point/id #uuid "84a533e8-9a7c-58f3-9d3c-7c08b3c6bfd1" :knowledge-point/title "Finding the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138e119b-9f29-5728-b024-f296e1407436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({3}^{\\pi }-1)" :db/id #edb/ref 17592186530898} {:answer/id #uuid "4c63f797-f964-543b-8948-8fa3ef071043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{\\operatorname{ln}⁡3}({3}^{\\pi }+1)" :db/id #edb/ref 17592186531027} {:answer/id #uuid "6b6ad79e-00af-5e1d-b171-f99e8a87b59c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3}{\\sqrt{1+\\operatorname{ln}⁡3}}({3}^{\\pi }-1)" :db/id #edb/ref 17592186531103} {:answer/id #uuid "a24f9d67-8d4f-5f04-a33c-d625d9ff53b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}({3}^{\\pi }-1)" :db/id #edb/ref 17592186531215} {:answer/id #uuid "ee47508c-c5ac-50f6-8486-05ab49b69007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{ln}^{2}⁡3}}{\\operatorname{ln}⁡3}({3}^{\\pi }-1)" :db/id #edb/ref 17592186531346}] :answer-field/correct {:answer/id #uuid "ee47508c-c5ac-50f6-8486-05ab49b69007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{ln}^{2}⁡3}}{\\operatorname{ln}⁡3}({3}^{\\pi }-1)" :db/id #edb/ref 17592186531346} :answer-field/id #uuid "770387f5-8ab3-56b6-9ab8-582f315d1f1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186531469}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1bd5daf3-8ee2-5ee2-ae53-b882ce969a04" :question/math-academy-id "q-9541" :question/problem "Find the arc length of the polar curve $r={3}^{\\theta }$ for $0\\le \\theta \\le \\pi .$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={3}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }={3}^{\\theta }\\operatorname{ln}⁡3.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{({3}^{\\theta })}^{2}+{({3}^{\\theta }\\operatorname{ln}⁡3)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{3}^{2\\theta }+{3}^{2\\theta }{ln}^{2}⁡3}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{(1+{ln}^{2}⁡3){3}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡3}{\\int }_{0}^{\\pi }{3}^{\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡3}\\cdot \\frac{1}{\\operatorname{ln}⁡3}\\cdot {3}^{\\theta }{|}_{0}^{\\pi } \\\\  & =\\sqrt{1+{ln}^{2}⁡3}\\cdot \\frac{1}{\\operatorname{ln}⁡3}\\cdot ({3}^{\\pi }-{3}^{0}) \\\\  & =\\frac{\\sqrt{1+{ln}^{2}⁡3}}{\\operatorname{ln}⁡3}({3}^{\\pi }-1).\\end{aligned}\n$$"}]}
