      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14117154/observations/step-q161693-7b731eb79086a66edaa6.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14117154/observations/step-q161693-7b731eb79086a66edaa6.png",
      "source_url": "https://mathacademy.com/tasks/14117154/topics/2053/lesson",
      "captured_at": 1791720701.7420173,
      "math_academy_id": "q-161693",
      "topic_id": "2053",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q161693",
        "placement_id": null,
