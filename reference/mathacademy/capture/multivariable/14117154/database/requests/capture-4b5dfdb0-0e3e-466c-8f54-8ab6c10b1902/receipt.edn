9534146 17592186045417 true] [17592186412192 1076 #edb/ref 17592186045493 13194139534146 17592186045417 true] [17592186412192 1077 "selection" 13194139534146 17592186045417 true] [17592186412192 1078 #edb/ref 17592186412086 13194139534146 17592186045417 true] [17592186412192 1079 #uuid "f31a7306-1b8a-5b78-bf95-372025264fa5" 13194139534146 17592186045417 true] [17592186412193 1068 #edb/ref 17592186412181 13194139534146 17592186045417 true] [17592186412193 1069 "q-161682" 13194139534146 17592186045417 true] [17592186412193 1070 #edb/ref 17592186045487 13194139534146 17592186045417 true] [17592186412193 1071 "Find the volume of the solid region enclosed by the surfaces $x=-{z}^{2}$ and $x=\\sqrt{y},$ and the planes $y=0,$ $y=1,$ $z=-1,$ $z=2.$" 13194139534146 17592186045417 true] [17592186412193 1072 #uuid "248b6467-c247-56b8-869d-ac65691d4383" 13194139534146 17592186045417 true] [17592186412193 1074 "Notice that our solid can be written as a type II region: \n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le 1,\\,\\,-1\\le z\\le 2,\\,\\,-{z}^{2}\\le x\\le \\sqrt{y}}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{2}{\\int }_{-{z}^{2}}^{\\sqrt{y}}dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{2}[x]_{x=-{z}^{2}}^{x=\\sqrt{y}}\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{2}\\sqrt{y}-(-{z}^{2})\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{2}\\sqrt{y}+{z}^{2}\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{[z\\sqrt{y}+\\frac{1}{3}{z}^{3}]}_{z=-1}^{z=2}\\,dy \\\\  & ={\\int }_{0}^{1}(2-(-1))\\sqrt{y}+\\frac{1}{3}({2}^{3}-(-1)^{3})\\,dy \\\\  & ={\\int }_{0}^{1}3\\sqrt{y}+3\\,dy \\\\  & ={[2\\sqrt{{y}^{3}}+3y]}_{y=0}^{y=1} \\\\  & =2\\sqrt{{1}^{3}}+3(1)-0 \\\\  & =2+3 \\\\  & =5\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412194 1068 #edb/ref 17592186412176 13194139534146 17592186045417 true] [17592186412194 1069 "q-161741" 13194139534146 17592186045417 true] [17592186412194 1070 #edb/ref 17592186045487 13194139534146 17592186045417 true] [17592186412194 1071 "![](images/da/daedf62c68ba62dee844cf17efc2d767da47a06ceccaedde854779f542b90114.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the front and right ones, are parallel to the corresponding coordinate planes.*" 13194139534146 17592186045417 true] [17592186412194 1072 #uuid "2c5e175a-7b49-566c-a1ad-cebab486783a" 13194139534146 17592186045417 true] [17592186412194 1074 "![](images/7c/7c1738e97bc16a32f86d6901136afc4d9e288035d170fcd640db340ad36d19c5.png)\n\n \n\nNotice that our solid can be written as the type II region\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le 2-\\frac{1}{3}y-\\frac{1}{2}z},\n$$\n\nwhere $D$ is the projection of $R$ onto the $yz$-plane.\n\nTo find the top boundary curve of $D$ in the form $z=z(y),$ we substitute $x=1$ into the equation $x=2-\\frac{1}{3}y-\\frac{1}{2}z:$\n\n$$\n1=2-\\frac{1}{3}y-\\frac{1}{2}z\\,⟹\\,z=2-\\frac{2}{3}y\n$$\n\nThen, we have\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 3,\\,\\,0\\le z\\le 2-\\frac{2}{3}y},\n$$\n\nas shown below.\n\n![](images/ea/ea8b8397163309a11aa478fcc21ab53ee293c19f0d77a93b5c3d3472bb0eba70.png)\n\nHence, the type II representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le 3,\\,\\,0\\le z\\le 2-\\frac{2}{3}y,\\,\\,0\\le x\\le 2-\\frac{1}{3}y-\\frac{1}{2}z}.\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2-2y/3}{\\int }_{0}^{2-y/3-z/2}dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2-2y/3}[x]_{x=0}^{x=2-y/3-z/2}\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2-2y/3}(2-\\frac{y}{3}-\\frac{z}{2})-0\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2-2y/3}2-\\frac{y}{3}-\\frac{z}{2}\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{[(2-\\frac{y}{3})z-\\frac{{z}^{2}}{4}]}_{z=0}^{z=2-2y/3}\\,dy \\\\  & ={\\int }_{0}^{3}((2-\\frac{y}{3})(2-\\frac{2y}{3})-\\frac{1}{4}{(2-\\frac{2y}{3})}^{2})-0\\,dy \\\\  & ={\\int }_{0}^{3}(2-\\frac{2y}{3})((2-\\frac{y}{3})-\\frac{1}{4}(2-\\frac{2y}{3}))\\,dy \\\\  & ={\\int }_{0}^{3}(2-\\frac{2y}{3})(\\frac{3}{2}-\\frac{y}{6})\\,dy \\\\  & ={\\int }_{0}^{3}3-\\frac{4y}{3}+\\frac{{y}^{2}}{9}\\,dy \\\\  & ={[3y-\\frac{2{y}^{2}}{3}+\\frac{{y}^{3}}{27}]}_{y=0}^{y=3} \\\\  & =(3(3)-\\frac{2(3)^{2}}{3}+\\frac{{3}^{3}}{27})-0 \\\\  & =4.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412195 1068 #edb/ref 17592186412182 13194139534146 17592186045417 true] [17592186412195 1069 "q-161658" 13194139534146 17592186045417 true] [17592186412195 1070 #edb/ref 17592186045487 13194139534146 17592186045417 true] [17592186412195 1071 "Find the volume of the solid $R,$ given by\n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le 1,\\,0\\le z\\le y,\\,0\\le x\\le 3-y-z}.\n$$" 13194139534146 17592186045417 true] [17592186412195 1072 #uuid "341b5b80-395a-52ac-87f9-9ef65cfdd0e9" 13194139534146 17592186045417 true] [17592186412195 1074 "Notice that we have a three-dimensional type II region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{y}{\\int }_{0}^{3-y-z}\\,dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{y}[x]_{x=0}^{x=3-y-z}\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{y}3-y-z\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{[(3-y)z-\\frac{{z}^{2}}{2}]}_{z=0}^{z=y}\\,dy \\\\  & ={\\int }_{0}^{1}(3-y)y-\\frac{{y}^{2}}{2}\\,dy \\\\  & ={\\int }_{0}^{1}3y-\\frac{3}{2}{y}^{2}\\,dy \\\\  & ={[\\frac{3}{2}{y}^{2}-\\frac{1}{2}{y}^{3}]}_{y=0}^{y=1} \\\\  & =\\frac{3}{2}-\\frac{1}{2}-0 \\\\  & =1.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412196 1068 #edb/ref 17592186412189 13194139534146 17592186045417 true] [17592186412196 1069 "q-161703" 13194139534146 17592186045417 true] [17592186412196 1070 #edb/ref 17592186045486 13194139534146 17592186045417 true] [17592186412196 1071 "Consider the solid enclosed between the paraboloids $z=2+3{x}^{2}+2{y}^{2}$ and $z=4+{x}^{2}+{y}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-1}^{1}{\\int }_{a(x)}^{b(x)}\\,f(x,y)\\,dy\\,dx\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" 13194139534146 17592186045417 true] [17592186412196 1072 #uuid "3fb0f5ed-20e1-5a6f-bec1-d9ddd1ad73da" 13194139534146 17592186045417 true] [17592186412196 1074 "First, we need to determine the projection of the intersection of our surfaces onto the $xy$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}2+3{x}^{2}+2{y}^{2} & =4+{x}^{2}+{y}^{2} \\\\ 2{x}^{2}+{y}^{2} & =2\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $xy$-plane is an ellipse.\n\nNotice that our solid can be written as a type I region: \n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,\\,2+3{x}^{2}+2{y}^{2}\\le z\\le 4+{x}^{2}+{y}^{2}},\n$$\n\nwhere $D$ is the interior of the ellipse $2{x}^{2}+{y}^{2}=2.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{2+3{x}^{2}+2{y}^{2}}^{4+{x}^{2}+{y}^{2}}\\text{d}z]\\text{d}A \\\\  & ={∬}_{D}(4+{x}^{2}+{y}^{2})-(2+3{x}^{2}+2{y}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}2-2{x}^{2}-{y}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $y=-\\sqrt{2-2{x}^{2}},$ and\n\n- the upper part $y=\\sqrt{2-2{x}^{2}},$\n\nfor $-1\\le x\\le 1.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}2-2{x}^{2}-{y}^{2}\\,\\text{d}A & ={\\int }_{-1}^{1}{\\int }_{-\\sqrt{2-2{x}^{2}}}^{\\sqrt{2-2{x}^{2}}}\\,2-2{x}^{2}-{y}^{2}\\,dy\\,dx.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\sqrt{2-2{x}^{2}})}^{2}+{(\\sqrt{2-2{x}^{2}})}^{2}+(2-2{x}^{2}-{y}^{2}) \\\\  & =(2-2{x}^{2})+(2-2{x}^{2})+(2-2{x}^{2}-{y}^{2}) \\\\  & =6-6{x}^{2}-{y}^{2}.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412197 1068 #edb/ref 17592186412184 13194139534146 17592186045417 true] [17592186412197 1069 "q-161692" 13194139534146 17592186045417 true] [17592186412197 1070 #edb/ref 17592186045487 13194139534146 17592186045417 true] [17592186412197 1071 "![](images/f7/f7fe261b981f8c97a123675d1385237d62cdbb8c9976dc8c3f1841f073e497de.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the front one, are parallel to the corresponding coordinate planes.*" 13194139534146 17592186045417 true] [17592186412197 1072 #uuid "4ef656bf-166c-5181-a3cb-7a7a57c705a6" 13194139534146 17592186045417 true] [17592186412197 1074 "![](images/ca/ca8ce5a3ed7f3f164b348268cd0805e05df1e0ad8bf3381ca6368421ffe380cc.png)\n\n \n\nNotice that our solid can be written as the type II region\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le 2-y+2z},\n$$\n\nwhere\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 2,\\,\\,0\\le z\\le 3}\n$$\n\nis the projection of $R$ onto the $yz$-plane, shown below.\n\n![](images/52/52f67235db14b903955660728642ed6b00603a12f480501767a98058f47d157a.png)\n\nHence, the type II representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le 2,\\,\\,0\\le z\\le 3,\\,\\,0\\le x\\le 2-y+2z}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{3}{\\int }_{0}^{2-y+2z}dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{3}[x]_{x=0}^{x=2-y+2z}\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{3}(2-y+2z)-0\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{3}2-y+2z\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{[(2-y)z+{z}^{2}]}_{z=0}^{z=3}\\,dy \\\\  & ={\\int }_{0}^{2}((2-y)(3)+{3}^{2})-0\\,dy \\\\  & ={\\int }_{0}^{2}15-3y\\,dy \\\\  & ={[15y-\\frac{3}{2}{y}^{2}]}_{y=0}^{y=2} \\\\  & =(30-6)-0 \\\\  & =24.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412198 1068 #edb/ref 17592186412191 13194139534146 17592186045417 true] [17592186412198 1069 "q-38899" 13194139534146 17592186045417 true] [17592186412198 1070 #edb/ref 17592186045486 13194139534146 17592186045417 true] [17592186412198 1071 "Consider the solid enclosed between the paraboloids $z=-7+3{x}^{2}+2{y}^{2}$ and $z=1+{x}^{2}+{y}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-2}^{2}{\\int }_{a(x)}^{b(x)}\\,f(x,y)\\,dy\\,dx\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" 13194139534146 17592186045417 true] [17592186412198 1072 #uuid "59448eff-6a38-5971-9e73-20a5809538bf" 13194139534146 17592186045417 true] [17592186412198 1074 "First, we need to determine the projection of the intersection of our surfaces onto the $xy$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}-7+3{x}^{2}+2{y}^{2} & =1+{x}^{2}+{y}^{2} \\\\ 2{x}^{2}+{y}^{2} & =8\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $xy$-plane is an ellipse.\n\nNotice that our solid can be written as a type I region: \n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,\\,-7+3{x}^{2}+2{y}^{2}\\le z\\le 1+{x}^{2}+{y}^{2}},\n$$\n\nwhere $D$ is the interior of the ellipse $2{x}^{2}+{y}^{2}=8.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{-7+3{x}^{2}+2{y}^{2}}^{1+{x}^{2}+{y}^{2}}\\text{d}z]\\text{d}A \\\\  & ={∬}_{D}(1+{x}^{2}+{y}^{2})-(-7+3{x}^{2}+2{y}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}8-2{x}^{2}-{y}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $y=-\\sqrt{8-2{x}^{2}},$ and\n\n- the upper part $y=\\sqrt{8-2{x}^{2}},$\n\nfor $-2\\le x\\le 2.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}8-2{x}^{2}-{y}^{2}\\,\\text{d}A & ={\\int }_{-2}^{2}{\\int }_{-\\sqrt{8-2{x}^{2}}}^{\\sqrt{8-2{x}^{2}}}\\,8-2{x}^{2}-{y}^{2}\\,dy\\,dx.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\sqrt{8-2{x}^{2}})}^{2}+{(\\sqrt{8-2{x}^{2}})}^{2}+(8-2{x}^{2}-{y}^{2}) \\\\  & =(8-2{x}^{2})+(8-2{x}^{2})+(8-2{x}^{2}-{y}^{2}) \\\\  & =24-6{x}^{2}-{y}^{2}.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412199 1068 #edb/ref 17592186412192 13194139534146 17592186045417 true] [17592186412199 1069 "q-161679" 13194139534146 17592186045417 true] [17592186412199 1070 #edb/ref 17592186045485 13194139534146 17592186045417 true] [17592186412199 1071 "Find the volume of the solid region enclosed by the $xy$-plane and the plane $z=x+y+2,$ and the planes $x=-1,$ $x=0,$ $y=0,$ $y=1.$" 13194139534146 17592186045417 true] [17592186412199 1072 #uuid "5ddd03f9-52bb-5aac-ab6f-e8e23245dd8b" 13194139534146 17592186045417 true] [17592186412199 1074 "Notice that our solid can be written as a type I region: \n\n$$\nR={(x,y,z)\\,:\\,-1\\le x\\le 0,\\,\\,0\\le y\\le 1,\\,\\,0\\le z\\le x+y+2}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{1}{\\int }_{0}^{x+y+2}\\,dz\\,dy\\,dx \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{1}[z]_{z=0}^{z=x+y+2}\\,dy\\,dx \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{1}x+y+2\\,dy\\,dx \\\\  & ={\\int }_{-1}^{0}{[(x+2)y+\\frac{1}{2}{y}^{2}]}_{y=0}^{y=1}\\,dx \\\\  & ={\\int }_{-1}^{0}x+2+\\frac{1}{2}\\,dx \\\\  & ={\\int }_{-1}^{0}x+\\frac{5}{2}\\,dx \\\\  & ={[\\frac{1}{2}{x}^{2}+\\frac{5}{2}x]}_{x=-1}^{x=0} \\\\  & =0-(\\frac{1}{2}(-1)^{2}+\\frac{5}{2}(-1)) \\\\  & =-\\frac{1}{2}+\\frac{5}{2} \\\\  & =2\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412200 1068 #edb/ref 17592186412188 13194139534146 17592186045417 true] [17592186412200 1069 "q-161693" 13194139534146 17592186045417 true] [17592186412200 1070 #edb/ref 17592186045487 13194139534146 17592186045417 true] [17592186412200 1071 "![](images/4f/4f1ccfc3bdde9872114cc10c333f4d5dfcb1a271e97a3e37a58eefcb7eff1a48.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the front one, are parallel to the corresponding coordinate planes.*" 13194139534146 17592186045417 true] [17592186412200 1072 #uuid "6e182344-0946-5483-a450-ce9ff2b36770" 13194139534146 17592186045417 true] [17592186412200 1074 "![](images/a9/a90ab6eea35b1290e49106ac96c98241f637173c079812048feea9b25d911971.png)\n\n \n\nNotice that our solid can be written as the type II region\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le 2+2y-z},\n$$\n\nwhere\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 1,\\,\\,0\\le z\\le 1}\n$$\n\nis the projection of $R$ onto the $yz$-plane, shown below.\n\n![](images/b4/b497e6ef73b5b16e11baa08819e9628d3b5e1f2ee4d05fbafec48f73e087cbf1.png)\n\nHence, the type II representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le 1,\\,\\,0\\le z\\le 1,\\,\\,0\\le x\\le 2+2y-z}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{0}^{2+2y-z}dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}[x]_{x=0}^{x=2+2y-z}\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}(2+2y-z)-0\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}2+2y-z\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{[(2+2y)z-\\frac{{z}^{2}}{2}]}_{z=0}^{z=1}\\,dy \\\\  & ={\\int }_{0}^{1}2+2y-\\frac{1}{2}\\,dy \\\\  & ={\\int }_{0}^{1}\\frac{3}{2}+2y\\,dy \\\\  & ={[\\frac{3}{2}y+{y}^{2}]}_{y=0}^{y=1} \\\\  & =(\\frac{3}{2}+1)-0 \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412201 1068 #edb/ref 17592186412179 13194139534146 17592186045417 true] [17592186412201 1069 "q-161654" 13194139534146 17592186045417 true] [17592186412201 1070 #edb/ref 17592186045485 13194139534146 17592186045417 true] [17592186412201 1071 "Find the volume of the solid $R$ given by\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,1-x\\le y\\le 1+x,\\,0\\le z\\le xy}.\n$$" 13194139534146 17592186045417 true] [17592186412201 1072 #uuid "89162549-49ec-507f-b56c-dea9e66a6c30" 13194139534146 17592186045417 true] [17592186412201 1074 "Notice that we have a three-dimensional type I region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{1-x}^{1+x}{\\int }_{0}^{xy}\\,dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{1-x}^{1+x}[z]_{z=0}^{z=xy}\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{1-x}^{1+x}xy\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}x{[\\frac{{y}^{2}}{2}]}_{y=1-x}^{y=1+x}\\,dx \\\\  & ={\\int }_{0}^{1}\\frac{x}{2}((1+x)^{2}-(1-x)^{2})\\,dx \\\\  & ={\\int }_{0}^{1}\\frac{x}{2}((1+2x+{x}^{2})-(1-2x+{x}^{2}))\\,dx \\\\  & ={\\int }_{0}^{1}\\frac{x}{2}(4x)\\,dx \\\\  & ={\\int }_{0}^{1}2{x}^{2}\\,dx \\\\  & ={[\\frac{2}{3}{x}^{3}]}_{x=0}^{x=1} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412202 1068 #edb/ref 17592186412190 13194139534146 17592186045417 true] [17592186412202 1069 "q-161661" 13194139534146 17592186045417 true] [17592186412202 1070 #edb/ref 17592186045486 13194139534146 17592186045417 true] [17592186412202 1071 "Find the volume of the solid $R,$ given by\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 4,\\,4\\le z\\le 8-x,\\,0\\le y\\le 2-\\frac{x}{2}}.\n$$" 13194139534146 17592186045417 true] [17592186412202 1072 #uuid "9b5b7d1e-4726-5549-b494-2d265b26d8f0" 13194139534146 17592186045417 true] [17592186412202 1074 "Notice that we have a three-dimensional type III region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{4}{\\int }_{4}^{8-x}{\\int }_{0}^{2-\\frac{x}{2}}\\,dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{4}{\\int }_{4}^{8-x}[y]_{y=0}^{y=2-\\frac{x}{2}}\\,dz\\,dx \\\\  & ={\\int }_{0}^{4}{\\int }_{4}^{8-x}2-\\frac{x}{2}\\,dz\\,dx \\\\  & ={\\int }_{0}^{4}(2-\\frac{x}{2}){[z]}_{z=4}^{z=8-x}\\,dx \\\\  & ={\\int }_{0}^{4}(2-\\frac{x}{2})(8-x-4)\\,dx \\\\  & ={\\int }_{0}^{4}(2-\\frac{x}{2})(4-x)\\,dx \\\\  & ={\\int }_{0}^{4}8-4x+\\frac{1}{2}{x}^{2}\\,dx \\\\  & ={[8x-2{x}^{2}+\\frac{1}{6}{x}^{3}]}_{x=0}^{x=4} \\\\  & =(8(4)-2(4)^{2}+\\frac{1}{6}(4)^{3})-0 \\\\  & =\\frac{32}{3}.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412203 1068 #edb/ref 17592186412175 13194139534146 17592186045417 true] [17592186412203 1069 "q-40359" 13194139534146 17592186045417 true] [17592186412203 1070 #edb/ref 17592186045486 13194139534146 17592186045417 true] [17592186412203 1071 "Consider the solid enclosed between the parabolic cylinders $y={x}^{2}$ and $y=16-{z}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-4}^{4}{\\int }_{a(x)}^{b(x)}\\,f(x,z)\\,dz\\,dx\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" 13194139534146 17592186045417 true] [17592186412203 1072 #uuid "a2dc848f-1abc-53f8-b5eb-d94beb1dc593" 13194139534146 17592186045417 true] [17592186412203 1074 "First, we need to determine the projection of the intersection of our surfaces onto the $xz$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}{x}^{2} & =16-{z}^{2} \\\\ {x}^{2}+{z}^{2} & =16\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $xz$-plane is a circle.\n\nNotice that our solid can be written as a type III region: \n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,{x}^{2}\\le y\\le 16-{z}^{2}},\n$$\n\nwhere $D$ is the interior of the circle ${x}^{2}+{z}^{2}=16.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{{x}^{2}}^{16-{z}^{2}}\\text{d}y]\\text{d}A \\\\  & ={∬}_{D}(16-{z}^{2})-({x}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}16-{x}^{2}-{z}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $z=-\\sqrt{16-{x}^{2}},$ and\n\n- the upper part $z=\\sqrt{16-{x}^{2}},$\n\nfor $-4\\le x\\le 4.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}16-{x}^{2}-{z}^{2}\\,\\text{d}A & ={\\int }_{-4}^{4}{\\int }_{-\\sqrt{16-{x}^{2}}}^{\\sqrt{16-{x}^{2}}}\\,16-{x}^{2}-{z}^{2}\\,dz\\,dx.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f(y,z) & ={(-\\sqrt{16-{x}^{2}})}^{2}+{(\\sqrt{16-{z}^{2}})}^{2}+(16-{x}^{2}-{z}^{2}) \\\\  & =(16-{x}^{2})+(16-{x}^{2})+(16-{x}^{2}-{z}^{2}) \\\\  & =48-3{x}^{2}-{z}^{2}.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412204 1068 #edb/ref 17592186412187 13194139534146 17592186045417 true] [17592186412204 1069 "q-161678" 13194139534146 17592186045417 true] [17592186412204 1070 #edb/ref 17592186045485 13194139534146 17592186045417 true] [17592186412204 1071 "Find the volume of the solid region enclosed by the $xy$-plane, the surface $z={e}^{x+y},$ and the planes $x=0,$ $x=1,$ $y=0,$ $y=1.$" 13194139534146 17592186045417 true] [17592186412204 1072 #uuid "a3e6ac6a-7505-5f3b-b93d-b1ca31a35457" 13194139534146 17592186045417 true] [17592186412204 1074 "Notice that our solid can be written as a type I region: \n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le 1,\\,\\,0\\le z\\le {e}^{x+y}}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{0}^{{e}^{x+y}}\\,dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}[z]_{z=0}^{z={e}^{x+y}}\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}{e}^{x+y}\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}[{e}^{x+y}]_{y=0}^{y=1}\\,dx \\\\  & ={\\int }_{0}^{1}{e}^{x+1}-{e}^{x}\\,dx \\\\  & ={[{e}^{x+1}-{e}^{x}]}_{x=0}^{x=1} \\\\  & =({e}^{1+1}-{e}^{1})-({e}^{0+1}-{e}^{0}) \\\\  & ={e}^{2}-e-e+1 \\\\  & =(e-1)^{2}\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412205 1068 #edb/ref 17592186412173 13194139534146 17592186045417 true] [17592186412205 1069 "q-161655" 13194139534146 17592186045417 true] [17592186412205 1070 #edb/ref 17592186045485 13194139534146 17592186045417 true] [17592186412205 1071 "Find the volume of the solid $R$ given by\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 4,\\,1\\le z\\le 12-2x-2y}.\n$$" 13194139534146 17592186045417 true] [17592186412205 1072 #uuid "aad5f44f-02bf-597c-9fc6-961b47dea0e4" 13194139534146 17592186045417 true] [17592186412205 1074 "Notice that we have a three-dimensional type I region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{4}{\\int }_{1}^{12-2x-2y}\\,dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{4}[z]_{z=1}^{z=12-2x-2y}\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{4}12-2x-2y-1\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{4}11-2x-2y\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}[11y-2xy-{y}^{2}]_{y=0}^{y=4}\\,dx \\\\  & ={\\int }_{0}^{1}44-8x-16\\,dx \\\\  & ={\\int }_{0}^{1}-8x+28\\,dx \\\\  & ={[-4{x}^{2}+28x]}_{x=0}^{x=1} \\\\  & =-4+28-0 \\\\  & =24.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412206 1068 #edb/ref 17592186412174 13194139534146 17592186045417 true] [17592186412206 1069 "q-40319" 13194139534146 17592186045417 true] [17592186412206 1070 #edb/ref 17592186045486 13194139534146 17592186045417 true] [17592186412206 1071 "Consider the solid enclosed between the paraboloids $x=5{y}^{2}+{z}^{2}$ and the parabolic cylinder $x=9-4{y}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-1}^{1}{\\int }_{a(y)}^{b(y)}\\,f(y,z)\\,dz\\,dy\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" 13194139534146 17592186045417 true] [17592186412206 1072 #uuid "b5335202-1eb7-59f8-9c44-3e9c073e7a32" 13194139534146 17592186045417 true] [17592186412206 1074 "First, we need to determine the projection of the intersection of our surfaces onto the $yz$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}5{y}^{2}+{z}^{2} & =9-4{y}^{2} \\\\ 9{y}^{2}+{z}^{2} & =9\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $yz$-plane is an ellipse.\n\nNotice that our solid can be written as a type II region: \n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,5{y}^{2}+{z}^{2}\\le x\\le 9-4{y}^{2}},\n$$\n\nwhere $D$ is the interior of the ellipse $9{y}^{2}+{z}^{2}=9.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{5{y}^{2}+{z}^{2}}^{9-4{y}^{2}}\\text{d}x]\\text{d}A \\\\  & ={∬}_{D}(9-4{y}^{2})-(5{y}^{2}+{z}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}9-9{y}^{2}-{z}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $z=-\\sqrt{9-9{y}^{2}},$ and\n\n- the upper part $z=\\sqrt{9-9{y}^{2}},$\n\nfor $-1\\le y\\le 1.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}9-9{y}^{2}-{z}^{2}\\,\\text{d}A & ={\\int }_{-1}^{1}{\\int }_{-\\sqrt{9-9{y}^{2}}}^{\\sqrt{9-9{y}^{2}}}\\,9-9{y}^{2}-{z}^{2}\\,dz\\,dy.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\sqrt{9-9{y}^{2}})}^{2}+{(\\sqrt{9-9{y}^{2}})}^{2}+(9-9{y}^{2}-{z}^{2}) \\\\  & =(9-9{y}^{2})+(9-9{y}^{2})+(9-9{y}^{2}-{z}^{2}) \\\\  & =27-27{y}^{2}-{z}^{2}.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412207 1068 #edb/ref 17592186412186 13194139534146 17592186045417 true] [17592186412207 1069 "q-161698" 13194139534146 17592186045417 true] [17592186412207 1070 #edb/ref 17592186045486 13194139534146 17592186045417 true] [17592186412207 1071 "![](images/59/599b5392add89a6a22eb6c2232fedbdd26704ebf849bb05d7de52a6d81dcfb6a.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the right one, are parallel to the corresponding coordinate planes.*" 13194139534146 17592186045417 true] [17592186412207 1072 #uuid "bc1d5c0b-7b74-5ad3-bb28-1b0236b6db17" 13194139534146 17592186045417 true] [17592186412207 1074 "![](images/59/599b5392add89a6a22eb6c2232fedbdd26704ebf849bb05d7de52a6d81dcfb6a.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 3-\\frac{x}{2}-z},\n$$\n\nwhere\n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 2}\n$$\n\nis the projection of $R$ onto the $xz$-plane, shown below.\n\n![](images/9e/9e7c6fad45d9d85bad5ca16a2000e4d44a1739ab70797e41ae94945a4ffb02ef.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 2,\\,\\,0\\le y\\le 3-\\frac{x}{2}-z}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}{\\int }_{0}^{3-x/2-z}dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}[y]_{y=0}^{y=3-x/2-z}\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}(3-\\frac{x}{2}-z)-0\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}3-\\frac{x}{2}-z\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{[(3-\\frac{x}{2})z-\\frac{{z}^{2}}{2}]}_{z=0}^{z=2}\\,dx \\\\  & ={\\int }_{0}^{2}((3-\\frac{x}{2})(2)-\\frac{{2}^{2}}{2})-0\\,dx \\\\  & ={\\int }_{0}^{2}4-x\\,dx \\\\  & ={[4x-\\frac{{x}^{2}}{2}]}_{x=0}^{x=2} \\\\  & =(8-2)-0 \\\\  & =6.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412208 1068 #edb/ref 17592186412177 13194139534146 17592186045417 true] [17592186412208 1069 "q-161717" 13194139534146 17592186045417 true] [17592186412208 1070 #edb/ref 17592186045486 13194139534146 17592186045417 true] [17592186412208 1071 "Consider the solid enclosed between the parabolic cylinders $y=-4+{x}^{2}$ and $y=5-{z}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-3}^{3}{\\int }_{a(x)}^{b(x)}\\,f(x,z)\\,dz\\,dx\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" 13194139534146 17592186045417 true] [17592186412208 1072 #uuid "d28d127a-2ef1-5397-a112-fbe0142a6964" 13194139534146 17592186045417 true] [17592186412208 1074 "First, we need to determine the projection of the intersection of our surfaces onto the $xz$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}-4+{x}^{2} & =5-{z}^{2} \\\\ {x}^{2}+{z}^{2} & =9\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $xz$-plane is a circle.\n\nNotice that our solid can be written as a type III region: \n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,-4+{x}^{2}\\le y\\le 5-{z}^{2}},\n$$\n\nwhere $D$ is the interior of the circle ${x}^{2}+{z}^{2}=9.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{-4+{x}^{2}}^{5-{z}^{2}}\\text{d}y]\\text{d}A \\\\  & ={∬}_{D}(5-{z}^{2})-(-4+{x}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}9-{x}^{2}-{z}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $z=-\\sqrt{9-{x}^{2}},$ and\n\n- the upper part $z=\\sqrt{9-{x}^{2}},$\n\nfor $-3\\le x\\le 3.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}9-{x}^{2}-{z}^{2}\\,\\text{d}A & ={\\int }_{-3}^{3}{\\int }_{-\\sqrt{9-{x}^{2}}}^{\\sqrt{9-{x}^{2}}}\\,9-{x}^{2}-{z}^{2}\\,dz\\,dx.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\sqrt{9-{x}^{2}})}^{2}+{(\\sqrt{9-{x}^{2}})}^{2}+(9-{x}^{2}-{z}^{2}) \\\\  & =(9-{x}^{2})+(9-{x}^{2})+(9-{x}^{2}-{z}^{2}) \\\\  & =27-3{x}^{2}-{z}^{2}.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412209 1068 #edb/ref 17592186412185 13194139534146 17592186045417 true] [17592186412209 1069 "q-161691" 13194139534146 17592186045417 true] [17592186412209 1070 #edb/ref 17592186045487 13194139534146 17592186045417 true] [17592186412209 1071 "![](images/b0/b0645201b3726750226811e0c714dc09d3075021fcbb6ddd1525748e9539c02d.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the front one, are parallel to the corresponding coordinate planes.*" 13194139534146 17592186045417 true] [17592186412209 1072 #uuid "d44ebfc0-d493-5ede-9c33-adfa1ab81dd9" 13194139534146 17592186045417 true] [17592186412209 1074 "![](images/c4/c4cf12ec9b53282620c1730f824c96d98e0b9dbabee0478bf258cf6c2741da81.png)\n\n \n\nNotice that our solid can be written as the type II region\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le 1+y+z},\n$$\n\nwhere\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 1,\\,\\,0\\le z\\le 1}\n$$\n\nis the projection of $R$ onto the $yz$-plane, shown below.\n\n![](images/b4/b497e6ef73b5b16e11baa08819e9628d3b5e1f2ee4d05fbafec48f73e087cbf1.png)\n\nHence, the type II representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le 1,\\,\\,0\\le z\\le 1,\\,\\,0\\le x\\le 1+y+z}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{0}^{1+y+z}dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}[x]_{x=0}^{x=1+y+z}\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}(1+y+z)-0\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}1+y+z\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{[(1+y)z+\\frac{{z}^{2}}{2}]}_{z=0}^{z=1}\\,dy \\\\  & ={\\int }_{0}^{1}1+y+\\frac{1}{2}\\,dy \\\\  & ={\\int }_{0}^{1}\\frac{3}{2}+y\\,dy \\\\  & ={[\\frac{3}{2}y+\\frac{1}{2}{y}^{2}]}_{y=0}^{y=1} \\\\  & =(\\frac{3}{2}+\\frac{1}{2})-0 \\\\  & =2.\\end{aligned}\n$$" 13194139534146 17592186045417 true] [17592186412210 1068 #edb/ref 17592186412180 13194139534146 17592186045417 true] [17592186412210 1069 "q-40305" 13194139534146 17592186045417 true] [17592186412210 1070 #edb/ref 17592186045486 13194139534146 17592186045417 true] [17592186412210 1071 "Find the volume of the solid $R,$ given by\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 2,\\,-1\\le z\\le 1,\\,1\\le y\\le {x}^{2}+2{z}^{2}+2}.\n$$" 13194139534146 17592186045417 true] [17592186412210 1072 #uuid "e95b54dd-6268-5c5c-a490-a7470ea8eb6e" 13194139534146 17592186045417 true] [17592186412210 1074 "Notice that we have a three-dimensional type III region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}{\\int }_{1}^{{x}^{2}+2{z}^{2}+2}\\,dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}[y]_{y=1}^{y={x}^{2}+2{z}^{2}+2}\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}({x}^{2}+2{z}^{2}+2)-1\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}{x}^{2}+2{z}^{2}+1\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{[({x}^{2}+1)z+\\frac{2{z}^{3}}{3}]}_{z=-1}^{z=1}\\,dx \\\\  & ={\\int }_{0}^{2}({x}^{2}+1)(1-(-1))+\\frac{2}{3}({1}^{3}-(-1)^{3})\\,dx \\\\  & ={\\int }_{0}^{2}2{x}^{2}+\\frac{10}{3}\\,dx \\\\  & ={[\\frac{2}{3}{x}^{3}+\\frac{10}{3}x]}_{x=0}^{x=2} \\\\  & =(\\frac{2}{3}(2)^{3}+\\frac{10}{3}(2))-0 \\\\  & =12.\\end{aligned}\n$$" 13194139534146 17592186045417 true]] :edb/tempids {"answer-0186ed58-f7ec-5ef6-80f2-6bba068af8ae" 17592186412073 "answer-019b4327-5ad2-57c4-991f-ae345072327b" 17592186412074 "answer-07ab8e05-2f75-5f1a-81dd-e07557bc4267" 17592186412075 "answer-0846e1fd-4ddb-5928-9bfb-cd2dba987965" 17592186412076 "answer-08f5010d-f686-51ba-a29d-c3e7ebee57db" 17592186412077 "answer-09f0d55a-8633-510a-9a70-0736d72c9ea3" 17592186412078 "answer-0a84a3b2-19bb-5e84-a08f-3c6a06d39e69" 17592186412079 "answer-1407e0b5-2eac-5dcf-97da-330b75efe172" 17592186412080 "answer-140ba5b3-f14b-5987-a9e4-2138a251c985" 17592186412081 "answer-15b92e61-6c44-5617-9e76-b9e56e391b4e" 17592186412082 "answer-18508c80-0e18-52e8-aaa1-c7e154a4a945" 17592186412083 "answer-1c05b87c-0a2f-5b02-9732-195c4cebeb2f" 17592186412084 "answer-1c0c0737-e66b-54ce-a699-eb6eaa91aed3" 17592186412085 "answer-21737989-20b9-57bc-85fb-dd005e7013e3" 17592186412086 "answer-26f453de-fdf1-55b9-a976-f40753f1a395" 17592186412087 "answer-2a53e873-260c-523d-86d2-7a180a1002fa" 17592186412088 "answer-2b03de32-d32b-50f3-9d81-a9356d8226fd" 17592186412089 "answer-2b56129c-0df0-54af-906e-0e2a10719caa" 17592186412090 "answer-2c00395f-9e82-5707-bf92-e864ad8edc0a" 17592186412091 "answer-2d6a5b58-75ec-53ab-a1d2-eb0bf32cf642" 17592186412092 "answer-30e725ff-8723-507a-9752-9f42c6ef01be" 17592186412093 "answer-326b02ee-8bcd-58c7-ab55-05f61874238e" 17592186412094 "answer-33546658-bf3e-5faf-af2d-8c9d52241a04" 17592186412095 "answer-34344a8f-e42d-5906-a0f4-0118a32ca456" 17592186412096 "answer-34c83166-7494-5134-b177-dcd7f8751b56" 17592186412097 "answe