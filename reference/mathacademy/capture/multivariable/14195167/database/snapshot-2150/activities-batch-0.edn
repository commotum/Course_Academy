#{[{:activity/first-step {:db/id #edb/ref 17592186101621} :activity/id #uuid "004dc310-3a6e-5664-a905-c68173b8f37b" :activity/scope {:db/id #edb/ref 17592186050620 :topic/id #uuid "59a5dc4d-5419-5445-ba51-b020f0d2e967" :topic/math-academy-id 1212} :activity/steps [{:db/id #edb/ref 17592186101621 :step/content {:db/id #edb/ref 17592186102009 :tutorial/content "We can use differentiation to solve problems involving sectors of circles, such as finding the maximum area of the sector of a circle given a fixed perimeter. Let's remind ourselves of the general strategy for optimization problems.\n\n1. Draw a diagram of the situation, introducing variables where necessary.\n2. Write down the equation of the quantity that you're trying to maximize or minimize. This is called the **objective function**, and it might include more than one variable.\n3. Write down the constraint equation.\n4. Use the constraint equation to write the objective function in terms of a single variable only.\n5. Differentiate the objective function, set it equal to zero, and solve for the stationary points.\n6. Test each stationary point using the second derivative test. Or you can use the first derivative test if it's easier." :tutorial/id #uuid "b57ee810-f3fa-5ba1-a6c6-47856616e4e6" :tutorial/math-academy-id 664 :tutorial/title "Introduction"} :step/id #uuid "d8a0bcff-49d7-5c45-aa34-e863e62b0120" :step/math-academy-id 1272 :step/next {:db/id #edb/ref 17592186101622}} {:db/id #edb/ref 17592186101622 :step/content {:db/id #edb/ref 17592186100836 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100646 :question/id #uuid "ed569da8-3409-5fe1-8ef1-066e28479e53" :question/math-academy-id "e-347"} :knowledge-point/id #uuid "44e6a31e-57dc-533f-972b-bdf2882f3e24" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048883} {:db/id #edb/ref 17592186049173} {:db/id #edb/ref 17592186050622}] :knowledge-point/questions [{:db/id #edb/ref 17592186101184} {:db/id #edb/ref 17592186101473}] :knowle