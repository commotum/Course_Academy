-58a1-ba9e-bc13cbf51a90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186497136} {:answer/id #uuid "f56929c0-71d6-5c58-995f-255de28057ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186497181}] :answer-field/correct {:db/id #edb/ref 17592186497092} :answer-field/id #uuid "a9ab6cc7-1c6a-564f-9adc-c5736d5bdf19" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186497296} {:answer-field/choices [{:answer/id #uuid "16d54a59-b116-5d64-a123-c7d524af431f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186496706} {:answer/id #uuid "27845a93-fa50-598a-9caa-55fdd3c878c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186496741} {:answer/id #uuid "314d874f-d1a1-5c0c-876b-9f48ca57d403" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186496765} {:answer/id #uuid "7571a481-294e-57a6-a6a2-e3dd0a541007" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186496906} {:answer/id #uuid "bb3d34a3-9943-5540-972e-d0c6bda3e020" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186497040}] :answer-field/correct {:db/id #edb/ref 17592186496906} :answer-field/id #uuid "da022dfa-88fa-58f1-8013-b75ae78ec5de" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186497307} {:answer-field/choices [{:answer/id #uuid "603a1275-1788-51d9-af45-1a8f09f57a52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186496870} {:answer/id #uuid "b38e0e61-682b-5ba0-8a07-6ba2bc0dfa58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186497025} {:answer/id #uuid "cc493d8a-a8ec-5aa1-ae81-ac9bd675a655" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186497080} {:answer/id #uuid "d661add0-e9ab-5def-b53e-a9b6046af0ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186497108} {:answer/id #uuid "fce63f78-7203-526e-af52-97c8f967d525" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186497201}] :answer-field/correct {:db/id #edb/ref 17592186497025} :answer-field/id #uuid "fbaea06f-9399-5f51-8fd6-1c23afa989f4" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186497320}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f33a0982-c501-5349-ad00-235127306e08" :question/math-academy-id "q-335670" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}=5x(1-2x)-xy \\\\ {y}^{′}=-2y+3xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model with carrying capacity above, where $x=x(t)$ represents the prey and $y=y(t)$ represents the predators. Select the correct options in the reasoning below.\n\n$\\,$ Evaluating the Jacobian of the system at the equilibrium ${x}^{∗}=[0,\\,0]^{T},$ we get\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$J({x}^{∗})=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"40px\">{{field-1}}</td>\n<td align=\"center\" width=\"40px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,.$</td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>\n\n$\\,$ The eigenvalues of the Jacobian matrix are \n{{field-5}}.\n\n$\\,$ Therefore, the equilibrium at ${x}^{∗}$ is \n{{field-6}}{{field-7}}." :question/worked-solution "Let's denote ${f}_{1}(x,y)=5x(1-2x)-xy$ and ${f}_{2}(x,y)=-2y+3xy.$\n\nNow, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(5x(1-2x)-xy)=5-20x-y,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(5x(1-2x)-xy)=-x \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(-2y+3xy)=3y,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(-2y+3xy)=-2+3x\\end{aligned}\n$$\n\nThus, the Jacobian matrix is\n\n$$\nJ=[\\begin{aligned}5-20x-y & -x \\\\ 3y & -2+3x\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to get\n\n$$\nJ({x}^{∗})=[\\begin{aligned}5-20(0)-0 & -0 \\\\ 3(0) & -2+3(0)\\end{aligned}]=[\\begin{aligned}5 & 0 \\\\ 0 & -2\\end{aligned}].\n$$\n\nThe eigenvalues of the Jacobian matrix are ${\\lambda }_{1}=5\\text{ and }{\\lambda }_{2}=-2.$ Since the eigenvalues are real with opposite signs, our equilibrium is $\\text{an unstable}$ $\\text{saddle}.$"} :step/id #uuid "5932a145-7c28-5526-882d-17efb83e0fb8"} {:db/id #edb/ref 17592186497459 :step/content {:db/id #edb/ref 17592186370416 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0cca672-22d2-56b4-8615-61d6e24b7f94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186370418}] :answer-field/correct {:db/id #edb/ref 17592186370418} :answer-field/id #uuid "07b070e5-7be6-50e8-a4a0-beb9ca54ef6f" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186370417} {:answer-field/choices [{:answer/id #uuid "dda70e62-0307-5f61-be89-38a5799d0f0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186370420}] :answer-field/correct {:db/id #edb/ref 17592186370420} :answer-field/id #uuid "793a6dcc-2165-52e4-94f6-60749fcac9b0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186370419} {:answer-field/choices [{:answer/id #uuid "3512a5da-77e9-5ff0-a44a-28af35917f39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186370422}] :answer-field/correct {:db/id #edb/ref 17592186370422} :answer-field/id #uuid "f1e028e8-2b52-5edb-aa50-089cf299893a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186370421}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6734dc20-5e4c-5ba3-a922-996f26cded96" :question/math-academy-id "q-335607" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}=4x(1-0.25x)-2xy \\\\ {y}^{′}=-6y+3xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model with carrying capacity above, where $x=x(t)$ represents the prey and $y=y(t)$ represents the predators. The equilibria of the model are the following:\n\n$(0,0),\\,(${{field-1}}$,0),\\,(${{field-2}}$,${{field-3}}$)$" :question/worked-solution "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of linear equations:\n\n$$\n\\{\\begin{aligned}4x(1-0.25x)-2xy=0 \\\\ -6y+3xy=0\\end{aligned}\n$$\n\nFactoring the second equation, we get\n\n$$\n\\begin{aligned}-6y+3xy & =0 \\\\ y(-6+3x) & =0.\\end{aligned}\n$$\n\nSo, $y=0$ or $x=2.$ We consider both cases separately.\n\n- If $y=0,$ substituting it into the first equation, we have\n\n$$\n\\begin{aligned}4x(1-0.25x)-2x(0) & =0 \\\\ 4x(0.25x-1) & =0 \\\\ x & =0,\\,4.\\end{aligned}\n$$\n\nThus, the first two equilibria are $(0,0)$ and $(4,0).$\n\n- If $x=2,$ substituting it into the first equation, we have\n\n$$\n\\begin{aligned}4(2)(1-0.25(2))-2(2)y & =0 \\\\ 4-4y & =0 \\\\ y & =1.\\end{aligned}\n$$\n\nThus, another equilibrium is $(2,1).$\n\nTherefore, the equilibria of the model are\n\n$$\n(0,0),\\,(4,0),\\,(2,1).\n$$"} :step/id #uuid "9c6eefcd-5b2a-58f2-8fa4-3bbf0349123c" :step/next {:db/id #edb/ref 17592186497435}} {:db/id #edb/ref 17592186497473 :step/content {:db/id #edb/ref 17592186497359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac7f7168-2238-5278-920a-322ccf51d756" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186497010}] :answer-field/correct {:db/id #edb/ref 17592186497010} :answer-field/id #uuid "2827ddbf-479b-5003-a2de-01715d6851fe" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186497233} {:answer-field/choices [{:answer/id #uuid "7038e05b-62e6-5b9d-89f6-5884cc66e3ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186496900}] :answer-field/correct {:db/id #edb/ref 17592186496900} :answer-field/id #uuid "866fb4cc-629f-52ec-a9a5-882783d95536" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186497280} {:answer-field/choices [{:answer/id #uuid "56c313eb-74f2-5951-b106-ca3f0b7a9669" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186496841}] :answer-field/correct {:db/id #edb/ref 17592186496841} :answer-field/id #uuid "a9119afb-d7f2-5573-9b5d-ea702cbc65cd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186497295}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "54e98471-5688-5240-867b-3e9eae0b3046" :question/math-academy-id "q-335588" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}=4x(1-0.25x)-3xy \\\\ {y}^{′}=-y+xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model with carrying capacity above, where $x=x(t)$ represents the prey and $y=y(t)$ represents the predators. The equilibria of the model are the following:\n\n$(0,0),\\,(${{field-1}}$,0),\\,(${{field-2}}$,${{field-3}}$)$" :question/worked-solution "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of linear equations:\n\n$$\n\\{\\begin{aligned}4x(1-0.25x)-3xy=0 \\\\ -y+xy=0\\end{aligned}\n$$\n\nFactoring the second equation, we get\n\n$$\n\\begin{aligned}-y+xy & =0 \\\\ y(-1+x) & =0.\\end{aligned}\n$$\n\nSo, $y=0$ or $x=1.$ We consider both cases separately.\n\n- If $y=0,$ substituting it into the first equation, we have\n\n$$\n\\begin{aligned}4x(1-0.25x)-3x(0) & =0 \\\\ 4x(0.25x-1) & =0 \\\\ x & =0,\\,4.\\end{aligned}\n$$\n\nThus, the first two equilibria are $(0,0)$ and $(4,0).$\n\n- If $x=1,$ substituting it into the first equation, we have\n\n$$\n\\begin{aligned}4(1)(1-0.25(1))-3(1)y & =0 \\\\ 3-3y & =0 \\\\ y & =1.\\end{aligned}\n$$\n\nThus, another equilibrium is $(1,1).$\n\nTherefore, the equilibria of the model are\n\n$$\n(0,0),\\,(4,0),\\,(1,1).\n$$"} :step/id #uuid "bdfcda17-c79f-53ce-af4f-1ad4c7ab8581" :step/next {:db/id #edb/ref 17592186497459}}] :activity/title "The Lotka-Volterra Model With Carrying Capacity" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186496650}]}
