#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186134619} :activity/id #uuid "28765c46-c394-55b1-842f-82e4066f9786" :activity/scope {:db/id #edb/ref 17592186048326 :topic/id #uuid "9554dfa3-d48e-5a09-94ce-26a2a049aebc" :topic/math-academy-id 2211} :activity/steps [{:db/id #edb/ref 17592186134619 :step/content {:db/id #edb/ref 17592186135028 :tutorial/content "To construct the standard matrix of a linear transformation $T$ in $\\mathbb{R}^2,$ we find the images of the vectors in the standard basis $\\{ \\mathbf{i}, \\mathbf{j} \\}$ of $\\mathbb{R}^2$ under $T,$ and then use those images as columns in the standard matrix.\n\nTo demonstrate, let's consider the following linear transformation: \n\n![](images/b3/b399f02949935d4a4425b19e4946a3eb47375272bb0271586c93da504ff0bd2e.svg)\n\nComputing $\\mathbf T(\\mathbf i),$ we get\n\n$$\n\\begin{aligned}T(i) & =T[\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot 1-1\\cdot 0 \\\\ 1+3\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nComputing $\\mathbf T(\\mathbf j),$ we get\n\n$$\n\\begin{aligned}T(j) & =T[\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot 0-1\\cdot 1 \\\\ 0+3\\cdot 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the standard matrix for this linear transformation is ![](images/be/be0afb6703a6d5e4bcbb360297240a74f4aeec7efbbb1229c8cd01e112fa6bda.svg)\n\nIn the diagram below, we see the vectors in the standard basis $\\{ \\mathbf{i}, \\mathbf{j} \\}$ of $\\mathbb{R}^2$ and their images $\\{ \\mathbf{i'}, \\mathbf{j'} \\}$ under the transformation.\n\n![](images/91/9189a79fe44936221e38e7c051f9f0ddd53338c80cd324ba804d61beef6c2c44.png)\n\nIn general, a linear transformation in $\\mathbb R^n$ has a standard matrix of dimensions $n \\times n,$ whose columns are the images of the basis vectors under the action of the linear transformation." :tutorial/id #uuid "840f3f2c-df1b-50e6-afae-b6c5a434f7a5" :tutorial/math-academy-id 3528 :tutorial/title "Introduction"} :step/id #uuid "5711f04c-b960-52c7-925d-15098acb82c7" :step/math-academy-id 20006 :step/next {:db/id #edb/ref 17592186134622}} {:db/id #edb/ref 17592186134620 :step/content {:db/id #edb/ref 17592186133754 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133563 :question/id #uuid "4748324b-8edf-5fba-90e1-90683887d463" :question/math-academy-id "e-5436"} :knowledge-point/id #uuid "bca46ab2-488a-5596-b96b-559463731556" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050825}] :knowledge-point/questions [{:db/id #edb/ref 17592186134428} {:db/id #edb/ref 17592186134430} {:db/id #edb/ref 17592186271997} {:db/id #edb/ref 17592186329741} {:db/id #edb/ref 17592186348052} {:db/id #edb/ref 17592186403926} {:db/id #edb/ref 17592186403933} {:db/id #edb/ref 17592186476902} {:db/id #edb/ref 17592186476951}] :knowledge-point/title "Determining the Images of the Standard Basis Vectors Under a Given Linear Transformation"} :step/id #uuid "b4fbcf6d-62ba-54b7-9625-c8521044b1e0" :step/math-academy-id 20008} {:db/id #edb/ref 17592186134621 :step/content {:db/id #edb/ref 17592186133755 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133564 :question/id #uuid "0db64243-ffa4-595b-8555-5ee369450557" :question/math-academy-id "e-5437"} :knowledge-point/id #uuid "a2845913-5c76-57f5-a4d3-139a6513225b" :knowledge-point/questions [{:db/id #edb/ref 17592186134426} {:db/id #edb/ref 17592186134431} {:db/id #edb/ref 17592186271996} {:db/id #edb/ref 17592186348054} {:db/id #edb/ref 17592186393772} {:db/id #edb/ref 17592186393779}] :knowledge-point/title "Determining the Standard Matrix of a Linear Transformation Given a Diagram"} :step/id #uuid "ec1bcfe7-e63e-5e9f-a750-0f39702b4059" :step/math-academy-id 20009 :step/next {:db/id #edb/ref 17592186134620}} {:db/id #edb/ref 17592186134622 :step/content {:db/id #edb/ref 17592186133756 :knowledge-point/ca