db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329598}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e98d2b13-3a52-5439-8add-029a6bea2d0e" :question/math-academy-id "q-43894" :question/problem "![](images/5a/5aaf29ab4dd2de3d104ca37a71ee66078f985b908465a77ca06ba8ffadd50210.png)\n\nIn the diagram above,  $i$ and $j$ are the vectors of the standard basis of ${R}^{2}$, while ${i}^{′}$ and  ${j}^{′}$ are their images under the linear transformation $T.$\nWhat is the standard matrix of $T?$" :question/worked-solution "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nFrom the diagram we see that \n${i}^{′}=[\\begin{aligned}-2 \\\\ 3\\end{aligned}]$ \nand \n${j}^{′}=[\\begin{aligned}2 \\\\ 1\\end{aligned}].$\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=[\\begin{aligned}-2 & 2 \\\\ 3 & 1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186345352 :knowledge-point/_questions [{:db/id #edb/ref 17592186133756 :knowledge-point/id #uuid "b057dd5e-f80e-5d3f-84ae-b6aebd5800ea" :knowledge-point/title "Determining the Standard Matrix of a Linear Transformation Given the Image of the Standard Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "262e6574-f0a8-5e20-9194-efcddae60ce0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 2 & 7 \\\\ -3 & 5 & 6 \\\\ 6 & 2 & 0\\end{aligned}]" :db/id #edb/ref 17592186342563} {:answer/id #uuid "7022cab5-c16f-59e8-8443-f646f2928c72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 6 & 7 \\\\ 2 & 5 & 2 \\\\ 6 & -3 & -1\\end{aligned}]" :db/id #edb/ref 17592186343201} {:answer/id #uuid "83ed0187-3fcb-58e8-872c-d75f939d004a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 6 & 7 \\\\ 6 & -3 & -1 \\\\ 2 & 5 & 2\\end{aligned}]" :db/id #edb/ref 17592186343367} {:answer/id #uuid "cc12f4f7-3aea-5ecb-9daa-cc947d9c110e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 2 & 0 \\\\ -3 & 5 & 6 \\\\ -1 & 2 & 7\\end{aligned}]" :db/id #edb/ref 17592186344033} {:answer/id #uuid "e826efaf-1535-51be-94bc-1c46b60c59d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & -3 & -1 \\\\ 2 & 5 & 2 \\\\ 0 & 6 & 7\\end{aligned}]" :db/id #edb/ref 17592186344274}] :answer-field/correct {:answer/id #uuid "e826efaf-1535-51be-94bc-1c46b60c59d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & -3 & -1 \\\\ 2 & 5 & 2 \\\\ 0 & 6 & 7\\end{aligned}]" :db/id #edb/ref 17592186344274} :answer-field/id #uuid "f4b07dfd-33ab-5d7f-8790-26f107420179" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344922}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf91244f-b592-5bd1-a790-f40103636b32" :question/math-academy-id "q-77950" :question/problem "Given that ${i,j,k}$ is the standard basis of ${R}^{3}$ and that the images of $i,$ $j,$ and $k$ under the action of a linear transformation $T$ are $⟨6,2,0⟩,$ $⟨-3,5,6⟩,$ and $⟨-1,2,7⟩,$ respectively, what is the standard matrix of $T?$" :question/worked-solution "Every linear transformation in ${R}^{3}$ can be represented as a $3\\times 3$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i,j,$ and $k$ under the action of the transformation.\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=[\\begin{aligned}6 & -3 & -1 \\\\ 2 & 5 & 2 \\\\ 0 & 6 & 7\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186348052 :knowledge-point/_questions [{:db/id #edb/ref 17592186133754 :knowledge-point/id #uuid "bca46ab2-488a-5596-b96b-559463731556" :knowledge-point/title "Determining the Images of the Standard Basis Vectors Under a Given Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a497af5-5eb9-56bf-b12d-3f387cd8a6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$[\\begin{aligned}-3 \\\\ 1 \\\\ 0\\end{aligned}]$, $[\\begin{aligned}5 \\\\ -4 \\\\ -1\\end{aligned}]$, and $[\\begin{aligned}-2 \\\\ -1 \\\\ 0\\end{aligned}]$" :db/id #edb/ref 17592186345848} {:answer/id #uuid "4637f099-4ee7-5d9e-9432-c575e089e8ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$[\\begin{aligned}-3 \\\\ 5 \\\\ -2\\end{aligned}]$, $[\\begin{aligned}1 \\\\ -4 \\\\ -1\\end{aligned}]$, and $[\\begin{aligned}0 \\\\ -1 \\\\ 0\\end{aligned}]$" :db/id #edb/ref 17592186345963} {:answer/id #uuid "974b41e6-8824-5a0e-8dfe-a667359d08c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$[\\begin{aligned}1 \\\\ -4 \\\\ -1\\end{aligned}]$, $[\\begin{aligned}-3 \\\\ 5 \\\\ -2\\end{aligned}]$, and $[\\begin{aligned}0 \\\\ -1 \\\\ 0\\end{aligned}]$" :db/id #edb/ref 17592186346675} {:answer/id #uuid "d2617b0d-86a5-53d1-81d1-317ba2b47508" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$[\\begin{aligned}-4 \\\\ 5 \\\\ -1\\end{aligned}]$, $[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}]$, and $[\\begin{aligned}-1 \\\\ -2 \\\\ 0\\end{aligned}]$" :db/id #edb/ref 17592186347194} {:answer/id #uuid "fa6e43ae-c189-5b22-9626-25bb56dbca9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}]$, $[\\begin{aligned}-4 \\\\ 5 \\\\ -1\\end{aligned}]$, and $[\\begin{aligned}-1 \\\\ -2 \\\\ 0\\end{aligned}]$" :db/id #edb/ref 17592186347563}] :answer-field/correct {:answer/id #uuid "fa6e43ae-c189-5b22-9626-25bb56dbca9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}]$, $[\\begin{aligned}-4 \\\\ 5 \\\\ -1\\end{aligned}]$, and $[\\begin{aligned}-1 \\\\ -2 \\\\ 0\\end{aligned}]$" :db/id #edb/ref 17592186347563} :answer-field/id #uuid "357ca7ee-2a06-5f79-91d3-044623ab8371" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347695}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bed05d64-8314-58af-9149-10494ba514ea" :question/math-academy-id "q-77959" :question/problem "The linear transformation $T$ has the standard matrix \n\n$$\nT=[\\begin{aligned}1 & -4 & -1 \\\\ -3 & 5 & -2 \\\\ 0 & -1 & 0\\end{aligned}].\n$$\n\nWhat are the respective images of the standard basis vectors ${i,j,k}$ of ${R}^{3}$ under the action of $T?$" :question/worked-solution "**Method 1**\n\nThe images of the vectors in the standard basis ${i,j,k}$ are the first, second, and third columns of $T,$ respectively. \n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}T(i) & =T[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}] \\\\ T(j) & =T[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-4 \\\\ 5 \\\\ -1\\end{aligned}] \\\\ T(k) & =T[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ -2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\n**Method 2**\n\nWe can find the images of the vectors in the standard basis ${i,j,k}$ by computing the matrix products $T\\cdot i,$ $T\\cdot j,$ and $T\\cdot k:$\n\n$$\n\\begin{aligned}T(i) & =T\\cdot i=[\\begin{aligned}1 & -4 & -1 \\\\ -3 & 5 & -2 \\\\ 0 & -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}] \\\\ T(j) & =T\\cdot j=[\\begin{aligned}1 & -4 & -1 \\\\ -3 & 5 & -2 \\\\ 0 & -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-4 \\\\ 5 \\\\ -1\\end{aligned}] \\\\ T(k) & =T\\cdot k=[\\begin{aligned}1 & -4 & -1 \\\\ -3 & 5 & -2 \\\\ 0 & -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ -2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348054 :knowledge-point/_questions [{:db/id #edb/ref 17592186133755 :knowledge-point/id #uuid "a2845913-5c76-57f5-a4d3-139a6513225b" :knowledge-point/title "Determining the Standard Matrix of a Linear Transformation Given a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20fd94cc-5522-5d7e-ac14-c7b58e027b36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & -1 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186345646} {:answer/id #uuid "22c3ed76-01df-5a81-8b5d-fbc782177bb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & -1 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186345662} {:answer/id #uuid "287edbc5-aac7-5c0e-be20-72909a9702a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 3 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186345714} {:answer/id #uuid "65f260fc-3294-5f79-a424-39ae9010eb47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 1 \\\\ -1 & 2\\end{aligned}]" :db/id #edb/ref 17592186346241} {:answer/id #uuid "a0104217-3f8b-5a9f-ab68-58f0d4cf19c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 2 \\\\ 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186346751}] :answer-field/correct {:answer/id #uuid "22c3ed76-01df-5a81-8b5d-fbc782177bb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & -1 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186345662} :answer-field/id #uuid "258c5139-84bb-595a-bdbc-339f120023e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347667}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e54521b0-9af8-56df-9ce1-bb0fae27ed61" :question/math-academy-id "q-77990" :question/problem "![](images/20/20aff9b0dd1ea6aaab8cfa932317e83015956ac355349d5ae3d744de289bdae5.png)\n\nIn the diagram above, $i$ and $j$ are the vectors of the standard basis of ${R}^{2}$, while ${i}^{′}$ and ${j}^{′}$ are their images under the linear transformation $T.$\nWhat is the standard matrix of $T?$" :question/worked-solution "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nFrom the diagram we see that \n${i}^{′}=[\\begin{aligned}3 \\\\ 1\\end{aligned}]$ \nand \n${j}^{′}=[\\begin{aligned}-1 \\\\ 2\\end{aligned}].$\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=[\\begin{aligned}3 & -1 \\\\ 1 & 2\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186393772 :knowledge-point/_questions [{:db/id #edb/ref 17592186133755 :knowledge-point/id #uuid "a2845913-5c76-57f5-a4d3-139a6513225b" :knowledge-point/title "Determining the Standard Matrix of a Linear Transformation Given a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69ef12c0-81b8-5e47-a65d-7cb7211c8786" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 \\\\ 2 & -3\\end{aligned}]" :db/id #edb/re