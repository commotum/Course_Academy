#{[{:db/id #edb/ref 17592186534079 :knowledge-point/_questions [{:db/id #edb/ref 17592186064310 :knowledge-point/id #uuid "71dd9228-4b05-54d9-aeb2-3bdabf89e0e9" :knowledge-point/title "Differentiating a Quotient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f947482-c2c6-568d-82f0-29af6bfba254" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+8{x}^{3}+x+5" :db/id #edb/ref 17592186533253} {:answer/id #uuid "3e350aae-2cd2-5f81-8e5d-74dec200744b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+8{x}^{3}+x+5" :db/id #edb/ref 17592186533284} {:answer/id #uuid "67b07a11-17f0-5c4c-a4ca-8e59d532b7ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+16{x}^{3}+x+5" :db/id #edb/ref 17592186533382} {:answer/id #uuid "89588797-26b1-5b42-8b21-2029da27dbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+16{x}^{3}+2x+8" :db/id #edb/ref 17592186533468} {:answer/id #uuid "b35826d5-c07d-51fb-931e-4b0d6ab4dd47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+16{x}^{3}+2x+8" :db/id #edb/ref 17592186533574}] :answer-field/correct {:answer/id #uuid "67b07a11-17f0-5c4c-a4ca-8e59d532b7ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+16{x}^{3}+x+5" :db/id #edb/ref 17592186533382} :answer-field/id #uuid "0d94c7c1-de0e-5fb5-af87-71126c21e380" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533784}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "deb7ada4-14d9-5457-acd5-ef77477a4e36" :question/math-academy-id "q-138832" :question/problem "Consider the function $y=\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}.$  The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{2{e}^{{x}^{4}+2x}g(x)}{(x+8)^{7}}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({e}^{{x}^{4}+2x})-\\operatorname{ln}⁡((x+8)^{6}) \\\\ \\operatorname{ln}⁡y & ={x}^{4}+2x-6\\operatorname{ln}⁡(x+8)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{4}+2x-6\\operatorname{ln}⁡(x+8)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =4{x}^{3}+2-6\\cdot \\frac{1}{x+8} \\\\ \\frac{{y}^{′}}{y} & =4{x}^{3}+2-\\frac{6}{x+8}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(4{x}^{3}+2-\\frac{6}{x+8})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}(4{x}^{3}+2-\\frac{6}{x+8}) \\\\  & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}(\\frac{(4{x}^{3}+2)(x+8)-6}{x+8}) \\\\  & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{7}}((4{x}^{3}+2)(x+8)-6) \\\\  & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{7}}(4{x}^{4}+32{x}^{3}+2x+16-6) \\\\  & =\\frac{2{e}^{{x}^{4}+2x}(2{x}^{4}+16{x}^{3}+x+5)}{(x+8)^{7}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=2{x}^{4}+16{x}^{3}+x+5.\n$$"}] [{:db/id #edb/ref 17592186534090 :knowledge-point/_questions [{:db/id #edb/ref 17592186064310 :knowledge-point/id #uuid "71dd9228-4b05-54d9-aeb2-3bdabf89e0e9" :knowledge-point/title "Differentiating a Quotient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42e00fa1-2d53-53c2-91c2-dbaf97414222" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17{x}^{2}-6{x}^{3}+15" :db/id #edb/ref 17592186533296} {:answer/id #uuid "84e65e07-d407-5744-b09c-1d7419c5f733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{x}^{2}-3{x}^{3}+15" :db/id #edb/ref 17592186533452} {:answer/id #uuid "949b2307-7470-54c1-a231-4a7923ae08c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{x}^{2}+3{x}^{3}+15" :db/id #edb/ref 17592186533499} {:answer/id #uuid "9f5538e4-cb5c-53d2-8282-324285197339" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17{x}^{2}+3{x}^{3}+15" :db/id #edb/ref 17592186533525} {:answer/id #uuid "cffa59f6-f8b3-5069-84a6-83cd2e84beae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{2}-6{x}^{3}+15" :db/id #edb/ref 17592186533646}] :answer-field/correct {:answer/id #uuid "42e00fa1-2d53-53c2-91c2-dbaf97414222" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17{x}^{2}-6{x}^{3}+15" :db/id #edb/ref 17592186533296} :answer-field/id #uuid "f81d8766-b273-5742-81e1-135f6f4971d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533963}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f3859b1c-a23b-517a-bfe5-a836f749be10" :question/math-academy-id "q-138834" :question/problem "Consider the function $y=\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{({x}^{2}+1)^{x-1}}{(1-3x)^{6}}g(x)+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1).\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)^{x})-\\operatorname{ln}⁡((1-3x)^{5}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡({x}^{2}+1)-5\\operatorname{ln}⁡(1-3x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡({x}^{2}+1)-5\\operatorname{ln}⁡(1-3x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\operatorname{ln}⁡({x}^{2}+1)+x\\cdot \\frac{1}{{x}^{2}+1}\\cdot (2x)-5\\cdot \\frac{1}{1-3x}\\cdot (-3) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡({x}^{2}+1)+\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =y(\\operatorname{ln}⁡({x}^{2}+1)+\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\operatorname{ln}⁡({x}^{2}+1)+\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x}) \\\\  & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x})+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1) \\\\  & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\frac{2{x}^{2}(1-3x)+15({x}^{2}+1)}{({x}^{2}+1)(1-3x)})+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1) \\\\  & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\frac{17{x}^{2}-6{x}^{3}+15}{({x}^{2}+1)(1-3x)})+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1) \\\\  & =\\frac{({x}^{2}+1)^{x-1}}{(1-3x)^{6}}(17{x}^{2}-6{x}^{3}+15)+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1)\\end{aligned}\n$$\n\nTherefore,\n\n$$\ng(x)=17{x}^{2}-6{x}^{3}+15.\n$$"}] [{:db/id #edb/ref 17592186534067 :knowledge-point/_questions [{:db/id #edb/ref 17592186064311 :knowledge-point/id #uuid "c6005f9a-3eba-5f8d-909d-894d9cd24d12" :knowledge-point/title "Differentiating a Radical Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c61cfcf-a787-550b-810a-38a9ae04f7fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-6" :db/id #edb/ref 17592186533208} {:answer/id #uuid "9411358e-dbc0-567a-a1c3-e8fae0dff5ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x" :db/id #edb/ref 17592186533497} {:answer/id #uuid "96e9100a-3748-5dd5-ad4e-9a90375f9d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x" :db/id #edb/ref 17592186533508} {:answer/id #uuid "c744d1de-7757-5a26-ac48-bc584e98ec52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x+6" :db/id #edb/ref 17592186533617} {:answer/id #uuid "d6c60272-837e-5905-b5bf-1a14841fc162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-3" :db/id #edb/ref 17592186533662}] :answer-field/correct {:answer/id #uuid "96e9100a-3748-5dd5-ad4e-9a90375f9d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x" :db/id #edb/ref 17592186533508} :answer-field/id #uuid "52f2bc75-08e1-5592-986f-bf5ac47ce09a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533847}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cc13fb5c-5303-5c81-bafe-333779ced9ca" :question/math-academy-id "q-138854" :question/problem "Consider the function $y=\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{1}{2}(g(x)-({x}^{2}+4)\\operatorname{cot}⁡x)\\sqrt{({x}^{2}+4)\\operatorname{csc}⁡x}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}} \\\\  & =\\frac{\\sqrt{({x}^{2}+4)^{3}}}{\\sqrt{\\operatorname{sin}⁡x}} \\\\  & =\\frac{({x}^{2}+4)^{3/2}}{(\\operatorname{sin}⁡x)^{1/2}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{({x}^{2}+4)^{3/2}}{(\\operatorname{sin}⁡x)^{1/2}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+4)^{3/2})-\\operatorname{ln}⁡((\\operatorname{sin}⁡x)^{1/2}) \\\\ \\operatorname{ln}⁡y & =\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+4)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+4)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{3}{2}\\cdot \\frac{1}{{x}^{2}+4}\\cdot 2x-\\frac{1}{2}\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot \\operatorname{cos}⁡x \\\\ \\frac{{y}^{′}}{y} & =\\frac{3x}{{x}^{2}+4}-\\frac{\\operatorname{cot}⁡x}{2}\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{3x}{{x}^{2}+4}-\\frac{\\operatorname{cot}⁡x}{2})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}(\\frac{3x}{{x}^{2}+4}-\\frac{\\operatorname{cot}⁡x}{2}) \\\\  & =\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}(\\frac{6x-({x}^{2}+4)\\operatorname{cot}⁡x}{2({x}^{2}+4)}) \\\\  & =\\sqrt{\\frac{{x}^{2}+4}{\\operatorname{sin}⁡x}}(\\frac{6x-({x}^{2}+4)\\operatorname{cot}⁡x}{2}) \\\\  & =\\frac{1}{2}(6x-({x}^{2}+4)\\operatorname{cot}⁡x)\\sqrt{({x}^{2}+4)\\operatorname{csc}⁡x}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=6x.\n$$"}] [{:db/id #edb/ref 17592186554576 :knowledge-point/_questions [{:db/id #edb/ref 17592186064311 :knowledge-point/id #uuid "c6005f9a-3eba-5f8d-909d-894d9cd24d12" :knowledge-point/title "Differentiating a Radical Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80386a1f-1c68-542d-97ab-e6ec02fe80f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt[3]{(x+2)^{2}}" :db/id #edb/ref 17592186554125} {:answer/id #uuid "9eb339eb-1cc4-5d35-9e83-6c06760cd1fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{(3x+6)^{2}}" :db/id #edb/ref 17592186554219} {:answer/id #uuid "c88b7035-072c-5214-bd55-1804a6aa0ae7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{(3x+6)^{4}}" :db/id #edb/ref 17592186554310} {:answer/id #uuid "e2ae8cb1-1ad1-519a-a9ae-fc0f9b33b01f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{3x+6}" :db/id #edb/ref 17592186554361} {:answer/id #uuid "ec4a59e0-949a-5cc8-91d2-09ecb393925e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt[3]{(x+2)^{4}}" :db/id #edb/ref 17592186554386}] :answer-field/correct {:answer/id #uuid "c88b7035-072c-5214-bd55-1804a6aa0ae7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt[3]{(3x+6)^{4}}" :db/id #edb/ref 17592186554310} :answer-field/id #uuid "8c497ffd-4cca-50b5-a7fc-dc93d720ea25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554487}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5c789989-28b9-52e0-ac72-a0f8b7d66a60" :question/math-academy-id "q-138860" :question/problem "Consider the function $y=\\sqrt[3]{\\frac{({x}^{2}+2)^{6}}{3x+6}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{({x}^{2}+2)(11{x}^{2}+24x-2)}{g(x)}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt[3]{\\frac{({x}^{2}+2)^{6}}{3x+6}} \\\\  & =\\frac{\\sqrt[3]{({x}^{2}+2)^{6}}}{\\sqrt[3]{3x+6}} \\\\  & =\\frac{({x}^{2}+2)^{6/3}}{(3x+6)^{1/3}} \\\\  & =\\frac{({x}^{2}+2)^{2}}{(3x+6)^{1/3}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{({x}^{2}+2)^{2}}{(3x+6)^{1/3}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+2)^{2})-\\operatorname{ln}⁡((3x+6)^{1/3}) \\\\ \\operatorname{ln}⁡y & =2\\operatorname{ln}⁡({x}^{2}+2)-\\frac{1}{3}\\operatorname{ln}⁡(3x+6)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}⁡({x}^{2}+2)-\\frac{1}{3}\\operatorname{ln}⁡(3x+6)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2\\cdot \\frac{1}{{x}^{2}+2}\\cdot 2x-\\frac{1}{3}\\cdot \\frac{1}{3x+6}\\cdot 3 \\\\ \\frac{{y}^{′}}{y} & =\\frac{4x}{{x}^{2}+2}-\\frac{1}{3x+6}\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{4x}{{x}^{2}+2}-\\frac{1}{3x+6})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt[3]{\\frac{({x}^{2}+2)^{6}}{3x+6}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt[3]{\\frac{({x}^{2}+2)^{6}}{3x+6}}(\\frac{4x}{{x}^{2}+2}-\\frac{1}{3x+6}) \\\\  & =\\sqrt[3]{\\frac{({x}^{2}+2)^{6}}{3x+6}}(\\frac{4x(3x+6)-({x}^{2}+2)}{({x}^{2}+2)(3x+6)}) \\\\  & =\\sqrt[3]{\\frac{({x}^{2}+2)^{6}}{3x+6}}(\\frac{11{x}^{2}+24x-2}{({x}^{2}+2)(3x+6)}) \\\\  & =\\frac{({x}^{2}+2)(11{x}^{2}+24x-2)}{\\sqrt[3]{(3x-6)^{4}}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=\\sqrt[3]{(3x-6)^{4}}.\n$$"}] [{:db/id #edb/ref 17592186534031 :knowledge-point/_questions [{:db/id #edb/ref 17592186064310 :knowledge-point/id #uuid "71dd9228-4b05-54d9-aeb2-3bdabf89e0e9" :knowledge-point/title "Differentiating a Quotient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c406db1-ac6c-5309-b97f-14fd566c17b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x^{2}+x+11" :db/id #edb/ref 17592186533391}] :answer-field/correct {:answer/id #uuid "6c406db1-ac6c-5309-b97f-14fd566c17b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x^{2}+x+11" :db/id #edb/ref 17592186533391} :answer-field/id #uuid "8d713dab-487c-57b4-848a-8f859a772276" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533887}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "88fe2774-53cf-5c90-a007-5fb6a5d78b33" :question/math-academy-id "q-343529" :question/problem "Given that $y=\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}},$ find ${y}^{′}.$\n\n${y}^{′}=\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[$\n{{field-1}}$]$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x-2)^{5})-\\operatorname{ln}⁡({e}^{{x}^{2}+3x}) \\\\ \\operatorname{ln}⁡y & =5\\operatorname{ln}⁡(x-2)-({x}^{2}+3x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(5\\operatorname{ln}⁡(x-2)-({x}^{2}+3x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =5\\cdot \\frac{1}{x-2}-(2x+3) \\\\ \\frac{{y}^{′}}{y} & =\\frac{5}{x-2}-(2x+3)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y[\\frac{5}{x-2}-(2x+3)]\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}[\\frac{5}{x-2}-(2x+3)] \\\\  & =\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}[\\frac{5-(x-2)(2x+3)}{x-2}] \\\\  & =\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[5-(x-2)(2x+3)] \\\\  & =\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[5-(2{x}^{2}-x-6)] \\\\  & =\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[11+x-2{x}^{2}]\\end{aligned}\n$$"}]}
