#{[{:db/id #edb/ref 17592186401014 :knowledge-point/_questions [{:db/id #edb/ref 17592186092373 :knowledge-point/id #uuid "cd0b4da9-1a0f-5a46-aff1-3ce5c0cebb3b" :knowledge-point/title "Creating an Integral Expression For the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c77b2f36-6be8-50c0-ae22-868fa6cf86a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401016} {:answer/id #uuid "09d3bae4-8fa4-5410-960c-88cdf9ccbafc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+4{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401017} {:answer/id #uuid "e29d1f8d-e673-5fab-ab5a-b94d3c279c90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+4{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401018} {:answer/id #uuid "d634400e-7fcc-5b2f-8882-b33255d21d09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+4{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401019} {:answer/id #uuid "33483e89-3247-5b5b-b6c3-9a62773834b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401020}] :answer-field/correct {:answer/id #uuid "c77b2f36-6be8-50c0-ae22-868fa6cf86a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401016} :answer-field/id #uuid "4d94100e-63ab-58cf-b2c0-0f485eafe140" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401015}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a434871-4fea-52cd-80a4-1fd81c159fb1" :question/math-academy-id "q-15133" :question/problem "![](images/3a/3a760f55b6437a39010e4d1a00bdb5fb5390d848dd74347e7736e2ac49cd562b.png)\n\nWhich of the following gives the arc length of the polar curve $r=3\\operatorname{sin}⁡(4\\theta )$ for $0\\le \\theta \\le \\frac{\\pi }{4}$ (shown in blue in the diagram above)?" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=3\\operatorname{sin}⁡(4\\theta ),$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=12\\operatorname{cos}⁡(4\\theta ).\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(3\\operatorname{sin}⁡(4\\theta ))^{2}+(12\\operatorname{cos}⁡(4\\theta ))^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{9{sin}^{2}⁡(4\\theta )+144{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{9({sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta ))}\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186321141 :knowledge-point/_questions [{:db/id #edb/ref 17592186092374 :knowledge-point/id #uuid "84a533e8-9a7c-58f3-9d3c-7c08b3c6bfd1" :knowledge-point/title "Finding the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd1ec179-c3eb-579d-b407-4fb26d5fa6e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{2}({e}^{\\pi }-1)" :db/id #edb/ref 17592186320154}] :answer-field/correct {:answer/id #uuid "fd1ec179-c3eb-579d-b407-4fb26d5fa6e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{2}({e}^{\\pi }-1)" :db/id #edb/ref 17592186320154} :answer-field/id #uuid "2092fbc0-9454-5cb0-afd6-99345b4a8c65" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320241}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e21eed1a-d586-5617-ae1f-53bbb8801576" :question/math-academy-id "q-353598" :question/problem "![](images/16/16b676776dc22aece5a1fa777007a03b9e7903706cbdf5cc4ae14d8508370419.png)\n\nFind the arc length $L$ of the polar curve $r={e}^{2\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{2}$ (shown in blue in the diagram above). Do not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={e}^{2\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=2{e}^{2\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{({e}^{2\\theta })}^{2}+{(2{e}^{2\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4\\theta }+4{e}^{4\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{5{e}^{4\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{5}{\\int }_{0}^{\\pi /2}{e}^{2\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{5}{[\\frac{1}{2}{e}^{2\\theta }]}_{0}^{\\pi /2} \\\\  & =\\frac{\\sqrt{5}}{2}{[{e}^{2\\theta }]}_{0}^{\\pi /2} \\\\  & =\\frac{\\sqrt{5}}{2}({e}^{2(\\pi /2)}-{e}^{0}) \\\\  & =\\frac{\\sqrt{5}}{2}({e}^{\\pi }-1).\\end{aligned}\n$$"}]}
