#{[{:db/id #edb/ref 17592186499502 :knowledge-point/_questions [{:db/id #edb/ref 17592186092373 :knowledge-point/id #uuid "cd0b4da9-1a0f-5a46-aff1-3ce5c0cebb3b" :knowledge-point/title "Creating an Integral Expression For the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0989efb5-1038-59ac-8680-60117382e68a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /4}\\sqrt{(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186498746} {:answer/id #uuid "1ce9d6eb-3f8f-56eb-a2d0-a4cfacaf7268" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /4}\\sqrt{{\\theta }^{2}+2(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+2}\\,\\text{d}\\theta " :db/id #edb/ref 17592186498792} {:answer/id #uuid "38d06719-2aef-52ec-b523-72bbe2d5ce07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{2(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186498855} {:answer/id #uuid "51cc30b4-2098-5551-9641-1f9551e409a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{{\\theta }^{2}+2(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+2}\\,\\text{d}\\theta " :db/id #edb/ref 17592186498920} {:answer/id #uuid "52b44f14-c340-50a7-9cae-50d08c357aa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{{\\theta }^{2}+(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+1}\\,\\text{d}\\theta " :db/id #edb/ref 17592186498921}] :answer-field/correct {:answer/id #uuid "51cc30b4-2098-5551-9641-1f9551e409a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{{\\theta }^{2}+2(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+2}\\,\\text{d}\\theta " :db/id #edb/ref 17592186498920} :answer-field/id #uuid "f107053f-9248-55df-a0bd-cf3499751023" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499425}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "85d77d15-6969-5117-952d-e2b202d58514" :question/math-academy-id "q-15123" :question/problem "Which of the following gives the arc length of the polar curve $r=\\theta +\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{2}?$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\theta +\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=1-\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(\\theta +\\operatorname{cos}⁡\\theta )^{2}+(1-\\operatorname{sin}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{({\\theta }^{2}+2\\theta \\operatorname{cos}⁡\\theta +{cos}^{2}⁡\\theta )+(1-2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{\\theta }^{2}+2(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+2}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401014 :knowledge-point/_questions [{:db/id #edb/ref 17592186092373 :knowledge-point/id #uuid "cd0b4da9-1a0f-5a46-aff1-3ce5c0cebb3b" :knowledge-point/title "Creating an Integral Expression For the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c77b2f36-6be8-50c0-ae22-868fa6cf86a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401016} {:answer/id #uuid "09d3bae4-8fa4-5410-960c-88cdf9ccbafc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+4{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401017} {:answer/id #uuid "e29d1f8d-e673-5fab-ab5a-b94d3c279c90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+4{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401018} {:answer/id #uuid "d634400e-7fcc-5b2f-8882-b33255d21d09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+4{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401019} {:answer/id #uuid "33483e89-3247-5b5b-b6c3-9a62773834b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401020}] :answer-field/correct {:answer/id #uuid "c77b2f36-6be8-50c0-ae22-868fa6cf86a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186401016} :answer-field/id #uuid "4d94100e-63ab-58cf-b2c0-0f485eafe140" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401015}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a434871-4fea-52cd-80a4-1fd81c159fb1" :question/math-academy-id "q-15133" :question/problem "![](images/3a/3a760f55b6437a39010e4d1a00bdb5fb5390d848dd74347e7736e2ac49cd562b.png)\n\nWhich of the following gives the arc length of the polar curve $r=3\\operatorname{sin}⁡(4\\theta )$ for $0\\le \\theta \\le \\frac{\\pi }{4}$ (shown in blue in the diagram above)?" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=3\\operatorname{sin}⁡(4\\theta ),$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=12\\operatorname{cos}⁡(4\\theta ).\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(3\\operatorname{sin}⁡(4\\theta ))^{2}+(12\\operatorname{cos}⁡(4\\theta ))^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{9{sin}^{2}⁡(4\\theta )+144{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{9({sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta ))}\\,\\text{d}\\theta  \\\\  & =3{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186321141 :knowledge-point/_questions [{:db/id #edb/ref 17592186092374 :knowledge-point/id #uuid "84a533e8-9a7c-58f3-9d3c-7c08b3c6bfd1" :knowledge-point/title "Finding the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd1ec179-c3eb-579d-b407-4fb26d5fa6e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{2}({e}^{\\pi }-1)" :db/id #edb/ref 17592186320154} {:answer/id #uuid "048e136b-84ec-5868-b091-1a12da7bcf24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{2}(e^{\\pi}-1)" :db/id #edb/ref 17592186498739}] :answer-field/correct {:answer/id #uuid "048e136b-84ec-5868-b091-1a12da7bcf24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{2}(e^{\\pi}-1)" :db/id #edb/ref 17592186498739} :answer-field/id #uuid "2092fbc0-9454-5cb0-afd6-99345b4a8c65" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320241}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e21eed1a-d586-5617-ae1f-53bbb8801576" :question/math-academy-id "q-353598" :question/problem "![](images/16/16b676776dc22aece5a1fa777007a03b9e7903706cbdf5cc4ae14d8508370419.png)\n\nFind the arc length $L$ of the polar curve $r={e}^{2\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{2}$ (shown in blue in the diagram above). Do not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={e}^{2\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=2{e}^{2\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{({e}^{2\\theta })}^{2}+{(2{e}^{2\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4\\theta }+4{e}^{4\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{5{e}^{4\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{5}{\\int }_{0}^{\\pi /2}{e}^{2\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{5}{[\\frac{1}{2}{e}^{2\\theta }]}_{0}^{\\pi /2} \\\\  & =\\frac{\\sqrt{5}}{2}{[{e}^{2\\theta }]}_{0}^{\\pi /2} \\\\  & =\\frac{\\sqrt{5}}{2}({e}^{2(\\pi /2)}-{e}^{0}) \\\\  & =\\frac{\\sqrt{5}}{2}({e}^{\\pi }-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186499546 :knowledge-point/_questions [{:db/id #edb/ref 17592186092373 :knowledge-point/id #uuid "cd0b4da9-1a0f-5a46-aff1-3ce5c0cebb3b" :knowledge-point/title "Creating an Integral Expression For the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "160e2a0c-f074-5874-a5f2-17cc1fc2cae2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /3}\\sqrt{1-4\\operatorname{cos}⁡\\theta +5{cos}^{2}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186498777} {:answer/id #uuid "6d20f288-51ab-5e95-ad79-fa5df49f89a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /3}^{\\pi }\\sqrt{3-4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186498973} {:answer/id #uuid "a35283a7-4adc-5de1-826d-87a387cd4479" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /3}^{\\pi }\\sqrt{5-4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186499081} {:answer/id #uuid "c87b6998-b8e9-5934-9893-be14c9c09927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi /3}^{\\pi /3}\\sqrt{5+4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186499169} {:answer/id #uuid "d102d768-01d6-510f-bd39-ea2452eac6cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /3}^{\\pi }\\sqrt{3+4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186499192}] :answer-field/correct {:answer/id #uuid "a35283a7-4adc-5de1-826d-87a387cd4479" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /3}^{\\pi }\\sqrt{5-4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/id #edb/ref 17592186499081} :answer-field/id #uuid "cafcbac5-e575-5e1d-93e5-5e527facd2e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499408}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d774fdc1-484c-5e5e-b140-afbc35a348d0" :question/math-academy-id "q-51202" :question/problem "![](images/87/87a3563153fe0310767a79a96df0df5f6c0824027776b761df4a792b8b9b235e.png)\n\nWhich of the following gives the arc length of the polar curve $r=1-2\\operatorname{cos}⁡\\theta $ for $\\frac{\\pi }{3}\\le \\theta \\le \\pi $ (shown in blue in the diagram above)?" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1-2\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=2\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{(1-2\\operatorname{cos}⁡\\theta )^{2}+(2\\operatorname{sin}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{1-4\\operatorname{cos}⁡\\theta +4{cos}^{2}⁡\\theta +4{sin}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{1-4\\operatorname{cos}⁡\\theta +4}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{5-4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186499484 :knowledge-point/_questions [{:db/id #edb/ref 17592186092374 :knowledge-point/id #uuid "84a533e8-9a7c-58f3-9d3c-7c08b3c6bfd1" :knowledge-point/title "Finding the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39bd8942-8ea6-5f03-b9c2-980c08387095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{10}}{3}({e}^{3\\pi /2}+{e}^{-3\\pi /2})" :db/id #edb/ref 17592186498858} {:answer/id #uuid "3f95ea7f-6aac-57fb-89fc-e3618b1effd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{10}}{3}{e}^{3\\pi /2}" :db/id #edb/ref 17592186498876} {:answer/id #uuid "472465ce-5697-565a-b045-a23526f9815c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}({e}^{2\\pi /3}-{e}^{-2\\pi /3})" :db/id #edb/ref 17592186498893} {:answer/id #uuid "a7929dc7-bc71-5a90-8bb2-c5a85e81928b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{10}}{3}({e}^{3\\pi /2}-{e}^{-3\\pi /2})" :db/id #edb/ref 17592186499099} {:answer/id #uuid "e97e245e-6898-5e7c-8a99-3baaa90c0589" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}{e}^{3\\pi /2}" :db/id #edb/ref 17592186499259}] :answer-field/correct {:answer/id #uuid "a7929dc7-bc71-5a90-8bb2-c5a85e81928b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{10}}{3}({e}^{3\\pi /2}-{e}^{-3\\pi /2})" :db/id #edb/ref 17592186499099} :answer-field/id #uuid "62f08aa4-9c3b-5881-9036-fcd624473552" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186499360}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "657b78ff-bfd8-5861-b182-c1815c474783" :question/math-academy-id "q-9534" :question/problem "Find the arc length of the polar curve $r=2{e}^{3\\theta }$ for $-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=2{e}^{3\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=6{e}^{3\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{{(2{e}^{3\\theta })}^{2}+{(6{e}^{3\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{4{e}^{6\\theta }+36{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{40{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & =2\\sqrt{10}{\\int }_{-\\pi /2}^{\\pi /2}{e}^{3\\theta }\\,\\text{d}\\theta  \\\\  & =\\frac{2\\sqrt{10}}{3}{e}^{3\\theta }{|}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{2\\sqrt{10}}{3}({e}^{3\\pi /2}-{e}^{-3\\pi /2}).\\end{aligned}\n$$"}]}
