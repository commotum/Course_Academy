ze=\"1.623em\" maxsize=\"1.623em\">(</mo></mrow><mi>θ</mi><mo>+</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><msup><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">(</mo></mrow><mn>1</mn><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><msup><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">)</mo></mrow><mn>2</mn></msup></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>θ</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mrow></msubsup><msqrt><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">(</mo></mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>θ</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo>+</mo><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">)</mo></mrow><mo>+</mo><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">(</mo></mrow><mn>1</mn><mo>−</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo>+</mo><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">)</mo></mrow></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>θ</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>2</mn></mrow></msubsup><msqrt><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mo stretchy=\"false\">(</mo><mi>θ</mi><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo>−</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo stretchy=\"false\">)</mo><mo>+</mo><mn>2</mn></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>θ</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
