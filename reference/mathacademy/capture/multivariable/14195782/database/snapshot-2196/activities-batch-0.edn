#{[{:activity/expected-seconds 1380.0 :activity/first-step {:db/id #edb/ref 17592186134693} :activity/id #uuid "268bdff9-18d6-5412-ae6e-b8444e305d46" :activity/scope {:db/id #edb/ref 17592186050130 :topic/id #uuid "2f232786-4262-5d64-9c58-1578e8c629d2" :topic/math-academy-id 2129} :activity/steps [{:db/id #edb/ref 17592186134693 :step/content {:db/id #edb/ref 17592186135058 :tutorial/content "The **QR factorization** of an $m\\times n$ matrix $A$ with linearly independent columns is the matrix product\n\n$$\n\\underset{{\\large m} \\times {\\large n}}{A}\n=\n\\underset{{\\large m} \\times {\\large n}}{Q} \\times \\underset{{\\large n} \\times {\\large n}}{R},\n$$\n\nwhere \n\n- $Q$ is an $m \\times n$ matrix whose columns form an orthonormal basis of $\\text{Col}(A),$ and\n\n- $R$ is an $n \\times n$ upper triangular matrix with positive entries on its diagonal.\n\nFor example, the $3\\times 2$ matrix\n\n![](images/b7/b71bb9b1dc9aa6d23f2c990052e2e83eeda6000fc64a61ccdb614669d840d38a.svg)\n\nhas the QR factorization\n\n![](images/7c/7c5c30e4011efe0ac87f02217dd1f52c6e64658c6e90d22ad8689209badeb1f4.svg)" :tutorial/id #uuid "ce4cf9b1-a257-518d-befa-0bfba1cdec60" :tutorial/math-academy-id 3635 :tutorial/title "Introduction"} :step/id #uuid "69e8ec76-c280-55f4-8fc9-a6277b14654a" :step/math-academy-id 20266 :step/next {:db/id #edb/ref 17592186134800}} {:db/id #edb/ref 17592186134694 :step/content {:db/id #edb/ref 17592186133798 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133607 :question/id #uuid "f042812b-fb14-520a-bb6d-08631d941d04" :question/math-academy-id "e-5586"} :knowledge-point/id #uuid "19ae0632-68ac-5da9-8adf-cf71d5ecbc7c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050578}] :knowledge-point/questions [{:db/id #edb/ref 17592186134324} {:db/id #edb/ref 17592186134326} {:db/id #edb/ref 17592186364620} {:db/id #edb/ref 17592186364627} {:db/id #edb/ref 17592186378705} {:db/id #edb/ref 17592186388792} {:db/id #edb/ref 17592186395107} {:db/id #edb/ref 17592186432329} {:db/id #edb/ref 17592186442810}] :knowledge-point/title "Finding the QR Factorization of a Matrix"} :step/id #uuid "154bb446-4c57-548a-b863-0bfee2ca6f92" :step/math-academy-id 20267} {:db/id #edb/ref 17592186134732 :step/content {:db/id #edb/ref 17592186133821 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133633 :question/id #uuid "c6fe3751-c00b-592b-903e-567d95174cd2" :question/math-academy-id "e-5959"} :knowledge-point/id #uuid "cd18abf3-b551-55d6-a573-690745a65b3e" :knowledge-point/questions [{:db/id #edb/ref 17592186134352} {:db/id #edb/ref 17592186134354} {:db/id #edb/ref 17592186363217} {:db/id #edb/ref 17592186364171} {:db/id #edb/ref 17592186364178} {:db/id #edb/ref 17592186364599} {:db/id #edb/ref 17592186364606} {:db/id #edb/ref 17592186415506} {:db/id #edb/ref 17592186432326} {:db/id #edb/ref 17592186432334}] :knowledge-point/title "Finding a QR Factorization of a Matrix Given an Orthogonal Basis in Terms of the Columns of a Matrix"} :step/id #uuid "909730ba-aeca-592b-b525-e38e4f18e31a" :step/math-academy-id 22120 :step/next {:db/id #edb/ref 17592186134803}} {:db/id #edb/ref 17592186134798 :step/content {:db/id #edb/ref 17592186133862 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133678 :question/id #uuid "0a812585-d467-562d-acda-e379ac9dc544" :question/math-academy-id "e-8324"} :knowledge-point/id #uuid "38edbd80-2aef-5b3e-8dd9-de9f2fbeca9b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049606}] :knowledge-point/questions [{:db/id #edb/ref 17592186134315} {:db/id #edb/ref 17592186134355} {:db/id #edb/ref 17592186364152} {:db/id #edb/ref 17592186364585} {:db/id #edb/ref 17592186364592} {:db/id #edb/ref 17592186392389} {:db/id #edb/ref 17592186432332} {:db/id #edb/ref 17592186432333}] :knowledge-point/title "Finding the Triangular Factor of a QR Factorization Given the Orthogonal Factor"} :step/id #uuid "4035e4b7-aa8c-56a6-be26-0855ad0ce971" :step/math-academy-id 31108 :step/next {:db/id #edb/ref 17592186134802}} {:db/id #edb/ref 17592186134799 :step/content {:db/id #edb/ref 17592186133863 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133679 :question/id #uuid "155ed7f9-909e-5550-b1ef-f707b49f7fde" :question/math-academy-id "e-8325"} :knowledge-point/id #uuid "1ed5119c-5ce8-52dc-bd57-f9439ea199e6" :knowledge-point/questions [{:db/id #edb/ref 17592186134316} {:db/id #edb/ref 17592186134356} {:db/id #edb/ref 17592186363224} {:db/id #edb/ref 17592186363231} {:db/id #edb/ref 17592186364613} {:db/id #edb/ref 17592186380318} {:db/id #edb/ref 17592186395093} {:db/id #edb/ref 17592186395100} {:db/id #edb/ref 17592186415504} {:db/id #edb/ref 17592186415505} {:db/id #edb/ref 17592186432330}] :knowledge-point/title "Finding a QR Factorization of a Matrix Given a Matrix With Orthogonal Columns"} :step/id #uuid "133bd600-5eaf-5eaa-99fa-64b4c2a014a2" :step/math-academy-id 31109 :step/next {:db/id #edb/ref 17592186134694}} {:db/id #edb/ref 17592186134800 :step/content {:db/id #edb/ref 17592186133864 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133680 :question/id #uuid "35fdd570-1c80-5b0d-9c5f-fa277bd30afb" :question/math-academy-id "e-8326"} :knowledge-point/id #uuid "1304189f-61ac-53c5-9b09-8e365f763136" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049811} {:db/id #edb/ref 17592186050283} {:db/id #edb/ref 17592186050656}] :knowledge-point/questions [{:db/id #edb/ref 17592186134546} {:db/id #edb/ref 17592186134548} {:db/id #edb/ref 17592186363203} {:db/id #edb/ref 17592186363210} {:db/id #edb/ref 17592186364571} {:db/id #edb/ref 17592186364578} {:db/id #edb/ref 17592186432327} {:db/id #edb/ref 17592186432328} {:db/id #edb/ref 17592186432331}] :knowledge-point/title "Identifying Dimensions of Factors in a QR Factorization"} :step/id #uuid "28dbf6ab-32c9-578d-b6cd-07619f45dc9d" :step/math-academy-id 31119 :step/next {:db/id #edb/ref 17592186134801}} {:db/id #edb/ref 17592186134801 :step/content {:db/id #edb/ref 17592186135097 :tutorial/content "Given the matrix $Q$ in the QR factorization of an $m\\times n$ matrix $A,$ how do we find $R?$\n\nRecall that $Q$ has orthonormal columns, so pre-multiplying both sides of $A=QR$ by $Q^T,$ we obtain\n\n$$\n\\begin{aligned}{Q}^{T}\\cdot A & ={Q}^{T}\\cdot QR \\\\ {Q}^{T}A & ={Q}^{T}QR.\\end{aligned}\n$$\n\nNow, note that since the columns of $Q$ are orthonormal we have $Q^TQ = I_n.$ Therefore,\n\n$$\n\\begin{aligned}{Q}^{T}A & =({Q}^{T}Q)R \\\\ {Q}^{T}A & ={I}_{n}R \\\\ R & ={Q}^{T}A.\\end{aligned}\n$$\n\nSo, we can find $R$ by pre-multiplying $A$ by the transpose of $Q.$" :tutorial/id #uuid "20b6ab0a-cf41-550b-9242-2bb3f84c4917" :tutorial/math-academy-id 5017 :tutorial/title "Computing the Matrix R Given the Matrix Q in a QR Factorization"} :step/id #uuid "eebb9689-f8b3-55e2-8167-e5f5525e382a" :step/math-academy-id 31388 :step/next {:db/id #edb/ref 17592186134798}} {:db/id #edb/ref 17592186134802 :step/content {:db/id #edb/ref 17592186135098 :tutorial/content "Let's consider the QR factorization of the matrix $A$ shown below:\n\n![](images/ee/ee731d95c111101559ad135429198dd7e0b14313272f0933b1c706006da2fbd2.svg)\n\nSuppose also that we are given the following system of equations that connects the columns of $Q$ and the columns of $A{:}$  \n\n$$\n\\{\\begin{aligned}{q}_{1}=\\frac{1}{2}{a}_{1} \\\\ {q}_{2}=\\frac{1}{3}{a}_{2}+3{q}_{1} \\\\ {q}_{3}=\\frac{1}{4}{a}_{3}-2{q}_{1}+{q}_{2}\\end{aligned}\n$$\n\nHow do we find $R?$\nFirst, let's rewrite the vectors $\\mathbf{a}_1, \\mathbf{a}_2, \\mathbf{a}_3$ as a linear combination of the vectors $\\mathbf{q}_1, \\mathbf{q}_2, \\mathbf{q}_3 \\mathbin{:}$\n![](images/82/824c39c97bb115768856d672b39be8f65d8b4ecbc2ee5d6ccc9f4943594cbacd.svg)\n\nIn this new system, the coefficients of $\\mathbf{q}_1$ correspond to the first-row entries of $R,$ the coefficients of $\\mathbf{q}_2$ correspond to the second-row entries of $R,$ and the coefficients of $\\mathbf{q}_3$ correspond to the third-row entries of $R.$ Therefore,\n\n![](images/5b/5ba9887a4d9b47963af171e9275319a2564eca5a4ef8b3ef44978e2ff4b111d9.svg)\n\nTo see why this is, we can take the transpose of both sides of $A=QR{:}$\n\n$$\n\\begin{aligned}A & =QR \\\\ {A}^{T} & =(QR)^{T} \\\\ {A}^{T} & ={R}^{T}{Q}^{T} \\\\ \\overset{{A}^{T}}{\\overset{⏞}{\\begin{bmatrix}-\\,\\,\\,\\, & {a}_{1} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {a}_{2} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {a}_{3} & \\,\\,\\,\\,-\\end{bmatrix}}} & =\\overset{{R}^{T}}{\\overset{⏞}{\\begin{bmatrix}2 & 0 & 0 \\\\ -9 & 3 & 0 \\\\ 8 & -4 & 4\\end{bmatrix}}}\\overset{{Q}^{T}}{\\overset{⏞}{\\begin{bmatrix}-\\,\\,\\,\\, & {q}_{1} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {q}_{2} & \\,\\,\\,\\,- \\\\ -\\,\\,\\,\\, & {q}_{3} & \\,\\,\\,\\,-\\end{bmatrix}}}\\end{aligned}\n$$\n\nIf we were to expand this matrix product, we would obtain our system of equations." :tutorial/id #uuid "9a6d9a3e-33d4-52e8-b8b0-98cd20590dd6" :tutorial/math-academy-id 5018 :tutorial/title "Interpreting Relations Between Two Bases as Matrix Multiplication"} :step/id #uuid "fdc0053f-e37d-51ef-835e-365ca5c6da98" :step/math-academy-id 31389 :step/next {:db/id #edb/ref 17592186134732}} {:db/id #edb/ref 17592186134803 :step/content {:db/id #edb/ref 17592186135099 :tutorial/content "Let's now go through the QR factorization algorithm to find the factorization of the matrix\n\n![](images/f0/f0d468f6bce43491b3f97d10185f4393ae8e64198e24bb7708ad66ec57c73df4.svg)\n\n**Step 1**. Orthogonalize the columns of $A$ to get the columns of $Q.$ Using the Gram-Schmidt process, we obtain\n\n$$\n\\begin{aligned}{q}_{1}=\\frac{1}{3}\\begin{bmatrix}1 \\\\ 2 \\\\ -2\\end{bmatrix},\\,{q}_{2}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 \\\\ 1 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\n**Step 2**. Compute $R=Q^TA.$ We get\n\n$$\n\\begin{aligned}R=\\begin{bmatrix}6 & 3 \\\\ 0 & \\sqrt{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, the QR factorization of $A$ is\n\n![](images/7f/7f0face80ec3823f73e958fae5b78b12641204a8858bb2c8a7677be9827b919d.svg)" :tutorial/id #uuid "c2f59e79-8a0c-543b-8af0-381e95a18a8a" :tutorial/math-academy-id 5019 :tutorial/title "The QR Factorization Algorithm"} :step/id #uuid "94bcb87e-b43a-5740-aaed-1937658ca1d1" :step/math-academy-id 31390 :step/next {:db/id #edb/ref 17592186134799}}] :activity/title "QR Factorization" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186134008}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186415509} :activity/id #uuid "f7ca9485-c354-51f0-90ca-0b615f92c75d" :activity/scope {:db/id #edb/ref 17592186050130 :topic/id #uuid "2f232786-4262-5d64-9c58-1578e8c629d2" :topic/math-academy-id 2129} :activity/steps [{:db/id #edb/ref 17592186415507 :step/content {:db/id #edb/ref 17592186415504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25368ac6-b32f-5b26-8c46-331ac1522f54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186415487} {:answer/id #uuid "a0313793-4999-5aed-ac02-21acda57bbd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186415493} {:answer/id #uuid "aff7607c-ce12-5a45-9cb9-bbc45508055e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{\\sqrt{6}}" :db/id #edb/ref 17592186415495} {:answer/id #uuid "ddbdf48a-0960-5123-be14-52d24536ef82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186415499} {:answer/id #uuid "e6e0f3fd-8867-5cbf-95df-3e0275090b4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186415500}] :answer-field/correct {:db/id #edb/ref 17592186415487} :answer-field/id #uuid "9c762c76-71d9-5aca-b185-d376fcab2ad5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415503}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3591a132-7ac4-53c0-88c4-ee928e48a3a0" :question/math-academy-id "q-95943" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ 1 & 2 \\\\ -2 & 1\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{bmatrix}}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${a}_{1},{a}_{2}$ of $A$ are orthogonal, and that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained by normalizing the columns of $A,$ what is the value of ${q}_{31}\\cdot {r}_{11}?$" :question/worked-solution "Since the columns of $A$ are already orthogonal, to construct an orthogonal matrix $Q,$ we simply normalize ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{a}_{1}}{‖{a}_{1}‖}=\\frac{1}{\\sqrt{6}}\\begin{bmatrix}1 \\\\ 1 \\\\ -2\\end{bmatrix} \\\\ {q}_{2} & =\\frac{{a}_{2}}{‖{a}_{2}‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}0 \\\\ 2 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, pre-multiplying both sides of $A=QR$ by ${Q}^{T},$ we obtain\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =\\begin{bmatrix}\\frac{1}{\\sqrt{6}} & \\frac{1}{\\sqrt{6}} & -\\frac{2}{\\sqrt{6}} \\\\ 0 & \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ 1 & 2 \\\\ -2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\sqrt{6} & 0 \\\\ 0 & \\sqrt{5}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ 1 & 2 \\\\ -2 & 1\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}\\frac{1}{\\sqrt{6}} & 0 \\\\ \\frac{1}{\\sqrt{6}} & \\frac{2}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{6}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}\\sqrt{6} & 0 \\\\ 0 & \\sqrt{5}\\end{bmatrix}}}\n$$\n\nFinally, ${q}_{31}\\cdot {r}_{11}=-\\frac{2}{\\sqrt{6}}\\cdot \\sqrt{6}=-2.$"} :step/id #uuid "1006efc9-a233-5dd8-9108-e598aeab968e" :step/next {:db/id #edb/ref 17592186415508}} {:db/id #edb/ref 17592186415508 :step/content {:db/id #edb/ref 17592186415505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15f4dfc0-0618-5204-93e9-55df6839e9be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186415486} {:answer/id #uuid "320cae01-cb6d-546b-8fae-e515a79d9a94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186415489} {:answer/id #uuid "4258535d-b0d0-5712-835e-79ab5aee8c99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186415490} {:answer/id #uuid "7422fe19-732e-5581-b615-9ad03e55d8f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186415492} {:answer/id #uuid "d0567542-26c9-51bb-b549-cf91536f2136" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186415498}] :answer-field/correct {:db/id #edb/ref 17592186415492} :answer-field/id #uuid "84ec1a22-6484-5de6-851b-ba1cc03d10d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415502}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8b80e943-ecec-54be-8ddd-ec70be544570" :question/math-academy-id "q-96027" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}7 & 0 \\\\ 4 & 1 \\\\ 4 & -1\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{bmatrix}}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${a}_{1},{a}_{2}$ of $A$ are orthogonal, and that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained by normalizing the columns of $A,$ what is the value of ${q}_{22}\\cdot {r}_{22}?$" :question/worked-solution "Since the columns of $A$ are already orthogonal, to construct an orthogonal matrix $Q,$ we simply normalize ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{a}_{1}}{‖{a}_{1}‖}=\\frac{1}{9}\\begin{bmatrix}7 \\\\ 4 \\\\ 4\\end{bmatrix} \\\\ {q}_{2} & =\\frac{{a}_{2}}{‖{a}_{2}‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, pre-multiplying both sides of $A=QR$ by ${Q}^{T},$ we obtain\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =\\begin{bmatrix}\\frac{7}{9} & \\frac{4}{9} & \\frac{4}{9} \\\\ 0 & \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}\\begin{bmatrix}7 & 0 \\\\ 4 & 1 \\\\ 4 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & 0 \\\\ 0 & \\sqrt{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}7 & 0 \\\\ 4 & 1 \\\\ 4 & -1\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}\\frac{7}{9} & 0 \\\\ \\frac{4}{9} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{4}{9} & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}9 & 0 \\\\ 0 & \\sqrt{2}\\end{bmatrix}}}\n$$\n\nFinally, ${q}_{22}\\cdot {r}_{22}=\\frac{1}{\\sqrt{2}}\\cdot \\sqrt{2}=1.$"} :step/id #uuid "87cf8b28-f8dc-55f0-8421-e0d47143c136"} {:db/id #edb/ref 17592186415509 :step/content {:db/id #edb/ref 17592186415506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c232a99-6645-5177-89dc-66f13905956a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "13" :db/id #edb/ref 17592186415488} {:answer/id #uuid "713fedd8-bf09-5849-a1cc-c36eb8963d22" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186415491} {:answer/id #uuid "ad2e1681-8914-5558-96cf-ff55332d7ba4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186415494} {:answer/id #uuid "bdaadcc3-b0d6-5daa-b301-47336aa1a8b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186415496} {:answer/id #uuid "cbb4da72-b7ae-5fa0-aa7f-27b95ecda700" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186415497}] :answer-field/correct {:db/id #edb/ref 17592186415497} :answer-field/id #uuid "84577b17-c582-5baa-9501-36a73798f439" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415501}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a03feca5-d649-5b96-991d-3e2972b12233" :question/math-academy-id "q-95937" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} & {r}_{13} \\\\ 0 & {r}_{22} & {r}_{23} \\\\ 0 & 0 & {r}_{33}\\end{bmatrix}}}\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. You're given that the system of equations given below connects the columns of $Q$ and the columns of $A.$  \n\n$$\n\\{\\begin{aligned}{q}_{1}=\\frac{1}{3}{a}_{1} \\\\ {q}_{2}=\\frac{1}{2}{a}_{2}+{q}_{1} \\\\ {q}_{3}=\\frac{1}{4}{a}_{3}-{q}_{1}+2{q}_{2}\\end{aligned}\n$$\n\nWhat is the value of ${r}_{11}+{r}_{12}+{r}_{33}?$" :question/worked-solution "Let's rewrite the vectors ${a}_{1},{a}_{2},{a}_{3}$ as a linear combination of the vectors ${q}_{1},{q}_{2},{q}_{3}:$\n\n$$\n\\{\\begin{aligned}{q}_{1}=\\frac{1}{3}{a}_{1} \\\\ {q}_{2}=\\frac{1}{2}{a}_{2}+{q}_{1} \\\\ {q}_{3}=\\frac{1}{4}{a}_{3}-{q}_{1}+2{q}_{2}\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{a}_{1}=3{q}_{1} \\\\ {a}_{2}=-2{q}_{1}+2{q}_{2} \\\\ {a}_{3}=4{q}_{1}-8{q}_{2}+4{q}_{3}.\\end{aligned}\n$$\n\nTherefore, this system can be written in matrix form as follows:\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}3 & -2 & 4 \\\\ 0 & 2 & -8 \\\\ 0 & 0 & 4\\end{bmatrix}}}\n$$\n\nTherefore, \n\n$$\n{r}_{11}+{r}_{12}+{r}_{33}=3+(-2)+4=5.\n$$"} :step/id #uuid "9bf831d4-54e0-54a1-8ba6-7a632201fee0" :step/next {:db/id #edb/ref 17592186415507}}] :activity/title "QR Factorization" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186415485}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186442814} :activity/id #uuid "4001c9a4-1021-5a1b-9693-811b63a41207" :activity/scope {:db/id #edb/ref 17592186050130 :topic/id #uuid "2f232786-4262-5d64-9c58-1578e8c629d2" :topic/math-academy-id 2129} :activity/steps [{:db/id #edb/ref 17592186442811 :step/content {:db/id #edb/ref 17592186395100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c73f4b81-f7c2-58b3-ba59-81c1cb4e21d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186395102} {:answer/id #uuid "2965e000-8ed9-5b43-8807-b337179e3e72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186395103} {:answer/id #uuid "f728b525-0316-5b5a-bee0-0f67b27c8544" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186395104} {:answer/id #uuid "5578869c-e22f-59c6-b9c4-7f6a4a040091" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186395105} {:answer/id #uuid "db6dd2c4-cdf3-588c-b826-6965e60d9428" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186395106}] :answer-field/correct {:db/id #edb/ref 17592186395105} :answer-field/id #uuid "d8d465ac-6125-5625-8e53-c378575651c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186395101}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a11a1ea5-30ff-5154-92c7-cf0778166ca7" :question/math-academy-id "q-96026" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & 6 \\\\ 0 & 2 \\\\ -2 & 3\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{bmatrix}}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${a}_{1},{a}_{2}$ of $A$ are orthogonal, and that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained by normalizing the columns of $A,$ what is the value of ${q}_{31}\\cdot {r}_{12}?$" :question/worked-solution "Since the columns of $A$ are already orthogonal, to construct an orthogonal matrix $Q,$ we simply normalize ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{a}_{1}}{‖{a}_{1}‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}1 \\\\ 0 \\\\ -2\\end{bmatrix} \\\\ {q}_{2} & =\\frac{{a}_{2}}{‖{a}_{2}‖}=\\frac{1}{7}\\begin{bmatrix}6 \\\\ 2 \\\\ 3\\end{bmatrix}\\end{aligned}\n$$\n\nNow, pre-multiplying both sides of $A=QR$ by ${Q}^{T},$ we obtain\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & 0 & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{6}{7} & \\frac{2}{7} & \\frac{3}{7}\\end{bmatrix}\\begin{bmatrix}1 & 6 \\\\ 0 & 2 \\\\ -2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\sqrt{5} & 0 \\\\ 0 & 7\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we have the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}1 & 6 \\\\ 0 & 2 \\\\ -2 & 3\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & \\frac{6}{7} \\\\ 0 & \\frac{2}{7} \\\\ -\\frac{2}{\\sqrt{5}} & \\frac{3}{7}\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}\\sqrt{5} & 0 \\\\ 0 & 7\\end{bmatrix}}}\n$$\n\nFinally, ${q}_{31}\\cdot {r}_{12}=-\\frac{2}{\\sqrt{5}}\\cdot 0=0.$"} :step/id #uuid "24c95cd3-c302-51a3-abac-08bfbbb757dc" :step/next {:db/id #edb/ref 17592186442815}} {:db/id #edb/ref 17592186442812 :step/content {:db/id #edb/ref 17592186134354 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5efe4aae-2768-528f-a3cc-4c9b9a907391" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186379830} {:answer/id #uuid "a5705d08-f2bc-5a4f-b1ab-65641a5b0ae3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "26" :db/id #edb/ref 17592186379831} {:answer/id #uuid "bf62a0e5-63e3-5e42-889b-986f2738de40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-20" :db/id #edb/ref 17592186379832} {:answer/id #uuid "e87b5762-481c-57bd-ba1b-c18fef4d4c0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186379833} {:answer/id #uuid "411c482c-f2e8-5cb9-b82c-84752b240dce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186379834}] :answer-field/correct {:db/id #edb/ref 17592186379831} :answer-field/id #uuid "a20ad309-608a-5c10-aca7-0636d5c13dac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186379829}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "9fc92fc5-cd9a-5882-b3a5-3c9b7ba00cb3" :question/math-academy-id "q-41417" :question/problem "$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ \\frac{{v}_{1}}{‖{v}_{1}‖} & \\frac{{v}_{2}}{‖{v}_{2}‖} & \\frac{{v}_{3}}{‖{v}_{3}‖} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}{r}_{11} & {r}_{12} & {r}_{13} \\\\ 0 & {r}_{22} & {r}_{23} \\\\ 0 & 0 & {r}_{33}\\end{bmatrix}}}\n$$\n\nConsider the QR factorization of the matrix $A$ shown above, where $\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set of vectors. You're given that $‖{v}_{1}‖=4,$ $‖{v}_{2}‖=2,$ $‖{v}_{3}‖=6,$ and that the system of equations below describes the relationship between the columns of $Q$ and the columns of $A.$ \n\n$$\n\\{\\begin{aligned}{v}_{1}={a}_{1} \\\\ {v}_{2}={a}_{2}-2{v}_{1} \\\\ {v}_{3}={a}_{3}-4{v}_{1}+3{v}_{2}\\end{aligned}\n$$\n\nWhat is the value of ${r}_{11}+{r}_{13}+{r}_{33}?$" :question/worked-solution "First, we normalize the vectors ${v}_{1},{v}_{2},{v}_{3}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{{v}_{1}}{4}\\,⟹\\,{v}_{1}=4{q}_{1} \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{{v}_{2}}{2}\\,⟹\\,{v}_{2}=2{q}_{2} \\\\ {q}_{3} & =\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{{v}_{3}}{6}\\,⟹\\,{v}_{3}=6{q}_{3}.\\end{aligned}\n$$\n\nNow, the set $\\{{q}_{1},{q}_{2},{q}_{3}\\}$ will be both orthogonal and normalized.\n\nNext, let's rewrite the vectors ${a}_{1},{a}_{2},{a}_{3}$ as a linear combination of the vectors ${q}_{1},{q}_{2},{q}_{3}:$\n\n$$\n\\{\\begin{aligned}{v}_{1}={a}_{1} \\\\ {v}_{2}={a}_{2}-2{v}_{1} \\\\ {v}_{3}={a}_{3}-4{v}_{1}+3{v}_{2}\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{a}_{1}={v}_{1}=4{q}_{1} \\\\ {a}_{2}=2{v}_{1}+{v}_{2}=8{q}_{1}+2{q}_{2} \\\\ {a}_{3}=4{v}_{1}-3{v}_{2}+{v}_{3}=16{q}_{1}-6{q}_{2}+6{q}_{3}\\end{aligned}\n$$\n\nThe final system can be written in matrix form as follows:\n\n$$\n\\overset{A}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {a}_{1} & {a}_{2} & {a}_{3} \\\\ | & | & |\\end{bmatrix}}}=\\overset{Q}{\\overset{⏞}{\\begin{bmatrix}| & | & | \\\\ {q}_{1} & {q}_{2} & {q}_{3} \\\\ | & | & |\\end{bmatrix}}}\\overset{R}{\\overset{⏞}{\\begin{bmatrix}4 & 8 & 16 \\\\ 0 & 2 & -6 \\\\ 0 & 0 & 6\\end{bmatrix}}}\n$$\n\nTherefore, \n\n$$\n{r}_{11}+{r}_{13}+{r}_{33}=4+16+6=26.\n$$"} :step/id #uuid "2813bf88-52e1-5e7e-aeff-5a25b21a24b4" :step/next {:db/id #edb/ref 17592186442813}} {:db/id #edb/ref 17592186442813 :step/content {:db/id #edb/ref 17592186415506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c232a99-6645-5177-89dc-66f13905