 & 0 \\\\ 2 & 4 \\\\ 2 & 8\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{aligned}]}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained from the columns of $A$ using the Gram-Schmidt process, find  the value of ${q}_{11}\\cdot {r}_{12}.$" #edb/ref 17592186045417] [17592186510371 #edb/ref 1072 #uuid "1ccedda5-a7d6-563d-a624-831df95d1f38" #edb/ref 17592186045417] [17592186510371 #edb/ref 1074 "Let ${a}_{1},{a}_{2}$ be the columns of $A.$\n\nFirst, we find an orthonormal basis of $\\text{Col}(A)=\\text{Span}\\{{a}_{1},{a}_{2}\\}$ using the Gram-Schmidt process.\n\n**Step 1**. We set ${v}_{1}={a}_{1}=[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}].$\n\n**Step 2**. We find the vector ${v}_{2}$ orthogonal to $\\text{Span}\\{{v}_{1}\\}$ using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =[\\begin{aligned}0 \\\\ 4 \\\\ 8\\end{aligned}]-\\frac{24}{12}[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 4 \\\\ 8\\end{aligned}]-2[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 0 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nNext, we normalize ${v}_{1}$ and ${v}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{2\\sqrt{3}}[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]=\\frac{1}{\\sqrt{3}}[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{4\\sqrt{2}}[\\begin{aligned}4 \\\\ 0 \\\\ 4\\end{aligned}]=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute $R:$\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =[\\begin{aligned}-\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}][\\begin{aligned}-2 & 0 \\\\ 2 & 4 \\\\ 2 & 8\\end{aligned}] \\\\  & =[\\begin{aligned}2\\sqrt{3} & 4\\sqrt{3} \\\\ 0 & 4\\sqrt{2}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we obtain the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}-2 & 0 \\\\ 2 & 4 \\\\ 2 & 8\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}-\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{3}} & 0 \\\\ \\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}2\\sqrt{3} & 4\\sqrt{3} \\\\ 0 & 4\\sqrt{2}\\end{aligned}]}}.\n$$\n\nFinally, ${q}_{12}\\cdot {r}_{22}=(-\\frac{1}{\\sqrt{3}})\\cdot (4\\sqrt{3})=-4.$" #edb/ref 17592186045417] [17592186510452 #edb/ref 1068 #edb/ref 17592186510267 #edb/ref 17592186045417] [17592186510452 #edb/ref 1069 "q-96041" #edb/ref 17592186045417] [17592186510452 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186510452 #edb/ref 1071 "$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}2 & 3 \\\\ -2 & 1 \\\\ 2 & 1\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{aligned}]}}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained from the columns of $A$ using the Gram-Schmidt process, find  the value of ${q}_{22}\\cdot {r}_{22}.$" #edb/ref 17592186045417] [17592186510452 #edb/ref 1072 #uuid "ca2de93c-f55b-512e-9e27-ab6ff5bd3cb0" #edb/ref 17592186045417] [17592186510452 #edb/ref 1074 "Let ${a}_{1},{a}_{2}$ be the columns of $A.$\n\nFirst, we find an orthonormal basis of $\\text{Col}(A)=\\text{Span}\\{{a}_{1},{a}_{2}\\}$ using the Gram-Schmidt process.\n\n**Step 1**. We set ${v}_{1}={a}_{1}=[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}].$\n\n**Step 2**. We find the vector ${v}_{2}$ orthogonal to $\\text{Span}\\{{v}_{1}\\}$ using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =[\\begin{aligned}3 \\\\ 1 \\\\ 1\\end{aligned}]-\\frac{6}{12}[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 1 \\\\ 1\\end{aligned}]-\\frac{1}{2}[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nNext, we normalize ${v}_{1}$ and ${v}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{2\\sqrt{3}}[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}] \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{2\\sqrt{2}}[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute $R:$\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{3}} & -\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} & 0\\end{aligned}][\\begin{aligned}2 & 3 \\\\ -2 & 1 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2\\sqrt{3} & \\sqrt{3} \\\\ 0 & 2\\sqrt{2}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we obtain the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}2 & 3 \\\\ -2 & 1 \\\\ 2 & 1\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{3}} & 0\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}2\\sqrt{3} & \\sqrt{3} \\\\ 0 & 2\\sqrt{2}\\end{aligned}]}}.\n$$\n\nFinally, ${q}_{22}\\cdot {r}_{22}=(\\frac{1}{\\sqrt{2}})\\cdot (2\\sqrt{2})=2.$" #edb/ref 17592186045417] [17592186510504 #edb/ref 1058 #edb/ref 17592186510563 #edb/ref 17592186045