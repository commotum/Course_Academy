17] [17592186537590 #edb/ref 1083 #uuid "b9910e6d-7274-5ad8-9582-87f427993b41" #edb/ref 17592186045417] [17592186537601 #edb/ref 1080 "17" #edb/ref 17592186045417] [17592186537601 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186537601 #edb/ref 1083 #uuid "bfddd2cc-fb5b-506f-910b-2fc1d8be0dba" #edb/ref 17592186045417] [17592186537619 #edb/ref 1080 "$200$ units per month" #edb/ref 17592186045417] [17592186537619 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186537619 #edb/ref 1083 #uuid "c7c2e2ef-4e7c-53d2-a226-3d5810d7e74d" #edb/ref 17592186045417] [17592186537639 #edb/ref 1080 "$40$ units per month" #edb/ref 17592186045417] [17592186537639 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186537639 #edb/ref 1083 #uuid "d1f9e17b-f328-54e4-ab9d-74a99d605704" #edb/ref 17592186045417] [17592186537705 #edb/ref 1080 "$500$ units per month" #edb/ref 17592186045417] [17592186537705 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186537705 #edb/ref 1083 #uuid "e9e0e802-95ad-550c-9901-8b89631a6f48" #edb/ref 17592186045417] [17592186537740 #edb/ref 1080 "$250$ units per month" #edb/ref 17592186045417] [17592186537740 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186537740 #edb/ref 1083 #uuid "f906ef92-e5c6-577b-a75e-78d163c0e750" #edb/ref 17592186045417] [17592186537780 #edb/ref 1075 #edb/ref 17592186537291 #edb/ref 17592186045417] [17592186537780 #edb/ref 1075 #edb/ref 17592186537397 #edb/ref 17592186045417] [17592186537780 #edb/ref 1075 #edb/ref 17592186537456 #edb/ref 17592186045417] [17592186537780 #edb/ref 1075 #edb/ref 17592186537590 #edb/ref 17592186045417] [17592186537780 #edb/ref 1075 #edb/ref 17592186537601 #edb/ref 17592186045417] [17592186537780 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186537780 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186537780 #edb/ref 1078 #edb/ref 17592186537291 #edb/ref 17592186045417] [17592186537780 #edb/ref 1079 #uuid "465ed207-d844-5919-a8df-b87293b0bcf1" #edb/ref 17592186045417] [17592186537801 #edb/ref 1075 #edb/ref 17592186537519 #edb/ref 17592186045417] [17592186537801 #edb/ref 1075 #edb/ref 17592186537619 #edb/ref 17592186045417] [17592186537801 #edb/ref 1075 #edb/ref 17592186537639 #edb/ref 17592186045417] [17592186537801 #edb/ref 1075 #edb/ref 17592186537705 #edb/ref 17592186045417] [17592186537801 #edb/ref 1075 #edb/ref 17592186537740 #edb/ref 17592186045417] [17592186537801 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186537801 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186537801 #edb/ref 1078 #edb/ref 17592186537519 #edb/ref 17592186045417] [17592186537801 #edb/ref 1079 #uuid "68dc796d-0c9f-52c2-87ac-381b9f5b4a1e" #edb/ref 17592186045417] [17592186537849 #edb/ref 1075 #edb/ref 17592186537274 #edb/ref 17592186045417] [17592186537849 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186537849 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186537849 #edb/ref 1078 #edb/ref 17592186537274 #edb/ref 17592186045417] [17592186537849 #edb/ref 1079 #uuid "bb55bb9f-d933-52e4-9689-fefd9cbfbbcf" #edb/ref 17592186045417] [17592186537855 #edb/ref 1075 #edb/ref 17592186537267 #edb/ref 17592186045417] [17592186537855 #edb/ref 1075 #edb/ref 17592186537391 #edb/ref 17592186045417] [17592186537855 #edb/ref 1075 #edb/ref 17592186537432 #edb/ref 17592186045417] [17592186537855 #edb/ref 1075 #edb/ref 17592186537440 #edb/ref 17592186045417] [17592186537855 #edb/ref 1075 #edb/ref 17592186537513 #edb/ref 17592186045417] [17592186537855 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186537855 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186537855 #edb/ref 1078 #edb/ref 17592186537432 #edb/ref 17592186045417] [17592186537855 #edb/ref 1079 #uuid "cbe295f2-3c78-53d7-a4bc-8cad7afb171c" #edb/ref 17592186045417] [17592186537899 #edb/ref 1068 #edb/ref 17592186537801 #edb/ref 17592186045417] [17592186537899 #edb/ref 1069 "q-119056" #edb/ref 17592186045417] [17592186537899 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186537899 #edb/ref 1071 "A company spends $C(x)=0.01{x}^{2}+4x+680$ dollars to produce $x$ units of a certain product. The company sells the product for $$12$ per unit. Given that the company can produce at most $500$ units per month, how many units should the company produce per month to maximize its monthly profit?" #edb/ref 17592186045417] [17592186537899 #edb/ref 1072 #uuid "3238715a-ab0d-5fbe-809b-2aa2ec76dbe8" #edb/ref 17592186045417] [17592186537899 #edb/ref 1074 "To solve this problem, we apply the candidates test.\n\nFirst, note that for selling $x$ units of the product per month, the company has a monthly revenue (income) of $R(x)=12\\cdot x=12x$ dollars. \n\nTherefore, the profit function is given by\n\n$$\n\\begin{aligned}P(x) & =R(x)-C(x) \\\\  & =12x-(0.01{x}^{2}+4x+680) \\\\  & =8x-0.01{x}^{2}-680.\\end{aligned}\n$$\n\nWe note that the permitted domain is $0\\le x\\le 500.$ \n\nWe need to find the critical points of $P(x)$ for $0<x<500.$ Taking the derivative, we get\n\n$$\n{P}^{′}(x)=8-0.02x,\n$$\n\nand solving ${P}^{′}(x)=0$ gives the following critical point:\n\n$$\n\\begin{aligned}{P}^{′}(x) & =0 \\\\ 8-0.02x & =0 \\\\ x & =400\\end{aligned}\n$$\n\nNotice that $x=400$ lies in the interval $0<x<500.$ All that's left now is to confirm that $x=400$ does indeed give a maximum value of $P(x).$ To do this, we compute the second derivative:\n\n$$\n{P}^{″}(x)=-0.02<0\n$$\n\nSince the second derivative is negative, the point $x=400$ is indeed a local maximum of $P(x).$ And since $P(x)$ is quadratic, we conclude that $x=400$ is a global maximum of $P(x).$ \n\nTherefore, we conclude that the company will have a maximum monthly profit when it produces $400$ units per month." #edb/ref 17592186045417] [17592186537911 #edb/ref 1068 #edb/ref 17592186537855 #edb/ref 17592186045417] [17592186537911 #edb/ref 1069 "q-87593" #edb/ref 17592186045417] [17592186537911 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186537911 #edb/ref 1071 "A factory spends $C(x)=100-47x+21{x}^{2}-{x}^{3}$ thousand dollars per month to manufacture $x$ units of a certain product. The factory sells the product for $$100\\,000$ per unit. Given that the factory can produce between $1$ and $10$ items per month, what is the maximum monthly profit it can make?" #edb/ref 17592186045417] [17592186537911 #edb/ref 1072 #uuid "4cb999cb-e9bf-5cd0-a21c-a3857e783014" #edb/ref 17592186045417] [17592186537911 #edb/ref 1074 "To solve this problem, we apply the candidates test.\n\nFirst, note that for selling $x$ units of the product per month, the factory has a monthly revenue (income) of $R(x)=100\\cdot x=100x$ thousand dollars. \n\nTherefore, the profit function (in thousands of dollars) is given by\n\n$$\n\\begin{aligned}P(x) & =R(x)-C(x) \\\\  & =100x-(100-47x+21{x}^{2}-{x}^{3}) \\\\  & ={x}^{3}-21{x}^{2}+147x-100.\\end{aligned}\n$$\n\nWe note that the permitted domain is $1\\le x\\le 10.$ Therefore, $x=1$ and $x=10$ are both candidates for the global maxima of $P(x).$\n\nWe need to find the critical points of $P(x)$ for $1<x<10.$ Taking the derivative, we get\n\n$$\n{P}^{′}(x)=3{x}^{2}-42x+147,\n$$\n\nand solving ${P}^{′}(x)=0$ gives the following critical point:\n\n$$\n\\begin{aligned}{P}^{′}(x) & =0 \\\\ 3{x}^{2}-42x+147 & =0 \\\\ {x}^{2}-14x+49 & =0 \\\\ (x-7)^{2} & =0 \\\\ x & =7\\end{aligned}\n$$\n\nLet's check if $x=7$ gives a maximum value of $P(x).$ To do this, we compute the second derivative:\n\n$$\n{P}^{″}(x)=6x-42.\n$$\n\nEvaluating ${P}^{″}(x)$ at the critical point, we get\n\n$$\n\\begin{aligned}{P}^{″}(7)=6(7)-42=0,\\end{aligned}\n$$\n\nwhich does not confirm or deny that $x=7$ is a maximum of $P(x).$ Therefore, we should consider $x=7$ as one of the candidates.\n\nOur candidates are $x=1,$ $x=7$ and $x=10.$ Computing $P(x)$ at each of these values, we get the following:\n\n$$\n\\begin{aligned}P(1) & =(1)^{3}-21(1)^{2}+147(1)-100=27 \\\\ P(7) & =(7)^{3}-21(7)^{2}+147(7)-100=243 \\\\ P(10) & =(10)^{3}-21(10)^{2}+147(10)-100=270\\,✓\\end{aligned}\n$$\n\nTherefore, the maximum monthly profit is $270\\cdot $1\\,000=$270\\,000.$" #edb/ref 17592186045417] [17592186537936 #edb/ref 1068 #edb/ref 17592186537849 #edb/ref 17592186045417] [17592186537936 #edb/ref 1069 "q-347278" #edb/ref 17592186045417] [17592186537936 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186537936 #edb/ref 1071 "A tutoring center offers private lesson packages. When the price of a package is $$40,$ the center books all $80$ available sessions. For every $$4$ increase in the package price, one fewer session is booked. If the cost of providing each session is $$16,$ what price should the center charge to maximize its profit?\n\nTo maximize profit, the center should charge $$$\n{{field-1}}\nper session." #edb/ref 17592186045417] [17592186537936 #edb/ref 1072 #uuid "7f361b6d-88da-56f4-bb4f-1191d0218d94" #edb/ref 17592186045417] [17592186537936 #edb/ref 1074 "To solve this problem, we apply the candidates test.\n\nLet $x$ represent the number of unbooked sessions. Then the number of **booked** sessions is $(80-x),$ and the **price per session** is $(40+4x).$\n\nSo, the total revenue is\n\n$$\nR(x)=(80-x)(40+4x).\n$$\n\nExpanding, we get\n\n$$\nR(x)=-4{x}^{2}+280x+3200.\n$$\n\nThe cost of providing each booked session is $$16,$ so the total cost is\n\n$$\nC(x)=16(80-x)=1280-16x.\n$$\n\nTherefore, the profit function is\n\n$$\n\\begin{aligned}P(x) & =R(x)-C(x) \\\\  & =(-4{x}^{2}+280x+3200)-(1280-16x) \\\\  & =-4{x}^{2}+296x+1920.\\end{aligned}\n$$\n\nWe are given the domain $0\\le x\\le 80.$\n\nTo find the maximum, we take the derivative:\n\n$$\n{P}^{′}(x)=-8x+296.\n$$\n\nSolving ${P}^{′}(x)=0,$ we get:\n\n$$\nx=37.\n$$\n\nSince ${P}^{″}(x)=-8<0,$ this point is a maximum. Since $P(x)$ is quadratic, this maximum is global.\n\nNow, if $x=37$ sessions are unbooked, then the price is:\n\n$$\n40+4(37)=188.\n$$\n\nTherefore, to maximize profit, the center should charge $$\\,\\,188$ per session." #edb/ref 17592186045417] [17592186537977 #edb/ref 1068 #edb/ref 17592186537780 #edb/ref 17592186045417] [17592186537977 #edb/ref 1069 "q-87576" #edb/ref 17592186045417] [17592186537977 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186537977 #edb/ref 1071 "A daycare center can take care of between $10$ and $20$ children. The fee that parents must pay each month depends on the number of children enrolled in the center. If there are $10$ children enrolled, parents must pay $$40.$ On the other hand, if there are more than $10$ children enrolled, the price drops by $$2$ for each child. All the parents pay the same monthly fee.\n\nHow many children must enroll for the center to maximize its revenue?" #edb/ref 17592186045417] [17592186537977 #edb/ref 1072 #uuid "da64bda4-339a-50c3-828b-c79ac0fe60b0" #edb/ref 17592186045417] [17592186537977 #edb/ref 1074 "First, note that if there are $10+x$ children enrolled, then the monthly fee is $40-2x.$ So, the total revenue is given by\n\n$$\n\\begin{aligned}R(x) & ={{(10+x)}_{⏟}}_{\\text{number of children enrolled}}\\times \\,\\,\\,\\,\\,\\,{{(40-2x)}_{⏟}}_{\\text{monthly fee}} \\\\  & =(10+x)(40-2x) \\\\  & =400-20x+40x-2{x}^{2} \\\\  & =400+20x-2{x}^{2}.\\end{aligned}\n$$\n\nSince the center can only take care between $10$ and $20$ children, the permitted domain for $x$ is given by\n\n$$\n\\begin{aligned}10 & \\le x+10\\le 20 \\\\ 0 & \\le x\\le 10.\\end{aligned}\n$$\n\nTherefore, $x=0$ and $x=10$ are both candidates for the global maxima of $R(x).$\n\nWe need to find the critical points of $R(x)$ for $0<x<10.$ Taking the derivative, we get\n\n$$\n{R}^{′}(x)=20-4x,\n$$\n\nand solving ${R}^{′}(x)=0$ gives the following critical point:\n\n$$\n\\begin{aligned}{R}^{′}(x) & =0 \\\\ 20-4x & =0 \\\\ 4x & =20 \\\\ x & =5\\end{aligned}\n$$\n\nNotice that $x=5$ lies in the interval $0<x<10.$ All that's left now is to confirm that $x=5$ does indeed give a maximum value of $R(x).$ To do this, we compute the second derivative:\n\n$$\n{R}^{″}(x)=-4<0\n$$\n\nSince the second derivative is negative, the point $x=5$ is indeed a local maximum of $R(x).$ And since $R(x)$ is quadratic, we conclude that $x=5$ is a global maximum of $R(x).$ \n\nTherefore, the center must have $10+5=15$ children enrolled to maximize its revenue." #edb/ref 17592186045417] [17592186537999 #edb/ref 1058 #edb/ref 17592186538047 #edb/ref 17592186045417] [17592186537999 #edb/ref 1062 #uuid "1e9fa964-7041-5ffc-83b1-6b0438a925d8" #edb/ref 17592186045417] [17592186537999 #edb/ref 1063 #edb/ref 17592186101196 #edb/ref 17592186045417] [17592186538019 #edb/ref 1058 #edb/ref 17592186538052 #edb/ref 17592186045417] [17592186538019 #edb/ref 1062 #uuid "4dd5af7f-a91c-54b8-878b-4a18da96bc9b" #edb/ref 17592186045417] [17592186538019 #edb/ref 1063 #edb/ref 17592186537911 #edb/ref 17592186045417] [17592186538028 #edb/ref 1062 #uuid "6df0f32d-2973-5214-b35a-1fd2363c1870" #edb/ref 17592186045417] [17592186538028 #edb/ref 1063 #edb/ref 17592186537936 #edb/ref 17592186045417] [17592186538047 #edb/ref 1058 #edb/ref 17592186538019 #edb/ref 17592186045417] [17592186538047 #edb/ref 1062 #uuid "b36a3f97-5787-5772-8e16-fde45721c2ca" #edb/ref 17592186045417] [17592186538047 #edb/ref 1063 #edb/ref 17592186537977 #edb/ref 17592186045417] [17592186538052 #edb/ref 1058 #edb/ref 17592186538028 #edb/ref 17592186045417] [17592186538052 #edb/ref 1062 #uuid "c2ce17c2-aa7c-5e08-a132-c77e2f0ad3b4" #edb/ref 17592186045417] [17592186538052 #edb/ref 1063 #edb/ref 17592186537899 #edb/ref 17592186045417]}
