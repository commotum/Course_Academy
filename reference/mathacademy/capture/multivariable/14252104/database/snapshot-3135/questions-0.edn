#{[{:db/id #edb/ref 17592186371492 :knowledge-point/_questions [{:db/id #edb/ref 17592186054638 :knowledge-point/id #uuid "0e22a7b0-753b-51b1-8946-5d17456aa778" :knowledge-point/title "Computing the Cardinality of a Power Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a67d5a23-bfa3-56a6-b05b-7ddb95338a69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186371494} {:answer/id #uuid "21d857de-2040-542d-b96a-1fc210f9a495" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186371495} {:answer/id #uuid "797c0042-26a0-53d4-a049-6254bb7948fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186371496} {:answer/id #uuid "39be407b-8c19-569c-b139-c69c89ee81be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186371497} {:answer/id #uuid "fd12abb9-c760-5f0a-87ac-35fbd3c0084f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186371498}] :answer-field/correct {:answer/id #uuid "21d857de-2040-542d-b96a-1fc210f9a495" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186371495} :answer-field/id #uuid "1e79d4fd-a723-57a7-88cf-5022dcdba8ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371493}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d69634e4-c6ca-59bd-bfdb-d95ce02309d9" :question/math-academy-id "q-105148" :question/problem "If $E={\\delta }$, then $|P(E)|=$" :question/worked-solution "For any set $E,$ we have $|P(E)|={2}^{|E|}.$ \n\nIn this case, $|E|=1,$ so we have\n\n$$\n|P(E)|={2}^{|E|}={2}^{1}=2.\n$$"}] [{:db/id #edb/ref 17592186262987 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ed2b533-632f-5e72-b5fe-f6baae2c7ccd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463700} {:answer/id #uuid "5386e080-f0b9-543d-8db7-ec93c4a7551d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463701}] :answer-field/correct {:answer/id #uuid "0ed2b533-632f-5e72-b5fe-f6baae2c7ccd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463700} :answer-field/id #uuid "c40f6968-0bca-5774-9886-3bc959e1ef4a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464784} {:answer-field/choices [{:answer/id #uuid "6623661a-2525-5ca6-9734-515449041004" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463702} {:answer/id #uuid "96c3a4b7-5a7c-5d9c-951d-771a83b2e16f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463703}] :answer-field/correct {:answer/id #uuid "6623661a-2525-5ca6-9734-515449041004" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463702} :answer-field/id #uuid "fa9e942e-aaad-54cf-bbc0-e84775866385" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464785} {:answer-field/choices [{:answer/id #uuid "34a7767e-57b9-52a0-84c8-29455641c32d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463704} {:answer/id #uuid "facd7b6d-a0a0-5777-8f5f-c056b8c4ac1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463705}] :answer-field/correct {:answer/id #uuid "facd7b6d-a0a0-5777-8f5f-c056b8c4ac1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463705} :answer-field/id #uuid "c602597d-38bf-59bd-9d48-42d3ba73e05f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464786}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff4bdd6b-fa6c-575f-9520-7b26c79bdb6a" :question/math-academy-id "q-129216" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\operatorname{tan}⁡x?$    \n- **I.** $[0,\\frac{\\pi }{2}]$\n- **II.** $[0,\\frac{\\pi }{4})$\n- **III.** $[-\\frac{\\pi }{4},\\frac{\\pi }{4}]$\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[0,\\frac{\\pi }{2}]$  is closed, but the function is not defined at $x=\\frac{\\pi }{2}.$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[0,\\frac{\\pi }{4})$ is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[-\\frac{\\pi }{4},\\frac{\\pi }{4}]$ is closed, and the function is continuous on $[-\\frac{\\pi }{4},\\frac{\\pi }{4}].$ Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186573289 :knowledge-point/_questions [{:db/id #edb/ref 17592186064310 :knowledge-point/id #uuid "71dd9228-4b05-54d9-aeb2-3bdabf89e0e9" :knowledge-point/title "Differentiating a Quotient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "152b66f7-c7ce-598f-93d8-1e22b704f747" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-3{x}^{2}-20x+4" :db/id #edb/ref 17592186572846} {:answer/id #uuid "61dcae46-646f-5be7-9da2-a6de1d9ed25e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-4{x}^{2}-10x-2" :db/id #edb/ref 17592186572940} {:answer/id #uuid "7c7e4c5a-868b-5f38-b6a3-f41a6a7c3f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-2{x}^{2}-10x+2" :db/id #edb/ref 17592186572983} {:answer/id #uuid "7cee9ed5-127b-5419-a740-825cde47b428" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-4{x}^{2}-10x+4" :db/id #edb/ref 17592186572984} {:answer/id #uuid "c9ae8832-8946-513b-bceb-30925dd4f2ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-3{x}^{2}-20x-4" :db/id #edb/ref 17592186573077}] :answer-field/correct {:answer/id #uuid "7c7e4c5a-868b-5f38-b6a3-f41a6a7c3f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}-2{x}^{2}-10x+2" :db/id #edb/ref 17592186572983} :answer-field/id #uuid "0e4c95de-4b57-5003-8261-a6e1c6a6bcc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573152}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8db2f83d-f6c6-583a-9190-f65543a5bd2c" :question/math-academy-id "q-138836" :question/problem "Consider the function $y=\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{2{e}^{{x}^{2}}g(x)}{({x}^{2}-2x-8)^{3}}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({e}^{{x}^{2}})-\\operatorname{ln}⁡{({x}^{2}-2x-8)}^{2} \\\\ \\operatorname{ln}⁡y & ={x}^{2}-2\\operatorname{ln}⁡({x}^{2}-2x-8)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-2\\operatorname{ln}⁡({x}^{2}-2x-8)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2x-2\\cdot \\frac{1}{{x}^{2}-2x-8}\\cdot (2x-2) \\\\ \\frac{{y}^{′}}{y} & =2x-\\frac{4x-4}{{x}^{2}-2x-8}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(2x-\\frac{4x-4}{{x}^{2}-2x-8})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}(2x-\\frac{4x-4}{{x}^{2}-2x-8}) \\\\  & =\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}(\\frac{2x({x}^{2}-2x-8)-(4x-4)}{{x}^{2}-2x-8}) \\\\  & =\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{3}}(2x({x}^{2}-2x-8)-(4x-4)) \\\\  & =\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{3}}(2{x}^{3}-4{x}^{2}-16x-4x+4) \\\\  & =\\frac{2{e}^{{x}^{2}}({x}^{3}-2{x}^{2}-10x+2)}{({x}^{2}-2x-8)^{3}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)={x}^{3}-2{x}^{2}-10x+2.\n$$"}] [{:db/id #edb/ref 17592186573256 :knowledge-point/_questions [{:db/id #edb/ref 17592186176018 :knowledge-point/id #uuid "9c8893eb-cc9c-59b1-98c8-ec326a352e28" :knowledge-point/title "Evaluating a Limit Using the Alternative Limit Definition of Euler's Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb4fd080-504f-597c-84bf-48ecf4885982" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{\\frac{4}{7}}" :db/id #edb/ref 17592186573082}] :answer-field/correct {:answer/id #uuid "cb4fd080-504f-597c-84bf-48ecf4885982" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{\\frac{4}{7}}" :db/id #edb/ref 17592186573082} :answer-field/id #uuid "7e129902-6deb-5f56-af1c-12c6f695aaf0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573194}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ac40a4c-aba2-5c77-8ace-67895a16cfed" :question/math-academy-id "q-338264" :question/problem "Evaluate the following limit:\n\n${lim}_{n\\to 0}{(1+n)}^{4/7n}=$\n{{field-1}}" :question/worked-solution "Notice that as $n\\to 0,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{n\\to 0}{(1+n)}^{4/7n}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n{lim}_{n\\to 0}{(1+n)}^{1/n}=e\n$$\n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}{lim}_{n\\to 0}{(1+n)}^{4/7n} & ={lim}_{n\\to 0}{[{(1+n)}^{1/n}]}^{4/7} \\\\  & ={[{lim}_{n\\to 0}{(1+n)}^{1/n}]}^{4/7} \\\\  & ={e}^{4/7} \\\\  & =\\sqrt[7]{{e}^{4}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573260 :knowledge-point/_questions [{:db/id #edb/ref 17592186078407 :knowledge-point/id #uuid "3f5c089a-9506-5a0e-83ae-48efa8fd314c" :knowledge-point/title "Recognizing Derivatives in Limits Similar to the Instantaneous Rate of Change Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c00f7de0-d3e0-56cd-9123-ae6834d0e169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2" :db/id #edb/ref 17592186573066}] :answer-field/correct {:answer/id #uuid "c00f7de0-d3e0-56cd-9123-ae6834d0e169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pm 2" :db/id #edb/ref 17592186573066} :answer-field/id #uuid "566ccb36-6055-535a-bafd-ee2a268c69a1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573182}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c781737-7cc2-58de-b406-ca857cb292ed" :question/math-academy-id "q-339011" :question/problem "Find the value of $a$ given that\n\n$$\n{lim}_{h\\to 0}\\frac{(\\frac{1}{a+h}-\\frac{1}{a})}{h}=-\\frac{1}{4}\\,.\n$$\n\n$a=$\n{{field-1}}" :question/worked-solution "First, we let \n\n$$\nL=\\frac{(\\frac{1}{a+h}-\\frac{1}{a})}{h}=-\\frac{1}{4}.\n$$\n\nComparing this with the formula for the instantaneous rate of change,\n\n$$\n{f}^{′}(a)={lim}_{h\\to 0}\\frac{f(a+h)-f(a)}{h},\n$$\n\nwe see that if we let $f(x)=\\frac{1}{x}$, we get\n\n$$\n{f}^{′}(a)={lim}_{h\\to 0}\\frac{(\\frac{1}{a+h}-\\frac{1}{a})}{h}=L.\n$$\n\nThis confirms that $L={f}^{′}(a).$\n\nComputing the derivative, we have\n\n$$\n{f}^{′}(x)=-\\frac{1}{{x}^{2}},\\,{f}^{′}(a)=-\\frac{1}{{a}^{2}},\n$$\n\nand so,  $L=-\\frac{1}{{a}^{2}}.$\n\nFinally, since $L=-\\frac{1}{4},$ we must have\n\n$$\n\\begin{aligned}-\\frac{1}{{a}^{2}} & =-\\frac{1}{4} \\\\ {a}^{2} & =4 \\\\ a & =\\pm 2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314786 :knowledge-point/_questions [{:db/id #edb/ref 17592186184240 :knowledge-point/id #uuid "5a58f115-f368-5171-af73-37084085b42a" :knowledge-point/title "Finding a Limit Involving Trigonometric Functions and Their Inverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aaa8bd9b-23ac-5a6b-aa52-08253648c67f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186313315}] :answer-field/correct {:answer/id #uuid "aaa8bd9b-23ac-5a6b-aa52-08253648c67f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186313315} :answer-field/id #uuid "775fbe06-942a-5f66-b830-7e6bcac4e1aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314329}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f1b72358-e12f-522e-a6d1-8b47c27da23b" :question/math-academy-id "q-339477" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,\\frac{1}{2}}\\operatorname{tan}⁡(2x\\operatorname{arcsin}⁡(x))=$\n{{field-1}}" :question/worked-solution "![](images/24/24f07da42a537ded7916fc2440dcf3ee1ccdfc81c7b027b47e97814fec059f5a.png)\n\nThe domain of $\\operatorname{arcsin}⁡(x)$ is $x\\in [-1,1].$\n\nNow, substituting $x=\\frac{1}{2}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\frac{1}{2}}\\operatorname{tan}⁡(2x\\operatorname{arcsin}⁡(x)) & =\\operatorname{tan}⁡(2\\cdot \\frac{1}{2}\\operatorname{arcsin}⁡(\\frac{1}{2})) \\\\  & =\\operatorname{tan}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{\\sqrt{3}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573290 :knowledge-point/_questions [{:db/id #edb/ref 17592186096836 :knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing a Single Logarithmic Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4245b790-1a22-59f1-b2b1-ec25d43743c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3({e}^{2}+1)" :db/id #edb/ref 17592186572902}] :answer-field/correct {:answer/id #uuid "4245b790-1a22-59f1-b2b1-ec25d43743c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3({e}^{2}+1)" :db/id #edb/ref 17592186572902} :answer-field/id #uuid "8946e118-e7e3-5ee7-9e3c-9199dfb40a0e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186573199}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8f2aebee-176b-5447-94e6-cdb44a5559c2" :question/math-academy-id "q-351023" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡({x}^{3})\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we write the integral as\n\n$$\n{\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡({x}^{3})\\,\\text{d}x={\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡({x}^{3})\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡({x}^{3})\\, & ⟹\\,{u}^{′}=\\frac{3}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡({x}^{3})\\,\\text{d}x & ={\\int }_{1}^{{e}^{2}}u{v}^{′}\\text{d}x \\\\  & =uv{|}_{1}^{{e}^{2}}-{\\int }_{1}^{{e}^{2}}v{u}^{′}\\text{d}x \\\\  & =\\operatorname{ln}⁡({x}^{3})\\,(x){|}_{1}^{{e}^{2}}-{\\int }_{1}^{{e}^{2}}x(\\frac{3}{x})\\,\\text{d}x \\\\  & =[\\operatorname{ln}⁡(({e}^{2})^{3})\\,({e}^{2})-\\operatorname{ln}⁡({1}^{3})\\,(1)]-3{\\int }_{1}^{{e}^{2}}\\text{d}x \\\\  & ={e}^{2}\\operatorname{ln}⁡({e}^{6})-3x{|}_{1}^{{e}^{2}} \\\\  & =6{e}^{2}-3({e}^{2}-1) \\\\  & =3({e}^{2}+1).\\end{aligned}\n$$"}]}
