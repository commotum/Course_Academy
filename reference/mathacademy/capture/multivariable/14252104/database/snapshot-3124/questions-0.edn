edb/ref 17592186262987 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ed2b533-632f-5e72-b5fe-f6baae2c7ccd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463700} {:answer/id #uuid "5386e080-f0b9-543d-8db7-ec93c4a7551d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463701}] :answer-field/correct {:answer/id #uuid "0ed2b533-632f-5e72-b5fe-f6baae2c7ccd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463700} :answer-field/id #uuid "c40f6968-0bca-5774-9886-3bc959e1ef4a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464784} {:answer-field/choices [{:answer/id #uuid "6623661a-2525-5ca6-9734-515449041004" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463702} {:answer/id #uuid "96c3a4b7-5a7c-5d9c-951d-771a83b2e16f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463703}] :answer-field/correct {:answer/id #uuid "6623661a-2525-5ca6-9734-515449041004" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463702} :answer-field/id #uuid "fa9e942e-aaad-54cf-bbc0-e84775866385" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464785} {:answer-field/choices [{:answer/id #uuid "34a7767e-57b9-52a0-84c8-29455641c32d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463704} {:answer/id #uuid "facd7b6d-a0a0-5777-8f5f-c056b8c4ac1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463705}] :answer-field/correct {:answer/id #uuid "facd7b6d-a0a0-5777-8f5f-c056b8c4ac1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463705} :answer-field/id #uuid "c602597d-38bf-59bd-9d48-42d3ba73e05f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464786}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff4bdd6b-fa6c-575f-9520-7b26c79bdb6a" :question/math-academy-id "q-129216" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\operatorname{tan}⁡x?$    \n- **I.** $[0,\\frac{\\pi }{2}]$\n- **II.** $[0,\\frac{\\pi }{4})$\n- **III.** $[-\\frac{\\pi }{4},\\frac{\\pi }{4}]$\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[0,\\frac{\\pi }{2}]$  is closed, but the function is not defined at $x=\\frac{\\pi }{2}.$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[0,\\frac{\\pi }{4})$ is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[-\\frac{\\pi }{4},\\frac{\\pi }{4}]$ is closed, and the function is continuous on $[-\\frac{\\pi }{4},\\frac{\\pi }{4}].$ Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186314786 :knowledge-point/_questions [{:db/id #edb/ref 17592186184240 :knowledge-point/id #uuid "5a58f115-f368-5171-af73-37084085b42a" :knowledge-point/title "Finding a Limit Involving Trigonometric Functions and Their Inverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aaa8bd9b-23ac-5a6b-aa52-08253648c67f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186313315}] :answer-field/correct {:answer/id #uuid "aaa8bd9b-23ac-5a6b-aa52-08253648c67f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186313315} :answer-field/id #uuid "775fbe06-942a-5f66-b830-7e6bcac4e1aa" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314329}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f1b72358-e12f-522e-a6d1-8b47c27da23b" :question/math-academy-id "q-339477" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,\\frac{1}{2}}\\operatorname{tan}⁡(2x\\operatorname{arcsin}⁡(x))=$\n{{field-1}}" :question/worked-solution "![](images/24/24f07da42a537ded7916fc2440dcf3ee1ccdfc81c7b027b47e97814fec059f5a.png)\n\nThe domain of $\\operatorname{arcsin}⁡(x)$ is $x\\in [-1,1].$\n\nNow, substituting $x=\\frac{1}{2}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\frac{1}{2}}\\operatorname{tan}⁡(2x\\operatorname{arcsin}⁡(x)) & =\\operatorname{tan}⁡(2\\cdot \\frac{1}{2}\\operatorname{arcsin}⁡(\\frac{1}{2})) \\\\  & =\\operatorname{tan}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{\\sqrt{3}}.\\end{aligned}\n$$"}]}
