 17592186045498 #edb/ref 17592186045417] [17592186565287 #edb/ref 1083 #uuid "ea56ea57-0f71-519e-a988-f5b5c4c2111a" #edb/ref 17592186045417] [17592186565300 #edb/ref 1080 "{m}_{11}+{m}_{21}+{m}_{31}" #edb/ref 17592186045417] [17592186565300 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186565300 #edb/ref 1083 #uuid "f11656ee-b6cc-56d4-b249-32402c686bc5" #edb/ref 17592186045417] [17592186565321 #edb/ref 1080 "{m}_{11}\\cdot {m}_{21}\\cdot {m}_{31}" #edb/ref 17592186045417] [17592186565321 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186565321 #edb/ref 1083 #uuid "faf1dc4d-ba4d-5d53-a2f0-fd3508c89b44" #edb/ref 17592186045417] [17592186565342 #edb/ref 1075 #edb/ref 17592186564963 #edb/ref 17592186045417] [17592186565342 #edb/ref 1075 #edb/ref 17592186565150 #edb/ref 17592186045417] [17592186565342 #edb/ref 1075 #edb/ref 17592186565193 #edb/ref 17592186045417] [17592186565342 #edb/ref 1075 #edb/ref 17592186565221 #edb/ref 17592186045417] [17592186565342 #edb/ref 1075 #edb/ref 17592186565239 #edb/ref 17592186045417] [17592186565342 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186565342 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186565342 #edb/ref 1078 #edb/ref 17592186565193 #edb/ref 17592186045417] [17592186565342 #edb/ref 1079 #uuid "352dbe2b-1ccb-5161-9599-03540de2d249" #edb/ref 17592186045417] [17592186565349 #edb/ref 1075 #edb/ref 17592186564947 #edb/ref 17592186045417] [17592186565349 #edb/ref 1075 #edb/ref 17592186564979 #edb/ref 17592186045417] [17592186565349 #edb/ref 1075 #edb/ref 17592186565175 #edb/ref 17592186045417] [17592186565349 #edb/ref 1075 #edb/ref 17592186565278 #edb/ref 17592186045417] [17592186565349 #edb/ref 1075 #edb/ref 17592186565287 #edb/ref 17592186045417] [17592186565349 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186565349 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186565349 #edb/ref 1078 #edb/ref 17592186565287 #edb/ref 17592186045417] [17592186565349 #edb/ref 1079 #uuid "4f9c92a2-2c2c-5f88-a31b-706d15e85fb5" #edb/ref 17592186045417] [17592186565354 #edb/ref 1075 #edb/ref 17592186565020 #edb/ref 17592186045417] [17592186565354 #edb/ref 1075 #edb/ref 17592186565050 #edb/ref 17592186045417] [17592186565354 #edb/ref 1075 #edb/ref 17592186565190 #edb/ref 17592186045417] [17592186565354 #edb/ref 1075 #edb/ref 17592186565300 #edb/ref 17592186045417] [17592186565354 #edb/ref 1075 #edb/ref 17592186565321 #edb/ref 17592186045417] [17592186565354 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186565354 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186565354 #edb/ref 1078 #edb/ref 17592186565050 #edb/ref 17592186045417] [17592186565354 #edb/ref 1079 #uuid "61541d20-7c76-5499-b8e4-4955bf8e417c" #edb/ref 17592186045417] [17592186565378 #edb/ref 1075 #edb/ref 17592186565071 #edb/ref 17592186045417] [17592186565378 #edb/ref 1075 #edb/ref 17592186565099 #edb/ref 17592186045417] [17592186565378 #edb/ref 1075 #edb/ref 17592186565155 #edb/ref 17592186045417] [17592186565378 #edb/ref 1075 #edb/ref 17592186565171 #edb/ref 17592186045417] [17592186565378 #edb/ref 1075 #edb/ref 17592186565259 #edb/ref 17592186045417] [17592186565378 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186565378 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186565378 #edb/ref 1078 #edb/ref 17592186565171 #edb/ref 17592186045417] [17592186565378 #edb/ref 1079 #uuid "b76b9c41-1ad3-5f84-b769-5d10b8aa414c" #edb/ref 17592186045417] [17592186565398 #edb/ref 1075 #edb/ref 17592186565080 #edb/ref 17592186045417] [17592186565398 #edb/ref 1075 #edb/ref 17592186565084 #edb/ref 17592186045417] [17592186565398 #edb/ref 1075 #edb/ref 17592186565108 #edb/ref 17592186045417] [17592186565398 #edb/ref 1075 #edb/ref 17592186565198 #edb/ref 17592186045417] [17592186565398 #edb/ref 1075 #edb/ref 17592186565243 #edb/ref 17592186045417] [17592186565398 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186565398 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186565398 #edb/ref 1078 #edb/ref 17592186565243 #edb/ref 17592186045417] [17592186565398 #edb/ref 1079 #uuid "e5b07574-165a-5003-a2ce-65d9f6400776" #edb/ref 17592186045417] [17592186565419 #edb/ref 1068 #edb/ref 17592186565398 #edb/ref 17592186045417] [17592186565419 #edb/ref 1069 "q-122951" #edb/ref 17592186045417] [17592186565419 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186565419 #edb/ref 1071 "![](images/8a/8a418e8e8e84133cb672d312f5dde246876a0f261c97d739b62b7e5ced437764.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the lower Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}$*" #edb/ref 17592186045417] [17592186565419 #edb/ref 1072 #uuid "2ca84db7-67f2-5f23-9873-fa001c3f6805" #edb/ref 17592186045417] [17592186565419 #edb/ref 1074 "To calculate the lower Riemann sum $L$ with respect to the given partition, we compute the sum of the volumes of $4$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{m}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nSo in our case, we have\n\n$$\nL={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{12}\\cdot \\text{Area}({R}_{12})+{m}_{13}\\cdot \\text{Area}({R}_{13}).\n$$\n\nNow, notice that\n\n$$\n\\text{Area}({R}_{11})=\\text{Area}({R}_{12})=\\text{Area}({R}_{13})=1,\n$$\n\nand\n\n$$\n\\text{Area}({R}_{21})=3.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}L & ={m}_{11}+3\\cdot {m}_{21}+{m}_{12}+{m}_{13} \\\\  & ={m}_{11}+3{m}_{21}+{m}_{12}+{m}_{13}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186565423 #edb/ref 1068 #edb/ref 17592186565378 #edb/ref 17592186045417] [17592186565423 #edb/ref 1069 "q-75038" #edb/ref 17592186045417] [17592186565423 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186565423 #edb/ref 1071 "Let $R=[0,2]\\times [0,2]$ be a region in the $xy$-plane, and let $f(x,y)=4-x-y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{0,1,2\\},\\,{P}_{2}=\\{0,1,2\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the lower Riemann sum $L(f,P).$" #edb/ref 17592186045417] [17592186565423 #edb/ref 1072 #uuid "38c907cd-2c27-580b-8563-70cc82b39b8b" #edb/ref 17592186045417] [17592186565423 #edb/ref 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/3c/3cac974f7352243bfbe008ad8af58ae8222709f81f434070383cc759a46747c7.png)\n\nThe lower Riemann sum $L(f,P)$ is given by\n\n$$\nL(f,P)={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{12}\\cdot \\text{Area}({R}_{12})+{m}_{22}\\cdot \\text{Area}({R}_{22})\n$$\n\nwhere ${m}_{ij}$ is the minimum value of $f$ in each subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=1$ for all $4$ subregions, the formula for $L(f,P)$ reduces to\n\n$$\nL(f,P)={m}_{11}+{m}_{21}+{m}_{12}+{m}_{22}.\n$$\n\nNow, notice that\n\n- $f(x,y)=4-x-y$ decreases as $x$ increases, and\n\n- $f(x,y)=4-x-y$ decreases as $y$ increases.\n\n![](images/0f/0fefe892c74e8d391e56ee822f83e7e0fe0110593c9d6a4b93b8cfe1e558ab16.png)\n\nAs a result, the *minimum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion.\n\n![](images/fe/fe872f1f1b0307760dcdba6ac6f6be20f197662ac250ab46dc77fa472295906f.png)\n\nHence:\n\n$$\n\\begin{aligned}{m}_{11} & =f(1,1)=2 \\\\ {m}_{21} & =f(2,1)=1 \\\\ {m}_{12} & =f(1,2)=1 \\\\ {m}_{22} & =f(2,2)=0\\end{aligned}\n$$\n\nFinally,\n\n$$\nL(f,P)=2+1+1+0=4.\n$$" #edb/ref 17592186045417] [17592186565430 #edb/ref 1068 #edb/ref 17592186565342 #edb/ref 17592186045417] [17592186565430 #edb/ref 1069 "q-75235" #edb/ref 17592186045417] [17592186565430 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186565430 #edb/ref 1071 "Let $R=[0,4]\\times [0,4]$ be a region in the $xy$-plane, and let $f(x,y)=x+y+1.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{0,2,4\\},\\,{P}_{2}=\\{0,2,4\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the lower Riemann sum $L(f,P).$" #edb/ref 17592186045417] [17592186565430 #edb/ref 1072 #uuid "559bc70c-78ac-5c05-9067-d915f9f4b231" #edb/ref 17592186045417] [17592186565430 #edb/ref 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/29/293e79685a3f4da205d986bcf4331e4b4f43c0a48fe183d27f93aaee6bb17b99.png)\n\nThe lower sum $L(f,P)$ is given by\n\n$$\nL(f,P)={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{12}\\cdot \\text{Area}({R}_{12})+{m}_{22}\\cdot \\text{Area}({R}_{22})\n$$\n\nwhere ${m}_{ij}$ is the *minimum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=4$ for all $4$ subregions, the formula for $L(f,P)$ reduces to\n\n$$\nL(f,P)=4{m}_{11}+4{m}_{21}+4{m}_{12}+4{m}_{22}.\n$$\n\nNow, notice that\n\n- $f(x,y)=x+y+1$ increases as $x$ increases, and\n\n- $f(x,y)=x+y+1$ increases as $y$ increases.\n\n![](images/12/12df172e3a2f60a8b123937600d5774508ac8cb204696414690490be8d9e2c32.png)\n\nAs a result, the *minimum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion.\n\n![](images/b5/b5e72e970d512740cc0d5de9e2d5739d71fb0c90e750c9874042ff4fa5230db9.png)\n\nHence:\n\n$$\n\\begin{aligned}{m}_{11} & =f(0,0)=1 \\\\ {m}_{21} & =f(2,0)=3 \\\\ {m}_{12} & =f(0,2)=3 \\\\ {m}_{22} & =f(2,2)=5\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}L(f,P) & =4\\cdot 1+4\\cdot 3+4\\cdot 3+4\\cdot 5 \\\\  & =48.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186565455 #edb/ref 1068 #edb/ref 17592186565349 #edb/ref 17592186045417] [17592186565455 #edb/ref 1069 "q-75231" #edb/ref 17592186045417] [17592186565455 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186565455 #edb/ref 1071 "Let $R=[0,1]\\times [1,3]$ be a region in the $xy$-plane, and let $f(x,y)=3x+y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{0,1\\},\\,{P}_{2}=\\{1,2,3\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the lower Riemann sum $L(f,P).$" #edb/ref 17592186045417] [17592186565455 #edb/ref 1072 #uuid "aebb283d-a6dd-5621-b2da-04fb6f0be9f3" #edb/ref 17592186045417] [17592186565455 #edb/ref 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/c2/c2c33fe367e36506f949f1f76d84ccb2b3ff74ea3a4456e57982f489978225b3.png)\n\nThe lower sum $L(f,P)$ is given by\n\n$$\nL(f,P)={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{12}\\cdot \\text{Area}({R}_{12})\n$$\n\nwhere ${m}_{ij}$ is the *minimum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=1$ for all $2$ subregions, the formula for $L(f,P)$ reduces to\n\n$$\nL(f,P)={m}_{11}+{m}_{12}.\n$$\n\nNow, notice that\n\n- $f(x,y)=3x+y$ increases as $x$ increases, and\n\n- $f(x,y)=3x+y$ increases as $y$ increases.\n\n![](images/3b/3bdc77445e75c7c74d6e242f9eb469687aa34384e7399b05607dfaa4a81ae596.png)\n\nAs a result, the *minimum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion.\n\n![](images/ac/acded82358333752ba407673edf543262ee0b36166014c3de54d9beef9218a26.png)\n\nHence:\n\n$$\n\\begin{aligned}{m}_{11} & =f(0,1)=1 \\\\ {m}_{12} & =f(0,2)=2\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}L(f,P) & =1+2 \\\\  & =3.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186565462 #edb/ref 1068 #edb/ref 17592186565354 #edb/ref 17592186045417] [17592186565462 #edb/ref 1069 "q-122873" #edb/ref 17592186045417] [17592186565462 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186565462 #edb/ref 1071 "![](images/c6/c6ed4ab6e979f6df3cba0b2afc442dec11667b7b81027cd692e01f1106ee53fa.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the lower Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}$*" #edb/ref 17592186045417] [17592186565462 #edb/ref 1072 #uuid "bfe6201a-0cdf-54aa-a233-33c1bb74e932" #edb/ref 17592186045417] [17592186565462 #edb/ref 1074 "To calculate the lower Riemann sum $L$ with respect to the given partition, we compute the sum of the volumes of $3$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{m}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${m}_{ij}$ denotes the minimum value of $f$ on the subregion ${R}_{ij}.$ We pick the *minimum* value of $f$ because we're finding the *lower* sum.\n\nSo in our case, we have\n\n$$\nL={m}_{11}\\cdot \\text{Area}({R}_{11})+{m}_{21}\\cdot \\text{Area}({R}_{21})+{m}_{31}\\cdot \\text{Area}({R}_{31}).\n$$\n\nNotice that\n\n$$\n\\text{Area}({R}_{11})=\\text{Area}({R}_{21})=\\text{Area}({R}_{31})=2.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}L & =2\\cdot {m}_{11}+2\\cdot {m}_{21}+2\\cdot {m}_{31} \\\\  & =2({m}_{11}+{m}_{21}+{m}_{31}).\\end{aligned}\n$$" #edb/ref 17592186045417]}
