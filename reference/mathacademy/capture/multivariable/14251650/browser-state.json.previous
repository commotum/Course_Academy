    "q-37307": {
      "dom_id": "step-q37307",
      "name": "Question 2",
      "problem": "Find the differential $\\text{d}f$ for the function $f(x,y)=\\operatorname{ln}⁡(x+{y}^{2}).$",
      "worked_solution": "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{\\text{d}x}{x+{y}^{2}}+\\frac{2y\\,\\text{d}y}{x+{y}^{2}}\\end{aligned}\n$$",
      "calculator_instructions": "",
      "fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "option": "a",
              "dom_id": "questionWidget-choiceLetterCircle-37307-a",
