#{[{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186572730} :activity/id #uuid "4f3aedea-ce59-5377-a919-75712b7234d6" :activity/scope {:db/id #edb/ref 17592186049789 :topic/id #uuid "1421ca6c-3154-54fc-9984-2ec221f95a7c" :topic/math-academy-id 1950} :activity/steps [{:db/id #edb/ref 17592186572730 :step/content {:db/id #edb/ref 17592186125053 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c166559-b9a5-59ca-92aa-d849b5b800a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}\\,\\text{d}r+\\frac{1}{8}\\,\\text{d}\\theta " :db/id #edb/ref 17592186321360} {:answer/id #uuid "3bff60af-8093-5e22-9ff2-3056ea97c0ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{8}\\,\\text{d}r+\\frac{1}{8}\\,\\text{d}\\theta " :db/id #edb/ref 17592186321612} {:answer/id #uuid "7c3f6608-3382-52d2-9d27-9c29bc8d2ae1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi \\,\\text{d}r+4\\,\\text{d}\\theta " :db/id #edb/ref 17592186322124} {:answer/id #uuid "e0877f70-66c5-5f27-a401-90a010bced15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}\\,\\text{d}r+8\\,\\text{d}\\theta " :db/id #edb/ref 17592186322904} {:answer/id #uuid "f7d70644-2e54-528f-b715-5f4611844894" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}\\,\\text{d}r+4\\,\\text{d}\\theta " :db/id #edb/ref 17592186323095}] :answer-field/correct {:db/id #edb/ref 17592186322904} :answer-field/id #uuid "272d4a53-db30-59a7-93a4-ebd19e141f58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323245}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f9652424-c2ee-5706-a3c2-84b62902c6d8" :question/math-academy-id "q-37295" :question/problem "Given a sector of a circle, find the differential $\\text{d}S$ for the surface area $S$ if the radius is $r=4$ and the central angle is $\\theta =\\frac{\\pi }{8}.$" :question/worked-solution "The area of the sector is $S=\\frac{\\theta }{2}{r}^{2}.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(r,\\theta ) & =(\\frac{∂S}{∂r})\\,\\text{d}r+(\\frac{∂S}{∂\\theta })\\,\\text{d}\\theta  \\\\  & =r\\theta \\,\\text{d}r+\\frac{{r}^{2}}{2}\\,\\text{d}\\theta \\end{aligned}\n$$\n\nFor $r=4$ and $\\theta =\\frac{\\pi }{8},$ the differential is\n\n$$\n\\begin{aligned}\\text{d}S(4,\\frac{\\pi }{8}) & =4\\cdot \\frac{\\pi }{8}\\,\\text{d}r+\\frac{{4}^{2}}{2}\\,\\text{d}\\theta  \\\\  & =\\frac{\\pi }{2}\\,\\text{d}r+8\\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "05e1162b-9ac7-5dd4-9211-b622aacaf22f" :step/next {:db/id #edb/ref 17592186572745}} {:db/id #edb/ref 17592186572738 :step/content {:db/id #edb/ref 17592186348271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "009c9900-f889-52f9-b00b-40100c9397c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186345359} {:answer/id #uuid "33de2cd4-781a-5e11-9d06-401da624c0ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186345803} {:answer/id #uuid "6c775b28-e659-58c3-afb4-970c5a4d0320" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186346292} {:answer/id #uuid "80dabf23-d4b2-59f9-93af-a8e0472606a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,\\text{d}a+48\\,\\text{d}h" :db/id #edb/ref 17592186346477} {:answer/id #uuid "ef0dac21-38b0-572f-851b-fdb97e5e86a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186347461}] :answer-field/correct {:db/id #edb/ref 17592186345359} :answer-field/id #uuid "c0653cbc-f79b-58c9-bc1b-48709188cc90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347942}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6f0e792d-8d7d-5fba-9784-ec8ac9d90e29" :question/math-academy-id "q-79747" :question/problem "Given a rectangular solid, find the differential $\\text{d}S$ for the surface area $S$ of the rectangular solid if the base is a square with the side of $a=3$ and the height is $h=7.$" :question/worked-solution "The surface area of the given rectangular solid is $S=2{a}^{2}+4ah.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(a,h) & =(\\frac{∂S}{∂a})\\,\\text{d}a+(\\frac{∂S}{∂h})\\,\\text{d}h \\\\  & =(4a+4h)\\,\\text{d}a+4a\\,\\text{d}h\\end{aligned}\n$$\n\nFor $a=3$ and $h=7,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}S(3,7) & =(4\\cdot 3+4\\cdot 7)\\,\\text{d}a+4\\cdot 3\\,\\text{d}h \\\\  & =40\\,\\text{d}a+12\\,\\text{d}h.\\end{aligned}\n$$"} :step/id #uuid "1844416f-fe2c-5284-9655-9bd296331880" :step/next {:db/id #edb/ref 17592186572802}} {:db/id #edb/ref 17592186572745 :step/content {:db/id #edb/ref 17592186125056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "067f9b24-89cd-5640-aaaf-dff8c95ef59b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{d}x}{x+{y}^{2}}+\\frac{2y\\,\\text{d}y}{x+{y}^{2}}" :db/id #edb/ref 17592186321199} {:answer/id #uuid "1128d9b0-3826-5d98-9cc7-5f834358d3e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{d}x}{x+{y}^{2}}+\\frac{y\\,\\text{d}y}{x+{y}^{2}}" :db/id #edb/ref 17592186321281} {:answer/id #uuid "1e27c6eb-0785-5dec-84a8-1534c6f56ed8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x\\,\\text{d}x}{x+{y}^{2}}+\\frac{2y\\,\\text{d}y}{x+{y}^{2}}" :db/id #edb/ref 17592186321377} {:answer/id #uuid "3706943f-d54b-5676-bb50-c5c8aee51976" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+{y}^{2})\\,\\text{d}x+(x+{y}^{2})\\,\\text{d}y" :db/id #edb/ref 17592186321564} {:answer/id #uuid "5a9f369b-c20d-558d-9b39-4e4d7b41f3dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\,\\text{d}x}{x+{y}^{2}}-\\frac{2\\,\\text{d}y}{x+{y}^{2}}" :db/id #edb/ref 17592186321862}] :answer-field/correct {:db/id #edb/ref 17592186321199} :answer-field/id #uuid "7cc20461-d761-56fc-9e28-0485df92bb1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323417}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3d0cda7b-1864-5320-acd1-fb1c921ad388" :question/math-academy-id "q-37307" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y)=\\operatorname{ln}⁡(x+{y}^{2}).$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{\\text{d}x}{x+{y}^{2}}+\\frac{2y\\,\\text{d}y}{x+{y}^{2}}\\end{aligned}\n$$"} :step/id #uuid "316729c9-4888-5409-95a4-73e5ccec848e" :step/next {:db/id #edb/ref 17592186572746}} {:db/id #edb/ref 17592186572746 :step/content {:db/id #edb/ref 17592186348265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02dad359-25f2-59b1-a326-992f7d8f2be8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3{x}^{2}y-{y}^{3})\\text{d}x+({x}^{2}+{x}^{3}-3{y}^{2})\\text{d}y" :db/id #edb/ref 17592186345374} {:answer/id #uuid "37a0854b-5ffd-53b5-a97e-3fc8c049dafa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3{x}^{2}y)\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y" :db/id #edb/ref 17592186345828} {:answer/id #uuid "78a766e2-5151-5cd4-bd3b-cdc71e40524c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3{x}^{2}y-{y}^{3})\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y" :db/id #edb/ref 17592186346407} {:answer/id #uuid "9d887fd2-2962-51ac-ad91-2c074402c2fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3{x}^{2})\\text{d}x+({x}^{3}-{y}^{2})\\text{d}y" :db/id #edb/ref 17592186346722} {:answer/id #uuid "cbcdcfbb-2ee8-5177-94d0-d8a8b2bddfea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({x}^{3}-3{y}^{2})\\text{d}x+(2x+3{x}^{2}y)\\text{d}y" :db/id #edb/ref 17592186347137}] :answer-field/correct {:db/id #edb/ref 17592186345828} :answer-field/id #uuid "53ddc30c-7b7f-5181-82b4-b214c29b463f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347755}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "af353571-e5f3-5cb8-87db-52892f4fbe38" :question/math-academy-id "q-79739" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y)={x}^{2}+{x}^{3}y-{y}^{3}.$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =(2x+3{x}^{2}y)\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y\\end{aligned}\n$$"} :step/id #uuid "31929053-f3b9-591b-bdc2-747c8a370f98" :step/next {:db/id #edb/ref 17592186572738}} {:db/id #edb/ref 17592186572802 :step/content {:db/id #edb/ref 17592186348291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20b1b01d-dcce-5e97-8070-3e46cd24a9b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e-2" :db/id #edb/ref 17592186345641} {:answer/id #uuid "5d489c63-3bed-55d1-88eb-6a7cb5ad4096" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e" :db/id #edb/ref 17592186346150} {:answer/id #uuid "702fd59b-e266-554c-9f4d-07da9651143b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186346329} {:answer/id #uuid "c8ef46c8-495f-50a4-88cb-4b955b1c8d64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186347101} {:answer/id #uuid "e60a87d9-0bac-5840-9059-0b6443f4f86e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-e" :db/id #edb/ref 17592186347379}] :answer-field/correct {:db/id #edb/ref 17592186347101} :answer-field/id #uuid "e9750bae-5c66-5b82-a422-b4ec85ac0ea9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186348011}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a59577cc-4986-5576-9592-2ad42c96ff6f" :question/math-academy-id "q-79812" :question/problem "If $f(x,y)=x\\operatorname{ln}⁡y,$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(0,e)$ to $(1,2).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\operatorname{ln}⁡y\\,\\text{d}x+\\frac{x}{y}\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(0,e),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(0,e) & =\\operatorname{ln}⁡e\\,\\text{d}x+\\frac{0}{e}\\,\\text{d}y \\\\  & =1\\,\\text{d}x+0\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(0+Δx,e+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈1\\,Δx+0\\,Δy.\n$$\n\nMoving from $(0,e)$ to $(1,2),$ we have\n\n$$\n\\begin{aligned}Δx & =1-0=1, \\\\ Δy & =2-e.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\,Δx+0\\,Δy \\\\  & ≈1\\cdot (1)+0\\cdot (2-e) \\\\  & ≈1.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ increases by approximately $1.$"} :step/id #uuid "e9b6a348-f1db-5091-823d-f40f938737e7"}] :activity/title "Differentials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186572304}]}
