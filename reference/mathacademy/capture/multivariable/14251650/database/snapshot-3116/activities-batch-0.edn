#{[{:activity/expected-seconds 1020.0 :activity/first-step {:db/id #edb/ref 17592186125479} :activity/id #uuid "9e51b578-3c1e-53f2-bd6c-584e173a601f" :activity/scope {:db/id #edb/ref 17592186049789 :topic/id #uuid "1421ca6c-3154-54fc-9984-2ec221f95a7c" :topic/math-academy-id 1950} :activity/steps [{:db/id #edb/ref 17592186125477 :step/content {:db/id #edb/ref 17592186124565 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124374 :question/id #uuid "8ebce398-b228-51b0-8506-e0c6124478a5" :question/math-academy-id "e-6852"} :knowledge-point/id #uuid "4f23c5c7-d281-54da-b625-412925c80667" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048707}] :knowledge-point/questions [{:db/id #edb/ref 17592186125052} {:db/id #edb/ref 17592186125056} {:db/id #edb/ref 17592186284575} {:db/id #edb/ref 17592186348265} {:db/id #edb/ref 17592186348266} {:db/id #edb/ref 17592186348267} {:db/id #edb/ref 17592186348268} {:db/id #edb/ref 17592186348269} {:db/id #edb/ref 17592186393982} {:db/id #edb/ref 17592186446872} {:db/id #edb/ref 17592186446873} {:db/id #edb/ref 17592186564468}] :knowledge-point/title "Computing the Differential of a Multivariable Function"} :step/id #uuid "bf1f5b6c-b40c-5ff9-9ed6-50ee5d23ff70" :step/math-academy-id 25383 :step/next {:db/id #edb/ref 17592186125478}} {:db/id #edb/ref 17592186125478 :step/content {:db/id #edb/ref 17592186124566 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124375 :question/id #uuid "bb3ab0dc-7e26-58f5-a0c2-564c01c77f2e" :question/math-academy-id "e-6854"} :knowledge-point/id #uuid "153739f2-df62-5baf-8438-225edfc33ecb" :knowledge-point/questions [{:db/id #edb/ref 17592186125053} {:db/id #edb/ref 17592186125057} {:db/id #edb/ref 17592186284605} {:db/id #edb/ref 17592186348270} {:db/id #edb/ref 17592186348271} {:db/id #edb/ref 17592186348321} {:db/id #edb/ref 17592186372349} {:db/id #edb/ref 17592186375377} {:db/id #edb/ref 17592186375384} {:db/id #edb/ref 17592186393968} {:db/id #edb/ref 17592186446874} {:db/id #edb/ref 17592186498589}] :knowledge-point/title "Computing a Differential in a Geometrical Context"} :step/id #uuid "34d39ab5-5a0c-5548-9b37-4b9ff25664cc" :step/math-academy-id 25385 :step/next {:db/id #edb/ref 17592186125480}} {:db/id #edb/ref 17592186125479 :step/content {:db/id #edb/ref 17592186125813 :tutorial/content "The **differential** of a multivariable function $f(x,y)$ is denoted $\\textrm df(x,y)$ and represents the infinitesimal change in the function value that occurs when the inputs $x$ and $y$ are changed by infinitesimal amounts $\\textrm dx$ and $\\textrm dy.$\n\nThe formula for the differential comes from the multivariable chain rule, which can be expressed as\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y.\\end{aligned}\n$$\n\nNote that the differential can be extended to any number of variables. For example, for a three-variable function $f(x,y,z),$ we have\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z.\\end{aligned}\n$$" :tutorial/id #uuid "549aa462-1d86-5880-b6e2-2f6b1d79b41d" :tutorial/math-academy-id 4191 :tutorial/title "Introduction"} :step/id #uuid "ca5fbd6f-0bec-58b1-a606-32a0d7df8952" :step/math-academy-id 25416 :step/next {:db/id #edb/ref 17592186125477}} {:db/id #edb/ref 17592186125480 :step/content {:db/id #edb/ref 17592186125814 :tutorial/content "Given a multivariable function $f(x,y),$ the differential\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y\\end{aligned}\n$$\n\ntells us how infinitesimal changes in $x$ and $y,$ denoted $\\textrm dx$ and $\\textrm dy,$ result in an infinitesimal change in $f,$ denoted $\\textrm df.$\n\nConsequently, we can use the differential to *approximate* the change in $f$ as we move from one point to another. If we move from a point $(x,y)$ to a point $(x + \\Delta x, y + \\Delta y),$ then the approximate change in $f$ is given by\n\n$$\n\\begin{aligned}Δf(x,y) & ≈(\\frac{∂f}{∂x})\\,Δx+(\\frac{∂f}{∂y})\\,Δy.\\end{aligned}\n$$\n\nThe above formula is very similar to the differential formula, except the $\\textrm d$'s are replaced with $\\Delta$'s. The $\\textrm d$'s refer to infinitesimal changes, while the $\\Delta$'s refer to changes that can actually be measured." :tutorial/id #uuid "c2d5565a-cb57-537b-bd6e-64ebd0b91783" :tutorial/math-academy-id 4214 :tutorial/title "Approximating Change Using Differentials"} :step/id #uuid "98241263-1948-5c19-9eb8-bdad86fba771" :step/math-academy-id 25515 :step/next {:db/id #edb/ref 17592186125481}} {:db/id #edb/ref 17592186125481 :step/content {:db/id #edb/ref 17592186124567 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124376 :question/id #uuid "0c4816ed-fba0-5dc7-94ba-646b875d653d" :question/math-academy-id "e-6875"} :knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649" :knowledge-point/questions [{:db/id #edb/ref 17592186125055} {:db/id #edb/ref 17592186125226} {:db/id #edb/ref 17592186284577} {:db/id #edb/ref 17592186284578} {:db/id #edb/ref 17592186348287} {:db/id #edb/ref 17592186348289} {:db/id #edb/ref 17592186348290} {:db/id #edb/ref 17592186348291} {:db/id #edb/ref 17592186348292} {:db/id #edb/ref 17592186348293} {:db/id #edb/ref 17592186354501} {:db/id #edb/ref 17592186354502}] :knowledge-point/title "Using Differentials to Approximate the Change in a Multivariable Function"} :step/id #uuid "382f7b0c-adae-5236-b08b-ef5b7008f906" :step/math-academy-id 25516 :step/next {:db/id #edb/ref 17592186125482}} {:db/id #edb/ref 17592186125482 :step/content {:db/id #edb/ref 17592186124568 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124377 :question/id #uuid "febc72d4-b1b8-52c9-a805-013b30695077" :question/math-academy-id "e-6876"} :knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9" :knowledge-point/questions [{:db/id #edb/ref 17592186125051} {:db/id #edb/ref 17592186125227} {:db/id #edb/ref 17592186284580} {:db/id #edb/ref 17592186284581} {:db/id #edb/ref 17592186348300} {:db/id #edb/ref 17592186348301} {:db/id #edb/ref 17592186348302} {:db/id #edb/ref 17592186348303} {:db/id #edb/ref 17592186348304} {:db/id #edb/ref 17592186348306} {:db/id #edb/ref 17592186354503} {:db/id #edb/ref 17592186373237}] :knowledge-point/title "Using Differentials to Approximate the Value of a Function"} :step/id #uuid "896f3d03-adff-53cf-be59-7b4310e8b280" :step/math-academy-id 25517}] :activity/title "Differentials" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186124739}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186481467} :activity/id #uuid "52ee3973-52bc-556a-8616-fb2686b552f2" :activity/scope {:db/id #edb/ref 17592186049789 :topic/id #uuid "1421ca6c-3154-54fc-9984-2ec221f95a7c" :topic/math-academy-id 1950} :activity/steps [{:db/id #edb/ref 17592186481450 :step/content {:db/id #edb/ref 17592186348271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "009c9900-f889-52f9-b00b-40100c9397c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186345359} {:answer/id #uuid "33de2cd4-781a-5e11-9d06-401da624c0ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186345803} {:answer/id #uuid "6c775b28-e659-58c3-afb4-970c5a4d0320" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186346292} {:answer/id #uuid "80dabf23-d4b2-59f9-93af-a8e0472606a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,\\text{d}a+48\\,\\text{d}h" :db/id #edb/ref 17592186346477} {:answer/id #uuid "ef0dac21-38b0-572f-851b-fdb97e5e86a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186347461}] :answer-field/correct {:db/id #edb/ref 17592186345359} :answer-field/id #uuid "c0653cbc-f79b-58c9-bc1b-48709188cc90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347942}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6f0e792d-8d7d-5fba-9784-ec8ac9d90e29" :question/math-academy-id "q-79747" :question/problem "Given a rectangular solid, find the differential $\\text{d}S$ for the surface area $S$ of the rectangular solid if the base is a square with the side of $a=3$ and the height is $h=7.$" :question/worked-solution "The surface area of the given rectangular solid is $S=2{a}^{2}+4ah.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(a,h) & =(\\frac{∂S}{∂a})\\,\\text{d}a+(\\frac{∂S}{∂h})\\,\\text{d}h \\\\  & =(4a+4h)\\,\\text{d}a+4a\\,\\text{d}h\\end{aligned}\n$$\n\nFor $a=3$ and $h=7,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}S(3,7) & =(4\\cdot 3+4\\cdot 7)\\,\\text{d}a+4\\cdot 3\\,\\text{d}h \\\\  & =40\\,\\text{d}a+12\\,\\text{d}h.\\end{aligned}\n$$"} :step/id #uuid "36110881-4f06-5b62-a14a-640b5c8ecaec" :step/next {:db/id #edb/ref 17592186481470}} {:db/id #edb/ref 17592186481459 :step/content {:db/id #edb/ref 17592186348293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18aa2d29-4200-55a9-9049-eec28d6ce46d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186345569} {:answer/id #uuid "28d8915f-3339-5227-a3ee-86c79928eb21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{\\pi }{2}" :db/id #edb/ref 17592186345717} {:answer/id #uuid "39be8076-d1a4-53bc-beb7-69d5faf74820" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186345843} {:answer/id #uuid "e580e49f-e01d-5220-aa00-628de33ae96e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi -2" :db/id #edb/ref 17592186347372} {:answer/id #uuid "fb111822-7947-5e96-ad01-3bd29918f4a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186347567}] :answer-field/correct {:db/id #edb/ref 17592186345569} :answer-field/id #uuid "da7d86ef-4dea-5ade-8600-60a413066868" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347990}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0a50b343-0303-5110-8cf9-6975a85c04cf" :question/math-academy-id "q-79815" :question/problem "If $f(x,y,z)=x\\operatorname{sin}⁡y+y\\operatorname{cos}⁡z,$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y,z)$ from $(1,0,\\frac{\\pi }{2})$ to $(0,1,1).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡y\\,\\text{d}x+(x\\operatorname{cos}⁡y+\\operatorname{cos}⁡z)\\,\\text{d}y-y\\operatorname{sin}⁡z\\,\\text{d}z\\end{aligned}\n$$\n\nAt the point $(1,0,\\frac{\\pi }{2}),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(1,0,\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(0)\\,\\text{d}x+(1\\cdot \\operatorname{cos}⁡(0)+\\operatorname{cos}⁡(\\frac{\\pi }{2}))\\,\\text{d}y-0\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{2})\\,\\text{d}z \\\\  & =0\\,\\text{d}x+1\\,\\text{d}y+0\\,\\text{d}z.\\end{aligned}\n$$\n\nSo, if we move to the point $(1+Δx,0+Δy,\\frac{\\pi }{2}+Δz),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈0\\,Δx+1\\,Δy+0\\,Δz.\n$$\n\nMoving from $(1,0,\\frac{\\pi }{2})$ to $(0,1,1),$ we have\n\n$$\n\\begin{aligned}Δx & =0-1=-1, \\\\ Δy & =1-0=1 \\\\ Δz & =1-\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈0\\,Δx+1\\,Δy+0\\,Δz \\\\  & ≈0\\cdot (-1)+1\\cdot (1)+0\\cdot (1-\\frac{\\pi }{2}) \\\\  & ≈1.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y,z)$ increases by approximately $1.$"} :step/id #uuid "82baedff-1f18-5874-ab86-496b5c5150c2" :step/next {:db/id #edb/ref 17592186481465}} {:db/id #edb/ref 17592186481465 :step/content {:db/id #edb/ref 17592186284581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e9f4654-e89d-5d9e-a79c-0bb5f857defd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.521" :db/id #edb/ref 17592186282101} {:answer/id #uuid "85c51f51-7216-584b-b827-69d84ec4f79d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.652" :db/id #edb/ref 17592186282842} {:answer/id #uuid "beb360a4-ee13-5f31-9c0a-e76bcd78e6b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.359" :db/id #edb/ref 17592186283346} {:answer/id #uuid "e2d331ae-1ad5-5557-89ef-e15bbaae3a68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.482" :db/id #edb/ref 17592186283667} {:answer/id #uuid "e74c9b4d-a866-5c53-8a6c-93a7e66b72ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.274" :db/id #edb/ref 17592186283703}] :answer-field/correct {:db/id #edb/ref 17592186283346} :answer-field/id #uuid "aff6cf4f-69f4-50e0-b11a-e6431b91e83f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284241}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9eb149a3-bdcc-552e-a682-ced670cd4013" :question/math-academy-id "q-167171" :question/problem "Estimate $\\operatorname{sin}⁡(\\sqrt{{\\pi }^{2}+1}+0.2)$ using a differential $\\text{d}f$ of the function $f(x,y)=\\operatorname{sin}⁡(\\sqrt{x}+y)$ at the point $({\\pi }^{2},0).$ Round your answer to $3$ decimal places." :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{\\operatorname{cos}⁡(\\sqrt{x}+y)}{2\\sqrt{x}}\\,\\text{d}x+\\operatorname{cos}⁡(\\sqrt{x}+y)\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $({\\pi }^{2},0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =\\frac{\\operatorname{cos}⁡(\\pi )}{2\\pi }\\,\\text{d}x+\\operatorname{cos}⁡(\\pi )\\,\\text{d}y \\\\  & =-\\frac{1}{2\\pi }\\,\\text{d}x-\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $({\\pi }^{2}+Δx,0+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈-\\frac{1}{2\\pi }\\,Δx-\\,Δy\n$$\n\nNote that \n\n$$\n\\operatorname{sin}⁡(\\sqrt{{\\pi }^{2}+1}+0.2)=f({\\pi }^{2}+1,0.2),\n$$\n\nso we want to move to the point $({\\pi }^{2}+1,0.2).$\n\nMoving from $({\\pi }^{2},0)$ to $({\\pi }^{2}+1,0.2),$ we have\n\n$$\n\\begin{aligned}Δx & =({\\pi }^{2}+1)-{\\pi }^{2}=1, \\\\ Δy & =0.2-0=0.2.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈(-\\frac{1}{2\\pi })\\cdot (1)-1\\cdot (0.2) \\\\  & =-\\frac{1}{2\\pi }-0.2 \\\\  & ≈-0.359.\\end{aligned}\n$$\n\nThis means that the value of $f$ decreases by about $-0.359.$ Consequently, we have\n\n$$\n\\begin{aligned}f({\\pi }^{2}+1,0.2) & ≈f({\\pi }^{2},0)-0.359 \\\\ \\operatorname{sin}⁡(\\sqrt{{\\pi }^{2}+1}+0.2) & ≈\\operatorname{sin}⁡(\\sqrt{{\\pi }^{2}}+0)-0.359 \\\\  & =0-0.359 \\\\  & =-0.359.\\end{aligned}\n$$"} :step/id #uuid "b86e363e-7ec4-59af-9dfb-ebd22f051bfc"} {:db/id #edb/ref 17592186481467 :step/content {:db/id #edb/ref 17592186348265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02dad359-25f2-59b1-a326-992f7d8f2be8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3{x}^{2}y-{y}^{3})\\text{d}x+({x}^{2}+{x}^{3}-3{y}^{2})\\text{d}y" :db/id #edb/ref 17592186345374} {:answer/id #uuid "37a0854b-5ffd-53b5-a97e-3fc8c049dafa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3{x}^{2}y)\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y" :db/id #edb/ref 17592186345828} {:answer/id #uuid "78a766e2-5151-5cd4-bd3b-cdc71e40524c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3{x}^{2}y-{y}^{3})\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y" :db/id #edb/ref 17592186346407} {:answer/id #uuid "9d887fd2-2962-51ac-ad91-2c074402c2fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3{x}^{2})\\text{d}x+({x}^{3}-{y}^{2})\\text{d}y" :db/id #edb/ref 17592186346722} {:answer/id #uuid "cbcdcfbb-2ee8-5177-94d0-d8a8b2bddfea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({x}^{3}-3{y}^{2})\\text{d}x+(2x+3{x}^{2}y)\\text{d}y" :db/id #edb/ref 17592186347137}] :answer-field/correct {:db/id #edb/ref 17592186345828} :answer-field/id #uuid "53ddc30c-7b7f-5181-82b4-b214c29b463f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347755}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "af353571-e5f3-5cb8-87db-52892f4fbe38" :question/math-academy-id "q-79739" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y)={x}^{2}+{x}^{3}y-{y}^{3}.$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =(2x+3{x}^{2}y)\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y\\end{aligned}\n$$"} :step/id #uuid "cd2d74e5-abec-550d-9ecd-251a39a898c0" :step/next {:db/id #edb/ref 17592186481450}} {:db/id #edb/ref 17592186481470 :step/content {:db/id #edb/ref 17592186348292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d5f0ff3-67c3-5156-80d4-3b1056e54271" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186345456} {:answer/id #uuid "aa5c1f15-75a4-5090-ab69-ed2b1d6b4397" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186346839} {:answer/id #uuid "b34d8f8b-645c-5063-9782-d98391879677" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186346918} {:answer/id #uuid "c7663d80-ea3d-53cf-9cff-cd7f8bff08ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186347085} {:answer/id #uuid "de53245c-33e1-5dc2-9980-d68bbba16eee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186347307}] :answer-field/correct {:db/id #edb/ref 17592186345456} :answer-field/id #uuid "6d29f153-5da4-5bde-bade-0dc96a9e6da3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347802}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "01cbcb4d-5667-5e3e-806c-ef99a5773f2c" :question/math-academy-id "q-79813" :question/problem "If $f(x,y)=xy+x{e}^{y},$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(2,0)$ to $(1,-0.5).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =(y+{e}^{y})\\,\\text{d}x+(x+x{e}^{y})\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(2,0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(2,0) & =(0+{e}^{0})\\,\\text{d}x+(2+2\\cdot {e}^{0})\\,\\text{d}y \\\\  & =1\\,\\text{d}x+4\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(2+Δx,0+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈1\\,Δx+4\\,Δy.\n$$\n\nMoving from $(2,0)$ to $(1,-0.5),$ we have\n\n$$\n\\begin{aligned}Δx & =1-2=-1, \\\\ Δy & =-0.5-0=-0.5.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\,Δx+4\\,Δy \\\\  & ≈1\\cdot (-1)+4\\cdot (-0.5) \\\\  & ≈-3.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ decreases by approximately $3.$"} :step/id #uuid "e1760d0a-7b68-5369-867b-8060b5dc8d02" :step/next {:db/id #edb/ref 17592186481459}}] :activity/title "Differentials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186480733}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186498610} :activity/id #uuid "2d4d0e16-57ea-5547-8e12-74455c336ca2" :activity/scope {:db/id #edb/ref 17592186049789 :topic/id #uuid "1421ca6c-3154-54fc-9984-2ec221f95a7c" :topic/math-academy-id 1950} :activity/steps [{:db/id #edb/ref 17592186498605 :step/content {:db/id #edb/ref 17592186125226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a096788c-853c-5498-9e98-f2c341faf5dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186123957} {:answer/id #uuid "f7033e0b-729b-5d85-9a5c-4f9b133f9ebc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186123958} {:answer/id #uuid "1823c3eb-0c29-5698-8bd9-73b26d35b304" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186123959} {:answer/id #uuid "1b81ed15-8180-5476-bd0f-8480f3857e57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186123960} {:answer/id #uuid "4e2b4b0b-b7aa-5de6-8a35-a718cca8d034" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186123961}] :answer-field/correct {:db/id #edb/ref 17592186123959} :answer-field/id #uuid "10a51164-edc3-5bcd-b5d5-b6430f4e1533" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186123956}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b3d2ae44-10d9-5db3-858c-8da3c9096267" :question/math-academy-id "q-79814" :question/problem "If $f(x,y,z)=y{e}^{x}+xz,$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y,z)$ from $(0,1,2)$ to $(-1,0,3).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂x})\\,\\text{d}z \\\\  & =(y{e}^{x}+z)\\,\\text{d}x+{e}^{x}\\,\\text{d}y+x\\,\\text{d}z\\end{aligned}\n$$\n\nAt the point $(0,1,2),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(0,1,2) & =(1\\cdot {e}^{0}+2)\\,\\text{d}x+{e}^{0}\\,\\text{d}y+0\\,\\text{d}z \\\\  & =3\\,\\text{d}x+1\\,\\text{d}y+0\\,\\text{d}z.\\end{aligned}\n$$\n\nSo, if we move to the point $(0+Δx,1+Δy,2+Δz),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈3\\,Δx+1\\,Δy+0\\,Δz.\n$$\n\nMoving from $(0,1,2)$ to $(-1,0,3),$ we have\n\n$$\n\\begin{aligned}Δx & =-1-0=-1, \\\\ Δy & =0-1=-1 \\\\ Δz & =3-2=1.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈3\\,Δx+1\\,Δy+0\\,Δz \\\\  & ≈3\\cdot (-1)+1\\cdot (-1)+0\\cdot (1) \\\\  & ≈-4.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y,z)$ decreases by approximately $-4.$"} :step/id #uuid "088b3514-bc5b-5449-aa23-34fd0bf5d3dd" :step/next {:db/id #edb/ref 17592186498651}} {:db/id #edb/ref 17592186498610 :step/content {:db/id #edb/ref 17592186498589 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "617286e8-47ce-51b6-b506-3b48cff8cb06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,\\text{d}a+2\\,\\text{d}b+\\text{d}h" :db/id #edb/ref 17592186498029} {:answer/id #uuid "7cd99149-aedb-5119-a535-5559ad7a90f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{d}a+2\\,\\text{d}b+4\\,\\text{d}h" :db/id #edb/ref 17592186498093} {:answer/id #uuid "884b8e65-9503-5538-83b3-f52c4b72fe28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,\\text{d}a+\\text{d}b+2\\,\\text{d}h" :db/id #edb/ref 17592186498114} {:answer/id #uuid "89575744-0951-5e71-9a75-60b9e81bb12b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,\\text{d}a+4\\,\\text{d}b+\\text{d}h" :db/id #edb/ref 17592186498116} {:answer/id #uuid "cab3f89e-5562-5702-943e-6433f814978e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\,\\text{d}a+\\text{d}b+4\\,\\text{d}h" :db/id #edb/ref 17592186498250}] :answer-field/correct {:db/id #edb/ref 17592186498250} :answer-field/id #uuid "361b4f31-81d9-5f43-b63b-1aa713ee6c5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186498384}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e1b5df81-7853-5e90-b2a0-96b74729c9c8" :question/math-academy-id "q-79749" :question/problem "Given a right triangular prism, find the differential $\\text{d}V$ for the volume $V$ if the height is $h=1$ and the base is a right triangle with legs $a=2$ and $b=4.$" :question/worked-solution "The volume of a given right triangular prism is $V=\\frac{abh}{2}.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}V(a,b,c) & =(\\frac{∂V}{∂a})\\,\\text{d}a+(\\frac{∂V}{∂b})\\,\\text{d}b+(\\frac{∂V}{∂h})\\,\\text{d}h \\\\  & =\\frac{bh}{2}\\,\\text{d}a+\\frac{ah}{2}\\,\\text{d}b+\\frac{ab}{2}\\,\\text{d}h\\end{aligned}\n$$\n\nFor $a=2,$ $b=4,$ and $h=1,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}V(2,4,1) & =\\frac{4\\cdot 1}{2}\\,\\text{d}a+\\frac{2\\cdot 1}{2}\\,\\text{d}b+\\frac{2\\cdot 4}{2}\\,\\text{d}h \\\\  & =2\\,\\text{d}a+\\text{d}b+4\\,\\text{d}h.\\end{aligned}\n$$"} :step/id #uuid "145b0fcf-5bc5-5799-a79e-37ee8628b0fd" :step/next {:db/id #edb/ref 17592186498605}} {:db/id #edb/ref 17592186498632 :step/content {:db/id #edb/ref 17592186354502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4664834b-f9c2-5711-9fbe-9e47c49b3446" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186352218} {:answer/id #uuid "57f10dd3-b6db-56b3-a0bc-7ae2adcbd893" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186352342} {:answer/id #uuid "589f8986-d7f3-5f81-95dc-09885e486e74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-24" :db/id #edb/ref 17592186352346} {:answer/id #uuid "acef1955-0448-5736-b63d-c7e469566b4b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12" :db/id #edb/ref 17592186353034} {:answer/id #uuid "e8ea3e5d-e86e-5f69-be8a-a181e3697068" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186353593}] :answer-field/correct {:db/id #edb/ref 17592186353034} :answer-field/id #uuid "2e0aaa07-d114-533e-b9c9-fc1efde6d6b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186353892}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ed7f3fdb-ae1d-565d-b08f-f4ca7b1197c9" :question/math-academy-id "q-86716" :question/problem "If $f(x,y,z)=(2x+{y}^{2}-z)^{2},$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y,z)$ from $(1,2,0)$ to $(2,1.5,1).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =4(2x+{y}^{2}-z)\\,\\text{d}x+4y(2x+{y}^{2}-z)\\,\\text{d}y-2(2x+{y}^{2}-z)\\,\\text{d}z\\end{aligned}\n$$\n\nAt the point $(1,2,0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(1,2,0) & =4(2\\cdot 1+{2}^{2}-0)\\,\\text{d}x+(4\\cdot 2)(2\\cdot 1+{2}^{2}-0)\\,\\text{d}y-2(2\\cdot 1+{2}^{2}-0)\\,\\text{d}z \\\\  & =24\\,\\text{d}x+48\\,\\text{d}y-12\\,\\text{d}z.\\end{aligned}\n$$\n\nSo, if we move to the point $(1+Δx,2+Δy,0+Δz),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈24\\,Δx+48\\,Δy-12\\,Δz.\n$$\n\nMoving from $(1,2,0)$ to $(2,1.5,1),$ we have\n\n$$\n\\begin{aligned}Δx & =2-1=1, \\\\ Δy & =1.5-2=-0.5 \\\\ Δz & =1-0=1.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈24\\,Δx+48\\,Δy-12\\,Δz \\\\  & ≈24\\cdot 1+48\\cdot (-0.5)-12\\cdot 1 \\\\  & ≈-12.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y,z)$ decreases by approximately $-12.$"} :step/id #uuid "740c900e-a259-591c-8909-204f7f1d3bdc"} {:db/id #edb/ref 17592186498649 :step/content {:db/id #edb/ref 17592186375384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b7f183-ac89-5adb-9509-67e6410e2eda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,\\text{d}r+40\\,\\text{d}l" :db/id #edb/ref 17592186375386} {:answer/id #uuid "3e9dd3ed-eaf8-543f-9cc9-8a1e7cc69c1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\pi \\,\\text{d}r+10\\pi \\,\\text{d}l" :db/id #edb/ref 17592186375387} {:answer/id #uuid "8ad85924-7918-597c-a6e9-8076e5041dd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\,\\text{d}r+6\\,\\text{d}l" :db/id #edb/ref 17592186375388} {:answer/id #uuid "6c9e0aee-c171-578f-be62-2d9fa754d026" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\pi \\,\\text{d}r+12\\pi \\,\\text{d}l" :db/id #edb/ref 17592186375389} {:answer/id #uuid "61520cb3-6fa1-591d-aec4-9e23c7e259a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "10\\pi \\,\\text{d}r+6\\pi \\,\\text{d}l" :db/id #edb/ref 17592186375390}] :answer-field/correct {:db/id #edb/ref 17592186375390} :answer-field/id #uuid "894bb581-a8fd-5805-ac2d-24aef358fe0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186375385}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ddfbfeb1-47d1-5e4a-929c-ad72e52c8b4d" :question/math-academy-id "q-79959" :question/problem "Given a right cone, find the differential $\\text{d}S$ for the lateral surface area $S$ of the right cone if the base radius is $r=6,$ and the slant height is $l=10.$" :question/worked-solution "The  lateral surface area of the right cone is $S=\\pi rl.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(rl) & =(\\frac{∂S}{∂r})\\,\\text{d}r+(\\frac{∂S}{∂l})\\,\\text{d}l \\\\  & =\\pi l\\,\\text{d}r+\\pi r\\,\\text{d}l\\end{aligned}\n$$\n\nFor $r=6,$ and $l=10,$  the differential is\n\n$$\n\\begin{aligned}\\text{d}S(6,10) & =10\\pi \\,\\text{d}r+6\\pi \\,\\text{d}l.\\end{aligned}\n$$"} :step/id #uuid "c392a7db-b0ed-5603-b7c1-35e5cf82123f" :step/next {:db/id #edb/ref 17592186498632}} {:db/id #edb/ref 17592186498651 :step/content {:db/id #edb/ref 17592186348300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "032ef8bf-a149-5f5d-b9bc-54e6d8674bc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.062" :db/id #edb/ref 17592186345377} {:answer/id #uuid "3c56bb24-5e3e-5dba-9bd7-0f16e2f3edd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.066" :db/id #edb/ref 17592186345861} {:answer/id #uuid "7d3bf950-dbc6-55c7-8257-4238683ae1b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.060" :db/id #edb/ref 17592186346447} {:answer/id #uuid "85c38cb7-115d-538e-baa8-9d152e8db340" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.058" :db/id #edb/ref 17592186346514} {:answer/id #uuid "8cf00326-ca9e-5146-a772-c3778f9f8641" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0.064" :db/id #edb/ref 17592186346578}] :answer-field/correct {:db/id #edb/ref 17592186346447} :answer-field/id #uuid "52c20e21-9157-5114-a78d-535633267fdc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347748}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2e921641-2f51-5af1-85b0-a27e011ac9c8" :question/math-academy-id "q-79836" :question/problem "Estimate $\\operatorname{cos}⁡(1)\\operatorname{sin}⁡(0.12)$ using a differential $\\text{d}f$ of the function $f(x,y)=\\operatorname{cos}⁡x\\operatorname{sin}⁡y$ at the point $(\\frac{\\pi }{3},0).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =-\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\,\\text{d}x+\\operatorname{cos}⁡x\\operatorname{cos}⁡y\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(\\frac{\\pi }{3},0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =-\\operatorname{sin}⁡(\\frac{\\pi }{3})\\operatorname{sin}⁡0\\,\\text{d}x+\\operatorname{cos}⁡(\\frac{\\pi }{3})\\operatorname{cos}⁡0\\,\\text{d}y \\\\  & =0\\,\\text{d}x+\\frac{1}{2}\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(\\frac{\\pi }{3}+Δx,0+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈0\\,Δx+\\frac{1}{2}\\,Δy\n$$\n\nNote that \n\n$$\n\\operatorname{cos}⁡(1)\\operatorname{sin}⁡(0.12)=f(1,0.12),\n$$\n\nso we want to move to the point $(1,0.12).$\n\nMoving from $(\\frac{\\pi }{3},0)$ to $(1,0.12),$ we have\n\n$$\n\\begin{aligned}Δx & =1-\\frac{\\pi }{3}, \\\\ Δy & =0.12-0=0.12.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈0\\cdot (1-\\frac{\\pi }{3})+\\frac{1}{2}\\cdot (0.12) \\\\  & ≈0+0.5\\cdot 0.12 \\\\  & ≈0.06.\\end{aligned}\n$$\n\nThis means that the value of $f$ increases by about $0.06.$ Consequently, we have\n\n$$\n\\begin{aligned}f(1,0.12) & ≈f(\\frac{\\pi }{3},0)+0.06 \\\\ \\operatorname{cos}⁡(1)\\operatorname{sin}⁡(0.12) & ≈\\operatorname{cos}⁡(\\frac{\\pi }{3})\\operatorname{sin}⁡(0)+0.06 \\\\  & ≈0+0.06 \\\\  & ≈0.06.\\end{aligned}\n$$"} :step/id #uuid "c484bbba-14d6-565d-8ee8-8fad99f87433" :step/next {:db/id #edb/ref 17592186498649}}] :activity/title "Differentials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186497789}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186572730} :activity/id #uuid "4f3aedea-ce59-5377-a919-75712b7234d6" :activity/scope {:db/id #edb/ref 17592186049789 :topic/id #uuid "1421ca6c-3154-54fc-9984-2ec221f95a7c" :topic/math-academy-id 1950} :activity/steps [{:db/id #edb/ref 17592186572730 :step/content {:db/id #edb/ref 17592186125053 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c166559-b9a5-59ca-92aa-d849b5b800a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}\\,\\text{d}r+\\frac{1}{8}\\,\\text{d}\\theta " :db/id #edb/ref 17592186321360} {:answer/id #uuid "3bff60af-8093-5e22-9ff2-3056ea97c0ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{8}\\,\\text{d}r+\\frac{1}{8}\\,\\text{d}\\theta " :db/id #edb/ref 17592186321612} {:answer/id #uuid "7c3f6608-3382-52d2-9d27-9c29bc8d2ae1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi \\,\\text{d}r+4\\,\\text{d}\\theta " :db/id #edb/ref 17592186322124} {:answer/id #uuid "e0877f70-66c5-5f27-a401-90a010bced15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}\\,\\text{d}r+8\\,\\text{d}\\theta " :db/id #edb/ref 17592186322904} {:answer/id #uuid "f7d70644-2e54-528f-b715-5f4611844894" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}\\,\\text{d}r+4\\,\\text{d}\\theta " :db/id #edb/ref 17592186323095}] :answer-field/correct {:db/id #edb/ref 17592186322904} :answer-field/id #uuid "272d4a53-db30-59a7-93a4-ebd19e141f58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323245}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f9652424-c2ee-5706-a3c2-84b62902c6d8" :question/math-academy-id "q-37295" :question/problem "Given a sector of a circle, find the differential $\\text{d}S$ for the surface area $S$ if the radius is $r=4$ and the central angle is $\\theta =\\frac{\\pi }{8}.$" :question/worked-solution "The area of the sector is $S=\\frac{\\theta }{2}{r}^{2}.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(r,\\theta ) & =(\\frac{∂S}{∂r})\\,\\text{d}r+(\\frac{∂S}{∂\\theta })\\,\\text{d}\\theta  \\\\  & =r\\theta \\,\\text{d}r+\\frac{{r}^{2}}{2}\\,\\text{d}\\theta \\end{aligned}\n$$\n\nFor $r=4$ and $\\theta =\\frac{\\pi }{8},$ the differential is\n\n$$\n\\begin{aligned}\\text{d}S(4,\\frac{\\pi }{8}) & =4\\cdot \\frac{\\pi }{8}\\,\\text{d}r+\\frac{{4}^{2}}{2}\\,\\text{d}\\theta  \\\\  & =\\frac{\\pi }{2}\\,\\text{d}r+8\\,\\text{d}\\theta .\\end{aligned}\n$$"} :step/id #uuid "05e1162b-9ac7-5dd4-9211-b622aacaf22f" :step/next {:db/id #edb/ref 17592186572745}} {:db/id #edb/ref 17592186572738 :step/content {:db/id #edb/ref 17592186348271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "009c9900-f889-52f9-b00b-40100c9397c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186345359} {:answer/id #uuid "33de2cd4-781a-5e11-9d06-401da624c0ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "17\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186345803} {:answer/id #uuid "6c775b28-e659-58c3-afb4-970c5a4d0320" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186346292} {:answer/id #uuid "80dabf23-d4b2-59f9-93af-a8e0472606a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "40\\,\\text{d}a+48\\,\\text{d}h" :db/id #edb/ref 17592186346477} {:answer/id #uuid "ef0dac21-38b0-572f-851b-fdb97e5e86a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186347461}] :answer-field/correct {:db/id #edb/ref 17592186345359} :answer-field/id #uuid "c0653cbc-f79b-58c9-bc1b-48709188cc90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347942}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6f0e792d-8d7d-5fba-9784-ec8ac9d90e29" :question/math-academy-id "q-79747" :question/problem "Given a rectangular solid, find the differential $\\text{d}S$ for the surface area $S$ of the rectangular solid if the base is a square with the side of $a=3$ and the height is $h=7.$" :question/worked-solution "The surface area of the given rectangular solid is $S=2{a}^{2}+4ah.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(a,h) & =(\\frac{∂S}{∂a})\\,\\text{d}a+(\\frac{∂S}{∂h})\\,\\text{d}h \\\\  & =(4a+4h)\\,\\text{d}a+4a\\,\\text{d}h\\end{aligned}\n$$\n\nFor $a=3$ and $h=7,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}S(3,7) & =(4\\cdot 3+4\\cdot 7)\\,\\text{d}a+4\\cdot 3\\,\\text{d}h \\\\  & =40\\,\\text{d}a+12\\,\\text{d}h.\\end{aligned}\n$$"} :step/id #uuid "1844416f-fe2c-5284-9655-9bd296331880" :step/next {:db/id #edb/ref 17592186572802}} {:db/id #edb/ref 17592186572745 :step/content {:db/id #edb/ref 17592186125056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "067f9b24-89cd-5640-aaaf-dff8c95ef59b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{d}x}{x+{y}^{2}}+\\frac{2y\\,\\text{d}y}{x+{y}^{2}}" :db/id #edb/ref 17592186321199} {:answer/id #uuid "1128d9b0-3826-5d98-9cc7-5f834358d3e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\text{d}x}{x+{y}^{2}}+\\frac{y\\,\\text{d}y}{x+{y}^{2}}" :db/id #edb/ref 17592186321281} {:answer/id #uuid "1e27c6eb-0785-5dec-84a8-1534c6f56ed8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x\\,\\text{d}x}{x+{y}^{2}}+\\frac{2y\\,\\text{d}y}{x+{y}^{2}}" :db/id #edb/ref 17592186321377} {:answer/id #uuid "3706943f-d54b-5676-bb50-c5c8aee51976" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(x+{y}^{2})\\,\\text{d}x+(x+{y}^{2})\\,\\text{d}y" :db/id #edb/ref 17592186321564} {:answer/id #uuid "5a9f369b-c20d-558d-9b39-4e4d7b41f3dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\,\\text{d}x}{x+{y}^{2}}-\\frac{2\\,\\text{d}y}{x+{y}^{2}}" :db/id #edb/ref 17592186321862}] :answer-field/correct {:db/id #edb/ref 17592186321199} :answer-field/id #uuid "7cc20461-d761-56fc-9e28-0485df92bb1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323417}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3d0cda7b-1864-5320-acd1-fb1c921ad388" :question/math-academy-id "q-37307" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y)=\\operatorname{ln}⁡(x+{y}^{2}).$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{\\text{d}x}{x+{y}^{2}}+\\frac{2y\\,\\text{d}y}{x+{y}^{2}}\\end{aligned}\n$$"} :step/id #uuid "316729c9-4888-5409-95a4-73e5ccec848e" :step/next {:db/id #edb/ref 17592186572746}} {:db/id #edb/ref 17592186572746 :step/content {:db/id #edb/ref 17592186348265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02dad359-25f2-59b1-a326-992f7d8f2be8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3{x}^{2}y-{y}^{3})\\text{d}x+({x}^{2}+{x}^{3}-3{y}^{2})\\text{d}y" :db/id #edb/ref 17592186345374} {:answer/id #uuid "37a0854b-5ffd-53b5-a97e-3fc8c049dafa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3{x}^{2}y)\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y" :db/id #edb/ref 17592186345828} {:answer/id #uuid "78a766e2-5151-5cd4-bd3b-cdc71e40524c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3{x}^{2}y-{y}^{3})\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y" :db/id #edb/ref 17592186346407} {:answer/id #uuid "9d887fd2-2962-51ac-ad91-2c074402c2fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2x+3{x}^{2})\\text{d}x+({x}^{3}-{y}^{2})\\text{d}y" :db/id #edb/ref 17592186346722} {:answer/id #uuid "cbcdcfbb-2ee8-5177-94d0-d8a8b2bddfea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({x}^{3}-3{y}^{2})\\text{d}x+(2x+3{x}^{2}y)\\text{d}y" :db/id #edb/ref 17592186347137}] :answer-field/correct {:db/id #edb/ref 17592186345828} :answer-field/id #uuid "53ddc30c-7b7f-5181-82b4-b214c29b463f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347755}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "af353571-e5f3-5cb8-87db-52892f4fbe38" :question/math-academy-id "q-79739" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y)={x}^{2}+{x}^{3}y-{y}^{3}.$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =(2x+3{x}^{2}y)\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y\\end{aligned}\n$$"} :step/id #uuid "31929053-f3b9-591b-bdc2-747c8a370f98" :step/next {:db/id #edb/ref 17592186572738}} {:db/id #edb/ref 17592186572802 :step/content {:db/id #edb/ref 17592186348291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20b1b01d-dcce-5e97-8070-3e46cd24a9b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e-2" :db/id #edb/ref 17592186345641} {:answer/id #uuid "5d489c63-3bed-55d1-88eb-6a7cb5ad4096" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e" :db/id #edb/ref 17592186346150} {:answer/id #uuid "702fd59b-e266-554c-9f4d-07da9651143b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186346329} {:answer/id #uuid "c8ef46c8-495f-50a4-88cb-4b955b1c8d64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186347101} {:answer/id #uuid "e60a87d9-0bac-5840-9059-0b6443f4f86e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-e" :db/id #edb/ref 17592186347379}] :answer-field/correct {:db/id #edb/ref 17592186347101} :answer-field/id #uuid "e9750bae-5c66-5b82-a422-b4ec85ac0ea9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186348011}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a59577cc-4986-5576-9592-2ad42c96ff6f" :question/math-academy-id "q-79812" :question/problem "If $f(x,y)=x\\operatorname{ln}⁡y,$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(0,e)$ to $(1,2).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\operatorname{ln}⁡y\\,\\text{d}x+\\frac{x}{y}\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(0,e),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(0,e) & =\\operatorname{ln}⁡e\\,\\text{d}x+\\frac{0}{e}\\,\\text{d}y \\\\  & =1\\,\\text{d}x+0\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(0+Δx,e+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈1\\,Δx+0\\,Δy.\n$$\n\nMoving from $(0,e)$ to $(1,2),$ we have\n\n$$\n\\begin{aligned}Δx & =1-0=1, \\\\ Δy & =2-e.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\,Δx+0\\,Δy \\\\  & ≈1\\cdot (1)+0\\cdot (2-e) \\\\  & ≈1.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ increases by approximately $1.$"} :step/id #uuid "e9b6a348-f1db-5091-823d-f40f938737e7"}] :activity/title "Differentials" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186572304}]}
