#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186064992} :activity/id #uuid "8a6775e9-2229-5837-a376-b69fe905d97e" :activity/scope {:db/id #edb/ref 17592186048123 :topic/id #uuid "80ecc4ad-075a-51a6-a1fc-72dc61a2444d" :topic/math-academy-id 313} :activity/steps [{:db/id #edb/ref 17592186064992 :step/content {:db/id #edb/ref 17592186065347 :tutorial/content "Let's consider the graph of the function $y=f(x)$ on the closed interval $[0,7]$ shown below.\n\n![](images/39/39851b8fc5658ccfd92711eb9fe7a00a730300a3bf2e635911bdd51ea69de37a.png)\n\nThe **critical points** of $f(x)$ are the values of $x$ where $f'(x)=0$ or $f'(x)$ doesn't exist. Graphically, those are the values where the tangent to the graph is horizontal or where the tangent does not exist, respectively.\n\nIn the given graph, we can see that \n\n- at $x=2,$ the tangent to the graph is horizontal, so we have $f'(x)=0,$ while\n\n- at $x=4,$ there is a sharp corner, so $f'(x)$ doesn't exist.\n\nSo, there are two critical points, and their $x$-coordinates are $x=2$ and $x=4.$ \n\nIn particular, a critical point is called a **stationary point** if $f'(x)=0.$ So here, the points $x=2$ and $x=4$ are both critical points, but only the point at $x=2$ is a stationary point.\n\n![](images/4e/4e91994fa85a068ef847cbd82dc176569fd15ab2487dfff6936280e9a1deb634.png)" :tutorial/id #uuid "36584e6c-f116-5ad4-bb03-576b0f7e9c0e" :tutorial/math-academy-id 2660 :tutorial/title "Introduction"} :step/id #uuid "02673d5b-6611-5854-bca0-ff7445f2f3c3" :step/math-academy-id 12782 :step/next {:db/id #edb/ref 17592186065158}} {:db/id #edb/ref 17592186064993 :step/content {:db/id #edb/ref 17592186064162 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064044 :question/id #uuid "2d9fc36f-8d8f-5e57-9ff0-28a032e71980" :question/math-academy-id "e-3726"} :knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048164} {:db/id #edb/ref 17592186050033}] :knowledge-point/questions [{:db/id #edb/ref 17592186064801} {:db/id #edb/ref 17592186064835} {:db/id #edb/ref 17592186238005} {:db/id #edb/ref 17592186238006} {:db/id #edb/ref 17592186238008} {:db/id #edb/ref 17592186329920} {:db/id #edb/ref 17592186329921} {:db/id #edb/ref 17592186402902} {:db/id #edb/ref 17592186402909}] :knowledge-point/title "Identifying Extrema of a Function Given Its Graph"} :step/id #uuid "2b2aa51f-4124-5395-afb4-05149fddd969" :step/math-academy-id 12789} {:db/id #edb/ref 17592186065158 :step/content {:db/id #edb/ref 17592186064273 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064116 :question/id #uuid "97897d09-3dc9-5e35-8f56-d44f54c542cc" :question/math-academy-id "e-6169"} :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048420} {:db/id #edb/ref 17592186050711}] :knowledge-point/questions [{:db/id #edb/ref 17592186064800} {:db/id #edb/ref 17592186064802} {:db/id #edb/ref 17592186235483} {:db/id #edb/ref 17592186238003} {:db/id #edb/ref 17592186238004} {:db/id #edb/ref 17592186329838} {:db/id #edb/ref 17592186329839} {:db/id #edb/ref 17592186341964} {:db/id #edb/ref 17592186341965} {:db/id #edb/ref 17592186403633} {:db/id #edb/ref 17592186403640}] :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"} :step/id #uuid "589482bf-a622-576c-8b59-1c5332c13087" :step/math-academy-id 23042 :step/next {:db/id #edb/ref 17592186065159}} {:db/id #edb/ref 17592186065159 :step/content {:db/id #edb/ref 17592186065374 :tutorial/content "Some critical points are **local extrema**. There are two types of local extrema:\n\n- A **local minimum** is the lowest point of a valley in a graph. Equivalently, $x=a$ is a local minimum if for $x$ values \"close\" to $x=a,$ we have $f(x) \\geq f(a)$.\n\n- A **local maximum** is the highest point of a peak in a graph. Equivalently, $x=a$ is a local maximum if for $x$ values \"close\" to $x=a,$ we have $f(x) \\leq f(a)$.\n\n![](images/d6/d6fbdf74b282bd5b8172fcc7927f84bbdfd050a717794f3b40c8e58b83d7b87e.png)\n\nOn the graph above, the critical point at $x=4$ is a local minimum since it is the lowest point of a valley. Likewise, the critical point at $x=6$ is a local maximum since it is the highest point of a peak. But the critical point at $x=2$ is not a local extremum since it is neither a peak nor a valley.\n\nThe **global extrema** of a function in an interval are given by the lowest or highest points of the function's graph in the whole interval.\n\n- The lowest point is the **global minimum**, whereas\n\n- the highest point is the **global maximum**.\n\nHere, the global minimum is at $x=4$, and the global maximum is at $x=0.$\n\n![](images/8a/8adb83da866dae1cd122b5271b2cb9036c72a389eaf1c48148888140bda576ac.png)\n\n\"Local\" extrema are the lowest or highest points compared to points that are very close to them. On the other hand, \"global\" extrema are the lowest/highest points of the graph over its entire domain." :tutorial/id #uuid "05856315-caeb-577d-9dea-b5e5f8830820" :tutorial/math-academy-id 3898 :tutorial/title "Local and Global Extrema of a Function"} :step/id #uuid "b952eadc-3fe2-5be0-8961-f9af3dc6fcd5" :step/math-academy-id 23043 :step/next {:db/id #edb/ref 17592186064993}}] :activity/title "Global vs. Local Extrema and Critical Points" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064409}] [{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186092985} :activity/id #uuid "1f4a96cc-7c54-52f8-a1a6-15cb899c1e06" :activity/scope {:db/id #edb/ref 17592186048154 :topic/id #uuid "83982bb2-6110-5530-b99f-551ac70d16db" :topic/math-academy-id 945} :activity/steps [{:db/id #edb/ref 17592186092985 :step/content {:db/id #edb/ref 17592186093489 :tutorial/content "Suppose that we wish to approximate the area ![](images/6b/6bd69882ede929379fa9babdf49386dd09138f26cabc6a4d617bbac5e92d21a5.svg) under the curve ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) on the interval ![](images/ef/ef1ae5c1ba5a449d816bfb51a4a5d469ea802406b197a04c15e1c885c5e295b8.svg)\n\n![](images/b0/b07fe3413d7739cb2173d31323bc86df46ef2c48390a6d36f877be80ccf2e4bc.png)\n\nWe have already seen how to estimate the area using left and right Riemann sums, in which we approximate the area using rectangles.\n\nHowever, we can get an even better estimate using trapezoids instead. The process of approximating the area under a curve using trapezoids is called the **trapezoidal rule.**\n\nHere, we will approximate the area under the graph of ![](images/2e/2eb046be7e52e5a72d29a1333f9cf483411f0a8d6d897fe53014cc1952c6f759.svg) with three trapezoids, each with a height equal to ![](images/da/daae2fd3251c4ba175906af980d1c33d4db057c616509ec6a146307d64417228.svg) Note that the trapezoids are turned on their side, so *their heights run horizontally*.\n\n![](images/13/13b034759b6acf4a451b0725e6abf4d23ae1dc80e567ee792ad51116e35f3373.png)\n\nWe compute the area of each trapezoid and add them all together:\n\n![](images/09/093f580f625b22a2cf914a85c64b433e280e30071df9c934ddef49af5034e1da.svg)\n\nBecause the function is *concave up* over the interval ![](images/85/8559262277e3f52fd1eb8139fad407ed50f80873ec56c7349969a9a3ee6789e4.svg) the trapezoids reach above the function, and therefore our approximation is an *overestimate* of the actual area." :tutorial/id #uuid "e65800fc-8bfa-5eef-910a-646db63059f3" :tutorial/math-academy-id 745 :tutorial/title "Introduction"} :step/id #uuid "a39b94fd-84fb-50cb-a6e2-54562afa24b2" :step/math-academy-id 1433 :step/next {:db/id #edb/ref 17592186093339}} {:db/id #edb/ref 17592186092986 :step/content {:db/id #edb/ref 17592186092179 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092005 :question/id #uuid "d5b950ed-cb5e-5160-a0ca-c88c8bf8f2af" :question/math-academy-id "e-398"} :knowledge-point/id #uuid "32793ffd-b4c6-58af-9f6f-69c756ed7f1d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048147} {:db/id #edb/ref 17592186048363} {:db/id #edb/ref 17592186049386}] :knowledge-point/questions [{:db/id #edb/ref 17592186092740} {:db/id #edb/ref 17592186092743} {:db/id #edb/ref 17592186319151} {:db/id #edb/ref 17592186323803} {:db/id #edb/ref 17592186323804} {:db/id #edb/ref 17592186354417} {:db/id #edb/ref 17592186354418}] :knowledge-point/title "Using the Trapezoidal Rule with Regular Step Size"} :step/id #uuid "a4629462-9622-5f78-a714-26307a2c193d" :step/math-academy-id 1434 :step/next {:db/id #edb/ref 17592186093144}} {:db/id #edb/ref 17592186092987 :step/content {:db/id #edb/ref 17592186093490 :tutorial/content "So far, the step size $\\Delta x$ has been the same for each trapezoid. In these cases, we say that the step size is **regular**.\n\nHowever, in some situations, the step size can vary. In such cases, we say that the step size is **irregular**. But we can still use the trapezoidal rule to approximate the area under a curve. Let's see an example." :tutorial/id #uuid "cdc39254-77da-5bea-bcaf-2e7e1b965777" :tutorial/math-academy-id 748 :tutorial/title "Trapezoidal Rule Sum with Irregular Step Size"} :step/id #uuid "04c3acc3-25f5-55e2-9af7-0b249fe1ad45" :step/math-academy-id 1438 :step/next {:db/id #edb/ref 17592186092988}} {:db/id #edb/ref 17592186092988 :step/content {:db/id #edb/ref 17592186092180 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092006 :question/id #uuid "902fb0e4-47fd-53b7-9755-b5cbe49fd9be" :question/math-academy-id "e-399"} :knowledge-point/id #uuid "bec73486-156f-5124-97b4-58f65ea8430d" :knowledge-point/questions [{:db/id #edb/ref 17592186092741} {:db/id #edb/ref 17592186092859} {:db/id #edb/ref 17592186253254} {:db/id #edb/ref 17592186253255} {:db/id #edb/ref 17592186319154} {:db/id #edb/ref 17592186354425} {:db/id #edb/ref 17592186354431} {:db/id #edb/ref 17592186354432}] :knowledge-point/title "Using the Trapezoidal Rule With Irregular Step Size"} :step/id #uuid "502bd3d3-92d7-5b81-9e46-de4cbc0abae7" :step/math-academy-id 1439 :step/next {:db/id #edb/ref 17592186092989}} {:db/id #edb/ref 17592186092989 :step/content {:db/id #edb/ref 17592186092181 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092007 :question/id #uuid "609e4a44-e2cc-5980-806e-a1ebd27f56ea" :question/math-academy-id "e-400"} :knowledge-point/id #uuid "903cd6d7-18f2-5b53-a8e9-9aaef5589549" :knowledge-point/questions [{:db/id #edb/ref 17592186092742} {:db/id #edb/ref 17592186092744} {:db/id #edb/ref 17592186253277} {:db/id #edb/ref 17592186297430} {:db/id #edb/ref 17592186319160} {:db/id #edb/ref 17592186332682} {:db/id #edb/ref 17592186332846} {:db/id #edb/ref 17592186332847} {:db/id #edb/ref 17592186399912}] :knowledge-point/title "Using the Trapezoidal Rule: Word Problem"} :step/id #uuid "77f0ef8a-4a60-5548-98f5-3232466916a7" :step/math-academy-id 1442} {:db/id #edb/ref 17592186093144 :step/content {:db/id #edb/ref 17592186092283 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092132 :question/id #uuid "ae0b4eee-5dfa-5a29-af18-ef1583697159" :question/math-academy-id "e-7515"} :knowledge-point/id #uuid "2960d2d6-7354-5f2a-80cc-8d514465455f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049011}] :knowledge-point/questions [{:db/id #edb/ref 17592186092736} {:db/id #edb/ref 17592186092737} {:db/id #edb/ref 17592186250519} {:db/id #edb/ref 17592186250520} {:db/id #edb/ref 17592186354424} {:db/id #edb/ref 17592186392663} {:db/id #edb/ref 17592186392670} {:db/id #edb/ref 17592186394696}] :knowledge-point/title "Identifying Whether the Trapezoidal Rule Sum Gives an Underestimate or Overestimate"} :step/id #uuid "968154c5-9136-51f9-b14d-facf1a6939ab" :step/math-academy-id 27893 :step/next {:db/id #edb/ref 17592186092987}} {:db/id #edb/ref 17592186093339 :step/content {:db/id #edb/ref 17592186093381 :tutorial/content "In the previous problem, we had the following expression for the trapezoidal rule sum:\n\n$$\n\\mathcal{A} \\approx \\dfrac{ {\\color{red}f(1)}+{\\color{red}f(2)} }{2}\\cdot {\\color{blue}\\Delta x} + \\dfrac{ {\\color{red}f(2)}+ {\\color{red}f(3)} }{2}\\cdot {\\color{blue}\\Delta x} + \\dfrac{ {\\color{red}f(3)}+ {\\color{red}f(4)} }{2}\\cdot {\\color{blue}\\Delta x}\n$$\n\nNotice that we can simplify the above by factoring out $\\dfrac{1}{2}$ and $\\Delta x,$ and also collecting like terms:\n\n$$\n\\mathcal{A} \\approx \\dfrac{1}{2} [ \\overbrace{{\\color{red}f(1)} + 2\\left( {\\color{red}f(2)}+{\\color{red}f(3)}\\right) +{\\color{red}f(4)}}^{\\color{red}\\large\\text{bases}} ] \\underbrace{\\color{blue}\\Delta x}_{\\color{blue}\\large\\text{height}}\n$$\n\nIn general, we can compute the trapezoidal rule sum for a function $y=f(x)$ over an interval $[a,b]$ using the **general formula** as follows:\n\n$$\n\\mathcal{A} \\approx \\dfrac{1}{2}\\cdot [\\overbrace{{\\color{red}f(a)} + 2({\\color{red}f(x_1)}+{\\color{red}f(x_2)}+ \\ldots +{\\color{red}f(x_{n-1})}) +{\\color{red}f(b)} }^{\\color{red}\\large\\text{bases}} ] \\cdot\\!\\! \\underbrace{\\color{blue}\\Delta x}_{\\color{blue}\\large\\text{height}},\n$$\n\nHere, $n$ is the number of trapezoids, and $\\Delta x$ is the step size given by\n\n$$\n\\Delta x = \\dfrac{b-a}{n}.\n$$\n\n**Note:** If we look carefully at the formula, we realize that the trapezoidal rule is an average of the left and right Riemann sums!" :tutorial/id #uuid "4c91f011-2a77-5e6e-b606-b2f1ba9109a5" :tutorial/math-academy-id 2025 :tutorial/title "The General Formula"} :step/id #uuid "c1e23387-2dc2-5a65-bcbf-4120235e3273" :step/math-academy-id 7562 :step/next {:db/id #edb/ref 17592186092986}}] :activity/title "Approximating Areas With the Trapezoidal Rule" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092439}] [{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186093335} :activity/id #uuid "21c10e32-8c2e-5d6b-a5cb-19f07aa83fdf" :activity/scope {:db/id #edb/ref 17592186049236 :topic/id #uuid "e5b028a3-9410-51df-925f-0bb38d65ee4b" :topic/math-academy-id 993} :activity/steps [{:db/id #edb/ref 17592186093089 :step/content {:db/id #edb/ref 17592186092242 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092084 :question/id #uuid "6e4ab84e-f722-557e-9740-25b3a0b3d660" :question/math-academy-id "e-6104"} :knowledge-point/id #uuid "6b175cb1-6615-540f-9145-224a838e37d0" :knowledge-point/questions [{:db/id #edb/ref 17592186092715} {:db/id #edb/ref 17592186092730} {:db/id #edb/ref 17592186317439} {:db/id #edb/ref 17592186329819} {:db/id #edb/ref 17592186339054} {:db/id #edb/ref 17592186339055} {:db/id #edb/ref 17592186508057} {:db/id #edb/ref 17592186508070} {:db/id #edb/ref 17592186508097}] :knowledge-point/title "Estimating a Derivative Given a Graph Using a Backward Difference Approximation"} :step/id #uuid "332d8f20-0643-51b2-8b43-875b7569adc3" :step/math-academy-id 22597 :step/next {:db/id #edb/ref 17592186093337}} {:db/id #edb/ref 17592186093090 :step/content {:db/id #edb/ref 17592186092243 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092085 :question/id #uuid "fb3d12e8-e413-5300-8d3f-991ddfd2a893" :question/math-academy-id "e-6105"} :knowledge-point/id #uuid "4d864064-2833-530a-b421-a57f9ec5fce5" :knowledge-point/questions [{:db/id #edb/ref 17592186092729} {:db/id #edb/ref 17592186092731} {:db/id #edb/ref 17592186317444} {:db/id #edb/ref 17592186317445} {:db/id #edb/ref 17592186317446} {:db/id #edb/ref 17592186329809} {:db/id #edb/ref 17592186354476} {:db/id #edb/ref 17592186508058} {:db/id #edb/ref 17592186508074}] :knowledge-point/title "Estimating a Derivative Given a Graph Using a Backward Difference Approximation: Word Problem"} :step/id #uuid "0358e8c8-7e96-5bb6-9fc7-eef0c1c3cde8" :step/math-academy-id 22598 :step/next {:db/id #edb/ref 17592186093338}} {:db/id #edb/ref 17592186093335 :step/content {:db/id #edb/ref 17592186093444 :tutorial/content "To approximate the derivative of a function, we can use the finite difference formula\n\n$$\nf'(x)\\approx \\frac{f(x) - f(x-h) }{h}\n$$\n\nfor small values of the step size $h,$ with $h>0.$\n\nThis expression is known as the **backward difference approximation** because if $h>0$ then $x-h$ is a step behind $x$ (i.e., to the left). \n\n![](images/dd/ddc03ba86c8c343d5733b51444cec157182894b6d0c4fccb501b1dc3bca98f57.png)\n\nAs usual, the smaller the step size $h$ is, the better the approximation to $f'(x)$ we obtain." :tutorial/id #uuid "6aff8fa6-f787-5984-944a-5648207e6830" :tutorial/math-academy-id 368 :tutorial/title "Introduction"} :step/id #uuid "5a2b7913-8af1-56e3-ae9c-6dea1ca15630" :step/math-academy-id 686 :step/next {:db/id #edb/ref 17592186093336}} {:db/id #edb/ref 17592186093336 :step/content {:db/id #edb/ref 17592186092390 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091959 :question/id #uuid "7a6fbfc8-cd6d-57fe-bcab-ab68339683bd" :question/math-academy-id "e-155"} :knowledge-point/id #uuid "494ef4f7-873c-5d87-85e5-89094c6cc376" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061} {:db/id #edb/ref 17592186049362}] :knowledge-point/questions [{:db/id #edb/ref 17592186092920} {:db/id #edb/ref 17592186092921} {:db/id #edb/ref 17592186317435} {:db/id #edb/ref 17592186317436} {:db/id #edb/ref 17592186317437} {:db/id #edb/ref 17592186339050} {:db/id #edb/ref 17592186339053} {:db/id #edb/ref 17592186508041} {:db/id #edb/ref 17592186508094} {:db/id #edb/ref 17592186508101}] :knowledge-point/title "Estimating a Derivative Given a Table Using a Backward Difference Approximation"} :step/id #uuid "f1579afd-f8b8-522d-815c-72dc7b18e4b7" :step/math-academy-id 687 :step/next {:db/id #edb/ref 17592186093089}} {:db/id #edb/ref 17592186093337 :step/content {:db/id #edb/ref 17592186092391 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091961 :question/id #uuid "cdf8854d-14ea-5564-81cc-4e5098f1acc3" :question/math-academy-id "e-156"} :knowledge-point/id #uuid "a6068e54-fa91-5078-86f8-d34f1f1a3ca4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048835}] :knowledge-point/questions [{:db/id #edb/ref 17592186092727} {:db/id #edb/ref 17592186092728} {:db/id #edb/ref 17592186317440} {:db/id #edb/ref 17592186317442} {:db/id #edb/ref 17592186329817} {:db/id #edb/ref 17592186332871} {:db/id #edb/ref 17592186339056} {:db/id #edb/ref 17592186508052} {:db/id #edb/ref 17592186508064} {:db/id #edb/ref 17592186508068} {:db/id #edb/ref 17592186508082}] :knowledge-point/title "Estimating a Derivative Given a Table Using a Backward Difference Approximation: Word Problem"} :step/id #uuid "84a50349-fb71-5a17-b1e7-276d47f34414" :step/math-academy-id 691 :step/next {:db/id #edb/ref 17592186093090}} {:db/id #edb/ref 17592186093338 :step/content {:db/id #edb/ref 17592186093445 :tutorial/content "Where does the formula for the backward difference come from? Remember that from the definition of derivative, we have the forward difference formula\n\n$$\nf'(x)\\approx \\frac{f(x+h) - f(x) }{h}\n$$\n\nfor small values of  $h.$ \n\nNow, replacing $h$ with $-h$ in the formula above gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & ≈\\frac{f(x-h)-f(x)}{-h} \\\\  & =\\frac{f(x)-f(x-h)}{h}.\\end{aligned}\n$$\n\nThe step of replacing $h$ with $-h$ is equivalent to stepping a distance of $h$ to the left rather than to the right." :tutorial/id #uuid "1cc2d207-71d4-53a4-8c67-5af0c5f4d173" :tutorial/math-academy-id 371 :tutorial/title "Derivation of the Formula"} :step/id #uuid "a635f38c-a7e9-57d1-aeb5-e9fe6f8751e0" :step/math-academy-id 694}] :activity/title "Estimating Derivatives Using a Backward Difference Quotient" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092467}] [{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186093330} :activity/id #uuid "3cb60590-ce3c-5ae5-bb4c-9fa261e5f9f2" :activity/scope {:db/id #edb/ref 17592186049934 :topic/id #uuid "1fbdb06d-f1f4-55f3-bf00-af01b659732d" :topic/math-academy-id 992} :activity/steps [{:db/id #edb/ref 17592186093330 :step/content {:db/id #edb/ref 17592186093443 :tutorial/content "For a function $f(x),$ its derivative at a point $x$ is defined by the limit\n\n$$\nf'(x) = \\lim\\limits_{h\\to 0} \\frac{f(x+h) - f(x) }{h}.\n$$\n\nBut often, computing this limit exactly is impossible or impractical. One example might be when we don't have an explicit expression for $f(x).$ In such cases, instead of finding an exact value for $f'(x)$, we can *approximate* the derivative using the formula\n\n \n\n$$\nf'(x)\\approx \\frac{f(x+h) - f(x) }{h}\n$$\n\nfor small values of the \"step size\" $h,$ with $h>0.$\n\nThis expression is called the **forward difference approximation** because if $h >0$ then $x+h$ is a step forward (i.e., to the right) from $x.$\n\n![](images/18/1860d33c3b34fa5c869f5a3c7a04ef4d02271ba30d60f973b892800ef7c9524e.png)\n\nGenerally, this and other similar methods are known as **finite-difference** approximations. The smaller the value of $h,$ the better the approximation." :tutorial/id #uuid "c3fb3f8f-2a89-5f4a-8f24-9cf556a18c41" :tutorial/math-academy-id 363 :tutorial/title "Introduction"} :step/id #uuid "c0976a2b-1337-5627-8c4d-ef63079d733d" :step/math-academy-id 676 :step/next {:db/id #edb/ref 17592186093331}} {:db/id #edb/ref 17592186093331 :step/content {:db/id #edb/ref 17592186092386 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091955 :question/id #uuid "a7f1c431-54b4-52b5-9ad6-cb4dd81e0f30" :question/math-academy-id "e-151"} :knowledge-point/id #uuid "44f09c22-7107-5c80-9c91-a7b58cb639b2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049061} {:db/id #edb/ref 17592186049362}] :knowledge-point/questions [{:db/id #edb/ref 17592186092912} {:db/id #edb/ref 17592186092913} {:db/id #edb/ref 17592186235470} {:db/id #edb/ref 17592186317191} {:db/id #edb/ref 17592186317192} {:db/id #edb/ref 17592186317193} {:db/id #edb/ref 17592186339010} {:db/id #edb/ref 17592186339012} {:db/id #edb/ref 17592186505796} {:db/id #edb/ref 17592186505805}] :knowledge-point/title "Estimating a Derivative From a Table Using a Forward Difference Approximation"} :step/id #uuid "f68f148f-5e8f-52a7-ae44-4bf6aabecc15" :step/math-academy-id 677 :step/next {:db/id #edb/ref 17592186093332}} {:db/id #edb/ref 17592186093332 :step/content {:db/id #edb/ref 17592186092387 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091956 :question/id #uuid "8717eda6-57e6-59ec-ab1c-f40887fa52fb" :question/math-academy-id "e-152"} :knowledge-point/id #uuid "419134c3-3177-5d7d-86f6-899a73338b1c" :knowledge-point/questions [{:db/id #edb/ref 17592186092719} {:db/id #edb/ref 17592186092720} {:db/id #edb/ref 17592186317197} {:db/id #edb/ref 17592186329812} {:db/id #edb/ref 17592186329813} {:db/id #edb/ref 17592186339014} {:db/id #edb/ref 17592186505794} {:db/id #edb/ref 17592186505813} {:db/id #edb/ref 17592186505823}] :knowledge-point/title "Estimating a Derivative From a Graph Using a Forward Difference Approximation"} :step/id #uuid "aa713ca3-ee27-5c87-897f-349e9d84433e" :step/math-academy-id 680 :step/next {:db/id #edb/ref 17592186093333}} {:db/id #edb/ref 17592186093333 :step/content {:db/id #edb/ref 17592186092388 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091957 :question/id #uuid "580533af-c13d-5e1c-8282-f0172709c7e1" :question/math-academy-id "e-153"} :knowledge-point/id #uuid "5e651cb4-ae24-5ac7-9c01-d90de562b155" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048835}] :knowledge-point/questions [{:db/id #edb/ref 17592186092716} {:db/id #edb/ref 17592186092717} {:db/id #edb/ref 17592186317198} {:db/id #edb/ref 17592186317199} {:db/id #edb/ref 17592186329811} {:db/id #edb/ref 17592186339015} {:db/id #edb/ref 17592186505746} {:db/id #edb/ref 17592186505779} {:db/id #edb/ref 17592186505842}] :knowledge-point/title "Estimating a Derivative From a Table Using a Forward Difference Approximation: Word Problem"} :step/id #uuid "7e8c5132-4661-56c0-9cc7-9cd625cd092f" :step/math-academy-id 682 :step/next {:db/id #edb/ref 17592186093334}} {:db/id #edb/ref 17592186093334 :step/content {:db/id #edb/ref 17592186092389 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091958 :question/id #uuid "73818e0b-6f95-59a6-b1a7-672bbea8de86" :question/math-academy-id "e-154"} :knowledge-point/id #uuid "167f04f0-c08e-51d8-acfa-2c4660083e6a" :knowledge-point/questions [{:db/id #edb/ref 17592186092718} {:db/id #edb/ref 17592186092721} {:db/id #edb/ref 17592186297362} {:db/id #edb/ref 17592186317204} {:db/id #edb/ref 17592186317205} {:db/id #edb/ref 17592186317206} {:db/id #edb/ref 17592186505821} {:db/id #edb/ref 17592186505833}] :knowledge-point/title "Estimating a Derivative From a Graph Using a Forward Difference Approximation: Word Problem"} :step/id #uuid "712fc50f-c422-5419-9b82-fa1b3e7a4a00" :step/math-academy-id 684}] :activity/title "Estimating Derivatives Using a Forward Difference Quotient" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092466}] [{:activity/first-step {:db/id #edb/ref 17592186065149} :activity/id #uuid "633bad62-882e-5d8a-8c9d-aa13b14ea6e1" :activity/scope {:db/id #edb/ref 17592186050572 :topic/id #uuid "54b8c8a0-5bff-5a9f-9ca1-b046c38a20d9" :topic/math-academy-id 336} :activity/steps [{:db/id #edb/ref 17592186065149 :step/content {:db/id #edb/ref 17592186065362 :tutorial/content "Consider a curve $y=f(x)$ between two points $x=a$ and $x=b$. The **average rate of change** of $y=f(x)$ on the interval $x\\in[a,b]$ is computed as follows:\n\n$$\n\\dfrac{\\Delta y}{\\Delta x} = \\dfrac{\\text{change in}y}{\\text{change in}x} = \\dfrac{f(b)-f(a)}{b-a}\n$$\n\nGeometrically, the average rate of change represents the slope of the **secant line** which passes through $(a,f(a))$ and $(b,f(b))$.\n\n![](images/2d/2d27bcc73d1bcb8545c058c06553e3f4bc80d5426a98f5bb90e4d4c0aef71108.png)\n\n**Note:** In general, a secant is a line that intersects a curve at two or more distinct points." :tutorial/id #uuid "4e32384d-35c4-578e-b254-9cf90914529e" :tutorial/math-academy-id 312 :tutorial/title "Introduction"} :step/id #uuid "59d271e2-f80e-5c14-bfff-c684c31322e1" :step/math-academy-id 206314 :step/next {:db/id #edb/ref 17592186065150}} {:db/id #edb/ref 17592186065150 :step/content {:db/id #edb/ref 17592186064267 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063929 :question/id #uuid "ac676612-cbb2-5057-a515-501e03414b5a" :question/math-academy-id "e-118"} :knowledge-point/id #uuid "68635d27-a9ef-541b-a57b-d9f5f422ae85" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048652} {:db/id #edb/ref 17592186049061}] :knowledge-point/questions [{:db/id #edb/ref 17592186064565} {:db/id #edb/ref 17592186064635} {:db/id #edb/ref 17592186233623} {:db/id #edb/ref 17592186233667}] :knowledge-point/title "Calculating the Average Rate of Change of a Function"} :step/id #uuid "963172d5-8251-51b5-aca6-4ecca42d86ee" :step/math-academy-id 206315 :step/next {:db/id #edb/ref 17592186065151}} {:db/id #edb/ref 17592186065151 :step/content {:db/id #edb/ref 17592186064268 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063931 :question/id #uuid "40bfeecc-aa0f-5901-9d75-bc94421b14ec" :question/math-academy-id "e-121"} :knowledge-point/id #uuid "1f7224e3-9c13-51e7-a3f7-0e379f63a861" :knowledge-point/questions [{:db/id #edb/ref 17592186064522} {:db/id #edb/ref 17592186064541} {:db/id #edb/ref 17592186233053} {:db/id #edb/ref 17592186233537} {:db/id #edb/ref 17592186233606} {:db/id #edb/ref 17592186233607}] :knowledge-point/title "Calculating the Average Rate of Change Given a Table"} :step/id #uuid "1d064d4d-5d1a-58f9-b5c9-1a03c3fe5caf" :step/math-academy-id 206318 :step/next {:db/id #edb/ref 17592186065152}} {:db/id #edb/ref 17592186065152 :step/content {:db/id #edb/ref 17592186064269 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063930 :question/id #uuid "484ff19c-9a37-553c-a5d5-837a50574703" :question/math-academy-id "e-120"} :knowledge-point/id #uuid "8d13310c-2b80-5945-ada3-31d886f1ec48" :knowledge-point/questions [{:db/id #edb/ref 17592186064573} {:db/id #edb/ref 17592186064636} {:db/id #edb/ref 17592186233625} {:db/id #edb/ref 17592186233642} {:db/id #edb/ref 17592186234400} {:db/id #edb/ref 17592186234402}] :knowledge-point/title "Calculating the Average Rate of Change: Word Problem"} :step/id #uuid "295e95a9-3a8e-541c-bdff-bd462fa18b86" :step/math-academy-id 206321 :step/next {:db/id #edb/ref 17592186065153}} {:db/id #edb/ref 17592186065153 :step/content {:db/id #edb/ref 17592186064270 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063932 :question/id #uuid "50e4be08-7e9b-501b-beae-686aa62e96f3" :question/math-academy-id "e-122"} :knowledge-point/id #uuid "051b5337-7671-599f-a7f3-c3fb064575cc" :knowledge-point/questions [{:db/id #edb/ref 17592186064523} {:db/id #edb/ref 17592186064524} {:db/id #edb/ref 17592186234250} {:db/id #edb/ref 17592186234251}] :knowledge-point/title "Determining the Interval Over Which the Average Rate of Change is Zero"} :step/id #uuid "343ddc12-c579-5e1b-8c2d-a42ac8017653" :step/math-academy-id 206324}] :activity/title "The Average Rate of Change of a Function" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186064427}]}
