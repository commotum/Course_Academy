#{[{:activity/first-step {:db/id #edb/ref 17592186511609} :activity/id #uuid "bedb83e1-4c37-5446-a72c-fd137b4418d6" :activity/steps [{:db/id #edb/ref 17592186511609 :step/content {:assigned-problem/content {:db/id #edb/ref 17592186511453 :multistep/context "A campsite opens on the $1$st of May $(t=0)$ and closes after $8$ months. The number of customers in the campsite after $t$ months is modeled by a differentiable function $q$ for $0\\le t\\le 8.$ Some values for $q(t)$ for different values of $t$ are given in the table below.\n\n| $t$ (months) | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ | $6$ | $7$ | $8$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $q(t)$ (customers) | $0$ | $59$ | $120$ | $92$ | $108$ | $85$ | $47$ | $18$ | $0$ |" :multistep/first-step {:db/id #edb/ref 17592186511590} :multistep/id #uuid "1f7f0079-ead3-5b48-9ed7-038c428c6b95" :multistep/steps [{:db/id #edb/ref 17592186511590 :step/content {:db/id #edb/ref 17592186511500 :question/id #uuid "61246f8d-17fc-5cf4-84dc-d3e84d220ded" :question/math-academy-id "q-166362"} :step/id #uuid "14dc92fe-b926-56a3-9447-0731e156f799" :step/next {:db/id #edb/ref 17592186511626}} {:db/id #edb/ref 17592186511626 :step/content {:db/id #edb/ref 17592186511513 :question/id #uuid "7a6777e5-075d-540c-87f4-265fdb022242" :question/math-academy-id "q-166363"} :step/id #uuid "65e9a74f-d4af-5e85-9717-677667dca31c" :step/next {:db/id #edb/ref 17592186511627}} {:db/id #edb/ref 17592186511627 :step/content {:db/id #edb/ref 17592186511543 :question/id #uuid "ae9e49ed-eef5-5e75-8ccc-b6af327fb845" :question/math-academy-id "q-166364"} :step/id #uuid "6719078a-ae01-5b15-a69d-2c93b4d15fad" :step/next {:db/id #edb/ref 17592186511629}} {:db/id #edb/ref 17592186511629 :step/content {:db/id #edb/ref 17592186511505 :question/id #uuid "6b1c7ad5-e07c-5b25-9e08-a2e2aa0ac237" :question/math-academy-id "q-166365"} :step/id #uuid "766b9e6a-e65b-53da-b6e9-5f712795eacf" :step/next {:db/id #edb/ref 17592186511659}} {:db/id #edb/ref