45494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186311536}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14e95436-1992-5d26-a51a-862b1ae1c205" :question/math-academy-id "q-337533" :question/problem "Consider the first-order linear ODE\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-6y={e}^{6x}.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\,$ According to VOP, we assume a particular solution of the form {{field-1}}.\n\n$\\,$ Solving for $u,$ we have $u(x)=$ {{field-2}}.\n\n$\\,$ Therefore, the particular solution is ${y}_{p}(x)=$ {{field-3}}." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-6{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{6x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable ${y}_{p},$ we set $A=u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\n{y}_{p}(x)=u(x){e}^{6x}\n$$\n\nIntuitively, this form of ${y}_{p}$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate ${u}^{′}:$\n\n$$\n\\begin{aligned}{(u{e}^{6x})}^{′}-6(u{e}^{6x}) & ={e}^{6x} \\\\ {u}^{′}{e}^{6x}+6u{e}^{6x}-6u{e}^{6x} & ={e}^{6x} \\\\ {u}^{′}{e}^{6x}+\\cancel{6u{e}^{6x}}-\\cancel{6u{e}^{6x}} & ={e}^{6x} \\\\ {u}^{′}{e}^{6x} & ={e}^{6x} \\\\ {u}^{′} & =1\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & =1 \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int \\,\\text{d}x \\\\ u & =x.\\end{aligned}\n$$\n\nFinally, since ${y}_{p}=u(x){e}^{6x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{6x} \\\\  & =x{e}^{6x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186478438 :knowledge-point/_questions [{:db/id #edb/ref 17592186157456 :knowledge-point/id #uuid "7ac34a18-053d-5eab-8c2c-bd0f15658186" :knowledge-point/title "Solving First-Order Linear ODEs Using Variation of Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a3262b4-4909-5d73-8fa3-b8da60affffb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int {e}^{-3x}\\operatorname{cosh}⁡4x\\,\\text{d}x" :db/id #edb/ref 17592186477754} {:answer/id #uuid "1ece36c5-c392-5723-af8e-a05005cfadd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int {e}^{-3x}\\operatorname{sinh}⁡4x\\,\\text{d}x" :db/id #edb/ref 17592186477792} {:answer/id #uuid "22eb1d31-f42f-536a-b5d5-1ff46ae590a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int {e}^{3x}\\operatorname{cosh}⁡4x\\,\\text{d}x" :db/id #edb/ref 17592186477804} {:answer/id #uuid "411575a2-6525-525b-bf3f-ec23aa83bae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int {e}^{3x}\\operatorname{sinh}⁡4x\\,\\text{d}x" :db/id #edb/ref 17592186477857}] :answer-field/correct {:answer/id #uuid "22eb1d31-f42f-536a-b5d5-1ff46ae590a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int {e}^{3x}\\operatorname{cosh}⁡4x\\,\\text{d}x" :db/id #edb/ref 17592186477804} :answer-field/id #uuid "2a6bac64-288b-5a09-94e1-1e2919a409c0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186478263} {:answer-field/choices [{:answer/id #uuid "2f3b432c-151d-594b-8d7d-9b13407c0ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3x}\\int {e}^{3x}\\operatorname{sinh}⁡4x\\,\\text{d}x" :db/id #edb/ref 17592186477820} {:answer/id #uuid "467c1681-9340-54aa-8b27-5b6369967fa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3x}\\int {e}^{3x}\\operatorname{cosh}⁡4x\\,\\text{d}x" :db/id #edb/ref 17592186477871} {:answer/id #uuid "a2499933-2a21-519a-8589-5a43bbc78158" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3x}\\int {e}^{-3x}\\operatorname{sinh}⁡4x\\,\\text{d}x" :db/id #edb/ref 17592186478047} {:answer/id #uuid "ed9764fd-0d06-5316-8d9c-58776684d236" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3x}\\int {e}^{-3x}\\operatorname{cosh}⁡4x\\,\\text{d}x" :db/id #edb/ref 17592186478209}] :answer-field/correct {:answer/id #uuid "467c1681-9340-54aa-8b27-5b6369967fa9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-3x}\\int {e}^{3x}\\operatorname{cosh}⁡4x\\,\\text{d}x" :db/id #edb/ref 17592186477871} :answer-field/id #uuid "492a5826-a67f-5d66-81f7-1edeae44416a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186478277} {:answer-field/choices [{:answer/id #uuid "2b45b1b5-78af-599f-a835-1a8ecc98bf24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-4x}" :db/id #edb/ref 17592186477816} {:answer/id #uuid "786b8085-11f0-5a07-a254-2ccd551653d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{3x}" :db/id #edb/ref 17592186477985} {:answer/id #uuid "eb773ad9-053a-5b9a-804c-75516ccb8f67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-3x}" :db/id #edb/ref 17592186478204} {:answer/id #uuid "ed6515d1-3e26-5063-b434-46412a526821" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{4x}" :db/id #edb/ref 17592186478208} {:answer/id #uuid "fc73efc5-df55-5dfa-8e43-ca8958f0d830" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-7x}" :db/id #edb/ref 17592186478239}] :answer-field/correct {:answer/id #uuid "eb773ad9-053a-5b9a-804c-75516ccb8f67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u(x){e}^{-3x}" :db/id #edb/ref 17592186478204} :answer-field/id #uuid "f5c7f2fc-5df9-53b7-b7f3-4012e939ef10" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186478363}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b7565b02-4af8-5778-b268-0a737a2704ef" :question/math-academy-id "q-352902" :question/problem "Consider the first-order linear ODE\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+3y=\\operatorname{cosh}⁡4x.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\,$ According to VOP, we assume a particular solution of the form {{field-1}}.\n\n$\\,$ Solving for $u,$ we have $u(x)=$ {{field-2}}.\n\n$\\,$ Therefore, the particular solution is ${y}_{p}(x)=$ {{field-3}}." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}+3{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{-3x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable ${y}_{p},$ we set $A=u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\n{y}_{p}(x)=u(x){e}^{-3x}\n$$\n\nIntuitively, this form of ${y}_{p}$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate ${u}^{′}:$\n\n$$\n\\begin{aligned}{(u{e}^{-3x})}^{′}+3(u{e}^{-3x}) & =\\operatorname{cosh}⁡4x \\\\ {u}^{′}{e}^{-3x}-3u{e}^{-3x}+3u{e}^{-3x} & =\\operatorname{cosh}⁡4x \\\\ {u}^{′}{e}^{-3x}-\\cancel{3u{e}^{-3x}}+\\cancel{3u{e}^{-3x}} & =\\operatorname{cosh}⁡4x \\\\ {u}^{′}{e}^{-3x} & =\\operatorname{cosh}⁡4x \\\\ {u}^{′} & ={e}^{3x}\\operatorname{cosh}⁡4x\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & ={e}^{3x}\\operatorname{cosh}⁡4x \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int {e}^{3x}\\operatorname{cosh}⁡4x\\,\\text{d}x \\\\ u & =\\int {e}^{3x}\\operatorname{cosh}⁡4x\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, since ${y}_{p}=u(x){e}^{-3x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{-3x} \\\\  & =\\int {e}^{3x}\\operatorname{cosh}⁡4x\\,\\text{d}x\\cdot {e}^{-3x} \\\\  & ={e}^{-3x}\\int {e}^{3x}\\operatorname{cosh}⁡4x\\,\\text{d}x.\\end{aligned}\n$$"}]}
