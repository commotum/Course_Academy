ution but with a varying amplitude."}] [{:db/id #edb/ref 17592186478407 :knowledge-point/_questions [{:db/id #edb/ref 17592186157455 :knowledge-point/id #uuid "f1059ab6-d512-537f-be1e-28aa492a6ef0" :knowledge-point/title "Finding a Suitable Variation of Parameters Ansatz"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02aa2931-7319-5eae-9d08-6773a3ce5feb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=u(x){e}^{3x}" :db/id #edb/ref 17592186477741} {:answer/id #uuid "2766ea17-aeed-504c-a94b-bf82fe983ccf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=u(x){e}^{-5x}" :db/id #edb/ref 17592186477812} {:answer/id #uuid "6a6d299c-6f4f-5c00-ad91-3c97e7012470" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=u(x){e}^{5x}" :db/id #edb/ref 17592186477952} {:answer/id #uuid "7db9b1cc-8c00-5908-9a9e-8f7f4b027041" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=u(x){e}^{-3x}" :db/id #edb/ref 17592186477992} {:answer/id #uuid "84c0b521-9ff1-595e-bda5-2e7954af39ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=u(x){e}^{-8x}" :db/id #edb/ref 17592186478008}] :answer-field/correct {:answer/id #uuid "2766ea17-aeed-504c-a94b-bf82fe983ccf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{p}(x)=u(x){e}^{-5x}" :db/id #edb/ref 17592186477812} :answer-field/id #uuid "489e0198-dac9-5cfe-81b0-6c9678cf7acf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186478276}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "605f7436-db66-5e71-900c-b1554cd28ac4" :question/math-academy-id "q-337239" :question/problem "Consider the fi