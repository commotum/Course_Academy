#edb/ref 17592186257663} {:answer/id #uuid "c6df00e4-14bf-5e23-a939-f984f68a0ff9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186258519} {:answer/id #uuid "e3cc3553-89e2-5ace-abc4-1172afe072cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186258761} {:answer/id #uuid "e497e2c8-05df-595e-a19c-1ff2ed39c04b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186258767}] :answer-field/correct {:answer/id #uuid "2384c997-1d5d-53b4-a312-5c2ec9c86073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257079} :answer-field/id #uuid "a4304b44-cbb1-57e3-b024-663ea2e2eb70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259322}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "46935a1e-c060-58a7-ab7d-a527906c3000" :question/math-academy-id "q-124148" :question/problem "![](images/24/2400f92070b4f7d4e0ad0309574b729da86754bc64b6d7a3c508433d1bbc7f76.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}y,$ where $C$ is the path along the line segment between the points $(4,0)$ to the point $(0,3),$ as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, ${y}_{2}=3$ and ${y}_{1}=0.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1}=3-0=3.\n$$"}] [{:db/id #edb/ref 17592186180002 :knowledge-point/_questions [{:db/id #edb/ref 17592186179733 :knowledge-point/id #uuid "2fd19952-77af-5f27-a7ef-adf46b1958ae" :knowledge-point/title "Orientation-Dependence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d06d74e-8cbb-534e-9e3d-b565ad2be03c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186257326} {:answer/id #uuid "3e4cf246-885b-5339-ba6d-2a6a26c29fd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Impossible to determine" :db/id #edb/ref 17592186257341} {:answer/id #uuid "9c24bf18-5b81-5f28-9b53-d40d50783a35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258154} {:answer/id #uuid "a96067c9-1bd3-5cae-ad8c-0d00c40ff765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186258259} {:answer/id #uuid "c8e8aab0-bd61-54e0-9a37-1cee850b0d7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186258533}] :answer-field/correct {:answer/id #uuid "a96067c9-1bd3-5cae-ad8c-0d00c40ff765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186258259} :answer-field/id #uuid "564a707d-5cc2-58d4-811e-f0cb1791bf4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259179}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4dcfed6a-aece-5954-8f2d-d015ef026f97" :question/math-academy-id "q-124149" :question/problem "If ${\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x=4$ and ${\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}x=6,$ calculate ${\\int }_{C}f(x,y)\\,\\text{d}x$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $x,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}x=-{\\int }_{C}f(x,y)\\,\\text{d}x$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}x={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}x \\\\  & =4-6 \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186180003 :knowledge-point/_questions [{:db/id #edb/ref 17592186179733 :knowledge-point/id #uuid "2fd19952-77af-5f27-a7ef-adf46b1958ae" :knowledge-point/title "Orientation-Dependence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba7f3b3f-8c00-5efb-ba91-e911846678e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186177688} {:answer/id #uuid "ec493392-1dba-5ad7-9cc2-b87582cf571d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186177689} {:answer/id #uuid "3b1f8f4f-61b9-5cc5-ab67-414245fe1602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186177690} {:answer/id #uuid "65826242-136d-5f75-9d5a-57bf5082fa0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186177691} {:answer/id #uuid "7d78ab03-5b69-5fae-8c19-c964cd74fda0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186177692}] :answer-field/id #uuid "e2412bc6-f3f9-51ac-92fa-0591c2c3903e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177687}] :question/id #uuid "e3ca1583-0f44-5bd8-a174-1f7bba09e7fc" :question/math-academy-id "q-124150" :question/problem "If $\\displaystyle \\int_{C}f(x, y)dy = 12$ and $\\displaystyle \\int_{-C_{1}}f(x, y)dy = 8$, calculate $\\displaystyle \\int_{-C_{2}}f(x, y)dy$ given that $C = C_{1}∪C_{2}$."}] [{:db/id #edb/ref 17592186259614 :knowledge-point/_questions [{:db/id #edb/ref 17592186179733 :knowledge-point/id #uuid "2fd19952-77af-5f27-a7ef-adf46b1958ae" :knowledge-point/title "Orientation-Dependence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28d5e447-8418-5713-9439-d989ec5b6429" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186257147} {:answer/id #uuid "361a934d-451b-5e92-92f4-46a6a1e2211a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-27" :db/id #edb/ref 17592186257259} {:answer/id #uuid "dc5e7fd0-81d0-5309-8978-db5e8c201730" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258701} {:answer/id #uuid "e9498204-facb-59b8-b6f0-bc76230762a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186258805} {:answer/id #uuid "f3c4005f-481d-5307-83cd-ce0861f8586f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186258909}] :answer-field/correct {:answer/id #uuid "e9498204-facb-59b8-b6f0-bc76230762a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186258805} :answer-field/id #uuid "e5a217e9-fa91-5a9c-b987-36a79f55e03e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259433}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7673d1a0-afd2-5d22-93cd-75c43bd54a25" :question/math-academy-id "q-124186" :question/problem "If ${\\int }_{-C}f(x,y)\\,\\text{d}x=16$ and ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x=11,$ calculate ${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $x,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}x=-{\\int }_{C}f(x,y)\\,\\text{d}x$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}x={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x$\n\nIn our case, we have:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x \\\\ -{\\int }_{-C}f(x,y)\\,\\text{d}x & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x \\\\ -16 & =-11+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x \\\\ -5 & ={\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x=-5.\n$$"}] [{:db/id #edb/ref 17592186259675 :knowledge-point/_questions [{:db/id #edb/ref 17592186179732 :knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f" :knowledge-point/title "Line Integrals of Unity With Respect to Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2edaaf2f-2729-5e65-a17a-4523df70dc44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi +3" :db/id #edb/ref 17592186257196} {:answer/id #uuid "30317006-4123-578e-9743-270d0931c8a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\pi +5" :db/id #edb/ref 17592186257208} {:answer/id #uuid "3ad210eb-4b42-5adc-9741-42f5d0ecc308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186257302} {:answer/id #uuid "3e00a328-7f68-5d4d-a8a7-112fa74ac353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186257337} {:answer/id #uuid "910124d3-addc-5134-bc4e-2a9c75123e6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186258063}] :answer-field/correct {:answer/id #uuid "3e00a328-7f68-5d4d-a8a7-112fa74ac353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186257337} :answer-field/id #uuid "632a34c9-7ac2-5925-8606-5ed2acf6e125" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259203}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "62aa34a7-e962-5ffb-a115-12676e1e5f66" :question/math-academy-id "q-124342" :question/problem "![](images/9d/9df3b88fb441956592ef8c45214c4728bb321f6fd6b627eb67ce3ce963438915.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}y,$ where $C={C}_{1}\\cup {C}_{2}$ is the path comprising of a vertical line segment of length $5$ and a semicircle of radius $4,$ as  shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, ${y}_{1}=4$ and  ${y}_{2}=-1.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1}=(-1)-4=-5.\n$$"}] [{:db/id #edb/ref 17592186259679 :knowledge-point/_questions [{:db/id #edb/ref 17592186179732 :knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f" :knowledge-point/title "Line Integrals of Unity With Respect to Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06ca0885-40bb-54cb-993c-16ff6bf31c41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186256840} {:answer/id #uuid "12fa8929-0c5a-5ace-90d7-c5115bf0058b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186256953} {:answer/id #uuid "183c8bbd-3c11-5936-9ffc-c6982100aaf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186256992} {:answer/id #uuid "500abeff-f88a-5e7f-b4d5-355a04de8c57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186257467} {:answer/id #uuid "efca4aee-a601-54e9-a99b-317ab7d1d962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258865}] :answer-field/correct {:answer/id #uuid "183c8bbd-3c11-5936-9ffc-c6982100aaf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186256992} :answer-field/id #uuid "1ac8b6b8-ab1c-5e1c-a116-351ff4b5cdb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259077}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "239dd34c-3202-5609-97c3-2d198c5bc0b2" :question/math-academy-id "q-124348" :question/problem "![](images/9b/9b3065e58decfca5355252b93ec3283cc5ffc96dc04826aeab1131e95d3a2e64.png)\n\nCalculate ${∮}_{C}\\,\\text{d}y,$ where $C$ is the closed path along the rectangle, traversed once in the counterclockwise direction, as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{∮}_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, the initial and terminal points are the same (since the path is closed and is traversed only once). Therefore, ${y}_{1}={y}_{2},$ and we have\n\n$$\n{∮}_{C}\\,\\text{d}y=0.\n$$"}] [{:db/id #edb/ref 17592186259680 :knowledge-point/_questions [{:db/id #edb/ref 17592186179732 :knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f" :knowledge-point/title "Line Integrals of Unity With Respect to Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1158d026-709a-5659-b93a-fc893dd400af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186256940} {:answer/id #uuid "66f2a44e-1a4e-533c-a949-20a791d8a9db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257693} {:answer/id #uuid "9b7e9c21-404c-5ea0-9e7f-5577a4f7ed1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3+\\sqrt{5}" :db/id #edb/ref 17592186258149} {:answer/id #uuid "a2f700a2-042f-52d1-89e7-50faf272ccdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258207} {:answer/id #uuid "ab1542bb-657e-5259-b224-f4b76e1d04c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186258274}] :answer-field/correct {:answer/id #uuid "ab1542bb-657e-5259-b224-f4b76e1d04c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186258274} :answer-field/id #uuid "9a1a50c1-b1c0-541a-8298-c9ff23e9c190" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259304}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "76093563-4073-5ddf-89ae-28178104bcaa" :question/math-academy-id "q-124349" :question/problem "![](images/0d/0da125535534cbd50b96cb280cf8b8a4b58653a344c8699d7b732ec73cc3b2ce.png)\n\nCalculate ${∮}_{C}\\,\\text{d}y,$ where $C$ is the closed path along a right triangle, traversed once in the counterclockwise direction, as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{∮}_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, the initial and terminal points are the same (since the path is closed and is traversed only once). Therefore, ${y}_{1}={y}_{2},$ and we have\n\n$$\n{∮}_{C}\\,\\text{d}y=0.\n$$"}]}
