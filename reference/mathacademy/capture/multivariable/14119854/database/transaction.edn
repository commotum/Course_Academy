1}$ is the $x$-coordinate of the initial point.\n\nIn our case, ${x}_{2}=-4$ and ${x}_{1}=-1.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}x={x}_{2}-{x}_{1}=(-4)-(-1)=-3.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0a420733-9597-59c7-a430-a56589724b06"] :db/ensure [:question/validate]} {:db/id "answer-field-0a420733-9597-59c7-a430-a56589724b06" :answer-field/id #uuid "0a420733-9597-59c7-a430-a56589724b06" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-29b4934d-6ad2-57c3-89d5-064138568fd9" :answer-field/choices ["answer-29b4934d-6ad2-57c3-89d5-064138568fd9" "answer-d43c3421-a359-5d67-9fb2-039db4f6dbbc" "answer-3dec085f-d086-5935-8b12-c7f060d85182" "answer-05561efb-810b-5987-b7e5-1cc8fd5d9c6a" "answer-8d3c001b-a296-5526-af04-84e4bd0dfc8a"] :db/ensure [:answer-field/validate]} {:db/id "answer-29b4934d-6ad2-57c3-89d5-064138568fd9" :answer/id #uuid "29b4934d-6ad2-57c3-89d5-064138568fd9" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-d43c3421-a359-5d67-9fb2-039db4f6dbbc" :answer/id #uuid "d43c3421-a359-5d67-9fb2-039db4f6dbbc" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-3dec085f-d086-5935-8b12-c7f060d85182" :answer/id #uuid "3dec085f-d086-5935-8b12-c7f060d85182" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-05561efb-810b-5987-b7e5-1cc8fd5d9c6a" :answer/id #uuid "05561efb-810b-5987-b7e5-1cc8fd5d9c6a" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-8d3c001b-a296-5526-af04-84e4bd0dfc8a" :answer/id #uuid "8d3c001b-a296-5526-af04-84e4bd0dfc8a" :answer/type :answer.type/math :answer/value "\\frac{9\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "question-a19a3e84-b3b7-545b-90bc-54d947e5986c" :question/id #uuid "a19a3e84-b3b7-545b-90bc-54d947e5986c" :question/math-academy-id "