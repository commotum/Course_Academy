-8f59-530d-9f0d-9e00044a377f" :answer-field/id #uuid "3c4667bc-8f59-530d-9f0d-9e00044a377f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2e06e035-45fa-5e53-bfbc-65514f433cd9" :answer-field/choices ["answer-105bce54-4026-504a-aebc-d3aeaf976b6a" "answer-dafff622-d36c-559c-aa25-3ffc0e5c93a2" "answer-2e06e035-45fa-5e53-bfbc-65514f433cd9" "answer-e3917919-8158-59b4-b944-e19f2eb5c017" "answer-c08436b7-7d2d-5354-b7f9-73e0c58fe847"] :db/ensure [:answer-field/validate]} {:db/id "answer-105bce54-4026-504a-aebc-d3aeaf976b6a" :answer/id #uuid "105bce54-4026-504a-aebc-d3aeaf976b6a" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-dafff622-d36c-559c-aa25-3ffc0e5c93a2" :answer/id #uuid "dafff622-d36c-559c-aa25-3ffc0e5c93a2" :answer/type :answer.type/math :answer/value "-\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-2e06e035-45fa-5e53-bfbc-65514f433cd9" :answer/id #uuid "2e06e035-45fa-5e53-bfbc-65514f433cd9" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-e3917919-8158-59b4-b944-e19f2eb5c017" :answer/id #uuid "e3917919-8158-59b4-b944-e19f2eb5c017" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-c08436b7-7d2d-5354-b7f9-73e0c58fe847" :answer/id #uuid "c08436b7-7d2d-5354-b7f9-73e0c58fe847" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id 17592186179996 :question/problem "![](images/ec/ec03c28e17138917d31898f165925cb246cf1f81a03f15672f87dde586b06ed2.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}y,$ where $C={C}_{1}\\cup {C}_{2}$ is the path comprising of a horizontal line segment of length $2$ and a semicircle of radius $2,$ shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, ${y}_{1}={y}_{2}=1.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1}=1-1=0.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-11d73d0a-9b92-5725-b122-3966ab941aac"] :db/ensure [:question/validate]} {:db/id "answer-field-11d73d0a-9b92-5725-b122-3966ab941aac" :answer-field/id #uuid "11d73d0a-9b92-5725-b122-3966ab941aac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-627a50c9-9a65-5ce4-b1c6-1df26867b7d8" :answer-field/choices ["answer-2cfb5012-01ba-5773-8380-07b0c227978b" "answer-627a50c9-9a65-5ce4-b1c6-1df26867b7d8" "answer-a8ef58cc-01f9-5539-9409-f4b9eb5a98f4" "answer-5350f40c-1597-5be9-bd8f-3c625b18eb6e" "answer-2ba37e23-4407-593f-878c-8abbf9aaeab1"] :db/ensure [:answer-field/validate]} {:db/id "answer-2cfb5012-01ba-5773-8380-07b0c227978b" :answer/id #uuid "2cfb5012-01ba-5773-8380-07b0c227978b" :answer/type :answer.type/math :answer/value "-\\pi " :db/ensure [:answer/validate]} {:db/id "answer-627a50c9-9a65-5ce4-b1c6-1df26867b7d8" :answer/id #uuid "627a50c9-9a65-5ce4-b1c6-1df26867b7d8" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-a8ef58cc-01f9-5539-9409-f4b9eb5a98f4" :answer/id #uuid "a8ef58cc-01f9-5539-9409-f4b9eb5a98f4" :answer/type :answer.type/math :answer/value "2\\pi +2" :db/ensure [:answer/validate]} {:db/id "answer-5350f40c-1597-5be9-bd8f-3c625b18eb6e" :answer/id #uuid "5350f40c-1597-5be9-bd8f-3c625b18eb6e" :answer/type :answer.type/math :answer/value "2\\pi -2" :db/ensure [:answer/validate]} {:db/id "answer-2ba37e23-4407-593f-878c-8abbf9aaeab1" :answer/id #uuid "2ba37e23-4407-593f-878c-8abbf9aaeab1" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-28b25a72-e404-5d69-993b-a9b2c8d9ba39" :question/id #uuid "28b25a72-e404-5d69-993b-a9b2c8d9ba39" :question/math-academy-id "q-124187" :question/problem "If ${\\int }_{C}f(x,y)\\,\\text{d}y=17,$ ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y=7,$ and ${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y=5,$ calculate ${\\int }_{-{C}_{3}}f(x,y)\\,\\text{d}y$ given that $C={C}_{1}\\cup {C}_{2}\\cup {C}_{3}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}\\cup {C}_{3}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $y,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}y=-{\\int }_{C}f(x,y)\\,\\text{d}y$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{3}}f(x,y)\\,\\text{d}y$\n\nIn our case, we have:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{3}}f(x,y)\\,\\text{d}y \\\\ 17 & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y+5-{\\int }_{-{C}_{3}}f(x,y)\\,\\text{d}y \\\\ 17 & =-7+5-{\\int }_{-{C}_{3}}f(x,y)\\,\\text{d}y \\\\ 19 & =-{\\int }_{-{C}_{3}}f(x,y)\\,\\text{d}y\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{-{C}_{3}}f(x,y)\\,\\text{d}y=-19.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-45a9fe64-c73b-5f9f-af73-48b5821ab772"] :db/ensure [:question/validate]} {:db/id "answer-field-45a9fe64-c73b-5f9f-af73-48b5821ab772" :answer-field/id #uuid "45a9fe64-c73b-5f9f-af73-48b5821ab772" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-01e4d0b1-3d49-5ae5-b65b-8dbe801177f5" :answer-field/choices ["answer-328548aa-6ec4-5ded-abca-468351c78e63" "answer-01e4d0b1-3d49-5ae5-b65b-8dbe801177f5" "answer-53d99d5e-8f7a-5890-a03d-e22ee095b634" "answer-2a14506d-1bc5-538f-8601-a75415c5af4d" "answer-7b192eed-e4b2-5e18-b229-5a2f13c347d3"] :db/ensure [:answer-field/validate]} {:db/id "answer-328548aa-6ec4-5ded-abca-468351c78e63" :answer/id #uuid "328548aa-6ec4-5ded-abca-468351c78e63" :answer/type :answer.type/math :answer/value "-15" :db/ensure [:answer/validate]} {:db/id "answer-01e4d0b1-3d49-5ae5-b65b-8dbe801177f5" :answer/id #uuid "01e4d0b1-3d49-5ae5-b65b-8dbe801177f5" :answer/type :answer.type/math :answer/value "-19" :db/ensure [:answer/validate]} {:db/id "answer-53d99d5e-8f7a-5890-a03d-e22ee095b634" :answer/id #uuid "53d99d5e-8f7a-5890-a03d-e22ee095b634" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-2a14506d-1bc5-538f-8601-a75415c5af4d" :answer/id #uuid "2a14506d-1bc5-538f-8601-a75415c5af4d" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "answer-7b192eed-e4b2-5e18-b229-5a2f13c347d3" :answer/id #uuid "7b192eed-e4b2-5e18-b229-5a2f13c347d3" :answer/type :answer.type/math :answer/value "29" :db/ensure [:answer/validate]} {:db/id 17592186180003 :question/problem "If ${\\int }_{C}f(x,y)\\,\\text{d}y=12$ and ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y=8,$ calculate ${\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $y,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}y=-{\\int }_{C}f(x,y)\\,\\text{d}y$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y$\n\nIn our case, we have:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y \\\\ 12 & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y \\\\ 12 & =-8-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y \\\\ 20 & =-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y=-20.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0ae3b474-71b1-5e53-80d8-8ff83014500b"] :db/ensure [:question/validate]} {:db/id "answer-field-0ae3b474-71b1-5e53-80d8-8ff83014500b" :answer-field/id #uuid "0ae3b474-71b1-5e53-80d8-8ff83014500b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ba35a350-5197-53ed-ab93-7811ac616cc9" :answer-field/choices ["answer-ba35a350-5197-53ed-ab93-7811ac616cc9" "answer-f61c2696-a894-5f2d-b3e9-6c094b9ebfe1" "answer-2f5989ee-33da-5aee-80b5-59f4458347c3" "answer-608438d6-dac5-5e73-81f2-28ee2e83a8a5" "answer-65d7c98e-321b-597f-b317-1c771751881a"] :db/ensure [:answer-field/validate]} {:db/id "answer-ba35a350-5197-53ed-ab93-7811ac616cc9" :answer/id #uuid "ba35a350-5197-53ed-ab93-7811ac616cc9" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "answer-f61c2696-a894-5f2d-b3e9-6c094b9ebfe1" :answer/id #uuid "f61c2696-a894-5f2d-b3e9-6c094b9ebfe1" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-2f5989ee-33da-5aee-80b5-59f4458347c3" :answer/id #uuid "2f5989ee-33da-5aee-80b5-59f4458347c3" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-608438d6-dac5-5e73-81f2-28ee2e83a8a5" :answer/id #uuid "608438d6-dac5-5e73-81f2-28ee2e83a8a5" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-65d7c98e-321b-597f-b317-1c771751881a" :answer/id #uuid "65d7c98e-321b-597f-b317-1c771751881a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-41a5f2bb-63fd-5596-b20f-47e35c05d2ec" :question/id #uuid "41a5f2bb-63fd-5596-b20f-47e35c05d2ec" :question/math-academy-id "q-124183" :question/problem "If ${\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y=14$ and ${\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y=-6,$ calculate ${\\int }_{C}f(x,y)\\,\\text{d}y$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $y,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}y=-{\\int }_{C}f(x,y)\\,\\text{d}y$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y \\\\  & =14-(-6) \\\\  & =20.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9bc8f0e0-f5cb-5cee-aa30-efe616caf6e2"] :db/ensure [:question/validate]} {:db/id "answer-field-9bc8f0e0-f5cb-5cee-aa30-efe616caf6e2" :answer-field/id #uuid "9bc8f0e0-f5cb-5cee-aa30-efe616caf6e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7e5524bb-b193-5580-b930-13a4c434d2d2" :answer-field/choices ["answer-75d3c873-74de-59e1-9205-f943f90ed6f3" "answer-d44d1f9d-b5f4-53e0-ba1f-2259d7fb76a2" "answer-7e5524bb-b193-5580-b930-13a4c434d2d2" "answer-87d96269-00c7-5980-b0c5-a6b5955bd666" "answer-b8ba360f-ed62-5d53-a965-3d462320b72e"] :db/ensure [:answer-field/validate]} {:db/id "answer-75d3c873-74de-59e1-9205-f943f90ed6f3" :answer/id #uuid "75d3c873-74de-59e1-9205-f943f90ed6f3" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "answer-d44d1f9d-b5f4-53e0-ba1f-2259d7fb76a2" :answer/id #uuid "d44d1f9d-b5f4-53e0-ba1f-2259d7fb76a2" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-7e5524bb-b193-5580-b930-13a4c434d2d2" :answer/id #uuid "7e5524bb-b193-5580-b930-13a4c434d2d2" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-87d96269-00c7-5980-b0c5-a6b5955bd666" :answer/id #uuid "87d96269-00c7-5980-b0c5-a6b5955bd666" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-b8ba360f-ed62-5d53-a965-3d462320b72e" :answer/id #uuid "b8ba360f-ed62-5d53-a965-3d462320b72e" :answer/type :answer.type/text :answer/value "Impossible to determine" :db/ensure [:answer/validate]} {:db/id 17592186180715 :tutorial/content "Earlier, we showed that\n\n$$\n\\int_{C}\\,\\textrm d x = 2,\n$$\n\nwhere $C$ is the path along the quarter-circle shown below.\n\n![](images/01/01b5f21b2c778f62f7dd884065ee4ce17dd01bd021063fc7c788f09a89feea86.png)\n\nIf we reverse the orientation of the curve, we get the following path:\n\n![](images/46/469675e85a6ca1d23de6da985d36e8e86c859ceff38ea6849984ea3c2cd34abe.png)\n\nThe initial and terminal points have swapped, and so we now have $x_1 = 2$ and $x_2 = 0.$ Applying our formula, we have\n\n$$\n\\begin{aligned}{\\int }_{-C}\\,\\text{d}x & ={x}_{2}-{x}_{1} \\\\  & =0-2 \\\\  & =-2.\\end{aligned}\n$$\n\nThis example illustrates an important property of line integrals with respect to $x,$ described in full as follows:\n\n*Let $C$ be a piecewise-smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. Then,*\n\n$$\n\\displaystyle\\int_{-C} f(x,y)\\,\\textrm d x = -\\int_{C} f(x,y)\\,\\textrm d x.\n$$\n\n*Similarly, *\n\n$$\n\\displaystyle\\int_{-C} f(x,y)\\,\\textrm d y = -\\int_{C} f(x,y)\\,\\textrm d y.\n$$\n\nIn other words, line integrals with respect to $x$ and $y$ are *dependent on orientation*. This is quite different from the case for line integrals with respect to arc length, which are independent of orientation." :db/ensure [:tutorial/validate]} {:db/id 17592186180717 :tutorial/content "![](images/c2/c2ab6be66d91822186ee94c846f8cd1a247da776b89d7d9220b836193b9b04d3.png)\n\nConsider the path $C$ above. Earlier, we showed that\n\n$$\n\\int_{C}\\,\\textrm d x = 2,\n$$\n\nWe note the following:\n\n- In the context of our usual interpretation of line integrals with respect to $x,$ this result represents the total area accumulated when the function $z=1$ is projected onto the plane $y=0$ as $C$ is traversed from the initial point $(0,2)$ to the terminal point $(2,0).$ \n\n![](images/29/297e4e302b0cec7f4448ec7e8b36ab6c1f84d79d5f71aad1c6887d86d54dc328.png)\n\nFrom the diagram, we see that this projection generates a rectangle of length $x_2 - x_1 = 2$ and height $z=1.$ Since the integral of unity with respect to $x$ along $C$ is equal to the area of this rectangle, we have\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}x & =1\\cdot ({x}_{2}-{x}_{1}) \\\\  & ={x}_{2}-{x}_{1} \\\\  & =2.\\end{aligned}\n$$\n\nFurthermore, this result is *positive* because the rectangle is traced out in the direction of *increasing* $x.$\n\n- If we reverse the direction of the curve then we get a *negative* result. This is because the rectangle is traced out in the direction of *decreasing* $x,$ as shown below.\n\n![](images/17/179713734445f85818ef4e46cfa5948115cea936538acd3095cbfa706d381972.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186179861 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
