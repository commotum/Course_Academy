db/id "answer-d0b76d48-4379-5b0c-bd2d-223ce4c993fc" :answer/id #uuid "d0b76d48-4379-5b0c-bd2d-223ce4c993fc" :answer/type :answer.type/text :answer/value "odd" :db/ensure [:answer/validate]} {:db/id "answer-field-5c580a2d-1eaf-59df-bd57-50b95a0b8b16" :answer-field/id #uuid "5c580a2d-1eaf-59df-bd57-50b95a0b8b16" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-18a2af04-639a-5b68-ad5f-7ec45b756d4e" :answer-field/choices ["answer-4a5af095-ada0-5451-a8f3-6f8752872548" "answer-3e35abe4-6fe9-5561-8514-cc42a373df5a" "answer-18a2af04-639a-5b68-ad5f-7ec45b756d4e"] :db/ensure [:answer-field/validate]} {:db/id "answer-4a5af095-ada0-5451-a8f3-6f8752872548" :answer/id #uuid "4a5af095-ada0-5451-a8f3-6f8752872548" :answer/type :answer.type/text :answer/value "periodic" :db/ensure [:answer/validate]} {:db/id "answer-3e35abe4-6fe9-5561-8514-cc42a373df5a" :answer/id #uuid "3e35abe4-6fe9-5561-8514-cc42a373df5a" :answer/type :answer.type/text :answer/value "piecewise linear" :db/ensure [:answer/validate]} {:db/id "answer-18a2af04-639a-5b68-ad5f-7ec45b756d4e" :answer/id #uuid "18a2af04-639a-5b68-ad5f-7ec45b756d4e" :answer/type :answer.type/text :answer/value "piecewise smooth" :db/ensure [:answer/validate]} {:db/id "answer-field-04f21919-6b70-5a22-9660-a18b41b9f85b" :answer-field/id #uuid "04f21919-6b70-5a22-9660-a18b41b9f85b" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "answer-2560f1d4-c701-5a15-a0c6-099ceec0a029" :answer-field/choices ["answer-3b02146b-039b-58d6-8831-a4df1c64ce25" "answer-2560f1d4-c701-5a15-a0c6-099ceec0a029" "answer-069197c9-45d7-5029-a771-c125abb39812"] :db/ensure [:answer-field/validate]} {:db/id "answer-3b02146b-039b-58d6-8831-a4df1c64ce25" :answer/id #uuid "3b02146b-039b-58d6-8831-a4df1c64ce25" :answer/type :answer.type/math :answer/value "\\frac{32(-1)^{n}}{{n}^{2}{\\pi }^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-2560f1d4-c701-5a15-a0c6-099ceec0a029" :answer/id #uuid "2560f1d4-c701-5a15-a0c6-099ceec0a029" :answer/type :answer.type/math :answer/value "\\frac{8(-1)^{n+1}}{n\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-069197c9-45d7-5029-a771-c125abb39812" :answer/id #uuid "069197c9-45d7-5029-a771-c125abb39812" :answer/type :answer.type/math :answer/value "\\frac{8(-1)^{n}}{n\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-field-42cacff0-1789-5047-806f-1ce56c82fffe" :answer-field/id #uuid "42cacff0-1789-5047-806f-1ce56c82fffe" :answer-field/key "field-5" :answer-field/type :answer-field.type/select :answer-field/correct "answer-ed7936d2-d492-55f5-8f89-72cc366de9fe" :answer-field/choices ["answer-d213c661-82d6-5131-afa0-06ed917e513c" "answer-ed7936d2-d492-55f5-8f89-72cc366de9fe"] :db/ensure [:answer-field/validate]} {:db/id "answer-d213c661-82d6-5131-afa0-06ed917e513c" :answer/id #uuid "d213c661-82d6-5131-afa0-06ed917e513c" :answer/type :answer.type/math :answer/value "cos\\,(\\frac{n\\pi x}{4})" :db/ensure [:answer/validate]} {:db/id "answer-ed7936d2-d492-55f5-8f89-72cc366de9fe" :answer/id #uuid "ed7936d2-d492-55f5-8f89-72cc366de9fe" :answer/type :answer.type/math :answer/value "sin\\,(\\frac{n\\pi x}{4})" :db/ensure [:answer/validate]} {:db/id 17592186317372 :question/problem "Let $f(x)$ be the $6$-periodic extension of the function $F(x)=-7{x}^{2}+4$ defined on $[-3,3).$ Select the correct options in the reasoning below, showing the derivation of the Fourier series of the $6$-periodic extension of $G(x)=-14x$ from the corresponding Fourier series of $f(x).$\n\nThe Fourier series of $f(x)$ is given by\n\n$$\n-7{x}^{2}+4∼-17+{\\sum }_{n=1}^{\\infty }\\frac{252(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}{{field-1}}.\n$$\n\nSince $f$ is \n{{field-2}}\nand\n{{field-3}}\non $R,$ we may differentiate its Fourier series term-by-term to get\n\n$$\n-14x∼{\\sum }_{n=1}^{\\infty }{{field-4}}\\cdot {{field-5}}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186317040 :answer-field/correct 17592186316422 :db/ensure [:answer-field/validate]} {:db/id 17592186316738 :answer-field/correct 17592186315921 :db/ensure [:answer-field/validate]} {:db/id "question-a8bfe2ba-a961-5858-9456-3382dda97cd5" :question/id #uuid "a8bfe2ba-a961-5858-9456-3382dda97cd5" :question/math-academy-id "q-343397" :question/problem "Let $f(x)$ be the $2$-periodic extension of the function $F(x)=-7{x}^{2}$ defined on $[-1,1).$ Select the correct options in the reasoning below, showing the derivation of a series converging to the $2$-periodic extension of \n\n$$\nG(x)=-\\frac{7}{3}{x}^{3}={\\int }_{0}^{x}f(t)\\,\\text{d}t\n$$\n\nfrom the corresponding Fourier series of $f(x).$\n\nThe Fourier series of $f(x)$ is given by\n\n$$\n-7{x}^{2}∼-\\frac{7}{3}+{\\sum }_{n=1}^{\\infty }\\frac{28(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}{{field-1}}.\n$$\n\nSince $f$ is \n{{field-2}} \non $R,$ we may integrate its Fourier series term-by-term to get\n\n$$\n-\\frac{7}{3}{x}^{3}∼-\\frac{7}{3}x+{\\sum }_{n=1}^{\\infty }{{field-3}}\\cdot {{field-4}}.\n$$" :question/worked-solution "First, notice that $F(x)$ is an even function. So, the Fourier series of its $2L$-periodic extension has the form\n\n$$\n\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{L}).\n$$\n\nIn our case, $L=1$ and we are already given the coefficients for $n\\ge 1.$ Thus, the Fourier series of $f(x)$ is given by\n\n$$\nf(x)∼-\\frac{7}{3}+{\\sum }_{n=1}^{\\infty }\\frac{28(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\operatorname{cos}⁡(n\\pi x).\n$$\n\nNow, notice that the function $F$ is continuous on $(-1,1).$ \nTherefore, the $2$-periodic extension $f$ is $\\text{piecewise continuous}$ on $R,$ so we may integrate its Fourier series term-by-term:\n\n$$\n\\begin{aligned}{\\int }_{0}^{x}(-7{t}^{2})\\,\\text{d}t & ∼{\\int }_{0}^{x}(-\\frac{7}{3}+{\\sum }_{n=1}^{\\infty }\\frac{28(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\operatorname{cos}⁡(n\\pi t))\\text{d}t \\\\ {[-\\frac{7}{3}{t}^{3}]}_{0}^{x} & ∼[-\\frac{7}{3}t]_{0}^{x}+{\\sum }_{n=1}^{\\infty }\\frac{28(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\cdot [\\frac{1}{n\\pi }\\operatorname{sin}⁡(n\\pi t)]_{0}^{x} \\\\ -\\frac{7}{3}{x}^{3} & ∼-\\frac{7}{3}x+{\\sum }_{n=1}^{\\infty }\\,\\frac{28(-1)^{n+1}}{{n}^{3}{\\pi }^{3}}\\cdot \\operatorname{sin}⁡(n\\pi x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-46e78378-a68c-5fbc-81ff-f25f17917dcb" "answer-field-6012ae07-2130-5ce1-9441-f9d072891406" "answer-field-76d3ab45-43dd-5f98-abc0-1fde975cee55" "answer-field-04ad8b60-8a46-572e-9c0d-e6fe2e8f69a7"] :db/ensure [:question/validate]} {:db/id "answer-field-46e78378-a68c-5fbc-81ff-f25f17917dcb" :answer-field/id #uuid "46e78378-a68c-5fbc-81ff-f25f17917dcb" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-31e037d0-6ce2-5da7-a3c6-2e20090807e6" :answer-field/choices ["answer-4a36f775-e764-5b0b-af61-c33ceb6dc805" "answer-31e037d0-6ce2-5da7-a3c6-2e20090807e6" "answer-e7f99b90-2fe3-5990-adcc-80770eaba5d1" "answer-097c8db1-3ed4-5c62-8384-75b3665d2464"] :db/ensure [:answer-field/validate]} {:db/id "answer-4a36f775-e764-5b0b-af61-c33ceb6dc805" :answer/id #uuid "4a36f775-e764-5b0b-af61-c33ceb6dc805" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\frac{n\\pi x}{2})" :db/ensure [:answer/validate]} {:db/id "answer-31e037d0-6ce2-5da7-a3c6-2e20090807e6" :answer/id #uuid "31e037d0-6ce2-5da7-a3c6-2e20090807e6" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(n\\pi x)" :db/ensure [:answer/validate]} {:db/id "answer-e7f99b90-2fe3-5990-adcc-80770eaba5d1" :answer/id #uuid "e7f99b90-2fe3-5990-adcc-80770eaba5d1" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{2})" :db/ensure [:answer/validate]} {:db/id "answer-097c8db1-3ed4-5c62-8384-75b3665d2464" :answer/id #uuid "097c8db1-3ed4-5c62-8384-75b3665d2464" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(n\\pi x)" :db/ensure [:answer/validate]} {:db/id "answer-field