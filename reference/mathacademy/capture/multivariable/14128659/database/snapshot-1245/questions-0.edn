)^{n}}{{n}^{2}{\\pi }^{2}}" :db/id #edb/ref 17592186315710} {:answer/id #uuid "a6d7ef19-fb4f-5d33-83d6-08a0e589010c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12(-1)^{n}}{n\\pi }" :db/id #edb/ref 17592186316057} {:answer/id #uuid "cf32c093-f419-533a-8c1c-53b8651f43b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12(-1)^{n+1}}{n\\pi }" :db/id #edb/ref 17592186316286}] :answer-field/correct {:answer/id #uuid "0d8a3c58-25e9-5f17-94ad-bc0082326c31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{48(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}" :db/id #edb/ref 17592186315201} :answer-field/id #uuid "8f081ed1-3b16-5b9e-bda2-41b1fdccacc4" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316873} {:answer-field/choices [{:answer/id #uuid "4b381952-9b35-5658-9a1c-bb7343908f89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186315548} {:answer/id #uuid "7e5e8d78-0c39-54db-922c-1b42e53eb152" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "piecewise continuous" :db/id #edb/ref 17592186315814} {:answer/id #uuid "bc0cb57c-2c6c-506c-a631-df11bc6136e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186316181} {:answer/id #uuid "c87d645a-8c67-5b22-89fa-a4a0b393bafa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "periodic" :db/id #edb/ref 17592186316249}] :answer-field/correct {:answer/id #uuid "7e5e8d78-0c39-54db-922c-1b42e53eb152" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "piecewise continuous" :db/id #edb/ref 17592186315814} :answer-field/id #uuid "dfc26870-1dfe-514a-a70b-a4e5da432c5a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186317080}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3b75f000-c288-5650-b319-990a54e2ce6c" :question/math-academy-id "q-343340" :question/problem "Let $f(x)$ be the $8$-periodic extension of the function $F(x)=\\frac{3}{2}x$ defined on $[-4,4).$ Select the correct options in the reasoning below, showing the derivation of a series converging to the $8$-periodic extension of \n\n$$\nG(x)=\\frac{3}{4}{x}^{2}={\\int }_{0}^{x}f(t)\\,\\text{d}t\n$$\n\nfrom the corresponding Fourier series of $f(x).$\n\nThe Fourier series of $f(x)$ is given by\n\n$$\n\\frac{3}{2}x∼{\\sum }_{n=1}^{\\infty }\\frac{12(-1)^{n+1}}{n\\pi }{{field-1}}.\n$$\n\nSince $f$ is \n{{field-2}} \non $R,$ we may integrate its Fourier series term-by-term to get\n\n$$\n\\frac{3}{4}{x}^{2}∼{\\sum }_{n=1}^{\\infty }{{field-3}}\\cdot {{field-4}}.\n$$" :question/worked-solution "First, notice that $F(x)$ is an odd function. So, the Fourier series of its $2L$-periodic extension has the form\n\n$$\n{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{L}).\n$$\n\nIn our case, $L=4$ and we are already given the coefficients ${b}_{n}$ for $n\\ge 1.$ Thus, the Fourier series of $f(x)$ is given by\n\n$$\nf(x)∼{\\sum }_{n=1}^{\\infty }\\frac{12(-1)^{n+1}}{n\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{4}).\n$$\n\nNow, notice that the function $F$ is continuous on $(-4,4).$ \nTherefore, the $8$-periodic extension $f$ is $\\text{piecewise continuous}$ on $R,$ so we may integrate its Fourier series term-by-term:\n\n$$\n\\begin{aligned}{\\int }_{0}^{x}\\frac{3}{2}t\\,\\text{d}t & ∼{\\sum }_{n=1}^{\\infty }{\\int }_{0}^{x}\\frac{12(-1)^{n+1}}{n\\pi }\\operatorname{sin}⁡(\\frac{n\\pi t}{4})\\,\\text{d}t \\\\ {[\\frac{3}{4}{t}^{2}]}_{0}^{x} & ∼{\\sum }_{n=1}^{\\infty }\\frac{12(-1)^{n+1}}{n\\pi }\\cdot [-\\frac{4}{n\\pi }\\operatorname{cos}⁡(\\frac{n\\pi t}{4})]_{0}^{x} \\\\ \\frac{3}{4}{x}^{2} & ∼{\\sum }_{n=1}^{\\infty }\\,\\frac{48(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\cdot (1-\\operatorname{cos}⁡(\\frac{n\\pi x}{4}))\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186222038 :knowledge-point/_questions [{:db/id #edb/ref 17592186221451 :knowledge-point/id #uuid "c1e01d04-6c13-52eb-a4b6-ad9a5cde8134" :knowledge-point/title "Integrating a Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4817ea5-c1f7-547f-9917-fdd4c1930e4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{2})" :db/id #edb/ref 17592186316139} {:answer/id #uuid "e2de7b78-6248-5197-b0d0-d24b15c605ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{n\\pi x}{2})" :db/id #edb/ref 17592186316376} {:answer/id #uuid "e39a3f48-7f97-55da-b06f-2dd831b7858b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\operatorname{sin}⁡(\\frac{n\\pi x}{2}))" :db/id #edb/ref 17592186316378} {:answer/id #uuid "e8932200-fa03-5233-bf3d-aa0ad11900c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\operatorname{cos}⁡(\\frac{n\\pi x}{2}))" :db/id #edb/ref 17592186316409}] :answer-field/correct {:answer/id #uuid "b4817ea5-c1f7-547f-9917-fdd4c1930e4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{2})" :db/id #edb/ref 17592186316139} :answer-field/id #uuid "2f1681a0-d882-5d7f-aacd-ca07d25bedd3" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186316659} {:answer-field/choices [{:answer/id #uuid "8a6d54fd-4612-5d08-bb60-709d157ad8d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ope