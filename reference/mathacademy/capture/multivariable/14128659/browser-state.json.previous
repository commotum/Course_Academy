\"ORD\"><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mrow><msup><mi>n</mi><mn>2</mn></msup><msup><mi>π</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mpadded></mstyle><mo>⋅</mo><mstyle style=\"border: solid 1pt gainsboro\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mn>1</mn><mo>−</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>n</mi><mi>π</mi><mi>x</mi></mrow><mn>3</mn></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mpadded></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
