type/select} :db/id #edb/ref 17592186557179} {:answer-field/choices [{:answer/id #uuid "16ab56e4-e2eb-5bf9-9537-27b52e4fea63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "saddle" :db/id #edb/ref 17592186556478} {:answer/id #uuid "2ef6eec8-69b9-5a4d-bffc-49e9d96f294b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral source" :db/id #edb/ref 17592186556530} {:answer/id #uuid "9fdef16c-4571-5793-a652-d0ba873fbfa7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center" :db/id #edb/ref 17592186556819} {:answer/id #uuid "a67bd7a3-bed8-52ac-9850-f7b4ed8b4ece" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral sink" :db/id #edb/ref 17592186556836}] :answer-field/correct {:answer/id #uuid "16ab56e4-e2eb-5bf9-9537-27b52e4fea63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "saddle" :db/id #edb/ref 17592186556478} :answer-field/id #uuid "f267bf00-331a-5ba4-80d1-f50c27b73d21" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186557201}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "370d8409-9b53-5d37-9911-f67945640175" :question/math-academy-id "q-334651" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}=2x-3xy \\\\ {y}^{′}=-5y+4xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model above, where $x=x(t)$ represents the prey and $y=y(t)$ represents the predators. Select the correct options in the reasoning below.\n\n$\\,$ Evaluating the Jacobian of the system at the equilibrium ${x}^{∗}=[0,\\,0]^{T},$ we get\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$J({x}^{∗})=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"40px\">{{field-1}}</td>\n<td align=\"center\" width=\"40px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,.$</td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>\n\n$\\,$ The eigenvalues of the Jacobian matrix are \n{{field-5}}.\n\n$\\,$ Therefore, the equilibrium at ${x}^{∗}$ is \n{{field-6}}{{field-7}}." :question/worked-solution "Let's denote ${f}_{1}(x,y)=2x-3xy$ and ${f}_{2}(x,y)=-5y+4xy.$\n\nNow, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(2x-3xy)=2-3y,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(2x-3xy)=-3x \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(-5y+4xy)=4y,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(-5y+4xy)=-5+4x\\end{aligned}\n$$\n\nThus, the Jacobian matrix is\n\n$$\nJ=[\\begin{aligned}2-3y & -3x \\\\ 4y & -5+4x\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to get\n\n$$\nJ({x}^{∗})=[\\begin{aligned}2-3(0) & -3(0) \\\\ 4(0) & -5+4(0)\\end{aligned}]=[\\begin{aligned}2 & 0 \\\\ 0 & -5\\end{aligned}].\n$$\n\nThe eigenvalues of the Jacobian matrix are ${\\lambda }_{1}=2\\text{ and }{\\lambda }_{2}=-5.$ Since eigenvalues are real with opposite signs, our equilibrium is $\\text{an unstable}$ $\\text{saddle}.$"}] [{:db/id #edb/ref 17592186557220 :knowledge-point/_questions [{:db/id #edb/ref 17592186166923 :knowledge-point/id #uuid "4f77fc78-6c6b-5dd0-ac2b-7822e4cb961f" :knowledge-point/title "Finding Equilibrium Points of the Lotka-Volterra System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7c23440-5c3b-5c48-baf9-2c8cb1453e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186557044}] :answer-field/correct {:answer/id #uuid "f7c23440-5c3b-5c48-baf9-2c8cb1453e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186557044} :answer-field/id #uuid "0efa0061-db88-505a-8abf-cea16f7858a3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186557072} {:answer-field/choices [{:answer/id #uuid "ae33a651-5fef-5a40-83d2-8951babac325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186556858}] :answer-field/correct {:answer/id #uuid "ae33a651-5fef-5a40-83d2-8951babac325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186556858} :answer-field/id #uuid "7995027e-8581-593c-8043-53ee8d796378" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186557136}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "257d204a-c14e-5aa5-8045-bec1e0148274" :question/math-academy-id "q-334995" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}=-3x+5xy \\\\ {y}^{′}=5y-3xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model above, where $x=x(t)$ represents the predators and $y=y(t)$ represents the prey. Find the nonzero equilibrium of the model.\n\n$(${{field-1}}\n$,$\n{{field-2}}$)$" :question/worked-solution "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of linear equations:\n\n$$\n\\{\\begin{aligned}-3x+5xy=0 \\\\ 5y-3xy=0\\end{aligned}\n$$\n\nSolving the first equation, we get\n\n$$\n\\begin{aligned}-3x+5xy & =0 \\\\ x(-3+5y) & =0.\\end{aligned}\n$$\n\nSo, $x=0$ or $y=\\frac{3}{5}.$ We consider both cases separately.\n\n- If $x=0,$ substituting it into the second equation, we have\n\n$$\n\\begin{aligned}5y-3(0)y=0\\,⇒\\,y=0.\\end{aligned}\n$$\n\nThus, one equilibrium is $(0,0).$\n\n- If $y=\\frac{3}{5},$ substituting it into the second equation, we have\n\n$$\n\\begin{aligned}5y-3xy & =0 \\\\ y(5-3x) & =0 \\\\ \\frac{3}{5}(5-3x) & =0 \\\\ 5-3x & =0 \\\\ x & =\\frac{5}{3}.\\end{aligned}\n$$\n\nThus, another equilibrium is $(\\frac{5}{3},\\frac{3}{5}).$\n\nTherefore, the nonzero equilibrium of the model is\n$(\\frac{5}{3},\\frac{3}{5}).$"}] [{:db/id #edb/ref 17592186557273 :knowledge-point/_questions [{:db/id #edb/ref 17592186166924 :knowledge-point/id #uuid "f1fa1647-1acb-50bd-95e7-26ed0c495bd4" :knowledge-point/title "Classifying Equilibria of the Lotka-Volterra Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097afa2f-b763-522d-8032-55d688c0a48e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186556451} {:answer/id #uuid "41edcfd1-d5be-5af9-9124-6e8bc1342df8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186556575} {:answer/id #uuid "a183426e-8a50-5897-ac5d-048e3653057c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186556825} {:answer/id #uuid "c0ed8d32-d145-5e0c-aae9-cf1b8fc058cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186556893} {:answer/id #uuid "e9928077-44bc-5ecc-819b-2944f2d4cb5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186557006}] :answer-field/correct {:answer/id #uuid "e9928077-44bc-5ecc-819b-2944f2d4cb5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186557006} :answer-field/id #uuid "18af244f-5b99-5c52-b321-7c2760b8516a" :answer-field/key "field-4" :answer-field/type {:d