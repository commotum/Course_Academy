\\\ 0 & 6 & 9\\end{aligned}] & {R}_{3} & :={R}_{3}+(-6){R}_{2} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -6 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-2 & 3 & 8 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & -3\\end{aligned}] \\\\  & =U.\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -6 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 6 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-2 & 3 & 8 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & -3\\end{aligned}]}_{⏟}}_{U}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120193 :knowledge-point/_questions [{:db/id #edb/ref 17592186119794 :knowledge-point/id #uuid "a4d10f94-98d4-53d8-a35c-e65a06dd2c55" :knowledge-point/title "Finding the LU Factorization Using a Single Elementary Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3fb138a-dbb9-5bca-a0c0-cb9833348318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186117320} {:answer/id #uuid "b23b5e53-2fad-53e7-b91f-acc5facebb03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186117321} {:answer/id #uuid "f891ce3d-dab2-52d1-bd10-b64e7b66b3f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186117322} {:answer/id #uuid "24bac7cf-a2c0-5b28-8178-f63bc015eeb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186117323} {:answer/id #uuid "5e35b5b4-a128-5aaa-9073-3fcd24901fa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186117324}] :answer-field/correct {:answer/id #uuid "b23b5e53-2fad-53e7-b91f-acc5facebb03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186117321} :answer-field/id #uuid "996c4b7e-e3a3-51a4-b248-a60b56f90cef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117319}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7eb0065-e372-5f47-afb0-364ee5325cfa" :question/math-academy-id "q-32587" :question/problem "Given that\n$A=[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 8 \\\\ 5 & 10 & 9\\end{aligned}]$\nhas the LU decomposition $A=LU,$ then ${l}_{31}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 8 \\\\ 5 & 10 & 9\\end{aligned}] & {R}_{3} & :={R}_{3}+(-5){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -5 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 8 \\\\ 0 & 0 & -6\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -5 & 0 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 5 & 0 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 8 \\\\ 0 & 0 & -6\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{31}=5,{u}_{33}=-6,$ and ${l}_{31}\\cdot {u}_{33}=-30.$"}] [{:db/id #edb/ref 17592186120200 :knowledge-point/_questions [{:db/id #edb/ref 17592186119795 :knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44316460-f62f-5f2e-8461-32899b0a3bb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300298} {:answer/id #uuid "9e536b51-8864-5fa0-90f7-a389dd700360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300761} {:answer/id #uuid "aa03edf1-60b8-5e08-86a6-3adb47c71dd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300814} {:answer/id #uuid "d33fcfad-0616-55e9-b637-ad961007ce65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186301013} {:answer/id #uuid "f85f7da9-72c8-543b-aff8-74d9cd3dfab1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186301188}] :answer-field/correct {:answer/id #uuid "9e536b51-8864-5fa0-90f7-a389dd700360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300761} :answer-field/id #uuid "be381ffe-abf4-5da2-90cf-f936e2c2f43b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301848}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "80727ea8-1d37-5678-9a50-5d7e94ac9250" :question/math-academy-id "q-32684" :question/problem "Suppose that a $3\\times 3$ matrix $C$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}-{R}_{1},\\,{R}_{3}:={R}_{3}+4{R}_{1}\n$$\n\nGiven that $C$ has the LU factorization $C=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+4\\cdot {R}_{1}$ is equivalent to multiplying $C$ from the left by the following elementary matrices:\n\n$$\n{{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix}}_{⏟}}_{{E}_{2}}\\cdot {{\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}_{⏟}}_{{E}_{1}}\\cdot C=U\n$$\n\nNow, since ${E}_{2}{E}_{1}C=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}C & =U \\\\ {E}_{1}C & ={E}_{2}^{-1}U \\\\ C & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ C & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ C & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix})U \\\\ C & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -4 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302309 :knowledge-point/_questions [{:db/id #edb/ref 17592186119795 :knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f2ebc4b-5389-54bf-a2fa-d9bfc4a8f26e" :answer/type {:db/i