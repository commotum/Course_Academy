& 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{bmatrix})U \\\\ H & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120183 :knowledge-point/_questions [{:db/id #edb/ref 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fd1da0c-9706-54e7-a5f2-f3d28e865dbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300194} {:answer/id #uuid "412e17c7-0020-53f1-a0ef-539e1365d3d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -2 & 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300281} {:answer/id #uuid "4b04aaca-0605-5891-9aea-47020aa5f0dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300348} {:answer/id #uuid "7a7cfc9b-c118-57b5-980b-fd9d456c0e75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300566} {:answer/id #uuid "a9cb8b03-0892-5abc-894c-fd8f3ea0915c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300812}] :answer-field/correct {:answer/id #uuid "7a7cfc9b-c118-57b5-980b-fd9d456c0e75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186300566} :answer-field/id #uuid "91857d77-adc5-5d07-b88e-f2dabe47806e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301690}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "36e66381-e67c-58c9-901d-001e6d2f3331" :question/math-academy-id "q-32532" :question/problem "Given that \n$A=\\begin{bmatrix}1 & 2 & -1 \\\\ 2 & 5 & 0 \\\\ -1 & -2 & 3\\end{bmatrix}$ has the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 2 & -1 \\\\ 2 & 5 & 0 \\\\ -1 & -2 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 1 & 2 \\\\ -1 & -2 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 2\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 2\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302202 :knowledge-point/_questions [{:db/id #edb/ref 17592186119796 :knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0432df21-0cbf-5310-b63d-d6d35b252ad8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186299948} {:answer/id #uuid "0e624142-c08f-57f0-ac81-3c8acbe9f224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186300009} {:answer/id #uuid "934f2563-3041-51a5-be22-78f3bc46ae92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186300701} {:answer/id #uuid "ac425112-4037-539d-b950-dc90094cf5b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186300823} {:answer/id #uuid "b1c403d6-3218-5d7c-bb7b-d08ac835de9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186300849}] :answer-field/correct {:answer/id #uuid "0e624142-c08f-57f0-ac81-3c8acbe9f224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186300009} :answer-field/id #uuid "b0579342-0bba-5c5a-a576-6b032097c4cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301806}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "912ad134-e874-55d5-a192-6e414d5ad134" :question/math-academy-id "q-32533" :question/problem "Given that\n$A=\\begin{bmatrix}-1 & 1 & 1 \\\\ 1 & -3 & 1 \\\\ 0 & -1 & 2\\end{bmatrix}$\nhas the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-1 & 1 & 1 \\\\ 1 & -3 & 1 \\\\ 0 & -1 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 1 & 1 \\\\ 0 & -2 & 2 \\\\ 0 & -1 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-0.5){R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -0.5 & 1\\end{bmatrix}}}\\cdot {E}_{1}\\cdot A \\\\  & ∼\\begin{bmatrix}-1 & 1 & 1 \\\\ 0 & -2 & 2 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =U.\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -0.5 & 1\\end{bmatrix}}^{-1}U \\\\ A & =(\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0.5 & 1\\end{bmatrix})U \\\\ A & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0.5 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-1 & 1 & 1 \\\\ 0 & -2 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=0.5,{u}_{33}=1,$ and ${l}_{32}\\cdot {u}_{33}=0.5.$"}] [{:db/id #edb/ref 17592186557247 :knowledge-point/_questions [{:db/id #edb/ref 17592186119794 :knowledge-point/id #uuid "a4d10f94-98d4-53d8-a35c-e65a06dd2c55" :knowledge-point/title "Finding the LU Factorization Using a Single Elementary Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a55d4c8-ba65-5de7-84a2-4ee94b361461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186556487} {:answer/id #uuid "6294613e-6b1e-58a0-a797-a8bc314e0e5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186556655} {:answer/id #uuid "82e69121-ee24-55ee-be9b-a4fee20e1b36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186556734} {:answer/id #uuid "92f08831-eeff-53f3-8e72-199165e34fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186556784} {:answer/id #uuid "b6059bbc-7cd6-5c6e-a838-7b79406bffd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186556879}] :answer-field/correct {:answer/id #uuid "b6059bbc-7cd6-5c6e-a838-7b79406bffd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186556879} :answer-field/id #uuid "44515a13-3042-5dad-a7e1-fc7dbbca7de6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557102}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c02183d-b4b3-51bb-97f0-443673f54a1a" :question/math-academy-id "q-32571" :question/problem "Given that\n$A=[\\begin{aligned}1 & 5 & -7 \\\\ 0 & 2 & -4 \\\\ 0 & -3 & 5\\end{aligned}]$\nhas the LU decomposition $A=LU,$ then ${l}_{32}\\cdot {u}_{33}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 5 & -7 \\\\ 0 & 2 & -4 \\\\ 0 & -3 & 5\\end{aligned}] & {R}_{3} & :={R}_{3}+(\\frac{3}{2}){R}_{2} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{3}{2} & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}1 & 5 & -7 \\\\ 0 & 2 & -4 \\\\ 0 & 0 & -1\\end{aligned}] \\\\  & =U.\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & \\frac{3}{2} & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -\\frac{3}{2} & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & 5 & -7 \\\\ 0 & 2 & -4 \\\\ 0 & 0 & -1\\end{aligned}].}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=-\\frac{3}{2},{u}_{33}=-1,$ and ${l}_{32}\\cdot {u}_{33}=\\frac{3}{2}.$"}] [{:db/id #edb/ref 17592186557314 :knowledge-point/_questions [{:db/id #edb/ref 17592186119794 :knowledge-point/id #uuid "a4d10f94-98d4-53d8-a35c-e65a06dd2c55" :knowledge-point/title "Finding the LU Factorization Using a Single Elementary Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f45f559-94dd-563f-b6eb-86c40bcad18c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -6 & 1\\end{aligned}]" :db/id #edb/ref 17592186556606} {:answer/id #uuid "6135e766-b82e-5f99-857b-dc1d26563ce1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\beg