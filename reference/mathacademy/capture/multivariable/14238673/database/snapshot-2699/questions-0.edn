factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}H & =U \\\\ {E}_{1}H & ={E}_{2}^{-1}U \\\\ H & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ H & ={\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}}^{-1}{\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -8 & 0 & 1\\end{bmatrix}}^{-1}U \\\\ H & =(\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 8 & 0 & 1\\end{bmatrix})U \\\\ H & ={{\\begin{bmatrix}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 8 & 0 & 1\\end{bmatrix}}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399559 :knowledge-point/_questions [{:db/id #edb/ref 17592186119795 :knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03772422-1c36-5538-ad98-2c341599f95b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186399561} {:answer/id #uuid "c2fca63d-f8ed-5f29-879b-652f96b8979f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186399562} {:answer/id #uuid "d42309d2-7714-52af-b242-8be64341a7ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186399563} {:answer/id #uuid "2ef8e9e4-6087-5646-8666-05b609a8e68f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186399564} {:answer/id #uuid "0d7c55b5-02cc-530a-a0d0-c4f52cb2cc8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} 