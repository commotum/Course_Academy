></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mstyle mathcolor=\"blue\"><mn>3</mn></mstyle></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mstyle mathcolor=\"blue\"><mn>1</mn></mstyle></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>⏟</mo></munder></mrow><mrow data-mjx-texclass=\"ORD\"><mi>L</mi></mrow></munder><mo>⋅</mo><mi>U</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
