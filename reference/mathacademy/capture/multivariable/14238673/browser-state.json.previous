/mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>⏞</mo></mover></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>E</mi><mn>1</mn></msub></mrow></mover><mo>⋅</mo><mi>A</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>∼</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>1</mn></mtd><mtd><mo>−</mo><mn>2</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>3</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>3</mn></mtd><mtd><mo>−</mo><mn>1</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd><mtd><msub><mi>R</mi><mn>3</mn></msub></mtd><mtd><mi></mi><mo>:=</mo><msub><mi>R</mi><mn>3</mn></msub><mo>+</mo><mo stretchy=\"false\">(</mo><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><msub><mi>R</mi><mn>2</mn></msub></mtd><mtd><mi></mi><mo stretchy=\"false\">⟺</mo></mtd><mtd><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><mover><mrow data-mjx-texclass=\"OP\"><mover><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mo>−</mo><mn>1</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>⏞</mo></mover></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>E</mi><mn>2</mn></msub></mrow></mover><mo>⋅</mo><msub><mi>E</mi><mn>1</mn></msub><mo>⋅</mo><mi>A</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>∼</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>1</mn></mtd><mtd><mo>−</mo><mn>2</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>3</mn></