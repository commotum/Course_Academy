}^{2}+2x\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(6xy-2x+2y-3) & \\frac{∂}{∂x}(3{x}^{2}+2x) \\\\ \\frac{∂}{∂y}(6xy-2x+2y-3) & \\frac{∂}{∂y}(3{x}^{2}+2x)\\end{bmatrix} \\\\  & =\\begin{bmatrix}6y-2 & 6x+2 \\\\ 6x+2 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{\\begin{bmatrix}6y-2 & 6x+2 \\\\ 6x+2 & 0\\end{bmatrix}}_{{x}_{n}}^{-1}{\\begin{bmatrix}6xy-2x+2y-3 \\\\ 3{x}^{2}+2x\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nStarting with\n${x}_{0}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}-{\\begin{bmatrix}6y-2 & 6x+2 \\\\ 6x+2 & 0\\end{bmatrix}}_{{x}_{0}}^{-1}{\\begin{bmatrix}6xy-2x+2y-3 \\\\ 3{x}^{2}+2x\\end{bmatrix}}_{{x}_{0}} \\\\  & =\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}-{\\begin{bmatrix}6(2)-2 & 6(1)+2 \\\\ 6(1)+2 & 0\\end{bmatrix}}^{-1}\\begin{bmatrix}6(1)(2)-2(1)+2(2)-3 \\\\ 3(1)^{2}+2(1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}-{\\begin{bmatrix}10 & 8 \\\\ 8 & 0\\end{bmatrix}}^{-1}\\begin{bmatrix}11 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}-\\frac{1}{10\\cdot 0-8\\cdot 8}\\begin{bmatrix}0 & -8 \\\\ -8 & 10\\end{bmatrix}\\begin{bmatrix}11 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}+\\frac{1}{64}\\begin{bmatrix}-40 \\\\ -38\\end{bmatrix} \\\\  & ≈\\begin{bmatrix}0.375 \\\\ 1.406\\end{bmatrix}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186292592 #edb/ref 1068 #edb/ref 17592186292045 #edb/ref 17592186045417] [17592186292592 #edb/ref 1069 "q-257193" #edb/ref 17592186045417] [17592186292592 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186292592 #edb/ref 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[0,2]\\times [0,2]⊆{R}^{2},$ where\n\n$$\nf(x,y)=3{x}^{2}y-2x{y}^{2}-x+3{y}^{2}+3.\n$$\n\nCalculate one iteration of the Newton-Raphson process for optimization that starts at ${x}_{0}=[2,\\,0]^{T}.$ Round your final answer to three decimal places (if needed).\n\n| ${x}_{1}≈[$ | $1.014$ | $]$ |\n| --- | --- | --- |\n| {{field-1}} |  |  |" #edb/ref 17592186045417] [17592186292592 #edb/ref 1072 #uuid "190c6d44-474e-5b52-b8e9-3026c8fa349e" #edb/ref 17592186045417] [17592186292592 #edb/ref 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(3{x}^{2}y-2x{y}^{2}-x+3{y}^{2}+3) \\\\ \\frac{∂}{∂y}(3{x}^{2}y-2x{y}^{2}-x+3{y}^{2}+3)\\end{bmatrix} \\\\  & =\\begin{bmatrix}6xy-2{y}^{2}-1 \\\\ 3{x}^{2}-4xy+6y\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(6xy-2{y}^{2}-1) & \\frac{∂}{∂x}(3{x}^{2}-4xy+6y) \\\\ \\frac{∂}{∂y}(6xy-2{y}^{2}-1) & \\frac{∂}{∂y}(3{x}^{2}-4xy+6y)\\end{bmatrix} \\\\  & =\\begin{bmatrix}6y & 6x-4y \\\\ 6x-4y & 6-4x\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{\\begin{bmatrix}6y & 6x-4y \\\\ 6x-4y & 6-4x\\end{bmatrix}}_{{x}_{n}}^{-1}{\\begin{bmatrix}6xy-2{y}^{2}-1 \\\\ 3{x}^{2}-4xy+6y\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nStarting with\n${x}_{0}=\\begin{bmatrix}2 \\\\ 0\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}-{\\begin{bmatrix}6y & 6x-4y \\\\ 6x-4y & 6-4x\\end{bmatrix}}_{{x}_{0}}^{-1}{\\begin{bmatrix}6xy-2{y}^{2}-1 \\\\ 3{x}^{2}-4xy+6y\\end{bmatrix}}_{{x}_{0}} \\\\  & =\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}-{\\begin{bmatrix}6(0) & 6(2)-4(0) \\\\ 6(2)-4(0) & 6-4(2)\\end{bmatrix}}^{-1}\\begin{bmatrix}6(2)(0)-2(0)^{2}-1 \\\\ 3(2)^{2}-4(2)(0)+6(0)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}-{\\begin{bmatrix}0 & 12 \\\\ 12 & -2\\end{bmatri