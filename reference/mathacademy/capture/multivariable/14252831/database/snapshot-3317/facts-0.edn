2-90ca-b17d2dfc3fef" #edb/ref 17592186045417] [17592186575536 #edb/ref 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(4{x}^{2}y-2{x}^{2}+xy-3{y}^{2}-2) \\\\ \\frac{∂}{∂y}(4{x}^{2}y-2{x}^{2}+xy-3{y}^{2}-2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}8xy-4x+y \\\\ 4{x}^{2}+x-6y\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(8xy-4x+y) & \\frac{∂}{∂x}(4{x}^{2}+x-6y) \\\\ \\frac{∂}{∂y}(8xy-4x+y) & \\frac{∂}{∂y}(4{x}^{2}+x-6y)\\end{bmatrix} \\\\  & =\\begin{bmatrix}8y-4 & 8x+1 \\\\ 8x+1 & -6\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{\\begin{bmatrix}8y-4 & 8x+1 \\\\ 8x+1 & -6\\end{bmatrix}}_{{x}_{n}}^{-1}{\\begin{bmatrix}8xy-4x+y \\\\ 4{x}^{2}+x-6y\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nStarting with\n${x}_{0}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}-{\\begin{bmatrix}8y-4 & 8x+1 \\\\ 8x+1 & -6\\end{bmatrix}}_{{x}_{0}}^{-1}{\\begin{bmatrix}8xy-4x+y \\\\ 4{x}^{2}+x-6y\\end{bmatrix}}_{{x}_{0}} \\\\  & =\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}-{\\begin{bmatrix}8(2)-4 & 8(1)+1 \\\\ 8(1)+1 & -6\\end{bmatrix}}^{-1}\\begin{bmatrix}8(1)(2)-4(1)+2 \\\\ 4(1)^{2}+(1)-6(2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}-{\\begin{bmatrix}12 & 9 \\\\ 9 & -6\\end{bmatrix}}^{-1}\\begin{bmatrix}14 \\\\ -7\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}-\\frac{1}{12\\cdot (-6)-9\\cdot 9}\\begin{bmatrix}-6 & -9 \\\\ -9 & 12\\end{bmatrix}\\begin{bmatrix}14 \\\\ -7\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}+\\frac{1}{153}\\begin{bmatrix}-21 \\\\ -210\\end{bmatrix} \\\\  & ≈\\begin{bmatrix}0.863 \\\\ 0.627\\end{bmatrix}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186575629 #edb/ref 1058 #edb/ref 17592186575650 #edb/ref 17592186045417] [17592186575629 #edb/ref 1062 #uuid "02f70f84-4879-5483-8c29-2a30eb0b7266" #edb/ref 17592186045417] [17592186575629 #edb/ref 1063 #edb/ref 17592186292592 #edb/ref 17592186045417] [17592186575631 #edb/ref 1058 #edb/ref 17592186575629 #edb/ref 17592186045417] [17592186575631 #edb/ref 1062 #uuid "16446d00-e5b5-5d9b-913d-c5ae0ea22dc7" #edb/ref 17592186045417] [17592186575631 #edb/ref 1063 #edb/ref 17592186292591 #edb/ref 17592186045417] [17592186575650 #edb/ref 1062 #uuid "52f3de00-758e-50c2-92d0-b7b2f32051cf" #edb/ref 17592186045417] [17592186575650 #edb/ref 1063 #edb/ref 17592186575536 #edb/ref 17592186045417] [17592186575664 #edb/ref 1058 #edb/ref 17592186575677 #edb/ref 17592186045417] [17592186575664 #edb/ref 1062 #uuid "771bc9ee-acef-593c-92c0-5a668403e45d" #edb/ref 17592186045417] [17592186575664 #edb/ref 1063 #edb/ref 17592186204510 #edb/ref 17592186045417] [17592186575677 #edb/ref 1058 #edb/ref 17592186575631 #edb/ref 17592186045417] [17592186575677 #edb/ref 1062 #uuid "a7f21ffd-152a-5b80-9a81-6831dc018252" #edb/ref 17592186045417] [17592186575677 #edb/ref 1063 #edb/ref 17592186204512 #edb/ref 17592186045417]}
