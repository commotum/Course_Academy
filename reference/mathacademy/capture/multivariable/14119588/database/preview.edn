 2 \\\\ -2 & 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ 6 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -2 \\\\ -2 & 1 \\\\ 2 & -1\\end{aligned}]\\cdot {[\\begin{aligned}8 & -4 \\\\ -4 & 6\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}-4 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -2 \\\\ -2 & 1 \\\\ 2 & -1\\end{aligned}]\\cdot \\frac{1}{16}[\\begin{aligned}3 & 2 \\\\ 2 & 4\\end{aligned}]\\cdot [\\begin{aligned}-4 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -2 \\\\ -2 & 1 \\\\ 2 & -1\\end{aligned}]\\cdot \\frac{1}{4}[\\begin{aligned}-5 \\\\ -6\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 1 \\\\ -1\\end{aligned}]=\\overset{^}{x}\\end{aligned}\n$$\n\n \n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}} \\\\  & =\\sqrt{(3-3)^{2}+(6-1)^{2}+(4-(-1))^{2}} \\\\  & =\\sqrt{25+25} \\\\  & =\\sqrt{50} \\\\  & =5\\sqrt{2}.\\end{aligned}\n$$" 13194139534257 17592186045417 true] [17592186416324 1068 #edb/ref 17592186416322 13194139534257 17592186045417 true] [17592186416324 1069 "q-139469" 13194139534257 17592186045417 true] [17592186416324 1070 #edb/ref 17592186045485 13194139534257 17592186045417 true] [17592186416324 1071 "Find the distance between the vector $x$ and the subspace spanned by the linearly independent vectors ${{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}-2 \\\\ -2 \\\\ 1 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 2 \\\\ 2 \\\\ -1\\end{aligned}],\\,x=[\\begin{aligned}1 \\\\ 2 \\\\ -3 \\\\ -3\\end{aligned}].\n$$" 13194139534257 17592186045417 true] [17592186416324 1072 #uuid "d0d68cfe-73a4-5cae-a88d-ce4c5ac5ed06" 13194139534257 17592186045417 true] [17592186416324 1074 "The orthogonal projection of $x$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x=A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x.\n$$\n\nIn our case, we have \n\n$$\nA=[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]=[\\begin{aligned}-2 & -1 \\\\ -2 & 2 \\\\ 1 & 2 \\\\ 0 & -1\\end{aligned}]\\,⟹\\,{A}^{T}=[\\begin{aligned}-2 & -2 & 1 & 0 \\\\ -1 & 2 & 2 & -1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}-2 & -1 \\\\ -2 & 2 \\\\ 1 & 2 \\\\ 0 & -1\\end{aligned}]\\cdot {([\\begin{aligned}-2 & -2 & 1 & 0 \\\\ -1 & 2 & 2 & -1\\end{aligned}]\\,\\cdot \\,[\\begin{aligned}-2 & -1 \\\\ -2 & 2 \\\\ 1 & 2 \\\\ 0 & -1\\end{aligned}])}^{-1}\\,\\,\\,\\,\\cdot \\,[\\begin{aligned}-2 & -2 & 1 & 0 \\\\ -1 & 2 & 2 & -1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 2 \\\\ -3 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -1 \\\\ -2 & 2 \\\\ 1 & 2 \\\\ 0 & -1\\end{aligned}]\\cdot {[\\begin{aligned}9 & 0 \\\\ 0 & 10\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}-9 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -1 \\\\ -2 & 2 \\\\ 1 & 2 \\\\ 0 & -1\\end{aligned}]\\cdot \\frac{1}{90}[\\begin{aligned}10 & 0 \\\\ 0 & 9\\end{aligned}]\\cdot [\\begin{aligned}-9 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -1 \\\\ -2 & 2 \\\\ 1 & 2 \\\\ 0 & -1\\end{aligned}]\\cdot [\\begin{aligned}-1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 2 \\\\ -1 \\\\ 0\\end{aligned}]=\\overset{^}{x}\\end{aligned}\n$$\n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}+({x}_{4}-{\\overset{^}{x}}_{4})^{2}} \\\\  & =\\sqrt{(1-2)^{2}+(2-2)^{2}+(-3-(-1))^{2}+(-3-0)^{2}} \\\\  & =\\sqrt{1+0+4+9} \\\\  & =\\sqrt{14}.\\end{aligned}\n$$" 13194139534257 17592186045417 true]] :edb/tempids {"answer-0f092c3d-8556-5f6a-af54-6cf54502714d" 17592186416311 "answer-1a899cfc-2b1e-5341-b