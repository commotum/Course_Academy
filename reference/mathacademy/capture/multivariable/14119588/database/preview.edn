\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}-7 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ 5 \\\\ 1 \\\\ 1\\end{aligned}]=\\overset{^}{x}\\end{aligned}\n$$\n\nFinally, the distance between $\\mathbf{x}$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}+({x}_{4}-{\\overset{^}{x}}_{4})^{2}} \\\\  & =\\sqrt{(-3-(-3))^{2}+(5-5)^{2}+(-1-1)^{2}+(3-1)^{2}} \\\\  & =\\sqrt{0+0+4+4} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$" 13194139534257 17592186045417 false] [17592186184074 1074 "The orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n\\textrm{proj}_{S} \\: \\mathbf{x} = A(A^T\\!A)^{-1}\\!A^T\\,\\mathbf{x}.\n$$\n\nIn our case, we have \n![](images/ac/acee6cac9fd5dec811783141ecdcfd07402d6482146cdbdcac8f6e536416f0b7.svg)\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 1 \\\\ 1 & 3 \\\\ 1 & 2 \\\\ 1 & 2\\end{aligned}]\\cdot {([\\begin{aligned}1 & 1 & 1 & 1 \\\\ 1 & 3 & 2 & 2\\end{aligned}]\\,\\cdot \\,[\\begin{aligned}1 & 1 \\\\ 1 & 3 \\\\ 1 & 2 \\\\ 1 & 2\\end{aligned}])}^{-1}\\,\\,\\,\\,\\cdot \\,[\\begin{aligned}1 & 1 & 1 & 1 \\\\ 1 & 3 & 2 & 2\\end{aligned}]\\cdot [\\begin{aligned}-3 \\\\ 5 \\\\ -1 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & 3 \\\\ 1 & 2 \\\\ 1 & 2\\end{aligned}]\\cdot {[\\begin{aligned}4 & 8 \\\\ 8 & 18\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}4 \\\\ 16\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & 3 \\\\ 1 & 2 \\\\ 1 & 2\\end{aligned}]\\cdot \\frac{1}{4}[\\begin{aligned}9 & -4 \\\\ -4 & 2\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ 16\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & 3 \\\\ 1 & 2 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}-7 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-3 \\\\ 5 \\\\ 1 \\\\ 1\\end{aligned}]=\\overset{^}{x}\\end{aligned}\n$$\n\nFinally, the distance between $\\mathbf{x}$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}+({x}_{4}-{\\overset{^}{x}}_{4})^{2}} \\\\  & =\\sqrt{(-3-(-3))^{2}+(5-5)^{2}+(-1-1)^{2}+(3-1)^{2}} \\\\  & =\\sqrt{0+0+4+4} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$" 13194139534257 17592186045417 true] [17592186184075 1071 "Given the vector $\\mathbf{x}$ and the system of linear equations below, find the projection of $\\mathbf{x}$ onto the solution space of the system.\n![](images/04/043050d4ab229a40aef87d4a404f5af2337a36d1ba54926dcb9a214fdad5e245.png)" 13194139534257 17592186045417 false] [17592186184075 1071 "Given the vector $\\mathbf{x}$ and the system of linear equations below, find the projection of $\\mathbf{x}$ onto the solution space of the system.\n![](images/5a/5ad675762a16e4c81d5d83161dc24646121e4ca10b1e8a4957d7e9a317fc1fc4.svg)" 13194139534257 17592186045417 true] [17592186184075 1074 "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -2 & 3 & 0 \\\\ 2 & -4 & 6 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, $x_2,$ and $x_3$ are free variables. Now, from the first equation, we get $x_1 = 2x_2-3x_3.$ Therefore, the general solution is\n![](images/8a/8aac548229fb8312eefaed282dd27daadf560b17009f163d568ca1edda949a69.png)\n\nConsequently, \n\n![](images/b2/b241f88f83f96ef2f393b7450e5933831b300b98522b16b02208298db1b4ea91.png)\nis a basis of the solution space of the system.\n\nNow, we let $A$ be a matrix whose columns equal the elements of $\\mathcal B,$ and we find the orthogonal projection of $\\mathbf{x}$ onto the solution space of the system as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {([\\begin{aligned}2 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}2 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ 2 \\\\ 14\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {[\\begin{aligned}5 & -6 \\\\ -6 & 10\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}10 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{14}[\\begin{aligned}10 & 6 \\\\ 6 & 5\\end{aligned}]\\cdot [\\begin{aligned}10 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}8 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 8 \\\\ 5\\end{aligned}]\\end{aligned}\n$$" 13194139534257 17592186045417 false] [17592186184075 1074 "First, we need to find a basis for the solution space of the system. \n\nConsider the augmented matrix $M$ of the system, which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -2 & 3 & 0 \\\\ 2 & -4 & 6 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is $1$ pivot column (the $1$st one). Thus, $x_2,$ and $x_3$ are free variables. Now, from the first equation, we get $x_1 = 2x_2-3x_3.$ Therefore, the general solution is\n![](images/fe/fe0dd0d87977a4b16d56a96e54a5db6b56bd7cb9f5182a9c43ff6e14f03d2c7a.svg)\n\nConsequently, \n\n![](images/93/9335bf579d464c3e54a92459199d585c8e42b5ef21ee9382436439d050338c9e.svg)\nis a basis of the solution space of the system.\n\nNow, we let $A$ be a matrix whose columns equal the elements of $\\mathcal B,$ and we find the orthogonal projection of $\\mathbf{x}$ onto the solution space of the system as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =A({A}^{T}\\,A)^{-1}\\,{A}^{T}\\,x \\\\  & =[\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {([\\begin{aligned}2 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}2 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ 2 \\\\ 14\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot {[\\begin{aligned}5 & -6 \\\\ -6 & 10\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}10 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot \\frac{1}{14}[\\begin{aligned}10 & 6 \\\\ 6 & 5\\end{aligned}]\\cdot [\\begin{aligned}10 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -3 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}8 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 8 \\\\ 5\\end{aligned}]\\end{aligned}\n$$" 13194139534257 17592186045417 true] [17592186184111 1071 "Find the acute angle between the vector $\\mathbf{x}$ and the subspace spanned by the linearly independent vectors $\\{ \\mathbf{a}_1,\\mathbf{a}_2\\},$ where\n![](images/13/13b2b59a69e2fd1562f9b835128a16332c7fbd32646f662efe7dbf06bf5cac56.svg)" 13194139534257 17592186045417 true] [17592186184111 1071 "Find the acute angle between the vector $\\mathbf{x}$ and the subspace spanned by the linearly independent vectors $\\{ \\mathbf{a}_1,\\mathbf{a}_2\\},$ where\n![](images/2c/2c71360d859e203a5e1533b3c9aaa91c11243c1eba0bca05f92a03378850b067.png)" 13194139534257 17592186045417 false] [17592186184111 1074 "The orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n\\textrm{proj}_{S} \\: \\mathbf{x} = A(A^T\\!A)^{-1}\\!A^T\\,\\mathbf{x}.\n$$\n\nIn our case, we have\n![](images/9c/9cdf7153834225217e3cfd680182777f47f2cc0d09185a66742b46fc67ebd7b6.png)\nTherefore, we get the following projection: \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}]\\cdot {([\\begin{aligned}3 & -3 & -3 \\\\ 3 & -3 & 3\\end{aligned}]\\cdot [\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}3 & -3 & -3 \\\\ 3 & -3 & 3\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}]\\cdot {[\\begin{aligned}27 & 9 \\\\ 9 & 27\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}-3 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}]\\cdot \\frac{1}{72}[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]\\cdot [\\begin{aligned}-3 \\\\ -3\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}]\\cdot [\\begin{aligned}-1 \\\\ -1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nThe acute angle between $\\mathbf{x}$ and $S$ is the acute angle between $\\mathbf{x}$ and $\\textrm{proj}_S \\mathbf{x}.$ Equivalently, it is the acute angle between $\\mathbf{x}$ and any non-zero vector that is parallel to $\\textrm{proj}_S \\mathbf{x}.$ So, to make calculations easier, we can find the angle between the vectors\n\n![](images/4e/4e59afb848b5180340b05874c2dd63d04c22186c0c8e2235535e19551cab983a.png)\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{0\\cdot (-1)+1\\cdot 1+0\\cdot 0}{\\sqrt{{0}^{2}+{1}^{2}+{0}^{2}}\\sqrt{{(-1)}^{2}+{1}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{1}\\cdot \\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta = \\arccos\\left( \\dfrac{\\sqrt{2}}2\\right)= \\dfrac\\pi 4,\n$$\n\nwhich is already an acute angle, as desired." 13194139534257 17592186045417 false] [17592186184111 1074 "The orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n\\textrm{proj}_{S} \\: \\mathbf{x} = A(A^T\\!A)^{-1}\\!A^T\\,\\mathbf{x}.\n$$\n\nIn our case, we have\n![](images/bb/bb65806cb07e71dc92a5c55c210df1112da1f2500ed6cf18ef2a373d155aea94.svg)\nTherefore, we get the following projection: \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}]\\cdot {([\\begin{aligned}3 & -3 & -3 \\\\ 3 & -3 & 3\\end{aligned}]\\cdot [\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}3 & -3 & -3 \\\\ 3 & -3 & 3\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}]\\cdot {[\\begin{aligned}27 & 9 \\\\ 9 & 27\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}-3 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}]\\cdot \\frac{1}{72}[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]\\cdot [\\begin{aligned}-3 \\\\ -3\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}3 & 3 \\\\ -3 & -3 \\\\ -3 & 3\\end{aligned}]\\cdot [\\begin{aligned}-1 \\\\ -1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nThe acute angle between $\\mathbf{x}$ and $S$ is the acute angle between $\\mathbf{x}$ and $\\textrm{proj}_S \\mathbf{x}.$ Equivalently, it is the acute angle between $\\mathbf{x}$ and any non-zero vector that is parallel to $\\textrm{proj}_S \\mathbf{x}.$ So, to make calculations easier, we can find the angle between the vectors\n\n![](images/54/54a3c6bd24d0c021c0aa65ca1f12c6470b83744c46f984bdb076287b076fc9c1.svg)\n\nComputing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{0\\cdot (-1)+1\\cdot 1+0\\cdot 0}{\\sqrt{{0}^{2}+{1}^{2}+{0}^{2}}\\sqrt{{(-1)}^{2}+{1}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{1}\\cdot \\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta = \\arccos\\left( \\dfrac{\\sqrt{2}}2\\right)= \\dfrac\\pi 4,\n$$\n\nwhich is already an acute angle, as desired." 13194139534257 17592186045417 true] [17592186184175 1038 #edb/ref 17592186416323 13194139534257 17592186045417 true] [17592186184175 1038 #edb/ref 17592186416324 13194139534257 17592186045417 true] [17592186184403 1050 1260.0 13194139534257 17592186045417 true] [17592186184779 1068 #edb/ref 17592186183283 13194139534257 17592186045417 false] [17592186185333 1064 "One use for finding the orthogonal projection of a vector onto a subspace is to find the shortest distance between the vector and the subspace.\n\nGiven a vector $\\mathbf{x}$ and a subspace $S = \\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\},$ the **distance between $\\mathbf{x}$ and $S$** is given by \n\n$$\n\\Vert \\mathbf{x} - \\textrm{proj}_{S}\\mathbf{x} \\Vert\n$$\n\nas shown in the diagram below.\n\n![](images/d1/d10fd1778529183deb6912cebe9d2b7ad405091fe21a261c464d3d22c6d0860b.png)\n\nLet's find the distance between the vector $\\mathbf{x}$ and the subspace spanned by the linearly independent vectors $\\{\\mathbf{a}_1,\\mathbf{a}_2 \\},$ where\n\n![](images/83/83f52159171e736c7ee9edbd0593442d2282572db667eca483e5a77d0b73c9f7.svg)\n\nThe orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n\\textrm{proj}_{S} \\: \\mathbf{x} = A(A^T\\!A)^{-1}\\!A^T\\,\\mathbf{x}.\n$$\n\nIn this case, we have \n![](images/9e/9eca38b4b340e44108b073e3f939ce29ae96345b9c1870b9e2cc57a98f9cb077.svg)\nTherefore, we get the following projection: \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}]\\cdot {([\\begin{aligned}1 & 0 & -1 \\\\ 2 & -1 & -2\\end{aligned}]\\cdot [\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 0 & -1 \\\\ 2 & -1 & -2\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}]\\cdot {[\\begin{aligned}2 & 4 \\\\ 4 & 9\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}-4 \\\\ -10\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}]\\cdot \\frac{1}{2}[\\begin{aligned}9 & -4 \\\\ -4 & 2\\end{aligned}]\\cdot [\\begin{aligned}-4 \\\\ -10\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]=\\overset{^}{x}\\end{aligned}\n$$\n\n \n\nFinally, using the distance formula, the distance between $\\mathbf{x}$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}} \\\\  & =\\sqrt{(0-(-2))^{2}+(2-2)^{2}+(4-2)^{2}} \\\\  & =\\sqrt{4+0+4} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\n**Note:** Recall that the vector $\\textbf{x}-\\textrm{proj}_{S}\\,\\mathbf{x},$ whose norm $\\| \\textbf{x}-\\textrm{proj}_{S}\\,\\mathbf{x} \\|$ represents the distance from $\\mathbf{x}$ to $S,$ is sometimes called the **vector rejection of $\\mathbf{x}$ from $S.$**" 13194139534257 17592186045417 true] [17592186185333 1064 "One use for finding the orthogonal projection of a vector onto a subspace is to find the shortest distance between the vector and the subspace.\n\nGiven a vector $\\mathbf{x}$ and a subspace $S = \\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\},$ the **distance between $\\mathbf{x}$ and $S$** is given by \n\n$$\n\\Vert \\mathbf{x} - \\textrm{proj}_{S}\\mathbf{x} \\Vert\n$$\n\nas shown in the diagram below.\n\n![](images/d1/d10fd1778529183deb6912cebe9d2b7ad405091fe21a261c464d3d22c6d0860b.png)\n\nLet's find the distance between the vector $\\mathbf{x}$ and the subspace spanned by the linearly independent vectors $\\{\\mathbf{a}_1,\\mathbf{a}_2 \\},$ where\n\n$$\n[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]\n$$\n\nThe orthogonal projection of $\\mathbf{x}$ onto the subspace spanned by the columns of a matrix $A$ is given by\n\n$$\n\\textrm{proj}_{S} \\: \\mathbf{x} = A(A^T\\!A)^{-1}\\!A^T\\,\\mathbf{x}.\n$$\n\nIn this case, we have \n\n$$\n[\\begin{aligned}| & | \\\\ {a}_{1} & {a}_{2} \\\\ | & |\\end{aligned}]\n$$\n\nTherefore, we get the following projection: \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}]\\cdot {([\\begin{aligned}1 & 0 & -1 \\\\ 2 & -1 & -2\\end{aligned}]\\cdot [\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 0 & -1 \\\\ 2 & -1 & -2\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}]\\cdot {[\\begin{aligned}2 & 4 \\\\ 4 & 9\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}-4 \\\\ -10\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}]\\cdot \\frac{1}{2}[\\begin{aligned}9 & -4 \\\\ -4 & 2\\end{aligned}]\\cdot [\\begin{aligned}-4 \\\\ -10\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 0 & -1 \\\\ -1 & -2\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]=\\overset{^}{x}\\end{aligned}\n$$\n\n \n\nFinally, using the distance formula, the distance between $\\mathbf{x}$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}} \\\\  & =\\sqrt{(0-(-2))^{2}+(2-2)^{2}+(4-2)^{2}} \\\\  & =\\sqrt{4+0+4} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\n**Note:** Recall that the vector $\\textbf{x}-\\textrm{proj}_{S}\\,\\mathbf{x},$ whose norm $\\| \\textbf{x}-\\textrm{proj}_{S}\\,\\mathbf{x} \\|$ represents the distance from $\\mathbf{x}$ to $S,$ is sometimes called the **vector rejection of $\\mathbf{x}$ from $S.$**" 13194139534257 17592186045417 false] [17592186185334 1064 "As well as finding the distance between a vector and a subspace, we can also use the vector's orthogonal projection onto the subspace to find the angle between the vector and the subspace.\n\nGiven a vector $\\mathbf{x}$ and a subspace $S = \\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\},$ the **acute angle between $\\mathbf{x}$ and $S$** is the acute angle formed by $\\mathbf{x}$ and its orthogonal projection $\\textrm{proj}_S \\mathbf{x},$ as shown below:\n\n![](images/1c/1c9fd00ab46691fefc65ffa6478ed589fbad1df6bfd19b913c6a4a94ae0358a0.png)\n\nLet's return to our previous example, where we had\n\n![](images/3c/3c881ed55614722cf3cfe5c969c8c05a0c093e87cf1d2aa1221dbfc741455b92.svg)\n\nPreviously, we found that the orthogonal projection of $\\mathbf{x}$ into the subspace spanned by $\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\}$ is\n\n![](images/6a/6a060f96f72ece67567be5d0deb70042fa50ba2f005a1539c67383f6de3e1426.svg)\n\nWe can compute the cosine of the angle between $\\mathbf x$ and $\\textrm{proj}_S \\mathbf x$ using the dot product:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}x}{||x||\\cdot ||{\\text{proj}}_{S}x||} \\\\  & =\\frac{0\\cdot (-2)+2\\cdot 2+4\\cdot 2}{\\sqrt{{0}^{2}+{2}^{2}+{4}^{2}}\\sqrt{(-2)^{2}+{2}^{2}+{2}^{2}}} \\\\  & =\\frac{12}{\\sqrt{20}\\sqrt{12}} \\\\  & =\\frac{2\\cdot 2\\cdot 3}{2\\sqrt{5}\\cdot 2\\sqrt{3}} \\\\  & =\\frac{\\sqrt{3}}{\\sqrt{5}}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta = \\arccos\\left(  \\dfrac{\\sqrt3}{\\sqrt5}\\right) \\approx 39.23^{\\circ},\n$$\n\nwhich is already an acute angle." 13194139534257 17592186045417 true] [17592186185334 1064 "As well as finding the distance between a vector and a subspace, we can also use the vector's orthogonal projection onto the subspace to find the angle between the vector and the subspace.\n\nGiven a vector $\\mathbf{x}$ and a subspace $S = \\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\},$ the **acute angle between $\\mathbf{x}$ and $S$** is the acute angle formed by $\\mathbf{x}$ and its orthogonal projection $\\textrm{proj}_S \\mathbf{x},$ as shown below:\n\n![](images/1c/1c9fd00ab46691fefc65ffa6478ed589fbad1df6bfd19b913c6a4a94ae0358a0.png)\n\nLet's return to our previous example, where we had\n\n$$\n[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]\n$$\n\nPreviously, we found that the orthogonal projection of $\\mathbf{x}$ into the subspace spanned by $\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\}$ is\n\n$$\n[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]\n$$\n\nWe can compute the cosine of the angle between $\\mathbf x$ and $\\textrm{proj}_S \\mathbf x$ using the dot product:\n\n$$\n\\begin{aligned}\\operatorname{cos}\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}x}{||x||\\cdot ||{\\text{proj}}_{S}x||} \\\\  & =\\frac{0\\cdot (-2)+2\\cdot 2+4\\cdot 2}{\\sqrt{{0}^{2}+{2}^{2}+{4}^{2}}\\sqrt{(-2)^{2}+{2}^{2}+{2}^{2}}} \\\\  & =\\frac{12}{\\sqrt{20}\\sqrt{12}} \\\\  & =\\frac{2\\cdot 2\\cdot 3}{2\\sqrt{5}\\cdot 2\\sqrt{3}} \\\\  & =\\frac{\\sqrt{3}}{\\sqrt{5}}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta = \\arccos\\left(  \\dfrac{\\sqrt3}{\\sqrt5}\\right) \\approx 39.23^{\\circ},\n$$\n\nwhich is already an acute angle.\n\nNow, the acute angle between [math]\\mathbf{x}[/math] and [math]\\textrm{proj}_S \\mathbf{x}[/math] is equivalent to the acute angle between [math]\\mathbf{x}[/math] and any non-zero vector that is parallel to [math]\\textrm{proj}_S \\mathbf{x}.[/math] So, to make calculations easier, we can find the angle between the vectors\n\n[math]\\qquad[/math] [math]\\mathbf{x} = \\begin{bmatrix} 0 \\\\ 2 \\\\ 4 \\end{bmatrix} \\quad[/math] and [math]\\quad \\dfrac12 \\, \\textrm{proj}_S \\mathbf{x} = \\begin{bmatrix} -1 \\\\ 1 \\\\ 1 \\end{bmatrix}.[/math] \n\nComputing the cosine using the dot product, we obtain\n\n\\begin{align}\n\\cos\\theta \n&= \\dfrac{0 \\cdot (-1) + 2 \\cdot 1 + 4 \\cdot 1}{\\sqrt{0^2+2^2+4^2}\\sqrt{(-1)^2+1^2+1^2}} \\\\[5pt] \n&= \\dfrac{6}{\\sqrt{20}\\sqrt3} \\\\[5pt] \n&= \\dfrac{2\\cdot3}{2\\sqrt5\\sqrt3} \\\\[5pt] \n&= \\dfrac{\\sqrt3}{\\sqrt5}.  \n\\end{align}" 13194139534257 17592186045417 false] [17592186416311 1080 "3\\sqrt{6}" 13194139534257 17592186045417 true] [17592186416311 1082 #edb/ref 17592186045498 13194139534257 17592186045417 true] [17592186416311 1083 #uuid "0f092c3d-8556-5f6a-af54-6cf54502714d" 13194139534257 17592186045417 true] [17592186416312 1080 "5\\sqrt{2}" 13194139534257 17592186045417 true] [17592186416312 1082 #edb/ref 17592186045498 13194139534257 17592186045417 true] [17592186416312 1083 #uuid "1a899cfc-2b1e-5341-b7ff-75e82ccc677e" 13194139534257 17592186045417 true] [17592186416313 1080 "4" 13194139534257 17592186045417 true] [17592186416313 1082 #edb/ref 17592186045498 13194139534257 17592186045417 true] [17592186416313 1083 #uuid "6042ceb6-39dd-5861-ab98-2ba38c0dfad7" 13194139534257 17592186045417 true] [17592186416314 1080 "\\sqrt{15}" 13194139534257 17592186045417 true] [17592186416314 1082 #edb/ref 17592186045498 13194139534257 17592186045417 true] [17592186416314 1083 #uuid "6b6a5f2f-76cf-57a5-b55b-09e192c66fac" 13194139534257 17592186045417 true] [17592186416315 1080 "2\\sqrt{3}" 13194139534257 17592186045417 true] [17592186416315 1082 #edb/ref 17592186045498 13194139534257 17592186045417 true] [17592186416315 1083 #uuid "c6a4b7c1-b28b-59e9-b2e0-44d2e77e5df9" 13194139534257 17592186045417 true] [17592186416316 1080 "\\sqrt{14}" 13194139534257 17592186045417 true] [17592186416316 1082 #edb/ref 17592186045498 13194139534257 17592186045417 true] [17592186416316 1083 #uuid "db2fadc7-9954-5d2d-9567-580bac75c