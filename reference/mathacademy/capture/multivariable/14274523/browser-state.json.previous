      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14274523/observations/step-q315939-8430c13d3076b7233ecb.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14274523/observations/step-q315939-8430c13d3076b7233ecb.png",
      "source_url": "https://mathacademy.com/tasks/14274523/topics/1212/review",
      "captured_at": 1792220286.8506415,
      "math_academy_id": "q-315939",
