          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:100px;\n                                        margin-left:4px;\n                                        margin-right:4px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"1\"><span mathquill-command-id=\"3\">1</span><span mathquill-command-id=\"5\" class=\"mq-binary-operator\">−</span><span mathquill-command-id=\"7\">3</span><var mathquill-command-id=\"10\" class=\"mq-operator-name mq-first\">c</var><var mathquill-command-id=\"11\" class=\"mq-operator-name\">o</var><var mathquill-command-id=\"12\" class=\"mq-operator-name mq-last\">s</var><span mathquill-command-id=\"14\">(</span><span mathquill-command-id=\"16\">2</span><var mathquill-command-id=\"18\">t</var><span mathquill-command-id=\"20\">)</span></span></div></div>",
          "rendered_text": "1−3cos(2t)",
