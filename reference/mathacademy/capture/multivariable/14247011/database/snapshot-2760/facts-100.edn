{y}^{3})\\text{ }i+\\frac{∂}{∂y}(x{z}^{2}+z{y}^{3})\\text{ }j+\\frac{∂}{∂z}(x{z}^{2}+z{y}^{3})\\text{ }k \\\\  & ={z}^{2}\\text{ }i+3z{y}^{2}\\text{ }j+(2xz+{y}^{3})k \\\\ ∇\\,f(-2,1,2) & ={2}^{2}\\text{ }i+3(2)(1)^{2}\\text{ }j+(2(-2)(2)+{1}^{3})k \\\\  & =4\\,i+6\\,j-7k \\\\  & =⟨4,6,-7⟩\\end{aligned}\n$$\n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(-2,1,2)\\cdot ⟨x+2,\\,y-1,\\,z-2⟩ & =0 \\\\ ⟨4,6,-7⟩\\cdot ⟨x+2,\\,y-1,\\,z-2⟩ & =0 \\\\ 4(x+2)+6(y-1)-7(z-2) & =0 \\\\ 4x+6y-7z+16 & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186564515 #edb/ref 1068 #edb/ref 17592186564408 #edb/ref 17592186045417] [17592186564515 #edb/ref 1069 "q-102702" #edb/ref 17592186045417] [17592186564515 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186564515 #edb/ref 1071 "Given the function $f(x,y,z)={e}^{y}\\operatorname{cos}⁡2x+{z}^{2}$, find the equation of the tangent plane to the level surface that passes  through the point where $(x,y,z)=(\\frac{\\pi }{4},4,1).$" #edb/ref 17592186045417] [17592186564515 #edb/ref 1072 #uuid "a6978155-572b-505c-b00f-8a94900d562b" #edb/ref 17592186045417] [17592186564515 #edb/ref 1074 "The equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y,z)$ and evaluate it at $({x}_{0},{y}_{0},{z}_{0})=(\\frac{\\pi }{4},4,1):$ \n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}({e}^{y}\\operatorname{cos}⁡2x+{z}^{2})\\text{ }i+\\frac{∂}{∂y}({e}^{y}\\operatorname{cos}⁡2x+{z}^{2})\\text{ }j+\\frac{∂}{∂z}({e}^{y}\\operatorname{cos}⁡2x+{z}^{2})\\text{ }k \\\\  & =-2{e}^{y}\\operatorname{sin}⁡2x\\text{ }i+{e}^{y}\\operatorname{cos}⁡2x\\text{ }j+2zk \\\\ ∇\\,f(\\frac{\\pi }{4},4,1) & =-2{e}^{4}\\operatorname{sin}⁡(\\frac{\\pi }{2})\\text{ }i+{e}^{4}\\operatorname{cos}⁡(\\frac{\\pi }{2})\\text{ }j+2(1)k \\\\  & =-2{e}^{4}\\,i+0\\,j+2k \\\\  & =⟨-2{e}^{4},0,2⟩\\end{aligned}\n$$\n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(\\frac{\\pi }{4},4,1)\\cdot ⟨x-\\frac{\\pi }{4},\\,y-4,\\,z-1⟩ & =0 \\\\ ⟨-2{e}^{4},0,2⟩\\cdot ⟨x-\\frac{\\pi }{4},\\,y-4,\\,z-1⟩ & =0\\end{aligned}\n$$" #edb/ref 17592186045417]}
