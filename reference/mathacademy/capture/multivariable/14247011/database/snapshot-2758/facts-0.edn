b/ref 17592186045417] [17592186475905 #edb/ref 1075 #edb/ref 17592186475601 #edb/ref 17592186045417] [17592186475905 #edb/ref 1075 #edb/ref 17592186475653 #edb/ref 17592186045417] [17592186475905 #edb/ref 1075 #edb/ref 17592186475673 #edb/ref 17592186045417] [17592186475905 #edb/ref 1075 #edb/ref 17592186475792 #edb/ref 17592186045417] [17592186475905 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186475905 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186475905 #edb/ref 1078 #edb/ref 17592186475673 #edb/ref 17592186045417] [17592186475905 #edb/ref 1079 #uuid "f5f7cc0c-f2cb-5ebd-8a19-e3ddc8cdda4a" #edb/ref 17592186045417] [17592186475928 #edb/ref 1068 #edb/ref 17592186475905 #edb/ref 17592186045417] [17592186475928 #edb/ref 1069 "q-102714" #edb/ref 17592186045417] [17592186475928 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186475928 #edb/ref 1071 "Consider the surface $x{y}^{2}+6=z{x}^{2}.$ Find the equation of the tangent plane to that surface at the point $(-2,-1,1).$" #edb/ref 17592186045417] [17592186475928 #edb/ref 1072 #uuid "2dcb9c2a-7362-5965-b423-4b434eec8d3a" #edb/ref 17592186045417] [17592186475928 #edb/ref 1074 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}x{y}^{2}+6 & =z{x}^{2} \\\\ x{y}^{2}-z{x}^{2} & =-6\\end{aligned}\n$$\n\nIf we set $f(x,y,z)=x{y}^{2}-z{x}^{2}$, our surface can be viewed as the level surface $f(x,y,z)=-6.$ \n\nRecall that the equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nNow, we find the gradient of $f(x,y,z)$ and evaluate it at $(-2,-1,1):$\n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(x{y}^{2}-z{x}^{2})\\text{ }i+\\frac{∂}{∂y}(x{y}^{2}-z{x}^{2})\\text{ }j+\\frac{∂}{∂z}(x{y}^{2}-z{x}^{2})\\text{ }k \\\\  & =({y}^{2}-2xz)\\text{ }i+2xy\\text{ }j-{x}^{2}\\text{ }k \\\\ ∇\\,f(-2,-1,1) & =((-1)^{2}-2(-2)(1))\\text{ }i+2(-2)(-1)\\text{ }j-(-2)^{2}\\text{ }k \\\\  & =5\\,i+4j-4\\,k \\\\  & =⟨5,4,-4⟩\\end{aligned}\n$$\n\nFinally, we can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(-2,-1,1)\\cdot ⟨x+2,\\,y+1,\\,z-1⟩ & =0 \\\\ ⟨5,4,-4⟩\\cdot ⟨x+2,\\,y+1,\\,z-1⟩ & =0 \\\\ 5(x+2)+4(y+1)-4(z-1) & =0 \\\\ 5x+4y-4z+18 & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186475934 #edb/ref 1068 #edb/ref 17592186475843 #edb/ref 17592186045417] [17592186475934 #edb/ref 1069 "q-102713" #edb/ref 17592186045417] [17592186475934 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186475934 #edb/ref 1071 "Consider the surface $z\\operatorname{cos}⁡(x+y)-xyz=2+\\frac{{\\pi }^{2}}{2}.$ Given that $n=⟨a,b,c⟩$ is a non-zero normal vector to the surface at the point $(\\frac{\\pi }{2},-\\frac{\\pi }{2},2),$ what is the value of $\\frac{a}{b}?$" #edb/ref 17592186045417] [17592186475934 #edb/ref 1072 #uuid "480ef21f-535f-5e73-9903-6cc50742dda8" #edb/ref 17592186045417] [17592186475934 #edb/ref 1074 "Let's define  $f(x,y,z)=z\\operatorname{cos}⁡(x+y)-xyz.$ Then, our surface can be viewed as the level surface $f(x,y,z)=2+\\frac{{\\pi }^{2}}{2}.$  \n\nNow, we find the gradient of $f(x,y,z)$ and evaluate it at $(\\frac{\\pi }{2},-\\frac{\\pi }{2},2):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(z\\operatorname{cos}⁡(x+y)-xyz)i+\\frac{∂}{∂y}(z\\operatorname{cos}⁡(x+y)-xyz)j+\\frac{∂}{∂z}(z\\operatorname{cos}⁡(x+y)-xyz)k \\\\  & =(-z\\operatorname{sin}⁡(x+y)-yz)i+(-z\\operatorname{sin}⁡(x+y)-xz)j+(\\operatorname{cos}⁡(x+y)-xy)k \\\\ ∇f(\\frac{\\pi }{2},-\\frac{\\pi }{2},2) & =(-2\\operatorname{sin}⁡(\\frac{\\pi }{2}-\\frac{\\pi }{2})-2(-\\frac{\\pi }{2}))\\text{ }i+(-2\\operatorname{sin}⁡(\\frac{\\pi }{2}-\\frac{\\pi }{2})-2(\\frac{\\pi }{2}))\\text{ }j+(\\operatorname{cos}⁡(\\frac{\\pi }{2}-\\frac{\\pi }{2})-(\\frac{\\pi }{2})(-\\frac{\\pi }{2}))\\text{ }k \\\\  & =\\pi \\text{ }i-\\pi \\text{ }j+(1+\\frac{{\\pi }^{2}}{4})\\text{ }k \\\\  & =⟨\\pi ,\\,-\\pi ,\\,1+\\frac{{\\pi }^{2}}{4}⟩\\end{aligned}\n$$\n\nTherefore, our normal vector is $n=⟨a,b,c⟩=⟨\\pi ,\\,-\\pi ,\\,\\frac{{\\pi }^{2}+4}{4}⟩.$\n\nFinally, $\\frac{a}{b}=\\frac{\\pi }{-\\pi }=-1.$" #edb/ref 17592186045417] [17592186475937 #edb/ref 1068 #edb/ref 17592186475885 #edb/ref 17592186045417] [17592186475937 #edb/ref 1069 "q-102707" #edb/ref 17592186045417] [17592186475937 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186475937 #edb/ref 1071 "Given the function $f(x,y,z)={x}^{2}z+{z}^{2}y+{y}^{2}x$, find the equation of the tangent plane to the level surface that passes  through the point where $(x,y,z)=(1,1,-1).$" #edb/ref 17592186045417] [17592186475937 #edb/ref 1072 #uuid "58a67d8c-4e10-594d-863e-d6da9c98fcce" #edb/ref 17592186045417] [17592186475937 #edb/ref 1074 "The equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y,z)$ and evaluate it at $({x}_{0},{y}_{0},{z}_{0})=(1,1,-1):$ \n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}({x}^{2}z+{z}^{2}y+{y}^{2}x)\\text{ }i+\\frac{∂}{∂y}({x}^{2}z+{z}^{2}y+{y}^{2}x)\\text{ }j+\\frac{∂}{∂z}({x}^{2}z+{z}^{2}y+{y}^{2}x)\\text{ }k \\\\  & =(2xz+{y}^{2})\\text{ }i+({z}^{2}+2yx)\\text{ }j+({x}^{2}+2zy)k \\\\ ∇\\,f(1,1,-1) & =(2(1)(-1)+{1}^{2})\\text{ }i+((-1)^{2}+2(1)(1))\\text{ }j+({1}^{2}+2(-1)(1))k \\\\  & =-\\,i+3\\,j-k \\\\  & =⟨-1,3,-1⟩\\end{aligned}\n$$\n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(1,1,-1)\\cdot ⟨x-1,\\,y-1,\\,z+1⟩ & =0 \\\\ ⟨-1,3,-1⟩\\cdot ⟨x-1,\\,y-1,\\,z+1⟩ & =0 \\\\ -(x-1)+3(y-1)-(z+1) & =0 \\\\ -x+3y-z-3 & =0\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186493376 #edb/ref 1043 #edb/ref 17592186494023 #edb/ref 17592186045417] [17592186493376 #edb/ref 1043 #edb/ref 17592186494027 #edb/ref 17592186045417] [17592186493376 #edb/ref 1043 #edb/ref 17592186494028 #edb/ref 17592186045417] [17592186493376 #edb/ref 1043 #edb/ref 17592186494051 #edb/ref 17592186045417] [17592186493376 #edb/ref 1043 #edb/ref 17592186494072 #edb/ref 17592186045417] [17592186493376 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186493376 #edb/ref 1045 "Tangent Planes to Level Surfaces" #edb/ref 17592186045417] [17592186493376 #edb/ref 1046 #edb/ref 17592186494072 #edb/ref 17592186045417] [17592186493376 #edb/ref 1048 #edb/ref 17592186046659 #edb/ref 17592186045417] [17592186493376 #edb/ref 1049 #edb/ref 17592186048554 #edb/ref 17592186045417] [17592186493376 #edb/ref 1053 #uuid "63e75d2f-a87d-5228-8980-4d6f3fc9a47a" #edb/ref 17592186045417] [17592186493426 #edb/ref 1080 "⟨1,1,-e⟩\\cdot ⟨x-e,\\,y-e,\\,z-1⟩=0" #edb/ref 17592186045417] [17592186493426 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186493426 #edb/ref 1083 #uuid "13a034a0-40db-53e2-8743-0500f64927fd" #edb/ref 17592186045417] [17592186493465 #edb/ref 1080 "⟨2,e,2e⟩\\cdot ⟨x+1,\\,y+2,\\,z+1⟩=0" #edb/ref 17592186045417] [17592186493465 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186493465 #edb/ref 1083 #uuid "2c75f8c9-6d90-5e2f-9fd0-6d4f8cbd173a" #edb/ref 17592186045417] [17592186493472 #edb/ref 1080 "⟨2,-e,-2e⟩\\cdot ⟨x-1,\\,y-2,\\,z-1⟩=0" #edb/ref 17592186045417] [17592186493472 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186493472 #edb/ref 1083 #uuid "3050b9e4-da08-5715-ad5a-8caf10a32624" 