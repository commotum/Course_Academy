7] [17592186322687 #edb/ref 1083 #uuid "c69134c6-e59d-5120-8af3-0b8bb7f8b190" #edb/ref 17592186045417] [17592186323391 #edb/ref 1075 #edb/ref 17592186321465 #edb/ref 17592186045417] [17592186323391 #edb/ref 1075 #edb/ref 17592186322054 #edb/ref 17592186045417] [17592186323391 #edb/ref 1075 #edb/ref 17592186322509 #edb/ref 17592186045417] [17592186323391 #edb/ref 1075 #edb/ref 17592186322659 #edb/ref 17592186045417] [17592186323391 #edb/ref 1075 #edb/ref 17592186322687 #edb/ref 17592186045417] [17592186323391 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186323391 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186323391 #edb/ref 1078 #edb/ref 17592186322687 #edb/ref 17592186045417] [17592186323391 #edb/ref 1079 #uuid "6e18b7a8-1caf-5bbf-be09-d1d09a6d4c0a" #edb/ref 17592186045417] [17592186345399 #edb/ref 1080 "-5" #edb/ref 17592186045417] [17592186345399 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186345399 #edb/ref 1083 #uuid "055ca543-5d57-5d9e-a2d2-381ab5780193" #edb/ref 17592186045417] [17592186346185 #edb/ref 1080 "-\\frac{3}{2}" #edb/ref 17592186045417] [17592186346185 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346185 #edb/ref 1083 #uuid "606d26e9-38fb-5406-81c6-bbbc70b87d52" #edb/ref 17592186045417] [17592186346589 #edb/ref 1080 "\\frac{3}{2}" #edb/ref 17592186045417] [17592186346589 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186346589 #edb/ref 1083 #uuid "8e4a5312-9c03-5d11-93e6-1b83c3444d97" #edb/ref 17592186045417] [17592186347038 #edb/ref 1080 "3" #edb/ref 17592186045417] [17592186347038 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186347038 #edb/ref 1083 #uuid "c345d148-9371-50cb-bc70-e50fb33e6977" #edb/ref 17592186045417] [17592186347286 #edb/ref 1080 "4" #edb/ref 17592186045417] [17592186347286 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186347286 #edb/ref 1083 #uuid "dcdb03f8-d803-5843-ae32-5f7feed10058" #edb/ref 17592186045417] [17592186347701 #edb/ref 1075 #edb/ref 17592186345399 #edb/ref 17592186045417] [17592186347701 #edb/ref 1075 #edb/ref 17592186346185 #edb/ref 17592186045417] [17592186347701 #edb/ref 1075 #edb/ref 17592186346589 #edb/ref 17592186045417] [17592186347701 #edb/ref 1075 #edb/ref 17592186347038 #edb/ref 17592186045417] [17592186347701 #edb/ref 1075 #edb/ref 17592186347286 #edb/ref 17592186045417] [17592186347701 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186347701 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186347701 #edb/ref 1078 #edb/ref 17592186347038 #edb/ref 17592186045417] [17592186347701 #edb/ref 1079 #uuid "38edd513-af3d-5da1-9d87-d229b9ce95f5" #edb/ref 17592186045417] [17592186348450 #edb/ref 1068 #edb/ref 17592186347701 #edb/ref 17592186045417] [17592186348450 #edb/ref 1069 "q-80778" #edb/ref 17592186045417] [17592186348450 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186348450 #edb/ref 1071 "Consider the surface ${2}^{3{z}^{2}+2xy}=2.$ Given that $n=⟨a,b,c⟩$ is a non-zero normal vector to the surface at the point $(1,-1,1),$ what is the value of $\\frac{c}{b}?$" #edb/ref 17592186045417] [17592186348450 #edb/ref 1072 #uuid "581af8f1-8855-519d-a20e-429c65cef0c0" #edb/ref 17592186045417] [17592186348450 #edb/ref 1074 "Let's define  $f(x,y,z)={2}^{3{z}^{2}+2xy}.$ Then, our surface can be viewed as the level surface $f(x,y,z)=2.$  \n\nNow, we find the gradient of $f(x,y,z)$ and evaluate it at $(1,-1,1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}({2}^{3{z}^{2}+2xy})i+\\frac{∂}{∂y}({2}^{3{z}^{2}+2xy})j+\\frac{∂}{∂z}({2}^{3{z}^{2}+2xy})k \\\\  & =({2}^{3{z}^{2}+2xy}\\cdot 2y\\operatorname{ln}⁡2)i+({2}^{3{z}^{2}+2xy}\\cdot 2x\\operatorname{ln}⁡2)j+({2}^{3{z}^{2}+2xy}\\cdot 6z\\operatorname{ln}⁡2)k \\\\  & =2\\operatorname{ln}⁡2(y\\,\\text{ }{2}^{3{z}^{2}+2xy}\\text{ }i+x\\,\\text{ }{2}^{3{z}^{2}+2xy}\\text{ }j+3z\\,\\text{ }{2}^{3{z}^{2}+2xy}\\text{ }k) \\\\ ∇f(1,-1,1) & =2\\operatorname{ln}⁡2((-1)\\cdot \\text{ }{2}^{3(1)^{2}+2\\cdot 1\\cdot (-1)}\\text{ }i+1\\cdot \\,\\text{ }{2}^{3(1)^{2}+2\\cdot 1\\cdot (-1)}\\text{ }j+3(1)\\cdot {2}^{3(1)^{2}+2\\cdot 1\\cdot (-1)}\\text{ }k) \\\\  & =2\\operatorname{ln}⁡2(-{2}^{1}\\text{ }i+{2}^{1}\\text{ }j+3\\cdot {2}^{1}\\text{ }k) \\\\  & =4\\operatorname{ln}⁡2(-i+j+3\\text{ }k) \\\\  & =⟨-4\\operatorname{ln}⁡2,\\,4\\operatorname{ln}⁡2,\\,12\\operatorname{ln}⁡2⟩\\end{aligned}\n$$\n\nTherefore, our normal vector is $n=⟨a,b,c⟩=⟨-4\\operatorname{ln}⁡2,\\,4\\operatorname{ln}⁡2,\\,12\\operatorname{ln}⁡2⟩.$\n\nFinally, $\\frac{c}{b}=\\frac{12\\operatorname{ln}⁡2}{4\\operatorname{ln}⁡2}=3.$" #edb/ref 17592186045417] [17592186366809 #edb/ref 1075 #edb/ref 17592186366810 #edb/ref 17592186045417] [17592186366809 #edb/ref 1075 #edb/ref 17592186366811 #edb/ref 17592186045417] [17592186366809 #edb/ref 1075 #edb/ref 17592186366812 #edb/ref 17592186045417] [17592186366809 #edb/ref 1075 #edb/ref 17592186366813 #edb/ref 17592186045417] [17592186366809 #edb/ref 1075 #edb/ref 17592186366814 #edb/ref 17592186045417] [17592186366809 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186366809 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186366809 #edb/ref 1078 #edb/ref 17592186366810 #edb/ref 17592186045417] [17592186366809 #edb/ref 1079 #uuid "ab905e04-ebcb-5bbc-8e7d-cdb57e6bb24a" #edb/ref 17592186045417] [17592186366810 #edb/ref 1080 "3x+2y+4z-16=0" #edb/ref 17592186045417] [17592186366810 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186366810 #edb/ref 1083 #uuid "b9d90141-bb87-557b-8f42-7d42bba3c91d" #edb/ref 17592186045417] [17592186366811 #edb/ref 1080 "2x+4y+3z-10=0" #edb/ref 17592186045417] [17592186366811 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186366811 #edb/ref 1083 #uuid "152ddd87-e22d-58da-85bb-b549e713fa60" #edb/ref 17592186045417] [1759218636