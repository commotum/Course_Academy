 -6\\end{aligned}],\\,Σ=[\\begin{aligned}7 & 0 \\\\ 0 & 6\\end{aligned}],\\,V=[\\begin{aligned}\\frac{2}{\\sqrt{13}} & -\\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{aligned}]\n$$\n\nConsider the matrices $A,$ $Σ,$ and $V$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ what is the second column of $U?$" :question/worked-solution "Recall that if $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ and ${\\sigma }_{i}\\ne 0,$ then the $i$th column of $U$ can be found as\n\n$$\n{u}_{i}=\\frac{1}{{\\sigma }_{i}}A{v}_{i},\n$$\n\n \n\nwhere ${v}_{i}$ is the $i$th column of the matrix $V.$\n\nFrom the matrix $Σ,$ we deduce that the singular values are ${\\sigma }_{1}=7$ and ${\\sigma }_{2}=6.$ Therefore, the second column of $U$ is\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{6}[\\begin{aligned}6 & 3 \\\\ 2 & -6\\end{aligned}][\\begin{aligned}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}-\\frac{12}{\\sqrt{13}} \\\\ -\\frac{18}{\\sqrt{13}}\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{2}{\\sqrt{13}} \\\\ -\\frac{3}{\\sqrt{13}}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186418153 :knowledge-point/_questions [{:db/id #edb/ref 17592186162017 :knowledge-point/id #uuid "f0d7f5df-a1f9-5242-9386-446313ec0178" :knowledge-point/title "Determining the Columns of the First Matrix Given Part of a Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "497e502c-a710-5896-85f2-7c55ee60c5a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}{\\sqrt{10}} \\\\ -\\frac{1}{\\sqrt{10}}\\end{aligned}]" :db/id #edb/ref 17592186418101} {:answer/id #uuid "56b85f54-1a37-5dc2-9478-38992ce73b70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3}