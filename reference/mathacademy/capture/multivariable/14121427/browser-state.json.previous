      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121427/observations/step-q140637-dc228b21f6fa97b5fe48.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121427/observations/step-q140637-dc228b21f6fa97b5fe48.png",
      "source_url": "https://mathacademy.com/tasks/14121427/topics/3132/lesson",
      "captured_at": 1791740421.986507,
      "math_academy_id": "q-140637",
      "topic_id": "3132",
      "sequence_position": null,
      "source_step": {
