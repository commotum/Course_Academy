      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121427/observations/step-q96328-825d1fc90bea3820939a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121427/observations/step-q96328-825d1fc90bea3820939a.png",
      "source_url": "https://mathacademy.com/tasks/14121427/topics/3132/lesson",
      "captured_at": 1791740625.9790628,
      "math_academy_id": "q-96328",
      "topic_id": "3132",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q96328",
        "placement_id": null,
        "content_id": null,
        "type": null
