      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121427/observations/step-q96321-e6b2f7529ea1854e52bb.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121427/observations/step-q96321-e6b2f7529ea1854e52bb.png",
      "source_url": "https://mathacademy.com/tasks/14121427/topics/3132/lesson",
      "captured_at": 1791740673.1828353,
      "math_academy_id": "q-96321",
