      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121427/observations/step-q96309-973697d049c94f7f44e3.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121427/observations/step-q96309-973697d049c94f7f44e3.png",
      "source_url": "https://mathacademy.com/tasks/14121427/topics/3132/lesson",
      "captured_at": 1791740591.2196074,
      "math_academy_id": "q-96309",
