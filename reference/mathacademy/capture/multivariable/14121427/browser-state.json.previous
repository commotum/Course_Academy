      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121427/observations/step-q96352-c7a8d533ffd12d8d4ae8.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14121427/observations/step-q96352-c7a8d533ffd12d8d4ae8.png",
      "source_url": "https://mathacademy.com/tasks/14121427/topics/3132/lesson",
      "captured_at": 1791740750.8396552,
      "math_academy_id": "q-96352",
