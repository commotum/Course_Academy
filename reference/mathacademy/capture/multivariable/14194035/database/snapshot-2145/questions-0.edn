#{[{:db/id #edb/ref 17592186281560 :knowledge-point/_questions [{:db/id #edb/ref 17592186198407 :knowledge-point/id #uuid "444e9b54-f6d4-5b70-af49-d01556bb3135" :knowledge-point/title "The Moment of a Plane Lamina About the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "167e6409-5e3e-5efb-a712-07b360471d4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186278790} {:answer/id #uuid "2732ae5b-753f-525a-b5e9-1120f08e3c31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186278940} {:answer/id #uuid "775abca6-570c-5895-b34d-8941c17f178b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186279658} {:answer/id #uuid "88d3bab5-4d08-59c8-a45a-f21f13e573d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186279814} {:answer/id #uuid "f3d35eb7-48e3-5f6c-b3b0-c9bb57e1a8a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186280726}] :answer-field/correct {:answer/id #uuid "2732ae5b-753f-525a-b5e9-1120f08e3c31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186278940} :answer-field/id #uuid "e17aea6f-d602-5f51-a2f7-34b15c79c4b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281226}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b4076e3-ab6e-5bdd-85c0-2781a4c652d0" :question/math-academy-id "q-162977" :question/problem "The lamina $D={(x,y)\\,:\\,1\\le y\\le 3,\\,1\\le x\\le {e}^{y}}$ has the mass density function $\\lambda (x,y)=\\frac{1}{xy}.$ Find the moment of the lamina about the $x$-axis." :question/worked-solution "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $x$-axis is given by\n\n$$\n{M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type II plane region and $\\lambda (x,y)=\\frac{1}{xy}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\cdot \\frac{1}{xy}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{1}{x}\\,\\text{d}A \\\\  & ={\\int }_{1}^{3}{\\int }_{1}^{{e}^{y}}\\frac{1}{x}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}[\\operatorname{ln}⁡x]_{x=1}^{x={e}^{y}}\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}y\\,\\text{d}y \\\\  & ={[\\frac{{y}^{2}}{2}]}_{y=1}^{y=3} \\\\  & =\\frac{1}{2}(9-1) \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281587 :knowledge-point/_questions [{:db/id #edb/ref 17592186198406 :knowledge-point/id #uuid "804ee2d1-5590-534d-ae11-7d2c5614a9b1" :knowledge-point/title "The Moment of a Plane Lamina About the Y-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e521e4f-0860-5a65-9ac2-eda32bfca8ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186279305} {:answer/id #uuid "4ff0cfbd-f9da-5245-a475-255ea08605cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186279318} {:answer/id #uuid "8fdb2853-701b-5307-ad7e-d512948651d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186279873} {:answer/id #uuid "ab21d0b4-eff6-548f-b2b3-7f4952880828" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186280108} {:answer/id #uuid "fd58d3b2-06c6-5e92-89a3-b6bb6ae53691" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186280809}] :answer-field/correct {:answer/id #uuid "4e521e4f-0860-5a65-9ac2-eda32bfca8ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186279305} :answer-field/id #uuid "c47ab8ca-3bde-5fba-a4a7-31651f3af0b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281176}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe9f4bda-1254-5b20-b5e7-335406a2dc03" :question/math-academy-id "q-163066" :question/problem "The lamina $D={(x,y)\\,:\\,0\\le x\\le 3y,\\,0\\le y\\le 1}$ has the mass density function $\\lambda (x,y)=5xy.$ Find the moment of the lamina about the $y$-axis." :question/worked-solution "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $y$-axis is given by\n\n$$\n{M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type II plane region and $\\lambda (x,y)=5xy.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{y} & ={∬}_{D}x\\cdot 5xy\\,\\text{d}A \\\\  & ={∬}_{D}5{x}^{2}y\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3y}5{x}^{2}y\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}5y{\\int }_{0}^{3y}{x}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}5y{[\\frac{{x}^{3}}{3}]}_{x=0}^{x=3y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}5y(9{y}^{3}-0)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}45{y}^{4}\\,\\text{d}y \\\\  & =[9{y}^{5}]_{y=0}^{y=1} \\\\  & =9.\\end{aligned}\n$$"}]}
