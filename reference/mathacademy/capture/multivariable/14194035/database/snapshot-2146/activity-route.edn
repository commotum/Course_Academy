#{[{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186508138} :activity/id #uuid "66c5f538-bf73-5738-ac9e-056fec289e7e" :activity/scope {:db/id #edb/ref 17592186049110 :topic/id #uuid "db34e5aa-cabd-518f-9dff-177947a5ce3a" :topic/math-academy-id 4166} :activity/steps [{:db/id #edb/ref 17592186508117 :step/content {:db/id #edb/ref 17592186281587 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e521e4f-0860-5a65-9ac2-eda32bfca8ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186279305} {:answer/id #uuid "4ff0cfbd-f9da-5245-a475-255ea08605cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186279318} {:answer/id #uuid "8fdb2853-701b-5307-ad7e-d512948651d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186279873} {:answer/id #uuid "ab21d0b4-eff6-548f-b2b3-7f4952880828" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186280108} {:answer/id #uuid "fd58d3b2-06c6-5e92-89a3-b6bb6ae53691" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186280809}] :answer-field/correct {:db/id #edb/ref 17592186279305} :answer-field/id #uuid "c47ab8ca-3bde-5fba-a4a7-31651f3af0b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281176}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fe9f4bda-1254-5b20-b5e7-335406a2dc03" :question/math-academy-id "q-163066" :question/problem "The lamina $D=\\{(x,y)\\,:\\,0\\le x\\le 3y,\\,0\\le y\\le 1\\}$ has the mass density function $\\lambda (x,y)=5xy.$ Find the moment of the lamina about the $y$-axis." :question/worked-solution "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $y$-axis is given by\n\n$$\n{M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type II plane region and $\\lambda (x,y)=5xy.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{y} & ={∬}_{D}x\\cdot 5xy\\,\\text{d}A \\\\  & ={∬}_{D}5{x}^{2}y\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3y}5{x}^{2}y\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}5y{\\int }_{0}^{3y}{x}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}5y{[\\frac{{x}^{3}}{3}]}_{x=0}^{x=3y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}5y(9{y}^{3}-0)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}45{y}^{4}\\,\\text{d}y \\\\  & =[9{y}^{5}]_{y=0}^{y=1} \\\\  & =9.\\end{aligned}\n$$"} :step/id #uuid "04149e10-de16-5e52-9d4c-e924df4e6c9a" :step/next {:db/id #edb/ref 17592186508168}} {:db/id #edb/ref 17592186508138 :step/content {:db/id #edb/ref 17592186508098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63becd05-2827-54e1-b25f-49475c7277d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186507745} {:answer/id #uuid "a8e556e3-1b58-565c-8179-f27e71c39ec1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186507835} {:answer/id #uuid "b7617195-3a4c-5cce-a014-90302c0f45d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186507850} {:answer/id #uuid "ccd1812f-96df-5ea4-86f6-fc9ebbe2a707" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186507881} {:answer/id #uuid "eae7226a-9ab7-55eb-9547-35faebb62155" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186507917}] :answer-field/correct {:db/id #edb/ref 17592186507917} :answer-field/id #uuid "0b8a70bd-cbd3-5bb7-9a20-2989c5769039" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507947}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c6e7ac3c-60bd-5c96-a837-e70ac483b403" :question/math-academy-id "q-162972" :question/problem "The lamina $D=\\{(x,y)\\,:\\,(x,y)\\,:\\,0\\le y\\le 1,\\,-y\\le x\\le y\\}$ has the mass density function $\\lambda (x,y)=6{x}^{2}.$ Find the moment of the lamina about the $x$-axis." :question/worked-solution "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $x$-axis is given by\n\n$$\n{M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type II plane region and $\\lambda (x,y)=6{x}^{2}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\cdot 6{x}^{2}\\,\\text{d}A \\\\  & ={∬}_{D}6{x}^{2}y\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{-y}^{y}6{x}^{2}y\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}2y[{\\int }_{-y}^{y}3{x}^{2}\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}2y\\cdot {[{x}^{3}]}_{x=-y}^{x=y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}2y\\cdot 2{y}^{3}\\text{ }\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}4{y}^{4}\\,\\text{d}y \\\\  & ={[\\frac{4}{5}{y}^{5}]}_{y=0}^{y=1} \\\\  & =\\frac{4}{5}.\\end{aligned}\n$$"} :step/id #uuid "64412876-71ee-5320-bcb3-58c33e18f0b7" :step/next {:db/id #edb/ref 17592186508165}} {:db/id #edb/ref 17592186508165 :step/content {:db/id #edb/ref 17592186281560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "167e6409-5e3e-5efb-a712-07b360471d4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186278790} {:answer/id #uuid "2732ae5b-753f-525a-b5e9-1120f08e3c31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186278940} {:answer/id #uuid "775abca6-570c-5895-b34d-8941c17f178b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186279658} {:answer/id #uuid "88d3bab5-4d08-59c8-a45a-f21f13e573d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186279814} {:answer/id #uuid "f3d35eb7-48e3-5f6c-b3b0-c9bb57e1a8a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186280726}] :answer-field/correct {:db/id #edb/ref 17592186278940} :answer-field/id #uuid "e17aea6f-d602-5f51-a2f7-34b15c79c4b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281226}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9b4076e3-ab6e-5bdd-85c0-2781a4c652d0" :question/math-academy-id "q-162977" :question/problem "The lamina $D=\\{(x,y)\\,:\\,1\\le y\\le 3,\\,1\\le x\\le {e}^{y}\\}$ has the mass density function $\\lambda (x,y)=\\frac{1}{xy}.$ Find the moment of the lamina about the $x$-axis." :question/worked-solution "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $x$-axis is given by\n\n$$\n{M}_{x}={∬}_{D}y\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type II plane region and $\\lambda (x,y)=\\frac{1}{xy}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{x} & ={∬}_{D}y\\cdot \\frac{1}{xy}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{1}{x}\\,\\text{d}A \\\\  & ={\\int }_{1}^{3}{\\int }_{1}^{{e}^{y}}\\frac{1}{x}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}[\\operatorname{ln}⁡x]_{x=1}^{x={e}^{y}}\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}y\\,\\text{d}y \\\\  & ={[\\frac{{y}^{2}}{2}]}_{y=1}^{y=3} \\\\  & =\\frac{1}{2}(9-1) \\\\  & =4.\\end{aligned}\n$$"} :step/id #uuid "e84e8b2b-1d47-5a7c-a608-fa747bd1a9cf" :step/next {:db/id #edb/ref 17592186508117}} {:db/id #edb/ref 17592186508166 :step/content {:db/id #edb/ref 17592186508061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e1b7da3-c426-532e-ac8e-720cc44224b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186507632} {:answer/id #uuid "6511608d-c3ac-5e2b-8914-4eba27b60808" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186507746} {:answer/id #uuid "6a9602ff-82fc-59fa-9526-6670ef4a4c21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186507754} {:answer/id #uuid "71ace97c-298f-5384-84e5-5cec05c12f1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186507764} {:answer/id #uuid "72c7b13e-659a-509a-a72a-ffc4f4cc555e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186507765}] :answer-field/correct {:db/id #edb/ref 17592186507632} :answer-field/id #uuid "77626c7e-6f8b-519e-9042-3f623f612a29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186507996}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "567a0e9f-c2af-5671-a94c-0c227edb1ded" :question/math-academy-id "q-163505" :question/problem "Consider the lamina that occupies the region $D=\\{(x,y)\\,:\\,0\\le x\\le \\sqrt{{y}^{3}},\\,0\\le y\\le 1\\}.$ Given that the area of the lamina is $\\frac{2}{5}$ square units, find the $y$-coordinate of its centroid." :question/worked-solution "The centroid of a lamina $D$ with area ${A}_{D}$ is given by $({x}_{c},{y}_{c}),$ where\n\n$$\n{x}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}x\\,\\,\\text{d}A,\\,{y}_{c}=\\frac{1}{{A}_{D}}{∬}_{D}y\\,\\,\\text{d}A.\n$$\n\nTherefore, the $y$-coordinate of the centroid is \n\n$$\n\\begin{aligned}{y}_{c} & =\\frac{1}{{A}_{D}}{∬}_{D}y\\,\\text{d}A \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{{y}^{3}}}y\\,\\text{d}x\\,\\text{d}y \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}y{\\int }_{0}^{\\sqrt{{y}^{3}}}\\text{d}x\\,\\text{d}y \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}y[x]_{x=0}^{x=\\sqrt{{y}^{3}}}\\,\\text{d}y \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}y\\cdot \\sqrt{{y}^{3}}\\,\\text{d}y \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}{y}^{5/2}\\,\\text{d}y \\\\  & =\\frac{5}{2}{[\\frac{2{y}^{7/2}}{7}]}_{0}^{1} \\\\  & =\\frac{5}{2}\\cdot \\frac{2}{7} \\\\  & =\\frac{5}{7}.\\end{aligned}\n$$"} :step/id #uuid "edd8ba29-7f85-5fb5-96c7-3b323408b5ac"} {:db/id #edb/ref 17592186508168 :step/content {:db/id #edb/ref 17592186508048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b78bae3-6dac-5231-bc72-0f224493d1ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186507651} {:answer/id #uuid "461dd4bf-3120-534f-903c-0f6b43aa0379" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15" :db/id #edb/ref 17592186507706} {:answer/id #uuid "5f7de461-b87c-5895-81fe-a20fba2fc2fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186507738} {:answer/id #uuid "9ee1ba58-3c47-5256-98f6-5f3213ad1570" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186507821} {:answer/id #uuid "9f938d30-ac1a-58c2-b1e4-72cbfb1471d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186507822}] :answer-field/correct {:db/id #edb/ref 17592186507822} :answer-field/id #uuid "b671f817-f30d-58d1-9ad7-bc1f02d0b0c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186508014}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1263ed3f-1cc0-53b6-a6ed-69fefa90cd2b" :question/math-academy-id "q-163164" :question/problem "A thin plate $D$ with the mass density function $\\lambda (x,y)=\\frac{15{y}^{2}}{x}$ is enclosed between the curve  $x=2-{y}^{2}$ and the line $x=1$ for $-1\\le y\\le 1.$ Find the moment of the plate about the $y$-axis." :question/worked-solution "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $y$-axis is given by\n\n$$\n{M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is a type II plane region, as shown below.\n\n![](images/6c/6c78767d03e3429551498e651d982d99b6ceb72aa73422c5205bef296c9a1754.png)\n\nSo, we have \n\n$$\nD=\\{(x,y)\\,:\\,1\\le x\\le 2-{y}^{2},\\,-1\\le y\\le 1\\}\n$$\n\nand $\\lambda (x,y)=\\frac{15{y}^{2}}{x}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{y} & ={∬}_{D}x\\cdot \\frac{15{y}^{2}}{x}\\,\\text{d}A \\\\  & ={∬}_{D}15{y}^{2}\\,\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{1}^{2-{y}^{2}}15{y}^{2}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{-1}^{1}15{y}^{2}[{\\int }_{1}^{2-{y}^{2}}\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{-1}^{1}15{y}^{2}[x]_{x=1}^{x=2-{y}^{2}}\\,\\text{d}y \\\\  & ={\\int }_{-1}^{1}15{y}^{2}(2-{y}^{2}-1)\\,\\text{d}y \\\\  & ={\\int }_{-1}^{1}15{y}^{2}-15{y}^{4}\\,\\text{d}y \\\\  & ={[5{y}^{3}-3{y}^{5}]}_{y=-1}^{y=1} \\\\  & =(5-3)-(-5+3) \\\\  & =4.\\end{aligned}\n$$"} :step/id #uuid "f8e51044-c774-57f1-9ffb-21331bca50b2" :step/next {:db/id #edb/ref 17592186508166}}] :activity/title "Moments and Centers of Mass of Plane Laminas" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186507602}]}
