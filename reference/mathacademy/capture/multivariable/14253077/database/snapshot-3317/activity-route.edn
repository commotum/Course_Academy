type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186575438}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f13e5a72-4a23-515c-ab95-f658eaa41fe0" :question/math-academy-id "q-127925" :question/problem "Simplify the statement $¬[¬(¬C)∧¬(¬D)].$" :question/worked-solution "Two negations in a row cancel each other out. So:\n\n- we can simplify $¬(¬C)$ to $C,$ and\n\n- we can also simplify $¬(¬D)$ to $D.$\n\nTherefore, the given statement can be simplified to \n\n$$\n¬(C∧D).\n$$"} :step/id #uuid "42dd9803-f0ad-5b7b-823e-bfc945ab8883" :step/next {:db/id #edb/ref 17592186575628}} {:db/id #edb/ref 17592186575670 :step/content {:db/id #edb/ref 17592186575569 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10e3ba92-001d-581a-8efa-e0ea363247ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∨¬Q)" :db/id #edb/ref 17592186574975} {:answer/id #uuid "b50e8d2a-78ab-5e65-b725-a437d03be7a5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∧¬Q" :db/id #edb/ref 17592186575271} {:answer/id #uuid "c5ba1d28-aebd-5536-a7bb-b81f72394330" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(P∧Q)" :db/id #edb/ref 17592186575301} {:answer/id #uuid "e15ba0f1-57c5-5e2d-8f08-8b5cf51951a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∨¬Q" :db/id #edb/ref 17592186575349} {:answer/id #uuid "fae61f9a-eeae-56ce-a9d4-3f4a026215ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬P∧Q" :db/id #edb/ref 17592186575398}] :answer-field/correct {:db/id #edb/ref 17592186575271} :answer-field/id #uuid "33009a3d-49a6-59b4-91d1-066dce792b69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186575440}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "84b6b965-ea41-5400-8147-e09aa89958f6" :question/math-academy-id "q-81405" :question/problem "$7$ is **not** a composite number, and $8$ is **not** a prime number.\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:7\\text{ is a composite number}$\n\n- $Q:8\\text{ is a prime number}$" :question/worked-solution "The sentence\n\n$7$ is **not** a composite number \n\ncan be expressed symbolically as $¬P.$ \n\nThe sentence\n\n$8$ is **not** a prime number \n\ncan be expressed symbolically as $¬Q.$\n\nTherefore, the sentence\n\n$7$ is **not** a composite number, and $8$ is **not** a prime number\n\ncan be expressed symbolically as $¬P∧¬Q.$"} :step/id #uuid "9093a0fe-d866-5e2e-b514-9a41354bd7a3" :step/next {:db/id #edb/ref 17592186575648}} {:db/id #edb/ref 17592186575682 :step/content {:db/id #edb/ref 17592186575572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08e920fa-af39-5ae0-bb8d-2e52d84bdd4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(¬A∨B)" :db/id #edb/ref 17592186574963} {:answer/id #uuid "49d98e5f-4e06-5bbe-9586-bb202def09e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(A∨B)" :db/id #edb/ref 17592186575076} {:answer/id #uuid "75cea7b1-6066-57ac-a6f5-2f97c028b5c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬A∨¬B" :db/id #edb/ref 17592186575165} {:answer/id #uuid "9dcde410-8322-55aa-8bc8-4472ead1f42b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A∨B" :db/id #edb/ref 17592186575221} {:answer/id #uuid "eca5a16f-6f29-5ed8-bf8e-df6b9518f30a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(A∨¬B)" :db/id #edb/ref 17592186575369}] :answer-field/correct {:db/id #edb/ref 17592186575076} :answer-field/id #uuid "c48eab92-4379-55d1-8e35-755d040a0303" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186575495}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "89850724-94bf-5f37-83b0-1aabcc5cf9cb" :question/math-academy-id "q-81366" :question/problem "Simplify the statement $¬[¬(¬A)∨¬(¬B)].$" :question/worked-solution "Two negations in a row cancel each other out. So:\n\n- we can simplify $¬(¬A)$ to $A,$ and\n\n- we can also simplify  $¬(¬B)$ to $B.$\n\nTherefore, the given statement can be simplified to \n\n$$\n¬(A∨B).\n$$"} :step/id #uuid "c88ff846-214d-564c-b98c-9961380c4582" :step/next {:db/id #edb/ref 17592186575670}} {:db/id #edb/ref 17592186575685 :step/content {:db/id #edb/ref 17592186381598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90a46bea-10a0-54f6-ac2c-0b1ff0d9c094" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186381600} {:answer/id #uuid "e462d60c-424d-5fb0-a381-1e6a09469e12" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186381601}] :answer-field/correct {:db/id #edb/ref 17592186381601} :answer-field/id #uuid "1bc65c84-9062-526a-9348-87416239d5f0" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186381599} {:answer-field/choices [{:answer/id #uuid "27e305df-97f0-5d08-8b8d-578085a3384f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186381603} {:answer/id #uuid "ebc3b38d-1a85-5fca-8105-34390a0e86c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186381604}] :answer-field/correct {:db/id #edb/ref 17592186381604} :answer-field/id #uuid "e91ff4a3-cf07-5c06-ae50-f782725f8716" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186381602} {:answer-field/choices [{:answer/id #uuid "a6ff43e8-ab91-5130-9c66-47c49f6abad6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186381606} {:answer/id #uuid "069ecaf8-52df-57fa-ab9a-064676156586" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186381607}] :answer-field/correct {:db/id #edb/ref 17592186381607} :answer-field/id #uuid "0c33e650-bd15-544e-b4e4-543645d4b90d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186381605} {:answer-field/choices [{:answer/id #uuid "5f7ec07d-8c52-59b5-bf08-7e8ede02b4c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186381609} {:answer/id #uuid "947c0f3b-3ad0-5c81-92e7-21ffbbaa2a67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186381610}] :answer-field/correct {:db/id #edb/ref 17592186381609} :answer-field/id #uuid "bc7fa4b3-d671-55a5-b19c-1105182de6e9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186381608}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22aac00f-b3c2-59cf-a645-08ce6fac9605" :question/math-academy-id "q-182397" :question/problem "Find the missing values in the following truth table:\n\n| $\\,P\\,$ | $\\,Q\\,$ | $\\,¬(P∧¬Q)\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | {{field-1}} |\n| $\\text{T}$ | $\\text{F}$ | {{field-2}} |\n| $\\text{F}$ | $\\text{T}$ | {{field-3}} |\n| $\\text{F}$ | $\\text{F}$ | {{field-4}} |" :question/worked-solution "First, we add a column for $¬Q,$ where the truth values are opposite to the corresponding values in the column for $Q.$ \n\n| $\\,P\\,$ | $\\,Q\\,$ | $\\,¬Q\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n\nThen, we add a column for $P∧¬Q.$ Remember that $P∧¬Q$ is true if both $P$ and $¬Q$ are true. \n\n| $\\,P\\,$ | $\\,Q\\,$ | $\\,¬Q\\,$ | $\\,P∧¬Q\\,$ |\n| --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n\nFinally, we add a column for $¬(P∧¬Q).$ Remember that the truth values of $¬(P∧¬Q)$ are opposite those of $P∧¬Q.$ \n\n| $\\,P\\,$ | $\\,Q\\,$ | $\\,¬Q\\,$ | $\\,P∧¬Q\\,$ | $\\,¬(P∧¬Q)\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |"} :step/id #uuid "e44f3cd9-fb0d-54e2-aa3d-92dbb20b765c"}] :activity/title "The \"Not\" Connective" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186574943}]}
