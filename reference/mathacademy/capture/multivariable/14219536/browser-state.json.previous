      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14219536/observations/step-q337230-d95ce1eb01d48284daf3.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14219536/observations/step-q337230-d95ce1eb01d48284daf3.png",
      "source_url": "https://mathacademy.com/tasks/14219536/topics/3187/review",
