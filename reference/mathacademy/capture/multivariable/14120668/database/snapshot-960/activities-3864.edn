#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186189084} :activity/id #uuid "3ed58cd9-6ef3-50be-9e26-519bae38fdf0" :activity/scope {:db/id #edb/ref 17592186049367 :topic/id #uuid "ef34739b-f46e-5073-bcb9-1acc5022fae9" :topic/math-academy-id 3864} :activity/steps [{:db/id #edb/ref 17592186189084 :step/content {:db/id #edb/ref 17592186189366 :tutorial/content "Recall that, given a random sample $X_1, X_2,\\ldots X_n$ of size $n,$ the sample mean $\\overline{X}$ is an unbiased estimator of the population mean $\\mu,$ and is defined as\n\n$$\n\\overline{X} \n= \\dfrac1n\\sum_{i=1}^n X_i .\n$$\n\nThe sample mean is an example of a **statistic**. A statistic is a random variable computed using values from a sample. Statistics are often used to estimate population parameters, although they also have other uses.\n\nLet's take a look at some other examples of statistics:\n\n- The following statistic could be used as an estimator for the population variance $\\sigma^2\\mathbin{:}$\n\n$$\n\\displaystyle\\dfrac1n \\sum_{i=1}^n (X_i - \\overline{X})^2\n$$\n\n- The following statistic could be used as an estimator for the population maximum:\n\n$$\n\\textrm{max}(X_1, X_2, \\ldots, X_n)\n$$\n\n- The following statistic could be used as an estimator for the population range:\n\n$$\n\\textrm{max}(X_1, X_2, \\ldots, X_n) - \\textrm{min}(X_1, X_2, \\ldots, X_n)\n$$\n\n- The following statistic could be used as an estimator for the population median:\n\n$$\n\\textrm{median}(X_1, X_2, \\ldots, X_n)\n$$\n\nStatistics cannot include any *unknown* population parameters. For example:\n\n- If the population mean $\\mu$ is *unknown,* then the following quantity is *not* a statistic:\n\n$$\n\\displaystyle\\dfrac1n \\sum_{i=1}^n (X_i - \\mu)^2\n$$\n\n- However, if the population parameters $\\mu$ and $\\sigma$ are *both* known, then the following quantity *is* a statistic: \n\n$$\n\\displaystyle  \\sum_{i=1}^n \\left(\\dfrac{X_i - \\mu}{\\sigma}\\right)^2\n$$\n\nFinally, since statistics are described using observations from a random sample, they are random variables and therefore have a probability distribution. The probability distribution of a statistic is called the **sampling distribution** of the statistic." :tutorial/id #uuid "ff70a4bd-af92-57e6-b4c5-ea9a746555ab" :tutorial/math-academy-id 6146 :tutorial/title "Introduction"} :step/id #uuid "01b06219-bfde-5828-aaf4-a383feda218e" :step/math-academy-id 37308 :step/next {:db/id #edb/ref 17592186189086}} {:db/id #edb/ref 17592186189085 :step/content {:db/id #edb/ref 17592186188279 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188214 :question/id #uuid "47507b72-86e2-5980-9e59-22d59c9f7279" :question/math-academy-id "e-9918"} :knowledge-point/id #uuid "8d8dc4e9-47fc-58a2-b650-d9badbcd75d5" :knowledge-point/questions [{:db/id #edb/ref 17592186188549} {:db/id #edb/ref 17592186188550} {:db/id #edb/ref 17592186416925} {:db/id #edb/ref 17592186416926} {:db/id #edb/ref 17592186416930} {:db/id #edb/ref 17592186416932}] :knowledge-point/title "Calculating Statistics"} :step/id #uuid "aa1b7f8b-cb7d-5904-94ab-e048a827a448" :step/math-academy-id 37309} {:db/id #edb/ref 17592186189086 :step/content {:db/id #edb/ref 17592186188280 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188215 :question/id #uuid "11f8e3f1-5110-5db1-83de-99d65ea76de5" :question/math-academy-id "e-9920"} :knowledge-point/id #uuid "fd3fd748-f238-59b2-badf-54b6e762836c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049697} {:db/id #edb/ref 17592186050034} {:db/id #edb/ref 17592186050606}] :knowledge-point/questions [{:db/id #edb/ref 17592186188548} {:db/id #edb/ref 17592186188565} {:db/id #edb/ref 17592186416924} {:db/id #edb/ref 17592186416927} {:db/id #edb/ref 17592186416928} {:db/id #edb/ref 17592186416929} {:db/id #edb/ref 17592186416931}] :knowledge-point/title "Identifying Statistics"} :step/id #uuid "a9b58fb6-3fb7-5c00-add5-7c258fff9f89" :step/math-academy-id 37318 :step/next {:db/id #edb/ref 17592186189085}}] :activity/title "Sampling Distributions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186188459}]}
