          "dom_id": "questionWidget-choiceLetterCircle-139806-c",
          "type": "text",
          "value": "III only",
          "html": "III only"
        },
        {
          "option": "d",
          "dom_id": "questionWidget-choiceLetterCircle-139806-d",
          "type": "text",
          "value": "I and III only",
          "html": "I and III only"
        },
        {
          "option": "e",
