#{[{:db/id #edb/ref 17592186553540 :knowledge-point/_questions [{:db/id #edb/ref 17592186166766 :knowledge-point/id #uuid "216296fc-1ce3-532f-b96c-3d352c6b6ef2" :knowledge-point/title "Differentiating an Inverse Sech Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "954ddca6-7c11-5b1b-8b70-3aec8c910b12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{x\\sqrt{1-x^{8}}}" :db/id #edb/ref 17592186553170}] :answer-field/correct {:answer/id #uuid "954ddca6-7c11-5b1b-8b70-3aec8c910b12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{x\\sqrt{1-x^{8}}}" :db/id #edb/ref 17592186553170} :answer-field/id #uuid "f46cfecc-0cc8-5cc8-9940-d2b0180183b0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186553484}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7d72fdc8-4a06-597a-b4ee-b1daf23025f9" :question/math-academy-id "q-341503" :question/problem "$$\n\nIf $y=\\frac{1}{4}\\operatorname{arsech}⁡({x}^{4}),$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}[\\frac{1}{4}\\operatorname{arsech}⁡({x}^{4})] \\\\  & =\\frac{1}{4}\\cdot [-\\frac{1}{{x}^{4}\\sqrt{1-{({x}^{4})}^{2}}}]\\cdot {({x}^{4})}^{′} \\\\  & =-\\frac{1}{4{x}^{4}\\sqrt{1-{x}^{8}}}\\cdot 4{x}^{3} \\\\  & =-\\frac{1}{x\\sqrt{1-{x}^{8}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186553527 :knowledge-point/_questions [{:db/id #edb/ref 17592186166768 :knowledge-point/id #uuid "f5e40340-35cf-50ee-8a0d-7eb873490693" :knowledge-point/title "Differentiating Inverse Reciprocal Hyperbolic Functions Using the Product and Quotient Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63425058-6c08-5e95-8aaa-fe0ae9451531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x}{\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186553080}] :answer-field/correct {:answer/id #uuid "63425058-6c08-5e95-8aaa-fe0ae9451531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x}{\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186553080} :answer-field/id #uuid "8af448d4-fd7c-5f68-b3a3-6e5b346e24e2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186553439}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "606f9c6c-5c1e-593b-8109-6427fb98d820" :question/math-academy-id "q-341553" :question/problem "$$\n\nIf $f(x)=\\operatorname{sin}⁡x\\,\\operatorname{arcsch}⁡x,$ calculate ${f}^{′}(x).$\n\n${f}^{′}(x)=\\operatorname{cos}⁡x\\cdot \\operatorname{arcsch}⁡x\\,-\\frac{1}{|x|}\\cdot $ \n{{field-1}}" :question/worked-solution "In this case, the expression for $f(x)$ is a product $u(x)\\cdot v(x)$ with $u(x)=\\operatorname{sin}⁡x$ and $v(x)=\\operatorname{arcsch}⁡x.$\n\nTherefore, we apply the product rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={(\\operatorname{sin}⁡x)}^{′}\\cdot \\operatorname{arcsch}⁡x+\\operatorname{sin}⁡x\\cdot {(\\operatorname{arcsch}⁡x)}^{′} \\\\  & =\\operatorname{cos}⁡x\\cdot \\operatorname{arcsch}⁡x\\,+\\,\\operatorname{sin}⁡x\\cdot (-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}) \\\\  & =\\operatorname{cos}⁡x\\cdot \\operatorname{arcsch}⁡x-\\frac{1}{|x|}\\cdot \\frac{\\operatorname{sin}⁡x}{\\sqrt{1+{x}^{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186553566 :knowledge-point/_questions [{:db/id #edb/ref 17592186166768 :knowledge-point/id #uuid "f5e40340-35cf-50ee-8a0d-7eb873490693" :knowledge-point/title "Differentiating Inverse Reciprocal Hyperbolic Functions Using the Product and Quotient Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0578ff56-9fb7-5619-a9b1-ed8f2ede6282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{1-x^2}" :db/id #edb/ref 17592186552874}] :answer-field/correct {:answer/id #uuid "0578ff56-9fb7-5619-a9b1-ed8f2ede6282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{1-x^2}" :db/id #edb/ref 17592186552874} :answer-field/id #uuid "586bfc89-c55e-5fa0-a3a8-3b72520ea9db" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186553416}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b39ee0b2-d875-5c07-89bc-5a93b5408c42" :question/math-academy-id "q-341558" :question/problem "$$\n\nIf $f(x)=(x+2)\\,\\operatorname{arcoth}⁡x,$ calculate ${f}^{′}(x).$\n\n${f}^{′}(x)=\\operatorname{arcoth}⁡x\\,+$ \n{{field-1}}" :question/worked-solution "In this case, the expression for $f(x)$ is a product $u(x)\\cdot v(x)$ with $u(x)=x+2$ and $v(x)=\\operatorname{arcoth}⁡x.$\n\nTherefore, we apply the product rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={(x+2)}^{′}\\cdot \\operatorname{arcoth}⁡x+(x+2)\\cdot {(\\operatorname{arcoth}⁡x)}^{′} \\\\  & =1\\cdot \\operatorname{arcoth}⁡x\\,+\\,(x+2)\\cdot (\\frac{1}{1-{x}^{2}}) \\\\  & =\\operatorname{arcoth}⁡x+\\frac{x+2}{1-{x}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186553521 :knowledge-point/_questions [{:db/id #edb/ref 17592186166766 :knowledge-point/id #uuid "216296fc-1ce3-532f-b96c-3d352c6b6ef2" :knowledge-point/title "Differentiating an Inverse Sech Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9af70380-e503-50b8-8456-a4d26ba605ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{2x+1}+\\frac{1}{\\sqrt{-x(x+1)}}" :db/id #edb/ref 17592186553182} {:answer/id #uuid "a95d1f7e-3ad0-5e4e-bba3-859fd658d6d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{2x+1}(1-\\frac{1}{\\sqrt{-x(x+1)}})" :db/id #edb/ref 17592186553208} {:answer/id #uuid "aa65b81f-556d-5759-8d4a-d96a8f580eb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{2x+1}-\\frac{1}{2\\sqrt{-x(x+1)}}" :db/id #edb/ref 17592186553213} {:answer/id #uuid "ad6f8b25-d391-5520-b35a-d57fb931c15e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{2x+1}(1+\\frac{1}{2\\sqrt{-x(x+1)}})" :db/id #edb/ref 17592186553216} {:answer/id #uuid "c5520221-3ee7-520d-9922-76e4e5d7251d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{2x+1}(1+\\frac{2}{\\sqrt{-x(x+1)}})" :db/id #edb/ref 17592186553259}] :answer-field/correct {:answer/id #uuid "ad6f8b25-d391-5520-b35a-d57fb931c15e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{2x+1}(1+\\frac{1}{2\\sqrt{-x(x+1)}})" :db/id #edb/ref 17592186553216} :answer-field/id #uuid "f6f2ed98-5841-5a83-8d7d-7fd91c809d2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553485}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5339fa9a-9297-5700-9672-1deb7e152857" :question/math-academy-id "q-95527" :question/problem "$$\n\nIf $y=\\operatorname{ln}⁡(2x+1)-\\operatorname{arsech}⁡(2x+1),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(2x+1)-\\operatorname{arsech}⁡(2x+1)) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(2x+1))-\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡(2x+1)) \\\\  & =\\frac{2}{2x+1}-(-\\frac{1}{(2x+1)\\sqrt{1-(2x+1)^{2}}})\\cdot (2x+1)^{′} \\\\  & =\\frac{2}{2x+1}+\\frac{1}{(2x+1)\\sqrt{1-4{x}^{2}-4x-1}}\\cdot 2 \\\\  & =\\frac{2}{2x+1}+\\frac{2}{(2x+1)\\sqrt{-4{x}^{2}-4x}} \\\\  & =\\frac{2}{2x+1}(1+\\frac{1}{\\sqrt{-4x(x+1)}}) \\\\  & =\\frac{2}{2x+1}(1+\\frac{1}{2\\sqrt{-x(x+1)}}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186553492 :knowledge-point/_questions [{:db/id #edb/ref 17592186166767 :knowledge-point/id #uuid "74aa4936-437c-52c6-b5ec-f175443379a7" :knowledge-point/title "Differentiating an Inverse Coth Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ea54858-c2ae-53ae-9781-af37347f2906" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+1}{x(x+2)}" :db/id #edb/ref 17592186552924} {:answer/id #uuid "3194dd52-40d1-570a-9fff-65ffcb9727e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x(x-2)}{x-1}" :db/id #edb/ref 17592186552960} {:answer/id #uuid "3231a9cb-b14f-5028-aa45-a3ff5392b25a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x(x-1)}{x-2}" :db/id #edb/ref 17592186552967} {:answer/id #uuid "9121d2d3-5c6d-59c7-9f0b-3368c8a5ced6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{x(x+1)}" :db/id #edb/ref 17592186553159} {:answer/id #uuid "c5d4d527-999d-55f5-b426-2b767c18a438" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-1}{x(x-2)}" :db/id #edb/ref 17592186553261}] :answer-field/correct {:answer/id #uuid "c5d4d527-999d-55f5-b426-2b767c18a438" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-1}{x(x-2)}" :db/id #edb/ref 17592186553261} :answer-field/id #uuid "6f7deaea-aba3-52f7-9886-400b1832e9bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553428}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0801b610-a1ee-5624-88f2-98b242787497" :question/math-academy-id "q-95539" :question/problem "$$\n\nIf $y=\\operatorname{ln}⁡(x-2)+\\operatorname{arcoth}⁡(x-1),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(x-2)+\\operatorname{arcoth}⁡(x-1)) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(x-2))+\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡(x-1)) \\\\  & =\\frac{1}{x-2}+\\frac{1}{1-(x-1)^{2}}\\cdot (x-1)^{′} \\\\  & =\\frac{1}{x-2}+\\frac{1}{1-({x}^{2}-2x+1)}\\cdot 1 \\\\  & =\\frac{1}{x-2}+\\frac{1}{2x-{x}^{2}} \\\\  & =\\frac{1}{x-2}-\\frac{1}{x(x-2)} \\\\  & =\\frac{1}{x-2}(1-\\frac{1}{x}) \\\\  & =\\frac{x-1}{x(x-2)}.\\end{aligned}\n$$"}]}
