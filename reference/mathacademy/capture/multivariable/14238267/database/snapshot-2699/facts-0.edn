6045417] [17592186557172 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186557172 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186557172 #edb/ref 1078 #edb/ref 17592186556889 #edb/ref 17592186045417] [17592186557172 #edb/ref 1079 #uuid "becc477c-1df6-5756-8837-a73d10338340" #edb/ref 17592186045417] [17592186557205 #edb/ref 1075 #edb/ref 17592186556542 #edb/ref 17592186045417] [17592186557205 #edb/ref 1075 #edb/ref 17592186556631 #edb/ref 17592186045417] [17592186557205 #edb/ref 1075 #edb/ref 17592186556697 #edb/ref 17592186045417] [17592186557205 #edb/ref 1075 #edb/ref 17592186556888 #edb/ref 17592186045417] [17592186557205 #edb/ref 1075 #edb/ref 17592186557049 #edb/ref 17592186045417] [17592186557205 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186557205 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186557205 #edb/ref 1078 #edb/ref 17592186556542 #edb/ref 17592186045417] [17592186557205 #edb/ref 1079 #uuid "f640bd4e-d214-5668-a628-34c871dc6526" #edb/ref 17592186045417] [17592186557215 #edb/ref 1068 #edb/ref 17592186557099 #edb/ref 17592186045417] [17592186557215 #edb/ref 1069 "q-11480" #edb/ref 17592186045417] [17592186557215 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186557215 #edb/ref 1071 "Consider the finite region bounded by the curve $y={x}^{2}-{x}^{3}$ and the $x$-axis. Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis." #edb/ref 17592186045417] [17592186557215 #edb/ref 1072 #uuid "1d2ad0a0-cc2c-5c3a-a170-bcfe4847272e" #edb/ref 17592186045417] [17592186557215 #edb/ref 1074 "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}{x}^{2}-{x}^{3} & =0 \\\\ {x}^{2}(1-x) & =0\\end{aligned}\n$$\n\nThe solutions are  $x=0$ and  $x=1.$ So, we need to integrate from $x=0$ to $x=1.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}x({x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}({x}^{3}-{x}^{4})\\text{d}x \\\\  & ={2\\pi (\\frac{{x}^{4}}{4}\\text{ }-\\frac{{x}^{5}}{5})|}_{0}^{1} \\\\  & =2\\pi [(\\frac{1}{4}-\\frac{1}{5})-0] \\\\  & =2\\pi (\\frac{1}{20}) \\\\  & =\\frac{\\pi }{10}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186557256 #edb/ref 1068 #edb/ref 17592186557098 #edb/ref 17592186045417] [17592186557256 #edb/ref 1069 "q-352256" #edb/ref 17592186045417] [17592186557256 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186557256 #edb/ref 1071 "Consider the finite region bounded by the curve $y=x-3{x}^{2}$ and the $x$-axis. Calculate the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" #edb/ref 17592186045417] [17592186557256 #edb/ref 1072 #uuid "64dd5dee-1a80-5aec-aff5-ee2daf8b8dbf" #edb/ref 17592186045417] [17592186557256 #edb/ref 1074 "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}x-3{x}^{2} & =0 \\\\ x(1-3x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=\\frac{1}{3}.$ So, we need to integrate from $x=0$ to $x=\\frac{1}{3}.$  \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1/3}x(x-3{x}^{2})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1/3}({x}^{2}-3{x}^{3})\\text{d}x \\\\  & =2\\pi {(\\frac{{x}^{3}}{3}-\\frac{3{x}^{4}}{4})|}_{0}^{1/3} \\\\  & =2\\pi [(\\frac{1}{3\\cdot {3}^{3}}-\\frac{3}{4\\cdot {3}^{4}})-0] \\\\  & =2\\pi (\\frac{1}{324}) \\\\  & =\\frac{\\pi }{162}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186557266 #edb/ref 1068 #edb/ref 17592186557205 #edb/ref 17592186045417] [17592186557266 #edb/ref 1069 "q-139201" #edb/ref 17592186045417] [17592186557266 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186557266 #edb/ref 1071 "![](images/78/780120c106065874c04d97b8b6ef10e3e81e1cf9fd7c7b19bc633963cbadafe4.png)\n\nConsider the finite region bounded by the curves $y=4x-2{x}^{2}$ and $y=2{x}^{3},$ as shown above. Find an integral expression for the volume generated when this region is rotated $2\\pi $ radians about the $y$-axis." #edb/ref 17592186045417] [17592186557266 #edb/ref 1072 #uuid "6fc2e8c7-fc0f-5be7-9a14-96326d528b23" #edb/ref 17592186045417] [17592186557266 #edb/ref 1074 "First, let $f(x)=4x-2{x}^{2}$ and $g(x)=2{x}^{3}.$\n\nWe start by determining the points where the curves intersect by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ 4x-2{x}^{2} & =2{x}^{3} \\\\ 4x-2{x}^{2}-2{x}^{3} & =0 \\\\ -2x(-2+x+{x}^{2}) & =0 \\\\ x(x-1)(x+2) & =0\\end{aligned}\n$$\n\nThe solutions are $x=-2,$ $x=0,$  and $x=1.$ So, we need to integrate from $x=0$ to $x=1$ because we are only concerned about $x\\ge 0.$ \n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/e6/e695cfd83116df98b1530e2d53186de0ebcd03c6056c2b8d7c2272a76fbd790c.png)\n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=g(x)=2{x}^{3},$ and\n\n- *leaves* through the upper function $y=f(x)=4x-2{x}^{2}.$\n\nTherefore, using the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}x([4x-2{x}^{2}]-[2{x}^{3}])\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}x(4x-2{x}^{2}-2{x}^{3})\\text{d}x \\\\  & =4\\pi {\\int }_{0}^{1}(2{x}^{2}-{x}^{3}-{x}^{4})\\text{d}x\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186557302 #edb/ref 1068 #edb/ref 17592186557086 #edb/ref 17592186045417] [17592186557302 #edb/ref 1069 "q-139276" #edb/ref 17592186045417] [17592186557302 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186557302 #edb/ref 1071 "![](images/a9/a9db1a85c150c0bd6a8913a19387c7c717103cff1faf5266c7e21e774ab193ab.png)\n\nConsider the finite region bounded by the curves $y=-{x}^{2}+2x+1$ and $y={x}^{2}+1,$ as shown above. Find an integral expression for the volume generated when this region is rotated $2\\pi $ radians about the $y$-axis." #edb/ref 17592186045417] [17592186557302 #edb/ref 1072 #uuid "c1c69fb5-f0aa-5c39-a555-57a6bac7db2e" #edb/ref 17592186045417] [17592186557302 #edb/ref 1074 "First, let $f(x)=-{x}^{2}+2x+1$ and $g(x)={x}^{2}+1.$\n\nWe start by determining the points where the curves intersect by solving the following equation for $x:$\n\n$$\n\\begin{aligned}f(x) & =g(x) \\\\ -{x}^{2}+2x+1 & ={x}^{2}+1 \\\\ -2{x}^{2}+2x & =0 \\\\ -2x(x-1) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0,$ and $x=1.$ So, we need to integrate from $x=0$ to $x=1.$  \n\nNow, let's draw our usual vertical arrow through the region to determine the lower and upper functions.\n\n![](images/87/8790ae667c9a2741e2a732ff69d9afe5633dc26df7b02eee52fb51478524282b.png)\n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=g(x)={x}^{2}+1,$ and\n\n- *leaves* through the upper function $y=f(x)=-{x}^{2}+2x+1.$\n\nTherefore, using the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x([\\text{upper}]-[\\text{lower}])\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}x([-{x}^{2}+2x+1]-[{x}^{2}+1])\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{1}x(2x-2{x}^{2})\\text{d}x \\\\  & =4\\pi {\\int }_{0}^{1}({x}^{2}-{x}^{3})\\text{d}x\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186557312 #edb/ref 1068 #edb/ref 17592186557172 #edb/ref 17592186045417] [17592186557312 #edb/ref 1069 "q-11481" #edb/ref 17592186045417] [17592186557312 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186557312 #edb/ref 1071 "![](images/63/63bc2b3795556cd1f1b3b5b63c8d92816f64edcad364664db25acc0a7cc59b9e.png)\n\nConsider the finite region bounded by the curve $y=3{x}^{2}-{x}^{3}$ and the $x$-axis, shown above. What integral gives the volume of the solid generated when this region is rotated $2\\pi $ radians about the $y$-axis?" #edb/ref 17592186045417] [17592186557312 #edb/ref 1072 #uuid "cc5e2afa-3b34-5a5a-87d2-86576b259f97" #edb/ref 17592186045417] [17592186557312 #edb/ref 1074 "First, we determine the points where the curve intersects the $x$-axis by solving the following equation for $x:$\n\n$$\n\\begin{aligned}3{x}^{2}-{x}^{3} & =0 \\\\ {x}^{2}(3-x) & =0\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=3.$ So, we need to integrate from $x=0$ to $x=3.$  \n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{a}^{b}x\\,f(x)\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{3}x(3{x}^{2}-{x}^{3})\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{3}(3{x}^{3}-{x}^{4})\\text{d}x\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186557349 #edb/ref 1058 #edb/ref 17592186557355 #edb/ref 17592186045417] [17592186557349 #edb/ref 1062 #uuid "33505734-d9d3-5b43-ae80-e3a496f5ae08" #edb/ref 17592186045417] [17592186557349 #edb/ref 1063 #edb/ref 17592186557302 #edb/ref 17592186045417] [17592186557354 #edb/ref 1058 #edb/ref 17592186557365 #edb/ref 17592186045417] [17592186557354 #edb/ref 1062 #uuid "3fabfb31-ba4d-5286-ae69-a7ab6909a969" #edb/ref 17592186045417] [17592186557354 #edb/ref 1063 #edb/ref 17592186557215 #edb/ref 17592186045417] [17592186557355 #edb/ref 1062 #uuid "4178bcb0-dd69-588c-bb6e-e7bbae7e2e7c" #edb/ref 17592186045417] [17592186557355 #edb/ref 1063 #edb/ref 17592186557256 #edb/ref 17592186045417] [17592186557365 #edb/ref 1058 #edb/ref 17592186557378 #edb/ref 17592186045417] [17592186557365 #edb/ref 1062 #uuid "6edba391-8597-52e1-b1c5-ab751b3434bc" #edb/ref 17592186045417] [17592186557365 #edb/ref 1063 #edb/ref 17592186557312 #edb/ref 17592186045417] [17592186557378 #edb/ref 1058 #edb/ref 17592186557349 #edb/ref 17592186045417] [17592186557378 #edb/ref 1062 #uuid "8e1f6b4c-2b0c-5f76-b13b-1f43a0ca1120" #edb/ref 17592186045417] [17592186557378 #edb/ref 1063 #edb/ref 17592186557266 #edb/ref 17592186045417]}
