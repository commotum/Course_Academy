      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14238267/observations/step-q11481-d022550b21a275a3929e.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14238267/observations/step-q11481-d022550b21a275a3929e.png",
      "source_url": "https://mathacademy.com/tasks/14238267/topics/1084/review",
