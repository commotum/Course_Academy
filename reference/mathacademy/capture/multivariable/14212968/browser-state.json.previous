      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q53195-082b05c824e1d7f3f0b2.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q53195-082b05c824e1d7f3f0b2.png",
      "source_url": "https://mathacademy.com/tasks/14212968/topics/369/lesson",
      "captured_at": 1792003405.7819433,
      "math_academy_id": "q-53195",
      "topic_id": "369",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q53195",
        "placement_id": null,
        "content_id": null,
