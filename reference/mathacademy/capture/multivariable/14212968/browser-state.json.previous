      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q83679-8fcd77a5e4c44eeabf56.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q83679-8fcd77a5e4c44eeabf56.png",
      "source_url": "https://mathacademy.com/tasks/14212968/topics/369/lesson",
      "captured_at": 1792003506.3333714,
      "math_academy_id": "q-83679",
      "topic_id": "369",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q83679",
