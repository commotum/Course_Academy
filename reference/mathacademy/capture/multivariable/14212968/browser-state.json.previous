      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q121763-208ea987d010331b140a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q121763-208ea987d010331b140a.png",
      "source_url": "https://mathacademy.com/tasks/14212968/topics/369/lesson",
      "captured_at": 1792003649.5324543,
      "math_academy_id": "q-121763",
