      ],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q343159-aaf935d9d6ad01f8ea7d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q343159-aaf935d9d6ad01f8ea7d.png",
      "source_url": "https://mathacademy.com/tasks/14212968/topics/369/lesson",
      "captured_at": 1792003551.312192,
      "math_academy_id": "q-343159",
      "topic_id": "369",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q343159",
        "placement_id": null,
        "content_id": null,
