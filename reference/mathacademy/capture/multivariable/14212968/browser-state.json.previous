          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:40px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"34\"><span class=\"mq-fraction mq-non-leaf\" mathquill-command-id=\"36\"><span class=\"mq-numerator\" mathquill-block-id=\"38\"><span mathquill-command-id=\"37\">1</span></span><span class=\"mq-denominator\" mathquill-block-id=\"40\"><span mathquill-command-id=\"39\">4</span><span mathquill-command-id=\"41\">0</span></span><span style=\"display:inline-block;width:0\">​</span></span></span></div></div>",
