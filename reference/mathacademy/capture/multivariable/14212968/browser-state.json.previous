          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:90px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"1\"><span mathquill-command-id=\"3\" class=\"\">−</span><span mathquill-command-id=\"5\">1</span><span mathquill-command-id=\"7\">.</span><span mathquill-command-id=\"9\">2</span><var mathquill-command-id=\"12\" class=\"mq-operator-name mq-first\">c</var><var mathquill-command-id=\"13\" class=\"mq-operator-name\">s</var><var mathquill-command-id=\"14\" class=\"mq-operator-name\">c</var><span class=\"mq-supsub mq-non-leaf mq-sup-only\" mathquill-command-id=\"16\"><span class=\"mq-sup\" mathquill-block-id=\"18\"><span mathquill-command-id=\"17\">2</span></span></span><span mathquill-command-id=\"20\">(</span><var mathquill-command-id=\"22\">θ</var><span mathquill-command-id=\"24\">)</span></span></div></div>",
          "rendered_text": "−1.2csc2(θ)",
