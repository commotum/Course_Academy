          "dom_index": 0,
          "disabled": false,
          "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:40px;\n                                        margin-left:2px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"26\"><span mathquill-command-id=\"28\">3</span><span mathquill-command-id=\"30\">0</span><span class=\"mq-nonSymbola\" mathquill-command-id=\"32\">π</span></span></div></div>",
          "rendered_text": "30π",
