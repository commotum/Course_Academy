          "render_ready": true,
          "path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/assets/b4b48ffa8202e15042190b98b8fc11bb02bc06547abcfbfba87b1433e5161d9b.png",
