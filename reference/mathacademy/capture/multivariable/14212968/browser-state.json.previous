      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q314884-d594db346af10f0946a1.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q314884-d594db346af10f0946a1.png",
      "source_url": "https://mathacademy.com/tasks/14212968/topics/369/lesson",
      "captured_at": 1792003484.133505,
      "math_academy_id": "q-314884",
