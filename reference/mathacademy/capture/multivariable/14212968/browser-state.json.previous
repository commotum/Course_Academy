      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q2910-6f4ec114bcd6a35677dc.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q2910-6f4ec114bcd6a35677dc.png",
      "source_url": "https://mathacademy.com/tasks/14212968/topics/369/lesson",
      "captured_at": 1792003580.7255695,
      "math_academy_id": "q-2910",
