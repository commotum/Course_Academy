      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q86352-7427dd3a75813ab1f240.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q86352-7427dd3a75813ab1f240.png",
      "source_url": "https://mathacademy.com/tasks/14212968/topics/369/lesson",
      "captured_at": 1792003626.1765666,
      "math_academy_id": "q-86352",
      "topic_id": "369",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q86352",
