      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q83678-e661b329576a37124733.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q83678-e661b329576a37124733.png",
      "source_url": "https://mathacademy.com/tasks/14212968/topics/369/lesson",
      "captured_at": 1792003461.3427336,
      "math_academy_id": "q-83678",
      "topic_id": "369",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q83678",
        "placement_id": null,
