      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q121345-4ae83ab8fc650ccaa191.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14212968/observations/step-q121345-4ae83ab8fc650ccaa191.png",
      "source_url": "https://mathacademy.com/tasks/14212968/topics/369/lesson",
      "captured_at": 1792003361.4003055,
