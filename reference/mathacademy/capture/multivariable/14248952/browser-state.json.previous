iant=\"normal\">Δ</mi><msub><mi>x</mi><mn>2</mn></msub><mo>+</mo><mo>⋯</mo><mo>+</mo><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mi>m</mi></msub><mo>+</mo><msub><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy=\"false\">)</mo><mi mathvariant=\"normal\">Δ</mi><msub><mi>x</mi><mi>n</mi></msub></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mn>1</mn></msub><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>+</mo><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><msub><mi>x</mi><mn>0</mn></msub><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mn>1</mn></msub><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>−</mo><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><msub><mi>x</mi><mn>0</mn></msub><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>+</mo><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mn>2</mn></msub><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>+</mo><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><msub><mi>x</mi><mn>1</mn></msub><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mn>2</mn></msub><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>−</mo><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><msub><mi>x</mi><mn>1</mn></msub><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>+</mo><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>⋯</mo><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>+</mo><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mi>m</mi></msub><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>+</mo><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><msub><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><msub><mi>x</mi><mi>m</mi></msub><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><mo>−</mo><mstyle scriptlevel=\"0\"><mspace width=\"-0.167em\"></mspace></mstyle><msub><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><msubsup><mi>x</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>x</mi><mn>0</mn><mn>2</mn></msubsup><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><msubsup><mi>x</mi><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>x</mi><mn>1</mn><mn>2</mn></msubsup><mo stretchy=\"false\">)</mo><mo>+</mo><mo>⋯</mo><mo>+</mo><mo stretchy=\"false\">(</mo><msubsup><mi>x</mi><mi>m</mi><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo stretchy=\"false\">(</mo><menclose notation=\"updiagonalstrike\"><msubsup><mi>x</mi><mn>1</mn><mn>2</mn></msubsup></menclose><mo>−</mo><msubsup><mi>x</mi><mn>0</mn><mn>2</mn></msubsup><mo stretchy=\"false\">)</mo><mo>+</mo><mo stretchy=\"false\">(</mo><menclose notation=\"updiagonalstrike\"><msubsup><mi>x</mi><mn>2</mn><mn>2</mn></msubsup></menclose><mo>−</mo><menclose notation=\"updiagonalstrike\"><msubsup><mi>x</mi><mn>1</mn><mn>2</mn></msubsup></menclose><mo stretchy=\"false\">)</mo><mo>+</mo><mo>⋯</mo><mo>+</mo><mo stretchy=\"false\">(</mo><msubsup><mi>x</mi><mi>m</mi><mn>2</mn></msubsup><mo>−</mo><menclose notation=\"updiagonalstrike\"><msubsup><mi>x</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup></menclose><mo stretchy=\"false\">)</mo></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><msubsup><mi>x</mi><mn>0</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>x</mi><mi>m</mi><mn>2</mn></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msubsup><mi>x</mi><mi>m</mi><mn>2</mn></msubsup><mo>−</mo><msubsup><mi>x</mi><mn>0</mn><mn>2</mn></msubsup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><msup><mn>2</mn><mn>2</mn></msup><mo>−</mo><msup><mn>0</mn><mn>2</mn></msup></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>4</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Combining our results, we finally arrive at</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"155\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-munderover space=\"2\"><mjx-over style=\"padding-bottom: 0.192em; padding-left: 0.412em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D45A TEX-I\"></mjx-c></mjx-mi></mjx-over><mjx-box><mjx-munder><mjx-row><mjx-base><mjx-mo class=\"mjx-lop\"><mjx-c class=\"mjx-c2211 TEX-S2\"></mjx-c></mjx-mo></mjx-base></mjx-row><mjx-row><mjx-under style=\"padding-top: 0.167em; padding-left: 0.148em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D456 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-texatom></mjx-under></mjx-row></mjx-munder></mjx-box></mjx-munderover><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"><