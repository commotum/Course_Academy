2}-{x}_{0}^{2})+({x}_{2}^{2}-{x}_{1}^{2})+⋯+({x}_{m}^{2}-{x}_{m-1}^{2}) \\\\  & =(\\cancel{{x}_{1}^{2}}-{x}_{0}^{2})+(\\cancel{{x}_{2}^{2}}-\\cancel{{x}_{1}^{2}})+⋯+({x}_{m}^{2}-\\cancel{{x}_{m-1}^{2}}) \\\\  & =-{x}_{0}^{2}+{x}_{m}^{2} \\\\  & ={x}_{m}^{2}-{x}_{0}^{2} \\\\  & =(-1)^{2}-(-3)^{2} \\\\  & =-8\\end{aligned}\n$$\n\nCombining our results, we finally arrive at\n\n$$\n-2{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}\\cdot {\\sum }_{j=1}^{n}Δ{y}_{j}=(-2)\\cdot (-8)\\cdot 3=48.\n$$"}] [{:db/id #edb/ref 17592186180267 :knowledge-point/_questions [{:db/id #edb/ref 17592186179722 :knowledge-point/id #uuid "9f913fab-d0b5-5e9e-b292-039afe4a148c" :knowledge-point/title "Computing a Double Sum Over a Rectangular Partition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98306fc0-a472-5425-9bb0-17720fbc4641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186179147} {:answer/id #uuid "cc621d40-d3ea-5257-a80f-61bedbd04a45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186179148} {:answer/id #uuid "dec086f0-103c-591b-a47b-81dfdf7f507e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186179149} {:answer/id #uuid "e6e7e96f-2f3c-58e3-8e58-ea80bd064c51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186179150} {:answer/id #uuid "7b55bca8-d2bc-5f6c-8bbd-e2b88022768c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186179151}] :answer-field/id #uuid "e7a3ae0c-1a08-5a16-9188-dce2ab112a74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186179146}] :question/id #uuid "b8ba4a0f-f607-55a9-9beb-85f51bad2770" :question/math-academy-id "q-72128" :