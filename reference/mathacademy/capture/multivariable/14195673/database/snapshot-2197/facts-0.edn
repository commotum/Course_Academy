db/ref 17592186510023 #edb/ref 17592186045417] [17592186510336 #edb/ref 1075 #edb/ref 17592186510119 #edb/ref 17592186045417] [17592186510336 #edb/ref 1075 #edb/ref 17592186510131 #edb/ref 17592186045417] [17592186510336 #edb/ref 1075 #edb/ref 17592186510191 #edb/ref 17592186045417] [17592186510336 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186510336 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186510336 #edb/ref 1078 #edb/ref 17592186510023 #edb/ref 17592186045417] [17592186510336 #edb/ref 1079 #uuid "bda027a4-fbea-5ab2-9b7c-09170115f2b8" #edb/ref 17592186045417] [17592186510383 #edb/ref 1068 #edb/ref 17592186510264 #edb/ref 17592186045417] [17592186510383 #edb/ref 1069 "q-149431" #edb/ref 17592186045417] [17592186510383 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186510383 #edb/ref 1071 "The table below gives the values of a positive, continuous function $f(x)$ over the closed interval $[1,11].$ \nUsing a left Riemann sum with $5$ equal subintervals, estimate the volume of the solid generated when the region bounded by the curve $y=f(x),$ the $x$-axis, and the vertical lines $x=1$ and $x=11$ is rotated $2\\pi $ radians about the $x$-axis.\n\n| $x$ | $1$ | $3$ | $5$ | $7$ | $9$ | $11$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $1$ | $\\sqrt{2}$ | $0$ | $1$ | $3$ | $2$ |\n\n*Hint: The volume of the solid generated when the region bounded by a curve $y=f(x),$ the $x$-axis, and the vertical lines $x=a$ and $x=b$ is rotated $2\\pi $ radians about the $x$-axis is given by*\n\n$$\nV=\\pi {\\int }_{a}^{b}[f(x)]^{2}\\,\\text{d}x.\n$$" #edb/ref 17592186045417] [17592186510383 #edb/ref 1072 #uuid "3dca0c4b-ab3e-5cab-b892-e8bf877045ac" #edb/ref 17592186045417] [17592186510383 #edb/ref 1074 "Using the hint, the volume of the solid generated when the region bounded by a curve $y=f(x),$ the $x$-axis, and the vertical lines $x=1$ and $x=11$ is rotated $2\\pi $ radians about the $x$-axis is given by\n\n$$\nV=\\pi {\\int }_{1}^{11}[f(x)]^{2}\\,\\text{d}x.\n$$\n\nLet $g(x)={(f(x))}^{2}.$ The (regular) step size $Δx$ is given by \n\n$$\nΔx=\\frac{11-1}{5}=2.\n$$\n\nWe can approximate the integral above using a *left* Riemann sum with $5$ equal subintervals and step size $Δx$ as follows:\n\n$$\n\\pi {\\int }_{1}^{11}g(x)\\,\\text{d}x≈\\pi \\cdot (g(1)+g(3)+g(5)+g(7)+g(9))\\cdot Δx\n$$\n\nWe set up a table with values of $g(x)$ at each point:\n\n| $x$ | $1$ | $3$ | $5$ | $7$ | $9$ | $11$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $1$ | $\\sqrt{2}$ | $0$ | $1$ | $3$ | $2$ |\n| $g(x)={(f(x))}^{2}$ | $1$ | $2$ | $0$ | $1$ | $9$ | $4$ |\n\nFinally, we obtain the following approximation for our volume:\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{1}^{11}g(x)\\,\\text{d}x \\\\  & ≈\\pi \\cdot (g(1)+g(3)+g(5)+g(7)+g(9))\\cdot Δx \\\\  & =\\pi \\cdot (1+2+0+1+9)\\cdot 2 \\\\  & =\\pi \\cdot 13\\cdot 2 \\\\  & =26\\pi \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186510395 #edb/ref 1068 #edb/ref 17592186510336 #edb/ref 17592186045417] [17592186510395 #edb/ref 1069 "q-149505" #edb/ref 17592186045417] [17592186510395 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186510395 #edb/ref 1071 "Let $f(x)$ be negative and strictly increasing for $x\\in [0,1],$ and differentiable for $x\\in (0,1).$ Suppose we approximate the area under the curve $y=g(x)=({x}^{2}-2)\\cdot f(x)$ over the interval $[0,1]$ using a right Riemann sum. Given that $g(x)>0,$ which of the following statements must be true?\n\nI. ${f}^{′}(x)>0$\n\nII. ${g}^{′}(x)>0$\n\nIII. The Riemann sum underestimates the true area." #edb/ref 17592186045417] [17592186510395 #edb/ref 1072 #uuid "597bb006-761e-5b6e-a002-be65431d8129" #edb/ref 17592186045417] [17592186510395 #edb/ref 1074 "We're given that $g(x)=({x}^{2}-2)\\cdot f(x)>0.$ Now, recall the following:\n\n- If $g(x)$ is strictly increasing, the right Riemann sum gives an *overestimate* of the area under the curve $y=g(x).$\n\n- If $g(x)$ is strictly decreasing, the right Riemann sum gives an *underestimate* of the area under the curve $y=g(x).$\n\nLet's now consider each statement in turn:\n\n- Statement I is true. Since $f(x)$ is strictly increasing, we have ${f}^{′}(x)>0.$\n\n- Statement II is false. Differentiating $g(x)=({x}^{2}-2)\\cdot f(x),$ we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =({x}^{2}-2)^{′}\\cdot f(x)+({x}^{2}-2)\\cdot {f}^{′}(x) \\\\  & =2x\\cdot f(x)+({x}^{2}-2)\\cdot {f}^{′}(x).\\end{aligned}\n$$\n\nNow, since $f(x)$ is negative and strictly increasing over the interval $(0,1),$ we have \n\n$$\n2x>0,\\,f(x)<0,\\,{x}^{2}-2<0,\\,{f}^{′}(x)>0.\n$$\n\nHence, we obtain\n\n$$\n{g}^{′}(x)={{2x}_{⏟}}_{>0}\\cdot {{f(x)}_{⏟}}_{<0}+{{({x}^{2}-2)}_{⏟}}_{<0}\\cdot {{{f}^{′}(x)}_{⏟}}_{>0}={{2x\\cdot f(x)}_{⏟}}_{<0}+\\,{{{x}^{2}\\cdot {f}^{′}(x)}_{⏟}}_{<0}<0.\n$$\n\n- Statement III is true. Since ${g}^{′}(x)<0,$ the function $g(x)$ is strictly decreasing. Therefore, the right Riemann sum gives an *underestimate* of the area under the curve $y=({x}^{2}-2)\\cdot f(x).$\n\nTherefore, the correct answer is \"I and III only.\"" #edb/ref 17592186045417] [17592186510422 #edb/ref 1068 #edb/ref 17592186510284 #edb/ref 17592186045417] [17592186510422 #edb/ref 1069 "q-149458" #edb/ref 17592186045417] [17592186510422 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186510422 #edb/ref 1071 "The table below gives the values of a positive, continuous function $f(x)$ and its derivative ${f}^{′}(x)$ over the closed interval $[0,9].$\nUsing a left Riemann sum with $3$ equal subintervals, estimate the arc length of the curve $y=f(x)$ between $x=0$ and $x=9.$\n\n| $x$ | $0$ | $3$ | $6$ | $9$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $1$ | $2$ | $7$ | $10$ |\n| ${f}^{′}(x)$ | $2\\sqrt{2}$ | $0$ | $4\\sqrt{3}$ | $\\sqrt{3}$ |\n\n*Hint: The arc length of a smooth curve $y=f(x)$ between $x=a$ and $x=b$ is given by*\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$" #edb/ref 17592186045417] [17592186510422 #edb/ref 1072 #uuid "8b473789-e487-5a61-80e6-ac184764ee91" #edb/ref 17592186045417] [17592186510422 #edb/ref 1074 "Using the hint, we have that the arc length of a curve $y=f(x)$ between $x=0$ and $x=9$ is given by\n\n$$\nL={\\int }_{0}^{9}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nLet $g(x)=\\sqrt{1+[{f}^{′}(x)]^{2}}.$ The (regular) step size $Δx$ is given by \n\n$$\nΔx=\\frac{9-0}{3}=3.\n$$\n\nWe can approximate the integral above using a *left* Riemann sum with $3$ equal subintervals and step size $Δx$ as follows:\n\n$$\n{\\int }_{0}^{9}g(x)\\,\\text{d}x≈(g(0)+g(3)+g(6)\\cdot Δx\n$$\n\nNow, we set up a table with values of $g(x)$ at each point:\n\n| $x$ | $0$ | $3$ | $6$ | $9$ |\n| --- | --- | --- | --- | --- |\n| ${f}^{′}(x)$ | $2\\sqrt{2}$ | $0$ | $4\\sqrt{3}$ | $\\sqrt{3}$ |\n| $g(x)=\\sqrt{1+[{f}^{′}(x)]^{2}}$ | $3$ | $1$ | $7$ | $2$ |\n\nFinally, we obtain the following approximation for our arc length:\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{9}g(x)\\,\\text{d}x \\\\  & ≈(g(0)+g(3)+g(6))\\cdot Δx \\\\  & =(3+1+7)\\cdot 3 \\\\  & =11\\cdot 3 \\\\  & =33\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186510425 #edb/ref 1068 #edb/ref 17592186510297 #edb/ref 17592186045417] [17592186510425 #edb/ref 1069 "q-149419" #edb/ref 17592186045417] [17592186510425 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186510425 #edb/ref 1071 "The table below gives the values of a positive, continuous function $f(x)$ over the closed interval $[0,15].$ \nUsing a right Riemann sum with $5$ equal subintervals, estimate the volume of the solid generated when the region bounded by the curve $y=f(x),$ the $x$-axis, and the vertical lines $x=0$ and $x=15$ is rotated $2\\pi $ radians about the $x$-axis.\n\n| $x$ | $0$ | $3$ | $6$ | $9$ | $12$ | $15$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $3$ | $2$ | $\\sqrt{3}$ | $0$ | $2\\sqrt{2}$ | $1$ |\n\n*Hint: The volume of the solid generated when the region bounded by a curve $y=f(x),$ the $x$-axis, and the vertical lines $x=a$ and $x=b$ is rotated $2\\pi $ radians about the $x$-axis is given by*\n\n$$\nV=\\pi {\\int }_{a}^{b}[f(x)]^{2}\\,\\text{d}x.\n$$" #edb/ref 17592186045417] [17592186510425 #edb/ref 1072 #uuid "95ecf8d2-2252-5516-85e1-ebd3d6544d2a" #edb/ref 17592186045417] [17592186510425 #edb/ref 1074 "Using the hint, the volume of the solid generated when the region bounded by a curve $y=f(x),$ the $x$-axis, and the vertical lines $x=0$ and $x=15$ is rotated $2\\pi $ radians about the $x$-axis is given by\n\n$$\nV=\\pi {\\int }_{0}^{15}[f(x)]^{2}\\,\\text{d}x.\n$$\n\nLet $g(x)={(f(x))}^{2}.$ The (regular) step size $Δx$ is given by \n\n$$\nΔx=\\frac{15-0}{5}=3.\n$$\n\nWe can approximate the integral above using a *right* Riemann sum with $5$ equal subintervals and step size $Δx$ as follows:\n\n$$\n\\pi {\\int }_{0}^{15}g(x)\\,\\text{d}x≈\\pi \\cdot (g(3)+g(6)+g(9)+g(12)+g(15))\\cdot Δx\n$$\n\nWe set up a table with values of $g(x)$ at each point:\n\n| $x$ | $0$ | $3$ | $6$ | $9$ | $12$ | $15$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $3$ | $2$ | $\\sqrt{3}$ | $0$ | $2\\sqrt{2}$ | $1$ |\n| $g(x)={(f(x))}^{2}$ | $9$ | $4$ | $3$ | $0$ | $8$ | $1$ |\n\nFinally, we obtain the following approximation for our volume:\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{0}^{15}g(x)\\,\\text{d}x \\\\  & ≈\\pi \\cdot (g(3)+g(6)+g(9)+g(12)+g(15))\\cdot Δx \\\\  & =\\pi \\cdot (4+3+0+8+1)\\cdot 3 \\\\  & =\\pi \\cdot 16\\cdot 3 \\\\  & =48\\pi \\end{aligned}\n$$" #edb/ref 17592186045417] [17592186510490 #edb/ref 1058 #edb/ref 17592186510553 #edb/ref 17592186045417] [17592186510490 #edb/ref 1062 #uuid "32d2ec1a-d6ed-5482-879e-744367b94dca" #edb/ref 17592186045417] [17592186510490 #edb/ref 1063 #edb/ref 17592186510383 #edb/ref 17592186045417] [17592186510511 #edb/ref 1062 #uuid "694eb003-d786-5734-a959-cc83c41aa69e" #edb/ref 17592186045417] [17592186510511 #edb/ref 1063 #edb/ref 17592186510395 #edb/ref 17592186045417] [17592186510514 #edb/ref 1058 #edb/ref 17592186510539 #edb/ref 17592186045417] [17592186510514 #edb/ref 1062 #uuid "6c9c828f-44ee-5495-86d5-5bda67c8798d" #edb/ref 17592186045417] [17592186510514 #edb/ref 1063 #edb/ref 17592186193027 #edb/ref 17592186045417] [17592186510539 #edb/ref 1058 #edb/ref 17592186510490 #edb/ref 17592186045417] [17592186510539 #edb/ref 1062 #uuid "c0e73eb7-4739-5f4b-84a0-6fccb98ec129" #edb/ref 17592186045417] [17592186510539 #edb/ref 1063 #edb/ref 17592186510425 #edb/ref 17592186045417] [17592186510553 #edb/ref 1058 #edb/ref 17592186510511 #edb/ref 17592186045417] [17592186510553 #edb/ref 1062 #uuid "e5bc175d-e11b-55ff-aaea-33f654704c94" #edb/ref 17592186045417] [17592186510553 #edb/ref 1063 #edb/ref 17592186510422 #edb/ref 17592186045417]}
