/mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right left\" columnspacing=\"0em\" rowspacing=\"0.8em 0.8em 0.8em 0.8em 0.3em\"><mtr><mtd><mi>V</mi></mtd><mtd><mi></mi><mo>=</mo><mi>π</mi><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mn>11</mn></mrow></msubsup><mi>g</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>≈</mo><mi>π</mi><mo>⋅</mo><mo stretchy=\"false\">(</mo><mi>g</mi><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mi>g</mi><mo stretchy=\"false\">(</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mi>g</mi><mo stretchy=\"false\">(</mo><mn>5</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mi>g</mi><mo stretchy=\"false\">(</mo><mn>7</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mi>g</mi><mo stretchy=\"false\">(</mo><mn>9</mn><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">)</mo><mo>⋅</mo><mi mathvariant=\"normal\">Δ</mi><mi>x</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>π</mi><mo>⋅</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>0</mn><mo>+</mo><mn>1</mn><mo>+</mo><mn>9</mn><mo stretchy=\"false\">)</mo><mo>⋅</mo><mn>2</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mi>π</mi><mo>⋅</mo><mn>13</mn><mo>⋅</mo><mn>2</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mn>26</mn><mi>π</mi></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
