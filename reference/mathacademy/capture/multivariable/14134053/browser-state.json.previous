></mi><mo>=</mo><mn>48</mn></mtd></mtr><mtr><mtd><msup><mn>0</mn><mn>2</mn></msup><mo>+</mo><mn>2</mn><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>9</mn><mrow><mn>16</mn><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow><mo>+</mo><mn>4</mn><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">(</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>9</mn><mrow><mn>64</mn><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo data-mjx-texclass=\"CLOSE\">)</mo></mrow></mtd><mtd><mi></mi><mo>=</mo><mn>48</mn></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>9</mn><mrow><mn>8</mn><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>9</mn><mrow><mn>16</mn><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mn>48</mn></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>18</mn><mrow><mn>16</mn><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>9</mn><mrow><mn>16</mn><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mn>48</mn></mtd></mtr><mtr><mtd><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>27</mn><mrow><mn>16</mn><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mn>48</mn></mtd></mtr><mtr><mtd><msup><mi>λ</mi><mn>2</mn></msup></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>9</mn><mn>256</mn></mfrac></mstyle></mtd></mtr><mtr><mtd><mi>λ</mi></mtd><mtd><mi></mi><mo>=</mo><mo>±</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>3</mn><mn>16</mn></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>We ca