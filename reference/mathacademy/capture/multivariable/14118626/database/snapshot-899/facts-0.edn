\\\\ \\operatorname{cos}⁡(5t)+\\operatorname{sin}⁡(5t)\\end{aligned}]" #edb/ref 17592186045417] [17592186307421 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186307421 #edb/ref 1083 #uuid "f5517b5c-9b51-5048-865f-4559006210d0" #edb/ref 17592186045417] [17592186307447 #edb/ref 1080 "\\text{x}(t)=[\\begin{aligned}\\operatorname{cos}⁡(5t)+5\\operatorname{sin}⁡(5t) \\\\ \\operatorname{cos}⁡(5t)-\\operatorname{sin}⁡(5t)\\end{aligned}]" #edb/ref 17592186045417] [17592186307447 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186307447 #edb/ref 1083 #uuid "f7735b63-f11b-54fb-adbc-dc86dab8bb17" #edb/ref 17592186045417] [17592186307732 #edb/ref 1075 #edb/ref 17592186305216 #edb/ref 17592186045417] [17592186307732 #edb/ref 1075 #edb/ref 17592186305520 #edb/ref 17592186045417] [17592186307732 #edb/ref 1075 #edb/ref 17592186306659 #edb/ref 17592186045417] [17592186307732 #edb/ref 1075 #edb/ref 17592186307421 #edb/ref 17592186045417] [17592186307732 #edb/ref 1075 #edb/ref 17592186307447 #edb/ref 17592186045417] [17592186307732 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186307732 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186307732 #edb/ref 1078 #edb/ref 17592186306659 #edb/ref 17592186045417] [17592186307732 #edb/ref 1079 #uuid "44687a24-fd41-5a07-bdd7-e77e03c1b3f8" #edb/ref 17592186045417] [17592186308171 #edb/ref 1075 #edb/ref 17592186305320 #edb/ref 17592186045417] [17592186308171 #edb/ref 1075 #edb/ref 17592186306322 #edb/ref 17592186045417] [17592186308171 #edb/ref 1075 #edb/ref 17592186306457 #edb/ref 17592186045417] [17592186308171 #edb/ref 1075 #edb/ref 17592186306458 #edb/ref 17592186045417] [17592186308171 #edb/ref 1075 #edb/ref 17592186306986 #edb/ref 17592186045417] [17592186308171 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186308171 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186308171 #edb/ref 1078 #edb/ref 17592186306986 #edb/ref 17592186045417] [17592186308171 #edb/ref 1079 #uuid "d1240bd8-a5f5-5f09-a6c2-bec2bc9728d5" #edb/ref 17592186045417] [17592186308548 #edb/ref 1068 #edb/ref 17592186307732 #edb/ref 17592186045417] [17592186308548 #edb/ref 1069 "q-334063" #edb/ref 17592186045417] [17592186308548 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186308548 #edb/ref 1071 "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-1 & 26 \\\\ -1 & 1\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}1 \\\\ 1\\end{aligned}].\n$$\n\n*Hint: The matrix has the eigenvalue ${\\lambda }_{1}=5\\text{i}$ with the corresponding eigenvector ${v}_{1}=[\\begin{aligned}1-5\\text{i} \\\\ 1\\end{aligned}].$*" #edb/ref 17592186045417] [17592186308548 #edb/ref 1072 #uuid "d09bcde9-8cbf-534e-b009-ecb0c5d97dc7" #edb/ref 17592186045417] [17592186308548 #edb/ref 1074 "We need to find the eigenvalues and associated eigenvectors of the matrix $A=[\\begin{aligned}-1 & 26 \\\\ -1 & 1\\end{aligned}].$ \n\nWe are given the eigenvalue ${\\lambda }_{1}=5\\text{i}$ and the corresponding eigenvector ${v}_{1}=[\\begin{aligned}1-5\\text{i} \\\\ 1\\end{aligned}].$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=5\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=[\\begin{aligned}1-5\\text{i} \\\\ 1\\end{aligned}]{e}^{5\\text{i}t}.\n$$\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}1-5\\text{i} \\\\ 1\\end{aligned}]{e}^{5\\text{i}t} \\\\  & =[\\begin{aligned}1-5\\text{i} \\\\ 1\\end{aligned}]\\cdot (\\operatorname{cos}⁡(5t)+\\text{i}\\operatorname{sin}⁡(5t)) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(5t)+\\text{i}\\operatorname{sin}⁡(5t)-5\\text{i}\\operatorname{cos}⁡(5t)+5\\operatorname{sin}⁡(5t) \\\\ \\operatorname{cos}⁡(5t)+\\text{i}\\operatorname{sin}⁡(5t)\\end{aligned}] \\\\  & =[\\begin{aligned}(\\operatorname{cos}⁡(5t)+5\\operatorname{sin}⁡(5t))+\\text{i}(\\operatorname{sin}⁡(5t)-5\\operatorname{cos}⁡(5t)) \\\\ \\operatorname{cos}⁡(5t)+\\text{i}\\operatorname{sin}⁡(5t)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(5t)+5\\operatorname{sin}⁡(5t) \\\\ \\operatorname{cos}⁡(5t)\\end{aligned}]+\\text{i}[\\begin{aligned}\\operatorname{sin}⁡(5t)-5\\operatorname{cos}⁡(5t) \\\\ \\operatorname{sin}⁡(5t)\\end{aligned}] \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors ${w}_{1}$ and ${w}_{2}$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(5t)+5\\operatorname{sin}⁡(5t) \\\\ \\operatorname{cos}⁡(5t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sin}⁡(5t)-5\\operatorname{cos}⁡(5t) \\\\ \\operatorname{sin}⁡(5t)\\end{aligned}].\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & ={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]+{c}_{2}[\\begin{aligned}-5 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}1 \\\\ 1\\end{aligned}] & =[\\begin{aligned}{c}_{1}-5{c}_{2} \\\\ {c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =1[\\begin{aligned}\\operatorname{cos}⁡(5t)+5\\operatorname{sin}⁡(5t) \\\\ \\operatorname{cos}⁡(5t)\\end{aligned}]+0[\\begin{aligned}\\operatorname{sin}⁡(5t)-5\\operatorname{cos}⁡(5t) \\\\ \\operatorname{sin}⁡(5t)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(5t)+5\\operatorname{sin}⁡(5t) \\\\ \\operatorname{cos}⁡(5t)\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186308557 #edb/ref 1068 #edb/ref 17592186308171 #edb/ref 17592186045417] [17592186308557 #edb/ref 1069 "q-334103" #edb/ref 17592186045417] [17592186308557 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186308557 #edb/ref 1071 "$$\n{x}^{′}(t)=[\\begin{aligned}4 & 1 \\\\ -1 & 4\\end{aligned}]x(t)\n$$\n\nConsider the system of linear differential equations above.\nFind the unknown function $f(t)$ in the general solution to the system, shown below.\n\n$$\n\\text{x}(t)={c}_{1}[\\begin{aligned}\\operatorname{sin}⁡t \\\\ f(t)\\end{aligned}]{e}^{4t}+{c}_{2}[\\begin{aligned}-\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{4t}\n$$\n\n*Hint: One of the eigenvalues of the matrix is ${\\lambda }_{1}=4+\\text{i}.$*" #edb/ref 17592186045417] [17592186308557 #edb/ref 1072 #uuid "78ae1104-266d-589e-8326-583eecd00f87" #edb/ref 17592186045417] [17592186308557 #edb/ref 1074 "We need to find the eigenvalues and associated eigenvectors of the matrix $A=[\\begin{aligned}4 & 1 \\\\ -1 & 4\\end{aligned}].$ \n\nWe are given that the eigenvalue is ${\\lambda }_{1}=4+\\text{i}.$ \n\nLet's go through the process of finding the eigenvectors. For ${\\lambda }_{1}=4+\\text{i},$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}-\\text{i} & 1 \\\\ -1 & -\\text{i}\\end{aligned}]∼[\\begin{aligned}1 & \\text{i} \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}-\\text{i} \\\\ 1\\end{aligned}].$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=4+\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=[\\begin{aligned}-\\text{i} \\\\ 1\\end{aligned}]{e}^{(4+\\text{i})t}.\n$$\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}-\\text{i} \\\\ 1\\end{aligned}]{e}^{(4+\\text{i})t} \\\\  & =[\\begin{aligned}-\\text{i} \\\\ 1\\end{aligned}]{e}^{4t}(\\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t) \\\\  & =[\\begin{aligned}{e}^{4t}\\operatorname{sin}⁡t-\\text{i}({e}^{4t}\\operatorname{cos}⁡t) \\\\ {e}^{4t}\\operatorname{cos}⁡t+\\text{i}({e}^{4t}\\operatorname{sin}⁡t)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{4t}+\\text{i}[\\begin{aligned}-\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{4t} \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors ${w}_{1}$ and ${w}_{2}$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{4t}+{c}_{2}[\\begin{aligned}-\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{4t}.\\end{aligned}\n$$\n\nFinally, $f(t)=\\operatorname{cos}⁡t.$" #edb/ref 17592186045417] [17592186414105 #edb/ref 1080 "\\text{x}(t)=[\\begin{aligned}\\operatorname{sin}⁡(3t)-\\operatorname{cos}⁡(3t) \\\\ \\operatorname{sin}⁡(3t)+\\operatorname{cos}⁡(3t)\\end{aligned}]{e}^{-2t}" #edb/ref 17592186045417] [17592186414105 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186414105 #edb/ref 1083 #uuid "05327d3a-aca0-5fb0-9c50-b10761df4f82" #edb/ref 17592186045417] [17592186414106 #edb/ref 1080 "\\operatorname{cos}⁡(3t)+2\\operatorname{sin}⁡(3t)" #edb/ref 17592186045417] [17592186414106 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186414106 #edb/ref 1083 #uuid "1995fd1a-c6d4-512a-a6be-f138f303bc89" #edb/ref 17592186045417] [17592186