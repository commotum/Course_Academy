    "q-81596": {
      "dom_id": "step-q81596",
      "name": "Question 1",
      "problem": "Which statement is equivalent to $(A∨B)∧C?$",
      "worked_solution": "We distribute the conjunction over the disjunction, as follows:\n\n$$\n(A∨B)∧C≡(A∧C)∨(B∧C)\n$$",
