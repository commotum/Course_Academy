:answer/value "(¬Q∨R)∧(P∨¬Q)" :db/id #edb/ref 17592186417290} :answer-field/id #uuid "bee75b8c-7e23-597a-b6f8-f1d54d44dd00" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417310}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "069dc222-993e-5f7e-957c-4dcdfd352437" :question/math-academy-id "q-128640" :question/problem "Which statement is equivalent to $(R∧P)∨¬Q?$" :question/worked-solution "We distribute the disjunction over the conjunction, as follows:\n\n$$\n(R∧P)∨¬Q≡(R∨¬Q)∧(P∨¬Q)\n$$\n\nNow, since $R∨¬Q≡¬Q∨R,$ we can write\n\n$$\n(R∨¬Q)∧(P∨¬Q)≡(¬Q∨R)∧(P∨¬Q).\n$$"}] [{:db/id #edb/ref 17592186417321 :knowledge-point/_questions [{:db/id #edb/ref 17592186157273 :knowledge-point/id #uuid "44bf5c8e-cf2a-595c-b93a-5fe338ffd766" :knowledge-point/title "Simplifying a Statement Using the Distributive Property for Conjunctions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "167e317c-1aae-5d23-823c-1ddd7b7e4d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C∧(B∨A)" :db/id #edb/ref 17592186417231} {:answer/id #uuid "4b76fe12-160b-5475-a455-0f529535cce5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(C∨B)∧A" :db/id #edb/ref 17592186417249} {:answer/id #uuid "4fa867c3-f3df-5dba-8f74-aeeeaf973caf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(C∧B)∧A" :db/id #edb/ref 17592186417251} {:answer/id #uuid "5b046601-883a-503a-9926-4a6cb1484b3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C∨(B∧A)" :db/id #edb/ref 17592186417255} {:answer/id #uuid "64b138ec-8e77-511b-9b46-35ddac1d0ed2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(C∨B)∨A" :db/id #edb/ref 17592186417260}] :answer-field/correc