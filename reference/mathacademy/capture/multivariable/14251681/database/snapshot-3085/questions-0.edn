#{[{:db/id #edb/ref 17592186157076 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157272 :knowledge-point/id #uuid "9c108451-a023-5057-8e13-628be2df85cf" :knowledge-point/title "Expanding a Statement by Distributing a Conjunction"}] :question/id #uuid "2d12f13f-510a-558b-9e10-88151d3e1bb3" :question/math-academy-id "e-7077" :question/problem "Expand the statement $P \\land (Q \\lor R)$ by distributing the conjunction." :question/worked-solution "We distribute the conjunction over the disjunction, as follows:\n\n$$\nP \\land (Q \\lor R) \\equiv (P \\land Q) \\lor (P \\land R)\n$$"}] [{:db/id #edb/ref 17592186157077 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157273 :knowledge-point/id #uuid "44bf5c8e-cf2a-595c-b93a-5fe338ffd766" :knowledge-point/title "Simplifying a Statement Using the Distributive Property for Conjunctions"}] :question/id #uuid "66490eb1-08f7-5df5-9540-88cc538e7d58" :question/math-academy-id "e-7078" :question/problem "Simplify the statement $(A \\land C) \\lor (A \\land B)$ using the distributive property for conjunctions." :question/worked-solution "We can factor out the conjunction with $A,$ as follows:\n\n$$\n(A \\land C) \\lor (A \\land B) \\equiv A \\land (C \\lor B)\n$$"}] [{:db/id #edb/ref 17592186157082 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157278 :knowledge-point/id #uuid "5784bae8-d32b-522d-91c1-df798c1ad1d5" :knowledge-point/title "Expanding a Statement by Distributing a Disjunction"}] :question/id #uuid "726d5902-76f0-5321-bf3b-678fe487c831" :question/math-academy-id "e-7124" :question/problem "Expand the statement $(C \\land B) \\lor A$ by distributing the disjunction." :question/worked-solution "We distribute the disjunction over the conjunction, as follows:\n\n$$\n(C \\land B) \\lor A  \\equiv (C \\lor A) \\land (B \\lor A)\n$$"}] [{:db/id #edb/ref 17592186157083 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157279 :knowledge-point/id #uuid "50c12386-8f44-5a50-a