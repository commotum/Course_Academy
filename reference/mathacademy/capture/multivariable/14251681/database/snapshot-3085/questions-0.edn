} :answer/value "(Y∨¬Z)∧X" :db/id #edb/ref 17592186377836} {:answer/id #uuid "fd91eb9e-4d95-54ca-b286-096a53f74cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(Y∨¬Z)∨X" :db/id #edb/ref 17592186377837}] :answer-field/correct {:answer/id #uuid "bfa41864-076f-596e-8f54-9912c636d116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(Y∨¬Z)∧X" :db/id #edb/ref 17592186377836} :answer-field/id #uuid "079fac7c-cc66-55a2-9936-fd722d378c2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377832}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c17ed8b0-93c1-546f-8e61-c4cd15d78bc4" :question/math-academy-id "q-81616" :question/problem "Which statement is equivalent to $(X∧Y)∨(X∧¬Z)?$" :question/worked-solution "First, we can factor out the conjunction with $X,$ as follows:\n\n$$\n(X∧Y)∨(X∧¬Z)≡X∧(Y∨¬Z)\n$$\n\nThen, we can write\n\n$$\nX∧(Y∨¬Z)≡(Y∨¬Z)∧X.\n$$"}] [{:db/id #edb/ref 17592186417116 :knowledge-point/_questions [{:db/id #edb/ref 17592186157273 :knowledge-point/id #uuid "44bf5c8e-cf2a-595c-b93a-5fe338ffd766" :knowledge-point/title "Simplifying a Statement Using the Distributive Property for Conjunctions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30e7cbc2-cbd4-53d8-853f-b1eef6d6f6e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∧(H∨K)" :db/id #edb/ref 17592186417090} {:answer/id #uuid "3bd7be93-2827-57fe-af9b-b506619002d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(H∧K)∧¬P" :db/id #edb/ref 17592186417095} {:answer/id #uuid "4aa42a40-227c-52eb-9ac1-c9ca9ed74398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∨(H∨K)" :db/id #edb/ref 17592186417098} {:answer/id #uuid "5c594939-5010-59b7-aeb0-b275fef1f392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "P∧(¬H∨K)" :db/id #edb/ref 17592186417101} {:answer/id #uuid "d5c35db1-1467-529e-a1e5-e91a92e96b7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∨(H∧K)" :db/id #edb/ref 17592186417105}] :answer-field/correct {:answer/id #uuid "30e7cbc2-cbd4-53d8-853f-b1eef6d6f6e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬P∧(H∨K)" :db/id #edb/ref 17592186417090} :answer-field/id #uuid "88a08983-3aaf-5e49-9bb4-ac503165bfd3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417112}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3c480e6c-f991-5894-887d-f4dfdff7f021" :question/math-academy-id "q-86772" :question/problem "Which statement is equivalent to $(H∧¬P)∨(K∧¬P)?$" :question/worked-solution "First, we can factor out the conjunction with $¬P,$ as follows:\n\n$$\n(H∧¬P)∨(K∧¬P)≡(H∨K)∧¬P\n$$\n\nThen, we can write\n\n$$\n(H∨K)∧¬P≡¬P∧(H∨K).\n$$"}]}
