45417] [17592186167892 #edb/ref 1062 #uuid "3d8f9646-10b3-5bfd-97ef-e080e3440cfc" #edb/ref 17592186045417] [17592186167892 #edb/ref 1063 #edb/ref 17592186166933 #edb/ref 17592186045417] [17592186167893 #edb/ref 1058 #edb/ref 17592186167894 #edb/ref 17592186045417] [17592186167893 #edb/ref 1061 590709 #edb/ref 17592186045417] [17592186167893 #edb/ref 1062 #uuid "6351ca80-d1fa-5039-94d0-87986551c3b2" #edb/ref 17592186045417] [17592186167893 #edb/ref 1063 #edb/ref 17592186166934 #edb/ref 17592186045417] [17592186167894 #edb/ref 1061 590712 #edb/ref 17592186045417] [17592186167894 #edb/ref 1062 #uuid "5d6348a1-6da4-5516-b665-5319df7cd619" #edb/ref 17592186045417] [17592186167894 #edb/ref 1063 #edb/ref 17592186166935 #edb/ref 17592186045417] [17592186167895 #edb/ref 1058 #edb/ref 17592186167891 #edb/ref 17592186045417] [17592186167895 #edb/ref 1061 590715 #edb/ref 17592186045417] [17592186167895 #edb/ref 1062 #uuid "91a3017f-8462-5088-8b1f-303f10ce818d" #edb/ref 17592186045417] [17592186167895 #edb/ref 1063 #edb/ref 17592186168032 #edb/ref 17592186045417] [17592186167993 #edb/ref 1064 "![](images/0b/0bebe0003d3d70b77be931f2dba651d85352bddf6e41b94055bb227b07d60153.svg)\n\n**Step 1**. In the initial value problem above, we apply the Laplace transform $\\mathcal{L}$ to both sides of each equation.\n\nFirst, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n\\left\\{\\begin{aligned}L\\{{x}_{1}^{′}(t)\\} &=L\\{{x}_{1}(t)+5\\} \\\\ L\\{{x}_{2}^{′}(t)\\} &=L\\{-2{x}_{1}(t)+4{x}_{2}(t)-2\\}\\end{aligned}\\right.\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n\\left\\{\\begin{aligned}sL\\{{x}_{1}(t)\\}-{x}_{1}(0) &=L\\{{x}_{1}(t)\\}+5L\\{1\\} \\\\ sL\\{{x}_{2}(t)\\}-{x}_{2}(0) &=-2L\\{{x}_{1}(t)\\}+4L\\{{x}_{2}(t)\\}-2L\\{1\\}\\end{aligned}\\right.\n$$\n\nUsing the result\n\n$$\n\\mathcal L\\{1\\} = \\dfrac{1}{s},\n$$\n\nwe can write our system as follows:\n\n$$\n\\left\\{\\begin{aligned}s{X}_{1}(s)+2 &={X}_{1}(s)+\\frac{5}{s} \\\\ s{X}_{2}(s)-3 &=-2{X}_{1}(s)+4{X}_{2}(s)-\\frac{2}{s}\\end{aligned}\\right.\n$$\n\nwhere $X_1(s) = \\mathcal{L}\\left\\{  x_1(t) \\right\\}$ and $X_2(s) = \\mathcal{L}\\left\\{  x_2(t) \\right\\}$ are the Laplace transforms of the functions $x_1(t)$ and $x_2(t),$ respectively.\n\n**Step 2**. Now, solving the first equation for $X_1(s),$ we get\n\n$$\n\\begin{aligned}s{X}_{1}(s)+2={X}_{1}(s)+\\frac{5}{s}\\,⟹\\,{X}_{1}(s) & =\\frac{-2s+5}{s(s-1)}.\\end{aligned}\n$$\n\nSubstituting this in the second equation and solving for $X_2(s),$ we have\n\n$$\ns X_2(s) - 3 = - 2 \\left(\\dfrac{-2s+5}{s(s-1)}\\right) + 4 X_2(s) - \\dfrac{2}{s}\n\\qquad\\Longrightarrow\\qquad\nX_2(s) = \\dfrac{3s^2-s-8}{s(s-1)(s-4)}.\n$$\n\n**Step 3**. To find $x_1(t)$ and $x_2(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to $X_1(s)$ and $X_2(s){:}$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}\\{{X}_{1}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{-2s+5}{s(s-1)}\\} \\\\  & ={L}^{-1}\\{\\frac{3}{s-1}-\\frac{5}{s}\\} \\\\  & =3{L}^{-1}\\{\\frac{1}{s-1}\\}-5{L}^{-1}\\{\\frac{1}{s}\\} \\\\  & =3{e}^{t}-5 \\\\ {x}_{2}(t) & ={L}^{-1}\\{{X}_{2}(s)\\} \\\\  & ={L}^{-1}\\{\\frac{3{s}^{2}-s-8}{s(s-1)(s-4)}\\} \\\\  & ={L}^{-1}\\{\\frac{2}{s-1}+\\frac{3}{s-4}-\\frac{2}{s}\\} \\\\  & =2{L}^{-1}\\{\\frac{1}{s-1}\\}+3{L}^{-1}\\{\\frac{1}{s-4}\\}-2{L}^{-1}\\{\\frac{1}{s}\\} \\\\  & =2{e}^{t}+3{e}^{4t}-2\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =\\begin{bmatrix}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{bmatrix}=\\begin{bmatrix}3{e}^{t}-5 \\\\ 2{e}^{t}+3{e}^{4t}-2\\end{bmatrix}\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186167993 #edb/ref 1065 14420 #edb/ref 17592186045417] [17592186167993 #edb/ref 1066 #uuid "00904ad0-6191-560b-a452-c838aa7543a6" #edb/ref 17592186045417] [17592186167993 #edb/ref 1067 "A Worked Example" #edb/ref 17592186045417] [17592186168032 #edb/ref 1064 "In this topic, we'll learn how to use Laplace transforms to solve inhomogeneous systems like the one below.\n![](images/e0/e04825ebe3b670d020df9c4dad9b86564a57542effc88b77d5778f535e15d5bf.svg)\n\nSimilar to the homogeneous case, the process can be split into three steps.\n\n- **Step 1.** Apply the Laplace transform $\\mathcal{L}$ to both sides of each equation, to get a system with variables \n\n$$\nX_1(s) = \\mathcal{L}\\left\\{  x_1(t) \\right\\} \\qquad \\text{and} \\qquad X_2(s) = \\mathcal{L}\\left\\{  x_2(t) \\right\\}.\n$$\n\n- **Step 2.** Solve the obtained system for variables \n\n$$\nX_1(s) \\qquad \\text{and} \\qquad X_2(s).\n$$\n\n- **Step 3.** To find initial variables \n\n$$\nx_1(t) \\qquad \\text{and} \\qquad x_2(t)\n$$\n\nsatisfying the original initial value problem, apply the inverse Laplace transform to \n\n$$\nX_1(s) \\qquad \\text{and} \\qquad X_2(s).\n$$\n\nLet's see how this works in practice." #edb/ref 17592186045417] [17592186168032 #edb/ref 1065 14611 #edb/ref 17592186045417] [17592186168032 #edb/ref 1066 #uuid "3733acd7-1a13-5183-a501-0baf1eaf53a5" #edb/ref 17592186045417] [17592186168032 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186303520 #edb/ref 1080 "\\frac{1}{2}{e}^{t}+\\frac{3}{2}{e}^{3t}-1" #edb/ref 17592186045417] [17592186303520 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186303520 #edb/ref 1083 #uuid "ac964228-37ed-5165-995d-548c80a4f24b" #edb/ref 17592186045417] [17592186303701 #edb/ref 1080 "{e}^{t}-3" #edb/ref 17592186045417] [17592186303701 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186303701 #edb/ref 1083 #uuid "caf736de-0666-5d9b-968f-218e1f2297c1" #edb/ref 17592186045417] [17592186304154 #edb/ref 1075 #edb/ref 17592186303520 #edb/ref 17592186045417] [17592186304154 #edb/ref 1075 #edb/ref 17592186506260 #edb/ref 17592186045417] [17592186304154 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186304154 #edb/ref 1077 "field-2" #edb/ref 1759