186045498 :db/ident :answer.type/math} :answer/value "\\text{L3}" :db/id #edb/ref 17592186370368}] :answer-field/correct {:answer/id #uuid "a6bc1038-64cb-535a-b633-b2c5e10b6ad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{L4}" :db/id #edb/ref 17592186370367} :answer-field/id #uuid "d3847361-a50f-5b4d-82d7-e69b36f4a78c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186370365}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de398203-cf28-58bc-baf8-d4c0b37651f0" :question/math-academy-id "q-335416" :question/problem "Consider the inhomogeneous system  ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix. A derivation of the formula for the solution $x(t)$ passing through $x({t}_{0})$ is presented below.\n\n$\\text{L1}:\\,$ Let $y(t)={e}^{-A(t-{t}_{0})}x(t)$  \n\n$\\text{L2}:\\,$ ${y}^{′}(t)=-A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}{x}^{′}(t)$  \n\n$\\text{L3}:\\,$ ${y}^{′}(t)={e}^{-A(t-{t}_{0})}g(t)$  \n\n$\\text{L4}:\\,$ $y(t)-y({t}_{0})={\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s$\n\n$\\text{L5}:\\,$ $y({t}_{0})=x({t}_{0})$ \n\n$\\text{L6}:\\,$ $y(t)=x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s$  \n\n$\\text{L7}:\\,$ ${e}^{A(t-{t}_{0})}y(t)={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s$\n\n$\\text{L8}:\\,$ ${e}^{A(t-{t}_{0})}y(t)=x(t)$\n\n$\\text{L9}:\\,$ $x(t)={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L3}$ follows from $\\text{L2}$ by  \n{{field-1}}.\n\n$\\,$ Line $\\text{L6}$ follows from line\n{{field-2}}\nby substituting \n{{field-3}}.\n\n$\\,$ Line $\\text{L8}$ follows from line $\\text{L1}$ by  \n{{field-4}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L2}$ and $\\text{L3}.$ Starting from\n\n$$\n{y}^{′}(t)=-A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}{x}^{′}(t)\n$$\n\nin $\\text{L2}$ and substituting ${x}^{′}(t)=Ax(t)+g(t)$ from the original system gives\n\n$$\n\\begin{aligned}{y}^{′}(t) & =-A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}(Ax(t)+g(t)) \\\\  & =-A{e}^{-A(t-{t}_{0})}x(t)+A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}g(t) \\\\  & ={e}^{-A(t-{t}_{0})}g(t).\\end{aligned}\n$$\n\nThus, $\\text{L3}$ follows from $\\text{L2}$ by $\\text{substituting }{x}^{′}(t)=Ax(t)+g(t).$\n\n- Next, we consider lines $\\text{L4}$, $\\text{L5}$, and $\\text{L6}.$ From $\\text{L4}$ we have\n\n$$\ny(t)-y({t}_{0})={\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s.\n$$\n\nUsing $y({t}_{0})=x({t}_{0})$ from $\\text{L5}$, this becomes\n\n$$\ny(t)-x({t}_{0})={\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s,\n$$\n\nso\n\n$$\ny(t)=x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s.\n$$\n\nThus, $\\text{L6}$ follows from $\\text{L4}$ by substituting $y({t}_{0})=x({t}_{0}).$\n\n- Finally, we consider lines $\\text{L1}$ and $\\text{L8}.$ Multiplying both sides of\n\n$$\ny(t)={e}^{-A(t-{t}_{0})}x(t)\n$$\n\nfrom $\\text{L1}$ by ${e}^{A(t-{t}_{0})}$ gives\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})}y(t) & ={e}^{A(t-{t}_{0})}{e}^{-A(t-{t}_{0})}x(t) \\\\  & =x(t).\\end{aligned}\n$$\n\nTherefore, $\\text{L8}$ follows from $\\text{L1}$ by $\\text{multiplying both sides by }{e}^{A(t-{t}_{0})}.$"}] [{:db/id #edb/ref 17592186396755 :knowledge-point/_questions [{:db/id #edb/ref 17592186229133 :knowledge-point/id #uuid "4c4b78fa-76af-5261-87a0-d1960aa0fe04" :knowledge-point/title "Proving the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6340a434-1f61-5e6a-a285-4fc8d1b9102a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "differentiating and using the sum rule" :db/id #edb/ref 17592186396757} {:answer/id #uuid "8b331929-7f99-5db3-bfa8-928f56ab52cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "multiplying both sides by ${e}^{A(t+{t}_{0})}$" :db/id #edb/ref 17592186396758} {:answer/id #uuid "a9383354-b3ca-54ba-be42-38ef63dbcfa7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "multiplying both sides by ${e}^{A(t-{t}_{0})}$" :db/id #edb/ref 17592186396759} {:answer/id #uuid "11fbce92-a29e-5530-88e3-f9015373285b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "evaluating at $t={t}_{0}$" :db/id #edb/ref 17592186396760}] :answer-field/correct {:answer/id #uuid "11fbce92-a29e-5530-88e3-f9015373285b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "evaluating at $t={t}_{0}$" :db/id #edb/ref 17592186396760} :answer-field/id #uuid "af7ae7ba-6ace-5d3b-a3df-d31722ff9859" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186396756} {:answer-field/choices [{:answer/id #uuid "6c225024-4134-558a-ac74-254995be9458" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "applying a change of variables" :db/id #edb/ref 17592186396762} {:answer/id #uuid "aa1af8f3-6b38-5b8d-bad8-3a7e70e14522" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "substituting ${x}^{′}(t)=Ax(t)+g(t)$" :db/id #edb/ref 17592186396763} {:answer/id #uuid "5381208c-3cf9-501f-8d6d-9c77cfe29564" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "evaluating at $t={t}_{0}$" :db/id #edb/ref 17592186396764} {:answer/id #uuid "c71be608-0adf-5170-8c99-84e72c9a3b61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "substituting ${x}^{′}(t)=Ax(t)+g(t)+{t}_{0}$" :db/id #edb/ref 17592186396765}] :answer-field/correct {:answer/id #uuid "aa1af8f3-6b38-5b8d-bad8-3a7e70e14522" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "substituting ${x}^{′}(t)=Ax(t)+g(t)$" :db/id #edb/ref 17592186396763} :answer-field/id #uuid "c6031269-ba85-5872-aa4c-e64d608aeb30" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186396761} {:answer-field/choices [{:answer/id #uuid "1f0731d0-4386-5750-abab-d09fd58801e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "multiplying both sides by ${e}^{A(t+{t}_{0})}$" :db/id #edb/ref 17592186396767} {:answer/id #uuid "7aebdae2-bb8c-5fcc-8f5e-cbfc865f92de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "multiplying both sides by ${e}^{A(t-{t}_{0})}$" :db/id #edb/ref 17592186396768} {:answer/id #uuid "51ead76c-972a-53c4-aafe-40ddf79b5d2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "integrating both sides" :db/id #edb/ref 17592186396769} {:answer/id #uuid "bdb4f772-c3f3-5eda-8d5a-76ce2843a3a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "evaluating at $t={t}_{0}$" :db/id #edb/ref 17592186396770}] :answer-field/correct {:answer/id #uuid "7aebdae2-bb8c-5fcc-8f5e-cbfc865f92de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "multiplying both sides by ${e}^{A(t-{t}_{0})}$" :db/id #edb/ref 17592186396768} :answer-field/id #uuid "5ec773fb-fcb6-505d-9f93-6d40a41f5157" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186396766}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e9e9aa1-972a-5335-8521-470987b0b354" :question/math-academy-id "q-335420" :question/problem "Consider the inhomogeneous system  ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix. A derivation of the formula for the solution $x(t)$ passing through $x({t}_{0})$ is presented below.\n\n$\\text{L1}:\\,$ Let $y(t)={e}^{-A(t-{t}_{0})}x(t)$  \n\n$\\text{L2}:\\,$ ${y}^{′}(t)=-A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}{x}^{′}(t)$  \n\n$\\text{L3}:\\,$ ${y}^{′}(t)={e}^{-A(t-{t}_{0})}g(t)$  \n\n$\\text{L4}:\\,$ $y(t)-y({t}_{0})={\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s$\n\n$\\text{L5}:\\,$ $y({t}_{0})=x({t}_{0})$ \n\n$\\text{L6}:\\,$ $y(t)=x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s$  \n\n$\\text{L7}:\\,$ ${e}^{A(t-{t}_{0})}y(t)={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s$\n\n$\\text{L8}:\\,$ ${e}^{A(t-{t}_{0})}y(t)=x(t)$\n\n$\\text{L9}:\\,$ $x(t)={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L3}$ follows from $\\text{L2}$ by  \n{{field-1}}.\n\n$\\,$ Line $\\text{L5}$ follows from line $\\text{L1}$ by  \n{{field-2}}.\n\n$\\,$ Line $\\text{L7}$ follows from line $\\text{L6}$ by  \n{{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L2}$ and $\\text{L3}.$ Starting from\n\n$$\n{y}^{′}(t)=-A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}{x}^{′}(t)\n$$\n\nin $\\text{L2}$ and substituting ${x}^{′}(t)=Ax(t)+g(t)$ from the original system gives\n\n$$\n\\begin{aligned}{y}^{′}(t) & =-A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}(Ax(t)+g(t)) \\\\  & =-A{e}^{-A(t-{t}_{0})}x(t)+A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}g(t) \\\\  & ={e}^{-A(t-{t}_{0})}g(t).\\end{aligned}\n$$\n\nThus, $\\text{L3}$ follows from $\\text{L2}$ by $\\text{substituting }{x}^{′}(t)=Ax(t)+g(t).$\n\n- Next, we consider lines $\\text{L1}$ and $\\text{L5}.$ Evaluating $y(t)={e}^{-A(t-{t}_{0})}x(t)$ at $t={t}_{0}$ gives\n\n$$\ny({t}_{0})={e}^{-A({t}_{0}-{t}_{0})}x({t}_{0})=Ix({t}_{0})=x({t}_{0}).\n$$\n\nTherefore, $\\text{L5}$ follows from $\\text{L1}$ by $\\text{evaluating at }t={t}_{0}.$\n\n- Finally, we consider lines $\\text{L6}$ and $\\text{L7}.$ Multiplying both sides of\n\n$$\ny(t)=x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,ds\n$$\n\nfrom $\\text{L6}$ by ${e}^{A(t-{t}_{0})}$ gives\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})}y(t) & ={e}^{A(t-{t}_{0})}x({t}_{0})+{e}^{A(t-{t}_{0})}{\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s \\\\  & ={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s.\\end{aligned}\n$$\n\nTherefore, $\\text{L7}$ follows from $\\text{L6}$ by $\\text{multiplying both sides by }{e}^{A(t-{t}_{0})}.$"}]}
