#{[{:db/id #edb/ref 17592186512945 :knowledge-point/_questions [{:db/id #edb/ref 17592186229132 :knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b" :knowledge-point/title "Solving an Inhomogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ce80ed6-c2fb-573a-bcb7-17c24ee2cd02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-e^{-t}" :db/id #edb/ref 17592186512202}] :answer-field/correct {:answer/id #uuid "2ce80ed6-c2fb-573a-bcb7-17c24ee2cd02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-e^{-t}" :db/id #edb/ref 17592186512202} :answer-field/id #uuid "7d8ad94d-1b6b-50f4-917b-e60fcda59e4c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186512794}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dcde9f99-5a2a-52a5-a122-c3ef3631c507" :question/math-academy-id "q-335070" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-x(t)+y(t) \\\\ {y}^{′}(t)=-y(t)+1,\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{-t} & t{e}^{-t} \\\\ 0 & {e}^{-t}\\end{aligned}],$ where $A=[\\begin{aligned}-1 & 1 \\\\ 0 & -1\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">$1-{e}^{-t}-t{e}^{-t}$ </td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-1 & 1 \\\\ 0 & -1\\end{aligned}]x(t)+g(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $g(t)=[\\begin{aligned}0 \\\\ 1\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}-1 & 1 \\\\ 0 & -1\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=[\\begin{aligned}{e}^{-t} & t{e}^{-t} \\\\ 0 & {e}^{-t}\\end{aligned}].\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}{e}^{-t} & t{e}^{-t} \\\\ 0 & {e}^{-t}\\end{aligned}][\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}{e}^{-(t-s)} & (t-s){e}^{-(t-s)} \\\\ 0 & {e}^{-(t-s)}\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}{e}^{-(t-s)} & (t-s){e}^{-(t-s)} \\\\ 0 & {e}^{-(t-s)}\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}(t-s){e}^{s-t} \\\\ {e}^{s-t}\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}(t-s){e}^{s-t} \\\\ {e}^{s-t}\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}(-s+t+1){e}^{s-t} \\\\ {e}^{s-t}\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}1-(t+1){e}^{-t} \\\\ 1-{e}^{-t}\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]+[\\begin{aligned}1-(t+1){e}^{-t} \\\\ 1-{e}^{-t}\\end{aligned}] \\\\  & =[\\begin{aligned}1-{e}^{-t}-t{e}^{-t} \\\\ 1-{e}^{-t}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186512943 :knowledge-point/_questions [{:db/id #edb/ref 17592186229132 :knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b" :knowledge-point/title "Solving an Inhomogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a13ebe21-3fd3-5659-96f0-dac3aebbcdb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-e^{2t}-1" :db/id #edb/ref 17592186512473}] :answer-field/correct {:answer/id #uuid "a13ebe21-3fd3-5659-96f0-dac3aebbcdb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-e^{2t}-1" :db/id #edb/ref 17592186512473} :answer-field/id #uuid "6115237a-ca95-5556-91b1-d22bf91c2c37" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186512779}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d29ce693-46aa-5cb5-a64c-988886b4e7a0" :question/math-academy-id "q-335072" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=2x(t)+y(t)+1 \\\\ {y}^{′}(t)=2y(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{2t} & t{e}^{2t} \\\\ 0 & {e}^{2t}\\end{aligned}],$ where $A=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\frac{1}{2}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}]x(t)+g(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $g(t)=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=[\\begin{aligned}{e}^{2t} & t{e}^{2t} \\\\ 0 & {e}^{2t}\\end{aligned}].\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}{e}^{2t} & t{e}^{2t} \\\\ 0 & {e}^{2t}\\end{aligned}][\\begin{aligned}-1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-{e}^{2t} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}{e}^{2(t-s)} & (t-s){e}^{2(t-s)} \\\\ 0 & {e}^{2(t-s)}\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}{e}^{2(t-s)} & (t-s){e}^{2(t-s)} \\\\ 0 & {e}^{2(t-s)}\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{2(t-s)} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}{e}^{2(t-s)} \\\\ 0\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}-\\frac{1}{2}{e}^{2(t-s)} \\\\ 0\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}\\frac{1}{2}{e}^{2t}-\\frac{1}{2} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}-{e}^{2t} \\\\ 0\\end{aligned}]+[\\begin{aligned}\\frac{1}{2}{e}^{2t}-\\frac{1}{2} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{2}{e}^{2t}-\\frac{1}{2} \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}-{e}^{2t}-1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}-{e}^{2t}-1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186512909 :knowledge-point/_questions [{:db/id #edb/ref 17592186229132 :knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b" :knowledge-point/title "Solving an Inhomogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b374613-ddcc-5c32-8993-19ba069fb8ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{4t}-1" :db/id #edb/ref 17592186512258}] :answer-field/correct {:answer/id #uuid "4b374613-ddcc-5c32-8993-19ba069fb8ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e^{4t}-1" :db/id #edb/ref 17592186512258} :answer-field/id #uuid "083c749e-9d27-588e-b8bf-03bf5d6d7291" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186512725}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c12baec-9a09-54f7-8159-4ab5ea602070" :question/math-academy-id "q-335084" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=4x(t)+y(t)+2 \\\\ {y}^{′}(t)=4y(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{aligned}],$ where $A=[\\begin{aligned}4 & 1 \\\\ 0 & 4\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\frac{1}{2}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"120px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}4 & 1 \\\\ 0 & 4\\end{aligned}]x(t)+g(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $g(t)=[\\begin{aligned}2 \\\\ 0\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}4 & 1 \\\\ 0 & 4\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=[\\begin{aligned}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{aligned}].\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})}x(0) & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{aligned}][\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}{e}^{4(t-s)} & (t-s){e}^{4(t-s)} \\\\ 0 & {e}^{4(t-s)}\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}{e}^{4(t-s)} & (t-s){e}^{4(t-s)} \\\\ 0 & {e}^{4(t-s)}\\end{aligned}][\\begin{aligned}2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2{e}^{4(t-s)} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}2{e}^{4(t-s)} \\\\ 0\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}\\frac{1}{2}{e}^{4(t-s)} \\\\ 0\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}\\frac{1}{2}{e}^{4t}-\\frac{1}{2} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]+[\\begin{aligned}\\frac{1}{2}{e}^{4t}-\\frac{1}{2} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2}{e}^{4t}-\\frac{1}{2} \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}{e}^{4t}-1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186229683 :knowledge-point/_questions [{:db/id #edb/ref 17592186229133 :knowledge-point/id #uuid "4c4b78fa-76af-5261-87a0-d1960aa0fe04" :knowledge-point/title "Proving the Matrix Exponential Formula for IVP Solution of an Inhomogeneous System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c189b4b8-e649-59af-816a-a0162eba91e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{A(t-{t}_{0})}y(t)=x(t)+{t}_{0}" :db/id #edb/ref 17592186370351} {:answer/id #uuid "794bd4e3-c940-5f5b-ac2e-7bed9c9fda49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y({t}_{0})=x({t}_{0})" :db/id #edb/ref 17592186370352} {:answer/id #uuid "39704c3f-642f-5f72-adf4-ba19d22ad47c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(t)={e}^{-A(t-{t}_{0})}x(t)" :db/id #edb/ref 17592186370353} {:answer/id #uuid "c17dbc31-0ce1-56f2-b44e-655f25c7dc56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{′}(t)=Ax(t)+g(t)+{t}_{0}" :db/id #edb/ref 17592186370354}] :answer-field/correct {:answer/id #uuid "794bd4e3-c940-5f5b-ac2e-7bed9c9fda49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y({t}_{0})=x({t}_{0})" :db/id #edb/ref 17592186370352} :answer-field/id #uuid "fda6ab81-45b1-5bf1-8ab0-0c01e2051850" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186370350} {:answer-field/choices [{:answer/id #uuid "782fb0a5-ca2e-5b95-b112-f1d6b4541b99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "applying a change of variables" :db/id #edb/ref 17592186370356} {:answer/id #uuid "9f55c8c5-2761-513a-a8db-cb284e8363cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "substituting ${x}^{′}(t)=Ax(t)+g(t)$" :db/id #edb/ref 17592186370357} {:answer/id #uuid "a540c6e8-5cf1-5239-b2ce-b9c0f9305221" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "evaluating at $t={t}_{0}$" :db/id #edb/ref 17592186370358} {:answer/id #uuid "b377ec22-52b4-5ba4-8938-f3e674edaf05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "substituting ${x}^{′}(t)=Ax(t)+g(t)+{t}_{0}$" :db/id #edb/ref 17592186370359}] :answer-field/correct {:answer/id #uuid "9f55c8c5-2761-513a-a8db-cb284e8363cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "substituting ${x}^{′}(t)=Ax(t)+g(t)$" :db/id #edb/ref 17592186370357} :answer-field/id #uuid "0ac2465d-1b6b-571f-8ad5-