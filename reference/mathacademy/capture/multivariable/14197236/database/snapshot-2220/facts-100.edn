\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186512909 #edb/ref 1072 #uuid "8c12baec-9a09-54f7-8159-4ab5ea602070" #edb/ref 17592186045417] [17592186512909 #edb/ref 1074 "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}4 & 1 \\\\ 0 & 4\\end{aligned}]x(t)+g(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $g(t)=[\\begin{aligned}2 \\\\ 0\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}4 & 1 \\\\ 0 & 4\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=[\\begin{aligned}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{aligned}].\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})}x(0) & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{aligned}][\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}{e}^{4(t-s)} & (t-s){e}^{4(t-s)} \\\\ 0 & {e}^{4(t-s)}\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}{e}^{4(t-s)} & (t-s){e}^{4(t-s)} \\\\ 0 & {e}^{4(t-s)}\\end{aligned}][\\begin{aligned}2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2{e}^{4(t-s)} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}2{e}^{4(t-s)} \\\\ 0\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}\\frac{1}{2}{e}^{4(t-s)} \\\\ 0\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}\\frac{1}{2}{e}^{4t}-\\frac{1}{2} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]+[\\begin{aligned}\\frac{1}{2}{e}^{4t}-\\frac{1}{2} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2}{e}^{4t}-\\frac{1}{2} \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}{e}^{4t}-1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186512943 #edb/ref 1068 #edb/ref 17592186512779 #edb/ref 17592186045417] [17592186512943 #edb/ref 1069 "q-335072" #edb/ref 17592186045417] [17592186512943 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186512943 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=2x(t)+y(t)+1 \\\\ {y}^{′}(t)=2y(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{2t} & t{e}^{2t} \\\\ 0 & {e}^{2t}\\end{aligned}],$ where $A=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\frac{1}{2}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186512943 #edb/ref 1072 #uuid "d29ce693-46aa-5cb5-a64c-988886b4e7a0" #edb/ref 17592186045417] [17592186512943 #edb/ref 1074 "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}]x(t)+g(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $g(t)=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=[\\begin{aligned}{e}^{2t} & t{e}^{2t} \\\\ 0 & {e}^{2t}\\end{aligned}].\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}{e}^{2t} & t{e}^{2t} \\\\ 0 & {e}^{2t}\\end{aligned}][\\begin{aligned}-1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-{e}^{2t} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}{e}^{2(t-s)} & (t-s){e}^{2(t-s)} \\\\ 0 & {e}^{2(t-s)}\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}{e}^{2(t-s)} & (t-s){e}^{2(t-s)} \\\\ 0 & {e}^{2(t-s)}\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{2(t-s)} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}{e}^{2(t-s)} \\\\ 0\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}-\\frac{1}{2}{e}^{2(t-s)} \\\\ 0\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}\\frac{1}{2}{e}^{2t}-\\frac{1}{2} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}-{e}^{2t} \\\\ 0\\end{aligned}]+[\\begin{aligned}\\frac{1}{2}{e}^{2t}-\\frac{1}{2} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{2}{e}^{2t}-\\frac{1}{2} \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}-{e}^{2t}-1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}-{e}^{2t}-1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186512945 #edb/ref 1068 #edb/ref 17592186512794 #edb/ref 17592186045417] [17592186512945 #edb/ref 1069 "q-335070" #edb/ref 17592186045417] [17592186512945 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186512945 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=-x(t)+y(t) \\\\ {y}^{′}(t)=-y(t)+1,\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{-t} & t{e}^{-t} \\\\ 0 & {e}^{-t}\\end{aligned}],$ where $A=[\\begin{aligned}-1 & 1 \\\\ 0 & -1\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">$1-{e}^{-t}-t{e}^{-t}$ </td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186512945 #edb/ref 1072 #uuid "dcde9f99-5a2a-52a5-a122-c3ef3631c507" #edb/ref 17592186045417] [17592186512945 #edb/ref 1074 "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-1 & 1 \\\\ 0 & -1\\end{aligned}]x(t)+g(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $g(t)=[\\begin{aligned}0 \\\\ 1\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}-1 & 1 \\\\ 0 & -1\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=[\\begin{aligned}{e}^{-t} & t{e}^{-t} \\\\ 0 & {e}^{-t}\\end{aligned}].\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}{e}^{-t} & t{e}^{-t} \\\\ 0 & {e}^{-t}\\end{aligned}][\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}{e}^{-(t-s)} & (t-s){e}^{-(t-s)} \\\\ 0 & {e}^{-(t-s)}\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}{e}^{-(t-s)} & (t-s){e}^{-(t-s)} \\\\ 0 & {e}^{-(t-s)}\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}(t-s){e}^{s-t} \\\\ {e}^{s-t}\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}(t-s){e}^{s-t} \\\\ {e}^{s-t}\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}(-s+t+1){e}^{s-t} \\\\ {e}^{s-t}\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}1-(t+1){e}^{-t} \\\\ 1-{e}^{-t}\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]+[\\begin{aligned}1-(t+1){e}^{-t} \\\\ 1-{e}^{-t}\\end{aligned}] \\\\  & =[\\begin{al