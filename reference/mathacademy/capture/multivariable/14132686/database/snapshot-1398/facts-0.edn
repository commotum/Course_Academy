 17592186045417] [17592186307908 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186307908 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186307908 #edb/ref 1078 #edb/ref 17592186306466 #edb/ref 17592186045417] [17592186307908 #edb/ref 1079 #uuid "7b1aebd2-e893-5197-a788-c4691c654614" #edb/ref 17592186045417] [17592186308077 #edb/ref 1075 #edb/ref 17592186305167 #edb/ref 17592186045417] [17592186308077 #edb/ref 1075 #edb/ref 17592186305352 #edb/ref 17592186045417] [17592186308077 #edb/ref 1075 #edb/ref 17592186305815 #edb/ref 17592186045417] [17592186308077 #edb/ref 1075 #edb/ref 17592186306970 #edb/ref 17592186045417] [17592186308077 #edb/ref 1075 #edb/ref 17592186306982 #edb/ref 17592186045417] [17592186308077 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186308077 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186308077 #edb/ref 1078 #edb/ref 17592186306970 #edb/ref 17592186045417] [17592186308077 #edb/ref 1079 #uuid "ae893c59-7e49-5b0c-a55c-55a5f74e450d" #edb/ref 17592186045417] [17592186308322 #edb/ref 1075 #edb/ref 17592186306409 #edb/ref 17592186045417] [17592186308322 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186308322 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186308322 #edb/ref 1078 #edb/ref 17592186306409 #edb/ref 17592186045417] [17592186308322 #edb/ref 1079 #uuid "fb5567f5-30d6-5f84-bad2-a6f285e3a4e6" #edb/ref 17592186045417] [17592186308516 #edb/ref 1068 #edb/ref 17592186308077 #edb/ref 17592186045417] [17592186308516 #edb/ref 1069 "q-333837" #edb/ref 17592186045417] [17592186308516 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186308516 #edb/ref 1071 "Suppose we wish to approximate the solution to an initial value problem using the following numerical method:\n\n$$\n\\begin{aligned}Δy & =(xy+{y}^{2})\\cdot Δx \\\\ {y}_{\\text{new}} & =y+Δy\\end{aligned}\n$$\n\nIf the exact solution is ${y}_{\\text{exact}}(x)=3{x}^{2}+5x,$ find an expression for the local truncation error for the step from $x$ to ${x}_{\\text{new}}=x+Δx.$" #edb/ref 17592186045417] [17592186308516 #edb/ref 1072 #uuid "726f6f46-0815-5100-8694-30312d46b17e" #edb/ref 17592186045417] [17592186308516 #edb/ref 1074 "The local truncation error (LTE) is the error made in a single step of a numerical method, when the step begins from an exact value. The LTE of a numerical method at step $n$ from $x$ with exact value ${y}_{\\text{exact}}$ to ${x}_{\\text{new}}=x+Δx$ is\n\n$$\n\\begin{aligned}{τ}_{n} & ={y}_{\\text{exact}}({x}_{\\text{new}})-{y}_{\\text{new}} \\\\  & ={y}_{\\text{exact}}({x}_{\\text{new}})-({y}_{\\text{exact}}(x)+Δy).\\end{aligned}\n$$\n\nWe're given that the exact solution of the initial value problem is ${y}_{\\text{exact}}(x)=3{x}^{2}+5x.$ Now, let's find the $y$-increment given by the numerical method:\n\n$$\n\\begin{aligned}Δy & =(x\\cdot {y}_{\\text{exact}}(x)+{y}_{\\text{exact}}(x)^{2})\\cdot Δx \\\\  & =(x\\cdot (3{x}^{2}+5x)+(3{x}^{2}+5x)^{2})\\cdot Δx \\\\  & =(3{x}^{3}+5{x}^{2}+9{x}^{4}+30{x}^{3}+25{x}^{2})\\cdot Δx \\\\  & =(9{x}^{4}+33{x}^{3}+30{x}^{2})\\cdot Δx\\end{aligned}\n$$\n\nNext, we compute the exact value at ${x}_{\\text{new}}:$\n\n$$\n\\begin{aligned}{y}_{\\text{exact}}({x}_{\\text{new}}) & =({y}_{\\text{exact}}(x)+Δx) \\\\  & =3(x+Δx)^{2}+5(x+Δx) \\\\  & =3({x}^{2}+2x\\cdot Δx+(Δx)^{2})+5x+5(Δx) \\\\  & =3{x}^{2}+6x\\cdot Δx+3(Δx)^{2}+5x+5(Δx) \\\\  & =3{x}^{2}+5x+(6x+5)\\cdot Δx+3(Δx)^{2}\\end{aligned}\n$$\n\nFinally, we calculate the LTE for step $n$ starting at $x:$\n\n$$\n\\begin{aligned}{τ}_{n} & ={y}_{\\text{exact}}({x}_{\\text{new}})-{y}_{\\text{new}} \\\\  & =[3{x}^{2}+5x+(6x+5)\\cdot Δx+3(Δx)^{2}]-[3{x}^{2}+5x+(9{x}^{4}+33{x}^{3}+30{x}^{2})\\cdot Δx] \\\\  & =3{x}^{2}-3{x}^{2}+5x-5x+(6x+5)\\cdot Δx+3(Δx)^{2}-(9{x}^{4}+33{x}^{3}+30{x}^{2})\\cdot Δx \\\\  & =(6x+5)\\cdot Δx+3(Δx)^{2}-(9{x}^{4}+33{x}^{3}+30{x}^{2})\\cdot Δx \\\\  & =(-9{x}^{4}-33{x}^{3}-30{x}^{2}+6x+5)\\cdot Δx+3(Δx)^{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186308517 #edb/ref 1068 #edb/ref 17592186307854 #edb/ref 17592186045417] [17592186308517 #edb/ref 1069 "q-333838" #edb/ref 17592186045417] [17592186308517 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186308517 #edb/ref 1071 "Suppose we wish to approximate the solution to an initial value problem using the following numerical method:\n\n$$\n\\begin{aligned}Δy & =\\operatorname{ln}⁡(x+y)\\cdot Δx \\\\ {y}_{\\text{new}} & =y+Δy\\end{aligned}\n$$\n\nIf the exact solution is ${y}_{\\text{exact}}(x)={x}^{2}+1,$ find an expression for the local truncation error for the step from $x$ to ${x}_{\\text{new}}=x+Δx.$" #edb/ref 17592186045417] [17592186308517 #edb/ref 1072 #uuid "baf3125d-0d25-502b-857d-9bbe768e2a62" #edb/ref 17592186045417] [17592186308517 #edb/ref 1074 "The local truncation error (LTE) is the error made in a single step of a numerical method, when the step begins from an exact value. The LTE of a numerical method at step $n$ from $x$ with exact value ${y}_{\\text{exact}}$ to ${x}_{\\text{new}}=x+Δx$ is\n\n$$\n\\begin{aligned}{τ}_{n} & ={y}_{\\text{exact}}({x}_{\\text{new}})-{y}_{\\text{new}} \\\\  & ={y}_{\\text{exact}}({x}_{\\text{new}})-({y}_{\\text{exact}}(x)+Δy).\\end{aligned}\n$$\n\nWe're given that the exact solution of the initial value problem is ${y}_{\\text{exact}}(x)={x}^{2}+1.$ Now, let's find the $y$-increment given by the numerical method:\n\n$$\n\\begin{aligned}Δy & =\\operatorname{ln}⁡(x+{y}_{\\text{exact}}(x))\\cdot Δx \\\\  & =\\operatorname{ln}⁡(x+{x}^{2}+1)\\cdot Δx \\\\  & =\\operatorname{ln}⁡({x}^{2}+x+1)\\cdot Δx\\end{aligned}\n$$\n\nNext, we compute the exact value at ${x}_{\\text{new}}:$\n\n$$\n\\begin{aligned}{y}_{\\text{exact}}({x}_{\\text{new}}) & =({y}_{\\text{exact}}(x)+Δx) \\\\  & =(x+Δx)^{2}+1 \\\\  & ={x}^{2}+2x\\cdot Δx+(Δx)^{2}+1\\end{aligned}\n$$\n\nFinally, we calculate the LTE for step $n$ starting at $x:$\n\n$$\n\\begin{aligned}{τ}_{n} & ={y}_{\\text{exact}}({x}_{\\text{new}})-{y}_{\\text{new}} \\\\  & =[{x}^{2}+2x\\cdot Δx+(Δx)^{2}+1]-[{x}^{2}+1+\\operatorname{ln}⁡({x}^{2}+x+1)\\cdot Δx] \\\\  & ={x}^{2}-{x}^{2}+1-1+(2x-\\operatorname{ln}⁡({x}^{2}+x+1))\\cdot Δx+(Δx)^{2} \\\\  & =(2x-\\operatorname{ln}⁡({x}^{2}+x+1))\\cdot Δx+(Δx)^{2}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186308631 #edb/ref 1068 #edb/ref 17592186307620 #edb/ref 17592186045417] [17592186308631 #edb/ref 1068 #edb/ref 17592186307715 #edb/ref 17592186045417] [17592186308631 #edb/ref 1068 #edb/ref 17592186307908 #edb/ref 17592186045417] [17592186308631 #edb/ref 1069 "q-334486" #edb/ref 17592186045417] [17592186308631 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186308631 #edb/ref 1071 "A numerical method is used to approximate a solution to an initial value problem, resulting in the table below. If the exact solution is $y(x)=\\frac{1}{2}{x}^{2}+1,$ find, rounded to three decimal places, the global truncation error at each step.\n\n| $n$ | ${x}_{n}$ | ${y}_{n}$ | ${e}_{n}$ |\n| --- | --- | --- | --- |\n| $0$ | $0$ | $1$ | $0$ |\n| $1$ | $0.2$ | $1.010$ | {{field-1}} |\n| $2$ | $0.4$ | $1.040$ | {{field-2}} |\n| $3$ | $0.7$ | $1.140$ | {{field-3}} |" #edb/ref 17592186045417] [17592186308631 #edb/ref 1072 #uuid "c8e645d5-fc08-5104-ac6e-e5cda6447fc9" #edb/ref 17592186045417] [17592186308631 #edb/ref 1074 "The global truncation error (GTE) is the total error accumulated after several steps of a numerical method. The GTE of a numerical method at step $n$ from ${x}_{n-1}$ to ${x}_{n}={x}_{n-1}+Δx$ is\n\n$$\n{e}_{n}=y({x}_{n})-{y}_{n},\n$$\n\nwhere $y({x}_{n})$ is the exact value at ${x}_{n},$ and ${y}_{n}$ is the numerical value produced after $n$ steps.\n\nWe are given the numerical values ${y}_{n}$ produced at each step in the table. Now, we compute the exact value $y({x}_{n})$ at each value of ${x}_{n}:$\n\n- The exact value at ${x}_{0}=0$ is $y(0)=\\frac{1}{2}(0)^{2}+1=1.$\n\n- The exact value at ${x}_{1}=0.2$ is $y(0.2)=\\frac{1}{2}(0.2)^{2}+1.$\n\n- The exact value at ${x}_{2}=0.4$ is $y(0.4)=\\frac{1}{2}(0.4)^{2}+1.$\n\n- The exact value at ${x}_{3}=0.7$ is $y(0.7)=\\frac{1}{2}(0.7)^{2}+1.$\n\nLet's add these values to the table.\n\n| $n$ | ${x}_{n}$ | ${y}_{n}$ | $y({x}_{n})$ | ${e}_{n}$ |\n| --- | --- | --- | --- | --- |\n| $0$ | $0$ | $1$ | $1$ | $0$ |\n| $1$ | $0.2$ | $1.010$ | $\\frac{1}{2}(0.2)^{2}+1$ |  |\n| $2$ | $0.4$ | $1.040$ | $\\frac{1}{2}(0.4)^{2}+1$ |  |\n| $3$ | $0.7$ | $1.140$ | $\\frac{1}{2}(0.7)^{2}+1$ |  |\n\nFinally, we find the GTE at each step, rounding to three decimal places in each case:\n\n- The GTE of the first step is\n\n$$\n\\begin{aligned}{e}_{1} & =y({x}_{1})-{y}_{1} \\\\  & =\\frac{1}{2}(0.2)^{2}+1-1.010 \\\\  & =0.010.\\end{aligned}\n$$\n\n- The GTE of the second step is\n\n$$\n\\begin{aligned}{e}_{2} & =y({x}_{2})-{y}_{2} \\\\  & =\\frac{1}{2}(0.4)^{2}+1-1.040 \\\\  & =0.040.\\end{aligned}\n$$\n\n- The GTE of the third step is\n\n$$\n\\begin{aligned}{e}_{3} & =y({x}_{3})-{y}_{3} \\\\  & =\\frac{1}{2}(0.7)^{2}+1-1.140 \\\\  & =0.105.\\end{aligned}\n$$\n\nTherefore, the completed table is as given below.\n\n| $n$ | ${x}_{n}$ | ${y}_{n}$ | $y({x}_{n})$ | ${e}_{n}$ |\n| --- | --- | --- | --- | --- |\n| $0$ | $0$ | $1$ | $1$ | $0$ |\n| $1$ | $0.2$ | $1.010$ | $\\frac{1}{2}(0.2)^{2}+1$ | $0.010$ |\n| $2$ | $0.4$ | $1.040$ | $\\frac{1}{2}(0.4)^{2}+1$ | $0.040$ |\n| $3$ | $0.7$ | $1.140$ | $\\frac{1}{2}(0.7)^{2}+1$ | $0.105$ |" #edb/ref 17592186045417] [17592186308632 #edb/ref 1068 #edb/ref 17592186307536 #edb/ref 17592186045417] [17592186308632 #edb/ref 1068 #edb/ref 17592186307656 #edb/ref 17592186045417] [17592186308632 #edb/ref 1068 #edb/ref 17592186308322 #edb/ref 17592186045417] [17592186308632 #edb/ref 1069 "q-334489" #edb/ref 17592186045417] [17592186308632 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186308632 #edb/ref 1071 "A numerical method is used to approximate a solution to an initial value problem, resulting in the table below. If the exact solution is $y(x)=\\sqrt{1+{x}^{2}},$ find, rounded to three decimal places, the global truncation error at each step.\n\n| $n$ | ${x}_{n}$ | ${y}_{n}$ | ${e}_{n}$ |\n| --- | --- | --- | --- |\n| $0$ | $0$ | $1$ | $0$ |\n| $1$ | $0.25$ | $1.030$ | {{field-1}} |\n| $2$ | $0.5$ | $1.100$ | {{field-2}} |\n| $3$ | $0.75$ | $1.230$ | {{field-3}} |" #edb/ref 17592186045417] [17592186308632 #edb/ref 1072 #uuid "967bfe51-8535-5865-8de7-5112e7c8da0b" #edb/ref 17592186045417] [17592186308632 #edb/ref 1074 "The global truncation error (GTE) is the total error accumulated after several steps of a numerical method. The GTE of a numerical method at step $n$ from ${x}_{n-1}$ to ${x}_{n}={x}_{n-1}+Δx$ is\n\n$$\n{e}_{n}=y({x}_{n})-{y}_{n},\n$$\n\nwhere $y({x}_{n})$ is the exact value at ${x}_{n},$ and ${y}_{n}$ is the numerical value produced after $n$ steps.\n\nWe are given the numerical values ${y}_{n}$ produced at each step in the table. Now, we compute the exact value $y({x}_{n})$ at each value of ${x}_{n}:$\n\n- The exact value at ${x}_{0}=0$ is $y(0)=\\sqrt{1+{0}^{2}}=1.$\n\n- The exact value at ${x}_{1}=0.25$ is $y(0.25)=\\sqrt{1+(0.25)^{2}}.$\n\n- The exact value at ${x}_{2}=0.5$ is $y(0.5)=\\sqrt{1+(0.5)^{2}}.$\n\n- The exact value at ${x}_{3}=0.75$ is $y(0.75)=\\sqrt{1+(0.75)^{2}}.$\n\nLet's add these values to the table.\n\n| $n$ | ${x}_{n}$ | ${y}_{n}$ | $y({x}_{n})$ | ${e}_{n}$ |\n| --- | --- | --- | --- | --- |\n| $0$ | $0$ | $1$ | $1$ | $0$ |\n| $1$ | $0.25$ | $1.030$ | $\\sqrt{1+(0.25)^{2}}$ |  |\n| $2$ | $0.5$ | $1.100$ | $\\sqrt{1+(0.5)^{2}}$ |  |\n| $3$ | $0.75$ | $1.230$ | $\\sqrt{1+(0.75)^{2}}$ |  |\n\nFinally, we find the GTE at each step, rounding to three decimal places in each case:\n\n- The GTE of the first step is\n\n$$\n\\begin{aligned}{e}_{1} & =y({x}_{1})-{y}_{1} \\\\  & =\\sqrt{1+(0.25)^{2}}-1.030 \\\\  & ≈0.001.\\end{aligned}\n$$\n\n- The GTE of the second step is\n\n$$\n\\begin{aligned}{e}_{2} & =y({x}_{2})-{y}_{2} \\\\  & =\\sqrt{1+(0.5)^{2}}-1.100 \\\\  & ≈0.018.\\end{aligned}\n$$\n\n- The GTE of the third step is\n\n$$\n\\begin{aligned}{e}_{3} & =y({x}_{3})-{y}_{3} \\\\  & =\\sqrt{1+(0.75)^{2}}-1.230 \\\\  & =0.020.\\end{aligned}\n$$\n\nTherefore, the completed table is as given below.\n\n| $n$ | ${x}_{n}$ | ${y}_{n}$ | $y({x}_{n})$ | ${e}_{n}$ |\n| --- | --- | --- | --- | --- |\n| $0$ | $0$ | $1$ | $1$ | $0$ |\n| $1$ | $0.25$ | $1.030$ | $\\sqrt{1+(0.25)^{2}}$ | $0.001$ |\n| $2$ | $0.5$ | $1.100$ | $\\sqrt{1+(0.5)^{2}}$ | $0.018$ |\n| $3$ | $0.75$ | $1.230$ | $\\sqrt{1+(0.75)^{2}}$ | $0.020$ |" #edb/ref 17592186045417] [17592186433562 #edb/ref 1080 "-0.003" #edb/ref 17592186045417] [17592186433562 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186433562 #edb/ref 1083 #uuid "070795fc-61ca-597e-9a52-6ea22d8e9b4d" #edb/ref 17592186045417] [17592186433563 #edb/ref 1080 "-0.001" #edb/ref 17592186045417] [17592186433563 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186433563 #edb/ref 1083 #uuid "07626de1-5e6b-55e7-b945-409da489d200" #edb/ref 17592186045417] [17592186433564 #edb/ref 1080 "0.773" #edb/ref 17592186045417] [17592186433564 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186433564 #edb/ref 1083 #uuid "22719ae7-bcde-57eb-9c63-c4a0060ab2b6" #edb/ref 17592186045417] [17592186433565 #edb/ref 1080 "-0.002" #edb/ref 17592186045417] [17592186433565 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186433565 #edb/ref 1083 #uuid "68ea8446-6ec7-5d53-833e-6da073d1e40c" #edb/ref 17592186045417] [17592186433566 #edb/ref 1080 "0.007" #edb/ref 17592186045417] [17592186433566 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186433566 #edb/ref 1083 #uuid "a9f9ab51-ea1d-532c-a7fa-adb5fd089752" #edb/ref 17592186045417] [17592186433567 #edb/ref 1080 "0.005" #edb/ref 17592186045417] [17592186433567 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186433567 #edb/ref 1