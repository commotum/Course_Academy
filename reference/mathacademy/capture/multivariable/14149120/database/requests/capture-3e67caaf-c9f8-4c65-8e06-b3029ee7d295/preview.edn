17 true] [17592186444616 1076 #edb/ref 17592186045493 13194139534928 17592186045417 true] [17592186444616 1077 "selection" 13194139534928 17592186045417 true] [17592186444616 1078 #edb/ref 17592186444611 13194139534928 17592186045417 true] [17592186444616 1079 #uuid "5c6a2aa9-7d14-5b93-966f-5ef76762e118" 13194139534928 17592186045417 true] [17592186444617 1075 #edb/ref 17592186444601 13194139534928 17592186045417 true] [17592186444617 1075 #edb/ref 17592186444603 13194139534928 17592186045417 true] [17592186444617 1075 #edb/ref 17592186444607 13194139534928 17592186045417 true] [17592186444617 1075 #edb/ref 17592186444612 13194139534928 17592186045417 true] [17592186444617 1075 #edb/ref 17592186444614 13194139534928 17592186045417 true] [17592186444617 1076 #edb/ref 17592186045493 13194139534928 17592186045417 true] [17592186444617 1077 "selection" 13194139534928 17592186045417 true] [17592186444617 1078 #edb/ref 17592186444614 13194139534928 17592186045417 true] [17592186444617 1079 #uuid "6ac4cbf3-d6da-5e60-8eb4-cf067330135d" 13194139534928 17592186045417 true] [17592186444618 1068 #edb/ref 17592186444617 13194139534928 17592186045417 true] [17592186444618 1069 "q-162158" 13194139534928 17592186045417 true] [17592186444618 1070 #edb/ref 17592186045487 13194139534928 17592186045417 true] [17592186444618 1071 "Consider the vector field $F(x,y,z)=⟨z+5,\\,x-2y,\\,3x-2y⟩$ and a finite region $S$ of the plane $z=x+2y+1$ such that $\\text{Area}(S)=\\sqrt{2}.$ Calculate the flux of $F$ through $S$ with respect to the *downward*-pointing unit normal vector $n.$" 13194139534928 17592186045417 true] [17592186444618 1072 #uuid "2ae7b222-1017-5e06-9f85-8323117b3184" 13194139534928 17592186045417 true] [17592186444618 1074 "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that our surface $z=x+2y+1$ can be written using the dot product as \n\n$$\n⟨x,\\,y,\\,z⟩\\cdot {{⟨-1,\\,-2,\\,1⟩}_{⏟}}_{\\overset{~}{n}}=1,\\,\\text{or}\\,⟨x,\\,y,\\,z⟩\\cdot {{⟨1,\\,2,\\,-1⟩}_{⏟}}_{-\\overset{~}{n}}=-1.\n$$\n\nSince we require a downward-pointing normal vector to our surface $S,$ we must select one where the $z$-component is negative. This gives us the normal vector\n\n$$\n\\overset{~}{n}=⟨1,\\,2,\\,-1⟩.\n$$\n\nNormalizing this vector, we get\n\n$$\n\\begin{aligned}n & =\\frac{\\overset{~}{n}}{‖\\overset{~}{n}‖} \\\\  & =\\frac{⟨1,\\,2,\\,-1⟩}{\\sqrt{{1}^{2}+{2}^{2}+(-1)^{2}}} \\\\  & =\\frac{1}{\\sqrt{6}}⟨1,\\,2,\\,-1⟩.\\end{aligned}\n$$\n\nUsing the fact that $z=x+2y+1$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨z+5,\\,x-2y,\\,3x-2y⟩\\cdot \\frac{1}{\\sqrt{6}}⟨1,\\,2,\\,-1⟩ \\\\  & =\\frac{1}{\\sqrt{6}}⟨x+2y+6,\\,x-2y,\\,3x-2y⟩\\cdot ⟨1,\\,2,\\,-1⟩ \\\\  & =\\frac{1}{\\sqrt{6}}((x+2y+6)+2(x-2y)-(3x-2y)) \\\\  & =\\frac{1}{\\sqrt{6}}(x+2y+6+2x-4y-3x+2y) \\\\  & =\\frac{6}{\\sqrt{6}} \\\\  & =\\sqrt{6}.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}\\sqrt{6}\\,\\text{d}S \\\\  & =\\sqrt{6}{∬}_{S}\\,\\text{d}S \\\\  & =\\sqrt{6}\\cdot \\text{Area}(S) \\\\  & =\\sqrt{6}\\cdot \\sqrt{2} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$" 13194139534928 17592186045417 true] [17592186444619 1068 #edb/ref 17592186444616 13194139534928 17592186045417 true] [17592186444619 1069 "q-161193" 13194139534928 17592186045417 true] [17592186444619 1070 #edb/ref 17592186045487 13194139534928 17592186045417 true] [17592186444619 1071 "Consider the vector field $F(x,y,z)=⟨z,\\,y,\\,x⟩$ and the surface $S$ defined in Cartesian coordinates as $z=x+y$ for $0\\le x\\le 3$ and $0\\le y\\le 1.$ Calculate the flux of $F$ through $S$ with respect to the upward-pointing unit normal vector $n.$\n\n*Hint: You're given that the fundamental vector product of $S$ with respect to its canonical parametrization is $||{r}_{x}\\times {r}_{y}||=\\sqrt{3}.$*" 13194139534928 17592186045417 true] [17592186444619 1072 #uuid "627a222e-9363-5b8b-b1ec-0730c89cfcbe" 13194139534928 17592186045417 true] [17592186444619 1074 "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that our surface $z=x+y$ can be written using the dot product as \n\n$$\n⟨x,\\,y,\\,z⟩\\cdot {{⟨-1,\\,-1,\\,1⟩}_{⏟}}_{\\overset{~}{n}}=0,\\,\\text{or}\\,⟨x,\\,y,\\,z⟩\\cdot {{⟨1,\\,1,\\,-1⟩}_{⏟}}_{-\\overset{~}{n}}=0.\n$$\n\nSince we require an upward-pointing normal vector to our surface $S,$ we must select one where the $z$-component is positive. This gives us the normal vector\n\n$$\n\\overset{~}{n}=⟨-1,\\,-1,\\,1⟩.\n$$\n\nNormalizing this vector, we get\n\n$$\n\\begin{aligned}n & =\\frac{\\overset{~}{n}}{‖\\overset{~}{n}‖} \\\\  & =\\frac{⟨-1,\\,-1,\\,1⟩}{\\sqrt{(-1)^{2}+(-1)^{2}+{1}^{2}}} \\\\  & =\\frac{1}{\\sqrt{3}}⟨-1,\\,-1,\\,1⟩.\\end{aligned}\n$$\n\nUsing the fact that $z=x+y$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨z,\\,y,\\,x⟩\\cdot \\frac{1}{\\sqrt{3}}⟨-1,\\,-1,\\,1⟩ \\\\  & =\\frac{1}{\\sqrt{3}}⟨x+y,\\,y,\\,x⟩\\cdot ⟨-1,\\,-1,\\,1⟩ \\\\  & =\\frac{1}{\\sqrt{3}}(-(x+y)-y+x) \\\\  & =\\frac{1}{\\sqrt{3}}(-2y) \\\\  & =-\\frac{2}{\\sqrt{3}}\\,y.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}(-\\frac{2}{\\sqrt{3}}\\,y)\\,\\text{d}S \\\\  & ={∬}_{D}(-\\frac{2}{\\sqrt{3}}\\,y)\\cdot ||{r}_{x}\\times {r}_{y}||\\,\\text{d}A \\\\  & ={∬}_{D}-\\frac{2}{\\sqrt{3}}y\\cdot \\sqrt{3}\\,\\text{d}A \\\\  & ={∬}_{D}-\\frac{2}{\\cancel{\\sqrt{3}}}y\\cdot \\cancel{\\sqrt{3}}\\,\\text{d}A \\\\  & ={∬}_{D}-2y\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{3}-2y\\,\\text{d}x\\,\\text{d}y \\\\  & =-{\\int }_{0}^{1}2y\\,\\text{d}y\\cdot {\\int }_{0}^{3}\\,\\text{d}x \\\\  & =-[{y}^{2}]_{0}^{1}\\cdot [x]_{0}^{3} \\\\  & =-1\\cdot 3 \\\\  & =-3\\end{aligned}\n$$" 13194139534928 17592186045417 true] [17592186444620 1058 #edb/ref 17592186444623 13194139534928 17592186045417 true] [17592186444620 1062 #uuid "03b4b191-1c32-5328-8c44-46701817acdf" 13194139534928 17592186045417 true] [17592186444620 1063 #edb/ref 17592186167127 13194139534928 17592186045417 true] [17592186444621 1062 #uuid "0ad1dc8f-1c73-5500-a47a-c0fda9ab766e" 13194139534928 17592186045417 true] [17592186444621 1063 #edb/ref 17592186444618 13194139534928 17592186045417 true] [17592186444622 1058 #edb/ref 17592186444621 13194139534928 17592186045417 true] [17592186444622 1062 #uuid "8d884d62-3c79-5671-b709-2a062cef2457" 13194139534928 17592186045417 true] [17592186444622 1063 #edb/ref 17592186278421 13194139534928 17592186045417 true] [17592186444623 1058 #edb/ref 17592186444624 13194139534928 17592186045417 true] [17592186444623 1062 #uuid "b60e2d93-3137-5009-9f82-8e66614f6b08" 13194139534928 17592186045417 true] [17592186444623 1063 #edb/ref 17592186444619 13194139534928 17592186045417 true] [17592186444624 1058 #edb/ref 17592186444622 13194139534928 17592186045417 true] [17592186444624 1062 #uuid "de780f69-4606-5409-93bc-2ffc77e5cb9b" 13194139534928 17592186045417 true] [17592186444624 1063 #edb/ref 17592186401219 13194139534928 17592186045417 true]] :edb/tempids {"activity-0bdff687-f8d4-5855-9373-b5ab9e4534b8" 17592186444600 "answer-23676b92-59ce-549e-bb44-0ce2c22aff60" 17592186444601 "answer-2e7ca8ec-891f-5ccc-985b-4e4a85531ac2" 17592186444602 "answer-30a14e60-74d3-59a0-9d7c-8bfb0dc4a3c2" 17592186444603 "answer-3ccaaf5e-0e10-5c99-a0bc-d8a834cb86f3" 17592186444604 "answer-51f5f2fd-94a6-51c3-ac48-99d59a93e907" 17592186444605 "answer-8524a039-125d-5c28-8aaa-2b417ce25d91" 17592186444606 "answer-8c7915a4-09c6-54d8-8b86-d3abcf69