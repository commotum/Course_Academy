1caaf9c-6b9b-5711-a434-21f0416e6c7e" :knowledge-point/title "Rewriting a Flux Integral as a Surface Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "419c0982-db99-5289-b52f-a761ea3d1bae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y-x-2{z}^{2}" :db/id #edb/ref 17592186401221} {:answer/id #uuid "d412c461-4939-5aa5-9ddd-df78a8e85bc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y+{z}^{2}" :db/id #edb/ref 17592186401222} {:answer/id #uuid "a93a034f-199c-5c52-af3b-9d0a37596a31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y+{z}^{2}" :db/id #edb/ref 17592186401223} {:answer/id #uuid "dfbb580a-2ddc-5e43-a8f4-c46a6440cff0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y-x" :db/id #edb/ref 17592186401224} {:answer/id #uuid "e9a49a16-7b19-549f-8e35-18199cc77301" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2{z}^{2}" :db/id #edb/ref 17592186401225}] :answer-field/correct {:answer/id #uuid "dfbb580a-2ddc-5e43-a8f4-c46a6440cff0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2y-x" :db/id #edb/ref 17592186401224} :answer-field/id #uuid "a21eed7a-f07f-5d01-b24f-3b6ba15f83ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401220}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd68aee4-128c-55a1-8849-b847e40933c1" :question/math-academy-id "q-161198" :question/problem "Consider the vector field $F$ and the surface $S$ with unit normal vector $n,$ where\n\n$$\nF(x,y,z)=⟨{z}^{2},\\,x,\\,y-{z}^{2}⟩\\,,\\,n(x,y,z)=\\frac{1}{3}⟨2,\\,-1,\\,2⟩\\,.\n$$\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S=\\frac{1}{3}{∬}_{S}\\boxed{}\\,\\text{d}S,\n$$\n\nwhat is the missing expression?" :question/worked-solution "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nCalculating the dot product, we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨{z}^{2},\\,x,\\,y-{z}^{2}⟩\\cdot \\frac{1}{3}⟨2,\\,-1,\\,2⟩ \\\\  & =\\frac{1}{3}⟨{z}^{2},\\,x,\\,y-{z}^{2}⟩\\cdot ⟨2,\\,-1,\\,2⟩ \\\\  & =\\frac{1}{3}(2{z}^{2}-x+2(y-{z}^{2})) \\\\  & =\\frac{2y-x}{3}.\\end{aligned}\n$$\n\nTherefore, the flux can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}\\frac{2y-x}{3}\\,\\text{d}S \\\\  & =\\frac{1}{3}{∬}_{S}2y-x\\,\\text{d}S.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278421 :knowledge-point/_questions [{:db/id #edb/ref 17592186166880 :knowledge-point/id #uuid "21caaf9c-6b9b-5711-a434-21f0416e6c7e" :knowledge-point/title "Rewriting a Flux Integral as a Surface Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2720bb2d-ef3c-5bd3-b5d1-47e2a36e5b59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy+yz+xz" :db/id #edb/ref 17592186275834} {:answer/id #uuid "30f13b93-277e-5c15-b9c8-932581f5f992" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy-2yz+xz" :db/id #edb/ref 17592186275912} {:answer/id #uuid "3b883b06-8332-53dc-bb7f-68fb90e59ae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3xz-yz" :db/id #edb/ref 17592186275997} {:answer/id #uuid "74a4ce69-d793-5db1-9424-5b3b421ad0a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}{y}^{2}{z}^{2}" :db/id #edb/ref 17592186276532} {:answer/id #uuid "8f857f74-c7bf-534b-90d2-dc5735bc9d12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy-yz+2xz" :db/id #edb/ref 17592186276777}] :answer-field/correct {:answer/id #uuid "8f857f74-c7bf-534b-90d2-dc5735bc9d12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "xy-yz+2xz" :db/id #edb/ref 17592186276777} :answer-field/id #uuid "74b1826a-ee9f-5272-9977-4058c1ea92ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277932}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe4ccf73-c8f1-5e87-8e15-f27def60e911" :question/math-academy-id "q-161200" :question/problem "Consider the vector field $F$ and the surface $S$ with unit normal vector $n,$ where\n\n$$\nF(x,y,z)=⟨xy,\\,yz,\\,xz⟩\\,,\\,n(x,y,z)=\\frac{1}{\\sqrt{6}}⟨1,\\,-1,\\,2⟩\\,.\n$$\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S=\\frac{1}{\\sqrt{6}}{∬}_{S}\\boxed{}\\,\\text{d}S,\n$$\n\nwhat is the missing expression?" :question/worked-solution "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nCalculating the dot product, we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨xy,\\,yz,\\,xz⟩\\cdot \\frac{1}{\\sqrt{6}}⟨1,\\,-1,\\,2⟩ \\\\  & =\\frac{1}{\\sqrt{6}}⟨xy,\\,yz,\\,xz⟩\\cdot ⟨1,\\,-1,\\,2⟩ \\\\  & =\\frac{1}{\\sqrt{6}}(xy-yz+2xz) \\\\  & =\\frac{xy-yz+2xz}{\\sqrt{6}}.\\end{aligned}\n$$\n\nTherefore, the flux can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}\\frac{xy-yz+2xz}{\\sqrt{6}}\\,\\text{d}S \\\\  & =\\frac{1}{\\sqrt{6}}{∬}_{S}xy-yz+2xz\\,\\text{d}S.\\end{aligned}\n$$"}]}
