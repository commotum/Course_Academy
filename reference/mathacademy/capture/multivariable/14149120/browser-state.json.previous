</mi><mo>+</mo><mn>2</mn><mi>x</mi><mi>z</mi></mrow><msqrt><mn>6</mn></msqrt></mfrac></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>S</mi></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>1</mn><msqrt><mn>6</mn></msqrt></mfrac></mstyle><munder><mo data-mjx-texclass=\"OP\">∬</mo><mi>S</mi></munder><mstyle style=\"border: 1pt solid black\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mi>x</mi><mi>y</mi><mo>−</mo><mi>y</mi><mi>z</mi><mo>+</mo><mn>2</mn><mi>x</mi><mi>z</mi></mstyle></mpadded></mstyle><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>S</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
