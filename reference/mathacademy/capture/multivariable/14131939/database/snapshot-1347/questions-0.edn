cae4df6.png)\n\nNotice that the positive orientation of the inner curve ${C}_{2}$ is opposite that of ${C}_{2}$ as stated in the question.\n\nTherefore, we have\n\n$$\n\\begin{aligned}{∮}_{∂D}F\\cdot \\text{d}r & ={∮}_{{C}_{1}}F\\cdot \\text{d}r-{∮}_{{C}_{2}}F\\cdot \\text{d}r+{∮}_{{C}_{3}}F\\cdot \\text{d}r \\\\  & =2-9+8 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186431348 :knowledge-point/_questions [{:db/id #edb/ref 17592186133899 :knowledge-point/id #uuid "56caab23-f54d-58ee-99db-99c651f78e5c" :knowledge-point/title "Calculating the Circulation of a Vector Field Over a Region Containing Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30cf36fe-619f-5674-b7fc-e49a2947c716" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186431294} {:answer/id #uuid "4651760e-93e4-58a5-b28b-660b7c2991f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186431304} {:answer/id #uuid "91afb9b0-08b1-5b1f-a644-99141e4a54c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186431317} {:answer/id #uuid "c98ea491-6e86-51b5-b678-6ad024bc1f47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186431331} {:answer/id #uuid "ec3ca01a-910d-58fa-950d-d1c7ecc9fed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186431335}] :answer-field/correct {:answer/id #uuid "c98ea491-6e86-51b5-b678-6ad024bc1f47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186431331} :answer-field/id #uuid "d6c20d1b-8be1-5cba-93e4-c9f5ddddc294" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431347}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "084d8c6c-71d5-5e51-afa2-e1398eb868b9" :question/math-academy-id "q-126868" :question/problem "![](images/5e/5e11606627f4b91c977670cf9f919aff8b659cb5b4776cf3d04bb561b50b79fb.png)\n\nSuppose that $F$ is a vector field on ${R}^{2}$ defined over the region $D$ above. Given that \n\n$$\n{∮}_{{C}_{1}}F\\cdot \\text{d}r=4,\\,{∮}_{{C}_{2}}F\\cdot \\text{d}r=-6,\\,{∮}_{{C}_{3}}F\\cdot \\text{d}r=-8,\n$$\n\nwhere ${C}_{1},$ ${C}_{2},$ and ${C}_{3}$ are oriented clockwise, calculate the value of ${∮}_{∂D}F\\cdot \\text{d}r.$" :question/worked-solution "To calculate the total circulation of a vector field over the boundary of a region containing holes, we add together the circulations over each *positively oriented* boundary.\n\nRemember that:\n\n- the positive direction is *counterclockwise* for the *outer* curve ${C}_{1}$ (because the region $D$ is always on the left as we traverse ${C}_{1}$ counterclockwise), and\n\n- the positive direction is *clockwise* for the *inner* curves ${C}_{2}$ and ${C}_{3}$ (because the region $D$ is always on the left as we traverse ${C}_{2}$ and ${C}_{3}$ clockwise).\n\nThe diagram below shows the positive orientations of all three curves.\n\n![](images/fa/fa1022d2a1718627898289abdd4d3035a6e06230eea16d0e46832675b2e37def.png)\n\nNotice that the positive orientation of the outer curve ${C}_{1}$ is opposite that of ${C}_{1}$ as stated in the question.\n\nTherefore, we have\n\n$$\n\\begin{aligned}{∮}_{∂D}F\\cdot \\text{d}r & =-{∮}_{{C}_{1}}F\\cdot \\text{d}r+{∮}_{{C}_{2}}F\\cdot \\text{d}r+{∮}_{{C}_{3}}F\\cdot \\text{d}r \\\\  & =-4+(-6)+(-8) \\\\  & =-18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186431354 :knowledge-point/_questions [{:db/id #edb/ref 17592186133886 :knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0918efff-3716-5e79-bc16-ce01b647dee2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186431283} {:answer/id #uuid "0a4ab89c-0bd1-5d9d-bbfe-405c2f326073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186431284} {:answer/id #uuid "b158c6b6-52a5-5218-9685-8e39e2b380c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186431323} {:answer/id #uuid "b1f98841-106f-5d7f-bf0f-b27f11e0da85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186431324} {:answer/id #uuid "fe684fde-4550-539f-a64b-9a955faeea4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186431337}] :answer-field/correct {:answer/id #uuid "b1f98841-106f-5d7f-bf0f-b27f11e0da85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186431324} :answer-field/id #uuid "1eb80ec8-d8a5-5f3b-808d-db46b94db516" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431339}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a2fd9b28-2de8-59c7-8e8c-46e14a79f680" :question/math-academy-id "q-126880" :question/problem "![](images/65/65047f9bf4f035000175fc55ee3ba6eeb4aa7ec39674a1984b95ba98a3f754f6.png)\n\nCalculate ${∮}_{∂D}8y\\,dx+13x\\,dy,$ where $D$ is the region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=8y$ and $Q(x,y)=13x.$ So,  \n\n$$\n\\frac{∂P}{∂y}=8,\\,\\frac{∂Q}{∂x}=13.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}8y\\,dx+13x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(13-8)\\,\\text{d}A \\\\  & ={∬}_{D}5\\,\\text{d}A \\\\  & =5\\,{∬}_{D}\\,\\text{d}A \\\\  & =5\\cdot \\text{Area}(D) \\\\  & =5\\cdot (\\frac{6\\cdot 6}{2}-{2}^{2}) \\\\  & =5\\cdot (18-4) \\\\  & =70.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186431352 :knowledge-point/_questions [{:db/id #edb/ref 17592186133886 :knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "220be106-05bc-5093-b00a-7db60bd8ecaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\pi " :db/id #edb/ref 17592186431288} {:answer/id #uuid "37256756-976d-5c9b-9621-726f21d7d740" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48\\pi " :db/id #edb/ref 17592186431295} {:answer/id #uuid "3add5703-5575-518a-8fb6-785fcc0ae348" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\pi " :db/id #edb/ref 17592186431297} {:answer/id #uuid "b5c51c42-3a40-510d-8c2c-1c2f6b8e0682" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42\\pi " :db/id #edb/ref 17592186431327} {:answer/id #uuid "ddae96ae-32de-50a4-bd74-13c0f92807b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84\\pi " :db/id #edb/ref 17592186431334}] :answer-field/correct {:answer/id #uuid "ddae96ae-32de-50a4-bd74-13c0f92807b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84\\pi " :db/id #edb/ref 17592186431334} :answer-field/id #uuid "800a953b-6548-5c1f-a6b5-8f730ae36aed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431344}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e6cffb2-428d-5a69-9a22-1115ee05f052" :question/math-academy-id "q-126891" :question/problem "![](images/e7/e71bc835596d8699688f3623f339c26d365a8bb6e888742cbea10fc9da722adc.png)\n\nCalculate ${∮}_{∂D}5y\\,dx+11x\\,dy,$ where $D$ is the annular region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=5y$ and $Q(x,y)=11x.$ So,\n\n$$\n\\frac{∂P}{∂y}=5,\\,\\frac{∂Q}{∂x}=11.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}dx+x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(11-5)\\,\\text{d}A \\\\  & ={∬}_{D}6\\,\\text{d}A \\\\  & =6\\,\\text{Area}(D) \\\\  & =6\\cdot (\\pi \\cdot {4}^{2}-\\frac{\\pi \\cdot {2}^{2}}{2}) \\\\  & =6\\cdot 14\\pi  \\\\  & =84\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186431353 :knowledge-point/_questions [{:db/id #edb/ref 17592186133900 :knowledge-point/id #uuid "cdd9b289-4285-5958-a9ef-853882a18d2b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes: Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "236daf0a-8fec-5986-adef-4fec2089883e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100\\pi " :db/id #edb/ref 17592186431289} {:answer/id #uuid "2980d347-4cd0-508a-a19e-609126e74ead" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80\\pi " :db/id #edb/ref 17592186431291} {:answer/id #uuid "b95f6d7e-5d5f-5174-809f-affea38f8fa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "140\\pi " :db/id #edb/ref 17592186431328} {:answer/id #uuid "c0d3bde0-ed52-52bf-9585-a17e40e4ed16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120\\pi " :db/id #edb/ref 17592186431329} {:answer/id #uuid "f2034a12-3dc0-57c4-b9a4-d7673fd61b74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160\\pi " :db/id #edb/ref 17592186431336}] :answer-field/correct {:answer/id #uuid "f2034a12-3dc0-57c4-b9a4-d7673fd61b74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160\\pi " :db/id #edb/ref 17592186431336} :answer-field/id #uuid "2b281059-95fd-5ff3-8dbf-e28f1dfbb9f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431341}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93158d64-29fd-580d-9bf5-f56c5e2adb43" :question/math-academy-id "q-126938" :question/problem "![](images/5c/5ca9f071eaeebb0b31fba99a48ca8f08bd6b4b73588838aad7b5f513c283fd6c.png)\n\nCalculate ${∮}_{∂D}-({x}^{2}y+{y}^{3})\\,dx+({x}^{3}+x{y}^{2})\\,dy,$ where $D$ is the annular region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=-{x}^{2}y-{y}^{3}$ and $Q(x,y)={x}^{3}+x{y}^{2}.$ So,\n\n$$\n\\frac{∂P}{∂y}=-{x}^{2}-3{y}^{2},\\,\\frac{∂Q}{∂x}=3{x}^{2}+{y}^{2}.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}-({x}^{2}y+{y}^{3})\\,dx+({x}^{3}+x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}3{x}^{2}+{y}^{2}-(-{x}^{2}-3{y}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}4{x}^{2}+4{y}^{2}\\,\\text{d}A \\\\  & ={∬}_{D}4({x}^{2}+{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nThe region $D$ can be represented in polar coordinates as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,1\\le r\\le 3,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nRecall that the change of variables formula for polar coordinates gives\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, our double integral becomes\n\n$$\n\\begin{aligned}{∬}_{D}4({x}^{2}+{y}^{2})\\,\\text{d}A & =4{\\int }_{0}^{2\\pi }{\\int }_{1}^{3}(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{2\\pi }{\\int }_{1}^{3}{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{2\\pi }{\\int }_{1}^{3}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta {\\int }_{1}^{3}{r}^{3}\\,\\text{d}r \\\\  & =8\\pi {\\int }_{1}^{2}{r}^{3}\\,\\text{d}r \\\\  & =8\\pi \\cdot {\\frac{1}{4}{r}^{4}|}_{1}^{3} \\\\  & =2\\pi \\cdot ({3}^{4}-{1}^{4}) \\\\  & =160\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186431349 :knowledge-point/_questions [{:db/id #edb/ref 17592186133900 :knowledge-point/id #uuid "cdd9b289-4285-5958-a9ef-853882a18d2b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes: Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "247e7c9b-86e2-5f51-8ba9-c9448bc0dc8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186431290} {:answer/id #uuid "408f7865-0008-58e6-85c6-ac75d60946d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "189" :db/id #edb/ref 17592186431301} {:answer/id #uuid "4618a806-c076-56af-a407-64d1881a0e0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "192" :db/id #edb/ref 17592186431302} {:answer/id #uuid "51464593-b024-55b5-8ac6-2bf2b769ffdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186431306} {:answer/id #uuid "c459028d-7c56-50dd-8fbf-e3321e5298d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186431330}] :answer-field/correct {:answer/id #uuid "247e7c9b-86e2-5f51-8ba9-c9448bc0dc8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186431290} :answer-field/id #uuid "4a97b187-3262-5c06-b7ed-fed9c7d6dc5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431342}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "420adaa9-fbd3-5686-bca6-a55b93dae680" :question/math-academy-id "q-126939" :question/problem "![](images/b1/b1a063fd261e790a8c3a56f741d0356f963300c3fbd88ddde03aa1744ef81053.png)\n\nCalculate ${∮}_{∂D}({x}^{2}-{y}^{4})\\,dx+({x}^{3}y-x{y}^{3})\\,dy,$ where $D$ is the annular region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)={x}^{2}-{y}^{4}$ and $Q(x,y)=({x}^{3}y-x{y}^{3}).$ So,\n\n$$\n\\frac{∂P}{∂y}=-4{y}^{3},\\,\\frac{∂Q}{∂x}=3{x}^{2}y-{y}^{3}.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}({x}^{2}-{y}^{4})\\,dx+({x}^{3}y-x{y}^{3})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}3{x}^{2}y-{y}^{3}-(-4{y}^{3})\\,\\text{d}A \\\\  & ={∬}_{D}3{x}^{2}y+3{y}^{3}\\,\\text{d}A \\\\  & ={∬}_{D}3y({x}^{2}+{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nThe region $D$ can be represented in polar coordinates as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,1\\le r\\le 4,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nRecall that the change of variables formula for polar coordinates gives\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, our double integral becomes\n\n$$\n\\begin{aligned}{∬}_{D}3y({x}^{2}+{y}^{2})\\,\\text{d}A & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{4}3\\cdot r\\operatorname{sin}⁡\\theta \\cdot ((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{4}3{r}^{2}\\operatorname{sin}⁡\\theta \\cdot {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{4}3{r}^{4}\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta {\\int }_{1}^{4}3{r}^{4}\\,\\text{d}r \\\\  & =\\operatorname{cos}⁡\\theta \\,{|}_{0}^{2\\pi }\\cdot \\frac{3{r}^{5}}{5}\\,{|}_{1}^{4} \\\\  & =(\\operatorname{cos}⁡(2\\pi )-\\operatorname{cos}⁡(0))\\cdot (\\frac{3(4)^{5}}{5}-\\frac{3(1)^{5}}{5}) \\\\  & =(1-1)\\cdot (\\frac{3(4)^{5}}{5}-\\frac{3(1)^{5}}{5}) \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186431355 :knowledge-point/_questions [{:db/id #edb/ref 17592186133900 :knowledge-point/id #uuid "cdd9b289-4285-5958-a9ef-853882a18d2b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes: Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f39220d-1633-509c-81a8-5131d70771c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186431293} {:answer/id #uuid "39f62df8-11d8-553d-8fdd-204067835d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186431296} {:answer/id #uuid "3c2c4c9a-4ad0-5f0f-96f5-e727f1d26528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186431299} {:answer/id #uuid "59acde88-fd8f-54be-a537-e285b05463de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186431307} {:answer/id #uuid "5bef94c4-e6c8-5f82-b55a-2a267716a18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186431308}] :answer-field/correct {:answer/id #uuid "3c2c4c9a-4ad0-5f0f-96f5-e727f1d26528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186431299} :answer-field/id #uuid "d21d5399-1389-5996-9269-7e769b0bb606" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431346}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d01c58ab-6639-5fe1-a3d3-01aeb78816a2" :question/math-academy-id "q-126942" :question/problem "![](images/db/dbe6009d42623d3b3cd9f05380159bb0f4b8f22b920c1ef5d4d82b5dbf152d4a.png)\n\nCalculate \n${∮}_{∂D}{y}^{2}(x+1)\\,dx+(3{x}^{2}y+2xy)\\,dy,$\nwhere $D$ is the region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)={y}^{2}(x+1)$ and $Q(x,y)=3{x}^{2}y+2xy.$ Therefore,\n\n$$\n\\frac{∂P}{∂y}=2y(x+1),\\,\\frac{∂Q}{∂x}=6xy+2y.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}{y}^{2}(x+1)\\,dx+(3{x}^{2}y+2xy)\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(6xy+2y)-2y(x+1)\\,\\text{d}A \\\\  & ={∬}_{D}4xy\\,\\text{d}A.\\end{aligned}\n$$\n\nThe region $D$ can be represented in Cartesian coordinates as ${Δ}_{1}∖{Δ}_{2},$ where\n\n- ${Δ}_{1}=\\{(x,y)\\,:\\,0\\le x\\le 3,-1\\le y\\le 2\\}$ is the region enclosed by the outer curve, and\n\n- ${Δ}_{2}=\\{(x,y)\\,:\\,1\\le x\\le 2,0\\le y\\le 1\\}$ is the region enclosed by the inner curve.\n\nTherefore, our double integral becomes\n\n$$\n\\begin{aligned}{∬}_{D}4xy\\,\\text{d}A & ={∬}_{{Δ}_{1}}4xy\\,\\text{d}A-{∬}_{{Δ}_{2}}4xy\\,\\text{d}A \\\\  & ={\\int }_{-1}^{2}{\\int }_{0}^{3}4xy\\,\\text{d}x\\,\\text{d}y-{\\int }_{0}^{1}{\\int }_{1}^{2}4xy\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}2x\\,\\text{d}x{\\int }_{-1}^{2}2y\\,\\text{d}y-{\\int }_{1}^{2}2x\\,\\text{d}x{\\int }_{0}^{1}2y\\,\\text{d}y \\\\  & ={x}^{2}\\,{|}_{0}^{3}\\cdot {y}^{2}\\,{|}_{-1}^{2}-{x}^{2}\\,{|}_{1}^{2}\\cdot {y}^{2}\\,{|}_{0}^{1} \\\\  & =(9-0)\\cdot (4-1)-(4-1)\\cdot (1-0) \\\\  & =9\\cdot 3-3\\cdot 1 \\\\  & =24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186431356 :knowledge-point/_questions [{:db/id #edb/ref 17592186133900 :knowledge-point/id #uuid "cdd9b289-4285-5958-a9ef-853882a18d2b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes: Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d37215b-1943-5905-97aa-565540294dc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186431300} {:answer/id #uuid "a2b7de02-99e4-5e8d-9b2d-adc7d46bc083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186431320} {:answer/id #uuid "a55fde2d-708a-592b-8240-a4b285208e2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186431321} {:answer/id #uuid "adc8174a-05b0-5d22-bae6-7c69965d1aa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186431322} {:answer/id #uuid "b3b1df00-1a0c-583b-9b5b-65ba53909dfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186431325}] :answer-field/correct {:answer/id #uuid "b3b1df00-1a0c-583b-9b5b-65ba53909dfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186431325} :answer-field/id #uuid "5e0020cb-0a2c-5126-8edf-5125f13da402" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431343}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f20c5355-cea7-5f07-9f8f-ed2bfe376f88" :question/math-academy-id "q-126946" :question/problem "![](images/9b/9be396fd57559bb77f92d5a0421f3a7cdca577203904e577da0caf5326caac91.png)\n\nCalculate \n${∮}_{∂D}(2{x}^{2}{y}^{4}-x)\\,dx+(4{x}^{3}{y}^{3}-{y}^{2})\\,dy,$\nwhere $D$ is the region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=2{x}^{2}{y}^{4}-x$ and $Q(x,y)=4{x}^{3}{y}^{3}-{y}^{2}.$ Therefore,\n\n$$\n\\frac{∂P}{∂y}=8{x}^{2}{y}^{3},\\,\\frac{∂Q}{∂x}=12{x}^{2}{y}^{3}.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}(2{x}^{2}{y}^{4}-x)\\,dx+(4{x}^{3}{y}^{3}-{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}12{x}^{2}{y}^{3}-8{x}^{2}{y}^{3}\\,\\text{d}A \\\\  & ={∬}_{D}4{x}^{2}{y}^{3}\\,\\text{d}A.\\end{aligned}\n$$\n\nThe region $D$ can be represented in Cartesian coordinates as ${Δ}_{1}∖{Δ}_{2},$ where\n\n- ${Δ}_{1}=\\{(x,y)\\,:\\,-1\\le x\\le 2,-2\\le y\\le 2\\}$ is the region enclosed by the outer curve, and\n\n- ${Δ}_{2}=\\{(x,y)\\,:\\,0\\le x\\le 1,0\\le y\\le 1\\}$ is the region enclosed by the inner curve.\n\nTherefore, our double integral becomes\n\n$$\n\\begin{aligned}{∬}_{D}4{x}^{2}{y}^{3}\\,\\text{d}A & ={∬}_{{Δ}_{1}}4{x}^{2}{y}^{3}\\,\\text{d}A-{∬}_{{Δ}_{2}}4{x}^{2}{y}^{3}\\,\\text{d}A \\\\  & ={\\int }_{-2}^{2}{\\int }_{-1}^{2}4{x}^{2}{y}^{3}\\,\\text{d}x\\,\\text{d}y-{\\int }_{0}^{1}{\\int }_{0}^{1}4{x}^{2}{y}^{3}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{-1}^{2}{x}^{2}\\,\\text{d}x{\\int }_{-2}^{2}4{y}^{3}\\,\\text{d}y-{\\int }_{0}^{1}{x}^{2}\\,\\text{d}x{\\int }_{0}^{1}4{y}^{3}\\,\\text{d}y \\\\  & =\\frac{{x}^{3}}{3}\\,{|}_{-1}^{2}\\cdot {y}^{4}\\,{|}_{-2}^{2}-\\frac{{x}^{3}}{3}\\,{|}_{0}^{1}\\cdot {y}^{4}\\,{|}_{0}^{1} \\\\  & =(\\frac{8}{3}-(-\\frac{1}{3}))\\cdot (16-16)-(\\frac{1}{3}-0)\\cdot (1-0) \\\\  & =3\\cdot 0-\\frac{1}{3}\\cdot 1 \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$"}]}
