      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131939/observations/step-q126868-e13460dbdd8d91fb2544.png",
      "source_url": "https://mathacademy.com/tasks/14131939/topics/2117/lesson",
