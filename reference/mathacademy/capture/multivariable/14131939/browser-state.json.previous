      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131939/observations/step-q126861-4b9fab816eb493aca20b.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131939/observations/step-q126861-4b9fab816eb493aca20b.png",
