      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131939/observations/step-q126942-30f01f7f50875b927c1d.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131939/observations/step-q126942-30f01f7f50875b927c1d.png",
      "source_url": "https://mathacademy.com/tasks/14131939/topics/2117/lesson",
