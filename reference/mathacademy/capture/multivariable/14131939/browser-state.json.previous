      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131939/observations/step-q126855-1822a7b02495af045861.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131939/observations/step-q126855-1822a7b02495af045861.png",
      "source_url": "https://mathacademy.com/tasks/14131939/topics/2117/lesson",
