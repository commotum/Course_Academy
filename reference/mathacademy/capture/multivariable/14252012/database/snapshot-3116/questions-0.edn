#{[{:db/id #edb/ref 17592186157078 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157274 :knowledge-point/id #uuid "4106fe70-b9df-5621-ba64-66703855aaf9" :knowledge-point/title "Simplifying an Expression Using the Law that Conjunction Absorbs Disjunction"}] :question/id #uuid "d91fdb8d-5a45-5ac2-a281-20dcbbd7d6ce" :question/math-academy-id "e-7079" :question/problem "Which of the following are logically equivalent to $X?$\n\n- $X \\land (Y \\lor X)$\n\n- $(X \\lor Y) \\land Y$\n\n- $(X \\lor Y) \\land X$" :question/worked-solution "The law that conjunction absorbs disjunction is stated as\n\n$$\nX \\land (X \\lor Y) \\equiv X.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is logically equivalent to $X.$ We have\n\n$$\n\\begin{aligned}X∧(Y∨X) & ≡X∧(X∨Y) \\\\  & ≡X.\\,✓\\end{aligned}\n$$\n\n- Statement II is *not* logically equivalent to $X.$ We have\n\n$$\n\\begin{aligned}(Y∨X)∧Y & ≡Y∧(Y∨X) \\\\  & ≡Y≢X.\\,\\times \\end{aligned}\n$$\n\n- Statement III is logically equivalent to $X.$ We have\n\n$$\n\\begin{aligned}(X∨Y)∧X & ≡X∧(X∨Y) \\\\  & ≡X.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186157079 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186157275 :knowledge-point/id #uuid "5d4ea352-2a82-5ff5-8c08-b7f9a09929e6" :knowledge-point/title "Simplifying an Expression Using the Law that Disjunction Absorbs Conjunction"}] :question/id #uuid "228d6823-70ab-5b04-807a-b87e5f98bccb" :question/math-academy-id "e-7080" :question/problem "Which of the following are logically equivalent to $C?$\n\n- $(C \\land B) \\lor C$\n\n- $B \\lor (B \\land C)$\n\n- $C \\lor (C \\lor B)$" :question/worked-solution "The law that disjunction absorbs conjunction is stated as\n\n$$\nC \\lor (C \\land B) \\equiv C.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is logically equivalent to $C.$ We have\n\n$$\n\\begin{aligned}(C∧B)∨C & ≡C∨(C∧B) \\\\  & ≡C.\\,✓\\end{aligned}\n$$\n\n- Statement II is *not* logically equivalent to $C.$ We have\n\n$$\n\\begin{aligned}B∨(B∧C) & ≡B≢C.\\,\\times \\end{aligned}\n$$\n\n- Statement III is *not* logically equivalent to $C.$ This statement cannot be simplified using the absorption laws.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186378181 :knowledge-point/_questions [{:db/id #edb/ref 17592186157274 :knowledge-point/id #uuid "4106fe70-b9df-5621-ba64-66703855aaf9" :knowledge-point/title "Simplifying an Expression Using the Law that Conjunction Absorbs Disjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8e517c4-23a1-5dc9-9873-db08b9aeb3c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470649} {:answer/id #uuid "9ade5b3f-5cb6-518d-a651-81454cda6151" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470650}] :answer-field/correct {:answer/id #uuid "c8e517c4-23a1-5dc9-9873-db08b9aeb3c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470649} :answer-field/id #uuid "d8c841ea-fba3-56e1-9d85-327679542b1d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471830} {:answer-field/choices [{:answer/id #uuid "4d934691-3b6b-5ec3-9db2-a20903a11180" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470651} {:answer/id #uuid "e81df654-954c-56c2-9696-9eb3a8423750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470652}] :answer-field/correct {:answer/id #uuid "e81df654-954c-56c2-9696-9eb3a8423750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/v