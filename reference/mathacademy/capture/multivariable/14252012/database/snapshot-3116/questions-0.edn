r is \"II only.\""}] [{:db/id #edb/ref 17592186572724 :knowledge-point/_questions [{:db/id #edb/ref 17592186157274 :knowledge-point/id #uuid "4106fe70-b9df-5621-ba64-66703855aaf9" :knowledge-point/title "Simplifying an Expression Using the Law that Conjunction Absorbs Disjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f83e6b5-8139-59a3-8646-1a5f933d1f77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186572332} {:answer/id #uuid "4f6de57e-8591-59b8-8448-1673055375e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186572414} {:answer/id #uuid "5fde4f1e-5da6-568b-a479-ca97ca093cde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186572431} {:answer/id #uuid "9632130f-8983-5698-9824-a32e0cd95369" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186572478} {:answer/id #uuid "d864380a-e957-5064-a76f-12f401a7ae57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186572555}] :answer-field/correct {:answer/id #uuid "0f83e6b5-8139-59a3-8646-1a5f933d1f77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186572332} :answer-field/id #uuid "27ae5af1-10c4-54a3-be72-6e7bf0fda29b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572605}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eb08b876-0b66-567e-a3b3-60f7e35a27a7" :question/math-academy-id "q-103065" :question/problem "Which of the following are logically equivalent to $M?$\n\nI. $(M∧L)∧M$\n\nII. $M∧(M∨L)$\n\nIII. $(L∨M)∧M$" :question/worked-solution "The law that conjunction absorbs disjunction is stated as\n\n$$\nM∧(M∨L)≡M.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is *not*  logically equivalent to $M.$\nThis statement cannot be simplified using the absorption laws.\n\n- Statement II is logically equivalent to $M.$ We have\n\n$$\n\\begin{aligned}M∧(M∨L) & ≡M.\\,✓\\end{aligned}\n$$\n\n- Statement III is logically equivalent to $M.$ We have\n\n$$\n\\begin{aligned}(L∨M)∧M & ≡M∧(L∨M) \\\\  & ≡M∧(M∨L) \\\\  & ≡M.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186378202 :knowledge-point/_questions [{:db/id #edb/ref 17592186157274 :knowledge-point/id #uuid "4106fe70-b9df-5621-ba64-66703855aaf9" :knowledge-point/title "Simplifying an Expression Using the Law that Conjunction Absorbs Disjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a792c1a6-9640-5fad-85b2-fd8f2540a5f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470667} {:answer/id #uuid "5c170663-9340-5394-81f4-bdd17320b665" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470668}] :answer-field/correct {:answer/id #uuid "a792c1a6-9640-5fad-85b2-fd8f2540a5f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470667} :answer-field/id #uuid "df01b8a6-dd41-5f50-96ae-767d85aada7e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471839} {:answer-field/choices [{:answer/id #uuid "18f4bdbf-7cdb-54ec-8df5-0062b6ec5b31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470669} {:answer/id #uuid "e569d768-21a6-56ee-bfba