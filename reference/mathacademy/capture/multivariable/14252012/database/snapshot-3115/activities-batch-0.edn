#{[{:activity/first-step {:db/id #edb/ref 17592186158131} :activity/id #uuid "8bdf85c1-4b83-5092-87f5-18958edf4721" :activity/scope {:db/id #edb/ref 17592186050128 :topic/id #uuid "2edfad38-c4ef-5df9-8b35-5ea30d354656" :topic/math-academy-id 2823} :activity/steps [{:db/id #edb/ref 17592186158101 :step/content {:db/id #edb/ref 17592186157274 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157078 :question/id #uuid "d91fdb8d-5a45-5ac2-a281-20dcbbd7d6ce" :question/math-academy-id "e-7079"} :knowledge-point/id #uuid "4106fe70-b9df-5621-ba64-66703855aaf9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049824} {:db/id #edb/ref 17592186050777}] :knowledge-point/questions [{:db/id #edb/ref 17592186157799} {:db/id #edb/ref 17592186157801} {:db/id #edb/ref 17592186378181} {:db/id #edb/ref 17592186378188} {:db/id #edb/ref 17592186378195} {:db/id #edb/ref 17592186378202} {:db/id #edb/ref 17592186380159} {:db/id #edb/ref 17592186407272}] :knowledge-point/title "Simplifying an Expression Using the Law that Conjunction Absorbs Disjunction"} :step/id #uuid "06b73134-c888-557b-b24b-5c077c2e7029" :step/math-academy-id 26063 :step/next {:db/id #edb/ref 17592186158102}} {:db/id #edb/ref 17592186158102 :step/content {:db/id #edb/ref 17592186157275 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157079 :question/id #uuid "228d6823-70ab-5b04-807a-b87e5f98bccb" :question/math-academy-id "e-7080"} :knowledge-point/id #uuid "5d4ea352-2a82-5ff5-8c08-b7f9a09929e6" :knowledge-point/questions [{:db/id #edb/ref 17592186157800} {:db/id #edb/ref 17592186157802} {:db/id #edb/ref 17592186378209} {:db/id #edb/ref 17592186378216} {:db/id #edb/ref 17592186378223} {:db/id #edb/ref 17592186380166} {:db/id #edb/ref 17592186380173}] :knowledge-point/title "Simplifying an Expression Using the Law that Disjunction Absorbs Conjunction"} :step/id #uuid "bfff8667-4509-537f-8b85-edfe60cfa421" :step/math-academy-id 26064} {:db/id #edb/ref 17592186158131 :step/content {:db/id #edb/ref 17592186158482 :tutorial/content "There are two laws, called the **absorption laws**, that can be used to drastically simplify some logical expressions.\n\n- The law that conjunction absorbs disjunction is stated as $$A \\land (A \\lor B) \\equiv A.$$\n- Likewise, the law that disjunction absorbs conjunction is stated as $$A \\lor (A \\land B) \\equiv A.$$\n\nSometimes, the laws are stated more concisely as\n\n$$A \\land (A \\lor B) \\equiv A \\lor (A \\land B) \\equiv A.$$\n\nTo prove that these laws hold, we can construct truth tables:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\, A \\land (A \\lor B) \\,$ | $\\, A \\lor (A \\land B) \\,$ |\n| --- | --- | --- | --- |\n| $\\color{blue} \\textrm T$ | $\\textrm T$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\color{blue} \\textrm T$ | $\\textrm F$ | $\\color{blue} \\textrm T$ | $\\color{blue} \\textrm T$ |\n| $\\color{blue} \\textrm F$ | $\\textrm T$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |\n| $\\color{blue} \\textrm F$ | $\\textrm F$ | $\\color{blue} \\textrm F$ | $\\color{blue} \\textrm F$ |" :tutorial/id #uuid "dcc7f471-b2da-52b6-b003-76ae7ca1e64a" :tutorial/math-academy-id 4344 :tutorial/title "Introduction"} :step/id #uuid "46368002-98d2-5228-8269-a1aea4e09ac3" :step/math-academy-id 26413 :step/next {:db/id #edb/ref 17592186158101}}] :activity/title "The Absorption Laws" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186157480}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186407275} :activity/id #uuid "6b51003e-add2-53e1-8890-39467458041f" :activity/scope {:db/id #edb/ref 17592186050128 :topic/id #uuid "2edfad38-c4ef-5df9-8b35-5ea30d354656" :topic/math-academy-id 2823} :activity/steps [{:db/id #edb/ref 17592186407273 :step/content {:db/id #edb/ref 17592186157801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f1424b5-5b66-5073-87d0-1aa859444eca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460311} {:answer/id #uuid "6863ea72-aa28-52cb-af55-5a4103c49918" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460312}] :answer-field/correct {:db/id #edb/ref 17592186460311} :answer-field/id #uuid "dc4a67d5-90e7-55cb-b2e6-8c94e0730daa" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461022} {:answer-field/choices [{:answer/id #uuid "18d3bfc1-5db0-509f-8ac7-4f49a953c68b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460313} {:answer/id #uuid "7b1bcd18-9956-5f6f-8217-3f789b8c95f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460314}] :answer-field/correct {:db/id #edb/ref 17592186460313} :answer-field/id #uuid "0f53367d-5f51-5e20-adba-c20d8a617433" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461023} {:answer-field/choices [{:answer/id #uuid "4638cc17-f3e4-5746-98c5-e1c359745541" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460315} {:answer/id #uuid "2ebc556f-3c62-5062-b7cf-d2d608e89600" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460316}] :answer-field/correct {:db/id #edb/ref 17592186460316} :answer-field/id #uuid "898b5f3e-3fb3-58f7-9fbf-187796332049" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186461024}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c9f0b645-6838-5cad-b5bd-0b7bf64c64fb" :question/math-academy-id "q-81276" :question/problem "Which of the following are logically equivalent to $C?$\n- **I.** $B∨(B∨C)$\n- **II.** $B∧(B∨C)$\n- **III.** $C∧(B∨C)$\n\nSelect all that apply." :question/worked-solution "The law that conjunction absorbs disjunction is stated as\n\n$$\nC∧(C∨B)≡C.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is *not* logically equivalent to $C.$ This statement cannot be simplified using the absorption laws.\n\n- Statement II is *not* logically equivalent to $C.$ We have\n\n$$\n\\begin{aligned}B∧(B∨C) & ≡B≢C.\\,\\times \\end{aligned}\n$$\n\n- Statement III is logically equivalent to $C.$ We have\n\n$$\n\\begin{aligned}C∧(B∨C) & ≡C∧(C∨B) \\\\  & ≡C.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"III only.\""} :step/id #uuid "1eeac7d8-2e60-5c1b-bc79-fffcaf37ea73" :step/next {:db/id #edb/ref 17592186407274}} {:db/id #edb/ref 17592186407274 :step/content {:db/id #edb/ref 17592186407272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "679af59b-9a9b-5445-a2ed-971d3b27b789" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186473428} {:answer/id #uuid "de09f7f6-1950-5bcd-bd5c-77f9db8d881f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186473429}] :answer-field/correct {:db/id #edb/ref 17592186473428} :answer-field/id #uuid "4227a58e-2c13-5157-9e01-c278430e3976" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186474109} {:answer-field/choices [{:answer/id #uuid "3bd41ee6-ad6b-5890-a457-f6ca7b6dce4d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186473430} {:answer/id #uuid "02c1ee5c-a4fa-5962-a619-7f070b4cd2f0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186473431}] :answer-field/correct {:db/id #edb/ref 17592186473431} :answer-field/id #uuid "afee90de-95e4-5385-bed8-47f54fc880ed" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186474110} {:answer-field/choices [{:answer/id #uuid "6890afd6-d111-51ac-ae72-3d7d329c5b51" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186473432} {:answer/id #uuid "8a46eb9d-07c1-5ef1-b9f1-b6989168e206" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186473433}] :answer-field/correct {:db/id #edb/ref 17592186473433} :answer-field/id #uuid "9cced8f6-da3e-5b5c-9853-44c78ca4e503" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186474111}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "669b0027-14f5-5068-b932-b9686df06625" :question/math-academy-id "q-81717" :question/problem "Which of the following are logically equivalent to $R?$\n- **I.** $(T∨R)∧T$\n- **II.** $R∧(T∨R)$\n- **III.** $(R∨T)∧R$\n\nSelect all that apply." :question/worked-solution "The law that conjunction absorbs disjunction is stated as\n\n$$\nR∧(R∨T)≡R.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is *not* logically equivalent to $R.$ We have\n\n$$\n\\begin{aligned}(T∨R)∧T & ≡T∧(T∨R) \\\\  & ≡T≢R.\\,\\times \\end{aligned}\n$$\n\n- Statement II is logically equivalent to $R.$ We have\n\n$$\n\\begin{aligned}R∧(T∨R) & ≡R∧(R∨T) \\\\  & ≡R.\\,✓\\end{aligned}\n$$\n\n- Statement III is logically equivalent to $R.$ We have\n\n$$\n\\begin{aligned}(R∨T)∧R & ≡R∧(R∨T) \\\\  & ≡R.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\""} :step/id #uuid "39c66e43-2842-5715-bce0-22271f5c494c"} {:db/id #edb/ref 17592186407275 :step/content {:db/id #edb/ref 17592186157800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90bc18a9-9ac5-5d99-9097-173d1c4c292d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186460299} {:answer/id #uuid "de222f35-2fc9-5ba3-b69c-c4f4c4523eaf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186460300}] :answer-field/correct {:db/id #edb/ref 17592186460299} :answer-field/id #uuid "b3e3ed5f-1349-5ea1-b552-ce47ec76611a" :answer-field/k