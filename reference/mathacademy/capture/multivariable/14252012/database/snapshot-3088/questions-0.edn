r is \"II only.\""}] [{:db/id #edb/ref 17592186378202 :knowledge-point/_questions [{:db/id #edb/ref 17592186157274 :knowledge-point/id #uuid "4106fe70-b9df-5621-ba64-66703855aaf9" :knowledge-point/title "Simplifying an Expression Using the Law that Conjunction Absorbs Disjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a792c1a6-9640-5fad-85b2-fd8f2540a5f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470667} {:answer/id #uuid "5c170663-9340-5394-81f4-bdd17320b665" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470668}] :answer-field/correct {:answer/id #uuid "a792c1a6-9640-5fad-85b2-fd8f2540a5f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470667} :answer-field/id #uuid "df01b8a6-dd41-5f50-96ae-767d85aada7e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471839} {:answer-field/choices [{:answer/id #uuid "18f4bdbf-7cdb-54ec-8df5-0062b6ec5b31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470669} {:answer/id #uuid "e569d768-21a6-56ee-bfba-487c7d6a9866" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470670}] :answer-field/correct {:answer/id #uuid "e569d768-21a6-56ee-bfba-487c7d6a9866" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470670} :answer-field/id #uuid "a9c7bd7b-6434-543b-8c49-c42411e9330a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471840} {:answer-field/choices [{:answer/id #uuid "a7d14f9f-8332-521a-81a3-893b78f2e5