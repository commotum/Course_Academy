 0.8em 0.3em\"><mtr><mtd><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>h</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>f</mi><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo>+</mo><mi>h</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mrow><mi>h</mi></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mn>1</mn><mo>,</mo></mtd></mtr><mtr><mtd><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>h</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>f</mi><mo stretchy=\"false\">(</mo><mi>h</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mrow><mi>h</mi></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mo>−</mo><mn>1</mn><mo>,</mo></mtd></mtr><mtr><mtd><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">lim</mo><mrow data-mjx-texclass=\"ORD\"><mi>h</mi><mo accent=\"false\" stretchy=\"false\">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mi>f</mi><mo stretchy=\"false\">(</mo><mo>−</mo><mn>3</mn><mo>+</mo><mi>h</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mo>−</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mrow><mi>h</mi></mfrac></mstyle></mtd><mtd><mi></mi><mo>=</mo><mn>1.</mn></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Therefore, only I and III are true.</p>\n</div></div>",
