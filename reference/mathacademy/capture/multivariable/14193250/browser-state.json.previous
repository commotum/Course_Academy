      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14193250/observations/step-q104948-adcbcc3edeedf636cc38.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14193250/observations/step-q104948-adcbcc3edeedf636cc38.png",
      "source_url": "https://mathacademy.com/tasks/14193250/topics/637/review",
