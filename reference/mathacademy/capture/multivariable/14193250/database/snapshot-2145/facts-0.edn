ef 17592186045417] [17592186507251 #edb/ref 1079 #uuid "101d9dd4-dd5a-5b40-bb06-cc4f4eee42ea" #edb/ref 17592186045417] [17592186507362 #edb/ref 1075 #edb/ref 17592186506683 #edb/ref 17592186045417] [17592186507362 #edb/ref 1075 #edb/ref 17592186506827 #edb/ref 17592186045417] [17592186507362 #edb/ref 1075 #edb/ref 17592186506953 #edb/ref 17592186045417] [17592186507362 #edb/ref 1075 #edb/ref 17592186507100 #edb/ref 17592186045417] [17592186507362 #edb/ref 1075 #edb/ref 17592186507135 #edb/ref 17592186045417] [17592186507362 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186507362 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186507362 #edb/ref 1078 #edb/ref 17592186507135 #edb/ref 17592186045417] [17592186507362 #edb/ref 1079 #uuid "c755ac45-18f2-5688-96b0-fcf97a72209f" #edb/ref 17592186045417] [17592186507431 #edb/ref 1068 #edb/ref 17592186507251 #edb/ref 17592186045417] [17592186507431 #edb/ref 1069 "q-339039" #edb/ref 17592186045417] [17592186507431 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186507431 #edb/ref 1071 "${lim}_{x\\to 5}\\frac{{x}^{2}-25}{x-5}=${{field-1}}" #edb/ref 17592186045417] [17592186507431 #edb/ref 1072 #uuid "453b5d73-89c7-511f-b2be-1d3d4f762507" #edb/ref 17592186045417] [17592186507431 #edb/ref 1074 "First, we let\n\n$$\nL={lim}_{x\\to 5}\\frac{{x}^{2}-25}{x-5}.\n$$\n\nComparing this with the formula for the instantaneous rate of change\n\n$$\n{f}^{′}(a)={lim}_{x\\to a}\\frac{f(x)-f(a)}{x-a},\n$$\n\nwe see that if we let $f(x)={x}^{2}$ and $a=5$, we get\n\n$$\n\\begin{aligned}{f}^{′}(5) & ={lim}_{x\\to 5}\\frac{f(x)-f(5)}{x-5} \\\\  & ={lim}_{x\\to 5}\\frac{{x}^{2}-{5}^{2}}{x-5} \\\\  & ={lim}_{x\\to 5}\\frac{{x}^{2}-25}{x-5}=L.\\end{aligned}\n$$\n\nThis confirms that $L={f}^{′}(5).$\n\nComputing the derivative, we have\n\n$$\n{f}^{′}(x)=2x,\\,{f}^{′}(5)=2\\cdot 5=10,\n$$\n\nand therefore, we conclude that $L=10.$" #edb/ref 17592186045417] [17592186507452 #edb/ref 1068 #edb/ref 17592186507249 #edb/ref 17592186045417] [17592186507452 #edb/ref 1069 "q-314062" #edb/ref 17592186045417] [17592186507452 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186507452 #edb/ref 1071 "${lim}_{x\\to \\pi /4}\\,\\frac{\\operatorname{cos}⁡(x)-\\frac{\\sqrt{2}}{2}}{x-\\frac{\\pi }{4}}=${{field-1}}" #edb/ref 17592186045417] [17592186507452 #edb/ref 1072 #uuid "7fe715dd-222c-5303-8e5d-661af680f9ac" #edb/ref 17592186045417] [17592186507452 #edb/ref 1074 "First, we let\n\n$$\nL={lim}_{x\\to \\pi /4}\\,\\frac{\\operatorname{cos}⁡(x)-\\frac{\\sqrt{2}}{2}}{x-\\frac{\\pi }{4}}.\n$$\n\nComparing this with the formula for the instantaneous rate of change\n\n$$\n{f}^{′}(a)={lim}_{x\\to a}\\frac{f(x)-f(a)}{x-a},\n$$\n\nwe see that if we let $f(x)=\\operatorname{cos}⁡(x)$ and $a=\\frac{\\pi }{4}$, we get\n\n$$\n\\begin{aligned}{f}^{′}\\,(\\frac{\\pi }{4}) & ={lim}_{x\\to \\pi /4}\\frac{f(x)-f\\,(\\frac{\\pi }{4})}{x-\\frac{\\pi }{4}} \\\\  & ={lim}_{x\\to \\pi /4}\\frac{\\operatorname{cos}⁡(x)-cos\\,(\\frac{\\pi }{4})}{x-\\frac{\\pi }{4}} \\\\  & ={lim}_{x\\to \\pi /4}\\frac{\\operatorname{cos}⁡(x)-\\frac{\\sqrt{2}}{2}}{x-\\frac{\\pi }{4}}=L.\\end{aligned}\n$$\n\n \n\nThis confirms that $L={f}^{′}\\,(\\frac{\\pi }{4}).$\n\nComputing the derivative, we have\n\n$$\n{f}^{′}(x)=-\\operatorname{sin}⁡(x),\\,{f}^{′}\\,(\\frac{\\pi }{4})=-sin\\,(\\frac{\\pi }{4})=-\\frac{\\sqrt{2}}{2},\n$$\n\nand therefore, we conclude that $L=-\\frac{\\sqrt{2}}{2}.$" #edb/ref 17592186045417] [17592186507463 #edb/ref 1068 #edb/ref 17592186507362 #edb/ref 17592186045417] [17592186507463 #edb/ref 1069 "q-48459" #edb/ref 17592186045417] [17592186507463 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186507463 #edb/ref 1071 "![](images/72/72e1d1f1ea1aa635441da5503a49ac4d33d5ab0df62d48aa699debc7816df1c2.png)\n\nWhich of the following statements are true regarding the graph of the function $y=f(x)$ shown above? \n\nI. ${lim}_{h\\to 0}\\frac{f(-2+h)-f(-2)}{h}=1$\n\nII. ${lim}_{h\\to 0}\\frac{f(h)-f(0)}{h}=-0.5$\n\nIII. ${lim}_{h\\to 0}\\frac{f(-3+h)-f(-3)}{h}=1$" #edb/ref 17592186045417] [17592186507463 #edb/ref 1072 #uuid "9b3df8bd-2ae3-52a2-905f-ded2bd184071" #edb/ref 17592186045417] [17592186507463 #edb/ref 1074 "Comparing these limits with the formula for the instantaneous rate of change\n\n$$\n{f}^{′}(a)={lim}_{h\\to 0}\\frac{f(a+h)-f(a)}{h},\n$$\n\nwe see that \n\n$$\n\\begin{aligned}{lim}_{h\\to 0}\\frac{f(-2+h)-f(-2)}{h} & ={f}^{′}(-2), \\\\ {lim}_{h\\to 0}\\frac{f(h)-f(0)}{h} & ={f}^{′}(0), \\\\ {lim}_{h\\to 0}\\frac{f(-3+h)-f(-3)}{h} & ={f}^{′}(-3).\\end{aligned}\n$$\n\nThe function consists of three line segments. Inspecting the graph, we see that\n\n- for $x<-1$, we have  ${f}^{′}(x)=1,$\n\n- for $-1<x<1$, we have  ${f}^{′}(x)=-1,$\n\n- for $x>1$, we have  ${f}^{′}(x)=1.$\n\nThe derivative does not exist at $x=-1$ and $x=1$ . So we have\n\n$$\n\\begin{aligned}{lim}_{h\\to 0}\\frac{f(-2+h)-f(-2)}{h} & =1, \\\\ {lim}_{h\\to 0}\\frac{f(h)-f(0)}{h} & =-1, \\\\ {lim}_{h\\to 0}\\frac{f(-3+h)-f(-3)}{h} & =1.\\end{aligned}\n$$\n\nTherefore, only I and III are true." #edb/ref 17592186045417] [17592186507480 #edb/ref 1068 #edb/ref 17592186507248 #edb/ref 17592186045417] [17592186507480 #edb/ref 1069 "q-104948" #edb/ref 17592186045417] [17592186507480 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186507480 #edb/ref 1071 "${lim}_{x\\to 2}\\frac{{x}^{2}-4}{x-2}=$" #edb/ref 17592186045417] [17592186507480 #edb/ref 1072 #uuid "ac305827-2b68-5246-9f72-b59f76116099" #edb/ref 17592186045417] [17592186507480 #edb/ref 1074 "First, we let\n\n$$\nL={lim}_{x\\to 2}\\frac{{x}^{2}-4}{x-2}.\n$$\n\nComparing this with the formula for the instantaneous rate of change\n\n$$\n{f}^{′}(a)={lim}_{x\\to a}\\frac{f(x)-f(a)}{x-a},\n$$\n\nwe see that if we let $f(x)={x}^{2}$ and $a=2$, we get\n\n$$\n\\begin{aligned}{f}^{′}(2) & ={lim}_{x\\to 2}\\frac{f(x)-f(2)}{x-2} \\\\  & ={lim}_{x\\to 2}\\frac{{x}^{2}-{2}^{2}}{x-2} \\\\  & ={lim}_{x\\to 2}\\frac{{x}^{2}-4}{x-2}=L.\\end{aligned}\n$$\n\nThis confirms that $L={f}^{′}(2).$\n\nComputing the derivative, we have\n\n$$\n{f}^{′}(x)=2x,\\,{f}^{′}(2)=2\\cdot 2=4,\n$$\n\nand therefore we conclude that $L=4.$" #edb/ref 17592186045417] [17592186507501 #edb/ref 1068 #edb/ref 17592186507240 #edb/ref 17592186045417] [17592186507501 #edb/ref 1069 "q-104976" #edb/ref 17592186045417] [17592186507501 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186507501 #edb/ref 1071 "![](images/e0/e03f453156d57af94b13b76e22dc366644b18f56acc5f9a5f4a2c005e6bec3f7.png)\n\nWhich of the following statements are true regarding the graph of the function $y=f(x)$ shown above?\n\nI. ${lim}_{h\\to 0}\\frac{f(h)-f(0)}{h}=0$\n\nII. ${lim}_{h\\to 0}\\frac{f(1+h)-f(1)}{h}=-1$\n\nIII. ${lim}_{h\\to 0}\\frac{f(3+h)-f(3)}{h}=-1$" #edb/ref 17592186045417] [17592186507501 #edb/ref 1072 #uuid "cbf6525f-a6b2-5d79-bc38-725ad8dae9c2" #edb/ref 17592186045417] [17592186507501 #edb/ref 1074 "Comparing these limits with the formula for the instantaneous rate of change\n\n$$\n{f}^{′}(a)={lim}_{h\\to 0}\\frac{f(a+h)-f(a)}{h},\n$$\n\nwe see that \n\n$$\n\\begin{aligned}{lim}_{h\\to 0}\\frac{f(h)-f(0)}{h} & ={f}^{′}(0), \\\\ {lim}_{h\\to 0}\\frac{f(1+h)-f(1)}{h} & ={f}^{′}(1), \\\\ {lim}_{h\\to 0}\\frac{f(3+h)-f(3)}{h} & ={f}^{′}(3).\\end{aligned}\n$$\n\nThe function consists of three line segments. Inspecting the graph, we see that\n\n- for $-4<x<-1$, we have ${f}^{′}(x)=-1,$\n\n- for $-1<x<1$, we have ${f}^{′}(x)=0,$\n\n- for $1<x<4$, we have ${f}^{′}(x)=-1,$\n\n The derivative does not exist at $x=\\pm 1.$ So, we have  \n\n$$\n\\begin{aligned}{lim}_{h\\to 0}\\frac{f(h)-f(0)}{h} & =0, \\\\ {lim}_{h\\to 0}\\frac{f(1+h)-f(1)}{h} & =\\text{DNE}, \\\\ {lim}_{h\\to 0}\\frac{f(3+h)-f(3)}{h} & =-1.\\end{aligned}\n$$\n\nTherefore, only statements I and III are true." #edb/ref 17592186045417] [17592186507532 #edb/ref 1058 #edb/ref 17592186507593 #edb/ref 17592186045417] [17592186507532 