#{[{:activity/course {:db/id #edb/ref 17592186046669} :activity/first-step {:db/id #edb/ref 17592186562572} :activity/id #uuid "429544ed-8bbc-5289-a093-2f183882bb3e" :activity/scope {:db/id #edb/ref 17592186048726 :topic/id #uuid "b8f25367-71a5-50d2-9e6e-d239937a1fac" :topic/math-academy-id 1972} :activity/steps [{:db/id #edb/ref 17592186562520 :step/content {:db/id #edb/ref 17592186354445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14c0f630-3d3f-5ed2-b141-b4de74558d52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2A-22I" :db/id #edb/ref 17592186351749} {:answer/id #uuid "1c032529-58f9-5c6d-bb8a-28b0d83dcf4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{A}^{2}-22I" :db/id #edb/ref 17592186351819} {:answer/id #uuid "4c54e098-dfe0-5b60-9eda-b99474cc5cbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2A+22I" :db/id #edb/ref 17592186352264} {:answer/id #uuid "51747fe9-4344-5df8-a2b3-99b62f01c228" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{A}^{2}+22I" :db/id #edb/ref 17592186352299} {:answer/id #uuid "adf1cc36-8df2-5b24-b96f-d8364c7549da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22{A}^{2}+2I" :db/id #edb/ref 17592186353040}] :answer-field/correct {:db/id #edb/ref 17592186352299} :answer-field/id #uuid "a23b76ae-ab3d-5595-bd99-e08ffc6e5c76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186354098}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e3d8a5b7-428e-5b9f-a099-8d78abc215c6" :question/math-academy-id "q-85926" :question/problem "Let $A$ be a $3\\times 3$ matrix with the characteristic polynomial $p(\\lambda )=-{\\lambda }^{3}+2{\\lambda }^{2}+22.$ Then, ${A}^{3}=$" :question/worked-solution "Using the Cayley-Hamilton theorem, we obtain\n\n$$\n\\begin{aligned}p(A) & =O \\\\ -{A}^{3}+2{A}^{2}+22I & =O \\\\ {A}^{3} & =2{A}^{2}+22I.\\end{aligned}\n$$"} :step/id #uuid "009b2545-43e5-5219-8e67-bc5239b87a2f" :step/next {:db/id #edb/ref 17592186562584}} {:db/id #edb/ref 17592186562542 :step/content {:db/id #edb/ref 17592186392218 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de6c8aef-a70b-571d-ad06-c343dc69c199" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-10 & 40 \\\\ 0 & -10\\end{bmatrix}" :db/id #edb/ref 17592186392220} {:answer/id #uuid "cb7c199c-9d40-5982-8cd7-d65d993b6a6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-20 & 22 \\\\ -42 & 20\\end{bmatrix}" :db/id #edb/ref 17592186392221} {:answer/id #uuid "4ad98495-909a-50b7-aa42-65cbbef7dca9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}18 & 0 \\\\ 40 & -22\\end{bmatrix}" :db/id #edb/ref 17592186392222} {:answer/id #uuid "862263ee-5ba6-55a2-96fe-c5e3f12585cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-20 & 40 \\\\ 0 & 20\\end{bmatrix}" :db/id #edb/ref 17592186392223} {:answer/id #uuid "bec74d34-14b4-582b-b3b2-0b5244b0f153" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}-18 & 0 \\\\ -40 & 22\\end{bmatrix}" :db/id #edb/ref 17592186392224}] :answer-field/correct {:db/id #edb/ref 17592186392224} :answer-field/id #uuid "b597e5da-93f2-5924-a068-9852635bdc5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186392219}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6884fbdf-c141-559a-9c69-73ca1eb1083a" :question/math-academy-id "q-38727" :question/problem "Given the matrix\n$\\,A=\\begin{bmatrix}5 & 0 \\\\ 10 & -5\\end{bmatrix}$\nand $f(x)={x}^{23}-25{x}^{21}-4x+2$, find $f(A).$" :question/worked-solution "Let's start by finding the characteristic polynomial $p(\\lambda ):$\n\n$$\n\\begin{aligned}p(\\lambda ) & =\\text{det}(A-\\lambda I) \\\\  & =\\begin{vmatrix}5-\\lambda  & 0 \\\\ 10 & -5-\\lambda \\end{vmatrix} \\\\  & =(5-\\lambda )(-5-\\lambda ) \\\\  & ={\\lambda }^{2}-25\\end{aligned}\n$$\n\nNow, let's divide $f(x)$ by $p(x)$ using long division:\n\n|  | $\\,\\,{x}^{21}$ |  |  |  |  |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${x}^{2}-25\\,$ | $\\,\\enclose{longdiv}{{x}^{23}\\,-\\,25{x}^{21}\\,-\\,4x\\,+\\,2}$ |  |  |  |  |  |  |\n|  | ${x}^{23}$ | $-$ | $25{x}^{21}$ |  |  |  |  |\n|  |  |  |  | $-$ | $4x$ | $+$ | $2$ |\n\nTherefore, we can write $f(x)$ as \n\n$$\n\\begin{aligned}f(x) & =q(x)p(x)+r(x) \\\\  & =q(x)p(x)+(-4x+2)\\end{aligned}\n$$\n\nwhere $q(x)={x}^{21}.$ Replacing $x$ with $A,$ we have\n\n$$\nf(A)=q(A)p(A)+(-4A+2I).\n$$\n\nAccording to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,\n\n$$\n\\begin{aligned}f(A) & =q(A)p(A)+(-4A+2I) \\\\  & =q(A)\\cdot O+(-4A+2I) \\\\  & =-4A+2I \\\\  & =-4\\begin{bmatrix}5 & 0 \\\\ 10 & -5\\end{bmatrix}+2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-20 & 0 \\\\ -40 & 20\\end{bmatrix}+\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-18 & 0 \\\\ -40 & 22\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "577e82f8-0c54-5def-a845-15ce9bcbcc0c" :step/next {:db/id #edb/ref 17592186562520}} {:db/id #edb/ref 17592186562572 :step/content {:db/id #edb/ref 17592186326708 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28cc5ee2-6da9-52c1-a92b-8edb26634139" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{6}" :db/id #edb/ref 17592186324300} {:answer/id #uuid "47e93b3f-33d7-5090-b1fc-02844e927bff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{6}" :db/id #edb/ref 17592186324553} {:answer/id #uuid "a44579f4-a9e4-53da-a506-9eefbb4bf2e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186325367} {:answer/id #uuid "bd8f6f17-d42e-553d-a74b-0e76268b5611" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186325601} {:answer/id #uuid "d1b95922-aad1-5b77-a0d0-e6a698ab713b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186325792}] :answer-field/correct {:db/id #edb/ref 17592186324300} :answer-field/id #uuid "36035083-9336-58a8-9968-10256743cb12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186326311}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "688a2834-9fcd-5275-97a0-97e7aaa1b79c" :question/math-academy-id "q-38704" :question/problem "Given that $\\,A=\\begin{bmatrix}3 & 3 \\\\ 3 & 5\\end{bmatrix}\\,$ and $\\,{A}^{-1}=pI+qA$, find the value $p+q.$" :question/worked-solution "Let's find the characteristic equation $\\text{det}(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\text{det}(A-\\lambda I) & =0 \\\\ |\\begin{aligned}3-\\lambda  & 3 \\\\ 3 & 5-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )(5-\\lambda )-9 & =0 \\\\ {\\lambda }^{2}-8\\lambda +6 & =0\\end{aligned}\n$$\n\nUsing the Cayley-Hamilton theorem, we have that\n\n$$\n\\begin{aligned}{A}^{2}-8A+6I & =O.\\end{aligned}\n$$\n\nSince $A$ is invertible, we can multiply this equation by ${A}^{-1}:$\n\n$$\n\\begin{aligned}{A}^{-1}({A}^{2}-8A+6I) & =O \\\\ A-8I+6{A}^{-1} & =O \\\\ 6{A}^{-1} & =8I-A \\\\ {A}^{-1} & =\\frac{4}{3}I-\\frac{1}{6}A\\end{aligned}\n$$\n\nTherefore, $p=\\frac{4}{3},$ $q=-\\frac{1}{6}$ and\n\n$$\np+q=\\frac{4}{3}+(-\\frac{1}{6})=\\frac{7}{6}.\n$$"} :step/id #uuid "c9488e67-2747-5299-bfa1-6e5c456d8b59" :step/next {:db/id #edb/ref 17592186562580}} {:db/id #edb/ref 17592186562580 :step/content {:db/id #edb/ref 17592186125140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "486030d8-debf-5bf3-8646-937755b93331" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2A+{A}^{2}" :db/id #edb/ref 17592186324558} {:answer/id #uuid "7cb39a68-d9fa-5afc-a46e-1646bc050802" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{A}^{2}-A" :db/id #edb/ref 17592186325023} {:answer/id #uuid "8f700b32-f8f5-50c2-8448-a2e3950f6cf0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{A}^{2}-I" :db/id #edb/ref 17592186325188} {:answer/id #uuid "d2abfec0-1ad1-5263-bbad-6dc6f697cbf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2A-I" :db/id #edb/ref 17592186325799} {:answer/id #uuid "ec99ac0a-a7c2-59e7-88f3-37b0874d74a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2A-I" :db/id #edb/ref 17592186326052}] :answer-field/correct {:db/id #edb/ref 17592186326052} :answer-field/id #uuid "9ae27e9b-e1c9-591e-ae97-64fbf12bf64f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186326497}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "241347e1-d70b-502b-97bb-5ffa2634f0a1" :question/math-academy-id "q-38723" :question/problem "Let $A$ be a $3\\times 3$ matrix with the characteristic polynomial $p(\\lambda )=-{\\lambda }^{3}-2\\lambda -1.$ Then, ${A}^{3}=$" :question/worked-solution "Using the Cayley-Hamilton theorem, we obtain\n\n$$\n\\begin{aligned}p(A) & =O \\\\ -{A}^{3}-2A-I & =O \\\\ {A}^{3} & =-2A-I.\\end{aligned}\n$$"} :step/id #uuid "d76a9bcf-ce1d-59e1-a458-d42736b3c5ac" :step/next {:db/id #edb/ref 17592186562542}} {:db/id #edb/ref 17592186562584 :step/content {:db/id #edb/ref 17592186354451 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c632238-e62f-5f74-b0da-ba8a2b7c7882" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}21 & 0 \\\\ 72 & -27\\end{bmatrix}" :db/id #edb/ref 17592186351821} {:answer/id #uuid "470c7209-55c8-5c45-abce-7fe3f84f4c6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}21 & 27 \\\\ 0 & -72\\end{bmatrix}" :db/id #edb/ref 17592186352224} {:answer/id #uuid "5e13d16b-8e89-589c-b83e-8c447ea31fb4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}27 & 72 \\\\ 0 & -21\\end{bmatrix}" :db/id #edb/ref 17592186352401} {:answer/id #uuid "ad3d6b3f-3399-57a6-94b9-b1ab92b58f8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}21 & 72 \\\\ 0 & -27\\end{bmatrix}" :db/id #edb/ref 17592186353035} {:answer/id #uuid "dd1b1292-04d5-5403-8881-a67fccaa7676" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}12 & 72 \\\\ 0 & -12\\end{bmatrix}" :db/id #edb/ref 17592186353490}] :answer-field/correct {:db/id #edb/ref 17592186353035} :answer-field/id #uuid "af398d18-f5a4-5a12-bc2f-96080c170593" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186354125}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e1de5236-83e9-5753-abb0-71abaf264e50" :question/math-academy-id "q-85993" :question/problem "Given the matrix\n$\\,A=\\begin{bmatrix}4 & 12 \\\\ 0 & -4\\end{bmatrix}$\nand $f(x)={x}^{21}-16{x}^{19}+6x-3$, find $f(A).$" :question/worked-solution "Let's start by finding the characteristic polynomial $p(\\lambda ):$\n\n$$\n\\begin{aligned}p(\\lambda ) & =\\text{det}(A-\\lambda I) \\\\  & =\\begin{vmatrix}4-\\lambda  & 12 \\\\ 0 & -4-\\lambda \\end{vmatrix} \\\\  & =(4-\\lambda )(-4-\\lambda ) \\\\  & ={\\lambda }^{2}-16\\end{aligned}\n$$\n\nNow, let's divide $f(x)$ by $p(x)$ using long division:\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"left\" height=\"20\" width=\"20\">$\\,\\,{x}^{19}$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{2}-16\\,$</td>\n<td align=\"left\" colspan=\"7\" height=\"20\" width=\"20\">$\\,\\enclose{longdiv}{{x}^{21}\\,-\\,16{x}^{19}\\,+\\,6x\\,\\,-\\,\\,3\\phantom{|}}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{21}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$16{x}^{19}$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$6x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$3$</td>\n</tr>\n</tbody></table>\n\nTherefore, we can write $f(x)$ as \n\n$$\n\\begin{aligned}f(x) & =q(x)p(x)+r(x) \\\\  & =q(x)p(x)+(6x-3)\\end{aligned}\n$$\n\nwhere $q(x)={x}^{19}.$ Replacing $x$ with $A,$ we have\n\n$$\nf(A)=q(A)p(A)+(6A-3I).\n$$\n\nAccording to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,\n\n$$\n\\begin{aligned}f(A) & =q(A)p(A)+(6A-3I) \\\\  & =q(A)\\cdot O+(6A-3I) \\\\  & =6A-3I \\\\  & =6\\begin{bmatrix}4 & 12 \\\\ 0 & -4\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}24 & 72 \\\\ 0 & -24\\end{bmatrix}-\\begin{bmatrix}3 & 0 \\\\ 0 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}21 & 72 \\\\ 0 & -27\\end{bmatrix}.\\end{aligned}\n$$"} :step/id #uuid "e5720d7a-1ab9-5e71-a410-d953677a5677"}] :activity/title "The Cayley-Hamilton Theorem" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186561565}]}
