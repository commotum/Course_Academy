t=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{2}-16\\,$</td>\n<td align=\"left\" colspan=\"7\" height=\"20\" width=\"20\">$\\,\\enclose{longdiv}{{x}^{21}\\,-\\,16{x}^{19}\\,+\\,6x\\,\\,-\\,\\,3\\phantom{|}}$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">${x}^{21}$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$16{x}^{19}$</td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\"></td>\n<td align=\"center\" height=\"20\" width=\"20\">$6x$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$-$</td>\n<td align=\"center\" height=\"20\" width=\"20\">$3$</td>\n</tr>\n</tbody></table>\n\nTherefore, we can write $f(x)$ as \n\n$$\n\\begin{aligned}f(x) & =q(x)p(x)+r(x) \\\\  & =q(x)p(x)+(6x-3)\\end{aligned}\n$$\n\nwhere $q(x)={x}^{19}.$ Replacing $x$ with $A,$ we have\n\n$$\nf(A)=q(A)p(A)+(6A-3I).\n$$\n\nAccording to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,\n\n$$\n\\begin{aligned}f(A) & =q(A)p(A)+(6A-3I) \\\\  & =q(A)\\cdot O+(6A-3I) \\\\  & =6A-3I \\\\  & =6\\begin{bmatrix}4 & 12 \\\\ 0 & -4\\end{bmatrix}-3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}24 & 72 \\\\ 0 & -24\\end{bmatrix}-\\begin{bmatrix}3 & 0 \\\\ 0 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}21 & 72 \\\\ 0 & -27\\end{bmatrix}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186392218 #edb/ref 1068 #edb/ref 17592186392219 #edb/ref 17592186045417] [17592186392218 #edb/ref 1069 "q-38727" #edb/ref 17592186045417] [17592186392218 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186392218 #edb/ref 1071 "Given the matrix\n$\\,A=\\begin{bmatrix}5 & 0 \\\\ 10 & -5\\end{bmatrix}$\nand $f(x)={x}^{23}-25{x}^{21}-4x+2$, find $f(A).$" #edb/ref 17592186045443] [17592186392218 #edb/ref 1072 #uuid "6884fbdf-c141-559a-9c69-73ca1eb1083a" #edb/ref 17592186045417] [17592186392218 #edb/ref 1074 "Let's start by finding the characteristic polynomial $p(\\lambda ):$\n\n$$\n\\begin{aligned}p(\\lambda ) & =\\text{det}(A-\\lambda I) \\\\  & =\\begin{vmatrix}5-\\lambda  & 0 \\\\ 10 & -5-\\lambda \\end{vmatrix} \\\\  & =(5-\\lambda )(-5-\\lambda ) \\\\  & ={\\lambda }^{2}-25\\end{aligned}\n$$\n\nNow, let's divide $f(x)$ by $p(x)$ using long division:\n\n|  | $\\,\\,{x}^{21}$ |  |  |  |  |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${x}^{2}-25\\,$ | $\\,\\enclose{longdiv}{{x}^{23}\\,-\\,25{x}^{21}\\,-\\,4x\\,+\\,2}$ |  |  |  |  |  |  |\n|  | ${x}^{23}$ | $-$ | $25{x}^{21}$ |  |  |  |  |\n|  |  |  |  | $-$ | $4x$ | $+$ | $2$ |\n\nTherefore, we can write $f(x)$ as \n\n$$\n\\begin{aligned}f(x) & =q(x)p(x)+r(x) \\\\  & =q(x)p(x)+(-4x+2)\\end{aligned}\n$$\n\nwhere $q(x)={x}^{21}.$ Replacing $x$ with $A,$ we have\n\n$$\nf(A)=q(A)p(A)+(-4A+2I).\n$$\n\nAccording to the Cayley-Hamilton theorem, we have $p(A)=O.$ Therefore,\n\n$$\n\\begin{aligned}f(A) & =q(A)p(A)+(-4A+2I) \\\\  & =q(A)\\cdot O+(-4A+2I) \\\\  & =-4A+2I \\\\  & =-4\\begin{bmatrix}5 & 0 \\\\ 10 & -5\\end{bmatrix}+2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-20 & 0 \\\\ -40 & 20\\end{bmatrix}+\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-18 & 0 \\\\ -40 & 22\\end{bmatrix}.\\end{aligned}\n$$" #edb/ref 17592186045443] [17592186392219 #edb/ref 1075 #edb/ref 17592186392220 #edb/ref 17592186045417] [17592186392219 #edb/ref 1075 #edb/ref 17592186392221 #edb/ref 17592186045417] [175921863