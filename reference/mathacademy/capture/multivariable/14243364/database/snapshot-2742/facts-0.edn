b-9b08-48ecc4af0075" #edb/ref 17592186045417] [17592186125429 #edb/ref 1063 #edb/ref 17592186125794 #edb/ref 17592186045417] [17592186125430 #edb/ref 1058 #edb/ref 17592186125432 #edb/ref 17592186045417] [17592186125430 #edb/ref 1061 20134 #edb/ref 17592186045417] [17592186125430 #edb/ref 1062 #uuid "7b3b4f95-8159-5533-bd80-db194716f75b" #edb/ref 17592186045417] [17592186125430 #edb/ref 1063 #edb/ref 17592186125795 #edb/ref 17592186045417] [17592186125431 #edb/ref 1058 #edb/ref 17592186125502 #edb/ref 17592186045417] [17592186125431 #edb/ref 1061 20135 #edb/ref 17592186045417] [17592186125431 #edb/ref 1062 #uuid "d9e0bce9-63bf-58e4-af9b-2bb5b5d8e03c" #edb/ref 17592186045417] [17592186125431 #edb/ref 1063 #edb/ref 17592186124536 #edb/ref 17592186045417] [17592186125432 #edb/ref 1058 #edb/ref 17592186125431 #edb/ref 17592186045417] [17592186125432 #edb/ref 1061 20136 #edb/ref 17592186045417] [17592186125432 #edb/ref 1062 #uuid "1c6e6482-d051-50c1-b91d-40d9a95a380d" #edb/ref 17592186045417] [17592186125432 #edb/ref 1063 #edb/ref 17592186124537 #edb/ref 17592186045417] [17592186125433 #edb/ref 1058 #edb/ref 17592186125455 #edb/ref 17592186045417] [17592186125433 #edb/ref 1061 20137 #edb/ref 17592186045417] [17592186125433 #edb/ref 1062 #uuid "4e500723-739c-51c7-b82e-8727a24a1b1f" #edb/ref 17592186045417] [17592186125433 #edb/ref 1063 #edb/ref 17592186125796 #edb/ref 17592186045417] [17592186125434 #edb/ref 1061 20138 #edb/ref 17592186045417] [17592186125434 #edb/ref 1062 #uuid "0fed3d43-139d-505f-8482-70f3be0516d6" #edb/ref 17592186045417] [17592186125434 #edb/ref 1063 #edb/ref 17592186124538 #edb/ref 17592186045417] [17592186125455 #edb/ref 1058 #edb/ref 17592186125430 #edb/ref 17592186045417] [17592186125455 #edb/ref 1061 21546 #edb/ref 17592186045417] [17592186125455 #edb/ref 1062 #uuid "f3faf291-dd20-56c9-bc3d-8482113b6764" #edb/ref 17592186045417] [17592186125455 #edb/ref 1063 #edb/ref 17592186124552 #edb/ref 17592186045417] [17592186125502 #edb/ref 1058 #edb/ref 17592186125434 #edb/ref 17592186045417] [17592186125502 #edb/ref 1061 27370 #edb/ref 17592186045417] [17592186125502 #edb/ref 1062 #uuid "3167e19f-42e7-5fc7-8ee9-fb73a5fa3da3" #edb/ref 17592186045417] [17592186125502 #edb/ref 1063 #edb/ref 17592186125824 #edb/ref 17592186045417] [17592186125794 #edb/ref 1064 "The characteristic equation of a square matrix $A$ is given by \n\n$$\n\\det(A-\\lambda I)=0.\n$$\n\nOn the left-hand side of this equation, we have the expression \n\n$$\n\\det(A-\\lambda I),\n$$\n\n which we call the **characteristic polynomial** of the matrix $A.$\n\nFor instance, let's find the characteristic polynomial of the matrix ![](images/1d/1d6d0bdedbb25bbc41759e443cdc0f6a207ef5cbfa4761b05e1a1a2eda24cbec.svg)\n\n$$\n\\begin{aligned}p(\\lambda ) & =det(C-\\lambda I) \\\\  & =\\left|\\begin{aligned}-8-\\lambda  & -9 \\\\ 6 & 7-\\lambda \\end{aligned}\\right| \\\\  & =(-8-\\lambda )\\cdot (7-\\lambda )-(-9)\\cdot 6 \\\\  & ={\\lambda }^{2}+\\lambda -2\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186125794 #edb/ref 1065 3580 #edb/ref 17592186045417] [17592186125794 #edb/ref 1066 #uuid "25396b96-19ec-592d-b1c4-3c6fa172ef08" #edb/ref 17592186045417] [17592186125794 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186125795 #edb/ref 1064 "The **Cayley-Hamilton theorem** states the following: \n\n*Let $A$ be an $\\,n \\!\\times\\! n$ matrix whose characteristic polynomial is* \n\n$$\np(\\lambda) = \\textrm{det}(A-\\lambda I) = (-1)^n\\lambda^n + c_{n-1}\\lambda^{n-1}+\\cdots+c_1\\lambda + c_0.\n$$\n\n*Then, the matrix $A$ is a solution of the characteristic equation $p(\\lambda) = 0$.* \n\nThat is to say, if we substitute $A$ into the characteristic polynomial $p(\\lambda)$, taking $A^0 = I,$ then we have\n\n$$\np(A) = (-1)^nA^n + c_{n-1}A^{n-1}+\\cdots+c_1A + c_0I = O,\n$$\n\nwhere $O$ is the zero-matrix. \n\nFor example, according to this theorem, for the matrix \n![](images/d2/d24f480293267a9ddc28b03626e7bde6f01bd62a136fed17f8580bf1ea34d776.svg)\nwhose characteristic polynomial is \n\n$$\np(\\lambda)=\\lambda^2 +\\lambda -2,\n$$\n\nwe have\n\n$$\np(A) = A^2 +A -2I =O.\n$$" #edb/ref 17592186045417] [17592186125795 #edb/ref 1065 3581 #edb/ref 17592186045417] [17592186125795 #edb/ref 1066 #uuid "86101838-75af-5a3f-9dae-1e63a94c77a1" #edb/ref 17592186045417] [17592186125795 #edb/ref 1067 "The Cayley-Hamilton Theorem" #edb/ref 17592186045417] [17592186125796 #edb/ref 1064 "What conclusions can we make regarding the characteristic polynomial of the general $2\\times 2$ matrix $A,$ given by\n\n![](images/8e/8e26937ef1981804a548e92a4041bd8672cc75c7c5cc6efa0c0c2694c0736791.svg)\n\nFirst, let's find the characteristic equation:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\left|\\begin{aligned}a-\\lambda  & b \\\\ c & d-\\lambda \\end{aligned}\\right| & =0 \\\\ (a-\\lambda )(d-\\lambda )-bc & =0 \\\\ {\\lambda }^{2}-(a+d)\\lambda +(ad-bc) & =0\\end{aligned}\n$$\n\nNotice that the constant term is the determinant of the matrix: \n\n$$\n\\det(A) = ad-bc\n$$\n\n \n\nThe coefficient of $\\lambda$ is the sum of the diagonal entries of $A$ taken with a negative sign. The sum of the diagonal entries of a matrix $A$ is called the **trace** of $A,$ and we denote it as \n\n$$\n\\mathrm{tr}(A) = a+d.\n$$\n\nSo, for any $2\\times 2$ matrix $A$, the characteristic polynomial is\n\n$$\np(\\lambda) = \\lambda^2 -\\mathrm{tr}(A)\\lambda + \\det(A).\n$$\n\n**Note:** This result can be extended to the general case of $n \\times n$ matrices. If $A$ is an $n \\times n$ matrix, then its characteristic polynomial takes the form\n\n$$\n\\begin{aligned}p(\\lambda ) & =det(A-\\lambda I) \\\\  & =(-1)^{n}{\\lambda }^{n}+{c}_{n-1}{\\lambda }^{n-1}+⋯+{c}_{1}\\lambda +{c}_{0} \\\\  & =(-1)^{n}{\\lambda }^{n}+{{(-1)^{n-1}\\text{tr}(A)}_{⏟}}_{{c}_{n-1}}{\\lambda }^{n-1}+⋯+{c}_{1}\\lambda +{{det(A)}_{⏟}}_{{c}_{0}},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\begin{aligned}{c}_{n-1}=(-1)^{n-1}\\text{tr}(A)\\,\\text{and}\\,{c}_{0}=det(A).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186125796 #edb/ref 1065 3582 #edb/ref 17592186045417] [17592186125796 #edb/ref 1066 #uuid "1c54b7a6-10ea-5c57-ad4e-245a308d4790" #edb/ref 17592186045417] [17592186125796 #edb/ref 1067 "The Characteristic Polynomial for 2x2 Matrices" #edb/ref 17592186045417] [17592186125824 #edb/ref 1064 "If we want to evaluate a high-degree polynomial for a given matrix input, it can take a lot of time. For example, suppose we wanted to evaluate the polynomial\n\n$$\nf(x) = x^{10} - 5x^9 - 2x^8 + x + 2\n$$\n\nfor the input ![](images/0f/0f9bff826261a956305962b4ca945ed91012cc5042e6ffe92a4b5f1ce13d3237.svg) Computing the $10$th power of this matrix would be a lot of work!\n\nLuckily, there is a way to speed up the process. The trick is to use Cayley-Hamilton theorem, which tells us that every matrix is a solution to its characteristic equation.\n\nFor the given matrix ![](images/65/6514096b22aed47005e5ff59c47e3cec701aed5b120b0022b186f1bec941d953.svg) the characteristic polynomial is\n\n$$\n\\begin{aligned}p(\\lambda ) & =\\text{det}(A-\\lambda I) \\\\  & =|\\begin{aligned}1-\\lambda  & 2 \\\\ 3 & 4-\\lambda \\end{aligned}| \\\\  & =(1-\\lambda )(4-\\lambda )-6 \\\\  & ={\\lambda }^{2}-5\\lambda -2,\\end{aligned}\n$$\n\nso the Cayley-Hamilton theorem tells us that\n\n$$\np(A) = A^2 - 5A - 2I = 0.\n$$\n\nNow, observe that the polynomial $f(x)$ can be written as\n\n$$\n\\begin{aligned}f(x) & ={x}^{10}-5{x}^{9}-2{x}^{8}+x+2 \\\\  & ={x}^{8}({x}^{2}-5x-2)+x+2 \\\\  & ={x}^{8}p(x)+x+2.\\end{aligned}\n$$\n\nThen we have\n\n$$\nf(A) = A^8 p(A) + A + 2I,\n$$\n\nand because $p(A) = 0,$ we conclude that\n\n$$\n\\begin{aligned}f(A) & ={A}^{8}\\cdot 0+A+2I \\\\  & =0+A+2I \\\\  & =A+2I.\\end{aligned}\n$$\n\nNow, the computation is much faster:\n\n$$\n\\begin{aligned}f(A) & =A+2I \\\\  & =[\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}]+2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 2 \\\\ 3 & 6\\end{aligned}]\\end{aligned}\n$$\n\n**Note:** Other times, it may not be so obvious how to group the terms of $f(x)$ to reveal $p(x).$ In the general case, it's best to divide $f(x)$ by $p(x)$ using long division, and use the result\n\n$$\nf(x) = q(x) p(x) + r(x)\n$$\n\nwhere $q(x)$ is the quotient and $r(x)$ is the remainder. Let's see an example of this." #edb/ref 17592186045417] [17592186125824 #edb/ref 1065 4448 #edb/ref 17592186045417] [17592186125824 #edb/ref 1066 #uuid "769ceb10-1667-52b6-8a89-b4c7ca835276" #edb/ref 17592186045417] [17592186125824 #edb/ref 1067 "Using the Cayley-Hamilton Theorem to Quickly Evaluate a Matrix Polynomial" #edb/ref 17592186045417] [17592186269289 #edb/ref 1080 "\\begin{bmatrix}25 & -42 \\\\ 14 & -31\\end{bmatrix}" #edb/ref 17592186045443] [17592186269289 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186269289 #edb/ref 1083 #uuid "025a5c1a-4f6e-5e42-8dce-96a2fd08178a" #edb/ref 17592186045417] [17592186269575 #edb/ref 1080 "\\begin{bmatrix}31 & 14 \\\\ 42 & -25\\end{bmatrix}" #edb/ref 17592186045443] [17592186269575 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186269575 #edb/ref 1083 #uuid "23310913-8cd2-557c-be76-7e2691fe0ee4" #edb/ref 17592186045417] [17592186270533 #edb/ref 1080 "\\begin{bmatrix}15 & 14 \\\\ -42 & 30\\end{bmatrix}" #edb/ref 17592186045443] [17592186270533 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186270533 #edb/ref 1083 #uuid "9142a6e7-f5cb-5d0d-bcaf-2c7c6f384044" #edb/ref 17592186045417] [17592186271376 #edb/ref 1080 "\\begin{bmatrix}25 & 12 \\\\ -24 & -31\\end{bmatrix}" #edb/ref 17592186045443] [17592186271376 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186271376 #edb/ref 1083 #uuid "efb97e7a-5224-5bc1-9035-2d0d54445cd3" #edb/ref 17592186045417] [17592186271438 #edb/ref 1080 "\\begin{bmatrix}25 & 14 \\\\ -42 & -31\\end{bmatrix}" #edb/ref 17592186045443] [17592186271438 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [175921