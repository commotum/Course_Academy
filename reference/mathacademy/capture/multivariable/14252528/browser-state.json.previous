nd-color: gainsboro;\"><mjx-mpadded><mjx-block style=\"width: 1.122em; margin: 0.2em 0px; position: relative;\"><mjx-rbox style=\"left: 0.2em; top: 0px; max-width: 1.122em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c54\"></mjx-c></mjx-mtext></mjx-mstyle></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+2pt\" depth=\"+2pt\" lspace=\"2pt\" width=\"+4pt\"><mstyle mathcolor=\"blue\"><mtext>T</mtext></mstyle></mpadded></mstyle></math></mjx-assistive-mml></mjx-container></td>\n</tr>\n</tbody></table></div></div>",
