#{[{:activity/expected-seconds 720.0 :activity/first-step {:db/id #edb/ref 17592186060690} :activity/id #uuid "95e1ac2b-a3ab-570a-aa6c-322637d3df72" :activity/scope {:db/id #edb/ref 17592186050882 :topic/id #uuid "6e1bba25-5964-5d7f-844a-632e8e502d16" :topic/math-academy-id 248} :activity/steps [{:db/id #edb/ref 17592186060690 :step/content {:db/id #edb/ref 17592186060987 :tutorial/content "Of particular importance in mathematical proofs are so-called **biconditional statements.** These are statements of the form\n\n$$\n(P\\Rightarrow Q) \\land (Q\\Rightarrow P).\n$$\n\nIn words, a biconditional statement states that *\"$P$ implies $Q,$ **and** $Q$ implies $P.$\"* \n\nLet's construct a truth table for this biconditional statement.\n\n| $\\,P\\,$ | $\\,Q\\,$ | $\\,P\\Rightarrow Q\\,$ | $\\,Q\\Rightarrow P\\,$ | $\\,(P \\Rightarrow Q)\\land (Q \\Rightarrow P)\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\textrm T$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\textrm F$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ |\n\nBiconditional statements are so important that we give them a special symbol.\n\n$$\nP\\Leftrightarrow Q\n$$\n\nSo, we now have the following logical equivalence:\n\n$$\nP \\Leftrightarrow Q \\equiv (P \\Rightarrow Q) \\land (Q \\Rightarrow P)\n$$\n\nThe truth table for $P\\Leftrightarrow Q$ is as follows:\n\n| $\\,P\\,$ | $\\,Q\\,$ | $\\,P\\Leftrightarrow Q\\,$ |\n| --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm T$ |\n\nAccording to the truth table, $P\\Leftrightarrow Q$ is true if $P$ and $Q$ have the *same* truth value. Otherwise, it is false. We can express this as another logical equivalence:\n\n$$\nP\\Leftrightarrow Q \\equiv \\big(P \\land Q\\big) \\lor \\big(\\neg P \\land \\neg Q\\big)\n$$\n\nThere are many ways to say $P\\Leftrightarrow Q$ in words. Among the most common are the following:\n\n- *$P$ is equivalent to $Q$*\n\n- *$P$ if and only if $Q$*\n\n- *If $P$ then $Q,$ and if $Q$ then $P$*\n\n- *$P$ implies $Q$, and $Q$ implies $P$*" :tutorial/id #uuid "093aafe9-8f7e-5894-aa0f-80d9837de231" :tutorial/math-academy-id 7981 :tutorial/title "Introduction"} :step/id #uuid "d64cb2fb-f12e-53f4-854b-20e14ebe1763" :step/math-academy-id 180138 :step/next {:db/id #edb/ref 17592186060691}} {:db/id #edb/ref 17592186060691 :step/content {:db/id #edb/ref 17592186059777 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059418 :question/id #uuid "15d6b6c0-af70-5d22-bfdc-b2c0aaf98de5" :question/math-academy-id "e-12717"} :knowledge-point/id #uuid "fe8eb0bd-6d37-5eb8-98fd-796b2af992f7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049269}] :knowledge-point/questions [{:db/id #edb/ref 17592186060144} {:db/id #edb/ref 17592186060145} {:db/id #edb/ref 17592186379202} {:db/id #edb/ref 17592186379215} {:db/id #edb/ref 17592186379316} {:db/id #edb/ref 17592186379322} {:db/id #edb/ref 17592186390017} {:db/id #edb/ref 17592186412689} {:db/id #edb/ref 17592186412690} {:db/id #edb/ref 17592186573303} {:db/id #edb/ref 17592186573317}] :knowledge-point/title "Using the Equivalence Truth Table"} :step/id #uuid "16368019-6e3a-59cb-aff9-396cc5a523ae" :step/math-academy-id 180139 :step/next {:db/id #edb/ref 17592186060692}} {:db/id #edb/ref 17592186060692 :step/content {:db/id #edb/ref 17592186059778 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059417 :question/id #uuid "b5abe855-4626-5575-a03e-04a377eef82b" :question/math-academy-id "e-12716"} :knowledge-point/id #uuid "35e42262-e78c-5553-acfe-739684165622" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049805}] :knowledge-point/questions [{:db/id #edb/ref 17592186060146} {:db/id #edb/ref 17592186060147} {:db/id #edb/ref 17592186060148} {:db/id #edb/ref 17592186379222} {:db/id #edb/ref 17592186379235} {:db/id #edb/ref 17592186390023} {:db/id #edb/ref 17592186411156} {:db/id #edb/ref 17592186412691} {:db/id #edb/ref 17592186573304} {:db/id #edb/ref 17592186573305} {:db/id #edb/ref 17592186573306}] :knowledge-point/title "Completing a Truth Table for an Equivalence"} :step/id #uuid "dbb1b859-85c6-5a40-ad20-f902640167e1" :step/math-academy-id 180142 :step/next {:db/id #edb/ref 17592186060693}} {:db/id #edb/ref 17592186060693 :step/content {:db/id #edb/ref 17592186059779 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059416 :question/id #uuid "9df9c7d3-b06a-5f0c-be20-c0d24baa81ad" :question/math-academy-id "e-12715"} :knowledge-point/id #uuid "8946f811-40c4-5a19-a867-576c42364f15" :knowledge-point/questions [{:db/id #edb/ref 17592186059973} {:db/id #edb/ref 17592186060063} {:db/id #edb/ref 17592186378382} {:db/id #edb/ref 17592186378725} {:db/id #edb/ref 17592186386236} {:db/id #edb/ref 17592186394469} {:db/id #edb/ref 17592186411154}] :knowledge-point/title "Writing Biconditionals as Conditionals"} :step/id #uuid "0ad7a8c4-1d07-58d6-b796-4f8fd10de145" :step/math-academy-id 180146 :step/next {:db/id #edb/ref 17592186060694}} {:db/id #edb/ref 17592186060694 :step/content {:db/id #edb/ref 17592186059780 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059419 :question/id #uuid "51dc6bfc-d581-5972-9101-a80e614b33e4" :question/math-academy-id "e-12718"} :knowledge-point/id #uuid "4e85e1e6-6a11-52e6-96d3-a768ced940d4" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048378}] :knowledge-point/questions [{:db/id #edb/ref 17592186060064} {:db/id #edb/ref 17592186060423} {:db/id #edb/ref 17592186378375} {:db/id #edb/ref 17592186378739} {:db/id #edb/ref 17592186379195} {:db/id #edb/ref 17592186390010} {:db/id #edb/ref 17592186394476} {:db/id #edb/ref 17592186394483} {:db/id #edb/ref 17592186411155} {:db/id #edb/ref 17592186411157} {:db/id #edb/ref 17592186573301} {:db/id #edb/ref 17592186573323}] :knowledge-point/title "Simplifying Expressions Involving Equivalences"} :step/id #uuid "85c04f35-a7ed-5d67-bd58-e5ec887fb820" :step/math-academy-id 180149}] :activity/title "Biconditional Statements" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186059926}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186418398} :activity/id #uuid "e94c8e5f-9707-5db7-b76b-b8bf5e005ded" :activity/scope {:db/id #edb/ref 17592186050882 :topic/id #uuid "6e1bba25-5964-5d7f-844a-632e8e502d16" :topic/math-academy-id 248} :activity/steps [{:db/id #edb/ref 17592186418394 :step/content {:db/id #edb/ref 17592186411155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "940f2589-9f73-5417-804b-2bb82c8143cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬B⇒A" :db/id #edb/ref 17592186411134} {:answer/id #uuid "b492421a-8fbc-5f3d-88d9-040402e7893f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(A∧B)∨¬(B∨A)" :db/id #edb/ref 17592186411138} {:answer/id #uuid "d3188347-6e03-5c7a-b90e-0a84321cc0f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(A∨B)∧¬(B∨A)" :db/id #edb/ref 17592186411140} {:answer/id #uuid "e4314ff2-9a8b-5692-b710-657e0db7b72c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(A∨B)∧¬(B∧A)" :db/id #edb/ref 17592186411141} {:answer/id #uuid "f72d28f7-58e9-5fb1-a702-3dc4acfad2ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(A∧B)∧¬(B∨A)" :db/id #edb/ref 17592186411145}] :answer-field/correct {:db/id #edb/ref 17592186411141} :answer-field/id #uuid "e18107c3-8a03-5991-a93e-5223d254814d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186411151}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "75186b51-1b0d-58e4-a5b9-b90965af20bd" :question/math-academy-id "q-107158" :question/problem "$¬A⇔B≡$" :question/worked-solution "First, we use the definition of the biconditional statement to write the equivalence as a conjunction of implications: \n\n$$\n¬A⇔B≡(¬A⇒B)∧(B⇒¬A)\n$$\n\nNow, we represent all the implications using disjunctions and negations:\n\n$$\n(¬A⇒B)∧(B⇒¬A)≡(¬¬A∨B)∧(¬B∨¬A)\n$$\n\nNext, we use De Morgan's laws:\n\n$$\n(¬¬A∨B)∧(¬B∨¬A)≡(¬¬A∨B)∧¬(B∧A)\n$$\n\nFinally, we simplify the double negations:\n\n$$\n(¬¬A∨B)∧¬(B∧A)≡(A∨B)∧¬(B∧A)\n$$"} :step/id #uuid "0071541c-aa62-5f52-a780-f636a5705708" :step/next {:db/id #edb/ref 17592186418395}} {:db/id #edb/ref 17592186418395 :step/content {:db/id #edb/ref 17592186411154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03fc9076-17bb-57a9-be73-dfacce174097" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(Y∧X)⇒¬Y" :db/id #edb/ref 17592186411118} {:answer/id #uuid "109311f5-5d8e-5ac6-9266-8b6d76321bc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y⇒(Y∧X)" :db/id #edb/ref 17592186411121} {:answer/id #uuid "2059d0ef-498b-554c-8e0d-85c9f988c719" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Y⇒¬(Y∧X)" :db/id #edb/ref 17592186411122} {:answer/id #uuid "3bd9c0da-02e8-5952-b449-71cbb6aaf381" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬Y⇒(Y∧X)" :db/id #edb/ref 17592186411125} {:answer/id #uuid "633df85e-a6e9-521a-b6f5-a5c33c788554" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬(Y∧X)⇒Y" :db/id #edb/ref 17592186411128}] :answer-field/correct {:db/id #edb/ref 17592186411122} :answer-field/id #uuid "92f17ad3-acc3-5640-8a98-5f227a64f6be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186411148}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22a767fa-9117-5005-b0eb-ffcf7c23df74" :question/math-academy-id "q-107221" :question/problem "$$\n¬(Y∧X)⇔Y≡[¬(Y∧X)⇒Y]∧\n$$\n\nWhat expression should be inserted into the blank space above to give logically equivalent statements?" :question/worked-solution "According to the definition of the biconditional, \n\n- $A⇔B$ is true if $A⇒B$ **and** $B⇒A.$ Otherwise, it is false.\n\n- In other words, $A⇔B$ is true if $A$ and $B$ have the same truth values. Otherwise, it is false.\n\nSo, in this case, we have\n\n$$\n¬(Y∧X)⇔Y≡[¬(Y∧X)⇒Y]∧[\\,Y⇒¬(Y∧X)].\n$$\n\nTherefore, the missing part is $Y⇒¬(Y∧X).$"} :step/id #uuid "6a5f7cad-cf5f-550b-ae45-beb0199daa95" :step/next {:db/id #edb/ref 17592186418397}} {:db/id #edb/ref 17592186418396 :step/content {:db/id #edb/ref 17592186411156 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49b4a957-e2ab-592d-98ad-6b79c9d61e79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186411126} {:answer/id #uuid "6d8ee3de-1f02-5693-b88a-f715165a2f8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186411130}] :answer-field/correct {:db/id #edb/ref 17592186411126} :answer-field/id #uuid "3ae8aa36-3cd5-5bc7-a03f-b58abcd0da4c" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186411146} {:answer-field/choices [{:answer/id #uuid "20f13fdc-83b9-522d-ab07-bb7bf6868007" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186411123} {:answer/id #uuid "a5731b93-033e-5045-a105-962a512dbcf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186411137}] :answer-field/correct {:db/id #edb/ref 17592186411137} :answer-field/id #uuid "9a1fd416-ed31-512d-9a1b-958ce18bfb09" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186411149} {:answer-field/choices [{:answer/id #uuid "68f074df-4b7a-52ca-a573-a01e3f8dc23c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186411129} {:answer/id #uuid "b8954ad4-8c78-5f6e-a29d-7774810fc36d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186411139}] :answer-field/correct {:db/id #edb/ref 17592186411129} :answer-field/id #uuid "bf9a3cc5-67e5-5214-a219-100a853795df" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186411150} {:answer-field/choices [{:answer/id #uuid "0623476e-866e-5f1b-abac-b1775984ebbf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{F}" :db/id #edb/ref 17592186411119} {:answer/id #uuid "f24091f1-a1ab-5bd7-83ce-8c9c469b8840" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{T}" :db/id #edb/ref 17592186411144}] :answer-field/correct {:db/id #edb/ref 17592186411119} :answer-field/id #uuid "e8a11ceb-0331-5fd8-8ff6-71671af48cf0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186411152}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7dce07e5-2c84-5040-bb81-50a03090839e" :question/math-academy-id "q-182580" :question/problem "Find the missing values in the following truth table:\n\n| $\\,X\\,$ | $\\,Y\\,$ | $\\,¬(X∨Y)⇔X\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | {{field-1}} |\n| $\\text{T}$ | $\\text{F}$ | {{field-2}} |\n| $\\text{F}$ | $\\text{T}$ | {{field-3}} |\n| $\\text{F}$ | $\\text{F}$ | {{field-4}} |" :question/worked-solution "According to the definition of the biconditional, \n\n- $P⇔Q$ is true if $P⇒Q$ **and** $Q⇒P.$ Otherwise, it is false.\n\n- In other words, $P⇔Q$ is true if $P$ and $Q$ have the same truth values. Otherwise, it is false.\n\nFirst, we add a columns for $X∨Y$ and $¬(X∨Y):$\n\n| $\\,X\\,$ | $\\,Y\\,$ | $\\,X∨Y\\,$ | $\\,¬(X∨Y)\\,$ |\n| --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n\nFinally, we add a column for $¬(X∨Y)⇔X.$ \n\n| $\\,X\\,$ | $\\,Y\\,$ | $\\,X∨Y\\,$ | $\\,¬(X∨Y)\\,$ | $\\,¬(X∨Y)⇔X\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |"} :step/id #uuid "77538dfa-51b3-5a45-858e-98924c4d7a08"} {:db/id #edb/ref 17592186418397 :step/content {:db/id #edb/ref 17592186411157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0833f240-185e-532a-824f-4ccd738ff6d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(Y∧X)∨(¬X∧¬Y)" :db/id #edb/ref 17592186411120} {:answer/id #uuid "81e51dfb-5df1-5588-964c-928acab1bcb8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "X∧¬Y" :db/id #edb/ref 17592186411131} {:answer/id #uuid "8bda5940-fd50-546b-b1c8-6f4ae1ea16b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "¬X∧Y" :db/id #edb/ref 17592186411133} {:answer/id #uuid "999bcf3c-92e7-59d4-bcad-b3707c6d09dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(Y∧¬X)∧(X∧¬Y)" :db/id #edb/ref 17592186411135} {:answer/id #uuid "9b327029-890c-51ee-9cd1-2d50c1493769" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(Y∧¬X)∨(X∧¬Y)" :db/id #edb/ref 17592186411136}] :answer-field/correct {:db/id #edb/ref 17592186411136} :answer-field/id #uuid "67aed17a-d2cd-554a-99c0-e5486a53aa69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186411147}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "96aebafe-ff76-58ac-a04c-e47b82d4e2a3" :question/math-academy-id "q-182523" :question/problem "$¬(Y⇔X)≡$" :question/worked-solution "First, we use the definition of the biconditional statement to write the equivalence as a conjunction of implications: \n\n$$\n¬(Y⇔X)≡¬[(Y⇒X)∧(X⇒Y)]\n$$\n\nNow, we represent all the implications using disjunctions and negations:\n\n$$\n¬[(Y⇒X)∧(X⇒Y)]≡¬[(¬Y∨X)∧(¬X∨Y)]\n$$\n\nNext, we use De Morgan's laws:\n\n$$\n\\begin{aligned}¬[(¬Y∨X)∧(¬X∨Y)] & ≡¬(¬Y∨X)∨¬(¬X∨Y) \\\\  & ≡(¬¬Y∧¬X)∨(¬¬X∧¬Y)\\end{aligned}\n$$\n\nFinally, we simplify the double negations:\n\n$$\n\\begin{aligned}(¬¬Y∧¬X)∨(¬¬X∧¬Y) & ≡(Y∧¬X)∨(X∧¬Y)\\end{aligned}\n$$"} :step/id #uuid "8a0b196d-bfe1-5218-b08a-7a485c146d87" :step/next {:db/id #edb/ref 17592186418396}} {:db/id #edb/ref 17592186418398 :step/content {:db/id #edb/ref 17592186060063 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32e1d597-926b-5231-b70c-426d169352c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "P⇒Q" :db/id #edb/ref 17592186411124} {:answer/id #uuid "4d866fd2-43a3-573e-991b-92a748eb725b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(P⇒Q)∧(Q⇒P)" :db/id #edb/ref 17592186411127} {:answer/id #uuid "87c0e178-1f23-5517-94ff-105ac4ae0d9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(P⇒Q)∨(Q⇒P)" :db/id #edb/ref 17592186411132} {:answer/id #uuid "e50fba5b-5161-546c-8d3c-3d19539ab036" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "Q⇒P" :db/id #edb/ref 17592186411142} {:answer/id #uuid "f025e2ab-90b3-5479-bb88-23644a67a768" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(¬P⇒¬Q)∧(Q⇒P)" :db/id #edb/ref 17592186411143}] :answer-field/correct {:db/id #edb/ref 17592186411127} :answer-field/id #uuid "fbcd1085-7f9a-5980-ac51-cc2a3484d383" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186411153}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "994db419-8ab8-5b1c-9e43-3da4dc72767f" :question/math-academy-id "q-1471" :question/problem "$P⇔Q≡$" :question/worked-solution "According to the definition of the biconditional, \n\n- $A⇔B$ is true if $A⇒B$ **and** $B⇒A.$ Otherwise, it is false.\n\n- In other words, $A⇔B$ is true if $A$ and $B$ have the same truth values. Otherwise, it is false.\n\nSo in this case, we have\n\n$$\nP⇔Q≡(P⇒Q)∧(Q⇒P).\n$$"} :step/id #uuid "9ad7da45-2504-549b-81d7-12a095427db1" :step/next {:db/id #edb/ref 17592186418394}}] :activity/title "Biconditional Statements" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186418393}]}
