/id #uuid "4e85e1e6-6a11-52e6-96d3-a768ced940d4" :knowledge-point/title "Simplifying Expressions Involving Equivalences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a5ead25-f894-5c56-8fc8-208d6efb2411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(R∧¬S)∨(S∧¬R)" :db/id #edb/ref 17592186378741} {:answer/id #uuid "4e44a41f-1278-545b-a105-bae7c0bc610d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(R∨¬S)∧(S∧¬R)" :db/id #edb/ref 17592186378742} {:answer/id #uuid "2c76a143-fa4b-5a2d-93e7-c167938193a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(¬R∧S)∨(¬S∨R)" :db/id #edb/ref 17592186378743} {:answer/id #uuid "1e8354bc-1123-5aa3-badc-fcad60436a10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬R∧S" :db/id #edb/ref 17592186378744} {:answer/id #uuid "941653b2-f8ab-59c0-9183-0eea245e70e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(R∧¬S)∧(S∧¬R)" :db/id #edb/ref 17592186378745}] :answer-field/correct {:answer/id #uuid "2a5ead25-f894-5c56-8fc8-208d6efb2411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(R∧¬S)∨(S∧¬R)" :db/id #edb/ref 17592186378741} :answer-field/id #uuid "fa635f77-ae2d-55de-9a31-bd8bedcbba5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378740}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55df2827-3564-5843-aa9f-ed9944aa0ca9" :question/math-academy-id "q-1480" :question/problem "$¬(R⇔S)≡$" :question/worked-solution "First, we use the definition of the biconditional statement to write the equivalence as a conjunction of implications: \n\n$$\n¬(R⇔S)≡¬((R⇒S)∧(S⇒R))\n$$\n\nNow, we represent all the implications using disjunctions and negations:\n\n$$\n¬((R⇒S)∧(S⇒R))≡¬((¬R∨S)∧(¬S∨R))\n$$\n\nNext, we use De Morgan's laws:\n\n$$\n\\begin{aligned}¬((¬R∨S)∧(¬S∨R)) & ≡¬(¬R∨S)∨¬(¬S∨R) \\\\  & ≡(¬¬R∧¬S)∨(¬¬S∧¬R)\\end{aligned}\n$$\n\nFinally, we simplify the double negations:\n\n$$\n\\begin{aligned}(¬¬R∧¬S)∨(¬¬S∧¬R) & ≡(R∧¬S)∨(S∧¬R)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060144 :knowledge-point/_questions [{:db/id #edb/ref 17592186059777 :knowledge-point/id #uuid "fe8eb0bd-6d37-5eb8-98fd-796b2af992f7" :knowledge-point/title "Using the Equivalence Truth Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "939591f4-de0a-55c7-bc65-422a0183dd6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F" :db/id #edb/ref 17592186057231} {:answer/id #uuid "fae2ff86-e3d6-5a6a-9dfc-87a68d60decc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "T" :db/id #edb/ref 17592186057232}] :answer-field/id #uuid "6a02bb1a-19e1-5cc0-9aa7-c8f0966e476b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186057230} {:answer-field/choices [{:answer/id #uuid "ca0539e2-445c-518a-845a-2b52d85bde12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "T" :db/id #edb/ref 17592186057234} {:answer/id #uuid "d2a2d1c6-9d67-5f24-8144-7be5f7d9e4a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F" :db/id #edb/ref 17592186057235}] :answer-field/id #uuid "33ef370e-b718-564e-8916-d70c2cabcf0b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186057233} {:answer-field/choices [{:answer/id #uuid "d9dc8b9f-28d8-5e75-8efc-a7d0782b552e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "F" :db/id #edb/ref 17592186057237} {:answer/id #uuid "6ac57223-cf00-5f4a-baab-5e67c0b69580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "T" :db/id #edb/ref 17592186057238}] :answer-field/id #uuid "05768901-5eed-5ef0-b9a4-e6617e565643" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186057236}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "342fdb96-915c-5b25-80a4-1115d5bf9dc7" :question/math-academy-id "q-182475" :question/problem "Find the missing values in the following truth table:\n\n| $A$ | $B$ | $A⇔B$ |\n| --- | ---: | ---: |\n| $T$ | $T$ | $T$ |\n| $T$ | $F$ | {{field-1}} |\n| $F$ | $T$ | {{field-2}} |\n| $F$ | $F$ | {{field-3}} |"}] [{:db/id #edb/ref 17592186573323 :knowledge-point/_questions [{:db/id #edb/ref 17592186059780 :knowledge-point/id #uuid "4e85e1e6-6a11-52e6-96d3-a768ced940d4" :knowledge-point/title "Simplifying Expressions Involving Equivalences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39daa7e5-cb5c-5741-9a21-580afc034598" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∧B)∨(¬A∧¬B)" :db/id #edb/ref 17592186572886} {:answer/id #uuid "73f3ee55-620c-5e19-9c18-cc60974bcb4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬A∧B" :db/id #edb/ref 17592186572970} {:answer/id #uuid "74facaaf-1f98-50c8-acb9-65561bcc86c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(¬A∧B)∧(A∧¬B)" :db/id #edb/ref 17592186572971} {:answer/id #uuid "8ec18d04-5193-5b30-b1d2-9879366eceac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧¬B" :db/id #edb/ref 17592186573007} {:answer/id #uuid "af4e153b-eba0-5317-8b16-e0bc3532fae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(¬A∧B)∨(A∧¬B)" :db/id #edb/ref 17592186573047}] :answer-field/correct {:answer/id #uuid "af4e153b-eba0-5317-8b16-e0bc3532fae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(¬A∧B)∨(A∧¬B)" :db/id #edb/ref 17592186573047} :answer-field/id #uuid "4965da56-6033-5b41-a06c-91a9fdf4486b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573175}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f686088d-e105-5e19-956f-e84bb86ba487" :question/math-academy-id "q-182522" :question/problem "$¬(B⇔A)≡$" :question/worked-solution "First, we use the definition of the biconditional statement to write the equivalence as a conjunction of implications: \n\n$$\n¬(B⇔A)≡¬[(B⇒A)∧(A⇒B)]\n$$\n\nNow, we represent all the implications using disjunctions and negations:\n\n$$\n¬[(B⇒A)∧(A⇒B)]≡¬[(¬B∨A)∧(¬A∨B)]\n$$\n\nNext, we use De Morgan's laws:\n\n$$\n\\begin{aligned}¬[(¬B∨A)∧(¬A∨B)] & ≡¬(¬B∨A)∨¬(¬A∨B) \\\\  & ≡(¬¬B∧¬A)∨(¬¬A∧¬B)\\end{aligned}\n$$\n\nFinally, we simplify the double negations and write down symbols in alphabetic order inside the parentheses using commutative laws:\n\n$$\n\\begin{aligned}(¬¬B∧¬A)∨(¬¬A∧¬B) & ≡(B∧¬A)∨(A∧¬B) \\\\  & ≡(¬A∧B)∨(A∧¬B)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186411157 :knowledge-point/_questions [{:db/id #edb/ref 17592186059780 :knowledge-point/id #uuid "4e85e1e6-6a11-52e6-96d3-a768ced940d4" :knowledge-point/title "Simplifying Expressions Involving Equivalences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0833f240-185e-532a-824f-4ccd738ff6d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(Y∧X)∨(¬X∧¬Y)" :db/id #edb/ref 17592186411120} {:answer/id #uuid "81e51dfb-5df1-5588-964c-928acab1bcb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "X∧¬Y" :db/id #edb/ref 17592186411131} {:answer/id #uuid "8bda5940-fd50-546b-b1c8-6f4ae1ea16b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬X∧Y" :db/id #edb/ref 17592186411133} {:answer/id #uuid "999bcf3c-92e7-59d4-bcad-b3707c6d09dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(Y∧¬X)∧(X∧¬Y)" :db/id #edb/ref 17592186411135} {:answer/id #uuid "9b327029-890c-51ee-9cd1-2d50c1493769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(Y∧¬X)∨(X∧¬Y)" :db/id #edb/ref 17592186411136}] :answer-field/correct {:answer/id #uuid "9b327029-890c-51ee-9cd1-2d50c1493769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(Y∧¬X)∨(X∧¬Y)" :db/id #edb/ref 17592186411136} :answer-field/id #uuid "67aed17a-d2cd-554a-99c0-e5486a53aa69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411147}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96aebafe-ff76-58ac-a04c-e47b82d4e2a3" :question/math-academy-id "q-182523" :question/problem "$¬(Y⇔X)≡$" :question/worked-solution "First, we use the definition of the biconditional statement to write the equivalence as a conjunction of implications: \n\n$$\n¬(Y⇔X)≡¬[(Y⇒X)∧(X⇒Y)]\n$$\n\nNow, we represent all the implications using disjunctions and negations:\n\n$$\n¬[(Y⇒X)∧(X⇒Y)]≡¬[(¬Y∨X)∧(¬X∨Y)]\n$$\n\nNext, we use De Morgan's laws:\n\n$$\n\\begin{aligned}¬[(¬Y∨X)∧(¬X∨Y)] & ≡¬(¬Y∨X)∨¬(¬X∨Y) \\\\  & ≡(¬¬Y∧¬X)∨(¬¬X∧¬Y)\\end{aligned}\n$$\n\nFinally, we simplify the double negations:\n\n$$\n\\begin{aligned}(¬¬Y∧¬X)∨(¬¬X∧¬Y) & ≡(Y∧¬X)∨(X∧¬Y)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573301 :knowledge-point/_questions [{:db/id #edb/ref 17592186059780 :knowledge-point/id #uuid "4e85e1e6-6a11-52e6-96d3-a768ced940d4" :knowledge-point/title "Simplifying Expressions Involving Equivalences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "076d8325-3509-54e0-a053-b1ec5569d452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(R∧S)∧¬(R∨S)" :db/id #edb/ref 17592186572834} {:answer/id #uuid "690f9668-60b9-5816-9a5e-fa2a8f0eade8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(R∧S)∨¬(R∧S)" :db/id #edb/ref 17592186572951} {:answer/id #uuid "b77c5221-ae94-51e9-b8ce-b5340fd8bf22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(R∧S)∨¬(R∨S)" :db/id #edb/ref 17592186573056} {:answer/id #uuid "d24955ed-685d-5b34-8787-96d77fb1de82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(R∨S)∧¬(R∧S)" :db/id #edb/ref 17592186573089} {:answer/id #uuid "f0ee5d7a-4c7f-5f1d-b042-6f7a75f80cd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "¬R⇔S" :db/id #edb/ref 17592186573131}] :answer-field/correct {:answer/id #uuid "b77c5221-ae94-51e9-b8ce-b5340fd8bf22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(R∧S)∨¬(R∨S)" :db/id #edb/ref 17592186573056} :answer-field/id #uuid "a7422327-ad06-592f-a13d-35e60fbb5a20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573209}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "babcf679-477c-52f6-b009-8d35e055441b" :question/math-academy-id "q-182524" :question/problem "$¬(R⇔¬S)≡$" :question/worked-solution "First, we use the definition of the biconditional statement to write the equivalence as a conjunction of implications: \n\n$$\n¬(R⇔¬S)≡¬[(R⇒¬S)∧(¬S⇒R)]\n$$\n\nNow, we represent all the implications using disjunctions and negations:\n\n$$\n¬[(R⇒¬S)∧(¬S⇒R)]≡¬[(¬R∨¬S)∧(¬¬S∨R)]\n$$\n\nNext, we simplify the double negations:\n\n$$\n¬[(¬R∨¬S)∧(¬¬S∨R)]≡¬[(¬R∨¬S)∧(S∨R)]\n$$\n\nNow, we use De Morgan's laws:\n\n$$\n\\begin{aligned}¬[(¬R∨¬S)∧(S∨R)] & ≡¬(¬R∨¬S)∨¬(S∨R) \\\\  & ≡(¬¬R∧¬¬S)∨¬(S∨R)\\end{aligned}\n$$\n\nFinally, we again simplify the double negations and write down symbols in alphabetic order inside the parentheses using commutative laws:\n\n$$\n\\begin{aligned}(¬¬R∧¬¬S)∨¬(S∨R) & ≡(R∧S)∨¬(S∨R) \\\\  & ≡(R∧S)∨¬(R∨S)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186573317 :knowledge-point/_questions [{:db/id #edb/ref 17592186059777 :knowledge-point/id #uuid "fe8eb0bd-6d37-5eb8-98fd-796b2af992f7" :knowledge-point/title "Using the Equivalence Truth Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82f681a1-0b3c-5803-8e07-63d9408a9f9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "sometimes false" :db/id #edb/ref 17592186572993} {:answer/id #uuid "95fda5b2-41b7-5f84-a8c6-0bac46270c86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "sometimes true" :db/id #edb/ref 17592186573021} {:answer/id #uuid "c40155d8-dfe0-521d-ada0-32ee2755b311" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "always true" :db/id #edb/ref 17592186573071} {:answer/id #uuid "dd386d27-29fb-5876-82ae-816c9964363a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "always false" :db/id #edb/ref 17592186573104}] :answer-field/correct {:answer/id #uuid "dd386d27-29fb-5876-82ae-816c9964363a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "always false" :db/id #edb/ref 17592186573104} :answer-field/id #uuid "2e701f88-7e5e-53b4-8ecd-de2a796d1c4f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186573169}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ec004b06-3312-5bf4-be49-682afc34bcbf" :question/math-academy-id "q-182531" :question/problem "If $A$ is false and $B$ is true, then $A⇔B$ is\n\n{{field-1}}." :question/worked-solution "According to the definition of the biconditional, \n\n- $A⇔B$ is true if $A⇒B$ **and** $B⇒A.$ Otherwise, it is false.\n\n- In other words, $A⇔B$ is true if $A$ and $B$ have the same truth values. Otherwise, it is false.\n\nSo, when $A=\\text{F}$ and $B=\\text{T},$ we have\n\n$$\n\\begin{aligned}(A⇔B) & =(\\text{F}⇔\\text{T}) \\\\  & =\\text{F}.\\end{aligned}\n$$\n\nThe complete truth table is shown below:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A⇔B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n|  |  |  |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |"}] [{:db/id #edb/ref 17592186573303 :knowledge-point/_questions [{:db/id #edb/ref 17592186059777 :knowledge-point/id #uuid "fe8eb0bd-6d37-5eb8-98fd-796b2af992f7" :knowledge-point/title "Using the Equivalence Truth Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11d525de-5570-51a2-8903-a4fe37069249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186572844} {:answer/id #uuid "c584f988-9f19-5b15-abcd-fbfc601c7938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186573073}] :answer-field/correct {:answer/id #uuid "11d525de-5570-51a2-8903-a4fe37069249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186572844} :answer-field/id #uuid "1a364f31-5361-538d-8ff0-9aff626f051b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186573160} {:answer-field/choices [{:answer/id #uuid "0ed4e36c-d236-5be9-a3f3-a7f4ec88