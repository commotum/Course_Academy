      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153799/observations/step-q163217-56e5f64a77e5791cb4ed.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153799/observations/step-q163217-56e5f64a77e5791cb4ed.png",
      "source_url": "https://mathacademy.com/tasks/14153799/topics/2027/review",
      "captured_at": 1791864981.7424467,
      "math_academy_id": "q-163217",
