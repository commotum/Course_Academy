      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153799/observations/step-q163171-3a23e77268ac6d00a06f.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153799/observations/step-q163171-3a23e77268ac6d00a06f.png",
      "source_url": "https://mathacademy.com/tasks/14153799/topics/2027/review",
      "captured_at": 1791864937.7729602,
      "math_academy_id": "q-163171",
      "topic_id": "2027",
