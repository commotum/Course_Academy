      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153799/observations/step-q163219-a3f2ba3a9f170df9561b.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153799/observations/step-q163219-a3f2ba3a9f170df9561b.png",
