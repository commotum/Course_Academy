] [17592186368117 #edb/ref 1075 #edb/ref 17592186368119 #edb/ref 17592186045417] [17592186368117 #edb/ref 1075 #edb/ref 17592186368120 #edb/ref 17592186045417] [17592186368117 #edb/ref 1075 #edb/ref 17592186368121 #edb/ref 17592186045417] [17592186368117 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186368117 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186368117 #edb/ref 1078 #edb/ref 17592186368119 #edb/ref 17592186045417] [17592186368117 #edb/ref 1079 #uuid "f5c3dfe3-4874-5366-8605-975305c9e601" #edb/ref 17592186045417] [17592186368118 #edb/ref 1080 "|\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}|" #edb/ref 17592186045417] [17592186368118 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186368118 #edb/ref 1083 #uuid "72340dc1-5dda-5425-8945-6d48e1143d2b" #edb/ref 17592186045417] [17592186368119 #edb/ref 1080 "|\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}|" #edb/ref 17592186045417] [17592186368119 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186368119 #edb/ref 1083 #uuid "3ecdaede-59ca-5ab4-a488-3865e7146c27" #edb/ref 17592186045417] [17592186368120 #edb/ref 1080 "|\\begin{aligned}-\\pi  & 0 \\\\ 2 & 0\\end{aligned}|" #edb/ref 17592186045417] [17592186368120 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186368120 #edb/ref 1083 #uuid "aaf12431-0a5a-53d0-8213-0b17195297a5" #edb/ref 17592186045417] [17592186368121 #edb/ref 1080 "|\\begin{aligned}0 & \\pi  \\\\ 1 & 0\\end{aligned}|" #edb/ref 17592186045417] [17592186368121 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186368121 #edb/ref 1083 #uuid "aada5db9-0588-53a6-8255-685956e45ce9" #edb/ref 17592186045417] [17592186368122 #edb/ref 1075 #edb/ref 17592186368123 #edb/ref 17592186045417] [17592186368122 #edb/ref 1075 #edb/ref 17592186368124 #edb/ref 17592186045417] [17592186368122 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186368122 #edb/ref 1077 "field-2" #edb/ref 175