rname{cos}⁡(\\pi x)-1\\end{aligned}].$\n\nWe need to compute the Jacobian determinant of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\nJ=|\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}|\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(x\\operatorname{sin}⁡(\\pi y))=\\operatorname{sin}⁡(\\pi y),\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(x\\operatorname{sin}⁡(\\pi y))=\\pi x\\operatorname{cos}⁡(\\pi y) \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({y}^{2}+\\operatorname{cos}⁡(\\pi x)-1)=-\\pi \\operatorname{sin}⁡(\\pi x),\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂x}({y}^{2}+\\operatorname{cos}⁡(\\pi x)-1)=2y\\end{aligned}\n$$\n\nThus, we have\n\n$$\nJ=|\\begin{aligned}\\operatorname{sin}⁡(\\pi y) & \\pi x\\operatorname{cos}⁡(\\pi y) \\\\ -\\pi \\operatorname{sin}⁡(\\pi x) & 2y\\end{aligned}|.\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to get\n\n$$\n\\begin{aligned}J(0,0) & =|\\begin{aligned}\\operatorname{sin}⁡(0) & \\pi (0)\\operatorname{cos}⁡(0) \\\\ -\\pi \\operatorname{sin}⁡(0) & 2(0)\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}| \\\\  & =0.\\end{aligned}\n$$\n\nFinally, since the Jacobian determinant is zero, our system is $\\text{not almost linear}$ at ${x}^{∗}.$"}] [{:db/id #edb/ref 17592186444533 :knowledge-point/_questions [{:db/id #edb/ref 17592186221418 :knowledge-point/id #uuid "a9aeac73-8ee3-5fef-a47c-a96e3545d89c" :knowledge-point/title "Finding the Linear Approximations Near Equilibria"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a74585fc-43b7-580d-95e5-5d075a0f7994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186444482}] :answer-field/correct {:answer/id #uuid "a74585fc-43b7-580d-95e5-5d075a0f7994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186444482} :answer-field/id #uuid "d9c48156-6c36-5682-8a0c-533f385ce593" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444525} {:answer-field/choices [{:answer/id #uuid "e991a0bf-9f6b-5211-a7d0-c91413fe8845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186444492}] :answer-field/correct {:answer/id #uuid "e991a0bf-9f6b-5211-a7d0-c91413fe8845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186444492} :answer-field/id #uuid "e6b282bb-52e2-5ba2-92ff-89f8fe1cc11d" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444526} {:answer-field/choices [{:answer/id #uuid "047a0fe4-098e-5b1b-85f7-8eea9cbfcd48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444450}] :answer-field/correct {:answer/id #uuid "047a0fe4-098e-5b1b-85f7-8eea9cbfcd48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444450} :answer-field/id #uuid "eac3dd97-a737-5044-a0f0-cdc9088f977e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444528} {:answer-field/choices [{:answer/id #uuid "814de77e-70f6-5947-9487-b60887214561" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444471}] :answer-field/correct {:answer/id #uuid "814de77e-70f6-5947-9487-b60887214561" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444471} :answer-field/id #uuid "ebfec07f-2b8f-5c9f-a779-f1652bdc2150" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444529}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "056d7f87-a110-577b-a370-409d88e311c9" :question/math-academy-id "q-335136" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-x(t)+2{y}^{2}(t) \\\\ {y}^{′}(t)=-4x(t)+{x}^{2}(t)\\end{aligned}\n$$\n\nConsider the system of differential equations above. What is the corresponding linearized system at the equilibrium point ${x}^{∗}=[0,\\text{ }0]^{T}?$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${u}^{′}=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"50px\">{{field-1}}</td>\n<td align=\"center\" width=\"50px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,u,\\,$ where $u=x-{x}^{∗}$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $\\text{\\boldsymbol}f(x)=[\\begin{aligned}-x+2{y}^{2} \\\\ -4x+{x}^{2}\\end{aligned}].$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(-x+2{y}^{2})=-1,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(-x+2{y}^{2})=4y \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(-4x+{x}^{2})=-4+2x,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(-4x+{x}^{2})=0\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}-1 & 4y \\\\ -4+2x & 0\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=[\\begin{aligned}-1 & 4(0) \\\\ -4+2(0) & 0\\end{aligned}]=[\\begin{aligned}-1 & 0 \\\\ -4 & 0\\end{aligned}].\n$$\n\nFinally, near the equilibrium, the nonlinear system is approximated by\n\n$$\n{u}^{′}=[\\begin{aligned}-1 & 0 \\\\ -4 & 0\\end{aligned}]u,\n$$\n\nwhere the deviation vector is\n\n$$\nu=x-{x}^{∗}=[\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}0 \\\\ 0\\end{aligned}]=[\\begin{aligned}x \\\\ y\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186444541 :knowledge-point/_questions [{:db/id #edb/ref 17592186221418 :knowledge-point/id #uuid "a9aeac73-8ee3-5fef-a47c-a96e3545d89c" :knowledge-point/title "Finding the Linear Approximations Near Equilibria"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f32677a8-f34a-553b-9a82-9ec020d11dc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444497}] :answer-field/correct {:answer/id #uuid "f32677a8-f34a-553b-9a82-9ec020d11dc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444497} :answer-field/id #uuid "09f65387-8ba8-5141-ba8a-df8f2bbbf3ab" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444504} {:answer-field/choices [{:answer/id #uuid "e30ed290-68c5-52dc-965d-511f089e8620" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186444491}] :answer-field/correct {:answer/id #uuid "e30ed290-68c5-52dc-965d-511f089e8620" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186444491} :answer-field/id #uuid "437ce4a5-5dc9-5925-ae4d-585c8c8f74fc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444513} {:answer-field/choices [{:answer/id #uuid "5de99c57-aa35-5b2f-a607-d5829c37aa45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444463}] :answer-field/correct {:answer/id #uuid "5de99c57-aa35-5b2f-a607-d5829c37aa45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186444463} :answer-field/id #uuid "93a1d6d3-7477-5a08-8996-177851628c79" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444520} {:answer-field/choices [{:answer/id #uuid "b4ff3df2-4cd8-543e-85f5-87acb8ccb94f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186444484}] :answer-field/correct {:answer/id #uuid "b4ff3df2-4cd8-543e-85f5-87acb8ccb94f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186444484} :answer-field/id #uuid "9e03c506-fce9-59d6-a650-e23e814065e8" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444521}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ba7562c9-dc1e-5d77-b34b-c5d59c44924f" :question/math-academy-id "q-335146" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)={y}^{2}(t)-7x(t) \\\\ {y}^{′}(t)={x}^{2}(t)+6y(t)\\end{aligned}\n$$\n\nConsider the system of differential equations above. What is the corresponding linearized system at the equilibrium point ${x}^{∗}=[0,\\text{ }0]^{T}?$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${u}^{′}=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"50px\">{{field-1}}</td>\n<td align=\"center\" width=\"50px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,u,\\,$ where $u=x-{x}^{∗}$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $\\text{\\boldsymbol}f(x)=[\\begin{aligned}{y}^{2}-7x \\\\ {x}^{2}+6y\\end{aligned}].$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}({y}^{2}-7x)=-7,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}({y}^{2}-7x)=2y \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({x}^{2}+6y)=2x,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({x}^{2}+6y)=6\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}-7 & 2y \\\\ 2x & 6\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=[\\begin{aligned}-7 & 2(0) \\\\ 2(0) & 6\\end{aligned}]=[\\begin{aligned}-7 & 0 \\\\ 0 & 6\\end{aligned}].\n$$\n\nFinally, near the equilibrium, the nonlinear system is approximated by\n\n$$\n{u}^{′}=[\\begin{aligned}-7 & 0 \\\\ 0 & 6\\end{aligned}]u,\n$$\n\nwhere the deviation vector is\n\n$$\nu=x-{x}^{∗}=[\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}0 \\\\ 0\\end{aligned}]=[\\begin{aligned}x \\\\ y\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186444539 :knowledge-point/_questions [{:db/id #edb/ref 17592186221419 :knowledge-point/id #uuid "777fae40-2377-5e63-89f6-5c857beba2b2" :knowledge-point/title "Classifying an Isolated Critical Point of a Nonlinear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96be3107-0cb4-5d1a-b521-44976f754743" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral sink" :db/id #edb/ref 17592186444479} {:answer/id #uuid "c556e800-1066-566b-bf43-0cfcdca7d9cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral source" :db/id #edb/ref 17592186444488} {:answer/id #uuid "f0fe5180-e59f-52de-85cf-407940214623" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "source" :db/id #edb/ref 17592186444496}] :answer-field/correct {:answer/id #uuid "f0fe5180-e59f-52de-85cf-407940214623" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "source" :db/id #edb/ref 17592186444496} :answer-field/id #uuid "5319ccbb-ca29-5b39-970f-99bd75a0ebcc" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186444515} {:answer-field/choices [{:answer/id #uuid "682cd089-8e13-55c2-9498-40b7761fee9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "asymptotically stable" :db/id #edb/ref 17592186444469} {:answer/id #uuid "f87b2376-9c6e-540a-b6f2-620442d5299a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unstable" :db/id #edb/ref 17592186444501}] :answer-field/correct {:answer/id #uuid "f87b2376-9c6e-540a-b6f2-620442d5299a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unstable" :db/id #edb/ref 17592186444501} :answer-field/id #uuid "eab9dd67-f41e-5506-a8b5-c3347f7c7560" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186444527}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73b75bfd-1216-5131-9b02-68e4ee57dee1" :question/math-academy-id "q-336683" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=2x(t)+\\operatorname{sin}⁡(x(t))+\\operatorname{ln}⁡(y(t)^{2}+1) \\\\ {y}^{′}(t)=5y(t)+{tan}^{-1}⁡(x(t))\\end{aligned}\n$$\n\nConsider the system of differential equations above. What is the behavior of the system's solutions near the equilibrium ${x}^{∗}=[0,\\text{ }0]^{T}?$\n\n$\\,$\nThe equilibrium is an \n{{field-1}}{{field-2}}." :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and \n$\\text{\\boldsymbol}f(x)=[\\begin{aligned}2x+\\operatorname{sin}⁡(x)+\\operatorname{ln}⁡({y}^{2}+1) \\\\ 5y+{tan}^{-1}⁡(x)\\end{aligned}].$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(2x+\\operatorname{sin}⁡(x)+\\operatorname{ln}⁡({y}^{2}+1))=2+\\operatorname{cos}⁡(x) \\\\ \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(2x+\\operatorname{sin}⁡(x)+\\operatorname{ln}⁡({y}^{2}+1))=\\frac{2y}{{y}^{2}+1} \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(5y+{tan}^{-1}⁡(x))=\\frac{1}{1+{x}^{2}} \\\\ \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(5y+{tan}^{-1}⁡(x))=5\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}2+\\operatorname{cos}⁡(x) & \\frac{2y}{{y}^{2}+1} \\\\ \\frac{1}{1+{x}^{2}} & 5\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=[\\begin{aligned}2+\\operatorname{cos}⁡(0) & \\frac{2(0)}{(0)^{2}+1} \\\\ \\frac{1}{1+(0)^{2}} & 5\\end{aligned}]=[\\begin{aligned}3 & 0 \\\\ 1 & 5\\end{aligned}].\n$$\n\nNotice that the matrix is invertible (its determinant is not zero), so the system is almost linear at ${x}^{∗}.$\n\nTo find the eigenvalues of the Jacobian matrix, we write down the characteristic equation:\n\n$$\n\\begin{aligned}|\\begin{aligned}3-\\lambda  & 0 \\\\ 1 & 5-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )(5-\\lambda ) & =0\\end{aligned}\n$$\n\nSolving the equation, we get the eigenvalues ${\\lambda }_{1,2}=3,\\text{ }5.$\n\nFinally, since we both have two real and positive eigenvalues,, our equilibrium is an $\\text{unstable}$ $\\text{source}.$"}] [{:db/id #edb/ref 17592186444537 :knowledge-point/_questions [{:db/id #edb/ref 17592186221417 :knowledge-point/id #uuid "bd9680fc-dfa9-5411-aeca-81659b7dec8a" :knowledge-point/title "Identifying Almost Linear Systems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d2afa48-09df-57de-91de-9c0cb5eb84df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "almost linear" :db/id #edb/ref 17592186444475} {:answer/id #uuid "9235f6c0-3319-580d-b3bf-fdbbd06f932b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "not almost linear" :db/id #edb/ref 17592186444477}] :answer-field/correct {:answer/id #uuid "8d2afa48-09df-57de-91de-9c0cb5eb84df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "almost linear" :db/id #edb/ref 17592186444475} :answer-field/id #uuid "2a3ff5ab-5195-5904-838a-34e77d3c3d2c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186444510} {:answer-field/choices [{:answer/id #uuid "4e44e2d9-fd5b-5274-a4c1-fe92c4c28ddb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & \\pi  \\\\ 1 & 0\\end{aligned}|" :db/id #edb/ref 17592186444457} {:answer/id #uuid "934d5518-0836-5d37-8cc1-567ae23d217f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}4 & 1 \\\\ 1 & 2\\end{aligned}|" :db/id #edb/ref 17592186444478} {:answer/id #uuid "ea6ca74f-2f76-5dbf-a29a-a13e77e73e61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}|" :db/id #edb/ref 17592186444493} {:answer/id #uuid "f5dbd0c7-4811-55a5-be98-82a11c521cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}|" :db/id #edb/ref 17592186444498}] :answer-field/correct {:answer/id #uuid "934d5518-0836-5d37-8cc1-567ae23d217f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}4 & 1 \\\\ 1 & 2\\end{aligned}|" :db/id #edb/ref 17592186444478} :answer-field/id #uuid "5fa690cb-f556-55fa-af0b-ad088f3e0b28" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186444517}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45a54fce-a708-5a31-9c28-340df3e868af" :question/math-academy-id "q-336882" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)={x}^{2}(t)+y(t)-5 \\\\ {y}^{′}(t)={y}^{2}(t)+x(t)-3\\end{aligned}\n$$\n\nGiven the system of differential equations, select the correct options below.\n\nThe Jacobian determinant of the system at the equilibrium point ${x}^{∗}=[2,\\text{ }1]^{T}$ is given as\n\n$$\nJ(2,1)={{field-1}}.\n$$\n\nAt this point, the system is \n{{field-2}}\nat ${x}^{∗}.$" :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and \n$\\text{\\boldsymbol}f(x)=[\\begin{aligned}{x}^{2}+y-5 \\\\ {y}^{2}+x-3\\end{aligned}].$\n\nWe need to compute the Jacobian determinant of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\nJ=|\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}|\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}({x}^{2}+y-5)=2x,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}({x}^{2}+y-5)=1 \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({y}^{2}+x-3)=1,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({y}^{2}+x-3)=2y\\end{aligned}\n$$\n\nThus, we have\n\n$$\nJ=|\\begin{aligned}2x & 1 \\\\ 1 & 2y\\end{aligned}|.\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}2 \\\\ 1\\end{aligned}]$ to get\n\n$$\n\\begin{aligned}J(2,1) & =|\\begin{aligned}2(2) & 1 \\\\ 1 & 2(1)\\end{aligned}| \\\\  & =|\\begin{aligned}4 & 1 \\\\ 1 & 2\\end{aligned}| \\\\  & =4\\cdot 2-1\\cdot 1 \\\\  & =7 \\\\  & \\ne 0.\\end{aligned}\n$$\n\nFinally, since the Jacobian determinant is not zero, our system is $\\text{almost linear}$ at ${x}^{∗}.$"}] [{:db/id #edb/ref 17592186444542 :knowledge-point/_questions [{:db/id #edb/ref 17592186221418 :knowledge-point/id #uuid "a9aeac73-8ee3-5fef-a47c-a96e3545d89c" :knowledge-point/title "Finding the Linear Approximations Near Equilibria"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c9c348d-a36b-53dd-81bb-ef33120ab054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186444462}] :answer-field/correct {:answer/id #uuid "5c9c348d-a36b-53dd-81bb-ef33120ab054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186444462} :answer-field/id #uuid "025cfb1a-50d5-5082-8686-5fcbb1c3f912" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444503} {:answer-field/choices [{:answer/id #uuid "f7c2e02c-9726-5a93-bbda-a22a6bf7595c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186444500}] :answer-field/correct {:answer/id #uuid "f7c2e02c-9726-5a93-bbda-a22a6bf7595c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186444500} :answer-field/id #uuid "0c34426b-2fc9-5fbf-b2d2-279d5189a4db" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444505} {:answer-field/choices [{:answer/id #uuid "daef1d20-d35f-5e42-a590-ffdbe947eed0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186444489}] :answer-field/correct {:answer/id #uuid "daef1d20-d35f-5e42-a590-ffdbe947eed0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186444489} :answer-field/id #uuid "180c8d44-02cf-5931-b8b4-81414f9c43e3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444506} {:answer-field/choices [{:answer/id #uuid "a68e2c01-d079-5ccc-a595-ded49893f847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186444481}] :answer-field/correct {:answer/id #uuid "a68e2c01-d079-5ccc-a595-ded49893f847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186444481} :answer-field/id #uuid "3ccc26cc-c67c-5c0e-a63d-47074ce83aa5" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444511}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e8e22bce-e115-5d92-9ec4-991287c11960" :question/math-academy-id "q-336902" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)={x}^{2}(t)-{y}^{2}(t)+3x(t)+2y(t)-1 \\\\ {y}^{′}(t)={x}^{2}(t)+y(t)-4x(t)+4\\end{aligned}\n$$\n\nConsider the system of differential equations above. What is the corresponding linearized system at the equilibrium point ${x}^{∗}=[1,\\text{ }-1]^{T}?$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${u}^{′}=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"50px\">{{field-1}}</td>\n<td align=\"center\" width=\"50px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,u,\\,$ where $u=x-{x}^{∗}$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and \n$\\text{\\boldsymbol}f(x)=[\\begin{aligned}{x}^{2}-{y}^{2}+3x+2y-1 \\\\ {x}^{2}+y-4x+4\\end{aligned}].$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}({x}^{2}-{y}^{2}+3x+2y-1)=2x+3,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}({x}^{2}-{y}^{2}+3x+2y-1)=-2y+2 \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({x}^{2}+y-4x+4)=2x-4,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({x}^{2}+y-4x+4)=1\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}2x+3 & -2y+2 \\\\ 2x-4 & 1\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}1 \\\\ -1\\end{aligned}]$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=[\\begin{aligned}2(1)+3 & -2(-1)+2 \\\\ 2(1)-4 & 1\\end{aligned}]=[\\begin{aligned}5 & 4 \\\\ -2 & 1\\end{aligned}].\n$$\n\nFinally, near the equilibrium, the nonlinear system is approximated by\n\n$$\n{u}^{′}=[\\begin{aligned}5 & 4 \\\\ -2 & 1\\end{aligned}]u,\n$$\n\nwhere the deviation vector is\n\n$$\nu=x-{x}^{∗}=[\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}1 \\\\ -1\\end{aligned}]=[\\begin{aligned}x-1 \\\\ y+1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186368184 :knowledge-point/_questions [{:db/id #edb/ref 17592186221418 :knowledge-point/id #uuid "a9aeac73-8ee3-5fef-a47c-a96e3545d89c" :knowledge-point/title "Finding the Linear Approximations Near Equilibria"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aae2533e-427c-5750-ae66-88d1e4378acc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186368186}] :answer-field/correct {:answer/id #uuid "aae2533e-427c-5750-ae66-88d1e4378acc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186368186} :answer-field/id #uuid "b8d25b9b-5373-5c00-8a36-5090fe82791f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368185} {:answer-field/choices [{:answer/id #uuid "9c5fc6a0-19fe-56a4-9cf0-1de76c6493f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186368188}] :answer-field/correct {:answer/id #uuid "9c5fc6a0-19fe-56a4-9cf0-1de76c6493f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186368188} :answer-field/id #uuid "4c29b406-8180-595f-9aae-3d178f19a2c1" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368187} {:answer-field/choices [{:answer/id #uuid "af767bc3-d9be-53cf-8407-19d1ce259c7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186368190}] :answer-field/correct {:answer/id #uuid "af767bc3-d9be-53cf-8407-19d1ce259c7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186368190} :answer-field/id #uuid "66e37ca5-6012-50f9-89f3-865526e6acc9" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368189} {:answer-field/choices [{:answer/id #uuid "320daf72-7d61-5223-a594-9af115706e44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186368192}] :answer-field/correct {:answer/id #uuid "320daf72-7d61-5223-a594-9af115706e44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186368192} :answer-field/id #uuid "0090cd01-6fbb-5a08-8dac-f73a47491295" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186368191}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "764d1d84-2f88-5b8f-983f-958d465089bf" :question/math-academy-id "q-336904" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)={x}^{2}(t)+x(t)y(t)-2x(t)+3y(t)+5 \\\\ {y}^{′}(t)={y}^{2}(t)-x(t)+4y(t)+4\\end{aligned}\n$$\n\nConsider the system of differential equations above. What is the corresponding linearized system at the equilibrium point ${x}^{∗}=[1,\\text{ }-1]^{T}?$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${u}^{′}=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"50px\">{{field-1}}</td>\n<td align=\"center\" width=\"50px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,u,\\,$ where $u=x-{x}^{∗}$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and \n$\\text{\\boldsymbol}f(x)=[\\begin{aligned}{x}^{2}+xy-2x+3y+5 \\\\ {y}^{2}-x+4y+4\\end{aligned}].$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}({x}^{2}+xy-2x+3y+5)=2x+y-2,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}({x}^{2}+xy-2x+3y+5)=x+3 \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({y}^{2}-x+4y+4)=-1,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({y}^{2}-x+4y+4)=2y+4\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}2x+y-2 & x+3 \\\\ -1 & 2y+4\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}1 \\\\ -1\\end{aligned}]$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=[\\begin{aligned}2(1)+(-1)-2 & 1+3 \\\\ -1 & 2(-1)+4\\end{aligned}]=[\\begin{aligned}-1 & 4 \\\\ -1 & 2\\end{aligned}].\n$$\n\nFinally, near the equilibrium, the nonlinear system is approximated by\n\n$$\n{u}^{′}=[\\begin{aligned}-1 & 4 \\\\ -1 & 2\\end{aligned}]u,\n$$\n\nwhere the deviation vector is\n\n$$\nu=x-{x}^{∗}=[\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}1 \\\\ -1\\end{aligned}]=[\\begin{aligned}x-1 \\\\ y+1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186444538 :knowledge-point/_questions [{:db/id #edb/ref 17592186221419 :knowledge-point/id #uuid "777fae40-2377-5e63-89f6-5c857beba2b2" :knowledge-point/title "Classifying an Isolated Critical Point of a Nonlinear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35c3e72e-755c-5855-9dc1-693bcd430713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "saddle" :db/id #edb/ref 17592186444453} {:answer/id #uuid "4194eb5b-e8e8-52bf-ae3f-640f35c26071" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral source" :db/id #edb/ref 17592186444454} {:answer/id #uuid "ac89dec7-3711-5332-981c-e5af7f6e5723" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral sink" :db/id #edb/ref 17592186444483}] :answer-field/correct {:answer/id #uuid "4194eb5b-e8e8-52bf-ae3f-640f35c26071" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral source" :db/id #edb/ref 17592186444454} :answer-field/id #uuid "43333bf7-6c4e-5722-bb18-63f5f2d05e3b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186444512} {:answer-field/choices [{:answer/id #uuid "51dc4f1a-b8ef-5510-bb03-91610013ce6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "asymptotically stable" :db/id #edb/ref 17592186444459} {:answer/id #uuid "6014dc91-5d52-5025-b8e6-08bc57c4a993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unstable" :db/id #edb/ref 17592186444464}] :answer-field/correct {:answer/id #uuid "6014dc91-5d52-5025-b8e6-08bc57c4a993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unstable" :db/id #edb/ref 17592186444464} :answer-field/id #uuid "ec7e64f0-46b4-5113-827e-d2299e0897e2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186444530}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c33868d-8235-5c25-b35a-535f5738b142" :question/math-academy-id "q-336918" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=y(t)+(x(t)-2)^{3}+8 \\\\ {y}^{′}(t)=-2x(t)+4+\\operatorname{sin}⁡(y(t)+8)\\end{aligned}\n$$\n\nConsider the system of differential equations above. What is the behavior of the system's solutions near the equilibrium ${x}^{∗}=[2,\\text{ }-8]^{T}?$\n\n$\\,$\nThe equilibrium is an \n{{field-1}}{{field-2}}." :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and \n$\\text{\\boldsymbol}f(x)=[\\begin{aligned}y+(x-2)^{3}+8 \\\\ -2x+4+\\operatorname{sin}⁡(y+8)\\end{aligned}].$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(y+(x-2)^{3}+8)=3(x-2)^{2} \\\\ \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(-2x(t)+4+\\operatorname{sin}⁡(y(t)+8))=1 \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(-2x+4+\\operatorname{sin}⁡(y+8))=-2 \\\\ \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(-2x(t)+4+\\operatorname{sin}⁡(y(t)+8))=\\operatorname{cos}⁡(y+8)\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}3(x-2)^{2} & 1 \\\\ -2 & \\operatorname{cos}⁡(y+8)\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[2,\\text{ }-8]^{T}$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=[\\begin{aligned}3((2)-2)^{2} & 1 \\\\ -2 & \\operatorname{cos}⁡(-8+8)\\end{aligned}]=[\\begin{aligned}0 & 1 \\\\ -2 & 1\\end{aligned}].\n$$\n\nTo find the eigenvalues of the Jacobian matrix, we write down the characteristic equation:\n\n$$\n\\begin{aligned}|\\begin{aligned}0-\\lambda  & 1 \\\\ -2 & 1-\\lambda \\end{aligned}| & =0 \\\\ (-\\lambda )(1-\\lambda )-2 & =0 \\\\ {\\lambda }^{2}-\\lambda +2 & =0\\end{aligned}\n$$\n\nSolving the equation, we get the eigenvalues ${\\lambda }_{1,2}=\\frac{1}{2}\\pm \\frac{\\sqrt{7}}{2}i.$\n\nSince we have two complex eigenvalues with positive real parts, our equilibrium is an $\\text{unstable}$ $\\text{spiral source}.$"}] [{:db/id #edb/ref 17592186444540 :knowledge-point/_questions [{:db/id #edb/ref 17592186221419 :knowledge-point/id #uuid "777fae40-2377-5e63-89f6-5c857beba2b2" :knowledge-point/title "Classifying an Isolated Critical Point of a Nonlinear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60730a3e-e949-57de-8ec2-bc261b9d848e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "saddle" :db/id #edb/ref 17592186444466} {:answer/id #uuid "62e277f3-b18b-56f4-aa90-8bad13a1e90b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral sink" :db/id #edb/ref 17592186444468} {:answer/id #uuid "f69fa633-4c70-541f-a6c4-8d60a3b1d403" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral source" :db/id #edb/ref 17592186444499}] :answer-field/correct {:answer/id #uuid "60730a3e-e949-57de-8ec2-bc261b9d848e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "saddle" :db/id #edb/ref 17592186444466} :answer-field/id #uuid "8fed120f-3cd0-5b43-b0e2-666006741843" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186444519} {:answer-field/choices [{:answer/id #uuid "602cf795-4031-5bfc-83b2-fe8ca785f3b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "asymptotically stable" :db/id #edb/ref 17592186444465} {:answer/id #uuid "c2ba3315-c686-565d-8e5a-63bc28f08104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unstable" :db/id #edb/ref 17592186444487}] :answer-field/correct {:answer/id #uuid "c2ba3315-c686-565d-8e5a-63bc28f08104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unstable" :db/id #edb/ref 17592186444487} :answer-field/id #uuid "f625c762-bad3-507e-8e40-bec7a29d8f5f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186444532}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "74a51538-7992-5c00-9322-0a9614a20c67" :question/math-academy-id "q-336926" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)={x}^{2}+y-1 \\\\ {y}^{′}(t)=\\operatorname{ln}⁡(x+3)-y-(\\operatorname{ln}⁡3-1)\\end{aligned}\n$$\n\nConsider the system of differential equations above. What is the behavior of the system's solutions near the equilibrium ${x}^{∗}={[0,\\text{ }1]}^{T}?$\n\n$\\,$\nThe equilibrium is an \n{{field-1}}{{field-2}}." :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and \n$\\text{\\boldsymbol}f(x)=[\\begin{aligned}{x}^{2}+y-1 \\\\ \\operatorname{ln}⁡(x+3)-y-(\\operatorname{ln}⁡3-1)\\end{aligned}].$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}({x}^{2}+y-1)=2x \\\\ \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}({x}^{2}+y-1)=1 \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(x+3)-y-(\\operatorname{ln}⁡3-1))=\\frac{1}{x+3} \\\\ \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(\\operatorname{ln}⁡(x+3)-y-(\\operatorname{ln}⁡3-1))=-1\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}2x & 1 \\\\ \\frac{1}{x+3} & -1\\end{aligned}].\n$$\n\nNow, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}0 \\\\ 1\\end{aligned}]$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=[\\begin{aligned}0 & 1 \\\\ \\frac{1}{3} & -1\\end{aligned}].\n$$\n\nNotice that the matrix is invertible (its determinant is not zero), so the system is almost linear at ${x}^{∗}.$\n\nTo find the eigenvalues of the Jacobian matrix, we write down the characteristic equation:\n\n$$\n\\begin{aligned}|\\begin{aligned}-\\lambda  & 1 \\\\ \\frac{1}{3} & -1-\\lambda \\end{aligned}| & =0 \\\\ (-\\lambda )(-1-\\lambda )-\\frac{1}{3} & =0 \\\\ \\lambda (\\lambda +1)-\\frac{1}{3} & =0 \\\\ {\\lambda }^{2}+\\lambda -\\frac{1}{3} & =0\\end{aligned}\n$$\n\nSolving the equation, we get the eigenvalues ${\\lambda }_{1,2}=-\\frac{1}{2}\\pm \\frac{\\sqrt{21}}{6}.$\n\nFinally, since we have two real eigenvalues with opposite signs, our equilibrium is an $\\text{unstable}$ $\\text{saddle}.$"}] [{:db/id #edb/ref 17592186444543 :knowledge-point/_questions [{:db/id #edb/ref 17592186221419 :knowledge-point/id #uuid "777fae40-2377-5e63-89f6-5c857beba2b2" :knowledge-point/title "Classifying an Isolated Critical Point of a Nonlinear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b71bb514-1902-5366-9c65-2802bd8b7d2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unstable" :db/id #edb/ref 17592186444485} {:answer/id #uuid "b9a66a2a-e65d-5a2b-ad02-2948fa1cd356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "asymptotically stable" :db/id #edb/ref 17592186444486}] :answer-field/correct {:answer/id #uuid "b9a66a2a-e65d-5a2b-ad02-2948fa1cd356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "asymptotically stable" :db/id #edb/ref 17592186444486} :answer-field/id #uuid "b3c47420-898c-5eed-a1f6-36f38aa9d41e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186444522} {:answer-field/choices [{:answer/id #uuid "4e392284-bf67-5773-ac84-6acd62f23a6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "sink" :db/id #edb/ref 17592186444456} {:answer/id #uuid "ddecb96b-c156-543c-beb1-5817228d02ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "source" :db/id #edb/ref 17592186444490} {:answer/id #uuid "fc27b79b-7e6b-5b85-a343-6623191d10ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral sink" :db/id #edb/ref 17592186444502}] :answer-field/correct {:answer/id #uuid "4e392284-bf67-5773-ac84-6acd62f23a6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "sink" :db/id #edb/ref 17592186444456} :answer-field/id #uuid "bc7db006-7c89-5d8f-a5ab-4403236f4ab0" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186444523}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e9194ecf-6556-5bbf-bbe7-0cf26c275fb8" :question/math-academy-id "q-336934" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-3x(t)+y(t)^{2} \\\\ {y}^{′}(t)=-2y(t)+x(t)^{2}\\end{aligned}\n$$\n\nConsider the system of differential equations above. What is the behavior of the system's solutions near the equilibrium ${x}^{∗}=[0,\\text{ }0]^{T}?$\n\n$\\,$\nThe equilibrium is an \n{{field-1}}{{field-2}}." :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and \n$\\text{\\boldsymbol}f(x)=[\\begin{aligned}-3x+{y}^{2} \\\\ -2y+{x}^{2}\\end{aligned}].$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(-3x+{y}^{2})=-3 \\\\ \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(-3x+{y}^{2})=2y \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(-2y+{x}^{2})=2x \\\\ \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(-2y+{x}^{2})=-2\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}-3 & 2y \\\\ 2x & -2\\end{aligned}].\n$$\n\nNow evaluate the Jacobian at the equilibrium at ${x}^{∗}=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to get \n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=[\\begin{aligned}-3 & 2(0) \\\\ 2(0) & -2\\end{aligned}]=[\\begin{aligned}-3 & 0 \\\\ 0 & -2\\end{aligned}].\n$$\n\nNotice that the matrix is invertible (its determinant is not zero), so the system is almost linear at ${x}^{∗}.$\n\nTo find the eigenvalues of the Jacobian matrix, we write down the characteristic equation:\n\n$$\n\\begin{aligned}|\\begin{aligned}-3-\\lambda  & 0 \\\\ 0 & -2-\\lambda \\end{aligned}| & =0 \\\\ (-3-\\lambda )(-2-\\lambda ) & =0\\end{aligned}\n$$\n\nSolving the equation, we get the eigenvalues ${\\lambda }_{1,2}=-2,\\text{ }-3.$\n\nFinally, since we have two real and negative eigenvalues, our equilibrium is an $\\text{asymptotically stable}$ $\\text{sink}.$"}] [{:db/id #edb/ref 17592186444535 :knowledge-point/_questions [{:db/id #edb/ref 17592186221419 :knowledge-point/id #uuid "777fae40-2377-5e63-89f6-5c857beba2b2" :knowledge-point/title "Classifying an Isolated Critical Point of a Nonlinear System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "991487ac-27be-5ba6-b735-2aebd986386d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "asymptotically stable" :db/id #edb/ref 17592186444480} {:answer/id #uuid "ee31c528-c262-58b1-b5d9-40faa88c9ba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "unstable" :db/id #edb/ref 17592186444495}] :answer-field/correct {:answer/id #uuid "991487ac-27be-5ba6-b735-2aebd986386d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "asymptotically stable" :db/id #edb/ref 17592186444480} :answer-field/id #uuid "1f060b0a-5cae-57bf-bdcf-51f7b86e81a7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186444509} {:answer-field/choices [{:answer/id #uuid "2d6ad51e-f8fe-58e6-9d7d-79e8fd9d36c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "sink" :db/id #edb/ref 17592186444452} {:answer/id #uuid "56dc24d0-4973-5f7a-bb8c-a5b05670f2a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "spiral sink" :db/id #edb/ref 17592186444461} {:answer/id #uuid "610c3938-ff33-5c6b-9f7e-26e4e51f1564" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "source" :db/id #edb/ref 17592186444467}] :answer-field/correct {:answer/id #uuid "2d6ad51e-f8fe-58e6-9d7d-79e8fd9d36c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "sink" :db/id #edb/ref 17592186444452} :answer-field/id #uuid "d8486c7e-8a0c-5692-a6e8-5d35730ed341" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186444524}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3df14087-9cbc-58b7-a996-90852883ca3a" :question/math-academy-id "q-336937" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-4x(t)-2x(t)^{3}+y(t)^{2} \\\\ {y}^{′}(t)=-3y(t)-3y(t)^{3}+x(t)^{2}\\end{aligned}\n$$\n\nConsider the system of differential equations above. What is the behavior of the system's solutions near the equilibrium ${x}^{∗}=[0,\\text{ }0]^{T}?$\n\n$\\,$\nThe equilibrium is an \n{{field-1}}{{field-2}}." :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and \n\n$$\n\\text{\\boldsymbol}f(x)=[\\begin{aligned}-4x-2{x}^{3}+{y}^{2} \\\\ -3y-3{y}^{3}+{x}^{2}\\end{aligned}].\n$$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(-4x-2{x}^{3}+{y}^{2})=-4-6{x}^{2} \\\\ \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(-4x-2{x}^{3}+{y}^{2})=2y \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(-3y-3{y}^{3}+{x}^{2})=2x \\\\ \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(-3y-3{y}^{3}+{x}^{2})=-3-9{y}^{2}\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}-4-6{x}^{2} & 2y \\\\ 2x & -3-9{y}^{2}\\end{aligned}].\n$$\n\nNow evaluate the Jacobian at the equilibrium at ${x}^{∗}=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to get \n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=[\\begin{aligned}-4-6(0)^{2} & 2(0) \\\\ 2(0) & -3-9(0)^{2}\\end{aligned}]=[\\begin{aligned}-4 & 0 \\\\ 0 & -3\\end{aligned}].\n$$\n\nNotice that the matrix is invertible (its determinant is not zero), so the system is almost linear at ${x}^{∗}.$\n\nTo find the eigenvalues of the Jacobian matrix, we write down the characteristic equation:\n\n$$\n\\begin{aligned}|\\begin{aligned}-4-\\lambda  & 0 \\\\ 0 & -3-\\lambda \\end{aligned}| & =0 \\\\ (-4-\\lambda )(-3-\\lambda ) & =0\\end{aligned}\n$$\n\nSolving the equation, we get the eigenvalues ${\\lambda }_{1,2}=-3,\\text{ }-4.$\n\nFinally, since we have two real and negative eigenvalues, our equilibrium is an $\\text{asymptotically stable}$ $\\text{sink}.$"}] [{:db/id #edb/ref 17592186444536 :knowledge-point/_questions [{:db/id #edb/ref 17592186221418 :knowledge-point/id #uuid "a9aeac73-8ee3-5fef-a47c-a96e3545d89c" :knowledge-point/title "Finding the Linear Approximations Near Equilibria"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86448ffa-4985-5006-92fe-7235fceb5be8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186444474}] :answer-field/correct {:answer/id #uuid "86448ffa-4985-5006-92fe-7235fceb5be8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186444474} :answer-field/id #uuid "194dfd1f-21e6-59b2-9593-2beb7f9e8250" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444507} {:answer-field/choices [{:answer/id #uuid "4aa59ac8-cd8f-54fc-832d-b165c63d5079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186444455}] :answer-field/correct {:answer/id #uuid "4aa59ac8-cd8f-54fc-832d-b165c63d5079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186444455} :answer-field/id #uuid "1cbfa53a-6d93-5264-b814-7e6efcdd6d4b" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444508} {:answer-field/choices [{:answer/id #uuid "ee096123-d43d-5356-8566-8623f265bf9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186444494}] :answer-field/correct {:answer/id #uuid "ee096123-d43d-5356-8566-8623f265bf9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186444494} :answer-field/id #uuid "4a0a7ee5-4574-567f-ae65-cd2e7676f0b8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444514} {:answer-field/choices [{:answer/id #uuid "080e961a-297c-5b7d-9c41-af81d7198804" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186444451}] :answer-field/correct {:answer/id #uuid "080e961a-297c-5b7d-9c41-af81d7198804" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186444451} :answer-field/id #uuid "ed8eb70b-344a-5050-b370-92b4d15051d8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186444531}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4189cf97-4019-5e9f-9f66-1a0dc740de8d" :question/math-academy-id "q-366655" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)={x}^{2}(t)-2x(t)+3y(t)+3 \\\\ {y}^{′}(t)=-4x(t)+2{y}^{2}(t)-y(t)+5\\end{aligned}\n$$\n\nConsider the system of differential equations above. What is the corresponding linearized system at the equilibrium point ${x}^{∗}=[2,\\text{ }-1]^{T}?$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${u}^{′}=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"50px\">{{field-1}}</td>\n<td align=\"center\" width=\"50px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,u,\\,$ where $u=x-{x}^{∗}$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and \n$\\text{\\boldsymbol}f(x)=[\\begin{aligned}{x}^{2}-2x+3y+3 \\\\ -4x+2{y}^{2}-y+5\\end{aligned}].$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}({x}^{2}-2x+3y+3)=2x-2,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}({x}^{2}-2x+3y+3)=3 \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(-4x+2{y}^{2}-y+5)=-4,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(-4x+2{y}^{2}-y+5)=4y-1\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}2x-2 & 3 \\\\ -4 & 4y-1\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}2 \\\\ -1\\end{aligned}]$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=[\\begin{aligned}2(2)-2 & 3 \\\\ -4 & 4(-1)-1\\end{aligned}]=[\\begin{aligned}2 & 3 \\\\ -4 & -5\\end{aligned}].\n$$\n\nFinally, near the equilibrium, the nonlinear system is approximated by\n\n$$\n{u}^{′}=[\\begin{aligned}2 & 3 \\\\ -4 & -5\\end{aligned}]u,\n$$\n\nwhere the deviation vector is\n\n$$\nu=x-{x}^{∗}=[\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}2 \\\\ -1\\end{aligned}]=[\\begin{aligned}x-2 \\\\ y+1\\end{aligned}].\n$$"}]}
