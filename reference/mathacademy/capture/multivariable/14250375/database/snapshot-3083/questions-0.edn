 :knowledge-point/title "Simplifying a Compound Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06d1900f-904c-5ce9-9af9-2a655214c6a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186570135} {:answer/id #uuid "164f0918-fe41-5f2c-ae96-41edfe5a78a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q∧(R∨Q)" :db/id #edb/ref 17592186570168} {:answer/id #uuid "1a958a38-6801-58be-b387-50b13024ce7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R∧Q" :db/id #edb/ref 17592186570176} {:answer/id #uuid "bc198b10-7372-56a8-a226-8b76f4d61f87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q" :db/id #edb/ref 17592186570455} {:answer/id #uuid "fb6b08ff-4d48-556d-b3ab-c1591df39e88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R∨Q" :db/id #edb/ref 17592186570569}] :answer-field/correct {:answer/id #uuid "1a958a38-6801-58be-b387-50b13024ce7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R∧Q" :db/id #edb/ref 17592186570176} :answer-field/id #uuid "8670cfd6-f688-5e0c-ad34-bcc8a9380e86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570637}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7ea98094-8950-5b20-861d-41decac9476c" :question/math-academy-id "q-170789" :question/problem "Simplify the statement $R∧(Q∨(Q∧Q)).$" :question/worked-solution "First, the expression $Q∧Q$ simplifies to just $Q.$ \n\nSo, the given statement can be simplified to \n\n$$\nR∧(Q∨Q).\n$$\n\nThen, the expression $Q∨Q$ simplifies to just $Q.$\n\nSo, the given statement can be simplified to \n\n$$\nR∧Q.\n$$"}] [{:db/id #edb/ref 17592186570764 :knowledge-point/_questions [{:db/id #edb/ref 17592186198251 :knowledge-point/id #uuid "bbe7854c-d438-5ee0-adc8-c32d5d800050" :knowledge-point/title "Simplifying a Compound Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44228842-34e1-5bf5-8d27-9053ac142914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧B" :db/id #edb/ref 17592186570243} {:answer/id #uuid "6cefaf07-2cfa-5151-8157-c81d87efa699" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186570314} {:answer/id #uuid "8e47b951-af3a-5c88-ab72-2fa9b133034f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B" :db/id #edb/ref 17592186570374} {:answer/id #uuid "c6ef83b4-81d3-5ded-af82-d36051b69727" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨B" :db/id #edb/ref 17592186570471} {:answer/id #uuid "db4dfb95-d27c-5dec-80e4-a792d953f65a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B∨(A∧B)" :db/id #edb/ref 17592186570508}] :answer-field/correct {:answer/id #uuid "c6ef83b4-81d3-5ded-af82-d36051b69727" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨B" :db/id #edb/ref 17592186570471} :answer-field/id #uuid "5e77341c-73c0-5944-9e01-8bd2d9af7a60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186570621}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a5dc4674-bf70-593d-b79c-9ae4e2518f41" :question/math-academy-id "q-170790" :question/problem "Simplify the statement $A∨(B∧(B∨B)).$" :question/worked-solution "First, the expression $B∨B$ simplifies to just $B.$\n\nSo, the given statement can be simplified to\n\n$$\nA∨(B∧B).\n$$\n\nThen, the expression $B∧B$ simplifies to just $B.