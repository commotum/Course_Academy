54f1-b9a8-96b0dacf28cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{F}" :db/id #edb/ref 17592186570287} {:answer/id #uuid "bc9e082c-dedd-5bc4-981f-25922067385c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186570458}] :answer-field/correct {:answer/id #uuid "bc9e082c-dedd-5bc4-981f-25922067385c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{T}" :db/id #edb/ref 17592186570458} :answer-field/id #uuid "edb06e43-c06e-5b90-b51e-7cdae61fe54e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186570687}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "571dfb2b-950c-5c10-b8a7-797df910e9cf" :question/math-academy-id "q-212145" :question/problem "Find the missing values in the following truth table:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,(B∧A)∨(B∨A)\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | {{field-1}} |\n| $\\text{T}$ | $\\text{F}$ | {{field-2}} |\n| $\\text{F}$ | $\\text{T}$ | {{field-3}} |\n| $\\text{F}$ | $\\text{F}$ | {{field-4}} |" :question/worked-solution "First, we complete a truth table for the first part in parentheses, $B∧A.$ The statement $B∧A$ is true if both $A$ and $B$ are true.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,B∧A\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n\nNext, we append the truth table for the second part in parentheses, $B∨A.$ The statement $B∨A$ is true if either $A$ is true, $B$ is true, or both $A$ and $B$ are true. \n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,B∧A\\,$ | $\\,B∨A\\,$ |\n| --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n\nFinally, we look at the column $(B∧A)$ and the column $(B∨A)$ to complete the column $(B∧A)∨(B∨A).$ The statement $(B∧A)∨(B∨A)$ is true if either $(B∧A)$ is true, $(B∨A)$ is true, or both $(B∧A)$ and $(B∨A)$ are true.\n\nThe completed truth table is shown below:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,B∧A\\,$ | $\\,B∨A\\,$ | $\\,(B∧A)∨(B∨A)\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |"}]}
