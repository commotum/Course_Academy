#{[{:db/id #edb/ref 17592186198093 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198250 :knowledge-point/id #uuid "f14ab339-1aa8-51a1-ac86-dc780120657c" :knowledge-point/title "Completing a Truth Table for a Compound Statement"}] :question/id #uuid "4063a7d8-0a49-55c7-9e93-3b7ac58c7343" :question/math-academy-id "e-12679" :question/problem "Construct the truth table of the statement $(A \\land B) \\lor (A \\lor B)$." :question/worked-solution "First, we complete a truth table for the first part in parentheses, $A \\land B$. The statement $A \\land B$ is true if both $A$ and $B$ are true.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A \\land B\\,$ |\n| --- | ---: | ---: |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm F$ |\n\nNext, we append the truth table for the second part in parentheses, $A \\lor B$. The statement $A \\lor B$ is true if either $A$ is true, $B$ is true, or both $A$ and $B$ are true.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A \\land B\\,$ | $\\,A \\lor B\\,$ |\n| --- | ---: | ---: | ---: |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ |\n\nFinally, we look at the columns labeled $(A \\land B)$ and $(A \\lor B)$ to complete the column $(A \\land B) \\lor (A \\lor B)$. The statement $(A \\land B) \\lor (A \\lor B)$ is true if either $(A \\land B)$ is true, $(A \\lor B)$ is true, or both $(A \\land B)$ and $(A \\lor B)$ are true.\n\nThe completed truth table is shown below:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A \\land B\\,$ | $\\, A \\lor B\\,$ | $\\,(A \\land B) \\lor (A \\lor B) \\,$ |\n| --- | ---: | ---: | ---: | ---: |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |"}] [{:db/id #edb/ref 17592186198094 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198251 :knowledge-point/id #uuid "bbe7854c-d438-5ee0-adc8-c32d5d800050" :knowledge-point/title "Simplifying a Compound Statement"}] :question/id #uuid "e46add42-b23d-59cc-a611-a2f1b282d3bb" :question/math-academy-id "e-12701" :question/problem "Simplify the statement $P \\land (Q \\lor Q)$." :question/worked-solution "The expression $Q \\lor Q$ simplifies to just $Q$.\n\nSo, the given statement can be simplified to\n$P \\land Q$."}] [{:db/id #edb/ref 17592186198095 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186198249 :knowledge-point/id #uuid "21fd31e7-1eed-5dad-aff2-691ba1737b92" :knowledge-point/title "Completing a Truth Table"}] :question/id #uuid "e94e320d-c2d0-5ab4-b1e5-4e1e2c667bd5" :question/math-academy-id "e-12703" :question/problem "What are the missing entries in the following truth table?\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A \\land B\\,$ |\n| --- | ---: | ---: |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\phantom{F}}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\phantom{F}}$ |" :question/worked-solution "The statement $A \\land B$ is true if both $A$ and $B$ are true.\n\nThe complete truth table is shown below:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A \\land B\\,$ |\n| --- | ---: | ---: |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm T$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |"}] [{:db/id #edb/ref 17592186198694 :knowledge-point/_questions [{:db/id #edb/ref 17592186198251 :knowledge-point/id #uuid "bbe7854c-d438-5ee0-adc8-c32d5d800050" :knowledge-point/title "Simplifying a Compound Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85be3c9f-316f-5989-82e3-39002f26f90e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(A∨B)∧A" :db/id #edb/ref 17592186194791} {:answer/id #uuid "8d64b4d3-e951-5653-a7ad-1f61ba533a31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨B" :db/id #edb/ref 17592186194792} {:answer/id #uuid "9d1662b5-95d3-5c51-9529-44d735d1cb80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧B" :db/id #edb/ref 17592186194793} {:answer/id #uuid "a719aa99-4988-5d83-a658-84618f9cfb38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∧(B∨A)" :db/id #edb/ref 17592186194794} {:answer/id #uuid "4d55324c-e579-5d9b-a051-0dfae7266f74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A∨(A∧B)" :db/id #edb/ref 17592186194795}] :answer-field/id #uuid "76732e23-11c1-51b3-915b-9694d6fb35fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186194790}] :question/id #uuid "3b0fb093-40e7-5550-8cde-76d8edbb661f" :question/math-academy-id "q-170777" :question/problem "Simplify the statement $(A∧A)∨(B∨B)$."}] [{:db/id #edb/ref 17592186198829 :knowledge-point/_questions [{:db/id #edb/ref 17592186198249 :knowledge-point/id #uuid "21fd31e7-1eed-5dad-aff2-691ba1737b92" :knowledge-point/title "Completing a Truth Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c676196c-9f0c-53da-903c-b1f0d7d68932" :answer/type {:db