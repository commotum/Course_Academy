#{[{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186516944} :activity/id #uuid "3fdc85fd-9417-5f27-878a-26fa67cced22" :activity/scope {:db/id #edb/ref 17592186050540 :topic/id #uuid "521360f4-4398-5d66-ae61-73dcd0f74f49" :topic/math-academy-id 51} :activity/steps [{:db/id #edb/ref 17592186516878 :step/content {:db/id #edb/ref 17592186516764 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bff3a4f-a797-5315-a093-a0e43bf9c1e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186516204} {:answer/id #uuid "4807edcf-c198-541c-af49-03cb7d0192f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186516257} {:answer/id #uuid "603ac4dc-cd6a-524a-b62e-bb84d69c82a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "128" :db/id #edb/ref 17592186516321} {:answer/id #uuid "e691460b-9158-5c1a-aaac-006dfe7e1086" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186516591} {:answer/id #uuid "fb07557b-9f6f-5930-9255-eb2d7fc0c0f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186516637}] :answer-field/correct {:db/id #edb/ref 17592186516637} :answer-field/id #uuid "a26ebfcb-41a7-5e48-bdd5-7e3c756aa992" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516728}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0186524d-998b-54c6-a0f5-fa7d2edb8c89" :question/math-academy-id "q-105146" :question/problem "If $A=\\{1,8,\\{8,9\\},5,4,\\{2,7\\}\\}$, then $|P(A)|=$" :question/worked-solution "For any set $A,$ we have $|P(A)|={2}^{|A|}.$ \n\nIn this case, $|A|=6,$ so we have\n\n$$\n|P(A)|={2}^{|A|}={2}^{6}=64.\n$$\n\nRemember that $\\{8,9\\}$ is a single element in the set $A,$ and the same is true for $\\{2,7\\}.$"} :step/id #uuid "0f236f0b-57a6-5471-a446-6ce42cac2342" :step/next {:db/id #edb/ref 17592186516945}} {:db/id #edb/ref 17592186516902 :step/content {:db/id #edb/ref 17592186383680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33df4f48-f059-5aac-b8f0-f099e31a2bd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186383682} {:answer/id #uuid "f3dd68b1-f65d-5184-bbb4-c555eedfe6d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186383683} {:answer/id #uuid "aa6f8df5-cbdf-56ae-80f0-dad4e1c2aaef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186383684} {:answer/id #uuid "d7be702c-cb58-5a32-b0c0-22dff292aa5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186383685} {:answer/id #uuid "b6f161af-bd82-5618-b052-e3a775b0c121" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "256" :db/id #edb/ref 17592186383686}] :answer-field/correct {:db/id #edb/ref 17592186383684} :answer-field/id #uuid "9a504af7-d661-5466-ae33-ffb2c3dbb73f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186383681}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "081807a1-5337-5569-850c-b1949ae55f84" :question/math-academy-id "q-182221" :question/problem "If $A=\\{0\\}$ and $B=\\{5,6\\}$ then $|P(P(A))\\times B|=$" :question/worked-solution "For any set $S,$ we have $|P(S)|={2}^{|S|}.$ Also, $|S\\times T|=|S|\\cdot |T|.$\n\nIn our case, \n\n$$\n|A|=1,\\,|B|=2.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}|P(A)| & ={2}^{|A|}={2}^{1}=2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}|P(P(A))| & ={2}^{|P(A)|} \\\\  & ={2}^{2} \\\\  & =4.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}|P(P(A))\\times B| & =|P(P(A))|\\cdot |B| \\\\  & =4\\cdot 2 \\\\  & =8.\\end{aligned}\n$$"} :step/id #uuid "50dc482e-fe48-5c6f-985b-70ceb6762c4e" :step/next {:db/id #edb/ref 17592186516980}} {:db/id #edb/ref 17592186516944 :step/content {:db/id #edb/ref 17592186373257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6aaf71b-4960-5961-afa1-c9c1ddf33ed8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "128" :db/id #edb/ref 17592186373259} {:answer/id #uuid "ba508c22-2dcf-59c2-9539-fe7661c099d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186373260} {:answer/id #uuid "74e7ce6a-8798-5ed4-9de9-efd5aa83a65d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "129" :db/id #edb/ref 17592186373261} {:answer/id #uuid "1f14efe5-5f0a-5fee-9ee2-7e85505b55ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14" :db/id #edb/ref 17592186373262} {:answer/id #uuid "08770093-a28f-5166-ad8f-c1cf99c46184" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "49" :db/id #edb/ref 17592186373263}] :answer-field/correct {:db/id #edb/ref 17592186373261} :answer-field/id #uuid "58649371-77c2-5771-ab5a-7b1cc10ddd57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186373258}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8b98b713-be0c-56a7-9337-a9c7958ec47d" :question/math-academy-id "q-80971" :question/problem "Suppose that $X$ and $Y$ are sets. If $|X|=0$ and $|Y|=7,$ then $|P(X)|+|P(Y)|=$" :question/worked-solution "For any set $S$, $|P(S)|={2}^{|S|}.$ \n\nIn this case, $|X|=0$ and $|Y|=7,$ so we have \n\n$$\n\\begin{aligned}|P(X)|+|P(Y)| & ={2}^{|X|}+{2}^{|Y|} \\\\  & ={2}^{0}+{2}^{7} \\\\  & =1+128 \\\\  & =129.\\end{aligned}\n$$"} :step/id #uuid "a4c2be1d-d683-59b4-aa78-adac0b909f27" :step/next {:db/id #edb/ref 17592186516878}} {:db/id #edb/ref 17592186516945 :step/content {:db/id #edb/ref 17592186379127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33b6c47e-8246-50f3-9325-54dd77f76d33" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16" :db/id #edb/ref 17592186379129} {:answer/id #uuid "904f598d-3ed1-5d74-84dc-36bb3ad3d517" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186379130} {:answer/id #uuid "fa0824ad-dbf5-54af-90b1-3f90cb1373f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186379131} {:answer/id #uuid "4632f7af-3aba-5c19-854c-e70ab7d1d1d3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186379132} {:answer/id #uuid "eeb171f1-886c-5af0-989c-9c887889a747" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "256" :db/id #edb/ref 17592186379133}] :answer-field/correct {:db/id #edb/ref 17592186379129} :answer-field/id #uuid "9eed9f6b-2f01-5f80-ae09-36f055b25ac6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186379128}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "11747dae-0095-5e9a-a1d3-7c1819d5b4da" :question/math-academy-id "q-182217" :question/problem "If $|Z|=1$ then $|P(P(P(Z)))|=$" :question/worked-solution "For any set $S$, we have $|P(S)|={2}^{|S|}.$ \n\nIn our case, we have $|Z|=1.$ Therefore, we obtain\n\n$$\n|P(Z)|={2}^{1}=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}|P(P(Z))| & ={2}^{|P(Z)|} \\\\  & ={2}^{2} \\\\  & =4.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}|P(P(P(Z)))| & ={2}^{|P(P(Z))|} \\\\  & ={2}^{4} \\\\  & =16.\\end{aligned}\n$$"} :step/id #uuid "a5910cbe-18d6-5500-b155-fa1070c1e5b1" :step/next {:db/id #edb/ref 17592186516902}} {:db/id #edb/ref 17592186516980 :step/content {:db/id #edb/ref 17592186379134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4d607d8-d309-5ca9-83bc-740b4c36bade" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186471191} {:answer/id #uuid "325fb8bb-d47f-5880-a8b1-b79555ac108d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186471192}] :answer-field/correct {:db/id #edb/ref 17592186471192} :answer-field/id #uuid "42d12dc6-b94a-52d8-8494-2498d1c73f28" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186472101} {:answer-field/choices [{:answer/id #uuid "53559d5d-159d-5fdc-bd9d-4e94bdf5ac8b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186471193} {:answer/id #uuid "d6e30a64-f23f-5094-890c-8e7f4d8a8222" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186471194}] :answer-field/correct {:db/id #edb/ref 17592186471193} :answer-field/id #uuid "b856be72-7e15-5ad6-945e-6975defb3028" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186472102} {:answer-field/choices [{:answer/id #uuid "4b52a727-ad5e-5373-9c5a-a0274dde1602" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186471195} {:answer/id #uuid "bc8607f7-f14a-5008-becc-2bb0c03d4f5c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186471196}] :answer-field/correct {:db/id #edb/ref 17592186471196} :answer-field/id #uuid "5def3004-16f9-5b6c-af86-0253fe70b521" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186472103}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c162f27f-023e-512b-91b9-54632834b487" :question/math-academy-id "q-182238" :question/problem "Which of the following sets are finite?\n- **I.** $P({R,e})$\n- **II.** $P({x\\in R∣\\operatorname{cos}⁡x=0})$\n- **III.** $P({(-1)^{n}∣n\\in Z})$\n\nSelect all that apply." :question/worked-solution "The power set of a finite set is finite, while the power set of an infinite set is infinite.\n\nWith that in mind, let's examine our sets.\n\n- Set I is finite since the underlying set is finite. Notice that \n\n$$\nP({R,e})={∅,\\,{R},\\,{e},\\,{R,e}}\n$$\n\nhas cardinality $4.$\n\n- Set II is infinite since the underlying set ${x\\in R∣\\operatorname{cos}⁡x=0}$  is infinite.\n\n- Set III is finite since the underlying set is finite. Notice that \n\n$$\n{(-1)^{n}∣n\\in Z}={-1,1},\n$$\n\nand, as a result, \n\n$$\nP({(-1)^{n}∣n\\in Z})=P({-1,1})={∅,\\,{-1},\\,{1},\\,{-1,1}}\n$$\n\nhas cardinality $4.$\n\nTherefore, the correct answer is \"I and III only.\""} :step/id #uuid "ebc42d35-f4dd-5905-852b-c5cb495a2b71"}] :activity/title "Power Sets" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516093}]}
