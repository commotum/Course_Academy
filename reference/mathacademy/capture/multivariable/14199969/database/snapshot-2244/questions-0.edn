#{[{:db/id #edb/ref 17592186379127 :knowledge-point/_questions [{:db/id #edb/ref 17592186054639 :knowledge-point/id #uuid "d7ec1dc0-4e21-5001-959e-ed35039ca00e" :knowledge-point/title "Determining Cardinality in More Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33b6c47e-8246-50f3-9325-54dd77f76d33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186379129} {:answer/id #uuid "904f598d-3ed1-5d74-84dc-36bb3ad3d517" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186379130} {:answer/id #uuid "fa0824ad-dbf5-54af-90b1-3f90cb1373f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186379131} {:answer/id #uuid "4632f7af-3aba-5c19-854c-e70ab7d1d1d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186379132} {:answer/id #uuid "eeb171f1-886c-5af0-989c-9c887889a747" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "256" :db/id #edb/ref 17592186379133}] :answer-field/correct {:answer/id #uuid "33b6c47e-8246-50f3-9325-54dd77f76d33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186379129} :answer-field/id #uuid "9eed9f6b-2f01-5f80-ae09-36f055b25ac6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379128}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11747dae-0095-5e9a-a1d3-7c1819d5b4da" :question/math-academy-id "q-182217" :question/problem "If $|Z|=1$ then $|P(P(P(Z)))|=$" :question/worked-solution "For any set $S$, we have $|P(S)|={2}^{|S|}.$ \n\nIn our case, we have $|Z|=1.$ Therefore, we obtain\n\n$$\n|P(Z)|={2}^{1}=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}|P(P(Z))| & ={2}^{|P(Z)|} \\\\  & ={2}^{2} \\\\  & =4.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}|P(P(P(Z)))| & ={2}^{|P(P(Z))|} \\\\  & ={2}^{4} \\\\  & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383680 :knowledge-point/_questions [{:db/id #edb/ref 17592186054639 :knowledge-point/id #uuid "d7ec1dc0-4e21-5001-959e-ed35039ca00e" :knowledge-point/title "Determining Cardinality in More Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33df4f48-f059-5aac-b8f0-f099e31a2bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186383682} {:answer/id #uuid "f3dd68b1-f65d-5184-bbb4-c555eedfe6d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186383683} {:answer/id #uuid "aa6f8df5-cbdf-56ae-80f0-dad4e1c2aaef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186383684} {:answer/id #uuid "d7be702c-cb58-5a32-b0c0-22dff292aa5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186383685} {:answer/id #uuid "b6f161af-bd82-5618-b052-e3a775b0c121" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "256" :db/id #edb/ref 17592186383686}] :answer-field/correct {:answer/id #uuid "aa6f8df5-cbdf-56ae-80f0-dad4e1c2aaef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186383684} :answer-field/id #uuid "9a504af7-d661-5466-ae33-ffb2c3dbb73f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383681}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "081807a1-5337-5569-850c-b1949ae55f84" :question/math-academy-id "q-182221" :question/problem "If $A={0}$ and $B={5,6}$ then $|P(P(A))\\times B|=$" :question/worked-solution "For any set $S,$ we have $|P(S)|={2}^{|S|}.$ Also, $|S\\times T|=|S|\\cdot |T|.$\n\nIn our case, \n\n$$\n|A|=1,\\,|B|=2.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}|P(A)| & ={2}^{|A|}={2}^{1}=2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}|P(P(A))| & ={2}^{|P(A)|} \\\\  & ={2}^{2} \\\\  & =4.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}|P(P(A))\\times B| & =|P(P(A))|\\cdot |B| \\\\  & =4\\cdot 2 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379134 :knowledge-point/_questions [{:db/id #edb/ref 17592186054640 :knowledge-point/id #uuid "d4954fe5-f1fe-590a-9540-280a14606a49" :knowledge-point/title "Identifying True Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4d607d8-d309-5ca9-83bc-740b4c36bade" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471191} {:answer/id #uuid "325fb8bb-d47f-5880-a8b1-b79555ac108d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471192}] :answer-field/correct {:answer/id #uuid "325fb8bb-d47f-5880-a8b1-b79555ac108d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471192} :answer-field/id #uuid "42d12dc6-b94a-52d8-8494-2498d1c73f28" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472101} {:answer-field/choices [{:answer/id #uuid "53559d5d-159d-5fdc-bd9d-4e94bdf5ac8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471193} {:answer/id #uuid "d6e30a64-f23f-5094-890c-8e7f4d8a8222" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471194}] :answer-field/correct {:answer/id #uuid "53559d5d-159d-5fdc-bd9d-4e94bdf5ac8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471193} :answer-field/id #uuid "b856be72-7e15-5ad6-945e-6975defb3028" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472102} {:answer-field/choices [{:answer/id #uuid "4b52a727-ad5e-5373-9c5a-a0274dde1602" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471195} {:answer/id #uuid "bc8607f7-f14a-5008-becc-2bb0c03d4f5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471196}] :answer-field/correct {:answer/id #uuid "bc8607f7-f14a-5008-becc-2bb0c03d4f5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471196} :answer-field/id #uuid "5def3004-16f9-5b6c-af86-0253fe70b521" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472103}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c162f27f-023e-512b-91b9-54632834b487" :question/math-academy-id "q-182238" :question/problem "Which of the following sets are finite?\n- **I.** $P({R,e})$\n- **II.** $P({x\\in R∣\\operatorname{cos}⁡x=0})$\n- **III.** $P({(-1)^{n}∣n\\in Z})$\n\nSelect all that apply." :question/worked-solution "The power set of a finite set is finite, while the power set of an infinite set is infinite.\n\nWith that in mind, let's examine our sets.\n\n- Set I is finite since the underlying set is finite. Notice that \n\n$$\nP({R,e})={∅,\\,{R},\\,{e},\\,{R,e}}\n$$\n\nhas cardinality $4.$\n\n- Set II is infinite since the underlying set ${x\\in R∣\\operatorname{cos}⁡x=0}$  is infinite.\n\n- Set III is finite since the underlying set is finite. Notice that \n\n$$\n{(-1)^{n}∣n\\in Z}={-1,1},\n$$\n\nand, as a result, \n\n$$\nP({(-1)^{n}∣n\\in Z})=P({-1,1})={∅,\\,{-1},\\,{1},\\,{-1,1}}\n$$\n\nhas cardinality $4.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186373257 :knowledge-point/_questions [{:db/id #edb/ref 17592186054638 :knowledge-point/id #uuid "0e22a7b0-753b-51b1-8946-5d17456aa778" :knowledge-point/title "Computing the Cardinality of a Power Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6aaf71b-4960-5961-afa1-c9c1ddf33ed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128" :db/id #edb/ref 17592186373259} {:answer/id #uuid "ba508c22-2dcf-59c2-9539-fe7661c099d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186373260} {:answer/id #uuid "74e7ce6a-8798-5ed4-9de9-efd5aa83a65d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "129" :db/id #edb/ref 17592186373261} {:answer/id #uuid "1f14efe5-5f0a-5fee-9ee2-7e85505b55ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186373262} {:answer/id #uuid "08770093-a28f-5166-ad8f-c1cf99c46184" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186373263}] :answer-field/correct {:answer/id #uuid "74e7ce6a-8798-5ed4-9de9-efd5aa83a65d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "129" :db/id #edb/ref 17592186373261} :answer-field/id #uuid "58649371-77c2-5771-ab5a-7b1cc10ddd57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373258}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b98b713-be0c-56a7-9337-a9c7958ec47d" :question/math-academy-id "q-80971" :question/problem "Suppose that $X$ and $Y$ are sets. If $|X|=0$ and $|Y|=7,$ then $|P(X)|+|P(Y)|=$" :question/worked-solution "For any set $S$, $|P(S)|={2}^{|S|}.$ \n\nIn this case, $|X|=0$ and $|Y|=7,$ so we have \n\n$$\n\\begin{aligned}|P(X)|+|P(Y)| & ={2}^{|X|}+{2}^{|Y|} \\\\  & ={2}^{0}+{2}^{7} \\\\  & =1+128 \\\\  & =129.\\end{aligned}\n$$"}]}
