{aligned}2 & 1 \\\\ -1 & 2\\end{aligned}]\\cdot [\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & -2 \\\\ 2 & 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{150}[\\begin{aligned}4 & 3 \\\\ -2 & 6\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & -2 \\\\ 2 & 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{150}[\\begin{aligned}10 & 0 & -5 \\\\ 10 & 0 & 10\\end{aligned}] \\\\  & =\\frac{1}{30}[\\begin{aligned}2 & 0 & -1 \\\\ 2 & 0 & 2\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186388567 #edb/ref 1075 #edb/ref 17592186388568 #edb/ref 17592186045417] [17592186388567 #edb/ref 1075 #edb/ref 17592186388569 #edb/ref 17592186045417] [17592186388567 #edb/ref 1075 #edb/ref 17592186388570 #edb/ref 17592186045417] [17592186388567 #edb/ref 1075 #edb/ref 17592186388571 #edb/ref 17592186045417] [17592186388567 #edb/ref 1075 #edb/ref 17592186388572 #edb/ref 17592186045417] [17592186388567 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186388567 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186388567 #edb/ref 1078 #edb/ref 17592186388572 #edb/ref 17592186045417] [17592186388567 #edb/ref 1079 #uuid "519e599e-557f-5219-8bbb-718b79623ca0" #edb/ref 17592186045417] [17592186388568 #edb/ref 1080 "\\frac{1}{5}[\\begin{aligned}2 & 0 & 1 \\\\ 2 & 0 & 2\\end{aligned}]" #edb/ref 17592186045417] [17592186388568 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186388568 #edb/ref 1083 #uuid "e4372203-9216-542b-970e-8cec151b32b3" #edb/ref 17592186045417] [17592186388569 #edb/ref 1080 "\\frac{1}{50}[\\begin{aligned}2 & 0 & 2 \\\\ 3 & 0 & 3\\end{aligned}]" #edb/ref 17592186045417] [17592186388569 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186388569 #edb/ref 1083 #uuid "25f946f1-f189-517c-8d4f-b7f6d74888cd" #edb/ref 17592186045417] [17592186388570 #edb/ref 1080 "\\frac{1}{15}[\\begin{aligned}1 & 0 & -1 \\\\ 2 & 0 & 2\\end{aligned}]" #edb/ref 17592186045417] [17592186388570 #edb/ref 1082 #edb