#{[{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186516909} :activity/id #uuid "a05a4f34-cba1-54e4-b6a6-f7ada8846659" :activity/scope {:db/id #edb/ref 17592186050148 :topic/id #uuid "30d88a85-9b00-5b6d-90cc-41ac3f6c9da8" :topic/math-academy-id 1808} :activity/steps [{:db/id #edb/ref 17592186516900 :step/content {:db/id #edb/ref 17592186516801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140b7152-7be6-5b10-b162-4dcea3796757" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(23,5,6)" :db/id #edb/ref 17592186516151} {:answer/id #uuid "7062112e-23e0-5023-abc6-42331af0e0bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,50,6)" :db/id #edb/ref 17592186516364} {:answer/id #uuid "739dc482-cca6-5907-b91b-15164a66f7c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(32,50,16)" :db/id #edb/ref 17592186516369} {:answer/id #uuid "cde85d08-f475-531a-bd01-73f6eb9051bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(12,25,36)" :db/id #edb/ref 17592186516547} {:answer/id #uuid "d54b4cb0-06e8-5602-a1ad-89fba9fb6215" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186516561}] :answer-field/correct {:db/id #edb/ref 17592186516369} :answer-field/id #uuid "616c22d5-e3ac-50e3-88f8-ae593e1ea4d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516692}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4c18b1c7-8bdd-5391-9b67-8443fd23166f" :question/math-academy-id "q-73998" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\{\\begin{aligned}x=8+3t \\\\ y=-6+7t \\\\ z=2t\\end{aligned}\\,\\text{and}\\,Π:2x+5y-8z=186.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}2x+5y-8z & =186 \\\\ 2(8+3t)+5(-6+7t)-8(2t) & =186 \\\\ 16+6t-30+35t-16t & =186 \\\\ 25t & =200 \\\\ t & =8\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=8$ into the parametric equations of the line:\n\n$$\n\\{\\begin{aligned}x=8+3(8)=32 \\\\ y=-6+7(8)=50 \\\\ z=2(8)=16\\end{aligned}\n$$\n\nSo, the intersection point is $P(32,50,16).$"} :step/id #uuid "46aaa850-40f1-5820-9c52-4b357fdbea2f" :step/next {:db/id #edb/ref 17592186516919}} {:db/id #edb/ref 17592186516909 :step/content {:db/id #edb/ref 17592186120239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d74ada3-9243-5f7c-ade2-62caa4b9c021" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,1,-4)" :db/id #edb/ref 17592186402088} {:answer/id #uuid "2ddeb712-2499-5385-8cf5-8d5841c638be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,-4,7)" :db/id #edb/ref 17592186402089} {:answer/id #uuid "c3a42789-8ed3-50da-bd89-5ed82656d5bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-8,1,1)" :db/id #edb/ref 17592186402090} {:answer/id #uuid "4f5b4306-4e52-5f8f-a6c5-d9a8c474f65b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186402091} {:answer/id #uuid "b73612ac-9159-5b03-82b8-04dc3dbeb325" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,-4,1)" :db/id #edb/ref 17592186402092}] :answer-field/correct {:db/id #edb/ref 17592186402092} :answer-field/id #uuid "1ba93ced-d091-5536-afc3-ce47413fdf3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402087}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49e4fa98-401d-5c2d-a49c-1997a8550033" :question/math-academy-id "q-33203" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨-5,0,1⟩+t⟨-3,1,0⟩,\\,Π:-3x+y-2z+27=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨-5-3t,t,1⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}-3x+y-2z+27 & =0 \\\\ -3x+y-2z & =-27 \\\\ ⟨x,y,z⟩\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ r\\cdot ⟨-3,1,-2⟩ & =-27\\end{aligned}\n$$\n\nNow, substituting $r=⟨-5-3t,t,1⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ ⟨-5-3t,t,1⟩\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ -3(-5-3t)+1\\cdot t-2\\cdot 1 & =-27 \\\\ 15+9t+t-2 & =-27 \\\\ 10t & =-40 \\\\ t & =-4.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=-4$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-5-3(-4),-4,1⟩ \\\\  & =⟨7,-4,1⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(7,-4,1).$"} :step/id #uuid "5afd2fb8-f672-52e7-a18b-c486687e5ed6" :step/next {:db/id #edb/ref 17592186516948}} {:db/id #edb/ref 17592186516916 :step/content {:db/id #edb/ref 17592186515570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4e4e53-6530-5d9b-ac71-88fa4a852643" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,5,12)" :db/id #edb/ref 17592186514894} {:answer/id #uuid "13d7977a-6ece-5a3d-a4d3-a046ae5ee70a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,3,8)" :db/id #edb/ref 17592186514914} {:answer/id #uuid "3e792c4b-0f89-58e4-ad54-bf65b7f20967" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186515006} {:answer/id #uuid "97dcbf66-8c48-507d-96c6-a848577b2e92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-5,-3,-4)" :db/id #edb/ref 17592186515192} {:answer/id #uuid "a9993b57-a418-5d19-be94-6b1c3a3b00c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8,5,8)" :db/id #edb/ref 17592186515229}] :answer-field/correct {:db/id #edb/ref 17592186514914} :answer-field/id #uuid "c8d9ffbc-23ef-519d-9512-884d3bb1903d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515494}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "83aacc67-1785-59c3-94ae-6f65bea01fe4" :question/math-academy-id "q-108881" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\frac{x+2}{3}=\\frac{y+1}{2}=\\frac{z}{4},\\,Π:r\\cdot ⟨3,-1,2⟩=25.\n$$" :question/worked-solution "From the equation of the line $l$, we know that it passes through the point $A(-2,-1,0)$ and it is parallel to the vector $v=⟨3,2,4⟩.$ Therefore, its vector equation is given by\n\n$$\n\\begin{aligned}r & =⟨-2,-1,0⟩+t⟨3,2,4⟩ \\\\  & =⟨-2+3t,-1+2t,4t⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nNow, substituting $r=⟨-2+3t,-1+2t,4t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨3,-1,2⟩ & =25 \\\\ ⟨-2+3t,-1+2t,4t⟩\\cdot ⟨3,-1,2⟩ & =25 \\\\ 3(-2+3t)-(-1+2t)+2(4t) & =25 \\\\ -6+9t+1-2t+8t & =25 \\\\ 15t & =30 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-2+3(2),-1+2(2),4(2)⟩ \\\\  & =⟨4,3,8⟩.\\end{aligned}\n$$\n\nSo, we get $P(4,3,8).$"} :step/id #uuid "6b2e7866-b57f-55d0-8fca-843a70bc51a0"} {:db/id #edb/ref 17592186516919 :step/content {:db/id #edb/ref 17592186516797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58a61e2d-79ec-5942-a542-a599506c947f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,8,4)" :db/id #edb/ref 17592186516299} {:answer/id #uuid "5933b3cc-3b81-55f6-a9e9-d8ce70b49ee7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6,-4,1)" :db/id #edb/ref 17592186516303} {:answer/id #uuid "8c3399b1-2e8d-5048-9705-3b903a795275" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186516404} {:answer/id #uuid "be96b637-0ffd-5d98-b663-5c2fe316eeca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6,-4,-16)" :db/id #edb/ref 17592186516515} {:answer/id #uuid "f5f1cb12-78bd-54f6-9673-719b825438c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,5,-1)" :db/id #edb/ref 17592186516624}] :answer-field/correct {:db/id #edb/ref 17592186516299} :answer-field/id #uuid "96cd3fdc-919f-5a7e-9267-58831d9b0de1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516725}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "47b66d2c-d386-5a47-ab3a-e7307c9bb3f9" :question/math-academy-id "q-108335" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\{\\begin{aligned}x=4-t \\\\ y=2+3t \\\\ z=-6+5t\\end{aligned}\\,\\text{and}\\,Π:6x-4y+z+16=0.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}6x-4y+z+16 & =0 \\\\ 6(4-t)-4(2+3t)+(-6+5t) & =-16 \\\\ 24-6t-8-12t-6+5t & =-16 \\\\ -13t & =-26 \\\\ t & =2\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=2$ into the parametric equations of the line:\n\n$$\n\\{\\begin{aligned}x=4-2=2 \\\\ y=2+3(2)=8 \\\\ z=-6+5(2)=4\\end{aligned}\n$$\n\nSo, the intersection point is  $P(2,8,4).$"} :step/id #uuid "736e1f94-c79a-5f94-aec8-100a0d8ad1be" :step/next {:db/id #edb/ref 17592186516916}} {:db/id #edb/ref 17592186516948 :step/content {:db/id #edb/ref 17592186402093 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb5e385e-d48b-552d-92db-b2c42b730f55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,8,14)" :db/id #edb/ref 17592186402095} {:answer/id #uuid "2cec0929-bdd8-5d7b-8ece-52cdde4c6f93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,-2,6)" :db/id #edb/ref 17592186402096} {:answer/id #uuid "c23c18d5-4a2a-5884-8422-592e07e7f5b2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186402097} {:answer/id #uuid "50770341-c200-5dd2-a57c-f88a32fa60ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,4,8)" :db/id #edb/ref 17592186402098} {:answer/id #uuid "b695496a-1b9b-5846-a379-f0e3c0d96851" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(14,8,3)" :db/id #edb/ref 17592186402099}] :answer-field/correct {:db/id #edb/ref 17592186402095} :answer-field/id #uuid "0878a66a-d92b-5043-a146-6c379d55810e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402094}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eaab1f60-24fb-5572-8cfb-474f418bf09f" :question/math-academy-id "q-33205" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨-1,-2,6⟩+t⟨2,5,4⟩,\\,Π:x+2y+z-33=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨-1+2t,-2+5t,6+4t⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}x+2y+z-33 & =0 \\\\ x+2y+z & =33 \\\\ ⟨x,y,z⟩\\cdot ⟨1,2,1⟩ & =33 \\\\ r\\cdot ⟨1,2,1⟩ & =33\\end{aligned}\n$$\n\nNow, substituting $r=⟨-1+2t,-2+5t,6+4t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨1,2,1⟩ & =33 \\\\ ⟨-1+2t,-2+5t,6+4t⟩\\cdot ⟨1,2,1⟩ & =33 \\\\ -1+2t+2(-2+5t)+6+4t & =33 \\\\ -1+2t-4+10t+6+4t & =33 \\\\ 16t & =32 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-1+2(2),-2+5(2),6+4(2)⟩ \\\\  & =⟨3,8,14⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(3,8,14).$"} :step/id #uuid "ae6d11cd-9598-5c2f-b52d-5379a477c70b" :step/next {:db/id #edb/ref 17592186516900}}] :activity/title "The Intersection Between a Line and a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516105}]}
