#{[{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186120720} :activity/id #uuid "87481402-fa01-553f-b61a-d34f3d67f347" :activity/scope {:db/id #edb/ref 17592186050148 :topic/id #uuid "30d88a85-9b00-5b6d-90cc-41ac3f6c9da8" :topic/math-academy-id 1808} :activity/steps [{:db/id #edb/ref 17592186120720 :step/content {:db/id #edb/ref 17592186121053 :tutorial/content "Consider the following equations of a line $l$ and a plane $\\Pi\\mathbin{:}$\n\n$$\nl: \\mathbf{r} = \\langle 2,2,1 \\rangle + t \\langle 3,0,1 \\rangle, \\qquad \\Pi:\\mathbf{r} \\cdot \\langle 3,-5,1 \\rangle = 7.\n$$\n\nHow can we find the intersection point $P$ of $l$ and $\\Pi?$\n\nWe start by writing the equation of the line in the form $\\mathbf{r} = \\langle 2+3t , 2, 1+t \\rangle.$ Now, since $P$ must lie on the line $l,$ we can write its coordinates as $P(2+3t , 2, 1+t)$ for some particular value of $t \\in (-\\infty,\\infty).$\n\n![](images/d3/d3ba164eb98a53c463744e11d6593177ddde2a0a309f752e5d86b30db0d79925.png)\n\nOn the other hand, $P$ also lies on the plane $\\Pi.$ So, the coordinates $P(2+3t , 2, 1+t)$ must satisfy the equation of the plane as well. Substituting the position vector $\\mathbf{r} = \\langle 2+3t , 2, 1+t \\rangle$ into the equation of the plane and solving for $t,$ we get\n\n$$\n\\begin{aligned}r\\cdot ⟨3,-5,1⟩ & =7 \\\\ ⟨2+3t,2,1+t⟩\\cdot ⟨3,-5,1⟩ & =7 \\\\ 3(2+3t)-5\\cdot 2+(1+t) & =7 \\\\ 6+9t-10+1+t & =7 \\\\ 10t & =10 \\\\ t & =1.\\end{aligned}\n$$\n\nTo get the position vector $\\mathbf{p}$ of the intersection point $P,$ we substitute $t=1$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨2+3(1),2,1+(1)⟩ \\\\  & =⟨5,2,2⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(5, 2, 2).$" :tutorial/id #uuid "b2ca8cb0-0b92-5b99-ac8b-edd2f2a6dbb1" :tutorial/math-academy-id 3259 :tutorial/title "Introduction"} :step/id #uuid "a814365d-ddd3-5356-ac6d-30d046db60e2" :step/math-academy-id 17931 :step/next {:db/id #edb/ref 17592186120721}} {:db/id #edb/ref 17592186120721 :step/content {:db/id #edb/ref 17592186119836 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119650 :question/id #uuid "1d809050-9477-5de6-8c95-7294804e7b69" :question/math-academy-id "e-4943"} :knowledge-point/id #uuid "abef3da6-252e-51e4-b816-9ef7233b9a5d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048954} {:db/id #edb/ref 17592186049869}] :knowledge-point/questions [{:db/id #edb/ref 17592186120226} {:db/id #edb/ref 17592186120238} {:db/id #edb/ref 17592186244119} {:db/id #edb/ref 17592186244120} {:db/id #edb/ref 17592186314881} {:db/id #edb/ref 17592186342124} {:db/id #edb/ref 17592186342125} {:db/id #edb/ref 17592186399608} {:db/id #edb/ref 17592186399615} {:db/id #edb/ref 17592186403738} {:db/id #edb/ref 17592186442983} {:db/id #edb/ref 17592186442984} {:db/id #edb/ref 17592186475938} {:db/id #edb/ref 17592186475947}] :knowledge-point/title "Finding the Intersection Point of a Line in Vector Form and a Plane in Dot Product Form"} :step/id #uuid "ddf088ee-3776-5bfe-8145-83247b42b9d0" :step/math-academy-id 17932 :step/next {:db/id #edb/ref 17592186120723}} {:db/id #edb/ref 17592186120722 :step/content {:db/id #edb/ref 17592186119837 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119651 :question/id #uuid "c1576b30-9142-5884-b654-7ade7a765ec7" :question/math-academy-id "e-4944"} :knowledge-point/id #uuid "caf29808-4551-56a0-ac86-a4587a06fc0f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048729}] :knowledge-point/questions [{:db/id #edb/ref 17592186120229} {:db/id #edb/ref 17592186120239} {:db/id #edb/ref 17592186244184} {:db/id #edb/ref 17592186304962} {:db/id #edb/ref 17592186304967} {:db/id #edb/ref 17592186304971} {:db/id #edb/ref 17592186314820} {:db/id #edb/ref 17592186342129} {:db/id #edb/ref 17592186399636} {:db/id #edb/ref 17592186399650} {:db/id #edb/ref 17592186402093} {:db/id #edb/ref 17592186402256} {:db/id #edb/ref 17592186442982} {:db/id #edb/ref 17592186475912} {:db/id #edb/ref 17592186475933} {:db/id #edb/ref 17592186475975} {:db/id #edb/ref 17592186515570}] :knowledge-point/title "Finding the Intersection Point of a Line and a Plane Given in Other Forms"} :step/id #uuid "5e30a524-692f-5456-b232-21ecbec49f72" :step/math-academy-id 17933} {:db/id #edb/ref 17592186120723 :step/content {:db/id #edb/ref 17592186119838 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119652 :question/id #uuid "f952e670-a673-5c15-913b-c396e8885142" :question/math-academy-id "e-4945"} :knowledge-point/id #uuid "82e761b5-ec1c-549d-b726-e0909cfe460b" :knowledge-point/questions [{:db/id #edb/ref 17592186120289} {:db/id #edb/ref 17592186120290} {:db/id #edb/ref 17592186244121} {:db/id #edb/ref 17592186244122} {:db/id #edb/ref 17592186244124} {:db/id #edb/ref 17592186342127} {:db/id #edb/ref 17592186342128} {:db/id #edb/ref 17592186399622} {:db/id #edb/ref 17592186399629} {:db/id #edb/ref 17592186403745} {:db/id #edb/ref 17592186475922} {:db/id #edb/ref 17592186475941} {:db/id #edb/ref 17592186475955} {:db/id #edb/ref 17592186484201} {:db/id #edb/ref 17592186516797} {:db/id #edb/ref 17592186516801}] :knowledge-point/title "Finding the Intersection Point of a Line in Parametric Form and a Plane in Cartesian Form"} :step/id #uuid "58f5efb4-ec29-5ce2-8705-052ae48be5fc" :step/math-academy-id 17934 :step/next {:db/id #edb/ref 17592186120722}}] :activity/title "The Intersection Between a Line and a Plane" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120019}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186484337} :activity/id #uuid "77955475-06cd-58a4-a89c-cfc9a4ad253a" :activity/scope {:db/id #edb/ref 17592186050148 :topic/id #uuid "30d88a85-9b00-5b6d-90cc-41ac3f6c9da8" :topic/math-academy-id 1808} :activity/steps [{:db/id #edb/ref 17592186484300 :step/content {:db/id #edb/ref 17592186342129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e017315-e476-5fa0-8361-dc00652a6489" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,0,1)" :db/id #edb/ref 17592186340405} {:answer/id #uuid "ad64653c-387b-56c4-988a-77711f82ccae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186340706} {:answer/id #uuid "af463bcf-e431-5d1e-a420-7660e1b98031" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-2,-5,4)" :db/id #edb/ref 17592186340726} {:answer/id #uuid "d8153fa3-e604-533d-b56e-b26114f3d4d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,1,5)" :db/id #edb/ref 17592186341045} {:answer/id #uuid "f86bd550-c5e7-5c4a-ad94-8436818324a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-5,4,2)" :db/id #edb/ref 17592186341326}] :answer-field/correct {:db/id #edb/ref 17592186341045} :answer-field/id #uuid "9343b686-98f1-53b8-a0c6-e7d798a3b52a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341638}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "156769fc-4325-56fe-a6f3-a488d1baa118" :question/math-academy-id "q-74004" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨3,1,5⟩+w⟨-2,-5,4⟩,\\,Π:r=⟨-5,4,2⟩+s⟨0,3,1⟩+t⟨2,0,1⟩.\n$$" :question/worked-solution "From the equation of a plane in the parametric form $r=p+tv+sw$, we have that its normal vector is $n=v\\times w.$ In our case, the normal vectors to $Π$ is\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =⟨0,3,1⟩\\times ⟨2,0,1⟩ \\\\  & =|\\begin{aligned}i & j & k \\\\ 0 & 3 & 1 \\\\ 2 & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 1 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}|j+|\\begin{aligned}0 & 3 \\\\ 2 & 0\\end{aligned}|k \\\\  & =3i+2j-6k \\\\  & =⟨3,2,-6⟩.\\end{aligned}\n$$\n\nTherefore, the equation of the plane $Π$ in dot product form is\n\n$$\n\\begin{aligned}r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,2,-6⟩ & =⟨-5,4,2⟩\\cdot ⟨3,2,-6⟩ \\\\ r\\cdot ⟨3,2,-6⟩ & =-19.\\end{aligned}\n$$\n\nNow, substituting $r=⟨3,1,5⟩+w⟨-2,-5,4⟩$ into the equation of the plane in dot product form, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨3,2,-6⟩ & =-19 \\\\ ⟨3-2w,1-5w,5+4w⟩\\cdot ⟨3,2,-6⟩ & =-19 \\\\ 3(3-2w)+2(1-5w)-6(5+4w) & =-19 \\\\ 9-6w+2-10w-30-24w & =-19 \\\\ -40w & =0 \\\\ w & =0.\\end{aligned}\n$$\n\nFinally, to get the position vector $q$ of the intersection point $Q,$ we substitute $w=0$ into the equation of the line:\n\n$$\n\\begin{aligned}q & =⟨3-2(0),1-5(0),5+4(0)⟩ \\\\  & =⟨3,1,5⟩\\end{aligned}\n$$\n\nSo, the intersection point is $Q(3,1,5).$"} :step/id #uuid "0227058d-e862-5e31-b5c8-bea4849a37b5" :step/next {:db/id #edb/ref 17592186484327}} {:db/id #edb/ref 17592186484313 :step/content {:db/id #edb/ref 17592186342127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b2ccf68-fbc4-58ea-80f0-c47a1f4e61c5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186339365} {:answer/id #uuid "1d364631-26c0-59a4-93c9-0842ba8027a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(19,10,16)" :db/id #edb/ref 17592186339381} {:answer/id #uuid "2bfe2f6a-4b05-5041-9be9-ec95d41ced84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(18,8,12)" :db/id #edb/ref 17592186339510} {:answer/id #uuid "90fc5ea2-94e0-5824-91af-e274368bde07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(18,11,16)" :db/id #edb/ref 17592186340429} {:answer/id #uuid "a5f82de1-4dec-5d15-9285-344580d1aa1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8,-1,6)" :db/id #edb/ref 17592186340633}] :answer-field/correct {:db/id #edb/ref 17592186340429} :answer-field/id #uuid "3769c405-5ffb-59ea-8180-d6fbf6837b56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186341479}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8a17e320-306c-50fa-b84b-f8cbe958e629" :question/math-academy-id "q-73993" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\{\\begin{aligned}x=3-5t \\\\ y=2-3t \\\\ z=-2-6t\\end{aligned}\\,\\text{and}\\,Π:5x-2y+4z-132=0.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}5x-2y+4z-132 & =0 \\\\ 5(3-5t)-2(2-3t)+4(-2-6t) & =132 \\\\ 15-25t-4+6t-8-24t & =132 \\\\ -43t & =129 \\\\ t & =-3\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=-3$ into the parametric equations of the line:\n\n$$\n\\{\\begin{aligned}x=3-5(-3)=18 \\\\ y=2-3(-3)=11 \\\\ z=-2-6(-3)=16\\end{aligned}\n$$\n\nSo, the intersection point is  $P(18,11,16).$"} :step/id #uuid "3315e388-6b5a-5594-b5f3-c37c6118ed26" :step/next {:db/id #edb/ref 17592186484300}} {:db/id #edb/ref 17592186484327 :step/content {:db/id #edb/ref 17592186475912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "007d69dc-a2ca-580f-b0f7-74cbcfa1ebdd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186475444} {:answer/id #uuid "3a25e529-3954-5987-92eb-d533381cc44b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(25,31,-6)" :db/id #edb/ref 17592186475523} {:answer/id #uuid "52af092c-e727-5f18-8ff7-345347fe6d51" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-8,-13,5)" :db/id #edb/ref 17592186475562} {:answer/id #uuid "572842f6-cb5d-5a22-b2c9-50266f22eb6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(13,15,-2)" :db/id #edb/ref 17592186475570} {:answer/id #uuid "fca47535-789f-5b0b-98b2-271a04ca1b25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-14,-21,7)" :db/id #edb/ref 17592186475823}] :answer-field/correct {:db/id #edb/ref 17592186475523} :answer-field/id #uuid "d8937436-576e-5320-a137-6b981c96167e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186475895}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "07e33caa-9650-5834-8d9a-46cc82f723d1" :question/math-academy-id "q-108434" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨1,-1,2⟩+w⟨3,4,-1⟩,\\,Π:r=⟨5,3,-4⟩+s⟨1,0,2⟩+t⟨0,-2,3⟩.\n$$" :question/worked-solution "From the equation of a plane in the parametric form $r=p+tv+sw$, we have that its normal vector is $n=v\\times w.$ In our case, the normal vectors to $Π$ is\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =⟨1,0,2⟩\\times ⟨0,-2,3⟩ \\\\  & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 2 \\\\ 0 & -2 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 2 \\\\ -2 & 3\\end{aligned}|i-|\\begin{aligned}1 & 2 \\\\ 0 & 3\\end{aligned}|j+|\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}|k \\\\  & =4i-3j-2k \\\\  & =⟨4,-3,-2⟩.\\end{aligned}\n$$\n\nTherefore, the equation of the plane $Π$ in dot product form is\n\n$$\n\\begin{aligned}r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨4,-3,-2⟩ & =⟨5,3,-4⟩\\cdot ⟨4,-3,-2⟩ \\\\ r\\cdot ⟨4,-3,-2⟩ & =19.\\end{aligned}\n$$\n\nNow, substituting $r=⟨1,-1,2⟩+w⟨3,4,-1⟩$ into the equation of the plane in dot product form, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨4,-3,-2⟩ & =19 \\\\ ⟨1+3w,-1+4w,2-w⟩\\cdot ⟨4,-3,-2⟩ & =19 \\\\ 4(1+3w)-3(-1+4w)-2(2-w) & =19 \\\\ 4+12w+3-12w-4+2w & =19 \\\\ 2w & =16 \\\\ w & =8.\\end{aligned}\n$$\n\nFinally, to get the position vector $q$ of the intersection point $Q,$ we substitute $w=8$ into the equation of the line:\n\n$$\n\\begin{aligned}q & =⟨1+3(8),-1+4(8),2-8⟩ \\\\  & =⟨25,31,-6⟩\\end{aligned}\n$$\n\nSo, the intersection point is $Q(25,31,-6).$"} :step/id #uuid "6a1f4ccb-dfb0-5de6-aea8-7109eb01b3fc"} {:db/id #edb/ref 17592186484330 :step/content {:db/id #edb/ref 17592186484201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20fc86f8-0368-54eb-a3e0-3cf6b0379332" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-16,-16,13)" :db/id #edb/ref 17592186483621} {:answer/id #uuid "2143e54b-67d5-5002-957a-3bf88c230ca4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(24,-11,11)" :db/id #edb/ref 17592186483624} {:answer/id #uuid "257b548a-b52d-5b2d-8a2f-57d74b50d39c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186483630} {:answer/id #uuid "7944f3e7-3b31-5e5a-b5cb-a1562208eb42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(11,-13,11)" :db/id #edb/ref 17592186483813} {:answer/id #uuid "a0a4f2b9-c6e0-5e67-8ab6-66d592472d45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(26,12,12)" :db/id #edb/ref 17592186483899}] :answer-field/correct {:db/id #edb/ref 17592186483621} :answer-field/id #uuid "15f90597-4c03-5ae4-b2c2-f42eae091087" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186484091}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "12b4f5c6-720f-5c2c-b1e8-295eb7dcb29c" :question/math-academy-id "q-73991" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\{\\begin{aligned}x=-2-2t \\\\ y=5-3t \\\\ z=-1+2t\\end{aligned}\\,\\text{and}\\,Π:3x-2y+6z=62.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}3x-2y+6z & =62 \\\\ 3(-2-2t)-2(5-3t)+6(-1+2t) & =62 \\\\ -6-6t-10+6t-6+12t & =62 \\\\ 12t & =84 \\\\ t & =7\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=6$ into the parametric equations of the line:\n\n$$\n\\{\\begin{aligned}x=-2-2(7)=-16 \\\\ y=5-3(7)=-16 \\\\ z=-1+2(7)=13\\end{aligned}\n$$\n\nSo, the intersection point is $P(-16,-16,13).$"} :step/id #uuid "77b76b91-5e55-576f-a898-b871a06b8ed3" :step/next {:db/id #edb/ref 17592186484313}} {:db/id #edb/ref 17592186484337 :step/content {:db/id #edb/ref 17592186120290 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a523b91-b0c8-5d77-ac05-a918d500094c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-9,9,7)" :db/id #edb/ref 17592186312052} {:answer/id #uuid "82d8d2f3-12d7-5f69-9c67-b4d2db7dc5da" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186313028} {:answer/id #uuid "8d14825a-42af-51a3-9f03-b6163ac5f748" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,-1,3)" :db/id #edb/ref 17592186313102} {:answer/id #uuid "95ed7638-8aa8-5f1b-b639-82099d0d033c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9,7,-9)" :db/id #edb/ref 17592186313173} {:answer/id #uuid "c5ba162d-d3e7-561c-ba10-731b0f92f98b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(9,-9,7)" :db/id #edb/ref 17592186313525}] :answer-field/correct {:db/id #edb/ref 17592186313525} :answer-field/id #uuid "0d7ba987-d1b7-522f-859e-b04e23ff46bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186314051}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c755ffbb-8374-5c52-a967-a6387ef6da9c" :question/math-academy-id "q-33992" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\{\\begin{aligned}x=5-2t \\\\ y=-1+4t \\\\ z=-3-5t\\end{aligned}\\,\\text{and}\\,Π:2x-5y+3z-84=0.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}2x-5y+3z-84 & =0 \\\\ 2(5-2t)-5(-1+4t)+3(-3-5t) & =84 \\\\ 10-4t+5-20t-9-15t & =84 \\\\ -39t & =78 \\\\ t & =-2\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=-2$ into the parametric equations of the line:\n\n$$\n\\{\\begin{aligned}x=5-2(-2)=9 \\\\ y=-1+4(-2)=-9 \\\\ z=-3-5(-2)=7\\end{aligned}\n$$\n\nSo, the intersection point is  $P(9,-9,7).$"} :step/id #uuid "a9c592be-dcfe-59b6-a857-234bdfcf6a00" :step/next {:db/id #edb/ref 17592186484330}}] :activity/title "The Intersection Between a Line and a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186483561}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186516909} :activity/id #uuid "a05a4f34-cba1-54e4-b6a6-f7ada8846659" :activity/scope {:db/id #edb/ref 17592186050148 :topic/id #uuid "30d88a85-9b00-5b6d-90cc-41ac3f6c9da8" :topic/math-academy-id 1808} :activity/steps [{:db/id #edb/ref 17592186516900 :step/content {:db/id #edb/ref 17592186516801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140b7152-7be6-5b10-b162-4dcea3796757" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(23,5,6)" :db/id #edb/ref 17592186516151} {:answer/id #uuid "7062112e-23e0-5023-abc6-42331af0e0bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,50,6)" :db/id #edb/ref 17592186516364} {:answer/id #uuid "739dc482-cca6-5907-b91b-15164a66f7c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(32,50,16)" :db/id #edb/ref 17592186516369} {:answer/id #uuid "cde85d08-f475-531a-bd01-73f6eb9051bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(12,25,36)" :db/id #edb/ref 17592186516547} {:answer/id #uuid "d54b4cb0-06e8-5602-a1ad-89fba9fb6215" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186516561}] :answer-field/correct {:db/id #edb/ref 17592186516369} :answer-field/id #uuid "616c22d5-e3ac-50e3-88f8-ae593e1ea4d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516692}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4c18b1c7-8bdd-5391-9b67-8443fd23166f" :question/math-academy-id "q-73998" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\{\\begin{aligned}x=8+3t \\\\ y=-6+7t \\\\ z=2t\\end{aligned}\\,\\text{and}\\,Π:2x+5y-8z=186.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}2x+5y-8z & =186 \\\\ 2(8+3t)+5(-6+7t)-8(2t) & =186 \\\\ 16+6t-30+35t-16t & =186 \\\\ 25t & =200 \\\\ t & =8\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=8$ into the parametric equations of the line:\n\n$$\n\\{\\begin{aligned}x=8+3(8)=32 \\\\ y=-6+7(8)=50 \\\\ z=2(8)=16\\end{aligned}\n$$\n\nSo, the intersection point is $P(32,50,16).$"} :step/id #uuid "46aaa850-40f1-5820-9c52-4b357fdbea2f" :step/next {:db/id #edb/ref 17592186516919}} {:db/id #edb/ref 17592186516909 :step/content {:db/id #edb/ref 17592186120239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d74ada3-9243-5f7c-ade2-62caa4b9c021" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,1,-4)" :db/id #edb/ref 17592186402088} {:answer/id #uuid "2ddeb712-2499-5385-8cf5-8d5841c638be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,-4,7)" :db/id #edb/ref 17592186402089} {:answer/id #uuid "c3a42789-8ed3-50da-bd89-5ed82656d5bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-8,1,1)" :db/id #edb/ref 17592186402090} {:answer/id #uuid "4f5b4306-4e52-5f8f-a6c5-d9a8c474f65b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186402091} {:answer/id #uuid "b73612ac-9159-5b03-82b8-04dc3dbeb325" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,-4,1)" :db/id #edb/ref 17592186402092}] :answer-field/correct {:db/id #edb/ref 17592186402092} :answer-field/id #uuid "1ba93ced-d091-5536-afc3-ce47413fdf3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402087}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "49e4fa98-401d-5c2d-a49c-1997a8550033" :question/math-academy-id "q-33203" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨-5,0,1⟩+t⟨-3,1,0⟩,\\,Π:-3x+y-2z+27=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨-5-3t,t,1⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}-3x+y-2z+27 & =0 \\\\ -3x+y-2z & =-27 \\\\ ⟨x,y,z⟩\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ r\\cdot ⟨-3,1,-2⟩ & =-27\\end{aligned}\n$$\n\nNow, substituting $r=⟨-5-3t,t,1⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ ⟨-5-3t,t,1⟩\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ -3(-5-3t)+1\\cdot t-2\\cdot 1 & =-27 \\\\ 15+9t+t-2 & =-27 \\\\ 10t & =-40 \\\\ t & =-4.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=-4$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-5-3(-4),-4,1⟩ \\\\  & =⟨7,-4,1⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(7,-4,1).$"} :step/id #uuid "5afd2fb8-f672-52e7-a18b-c486687e5ed6" :step/next {:db/id #edb/ref 17592186516948}} {:db/id #edb/ref 17592186516916 :step/content {:db/id #edb/ref 17592186515570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4e4e53-6530-5d9b-ac71-88fa4a852643" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(7,5,12)" :db/id #edb/ref 17592186514894} {:answer/id #uuid "13d7977a-6ece-5a3d-a4d3-a046ae5ee70a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(4,3,8)" :db/id #edb/ref 17592186514914} {:answer/id #uuid "3e792c4b-0f89-58e4-ad54-bf65b7f20967" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186515006} {:answer/id #uuid "97dcbf66-8c48-507d-96c6-a848577b2e92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-5,-3,-4)" :db/id #edb/ref 17592186515192} {:answer/id #uuid "a9993b57-a418-5d19-be94-6b1c3a3b00c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8,5,8)" :db/id #edb/ref 17592186515229}] :answer-field/correct {:db/id #edb/ref 17592186514914} :answer-field/id #uuid "c8d9ffbc-23ef-519d-9512-884d3bb1903d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186515494}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "83aacc67-1785-59c3-94ae-6f65bea01fe4" :question/math-academy-id "q-108881" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\frac{x+2}{3}=\\frac{y+1}{2}=\\frac{z}{4},\\,Π:r\\cdot ⟨3,-1,2⟩=25.\n$$" :question/worked-solution "From the equation of the line $l$, we know that it passes through the point $A(-2,-1,0)$ and it is parallel to the vector $v=⟨3,2,4⟩.$ Therefore, its vector equation is given by\n\n$$\n\\begin{aligned}r & =⟨-2,-1,0⟩+t⟨3,2,4⟩ \\\\  & =⟨-2+3t,-1+2t,4t⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nNow, substituting $r=⟨-2+3t,-1+2t,4t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨3,-1,2⟩ & =25 \\\\ ⟨-2+3t,-1+2t,4t⟩\\cdot ⟨3,-1,2⟩ & =25 \\\\ 3(-2+3t)-(-1+2t)+2(4t) & =25 \\\\ -6+9t+1-2t+8t & =25 \\\\ 15t & =30 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-2+3(2),-1+2(2),4(2)⟩ \\\\  & =⟨4,3,8⟩.\\end{aligned}\n$$\n\nSo, we get $P(4,3,8).$"} :step/id #uuid "6b2e7866-b57f-55d0-8fca-843a70bc51a0"} {:db/id #edb/ref 17592186516919 :step/content {:db/id #edb/ref 17592186516797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58a61e2d-79ec-5942-a542-a599506c947f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,8,4)" :db/id #edb/ref 17592186516299} {:answer/id #uuid "5933b3cc-3b81-55f6-a9e9-d8ce70b49ee7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6,-4,1)" :db/id #edb/ref 17592186516303} {:answer/id #uuid "8c3399b1-2e8d-5048-9705-3b903a795275" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186516404} {:answer/id #uuid "be96b637-0ffd-5d98-b663-5c2fe316eeca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6,-4,-16)" :db/id #edb/ref 17592186516515} {:answer/id #uuid "f5f1cb12-78bd-54f6-9673-719b825438c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,5,-1)" :db/id #edb/ref 17592186516624}] :answer-field/correct {:db/id #edb/ref 17592186516299} :answer-field/id #uuid "96cd3fdc-919f-5a7e-9267-58831d9b0de1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186516725}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "47b66d2c-d386-5a47-ab3a-e7307c9bb3f9" :question/math-academy-id "q-108335" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\{\\begin{aligned}x=4-t \\\\ y=2+3t \\\\ z=-6+5t\\end{aligned}\\,\\text{and}\\,Π:6x-4y+z+16=0.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}6x-4y+z+16 & =0 \\\\ 6(4-t)-4(2+3t)+(-6+5t) & =-16 \\\\ 24-6t-8-12t-6+5t & =-16 \\\\ -13t & =-26 \\\\ t & =2\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=2$ into the parametric equations of the line:\n\n$$\n\\{\\begin{aligned}x=4-2=2 \\\\ y=2+3(2)=8 \\\\ z=-6+5(2)=4\\end{aligned}\n$$\n\nSo, the intersection point is  $P(2,8,4).$"} :step/id #uuid "736e1f94-c79a-5f94-aec8-100a0d8ad1be" :step/next {:db/id #edb/ref 17592186516916}} {:db/id #edb/ref 17592186516948 :step/content {:db/id #edb/ref 17592186402093 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb5e385e-d48b-552d-92db-b2c42b730f55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,8,14)" :db/id #edb/ref 17592186402095} {:answer/id #uuid "2cec0929-bdd8-5d7b-8ece-52cdde4c6f93" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,-2,6)" :db/id #edb/ref 17592186402096} {:answer/id #uuid "c23c18d5-4a2a-5884-8422-592e07e7f5b2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No intersection" :db/id #edb/ref 17592186402097} {:answer/id #uuid "50770341-c200-5dd2-a57c-f88a32fa60ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,4,8)" :db/id #edb/ref 17592186402098} {:answer/id #uuid "b695496a-1b9b-5846-a379-f0e3c0d96851" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(14,8,3)" :db/id #edb/ref 17592186402099}] :answer-field/correct {:db/id #edb/ref 17592186402095} :answer-field/id #uuid "0878a66a-d92b-5043-a146-6c379d55810e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402094}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eaab1f60-24fb-5572-8cfb-474f418bf09f" :question/math-academy-id "q-33205" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨-1,-2,6⟩+t⟨2,5,4⟩,\\,Π:x+2y+z-33=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨-1+2t,-2+5t,6+4t⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}x+2y+z-33 & =0 \\\\ x+2y+z & =33 \\\\ ⟨x,y,z⟩\\cdot ⟨1,2,1⟩ & =33 \\\\ r\\cdot ⟨1,2,1⟩ & =33\\end{aligned}\n$$\n\nNow, substituting $r=⟨-1+2t,-2+5t,6+4t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨1,2,1⟩ & =33 \\\\ ⟨-1+2t,-2+5t,6+4t⟩\\cdot ⟨1,2,1⟩ & =33 \\\\ -1+2t+2(-2+5t)+6+4t & =33 \\\\ -1+2t-4+10t+6+4t & =33 \\\\ 16t & =32 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-1+2(2),-2+5(2),6+4(2)⟩ \\\\  & =⟨3,8,14⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(3,8,14).$"} :step/id #uuid "ae6d11cd-9598-5c2f-b52d-5379a477c70b" :step/next {:db/id #edb/ref 17592186516900}}] :activity/title "The Intersection Between a Line and a Plane" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186516105}]}
