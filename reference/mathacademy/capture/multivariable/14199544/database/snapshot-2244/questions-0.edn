#{[{:db/id #edb/ref 17592186515570 :knowledge-point/_questions [{:db/id #edb/ref 17592186119837 :knowledge-point/id #uuid "caf29808-4551-56a0-ac86-a4587a06fc0f" :knowledge-point/title "Finding the Intersection Point of a Line and a Plane Given in Other Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4e4e53-6530-5d9b-ac71-88fa4a852643" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,5,12)" :db/id #edb/ref 17592186514894} {:answer/id #uuid "13d7977a-6ece-5a3d-a4d3-a046ae5ee70a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,3,8)" :db/id #edb/ref 17592186514914} {:answer/id #uuid "3e792c4b-0f89-58e4-ad54-bf65b7f20967" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186515006} {:answer/id #uuid "97dcbf66-8c48-507d-96c6-a848577b2e92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,-3,-4)" :db/id #edb/ref 17592186515192} {:answer/id #uuid "a9993b57-a418-5d19-be94-6b1c3a3b00c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8,5,8)" :db/id #edb/ref 17592186515229}] :answer-field/correct {:answer/id #uuid "13d7977a-6ece-5a3d-a4d3-a046ae5ee70a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,3,8)" :db/id #edb/ref 17592186514914} :answer-field/id #uuid "c8d9ffbc-23ef-519d-9512-884d3bb1903d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186515494}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83aacc67-1785-59c3-94ae-6f65bea01fe4" :question/math-academy-id "q-108881" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\frac{x+2}{3}=\\frac{y+1}{2}=\\frac{z}{4},\\,Π:r\\cdot ⟨3,-1,2⟩=25.\n$$" :question/worked-solution "From the equation of the line $l$, we know that it passes through the point $A(-2,-1,0)$ and it is parallel to the vector $v=⟨3,2,4⟩.$ Therefore, its vector equation is given by\n\n$$\n\\begin{aligned}r & =⟨-2,-1,0⟩+t⟨3,2,4⟩ \\\\  & =⟨-2+3t,-1+2t,4t⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nNow, substituting $r=⟨-2+3t,-1+2t,4t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨3,-1,2⟩ & =25 \\\\ ⟨-2+3t,-1+2t,4t⟩\\cdot ⟨3,-1,2⟩ & =25 \\\\ 3(-2+3t)-(-1+2t)+2(4t) & =25 \\\\ -6+9t+1-2t+8t & =25 \\\\ 15t & =30 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-2+3(2),-1+2(2),4(2)⟩ \\\\  & =⟨4,3,8⟩.\\end{aligned}\n$$\n\nSo, we get $P(4,3,8).$"}] [{:db/id #edb/ref 17592186120239 :knowledge-point/_questions [{:db/id #edb/ref 17592186119837 :knowledge-point/id #uuid "caf29808-4551-56a0-ac86-a4587a06fc0f" :knowledge-point/title "Finding the Intersection Point of a Line and a Plane Given in Other Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a69b22d8-5f30-5e05-81bb-243ed724e1d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-4, 7)" :db/id #edb/ref 17592186117594} {:answer/id #uuid "cdce1910-9bcc-5251-b118-6aa04aaeb35a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186117595} {:answer/id #uuid "06faf094-268f-5487-9e0a-8dda830b16c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8, 1, 1)" :db/id #edb/ref 17592186117596} {:answer/id #uuid "4ea6e821-2c68-5890-9921-7e7988992607" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,-4, 1)" :db/id #edb/ref 17592186117597} {:answer/id #uuid "79a2209b-6180-5a7d-9efd-5b7a99c8eed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7, 1,-4)" :db/id #edb/ref 17592186117598}] :answer-field/id #uuid "fe66adf4-1b34-5a67-af27-8e9f1215ce5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117593} {:answer-field/choices [{:answer/id #uuid "6d74ada3-9243-5f7c-ade2-62caa4b9c021" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,1,-4)" :db/id #edb/ref 17592186402088} {:answer/id #uuid "2ddeb712-2499-5385-8cf5-8d5841c638be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-4,7)" :db/id #edb/ref 17592186402089} {:answer/id #uuid "c3a42789-8ed3-50da-bd89-5ed82656d5bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8,1,1)" :db/id #edb/ref 17592186402090} {:answer/id #uuid "4f5b4306-4e52-5f8f-a6c5-d9a8c474f65b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186402091} {:answer/id #uuid "b73612ac-9159-5b03-82b8-04dc3dbeb325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,-4,1)" :db/id #edb/ref 17592186402092}] :answer-field/correct {:answer/id #uuid "b73612ac-9159-5b03-82b8-04dc3dbeb325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,-4,1)" :db/id #edb/ref 17592186402092} :answer-field/id #uuid "1ba93ced-d091-5536-afc3-ce47413fdf3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402087}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "49e4fa98-401d-5c2d-a49c-1997a8550033" :question/math-academy-id "q-33203" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨-5,0,1⟩+t⟨-3,1,0⟩,\\,Π:-3x+y-2z+27=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨-5-3t,t,1⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}-3x+y-2z+27 & =0 \\\\ -3x+y-2z & =-27 \\\\ ⟨x,y,z⟩\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ r\\cdot ⟨-3,1,-2⟩ & =-27\\end{aligned}\n$$\n\nNow, substituting $r=⟨-5-3t,t,1⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ ⟨-5-3t,t,1⟩\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ -3(-5-3t)+1\\cdot t-2\\cdot 1 & =-27 \\\\ 15+9t+t-2 & =-27 \\\\ 10t & =-40 \\\\ t & =-4.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=-4$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-5-3(-4),-4,1⟩ \\\\  & =⟨7,-4,1⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(7,-4,1).$"}] [{:db/id #edb/ref 17592186402093 :knowledge-point/_questions [{:db/id #edb/ref 17592186119837 :knowledge-point/id #uuid "caf29808-4551-56a0-ac86-a4587a06fc0f" :knowledge-point/title "Finding the Intersection Point of a Line and a Plane Given in Other Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb5e385e-d48b-552d-92db-b2c42b730f55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,8,14)" :db/id #edb/ref 17592186402095} {:answer/id #uuid "2cec0929-bdd8-5d7b-8ece-52cdde4c6f93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-2,6)" :db/id #edb/ref 17592186402096} {:answer/id #uuid "c23c18d5-4a2a-5884-8422-592e07e7f5b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186402097} {:answer/id #uuid "50770341-c200-5dd2-a57c-f88a32fa60ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,4,8)" :db/id #edb/ref 17592186402098} {:answer/id #uuid "b695496a-1b9b-5846-a379-f0e3c0d96851" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(14,8,3)" :db/id #edb/ref 17592186402099}] :answer-field/correct {:answer/id #uuid "fb5e385e-d48b-552d-92db-b2c42b730f55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,8,14)" :db/id #edb/ref 17592186402095} :answer-field/id #uuid "0878a66a-d92b-5043-a146-6c379d55810e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402094}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eaab1f60-24fb-5572-8cfb-474f418bf09f" :question/math-academy-id "q-33205" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨-1,-2,6⟩+t⟨2,5,4⟩,\\,Π:x+2y+z-33=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨-1+2t,-2+5t,6+4t⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}x+2y+z-33 & =0 \\\\ x+2y+z & =33 \\\\ ⟨x,y,z⟩\\cdot ⟨1,2,1⟩ & =33 \\\\ r\\cdot ⟨1,2,1⟩ & =33\\end{aligned}\n$$\n\nNow, substituting $r=⟨-1+2t,-2+5t,6+4t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨1,2,1⟩ & =33 \\\\ ⟨-1+2t,-2+5t,6+4t⟩\\cdot ⟨1,2,1⟩ & =33 \\\\ -1+2t+2(-2+5t)+6+4t & =33 \\\\ -1+2t-4+10t+6+4t & =33 \\\\ 16t & =32 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-1+2(2),-2+5(2),6+4(2)⟩ \\\\  & =⟨3,8,14⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(3,8,14).$"}]}
