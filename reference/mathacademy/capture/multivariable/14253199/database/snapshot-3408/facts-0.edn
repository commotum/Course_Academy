frac{n\\pi x}{2}) \\\\ {y}_{p}^{″} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }-{a}_{n}\\frac{n\\pi }{2}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}))∼{\\sum }_{n=1}^{\\infty }-{a}_{n}\\frac{{n}^{2}{\\pi }^{2}}{4}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{″}$ and ${y}_{p}$ into the equation and have\n\n$$\n{\\sum }_{n=1}^{\\infty }-{a}_{n}\\frac{{n}^{2}{\\pi }^{2}}{4}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})-4(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{2}))=4+{\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n+1}}{{n}^{3}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{2}).\n$$\n\nRearranging the terms, we get \n\n$$\n-4\\cdot \\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}(-\\frac{{n}^{2}{\\pi }^{2}}{4}-4)\\operatorname{cos}⁡(\\frac{n\\pi x}{2})=4+{\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n+1}}{{n}^{3}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNow, equating the free terms and cosine coefficients, we obtain:\n\n$$\n\\left\\{\\begin{aligned}-4\\cdot \\frac{{a}_{0}}{2} &=4 \\\\ {a}_{n}(-\\frac{{n}^{2}{\\pi }^{2}}{4}-4) &=\\frac{2(-1)^{n+1}}{{n}^{3}\\pi }\\end{aligned}\\right.\\,⇒\\,\\left\\{\\begin{aligned}\\frac{{a}_{0}}{2} &=-1 \\\\ {a}_{n} &=\\frac{8(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+16)}\\end{aligned}\\right.\n$$\n\nTherefore, our particular solution is\n\n$$\n{y}_{p}∼-1+{\\sum }_{n=1}^{\\infty }\\,\\frac{8(-1)^{n}}{{n}^{3}\\pi ({n}^{2}{\\pi }^{2}+16)}\\cdot \\operatorname{cos}⁡(\\frac{n\\pi x}{2}).\n$$" #edb/ref 17592186045443] [17592186368338 #edb/ref 1075 #edb/ref 17592186368339 #edb/ref 17592186045417] [17592186368338 #edb/ref 1075 #edb/ref 17592186368340 #edb/ref 17592186045417] [17592186368338 #edb/ref 1075 #edb/ref 17592186368341 #edb/ref 17592186045417] [17592186368338 #edb/ref 1075 #edb/ref 17592186368342 #edb/ref 17592186045417] [17592186368338 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186368338 #edb/ref 