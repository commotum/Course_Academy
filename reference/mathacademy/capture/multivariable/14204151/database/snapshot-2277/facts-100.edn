rac{3}{\\sqrt{13}}\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=25,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-25I & =\\begin{bmatrix}37 & -18 \\\\ -18 & 52\\end{bmatrix}-25\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}12 & -18 \\\\ -18 & 27\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-25I)x=0$ gives a unit eigenvector\n\n$$\n{v}_{2}=\\begin{bmatrix}\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{bmatrix}.\n$$\n\n- **Step 4.** Find the left singular vectors of $A$: Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n- First, we compute ${u}_{1}:$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{8}\\begin{bmatrix}6 & -4 \\\\ 1 & 6\\end{bmatrix}\\begin{bmatrix}-\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{bmatrix} \\\\  & =\\frac{1}{8}\\begin{bmatrix}-\\frac{24}{\\sqrt{13}} \\\\ \\frac{16}{\\sqrt{13}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{bmatrix}\\end{aligned}\n$$\n\n- Then, we compute ${u}_{2}:$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{5}\\begin{bmatrix}6 & -4 \\\\ 1 & 6\\end{bmatrix}\\begin{bmatrix}\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{bmatrix} \\\\  & =\\frac{1}{5}\\begin{bmatrix}\\frac{10}{\\sqrt{13}} \\\\ \\frac{15}{\\sqrt{13}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we construct the matrices $U$ and $V:$\n\n$$\nU=\\begin{bmatrix}-\\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}}\\end{bmatrix},\\,V=\\begin{bmatrix}-\\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{bmatrix}\n$$" #edb/ref 17592186045443] [17592186509694 #edb/ref 1043 #edb/ref 17592186510478 #edb/ref 1759218604541