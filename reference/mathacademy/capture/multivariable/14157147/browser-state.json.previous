sup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mn>3</mn></msubsup><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mn>0</mn><mn>2</mn></msubsup><mn>2</mn><mi>x</mi><mo stretchy=\"false\">(</mo><msup><mi>y</mi><mn>2</mn></msup><mo>+</mo><mn>6</mn><mo stretchy=\"false\">)</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>y</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mtext>d</mtext><mi>x</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
