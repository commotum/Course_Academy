#{[{:db/id #edb/ref 17592186172309 :knowledge-point/_questions [{:db/id #edb/ref 17592186172100 :knowledge-point/id #uuid "d5c7e707-c978-566d-8a69-98c84c7eb53e" :knowledge-point/title "Expressing Flux as a Double Integral Using Green's Theorem in Flux Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cb0875b-4ef8-58eb-8217-9c53fb18ec9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}{\\int }_{0}^{2}({x}^{2}-5y)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186260529} {:answer/id #uuid "8e8d79b2-c27e-5bcf-9329-f7f7ae12d537" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}{\\int }_{0}^{2}({x}^{2}+5y)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186261120} {:answer/id #uuid "9f228826-f550-52dc-83d1-70ff2e48a178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{\\int }_{-1}^{2}x(2y+5)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186261255} {:answer/id #uuid "c8cc4bc7-93b1-5f30-8801-7d45f0f67ff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}{\\int }_{0}^{2}x(2y+5)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186261649} {:answer/id #uuid "dd26827a-6b30-5805-9ec2-35c779e0f6bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{\\int }_{-1}^{2}x(2y-5)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186261831}] :answer-field/correct {:answer/id #uuid "c8cc4bc7-93b1-5f30-8801-7d45f0f67ff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}{\\int }_{0}^{2}x(2y+5)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186261649} :answer-field/id #uuid "e1a2ac70-d4cf-5928-8804-e1eb884d3787" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262521}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bab01488-68e9-5dde-9b92-c15b0288a3e8" :question/math-academy-id "q-127072" :question/problem "Consider the rectangle $C$ with vertices $(-1,0),(2,0),(2,2),$ and $(-1,2),$ traversed counterclockwise. Using the flux form of Green's theorem, express the flux of the vector field\n$F(x,y)={x}^{2}y\\,i+5xy\\,j$\nthrough $C$ as a repeated integral." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\,\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/26/265d27ad87a7f114bd2a32a5f48cbfedb13192abf48f9b759c4ed635e71ff144.png)\n\nWe have that $P(x,y)={x}^{2}y$ and $Q(x,y)=5xy.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2xy,\\,\\frac{∂Q}{∂y} & =5x.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD={(x,y):-1\\le x\\le 2,\\,0\\le y\\le 2}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2xy+5x)\\,\\text{d}A \\\\  & ={\\int }_{-1}^{2}{\\int }_{0}^{2}x(2y+5)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387803 :knowledge-point/_questions [{:db/id #edb/ref 17592186172100 :knowledge-point/id #uuid "d5c7e707-c978-566d-8a69-98c84c7eb53e" :knowledge-point/title "Expressing Flux as a Double Integral Using Green's Theorem in Flux Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a2f6f5b-f063-50fd-a445-e5206861484d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{\\int }_{0}^{3}(2{y}^{2}+6)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186387805} {:answer/id #uuid "ca3a5b14-e539-50ca-b764-e8483d96d0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{\\int }_{0}^{3}2{y}^{2}(x+6)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186387806} {:answer/id #uuid "ff2802b1-16eb-55bd-a33e-9c02fc8a176a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{3}{\\int }_{0}^{2}2x({y}^{2}+6)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186387807} {:answer/id #uuid "8051d521-18c9-5506-8dd8-4404b731cd23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}{\\int }_{0}^{3}({x}^{2}+12y)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186387808} {:answer/id #uuid "2d6e2d0e-132f-5112-af04-61afe3543d74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{3}{\\int }_{0}^{2}(2{x}^{2}+y)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186387809}] :answer-field/correct {:answer/id #uuid "ff2802b1-16eb-55bd-a33e-9c02fc8a176a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{3}{\\int }_{0}^{2}2x({y}^{2}+6)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186387807} :answer-field/id #uuid "a7357b1f-7672-551e-bf04-066c16895432" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387804}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6b4bd86f-3707-5569-a669-abddd19a5594" :question/math-academy-id "q-127228" :question/problem "Consider the rectangle $C$ with vertices $(0,0),(3,0),(3,2),$ and $(0,2),$  traversed counterclockwise. Using the flux form of Green's theorem, express the flux of the vector field\n$F(x,y)={x}^{2}{y}^{2}\\,i+12xy\\,j$\nthrough $C$ as a repeated integral." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n \n\n![](images/23/23066b23aebf332921c22a0439a414ade8dffd2a270641d186da0ed0e9488821.png)\n\nWe have that $P(x,y)={x}^{2}{y}^{2}$ and $Q(x,y)=12xy.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2x{y}^{2},\\,\\frac{∂Q}{∂y} & =12x.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD={(x,y):0\\le x\\le 3,\\,0\\le y\\le 2}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2x{y}^{2}+12x)\\,\\text{d}A \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}2x({y}^{2}+6)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262736 :knowledge-point/_questions [{:db/id #edb/ref 17592186172100 :knowledge-point/id #uuid "d5c7e707-c978-566d-8a69-98c84c7eb53e" :knowledge-point/title "Expressing Flux as a Double Integral Using Green's Theorem in Flux Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a4a4e6e-8fd1-5522-991a-091f0cb886bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{2}(6{y}^{2}+8x)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186260102} {:answer/id #uuid "20290a0e-d346-5c30-942c-4f76e1fbd4e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{3}{\\int }_{-1}^{1}(6{y}^{2}+8x)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186260151} {:answer/id #uuid "a3837ae4-763a-595f-890a-8cc4ef3801c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{2}3{y}^{3}(1+8x)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186261299} {:answer/id #uuid "b8b24ec3-56ed-5096-95a0-c3abce767ce2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{2}3{y}^{3}(1+8x)\\,\\text{d}x\\,\\text{d}y" :db/id #edb/ref 17592186261495} {:answer/id #uuid "fa68bf59-8089-510b-855b-d18f12a481e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{3}{\\int }_{-1}^{1}6{y}^{2}(1+8x)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186262064}] :answer-field/correct {:answer/id #uuid "a3837ae4-763a-595f-890a-8cc4ef3801c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{2}3{y}^{3}(1+8x)\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186261299} :answer-field/id #uuid "8e39b9c2-8ba1-5d6a-8730-4f02deaa62b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262373}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64b95036-f7c8-5305-8593-d176862393c3" :question/math-academy-id "q-127229" :question/problem "Consider the rectangle $C$ with vertices $(-1,0),(1,0),(1,2),$ and $(-1,2),$ traversed counterclockwise. Using the flux form of Green's theorem, express the flux of the vector field\n$F(x,y)=3x{y}^{3}\\,i+6x{y}^{4}\\,j$\nthrough $C$ as a repeated integral." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/fa/fa98f3db31860a463d0a551d5297895e61a6c041d852c04de04c44a194510961.png)\n\nWe have that $P(x,y)=3x{y}^{3}$ and $Q(x,y)=6x{y}^{4}.$ So, \n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=3{y}^{3},\\,\\frac{∂Q}{∂y} & =24x{y}^{3}.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD={(x,y):-1\\le x\\le 1,\\,0\\le y\\le 2}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(3{y}^{3}+24x{y}^{3})\\,\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2}3{y}^{3}(1+8x)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"}]}
