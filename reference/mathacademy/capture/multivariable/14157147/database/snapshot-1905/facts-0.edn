07 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186262752 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186262753 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186262757 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186262759 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186424514 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186424517 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186424518 #edb/ref 17592186045417] [17592186172101 #edb/ref 1038 #edb/ref 17592186424523 #edb/ref 17592186045417] [17592186172101 #edb/ref 1039 "Calculating Flux Across Rectangles" #edb/ref 17592186045417] [17592186172101 #edb/ref 1041 #edb/ref 17592186171907 #edb/ref 17592186045417] [17592186172101 #edb/ref 1042 #uuid "f2a418f9-b4da-53b4-a39c-75d28dfa8595" #edb/ref 17592186045417] [17592186172181 #edb/ref 1043 #edb/ref 17592186173009 #edb/ref 17592186045417] [17592186172181 #edb/ref 1043 #edb/ref 17592186173010 #edb/ref 17592186045417] [17592186172181 #edb/ref 1043 #edb/ref 17592186173011 #edb/ref 17592186045417] [17592186172181 #edb/ref 1043 #edb/ref 17592186173012 #edb/ref 17592186045417] [17592186172181 #edb/ref 1043 #edb/ref 17592186173013 #edb/ref 17592186045417] [17592186172181 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186172181 #edb/ref 1045 "Green's Theorem in Flux Form" #edb/ref 17592186045417] [17592186172181 #edb/ref 1046 #edb/ref 17592186173013 #edb/ref 17592186045417] [17592186172181 #edb/ref 1049 #edb/ref 17592186050694 #edb/ref 17592186045417] [17592186172181 #edb/ref 1050 600.0 #edb/ref 17592186045417] [17592186172181 #edb/ref 1053 #uuid "1b7424bb-16f3-51a5-8f12-862fc36f5a2a" #edb/ref 17592186045417] [17592186172309 #edb/ref 1068 #edb/ref 17592186262521 #edb/ref 17592186045417] [17592186172309 #edb/ref 1069 "q-127072" #edb/ref 17592186045417] [17592186172309 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186172309 #edb/ref 1071 "Consider the rectangle $C$ with vertices $(-1,0),(2,0),(2,2),$ and $(-1,2),$ traversed counterclockwise. Using the flux form of Green's theorem, express the flux of the vector field\n$F(x,y)={x}^{2}y\\,i+5xy\\,j$\nthrough $C$ as a repeated integral." #edb/ref 17592186045417] [17592186172309 #edb/ref 1072 #uuid "bab01488-68e9-5dde-9b92-c15b0288a3e8" #edb/ref 17592186045417] [17592186172309 #edb/ref 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\,\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/26/265d27ad87a7f114bd2a32a5f48cbfedb13192abf48f9b759c4ed635e71ff144.png)\n\nWe have that $P(x,y)={x}^{2}y$ and $Q(x,y)=5xy.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2xy,\\,\\frac{∂Q}{∂y} & =5x.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD={(x,y):-1\\le x\\le 2,\\,0\\le y\\le 2}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2xy+5x)\\,\\text{d}A \\\\  & ={\\int }_{-1}^{2}{\\int }_{0}^{2}x(2y+5)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186173009 #edb/ref 1061 35835 #edb/ref 17592186045417] [17592186173009 #edb/ref 1062 #uuid "ff8c90c5-7280-517d-b629-b9fcf49eb545" #edb/ref 17592186045417] [17592186173009 #edb/ref 1063 #edb/ref 17592186172099 #edb/ref 17592186045417] [17592186173010 #edb/ref 1058 #edb/ref 17592186173011 #edb/ref 17592186045417] [17592186173010 #edb/ref 1061 35836 #edb/ref 17592186045417] [17592186173010 #edb/ref 1062 #uuid "176aba1b-a4f1-53bf-b585-f21efd3b5ea7" #edb/ref 17592186045417] [17592186173010 #edb/ref 1063 #edb/ref 17592186172100 #edb/ref 17592186045417] [17592186173011 #edb/ref 1058 #edb/ref 17592186173009 #edb/ref 17592186045417] [17592186173011 #edb/ref 1061 35837 #edb/ref 17592186045417] [17592186173011 #edb/ref 1062 #uuid "b533c8b3-90f2-54ee-ae35-a98929d6ba6e" #edb/ref 17592186045417] [17592186173011 #edb/ref 1063 #edb/ref 17592186172101 #edb/ref 17592186045417] [17592186173012 #edb/ref 1058 #edb/ref 17592186173010 #edb/ref 17592186045417] [17592186173012 #edb/ref 1061 35877 #edb/ref 17592186045417] [17592186173012 #edb/ref 1062 #uuid "e5c29654-0b83-51e0-a3d0-c6fbf08c8f2d" #edb/ref 17592186045417] [17592186173012 #edb/ref 1063 #edb/ref 17592186173207 #edb/ref 17592186045417] [17592186173013 #edb/ref 1058 #edb/ref 17592186173012 #edb/ref 17592186045417] [17592186173013 #edb/ref 1061 35900 #edb/ref 17592186045417] [17592186173013 #edb/ref 1062 #uuid "528120c2-edf7-5b3d-a8d3-0b481b460d90" #edb/ref 17592186045417] [17592186173013 #edb/ref 1063 #edb/ref 17592186173208 #edb/ref 17592186045417] [17592186173207 #edb/ref 1064 "There is some nice intuition behind the flux form of Green's theorem that makes it easier to remember.\n\nSuppose that $\\mathbf F$ is a vector field on $\\mathbb R^2$ with component functions $P$ and $Q$ defined over a region $D.$ So, we have\n\n$$\n\\mathbf F(x,y) = P(x,y)\\,\\mathbf i + Q(x,y)\\,\\mathbf j.\n$$\n\nGreen's theorem in flux form states that the sum of the microscopic \"fluxes\" (divergences) of $\\mathbf F$ inside $D$ equals the macroscopic flux of $\\mathbf F$ across the boundary of $D.$\n\n![](images/47/47a81125069be94b4ccda6f228ff1b8253f99595c6f3c4ae0ca710bdb796215f.png)\n\n    \n\nRecall that the divergence (i.e., the microscopic flux) of $\\mathbf F$ at a point is given by\n\n$$\n\\textrm{div}\\,\\mathbf F = \\nabla \\cdot \\mathbf F = \\dfrac{\\partial P }{\\partial x} + \\dfrac{\\partial Q }{\\partial y}.\n$$\n\nIf we sum (integrate) the divergence at every point over the entire domain $D,$ we get\n\n$$\n\\iint\\limits_D \\left( \\dfrac{\\partial P }{\\partial x} + \\dfrac{\\partial Q }{\\partial y} \\right)\\textrm d A.\n$$\n\nThis expression gives us one side of Green's theorem in flux form.\n\nThe macroscopic divergence is simply the flux of $\\mathbf F$ across the boundary of $D{:}$\n\n$$\n\\oint\\limits_C\\mathbf F\\cdot \\mathbf n \\, \\textrm d s\n$$\n\nEquating the sum of the divergences with the flux, we have\n\n$$\n\\iint\\limits_D \\left( \\dfrac{\\partial P }{\\partial x} + \\dfrac{\\partial Q }{\\partial y} \\right)\\textrm d A = \\oint\\limits_C\\mathbf F\\cdot \\mathbf n \\, \\textrm d s.\n$$\n\nThe flux form of Green's theorem can be summarized in a single picture, as follows:\n\n![](images/0f/0f8ba4b7e853e3b59e8677b0954c3cfae1b9c482750e13a742bd4d45eda8005d.png)" #edb/ref 17592186045417] [17592186173207 #edb/ref 1065 5862 #edb/ref 17592186045417] [17592186173207 #edb/ref 1066 #uuid "9016229b-93aa-58fc-857c-2a2d3f337ca4" #edb/ref 17592186045417] [17592186173207 #edb/ref 1067 "Intuition Behind Green's Theorem in Flux Form" #edb/ref 17592186045417] [17592186173208 #edb/ref 1064 "Green's theorem allows us to write line integrals as double integrals, and we've seen how Green's theorem simplifies circulation calculations. Even more, Green's theorem can also be used to simplify flux calculations!\n\nTo see how, we first recall that the flux of $\\mathbf{F}(x,y) =  P(x,y)\\,\\mathbf i + Q(x,y)\\mathbf j$ across $C$ can be calculated as follows:\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s= \\oint\\limits_C P\\, \\textrm{d}y -Q\\, \\textrm{d}x\n$$\n\nwhere $C$ is closed and $\\mathbf n$ is the outward-pointing unit normal vector to $C.$\n\nNow, let's set $M= -Q$ and $N=P$. Then, by the circulation form of Green's theorem, we have\n\n$$\n\\begin{aligned}{∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x & ={∮}_{C}N\\,\\text{d}y+M\\,\\text{d}x \\\\  & ={∮}_{C}M\\,\\text{d}x+N\\,\\text{d}y \\\\  & ={∬}_{D}(\\frac{∂N}{∂x}-\\frac{∂M}{∂y})\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}-(-\\frac{∂Q}{∂y}))\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\\end{aligned}\n$$\n\nAs a result, we've obtained the **Green's theorem in flux form**, which we restate below:\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\iint\\limits_D \\left(\\dfrac{\\partial P }{\\partial x} +\\dfrac{\\partial  Q}{\\partial y}\\right)\\textrm d A\n$$\n\nNow, recall that the divergence of $\\mathbf F$ is given by\n\n$$\n\\textrm{div}\\,\\mathbf F =  \\dfrac{\\partial P }{\\partial x} + \\dfrac{\\partial Q }{\\partial y}.\n$$\n\nTherefore, we can also write Green's theorem in flux form as\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\iint\\limits_D \\textrm{div}\\,\\mathbf F\\,\\textrm{d}A.\n$$\n\nGreen's theorem in flux form allows us to convert a flux line integral into an equivalent double integral." #edb/ref 17592186045417] [17592186173208 #edb/ref 1065 5868 #edb/ref 17592186045417] [17592186173208 #edb/ref 1066 #uuid "7f3b4b70-8b58-53d1-bc8d-a42daddfab4d" #edb/ref 17592186045417] [17592186173208 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186260102 #edb/ref 1080 "{\\int }_{-1}^{1}{\\int }_{0}^{2}(6{y}^{2}+8x)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186260102 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186260102 #edb/ref 1083 #uuid "1a4a4e6e-8fd1-5522-991a-091f0cb886bb" #edb/ref 17592186045417] [17592186260151 #edb/ref 1080 "{\\int }_{0}^{3}{\\int }_{-1}^{1}(6{y}^{2}+8x)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186260151 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186260151 #edb/ref 1083 #uuid "20290a0e-d346-5c30-942c-4f76e1fbd4e9" #edb/ref 17592186045417] [17592186260529 #edb/ref 1080 "{\\int }_{-1}^{2}{\\int }_{0}^{2}({x}^{2}-5y)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186260529 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186260529 #edb/ref 1083 #uuid "4cb0875b-4ef8-58eb-8217-9c53fb18ec9a" #edb/ref 17592186045417] [17592186261120 #edb/ref 1080 "{\\int }_{-1}^{2}{\\int }_{0}^{2}({x}^{2}+5y)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186261120 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186261120 #edb/ref 1083 #uuid "8e8d79b2-c27e-5bcf-9329-f7f7ae12d537" #edb/ref 17592186045417] [17592186261255 #edb/ref 1080 "{\\int }_{0}^{2}{\\int }_{-1}^{2}x(2y+5)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186261255 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186261255 #edb/ref 1083 #uuid "9f228826-f550-52dc-83d1-70ff2e48a178" #edb/ref 17592186045417] [17592186261299 #edb/ref 1080 "{\\int }_{-1}^{1}{\\int }_{0}^{2}3{y}^{3}(1+8x)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186261299 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186261299 #edb/ref 1083 #uuid "a3837ae4-763a-595f-890a-8cc4ef3801c1" #edb/ref 17592186045417] [17592186261495 #edb/ref 1080 "{\\int }_{0}^{1}{\\int }_{0}^{2}3{y}^{3}(1+8x)\\,\\text{d}x\\,\\text{d}y" #edb/ref 17592186045417] [17592186261495 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186261495 #edb/ref 1083 #uuid "b8b24ec3-56ed-5096-95a0-c3abce767ce2" #edb/ref 17592186045417] [17592186261649 #edb/ref 1080 "{\\int }_{-1}^{2}{\\int }_{0}^{2}x(2y+5)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186261649 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186261649 #edb/ref 1083 #uuid "c8cc4bc7-93b1-5f30-8801-7d45f0f67ff7" #edb/ref 17592186045417] [17592186261831 #edb/ref 1080 "{\\int }_{0}^{2}{\\int }_{-1}^{2}x(2y-5)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186261831 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186261831 #edb/ref 1083 #uuid "dd26827a-6b30-5805-9ec2-35c779e0f6bb" #edb/ref 17592186045417] [17592186262064 #edb/ref 1080 "{\\int }_{0}^{3}{\\int }_{-1}^{1}6{y}^{2}(1+8x)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186262064 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186262064 #edb/ref 1083 #uuid "fa68bf59-8089-510b-855b-d18f12a481e9" #edb/ref 17592186045417] [17592186262373 #edb/ref 1075 #edb/ref 17592186260102 #edb/ref 17592186045417] [17592186262373 #edb/ref 1075 #edb/ref 17592186260151 #edb/ref 17592186045417] [17592186262373 #edb/ref 1075 #edb/ref 17592186261299 #edb/ref 17592186045417] [17592186262373 #edb/ref 1075 #edb/ref 17592186261495 #edb/ref 17592186045417] [17592186262373 #edb/ref 1075 #edb/ref 17592186262064 #edb/ref 17592186045417] [17592186262373 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186262373 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186262373 #edb/ref 1078 #edb/ref 17592186261299 #edb/ref 17592186045417] [17592186262373 #edb/ref 1079 #uuid "8e39b9c2-8ba1-5d6a-8730-4f02deaa62b2" #edb/ref 17592186045417] [17592186262521 #edb/ref 1075 #edb/ref 17592186260529 #edb/ref 17592186045417] [17592186262521 #edb/ref 1075 #edb/ref 17592186261120 #edb/ref 17592186045417] [17592186262521 #edb/ref 1075 #edb/ref 17592186261255 #edb/ref 17592186045417] [17592186262521 #edb/ref 1075 #edb/ref 17592186261649 #edb/ref 17592186045417] [17592186262521 #edb/ref 1075 #edb/ref 17592186261831 #edb/ref 17592186045417] [17592186262521 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186262521 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186262521 #edb/ref 1078 #edb/ref 17592186261649 #edb/ref 17592186045417] [17592186262521 #edb/ref 1079 #uuid "e1a2ac70-d4cf-5928-8804-e1eb884d3787" #edb/ref 17592186045417] [17592186262736 #edb/ref 1068 #edb/ref 17592186262373 #edb/ref 17592186045417] [17592186262736 #edb/ref 1069 "q-127229" #edb/ref 17592186045417] [17592186262736 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186262736 #edb/ref 1071 "Consider the rectangle $C$ with vertices $(-1,0),(1,0),(1,2),$ and $(-1,2),$ traversed counterclockwise. Using the flux form of Green's theorem, express the flux of the vector field\n$F(x,y)=3x{y}^{3}\\,i+6x{y}^{4}\\,j$\nthrough $C$ as a repeated integral." #edb/ref 17592186045417] [17592186262736 #edb/ref 1072 #uuid "64b95036-f7c8-5305-8593-d176862393c3" #edb/ref 17592186045417] [17592186262736 #edb/ref 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/fa/fa98f3db31860a463d0a551d5297895e61a6c041d852c04de04c44a194510961.png)\n\nWe have that $P(x,y)=3x{y}^{3}$ and $Q(x,y)=6x{y}^{4}.$ So, \n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=3{y}^{3},\\,\\frac{∂Q}{∂y} & =24x{y}^{3}.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD={(x,y):-1\\le x\\le 1,\\,0\\le y\\le 2}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(3{y}^{3}+24x{y}^{3})\\,\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2}3{y}^{3}(1+8x)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186387803 #edb/ref 1068 #edb/ref 17592186387804 #edb/ref 17592186045417] [17592186387803 #edb/ref 1069 "q-127228" #edb/ref 17592186045417] [17592186387803 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186387803 #edb/ref 1071 "Consider the rectangle $C$ with vertices $(0,0),(3,0),(3,2),$ and $(0,2),$  traversed counterclockwise. Using the flux form of Green's theorem, express the flux of the vector field\n$F(x,y)={x}^{2}{y}^{2}\\,i+12xy\\,j$\nthrough $C$ as a repeated integral." #edb/ref 17592186045417] [17592186387803 #edb/ref 1072 #uuid "6b4bd86f-3707-5569-a669-abddd19a5594" #edb/ref 17592186045417] [17592186387803 #edb/ref 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n \n\n![](images/23/23066b23aebf332921c22a0439a414ade8dffd2a270641d186da0ed0e9488821.png)\n\nWe have that $P(x,y)={x}^{2}{y}^{2}$ and $Q(x,y)=12xy.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2x{y}^{2},\\,\\frac{∂Q}{∂y} & =12x.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD={(x,y):0\\le x\\le 3,\\,0\\le y\\le 2}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2x{y}^{2}+12x)\\,\\text{d}A \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}2x({y}^{2}+6)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186387804 #edb/ref 1075 #edb/ref 17592186387805 #edb/ref 17592186045417] [17592186387804 #edb/ref 1075 #edb/ref 17592186387806 #edb/ref 17592186045417] [17592186387804 #edb/ref 1075 #edb/ref 17592186387807 #edb/ref 17592186045417] [17592186387804 #edb/ref 1075 #edb/ref 17592186387808 #edb/ref 17592186045417] [17592186387804 #edb/ref 1075 #edb/ref 17592186387809 #edb/ref 17592186045417] [17592186387804 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186387804 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186387804 #edb/ref 1078 #edb/ref 17592186387807 #edb/ref 17592186045417] [17592186387804 #edb/ref 1079 #uuid "a7357b1f-7672-551e-bf04-066c16895432" #edb/ref 17592186045417] [17592186387805 #edb/ref 1080 "{\\int }_{0}^{2}{\\int }_{0}^{3}(2{y}^{2}+6)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186387805 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186387805 #edb/ref 1083 #uuid "4a2f6f5b-f063-50fd-a445-e5206861484d" #edb/ref 17592186045417] [17592186387806 #edb/ref 1080 "{\\int }_{0}^{2}{\\int }_{0}^{3}2{y}^{2}(x+6)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186387806 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186387806 #edb/ref 1083 #uuid "ca3a5b14-e539-50ca-b764-e8483d96d0a5" #edb/ref 17592186045417] [17592186387807 #edb/ref 1080 "{\\int }_{0}^{3}{\\int }_{0}^{2}2x({y}^{2}+6)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186387807 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186387807 #edb/ref 1083 #uuid "ff2802b1-16eb-55bd-a33e-9c02fc8a176a" #edb/ref 17592186045417] [17592186387808 #edb/ref 1080 "{\\int }_{0}^{2}{\\int }_{0}^{3}({x}^{2}+12y)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186387808 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186387808 #edb/ref 1083 #uuid "8051d521-18c9-5506-8dd8-4404b731cd23" #edb/ref 17592186045417] [17592186387809 #edb/ref 1080 "{\\int }_{0}^{3}{\\int }_{0}^{2}(2{x}^{2}+y)\\,\\text{d}y\\,\\text{d}x" #edb/ref 17592186045417] [17592186387809 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186387809 #edb/ref 1083 #uuid "2d6e2d0e-132f-5112-af04-61afe3543d74" #edb/ref 17592186045417] [17592186429036 #edb/ref 1030 1.0 #edb/ref 17592186045436] [17592186429036 #edb/ref 1032 "Initial Codex estim