#{[{:db/id #edb/ref 17592186348286 :knowledge-point/_questions [{:db/id #edb/ref 17592186092238 :knowledge-point/id #uuid "98c9f0f1-be39-5893-b757-7a4750b07ab5" :knowledge-point/title "Finding the Area Bounded by the Loop of a Limaçon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d91ac80-4828-5778-bc38-7609f256f1fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\pi -8}{2}" :db/id #edb/ref 17592186346307} {:answer/id #uuid "70f9fabf-c90c-57f9-bd37-d2d5daee7ae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\pi -16}{4}" :db/id #edb/ref 17592186346346} {:answer/id #uuid "76256e8c-a2be-5150-aed9-b5b630a5036f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\pi -6}{4}" :db/id #edb/ref 17592186346390} {:answer/id #uuid "b002a26f-156f-5817-a58c-90884eedd7ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\pi +16}{4}" :db/id #edb/ref 17592186346886} {:answer/id #uuid "dc0f7fd1-5632-5dea-bcc6-d1d7077476e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\pi }{4}" :db/id #edb/ref 17592186347280}] :answer-field/correct {:answer/id #uuid "70f9fabf-c90c-57f9-bd37-d2d5daee7ae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\pi -16}{4}" :db/id #edb/ref 17592186346346} :answer-field/id #uuid "329a1129-f618-5a4f-8ea1-b0458c5f153c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347687}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1986f34-b362-501d-9d2f-c2574e803d73" :question/math-academy-id "q-79807" :question/problem "![](images/f5/f57ddfb02991296cbc0280272aa1a28e36cfed926dfedcd7b1955868cf83fff5.png)\n\nFind the area bounded by the polar curve $r=2-\\operatorname{sin}⁡\\theta $ for $0\\le \\theta \\le \\pi ,$ as shown above." :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=2-\\operatorname{sin}⁡\\theta $, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(2-\\operatorname{sin}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(4-4\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{0}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}{\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta ) \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{0}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}(\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{2}\\,{|}_{0}^{\\pi })) \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{0}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{4}\\,{|}_{0}^{\\pi }) \\\\  & =\\frac{9}{4}\\theta \\,{|}_{0}^{\\pi }+2\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{8}\\,{|}_{0}^{\\pi } \\\\  & =\\frac{9}{4}(\\pi -0)+2(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(0))-\\frac{1}{8}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{9\\pi }{4}+2(-2)-\\frac{1}{8}(0) \\\\  & =\\frac{9\\pi -16}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360679 :knowledge-point/_questions [{:db/id #edb/ref 17592186092268 :knowledge-point/id #uuid "a62e8412-1733-577c-bd60-25395e6fa908" :knowledge-point/title "Finding Areas Bounded by Other Polar Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46c86e07-d98c-5f2d-8bee-0bdfd47a3be0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}({e}^{\\pi }-1)" :db/id #edb/ref 17592186358359} {:answer/id #uuid "4de31113-9f5c-5176-99c4-71c441fabd1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{8}({e}^{4\\pi }-1)" :db/id #edb/ref 17592186358423} {:answer/id #uuid "6ec7a098-15f9-5fd8-8655-a20c99986ec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{8}({e}^{2\\pi }-1)" :db/id #edb/ref 17592186358717} {:answer/id #uuid "b2328028-e8f9-520e-b5dd-819c44800a50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}({e}^{4\\pi }-1)" :db/id #edb/ref 17592186359302} {:answer/id #uuid "ed8655d7-d806-56b2-9728-305a97d07fb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}({e}^{2\\pi }-1)" :db/id #edb/ref 17592186359865}] :answer-field/correct {:answer/id #uuid "4de31113-9f5c-5176-99c4-71c441fabd1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{8}({e}^{4\\pi }-1)" :db/id #edb/ref 17592186358423} :answer-field/id #uuid "d8e0974d-cb14-5381-9720-c536c35cbc10" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360373}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4f5e7246-7eb0-5b6e-855d-454cc182be07" :question/math-academy-id "q-9643" :question/problem "Find the area bounded by the polar curve $r=3{e}^{2\\theta }$ for $0\\le \\theta \\le \\pi .$" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=3{e}^{2\\theta }$, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }{(3{e}^{2\\theta })}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{0}^{\\pi }{e}^{4\\theta }\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}\\cdot \\frac{1}{4}{e}^{4\\theta }\\,{|}_{0}^{\\pi } \\\\  & =\\frac{9}{8}({e}^{4\\pi }-{e}^{0}) \\\\  & =\\frac{9}{8}({e}^{4\\pi }-1).\\end{aligned}\n$$"}]}
