#{[{:activity/expected-seconds 1500.0 :activity/first-step {:db/id #edb/ref 17592186093082} :activity/id #uuid "eaf91217-4388-5eb6-8d99-ece4485ba63a" :activity/scope {:db/id #edb/ref 17592186049612 :topic/id #uuid "04817f30-147e-5cb9-b0bb-c54b2e323640" :topic/math-academy-id 1000} :activity/steps [{:db/id #edb/ref 17592186093082 :step/content {:db/id #edb/ref 17592186093357 :tutorial/content "Suppose we want to find the area of the region bounded by the polar curve $r = 3\\cos\\theta$ and the rays $\\theta_1 = 0$ and $\\theta_2 = \\dfrac{\\pi}{2},$ as shown in blue in the picture below. Can we calculate this area using polar coordinates?\n\n![](images/2c/2c7e638a338aed2155ef5bf388be1f83a3a67d2296d5be09987b099a07edacbd.png)\n\nIn general, the area of the region bounded by a polar curve $r=r(\\theta)$ and the rays $\\theta=\\theta_1$ and $\\theta=\\theta_2$ is given by the formula\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2 \\:\\textrm{d}\\theta.\n$$\n\nTherefore, the area of the half-circle above can be obtained as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(3\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{0}^{\\pi /2}{cos}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{0}^{\\pi /2}\\frac{1}{2}(1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{9}{4}(\\theta {|}_{0}^{\\pi /2}+\\frac{1}{2}\\operatorname{sin}⁡(2\\theta ){|}_{0}^{\\pi /2}) \\\\  & =\\frac{9}{4}(\\frac{\\pi }{2}+0) \\\\  & =\\frac{9\\pi }{8}\\end{aligned}\n$$" :tutorial/id #uuid "37d5627c-6e4c-5ffe-b3f4-9efac9c1cc1c" :tutorial/math-academy-id 1126 :tutorial/title "Introduction"} :step/id #uuid "124bbd3f-149a-58b4-a192-cddec4a55c87" :step/math-academy-id 636917 :step/next {:db/id #edb/ref 17592186093083}} {:db/id #edb/ref 17592186093083 :step/content {:db/id #edb/ref 17592186092237 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092089 :question/id #uuid "0d1dcc59-e7af-5a86-87ba-aa7ee1b23767" :question/math-academy-id "e-632"} :knowledge-point/id #uuid "974a88f6-ff6a-5183-aeaf-6019e09061ec" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048292} {:db/id #edb/ref 17592186049303}] :knowledge-point/questions [{:db/id #edb/ref 17592186092626} {:db/id #edb/ref 17592186092932} {:db/id #edb/ref 17592186259576} {:db/id #edb/ref 17592186259577} {:db/id #edb/ref 17592186320969} {:db/id #edb/ref 17592186320970} {:db/id #edb/ref 17592186400135} {:db/id #edb/ref 17592186529113} {:db/id #edb/ref 17592186529122} {:db/id #edb/ref 17592186529147} {:db/id #edb/ref 17592186529148} {:db/id #edb/ref 17592186529149}] :knowledge-point/title "Finding the Area Bounded by a Petal of a Polar Rose"} :step/id #uuid "3976f903-173b-5b28-82c6-c4d5e43d84ee" :step/math-academy-id 636918 :step/next {:db/id #edb/ref 17592186093084}} {:db/id #edb/ref 17592186093084 :step/content {:db/id #edb/ref 17592186092238 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092090 :question/id #uuid "6040d180-ed1d-52b8-809c-b5820352d3d8" :question/math-academy-id "e-633"} :knowledge-point/id #uuid "98c9f0f1-be39-5893-b757-7a4750b07ab5" :knowledge-point/questions [{:db/id #edb/ref 17592186092564} {:db/id #edb/ref 17592186092628} {:db/id #edb/ref 17592186320971} {:db/id #edb/ref 17592186320972} {:db/id #edb/ref 17592186320973} {:db/id #edb/ref 17592186320978} {:db/id #edb/ref 17592186320979} {:db/id #edb/ref 17592186348286} {:db/id #edb/ref 17592186529112} {:db/id #edb/ref 17592186529135} {:db/id #edb/ref 17592186529160} {:db/id #edb/ref 17592186529179} {:db/id #edb/ref 17592186547016} {:db/id #edb/ref 17592186547084}] :knowledge-point/title "Finding the Area Bounded by the Loop of a Limaçon"} :step/id #uuid "4a4e1d0d-4d58-52c3-9254-7fbdf1cb4931" :step/math-academy-id 636921 :step/next {:db/id #edb/ref 17592186093127}} {:db/id #edb/ref 17592186093127 :step/content {:db/id #edb/ref 17592186092268 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092105 :question/id #uuid "a2d8dca5-a0f3-5b6f-81f5-4eea46ee70d8" :question/math-academy-id "e-6822"} :knowledge-point/id #uuid "a62e8412-1733-577c-bd60-25395e6fa908" :knowledge-point/questions [{:db/id #edb/ref 17592186092565} {:db/id #edb/ref 17592186092627} {:db/id #edb/ref 17592186235500} {:db/id #edb/ref 17592186259617} {:db/id #edb/ref 17592186275201} {:db/id #edb/ref 17592186320974} {:db/id #edb/ref 17592186320975} {:db/id #edb/ref 17592186320976} {:db/id #edb/ref 17592186320977} {:db/id #edb/ref 17592186360679} {:db/id #edb/ref 17592186360680} {:db/id #edb/ref 17592186529102} {:db/id #edb/ref 17592186529107} {:db/id #edb/ref 17592186529133} {:db/id #edb/ref 17592186529177} {:db/id #edb/ref 17592186546970}] :knowledge-point/title "Finding Areas Bounded by Other Polar Curves"} :step/id #uuid "545d497e-388a-508b-8784-5ae8f6439681" :step/math-academy-id 636924 :step/next {:db/id #edb/ref 17592186093145}} {:db/id #edb/ref 17592186093145 :step/content {:db/id #edb/ref 17592186093452 :tutorial/content "We've been using the following formula for the area of the region bounded by a polar curve ![](images/70/7031a0f3ab71df36bc36e925fcf4f04dbfc4feec5f374092855ef8d97b104452.svg) and the rays ![](images/38/38b971de9610efe2ed0de9f10956c73cf5cd967a86a5bcbb076791f369c22bef.svg) and ![](images/81/818e2605a585628c4becd20664b58007dbd2348ca664c80be6a838868a64693a.svg)\n\n![](images/55/55ffcf934c3a9e33a3376fa1796e6fb68ad1198d719db5ea094fe8eb46c5f47d.svg)\n\nBut where does this formula come from?\n\nTo see where the formula comes from, we can think about breaking up the area bounded by a polar curve into infinitesimally small sectors of circles.\n\nAs shown in the graph below, each sector has a radius of ![](images/3a/3a4ef1c1b261a53f9c45d0c90f2d44b155125fe1e7b1359406830111b4846f2f.svg) and spans an infinitesimally small angle, ![](images/09/0904a69fa5e6a3a10eaf74b3fdd865db92761eeeffffae1c0badd33ffdf5b34b.svg)\n\n![](images/82/82be86e7092a97ca5b2f1423f32b15030af0c8c63bf47ece8be40b45720ac905.png)\n\nThe ratio of the area of a sector to the full area of the circle must be the same as the ratio of the angle of the sector to a full revolution of the circle. So, if the area of a sector is ![](images/0b/0b2376d17b173024d6f6c82faaff585293e9830ba7ce0764ecf8338adcd14994.svg) then we can set up and solve the following proportion:\n\n![](images/5d/5d318385ab16ee14d784b33c00180a44ade7cee2e97ffeafd290171d0d44868f.svg)\n\nFinally, to find the area under the curve, we can integrate the areas of all the sectors:\n\n![](images/a7/a75940f74a02ceadff519af028783a0e704fba8a73c4abf36c6a371deb56dee7.svg)" :tutorial/id #uuid "1ba36924-1af3-515d-ac60-aab46240a7e7" :tutorial/math-academy-id 4582 :tutorial/title "Intuition Behind the Formula"} :step/id #uuid "a348433a-cb9d-5ca7-a360-627ea0f7f338" :step/math-academy-id 636927}] :activity/title "Finding the Area of a Polar Region" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092396}] [{:activity/course {:db/id #edb/ref 17592186046645} :activity/first-step {:db/id #edb/ref 17592186547120} :activity/id #uuid "3cae4783-8aca-5414-a0fd-55f47ad7d166" :activity/scope {:db/id #edb/ref 17592186049612 :topic/id #uuid "04817f30-147e-5cb9-b0bb-c54b2e323640" :topic/math-academy-id 1000} :activity/steps [{:db/id #edb/ref 17592186547091 :step/content {:db/id #edb/ref 17592186348286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d91ac80-4828-5778-bc38-7609f256f1fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9\\pi -8}{2}" :db/id #edb/ref 17592186346307} {:answer/id #uuid "70f9fabf-c90c-57f9-bd37-d2d5daee7ae5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9\\pi -16}{4}" :db/id #edb/ref 17592186346346} {:answer/id #uuid "76256e8c-a2be-5150-aed9-b5b630a5036f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9\\pi -6}{4}" :db/id #edb/ref 17592186346390} {:answer/id #uuid "b002a26f-156f-5817-a58c-90884eedd7ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9\\pi +16}{4}" :db/id #edb/ref 17592186346886} {:answer/id #uuid "dc0f7fd1-5632-5dea-bcc6-d1d7077476e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9\\pi }{4}" :db/id #edb/ref 17592186347280}] :answer-field/correct {:db/id #edb/ref 17592186346346} :answer-field/id #uuid "329a1129-f618-5a4f-8ea1-b0458c5f153c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347687}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b1986f34-b362-501d-9d2f-c2574e803d73" :question/math-academy-id "q-79807" :question/problem "![](images/f5/f57ddfb02991296cbc0280272aa1a28e36cfed926dfedcd7b1955868cf83fff5.png)\n\nFind the area bounded by the polar curve $r=2-\\operatorname{sin}⁡\\theta $ for $0\\le \\theta \\le \\pi ,$ as shown above." :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=2-\\operatorname{sin}⁡\\theta $, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(2-\\operatorname{sin}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(4-4\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{0}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}{\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta ) \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{0}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}(\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{2}\\,{|}_{0}^{\\pi })) \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{0}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{4}\\,{|}_{0}^{\\pi }) \\\\  & =\\frac{9}{4}\\theta \\,{|}_{0}^{\\pi }+2\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{8}\\,{|}_{0}^{\\pi } \\\\  & =\\frac{9}{4}(\\pi -0)+2(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(0))-\\frac{1}{8}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{9\\pi }{4}+2(-2)-\\frac{1}{8}(0) \\\\  & =\\frac{9\\pi -16}{4}.\\end{aligned}\n$$"} :step/id #uuid "0c7ee13f-dadf-5827-ac0b-ecc5f5d53fe9" :step/next {:db/id #edb/ref 17592186547114}} {:db/id #edb/ref 17592186547114 :step/content {:db/id #edb/ref 17592186547084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "133d1c36-6fc4-54a5-886d-ffa6d1d901d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi -4}{2}" :db/id #edb/ref 17592186546291} {:answer/id #uuid "594935a6-2810-554d-9799-095ccc4adcbb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi -8}{2}" :db/id #edb/ref 17592186546446} {:answer/id #uuid "7d3b55a9-801e-5581-82ba-197cfadd134c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi +8}{4}" :db/id #edb/ref 17592186546528} {:answer/id #uuid "c8201213-aa6a-595a-9cb4-25b97aefe536" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi -8}{2}" :db/id #edb/ref 17592186546695} {:answer/id #uuid "c84f9e5b-b609-56b9-a3cf-c70887165e49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3\\pi +2}{4}" :db/id #edb/ref 17592186546698}] :answer-field/correct {:db/id #edb/ref 17592186546446} :answer-field/id #uuid "d6eb1304-86d3-5439-8c1a-6e535052759f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186546935}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fea4b600-1957-5ee7-b24c-2a8da664ed40" :question/math-academy-id "q-123914" :question/problem "Find the area bounded by the polar curve $r=2-2\\operatorname{sin}⁡\\theta $ for $\\frac{\\pi }{2}\\le \\theta \\le \\pi .$" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=2-2\\operatorname{sin}⁡\\theta $, ${\\theta }_{1}=\\frac{\\pi }{2}$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{\\pi }(2-2\\operatorname{sin}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{\\pi }(4-8\\operatorname{sin}⁡\\theta +4{sin}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{\\pi /2}^{\\pi }+8\\operatorname{cos}⁡\\theta \\,{|}_{\\pi /2}^{\\pi }-2{\\int }_{\\pi /2}^{\\pi }(-1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta ) \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{\\pi /2}^{\\pi }+8\\operatorname{cos}⁡\\theta \\,{|}_{\\pi /2}^{\\pi }-2(-\\theta \\,{|}_{\\pi /2}^{\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{2}\\,{|}_{\\pi /2}^{\\pi })) \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{\\pi /2}^{\\pi }+8\\operatorname{cos}⁡\\theta \\,{|}_{\\pi /2}^{\\pi }+2\\theta \\,{|}_{\\pi /2}^{\\pi }-\\operatorname{sin}⁡(2\\theta )\\,{|}_{\\pi /2}^{\\pi }) \\\\  & =3\\theta \\,{|}_{\\pi /2}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{\\pi /2}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{2}\\,{|}_{\\pi /2}^{\\pi } \\\\  & =3(\\pi -\\frac{\\pi }{2})+4(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(\\frac{\\pi }{2}))-\\frac{1}{2}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(\\pi )) \\\\  & =\\frac{3\\pi }{2}+4\\cdot (-1)-\\frac{1}{2}(0) \\\\  & =\\frac{3\\pi }{2}-4 \\\\  & =\\frac{3\\pi -8}{2}.\\end{aligned}\n$$"} :step/id #uuid "5c5ed0a4-a51e-55f3-a46d-cbc3ad90f4b7" :step/next {:db/id #edb/ref 17592186547139}} {:db/id #edb/ref 17592186547120 :step/content {:db/id #edb/ref 17592186360679 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46c86e07-d98c-5f2d-8bee-0bdfd47a3be0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}({e}^{\\pi }-1)" :db/id #edb/ref 17592186358359} {:answer/id #uuid "4de31113-9f5c-5176-99c4-71c441fabd1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{8}({e}^{4\\pi }-1)" :db/id #edb/ref 17592186358423} {:answer/id #uuid "6ec7a098-15f9-5fd8-8655-a20c99986ec0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{8}({e}^{2\\pi }-1)" :db/id #edb/ref 17592186358717} {:answer/id #uuid "b2328028-e8f9-520e-b5dd-819c44800a50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}({e}^{4\\pi }-1)" :db/id #edb/ref 17592186359302} {:answer/id #uuid "ed8655d7-d806-56b2-9728-305a97d07fb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}({e}^{2\\pi }-1)" :db/id #edb/ref 17592186359865}] :answer-field/correct {:db/id #edb/ref 17592186358423} :answer-field/id #uuid "d8e0974d-cb14-5381-9720-c536c35cbc10" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360373}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4f5e7246-7eb0-5b6e-855d-454cc182be07" :question/math-academy-id "q-9643" :question/problem "Find the area bounded by the polar curve $r=3{e}^{2\\theta }$ for $0\\le \\theta \\le \\pi .$" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=3{e}^{2\\theta }$, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }{(3{e}^{2\\theta })}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{0}^{\\pi }{e}^{4\\theta }\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}\\cdot \\frac{1}{4}{e}^{4\\theta }\\,{|}_{0}^{\\pi } \\\\  & =\\frac{9}{8}({e}^{4\\pi }-{e}^{0}) \\\\  & =\\frac{9}{8}({e}^{4\\pi }-1).\\end{aligned}\n$$"} :step/id #uuid "830b15a1-d04c-512a-af49-3c89629258a5" :step/next {:db/id #edb/ref 17592186547170}} {:db/id #edb/ref 17592186547139 :step/content {:db/id #edb/ref 17592186546970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a3727ff-52bd-57c3-b177-f7a2d8ee75e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186546596}] :answer-field/correct {:db/id #edb/ref 17592186546596} :answer-field/id #uuid "1da0036b-025c-5d9f-a671-5ce1528b4da0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186546841}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1ac2a1ba-0f41-50b8-a45c-f89fbb85a481" :question/math-academy-id "q-352328" :question/problem "![](images/f8/f8ddb41c1b590eceeb3fb92c06bb1a34aa0b7ae92f9c2e76c5b6c595255086eb.png)\n\nFind the area $A$ bounded by the polar curve $r=2{e}^{\\theta }$ for $0\\le \\theta \\le \\operatorname{ln}⁡(2),$ as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nWhen $r(\\theta )=2{e}^{\\theta }$, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\operatorname{ln}⁡(2)$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\operatorname{ln}⁡(2)}(2{e}^{\\theta })^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\operatorname{ln}⁡(2)}4{e}^{2\\theta }\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\operatorname{ln}⁡(2)}{e}^{2\\theta }\\,\\text{d}\\theta  \\\\  & =2(\\frac{{e}^{2\\theta }}{2}){|}_{0}^{\\operatorname{ln}⁡(2)} \\\\  & ={e}^{2\\theta }\\,{|}_{0}^{\\operatorname{ln}⁡(2)} \\\\  & ={e}^{2\\operatorname{ln}⁡(2)}-{e}^{0} \\\\  & =4-1 \\\\  & =3.\\end{aligned}\n$$"} :step/id #uuid "b06a3eba-1986-52ee-b70e-40f72fc1f64a"} {:db/id #edb/ref 17592186547170 :step/content {:db/id #edb/ref 17592186547016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "101aa237-9b05-5fcf-a6bc-d32593b1fcd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}{\\int }_{\\pi /2}^{\\pi }{(1+\\frac{\\operatorname{sin}⁡(\\theta )}{9})}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186546282} {:answer/id #uuid "56e8305c-4e37-5d71-9af2-df48c238587a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{\\int }_{\\pi /2}^{\\pi }(1+\\frac{{sin}^{2}⁡(\\theta )}{9})\\text{d}\\theta " :db/id #edb/ref 17592186546442} {:answer/id #uuid "99f5835e-d85a-5ffb-b243-89bafa4277db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{\\int }_{\\pi /2}^{\\pi }{(1+\\frac{\\operatorname{sin}⁡(\\theta )}{3})}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186546594} {:answer/id #uuid "aa679397-be5e-54b1-bb5c-f465e0cdfdfa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}{\\int }_{\\pi }^{2\\pi }{(1+\\frac{\\operatorname{sin}⁡(\\theta )}{6})}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186546635} {:answer/id #uuid "d38ee693-1c4f-52a9-9a51-5de7c1bf2804" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{\\int }_{\\pi /2}^{\\pi }{(\\frac{\\operatorname{sin}⁡(\\theta )}{3})}^{2}\\text{d}\\theta " :db/id #edb/ref 17592186546718}] :answer-field/correct {:db/id #edb/ref 17592186546594} :answer-field/id #uuid "d1ef4502-034c-55d0-a25e-422ca6738f37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186546933}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7047c0ed-bfc1-51d7-b896-5a8dfa674a47" :question/math-academy-id "q-79796" :question/problem "Which of the following gives the total area enclosed by the graph of the polar curve $r=1+\\frac{\\operatorname{sin}⁡(\\theta )}{3}$ for $\\frac{\\pi }{2}\\le \\theta \\le \\pi ?$" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=1+\\frac{\\operatorname{sin}⁡(\\theta )}{3}$, ${\\theta }_{1}=\\frac{\\pi }{2}$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\nA=\\frac{1}{2}{\\int }_{\\pi /2}^{\\pi }{(1+\\frac{\\operatorname{sin}⁡(\\theta )}{3})}^{2}\\text{d}\\theta \\,.\n$$"} :step/id #uuid "ebaf585e-21b4-5ea6-8f0e-13dc9b777912" :step/next {:db/id #edb/ref 17592186547091}}] :activity/title "Finding the Area of a Polar Region" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186546238}]}
