208\"></use>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(1795,0)\">\n <use xlink:href=\"#E3-MJMAIN-28\"></use>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(2185,0)\">\n <use xlink:href=\"#E3-MJMAIN-2212\"></use>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(2963,0)\">\n <use xlink:href=\"#E3-MJMAIN-221E\"></use>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(3964,0)\">\n <use xlink:href=\"#E3-MJMAIN-2C\"></use>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(4409,0)\">\n <use xlink:href=\"#E3-MJMAIN-2212\"></use>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(5187,0)\">\n <use xlink:href=\"#E3-MJMAIN-31\"></use>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(5688,0)\">\n <use xlink:href=\"#E3-MJMAIN-29\"></use>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(6299,0)\">\n <use xlink:href=\"#E3-MJMAIN-222A\"></use>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(7189,0)\">\n <use xlink:href=\"#E3-MJMAIN-28\"></use>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(7579,0)\">\n <use xlink:href=\"#E3-MJMAIN-31\"></use>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(8079,0)\">\n <use xlink:href=\"#E3-MJMAIN-2C\"></use>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(8524,0)\">\n <use xlink:href=\"#E3-MJMAIN-221E\"></use>\n</g>\n<g fill=\"red\" stroke=\"red\" transform=\"translate(9525,0)\">\n <use xlink:href=\"#E3-MJMAIN-29\"></use>\n</g>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E3-MJMAIN-2E\" x=\"24717\" y=\"0\"></use>\n</g>\n</svg></span></p>\n<p>Notice that the integral on the left-hand side is the same but we used different functions on the right. What is the difference, and how do we know which hyperbolic function to use?</p>\n<p>The difference is the domain of the variable <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.977ex\" height=\"1.676ex\" style=\"vertical-align: -0.338ex;\