coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcsch x) = -\\dfrac{1}{|x|\\sqrt{1+ x^2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{1}{3|x|\\sqrt{{x}^{2}+1}}\\,\\text{d}x=-\\frac{1}{3}\\int -\\frac{1}{|x|\\sqrt{1+{x}^{2}}}\\,\\text{d}x=-\\frac{1}{3}\\operatorname{arcsch}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166608 #edb/ref 1069 "e-8376" #edb/ref 17592186045417] [17592186166608 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\displaystyle \\int \\dfrac{3}{x\\sqrt{1-x^2}}\\,\\textrm d x=$" #edb/ref 17592186045417] [17592186166608 #edb/ref 1072 #uuid "b72eee89-1abb-5081-b89e-6cc8735b7f54" #edb/ref 17592186045417] [17592186166608 #edb/ref 1074 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arsech x) = -\\dfrac{1}{x\\sqrt{1-x^2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{3}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x=-3\\int -\\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x=-3\\operatorname{arsech}⁡x+C.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186166609 #edb/ref 1069 "e-8377" #edb/ref 17592186045417] [17592186166609 #edb/ref 1071 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nCalculate $\\displaystyle \\int \\dfrac{8}{1-x^2}\\,\\textrm d x$ for $|x|>1.$" #edb/ref 17592186045417] [17592186166609 #edb/ref 1072 #uuid "35322f22-4526-53dd-9839-83dd4c286776" #edb/ref 17592186045417] [17592186166609 #edb/ref 1074 "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcoth x) = \\dfrac{1}{1-x^2}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{8}{1-{x}^{2}}\\,\\text{d}x=8\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x=8\\operatorname{arcoth}⁡x+C.\\end{aligned}\n$$" #edb/