#{[{:db/id #edb/ref 17592186166607 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166769 :knowledge-point/id #uuid "24e9c062-13d1-5a36-ad70-f062f3765100" :knowledge-point/title "Integrating Using Arcsch"}] :question/id #uuid "3d0b8fbe-a118-5ec7-83d4-863d605bed74" :question/math-academy-id "e-8375" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\displaystyle \\int \\dfrac{1}{3|x|\\sqrt{x^2+1}}\\,\\textrm d x=$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcsch x) = -\\dfrac{1}{|x|\\sqrt{1+ x^2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{1}{3|x|\\sqrt{{x}^{2}+1}}\\,\\text{d}x=-\\frac{1}{3}\\int -\\frac{1}{|x|\\sqrt{1+{x}^{2}}}\\,\\text{d}x=-\\frac{1}{3}\\operatorname{arcsch}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166608 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166770 :knowledge-point/id #uuid "e6071303-6be5-5636-a675-66d33864a7c9" :knowledge-point/title "Integrating Using Arsech"}] :question/id #uuid "b72eee89-1abb-5081-b89e-6cc8735b7f54" :question/math-academy-id "e-8376" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\displaystyle \\int \\dfrac{3}{x\\sqrt{1-x^2}}\\,\\textrm d x=$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arsech x) = -\\dfrac{1}{x\\sqrt{1-x^2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{3}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x=-3\\int -\\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x=-3\\operatorname{arsech}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186166609 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186166771 :knowledge-point/id #uuid "1c7d3082-d63a-5eac-9a9b-47681f8d4694" :knowledge-point/title "Integrating Using Arcoth"}] :question/id #uuid "35322f22-4526-53dd-9839-83dd4c286776" :question/math-academy-id "e-8377" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nCalculate $\\displaystyle \\int \\dfrac{8}{1-x^2}\\,\\textrm d x$ for $|x|>1.$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcoth x) = \\dfrac{1}{1-x^2}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{8}{1-{x}^{2}}\\,\\text{d}x=8\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x=8\\operatorname{arcoth}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526103 :knowledge-point/_questions [{:db/id #edb/ref 17592186166769 :knowledge-point/id #uuid "24e9c062-13d1-5a36-ad70-f062f3765100" :knowledge-point/title "Integrating Using Arcsch"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "209f30d8-ac3b-576f-aed7-a0d4d6d2d4b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186525278} {:answer/id #uuid "3cad3ce7-bb9d-5f5f-9e96-c75ed81957c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ide