ledge-point/id #uuid "24e9c062-13d1-5a36-ad70-f062f3765100" :knowledge-point/title "Integrating Using Arcsch"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "252dc388-8fea-5b06-87ba-cb60ad16a662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{arcsch}⁡x+C" :db/id #edb/ref 17592186525296} {:answer/id #uuid "4c94f977-88e7-5f78-9984-26aabc6187c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186525397} {:answer/id #uuid "81098bd5-5850-52d7-8458-dc4607fc1b5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186525529} {:answer/id #uuid "965e1030-9b6f-57ec-89d5-c17086fce864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}\\operatorname{arcsch}⁡x+C" :db/id #edb/ref 17592186525591} {:answer/id #uuid "e0839dfe-72bc-522e-bc2d-ad7dc48fc9de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{2}\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186525762}] :answer-field/correct {:answer/id #uuid "252dc388-8fea-5b06-87ba-cb60ad16a662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{arcsch}⁡x+C" :db/id #edb/ref 17592186525296} :answer-field/id #uuid "8f61831d-0f8e-5d56-a606-5a5bed7d042d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525917}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e89bfa66-6d9d-5430-9f05-5264fafe0111" :question/math-academy-id "q-162676" :question/problem "$$\n\n$\\int \\frac{2\\sqrt{2}}{|x|\\sqrt{2{x}^{2}+2}}\\,\\text{d}x=$" :question/worked-solution "$$\n\nThe formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{2\\sqrt{2}}{|x|\\sqrt{2{x}^{2}+2}}\\,\\text{d}x & =\\int \\frac{2\\sqrt{2}}{|x|\\sqrt{2({x}^{2}+1)}}\\,\\text{d}x \\\\  & =-\\frac{2\\sqrt{2}}{\\sqrt{2}}\\int -\\frac{1}{|x|\\sqrt{1+{x}^{2}}}\\,\\text{d}x \\\\  & =-2\\operatorname{arcsch}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526050 :knowledge-point/_questions [{:db/id #edb/ref 17592186166770 :knowledge-point/id #uuid "e6071303-6be5-5636-a675-66d33864a7c9" :knowledge-point/title "Integrating Using Arsech"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23e79958-46b2-57a2-a340-dc5eb91bcf8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186525291} {:answer/id #uuid "2e8e3065-a886-5127-b1be-87aa0cabd3ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{arcsch}⁡x+C" :db/id #edb/ref 17592186525313} {:answer/id #uuid "d24fd412-30aa-5bfb-a8ee-aafb584baa53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186525731} {:answer/id #uuid "e9521558-08df-5e31-b4b7-f999a1a2d356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186525784} {:answer/id #uuid "f232ccea-bb5b-53b1-a455-a34bf83b009c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186525810}] :answer-field/correct {:answer/id #uuid "23e79958-46b2-57a2-a340-dc5eb91bcf8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186525291} :answer-field/id #uuid "b34d7eff-85d3-52c5-8cbd-bc62db91bf11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525934}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "87d24960-3146-517f-bb76-d6b48812abfc" :question/math-academy-id "q-162689" :question/problem "$\\int \\frac{1}{x\\sqrt{9-9{x}^{2}}}\\,\\text{d}x=$" :question/worked-solution "$$\n\nThe formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{1}{x\\sqrt{9-9{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{x\\sqrt{9(1-{x}^{2})}}\\,\\text{d}x \\\\  & =-\\frac{1}{\\sqrt{9}}\\int -\\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =-\\frac{1}{3}\\operatorname{arsech}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186525989 :knowledge-point/_questions [{:db/id #edb/ref 17592186166770 :knowledge-point/id #uuid "e6071303-6be5-5636-a675-66d33864a7c9" :knowledge-point/title "Integrating Using Arsech"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eb6f9dc-020a-50be-8eee-970120af9ac0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arcsch}⁡x+C" :db/id #edb/ref 17592186525314} {:answer/id #uuid "76c59a6d-1f04-533b-84f5-36b81b257646" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186525504} {:answer/id #uuid "95d51512-8d03-543c-af11-c4992d86e5c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186525588} {:answer/id #uuid "ad960bd8-ce89-58eb-be88-4d438909f292" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186525645} {:answer/id #uuid "bbbf9c6c-3c00-504b-ab92-cafb5a32d2be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{arcoth}⁡x+C" :db/id #edb/ref 17592186525689}] :answer-field/correct {:answer/id #uuid "76c59a6d-1f04-533b-84f5-36b81b257646" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{arsech}⁡x+C" :db/id #edb/ref 17592186525504} :answer-field/id #uuid "29f35f1e-4567-548b-8129-2114d0772b84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186525869}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1983514f-2ffa-5869-bb28-86e01bbf3b65" :question/math-academy-id "q-162691" :question/problem "$$\n\n$\\int \\frac{2}{x\\sqrt{4-4{x}^{2}}}\\,\\text{d}x=$" :question/worked-solution "$$\n\nThe formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{2}{x\\sqrt{4-4{x}^{2}}}\\,\\text{d}x & =\\int \\frac{2}{x\\sqrt{4(1-{x}^{2})}}\\,\\text{d}x \\\\  & =-\\frac{2}{2}\\int -\\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =-\\operatorname{arsech}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186526058 :knowledge-point/_questions [{:db/id #edb/ref 17592186166771 :knowledge-point/id #uuid "1c7d3082-d63a-5eac-9a9b-47681f8d4694" :knowledge-point/title "Integrating Using Arcoth"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f47a5c2-0604-57c0-a510-d655fb160fa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{arsech}⁡x+C" :db/id