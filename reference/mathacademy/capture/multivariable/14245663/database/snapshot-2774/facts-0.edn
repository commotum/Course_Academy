6045417] [17592186054914 #edb/ref 1043 #edb/ref 17592186055580 #edb/ref 17592186045417] [17592186054914 #edb/ref 1043 #edb/ref 17592186055581 #edb/ref 17592186045417] [17592186054914 #edb/ref 1043 #edb/ref 17592186055582 #edb/ref 17592186045417] [17592186054914 #edb/ref 1043 #edb/ref 17592186055583 #edb/ref 17592186045417] [17592186054914 #edb/ref 1043 #edb/ref 17592186055584 #edb/ref 17592186045417] [17592186054914 #edb/ref 1043 #edb/ref 17592186055585 #edb/ref 17592186045417] [17592186054914 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186054914 #edb/ref 1045 "The \"And\" and \"Or\" Connectives" #edb/ref 17592186045417] [17592186054914 #edb/ref 1046 #edb/ref 17592186055579 #edb/ref 17592186045417] [17592186054914 #edb/ref 1049 #edb/ref 17592186048778 #edb/ref 17592186045417] [17592186054914 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186054914 #edb/ref 1053 #uuid "4dd99c93-ce32-53a9-b191-e8bddb7f8f7f" #edb/ref 17592186045417] [17592186055037 #edb/ref 1068 #edb/ref 17592186051752 #edb/ref 17592186045417] [17592186055037 #edb/ref 1069 "q-170852" #edb/ref 17592186045417] [17592186055037 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186055037 #edb/ref 1071 "$2$ is prime, **or** $14$ is a multiple of $7$ **and** $5.$\n\nExpress the compound statement above in symbolic form given the following notations:\n\n- $R:2\\text{ is prime}$\n\n- $S:14\\text{ is a multiple of }7$\n\n- $T:14\\text{ is a multiple of }5$" #edb/ref 17592186045417] [17592186055037 #edb/ref 1072 #uuid "c3a7db47-e883-5a71-8bfd-ec843bd98b41" #edb/ref 17592186045417] [17592186055037 #edb/ref 1074 "The word \"and\" is represented by the symbol \"$∧$\", while the word \"or\" is represented by the symbol \"$∨$\".\n\nNote that this sentence consists of two parts:\n\n- **Part 1:** $2$ is prime. This corresponds to $R.$\n\n- **Part 2:** $14$ is a multiple of $7$ and $5.$ This corresponds to\n\n$$\n{{14\\text{ is a multiple of }7}_{⏟}}_{S}\\,{{\\text{and}}_{⏟}}_{∧}\\,{{14\\text{ is a multiple of }5}_{⏟}}_{T},\n$$\n\nthat is, $S∧T.$\n\nSo, we can express the sentence as\n\n$$\n{{2\\text{ is prime}}_{⏟}}_{R}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{14\\text{ is a multiple of }7\\text{ and }5}_{⏟}}_{S\\,∧\\,T},\n$$\n\nthat is, $R∨(S∧T).$" #edb/ref 17592186045417] [17592186055087 #edb/ref 1068 #edb/ref 17592186051965 #edb/ref 17592186045417] [17592186055087 #edb/ref 1068 #edb/ref 17592186051968 #edb/ref 17592186045417] [17592186055087 #edb/ref 1068 #edb/ref 17592186051971 #edb/ref 17592186045417] [17592186055087 #edb/ref 1069 "q-181713" #edb/ref 17592186045417] [17592186055087 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186055087 #edb/ref 1071 "$$\n{{2\\text{ is negative}}_{⏟}}_{A}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{0.5\\text{ is rational}}_{⏟}}_{B}\n$$\n\nFor the compound statement above, we have that\n\n$\\,$ $A$ is {{field-1}},\n$\\,$ $B$ is {{field-2}},\n$\\,$ $A∨B$ is {{field-3}}." #edb/ref 17592186045417] [17592186055087 #edb/ref 1072 #uuid "251d1784-5e7a-5d2b-9609-81be8de6d435" #edb/ref 17592186045417] [17592186055087 #edb/ref 1074 "First, let's recall the following facts about the \"and\" $(∧)$ and \"or\" $(∨)$ logical connectives:\n\n- The statement $A∧B$ is true if *both* $A$ and $B$ are true.\n\n- The statement $A∨B$ is true if either $A$ is true, or $B$ is true, or *both* $A$ and $B$ are true.\n\nIn our case, $A$ is false, and $B$ is true. Therefore, the result is true:\n\n$$\n\\begin{aligned}{{2\\text{ is negative}}_{⏟}}_{A}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{0.5\\text{ is rational}}_{⏟}}_{B} & \\,\\,≡\\,\\text{false}∨\\text{true}≡\\text{true}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186055579 #edb/ref 1058 #edb/ref 17592186055580 #edb/ref 17592186045417] [17592186055579 #edb/ref 1061 153494 #edb/ref 17592186045417] [17592186055579 #edb/ref 1062 #uuid "4a197e18-2f93-5927-89e7-71b02eeb66ff" #edb/ref 17592186045417] [17592186055579 #edb/ref 1063 #edb/ref 17592186056005 #edb/ref 17592186045417] [17592186055580 #edb/ref 1058 #edb/ref 17592186055581 #edb/ref 17592186045417] [17592186055580 #edb/ref 1061 153495 #edb/ref 17592186045417] [17592186055580 #edb/ref 1062 #uuid "9a7b96e3-5988-5977-a20a-8a97b636978b" #edb/ref 17592186045417] [17592186055580 #edb/ref 1063 #edb/ref 17592186054641 #edb/ref 17592186045417] [17592186055581 #edb/ref 1058 #edb/ref 17592186055582 #edb/ref 17592186045417] [17592186055581 #edb/ref 1061 153498 #edb/ref 17592186045417] [17592186055581 #edb/ref 1062 #uuid "c089550c-a72d-5a29-a351-4052cea239c4" #edb/ref 17592186045417] [17592186055581 #edb/ref 1063 #edb/ref 17592186054642 #edb/ref 17592186045417] [17592186055582 #edb/ref 1058 #edb/ref 17592186055583 #edb/ref 17592186045417] [17592186055582 #edb/ref 1061 153501 #edb/ref 17592186045417] [17592186055582 #edb/ref 1062 #uuid "237b49c1-2062-5a12-862e-cc6120dfe275" #edb/ref 17592186045417] [17592186055582 #edb/ref 1063 #edb/ref 17592186056029 #edb/ref 17592186045417] [17592186055583 #edb/ref 1058 #edb/ref 17592186055584 #edb/ref 17592186045417] [17592186055583 #edb/ref 1061 153502 #edb/ref 17592186045417] [17592186055583 #edb/ref 1062 #uuid "1023b546-9b0c-52d3-9454-3a5adbb094ec" #edb/ref 17592186045417] [17592186055583 #edb/ref 1063 #edb/ref 17592186056072 #edb/ref 17592186045417] [17592186055584 #edb/ref 1058 #edb/ref 17592186055585 #edb/ref 17592186045417] [17592186055584 #edb/ref 1061 153503 #edb/ref 17592186045417] [17592186055584 #edb/ref 1062 #uuid "96ad2c2e-7a64-57d5-9f83-02022e8509c3" #edb/ref 17592186045417] [17592186055584 #edb/ref 1063 #edb/ref 17592186054643 #edb/ref 17592186045417] [17592186055585 #edb/ref 1061 153506 #edb/ref 17592186045417] [17592186055585 #edb/ref 1062 #uuid "3cd4f3c8-8abb-53a5-a3a4-5df352b82883" #edb/ref 17592186045417] [17592186055585 #edb/ref 1063 #edb/ref 17592186054644 #edb/ref 17592186045417] [17592186056005 #edb/ref 1064 "A **compound statement** is a sentence that consists of two or more statements separated by logical connectors, such as the word \"and\" or the word \"or.\"\n\nFor example, the following sentence is a compound statement:\n\n$P: 2$ is an integer **and** $2$ is positive \n\nThe first statement is \"$2$ is an integer,\" and the second is \"$2$ is positive.\" These two statements are separated by the logical connector \"and.\"\n\nThe following sentence is also a compound statement:\n\n$7$ is odd **or** $7$ is even \n\nIn this case, the first statement is \"$7$ is odd,\" and the second statement is \"$7$ is even.\" These two statements are separated by the logical connector \"or.\" \n\nWe can express the logical connectives \"and\" and \"or\" using symbols:\n\n- The word \"and\" is represented by the symbol \"$\\land$\". Notice that it resembles \"A\" for \"And.\"\n\n- The word \"or\" is represented by the symbol \"$\\lor$\".\n\nLet's translate the following sentence into symbolic form:\n\n$2$ is an integer **and** $2$ is positive \n\nTo start, we introduce the letters $A$ and $B$ to denote each individual statement:\n\n- $A:$ $2$ is an integer\n\n- $B:$  $2$ is positive\n\nThen, our sentence becomes\n\n$$\n\\underbrace{2 \\vphantom{p}\\textrm{ is an integer} }_A \\quad \\underbrace{\\vphantom{p}\\textrm{and}}_{\\land} \\quad \\underbrace{2 \\vphantom{p}\\textrm{ is positive} }_B,\n$$\n\nthat is, $A \\land B.$\n\nFinally, note the following terminology:\n\n- The statement \"$P$ and $Q$\" is called the **conjunction** of the statements $P$ and $Q.$\n\n- The statement \"$P$ or $Q$\" is called the **disjunction** of the statements $P$ and $Q.$" #edb/ref 17592186045417] [17592186056005 #edb/ref 1065 7962 #edb/ref 17592186045417] [17592186056005 #edb/ref 1066 #uuid "4570766f-a355-5a80-9756-cd94d76fed9c" #edb/ref 17592186045417] [17592186056005 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186056029 #edb/ref 1064 "Let's now consider the truth values of the logical connector \"and\". We have the following key idea:\n\n*The statement $A \\land B$ is true if $A$ is true **and** $B$ is true. Otherwise, it is false.* \n\nLet's determine the truth values of the following compound statement:\n\n$2$ is positive **and** $2$ is even.\n\nWriting this in symbols, we have the following:\n\n$$\n\\begin{aligned}{{2\\text{ is positive}}_{⏟}}_{A}\\,{{\\text{and}}_{⏟}}_{∧}\\,{{2\\text{ is even}}_{⏟}}_{B}\\end{aligned}\n$$\n\nor, simply\n\n$$\nA\\land B.\n$$\n\nSince $A$ is true and $B$ is true, this compound statement is true:\n\n$$\n\\begin{aligned}A∧B≡\\text{true}∧\\text{true}≡\\text{true}\\end{aligned}\n$$\n\nIn this context, the symbol \"$\\equiv$\" means \"is logically equivalent to.\" \n\nLet's now consider a similar compound statement but with the $2$ replaced with a $3$ in the second statement.\n\n$$\n\\begin{aligned}{{2\\text{ is positive}}_{⏟}}_{A}\\,{{\\text{and}}_{⏟}}_{∧}\\,{{3\\text{ is even}}_{⏟}}_{C}\\end{aligned}\n$$\n\nWe can write this symbolically as follows:\n\n$$\nA\\land C\n$$\n\nSince $A$ is true and $C$ is false, this compound statement is false:\n\n$$\n\\begin{aligned}A∧C≡\\text{true}∧\\text{false}≡\\text{false}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186056029 #edb/ref 1065 8142 #edb/ref 17592186045417] [17592186056029 #edb/ref 1066 #uuid "e16d77df-210e-5934-90ce-44b096916261" #edb/ref 17592186045417] [17592186056029 #edb/ref 1067 "Truth Values of Statements Containing the \"And\" Connective" #edb/ref 17592186045417] [17592186056072 #edb/ref 1064 "Let's now consider the truth values of the logical connector \"or\". We have the following key idea:\n\n*The statement $A \\lor B$ is true if $A$ is true, or $B$ is true, or both $A$ and $B$ are true. Otherwise, it is false.* \n\nLet's consider some examples:\n\n- First, consider the following statement:\n\n$$\n\\begin{aligned}{{2\\text{ is positive}}_{⏟}}_{A}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{2\\text{ is even}}_{⏟}}_{B}\\end{aligned}\n$$\n\nSince $A$ is true and $B$ is true, this compound statement is true:\n\n$$\n\\begin{aligned}A∨B≡\\text{true}∨\\text{true}≡\\text{true}\\end{aligned}\n$$\n\n- Next, consider the following statement:\n\n$$\n\\begin{aligned}{{2\\text{ is positive}}_{⏟}}_{A}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{3\\text{ is even}}_{⏟}}_{C}\\end{aligned}\n$$\n\nSince $A$ is true, this compound statement is true:\n\n$$\n\\begin{aligned}A∨C≡\\text{true}∨\\text{false}≡\\text{true}\\end{aligned}\n$$\n\n- Now, consider the following:\n\n$$\n\\begin{aligned}{{-2\\text{ is positive}}_{⏟}}_{D}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{2\\text{ is even}}_{⏟}}_{B}\\end{aligned}\n$$\n\nSince $B$ is true, this compound statement is true:\n\n$$\n\\begin{aligned}D∨B≡\\text{false}∨\\text{true}≡\\text{true}\\end{aligned}\n$$\n\n- Finally, consider the following:\n\n$$\n\\begin{aligned}{{-2\\text{ is positive}}_{⏟}}_{D}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{3\\text{ is even}}_{⏟}}_{C}\\end{aligned}\n$$\n\nSince $D$ and $C$ are both false, this compound statement is false:\n\n$$\n\\begin{aligned}D∨C≡\\text{false}∨\\text{false}≡\\text{false}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186056072 #edb/ref 1065 9044 #edb/ref 17592186045417] [17592186056072 #edb/ref 1066 #uuid "3b0d24cd-f605-59b2-9f16-f053e9b74e8a" #edb/ref 17592186045417] [17592186056072 #edb/ref 1067 "Truth Values of Statements Containing the \"Or\" Connective" #edb/ref 17592186045417] [17592186379005 #edb/ref 1068 #edb/ref 17592186379006 #edb/ref 17592186045417] [17592186379005 #edb/ref 1068 #edb/ref 17592186379009 #edb/ref 17592186045417] [17592186379005 #edb/ref 1068 #edb/ref 17592186379012 #edb/ref 17592186045417] [17592186379005 #edb/ref 1069 "q-175909" #edb/ref 17592186045417] [17592186379005 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186379005 #edb/ref 1071 "$$\n{{\\sqrt{2}\\text{ is irrational}}_{⏟}}_{A}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{1-2=1}_{⏟}}_{B}\n$$\n\nFor the compound statement above, we have that\n\n$\\,$ $A$ is {{field-1}},\n$\\,$ $B$ is {{field-2}},\n$\\,$ $A∨B$ is {{field-3}}." #edb/ref 17592186045417] [17592186379005 #edb/ref 1072 #uuid "b8a204fe-0678-5217-8fd6-73d54f821b1b" #edb/ref 17592186045417] [17592186379005 #edb/ref 1074 "First, let's recall the following facts about the \"and\" $(∧)$ and \"or\" $(∨)$ logical connectives:\n\n- The statement $A∧B$ is true if *both* $A$ and $B$ are true.\n\n- The statement $A∨B$ is true if either $A$ is true, or $B$ is true, or *both* $A$ and $B$ are true.\n\nIn our case, $A$ is true, and $B$ is false. Therefore, the result is true:\n\n$$\n\\begin{aligned}{{\\sqrt{2}\\text{ is irrational}}_{⏟}}_{A}\\,{{\\text{or}}_{⏟}}_{∨}\\,{{1-2=1}_{⏟}}_{B} & \\,\\,≡\\,\\text{true}∨\\text{false}≡\\text{true}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186379006 #edb/ref 1075 #edb/ref 17592186379007 #edb/ref 17592186045417] [17592186379006 #edb/ref 1075 #edb/ref 17592186379008 #edb/ref 17592186045417] [17592186379006 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186379006 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186379006 #edb/ref 1078 #edb/ref 17592186379008 #edb/ref 17592186045417] [17592186379006 #edb/ref 1079 #uuid "a73e4d24-a544-5df8-926d-0dd2efcec4c1" #edb/ref 17592186045417] [17592186379007 #edb/ref 1080 "false" #edb/ref 17592186045417] [17592186379007 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186379007 #edb/ref 1083 #uuid "398dfebf-2715-5754-8536-2fbf57b13ec2" #edb/ref 17592186045417] [17592186379008 #edb/ref 1080 "true" #edb/ref 17592186045417] [17592186379008 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186379008 #edb/ref 1083 #uuid "6bbd595e-8862-5ddd-ad65-9bbe8a1503d9" #edb/ref 17592186045417] [17592186379009 #edb/ref 1075 #edb/ref 17592186379010 #edb/ref 17592186045417] [17592186379009 #edb/ref 1075 #edb/ref 17592186379011 #edb/ref 17592186045417] [17592186379009 #edb/ref 1076 #edb/ref 17592186045494 #edb/ref 17592186045417] [17592186379009 #edb/ref 1077 "field-3" #edb/ref 17592186045417] [17592186379009 #edb/ref 1078 #edb/ref 17592186379011 #edb/ref 17592186045417] [17592186379009 #edb/ref 1079 #uuid "8de5b0f9-3915-