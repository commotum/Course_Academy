      ],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14200586/observations/step-q163644-91c7733a22d714b434dd.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14200586/observations/step-q163644-91c7733a22d714b434dd.png",
      "source_url": "https://mathacademy.com/tasks/14200586/topics/4173/review",
      "captured_at": 1791983399.9136028,
      "math_academy_id": "q-163644",
      "topic_id": "4173",
      "sequence_position": null,
