  "live_records": {
    "q-213398": {
      "dom_id": "step-q213398",
      "name": "Question 1",
      "problem": "Select the correct options in the reasoning below.\n\nThe integer $15$ \n{{field-1}}\na multiplicative inverse modulo $17$ since {{field-2}}{{field-3}}.",
      "worked_solution": "An integer $a$ has the multiplicative inverse modulo $n$ if and only if $a$ and $n$ are coprime, i.e., $\\text{gcd}(a,n)=1.$\n\nIn our case, $a=15$ and $n=17.$ So, we have\n\n$$\n\\text{gcd}(15,17)=1.\n$$\n\nTherefore, we conclude the following:\n\nThe integer $15$ $\\text{has}$ the multiplicative inverse modulo $17$ since $\\text{gcd}(15,17)$ $=1.$",
      "calculator_instructions": "",
