ut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable><mjx-tstrut></mjx-tstrut></mjx-mtd></mjx-mtr></mjx-itable></mjx-table></mjx-mtable></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mtable displaystyle=\"true\" columnalign=\"right\" columnspacing=\"\" rowspacing=\"3pt\"><mtr><mtd><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mstyle mathcolor=\"red\"><mn>75</mn></mstyle></mtd><mtd><mo>=</mo></mtd><mtd><mstyle mathcolor=\"red\"><mn>22</mn><mo>⋅</mo><mn>3</mn></mstyle></mtd><mtd><mo>+</mo></mtd><mtd><mstyle mathcolor=\"red\"><mn>9</mn></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo stretchy=\"false\">↙</mo></mtd><mtd></mtd><mtd><mo stretchy=\"false\">↙</mo></mtd><mtd></mtd></mtr><mtr><mtd><mstyle mathcolor=\"blue\"><mn>22</mn></mstyle></mtd><mtd><mo>=</mo></mtd><mtd><mstyle mathcolor=\"blue\"><mn>9</mn><mo>⋅</mo><mn>2</mn></mstyle></mtd><mtd><mo>+</mo></mtd><mtd><mstyle mathcolor=\"blue\"><mn>4</mn></mstyle></mtd></mtr><mtr><mtd></mtd><mtd><mo stretchy=\"false\">↙</mo></mtd><mtd></mtd><mtd><mo stretchy=\"false\">↙</mo></mtd><mtd></mtd></mtr><mtr><mtd><mstyle mathcolor=\"black\"><mn>9</mn></mstyle></mtd><mtd><mo>=</mo></mtd><mtd><mstyle mathcolor=\"black\"><mn>4</mn><mo>⋅</mo><mn>2</mn></mstyle></mtd><mtd><mo>+</mo></mtd><mtd><mstyle mathcolor=\"black\"><mn>1</mn></mstyle></mtd></mtr></mtable></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container> </p>\n<p>Solving for the rightmost terms in the equations above, we get</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"309\" style=\"font-size: 113.1%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 6.278em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: