-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow><mo>∗</mo></msup></math></mjx-assistive-mml></mjx-container> is \n<div id=\"selectList-335667-5\" class=\"selectList\" style=\"margin: 0px 4px 2px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-335667-5\" style=\"width: 177px; height: 17px; line-height: 17px;\">an unstable</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 624px; top: 26289px;\"><div class=\"selectListOption\" style=\"height: 17px;\">an asymptotically stable</div><div class=\"selectListOption selected\" style=\"height: 17px;\">an unstable</div><div class=\"selectListOption\" style=\"height: 17px;\">a stable</div></div></div><div id=\"selectList-335667-6\" class=\"selectList\" style=\"margin: 0px 2px 2px 4px;\"><div class=\"selectListFrameDisabled correctSelection\" id=\"selectListFrame-335667-6\" style=\"width: 63px; height: 17px; line-height: 17px;\">saddle</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1; left: 825px; top: 26289px;\"><div class=\"selectListOption\" style=\"height: 17px;\">center</div><div class=\"selectListOption\" style=\"height: 17px;\">sink</div><div class=\"selectListOption\" style=\"height: 17px;\">source</div><div class=\"selectListOption selected\" style=\"height: 17px;\">saddle</div></div></div>.</span></div><div class=\"questionWidget-buttonBar\"><div class=\"questionWidget-submitButton disabledButton\" style=\"display: none;\">Submit</div></div><div class=\"questionWidget-spinnerFrame\"><div class=\"questionWidget-spinner\" style=\"display: block;\"></div></div><div class=\"questionWidget-result\"><div class=\"questionWidget-correctIncorrectIcon\"><img src=\"/img/green-checkmark.png\"></div><div class=\"questionWidget-correctText\">Correct</div></div><div class=\"ques