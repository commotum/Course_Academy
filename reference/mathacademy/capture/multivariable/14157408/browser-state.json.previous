      "assets": [],
      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14157408/observations/step-q335667-9d29af3558241121fc1c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14157408/observations/step-q335667-9d29af3558241121fc1c.png",
      "source_url": "https://mathacademy.com/tasks/14157408/topics/3231/lesson",
