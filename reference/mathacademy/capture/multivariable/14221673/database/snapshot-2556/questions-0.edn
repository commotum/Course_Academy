#{[{:db/id #edb/ref 17592186535055 :knowledge-point/_questions [{:db/id #edb/ref 17592186083341 :knowledge-point/id #uuid "cab29074-3281-5c02-9a2b-423077675aef" :knowledge-point/title "Applying the Root Test in Divergent and Inconclusive Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6199dc51-e96e-5636-83f2-2579cabce364" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{1}{8}.$ The series is convergent." :db/id #edb/ref 17592186534464} {:answer/id #uuid "6c253c48-5507-56d5-9451-af7ca3386fc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{5}{4}.$ The series is divergent." :db/id #edb/ref 17592186534490} {:answer/id #uuid "73785847-2f06-56d2-b76c-2efa341aaff5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\infty .$ The series is divergent." :db/id #edb/ref 17592186534512} {:answer/id #uuid "9c49c143-d35a-594e-8e97-d80bb0c9ac82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=1.$ The root test gives no conclusion." :db/id #edb/ref 17592186534612} {:answer/id #uuid "c5e371ec-a315-5c84-89a5-b0df5f32e35f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=10.$ The series is divergent." :db/id #edb/ref 17592186534708}] :answer-field/correct {:answer/id #uuid "6c253c48-5507-56d5-9451-af7ca3386fc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{5}{4}.$ The series is divergent." :db/id #edb/ref 17592186534490} :answer-field/id #uuid "5ff32e85-d602-5a3e-9ef1-a2d2944e6ae0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534888}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af92a5d6-20ee-53fa-be9c-28e2a23392fd" :question/math-academy-id "q-139038" :question/problem "Calculate $L={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}$ for the sequence ${a}_{n}=\\frac{(10n)^{n}n}{(8n+1)^{n}}.$ According to the root test, does ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge?" :question/worked-solution "Suppose we have the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ such that ${a}_{n}\\ge 0$ for all $n\\ge 1,$ and that $L$ is defined as  \n\n$$\nL={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}={lim}_{n\\to \\infty }{({a}_{n})}^{1/n}.\n$$\n\n \n\nThen, the root test states the following:\n\n- If $L<1$, the series converges.\n\n- If $L>1$ or $L=\\infty $, the series diverges.\n\n- If $L=1$, the root test is inconclusive.\n\nWe have the sequence ${a}_{n},$ defined as\n\n$$\n{a}_{n}=\\frac{(10n)^{n}n}{(8n+1)^{n}}.\n$$\n\nTo apply the root test, we find the limit of $\\sqrt[n]{{a}_{n}}$ as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}} \\\\  & ={lim}_{n\\to \\infty }{({a}_{n})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }{(\\frac{(10n)^{n}n}{(8n+1)^{n}})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }(\\frac{10n\\sqrt[n]{n}}{8n+1}) \\\\  & ={lim}_{n\\to \\infty }\\frac{10n\\sqrt[n]{n}}{n(8+\\frac{1}{n})} \\\\  & ={lim}_{n\\to \\infty }\\frac{10\\sqrt[n]{n}}{(8+\\frac{1}{n})} \\\\  & =\\frac{10\\cdot 1}{8+0} \\\\  & =\\frac{5}{4}\\end{aligned}\n$$\n\nNote that we used the fact that\n\n$$\n{lim}_{n\\to \\infty }\\sqrt[n]{n}=1.\n$$\n\nSince $L=\\frac{5}{4}>1,$ the series diverges by the root test."}] [{:db/id #edb/ref 17592186534979 :knowledge-point/_questions [{:db/id #edb/ref 17592186083341 :knowledge-point/id #uuid "cab29074-3281-5c02-9a2b-423077675aef" :knowledge-point/title "Applying the Root Test in Divergent and Inconclusive Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a5894b-ca93-559e-9241-c70e09cfcc05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\infty .$ The series is divergent." :db/id #edb/ref 17592186534279} {:answer/id #uuid "0b0efef7-ea22-56c7-ac43-7422add3b46d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=1.$ The series is divergent." :db/id #edb/ref 17592186534287} {:answer/id #uuid "4f4a5642-c9e9-5168-8482-b21e873612c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{1}{9}.$ The series is convergent." :db/id #edb/ref 17592186534420} {:answer/id #uuid "7c46e210-d2d6-55e4-892f-4ca85507253f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=1.$ The root test gives no conclusion." :db/id #edb/ref 17592186534533} {:answer/id #uuid "a5779aa3-3102-5b67-aa38-f2aff312d456" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=5.$ The series is divergent." :db/id #edb/ref 17592186534636}] :answer-field/correct {:answer/id #uuid "7c46e210-d2d6-55e4-892f-4ca85507253f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=1.$ The root test gives no conclusion." :db/id #edb/ref 17592186534533} :answer-field/id #uuid "f5cf7d5d-3952-5581-beaf-679fd852cabd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534965}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0f1fd02c-d7d8-5411-85bd-473d05c64e92" :question/math-academy-id "q-14951" :question/problem "Calculate $L={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}$ for the sequence ${a}_{n}=\\frac{{5}^{n}{n}^{n+1}}{(9+5n)^{n}}.$ According to the root test, does ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge?" :question/worked-solution "Suppose we have the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ such that ${a}_{n}\\ge 0$ for all $n\\ge 1,$ and that $L$ is defined as  \n\n$$\nL={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}={lim}_{n\\to \\infty }{({a}_{n})}^{1/n}.\n$$\n\n \n\nThen, the root test states the following:\n\n- If $L<1$, the series converges.\n\n- If $L>1$ or $L=\\infty $, the series diverges.\n\n- If $L=1$, the root test is inconclusive.\n\nWe have the sequence ${a}_{n},$ defined as\n\n$$\n{a}_{n}=\\frac{{5}^{n}{n}^{n+1}}{(9+5n)^{n}}.\n$$\n\nTo apply the root test, we find the limit of $\\sqrt[n]{{a}_{n}}$ as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}} \\\\  & ={lim}_{n\\to \\infty }{({a}_{n})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }{(\\frac{{5}^{n}{n}^{n+1}}{(9+5n)^{n}})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }{(\\frac{{5}^{n}{n}^{n}\\cdot n}{(9+5n)^{n}})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }\\frac{5n\\sqrt[n]{n}}{9+5n} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\sqrt[n]{n}\\cdot \\frac{5n}{n})}{(\\frac{9}{n}+\\frac{5n}{n})} \\\\  & ={lim}_{n\\to \\infty }\\frac{5\\sqrt[n]{n}}{(\\frac{9}{n}+5)} \\\\  & =\\frac{5\\cdot 1}{0+5} \\\\  & =\\frac{5}{5} \\\\  & =1\\end{aligned}\n$$\n\nNote that we used the fact that\n\n$$\n{lim}_{n\\to \\infty }\\sqrt[n]{n}=1.\n$$\n\nSince $L=1,$ the root test gives no conclusion."}] [{:db/id #edb/ref 17592186535069 :knowledge-point/_questions [{:db/id #edb/ref 17592186083341 :knowledge-point/id #uuid "cab29074-3281-5c02-9a2b-423077675aef" :knowledge-point/title "Applying the Root Test in Divergent and Inconclusive Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a6ce84e-109c-502d-ae75-00961ce9ff86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{6}{5}.$ The series is divergent." :db/id #edb/ref 17592186534283} {:answer/id #uuid "50b57e3f-e86f-5664-a7b4-68a0717a38e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\infty .$ The series is divergent." :db/id #edb/ref 17592186534425} {:answer/id #uuid "667a0c54-51d8-5adb-87dd-0040efd8d40d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=6.$ The series is divergent." :db/id #edb/ref 17592186534472} {:answer/id #uuid "a01506fd-1477-5630-b72b-044bad1929cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=1.$ The root test gives no conclusion." :db/id #edb/ref 17592186534627} {:answer/id #uuid "c8f6e974-a325-5bc8-805b-63f27f6b2359" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{5}{6}.$ The series is convergent." :db/id #edb/ref 17592186534719}] :answer-field/correct {:answer/id #uuid "0a6ce84e-109c-502d-ae75-00961ce9ff86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{6}{5}.$ The series is divergent." :db/id #edb/ref 17592186534283} :answer-field/id #uuid "88aae151-d533-504a-94e6-0bbe62cec52b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534903}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d497f3f8-01e4-568d-82c0-af0842ace04d" :question/math-academy-id "q-14954" :question/problem "Calculate $L={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}$ for the sequence ${a}_{n}=\\frac{{6}^{n}}{{5}^{n}{n}^{6}}.$ According to the root test, does ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge?" :question/worked-solution "Suppose we have the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ such that ${a}_{n}\\ge 0$ for all $n\\ge 1,$ and that $L$ is defined as  \n\n$$\nL={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}={lim}_{n\\to \\infty }{({a}_{n})}^{1/n}.\n$$\n\n \n\nThen, the root test states the following:\n\n- If $L<1$, the series converges.\n\n- If $L>1$ or $L=\\infty $, the series diverges.\n\n- If $L=1$, the root test is inconclusive.\n\nWe have the sequence ${a}_{n},$ defined as\n\n$$\n{a}_{n}=\\frac{{6}^{n}}{{5}^{n}{n}^{6}}.\n$$\n\nTo apply the root test, we find the limit of $\\sqrt[n]{{a}_{n}}$ as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}} \\\\  & ={lim}_{n\\to \\infty }{({a}_{n})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }{(\\frac{{6}^{n}}{{5}^{n}{n}^{6}})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }(\\frac{6}{5\\cdot \\sqrt[n]{{n}^{6}}}) \\\\  & =\\frac{6}{5}{lim}_{n\\to \\infty }{(\\frac{1}{\\sqrt[n]{n}})}^{6} \\\\  & =\\frac{6}{5}\\cdot {1}^{6} \\\\  & =\\frac{6}{5}\\end{aligned}\n$$\n\nNote that we used the fact that\n\n$$\n{lim}_{n\\to \\infty }\\sqrt[n]{n}=1.\n$$\n\nSince $L=\\frac{6}{5}>1,$ the series diverges by the root test."}] [{:db/id #edb/ref 17592186534998 :knowledge-point/_questions [{:db/id #edb/ref 17592186083340 :knowledge-point/id #uuid "469975d9-f2a2-5e3e-9f26-cee3557cb88a" :knowledge-point/title "Applying the Root Test to a Convergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fe33770-f073-58ae-98ff-6550e980a4f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{1}{3}.$ The series is convergent." :db/id #edb/ref 17592186534386} {:answer/id #uuid "4c4501bf-5593-532c-b1be-a42d350ce985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{1}{9}.$ The series is convergent." :db/id #edb/ref 17592186534413} {:answer/id #uuid "b18e1a27-a6d5-5ac9-936a-fb892b199757" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\infty .$ The series is divergent." :db/id #edb/ref 17592186534662} {:answer/id #uuid "ce352136-40a5-50fe-a545-036a2a82efb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=3.$ The series is divergent." :db/id #edb/ref 17592186534727} {:answer/id #uuid "e0b64790-21c2-5f37-b2cc-33801393cf8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=0.$ The series is convergent." :db/id #edb/ref 17592186534765}] :answer-field/correct {:answer/id #uuid "e0b64790-21c2-5f37-b2cc-33801393cf8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=0.$ The series is convergent." :db/id #edb/ref 17592186534765} :answer-field/id #uuid "d3052d66-0697-5930-85f9-c584087760e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534948}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a25fcb4-6a85-5416-8ab8-d6107a3d8b17" :question/math-academy-id "q-6022" :question/problem "Calculate $L={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}$ for the sequence ${a}_{n}=\\frac{{n}^{n/2}}{3{n}^{{n}^{2}}}.$ Does ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge?" :question/worked-solution "Suppose we have the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ such that ${a}_{n}\\ge 0$ for all $n\\ge 1,$ and that $L$ is defined as  \n\n$$\nL={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}={lim}_{n\\to \\infty }{({a}_{n})}^{1/n}.\n$$\n\n \n\nThen, the root test states the following:\n\n- If $L<1$, the series converges.\n\n- If $L>1$ or $L=\\infty $, the series diverges.\n\n- If $L=1$, the root test is inconclusive.\n\nWe have the sequence ${a}_{n},$ defined as\n\n$$\n{a}_{n}=\\frac{{n}^{n/2}}{3{n}^{{n}^{2}}}.\n$$\n\nTo apply the root test, we find the limit of $\\sqrt[n]{{a}_{n}}$ as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}} \\\\  & ={lim}_{n\\to \\infty }{({a}_{n})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }{(\\frac{{n}^{n/2}}{3{n}^{{n}^{2}}})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }\\frac{\\sqrt{n}}{\\sqrt[n]{3}\\cdot {n}^{n}} \\\\  & ={lim}_{n\\to \\infty }\\sqrt[n]{\\frac{1}{3}}\\cdot \\frac{1}{{n}^{n-1/2}} \\\\  & =1\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nNote that we used the fact that\n\n$$\n{lim}_{n\\to \\infty }\\sqrt[n]{\\frac{1}{3}}=1.\n$$\n\nSince $L=0<1,$ the series converges by the root test."}] [{:db/id #edb/ref 17592186534994 :knowledge-point/_questions [{:db/id #edb/ref 17592186083340 :knowledge-point/id #uuid "469975d9-f2a2-5e3e-9f26-cee3557cb88a" :knowledge-point/title "Applying the Root Test to a Convergent Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47795a6f-f09c-5ce0-8648-0dda3b3866d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{11}{7}.$ The series is divergent." :db/id #edb/ref 17592186534400} {:answer/id #uuid "59da41e9-24a6-5453-ad33-2fd47886a1f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{1}{49}.$ The series is convergent." :db/id #edb/ref 17592186534446} {:answer/id #uuid "a9c65a76-4ede-5228-964c-67fc95c51b32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=0.$ The series is convergent." :db/id #edb/ref 17592186534643} {:answer/id #uuid "d58740e8-ed0f-5cea-b77a-0df6635012b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\infty .$ The series is divergent." :db/id #edb/ref 17592186534745} {:answer/id #uuid "db748b8f-576e-5783-80b0-1618e62a128d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{1}{7}.$ The series is convergent." :db/id #edb/ref 17592186534759}] :answer-field/correct {:answer/id #uuid "a9c65a76-4ede-5228-964c-67fc95c51b32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=0.$ The series is convergent." :db/id #edb/ref 17592186534643} :answer-field/id #uuid "d64a5913-6f1a-5c6e-88a9-5daa0337d7b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534951}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "30cdb164-81fa-5575-aede-39cb02771ca3" :question/math-academy-id "q-6027" :question/problem "Calculate $L={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}$ for the sequence ${a}_{n}=\\frac{{11}^{n}}{{7}^{n}\\cdot n!}.$ Does ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge?" :question/worked-solution "Suppose we have the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ such that ${a}_{n}\\ge 0$ for all $n\\ge 1,$ and that $L$ is defined as  \n\n$$\nL={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}={lim}_{n\\to \\infty }{({a}_{n})}^{1/n}.\n$$\n\n \n\nThen, the root test states the following:\n\n- If $L<1$, the series converges.\n\n- If $L>1$ or $L=\\infty $, the series diverges.\n\n- If $L=1$, the root test is inconclusive.\n\nWe have the sequence ${a}_{n},$ defined as\n\n$$\n{a}_{n}=\\frac{{11}^{n}}{{7}^{n}\\cdot n!}.\n$$\n\nTo apply the root test, we find the limit of $\\sqrt[n]{{a}_{n}}$ as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}} \\\\  & ={lim}_{n\\to \\infty }{({a}_{n})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }{(\\frac{{11}^{n}}{{7}^{n}\\cdot n!})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }(\\frac{11}{7\\cdot \\sqrt[n]{n!}}) \\\\  & =\\frac{11}{7}{lim}_{n\\to \\infty }\\sqrt[n]{\\frac{1}{n!}} \\\\  & =\\frac{11}{7}\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nNote that we used the fact that\n\n$$\n{lim}_{n\\to \\infty }\\sqrt[n]{\\frac{1}{n!}}=0.\n$$\n\nSince $L=0<1,$ the series converges by the root test."}]}
