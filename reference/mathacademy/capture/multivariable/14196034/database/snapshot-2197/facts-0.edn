db/ref 17592186045417] [17592186510340 #edb/ref 1079 #uuid "c715942c-d2c2-5b4c-ae37-5167cb54c7d2" #edb/ref 17592186045417] [17592186510357 #edb/ref 1075 #edb/ref 17592186509912 #edb/ref 17592186045417] [17592186510357 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186510357 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186510357 #edb/ref 1078 #edb/ref 17592186509912 #edb/ref 17592186045417] [17592186510357 #edb/ref 1079 #uuid "f24f971e-0879-530e-bc3b-f3a08731a8aa" #edb/ref 17592186045417] [17592186510396 #edb/ref 1068 #edb/ref 17592186510271 #edb/ref 17592186045417] [17592186510396 #edb/ref 1068 #edb/ref 17592186510321 #edb/ref 17592186045417] [17592186510396 #edb/ref 1068 #edb/ref 17592186510334 #edb/ref 17592186045417] [17592186510396 #edb/ref 1068 #edb/ref 17592186510357 #edb/ref 17592186045417] [17592186510396 #edb/ref 1069 "q-335133" #edb/ref 17592186045417] [17592186510396 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186510396 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=4x(t)+{y}^{2}(t) \\\\ {y}^{′}(t)={x}^{2}(t)-5y(t)\\end{aligned}\n$$\n\nConsider the system of differential equations above. What is the corresponding linearized system at the equilibrium point ${x}^{∗}=[0,\\text{ }0]^{T}?$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">${u}^{′}=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"50px\">{{field-1}}</td>\n<td align=\"center\" width=\"50px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,u,\\,$ where $u=x-{x}^{∗}$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" #edb/ref 17592186045417] [17592186510396 #edb/ref 1072 #uuid "59916f2b-317a-58b9-929b-11913732d3cd" #edb/ref 17592186045417] [17592186510396 #edb/ref 1074 "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $\\text{\\boldsymbol}f(x)=[\\begin{aligned}4x+{y}^{2} \\\\ {x}^{2}-5y\\end{aligned}].$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(4x+{y}^{2})=4,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(4x+{y}^{2})=2y \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({x}^{2}-5y)=2x,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({x}^{2}-5y)=-5\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}4 & 2y \\\\ 2x & -5\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=[\\begin{aligned}4 & 2(0) \\\\ 2(0) & -5\\end{aligned}]=[\\begin{aligned}4 & 0 \\\\ 0 & -5\\end{aligned}].\n$$\n\nFinally, near the equilibrium, the nonlinear system is approximated by\n\n$$\n{u}^{′}=[\\begin{aligned}4 & 0 \\\\ 0 & -5\\end{aligned}]u,\n$$\n\nwhere the deviation vector is\n\n$$\nu=x-{x}^{∗}=[\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}0 \\\\ 0\\end{aligned}]=[\\begin{aligned}x \\\\ y\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186510419 #edb/ref 1068 #edb/ref 17592186510333 #edb/ref 17592186045417] [17592186510419 #edb/ref 1068 #edb/ref 17592186510340 #edb/ref 17592186045417] [17592186510419 #edb/ref 1069 "q-336954" #edb/ref 17592186045417] [17592186510419 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186510419 #edb/ref 1071 "$$\n\\{\\begin{aligned}{x}^{′}(t)=xy-{y}^{2}-1 \\\\ {y}^{′}(t)=-{x}^{2}-{y}^{2}+5\\end{aligned}\n$$\n\nConsider the system of differential equations above. What is the behavior of the system’s solutions near the equilibrium ${x}^{∗}={[2,\\text{ }1]}^{T}?$\n\n$\\,$\nThe equilibrium is an  \n{{field-1}}{{field-2}}." #edb/ref 17592186045417] [17592186510419 #edb/ref 1072 #uuid "83d63d6d-d88e-5a5d-adf3-8972165ae385" #edb/ref 17592186045417] [17592186510419 #edb/ref 1074 "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and \n$\\text{\\boldsymbol}f(x)=[\\begin{aligned}xy-{y}^{2}-1 \\\\ -{x}^{2}-{y}^{2}+5\\end{aligned}].$\n\nWe need to compute the Jacobian matrix (or the total derivative) of $\\text{\\boldsymbol}f(x).$\n\nIn our case, we have the following:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}].\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(xy-{y}^{2}-1)=y \\\\ \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(xy-{y}^{2}-1)=x-2y \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(-{x}^{2}-{y}^{2}+5)=-2x \\\\ \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(-{x}^{2}-{y}^{2}+5)=-2y\\end{aligned}\n$$\n\nThus, we have:\n\n$$\n\\text{\\boldsymbol}{f}^{′}(x)=[\\begin{aligned}y & x-2y \\\\ -2x & -2y\\end{aligned}].\n$$\n\nNow, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}2 \\\\ 1\\end{aligned}]$ to get\n\n$$\n\\text{\\boldsymbol}{f}^{′}({x}^{∗})=[\\begin{aligned}(1) & 2-2(1) \\\\ -2(2) & -2(1)\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ -4 & -2\\end{aligned}].\n$$\n\nNotice that the matrix is invertible (its determinant is not zero), so the system is almost linear at ${x}^{∗}.$\n\nTo find the eigenvalues of the Jacobian matrix, we write down the characteristic equation:\n\n$$\n\\begin{aligned}|\\begin{aligned}1-\\lambda  & 0 \\\\ -4 & -2-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(-2-\\lambda ) & =0 \\\\ {\\lambda }^{2}+\\lambda -2 & =0\\end{aligned}\n$$\n\nSolving the equation, we get the eigenvalues ${\\lambda }_{1,2}=-2,1.$\n\nFinally, since we have two real eigenvalues with opposite signs, our equilibrium is an $\\text{unstable}$ $\\text{saddle}.$" #edb/ref 17592186045417] [17592186510488 #edb/ref 1058 #edb/ref 17592186510515 #edb/ref 17592186045417] [17592186510488 #edb/ref 1062 #uuid "2cb4bb92-6182-5d82-adf8-726f3c1f7eaa" #edb/ref 17592186045417] [17592186510488 #edb/ref 1063 #edb/ref 17592186368143 #edb/ref 17592186045417] [17592186510493 #edb/ref 1058 #edb/ref 17592186510557 #edb/ref 17592186045417] [17592186510493 #edb/ref 1062 #uuid "372bc3a9-4bde-54ec-8f9c-e9a568ca29f6" #edb/ref 17592186045417] [17592186510493 #edb/ref 1063 #edb/ref 17592186510419 #edb/ref 17592186045417] [17592186510515 #edb/ref 1058 #edb/ref 17592186510520 #edb/ref 17592186045417] [17592186510515 #edb/ref 1062 #uuid "70dd2bb3-126f-59ed-855a-f46120b28c5e" #edb/ref 17592186045417] [17592186510515 #edb/ref 1063 #edb/ref 17592186510396 #edb/ref 17592186045417] [17592186510520 #edb/ref 1058 #edb/ref 17592186510493 #edb/ref 17592186045417] [17592186510520 #edb/ref 1062 #uuid "819b91a6-5d0d-5137-8403-162591cc718d" #edb/ref 17592186045417] [17592186510520 #edb/ref 1063 #edb/ref 17592186368175 #edb/ref 17592186045417] [17592186510557 #edb/ref 1062 #uuid "ecc8f232-f4d0-52b1-8514-442214380c29" #edb/ref 17592186045417] [17592186510557 #edb/ref 1063 #edb/ref 17592186368201 #edb/ref 17592186045417]}
