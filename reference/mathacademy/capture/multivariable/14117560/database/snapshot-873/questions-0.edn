\operatorname{sin}⁡(6\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{3}(0-0) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{cos}⁡(3x)$ and $g(x)=1$ \n$\\text{are orthogonal}$ with respect to the inner product."}] [{:db/id #edb/ref 17592186314989 :knowledge-point/_questions [{:db/id #edb/ref 17592186166964 :knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604" :knowledge-point/title "Determining Expressions For Fourier Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a94b1c8-4d5d-57f8-8d53-ac3a6453ca96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}-3{x}^{2})\\operatorname{sin}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186312056} {:answer/id #uuid "53816f6c-3e82-50d9-ac80-035267b9b313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}-3{x}^{2})\\operatorname{cos}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186312652} {:answer/id #uuid "7ef6361a-50cc-5c14-ac0e-7f3592a2bc20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }({x}^{3}-3{x}^{2})\\operatorname{cos}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186312996} {:answer/id #uuid "e1fe8b43-b488-50d6-beab-ddb1e8e7c81e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{3}-3{x}^{2})\\operatorname{sin}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186313755} {:answer/id #uuid "e9e238a1-1b26-5122-a8fe-5ff7e768750a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{3}-3{x}^{2})\\operatorname{cos}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186313837} {:answer/id #uuid "fe8e0071-5ff2-5146-b1ad-31c0bd641445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }({x}^{3}-3{x}^{2})\\operatorname{sin}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186314007}] :answer-field/correct {:answer/id #uuid "e1fe8b43-b488-50d6-beab-ddb1e8e7c81e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{3}-3{x}^{2})\\operatorname{sin}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186313755} :answer-field/id #uuid "1216454a-eaf2-5450-98ce-5bc32c61d8d5" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314061} {:answer-field/choices [{:answer/id #uuid "d396e8bd-75df-5618-86c3-73c3b74b68a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩}{⟨f(x),\\operatorname{sin}⁡(x)⟩}" :db/id #edb/ref 17592186313637} {:answer/id #uuid "e03611ab-92b0-5d41-93e9-1fed57574361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(x)⟩}{⟨\\operatorname{cos}⁡(x),\\operatorname{cos}⁡(x)⟩}" :db/id #edb/ref 17592186313739} {:answer/id #uuid "e901f737-5c77-5341-8bc1-b78927986b51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨\\operatorname{cos}⁡(x),\\operatorname{cos}⁡(x)⟩}{⟨f(x),\\operatorname{sin}⁡(x)⟩}" :db/id #edb/ref 17592186313830} {:answer/id #uuid "eea50f81-a609-5dd4-97d4-e34cece10fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(x)⟩}{⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩}" :db/id #edb/ref 17592186313880} {:answer/id #uuid "f47e4960-b4d5-5018-96c9-56112e9c7b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(x)⟩}{⟨\\operatorname{cos}⁡(x),\\operatorname{cos}⁡(x)⟩}" :db/id #edb/ref 17592186313931}] :answer-field/correct {:answer/id #uuid "eea50f81-a609-5dd4-97d4-e34cece10fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(x)⟩}{⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩}" :db/id #edb/ref 17592186313880} :answer-field/id #uuid "92b52dea-8ebd-59fd-ba10-4790e182f356" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314406} {:answer-field/choices [{:answer/id #uuid "0809e822-7c07-5342-9864-6c3928f81e4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186312032} {:answer/id #uuid "1a1286cb-ed57-54d9-895a-f9fc1324b1f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1}" :db/id #edb/ref 17592186312167} {:answer/id #uuid "4c55aeab-c6e1-5fbc-b2db-4a738d0cf09b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186312594} {:answer/id #uuid "72b80f7b-088d-51a1-9120-764f5e7af0ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186312880} {:answer/id #uuid "7938bdd0-ab46-5b80-9a88-703c52b67232" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{1}" :db/id #edb/ref 17592186312944}] :answer-field/correct {:answer/id #uuid "4c55aeab-c6e1-5fbc-b2db-4a738d0cf09b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186312594} :answer-field/id #uuid "bec85f47-7594-555b-98c5-7a111c7fab2e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186314539}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c36e0e36-a227-5df1-b273-538c9f56de6b" :question/math-academy-id "q-340652" :question/problem "Let $F(x)={x}^{3}-3{x}^{2}$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [-\\pi ,\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${b}_{1}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[-\\pi ,\\pi ).$\n\n$$\n\\begin{aligned}{b}_{1} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [-\\pi ,\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [-\\pi ,\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{sin}⁡(x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{sin}⁡(x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{sin}⁡(x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{sin}⁡(x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{b}_{1}⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩ & ={\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡(x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}-\\frac{1}{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x-\\frac{1}{4}\\operatorname{sin}⁡(2x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))-\\frac{1}{4}(\\operatorname{sin}⁡(2\\pi )-(\\operatorname{sin}⁡(-2\\pi ))) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(x)⟩ & ={b}_{1}⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩ \\\\ {b}_{1} & =\\frac{⟨f(x),\\operatorname{sin}⁡(x)⟩}{⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩} \\\\ {b}_{1} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{-\\pi }^{\\pi }({x}^{3}-3{x}^{2})\\operatorname{sin}⁡(x)\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186167291 :knowledge-point/_questions [{:db/id #edb/ref 17592186166964 :knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604" :knowledge-point/title "Determining Expressions For Fourier Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b770c93-7a1a-5d97-9ec1-34145465e1e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2⟨f(x), 1⟩)/(⟨1, 1⟩)" :db/id #edb/ref 17592186164961} {:answer/id #uuid "ce25a880-ad7a-5212-930c-8dc660884830" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(⟨f(x), \\cos (x)⟩)/(⟨\\cos (x), \\cos (x)⟩)" :db/id #edb/ref 17592186164962} {:answer/id #uuid "2bfc66ea-4fec-5286-bf49-3c926943ebf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(⟨1, 1⟩)/(⟨f(x), 1⟩)" :db/id #edb/ref 17592186164963} {:answer/id #uuid "6c43c695-195f-56ee-93b2-24893305d14d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(⟨f(x), 1⟩)/(⟨1, 1⟩)" :db/id #edb/ref 17592186164964} {:answer/id #uuid "6c8dc833-e594-5819-8044-e7bc46c0dadd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(⟨f(x), \\sin (x)⟩)/(⟨\\sin (x), \\sin (x)⟩)" :db/id #edb/ref 17592186164965}] :answer-field/id #uuid "ee81749b-6e22-550d-95a8-c6a1a7d3b25a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186164960} {:answer-field/choices [{:answer/id #uuid "9ab11543-0698-5cbe-bc59-06b215269ed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{∞}(x^{2} + 9x)dx" :db/id #edb/ref 17592186164967} {:answer/id #uuid "ac8e54be-6582-5f99-af27-8eec975e3178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{2π}(x^{2} + 9x)dx" :db/id #edb/ref 17592186164968} {:answer/id #uuid "e70704da-b52f-58f2-9088-61eae6bc33de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{- π}^{π}(x^{2} + 9x)dx" :db/id #edb/ref 17592186164969} {:answer/id #uuid "eaf951c2-bc7b-5d7c-834d-d464a4d98745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{- π}^{π}(x^{2} + 9x)\\sin (x)dx" :db/id #edb/ref 17592186164970} {:answer/id #uuid "1dd1f195-0572-5b20-b13d-3f226584c31f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{- π}^{π}(x^{2} + 9x)\\cos (x)dx" :db/id #edb/ref 17592186164971}] :answer-field/id #uuid "66368ebb-168f-5c76-9928-415718aadf33" :answer-field/key "field-3" :answer-fie