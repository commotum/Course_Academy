[{:db/id 17592186166562 :question/problem "Let $F(x) = \\cos(2x)$ for $x\\in\\mathbb R.$ Suppose $f(x)$ is the $\\pi$-periodic extension of $F(x)$ from $x \\in [0,\\pi)$ to $x \\in \\mathbb{R}.$ Which of the following statements are true?\n\nI. $f(x+\\pi) = f(x)$ for all $x \\in \\mathbb{R}$\n\nII. $f(x) = F(x)$ for all $x \\in \\mathbb{R}$\n\nIII. $f\\left(x+\\dfrac{\\pi}{2}\\right) = f(x)$ for all $x \\in \\mathbb{R}$" :db/ensure [:question/validate]} {:db/id 17592186413395 :question/problem "Let $G(x)=x+1$ for $x\\in R.$ Suppose $g(x)$ is the $4$-periodic extension of $G(x)$ from $x\\in [0,4)$ to $x\\in R.$ Which of the following statements are true?\n\nI. $g(x+8)=g(x)$ for all $x\\in R$\n\nII. $g(x)=G(x)$ for all $x\\in R$\n\nIII. $g(x+2)=g(x)$ for all $x\\in R$" :db/ensure [:question/validate]} {:db/id 17592186413394 :question/problem "Let $F(x)=\\operatorname{sin}⁡(4x)$ for $x\\in R.$ Suppose $f(x)$ is the $\\frac{\\pi }{2}$-periodic extension of $F(x)$ from $x\\in [0,\\frac{\\pi }{2})$ to $x\\in R.$ Which of the following statements are true?\n\nI. $f(x)=F(x)$ for all $x\\in [0,\\frac{\\pi }{2}).$\n\nII. $f(x)=F(x)$ for all $x\\in R$\n\nIII. $f(x+2\\pi )=f(x)$ for all $x\\in R$" :db/ensure [:question/validate]}]
