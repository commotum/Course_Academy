 x=\"500\" y=\"0\"></use>\n</g>\n<g transform=\"translate(107,-780)\">\n <use xlink:href=\"#E12-MJMATHI-72\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E12-MJMAIN-32\" x=\"638\" y=\"408\"></use>\n</g>\n</g>\n</g>\n <use xlink:href=\"#E12-MJSZ3-29\" x=\"2097\" y=\"-1\"></use>\n</g>\n <use xlink:href=\"#E12-MJMAIN-2B\" x=\"6082\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMATHI-3C0\" x=\"7083\" y=\"0\"></use>\n<g transform=\"translate(7656,0)\">\n <use xlink:href=\"#E12-MJMATHI-72\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E12-MJMAIN-32\" x=\"638\" y=\"583\"></use>\n</g>\n</g>\n<g transform=\"translate(0,-1579)\">\n <use xlink:href=\"#E12-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n<g transform=\"translate(1334,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1694\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n <use xlink:href=\"#E12-MJMAIN-35\"></use>\n <use xlink:href=\"#E12-MJMAIN-34\" x=\"500\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMATHI-3C0\" x=\"1001\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E12-MJMATHI-72\" x=\"621\" y=\"-686\"></use>\n</g>\n</g>\n <use xlink:href=\"#E12-MJMAIN-2B\" x=\"3490\" y=\"0\"></use>\n <use xlink:href=\"#E12-MJMATHI-3C0\" x=\"4491\" y=\"0\"></use>\n<g transform=\"translate(5065,0)\">\n <use xlink:href=\"#E12-MJMATHI-72\" x=\"0\" y=\"0\"></use>\n <use transform=\"scale(0.707)\" xlink:href=\"#E12-MJMAIN-32\" x=\"638\" y=\"583\"></use>\n</g>\n <use xlink:href=\"#E12-MJMAIN-2E\" x=\"5970\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>We want to minimize <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"2.413ex\" height=\"2.509ex\" style=\"vertical-align: -0.671ex;\" viewBox=\"0 -791.3 1039 1080.4\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-13-Title\">\n<title id=\"MathJax-SVG-13-Title\">C,</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E13-MJMATHI-43\" d=\"M50 252Q50 367 117 473T286 641T490 704Q580 704 633 653Q642 643 648 636T656 626L657 623Q660 623 684 649Q691 655 699 663T715 679T725 690L740 705H746Q760 705 760 698Q760 694 728 561Q692 422 692 421Q690 416 687 415T669 413H653Q647 419 647 422Q647 423 648 429T650 449T651 481Q651 552 619 605T510 659Q484 659 454 652T382 628T299 572T226 479Q194 422 175 346T156 222Q156 108 232 58Q280 24 350 24Q441 24 512 92T606 240Q610 253 612 255T628 257Q648 257 648 248Q648 243 647 239Q618 132 523 55T319 -22Q206 -22 128 53T50 252Z\"></path>\n<path stroke-width=\"1\" id=\"E13-MJMAIN-2C\" d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E13-MJMATHI-43\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E13-MJMAIN-2C\" x=\"760\" y=\"0\"></use>\n</g>\n</svg></span> so we need to differentiate <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1.766ex\" height=\"2.176ex\" style=\"vertical-align: -0.338ex;\" viewBox=\"0 -791.3 760.5 936.9\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-14-Title\">\n<title id=\"MathJax-SVG-14-Title\">C</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E14-MJMATHI-43\" d=\"M50 252Q50 367 117 473T286 641T490 704Q580 704 633 653Q642 643 648 636T656 626L657 623Q660 623 684 649Q691 655 699 663T715 679T725 690L740 705H746Q760 705 760 698Q760 694 728 561Q692 422 692 421Q690 416 687 415T669 413H653Q647 419 647 422Q647 423 648 429T650 449T651 481Q651 552 619 605T510 659Q484 659 454 652T382 628T299 572T226 479Q194 422 175 346T156 222Q156 108 232 58Q280 24 350 24Q441 24 512 92T606 240Q610 253 612 255T628 257Q648 257 648 248Q648 243 647 239Q618 132 523 55T319 -22Q206 -22 128 53T50 252Z\"></path>\n</defs>\n<g stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\" aria-hidden=\"true\">\n <use xlink:href=\"#E14-MJMATHI-43\" x=\"0\" y=\"0\"></use>\n</g>\n</svg></span> and set the derivative equal to zero. The derivative is \n<span class=\"mjpage mjpage__block\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"21.77ex\" height=\"5.509ex\" style=\"vertical-align: -2.171ex;\" viewBox=\"0 -1437.2 9373.4 2372\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-15-Title\">\n<title id=\"MathJax-SVG-15-Title\">\nC'(r) = -\\dfrac{54\\pi}{r^2} + 2\\pi r.\n</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E15-MJMATHI-43\" d=\"M50 252Q50 367 117 473T286 641T490 704Q580 704 633 653Q642 643 648 636T656 626L657 623Q660 623 684 649Q691 655 699 663T715 679T725 690L740 705H746Q760 705 760 698Q760 694 728 561Q692 422 692 421Q690 416 687 415T669 413H653Q647 419 647 422Q647 423 648 429T650 449T651 481Q651 552 619 605T510 659Q484 659 454 652T382 628T299 572T226 479Q194 422 175 346T156 222Q156 108 232 58Q280 24 350 24Q441 24 512 92T606 240Q610 253 612 255T628 257Q648 257 648 248Q648 243 647 239Q618 132 523 55T319 -22Q206 -22 128 53T50 252Z\"></path>\n<path stroke-width=\"1\" id=\"E15-MJMAIN-2032\" d=\"M79 43Q73 43 52 49T30 61Q30 68 85 293T146 528Q161 560 198 560Q218 560 240 545T262 501Q262 496 260 486Q259 479 173 263T84 45T79 43Z\"></path>\n<path stroke-width=\"1\" id=\"E15-MJMAIN-28\" d=\"M94 250Q94 319 104 381T127 488T164 576T202 643T244 695T277 729T302 750H315H319Q333 750 333 741Q333 738 316 720T275 667T226 581T184 443T167 250T184 58T225 -81T274 -167T316 -220T333 -241Q333 -250 318 -250H315H302L274 -226Q180 -141 137 -14T94 250Z\"></path>\n<path stroke-width=\"1\" id=\"E15-MJMATHI-72\" d=\"M21 287Q22 290 23 295T28 317T38 348T53 381T73 411T99 433T132 442Q161 442