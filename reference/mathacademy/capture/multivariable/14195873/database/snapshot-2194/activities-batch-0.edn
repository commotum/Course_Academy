#{[{:activity/first-step {:db/id #edb/ref 17592186101627} :activity/id #uuid "55f9d198-0e40-5068-b3d7-cb97445bd35c" :activity/scope {:db/id #edb/ref 17592186048193 :topic/id #uuid "87377602-1cbe-5615-9d57-ddf6e1796287" :topic/math-academy-id 1214} :activity/steps [{:db/id #edb/ref 17592186101627 :step/content {:db/id #edb/ref 17592186102011 :tutorial/content "Suppose we want to construct a cylindrical container with a fixed volume, yet we wish to use as little material as possible to minimize our production costs.\n\n![](images/33/339a377a68f93c78cf99b0f58333ab26c24bff91509dd707d22981d773ef077c.png)\n\nThis is yet another type of optimization problem. Let's remind ourselves of the general strategy for optimization problems.\n\n1. Draw a diagram of the situation, introducing variables where necessary.\n2. Write down the equation of the quantity that you're trying to maximize or minimize. This is the objective function, and it might include more than one variable.\n3. Write down the constraint equation.\n4. Use the constraint equation to write the objective function in terms of a single variable only.\n5. Differentiate the objective function, set it equal to zero, and solve for the stationary points.\n6. Test each stationary point using the second derivative test. Or you can use the first derivative test if it's easier.\n\nIn the following examples, we'll need to use the formulas for a cylindrical can's volume $V$ and surface area $S$. For a cylinder with radius $r$ and height $h$, its volume is given by the formula\n\n$$\nV = \\pi r^2 h\n$$\n\nIf the cylinder is closed at both ends, its surface area $S$ is given by\n\n$$\nS = 2πrh + 2πr^{2}\n$$\n\nIf the cylinder is closed at only one end, its surface area $S$ is\n\n$$\nS = 2πrh + πr^{2}\n$$" :tutorial/id #uuid "67df391f-27a3-55c3-bc1d-46e69a2931e3" :tutorial/math-academy-id 672 :tutorial/title "Introduction"} :step/id #uuid "3c14aa67-65c7-52ad-b74d-223f276e9735" :step/math-academy-id 1290 :step/next {:db/id #edb/ref 17592186101628}} {:db/id #edb/ref 17592186101628 :step/content {:db/id #edb/ref 17592186100840 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100650 :question/id #uuid "c7f66eb5-8151-5886-9b35-58632319651f" :question/math-academy-id "e-351"} :knowledge-point/id #uuid "39738d1a-2b58-58e7-8b93-fae76501045c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048125} {:db/id #edb/ref 17592186048883} {:db/id #edb/ref 17592186049179} {:db/id #edb/ref 17592186049792} {:db/id #edb/ref 17592186050622}] :knowledge-point/questions [{:db/id #edb/ref 17592186101279} {:db/id #edb/ref 17592186101363}] :knowledge-point/title "Minimizing the Surface Area of a Cylinder With a Fixed Volume"} :step/id #uuid "878a1892-1997-5956-bc6f-f3f8903e7276" :step/math-academy-id 1291 :step/next {:db/id #edb/ref 17592186101629}} {:db/id #edb/ref 17592186101629 :step/content {:db/id #edb/ref 17592186100841 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100651 :question/id #uuid "c82b0d87-792b-57d2-9340-9095af643c44" :question/math-academy-id "e-352"} :knowledge-point/id #uuid "a8fae559-f88f-50ec-a1f0-a7cfeb319d19" :knowledge-point/questions [{:db/id #edb/ref 17592186101277} {:db/id #edb/ref 17592186101278}] :knowledge-point/title "Maximizing the Volume of a Cylinder With a Fixed Surface Area"} :step/id #uuid "c19129d0-cc7e-5b81-b68a-0b24932487c6" :step/math-academy-id 1296 :step/next {:db/id #edb/ref 17592186101788}} {:db/id #edb/ref 17592186101788 :step/content {:db/id #edb/ref 17592186100945 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100783 :question/id #uuid "3d2657d6-3dc6-5855-8464-4f23dc675211" :question/math-academy-id "e-7523"} :knowledge-point/id #uuid "a8ac7b46-da1d-57f9-ab61-efa672ca8128" :knowledge-point/questions [{:db/id #edb/ref 17592186101235} {:db/id #edb/ref 17592186101553}] :knowledge-point/title "Optimizing the Cost of Building a Cylinder"} :step/id #uuid "7dabe378-eb14-5a04-a969-d7336f1d4578" :step/math-academy-id 27954}] :activity/title "Optimization Problems Involving Cylinders" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101069}]}
