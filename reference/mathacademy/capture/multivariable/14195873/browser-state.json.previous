      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195873/observations/step-q16231-551a30a0bc2aba77f8f0.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195873/observations/step-q16231-551a30a0bc2aba77f8f0.png",
      "source_url": "https://mathacademy.com/tasks/14195873/topics/1214/lesson",
