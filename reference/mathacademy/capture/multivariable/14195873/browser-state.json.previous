      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195873/observations/step-q86214-9413e1c033dabc56f567.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14195873/observations/step-q86214-9413e1c033dabc56f567.png",
      "source_url": "https://mathacademy.com/tasks/14195873/topics/1214/lesson",
      "captured_at": 1791951259.3448334,
      "math_academy_id": "q-86214",
