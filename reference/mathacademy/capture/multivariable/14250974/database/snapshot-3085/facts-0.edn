17] [17592186050360 #edb/ref 1035 #uuid "4264930a-5f20-54f0-ad2a-c3ad45c03658" #edb/ref 17592186045417] [17592186050777 #edb/ref 1027 #edb/ref 17592186048378 #edb/ref 17592186045417] [17592186050777 #edb/ref 1027 #edb/ref 17592186049824 #edb/ref 17592186045417] [17592186050777 #edb/ref 1027 #edb/ref 17592186049989 #edb/ref 17592186045417] [17592186050777 #edb/ref 1027 #edb/ref 17592186050128 #edb/ref 17592186045417] [17592186050777 #edb/ref 1027 #edb/ref 17592186050360 #edb/ref 17592186045417] [17592186050777 #edb/ref 1028 #edb/ref 17592186157229 #edb/ref 17592186045417] [17592186050777 #edb/ref 1028 #edb/ref 17592186157230 #edb/ref 17592186045417] [17592186050777 #edb/ref 1028 #edb/ref 17592186157231 #edb/ref 17592186045417] [17592186050777 #edb/ref 1031 "Logical Equivalence" #edb/ref 17592186045417] [17592186050777 #edb/ref 1033 2821 #edb/ref 17592186045417] [17592186050777 #edb/ref 1035 #uuid "65e4f73e-43a8-5089-914d-135e7396b995" #edb/ref 17592186045417] [17592186157010 #edb/ref 1069 "e-13222" #edb/ref 17592186045417] [17592186157010 #edb/ref 1071 "What are the missing values in the following truth table?\n\n| $\\,X\\,$ | $\\,Y\\,$ | $\\,X \\land (X \\lor \\neg Y) \\,$ |\n| --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\phantom{T}}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\phantom{T}}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\phantom{F}}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\phantom{F}}$ |" #edb/ref 17592186045417] [17592186157010 #edb/ref 1072 #uuid "1901808f-9cd7-52c2-85a7-8937aa8d4da3" #edb/ref 17592186045417] [17592186157010 #edb/ref 1074 "First, we add a column for $\\neg Y{:}$\n\n| $\\,X\\,$ | $\\,Y\\,$ | $\\, \\neg Y \\,$ |\n| --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm F$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm T$ |\n\nThen, we add a column for $X \\lor \\neg Y{:}$\n\n| $\\,X\\,$ | $\\,Y\\,$ | $\\, \\neg Y \\,$ | $\\, X \\lor \\neg Y \\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\textrm T$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm T$ | $\\textrm T$ |\n\nFinally, we add a column for $X \\land (X \\lor \\neg Y){:}$\n\n| $\\,X\\,$ | $\\,Y\\,$ | $\\, \\neg Y \\,$ | $\\, X \\lor \\neg Y \\,$ | $\\, X \\land (X \\lor \\neg Y) \\,$ |\n| --- | --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm T$ | $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm T$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |" #edb/ref 17592186045417] [17592186157011 #edb/ref 1069 "e-13223" #edb/ref 17592186045417] [17592186157011 #edb/ref 1071 "Find the missing values in the following truth table:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,\\neg A \\land \\neg B \\,$ | $\\,\\neg (A \\lor B) \\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm F$ | $\\textrm F$ |\n| $\\textrm T$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\phantom{F}}$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\phantom{F}}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\phantom{F}}$ |\n\nUse your results to determine whether $\\neg A \\land \\neg B$ is logically equivalent to $\\neg (A \\lor B).$" #edb/ref 17592186045417] [17592186157011 #edb/ref 1072 #uuid "beb3d6c7-1c43-5d6b-a817-e1756ea36818" #edb/ref 17592186045417] [17592186157011 #edb/ref 1074 "First, let's solve for the missing values:\n\n- When $A \\equiv \\textrm T$ and $B \\equiv \\textrm F,$ we have\n\n$$\n\\begin{aligned}¬A∧¬B & ≡¬\\text{T}∧¬\\text{F} \\\\  & ≡\\text{F}∧\\text{T} \\\\  & ≡\\text{F}\\end{aligned}\n$$\n\n- When $A \\equiv \\textrm F$ and $B \\equiv \\textrm T,$ we have\n\n$$\n\\begin{aligned}¬(A∨B) & ≡¬(\\text{F}∨\\text{T}) \\\\  & ≡¬\\text{T} \\\\  & ≡\\text{F}\\end{aligned}\n$$\n\n- When $A \\equiv \\textrm F$ and $B \\equiv \\textrm F,$ we have\n\n$$\n\\begin{aligned}¬(A∨B) & ≡¬(\\text{F}∨\\text{F}) \\\\  & ≡¬\\text{F} \\\\  & ≡\\text{T}\\end{aligned}\n$$\n\nOur completed table is shown below.\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,\\neg A \\land \\neg B \\,$ | $\\,\\neg (A \\lor B) \\,$ |\n| --- | --- | --- | --- |\n| $\\textrm T$ | $\\textrm T$ | $\\textrm F$ | $\\textrm F$ |\n| $\\textrm T$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ | $\\textrm F$ |\n| $\\textrm F$ | $\\textrm T$ | $\\textrm F$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm F}$ |\n| $\\textrm F$ | $\\textrm F$ | $\\textrm T$ | $\\bbox[2pt,Gainsboro]{\\color{blue}\\textrm T}$ |\n\n \n\nTo determine whether $\\neg A \\land \\neg B$ is logically equivalent to $\\neg (A \\lor B),$ we need to check whether their truth tables are equivalent.\n\nLooking at the last two columns, we see that they are the same $(\\textrm{F},\\textrm{F},\\textrm{F},\\textrm{T}).$ Therefore, we conclude that $\\neg A \\land \\neg B$ is logically equivalent to $\\neg (A \\lor B),$ that is,\n\n$$\n\\neg A \\land \\neg B \\bbox[2pt,Gainsboro]{\\color{blue}\\equiv} \\neg (A \\lor B).\n$$" #edb/ref 17592186045417] [17592186157012 #edb/ref 1069 "e-13224" #edb/ref 17592186045417] [17592186157012 #edb/ref 1071 "Which of the following statements are logically equivalent?\n\n- $B \\land \\neg A$\n\n- $\\neg (A \\lor \\neg B)$\n\n- $\\neg (\\neg A \\lor B)$" #edb/ref 17592186045417] [17592186157012 #edb/ref 1072 #uuid "b6448ed1-56af-57e0-b414-8c01e6a01571" #edb