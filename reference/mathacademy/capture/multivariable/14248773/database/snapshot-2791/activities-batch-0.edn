#{[{:activity/expected-seconds 1260.0 :activity/first-step {:db/id #edb/ref 17592186167577} :activity/id #uuid "37fac92b-9502-52a2-8069-399fccbd8a62" :activity/scope {:db/id #edb/ref 17592186050031 :topic/id #uuid "27615ef6-ec0e-5e91-b58b-24b70dc01a09" :topic/math-academy-id 3173} :activity/steps [{:db/id #edb/ref 17592186167573 :step/content {:db/id #edb/ref 17592186166747 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166585 :question/id #uuid "285e2f4a-e8d0-5f5e-a2d2-fe5ba8476358" :question/math-academy-id "e-8256"} :knowledge-point/id #uuid "5ed13b87-51ab-547d-a9ed-960eda7db24e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048707}] :knowledge-point/question-generator {:db/id #edb/ref 17592186561381} :knowledge-point/questions [{:db/id #edb/ref 17592186167326} {:db/id #edb/ref 17592186167331} {:db/id #edb/ref 17592186284666} {:db/id #edb/ref 17592186360551} {:db/id #edb/ref 17592186360552} {:db/id #edb/ref 17592186360553} {:db/id #edb/ref 17592186360554} {:db/id #edb/ref 17592186360555} {:db/id #edb/ref 17592186360556} {:db/id #edb/ref 17592186360557} {:db/id #edb/ref 17592186383607} {:db/id #edb/ref 17592186385838} {:db/id #edb/ref 17592186561317} {:db/id #edb/ref 17592186561328} {:db/id #edb/ref 17592186561337} {:db/id #edb/ref 17592186561348} {:db/id #edb/ref 17592186561352} {:db/id #edb/ref 17592186561355} {:db/id #edb/ref 17592186561364} {:db/id #edb/ref 17592186561366} {:db/id #edb/ref 17592186561368} {:db/id #edb/ref 17592186561373}] :knowledge-point/title "Calculating the Derivative of a Multivariable Function With One Independent Variable"} :step/id #uuid "a6ab275a-61df-5648-811a-176fda344fe5" :step/math-academy-id 30861 :step/next {:db/id #edb/ref 17592186167697}} {:db/id #edb/ref 17592186167574 :step/content {:db/id #edb/ref 17592186166748 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166586 :question/id #uuid "7da1ada0-43e5-5807-b2c2-2a254a76cf27" :question/math-academy-id "e-8257"} :knowledge-point/id #uuid "1457941c-efa8-556f-9df7-3c5ae7b44ced" :knowledge-point/question-generator {:db/id #edb/ref 17592186526461} :knowledge-point/questions [{:db/id #edb/ref 17592186167327} {:db/id #edb/ref 17592186167332} {:db/id #edb/ref 17592186284667} {:db/id #edb/ref 17592186360558} {:db/id #edb/ref 17592186360566} {:db/id #edb/ref 17592186360568} {:db/id #edb/ref 17592186360569} {:db/id #edb/ref 17592186360570} {:db/id #edb/ref 17592186360571} {:db/id #edb/ref 17592186437273} {:db/id #edb/ref 17592186479065} {:db/id #edb/ref 17592186479104} {:db/id #edb/ref 17592186526410} {:db/id #edb/ref 17592186526417} {:db/id #edb/ref 17592186526421} {:db/id #edb/ref 17592186526423} {:db/id #edb/ref 17592186526426} {:db/id #edb/ref 17592186526431} {:db/id #edb/ref 17592186526441} {:db/id #edb/ref 17592186526442} {:db/id #edb/ref 17592186526448} {:db/id #edb/ref 17592186526455}] :knowledge-point/title "Calculating the Derivative of a Multivariable Function With One Independent Variable in the Special Case"} :step/id #uuid "8627eaba-93e3-51d5-b350-72ee5af3e635" :step/math-academy-id 30862 :step/next {:db/id #edb/ref 17592186167578}} {:db/id #edb/ref 17592186167575 :step/content {:db/id #edb/ref 17592186166749 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166587 :question/id #uuid "1491963b-fbd8-57fa-bdde-f2d6705fbb83" :question/math-academy-id "e-8258"} :knowledge-point/id #uuid "f26d941b-b4b4-591e-b7e0-ae4bbf81e94b" :knowledge-point/question-generator {:db/id #edb/ref 17592186529504} :knowledge-point/questions [{:db/id #edb/ref 17592186167311} {:db/id #edb/ref 17592186167325} {:db/id #edb/ref 17592186284668} {:db/id #edb/ref 17592186284669} {:db/id #edb/ref 17592186323886} {:db/id #edb/ref 17592186360483} {:db/id #edb/ref 17592186360484} {:db/id #edb/ref 17592186378038} {:db/id #edb/ref 17592186385363} {:db/id #edb/ref 17592186385824} {:db/id #edb/ref 17592186437272} {:db/id #edb/ref 17592186479133} {:db/id #edb/ref 17592186529474} {:db/id #edb/ref 17592186529477} {:db/id #edb/ref 17592186529480} {:db/id #edb/ref 17592186529488} {:db/id #edb/ref 17592186529494}] :knowledge-point/title "Calculating the Derivative of a Multivariable Function With Two Independent Variables"} :step/id #uuid "60b2ea1e-4b9a-5557-99ae-a83016e785a6" :step/math-academy-id 30863 :step/next {:db/id #edb/ref 17592186167579}} {:db/id #edb/ref 17592186167576 :step/content {:db/id #edb/ref 17592186166750 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166588 :question/id #uuid "e535fe44-a3cb-5c11-831c-118b90582c0d" :question/math-academy-id "e-8259"} :knowledge-point/id #uuid "71c243ca-5d46-58d2-bd16-28075c04d2db" :knowledge-point/question-generator {:db/id #edb/ref 17592186546131} :knowledge-point/questions [{:db/id #edb/ref 17592186167328} {:db/id #edb/ref 17592186167329} {:db/id #edb/ref 17592186284670} {:db/id #edb/ref 17592186323885} {:db/id #edb/ref 17592186360507} {:db/id #edb/ref 17592186360508} {:db/id #edb/ref 17592186360509} {:db/id #edb/ref 17592186360510} {:db/id #edb/ref 17592186360511} {:db/id #edb/ref 17592186383614} {:db/id #edb/ref 17592186385370} {:db/id #edb/ref 17592186420996} {:db/id #edb/ref 17592186546100} {:db/id #edb/ref 17592186546109} {:db/id #edb/ref 17592186546113} {:db/id #edb/ref 17592186546116} {:db/id #edb/ref 17592186546118}] :knowledge-point/title "Calculating the Derivative of a Function of Three Intermediate Variables and Two Independent Variables"} :step/id #uuid "26ddca41-ae16-5395-ae11-41c4d70303c6" :step/math-academy-id 30864} {:db/id #edb/ref 17592186167577 :step/content {:db/id #edb/ref 17592186168061 :tutorial/content "The chain rule for single variable functions $f=f(x)$ and $x=x(t)$ states that\n\n$$\n\\dfrac{\\textrm{d}f}{\\textrm{d}t} = \\dfrac{\\textrm{d}f}{\\textrm{d}x} \\cdot \\dfrac{\\textrm{d}x}{\\textrm{d}t}.\n$$\n\nLet's now suppose that $f = f(x,y),$ where $x=x(t)$ and $y=y(t)$ are single-variable functions. How do we find $\\dfrac{\\textrm d f}{\\textrm d t}$ in this case?\n\nThe functions $x(t)$ and $y(t)$ are known as **intermediate variables.** They are independent variables for the function $f(x,y),$ but are themselves dependent on the variable $t.$\n\nOne way to consider how $f(x,y)$ depends on $t$ is to draw a tree diagram.\n\nStarting with $f(x,y),$ we draw a branch for each intermediate variable. Then, we draw a branch for both $x=x(t)$ and $y=y(t),$ which are both dependent on the variable $t.$\n\n![](images/cd/cdc47e038ecaba62ae612a0ac0bc07067af232353fc4fc169bf4be57b3abbd1f.png)\n\nWe then label each branch with the derivative describing how the function changes due to a change in the variable. \n\n![](images/ec/ece6012e358b5b6920395df88acd8d7037a7b15bed1add1220365ba72bd24cbd.png)\n\nThen, traversing each branch, we compute the product of the derivatives along each branch and place the result at the end of the branch.\n\n![](images/f0/f01b253f560405a8c0f4be8f8797c652fb0ddf774f4db110b8822313b8ac50f3.png)\n\nFinally, to find $\\dfrac{\\textrm{d}f}{\\textrm{d}t},$ we sum the results for each branch:\n\n$$\n\\dfrac{\\textrm{d}f}{\\textrm{d}t}\n = \\dfrac{\\partial f}{\\partial x} \\cdot \\dfrac{\\textrm{d}x}{\\textrm{d}t} + \\dfrac{\\partial f}{\\partial y} \\cdot \\dfrac{\\textrm{d}y}{\\textrm{d}t}\n$$\n\nThis result is called the **multivariable chain rule**." :tutorial/id #uuid "80ad8a26-7d43-52d6-b0ba-e1d04283e5ad" :tutorial/math-academy-id 4957 :tutorial/title "Introduction"} :step/id #uuid "03fe551f-81c6-5c42-9baf-d6d12895ab47" :step/math-academy-id 30893 :step/next {:db/id #edb/ref 17592186167573}} {:db/id #edb/ref 17592186167578 :step/content {:db/id #edb/ref 17592186168062 :tutorial/content "How do we apply the multivariable chain rule if the intermediate variables are also dependent on two variables? \n\nFor example, suppose we have\n\n$$\nf = f(x,y), \\qquad x=g(s,t), \\qquad y=h(s,t).\n$$\n\nHow do we compute $\\dfrac{\\partial f}{\\partial s}?$ \n\nFirst, let's construct a tree diagram.\n\n![](images/ca/ca524eda2e6be3354fcb72bed52fcaf22257073c3228d74850f8226f9ef0af6f.png)\n\nNow, since we're interested in $\\dfrac{\\partial f}{\\partial s},$ we highlight all branches that give differentiation with respect to $s:$\n\n![](images/21/21cec766fe72965697304ef4288ffb2b090ddfca179210165dbcfd42ec490b27.png)\n\nIf we keep $t$ fixed and differentiate $f$ with respect to $s,$ then according to the chain rule for two intermediate variables and one independent variable, we obtain\n\n$$\n\\dfrac{\\partial f}{\\partial s} = \\dfrac{\\partial f}{\\partial x} \\cdot \\dfrac{\\partial x}{\\partial s} + \\dfrac{\\partial f}{\\partial y} \\cdot \\dfrac{\\partial y}{\\partial s}.\n$$\n\nSimilarly, if we wanted to compute $\\dfrac{\\partial f}{\\partial t},$ we would highlight all branches that give differentiation with respect to $t\\mathbin{:}$\n\n![](images/11/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nKeeping $s$ fixed and differentiating $f$ with respect to $t$ gives\n\n$$\n\\dfrac{\\partial f}{\\partial t} = \\dfrac{\\partial f}{\\partial x} \\cdot \\dfrac{\\partial x}{\\partial t} + \\dfrac{\\partial f}{\\partial y} \\cdot \\dfrac{\\partial y}{\\partial t}.\n$$" :tutorial/id #uuid "58d189b1-31fb-5b1b-bc4c-cff6be5e2f7b" :tutorial/math-academy-id 4958 :tutorial/title "The Multivariable Chain Rule With Two Independent Variables"} :step/id #uuid "2ffafece-1c0b-50f7-a3b1-e1b2d1bada36" :step/math-academy-id 30894 :step/next {:db/id #edb/ref 17592186167575}} {:db/id #edb/ref 17592186167579 :step/content {:db/id #edb/ref 17592186168063 :tutorial/content "We can generalize the chain rule to a multivariable function containing an arbitrary number of intermediate and independent variables.\n\nConsider the multivariable function \n\n$$\nf = f(x_1,x_2, \\ldots, x_m)\n$$\n\nwith $m$ independent variables and, for each $i \\in \\{1,\\ldots, n\\},$ the variable \n\n$$\nx_i = g_i(t_1, t_2, \\ldots, t_n)\n$$\n\nis a differentiable function of $n$ independent variables. Then,\n\n$$\n\\dfrac{\\partial f}{\\partial t_j} = \\dfrac{\\partial f}{\\partial x_1} \\cdot \\dfrac{\\partial x_1}{\\partial t_j} + \\dfrac{\\partial f}{\\partial x_2} \\cdot \\dfrac{\\partial x_2}{\\partial t_j} + \\dots + \\dfrac{\\partial f}{\\partial x_m} \\cdot \\dfrac{\\partial x_m}{\\partial t_j}\n$$\n\nfor $j \\in \\{1,2,\\ldots, n\\}.$" :tutorial/id #uuid "1ba7d2a4-05a6-5e62-8035-2610239633c3" :tutorial/math-academy-id 4959 :tutorial/title "The Generalized Multivariable Chain Rule"} :step/id #uuid "9731a04f-c2d1-5342-b940-0313b71ca1eb" :step/math-academy-id 30895 :step/next {:db/id #edb/ref 17592186167576}} {:db/id #edb/ref 17592186167697 :step/content {:db/id #edb/ref 17592186168088 :tutorial/content "There is a special case of the multivariable chain rule when $f=f(x,y)$ and $y=g(x).$ \n\nNotice that $x$ is an independent variable here. Therefore, the chain rule becomes\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{∂f}{∂x}\\cdot {{\\frac{\\text{d}x}{\\text{d}x}}_{⏟}}_{1}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x} \\\\  & =\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\\end{aligned}\n$$" :tutorial/id #uuid "44effd03-02e7-5eb1-8732-ee1522afa147" :tutorial/math-academy-id 5184 :tutorial/title "A Special Case of the Multivariable Chain Rule"} :step/id #uuid "fdc61eff-9eab-552e-9092-f4040bdff21a" :step/math-academy-id 32539 :step/next {:db/id #edb/ref 17592186167574}}] :activity/title "The Multivariable Chain Rule" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186166978}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186420998} :activity/id #uuid "844676a2-0a90-5f03-a7c1-22515b371e49" :activity/scope {:db/id #edb/ref 17592186050031 :topic/id #uuid "27615ef6-ec0e-5e91-b58b-24b70dc01a09" :topic/math-academy-id 3173} :activity/steps [{:db/id #edb/ref 17592186420997 :step/content {:db/id #edb/ref 17592186167325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a19a158-cb30-5c9e-9cf9-891ab114ad36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{s}^{2}(2t-1)" :db/id #edb/ref 17592186355012} {:answer/id #uuid "392f1f1c-1dad-5e72-b1e4-40cf201a767c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{s}^{2}t(s-t)" :db/id #edb/ref 17592186355179} {:answer/id #uuid "869f5f73-0c65-5003-ade6-8eeef3e8b4ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{s}^{2}(s-t)" :db/id #edb/ref 17592186355855} {:answer/id #uuid "c2f0fe58-16c4-5d79-ab11-4893e9ff089a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8st(s-1)" :db/id #edb/ref 17592186356369} {:answer/id #uuid "fa6ace28-41b6-5a2e-8b64-9dee698d22fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8st(t-1)" :db/id #edb/ref 17592186356853}] :answer-field/correct {:db/id #edb/ref 17592186356853} :answer-field/id #uuid "6314b903-87e4-5c8c-a8db-703d520d008b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357085}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e1e3cf4a-155f-587d-ba03-cc737759407e" :question/math-academy-id "q-94448" :question/problem "Let $f(x,y)={x}^{2}-4y,$ where $x=2st$ and $y={s}^{2}t.$ Calculate $\\frac{∂f}{∂s}.$" :question/worked-solution "![](images/21/21cec766fe72965697304ef4288ffb2b090ddfca179210165dbcfd42ec490b27.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2x,\\,\\frac{∂f}{∂y}=-4\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2(2st)=4st, \\\\ \\frac{∂f}{∂y} & =-4.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & =2t, \\\\ \\frac{∂y}{∂s} & =2st.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s} \\\\  & =(4st)(2t)+(-4)(2st) \\\\  & =8s{t}^{2}-8st \\\\  & =8st(t-1).\\end{aligned}\n$$"} :step/id #uuid "2cf7698e-82a3-5979-93cb-d2edffbb99d7" :step/next {:db/id #edb/ref 17592186421000}} {:db/id #edb/ref 17592186420998 :step/content {:db/id #edb/ref 17592186323885 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9a8991-24fd-50f9-8941-a329e3133c45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{s}^{4}{t}^{2}+10{s}^{3}\\operatorname{sin}⁡t" :db/id #edb/ref 17592186321230} {:answer/id #uuid "84b790fb-dce2-5ea5-9fbd-fb66967b78c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{s}^{2}{t}^{4}-20s\\operatorname{sin}⁡t" :db/id #edb/ref 17592186322195} {:answer/id #uuid "bb1f027a-f67b-5d1f-b407-9ee3b85b3667" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{s}^{4}t-5{s}^{3}\\operatorname{sin}⁡t" :db/id #edb/ref 17592186322598} {:answer/id #uuid "c8bfc905-fde6-54a5-83ad-c5fa1e325d7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{s}^{4}{t}^{2}-20{s}^{3}\\operatorname{sin}⁡t" :db/id #edb/ref 17592186322709} {:answer/id #uuid "f675ee7a-8c5d-5a9a-90cb-d0e4dd971fe3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5{s}^{2}{t}^{4}-15s\\operatorname{sin}⁡t-5\\operatorname{sin}⁡t" :db/id #edb/ref 17592186323079}] :answer-field/correct {:db/id #edb/ref 17592186322709} :answer-field/id #uuid "af1de9ae-38d9-5d66-a275-9fc76c319cbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186323509}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bd5b5db6-0961-5b1c-8f50-24c2f4348bc1" :question/math-academy-id "q-37132" :question/problem "Let $f(x,y,z)={x}^{2}y-5yz,$ where $x=st,$ $y={s}^{3}$ and $z=s\\operatorname{sin}⁡t.$ Calculate $\\frac{∂f}{∂s}.$" :question/worked-solution "![](images/be/be6afcdd0ad9ae0d7ef377c4918442a64e1186c90c25e27ec6c224d816a602fd.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2xy,\\,\\frac{∂f}{∂y}={x}^{2}-5z,\\,\\frac{∂f}{∂z}=-5y.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2(st)({s}^{3})=2{s}^{4}t, \\\\ \\frac{∂f}{∂y} & =(st)^{2}-5(s\\operatorname{sin}⁡t)={s}^{2}{t}^{2}-5s\\operatorname{sin}⁡t, \\\\ \\frac{∂f}{∂z} & =-5{s}^{3}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & =t, \\\\ \\frac{∂y}{∂s} & =3{s}^{2}, \\\\ \\frac{∂z}{∂s} & =\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =(2{s}^{4}t)\\cdot t+({s}^{2}{t}^{2}-5s\\operatorname{sin}⁡t)\\cdot 3{s}^{2}+(-5{s}^{3})\\cdot \\operatorname{sin}⁡t \\\\  & =2{s}^{4}{t}^{2}+3{s}^{4}{t}^{2}-15{s}^{3}\\operatorname{sin}⁡t-5{s}^{3}\\operatorname{sin}⁡t \\\\  & =5{s}^{4}{t}^{2}-20{s}^{3}\\operatorname{sin}⁡t.\\end{aligned}\n$$"} :step/id #uuid "6a9db776-142d-5ace-9b62-834d4e4b6a63" :step/next {:db/id #edb/ref 17592186421001}} {:db/id #edb/ref 17592186420999 :step/content {:db/id #edb/ref 17592186284667 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021a846a-8825-55bf-a7b3-1dc5c5c5ff19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "({x}^{2}+1)\\operatorname{ln}⁡({x}^{2}+1)" :db/id #edb/ref 17592186281709} {:answer/id #uuid "49b2d0a3-8640-5928-a7d2-f8a14102a68f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x(1+\\operatorname{ln}⁡({x}^{2}+1))" :db/id #edb/ref 17592186282314} {:answer/id #uuid "e8a1e1c7-9e8a-5f17-9500-4d7507d44b3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2x({x}^{2}+1)}{\\operatorname{ln}⁡({x}^{2}+1)}" :db/id #edb/ref 17592186283715} {:answer/id #uuid "efd819c9-60d2-5826-9266-3dba4a49aaec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2x}{\\operatorname{ln}⁡({x}^{2}+1)}" :db/id #edb/ref 17592186283779} {:answer/id #uuid "f5de75cd-c44e-5baf-9f07-d98f3333edab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x\\operatorname{ln}⁡({x}^{2}+1)" :db/id #edb/ref 17592186283839}] :answer-field/correct {:db/id #edb/ref 17592186282314} :answer-field/id #uuid "d658fcd0-7d37-5a87-a5b6-42706ffef583" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284307}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cdba7da9-8893-51f6-a38d-eccc847b176c" :question/math-academy-id "q-170670" :question/problem "If $f(x,y)=y\\operatorname{ln}⁡({x}^{2}+1)$ and $y={x}^{2}+1,$ compute $\\frac{\\text{d}f}{\\text{d}x}.$" :question/worked-solution "The chain rule for a multivariable function $f(x,y)$ in the case where $y=y(x)$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{2xy}{{x}^{2}+1},\\,\\frac{∂f}{∂y}=\\operatorname{ln}⁡({x}^{2}+1)\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{2x({x}^{2}+1)}{{x}^{2}+1}=2x, \\\\ \\frac{∂f}{∂y} & =\\operatorname{ln}⁡({x}^{2}+1).\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2x.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =2x+\\operatorname{ln}⁡({x}^{2}+1)\\cdot 2x \\\\  & =2x(1+\\operatorname{ln}⁡({x}^{2}+1)).\\end{aligned}\n$$"} :step/id #uuid "6ef0c797-03b2-58eb-8a37-83236f476fe8"} {:db/id #edb/ref 17592186421000 :step/content {:db/id #edb/ref 17592186360569 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4be18679-efe0-59e6-80ac-db92f8d96a8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\operatorname{sin}⁡x+x\\operatorname{cos}⁡x" :db/id #edb/ref 17592186358407} {:answer/id #uuid "4f9edd72-2523-57c6-9665-681f1ed475c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\operatorname{sin}⁡x-2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186358439} {:answer/id #uuid "9bcdf56c-f98e-5632-8b37-69db930425d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186359116} {:answer/id #uuid "9f4b3c97-4572-526c-8afd-d0a1d5757af5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\operatorname{sin}⁡x+\\operatorname{cos}⁡x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186359141} {:answer/id #uuid "b33efd16-e5a4-5396-8988-6df4afae8ae5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186359315}] :answer-field/correct {:db/id #edb/ref 17592186358407} :answer-field/id #uuid "1f643ac2-8342-50cb-9136-e026a1d69059" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360047}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cfb1f74a-0323-5d9e-a2f6-877356ed98f1" :question/math-academy-id "q-95118" :question/problem "If $f(x,y)={x}^{2}+yx$ and $y=\\operatorname{sin}⁡x,$ compute $\\frac{\\text{d}f}{\\text{d}x}.$" :question/worked-solution "The chain rule for a multivariable function $f(x,y)$ in the case where $y=y(x)$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2x+y,\\,\\frac{∂f}{∂y}=x\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2x+\\operatorname{sin}⁡x \\\\ \\frac{∂f}{∂y} & =x.\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =2x+\\operatorname{sin}⁡x+x\\operatorname{cos}⁡x.\\end{aligned}\n$$"} :step/id #uuid "7bfbd495-1860-54a3-8d60-35f838cfca25" :step/next {:db/id #edb/ref 17592186420999}} {:db/id #edb/ref 17592186421001 :step/content {:db/id #edb/ref 17592186420996 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17573a89-2ada-5cfd-8592-1b89b18d61f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186420990} {:answer/id #uuid "3856cad9-d2c1-55a4-adf6-784ae35a6aa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186420991} {:answer/id #uuid "5c54b913-d15a-53bc-b2c6-f71477530f9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186420992} {:answer/id #uuid "ae277bb1-236f-56f1-8a0c-7fd47295108c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186420993} {:answer/id #uuid "d87585d5-b5cd-5fbc-b58c-a3d2c45f4e66" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186420994}] :answer-field/correct {:db/id #edb/ref 17592186420993} :answer-field/id #uuid "f118ee24-10a3-5bda-8238-4be0365cace0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420995}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f22c7a35-af74-59c8-b71b-cae8347ea97d" :question/math-academy-id "q-37206" :question/problem "Let $f(x,y,z)=xy+yz+{z}^{2},$ where $x={s}^{2}+{t}^{2},$ $y=\\frac{s}{t}$ and $z=s{t}^{2}.$ Given that\n\n$$\n\\frac{∂f}{∂s}=\\frac{3{s}^{2}}{t}+{c}_{1}t+{c}_{2}st+{c}_{3}s{t}^{4},\n$$\n\nfind the value of ${c}_{1}+{c}_{2}+{c}_{3}.$" :question/worked-solution "![](images/be/be6afcdd0ad9ae0d7ef377c4918442a64e1186c90c25e27ec6c224d816a602fd.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y,\\,\\frac{∂f}{∂y}=x+z,\\,\\frac{∂f}{∂z}=y+2z.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{s}{t}, \\\\ \\frac{∂f}{∂y} & ={s}^{2}+{t}^{2}+s{t}^{2}, \\\\ \\frac{∂f}{∂z} & =\\frac{s}{t}+2s{t}^{2}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & =2s, \\\\ \\frac{∂y}{∂s} & =\\frac{1}{t}, \\\\ \\frac{∂z}{∂s} & ={t}^{2}.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =(\\frac{s}{t})\\cdot 2s+({s}^{2}+{t}^{2}+s{t}^{2})\\cdot \\frac{1}{t}+(\\frac{s}{t}+2s{t}^{2})\\cdot {t}^{2} \\\\  & =\\frac{2{s}^{2}}{t}+\\frac{{s}^{2}}{t}+t+st+st+2s{t}^{4} \\\\  & =\\frac{3{s}^{2}}{t}+t+2st+2s{t}^{4}.\\end{aligned}\n$$\n\nFinally, ${c}_{1}=1,$ ${c}_{2}=2$ and ${c}_{3}=2,$ and therefore\n\n$$\n{c}_{1}+{c}_{2}+{c}_{3}=1+2+2=5.\n$$"} :step/id #uuid "926bef20-92d0-5cd4-928e-9a8dd40763b1" :step/next {:db/id #edb/ref 17592186420997}}] :activity/title "The Multivariable Chain Rule" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186420989}] [{:activity/course {:db/id #edb/ref 17592186046658} :activity/first-step {:db/id #edb/ref 17592186515709} :activity/id #uuid "f9135b23-a1e2-5324-b00b-b9b69f18dd59" :activity/scope {:db/id #edb/ref 17592186050031 :topic/id #uuid "27615ef6-ec0e-5e91-b58b-24b70dc01a09" :topic/math-academy-id 3173} :activity/steps [{:db/id #edb/ref 17592186515621 :step/content {:db/id #edb/ref 17592186360484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01632887-adf0-501e-9c55-0c43a8e3a195" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\operatorname{sin}⁡(2st)" :db/id #edb/ref 17592186357770} {:answer/id #uuid "0667969c-90fd-5446-9ffe-efe916cf6782" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\operatorname{cos}⁡(2st)" :db/id #edb/ref 17592186357809} {:answer/id #uuid "31a57553-0726-5177-afb7-c33ab426fd0e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{s}^{2}\\operatorname{sin}⁡(2st)" :db/id #edb/ref 17592186358192} {:answer/id #uuid "c24d7296-dc42-53b5-9df3-6afb6f82d279" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\operatorname{sin}⁡(2st)" :db/id #edb/ref 17592186359456} {:answer/id #uuid "ed7d37b8-0f46-5fbb-b1ee-35edde54b6d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{t}^{2}\\operatorname{cos}⁡(2st)" :db/id #edb/ref 17592186359864}] :answer-field/correct {:db/id #edb/ref 17592186357809} :answer-field/id #uuid "0ae361e8-131f-5a9f-a75b-7ea0d6de8cc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360014}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "878a1123-ef9a-5a02-91a8-3dc4077906e0" :question/math-academy-id "q-94749" :question/problem "Let $f(x,y)=xy,$ where $x=\\operatorname{sin}⁡(st)$ and $y=\\operatorname{cos}⁡(st).$ Calculate $\\frac{∂f}{∂t}.$" :question/worked-solution "![](images/11/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y,\\,\\frac{∂f}{∂y}=x\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\operatorname{cos}⁡(st), \\\\ \\frac{∂f}{∂y} & =\\operatorname{sin}⁡(st).\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =s\\operatorname{cos}⁡(st), \\\\ \\frac{∂y}{∂t} & =-s\\operatorname{sin}⁡(st).\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t} \\\\  & =(\\operatorname{cos}⁡(st))(s\\operatorname{cos}⁡(st))+(\\operatorname{sin}⁡(st))(-s\\operatorname{sin}⁡(st)) \\\\  & =s{cos}^{2}⁡(st)-s{sin}^{2}⁡(st) \\\\  & =s({cos}^{2}⁡(st)-{sin}^{2}⁡(st)) \\\\  & =s\\operatorname{cos}⁡(2st).\\end{aligned}\n$$"} :step/id #uuid "03f2df0e-7127-5bf6-a3cb-55f1736639ac" :step/next {:db/id #edb/ref 17592186515646}} {:db/id #edb/ref 17592186515646 :step/content {:db/id #edb/ref 17592186479104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d5ecadd-1d99-51f3-b3ee-0d0a52a7e504" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2{e}^{2x}}{x+{e}^{2x}}" :db/id #edb/ref 17592186478669} {:answer/id #uuid "7eececa3-aed5-56bc-8acd-83a7d9f52ce0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{1+2{e}^{2x}}" :db/id #edb/ref 17592186478748} {:answer/id #uuid "c04864f4-8e0e-5d9d-8763-0a9d20cfc1c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+{e}^{2x}}{x+{e}^{2x}}" :db/id #edb/ref 17592186478870} {:answer/id #uuid "c22286df-0bd2-569b-80cb-dd78460f6e01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{2x}}{x+{e}^{2x}}" :db/id #edb/ref 17592186478871} {:answer/id #uuid "fd87021b-423b-576b-b08a-47b84980a27a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+2{e}^{2x}}{x+{e}^{2x}}" :db/id #edb/ref 17592186478956}] :answer-field/correct {:db/id #edb/ref 17592186478956} :answer-field/id #uuid "3f1b30ab-e87a-541b-926a-088f06d1391d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186478982}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "889d0bfa-8294-56c7-a3ce-0b0d572aff69" :question/math-academy-id "q-95120" :question/problem "If $f(x,y)=\\operatorname{ln}⁡(x+y)$ and $y={e}^{2x},$ compute $\\frac{\\text{d}f}{\\text{d}x}.$" :question/worked-solution "The chain rule for a multivariable function $f(x,y)$ in the case where $y=y(x)$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{1}{x+y},\\,\\frac{∂f}{∂y}=\\frac{1}{x+y}\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂f}{∂y}=\\frac{1}{x+{e}^{2x}}.\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2{e}^{2x}.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{1}{x+{e}^{2x}}+\\frac{1}{x+{e}^{2x}}\\cdot 2{e}^{2x} \\\\  & =\\frac{1}{x+{e}^{2x}}+\\frac{2{e}^{2x}}{x+{e}^{2x}} \\\\  & =\\frac{1+2{e}^{2x}}{x+{e}^{2x}}.\\end{aligned}\n$$"} :step/id #uuid "3c096bca-7b75-5ffa-8b01-bdd0cb2ca5b9" :step/next {:db/id #edb/ref 17592186515674}} {:db/id #edb/ref 17592186515674 :step/content {:db/id #edb/ref 17592186383614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8172957c-8ded-58d3-9a23-800391f6abc1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{s}" :db/id #edb/ref 17592186383616} {:answer/id #uuid "65fc28e8-01f1-5779-81a2-95006d854621" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{s}-2t" :db/id #edb/ref 17592186383617} {:answer/id #uuid "78f76e21-a29b-5ac4-bef0-5e96cc36b301" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{e}^{s}-2" :db/id #edb/ref 17592186383618} {:answer/id #uuid "1650585c-4f5b-5c09-98dc-1b8f36155d98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{s}+2+t" :db/id #edb/ref 17592186383619} {:answer/id #uuid "9d243851-27bb-5ff4-9d66-8de5b61c5110" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-{e}^{s}+t" :db/id #edb/ref 17592186383620}] :answer-field/correct {:db/id #edb/ref 17592186383618} :answer-field/id #uuid "a31244f4-c1a2-50a4-adcb-bc5510fae670" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186383615}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "04777d40-e9e1-5da3-94ee-34ffd4874f77" :question/math-academy-id "q-170674" :question/problem "Let $f(x,y,z)=z-x-y,$ where $x={e}^{s}+t,$ $y=s+1$ and $z=1-t-s.$ Calculate $\\frac{∂f}{∂s}.$" :question/worked-solution "![](images/be/be6afcdd0ad9ae0d7ef377c4918442a64e1186c90c25e27ec6c224d816a602fd.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-1,\\,\\frac{∂f}{∂y}=-1,\\,\\frac{∂f}{∂z}=1.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & ={e}^{s}, \\\\ \\frac{∂y}{∂s} & =1, \\\\ \\frac{∂z}{∂s} & =-1.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =(-1)\\cdot {e}^{s}+(-1)\\cdot 1+(1)\\cdot (-1) \\\\  & =-{e}^{s}-2.\\end{aligned}\n$$"} :step/id #uuid "a1ec6cd0-639d-5c32-a34b-e1f726d9e5e0"} {:db/id #edb/ref 17592186515687 :step/content {:db/id #edb/ref 17592186167325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a19a158-cb30-5c9e-9cf9-891ab114ad36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{s}^{2}(2t-1)" :db/id #edb/ref 17592186355012} {:answer/id #uuid "392f1f1c-1dad-5e72-b1e4-40cf201a767c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{s}^{2}t(s-t)" :db/id #edb/ref 17592186355179} {:answer/id #uuid "869f5f73-0c65-5003-ade6-8eeef3e8b4ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{s}^{2}(s-t)" :db/id #edb/ref 17592186355855} {:answer/id #uuid "c2f0fe58-16c4-5d79-ab11-4893e9ff089a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8st(s-1)" :db/id #edb/ref 17592186356369} {:answer/id #uuid "fa6ace28-41b6-5a2e-8b64-9dee698d22fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8st(t-1)" :db/id #edb/ref 17592186356853}] :answer-field/correct {:db/id #edb/ref 17592186356853} :answer-field/id #uuid "6314b903-87e4-5c8c-a8db-703d520d008b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186357085}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e1e3cf4a-155f-587d-ba03-cc737759407e" :question/math-academy-id "q-94448" :question/problem "Let $f(x,y)={x}^{2}-4y,$ where $x=2st$ and $y={s}^{2}t.$ Calculate $\\frac{∂f}{∂s}.$" :question/worked-solution "![](images/21/21cec766fe72965697304ef4288ffb2b090ddfca179210165dbcfd42ec490b27.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2x,\\,\\frac{∂f}{∂y}=-4\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2(2st)=4st, \\\\ \\frac{∂f}{∂y} & =-4.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & =2t, \\\\ \\frac{∂y}{∂s} & =2st.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s} \\\\  & =(4st)(2t)+(-4)(2st) \\\\  & =8s{t}^{2}-8st \\\\  & =8st(t-1).\\end{aligned}\n$$"} :step/id #uuid "bac60d39-22a6-5ac6-a280-51042791f62d" :step/next {:db/id #edb/ref 17592186515621}} {:db/id #edb/ref 17592186515709 :step/content {:db/id #edb/ref 17592186385370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "894ca471-2dd4-5d40-b36a-8da27b160d4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186385372} {:answer/id #uuid "a0652b0f-d1a7-5fb6-a24a-41d904eaf606" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186385373} {:answer/id #uuid "290a2a7e-ad92-516f-ae90-67ba3132c946" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186385374} {:answer/id #uuid "5ad83d4e-e307-5e90-9e4f-cc60c72f71d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186385375} {:answer/id #uuid "10e3eea0-e64b-5459-8cc2-03bcb5ecde36" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186385376}] :answer-field/correct {:db/id #edb/ref 17592186385375} :answer-field/id #uuid "98ca2715-a0aa-5460-b75b-4a47465638ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186385371}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7b9407c6-12a8-5179-a6fb-edc61bbc79bd" :question/math-academy-id "q-37208" :question/problem "Let $f(x,y,z)=\\operatorname{cos}⁡x+{y}^{2}z,$ where $x=3t,$ $y=t-s$ and $z=2st.$ Given that\n\n$$\n\\frac{∂f}{∂t}=-3\\operatorname{sin}⁡3t+{c}_{1}s{t}^{2}+{c}_{2}{s}^{2}t+{c}_{3}{s}^{3},\n$$\n\nfind the value of ${c}_{1}+{c}_{2}+{c}_{3}.$" :question/worked-solution "![](images/b5/b593a1b60fe8c1aef2c5c229ff426db350e6296b9ecb767494283f0fa3342072.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-\\operatorname{sin}⁡x,\\,\\frac{∂f}{∂y}=2yz,\\,\\frac{∂f}{∂z}={y}^{2}.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-\\operatorname{sin}⁡3t, \\\\ \\frac{∂f}{∂y} & =2(t-s)(2st)=4s{t}^{2}-4{s}^{2}t, \\\\ \\frac{∂f}{∂z} & =(t-s)^{2}={t}^{2}-2st+{s}^{2}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =3, \\\\ \\frac{∂y}{∂t} & =1, \\\\ \\frac{∂z}{∂t} & =2s.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =(-\\operatorname{sin}⁡3t)\\cdot 3+(4s{t}^{2}-4{s}^{2}t)\\cdot 1+({t}^{2}-2st+{s}^{2})\\cdot 2s \\\\  & =-3\\operatorname{sin}⁡3t+4s{t}^{2}-4{s}^{2}t+2s{t}^{2}-4{s}^{2}t+2{s}^{3} \\\\  & =-3\\operatorname{sin}⁡3t+6s{t}^{2}-8{s}^{2}t+2{s}^{3}.\\end{aligned}\n$$\n\nFinally, ${c}_{1}=6,$ ${c}_{2}=-8$ and ${c}_{3}=2,$ and therefore\n\n$$\n{c}_{1}+{c}_{2}+{c}_{3}=6+(-8)+2=0.\n$$"} :step/id #uuid "fe99fc10-51d6-55ce-8bf8-4a3e58f9b8d2" :step/next {:db/id #edb/ref 17592186515687}}] :activity/title "The Multivariable Chain Rule" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186514869}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186519644} :activity/id #uuid "c22e0dcd-15c2-55db-9d25-3bdc2b452a55" :activity/scope {:db/id #edb/ref 17592186050031 :topic/id #uuid "27615ef6-ec0e-5e91-b58b-24b70dc01a09" :topic/math-academy-id 3173} :activity/steps [{:db/id #edb/ref 17592186519617 :step/content {:db/id #edb/ref 17592186167331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7aa7cb58-130b-52e2-9ffc-cc9e52330663" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cot}⁡t+2\\operatorname{csc}⁡t" :db/id #edb/ref 17592186358818} {:answer/id #uuid "a1a9cb0c-c43b-5a83-8c67-e7c35f7eae70" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{csc}⁡t-\\operatorname{tan}⁡t" :db/id #edb/ref 17592186359161} {:answer/id #uuid "ea13c98f-b638-5d97-8167-fa566662cb6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{tan}⁡t-\\operatorname{cot}⁡t" :db/id #edb/ref 17592186359835} {:answer/id #uuid "ec49dc46-0ba5-5fda-b9c2-6bec956ac528" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{cot}⁡t-\\operatorname{tan}⁡t" :db/id #edb/ref 17592186359856} {:answer/id #uuid "f7162188-93f3-50e1-8684-87bec1a6cf00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sec}⁡t-\\operatorname{tan}⁡t" :db/id #edb/ref 17592186359937}] :answer-field/correct {:db/id #edb/ref 17592186359856} :answer-field/id #uuid "a955c8c5-959c-5957-86ce-5b5f4f04ba90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360295}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "19a64e51-db17-58fb-852b-340494362842" :question/math-academy-id "q-95078" :question/problem "If $f(x,y)=\\operatorname{ln}⁡(x{y}^{2}),x=\\operatorname{cos}⁡t$ and $y=\\operatorname{sin}⁡t,$ compute $\\frac{\\text{d}f}{\\text{d}t}$ for $0<t<\\frac{\\pi }{2}.$" :question/worked-solution "![](images/f0/f01b253f560405a8c0f4be8f8797c652fb0ddf774f4db110b8822313b8ac50f3.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $t,$ where $x=x(t)$ and $y=y(t),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}t}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{{y}^{2}}{x{y}^{2}}=\\frac{1}{x},\\,\\frac{∂f}{∂y}=\\frac{2xy}{x{y}^{2}}=\\frac{2}{y}\\end{aligned}\n$$\n\nWriting the above results in terms of $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{1}{\\operatorname{cos}⁡t}, \\\\ \\frac{∂f}{∂y} & =\\frac{2}{\\operatorname{sin}⁡t}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}=-\\operatorname{sin}⁡t,\\,\\frac{\\text{d}y}{\\text{d}t}=\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}t} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t} \\\\  & =\\frac{1}{\\operatorname{cos}⁡t}\\cdot (-\\operatorname{sin}⁡t)+\\frac{2}{\\operatorname{sin}⁡t}\\cdot \\operatorname{cos}⁡t \\\\  & =-\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t}+2\\cdot \\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t} \\\\  & =2\\operatorname{cot}⁡t-\\operatorname{tan}⁡t.\\end{aligned}\n$$"} :step/id #uuid "1d1473e6-3651-50ed-9ec9-88f004e468cd" :step/next {:db/id #edb/ref 17592186519623}} {:db/id #edb/ref 17592186519619 :step/content {:db/id #edb/ref 17592186360556 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b80e388-89f0-55d3-9647-29eb1e7d21a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2{csc}^{2}⁡2s" :db/id #edb/ref 17592186357986} {:answer/id #uuid "2931a144-34bf-5b91-9fd0-2c8561636d73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡2s+{csc}^{2}⁡2s" :db/id #edb/ref 17592186358129} {:answer/id #uuid "5f982da7-fadd-5a18-83b3-b5af485d42fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cot}⁡2s" :db/id #edb/ref 17592186358586} {:answer/id #uuid "981660b8-6d8e-5d6b-a353-cc9e60ac0aac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{tan}⁡2s" :db/id #edb/ref 17592186359084} {:answer/id #uuid "d2b01e60-3c8a-5b80-ab36-ad8a68a5308f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{sec}^{2}⁡2s" :db/id #edb/ref 17592186359593}] :answer-field/correct {:db/id #edb/ref 17592186357986} :answer-field/id #uuid "ce0a50c8-6fe1-52e2-992d-16da1ca6ce29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360348}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f22cdf5c-424c-5c09-91c4-a4b6bd7748c9" :question/math-academy-id "q-95084" :question/problem "If $f(x,y)=\\frac{x}{y},x=\\operatorname{cos}⁡2s$ and $y=\\operatorname{sin}⁡2s,$ compute $\\frac{\\text{d}f}{\\text{d}s}.$" :question/worked-solution "![](images/7e/7e5b5001794ecdf2c9b9e9102f334a63d2c59bc6f7511c2eb7fa358fc94cb0c5.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $s,$ where $x=x(s)$ and $y=y(s),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}s}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{1}{y},\\,\\frac{∂f}{∂y}=-\\frac{x}{{y}^{2}}\\end{aligned}\n$$\n\nWriting the above results in terms of $s,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{1}{\\operatorname{sin}⁡2s}, \\\\ \\frac{∂f}{∂y} & =-\\frac{\\operatorname{cos}⁡2s}{{sin}^{2}⁡2s}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}s}=-2\\operatorname{sin}⁡2s,\\,\\frac{\\text{d}y}{\\text{d}s}=2\\operatorname{cos}⁡2s.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}s} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s} \\\\  & =\\frac{1}{\\operatorname{sin}⁡2s}\\cdot (-2\\operatorname{sin}⁡2s)+(-\\frac{\\operatorname{cos}⁡2s}{{sin}^{2}⁡2s})\\cdot 2\\operatorname{cos}⁡2s \\\\  & =-2-2\\cdot \\frac{{cos}^{2}⁡2s}{{sin}^{2}⁡2s} \\\\  & =-2-2{cot}^{2}⁡2s \\\\  & =-2{csc}^{2}⁡2s.\\end{aligned}\n$$"} :step/id #uuid "1f2d63e2-db91-599f-ba79-b154350da4c1" :step/next {:db/id #edb/ref 17592186519639}} {:db/id #edb/ref 17592186519623 :step/content {:db/id #edb/ref 17592186385838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "247ee7d0-904c-5d01-8297-06a98015037c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1+\\frac{1}{\\sqrt{s}}){e}^{\\sqrt{s}}" :db/id #edb/ref 17592186385840} {:answer/id #uuid "7cec0dc1-33bb-5f04-a034-05527df9b19d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1+s){e}^{\\sqrt{s}}" :db/id #edb/ref 17592186385841} {:answer/id #uuid "323b91bd-668a-507d-8f83-8a04b4f2b115" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2+\\sqrt{s}){e}^{\\sqrt{s}}" :db/id #edb/ref 17592186385842} {:answer/id #uuid "ffd6bb8a-7411-5765-b787-90052e6b40f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1+\\frac{1}{2\\sqrt{s}}){e}^{\\sqrt{s}}" :db/id #edb/ref 17592186385843} {:answer/id #uuid "0fbb05f2-b967-534b-9feb-494c22d63500" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1+\\frac{\\sqrt{s}}{2}){e}^{\\sqrt{s}}" :db/id #edb/ref 17592186385844}] :answer-field/correct {:db/id #edb/ref 17592186385844} :answer-field/id #uuid "8f70704d-2718-514e-b670-1b5ed75416ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186385839}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c583feca-7024-59b3-b46e-988493997541" :question/math-academy-id "q-95083" :question/problem "If $f(x,y)=y{e}^{x},$ $x=\\sqrt{s}$ and $y=s,$ compute $\\frac{\\text{d}f}{\\text{d}s}$ for $s>0.$" :question/worked-solution "![](images/7e/7e5b5001794ecdf2c9b9e9102f334a63d2c59bc6f7511c2eb7fa358fc94cb0c5.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $s,$ where $x=x(s)$ and $y=y(s),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}s}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y{e}^{x},\\,\\frac{∂f}{∂y}={e}^{x}\\end{aligned}\n$$\n\nWriting the above results in terms of $s,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =s{e}^{\\sqrt{s}}, \\\\ \\frac{∂f}{∂y} & ={e}^{\\sqrt{s}}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}s}=\\frac{1}{2\\sqrt{s}},\\,\\frac{\\text{d}y}{\\text{d}s}=1.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}s} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s} \\\\  & =s{e}^{\\sqrt{s}}\\cdot \\frac{1}{2\\sqrt{s}}+{e}^{\\sqrt{s}}\\cdot 1 \\\\  & =\\frac{\\sqrt{s}}{2}{e}^{\\sqrt{s}}+{e}^{\\sqrt{s}} \\\\  & =(1+\\frac{\\sqrt{s}}{2}){e}^{\\sqrt{s}}.\\end{aligned}\n$$"} :step/id #uuid "2d471feb-727e-5216-935f-6bc8969b2a48" :step/next {:db/id #edb/ref 17592186519619}} {:db/id #edb/ref 17592186519639 :step/content {:db/id #edb/ref 17592186167332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e272a6d-78d3-5cb9-95c9-c87f0fea3da6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(x+{x}^{2})+\\frac{1+2x}{1+x}" :db/id #edb/ref 17592186357869} {:answer/id #uuid "34692782-e7a3-51e2-939e-c7595c3e9b0d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}\\operatorname{ln}⁡(1+x)" :db/id #edb/ref 17592186358219} {:answer/id #uuid "69e98fd7-fe36-540b-bd06-de9d5d7bdda7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(1+{x}^{2})-\\frac{1+3{x}^{2}}{1+2x}" :db/id #edb/ref 17592186358677} {:answer/id #uuid "7b57f18a-b391-5d2a-a9af-d8d06a8a7f7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡(1+x)-\\frac{1+2{x}^{2}}{1+{x}^{2}}" :db/id #edb/ref 17592186358823} {:answer/id #uuid "9695921f-e190-55c7-a45b-cceb0f8f0066" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+2x}{1+x}" :db/id #edb/ref 17592186359069}] :answer-field/correct {:db/id #edb/ref 17592186357869} :answer-field/id #uuid "000855cc-b4eb-5315-a2d3-71276d48abd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360003}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "56630566-56de-5b10-a1f2-1989c1203d78" :question/math-academy-id "q-95121" :question/problem "If $f(x,y)=x\\operatorname{ln}⁡(x+y)$ and $y={x}^{2},$ compute $\\frac{\\text{d}f}{\\text{d}x}.$" :question/worked-solution "The chain rule for a multivariable function $f(x,y)$ in the case where $y=y(x)$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\operatorname{ln}⁡(x+y)+\\frac{x}{x+y},\\,\\frac{∂f}{∂y}=\\frac{x}{x+y}\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\operatorname{ln}⁡(x+{x}^{2})+\\frac{x}{x+{x}^{2}}, \\\\ \\frac{∂f}{∂y} & =\\frac{x}{x+{x}^{2}}.\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2x.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\operatorname{ln}⁡(x+{x}^{2})+\\frac{x}{x+{x}^{2}}+\\frac{x}{x+{x}^{2}}\\cdot 2x \\\\  & =\\operatorname{ln}⁡(x+{x}^{2})+\\frac{x+2{x}^{2}}{x+{x}^{2}} \\\\  & =\\operatorname{ln}⁡(x+{x}^{2})+\\frac{x(1+2x)}{x(1+x)} \\\\  & =\\operatorname{ln}⁡(x+{x}^{2})+\\frac{1+2x}{1+x}.\\end{aligned}\n$$"} :step/id #uuid "6bc8b7a0-5c37-5a1c-8102-88692aa5f318"} {:db/id #edb/ref 17592186519644 :step/content {:db/id #edb/ref 17592186360552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1830bf59-5084-598f-b1f6-81191dfbfbcf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2+t}{\\sqrt{t\\operatorname{ln}⁡t}}" :db/id #edb/ref 17592186357965} {:answer/id #uuid "26a1cc25-ba10-5462-a7f5-4b6c422818d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{ln}⁡t}{\\sqrt{2t\\operatorname{ln}⁡t}}" :db/id #edb/ref 17592186358100} {:answer/id #uuid "72ac5140-e75a-5b93-834e-7afad4225743" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{2\\operatorname{ln}⁡t}}" :db/id #edb/ref 17592186358751} {:answer/id #uuid "8cdd033a-0457-5b60-bc47-43fcb08320c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+\\sqrt{t}}{\\sqrt{2\\operatorname{ln}⁡t}}" :db/id #edb/ref 17592186358978} {:answer/id #uuid "8ddb28d7-a49c-5dad-b528-bbf182a53bcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1+\\operatorname{ln}⁡t}{\\sqrt{2t\\operatorname{ln}⁡t}}" :db/id #edb/ref 17592186358988}] :answer-field/correct {:db/id #edb/ref 17592186358988} :answer-field/id #uuid "146b2117-94cd-5963-92fa-afe7f73a78f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360033}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e0f22ddd-635a-5638-92e4-fbad8751067f" :question/math-academy-id "q-95077" :question/problem "If $f(x,y)=\\sqrt{2xy},x=t$ and $y=\\operatorname{ln}⁡t,$ compute $\\frac{\\text{d}f}{\\text{d}t}.$" :question/worked-solution "![](images/f0/f01b253f560405a8c0f4be8f8797c652fb0ddf774f4db110b8822313b8ac50f3.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $t,$ where $x=x(t)$ and $y=y(t),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}t}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{y}{\\sqrt{2xy}},\\,\\frac{∂f}{∂y}=\\frac{x}{\\sqrt{2xy}}\\end{aligned}\n$$\n\nWriting the above results in terms of $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{\\operatorname{ln}⁡t}{\\sqrt{2t\\operatorname{ln}⁡t}}, \\\\ \\frac{∂f}{∂y} & =\\frac{t}{\\sqrt{2t\\operatorname{ln}⁡t}}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}=1,\\,\\frac{\\text{d}y}{\\text{d}t}=\\frac{1}{t}.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}t} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t} \\\\  & =\\frac{\\operatorname{ln}⁡t}{\\sqrt{2t\\operatorname{ln}⁡t}}\\cdot 1+\\frac{t}{\\sqrt{2t\\operatorname{ln}⁡t}}\\cdot \\frac{1}{t} \\\\  & =\\frac{\\operatorname{ln}⁡t}{\\sqrt{2t\\operatorname{ln}⁡t}}+\\frac{1}{\\sqrt{2t\\operatorname{ln}⁡t}} \\\\  & =\\frac{1+\\operatorname{ln}⁡t}{\\sqrt{2t\\operatorname{ln}⁡t}}.\\end{aligned}\n$$"} :step/id #uuid "773b2d36-2f0a-57e0-8be2-e48bb09a4815" :step/next {:db/id #edb/ref 17592186519617}}] :activity/title "The Multivariable Chain Rule" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186518986}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186524044} :activity/id #uuid "55cff9f9-18c9-533a-bc34-1923b1ce73b6" :activity/scope {:db/id #edb/ref 17592186050031 :topic/id #uuid "27615ef6-ec0e-5e91-b58b-24b70dc01a09" :topic/math-academy-id 3173} :activity/steps [{:db/id #edb/ref 17592186524041 :step/content {:db/id #edb/ref 17592186360569 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4be18679-efe0-59e6-80ac-db92f8d96a8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\operatorname{sin}⁡x+x\\operatorname{cos}⁡x" :db/id #edb/ref 17592186358407} {:answer/id #uuid "4f9edd72-2523-57c6-9665-681f1ed475c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\operatorname{sin}⁡x-2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186358439} {:answer/id #uuid "9bcdf56c-f98e-5632-8b37-69db930425d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186359116} {:answer/id #uuid "9f4b3c97-4572-526c-8afd-d0a1d5757af5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\operatorname{sin}⁡x+\\operatorname{cos}⁡x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186359141} {:answer/id #uuid "b33efd16-e5a4-5396-8988-6df4afae8ae5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186359315}] :answer-field/correct {:db/id #edb/ref 17592186358407} :answer-field/id #uuid "1f643ac2-8342-50cb-9136-e026a1d69059" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360047}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cfb1f74a-0323-5d9e-a2f6-877356ed98f1" :question/math-academy-id "q-95118" :question/problem "If $f(x,y)={x}^{2}+yx$ and $y=\\operatorname{sin}⁡x,$ compute $\\frac{\\text{d}f}{\\text{d}x}.$" :question/worked-solution "The chain rule for a multivariable function $f(x,y)$ in the case where $y=y(x)$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2x+y,\\,\\frac{∂f}{∂y}=x\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2x+\\operatorname{sin}⁡x \\\\ \\frac{∂f}{∂y} & =x.\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =2x+\\operatorname{sin}⁡x+x\\operatorname{cos}⁡x.\\end{aligned}\n$$"} :step/id #uuid "03875695-6306-58ee-ade0-e90c339315ac" :step/next {:db/id #edb/ref 17592186524107}} {:db/id #edb/ref 17592186524044 :step/content {:db/id #edb/ref 17592186360551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0906d5df-95ee-50f2-a42b-09e69555e339" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4t(1+2t){e}^{{t}^{2}}" :db/id #edb/ref 17592186357833} {:answer/id #uuid "140ea72d-9a0d-57b5-b67c-2049bb317343" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{t}^{2}(1+{t}^{2}){e}^{{t}^{2}}" :db/id #edb/ref 17592186357925} {:answer/id #uuid "9cea513d-612f-5290-b731-384d792ca237" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8t(1+{t}^{2}){e}^{{t}^{2}}" :db/id #edb/ref 17592186359124} {:answer/id #uuid "c0ba0846-4e92-5a2d-b302-7d756aa55faa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8{t}^{3}(2+t){e}^{{t}^{2}}" :db/id #edb/ref 17592186359440} {:answer/id #uuid "e95d1d3f-a370-59d0-97ce-9062ff9fd3d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4t(2+t){e}^{{t}^{2}}" :db/id #edb/ref 17592186359826}] :answer-field/correct {:db/id #edb/ref 17592186359124} :answer-field/id #uuid "d9bfd21b-4c44-5c5c-ba56-5fadb4ae0273" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360377}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4d8c80e5-aa7d-56a9-83f4-b1c7ab4b5caf" :question/math-academy-id "q-95076" :question/problem "If $f(x,y)={x}^{2}{e}^{y},x=2t$ and $y={t}^{2},$ compute $\\frac{\\text{d}f}{\\text{d}t}.$" :question/worked-solution "![](images/f0/f01b253f560405a8c0f4be8f8797c652fb0ddf774f4db110b8822313b8ac50f3.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $t,$ where $x=x(t)$ and $y=y(t),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}t}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2x{e}^{y},\\,\\frac{∂f}{∂y}={x}^{2}{e}^{y}\\end{aligned}\n$$\n\nWriting the above results in terms of $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2(2t){e}^{{t}^{2}}=4t{e}^{{t}^{2}}, \\\\ \\frac{∂f}{∂y} & =(2t)^{2}{e}^{{t}^{2}}=4{t}^{2}{e}^{{t}^{2}}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}=2,\\,\\frac{\\text{d}y}{\\text{d}t}=2t.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}t} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t} \\\\  & =4t{e}^{{t}^{2}}\\cdot 2+4{t}^{2}{e}^{{t}^{2}}\\cdot 2t \\\\  & =8t{e}^{{t}^{2}}+8{t}^{3}{e}^{{t}^{2}} \\\\  & =8t(1+{t}^{2}){e}^{{t}^{2}}.\\end{aligned}\n$$"} :step/id #uuid "1cab00d5-4da8-576c-bf80-814a66279e8a" :step/next {:db/id #edb/ref 17592186524081}} {:db/id #edb/ref 17592186524052 :step/content {:db/id #edb/ref 17592186360571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a85a62-20c8-53ea-9891-50994f57bf9f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4{x}^{2}(x-6)}{x+1}" :db/id #edb/ref 17592186357811} {:answer/id #uuid "31bd0322-e103-58db-ab4e-d490d4079dbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}(3{x}^{2}-1)}{(x+1)^{2}}" :db/id #edb/ref 17592186358194} {:answer/id #uuid "870209e6-e356-5edd-a169-1a95385cbde9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x(3x+4)}{(x+1)^{2}}" :db/id #edb/ref 17592186358933} {:answer/id #uuid "c0ec2678-1f3d-53f9-9edd-d1c6fda28115" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x(4x-3)}{x+1}" :db/id #edb/ref 17592186359444} {:answer/id #uuid "d1925cff-23b1-5f65-a480-35f2ce80acbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{x}^{2}(2x+3)}{(x+1)^{2}}" :db/id #edb/ref 17592186359584}] :answer-field/correct {:db/id #edb/ref 17592186359584} :answer-field/id #uuid "a27a35b5-3297-5a09-b127-d1d744a50e89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360275}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f411889e-b3c1-5aed-8247-b760065e6e98" :question/math-academy-id "q-95122" :question/problem "If $f(x,y)=\\frac{y}{x+1}$ and $y={x}^{3},$ compute $\\frac{\\text{d}f}{\\text{d}x}.$" :question/worked-solution "The chain rule for a multivariable function $f(x,y)$ in the case where $y=y(x)$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-\\frac{y}{(x+1)^{2}},\\,\\frac{∂f}{∂y}=\\frac{1}{x+1}\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-\\frac{{x}^{3}}{(x+1)^{2}}, \\\\ \\frac{∂f}{∂y} & =\\frac{1}{x+1}.\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =3{x}^{2}.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =-\\frac{{x}^{3}}{(x+1)^{2}}+\\frac{1}{x+1}\\cdot 3{x}^{2} \\\\  & =\\frac{3{x}^{2}}{x+1}-\\frac{{x}^{3}}{(x+1)^{2}} \\\\  & =\\frac{3{x}^{2}(x+1)-{x}^{3}}{(x+1)^{2}} \\\\  & =\\frac{3{x}^{3}+3{x}^{2}-{x}^{3}}{(x+1)^{2}} \\\\  & =\\frac{{x}^{2}(2x+3)}{(x+1)^{2}}.\\end{aligned}\n$$"} :step/id #uuid "3a017487-80b3-5b03-a1d5-2934bfa2d036"} {:db/id #edb/ref 17592186524081 :step/content {:db/id #edb/ref 17592186360555 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46f944b8-e799-5036-80f1-5ba5c1a7411f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{ln}⁡2s" :db/id #edb/ref 17592186358364} {:answer/id #uuid "82479d60-5437-50e5-882f-1cefac414e6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+\\operatorname{ln}⁡2s" :db/id #edb/ref 17592186358893} {:answer/id #uuid "f1724fb0-eb83-58dc-8a3f-92689c7862c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{ln}⁡2s" :db/id #edb/ref 17592186359901} {:answer/id #uuid "fe84e3ca-9757-54b8-a1da-085a92705bae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}+\\operatorname{ln}⁡2s" :db/id #edb/ref 17592186359990} {:answer/id #uuid "fede68b1-836b-57e9-a83f-57bb56eb0c3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}+\\operatorname{ln}⁡2s" :db/id #edb/ref 17592186359994}] :answer-field/correct {:db/id #edb/ref 17592186358893} :answer-field/id #uuid "ef608987-b651-5ccb-b9c8-ffdc510994e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360424}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b0e7724b-5745-517d-9a70-23d66bdba953" :question/math-academy-id "q-95081" :question/problem "If $f(x,y)=y+x\\operatorname{ln}⁡y,\\,x=s$ and $y=2s,$ compute $\\frac{\\text{d}f}{\\text{d}s}.$" :question/worked-solution "![](images/7e/7e5b5001794ecdf2c9b9e9102f334a63d2c59bc6f7511c2eb7fa358fc94cb0c5.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $s,$ where $x=x(s)$ and $y=y(s),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}s}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\operatorname{ln}⁡y,\\,\\frac{∂f}{∂y}=1+\\frac{x}{y}\\end{aligned}\n$$\n\nWriting the above results in terms of $s,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\operatorname{ln}⁡2s, \\\\ \\frac{∂f}{∂y} & =1+\\frac{s}{2s}=\\frac{3}{2}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}s}=1,\\,\\frac{\\text{d}y}{\\text{d}s}=2.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}s} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s} \\\\  & =\\operatorname{ln}⁡2s\\cdot 1+\\frac{3}{2}\\cdot 2 \\\\  & =3+\\operatorname{ln}⁡2s.\\end{aligned}\n$$"} :step/id #uuid "9e72f9a3-b2cc-52fb-b449-d5acf347acc1" :step/next {:db/id #edb/ref 17592186524041}} {:db/id #edb/ref 17592186524107 :step/content {:db/id #edb/ref 17592186360570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23dbcf33-c576-54cf-8c07-43b62cf69983" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1+4{x}^{2})\\operatorname{cos}⁡(\\frac{{x}^{2}-1}{x})" :db/id #edb/ref 17592186358069} {:answer/id #uuid "558df00d-6a5e-5bb3-bb8a-e8288e5b1e90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1-4{x}^{3}}{x})\\operatorname{cos}⁡(\\frac{{x}^{3}+1}{{x}^{2}})" :db/id #edb/ref 17592186358497} {:answer/id #uuid "67861fb7-92d5-5f5e-8f74-f8ff3c7f315c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1-3{x}^{3})\\operatorname{sin}⁡(\\frac{{x}^{2}+1}{{x}^{2}})" :db/id #edb/ref 17592186358655} {:answer/id #uuid "70539894-ff4f-5b7d-809c-ae8c476c88fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1-2{x}^{3}}{{x}^{2}})\\operatorname{sin}⁡(\\frac{{x}^{3}+1}{x})" :db/id #edb/ref 17592186358729} {:answer/id #uuid "da024232-5563-5f22-a044-1622a067232a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{2{x}^{2}+1}{x})\\operatorname{sin}⁡(\\frac{{x}^{3}+1}{x})" :db/id #edb/ref 17592186359659}] :answer-field/correct {:db/id #edb/ref 17592186358729} :answer-field/id #uuid "f550e8b8-0dda-5ff3-ba5c-bfed41503899" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186360429}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5f396a56-19fc-58e7-855c-d3a310fbb9ec" :question/math-academy-id "q-95119" :question/problem "If $f(x,y)=\\operatorname{cos}⁡({x}^{2}+y)$ and $y=\\frac{1}{x},$ compute $\\frac{\\text{d}f}{\\text{d}x}.$" :question/worked-solution "The chain rule for a multivariable function $f(x,y)$ in the case where $y=y(x)$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-2x\\operatorname{sin}⁡({x}^{2}+y),\\,\\frac{∂f}{∂y}=-\\operatorname{sin}⁡({x}^{2}+y)\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-2x\\operatorname{sin}⁡({x}^{2}+\\frac{1}{x}), \\\\ \\frac{∂f}{∂y} & =-\\operatorname{sin}⁡({x}^{2}+\\frac{1}{x}).\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{{x}^{2}}.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =-2x\\operatorname{sin}⁡({x}^{2}+\\frac{1}{x})+(-\\operatorname{sin}⁡({x}^{2}+\\frac{1}{x}))\\cdot (-\\frac{1}{{x}^{2}}) \\\\  & =(\\frac{1}{{x}^{2}}-2x)\\operatorname{sin}⁡({x}^{2}+\\frac{1}{x}) \\\\  & =(\\frac{1-2{x}^{3}}{{x}^{2}})\\operatorname{sin}⁡(\\frac{{x}^{3}+1}{x}).\\end{aligned}\n$$"} :step/id #uuid "fac2284d-62e5-5d58-b0c1-c75c972f080b" :step/next {:db/id #edb/ref 17592186524052}}] :activity/title "The Multivariable Chain Rule" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186523241}]}
