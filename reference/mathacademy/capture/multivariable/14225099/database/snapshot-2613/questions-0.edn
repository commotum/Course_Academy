swer.type/math} :answer/value "\\frac{3\\pi}{5}" :db/id #edb/ref 17592186543288}] :answer-field/correct {:answer/id #uuid "fe5b3ed0-b28b-5660-bf5d-280988f431a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi}{5}" :db/id #edb/ref 17592186543288} :answer-field/id #uuid "b908beae-827a-5298-91c7-8d25daaa56eb" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543429} {:answer-field/choices [{:answer/id #uuid "7df8d642-eb2b-5117-a7ea-b486589f0caf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186542979}] :answer-field/correct {:answer/id #uuid "7df8d642-eb2b-5117-a7ea-b486589f0caf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186542979} :answer-field/id #uuid "e4ca8561-971c-5261-a117-e700d3f41a23" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543453}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7afac99d-b74c-555b-b269-d08cbbf29447" :question/math-academy-id "q-274686" :question/problem "Expressed in **ascending order** in radians, the exact solutions to the equation $2\\operatorname{cos}⁡(5x)+2=0,$ for $0\\le x<2\\pi ,$  are\n\n${x}_{1}=$\n {{field-1}}$,\\,{x}_{2}=$ \n{{field-2}}$,\\,{x}_{3}=$ \n{{field-3}}$,\\,{x}_{4}=$ \n{{field-4}}$,\\,{x}_{5}=$ \n{{field-5}}." :question/worked-solution "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}2\\operatorname{cos}⁡(5x)+2 & =0 \\\\ 2\\operatorname{cos}⁡(5x) & =-2 \\\\ \\operatorname{cos}⁡(5x) & =-1\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}5x & =\\pi +2n\\pi .\\end{aligned}\n$$\n\nSolving our two equations for $x$ gives:\n\n$$\n\\begin{aligned}x & =\\frac{\\pi +2n\\pi }{5} \\\\ x & =\\frac{(2n+1)\\pi }{5}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{5}.$\n\n- Setting $n=1$ gives $x=\\frac{3\\pi }{5}.$\n\n- Setting $n=2$ gives $x=\\pi .$\n\n- Setting $n=3$ gives $x=\\frac{7\\pi }{5}.$\n\n- Setting $n=4$ gives $x=\\frac{9\\pi }{5}.$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$ \n\nSo, in ascending order, the solutions are\n\n$$\n{x}_{1}=\\frac{\\pi }{5},\\,{x}_{2}=\\frac{3\\pi }{5},\\,{x}_{3}=\\pi ,\\,{x}_{4}=\\frac{7\\pi }{5},\\,{x}_{5}=\\frac{9\\pi }{5}.\n$$"}] [{:db/id #edb/ref 17592186543473 :knowledge-point/_questions [{:db/id #edb/ref 17592186092173 :knowledge-point/id #uuid "1286cc9b-2080-5541-88e1-d4d2741ea1e5" :knowledge-point/title "Solving a Trigonometric Equation Containing the Cosine Function Transformed by Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2590cfe-0743-5c78-9389-41aa7df8f373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186543147}] :answer-field/correct {:answer/id #uuid "c2590cfe-0743-5c78-9389-41aa7df8f373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186543147} :answer-field/id #uuid "7779d086-41e5-5d94-b000-b1baac985d4d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543372} {:answer-field/choices [{:answer/id #uuid "f6c5a7c9-066c-5198-a3ef-fbb1ede3de63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186543272}] :answer-field/correct {:answer/id #uuid "f6c5a7c9-066c-5198-a3ef-fbb1ede3de63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186543272} :answer-field/id #uuid "878e4009-95f9-5dc4-a0a9-39ce168a65ce" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543384}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0663d30d-9045-55b3-9c5e-7d0dcf4eda51" :question/math-academy-id "q-335497" :question/problem "Expressed in **ascending order** in degrees, the exact solutions to the equation $3\\operatorname{cos}⁡(\\frac{3x}{2}-{60}^{∘})+\\frac{3}{2}=0,$ for $0\\le x<{360}^{∘},$  are\n\n${x}_{1}=$\n {{field-1}}${}^{∘},\\,{x}_{2}=$ \n{{field-2}}${}^{∘}.$" :question/worked-solution "First, we rearrange the equation as follows:\n\n$$\n\\begin{aligned}3\\operatorname{cos}⁡(\\frac{3x}{2}-{60}^{∘})+\\frac{3}{2} & =0 \\\\ 3\\operatorname{cos}⁡(\\frac{3x}{2}-{60}^{∘}) & =-\\frac{3}{2} \\\\ \\operatorname{cos}⁡(\\frac{3x}{2}-{60}^{∘}) & =-\\frac{1}{2}\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}\\frac{3x}{2}-{60}^{∘} & ={120}^{∘}+n\\cdot {360}^{∘}, & \\, & \\, & \\frac{3x}{2}-{60}^{∘} & ={240}^{∘}+n\\cdot {360}^{∘}.\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}\\frac{3x}{2} & ={120}^{∘}+{60}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & \\frac{3x}{2} & ={240}^{∘}+{60}^{∘}+n\\cdot {360}^{∘} \\\\ \\frac{3x}{2} & ={180}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & \\frac{3x}{2} & ={300}^{∘}+n\\cdot {360}^{∘} \\\\ 3x & ={360}^{∘}+n\\cdot {720}^{∘} & \\, & \\, & 3x & ={600}^{∘}+n\\cdot {720}^{∘} \\\\ x & ={120}^{∘}+n\\cdot {240}^{∘} & \\, & \\, & x & ={200}^{∘}+n\\cdot {240}^{∘}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain\n$0\\le x<{360}^{∘}.$\n\n- Setting $n=0$ gives $x={120}^{∘},$ and $x={200}^{∘}.$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<{360}^{∘}.$\n\nSo, in ascending order, the solutions are\n\n$$\n{x}_{1}={120}^{∘},\\,{x}_{2}={200}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186543512 :knowledge-point/_questions [{:db/id #edb/ref 17592186092173 :knowledge-point/id #uuid "1286cc9b-2080-5541-88e1-d4d2741ea1e5" :knowledge-point/title "Solving a Trigonometric Equation Containing the Cosine Function Transformed by Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7049029-dac1-5b25-b0a9-4b9ed11b7bb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "250" :db/id #edb/ref 17592186543227}] :answer-field/correct {:answer/id #uuid "e7049029-dac1-5b25-b0a9-4b9ed11b7bb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "250" :db/id #edb/ref 17592186543227} :answer-field/id #uuid "1e2bf51a-4f30-5939-a652-759a030f310a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543307} {:answer-field/choices [{:answer/id #uuid "1dfb5ef9-f5ff-55e0-8809-ca5e77424e40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186542719}] :answer-field/correct {:answer/id #uuid "1dfb5ef9-f5ff-55e0-8809-ca5e77424e40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186542719} :answer-field/id #uuid "ec0e8f49-f5e9-53fe-ab58-580c2c1ca697" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543459} {:answer-field/choices [{:answer/id #uuid "6b7f9c83-02c1-5e70-9da1-af9c14a34e35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "340" :db/id #edb/ref 17592186542929}] :answer-field/correct {:answer/id #uuid "6b7f9c83-02c1-5e70-9da1-af9c14a34e35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "340" :db/id #edb/ref 17592186542929} :answer-field/id #uuid "f8f063af-1dfe-5ae0-9262-3faf246fb3e4" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543466}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "689ab27d-73f0-5878-911e-f4bfe8b4c90e" :question/math-academy-id "q-335752" :question/problem "Expressed in **ascending order** in degrees, the exact solutions to the equation $\\operatorname{cos}⁡(4x+{20}^{∘})=\\frac{1}{2},$ for ${0}^{∘}\\le x<{360}^{∘},$ are ${x}_{1},{x}_{2},{x}_{3},{x}_{4},{x}_{5},{x}_{6},{x}_{7},$ and ${x}_{8}.$ Determine ${x}_{3},$ ${x}_{6},$ and ${x}_{8}.$\n\n$\\,{x}_{3}=$ \n{{field-1}}${}^{∘},\\,{x}_{6}=$ \n{{field-2}}${}^{∘},\\,{x}_{8}=$ \n{{field-3}}${}^{∘}.$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}4x+{20}^{∘} & ={60}^{∘}+n\\cdot {360}^{∘}, & \\, & \\, & 4x+{20}^{∘} & ={300}^{∘}+n\\cdot {360}^{∘}.\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}4x & ={60}^{∘}-{20}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & 4x & ={300}^{∘}-{20}^{∘}+n\\cdot {360}^{∘} \\\\ 4x & ={40}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & 4x & ={280}^{∘}+n\\cdot {360}^{∘} \\\\ x & ={10}^{∘}+n\\cdot {90}^{∘} & \\, & \\, & x & ={70}^{∘}+n\\cdot {90}^{∘}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain ${0}^{∘}\\le x<{360}^{∘}.$\n\n- Setting $n=0$ gives $x={10}^{∘}$ and $x={70}^{∘}.$\n\n- Setting $n=1$ gives $x={100}^{∘}$ and $x={160}^{∘}.$\n\n- Setting $n=2$ gives $x={190}^{∘}$ and $x={250}^{∘}.$\n\n- Setting $n=3$ gives $x={280}^{∘}$ and $x={340}^{∘}.$\n\nAll other integer values of $n$ generate solutions outside the domain ${0}^{∘}\\le x<{360}^{∘}.$ \n\nSo, in ascending order, the solutions are\n\n$$\n\\begin{aligned}{x}_{1} & ={10}^{∘},\\, & {x}_{2} & ={70}^{∘},\\, & {x}_{3} & ={100}^{∘}, & {x}_{4} & ={160}^{∘},\\, \\\\ {x}_{5} & ={190}^{∘},\\, & {x}_{6} & ={250}^{∘},\\, & {x}_{7} & ={280}^{∘}, & {x}_{8} & ={340}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186543495 :knowledge-point/_questions [{:db/id #edb/ref 17592186092173 :knowledge-point/id #uuid "1286cc9b-2080-5541-88e1-d4d2741ea1e5" :knowledge-point/title "Solving a Trigonometric Equation Containing the Cosine Function Transformed by Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "845d5508-0277-5506-af04-f8743869a08e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186542993}] :answer-field/correct {:answer/id #uuid "845d5508-0277-5506-af04-f8743869a08e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186542993} :answer-field/id #uuid "3541aadb-cc54-5704-a42d-4d1a7872ed3b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543323} {:answer-field/choices [{:answer/id #uuid "b482e662-fd2a-50e9-89dd-a5931b7d5547" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186543108}] :answer-field/correct {:answer/id #uuid "b482e662-fd2a-50e9-89dd-a5931b7d5547" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186543108} :answer-field/id #uuid "a66d7b3d-8473-5ef9-a750-65b48209e520" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543409} {:answer-field/choices [{:answer/id #uuid "df447177-ab9b-5f56-8c5d-57b790680d2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "330" :db/id #edb/ref 17592186543208}] :answer-field/correct {:answer/id #uuid "df447177-ab9b-5f56-8c5d-57b790680d2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "330" :db/id #edb/ref 17592186543208} :answer-field/id #uuid "bd5fb88d-f9cd-588b-9d6c-0e9acff9fa9f" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543432}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "468c5cf8-2c4e-5dd6-96eb-d94e2d3f4648" :question/math-academy-id "q-335765" :question/problem "Expressed in **ascending order** in degrees, the exact solutions to the equation $4\\operatorname{cos}⁡(3x+{30}^{∘})-2=0,$ for ${0}^{∘}\\le x<{360}^{∘},$ are ${x}_{1},{x}_{2},{x}_{3},{x}_{4},{x}_{5},$ and ${x}_{6}.$ Determine ${x}_{2},$ ${x}_{4},$ and ${x}_{6}.$\n\n$\\,{x}_{2}=$ \n{{field-1}}${}^{∘},\\,{x}_{4}=$ \n{{field-2}}${}^{∘},\\,{x}_{6}=$ \n{{field-3}}${}^{∘}.$" :question/worked-solution "First, we rearrange the equation as follows:\n\n$$\n\\begin{aligned}4\\operatorname{cos}⁡(3x+{30}^{∘})-2 & =0 \\\\ 4\\operatorname{cos}⁡(3x+{30}^{∘}) & =2 \\\\ \\operatorname{cos}⁡(3x+{30}^{∘}) & =\\frac{1}{2}\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}3x+{30}^{∘} & ={60}^{∘}+n\\cdot {360}^{∘}, & \\, & \\, & 3x+{30}^{∘} & ={300}^{∘}+n\\cdot {360}^{∘}.\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}3x & ={60}^{∘}-{30}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & 3x & ={300}^{∘}-{30}^{∘}+n\\cdot {360}^{∘} \\\\ 3x & ={30}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & 3x & ={270}^{∘}+n\\cdot {360}^{∘} \\\\ x & ={10}^{∘}+n\\cdot {120}^{∘} & \\, & \\, & x & ={90}^{∘}+n\\cdot {120}^{∘}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain ${0}^{∘}\\le x<{360}^{∘}.$\n\n- Setting $n=0$ gives $x={10}^{∘}$ and $x={90}^{∘}.$\n\n- Setting $n=1$ gives $x={130}^{∘}$ and $x={210}^{∘}.$\n\n- Setting $n=2$ gives $x={250}^{∘}$ and $x={330}^{∘}.$\n\nAll other integer values of $n$ generate solutions outside the domain ${0}^{∘}\\le x<{360}^{∘}.$  \n\nSo, in ascending order, the solutions are\n\n$$\n{x}_{1}={10}^{∘},\\,{x}_{2}={90}^{∘},\\,{x}_{3}={130}^{∘},\\,{x}_{4}={210}^{∘},\\,{x}_{5}={250}^{∘},\\,{x}_{6}={330}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186543509 :knowledge-point/_questions [{:db/id #edb/ref 17592186092174 :knowledge-point/id #uuid "9e880672-e776-5701-8168-730f7012f5b0" :knowledge-point/title "Solving a Trigonometric Equation Containing a Transformed Cosine Function Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa4f820-013c-52fa-b244-38fafa8db366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186542709}] :answer-field/correct {:answer/id #uuid "1aa4f820-013c-52fa-b244-38fafa8db366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186542709} :answer-field/id #uuid "ada90f2e-5064-56a4-aabd-120c6b51216d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543417} {:answer-field/choices [{:answer/id #uuid "d9a00334-4f57-5b02-bfff-2b787d85af60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-180" :db/id #edb/ref 17592186543197}] :answer-field/correct {:answer/id #uuid "d9a00334-4f57-5b02-bfff-2b787d85af60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-180" :db/id #edb/ref 17592186543197} :answer-field/id #uuid "deb66c26-5f33-5200-8bd7-282e210c4347" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543448}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "637ba677-860c-50d3-9633-f9db8d1adb0f" :question/math-academy-id "q-335807" :question/problem "Expressed in **ascending order** in degrees, the exact solutions to the equation $\\operatorname{cos}⁡(\\frac{x}{2}+{30}^{∘})=\\frac{1}{2},$ for $-{180}^{∘}\\le x<{180}^{∘},$  are\n\n${x}_{1}=$\n{{field-1}}${}^{∘},\\,{x}_{2}=$\n{{field-2}}${}^{∘}.$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}\\frac{x}{2}+{30}^{∘} & ={60}^{∘}+n\\cdot {360}^{∘}, & \\, & \\, & \\frac{x}{2}+{30}^{∘} & ={300}^{∘}+n\\cdot {360}^{∘}.\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}\\frac{x}{2} & ={60}^{∘}-{30}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & \\frac{x}{2} & ={300}^{∘}-{30}^{∘}+n\\cdot {360}^{∘} \\\\ \\frac{x}{2} & ={30}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & \\frac{x}{2} & ={270}^{∘}+n\\cdot {360}^{∘} \\\\ x & ={60}^{∘}+n\\cdot {720}^{∘} & \\, & \\, & x & ={540}^{∘}+n\\cdot {720}^{∘}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $-{180}^{∘}\\le x<{180}^{∘}.$\n\n- Setting $n=-1$ gives $x=-{660}^{∘}$ and $x=-{180}^{∘}.$  We reject the solution $-{660}^{∘}$ since it lies outside the domain of interest.\n\n- Setting $n=0$ gives $x={60}^{∘}$ and $x={540}^{∘}.$  We reject the solution ${540}^{∘}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain $-{180}^{∘}\\le x<{180}^{∘}.$ \n\nSo, in ascending order, the solutions are \n\n$$\n{x}_{1}={-180}^{∘},\\,{x}_{2}={60}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186543527 :knowledge-point/_questions [{:db/id #edb/ref 17592186092174 :knowledge-point/id #uuid "9e880672-e776-5701-8168-730f7012f5b0" :knowledge-point/title "Solving a Trigonometric Equation Containing a Transformed Cosine Function Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d90f992-2297-5d05-ac55-9ba4508a814d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186542932}] :answer-field/correct {:answer/id #uuid "6d90f992-2297-5d05-ac55-9ba4508a814d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186542932} :answer-field/id #uuid "1480127b-3372-528c-becd-c6fd13cbb58d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543302} {:answer-field/choices [{:answer/id #uuid "9c63190b-23bc-5290-8d3f-231a362b63e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17\\pi}{18}" :db/id #edb/ref 17592186543050}] :answer-field/correct {:answer/id #uuid "9c63190b-23bc-5290-8d3f-231a362b63e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17\\pi}{18}" :db/id #edb/ref 17592186543050} :answer-field/id #uuid "431ae314-3de9-59e8-bfd8-a5f31a6afc22" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543334} {:answer-field/choices [{:answer/id #uuid "a061380a-b6d7-5415-aa51-6d76659ce87d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi}{18}" :db/id #edb/ref 17592186543064}] :answer-field/correct {:answer/id #uuid "a061380a-b6d7-5415-aa51-6d76659ce87d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi}{18}" :db/id #edb/ref 17592186543064} :answer-field/id #uuid "4850e080-9da6-5a10-9e66-b565a38821ca" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543336}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8d85e958-8094-54f0-80e0-53c48caaf572" :question/math-academy-id "q-338812" :question/problem "Expressed in **ascending order** in radians, the exact solutions to the equation $4\\operatorname{cos}⁡(3x-\\frac{\\pi }{6})+2=0,$ for $0<x<\\pi ,$  are\n\n${x}_{1}=$ \n{{field-1}}$,\\,{x}_{2}=$ \n{{field-2}}$,\\,{x}_{3}=$ \n{{field-3}}." :question/worked-solution "First, we rearrange the equation as follows:\n\n$$\n\\begin{aligned}4\\operatorname{cos}⁡(3x-\\frac{\\pi }{6})+2 & =0 \\\\ 4\\operatorname{cos}⁡(3x-\\frac{\\pi }{6}) & =-2 \\\\ \\operatorname{cos}⁡(3x-\\frac{\\pi }{6}) & =-\\frac{1}{2}\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}3x-\\frac{\\pi }{6} & =\\frac{2\\pi }{3}+n\\cdot 2\\pi , & \\, & \\, & 3x-\\frac{\\pi }{6} & =\\frac{4\\pi }{3}+n\\cdot 2\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}3x & =\\frac{2\\pi }{3}+\\frac{\\pi }{6}+n\\cdot 2\\pi  & \\, & \\, & 3x & =\\frac{4\\pi }{3}+\\frac{\\pi }{6}+n\\cdot 2\\pi  \\\\ 3x & =\\frac{5\\pi }{6}+n\\cdot 2\\pi  & \\, & \\, & 3x & =\\frac{3\\pi }{2}+n\\cdot 2\\pi  \\\\ x & =\\frac{5\\pi }{18}+n\\cdot \\frac{2\\pi }{3} & \\, & \\, & x & =\\frac{\\pi }{2}+n\\cdot \\frac{2\\pi }{3}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0<x<\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{5\\pi }{18}$ and $x=\\frac{\\pi }{2}.$\n\n- Setting $n=1$ gives $x=\\frac{17\\pi }{18}$ and $x=\\frac{7\\pi }{6}.$  We reject the solution $\\frac{7\\pi }{6}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain $0<x<\\pi .$ \n\nSo, in ascending order, the solutions are \n\n$$\n{x}_{1}=\\frac{5\\pi }{18},\\,{x}_{2}=\\frac{\\pi }{2},\\,{x}_{3}=\\frac{17\\pi }{18}.\n$$"}] [{:db/id #edb/ref 17592186543555 :knowledge-point/_questions [{:db/id #edb/ref 17592186092172 :knowledge-point/id #uuid "b6d31a25-823d-59b2-897c-61a75b747c01" :knowledge-point/title "Solving a Trigonometric Equation Containing the Cosine Function Transformed by One Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7574b035-fb76-58c1-aaf3-b6389076e7bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi}{2}" :db/id #edb/ref 17592186542947}] :answer-field/correct {:answer/id #uuid "7574b035-fb76-58c1-aaf3-b6389076e7bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi}{2}" :db/id #edb/ref 17592186542947} :answer-field/id #uuid "a7620e10-48ae-5504-a96e-87ea7b96af22" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543413} {:answer-field/choices [{:answer/id #uuid "580a354e-1779-5718-b38a-6a25da50d38b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi}{6}" :db/id #edb/ref 17592186542880}] :answer-field/correct {:answer/id #uuid "580a354e-1779-5718-b38a-6a25da50d38b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi}{6}" :db/id #edb/ref 17592186542880} :answer-field/id #uuid "e477022f-fdfc-5eff-a7bd-6ef731fb7877" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186543451}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bf7fd672-fd24-5897-b0f7-1572fe68c96d" :question/math-academy-id "q-339149" :question/problem "Expressed in **ascending order** in radians, the exact solutions to the equation $cos\\,(x+\\frac{\\pi }{6})=\\frac{1}{2},$ for $0\\le x<2\\pi ,$ are\n\n${x}_{1}=$ \n{{field-1}}, $\\,{x}_{2}=$ \n{{field-2}}." :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}x+\\frac{\\pi }{6} & =\\frac{\\pi }{3}+n\\cdot 2\\pi , & \\, & \\, & x+\\frac{\\pi }{6} & =\\frac{5\\pi }{3}+n\\cdot 2\\pi .\\end{aligned}\n$$\n\nSolving our two equations for $x$ gives:\n\n$$\n\\begin{aligned}x & =\\frac{\\pi }{3}-\\frac{\\pi }{6}+n\\cdot 2\\pi  & \\, & \\, & x & =\\frac{5\\pi }{3}-\\frac{\\pi }{6}+n\\cdot 2\\pi  \\\\ x & =\\frac{\\pi }{6}+n\\cdot 2\\pi  & \\, & \\, & x & =\\frac{3\\pi }{2}+n\\cdot 2\\pi \\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{6}$ and $x=\\frac{3\\pi }{2}.$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$\n\nSo, the solutions to the equation, in ascending order, are \n\n$$\n{x}_{1}=\\frac{\\pi }{6},\\,{x}_{2}=\\frac{3\\pi }{2}.\n$$"}] [{:db/id #edb/ref 17592186543494 :knowledge-point/_questions [{:db/id #edb/ref 17592186092172 :knowledge-point/id #uuid "b6d31a25-823d-59b2-897c-61a75b747c01" :knowledge-point/title "Solving a Trigonometric Equation Containing the Cosine Function Transformed by One Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "167b02e4-ac13-5d64-88eb-49c8c9c919f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72\\,000" :db/id #edb/ref 17592186542696} {:answer/id #uuid "504bef0b-52d3-50be-91b2-f61bc23375e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,000" :db/id #edb/ref 17592186542859} {:answer/id #uuid "73e4e320-b54b-57f9-8435-ec96b175b323" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28\\,800" :db/id #edb/ref 17592186542944} {:answer/id #uuid "97a93b64-15dd-5069-a484-3b6fbc1f93e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\,400" :db/id #edb/ref 17592186543035} {:answer/id #uuid "b99395a0-9e8a-5e48-8de9-94bf037a2e4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,200" :db/id #edb/ref 17592186543124}] :answer-field/correct {:answer/id #uuid "97a93b64-15dd-5069-a484-3b6fbc1f93e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\,400" :db/id #edb/ref 17592186543035} :answer-field/id #uuid "a30da6f7-4089-5e7e-8e3b-203eef88447f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543408}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44457776-708f-510a-afa3-90718ee8b770" :question/math-academy-id "q-65968" :question/problem "Consider the equation $\\operatorname{cos}⁡2x=-\\frac{1}{2}$ for ${0}^{∘}\\le x<{360}^{∘}.$ If the solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ are written in ascending order,  what is the numerical value of ${x}_{1}\\cdot {x}_{3}?$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}2x & ={120}^{∘}+n\\cdot {360}^{∘}, & \\, & \\, & 2x & ={240}^{∘}+n\\cdot {360}^{∘}.\\end{aligned}\n$$\n\nSolving our two equations for $x$ gives:\n\n$$\n\\begin{aligned}x & =\\frac{{120}^{∘}}{2}+\\frac{n\\cdot {360}^{∘}}{2} & \\, & \\, & x & =\\frac{{240}^{∘}}{2}+\\frac{n\\cdot {360}^{∘}}{2} \\\\ x & ={60}^{∘}+n\\cdot {180}^{∘} & \\, & \\, & x & ={120}^{∘}+n\\cdot {180}^{∘}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain ${0}^{∘}\\le x<{360}^{∘}.$\n\n- Setting $n=0$ gives $x={60}^{∘}$ and $x={120}^{∘}$\n\n- Setting $n=1$ gives $x={240}^{∘}$ and $x={300}^{∘}$\n\nAll other values of $n$ generate solutions outside the domain ${0}^{∘}\\le x<{360}^{∘}.$ So, the solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ (written in ascending order) are\n\n$$\nx={60}^{∘},\\,{120}^{∘},\\,{240}^{∘},\\,{300}^{∘}\n$$\n\nFinally, since ${x}_{1}={60}^{∘}$ and ${x}_{3}={240}^{∘},$ the numerical value of ${x}_{1}\\cdot {x}_{3}$ is $60\\cdot 240=14\\,400.$"}] [{:db/id #edb/ref 17592186543584 :knowledge-point/_questions [{:db/id #edb/ref 17592186092174 :knowledge-point/id #uuid "9e880672-e776-5701-8168-730f7012f5b0" :knowledge-point/title "Solving a Trigonometric Equation Containing a Transformed Cosine Function Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15bd6583-d234-5634-9629-19b45df33048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35{\\pi }^{2}}{144}" :db/id #edb/ref 17592186542693} {:answer/id #uuid "5bf9f519-7e9a-582e-ba24-2db80b66b0c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{3}" :db/id #edb/ref 17592186542887} {:answer/id #uuid "9145a808-7c66-5308-8a18-4bcd731ea879" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186543019} {:answer/id #uuid "aa868f03-9cf5-5643-ae39-66d4807c5346" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{9}" :db/id #edb/ref 17592186543089} {:answer/id #uuid "b76b1697-f9b4-5319-9e00-35a7fd2da032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{\\pi }^{2}}{25}" :db/id #edb/ref 17592186543119}] :answer-field/correct {:answer/id #uuid "15bd6583-d234-5634-9629-19b45df33048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35{\\pi }^{2}}{144}" :db/id #edb/ref 17592186542693} :answer-field/id #uuid "991d8fa8-582c-5364-b708-a7dbf249588d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543392}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ef6f56bf-b6a0-53ab-9821-d8f13185e30a" :question/math-academy-id "q-65970" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cos}⁡2x=-\\frac{\\sqrt{3}}{2}$ for $0\\le x<\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x & =-\\frac{5\\pi }{6}+2n\\pi , & \\, & \\, & 2x & =\\frac{5\\pi }{6}+2n\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}2x & =-\\frac{5\\pi }{6}+2n\\pi  & \\, & \\, & 2x & =\\frac{5\\pi }{6}+2n\\pi  \\\\ x & =-\\frac{5\\pi }{12}+n\\pi  & \\, & \\, & x & =\\frac{5\\pi }{12}+n\\pi  \\\\ x & =\\frac{(12n-5)\\pi }{12} & \\, & \\, & x & =\\frac{(12n+5)\\pi }{12}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<\\pi .$\n\n- Setting $n=0$ gives $x=-\\frac{5\\pi }{12}$ and $x=\\frac{5\\pi }{12}.$ We reject the solution $-\\frac{5\\pi }{12}$ since it lies outside the domain of interest.\n\n- Setting $n=1$ gives $x=\\frac{7\\pi }{12}$ and $x=\\frac{17\\pi }{12}.$ We reject the solution $\\frac{17\\pi }{12}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<\\pi .$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{5\\pi }{12}\\cdot \\frac{7\\pi }{12}=\\frac{35{\\pi }^{2}}{144}.\n$$"}] [{:db/id #edb/ref 17592186543588 :knowledge-point/_questions [{:db/id #edb/ref 17592186092174 :knowledge-point/id #uuid "9e880672-e776-5701-8168-730f7012f5b0" :knowledge-point/title "Solving a Trigonometric Equation Containing a Transformed Cosine Function Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1370b931-f307-514b-acc4-b0c230734c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{\\pi }^{2}}{4}" :db/id #edb/ref 17592186542689} {:answer/id #uuid "1b1a8038-c551-5e26-9b1f-f7016b6e0545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{16}" :db/id #edb/ref 17592186542710} {:answer/id #uuid "45a03d7c-c8d6-5f14-af62-73e1fcf2af10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{\\pi }^{2}}{9}" :db/id #edb/ref 17592186542829} {:answer/id #uuid "52f06248-697b-5956-9ee8-1508ba5f0b5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{\\pi }^{2}}{25}" :db/id #edb/ref 17592186542862} {:answer/id #uuid "d30ec1f8-9a77-5358-8c53-8e66abf6be5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186543183}] :answer-field/correct {:answer/id #uuid "d30ec1f8-9a77-5358-8c53-8e66abf6be5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186543183} :answer-field/id #uuid "7432eaab-38b7-5b84-9d2a-70e7ae9a23c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543366}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f8328338-c374-57d6-bab7-26f0397ea50b" :question/math-academy-id "q-65971" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cos}⁡2x=\\frac{1}{2}$ for $0\\le x<\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x & =-\\frac{\\pi }{3}+2n\\pi , & \\, & \\, & 2x & =\\frac{\\pi }{3}+2n\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}2x & =-\\frac{\\pi }{3}+2n\\pi  & \\, & \\, & 2x & =\\frac{\\pi }{3}+2n\\pi  \\\\ x & =-\\frac{\\pi }{6}+n\\pi  & \\, & \\, & x & =\\frac{\\pi }{6}+n\\pi  \\\\ x & =\\frac{(6n-1)\\pi }{6} & \\, & \\, & x & =\\frac{(6n+1)\\pi }{6}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<\\pi .$\n\n- Setting $n=0$ gives $x=-\\frac{\\pi }{6}$ and $x=\\frac{\\pi }{6}.$ We reject the solution $-\\frac{\\pi }{6}$ since it lies outside the domain of interest.\n\n- Setting $n=1$ gives $x=\\frac{5\\pi }{6}$ and $x=\\frac{7\\pi }{6}.$ We reject the solution $\\frac{7\\pi }{6}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<\\pi .$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{6}\\cdot \\frac{5\\pi }{6}=\\frac{5{\\pi }^{2}}{36}.\n$$"}] [{:db/id #edb/ref 17592186543558 :knowledge-point/_questions [{:db/id #edb/ref 17592186092173 :knowledge-point/id #uuid "1286cc9b-2080-5541-88e1-d4d2741ea1e5" :knowledge-point/title "Solving a Trigonometric Equation Containing the Cosine Function Transformed by Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022e0018-2f42-5bc0-839a-94b3b6a7345a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7{\\pi }^{2}}{48}" :db/id #edb/ref 17592186542642} {:answer/id #uuid "243b413f-1ed5-5fd9-83ef-c67f2fb483ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13{\\pi }^{2}}{16}" :db/id #edb/ref 17592186542733} {:answer/id #uuid "ab0d6bfa-f34f-56b8-b82f-bb5140952e0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13{\\pi }^{2}}{48}" :db/id #edb/ref 17592186543091} {:answer/id #uuid "bc1c9710-16d0-52b3-9cf5-cd2bf56b2518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13{\\pi }^{2}}{144}" :db/id #edb/ref 17592186543133} {:answer/id #uuid "bf8999d6-066a-50d5-a8fc-0ad42db04a2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{144}" :db/id #edb/ref 17592186543143}] :answer-field/correct {:answer/id #uuid "243b413f-1ed5-5fd9-83ef-c67f2fb483ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13{\\pi }^{2}}{16}" :db/id #edb/ref 17592186542733} :answer-field/id #uuid "07364bf1-9117-523c-8ac5-3757ab4f12da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543296}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd740014-1051-58c1-bf02-d54c44856f2e" :question/math-academy-id "q-8416" :question/problem "Consider the equation $\\operatorname{cos}⁡(2x+\\frac{\\pi }{6})=\\frac{1}{2}$ for $0\\le x<2\\pi .$ If the solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ are written in ascending order, what is the value of ${x}_{2}\\cdot {x}_{3}?$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x+\\frac{\\pi }{6} & =\\frac{\\pi }{3}+2n\\pi , & \\, & \\, & 2x+\\frac{\\pi }{6} & =\\frac{5\\pi }{3}+2n\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}2x & =\\frac{\\pi }{3}-\\frac{\\pi }{6}+2n\\pi  & \\, & \\, & 2x & =\\frac{5\\pi }{3}-\\frac{\\pi }{6}+2n\\pi  \\\\ 2x & =\\frac{\\pi }{6}+2n\\pi  & \\, & \\, & 2x & =\\frac{3\\pi }{2}+2n\\pi  \\\\ x & =\\frac{\\pi }{12}+n\\pi  & \\, & \\, & x & =\\frac{3\\pi }{4}+n\\pi  \\\\ x & =\\frac{(1+12n)\\pi }{12} & \\, & \\, & x & =\\frac{(3+4n)\\pi }{4}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{12}$ and $x=\\frac{3\\pi }{4}$\n\n- Setting $n=1$ gives $x=\\frac{13\\pi }{12}$  and $x=\\frac{7\\pi }{4}$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$ So, the solutions ${x}_{1},{x}_{2},{x}_{3},{x}_{4}$ (written in ascending order) are\n\n$$\nx=\\frac{\\pi }{12},\\,\\frac{3\\pi }{4},\\,\\frac{13\\pi }{12},\\,\\frac{7\\pi }{4}.\n$$\n\nFinally,\n\n$$\n{x}_{2}\\cdot {x}_{3}=\\frac{3\\pi }{4}\\cdot \\frac{13\\pi }{12}=\\frac{13{\\pi }^{2}}{16}.\n$$"}] [{:db/id #edb/ref 17592186543548 :knowledge-point/_questions [{:db/id #edb/ref 17592186092174 :knowledge-point/id #uuid "9e880672-e776-5701-8168-730f7012f5b0" :knowledge-point/title "Solving a Trigonometric Equation Containing a Transformed Cosine Function Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18eb997a-9844-5aac-b91f-00f5f300d39b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{24}" :db/id #edb/ref 17592186542703} {:answer/id #uuid "33d9c60f-2f9d-53f4-980f-9aa97023962f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7{\\pi }^{2}}{24}" :db/id #edb/ref 17592186542779} {:answer/id #uuid "d7168513-56cb-58e5-b423-239ea3770fba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{48}" :db/id #edb/ref 17592186543192} {:answer/id #uuid "da5f6ffe-39d2-5021-9518-42610f548da9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{12}" :db/id #edb/ref 17592186543198} {:answer/id #uuid "edf9637c-aede-513e-8154-e840c0b4d689" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7{\\pi }^{2}}{48}" :db/id #edb/ref 17592186543246}] :answer-field/correct {:answer/id #uuid "edf9637c-aede-513e-8154-e840c0b4d689" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7{\\pi }^{2}}{48}" :db/id #edb/ref 17592186543246} :answer-field/id #uuid "c6635c31-8a89-581f-88ba-c9350baa70ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543439}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af242b6e-a0fa-5102-becb-649e55619922" :question/math-academy-id "q-8422" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cos}⁡(2x+\\frac{\\pi }{6})=-\\frac{1}{2}$ for $0\\le x<\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x+\\frac{\\pi }{6} & =-\\frac{2\\pi }{3}+2n\\pi , & \\, & \\, & 2x+\\frac{\\pi }{6} & =\\frac{2\\pi }{3}+2n\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}2x & =-\\frac{5\\pi }{6}+2n\\pi  & \\, & \\, & 2x & =\\frac{\\pi }{2}+2n\\pi  \\\\ x & =-\\frac{5\\pi }{12}+n\\pi  & \\, & \\, & x & =\\frac{\\pi }{4}+n\\pi  \\\\ x & =\\frac{(12n-5)\\pi }{12} & \\, & \\, & x & =\\frac{(4n+1)\\pi }{4}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<\\pi .$\n\n- Setting $n=0$ gives $x=-\\frac{5\\pi }{12}$ and $x=\\frac{\\pi }{4}.$ We reject $-\\frac{5\\pi }{12}$ since it lies outside the domain of interest.\n\n- Setting $n=1$ gives $x=\\frac{7\\pi }{12}$ and $x=\\frac{5\\pi }{4}.$ We reject $\\frac{5\\pi }{4}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain $0<x\\le \\pi .$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{4}\\cdot \\frac{7\\pi }{12}=\\frac{7{\\pi }^{2}}{48}.\n$$"}] [{:db/id #edb/ref 17592186543533 :knowledge-point/_questions [{:db/id #edb/ref 17592186092173 :knowledge-point/id #uuid "1286cc9b-2080-5541-88e1-d4d2741ea1e5" :knowledge-point/title "Solving a Trigonometric Equation Containing the Cosine Function Transformed by Multiple Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43b5a5a3-e3bd-5ca5-abf0-99897ef0d6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11{\\pi }^{2}}{16}" :db/id #edb/ref 17592186542824} {:answer/id #uuid "482140ef-4bcd-5c73-b1a5-1371712b352b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15{\\pi }^{2}}{16}" :db/id #edb/ref 17592186542835} {:answer/id #uuid "9a3f101b-39b0-5f18-bb20-2ed53c584e10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{48}" :db/id #edb/ref 17592186543044} {:answer/id #uuid "d8f3b022-ee82-5c9f-a98e-79cfe7d39c0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{4}" :db/id #edb/ref 17592186543195} {:answer/id #uuid "e0a0c041-ac86-5d7d-b144-83b28e3c689b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23{\\pi }^{2}}{48}" :db/id #edb/ref 17592186543212}] :answer-field/correct {:answer/id #uuid "e0a0c041-ac86-5d7d-b144-83b28e3c689b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{23{\\pi }^{2}}{48}" :db/id #edb/ref 17592186543212} :answer-field/id #uuid "82b1eb6b-29b6-5c06-8aaf-865126a7825b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543379}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9acc1f61-f727-5595-afa3-5b687cb64df5" :question/math-academy-id "q-8471" :question/problem "Consider the equation $\\operatorname{cos}⁡(2x-\\frac{7\\pi }{6})=-\\frac{1}{2}$ for $0\\le x<2\\pi .$ If the solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ are written in ascending order, what is the value of ${x}_{1}\\cdot {x}_{4}?$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x-\\frac{7\\pi }{6} & =-\\frac{2\\pi }{3}+2n\\pi , & \\, & \\, & 2x-\\frac{7\\pi }{6} & =\\frac{2\\pi }{3}+2n\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}2x & =\\frac{\\pi }{2}+2n\\pi  & \\, & \\, & 2x & =\\frac{11\\pi }{6}+2n\\pi  \\\\ x & =\\frac{\\pi }{4}+n\\pi  & \\, & \\, & x & =\\frac{11\\pi }{12}+n\\pi  \\\\ x & =\\frac{(4n+1)\\pi }{4} & \\, & \\, & x & =\\frac{(12n+11)\\pi }{12}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{4}$ and $x=\\frac{11\\pi }{12}$\n\n- Setting $n=1$ gives $x=\\frac{5\\pi }{4}$ and $x=\\frac{23\\pi }{12}$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$  So, the solutions ${x}_{1},{x}_{2},{x}_{3},{x}_{4}$ (written in ascending order) are\n\n$$\nx=\\frac{\\pi }{4},\\,\\frac{11\\pi }{12},\\,\\frac{5\\pi }{4},\\,\\frac{23\\pi }{12}.\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{4}=\\frac{\\pi }{4}\\cdot \\frac{23\\pi }{12}=\\frac{23{\\pi }^{2}}{48}.\n$$"}]}
