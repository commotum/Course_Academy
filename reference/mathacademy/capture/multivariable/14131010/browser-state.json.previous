      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131010/observations/step-q109146-06be9686d0a4b1661a83.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131010/observations/step-q109146-06be9686d0a4b1661a83.png",
      "source_url": "https://mathacademy.com/tasks/14131010/topics/1994/lesson",
      "captured_at": 1791781893.8065262,
      "math_academy_id": "q-109146",
