      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131010/observations/step-q126523-5e27ebbf984cbec34791.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14131010/observations/step-q126523-5e27ebbf984cbec34791.png",
      "source_url": "https://mathacademy.com/tasks/14131010/topics/1994/lesson",
      "captured_at": 1791781780.4674535,
      "math_academy_id": "q-126523",
      "topic_id": "1994",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q126523",
        "placement_id": null,
        "content_id": null,
