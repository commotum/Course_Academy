e-b676cb38f400" :answer-field/choices "answer-826c5023-ef86-5ab9-acaa-ec789d00fac6"] ["answer-field-cc1a6bc1-e6b7-5531-84ae-b676cb38f400" :answer-field/choices "answer-9d87d5ae-077e-5462-9e51-8ecda822620f"] ["question-947d34a3-027e-5d38-b8d1-e6f3a1b0d3d2" :question/answer-fields "answer-field-cc1a6bc1-e6b7-5531-84ae-b676cb38f400"] [17592186495044 :knowledge-point/questions "question-947d34a3-027e-5d38-b8d1-e6f3a1b0d3d2"] ["question-e3c42dde-368f-51a4-a96b-0c5d0e222f8f" :question/id #uuid "e3c42dde-368f-51a4-a96b-0c5d0e222f8f"] ["question-e3c42dde-368f-51a4-a96b-0c5d0e222f8f" :question/math-academy-id "q-354923"] ["question-e3c42dde-368f-51a4-a96b-0c5d0e222f8f" :question/problem "A scientist bought $1$ fluid ounce of a chemical solution and paid $\\$1.60$ for it. What's the unit price per cup?\n\nAssume that there are $8$ fluid ounces in one cup."] ["question-e3c42dde-368f-51a4-a96b-0c5d0e222f8f" :question/worked-solution "First, notice that there are $8$ fluid ounces in each cup.  \n\nSince the price is $\\$1.60$ per fluid ounce, to find the price per cup, we multiply by $8:$\n\n$$\n1.60\\times 8=12.80\n$$\n\nTherefore, the chemical solution costs $\\$12.80$ per cup."] ["question-e3c42dde-368f-51a4-a96b-0c5d0e222f8f" :question/difficulty :question.difficulty/easy] ["answer-field-44ddfc6b-4838-5599-a86f-bf8221237272" :answer-field/id #uuid "44ddfc6b-4838-5599-a86f-bf8221237272"] ["answer-5b0c9344-df9c-5f3f-b871-4631ff371574" :answer/id #uuid "5b0c9344-df9c-5f3f-b871-4631ff371574"] ["answer-5b0c9344-df9c-5f3f-b871-4631ff371574" :answer/type :answer.type/text] ["answer-5b0c9344-df9c-5f3f-b871-4631ff371574" :answer/value "$\\$10.20$ per cup"] ["answer-3497fac9-fc4e-56a7-bdbf-3df6bb29d82a" :answer/id #uuid "3497fac9-fc4e-56a7-bdbf-3df6bb29d82a"] ["answer-3497fac9-fc4e-56a7-bdbf-3df6bb29d82a" :answer/type :answer.type/text] ["answer-3497fac9-fc4e-56a7-bdbf-3df6bb29d82a" :answer/value "$\\$12.80$ per cup"] ["answer-d62a7cd4-5580-5f49-81c7-8e925474945a" :answer/id #uuid "d6