[{"source" ":org/Math-Academy" "forms" [{:db/id 17592186495045 :knowledge-point/questions ["question-7fb9ebfb-8542-5a5c-a420-5a62ca5ea273" "question-47942259-bbea-5bc3-9f75-4c601ace6485"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7fb9ebfb-8542-5a5c-a420-5a62ca5ea273" :question/id #uuid "7fb9ebfb-8542-5a5c-a420-5a62ca5ea273" :question/math-academy-id "q-68496" :question/problem "Emma bought $2$ pounds of raisins for  $\\$4.80.$ What's the unit price per ounce?\n\nAssume that there are $16$ ounces in one pound." :question/worked-solution "First, we convert from pounds to ounces. There are $16$ ounces in each pound, so we multiply the number of pounds  by $16:$  \n\n$$\n2\\times 16=32\n$$\n\nSo, $2$ pounds is the same as $32$ ounces. Now, to find the unit price per ounce, we divide the total price by $32:$\n\n$$\n4.80÷32=0.15\n$$\n\nTherefore, the raisins cost $\\$0.15$ per ounce." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2abffdfc-fc7f-5e62-bbf0-8004d983bdb6"] :db/ensure [:question/validate]} {:db/id "answer-field-2abffdfc-fc7f-5e62-bbf0-8004d983bdb6" :answer-field/id #uuid "2abffdfc-fc7f-5e62-bbf0-8004d983bdb6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b77dce2d-86db-5409-9e6c-c76cab9e68a6" :answer-field/choices ["answer-a0393141-d4c3-5b4f-899b-0fc8a40a1d12" "answer-b77dce2d-86db-5409-9e6c-c76cab9e68a6" "answer-a1d4816c-666f-5389-8d12-ea12066da2c8" "answer-5a7e9b95-e930-5da4-950d-4b10eb164347" "answer-ccc3159b-e49c-584f-856e-0b2cd597cb6e"] :db/ensure [:answer-field/validate]} {:db/id "answer-a0393141-d4c3-5b4f-899b-0fc8a40a1d12" :answer/id #uuid "a0393141-d4c3-5b4f-899b-0fc8a40a1d12" :answer/type :answer.type/text :answer/value "$\\$0.10$ per ounce" :db/ensure [:answer/validate]} {:db/id "answer-b77dce2d-86db-5409-9e6c-c76cab9e68a6" :answer/id #uuid "b77dce2d-86db-5409-9e6c-c76cab9e68a6" :answer/type :answer.type/text :answer/value "$\\$0.15$ p