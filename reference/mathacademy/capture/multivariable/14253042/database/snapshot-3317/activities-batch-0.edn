#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186495248} :activity/id #uuid "a2a7902b-50ad-5025-aee1-406a52f48bac" :activity/scope {:db/id #edb/ref 17592186495276 :topic/id #uuid "cef7c109-a883-5959-842c-c3cb8202ae04" :topic/math-academy-id 2555} :activity/steps [{:db/id #edb/ref 17592186495184 :step/content {:db/id #edb/ref 17592186495041 :knowledge-point/canonical-example {:db/id #edb/ref 17592186495053 :question/id #uuid "05aac4e0-eee5-5923-80d0-059ceee6159d" :question/math-academy-id "e-4543"} :knowledge-point/id #uuid "01ca542e-437b-5564-8d9a-cf9249ab53b9" :knowledge-point/questions [{:db/id #edb/ref 17592186495087} {:db/id #edb/ref 17592186495101} {:db/id #edb/ref 17592186495115} {:db/id #edb/ref 17592186495124} {:db/id #edb/ref 17592186495163}] :knowledge-point/title "Computing a Unit Price"} :step/id #uuid "1885e554-32d8-511b-808d-67d60f7399df" :step/math-academy-id 616165 :step/next {:db/id #edb/ref 17592186495249}} {:db/id #edb/ref 17592186495214 :step/content {:db/id #edb/ref 17592186495045 :knowledge-point/canonical-example {:db/id #edb/ref 17592186495168 :question/id #uuid "f60f0711-fce9-525f-a2d1-fdf86ccef7b9" :question/math-academy-id "e-4541"} :knowledge-point/id #uuid "60ccce15-6e30-58e5-a087-52100ebb460b" :knowledge-point/questions [{:db/id #edb/ref 17592186495054} {:db/id #edb/ref 17592186495067} {:db/id #edb/ref 17592186495090} {:db/id #edb/ref 17592186495113} {:db/id #edb/ref 17592186495133} {:db/id #edb/ref 17592186518137} {:db/id #edb/ref 17592186518153} {:db/id #edb/ref 17592186518186} {:db/id #edb/ref 17592186575539} {:db/id #edb/ref 17592186575568}] :knowledge-point/title "Computing a Unit Price With Conversion to Smaller Units"} :step/id #uuid "76ea330a-6861-5c40-a2ba-13e287e50b81" :step/math-academy-id 616169 :step/next {:db/id #edb/ref 17592186495239}} {:db/id #edb/ref 17592186495239 :step/content {:db/id #edb/ref 17592186495044 :knowledge-point/canonical-example {:db/id #edb/ref 17592186495061 :question/id #uuid "13572493-e244-5164-b0c2-a6c101cfeecc" :question/math-academy-id "e-22088"} :knowledge-point/id #uuid "247d98e4-8f13-5536-8ad6-00a14e476caf" :knowledge-point/questions [{:db/id #edb/ref 17592186495080} {:db/id #edb/ref 17592186495104} {:db/id #edb/ref 17592186495123} {:db/id #edb/ref 17592186495127} {:db/id #edb/ref 17592186495130} {:db/id #edb/ref 17592186518177} {:db/id #edb/ref 17592186518207} {:db/id #edb/ref 17592186575541} {:db/id #edb/ref 17592186575576} {:db/id #edb/ref 17592186575612}] :knowledge-point/title "Computing a Unit Price With Conversion to Larger Units"} :step/id #uuid "aedb1d7d-de1a-5c5e-bb8b-a9a5130bbd17" :step/math-academy-id 616172} {:db/id #edb/ref 17592186495248 :step/content {:db/id #edb/ref 17592186495279 :tutorial/content "A **unit price** is the price of a single item. To compute a unit price, we divide the total cost of a group of items by the number of items in the group.\n\nFor example, suppose a store sells a pack of $3$ shirts for $\\[math]12.$ \n\nTo find the unit price, we divide the total cost by the number of shirts:\n\n$$\n12 \\div 3  = 4\n$$\n\nTherefore, the unit price is $\\[/math]4$ per shirt." :tutorial/id #uuid "1e8ab0cc-4a5e-57ca-a168-f89d110ff113" :tutorial/math-academy-id 3104 :tutorial/title "Introduction"} :step/id #uuid "bd03cc48-369a-5495-aa96-7aa335bd67c7" :step/math-academy-id 616164 :step/next {:db/id #edb/ref 17592186495184}} {:db/id #edb/ref 17592186495249 :step/content {:db/id #edb/ref 17592186495277 :tutorial/content "Now, suppose that installing a fence costs $\\[math]360$ per yard. What would be the unit price per foot?\n\nFirst, notice that there are $3$ feet in $1$ yard.  \n\nTo find the unit price per foot, we *divide* the price per yard by $3\\mathbin{:}$\n\n$$\n360 \\div 3 = 120\n$$\n\nTherefore, installing the fence costs $\\[/math]120$ per foot.\n\nIn reverse, if we know that installing a fence costs $\\[math]120$ per foot, to find the unit price per yard, we would need to *multiply* the price per foot by $3\\mathbin{:}$\n\n$$\n120 \\times 3 = 360\n$$" :tutorial/id #uuid "15c0e757-69bb-5bfd-a417-6de7c79fa333" :tutorial/math-academy-id 15094 :tutorial/title "Unit Prices With Units Conversions"} :step/id #uuid "c1f9c4d4-8e93-5221-9ae9-b9e48f28f0d1" :step/math-academy-id 616168 :step/next {:db/id #edb/ref 17592186495214}}] :activity/title "Finding Unit Prices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186494312}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186518269} :activity/id #uuid "3d177d8b-58a3-5a2a-b0d6-cb5cc61ea34f" :activity/scope {:db/id #edb/ref 17592186495276 :topic/id #uuid "cef7c109-a883-5959-842c-c3cb8202ae04" :topic/math-academy-id 2555} :activity/steps [{:db/id #edb/ref 17592186518260 :step/content {:db/id #edb/ref 17592186518207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "488a6733-2b62-5110-a8a6-e3949dc8cd8b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$0.09$ per gallon" :db/id #edb/ref 17592186517629} {:answer/id #uuid "4de4fb3c-cdfc-5a86-ac04-dc62c62bcef4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$16$ per gallon" :db/id #edb/ref 17592186517640} {:answer/id #uuid "4f9e2cfb-824b-5a25-96b9-7b7594c7e4ec" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$24$ per gallon" :db/id #edb/ref 17592186517644} {:answer/id #uuid "65a07d60-9deb-5380-9182-5f188866a085" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$0.90$ per gallon" :db/id #edb/ref 17592186517675} {:answer/id #uuid "c24e2006-b55b-5eed-b5f2-8ce6d5a28b8a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$28$ per gallon" :db/id #edb/ref 17592186517859}] :answer-field/correct {:db/id #edb/ref 17592186517644} :answer-field/id #uuid "be180afd-ef20-5827-b2f6-fd91c64375fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518061}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e1dac973-b461-5ce9-a7ae-b3034ec42db1" :question/math-academy-id "q-354645" :question/problem "Maria bought $1$ cup of olive oil and paid $$1.50$ for it. What's the unit price per gallon?\n\nAssume that there are $16$ cups in one gallon." :question/worked-solution "First, notice that there are $16$ cups in each gallon.  \n\nSince the price is $$1.50$ per cup, to find the price per gallon, we multiply by $16:$\n\n$$\n1.50\\times 16=24\n$$\n\nTherefore, the olive oil costs $$24$ per gallon."} :step/id #uuid "71aa048c-d524-5909-97e9-aeb85adb50c1" :step/next {:db/id #edb/ref 17592186518265}} {:db/id #edb/ref 17592186518265 :step/content {:db/id #edb/ref 17592186518186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "239c18ff-9dd1-57f6-8621-96f43e3689ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$3.65$ per quart" :db/id #edb/ref 17592186517555} {:answer/id #uuid "580d3b9f-2181-5383-83ed-ba560ab18a67" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$3.50$ per quart" :db/id #edb/ref 17592186517651} {:answer/id #uuid "985dd1f2-b29f-5b02-881b-bb751aa3d19b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$3.60$ per quart" :db/id #edb/ref 17592186517778} {:answer/id #uuid "d3e94df4-b05d-549d-b591-d4d9120e8455" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$3.70$ per quart" :db/id #edb/ref 17592186517885} {:answer/id #uuid "e0b9e68e-25ae-5105-8196-f8e7b86fd57c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$3.55$ per quart" :db/id #edb/ref 17592186517911}] :answer-field/correct {:db/id #edb/ref 17592186517778} :answer-field/id #uuid "5f5d24c7-c2ff-5561-a437-9575608cc9c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186518020}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b6d906ea-b787-55f0-a205-6b6f9a337939" :question/math-academy-id "q-354900" :question/problem "Buying organic milk costs $$14.40$ per gallon. What's the unit price per quart?\n\nAssume that there are $4$ quarts in one gallon." :question/worked-solution "First, notice that there are $4$ quarts in $1$ gallon. So, to find the unit price per quart, we divide the total price by $4:$\n\n$$\n14.40÷4=3.60\n$$\n\nTherefore, the milk costs $$3.60$ per quart."} :step/id #uuid "882bc0ea-f6bd-5db8-820e-a5ee597f7592" :step/next {:db/id #edb/ref 17592186518299}} {:db/id #edb/ref 17592186518269 :step/content {:db/id #edb/ref 17592186518153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d715d96-7916-5406-9aba-de7f90a6a3bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$0.16$ per ounce" :db/id #edb/ref 17592186517699} {:answer/id #uuid "907d0e63-aa0e-53bd-ad9a-b19ed25389a5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$0.15$ per ounce" :db/id #edb/ref 17592186517759} {:answer/id #uuid "c0451957-dac5-5dee-8df2-a6987aa7df86" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$0.18$ per ounce" :db/id #edb/ref 17592186517856} {:answer/id #uuid "ed1a0d7c-ec15-522b-ac53-db82ebbd0e01" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$0.14$ per ounce" :db/id #edb/ref 17592186517938} {:answer/id #uuid "ff5451f8-2cb8-55fb-8a4c-45725471904d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$0.12$ per ounce" :db/id #edb/ref 17592186517967}] :answer-field/correct {:db/id #edb/ref 17592186517938} :answer-field/id #uuid "311b09e1-10eb-57ba-a434-9673ef28e54e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186517992}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "694684ae-3bf6-514c-9bb8-aef47c5c19c7" :question/math-academy-id "q-68552" :question/problem "At a convenience store, a $5$-pound canister of licorice candy costs $$11.20.$ What's the unit price per ounce?\n\nAssume that there are $16$ ounces in one pound." :question/worked-solution "First, we convert from pounds to ounces. There are $16$ ounces in each pound, so we multiply the number of pounds  by $16:$  \n\n$$\n5\\times 16=80\n$$\n\nSo, $5$ pounds is the same as $80$ ounces. Now, to find the unit price per ounce, we divide the total price by $80:$  \n\n$$\n11.20÷80=0.14\n$$\n\nTherefore, the licorice candy costs $$0.14$ per ounce."} :step/id #uuid "8eae0121-721d-55f3-b85e-b0cfa37bea3a" :step/next {:db/id #edb/ref 17592186518260}} {:db/id #edb/ref 17592186518294 :step/content {:db/id #edb/ref 17592186518177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cc156c5-da42-5cf1-afb4-e1a9ccffe353" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$14$ per pound" :db/id #edb/ref 17592186517608} {:answer/id #uuid "89a61866-108b-5d5c-a9c6-f994eea7b3b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$10$ per pound" :db/id #edb/ref 17592186517745} {:answer/id #uuid "b2b7ba53-17b8-5b02-a5ce-b70700a2a8f9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$16$ per pound" :db/id #edb/ref 17592186517824} {:answer/id #uuid "b3bd2153-3094-504a-9e6a-b74cf2b19e82" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$20$ per pound" :db/id #edb/ref 17592186517827} {:answer/id #uuid "e3429c35-cffd-5c1d-a927-f2b3fb6ffd84" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$$12$ per pound" :db/id #edb/ref 17592186517915}] :answer-field/correct {:db/id #edb/ref 17592186517915} :answer-field/id #uuid "14b9646b-84f3-5527-a013-f8974a97792e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186517976}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "924bf994-7977-5b78-af84-c2d13087032d" :question/math-academy-id "q-354914" :question/problem "Sarah bought $1$ ounce of almonds and paid $$0.75$ for it. What's the unit price per pound?\n\nAssume that th