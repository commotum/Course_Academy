d #uuid "642ddf76-83d6-5526-be68-f3cdea71c79f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186362641} {:answer/id #uuid "68bf0219-bcf9-574d-aa49-4687d9a8c8da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186362642}] :answer-field/correct {:answer/id #uuid "14529e7e-b092-5d31-b4ed-2ba06143f782" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186362640} :answer-field/id #uuid "5401f578-6bbd-541f-accf-4f7429d07e68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362637}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1f3188e0-a129-5566-aa12-cb0dd9585e31" :question/math-academy-id "q-108790" :question/problem "Consider a $3\\times 4$ matrix $A.$ If $\\text{dim}(\\text{Null}({A}^{T}))=2,$ then $\\text{dim}(\\text{Col}(A))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=3,$ $n=4,$ and $m-r=2.$ \n\nSubstituting $m=3$ into $m-r=2,$ we can find the rank of $A:$\n\n$$\n(3)-r=2\\,⟹\\,r=1\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Col}(A)) & =r=1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186134072 :knowledge-point/_questions [{:db/id #edb/ref 17592186133888 :knowledge-point/id #uuid "75e1da77-a5dc-5f78-977e-0d6dae99c97e" :knowledge-point/title "Identifying the Images of the Four Fundamental Subspaces of the Matrix Under Its Action"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82ad9957-3ade-5285-9fc7-a05ee7a459e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Col(A)" :db/id #edb/ref 17592186130589} {:answer/id #uuid "a0383324-dbca-50dd-bdcc-37512ea2d152" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Null(A)" :db/id #edb/ref 17592186130590} {:answer/id #uuid "a1a91f6b-5958-5cfe-896d-f5937e306a15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Null(A^{T})" :db/id #edb/ref 17592186130591} {:answer/id #uuid "ad28f55d-75f4-5e56-8c77-b012368c85c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Col(A^{T})" :db/id #edb/ref 17592186130592} {:answer/id #uuid "3846388b-6810-5c10-bf1d-68aa79f332e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186130593}] :answer-field/id #uuid "5698a0f6-293a-56c1-8d52-a0960e6d9bb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130588} {:answer-field/choices [{:answer/id #uuid "07509797-308b-5e51-8c0b-7ce937096e54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Null}(A)" :db/id #edb/ref 17592186380519} {:answer/id #uuid "5d46aa8d-aee6-5949-9319-7a6d7d0087f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}(A)" :db/id #edb/ref 17592186380520} {:answer/id #uuid "3c7884a2-0ad2-55ac-be08-5ec6f1269e25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Null}({A}^{T})" :db/id #edb/ref 17592186380521} {:answer/id #uuid "072d89d9-d407-530a-8155-7168cdaab68b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186380522} {:answer/id #uuid "726d2de0-3519-5e23-aed7-7964192a471f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186380523}] :answer-field/correct {:answer/id #uuid "072d89d9-d407-530a-8155-7168cdaab68b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{Col}({A}^{T})" :db/id #edb/ref 17592186380522} :answer-field/id #uuid "3f23184f-d234-52a0-baf0-4d7dec1d4f26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380518}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6e9167d-9cc2-5340-981b-f78b8d297972" :question/math-academy-id "q-108917" :question/problem "Let $A$ be a $m\\times n$ matrix. What is the image of $\\text{Col}(A)$ under the action of ${A}^{T}?$" :question/worked-solution "First,  notice that ${A}^{T}$ is a $n\\times m$ matrix.\n\nNow, pre-multiplying a vector $x\\in {R}^{m}$ by ${A}^{T}$ gives a linear combination of the columns of ${A}^{T}:$\n\n$$\n{{[\\begin{aligned}| & | & ⋯ & | \\\\ {a}_{1}^{T} & {a}_{2}^{T} & ⋯ & {a}_{m}^{T} \\\\ | & | & ⋯ & |\\end{aligned}]}_{⏟}}_{{A}^{T}}\\cdot {{[\\begin{aligned}{x}_{1} \\\\ ⋮ \\\\ {x}_{m}\\end{aligned}]}_{⏟}}_{x}={x}_{1}[\\begin{aligned}| \\\\ {a}_{1}^{T} \\\\ |\\end{aligned}]+{x}_{2}[\\begin{aligned}| \\\\ {a}_{2}^{T} \\\\ |\\end{aligned}]+⋯+{x}_{m}[\\begin{aligned}| \\\\ {a}_{m}^{T} \\\\ |\\end{aligned}]\n$$\n\nTherefore, the image of ${R}^{m}$ under the action of ${A}^{T}$ must be $\\text{Col}({A}^{T}),$ the column space of ${A}^{T},$ or equivalently, the row space of $A.$\n\nFurthermore, since $\\text{Null}({A}^{T})$ is mapped to the zero vector $0$ by the definition of the null subspace, the image of its orthogonal complement $\\text{Col}(({A}^{T})^{T})=\\text{Col}(A)$ must be $\\text{Col}({A}^{T}).$\n\nThis can be schematically visualized, as shown below.\n\n![](images/8c/8ca8508d05e28e4c91b5a7f3c65826ce68b5dacd382bfb1a76f09c09d1d004bf.png)"}] [{:db/id #edb/ref 17592186380580 :knowledge-point/_questions [{:db/id #edb/ref 17592186133887 :knowledge-point/id #uuid "1a36c7f7-4287-562b-94ea-047b38ede70f" :knowledge-point/title "Finding the Dimensions of the Four Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47f32d2d-62b0-5577-99a7-9ef569a3c1d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186380582} {:answer/id #uuid "f004b065-ceb0-53d6-af2a-9e1fc77f7ea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186380583} {:answer/id #uuid "0d424f23-7eba-535f-b6b3-1c3c53701008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186380584} {:answer/id #uuid "2655e19c-1cbf-550c-95b8-b20713cc8708" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186380585} {:answer/id #uuid "338e4081-fca8-5da7-8139-868e68982d73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186380586}] :answer-field/correct {:answer/id #uuid "0d424f23-7eba-535f-b6b3-1c3c53701008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186380584} :answer-field/id #uuid "091a11e0-779c-5adc-8846-339cc5d8f182" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380581}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "95eda20f-4166-5e69-9b5a-dd4b026bbb36" :question/math-academy-id "q-109874" :question/problem "Consider a $2\\times 4$ matrix $A.$ If $\\text{dim}(\\text{Null}({A}^{T}))=1,$ then $\\text{dim}(\\text{Col}(A))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=2,$ $n=4,$ and $m-r=1.$ \n\nSubstituting $m=2$ into $m-r=1,$ we can find the rank of $A:$\n\n$$\n(2)-r=1\\,⟹\\,r=1\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Col}(A)) & =r=1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362784 :knowledge-point/_questions [{:db/id #edb/ref 17592186133887 :knowledge-point/id #uuid "1a36c7f7-4287-562b-94ea-047b38ede70f" :knowledge-point/title "Finding the Dimensions of the Four Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29c8b328-6e43-5c3b-8a74-f5fb46485859" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186362786} {:answer/id #uuid "1b5037d9-2aed-5c31-90dd-13749f1173f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186362787} {:answer/id #uuid "7121c77f-ff14-5b7a-a45e-f13b7d7f0e4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186362788} {:answer/id #uuid "92b47738-a4c5-5222-b666-47b27f0b1d15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186362789} {:answer/id #uuid "6dd3b88d-bd0d-5848-9ec4-09ca27570803" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186362790}] :answer-field/correct {:answer/id #uuid "7121c77f-ff14-5b7a-a45e-f13b7d7f0e4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186362788} :answer-field/id #uuid "a13963a1-5122-5b42-936d-18e7d8414e4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362785}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3bb522f3-4dc5-5f07-a21d-cf9bb7dbc721" :question/math-academy-id "q-109875" :question/problem "Consider a $4\\times 5$ matrix $A.$ If $\\text{dim}(\\text{Null}(A))=1,$ then $\\text{dim}(\\text{Col}({A}^{T}))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=4,$ $n=5,$ and $n-r=1.$ \n\nSubstituting $n=5$ into $n-r=1,$ we can find the rank of $A:$\n\n$$\n(5)-r=1\\,⟹\\,r=4\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Col}({A}^{T})) & =r=4.\\end{aligned}\n$$"}]}
