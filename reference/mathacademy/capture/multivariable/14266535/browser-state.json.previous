mjx-n\" space=\"4\"><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c33\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mi mathvariant=\"normal\">∀</mi><mi>n</mi><mo>∈</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"double-struck\">Z</mi></mrow><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>2</mn><mo>∣</mo><mn>5</mn><mi>n</mi><mo>−</mo><mn>3.</mn></math></mjx-assistive-mml></mjx-container></p><p></p>\n<p></p><p>Since this statement is false, its negation is true.</p><p></p>\n<p></p><p>A <em>counterexample</em> is a particular case that disproves the statement. Equivalently, it's a case that proves the negation is true.</p><p></p>\n<p></p><p>The negation of our statement is</p><p></p>\n<p></p><p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"102\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-cAC\"></mjx-c></mjx-mi><mjx-texatom texclass=\"ORD\"><mjx-mo class=\"mjx-sop\"><mjx-c class=\"mjx-c28 TEX-S1\"></mjx-c></mjx-mo></mjx-texatom><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c2200\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2208\"></mjx-c></mjx-mo><mjx-texatom space=\"4\" texclass=\"ORD\"><mjx-mi class=\"mjx-ds mjx-b\"><mjx-c class=\"mjx-c2124 TEX-A\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mn class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2223\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn><mjx-texatom texclass=\"ORD\"><mjx-mo class=\"mjx-sop\"><mjx-c class=\"mjx-c29 TEX-S1\"></mjx-c></mjx-mo></mjx-texatom><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2261\"></mjx-c></mjx-mo><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2203\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2208\"></mjx-c></mjx-mo><mjx-texatom space=\"4\" texclass=\"ORD\"><mjx-mi class=\"mjx-ds mjx-b\"><mjx-c class=\"mjx-c2124 TEX-A\"></mjx-c></mjx-mi></mjx-texatom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mstyle><mjx-mspace style=\"width: 0.222em;\"></mjx-mspace></mjx-mstyle><mjx-mn class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2224 TEX-A\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c33\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mi mathvariant=\"normal\">¬</mi><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">(</mo></mrow><mi mathvariant=\"normal\">∀</mi><mi>n</mi><mo>∈</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"double-struck\">Z</mi></mrow><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>2</mn><mo>∣</mo><mn>5</mn><mi>n</mi><mo>−</mo><mn>3</mn><mrow data-mjx-texclass=\"ORD\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mo>≡</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mi mathvariant=\"normal\">∃</mi><mi>n</mi><mo>∈</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"double-struck\">Z</mi></mrow><mo>,</mo><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mn>2</mn><mo>∤</mo><mn>5</mn><mi>n</mi><mo>−</mo><mn>3.</mn></math></mjx-assistive-mml></mjx-container></p><p></p>\n<p></p><p>Therefore, we have the following:</p><p></p>\n<blockquote>\n<p>A counterexample for the above statement would be an integer <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"103\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle style=\"background-color: gainsboro;\"><mjx-mpadded><mjx-block style=\"width: 1.2em; margin: 0.3em 0px; position: relative;\"><mjx-rbox style=\"left: 0.3em; top: 0px; max-width: 1.2em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi></mjx-mstyle></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mi>n</mi></mstyle></mpadded></mstyle></math></mjx-assistive-mml></mjx-container> such that <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"104\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle style=\"background-color: gainsboro;\"><mjx-mpadded><mjx-block style=\"width: 3.422em; margin: 0.3em 0px; position: relative;\"><mjx-rbox style=\"left: 0.3em; top: 0px; max-width: 3.422em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-mstyle></mjx-rbox></mjx-block></mjx-mpadded></mjx-mstyle></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle mathbackground=\"Gainsboro\"><mpadded height=\"+3pt\" depth=\"+3pt\" lspace=\"3pt\" width=\"+6pt\"><mstyle mathcolor=\"blue\"><mn>5</mn><mi>n</mi><mo>−</mo><mn>3</mn></mstyle></mpadded></mstyle></math></mjx-assistive-mml></mjx-container> is <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"105\" style=\"font-size: 119.4%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mstyle style=\"background-color: gainsboro;\"><mjx-mpadded><mjx-block style=\"width: 5.885em; margin: 0.3em 0px; position: relative;\"><mjx-rbox style=\"left: 0.3em; top: 0px; max-width: 5.885em;\"><mjx-mstyle style=\"color: blue;\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c6E\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c74\"></mjx-c><mjx-c class=\"mjx-c20\"></mjx-c><mjx-c class=\"mjx-c64\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c76\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c73\"></mjx-c><mj