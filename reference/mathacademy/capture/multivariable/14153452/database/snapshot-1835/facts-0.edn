e4-cae8-5eb0-a93f-798ba20485a6" #edb/ref 17592186045417] [17592186198493 #edb/ref 1043 #edb/ref 17592186199296 #edb/ref 17592186045417] [17592186198493 #edb/ref 1043 #edb/ref 17592186199297 #edb/ref 17592186045417] [17592186198493 #edb/ref 1043 #edb/ref 17592186199298 #edb/ref 17592186045417] [17592186198493 #edb/ref 1043 #edb/ref 17592186199320 #edb/ref 17592186045417] [17592186198493 #edb/ref 1043 #edb/ref 17592186199321 #edb/ref 17592186045417] [17592186198493 #edb/ref 1043 #edb/ref 17592186199322 #edb/ref 17592186045417] [17592186198493 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186198493 #edb/ref 1045 "Flux Through Closed Surfaces" #edb/ref 17592186045417] [17592186198493 #edb/ref 1046 #edb/ref 17592186199320 #edb/ref 17592186045417] [17592186198493 #edb/ref 1049 #edb/ref 17592186049315 #edb/ref 17592186045417] [17592186198493 #edb/ref 1050 1020.0 #edb/ref 17592186045417] [17592186198493 #edb/ref 1053 #uuid "342a691e-fc66-56ce-aabf-098ff3242cb2" #edb/ref 17592186045417] [17592186198601 #edb/ref 1068 #edb/ref 17592186277796 #edb/ref 17592186045417] [17592186198601 #edb/ref 1069 "q-161162" #edb/ref 17592186045417] [17592186198601 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186198601 #edb/ref 1071 "![](images/89/8901e7155a476f0019b6d66e3b62b579b91daf99a448e497c93efce1d94415b0.png)\n\nConsider the vector field $F(x,y,z)=⟨0,\\,0,\\,2x+yz⟩$ and the surface $S$ defined by the bounding region of the rectangular solid shown above in the first octant. Calculate the flux of $F$ through $S.$" #edb/ref 17592186045417] [17592186198601 #edb/ref 1072 #uuid "300078ae-d2f8-55e0-bd83-9b0b9c3615b4" #edb/ref 17592186045417] [17592186198601 #edb/ref 1074 "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that only the $z$-component of $F=⟨0,\\,0,\\,2x+yz⟩$ is non-zero. Since the lateral sides of $S$ are parallel to the $z$-axis, the flux of $F$ through $S$ will be non-zero only at the top and bottom sides. \n\n![](images/8f/8fa71e16d84eb92506e9b10269182f907cb4f2437d0a9bdd3822da48c4cbba4a.png)\n\n \n\nLet's consider the flux of $F$ through these two sides.\n\n- Let ${S}_{1}$ denote the top surface. On this surface, we have $z=2$ for $0\\le x\\le 1$ and $0\\le y\\le 1.$ The outward-pointing unit normal vector to ${S}_{1}$ is\n\n$$\n{n}_{1}=⟨0,\\,0,\\,1⟩.\n$$\n\nUsing the fact that $z=2$ on ${S}_{1},$ we have\n\n$$\n\\begin{aligned}F\\cdot {n}_{1} & =⟨0,\\,0,\\,2x+yz⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =⟨0,\\,0,\\,2x+2y⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =2x+2y.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across ${S}_{1}$ as follows:\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}{S}_{1} & ={∬}_{{S}_{1}}F\\cdot {n}_{1}\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}2x+2y\\,\\text{d}S \\\\  & ={∬}_{D}2x+2y\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}2x+2y\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{[{x}^{2}+2xy]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}1+2y\\,\\text{d}y \\\\  & ={[y+{y}^{2}]}_{0}^{1} \\\\  & =2.\\end{aligned}\n$$\n\n- Let ${S}_{2}$ denote the bottom surface. On this surface, we have $z=0$ for $0\\le x\\le 1$ and $0\\le y\\le 1.$ The outward-pointing unit normal vector to ${S}_{2}$ is\n\n$$\n{n}_{2}=⟨0,\\,0,\\,-1⟩.\n$$\n\nUsing the fact that $z=0$ on ${S}_{2},$ we have\n\n$$\n\\begin{aligned}F\\cdot {n}_{2} & =⟨0,\\,0,\\,2x+yz⟩\\cdot ⟨0,\\,0,\\,-1⟩ \\\\  & =⟨0,\\,0,\\,2x⟩\\cdot ⟨0,\\,0,\\,-1⟩ \\\\  & =-2x.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across ${S}_{2}$ as follows:\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot \\text{d}{S}_{2} & ={∬}_{{S}_{2}}F\\cdot {n}_{2}\\,\\text{d}S \\\\  & ={∬}_{{S}_{2}}-2x\\,\\text{d}S \\\\  & ={∬}_{D}-2x\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}-2x\\,\\text{d}x\\,\\text{d}y \\\\  & =-{\\int }_{0}^{1}\\,\\text{d}y{\\int }_{0}^{1}2x\\,\\text{d}x \\\\  & =-1\\cdot {[{x}^{2}]}_{0}^{1} \\\\  & =-1\\cdot 1 \\\\  & =-1\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}F\\cdot n\\,\\text{d}S+{∬}_{{S}_{2}}F\\cdot n\\,\\text{d}S \\\\  & =2+(-1) \\\\  & =1.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186199296 #edb/ref 1058 #edb/ref 17592186199322 #edb/ref 17592186045417] [17592186199296 #edb/ref 1061 44438 #edb/ref 17592186045417] [17592186199296 #edb/ref 1062 #uuid "f24da8a5-d03b-52d4-93ed-bd3587f66dfa" #edb/ref 17592186045417] [17592186199296 #edb/ref 1063 #edb/ref 17592186198390 #edb/ref 17592186045417] [17592186199297 #edb/ref 1058 #edb/ref 17592186199321 #edb/ref 17592186045417] [17592186199297 #edb/ref 1061 44442 #edb/ref 17592186045417] [17592186199297 #edb/ref 1062 #uuid "bfcf599a-5392-50e6-bb70-aea6cfbb105a" #edb/ref 17592186045417] [17592186199297 #edb/ref 1063 #edb/ref 17592186198391 #edb/ref 17592186045417] [17592186199298 #edb/ref 1058 #edb/ref 17592186199297 #edb/ref 17592186045417] [17592186199298 #edb/ref 1061 44445 #edb/ref 17592186045417] [17592186199298 #edb/ref 1062 #uuid "2deaec25-cf1d-52dd-97eb-efa9bad2cd8f" #edb/ref 17592186045417] [17592186199298 #edb/ref 1063 #edb/ref 17592186199469 #edb/ref 17592186045417] [17592186199320 #edb/ref 1058 #edb/ref 17592186199296 #edb/ref 17592186045417] [17592186199320 #edb/ref 1061 44783 #edb/ref 17592186045417] [17592186199320 #edb/ref 1062 #uuid "70493dbd-ab3f-5404-8591-79605bde33e1" #edb/ref 17592186045417] [17592186199320 #edb/ref 1063 #edb/ref 17592186199479 #edb/ref 17592186045417] [17592186199321 #edb/ref 1061 44787 #edb/ref 17592186045417] [17592186199321 #edb/ref 1062 #uuid "c5b99d56-2b0a-5e62-9a25-4853c59d5bab" #edb/ref 17592186045417] [17592186199321 #edb/ref 1063 #edb/ref 17592186199480 #edb/ref 17592186045417] [17592186199322 #edb/ref 1058 #edb/ref 17592186199298 #edb/ref 17592186045417] [17592186199322 #edb/ref 1061 44792 #edb/ref 17592186045417] [17592186199322 #edb/ref 1062 #uuid "7203bf6c-a682-5850-807b-ad02403f986a" #edb/ref 17592186045417] [17592186199322 #edb/ref 1063 #edb/ref 17592186198404 #edb/ref 17592186045417] [17592186199469 #edb/ref 1064 "![](images/d2/d2a5641e502b11cca4f469ec743adc62d614f669d61c1b2d0b0c7549fb60bf6b.png)\n\n \n\nGiven a sphere of radius $r$ centered at the origin, an outward-pointing unit normal vector to the sphere at the point $P(x,y,z)$ is given by\n\n$$\n\\begin{aligned}n & =\\frac{⟨x,\\,y,\\,z⟩}{r}.\\end{aligned}\n$$\n\nWe can sometimes use this to calculate the flux of a vector field through a sphere. Let's see an example." #edb/ref 17592186045417] [17592186199469 #edb/ref 1065 7652 #edb/ref 17592186045417] [17592186199469 #edb/ref 1066 #uuid "6dc7d279-b10e-5ca3-b496-0382ff5c50ac" #edb/ref 17592186045417] [17592186199469 #edb/ref 1067 "The Outward-Pointing Unit Vector to a Sphere" #edb/ref 17592186045417] [17592186199479 #edb/ref 1064 "Similar to the case of *closed* curves, there is always a well-defined notion of \"inside\" and \"outside\" a closed *surface*. \n\nFor closed surfaces, the convention is the positive orientation is always given by the *outward-pointing* unit normal vector.\n\n![](images/d2/d2bb07e4684cfc3a8c5641ecc6930dbc1c76027a735c7efe0c1c60cd17a91060.png)\n\n \n\nWhen calculating the flux of a vector field $\\mathbf F$ across a closed surface, we always measure the flux relative to the surface's positive orientation.  \n\nLet's see an example." #edb/ref 17592186045417] [17592186199479 #edb/ref 1065 7726 #edb/ref 17592186045417] [17592186199479 #edb/ref 1066 #uuid "9a27f82e-a934-5e25-87cc-8140ba349eae" #edb/ref 17592186045417] [17592186199479 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186199480 #edb/ref 1064 "Let's derive the formula for a unit normal vector for a sphere of radius $r$ centered at the origin. \n\nConsider the function  \n\n$$\nw = f (x, y, z)= \\dfrac 1 2\\left(x^2 + y^2 + z^2 - r^2\\right).\n$$\n\n \n\nThe level surface corresponding to $w=0$ is the sphere $S$ with equation $x^2 + y^2 + z^2 = r^2.$ \n\nConsider the point $P(x,y,z)$ that lies on $S.$ Then, $\\nabla f(x,y,z)$ is a normal vector to the level surface at the point $P$.\n\nComputing $\\nabla f(x,y,z),$ we get\n\n$$\n\\begin{aligned}∇f(x,y,z) & =⟨{f}_{x},\\,{f}_{y},\\,{f}_{z}⟩ \\\\  & =\\frac{1}{2}⟨2x,\\,2y,\\,2z⟩ \\\\  & =⟨x,\\,y,\\,z⟩.\\end{aligned}\n$$\n\nSince $P(x,y,z)$ lies on $S,$ we have $x^2 + y^2 + z^2 = r^2.$\nNormalizing $\\nabla f(x,y,z),$ we get\n\n$$\n\\begin{aligned}n & =\\frac{∇f(x,y,z)}{‖∇f(x,y,z)‖} \\\\  & =\\frac{⟨x,\\,y,\\,z⟩}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}} \\\\  & =\\frac{⟨x,\\,y,\\,z⟩}{r}.\\end{aligned}\n$$\n\nTherefore, the unit normal vector for a sphere of radius $r$ centered at the origin is\n\n$$\n\\begin{aligned}n & =\\frac{⟨x,\\,y,\\,z⟩}{r}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186199480 #edb/ref 1065 7729 #edb/ref 17592186045417] [17592186199480 #edb/ref 1066 #uuid "51218e5e-009c-5c0c-8034-3440e9b736c0" #edb/ref 17592186045417] [17592186199480 #edb/ref 1067 "Deriving the Unit Normal Vector for a Sphere" #edb/ref 17592186045417] [17592186275601 #edb/ref 1080 "\\frac{28}{3}" #edb/ref 17592186045417] [17592186275601 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186275601 #edb/ref 1083 #uuid "0e9c78dc-55fa-58d4-a093-f9544e5dfbd9" #edb/ref 17592186045417] [17592186275787 #edb/ref 1080 "\\frac{64\\pi (8-3\\sqrt{3})}{3}" #edb/ref 17592186045417] [17592186275787 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186275787 #edb/ref 1083 #uuid "22aa9306-b821-5f7a-bcc1-13baa3e5f288" #edb/ref 17592186045417] [17592186275913 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186275913 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186275913 #edb/ref 1083 #uuid "310404f5-f868-54f7-b01b-a2a18674d442" #edb/ref 17592186045417] [17592186276393 #edb/ref 1080 "\\pi +3\\sqrt{2}" #edb/ref 17592