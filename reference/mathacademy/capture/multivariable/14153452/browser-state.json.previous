><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>64</mn><mi>π</mi><mo stretchy=\"false\">(</mo><mn>8</mn><mo>−</mo><mn>3</mn><msqrt><mn>3</mn></msqrt><mo stretchy=\"false\">)</mo></mrow><mn>3</mn></mfrac></mstyle><mo>+</mo><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mrow><mn>64</mn><mi>π</mi><mo stretchy=\"false\">(</mo><mn>8</mn><mo>−</mo><mn>3</mn><msqrt><mn>3</mn></msqrt><mo stretchy=\"false\">)</mo></mrow><mn>3</mn></mfrac></mstyle><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
