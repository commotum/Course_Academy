      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153452/observations/step-q161222-190095d0889fbed68340.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153452/observations/step-q161222-190095d0889fbed68340.png",
      "source_url": "https://mathacademy.com/tasks/14153452/topics/4162/review",
      "captured_at": 1791851307.0448115,
      "math_academy_id": "q-161222",
