      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153452/observations/step-q161162-a60a86e98bac8e9e8e23.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153452/observations/step-q161162-a60a86e98bac8e9e8e23.png",
      "source_url": "https://mathacademy.com/tasks/14153452/topics/4162/review",
      "captured_at": 1791851247.4947817,
      "math_academy_id": "q-161162",
      "topic_id": "4162",
      "sequence_position": null,
