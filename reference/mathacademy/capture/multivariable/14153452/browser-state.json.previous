      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153452/observations/step-q161207-c14540f90140e4c387e3.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14153452/observations/step-q161207-c14540f90140e4c387e3.png",
      "source_url": "https://mathacademy.com/tasks/14153452/topics/4162/review",
      "captured_at": 1791851268.3053153,
      "math_academy_id": "q-161207",
