#{[{:db/id #edb/ref 17592186172308 :knowledge-point/_questions [{:db/id #edb/ref 17592186172100 :knowledge-point/id #uuid "d5c7e707-c978-566d-8a69-98c84c7eb53e" :knowledge-point/title "Expressing Flux as a Double Integral Using Green's Theorem in Flux Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6730175f-e2ca-5f18-8300-20f526084f78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186424462} {:answer/id #uuid "9d5ab6e6-3ed2-5325-ad32-339384996043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(x+y)" :db/id #edb/ref 17592186424477} {:answer/id #uuid "ae24f312-5321-5cc9-87dd-f8625d1a40c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(x-y)" :db/id #edb/ref 17592186424483} {:answer/id #uuid "b7765c6a-5ae2-501d-ad46-c25d34ebcac5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}({x}^{2}+{y}^{2})" :db/id #edb/ref 17592186424484} {:answer/id #uuid "e838f00f-7aa2-51c0-8734-9a7dc0bd6c20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(y-x)" :db/id #edb/ref 17592186424496}] :answer-field/correct {:answer/id #uuid "9d5ab6e6-3ed2-5325-ad32-339384996043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(x+y)" :db/id #edb/ref 17592186424477} :answer-field/id #uuid "6725b75c-c66c-52af-8566-302236c9d990" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168711}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eeef3f59-4373-5478-9f71-3d8588687de5" :question/math-academy-id "q-127070" :question/problem "According to the flux form of Green's theorem, the flux of the vector field \n$F(x,y)=⟨{x}^{2}+1,\\,{y}^{2}⟩$\nacross the triangle $C$ with vertices $(0,0),(1,0),$ and $(0,2)$ can be represented as\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}f(x,y)\\,\\text{d}A,\n$$\n\nwhere $C$ is traversed counterclockwise, $n$ is the outward-pointing unit normal vector to $C,$ and $D$ is the region bounded by $C.$ Calculate the function $f(x,y).$" :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\,\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n \n\n![](images/c3/c3c617522488e6ebf47dd2b2a52c43a1fe06ccaef8cd1e8752ab4df5e2d4bd64.png)\n\nWe have that $P(x,y)={x}^{2}+1$ and $Q(x,y)={y}^{2}.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2x,\\,\\frac{∂Q}{∂y} & =2y.\\end{aligned}\n$$\n\nTherefore, applying the flux form of Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2x+2y)\\,\\text{d}A \\\\  & ={∬}_{D}2(x+y)\\,\\text{d}A.\\end{aligned}\n$$\n\nHence, $f(x,y)=2(x+y).$"}] [{:db/id #edb/ref 17592186424524 :knowledge-point/_questions [{:db/id #edb/ref 17592186172100 :knowledge-point/id #uuid "d5c7e707-c978-566d-8a69-98c84c7eb53e" :knowledge-point/title "Expressing Flux as a Double Integral Using Green's Theorem in Flux Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "209d3320-50d9-50ef-9a25-a823b828f588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-3{y}^{2}" :db/id #edb/ref 17592186424447} {:answer/id #uuid "3eed97bf-f19a-5ae8-9a9c-33659aaf6987" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x{y}^{2}" :db/id #edb/ref 17592186424454} {:answer/id #uuid "5c52dcea-70d7-560b-8792-445eff50c6a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-3{y}^{2}" :db/id #edb/ref 17592186424459} {:answer/id #uuid "8cceeb19-30be-531c-aaa0-0ea7e33dd634" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3{y}^{2}" :db/id #edb/ref 17592186424474} {:answer/id #uuid "eaf9c71a-e752-5728-b94c-b39be38cdb47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+2{y}^{2}" :db/id #edb/ref 17592186424497}] :answer-field/correct {:answer/id #uuid "8cceeb19-30be-531c-aaa0-0ea7e33dd634" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3{y}^{2}" :db/id #edb/ref 17592186424474} :answer-field/id #uuid "f8f6f773-72e6-553b-a49d-36c27b57974f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424513}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fec27738-a1e3-5883-83b7-8672ecd1a476" :question/math-academy-id "q-127224" :question/problem "According to the flux form of Green's theorem, the flux of the vector field \n$F(x,y)=⟨{x}^{2}+{y}^{2},\\,{x}^{3}+{y}^{3}⟩$\nacross the triangle $C$ with vertices $(0,0),(0,-2),$ and $(1,-1)$ can be represented as\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}f(x,y)\\,\\text{d}A,\n$$\n\nwhere $C$ is traversed counterclockwise, $n$ is the outward-pointing unit normal vector to $C,$ and $D$ is the region bounded by $C.$ Calculate the function $f(x,y).$" :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/f1/f1b9472021d3973167a7601785803837627476a4e8b1460e42f87e91ecb99d7e.png)\n\nWe have that $P(x,y)={x}^{2}+{y}^{2}$ and $Q(x,y)={x}^{3}+{y}^{3}.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2x,\\,\\frac{∂Q}{∂y} & =3{y}^{2}.\\end{aligned}\n$$\n\nTherefore, applying the flux form of Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2x+3{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nHence, $f(x,y)=2x+3{y}^{2}.$"}] [{:db/id #edb/ref 17592186541081 :knowledge-point/_questions [{:db/id #edb/ref 17592186172101 :knowledge-point/id #uuid "f2a418f9-b4da-53b4-a39c-75d28dfa8595" :knowledge-point/title "Calculating Flux Across Rectangles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42f7866a-874a-59e8-98df-e82497daf28c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186540642} {:answer/id #uuid "44289665-fb34-50eb-942c-684dbafac462" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186540644} {:answer/id #uuid "5d52696f-f66a-5483-9d31-ad3010ca9bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186540685} {:answer/id #uuid "675393a7-a22d-52c0-8122-89d84461848c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186540704} {:answer/id #uuid "7b1a18cf-57e7-594a-bab2-ece7b5646c56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186540734}] :answer-field/correct {:answer/id #uuid "7b1a18cf-57e7-594a-bab2-ece7b5646c56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186540734} :answer-field/id #uuid "dcc96fea-c51a-5b5e-9f54-45e9c86734fe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186541040}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "512baac6-6af2-5983-be4f-040d5e0743f6" :question/math-academy-id "q-127327" :question/problem "Use the flux form of Green's theorem to calculate the flux of the vector field\n\n$$\nF(x,y)=⟨y\\operatorname{cos}⁡y+y{x}^{3},\\,\\sqrt[3]{x}+y⟩\n$$\n\nthrough the boundary of the square with vertices $(-1,0),(1,0),(1,2),$ and $(-1,2).$" :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/fa/fa98f3db31860a463d0a551d5297895e61a6c041d852c04de04c44a194510961.png)\n\nWe have that $P(x,y)=y\\operatorname{cos}⁡y+y{x}^{3}$ and $Q(x,y)=\\sqrt[3]{x}+y.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=3{x}^{2}y,\\,\\frac{∂Q}{∂y} & =1.\\end{aligned}\n$$\n\nWe can express the rectangular region $D$ as follows:\n\n$$\nD=\\{(x,y):-1\\le x\\le 1,\\,0\\le y\\le 2\\}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,dy-Q\\,dx \\\\  & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(3{x}^{2}y+1)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}(3{x}^{2}y+1)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}({x}^{3}y+x)\\,{|}_{-1}^{1}\\,dy \\\\  & ={\\int }_{0}^{2}[((1)^{3}y+1)-((-1)^{3}y+(-1))]\\,dy \\\\  & ={\\int }_{0}^{2}(2y+2)\\,dy \\\\  & =[{y}^{2}+2y]_{0}^{2} \\\\  & =((2)^{2}+2(2))-0 \\\\  & =8.\\end{aligned}\n$$"}]}
