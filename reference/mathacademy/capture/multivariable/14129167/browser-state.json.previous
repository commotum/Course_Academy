      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129167/observations/step-q131196-92af3a55696d9c533437.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129167/observations/step-q131196-92af3a55696d9c533437.png",
      "source_url": "https://mathacademy.com/tasks/14129167/topics/2131/lesson",
      "captured_at": 1791770034.8424754,
      "math_academy_id": "q-131196",
