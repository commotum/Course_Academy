#{[{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186167701} :activity/id #uuid "da428aa9-1060-5793-9767-c17e69edc8d7" :activity/scope {:db/id #edb/ref 17592186049314 :topic/id #uuid "eb87a0b0-198f-5c1c-98ee-ceab471e0302" :topic/math-academy-id 3252} :activity/steps [{:db/id #edb/ref 17592186167586 :step/content {:db/id #edb/ref 17592186166754 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166592 :question/id #uuid "181b2a5e-7caf-5527-8602-e67a945affde" :question/math-academy-id "e-8337"} :knowledge-point/id #uuid "8e25ae0e-d10c-5fa4-924e-4c6a7efebac6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051084}] :knowledge-point/questions [{:db/id #edb/ref 17592186167333} {:db/id #edb/ref 17592186167354} {:db/id #edb/ref 17592186516766} {:db/id #edb/ref 17592186516789} {:db/id #edb/ref 17592186516831} {:db/id #edb/ref 17592186516832} {:db/id #edb/ref 17592186516853} {:db/id #edb/ref 17592186518166}] :knowledge-point/title "Differentiating an Inverse Sinh Function"} :step/id #uuid "80927e2b-51cd-5e26-a650-a211e98b5b70" :step/math-academy-id 31144 :step/next {:db/id #edb/ref 17592186167587}} {:db/id #edb/ref 17592186167587 :step/content {:db/id #edb/ref 17592186166755 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166593 :question/id #uuid "ce19d882-3c04-5ef1-8393-7de582df188d" :question/math-academy-id "e-8338"} :knowledge-point/id #uuid "eaab6e41-d34d-5eca-a41f-5ebe58a6b178" :knowledge-point/questions [{:db/id #edb/ref 17592186167334} {:db/id #edb/ref 17592186167377} {:db/id #edb/ref 17592186516779} {:db/id #edb/ref 17592186516782} {:db/id #edb/ref 17592186516858} {:db/id #edb/ref 17592186516866} {:db/id #edb/ref 17592186518144} {:db/id #edb/ref 17592186518170}] :knowledge-point/title "Differentiating an Inverse Cosh Function"} :step/id #uuid "72a68e36-0920-5a87-b35c-8244164aa23e" :step/math-academy-id 31145 :step/next {:db/id #edb/ref 17592186167588}} {:db/id #edb/ref 17592186167588 :step/content {:db/id #edb/ref 17592186166756 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166594 :question/id #uuid "d5eeb5a1-4bfd-5f1e-b261-548c91eec64b" :question/math-academy-id "e-8339"} :knowledge-point/id #uuid "1979b91d-2ac0-5d35-b4cc-1c9c9505b503" :knowledge-point/questions [{:db/id #edb/ref 17592186167335} {:db/id #edb/ref 17592186167353} {:db/id #edb/ref 17592186360604} {:db/id #edb/ref 17592186516767} {:db/id #edb/ref 17592186516800} {:db/id #edb/ref 17592186516844} {:db/id #edb/ref 17592186518156} {:db/id #edb/ref 17592186518178}] :knowledge-point/title "Differentiating an Inverse Tanh Function"} :step/id #uuid "ef9c2df4-390a-50bb-8e1e-90ff592b4bee" :step/math-academy-id 31146 :step/next {:db/id #edb/ref 17592186167589}} {:db/id #edb/ref 17592186167589 :step/content {:db/id #edb/ref 17592186166757 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166595 :question/id #uuid "7cd3958b-aa1c-5c9a-b2ef-a21002aa7ff1" :question/math-academy-id "e-8340"} :knowledge-point/id #uuid "57d851ce-44b5-5713-ba65-7f5a9cc1122f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813} {:db/id #edb/ref 17592186048842}] :knowledge-point/questions [{:db/id #edb/ref 17592186167336} {:db/id #edb/ref 17592186167337} {:db/id #edb/ref 17592186518158} {:db/id #edb/ref 17592186518214}] :knowledge-point/title "Differentiating Inverse Hyperbolic Functions Using the Product and Quotient Rules"} :step/id #uuid "80771e82-bccd-5a3a-b98a-e59fd31c7940" :step/math-academy-id 31147 :step/next {:db/id #edb/ref 17592186167710}} {:db/id #edb/ref 17592186167701 :step/content {:db/id #edb/ref 17592186168091 :tutorial/content "The derivatives of the base inverse hyperbolic functions are shown below:\n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}+1}}, &  & \\,x\\in (-\\infty ,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}-1}}, &  & \\,x\\in (1,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x) & =\\frac{1}{1-{x}^{2}}, &  & \\,x\\in (-1,1)\\end{aligned}\n$$\n\nNow that we know the derivative of the base inverse hyperbolic functions, we can differentiate combinations of these functions, by using the properties of differentiation.\n\nFor example, let's find the derivative of \n\n$$\ny = \\arcosh(x^2).\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡({x}^{2})) \\\\  & =\\frac{1}{\\sqrt{({x}^{2})^{2}-1}}\\cdot {({x}^{2})}^{′} \\\\  & =\\frac{1}{\\sqrt{{x}^{4}-1}}\\cdot 2x \\\\  & =\\frac{2x}{\\sqrt{{x}^{4}-1}}.\\end{aligned}\n$$" :tutorial/id #uuid "30ebb598-5737-5a10-9f96-b450c6c56039" :tutorial/math-academy-id 5209 :tutorial/title "Introduction"} :step/id #uuid "9c01d83c-633c-5a68-bac0-26e7193c94c5" :step/math-academy-id 32693 :step/next {:db/id #edb/ref 17592186167586}} {:db/id #edb/ref 17592186167710 :step/content {:db/id #edb/ref 17592186168100 :tutorial/content "We derive formulas for the derivatives of the inverse hyperbolic functions from the functions' definitions. \n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nFor instance, let's show that\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arsinh{x}) = \\dfrac{1}{\\sqrt{x^2+1}}.\n$$\n\nRecall that\n\n$$\n\\arsinh{x} = \\ln\\big(x+\\sqrt{x^2+1}\\big).\n$$\n\nDifferentiating using the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(x+\\sqrt{{x}^{2}+1})) \\\\  & =\\frac{1}{x+\\sqrt{{x}^{2}+1}}\\cdot (x+\\sqrt{{x}^{2}+1})^{′} \\\\  & =\\frac{(1+\\frac{x}{\\sqrt{{x}^{2}+1}})}{x+\\sqrt{{x}^{2}+1}} \\\\  & =\\frac{\\sqrt{{x}^{2}+1}+x}{\\sqrt{{x}^{2}+1}(x+\\sqrt{{x}^{2}+1})} \\\\  & =\\frac{\\cancel{x+\\sqrt{{x}^{2}+1}}}{\\sqrt{{x}^{2}+1}\\cancel{(x+\\sqrt{{x}^{2}+1})}} \\\\  & =\\frac{1}{\\sqrt{{x}^{2}+1}}.\\end{aligned}\n$$\n\nSimilarly, we can obtain the other formulas." :tutorial/id #uuid "05e38300-7cf8-5c4d-b35e-139ea77d72ee" :tutorial/math-academy-id 5225 :tutorial/title "Deriving the Derivatives of Inverse Hyperbolic Functions"} :step/id #uuid "10ef08f5-4066-5fac-874a-baef7c0c14e5" :step/math-academy-id 32715}] :activity/title "Differentiating Inverse Hyperbolic Functions" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186167019}]}
