#{[{:activity/expected-seconds 600.0 :activity/first-step {:db/id #edb/ref 17592186495218} :activity/id #uuid "24b39a23-bcdc-53b3-a773-ff2a2a0400ae" :activity/scope {:db/id #edb/ref 17592186495275 :topic/id #uuid "04654553-f8da-5ec9-a27d-ee5bae447da5" :topic/math-academy-id 6818} :activity/steps [{:db/id #edb/ref 17592186495185 :step/content {:db/id #edb/ref 17592186495042 :knowledge-point/canonical-example {:db/id #edb/ref 17592186495129 :question/id #uuid "b63d3979-8319-52e5-833c-e4230a367cb0" :question/math-academy-id "e-4540"} :knowledge-point/id #uuid "04d9118c-9cc2-5bb5-a7c4-ce43be06a65d" :knowledge-point/questions [{:db/id #edb/ref 17592186495064} {:db/id #edb/ref 17592186495092} {:db/id #edb/ref 17592186495122} {:db/id #edb/ref 17592186495135} {:db/id #edb/ref 17592186495147}] :knowledge-point/title "Determining the Best Deal by Computing Unit Prices"} :step/id #uuid "1de7948d-68f8-5999-953c-8acb8be31016" :step/math-academy-id 616955 :step/next {:db/id #edb/ref 17592186495238}} {:db/id #edb/ref 17592186495190 :step/content {:db/id #edb/ref 17592186495281 :tutorial/content "Unit prices can be used to quantify how good of a deal a particular purchase is.\n\nFor example, suppose that a store sells two packs of shirts:\n\n- $3$ shirts for $\\[math]12$\n\n- $5$ shirts for $\\[/math]15$\n\nTo determine which pack is the better deal, we can compare their unit prices.\n\n- For the pack of $3$ shirts for $\\[math]12,$ dividing the total cost by the total number of shirts gives\n\n$$\n12 \\div 3 = 4.\n$$\n\nSo, the unit price is $\\[/math]4.$\n\n- For the pack of $5$ shirts for $\\[math]15,$ dividing the total cost by the total number of shirts gives\n\n$$\n15 \\div 5 = 3.\n$$\n\nSo, the unit price is $\\[/math]3.$\n\nNow we interpret the unit prices in the context of the problem.\n\n- In the pack of $3$ shirts for $\\[math]12,$ each shirt costs $\\[/math]4.$\n\n- In the pack of $5$ shirts for $\\[math]15,$ each shirt costs $\\[/math]3.$\n\nBased on the above, we conclude that the pack of $5$ shirts for $\\[math]15$ is the better deal because it has a lower unit price (meaning that each shirt costs less)." :tutorial/id #uuid "be64d01c-4eb7-5332-b26c-97583b224a56" :tutorial/math-academy-id 15097 :tutorial/title "Determining the Best Deal by Computing Unit Prices"} :step/id #uuid "235b590b-52bc-52e8-a4ef-db453fdea765" :step/math-academy-id 616954 :step/next {:db/id #edb/ref 17592186495185}} {:db/id #edb/ref 17592186495197 :step/content {:db/id #edb/ref 17592186495043 :knowledge-point/canonical-example {:db/id #edb/ref 17592186495075 :question/id #uuid "3a104615-4887-59c8-9722-bb07b6cca5ae" :question/math-academy-id "e-4542"} :knowledge-point/id #uuid "1321abcb-7c99-5fef-b4fb-975ae5652b90" :knowledge-point/questions [{:db/id #edb/ref 17592186495066} {:db/id #edb/ref 17592186495086} {:db/id #edb/ref 17592186495096} {:db/id #edb/ref 17592186495102} {:db/id #edb/ref 17592186495111}] :knowledge-point/title "Working With a Reciprocal Unit Price"} :step/id #uuid "30f25678-f130-575f-b357-4ffe8b59f407" :step/math-academy-id 616959} {:db/id #edb/ref 17592186495218 :step/content {:db/id #edb/ref 17592186495280 :tutorial/content "When we compare prices, it is often helpful to know the *unit price*. Knowing it helps us:\n\n- compare different products,\n\n- determine the total cost for a given amount,\n\n- decide which option is the better deal.\n\nFor example, suppose Lena wants to buy some apples. The price of apples at a nearby market is $\\[math]1.20/\\mathrm{lb}.$ How much would Lena pay for $4$ pounds of apples?\n\nThe unit price is $\\[/math]1.20$ per pound.  \n\nSince Lena is buying $4$ pounds, we multiply the unit price by the number of pounds:\n\n$$\n\\begin{aligned}1.20\\times 4 & =4.80\\end{aligned}\n$$\n\nTherefore, Lena would pay $\\[math]4.80$ for $4$ pounds of apples.\n\nWhenever we know the unit price and the quantity, we can find the total cost by multiplying:\n\n$$\n\\text{Total Cost} = \\text{Unit Price} \\times \\text{Quantity}.\n$$" :tutorial/id #uuid "55a58a08-8164-5352-9b75-43c62ba6ecc5" :tutorial/math-academy-id 15086 :tutorial/title "Introduction"} :step/id #uuid "7f189f23-779a-5ab6-9245-89a7a070f017" :step/math-academy-id 616950 :step/next {:db/id #edb/ref 17592186495245}} {:db/id #edb/ref 17592186495238 :step/content {:db/id #edb/ref 17592186495278 :tutorial/content "For every unit price in \"dollars per item\", there is also a **reciprocal unit price** in \"items per dollar\".\n\nFor example, suppose that a store sells fabric for $\\[math]2$ per yard. Taking the reciprocal, we have\n\n$$\n2 \\,\\textrm{dollars per yard} \\quad\\rightarrow\\quad \\dfrac{1}{2}  \\,\\textrm{yards per dollar} .\n$$\n\nSo, if we have $\\[/math]1,$ then we can buy $\\dfrac{1}{2}$ of a yard of fabric." :tutorial/id #uuid "18f05709-44a6-59bc-962c-dbf491ad7501" :tutorial/math-academy-id 3106 :tutorial/title "Reciprocal Unit Prices"} :step/id #uuid "aebf2791-ae4f-5ea2-8312-994b316164b5" :step/math-academy-id 616958 :step/next {:db/id #edb/ref 17592186495197}} {:db/id #edb/ref 17592186495245 :step/content {:db/id #edb/ref 17592186495046 :knowledge-point/canonical-example {:db/id #edb/ref 17592186495154 :question/id #uuid "df05a979-ea59-5937-80a7-89e9e0014ca8" :question/math-academy-id "e-4539"} :knowledge-point/id #uuid "d550bb4f-72a6-5b74-b050-8fdc2af6b23f" :knowledge-point/questions [{:db/id #edb/ref 17592186495071} {:db/id #edb/ref 17592186495072} {:db/id #edb/ref 17592186495093} {:db/id #edb/ref 17592186495136} {:db/id #edb/ref 17592186495143}] :knowledge-point/title "Calculating a Total Price from a Unit Price"} :step/id #uuid "b7fc4646-02d5-59f6-896d-aa9560955608" :step/math-academy-id 616951 :step/next {:db/id #edb/ref 17592186495190}}] :activity/title "Working With Unit Prices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186494301}]}
