3-5e99-8459-ac9d52a00034" #edb/ref 17592186045417] [17592186479097 #edb/ref 1074 "Applying the multivariable chain rule for the function $f(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂f}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z}=2xyz\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂z} & =2{r}^{2}z\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & ={r}^{2}z\\operatorname{sin}⁡(2\\theta ).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479101 #edb/ref 1068 #edb/ref 17592186478973 #edb/ref 17592186045417] [17592186479101 #edb/ref 1069 "q-165280" #edb/ref 17592186045417] [17592186479101 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186479101 #edb/ref 1071 "Given that $f(x,y)=2y-xy,$ find $\\frac{∂f}{∂\\theta },$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." #edb/ref 17592186045417] [17592186479101 #edb/ref 1072 #uuid "824e717c-810d-5647-9a31-c9225776fabe" #edb/ref 17592186045417] [17592186479101 #edb/ref 1074 "Applying the multivariable chain rule for the function $f(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂\\theta } & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂\\theta } \\\\  & =-\\frac{∂f}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂f}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-y,\\,\\frac{∂f}{∂y}=2-x\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-r\\operatorname{sin}⁡\\theta , \\\\ \\frac{∂f}{∂y} & =2-r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂\\theta } & =(-r\\operatorname{sin}⁡\\theta )\\,(-r\\operatorname{sin}⁡\\theta )+(2-r\\operatorname{cos}⁡\\theta )r\\operatorname{cos}⁡\\theta  \\\\  & ={r}^{2}{sin}^{2}⁡\\theta +2r\\operatorname{cos}⁡\\theta -{r}^{2}{cos}^{2}⁡\\theta  \\\\  & ={r}^{2}({sin}^{2}⁡\\theta -{cos}^{2}⁡\\theta )+2r\\operatorname{cos}⁡\\theta  \\\\  & =-{r}^{2}\\operatorname{cos}⁡(2\\theta )+2r\\operatorname{cos}⁡\\theta  \\\\  & =2r\\operatorname{cos}⁡\\theta -{r}^{2}\\operatorname{cos}⁡(2\\theta ).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479105 #edb/ref 1068 #edb/ref 17592186478967 #edb/ref 17592186045417] [17592186479105 #edb/ref 1069 "q-95137" #edb/ref 17592186045417] [17592186479105 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186479105 #edb/ref 1071 "Given that $h(r,\\theta )=r(\\operatorname{cos}⁡\\theta -1),$ find $\\frac{∂h}{∂x},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." #edb/ref 17592186045417] [17592186479105 #edb/ref 1072 #uuid "88d1b83b-2766-5063-936f-a018502be867" #edb/ref 17592186045417] [17592186479105 #edb/ref 1074 "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂h}{∂x}=\\frac{∂h}{∂r}\\operatorname{cos}⁡\\theta -\\frac{1}{r}\\frac{∂h}{∂\\theta }\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r}=\\operatorname{cos}⁡\\theta -1,\\,\\frac{∂h}{∂\\theta }=-r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =(\\operatorname{cos}⁡\\theta -1)\\operatorname{cos}⁡\\theta -\\frac{1}{r}(-r\\operatorname{sin}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta -\\operatorname{cos}⁡\\theta +{sin}^{2}⁡\\theta  \\\\  & =1-\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479112 #edb/ref 1068 #edb/ref 17592186478977 #edb/ref 17592186045417] [17592186479112 #edb/ref 1069 "q-95170" #edb/ref 17592186045417] [17592186479112 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186479112 #edb/ref 1071 "Given that $w(x,y,z)=x{z}^{4}+y,$ find $\\frac{∂w}{∂r},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." #edb/ref 17592186045417] [17592186479112 #edb/ref 1072 #uuid "a5265619-0ee7-5042-83d2-70d3e989522b" #edb/ref 17592186045417] [17592186479112 #edb/ref 1074 "Applying the multivariable chain rule for the function $w(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂w}{∂r} & =\\frac{∂w}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂w}{∂y}\\cdot \\frac{∂y}{∂r}+\\frac{∂w}{∂z}\\cdot \\frac{∂z}{∂r} \\\\  & =\\frac{∂w}{∂x}\\operatorname{cos}⁡\\theta +\\frac{∂w}{∂y}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $w$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x}={z}^{4},\\,\\frac{∂w}{∂y}=1\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x} & ={z}^{4}, \\\\ \\frac{∂w}{∂y} & =1.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂r} & =({z}^{4})\\operatorname{cos}⁡\\theta +(1)\\operatorname{sin}⁡\\theta  \\\\  & ={z}^{4}\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479124 #edb/ref 1068 #edb/ref 17592186479003 #edb/ref 17592186045417] [17592186479124 #edb/ref 1069 "q-95115" #edb/ref 17592186045417] [17592186479124 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186479124 #edb/ref 1071 "Given that $h(x,y)={x}^{2}-{y}^{2},$ find $\\frac{∂h}{∂r},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." #edb/ref 17592186045417] [17592186479124 #edb/ref 1072 #uuid "c5298f54-bfaf-5a4f-ac68-b78b607bf15c" #edb/ref 17592186045417] [17592186479124 #edb/ref 1074 "Applying the multivariable chain rule for the function $h(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r} & =\\frac{∂h}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂h}{∂y}\\cdot \\frac{∂y}{∂r} \\\\  & =\\frac{∂h}{∂x}\\operatorname{cos}⁡\\theta +\\frac{∂h}{∂y}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x}=2x,\\,\\frac{∂h}{∂y}=-2y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =2r\\operatorname{cos}⁡\\theta , \\\\ \\frac{∂h}{∂y} & =-2r\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂r} & =(2r\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta -(2r\\operatorname{sin}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =2r({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & =2r\\operatorname{cos}⁡(2\\theta ).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479131 #edb/ref 1068 #edb/ref 17592186478994 #edb/ref 17592186045417] [17592186479131 #edb/ref 1069 "q-165281" #edb/ref 17592186045417] [17592186479131 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186479131 #edb/ref 1071 "Given that $f(x,y)={x}^{2}+y,$ find $\\frac{∂f}{∂\\theta },$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." #edb/ref 17592186045417] [17592186479131 #edb/ref 1072 #uuid "d222dcc8-f398-5562-bff7-74444e587da8" #edb/ref 17592186045417] [17592186479131 #edb/ref 1074 "Applying the multivariable chain rule for the function $f(x,y)$ with two independent variables $r$ and $\\theta ,$ where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂\\theta } & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂\\theta } \\\\  & =-\\frac{∂f}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂f}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2x,\\,\\frac{∂f}{∂y}=1\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2r\\operatorname{cos}⁡\\theta , \\\\ \\frac{∂f}{∂y} & =1.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂\\theta } & =-2r\\operatorname{cos}⁡\\theta \\,r\\operatorname{sin}⁡\\theta +r\\operatorname{cos}⁡\\theta  \\\\  & =-{r}^{2}\\operatorname{sin}⁡(2\\theta )+r\\operatorname{cos}⁡\\theta  \\\\  & =r\\operatorname{cos}⁡\\theta -{r}^{2}\\operatorname{sin}⁡(2\\theta ).\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479138 #edb/ref 1068 #edb/ref 17592186478983 #edb/ref 17592186045417] [17592186479138 #edb/ref 1069 "q-95168" #edb/ref 17592186045417] [17592186479138 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186479138 #edb/ref 1071 "Given that $g(x,y,z)={x}^{2}z+{z}^{2},$ find $\\frac{∂g}{∂z},$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." #edb/ref 17592186045417] [17592186479138 #edb/ref 1072 #uuid "e54cb552-8c05-5b9c-84f1-978bbe7cbf63" #edb/ref 17592186045417] [17592186479138 #edb/ref 1074 "Applying the multivariable chain rule for the function $g(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z} & =\\frac{∂g}{∂x}\\cdot \\frac{∂x}{∂z}+\\frac{∂g}{∂y}\\cdot \\frac{∂y}{∂z}+\\frac{∂g}{∂z}\\cdot \\frac{∂z}{∂z} \\\\  & =\\frac{∂g}{∂z}.\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $g$ with respect to $z:$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z}={x}^{2}+2z\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z} & ={r}^{2}{cos}^{2}⁡\\theta +2z.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186479141 #edb/ref 1068 #edb/ref 17592186479039 #edb/ref 17592186045417] [17592186479141 #edb/ref 1069 "q-95169" #edb/ref 17592186045417] [17592186479141 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186479141 #edb/ref 1071 "Given that $h(x,y,z)=xyz,$ find $\\frac{∂h}{∂\\theta },$ where $(x,y,z)$ are Cartesian coordinates and $(r,\\theta ,z)$ are the corresponding cylindrical polar coordinates." #edb/ref 17592186045417] [17592186479141 #edb/ref 1072 #uuid "eb779ef9-c9f2-5338-9ff6-677718e082ac" #edb/ref 17592186045417] [17592186479141 #edb/ref 1074 "Applying the multivariable chain rule for the function $h(x,y,z)$ with three independent variables $r,\\theta ,$ and $z,$ where $x=r\\operatorname{cos}⁡\\theta ,y=r\\operatorname{sin}⁡\\theta ,$ and $z=z,$ we have\n\n$$\n\\begin{aligned}\\frac{∂h}{∂\\theta } & =\\frac{∂h}{∂x}\\cdot \\frac{∂x}{∂\\theta }+\\frac{∂h}{∂y}\\cdot \\frac{∂y}{∂\\theta }+\\frac{∂h}{∂z}\\cdot \\frac{∂z}{∂\\theta } \\\\  & =-\\frac{∂h}{∂x}r\\operatorname{sin}⁡\\theta +\\frac{∂h}{∂y}r\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x}=yz,\\,\\frac{∂h}{∂y}=xz\\end{aligned}\n$$\n\nWriting the above results in terms of $r,\\theta ,$ and $z,$ we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =rz\\operatorname{sin}⁡\\theta , \\\\ \\frac{∂h}{∂y} & =rz\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂\\theta } & =-(rz\\operatorname{sin}⁡\\theta )r\\operatorname{sin}⁡\\theta +(rz\\operatorname{cos}⁡\\theta )r\\operatorname{cos}⁡\\theta  \\\\  & =-{r}^{2}z{sin}^{2}⁡\\theta +{r}^{2}z{cos}^{2}⁡\\theta  \\\\  & ={r}^{2}z({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & ={r}^{2}z\\operatorname{cos}⁡2\\theta .\\end{aligned}\n$$" #edb/ref 17592186045417]}
