d-0d38-5707-b522-539cbb8690bb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186370445} {:answer-field/choices [{:answer/id #uuid "528c2042-bbc6-5b65-b878-9272d65a2ce5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186370452} {:answer/id #uuid "b43d21bb-10b6-5687-9980-27eca8f24674" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186370453} {:answer/id #uuid "692d3869-192d-58b4-82a1-5fd1011b0178" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186370454} {:answer/id #uuid "19170cf0-0c05-5c79-b91c-4fcce8741e39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186370455} {:answer/id #uuid "e79d7c51-4e5f-5066-9c8d-7cd3df0b1c4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186370456}] :answer-field/correct {:db/id #edb/ref 17592186370455} :answer-field/id #uuid "7623ba1f-f48d-519f-bb4e-e3d71b734c62" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186370451} {:answer-field/choices [{:answer/id #uuid "9d93b58c-5231-5a80-86f1-2e9d24fb9b0d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${\\lambda }_{1}=3$ and ${\\lambda }_{2}=-1$" :db/id #edb/ref 17592186370458} {:answer/id #uuid "8eb892db-47c0-5c2c-9f28-82b937114122" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }_{1,2}=\\pm \\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186370459} {:answer/id #uuid "933d9a45-6cc4-5308-bbac-a8a57535238e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-3$" :db/id #edb/ref 17592186370460} {:answer/id #uuid "6e872aac-05ba-58e5-ba5d-e39015c1db21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }_{1,2}=\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186370461}] :answer-field/correct {:db/id #edb/ref 17592186370458} :answer-field/id #uuid "e6a9a8df-f37b-50dd-8556-f70bacf81294" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186370457}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cd854bc5-9792-54c0-806a-73dbdfda7584" :question/math-academy-id "q-335630" :question/problem "$$\n\\left\\{\\begin{aligned}{x}^{′} &=3x(1-0.3x)-4xy \\\\ {y}^{′} &=-y+xy\\end{aligned}\\right.\n$$\n\nConsider the Lotka-Volterra model with carrying capacity above, where $x=x(t)$ represents the prey and $y=y(t)$ represents the predators. Select the correct options in the reasoning below.$\\,$ Evaluating the Jacobian of the system at the equilibrium ${x}^{∗}=[0,\\,0]^{T},$ we get\n\n| $J({x}^{∗})=\\,\\,$ |  | {{field-1}} | {{field-2}} |  | $\\,.$ |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |  |\n\n$\\,$ The eigenvalues of the Jacobian matrix are \n{{field-5}}.\n\n$\\,$ Therefore, the equilibrium at ${x}^{∗}$ is \n{{field-6}}{{field-7}}." :question/worked-solution "Let's denote ${f}_{1}(x,y)=3x(1-0.3x)-4xy$ and ${f}_{2}(x,y)=-y+xy.$\n\nNow, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(3x(1-0.3x)-4xy)=3-1.8x-4y,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(3x(1-0.3x)-4xy)=-4x \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(-y+xy)=y,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(-y+xy)=-1+x\\end{aligned}\n$$\n\nThus, the Jacobian matrix is\n\n$$\nJ=\\begin{bmatrix}3-1.8x-4y & -4x \\\\ y & -1+x\\end{bmatrix}.\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}$ to get\n\n$$\nJ({x}^{∗})=\\begin{bmatrix}3-1.8(0)-4(0) & -4(0) \\\\ 0 & -1+0\\end{bmatrix}=\\begin{bmatrix}3 & 0 \\\\ 0 & -1\\end{bmatrix}.\n$$\n\nThe eigenvalues of the Jacobian matrix are ${\\lambda }_{1}=3\\text{ and }{\\lambda }_{2}=-1.$ Since the eigenvalues are real with opposite signs, our equilibrium is $\\text{an unstable}$ $\\text{saddle}.$"} :step/id #uuid "77086ede-11b7-5f95-8032-15b20f19c4f2"}] :activity/title "The Lotka-Volterra Model With Carrying Capacity" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186520757}] [{:activity/course {:db/id #edb/ref 17592186046669} :activity/first-step {:db/id #edb/ref 17592186562554} :activity/id #uuid "61c53cb2-ee5a-53ac-ad96-619efc5fde54" :activity/scope {:db/id #edb/ref 17592186049289 :topic/id #uuid "ea2533e0-c4a4-5c4e-b20a-9fb6ea3d7c70" :topic/math-academy-id 3231} :activity/steps [{:db/id #edb/ref 17592186562554 :step/content {:db/id #edb/ref 17592186562503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d46c852-71aa-5405-ba00-2818a084e780" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186561624} {:answer/id #uuid "0fccf0f9-84b6-532e-8097-b8950bb64529" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186561629} {:answer/id #uuid "63e9fcea-73e4-51ca-86d6-f52ac7fa3260" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186561825} {:answer/id #uuid "a895dde9-5b19-55fa-9e29-994ae8fb5495" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186561999} {:answer/id #uuid "c4bd1201-33ef-5c84-9772-978f9951dc3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-0.5" :db/id #edb/ref 17592186562075}] :answer-field/correct {:db/id #edb/ref 17592186561624} :answer-field/id #uuid "0d254612-5df9-5924-b8e3-9685b0af8029" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186562228} {:answer-field/choices [{:answer/id #uuid "891a977f-3292-58d0-80ce-2eb4ed53c07c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\lambda }_{1,2}=-0.5\\pm 0.5\\sqrt{7}\\,\\text{i}" :db/id #edb/ref 17592186561923} {:answer/id #uuid "91168c21-a6a8-5be3-b9a9-24deae624ffb" :answer/type {: