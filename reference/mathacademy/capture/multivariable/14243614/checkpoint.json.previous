      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14243614/observations/step-q334872-3ac84e7757bd2e99c5a5.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14243614/observations/step-q334872-3ac84e7757bd2e99c5a5.png",
