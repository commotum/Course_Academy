          "at": 1792101068.6737,
          "url": "https://mathacademy.com/learn",
          "captured_at": 1792101068.6702316,
          "source_sha256": "57e4502e20e0aad0de0e76099845664f52257fb1fb103f86721d59259737d363",
          "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/browser-originals/57e4502e20e0aad0de0e76099845664f52257fb1fb103f86721d59259737d363.html",
          "status": 200,
          "headers": {
            "date": "Thu, 15 Oct 2026 21:51:08 GMT",
            "etag": "W/\"3b985-z0o0FNGZ4XC6q8eLH9eBdC+q6Ho\""
