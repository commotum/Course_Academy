"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>λ</mi><mn>2</mn></msub><mo>=</mo><mn>4</mn></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></div><div class=\"selectListOption\" style=\"height: 27px;\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"26\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D706 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-texatom></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-cB1\"></mjx-c></mjx-mo><mjx-mtext class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c69\"></mjx-c></mjx-mtext></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"73\" jax=\"CHTML\" style=\"font-size: 119.6%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D706 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-texatom size=\"s\" texclass=\"ORD\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-texatom></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c><mjx-c class=\"mjx-c2E\"></mjx-c><mjx-c class=\"mjx-c35\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-cB1\"></mjx-c></mjx-mo><mjx-mtext class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c69\"></mjx-c></mjx-mtext></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>λ</mi><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo>,</mo><mn>2</mn></mrow></msub><mo>=</mo><mn>0.5</mn><mo>±</mo><mtext>i</mtext></math></mjx-assistive-mml></mjx-container></mjx-assistive-mml></mjx-container></div></div></div>.<p></p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"133\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mstyle><mjx-mspace style=\"width: 1em;\"></mjx-mspace></mjx-mstyle></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mstyle scriptlevel=\"0\"><mspace width=\"1em\"></mspace></mstyle></math></mjx-assistive-mml></mjx-container> Therefore, the equilibrium at <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"134\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-msup><mjx-texatom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D431 TEX-B\"></mjx-c></mjx-mi></mjx-texatom><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mo class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c2217\"></mjx-c></mjx-mo></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow><mo>∗</mo></msup></math></mjx-assistive-mml></mjx-container> is \n<div class=\"selectList\" id=\"selectList-334872-5\" style=\"margin: 0px 4px 2px;\"><div class=\"selectListFrame correctSelection\" id=\"selectListFrame-334872-5\" style=\"width: 177px; height: 17px; line-height: 17px;\">an asymptotically stable</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1;\"><div class=\"selectListOption\" style=\"height: 17px;\">an asymptotically stable</div><div class=\"selectListOption\" style=\"height: 17px;\">an unstable</div><div class=\"selectListOption\" style=\"height: 17px;\">a stable</div></div></div><div class=\"selectList\" id=\"selectList-334872-6\" style=\"margin: 0px 2px 2px 4px;\"><div class=\"selectListFrame correctSelection\" id=\"selectListFrame-334872-6\" style=\"width: 103px; height: 17px; line-height: 17px;\">spiral sink</div><div class=\"selectListOptions\" style=\"visibility: hidden; z-index: 1;\"><div class=\"selectListOption\" style=\"height: 17px;\">spiral sink</div><div class=\"selectListOption\" style=\"height: 17px;\">saddle</div><div class=\"selectListOption\" style=\"height: 17px;\">spiral source</div><div class=\"selectListOption\" style=\"height: 17px;\">center</div></div></div>.\n</span></div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyHard\">H</div><span class=\"answerCreated\">Thu, Oct 15th @ 2:52 PM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:50</span><span class=\"answerResult\"><span style=\"color: green;\">Full Credit</span></span></div></div>"
