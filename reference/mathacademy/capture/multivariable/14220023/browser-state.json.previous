      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14220023/observations/step-q362710-0b1b14a0fde02395cb7a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14220023/observations/step-q362710-0b1b14a0fde02395cb7a.png",
