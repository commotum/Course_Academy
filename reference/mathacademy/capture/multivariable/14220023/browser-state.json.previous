      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14220023/observations/step-q352098-28137eac3d6b57e34f63.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14220023/observations/step-q352098-28137eac3d6b57e34f63.png",
      "source_url": "https://mathacademy.com/tasks/14220023/topics/415/lesson",
      "captured_at": 1792022865.2641792,
      "math_academy_id": "q-352098",
      "topic_id": "415",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q352098",
        "placement_id": null,
