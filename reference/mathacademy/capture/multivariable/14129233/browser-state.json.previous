      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129233/observations/step-q83979-7b4251026861b49f25cd.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129233/observations/step-q83979-7b4251026861b49f25cd.png",
      "source_url": "https://mathacademy.com/tasks/14129233/topics/2835/lesson",
      "captured_at": 1791770318.65728,
      "math_academy_id": "q-83979",
      "topic_id": "2835",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q83979",
        "placement_id": null,
