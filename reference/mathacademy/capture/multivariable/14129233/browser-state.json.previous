</mrow><mn>4</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mn>4</mn></mrow></msubsup><mo stretchy=\"false\">(</mo><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo>+</mo><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi><mo stretchy=\"false\">)</mo><msubsup><mo data-mjx-texclass=\"OP\">∫</mo><mrow data-mjx-texclass=\"ORD\"><mi>sec</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>cos</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi></mrow></msubsup><msup><mi>r</mi><mn>2</mn></msup><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>r</mi><mstyle scriptlevel=\"0\"><mspace width=\"0.222em\"></mspace></mstyle><mtext>d</mtext><mi>θ</mi><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
