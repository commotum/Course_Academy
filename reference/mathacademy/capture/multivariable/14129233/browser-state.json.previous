      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129233/observations/step-q85175-5a494a6aabf091d4ab47.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14129233/observations/step-q85175-5a494a6aabf091d4ab47.png",
      "source_url": "https://mathacademy.com/tasks/14129233/topics/2835/lesson",
      "captured_at": 1791770286.345768,
      "math_academy_id": "q-85175",
      "topic_id": "2835",
      "sequence_position": null,
      "source_step": {
        "dom_id": "step-q85175",
        "placement_id": null,
