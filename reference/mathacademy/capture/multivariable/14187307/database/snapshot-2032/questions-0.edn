d #edb/ref 17592186499664} {:answer/id #uuid "8166c34f-e359-5b5c-ba3e-efe8e59a3e11" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a33a645a435e8c144a1109f91850deff11bfd059724a7161753c9bb9a620a521.png" :db/id #edb/ref 17592186499898} {:answer/id #uuid "b5a16136-9029-54ee-b815-5120584dc7cc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/95/95988c03055bed7c4cfc14331c76153a3e813d0d0a3018aa49b26494503fe856.png" :db/id #edb/ref 17592186500023} {:answer/id #uuid "c36a078d-d1d6-54bb-86a8-b6657a466986" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a0/a0038e238ec25cfc1dfe7d2f89712f58931fb48ecea2c8f4e07fe613a3257735.png" :db/id #edb/ref 17592186500049} {:answer/id #uuid "f92e3af2-da17-50cc-b292-b5e912be09fe" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e2/e2f5215e5c1aab95306d4ec5aee54ff1b8ccd01fbb08043678692722faa904ca.png" :db/id #edb/ref 17592186500166}] :answer-field/correct {:answer/id #uuid "05d8f285-cdd2-55af-a3b6-2179b7742a38" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/50/5098abed199db997b901675210c7289f2a85732881a1defeadc2e5f2b80d8086.png" :db/id #edb/ref 17592186499664} :answer-field/id #uuid "7715bed5-0219-5a1c-a9a0-42518512f7f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186500230}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7a86a9c-206d-5e61-b545-baa0dd6589ec" :question/math-academy-id "q-92792" :question/problem "A survey was conducted among high school students to find out their favorite games. According to their responses, for every $3$ students who prefer soccer, there are $5$ students who prefer baseball. Which tape diagram represents the given scenario?" :question/worked-solution "We are told that:  \n\nfor every $3$ students who prefer soccer there are $5$ students who prefer baseball\n\nSo, in a tape diagram, soccer´s tape must contain $3$ boxes, while the tape corresponding to baseball should have $5$ boxes.\n\nTherefore, the diagram is the following:\n\n![](images/50/5098abed199db997b901675210c7289f2a85732881a1defeadc2e5f2b80d8086.png)"}] [{:db/id #edb/ref 17592186500291 :knowledge-point/_questions [{:db/id #edb/ref 17592186073855 :knowledge-point/id #uuid "76a2f388-bfe6-567b-beec-c59644da1e8a" :knowledge-point/title "Computing Ratios From Tape Diagrams Using Multiple Units"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e58df5a-6c7b-5457-bff1-c2daa726d742" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186499721} {:answer/id #uuid "56a6f2ee-f72b-5bcb-9ba3-b1c839917a3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186499823} {:answer/id #uuid "69cac9de-ea62-5da6-a089-9e03694a837b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186499856} {:answer/id #uuid "816d9cf9-3257-57fc-8c41-6985c7e57ae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186499899} {:answer/id #uuid "d6f23ee7-9ab8-5bb7-a40a-2dcf8272c40d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186500092}] :answer-field/correct {:answer/id #uuid "69cac9de-ea62-5da6-a089-9e03694a837b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186499856} :answer-field/id #uuid "1623f4ed-2ad5-5db2-b327-0039b809100e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186500193}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a689f52-7a55-519b-a705-abe55d84d915" :question/math-academy-id "q-92809" :question/problem "![](images/9b/9b349ac221e04877ef3ad0474d9ddb1e95e7f01748f0be9975e18b9195090f5e.png)\n\nMs. Robinson's class has $32$ students. The ratio of boys to girls  is shown in the diagram above. How many girls are in Ms. Robinson's class?" :question/worked-solution "The tape diagram shows $3$ boxes corresponding to boys, and $5$ boxes corresponding to girls. Therefore, the ratio of boys to girls born is $3:5.$\n\nWe are told that Ms. Robinson's class has $32$ students in total. The tape diagram has $3+5=8$ boxes in total. Therefore, each box in the diagram above represents $32÷8=4$ students in Ms. Robinson's class. \n\nNow, we fill the number $4$ in each box of both tapes:\n\n![](images/66/66ba3f4ea51eb34cf4c1f313058e56523236ebd36fcd092082b9f6ca63261d1b.png)\n\nSince there are $5$ boxes corresponding to girls, and each box represents $4$ students, the number of girls in Mr. Robinson's class must be:\n\n$$\n5\\times 4=20.\n$$\n\nSo, there are $20$  girls in Mr. Robinson's class."}]}
