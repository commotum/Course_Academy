difficulty/easy} :question/id #uuid "24b62cd6-a2c3-5060-a0de-7e8afa941a63" :question/math-academy-id "q-92772" :question/problem "A fan noticed the following trend: in the last three weeks, the Yankees won $4$ games for every $3$ Red Sox wins.  Which tape diagram represents the given scenario?" :question/worked-solution "We are told that:\n\nthe Yankees won $4$ games for every $3$  Red Sox wins  \n\nSo, in a tape diagram, Yankee's tape must contain $4$ boxes, while the tape corresponding to the Red Sox should have $3$ boxes.\n\nTherefore, the diagram is the following:\n\n![](images/e5/e53d8287e51e697be1a010a7af34ad2a062bc505ce06326e15605ac52bd16cda.png)"}] [{:db/id #edb/ref 17592186500287 :knowledge-point/_questions [{:db/id #edb/ref 17592186073853 :knowledge-point/id #uuid "5ef376fd-9191-586d-b172-5e46e3043243" :knowledge-point/title "Creating Tape Diagrams Given a Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba414a5-bafd-5f3b-8668-fb17d4b390c0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ec/ec8b1be4b88a8315d253b625da48696f6c894d78214967e17a2d69576fcd32e9.png" :db/id #edb/ref 17592186499681} {:answer/id #uuid "3c666358-7e71-554c-b170-69a39428234c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c9/c9a78e5ce7f019eb472770f7d3b3703bab7c6b5cb22e38c4c39a379156936bc7.png" :db/id #edb/ref 17592186499773} {:answer/id #uuid "7bf1ef25-5878-5b41-a9dc-5eef9ecbdf06" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/23/23498cdbf112703b7ca7cf6bce275a83b0ad8f7a63df73007dcd5f010bb3c69d.png" :db/id #edb/ref 17592186499887} {:answer/id #uuid "87a489dc-39f0-59b4-a8eb-620c84f79dd0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8c/8c4f104a91eb0fba304de58f7bd68b45d80e0b81227ec453f395cd5ad115a79d.png" :db/id #edb/ref 17592186499918} {:answer/id #uuid "afa4b2c3