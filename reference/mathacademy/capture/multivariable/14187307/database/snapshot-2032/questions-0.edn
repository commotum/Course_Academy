6-567b-beec-c59644da1e8a" :knowledge-point/title "Computing Ratios From Tape Diagrams Using Multiple Units"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2460564d-7c78-57ef-8cdd-051c6b124420" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186499736} {:answer/id #uuid "2569b9b0-7570-5758-8153-0fbb9d36492e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186499737} {:answer/id #uuid "2a6f56ed-8fa7-54de-b9a2-28dd803f57b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186499745} {:answer/id #uuid "32c8c091-5bf2-5eb9-8870-61598ee1b630" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186499760} {:answer/id #uuid "b4537d2a-7976-55f1-bec5-5d67839b206a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186500017}] :answer-field/correct {:answer/id #uuid "32c8c091-5bf2-5eb9-8870-61598ee1b630" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186499760} :answer-field/id #uuid "241f2467-3e73-5f84-bcea-fab2347557a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186500196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed7cfda9-6dae-5e39-9991-44b62b4e52f7" :question/math-academy-id "q-61770" :question/problem "![](images/7c/7c7e161603d7f4dc59a8d19c4b28326232779c20fc6e029d168ad15e84661aa1.png)\n\nDavid's bag has green and yellow balls, in total there are $40$ balls. The ratio of green balls to yellow balls is shown in the diagram above. How many green balls are there?" :question/worked-solution "The tape diagram shows $3$ boxes corresponding to green, and $5$ boxes corresponding to yellow. Therefore, the ratio of green balls to yellow balls in David's bag is $3:5.$\n\nWe are told that David's bag has $40$ balls in total. The tape diagram has $3+5=8$ boxes in total. Therefore, each box in the diagram above represents $40÷8=5$ balls in the bag.\n\nNow, we fill the number $5$ in each box of both tapes:\n\n![](images/8f/8fdf2dfff7c145ae3774ec869a54752f2fb1c47ad98da3a21b45c36c3e1a9b09.png)\n\nSince there are $3$ boxes corresponding to green balls, and each box represents $5$ balls, the number of green balls must be:\n\n$$\n3\\times 5=15.\n$$\n\nSo, there are $15$ green balls in David's bag."}] [{:db/id #edb/ref 17592186074484 :knowledge-point/_questions [{:db/id #edb/ref 17592186073855 :knowledge-point/id #uuid "76a2f388-bfe6-567b-beec-c59644da1e8a" :knowledge-point/title "Computing Ratios From Tape Diagrams Using Multiple Units"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5f53b4a-0552-58da-b231-ec2406fcc47c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186073143} {:answer/id #uuid "d9aaf306-787d-51fd-8425-78190b60cb8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186073144} {:answer/id #uuid "2707a043-bb7f-5f35-91f5-b836d966f17f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186073145} {:answer/id #uuid "58fdac3a-0922-5ef2-8699-65d28eac9a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186073146} {:answer/id #uuid "61429067-e8a5-5d8a-91da-7b5c1b5b0af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186073147}] :answer-field/correct {:answer/id #uuid "2707a043-bb7f-5f35-91f5-b836d966f17f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186073145} :answer-field/id #uuid "bc071b32-06e2-56ea-841b-dd7d64aae128" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186073142}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "455ec586-01a1-5624-964c-13e7c5990f53" :question/math-academy-id "q-61772" :question/problem "![](images/8d/8d861b8d473ffe6b56105636da5ea51bb5fd33685b454800d376616b5cf2e311.png)\n\nThe password of Carla's computer has ten characters. Each character is a number among $1$ and $9.$ The ratio of odd numbers to even numbers is shown in the diagram above. How many even numbers her password has?" :question/worked-solution "The tape diagram shows $2$ boxes corresponding to odd numbers, and $3$ boxes corresponding to even numbers. Therefore, the ratio of odd to even in the password is $2:3.$\n\nWe are told that the password has $10$ characters. The tape diagram has $2+3=5$ boxes in total. Therefore, each box in the diagram above represents $10÷5=2$ numbers.\n\nNow, we fill the number $2$ in each box of both tapes:\n\n![](images/7d/7dc4dedfb2550e65ad1146b5103fc00ac1cc0d447258d336602df4b7be93a658.png)\n\nSince there are $3$ boxes corresponding to even numbers, and each box represents $2$ numbers, the number of even numbers must be:\n\n$$\n3\\times 2=6.\n$$\n\nSo, Carla's password has $6$ even numbers."}] [{:db/id #edb/ref 17592186500294 :knowledge-point/_questions [{:db/id #edb/ref 17592186073852 :knowledge-point/id #uuid "bbf7f692-6019-55eb-9fc9-c4cad3c4df93" :knowledge-point/title "Computing Ratios From Tape Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3327b14c-c5ff-5abd-b9c2-cae374cc18a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4:10" :db/id #edb/ref 17592186499761} {:answer/id #uuid "6ac