ts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5f53b4a-0552-58da-b231-ec2406fcc47c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186073143} {:answer/id #uuid "d9aaf306-787d-51fd-8425-78190b60cb8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186073144} {:answer/id #uuid "2707a043-bb7f-5f35-91f5-b836d966f17f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186073145} {:answer/id #uuid "58fdac3a-0922-5ef2-8699-65d28eac9a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186073146} {:answer/id #uuid "61429067-e8a5-5d8a-91da-7b5c1b5b0af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186073147}] :answer-field/id #uuid "bc071b32-06e2-56ea-841b-dd7d64aae128" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186073142}] :question/id #uuid "455ec586-01a1-5624-964c-13e7c5990f53" :question/math-academy-id "q-61772" :question/problem "![](images/8d/8d861b8d473ffe6b56105636da5ea51bb5fd33685b454800d376616b5cf2e311.png)\n\nThe password of Carla's computer has ten characters. Each character is a number among $1$ and $9$. The ratio of odd numbers to even numbers is shown in the diagram above. How many even numbers her password has?"}]}
