#{[{:activity/first-step {:db/id #edb/ref 17592186074827} :activity/id #uuid "8187877f-8b2c-5130-85d8-d264e532a36c" :activity/scope {:db/id #edb/ref 17592186049838 :topic/id #uuid "17da6c55-4c04-52a9-996e-d7cc7839ee6d" :topic/math-academy-id 556} :activity/steps [{:db/id #edb/ref 17592186074827 :step/content {:db/id #edb/ref 17592186074969 :tutorial/content "We can illustrate ratios with a **tape diagram**, where each box represents a unit.\n\nThe tape diagram below shows the ratio between the number of black hair ties and white hair ties there are in the package Anabelle bought.\n\n![](images/15/15c9b0b47bd0e6fdca99ab67df4bdc7e9202978128770df717bb347e463cfb33.png)\n\nIn this diagram, each box represents a hair tie.\nSo, what is the ratio of white hair ties to black hair ties?\n\nThe tape diagram for white hair ties shows $\\color{blue}5$ boxes, so Anabelle has $\\color{blue}5$ white hair ties.\n\nLikewise, the tape diagram for black hair ties contains $\\color{red}6$ boxes, so she has $\\color{red}6$ black hair ties.\n\nTherefore, the ratio of white hair ties to black hair ties is ${\\color{blue}5}:{\\color{red}6}$." :tutorial/id #uuid "db49cfe6-f1ac-5798-847e-e351e2ca2271" :tutorial/math-academy-id 2054 :tutorial/title "Introduction"} :step/id #uuid "6d46a89c-a25b-5481-b05c-1dc6047fbb36" :step/math-academy-id 633368 :step/next {:db/id #edb/ref 17592186074828}} {:db/id #edb/ref 17592186074828 :step/content {:db/id #edb/ref 17592186073852 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073567 :question/id #uuid "032ead48-0a3f-5a5e-b604-2a2fc0d91770" :question/math-academy-id "e-2288"} :knowledge-point/id #uuid "bbf7f692-6019-55eb-9fc9-c4cad3c4df93" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050924}] :knowledge-point/questions [{:db/id #edb/ref 17592186074472} {:db/id #edb/ref 17592186074483}] :knowledge-point/title "Computing Ratios From Tape Diagrams"} :step/id #uuid "834b2a5e-aa96-59d4-9f65-37f0c2e561a3" :step/math-academy-id 633369 :step/next {:db/id #edb/ref 17592186074829}} {:db/id #edb/ref 17592186074829 :step/content {:db/id #edb/ref 17592186073853 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073569 :question/id #uuid "fe68a823-4477-5d82-bd17-12842d6e8735" :question/math-academy-id "e-2290"} :knowledge-point/id #uuid "5ef376fd-9191-586d-b172-5e46e3043243" :knowledge-point/questions [{:db/id #edb/ref 17592186074471} {:db/id #edb/ref 17592186074477}] :knowledge-point/title "Creating Tape Diagrams Given a Ratio"} :step/id #uuid "87245d97-a832-5bd2-bb54-0d9029ed3603" :step/math-academy-id 633372 :step/next {:db/id #edb/ref 17592186074830}} {:db/id #edb/ref 17592186074830 :step/content {:db/id #edb/ref 17592186074971 :tutorial/content "In some tape diagrams, each box can represent more than one unit.\n\nFor instance, the ratio of pins to paper clips in a case is given by the tape diagram below. If there are $15$ pins in the case, how many paper clips are there in total?\n\n![](images/82/82f94d7377ea3923ffdd825de324b128cd8b4f102070bf6890dee2cbc619657e.png)\n\nWe are told that there are $15$ pins in the case, but the tape diagram for pins shows $3$ boxes. Therefore, each box in the diagram above represents\n\n$$\n15 \\div 3 = 5\n$$\n\nunits.\n\nNow, we fill the number $5$ in each box of both tapes:\n\n![](images/7d/7d8d1e22ee067588593b7b08442dd2a44142f9f684d84809056ee0ffb4b2dfc0.png)\n\nSince there are $4$ boxes corresponding to paper clips, and each box represents $5$ units, the total number of paper clips is\n\n$$\n4 \\times 5 = 20 \\,\n$$\n\nSo, there are $20$ paper clips in Mrs. Robinson's case." :tutorial/id #uuid "6a5fc255-be3d-58ad-b9c5-c1bbed5b72ad" :tutorial/math-academy-id 2056 :tutorial/title "Computing Ratios Using Tape Diagrams With Multiple Units"} :step/id #uuid "e1906855-8771-5209-9808-b6c5d3d82903" :step/math-academy-id 633375 :step/next {:db/id #edb/ref 17592186074831}} {:db/id #edb/ref 17592186074831 :step/content {:db/id #edb/ref 17592186073854 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073574 :question/id #uuid "c089129a-f06b-53d3-a7be-d8d8a79b6dd9" :question/math-academy-id "e-2295"} :knowledge-point/id #uuid "5aedad19-4881-5b53-9ec9-335bbe9cec48" :knowledge-point/questions [{:db/id #edb/ref 17592186074470} {:db/id #edb/ref 17592186074478}] :knowledge-point/title "Interpreting Tape Diagrams Using Multiple Units"} :step/id #uuid "b40ecc8b-3307-5e8c-a52b-105ba265f265" :step/math-academy-id 633376 :step/next {:db/id #edb/ref 17592186074832}} {:db/id #edb/ref 17592186074832 :step/content {:db/id #edb/ref 17592186073855 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073575 :question/id #uuid "ca5d9154-4c7e-5866-a6eb-5e4c1fb4d24b" :question/math-academy-id "e-2296"} :knowledge-point/id #uuid "76a2f388-bfe6-567b-beec-c59644da1e8a" :knowledge-point/questions [{:db/id #edb/ref 17592186074484} {:db/id #edb/ref 17592186074523}] :knowledge-point/title "Computing Ratios From Tape Diagrams Using Multiple Units"} :step/id #uuid "53d075f6-e5a4-5538-8f53-8f68f0d418a4" :step/math-academy-id 633379}] :activity/title "Tape Diagrams" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186073974}]}
