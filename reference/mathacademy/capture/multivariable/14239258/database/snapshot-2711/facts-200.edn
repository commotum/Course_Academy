743a3" #edb/ref 17592186045417] [17592186558292 #edb/ref 1080 "\\frac{3}{2}" #edb/ref 17592186045417] [17592186558292 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186558292 #edb/ref 1083 #uuid "d7f6dbe2-f389-5865-a28c-083f626a394d" #edb/ref 17592186045417] [17592186558437 #edb/ref 1075 #edb/ref 17592186558030 #edb/ref 17592186045417] [17592186558437 #edb/ref 1075 #edb/ref 17592186558086 #edb/ref 17592186045417] [17592186558437 #edb/ref 1075 #edb/ref 17592186558089 #edb/ref 17592186045417] [17592186558437 #edb/ref 1075 #edb/ref 17592186558210 #edb/ref 17592186045417] [17592186558437 #edb/ref 1075 #edb/ref 17592186558292 #edb/ref 17592186045417] [17592186558437 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186558437 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186558437 #edb/ref 1078 #edb/ref 17592186558089 #edb/ref 17592186045417] [17592186558437 #edb/ref 1079 #uuid "9e40607e-9b99-5e38-8f0d-dd955650b71c" #edb/ref 17592186045417] [17592186558485 #edb/ref 1068 #edb/ref 17592186558437 #edb/ref 17592186045417] [17592186558485 #edb/ref 1069 "q-163103" #edb/ref 17592186045417] [17592186558485 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186558485 #edb/ref 1071 "For the function of two variables \n$f(x,y)=y\\operatorname{sin}⁡(x+y),$\nthe quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\nf(x,y)=axy+b{y}^{2}.\n$$\n\nFind the value of $a+b.$" #edb/ref 17592186045417] [17592186558485 #edb/ref 1072 #uuid "0ce9fe2d-58e8-5131-a802-985ae9f0bd60" #edb/ref 17592186045417] [17592186558485 #edb/ref 1074 "If the function $f(x,y)$ is twice differentiable at $(x,y)=(0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}} \\\\  & \\,\\,+{{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =0.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =y\\operatorname{cos}⁡(x+y), & \\,{f}_{y}(x,y) & =\\operatorname{sin}⁡(x+y)+y\\operatorname{cos}⁡(x+y) \\\\ {f}_{x}(0,0) & =0, & \\,{f}_{y}(0,0) & =0\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =-y\\operatorname{sin}⁡(x+y), & \\,{f}_{xx}(0,0) & =0 \\\\ {f}_{xy}(x,y) & =\\operatorname{cos}⁡(x+y)-y\\operatorname{sin}⁡(x+y), & \\,{f}_{xy}(0,0) & =1 \\\\ {f}_{yy}(x,y) & =2\\operatorname{cos}⁡(x+y)-y\\operatorname{sin}⁡(x+y), & \\,{f}_{yy}(0,0) & =2\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈0+0\\cdot x+0\\cdot y+\\frac{1}{2}(0\\cdot {x}^{2}+2(1)\\cdot xy+2\\cdot {y}^{2}) \\\\  & =1xy+1{y}^{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=1+1=2.\n$$" #edb/ref 17592186045417] [17592186558613 #edb/ref 1058 #edb/ref 17592186558674 #edb/ref 17592186045417] [17592186558613 #edb/ref 1062 #uuid "3a11e84f-b2e6-5b96-aebc-d33a601e7124" #edb/ref 17592186045417] [17592186558613 #edb/ref 1063 #edb/ref 17592186281599 #edb/ref 17592186045417] [17592186558643 #edb/ref 1058 #edb/ref 17592186558613 #edb/ref 17592186045417] [17592186558643 #edb/ref 1062 #uuid "73dacf11-d610-510f-9f2a-ac96a061e45f" #edb/ref 17592186045417] [17592186558643 #edb/ref 1063 #edb/ref 17592186281594 #edb/ref 17592186045417] [17592186558649 #edb/ref 1058 #edb/ref 17592186558643 #edb/ref 17592186045417] [17592186558649 #edb/ref 1062 #uuid "7de9f41d-a324-5443-81f5-c5e92f51bfc5" #edb/ref 17592186045417] [17592186558649 #edb/ref 1063 #edb/ref 17592186198645 #edb/ref 17592186045417] [17592186558670 #edb/ref 1062 #uuid "a43c867a-54d3-5da5-aa81-a0fc72465bfa" #edb/ref 175921860